msgstr "メイ・リデル・アーシェロット"

msgctxt "text_id=24092 | speaker=unknown"
msgid "Back"
msgstr "戻る"

msgctxt "text_id=24093 | speaker=unknown"
msgid "Is Miss Kuonji a neat freak?"
msgstr "久遠寺さんは本当に潔癖か？と思った。"

msgctxt "text_id=24094 | speaker=unknown"
msgid "Why did Tokitsu come to this party?"
msgstr "土桔氏はどうして誕生会を？と思った。"

msgctxt "text_id=24095 | speaker=unknown"
msgid "Are there two types of murders?"
msgstr "殺人は二種類に分けられる？と思った。"

msgctxt "text_id=24096 | speaker=unknown"
msgid "Ritsuka's lockpicking skills!"
msgstr "律架さんのピッキング……！と思った。"

msgctxt "text_id=24097 | speaker=unknown"
msgid "Names define us."
msgstr "名は体を表す、と思った。"

msgctxt "text_id=24098 | speaker=unknown"
msgid "Who has magical energy?"
msgstr "魔力とやらを持っているのは誰だ、と思った。"

msgctxt "text_id=24099 | speaker=unknown"
msgid "Who could activate a Ploy?"
msgstr "プロイとやらを起動できたのは誰だ、と思った。"

msgctxt "text_id=24100 | speaker=unknown"
msgid "Who's always being watched by everyone?"
msgstr "常にみんなに見られていたのは誰だ、と思った。"

msgctxt "text_id=24101 | speaker=unknown"
msgid "Aoko Aozaki"
msgstr "蒼崎 青子"

