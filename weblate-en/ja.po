msgctxt "text_id=1343 | speaker=unknown"
msgid "  NITROGEN: NOMINAL."
msgstr "　窒素、異常ナシ。"

#. Occurrence 1DOT5_3:356:1344: voice_id=C50_1DOT5_3_9002; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:356
msgctxt "text_id=1344 | speaker=unknown"
msgid "  OXYGEN: NOMINAL."
msgstr "　酸素、異常ナシ。"

#. Occurrence 1DOT5_3:362:1345: voice_id=C50_1DOT5_3_9003; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:362
msgctxt "text_id=1345 | speaker=unknown"
msgid "  ARGON: NOMINAL."
msgstr "　アルゴン、異常ナシ。"

#. Occurrence 1DOT5_3:368:1346: voice_id=C50_1DOT5_3_9004; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:368
msgctxt "text_id=1346 | speaker=unknown"
msgid "  CARBON DIOXIDE: NOMINAL."
msgstr "　二酸化炭素、異常ナシ。"

#. Occurrence 1DOT5_3:376:1347: voice_id=C50_1DOT5_3_0006; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:376
msgctxt "text_id=1347 | speaker=unknown"
msgid "  FIFTH THEORETICAL FACTOR: MULTIPLE ANOMALIES DETECTED."
msgstr "　第五仮説要素―――異常／異常／異常／アリ。"

#. Occurrence 1DOT5_3:399:1348: voice_id=C50_1DOT5_3_0007; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:399
msgctxt "text_id=1348 | speaker=unknown"
msgid "  LOCAL SPACE-TIME DISCREPANCY DETECTED."
msgstr "　周囲ノ時空連続体ニ　齟齬ヲ　確認。"

#. Occurrence 1DOT5_3:406:1349: voice_id=C50_1DOT5_3_0008; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:406
msgctxt "text_id=1349 | speaker=unknown"
msgid "  CONCLUSION: CONTACT, CLASS 1 THREAT."
msgstr "　第一種　危険物トノ　遭遇ト　断定。"

#. Occurrence 1DOT5_3:443:1350: voice_id=C50_1DOT5_3_0009; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:443
msgctxt "text_id=1350 | speaker=unknown"
msgid "  SHIFTING PERCEPTION RANGE FROM SUBJECTIVE TO OBJECTIVE..."
msgstr "　知覚領域ヲ　主観→客観ニ　変更。"

#. Occurrence 1DOT5_3:451:1351: voice_id=C50_1DOT5_3_0010; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:451
msgctxt "text_id=1351 | speaker=unknown"
msgid "  SHIFTING AUTONOMOUS CIRCUIT TO RESERVE POWER..."
msgstr "　自律回路ヲ　予備電源　ニ　、"

msgctxt "text_id=1352 | speaker=unknown"
msgid "  SHIFTING DIAGNOSTIC CIRCUIT TO MAIN POWER..."
msgstr "　計測回路ヲ　主電源　ニ　変更。"

#. Occurrence 1DOT5_3:461:1353: voice_id=C50_1DOT5_3_0011; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:461
msgctxt "text_id=1353 | speaker=unknown"
msgid "  SHIFTING VIEW MODE..."
msgstr "　<視覚|カメラ>ヲ　赤外線計測　カラ"

msgctxt "text_id=1354 | speaker=unknown"
msgid "  I.R. FILTER INACTIVE. i FILTER ACTIVE."
msgstr "　虚数線計測　ニ　変更。"

#. Occurrence 1DOT5_3:489:1355: voice_id=C50_1DOT5_3_0012; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:489
msgctxt "text_id=1355 | speaker=unknown"
msgid "  NOW, IT BEGINS."
msgstr "　―――デハ。"

#. Occurrence 1DOT5_3:495:1356: voice_id=C50_1DOT5_3_0013; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:495
msgctxt "text_id=1356 | speaker=unknown"
msgid "  INITIATING COMBAT LOG..."
msgstr "　コレヨリ　戦闘行為ノ　記述ヲ　開始シマス。"

#. Occurrence 1DOT5_3:503:1357: voice_id=C50_1DOT5_3_0014; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:503
msgctxt "text_id=1357 | speaker=unknown"
msgid "  OH, MASTER. "
msgstr "　主ヨ。"

msgctxt "text_id=1358 | speaker=unknown"
msgid "PRESERVE ME FROM HARM."
msgstr "ドウカ我ガ身ヲ　護リタマエ。"

#. Occurrence 1DOT5_3:571:1359: scene=1DOT5_3
#: 1DOT5_3:571
msgctxt "text_id=1359 | speaker=unknown"
msgid "  Misaki City was a thickly wooded area."
msgstr "　三咲市には森が多い。"

#. Occurrence 1DOT5_3:576:1360: scene=1DOT5_3
#: 1DOT5_3:576
msgctxt "text_id=1360 | speaker=unknown"
msgid "  Urban development continued unabated, but Mother Nature still drew breath in its outskirts."
msgstr "　都市開発は進んでいるが、郊外にはいまだ深い自然が息づいている。"

#. Occurrence 1DOT5_3:596:1361: scene=1DOT5_3
#: 1DOT5_3:596
msgctxt "text_id=1361 | speaker=unknown"
msgid "  Wise old trees had been turned to lumber."
msgstr "　<物知|ものし>りな樹木が伐採され、"

#. Occurrence 1DOT5_3:601:1362: scene=1DOT5_3
#: 1DOT5_3:601
msgctxt "text_id=1362 | speaker=unknown"
msgid "  The leaves had begun to turn to mulch."
msgstr "　温かな腐葉土が<拓|ひら>かれ、"

#. Occurrence 1DOT5_3:606:1363: scene=1DOT5_3
#: 1DOT5_3:606
msgctxt "text_id=1363 | speaker=unknown"
msgid "  Even though the birds who curiously tilted their heads had moved on, the verdure lived on, a testament to its enduring strength."
msgstr "　不思議そうに首をかしげる小鳥たちが消え去っても、真に力のある<緑|みどり>は生き続ける。"

#. Occurrence 1DOT5_3:612:1364: scene=1DOT5_3
#: 1DOT5_3:612
msgctxt "text_id=1364 | speaker=unknown"
msgid "  Until the time came that the devouring light of civilization became powerful enough to encroach upon nature's mysterious domain."
msgstr "　文明の光が、彼らの<培|つちか>ってきた年月を<侵|おか>すほどの強さになるその時まで、神秘の領域として有り続ける。"

#. Occurrence 1DOT5_3:659:1365: scene=1DOT5_3
#: 1DOT5_3:659
msgctxt "text_id=1365 | speaker=unknown"
msgid "  These woods were no exception."
msgstr "　……この森もその一つ。"

#. Occurrence 1DOT5_3:664:1366: scene=1DOT5_3
#: 1DOT5_3:664
msgctxt "text_id=1366 | speaker=unknown"
msgid "  The outlying border between Misaki City and Misaki Hills had been left untouched."
msgstr "　手つかずのまま郊外に放置された三咲町と三咲丘の<境界|ボーダー>。"

#. Occurrence 1DOT5_3:670:1367: scene=1DOT5_3
#: 1DOT5_3:670
msgctxt "text_id=1367 | speaker=unknown"
msgid "  Though driven from their nests and dens here, wildlife continued to subsist even today. No longer able to return to the days before man, this was just like any other forest situated next to a town."
msgstr "　今では住みかを追われた獣たちが細々と暮らす、地方都市ならどこにでもある、いたって<平均|ノーマル>な、帰らずの森である。"

#. Occurrence 1DOT5_3:714:1368: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0000_A; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:714
msgctxt "text_id=1368 | speaker=alice"
msgid "                      "
msgstr "　　　"

#. Occurrence 1DOT5_3:714:1369: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0000_A; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:714
msgctxt "text_id=1369 | speaker=alice"
msgid "Hey diddle diddle,"
msgstr "Hey diddle diddle,"

#. Occurrence 1DOT5_3:714:1370: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0000_A; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:714
msgctxt "text_id=1370 | speaker=alice"
msgid "                      The cat and the fiddle..."
msgstr "　　　The cat and the fiddle,"

#. Occurrence 1DOT5_3:752:1371: scene=1DOT5_3
#: 1DOT5_3:752
msgctxt "text_id=1371 | speaker=unknown"
msgid "  Winter had arrived in the woods."
msgstr "　森には、既に冬が到来していた。"

#. Occurrence 1DOT5_3:757:1372: scene=1DOT5_3
#: 1DOT5_3:757
msgctxt "text_id=1372 | speaker=unknown"
msgid "  The chill cut like a razor,"
msgstr "　<薄刃|カミソリ>のように肌を<削|そ>ぐ冷気。"

#. Occurrence 1DOT5_3:762:1373: scene=1DOT5_3
#: 1DOT5_3:762
msgctxt "text_id=1373 | speaker=unknown"
msgid "  the icy air so thick it could reached one's bones."
msgstr "　膝元までにじりよる氷の気配。"

#. Occurrence 1DOT5_3:768:1374: scene=1DOT5_3
#: 1DOT5_3:768
msgctxt "text_id=1374 | speaker=unknown"
msgid "  Exposed cheeks stiffened, and wisps of breath formed swirls in the air before disappearing."
msgstr "　露出した<頬|ほほ>はこわばり、吐息は白い雲になって消えていく。"

#. Occurrence 1DOT5_3:773:1375: scene=1DOT5_3
#: 1DOT5_3:773
msgctxt "text_id=1375 | speaker=unknown"
msgid "  It was one degree above freezing."
msgstr "　気温にして摂氏一度。"

#. Occurrence 1DOT5_3:778:1376: scene=1DOT5_3
#: 1DOT5_3:778
msgctxt "text_id=1376 | speaker=unknown"
msgid "  The cold snap penetrated every nook and cranny of the woods, from the ground, to the trees, to the wildlife."
msgstr "　寒波は森全体に、大地や木々、獣たちに染み渡る。"

#. Occurrence 1DOT5_3:838:1377: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0001_A; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:838
msgctxt "text_id=1377 | speaker=alice"
msgid "                                "
msgstr "　　　　　　"

#. Occurrence 1DOT5_3:838:1378: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0001_A; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:838
msgctxt "text_id=1378 | speaker=alice"
msgid "The cow jump'd over the moon,"
msgstr "The cow jump'd over the moon,"

#. Occurrence 1DOT5_3:838:1379: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0001_A; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:838
msgctxt "text_id=1379 | speaker=alice"
msgid "                                The little dog laugh'd..."
msgstr "　　　　　　The little dog laugh'd"

#. Occurrence 1DOT5_3:914:1380: scene=1DOT5_3
#: 1DOT5_3:914
msgctxt "text_id=1380 | speaker=unknown"
msgid "  The forest allowed nobody entry during the day."
msgstr "　昼の森は人々を立ち入らせず、"

#. Occurrence 1DOT5_3:919:1381: scene=1DOT5_3
#: 1DOT5_3:919
msgctxt "text_id=1381 | speaker=unknown"
msgid "  During the winter, it willed the animals to slumber."
msgstr "　冬の森は獣たちすら眠らせる。"

#. Occurrence 1DOT5_3:926:1382: scene=1DOT5_3
#: 1DOT5_3:926
msgctxt "text_id=1382 | speaker=unknown"
msgid "  The still evening air felt like the stagnant breath of the lingering dead."
msgstr "　漂う<夜気|やき>は亡霊の息そのものだ。"

#. Occurrence 1DOT5_3:931:1383: scene=1DOT5_3
#: 1DOT5_3:931
msgctxt "text_id=1383 | speaker=unknown"
msgid "  The forest consumed the moonlight, obscuring the sight of even the closest of precipices, and hastening the untimely doom of any soul unfortunate enough to become lost within."
msgstr "　<月|つき><明|あ>かりを<呑|の>み、<一寸先|いっすんさき>の<崖|がけ>を隠し、迷いこんだ哀れな生贄を破滅させる。"

#. Occurrence 1DOT5_3:951:1384: scene=1DOT5_3
#: 1DOT5_3:951
msgctxt "text_id=1384 | speaker=unknown"
msgid "  The only noises to be heard were the whisperings of the wind and the murmurings of the stream."
msgstr "　聞こえるのは<微|かす>かな風の音と、川のせせらぎ。"

#. Occurrence 1DOT5_3:956:1385: scene=1DOT5_3
#: 1DOT5_3:956
msgctxt "text_id=1385 | speaker=unknown"
msgid "  The immortal darkness stifled any sense of life."
msgstr "　ここは<生命|いのち>を感じさせない<無窮|むきゅう>の闇。"

#. Occurrence 1DOT5_3:961:1386: scene=1DOT5_3
#: 1DOT5_3:961
msgctxt "text_id=1386 | speaker=unknown"
msgid "  Not the breath of an animal, much less that of a person, was drawn in this place."
msgstr "　獣はおろか、人の息など有るはずがない。"

#. Occurrence 1DOT5_3:966:1387: scene=1DOT5_3
#: 1DOT5_3:966
msgctxt "text_id=1387 | speaker=unknown"
msgid "  However..."
msgstr "　だが、"

#. Occurrence 1DOT5_3:988:1388: scene=1DOT5_3
#: 1DOT5_3:988
msgctxt "text_id=1388 | speaker=unknown"
msgid "  A figure in black, not of this place, skulked within."
msgstr "　その中を行く、不釣り合いな黒衣があった。"

#. Occurrence 1DOT5_3:993:1389: scene=1DOT5_3
#: 1DOT5_3:993
msgctxt "text_id=1389 | speaker=unknown"
msgid "  It cast the tiniest, frailest of silhouettes, like a small boat lost in a sea of fog."
msgstr "　霧の海に迷いこんだ小舟のような、あまりにも小さく弱々しいシルエット。"

#. Occurrence 1DOT5_3:999:1390: scene=1DOT5_3
#: 1DOT5_3:999
msgctxt "text_id=1390 | speaker=unknown"
msgid "  Its trepidatious footsteps echoed through the woods."
msgstr "　たよりなげな足音が響く。"

#. Occurrence 1DOT5_3:1004:1391: scene=1DOT5_3
#: 1DOT5_3:1004
msgctxt "text_id=1391 | speaker=unknown"
msgid "  There, exiting the veil of trees, was the unmistakable likeness of a young girl."
msgstr "　木々のヴェールを抜けるのは、紛れもなく、年若い人間の少女である。"

#. Occurrence 1DOT5_3:1034:1392: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0002_A; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:1034
msgctxt "text_id=1392 | speaker=alice"
msgid "                          "
msgstr "　　　　"

#. Occurrence 1DOT5_3:1034:1393: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0002_A; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:1034
msgctxt "text_id=1393 | speaker=alice"
msgid "To see such craft,"
msgstr "To see such craft,"

#. Occurrence 1DOT5_3:1034:1394: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0002_A; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:1034
msgctxt "text_id=1394 | speaker=alice"
msgid "                          And the dish ran away with the spoon."
msgstr "　　　　And the dish ran away with the spoon."

#. Occurrence 1DOT5_3:1082:1395: voice_id=C20_1DOT5_3_0000; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1082
msgctxt "text_id=1395 | speaker=unknown"
msgid "      \"Someone's here, someone's here!\""
msgstr "　　　『来たぞ来たぞ』"

#. Occurrence 1DOT5_3:1088:1396: voice_id=C30_1DOT5_3_0000; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1088
msgctxt "text_id=1396 | speaker=unknown"
msgid "                            \"There they are, there they are!\""
msgstr "　　　　　　　　　　　　　　『居るぞ居るぞ！』"

#. Occurrence 1DOT5_3:1119:1397: voice_id=C20_1DOT5_3_0001; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1119
msgctxt "text_id=1397 | speaker=unknown"
msgid "    \"Who can they be, who can they be?\""
msgstr "　　『誰が誰が？』"

#. Occurrence 1DOT5_3:1125:1398: voice_id=C30_1DOT5_3_0001; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1125
msgctxt "text_id=1398 | speaker=unknown"
msgid "                      \"Someone and someone!\""
msgstr "　　　　　　　　　　　『誰と誰が！』"

#. Occurrence 1DOT5_3:1149:1399: voice_id=C20_1DOT5_3_0002; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1149
msgctxt "text_id=1399 | speaker=unknown"
msgid "  \"Are you hungry?\""
msgstr "　『お腹は減ったの？』"

#. Occurrence 1DOT5_3:1155:1400: voice_id=C30_1DOT5_3_0002; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1155
msgctxt "text_id=1400 | speaker=unknown"
msgid "                              \"I'm starving!\""
msgstr "　　　　　　　　　　　　　　　『お腹は鳴ったさ！』"

#. Occurrence 1DOT5_3:1198:1401: voice_id=C20_1DOT5_3_0003; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1198
msgctxt "text_id=1401 | speaker=unknown"
msgid "    \"Which one should we eat?\""
msgstr "　　『どっちが食べる？』"

#. Occurrence 1DOT5_3:1204:1402: voice_id=C30_1DOT5_3_0003; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1204
msgctxt "text_id=1402 | speaker=unknown"
msgid "                            \"Let's eat them both!\""
msgstr "　　　　　　　　　　　　　　『どっちも食べる！』"

#. Occurrence 1DOT5_3:1228:1403: voice_id=C20_1DOT5_3_0004; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1228
msgctxt "text_id=1403 | speaker=unknown"
msgid "  \"You take the left!\""
msgstr "　『キミは左手、』"

#. Occurrence 1DOT5_3:1234:1404: voice_id=C30_1DOT5_3_0004; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1234
msgctxt "text_id=1404 | speaker=unknown"
msgid "                      \"You take the right!\""
msgstr "　　　　　　　　　　　『オマエは右手！』"

#. Occurrence 1DOT5_3:1258:1405: voice_id=C20_1DOT5_3_0005; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1258
msgctxt "text_id=1405 | speaker=unknown"
msgid "    \"We must welcome them!\""
msgstr "　　『歓迎しないと、』"

#. Occurrence 1DOT5_3:1264:1406: voice_id=C30_1DOT5_3_0005; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1264
msgctxt "text_id=1406 | speaker=unknown"
msgid "                                \"We must entertain them!\""
msgstr "　　　　　　　　　　　　　　　　『感激しないと！』"

#. Occurrence 1DOT5_3:1292:1407: voice_id=X10_1DOT5_3_0000; voice_prefix=X10; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1292
msgctxt "text_id=1407 | speaker=unknown"
msgid "          \"\"After all, we don't often have guests!\"\""
msgstr "　　　　　『『なにしろようやく楽しいお客！』』"

#. Occurrence 1DOT5_3:1370:1408: voice_id=C20_1DOT5_3_0006; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1370
msgctxt "text_id=1408 | speaker=unknown"
msgid "              \"While we're at it, the stomach and the tibia.\""
msgstr "　　　　　　　『ついでにお<腹|なか>と<頸骨|けいこつ>も、』"

#. Occurrence 1DOT5_3:1376:1409: voice_id=C30_1DOT5_3_0006; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1376
msgctxt "text_id=1409 | speaker=unknown"
msgid "          \"It's not often we get to chew the fat!\""
msgstr "　　　　　『せっかくだからよく噛まないと！』"

#. Occurrence 1DOT5_3:1451:1410: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0003; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:1451
msgctxt "text_id=1410 | speaker=alice"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 1DOT5_3:1457:1411: scene=1DOT5_3
#: 1DOT5_3:1457
msgctxt "text_id=1411 | speaker=unknown"
msgid "  The shadows in the trees laughed ominously."
msgstr "　木々の影が不気味に笑う。"

#. Occurrence 1DOT5_3:1462:1412: scene=1DOT5_3
#: 1DOT5_3:1462
msgctxt "text_id=1412 | speaker=unknown"
msgid "  A hallucination? An illusion? Or perhaps... Something real?"
msgstr "　幻聴か。錯覚か。あるいは<本|・><物|・>か。"

#. Occurrence 1DOT5_3:1467:1413: scene=1DOT5_3
#: 1DOT5_3:1467
msgctxt "text_id=1413 | speaker=unknown"
msgid "  The shadows frolicked in time to the girl's pace."
msgstr "　少女の歩みに合わせて、寄り添う影がパタパタはしゃぐ。"

#. Occurrence 1DOT5_3:1511:1414: voice_id=C20_1DOT5_3_8001; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1511
msgctxt "text_id=1414 | speaker=unknown"
msgid "\"Come, come!\""
msgstr "『さあさあ、さあさあ』"

#. Occurrence 1DOT5_3:1518:1415: voice_id=C30_1DOT5_3_8001; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1518
msgctxt "text_id=1415 | speaker=unknown"
msgid " \"Deeper and deeper!\""
msgstr "『もっと奥へ、もっと奥へ！』"

#. Occurrence 1DOT5_3:1525:1416: voice_id=C20_1DOT5_3_0008; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1525
msgctxt "text_id=1416 | speaker=unknown"
msgid "\"Did you remember to rig the dice?\""
msgstr "『ところでダイスは細工済み？』"

#. Occurrence 1DOT5_3:1531:1417: voice_id=C30_1DOT5_3_0008; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1531
msgctxt "text_id=1417 | speaker=unknown"
msgid "\"Loaded innards, they have.\""
msgstr "『お<胃|なか>の重いローデッド』"

#. Occurrence 1DOT5_3:1537:1418: voice_id=C20_1DOT5_3_0009; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1537
msgctxt "text_id=1418 | speaker=unknown"
msgid "\"Nibbled around the edges, they be!\""
msgstr "『はじっこ<囓|かじ>ったエッジワーク！』"

#. Occurrence 1DOT5_3:1544:1419: voice_id=C30_1DOT5_3_0009; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1544
msgctxt "text_id=1419 | speaker=unknown"
msgid "\"Just remember, don't roll that vital six!\""
msgstr "『どうでもいいけど、<肝心|かんじん><要|かなめ>の六の目だけはださないように！』"

#. Occurrence 1DOT5_3:1612:1420: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0004; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:1612
msgctxt "text_id=1420 | speaker=alice"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 1DOT5_3:1618:1421: scene=1DOT5_3
#: 1DOT5_3:1618
msgctxt "text_id=1421 | speaker=unknown"
msgid "  The girl knitted her eyebrows."
msgstr "　少女の眉が、かすかに歪む。"

#. Occurrence 1DOT5_3:1623:1422: scene=1DOT5_3
#: 1DOT5_3:1623
msgctxt "text_id=1422 | speaker=unknown"
msgid "  She heard voices and felt the presence of things that should not be."
msgstr "　聞こえる筈のない声、"

#. Occurrence 1DOT5_3:1628:1423: scene=1DOT5_3
#: 1DOT5_3:1628
msgctxt "text_id=1423 | speaker=unknown"
msgid "  Scary enough to frighten this particular girl?"
msgstr "　いる筈のない獣の気配に怯えるように？"

#. Occurrence 1DOT5_3:1633:1424: scene=1DOT5_3
#: 1DOT5_3:1633
msgctxt "text_id=1424 | speaker=unknown"
msgid "  As if."
msgstr "　まさか。"

#. Occurrence 1DOT5_3:1638:1425: scene=1DOT5_3
#: 1DOT5_3:1638
msgctxt "text_id=1425 | speaker=unknown"
msgid "  Her tightly pursed lips betrayed not a hint of fear."
msgstr "　きつく結ばれた唇には、微塵の恐れもありはしない。"

#. Occurrence 1DOT5_3:1720:1426: scene=1DOT5_3
#: 1DOT5_3:1720
msgctxt "text_id=1426 | speaker=unknown"
msgid "  The girl walked of her own volition."
msgstr "　少女の歩みは自らの意志によるもの。"

#. Occurrence 1DOT5_3:1725:1427: scene=1DOT5_3
#: 1DOT5_3:1725
msgctxt "text_id=1427 | speaker=unknown"
msgid "  If she had truly felt fear, her legs would be frozen."
msgstr "　恐怖があるのなら、そもそも足は進ませない。"

#. Occurrence 1DOT5_3:1730:1428: scene=1DOT5_3
#: 1DOT5_3:1730
msgctxt "text_id=1428 | speaker=unknown"
msgid "  Deep within the trees..."
msgstr "　木々の奥。"

#. Occurrence 1DOT5_3:1735:1429: scene=1DOT5_3
#: 1DOT5_3:1735
msgctxt "text_id=1429 | speaker=unknown"
msgid "  She was perfectly aware of the two humanoid figures stalking her through the still, night air."
msgstr "　夜気に隠れながら見つめてくる二体の人影に、少女はきちんと気づいている。"

#. Occurrence 1DOT5_3:1761:1430: voice_id=C20_1DOT5_3_0010; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1761
msgctxt "text_id=1430 | speaker=unknown"
msgid "\"I saw them, I saw them!\""
msgstr "『見たぞ見たぞ』"

#. Occurrence 1DOT5_3:1767:1431: voice_id=C30_1DOT5_3_0010; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1767
msgctxt "text_id=1431 | speaker=unknown"
msgid "\"They're coming, they're coming!\""
msgstr "『来るぞ来るぞ！』"

#. Occurrence 1DOT5_3:1773:1432: voice_id=C20_1DOT5_3_0011; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1773
msgctxt "text_id=1432 | speaker=unknown"
msgid "\"Give up!\""
msgstr "『もう諦めろ』"

#. Occurrence 1DOT5_3:1779:1433: voice_id=C30_1DOT5_3_0011; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1779
msgctxt "text_id=1433 | speaker=unknown"
msgid "\"There's no going back!\""
msgstr "『もう帰れない！』"

#. Occurrence 1DOT5_3:1867:1434: voice_id=C20_1DOT5_3_0012; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1867
msgctxt "text_id=1434 | speaker=unknown"
msgid "            \"We warned you!\""
msgstr "　　　　　　『あんなに教えてあげたのに』"

#. Occurrence 1DOT5_3:1938:1435: voice_id=C30_1DOT5_3_0012; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1938
msgctxt "text_id=1435 | speaker=unknown"
msgid "          \"It's your fault for staying!\""
msgstr "　　　　　『<余|よ><所|そ>に消えないオマエが悪い！』"

#. Occurrence 1DOT5_3:2019:1436: scene=1DOT5_3
#: 1DOT5_3:2019
msgctxt "text_id=1436 | speaker=unknown"
msgid "  The girl halted her steps."
msgstr "　少女の歩みが止まる。"

#. Occurrence 1DOT5_3:2024:1437: scene=1DOT5_3
#: 1DOT5_3:2024
msgctxt "text_id=1437 | speaker=unknown"
msgid "  The racket from the accompanying voices died in turn."
msgstr "　<蠢|うごめ>いていた二人分の声も止まる。"

#. Occurrence 1DOT5_3:2029:1438: scene=1DOT5_3
#: 1DOT5_3:2029
msgctxt "text_id=1438 | speaker=unknown"
msgid "  The babbling brook suddenly sounded like a crackling fire."
msgstr "　小川のせせらぎが、たき火の<爆|は>ぜ音のように聞こえる。"

#. Occurrence 1DOT5_3:2070:1439: scene=1DOT5_3
#: 1DOT5_3:2070
msgctxt "text_id=1439 | speaker=unknown"
msgid "  And then..."
msgstr "　そうして。"

#. Occurrence 1DOT5_3:2075:1440: scene=1DOT5_3
#: 1DOT5_3:2075
msgctxt "text_id=1440 | speaker=unknown"
msgid "  Across the shallow stream, something appeared that should not exist in the city, much less these woods."
msgstr "　<踝|くるぶし>ほどの小さな川の向こうに、街はおろか、この森にすら<在|あ>ってはならないモノが現れた。"

#. Occurrence 1DOT5_3:2198:1441: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0005; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:2198
msgctxt "text_id=1441 | speaker=alice"
msgid "\"Good evening. I don't suppose I could speak to your master?\""
msgstr "「今晩は。話の分かる<主人|ひと>はいる？」"

#. Occurrence 1DOT5_3:2204:1442: scene=1DOT5_3
#: 1DOT5_3:2204
msgctxt "text_id=1442 | speaker=unknown"
msgid "  The girl addressed them calmly."
msgstr "　少女は平然と語りかける。"

#. Occurrence 1DOT5_3:2209:1443: scene=1DOT5_3
#: 1DOT5_3:2209
msgctxt "text_id=1443 | speaker=unknown"
msgid "  These men with their Glasgow grins creeped toward her like two slugs."
msgstr "　二人の口裂け男は<蝸牛|かぎゅう>のように、じりじりとにじり寄る。"

#. Occurrence 1DOT5_3:2243:1444: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0006; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:2243
msgctxt "text_id=1444 | speaker=alice"
msgid "\"...I see. Simple graveyard wards, sent to be lookouts."
msgstr "「……そう。ただの<墓守|はかもり>、監視だけが仕事なのね。"

#. Occurrence 1DOT5_3:2249:1445: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0007; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:2249
msgctxt "text_id=1445 | speaker=alice"
msgid "  My mistake. I should have entrusted this to Aoko."
msgstr "　失敗したわ。これなら青子に任せれば良かった。"

#. Occurrence 1DOT5_3:2266:1446: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0008; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:2266
msgctxt "text_id=1446 | speaker=alice"
msgid "  However...\""
msgstr "　ああ、けど―――」"

#. Occurrence 1DOT5_3:2304:1447: scene=1DOT5_3
#: 1DOT5_3:2304
msgctxt "text_id=1447 | speaker=unknown"
msgid "  The one grinning man stood still."
msgstr "　一方の口裂け男は立ったまま。"

#. Occurrence 1DOT5_3:2309:1448: scene=1DOT5_3
#: 1DOT5_3:2309
msgctxt "text_id=1448 | speaker=unknown"
msgid "  The other, shaking violently as if unable to contain himself any longer, turned toward the girl."
msgstr "　もう一方の口裂け男は、我慢できないとばかりに、ぐらりと体を<傾|かたむ>かせる。"

#. Occurrence 1DOT5_3:2330:1449: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0009; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:2330
msgctxt "text_id=1449 | speaker=alice"
msgid "\"Aoko still has a lot on her plate."
msgstr "「青子にはまだ荷が重いわね。"

#. Occurrence 1DOT5_3:2336:1450: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0010; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:2336
msgctxt "text_id=1450 | speaker=alice"
msgid "  Although you far from look the part, you seem to be on the level of a fully-fledged mage.\""
msgstr "　そんな姿だけど、貴方たちは一人前の魔術師のようだし」"

#. Occurrence 1DOT5_3:2396:1451: scene=1DOT5_3
#: 1DOT5_3:2396
msgctxt "text_id=1451 | speaker=unknown"
msgid "  Her black outfit stirred."
msgstr "　黒衣が動く。"

#. Occurrence 1DOT5_3:2401:1452: scene=1DOT5_3
#: 1DOT5_3:2401
msgctxt "text_id=1452 | speaker=unknown"
msgid "  In her right hand she held a vitreous cat, darker than the deepest night."
msgstr "　少女の右手には、夜なお深い<硝子|ガラス>の猫。"

#. Occurrence 1DOT5_3:2452:1453: voice_id=C50_1DOT5_3_0015; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:2452
msgctxt "text_id=1453 | speaker=unknown"
msgid "\"...?\""
msgstr "“…………？”"

#. Occurrence 1DOT5_3:2458:1454: scene=1DOT5_3
#: 1DOT5_3:2458
msgctxt "text_id=1454 | speaker=unknown"
msgid "  The two Glasgow men let out a yelp of caution and incoherent fear."
msgstr "　こぼれたものは、小さな警戒と、脈絡のない<畏|おそ>れだった。"

#. Occurrence 1DOT5_3:2463:1455: scene=1DOT5_3
#: 1DOT5_3:2463
msgctxt "text_id=1455 | speaker=unknown"
msgid "  It was at this moment that they finally bared their intent and emotion."
msgstr "　二体の口裂け男はこの時、ようやく自らの<感情|いし>を表し、"

#. Occurrence 1DOT5_3:2488:1456: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0011; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:2488
msgctxt "text_id=1456 | speaker=alice"
msgid "\"Farewell, my guests."
msgstr "「さようなら、お客様。"

#. Occurrence 1DOT5_3:2494:1457: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0012; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:2494
msgctxt "text_id=1457 | speaker=alice"
msgid "  Since this will take but a moment, I offer only a good-bye.\""
msgstr "　きっと一瞬だろうから、お<別|わか>れだけ言っておくわ」"

#. Occurrence 1DOT5_3:2563:1458: scene=1DOT5_3
#: 1DOT5_3:2563
msgctxt "text_id=1458 | speaker=unknown"
msgid "  The two shuddered at her words."
msgstr "　その言葉に、彼等は明確に戦慄した。"

#. Occurrence 1DOT5_3:2631:1459: scene=1DOT5_3
#: 1DOT5_3:2631
msgctxt "text_id=1459 | speaker=unknown"
msgid "  They had no mouths, nor ears or brains to begin with. For creatures like these, words were redundant."
msgstr "　そもそも彼らには耳と口と脳がない。だから言葉なんて必要ない。"

#. Occurrence 1DOT5_3:2636:1460: scene=1DOT5_3
#: 1DOT5_3:2636
msgctxt "text_id=1460 | speaker=unknown"
msgid "  All that existed was the present."
msgstr "　彼らにとって有るものは“この瞬間”だけ。"

#. Occurrence 1DOT5_3:2641:1461: scene=1DOT5_3
#: 1DOT5_3:2641
msgctxt "text_id=1461 | speaker=unknown"
msgid "  For these soulless creatures, fears and hopes were nothing more than an unimaginable future."
msgstr "　恐怖も、期待も、心のない彼等にとって起こりえない“<未|き><来|ぼう>”でしかない。"

#. Occurrence 1DOT5_3:2708:1462: scene=1DOT5_3
#: 1DOT5_3:2708
msgctxt "text_id=1462 | speaker=unknown"
msgid "  Then what could be this feeling of foreboding they felt?"
msgstr "　なのに、彼らは予感したのだ。"

#. Occurrence 1DOT5_3:2713:1463: scene=1DOT5_3
#: 1DOT5_3:2713
msgctxt "text_id=1463 | speaker=unknown"
msgid "  ...The spine-chilling miracle that would rip them to pieces not moments from now."
msgstr "　たった今、そしてこれから、身の毛のよだつ奇跡が、自分たちをメチャクチャにする―――"

#. Occurrence 1DOT5_3:2882:1464: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0013; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:2882
msgctxt "text_id=1464 | speaker=alice"
msgid "\"Come then, puppets, let us play make-believe.\""
msgstr "「さあ―――ごっこ遊びをしましょう、お人形さん」"

#. Occurrence 1DOT5_3:2912:1465: scene=1DOT5_3
#: 1DOT5_3:2912
msgctxt "text_id=1465 | speaker=unknown"
msgid "  Her song sounded like a bell, echoing through the white woods."
msgstr "　白い森に、鐘のような<夜|うた>が響く。"

#. Occurrence 1DOT5_3:2917:1466: scene=1DOT5_3
#: 1DOT5_3:2917
msgctxt "text_id=1466 | speaker=unknown"
msgid "  The girl's voice vanquished the frost that had gripped the trees."
msgstr "　森を凍らせていた寒波が、少女の声に吹き消されていく。"

#. Occurrence 1DOT5_3:2922:1467: scene=1DOT5_3
#: 1DOT5_3:2922
msgctxt "text_id=1467 | speaker=unknown"
msgid "  Then..."
msgstr "　そして、"

#. Occurrence 1DOT5_3:3026:1468: voice_id=C20_1DOT5_3_0013; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:3026
msgctxt "text_id=1468 | speaker=unknown"
msgid "          \"Come on, don't keep us waiting!\""
msgstr "　　　　　『いやいやずいぶん待たされた！』"

#. Occurrence 1DOT5_3:3032:1469: voice_id=C30_1DOT5_3_0013; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:3032
msgctxt "text_id=1469 | speaker=unknown"
msgid "          \"Come on, it's time for Little Red Riding Hood!\""
msgstr "　　　　　『さあ―――赤ずきんの登場だ！』"

#. Occurrence 1DOT5_3:3053:1470: scene=1DOT5_3
#: 1DOT5_3:3053
msgctxt "text_id=1470 | speaker=unknown"
msgid "  The curtains opened on Diddle Diddle, the Banquet of the Night."
msgstr "　<夜の饗宴|ディドルディドル>の幕が<開|あ>く。"

#. Occurrence 1DOT5_3:3058:1471: scene=1DOT5_3
#: 1DOT5_3:3058
msgctxt "text_id=1471 | speaker=unknown"
msgid "  In confusion, one slit-mouthed man swooped toward the girl."
msgstr "　一方の口裂け男は混乱して少女へと襲いかかる。"

#. Occurrence 1DOT5_3:3063:1472: scene=1DOT5_3
#: 1DOT5_3:3063
msgctxt "text_id=1472 | speaker=unknown"
msgid "  In fear, the other fled into the woods behind him."
msgstr "　一方の口裂け男は恐怖から<森|うしろ>へと走り出す。"

#. Occurrence 1DOT5_3:3221:1473: scene=1DOT5_3
#: 1DOT5_3:3221
msgctxt "text_id=1473 | speaker=unknown"
msgid "  The deformed humanoid darted forth, kicking up water as it rushed the girl."
msgstr "　水しぶきをあげ、少女に躍りかかる<奇形|きけい>の人影。"

#. Occurrence 1DOT5_3:3226:1474: scene=1DOT5_3
#: 1DOT5_3:3226
msgctxt "text_id=1474 | speaker=unknown"
msgid "  She already knew what this fiend was."
msgstr "　少女は知っている。"

#. Occurrence 1DOT5_3:3231:1475: scene=1DOT5_3
#: 1DOT5_3:3231
msgctxt "text_id=1475 | speaker=unknown"
msgid "  The grinning figure had scissors for hands and a demon's heart."
msgstr "　この口裂け男の両手はハサミで、心は子鬼。"

#. Occurrence 1DOT5_3:3236:1476: scene=1DOT5_3
#: 1DOT5_3:3236
msgctxt "text_id=1476 | speaker=unknown"
msgid "  It was a wretch who kidnapped children, mercilessly rendering them into pieces."
msgstr "　捕まえた子供を容赦なく、胴体からまっぷたつに切る悪魔だと。"

#. Occurrence 1DOT5_3:3317:1477: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0014; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:3317
msgctxt "text_id=1477 | speaker=alice"
msgid "\"Tweedle.\""
msgstr "「トゥィードル」"

#. Occurrence 1DOT5_3:3323:1478: voice_id=C20_1DOT5_3_0014; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:3323
msgctxt "text_id=1478 | speaker=unknown"
msgid "\"Leave it to us!\""
msgstr "『お任せお任せ！』"

#. Occurrence 1DOT5_3:3330:1479: voice_id=C30_1DOT5_3_0014; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:3330
msgctxt "text_id=1479 | speaker=unknown"
msgid "\"It's finally our turn!\""
msgstr "『ようやく出番だ、あらよっと！』"

#. Occurrence 1DOT5_3:3445:1480: scene=1DOT5_3
#: 1DOT5_3:3445
msgctxt "text_id=1480 | speaker=unknown"
msgid "  The piglets bounded and rebounded, like paddle balls."
msgstr "　飛びだした子豚は<手鞠|てまり>のように。"

#. Occurrence 1DOT5_3:3450:1481: scene=1DOT5_3
#: 1DOT5_3:3450
msgctxt "text_id=1481 | speaker=unknown"
msgid "  The stuffed animals, over three feet in length, jumped and weaved their way between the trees."
msgstr "　一メートルほどのぬいぐるみは、木々の合間を躍りながらすり抜けていく。"

#. Occurrence 1DOT5_3:3601:1482: scene=1DOT5_3
#: 1DOT5_3:3601
msgctxt "text_id=1482 | speaker=unknown"
msgid "  Even with these strange creatures before him, the grinning man did not so much as blink."
msgstr "　そんな怪異を前にしても、口裂け男に迷いはない。"

#. Occurrence 1DOT5_3:3606:1483: scene=1DOT5_3
#: 1DOT5_3:3606
msgctxt "text_id=1483 | speaker=unknown"
msgid "  He raised his arms, but what emerged from his coat sleeves were not the human appendages you would expect."
msgstr "　男の両腕が上がる。長いコートの袖から現れたものは、人間の腕ではない。"

#. Occurrence 1DOT5_3:3611:1484: scene=1DOT5_3
#: 1DOT5_3:3611
msgctxt "text_id=1484 | speaker=unknown"
msgid "  In their place, fiendish cleavers, more than a foot and a half in length."
msgstr "　刃渡り五十センチを超える、凶悪な<出|デ><刃|バ><包丁|ソード>。"

#. Occurrence 1DOT5_3:3616:1485: scene=1DOT5_3
#: 1DOT5_3:3616
msgctxt "text_id=1485 | speaker=unknown"
msgid "  These appendages, which had torn so much of their prey to pieces, sliced cleanly through the flying pigs' skulls."
msgstr "　今まで多くのエモノを切り裂いてきた両腕が、跳び<交|か>う子豚たちを正面から両断する。"

#. Occurrence 1DOT5_3:3734:1486: voice_id=C60_1DOT5_3_0000; voice_prefix=C60; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:3734
msgctxt "text_id=1486 | speaker=unknown"
msgid "\"-?!\""
msgstr "“―――！？”"

#. Occurrence 1DOT5_3:3740:1487: scene=1DOT5_3
#: 1DOT5_3:3740
msgctxt "text_id=1487 | speaker=unknown"
msgid "  His limbs froze in place."
msgstr "　口裂け男の手足が凍る。"

#. Occurrence 1DOT5_3:3745:1488: scene=1DOT5_3
#: 1DOT5_3:3745
msgctxt "text_id=1488 | speaker=unknown"
msgid "  The pigs' bodies were sliced perfectly in half."
msgstr "　切られた子豚の体が割れる。"

#. Occurrence 1DOT5_3:3789:1489: scene=1DOT5_3
#: 1DOT5_3:3789
msgctxt "text_id=1489 | speaker=unknown"
msgid "  And then..."
msgstr "　がちん、と。"

#. Occurrence 1DOT5_3:3794:1490: scene=1DOT5_3
#: 1DOT5_3:3794
msgctxt "text_id=1490 | speaker=unknown"
msgid "  Bisected from head to tail, the pigs' innards became as alligator jaws and clamped down upon the grinning man's arms."
msgstr "　頭から尾っぽまで断たれた子豚は、そのまま巨大なワニの口になって、口裂け男の腕に噛みついた。"

#. Occurrence 1DOT5_3:3814:1491: scene=1DOT5_3
#: 1DOT5_3:3814
msgctxt "text_id=1491 | speaker=unknown"
msgid "  From fingertips to shoulders, they were swallowed whole."
msgstr "　文字通り、肩口まで丸飲みである。"

#. Occurrence 1DOT5_3:3819:1492: scene=1DOT5_3
#: 1DOT5_3:3819
msgctxt "text_id=1492 | speaker=unknown"
msgid "  It was all it took to rob the man of control over his entire body."
msgstr "　それだけで男から全身の自由が消失した。"

#. Occurrence 1DOT5_3:3849:1493: voice_id=C60_1DOT5_3_0001; voice_prefix=C60; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:3849
msgctxt "text_id=1493 | speaker=unknown"
msgid "\"-, -!\""
msgstr "“―――、―――！”"

#. Occurrence 1DOT5_3:3854:1494: scene=1DOT5_3
#: 1DOT5_3:3854
msgctxt "text_id=1494 | speaker=unknown"
msgid "  Another shiver of fear."
msgstr "　走る<怖気|おぞけ>。"

#. Occurrence 1DOT5_3:3859:1495: scene=1DOT5_3
#: 1DOT5_3:3859
msgctxt "text_id=1495 | speaker=unknown"
msgid "  These were no mere pig familiars."
msgstr "　コレは子豚の使い魔ではない。"

#. Occurrence 1DOT5_3:3864:1496: scene=1DOT5_3
#: 1DOT5_3:3864
msgctxt "text_id=1496 | speaker=unknown"
msgid "  Immediately he realized that these were stapler monsters disguised as mere pigs."
msgstr "　子豚のカタチをした、<文房具|ホッチキス>の化け物である事を、口裂け男は瞬時に理解した。"

#. Occurrence 1DOT5_3:3922:1497: voice_id=C20_1DOT5_3_0015; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:3922
msgctxt "text_id=1497 | speaker=unknown"
msgid "\"I got him!\""
msgstr "『捕まえたのはダムでした！』"

#. Occurrence 1DOT5_3:3930:1498: voice_id=C30_1DOT5_3_0015; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:3930
msgctxt "text_id=1498 | speaker=unknown"
msgid "\"No, I got him!\""
msgstr "『捕まえたのはディーだってば！』"

#. Occurrence 1DOT5_3:3939:1499: voice_id=C20_1DOT5_3_0016; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:3939
msgctxt "text_id=1499 | speaker=unknown"
msgid "\"Oh, but too bad Master has no words, no emotion, no interest!\""
msgstr "『ああでも残念、ご主人様は無口で無情で無関心！』"

#. Occurrence 1DOT5_3:3945:1500: voice_id=C30_1DOT5_3_0016; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:3945
msgctxt "text_id=1500 | speaker=unknown"
msgid "\"In the end, it doesn't really matter who did it!\""
msgstr "『けっきょく、どっちの手柄も同じこと！』"

#. Occurrence 1DOT5_3:4034:1501: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0015; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:4034
msgctxt "text_id=1501 | speaker=alice"
msgid "                              "
msgstr "　　　　　"

#. Occurrence 1DOT5_3:4034:1502: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0015; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:4034
msgctxt "text_id=1502 | speaker=alice"
msgid "London Bridge is broken down,"
msgstr "London Bridge is broken down,"

#. Occurrence 1DOT5_3:4034:1503: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0015; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:4034
msgctxt "text_id=1503 | speaker=alice"
msgid "                              Broken down, broken down..."
msgstr "　　　　　Broken down,broken down."

#. Occurrence 1DOT5_3:4108:1504: voice_id=C60_1DOT5_3_0002; voice_prefix=C60; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:4108
msgctxt "text_id=1504 | speaker=unknown"
msgid "\"-, Ghh!\""
msgstr "“―――、ギ”"

#. Occurrence 1DOT5_3:4114:1505: scene=1DOT5_3
#: 1DOT5_3:4114
msgctxt "text_id=1505 | speaker=unknown"
msgid "  \"Impossible!\" its presence murmured three times."
msgstr "　ありえない、と再三、口裂け男の気配が呟く。"

#. Occurrence 1DOT5_3:4120:1506: scene=1DOT5_3
#: 1DOT5_3:4120
msgctxt "text_id=1506 | speaker=unknown"
msgid "  Not possible."
msgstr "　これはなんだ。"

msgctxt "text_id=1507 | speaker=unknown"
msgid " Not possible."
msgstr "これはなんだ。"

msgctxt "text_id=1508 | speaker=unknown"
msgid " Not... possible?"
msgstr "これはなんだ？"

#. Occurrence 1DOT5_3:4145:1509: scene=1DOT5_3
#: 1DOT5_3:4145
msgctxt "text_id=1509 | speaker=unknown"
msgid "  Talking pigs were one thing."
msgstr "　喋る子豚。それはいい。"

#. Occurrence 1DOT5_3:4150:1510: scene=1DOT5_3
#: 1DOT5_3:4150
msgctxt "text_id=1510 | speaker=unknown"
msgid "  Even having one's arms chomped off was in the realm of occupational hazard."
msgstr "　肩口まで食いつかれた腕。それもいい。"

#. Occurrence 1DOT5_3:4156:1511: scene=1DOT5_3
#: 1DOT5_3:4156
msgctxt "text_id=1511 | speaker=unknown"
msgid "  In an instant, the wood was enveloped in a dense wave of magical energy."
msgstr "　一瞬で森を<覆|おお>った、あまりにも濃密な魔力の波。"

msgctxt "text_id=1512 | speaker=unknown"
msgid "^Though vexing, it was still impressive."
msgstr "<忌々|いまいま>しいが、素晴らしい。"

#. Occurrence 1DOT5_3:4178:1513: scene=1DOT5_3
#: 1DOT5_3:4178
msgctxt "text_id=1513 | speaker=unknown"
msgid "  None of these facts were particularly extraordinary."
msgstr "　しかし、それらは別段、驚くに値しない。"

#. Occurrence 1DOT5_3:4183:1514: scene=1DOT5_3
#: 1DOT5_3:4183
msgctxt "text_id=1514 | speaker=unknown"
msgid "  These rare familiars, their bizarre attack, the sheer innate magical energy to overwhelm others..."
msgstr "　稀少な使い魔、猟奇的な攻撃、他を圧する天賦の魔力。"

#. Occurrence 1DOT5_3:4188:1515: scene=1DOT5_3
#: 1DOT5_3:4188
msgctxt "text_id=1515 | speaker=unknown"
msgid "  He had experience with all these things."
msgstr "　そういったモノは彼らにも覚えがあるのだ。"

#. Occurrence 1DOT5_3:4193:1516: scene=1DOT5_3
#: 1DOT5_3:4193
msgctxt "text_id=1516 | speaker=unknown"
msgid "  His employer was skilled enough to achieve all of this as well."
msgstr "　何しろ彼らの雇い主が、その<類|たぐい>の異人である。"

#. Occurrence 1DOT5_3:4219:1517: scene=1DOT5_3
#: 1DOT5_3:4219
msgctxt "text_id=1517 | speaker=unknown"
msgid "  However..."
msgstr "　しかし―――"

#. Occurrence 1DOT5_3:4258:1518: voice_id=C20_1DOT5_3_0017; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:4258
msgctxt "text_id=1518 | speaker=unknown"
msgid "\"What now? What now? How long should we hold him like this?\""
msgstr "『どうするどうする、いつまで放置？』"

#. Occurrence 1DOT5_3:4265:1519: voice_id=C30_1DOT5_3_0017; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:4265
msgctxt "text_id=1519 | speaker=unknown"
msgid "\"Even a blink of an eye is too long! Let's take an arm. \""
msgstr "『手足一本、まばたきだって贅沢だ！』"

#. Occurrence 1DOT5_3:4302:1520: voice_id=C20_1DOT5_3_0018; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:4302
msgctxt "text_id=1520 | speaker=unknown"
msgid "\"I'll give you a good price if you'll pay me in pounds!\""
msgstr "『お支払いは面倒でも、できればポンドでお願いします！』"

#. Occurrence 1DOT5_3:4350:1521: scene=1DOT5_3
#: 1DOT5_3:4350
msgctxt "text_id=1521 | speaker=unknown"
msgid "  What... were they?"
msgstr "　コレは、なんだ。"

#. Occurrence 1DOT5_3:4355:1522: scene=1DOT5_3
#: 1DOT5_3:4355
msgctxt "text_id=1522 | speaker=unknown"
msgid "  Not vessels."
msgstr "　器物でもない。"

#. Occurrence 1DOT5_3:4360:1523: scene=1DOT5_3
#: 1DOT5_3:4360
msgctxt "text_id=1523 | speaker=unknown"
msgid "  Not living creatures."
msgstr "　生物でもない。"

#. Occurrence 1DOT5_3:4365:1524: scene=1DOT5_3
#: 1DOT5_3:4365
msgctxt "text_id=1524 | speaker=unknown"
msgid "  Not beings powered by Magic Circuits."
msgstr "　魔術回路によって動くクリーチャーですらない。"

#. Occurrence 1DOT5_3:4457:1525: scene=1DOT5_3
#: 1DOT5_3:4457
msgctxt "text_id=1525 | speaker=unknown"
msgid "  Even though only his arms had been bitten, none of his body would move."
msgstr "　噛まれた箇所は両腕だけだというのに、全身が動かない。"

#. Occurrence 1DOT5_3:4462:1526: scene=1DOT5_3
#: 1DOT5_3:4462
msgctxt "text_id=1526 | speaker=unknown"
msgid "  It was nothing like being bound or weakened."
msgstr "　金縛りや衰弱とはまるで違う。"

#. Occurrence 1DOT5_3:4467:1527: scene=1DOT5_3
#: 1DOT5_3:4467
msgctxt "text_id=1527 | speaker=unknown"
msgid "  This felt more like he had become words written in a book, fated to keep to their page."
msgstr "　まるで自分が<本|・><に|・><書|・><か|・><れ|・><た|・><文|・><字|・>になってしまったような、もうどこにも行けない感覚。"

#. Occurrence 1DOT5_3:4524:1528: scene=1DOT5_3
#: 1DOT5_3:4524
msgctxt "text_id=1528 | speaker=unknown"
msgid "  As the grinning figure's deformities indicated, he had overcome numerous curiosities and monstrosities."
msgstr "　この口裂け男とて、その<奇形|きけい>が<示|しめ>す通り、幾たびの怪異を越えてきた。"

#. Occurrence 1DOT5_3:4529:1529: scene=1DOT5_3
#: 1DOT5_3:4529
msgctxt "text_id=1529 | speaker=unknown"
msgid "  Illusions, enthrallment, compulsions..."
msgstr "　<幻惑|げんわく>、<魅了|みりょう>、<強制|きょうせい>。"

#. Occurrence 1DOT5_3:4534:1530: scene=1DOT5_3
#: 1DOT5_3:4534
msgctxt "text_id=1530 | speaker=unknown"
msgid "  Freezings, putrefactions, and even petrifications-a power granted to only the pinnacle of Mystic Eyes..."
msgstr "　<氷結|ひょうけつ>、<屍蝋|しろう>、はては<魔眼|まがん>の最奥である石化まで。"

#. Occurrence 1DOT5_3:4539:1531: scene=1DOT5_3
#: 1DOT5_3:4539
msgctxt "text_id=1531 | speaker=unknown"
msgid "  From poisons to magecraft, he had weathered a great deal."
msgstr "　薬物から魔術、多くの<戒|いまし>めを経験した彼は叫ぶ。"

#. Occurrence 1DOT5_3:4544:1532: scene=1DOT5_3
#: 1DOT5_3:4544
msgctxt "text_id=1532 | speaker=unknown"
msgid "  But this was something different altogether."
msgstr "　これは違う。違うものだ、と。"

#. Occurrence 1DOT5_3:4633:1533: scene=1DOT5_3
#: 1DOT5_3:4633
msgctxt "text_id=1533 | speaker=unknown"
msgid "  The penalty that bound him now"
msgstr "　いま彼を縛る戒めは、"

msgctxt "text_id=1534 | speaker=unknown"
msgid "  was based on different principles from blood, flesh, oxygen, or heat."
msgstr "　血液、筋肉、酸素、熱量とは別の法則。"

#. Occurrence 1DOT5_3:4640:1535: scene=1DOT5_3
#: 1DOT5_3:4640
msgctxt "text_id=1535 | speaker=unknown"
msgid "  It was an unknown restraint that followed no rules he knew."
msgstr "　どのルールにも当てはまらない未知の束縛。"

#. Occurrence 1DOT5_3:4646:1536: scene=1DOT5_3
#: 1DOT5_3:4646
msgctxt "text_id=1536 | speaker=unknown"
msgid "  Indeed, though it was terrifying to admit..."
msgstr "　……ああ、口にするのもおぞましいが。"

#. Occurrence 1DOT5_3:4652:1537: scene=1DOT5_3
#: 1DOT5_3:4652
msgctxt "text_id=1537 | speaker=unknown"
msgid "  It was as if he'd encountered something alien to everything in this world."
msgstr "　まるで、この世のすべてと<乖離|かいり>している。"

#. Occurrence 1DOT5_3:4755:1538: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0016; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:4755
msgctxt "text_id=1538 | speaker=alice"
msgid "                                "
msgstr "　　　　　　"

#. Occurrence 1DOT5_3:4755:1539: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0016; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:4755
msgctxt "text_id=1539 | speaker=alice"
msgid "London Bridge is broken down,"
msgstr "London Bridge is broken down,"

#. Occurrence 1DOT5_3:4755:1540: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0016; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:4755
msgctxt "text_id=1540 | speaker=alice"
msgid "                                Broken down, broken down."
msgstr "　　　　　　Broken down,broken down."

#. Occurrence 1DOT5_3:4755:1541: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0016; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:4755
msgctxt "text_id=1541 | speaker=alice"
msgid "                                London Bridge is broken down,"
msgstr "　　　　　　London Bridge is broken down,"

#. Occurrence 1DOT5_3:4755:1542: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0016; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:4755
msgctxt "text_id=1542 | speaker=alice"
msgid "                                My fair lady."
msgstr "　　　　　　My fair lady."

#. Occurrence 1DOT5_3:4833:1543: voice_id=C60_1DOT5_3_0003; voice_prefix=C60; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:4833
msgctxt "text_id=1543 | speaker=unknown"
msgid "\"Gh―\""
msgstr "“ギ―――”"

#. Occurrence 1DOT5_3:4841:1544: scene=1DOT5_3
#: 1DOT5_3:4841
msgctxt "text_id=1544 | speaker=unknown"
msgid "  Fangs sank into his left and right shoulders."
msgstr "　左右の肩口に食いこむ牙。"

#. Occurrence 1DOT5_3:4846:1545: scene=1DOT5_3
#: 1DOT5_3:4846
msgctxt "text_id=1545 | speaker=unknown"
msgid "  For the first time in this form, he felt rage seethe up inside him."
msgstr "　彼はこのカタチとして生まれてから、はじめて怒りの<感情|いし>を覚えた。"

#. Occurrence 1DOT5_3:4866:1546: scene=1DOT5_3
#: 1DOT5_3:4866
msgctxt "text_id=1546 | speaker=unknown"
msgid "  ...The basis of all things had to be absolute."
msgstr "　……基準は絶対でなければならない。"

#. Occurrence 1DOT5_3:4871:1547: scene=1DOT5_3
#: 1DOT5_3:4871
msgctxt "text_id=1547 | speaker=unknown"
msgid "  All Mystics, all things bizarre obeyed some set of laws."
msgstr "　いかな神秘、いかな怪奇にも法則はある。"

#. Occurrence 1DOT5_3:4876:1548: scene=1DOT5_3
#: 1DOT5_3:4876
msgctxt "text_id=1548 | speaker=unknown"
msgid "  But these pigs ignored this, along with his dignity."
msgstr "　コレらはそんな、彼らの<矜持|きょうじ>を無視するものだ。"

#. Occurrence 1DOT5_3:4947:1549: voice_id=C20_1DOT5_3_0019; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:4947
msgctxt "text_id=1549 | speaker=unknown"
msgid "\"After three days you weaken!\""
msgstr "『さあ、三日で衰弱！』"

#. Occurrence 1DOT5_3:4953:1550: voice_id=C30_1DOT5_3_0018; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:4953
msgctxt "text_id=1550 | speaker=unknown"
msgid "      \"After six, you drown!\""
msgstr "　　　『六日で溺死！』"

#. Occurrence 1DOT5_3:4959:1551: voice_id=C20_1DOT5_3_0020; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:4959
msgctxt "text_id=1551 | speaker=unknown"
msgid "\"After half a year, you'll be a wretched skeleton!\""
msgstr "『半年たてば<惨|みじ>めな<骸骨|がいこつ>！』"

#. Occurrence 1DOT5_3:4966:1552: voice_id=X10_1DOT5_3_0001; voice_prefix=X10; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:4966
msgctxt "text_id=1552 | speaker=unknown"
msgid "\"\"Sorry to be rude, but we'll just kill you now!\"\""
msgstr "『『でもでもご無礼、面倒だからいま殺そうか！』』"

#. Occurrence 1DOT5_3:5058:1553: voice_id=C60_1DOT5_3_0004; voice_prefix=C60; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:5058
msgctxt "text_id=1553 | speaker=unknown"
msgid "\"SSSSHHHHHHHHHHH!!!\""
msgstr "“シィィィィィィイイイイイ！！！！！！”"

#. Occurrence 1DOT5_3:5074:1554: scene=1DOT5_3
#: 1DOT5_3:5074
msgctxt "text_id=1554 | speaker=unknown"
msgid "  A howl."
msgstr "　吠えた。"

#. Occurrence 1DOT5_3:5079:1555: scene=1DOT5_3
#: 1DOT5_3:5079
msgctxt "text_id=1555 | speaker=unknown"
msgid "  Though he had no voice, he let out an exasperated scream."
msgstr "　口のないものが、<憤怒|ふんぬ>の叫びを響かせる。"

#. Occurrence 1DOT5_3:5174:1556: voice_id=C20_1DOT5_3_0021; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:5174
msgctxt "text_id=1556 | speaker=unknown"
msgid "\"Huh?\""
msgstr "『うげ？』"

#. Occurrence 1DOT5_3:5180:1557: voice_id=C30_1DOT5_3_0019; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:5180
msgctxt "text_id=1557 | speaker=unknown"
msgid "\"Huh?!\""
msgstr "『うげげ！？』"

#. Occurrence 1DOT5_3:5186:1558: voice_id=C20_1DOT5_3_0022; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:5186
msgctxt "text_id=1558 | speaker=unknown"
msgid "\"What a convenient function, to be able to detach your arms!\""
msgstr "『なんて便利、自分の腕を<外|はず>せる<機構|きこう>！』"

#. Occurrence 1DOT5_3:5192:1559: voice_id=C30_1DOT5_3_0020; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:5192
msgctxt "text_id=1559 | speaker=unknown"
msgid "\"What an unparalleled warrior!\""
msgstr "『おお、オマエこそ三国一のモノノフよー！』"

#. Occurrence 1DOT5_3:5296:1560: scene=1DOT5_3
#: 1DOT5_3:5296
msgctxt "text_id=1560 | speaker=unknown"
msgid "  The talkative pigs fell into the stream."
msgstr "　お喋りな子豚たちは小川に落ちた。"

#. Occurrence 1DOT5_3:5301:1561: scene=1DOT5_3
#: 1DOT5_3:5301
msgctxt "text_id=1561 | speaker=unknown"
msgid "  That exasperated scream was the sound of the figure tearing his arms from their sockets."
msgstr "　憤怒の<声|おと>は、自ら両肩を破壊した炸裂音だ。"

#. Occurrence 1DOT5_3:5306:1562: scene=1DOT5_3
#: 1DOT5_3:5306
msgctxt "text_id=1562 | speaker=unknown"
msgid "  Armless, he rushed the girl."
msgstr "　両腕を失ってなお、口裂け男は少女へと走る。"

#. Occurrence 1DOT5_3:5319:1563: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0017; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:5319
msgctxt "text_id=1563 | speaker=alice"
msgid "\"...Useless swine. I'll see you be punished later.\""
msgstr "「……役立たず。後でおしおきが必要ね」"

#. Occurrence 1DOT5_3:5361:1564: scene=1DOT5_3
#: 1DOT5_3:5361
msgctxt "text_id=1564 | speaker=unknown"
msgid "  He may have lost his mangled arms, but not the object of his malice."
msgstr "　もはや切りきざむ腕はないが、彼には最大の悪意が残っている。"

#. Occurrence 1DOT5_3:5526:1565: scene=1DOT5_3
#: 1DOT5_3:5526
msgctxt "text_id=1565 | speaker=unknown"
msgid "  A Mystic Eye to pierce the heart of its victim."
msgstr "　<睨|にら>んだ者の心臓を<射|い><止|と>める魔眼。"

#. Occurrence 1DOT5_3:5531:1566: scene=1DOT5_3
#: 1DOT5_3:5531
msgctxt "text_id=1566 | speaker=unknown"
msgid "  A Magic Circuit designed to stop a beating heart."
msgstr "　心筋を<梗塞|こうそく>させる事のみに特化した魔術回路。"

#. Occurrence 1DOT5_3:5536:1567: scene=1DOT5_3
#: 1DOT5_3:5536
msgctxt "text_id=1567 | speaker=unknown"
msgid "  It was beautiful in its simplicity. At point-blank range, it was the equivalent of an unavoidable shotgun blast."
msgstr "　<単純|シンプル>ではあるが、だからこそ、この至近距離で放てば回避は不可能な死の<散弾|ショットガン>。"

#. Occurrence 1DOT5_3:5740:1568: voice_id=C60_1DOT5_3_0005; voice_prefix=C60; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:5740
msgctxt "text_id=1568 | speaker=unknown"
msgid "\"...?\""
msgstr "“―――？”"

#. Occurrence 1DOT5_3:5746:1569: scene=1DOT5_3
#: 1DOT5_3:5746
msgctxt "text_id=1569 | speaker=unknown"
msgid "  But..."
msgstr "　だが。"

#. Occurrence 1DOT5_3:5751:1570: scene=1DOT5_3
#: 1DOT5_3:5751
msgctxt "text_id=1570 | speaker=unknown"
msgid "  Tragically, that eye was all he had."
msgstr "　不幸な事に、彼には目しかなく。"

#. Occurrence 1DOT5_3:5781:1571: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0018; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:5781
msgctxt "text_id=1571 | speaker=alice"
msgid "                          "
msgstr "　　　　"

#. Occurrence 1DOT5_3:5781:1572: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0018; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:5781
msgctxt "text_id=1572 | speaker=alice"
msgid "Build it up with wood and clay,"
msgstr "Build it up with wood and clay,"

#. Occurrence 1DOT5_3:5781:1573: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0018; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:5781
msgctxt "text_id=1573 | speaker=alice"
msgid "                          Wood and clay, Wood and clay,"
msgstr "　　　　Wood and clay,Wood and clay,"

#. Occurrence 1DOT5_3:5781:1574: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0018; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:5781
msgctxt "text_id=1574 | speaker=alice"
msgid "                          Build it up with wood and clay,"
msgstr "　　　　Build it up with wood and clay,"

#. Occurrence 1DOT5_3:5781:1575: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0018; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:5781
msgctxt "text_id=1575 | speaker=alice"
msgid "                          My fair lady."
msgstr "　　　　My fair lady."

#. Occurrence 1DOT5_3:5802:1576: scene=1DOT5_3
#: 1DOT5_3:5802
msgctxt "text_id=1576 | speaker=unknown"
msgid "  He failed to realize that her song had changed."
msgstr "　少女の唄が違うものになっていた事に、最後まで気づかなかった。"

#. Occurrence 1DOT5_3:5917:1577: scene=1DOT5_3
#: 1DOT5_3:5917
msgctxt "text_id=1577 | speaker=unknown"
msgid "  For the giant, the earth-shattering strike was akin to the act of shooing away an insect."
msgstr "　ソレにとって大地を震わす一撃は、虫を払った程度のものでしかない。"

#. Occurrence 1DOT5_3:5938:1578: scene=1DOT5_3
#: 1DOT5_3:5938
msgctxt "text_id=1578 | speaker=unknown"
msgid "  Its green, verdant veins pulsed."
msgstr "　隆々とわきたつ緑の血管。"

#. Occurrence 1DOT5_3:5943:1579: scene=1DOT5_3
#: 1DOT5_3:5943
msgctxt "text_id=1579 | speaker=unknown"
msgid "  Oaken bark covered its body, hardened sufficiently over centuries to repel even a chainsaw."
msgstr "　<乾|かわ>き、何百年という時を<食|は>み、電動の<回転刃|チェインソー>すら<弾|はじ>く<樫|かし>の皮。"

#. Occurrence 1DOT5_3:5948:1580: scene=1DOT5_3
#: 1DOT5_3:5948
msgctxt "text_id=1580 | speaker=unknown"
msgid "  On its forehead, inscribed in all manner of colors, was the word \"emeth,\" though judging from its misspelling, the inscription was purely decorative."
msgstr "　額には色とりどりの絵の具で落書きされた「emeth」の文字。……ところどころ間違った、お約束にすぎない綴りではあるが。"

#. Occurrence 1DOT5_3:6103:1581: scene=1DOT5_3
#: 1DOT5_3:6103
msgctxt "text_id=1581 | speaker=unknown"
msgid "  The Thames Troll."
msgstr "　その姿こそテムズトロル。"

#. Occurrence 1DOT5_3:6108:1582: scene=1DOT5_3
#: 1DOT5_3:6108
msgctxt "text_id=1582 | speaker=unknown"
msgid "  It also went by the moniker Falling Down."
msgstr "　あるいはフォーリンダウン。"

#. Occurrence 1DOT5_3:6113:1583: scene=1DOT5_3
#: 1DOT5_3:6113
msgctxt "text_id=1583 | speaker=unknown"
msgid "  Or alternatively, the Great Bridge."
msgstr "　またの名をグレートブリッジ。"

#. Occurrence 1DOT5_3:6118:1584: scene=1DOT5_3
#: 1DOT5_3:6118
msgctxt "text_id=1584 | speaker=unknown"
msgid "  Admired in different forms, it was the first of four miracles."
msgstr "　<数多|あまた><異形|いぎょう>に賞賛される、四つの奇蹟の最初のいっぽ。"

#. Occurrence 1DOT5_3:6205:1585: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0019; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:6205
msgctxt "text_id=1585 | speaker=alice"
msgid "\"Thames, please take care of the other one.\""
msgstr "「テムズ、もう一体をお願い」"

#. Occurrence 1DOT5_3:6230:1586: scene=1DOT5_3
#: 1DOT5_3:6230
msgctxt "text_id=1586 | speaker=unknown"
msgid "  The giant responded to the girl's words."
msgstr "　少女の言葉に巨人が応える。"

#. Occurrence 1DOT5_3:6235:1587: scene=1DOT5_3
#: 1DOT5_3:6235
msgctxt "text_id=1587 | speaker=unknown"
msgid "  With roots rent deep into the earth, it raised its left arm to the heavens without moving a step."
msgstr "　地に根を張った緑の巨人は一歩も動かず、その左腕を天に<掲|かか>げ―――"

#. Occurrence 1DOT5_3:6426:1588: voice_id=C50_1DOT5_3_0016; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:6426
msgctxt "text_id=1588 | speaker=unknown"
msgid "\"-, -\""
msgstr "“―――、―――”"

#. Occurrence 1DOT5_3:6432:1589: scene=1DOT5_3
#: 1DOT5_3:6432
msgctxt "text_id=1589 | speaker=unknown"
msgid "  Elsewhere in the forest..."
msgstr "　一方。"

#. Occurrence 1DOT5_3:6437:1590: scene=1DOT5_3
#: 1DOT5_3:6437
msgctxt "text_id=1590 | speaker=unknown"
msgid "  The grinning figure who had chosen to flee the battle was running through the night forest at full speed."
msgstr "　交戦と同時に逃げ出した口裂け男は、夜の森をひた走っていた。"

#. Occurrence 1DOT5_3:6442:1591: scene=1DOT5_3
#: 1DOT5_3:6442
msgctxt "text_id=1591 | speaker=unknown"
msgid "  Record and provide a detailed description of the enemy."
msgstr "　相手を記録し、記述する事。"

#. Occurrence 1DOT5_3:6447:1592: scene=1DOT5_3
#: 1DOT5_3:6447
msgctxt "text_id=1592 | speaker=unknown"
msgid "  Those were the orders assigned to him."
msgstr "　それが、彼が己に課した<使命|オーダー>である。"

#. Occurrence 1DOT5_3:6509:1593: scene=1DOT5_3
#: 1DOT5_3:6509
msgctxt "text_id=1593 | speaker=unknown"
msgid "  He poured all of his energy into escaping this forest with which he had become so familiar."
msgstr "　住み慣れた森を全力で逃げていく。"

#. Occurrence 1DOT5_3:6514:1594: scene=1DOT5_3
#: 1DOT5_3:6514
msgctxt "text_id=1594 | speaker=unknown"
msgid "  In case of emergency, the plan was for one to challenge the enemy while the other made a tactical retreat in order to report to their master."
msgstr "　有事の際は一体が敵に挑み、もう一体は撤退し、雇い主に報告するのが彼らの戦術だった。"

#. Occurrence 1DOT5_3:6520:1595: scene=1DOT5_3
#: 1DOT5_3:6520
msgctxt "text_id=1595 | speaker=unknown"
msgid "  He dashed through the forest."
msgstr "　森を駆ける事。"

#. Occurrence 1DOT5_3:6525:1596: scene=1DOT5_3
#: 1DOT5_3:6525
msgctxt "text_id=1596 | speaker=unknown"
msgid "  Though gripped by fear, he was confident in his ability to perform the mission he was designed for."
msgstr "　逃げる事だけに機能を特化させた口裂け男は、恐怖に縛られながらも、自身の勝ちを確信した。"

#. Occurrence 1DOT5_3:6628:1597: scene=1DOT5_3
#: 1DOT5_3:6628
msgctxt "text_id=1597 | speaker=unknown"
msgid "  Nothing could catch him in these woods."
msgstr "　森で彼に追いつけるモノはいない。"

#. Occurrence 1DOT5_3:6633:1598: scene=1DOT5_3
#: 1DOT5_3:6633
msgctxt "text_id=1598 | speaker=unknown"
msgid "  Even the wolves could not track him."
msgstr "　野生の狼ですら、離されないよう追尾するのがやっとだろう。"

#. Occurrence 1DOT5_3:6638:1599: scene=1DOT5_3
#: 1DOT5_3:6638
msgctxt "text_id=1599 | speaker=unknown"
msgid "  His bird-like legs thumped as they kicked the ground."
msgstr "　カッカッ、と地面を蹴る鳥形の脚。"

#. Occurrence 1DOT5_3:6643:1600: scene=1DOT5_3
#: 1DOT5_3:6643
msgctxt "text_id=1600 | speaker=unknown"
msgid "  Perhaps it was his creator's eccentric tastes that dictated their form when optimizing them for running."
msgstr "　制作者の<偏|かたよ>った趣味なのか、走行のみに特化した場合、彼の脚はこのように変形する。"

#. Occurrence 1DOT5_3:6749:1601: scene=1DOT5_3
#: 1DOT5_3:6749
msgctxt "text_id=1601 | speaker=unknown"
msgid "  The grinning man could reach a maximum speed of 45 miles per hour,"
msgstr "　最高時速70キロ。"

#. Occurrence 1DOT5_3:6754:1602: scene=1DOT5_3
#: 1DOT5_3:6754
msgctxt "text_id=1602 | speaker=unknown"
msgid "  well past the limit of any bipedal creature."
msgstr "　二足歩行生物の限界を超えながら森を行く口裂け男。"

#. Occurrence 1DOT5_3:6759:1603: scene=1DOT5_3
#: 1DOT5_3:6759
msgctxt "text_id=1603 | speaker=unknown"
msgid "  After securing a distance of several miles, he turned around to confirm his safety."
msgstr "　彼は数キロもの距離をとり、背後の安全を確認した。"

#. Occurrence 1DOT5_3:6813:1604: scene=1DOT5_3
#: 1DOT5_3:6813
msgctxt "text_id=1604 | speaker=unknown"
msgid "  ...There was no sign of pursuit."
msgstr "　……追ってくるモノはいない。"

#. Occurrence 1DOT5_3:6818:1605: scene=1DOT5_3
#: 1DOT5_3:6818
msgctxt "text_id=1605 | speaker=unknown"
msgid "  His crescent-shaped mouth―nay, eye―slackened in relief."
msgstr "　三日月型の口―――いや、目がほう、と安堵に<緩|ゆる>む。"

#. Occurrence 1DOT5_3:6841:1606: scene=1DOT5_3
#: 1DOT5_3:6841
msgctxt "text_id=1606 | speaker=unknown"
msgid "  And then..."
msgstr "　そうして。"

#. Occurrence 1DOT5_3:6848:1607: voice_id=C50_1DOT5_3_0017; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:6848
msgctxt "text_id=1607 | speaker=unknown"
msgid "\"-?\""
msgstr "“―――？”"

#. Occurrence 1DOT5_3:6880:1608: scene=1DOT5_3
#: 1DOT5_3:6880
msgctxt "text_id=1608 | speaker=unknown"
msgid "  After facing forward once more, he looked up to lock eyes with his doom."
msgstr "　前方に体を向き直した時、彼は自らの死を見上げた。"

#. Occurrence 1DOT5_3:6910:1609: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0020; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:6910
msgctxt "text_id=1609 | speaker=alice"
msgid "                                "
msgstr "　　　　　　"

#. Occurrence 1DOT5_3:6910:1610: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0020; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:6910
msgctxt "text_id=1610 | speaker=alice"
msgid "London Bridge is broken down,"
msgstr "London Bridge is broken down,"

#. Occurrence 1DOT5_3:6910:1611: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0020; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:6910
msgctxt "text_id=1611 | speaker=alice"
msgid "                                Broken down, broken down..."
msgstr "　　　　　　Broken down,broken down―――"

#. Occurrence 1DOT5_3:6971:1612: scene=1DOT5_3
#: 1DOT5_3:6971
msgctxt "text_id=1612 | speaker=unknown"
msgid "  In the distance, he could hear the dark rhymes of Mother Goose."
msgstr "　彼方から聞こえる<暗黒童話|マザーグース>。"

#. Occurrence 1DOT5_3:6976:1613: scene=1DOT5_3
#: 1DOT5_3:6976
msgctxt "text_id=1613 | speaker=unknown"
msgid "  Countless vines extended from the ground."
msgstr "　地面から伸びた無数の<蔓|つる>。"

#. Occurrence 1DOT5_3:6981:1614: scene=1DOT5_3
#: 1DOT5_3:6981
msgctxt "text_id=1614 | speaker=unknown"
msgid "  They formed into a monstrosity that conjured up images of an arched bridge, something resembling a giant arm."
msgstr "　<橋|アーチ>を思わせる怪異は、さながら、巨大な腕に似て―――"

#. Occurrence 1DOT5_3:7088:1615: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0021; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:7088
msgctxt "text_id=1615 | speaker=alice"
msgid "                                "
msgstr "　　　　　　"

msgctxt "text_id=1616 | speaker=unknown"
msgid "London Bridge is broken down,"
msgstr "London Bridge is broken down,"

msgctxt "text_id=1617 | speaker=unknown"
msgid "                                My fair lady."
msgstr "　　　　　　My fair lady."

#. Occurrence 1DOT5_3:7205:1618: voice_id=C50_1DOT5_3_0018; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7205
msgctxt "text_id=1618 | speaker=unknown"
msgid "  FINAL REPORT."
msgstr "　最終報告。"

#. Occurrence 1DOT5_3:7212:1619: voice_id=C50_1DOT5_3_0019; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7212
msgctxt "text_id=1619 | speaker=unknown"
msgid "  SURVIVAL: UNABLE TO COMPLETE."
msgstr "　生還ハ　困難。"

#. Occurrence 1DOT5_3:7218:1620: voice_id=C50_1DOT5_3_0020; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7218
msgctxt "text_id=1620 | speaker=unknown"
msgid "  ANALYSIS: UNABLE TO COMPLETE."
msgstr "　解析ハ　困難。"

#. Occurrence 1DOT5_3:7224:1621: voice_id=C50_1DOT5_3_0021; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7224
msgctxt "text_id=1621 | speaker=unknown"
msgid "  TRANSMISSION: UNABLE TO COMPLETE."
msgstr "　転送ハ　困難。"

#. Occurrence 1DOT5_3:7230:1622: voice_id=C50_1DOT5_3_0022; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7230
msgctxt "text_id=1622 | speaker=unknown"
msgid "  ENDING SESSION..."
msgstr "　状況ヲ　終了シマス。"

#. Occurrence 1DOT5_3:7237:1623: voice_id=C50_1DOT5_3_0023; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7237
msgctxt "text_id=1623 | speaker=unknown"
msgid "  AAAH. OH, MASTER. PRESERVE ME FROM-"
msgstr "　Ａａａａａ。主ヨ。ドウカ、コノ身ヲ、護リ―――"

#. Occurrence 1DOT5_3:7439:1624: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0022; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:7439
msgctxt "text_id=1624 | speaker=alice"
msgid "\"...I think we're about done here. Well done, Thames. You can return now."
msgstr "「……済んだようね。お疲れさま、戻ってテムズ。"

#. Occurrence 1DOT5_3:7451:1625: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0023; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:7451
msgctxt "text_id=1625 | speaker=alice"
msgid "  Hopefully, our next encounter will be more worth our time.\""
msgstr "　次はもっと、高価な場所ならいいのだけど」"

#. Occurrence 1DOT5_3:7535:1626: scene=1DOT5_3
#: 1DOT5_3:7535
msgctxt "text_id=1626 | speaker=unknown"
msgid "  The girl turned on her heel."
msgstr "　少女は踵を返す。"

#. Occurrence 1DOT5_3:7540:1627: scene=1DOT5_3
#: 1DOT5_3:7540
msgctxt "text_id=1627 | speaker=unknown"
msgid "  The invaders who had set up shop in the woods were eliminated."
msgstr "　この森に工房を構えた外敵は消し去った。"

#. Occurrence 1DOT5_3:7545:1628: scene=1DOT5_3
#: 1DOT5_3:7545
msgctxt "text_id=1628 | speaker=unknown"
msgid "  She had no interest in whether they had been good or evil, nor how many victims they had claimed."
msgstr "　彼らが善悪どちらのもので、どれだけの被害者を築き上げてきたか、少女には関心のない事だ。"

#. Occurrence 1DOT5_3:7550:1629: scene=1DOT5_3
#: 1DOT5_3:7550
msgctxt "text_id=1629 | speaker=unknown"
msgid "  The shackles of civic society held no sway over her."
msgstr "　人間社会のしがらみに関心は持たない。"

#. Occurrence 1DOT5_3:7555:1630: scene=1DOT5_3
#: 1DOT5_3:7555
msgctxt "text_id=1630 | speaker=unknown"
msgid "  This was the way of a pure-blooded witch, the way of a Meinster."
msgstr "　それが純血の魔女、マインスターのあり方だ。"

#. Occurrence 1DOT5_3:7640:1631: voice_id=C20_1DOT5_3_0023; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7640
msgctxt "text_id=1631 | speaker=unknown"
msgid "\"Hey, what about us!? What about us!?\""
msgstr "『ちょ、ボクたちは！？　ねえボクたちは！？』"

#. Occurrence 1DOT5_3:7648:1632: voice_id=C30_1DOT5_3_0021; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7648
msgctxt "text_id=1632 | speaker=unknown"
msgid "\"Help me get this arm outta my teeth!\""
msgstr "『腕、この腕ぬけないんだけど！』"

#. Occurrence 1DOT5_3:7654:1633: voice_id=C20_1DOT5_3_0024; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7654
msgctxt "text_id=1633 | speaker=unknown"
msgid "\"We really shouldn't move while we're eating.\""
msgstr "『噛んだままだとボクらも動けないっていうかさあ』"

#. Occurrence 1DOT5_3:7662:1634: voice_id=C30_1DOT5_3_0022; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7662
msgctxt "text_id=1634 | speaker=unknown"
msgid "\"Don't tell us you don't need pigs that can't fly!\""
msgstr "『ひどい、飛べないブタに用はないと！？』"

#. Occurrence 1DOT5_3:7669:1635: voice_id=C20_1DOT5_3_0025; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7669
msgctxt "text_id=1635 | speaker=unknown"
msgid "\"W-We'll do a better job next time, though we're nothing but screw-ups!\""
msgstr "『次、次はお役に立ちますきっと！　生まれてこの方、失敗続きのボクらだけど！』"

#. Occurrence 1DOT5_3:7677:1636: voice_id=C30_1DOT5_3_0023; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7677
msgctxt "text_id=1636 | speaker=unknown"
msgid "\"Yeah, you owe us at least one compliment before the end!\""
msgstr "『うん、壊れるまでに一度ぐらいは褒められたいね！』"

#. Occurrence 1DOT5_3:7760:1637: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0024; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:7760
msgctxt "text_id=1637 | speaker=alice"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence 1DOT5_3:7770:1638: scene=1DOT5_3
#: 1DOT5_3:7770
msgctxt "text_id=1638 | speaker=unknown"
msgid "  The girl let out a sigh and stepped into the stream. She removed her gloves and dipped her slender fingers into the ice water."
msgstr "　少女はため息をついて小川に足を運ぶと、黒い手袋をとって、細い指を氷水に浸した。"

#. Occurrence 1DOT5_3:7831:1639: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0025; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:7831
msgctxt "text_id=1639 | speaker=alice"
msgid "\"I told you not to roll sixes."
msgstr "「六の目はだすなって言うけど。"

#. Occurrence 1DOT5_3:7838:1640: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0026; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:7838
msgctxt "text_id=1640 | speaker=alice"
msgid "But I suppose it is the only number you can roll.\""
msgstr "六の目しかでないようになってるわよね、貴方たち」"

#. Occurrence 1DOT5_3:7858:1641: scene=1DOT5_3
#: 1DOT5_3:7858
msgctxt "text_id=1641 | speaker=unknown"
msgid "  There was no response to her melancholy tone."
msgstr "　憂鬱な呟きに、<応|こた>えの声はない。"

#. Occurrence 1DOT5_3:7863:1642: scene=1DOT5_3
#: 1DOT5_3:7863
msgctxt "text_id=1642 | speaker=unknown"
msgid "  In place of the once-boisterous pigs were two black dice, now sitting in the palm of her hand."
msgstr "　あれほど騒がしかった子豚は影も形もなく、少女の手のひらには黒い<賽子|ダイス>が二つだけ。"

#. Occurrence 1DOT5_3:7868:1643: scene=1DOT5_3
#: 1DOT5_3:7868
msgctxt "text_id=1643 | speaker=unknown"
msgid "  As the girl was about to say something to the scattered remains around her, she realized something that made her put a hand to her mouth."
msgstr "　少女は散らばった残骸に声をかけようとして、あ、と口元に手を当てた。"

#. Occurrence 1DOT5_3:7908:1644: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0027; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:7908
msgctxt "text_id=1644 | speaker=alice"
msgid "\"...The farewell is over."
msgstr "「……お別れは済ませていたわね。"

#. Occurrence 1DOT5_3:7914:1645: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0028; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:7914
msgctxt "text_id=1645 | speaker=alice"
msgid "  Should I have asked them if they had any last words?\""
msgstr "　<銘|めい>ぐらいは、聞いておくべきだったかしら」"

#. Occurrence 1DOT5_3:7972:1646: scene=1DOT5_3
#: 1DOT5_3:7972
msgctxt "text_id=1646 | speaker=unknown"
msgid "  Her slender, pale fingers traced her lips, as if reluctant to part from them."
msgstr "　白魚のような指が、名残惜しそうに唇をなぞる。"

#. Occurrence 1DOT5_3:7977:1647: scene=1DOT5_3
#: 1DOT5_3:7977
msgctxt "text_id=1647 | speaker=unknown"
msgid "  Sighing again, she calmly left the dark woods the same way she had entered."
msgstr "　少女は二度目のため息をついた後、訪れた時と同じように、ゆっくりと暗い森を後にした。"

#. Occurrence 1DOT5_4:47:1648: scene=1DOT5_4
#: 1DOT5_4:47
msgctxt "text_id=1648 | speaker=unknown"
msgid "  Let us rewind to a moment in the recent past."
msgstr "　カメラは少しだけさかのぼる。"

#. Occurrence 1DOT5_4:52:1649: scene=1DOT5_4
#: 1DOT5_4:52
msgctxt "text_id=1649 | speaker=unknown"
msgid "  The scene took place on a Saturday morning in early December."
msgstr "　日付にすると１２月初めの、ちょっとした閑話休題。"

#. Occurrence 1DOT5_4:100:1650: scene=1DOT5_4
#: 1DOT5_4:100
msgctxt "text_id=1650 | speaker=unknown"
msgid "  With third period over just before lunch, the only activity that remained before the scholastic day ended was homeroom."
msgstr "　三時限目の授業が終わり、帰りの<ＨＲ|ホームルーム>を残すだけの土曜の昼前。"

#. Occurrence 1DOT5_4:105:1651: scene=1DOT5_4
#: 1DOT5_4:105
msgctxt "text_id=1651 | speaker=unknown"
msgid "  Two of Class C's students, Soujyuro Sizuki and Housuke Kinomi, were standing outside on the balcony overlooking the schoolyard. They were stuck waiting for their homeroom teacher, Mr. Kazuki Yamasiro, and could not leave until he arrived."
msgstr "　２－Ｃ組の生徒である<静希|しずき><草十郎|そうじゅうろう>と<木|き><乃|の><美|み><芳助|ほうすけ>は、担任の山城和樹がいっこうに現れない為、帰りたいのに帰れない、という宙づり状態でベランダから校庭など眺めていた。"

#. Occurrence 1DOT5_4:125:1652: scene=1DOT5_4
#: 1DOT5_4:125
msgctxt "text_id=1652 | speaker=unknown"
msgid "  The rest of their classmates were chatting idly in the classroom."
msgstr "　他のクラスメイトたちは教室内で雑談中。"

#. Occurrence 1DOT5_4:146:1653: scene=1DOT5_4
#: 1DOT5_4:146
msgctxt "text_id=1653 | speaker=unknown"
msgid "  Class A's Tobimaru Tsukiji was killing time alongside them."
msgstr "　ふたりの隣には、暇つぶしで付き合っている<Ａ|よ><組|そ>のクラスの<槻司|つきじ><鳶丸|とびまる>の姿があった。"

#. Occurrence 1DOT5_4:151:1654: scene=1DOT5_4
#: 1DOT5_4:151
msgctxt "text_id=1654 | speaker=unknown"
msgid "  The listless trio discussed their weekend plans as they leaned on the veranda's railing."
msgstr "　三人はやる気なさげにベランダの<欄干|らんかん>によりかかり、週末の予定などを話しあっている。"

#. Occurrence 1DOT5_4:177:1655: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0000; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:177
msgctxt "text_id=1655 | speaker=soujuurou"
msgid "\"You working at the Bear this weekend, Kinomi?\""
msgstr "「木乃美はベアでアルバイトか？」"

#. Occurrence 1DOT5_4:190:1656: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0000; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:190
msgctxt "text_id=1656 | speaker=kinomi"
msgid "\"Like hell I am. Who the hell works 'til Sunday?"
msgstr "「バッカ、誰が日曜まで働くかってーの。"

#. Occurrence 1DOT5_4:196:1657: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0001; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:196
msgctxt "text_id=1657 | speaker=kinomi"
msgid "  I'm going out tomorrow with some chicks from Class B... 'least that was the plan. They said they're grounded or something...\""
msgstr "　明日はほら、Ｂ組の子たちと遊びに行く……予定だったんだけどなー。なんかうちから出られねぇー」"

#. Occurrence 1DOT5_4:241:1658: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0001; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:241
msgctxt "text_id=1658 | speaker=soujuurou"
msgid "\"So, in other words, you failed again.\""
msgstr "「む。それはつまり、またふられたのか」"

#. Occurrence 1DOT5_4:270:1659: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0002; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:270
msgctxt "text_id=1659 | speaker=kinomi"
msgid "\"Jeez, kick a man when he's down much, Sizuki?!\""
msgstr "「ごはっ、直撃!?　言いづらいコトをまっすぐ言うよね静希クンってば！」"

#. Occurrence 1DOT5_4:299:1660: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_1DOT5_4_0000; voice_prefix=B70; voice_category=4; scene=1DOT5_4
#: 1DOT5_4:299
msgctxt "text_id=1660 | speaker=tobimaru"
msgid "\"Please, even the most airheaded chicks know better than to accept an invite from your dumb ass. Crash and burn all you like, but don't drag Sono-G into the fallout, will you?\""
msgstr "「そりゃ毎日テメエのバカ面みてれば、ヒヨコだってふられるって言葉を覚えるだろうよ。自滅するのは勝手だけどな、くれぐれも草の字にヘンな遊び教えんなよ」"

#. Occurrence 1DOT5_4:342:1661: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0003; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:342
msgctxt "text_id=1661 | speaker=kinomi"
msgid "\"Well excuse me, Your Majesty. You're one to talk!"
msgstr "「あん、そりゃ<殿下|でんか>の方じゃねえの？"

#. Occurrence 1DOT5_4:348:1662: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0004; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:348
msgctxt "text_id=1662 | speaker=kinomi"
msgid "  Word to the wise, Sizuki. Tsukiji's heart is as black as they come."
msgstr "　気ぃつけろよ静希、<槻司|つきじ>はマジで腹黒いからよ。"

#. Occurrence 1DOT5_4:354:1663: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0005; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:354
msgctxt "text_id=1663 | speaker=kinomi"
msgid "  In his mind he's like... you know those labels you use to separate the trash? This dude uses them to label people―you're either useful to him or you ain't.\""
msgstr "　コイツの頭ん中は、ほら、アレ。ゴミ捨て場の貼り紙？　あんな感じだから。くっきり使えるモンと使えないモン分けてんだよ」"

#. Occurrence 1DOT5_4:395:1664: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0002; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:395
msgctxt "text_id=1664 | speaker=soujuurou"
msgid "\"Yeah, I figured that out."
msgstr "「ああ、それは知ってる。"

#. Occurrence 1DOT5_4:406:1665: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0003; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:406
msgctxt "text_id=1665 | speaker=soujuurou"
msgid "  ...Speaking of which, I know this is a bit out of the blue, but what do you think about Kinomi, Tobimaru?\""
msgstr "　―――ところで唐突に思ったんだが、鳶丸の中じゃ木乃美はどういう扱いなんだ？」"

#. Occurrence 1DOT5_4:434:1666: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_1DOT5_4_0001; voice_prefix=B70; voice_category=4; scene=1DOT5_4
#: 1DOT5_4:434
msgctxt "text_id=1666 | speaker=tobimaru"
msgid "\"Hmm... Well you know how the country's going to stop collecting oversized scrap for free soon, since it costs too much to dispose of? That's because of people like him.\""
msgstr "「そうだなあ。粗大ゴミ回収は、金でも貰わねえとワリ合わなくなるんじゃねえか？　国が無料で回収するのはそろそろおしまいってトコ」"

#. Occurrence 1DOT5_4:478:1667: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0006; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:478
msgctxt "text_id=1667 | speaker=kinomi"
msgid "\"What kinda nonsense is that? Who throws out big stuff like cabinets when you can make good money off of them?!"
msgstr "「はあ？　なに言ってんのオマエ？　使い古しの箪笥とか高く売れるじゃん！"

#. Occurrence 1DOT5_4:490:1668: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0007; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:490
msgctxt "text_id=1668 | speaker=kinomi"
msgid "  The future is grab-and-go, you know. Just look how rad those disposable cameras you can buy at convenience stores are. Looks like the times have finally caught up with my idea of consumer culture―\""
msgstr "　オレみたいな開封・即使用、みたいな男がこれからのトレンドなワケでしょ？　ほら、コンビニで売ってる使い捨てカメラとか大人気だし？　ようやく流行がオレの消費文明に追いついたと、」"

#. Occurrence 1DOT5_4:532:1669: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0004_0; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:532
msgctxt "text_id=1669 | speaker=soujuurou"
msgid "\"So, Kinomi's working this weekend."
msgstr "「じゃあ木乃美はバイト、と。"

#. Occurrence 1DOT5_4:546:1670: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0004_1; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:546
msgctxt "text_id=1670 | speaker=soujuurou"
msgid "What about you, Tobimaru?\""
msgstr "鳶丸は？」"

#. Occurrence 1DOT5_4:558:1671: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0008; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:558
msgctxt "text_id=1671 | speaker=kinomi"
msgid "\"My time is coming, just watch!\""
msgstr "「来るからネ、ちゃんとオレの時代！」"

#. Occurrence 1DOT5_4:569:1672: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_1DOT5_4_0002; voice_prefix=B70; voice_category=4; scene=1DOT5_4
#: 1DOT5_4:569
msgctxt "text_id=1672 | speaker=tobimaru"
msgid "\"There's some business to attend to on my end. I'll be entertaining a guest of my father's. Giving a tour of the city, stuff like that.\""
msgstr "「俺はちょい私用だ。親父の客が来てるんで接待しなきゃならん。街の案内をしてくれとさ」"

#. Occurrence 1DOT5_4:596:1673: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0009; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:596
msgctxt "text_id=1673 | speaker=kinomi"
msgid "\"Friggin' rude! Don't interrupt a guy when he's talking."
msgstr "「きけよー。人の話きけよー。"

#. Occurrence 1DOT5_4:627:1674: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0010; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:627
msgctxt "text_id=1674 | speaker=kinomi"
msgid "  I was gonna say, I'm gonna be watching my kid sister. I ain't helping out at that crappy Chinese restaurant.\""
msgstr "　あのよぅ、オレは妹の相手してやるだけなんだよぅ。隣のクソ中華飯店の手伝いなんかしねーよー」"

#. Occurrence 1DOT5_4:655:1675: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_1DOT5_4_0003; voice_prefix=B70; voice_category=4; scene=1DOT5_4
#: 1DOT5_4:655
msgctxt "text_id=1675 | speaker=tobimaru"
msgid "\"What about you, Sono-G? You working tomorrow?\""
msgstr "「草の字は？　明日もバイトか？」"

#. Occurrence 1DOT5_4:683:1676: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0005; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:683
msgctxt "text_id=1676 | speaker=soujuurou"
msgid "\"No, no plans. But I am going to work at the amusement park after school today.\""
msgstr "「いや、それが一日空いてる。今日はこれから遊園地でアルバイトだけど」"

#. Occurrence 1DOT5_4:727:1677: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0011; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:727
msgctxt "text_id=1677 | speaker=kinomi"
msgid "\"What, Magic Kitsy Land? Seriously?"
msgstr "「うげぇ、それって魔のキッツィーランド？"

#. Occurrence 1DOT5_4:733:1678: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0012; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:733
msgctxt "text_id=1678 | speaker=kinomi"
msgid "  You're tougher than you look, Sizuki. I heard even the judo guys who worked there bailed.\""
msgstr "　タフだねぇ静希。あそこのバイトは柔道部の連中でも音を上げるって話じゃんか」"

#. Occurrence 1DOT5_4:761:1679: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0006; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:761
msgctxt "text_id=1679 | speaker=soujuurou"
msgid "\"It couldn't possibly be worse than carrying boxes for ExFed, right?\""
msgstr "「……なんと。まさか、ネコクロの荷物運びより辛い？」"

#. Occurrence 1DOT5_4:796:1680: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0013; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:796
msgctxt "text_id=1680 | speaker=kinomi"
msgid "\"Well... okay, not that bad."
msgstr "「んー。いや、そこまではよく。"

#. Occurrence 1DOT5_4:802:1681: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0014; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:802
msgctxt "text_id=1681 | speaker=kinomi"
msgid "  Damn, that a-hole Yamasiro is taking his sweet time. Look, Class B is already leaving!\""
msgstr "　しっかし山城のヤロウ遅ぇなあ。見ろ、となりのＢ組すらお帰りになられてるぞ」"

#. Occurrence 1DOT5_4:808:1682: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_1DOT5_4_0004; voice_prefix=B70; voice_category=4; scene=1DOT5_4
#: 1DOT5_4:808
msgctxt "text_id=1682 | speaker=tobimaru"
msgid "\"Looks like it. You know, I didn't wanna pull this card, but we'll just have to call him. We can't let Sono-G be late for work.\""
msgstr "「だな。仕方ねえ、面倒だが呼んでくるか。草の字を遅刻させるワケにゃいかねえし」"

#. Occurrence 1DOT5_4:851:1683: scene=1DOT5_4
#: 1DOT5_4:851
msgctxt "text_id=1683 | speaker=unknown"
msgid "  And as if by design, the moment Tobimaru Tsukiji stood up wearily from the balcony railing..."
msgstr "　大儀そうにベランダの手すりから体を起こす槻司鳶丸と、"

#. Occurrence 1DOT5_4:858:1684: scene=1DOT5_4
#: 1DOT5_4:858
msgctxt "text_id=1684 | speaker=unknown"
msgid "  ...the school's PA system chime rang."
msgstr "　狙いすましたように、ピンポンパン、と鳴り響く校内放送。"

#. Occurrence 1DOT5_4:896:1685: voice_id=F30_1DOT5_4_0000_A; voice_prefix=F30; voice_category=0; scene=1DOT5_4
#: 1DOT5_4:896
msgctxt "text_id=1685 | speaker=unknown"
msgid "\"Soujyuro Sizuki, Class 2-C, please report immediately to Mr. Yamasiro in the faculty room. I repeat, Soujyuro Sizuki, Class 2-C...\""
msgstr "『２年Ｃ組の静希草十郎くん。山城先生がお呼びです。至急、職員室まで来てください。繰り返します、２年Ｃ組の～』"

#. Occurrence 1DOT5_4:920:1686: scene=1DOT5_4
#: 1DOT5_4:920
msgctxt "text_id=1686 | speaker=unknown"
msgid "  An awkward silence fell upon the three."
msgstr "　三人の間に気まずい沈黙。"

#. Occurrence 1DOT5_4:925:1687: scene=1DOT5_4
#: 1DOT5_4:925
msgctxt "text_id=1687 | speaker=unknown"
msgid "  After a long five seconds, Soujyuro said goodbye and headed back inside."
msgstr "　五秒ほどぼんやりしてから、草十郎はそれじゃあ、とふたりを残してベランダを後にした。"

#. Occurrence 1DOT5_4:964:1688: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0015; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:964
msgctxt "text_id=1688 | speaker=kinomi"
msgid "\"Ugh, nothing interesting ever happens here. Can't someone make a crop circle in the schoolyard or something?\""
msgstr "「面白いコトねぇなあ。誰か、校庭にミステリーサークルとか作ってくんねぇかなあ」"

#. Occurrence 1DOT5_4:970:1689: scene=1DOT5_4
#: 1DOT5_4:970
msgctxt "text_id=1689 | speaker=unknown"
msgid "  Kinomi grumbled, slouching his shoulders and succumbing to his lethargy."
msgstr "　肩の力を抜きまくり、完全脱力人間になりながらぼやく木乃美。"

#. Occurrence 1DOT5_4:1013:1690: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_1DOT5_4_0005; voice_prefix=B70; voice_category=4; scene=1DOT5_4
#: 1DOT5_4:1013
msgctxt "text_id=1690 | speaker=tobimaru"
msgid "\"Stop expecting others to make life interesting. If you're bored, then make something happen yourself. Challenge Aozaki to an inter-class debate or something.\""
msgstr "「他人の妄想力に期待すんなよ。刺激が欲しいならテメエでイベント起こせ。ほら、クラス分け発表の時よろしく、蒼崎につっかかればすぐだぜ」"

#. Occurrence 1DOT5_4:1060:1691: scene=1DOT5_4
#: 1DOT5_4:1060
msgctxt "text_id=1691 | speaker=unknown"
msgid "\"Suffering ain't interesting! Scrapping with the prez is asking for it. I said 'interesting' not 'terrifying.'"
msgstr "「ひいい、蘇るトラウマ！　やだよー、会長の<大立|おおた>ちまわりは<面白|おもしろ>いのを通りこして<恐|おそ>ろしいよー。"

#. Occurrence 1DOT5_4:1072:1692: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0016_1; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:1072
msgctxt "text_id=1692 | speaker=kinomi"
msgid "As a decent, upstanding, red-blooded male, I'd happily settle for a hot transfer student showing up."
msgstr "善良な一男子生徒としちゃあ、美少女が転校してくるだけでいいんだよー。"

#. Occurrence 1DOT5_4:1083:1693: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0017; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:1083
msgctxt "text_id=1693 | speaker=kinomi"
msgid "  As long as she isn't boring, anyway. Maybe if she were a Hollywood producer, or some famous English singer, or-\""
msgstr "　んー、まあ、フツーの子じゃつまんないから、ハリウッドのプロデューサーとか、イギリスの歌姫とかー」"

#. Occurrence 1DOT5_4:1114:1694: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_1DOT5_4_0006; voice_prefix=B70; voice_category=4; scene=1DOT5_4
#: 1DOT5_4:1114
msgctxt "text_id=1694 | speaker=tobimaru"
msgid "\"Laaame. If you're going that far, at least make her a babe from Mars.\""
msgstr "「どんな<括|くく>りだそりゃ。そこは火星のお姫さまあたりにしとけよ」"

#. Occurrence 1DOT5_4:1137:1695: voice_id=F30_1DOT5_4_0001; voice_prefix=F30; voice_category=0; scene=1DOT5_4
#: 1DOT5_4:1137
msgctxt "text_id=1695 | speaker=unknown"
msgid "\"Attention, Class 2-C. This is an announcement from Mr. Yamasiro:"
msgstr "『それと、２年Ｃ組の皆さんへ、山城先生から伝言です。"

#. Occurrence 1DOT5_4:1143:1696: voice_id=F30_1DOT5_4_0002; voice_prefix=F30; voice_category=0; scene=1DOT5_4
#: 1DOT5_4:1143
msgctxt "text_id=1696 | speaker=unknown"
msgid "Mr. Yamasiro is currently occupied and unable to attend homeroom. Please make your way home."
msgstr "“山城先生は訳あってＨＲを欠席しますので、各自、勝手に下校しちゃってくださいね。それではでは”"

#. Occurrence 1DOT5_4:1149:1697: voice_id=F30_1DOT5_4_0003; voice_prefix=F30; voice_category=0; scene=1DOT5_4
#: 1DOT5_4:1149
msgctxt "text_id=1697 | speaker=unknown"
msgid "  This concludes all announcements for the day.\""
msgstr "　以上、放送室からお知らせしました』"

#. Occurrence 1DOT5_4:1175:1698: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0018; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:1175
msgctxt "text_id=1698 | speaker=kinomi"
msgid "\"...The hell? Ever since Yamasiro bought that new car, he's been a real punk! Maybe I'll see what sound this dime makes against the door of a new Serbia!\""
msgstr "「……どうよコレ。山城、新車買ってからフリーダムすぎねえ？　このままではあの真新しいセルビアに、オレのギザ<十|じゅう>がうなりかねん」"

#. Occurrence 1DOT5_4:1181:1699: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_1DOT5_4_0007; voice_prefix=B70; voice_category=4; scene=1DOT5_4
#: 1DOT5_4:1181
msgctxt "text_id=1699 | speaker=tobimaru"
msgid "\"Hold it, hotshot. Just put gum in the keyhole. Teachers get paid peanuts, man.\""
msgstr "「鍵穴にガム程度にしとけ。教師の薄給はマジ同情に値するからな」"

#. Occurrence 1DOT5_4:1216:1700: scene=1DOT5_4
#: 1DOT5_4:1216
msgctxt "text_id=1700 | speaker=unknown"
msgid "  The two frenemies returned to the classroom, complaining all the while,"
msgstr "　ぼやきながらも教室に戻る悪友ふたり。"

#. Occurrence 1DOT5_4:1221:1701: scene=1DOT5_4
#: 1DOT5_4:1221
msgctxt "text_id=1701 | speaker=unknown"
msgid "  their concern for their mutual friend summoned to the faculty office completely out of mind."
msgstr "　職員室に呼び出された友人の心配は、これっぽっちもしていなかった。"

#. Occurrence 1DOT5_4:1267:1702: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0000; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1267
msgctxt "text_id=1702 | speaker=aoko"
msgid "\"I don't agree. The school allows for students to hold part-time jobs."
msgstr "「納得いきません。生徒のアルバイトは認められています。"

#. Occurrence 1DOT5_4:1273:1703: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0001; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1273
msgctxt "text_id=1703 | speaker=aoko"
msgid "  According to school regulations, a job at a workplace authorized by the school is recommended as a social experience.\""
msgstr "　学校公認の職場であるなら、社会経験の一環として推奨する、と校則にもありますが」"

#. Occurrence 1DOT5_4:1291:1704: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0000; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1291
msgctxt "text_id=1704 | speaker=yamashiro"
msgid "\"That's true, but in his case it's a matter of going too far."
msgstr "「そうなんだけどねえ。彼の場合、やりすぎなのが問題なワケで。"

#. Occurrence 1DOT5_4:1298:1705: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0001; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1298
msgctxt "text_id=1705 | speaker=yamashiro"
msgid "What if, let's suppose, he were working somewhere without permission, somewhere that might be violating the Labor Standards Law? That would spell trouble for both the school and for him.\""
msgstr "仮に、もし認可していない、労働基準法に反してそうな所で働いてたら困るでしょ、<学校|うち>も彼も」"

#. Occurrence 1DOT5_4:1329:1706: scene=1DOT5_4
#: 1DOT5_4:1329
msgctxt "text_id=1706 | speaker=unknown"
msgid "  The volatile tension between the ruthless student council president and the easygoing modern language teacher permeated the room."
msgstr "　<土曜日|ハンドン>の昼食を前に浮き足立つ職員室で、鬼の生徒会長となあなあ現国教師が危険な匂いをまき散らす。"

#. Occurrence 1DOT5_4:1334:1707: scene=1DOT5_4
#: 1DOT5_4:1334
msgctxt "text_id=1707 | speaker=unknown"
msgid "  Praying to be spared from the impending confrontation, the other teachers hurriedly relocated to the meeting room."
msgstr "　他の教師陣はくわばらくわばら、と会議室にそそくさ移動。"

#. Occurrence 1DOT5_4:1339:1708: scene=1DOT5_4
#: 1DOT5_4:1339
msgctxt "text_id=1708 | speaker=unknown"
msgid "  By the time Mr. Yamasiro noticed this, the only other person in the room was the student council president, Aoko Aozaki."
msgstr "　山城教諭がおや？と気づいた時、職員室にいるのは彼と、生徒会長・蒼崎青子その人だけだった。"

#. Occurrence 1DOT5_4:1372:1709: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0002; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1372
msgctxt "text_id=1709 | speaker=yamashiro"
msgid "\"...They all ran, huh. Why does everyone always push the scary jobs on me? They're so mean.\""
msgstr "「……逃げたか。ひどいなあみんな、怖いのは僕に押しつけてばっかりだもんなあ」"

#. Occurrence 1DOT5_4:1390:1710: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0002; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1390
msgctxt "text_id=1710 | speaker=aoko"
msgid "\"Don't change the subject, sir."
msgstr "「話の続きです、先生。"

#. Occurrence 1DOT5_4:1396:1711: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0003; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1396
msgctxt "text_id=1711 | speaker=aoko"
msgid "  If we do suppose that he is working at an unauthorized workplace, doesn't that mean that the school isn't accommodating his needs?\""
msgstr "　仮に彼が指定以外のアルバイトをしているとしたら、それは彼の要求に学校側が応えていないからではありませんか？」"

#. Occurrence 1DOT5_4:1422:1712: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0004; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1422
msgctxt "text_id=1712 | speaker=aoko"
msgid "\"I'm not saying that the school needs to cover his room and board, but as long as he's not working too much, his request deserves due consideration."
msgstr "「下宿先の家賃を奨学金でまかなえとは言いませんが、時間の許すかぎり働きたい、という要望は考慮すべきです。"

#. Occurrence 1DOT5_4:1433:1713: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0005; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1433
msgctxt "text_id=1713 | speaker=aoko"
msgid "  And if you are still concerned about unauthorized workplaces, please first revise the rule that limits each student to only one.\""
msgstr "　指定外のアルバイトを疑うのなら、まず“働き先は一生徒につき一件だけ”という規則を改めてください」"

#. Occurrence 1DOT5_4:1465:1714: scene=1DOT5_4
#: 1DOT5_4:1465
msgctxt "text_id=1714 | speaker=unknown"
msgid "  After hearing her out and realizing there was no way she would back down, Mr. Yamasiro hung his head."
msgstr "　生徒会長の静かな語り口調に、これはどうあっても引いてくれないなあ、と山城教諭はうなだれる。"

#. Occurrence 1DOT5_4:1495:1715: scene=1DOT5_4
#: 1DOT5_4:1495
msgctxt "text_id=1715 | speaker=unknown"
msgid "  This was supposed to be easy."
msgstr "　事はもっと単純に済む筈だった。"

#. Occurrence 1DOT5_4:1500:1716: scene=1DOT5_4
#: 1DOT5_4:1500
msgctxt "text_id=1716 | speaker=unknown"
msgid "  The plan was to call in the student rumored to be working multiple jobs, confirm whether the rumor was true, and if so, give him a warning and some guidance, then head to lunch with the knowledge that all was right with the world."
msgstr "『複数のアルバイトをしている』と噂をたてられた生徒を呼び出して事情を<訊|たず>ね、これが真実なら注意・指導し、世は全て事も無し、と昼食に向かう予定だったのだ。"

#. Occurrence 1DOT5_4:1505:1717: scene=1DOT5_4
#: 1DOT5_4:1505
msgctxt "text_id=1717 | speaker=unknown"
msgid "  The student council president, who was coincidentally in the faculty room at the time, had heard the entire issue and decided to call out this injustice."
msgstr "　その話をたまたま職員室に来ていた生徒会長が聞きつけ、それはおかしい、と食いついてしまった。"

#. Occurrence 1DOT5_4:1525:1718: scene=1DOT5_4
#: 1DOT5_4:1525
msgctxt "text_id=1718 | speaker=unknown"
msgid "  As far as Mr. Yamasiro was concerned, she was in the right, and he was well aware of the aforementioned student's situation."
msgstr "　山城自身、生徒会長の意見はもっともだし、<件|くだん>の生徒の事情も理解している。"

#. Occurrence 1DOT5_4:1530:1719: scene=1DOT5_4
#: 1DOT5_4:1530
msgctxt "text_id=1719 | speaker=unknown"
msgid "  Personally, he would have liked to help, but among the faculty he was just the new kid on the block."
msgstr "　個人的には応援してやりたいのだが、彼も悲しい新米教師。"

#. Occurrence 1DOT5_4:1535:1720: scene=1DOT5_4
#: 1DOT5_4:1535
msgctxt "text_id=1720 | speaker=unknown"
msgid "  He wanted to stay on the vice principal's good side, and at the very least not lose his job, as badly paid as it was."
msgstr "　副教頭のご機嫌もうかがいたいし、薄給とはいえ職を失うのもよろしくない。"

#. Occurrence 1DOT5_4:1574:1721: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0003; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1574
msgctxt "text_id=1721 | speaker=yamashiro"
msgid "\"...Look. This was a warning straight from the vice principal. I can't do anything more to help.\""
msgstr "「……こればかりはね。副教頭先生直々の注意なんで、僕も助けてあげられないんだよ」"

#. Occurrence 1DOT5_4:1580:1722: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0006; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1580
msgctxt "text_id=1722 | speaker=aoko"
msgid "\"What if we compromised?\""
msgstr "「それでしたら、落としどころがあればいいんですね？」"

#. Occurrence 1DOT5_4:1591:1723: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0004; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1591
msgctxt "text_id=1723 | speaker=yamashiro"
msgid "\"What do you mean?\""
msgstr "「うん？」"

#. Occurrence 1DOT5_4:1612:1724: scene=1DOT5_4
#: 1DOT5_4:1612
msgctxt "text_id=1724 | speaker=unknown"
msgid "  The student council president removed a document from her bag."
msgstr "　生徒会長は鞄から一枚の書類を取り出した。"

#. Occurrence 1DOT5_4:1617:1725: scene=1DOT5_4
#: 1DOT5_4:1617
msgctxt "text_id=1725 | speaker=unknown"
msgid "  It was a document that had been brought up in the morning's faculty meeting, bringing a host of headaches with it."
msgstr "　今朝の職員会議でも取り上げられた、全教員の頭痛の種の一つである。"

#. Occurrence 1DOT5_4:1643:1726: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0005; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1643
msgctxt "text_id=1726 | speaker=yamashiro"
msgid "\"Ms. Aozaki, that's not the...\""
msgstr "「蒼崎くん、それは」"

#. Occurrence 1DOT5_4:1665:1727: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0007; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1665
msgctxt "text_id=1727 | speaker=aoko"
msgid "\"Yes. This is the Aida Church's volunteer registration form."
msgstr "「はい。<合田|あいだ>教会のボランティア参加の申告書です。"

#. Occurrence 1DOT5_4:1671:1728: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0008; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1671
msgctxt "text_id=1728 | speaker=aoko"
msgid "  There were zero applicants again this month, a fact that would certainly bother a devout Christian like the vice principal."
msgstr "　今月も希望者ゼロですね。敬虔なクリスチャンである副教頭先生は、さぞお気を悪くしているかと。"

#. Occurrence 1DOT5_4:1677:1729: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0009; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1677
msgctxt "text_id=1729 | speaker=aoko"
msgid "  Even this morning he was lamenting our students' lack of faith.\""
msgstr "　我が校の生徒には信心が足りん、と、今朝も<嘆|なげ>かれていたとか？」"

#. Occurrence 1DOT5_4:1710:1730: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0006; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1710
msgctxt "text_id=1730 | speaker=yamashiro"
msgid "\"...I can't deny that, but what I'd really like to know is how you became so well-informed of the content of this morning's faculty meeting.\""
msgstr "「……そうだけど。どうして君が今朝の職員会議の内容を知っているか聞きたいよ、ホント」"

#. Occurrence 1DOT5_4:1716:1731: scene=1DOT5_4
#: 1DOT5_4:1716
msgctxt "text_id=1731 | speaker=unknown"
msgid "  Mr. Yamasiro scratched his head, but his eyes were smiling gleefully."
msgstr "　頭を掻く山城教諭だが、その目は楽しげに笑っている。"

#. Occurrence 1DOT5_4:1721:1732: scene=1DOT5_4
#: 1DOT5_4:1721
msgctxt "text_id=1732 | speaker=unknown"
msgid "  He had figured out the student council president's objective."
msgstr "　生徒会長の狙いに合点がいったからだ。"

#. Occurrence 1DOT5_4:1760:1733: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0007; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1760
msgctxt "text_id=1733 | speaker=yamashiro"
msgid "\"So, I'll scratch your back, and you'll scratch mine. Is that it?"
msgstr "「<魚心|うおごころ>あれば<水心|みずごころ>あり、ですか。"

#. Occurrence 1DOT5_4:1766:1734: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0008; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1766
msgctxt "text_id=1734 | speaker=yamashiro"
msgid "  Work conducted on the church's behalf is done on a voluntary basis, but still compensated in some form. And it's officially recognized by the school as a form of social study."
msgstr "　教会への奉仕活動はボランティアだけど、きちんと謝礼がでる。あれもカタチの上では学校側が推奨する社会見学だからね。"

#. Occurrence 1DOT5_4:1772:1735: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0009; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1772
msgctxt "text_id=1735 | speaker=yamashiro"
msgid "  The vice principal will be overjoyed to have a participant, and-\""
msgstr "　副教頭先生は参加者がでた事に喜び、加えて、」"

#. Occurrence 1DOT5_4:1809:1736: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0010; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1809
msgctxt "text_id=1736 | speaker=aoko"
msgid "\"And in the event that said volunteer is already employed somewhere else, the school's permission will be extended to both."
msgstr "「その参加希望者が既に他のアルバイトに就いていた場合、学校側の認可が二つになっちゃいますね。"

#. Occurrence 1DOT5_4:1815:1737: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0011; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1815
msgctxt "text_id=1737 | speaker=aoko"
msgid "  Considering the precedent, I find this to be a good compromise.\""
msgstr "　前例にしては、いい落としどころだと思いますが」"

#. Occurrence 1DOT5_4:1850:1738: scene=1DOT5_4
#: 1DOT5_4:1850
msgctxt "text_id=1738 | speaker=unknown"
msgid "  Mr. Yamasiro raised his hands in surrender."
msgstr "　まいった、と手をあげる山城教諭。"

#. Occurrence 1DOT5_4:1855:1739: scene=1DOT5_4
#: 1DOT5_4:1855
msgctxt "text_id=1739 | speaker=unknown"
msgid "  There were few students able to both raise a complaint and propose a proper solution."
msgstr "　問題を告発しながらも、きちんと解決策を提案してくる生徒はそういない。"

#. Occurrence 1DOT5_4:1860:1740: scene=1DOT5_4
#: 1DOT5_4:1860
msgctxt "text_id=1740 | speaker=unknown"
msgid "  Perhaps it was her big-sisterly disposition that made this girl so simultaneously feared yet trusted."
msgstr "　この女生徒が恐れられながらも頼られているのは、この姉御肌なところによるものだろう。"

#. Occurrence 1DOT5_4:1891:1741: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0010; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1891
msgctxt "text_id=1741 | speaker=yamashiro"
msgid "\"All right, let's try it your way. Just... say a prayer for me, okay?\""
msgstr "「よし、その方向で攻めてみよう。上手くいくよう祈ってくれよ」"

#. Occurrence 1DOT5_4:1909:1742: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0012; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1909
msgctxt "text_id=1742 | speaker=aoko"
msgid "\"I don't like it when people are overly reliant on others. If you're going to participate in this scheme, please take your part seriously, Mr. Yamasiro.\""
msgstr "「他力本願は嫌いです。<悪巧|わるだく>みに乗ってくれるのなら、きちんと活躍してください、山城先生」"

#. Occurrence 1DOT5_4:1919:1743: scene=1DOT5_4
#: 1DOT5_4:1919
msgctxt "text_id=1743 | speaker=unknown"
msgid "  With a bow, the student council president turned to leave the faculty room."
msgstr "　それでは失礼します、と礼をして職員室を去る生徒会長。"

#. Occurrence 1DOT5_4:1940:1744: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0011; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1940
msgctxt "text_id=1744 | speaker=yamashiro"
msgid "\"Ah, wait a second. You're not going anywhere."
msgstr "「あ、待った待った、君も残るんだ。"

#. Occurrence 1DOT5_4:1947:1745: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0012; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1947
msgctxt "text_id=1745 | speaker=yamashiro"
msgid "I'm going to go ahead and call in Sizuki now, so I'll need you to stay and look after him properly.\""
msgstr "今から静希くんを呼ぶから、ちゃんと面倒見てもらわないと」"

#. Occurrence 1DOT5_4:1970:1746: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0013; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1970
msgctxt "text_id=1746 | speaker=aoko"
msgid "\"...What?\""
msgstr "「――――――は？」"

#. Occurrence 1DOT5_4:1990:1747: scene=1DOT5_4
#: 1DOT5_4:1990
msgctxt "text_id=1747 | speaker=unknown"
msgid "  The girl's cool eyes narrowed."
msgstr "　少女のクールな瞳が、きゅっと細くなる。"

#. Occurrence 1DOT5_4:1995:1748: scene=1DOT5_4
#: 1DOT5_4:1995
msgctxt "text_id=1748 | speaker=unknown"
msgid "  Unable to process what she had just heard, her expression turned to a scowl."
msgstr "　いま、心底理解できない台詞を聞いたんだけど、と山城教諭を睨みつける。"

#. Occurrence 1DOT5_4:2034:1749: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0013; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:2034
msgctxt "text_id=1749 | speaker=yamashiro"
msgid "\"If we're looking for volunteers, two is better than one, right?"
msgstr "「いや、参加希望者は一人より二人の方がいいだろ。"

#. Occurrence 1DOT5_4:2040:1750: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0014; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:2040
msgctxt "text_id=1750 | speaker=yamashiro"
msgid "  Plus, knowing that you are following up on this would give me great peace of mind.\""
msgstr "　蒼崎くんがフォローしてくれるなら僕も安心だしね」"

#. Occurrence 1DOT5_4:2046:1751: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0014; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2046
msgctxt "text_id=1751 | speaker=aoko"
msgid "\"But, sir, I don't―\""
msgstr "「あの、ちょっと、先生」"

#. Occurrence 1DOT5_4:2087:1752: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0015; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:2087
msgctxt "text_id=1752 | speaker=yamashiro"
msgid "\"Hello, broadcasting room? Please put out an announcement asking for Class 2-C student Soujyuro Sizuki to report to Mr. Yamasiro in the staff room immediately.\""
msgstr "「あ、放送室？　２年Ｃ組の静希草十郎くん、至急職員室に来てください、で放送、お願いします」"

#. Occurrence 1DOT5_4:2093:1753: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0015; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2093
msgctxt "text_id=1753 | speaker=aoko"
msgid "\"No, like I was about to say―\""
msgstr "「その、だから、先生」"

#. Occurrence 1DOT5_4:2127:1754: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0016; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:2127
msgctxt "text_id=1754 | speaker=yamashiro"
msgid "\"Oh, this is perfect! And to think that the source of my headache would go away, too. Today's my lucky day!"
msgstr "「いやあ、これで万全だ！　まさか頭痛のタネが同時に消え去るなんて、今日はついてる！"

#. Occurrence 1DOT5_4:2134:1755: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0017; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:2134
msgctxt "text_id=1755 | speaker=yamashiro"
msgid "  Ms. Aozaki, what would I do without your kindness? Wait a second... He's not your type, is he? ...Oh, broadcasting room? Please add the following: 'The student council president is eagerly awaiting-'\""
msgstr "　ああ、けど蒼崎くん、ずいぶん親身になってくれるんだね。なに、もしかしてああいうのがタイプ？　あ、放送室さん、ついでに生徒会長が心からお待ちしていますと付け足して―――」"

#. Occurrence 1DOT5_4:2140:1756: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0016; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2140
msgctxt "text_id=1756 | speaker=aoko"
msgid "\"Mr. Yamasirooo!\""
msgstr "「って、山城ォ―――！」"

#. Occurrence 1DOT5_4:2251:1757: scene=1DOT5_4
#: 1DOT5_4:2251
msgctxt "text_id=1757 | speaker=unknown"
msgid "  The next day, a pleasant Sunday."
msgstr "　翌日、気持ちのいい日曜日。"

#. Occurrence 1DOT5_4:2257:1758: scene=1DOT5_4
#: 1DOT5_4:2257
msgctxt "text_id=1758 | speaker=unknown"
msgid "  Soujyuro was awake two hours before the time he was supposed to meet her."
msgstr "　草十郎は待ち合わせの時間より二時間早く目を覚ました。"

#. Occurrence 1DOT5_4:2294:1759: scene=1DOT5_4
#: 1DOT5_4:2294
msgctxt "text_id=1759 | speaker=unknown"
msgid "  After getting up, he decided to go for a leisurely jog to clear his mind, but, lost among his own thoughts, his thirty-minute jog turned into almost an hour. Upon realizing, he rushed home."
msgstr "　その後、気を落ち着けるためにジョギングがてらの散歩にでかけ、三十分で戻るつもりがあれこれ考えているうちに一時間近く経っている事に気づき、あわてて帰宅。"

#. Occurrence 1DOT5_4:2299:1760: scene=1DOT5_4
#: 1DOT5_4:2299
msgctxt "text_id=1760 | speaker=unknown"
msgid "  After thoroughly racking his brain over what to wear for the occasion, he decided upon wearing his school uniform."
msgstr "　何を着ていくものか考え抜いたあげく、結局、学校の制服で臨むことにした。"

#. Occurrence 1DOT5_4:2333:1761: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0017; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2333
msgctxt "text_id=1761 | speaker=aoko"
msgid "\"Ten o'clock, Misaki Central Park, east entrance. I'll meet you there.\""
msgstr "“午前十時、三咲中央公園の東入り口で待ち合わせ”"

#. Occurrence 1DOT5_4:2354:1762: scene=1DOT5_4
#: 1DOT5_4:2354
msgctxt "text_id=1762 | speaker=unknown"
msgid "  Yesterday in the faculty room..."
msgstr "　昨日の職員室。"

#. Occurrence 1DOT5_4:2359:1763: scene=1DOT5_4
#: 1DOT5_4:2359
msgctxt "text_id=1763 | speaker=unknown"
msgid "  When Aoko Aozaki had shared the time and place with him that day, she said it with such pain on her face. Maybe she was fighting a headache at the time."
msgstr "　風邪気味だったのか、蒼崎青子は頭痛を押し殺すような顔でそう言った。"

#. Occurrence 1DOT5_4:2394:1764: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0007; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2394
msgctxt "text_id=1764 | speaker=soujuurou"
msgid "\"I wonder if Aozaki is feeling better.\""
msgstr "「しかし、蒼崎の風邪は治っているのだろうか」"

#. Occurrence 1DOT5_4:2400:1765: scene=1DOT5_4
#: 1DOT5_4:2400
msgctxt "text_id=1765 | speaker=unknown"
msgid "  Soujyuro muttered, his words of concern misguided as they were."
msgstr "　草十郎はあさっての方向を見ながら、あさってを向いた心配ごとを呟く。"

#. Occurrence 1DOT5_4:2405:1766: scene=1DOT5_4
#: 1DOT5_4:2405
msgctxt "text_id=1766 | speaker=unknown"
msgid "  In any case, he waited for about five minutes."
msgstr "　ともあれ、そうして待つこと約五分。"

#. Occurrence 1DOT5_4:2410:1767: scene=1DOT5_4
#: 1DOT5_4:2410
msgctxt "text_id=1767 | speaker=unknown"
msgid "  At precisely ten o'clock, the student council president appeared."
msgstr "　十時きっかりに生徒会長は登場した。"

#. Occurrence 1DOT5_4:2445:1768: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0018; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2445
msgctxt "text_id=1768 | speaker=aoko"
msgid "\"Good morning."
msgstr "「おはよ。"

#. Occurrence 1DOT5_4:2445:1769: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0018; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2445
msgctxt "text_id=1769 | speaker=aoko"
msgid "  Punctual as usual, I see.\""
msgstr "　いつもの事だけど、時間だけはピッタリよね、貴方」"

#. Occurrence 1DOT5_4:2463:1770: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0008; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2463
msgctxt "text_id=1770 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 1DOT5_4:2483:1771: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0019; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2483
msgctxt "text_id=1771 | speaker=aoko"
msgid "\"What's wrong with your face? Are you sick?\""
msgstr "「ひどい顔ね。もしかして気分悪いの？」"

#. Occurrence 1DOT5_4:2504:1772: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0009; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2504
msgctxt "text_id=1772 | speaker=soujuurou"
msgid "\"No, I think I feel fine.\""
msgstr "「いや、体調はいいと思う」"

#. Occurrence 1DOT5_4:2509:1773: scene=1DOT5_4
#: 1DOT5_4:2509
msgctxt "text_id=1773 | speaker=unknown"
msgid "  He waved off her concern."
msgstr "　しんぱいごむよう、と軽く弁明する草十郎。"

#. Occurrence 1DOT5_4:2515:1774: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0010; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2515
msgctxt "text_id=1774 | speaker=soujuurou"
msgid "\"You're wearing your school uniform.\""
msgstr "「だがしかし、蒼崎は制服だった」"

#. Occurrence 1DOT5_4:2526:1775: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0020; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2526
msgctxt "text_id=1775 | speaker=aoko"
msgid "\"Of course I'm wearing my uniform. This is a school activity, isn't it?\""
msgstr "「ええ。学校の行事だもの、当然でしょう？」"

#. Occurrence 1DOT5_4:2532:1776: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0011; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2532
msgctxt "text_id=1776 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 1DOT5_4:2566:1777: scene=1DOT5_4
#: 1DOT5_4:2566
msgctxt "text_id=1777 | speaker=unknown"
msgid "  A heavy weight of despondency fell upon Soujyuro's shoulders."
msgstr "　がっくりと肩に重みを感じる草十郎。"

#. Occurrence 1DOT5_4:2571:1778: scene=1DOT5_4
#: 1DOT5_4:2571
msgctxt "text_id=1778 | speaker=unknown"
msgid "  The angsting over his outfit for the previous two hours had been rendered meaningless just like that."
msgstr "　朝から<益体|やくたい>もなく浮き足立っていた二時間は、こうして容赦なく台無しにされた。"

#. Occurrence 1DOT5_4:2636:1779: scene=1DOT5_4
#: 1DOT5_4:2636
msgctxt "text_id=1779 | speaker=unknown"
msgid "  The duo, clad in their school uniforms on a day off, walked by the train station."
msgstr "　休日の駅前を、制服姿の男女が歩く。"

#. Occurrence 1DOT5_4:2641:1780: scene=1DOT5_4
#: 1DOT5_4:2641
msgctxt "text_id=1780 | speaker=unknown"
msgid "  In the beginning, Aoko had made efforts to give Soujyuro a thorough lay of the land, but today she only shared the bare minimum of explanations."
msgstr "　はじめは丁寧に街の案内をしていた青子だが、今は必要最低限の説明だけにとどめている。"

#. Occurrence 1DOT5_4:2673:1781: scene=1DOT5_4
#: 1DOT5_4:2673
msgctxt "text_id=1781 | speaker=unknown"
msgid "  This was partly because, surprisingly, Soujyuro had become well-accustomed to the town."
msgstr "　草十郎が思いのほか町に詳しくなっていた事もあるが、"

#. Occurrence 1DOT5_4:2678:1782: scene=1DOT5_4
#: 1DOT5_4:2678
msgctxt "text_id=1782 | speaker=unknown"
msgid "  Which restaurants were good... Which shortcuts to use in a rush..."
msgstr "　やれここのゴハンがおいしいだの、"

#. Occurrence 1DOT5_4:2683:1783: scene=1DOT5_4
#: 1DOT5_4:2683
msgctxt "text_id=1783 | speaker=unknown"
msgid "  And why the nearby bicycle shop was better than the department store by the station if you wanted to buy a bicycle... things a local would know."
msgstr "　急いでる時はこっちが近道だの、自転車を買うなら駅前デパートよりあっちの専門店のがいいだの、"

#. Occurrence 1DOT5_4:2693:1784: scene=1DOT5_4
#: 1DOT5_4:2693
msgctxt "text_id=1784 | speaker=unknown"
msgid "  But the other reason was that it had dawned on Aoko how the two of them conversing might look to passersby."
msgstr "　そんな会話をしている時、ハタと冷静に、今の状況が第三者的にどう見えるかに気付いたからだ。"

#. Occurrence 1DOT5_4:2729:1785: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0012; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2729
msgctxt "text_id=1785 | speaker=soujuurou"
msgid "\"On a different topic, do you mind telling me what kind of work we'll be doing today?\""
msgstr "「話は変わるけど。具体的にどんな労働内容なのか、そろそろ聞いていいかな」"

#. Occurrence 1DOT5_4:2749:1786: scene=1DOT5_4
#: 1DOT5_4:2749
msgctxt "text_id=1786 | speaker=unknown"
msgid "  From here on, volunteering at the church meant that the school would tolerate his multiple jobs."
msgstr "　教会の奉仕作業に参加すれば、今後、アルバイトの<掛|か>け<持|も>ちを大目にみてあげられる―――"

#. Occurrence 1DOT5_4:2754:1787: scene=1DOT5_4
#: 1DOT5_4:2754
msgctxt "text_id=1787 | speaker=unknown"
msgid "  Soujyuro had quickly agreed to the tempting offer, nodding like a bobblehead. But, as was typical for him, he had failed to consider the content of the proposal."
msgstr "　そんな甘い誘いにコクコクと頷いた草十郎だが、例によって例の如く、どんな作業なのか考えてもいないようだ。"

#. Occurrence 1DOT5_4:2787:1788: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0021; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2787
msgctxt "text_id=1788 | speaker=aoko"
msgid "\"...Somehow, I just knew you had no idea what we're going to be doing today."
msgstr "「……まあ、そんなコトだろうと覚悟はしてたけど。"

#. Occurrence 1DOT5_4:2793:1789: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0022; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2793
msgctxt "text_id=1789 | speaker=aoko"
msgid "  Is this your first time going to Aida Church?\""
msgstr "　貴方、<合田|あいだ>教会は初めて？」"

#. Occurrence 1DOT5_4:2799:1790: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0013; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2799
msgctxt "text_id=1790 | speaker=soujuurou"
msgid "\"This is my second time. The last time was because I was outside admiring the strange architecture, and then a person inside gave me some free candy.\""
msgstr "「教会なら二回目だ。珍しい建物なんで近寄ったら、中の人がタダでお菓子をくれたんだけど……」"

#. Occurrence 1DOT5_4:2836:1791: scene=1DOT5_4
#: 1DOT5_4:2836
msgctxt "text_id=1791 | speaker=unknown"
msgid "  He pondered with all sincerity how exactly a church worked."
msgstr "　どういう仕組みなんだろう、と草十郎は真剣に考えこんでいる。"

#. Occurrence 1DOT5_4:2841:1792: scene=1DOT5_4
#: 1DOT5_4:2841
msgctxt "text_id=1792 | speaker=unknown"
msgid "  His contemplative posture made him appear the part of the philosopher, but after all his thinking, he concluded,"
msgstr "　うつむく仕草は哲学者のソレだが、しょせん、"

#. Occurrence 1DOT5_4:2847:1793: scene=1DOT5_4
#: 1DOT5_4:2847
msgctxt "text_id=1793 | speaker=unknown"
msgid "\"I guess they start taking your money on your second visit?\""
msgstr "“やっぱり二回目からはお金をとられるのだろうか？”"

#. Occurrence 1DOT5_4:2853:1794: scene=1DOT5_4
#: 1DOT5_4:2853
msgctxt "text_id=1794 | speaker=unknown"
msgid "  ...Such was the extent of Soujyuro's concerns."
msgstr "　程度の悩みである。"

#. Occurrence 1DOT5_4:2888:1795: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0023; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2888
msgctxt "text_id=1795 | speaker=aoko"
msgid "\"...Normally, the church only gives candy out to children, you know.\""
msgstr "「……普通、そういうコトは子供にしかしないんだけどね、あの教会は」"

#. Occurrence 1DOT5_4:2894:1796: scene=1DOT5_4
#: 1DOT5_4:2894
msgctxt "text_id=1796 | speaker=unknown"
msgid "  Aoko sighed at the lost little lamb."
msgstr "　よっぽど迷える子羊に見えたんだろう、とため息をつく青子。"

#. Occurrence 1DOT5_4:2928:1797: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0024; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2928
msgctxt "text_id=1797 | speaker=aoko"
msgid "\"So who did you end up meeting? The priest? One of the sisters?\""
msgstr "「で、どんな人にあったの？　神父、それともシスター？」"

#. Occurrence 1DOT5_4:2934:1798: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0014; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2934
msgctxt "text_id=1798 | speaker=soujuurou"
msgid "\"A very beautiful woman, as it happens.\""
msgstr "「それはそれは、綺麗な女の人だった」"

#. Occurrence 1DOT5_4:2955:1799: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0025; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2955
msgctxt "text_id=1799 | speaker=aoko"
msgid "\"Oh, Sister Yuika, then. If we see her today, you'll need to thank her... or, then again, no need. You're doing just fine in that department anyway.\""
msgstr "「じゃあ<唯架|ゆいか>さんの方ね。今日会ったらお礼を……って、必要ないか。アンタの事だから、そのあたりはキチッとしてるだろうし」"

#. Occurrence 1DOT5_4:2961:1800: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0015; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2961
msgctxt "text_id=1800 | speaker=soujuurou"
msgid "\"Hm?\""
msgstr "「？」"

#. Occurrence 1DOT5_4:2988:1801: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0026; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2988
msgctxt "text_id=1801 | speaker=aoko"
msgid "\"As far as work goes, it's not much different from what you've been doing at school, so it should be straightforward."
msgstr "「仕事の話なら簡単よ。学校でやってる事と変わらないから。"

#. Occurrence 1DOT5_4:2995:1802: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0027; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2995
msgctxt "text_id=1802 | speaker=aoko"
msgid "And considering the church's size, there's actually not a lot of people.\""
msgstr "あの教会、規模のわりに人数が少ないのよ」"

#. Occurrence 1DOT5_4:3015:1803: scene=1DOT5_4
#: 1DOT5_4:3015
msgctxt "text_id=1803 | speaker=unknown"
msgid "  Aoko picked up her pace as they headed for the church."
msgstr "　早足で教会に向かう青子。"

#. Occurrence 1DOT5_4:3020:1804: scene=1DOT5_4
#: 1DOT5_4:3020
msgctxt "text_id=1804 | speaker=unknown"
msgid "  Somehow, she seemed like a general invading enemy territory. It made Soujyuro furrow his brows in discomfort."
msgstr "　なんだか敵地に向かう鬼将軍のようだ、と草十郎は不安げに眉を曇らせた。"

#. Occurrence 1DOT5_4:3067:1805: scene=1DOT5_4
#: 1DOT5_4:3067
msgctxt "text_id=1805 | speaker=unknown"
msgid "  Aida Church had a long history."
msgstr "　合田教会は古い歴史を持つ教会だ。"

#. Occurrence 1DOT5_4:3072:1806: scene=1DOT5_4
#: 1DOT5_4:3072
msgctxt "text_id=1806 | speaker=unknown"
msgid "  Far from the station, it was a white-painted sanctuary nestled between the business and residential districts."
msgstr "　駅から離れた、オフィス街と住宅地の<狭間|はざま>に建てられた白い聖域。"

#. Occurrence 1DOT5_4:3077:1807: scene=1DOT5_4
#: 1DOT5_4:3077
msgctxt "text_id=1807 | speaker=unknown"
msgid "  As far as Aoko could remember, the church as she knew it now was the result of remodeling done eight years prior. It was practically a cathedral for a town of this size."
msgstr "　青子の知るかぎり、たしか八年ほど前に今のカタチに改装された、こんな田舎町には十分すぎるほどの大教会である。"

#. Occurrence 1DOT5_4:3110:1808: scene=1DOT5_4
#: 1DOT5_4:3110
msgctxt "text_id=1808 | speaker=unknown"
msgid "  Incidentally, located next to it was the Misaki City General Hospital."
msgstr "　ちなみに横にあるのは三咲市一の総合病院。"

#. Occurrence 1DOT5_4:3115:1809: scene=1DOT5_4
#: 1DOT5_4:3115
msgctxt "text_id=1809 | speaker=unknown"
msgid "  From Aoko's perspective, it seemed awfully suspicious for the church to take up residence next to the location in the city where the most lives were lost, though the only two who were aware of this opinion were her roommate, Alice Kuonji, and the priest."
msgstr "　青子からすれば、町で一番多くの命が失われる場所の隣にちゃっかり居を構える時点で信用ならない―――のだが、その所感を知るのは同居人である久遠寺有珠と、教会の神父だけに留まっている。"

#. Occurrence 1DOT5_4:3147:1810: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0016; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:3147
msgctxt "text_id=1810 | speaker=soujuurou"
msgid "\"Are you a regular at this place?\""
msgstr "「蒼崎はこの教会に<縁|えん>があるのか？」"

#. Occurrence 1DOT5_4:3158:1811: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0028; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3158
msgctxt "text_id=1811 | speaker=aoko"
msgid "\"Me? Not in the slightest. My father and grandfather had a long history with it, but if I could, I'd go back in time and cut all of our ties to this place."
msgstr "「私？　私はこれっぽっちも、もう過去に戻って<改竄|かいざん>したいぐらい微塵もないけど、うちの父と祖父は長い付き合い。"

#. Occurrence 1DOT5_4:3169:1812: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0029; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3169
msgctxt "text_id=1812 | speaker=aoko"
msgid "  I had to come here every day in elementary school to help out, and boy, did that ever rub me the wrong way.\""
msgstr "　ここの手伝いなんて、忌々しいコトに小学生の頃は毎日してたもんだけど―――」"

#. Occurrence 1DOT5_4:3195:1813: scene=1DOT5_4
#: 1DOT5_4:3195
msgctxt "text_id=1813 | speaker=unknown"
msgid "  The more Aoko spoke, the more twisted her expression became."
msgstr "　話せば話すほど、青子の表情は凶悪になっていく。"

#. Occurrence 1DOT5_4:3200:1814: scene=1DOT5_4
#: 1DOT5_4:3200
msgctxt "text_id=1814 | speaker=unknown"
msgid "  Recalling this made her want to grab it by the proverbial collar, give it the proverbial one-arm judo back throw, smash its proverbial head into the proverbial ground, and kick the proverbial living daylights out of its defenseless proverbial torso."
msgstr "　忘れがたいトラウマと向き合い、胸ぐらを掴み、豪快に一本背負いをかまして脳天を地面にたたきつけたあと、無防備な胴体にローキックを食らわせる―――"

#. Occurrence 1DOT5_4:3205:1815: scene=1DOT5_4
#: 1DOT5_4:3205
msgctxt "text_id=1815 | speaker=unknown"
msgid "  Such was her so-called trauma that if it were anthropomorphized, it would take more than a five-round beating to satisfy her thirst for vengeance."
msgstr "　トラウマとやらが擬人化していれば、その程度の報復行為を軽く五セットはこなしそうな、それはそれは凄まじい気炎をあげるのだった。"

#. Occurrence 1DOT5_4:3240:1816: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0017; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:3240
msgctxt "text_id=1816 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 1DOT5_4:3246:1817: scene=1DOT5_4
#: 1DOT5_4:3246
msgctxt "text_id=1817 | speaker=unknown"
msgid "  It was in this moment, as he became aware of Aoko's mood, that Soujyuro began to fear for his safety."
msgstr "　そんな青子の不機嫌っぷりに、草十郎が我が身の危険を感じだした頃。"

#. Occurrence 1DOT5_4:3252:1818: scene=1DOT5_4
#: 1DOT5_4:3252
msgctxt "text_id=1818 | speaker=unknown"
msgid "  Perhaps attracted by the noisy murder of crows outside the church,"
msgstr "　教会の上空にバサバサ集まりだしたカラスに惹かれたのか、"

msgctxt "text_id=1819 | speaker=unknown"
msgid " a woman in a nun's habit emerged from the front entrance."
msgstr "正面玄関から<修道女|シスター>服の女性が姿を見せた。"

#. Occurrence 1DOT5_4:3288:1820: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0000; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3288
msgctxt "text_id=1820 | speaker=yuika"
msgid "\"Excuse me, do you have business with the church today?"
msgstr "「失礼ですが、どちらのお客様でしょう。"

#. Occurrence 1DOT5_4:3294:1821: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0001; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3294
msgctxt "text_id=1821 | speaker=yuika"
msgid "  I'm afraid this church does not associate with criminals, so if you would be so kind as to consider coming another day, or perhaps return once you have repented of your sinful ways and paid for your crimes to society, you can―\""
msgstr "　当教会は暴力団関係の方はご遠慮いただいておりますので、日を<改|あらた>める、<或|ある>いは生き方を<悔|く>い改めた後、社会的な罪を<償|つぐな>ってから門をくぐって頂きたいのですが―――」"

#. Occurrence 1DOT5_4:3300:1822: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0030; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3300
msgctxt "text_id=1822 | speaker=aoko"
msgid "\"It's Aoko Aozaki, Sister Yuika.\""
msgstr "「蒼崎青子です、シスター唯架」"

#. Occurrence 1DOT5_4:3333:1823: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0002; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3333
msgctxt "text_id=1823 | speaker=yuika"
msgid "\"Well, if it isn't Aoko."
msgstr "「まあ―――青子さんでしたか。"

#. Occurrence 1DOT5_4:3339:1824: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0003; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3339
msgctxt "text_id=1824 | speaker=yuika"
msgid "  What a lovely surprise. It's been such a long time since you've visited.\""
msgstr "　驚きました。昼間のうちに貴女が来るのは久しぶりです」"

#. Occurrence 1DOT5_4:3357:1825: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0031; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3357
msgctxt "text_id=1825 | speaker=aoko"
msgid "\"I suppose it has. I'm only ever called at night to speak with the father."
msgstr "「そうですね。いつもは夜に呼ばれて、神父さまとだけお話をしていますから。唯架さんとは……"

#. Occurrence 1DOT5_4:3363:1826: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0032; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3363
msgctxt "text_id=1826 | speaker=aoko"
msgid "  I suppose it's been, what, close to a year since we had a face-to-face conversation."
msgstr "　まあ。意外ですね、一年近く<ま|・><と|・><も|・>にお話をしていません。"

#. Occurrence 1DOT5_4:3376:1827: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0033; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3376
msgctxt "text_id=1827 | speaker=aoko"
msgid "And who knows how long it'll be until the next time.\""
msgstr "ま、この先だって一度もないでしょうけど」"

#. Occurrence 1DOT5_4:3414:1828: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0004; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3414
msgctxt "text_id=1828 | speaker=yuika"
msgid "\"Yes. I'm almost sad to see you grow up so fast. Your presence has become so menacing, you hardly resemble the virtuous girl I remember so well.\""
msgstr "「ええ。貴女もずいぶんと立派になられたようで、ガッカリです。なにより、今の気配は清らかな少女とは思えないほど<悪辣|あくらつ>でした」"

#. Occurrence 1DOT5_4:3420:1829: scene=1DOT5_4
#: 1DOT5_4:3420
msgctxt "text_id=1829 | speaker=unknown"
msgid "  On the surface, the two exchanged congenial greetings."
msgstr "　表向き、和気あいあいと挨拶を交わすふたり。"

#. Occurrence 1DOT5_4:3425:1830: scene=1DOT5_4
#: 1DOT5_4:3425
msgctxt "text_id=1830 | speaker=unknown"
msgid "  Unable to read between the lines, all Soujyuro could see were two good friends."
msgstr "　そのピリピリした空気をまったく読めず、仲がいいなあ、と見守る草十郎。"

#. Occurrence 1DOT5_4:3462:1831: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0034; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3462
msgctxt "text_id=1831 | speaker=aoko"
msgid "\"He and I are this month's volunteers."
msgstr "「今月のボランティアは私とそこの彼です。"

#. Occurrence 1DOT5_4:3468:1832: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0035; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3468
msgctxt "text_id=1832 | speaker=aoko"
msgid "  For the beloved Aida Church, it would be our pleasure to be working from exactly ten to three, and not a minute more.\""
msgstr "　親愛なる合田教会のためですから。十時から三時まで、一分の狂いもなく、きっかり働かせていただきますわ」"

#. Occurrence 1DOT5_4:3486:1833: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0005; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3486
msgctxt "text_id=1833 | speaker=yuika"
msgid "\"Well, as you know we are reaching the end times, but your spirit of service is welcome."
msgstr "「まあ。世も末ですが歓迎しますね。"

#. Occurrence 1DOT5_4:3492:1834: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0006; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3492
msgctxt "text_id=1834 | speaker=yuika"
msgid "  The house of the Lord is open to all who might enter, even those with wickedness in their hearts.\""
msgstr "　神の家は万人に等しく開くもの。この際、貴女の内面は見なかった事にしておきましょう」"

#. Occurrence 1DOT5_4:3512:1835: scene=1DOT5_4
#: 1DOT5_4:3512
msgctxt "text_id=1835 | speaker=unknown"
msgid "  The nun flashed a smile that was equal parts elegant and cruel."
msgstr "　上品に、しかし酷薄に微笑むシスター。"

#. Occurrence 1DOT5_4:3517:1836: scene=1DOT5_4
#: 1DOT5_4:3517
msgctxt "text_id=1836 | speaker=unknown"
msgid "  Keeping up appearances aside, she seemed overjoyed to have able hands to put to work."
msgstr "　表向きはどうあれ、労働力が手に入ったのは喜ばしい事らしい。"

#. Occurrence 1DOT5_4:3565:1837: scene=1DOT5_4
#: 1DOT5_4:3565
msgctxt "text_id=1837 | speaker=unknown"
msgid "  The sister introduced herself as Yuika Suse and thanked Soujyuro, who had volunteered of his own volition."
msgstr "　シスターは<周|す><瀬|せ><唯架|ゆいか>と名乗り、自ら奉仕活動を希望した草十郎に礼を述べた。"

#. Occurrence 1DOT5_4:3570:1838: scene=1DOT5_4
#: 1DOT5_4:3570
msgctxt "text_id=1838 | speaker=unknown"
msgid "  Soujyuro noticed that her eyes were always shut, but not wanting to be rude, especially in front of Aoko, he decided not to pry."
msgstr "　彼女の閉じた目に気づいていた草十郎だったが、青子の手前もあるし、なにより失礼な事かもしれない、と質問は遠慮した。"

#. Occurrence 1DOT5_4:3605:1839: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0007; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3605
msgctxt "text_id=1839 | speaker=yuika"
msgid "\"So you're Mr. Sizuki."
msgstr "「静希さんと仰るのですね。"

#. Occurrence 1DOT5_4:3611:1840: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0008; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3611
msgctxt "text_id=1840 | speaker=yuika"
msgid "  Your name is as calm as your countenance.\""
msgstr "　声のイメージ通り、落ち着いたお名前です」"

#. Occurrence 1DOT5_4:3617:1841: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0018; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:3617
msgctxt "text_id=1841 | speaker=soujuurou"
msgid "\"It is? Well, thanks.\""
msgstr "「はあ。それはどうも」"

#. Occurrence 1DOT5_4:3623:1842: scene=1DOT5_4
#: 1DOT5_4:3623
msgctxt "text_id=1842 | speaker=unknown"
msgid "  The sister let slip a frown at Soujyuro's ambivalent response to her compliment."
msgstr "　名前を誉められてもいまいち実感の湧かない草十郎に、シスターはわずかに顔を曇らせる。"

#. Occurrence 1DOT5_4:3651:1843: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0009; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3651
msgctxt "text_id=1843 | speaker=yuika"
msgid "\"I apologize. I did not mean to cause discomfort by using your surname."
msgstr "「失礼、名字で呼ばれるのはお嫌いのようですね。"

#. Occurrence 1DOT5_4:3657:1844: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0010; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3657
msgctxt "text_id=1844 | speaker=yuika"
msgid "  May I call you Soujyuro instead?\""
msgstr "　草十郎さん、でよろしいですか？」"

#. Occurrence 1DOT5_4:3677:1845: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0019; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:3677
msgctxt "text_id=1845 | speaker=soujuurou"
msgid "\"Oh, um, whichever. Either one is fine.\""
msgstr "「え、いや、どっちでも、いいですけど」"

#. Occurrence 1DOT5_4:3710:1846: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0011; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3710
msgctxt "text_id=1846 | speaker=yuika"
msgid "\"Well then, as you wish. ...I had not appreciated how difficult a subject it would be.\""
msgstr "「ではそのように。……本当、難儀なことですね」"

#. Occurrence 1DOT5_4:3716:1847: scene=1DOT5_4
#: 1DOT5_4:3716
msgctxt "text_id=1847 | speaker=unknown"
msgid "  Though the sister's tone was gentle, her words seemed somewhat indifferent."
msgstr "　口調こそ穏やかだが、シスターの言葉はどこか冷淡だ。"

#. Occurrence 1DOT5_4:3721:1848: scene=1DOT5_4
#: 1DOT5_4:3721
msgctxt "text_id=1848 | speaker=unknown"
msgid "  She lacked sight, but she guided the two with certainty in her step."
msgstr "　視界を閉ざしている彼女だが、確かな足取りで青子たちを先導する。"

#. Occurrence 1DOT5_4:3764:1849: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0012; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3764
msgctxt "text_id=1849 | speaker=yuika"
msgid "\"Well then, as for what you will be doing...\""
msgstr "「それで、奉仕の内容ですが」"

#. Occurrence 1DOT5_4:3776:1850: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0036; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3776
msgctxt "text_id=1850 | speaker=aoko"
msgid "\"I already know. Christmas is coming up, so you want to get all of the tedious cleaning out of the way, right?"
msgstr "「分かってます。クリスマス前だし、面倒な掃除を済ませておきたいんでしょう？"

#. Occurrence 1DOT5_4:3782:1851: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0037; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3782
msgctxt "text_id=1851 | speaker=aoko"
msgid "  That won't be a problem. Cleaning is our strong suit.\""
msgstr "　問題ありません、そういうの得意ですから」"

#. Occurrence 1DOT5_4:3788:1852: scene=1DOT5_4
#: 1DOT5_4:3788
msgctxt "text_id=1852 | speaker=unknown"
msgid "  It wasn't \"their\" strong suit, as much as it was Soujyuro's."
msgstr "　青子ではなく、おもに連れの草十郎がであるが。"

#. Occurrence 1DOT5_4:3828:1853: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0013; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3828
msgctxt "text_id=1853 | speaker=yuika"
msgid "\"...Then Aoko, you will be at the stove preparing the communion wafers."
msgstr "「……。では青子さんは<竈|かまど>の方で、<聖餅|せいへい>の作り置きを。"

#. Occurrence 1DOT5_4:3835:1854: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0014_0; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3835
msgctxt "text_id=1854 | speaker=yuika"
msgid "  Mr. Sizuki, you will be outside."
msgstr "　静希さんは外に。"

#. Occurrence 1DOT5_4:3847:1855: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0014_1; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3847
msgctxt "text_id=1855 | speaker=yuika"
msgid "I will need your help cleaning the areas I can't reach.\""
msgstr "私どもでは手の届かない箇所の清掃をお願いします」"

#. Occurrence 1DOT5_4:3859:1856: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0038; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3859
msgctxt "text_id=1856 | speaker=aoko"
msgid "\"One question. Ritsuka isn't in the kitchen, is she? You can't make me go in there if she is.\""
msgstr "「ちょっと待って。台所に<律架|りつか>のヤツ、いないでしょうね？　こんな所であんなのに会うなんてゴメンだから」"

#. Occurrence 1DOT5_4:3872:1857: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0015; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3872
msgctxt "text_id=1857 | speaker=yuika"
msgid "\"Don't worry―Ritsuka is not here right now. There's no need to hold back on her account.\""
msgstr "「律架は留守です。ですので、どうぞ気兼ねなく」"

#. Occurrence 1DOT5_4:3898:1858: scene=1DOT5_4
#: 1DOT5_4:3898
msgctxt "text_id=1858 | speaker=unknown"
msgid "  With a dismissive wave, Aoko headed toward the door in the back of the worship hall."
msgstr "　はいはい、と手を振って、青子は礼拝堂奥のドアに向かっていった。"

#. Occurrence 1DOT5_4:3903:1859: scene=1DOT5_4
#: 1DOT5_4:3903
msgctxt "text_id=1859 | speaker=unknown"
msgid "  As she had indicated, she was quite accustomed to this church."
msgstr "　公言通り、この教会には慣れきっているようだ。"

#. Occurrence 1DOT5_4:3942:1860: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0016; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3942
msgctxt "text_id=1860 | speaker=yuika"
msgid "\"This way please, Mr. Sizuki."
msgstr "「静希さんはこちらに。"

#. Occurrence 1DOT5_4:3948:1861: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0017; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3948
msgctxt "text_id=1861 | speaker=yuika"
msgid "  We will start with the storeroom. I'd like to ask you to carry the cleaning supplies.\""
msgstr "　まずは物置から、清掃道具を運んでいただきます」"

#. Occurrence 1DOT5_4:4006:1862: scene=1DOT5_4
#: 1DOT5_4:4006
msgctxt "text_id=1862 | speaker=unknown"
msgid "  The work entrusted to Soujyuro did not require any particular skill. It was window cleaning at its most standard."
msgstr "　草十郎に託された仕事は、これといって特殊な技術を必要としない、いたって普通の窓拭きだった。"

#. Occurrence 1DOT5_4:4027:1863: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0020; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:4027
msgctxt "text_id=1863 | speaker=soujuurou"
msgid "\"Should I clean all of the windows?\""
msgstr "「窓を全部拭けばいいんですね？」"

#. Occurrence 1DOT5_4:4033:1864: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0018; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:4033
msgctxt "text_id=1864 | speaker=yuika"
msgid "\"Yes. Start with a wet rag, then wipe with a dry rag, then use the cleaning spray. Is the ladder tall enough?\""
msgstr "「水拭きとから拭き、その後にコートスプレーもお願いします。ハシゴの高さは足りますか？」"

#. Occurrence 1DOT5_4:4039:1865: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0021; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:4039
msgctxt "text_id=1865 | speaker=soujuurou"
msgid "\"Oh. It looks like it might be a little short.\""
msgstr "「あれ。ちょっと足りないっぽいですね」"

#. Occurrence 1DOT5_4:4045:1866: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0019; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:4045
msgctxt "text_id=1866 | speaker=yuika"
msgid "\"Then just clean what you can reach. Thank you very much.\""
msgstr "「では届く範囲で結構ですので、よろしくお願いします」"

#. Occurrence 1DOT5_4:4092:1867: scene=1DOT5_4
#: 1DOT5_4:4092
msgctxt "text_id=1867 | speaker=unknown"
msgid "  After the brief exchange, the sister returned to the church."
msgstr "　そんな簡潔なやりとりをして、シスターは教会に戻ってしまった。"

#. Occurrence 1DOT5_4:4097:1868: scene=1DOT5_4
#: 1DOT5_4:4097
msgctxt "text_id=1868 | speaker=unknown"
msgid "  Soujyuro began to wonder if it was out of distrust in him that she was being so curt."
msgstr "　よほど草十郎を信頼しているのか、もともとドライな性格なのか。"

#. Occurrence 1DOT5_4:4102:1869: scene=1DOT5_4
#: 1DOT5_4:4102
msgctxt "text_id=1869 | speaker=unknown"
msgid "  He understood that it was too soon to glean an answer from their first meeting, but then again such answers always eluded Soujyuro."
msgstr "　初対面で判断がつく筈もなし、そもそも草十郎にそんな詮索ができる筈もなし。"

#. Occurrence 1DOT5_4:4113:1870: scene=1DOT5_4
#: 1DOT5_4:4113
msgctxt "text_id=1870 | speaker=unknown"
msgid "  Left alone but no less encouraged, Soujyuro began cleaning the windows."
msgstr "　ぽつんと独り放置されても腐ることなく、草十郎は窓拭きを開始した。"

#. Occurrence 1DOT5_4:4162:1871: scene=1DOT5_4
#: 1DOT5_4:4162
msgctxt "text_id=1871 | speaker=unknown"
msgid "  The day's weather was a disappointment once again."
msgstr "　今日も天候は思わしくない。"

#. Occurrence 1DOT5_4:4167:1872: scene=1DOT5_4
#: 1DOT5_4:4167
msgctxt "text_id=1872 | speaker=unknown"
msgid "  It had not gone so far as to rain, but was too overcast to enjoy the sun."
msgstr "　雨が降る程ではないが太陽も見えないハンパな天気だ。"

#. Occurrence 1DOT5_4:4172:1873: scene=1DOT5_4
#: 1DOT5_4:4172
msgctxt "text_id=1873 | speaker=unknown"
msgid "  He leaned against the tall ladder and, beginning with a window about five yards from the ground, quietly cleaned."
msgstr "　高いハシゴに腰をかけて、高さにして五メートル近い窓をのどかに掃除する。"

#. Occurrence 1DOT5_4:4177:1874: scene=1DOT5_4
#: 1DOT5_4:4177
msgctxt "text_id=1874 | speaker=unknown"
msgid "  Soujyuro was never the kind of person to mind physical labor. In fact, if there had been a blue sky, this might have been a perfect day off to him."
msgstr "　草十郎は肉体労働が苦にならない人柄なので、これで空が真っ青であったら、それだけで素晴らしい休日になったかもしれない。"

#. Occurrence 1DOT5_4:4212:1875: scene=1DOT5_4
#: 1DOT5_4:4212
msgctxt "text_id=1875 | speaker=unknown"
msgid "  By the time he finished his third or fourth window, he felt very relaxed and began to whistle."
msgstr "　三枚目、四枚目、と仕上げていくうちに気が<緩|ゆる>み、口笛など吹きつつ窓を拭く。"

#. Occurrence 1DOT5_4:4217:1876: scene=1DOT5_4
#: 1DOT5_4:4217
msgctxt "text_id=1876 | speaker=unknown"
msgid "  Though 15 feet was an intimidating height, it provided a wonderful view at the same time."
msgstr "　五メートル近い高さは怖くはあるが、同時に絶景でもあった。"

#. Occurrence 1DOT5_4:4222:1877: scene=1DOT5_4
#: 1DOT5_4:4222
msgctxt "text_id=1877 | speaker=unknown"
msgid "  Turning toward the town gave Soujyuro a clear view of the tree-topped hill that had previously caught his eye."
msgstr "　ふと町の方に目を向ければ、引っ越してきてからずっと気になっていた、緑の丘が見てとれる。"

#. Occurrence 1DOT5_4:4252:1878: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0022; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:4252
msgctxt "text_id=1878 | speaker=soujuurou"
msgid "\"So there really is a house in the woods.\""
msgstr "「やっぱり、林の中に家があるような……」"

#. Occurrence 1DOT5_4:4258:1879: scene=1DOT5_4
#: 1DOT5_4:4258
msgctxt "text_id=1879 | speaker=unknown"
msgid "  The hill and the woods just outside of town."
msgstr "　三咲町のはずれにある丘と森。"

#. Occurrence 1DOT5_4:4263:1880: scene=1DOT5_4
#: 1DOT5_4:4263
msgctxt "text_id=1880 | speaker=unknown"
msgid "  From here, the forest overlooking the sleepless city looked like a foreign castle."
msgstr "　眠らない町を見下ろす森は、ここから見ると異国の城塞のようだ。"

#. Occurrence 1DOT5_4:4285:1881: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0000; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4285
msgctxt "text_id=1881 | speaker=ritsuka"
msgid "\"Well, well. Do we have a burglar?\""
msgstr "「あれ？　なになに、ドロボウさんー？」"

#. Occurrence 1DOT5_4:4291:1882: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0023; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:4291
msgctxt "text_id=1882 | speaker=soujuurou"
msgid "\"...?\""
msgstr "「？」"

#. Occurrence 1DOT5_4:4324:1883: scene=1DOT5_4
#: 1DOT5_4:4324
msgctxt "text_id=1883 | speaker=unknown"
msgid "  Just then..."
msgstr "　―――と。"

#. Occurrence 1DOT5_4:4329:1884: scene=1DOT5_4
#: 1DOT5_4:4329
msgctxt "text_id=1884 | speaker=unknown"
msgid "  Lost in his thoughts while wiping windows, Soujyuro was pulled out of his trance by someone pacing below him."
msgstr "　物思いにふけりながらもセッセと腕を動かしていた草十郎の眼下で、トコトコと人の気配。"

#. Occurrence 1DOT5_4:4334:1885: scene=1DOT5_4
#: 1DOT5_4:4334
msgctxt "text_id=1885 | speaker=unknown"
msgid "  He looked down and saw a girl, her unkempt clothes otherwise contrasting with her kind visage. "
msgstr "　視線を下げると、そこには一見して人の良さそうな、それでいてだらしなさそうな、女性の姿があった。"

#. Occurrence 1DOT5_4:4366:1886: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0001; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4366
msgctxt "text_id=1886 | speaker=ritsuka"
msgid "\"Hmm. But you look a little too loosey-goosey to be a thief. Wait, I know. Maybe you're the type that jumps out of people's fireplaces and gives them toys they don't need, like that one saint."
msgstr "「ん、でもちょっと怪盗には似合わないのんびり屋さん風味。どっちかって言うと、あれかしら。暖炉から現れては微妙に要らないオモチャを押しつける<聖者|セイント>、みたいな。"

#. Occurrence 1DOT5_4:4377:1887: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0002; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4377
msgctxt "text_id=1887 | speaker=ritsuka"
msgid "  Oh, but I just can't stand his beard. You know all that guy is doing is breaking and entering, right?\""
msgstr "　うわあ……わたし、あのヒゲ苦手なのよねぇ……だってどう見ても不法侵入者じゃない、あの人？」"

#. Occurrence 1DOT5_4:4414:1888: scene=1DOT5_4
#: 1DOT5_4:4414
msgctxt "text_id=1888 | speaker=unknown"
msgid "  She looked to be in her late twenties."
msgstr "　年齢は二十代後半、だろうか。"

#. Occurrence 1DOT5_4:4419:1889: scene=1DOT5_4
#: 1DOT5_4:4419
msgctxt "text_id=1889 | speaker=unknown"
msgid "  Despite the cold, she was not wearing a coat. She had no purse either, which was rather strange as a woman and her purse were never far apart. Not that Soujyuro knew this truth quite yet."
msgstr "　この寒さで上着を羽織っておらず、バッグらしきものも持っていない。草十郎はまだ知りえないコトだが、大人の女性とバッグはワンセットの存在である。"

#. Occurrence 1DOT5_4:4424:1890: scene=1DOT5_4
#: 1DOT5_4:4424
msgctxt "text_id=1890 | speaker=unknown"
msgid "  Based on the fact that none of this seemed to apply to her, one could have easily surmised that she was herself a little \"loosey-goosey.\""
msgstr "　そのあたりを無視しているあたり、この女性の自由奔放さが<窺|うかが>える。"

#. Occurrence 1DOT5_4:4430:1891: scene=1DOT5_4
#: 1DOT5_4:4430
msgctxt "text_id=1891 | speaker=unknown"
msgid " A few cards short of a full deck, one might also say."
msgstr "抜けている、とも言う。"

#. Occurrence 1DOT5_4:4471:1892: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0003; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4471
msgctxt "text_id=1892 | speaker=ritsuka"
msgid "\"Oh, I got it!"
msgstr "「あ。わたし、ピーンと来たわ。"

#. Occurrence 1DOT5_4:4477:1893: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0004; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4477
msgctxt "text_id=1893 | speaker=ritsuka"
msgid "  Are you that part-timer from Misaki High? Wow, high schoolers these days really are something. You put the pros to shame!\""
msgstr "　キミ、ミサ高のバイトの子？　偉いわ、今時の高校生は業者さん顔負けなのね！」"

#. Occurrence 1DOT5_4:4483:1894: scene=1DOT5_4
#: 1DOT5_4:4483
msgctxt "text_id=1894 | speaker=unknown"
msgid "  The girl looked up in admiration to Soujyuro, as he stood atop his ladder."
msgstr "　ハシゴの頂点に座った草十郎を見上げて、女性は感動しきっている。"

#. Occurrence 1DOT5_4:4509:1895: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0005; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4509
msgctxt "text_id=1895 | speaker=ritsuka"
msgid "\"Cool, let me help!"
msgstr "「よーし、わたしも手伝っちゃおうかな！"

#. Occurrence 1DOT5_4:4515:1896: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0006; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4515
msgctxt "text_id=1896 | speaker=ritsuka"
msgid "  Is there another ladder? And rags? Ah, since we're doing this anyway, why don't we just use the hose? You know, spray water all over the place, yelling and having a good time. We might get in trouble, but a little fun never hurt anybody, right?\""
msgstr "　ハシゴはまだある？　他の<雑巾|ぞうきん>は？　あ、どうせだからホースで水をかけるのはどうかしら！　こうバアーっと、けるひゃー！とか叫びながら！　バチあたりだけど、それなら少しぐらいは楽しくなりそうじゃない？」"

#. Occurrence 1DOT5_4:4549:1897: scene=1DOT5_4
#: 1DOT5_4:4549
msgctxt "text_id=1897 | speaker=unknown"
msgid "  The girl let out a hearty laugh."
msgstr "　心底から楽しそうに女性は笑った。"

#. Occurrence 1DOT5_4:4554:1898: scene=1DOT5_4
#: 1DOT5_4:4554
msgctxt "text_id=1898 | speaker=unknown"
msgid "  Her smile glowed like a cactus that had sprouted legs and begun to run about."
msgstr "　光がこぼれそうな、自立して走りまわるサボテンみたいな笑顔だった。"

#. Occurrence 1DOT5_4:4560:1899: scene=1DOT5_4
#: 1DOT5_4:4560
msgctxt "text_id=1899 | speaker=unknown"
msgid "...Inasmuch as a running cactus could only cause trouble."
msgstr "はた迷惑という意味だった。"

#. Occurrence 1DOT5_4:4567:1900: scene=1DOT5_4
#: 1DOT5_4:4567
msgctxt "text_id=1900 | speaker=unknown"
msgid "  As Soujyuro anticipated, the girl began to clean without waiting for his approval."
msgstr "　そんな草十郎の連想通り、女性は草十郎の返事を待たず、まあまあ、と窓拭きに参加した。"

#. Occurrence 1DOT5_4:4632:1901: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0007; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4632
msgctxt "text_id=1901 | speaker=ritsuka"
msgid "\"So I was walking by the church, and I saw a figure stuck to the window. 'A daylight burglary seems pretty bold,' I thought, but my curiosity got the best of me."
msgstr "「いえ、教会の前を通ったら、人影っぽいのが窓にへばりついてるのが見えちゃったの。昼間っから泥棒とか豪快だなあって、ちょっと興味ひかれちゃって。"

#. Occurrence 1DOT5_4:4638:1902: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0008; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4638
msgctxt "text_id=1902 | speaker=ritsuka"
msgid "  Imagine my surprise when I saw such a cute boy working as diligently as a window wiping expert. You can't blame a girl for wanting to help out after seeing that, can you?\""
msgstr "　そしたら可愛い子が真面目に労働してたワケ。窓拭きの達人みたいに、ビっと格好よく。そんなの見せられたら手伝いたくなるのが人情じゃない？」"

#. Occurrence 1DOT5_4:4658:1903: scene=1DOT5_4
#: 1DOT5_4:4658
msgctxt "text_id=1903 | speaker=unknown"
msgid "  Wiping the window next to Soujyuro, the girl continued to chatter cheerfully."
msgstr "　草十郎のひとつ隣の窓を拭きながら、女性は陽気に話しかけてくる。"

#. Occurrence 1DOT5_4:4663:1904: scene=1DOT5_4
#: 1DOT5_4:4663
msgctxt "text_id=1904 | speaker=unknown"
msgid "  Although this was all kinds of suspicious, Soujyuro politely followed her lead, nodding and agreeing as she spoke."
msgstr "　そんな、考えようによっては怪しいコトこの上ない女性にうんうんと真面目に同意する草十郎。"

#. Occurrence 1DOT5_4:4668:1905: scene=1DOT5_4
#: 1DOT5_4:4668
msgctxt "text_id=1905 | speaker=unknown"
msgid "  Perhaps it was an instinctive camaraderie."
msgstr "　なんというか、彼の本能が理解したのだ。"

#. Occurrence 1DOT5_4:4673:1906: scene=1DOT5_4
#: 1DOT5_4:4673
msgctxt "text_id=1906 | speaker=unknown"
msgid "  He sensed this girl was just like him, always getting the short end of the stick when it came to menial work."
msgstr "　この女性は自分と同じように、いつもこういう地味な作業を押しつけられる同士なのだと―――！"

#. Occurrence 1DOT5_4:4720:1907: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0024; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:4720
msgctxt "text_id=1907 | speaker=soujuurou"
msgid "\"So are you from the church?\""
msgstr "「貴方は教会の人なんですか？」"

#. Occurrence 1DOT5_4:4752:1908: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0009; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4752
msgctxt "text_id=1908 | speaker=ritsuka"
msgid "\"Me? No, I was just passing by."
msgstr "「わたし？　いえ、ただの通りすがりよ。"

#. Occurrence 1DOT5_4:4763:1909: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0010; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4763
msgctxt "text_id=1909 | speaker=ritsuka"
msgid "  More importantly, why are you acting like we've never met before? Don't you remember all those times we met in the shopping mall?\""
msgstr "　それより貴方ってのは他人行儀ねぇ。キミとは商店街で何度も会ってるのに」"

#. Occurrence 1DOT5_4:4769:1910: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0025; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:4769
msgctxt "text_id=1910 | speaker=soujuurou"
msgid "\"No... When did that happen?\""
msgstr "「いや、会ってませんよ？」"

#. Occurrence 1DOT5_4:4819:1911: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0011_0; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4819
msgctxt "text_id=1911 | speaker=ritsuka"
msgid "\"All the time, silly! You work at that restaurant, Uotatsu, right? I was there several times just this week!"
msgstr "「会ってますー。キミ、<魚達|うおたつ>さんでバイトしてる子でしょう？　今週だけでも何度か行ってるもん、わたし。"

#. Occurrence 1DOT5_4:4831:1912: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0011_1; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4831
msgctxt "text_id=1912 | speaker=ritsuka"
msgid "  I'm... um... Oh, right."
msgstr "　わたしは―――ええっと、そうね、"

#. Occurrence 1DOT5_4:4843:1913: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0011_2; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4843
msgctxt "text_id=1913 | speaker=ritsuka"
msgid "I'm Hanazawa. What's your name?\""
msgstr "<花澤|はなざわ>って言うんだけど、キミの名前は？」"

#. Occurrence 1DOT5_4:4863:1914: scene=1DOT5_4
#: 1DOT5_4:4863
msgctxt "text_id=1914 | speaker=unknown"
msgid "  Hanazawa took a quick glance at the flower bed below in the middle of her introduction, then gave him a friendly laugh."
msgstr "　台詞の途中、ちらりと眼下の花壇を見ながら、きさくに笑いかける花澤さん。"

#. Occurrence 1DOT5_4:4868:1915: scene=1DOT5_4
#: 1DOT5_4:4868
msgctxt "text_id=1915 | speaker=unknown"
msgid "  Soujyuro's self-introduction, however, was his usual brand of awkward."
msgstr "　草十郎はいつも通り、自信なげに自己紹介を済ませた。"

#. Occurrence 1DOT5_4:4915:1916: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0012; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4915
msgctxt "text_id=1916 | speaker=ritsuka"
msgid "\"Soujyuro, huh? ...Your name's cute, in an old-fashioned kind of way."
msgstr "「草十郎さん……うん、いい名前ね、古風な感じで。"

#. Occurrence 1DOT5_4:4921:1917: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0013; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4921
msgctxt "text_id=1917 | speaker=ritsuka"
msgid "  The 'jyu' in your name means 'ten,' right? Names with numbers in them are so Japanese, don't you think? ...Do you know the priest and sisters here? Eiri and Yuika... Their names sound so foreign.\""
msgstr "　名前に数字が入ってると、なんか日本人って感じがしない？　ここの神父さんとかシスターの名前、知ってる？　エイリとかユイカとか、なんか外国風なんだけど」"

#. Occurrence 1DOT5_4:4953:1918: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0026; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:4953
msgctxt "text_id=1918 | speaker=soujuurou"
msgid "\"I don't know Eiri, but Yuika was the woman with the pretty dark hair, right?\""
msgstr "「エイリさんはともかく、唯架さんは綺麗な黒髪の女の人でしたよ？」"

#. Occurrence 1DOT5_4:5002:1919: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0014; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5002
msgctxt "text_id=1919 | speaker=ritsuka"
msgid "\"Oh, so you haven't met the priest yet."
msgstr "「あら、神父さんにはまだ会っていないのね。"

#. Occurrence 1DOT5_4:5008:1920: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0015; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5008
msgctxt "text_id=1920 | speaker=ritsuka"
msgid "  Aida Church is famous for its handsome priest and beautiful sisters, you know. ...Oh, that's right! You just moved here! You're living on your own, right?\""
msgstr "　合田教会の美形神父と美人姉妹って言ったら有名なんだけど……あ、そうか！　さてはキミ、最近引っ越してきたんでしょう！　しかもひとり暮らしと見たわ！」"

#. Occurrence 1DOT5_4:5043:1921: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0027_0; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5043
msgctxt "text_id=1921 | speaker=soujuurou"
msgid "\"Yes..."
msgstr "「そうですけど……"

#. Occurrence 1DOT5_4:5056:1922: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0027_1; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5056
msgctxt "text_id=1922 | speaker=soujuurou"
msgid "You're really sharp, Ms. Hanazawa. You seem to be pretty good at guessing things about me.\""
msgstr "花澤さん、すごいですね？　さっきからあまりにも的確なあてずっぽうです」"

#. Occurrence 1DOT5_4:5092:1923: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0016; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5092
msgctxt "text_id=1923 | speaker=ritsuka"
msgid "\"It's called deductive reasoning, silly."
msgstr "「いえいえ、推理と言ってくれたまえ。"

#. Occurrence 1DOT5_4:5098:1924: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0017; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5098
msgctxt "text_id=1924 | speaker=ritsuka"
msgid "  This town doesn't have much to do for fun, certainly not enough that a kid like you would need to work this much. Normally, you'd just need one job to cover spending money. You don't seem like the materialistic type, either."
msgstr "　キミぐらいの子がアルバイトに精を出すほど、この町の娯楽は魅力的じゃないもの。遊ぶお金ならバイト一件で<賄|まかな>えちゃうわ。キミは物欲のあるタイプじゃなさそうだし。"

#. Occurrence 1DOT5_4:5104:1925: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0018; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5104
msgctxt "text_id=1925 | speaker=ritsuka"
msgid "  Which leaves living expenses as the only wholesome reason for working this hard, right?"
msgstr "　となると、これはもう生活費のためと考えるのが健全でしょう？"

#. Occurrence 1DOT5_4:5111:1926: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0019; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5111
msgctxt "text_id=1926 | speaker=ritsuka"
msgid "Hmm. Then again, it isn't very 'wholesome' for a student to be paying for his own room, board, and tuition.\""
msgstr "　……んー、まあ、学生さんが生活費も学費も自分だけで賄う、なんてのは健全じゃないんだけど」"

#. Occurrence 1DOT5_4:5166:1927: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0028; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5166
msgctxt "text_id=1927 | speaker=soujuurou"
msgid "\"Not necessarily."
msgstr "「いや、そうでもないですよ？"

#. Occurrence 1DOT5_4:5166:1928: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0028; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5166
msgctxt "text_id=1928 | speaker=soujuurou"
msgid "  Don't they say he who does not work, doesn't eat?\""
msgstr "　働かざるもの食うべからずです」"

#. Occurrence 1DOT5_4:5180:1929: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0020; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5180
msgctxt "text_id=1929 | speaker=ritsuka"
msgid "\"Wow, Soujyuro. You're pretty mature for your age."
msgstr "「そっかぁ。草十郎さんは若いのに立派ねー。"

#. Occurrence 1DOT5_4:5180:1930: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0020; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5180
msgctxt "text_id=1930 | speaker=ritsuka"
msgid "  When I was a student, I was completely absorbed in work, too, so I understand how difficult things must be for you.\""
msgstr "　わたしも学生の頃はバイト三昧だったから、少しはキミのたいへんさも分かるわよー」"

#. Occurrence 1DOT5_4:5191:1931: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0029; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5191
msgctxt "text_id=1931 | speaker=soujuurou"
msgid "\"Oh. You lived by yourself as well, Ms. Hanazawa?\""
msgstr "「なんと。花澤さんもひとり暮らしだったんですか？」"

#. Occurrence 1DOT5_4:5217:1932: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0021; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5217
msgctxt "text_id=1932 | speaker=ritsuka"
msgid "\"Yeah. I studied abroad over my parents' objections. I went to the same school as a friend, and we roomed together to save money. But food wasn't free, as you know."
msgstr "「ええ。親の反対をおしきって、よその国に留学しちゃったの。<留学先|あっち>にはトモダチもいたから下宿先には困らなかったけど、さすがに食費ぐらいは稼がないとねー。"

#. Occurrence 1DOT5_4:5223:1933: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0022; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5223
msgctxt "text_id=1933 | speaker=ritsuka"
msgid "  That said, I'm the kind of person who doesn't mind a bit of elbow grease. Looking back on it now, my time at school and work was a great memory.\""
msgstr "　けどまあ、こう見えて肉体労働は苦にならないタイプだし。学院もバイトも楽しい思い出になってるわ」"

#. Occurrence 1DOT5_4:5280:1934: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0030; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5280
msgctxt "text_id=1934 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 1DOT5_4:5286:1935: scene=1DOT5_4
#: 1DOT5_4:5286
msgctxt "text_id=1935 | speaker=unknown"
msgid "  Soujyuro nodded agreeably."
msgstr "　おお、とまたもコクコク頷く草十郎。"

#. Occurrence 1DOT5_4:5291:1936: scene=1DOT5_4
#: 1DOT5_4:5291
msgctxt "text_id=1936 | speaker=unknown"
msgid "  Dignified or not, he could barely hold back the sense of solidarity that was welling up within him."
msgstr "　<節操|せっそう>なく湧きたつ親近感を<抑|おさ>えられない。"

#. Occurrence 1DOT5_4:5340:1937: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0023; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5340
msgctxt "text_id=1937 | speaker=ritsuka"
msgid "\"Hehehe. Well, since this might be fate, and I'll probably be seeing more of you at Uotatsu from here on out, come see me if you need someone to talk to. I can't promise that I'll be much help, but I'll do my best impression of a sounding board.\""
msgstr "「ふふふ。これも何かの縁だし、魚達さんではこれからお世話になりそうだし。頼りないだろうけど、相談事があったらぜひ言ってね。精神面で力になるわ」"

#. Occurrence 1DOT5_4:5389:1938: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0031; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5389
msgctxt "text_id=1938 | speaker=soujuurou"
msgid "\"Thank you, I appreciate it."
msgstr "「ありがとうございます。"

#. Occurrence 1DOT5_4:5396:1939: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0032_0; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5396
msgctxt "text_id=1939 | speaker=soujuurou"
msgid "  Maybe you can help me out right now."
msgstr "　じゃあ早速ですけど、"

#. Occurrence 1DOT5_4:5408:1940: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0032_1; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5408
msgctxt "text_id=1940 | speaker=soujuurou"
msgid "What do they actually do here?"
msgstr "ここは何をするところなんでしょう？"

#. Occurrence 1DOT5_4:5408:1941: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0032_1; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5408
msgctxt "text_id=1941 | speaker=soujuurou"
msgid "\""
msgstr "」"

#. Occurrence 1DOT5_4:5415:1942: scene=1DOT5_4
#: 1DOT5_4:5415
msgctxt "text_id=1942 | speaker=unknown"
msgid "  As Soujyuro said \"here,\" he pointed at the church."
msgstr "　ここ、と教会を指さす草十郎。"

#. Occurrence 1DOT5_4:5464:1943: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0024; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5464
msgctxt "text_id=1943 | speaker=ritsuka"
msgid "\"Uhh...what do you mean?\""
msgstr "「え、えっと？」"

#. Occurrence 1DOT5_4:5470:1944: scene=1DOT5_4
#: 1DOT5_4:5470
msgctxt "text_id=1944 | speaker=unknown"
msgid "  Even Hanazawa was taken aback by his question."
msgstr "　さすがの花澤さんも面食らっている。"

#. Occurrence 1DOT5_4:5475:1945: scene=1DOT5_4
#: 1DOT5_4:5475
msgctxt "text_id=1945 | speaker=unknown"
msgid "  Unaware of Soujyuro's provincial background―combined with her quick-witted nature―Hanazawa seemingly mistook his question for some kind of sophisticated wit."
msgstr "　草十郎がビンテージものの田舎者である事なんぞ知らない花澤さんであるが、持ち前の機転の良さで、これは高度な皮肉なのだと勘違いしてしまったようだ。"

#. Occurrence 1DOT5_4:5513:1946: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0025; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5513
msgctxt "text_id=1946 | speaker=ritsuka"
msgid "\"Hmm. Good question."
msgstr "「うーん、そうねー。"

#. Occurrence 1DOT5_4:5519:1947: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0026; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5519
msgctxt "text_id=1947 | speaker=ritsuka"
msgid "  I guess people treat it as a spiritual sanctuary... Is that the right word for it? No, maybe not sanctuary, more like a shield, or... a place that plugs leaks in your mind? It's basically a way for people to avoid getting better."
msgstr "　心の安全を扱っている、というのはどうかしら。いえ、安全というよりは鎧？　ツギハギのバリケード？　とにかく本人はちっとも鍛えられないってコトは同じよね。"

#. Occurrence 1DOT5_4:5525:1948: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0027; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5525
msgctxt "text_id=1948 | speaker=ritsuka"
msgid "  Oh, and they give out free bread and wine.\""
msgstr "　ああ、あとはパンとワインも分けてくれるわね」"

#. Occurrence 1DOT5_4:5531:1949: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0033; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5531
msgctxt "text_id=1949 | speaker=soujuurou"
msgid "\"For free?\""
msgstr "「無料でですか？」"

#. Occurrence 1DOT5_4:5552:1950: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0028; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5552
msgctxt "text_id=1950 | speaker=ritsuka"
msgid "\"Sure! I mean, I've heard rich people just donate a bunch of money anyway."
msgstr "「もちろん。富める者は勝手に置いていくって話。"

#. Occurrence 1DOT5_4:5558:1951: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0029; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5558
msgctxt "text_id=1951 | speaker=ritsuka"
msgid "  Oh yeah, one more thing, and this is the most important wrinkle--their income isn't taxed. Saving souls is tough work, but it's zero-risk high-reward if you've got a solid business plan.\""
msgstr "　あとは―――そっか。これが一番大きいんだけど、収入に税金がかからない。心の安全は扱いが難しいけど、きちんと売り物にできればノーリスクハイリターンよ」"

#. Occurrence 1DOT5_4:5616:1952: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0034; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5616
msgctxt "text_id=1952 | speaker=soujuurou"
msgid "\"Is that so... I don't really follow, but are you saying that that it's a good place to come when you're in trouble?\""
msgstr "「……はあ。よく分からないですけど、ピンチの時はここに転がりこめばいいんですね？」"

#. Occurrence 1DOT5_4:5622:1953: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0030; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5622
msgctxt "text_id=1953 | speaker=ritsuka"
msgid "\"Umm... I wouldn't recommend that."
msgstr "「んー、それはおすすめしないなあ。"

#. Occurrence 1DOT5_4:5628:1954: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0031; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5628
msgctxt "text_id=1954 | speaker=ritsuka"
msgid "  I think it would be better to visit once a month or so, just for a little peace of mind.\""
msgstr "　ご利用は月に一回、気休め程度にした方がいいと思う」"

#. Occurrence 1DOT5_4:5671:1955: scene=1DOT5_4
#: 1DOT5_4:5671
msgctxt "text_id=1955 | speaker=unknown"
msgid "  The rags squeaked as the two carefree souls continued to wipe down the windows."
msgstr "　きゅっきゅっ、と窓を<拭|ふ>く音が響く。"

#. Occurrence 1DOT5_4:5676:1956: scene=1DOT5_4
#: 1DOT5_4:5676
msgctxt "text_id=1956 | speaker=unknown"
msgid "  Whistling as they went, they shined up one window. Then another. Then another."
msgstr "　趣味を同じくするふたりは<暢気|のんき>に口笛を吹きながら一枚、また一枚、と教会の窓を磨き上げていく。"

#. Occurrence 1DOT5_4:5719:1957: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0035; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5719
msgctxt "text_id=1957 | speaker=soujuurou"
msgid "\"Oh yeah, one more question."
msgstr "「そうだ、もうひとつあります。"

#. Occurrence 1DOT5_4:5725:1958: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0036; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5725
msgctxt "text_id=1958 | speaker=soujuurou"
msgid "  What are those woods way over there?\""
msgstr "　ここから見えるあの森、なんですか？」"

#. Occurrence 1DOT5_4:5737:1959: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0032; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5737
msgctxt "text_id=1959 | speaker=ritsuka"
msgid "\"Woods? On the mountain, you mean?\""
msgstr "「森？　あの山の上にある森のコト？」"

#. Occurrence 1DOT5_4:5773:1960: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0037; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5773
msgctxt "text_id=1960 | speaker=soujuurou"
msgid "\"Well, yeah, but that's really more of a hill than a mountain.\""
msgstr "「ですけど、アレは山じゃなくて丘と言うべきです」"

#. Occurrence 1DOT5_4:5779:1961: scene=1DOT5_4
#: 1DOT5_4:5779
msgctxt "text_id=1961 | speaker=unknown"
msgid "  As someone raised in the countryside, Soujyuro's pride would not allow for a mound of dirt to be called a mountain."
msgstr "　田舎育ちの人間として、あの程度の高台を山というのはプライドが許さないらしい。"

#. Occurrence 1DOT5_4:5828:1962: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0033; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5828
msgctxt "text_id=1962 | speaker=ritsuka"
msgid "\"You think so? Any incline that takes energy to climb is a mountain in my book. But if you say so...\""
msgstr "「そう？　あれはあれで、けっこう登るのに体力使うんだけど……まあ、<丘|そっち>の方がより<ら|・><し|・><い|・>わねぇ」"

#. Occurrence 1DOT5_4:5834:1963: scene=1DOT5_4
#: 1DOT5_4:5834
msgctxt "text_id=1963 | speaker=unknown"
msgid "  It was as if a shadow fell over her till-now sunny disposition."
msgstr "　女性の気さくな笑顔に自虐的な影がさす。"

#. Occurrence 1DOT5_4:5839:1964: scene=1DOT5_4
#: 1DOT5_4:5839
msgctxt "text_id=1964 | speaker=unknown"
msgid "  She was undoubtedly a beautiful woman with very lovely features."
msgstr "　もともと端整な顔つきをした美人だ。"

#. Occurrence 1DOT5_4:5844:1965: scene=1DOT5_4
#: 1DOT5_4:5844
msgctxt "text_id=1965 | speaker=unknown"
msgid "  But as Soujyuro looked at her in that moment, her smile melted away, and he saw how disturbed she was at his comment."
msgstr "　笑顔を崩すと一転して酷薄な、見るものを威圧する表情になる事に、今さらながら草十郎は気が付いた。"

#. Occurrence 1DOT5_4:5849:1966: scene=1DOT5_4
#: 1DOT5_4:5849
msgctxt "text_id=1966 | speaker=unknown"
msgid "  And when it comes down to it..."
msgstr "　もちろん、"

#. Occurrence 1DOT5_4:5887:1967: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0038; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5887
msgctxt "text_id=1967 | speaker=soujuurou"
msgid "\"It's definitely a hill. Oh, and what about that thing that looks like a chimney?\""
msgstr "「あれは丘です。それとほら、ここから<煙突|えんとつ>みたいなの見えますけど、アレはなんですか？」"

#. Occurrence 1DOT5_4:5893:1968: scene=1DOT5_4
#: 1DOT5_4:5893
msgctxt "text_id=1968 | speaker=unknown"
msgid "  Soujyuro was not one to closely watch people's reactions and fuss over his speech."
msgstr "　そんな事で草十郎があれこれ遠慮したり、怪しんだりする事はないのだった。"

#. Occurrence 1DOT5_4:5914:1969: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0034; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5914
msgctxt "text_id=1969 | speaker=ritsuka"
msgid "\"It looks like a chimney because it is a chimney."
msgstr "「あれは本物の煙突よ。"

#. Occurrence 1DOT5_4:5920:1970: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0035; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5920
msgctxt "text_id=1970 | speaker=ritsuka"
msgid "  That forest is all private property, and a huge mansion sits right in the middle of it. None of the locals really know anything about it because they're not allowed in there."
msgstr "　あの森は全部私有地なんだけど、その中にでっかい洋館が建っているの。でも私有地だから地元の人間も入ったコトはないんじゃないかしら。"

#. Occurrence 1DOT5_4:5962:1971: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0036; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5962
msgctxt "text_id=1971 | speaker=ritsuka"
msgid "  People call it the Kuonji Haunted Mansion. The locals are all spooked by it, so it's probably best that you keep your distance. For a tiny wooded area, there have been all kinds of freaky stories about the place―weird accidents, wild dog sightings, you name it.\""
msgstr "　通称、<久遠寺|くおんじ>のお化け屋敷ってね。近所の皆さんは気味悪がってるし、あんまり近寄らない方がいいんじゃない？　あんな小さな森なのに遭難したとか、野犬が出るとか、物騒な話には事欠かないから」"

#. Occurrence 1DOT5_4:5988:1972: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0039; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5988
msgctxt "text_id=1972 | speaker=soujuurou"
msgid "\"Wild dogs? You get wild dogs here in the city, too?\""
msgstr "「野犬って、都会にも野犬？」"

#. Occurrence 1DOT5_4:5999:1973: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0037; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5999
msgctxt "text_id=1973 | speaker=ritsuka"
msgid "\"Lots of them! There are even some in the empty lot behind the church. The priest here is a bit eccentric, and one time he gave them some bread, and the pups made the area part of their patrol route.\""
msgstr "「たくさんいるわよー。この教会の裏手の空き地にだっているし。ここの神父さんは物好きだからパンとかあげちゃって、それでワンちゃんの巡回ルートになっちゃってるんでしょうけど」"

#. Occurrence 1DOT5_4:6005:1974: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0040; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6005
msgctxt "text_id=1974 | speaker=soujuurou"
msgid "\"...?\""
msgstr "「？」"

#. Occurrence 1DOT5_4:6063:1975: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0038; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:6063
msgctxt "text_id=1975 | speaker=ritsuka"
msgid "\"Anyway, don't go up there. You know what they say about idiots and high places. It's something of an unspoken rule around here to stay out."
msgstr "「とにかく、君子危うきに近寄らず、よ。あの森には入らないのが街のルールなの。"

#. Occurrence 1DOT5_4:6069:1976: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0039; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:6069
msgctxt "text_id=1976 | speaker=ritsuka"
msgid "  For one thing, it's private property! If you trespass, someone's going to call the cops, and then you're going to spend the rest of the day getting grilled at the station. That doesn't sound like much fun, does it?\""
msgstr "　そもそも私有地だし、入ったらお巡りさんを呼ばれちゃって、そのまま交番でお説教ターイム！　なんて、あんまり楽しくないでしょう？」"

#. Occurrence 1DOT5_4:6115:1977: scene=1DOT5_4
#: 1DOT5_4:6115
msgctxt "text_id=1977 | speaker=unknown"
msgid "  Soujyuro nodded along to her story as he stared at the far-off chimney from his vantage point on the ladder."
msgstr "　なるほど、とハシゴの上から遥か彼方の煙突を眺める。"

#. Occurrence 1DOT5_4:6120:1978: scene=1DOT5_4
#: 1DOT5_4:6120
msgctxt "text_id=1978 | speaker=unknown"
msgid "  A teeny tiny part of him was curious about that hill, because it reminded him of the woods where he grew up, but after reminding himself that it was none of his business, he returned to window washing."
msgstr "　少しだけ、ほんの少しだけ故郷の森を連想させる丘なので気になっていたが、どうやら自分には何の関係もないようだと納得し、草十郎は窓拭きを再開した。"

#. Occurrence 1DOT5_4:6177:1979: scene=1DOT5_4
#: 1DOT5_4:6177
msgctxt "text_id=1979 | speaker=unknown"
msgid "  Thanks to Hanazawa lending a hand, they were able to finish the job without a hitch."
msgstr "　花澤さんの協力のおかげで、窓拭きは滞りなく終了した。"

#. Occurrence 1DOT5_4:6182:1980: scene=1DOT5_4
#: 1DOT5_4:6182
msgctxt "text_id=1980 | speaker=unknown"
msgid "  Between the two of them, they had accomplished a simple but very time-consuming task."
msgstr "　ふたりがかりで、地味だが手間のかかる仕事をやり遂げたのだ。"

#. Occurrence 1DOT5_4:6221:1981: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0040; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:6221
msgctxt "text_id=1981 | speaker=ritsuka"
msgid "\"Nice work."
msgstr "「はい、ごくろうさまでした。"

#. Occurrence 1DOT5_4:6227:1982: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0041; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:6227
msgctxt "text_id=1982 | speaker=ritsuka"
msgid "  I hardly recognize these windows, considering how filthy they were before!"
msgstr "　うん、あれだけ砂まみれだった窓が見違えたわね！"

#. Occurrence 1DOT5_4:6245:1983: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0042; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:6245
msgctxt "text_id=1983 | speaker=ritsuka"
msgid "  Why don't we head to a café somewhere and get something to drink? I'll treat you as a reward for all your"
msgstr "　どう、これから適当な<茶店|さてん>でお茶にしない？　草十郎さんの仕事っぷりに敬意を表して、わたしがおご"

#. Occurrence 1DOT5_4:6258:1984: scene=1DOT5_4
#: 1DOT5_4:6258
msgctxt "text_id=1984 | speaker=unknown"
msgid "―\""
msgstr "―――」"

#. Occurrence 1DOT5_4:6284:1985: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0041; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6284
msgctxt "text_id=1985 | speaker=soujuurou"
msgid "\"Ms. Hanazawa? You were in the middle of saying som―\""
msgstr "「はい？　何か言いました、花澤さ―――」"

#. Occurrence 1DOT5_4:6296:1986: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0043; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:6296
msgctxt "text_id=1986 | speaker=ritsuka"
msgid "\"Oh, sorry, I just remembered some urgent business I need to attend to."
msgstr "「いえ、ごめんなさい、急用を思い出しちゃった。"

#. Occurrence 1DOT5_4:6307:1987: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0044; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:6307
msgctxt "text_id=1987 | speaker=ritsuka"
msgid "  Catch you later! Ciao!\""
msgstr "　花澤さんはここで失礼するのでした。チャオ～」"

#. Occurrence 1DOT5_4:6318:1988: scene=1DOT5_4
#: 1DOT5_4:6318
msgctxt "text_id=1988 | speaker=unknown"
msgid "  By the time Soujyuro, who had started putting away the ladder, turned around, he was only able to catch a glimpse of the girl's figure dashing toward the street at lightning speed."
msgstr "　ハシゴを片づけていた草十郎が振り向くと、女性は<脱兎|だっと>の如く表通りに走り去っていた。"

#. Occurrence 1DOT5_4:6352:1989: scene=1DOT5_4
#: 1DOT5_4:6352
msgctxt "text_id=1989 | speaker=unknown"
msgid "  It was just before three o'clock."
msgstr "　時刻はそろそろ三時。"

#. Occurrence 1DOT5_4:6357:1990: scene=1DOT5_4
#: 1DOT5_4:6357
msgctxt "text_id=1990 | speaker=unknown"
msgid "  More than three hours had passed since Hanazawa offered to help."
msgstr "　花澤さんが手伝いを申し出てから三時間以上経過している。"

#. Occurrence 1DOT5_4:6392:1991: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0042; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6392
msgctxt "text_id=1991 | speaker=soujuurou"
msgid "\"Hmm...\""
msgstr "「うむ」"

#. Occurrence 1DOT5_4:6398:1992: scene=1DOT5_4
#: 1DOT5_4:6398
msgctxt "text_id=1992 | speaker=unknown"
msgid "  Soujyuro watched the girl with many strange faces disappear."
msgstr "　彼女の急変をしたり顔で見送る草十郎。"

#. Occurrence 1DOT5_4:6403:1993: scene=1DOT5_4
#: 1DOT5_4:6403
msgctxt "text_id=1993 | speaker=unknown"
msgid "  For someone who seemed to have been on an aimless walk, Hanazawa had spent a good deal of time with him."
msgstr "　行くあてなく散歩をしていたように見えた花澤さんだが、これだけ時間を潰したのだ。"

#. Occurrence 1DOT5_4:6408:1994: scene=1DOT5_4
#: 1DOT5_4:6408
msgctxt "text_id=1994 | speaker=unknown"
msgid "  Maybe helping Soujyuro out reminded her of something she needed to do."
msgstr "　手伝ってくれた時と同じように、適当な用事を思いだしてしまったのだろう。"

#. Occurrence 1DOT5_4:6439:1995: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0039; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6439
msgctxt "text_id=1995 | speaker=aoko"
msgid "\"Sizuki, are you out there?\""
msgstr "「静希君、そっちにいるの？」"

#. Occurrence 1DOT5_4:6445:1996: scene=1DOT5_4
#: 1DOT5_4:6445
msgctxt "text_id=1996 | speaker=unknown"
msgid "  The student council president popped her head out from the corner of the church."
msgstr "　と。教会の角からひょっこり顔を出す生徒会長。"

#. Occurrence 1DOT5_4:6483:1997: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0040; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6483
msgctxt "text_id=1997 | speaker=aoko"
msgid "\"Ah, don't mind me. You do your thing...\""
msgstr "「あ、声かけてゴメン。いいから作業に専念―――」"

#. Occurrence 1DOT5_4:6489:1998: scene=1DOT5_4
#: 1DOT5_4:6489
msgctxt "text_id=1998 | speaker=unknown"
msgid "  The sight of Soujyuro putting away a ladder taller than himself seemed to have provoked an emotional response in Aoko."
msgstr "　自分の背丈より長いハシゴを片づけている草十郎を見て、青子は面食らったようだ。"

#. Occurrence 1DOT5_4:6499:1999: scene=1DOT5_4
#: 1DOT5_4:6499
msgctxt "text_id=1999 | speaker=unknown"
msgid "  Then, in an instant, she rolled up her sleeves and began to approach him."
msgstr "　それも一瞬の事で、彼女は腕まくりをして草十郎に歩み寄った。"

#. Occurrence 1DOT5_4:6537:2000: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0043; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6537
msgctxt "text_id=2000 | speaker=soujuurou"
msgid "\"Hm?\""
msgstr "「？」"

#. Occurrence 1DOT5_4:6542:2001: scene=1DOT5_4
#: 1DOT5_4:6542
msgctxt "text_id=2001 | speaker=unknown"
msgid "  This surprised him more than Aoko's sudden appearance."
msgstr "　とつぜん現れた青子より、草十郎にはそっちの方が驚きだったらしい。"

#. Occurrence 1DOT5_4:6547:2002: scene=1DOT5_4
#: 1DOT5_4:6547
msgctxt "text_id=2002 | speaker=unknown"
msgid "  Ignoring Soujyuro's bewilderment, Aoko promptly began issuing orders."
msgstr "　当惑する草十郎をよそに、青子はてきぱきと指示をだす。"

#. Occurrence 1DOT5_4:6574:2003: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0041; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6574
msgctxt "text_id=2003 | speaker=aoko"
msgid "\"Put the ladder on its side."
msgstr "「ハシゴ、横に倒していいわよ。"

#. Occurrence 1DOT5_4:6574:2004: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0041; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6574
msgctxt "text_id=2004 | speaker=aoko"
msgid "  I'll hold the bottom, so you take the top.\""
msgstr "　下の方は私が持つから、貴方は上の方お願い」"

#. Occurrence 1DOT5_4:6586:2005: scene=1DOT5_4
#: 1DOT5_4:6586
msgctxt "text_id=2005 | speaker=unknown"
msgid "  She did all of this so matter-of-factly, that Soujyuro began lowering the ladder before he even had a chance to insist that he could do it by himself."
msgstr "　それがあまりに自然な行為だったので、ひとりで十分だと強がる前に、草十郎はハシゴを横に倒していた。"

#. Occurrence 1DOT5_4:6649:2006: scene=1DOT5_4
#: 1DOT5_4:6649
msgctxt "text_id=2006 | speaker=unknown"
msgid "  With work finished and the sister's thank you gifts in hand, the two put the church behind them."
msgstr "　アルバイトが終わり、シスターから気持ち程度の謝礼を受け取って、ふたりは教会を後にした。"

#. Occurrence 1DOT5_4:6654:2007: scene=1DOT5_4
#: 1DOT5_4:6654
msgctxt "text_id=2007 | speaker=unknown"
msgid "  Since Aoko apparently had something to do around the station, they decided they would walk together until they got there."
msgstr "　青子は駅前に用事があるとの事で、とりあえずそこまでは同じ道行きだ。"

#. Occurrence 1DOT5_4:6688:2008: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0042; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6688
msgctxt "text_id=2008 | speaker=aoko"
msgid "\"You're a really hard worker.\""
msgstr "「でも、ほんとにアルバイト慣れしてるのね」"

#. Occurrence 1DOT5_4:6694:2009: scene=1DOT5_4
#: 1DOT5_4:6694
msgctxt "text_id=2009 | speaker=unknown"
msgid "  Beneath the orange-tinged sky."
msgstr "　じき夕暮れになる空の下。"

#. Occurrence 1DOT5_4:6699:2010: scene=1DOT5_4
#: 1DOT5_4:6699
msgctxt "text_id=2010 | speaker=unknown"
msgid "  Aoko spoke more as though she was expressing her thoughts out loud than striking up a conversation."
msgstr "　話しかけるというよりは感想をもらすように、青子はそんな台詞を口にした。"

#. Occurrence 1DOT5_4:6725:2011: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0044; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6725
msgctxt "text_id=2011 | speaker=soujuurou"
msgid "\"Really? Coming from you, Aozaki, that's really nice to hear.\""
msgstr "「そうか。蒼崎から見てそうなら、少しは嬉しいな」"

#. Occurrence 1DOT5_4:6731:2012: scene=1DOT5_4
#: 1DOT5_4:6731
msgctxt "text_id=2012 | speaker=unknown"
msgid "  Soujyuro gave her an earnest smile."
msgstr "　素直に微笑む草十郎。"

#. Occurrence 1DOT5_4:6736:2013: scene=1DOT5_4
#: 1DOT5_4:6736
msgctxt "text_id=2013 | speaker=unknown"
msgid "  But then again, he had been beaming ever since he received his pay, so the source of his joy was not so clear."
msgstr "　もっとも、給金をもらってから彼はずっとホクホク顔だったので、何に喜んでいるかは不明だった。"

#. Occurrence 1DOT5_4:6776:2014: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0043; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6776
msgctxt "text_id=2014 | speaker=aoko"
msgid "\"Not so fast. You've still got a ways to go, buster, so don't get too carried away. You're only just breaking even, if that.\""
msgstr "「あ、あのね。貴方は普段が問題ばっかりなんだから、あんまり調子に乗らないように。差し引きゼロっていうか、まだまだマイナスなんだから」"

#. Occurrence 1DOT5_4:6782:2015: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0045; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6782
msgctxt "text_id=2015 | speaker=soujuurou"
msgid "\"You're not going to get on my back about school, are you? That'll really spoil my mood.\""
msgstr "「む。学校の事は、言われると悲しくなる」"

#. Occurrence 1DOT5_4:6816:2016: scene=1DOT5_4
#: 1DOT5_4:6816
msgctxt "text_id=2016 | speaker=unknown"
msgid "  Soujyuro hung his head dejectedly."
msgstr "　草十郎はがっくりとうなだれた。"

#. Occurrence 1DOT5_4:6821:2017: scene=1DOT5_4
#: 1DOT5_4:6821
msgctxt "text_id=2017 | speaker=unknown"
msgid "  Even if his job had been going well, school was still a bust. Exams were one thing, but even classwork was something he had found himself falling behind in."
msgstr "　アルバイトはこなせても、学校の授業ばかりはどうにもならない。試験はともかく、日々の授業は一朝一夕でついて行けるものではないからだ。"

#. Occurrence 1DOT5_4:6847:2018: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0046; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6847
msgctxt "text_id=2018 | speaker=soujuurou"
msgid "\"Why do you hate people with bad grades, Aozaki?\""
msgstr "「蒼崎は成績悪いヤツは嫌いか？」"

#. Occurrence 1DOT5_4:6865:2019: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0044; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6865
msgctxt "text_id=2019 | speaker=aoko"
msgid "\"Well, dealing with lame-brains is certainly tiring, but that's beside the point in your case. And don't let this get to your head. We're not friends, okay?"
msgstr "「……。まあ、頭というか巡りの悪い人との話は、疲れるでしょうね。でも貴方はそれ以前だし、そもそも私にはこれっぽっちも関係ないし。"

#. Occurrence 1DOT5_4:6876:2020: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0045; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6876
msgctxt "text_id=2020 | speaker=aoko"
msgid "  It's the teachers' job to figure out how to help students overcome handicaps, and it's your job to follow through on that help. Having a job is fine with me, but make sure you study properly when you get home.\""
msgstr "　でっかいハンデをなんとかするのは先生たちの仕事で、それに応えるのは貴方の役目。アルバイトもいいけど、帰ったらきちんと予習、やっときなさいよ」"

#. Occurrence 1DOT5_4:6913:2021: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0047; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6913
msgctxt "text_id=2021 | speaker=soujuurou"
msgid "\"You can count on me. Everyone at the school is good people.\""
msgstr "「それはもちろん。学校の人たちはみんないい人だ」"

#. Occurrence 1DOT5_4:6919:2022: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0046; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6919
msgctxt "text_id=2022 | speaker=aoko"
msgid "\"Fine, if you say so-wait. Did you just say 'everyone is good people'?\""
msgstr "「そ。ならいいけど―――みんないい人？」"

#. Occurrence 1DOT5_4:6925:2023: scene=1DOT5_4
#: 1DOT5_4:6925
msgctxt "text_id=2023 | speaker=unknown"
msgid "  Aoko cocked her head to one side, unsure how this exchange had resulted in that response."
msgstr "　今のやりとりで、なんでそんな台詞が返ってくるのか、と首をかしげる青子だった。"

#. Occurrence 1DOT5_4:6930:2024: scene=1DOT5_4
#: 1DOT5_4:6930
msgctxt "text_id=2024 | speaker=unknown"
msgid "  She decided to interpret it as Soujyuro simply expressing his gratitude in his own peculiar way."
msgstr "　おそらく、草十郎なりの感謝の表れなんだろう、と納得する。"

#. Occurrence 1DOT5_4:6967:2025: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0047; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6967
msgctxt "text_id=2025 | speaker=aoko"
msgid "\"...Oh, one more thing."
msgstr "「―――ところで。"

#. Occurrence 1DOT5_4:6974:2026: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0048; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6974
msgctxt "text_id=2026 | speaker=aoko"
msgid "I need to know what other kinds of jobs you're working, you know, in case it comes up.\""
msgstr "参考までに訊くんだけど、貴方、他にどんなバイトしてるの？」"

#. Occurrence 1DOT5_4:6985:2027: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0048; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6985
msgctxt "text_id=2027 | speaker=soujuurou"
msgid "\"If you're asking where, I work at a lot of places in the shopping district. The fish shop, the flower shop, and so on. Oh, but yesterday I went over to the next town. I worked a shift at the amusement park.\""
msgstr "「どこって、商店街が多い。魚のお店とか、花の店とか。ああ、でも昨日は隣町まで遠出したな。遊園地のアルバイト」"

#. Occurrence 1DOT5_4:7019:2028: scene=1DOT5_4
#: 1DOT5_4:7019
msgctxt "text_id=2028 | speaker=unknown"
msgid "  Since the only school-authorized locations were in the Misaki shopping district, his response was much as she expected."
msgstr "　学校側が認可しているのは三咲町の商店街だけなので、予想通りの回答だった。"

#. Occurrence 1DOT5_4:7024:2029: scene=1DOT5_4
#: 1DOT5_4:7024
msgctxt "text_id=2029 | speaker=unknown"
msgid "  That is, except for the decidedly unexpected last part."
msgstr "　最後に出た、およそ静希草十郎とは無関係の単語以外は。"

#. Occurrence 1DOT5_4:7062:2030: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0049; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7062
msgctxt "text_id=2030 | speaker=aoko"
msgid "\"When you say amusement park... you don't mean the one in Yashirogi, do you?!\""
msgstr "「遊園地って、<社木|やしろぎ>の!?」"

#. Occurrence 1DOT5_4:7068:2031: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0049; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:7068
msgctxt "text_id=2031 | speaker=soujuurou"
msgid "\"That's the one. I disassembled and moved unused signs and curios and stuff. It was exhausting.\""
msgstr "「そう。使わなくなった看板とかオブジェとか、解体して運び出したんだ。さすがに疲れたな、あれは」"

#. Occurrence 1DOT5_4:7080:2032: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0050; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7080
msgctxt "text_id=2032 | speaker=aoko"
msgid "\"That so... Yeah, I can imagine it took a lot out of you.\""
msgstr "「へえー……うん、それは体力勝負でしょうね」"

#. Occurrence 1DOT5_4:7100:2033: scene=1DOT5_4
#: 1DOT5_4:7100
msgctxt "text_id=2033 | speaker=unknown"
msgid "  This left Aoko rather impressed."
msgstr "　今度こそ本気で感心する青子。"

#. Occurrence 1DOT5_4:7105:2034: scene=1DOT5_4
#: 1DOT5_4:7105
msgctxt "text_id=2034 | speaker=unknown"
msgid "  Transporting unused amusement park machinery was not a job that students did willingly in their free time."
msgstr "　遊園地で使われる機械の運搬は、ちょっと、学生が片手間でやる仕事ではないからだ。"

#. Occurrence 1DOT5_4:7140:2035: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0051; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7140
msgctxt "text_id=2035 | speaker=aoko"
msgid "\"I'm a bit jealous. I've never even been to Kitsy Land, even though it's so close to here.\""
msgstr "「でもいいなあ。私、キッツィーランドって一度も行った事ないの。三咲町に住んでるのに」"

#. Occurrence 1DOT5_4:7189:2036: scene=1DOT5_4
#: 1DOT5_4:7189
msgctxt "text_id=2036 | speaker=unknown"
msgid "  Aoko looked up in the direction of the neighboring town."
msgstr "　青子は隣町の方角を仰ぎ見る。"

#. Occurrence 1DOT5_4:7194:2037: scene=1DOT5_4
#: 1DOT5_4:7194
msgctxt "text_id=2037 | speaker=unknown"
msgid "  From here you could just barely make out the Ferris wheel."
msgstr "　ここから見えるのは、かろうじて観覧車だけ。"

#. Occurrence 1DOT5_4:7199:2038: scene=1DOT5_4
#: 1DOT5_4:7199
msgctxt "text_id=2038 | speaker=unknown"
msgid "  The round, steel frame of the wheel, illuminated by the sunset as it was, was reminiscent of an old gravestone."
msgstr "　夕日に照らされた円形の鉄骨仕掛けは、<寂|さび>れた<墓標|ぼひょう>を思わせる。"

#. Occurrence 1DOT5_4:7246:2039: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0050; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:7246
msgctxt "text_id=2039 | speaker=soujuurou"
msgid "\"...That's a shame. Is it because you're short on cash?\""
msgstr "「……そうか。それは、金銭的な理由で？」"

#. Occurrence 1DOT5_4:7271:2040: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0052; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7271
msgctxt "text_id=2040 | speaker=aoko"
msgid "\"Pft―\""
msgstr "「っ―――」"

#. Occurrence 1DOT5_4:7277:2041: scene=1DOT5_4
#: 1DOT5_4:7277
msgctxt "text_id=2041 | speaker=unknown"
msgid "  Aoko had to stifle her laughter."
msgstr "　途端、青子はおかしそうに口をおさえた。"

#. Occurrence 1DOT5_4:7282:2042: scene=1DOT5_4
#: 1DOT5_4:7282
msgctxt "text_id=2042 | speaker=unknown"
msgid "  She knew it would be rude to Soujyuro to burst out laughing, but the remark tickled her funny bone."
msgstr "　草十郎に失礼だと思ったものの、笑いのツボに入ってしまったらしい。"

#. Occurrence 1DOT5_4:7308:2043: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0053; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7308
msgctxt "text_id=2043 | speaker=aoko"
msgid "\"No, it's not like that."
msgstr "「ううん、そういうんじゃなくて。"

#. Occurrence 1DOT5_4:7314:2044: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0054; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7314
msgctxt "text_id=2044 | speaker=aoko"
msgid "  It's simple, really. Even back when it first opened, it was always packed with people, and I just never had the time to go. If it were a problem that could be solved with money, I would go right now.\""
msgstr "　単純に、あれが開園してから立てこんでて、遊びにいく暇がなかっただけよ。お金で解決する問題だったら、それこそ今すぐに行ってるわ」"

#. Occurrence 1DOT5_4:7334:2045: scene=1DOT5_4
#: 1DOT5_4:7334
msgctxt "text_id=2045 | speaker=unknown"
msgid "  Aoko showed Soujyuro the envelope that contained the pay from the church."
msgstr "　ほら、と青子は教会のアルバイト代の入った封筒を見せた。"

#. Occurrence 1DOT5_4:7339:2046: scene=1DOT5_4
#: 1DOT5_4:7339
msgctxt "text_id=2046 | speaker=unknown"
msgid "  There was nothing sinister about her remark and gesture, but the fact that she did not jump at the chance to go made Soujyuro sad."
msgstr "　その仕草は明るいものだったが、それでも“行く”と口にしない青子に、草十郎はむっと顔を曇らせる。"

#. Occurrence 1DOT5_4:7374:2047: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0051; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:7374
msgctxt "text_id=2047 | speaker=soujuurou"
msgid "\"Then why don't we go sometime?\""
msgstr "「それなら、今度行けばいいじゃないか」"

#. Occurrence 1DOT5_4:7391:2048: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0055; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7391
msgctxt "text_id=2048 | speaker=aoko"
msgid "\"Thanks, but no can do."
msgstr "「ありがと。けどそれは無理な話。"

#. Occurrence 1DOT5_4:7398:2049: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0056; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7398
msgctxt "text_id=2049 | speaker=aoko"
msgid "You probably didn't catch on because you are who you are, but the place went out of business."
msgstr "アンタの事だから気づいていないと思うけど、アレ、つぶれてるのよ。"

#. Occurrence 1DOT5_4:7405:2050: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0057; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7405
msgctxt "text_id=2050 | speaker=aoko"
msgid "I think it's been about two years since the park closed down.\""
msgstr "廃園になってからもう二年以上は経つんじゃない？」"

#. Occurrence 1DOT5_4:7416:2051: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0052; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:7416
msgctxt "text_id=2051 | speaker=soujuurou"
msgid "\"What...?\""
msgstr "「―――なんと」"

#. Occurrence 1DOT5_4:7450:2052: scene=1DOT5_4
#: 1DOT5_4:7450
msgctxt "text_id=2052 | speaker=unknown"
msgid "  It was no wonder there were no customers all the time he was there."
msgstr "　どうりで客がいなかった、と草十郎は納得する。"

#. Occurrence 1DOT5_4:7455:2053: scene=1DOT5_4
#: 1DOT5_4:7455
msgctxt "text_id=2053 | speaker=unknown"
msgid "  Exasperated as she was at Soujyuro, the student council president seemed to be enjoying herself."
msgstr "　生徒会長は呆れながらも少しだけ楽しそうだ。"

#. Occurrence 1DOT5_4:7460:2054: scene=1DOT5_4
#: 1DOT5_4:7460
msgctxt "text_id=2054 | speaker=unknown"
msgid "  At this point, she would be yelling things at Soujyuro like, \"I can't believe you didn't know that!\" But this evening―this one and only evening―she found it charming."
msgstr "　いつもなら“そんな事まで教えないと分からないとは！”と呆れていた彼女だが、この夕暮れにかぎっては、なんだか微笑ましく見えたらしい。"

#. Occurrence 1DOT5_4:7520:2055: scene=1DOT5_4
#: 1DOT5_4:7520
msgctxt "text_id=2055 | speaker=unknown"
msgid "  They parted ways, and Soujyuro returned home to his apartment, immersed himself in his studies, and before he knew it was time to go to work."
msgstr "　蒼崎青子と別れ、アパートに帰って学校の予習に埋没していると、あっという間にアルバイトの時間になった。"

#. Occurrence 1DOT5_4:7525:2056: scene=1DOT5_4
#: 1DOT5_4:7525
msgctxt "text_id=2056 | speaker=unknown"
msgid "  The major cultural difference―though certainly not the only point of difference―between city and country was the use of time."
msgstr "　山と都会の違いはそれこそ数えきれないが、もっとも大きな点は時間の用途だ。"

#. Occurrence 1DOT5_4:7530:2057: scene=1DOT5_4
#: 1DOT5_4:7530
msgctxt "text_id=2057 | speaker=unknown"
msgid "  It did not matter what part of the city he was in, time flowed far too quickly here."
msgstr "　此処ではともかく、時の流れが早すぎる。"

#. Occurrence 1DOT5_4:7535:2058: scene=1DOT5_4
#: 1DOT5_4:7535
msgctxt "text_id=2058 | speaker=unknown"
msgid "  Failing to squeeze even a drop of knowledge from his textbooks, he put them away for the day before heading into town."
msgstr "　ちっとも頭に入らなかった参考書を片づけて、草十郎は一日の締めとばかりに夜の町に出かけていった。"

#. Occurrence 1DOT5_4:7581:2059: scene=1DOT5_4
#: 1DOT5_4:7581
msgctxt "text_id=2059 | speaker=unknown"
msgid "  The night grew deeper as today turned into tomorrow."
msgstr "　日付変更線を越えて、夜はますます深く眠りについていく。"

#. Occurrence 1DOT5_4:7586:2060: scene=1DOT5_4
#: 1DOT5_4:7586
msgctxt "text_id=2060 | speaker=unknown"
msgid "  Soujyuro reversed his collar to protect his neck from the bitter cold and began to make his way back home."
msgstr "　<襟|えり>をたてて、冷えこんだ冬の空気から首筋を守りながら、草十郎は帰路につく。"

#. Occurrence 1DOT5_4:7591:2061: scene=1DOT5_4
#: 1DOT5_4:7591
msgctxt "text_id=2061 | speaker=unknown"
msgid "  Not a soul to be seen. No dogs scrounging for food, no late-night shoppers."
msgstr "　周囲には<食べ物|ひろいもの>目当ての犬もいないし、ちょっとした買い物で出歩いている人もいない。"

#. Occurrence 1DOT5_4:7596:2062: scene=1DOT5_4
#: 1DOT5_4:7596
msgctxt "text_id=2062 | speaker=unknown"
msgid "  Why would there be; the solitary convenience store in the area closed at eleven o'clock."
msgstr "　この近くに一店だけのコンビニエンスストアも夜の十一時に閉まってしまう以上、買い物目的で外出する住民はいないのだろう。"

#. Occurrence 1DOT5_4:7621:2063: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0053; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:7621
msgctxt "text_id=2063 | speaker=soujuurou"
msgid "\"...Hah.\""
msgstr "「―――ふう」"

#. Occurrence 1DOT5_4:7627:2064: scene=1DOT5_4
#: 1DOT5_4:7627
msgctxt "text_id=2064 | speaker=unknown"
msgid "  He mustered what little energy he had to take in an especially deep breath."
msgstr "　脱力して、ひときわ深く呼吸をする。"

#. Occurrence 1DOT5_4:7632:2065: scene=1DOT5_4
#: 1DOT5_4:7632
msgctxt "text_id=2065 | speaker=unknown"
msgid "  Man-made landmarks lined the deserted street."
msgstr "　人気のない、人工物によって築かれた町並み。"

#. Occurrence 1DOT5_4:7637:2066: scene=1DOT5_4
#: 1DOT5_4:7637
msgctxt "text_id=2066 | speaker=unknown"
msgid "  Garish blue fluorescent light, brighter than the stars above, illuminated the darkness."
msgstr "　星明かりより眩しい、青い蛍光灯に照らされた暗がり。"

#. Occurrence 1DOT5_4:7642:2067: scene=1DOT5_4
#: 1DOT5_4:7642
msgctxt "text_id=2067 | speaker=unknown"
msgid "  An unconscious sense of anxiety stirred within him."
msgstr "　そういったものが、意識せずとも草十郎の不安をあおり立てる。"

#. Occurrence 1DOT5_4:7699:2068: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0054; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:7699
msgctxt "text_id=2068 | speaker=soujuurou"
msgid "\"...Get yourself together. It's normal for the night to be scary.\""
msgstr "「……情けない。夜が怖いのは当たり前じゃないか」"

#. Occurrence 1DOT5_4:7705:2069: scene=1DOT5_4
#: 1DOT5_4:7705
msgctxt "text_id=2069 | speaker=unknown"
msgid "  A chill crept up his spine as he attempted to mask his weakness with words."
msgstr "　ぶるっとくる寒気に背を丸めながら、強がりを口にする。"

#. Occurrence 1DOT5_4:7710:2070: scene=1DOT5_4
#: 1DOT5_4:7710
msgctxt "text_id=2070 | speaker=unknown"
msgid "\"Stay out of the dark.\""
msgstr "“暗がりに近づくな”"

#. Occurrence 1DOT5_4:7715:2071: scene=1DOT5_4
#: 1DOT5_4:7715
msgctxt "text_id=2071 | speaker=unknown"
msgid "\"Stay away from deserted places.\""
msgstr "“人気のないところには立ち入るな”"

#. Occurrence 1DOT5_4:7720:2072: scene=1DOT5_4
#: 1DOT5_4:7720
msgctxt "text_id=2072 | speaker=unknown"
msgid "  Whether it was for some deeper reason, or perhaps the fact that he looked so helpless..."
msgstr "　何の因果か、それとも、それだけ情けない顔をしていたのか。"

#. Occurrence 1DOT5_4:7726:2073: scene=1DOT5_4
#: 1DOT5_4:7726
msgctxt "text_id=2073 | speaker=unknown"
msgid "Everybody he had met in his life seemed to warn him with those words."
msgstr "草十郎がこれまで知り合ってきた人たちは、決まってそんな忠告をした。"

#. Occurrence 1DOT5_4:7765:2074: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0055; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:7765
msgctxt "text_id=2074 | speaker=soujuurou"
msgid "\"Did knowing that ever help anyone?\""
msgstr "「そうは言ってもしょうがないし、だいたい」"

#. Occurrence 1DOT5_4:7790:2075: scene=1DOT5_4
#: 1DOT5_4:7790
msgctxt "text_id=2075 | speaker=unknown"
msgid "  What did that even mean, \"Stay out of the dark\"?"
msgstr "　暗がりに近づくな、なんて言われても実感が湧かない。"

#. Occurrence 1DOT5_4:7795:2076: scene=1DOT5_4
#: 1DOT5_4:7795
msgctxt "text_id=2076 | speaker=unknown"
msgid "  Nowhere in the city was without light."
msgstr "　<都|こ><会|こ>には明かりのない場所はない。"

#. Occurrence 1DOT5_4:7800:2077: scene=1DOT5_4
#: 1DOT5_4:7800
msgctxt "text_id=2077 | speaker=unknown"
msgid "  Everywhere, from the bustling train station to the remote residential areas, was illuminated by artificial light, not least the main roads."
msgstr "　大通りは言うに及ばず、駅前の喧噪から離れた住宅地にだって電灯の明かりがある。"

#. Occurrence 1DOT5_4:7820:2078: scene=1DOT5_4
#: 1DOT5_4:7820
msgctxt "text_id=2078 | speaker=unknown"
msgid "  Scary was scary, but this kind of fear was of a different sort than what he'd felt in the mountains."
msgstr "　怖いのは怖いが、怖さの質が山とは違う。"

#. Occurrence 1DOT5_4:7826:2079: scene=1DOT5_4
#: 1DOT5_4:7826
msgctxt "text_id=2079 | speaker=unknown"
msgid "  The most likely source of his fear was the fact that this place was governed by starkly different rules."
msgstr "　おそらくは根本になるルールが違うのだ。"

#. Occurrence 1DOT5_4:7831:2080: scene=1DOT5_4
#: 1DOT5_4:7831
msgctxt "text_id=2080 | speaker=unknown"
msgid "  The way in which the city meted out justice was terribly imbalanced."
msgstr "　因果応報の仕組みが一方にのみ優しく作られている。"

#. Occurrence 1DOT5_4:7836:2081: scene=1DOT5_4
#: 1DOT5_4:7836
msgctxt "text_id=2081 | speaker=unknown"
msgid "  And to the provincial Soujyuro, his lack of familiarity with the laws of the land terrified him far more than the dark."
msgstr "　怖いと言えば、そのルールがまだよく分からない事の方が、田舎育ちの彼には怖い。"

#. Occurrence 1DOT5_4:7860:2082: scene=1DOT5_4
#: 1DOT5_4:7860
msgctxt "text_id=2082 | speaker=unknown"
msgid "  In the mountains, retribution came swiftly to those who broke the rules."
msgstr "　山では、ルールを破った者は<そ|・><の|・><時|・><点|・>で報いを受ける。"

#. Occurrence 1DOT5_4:7865:2083: scene=1DOT5_4
#: 1DOT5_4:7865
msgctxt "text_id=2083 | speaker=unknown"
msgid "  Take a game trail, for example."
msgstr "　例えば<獣道|けものみち>。"

#. Occurrence 1DOT5_4:7871:2084: scene=1DOT5_4
#: 1DOT5_4:7871
msgctxt "text_id=2084 | speaker=unknown"
msgid "Those who unwittingly trespassed on the animal kingdom's domain would, as a matter of course, be savaged by the native wildlife."
msgstr "彼らの縄張りと気付かずに入ってしまえば、当然、住人である動物に襲われて怪我を負う。"

#. Occurrence 1DOT5_4:7876:2085: scene=1DOT5_4
#: 1DOT5_4:7876
msgctxt "text_id=2085 | speaker=unknown"
msgid "  Accordingly, in Soujyuro's mind, an offender paid the price for one's mistakes immediately."
msgstr "　このように、草十郎にとって過ちとはすぐさま返ってくるものだった。"

#. Occurrence 1DOT5_4:7881:2086: scene=1DOT5_4
#: 1DOT5_4:7881
msgctxt "text_id=2086 | speaker=unknown"
msgid "  It was not a matter of who punished whom; it was simply that the one who broke the rules would meet instant, tangible retribution."
msgstr "　誰が誰を罰するというのではなく、ルールを破れば即、その間違いがカタチになって降りかかると。"

#. Occurrence 1DOT5_4:7915:2087: scene=1DOT5_4
#: 1DOT5_4:7915
msgctxt "text_id=2087 | speaker=unknown"
msgid "  He felt that, in this regard, the laws of the city were far too ambiguous."
msgstr "　都会はそのあたりが少しだけ曖昧だと思う。"

#. Occurrence 1DOT5_4:7920:2088: scene=1DOT5_4
#: 1DOT5_4:7920
msgctxt "text_id=2088 | speaker=unknown"
msgid "  One could meet their demise without ever knowing whether one was in the right or wrong."
msgstr "　だから、一体なにが正しかったのか、なにが間違っていたのか、致命的な<結末|おわり>になるまで分からない。"

#. Occurrence 1DOT5_4:7941:2089: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0056; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:7941
msgctxt "text_id=2089 | speaker=soujuurou"
msgid "\"Though, I guess it's probably not that different when it comes down to it.\""
msgstr "「……けど、基本的には変わらないんだよな、たぶん」"

#. Occurrence 1DOT5_4:7947:2090: scene=1DOT5_4
#: 1DOT5_4:7947
msgctxt "text_id=2090 | speaker=unknown"
msgid "  To put it simply, retribution was delayed."
msgstr "　単純に因果応報の効果が遅いだけ。"

#. Occurrence 1DOT5_4:7952:2091: scene=1DOT5_4
#: 1DOT5_4:7952
msgctxt "text_id=2091 | speaker=unknown"
msgid "  To take the analogy a step further, back home in his village, no one individual had been given the responsibility of maintaining order."
msgstr "　さらに喩えるなら、彼の田舎には村の治安維持を任された人間はいなかった。"

#. Occurrence 1DOT5_4:7985:2092: scene=1DOT5_4
#: 1DOT5_4:7985
msgctxt "text_id=2092 | speaker=unknown"
msgid "  In the city, however, someone was put in charge of punishing law-breakers on behalf of the kindhearted citizens who lived there."
msgstr "　都会は人間に優しいかわりに、ルールを破った人間を罰する何者かが<据|す>えられている。"

#. Occurrence 1DOT5_4:7990:2093: scene=1DOT5_4
#: 1DOT5_4:7990
msgctxt "text_id=2093 | speaker=unknown"
msgid "  While crime and punishment in the mountains were synonymous, in the city the two were separated, and an unrelated person brought judgment after the crime had been committed."
msgstr "　山では罪と罰は同義だったが、街ではその二つは切り離され、罪をおかした後に、罰を持ってくる他人がいるらしい。"

#. Occurrence 1DOT5_4:8010:2094: scene=1DOT5_4
#: 1DOT5_4:8010
msgctxt "text_id=2094 | speaker=unknown"
msgid "  Entering places that must not be entered..."
msgstr "　入ってはいけない場所。"

#. Occurrence 1DOT5_4:8015:2095: scene=1DOT5_4
#: 1DOT5_4:8015
msgctxt "text_id=2095 | speaker=unknown"
msgid "  Seeing things that must not be seen..."
msgstr "　見てはいけない出来事。"

#. Occurrence 1DOT5_4:8020:2096: scene=1DOT5_4
#: 1DOT5_4:8020
msgctxt "text_id=2096 | speaker=unknown"
msgid "  Breaking a law had consequences; someone would come to exact justice for the law that was broken."
msgstr "　そういったルールを破った時、何者かが罰しに来るのが社会のルールなのだ。"

#. Occurrence 1DOT5_4:8050:2097: scene=1DOT5_4
#: 1DOT5_4:8050
msgctxt "text_id=2097 | speaker=unknown"
msgid "  The result of all this was that the safest way to survive the city was not to stick your nose in the affairs of others."
msgstr "　なので―――町で安全に暮らす方法というのは、余人の事情に立ち入らないこと。"

#. Occurrence 1DOT5_4:8056:2098: scene=1DOT5_4
#: 1DOT5_4:8056
msgctxt "text_id=2098 | speaker=unknown"
msgid "  When the people who cared about Soujyuro told him to \"stay away,\" they probably meant, \"if you don't, nobody will be able to help you.\""
msgstr "　草十郎を気遣ってくれた人たちが口を揃えて“近づくな”と言っていたのは、“そうなったら誰も助けてあげられない”からなのだろう。"

#. Occurrence 1DOT5_4:8077:2099: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0057; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:8077
msgctxt "text_id=2099 | speaker=soujuurou"
msgid "\"Oh crap, I almost took another shortcut.\""
msgstr "「……っと。いけない、また近道しそうになった」"

#. Occurrence 1DOT5_4:8097:2100: scene=1DOT5_4
#: 1DOT5_4:8097
msgctxt "text_id=2100 | speaker=unknown"
msgid "  No matter how much of a nuisance these obstacles were, one could not just climb over a neighbor's fence, even when one's apartment was just the other side."
msgstr "　なので、いくら邪魔だからといって人の家の塀をよじのぼって、すぐ向こうのアパートを目指してはいけないのである。"

#. Occurrence 1DOT5_4:8102:2101: scene=1DOT5_4
#: 1DOT5_4:8102
msgctxt "text_id=2101 | speaker=unknown"
msgid "  If the people inside happened to be awake and call the police, nobody would lift a hand to help him."
msgstr "　たまたま家の人が起きていたら警察に通報されて、誰にも助けてもらえなくなってしまう。"

#. Occurrence 1DOT5_4:8144:2102: scene=1DOT5_4
#: 1DOT5_4:8144
msgctxt "text_id=2102 | speaker=unknown"
msgid "  With his misguided view of the city, Soujyuro once again ended his day in peace."
msgstr "　そんな見当違いの都市観を持ったまま、今日も静希草十郎の一日は平穏に終わっていく。"

#. Occurrence 1DOT5_4:8180:2103: scene=1DOT5_4
#: 1DOT5_4:8180
msgctxt "text_id=2103 | speaker=unknown"
msgid "  Unable to fall asleep right away, he gazed out his window upon the night sky from the floor of his apartment."
msgstr "　すぐには寝つけず、床についたまま窓越しの空を眺める。"

#. Occurrence 1DOT5_4:8185:2104: scene=1DOT5_4
#: 1DOT5_4:8185
msgctxt "text_id=2104 | speaker=unknown"
msgid "  The cityscape had caused him to tremble in fear when he first moved here."
msgstr "　都会にきた彼が最初に戦慄した<風景|もの>。"

#. Occurrence 1DOT5_4:8190:2105: scene=1DOT5_4
#: 1DOT5_4:8190
msgctxt "text_id=2105 | speaker=unknown"
msgid "  The convenience of solving almost any problem with the flip of a switch..."
msgstr "　スイッチひとつでたいていの事は解決される便利さも、"

#. Occurrence 1DOT5_4:8195:2106: scene=1DOT5_4
#: 1DOT5_4:8195
msgctxt "text_id=2106 | speaker=unknown"
msgid "  The novelty of living a wall away from a complete stranger..."
msgstr "　壁一枚隣りに顔しか知らない他人が住んでいる新鮮さも、"

#. Occurrence 1DOT5_4:8200:2107: scene=1DOT5_4
#: 1DOT5_4:8200
msgctxt "text_id=2107 | speaker=unknown"
msgid "  It all disappeared into the night sky when he looked up."
msgstr "　この夜空を見上げた時に吹き飛んだ。"

#. Occurrence 1DOT5_4:8222:2108: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0058; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:8222
msgctxt "text_id=2108 | speaker=soujuurou"
msgid "\"...Is this really the same sky?\""
msgstr "“……こんな空も、あるのか”"

#. Occurrence 1DOT5_4:8228:2109: scene=1DOT5_4
#: 1DOT5_4:8228
msgctxt "text_id=2109 | speaker=unknown"
msgid "  Unconsciously, he recalled his own words."
msgstr "　意識せず、漠然とこぼれた言葉を覚えている。"

#. Occurrence 1DOT5_4:8248:2110: scene=1DOT5_4
#: 1DOT5_4:8248
msgctxt "text_id=2110 | speaker=unknown"
msgid "  \"What dim stars.\""
msgstr "　なんて暗い星。"

#. Occurrence 1DOT5_4:8253:2111: scene=1DOT5_4
#: 1DOT5_4:8253
msgctxt "text_id=2111 | speaker=unknown"
msgid "  \"What a cramped sky.\""
msgstr "　なんて狭い空。"

#. Occurrence 1DOT5_4:8258:2112: scene=1DOT5_4
#: 1DOT5_4:8258
msgctxt "text_id=2112 | speaker=unknown"
msgid "  Here there were no starry nights."
msgstr "　ここでは星の見える夜はない。"

#. Occurrence 1DOT5_4:8263:2113: scene=1DOT5_4
#: 1DOT5_4:8263
msgctxt "text_id=2113 | speaker=unknown"
msgid "  Could he even survive here?"
msgstr "　自分はここで暮らしていけるのかどうか―――"

#. Occurrence 1DOT5_4:8269:2114: scene=1DOT5_4
#: 1DOT5_4:8269
msgctxt "text_id=2114 | speaker=unknown"
msgid "  The same misgivings since his first night continued to haunt him."
msgstr "　あの夜に抱いた不安は今も変わっていない。"

#. Occurrence 1DOT5_4:8290:2115: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0059; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:8290
msgctxt "text_id=2115 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 1DOT5_4:8309:2116: scene=1DOT5_4
#: 1DOT5_4:8309
msgctxt "text_id=2116 | speaker=unknown"
msgid "  His eyelids fell shut."
msgstr "　<瞼|まぶた>を閉じる。"

#. Occurrence 1DOT5_4:8314:2117: scene=1DOT5_4
#: 1DOT5_4:8314
msgctxt "text_id=2117 | speaker=unknown"
msgid "  Although he was fraught with worry, Soujyuro's body felt the fatigue from his work and studies, and thus, he fell fast asleep."
msgstr "　そんな女々しい悩みとは裏腹に、アルバイトと勉強で疲れた体はあっさり、ぐっすり安眠していった。"

#. Occurrence 2_1:130:2118: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0000; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:130
msgctxt "text_id=2118 | speaker=soujuurou"
msgid "\"The city is really strange,"
msgstr "“都会は魔界だ。"

#. Occurrence 2_1:139:2119: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0001; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:139
msgctxt "text_id=2119 | speaker=soujuurou"
msgid "  but a pretty easy place to live, once you get the hang of it.\""
msgstr "　けど、慣れればわりと住みやすいとは思う”"

#. Occurrence 2_1:198:2120: scene=2_1
#: 2_1:198
msgctxt "text_id=2120 | speaker=unknown"
msgid "  Soujyuro sighed listlessly."
msgstr "　はあ、と力のないため息がこぼれる。"

#. Occurrence 2_1:203:2121: scene=2_1
#: 2_1:203
msgctxt "text_id=2121 | speaker=unknown"
msgid "  He looked down at the winter schoolyard below, lost in thought."
msgstr "　静希草十郎は冬の校庭を見下ろしながら、柄にもなく物思いに<耽|ふけ>っていた。"

#. Occurrence 2_1:233:2122: scene=2_1
#: 2_1:233
msgctxt "text_id=2122 | speaker=unknown"
msgid "  \"December\" was written on the corner of the chalkboard."
msgstr "　黒板の隅には１２月の日付。"

#. Occurrence 2_1:238:2123: scene=2_1
#: 2_1:238
msgctxt "text_id=2123 | speaker=unknown"
msgid "  He could not believe ten days had already passed since he transferred to the school."
msgstr "　早いもので、草十郎が転入してからすでに十日。"

#. Occurrence 2_1:243:2124: scene=2_1
#: 2_1:243
msgctxt "text_id=2124 | speaker=unknown"
msgid "  The last vestiges of autumn had faded with the change of the month."
msgstr "　暦が１２月に移り、辛うじて残っていた秋の面影は見る影もない。"

#. Occurrence 2_1:248:2125: scene=2_1
#: 2_1:248
msgctxt "text_id=2125 | speaker=unknown"
msgid "  The trees were all but barren, and the ground below them a mat of fallen leaves."
msgstr "　校庭の木々はそのほとんどが裸になり、舞い散った落ち葉が地面を覆い隠している。"

#. Occurrence 2_1:289:2126: scene=2_1
#: 2_1:289
msgctxt "text_id=2126 | speaker=unknown"
msgid "  Fourth period was classics."
msgstr "　古典の時間。"

#. Occurrence 2_1:294:2127: scene=2_1
#: 2_1:294
msgctxt "text_id=2127 | speaker=unknown"
msgid "  An elderly teacher stood at the lectern and rambled on."
msgstr "　教壇からは老教師による見解が淡々と流れてくる。"

#. Occurrence 2_1:299:2128: scene=2_1
#: 2_1:299
msgctxt "text_id=2128 | speaker=unknown"
msgid "  While he had finally gotten used to the classroom, he still had a long way to go to get up to speed in his classes."
msgstr "　ようやく馴れてきた教室と、まだまだ追いつけない授業の四時限目。"

#. Occurrence 2_1:304:2129: scene=2_1
#: 2_1:304
msgctxt "text_id=2129 | speaker=unknown"
msgid "  Lacking even the basic understanding most students learn in their early scholastic life, it was a battle for Soujyuro to keep up."
msgstr "　基礎が出来てない草十郎にとって、日々の授業は真剣勝負だ。"

#. Occurrence 2_1:309:2130: scene=2_1
#: 2_1:309
msgctxt "text_id=2130 | speaker=unknown"
msgid "  Even if he was unable to grasp all of the content right away, he at least tried to memorize everything in the hope that he could make use of it down the road."
msgstr "　今は内容を正しく飲みこめなくともきっかり暗記し、後々に生かせるよう心がけている。"

#. Occurrence 2_1:329:2131: scene=2_1
#: 2_1:329
msgctxt "text_id=2131 | speaker=unknown"
msgid "  Which is why losing himself in his thoughts was about the last thing he should have been doing."
msgstr "　なので雑念などもってのほか。"

#. Occurrence 2_1:334:2132: scene=2_1
#: 2_1:334
msgctxt "text_id=2132 | speaker=unknown"
msgid "  He would normally chastise himself for daydreaming, but..."
msgstr "　よそ見をしている暇はない、と厳しく自分に言いつけているのだが、"

#. Occurrence 2_1:374:2133: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0002; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:374
msgctxt "text_id=2133 | speaker=soujuurou"
msgid "\"...Hah.\""
msgstr "「………………はあ」"

#. Occurrence 2_1:379:2134: scene=2_1
#: 2_1:379
msgctxt "text_id=2134 | speaker=unknown"
msgid "  Troublingly, he was unable to concentrate in class today."
msgstr "　困ったコトに、今日はどうしても授業に集中できなかった。"

#. Occurrence 2_1:399:2135: scene=2_1
#: 2_1:399
msgctxt "text_id=2135 | speaker=unknown"
msgid "  Soujyuro could not place the source of his lack of concentration."
msgstr "　集中力の不足はどこからきたものか。"

#. Occurrence 2_1:404:2136: scene=2_1
#: 2_1:404
msgctxt "text_id=2136 | speaker=unknown"
msgid "  It could not have been the winter in the city; it was much milder than in the mountains. Neither was his part-time job particularly tiring."
msgstr "　都市の冬は山に比べれば格段に住みやすいし、毎日のアルバイトだってそう<過酷|ハード>ではない。"

#. Occurrence 2_1:409:2137: scene=2_1
#: 2_1:409
msgctxt "text_id=2137 | speaker=unknown"
msgid "  He was not any more physically fatigued than the average student, so that could not be it either."
msgstr "　肉体的な疲れは、まあ、人並みだろうから理由にはあげられない。"

#. Occurrence 2_1:445:2138: scene=2_1
#: 2_1:445
msgctxt "text_id=2138 | speaker=unknown"
msgid "  Others might conclude that it was because the courses were boring, but that seemed off the mark, too."
msgstr "　では授業そのものが退屈だから、と言われるとそれも違う。"

#. Occurrence 2_1:450:2139: scene=2_1
#: 2_1:450
msgctxt "text_id=2139 | speaker=unknown"
msgid "  Soujyuro did not share his classmates' opinions about their classes."
msgstr "　草十郎はクラスメイトたちが言うほど授業をつまらないものだと感じていない。"

#. Occurrence 2_1:455:2140: scene=2_1
#: 2_1:455
msgctxt "text_id=2140 | speaker=unknown"
msgid "  On the contrary, he rather enjoyed his class time."
msgstr "　良いか悪いかで言えば、間違いなく良い部類に入る時間だ。"

#. Occurrence 2_1:475:2141: scene=2_1
#: 2_1:475
msgctxt "text_id=2141 | speaker=unknown"
msgid "  No, his frame of mind was not to blame either."
msgstr "　なので精神的な面でも理由は見あたらない。"

#. Occurrence 2_1:480:2142: scene=2_1
#: 2_1:480
msgctxt "text_id=2142 | speaker=unknown"
msgid "  Trying to figure out what was wrong only made him more depressed."
msgstr "　ここまで集中力が散漫になるのはどうかと思う、と草十郎は我が身の情けなさに落ちこんでいる。"

#. Occurrence 2_1:527:2143: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0003; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:527
msgctxt "text_id=2143 | speaker=soujuurou"
msgid "(What's wrong with me? It's not like me to be so distracted.)"
msgstr "『……いけない。こんなんじゃ気が散る一方だ』"

#. Occurrence 2_1:553:2144: scene=2_1
#: 2_1:553
msgctxt "text_id=2144 | speaker=unknown"
msgid "  He scolded himself and turned his attention to the chalkboard."
msgstr "　自分を叱って黒板に目を向ける。"

#. Occurrence 2_1:558:2145: scene=2_1
#: 2_1:558
msgctxt "text_id=2145 | speaker=unknown"
msgid "  The rhythmic ticks of the chalk were sending him into a slumber, but he somehow managed to resist their lullaby."
msgstr "　カツカツと規則正しく、なのになぜか眠気を誘う<白墨|チョーク>の滑る音も、この純朴な転入生を<堕落|だらく>させるには至らない。"

#. Occurrence 2_1:607:2146: scene=2_1
#: 2_1:607
msgctxt "text_id=2146 | speaker=unknown"
msgid "  And yet, he was still unable to focus on the class."
msgstr "　けれどやっぱり、彼は授業に集中できなかった。"

#. Occurrence 2_1:613:2147: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0004; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:613
msgctxt "text_id=2147 | speaker=soujuurou"
msgid "(...Ugh.)"
msgstr "『…………むう』"

#. Occurrence 2_1:618:2148: scene=2_1
#: 2_1:618
msgctxt "text_id=2148 | speaker=unknown"
msgid "  Soujyuro reflected silently as was his custom, and sighed inwardly."
msgstr "　重いため息をついて草十郎なりに考える。"

#. Occurrence 2_1:623:2149: scene=2_1
#: 2_1:623
msgctxt "text_id=2149 | speaker=unknown"
msgid "  Deep down he knew the real source of his agitation."
msgstr "　あまり考えたくはないが、原因は、まあ。"

#. Occurrence 2_1:630:2150: scene=2_1
#: 2_1:630
msgctxt "text_id=2150 | speaker=unknown"
msgid "  The events of the previous night were the only thing it could be."
msgstr "　思い返すたびにどうかと思う、昨夜の出来事以外ありえなかった。"

#. Occurrence 2_1:686:2151: scene=2_1
#: 2_1:686
msgctxt "text_id=2151 | speaker=unknown"
msgid "  With the chime to signal the end of class, the teacher bowed and exited into the hallway."
msgstr "　授業の終わりを告げるチャイムと、礼をして廊下に向かう老教師。"

#. Occurrence 2_1:691:2152: scene=2_1
#: 2_1:691
msgctxt "text_id=2152 | speaker=unknown"
msgid "  To see him off, the thirty or so students all stood up from their desks."
msgstr "　彼の退室を見届けて、三十人もの生徒は一斉に席を立った。"

#. Occurrence 2_1:696:2153: scene=2_1
#: 2_1:696
msgctxt "text_id=2153 | speaker=unknown"
msgid "  The clock, which had seemed to slow dramatically around half-past eleven, now struck noon."
msgstr "　11時半ごろから緩慢に進んでいた時計の針は、いまやピッタリと頂点を指し示している。"

#. Occurrence 2_1:744:2154: scene=2_1
#: 2_1:744
msgctxt "text_id=2154 | speaker=unknown"
msgid "  The tension seemed to fade from the room all at once."
msgstr "　ざあ、と<伝播|でんぱ>していく憩いの空気。"

#. Occurrence 2_1:749:2155: scene=2_1
#: 2_1:749
msgctxt "text_id=2155 | speaker=unknown"
msgid "  The release from a difficult lesson"
msgstr "　堅苦しい授業からのひとときの解放、"

#. Occurrence 2_1:754:2156: scene=2_1
#: 2_1:754
msgctxt "text_id=2156 | speaker=unknown"
msgid "  was the start of lunchtime-the highlight of school life."
msgstr "　学園生活の華ともいえる<昼食|ランチタイム>の始まりだ。"

#. Occurrence 2_1:803:2157: scene=2_1
#: 2_1:803
msgctxt "text_id=2157 | speaker=unknown"
msgid "  Misaki High's cafeteria was not particularly known for its quality of food."
msgstr "　三咲高校の学食の味つけはよろしくない。"

#. Occurrence 2_1:808:2158: scene=2_1
#: 2_1:808
msgctxt "text_id=2158 | speaker=unknown"
msgid "  Complaints that the quality was below that of a private school went unheeded,"
msgstr "　私立校にあるまじき怠慢、という抗議もどこ吹く風で、"

#. Occurrence 2_1:813:2159: scene=2_1
#: 2_1:813
msgctxt "text_id=2159 | speaker=unknown"
msgid "  and the same \"unique\" flavors appeared on the menu each and every day."
msgstr "　今日も今日とて独特の味を提供している。"

#. Occurrence 2_1:818:2160: scene=2_1
#: 2_1:818
msgctxt "text_id=2160 | speaker=unknown"
msgid "  Private school prices coupled with subpar quality led the majority of students to opt for boxed lunches instead."
msgstr "　値段もそれなり、味もいまいち、となれば、必然、学校ではお弁当派が大勢力となる。"

#. Occurrence 2_1:852:2161: scene=2_1
#: 2_1:852
msgctxt "text_id=2161 | speaker=unknown"
msgid "  Soujyuro's Class 2-C was no exception."
msgstr "　草十郎が転入した二年Ｃ組も例外ではない。"

#. Occurrence 2_1:857:2162: scene=2_1
#: 2_1:857
msgctxt "text_id=2162 | speaker=unknown"
msgid "  The boys muscled as many as ten desks into what resembled a long dining table."
msgstr "　男子は腕力にまかせて十個ほどの机をあわせ、長テーブルのような食卓を築く。"

#. Occurrence 2_1:862:2163: scene=2_1
#: 2_1:862
msgctxt "text_id=2163 | speaker=unknown"
msgid "  Conversely, the girls divided themselves into smaller tables of two or three desks with practiced ease, and started chatting within their cliques."
msgstr "　一方、女子は洗練された手順で二、三個の机をこぢんまりとしたテーブルにかえ、いくつかのグループにわかれて談笑を始めていた。"

#. Occurrence 2_1:894:2164: scene=2_1
#: 2_1:894
msgctxt "text_id=2164 | speaker=unknown"
msgid "  Not a single student wasted even a second of their precious lunchtime."
msgstr "　貴重な昼休みを一分一秒も無駄にしない。"

#. Occurrence 2_1:899:2165: scene=2_1
#: 2_1:899
msgctxt "text_id=2165 | speaker=unknown"
msgid "  Where both sides differed in method, they shared a common goal."
msgstr "　かたちは違えど、両陣営の信念は同じだった。"

#. Occurrence 2_1:951:2166: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0005; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:951
msgctxt "text_id=2166 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 2_1:956:2167: scene=2_1
#: 2_1:956
msgctxt "text_id=2167 | speaker=unknown"
msgid "  Soujyuro was struck dumb by the efficiency of the transformation."
msgstr "　その手際の良さに草十郎は呆気に取られている。"

#. Occurrence 2_1:961:2168: scene=2_1
#: 2_1:961
msgctxt "text_id=2168 | speaker=unknown"
msgid "  Even after ten days, he was unable to keep pace with the rest of the class and remained seated where he had sat during the previous period."
msgstr "　転入してから十日経った今でもこのスピーディーさについていけず、いまだ自分の席に居座っていた。"

#. Occurrence 2_1:983:2169: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_2_1_0000; voice_prefix=B50; voice_category=6; scene=2_1
#: 2_1:983
msgctxt "text_id=2169 | speaker=kinomi"
msgid "\"Hey, Sizuki! Over here!\""
msgstr "「おーい、こっちこいよ静希！」"

#. Occurrence 2_1:994:2170: scene=2_1
#: 2_1:994
msgctxt "text_id=2170 | speaker=unknown"
msgid "  The voice came from the large makeshift dining table near the window."
msgstr "　呼びかけてくる声は、教室の窓側を占拠した一大食卓からだった。"

#. Occurrence 2_1:1036:2171: scene=2_1
#: 2_1:1036
msgctxt "text_id=2171 | speaker=unknown"
msgid "  Housuke Kinomi was beckoning him over while leaning back in his chair in a way that looked like he could fall backward at any second."
msgstr "　だらしなく椅子をななめに立て、いつスッ<転|ころ>んでもおかしくない状態で手招きしているのは<木|き><乃|の><美|み><芳助|ほうすけ>。"

#. Occurrence 2_1:1041:2172: scene=2_1
#: 2_1:1041
msgctxt "text_id=2172 | speaker=unknown"
msgid "  He was regularly shot down by others in the class for being lazy and crass, but his earnest nature kept him from getting on anyone's bad side."
msgstr "　口が悪くて根性も無い、とクラス中から<酷評|こくひょう>される人物だが、さっぱりした性格のおかげか敵は少ない。"

#. Occurrence 2_1:1046:2173: scene=2_1
#: 2_1:1046
msgctxt "text_id=2173 | speaker=unknown"
msgid "  Though something could be said for not being so forthcoming all the time, too."
msgstr "　たまに、さっぱりしすぎるのもどうか、とみなの頭を悩ませてもいる。"

#. Occurrence 2_1:1082:2174: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_2_1_0001; voice_prefix=B50; voice_category=6; scene=2_1
#: 2_1:1082
msgctxt "text_id=2174 | speaker=kinomi"
msgid "\"Times-a-wastin'! Let's eat!"
msgstr "「メシにしようぜメシぃ。"

#. Occurrence 2_1:1088:2175: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_2_1_0002; voice_prefix=B50; voice_category=6; scene=2_1
#: 2_1:1088
msgctxt "text_id=2175 | speaker=kinomi"
msgid "  I've got a bunch of leftover spring rolls from yesterday, but when my dad saw 'em, he told me I shouldn't waste 'em, so that's the only thing I've got.\""
msgstr "　オレさあ、昨日店の残り物もらいすぎたんだよ。春巻だよ春巻。それを見た親父がさあ、貰ったモンは残すなってうるさくてさあ。食いもん、春巻きしかねーんだわ」"

#. Occurrence 2_1:1113:2176: scene=2_1
#: 2_1:1113
msgctxt "text_id=2176 | speaker=unknown"
msgid "  It seemed his end game was to find someone who might take pity on him and trade him for something better."
msgstr "　なので救いの手を差し向けてくれ、とまっとうな弁当を呼びこもうと企む木乃美だった。"

#. Occurrence 2_1:1118:2177: scene=2_1
#: 2_1:1118
msgctxt "text_id=2177 | speaker=unknown"
msgid "  The two of them worked at the same restaurant, so he was one of the few people Soujyuro knew before starting school."
msgstr "　木乃美と草十郎は同じ店で働いており、転入前から顔見知りだった数少ないアルバイト仲間だ。"

#. Occurrence 2_1:1123:2178: scene=2_1
#: 2_1:1123
msgctxt "text_id=2178 | speaker=unknown"
msgid "  He was also the reason Soujyuro was able to learn the true meaning of the phrase \"can't live with them, can't live without them.\""
msgstr "　また、草十郎に『腐れ縁』という言葉をはじめて実感させた男でもある。"

#. Occurrence 2_1:1164:2179: voice_id=E20_2_1_0000; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1164
msgctxt "text_id=2179 | speaker=unknown"
msgid "\"Yeah, Sizuki! Get your butt over here! It's the long-awaited Canned Food Festival today!\""
msgstr "「お、いいな、静希も来いよー！　今日は待ちに待った缶詰祭りをすっからさー！」"

#. Occurrence 2_1:1170:2180: voice_id=E30_2_1_0000; voice_prefix=E30; voice_category=0; scene=2_1
#: 2_1:1170
msgctxt "text_id=2180 | speaker=unknown"
msgid "\"So we're really going through with this? We're absolutely sure we wanna do this?\""
msgstr "「……ついに決行するのかよ……誰か冷静になった方がいいんじゃないのか、実際……」"

#. Occurrence 2_1:1176:2181: voice_id=E20_2_1_9000; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1176
msgctxt "text_id=2181 | speaker=unknown"
msgid "\"You bet your ass we are! Sure, the stuff is processed to hell, but all the canned crab you can eat?! This ain't no sardines in a can, dude!\""
msgstr "「バカ、すげえ楽しいってきっと！　そりゃパチもんくさいけどカニ缶とか食い放題なんだぜ!?　サバ缶じゃなくて！」"

#. Occurrence 2_1:1224:2182: voice_id=E40_2_1_9000; voice_prefix=E40; voice_category=0; scene=2_1
#: 2_1:1224
msgctxt "text_id=2182 | speaker=unknown"
msgid "\"You for real?! Then hell yeah! Count me in!"
msgstr "「まじ！？　やったー、オレも参加するー！"

#. Occurrence 2_1:1224:2183: voice_id=E40_2_1_9000; voice_prefix=E40; voice_category=0; scene=2_1
#: 2_1:1224
msgctxt "text_id=2183 | speaker=unknown"
msgid "  Is there enough corned beef for everyone? Or is it first come, first served?\""
msgstr "　コンビーフはひとり一個？　それとも早い者勝ち？」"

#. Occurrence 2_1:1238:2184: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_2_1_0003; voice_prefix=B50; voice_category=6; scene=2_1
#: 2_1:1238
msgctxt "text_id=2184 | speaker=kinomi"
msgid "\"That's not somethin' you can eat a ton of, ya know. Only the first can tastes any good.\""
msgstr "「おまえな、ひとりで何個も食えるもんじゃねえぞアレ。うまいのは最初の一個だけだって」"

#. Occurrence 2_1:1244:2185: voice_id=E30_2_1_0001; voice_prefix=E30; voice_category=0; scene=2_1
#: 2_1:1244
msgctxt "text_id=2185 | speaker=unknown"
msgid "\"With Sizuki on board, we'd be at an even seven cans a piece. What a lifesaver...\""
msgstr "「静希たちがくるならノルマはひとり七個に下がるのか……助かるなあ……」"

#. Occurrence 2_1:1250:2186: voice_id=E50_2_1_0001; voice_prefix=E50; voice_category=0; scene=2_1
#: 2_1:1250
msgctxt "text_id=2186 | speaker=unknown"
msgid "\"So what's up with your lunch, Kinomi? It looks harder than the cans.\""
msgstr "「ところで木乃美の弁当の中身、なんか缶詰より硬そうじゃね？」"

#. Occurrence 2_1:1278:2187: scene=2_1
#: 2_1:1278
msgctxt "text_id=2187 | speaker=unknown"
msgid "  The boys usually passed the time by making fun of each other's lunches, but today they were united against a common foe."
msgstr "　いつもは互いの弁当の不出来さをネタにして騒ぐ彼らは、今日に限って団結していた。"

#. Occurrence 2_1:1289:2188: scene=2_1
#: 2_1:1289
msgctxt "text_id=2188 | speaker=unknown"
msgid "  A pyramid of countless cans stood in the middle of the table."
msgstr "　テーブルにはピラミッド型につまれた無数の缶詰。"

#. Occurrence 2_1:1294:2189: scene=2_1
#: 2_1:1294
msgctxt "text_id=2189 | speaker=unknown"
msgid "  They had all been taken from the pantry of a certain student's house, and the expiration dates on them had all been scribbled out with a marker."
msgstr "　賞味期限を油性のサインペンで塗りつぶされたソレは、ある男子生徒の家の倉庫から発掘されたものらしい。"

#. Occurrence 2_1:1332:2190: voice_id=E20_2_1_0001; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1332
msgctxt "text_id=2190 | speaker=unknown"
msgid "\"All right, lads. Everyone got your can openers?"
msgstr "「よし野郎ども、各自マイ缶切りの用意はいいな？"

#. Occurrence 2_1:1338:2191: voice_id=E20_2_1_0002; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1338
msgctxt "text_id=2191 | speaker=unknown"
msgid "  Eating them sucks! No one likes leftovers! But these metal demons must be slain at all costs, even if it means missing fifth period!"
msgstr "　食べるも地獄、残すも地獄。我ら五時限目の授業はないものと恐れぬ修羅となり、鉄の悪魔どもを平らげん―――"

#. Occurrence 2_1:1344:2192: voice_id=E20_2_1_0003; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1344
msgctxt "text_id=2192 | speaker=unknown"
msgid "  Oh, and a special thanks to our sponsors, Downtown McCoy and Nakayama Market!\""
msgstr "　えー、食材は下町のなんでも商会、マーケット中山からの提供です！」"

#. Occurrence 2_1:1384:2193: voice_id=E40_2_1_0001; voice_prefix=E40; voice_category=0; scene=2_1
#: 2_1:1384
msgctxt "text_id=2193 | speaker=unknown"
msgid "\"Yeah, baby! Let's eat!\""
msgstr "「ヒュー！　バカも休み休みyeah！」"

#. Occurrence 2_1:1389:2194: scene=2_1
#: 2_1:1389
msgctxt "text_id=2194 | speaker=unknown"
msgid "  The boys united as one and hoisted their can openers into the air."
msgstr "　一団となって、缶切りを持った手を天高く掲げる男子生徒の群れ。"

#. Occurrence 2_1:1454:2195: voice_id=E20_2_1_0004; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1454
msgctxt "text_id=2195 | speaker=unknown"
msgid "\"Eat up, Sizuki! There's enough can openers to go around!\""
msgstr "「ほら、静希も食べようぜー。缶切りならまだあるからさー」"

#. Occurrence 2_1:1466:2196: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0006; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:1466
msgctxt "text_id=2196 | speaker=soujuurou"
msgid "\"I thought I told you yesterday that I'm not interested in being your taste tester."
msgstr "「いや、君らの弁当の毒見はゴメンだって昨日言ったはずだ。"

#. Occurrence 2_1:1472:2197: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0007; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:1472
msgctxt "text_id=2197 | speaker=soujuurou"
msgid "  And besides, at least half of those cans are past their expiration date.\""
msgstr "　それに、その缶詰半分以上、賞味期限切れてるだろう」"

#. Occurrence 2_1:1478:2198: voice_id=E20_2_1_0005; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1478
msgctxt "text_id=2198 | speaker=unknown"
msgid "\"Oh, c'mon! Live a little!\""
msgstr "「なんだよー、つれねえなあー！」"

#. Occurrence 2_1:1489:2199: scene=2_1
#: 2_1:1489
msgctxt "text_id=2199 | speaker=unknown"
msgid "  Quite an inexplicably excited group of guys."
msgstr "　どっと沸くならず者たち。"

#. Occurrence 2_1:1494:2200: scene=2_1
#: 2_1:1494
msgctxt "text_id=2200 | speaker=unknown"
msgid "  Their real motivation seemed to be to spread the pain."
msgstr "　<犠牲者|なかま>を一人でも増やそうと思っているに違いない。"

#. Occurrence 2_1:1540:2201: scene=2_1
#: 2_1:1540
msgctxt "text_id=2201 | speaker=unknown"
msgid "  But moved by their energy and conceding defeat, Soujyuro got up from his seat and joined them."
msgstr "　彼らの賑やかさにほだされ、仕方ない、と席を立つ草十郎。"

#. Occurrence 2_1:1545:2202: scene=2_1
#: 2_1:1545
msgctxt "text_id=2202 | speaker=unknown"
msgid "  And before he could..."
msgstr "　それを、"

#. Occurrence 2_1:1552:2203: voice_id=D90_2_1_0000; voice_prefix=D90; voice_category=0; scene=2_1
#: 2_1:1552
msgctxt "text_id=2203 | speaker=unknown"
msgid "\"Hey! Give it a rest, why don't you?"
msgstr "「じゃ、わたしたちが釣り上げよっかなー！"

#. Occurrence 2_1:1558:2204: voice_id=D90_2_1_0001; voice_prefix=D90; voice_category=0; scene=2_1
#: 2_1:1558
msgctxt "text_id=2204 | speaker=unknown"
msgid "  Forget them, Sizuki! Come eat with us!\""
msgstr "　静希くん、あんなの放っておいて一緒にどう？」"

#. Occurrence 2_1:1564:2205: scene=2_1
#: 2_1:1564
msgctxt "text_id=2205 | speaker=unknown"
msgid "  Another interested party joined the fray."
msgstr "　もう一方の勢力がつかまえた。"

#. Occurrence 2_1:1584:2206: scene=2_1
#: 2_1:1584
msgctxt "text_id=2206 | speaker=unknown"
msgid "  A girl with short but stylish hair had called out to him."
msgstr "　呼び掛けたのはショートの髪がよく似合う女生徒だった。"

#. Occurrence 2_1:1589:2207: scene=2_1
#: 2_1:1589
msgctxt "text_id=2207 | speaker=unknown"
msgid "  She had also tried to get Soujyuro to join the track and field club several days earlier."
msgstr "　数日前、草十郎を陸上部に勧誘してくれた事もある。"

#. Occurrence 2_1:1630:2208: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0008; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:1630
msgctxt "text_id=2208 | speaker=soujuurou"
msgid "\"...Um, thanks for the offer, but I'd rather not.\""
msgstr "「……いや。そっちも遠慮したいな、できれば」"

#. Occurrence 2_1:1635:2209: scene=2_1
#: 2_1:1635
msgctxt "text_id=2209 | speaker=unknown"
msgid "  He answered with a troubled look on his face."
msgstr "　困り顔で返答する。"

#. Occurrence 2_1:1640:2210: scene=2_1
#: 2_1:1640
msgctxt "text_id=2210 | speaker=unknown"
msgid "  On their table was nothing but a pile of fruit Soujyuro had never seen before."
msgstr "　彼女達のテーブルには草十郎があまり知らない果実<だ|・><け|・>が山のようにつまれていた。"

#. Occurrence 2_1:1666:2211: voice_id=E10_2_1_0000; voice_prefix=E10; voice_category=0; scene=2_1
#: 2_1:1666
msgctxt "text_id=2211 | speaker=unknown"
msgid "\"What? Whyyy? You don't like papayas?"
msgstr "「えー、なんでー？　パパイヤとか嫌い？"

#. Occurrence 2_1:1666:2212: voice_id=E10_2_1_0000; voice_prefix=E10; voice_category=0; scene=2_1
#: 2_1:1666
msgctxt "text_id=2212 | speaker=unknown"
msgid "  We've got mango and coconut if you want something else! And don't tell anyone, but we've even got a Yubari melon!\""
msgstr "　マンゴーもあるし、ヤシの実だってあるし、内緒だけど夕張メロンもあるんだから！」"

#. Occurrence 2_1:1671:2213: scene=2_1
#: 2_1:1671
msgctxt "text_id=2213 | speaker=unknown"
msgid "  The members of the fruit group pumped their fists in unison at that last delicacy."
msgstr "　拳を立てて力説する果実グループ。"

#. Occurrence 2_1:1705:2214: voice_id=E20_2_1_0006; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1705
msgctxt "text_id=2214 | speaker=unknown"
msgid "\"Wait, coconuts? Can you even eat those?\""
msgstr "「待て、なんだヤシの実って？　アレ食えるもんなの？」"

#. Occurrence 2_1:1711:2215: voice_id=E30_2_1_0002; voice_prefix=E30; voice_category=0; scene=2_1
#: 2_1:1711
msgctxt "text_id=2215 | speaker=unknown"
msgid "\"Umm, I'd like a mango if you have any extra.\""
msgstr "「あ、マンゴー余ったら回してほしいなー」"

#. Occurrence 2_1:1717:2216: voice_id=E40_2_1_0002; voice_prefix=E40; voice_category=0; scene=2_1
#: 2_1:1717
msgctxt "text_id=2216 | speaker=unknown"
msgid "\"Idiots! Meat! MEEEAT! Eatin' anything else is just gonna make ya weak!\""
msgstr "「ばか、肉食え肉。そんなんだから貧弱な体してんだぞ、おまえら！」"

#. Occurrence 2_1:1722:2217: scene=2_1
#: 2_1:1722
msgctxt "text_id=2217 | speaker=unknown"
msgid "  Soujyuro couldn't keep track of all of the voices flying across the room."
msgstr "　飛びかう声に、やっぱり草十郎はついていけない。"

#. Occurrence 2_1:1755:2218: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0009; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:1755
msgctxt "text_id=2218 | speaker=soujuurou"
msgid "\"All I know is that nothing good will come out of either of these choices.\""
msgstr "「……分かるのは、どっちも破滅的だってコトだけだ」"

#. Occurrence 2_1:1761:2219: scene=2_1
#: 2_1:1761
msgctxt "text_id=2219 | speaker=unknown"
msgid "  That being said, he found it difficult to refuse them outright."
msgstr "　言いつつ、草十郎はどちらも断りきれない。"

#. Occurrence 2_1:1766:2220: scene=2_1
#: 2_1:1766
msgctxt "text_id=2220 | speaker=unknown"
msgid "  His tendency to accept others' goodwill at face value occasionally left him frozen with indecision."
msgstr "　他人の好意を素直に受け取りすぎる彼は、時に優柔不断になる。"

#. Occurrence 2_1:1771:2221: scene=2_1
#: 2_1:1771
msgctxt "text_id=2221 | speaker=unknown"
msgid "  Not accustomed to regular human interaction, he was unable to judge when it was or was not appropriate to turn someone down."
msgstr "　人間、好意になれていないと、何を捨てるべきか咄嗟に判断できないのである。"

#. Occurrence 2_1:1776:2222: scene=2_1
#: 2_1:1776
msgctxt "text_id=2222 | speaker=unknown"
msgid "  Someone tapped the lost, little lamb on the shoulder."
msgstr "　そんな迷える子羊の肩を叩く影がひとつ。"

#. Occurrence 2_1:1813:2223: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0000; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:1813
msgctxt "text_id=2223 | speaker=tobimaru"
msgid "\"Don't mind them. If you get involved with every idiot who invites you to do something, you'll mess up your whole life. It's okay to turn them down, you know."
msgstr "「ほっとけほっとけ。いちいちここのバカどもに付き合ってちゃ人生台無しだ。適当に流しとけばいいんだよ。"

#. Occurrence 2_1:1819:2224: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0001; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:1819
msgctxt "text_id=2224 | speaker=tobimaru"
msgid "  And you guys... Stop trying to lead this good soul over to the dark side!\""
msgstr "　オラ、おまえらもな、善良な羊を悪の園に引きずりこんでんじゃねえよ」"

#. Occurrence 2_1:1825:2225: scene=2_1
#: 2_1:1825
msgctxt "text_id=2225 | speaker=unknown"
msgid "  An inappropriately loud voice echoed throughout the classroom from behind him."
msgstr "　場違いにドスのきいた声が、草十郎の背後から教室に響きわたる。"

#. Occurrence 2_1:1861:2226: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0010; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:1861
msgctxt "text_id=2226 | speaker=soujuurou"
msgid "\"Vice president.\""
msgstr "「副会長」"

#. Occurrence 2_1:1866:2227: scene=2_1
#: 2_1:1866
msgctxt "text_id=2227 | speaker=unknown"
msgid "  Soujyuro turned around to see a boy about a head taller than him."
msgstr "　草十郎が振り向くと、そこには彼より頭ひとつぶん背の高い男子生徒が立っていた。"

#. Occurrence 2_1:1900:2228: scene=2_1
#: 2_1:1900
msgctxt "text_id=2228 | speaker=unknown"
msgid "  His long hair, while unkempt, had been brushed back, giving it an appealingly windswept look."
msgstr "　乱雑に、けれど見栄えよく撫で上げられた長髪。"

#. Occurrence 2_1:1905:2229: scene=2_1
#: 2_1:1905
msgctxt "text_id=2229 | speaker=unknown"
msgid "  His attractive features belied the contempt for the classroom his eyes carried."
msgstr "　整った美形でありながら刺々しい目つきでクラスを<睥睨|へいげい>する暴力性。"

#. Occurrence 2_1:1910:2230: scene=2_1
#: 2_1:1910
msgctxt "text_id=2230 | speaker=unknown"
msgid "  Unlike the perpetually dopey-looking Soujyuro, he was an extremely attractive boy, capable of captivating anyone who so much as glanced at him."
msgstr "　いつも眠そうな草十郎とは対照的な、一目で人を魅了する非の打ちどころのない美男子。"

#. Occurrence 2_1:1915:2231: scene=2_1
#: 2_1:1915
msgctxt "text_id=2231 | speaker=unknown"
msgid "  In most cases, such a boy's presence would be met with awe and respect. However..."
msgstr "　誰もが<畏|おそ>れ、<敬|うやま>うであろう彼への反応は、しかし。"

#. Occurrence 2_1:1948:2232: voice_id=E20_2_1_0007; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1948
msgctxt "text_id=2232 | speaker=unknown"
msgid "\"Oh look! Our mighty vice president has graciously decided to pay us a visit!\""
msgstr "「なんだよ、副会長さまのお出ましかよー！」"

#. Occurrence 2_1:1954:2233: voice_id=E30_2_1_0003; voice_prefix=E30; voice_category=0; scene=2_1
#: 2_1:1954
msgctxt "text_id=2233 | speaker=unknown"
msgid "\"I thought you were going to take up residence in the cafeteria so you wouldn't have to see our stupid faces anymore!\""
msgstr "「テメエらのバカ顔にはこりごりだって、学食に陣取ってたんじゃなかったのかよー！」"

#. Occurrence 2_1:1960:2234: voice_id=E40_2_1_0003; voice_prefix=E40; voice_category=0; scene=2_1
#: 2_1:1960
msgctxt "text_id=2234 | speaker=unknown"
msgid "\"Hehehe, have you lost your way, Your Highness? You're slumming where the commoners eat gruel from their troughs. Shouldn't you be sipping tea with the babes from Class A?\""
msgstr "「へへへ、ここは見てのとおりボンクラどもが集う貧民街でございますよ、王子はほら、Ａ組のきれいどころとカフェでお茶でもしてればいいじゃない！」"

#. Occurrence 2_1:2003:2235: voice_id=E50_2_1_0002; voice_prefix=E50; voice_category=0; scene=2_1
#: 2_1:2003
msgctxt "text_id=2235 | speaker=unknown"
msgid "\"Why don't you leave Sizuki alone, huh? First Lady Aoko has it in for him, now His Highness too! What could he have done to have earned the attention of such royalty?\""
msgstr "「また静希呼びに来たのかよ。青子女史といい鳶丸殿下といい、静希、なんかヤバいコトしちゃったのか……？」"

#. Occurrence 2_1:2009:2236: voice_id=D90_2_1_0002; voice_prefix=D90; voice_category=0; scene=2_1
#: 2_1:2009
msgctxt "text_id=2236 | speaker=unknown"
msgid "\"Really?! But Sizuki's such a goody-two-shoes! He's never broken any rules!"
msgstr "「えー。静希くんは校則違反しないじゃん。"

#. Occurrence 2_1:2009:2237: voice_id=D90_2_1_0002; voice_prefix=D90; voice_category=0; scene=2_1
#: 2_1:2009
msgctxt "text_id=2237 | speaker=unknown"
msgid "  Well, the rules of the school at least!\""
msgstr "　ちょっと、それ以外のルール破るだけで！」"

#. Occurrence 2_1:2015:2238: voice_id=E10_2_1_0001; voice_prefix=E10; voice_category=0; scene=2_1
#: 2_1:2015
msgctxt "text_id=2238 | speaker=unknown"
msgid "\"Wait, could it be that...Tsukiji really switched teams after Aozaki rejected him!?\""
msgstr "「ってコトはやっぱり―――<槻司|つきじ>くん、蒼崎に振られてからそっちに走ったって本当だったのね!?」"

#. Occurrence 2_1:2050:2239: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0011; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:2050
msgctxt "text_id=2239 | speaker=soujuurou"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 2_1:2055:2240: scene=2_1
#: 2_1:2055
msgctxt "text_id=2240 | speaker=unknown"
msgid "  They continued to give him a hard time."
msgstr "　この通り、親愛と友情に満ちた暴言だった。"

#. Occurrence 2_1:2066:2241: scene=2_1
#: 2_1:2066
msgctxt "text_id=2241 | speaker=unknown"
msgid "  Soujyuro could not help but feel sorry for him."
msgstr "　言われたい放題の男子に、草十郎はつい同情してしまう。"

#. Occurrence 2_1:2071:2242: scene=2_1
#: 2_1:2071
msgctxt "text_id=2242 | speaker=unknown"
msgid "  The class vice president, on the other hand, showed absolutely no reaction whatsoever."
msgstr "　もっとも、肝心の男子はまったくのノーリアクション。"

#. Occurrence 2_1:2076:2243: scene=2_1
#: 2_1:2076
msgctxt "text_id=2243 | speaker=unknown"
msgid "  He glared at them with a bored look and simply raised his voice."
msgstr "　騒ぎ立てる彼らをつまらなげに<一瞥|いちべつ>すると、吐き捨てるように声をあげる。"

#. Occurrence 2_1:2116:2244: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0002; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2116
msgctxt "text_id=2244 | speaker=tobimaru"
msgid "\"You freaks should get some new material."
msgstr "「相変わらず無駄に元気があって結構じゃねえかテメエら。"

#. Occurrence 2_1:2123:2245: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0003; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2123
msgctxt "text_id=2245 | speaker=tobimaru"
msgid "  Why don't you spend your time more productively for once? Like helping with the Special Winter Cleaning Team."
msgstr "　そんなに活力たぎってんなら冬期特別清掃班にだって参加出来るよなあ、"

msgctxt "text_id=2246 | speaker=unknown"
msgid " Yeah, you heard me."
msgstr "オイ？"

#. Occurrence 2_1:2134:2247: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0004; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2134
msgctxt "text_id=2247 | speaker=tobimaru"
msgid "  Only one student in the entire school has signed up so far! Having all of Class C with us would be a huge help, but I guess you want me and Aozaki to do all the work!\""
msgstr "　いまんところ自主的に申し出てるのは全校で一人しかいねえんだ。２－Ｃ全員が参加すりゃあ、俺も蒼崎も肩の荷がおりるってもんなんだがよ……！」"

#. Occurrence 2_1:2169:2248: scene=2_1
#: 2_1:2169
msgctxt "text_id=2248 | speaker=unknown"
msgid "  The menacing growl in his voice contrasted greatly with the boy's well-constructed looks."
msgstr "　その端整な顔立ちとはかけ離れた、ドスのきいた<胴間|どうま>声が教室に響く。"

#. Occurrence 2_1:2174:2249: scene=2_1
#: 2_1:2174
msgctxt "text_id=2249 | speaker=unknown"
msgid "  Both Team Canned and Team Fruit's words were doused like a fire being smothered. "
msgstr "　彼の一喝で水を打ったように黙りこむ、ならず者部隊＆スイーツ愛好者たち。"

#. Occurrence 2_1:2179:2250: scene=2_1
#: 2_1:2179
msgctxt "text_id=2250 | speaker=unknown"
msgid "  This was partly due to their fear of the boy, but mostly due to their fear of the Special Winter Cleaning Team."
msgstr "　この男子生徒を畏怖しての事もあるが、何より『冬期特別清掃班』が恐ろしいからである。"

#. Occurrence 2_1:2199:2251: scene=2_1
#: 2_1:2199
msgctxt "text_id=2251 | speaker=unknown"
msgid "  Yes, the Special Winter Cleaning Team."
msgstr "　冬期特別清掃班。"

#. Occurrence 2_1:2204:2252: scene=2_1
#: 2_1:2204
msgctxt "text_id=2252 | speaker=unknown"
msgid "  Joining meant spending part of your winter break cleaning up the old school building and mountainous rear courtyard that had been neglected by the previous two student councils."
msgstr "　それは先々代の生徒会からお手上げ状態で放置していた旧校舎、および山みたいな裏庭の森を冬休みを挙げて清掃しよう、という趣旨の、学園行事の名を借りた拷問だ。"

#. Occurrence 2_1:2224:2253: scene=2_1
#: 2_1:2224
msgctxt "text_id=2253 | speaker=unknown"
msgid "  It was a form of legalized torture that could potentially ruin three whole days of your winter break."
msgstr "　おそらく、冬休みのうち三日は完全に潰される。"

#. Occurrence 2_1:2229:2254: scene=2_1
#: 2_1:2229
msgctxt "text_id=2254 | speaker=unknown"
msgid "  And forget about any compensation in the form of extra credits."
msgstr "　もちろん成績に残るような見返りはない。"

#. Occurrence 2_1:2234:2255: scene=2_1
#: 2_1:2234
msgctxt "text_id=2255 | speaker=unknown"
msgid "  No, it was pointless volunteer work for a student council project. It was practically a miracle that they had found even a single volunteer."
msgstr "　ことはあくまで生徒会が立案しただけのボランティア。参加希望者が一人でもいたコトは奇跡に近い。"

#. Occurrence 2_1:2269:2256: voice_id=E20_2_1_0008; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:2269
msgctxt "text_id=2256 | speaker=unknown"
msgid "\"Umm... sorry, but we're clearly... not fit enough... yeah, that's it. That stuff takes conditioning. We'll just eat our canned food in the corner now, okay?\""
msgstr "「あー……いや、僕ら、ちょっと体弱いんで……すみっちょで缶詰食べてますね？」"

#. Occurrence 2_1:2275:2257: voice_id=D90_2_1_0003; voice_prefix=D90; voice_category=0; scene=2_1
#: 2_1:2275
msgctxt "text_id=2257 | speaker=unknown"
msgid "\"Yeah, us, too. We're uh... anemic, you see... and if we don't eat this fruit, we'll, uh, die. That, and we already have plans, or something.\""
msgstr "「わたしたちも貧血気味で……こうやって果物たべてないと死んじゃうっていうか……冬休みはもう予定いっぱいっていうか……」"

#. Occurrence 2_1:2292:2258: scene=2_1
#: 2_1:2292
msgctxt "text_id=2258 | speaker=unknown"
msgid "  All of the students but one scuffled away."
msgstr "　一名を除いて、そそくさと隅に移動する２年Ｃ組の皆さん。"

#. Occurrence 2_1:2318:2259: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0005; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2318
msgctxt "text_id=2259 | speaker=tobimaru"
msgid "\"That's much better. Lunchtime is best in silence."
msgstr "「よし、昼食はやっぱり静かにやらねえとな。"

#. Occurrence 2_1:2329:2260: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0006; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2329
msgctxt "text_id=2260 | speaker=tobimaru"
msgid "  I'm tired of people complaining that you guys make even more noise than the freshmen. Get it together, you losers.\""
msgstr "　一年坊主の教室より二年の教室の方がやかましいなんて苦情、いいかげんにしやがれよアホウども？」"

#. Occurrence 2_1:2354:2261: scene=2_1
#: 2_1:2354
msgctxt "text_id=2261 | speaker=unknown"
msgid "  The mob meekly scurried away."
msgstr "　うへーい、と弱々しく退散する有象無象たち。"

#. Occurrence 2_1:2359:2262: scene=2_1
#: 2_1:2359
msgctxt "text_id=2262 | speaker=unknown"
msgid "  Soujyuro turned to join them, but as he did..."
msgstr "　その中に溶け込むように流れていく草十郎だったが、"

#. Occurrence 2_1:2391:2263: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0007; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2391
msgctxt "text_id=2263 | speaker=tobimaru"
msgid "\"Hold on, Soujyuro. You're with me.\""
msgstr "「おう、おまえはこっちだ草十郎。ちょい顔貸せ」"

#. Occurrence 2_1:2397:2264: scene=2_1
#: 2_1:2397
msgctxt "text_id=2264 | speaker=unknown"
msgid "  The hand on his shoulder held him in place."
msgstr "　強引に肩を引かれ、仲間入りを阻まれた。"

#. Occurrence 2_1:2420:2265: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_2_1_0004; voice_prefix=B50; voice_category=6; scene=2_1
#: 2_1:2420
msgctxt "text_id=2265 | speaker=kinomi"
msgid "\"Jeez, who does the student council think they are, anyway? Barging into our classroom to lecture us on table manners!\""
msgstr "「……っだよ、生徒会横暴ー。人んちのテーブルマナーまで指図してほしくねーよなー！」"

#. Occurrence 2_1:2426:2266: scene=2_1
#: 2_1:2426
msgctxt "text_id=2266 | speaker=unknown"
msgid "  Kinomi cursed him under his breath to his friends the second the vice president turned to go."
msgstr "　立ち去る背中を好機と見たのか、仲間うちでのみ聞こえるよう悪態をつく木乃美。"

#. Occurrence 2_1:2459:2267: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0008; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2459
msgctxt "text_id=2267 | speaker=tobimaru"
msgid "\"What was that, Kinomi? Oh! You wanna become our second volunteer? Perfect! I'll make it the best winter vacation you've ever had!\""
msgstr "「ああ？　上等じゃねえか木乃美、いいぜ、おまえが記念すべき二人目だ。冬休み、首を洗って待ってやがれ」"

#. Occurrence 2_1:2465:2268: scene=2_1
#: 2_1:2465
msgctxt "text_id=2268 | speaker=unknown"
msgid "  The vice president must have heard everything Kinomi said, because he gave a thumbs up before figuratively jabbing it in his eye."
msgstr "　きっかり聞こえていたのか、副会長は親指をたてて、ぐるん、と<一回転|ノックアウト>の意を示す。"

#. Occurrence 2_1:2506:2269: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_2_1_0005; voice_prefix=B50; voice_category=6; scene=2_1
#: 2_1:2506
msgctxt "text_id=2269 | speaker=kinomi"
msgid "\"Yo, is this guy for real?"
msgstr "「はあ、なに言ってんですかアイツ？"

#. Occurrence 2_1:2512:2270: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_2_1_0006; voice_prefix=B50; voice_category=6; scene=2_1
#: 2_1:2512
msgctxt "text_id=2270 | speaker=kinomi"
msgid "  This is voluntary, isn't it? It ain't voluntary if you gotta force people to do it! Am I right?!\""
msgstr "　アレ自主的なイベントじゃん、いくら副会長ったって強制はできないですよねぇ!?」"

#. Occurrence 2_1:2518:2271: scene=2_1
#: 2_1:2518
msgctxt "text_id=2271 | speaker=unknown"
msgid "  The problem child of Class C laughed merrily."
msgstr "　ひひひ、と笑う２年Ｃ組の誇る問題児。"

#. Occurrence 2_1:2544:2272: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0009; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2544
msgctxt "text_id=2272 | speaker=tobimaru"
msgid "\"That was yesterday."
msgstr "「そりゃ昨日までの話だ。"

#. Occurrence 2_1:2550:2273: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0010; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2550
msgctxt "text_id=2273 | speaker=tobimaru"
msgid "  The school has since accepted the president's proposal that council members be able to forcibly enlist students for participation."
msgstr "　会長の提案が学校側に受理されてな、本日付けで生徒会役員は強制力のある推薦権をもらえたんだよ。"

#. Occurrence 2_1:2561:2274: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0011; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2561
msgctxt "text_id=2274 | speaker=tobimaru"
msgid "  And recommendations by the president and vice president are ironclad. Refusing them means breaking school rules in addition to facing Aozaki's wrath, which, let me tell you now, I won't be able to stop.\""
msgstr "　とくに会長と副会長の推薦は絶対だ。拒否した場合、学校側はともかく、蒼崎がなにするか俺には止められねえからそのつもりでな？」"

#. Occurrence 2_1:2587:2275: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_2_1_0007; voice_prefix=B50; voice_category=6; scene=2_1
#: 2_1:2587
msgctxt "text_id=2275 | speaker=kinomi"
msgid "\"Whaaat!? You're hanging me by my balls here! This is extortion, or blackmail, or something!\""
msgstr "@o「げぇぇぇ!!!?　ちょ、それ事実上の死刑宣告じゃん!?　生徒^会まじ横暴ー！！！！」"

#. Occurrence 2_1:2610:2276: scene=2_1
#: 2_1:2610
msgctxt "text_id=2276 | speaker=unknown"
msgid "  Kinomi's terrified shrieking continued behind them as the vice president and Soujyuro left the classroom."
msgstr "　悪態から悲鳴に変わる木乃美の断末魔を後に、副会長と草十郎は２年Ｃ組を後にした。"

#. Occurrence 2_2:72:2277: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0000; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:72
msgctxt "text_id=2277 | speaker=tobimaru"
msgid "\"What am I going to do with you, Soujyuro?\""
msgstr "「おまえも大変だな、草十郎」"

#. Occurrence 2_2:78:2278: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0000; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:78
msgctxt "text_id=2278 | speaker=soujuurou"
msgid "\"With me? Aren't you busy with other things, vice president?\""
msgstr "「あんたもわりと暇なんだな、副会長」"

#. Occurrence 2_2:104:2279: scene=2_2
#: 2_2:104
msgctxt "text_id=2279 | speaker=unknown"
msgid "  The two entered the empty student council room."
msgstr "　無人の生徒会室に入るなり所感を口にするふたり。"

#. Occurrence 2_2:110:2280: scene=2_2
#: 2_2:110
msgctxt "text_id=2280 | speaker=unknown"
msgid "  Misaki High's student council had the use of two rooms."
msgstr "　三咲高校の生徒会室は二つあり、"

#. Occurrence 2_2:115:2281: scene=2_2
#: 2_2:115
msgctxt "text_id=2281 | speaker=unknown"
msgid "  One was a large office specifically made for the student council."
msgstr "　一つは生徒会用に作られた大部屋、"

#. Occurrence 2_2:120:2282: scene=2_2
#: 2_2:120
msgctxt "text_id=2282 | speaker=unknown"
msgid "  The second was an archive room, once used as a preparatory office for math courses."
msgstr "　もう一つは数学の準備室だった資料室とに分かれている。"

#. Occurrence 2_2:141:2283: scene=2_2
#: 2_2:141
msgctxt "text_id=2283 | speaker=unknown"
msgid "  As the latter of the two, the walls were lined with densely packed shelves, making an already cramped room seem even more confined."
msgstr "　こちらは資料室の方で、壁にはファイルのつまった資料棚がびっしりと並び、ただでさえ狭苦しい部屋を余計に窮屈に見せていた。"

#. Occurrence 2_2:148:2284: scene=2_2
#: 2_2:148
msgctxt "text_id=2284 | speaker=unknown"
msgid "  For this reason, it served more as a private refuge to the student council."
msgstr "　生徒会室というより、個人の隠れ家といった方が正しいだろう。"

#. Occurrence 2_2:153:2285: scene=2_2
#: 2_2:153
msgctxt "text_id=2285 | speaker=unknown"
msgid "  The two students sat across from one another."
msgstr "　草十郎が椅子に座ると、向かい合うように男子生徒も腰を下ろした。"

#. Occurrence 2_2:189:2286: scene=2_2
#: 2_2:189
msgctxt "text_id=2286 | speaker=unknown"
msgid "  Tobimaru Tsukiji."
msgstr "　<槻司|つきじ><鳶丸|とびまる>。"

#. Occurrence 2_2:194:2287: scene=2_2
#: 2_2:194
msgctxt "text_id=2287 | speaker=unknown"
msgid "  He was the son of the chairman of Misaki High School and the vice president of its school council."
msgstr "　私立三咲高校の理事長の息子であり、生徒会副会長。"

#. Occurrence 2_2:199:2288: scene=2_2
#: 2_2:199
msgctxt "text_id=2288 | speaker=unknown"
msgid "  Like Soujyuro, he was in his second year, and first met the transfer student a week earlier when the task of looking after him was dumped onto the student council."
msgstr "　学年は草十郎と同じく二年生で、約一週間前、転入生の世話を生徒会長に押しつけられてからの付き合いである。"

#. Occurrence 2_2:225:2289: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0001; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:225
msgctxt "text_id=2289 | speaker=tobimaru"
msgid "\"I told you to stop calling me that. People may as well call me the president's dog, the shit I have to take from her.\""
msgstr "「副会長はやめろって。クソッタレな話だが、俺はしょせん会長の犬だからな」"

#. Occurrence 2_2:231:2290: scene=2_2
#: 2_2:231
msgctxt "text_id=2290 | speaker=unknown"
msgid "  As self-deprecating as his words were, he hardly seemed dissatisfied with the arrangement."
msgstr "　やれやれと自嘲するも、不満があるワケでもなさそうだ。"

#. Occurrence 2_2:238:2291: scene=2_2
#: 2_2:238
msgctxt "text_id=2291 | speaker=unknown"
msgid "  He took a snack from his pocket and grimaced at it before taking a bite."
msgstr "　鳶丸はポケットからスナック菓子を取りだし、実にまずそうに口に入れた。"

#. Occurrence 2_2:250:2292: scene=2_2
#: 2_2:250
msgctxt "text_id=2292 | speaker=unknown"
msgid "  The hundred-calorie energy bar sacrificed flavor for efficacy, but somehow not enough to prevent him gnawing on it like a piece of jerky."
msgstr "　一本１００キロカロリーほどのブロック形式の簡易食を、それこそ干し肉を引きちぎるように片づけていく。"

#. Occurrence 2_2:303:2293: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0001; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:303
msgctxt "text_id=2293 | speaker=soujuurou"
msgid "\"I see what you're saying, Tobimaru, but being a dog isn't exactly a good thing.\""
msgstr "「そうか。でも犬はよくないな、鳶丸」"

#. Occurrence 2_2:345:2294: scene=2_2
#: 2_2:345
msgctxt "text_id=2294 | speaker=unknown"
msgid "  Soujyuro sat in the chair with a concerned look on his face."
msgstr "　難しい顔つきで草十郎は椅子に座る。"

#. Occurrence 2_2:356:2295: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0002; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:356
msgctxt "text_id=2295 | speaker=tobimaru"
msgid "\"Huh? What's wrong with dogs?\""
msgstr "「あん？　犬がどうしたって？」"

#. Occurrence 2_2:374:2296: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0002; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:374
msgctxt "text_id=2296 | speaker=soujuurou"
msgid "\"Dogs aren't good. I mean, it's a bad comparison in the first place, but dogs are way scarier.\""
msgstr "「犬はよくないって言った。喩えが違う気がするし、なにより怖いぞ、アレ」"

#. Occurrence 2_2:380:2297: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0003; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:380
msgctxt "text_id=2297 | speaker=tobimaru"
msgid "\"You grew up in the mountains, and you're still afraid of dogs?\""
msgstr "「？　なんだよ、山奥育ちのくせに犬が怖いのか？」"

#. Occurrence 2_2:406:2298: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0003; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:406
msgctxt "text_id=2298 | speaker=soujuurou"
msgid "\"I'm afraid of most animals, but dogs are in a class of their own."
msgstr "「そりゃたいていの生き物は怖いけど、犬は別格だ。"

#. Occurrence 2_2:412:2299: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0004; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:412
msgctxt "text_id=2299 | speaker=soujuurou"
msgid "  A pack of wild dogs is particularly terrifying."
msgstr "　徒党を組んだ野犬ほど始末に負えないものはない。"

#. Occurrence 2_2:418:2300: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0005; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:418
msgctxt "text_id=2300 | speaker=soujuurou"
msgid "  They're as tenacious as they are fast."
msgstr "　<脚|あし>の速さも脅威だけど、なにより執念深すぎる。"

#. Occurrence 2_2:429:2301: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0006; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:429
msgctxt "text_id=2301 | speaker=soujuurou"
msgid "  No matter where you run, they'll chase you as long as there's still life left in them.\""
msgstr "　坂だろうと追いかけてくるし、最後の一匹になるまで引かないんだぞ」"

#. Occurrence 2_2:474:2302: scene=2_2
#: 2_2:474
msgctxt "text_id=2302 | speaker=unknown"
msgid "  Soujyuro opened his lunch as he spoke."
msgstr "　などと言いつつ、弁当の包みを開ける草十郎。"

#. Occurrence 2_2:479:2303: scene=2_2
#: 2_2:479
msgctxt "text_id=2303 | speaker=unknown"
msgid "  Inside the bright green cloth: three beautifully made triangular rice balls."
msgstr "　若草色をした布には、綺麗な三角形をしたおにぎりが三つ包まれていた。"

#. Occurrence 2_2:524:2304: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0004; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:524
msgctxt "text_id=2304 | speaker=tobimaru"
msgid "\"...Would you look at that.\""
msgstr "「……ショックだ」"

#. Occurrence 2_2:554:2305: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0007; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:554
msgctxt "text_id=2305 | speaker=soujuurou"
msgid "\"Look at what? What do you mean?\""
msgstr "「？　ショックってなにが？」"

#. Occurrence 2_2:560:2306: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0005; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:560
msgctxt "text_id=2306 | speaker=tobimaru"
msgid "\"Oh, nothing. It's just that those are some special-looking rice balls you've got there.\""
msgstr "「いや、そんな、この世のものとは思えない握り飯を見たのは初めてだ。思わず絶句しちまった」"

#. Occurrence 2_2:572:2307: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0008; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:572
msgctxt "text_id=2307 | speaker=soujuurou"
msgid "\"...Is that a good thing or a bad thing?\""
msgstr "「……。それ、どっちなんだ？」"

#. Occurrence 2_2:596:2308: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0006; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:596
msgctxt "text_id=2308 | speaker=tobimaru"
msgid "\"I'm trying to compliment you, you idiot.\""
msgstr "「誉めてるんだよ、馬鹿」"

#. Occurrence 2_2:640:2309: scene=2_2
#: 2_2:640
msgctxt "text_id=2309 | speaker=unknown"
msgid "  Soujyuro was always confounded by phrasing that could be interpreted in multiple ways; euphemisms and subtle sarcasm were often lost on him."
msgstr "　草十郎を相手に侮辱とも称賛とも取れる言い回しはこういう結果を招く。婉曲な表現、遠回しな嫌味をかみ砕ける<機微|きび>がないためだ。"

#. Occurrence 2_2:645:2310: scene=2_2
#: 2_2:645
msgctxt "text_id=2310 | speaker=unknown"
msgid "  It was only on rare occasions, like this one, that he chose to confirm what was being said."
msgstr "　ただ、今のように言葉の良し悪しをいちいち訊ねるのは<希|まれ>だった。"

#. Occurrence 2_2:650:2311: scene=2_2
#: 2_2:650
msgctxt "text_id=2311 | speaker=unknown"
msgid "  Tobimaru had come to suspect that Soujyuro had a very black-and-white way of seeing things."
msgstr "　鳶丸の推測だが、この少年は個人的に<譲|ゆず>れない事のみ白黒をハッキリさせる気質らしい。"

#. Occurrence 2_2:676:2312: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0009; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:676
msgctxt "text_id=2312 | speaker=soujuurou"
msgid "\"Say, does that hard chunk of flour-looking stuff taste any good?\""
msgstr "「ところで。その固まった小麦粉みたいなの、美味しいのか？」"

#. Occurrence 2_2:682:2313: scene=2_2
#: 2_2:682
msgctxt "text_id=2313 | speaker=unknown"
msgid "  Soujyuro stared at the energy bar with a curious look on his face."
msgstr "　興味津々とばかりに鳶丸の簡易食を見つめる草十郎。"

#. Occurrence 2_2:723:2314: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0007; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:723
msgctxt "text_id=2314 | speaker=tobimaru"
msgid "\"It's not meant to taste good. You can try it if you want."
msgstr "「まずくはねえが美味くもねえよ。ま、試してみる分には止めねえが。"

#. Occurrence 2_2:735:2315: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0008; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:735
msgctxt "text_id=2315 | speaker=tobimaru"
msgid "  People shouldn't hold back when it comes to the three base desires.\""
msgstr "　人間、何事も手間暇惜しむようになっちゃおしまいだぜ。事が三大欲求ならなおさらだ」"

#. Occurrence 2_2:768:2316: scene=2_2
#: 2_2:768
msgctxt "text_id=2316 | speaker=unknown"
msgid "  Tobimaru quickly finished off his bar, put another one on the table, and grabbed one of Soujyuro's rice ball."
msgstr "　鳶丸はガリガリとブロック菓子を平らげ、残った一本を机に置き、当然という手つきでおにぎりを一つ手に取った。"

#. Occurrence 2_2:773:2317: scene=2_2
#: 2_2:773
msgctxt "text_id=2317 | speaker=unknown"
msgid "  Soujyuro failed to notice the rudeness of the forced exchange, and gave the proffered energy bar a try."
msgstr "　草十郎も当然とばかりに鳶丸の暴挙を見逃し、差し出されたブロック菓子を食べてみる。"

#. Occurrence 2_2:820:2318: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0010; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:820
msgctxt "text_id=2318 | speaker=soujuurou"
msgid "\"...It kind of tastes like dirt.\""
msgstr "「……なんだか、土を食べてるみたいだ」"

#. Occurrence 2_2:846:2319: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0009; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:846
msgctxt "text_id=2319 | speaker=tobimaru"
msgid "\"Now you get it. It's what a joyless existence tastes like.\""
msgstr "「違いない。遊びを無くせば人生こんなもんだって見本だな」"

#. Occurrence 2_2:869:2320: scene=2_2
#: 2_2:869
msgctxt "text_id=2320 | speaker=unknown"
msgid "  Out of principle, Soujyuro labored over his energy bar, cringing all the while."
msgstr "　草十郎は苦い顔のまま、律儀に簡易食をかじっていく。"

#. Occurrence 2_2:874:2321: scene=2_2
#: 2_2:874
msgctxt "text_id=2321 | speaker=unknown"
msgid "  He was both curious of the unknown and loathe to leave something unfinished."
msgstr "　未知への関心と、はじめた事はきっちり終わらせようとする律儀さである。"

#. Occurrence 2_2:905:2322: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0010; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:905
msgctxt "text_id=2322 | speaker=tobimaru"
msgid "\"Don't force yourself to finish it right now. The whole point of it is that you can eat it on the run. And while the flavor isn't that great, at least it's consistent."
msgstr "「いま無理に平らげる必要はねえぞ。そいつの利点は携帯食ってところだからな。素で味けないが、食えるうちは味が落ちないのがいいところだ。"

#. Occurrence 2_2:916:2323: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0011; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:916
msgctxt "text_id=2323 | speaker=tobimaru"
msgid "  Anyway, never mind that. Are you getting used to how things work around here?\""
msgstr "　ま、そっちはともかく。どうだ、少しは慣れたか？」"

#. Occurrence 2_2:963:2324: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0011; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:963
msgctxt "text_id=2324 | speaker=soujuurou"
msgid "\"Yes. You and Aozaki have been a huge help.\""
msgstr "「ああ。鳶丸や蒼崎が気を遣ってくれているからね」"

#. Occurrence 2_2:990:2325: scene=2_2
#: 2_2:990
msgctxt "text_id=2325 | speaker=unknown"
msgid "  Tobimaru turned his eyes up to the ceiling, unable to handle Soujyuro's carefree smile."
msgstr "　屈託のない笑顔に、鳶丸はつい顔をそらしてしまった。"

#. Occurrence 2_2:995:2326: scene=2_2
#: 2_2:995
msgctxt "text_id=2326 | speaker=unknown"
msgid "  As absentminded as Soujyuro might have been, his expressions were nonetheless incredibly earnest."
msgstr "　草十郎はたしかに普段からぼんやりしているが、反面、こうして見せる感情表現はまっすぐで嘘がない。"

#. Occurrence 2_2:1000:2327: scene=2_2
#: 2_2:1000
msgctxt "text_id=2327 | speaker=unknown"
msgid "  It was like poison to someone as self-absorbed as Tobimaru."
msgstr "　鳶丸のように若く利己的な人間にとっては、ささやかな毒にもなる。"

#. Occurrence 2_2:1040:2328: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0012; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1040
msgctxt "text_id=2328 | speaker=tobimaru"
msgid "(Now I know why Aozaki goes so out of her way to avoid him.)"
msgstr "『……だから蒼崎はこねえんだよなあ……』"

#. Occurrence 2_2:1046:2329: scene=2_2
#: 2_2:1046
msgctxt "text_id=2329 | speaker=unknown"
msgid "  He took a bite from the rice ball to steer himself away from such thoughts."
msgstr "　内心呟いて、手にした握り飯を一口かじる鳶丸。"

#. Occurrence 2_2:1051:2330: scene=2_2
#: 2_2:1051
msgctxt "text_id=2330 | speaker=unknown"
msgid "  Though now cold, the rice had managed to maintain its freshness, startling Tobimaru."
msgstr "　冷めた白米でありながら、しっかり柔らかな食感である事に二度驚く鳶丸だった。"

#. Occurrence 2_2:1095:2331: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0013; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1095
msgctxt "text_id=2331 | speaker=tobimaru"
msgid "\"...Huh.  "
msgstr "「……ん？　"

msgctxt "text_id=2332 | speaker=unknown"
msgid "Wait a sec, I'm the one that has your back, you know that right? Aozaki told me you were too annoying to deal with!\""
msgstr "いや待て、気を遣ってんのは俺だけじゃねえか。蒼崎なんておまえが転入した日に“彼、迷惑だから見張ってて”の一言だけだぞ!?」"

#. Occurrence 2_2:1132:2333: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0012; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1132
msgctxt "text_id=2333 | speaker=soujuurou"
msgid "\"Did I say something to upset you?\""
msgstr "「……なんでそこで君が怒るんだ？」"

#. Occurrence 2_2:1169:2334: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0014; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1169
msgctxt "text_id=2334 | speaker=tobimaru"
msgid "\"Don't you get it? I'm the only one helping you keep your head above water, while Aozaki sits in the student council room digging up dirt on other students!"
msgstr "「いや、だからだな。おまえが学校に慣れるよう陰ながら見守ってんのは俺で、蒼崎は生徒会室で全校生徒の弱みを集めてるだけって話だ！"

#. Occurrence 2_2:1169:2335: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0014; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1169
msgctxt "text_id=2335 | speaker=tobimaru"
msgid "  I'm the one who gets lumbered with the crap jobs, while she gets to-\""
msgstr "　面倒な苦労してんのは俺だけじゃねえかって―――」"

#. Occurrence 2_2:1193:2336: scene=2_2
#: 2_2:1193
msgctxt "text_id=2336 | speaker=unknown"
msgid "  Tobimaru stopped himself, realizing how ridiculous he sounded. Soujyuro, rightly so, knew it was nothing to get this upset over."
msgstr "　そこまで口にして、鳶丸は自分の言い分が馬鹿らしくなった。草十郎の言う通り、鳶丸が怒る筋合いでもない。"

#. Occurrence 2_2:1214:2337: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0015; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1214
msgctxt "text_id=2337 | speaker=tobimaru"
msgid "\"Well, whatever. I'm only here 'cause she told me to be."
msgstr "「……ま、いいさ。蒼崎に言いつけられなきゃこうなる事もなかったしな。"

#. Occurrence 2_2:1231:2338: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0016; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1231
msgctxt "text_id=2338 | speaker=tobimaru"
msgid "  Do you know?"
msgstr "　知ってるか？"

#. Occurrence 2_2:1231:2339: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0016; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1231
msgctxt "text_id=2339 | speaker=tobimaru"
msgid "  Do you know why she stuck me with you?\""
msgstr "　あいつ、どうして俺にこんな役させたと思う？」"

#. Occurrence 2_2:1242:2340: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0013; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1242
msgctxt "text_id=2340 | speaker=soujuurou"
msgid "\"Because you're the vice president?\""
msgstr "「副会長だからだろ」"

#. Occurrence 2_2:1253:2341: scene=2_2
#: 2_2:1253
msgctxt "text_id=2341 | speaker=unknown"
msgid "  Tobimaru's handsome face went dark."
msgstr "　言われて、鳶丸はその綺麗な顔を曇らせる。"

#. Occurrence 2_2:1280:2342: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0017; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1280
msgctxt "text_id=2342 | speaker=tobimaru"
msgid "\"Do you really think it's normal for a student council vice president to waste all of his time on a single transfer student?"
msgstr "「あのなあ。どうして副会長が転入生ひとりにかかりっきりにならなくちゃいけねえんだよ。"

#. Occurrence 2_2:1302:2343: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0018; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1302
msgctxt "text_id=2343 | speaker=tobimaru"
msgid "  Ugh, whatever, man. Try asking her directly if you get the chance. You'll learn who she really is.\""
msgstr "　チッ、いいぜ、機会があったら蒼崎本人に聞いてみな。あいつの本性が分かるからよ」"

#. Occurrence 2_2:1347:2344: scene=2_2
#: 2_2:1347
msgctxt "text_id=2344 | speaker=unknown"
msgid "  He snatched another bite of the rice ball while grumbling under his breath."
msgstr "　鳶丸は悪態をつきながらさらに握り飯をかじる。"

#. Occurrence 2_2:1352:2345: scene=2_2
#: 2_2:1352
msgctxt "text_id=2345 | speaker=unknown"
msgid "  There it was again. Rice grains that were just dry enough to be fresh and tender in the mouth; a morsel that betrayed its humble description, which must have been delicately molded by a master chef rather than haphazardly clumped into a ball..."
msgstr "　乾燥した米粒でありながら、なんという<瑞々|みずみず>しさ……言うなれば<握|にぎ>り飯ではなく<包|つつ>み飯。力任せに米を固めたのではなく、職人の業で優しく『おにぎり』というカタチに集結させたとしか思えない……"

#. Occurrence 2_2:1410:2346: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0019; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1410
msgctxt "text_id=2346 | speaker=tobimaru"
msgid "\"Just the right amount of salt, and the subtlest of soy sauce notes coming from the center, it..."
msgstr "「そしてなによりこの塩加減、中の具からしみだした玄妙な醤油加減はどうだ―――"

msgctxt "text_id=2347 | speaker=unknown"
msgid " It doesn't just whet your appetite, it stimulates the desire centers of your brain and-"
msgstr "食欲をそそるどころか、脳を食欲だけにするような―――"

msgctxt "text_id=2348 | speaker=unknown"
msgid " ...Oh wow.\""
msgstr "おお―――」"

#. Occurrence 2_2:1427:2349: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0014; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1427
msgctxt "text_id=2349 | speaker=soujuurou"
msgid "\"Tobimaru, you appear to be thinking out loud.\""
msgstr "「鳶丸、思ってる事が口に出てるみたいだけど」"

#. Occurrence 2_2:1455:2350: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0020; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1455
msgctxt "text_id=2350 | speaker=tobimaru"
msgid "\"It's nothing, just color me surprised."
msgstr "「いや、それほどのショックだったってワケだ。"

#. Occurrence 2_2:1489:2351: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0021; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1489
msgctxt "text_id=2351 | speaker=tobimaru"
msgid "  Hey, Sono-G, what's this filling, anyway?\""
msgstr "　なあ草の字。これ、具はなんだ？」"

#. Occurrence 2_2:1500:2352: scene=2_2
#: 2_2:1500
msgctxt "text_id=2352 | speaker=unknown"
msgid "  It was only natural to inquire about the unexpectedly delicious bite."
msgstr "　予想外の味に思わず訊ねる。"

#. Occurrence 2_2:1505:2353: scene=2_2
#: 2_2:1505
msgctxt "text_id=2353 | speaker=unknown"
msgid "  He had been nibbling around the edges and had not yet reached its center."
msgstr "　ちなみに、鳶丸はまだ外周だけで中心たる具に辿り着いていない。"

#. Occurrence 2_2:1551:2354: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0015; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1551
msgctxt "text_id=2354 | speaker=soujuurou"
msgid "\"Oh, that would be grasshopper.\""
msgstr "「ああ、それはイナゴ」"

#. Occurrence 2_2:1564:2355: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0022; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1564
msgctxt "text_id=2355 | speaker=tobimaru"
msgid "\"No way!\""
msgstr "「ありえねえ！」"

#. Occurrence 2_2:1570:2356: scene=2_2
#: 2_2:1570
msgctxt "text_id=2356 | speaker=unknown"
msgid "  The vice president choked on his cough."
msgstr "　がは、と咳きこむ副会長。"

#. Occurrence 2_2:1575:2357: scene=2_2
#: 2_2:1575
msgctxt "text_id=2357 | speaker=unknown"
msgid "  He had assumed that Soujyuro would prefer earthy ingredients instead of seafood on account of his mountain life, but he never expected he would use grasshoppers."
msgstr "　たしかに、山奥育ちの草十郎には海の幸より山の幸のイメージがあるような、でもイナゴはないような。"

#. Occurrence 2_2:1614:2358: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0023; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1614
msgctxt "text_id=2358 | speaker=tobimaru"
msgid "\"Damn it! You should have warned me first, Soujyuro! ...But man, was that delicious!\""
msgstr "「クソ、食う前に言えよな！　信じられねえぐらい美味いと思っちまったじゃねえか！」"

#. Occurrence 2_2:1645:2359: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0016; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1645
msgctxt "text_id=2359 | speaker=soujuurou"
msgid "\"Oh. I was just joking.\""
msgstr "「ああ、今のは嘘だよ」"

#. Occurrence 2_2:1673:2360: scene=2_2
#: 2_2:1673
msgctxt "text_id=2360 | speaker=unknown"
msgid "  They locked eyes for a moment."
msgstr "　瞬間、見つめ合うふたり。"

#. Occurrence 2_2:1708:2361: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0017; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1708
msgctxt "text_id=2361 | speaker=soujuurou"
msgid "\"It's salmon. I would never eat grasshopper.\""
msgstr "「ほんとは鮭。いくらなんでも、イナゴはね」"

#. Occurrence 2_2:1723:2362: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0024; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1723
msgctxt "text_id=2362 | speaker=tobimaru"
msgid "\"O-oh, right. Yeah. I knew that."
msgstr "「―――お、おう。そうだよな、いや、安心した。"

#. Occurrence 2_2:1723:2363: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0024; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1723
msgctxt "text_id=2363 | speaker=tobimaru"
msgid "  Of course it wouldn't be grasshopper.\""
msgstr "　いくらなんでもイナゴはねえよな」"

#. Occurrence 2_2:1754:2364: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0018; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1754
msgctxt "text_id=2364 | speaker=soujuurou"
msgid "\"Yeah. I mean, you can't find fresh grasshoppers in this city to begin with.\""
msgstr "「ああ、こんな都会で身のしまったイナゴが手に入るもんか」"

#. Occurrence 2_2:1760:2365: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0025; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1760
msgctxt "text_id=2365 | speaker=tobimaru"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 2_2:1765:2366: scene=2_2
#: 2_2:1765
msgctxt "text_id=2366 | speaker=unknown"
msgid "  As curious as those words were, Tobimaru decided to let them go."
msgstr "　気になる台詞だったが、あえて鳶丸はスルーする。"

#. Occurrence 2_2:1804:2367: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0026; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1804
msgctxt "text_id=2367 | speaker=tobimaru"
msgid "\"Jeez, Soujyuro. That's not something to joke about. You want me to hurl or something?\""
msgstr "「……ったく。どっちにしても冗談きついぜ。あやうくはき出すところだったじゃねえか。らしくねえぞ、草十郎」"

#. Occurrence 2_2:1810:2368: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0019; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1810
msgctxt "text_id=2368 | speaker=soujuurou"
msgid "\"Don't say bad things about Aozaki then.\""
msgstr "「君が蒼崎の悪口を言うからだ」"

#. Occurrence 2_2:1852:2369: scene=2_2
#: 2_2:1852
msgctxt "text_id=2369 | speaker=unknown"
msgid "  Soujyuro closed his eyes as he continued to chew on his rice ball."
msgstr "　瞼を閉じ、不機嫌そうに握り飯を食べながら草十郎はそう言った。たしかに言った。"

#. Occurrence 2_2:1857:2370: scene=2_2
#: 2_2:1857
msgctxt "text_id=2370 | speaker=unknown"
msgid "  Tobimaru watched incredulously as Soujyuro made no attempt to hide his disapproval."
msgstr "　不満そうにもぐもぐ口を動かす草十郎を、鳶丸は<唖然|あぜん>と見つめる。"

#. Occurrence 2_2:1895:2371: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0027; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1895
msgctxt "text_id=2371 | speaker=tobimaru"
msgid "\"Okay, that I can't let go. You're really saying you were taking revenge for Aozaki?\""
msgstr "「―――おい。今のはさすがに聞き捨てならねえぞ。俺が蒼崎の悪口を言ったから<意趣返|いしゅがえ>しをしたと、そういうコトか？」"

#. Occurrence 2_2:1927:2372: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0020; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1927
msgctxt "text_id=2372 | speaker=soujuurou"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 2_2:1933:2373: scene=2_2
#: 2_2:1933
msgctxt "text_id=2373 | speaker=unknown"
msgid "  Soujyuro continued chewing."
msgstr "　もぐもぐもぐ。"

#. Occurrence 2_2:1938:2374: scene=2_2
#: 2_2:1938
msgctxt "text_id=2374 | speaker=unknown"
msgid "  The country boy's silent protest said all that needed to be said."
msgstr "　純朴な田舎少年の無言の抗議は、ますます真実味を増していく。"

#. Occurrence 2_2:1981:2375: scene=2_2
#: 2_2:1981
msgctxt "text_id=2375 | speaker=unknown"
msgid "  The vice president suddenly looked like he had been struck by lightning."
msgstr "　間違いない、なんという悲劇、と副会長は落雷を受けたかのような頭痛にもだえた。"

#. Occurrence 2_2:2012:2376: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0028; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2012
msgctxt "text_id=2376 | speaker=tobimaru"
msgid "\"What the... Don't tell me you've fallen for Aozaki!"
msgstr "「なんてこった。おまえ、まさか蒼崎に惚れてんのか？"

#. Occurrence 2_2:2031:2377: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0029; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2031
msgctxt "text_id=2377 | speaker=tobimaru"
msgid "  You have, haven't you? ...Hey! I asked you a question, dammit!\""
msgstr "　そうなのか？　そうなんだな!?　おい、眠ってねえで起きろ！」"

#. Occurrence 2_2:2078:2378: scene=2_2
#: 2_2:2078
msgctxt "text_id=2378 | speaker=unknown"
msgid "  Tobimaru flew out of his chair and violently shook Soujyuro by the shoulders."
msgstr "　椅子から立ち上がり、草十郎の両肩を激しくシェイクする鳶丸。"

#. Occurrence 2_2:2089:2379: scene=2_2
#: 2_2:2089
msgctxt "text_id=2379 | speaker=unknown"
msgid "  Soujyuro opened his eyes."
msgstr "　仕方なく、むっとした顔で草十郎は目を開けた。"

#. Occurrence 2_2:2129:2380: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0030; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2129
msgctxt "text_id=2380 | speaker=tobimaru"
msgid "\"I forgot. You don't know about what happened a year ago..."
msgstr "「そうか……おまえは一年前の惨劇を知らないんだな。"

#. Occurrence 2_2:2135:2381: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0031; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2135
msgctxt "text_id=2381 | speaker=tobimaru"
msgid "  'Cause if you did, you wouldn't be treading down this path of destruction, my friend.\""
msgstr "　知ってりゃ、そんなストレートな破滅願望を持つ事もなかったろうに」"

#. Occurrence 2_2:2156:2382: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0021; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:2156
msgctxt "text_id=2382 | speaker=soujuurou"
msgid "\"You've got it all wrong, but that's okay. Tell me what happened a year ago first.\""
msgstr "「……君の言葉には誤解が含まれてるけど、それは後にする。それより、一年前の惨劇って？」"

#. Occurrence 2_2:2176:2383: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0032; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2176
msgctxt "text_id=2383 | speaker=tobimaru"
msgid "\"...Hmph.\""
msgstr "「―――む」"

#. Occurrence 2_2:2232:2384: scene=2_2
#: 2_2:2232
msgctxt "text_id=2384 | speaker=unknown"
msgid "  Tobimaru regained his composure and sat down after a moment's thought."
msgstr "　鳶丸はハッと我に返り、どうしたものかと考えたあげく、どすんと椅子に座る。"

#. Occurrence 2_2:2244:2385: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0033; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2244
msgctxt "text_id=2385 | speaker=tobimaru"
msgid "\"Okay. I'm not one to gossip, but for you I'm making an exception.\""
msgstr "「仕方ねえ。この手の噂をするのは好きじゃねえんだけどな」"

#. Occurrence 2_2:2250:2386: scene=2_2
#: 2_2:2250
msgctxt "text_id=2386 | speaker=unknown"
msgid "  Tobimaru reassured himself that it was in Soujyuro's best interests as a young man to know."
msgstr "　しかしそれも青少年の輝かしい未来のためだ、と鳶丸は自己肯定した。"

#. Occurrence 2_2:2294:2387: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0034; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2294
msgctxt "text_id=2387 | speaker=tobimaru"
msgid "\"It went down when Aozaki was a freshman."
msgstr "「あれは蒼崎がまだ一年の頃の話だ。"

#. Occurrence 2_2:2336:2388: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0035; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2336
msgctxt "text_id=2388 | speaker=tobimaru"
msgid "  Everybody was new to high school, so nobody knew what anyone was like yet, her included."
msgstr "　あの頃はみんな入学したばっかりで、蒼崎がどんな性格か誰も知らなかった。"

#. Occurrence 2_2:2353:2389: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0036; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2353
msgctxt "text_id=2389 | speaker=tobimaru"
msgid "  She was a total babe. I mean just look at her!"
msgstr "　あいつ、外見は文句なしに美人だからな。"

#. Occurrence 2_2:2359:2390: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0037; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2359
msgctxt "text_id=2390 | speaker=tobimaru"
msgid "  All the guys were crazy for her.\""
msgstr "　そりゃあ男どもは狂喜乱舞したもんさ」"

#. Occurrence 2_2:2376:2391: scene=2_2
#: 2_2:2376
msgctxt "text_id=2391 | speaker=unknown"
msgid "  Little did they know that soon after they would go crazy for an entirely different reason."
msgstr "　そして、後に違った意味で狂喜乱舞する事になるとは、誰ひとり夢にも思わなかったのである。"

#. Occurrence 2_2:2416:2392: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0038; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2416
msgctxt "text_id=2392 | speaker=tobimaru"
msgid "\"The first couple of months, the school descended into chaos."
msgstr "「四月、五月はもう上を下への大騒ぎでよ。"

#. Occurrence 2_2:2422:2393: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0039; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2422
msgctxt "text_id=2393 | speaker=tobimaru"
msgid "  You gotta remember, that early on in the year, no one cared about class hierarchy."
msgstr "　あの時ばかりは上級生も下級生もなかったな。"

#. Occurrence 2_2:2428:2394: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0040; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2428
msgctxt "text_id=2394 | speaker=tobimaru"
msgid "  So tons of guys were fighting themselves over her, it was insane. Just getting anywhere near Aozaki was next to impossible.\""
msgstr "　野郎同士の牽制、共闘、はては決闘まで、まあよくも騒いだもんさ。蒼崎に近寄るだけでも大変だったんだぜ？」"

#. Occurrence 2_2:2464:2395: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0022; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:2464
msgctxt "text_id=2395 | speaker=soujuurou"
msgid "\"I don't understand. Why would that happen?\""
msgstr "「？　なんでそんなよく分からない事態になるんだ？」"

#. Occurrence 2_2:2502:2396: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0041; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2502
msgctxt "text_id=2396 | speaker=tobimaru"
msgid "\"'Cause that's what happens when a hundred guys like the same girl, duh."
msgstr "「そりゃ蒼崎はひとりきり、命知らずな野郎はのべ百人ほどいたからだよ。"

#. Occurrence 2_2:2508:2397: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0042; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2508
msgctxt "text_id=2397 | speaker=tobimaru"
msgid "  It would have taken Aozaki three months just to have lunch with them all individually."
msgstr "　ひとりひとり蒼崎とランチしても三ヶ月かかるだろ？"

#. Occurrence 2_2:2519:2398: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0043; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2519
msgctxt "text_id=2398 | speaker=tobimaru"
msgid "  So people decided to fight over who got to ask her out.\""
msgstr "　だから、まずは男同士でつまんねえ暗闘があったのさ」"

#. Occurrence 2_2:2550:2399: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0023; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:2550
msgctxt "text_id=2399 | speaker=soujuurou"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence 2_2:2556:2400: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0044; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2556
msgctxt "text_id=2400 | speaker=tobimaru"
msgid "\"They were all a bunch of losers if you ask me. But what happened next is the juicy part.\""
msgstr "「ま、いい。分からねえんならそこは飛ばそう。<所詮|しょせん>負け犬どもの話だしな、本筋にはなりえねえ」"

#. Occurrence 2_2:2613:2401: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0045; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2613
msgctxt "text_id=2401 | speaker=tobimaru"
msgid "\"Those who emerged from the conflict unscathed made their move..."
msgstr "「でな。そんなどうでもいい戦いを勝ち残ったヤツらは列なして一年の女に言い寄ったワケだ。"

#. Occurrence 2_2:2619:2402: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0046; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2619
msgctxt "text_id=2402 | speaker=tobimaru"
msgid "  And though she might not seem like it, she's the type who likes to put a guy down lightly, you know, because of their sincerity or courage or whatever."
msgstr "　蒼崎はアレでなんていうか、相手のなけなしの誠意？　じゃなくてアレか、勇気？　そういうの、無視できずに認めちまうヤツだからな。"

#. Occurrence 2_2:2625:2403: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0047; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2625
msgctxt "text_id=2403 | speaker=tobimaru"
msgid "  At any rate, she rejected all comers as politely as she could.\""
msgstr "　言い寄ってくる相手を可能なかぎり丁寧に断ってた」"

#. Occurrence 2_2:2670:2404: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0048; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2670
msgctxt "text_id=2404 | speaker=tobimaru"
msgid "\"But there was one guy who couldn't take a hint."
msgstr "「が、中にはそれで勘違いしちまう奴もいてよ。"

#. Occurrence 2_2:2676:2405: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0049; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2676
msgctxt "text_id=2405 | speaker=tobimaru"
msgid "  He was a third-year who just refused to give up."
msgstr "　三年のある野郎がこれは脈アリと見て蒼崎に何度も言い寄ったんだよ。"

#. Occurrence 2_2:2682:2406: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0050; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2682
msgctxt "text_id=2406 | speaker=tobimaru"
msgid "  ...Maybe he was a little bit nuts. It's hard to see it any other way at this point.\""
msgstr "　……たぶん、そいつ頭がおかしかったんだ。今にして思うと、そうとしか思えん」"

#. Occurrence 2_2:2688:2407: scene=2_2
#: 2_2:2688
msgctxt "text_id=2407 | speaker=unknown"
msgid "  Incidentally, Tobimaru decided to gloss over the fact that this student was also the former student council president."
msgstr "　ちなみに、その三年生とやらが前期の生徒会長である事を、鳶丸は秘する事にした。"

#. Occurrence 2_2:2739:2408: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0051; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2739
msgctxt "text_id=2408 | speaker=tobimaru"
msgid "\"But he didn't keep it up only at school. Later he started following her home."
msgstr "「学園ばかりか蒼崎の家まで押しかけたそうでな。"

msgctxt "text_id=2409 | speaker=unknown"
msgid " That must have been the last straw, because Aozaki wigged out. She sent him packing in ways I'm not comfortable repeating out loud.\""
msgstr "あまりにしつこいんで蒼崎も堪忍袋の緒が切れたんだろう。ちょっと、口にするのは<憚|はばか>られる方法でふったんだよ」"

#. Occurrence 2_2:2816:2410: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0052; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2816
msgctxt "text_id=2410 | speaker=tobimaru"
msgid "\"The conclusion? The student didn't just request a transfer, he tucked tail and left Misaki completely. Aozaki was sentenced to a month of house arrest."
msgstr "「結果、そいつは自分から他校に転入希望したばかりか三咲町からも逃げ出しちまって、蒼崎も一ヶ月ばかり自宅謹慎を食らった。"

#. Occurrence 2_2:2822:2411: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0053; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2822
msgctxt "text_id=2411 | speaker=tobimaru"
msgid "  It came to be known as the Bloody Town Hall Incident."
msgstr "　世に言う血の公会堂事件だ。"

#. Occurrence 2_2:2828:2412: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0054; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2828
msgctxt "text_id=2412 | speaker=tobimaru"
msgid "  She could tell you more about it than I can... but I wouldn't recommend asking her. Ask the school newspaper editor instead. She loves a bit of gossip.\""
msgstr "　詳しく知りたけりゃ本人………はまずいな、新聞部にでもいけ。あそこの部長は命知らずだから、訊けば面白がって教えてくれる」"

#. Occurrence 2_2:2895:2413: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0024; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:2895
msgctxt "text_id=2413 | speaker=soujuurou"
msgid "\"Tobimaru. I get the feeling you're not telling me everything.\""
msgstr "「……鳶丸。その、具体的な表現を故意に避けてないか？」"

#. Occurrence 2_2:2919:2414: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0055; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2919
msgctxt "text_id=2414 | speaker=tobimaru"
msgid "\"Hey, you'd do the same if you were me. I may be the board chairman's son and all, but some things scare even me, and I wanna graduate in one piece."
msgstr "「仕方ねえだろ。理事長の息子だろうが何だろうが怖いものは怖ぇし、高校ぐらいは無事卒業しとかねえとな。"

#. Occurrence 2_2:2930:2415: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0056; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2930
msgctxt "text_id=2415 | speaker=tobimaru"
msgid "  You want me to freak out every time I see a girl in a school uniform?\""
msgstr "　うちの女子の制服みるたびに奇声をあげるトラウマなんて持ちたくねえよ」"

#. Occurrence 2_2:2977:2416: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0025; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:2977
msgctxt "text_id=2416 | speaker=soujuurou"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 2_2:2983:2417: scene=2_2
#: 2_2:2983
msgctxt "text_id=2417 | speaker=unknown"
msgid "  Soujyuro tilted his head to the side in confusion."
msgstr "　むう、と納得いかなげに首をかしげる草十郎。"

#. Occurrence 2_2:2988:2418: scene=2_2
#: 2_2:2988
msgctxt "text_id=2418 | speaker=unknown"
msgid "  Tobimaru had lost him with that comment."
msgstr "　鳶丸の言わんとするところが、彼にはさっぱり分からない。"

#. Occurrence 2_2:3032:2419: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0057; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3032
msgctxt "text_id=2419 | speaker=tobimaru"
msgid "\"Well, whatever."
msgstr "「まあいい。"

#. Occurrence 2_2:3038:2420: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0058; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3038
msgctxt "text_id=2420 | speaker=tobimaru"
msgid "  What is it about Aozaki that you like anyway?\""
msgstr "　それより、なんで蒼崎なんかがいいんだよ、草十郎」"

#. Occurrence 2_2:3066:2421: scene=2_2
#: 2_2:3066
msgctxt "text_id=2421 | speaker=unknown"
msgid "  He tilted his head again, this time to the other side."
msgstr "　言われて、今度は逆の方向に、はて、と草十郎は首をかしげた。"

#. Occurrence 2_2:3093:2422: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0059; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3093
msgctxt "text_id=2422 | speaker=tobimaru"
msgid "\"Whoa. Are you really that hot for her?"
msgstr "「おい。おまえ、本当に蒼崎が好きなのか？"

#. Occurrence 2_2:3099:2423: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0060; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3099
msgctxt "text_id=2423 | speaker=tobimaru"
msgid "  'Cause if your heart pounds in her presence, that could be caused by fear, you know. Tell me you aren't stupid enough to like her for no good reason.\""
msgstr "　たんに胸がドキドキいってるだけなら、それは恋じゃなくて恐怖だってオチもあるぜ。いくら草の字がぼんやりでも理由ってもんがあるだろ？」"

#. Occurrence 2_2:3105:2424: scene=2_2
#: 2_2:3105
msgctxt "text_id=2424 | speaker=unknown"
msgid "  He tilted his head even further."
msgstr "　草十郎はさらに首をかしげる。"

#. Occurrence 2_2:3152:2425: scene=2_2
#: 2_2:3152
msgctxt "text_id=2425 | speaker=unknown"
msgid "  What Tobimaru was saying sounded off, but Soujyuro decided not to press the matter."
msgstr "　鳶丸の言い分には<語弊|ごへい>があるが、とりあえず今はそれを抜きにするとして。"

#. Occurrence 2_2:3157:2426: scene=2_2
#: 2_2:3157
msgctxt "text_id=2426 | speaker=unknown"
msgid "  All the more because he found many of his own emotions towards Aoko Aozaki to be incomprehensible."
msgstr "　草十郎自身、蒼崎青子に抱く感情には理解できないものが多すぎた。"

#. Occurrence 2_2:3183:2427: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0026; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3183
msgctxt "text_id=2427 | speaker=soujuurou"
msgid "\"It is kind of strange, to be honest. I don't even know her that well.\""
msgstr "「そうだな、おかしい。俺は、あまり彼女を知らないのにね」"

#. Occurrence 2_2:3206:2428: scene=2_2
#: 2_2:3206
msgctxt "text_id=2428 | speaker=unknown"
msgid "  That was because they had not truly spoken to each other since the day she showed him around."
msgstr "　それもその筈、創立記念日の案内以来、学園内において草十郎と青子は一度も話していないのだ。"

#. Occurrence 2_2:3211:2429: scene=2_2
#: 2_2:3211
msgctxt "text_id=2429 | speaker=unknown"
msgid "  Every time Soujyuro tried to talk to her, she immediately got up and left."
msgstr "　草十郎が話し掛けようとすると青子は素早く立ち去ってしまう。"

#. Occurrence 2_2:3216:2430: scene=2_2
#: 2_2:3216
msgctxt "text_id=2430 | speaker=unknown"
msgid "  As fate would have it, they ended up working together that recent Sunday, but made only idle chatter on the way and back."
msgstr "　この間の日曜日には縁あって労働を共にしたが、あれだって往復時間に軽く話した程度である。"

#. Occurrence 2_2:3257:2431: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0027; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3257
msgctxt "text_id=2431 | speaker=soujuurou"
msgid "\"There's something you don't know, either, Tobimaru."
msgstr "「けど鳶丸、君は知らないだけなんだ。"

#. Occurrence 2_2:3263:2432: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0028; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3263
msgctxt "text_id=2432 | speaker=soujuurou"
msgid "  Sometimes I feel someone's gaze on me, and when I turn around to see who it is, she's there, looking like she's worried about me, that I'll mess up."
msgstr "　時々なんだが、誰かの視線を感じて振り返ってみると、いつ失敗するかを心配して見ている人がいる。"

#. Occurrence 2_2:3269:2433: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0029; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3269
msgctxt "text_id=2433 | speaker=soujuurou"
msgid "  I know what you'll say-she just happened to see me in the hallway and was keeping an eye on me. Maybe she secretly wishes she could ignore me when we pass each other."
msgstr "　鳶丸の言うとおり、ただ廊下で俺を見かけて、たんに監視していただけなのかも知れない。本当は俺の事なんて気にせず素通りしたいのかも知れない。"

#. Occurrence 2_2:3275:2434: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0030; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3275
msgctxt "text_id=2434 | speaker=soujuurou"
msgid "  But whatever the reason, I believe her concern is genuine.\""
msgstr "　けど、どんな種類であれ彼女の心配は本物だ」"

#. Occurrence 2_2:3333:2435: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0031; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3333
msgctxt "text_id=2435 | speaker=soujuurou"
msgid "\"And that's the most important thing about all this."
msgstr "「それに、ここが一番大事だと思うんだけど。"

#. Occurrence 2_2:3339:2436: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0032; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3339
msgctxt "text_id=2436 | speaker=soujuurou"
msgid "  I believe that nature of hers has helped me out repeatedly.\""
msgstr "　実際の話、蒼崎のそういうところのおかげで、俺は助かっていたりするんだ」"

#. Occurrence 2_2:3384:2437: scene=2_2
#: 2_2:3384
msgctxt "text_id=2437 | speaker=unknown"
msgid "  His tone was measured and sincere."
msgstr "　何の気負いもなく、真剣に彼は言った。"

#. Occurrence 2_2:3389:2438: scene=2_2
#: 2_2:3389
msgctxt "text_id=2438 | speaker=unknown"
msgid "  Tobimaru sighed with a tinge of regret."
msgstr "　それを聞いた鳶丸は軽い後悔と共に、ため息などをこぼしてしまう。"

#. Occurrence 2_2:3415:2439: scene=2_2
#: 2_2:3415
msgctxt "text_id=2439 | speaker=unknown"
msgid "  If not for those words, he could have introduced Soujyuro to a more suitable girl with whom he could have lived out the rest of his school days in peace."
msgstr "　今の台詞さえ聞かなければ適当な女生徒を紹介して、草十郎が平穏な高校生活を送れるよう段取っただろうに。"

#. Occurrence 2_2:3433:2440: scene=2_2
#: 2_2:3433
msgctxt "text_id=2440 | speaker=unknown"
msgid "  He never went to such lengths for his other friends."
msgstr "　本来、彼がそこまで男友達のために骨折るコトはない。"

#. Occurrence 2_2:3438:2441: scene=2_2
#: 2_2:3438
msgctxt "text_id=2441 | speaker=unknown"
msgid "  Generally speaking, if it was of some benefit to him, he was unafraid of exploiting another."
msgstr "　利用できる相手なら損得のために騙しあい、助け合う。"

#. Occurrence 2_2:3443:2442: scene=2_2
#: 2_2:3443
msgctxt "text_id=2442 | speaker=unknown"
msgid "  If they were of no use, he didn't bother getting involved with them. That was how Tobimaru Tsukiji operated."
msgstr "　利用できない人間は、そも利用するべきではないと判断して距離を置くのが槻司鳶丸の信念だ。"

#. Occurrence 2_2:3448:2443: scene=2_2
#: 2_2:3448
msgctxt "text_id=2443 | speaker=unknown"
msgid "  Soujyuro happened to be the type of person who provided no benefit to Tobimaru, yet somehow sparked in him a desire to help."
msgstr "　そんな彼をして、静希草十郎は益を得る相手ではないクセに、手を貸したくなる人種だった。"

#. Occurrence 2_2:3512:2444: scene=2_2
#: 2_2:3512
msgctxt "text_id=2444 | speaker=unknown"
msgid "  It was not that friendship was completely alien to him."
msgstr "　彼は友情には<疎|うと>くなかったが、"

#. Occurrence 2_2:3517:2445: scene=2_2
#: 2_2:3517
msgctxt "text_id=2445 | speaker=unknown"
msgid "  He just did not have many people he felt that close to."
msgstr "　友人と呼べる人物にはそう恵まれていなかった。"

#. Occurrence 2_2:3523:2446: scene=2_2
#: 2_2:3523
msgctxt "text_id=2446 | speaker=unknown"
msgid "  So if Soujyuro had really fallen for Aoko, it was not his place, as a friend, to try to change his mind."
msgstr "　……なので、草十郎が本気で青子に惚れているのなら、友人として、それを改めさせる野暮はできなかった。"

#. Occurrence 2_2:3576:2447: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0061; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3576
msgctxt "text_id=2447 | speaker=tobimaru"
msgid "\"Ugh, well, I guess it's true that love knows no reason.\""
msgstr "「……やれやれ。結局、惚れてる奴にゃあ理由なんていらねえんだな」"

#. Occurrence 2_2:3589:2448: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0033; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3589
msgctxt "text_id=2448 | speaker=soujuurou"
msgid "\"I wouldn't say there's no reason for it. I can think of one at least."
msgstr "「そんな事はない。理由ならひとつある。"

#. Occurrence 2_2:3589:2449: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0033; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3589
msgctxt "text_id=2449 | speaker=soujuurou"
msgid "  I thought she was beautiful the moment I first laid eyes on her.\""
msgstr "　彼女を<一目|ひとめ>みた時に、綺麗だなって思ったぞ」"

#. Occurrence 2_2:3601:2450: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0062; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3601
msgctxt "text_id=2450 | speaker=tobimaru"
msgid "\"Uh.\""
msgstr "「あ？」"

#. Occurrence 2_2:3606:2451: scene=2_2
#: 2_2:3606
msgctxt "text_id=2451 | speaker=unknown"
msgid "  Tobimaru's shoulders slumped."
msgstr "　がくん、と肩を落とす鳶丸。"

#. Occurrence 2_2:3641:2452: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0063; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3641
msgctxt "text_id=2452 | speaker=tobimaru"
msgid "\"After all that, you just like her for her looks? Listen to yourself, Soujyuro!\""
msgstr "「なんだぁ!?　あんだけ恥ずかしい台詞いっといて、要は外見に惚れてますだあ？　結局見てくれかよ草十郎！」"

#. Occurrence 2_2:3647:2453: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0034; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3647
msgctxt "text_id=2453 | speaker=soujuurou"
msgid "\"What's wrong with appreciating beauty?"
msgstr "「綺麗なものに見惚れるのは、いいことじゃないのか？"

#. Occurrence 2_2:3653:2454: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0035; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3653
msgctxt "text_id=2454 | speaker=soujuurou"
msgid "  I don't think there is anything wrong with judging someone by the physical appearance they worked hard to create.\""
msgstr "　自分を綺麗に見せる努力をしているんだから、外見から内面を判断するのは、そんなおかしな話じゃないと思う」"

#. Occurrence 2_2:3674:2455: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0064; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3674
msgctxt "text_id=2455 | speaker=tobimaru"
msgid "\"Hrm.\""
msgstr "「む」"

#. Occurrence 2_2:3679:2456: scene=2_2
#: 2_2:3679
msgctxt "text_id=2456 | speaker=unknown"
msgid "  That sounded like a sophism to Tobimaru, but he had no counterpoint to offer."
msgstr "　詭弁のようではあるが、なんとなく正論のような気もする。"

#. Occurrence 2_2:3706:2457: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0065; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3706
msgctxt "text_id=2457 | speaker=tobimaru"
msgid "\"All right. I get it. I'll let it go. It's none of my business who you go after anyway.\""
msgstr "「……しょうがねえ、分かったよ。この話はもう止めよう。草の字が誰を<自分|テメエ>の女にするか、俺の知った事じゃねえし」"

#. Occurrence 2_2:3747:2458: scene=2_2
#: 2_2:3747
msgctxt "text_id=2458 | speaker=unknown"
msgid "  Now..."
msgstr "　さて。"

#. Occurrence 2_2:3752:2459: scene=2_2
#: 2_2:3752
msgctxt "text_id=2459 | speaker=unknown"
msgid "  Tobimaru was mistaken about one major point during this whole conversation."
msgstr "　ここで、鳶丸はひとつ、大きな勘違いをしていた。"

#. Occurrence 2_2:3757:2460: scene=2_2
#: 2_2:3757
msgctxt "text_id=2460 | speaker=unknown"
msgid "  Namely, that Soujyuro was not head-over-heels in love with Aoko and hoped to go steady with her. He merely liked her as a person."
msgstr "　静希草十郎は蒼崎青子に好意を持っているだけであって、別に、心の底から好きだとか、恋人として付き合いたいなんて願望は、むしろ一片も無かった、という点である。"

#. Occurrence 2_2:3763:2461: scene=2_2
#: 2_2:3763
msgctxt "text_id=2461 | speaker=unknown"
msgid "  Nobody could have foreseen the massive calamity that would be caused by this simple misunderstanding."
msgstr "　この勘違いが後に大きな禍根となるコトを、神ならざる彼らが気付くよしもない。"

#. Occurrence 2_2:3803:2462: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0066; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3803
msgctxt "text_id=2462 | speaker=tobimaru"
msgid "\"I've just got one piece of advice for you, Soujyuro."
msgstr "「だがよ、ひとつだけ忠告しておくぜ草十郎。"

#. Occurrence 2_2:3810:2463: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0067_0; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3810
msgctxt "text_id=2463 | speaker=tobimaru"
msgid "  Just because Aozaki fights with someone doesn't mean she hates them, and just because she's nice to someone doesn't mean she likes them."
msgstr "蒼崎はケンカをした相手だろうと別に嫌うワケじゃない。逆に言えば、親切にしたって別に好かれるワケでもない。"

#. Occurrence 2_2:3824:2464: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0067_1; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3824
msgctxt "text_id=2464 | speaker=tobimaru"
msgid " I'm a prime example of that.\""
msgstr "いい例が俺だ」"

#. Occurrence 2_2:3830:2465: scene=2_2
#: 2_2:3830
msgctxt "text_id=2465 | speaker=unknown"
msgid "  He spoke with a pained sigh as if opening old wounds from the past."
msgstr "　過去の傷心を思いだしたのか、鳶丸は重いため息とともに語る。"

#. Occurrence 2_2:3879:2466: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0036; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3879
msgctxt "text_id=2466 | speaker=soujuurou"
msgid "\"I see."
msgstr "「そうか、"

msgctxt "text_id=2467 | speaker=unknown"
msgid " What happened?\""
msgstr "詳しく」"

#. Occurrence 2_2:3924:2468: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0068; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3924
msgctxt "text_id=2468 | speaker=tobimaru"
msgid "\"Long story short, she used to be really full of herself, and I once tried to hit her."
msgstr "「おう。昔な、あいつがあんまりに独善的だったんでつい手をあげかけちまった事がある。"

#. Occurrence 2_2:3930:2469: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0069; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3930
msgctxt "text_id=2469 | speaker=tobimaru"
msgid "  It happened last summer. I'd already been working with her in the student council for a year at that point and saw her more like a fellow soldier in the trenches than as a girl."
msgstr "　半年前の夏だ。一年もあいつと生徒会やってたもんだから、俺も女っつーより戦友って気になっててな。"

#. Occurrence 2_2:3936:2470: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0070; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3936
msgctxt "text_id=2470 | speaker=tobimaru"
msgid "  One day, I lost my temper and I took a swing at her. I like to think I've got a mean right hook, and I slugged her pretty good, so I thought I won that round.\""
msgstr "　つい勢いで平手打ちをしようと右手をあげた。―――我ながら四番<打者|バッター>もかくやという腰のひねり。たしかな実感とともに、俺は勝利を確信したもんさ」"

#. Occurrence 2_2:3970:2471: scene=2_2
#: 2_2:3970
msgctxt "text_id=2471 | speaker=unknown"
msgid "  He had a distant look in his eyes as his words trailed off."
msgstr "　ふっ、と遠い目をする彼は、その後の<顛末|てんまつ>を話そうとはしなかった。"

#. Occurrence 2_2:4017:2472: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0071; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:4017
msgctxt "text_id=2472 | speaker=tobimaru"
msgid "\"The next day, when I came to the student council room, I thought she'd be spoiling for a fight, but she was the same as always."
msgstr "「翌日になって、こりゃあ完全に敵扱いされたな、と覚悟して生徒会室にいってみりゃあ、蒼崎はいつも通りだった。"

#. Occurrence 2_2:4023:2473: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0072; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:4023
msgctxt "text_id=2473 | speaker=tobimaru"
msgid "  And since then, we've simply continued working together as president and vice president.\""
msgstr "　で、以来あいつと俺は会長と副会長で納まってる」"

#. Occurrence 2_2:4070:2474: scene=2_2
#: 2_2:4070
msgctxt "text_id=2474 | speaker=unknown"
msgid "  Soujyuro sighed at his story."
msgstr "　話を聞き終わり、ふーん、と感想を漏らす草十郎。"

#. Occurrence 2_2:4075:2475: scene=2_2
#: 2_2:4075
msgctxt "text_id=2475 | speaker=unknown"
msgid "  He then said, with absolute confidence,"
msgstr "　そうして自信を持って、"

#. Occurrence 2_2:4109:2476: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0037; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:4109
msgctxt "text_id=2476 | speaker=soujuurou"
msgid "\"So, you just wanted to brag about how close you two are?\""
msgstr "「いまの話を総合すると、君はたんに<惚気|のろけ>たいのか？」"

#. Occurrence 2_2:4115:2477: scene=2_2
#: 2_2:4115
msgctxt "text_id=2477 | speaker=unknown"
msgid "  Clearly, he had missed the point entirely."
msgstr "　真顔で、まったく分かってない感想を口にするのだった。"

#. Occurrence 2_2:4171:2478: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0073; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:4171
msgctxt "text_id=2478 | speaker=tobimaru"
msgid "\"Are you kidding me!?  "
msgstr "「んなワケあるかぁ！！！！　"

msgctxt "text_id=2479 | speaker=unknown"
msgid " How in the hell do you come to that conclusion after hearing a story like that!?"
msgstr "いまの話のどこに甘ずっぱい要素があんだよ！？"

#. Occurrence 2_2:4185:2480: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0074; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:4185
msgctxt "text_id=2480 | speaker=tobimaru"
msgid "  "
msgstr "　"

msgctxt "text_id=2481 | speaker=unknown"
msgid "I'm telling you that from that day forward I could never see her again as a woman!\""
msgstr "俺としちゃあ、あいつを女として見なくなった決定的な事件だったんだがねぇ！？」"

#. Occurrence 2_2:4199:2482: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0038; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:4199
msgctxt "text_id=2482 | speaker=soujuurou"
msgid "\"Oh, I was mistaken?\""
msgstr "「なんだ、違うのか」"

#. Occurrence 2_2:4227:2483: scene=2_2
#: 2_2:4227
msgctxt "text_id=2483 | speaker=unknown"
msgid "  A look of disappointment flittered across Soujyuro's face. "
msgstr "　もったいない、と不満そうに漏らす草十郎。"

#. Occurrence 2_2:4232:2484: scene=2_2
#: 2_2:4232
msgctxt "text_id=2484 | speaker=unknown"
msgid "  Tobimaru revised his opinion: Soujyuro was something of a simpleton, but there was a quality to him that Tobimaru could not quite place."
msgstr "　……この男、単純のようで底が知れぬのかも、と鳶丸は考えを改めた。"

#. Occurrence 2_2:4281:2485: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0075; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:4281
msgctxt "text_id=2485 | speaker=tobimaru"
msgid "\"Just take it from me―her standards are anything but normal."
msgstr "「とにかくだ。俺が言いたいのは、蒼崎青子の“好き嫌いの基準”ってのは普通じゃないって事だ。"

#. Occurrence 2_2:4287:2486: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0076; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:4287
msgctxt "text_id=2486 | speaker=tobimaru"
msgid "  She won't like you for being nice to her, and she won't hate you for being mean to her. That's the kind of princess she is.\""
msgstr "いいコトをすれば好かれる、気に入らないコトをすれば嫌われる、ってワケじゃねえんだよ、あのお姫さまは」"

#. Occurrence 2_2:4306:2487: scene=2_2
#: 2_2:4306
msgctxt "text_id=2487 | speaker=unknown"
msgid "  Soujyuro answered that he would keep it in mind, as he looked to the clock."
msgstr "　参考にするよ、と答えて草十郎は時計を見る。"

#. Occurrence 2_2:4311:2488: scene=2_2
#: 2_2:4311
msgctxt "text_id=2488 | speaker=unknown"
msgid "  They had been talking for a while, and lunch was almost over."
msgstr "　長話がすぎたらしい。昼休みは残り少なくなっていた。"

#. Occurrence 2_2:4332:2489: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0039; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:4332
msgctxt "text_id=2489 | speaker=soujuurou"
msgid "\"Is there anything else you wanted to discuss?\""
msgstr "「もう君からの話はないか？」"

#. Occurrence 2_2:4338:2490: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0077; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:4338
msgctxt "text_id=2490 | speaker=tobimaru"
msgid "\"Huh? I didn't have anything to discuss in the first place.\""
msgstr "「あ？　はじめからねえよ、そんなの」"

#. Occurrence 2_2:4359:2491: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0040; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:4359
msgctxt "text_id=2491 | speaker=soujuurou"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 2_2:4365:2492: scene=2_2
#: 2_2:4365
msgctxt "text_id=2492 | speaker=unknown"
msgid "  Why had Tobimaru even brought him here in the first place? Soujyuro tilted his head in wonder but shook it off to deal with the more pressing matters at hand."
msgstr "　なら何故この男は自分をここに連れこんだのだろう？　と首をかしげる草十郎だったが、今は他に本題がある。"

#. Occurrence 2_2:4406:2493: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0041; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:4406
msgctxt "text_id=2493 | speaker=soujuurou"
msgid "\"Could you stay a little longer?"
msgstr "「よし。じゃあもう少し付きあってくれ。"

#. Occurrence 2_2:4406:2494: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0041; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:4406
msgctxt "text_id=2494 | speaker=soujuurou"
msgid "  There's something I wanted to ask you.\""
msgstr "　鳶丸に訊きたいことがあったんだ」"

#. Occurrence 2_2:4412:2495: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0078; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:4412
msgctxt "text_id=2495 | speaker=tobimaru"
msgid "\"?\""
msgstr "「？」"

#. Occurrence 2_2:4451:2496: scene=2_2
#: 2_2:4451
msgctxt "text_id=2496 | speaker=unknown"
msgid "  Tobimaru sat up straight, having never seen Soujyuro's face look so serious before."
msgstr "　今までにない真剣な表情の草十郎に、思わず姿勢を正す鳶丸。"

#. Occurrence 2_2:4456:2497: scene=2_2
#: 2_2:4456
msgctxt "text_id=2497 | speaker=unknown"
msgid "  Soujyuro set aside his rice ball and cleared his throat."
msgstr "　食べかけのおにぎりもそのままに、ゴホン、と草十郎は咳払いをする。"

#. Occurrence 2_2:4505:2498: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0042; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:4505
msgctxt "text_id=2498 | speaker=soujuurou"
msgid "\"It's about something that happened yesterday.\""
msgstr "「―――実は昨日、こんなコトがあって……」"

#. Occurrence 2_2:4511:2499: scene=2_2
#: 2_2:4511
msgctxt "text_id=2499 | speaker=unknown"
msgid "  He spoke solemnly."
msgstr "　語りだしは厳かに。"

#. Occurrence 2_2:4516:2500: scene=2_2
#: 2_2:4516
msgctxt "text_id=2500 | speaker=unknown"
msgid "  And as carefully as possible, he recounted what had occurred the night before..."
msgstr "　草十郎はできるだけ正確に、昨夜出会ったある出来事について話し始めた。"

#. Occurrence 2_3:50:2501: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0000; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:50
msgctxt "text_id=2501 | speaker=aoko"
msgid "\"Sizuki, you in here?\""
msgstr "「静希君、いる？」"

#. Occurrence 2_3:56:2502: scene=2_3
#: 2_3:56
msgctxt "text_id=2502 | speaker=unknown"
msgid "  It was ten to twelve and lunchtime was quickly coming to an end."
msgstr "　昼休みも終わろうとしている十二時五十分。"

#. Occurrence 2_3:61:2503: scene=2_3
#: 2_3:61
msgctxt "text_id=2503 | speaker=unknown"
msgid "  Her face popped into Class C. As lively as ever,"
msgstr "　一向に活気の<衰|おとろ>えない二年Ｃ組の教室に顔を出し、"

#. Occurrence 2_3:66:2504: scene=2_3
#: 2_3:66
msgctxt "text_id=2504 | speaker=unknown"
msgid "  as if it were an everyday occurrence..."
msgstr "　……彼女にとってはごく普通の仕草で……"

#. Occurrence 2_3:71:2505: scene=2_3
#: 2_3:71
msgctxt "text_id=2505 | speaker=unknown"
msgid "  ...Aoko Aozaki announced her presence."
msgstr "　蒼崎青子はそう告げた。"

#. Occurrence 2_3:105:2506: scene=2_3
#: 2_3:105
msgctxt "text_id=2506 | speaker=unknown"
msgid "  While Aoko wasn't part of Class C, she didn't let it bother her as she casually entered the classroom."
msgstr "　青子にとってＣ組は<余所|よそ>のクラスだが、そんな事はおかまいなしで気軽に教室へと入っていく。"

#. Occurrence 2_3:151:2507: scene=2_3
#: 2_3:151
msgctxt "text_id=2507 | speaker=unknown"
msgid "  In contrast, the baby birds who had been so noisily chirping while eating lunch quickly quieted and began to rearrange their seats."
msgstr "　一方。リラックスした彼女とは対照的に、今まで餌を前にした<雛鳥|ひなどり>の如く騒がしかった生徒達は白々しいほど静かに、行儀よく席につきはじめた。"

#. Occurrence 2_3:192:2508: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0001; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:192
msgctxt "text_id=2508 | speaker=aoko"
msgid "(Hmph. Are they trying to tell me something?)"
msgstr "『……どういう意味よ、それ……』"

#. Occurrence 2_3:198:2509: scene=2_3
#: 2_3:198
msgctxt "text_id=2509 | speaker=unknown"
msgid "  She bristled internally before looking around the room."
msgstr "　内心で舌打ちしつつ、青子は教室を見回した。"

#. Occurrence 2_3:203:2510: scene=2_3
#: 2_3:203
msgctxt "text_id=2510 | speaker=unknown"
msgid "  She could not see the male student she had come here to find."
msgstr "　目当ての男子生徒の姿はない。"

#. Occurrence 2_3:208:2511: scene=2_3
#: 2_3:208
msgctxt "text_id=2511 | speaker=unknown"
msgid "  He hardly stood out, so she thought he might be hidden in a corner somewhere, but that appeared to not be the case."
msgstr "　目立たない奴だから、はじっこに隠れているかと思えばそうでもなさそうだ。"

#. Occurrence 2_3:242:2512: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0002; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:242
msgctxt "text_id=2512 | speaker=aoko"
msgid "\"Arisato, do you have any idea where Sizuki from seat 12 is?\""
msgstr "「有里君。出席番号12番の静希君は？」"

#. Occurrence 2_3:247:2513: scene=2_3
#: 2_3:247
msgctxt "text_id=2513 | speaker=unknown"
msgid "  Aoko kept her tone professional."
msgstr "　青子はあくまで事務的に問う。"

#. Occurrence 2_3:253:2514: voice_id=E70_2_3_0000; voice_prefix=E70; voice_category=0; scene=2_3
#: 2_3:253
msgctxt "text_id=2514 | speaker=unknown"
msgid "\"Wait, me? Umm, Sizuki left with His Highness Tobimaru a while ago.\""
msgstr "「え、俺……？　えーと、静希ならさっき鳶丸<殿下|でんか>が連れていったよ」"

#. Occurrence 2_3:258:2515: scene=2_3
#: 2_3:258
msgctxt "text_id=2515 | speaker=unknown"
msgid "  The boy was shocked that she actually knew his name."
msgstr "　名前を呼ばれた男子生徒は、青子が自分の名前を知っている事に驚きつつ返答した。"

#. Occurrence 2_3:284:2516: scene=2_3
#: 2_3:284
msgctxt "text_id=2516 | speaker=unknown"
msgid "  One might think that the reason students referred to Tobimaru Tsukiji by a royal title was because he was the chairman's son, but it was because he actually acted like royalty."
msgstr "　余談ではあるが、<槻司|つきじ><鳶丸|とびまる>が殿下と呼ばれるのは彼が理事長の息子だから……という訳でもなく、純粋に彼の振るまいが王子のようだからである。"

#. Occurrence 2_3:289:2517: scene=2_3
#: 2_3:289
msgctxt "text_id=2517 | speaker=unknown"
msgid "  In fact, the vice president was said to have taken a liking to the title."
msgstr "　本人もそのアダ名は気に入っているらしい。"

#. Occurrence 2_3:316:2518: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0003; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:316
msgctxt "text_id=2518 | speaker=aoko"
msgid "\"He's with Tobimaru? Are those two friends or something?\""
msgstr "「鳶丸が……？　あいつ、静希君と仲いいの？」"

#. Occurrence 2_3:337:2519: scene=2_3
#: 2_3:337
msgctxt "text_id=2519 | speaker=unknown"
msgid "  She seemed surprised."
msgstr "　意外そうに訊く青子と、"

#. Occurrence 2_3:342:2520: scene=2_3
#: 2_3:342
msgctxt "text_id=2520 | speaker=unknown"
msgid "  The class seemed surprised at her surprise."
msgstr "　その台詞を意外そうに聞くクラス一同。"

#. Occurrence 2_3:364:2521: voice_id=D90_2_3_0000; voice_prefix=D90; voice_category=0; scene=2_3
#: 2_3:364
msgctxt "text_id=2521 | speaker=unknown"
msgid "\"No idea, but we've never seen Tsukiji be that friendly with another boy before."
msgstr "「良いも悪いも、槻司くんが男子と仲良く話してるのって今まで見たことなかったよ、あたし達。"

#. Occurrence 2_3:370:2522: voice_id=D90_2_3_0001; voice_prefix=D90; voice_category=0; scene=2_3
#: 2_3:370
msgctxt "text_id=2522 | speaker=unknown"
msgid "  Well, maybe Kinomi, but he's an idiot, so that hardly counts.\""
msgstr "　あ、木乃美くんはバカだから別だけど」"

#. Occurrence 2_3:376:2523: voice_id=E20_2_3_0000; voice_prefix=E20; voice_category=0; scene=2_3
#: 2_3:376
msgctxt "text_id=2523 | speaker=unknown"
msgid "\"Yeah. His Highness was slow to warm to him, but since the third day, it's been nothing but friendly arguments.\""
msgstr "「そうだよなあ。はじめは殿下もあんまり話してなかったけど、三日もしたら楽しそうに口喧嘩してたもんなぁ」"

#. Occurrence 2_3:382:2524: voice_id=E30_2_3_0000; voice_prefix=E30; voice_category=0; scene=2_3
#: 2_3:382
msgctxt "text_id=2524 | speaker=unknown"
msgid "\"Well, you can't really help but like Sizuki. He may be a little odd, but he's good people.\""
msgstr "「ま、静希相手につっぱっても仕方ないじゃん？　あいつ変だけどいい奴だし」"

#. Occurrence 2_3:388:2525: voice_id=E10_2_3_0000; voice_prefix=E10; voice_category=0; scene=2_3
#: 2_3:388
msgctxt "text_id=2525 | speaker=unknown"
msgid "\"Totally! Soujyuro is really nice!\""
msgstr "「そーよねー。いい人だもんねー草十郎くん！」"

#. Occurrence 2_3:422:2526: scene=2_3
#: 2_3:422
msgctxt "text_id=2526 | speaker=unknown"
msgid "  Having recomposed themselves, Class C started chatting again."
msgstr "　調子を取り戻しつつあるのか、二年Ｃ組の面々はざわざわと会話をリレーしはじめる。"

#. Occurrence 2_3:440:2527: scene=2_3
#: 2_3:440
msgctxt "text_id=2527 | speaker=unknown"
msgid "  Aoko listened for a bit before turning around"
msgstr "　それをしばらく聞いていた青子だったが、唐突にくるりと背を向け、"

msgctxt "text_id=2528 | speaker=unknown"
msgid " and leaving the class with a, \"later.\""
msgstr "「それじゃ」と二年Ｃ組を後にした。"

#. Occurrence 2_3:509:2529: scene=2_3
#: 2_3:509
msgctxt "text_id=2529 | speaker=unknown"
msgid "  All the Soujyuro talk finished as quickly as it had started."
msgstr "　とりあえず手短に、草十郎の話は済んだ。"

#. Occurrence 2_3:515:2530: scene=2_3
#: 2_3:515
msgctxt "text_id=2530 | speaker=unknown"
msgid "  Lunchtime was coming to a close in the student council room."
msgstr "　昼休みも残り数分と迫った生徒会室。"

#. Occurrence 2_3:520:2531: scene=2_3
#: 2_3:520
msgctxt "text_id=2531 | speaker=unknown"
msgid "  Soujyuro, having told his story, was smiling in satisfaction."
msgstr "　話し終えて満足顔の草十郎と、"

#. Occurrence 2_3:525:2532: scene=2_3
#: 2_3:525
msgctxt "text_id=2532 | speaker=unknown"
msgid "  Tobimaru, still sitting across from him, was frowning."
msgstr "　聞き終わって難色顔の鳶丸が、机をはさんで向かいあっている。"

#. Occurrence 2_3:566:2533: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0000; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:566
msgctxt "text_id=2533 | speaker=soujuurou"
msgid "\"So, what do you think?\""
msgstr "「さ、感想を聞かせてくれ」"

#. Occurrence 2_3:572:2534: scene=2_3
#: 2_3:572
msgctxt "text_id=2534 | speaker=unknown"
msgid "  Soujyuro told his yarn as best he could."
msgstr "　話す事はすべて話した、と草十郎。"

#. Occurrence 2_3:577:2535: scene=2_3
#: 2_3:577
msgctxt "text_id=2535 | speaker=unknown"
msgid "  Tobimaru fingered his brow as if he was angry or concerned."
msgstr "　鳶丸はというと、怒っているような、悩んでいるような、曖昧な表情で額に指を当てていた。"

#. Occurrence 2_3:620:2536: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0000; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:620
msgctxt "text_id=2536 | speaker=tobimaru"
msgid "\"Sono-G. Are you trying to make fun of me? A word of advice, leave that to us smart people, hmm?\""
msgstr "「……なあ、草の字。おまえ、人を馬鹿にできるほど器用な奴じゃねえよな」"

#. Occurrence 2_3:653:2537: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0001; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:653
msgctxt "text_id=2537 | speaker=soujuurou"
msgid "\"Take that back. I'm more clever than you think.\""
msgstr "「失礼な。器用な方だぞ、俺は」"

#. Occurrence 2_3:658:2538: scene=2_3
#: 2_3:658
msgctxt "text_id=2538 | speaker=unknown"
msgid "  His response only confirmed Tobimaru's suspicions."
msgstr "　その返答に、つくづく不器用な性格だと確信する。"

#. Occurrence 2_3:663:2539: scene=2_3
#: 2_3:663
msgctxt "text_id=2539 | speaker=unknown"
msgid "  It had to be one of two possible conclusions."
msgstr "　となると結論は二つに一つだ。"

#. Occurrence 2_3:700:2540: scene=2_3
#: 2_3:700
msgctxt "text_id=2540 | speaker=unknown"
msgid "  That what Soujyuro had just told him was true..."
msgstr "　一つは、いま聞いた話は真実だという事。"

#. Occurrence 2_3:705:2541: scene=2_3
#: 2_3:705
msgctxt "text_id=2541 | speaker=unknown"
msgid "  ...or that Soujyuro was so tired that he must have been hallucinating at the time."
msgstr "　あるいは、彼が幻覚を見るほど疲れきっているという事。"

#. Occurrence 2_3:715:2542: scene=2_3
#: 2_3:715
msgctxt "text_id=2542 | speaker=unknown"
msgid "  Tobimaru sincerely hoped it was the latter."
msgstr "　鳶丸としては後者であってほしいものだが……。"

#. Occurrence 2_3:741:2543: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0001; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:741
msgctxt "text_id=2543 | speaker=tobimaru"
msgid "\"To be honest, Soujyuro. You're growing on me."
msgstr "「……草十郎。率直に言って、俺はおまえが気に入っている。"

#. Occurrence 2_3:752:2544: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0002; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:752
msgctxt "text_id=2544 | speaker=tobimaru"
msgid "  Anybody that never lies can't really be considered human."
msgstr "　嘘のない人間なんてのは人間じゃねえ。"

#. Occurrence 2_3:760:2545: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0003_0; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:760
msgctxt "text_id=2545 | speaker=tobimaru"
msgid "So for a misanthrope like me, I suppose you could say its easy to like you."
msgstr "俺は人間嫌いだから、そんなおまえさんが気に入ってたりするんだが……"

#. Occurrence 2_3:772:2546: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0003_1; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:772
msgctxt "text_id=2546 | speaker=tobimaru"
msgid " But if you're gonna stick to your dumb story, I'm not sure what I'm going to do for lunch starting tomorrow.\""
msgstr "そんなヤツまでバカげたコトを言い出したら、俺は明日から何を頼りに昼メシを食えばいいんだ？」"

#. Occurrence 2_3:791:2547: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0002; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:791
msgctxt "text_id=2547 | speaker=soujuurou"
msgid "\"Why not just eat in the cafeteria?\""
msgstr "「学食で食べればいいんじゃないか？」"

#. Occurrence 2_3:796:2548: scene=2_3
#: 2_3:796
msgctxt "text_id=2548 | speaker=unknown"
msgid "  Hearing his suggestion, Tobimaru's face darkened."
msgstr "　あっさりとした一言に、鳶丸はいっそう表情を暗くする。"

#. Occurrence 2_3:826:2549: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0004; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:826
msgctxt "text_id=2549 | speaker=tobimaru"
msgid "\"Okay. I'll spell it out for you. You were hallucinating."
msgstr "「分かった、はっきり言おう。それは幻覚だ。"

#. Occurrence 2_3:832:2550: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0005; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:832
msgctxt "text_id=2550 | speaker=tobimaru"
msgid "  If you still insist you saw a ghost, I'd be more than happy to introduce you to a good psychiatrist.\""
msgstr "　幽霊の正体見たり<枯|か>れ<尾花|おばな>ってヤツだろうさ。それでも納得いかないってんなら、いい精神科を紹介してやる」"

#. Occurrence 2_3:858:2551: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0003; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:858
msgctxt "text_id=2551 | speaker=soujuurou"
msgid "\"So that's your take on it. Good to know.\""
msgstr "「それが君の感想か。よし、ならいいんだ」"

#. Occurrence 2_3:863:2552: scene=2_3
#: 2_3:863
msgctxt "text_id=2552 | speaker=unknown"
msgid "  As bitter as Tobimaru's words might have sounded to most, Soujyuro swallowed them whole."
msgstr "　聞きようによっては侮辱としか取れない鳶丸の言葉を、草十郎は<泰然|たいぜん>と受けとめた。"

#. Occurrence 2_3:889:2553: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0004; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:889
msgctxt "text_id=2553 | speaker=soujuurou"
msgid "\"I already figured as much. It sounds like a tall tale to me, too."
msgstr "「そりゃあ俺だって神隠しの<類|たぐい>だと思ったよ。"

#. Occurrence 2_3:900:2554: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0005; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:900
msgctxt "text_id=2554 | speaker=soujuurou"
msgid "  I was starting to wonder if it was normal for that kind of thing to go on in a city, so I wanted to hear your opinion.\""
msgstr "　けど、都会じゃもしかしてそれも有りなのかもしれないだろ。確かめたかったのはそこなんだ」"

#. Occurrence 2_3:928:2555: scene=2_3
#: 2_3:928
msgctxt "text_id=2555 | speaker=unknown"
msgid "  Satisfied, Soujyuro finished off his last rice ball and neatly folded the cloth."
msgstr "　良かった、とばかりに草十郎は残った最後の握り飯をぺろっと平らげ、包み布をたたむ。"

#. Occurrence 2_3:955:2556: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0006; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:955
msgctxt "text_id=2556 | speaker=tobimaru"
msgid "\"Hey, hold on a second."
msgstr "「……おい。すると何か？"

#. Occurrence 2_3:961:2557: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0007; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:961
msgctxt "text_id=2557 | speaker=tobimaru"
msgid "  You didn't actually think it was normal for people in the city to breathe fire or extend their arms like they're made of rubber, did you?\""
msgstr "　おまえは都会の人間は口から火を吹いたり、腕が伸びたりするのが普通だと思ったのか？」"

#. Occurrence 2_3:967:2558: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0006; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:967
msgctxt "text_id=2558 | speaker=soujuurou"
msgid "\"Well, not normal, as much as within the realm of possibility."
msgstr "「……まあ、普通じゃないけど、特別でもないんじゃないかと思ったんだ。"

#. Occurrence 2_3:973:2559: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0007; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:973
msgctxt "text_id=2559 | speaker=soujuurou"
msgid "  This city is full of extraordinary things we don't have up in the mountains. I thought it might have some extraordinary people as well.\""
msgstr "　ここは山に無い物があふれている、何でもありの場所だ。だから、それぐらいやってのける人だって、もしかしているのかなと」"

#. Occurrence 2_3:1015:2560: scene=2_3
#: 2_3:1015
msgctxt "text_id=2560 | speaker=unknown"
msgid "  That his face was as serious as it was made Tobimaru realize just how big a culture shock Soujyuro must've been experiencing."
msgstr "　真顔で返す草十郎を見て、鳶丸は自分と彼を<隔|へだ>てている文化レベルの違いを痛感した。"

#. Occurrence 2_3:1020:2561: scene=2_3
#: 2_3:1020
msgctxt "text_id=2561 | speaker=unknown"
msgid "  Living up in the mountains, with no electricity."
msgstr "　電気も通わない山奥。"

#. Occurrence 2_3:1025:2562: scene=2_3
#: 2_3:1025
msgctxt "text_id=2562 | speaker=unknown"
msgid "  In a place where the night sky was as it always had been, where humans were just one more organism in nature's garden. It makes sense that those conditions would create a boy like him."
msgstr "　夜は太古のままの夜で、人間は主役ではなくどうでもいい端役、自然を構築する一パーツに留まっているのなら、たしかに、この少年のような人間が出来るのだろう。"

#. Occurrence 2_3:1070:2563: scene=2_3
#: 2_3:1070
msgctxt "text_id=2563 | speaker=unknown"
msgid "  The idea of children growing up so pure was an appealing one, but maybe it was natural to forgo civilization when your population was so small."
msgstr "　赤子が無垢なまま成長したと言えば聞こえはいいが、要は人が少なすぎて文明が発達するまでもなかった、"

#. Occurrence 2_3:1075:2564: scene=2_3
#: 2_3:1075
msgctxt "text_id=2564 | speaker=unknown"
msgid "  Or perhaps it was so simple a world that excessive knowledge was deemed irrelevant."
msgstr "　あるいは、余分な知識体系を必要としなかった素朴な世界だったのだ。"

#. Occurrence 2_3:1081:2565: scene=2_3
#: 2_3:1081
msgctxt "text_id=2565 | speaker=unknown"
msgid "  It was precisely because city life offered him so much that was impossible up till now that he had come to the conclusion that anything was possible here."
msgstr "　都会の生活を“今までの生活では全てありえなかった事”と感じる彼だからこそ、逆説的に、“起こりえる事は全てありえる事”に取ってしまう。"

#. Occurrence 2_3:1118:2566: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0008; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1118
msgctxt "text_id=2566 | speaker=tobimaru"
msgid "\"Relax. The city might have its share of shady guys, but none of them are magicians in disguise.\""
msgstr "「安心しろ。たしかにこっちには<性質|たち>の悪いヤツらばっかりだけどな、そんな魔法使いみたいなヤツはいねえよ」"

#. Occurrence 2_3:1124:2567: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0008; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1124
msgctxt "text_id=2567 | speaker=soujuurou"
msgid "\"I hope you're right.\""
msgstr "「そうだと良いんだけど」"

#. Occurrence 2_3:1130:2568: scene=2_3
#: 2_3:1130
msgctxt "text_id=2568 | speaker=unknown"
msgid "  But Soujyuro seemed unsure."
msgstr "　どこか納得のいかない様子の草十郎。"

#. Occurrence 2_3:1135:2569: scene=2_3
#: 2_3:1135
msgctxt "text_id=2569 | speaker=unknown"
msgid "  And on Tobimaru's part, there were things to Soujyuro's story that he found hard to swallow."
msgstr "　……確かに、今の話の中で納得のいかない点は鳶丸にもあった。"

#. Occurrence 2_3:1141:2570: scene=2_3
#: 2_3:1141
msgctxt "text_id=2570 | speaker=unknown"
msgid "Whether true or not, the incident Soujyuro had described was disturbing."
msgstr "アリかナシかはともかくとして、いま聞かされた出来事は人道的によろしくない。"

#. Occurrence 2_3:1188:2571: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0009; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1188
msgctxt "text_id=2571 | speaker=tobimaru"
msgid "\"For the time being, let's assume what you say actually happened."
msgstr "「まあ、事の真偽というか、どんな間違いでそう見えたかは置いておいてだ。"

#. Occurrence 2_3:1194:2572: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0010; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1194
msgctxt "text_id=2572 | speaker=tobimaru"
msgid "  That would ultimately mean that one of our school's students killed someone in the park last night and that neither of the parties involved were... normal.\""
msgstr "　結果だけ見ればうちの生徒が夜の公園で人を殺したって事になる。しかも双方控えめに表現しても普通じゃねえ」"

#. Occurrence 2_3:1199:2573: scene=2_3
#: 2_3:1199
msgctxt "text_id=2573 | speaker=unknown"
msgid "  As a newcomer to town, Soujyuro assumed that everyone his age was a student at this school. For better or worse, he was right."
msgstr "　町にやってきて日の浅い草十郎は、同い年の少年少女は『みなこの学校の生徒である』と誤認していたのだが、幸か不幸か結論として間違いではなかった。"

#. Occurrence 2_3:1230:2574: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0011; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1230
msgctxt "text_id=2574 | speaker=tobimaru"
msgid "\"One of them was equipped with a flamethrower, while the other..."
msgstr "「一人は火炎放射器を持って、もう一人は……"

msgctxt "text_id=2575 | speaker=unknown"
msgid " had a naginata... or at least a bladed weapon resembling one that was a good few feet in length.\""
msgstr "まあ、なんだ。<長刀|なぎなた>でも持ち出したのか、刃物らしきものが何メートルも伸びたときた」"

#. Occurrence 2_3:1258:2576: scene=2_3
#: 2_3:1258
msgctxt "text_id=2576 | speaker=unknown"
msgid "  Soujyuro bobbed his head up and down as he listened to the disbelief in Tobimaru's voice. Hearing it repeated by someone else, he could see how someone might think he was taking them for a ride."
msgstr "　鳶丸の呆れ声を聞きながら、なるほど、と小さく頷く草十郎。こうして<他人|ひと>の口から聞くと、相手を馬鹿にしてるとしか思えない内容だ。"

#. Occurrence 2_3:1301:2577: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0009; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1301
msgctxt "text_id=2577 | speaker=soujuurou"
msgid "\"Look, I'm not crazy, it really did happen like I said.\""
msgstr "「正気を疑うな。尋常じゃないぞ、その話」"

#. Occurrence 2_3:1338:2578: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0012; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1338
msgctxt "text_id=2578 | speaker=tobimaru"
msgid "\"Give it to me straight, Soujyuro. You're pulling my leg, aren't you?\""
msgstr "「草十郎。おまえ、実は俺をからかってんだろう？」"

#. Occurrence 2_3:1365:2579: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0010; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1365
msgctxt "text_id=2579 | speaker=soujuurou"
msgid "\"No, I'm not."
msgstr "「いや、まったく。"

#. Occurrence 2_3:1387:2580: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0011; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1387
msgctxt "text_id=2580 | speaker=soujuurou"
msgid "  But I get it. There's no one in the city who can do that...right?"
msgstr "　けどまあ、都会にはそんな人間はいないんだろう？"

#. Occurrence 2_3:1393:2581: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0012; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1393
msgctxt "text_id=2581 | speaker=soujuurou"
msgid "  If not, I was probably just hallucinating like you said. Working part-time while studying for exams has been pretty trying.\""
msgstr "　なら鳶丸の言う通り、夢でも見てたんだ。ここのところアルバイトと試験が重なって辛くて」"

#. Occurrence 2_3:1399:2582: scene=2_3
#: 2_3:1399
msgctxt "text_id=2582 | speaker=unknown"
msgid "  Winter break was just around the corner and the end of term exams were but a week away. Both were proving formidable opponents for Soujyuro."
msgstr "　今は冬休み直前。期末試験は一週間後に迫っている。草十郎にとっては何よりも手強い難敵だ。"

#. Occurrence 2_3:1420:2583: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0013; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1420
msgctxt "text_id=2583 | speaker=soujuurou"
msgid "\"I don't even know the basics, so I need to study twice as hard as everyone else. I mean, anyone would start to lose it if they did nothing but study, right?\""
msgstr "「俺は基本ができてないから、人の倍程度の勉強じゃ追いつけない。ほら、勉強ばかりしているとノイローゼをするんだろう？」"

#. Occurrence 2_3:1440:2584: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0013; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1440
msgctxt "text_id=2584 | speaker=tobimaru"
msgid "\"I wouldn't say you're losing it, but you're definitely pushing yourself too hard. Maybe cut back on work a bit until the exams are over?\""
msgstr "「そりゃするんじゃなくてなるものだが、ま、なんにせよやり過ぎ飲み過ぎはよくねえわな。試験前ぐらいはバイト減らしたらどうだ？」"

#. Occurrence 2_3:1468:2585: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0014; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1468
msgctxt "text_id=2585 | speaker=soujuurou"
msgid "\"I've tried to cut back, but a lot of people take off at the end of the year, so they often ask me to fill in for their shifts.\""
msgstr "「減らしてはいるんだけどね。年末ってアルバイトを休む人も多くて、その代行も頼まれがちだし」"

#. Occurrence 2_3:1473:2586: scene=2_3
#: 2_3:1473
msgctxt "text_id=2586 | speaker=unknown"
msgid "  He shrugged helplessly."
msgstr "　草十郎はやれやれと肩をすくめる。"

#. Occurrence 2_3:1485:2587: scene=2_3
#: 2_3:1485
msgctxt "text_id=2587 | speaker=unknown"
msgid "  It was obvious from his words that he had been busy."
msgstr "　その口ぶりから彼の忙しさは読み取れる。"

#. Occurrence 2_3:1490:2588: scene=2_3
#: 2_3:1490
msgctxt "text_id=2588 | speaker=unknown"
msgid "  Even if he was not going crazy, lack of sleep could have caused him to daydream, even if this all did go down in the middle of the night."
msgstr "　ノイローゼはともかく、睡眠不足で白昼夢を見るぐらいあるかもしれない。……実際、その場面にでくわしたのは深夜とのコトではあるが。"

#. Occurrence 2_3:1524:2589: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0014; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1524
msgctxt "text_id=2589 | speaker=tobimaru"
msgid "\"Sounds tough, Soujyuro.\""
msgstr "「なんだか大変そうだな、草十郎」"

#. Occurrence 2_3:1550:2590: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0015; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1550
msgctxt "text_id=2590 | speaker=soujuurou"
msgid "\"Yeah, city life has been exhausting.\""
msgstr "「ああ、実はかなりまいってる。都会の暮らしは深刻だ」"

#. Occurrence 2_3:1561:2591: scene=2_3
#: 2_3:1561
msgctxt "text_id=2591 | speaker=unknown"
msgid "  Soujyuro nodded with a pained look on his face."
msgstr "　困ったもんだと真顔で頷く草十郎。"

#. Occurrence 2_3:1566:2592: scene=2_3
#: 2_3:1566
msgctxt "text_id=2592 | speaker=unknown"
msgid "  What was strange, however, was that he did not look the least bit tired."
msgstr "　毛ほども疲れていないように見えるのが困りものだった。"

#. Occurrence 2_3:1616:2593: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0015; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1616
msgctxt "text_id=2593 | speaker=tobimaru"
msgid "\"I'm impressed you never complain about it."
msgstr "「泣き言いわねえのは感心するけどな。"

#. Occurrence 2_3:1616:2594: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0015; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1616
msgctxt "text_id=2594 | speaker=tobimaru"
msgid "  You always look like nothing bothers you at all.\""
msgstr "　おまえ、心労は顔に出ない<性質|タチ>か？」"

#. Occurrence 2_3:1622:2595: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0016; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1622
msgctxt "text_id=2595 | speaker=soujuurou"
msgid "\"Hm? That's just because it isn't bad enough to bother me.\""
msgstr "「？　そりゃ、心労はどこも痛まないからね」"

#. Occurrence 2_3:1628:2596: scene=2_3
#: 2_3:1628
msgctxt "text_id=2596 | speaker=unknown"
msgid "  As he answered, Soujyuro looked up at the clock on the wall."
msgstr "　答えて、草十郎はちらりと壁の時計を見る。"

#. Occurrence 2_3:1633:2597: scene=2_3
#: 2_3:1633
msgctxt "text_id=2597 | speaker=unknown"
msgid "  Lunchtime was almost over."
msgstr "　そろそろ昼休みも終わろうとしていた。"

#. Occurrence 2_3:1656:2598: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0017; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1656
msgctxt "text_id=2598 | speaker=soujuurou"
msgid "\"Tobimaru, the time.\""
msgstr "「鳶丸、時間だ」"

#. Occurrence 2_3:1662:2599: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0016; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1662
msgctxt "text_id=2599 | speaker=tobimaru"
msgid "\"Really? It's that late already? You can go on ahead. I still have things to do.\""
msgstr "「お？　ああ、もうそんなに経ったか。気にせず先に行ってていいぜ。俺はまだ用があるからよ」"

#. Occurrence 2_3:1690:2600: scene=2_3
#: 2_3:1690
msgctxt "text_id=2600 | speaker=unknown"
msgid "  Soujyuro watched as Tobimaru made a gesture that seemed to lament the life of a student council member."
msgstr "　生徒会役員は大変なんだとジェスチャーする鳶丸を、草十郎はマジマジと見つめる。"

#. Occurrence 2_3:1695:2601: scene=2_3
#: 2_3:1695
msgctxt "text_id=2601 | speaker=unknown"
msgid "  His eyes looked as if they were looking at a piece of art and not understanding its value."
msgstr "　価値の分からない美術品を見るような目で。"

#. Occurrence 2_3:1721:2602: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0018; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1721
msgctxt "text_id=2602 | speaker=soujuurou"
msgid "\"I'm jealous that you can just skip class whenever you want."
msgstr "「授業をさぼれる身分っていうのは羨ましいな。"

#. Occurrence 2_3:1727:2603: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0019; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1727
msgctxt "text_id=2603 | speaker=soujuurou"
msgid "  I would have thought you were a stickler for the rules.\""
msgstr "　そういうの、鳶丸が嫌いな手抜きじゃないのか？」"

#. Occurrence 2_3:1765:2604: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0017; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1765
msgctxt "text_id=2604 | speaker=tobimaru"
msgid "\"How many times do I have to tell you?! It's not skipping when I've got special permission!\""
msgstr "「そりゃ誤解も<甚|はなは>だしい！　俺の欠席は手抜きじゃねえ、特権ってヤツだと言ったろう!?」"

#. Occurrence 2_3:1771:2605: scene=2_3
#: 2_3:1771
msgctxt "text_id=2605 | speaker=unknown"
msgid "  The vice president angrily defended himself as he stood up."
msgstr "　心外だ、とばかりに席を立って力説する副会長。"

#. Occurrence 2_3:1776:2606: scene=2_3
#: 2_3:1776
msgctxt "text_id=2606 | speaker=unknown"
msgid "  The transfer student merely gazed at him, unfazed."
msgstr "　それをふーん、と無感動に眺める転入生。"

#. Occurrence 2_3:1803:2607: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0018; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1803
msgctxt "text_id=2607 | speaker=tobimaru"
msgid "\"Hey! You're not honestly implying you still don't understand after all that, are you?!"
msgstr "「おいおい、アレだけ説明したのにぜんっぜん分かってなかったのか!?"

#. Occurrence 2_3:1809:2608: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0019; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1809
msgctxt "text_id=2608 | speaker=tobimaru"
msgid "  Oh well. Just sit down and listen, Sono-G."
msgstr "　しょうがねえ、まず座れ。いいか草の字。"

#. Occurrence 2_3:1815:2609: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0020; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1815
msgctxt "text_id=2609 | speaker=tobimaru"
msgid "  I was granted talent and luck beyond that of most people, but I always put the work in. But once I leave here I'm on my own, now do you get it?\""
msgstr "　常人をうわまわる英気と幸運を兼ね備えながら、座する事なく精進してきた俺でも、ここを卒業しちまえば裸一貫になっちまうんだぞ？」"

#. Occurrence 2_3:1842:2610: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0021; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1842
msgctxt "text_id=2610 | speaker=tobimaru"
msgid "\"I'm sick of explaining this to people."
msgstr "「ひでえ話だ。"

#. Occurrence 2_3:1848:2611: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0022; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1848
msgctxt "text_id=2611 | speaker=tobimaru"
msgid "  My family's status will only keep me afloat for one more year. What about that could you possibly envy?"
msgstr "　<自分|テメエ>の家柄を活用できんのはあと一年ちょいだけなんだぜ？　これの一体どこが羨ましいってんだ？"

#. Occurrence 2_3:1854:2612: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0023; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1854
msgctxt "text_id=2612 | speaker=tobimaru"
msgid "  Most people can live off privilege for their entire lives, but the best I get is three measly years!\""
msgstr "　ふつう一生続くはずの親の七光って<権利|ヤツ>が、俺の場合はたった三年間しかねえんだからな！」"

#. Occurrence 2_3:1881:2613: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0024; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1881
msgctxt "text_id=2613 | speaker=tobimaru"
msgid "\"So I have to take advantage of what I have while I have it."
msgstr "「となりゃあ、有効なうちに使っておかなきゃもったいなくてオチオチ眠ってもいられねえ。"

#. Occurrence 2_3:1887:2614: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0025; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1887
msgctxt "text_id=2614 | speaker=tobimaru"
msgid "  Just the thought of having to count beans like the rest of the idiots out there gets me livid. The adult world is going to kill me. The envy alone will be enough to destroy my fragile heart!\""
msgstr "　ああイヤだイヤだ、何がイヤかってバカどもと<雁首|がんくび>ならべて金勘定するのがイヤだ！　ったく、嫉妬渦巻く大人の世界じゃ俺のオブラートみたいな心なんてぱっくり呑まれて溶けちまうコト請け合いだろうさ！」"

#. Occurrence 2_3:1935:2615: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0020; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1935
msgctxt "text_id=2615 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 2_3:1940:2616: scene=2_3
#: 2_3:1940
msgctxt "text_id=2616 | speaker=unknown"
msgid "  While he must have been joking, Soujyuro took his tone to be completely sincere."
msgstr "　冗談にしか取れない熱弁は、草十郎の聞くかぎりどうも本気のようだった。"

#. Occurrence 2_3:1951:2617: scene=2_3
#: 2_3:1951
msgctxt "text_id=2617 | speaker=unknown"
msgid "  He listened as he envied Tobimaru's ability to be so open about his feelings."
msgstr "　そういう事を本気で言える人間性が羨ましい、などと思いつつ、草十郎はなるほど、と納得する。"

#. Occurrence 2_3:1956:2618: scene=2_3
#: 2_3:1956
msgctxt "text_id=2618 | speaker=unknown"
msgid "  From his frame of reference, there was nothing he could do but take Tobimaru for his word."
msgstr "　本人が言うのだから彼の主観的には正しいのだろうと。"

#. Occurrence 2_3:1961:2619: scene=2_3
#: 2_3:1961
msgctxt "text_id=2619 | speaker=unknown"
msgid "  When..."
msgstr "　だが、"

#. Occurrence 2_3:1985:2620: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0004; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:1985
msgctxt "text_id=2620 | speaker=aoko"
msgid "\"If you're looking to extend your privileges, why not stay in school? I'd be more than happy to arrange that for you.\""
msgstr "「あら、そんな権利なんて留年すればいくらでも引き延ばせるのに。なんなら協力してあげましょうか、この私でよろしければ」"

#. Occurrence 2_3:1997:2621: scene=2_3
#: 2_3:1997
msgctxt "text_id=2621 | speaker=unknown"
msgid "  The door to the student council room flew open, washing away Soujyuro's half-hearted responses to his friend."
msgstr "　草十郎の骨のない相づちを蹴散らすように、生徒会室の扉が勢いよく開かれた。"

#. Occurrence 2_3:2036:2622: scene=2_3
#: 2_3:2036
msgctxt "text_id=2622 | speaker=unknown"
msgid "  This frosty statement destroyed the warm atmosphere of the room."
msgstr "　ほんわかした空気を一撃で打ち砕く<冷静|クール>な一言。"

#. Occurrence 2_3:2041:2623: scene=2_3
#: 2_3:2041
msgctxt "text_id=2623 | speaker=unknown"
msgid "  And it also marked the abrupt end to Tobimaru Tsukiji's reign there."
msgstr "　槻司鳶丸にあったこの場の支配権は、<蝙蝠|こうもり>より<潔|いさぎよ>く彼女の手に飛び立ったのだった。"

#. Occurrence 2_3:2067:2624: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0026; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:2067
msgctxt "text_id=2624 | speaker=tobimaru"
msgid "\"...No, I just meant that our dreams are something we take hold of ourselves.\""
msgstr "「……いや、いい。自分の夢は、自分の力だけで叶えようとつねづね思ってるんだ」"

#. Occurrence 2_3:2073:2625: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0005; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2073
msgctxt "text_id=2625 | speaker=aoko"
msgid "\"Really. Then why not spend more time on that than this pathetic display."
msgstr "「そ。なら今みたいな恥ずかしいこと力説しないでね。"

#. Occurrence 2_3:2073:2626: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0005; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2073
msgctxt "text_id=2626 | speaker=aoko"
msgid "  I could hear you all the way from the hallway, Mr. Vice President.\""
msgstr "　廊下にまで聞こえてたわよ、副会長さん」"

#. Occurrence 2_3:2119:2627: scene=2_3
#: 2_3:2119
msgctxt "text_id=2627 | speaker=unknown"
msgid "  Not missing a beat, Aoko Aozaki stepped inside the room."
msgstr "　さらりと言って、彼女……蒼崎青子が生徒会室に入ってくる。"

#. Occurrence 2_3:2124:2628: scene=2_3
#: 2_3:2124
msgctxt "text_id=2628 | speaker=unknown"
msgid "  Her dark hair was slightly disheveled as if she had been running."
msgstr "　長い黒髪がわずかに乱れているのは、ここまで走ってきたせいか。"

#. Occurrence 2_3:2129:2629: scene=2_3
#: 2_3:2129
msgctxt "text_id=2629 | speaker=unknown"
msgid "  Her gaze missed the sitting Soujyuro entirely and was focused completely on the ranting vice president."
msgstr "　青子の視線は座ったままの草十郎にではなく、熱弁していた副会長に向けられている。"

#. Occurrence 2_3:2177:2630: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0021; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2177
msgctxt "text_id=2630 | speaker=soujuurou"
msgid "\"Good luck, Tobimaru.\""
msgstr "「頑張れ、鳶丸」"

#. Occurrence 2_3:2189:2631: scene=2_3
#: 2_3:2189
msgctxt "text_id=2631 | speaker=unknown"
msgid "  Soujyuro quietly got up to head back to his classroom."
msgstr "　そろそろ教室に戻らないといけない、と草十郎は静かに立ち上がる。"

#. Occurrence 2_3:2195:2632: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0027; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:2195
msgctxt "text_id=2632 | speaker=tobimaru"
msgid "\"...That's cold, man.\""
msgstr "「……わりと薄情なんだな、おまえって」"

#. Occurrence 2_3:2225:2633: scene=2_3
#: 2_3:2225
msgctxt "text_id=2633 | speaker=unknown"
msgid "  Tobimaru grumbled in front of Aoko."
msgstr "　青子を前にして呟く鳶丸。"

#. Occurrence 2_3:2266:2634: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0022; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2266
msgctxt "text_id=2634 | speaker=soujuurou"
msgid "\"But it's almost time for class.\""
msgstr "「だって時間がない」"

#. Occurrence 2_3:2290:2635: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0028; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:2290
msgctxt "text_id=2635 | speaker=tobimaru"
msgid "\"You're just proving my point, you're-\""
msgstr "「だから、そういうのが薄情とだな……」"

#. Occurrence 2_3:2295:2636: scene=2_3
#: 2_3:2295
msgctxt "text_id=2636 | speaker=unknown"
msgid "  He cut himself off."
msgstr "　言いかけて言葉を呑む鳶丸。"

#. Occurrence 2_3:2315:2637: scene=2_3
#: 2_3:2315
msgctxt "text_id=2637 | speaker=unknown"
msgid "  Aoko briefly shifted her gaze to Soujyuro."
msgstr "　今まで自分しか見ていなかった青子の視線が、草十郎をちらりと見たからだ。"

#. Occurrence 2_3:2357:2638: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0006; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2357
msgctxt "text_id=2638 | speaker=aoko"
msgid "\"It's not like I have time for this, either, you know. It feels like I'm always having to clean up after you.\""
msgstr "「時間がないのは私も同じよ。貴方にはいつも振り回される」"

#. Occurrence 2_3:2363:2639: scene=2_3
#: 2_3:2363
msgctxt "text_id=2639 | speaker=unknown"
msgid "  Not a complaint. It was her honest opinion."
msgstr "　これは文句ではなく、素直な意見らしい。"

#. Occurrence 2_3:2377:2640: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0029; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:2377
msgctxt "text_id=2640 | speaker=tobimaru"
msgid "\"Wait, you're here for Soujyuro?\""
msgstr "「なんだ、用件は草十郎かよ」"

#. Occurrence 2_3:2388:2641: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0007; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2388
msgctxt "text_id=2641 | speaker=aoko"
msgid "\"Don't worry. I'll deal with you next.\""
msgstr "「安心なさい、貴方にもあるから」"

#. Occurrence 2_3:2425:2642: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0030; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:2425
msgctxt "text_id=2642 | speaker=tobimaru"
msgid "\"...?\""
msgstr "「……？」"

#. Occurrence 2_3:2430:2643: scene=2_3
#: 2_3:2430
msgctxt "text_id=2643 | speaker=unknown"
msgid "  Her eyes shimmered with a murderous glee."
msgstr "　心なしか、青子の目に殺伐とした<翳|かげ>りがある。"

#. Occurrence 2_3:2435:2644: scene=2_3
#: 2_3:2435
msgctxt "text_id=2644 | speaker=unknown"
msgid "  It was slightly different from the more sullen gaze to which Tobimaru had grown accustomed."
msgstr "　いつも不機嫌そうな青子の視線に見慣れている鳶丸だからこそ気づける、微妙な差異だ。"

#. Occurrence 2_3:2440:2645: scene=2_3
#: 2_3:2440
msgctxt "text_id=2645 | speaker=unknown"
msgid "  For whatever reason, Aoko's mood seemed worse than usual."
msgstr "　……理由は不明だが、蒼崎青子はいつになくご機嫌ななめという事らしい。"

#. Occurrence 2_3:2475:2646: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0008; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2475
msgctxt "text_id=2646 | speaker=aoko"
msgid "\"Sizuki. Which do you prefer, running or swimming?\""
msgstr "「静希君。貴方、走るのと泳ぐの、どっちが好き？」"

#. Occurrence 2_3:2494:2647: scene=2_3
#: 2_3:2494
msgctxt "text_id=2647 | speaker=unknown"
msgid "  Aoko asked abruptly."
msgstr "　唐突に青子が訊ねる。"

#. Occurrence 2_3:2499:2648: scene=2_3
#: 2_3:2499
msgctxt "text_id=2648 | speaker=unknown"
msgid "  Soujyuro frowned a little before saying he was fine with either one."
msgstr "　草十郎は少し顔を曇らせてから、どっちも、と答えた。"

#. Occurrence 2_3:2505:2649: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0009; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2505
msgctxt "text_id=2649 | speaker=aoko"
msgid "\"That won't do. Pick one.\""
msgstr "「だめよ、ひとつにして」"

#. Occurrence 2_3:2531:2650: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0023; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2531
msgctxt "text_id=2650 | speaker=soujuurou"
msgid "\"...Swimming, I guess. Why do you ask?\""
msgstr "「……泳ぐほう、かな。けど、どうして？」"

#. Occurrence 2_3:2537:2651: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0010; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2537
msgctxt "text_id=2651 | speaker=aoko"
msgid "\"Because you still haven't joined a club.\""
msgstr "「貴方がまだどこの部にも所属してないから」"

#. Occurrence 2_3:2542:2652: scene=2_3
#: 2_3:2542
msgctxt "text_id=2652 | speaker=unknown"
msgid "  A succinct reply."
msgstr "　実に無駄のない答えだった。"

#. Occurrence 2_3:2547:2653: scene=2_3
#: 2_3:2547
msgctxt "text_id=2653 | speaker=unknown"
msgid "  One that left no room for Soujyuro to object."
msgstr "　無駄がなさすぎて、草十郎の意見をはさむ隙間もない。"

#. Occurrence 2_3:2595:2654: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0011; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2595
msgctxt "text_id=2654 | speaker=aoko"
msgid "\"You've read the school regulations. All students must participate in club activities."
msgstr "「うちの校則、読んだわよね。生徒はただ一人の例外もなく部活動に参加しなくてはならない。"

#. Occurrence 2_3:2601:2655: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0012; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2601
msgctxt "text_id=2655 | speaker=aoko"
msgid "  I'm not the biggest fan of it myself, to be honest, but a rule is a rule.\""
msgstr "　正直どうかと思う校則だけど、決まりは決まりだから」"

#. Occurrence 2_3:2607:2656: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0024; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2607
msgctxt "text_id=2656 | speaker=soujuurou"
msgid "\"That's crazy. How could I possibly find the time for that?\""
msgstr "「そんな無茶な。悪いけど、そこまでの暇はないんだ」"

#. Occurrence 2_3:2625:2657: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0013; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2625
msgctxt "text_id=2657 | speaker=aoko"
msgid "\"How indeed?\""
msgstr "「でしょうね」"

#. Occurrence 2_3:2630:2658: scene=2_3
#: 2_3:2630
msgctxt "text_id=2658 | speaker=unknown"
msgid "  An equally terse response."
msgstr "　短い返答。"

#. Occurrence 2_3:2647:2659: scene=2_3
#: 2_3:2647
msgctxt "text_id=2659 | speaker=unknown"
msgid "  She was typically to the point, but Tobimaru got the impression that she was expressly trying to keep her interaction with Soujyuro short."
msgstr "　青子に容赦がないのはいつもの事だが、鳶丸には、彼女が草十郎との会話を避けているようにも見える。"

#. Occurrence 2_3:2694:2660: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0014; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2694
msgctxt "text_id=2660 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 2_3:2700:2661: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0025; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2700
msgctxt "text_id=2661 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 2_3:2706:2662: scene=2_3
#: 2_3:2706
msgctxt "text_id=2662 | speaker=unknown"
msgid "  They stared at each other in silence."
msgstr "　無言で見つめあうふたり。"

#. Occurrence 2_3:2711:2663: scene=2_3
#: 2_3:2711
msgctxt "text_id=2663 | speaker=unknown"
msgid "  Tobimaru stood breathlessly silent on the sidelines until Soujyuro broke the impasse."
msgstr "　第三者の鳶丸すら息がつまりそうな沈黙は、そうか、という草十郎の一言で破られた。"

#. Occurrence 2_3:2765:2664: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0026; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2765
msgctxt "text_id=2664 | speaker=soujuurou"
msgid "\"I thought you of all people would understand, Aozaki."
msgstr "「蒼崎は分かってると思ってた。"

#. Occurrence 2_3:2772:2665: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0027; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2772
msgctxt "text_id=2665 | speaker=soujuurou"
msgid "I mean, of course you do."
msgstr "ああ、いや違う、きっと分かっているんだな。"

#. Occurrence 2_3:2784:2666: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0028; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2784
msgctxt "text_id=2666 | speaker=soujuurou"
msgid "  That's what makes you strong.\""
msgstr "　うん。だから、そこが強いんだろうね」"

#. Occurrence 2_3:2807:2667: scene=2_3
#: 2_3:2807
msgctxt "text_id=2667 | speaker=unknown"
msgid "  Soujyuro stood up from his seat."
msgstr "　席を離れる草十郎。"

#. Occurrence 2_3:2825:2668: scene=2_3
#: 2_3:2825
msgctxt "text_id=2668 | speaker=unknown"
msgid "  He walked past Aoko and into the hallway."
msgstr "　青子の横を通り過ぎ、あっさりと廊下に出る。"

#. Occurrence 2_3:2846:2669: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0029; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2846
msgctxt "text_id=2669 | speaker=soujuurou"
msgid "\"Do you mind if I start tomorrow?\""
msgstr "「それ、明日からでいいんだろ？」"

#. Occurrence 2_3:2859:2670: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0015; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2859
msgctxt "text_id=2670 | speaker=aoko"
msgid "\"Whatever works for you, Sizuki.\""
msgstr "「静希君がいいならね」"

#. Occurrence 2_3:2880:2671: scene=2_3
#: 2_3:2880
msgctxt "text_id=2671 | speaker=unknown"
msgid "  He did his best to force a smile before leaving the student council room."
msgstr "　できるだけ頑張るよ、と苦笑して、草十郎は生徒会室を後にした。"

#. Occurrence 2_4:50:2672: scene=2_4
#: 2_4:50
msgctxt "text_id=2672 | speaker=unknown"
msgid "   While watching the events play out, Tobimaru found himself deeply impressed with Soujyuro."
msgstr "　そんな一連の出来事を観察しながら、鳶丸はつくづく草十郎に感心していた。"

#. Occurrence 2_4:80:2673: scene=2_4
#: 2_4:80
msgctxt "text_id=2673 | speaker=unknown"
msgid "  He could tell from Aoko's behavior that she was trying to get a rise out of Soujyuro. Soujyuro, on the other hand, didn't react. Heedless of what Aoko was doing, he simply went on his way."
msgstr "　今の青子の態度は、相手を怒らせる事を前提としたものだ。しかし草十郎は怒りだす様子もなく、掴みどころのない……言ってるコトは本当に掴みようがなかったが……返答をして去っていった。"

#. Occurrence 2_4:85:2674: scene=2_4
#: 2_4:85
msgctxt "text_id=2674 | speaker=unknown"
msgid "  To Tobimaru, it was hard to believe that Soujyuro had not taken offense."
msgstr "　草十郎とて少なからず不満に思っただろう。"

#. Occurrence 2_4:90:2675: scene=2_4
#: 2_4:90
msgctxt "text_id=2675 | speaker=unknown"
msgid "  From his point of view, Soujyuro's poker face had been the performance of a lifetime."
msgstr "　それを表情にも仕草にも出さなかった事に、鳶丸は一流の芸を見た気がしたのである。"

#. Occurrence 2_4:148:2676: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0000; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:148
msgctxt "text_id=2676 | speaker=tobimaru"
msgid "\"The kid has some balls, huh, president?\""
msgstr "「いや、でも何が強いんだろうな会長？」"

#. Occurrence 2_4:154:2677: scene=2_4
#: 2_4:154
msgctxt "text_id=2677 | speaker=unknown"
msgid "  He looked at Aoko curiously."
msgstr "　鳶丸は首をかしげて青子を見る。"

#. Occurrence 2_4:176:2678: scene=2_4
#: 2_4:176
msgctxt "text_id=2678 | speaker=unknown"
msgid "  Aoko stood completely still, staring at the wall."
msgstr "　青子は立ち尽くしたまま、じっと壁を睨んでいた。"

#. Occurrence 2_4:182:2679: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0001; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:182
msgctxt "text_id=2679 | speaker=tobimaru"
msgid "\"...Hey, Aozaki?\""
msgstr "「……蒼崎？」"

#. Occurrence 2_4:187:2680: scene=2_4
#: 2_4:187
msgctxt "text_id=2680 | speaker=unknown"
msgid "  Aoko showed no response."
msgstr "　鳶丸の呼び掛けに、青子は応えない。"

#. Occurrence 2_4:199:2681: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0002; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:199
msgctxt "text_id=2681 | speaker=tobimaru"
msgid "\"Yo. President. Earth to Aozaki, come in, come in. ...Lady Aoko?"
msgstr "「おーい、かいちょー。蒼崎ぃー。……青子女史？"

#. Occurrence 2_4:199:2682: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0002; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:199
msgctxt "text_id=2682 | speaker=tobimaru"
msgid "  ..."
msgstr "　……"

msgctxt "text_id=2683 | speaker=unknown"
msgid " Ahem. I'M TALKING TO YOU, AOKO AOZAKI!\""
msgstr "おい、聞いてんのかよ蒼崎青子！」"

#. Occurrence 2_4:260:2684: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0000; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:260
msgctxt "text_id=2684 | speaker=aoko"
msgid "\"Enough with the 'AO, AO, AO,' already! God!\""
msgstr "「っさいわね！　あおあお呼ぶなっ！」"

#. Occurrence 2_4:266:2685: scene=2_4
#: 2_4:266
msgctxt "text_id=2685 | speaker=unknown"
msgid "  Her fury echoed across the student council room."
msgstr "　怒鳴り声が生徒会室に響く。"

#. Occurrence 2_4:271:2686: scene=2_4
#: 2_4:271
msgctxt "text_id=2686 | speaker=unknown"
msgid "  It was a beautiful sound that could be heard into the hallway and made Tobimaru's rant from earlier pale in comparison."
msgstr "　さきほどの鳶丸の熱弁以上に、廊下にまで通る美声だった。"

#. Occurrence 2_4:308:2687: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0003; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:308
msgctxt "text_id=2687 | speaker=tobimaru"
msgid "\"Look who's talking, miss megaphone!\""
msgstr "「やかましい、うるせえのはテメエも同じだ！」"

#. Occurrence 2_4:313:2688: scene=2_4
#: 2_4:313
msgctxt "text_id=2688 | speaker=unknown"
msgid "  Perhaps her shouting was still ringing in his ears, or he was just the type to answer a shout with a shout, but he shot back reflexively."
msgstr "　よほど耳に響いたのか、それとも怒鳴られたら怒鳴り返す性分なのか、鳶丸も反射的に言い返す。"

#. Occurrence 2_4:319:2689: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0004; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:319
msgctxt "text_id=2689 | speaker=tobimaru"
msgid "\"No wonder you can't get a boyfriend."
msgstr "「そんなんだから男の一人もできねえんだよ、おまえは。"

#. Occurrence 2_4:319:2690: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0004; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:319
msgctxt "text_id=2690 | speaker=tobimaru"
msgid "  Do I have your attention now?\""
msgstr "　ほら、目ぇ覚めたか？」"

#. Occurrence 2_4:371:2691: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0001; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:371
msgctxt "text_id=2691 | speaker=aoko"
msgid "\"I could hear you before. I was just ignoring you because you were annoying me, and I thought it'd be easier than getting you to shut up.\""
msgstr "「別に、貴方の声は聞こえてた。わずらわしかったから無視してただけよ。黙らせるの面倒だし」"

#. Occurrence 2_4:391:2692: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0005; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:391
msgctxt "text_id=2692 | speaker=tobimaru"
msgid "\"You've got some nerve. Am I a mosquito to you?\""
msgstr "「テメエな。俺は蚊かなんかか、おい」"

#. Occurrence 2_4:402:2693: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0002; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:402
msgctxt "text_id=2693 | speaker=aoko"
msgid "\"A mosquito would offer better company, so no.\""
msgstr "「コミュニケーションが成立しない点で言えば、あっちのがまだ上品よね」"

#. Occurrence 2_4:440:2694: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0006; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:440
msgctxt "text_id=2694 | speaker=tobimaru"
msgid "\"...And what exactly is that supposed to mean?\""
msgstr "「……ほう、その心は？」"

#. Occurrence 2_4:461:2695: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0003; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:461
msgctxt "text_id=2695 | speaker=aoko"
msgid "\"We never see eye to eye. Talking to you is like going on a date, both pointless activities.\""
msgstr "「お互い、何を言ってるか分からない。意味のない会話なら、逢瀬みたいなものでしょう？」"

#. Occurrence 2_4:480:2696: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0007; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:480
msgctxt "text_id=2696 | speaker=tobimaru"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 2_4:485:2697: scene=2_4
#: 2_4:485
msgctxt "text_id=2697 | speaker=unknown"
msgid "  Based on that statement, Aoko must have been under the assumption that dating was the act of two lovers whispering nonsense to each other."
msgstr "　その論からいくと、彼女にとって恋人同士とは意味のない会話をするものらしい。"

#. Occurrence 2_4:518:2698: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0008; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:518
msgctxt "text_id=2698 | speaker=tobimaru"
msgid "\"...The real question is what the hell qualifies as company to you, but whatever."
msgstr "「……問題は、おまえにとって意味のある会話ってのがどの程度の価値かってコトだが……まあいいか。"

#. Occurrence 2_4:524:2699: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0009; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:524
msgctxt "text_id=2699 | speaker=tobimaru"
msgid "  You're awfully harsh today, Aozaki.\""
msgstr "　いつになくきついじゃねえか、蒼崎」"

#. Occurrence 2_4:530:2700: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0004; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:530
msgctxt "text_id=2700 | speaker=aoko"
msgid "\"Maybe a little. This isn't exactly the time to make nice.\""
msgstr "「ちょっとね。いま愛嬌ふりまける状況じゃないのよ」"

#. Occurrence 2_4:549:2701: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0010; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:549
msgctxt "text_id=2701 | speaker=tobimaru"
msgid "\"Funny you mention that―I haven't seen you try to be civil at all in the last two years.\""
msgstr "「不思議だ。この二年間で蒼崎の愛嬌なんてものは見たことがないんだが」"

#. Occurrence 2_4:575:2702: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0005; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:575
msgctxt "text_id=2702 | speaker=aoko"
msgid "\"Oh, I'm always civil―just not when you're in the same room.\""
msgstr "「鳶丸のいない時にふりまいてたの」"

#. Occurrence 2_4:598:2703: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0011; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:598
msgctxt "text_id=2703 | speaker=tobimaru"
msgid "\"So that's how it is. You're still upset with me for what happened, aren't you?\""
msgstr "「そうかよ。やっぱりあの時のこと恨んでるんだろ、生徒会長さんはよ」"

#. Occurrence 2_4:603:2704: scene=2_4
#: 2_4:603
msgctxt "text_id=2704 | speaker=unknown"
msgid "  There was only one thing that Tobimaru could be talking about--"
msgstr "　鳶丸の言うあの時というのは一つしかない。"

#. Occurrence 2_4:608:2705: scene=2_4
#: 2_4:608
msgctxt "text_id=2705 | speaker=unknown"
msgid "  the incident that occurred in the student council room this past summer."
msgstr "　今年の夏に起きた、生徒会室イン武道館事件の事である。"

#. Occurrence 2_4:643:2706: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0006; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:643
msgctxt "text_id=2706 | speaker=aoko"
msgid "\"Huh? Isn't that ancient history at this point?"
msgstr "「え、随分と昔の話じゃないそれ？"

#. Occurrence 2_4:649:2707: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0007; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:649
msgctxt "text_id=2707 | speaker=aoko"
msgid "  Don't you think you should stop wasting brainpower on this? I mean, you've got so few brain cells to work with as it is.\""
msgstr "　そんなどうでもいい事に容量を使っちゃもったいないわよ？　ただでさえ脳の覚醒部分が少ないのに」"

#. Occurrence 2_4:668:2708: scene=2_4
#: 2_4:668
msgctxt "text_id=2708 | speaker=unknown"
msgid "  As the conversation wore on, Aoko's murderous aura began to fade, and her sharp gaze gave way to a calmer demeanor rarely seen from her."
msgstr "　会話が走ってきたおかげか、青子から先ほどまでの<殺伐|さつばつ>さが薄れつつあった。鋭い視線も、時たまにしか見せない<涼|すず>しげなものになる。"

#. Occurrence 2_4:673:2709: scene=2_4
#: 2_4:673
msgctxt "text_id=2709 | speaker=unknown"
msgid "  It was quite possible that nobody besides Tobimaru had ever seen this side of her at school before."
msgstr "　学校内で彼女のこういった顔を見られるのは、今のところ槻司鳶丸だけだろう。"

#. Occurrence 2_4:707:2710: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0012; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:707
msgctxt "text_id=2710 | speaker=tobimaru"
msgid "\"Thanks for the concern, psych. And for the record, it's not like I want to relive it either."
msgstr "「ご忠告どうも。俺だってあんな事は忘れてえよ。"

#. Occurrence 2_4:718:2711: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0013; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:718
msgctxt "text_id=2711 | speaker=tobimaru"
msgid "  ...It's just, when Sono-G was being an idiot earlier, it kinda reminded me of how it went down. Come to think of it, this is the room it happened in!\""
msgstr "　……ただ、さっき草の字が馬鹿な事いいやがるからつい思い出しちまったんだよ。くそ、考えてみりゃあ場所まで一緒じゃねえか！」"

#. Occurrence 2_4:731:2712: scene=2_4
#: 2_4:731
msgctxt "text_id=2712 | speaker=unknown"
msgid "  Despite his ranting, his face betrayed a touch of nostalgia."
msgstr "　などと悪態をつきながらも、まんざらでもなさげに過去を懐かしむ鳶丸。"

#. Occurrence 2_4:756:2713: scene=2_4
#: 2_4:756
msgctxt "text_id=2713 | speaker=unknown"
msgid "  Aoko, on the other hand, was scowling."
msgstr "　一方、青子は顔をしかめる。"

#. Occurrence 2_4:778:2714: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0008; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:778
msgctxt "text_id=2714 | speaker=aoko"
msgid "\"Hold on."
msgstr "「ちょっと待って。"

#. Occurrence 2_4:784:2715: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0009; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:784
msgctxt "text_id=2715 | speaker=aoko"
msgid "  You didn't tell him about what happened, did you?\""
msgstr "　あの話、彼にしたの……？」"

#. Occurrence 2_4:804:2716: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0014; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:804
msgctxt "text_id=2716 | speaker=tobimaru"
msgid "\"Sure did. At least, "
msgstr "「おう、俺がテメエに"

#. Occurrence 2_4:804:2717: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0014; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:804
msgctxt "text_id=2717 | speaker=tobimaru"
msgid "how you mocked my candidacy for president and told me my face had sidekick written all over it."
msgstr "“なんで会長になんか立候補したのよ。アンタは副会長って顔でしょ、どう見ても”"

#. Occurrence 2_4:804:2718: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0014; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:804
msgctxt "text_id=2718 | speaker=tobimaru"
msgid "  And the part where I took the bait and tried my damnedest to punch you for it.\""
msgstr "　なんて挑発されて、生涯最高の突きをしたところまでな」"

#. Occurrence 2_4:827:2719: scene=2_4
#: 2_4:827
msgctxt "text_id=2719 | speaker=unknown"
msgid "  Aoko let out a sigh... as if relieved that Tobimaru had not told Soujyuro the rest of the story."
msgstr "　何故か、ほう、と青子は息をついた。その先を知られなくて良かった、という風に。"

#. Occurrence 2_4:846:2720: scene=2_4
#: 2_4:846
msgctxt "text_id=2720 | speaker=unknown"
msgid "  Even she wasn't sure why."
msgstr "　何故だかは鳶丸にも青子自身にも分からない。"

#. Occurrence 2_4:884:2721: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0010; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:884
msgctxt "text_id=2721 | speaker=aoko"
msgid "\"I'll admit that was quite a punch though."
msgstr "「アレはたしかに、びっくりするぐらいいい突きだった。"

#. Occurrence 2_4:884:2722: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0010; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:884
msgctxt "text_id=2722 | speaker=aoko"
msgid "  It was enough to make me react on reflex."
msgstr "　思わず体が反応しちゃったものね。"

#. Occurrence 2_4:890:2723: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0011; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:890
msgctxt "text_id=2723 | speaker=aoko"
msgid "  Did I really say that, by the way?\""
msgstr "　ところで、私そんなコト言ったっけ？」"

#. Occurrence 2_4:901:2724: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0015; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:901
msgctxt "text_id=2724 | speaker=tobimaru"
msgid "\"You sure did. And not only that―after I was taken to the infirmary, you had the balls to tell me you did me a favor by forcing me to be your number two.\""
msgstr "「言った。しかも俺が保健室に運ばれたのをこれ幸いと、強引に副会長にしやがった」"

#. Occurrence 2_4:924:2725: scene=2_4
#: 2_4:924
msgctxt "text_id=2725 | speaker=unknown"
msgid "  Since that day, Tobimaru had served as the vice president to the person who'd usurped the role from him."
msgstr "　以来、鳶丸は選挙戦で負けた相手に副会長として使われているのであった。"

#. Occurrence 2_4:951:2726: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0016; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:951
msgctxt "text_id=2726 | speaker=tobimaru"
msgid "\"It's fine, though. The president's chair doesn't suit me anyway. I feel much more at home as the vice president. Your job would have probably turned me into my dad.\""
msgstr "「いいけどな。俺に会長職は合わねえって分かったし。副会長の方が性に合ってやがる。会長なんてやってたら、あやうく親父みたいな野郎になってただろうしよ」"

#. Occurrence 2_4:985:2727: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0012; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:985
msgctxt "text_id=2727 | speaker=aoko"
msgid "\"Your pride's never allowed you to give anything less than your best."
msgstr "「プライド高い分、できるコトは全部やるからね鳶丸は。"

#. Occurrence 2_4:996:2728: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0013; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:996
msgctxt "text_id=2728 | speaker=aoko"
msgid "  You might be a little too comfortable on the student council, though. Makes me wonder how you would've looked as an honor student.\""
msgstr "　ま、会長職に専心するあまり、気が付いたら優等生になってたアンタも見たかったけど？」"

#. Occurrence 2_4:1030:2729: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0017; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1030
msgctxt "text_id=2729 | speaker=tobimaru"
msgid "\"Don't even go there. Even thinking about it gives me the creeps."
msgstr "「やめてくれ、ゾッとしねえ。"

#. Occurrence 2_4:1036:2730: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0018; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1036
msgctxt "text_id=2730 | speaker=tobimaru"
msgid "  Having one wolf in sheep's clothing around here is bad enough.\""
msgstr "　ネコかぶるのはおまえだけで十分だ」"

#. Occurrence 2_4:1047:2731: scene=2_4
#: 2_4:1047
msgctxt "text_id=2731 | speaker=unknown"
msgid "  Tobimaru shooed Aoko away like an annoying pest."
msgstr "　しっしっ、と青子に手を振る鳶丸。"

#. Occurrence 2_4:1052:2732: scene=2_4
#: 2_4:1052
msgctxt "text_id=2732 | speaker=unknown"
msgid "  It was a typical example of the crude verbal abuse they exchanged on a daily basis, with a wittiness that only two longtime foes could manage."
msgstr "　男女にあるまじき戦いを繰り広げた者特有の、実にさっぱりした<罵|ののし>り合いだった。"

#. Occurrence 2_4:1089:2733: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0014; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1089
msgctxt "text_id=2733 | speaker=aoko"
msgid "\"So..."
msgstr "「―――で。"

msgctxt "text_id=2734 | speaker=unknown"
msgid " Why did you tell him?\""
msgstr "なんでそんな話したのよ」"

#. Occurrence 2_4:1112:2735: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0019; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1112
msgctxt "text_id=2735 | speaker=tobimaru"
msgid "\"Tell who what?\""
msgstr "「は？」"

#. Occurrence 2_4:1118:2736: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0015; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1118
msgctxt "text_id=2736 | speaker=aoko"
msgid "\"Why did you tell him what happened between you and me?\""
msgstr "「半年前の、ここの事件を、なんで彼に話したのよ」"

#. Occurrence 2_4:1130:2737: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0020; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1130
msgctxt "text_id=2737 | speaker=tobimaru"
msgid "\"Oh, that."
msgstr "「あ、そっちか。"

#. Occurrence 2_4:1130:2738: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0020; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1130
msgctxt "text_id=2738 | speaker=tobimaru"
msgid "  I was just trying to put a stop to the nonsense he was spewing and―\""
msgstr "　いや、あいつが馬鹿なこと口走ったからなんだが―――」"

#. Occurrence 2_4:1135:2739: scene=2_4
#: 2_4:1135
msgctxt "text_id=2739 | speaker=unknown"
msgid "  He stopped himself before he said any more."
msgstr "　その先は言えない。"

#. Occurrence 2_4:1155:2740: scene=2_4
#: 2_4:1155
msgctxt "text_id=2740 | speaker=unknown"
msgid "  He knew better than to let slip the fact that Soujyuro had a thing for Aoko. Everyone knew guys didn't sell each other out like that."
msgstr "　静希草十郎が蒼崎青子に惚れている、という事実は口に出来ない事だ。<漢|おとこ>としての暗黙の了解である。"

#. Occurrence 2_4:1155:2741: scene=2_4
#: 2_4:1155
msgctxt "text_id=2741 | speaker=unknown"
msgid "  Even if it was all, in truth, a misunderstanding."
msgstr "　たとえ、それが彼の勘違いでもだ。"

#. Occurrence 2_4:1181:2742: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0021; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1181
msgctxt "text_id=2742 | speaker=tobimaru"
msgid "\"Anyway, what the hell was that before, Aozaki?"
msgstr "「それより、さっきのはないんじゃねえのか蒼崎。"

#. Occurrence 2_4:1187:2743: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0022; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1187
msgctxt "text_id=2743 | speaker=tobimaru"
msgid "  That's some grudge you've got against Soujyuro.\""
msgstr "　おまえ、草十郎に恨みでもあんの？」"

#. Occurrence 2_4:1198:2744: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0016; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1198
msgctxt "text_id=2744 | speaker=aoko"
msgid "\"I'm not some princess who goes around holding grudges for something that happened over a week ago, you know.\""
msgstr "「七日以上前の恨みを引きずるほど、私はお姫さまじゃないつもりだけど」"

#. Occurrence 2_4:1208:2745: scene=2_4
#: 2_4:1208
msgctxt "text_id=2745 | speaker=unknown"
msgid "  He wanted to retort that she was more like a queen than a princess."
msgstr "　ああ、おまえはお姫さまっていうより女王さまだな、と言いかけて止める鳶丸。"

#. Occurrence 2_4:1218:2746: scene=2_4
#: 2_4:1218
msgctxt "text_id=2746 | speaker=unknown"
msgid "  But he'd come to know her too well over the past two years to dig himself into a hole like that."
msgstr "　彼もこの二年で、十分に蒼崎青子を学習しているのだった。"

#. Occurrence 2_4:1244:2747: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0023; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1244
msgctxt "text_id=2747 | speaker=tobimaru"
msgid "\"Okay, so why'd you a pick a fight with him?"
msgstr "「恨みはないねえ。それにしちゃあ故意にケンカ売ってただろ。なんでだ？"

#. Occurrence 2_4:1251:2748: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0024; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1251
msgctxt "text_id=2748 | speaker=tobimaru"
msgid "  I mean, he does throw you off when you talk to him, but there's not an evil bone in his body.\""
msgstr "　たしかに調子の狂うヤツだが、あいつほどいいヤツはいねえだろうに」"

#. Occurrence 2_4:1284:2749: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0017; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1284
msgctxt "text_id=2749 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 2_4:1290:2750: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0025; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1290
msgctxt "text_id=2750 | speaker=tobimaru"
msgid "\"Wow. Why are you looking at me like you just stepped in a turd?\""
msgstr "「おい待て。なんだその、足下の白アリを見るかのような態度は」"

#. Occurrence 2_4:1296:2751: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0018; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1296
msgctxt "text_id=2751 | speaker=aoko"
msgid "\"Oh, no big reason. Hearing you say that, I was just thinking that I've never met such a despicable person in my life.\""
msgstr "「別に。アンタまでその台詞を言うのかって、心底から見下げ果てただけよ」"

#. Occurrence 2_4:1330:2752: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0019; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1330
msgctxt "text_id=2752 | speaker=aoko"
msgid "\"...Well, whatever. So he's a good guy? That makes him the perfect person to pick a fight with. If nobody else'll do it, the job falls to me, right?\""
msgstr "「……まあいいか。いいヤツ、いいひと、結構じゃない？　ケンカを売る相手としちゃあ上等だわ。誰も憎んであげないなら、私ぐらいそうしないとね」"

#. Occurrence 2_4:1344:2753: scene=2_4
#: 2_4:1344
msgctxt "text_id=2753 | speaker=unknown"
msgid "  She said casually, having regained her composure."
msgstr "　うん、と気を取り直して気軽に言う青子。"

#. Occurrence 2_4:1365:2754: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0026; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1365
msgctxt "text_id=2754 | speaker=tobimaru"
msgid "\"You just can't help yourself, huh.\""
msgstr "「しないとねって、おまえ」"

#. Occurrence 2_4:1370:2755: scene=2_4
#: 2_4:1370
msgctxt "text_id=2755 | speaker=unknown"
msgid "  Tobimaru could not follow her reasoning at all."
msgstr "　鳶丸にはその結論がさっぱりである。"

#. Occurrence 2_4:1396:2756: scene=2_4
#: 2_4:1396
msgctxt "text_id=2756 | speaker=unknown"
msgid "  Tobimaru was used to Aoko's erratic trains of thought, but hating Soujyuro for no reason seemed needlessly cruel. His friend's naive and innocent face came to mind, and then he blurted,"
msgstr "　蒼崎青子のこういう思考の飛び方に慣れてはいる鳶丸だが、理由もなく嫌われる草十郎があんまりと言えばあんまりで、脳裏にはあの人畜無害な顔が浮かんでしまい、つい、"

#. Occurrence 2_4:1410:2757: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0027; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1410
msgctxt "text_id=2757 | speaker=tobimaru"
msgid "\"But Soujyuro's taken a shine to you, Aozaki. How can you hate him, knowing that?\""
msgstr "「けど草十郎は蒼崎が好きなんだぜ。それでも嫌いなのか？」"

#. Occurrence 2_4:1441:2758: scene=2_4
#: 2_4:1441
msgctxt "text_id=2758 | speaker=unknown"
msgid "  His vow of silence had lasted not even two minutes."
msgstr "　二分足らずで、言うべきではないという誓いを破っていた。"

#. Occurrence 2_4:1479:2759: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0028; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1479
msgctxt "text_id=2759 | speaker=tobimaru"
msgid "\"Oh. Um... What I meant was...\""
msgstr "「あ―――いや、今のはな、蒼崎」"

#. Occurrence 2_4:1485:2760: scene=2_4
#: 2_4:1485
msgctxt "text_id=2760 | speaker=unknown"
msgid "  He tried to take it back, but it was too late."
msgstr "　しまった、と口を閉ざすがもう遅い。"

#. Occurrence 2_4:1490:2761: scene=2_4
#: 2_4:1490
msgctxt "text_id=2761 | speaker=unknown"
msgid "  She had heard his words loud and clear."
msgstr "　そして閉まったものは仕方がない。"

#. Occurrence 2_4:1496:2762: scene=2_4
#: 2_4:1496
msgctxt "text_id=2762 | speaker=unknown"
msgid "All he could hope for now was that she would take it well."
msgstr "こうなると青子の反応に一縷の望みをかける鳶丸だが―――"

#. Occurrence 2_4:1531:2763: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0020; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1531
msgctxt "text_id=2763 | speaker=aoko"
msgid "\"Because I like what I like and dislike what I don't like."
msgstr "「そりゃそうでしょ、好き嫌いは誰にもあるし。"

#. Occurrence 2_4:1537:2764: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0021; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1537
msgctxt "text_id=2764 | speaker=aoko"
msgid "  Just because he wants to be friends doesn't mean I have to suddenly like him.\""
msgstr "　けどこればかりはね。彼が私と仲良くしたいって言っても、私は嫌いなんだから仕方ない」"

#. Occurrence 2_4:1543:2765: scene=2_4
#: 2_4:1543
msgctxt "text_id=2765 | speaker=unknown"
msgid "  Stone. Cold. Aoko."
msgstr "　ドライと言えばドライ。"

#. Occurrence 2_4:1548:2766: scene=2_4
#: 2_4:1548
msgctxt "text_id=2766 | speaker=unknown"
msgid "  Tobimaru found himself filled with indignation at how detached Aoko was being."
msgstr "　スマートと言えばスマートな青子の感想に、柄にもなく憤慨してしまうのだった。"

#. Occurrence 2_4:1582:2767: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0029; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1582
msgctxt "text_id=2767 | speaker=tobimaru"
msgid "\"Don't you get it? This isn't just about friendship!"
msgstr "「いや、そんなお友達感覚の話じゃなくてだな！"

#. Occurrence 2_4:1588:2768: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0030; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1588
msgctxt "text_id=2768 | speaker=tobimaru"
msgid "  And I didn't mean he only 'likes' you, either! Believe me when I say that Sono-G really has a thing for you!\""
msgstr "　そういう好き嫌いじゃなくて、草の字は本気でおまえに惚れてるって言ったんだよ！」"

#. Occurrence 2_4:1607:2769: scene=2_4
#: 2_4:1607
msgctxt "text_id=2769 | speaker=unknown"
msgid "  He shouted, his face the embodiment of sincerity."
msgstr "　真顔で怒鳴る鳶丸。"

#. Occurrence 2_4:1612:2770: scene=2_4
#: 2_4:1612
msgctxt "text_id=2770 | speaker=unknown"
msgid "  Aoko gave him a blank stare."
msgstr "　それに、青子はぽかんとした顔を向けていた。"

#. Occurrence 2_4:1632:2771: scene=2_4
#: 2_4:1632
msgctxt "text_id=2771 | speaker=unknown"
msgid "  It was the face of someone who had lost their wallet hours earlier and was only just realizing it now."
msgstr "　まっさらなその顔は、何時間か前に財布を落とした、と気付いた放心に似ている。"

#. Occurrence 2_4:1637:2772: scene=2_4
#: 2_4:1637
msgctxt "text_id=2772 | speaker=unknown"
msgid "  The first instant of doubt that ushers in the reality of the situation."
msgstr "　なんでこんな<現実|コト>になってるのか、と我を疑う一瞬の間。"

#. Occurrence 2_4:1642:2773: scene=2_4
#: 2_4:1642
msgctxt "text_id=2773 | speaker=unknown"
msgid "  But, an instant is all it was."
msgstr "　それは本当に一瞬で、"

#. Occurrence 2_4:1679:2774: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0022; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1679
msgctxt "text_id=2774 | speaker=aoko"
msgid "\"So what?\""
msgstr "「で？」"

#. Occurrence 2_4:1685:2775: scene=2_4
#: 2_4:1685
msgctxt "text_id=2775 | speaker=unknown"
msgid "  She answered coolly,"
msgstr "　何でもないコトのように、平然と青子は聞き返した。"

#. Occurrence 2_4:1690:2776: scene=2_4
#: 2_4:1690
msgctxt "text_id=2776 | speaker=unknown"
msgid "  as if she had no idea why it should matter to her at all."
msgstr "　それが、一体、私にどんな意味があるのかと。"

#. Occurrence 2_4:1726:2777: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0031; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1726
msgctxt "text_id=2777 | speaker=tobimaru"
msgid "\"'So what'?! Were you born in hell?! I'll assume you didn't hear me and I'll say it again. Soujyuro-\""
msgstr "「で？　ときたか。鬼でもなけりゃ悪魔だな、おまえって女は。よかろう、聞こえなかったのならもう一度言ってやる」"

#. Occurrence 2_4:1732:2778: scene=2_4
#: 2_4:1732
msgctxt "text_id=2778 | speaker=unknown"
msgid "  Tobimaru gave up any pretense of masculine solidarity and fired back hard."
msgstr "　こうなったら漢の約束もあったもんじゃない、と開き直る鳶丸。"

#. Occurrence 2_4:1752:2779: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0023; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1752
msgctxt "text_id=2779 | speaker=aoko"
msgid "\"Don't bother. I couldn't care less.\""
msgstr "「いいわよそんなの。つまらないもの」"

#. Occurrence 2_4:1770:2780: scene=2_4
#: 2_4:1770
msgctxt "text_id=2780 | speaker=unknown"
msgid "  She ruthlessly cut him off."
msgstr "　それをあっさりと、心底からの感想で彼女は切り捨てた。"

#. Occurrence 2_4:1806:2781: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0032; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1806
msgctxt "text_id=2781 | speaker=tobimaru"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 2_4:1812:2782: scene=2_4
#: 2_4:1812
msgctxt "text_id=2782 | speaker=unknown"
msgid "  Thinking of the boys who still harbored unrequited love for Aoko, Tobimaru tried hard to come up with a name befitting the demoness in front of him."
msgstr "　とりあえず、学校中のいまだ健気に片思いをしている男子生徒のため、この悪鬼に相応しい呼称はないかと模索する鳶丸だった。"

#. Occurrence 2_4:1860:2783: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0024; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1860
msgctxt "text_id=2783 | speaker=aoko"
msgid "\"Now I see. So that's why you told him about our little incident."
msgstr "「なるほどね、それでさっきの話に結びつくワケだ。"

#. Occurrence 2_4:1871:2784: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0025; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1871
msgctxt "text_id=2784 | speaker=aoko"
msgid "  Who could have thought His Highness could be so considerate to his friends?"
msgstr "　へぇー、柄にもなく友達思いじゃない殿下？"

#. Occurrence 2_4:1877:2785: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0026; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1877
msgctxt "text_id=2785 | speaker=aoko"
msgid "  I bet you also told him all the nasty rumors floating about me, too, huh.\""
msgstr "　ってコトは聞くも無惨、語るも無情っていう私の噂話、教えてあげたんでしょう？」"

#. Occurrence 2_4:1883:2786: scene=2_4
#: 2_4:1883
msgctxt "text_id=2786 | speaker=unknown"
msgid "  She laughed as a fiendish smile adorned her face."
msgstr "　ふふ、と妖しい笑みを浮かべる青子。"

#. Occurrence 2_4:1888:2787: scene=2_4
#: 2_4:1888
msgctxt "text_id=2787 | speaker=unknown"
msgid "  Tobimaru repented to God, whoever and wherever he or she might be, for ever bringing up Aoko's love life."
msgstr "　鳶丸はこの相手に色恋ざたの話をした事を、どっかにいる神さまに懺悔した。"

#. Occurrence 2_4:1922:2788: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0027; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1922
msgctxt "text_id=2788 | speaker=aoko"
msgid "\"You did the right thing, Tobimaru. Now be a good little vice president and tell me every single thing you told him.\""
msgstr "「鳶丸にしちゃあ正しい判断ね。誉めてあげるから、どんな話をしたのか聞きたいなー、私」"

#. Occurrence 2_4:1927:2789: scene=2_4
#: 2_4:1927
msgctxt "text_id=2789 | speaker=unknown"
msgid "  She was smiling, but Tobimaru wished she'd at least try to hide the bloodlust."
msgstr "　笑顔のくせに殺気を放つのは止めてほしい。"

#. Occurrence 2_4:1950:2790: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0033; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1950
msgctxt "text_id=2790 | speaker=tobimaru"
msgid "\"Just two things, really... The story you're most infamous for, and what happened in this room.\""
msgstr "「……代表作と、ここでの事件を二つばかり」"

#. Occurrence 2_4:1955:2791: scene=2_4
#: 2_4:1955
msgctxt "text_id=2791 | speaker=unknown"
msgid "  Aoko nodded with satisfaction as she listened to Tobimaru's hesitant answer."
msgstr "　遠慮がちな鳶丸の返答を聞いて、満足げに頷く青子。"

#. Occurrence 2_4:1991:2792: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0028; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1991
msgctxt "text_id=2792 | speaker=aoko"
msgid "\"Rumors like those can come in handy sometimes. You can use them chase off annoying people. Just be careful about who you tell, okay?\""
msgstr "「こういう時、噂話って便利よね。うるさいのを追っ払ってくれるから。でも、そんな話を考えなしで広めたら大変だから、これからは気をつけてね」"

#. Occurrence 2_4:2012:2793: scene=2_4
#: 2_4:2012
msgctxt "text_id=2793 | speaker=unknown"
msgid "  Had this been in writing, the chillingly sweet tone of her words could've been signed with a heart."
msgstr "　それは、語尾にハートマークでもつきそうな、ゾッとするほど甘い笑顔だった。"

#. Occurrence 2_4:2048:2794: scene=2_4
#: 2_4:2048
msgctxt "text_id=2794 | speaker=unknown"
msgid "  Whether angry or happy, Aozaki spoke in a disturbingly cute manner when she was in a heightened emotional state."
msgstr "　怒りにしろ喜びにしろ、感情がハイになると蒼崎は可愛らしい口調になる……"

#. Occurrence 2_4:2053:2795: scene=2_4
#: 2_4:2053
msgctxt "text_id=2795 | speaker=unknown"
msgid "  Tobimaru took note of this new discovery, aware that it did nothing to get him out of this situation."
msgstr "　そんな新事実を発見した鳶丸だが、だからといってこの場がどうにかなる訳でもない。"

#. Occurrence 2_4:2091:2796: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0034; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2091
msgctxt "text_id=2796 | speaker=tobimaru"
msgid "\"Don't worry. I value my life, so I'll shut my mouth."
msgstr "「ああ、俺も命は惜しいからな、口はもう滑らねえよ。"

#. Occurrence 2_4:2103:2797: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0035; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2103
msgctxt "text_id=2797 | speaker=tobimaru"
msgid "  ...But Aozaki... Do you really hate Soujyuro that much?\""
msgstr "　……けどよ蒼崎。本気で草十郎が嫌いなのか？」"

#. Occurrence 2_4:2124:2798: scene=2_4
#: 2_4:2124
msgctxt "text_id=2798 | speaker=unknown"
msgid "  He knew that it was a topic he would be better off avoiding, but he tried asking anyway."
msgstr "　もうこの話題は避けるべきだと分かっていても<果敢|かかん>に挑む鳶丸。"

#. Occurrence 2_4:2129:2799: scene=2_4
#: 2_4:2129
msgctxt "text_id=2799 | speaker=unknown"
msgid "  The bonds between men, at times, shine more beautifully than a pearl."
msgstr "　男の友情というものは、時に真珠より美しい。"

#. Occurrence 2_4:2162:2800: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0029; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2162
msgctxt "text_id=2800 | speaker=aoko"
msgid "\"Well... I might not like him... but that doesn't mean I hate him. I'm not even sure why I feel the way I do."
msgstr "「まあ……好きじゃないから嫌い、っていうワケじゃないけど。私が彼の事を嫌う理由は自分でも分からない。"

#. Occurrence 2_4:2192:2801: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0030; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2192
msgctxt "text_id=2801 | speaker=aoko"
msgid "  Which is probably the problem.\""
msgstr "　だからダメなのね、きっと」"

#. Occurrence 2_4:2197:2802: scene=2_4
#: 2_4:2197
msgctxt "text_id=2802 | speaker=unknown"
msgid "  Perhaps to placate Tobimaru, Aoko paused in contemplation before she answered."
msgstr "　鳶丸の顔を立てていくらか思考実験したのか、青子はしばし悩んでからそんな返答をする。"

#. Occurrence 2_4:2202:2803: scene=2_4
#: 2_4:2202
msgctxt "text_id=2803 | speaker=unknown"
msgid "  Giving it a moment without immediately blurting out a response meant that not even he could complain."
msgstr "　即答ではなく熟考しての答えなら、鳶丸も文句を言う筋合いはない。"

#. Occurrence 2_4:2241:2804: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0036; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2241
msgctxt "text_id=2804 | speaker=tobimaru"
msgid "\"Huh. I guess that makes sense."
msgstr "「そうか。ま、そういうコトならしょうがねえか。"

#. Occurrence 2_4:2252:2805: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0037; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2252
msgctxt "text_id=2805 | speaker=tobimaru"
msgid "  As much as emotional arguments can make sense. There's nothing I can do if neither of you understand why you feel the way you do.\""
msgstr "　なにしろきれいさっぱり感情論だ。お互い理由もなく好きと嫌いじゃ手を貸す隙間もねえワケだし」"

#. Occurrence 2_4:2257:2806: scene=2_4
#: 2_4:2257
msgctxt "text_id=2806 | speaker=unknown"
msgid "  Thinking that would be the end of it, Tobimaru looked up toward the ceiling and silently apologized to Soujyuro."
msgstr "　これでこの話は終わりか、と草十郎に謝りながら天をあおぐ鳶丸。"

#. Occurrence 2_4:2275:2807: scene=2_4
#: 2_4:2275
msgctxt "text_id=2807 | speaker=unknown"
msgid "  However..."
msgstr "　しかし。"

#. Occurrence 2_4:2294:2808: scene=2_4
#: 2_4:2294
msgctxt "text_id=2808 | speaker=unknown"
msgid "  His final sentence appeared to have piqued Aoko's interest."
msgstr "　その降参を告げる一言が、蒼崎青子の興味を引いたらしい。"

#. Occurrence 2_4:2320:2809: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0031; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2320
msgctxt "text_id=2809 | speaker=aoko"
msgid "\"...Wait. What do you mean by that?\""
msgstr "「……待って。今の、どういう意味？」"

#. Occurrence 2_4:2326:2810: scene=2_4
#: 2_4:2326
msgctxt "text_id=2810 | speaker=unknown"
msgid "  Her faux cheer had vanished."
msgstr "　上機嫌ぽかった口調が変わる。"

#. Occurrence 2_4:2331:2811: scene=2_4
#: 2_4:2331
msgctxt "text_id=2811 | speaker=unknown"
msgid "  Failing to pick up on this, Tobimaru answered nonchalantly."
msgstr "　それに気付かず、軽い気持ちで鳶丸は答えた。"

#. Occurrence 2_4:2358:2812: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0038; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2358
msgctxt "text_id=2812 | speaker=tobimaru"
msgid "\"Oh, nothing. It's just that Soujyuro also said he wasn't exactly sure why he liked you... or more like, there was no particular reason for how he felt, I think.\""
msgstr "「いやアイツもさ、蒼崎に惚れた理由が分からない、なんて言いやがってよ。……ああ、違ったか、理由なんてない、なんて意味だったかな」"

#. Occurrence 2_4:2364:2813: scene=2_4
#: 2_4:2364
msgctxt "text_id=2813 | speaker=unknown"
msgid "  Tobimaru was still in disbelief that Soujyuro had been charmed by Aoko's appearance, so he purposely left that part out."
msgstr "　鳶丸は“青子の外見に惹かれた”なんて草十郎の言葉を信じていないので、そこはあっさりと切り離す。"

#. Occurrence 2_4:2391:2814: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0032; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2391
msgctxt "text_id=2814 | speaker=aoko"
msgid "\"He said he likes me... for no reason?\""
msgstr "「理由はない、ですって……？」"

#. Occurrence 2_4:2404:2815: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0039; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2404
msgctxt "text_id=2815 | speaker=tobimaru"
msgid "\"Yeah. I mean, I even told him about all the rumors around you, and it had no effect on him whatsoever. What did he say again...? Oh, right. He was going on about how genuine your concern for him was, and how it really helped him. It's almost too mushy for me to repeat out loud."
msgstr "「ああ。なんで、俺がいくらおまえの噂話をしても無駄だった。あまつさえなんて言ってたかな……そうそう、理由はどうあれ、蒼崎の心配は本物なんだ、とか、自分はそれで助かってるとか。俺なんかにゃ言えない台詞だったのは確かだね、どーにも。"

#. Occurrence 2_4:2417:2816: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0040; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2417
msgctxt "text_id=2816 | speaker=tobimaru"
msgid "  All I can say is that, unlike the other boys, the rumors didn't faze him in the least.\""
msgstr "　はっきりしてんのは他の野郎どもと違って、噂を聞いても手を引く素振りなんざ微塵もなかったって事だけ―――」"

#. Occurrence 2_4:2454:2817: scene=2_4
#: 2_4:2454
msgctxt "text_id=2817 | speaker=unknown"
msgid "  Tobimaru finally noticed the shift in Aoko's demeanor."
msgstr "　そこまで調子よく語って、鳶丸は青子の変化に気が付いた。"

#. Occurrence 2_4:2477:2818: scene=2_4
#: 2_4:2477
msgctxt "text_id=2818 | speaker=unknown"
msgid "  She was scowling at the wall."
msgstr "　彼女は壁を睨んでいる。"

#. Occurrence 2_4:2482:2819: scene=2_4
#: 2_4:2482
msgctxt "text_id=2819 | speaker=unknown"
msgid "  She glared at it in silence like it was her worst enemy, and this continued for several minutes."
msgstr "　その、仇を見るような視線は無言のまま何分か続けられた。"

#. Occurrence 2_4:2530:2820: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0033; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2530
msgctxt "text_id=2820 | speaker=aoko"
msgid "\"...What the hell is that? Why can't I shake the feeling that I've heard all this before somewhere.\""
msgstr "「……なにそれ。さっきといいそれといい、どこかで聞いたような事ばっかり―――」"

#. Occurrence 2_4:2569:2821: scene=2_4
#: 2_4:2569
msgctxt "text_id=2821 | speaker=unknown"
msgid "  So great was her ire that the gnashing of her teeth was audible."
msgstr "　ぎり、と歯を噛む音がする。"

#. Occurrence 2_4:2574:2822: scene=2_4
#: 2_4:2574
msgctxt "text_id=2822 | speaker=unknown"
msgid "  The irritation seethed until it reached the point that Aoko forgot Tobimaru was even in the room."
msgstr "　反感ここに極まり、あまりの不機嫌さに目の前にいる鳶丸が視界に入っていないようだ。"

#. Occurrence 2_4:2584:2823: scene=2_4
#: 2_4:2584
msgctxt "text_id=2823 | speaker=unknown"
msgid "  Tobimaru looked heavenward for forgiveness, sensing that he'd brought further calamity down upon Soujyuro's head."
msgstr "　なんか、また絶望的に草十郎に迷惑かける事を言っちまったな、と鳶丸は天をあおいだ。"

#. Occurrence 2_4:2649:2824: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0034; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2649
msgctxt "text_id=2824 | speaker=aoko"
msgid "\"...I kind of get it now. I think I know why I don't like him.\""
msgstr "「……少し分かったわ。なんでアイツが気に喰わないのか」"

#. Occurrence 2_4:2661:2825: scene=2_4
#: 2_4:2661
msgctxt "text_id=2825 | speaker=unknown"
msgid "  Tobimaru looked away as if to indicate that he'd rather not know, but Aoko ignored him and began to grumble venomously."
msgstr "　聞きたくない、どっかよそで喋ってくれないもんかなー、などと目を逸らす鳶丸を無視して、青子は<呪詛|じゅそ>のように言葉を紡ぐ。"

#. Occurrence 2_4:2687:2826: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0035; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2687
msgctxt "text_id=2826 | speaker=aoko"
msgid "\"The way he acts and talks reminds me of someone I despise."
msgstr "「あいつ、私が嫌いな奴と言動が似てるのよ。"

#. Occurrence 2_4:2693:2827: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0036; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2693
msgctxt "text_id=2827 | speaker=aoko"
msgid "  Like how everyone thinks he's an angel, and how nothing seems to bother him. Maybe it's how good he is at getting on my nerves.\""
msgstr "　誰彼かまわずいい人扱いされるところとか。妙にふわふわしてるところとか。いちいち私の癇に障るところとか」"

#. Occurrence 2_4:2711:2828: scene=2_4
#: 2_4:2711
msgctxt "text_id=2828 | speaker=unknown"
msgid "  Glancing idly up at the clock, Tobimaru thought that last part just sounded like misplaced anger."
msgstr "　最後のはただの八つ当たりだよな、と所在なげに時計とか見てみる副会長。"

#. Occurrence 2_4:2733:2829: scene=2_4
#: 2_4:2733
msgctxt "text_id=2829 | speaker=unknown"
msgid "  And that was that."
msgstr "　―――と。"

#. Occurrence 2_4:2738:2830: scene=2_4
#: 2_4:2738
msgctxt "text_id=2830 | speaker=unknown"
msgid "  One o'clock had come and gone."
msgstr "　時計は、当然のように午後一時を回っていた。"

#. Occurrence 2_4:2782:2831: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0041; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2782
msgctxt "text_id=2831 | speaker=tobimaru"
msgid "\"...Fine. I get it. Sorry I said anything."
msgstr "「……分かった、もういい。この話をした俺が悪かった。"

#. Occurrence 2_4:2793:2832: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0042; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2793
msgctxt "text_id=2832 | speaker=tobimaru"
msgid "  So did you need me for anything? Class has already started, you know.\""
msgstr "　で、俺に用ってのはなんだよ。言っとくけど、もう授業始まってるぜ？」"

#. Occurrence 2_4:2812:2833: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0037_0; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2812
msgctxt "text_id=2833 | speaker=aoko"
msgid "\"Huh? What do you mean by class?  "
msgstr "「へ？　授業って、なんで？　"

#. Occurrence 2_4:2824:2834: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0037_1; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2824
msgctxt "text_id=2834 | speaker=aoko"
msgid "When did it...\""
msgstr "いつ？」"

#. Occurrence 2_4:2835:2835: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0043; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2835
msgctxt "text_id=2835 | speaker=tobimaru"
msgid "\"The bell rang right after Sono-G left, around the time you were busy being pissed off at the wall. Tell me, Ms. President. Are you allowed to miss fifth period?\""
msgstr "「いや、さっき草の字が出てってから、蒼崎がぎらーんって壁睨んでた時にチャイムが鳴ったんだよ。いいのか生徒会長。五時限目ばっくれて」"

#. Occurrence 2_4:2929:2836: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0038; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2929
msgctxt "text_id=2836 | speaker=aoko"
msgid "\"Of course I'm not!"
msgstr "「っ、いいわけないでしょ！"

msgctxt "text_id=2837 | speaker=unknown"
msgid "  Why didn't you say something!?\""
msgstr "　なんで黙ってんのよアンタはーっ！」"

#. Occurrence 2_4:2938:2838: scene=2_4
#: 2_4:2938
msgctxt "text_id=2838 | speaker=unknown"
msgid "  She looked like she was on the verge of tears as she shouted and pulled at his necktie."
msgstr "　鳶丸のネクタイをひっぱりながら、半泣き状態で青子は怒鳴る。"

#. Occurrence 2_4:2944:2839: scene=2_4
#: 2_4:2944
msgctxt "text_id=2839 | speaker=unknown"
msgid "Tobimaru raised his hands in mock surrender―a gesture reserved only for the true victor."
msgstr "対して、鳶丸は両手をギブアップの形で上げていた。勝者の余裕である。"

#. Occurrence 2_4:2980:2840: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0044; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2980
msgctxt "text_id=2840 | speaker=tobimaru"
msgid "\"Consider this revenge for saying I was worse than a mosquito."
msgstr "「蚊のほうがエレガントなんて言いやがった仕返しだ。"

#. Occurrence 2_4:2980:2841: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0044; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2980
msgctxt "text_id=2841 | speaker=tobimaru"
msgid "  Hopefully you've learned your lesson, oh hellish demon who feasts upon the hearts of men.\""
msgstr "　思い知るがいい、男の純情を踏みにじったり焼き殺したりするエリート悪魔め」"

#. Occurrence 2_4:2999:2842: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0039; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2999
msgctxt "text_id=2842 | speaker=aoko"
msgid "\"You're so petty, you know that!?"
msgstr "「あいかわらず細かく根に持つ男！"

#. Occurrence 2_4:2999:2843: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0039; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2999
msgctxt "text_id=2843 | speaker=aoko"
msgid "  You're supposed to repay insults with insults, you coward!\""
msgstr "　言動には言動で返しなさいよね、卑怯者！」"

#. Occurrence 2_4:3005:2844: scene=2_4
#: 2_4:3005
msgctxt "text_id=2844 | speaker=unknown"
msgid "  She tightened his necktie around his neck with a yank."
msgstr "　鳶丸の首にぐいぐいとネクタイが締まっていく。"

#. Occurrence 2_4:3010:2845: scene=2_4
#: 2_4:3010
msgctxt "text_id=2845 | speaker=unknown"
msgid "  The vice president smiled a thuggish grin, as if her reaction made his victory that much sweeter."
msgstr "　それすら勝者の愉悦、とチンピラ顔で笑う副会長。"

#. Occurrence 2_4:3057:2846: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0045; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:3057
msgctxt "text_id=2846 | speaker=tobimaru"
msgid "\"Heh. It's no secret you're heading to remedial classics. And I don't have to tell you who teaches Class A during fifth period. Old bat Fujishiro is going to have your head!\""
msgstr "「ふふふ、おまえの古典が<補習|はめつ>に向かっているのは周知の事実。そしてＡ組の五時限目は言うまでもない。<藤代|ふじしろ>のばあさん、蒼崎のこと嫌ってるしな」"

#. Occurrence 2_4:3063:2847: scene=2_4
#: 2_4:3063
msgctxt "text_id=2847 | speaker=unknown"
msgid "  Fujishiro had one of the longest tenures at the school, so it was only natural she would be in charge of teaching the classics."
msgstr "　藤代というのは古参教師のひとりで、言うまでもなく、担当は古典である。"

#. Occurrence 2_4:3084:2848: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0046; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:3084
msgctxt "text_id=2848 | speaker=tobimaru"
msgid "\"This is where you stop yanking on my tie and haul ass to your classroom."
msgstr "「さあ、こんな所で俺のネクタイを引っぱる余裕があるのなら、急いで自分の教室に立ち返るがいい。"

#. Occurrence 2_4:3090:2849: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0047; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:3090
msgctxt "text_id=2849 | speaker=tobimaru"
msgid "  I won't even try to stop you. Am I not merciful?\""
msgstr "　情けだ、別に止めはしねえよ」"

#. Occurrence 2_4:3121:2850: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0040; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:3121
msgctxt "text_id=2850 | speaker=aoko"
msgid "\"Damn! It! All! I can't believe you of all people pulled one over on me!"
msgstr "「っっっクソ、あんたなんかに嵌められるなんて！"

#. Occurrence 2_4:3121:2851: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0040; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:3121
msgctxt "text_id=2851 | speaker=aoko"
msgid "  Just die already!\""
msgstr "　えぇい、このまま死んでしまえ！」"

#. Occurrence 2_4:3127:2852: scene=2_4
#: 2_4:3127
msgctxt "text_id=2852 | speaker=unknown"
msgid "  She choked him even harder with his necktie."
msgstr "　さらに締まるネクタイ。"

#. Occurrence 2_4:3132:2853: scene=2_4
#: 2_4:3132
msgctxt "text_id=2853 | speaker=unknown"
msgid "  As Aoko put words into action and mercilessly strangled Tobimaru, he saw his life flash before his eyes."
msgstr "　有言実行、容赦のない青子の窒息攻撃にひととき、神を見る鳶丸だった。"

#. Occurrence 2_4:3182:2854: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0048; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:3182
msgctxt "text_id=2854 | speaker=tobimaru"
msgid "\"Ggahhhh! Wait! Stop! I'm gonna die! It isn't too late! Do you want them to mark you absent!?\""
msgstr "「―――ハ！？　いや、待て待て、ホントに死んじまうだろうがっ！　今ならまだ間に合う、十分過ぎたら遅刻から欠席扱いだぞ！？」"

#. Occurrence 2_4:3188:2855: scene=2_4
#: 2_4:3188
msgctxt "text_id=2855 | speaker=unknown"
msgid "  Aoko glanced up at the clock."
msgstr "　とっさに時計を見る青子。"

#. Occurrence 2_4:3208:2856: scene=2_4
#: 2_4:3208
msgctxt "text_id=2856 | speaker=unknown"
msgid "  It was still only seven past one. Her route was from the student council room on the second floor to the Class A classroom on the third floor. If she ran she could make it."
msgstr "　時刻は午後一時七分。二階である第二生徒会室から、三階端のＡ組の教室まで走ればギリギリ間に合う距離だった。"

#. Occurrence 2_4:3251:2857: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0041; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:3251
msgctxt "text_id=2857 | speaker=aoko"
msgid "\"I'll let you live, Tobimaru. This time.\""
msgstr "「命<拾|ひろ>ったわね、鳶丸」"

#. Occurrence 2_4:3257:2858: scene=2_4
#: 2_4:3257
msgctxt "text_id=2858 | speaker=unknown"
msgid "  Aoko clicked her tongue disappointedly."
msgstr "　ち、と言い捨てる青子。"

#. Occurrence 2_4:3262:2859: scene=2_4
#: 2_4:3262
msgctxt "text_id=2859 | speaker=unknown"
msgid "  What disturbed Tobimaru was that it didn't sound like an empty threat. "
msgstr "　あながち嘘でもないのが鳶丸的に頭がいたい。"

#. Occurrence 2_4:3308:2860: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0042; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:3308
msgctxt "text_id=2860 | speaker=aoko"
msgid "\"Be here after school."
msgstr "「あと放課後、ここにいて。"

#. Occurrence 2_4:3308:2861: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0042; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:3308
msgctxt "text_id=2861 | speaker=aoko"
msgid "  I actually do have something I need you to do.\""
msgstr "　頼みたい事があるのはホントなんだから」"

#. Occurrence 2_4:3332:2862: scene=2_4
#: 2_4:3332
msgctxt "text_id=2862 | speaker=unknown"
msgid "  She was halfway out of the room before she even finished her sentence."
msgstr "　言うが早いか、青子は隼のように生徒会室から飛び出していった。"

#. Occurrence 2_4:3380:2863: scene=2_4
#: 2_4:3380
msgctxt "text_id=2863 | speaker=unknown"
msgid "  Finally all alone,"
msgstr "　ようやくひとりになって、"

msgctxt "text_id=2864 | speaker=unknown"
msgid " Tobimaru closed the open door, locked it,"
msgstr "鳶丸は開けっぱなしの扉を閉め、鍵をかけて"

msgctxt "text_id=2865 | speaker=unknown"
msgid " and slumped into a chair."
msgstr "椅子に座る。"

#. Occurrence 2_4:3391:2866: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0049; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:3391
msgctxt "text_id=2866 | speaker=tobimaru"
msgid "\"...Never a dull moment with Aozaki around, that's for sure.\""
msgstr "「……ったく。ああしてる分には楽しいヤツなんだけどよ、蒼崎は」"

#. Occurrence 2_4:3397:2867: scene=2_4
#: 2_4:3397
msgctxt "text_id=2867 | speaker=unknown"
msgid "  He leaned back in the creaky folding chair and let out a sigh."
msgstr "　ギシリ、とパイプ椅子の背もたれを<軋|きし>ませてため息をつく。"

#. Occurrence 2_4:3454:2868: scene=2_4
#: 2_4:3454
msgctxt "text_id=2868 | speaker=unknown"
msgid "  The weather outside was beautiful."
msgstr "　窓の外は気持ちのいい晴れ模様。"

#. Occurrence 2_4:3459:2869: scene=2_4
#: 2_4:3459
msgctxt "text_id=2869 | speaker=unknown"
msgid "  But the sunlight waned early in the winter."
msgstr "　が、冬の日射しはすぐに弱くなっていく。"

#. Occurrence 2_4:3464:2870: scene=2_4
#: 2_4:3464
msgctxt "text_id=2870 | speaker=unknown"
msgid "  Before long, daylight would fade, and the unheated student council room would grow colder and colder."
msgstr "　じき日の勢いも翳って、暖房の入っていない生徒会室は段々と冷えていくだろう。"

#. Occurrence 2_4:3469:2871: scene=2_4
#: 2_4:3469
msgctxt "text_id=2871 | speaker=unknown"
msgid "  All of the good equipment, like the heater, had ended up in the main office, so he had no choice but to settle in for a chilly afternoon."
msgstr "　ストーブなんて気の利いた物は第一生徒会室に流れているので、この寒さには慣れろという他ないのだが。"

#. Occurrence 2_4:3558:2872: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0050; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:3558
msgctxt "text_id=2872 | speaker=tobimaru"
msgid "\"If only this weather would last..."
msgstr "「こんな天気が続けばいいんだがねぇ。"

#. Occurrence 2_4:3558:2873: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0050; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:3558
msgctxt "text_id=2873 | speaker=tobimaru"
msgid "  Shame the forecast predicted more clouds.\""
msgstr "　天気予報じゃ、また雲行き怪しいって話だが」"

#. Occurrence 2_4:3575:2874: scene=2_4
#: 2_4:3575
msgctxt "text_id=2874 | speaker=unknown"
msgid "  After his somewhat suggestive monologue, Tobimaru's mind drifted."
msgstr "　なんとなく暗示的な独白の後、鳶丸は草十郎の姿を思い浮べた。"

#. Occurrence 2_4:3580:2875: scene=2_4
#: 2_4:3580
msgctxt "text_id=2875 | speaker=unknown"
msgid "  He idly wondered to himself whether Soujyuro was an overcast day or a clear day sort of guy, but no answers came."
msgstr "　曇りと晴れ。そのどちらが彼らしいか考えてみたが、ついに答えは出なかった。"

#. Occurrence 2_5:55:2876: scene=2_5
#: 2_5:55
msgctxt "text_id=2876 | speaker=unknown"
msgid "  The school day over, Soujyuro headed straight to his job."
msgstr "　その日の学校が終わると、草十郎は寄り道一つせずアルバイト先に直行した。"

#. Occurrence 2_5:60:2877: scene=2_5
#: 2_5:60
msgctxt "text_id=2877 | speaker=unknown"
msgid "  While the school had approved his jobs at the Chinese restaurant and fish market in Misaki's shopping district, there was other work he hadn't mentioned to them."
msgstr "　学校側に申告してあるのは三咲町商店街にある中華飯店と鮮魚店だけで、他のアルバイトは秘密にしている。"

#. Occurrence 2_5:65:2878: scene=2_5
#: 2_5:65
msgctxt "text_id=2878 | speaker=unknown"
msgid "  And it was not because he knew that they would complain at him working too many, but rather because of the illicit nature of one job in particular."
msgstr "　それも単に数が多いからではなく、それ以前に法律に違反していそうな働き先だったからだ。"

#. Occurrence 2_5:121:2879: scene=2_5
#: 2_5:121
msgctxt "text_id=2879 | speaker=unknown"
msgid "  Today, his workplace was a pachinko parlor in front of Yashirogi Station."
msgstr "　今日のアルバイト先はその最たるもので、<社木|やしろぎ>駅前にあるパチンコ店だ。"

#. Occurrence 2_5:128:2880: scene=2_5
#: 2_5:128
msgctxt "text_id=2880 | speaker=unknown"
msgid "  Soujyuro changed out of his school uniform and into a black faux tuxedo uniform, then began cleaning the storefront."
msgstr "　学校の制服から店の黒いタキシードじみた制服に着替え、仕事はじめに店周りの掃除をする。"

#. Occurrence 2_5:174:2881: scene=2_5
#: 2_5:174
msgctxt "text_id=2881 | speaker=unknown"
msgid "  Yashirogi was the jewel of Misaki City, a busy place with a vast assortment of commercial centers and shopping arcades."
msgstr "　三咲市の顔である<社木|やしろぎ>の駅前は幾多のショッピングビルが競い合うように乱立し、アーケード街もそれらに<倣|なら>うように騒がしい。"

#. Occurrence 2_5:179:2882: scene=2_5
#: 2_5:179
msgctxt "text_id=2882 | speaker=unknown"
msgid "  Where there were people en masse, there were products made en masse."
msgstr "　人が多くなれば生み出される物も多くなる。"

#. Occurrence 2_5:184:2883: scene=2_5
#: 2_5:184
msgctxt "text_id=2883 | speaker=unknown"
msgid "  A romantic might describe it as a place of joy,"
msgstr "　浪漫として言えば笑顔であり、"

#. Occurrence 2_5:189:2884: scene=2_5
#: 2_5:189
msgctxt "text_id=2884 | speaker=unknown"
msgid "  a realist would note the free enterprise,"
msgstr "　現実的に言えば流通であり、"

#. Occurrence 2_5:194:2885: scene=2_5
#: 2_5:194
msgctxt "text_id=2885 | speaker=unknown"
msgid "  and a cynic would point at all the garbage."
msgstr "　より現実的に言えばゴミである。"

#. Occurrence 2_5:248:2886: scene=2_5
#: 2_5:248
msgctxt "text_id=2886 | speaker=unknown"
msgid "  Local authorities had attempted to beautify Yashirogi, but there was one basic tenet of society they could not overcome."
msgstr "　クリーンな町作りを目指している社木だが、そのルールには逆らえない。"

#. Occurrence 2_5:253:2887: scene=2_5
#: 2_5:253
msgctxt "text_id=2887 | speaker=unknown"
msgid "  This establishment was the embodiment of that rule."
msgstr "　それがこういった店なら尚更だ。"

#. Occurrence 2_5:258:2888: scene=2_5
#: 2_5:258
msgctxt "text_id=2888 | speaker=unknown"
msgid "  Businesses such as this attracted the dregs of society, and as such, the front of the parlor had to be cleaned several times a day."
msgstr "　商売柄<質|たち>の悪い人種を呼びこみやすいホールの前は、日に何度も清掃を心がけるべきである。"

#. Occurrence 2_5:279:2889: scene=2_5
#: 2_5:279
msgctxt "text_id=2889 | speaker=unknown"
msgid "  Soujyuro stood outside in the winter cold sweeping used-up cigarette butts, picking up discarded fliers, and tossing empty cans into the trash."
msgstr "　冬の寒空の下、草十郎は煙草の吸い殻を集め、チラシを拾い、空き缶をゴミ箱へ。"

#. Occurrence 2_5:284:2890: scene=2_5
#: 2_5:284
msgctxt "text_id=2890 | speaker=unknown"
msgid "  Something about it must have reminded him of mountain life, because he cheerfully finished the job with ease."
msgstr "　山での生活を彷彿とさせるものがあるらしく、草十郎は気軽に、淡々と掃除をこなした。"

#. Occurrence 2_5:339:2891: scene=2_5
#: 2_5:339
msgctxt "text_id=2891 | speaker=unknown"
msgid "  After making sure the storefront was acceptably clean, he returned to the inside of the parlor where it was nice and warm."
msgstr "　ひととおり店周りを綺麗にし、晴れて暖房の効いた店内に戻る。"

#. Occurrence 2_5:344:2892: scene=2_5
#: 2_5:344
msgctxt "text_id=2892 | speaker=unknown"
msgid "  Blinding lights, deafening sounds,"
msgstr "　まぶしく目に痛い騒音、"

#. Occurrence 2_5:349:2893: scene=2_5
#: 2_5:349
msgctxt "text_id=2893 | speaker=unknown"
msgid "  and the oppressive odor of tobacco assaulted him as he passed through the parlor on his way to the office."
msgstr "　充満するタバコの臭いに圧倒されながら店内を横断して事務所へ向かう。"

#. Occurrence 2_5:399:2894: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0000; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:399
msgctxt "text_id=2894 | speaker=soujuurou"
msgid "\"Boss, I've finished cleaning outside.\""
msgstr "「店長。外まわりの掃除、終わりました」"

#. Occurrence 2_5:405:2895: voice_id=D10_2_5_0000; voice_prefix=D10; voice_category=0; scene=2_5
#: 2_5:405
msgctxt "text_id=2895 | speaker=unknown"
msgid "\"Good job. I've got something else for you. Could you go check on the customer on machine forty on the second floor for me?"
msgstr "「はい、ごくろうさま。それで、いいかな。二階の四十番台のお客さんの様子、見てきてくれない？"

#. Occurrence 2_5:411:2896: voice_id=D10_2_5_0001; voice_prefix=D10; voice_category=0; scene=2_5
#: 2_5:411
msgctxt "text_id=2896 | speaker=unknown"
msgid "  I have a hunch she might be cheating.\""
msgstr "　どうも懐にのんでそうなんだよね、あのお姉さん」"

#. Occurrence 2_5:431:2897: scene=2_5
#: 2_5:431
msgctxt "text_id=2897 | speaker=unknown"
msgid "  His boss was a good-natured man who used to work a desk job."
msgstr "　元会社員の、人の良さそうな店長さんである。"

#. Occurrence 2_5:436:2898: scene=2_5
#: 2_5:436
msgctxt "text_id=2898 | speaker=unknown"
msgid "  The reason he employed someone like Soujyuro, even though he was clearly a student, was not because he admired him for working his way through school."
msgstr "　あきらかに学生である草十郎を採用したのはその苦学生ぶりに感動したから―――ではなく、"

#. Occurrence 2_5:441:2899: scene=2_5
#: 2_5:441
msgctxt "text_id=2899 | speaker=unknown"
msgid "  It was because all of the other employees were scary and intimidating, and he wanted at least one employee who was not."
msgstr "　店員がみんな怖い顔をしているので一人でも心安らげる店員がほしい、という理由らしい。"

#. Occurrence 2_5:462:2900: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0001; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:462
msgctxt "text_id=2900 | speaker=soujuurou"
msgid "\"Are you sure? I still haven't cleaned the toilets.\""
msgstr "「いいんですか？　トイレの掃除、まだですけど」"

#. Occurrence 2_5:468:2901: voice_id=D10_2_5_0002; voice_prefix=D10; voice_category=0; scene=2_5
#: 2_5:468
msgctxt "text_id=2901 | speaker=unknown"
msgid "\"It's fine, it's fine. She's in the security camera's blind spot, so we have no way of confirming whether she's up to no good."
msgstr "「いいのいいの。なんかねぇ、カメラの死角にいるんでイマイチ確証とれないの。"

#. Occurrence 2_5:474:2902: voice_id=D10_2_5_0003; voice_prefix=D10; voice_category=0; scene=2_5
#: 2_5:474
msgctxt "text_id=2902 | speaker=unknown"
msgid "  I want you to go because you've got a sixth sense about these things. Go check on her, will you?\""
msgstr "　草ちゃん、いまのところ的中率百パーセントでしょ。様子見てきてくれないかなぁ」"

#. Occurrence 2_5:484:2903: scene=2_5
#: 2_5:484
msgctxt "text_id=2903 | speaker=unknown"
msgid "  Hearing that, Soujyuro put away his cleaning equipment and headed upstairs."
msgstr "　そういう事でしたら、と掃除用具を片付けて草十郎は二階フロアに向かった。"

#. Occurrence 2_5:542:2904: scene=2_5
#: 2_5:542
msgctxt "text_id=2904 | speaker=unknown"
msgid "  It was a typically large-scale pachinko parlor with two floors."
msgstr "　店は典型的な二階建ての、大きい部類に入るパチンコ店である。"

#. Occurrence 2_5:547:2905: scene=2_5
#: 2_5:547
msgctxt "text_id=2905 | speaker=unknown"
msgid "  It prided itself on being a local establishment that was satisfied with taking the locals' money little-by-little without resorting to more exploitative means."
msgstr "　基本的には地域密着型で、あまりあこぎな調整もせず、少しずつ町の皆さんから収入を得ることを良しとしている。"

#. Occurrence 2_5:552:2906: scene=2_5
#: 2_5:552
msgctxt "text_id=2906 | speaker=unknown"
msgid "  But regardless of the parlor's intentions, its customers were not so scrupulous."
msgstr "　が、店側はそのつもりでも、お客様は千差万別。"

#. Occurrence 2_5:572:2907: scene=2_5
#: 2_5:572
msgctxt "text_id=2907 | speaker=unknown"
msgid "  Among them were casual players, professional gamblers, and cheaters looking to profit by exploiting whatever loopholes they could find."
msgstr "　気軽に遊びに来る者もいれば、これで食べている<職業博徒|プ　　ロ>、はては不正を働いて儲けようという輩もやってくる。"

#. Occurrence 2_5:577:2908: scene=2_5
#: 2_5:577
msgctxt "text_id=2908 | speaker=unknown"
msgid "  Of particular prevalence was a device developed in the mid-eighties that could disrupt a machine's circuitry from the outside and make it much easier to get what was called a triple seven jackpot."
msgstr "　中でも八十年代中期から流行しだしたある機械は、ゲーム台の電気系統に外部からアクセスしてプログラムを狂わせ、俗に言うスリーセブン等の大当たりをたやすく実現してしまう。"

#. Occurrence 2_5:608:2909: scene=2_5
#: 2_5:608
msgctxt "text_id=2909 | speaker=unknown"
msgid "  As much as the parlor wanted to deny these cheaters entry, it needed to present hard evidence of cheating, or risk losing customers."
msgstr "　当然店側としてもそういった人種の入場はお断りしたいのだが、確たる証拠もなしにお帰り願う訳にもいかない。"

#. Occurrence 2_5:608:2910: scene=2_5
#: 2_5:608
msgctxt "text_id=2910 | speaker=unknown"
msgid "  Particularly in the service industry, \"innocent until proven guilty\" was not a rule taken lightly."
msgstr "　客商売である以上、疑わしきは罰せず、がルールである。"

#. Occurrence 2_5:613:2911: scene=2_5
#: 2_5:613
msgctxt "text_id=2911 | speaker=unknown"
msgid "  As a result, they could only punish the customers they caught in the act."
msgstr "　結果、現行犯としてとっ捕まえるのが店側の正義となる。"

#. Occurrence 2_5:618:2912: scene=2_5
#: 2_5:618
msgctxt "text_id=2912 | speaker=unknown"
msgid "  Such cheaters were known as gotoshi, a slice of society which Soujyuro knew nothing about."
msgstr "　そういった不心得者をゴト師と言うらしいが、草十郎にはそのへんの事情は一切分かっていない。"

#. Occurrence 2_5:623:2913: scene=2_5
#: 2_5:623
msgctxt "text_id=2913 | speaker=unknown"
msgid "  What he did know was that they were inconveniencing his employer and violating their rules."
msgstr "　彼が承知しているのは、彼らが店側にとって厄介な相手であり、かつ、不正を働いているルール違反者である、という事だけだ。"

#. Occurrence 2_5:662:2914: scene=2_5
#: 2_5:662
msgctxt "text_id=2914 | speaker=unknown"
msgid "  He went upstairs."
msgstr "　二階に上がる。"

#. Occurrence 2_5:667:2915: scene=2_5
#: 2_5:667
msgctxt "text_id=2915 | speaker=unknown"
msgid "  The radio and game machine sounds on the second floor were quieter than the cacophony downstairs."
msgstr "　有線のラジオもゲーム台の音も、一階よりは控えめに流れている。"

#. Occurrence 2_5:672:2916: scene=2_5
#: 2_5:672
msgctxt "text_id=2916 | speaker=unknown"
msgid "  There were a hundred game machines on the ground floor and over eighty on the second. While there were some empty seats here and there, it was a solid evening turnout."
msgstr "　一階の百台に対して二階のゲーム台の数は八十あまり。空席はちらほらとあるものの、夕方にしては客入りは良好だろう。"

#. Occurrence 2_5:677:2917: scene=2_5
#: 2_5:677
msgctxt "text_id=2917 | speaker=unknown"
msgid "  The machine mentioned by his boss was in the center aisle."
msgstr "　店長の言う四十番台は店の中ごろの列だ。"

#. Occurrence 2_5:695:2918: scene=2_5
#: 2_5:695
msgctxt "text_id=2918 | speaker=unknown"
msgid "  Soujyuro nonchalantly leaned back against the wall and watched the customer hit the jackpot over and over again."
msgstr "　さりげなく列の入り口あたりの壁に寄りかかってみると、たしかに派手に<大当たり|フィーバー>しているお客さんがいた。"

#. Occurrence 2_5:741:2919: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0002; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:741
msgctxt "text_id=2919 | speaker=soujuurou"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 2_5:746:2920: scene=2_5
#: 2_5:746
msgctxt "text_id=2920 | speaker=unknown"
msgid "  The second he saw her, his gut told him that she was not cheating."
msgstr "　<一目|ひとめ>見た瞬間に違うな、と草十郎は直感した。"

#. Occurrence 2_5:751:2921: scene=2_5
#: 2_5:751
msgctxt "text_id=2921 | speaker=unknown"
msgid "  He still was not sure what made someone a master swindler, but if it meant they were special, this woman certainly fit that description."
msgstr "　何を以てプロと言うかは疑問だが、特別という意味なら彼女は本物だ。"

#. Occurrence 2_5:756:2922: scene=2_5
#: 2_5:756
msgctxt "text_id=2922 | speaker=unknown"
msgid "  It was almost as if he could feel the luck emanating from her."
msgstr "　なんとなく、その幸運の強さが感じ取れる。"

#. Occurrence 2_5:761:2923: scene=2_5
#: 2_5:761
msgctxt "text_id=2923 | speaker=unknown"
msgid "  As the customers looked on, she silently turned the handle again and again."
msgstr "　周りの客達の関心を一身に浴びながら、彼女は黙々とハンドルを回している。"

#. Occurrence 2_5:781:2924: scene=2_5
#: 2_5:781
msgctxt "text_id=2924 | speaker=unknown"
msgid "  She appeared older than Soujyuro."
msgstr "　歳は<草十郎|じぶん>より何歳か上。"

#. Occurrence 2_5:786:2925: scene=2_5
#: 2_5:786
msgctxt "text_id=2925 | speaker=unknown"
msgid "  She wore a green, form-fitting, one-piece dress."
msgstr "　緑色の、体の線がはっきりと判る洋服を着ている。上着とスカートが一体になったような服だ。"

#. Occurrence 2_5:791:2926: scene=2_5
#: 2_5:791
msgctxt "text_id=2926 | speaker=unknown"
msgid "  A pair of stockings covered her legs."
msgstr "　足は素肌ではなくストッキングをはいている。"

#. Occurrence 2_5:796:2927: scene=2_5
#: 2_5:796
msgctxt "text_id=2927 | speaker=unknown"
msgid "  Her slender legs were gracefully crossed, and her elegance suited a painting better than a casino."
msgstr "　細い両足は艶やかに組まれ、パチンコをしているというよりは絵画のモデルのような優雅さだった。"

#. Occurrence 2_5:801:2928: scene=2_5
#: 2_5:801
msgctxt "text_id=2928 | speaker=unknown"
msgid "  Her dark, reddish hair was cut short in a bob, perfectly framing her stylish spectacles and crimson lips."
msgstr "　赤みのかかった黒髪は短く、涼しげにかけたメガネと赤い唇がやけに決まっていた。"

#. Occurrence 2_5:821:2929: scene=2_5
#: 2_5:821
msgctxt "text_id=2929 | speaker=unknown"
msgid "  Truth be told, something was off about this picturesque beauty ringing the jackpot over and over again."
msgstr "　正直に言って、こんな場所でフィーバーを出していい美人ではない。"

#. Occurrence 2_5:826:2930: scene=2_5
#: 2_5:826
msgctxt "text_id=2930 | speaker=unknown"
msgid "  Four boxes' worth of pachinko balls sat at her feet, and her winning streak showed no sign of abating."
msgstr "　彼女の足元には四つの大箱が重ねられていて、その勢いは留まるところを知らない。"

#. Occurrence 2_5:831:2931: scene=2_5
#: 2_5:831
msgctxt "text_id=2931 | speaker=unknown"
msgid "  She looked bored as her slender, porcelain fingers lifted a long cigarette to her lips."
msgstr "　退屈そうに、細い陶器のような指が長い煙草を唇に運ぶ。"

#. Occurrence 2_5:852:2932: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0003; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:852
msgctxt "text_id=2932 | speaker=soujuurou"
msgid "(Feels like... I've seen her somewhere...)"
msgstr "『……なんか……どっかで……』"

#. Occurrence 2_5:857:2933: scene=2_5
#: 2_5:857
msgctxt "text_id=2933 | speaker=unknown"
msgid "  Just as that thought crossed his mind, her gaze turned toward the wall, and Soujyuro."
msgstr "　そう思った瞬間、メガネごしに視線が壁側―――草十郎を見た。"

#. Occurrence 2_5:1004:2934: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0004; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1004
msgctxt "text_id=2934 | speaker=soujuurou"
msgid "\"...!\""
msgstr "「………！」"

#. Occurrence 2_5:1009:2935: scene=2_5
#: 2_5:1009
msgctxt "text_id=2935 | speaker=unknown"
msgid "  Suddenly, a chill ran down his spine."
msgstr "　とたん、背中に走る悪寒。"

#. Occurrence 2_5:1014:2936: scene=2_5
#: 2_5:1014
msgctxt "text_id=2936 | speaker=unknown"
msgid "  He reflexively covered his mouth to keep from shrieking."
msgstr "　反射的にこぼれる悲鳴を必死に手で押さえつける。"

#. Occurrence 2_5:1049:2937: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0005; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1049
msgctxt "text_id=2937 | speaker=soujuurou"
msgid "(It's her! The woman from yesterday!)"
msgstr "『あの<女|ひと>、昨日の……！』"

#. Occurrence 2_5:1097:2938: scene=2_5
#: 2_5:1097
msgctxt "text_id=2938 | speaker=unknown"
msgid "  Acting on pure instinct, Soujyuro took off running."
msgstr "　確証のない直感に弾かれて、草十郎は<脱兎|だっと>の如く走り出した。"

#. Occurrence 2_5:1102:2939: scene=2_5
#: 2_5:1102
msgctxt "text_id=2939 | speaker=unknown"
msgid "  He headed straight downstairs, desperate to not be on the same floor as her."
msgstr "　この場から一刻も早く逃れようと、まず一階へ。"

#. Occurrence 2_5:1121:2940: scene=2_5
#: 2_5:1121
msgctxt "text_id=2940 | speaker=unknown"
msgid "  He would have run straight out the door, but for his obligations to his job."
msgstr "　そのまま外に駆け出そうとしたが、最低限の責任として店長に声をかける。"

#. Occurrence 2_5:1163:2941: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0006; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1163
msgctxt "text_id=2941 | speaker=soujuurou"
msgid "\"Boss, I'm leaving early. And the person upstairs is fine.\""
msgstr "「店長、早退します。それと、二階の人は問題ないです」"

#. Occurrence 2_5:1183:2942: scene=2_5
#: 2_5:1183
msgctxt "text_id=2942 | speaker=unknown"
msgid "  He tried to keep his composure as he spoke, jamming his school uniform into a paper bag as he ran out of the parlor."
msgstr "　心の動揺をなんとか抑えこみながら告げ、学校の制服を紙袋につめて店を飛びだした。"

#. Occurrence 2_5:1258:2943: scene=2_5
#: 2_5:1258
msgctxt "text_id=2943 | speaker=unknown"
msgid "  Cloudy weather brought the shadow of night over Yashirogi as he ran through the shopping arcade toward the station."
msgstr "　曇った天候のせいか、すでに夜の影が濃い社木の商店街を走り抜けて駅に向かう。"

#. Occurrence 2_5:1263:2944: scene=2_5
#: 2_5:1263
msgctxt "text_id=2944 | speaker=unknown"
msgid "  He shot up the long staircase like an arrow, quickly pulled his train pass from his wallet, and passed through the ticket gate."
msgstr "　長い階段を矢のように駆け上がり、定期を財布から素早く取り出して改札を通り過ぎる。"

#. Occurrence 2_5:1301:2945: scene=2_5
#: 2_5:1301
msgctxt "text_id=2945 | speaker=unknown"
msgid "  The ticket gate was crowded with people standing around, walking, and talking."
msgstr "　改札には大勢の人々がそれぞれの事情で立ち止まったり、歩いたり、話し合ったりしていた。"

#. Occurrence 2_5:1306:2946: scene=2_5
#: 2_5:1306
msgctxt "text_id=2946 | speaker=unknown"
msgid "  The station attendant by the automatic ticket machine had an unpleasant look on his face. There was now a familiar, comforting hustle and bustle around him."
msgstr "　その中で無愛想な顔をしているのは自動改札の横にある駅員室の駅員ぐらいで、ここにはちょっとだけ騒がしい安心があふれていた。"

#. Occurrence 2_5:1311:2947: scene=2_5
#: 2_5:1311
msgctxt "text_id=2947 | speaker=unknown"
msgid "  Just another day in the city."
msgstr "　都市の日常、と言い換えてもいい。"

#. Occurrence 2_5:1316:2948: scene=2_5
#: 2_5:1316
msgctxt "text_id=2948 | speaker=unknown"
msgid "  Nothing like what he witnessed the night before."
msgstr "　間違っても、昨夜の草十郎が見てしまった風景はどこにも見当たらない。"

#. Occurrence 2_5:1362:2949: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0007; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1362
msgctxt "text_id=2949 | speaker=soujuurou"
msgid "\"...Phew.\""
msgstr "「――――――はあ」"

#. Occurrence 2_5:1368:2950: scene=2_5
#: 2_5:1368
msgctxt "text_id=2950 | speaker=unknown"
msgid "  He could finally breathe again."
msgstr "　ようやく肺に空気を送る。"

#. Occurrence 2_5:1373:2951: scene=2_5
#: 2_5:1373
msgctxt "text_id=2951 | speaker=unknown"
msgid "  The momentary rush of relief brought him to an abrupt stop."
msgstr "　つかの間の安心から、草十郎はぴたりと立ち止まった。"

#. Occurrence 2_5:1378:2952: scene=2_5
#: 2_5:1378
msgctxt "text_id=2952 | speaker=unknown"
msgid "  He nervously turned around."
msgstr "　おそるおそる背後を振り返る。"

#. Occurrence 2_5:1397:2953: scene=2_5
#: 2_5:1397
msgctxt "text_id=2953 | speaker=unknown"
msgid "  There was no way that dangerous individual could be behind him."
msgstr "　当然のように、追いかけてくる危険人物など居るはずもない。"

#. Occurrence 2_5:1418:2954: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0008; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1418
msgctxt "text_id=2954 | speaker=soujuurou"
msgid "(Wait, why would I even...?)"
msgstr "『……って、考えてみると……』"

#. Occurrence 2_5:1424:2955: scene=2_5
#: 2_5:1424
msgctxt "text_id=2955 | speaker=unknown"
msgid "  He couldn't think of a good reason for why he'd fled so desperately."
msgstr "　なぜ唐突に走りだしたのか、その理由が脆弱すぎた。"

#. Occurrence 2_5:1429:2956: scene=2_5
#: 2_5:1429
msgctxt "text_id=2956 | speaker=unknown"
msgid "  As far as he could remember, he hadn't even seen the threat's face long enough to form an opinion about her."
msgstr "　そもそも自分は、人相が分かるほど“<危険|あいて>の顔”を見ていなかったではないか、と呆れかえる。"

#. Occurrence 2_5:1447:2957: scene=2_5
#: 2_5:1447
msgctxt "text_id=2957 | speaker=unknown"
msgid "  Soujyuro gave himself a good slap on the cheek to pull himself together and quickly made his way down to the platform."
msgstr "　頬を叩いて気合いを入れ直し、草十郎は早足でプラットホームに下りていく。"

#. Occurrence 2_5:1452:2958: scene=2_5
#: 2_5:1452
msgctxt "text_id=2958 | speaker=unknown"
msgid "  Unfortunately, the next train was ten minutes away, and panicking would do him no favors, so he quietly found an empty seat and sat down."
msgstr "　あいにく電車は十分待ちだったが、ここで取り乱しても仕方がないので大人しく椅子に座った。"

#. Occurrence 2_5:1514:2959: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0009; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1514
msgctxt "text_id=2959 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 2_5:1520:2960: scene=2_5
#: 2_5:1520
msgctxt "text_id=2960 | speaker=unknown"
msgid "  He took another deep breath."
msgstr "　もういちど深呼吸。"

#. Occurrence 2_5:1525:2961: scene=2_5
#: 2_5:1525
msgctxt "text_id=2961 | speaker=unknown"
msgid "  He was surrounded by people waiting for the train just like he was."
msgstr "　周りには自分と同じく、電車待ちの人々の姿がある。"

#. Occurrence 2_5:1530:2962: scene=2_5
#: 2_5:1530
msgctxt "text_id=2962 | speaker=unknown"
msgid "  ...And no sign of anyone pursuing him."
msgstr "　……追いかけてくる“誰か”なんて影も形もない。"

#. Occurrence 2_5:1535:2963: scene=2_5
#: 2_5:1535
msgctxt "text_id=2963 | speaker=unknown"
msgid "  His head finally cleared up, and he assured himself that he was overthinking things."
msgstr "　考えすぎだった、と、ようやく頭がクリアになる。"

#. Occurrence 2_5:1540:2964: scene=2_5
#: 2_5:1540
msgctxt "text_id=2964 | speaker=unknown"
msgid "  Though, he was surprised at how heavy his shoulders felt."
msgstr "　ただ、がっくりと落ちた両肩が重いのが意外だった。"

#. Occurrence 2_5:1593:2965: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0010; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1593
msgctxt "text_id=2965 | speaker=soujuurou"
msgid "(I'm just tired, I'm sure of it. I know my own body best, after all.)"
msgstr "『……疲れてるのは分かってる。自分の体のコトだし』"

#. Occurrence 2_5:1599:2966: scene=2_5
#: 2_5:1599
msgctxt "text_id=2966 | speaker=unknown"
msgid "  Soujyuro sighed at his greater-than-expected fatigue."
msgstr "　予想以上の強い疲労に、草十郎は嘆息した。"

#. Occurrence 2_5:1604:2967: scene=2_5
#: 2_5:1604
msgctxt "text_id=2967 | speaker=unknown"
msgid "  He had certainly struggled since coming down from the mountains, but in retrospect, it could have been worse."
msgstr "　山を下りてきてからの生活はたしかに過酷だったが、こうして座って振り返ってみると我慢できないほどではなかった。"

#. Occurrence 2_5:1609:2968: scene=2_5
#: 2_5:1609
msgctxt "text_id=2968 | speaker=unknown"
msgid "  Physically, he was probably holding up fine."
msgstr "　肉体的にはたぶんまだまだ大丈夫。"

#. Occurrence 2_5:1614:2969: scene=2_5
#: 2_5:1614
msgctxt "text_id=2969 | speaker=unknown"
msgid "  He was much less confident in his mental state."
msgstr "　<音|ね>をあげているのは心の問題だ。"

#. Occurrence 2_5:1663:2970: scene=2_5
#: 2_5:1663
msgctxt "text_id=2970 | speaker=unknown"
msgid "  The city and the mountains could not have been more different."
msgstr "　ここと山とでは何もかもが違う。"

#. Occurrence 2_5:1668:2971: scene=2_5
#: 2_5:1668
msgctxt "text_id=2971 | speaker=unknown"
msgid "  He had been slow to recognize the differences and adapt."
msgstr "　それを認めて適応する事はひどく難しかった。"

#. Occurrence 2_5:1673:2972: scene=2_5
#: 2_5:1673
msgctxt "text_id=2972 | speaker=unknown"
msgid "  Acclimation was simple enough. Humans were nothing if not adaptable. Even without any effort, one would learn to adjust over time."
msgstr "　馴染むのは簡単だ。人間はなんにだって慣れる生き物なので、放っておいても順応していく。"

#. Occurrence 2_5:1678:2973: scene=2_5
#: 2_5:1678
msgctxt "text_id=2973 | speaker=unknown"
msgid "  Recognizing the challenges had been the hard part."
msgstr "　なので。難しかったのは、たぶん認める方だろう。"

#. Occurrence 2_5:1699:2974: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0011; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1699
msgctxt "text_id=2974 | speaker=soujuurou"
msgid "\"...Actually, it's all been difficult.\""
msgstr "「……そりゃあ。とにかく、難しいコトだらけだし」"

#. Occurrence 2_5:1720:2975: scene=2_5
#: 2_5:1720
msgctxt "text_id=2975 | speaker=unknown"
msgid "  Soujyuro grumbled a complaint he'd never uttered before."
msgstr "　今まで口にしたことのない弱音を漏らす。"

#. Occurrence 2_5:1725:2976: scene=2_5
#: 2_5:1725
msgctxt "text_id=2976 | speaker=unknown"
msgid "  To be honest, he was still afraid to wander around town."
msgstr "　正直、草十郎は町を出歩く事すらいまだに怖い。"

#. Occurrence 2_5:1730:2977: scene=2_5
#: 2_5:1730
msgctxt "text_id=2977 | speaker=unknown"
msgid "  There were so many things city people took for granted that Soujyuro had yet to grasp. It was little wonder that this neverending chain of surprises would wear on him."
msgstr "　都会の人々には当たり前の事でも、彼にとっては未知の事ばかりなのだ。そんな事が連続するたびに驚いているのだから、まいらない筈がない。"

#. Occurrence 2_5:1755:2978: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0012; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1755
msgctxt "text_id=2978 | speaker=soujuurou"
msgid "(Oh... It isn't my body that's tired.)"
msgstr "『……そっか……疲れてるのは体じゃないのか……』"

#. Occurrence 2_5:1773:2979: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0013; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1773
msgctxt "text_id=2979 | speaker=soujuurou"
msgid "\"That would explain the hallucination.\""
msgstr "「だから、あんな幻を見る」"

#. Occurrence 2_5:1808:2980: scene=2_5
#: 2_5:1808
msgctxt "text_id=2980 | speaker=unknown"
msgid "  He muttered to himself, then shook his head."
msgstr "　呟いてみて、草十郎は小さく首を横に振った。"

#. Occurrence 2_5:1813:2981: scene=2_5
#: 2_5:1813
msgctxt "text_id=2981 | speaker=unknown"
msgid "  That which exists, exists. Such was the way of all things."
msgstr "　有る物は有るのが、世の習わしだ。"

#. Occurrence 2_5:1818:2982: scene=2_5
#: 2_5:1818
msgctxt "text_id=2982 | speaker=unknown"
msgid "  Tobimaru had called it a hallucination, but Soujyuro knew what he saw was real."
msgstr "　鳶丸にはああは言ったが、草十郎は<あ|・><の|・><出|・><来|・><事|・>が現実だと解っていた。"

#. Occurrence 2_5:1892:2983: scene=2_5
#: 2_5:1892
msgctxt "text_id=2983 | speaker=unknown"
msgid "  The city was a magical kingdom compared to the mountains."
msgstr "　ここは山に比べれば魔法の国だ。"

#. Occurrence 2_5:1897:2984: scene=2_5
#: 2_5:1897
msgctxt "text_id=2984 | speaker=unknown"
msgid "  If there were real magicians secretly living here, that should have been no surprise at all."
msgstr "　それなら、本物の魔法使いがこっそり暮らしててもおかしくはない。"

#. Occurrence 2_5:1902:2985: scene=2_5
#: 2_5:1902
msgctxt "text_id=2985 | speaker=unknown"
msgid "  The thought alone made his legs tremble. It took him a moment longer to realize that they were quivering out of fear."
msgstr "　一度でもそう思ってしまったら、椅子に座った両足が小刻みに震えていた。どうも怖いらしい、と気付いたのはしばらくしてからだ。"

#. Occurrence 2_5:1907:2986: scene=2_5
#: 2_5:1907
msgctxt "text_id=2986 | speaker=unknown"
msgid "  He had feared the unnatural ever since he encountered a wild bear on a mountain path as a child."
msgstr "　自然以外を怖いと思うのは、子供のころ山道でばったり野生の熊に出会った時以来である。"

#. Occurrence 2_5:1959:2987: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0014; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1959
msgctxt "text_id=2987 | speaker=soujuurou"
msgid "\"But this is nothing like that."
msgstr "「いや、あれはこんなもんじゃなかったっけ。"

#. Occurrence 2_5:1965:2988: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0015; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1965
msgctxt "text_id=2988 | speaker=soujuurou"
msgid "  I cried and screamed my head off back then.\""
msgstr "　なりふりかまわず泣き叫んだもんな、あの時は」"

#. Occurrence 2_5:1971:2989: scene=2_5
#: 2_5:1971
msgctxt "text_id=2989 | speaker=unknown"
msgid "  Soujyuro smiled a little as he recalled his traumatic childhood memory."
msgstr "　幼少期のトンデモなトラウマを思い出し、草十郎はつい<微|わ><笑|ら>ってしまった。"

#. Occurrence 2_5:1991:2990: scene=2_5
#: 2_5:1991
msgctxt "text_id=2990 | speaker=unknown"
msgid "  Anyone would have fainted at the sudden appearance of a growling beast that towered over 6 feet tall."
msgstr "　たしかに二メートル以上の獣がのっそり現れ、ぐるるる、なんて唸った日には誰だって卒倒するだろう。"

#. Occurrence 2_5:1996:2991: scene=2_5
#: 2_5:1996
msgctxt "text_id=2991 | speaker=unknown"
msgid "  The monster in the movie that Soujyuro saw not two days ago was the equivalent of a cuddly stuffed animal when compared to the wild mountain creatures."
msgstr "　山で生活していた草十郎からしてどのくらい迫力があったかと言うと、ほんの二日前に映画で見た大怪獣をぬいぐるみでは、と錯覚するぐらい野生の獣は怖かった。"

#. Occurrence 2_5:2001:2992: scene=2_5
#: 2_5:2001
msgctxt "text_id=2992 | speaker=unknown"
msgid "  He was reminded that he'd faced far worse before, and his ordeal now was something he could endure."
msgstr "　それを思い出せば、たしかに、これぐらいはなんとか我慢できる話かもしれない。"

#. Occurrence 2_5:2054:2993: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0016; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:2054
msgctxt "text_id=2993 | speaker=soujuurou"
msgid "\"That's right. The problem now, is... what I heard someone say at the end. What's 'catch and eliminate' supposed to mean?\""
msgstr "「……そうだよな。今の問題は、えーと……チラっと聞こえた最後の台詞か。『捕まえて始末する』っていうのは、どうなんだ？」"

#. Occurrence 2_5:2060:2994: scene=2_5
#: 2_5:2060
msgctxt "text_id=2994 | speaker=unknown"
msgid "  At face value, the meaning was obvious."
msgstr "　額面通りにとるのなら、それこそ文字通りの意味、というヤツだ。"

#. Occurrence 2_5:2065:2995: scene=2_5
#: 2_5:2065
msgctxt "text_id=2995 | speaker=unknown"
msgid "  But the implications were simply too frightening to contemplate seriously. Perhaps he had misheard the words, or perhaps the speaker had misspoke."
msgstr "　あまりにも物騒な意味合いすぎて、真剣に考察することが難しい。何かの聞き間違い、あるいは言い間違いだったのだろう、と放り投げてしまいたくなる。"

#. Occurrence 2_5:2087:2996: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0017; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:2087
msgctxt "text_id=2996 | speaker=soujuurou"
msgid "\"The law of the city... means someone will deal out punishment eventually...\""
msgstr "「都会のルール……誰かが、きっと罰しに来る、か……」"

#. Occurrence 2_5:2093:2997: scene=2_5
#: 2_5:2093
msgctxt "text_id=2997 | speaker=unknown"
msgid "  Even as he said it, the idea didn't feel quite real. It was hard to imagine that it applied to him."
msgstr "　自分で言っておきながら、やっぱり他人ごとのようで、夢だったと割り切りたい気分だ。"

#. Occurrence 2_5:2116:2998: scene=2_5
#: 2_5:2116
msgctxt "text_id=2998 | speaker=unknown"
msgid "  Soujyuro breathed in and closed his eyes."
msgstr "　草十郎は息をついて瞼を閉じる。"

#. Occurrence 2_5:2121:2999: scene=2_5
#: 2_5:2121
msgctxt "text_id=2999 | speaker=unknown"
msgid "  His vision dimmed, putting the illuminated cityscape out of sight, and out of mind."
msgstr "　視界の暗転と共に先ほどの光景をすべて棚上げ。"

#. Occurrence 2_5:2126:3000: scene=2_5
#: 2_5:2126
msgctxt "text_id=3000 | speaker=unknown"
msgid "  For now, he resolved to put last night's events behind him."
msgstr "　とりあえず、今はきれいさっぱり昨夜の出来事を忘れる事にした。"

#. Occurrence 2_5:2175:3001: scene=2_5
#: 2_5:2175
msgctxt "text_id=3001 | speaker=unknown"
msgid "  When he opened his eyes, his breathing had calmed."
msgstr "　瞼を開けると、呼吸はすっかり落ち着いていた。"

#. Occurrence 2_5:2182:3002: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0018; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:2182
msgctxt "text_id=3002 | speaker=soujuurou"
msgid "\"I wonder..."
msgstr "「それでさ。"

#. Occurrence 2_5:2188:3003: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0019; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:2188
msgctxt "text_id=3003 | speaker=soujuurou"
msgid "  What happened to Tobimaru when he tried to hit Aozaki?\""
msgstr "　蒼崎を殴りつけようとして、結局どうなったんだ鳶丸？」"

#. Occurrence 2_5:2195:3004: scene=2_5
#: 2_5:2195
msgctxt "text_id=3004 | speaker=unknown"
msgid "  The question suddenly popped into Soujyuro's head."
msgstr "　なんとなく唐突に、そんな疑問が湧いたりする。"

#. Occurrence 2_5:2200:3005: scene=2_5
#: 2_5:2200
msgctxt "text_id=3005 | speaker=unknown"
msgid "  He decided he would ask next time, and stood up from his chair. A long streak of light blazed by, announcing the arrival of the next train."
msgstr "　今度聞いてみよう、と草十郎が椅子から立ち上がった時、長い光を引いて電車がやってきた。"

#. Occurrence 3_1:59:3006: scene=3_1
#: 3_1:59
msgctxt "text_id=3006 | speaker=unknown"
msgid "  Let me tell you..."
msgstr "　つまり、"

msgctxt "text_id=3007 | speaker=unknown"
msgid " how the events of yesterday transpired."
msgstr "昨日こんな事があった。"

#. Occurrence 3_1:108:3008: scene=3_1
#: 3_1:108
msgctxt "text_id=3008 | speaker=unknown"
msgid "  \"On moonless nights, you must never look back.\""
msgstr "　“月の無い夜は、決して振り向いてはいけないよ―――”"

#. Occurrence 3_1:130:3009: scene=3_1
#: 3_1:130
msgctxt "text_id=3009 | speaker=unknown"
msgid "  Was it a lesson or was it a warning?"
msgstr "　それは教訓だったのか、警告だったのか。"

#. Occurrence 3_1:135:3010: scene=3_1
#: 3_1:135
msgctxt "text_id=3010 | speaker=unknown"
msgid "  It was so very long ago. At the time, I could not have imagined what I, what my very being, would become."
msgstr "　ずいぶんと昔……私がまだ今の<自分|ありかた>を夢にも思っていなかった頃。"

#. Occurrence 3_1:140:3011: scene=3_1
#: 3_1:140
msgctxt "text_id=3011 | speaker=unknown"
msgid "  One night, it came without warning. I was filled with an anxiety so heightened that it made me want to burst into tears, so I fled to my grandfather's workshop."
msgstr "　突然、何の前触れもなく、泣きだしたくなるぐらいの不安でいっぱいになって、祖父の工房に逃げこんだ夜の話だ。"

#. Occurrence 3_1:145:3012: scene=3_1
#: 3_1:145
msgctxt "text_id=3012 | speaker=unknown"
msgid "  Unlike the grandfather I knew, he smiled and kindly placed his hand upon my head."
msgstr "　祖父は別人のように優しく微笑み、私の頭に静かに手を乗せて、"

#. Occurrence 3_1:170:3013: scene=3_1
#: 3_1:170
msgctxt "text_id=3013 | speaker=unknown"
msgid "  \"...Yes, the red death follows your every step.\""
msgstr "　“―――<赤色|あかいろ>の死が、おまえの背中を見ているからね”"

#. Occurrence 3_1:192:3014: scene=3_1
#: 3_1:192
msgctxt "text_id=3014 | speaker=unknown"
msgid "  Rather than consoling me, he sent me home with only those haunting words."
msgstr "　そんな、気休めどころかより絶望的な言葉を残して、私を家につき返した。"

#. Occurrence 3_1:197:3015: scene=3_1
#: 3_1:197
msgctxt "text_id=3015 | speaker=unknown"
msgid "  That night, I was certain that I sensed a shadow lurking behind me."
msgstr "　私はあの夜、たしかに背後に<潜|ひそ>む影を認めた。"

#. Occurrence 3_1:202:3016: scene=3_1
#: 3_1:202
msgctxt "text_id=3016 | speaker=unknown"
msgid "  Something or someone watching me from afar..."
msgstr "　ずっと遠くから私を見ている何者か。"

#. Occurrence 3_1:209:3017: scene=3_1
#: 3_1:209
msgctxt "text_id=3017 | speaker=unknown"
msgid "  Then little by little, year by year, it drew closer."
msgstr "　それは少しずつ、年々距離を<縮|ちぢ>めていき―――"

#. Occurrence 3_1:215:3018: scene=3_1
#: 3_1:215
msgctxt "text_id=3018 | speaker=unknown"
msgid "  Eventually, the presence that once felt like a spot on the horizon grew so close that I could feel its breath down the base of my neck."
msgstr "　小さな点ほどだった気配は、その息づかいさえ感じるほどすぐ後ろまで迫っていた。"

#. Occurrence 3_1:245:3019: scene=3_1
#: 3_1:245
msgctxt "text_id=3019 | speaker=unknown"
msgid "  Of course it was all in my mind."
msgstr "　もちろん錯覚。"

#. Occurrence 3_1:250:3020: scene=3_1
#: 3_1:250
msgctxt "text_id=3020 | speaker=unknown"
msgid "  When I turned around, nobody was there."
msgstr "　振り向いた先には誰もいない。"

#. Occurrence 3_1:256:3021: scene=3_1
#: 3_1:256
msgctxt "text_id=3021 | speaker=unknown"
msgid "  But that night marked the beginning."
msgstr "　ただ―――きっかけになったあの夜。"

#. Occurrence 3_1:261:3022: scene=3_1
#: 3_1:261
msgctxt "text_id=3022 | speaker=unknown"
msgid "  In hindsight, I later understood that the indescribable anxiety I felt was the dread of certain death."
msgstr "　あの時の言いようのない不安は、間違いなく、約束された<恐怖|し>に起因するものだった。"

#. Occurrence 3_1:336:3023: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_3_1_9000; voice_prefix=A40; voice_category=2; scene=3_1
#: 3_1:336
msgctxt "text_id=3023 | speaker=alice"
msgid "\""
msgstr "“"

msgctxt "text_id=3024 | speaker=unknown"
msgid "...Hey diddle diddle, the cat and the fiddle,"
msgstr "……Hey diddle diddle,The cat and the fiddle,"

msgctxt "text_id=3025 | speaker=unknown"
msgid "  The cow jump'd over the moon,"
msgstr "　The cow jump'd over the moon,"

msgctxt "text_id=3026 | speaker=unknown"
msgid "  The little dog laugh'd...\""
msgstr "　The little dog laugh'd……”"

#. Occurrence 3_1:357:3027: scene=3_1
#: 3_1:357
msgctxt "text_id=3027 | speaker=unknown"
msgid "  ...How much time has passed since that night?"
msgstr "　……あれはいつの話だっただろう。"

#. Occurrence 3_1:362:3028: scene=3_1
#: 3_1:362
msgctxt "text_id=3028 | speaker=unknown"
msgid "  It lingered deep in the recesses of my mind where childhood memories are kept."
msgstr "　遠い子供の頃の記憶の片隅。"

#. Occurrence 3_1:367:3029: scene=3_1
#: 3_1:367
msgctxt "text_id=3029 | speaker=unknown"
msgid "  A faded, story book-esque memory."
msgstr "　絵日記じみたかすかな思い出。"

#. Occurrence 3_1:372:3030: scene=3_1
#: 3_1:372
msgctxt "text_id=3030 | speaker=unknown"
msgid "  On dark nights, I still hear the faint echo of my grandfather's words."
msgstr "　……暗い夜には決まって祖父の言葉が耳に響く。"

#. Occurrence 3_1:377:3031: scene=3_1
#: 3_1:377
msgctxt "text_id=3031 | speaker=unknown"
msgid "  But no matter how strong the wind may howl, or how entrancing the song of the girl next to me, I could never bury his ominous words completely."
msgstr "　どんなに風が強く吹いても、<傍|かたわ>らの少女の<鐘|うた>が聞き惚れるほどのものでも、不吉な言葉をかき消す事はできない。"

#. Occurrence 3_1:411:3032: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_3_1_0000; voice_prefix=A40; voice_category=2; scene=3_1
#: 3_1:411
msgctxt "text_id=3032 | speaker=alice"
msgid "\"...It's here.\""
msgstr "「……ご到着ね」"

#. Occurrence 3_1:427:3033: scene=3_1
#: 3_1:427
msgctxt "text_id=3033 | speaker=unknown"
msgid "  The girl beside me said."
msgstr "　傍らの<少女|ありす>が言った。"

#. Occurrence 3_1:432:3034: scene=3_1
#: 3_1:432
msgctxt "text_id=3034 | speaker=unknown"
msgid "  Alice's inflectionless voice spoke volumes of her role as the bystander."
msgstr "　抑揚のない声は、完全に傍観者でいる事を示している。"

#. Occurrence 3_1:464:3035: scene=3_1
#: 3_1:464
msgctxt "text_id=3035 | speaker=unknown"
msgid "  That night, there was only me and her."
msgstr "　夜の公園には私と彼女だけ。"

#. Occurrence 3_1:469:3036: scene=3_1
#: 3_1:469
msgctxt "text_id=3036 | speaker=unknown"
msgid "  It was the night I would mark as the birth of who I am today."
msgstr "　今日は私にとって“今の自分”の誕生日。"

#. Occurrence 3_1:474:3037: scene=3_1
#: 3_1:474
msgctxt "text_id=3037 | speaker=unknown"
msgid "  For what should have been quite the memorable night, it sure wasn't a promising start."
msgstr "　記念すべき<初陣|ういじん>にしては、少々不吉な夜と言わざるをえない。"

#. Occurrence 3_1:522:3038: scene=3_1
#: 3_1:522
msgctxt "text_id=3038 | speaker=unknown"
msgid "  Dense clouds blocked the starlight above like a black umbrella."
msgstr "　ぶあつい雲は黒い傘のように星明かりを<遮|さえぎ>っている。"

#. Occurrence 3_1:527:3039: scene=3_1
#: 3_1:527
msgctxt "text_id=3039 | speaker=unknown"
msgid "  Strong wind tore through the sky, carrying the heavy clouds with it."
msgstr "　強い風は夜空を引き裂き、重い雲を運んでいく。"

#. Occurrence 3_1:532:3040: scene=3_1
#: 3_1:532
msgctxt "text_id=3040 | speaker=unknown"
msgid "  The hands on the clock in the middle of the park pointed skyward, as if reaching for the moon."
msgstr "　公園の真ん中に立つ柱時計の針は、二本とも頭上の月を指すように頂点を向いている。"

#. Occurrence 3_1:556:3041: scene=3_1
#: 3_1:556
msgctxt "text_id=3041 | speaker=unknown"
msgid "  Unfortunately for them, tonight there was no moon to point at."
msgstr "　あいにくと、今日は月のない夜だったけれど。"

#. Occurrence 3_1:607:3042: scene=3_1
#: 3_1:607
msgctxt "text_id=3042 | speaker=unknown"
msgid "  The winter air grew fiercer as the night wore on."
msgstr "　冬の大気は、深夜になって狂暴さを増している。"

#. Occurrence 3_1:612:3043: scene=3_1
#: 3_1:612
msgctxt "text_id=3043 | speaker=unknown"
msgid "  Inhaling felt as though it would freeze me from the inside."
msgstr "　息を吸うだけで体の中が凍る気がする。"

#. Occurrence 3_1:655:3044: scene=3_1
#: 3_1:655
msgctxt "text_id=3044 | speaker=unknown"
msgid "  The air chilled me to the bone, threatening to pass up my spine directly to my brain."
msgstr "　骨に染みこむような冷気は、そのまま背骨を通じて脳に直接入りこんでくる。"

#. Occurrence 3_1:661:3045: scene=3_1
#: 3_1:661
msgctxt "text_id=3045 | speaker=unknown"
msgid "  To prevent my mind from being paralyzed,"
msgstr "　思考が寒さで麻痺しないよう、"

#. Occurrence 3_1:667:3046: scene=3_1
#: 3_1:667
msgctxt "text_id=3046 | speaker=unknown"
msgid "  and to prevent my fingertips from becoming stone,"
msgstr "　指先が寒気で化石にならないよう、"

#. Occurrence 3_1:673:3047: scene=3_1
#: 3_1:673
msgctxt "text_id=3047 | speaker=unknown"
msgid "  I sparked a fire using my internal rhythm and emotion. "
msgstr "　私は、自分の<鼓動|リズム>と感情を炎にくべた。"

#. Occurrence 3_1:731:3048: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_3_1_0001; voice_prefix=A40; voice_category=2; scene=3_1
#: 3_1:731
msgctxt "text_id=3048 | speaker=alice"
msgid "\"I'm transferring tactile feedback to you. ...Good luck."
msgstr "「触覚を<譲|ゆず>るわ。……幸運ね。"

#. Occurrence 3_1:731:3049: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_3_1_0001; voice_prefix=A40; voice_category=2; scene=3_1
#: 3_1:731
msgctxt "text_id=3049 | speaker=alice"
msgid "  Stand over there, and the engraved will-o'-the-wisp will ignite.\""
msgstr "　あの位置なら刻んでおいた<鬼火|ウィスプ>が灯る」"

#. Occurrence 3_1:737:3050: scene=3_1
#: 3_1:737
msgctxt "text_id=3050 | speaker=unknown"
msgid "  I responded to Alice with a nod."
msgstr "　有珠の言葉に頷きだけで応える。"

#. Occurrence 3_1:742:3051: scene=3_1
#: 3_1:742
msgctxt "text_id=3051 | speaker=unknown"
msgid "  And then, for just a moment, I saw the ground."
msgstr "　その時、一瞬だけ地面が見えた。"

#. Occurrence 3_1:762:3052: scene=3_1
#: 3_1:762
msgctxt "text_id=3052 | speaker=unknown"
msgid "  ...My legs quivered ever so faintly."
msgstr "　……私の両足はかすかに震えている。"

#. Occurrence 3_1:767:3053: scene=3_1
#: 3_1:767
msgctxt "text_id=3053 | speaker=unknown"
msgid "  I told myself they were shaking from the cold, but I wasn't so sure."
msgstr "　寒いから震えているんだ、と判断したけれど自信はなかった。"

#. Occurrence 3_1:772:3054: scene=3_1
#: 3_1:772
msgctxt "text_id=3054 | speaker=unknown"
msgid "  In reality, they may not have been numbed by the cold, but by fear. I breathe a sigh of relief. My humanity must still be intact if my emotions are still present."
msgstr "　本当は寒さではなく恐怖で<痺|しび>れてしまっているのかも知れない。……ホッと息を吐く。感情が働いているのなら、私はじゅうぶんに人間らしい。"

#. Occurrence 3_1:847:3055: scene=3_1
#: 3_1:847
msgctxt "text_id=3055 | speaker=unknown"
msgid "  Before I could sink into a pool of my own sentimentality, the sensations from the Bounded Field flowed from Alice into me."
msgstr "　そんな感傷にひたる間もなく、結界の感触が有珠から私に移ってきた。"

#. Occurrence 3_1:853:3056: scene=3_1
#: 3_1:853
msgctxt "text_id=3056 | speaker=unknown"
msgid "  A transparent wall covered the entire park."
msgstr "　この公園一帯に敷かれた透明の<境|かべ>。"

#. Occurrence 3_1:858:3057: scene=3_1
#: 3_1:858
msgctxt "text_id=3057 | speaker=unknown"
msgid "  An unrecognizable carpet rooted deep under the earth."
msgstr "　地中深くまで根を張った認知外の絨毯。"

#. Occurrence 3_1:937:3058: scene=3_1
#: 3_1:937
msgctxt "text_id=3058 | speaker=unknown"
msgid "  Alice Kuonji's chants of the Mother Goose fairy tales permeated the night."
msgstr "　―――夜に<浸|ひび>く、久遠寺有珠の<童話詠唱|マザーグース>。"

#. Occurrence 3_1:947:3059: scene=3_1
#: 3_1:947
msgctxt "text_id=3059 | speaker=unknown"
msgid "  The sensations became one with my body."
msgstr "　それらの感覚と、私の体がひとつになる。"

#. Occurrence 3_1:986:3060: scene=3_1
#: 3_1:986
msgctxt "text_id=3060 | speaker=unknown"
msgid "  I felt goosebumps on my quivering right arm."
msgstr "　ざわり、と右腕に鳥肌がたつ。"

#. Occurrence 3_1:991:3061: scene=3_1
#: 3_1:991
msgctxt "text_id=3061 | speaker=unknown"
msgid "  Someone had trespassed."
msgstr "　誰かが私の腕に侵入したのだ。"

#. Occurrence 3_1:1038:3062: scene=3_1
#: 3_1:1038
msgctxt "text_id=3062 | speaker=unknown"
msgid "  The goosebumps crept up my right arm like ants,"
msgstr "　鳥肌は<蟻|あり>のように右腕を<這|は>い上がってくる。"

#. Occurrence 3_1:1043:3063: scene=3_1
#: 3_1:1043
msgctxt "text_id=3063 | speaker=unknown"
msgid "  and slowly but surely, made inroads for my heart."
msgstr "　ゆっくりと、確実に、この心臓めがけて。"

#. Occurrence 3_1:1048:3064: scene=3_1
#: 3_1:1048
msgctxt "text_id=3064 | speaker=unknown"
msgid "  Holding back the desire to drive them out, I waited for them to reach a certain, definitive position."
msgstr "　払い<除|の>けたくなる衝動をおさえて、より決定的な位置、より確実な到来を待つ。"

#. Occurrence 3_1:1093:3065: scene=3_1
#: 3_1:1093
msgctxt "text_id=3065 | speaker=unknown"
msgid "  A moonless night."
msgstr "　月の無い夜。"

#. Occurrence 3_1:1098:3066: scene=3_1
#: 3_1:1098
msgctxt "text_id=3066 | speaker=unknown"
msgid "  The park's quaint street lights were not enough to lift the darkness."
msgstr "　公園の小さな街灯だけでは、闇の<全容|すべて>は見渡せない。"

#. Occurrence 3_1:1136:3067: scene=3_1
#: 3_1:1136
msgctxt "text_id=3067 | speaker=unknown"
msgid "  The ants came to a stop."
msgstr "　蟻の進行は止まった。"

#. Occurrence 3_1:1141:3068: scene=3_1
#: 3_1:1141
msgctxt "text_id=3068 | speaker=unknown"
msgid "  Far, far from my right arm, they had reached my very heart."
msgstr "　私の右腕から離れて離れて<心臓|まなか>のとなり。"

#. Occurrence 3_1:1168:3069: scene=3_1
#: 3_1:1168
msgctxt "text_id=3069 | speaker=unknown"
msgid "  Even without the aid of my sense of sight, I could see the intruder lurking in the darkness."
msgstr "　視覚を動員することなく、闇に<潜|ひそ>む侵入者の姿が見える。"

#. Occurrence 3_1:1173:3070: scene=3_1
#: 3_1:1173
msgctxt "text_id=3070 | speaker=unknown"
msgid "  To starboard, in the bushes about thirty steps back, on all fours. It was beckoning with its right hand."
msgstr "　ここから<右舷|うげん>後方三十歩ほどの茂みの<陰|かげ>、四つんばいに手足をついたソレは<手招|てまね>きするように右手をあげ―――"

#. Occurrence 3_1:1204:3071: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0000; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:1204
msgctxt "text_id=3071 | speaker=aoko"
msgid "\"...There!\""
msgstr "「―――そこ！」"

#. Occurrence 3_1:1210:3072: scene=3_1
#: 3_1:1210
msgctxt "text_id=3072 | speaker=unknown"
msgid "  The enemy's movement and my perception of it were in lockstep."
msgstr "　私の知覚と、敵の行動はほぼ同時だった。"

#. Occurrence 3_1:1230:3073: scene=3_1
#: 3_1:1230
msgctxt "text_id=3073 | speaker=unknown"
msgid "  I spun around."
msgstr "　体が振り向く。"

#. Occurrence 3_1:1282:3074: scene=3_1
#: 3_1:1282
msgctxt "text_id=3074 | speaker=unknown"
msgid "  The enemy's arm stretched out like a spear."
msgstr "　敵の腕は槍のように伸びた。"

#. Occurrence 3_1:1330:3075: scene=3_1
#: 3_1:1330
msgctxt "text_id=3075 | speaker=unknown"
msgid "  This lethal weapon, aimed at the back of my head, brushed my hair at breakneck speed."
msgstr "　高速で後頭部に放たれた凶器が、私の髪をさらっていく。"

#. Occurrence 3_1:1335:3076: scene=3_1
#: 3_1:1335
msgctxt "text_id=3076 | speaker=unknown"
msgid "  With the omniscient awareness granted by Alice's ward, I managed to avoid it by the skin of my teeth."
msgstr "　有珠から結界を<譲渡|じょうと>され、ここ一帯そのものとなった全能の知覚が、最小の回避を可能とする。"

#. Occurrence 3_1:1388:3077: scene=3_1
#: 3_1:1388
msgctxt "text_id=3077 | speaker=unknown"
msgid "  My hair fanned through the air from the violence of the attack."
msgstr "　礼儀知らずの蛮行に舞い上がる髪。"

#. Occurrence 3_1:1428:3078: scene=3_1
#: 3_1:1428
msgctxt "text_id=3078 | speaker=unknown"
msgid "  The strike grazed my cheek, and I felt a small, sharp pain."
msgstr "　頬をかする、小さいが鋭い痛み。"

#. Occurrence 3_1:1456:3079: scene=3_1
#: 3_1:1456
msgctxt "text_id=3079 | speaker=unknown"
msgid "  It felt like the kiss of death."
msgstr "　―――死が、魂に触れた気がした。"

#. Occurrence 3_1:1508:3080: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0001; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:1508
msgctxt "text_id=3080 | speaker=aoko"
msgid "\"...!\""
msgstr "「っ―――！」"

#. Occurrence 3_1:1563:3081: scene=3_1
#: 3_1:1563
msgctxt "text_id=3081 | speaker=unknown"
msgid "  I switched the flow of my body's blood to a different cycle."
msgstr "　体内の血流を、異なる<循環|かいろ>に切り替える。"

#. Occurrence 3_1:1568:3082: scene=3_1
#: 3_1:1568
msgctxt "text_id=3082 | speaker=unknown"
msgid "  The blood running through my veins at a few feet per second transmuted into an imaginary element."
msgstr "　秒速一メートルで体内を巡る血液が、架空の元素に変質する。"

#. Occurrence 3_1:1574:3083: scene=3_1
#: 3_1:1574
msgctxt "text_id=3083 | speaker=unknown"
msgid "My body became a single circuit and my heart transformed into a completely different engine."
msgstr "心臓はまったく別の<生|エ><成|ン><機|ジ><関|ン>に成りはてて、私の体を一つの回路として利用する。"

#. Occurrence 3_1:1595:3084: scene=3_1
#: 3_1:1595
msgctxt "text_id=3084 | speaker=unknown"
msgid "  Within me stirred an unknowable motion of immeasurable heat--"
msgstr "　熱量として計測されない不可知の運動。"

#. Occurrence 3_1:1600:3085: scene=3_1
#: 3_1:1600
msgctxt "text_id=3085 | speaker=unknown"
msgid "  Something Mystic, yet untapped by humankind, that made me who I am."
msgstr "　私を今の私にならしめた、いまだ人の手の及ばぬ神秘。"

#. Occurrence 3_1:1605:3086: scene=3_1
#: 3_1:1605
msgctxt "text_id=3086 | speaker=unknown"
msgid "  It was the fire of life behind all miracles and fables--"
msgstr "　あらゆる奇跡、<寓話|ぐうわ>の動力となる生命の火。"

#. Occurrence 3_1:1657:3087: scene=3_1
#: 3_1:1657
msgctxt "text_id=3087 | speaker=unknown"
msgid "  what we mages called magical energy."
msgstr "　これを、私たちは魔力と呼ぶ。"

#. Occurrence 3_1:1705:3088: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0002; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:1705
msgctxt "text_id=3088 | speaker=aoko"
msgid "\"...<Connecting|Set.>.\""
msgstr "「―――<接続|セット>」"

#. Occurrence 3_1:1752:3089: scene=3_1
#: 3_1:1752
msgctxt "text_id=3089 | speaker=unknown"
msgid "  I turned around, set the enemy in my sights, and held up one hand."
msgstr "　振り向いて敵を視界に収め、片手を振りかぶる。"

#. Occurrence 3_1:1757:3090: scene=3_1
#: 3_1:1757
msgctxt "text_id=3090 | speaker=unknown"
msgid "  My arm was the agent of my will."
msgstr "　腕は意志の代行だ。"

#. Occurrence 3_1:1762:3091: scene=3_1
#: 3_1:1762
msgctxt "text_id=3091 | speaker=unknown"
msgid "  My lack of experience meant my magecraft would only be possible with the use of vocalizations and gestures."
msgstr "　私はまだ未熟だから、<発|こ><音|え>と<手足|どうさ>を使わないと魔術は働いてくれない。"

#. Occurrence 3_1:1842:3092: scene=3_1
#: 3_1:1842
msgctxt "text_id=3092 | speaker=unknown"
msgid "  Magical formulae were engraved all over the park."
msgstr "　魔術式は予め公園に刻まれている。"

#. Occurrence 3_1:1847:3093: scene=3_1
#: 3_1:1847
msgctxt "text_id=3093 | speaker=unknown"
msgid "  All I had to do was ignite them."
msgstr "　私がするコトは、その式に火をくべるだけ。"

#. Occurrence 3_1:1852:3094: scene=3_1
#: 3_1:1852
msgctxt "text_id=3094 | speaker=unknown"
msgid "  I needed to direct the flow of the magical energy within my body into each formula."
msgstr "　体内で生成した魔力を、各自それぞれの方式で流しこめばいい。"

#. Occurrence 3_1:1903:3095: scene=3_1
#: 3_1:1903
msgctxt "text_id=3095 | speaker=unknown"
msgid "  Typically, a mage acts as a conduit. Whether wired or wireless, the mage simply pours magical energy into the formula."
msgstr "　たいていの魔術師は転移方式だ。有線にしろ無線にしろ、式に魔力を<注|そそ>げばいい。"

#. Occurrence 3_1:1909:3096: scene=3_1
#: 3_1:1909
msgctxt "text_id=3096 | speaker=unknown"
msgid "  Releasing this energy in the form of a projectile, stream, or any number of other methods would usually suffice, but in my case..."
msgstr "　“出す”“撃つ”“流す”と色々あるけど、私の場合はなんていうか、こう―――"

msgctxt "text_id=3097 | speaker=unknown"
msgid " It was the feeling of my limbs whipping out!"
msgstr "自分の手足で<弾|はじ>く感じ……！"

#. Occurrence 3_1:1951:3098: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0003; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:1951
msgctxt "text_id=3098 | speaker=aoko"
msgid "\"Burn!\""
msgstr "「―――燃えろ！」"

#. Occurrence 3_1:2015:3099: scene=3_1
#: 3_1:2015
msgctxt "text_id=3099 | speaker=unknown"
msgid "  I fought speed with speed."
msgstr "　高速に高速で対抗する。"

#. Occurrence 3_1:2072:3100: scene=3_1
#: 3_1:2072
msgctxt "text_id=3100 | speaker=unknown"
msgid "  The enemy's arm, extended ten feet forward, became engulfed in flames."
msgstr "　数メートル伸ばした腕はそのまま、敵は炎に包まれた。"

#. Occurrence 3_1:2077:3101: scene=3_1
#: 3_1:2077
msgctxt "text_id=3101 | speaker=unknown"
msgid "  It was nighttime at the park. The scene, reminiscent of a campfire, but one in which the center of the flames contained a humanoid figure wriggling like a shadow puppet."
msgstr "　夜の公園というコトもあってキャンプファイヤーを連想させる。ただ、炎の中で影絵のように<蠢|うごめ>くのは人間らしき姿だったけど。"

#. Occurrence 3_1:2135:3102: scene=3_1
#: 3_1:2135
msgctxt "text_id=3102 | speaker=unknown"
msgid "  The flame subsided just as unnaturally as it had ignited."
msgstr "　不自然に発した炎は、やっぱり不自然に消えた。"

#. Occurrence 3_1:2140:3103: scene=3_1
#: 3_1:2140
msgctxt "text_id=3103 | speaker=unknown"
msgid "  No crackling, no burning smell."
msgstr "　物を焼く音も、焦げた臭いもあまりない。"

#. Occurrence 3_1:2185:3104: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0004; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2185
msgctxt "text_id=3104 | speaker=aoko"
msgid "\"You can have the Bounded Field back. I'll check the remains.\""
msgstr "「―――結界、返すわ。死体を確認するから」"

#. Occurrence 3_1:2209:3105: scene=3_1
#: 3_1:2209
msgctxt "text_id=3105 | speaker=unknown"
msgid "  After telling this to Alice, I headed toward the motionless figure."
msgstr "　傍らの彼女に言って、もう動かない人影に足を向けた。"

#. Occurrence 3_1:2232:3106: scene=3_1
#: 3_1:2232
msgctxt "text_id=3106 | speaker=unknown"
msgid "  I killed it."
msgstr "　殺した。"

#. Occurrence 3_1:2238:3107: scene=3_1
#: 3_1:2238
msgctxt "text_id=3107 | speaker=unknown"
msgid "I killed it."
msgstr "殺した。"

#. Occurrence 3_1:2244:3108: scene=3_1
#: 3_1:2244
msgctxt "text_id=3108 | speaker=unknown"
msgid "I killed it."
msgstr "殺した。"

#. Occurrence 3_1:2249:3109: scene=3_1
#: 3_1:2249
msgctxt "text_id=3109 | speaker=unknown"
msgid "  Regardless of who my opponent was, I just took someone's life."
msgstr "　相手が何者であれ、人の命に、手をかけた。"

#. Occurrence 3_1:2254:3110: scene=3_1
#: 3_1:2254
msgctxt "text_id=3110 | speaker=unknown"
msgid "  My throat parched, I swallowed the truth that without this sense of reality I would have been helpless."
msgstr "　その、現実味もなければ手応えもなかった事実を、<渇|かわ>ききった喉で嚥下する。"

#. Occurrence 3_1:2260:3111: scene=3_1
#: 3_1:2260
msgctxt "text_id=3111 | speaker=unknown"
msgid "So hard and bitter, impossible to swallow...but I tried to anyway."
msgstr "硬くて苦くてこれっぽっちも飲み込めないけど、嚥下しようと努めていた。"

#. Occurrence 3_1:2298:3112: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0005; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2298
msgctxt "text_id=3112 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 3_1:2304:3113: scene=3_1
#: 3_1:2304
msgctxt "text_id=3113 | speaker=unknown"
msgid "  I was unnervingly calm. My heart pounded and my breath felt heavy, but my mind was nonetheless calm."
msgstr "　私はいたって冷静だ。心拍数はレートを幾分オーバーしていて、呼吸も<千|ち><々|ぢ>に乱れているけど、頭はすっごく冷静の筈。"

#. Occurrence 3_1:2309:3114: scene=3_1
#: 3_1:2309
msgctxt "text_id=3114 | speaker=unknown"
msgid "  By the time I realized it, the charred remains were already in front of me."
msgstr "　気が付けば消し炭はもう目の前。"

#. Occurrence 3_1:2314:3115: scene=3_1
#: 3_1:2314
msgctxt "text_id=3115 | speaker=unknown"
msgid "  Bracing for a counter-attack, I carefully examined the corpse."
msgstr "　反撃を想定しつつ、ゆっくり死骸を確認する。"

#. Occurrence 3_1:2332:3116: scene=3_1
#: 3_1:2332
msgctxt "text_id=3116 | speaker=unknown"
msgid "  Everything seemed fine. This body lying slumped to the ground, was nothing but ash."
msgstr "　……よし、問題なし。公園の地面に倒れ臥したそれは、燃えつきて灰になっていた。"

#. Occurrence 3_1:2353:3117: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0006; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2353
msgctxt "text_id=3117 | speaker=aoko"
msgid "\"...?\""
msgstr "「………？」"

#. Occurrence 3_1:2359:3118: scene=3_1
#: 3_1:2359
msgctxt "text_id=3118 | speaker=unknown"
msgid "  But something wasn't right."
msgstr "　けれど何かおかしい。"

#. Occurrence 3_1:2364:3119: scene=3_1
#: 3_1:2364
msgctxt "text_id=3119 | speaker=unknown"
msgid "  To begin with, its remains didn't smell organic."
msgstr "　一見した感想、残骸のあり方に生命の匂いがしない。"

#. Occurrence 3_1:2369:3120: scene=3_1
#: 3_1:2369
msgctxt "text_id=3120 | speaker=unknown"
msgid "  Not willing to believe my hunch, I took a closer look at the corpse's face."
msgstr "　まさか、と人影の顔を見る。"

#. Occurrence 3_1:2374:3121: scene=3_1
#: 3_1:2374
msgctxt "text_id=3121 | speaker=unknown"
msgid "  All that greeted me was the featureless white face of a mannequin."
msgstr "　そこには目も鼻もなく、マネキンのような白い面だけがあった。"

#. Occurrence 3_1:2418:3122: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0007; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2418
msgctxt "text_id=3122 | speaker=aoko"
msgid "\"Damn it, they got us again!\""
msgstr "「ちくしょー、またやられた！」"

#. Occurrence 3_1:2425:3123: scene=3_1
#: 3_1:2425
msgctxt "text_id=3123 | speaker=unknown"
msgid "  Screaming, I kicked the mannequin."
msgstr "　叫んでマネキンを蹴っとばす。"

#. Occurrence 3_1:2430:3124: scene=3_1
#: 3_1:2430
msgctxt "text_id=3124 | speaker=unknown"
msgid "  The corpse crumbled to ash and disappeared with the wind."
msgstr "　灰は風に舞い、死体も風化していく。"

#. Occurrence 3_1:2436:3125: scene=3_1
#: 3_1:2436
msgctxt "text_id=3125 | speaker=unknown"
msgid "No, this was no corpse. This was just a puppet, and for all our efforts to lure the master out, we had once again been tricked by a familiar."
msgstr "いや、死体というのは正しくないか。これはただの人形で、結局、おびき寄せたつもりが、またハズレを引かされた。"

#. Occurrence 3_1:2441:3126: scene=3_1
#: 3_1:2441
msgctxt "text_id=3126 | speaker=unknown"
msgid "  My debut, my first test out in the open, would be postponed for another day."
msgstr "　……本当の意味での初陣は、また先送りになったということだ。"

#. Occurrence 3_1:2486:3127: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0008; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2486
msgctxt "text_id=3127 | speaker=aoko"
msgid "\"Argh..."
msgstr "「はあ……"

msgctxt "text_id=3128 | speaker=unknown"
msgid " Will I ever pass this test...?"
msgstr "いつになったら一人前にって……"

msgctxt "text_id=3129 | speaker=unknown"
msgid " ...What?\""
msgstr "あれ？」"

#. Occurrence 3_1:2510:3130: scene=3_1
#: 3_1:2510
msgctxt "text_id=3130 | speaker=unknown"
msgid "  At that moment, I suddenly noticed something familiar in the corner of my eye."
msgstr "　その時、ふと視界を見慣れた物がかすめた。"

#. Occurrence 3_1:2515:3131: scene=3_1
#: 3_1:2515
msgctxt "text_id=3131 | speaker=unknown"
msgid "  Something seemed strange about the slide on the other end of the park. It appeared as though its shadow were larger than it should be."
msgstr "　むこうの滑り台の影のカタチがおかしい。なんというか、余分なモノでぷくっと太っている気がする。"

#. Occurrence 3_1:2540:3132: scene=3_1
#: 3_1:2540
msgctxt "text_id=3132 | speaker=unknown"
msgid "  Was I still drunk on the high of battle?"
msgstr "　戦闘の余熱でのぼせていたのか。"

#. Occurrence 3_1:2545:3133: scene=3_1
#: 3_1:2545
msgctxt "text_id=3133 | speaker=unknown"
msgid "  It took me a second to realize what it was."
msgstr "　私は、その“余分な影”が何であるか、思い出すのに一秒もかかってしまった。"

#. Occurrence 3_1:2589:3134: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0009; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2589
msgctxt "text_id=3134 | speaker=aoko"
msgid "\"Who's there!?\""
msgstr "「―――誰ッ！？」"

#. Occurrence 3_1:2596:3135: scene=3_1
#: 3_1:2596
msgctxt "text_id=3135 | speaker=unknown"
msgid "  Calling out was a mistake."
msgstr "　自分で言うのもなんだけど、失敗だった。"

#. Occurrence 3_1:2602:3136: scene=3_1
#: 3_1:2602
msgctxt "text_id=3136 | speaker=unknown"
msgid "  Startled by my voice, the figure, wearing a familiar high school uniform, took a step back, and then..."
msgstr "　その見慣れた高校の制服を着た誰かは私の声でビクっと後じさって、そのまま、"

msgctxt "text_id=3137 | speaker=unknown"
msgid " It broke into a sprint."
msgstr "ものすごい勢いで走り出した。"

#. Occurrence 3_1:2612:3138: scene=3_1
#: 3_1:2612
msgctxt "text_id=3138 | speaker=unknown"
msgid "  Like someone running for their life."
msgstr "　まるで必死に逃げるみたい―――"

#. Occurrence 3_1:2634:3139: scene=3_1
#: 3_1:2634
msgctxt "text_id=3139 | speaker=unknown"
msgid "  ...Or should I say, he was doing exactly that!"
msgstr "　―――って、実際逃げてるんだアレ！"

#. Occurrence 3_1:2678:3140: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0010; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2678
msgctxt "text_id=3140 | speaker=aoko"
msgid "\"After him! We've been spotted!\""
msgstr "「追いかけて！　見られた！」"

#. Occurrence 3_1:2684:3141: scene=3_1
#: 3_1:2684
msgctxt "text_id=3141 | speaker=unknown"
msgid "  In a rush, I shouted to my partner, but she hadn't even noticed the third party's presence in the first place."
msgstr "　急いで相棒に言うけれど、彼女は第三者の存在に気付いてもいなかった。"

#. Occurrence 3_1:2689:3142: scene=3_1
#: 3_1:2689
msgctxt "text_id=3142 | speaker=unknown"
msgid "  Though, it wasn't as if I could move by myself. Embarrassingly, the fight had taken more out of me than I'd have liked...!"
msgstr "　かといって自分も動けない。情けない事に、今の戦闘でまだ足がすくんでやがる……！"

#. Occurrence 3_1:2751:3143: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0011; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2751
msgctxt "text_id=3143 | speaker=aoko"
msgid "\"No, he'll get away!"
msgstr "「だめ、逃げられる！"

#. Occurrence 3_1:2757:3144: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0012; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2757
msgctxt "text_id=3144 | speaker=aoko"
msgid "  We need to catch and eliminate him!\""
msgstr "　捕まえて始末しないと……！」"

#. Occurrence 3_1:2763:3145: scene=3_1
#: 3_1:2763
msgctxt "text_id=3145 | speaker=unknown"
msgid "  There was no time for niceties."
msgstr "　上品に振る舞う余裕なんてない。"

#. Occurrence 3_1:2768:3146: scene=3_1
#: 3_1:2768
msgctxt "text_id=3146 | speaker=unknown"
msgid "  For us, being seen here was a matter of life and death!"
msgstr "　この現場を誰かに見られる事は、私たちにとって生死に関わる問題なんだから―――！"

#. Occurrence 3_1:2827:3147: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0013; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2827
msgctxt "text_id=3147 | speaker=aoko"
msgid "\"Wait, get back here you...!\""
msgstr "「待て、この……！」"

#. Occurrence 3_1:2833:3148: scene=3_1
#: 3_1:2833
msgctxt "text_id=3148 | speaker=unknown"
msgid "  Shaking off the numbness in my legs, I made for the park's exit."
msgstr "　足の<痺|しび>れを振り払って公園の外に出る。"

#. Occurrence 3_1:2861:3149: scene=3_1
#: 3_1:2861
msgctxt "text_id=3149 | speaker=unknown"
msgid "  I had to admire his escape."
msgstr "　……なんて見事な逃げ足だろう。"

#. Occurrence 3_1:2866:3150: scene=3_1
#: 3_1:2866
msgctxt "text_id=3150 | speaker=unknown"
msgid "  The witness, party to the entire night's proceedings, had disappeared into the darkness of the residential district without a trace."
msgstr "　一部始終を目撃していた何者かは、跡形もなく住宅地の闇に消えていた。"

#. Occurrence 3_1:2887:3151: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0014; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2887
msgctxt "text_id=3151 | speaker=aoko"
msgid "\"Why the hell didn't I sense him in the field!?\""
msgstr "「ああもう、結界にあいつの感触なんてなかったのに……！」"

#. Occurrence 3_1:2893:3152: scene=3_1
#: 3_1:2893
msgctxt "text_id=3152 | speaker=unknown"
msgid "  Complaining to myself wouldn't bring back the figure in uniform."
msgstr "　などと、文句を言ってみても学生服の人影が戻ってくる筈もない。"

#. Occurrence 3_1:2898:3153: scene=3_1
#: 3_1:2898
msgctxt "text_id=3153 | speaker=unknown"
msgid "  Bitter at my own incompetence, I gave up the chase."
msgstr "　自分の情けなさを恨めしく思いながら、私は追跡を諦めた。"

#. Occurrence 3_1:2951:3154: scene=3_1
#: 3_1:2951
msgctxt "text_id=3154 | speaker=unknown"
msgid "  Though temporary, the park had become Alice's \"woods.\""
msgstr "　一時的にしろ、公園は有珠の“森”になっている。"

#. Occurrence 3_1:2956:3155: scene=3_1
#: 3_1:2956
msgctxt "text_id=3155 | speaker=unknown"
msgid "  For anyone within a few feet of the park, other park-goers' identifiable features and voices became murky, like the stuff of fairy tales."
msgstr "　ここでは一メートル以内にいようと人物像の特定、声の確認はあやふやになる。なにしろ童話の中の出来事だ。"

#. Occurrence 3_1:2961:3156: scene=3_1
#: 3_1:2961
msgctxt "text_id=3156 | speaker=unknown"
msgid "  Tonight's proceedings may have had a witness, but if our identities were still hidden... Then this was still a chance."
msgstr "　一連の出来事は見られたが、私や彼女の顔や素性は知られていない―――なら、他に打つ手はある。"

#. Occurrence 3_1:3027:3157: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0015; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:3027
msgctxt "text_id=3157 | speaker=aoko"
msgid "\"That looked like a male from behind.\""
msgstr "「あの背中、男だった」"

#. Occurrence 3_1:3033:3158: scene=3_1
#: 3_1:3033
msgctxt "text_id=3158 | speaker=unknown"
msgid "  I returned to the park."
msgstr "　公園に戻る。"

#. Occurrence 3_1:3038:3159: scene=3_1
#: 3_1:3038
msgctxt "text_id=3159 | speaker=unknown"
msgid "  That uniform was, without a doubt, from my high school."
msgstr "　見慣れていて当然で、アレは間違いなくうちの高校の制服だ。"

#. Occurrence 3_1:3043:3160: scene=3_1
#: 3_1:3043
msgctxt "text_id=3160 | speaker=unknown"
msgid "  That was clue enough. If he was a schoolmate of mine, I had plenty of methods to flush him out."
msgstr "　手がかりとしてはそれで十分。うちの生徒なら洗いだす手段はいくらでもある。"

#. Occurrence 3_1:3064:3161: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0016; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:3064
msgctxt "text_id=3161 | speaker=aoko"
msgid "\"...It's one thing after another.\""
msgstr "「……にしても。どうしてこう問題ばっかり増えていくんだろう」"

#. Occurrence 3_1:3070:3162: scene=3_1
#: 3_1:3070
msgctxt "text_id=3162 | speaker=unknown"
msgid "  Amidst my grumbling, I set my priorities straight."
msgstr "　などと愚痴りつつも、解決の優先順位ははっきりしていた。"

#. Occurrence 3_1:3075:3163: scene=3_1
#: 3_1:3075
msgctxt "text_id=3163 | speaker=unknown"
msgid "  Before some strange rumors spread, I needed to seal the witness's mouth shut."
msgstr "　変な噂をばらまかれるより早く、さっきの目撃者の口を封じなくてはいけない。"

#. Occurrence 3_1:3080:3164: scene=3_1
#: 3_1:3080
msgctxt "text_id=3164 | speaker=unknown"
msgid "  That was the highest priority. Quickly and without mercy."
msgstr "　それも最優先で、迅速に、容赦なく。"

#. Occurrence 3_1:3126:3165: scene=3_1
#: 3_1:3126
msgctxt "text_id=3165 | speaker=unknown"
msgid "  Looking up, I saw Alice's previously distant figure."
msgstr "　顔を上げると、離れていた有珠の姿が見えた。"

#. Occurrence 3_1:3131:3166: scene=3_1
#: 3_1:3131
msgctxt "text_id=3166 | speaker=unknown"
msgid "  Though she was in as much trouble as I was with her existence as a mage also exposed, she had but one thing to say."
msgstr "　魔術師としてのあり方を目撃され、ピンチなのは彼女も同じなのに、"

#. Occurrence 3_1:3162:3167: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_3_1_0002; voice_prefix=A40; voice_category=2; scene=3_1
#: 3_1:3162
msgctxt "text_id=3167 | speaker=alice"
msgid "\"...This means trouble.\""
msgstr "「……これは、困った事になったわね」"

#. Occurrence 3_1:3168:3168: scene=3_1
#: 3_1:3168
msgctxt "text_id=3168 | speaker=unknown"
msgid "  Her statue-like figure, staring into the darkness, seemed more expressionless than calm."
msgstr "　人影の走り去った闇を見つめる姿は、冷静というより彫像か何かのように無反応。"

#. Occurrence 3_1:3174:3169: scene=3_1
#: 3_1:3174
msgctxt "text_id=3169 | speaker=unknown"
msgid "  ...I was pissed off."
msgstr "　……本当、うんざりする。"

#. Occurrence 3_1:3174:3170: scene=3_1
#: 3_1:3174
msgctxt "text_id=3170 | speaker=unknown"
msgid "  Her inscrutable voice resembled the moonless night so much it made me angry."
msgstr "　抑揚のないその声は、月の無い晩に、憎らしいほど似合っていた。"

#. Occurrence 4_1:44:3171: scene=4_1
#: 4_1:44
msgctxt "text_id=3171 | speaker=unknown"
msgid "  There really isn't any other way of saying this. I am a magician."
msgstr "　唐突に言うと、私は魔法使いである。"

#. Occurrence 4_1:73:3172: scene=4_1
#: 4_1:73
msgctxt "text_id=3172 | speaker=unknown"
msgid "  Kind of like those witches in fairy tales who live alone in the woods and perform miracles with the wave of a finger."
msgstr "　なんていうか、指先ひとつで奇跡を起こして、<辺鄙|へんぴ>な森に隠れ住んでいる童話のあれだ。"

#. Occurrence 4_1:78:3173: scene=4_1
#: 4_1:78
msgctxt "text_id=3173 | speaker=unknown"
msgid "  While the popular depiction of it differs from reality, it's closer to the truth than you know."
msgstr "　イメージはちょっと違うけど、わりと的を射ているので採用したいと思う。"

#. Occurrence 4_1:100:3174: scene=4_1
#: 4_1:100
msgctxt "text_id=3174 | speaker=unknown"
msgid "  Though just so we're clear, no, I don't fly through the sky on a broom."
msgstr "　ただ断っておくと、ホウキに乗って空は飛ばない。"

#. Occurrence 4_1:105:3175: scene=4_1
#: 4_1:105
msgctxt "text_id=3175 | speaker=unknown"
msgid "  I cannot transform into animals or speak with small birds."
msgstr "　動物に変身したり小鳥と話したりもできない。"

#. Occurrence 4_1:110:3176: scene=4_1
#: 4_1:110
msgctxt "text_id=3176 | speaker=unknown"
msgid "  Modern mages are nothing so fanciful."
msgstr "　夢があるようでないのが今風の魔術師なのである。"

#. Occurrence 4_1:164:3177: scene=4_1
#: 4_1:164
msgctxt "text_id=3177 | speaker=unknown"
msgid "  Our existence sounds unbelievable, but we're quite grounded. "
msgstr "　非常識だけど現実的。"

#. Occurrence 4_1:169:3178: scene=4_1
#: 4_1:169
msgctxt "text_id=3178 | speaker=unknown"
msgid "  Though it may seem like we can do anything, we're actually majorly constrained."
msgstr "　万能なようでわりと<窮屈|きゅうくつ>。"

#. Occurrence 4_1:174:3179: scene=4_1
#: 4_1:174
msgctxt "text_id=3179 | speaker=unknown"
msgid "  And while I still have a lot to learn about it, this is my real job. Sounds a lot more romantic than being a high school student, right?"
msgstr "　胸を張るには色々半端なものだけど、私の本当の職業は学生じゃなくて、そんな<浪漫|ロマン>あふれるものだった。"

#. Occurrence 4_1:194:3180: scene=4_1
#: 4_1:194
msgctxt "text_id=3180 | speaker=unknown"
msgid "  Naturally, this is a secret I don't just share with anyone."
msgstr "　けど、その事はもちろん秘密。"

#. Occurrence 4_1:200:3181: scene=4_1
#: 4_1:200
msgctxt "text_id=3181 | speaker=unknown"
msgid "\"A mage must do everything in their power to conceal their work.\""
msgstr "“魔術師はこれ、その<御業|みわざ>をすべて<隠匿|いんとく>すべし”"

#. Occurrence 4_1:206:3182: scene=4_1
#: 4_1:206
msgctxt "text_id=3182 | speaker=unknown"
msgid "  That is the first and most important of the Association's ten laws, not that I'm tempted to let the cat out the bag in the least."
msgstr "　協会の十箇条のトップに出ている事だし、私だってこんなワケわかんない<話|こと>を口外する気はさらさらない。"

#. Occurrence 4_1:253:3183: scene=4_1
#: 4_1:253
msgctxt "text_id=3183 | speaker=unknown"
msgid "  My secret identity as an honor student is intact, and absolutely no good would come of me revealing my true nature."
msgstr "　これでも外じゃ優等生で通っているし、だいたい、知らしめたところで私が嬉しい事なんてまったくない。"

#. Occurrence 4_1:258:3184: scene=4_1
#: 4_1:258
msgctxt "text_id=3184 | speaker=unknown"
msgid "  If anything, it'd only lead to more headaches."
msgstr "　どっちかというと頭の痛いことばかりだ。"

#. Occurrence 4_1:263:3185: scene=4_1
#: 4_1:263
msgctxt "text_id=3185 | speaker=unknown"
msgid "  That's why I do everything in my power to keep it a secret."
msgstr "　なので、そんなつまんない事は極力、自重するにかぎる。"

#. Occurrence 4_1:298:3186: scene=4_1
#: 4_1:298
msgctxt "text_id=3186 | speaker=unknown"
msgid "  Of course, if I'd accomplished anything as a magician by now, then maybe I'd see it differently."
msgstr "　もっとも、それはまだ私が立派な魔法使いになれていないからだ。"

#. Occurrence 4_1:303:3187: scene=4_1
#: 4_1:303
msgctxt "text_id=3187 | speaker=unknown"
msgid "  I've fantasized about revealing my secret life's work to a single, special person, when I finally make something of myself."
msgstr "　生涯の秘密というのは、私自身が立派になって一人前になった時、たったひとりにだけ打ち明けられれば、それで幸せだと思う。"

#. Occurrence 4_1:323:3188: scene=4_1
#: 4_1:323
msgctxt "text_id=3188 | speaker=unknown"
msgid "  Yeah... it'd be pretty stellar to just confess one day, \"By the way, I'm a magician.\""
msgstr "　うん。いちばん大きな秘密の告白が『実は魔法使いでした』なんていうのは、たいへん洒落ている。"

#. Occurrence 4_1:329:3189: scene=4_1
#: 4_1:329
msgctxt "text_id=3189 | speaker=unknown"
msgid "  That idea alone is enough to keep me from spoiling the big reveal, regardless of the Association's rules."
msgstr "　そのシーンを想像すると妙におかしくて、協会の規則なんかより晩年のために秘密を守りたくなるぐらい。"

#. Occurrence 4_1:374:3190: scene=4_1
#: 4_1:374
msgctxt "text_id=3190 | speaker=unknown"
msgid "  My grandfather patted me on the head when I shared these thoughts with him."
msgstr "　以上の事を祖父に話すと、彼は私の頭を撫でてくれた。"

#. Occurrence 4_1:380:3191: scene=4_1
#: 4_1:380
msgctxt "text_id=3191 | speaker=unknown"
msgid "  I don't know if that was praise or what, but I remember that his touch was gentle."
msgstr "　誉めてくれたのか<窘|たしな>めていたのかは分からないけど、あの人にしては優しい感触だったと思う。"

#. Occurrence 4_1:411:3192: scene=4_1
#: 4_1:411
msgctxt "text_id=3192 | speaker=unknown"
msgid "  I first learned that I would be succeeding my grandfather on the day I graduated middle school."
msgstr "　私が魔術―――祖父の後を継ぐ事になったのは、中学を卒業したその日だった。"

#. Occurrence 4_1:416:3193: scene=4_1
#: 4_1:416
msgctxt "text_id=3193 | speaker=unknown"
msgid "  When I returned home, there he was."
msgstr "　家に帰るなり祖父は"

#. Occurrence 4_1:422:3194: scene=4_1
#: 4_1:422
msgctxt "text_id=3194 | speaker=unknown"
msgid "\"Your elder sister left on a journey. From this day forth, you are the heir to the Aozaki.\""
msgstr "『姉は旅に出た。今日からおまえが蒼崎の後継ぎだ』"

#. Occurrence 4_1:428:3195: scene=4_1
#: 4_1:428
msgctxt "text_id=3195 | speaker=unknown"
msgid "  He said it in such a matter-of-fact way."
msgstr "　なんて事を淡々と語ったのだ。"

#. Occurrence 4_1:460:3196: scene=4_1
#: 4_1:460
msgctxt "text_id=3196 | speaker=unknown"
msgid "  I knew that the Aozaki family passed down this old tradition of magecraft, but to be honest, I never imagined I would be the one to wield it."
msgstr "　蒼崎の家が魔術なんて古くさいものを伝えていた事は知っていたけど、正直、自分にそのおはちが回ってくるとは思ってもいなかった。"

#. Occurrence 4_1:493:3197: scene=4_1
#: 4_1:493
msgctxt "text_id=3197 | speaker=unknown"
msgid "  Magecraft is supposed to be passed down to a single child."
msgstr "　魔術の継承は<一子相伝|いっしそうでん>とかなんとか。"

#. Occurrence 4_1:499:3198: scene=4_1
#: 4_1:499
msgctxt "text_id=3198 | speaker=unknown"
msgid "  It was my sister's role to take the mantle, and I had no interest in dedicating myself to so many rules and routines. I planned to live a normal life; I had hopes and dreams for the future."
msgstr "　色々と決まり事の多そうな魔法使いの座とやらは姉貴の役割で、私はそういうトンデモとは無関係。いたってノーマルな生活設計、将来希望だったのだ。"

#. Occurrence 4_1:519:3199: scene=4_1
#: 4_1:519
msgctxt "text_id=3199 | speaker=unknown"
msgid "  I felt bad for my sister, but I was determined to live my life my way."
msgstr "　なので、姉貴には悪いけど自由気ままに人生を送らせてもらいましょう―――"

#. Occurrence 4_1:524:3200: scene=4_1
#: 4_1:524
msgctxt "text_id=3200 | speaker=unknown"
msgid "  And while I managed to do just that for a time, I was blindsided by a vicious counterpunch."
msgstr "　なんて気楽にやってきたところで、とんでもないカウンターが待っていたワケである。"

#. Occurrence 4_1:557:3201: scene=4_1
#: 4_1:557
msgctxt "text_id=3201 | speaker=unknown"
msgid "  Since then, I've been thrust headlong into a world I had only observed from afar."
msgstr "　以来、私は今まで横目で見ていただけの世界に身を置くことになった。"

#. Occurrence 4_1:562:3202: scene=4_1
#: 4_1:562
msgctxt "text_id=3202 | speaker=unknown"
msgid "  It was a hell of a way to start high school."
msgstr "　まさかまさかの高校デビュー。"

#. Occurrence 4_1:568:3203: scene=4_1
#: 4_1:568
msgctxt "text_id=3203 | speaker=unknown"
msgid "  But I suppose it wasn't all that bad, all things considered."
msgstr "　まあ、新生活のスタートとしては悪くない。"

#. Occurrence 4_1:604:3204: scene=4_1
#: 4_1:604
msgctxt "text_id=3204 | speaker=unknown"
msgid "  ...A lot has happened since then."
msgstr "　……それから色々あって現在。"

#. Occurrence 4_1:609:3205: scene=4_1
#: 4_1:609
msgctxt "text_id=3205 | speaker=unknown"
msgid "  I was so dazed by this newfound life that a year of school motored right by. I was a second-year before I knew it."
msgstr "　この役柄には戸惑ったけど、それも気が付けばもう二年目に届こうとしている。"

#. Occurrence 4_1:641:3206: scene=4_1
#: 4_1:641
msgctxt "text_id=3206 | speaker=unknown"
msgid "  Thankfully, nothing drastic has happened... the six months my roommate and I totally tried to kill each other nonwithstanding."
msgstr "　その間にトラブルらしき物は一切なかったし……私たちの名誉のため、半年に<亘|わた>る同居人との殺し合いはカウントしない……"

#. Occurrence 4_1:647:3207: scene=4_1
#: 4_1:647
msgctxt "text_id=3207 | speaker=unknown"
msgid "As it happens, I've got a natural talent at this magic stuff, so I've yet to have any hang-ups there, either."
msgstr "魔法使いとしての才能もそれなりに優れているみたいで、まだ壁にはぶつかってはいない。"

#. Occurrence 4_1:691:3208: scene=4_1
#: 4_1:691
msgctxt "text_id=3208 | speaker=unknown"
msgid "  I'm only human, so I've had my fair share of headaches for sure, but never once did I worry about my future."
msgstr "　人間なんだから頭の痛い悩みは二つや三つあるけれど、今のところ将来に不安を感じる事はまったくなかった。"

#. Occurrence 4_1:696:3209: scene=4_1
#: 4_1:696
msgctxt "text_id=3209 | speaker=unknown"
msgid "  I thought my life would be smooth sailing all the way."
msgstr "　私の生活は、このまま<順風満帆|じゅんぷうまんぱん>に行くと思っていたのだ。"

#. Occurrence 4_1:713:3210: scene=4_1
#: 4_1:713
msgctxt "text_id=3210 | speaker=unknown"
msgid "  If only everything had gone to plan last night."
msgstr "　昨夜の、例の一件さえ起こらなければ。"

#. Occurrence 4_1:748:3211: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0000; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:748
msgctxt "text_id=3211 | speaker=alice"
msgid "\"Well?\""
msgstr "「どう？」"

#. Occurrence 4_1:770:3212: scene=4_1
#: 4_1:770
msgctxt "text_id=3212 | speaker=unknown"
msgid "  Alice Kuonji asked Aoko Aozaki the second she entered the house."
msgstr "　久遠寺邸に帰宅するなり、蒼崎青子は久遠寺有珠にそう<訊|たず>ねられた。"

#. Occurrence 4_1:775:3213: scene=4_1
#: 4_1:775
msgctxt "text_id=3213 | speaker=unknown"
msgid "  Her dark eyes succeeded where her voice failed to communicate the gravity of the situation."
msgstr "　切迫感も危機感もない声だが、<玻|は><璃|り>のような<黒瞳|こくどう>が事の重要性を告げている。"

#. Occurrence 4_1:826:3214: scene=4_1
#: 4_1:826
msgctxt "text_id=3214 | speaker=unknown"
msgid "  Aoko took off her unflattering coat, hung it on the hanger, and sat down on the sofa."
msgstr "　色気のないコートを脱いでハンガーにかけ、青子はソファーに腰を下ろした。"

#. Occurrence 4_1:831:3215: scene=4_1
#: 4_1:831
msgctxt "text_id=3215 | speaker=unknown"
msgid "  Alice sat across from her, with a table separating them."
msgstr "　正面にはテーブルを挟んで有珠が座っている。"

#. Occurrence 4_1:865:3216: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0000; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:865
msgctxt "text_id=3216 | speaker=aoko"
msgid "\"Any progress with those things?\""
msgstr "「そっちは？」"

#. Occurrence 4_1:885:3217: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0001; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:885
msgctxt "text_id=3217 | speaker=alice"
msgid "\"Not at all. I've only got seven left that are any good for reconnaissance. I've been using them up fast and haven't had time to make more.\""
msgstr "「良くないわね。<偵察|ていさつ>に行けるのは七個ぐらい。ここのところ使ってばかりで、作り置きをする余裕もなかったし」"

#. Occurrence 4_1:891:3218: scene=4_1
#: 4_1:891
msgctxt "text_id=3218 | speaker=unknown"
msgid "  Alice's gaze drifted from Aoko to the box on the table."
msgstr "　青子から視線を逸らすと、有珠はテーブルの上に置かれた箱に視線を戻す。"

#. Occurrence 4_1:937:3219: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0001; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:937
msgctxt "text_id=3219 | speaker=aoko"
msgid "\"Were none of them keeping watch that night?"
msgstr "「あの夜、街を監視していたヤツはいないの？"

#. Occurrence 4_1:937:3220: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0001; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:937
msgctxt "text_id=3220 | speaker=aoko"
msgid "  They've never let you down when it comes to this sort of thing, have they?\""
msgstr "　街の偵察は完璧なんでしょ、そいつら」"

#. Occurrence 4_1:953:3221: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0002; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:953
msgctxt "text_id=3221 | speaker=alice"
msgid "\"During the day, no. But there is quite the risk when flying them at night.\""
msgstr "「それは昼間の話よ。夜間飛行は危険が多いわ」"

#. Occurrence 4_1:990:3222: scene=4_1
#: 4_1:990
msgctxt "text_id=3222 | speaker=unknown"
msgid "  Meaning they were of the least use when needed the most. Aoko sighed."
msgstr "　肝心なところで役に立たないのね、とため息をつく青子。"

#. Occurrence 4_1:1017:3223: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0003; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:1017
msgctxt "text_id=3223 | speaker=alice"
msgid "\"...Well, how are you faring? You seemed pretty confident this morning.\""
msgstr "「……そういう貴女は？　朝はずいぶんと強気だったけど？」"

#. Occurrence 4_1:1046:3224: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0002; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1046
msgctxt "text_id=3224 | speaker=aoko"
msgid "\"Hm?"
msgstr "「ん？　"

msgctxt "text_id=3225 | speaker=unknown"
msgid " Yeah, I guess everything's good on my end."
msgstr "あ、こっちは予定通りよ。"

#. Occurrence 4_1:1059:3226: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0003; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1059
msgctxt "text_id=3226 | speaker=aoko"
msgid "  I'm pretty sure I'll know by tomorrow. I told Tobimaru to look into all of the students' addresses and schedules."
msgstr "　明日までにはしぼりこめると思う。今朝、鳶丸にうちの生徒の自宅と行動時間を調べさせたから。"

#. Occurrence 4_1:1065:3227: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0004; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1065
msgctxt "text_id=3227 | speaker=aoko"
msgid "  Not many people wander the park that time of night, so it should be easy enough to figure out who it was.\""
msgstr "　あの時間に公園をうろつく奴は滅多にいないし、簡単に割り出せる」"

#. Occurrence 4_1:1098:3228: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0004; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:1098
msgctxt "text_id=3228 | speaker=alice"
msgid "\"How can you be so sure?\""
msgstr "「そう簡単にいくの？」"

#. Occurrence 4_1:1104:3229: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0005; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1104
msgctxt "text_id=3229 | speaker=aoko"
msgid "\"Because. I didn't just join the student council to keep up appearances. I've been using my position to keep tabs on everyone."
msgstr "「いくわよ。<伊|ダ><達|テ>に生徒会に勤めてないわ。その程度のデータは揃えてある。"

#. Occurrence 4_1:1111:3230: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0006; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1111
msgctxt "text_id=3230 | speaker=aoko"
msgid "I have info on everything from part-time jobs, to friends' addresses, to what they're up to in their spare time."
msgstr "月一のバイト先はおろか親しい友人宅との移動時間、その優先順位まで調べ上げてるんだから。"

#. Occurrence 4_1:1117:3231: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0007; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1117
msgctxt "text_id=3231 | speaker=aoko"
msgid "  It's a list I was hoping to keep secret, but we can't afford to do that now, can we? That's why I keep the vice president around. It's the kind of thing he does best.\""
msgstr "　<他|ひ><人|と>には見せたくなかったリストだけど、そんな余裕ないでしょ？　だから、そういうのが向いてる副会長にやらせたの」"

#. Occurrence 4_1:1155:3232: scene=4_1
#: 4_1:1155
msgctxt "text_id=3232 | speaker=unknown"
msgid "  Incidentally, the creation of this secret file started the moment Aoko became student council president."
msgstr "　余談ではあるが、その機密ファイルが作成されたのは青子が生徒会長になってからである。"

#. Occurrence 4_1:1160:3233: scene=4_1
#: 4_1:1160
msgctxt "text_id=3233 | speaker=unknown"
msgid "  The mere rumor of its existence was enough to strike fear into the entire student body."
msgstr "　その存在だけが噂され、彼女が全校生徒に恐れられる一因になっている、いわく付きの一品だ。"

#. Occurrence 4_1:1199:3234: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0005; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:1199
msgctxt "text_id=3234 | speaker=alice"
msgid "\"...As thorough as always, I see.\""
msgstr "「……そう。徹底しているわね、あい変わらず」"

#. Occurrence 4_1:1205:3235: scene=4_1
#: 4_1:1205
msgctxt "text_id=3235 | speaker=unknown"
msgid "  Alice was only mildly surprised."
msgstr "　やや呆れ気味に漏らす有珠。"

#. Occurrence 4_1:1210:3236: scene=4_1
#: 4_1:1210
msgctxt "text_id=3236 | speaker=unknown"
msgid "  It had been almost two years since they first started living together."
msgstr "　同居をはじめて二年近く。"

#. Occurrence 4_1:1215:3237: scene=4_1
#: 4_1:1215
msgctxt "text_id=3237 | speaker=unknown"
msgid "  She knew as well as anyone that when Aoko put her mind to something, she saw it through to the end."
msgstr "　一度やると決めればとことんまで突っ走るのが蒼崎青子だと、有珠も十分身にしみている。"

#. Occurrence 4_1:1258:3238: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0008; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1258
msgctxt "text_id=3238 | speaker=aoko"
msgid "\"Well, I never imagined I'd have to use it like this. But it's better to be safe than sorry.\""
msgstr "「ま、私もアレがこんな風に役立つとは思ってもみなかったけど。ほんと、備えあれば憂いなしとはこの事ね」"

#. Occurrence 4_1:1264:3239: scene=4_1
#: 4_1:1264
msgctxt "text_id=3239 | speaker=unknown"
msgid "  But what happened last night was far beyond a mere exception to the rule."
msgstr "　とはいえ昨夜の出来事は異例中の異例だ。"

#. Occurrence 4_1:1269:3240: scene=4_1
#: 4_1:1269
msgctxt "text_id=3240 | speaker=unknown"
msgid "  This predicament should not have even been possible."
msgstr "　この状況は、本来起こりえるものではない。"

#. Occurrence 4_1:1308:3241: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_9000; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1308
msgctxt "text_id=3241 | speaker=aoko"
msgid "\"More importantly, have you figured out what went wrong? And don't tell me it had anything to do with your link to the Bounded Field.\""
msgstr "「それより原因は分かったの？　結界の<結|むす>びに不手際があったなんてのは聞かないわよ」"

#. Occurrence 4_1:1314:3242: scene=4_1
#: 4_1:1314
msgctxt "text_id=3242 | speaker=unknown"
msgid "  Aoko glared at her."
msgstr "　凛とした視線を一際強くする青子。"

#. Occurrence 4_1:1319:3243: scene=4_1
#: 4_1:1319
msgctxt "text_id=3243 | speaker=unknown"
msgid "  The ward was Alice's responsibility."
msgstr "　結界の仕上げは有珠の役割だ。"

#. Occurrence 4_1:1324:3244: scene=4_1
#: 4_1:1324
msgctxt "text_id=3244 | speaker=unknown"
msgid "  If it was to blame for last night's trouble, Alice had to own up to her fair share."
msgstr "　昨夜のトラブルの原因が結界にあるのなら、責任の所在は明らかにしなくてはならない。"

#. Occurrence 4_1:1361:3245: scene=4_1
#: 4_1:1361
msgctxt "text_id=3245 | speaker=unknown"
msgid "  Alice and Aoko may have been roommates and partners, but it was a relationship of convenience."
msgstr "　同居人であり相棒である青子と有珠だが、それはあくまで利害が一致しているからである。"

#. Occurrence 4_1:1366:3246: scene=4_1
#: 4_1:1366
msgctxt "text_id=3246 | speaker=unknown"
msgid "  While lineage had brought them together, they were more like enemies than allies."
msgstr "　ふたりの関係は、それが家柄によるものだとしても、味方というより敵に近い。"

#. Occurrence 4_1:1371:3247: scene=4_1
#: 4_1:1371
msgctxt "text_id=3247 | speaker=unknown"
msgid "  Ultimately, they were just not a match."
msgstr "　最終的な話、蒼崎青子と久遠寺有珠は<相容|あいい>れない。"

#. Occurrence 4_1:1407:3248: scene=4_1
#: 4_1:1407
msgctxt "text_id=3248 | speaker=unknown"
msgid "  Where there was a blunder, it was punished."
msgstr "　失点があれば叩く。"

#. Occurrence 4_1:1426:3249: scene=4_1
#: 4_1:1426
msgctxt "text_id=3249 | speaker=unknown"
msgid "  Where there was an opening, it would be attacked."
msgstr "　隙があれば攻撃する。"

#. Occurrence 4_1:1453:3250: scene=4_1
#: 4_1:1453
msgctxt "text_id=3250 | speaker=unknown"
msgid "  If there was even an opportunity..."
msgstr "　―――機会さえ。"

#. Occurrence 4_1:1458:3251: scene=4_1
#: 4_1:1458
msgctxt "text_id=3251 | speaker=unknown"
msgid "  The two of them would kill each other in the event of such a moment."
msgstr "　互いが信条的に納得のいく機会が訪れるのなら、当然のように殺し合う関係だ。"

#. Occurrence 4_1:1514:3252: scene=4_1
#: 4_1:1514
msgctxt "text_id=3252 | speaker=unknown"
msgid "  Alice locked eyes with Aoko."
msgstr "　そんな青子の視線を、有珠は正面から受けとめる。"

#. Occurrence 4_1:1542:3253: scene=4_1
#: 4_1:1542
msgctxt "text_id=3253 | speaker=unknown"
msgid "  Aoko's fierce gaze could make a grown man cower in fear, but Alice did not bat an eyelash."
msgstr "　大の男でもたじろぐ視線を前にして、有珠の<表情|かお>は微塵も変わらない。"

#. Occurrence 4_1:1569:3254: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0007; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:1569
msgctxt "text_id=3254 | speaker=alice"
msgid "\"...Assuming the Bounded Field was the problem, wouldn't this have happened countless times before?\""
msgstr "「……仮の話だけど。あの結界に落ち度があったのなら、今まで何度もこういう状況になっていたでしょうね」"

#. Occurrence 4_1:1591:3255: scene=4_1
#: 4_1:1591
msgctxt "text_id=3255 | speaker=unknown"
msgid "  \"I suppose you're right,\" Aoko agreed, as the question reaffirmed her trust in Alice."
msgstr "　でしょうね、と青子は頷いた。立場上問いつめただけで、青子は有珠を信頼している。"

#. Occurrence 4_1:1626:3256: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0009; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1626
msgctxt "text_id=3256 | speaker=aoko"
msgid "\"So you're saying there was nothing wrong with it?\""
msgstr "「結界の在り方は完璧だったのね？」"

#. Occurrence 4_1:1650:3257: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0008; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:1650
msgctxt "text_id=3257 | speaker=alice"
msgid "\"I honestly can't say for sure.\""
msgstr "「絶対とまでは、断言はできないけど」"

#. Occurrence 4_1:1656:3258: scene=4_1
#: 4_1:1656
msgctxt "text_id=3258 | speaker=unknown"
msgid "  Alice answered as flatly as ever."
msgstr "　やはり抑揚のない声で答える有珠。"

#. Occurrence 4_1:1718:3259: scene=4_1
#: 4_1:1718
msgctxt "text_id=3259 | speaker=unknown"
msgid "  A Bounded Field is like a sanctuary sealed away from the real world."
msgstr "　結界とは、一つの閉じられた世界を意味する。"

#. Occurrence 4_1:1723:3260: scene=4_1
#: 4_1:1723
msgctxt "text_id=3260 | speaker=unknown"
msgid "  Steps are taken whereby a certain area is cut off from the outside world."
msgstr "　閉じたい場所を、どのような手段であれ外界から<遮断|しゃだん>した状況を結界と呼ぶ。"

#. Occurrence 4_1:1728:3261: scene=4_1
#: 4_1:1728
msgctxt "text_id=3261 | speaker=unknown"
msgid "  There are various kinds of Bounded Fields."
msgstr "　結界には様々な種類があり、"

#. Occurrence 4_1:1733:3262: scene=4_1
#: 4_1:1733
msgctxt "text_id=3262 | speaker=unknown"
msgid "  There are physical ones that close off an area behind a wall,"
msgstr "　実際にその区間を壁で隔離する物理的なものもあれば、"

#. Occurrence 4_1:1738:3263: scene=4_1
#: 4_1:1738
msgctxt "text_id=3263 | speaker=unknown"
msgid "  and less tangible ones that use mirrors, mist, or trees to conceal that which occurs within."
msgstr "　区間内の様子を鏡や霧、森の囲み等で隠してしまう視覚的なものもある。"

#. Occurrence 4_1:1759:3264: scene=4_1
#: 4_1:1759
msgctxt "text_id=3264 | speaker=unknown"
msgid "  However, when closing off an area to the outside world, you cannot avoid communicating the abnormality's existence."
msgstr "　ただし、それらの結界は『内部』を閉じるために『外部』に異常性を報せてしまっている。"

#. Occurrence 4_1:1764:3265: scene=4_1
#: 4_1:1764
msgctxt "text_id=3265 | speaker=unknown"
msgid "  In other words, the area may be closed off to the outside world, but it is impossible to hide the fact that it is closed off."
msgstr "　立ち入り禁止にはできても、その区間が立ち入り禁止となっている事実を隠蔽できない。"

#. Occurrence 4_1:1769:3266: scene=4_1
#: 4_1:1769
msgctxt "text_id=3266 | speaker=unknown"
msgid "  In time, someone will take interest in a sealed-off area even if they cannot see what is going on inside."
msgstr "　いずれ、中の様子が見えずとも“立ち入り禁止”区域そのものに興味を持つ者がでてくるだろう。"

#. Occurrence 4_1:1804:3267: scene=4_1
#: 4_1:1804
msgctxt "text_id=3267 | speaker=unknown"
msgid "  Some might say this is putting the cart before the horse."
msgstr "　それでは本末転倒だ。"

#. Occurrence 4_1:1809:3268: scene=4_1
#: 4_1:1809
msgctxt "text_id=3268 | speaker=unknown"
msgid "  The ideal field would be one that was both undetectable and impervious to interference from the outside."
msgstr "　真に優れた結界とは、外界に何ら異変を感じさせず、同時に、外から干渉されない<隔|へだ>たりでなくてはならない。"

#. Occurrence 4_1:1847:3269: scene=4_1
#: 4_1:1847
msgctxt "text_id=3269 | speaker=unknown"
msgid "  That was exactly the kind Alice had generated in the park the night before."
msgstr "　昨夜、久遠寺有珠が公園に敷いた結界はその<類|たぐい>の、“理想的な”結界だった。"

#. Occurrence 4_1:1868:3270: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0010; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1868
msgctxt "text_id=3270 | speaker=aoko"
msgid "\"...Even if someone has a reason to be in a place, they shouldn't enter if you've made them forget their reason for being there."
msgstr "「……その場所に用があっても、今は無いように思わせれば誰もそこには立ち入らない。"

#. Occurrence 4_1:1899:3271: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0011; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1899
msgctxt "text_id=3271 | speaker=aoko"
msgid "  It takes an immense amount of time and energy to create a field that produces a temporary illusion around a location you wish to conceal, but they prove extremely effective for at least an hour or so, right?"
msgstr "　隠したい場所の周りに、一時的な意識の<改竄|かいざん>を<促|うなが>す結界を張る……手間はかかるんだけど、一時間程度の<人避|ひとよ>けには信頼性は高い結界よね。"

#. Occurrence 4_1:1918:3272: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0012; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1918
msgctxt "text_id=3272 | speaker=aoko"
msgid "  And, to top it all, it was top-class, made from your mirrors, and it's not like they shattered while we were using it. The only other presence I felt inside was that of that puppet."
msgstr "　有珠の鏡を使った一級品だし、途中で破れる事もない。事実、入ってきたのはあの人形だけだとはっきり感じられた。"

#. Occurrence 4_1:1918:3273: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0012; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1918
msgctxt "text_id=3273 | speaker=aoko"
msgid "  If that isn't a perfectly constructed Bounded Field, then what is?\""
msgstr "　これで完璧じゃなかったら何が完璧なのよ？」"

#. Occurrence 4_1:1956:3274: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0009; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:1956
msgctxt "text_id=3274 | speaker=alice"
msgid "\"...I have no idea. The trees were prepared perfectly."
msgstr "「……わたしも分からない。森作りに落ち度はなかったわ。"

#. Occurrence 4_1:1962:3275: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0010; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:1962
msgctxt "text_id=3275 | speaker=alice"
msgid "  I cultivated the trees and plants over several days, and it's always proved to be a reliable field. But maybe, just maybe, there was something I didn't account for.\""
msgstr "　森は数日かけて栽培したものだし、今まで通り信頼できる結界よ。けど例外があったのなら、どこかで見落としがあったのね」"

#. Occurrence 4_1:1968:3276: scene=4_1
#: 4_1:1968
msgctxt "text_id=3276 | speaker=unknown"
msgid "  Though Alice's words conceded the possibility, her eyes expressed her confidence that she had overlooked nothing."
msgstr "　そう言う有珠の瞳は、その見落とし自体なかった事を示している。"

#. Occurrence 4_1:2010:3277: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0013; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2010
msgctxt "text_id=3277 | speaker=aoko"
msgid "\"...Well, crap. In that case, we'd better hope that the witness was the puppeteer, which would make sense. A mage would probably be able to penetrate it."
msgstr "「……まいった。こうなると、一番いいのは<目撃者|あいつ>が人形使いだってパターンね。それならかろうじて納得できる。相手が魔術師なら、結界の侵入ぐらいできるでしょうし。"

#. Occurrence 4_1:2022:3278: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0014; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2022
msgctxt "text_id=3278 | speaker=aoko"
msgid "  Something else bothers me, though. How did he avoid detection?\""
msgstr "　問題は……侵入した時の違和感を、どうやって消したかって事だけど」"

#. Occurrence 4_1:2042:3279: scene=4_1
#: 4_1:2042
msgctxt "text_id=3279 | speaker=unknown"
msgid "  The thought of being targeted by this individual was pretty terrifying."
msgstr "　そんな使い手が自分たちを狙っている、というのもぞっとしない話だ。"

#. Occurrence 4_1:2047:3280: scene=4_1
#: 4_1:2047
msgctxt "text_id=3280 | speaker=unknown"
msgid "  If they were able to penetrate Alice's field, it could only mean that their skill in magecraft was superior to Alice's."
msgstr "　有珠の結界を魔術で騙し通せるという事は、相手は久遠寺有珠を上回る魔術の腕を持つという事。"

#. Occurrence 4_1:2066:3281: scene=4_1
#: 4_1:2066
msgctxt "text_id=3281 | speaker=unknown"
msgid "  ...Alice, in her current state, would be completely helpless against such a foe."
msgstr "　―――とてもではないが、今の蒼崎青子にどうにかできる相手ではない。"

#. Occurrence 4_1:2116:3282: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0011; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:2116
msgctxt "text_id=3282 | speaker=alice"
msgid "\"...I've already determined that it was not a mage."
msgstr "「……その線はないわ。"

#. Occurrence 4_1:2122:3283: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0012; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:2122
msgctxt "text_id=3283 | speaker=alice"
msgid "  This was most certainly an outsider. The starlings are one thing, but not even Robin was able to follow him. There were no traces of magical energy, so that rules out a magical pawn.\""
msgstr "　彼は部外者よ。<椋鳥|むくどり>はともかく、ロビンが後を<辿|たど>れなかったもの。魔力の気配はまったくなし。誰かの魔術で操られている犠牲者、というのもないわね」"

#. Occurrence 4_1:2156:3284: scene=4_1
#: 4_1:2156
msgctxt "text_id=3284 | speaker=unknown"
msgid "  Aoko was quickly running out of straws to grasp at."
msgstr "　はかない希望は打ち砕かれた。"

#. Occurrence 4_1:2161:3285: scene=4_1
#: 4_1:2161
msgctxt "text_id=3285 | speaker=unknown"
msgid "  And that meant she was out of questions to ask."
msgstr "　なら、これで青子の質問は終わりだ。"

#. Occurrence 4_1:2166:3286: scene=4_1
#: 4_1:2166
msgctxt "text_id=3286 | speaker=unknown"
msgid "  All she could do was call it bad luck and leave it at that."
msgstr "　ここはもう、たんに運が無かったと諦めて昨夜の事を認めるしかない。"

#. Occurrence 4_1:2211:3287: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0015; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2211
msgctxt "text_id=3287 | speaker=aoko"
msgid "(First you get found out that you're a mage, then you let the witness get away. Why couldn't I just have normal high schooler problems...)"
msgstr "『……魔術師の秘密を見られて、おまけに目撃者を逃がした、か……。普通の高校生の悩みじゃないなぁ……』"

#. Occurrence 4_1:2217:3288: scene=4_1
#: 4_1:2217
msgctxt "text_id=3288 | speaker=unknown"
msgid "  The sofa groaned as she leaned back."
msgstr "　ばふ、とソファーに大きく背中を預ける。"

#. Occurrence 4_1:2222:3289: scene=4_1
#: 4_1:2222
msgctxt "text_id=3289 | speaker=unknown"
msgid "  Her gaze went up to the brown ceiling with a sigh."
msgstr "　悲しいかな、見上げた空はブラウンの天井だ。"

#. Occurrence 4_1:2227:3290: scene=4_1
#: 4_1:2227
msgctxt "text_id=3290 | speaker=unknown"
msgid "  It wasn't much of a view. She was becoming increasingly depressed."
msgstr "　風情も何もあったものじゃない、とますます青子はブルーになる。"

#. Occurrence 4_1:2248:3291: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0013; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:2248
msgctxt "text_id=3291 | speaker=alice"
msgid "\"Aoko. Make up your mind.\""
msgstr "「青子。覚悟を決めておいて」"

#. Occurrence 4_1:2273:3292: scene=4_1
#: 4_1:2273
msgctxt "text_id=3292 | speaker=unknown"
msgid "  Her roommate's voice seemed indifferent."
msgstr "　超然とした同居人の声。"

#. Occurrence 4_1:2278:3293: scene=4_1
#: 4_1:2278
msgctxt "text_id=3293 | speaker=unknown"
msgid "  But Aoko just kept staring up at the wooden ceiling."
msgstr "　天井を見上げる青子の瞳に変化はない。ただ、ぼんやりと木造の景色を眺めている。"

#. Occurrence 4_1:2304:3294: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0014; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:2304
msgctxt "text_id=3294 | speaker=alice"
msgid "\"...If you're not up to the task, I can take care of it myself.\""
msgstr "「……それとも。貴女にできないのなら、わたしが行ってあげてもいいけど」"

#. Occurrence 4_1:2339:3295: scene=4_1
#: 4_1:2339
msgctxt "text_id=3295 | speaker=unknown"
msgid "  The cool-mannered girl's statement carried an equally icy implication."
msgstr "　冷酷な彼女の言葉は、真実、冷酷な意味を持っていた。"

#. Occurrence 4_1:2344:3296: scene=4_1
#: 4_1:2344
msgctxt "text_id=3296 | speaker=unknown"
msgid "  Aoko took the words in slowly with as much sincerity as she could muster."
msgstr "　それをゆっくり、自分に許される精一杯の誠実さで青子は飲みこんだ。"

#. Occurrence 4_1:2349:3297: scene=4_1
#: 4_1:2349
msgctxt "text_id=3297 | speaker=unknown"
msgid "  It was like trying to swallow molten lead."
msgstr "　決して消化できない、熱した<鉛|なまり>を口にするように。"

#. Occurrence 4_1:2393:3298: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0016; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2393
msgctxt "text_id=3298 | speaker=aoko"
msgid "(She's right. And I've already made up my mind.)"
msgstr "『……そうだ。覚悟なんて、もう決めたでしょう』"

#. Occurrence 4_1:2399:3299: scene=4_1
#: 4_1:2399
msgctxt "text_id=3299 | speaker=unknown"
msgid "  The thought sounded hollow even as it popped into her head."
msgstr "　自分に言い聞かせるが、それも誤魔化しだ。"

#. Occurrence 4_1:2404:3300: scene=4_1
#: 4_1:2404
msgctxt "text_id=3300 | speaker=unknown"
msgid "  This was clearly different from last time."
msgstr "　明らかに前回と今回は違う。"

#. Occurrence 4_1:2409:3301: scene=4_1
#: 4_1:2409
msgctxt "text_id=3301 | speaker=unknown"
msgid "  While the aim was indeed the same, the circumstances surrounding her target were clearly different."
msgstr "　やる事は同じだとしても、その対象の立場が違う。"

#. Occurrence 4_1:2440:3302: scene=4_1
#: 4_1:2440
msgctxt "text_id=3302 | speaker=unknown"
msgid "  She may have been determined before, but that was as a mage."
msgstr "　前回の覚悟は、いわば魔術師としての覚悟だった。"

#. Occurrence 4_1:2445:3303: scene=4_1
#: 4_1:2445
msgctxt "text_id=3303 | speaker=unknown"
msgid "  If enemies emerged, she would kill them."
msgstr "　敵が来るから倒す。"

#. Occurrence 4_1:2450:3304: scene=4_1
#: 4_1:2450
msgctxt "text_id=3304 | speaker=unknown"
msgid "  If she was challenged, she would step up to the fight."
msgstr "　戦いを挑まれたのならこれに応える。"

#. Occurrence 4_1:2455:3305: scene=4_1
#: 4_1:2455
msgctxt "text_id=3305 | speaker=unknown"
msgid "  It was a fight between two mages, and her opponent was in the wrong. Even if this could only end in death for one of them, it was an outcome both parties could accept."
msgstr "　こちらもむこうも同じ魔術師で、形式上<非|ひ>はあちら側にある。たとえその決着が殺人以外の何物でもないとしても、お互い合意の行動だ。"

#. Occurrence 4_1:2460:3306: scene=4_1
#: 4_1:2460
msgctxt "text_id=3306 | speaker=unknown"
msgid "  Kill or be killed."
msgstr "　殺し、殺される<天秤|てんびん>の上での行為。"

#. Occurrence 4_1:2465:3307: scene=4_1
#: 4_1:2465
msgctxt "text_id=3307 | speaker=unknown"
msgid "  Morality had no weight on this scale."
msgstr "　彼らも彼女も、善悪の<秤|はかり>をそもそも用意していない。"

#. Occurrence 4_1:2503:3308: scene=4_1
#: 4_1:2503
msgctxt "text_id=3308 | speaker=unknown"
msgid "  But this time was different."
msgstr "　けれど今回は違う。"

#. Occurrence 4_1:2508:3309: scene=4_1
#: 4_1:2508
msgctxt "text_id=3309 | speaker=unknown"
msgid "  Her opponent was neither enemy nor mage. Even if she was prepared to kill them, this person was likely not ready to die."
msgstr "　相手は敵でもないし、魔術師でもない。こっちはそのつもりでも、相手にその気はないだろう。"

#. Occurrence 4_1:2513:3310: scene=4_1
#: 4_1:2513
msgctxt "text_id=3310 | speaker=unknown"
msgid "  ...That's why morality did factor into it, now."
msgstr "　……だから、これはきっと善悪の話になる。"

#. Occurrence 4_1:2518:3311: scene=4_1
#: 4_1:2518
msgctxt "text_id=3311 | speaker=unknown"
msgid "  Was she truly up to the task of murdering an innocent person?"
msgstr "　無関係な殺戮を、果たして自分は負えるのか。"

#. Occurrence 4_1:2523:3312: scene=4_1
#: 4_1:2523
msgctxt "text_id=3312 | speaker=unknown"
msgid "  Could she swallow the fact that this was a common occurrence for a mage?"
msgstr "　魔術師なら当然の、よくある<手|こ><間|と>だと飲みこむのか。"

#. Occurrence 4_1:2571:3313: scene=4_1
#: 4_1:2571
msgctxt "text_id=3313 | speaker=unknown"
msgid "  She snorted sardonically."
msgstr "　まさか、と鼻で笑う。"

#. Occurrence 4_1:2576:3314: scene=4_1
#: 4_1:2576
msgctxt "text_id=3314 | speaker=unknown"
msgid "  Being a mage did not mean that Aoko was some kind of monk who could cut ties with the real world on a whim."
msgstr "『魔術師だから』なんて理由で現実社会との折り合いを無くす超越性なぞ、はなから青子は持っていない。"

#. Occurrence 4_1:2581:3315: scene=4_1
#: 4_1:2581
msgctxt "text_id=3315 | speaker=unknown"
msgid "  If there was one thing Aoko hated..."
msgstr "　心に確信のないまま、"

#. Occurrence 4_1:2586:3316: scene=4_1
#: 4_1:2586
msgctxt "text_id=3316 | speaker=unknown"
msgid "  It was doing things without conviction or an understanding of exactly why she was doing them."
msgstr "　分からないまま行動する事を、青子は嫌っている。"

#. Occurrence 4_1:2591:3317: scene=4_1
#: 4_1:2591
msgctxt "text_id=3317 | speaker=unknown"
msgid "  When she acted, she preferred to act decisively."
msgstr "　彼女が走る時は、いつも自分に決断を下した後だ。"

#. Occurrence 4_1:2654:3318: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0017; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2654
msgctxt "text_id=3318 | speaker=aoko"
msgid "\"I guess I don't have any other choice.\""
msgstr "「うん。ま、やるしかないだろうね」"

#. Occurrence 4_1:2687:3319: scene=4_1
#: 4_1:2687
msgctxt "text_id=3319 | speaker=unknown"
msgid "  As she said it, she got up from the sofa, having had her fill of the ceiling for one day."
msgstr "　さばさばした一言とともに、青子はソファーから背を離した。いいかげん天井は見飽きたらしい。"

#. Occurrence 4_1:2692:3320: scene=4_1
#: 4_1:2692
msgctxt "text_id=3320 | speaker=unknown"
msgid "  Aoko had returned to the Aoko of always, and Alice was done probing her."
msgstr "　青子はいつも通りの青子で、有珠もあえて言及はしない。"

#. Occurrence 4_1:2720:3321: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0015; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:2720
msgctxt "text_id=3321 | speaker=alice"
msgid "\"Take this.\""
msgstr "「じゃあ、これ」"

#. Occurrence 4_1:2726:3322: scene=4_1
#: 4_1:2726
msgctxt "text_id=3322 | speaker=unknown"
msgid "  As if to reward her, Alice produced a small bottle."
msgstr "　ご褒美、とばかりに有珠は<小瓶|こびん>を取り出した。"

#. Occurrence 4_1:2762:3323: scene=4_1
#: 4_1:2762
msgctxt "text_id=3323 | speaker=unknown"
msgid "  It fit neatly in the palm of her hand."
msgstr "　手のひらに収まるほどの大きさ。"

#. Occurrence 4_1:2767:3324: scene=4_1
#: 4_1:2767
msgctxt "text_id=3324 | speaker=unknown"
msgid "  The bottle looked completely out of place in her slender fingers."
msgstr "　少女の細い指先とは不釣り合いな、寸胴の、見栄えしない瓶である。"

#. Occurrence 4_1:2772:3325: scene=4_1
#: 4_1:2772
msgctxt "text_id=3325 | speaker=unknown"
msgid "  The glass was cloudy and it appeared empty."
msgstr "　瓶は曇っていて、中身はカラ。"

#. Occurrence 4_1:2777:3326: scene=4_1
#: 4_1:2777
msgctxt "text_id=3326 | speaker=unknown"
msgid "  Some shreds of paper remained on the front where there was once a label."
msgstr "　表面にはラベルのシールを強引に剥がした跡が見られた。"

#. Occurrence 4_1:2798:3327: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0018; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2798
msgctxt "text_id=3327 | speaker=aoko"
msgid "\"What's that?\""
msgstr "「なによ、それ」"

#. Occurrence 4_1:2822:3328: scene=4_1
#: 4_1:2822
msgctxt "text_id=3328 | speaker=unknown"
msgid "  Aoko stared at the bottle suspiciously."
msgstr "　不吉なものを感じて、<胡散|うさん>臭そうに小瓶を睨む。"

#. Occurrence 4_1:2862:3329: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0016; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:2862
msgctxt "text_id=3329 | speaker=alice"
msgid "\"It's a storage bottle. I had one to spare, so I'm giving it to you.\""
msgstr "「収納の小瓶。ちょうどひとつ余ってたから、あげるわ」"

#. Occurrence 4_1:2899:3330: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0019; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2899
msgctxt "text_id=3330 | speaker=aoko"
msgid "\"A what?\""
msgstr "「はい？」"

#. Occurrence 4_1:2905:3331: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0017; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:2905
msgctxt "text_id=3331 | speaker=alice"
msgid "\"I forgot what it's called, but it's a thing out of a Chinese novel.\""
msgstr "「名前は忘れたけど、中国の小説に出てきたのと同じよ」"

#. Occurrence 4_1:2918:3332: scene=4_1
#: 4_1:2918
msgctxt "text_id=3332 | speaker=unknown"
msgid "  Aoko was miraculously able to parse what Alice meant."
msgstr "　素っ気ない言葉に、青子は驚異の理解力を示した。"

#. Occurrence 4_1:2958:3333: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0020_0; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2958
msgctxt "text_id=3333 | speaker=aoko"
msgid "\"Are you saying that this is the red drinking gourd from the story about the two brothers who guarded the Lotus Cave?"
msgstr "「それって<蓮華洞|れんげどう>の<番人|きょうだい>の話？　じゃ、あの赤い<瓢箪|ひょうたん>と同じなわけ？"

#. Occurrence 4_1:2985:3334: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0020_1; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2985
msgctxt "text_id=3334 | speaker=aoko"
msgid "  Don't take this the wrong way, but it looks like your everyday medicine bottle with the label ripped off.\""
msgstr "　言いたくないけど、そこらへんの風邪薬のラベルを無理やり剥がして、小瓶に見せかけてるそれが？」"

#. Occurrence 4_1:3034:3335: scene=4_1
#: 4_1:3034
msgctxt "text_id=3335 | speaker=unknown"
msgid "  Alice looked at the bottle and acknowledged how ordinary it looked."
msgstr "　言われて、たしかにセンスも何もない、と小瓶をまじまじと見る有珠。"

#. Occurrence 4_1:3060:3336: scene=4_1
#: 4_1:3060
msgctxt "text_id=3336 | speaker=unknown"
msgid "  She also understood that she would not be the one using it as she set it on the table."
msgstr "　が、別に自分が使うわけでもないと悟ったのか、あっさりと小瓶をテーブルに置いた。"

#. Occurrence 4_1:3087:3337: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0018; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3087
msgctxt "text_id=3337 | speaker=alice"
msgid "\"Except this is a jade flask, not a red drinking gourd.\""
msgstr "「赤い瓢箪じゃなくて、<羊脂玉|ようしぎょく>の<浄瓶|じょうびん>の方」"

#. Occurrence 4_1:3117:3338: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0021; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:3117
msgctxt "text_id=3338 | speaker=aoko"
msgid "\"That's not the problem. The problem is maintaining my dignity as a mage.\""
msgstr "「そういう問題じゃない。私は魔術師としての雰囲気を論じてるんだっ」"

#. Occurrence 4_1:3130:3339: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0019; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3130
msgctxt "text_id=3339 | speaker=alice"
msgid "\"Don't get stuck on the details. Just be happy it's not a bottle of laxatives.\""
msgstr "「些細な事を気にするのね。<正露丸|せいろがん>の瓶じゃないだけいいと思うけど」"

#. Occurrence 4_1:3143:3340: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0022; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:3143
msgctxt "text_id=3340 | speaker=aoko"
msgid "\"...Fine.\""
msgstr "「―――む」"

#. Occurrence 4_1:3148:3341: scene=4_1
#: 4_1:3148
msgctxt "text_id=3341 | speaker=unknown"
msgid "  She made a good point."
msgstr "　あまりにも説得力のある返答だった。"

#. Occurrence 4_1:3199:3342: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0020; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3199
msgctxt "text_id=3342 | speaker=alice"
msgid "\"Just open the lid and ask for the person's name."
msgstr "「ふたを開けて、相手の名前を<訊|たず>ねればいいから。"

#. Occurrence 4_1:3205:3343: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0021; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3205
msgctxt "text_id=3343 | speaker=alice"
msgid "  But be careful, because if the target is resistant, the bottle will shatter.\""
msgstr "　ただし相手に抵抗する意志が残っている場合、小瓶は割れるから気をつけて」"

#. Occurrence 4_1:3210:3344: scene=4_1
#: 4_1:3210
msgctxt "text_id=3344 | speaker=unknown"
msgid "  Aoko raised her eyebrows."
msgstr "　淡々と語る有珠と、眉をひそめる青子。"

#. Occurrence 4_1:3226:3345: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0023; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:3226
msgctxt "text_id=3345 | speaker=aoko"
msgid "\"Hang on. If he's resistant, I can only use it when he's asleep, right?\""
msgstr "「ちょっと待った。抵抗する意志があるとダメって、眠っている時にやれってコト？」"

#. Occurrence 4_1:3277:3346: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0022; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3277
msgctxt "text_id=3346 | speaker=alice"
msgid "\"...I've never tried it, to be honest."
msgstr "「……それは試したコトがなかったわ。"

#. Occurrence 4_1:3283:3347: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0023; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3283
msgctxt "text_id=3347 | speaker=alice"
msgid "  But is there anyone who responds to things in their sleep?\""
msgstr "　眠っているのに返事をする人っているの？」"

#. Occurrence 4_1:3304:3348: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0024; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:3304
msgctxt "text_id=3348 | speaker=aoko"
msgid "\"...You'd be surprised."
msgstr "「……たまにいるけど。"

#. Occurrence 4_1:3304:3349: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0024; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:3304
msgctxt "text_id=3349 | speaker=aoko"
msgid "  But, true. People like that are rare.\""
msgstr "　まあ、確かに珍しいわね、そういう人」"

#. Occurrence 4_1:3310:3350: scene=4_1
#: 4_1:3310
msgctxt "text_id=3350 | speaker=unknown"
msgid "  In that case, one would have to weaken them until they were about to pass out."
msgstr "　となると、あとは相手が思いっきり衰弱していて、前後不覚になっている、といった状況ぐらいか。"

#. Occurrence 4_1:3331:3351: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0024; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3331
msgctxt "text_id=3351 | speaker=alice"
msgid "\"Oh, I almost forgot. Drugs or magecraft will also cause the bottle to break.\""
msgstr "「あ、そうそう。薬や魔術がかかっていると、その<余分|おも>さでも割れるから気をつけて」"

#. Occurrence 4_1:3376:3352: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0025; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:3376
msgctxt "text_id=3352 | speaker=aoko"
msgid "\"Then what good is it!?"
msgstr "「つっかえない！"

#. Occurrence 4_1:3376:3353: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0025; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:3376
msgctxt "text_id=3353 | speaker=aoko"
msgid "  What won't break the damn thing?\""
msgstr "　それってほとんど役たたずって事じゃない！」"

#. Occurrence 4_1:3406:3354: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0025; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3406
msgctxt "text_id=3354 | speaker=alice"
msgid "\"A tool is only as good as the person using it.\""
msgstr "「それは青子しだいね」"

#. Occurrence 4_1:3411:3355: scene=4_1
#: 4_1:3411
msgctxt "text_id=3355 | speaker=unknown"
msgid "  Alice turned away as she replied,"
msgstr "　言って、有珠は視線を外す。"

#. Occurrence 4_1:3416:3356: scene=4_1
#: 4_1:3416
msgctxt "text_id=3356 | speaker=unknown"
msgid "  as if the topic no longer mattered to her."
msgstr "　もうこの話題はどうでもいい、と言うように。"

#. Occurrence 4_1:3466:3357: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0026; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:3466
msgctxt "text_id=3357 | speaker=aoko"
msgid "\"...Ugh. I know you're fond of using dainty tools like this. Is it a hobby of yours or something?\""
msgstr "「……はあ。有珠がこういう小道具好きなのは知ってたけどね……これも趣味なワケ？」"

#. Occurrence 4_1:3471:3358: scene=4_1
#: 4_1:3471
msgctxt "text_id=3358 | speaker=unknown"
msgid "  Aoko asked, hoping Alice would deny it."
msgstr "　あんまりこういう趣味は持ってほしくないな、と思いつつ青子は問う。"

#. Occurrence 4_1:3484:3359: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0026; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3484
msgctxt "text_id=3359 | speaker=alice"
msgid "\"Perhaps."
msgstr "「たぶん。"

#. Occurrence 4_1:3490:3360: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0027; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3490
msgctxt "text_id=3360 | speaker=alice"
msgid "  So? Are you going to take it or leave it?\""
msgstr "　それで、どうするの？　持っていくのか、いかないのか」"

#. Occurrence 4_1:3555:3361: scene=4_1
#: 4_1:3555
msgctxt "text_id=3361 | speaker=unknown"
msgid "  Without answering, Aoko dithered a bit before taking the bottle and putting it in her pocket."
msgstr "　その質問には答えず、しばし迷ってから青子は小瓶を手に取ると、ポケットにしまいこんだ。"

#. Occurrence 4_1:3561:3362: scene=4_1
#: 4_1:3561
msgctxt "text_id=3362 | speaker=unknown"
msgid "  She figured she might be able to find some use for it."
msgstr "　まあ、何かの役には立つかもしれない。"

#. Occurrence 4_2:54:3363: scene=4_2
#: 4_2:54
msgctxt "text_id=3363 | speaker=unknown"
msgid "  Two hours had passed and the clock struck nine."
msgstr "　それから二時間ほど経った午後九時。"

#. Occurrence 4_2:59:3364: scene=4_2
#: 4_2:59
msgctxt "text_id=3364 | speaker=unknown"
msgid "  Their conversation had moved from the drawing room to the sunroom, and had manifested into the kind of scene one would not expect in such a mansion."
msgstr "　ふたりは話し合いの場を居間からサンルームに移し、この洋館に不釣り合いな光景をくり広げていた。"

#. Occurrence 4_2:105:3365: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0000; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:105
msgctxt "text_id=3365 | speaker=aoko"
msgid "\"To be honest, I didn't really want to leave it to Tobimaru like this.\""
msgstr "「まあホントはね、鳶丸に任せる気はなかったんだけど」"

#. Occurrence 4_2:111:3366: scene=4_2
#: 4_2:111
msgctxt "text_id=3366 | speaker=unknown"
msgid "  A hot earthenware pot sat on the table."
msgstr "　テーブルの上にでん、と土鍋が置かれている。"

#. Occurrence 4_2:117:3367: scene=4_2
#: 4_2:117
msgctxt "text_id=3367 | speaker=unknown"
msgid "  Aoko spat out complaints to no one in particular as she plucked food from it with her chopsticks."
msgstr "　くつくつと温かな湯気をたてる土鍋を<箸|はし>でつつきながら、青子は誰に語るでもなくぼやいている。"

#. Occurrence 4_2:137:3368: scene=4_2
#: 4_2:137
msgctxt "text_id=3368 | speaker=unknown"
msgid "  Tonight they were eating a traditional Japanese meal that looked out of place in this mansion."
msgstr "　今晩の夕食は、洋館にあるまじき和食だった。"

#. Occurrence 4_2:142:3369: scene=4_2
#: 4_2:142
msgctxt "text_id=3369 | speaker=unknown"
msgid "  When it came to the kind of Japanese hotpot where all one had to do was buy and boil ingredients, it was usually Aoko's responsibility."
msgstr "　こういう日本的、かつ材料を買ってくるだけで済む鍋物はおもに青子の担当である。"

#. Occurrence 4_2:148:3370: scene=4_2
#: 4_2:148
msgctxt "text_id=3370 | speaker=unknown"
msgid "  Alice sat across from Aoko as she silently poked at the pot with a fork."
msgstr "　有珠は青子の対面で、やはり無言で鍋にフォークを入れていた。"

#. Occurrence 4_2:200:3371: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0001; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:200
msgctxt "text_id=3371 | speaker=aoko"
msgid "\"Yamasiro made it a point to say that Sizuki hadn't joined a club. It's not like I have the time or energy to keep track of every single student.\""
msgstr "「<山城|ヤマシロ>の奴が来るなり『静希くんはまだ部活に入っていないから、面倒みてあげてくれないかな』なんて言ってくるもんだからさ。全校生徒の行動範囲なんて見直す気力無くなっちゃったのよ」"

#. Occurrence 4_2:240:3372: scene=4_2
#: 4_2:240
msgctxt "text_id=3372 | speaker=unknown"
msgid "  The egg she had plucked was still as silky as a baby's bottom, so she returned it to the pot."
msgstr "　取った玉子はまだ乙女のように純白だったので鍋に返す。"

#. Occurrence 4_2:245:3373: scene=4_2
#: 4_2:245
msgctxt "text_id=3373 | speaker=unknown"
msgid "  She settled for the shirataki noodles instead."
msgstr "　仕方なく火の通りの早いしらたきに手を出した。"

#. Occurrence 4_2:372:3374: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0002; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:372
msgctxt "text_id=3374 | speaker=aoko"
msgid "\"I already know that the idiot is constantly busy with his jobs."
msgstr "「そりゃあ、あのバカがバイトで忙しいのは知ってるわよ。"

#. Occurrence 4_2:378:3375: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0003; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:378
msgctxt "text_id=3375 | speaker=aoko"
msgid "  That's why I tried my best to set him up with a club activity captain that'd be accommodating."
msgstr "　だから出来るだけ春先までのんびりしてて、あんなのでも親身になってくれそうな部の部長にあたってみたのに。"

#. Occurrence 4_2:387:3376: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0004_0; voice_prefix=A10; voice_category=1; scene=4_2
#. Occurrence 4_2:395:3376: scene=4_2
#: 4_2:387 4_2:395
msgctxt "text_id=3376 | speaker=aoko"
msgid "But the nerve of the guy, not even a thanks."
msgstr "ありがとうのひとつも無いってのは、ちょっと癪にさわるわよね。"

#. Occurrence 4_2:438:3377: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0004_1; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:438
msgctxt "text_id=3377 | speaker=aoko"
msgid "  Are you even listening, Alice?\""
msgstr "　ね、聞いてる有珠？」"

#. Occurrence 4_2:486:3378: scene=4_2
#: 4_2:486
msgctxt "text_id=3378 | speaker=unknown"
msgid "  As if her mouth was full, she simply nodded in response."
msgstr "　具を口に含んでいたのか、声を上げずに有珠は首を縦に振った。"

#. Occurrence 4_2:491:3379: scene=4_2
#: 4_2:491
msgctxt "text_id=3379 | speaker=unknown"
msgid "  Her expression stated that she had no interest nor opinion on the matter, but she at least appeared to be listening."
msgstr "　興味も意見もまったくないという<表情|かお>だが、話だけは聞いているようだ。"

#. Occurrence 4_2:496:3380: scene=4_2
#: 4_2:496
msgctxt "text_id=3380 | speaker=unknown"
msgid "  Satisfied, Aoko nibbled on some hanpen fish cake."
msgstr "　それに満足して青子ははんぺんをかじった。"

#. Occurrence 4_2:554:3381: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0005; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:554
msgctxt "text_id=3381 | speaker=aoko"
msgid "\"I just can't trust anyone who says he's a great guy. Surprise, even Tobimaru was gushing about him."
msgstr "「それに私、いい人ー、なんて言われるヤツは信用できないのよ。あろう事か鳶丸までそんなこと口走る始末だし。"

#. Occurrence 4_2:554:3382: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0005; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:554
msgctxt "text_id=3382 | speaker=aoko"
msgid "  The only thing he's great at is being an airhead."
msgstr "　あれはいい人なんじゃなくて、ただぼんやりしてるだけなんだっての。"

#. Occurrence 4_2:566:3383: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0006; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:566
msgctxt "text_id=3383 | speaker=aoko"
msgid "  ...I mean, there's really something wrong with his brain if he didn't get angry after what I said.\""
msgstr "　……大体、あそこまで言われて怒りもしないなんてどうかしてるわ」"

#. Occurrence 4_2:625:3384: scene=4_2
#: 4_2:625
msgctxt "text_id=3384 | speaker=unknown"
msgid "  Her thoughts went to what had happened in the student council room earlier that day."
msgstr "　今日の生徒会室での一件を思い出す。"

#. Occurrence 4_2:630:3385: scene=4_2
#: 4_2:630
msgctxt "text_id=3385 | speaker=unknown"
msgid "  She remembered how non-responsive Soujyuro had been to her words."
msgstr "　草十郎は青子の一方的な言葉に、さして反論もせずそのまま去っていった。"

#. Occurrence 4_2:635:3386: scene=4_2
#: 4_2:635
msgctxt "text_id=3386 | speaker=unknown"
msgid "  His unconcerned face alone was enough for her to swallow the rest of her hanpen without chewing it."
msgstr "　あの取り澄ました顔を思い出すだけで残ったはんぺんを噛まずに飲みこんでしまう青子なのだった。"

#. Occurrence 4_2:691:3387: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0007; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:691
msgctxt "text_id=3387 | speaker=aoko"
msgid "\"I thought you would understand,\" he says. Hah!"
msgstr "『……ふん。なにが分かってるんだな、よ』"

#. Occurrence 4_2:697:3388: scene=4_2
#: 4_2:697
msgctxt "text_id=3388 | speaker=unknown"
msgid "  His words were a lot like those that ended her childhood."
msgstr "　草十郎の一言と、幼年期の終わりに贈られた言葉が重なる。"

#. Occurrence 4_2:718:3389: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_4_2_0000; voice_prefix=B30; voice_category=9; scene=4_2
#: 4_2:718
msgctxt "text_id=3389 | speaker=ritsuka"
msgid "\"You know it, don't you, Aoko?"
msgstr "“―――青子ちゃんは分かっているんだね。"

#. Occurrence 4_2:724:3390: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_4_2_0001; voice_prefix=B30; voice_category=9; scene=4_2
#: 4_2:724
msgctxt "text_id=3390 | speaker=ritsuka"
msgid "  Through it all, you never lose sight of who you are. You're so strong...\""
msgstr "　それでも自分であり続けられるという事は、とても強い事なんだよ―――”"

#. Occurrence 4_2:730:3391: scene=4_2
#: 4_2:730
msgctxt "text_id=3391 | speaker=unknown"
msgid "  Perhaps it was meant as a compliment."
msgstr "　たぶん、あの言葉は誉めてくれていたのだ。"

#. Occurrence 4_2:735:3392: scene=4_2
#: 4_2:735
msgctxt "text_id=3392 | speaker=unknown"
msgid "  But she took it as a patronizing way to pity her."
msgstr "　でも自分にとって残酷な評価だった。"

#. Occurrence 4_2:740:3393: scene=4_2
#: 4_2:740
msgctxt "text_id=3393 | speaker=unknown"
msgid "  Because the person who said it had acted like she was looking at a wounded animal."
msgstr "　だって、それを告げるあの人の顔は、痛ましいものを見るような顔をしていたのだ。"

#. Occurrence 4_2:761:3394: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0008; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:761
msgctxt "text_id=3394 | speaker=aoko"
msgid "(Whatever. Who cares what that weirdo thinks or says?)"
msgstr "『―――ま。あんな変態の言ってたコトなんて、いまさらどうでもいいけどさ』"

#. Occurrence 4_2:767:3395: scene=4_2
#: 4_2:767
msgctxt "text_id=3395 | speaker=unknown"
msgid "  That episode might have made her the most confused she had ever been in her life. Yet, what shocked young Aoko the most was to look of pity on the face of the person she admired the most."
msgstr "　それでも、生涯最大の気の迷いであったワケだけど、憧れていた人物にあんな顔をされたのは幼心にショックだった。"

#. Occurrence 4_2:788:3396: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0000; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:788
msgctxt "text_id=3396 | speaker=alice"
msgid "\"...You fought.\""
msgstr "「……ケンカ」"

#. Occurrence 4_2:829:3397: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0009; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:829
msgctxt "text_id=3397 | speaker=aoko"
msgid "\"Huh?\""
msgstr "「え？」"

#. Occurrence 4_2:834:3398: scene=4_2
#: 4_2:834
msgctxt "text_id=3398 | speaker=unknown"
msgid "  The abrupt comment stopped her in her tracks."
msgstr "　箸を浮かせたまま物思いに<耽|ふけ>っていた青子に、有珠は唐突にそう言い放った。"

#. Occurrence 4_2:876:3399: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0010; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:876
msgctxt "text_id=3399 | speaker=aoko"
msgid "\"Sorry, what'd you say? Something about a fight?\""
msgstr "「ごめん、聞いてなかった。ケンカって、あの喧嘩？」"

#. Occurrence 4_2:881:3400: scene=4_2
#: 4_2:881
msgctxt "text_id=3400 | speaker=unknown"
msgid "  Alice nodded."
msgstr "　こくり、と可憐な首が頷く。"

#. Occurrence 4_2:932:3401: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0001; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:932
msgctxt "text_id=3401 | speaker=alice"
msgid "\"I can't say I completely understand from what you've said."
msgstr "「貴女の感想だけじゃ状況はよく掴めないけど。"

#. Occurrence 4_2:944:3402: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0002; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:944
msgctxt "text_id=3402 | speaker=alice"
msgid "  But it does come across as if you were trying to pick a fight with him.\""
msgstr "　つまり、青子はその人に喧嘩を売りたかったのね」"

#. Occurrence 4_2:981:3403: scene=4_2
#: 4_2:981
msgctxt "text_id=3403 | speaker=unknown"
msgid "  Alice bit into the very last hanpen."
msgstr "　はむ、と最後のはんぺんに口をつける有珠。"

#. Occurrence 4_2:986:3404: scene=4_2
#: 4_2:986
msgctxt "text_id=3404 | speaker=unknown"
msgid "  Her remark was unexpected but completely on point."
msgstr "　それはあんまりに予想外で、いやに的を射た意見のような。"

#. Occurrence 4_2:1040:3405: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0011; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1040
msgctxt "text_id=3405 | speaker=aoko"
msgid "\"...W-why did you go there!?"
msgstr "「な……なんでそうなるのよ!?"

#. Occurrence 4_2:1047:3406: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0012_0; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1047
msgctxt "text_id=3406 | speaker=aoko"
msgid "  I'd rather die than spend another second with him!"
msgstr "　私はあんなのと一秒だって関わりたくないだけだってば！"

#. Occurrence 4_2:1088:3407: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0012_1; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1088
msgctxt "text_id=3407 | speaker=aoko"
msgid "I mean, seriously! Gross! I have no interest in him whatsoever!"
msgstr "だいたいそれどころじゃないし！　興味とかまったくないし！"

#. Occurrence 4_2:1127:3408: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0012_2; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1127
msgctxt "text_id=3408 | speaker=aoko"
msgid " I'd love it if I never had to say anything about him ever again!\""
msgstr "会話もこれ以上ないってぐらい簡潔に切り上げたし！」"

#. Occurrence 4_2:1162:3409: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0003; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:1162
msgctxt "text_id=3409 | speaker=alice"
msgid "\"So why all the talk about him?\""
msgstr "「なら、どうして今そんな話をするの？」"

#. Occurrence 4_2:1201:3410: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0013; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1201
msgctxt "text_id=3410 | speaker=aoko"
msgid "\"W-what...I, err..."
msgstr "「え……それは……その、"

msgctxt "text_id=3411 | speaker=unknown"
msgid " I was just reporting on today's investigation. Something wrong with that?\""
msgstr "アンタに今日の調査過程を報せてあげたのよ。それ以外何があるって言うの？」"

#. Occurrence 4_2:1255:3412: scene=4_2
#: 4_2:1255
msgctxt "text_id=3412 | speaker=unknown"
msgid "  What other reason could Alice be suggesting Aoko had for bringing it up?"
msgstr "　本当に、それ以外に何があるって言うんだろう？"

#. Occurrence 4_2:1274:3413: scene=4_2
#: 4_2:1274
msgctxt "text_id=3413 | speaker=unknown"
msgid "  It would be several hours later, in bed, that Aoko realized that she had dug her own grave."
msgstr "　自ら墓穴を掘って中に入り、追い打ちとばかりに土を被っている事に青子が気付くのは数時間後、おやすみなさいとベッドに入ってからである。"

#. Occurrence 4_2:1316:3414: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0004; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:1316
msgctxt "text_id=3414 | speaker=alice"
msgid "\"No, not really."
msgstr "「いいけど、わたしは別に。"

#. Occurrence 4_2:1322:3415: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0005; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:1322
msgctxt "text_id=3415 | speaker=alice"
msgid "  But... does he really bother you that much?\""
msgstr "　ただ……青子は、本当にその人が嫌いなの？」"

#. Occurrence 4_2:1328:3416: scene=4_2
#: 4_2:1328
msgctxt "text_id=3416 | speaker=unknown"
msgid "  Alice ate her hotpot in silence as if she was honoring some sort of sacred ritual."
msgstr "　何か神聖な作業をするように、黙々とおでんを食べながら有珠は質問する。"

#. Occurrence 4_2:1382:3417: scene=4_2
#: 4_2:1382
msgctxt "text_id=3417 | speaker=unknown"
msgid "  Her face was as indifferent as always, but she was secretly enjoying how flustered Aoko was."
msgstr "　表情こそいつも通り無関心だが、内面では青子の態度を面白がっている節がある。"

#. Occurrence 4_2:1387:3418: scene=4_2
#: 4_2:1387
msgctxt "text_id=3418 | speaker=unknown"
msgid "  Aoko remained oblivious to this."
msgstr "　そんな有珠の思惑にも青子は気付けなかった。"

#. Occurrence 4_2:1392:3419: scene=4_2
#: 4_2:1392
msgctxt "text_id=3419 | speaker=unknown"
msgid "  Normally, she would have noticed immediately, but she was not quite herself at this moment."
msgstr "　いつもなら簡単に気が付くのだが、ちょっとした心の混乱がその余裕を奪っている。"

#. Occurrence 4_2:1444:3420: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0014; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1444
msgctxt "text_id=3420 | speaker=aoko"
msgid "\"Does he really―well, of course he does. I think I've said that often enough.\""
msgstr "「本当にって……そりゃそうよ。気にくわないって何度も言ってるじゃない」"

#. Occurrence 4_2:1453:3421: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0006; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:1453
msgctxt "text_id=3421 | speaker=alice"
msgid "\"Okay. What specifically about him do you dislike?\""
msgstr "「そ。具体的には？」"

#. Occurrence 4_2:1462:3422: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0015; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1462
msgctxt "text_id=3422 | speaker=aoko"
msgid "\"Huh? I don't need a specific reason to...\""
msgstr "「はあ？　具体的にはって、そんなのに理由なんて……」"

#. Occurrence 4_2:1498:3423: scene=4_2
#: 4_2:1498
msgctxt "text_id=3423 | speaker=unknown"
msgid "  She trailed off as she finally realized how disagreeable she was being."
msgstr "　そこまで口にして、ようやく青子はその矛盾に気が付いた。"

#. Occurrence 4_2:1525:3424: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0016; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1525
msgctxt "text_id=3424 | speaker=aoko"
msgid "(...Hrm. ...Mm?)"
msgstr "『……む……ぬ？』"

#. Occurrence 4_2:1530:3425: scene=4_2
#: 4_2:1530
msgctxt "text_id=3425 | speaker=unknown"
msgid "  She could come up with no reason why."
msgstr "　そう、理由なんてこれっぽっちもない。"

#. Occurrence 4_2:1535:3426: scene=4_2
#: 4_2:1535
msgctxt "text_id=3426 | speaker=unknown"
msgid "  Her instincts had told her that she was incompatible with that hick."
msgstr "　一目見た時からあの田舎者とは相容れないな、と本能が告げただけだ。"

#. Occurrence 4_2:1540:3427: scene=4_2
#: 4_2:1540
msgctxt "text_id=3427 | speaker=unknown"
msgid "  But why such a strong reaction?"
msgstr "　でも、それは一体どうしてだろう？"

#. Occurrence 4_2:1545:3428: scene=4_2
#: 4_2:1545
msgctxt "text_id=3428 | speaker=unknown"
msgid "  More than anything in the world, Aoko hated emotions without reason and decisions made with no rationale."
msgstr "　そもそも理由のない感情、根拠のない決めつけなんてものは、彼女が一番嫌うところだ。"

#. Occurrence 4_2:1599:3429: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0017; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1599
msgctxt "text_id=3429 | speaker=aoko"
msgid "\"Ugh... I just don't like him. I'm... sure there's a good reason for it. I think.\""
msgstr "「う……き、嫌いな物は嫌いなんだから……ちゃんと、どっかに理由があるんだ、と思うけど……」"

#. Occurrence 4_2:1605:3430: scene=4_2
#: 4_2:1605
msgctxt "text_id=3430 | speaker=unknown"
msgid "  She became more flustered the more she talked."
msgstr "　口にすればするほど歯切れが悪くなる。"

#. Occurrence 4_2:1610:3431: scene=4_2
#: 4_2:1610
msgctxt "text_id=3431 | speaker=unknown"
msgid "  Unfortunately for her, she could not come up with a coherent reason to hate Soujyuro Sizuki."
msgstr "　……困ったことに、青子には静希草十郎を嫌がる理由が見当たらなかった。"

#. Occurrence 4_2:1692:3432: scene=4_2
#: 4_2:1692
msgctxt "text_id=3432 | speaker=unknown"
msgid "  It was not his fault that he had zero common sense. It was the fault of the environment he grew up in."
msgstr "　常識がないのは彼の今までの環境が悪いのであって、草十郎自身に非はない。"

#. Occurrence 4_2:1697:3433: scene=4_2
#: 4_2:1697
msgctxt "text_id=3433 | speaker=unknown"
msgid "  In fact, it was admirable that he was trying so hard to adapt to civilized society."
msgstr "　いや、逆になんとか文明社会に順応しようとする姿勢には好感が持てる筈だ。"

#. Occurrence 4_2:1723:3434: scene=4_2
#: 4_2:1723
msgctxt "text_id=3434 | speaker=unknown"
msgid "  As clueless as he might seem, he was not a complete waste of space."
msgstr "　ぼんやりした所も、行動が<緩慢|かんまん>という訳ではない。"

#. Occurrence 4_2:1728:3435: scene=4_2
#: 4_2:1728
msgctxt "text_id=3435 | speaker=unknown"
msgid "  If he seemed a bit slow, it was only because his gentle nature compelled him to think before acting."
msgstr "　彼の仕草や言動がワンテンポ遅く見えるのは、彼が自分の言動に注意を払っているからであり、結果、緩やかに見えるだけなのだ。"

#. Occurrence 4_2:1733:3436: scene=4_2
#: 4_2:1733
msgctxt "text_id=3436 | speaker=unknown"
msgid "  When one looked at everything objectively, the conclusion was obvious."
msgstr "　そうやって静希草十郎という人物をあくまで公平に環境と人格に分けて評価すれば、結果は分かりきっている。"

#. Occurrence 4_2:1738:3437: scene=4_2
#: 4_2:1738
msgctxt "text_id=3437 | speaker=unknown"
msgid "  As much as she was loathe to admit it, he really was unassuming do-gooder everyone had him pegged as."
msgstr "　認めたくないが、みんなの言う通り、嫌味のない『いい人』像がそこにある。"

#. Occurrence 4_2:1765:3438: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0018; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1765
msgctxt "text_id=3438 | speaker=aoko"
msgid "(I can't believe what I'm thinking. Is there really nothing wrong with him?)"
msgstr "『ちょっと本気かっての……人間的に悪いところ、ホントに微塵もないのかアレ………？』"

#. Occurrence 4_2:1817:3439: scene=4_2
#: 4_2:1817
msgctxt "text_id=3439 | speaker=unknown"
msgid "  There was plenty, so she left it at that for now."
msgstr "　ダメな部分は山ほどあるのでとりあえずそこは保留。"

#. Occurrence 4_2:1822:3440: scene=4_2
#: 4_2:1822
msgctxt "text_id=3440 | speaker=unknown"
msgid "  The chopsticks she had been using came to a stop."
msgstr "　今まで忙しなく動いていたおでんをつつく箸は、ここで完全に停止した。"

#. Occurrence 4_2:1827:3441: scene=4_2
#: 4_2:1827
msgctxt "text_id=3441 | speaker=unknown"
msgid "  She was getting very annoyed."
msgstr "　なんか、ますますムカつく。"

#. Occurrence 4_2:1885:3442: scene=4_2
#: 4_2:1885
msgctxt "text_id=3442 | speaker=unknown"
msgid "  An irrational hatred burned through her head."
msgstr "　理由のない反感に青子はぐるぐる頭を回す。"

#. Occurrence 4_2:1890:3443: scene=4_2
#: 4_2:1890
msgctxt "text_id=3443 | speaker=unknown"
msgid "  Unable to come to terms with her feelings, she desperately tried to analyze Soujyuro, but her mind only went in more circles."
msgstr "　それはまずい、自分的にそんなのは許容できない、と必死に静希草十郎を分析するのだが、ますます自分を追いつめるだけだった。"

#. Occurrence 4_2:1935:3444: scene=4_2
#: 4_2:1935
msgctxt "text_id=3444 | speaker=unknown"
msgid "  Alice fixed Aoko with a deadpan stare."
msgstr "　そんな袋小路に<陥|おちい>った青子を、有珠はまじまじと眺める。"

#. Occurrence 4_2:1946:3445: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0007; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:1946
msgctxt "text_id=3445 | speaker=alice"
msgid "\"...I'm shocked.\""
msgstr "「……あきれた」"

#. Occurrence 4_2:1951:3446: scene=4_2
#: 4_2:1951
msgctxt "text_id=3446 | speaker=unknown"
msgid "  A small sigh."
msgstr "　小さな嘆息。"

#. Occurrence 4_2:2020:3447: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0008; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:2020
msgctxt "text_id=3447 | speaker=alice"
msgid "\"This isn't like you, Aoko.\""
msgstr "「らしくないわね、青子」"

#. Occurrence 4_2:2029:3448: scene=4_2
#: 4_2:2029
msgctxt "text_id=3448 | speaker=unknown"
msgid "  Those words were the final blow."
msgstr "　その一言は、青子にとってまさにとどめだった。"

#. Occurrence 4_2:2034:3449: scene=4_2
#: 4_2:2034
msgctxt "text_id=3449 | speaker=unknown"
msgid "  Aoko felt the floor fall out from under her."
msgstr "　自分の理解不能ぶりに目眩がする。"

#. Occurrence 4_2:2066:3450: scene=4_2
#: 4_2:2066
msgctxt "text_id=3450 | speaker=unknown"
msgid "  She was unable to leave her chair until long after Alice had finished eating and left."
msgstr "　ご馳走さまと有珠が居間に立ち去った後、しばらく椅子から立てなかった程に。"

#. Occurrence 4_3:72:3451: scene=4_3
#: 4_3:72
msgctxt "text_id=3451 | speaker=unknown"
msgid "  However..."
msgstr "　しかし。"

#. Occurrence 4_3:77:3452: scene=4_3
#: 4_3:77
msgctxt "text_id=3452 | speaker=unknown"
msgid "  Even after getting knocked down, Aoko Aozaki was not one to be kept that way."
msgstr "　とどめを刺されたからといって、いつまでも伏せっている蒼崎青子ではなかった。"

#. Occurrence 4_3:82:3453: scene=4_3
#: 4_3:82
msgctxt "text_id=3453 | speaker=unknown"
msgid "  She made short work of clearing up after dinner and, after conceding the first bath of the night to Alice, left the drawing room."
msgstr "　早々に夕食の片付けを済ませ、はじめのお風呂を有珠に譲って居間を後にする。"

#. Occurrence 4_3:87:3454: scene=4_3
#: 4_3:87
msgctxt "text_id=3454 | speaker=unknown"
msgid "  Since it was customary in these sorts of mansions to turn the lights off when leaving an empty room, the only lit areas of the house were the drawing room and the two girls' bedrooms."
msgstr "　洋館では人のいない場所に電灯はつけない決まりなので、明かりがついているのは居間と彼女たちの部屋ぐらいだ。"

#. Occurrence 4_3:109:3455: scene=4_3
#: 4_3:109
msgctxt "text_id=3455 | speaker=unknown"
msgid "  The upstairs was enveloped in darkness."
msgstr "　二階は暗闇に包まれている。"

#. Occurrence 4_3:114:3456: scene=4_3
#: 4_3:114
msgctxt "text_id=3456 | speaker=unknown"
msgid "  Aoko briskly made her way to the deepest part of the east wing along the long corridor, illuminated only by the light of the moon, and arrived at her room."
msgstr "　長い、月明かりだけが頼りの廊下をスタスタと移動して、青子は二階東側の最奥にある自室に辿り着いた。"

#. Occurrence 4_3:163:3457: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0000; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:163
msgctxt "text_id=3457 | speaker=aoko"
msgid "\"...All being said..."
msgstr "「―――結論として。"

#. Occurrence 4_3:169:3458: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0001; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:169
msgctxt "text_id=3458 | speaker=aoko"
msgid "  Sneak attacks make me sick to my stomach.\""
msgstr "　やっぱり、<騙|だま>し<討|う>ちは気にくわない」"

#. Occurrence 4_3:193:3459: scene=4_3
#: 4_3:193
msgctxt "text_id=3459 | speaker=unknown"
msgid "  She had been considering this on the way down the corridor, or perhaps ever since she left the drawing room."
msgstr "　廊下を歩きながら、いや、居間からずっと考えていたのか。"

#. Occurrence 4_3:198:3460: scene=4_3
#: 4_3:198
msgctxt "text_id=3460 | speaker=unknown"
msgid "  The moment she entered her room, she drew her proverbial line in the sand."
msgstr "　部屋に入るなり、青子はきっぱりと断言した。"

#. Occurrence 4_3:219:3461: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0002; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:219
msgctxt "text_id=3461 | speaker=aoko"
msgid "\"If I'm going to do it, I'm going to do it face to face. I'll give it to him straight.\""
msgstr "「やるにしても隠れるのはなし。正面から堂々と、向かいあって理由を言う」"

#. Occurrence 4_3:225:3462: scene=4_3
#: 4_3:225
msgctxt "text_id=3462 | speaker=unknown"
msgid "  This was not a concession driven by feelings of sympathy or compassion."
msgstr "　情けにかられての精一杯の譲歩、ではない。"

#. Occurrence 4_3:230:3463: scene=4_3
#: 4_3:230
msgctxt "text_id=3463 | speaker=unknown"
msgid "  For her, this was simply the way things ought to be."
msgstr "　単に、彼女にとってそういうあり方が<当然|スタンダード>というだけだ。"

#. Occurrence 4_3:251:3464: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0003; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:251
msgctxt "text_id=3464 | speaker=aoko"
msgid "\"Okay, with that out of the way...\""
msgstr "「よし、そうと決まれば―――」"

#. Occurrence 4_3:275:3465: scene=4_3
#: 4_3:275
msgctxt "text_id=3465 | speaker=unknown"
msgid "  After settling her resolve, she headed to the study next door."
msgstr "　自分の意志を確認して、隣室の書斎に向かう。"

#. Occurrence 4_3:339:3466: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0004; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:339
msgctxt "text_id=3466 | speaker=aoko"
msgid "\"Let's see, Thursday shelf, winter solstice, green spine...\""
msgstr "「えーと、木曜棚の冬至覧、緑の背表紙、と……」"

#. Occurrence 4_3:345:3467: scene=4_3
#: 4_3:345
msgctxt "text_id=3467 | speaker=unknown"
msgid "  Without hesitation, she removed one book from the countless volumes on the shelf."
msgstr "　無数の本の中から迷わず一冊を抜き取る。"

#. Occurrence 4_3:351:3468: scene=4_3
#: 4_3:351
msgctxt "text_id=3468 | speaker=unknown"
msgid "  The introductory textbooks transported here from the Aozaki residence were separated into six shelves, labeled Monday to Saturday."
msgstr "　蒼崎の家から運びこんだ入門書は、月曜から土曜と六つの<棚|カテゴリ>に振り分けられていた。"

#. Occurrence 4_3:402:3469: scene=4_3
#: 4_3:402
msgctxt "text_id=3469 | speaker=unknown"
msgid "  Aoko had organized the books by topic, genre, and purpose, and had more or less memorized exactly what was in her personal library."
msgstr "　青子は蔵書を項目、分類、用途に分けておおまかに記憶している。"

#. Occurrence 4_3:407:3470: scene=4_3
#: 4_3:407
msgctxt "text_id=3470 | speaker=unknown"
msgid "  Referencing any of this material took her no time at all."
msgstr "　必要な知識、資料の検索には時間はとらない。"

#. Occurrence 4_3:412:3471: scene=4_3
#: 4_3:412
msgctxt "text_id=3471 | speaker=unknown"
msgid "  It was to be expected from keeper of this study."
msgstr "　書斎の主として最低限の務めである。"

#. Occurrence 4_3:432:3472: scene=4_3
#: 4_3:432
msgctxt "text_id=3472 | speaker=unknown"
msgid "  ...Though, this keeper's fiefdom was nothing more than a small room."
msgstr "　……などと偉ぶっても、所詮はちっぽけな書斎の管理のみ。"

#. Occurrence 4_3:437:3473: scene=4_3
#: 4_3:437
msgctxt "text_id=3473 | speaker=unknown"
msgid "  Both Aoko and Alice had given up all hope on the cluttered mess of a library in the annex."
msgstr "　別館にある図書室は青子も有珠もお手上げの魔窟だ。"

#. Occurrence 4_3:442:3474: scene=4_3
#: 4_3:442
msgctxt "text_id=3474 | speaker=unknown"
msgid "  Nevertheless, on occasion, Aoko would have no option other than to give Alice a heads-up and visit it when this study did not meet her needs."
msgstr "　もしこの書斎だけで用が足りないのなら、有珠に声をかけて別館に<赴|おもむ>くしかない。"

#. Occurrence 4_3:488:3475: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0005; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:488
msgctxt "text_id=3475 | speaker=aoko"
msgid "\"...I really hope I don't have to go over there now.\""
msgstr "「……できればそれは避けたいところだけど、っと」"

#. Occurrence 4_3:509:3476: scene=4_3
#: 4_3:509
msgctxt "text_id=3476 | speaker=unknown"
msgid "  Aoko placed the thick, green book down and took a seat."
msgstr "　緑色の、分厚い装丁の本を机に置いて、椅子に座る。"

#. Occurrence 4_3:516:3477: scene=4_3
#: 4_3:516
msgctxt "text_id=3477 | speaker=unknown"
msgid "  The desk she sat at was sturdy but uninviting."
msgstr "　頑丈で硬質で温かみのない机。"

#. Occurrence 4_3:521:3478: scene=4_3
#: 4_3:521
msgctxt "text_id=3478 | speaker=unknown"
msgid "  It wasn't the sort of furniture girls her age grew attached to, but she liked its minimalist elegance nonetheless."
msgstr "　まだ年若い少女が愛用する物ではないが、青子はこの洗練されすぎて骨しかないような豪華さが好きだった。"

#. Occurrence 4_3:527:3479: scene=4_3
#: 4_3:527
msgctxt "text_id=3479 | speaker=unknown"
msgid "  She flipped lightly through the book's old, worn pages."
msgstr "　古びた本のページが、その机の上ではらりとめくられる。"

#. Occurrence 4_3:560:3480: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0006; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:560
msgctxt "text_id=3480 | speaker=aoko"
msgid "(I still can't manage anything like Alice's Bounded Field."
msgstr "『……有珠みたいな結界は私にはまだ無理だ。"

#. Occurrence 4_3:567:3481: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0007; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:567
msgctxt "text_id=3481 | speaker=aoko"
msgid "I guess I'll just have to find a place off the beaten track.)"
msgstr "人払いはその場所自体に頼らないといけないか……』"

#. Occurrence 4_3:573:3482: scene=4_3
#: 4_3:573
msgctxt "text_id=3482 | speaker=unknown"
msgid "  The mountains?"
msgstr "　たとえば山奥。"

#. Occurrence 4_3:578:3483: scene=4_3
#: 4_3:578
msgctxt "text_id=3483 | speaker=unknown"
msgid "  The woods?"
msgstr "　たとえば林中。"

#. Occurrence 4_3:583:3484: scene=4_3
#: 4_3:583
msgctxt "text_id=3484 | speaker=unknown"
msgid "  The school building, empty at night?"
msgstr "　たとえば、生徒のいない深夜の校舎。"

#. Occurrence 4_3:588:3485: scene=4_3
#: 4_3:588
msgctxt "text_id=3485 | speaker=unknown"
msgid "  She was looking for a place that would be, except for the worst of luck, void of people, allowing her to forgo the use of magecraft."
msgstr "　場所自体に魔術をかけなくても、よっぽど運が悪くないかぎり誰もやってこない場所が望ましい。"

#. Occurrence 4_3:615:3486: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0008; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:615
msgctxt "text_id=3486 | speaker=aoko"
msgid "(Walls of thorns and magical mists are so indirect. If I want to cut off any route of escape, I need someplace... flashy and obvious, both in purpose and in looks.)"
msgstr "『茨の壁だの魔力の霧だの、そういう回りくどいのもナンだしなあ……退路を断つ、っていうなら、もっとこう、見た目にも状況的にも派手な方が効果的だし』"

#. Occurrence 4_3:627:3487: scene=4_3
#: 4_3:627
msgctxt "text_id=3487 | speaker=unknown"
msgid "  Muttering about how there had to be some basic spell that fit her needs, she continued to flip through the pages."
msgstr "　ぶつぶつと自分好みの、初歩的な術式はないものかとページをめくる青子。"

#. Occurrence 4_3:632:3488: scene=4_3
#: 4_3:632
msgctxt "text_id=3488 | speaker=unknown"
msgid "  It goes without saying that she was looking for a way to deal with the witness from the previous night."
msgstr "　言うまでもなく、彼女が探しているのは昨夜の目撃者を始末する方法だ。"

#. Occurrence 4_3:667:3489: scene=4_3
#: 4_3:667
msgctxt "text_id=3489 | speaker=unknown"
msgid "  Magecraft's uses were many, but not all-encompassing."
msgstr "　魔術は万能ではあるが有限である。"

#. Occurrence 4_3:683:3490: scene=4_3
#: 4_3:683
msgctxt "text_id=3490 | speaker=unknown"
msgid "  Fundamentally, magecraft was good for making things or phenomena that existed already, while more or less bypassing the time and resources conventional means would require."
msgstr "　基本的に、<地上|ここ>にある物、<現実|ここ>で起きる事を、実現時間や必要経費を多少無視して発現させるだけのものだ。"

#. Occurrence 4_3:688:3491: scene=4_3
#: 4_3:688
msgctxt "text_id=3491 | speaker=unknown"
msgid "  It was, however, unable to manifest phenomena that were impossible in this world."
msgstr "　この<宇宙|せかい>で起きえない現象は、魔術では発現できない。"

#. Occurrence 4_3:693:3492: scene=4_3
#: 4_3:693
msgctxt "text_id=3492 | speaker=unknown"
msgid "  It was essentially an equivalent exchange that used a variety of shortcuts."
msgstr "　要はショートカットを使いまくった等価交換だ。"

#. Occurrence 4_3:713:3493: scene=4_3
#: 4_3:713
msgctxt "text_id=3493 | speaker=unknown"
msgid "  A phenomenon made possible by human hands, actualized by an individual's power―"
msgstr "　人の手で可能となる現象を、個人の力で実行する―――"

#. Occurrence 4_3:713:3494: scene=4_3
#: 4_3:713
msgctxt "text_id=3494 | speaker=unknown"
msgid "  that was generally what magecraft was."
msgstr "　それが一般的な魔術のあり方である。"

#. Occurrence 4_3:718:3495: scene=4_3
#: 4_3:718
msgctxt "text_id=3495 | speaker=unknown"
msgid "  To give a simple example, if Aoko were so inclined, she could make an entire lake appear at the mansion."
msgstr "　単純な話、その気になれば巨大な湖をこの洋館に持ってくる事もできる。"

#. Occurrence 4_3:723:3496: scene=4_3
#: 4_3:723
msgctxt "text_id=3496 | speaker=unknown"
msgid "  However, it had to be something that existed within this world. Nothing, not even the smallest matter, could escape this unbreakable law."
msgstr "　けれど、<こ|・><の|・><世|・><に|・><な|・><い|・><も|・><の|・>を持ってくるコトは、たとえ小指の先ほどであろうと許されない。"

#. Occurrence 4_3:755:3497: scene=4_3
#: 4_3:755
msgctxt "text_id=3497 | speaker=unknown"
msgid "  Even if Aoko were to release a level of heat on par with an F-15 fighter jet's afterburner, that event would only be possible if the circuit named Aoko Aozaki acted as a temporary input variable in a magical formula."
msgstr "　例えば、青子単体で<戦闘機|Ｆ－１５>のアフターバーナー並みの熱量を放出できたとしても、それは魔術式によって蒼崎青子という回路が一時的に入力の変数になっただけだ。"

#. Occurrence 4_3:775:3498: scene=4_3
#: 4_3:775
msgctxt "text_id=3498 | speaker=unknown"
msgid "  The derived equivalence was simply a value that already occurred in reality."
msgstr "　導き出されるイコールそのものは、現実に起こりえる数値となる。"

#. Occurrence 4_3:780:3499: scene=4_3
#: 4_3:780
msgctxt "text_id=3499 | speaker=unknown"
msgid "  If the variable in the equation did not exist elsewhere in reality, the spell would not be valid."
msgstr "　だが、そのイコールそのものが現実にないモノである場合、術式は成り立たない。"

#. Occurrence 4_3:814:3500: scene=4_3
#: 4_3:814
msgctxt "text_id=3500 | speaker=unknown"
msgid "  The imaginary element known as magical energy was like a lie that could only slip its fantasy through the network of order at the moment of ignition."
msgstr "　魔力という架空要素は、発火の瞬間だけ秩序の網をくぐり抜ける嘘のようなもの。"

#. Occurrence 4_3:830:3501: scene=4_3
#: 4_3:830
msgctxt "text_id=3501 | speaker=unknown"
msgid "  Giving form to the nonexistent--illusions invading reality--was something the universe did not allow."
msgstr "　この世にないものをカタチにする事―――幻想が現実を侵す事を、この宇宙は容認しない。"

#. Occurrence 4_3:878:3502: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0009; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:878
msgctxt "text_id=3502 | speaker=aoko"
msgid "(Still, what was it? You can combine the imaginary factor--Ether--with pretty much anything else since it's not real itself...?"
msgstr "『……とは言っても<架|エ><空|ー><要|テ><素|ル>は基本なんにでも<付属|で>きるんで、<大本|おおもと>がウソ、なんだっけ。"

#. Occurrence 4_3:884:3503: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0010; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:884
msgctxt "text_id=3503 | speaker=aoko"
msgid "  Anything composed entirely of magical energy is little more than an illusion and will quickly dissipate. Even a typical field, like a wall of thorns, generally starts with the user planting the thorns first before using magical energy to grow and strengthen them in an instant."
msgstr "　魔力だけで構成されたものは幻想扱いされて急速に消えていくとか……典型的な結界、茨の壁とかはもともと茨を生やしておいて、魔力で一気に成長・強化してるものだし。"

#. Occurrence 4_3:890:3504: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0011; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:890
msgctxt "text_id=3504 | speaker=aoko"
msgid "  In the end, magical energy is just an easy-to-use fuel source, while acting as a firework that ignites a phenomenon.)"
msgstr "　魔力っていうのは結局、使い勝手のいいガソリン、兼、事象に火をつける火花ってワケで―――』"

#. Occurrence 4_3:916:3505: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0012; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:916
msgctxt "text_id=3505 | speaker=aoko"
msgid "\"...Or so they say."
msgstr "「―――なんて言いつつ。"

#. Occurrence 4_3:922:3506: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0013; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:922
msgctxt "text_id=3506 | speaker=aoko"
msgid "  Imaginary factors are all well and good, but all I can do is connect a basic circuit, and process energy into a projectile.\""
msgstr "　架空要素<云々|うんぬん>より、基本的な回路の接続と、魔力を加工して弾く事ぐらいしかできないのよね、私」"

#. Occurrence 4_3:948:3507: scene=4_3
#: 4_3:948
msgctxt "text_id=3507 | speaker=unknown"
msgid "  Laughing to herself, she looked for a Bounded Field or something similar more suited to her current ability."
msgstr "　あはは、と笑って<現|い><状|ま>の自分に作れる結界は何か、と検索する。"

#. Occurrence 4_3:953:3508: scene=4_3
#: 4_3:953
msgctxt "text_id=3508 | speaker=unknown"
msgid "  The identity of the witness was still unknown, but if they were a classmate of Aoko's, she had any number of pretexts by which to lure them out."
msgstr "　目撃者の素性は不明だが、相手が同じ高校の生徒なら呼び出す口実はいくらでもある。"

#. Occurrence 4_3:958:3509: scene=4_3
#: 4_3:958
msgctxt "text_id=3509 | speaker=unknown"
msgid "  The problem was after that."
msgstr "　問題は呼び出した後だろう。"

#. Occurrence 4_3:985:3510: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0014; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:985
msgctxt "text_id=3510 | speaker=aoko"
msgid "(Then it becomes a question of precision. If I don't take care of him in one blow, he might slip away.)"
msgstr "『そうなると、問題は命中率よね……。一撃で決めないと逃げられちゃうだろうし』"

#. Occurrence 4_3:991:3511: scene=4_3
#: 4_3:991
msgctxt "text_id=3511 | speaker=unknown"
msgid "  To be honest, she wasn't confident she could handle this smoothly without Alice's support."
msgstr "　正直、有珠のサポートなしで上手くやれる自信はない。"

#. Occurrence 4_3:996:3512: scene=4_3
#: 4_3:996
msgctxt "text_id=3512 | speaker=unknown"
msgid "  But Aoko saw no reason to ask for help given that the target in question was a regular bystander."
msgstr "　けれど相手が一般人なら自分だけで十分、と青子は助力を一切拒否したのだ。"

#. Occurrence 4_3:1001:3513: scene=4_3
#: 4_3:1001
msgctxt "text_id=3513 | speaker=unknown"
msgid "  Fledgling as she was, she still had her pride as a mage."
msgstr "　半人前ではあるが、青子にも魔術師としてのプライドがある。"

#. Occurrence 4_3:1058:3514: scene=4_3
#: 4_3:1058
msgctxt "text_id=3514 | speaker=unknown"
msgid "  She continued to turn through the pages rhythmically."
msgstr "　ページはリズムよくめくられていく。"

#. Occurrence 4_3:1063:3515: scene=4_3
#: 4_3:1063
msgctxt "text_id=3515 | speaker=unknown"
msgid "  In the midst of the fluttering sound of thumbing through the volume, Aoko suddenly stopped her finger at a certain page."
msgstr "　パラパラと小さな音をたてる中、青子の指がぴたりとあるページで止まった。"

#. Occurrence 4_3:1102:3516: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0015; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1102
msgctxt "text_id=3516 | speaker=aoko"
msgid "\"Found it.\""
msgstr "「見付けた」"

#. Occurrence 4_3:1108:3517: scene=4_3
#: 4_3:1108
msgctxt "text_id=3517 | speaker=unknown"
msgid "  She smiled to herself."
msgstr "　小さな微笑。"

#. Occurrence 4_3:1113:3518: scene=4_3
#: 4_3:1113
msgctxt "text_id=3518 | speaker=unknown"
msgid "  It was a simple formula that she had tucked away somewhere in the recesses of her memory. A spell of simple destruction."
msgstr "　それは記憶の片隅にあった、ただ壊すだけの単純な魔術式。"

#. Occurrence 4_3:1134:3519: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0016; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1134
msgctxt "text_id=3519 | speaker=aoko"
msgid "(...A cage. That's all I need to make."
msgstr "『……檻をね、作ればいいのよ。"

#. Occurrence 4_3:1140:3520: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0017; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1140
msgctxt "text_id=3520 | speaker=aoko"
msgid "  It's the oldest trick in the book that any hunter worth their salt would use.)"
msgstr "　狩りをする時の常套手段じゃない。獲物を逃げられないようにするのは』"

#. Occurrence 4_3:1171:3521: scene=4_3
#: 4_3:1171
msgctxt "text_id=3521 | speaker=unknown"
msgid "  She placed a bookmark in the book, closed it, and got up to return to her room."
msgstr "　ページに栞を挟んで、部屋に持ち帰ろうと立ち上がる。"

#. Occurrence 4_3:1206:3522: scene=4_3
#: 4_3:1206
msgctxt "text_id=3522 | speaker=unknown"
msgid "  Suddenly she felt someone watching her."
msgstr "　ふいに視線を感じた。"

#. Occurrence 4_3:1254:3523: scene=4_3
#: 4_3:1254
msgctxt "text_id=3523 | speaker=unknown"
msgid "  Through the window, she saw her in the night―a girl, staring back with a coldhearted expression."
msgstr "　夜を<透|とお>す窓に、冷めきった目の少女が映っている。"

#. Occurrence 4_3:1259:3524: scene=4_3
#: 4_3:1259
msgctxt "text_id=3524 | speaker=unknown"
msgid "  The girl's face was hers, the expression undoubtedly her own."
msgstr "　それが今の自分の<表情|かお>である事を、青子は冷静に受けとめる。"

#. Occurrence 4_3:1280:3525: scene=4_3
#: 4_3:1280
msgctxt "text_id=3525 | speaker=unknown"
msgid "  ...She began planning how to erase the witness."
msgstr "　―――目撃者を消す計画を立て始めた。"

#. Occurrence 4_3:1286:3526: scene=4_3
#: 4_3:1286
msgctxt "text_id=3526 | speaker=unknown"
msgid "  Though to say it was something as elaborate as a plan was overkill."
msgstr "　いや、計画なんて複雑なものではない。"

#. Occurrence 4_3:1291:3527: scene=4_3
#: 4_3:1291
msgctxt "text_id=3527 | speaker=unknown"
msgid "  This was just a job."
msgstr "　これはただの作業。"

#. Occurrence 4_3:1296:3528: scene=4_3
#: 4_3:1296
msgctxt "text_id=3528 | speaker=unknown"
msgid "  She was going to make a cage and then lure her prey into it."
msgstr "　事前に檻を作っておき、そこに獲物を誘うだけの話。"

#. Occurrence 4_3:1301:3529: scene=4_3
#: 4_3:1301
msgctxt "text_id=3529 | speaker=unknown"
msgid "  There was no getting around it―premeditated violence."
msgstr "　まったくもって、何の言い逃れもできない暴力だ。"

#. Occurrence 4_3:1375:3530: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0018; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1375
msgctxt "text_id=3530 | speaker=aoko"
msgid "\"I wonder if Alice is done with her bath.\""
msgstr "「さ、そろそろ有珠は上がったかな」"

#. Occurrence 4_3:1381:3531: scene=4_3
#: 4_3:1381
msgctxt "text_id=3531 | speaker=unknown"
msgid "  She mumbled out loud, as if the bath would return some warmth to her chilled heart."
msgstr "　青子は冷めた心に熱を戻すように、どうでもいい独り言を口にした。"

#. Occurrence 4_3:1465:3532: scene=4_3
#: 4_3:1465
msgctxt "text_id=3532 | speaker=unknown"
msgid "  About twenty minutes had passed since she gave Alice the privilege of using the hot water first."
msgstr "　有珠にはじめの入浴を譲ってから二十分近く経つ。"

#. Occurrence 4_3:1470:3533: scene=4_3
#: 4_3:1470
msgctxt "text_id=3533 | speaker=unknown"
msgid "  Alice tended to bathe quickly, finishing well under ten minutes."
msgstr "　彼女のお風呂はカラスの行水よろしく、十分もあれば終わっている。"

#. Occurrence 4_3:1475:3534: scene=4_3
#: 4_3:1475
msgctxt "text_id=3534 | speaker=unknown"
msgid "  Her roommate was the type that could not understand the spirit of the bath, treating it as nothing more than a necessity for looking after one's body."
msgstr "　有珠はお風呂の情緒を理解できないタイプで、風呂はあくまで体のメンテナンスをするものと捉えている。"

#. Occurrence 4_3:1480:3535: scene=4_3
#: 4_3:1480
msgctxt "text_id=3535 | speaker=unknown"
msgid "  For Alice, the concept of staying at a hot spring inn sounded more like a chore than anything, though in this regard Aoko had to agree."
msgstr "　温泉宿のすばらしさも有珠にとっては“なんか面倒なところ”にすぎず、そのあたりには本気で同情する青子だった。"

#. Occurrence 4_3:1530:3536: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0019; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1530
msgctxt "text_id=3536 | speaker=aoko"
msgid "\"I guess it's my time to... Huh? Is that the drawing room light on?\""
msgstr "「よし、浴場はカラ、と……あれ？　居間に電気ついてる？」"

#. Occurrence 4_3:1536:3537: scene=4_3
#: 4_3:1536
msgctxt "text_id=3537 | speaker=unknown"
msgid "  It was unusual for Alice to sit in the drawing room after her bath."
msgstr "　入浴を済ませた後、有珠が居間にいるのは珍しい。"

#. Occurrence 4_3:1541:3538: scene=4_3
#: 4_3:1541
msgctxt "text_id=3538 | speaker=unknown"
msgid "  On nights when she had nothing to discuss, it was her style to return directly to her bedroom."
msgstr "　話し合いのない夜は、さっさと自室に戻るのが彼女のスタイルなのだが。"

#. Occurrence 4_3:1593:3539: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0020; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1593
msgctxt "text_id=3539 | speaker=aoko"
msgid "\"Alice, are you in here?\""
msgstr "「有珠、いるの？」"

#. Occurrence 4_3:1603:3540: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0000; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:1603
msgctxt "text_id=3540 | speaker=alice"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 4_3:1608:3541: scene=4_3
#: 4_3:1608
msgctxt "text_id=3541 | speaker=unknown"
msgid "  Alice nodded."
msgstr "　こくり、と頷く有珠。"

#. Occurrence 4_3:1613:3542: scene=4_3
#: 4_3:1613
msgctxt "text_id=3542 | speaker=unknown"
msgid "  With no book in hand, it appeared that Alice had been waiting for Aoko."
msgstr "　読書中でもなく、彼女は青子を待っていたようだ。"

#. Occurrence 4_3:1647:3543: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0021; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1647
msgctxt "text_id=3543 | speaker=aoko"
msgid "(So that's how it is. She really has no faith in me, does she?)"
msgstr "『……そういうコト。私も信用ないな、ほんと』"

#. Occurrence 4_3:1653:3544: scene=4_3
#: 4_3:1653
msgctxt "text_id=3544 | speaker=unknown"
msgid "  Aoko scratched her head in exasperation."
msgstr "　はあ、と頭を掻く青子。"

#. Occurrence 4_3:1658:3545: scene=4_3
#: 4_3:1658
msgctxt "text_id=3545 | speaker=unknown"
msgid "  Was it that Alice was worried about her, or had no faith in her?"
msgstr "　信用されていないのか、心配されているのか。"

#. Occurrence 4_3:1663:3546: scene=4_3
#: 4_3:1663
msgctxt "text_id=3546 | speaker=unknown"
msgid "  Her expression was so calm Aoko could hardly figure what she was thinking."
msgstr "　久遠寺有珠の表情は静かすぎて、いまいち真意が読み取れない。"

#. Occurrence 4_3:1689:3547: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0022; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1689
msgctxt "text_id=3547 | speaker=aoko"
msgid "\"I have a plan. Wanna hear it?\""
msgstr "「方針なら決まったけど。聞く？」"

#. Occurrence 4_3:1709:3548: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0001; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:1709
msgctxt "text_id=3548 | speaker=alice"
msgid "\"...I can tell what it is by the look on your face."
msgstr "「……その顔を見れば聞かなくても分かるわ。"

#. Occurrence 4_3:1720:3549: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0002; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:1720
msgctxt "text_id=3549 | speaker=alice"
msgid "  It's good that you're no longer wavering, but...you must do something about that tell of yours, Aoko.\""
msgstr "　迷いがなくなったのはいい事だけど。……悪い癖ね、青子」"

#. Occurrence 4_3:1726:3550: scene=4_3
#: 4_3:1726
msgctxt "text_id=3550 | speaker=unknown"
msgid "  Alice let out a small sigh."
msgstr "　小さなため息。"

#. Occurrence 4_3:1731:3551: scene=4_3
#: 4_3:1731
msgctxt "text_id=3551 | speaker=unknown"
msgid "  It was unusual for Alice to make such a display of her disappointment."
msgstr "　この黒衣の少女がこれみよがしに<落胆|らくたん>を表すのは珍しい。"

#. Occurrence 4_3:1766:3552: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0023; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1766
msgctxt "text_id=3552 | speaker=aoko"
msgid "\"I don't like sneaky attacks, so I'm going to do it fairly, and only after I've told him why straight to his face."
msgstr "「ええ。騙し討ちは趣味じゃないから。殺すにしても正々堂々、正面から理由を言った後にする。"

#. Occurrence 4_3:1772:3553: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0024; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1772
msgctxt "text_id=3553 | speaker=aoko"
msgid "  That way there will be absolutely no trouble later. Any complaints?\""
msgstr "　それならすっぱり後腐れもないし。文句ある？」"

#. Occurrence 4_3:1790:3554: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0003; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:1790
msgctxt "text_id=3554 | speaker=alice"
msgid "\"Why would I have any? This is really only a matter of personal preference, after all."
msgstr "「文句はないわ。そういうの、好きか嫌いかはこの<際|さい>関係ないでしょうし。"

#. Occurrence 4_3:1801:3555: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0004; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:1801
msgctxt "text_id=3555 | speaker=alice"
msgid "  However...\""
msgstr "　けど―――」"

#. Occurrence 4_3:1840:3556: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0025; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1840
msgctxt "text_id=3556 | speaker=aoko"
msgid "\"You're worried that I'll mess up, right? My accuracy hasn't exactly been stellar lately, so I was thinking about how to cover my bases with the location."
msgstr "「確実性はどうかってコトでしょ。私、いまいち命中率悪いし。そのへんの問題は場所選びでフォローしようかなと。"

#. Occurrence 4_3:1852:3557: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0026; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1852
msgctxt "text_id=3557 | speaker=aoko"
msgid "  I can't throw up a field like you, so I was thinking of doing it somewhere where he physically can't escape. Any ideas?\""
msgstr "　私は有珠のようにはいかないから、物理的に逃げられない場所にしようと思うんだけど……なにかアイデアない？」"

#. Occurrence 4_3:1891:3558: scene=4_3
#: 4_3:1891
msgctxt "text_id=3558 | speaker=unknown"
msgid "  Alice nodded in thought."
msgstr "　青子からの相談に、そうね、と一考する有珠。"

#. Occurrence 4_3:1896:3559: scene=4_3
#: 4_3:1896
msgctxt "text_id=3559 | speaker=unknown"
msgid "  The finger that gently rested on her lips indicated that the question was to her liking."
msgstr "　そっと唇にあてた指が、彼女好みの質問だったコトを示している。"

#. Occurrence 4_3:1922:3560: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0005; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:1922
msgctxt "text_id=3560 | speaker=alice"
msgid "\"What about mirrors? You could easily seal him in the house of mirrors for all eternity.\""
msgstr "「鏡はどう？　鏡の国なら永遠に閉じこめていられるけど」"

#. Occurrence 4_3:1940:3561: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0027; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1940
msgctxt "text_id=3561 | speaker=aoko"
msgid "\"...Seriously? That's your idea?\""
msgstr "「……アンタ、そういうところ常識ないわよね」"

#. Occurrence 4_3:1950:3562: scene=4_3
#: 4_3:1950
msgctxt "text_id=3562 | speaker=unknown"
msgid "  She frowned at Alice's bad taste."
msgstr "　というか悪趣味、と青子は顔をしかめる。"

#. Occurrence 4_3:1984:3563: scene=4_3
#: 4_3:1984
msgctxt "text_id=3563 | speaker=unknown"
msgid "  It was the kind of idea her roommate found to be inspired, but Aoko knew was out of the question."
msgstr "　同居人なりのクリティカルなアイデアだったのだろうが、とても参考にならない。"

#. Occurrence 4_3:2004:3564: scene=4_3
#: 4_3:2004
msgctxt "text_id=3564 | speaker=unknown"
msgid "  Aoko was looking for a natural Bounded Field she could prepare, not a realm bordering on True Magic that she couldn't create to begin with."
msgstr "　青子は自分に用意できる結界を知りたいのであって、魔法スレスレの大結界など望んでいないし、用意もできないのだ。"

#. Occurrence 4_3:2030:3565: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0006; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:2030
msgctxt "text_id=3565 | speaker=alice"
msgid "\"Then you'll choose otherwise, I suppose. But please, whatever you do, do not bring him here.\""
msgstr "「なら他をあたるのね。……でも、ここを使うのだけはやめてちょうだい」"

#. Occurrence 4_3:2050:3566: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0028; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:2050
msgctxt "text_id=3566 | speaker=aoko"
msgid "\"You don't need to tell me that."
msgstr "「言われなくても分かってるって。"

#. Occurrence 4_3:2062:3567: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0029; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:2062
msgctxt "text_id=3567 | speaker=aoko"
msgid "  But, actually... Yeah."
msgstr "　あ―――けど、そうね。"

#. Occurrence 4_3:2068:3568: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0030; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:2068
msgctxt "text_id=3568 | speaker=aoko"
msgid "  A house of mirrors might actually work.\""
msgstr "　ミラーハウスはいいアイデアかも」"

#. Occurrence 4_3:2096:3569: scene=4_3
#: 4_3:2096
msgctxt "text_id=3569 | speaker=unknown"
msgid "  Aoko smirked and shifted her balance away from the wall she was resting on."
msgstr "　ニヤリと微笑って、青子は壁に寄りかかっていた体を起こした。"

#. Occurrence 4_3:2132:3570: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0031; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:2132
msgctxt "text_id=3570 | speaker=aoko"
msgid "\"Thanks, Alice. I just figured out the whole plan."
msgstr "「サンキュ、有珠。全体の流れはできあがったわ。"

#. Occurrence 4_3:2139:3571: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0032; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:2139
msgctxt "text_id=3571 | speaker=aoko"
msgid "I guess it's always best to talk to someone when you're in a bind.\""
msgstr "ほんと、こういうのってダメもとでも相談してみるものよね」"

#. Occurrence 4_3:2167:3572: scene=4_3
#: 4_3:2167
msgctxt "text_id=3572 | speaker=unknown"
msgid "  Now in a good mood, Aoko retreated from the drawing room."
msgstr "　ご機嫌な様子で立ち去る青子。"

#. Occurrence 4_3:2172:3573: scene=4_3
#: 4_3:2172
msgctxt "text_id=3573 | speaker=unknown"
msgid "  Alice tried and failed to visualize what kind of blueprint Aoko had drawn up in her mind, but whatever it was, it appeared to be the thorough kind Aoko was good at."
msgstr "　どんな青写真ができたのか有珠には見当もつかないが、彼女なりに万全の策ができたらしい。"

#. Occurrence 4_3:2203:3574: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0007; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:2203
msgctxt "text_id=3574 | speaker=alice"
msgid "\"...\""
msgstr "「……………………」"

#. Occurrence 4_3:2209:3575: scene=4_3
#: 4_3:2209
msgctxt "text_id=3575 | speaker=unknown"
msgid "  Aoko headed for the bathroom, humming to herself as she went."
msgstr "　鼻歌まじりに浴場に向かう同居人。"

#. Occurrence 4_3:2214:3576: scene=4_3
#: 4_3:2214
msgctxt "text_id=3576 | speaker=unknown"
msgid "  A year and a half of sharing a living space had taught Alice something:"
msgstr "　ここ一年半の経験か。"

#. Occurrence 4_3:2219:3577: scene=4_3
#: 4_3:2219
msgctxt "text_id=3577 | speaker=unknown"
msgid "  When Aoko Aozaki was in this good of a mood, only deep trouble could follow."
msgstr "　黒衣の少女は、蒼崎青子は有頂天になった時こそ信じられないトラブルに見舞われる事を知っていた。"

#. Occurrence 4_3:2274:3578: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0008; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:2274
msgctxt "text_id=3578 | speaker=alice"
msgid "\"Hm? You want to know if I'm okay with letting Aoko handle this on her own?\""
msgstr "「え？　……青子ひとりに<任|まか>せていいのか、ですって？」"

#. Occurrence 4_3:2287:3579: scene=4_3
#: 4_3:2287
msgctxt "text_id=3579 | speaker=unknown"
msgid "  It was unclear how long the bird had been in the drawing room."
msgstr "　いつから居間にいたのか。"

#. Occurrence 4_3:2293:3580: scene=4_3
#: 4_3:2293
msgctxt "text_id=3580 | speaker=unknown"
msgid "  Chirping at Alice, the... robin-like bird pranced across the furniture as if it were its property. "
msgstr "　コマドリ……のような鳥が、チチチ、と鳴き声をあげながら調度品の上を<闊歩|かっぽ>する。"

#. Occurrence 4_3:2319:3581: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0009; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:2319
msgctxt "text_id=3581 | speaker=alice"
msgid "\"...Yes, I suppose. She said that she wanted to do it alone, and I do want her to know she has my every faith. Still...\""
msgstr "「……そうね。彼女がひとりでやると言ったのだから、任せるのが正しい信頼関係なんでしょうけど―――」"

#. Occurrence 4_3:2325:3582: scene=4_3
#: 4_3:2325
msgctxt "text_id=3582 | speaker=unknown"
msgid "  The girl in black raised her arm."
msgstr "　黒衣の少女の腕があがる。"

#. Occurrence 4_3:2380:3583: scene=4_3
#: 4_3:2380
msgctxt "text_id=3583 | speaker=unknown"
msgid "  The bird, chirping once again, alighted on her outstretched, affectionate finger."
msgstr "　口づけを許すように差し出された指先に、チチチ、と鳴き声が舞い降りる。"

#. Occurrence 4_3:2387:3584: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0010; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:2387
msgctxt "text_id=3584 | speaker=alice"
msgid "\"Suffice to say..."
msgstr "「……嫌な話だけど。"

#. Occurrence 4_3:2394:3585: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0011; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:2394
msgctxt "text_id=3585 | speaker=alice"
msgid "Trust and faith are two very different things.\""
msgstr "信頼と信用は、また違う話よね」"

#. Occurrence 4_3:2401:3586: scene=4_3
#: 4_3:2401
msgctxt "text_id=3586 | speaker=unknown"
msgid "  The bird puffed out its stout chest in agreement."
msgstr "　<言|こえ>なき鳥が、そのでっぷりとした胸を張って同意する。"

#. Occurrence 4_3:2406:3587: scene=4_3
#: 4_3:2406
msgctxt "text_id=3587 | speaker=unknown"
msgid "  And Aoko was none the wiser to her roommate's rather unsettling comments."
msgstr "　わりかし物騒な同居人の<囁|ささや>きを、もちろん、青子は知るよしもないのだった。"

#. Occurrence 4_4:97:3588: scene=4_4
#: 4_4:97
msgctxt "text_id=3588 | speaker=unknown"
msgid "  The following day was a typically overcast one."
msgstr "　翌日。空は相変わらずの曇り模様。"

#. Occurrence 4_4:119:3589: scene=4_4
#: 4_4:119
msgctxt "text_id=3589 | speaker=unknown"
msgid "  The day's classes ended as they had started: uneventfully."
msgstr "　一日の授業は何事もなく終わった。"

#. Occurrence 4_4:124:3590: scene=4_4
#: 4_4:124
msgctxt "text_id=3590 | speaker=unknown"
msgid "  Winter break was just around the corner, and with it, final exams."
msgstr "　冬休み前の期末試験まであとわずか。"

#. Occurrence 4_4:129:3591: scene=4_4
#: 4_4:129
msgctxt "text_id=3591 | speaker=unknown"
msgid "  Although Misaki High prided itself on discipline, it was still a private school which promoted a culture of independence among its students."
msgstr "　今では厳しい規律に支配された<三咲高|ミサコー>であるが、もともとは生徒の自主性を第一とするおおらかな私立高校である。"

#. Occurrence 4_4:149:3592: scene=4_4
#: 4_4:149
msgctxt "text_id=3592 | speaker=unknown"
msgid "  Industrious students had a place to explore that side of themselves under the guardianship of the student council president."
msgstr "　真面目な生徒は生徒会長の<庇|ひ><護|ご>の下とことん真面目に。"

#. Occurrence 4_4:154:3593: scene=4_4
#: 4_4:154
msgctxt "text_id=3593 | speaker=unknown"
msgid "  More easygoing students could spend their time after school as they wished, as long as they were mindful of personal responsibility."
msgstr "　気楽な生徒は、まあ個人の責任のかぎり、とことん自由に放課後を過ごしているのだった。"

#. Occurrence 4_4:174:3594: scene=4_4
#: 4_4:174
msgctxt "text_id=3594 | speaker=unknown"
msgid "  The fact that the poster boy of independence was the student council vice president indicated just how vast the spectrum was."
msgstr "　そして、その自由な生徒の代表みたいな男が生徒会の副会長にいるあたり、この学校の懐の深さはちょっとおかしい。"

#. Occurrence 4_4:225:3595: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0000; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:225
msgctxt "text_id=3595 | speaker=tobimaru"
msgid "\"Aozaki, you in here?\""
msgstr "「蒼崎、いるかー！」"

#. Occurrence 4_4:254:3596: scene=4_4
#: 4_4:254
msgctxt "text_id=3596 | speaker=unknown"
msgid "  Tobimaru Tsukiji threw open the door to the satellite student council room, the rumored location for their secret meetings."
msgstr "　おもに密会用と噂される第二生徒会室の扉を、<槻司|つきじ><鳶丸|とびまる>は陽気にブチ開けた。"

#. Occurrence 4_4:259:3597: scene=4_4
#: 4_4:259
msgctxt "text_id=3597 | speaker=unknown"
msgid "  Despite all appearances, he was the student council vice president, who also happened to be the poor soul responsible for executing the student council's dirty work."
msgstr "　これでも副会長さまであり、生徒会の<陰|かげ>の雑務係と哀れまれる人物である。"

#. Occurrence 4_4:294:3598: scene=4_4
#: 4_4:294
msgctxt "text_id=3598 | speaker=unknown"
msgid "  One person was waiting for him in the cramped room."
msgstr "　狭苦しい室内には待ち人がひとり。"

#. Occurrence 4_4:299:3599: scene=4_4
#: 4_4:299
msgctxt "text_id=3599 | speaker=unknown"
msgid "  The student council president, Aoko Aozaki, sat imperiously in a folding chair, glaring at Tobimaru and his boisterous entrance."
msgstr "　生徒会長・蒼崎青子は姿勢良くパイプ椅子に座って、大声を上げた鳶丸をじろりと睨んでいる。"

#. Occurrence 4_4:344:3600: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0001; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:344
msgctxt "text_id=3600 | speaker=tobimaru"
msgid "\"This room is freezing, as usual."
msgstr "「あいかわらず寒いなこの部屋。"

#. Occurrence 4_4:344:3601: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0001; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:344
msgctxt "text_id=3601 | speaker=tobimaru"
msgid "  We really need to buy a heater.\""
msgstr "　なあ、今度ストーブ購入しようぜ」"

#. Occurrence 4_4:350:3602: scene=4_4
#: 4_4:350
msgctxt "text_id=3602 | speaker=unknown"
msgid "  So as not to succumb to Aoko's oppressive silence, Tobimaru opened with some casual small talk."
msgstr "　青子の無言の圧迫に負けないように、鳶丸は何気なく会話を切り出した。"

#. Occurrence 4_4:396:3603: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0000; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:396
msgctxt "text_id=3603 | speaker=aoko"
msgid "\"Thank you for coming. Let's get down to business. Do you know why I've asked you here?\""
msgstr "「お疲れさま。ところでアンタ、何しに来たのか分かってる？」"

#. Occurrence 4_4:419:3604: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0002; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:419
msgctxt "text_id=3604 | speaker=tobimaru"
msgid "\"I have an idea. What's up with the formality, Aozaki?"
msgstr "「まあな。ただ、事務的に話すのって寒いじゃねえか。"

#. Occurrence 4_4:425:3605: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0003; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:425
msgctxt "text_id=3605 | speaker=tobimaru"
msgid "  Pretty cold to talk shop right away all the time, you know?\""
msgstr "　少しぐらい世間話でもしねえとつまらねえだろ？」"

#. Occurrence 4_4:452:3606: scene=4_4
#: 4_4:452
msgctxt "text_id=3606 | speaker=unknown"
msgid "  Tobimaru closed the door and sat down across from Aoko."
msgstr "　鳶丸は扉を閉めて、青子の前の椅子に座った。"

#. Occurrence 4_4:457:3607: scene=4_4
#: 4_4:457
msgctxt "text_id=3607 | speaker=unknown"
msgid "  He was holding a blue envelope."
msgstr "　その手には青い封筒を抱えている。"

#. Occurrence 4_4:501:3608: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0001; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:501
msgctxt "text_id=3608 | speaker=aoko"
msgid "\"Yeah, and loose lips sink ships."
msgstr "「こういう時は無駄口はたたかない方がいいわよ。"

#. Occurrence 4_4:507:3609: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0002; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:507
msgctxt "text_id=3609 | speaker=aoko"
msgid "  Might remember that once you get out into the real world.\""
msgstr "　なんとなくプロっぽいでしょ」"

#. Occurrence 4_4:513:3610: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0004; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:513
msgctxt "text_id=3610 | speaker=tobimaru"
msgid "\"All right, I'll remem―wait a sec. Nice try.\""
msgstr "「なる―――いや、いやいやいや」"

#. Occurrence 4_4:534:3611: scene=4_4
#: 4_4:534
msgctxt "text_id=3611 | speaker=unknown"
msgid "  Tobimaru was halfway to agreeing with Aoko before he caught himself and began to shake his head."
msgstr "　青子の刺々しい返答にそうかも、と同意しかけて、鳶丸はイヤイヤと首を振った。"

#. Occurrence 4_4:539:3612: scene=4_4
#: 4_4:539
msgctxt "text_id=3612 | speaker=unknown"
msgid "  As much as Tobimaru enjoyed the lack of red tape in his new line of work, he was not ready to turn full spy on his first day on the job."
msgstr "　いくらフリーダムな鳶丸でも、そんな諜報員めいた日常は<御免|ごめん><蒙|こうむ>る。"

#. Occurrence 4_4:566:3613: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0003; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:566
msgctxt "text_id=3613 | speaker=aoko"
msgid "\"So then. Are you done with your investigation?\""
msgstr "「それで、調べ終わったの？」"

#. Occurrence 4_4:578:3614: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0005; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:578
msgctxt "text_id=3614 | speaker=tobimaru"
msgid "\"Yeah. I finished the last interview just now."
msgstr "「ああ。ついさっき最後の聴取を済ませてきた。"

#. Occurrence 4_4:584:3615: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0006; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:584
msgctxt "text_id=3615 | speaker=tobimaru"
msgid "  The details are in the envelope along with the file you gave me.\""
msgstr "　詳しい事はその封筒に入ってる。おまえから渡された例のファイルも、そん中」"

#. Occurrence 4_4:629:3616: scene=4_4
#: 4_4:629
msgctxt "text_id=3616 | speaker=unknown"
msgid "  He tossed the envelope onto the table."
msgstr "　ぱさり、と机に置かれる青封筒。"

#. Occurrence 4_4:660:3617: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0004; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:660
msgctxt "text_id=3617 | speaker=aoko"
msgid "\"Good.\""
msgstr "「そう」"

#. Occurrence 4_4:719:3618: scene=4_4
#: 4_4:719
msgctxt "text_id=3618 | speaker=unknown"
msgid "  Aoko picked it up and began to scan through the documents that were inside."
msgstr "　青子は封筒を手にし、中の書類に目を通す。"

#. Occurrence 4_4:724:3619: scene=4_4
#: 4_4:724
msgctxt "text_id=3619 | speaker=unknown"
msgid "  She entered her own little world, not sparing the slightest bit of attention for Tobimaru."
msgstr "　そこからは完全に彼女ひとりの世界で、鳶丸に対して気を配ってさえいない。"

#. Occurrence 4_4:729:3620: scene=4_4
#: 4_4:729
msgctxt "text_id=3620 | speaker=unknown"
msgid "  If ignoring other people were a skill, she would be a master at it."
msgstr "　歯に<衣|きぬ>着せずに言えば、パーフェクトなまでの無視っぷりである。"

#. Occurrence 4_4:808:3621: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0007; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:808
msgctxt "text_id=3621 | speaker=tobimaru"
msgid "\"...Ahem.\""
msgstr "「………………なあ」"

#. Occurrence 4_4:814:3622: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0005; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:814
msgctxt "text_id=3622 | speaker=aoko"
msgid "\"What?\""
msgstr "「なに？」"

#. Occurrence 4_4:820:3623: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0008; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:820
msgctxt "text_id=3623 | speaker=tobimaru"
msgid "\"I just wanted to ask one thing.\""
msgstr "「ひとつ、聞きたいんだけどよ」"

#. Occurrence 4_4:832:3624: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0006; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:832
msgctxt "text_id=3624 | speaker=aoko"
msgid "\"Yeah, and?\""
msgstr "「だから、なに？」"

#. Occurrence 4_4:859:3625: scene=4_4
#: 4_4:859
msgctxt "text_id=3625 | speaker=unknown"
msgid "  The room was filled with a chilling silence."
msgstr "　冷えきった沈黙。"

#. Occurrence 4_4:864:3626: scene=4_4
#: 4_4:864
msgctxt "text_id=3626 | speaker=unknown"
msgid "  Aoko continued reading without an ounce of emotion upon her face."
msgstr "　無感情に書類をチェックする青子と、"

#. Occurrence 4_4:869:3627: scene=4_4
#: 4_4:869
msgctxt "text_id=3627 | speaker=unknown"
msgid "  Though Tobimaru kept up an air of indifference, his stare remained fixed intently on her."
msgstr "　そんな青子をどうでもよさげに、しかし正面から見据える鳶丸。"

#. Occurrence 4_4:890:3628: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0009; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:890
msgctxt "text_id=3628 | speaker=tobimaru"
msgid "\"Do you get a kick out of doing this kind of thing, Aozaki?\""
msgstr "「蒼崎、そういうの作って楽しい？」"

#. Occurrence 4_4:947:3629: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0007; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:947
msgctxt "text_id=3629 | speaker=aoko"
msgid "\"Of course not. What's so fun about gathering intel I hardly even get to use?\""
msgstr "「楽しいワケないでしょ。こんなの、作ったところであんまり使う機会なんてないんだから」"

#. Occurrence 4_4:981:3630: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0010; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:981
msgctxt "text_id=3630 | speaker=tobimaru"
msgid "\"Riiight. Just wanted to check.\""
msgstr "「そうか。ならいい」"

#. Occurrence 4_4:989:3631: scene=4_4
#: 4_4:989
msgctxt "text_id=3631 | speaker=unknown"
msgid "  Whether or not he was convinced, Tobimaru stood up from his chair with a disappointed expression."
msgstr "　納得いったのか、<憮然|ぶぜん>顔のまま鳶丸は席を立った。"

#. Occurrence 4_4:1024:3632: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0011; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:1024
msgctxt "text_id=3632 | speaker=tobimaru"
msgid "\"You'll figure this out just by reading it all, but I wasn't able to dig up anything conclusive."
msgstr "「最後まで読めば分かるだろうが、あんまり確証は取れなかったぜ。"

#. Occurrence 4_4:1031:3633: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0012; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:1031
msgctxt "text_id=3633 | speaker=tobimaru"
msgid "By all indications, that there weren't any students in the area the day before yesterday. It's not like I can say that for sure, though.\""
msgstr "というより、一昨日あの辺りにいた生徒はいないって話になりそうだ。ま、断定はできないけどな」"

#. Occurrence 4_4:1082:3634: scene=4_4
#: 4_4:1082
msgctxt "text_id=3634 | speaker=unknown"
msgid "  No longer concerned over his task, Tobimaru headed toward the door,"
msgstr "　鳶丸はつれない態度でドアに向かう。"

#. Occurrence 4_4:1087:3635: scene=4_4
#: 4_4:1087
msgctxt "text_id=3635 | speaker=unknown"
msgid "  as if to say it was out of his hands."
msgstr "　俺はこの件には無関係です、と言わんばかりだ。"

#. Occurrence 4_4:1137:3636: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0013; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:1137
msgctxt "text_id=3636 | speaker=tobimaru"
msgid "\"...Oh, and one more thing."
msgstr "「―――っと、そうだ。"

#. Occurrence 4_4:1143:3637: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0014; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:1143
msgctxt "text_id=3637 | speaker=tobimaru"
msgid "  There was one student that wasn't included in your dragnet. You forgot to include any out-of-term transfers.\""
msgstr "　そういえば一人だけ該当しなかった奴がいる。季節外れの転入生までは、蒼崎も調べきれなかったみてえじゃねぇか」"

#. Occurrence 4_4:1187:3638: scene=4_4
#: 4_4:1187
msgctxt "text_id=3638 | speaker=unknown"
msgid "  Aoko raised her head ever so slightly."
msgstr "　わずかに顔をあげる青子。"

#. Occurrence 4_4:1192:3639: scene=4_4
#: 4_4:1192
msgctxt "text_id=3639 | speaker=unknown"
msgid "  He was right. The recent transfer student was not included within the scope of her investigation."
msgstr "　たしかに転入したばかりの生徒は彼女の調査範囲に含まれてはいない。"

#. Occurrence 4_4:1213:3640: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0015; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:1213
msgctxt "text_id=3640 | speaker=tobimaru"
msgid "\"So I haven't looked at Sono-G."
msgstr "「そんなわけで草の字に関しては調べてないぜ。"

#. Occurrence 4_4:1219:3641: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0016; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:1219
msgctxt "text_id=3641 | speaker=tobimaru"
msgid "  Though, considering it's him, it's safe to assume that he was working late. Or, wait, it would be if he hadn't have mentioned something about... seeing a murder or whatever. I told him that it was probably just a bad dream.\""
msgstr "　ま、アイツならいつだろうと遅くまでバイトだろうが……いや、人殺しを見た、なんてコト口走ってるようじゃ、家で悪い夢でも見てたのかもしれねえか」"

#. Occurrence 4_4:1256:3642: scene=4_4
#: 4_4:1256
msgctxt "text_id=3642 | speaker=unknown"
msgid "  Tobimaru cheerfully left the student council room."
msgstr "　鳶丸は陽気にこぼして去っていった。"

#. Occurrence 4_4:1291:3643: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0008; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:1291
msgctxt "text_id=3643 | speaker=aoko"
msgid "\"...What?\""
msgstr "「―――、は？」"

#. Occurrence 4_4:1297:3644: scene=4_4
#: 4_4:1297
msgctxt "text_id=3644 | speaker=unknown"
msgid "  Simultaneously, Aoko felt her fingers go numb,"
msgstr "　同時に、青子は持っていた書類を机に落とした。"

#. Occurrence 4_4:1302:3645: scene=4_4
#: 4_4:1302
msgctxt "text_id=3645 | speaker=unknown"
msgid "  and the documents she was holding spilled all over the table."
msgstr "　別にそんなつもりはなかったのに、なぜか、指先から力が失われてしまったらしい。"

#. Occurrence 4_4:1353:3646: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0009; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:1353
msgctxt "text_id=3646 | speaker=aoko"
msgid "\"It can't be. That's not possible...\""
msgstr "「……そんな、まさかね」"

#. Occurrence 4_4:1359:3647: scene=4_4
#: 4_4:1359
msgctxt "text_id=3647 | speaker=unknown"
msgid "  She broke out into a cold sweat and tried to tell herself that there must be some kind of mistake."
msgstr "　考えすぎだ、と自分に対して軽口を言ってみる。"

#. Occurrence 4_4:1364:3648: scene=4_4
#: 4_4:1364
msgctxt "text_id=3648 | speaker=unknown"
msgid "  However, the uncomfortable feeling in her gut would simply not go away. Perhaps because her intuition was almost always right at times like these."
msgstr "　けれど突然生まれた不安は消えず、こういう時の自分の直感がたいてい合っている事を、蒼崎青子は知っていた。"

#. Occurrence 4_4:1456:3649: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0010; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:1456
msgctxt "text_id=3649 | speaker=aoko"
msgid "\"...You gotta be kidding me.\""
msgstr "「―――馬鹿らしい」"

#. Occurrence 4_4:1462:3650: scene=4_4
#: 4_4:1462
msgctxt "text_id=3650 | speaker=unknown"
msgid "  And yet, she knew what she had to do."
msgstr "　だとしてもやる事は同じだ。"

#. Occurrence 4_4:1467:3651: scene=4_4
#: 4_4:1467
msgctxt "text_id=3651 | speaker=unknown"
msgid "  She would not have hesitated to kill Tobimaru if he had been the witness."
msgstr "　仮に目撃者が鳶丸だった場合、青子は<躊躇|ためら>わず殺せるだろう。"

#. Occurrence 4_4:1472:3652: scene=4_4
#: 4_4:1472
msgctxt "text_id=3652 | speaker=unknown"
msgid "  But what if it was who she was thinking of?"
msgstr "　けれど、それが彼だったら？"

#. Occurrence 4_4:1477:3653: scene=4_4
#: 4_4:1477
msgctxt "text_id=3653 | speaker=unknown"
msgid "  Just considering the possibility caused her blood to run cold."
msgstr "　そんな『もしも』を連想した途端、どんな仮定より冷めきっていく自分を感じた。"

#. Occurrence 4_4:1514:3654: scene=4_4
#: 4_4:1514
msgctxt "text_id=3654 | speaker=unknown"
msgid "  Aoko put her forehead in her hands and began to brood."
msgstr "　青子は額に手を当てて考えこむ。"

#. Occurrence 4_4:1519:3655: scene=4_4
#: 4_4:1519
msgctxt "text_id=3655 | speaker=unknown"
msgid "  And then, suddenly―"
msgstr "　そうして唐突に、"

#. Occurrence 4_4:1579:3656: scene=4_4
#: 4_4:1579
msgctxt "text_id=3656 | speaker=unknown"
msgid "\"Let us talk choice. You will always be faced with choices."
msgstr "「選択の話をしよう。おまえは常に二者択一を迫られる。"

#. Occurrence 4_4:1584:3657: scene=4_4
#: 4_4:1584
msgctxt "text_id=3657 | speaker=unknown"
msgid "  A virtuous fool and a wicked sage. You cannot save both. You must pick one. That is the freedom granted to you.\""
msgstr "　善良な愚者と醜悪な賢者。すべてを救う手段はない。どちらかを選ぶこと。それだけが、おまえに許された自由となる」"

#. Occurrence 4_4:1644:3658: scene=4_4
#: 4_4:1644
msgctxt "text_id=3658 | speaker=unknown"
msgid "  Two years earlier."
msgstr "　二年前。"

#. Occurrence 4_4:1649:3659: scene=4_4
#: 4_4:1649
msgctxt "text_id=3659 | speaker=unknown"
msgid "  Aoko muttered the words offered by her grandfather the day she replaced her elder sister as his successor, and let out a sigh of lament."
msgstr "　姉に代わって後継ぎになった日に祖父から贈られた言葉を呟いて、青子は小さく嘆息した。"

#. Occurrence 4_4:1656:3660: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0011; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:1656
msgctxt "text_id=3660 | speaker=aoko"
msgid "\"...This has to be a joke.\""
msgstr "「―――すごく、バカみたい」"

#. Occurrence 4_4:1670:3661: scene=4_4
#: 4_4:1670
msgctxt "text_id=3661 | speaker=unknown"
msgid "  She laughed at her own intuition."
msgstr "　自分の勘の良さに<嗤|わら>ってしまう。"

#. Occurrence 4_4:1676:3662: scene=4_4
#: 4_4:1676
msgctxt "text_id=3662 | speaker=unknown"
msgid "  But it was no joke."
msgstr "　本当。"

msgctxt "text_id=3663 | speaker=unknown"
msgid " If only those words had never been said."
msgstr "そんな台詞、口にしなければよかったのにと。"

#. Occurrence 4_4:1776:3664: scene=4_4
#: 4_4:1776
msgctxt "text_id=3664 | speaker=unknown"
msgid "  Aoko locked up the student council room and left for the day."
msgstr "　青子は戸締まりを済ませ、生徒会室を後にした。"

#. Occurrence 4_4:1781:3665: scene=4_4
#: 4_4:1781
msgctxt "text_id=3665 | speaker=unknown"
msgid "  Calmly, as though nothing untoward had happened, she greeted the students as they passed her in the halls. She was almost shocked by how natural she seemed."
msgstr "　平然と、それこそ何もなかったようにすれ違う生徒たちと挨拶を交わせるあたり、自分らしいと呆れながら。"

#. Occurrence 4_4:1830:3666: scene=4_4
#: 4_4:1830
msgctxt "text_id=3666 | speaker=unknown"
msgid "  There were still plenty of students at the school."
msgstr "　学校にはまだ活気がある。"

#. Occurrence 4_4:1835:3667: scene=4_4
#: 4_4:1835
msgctxt "text_id=3667 | speaker=unknown"
msgid "  The grounds were noisy with the chattering of students who had finished the day but had yet to head home. Others still had club activities."
msgstr "　部活動の生徒は言うに及ばず、用を済ませて下校していく生徒たちの話し声で校庭は騒がしい。"

#. Occurrence 4_4:1840:3668: scene=4_4
#: 4_4:1840
msgctxt "text_id=3668 | speaker=unknown"
msgid "  The gray sky looked ready to pour, but nobody seemed to pay it any mind."
msgstr "　今にも泣きだしそうな灰色の空だが、彼らにはさして気になる問題ではないようだ。"

#. Occurrence 4_4:1887:3669: scene=4_4
#: 4_4:1887
msgctxt "text_id=3669 | speaker=unknown"
msgid "  Amidst the clamor, Aoko hastened to the school gate."
msgstr "　そんな喧噪にまじって、青子は早足で校門に向かう。"

#. Occurrence 4_4:1892:3670: scene=4_4
#: 4_4:1892
msgctxt "text_id=3670 | speaker=unknown"
msgid "  She passed by some students in animated conversation."
msgstr "　お<喋|しゃべ>りに花を咲かす生徒たちを通りすぎる。"

#. Occurrence 4_4:1897:3671: scene=4_4
#: 4_4:1897
msgctxt "text_id=3671 | speaker=unknown"
msgid "  They seemed to be talking about their after-school plans."
msgstr "　会話の内容は放課後の予定について。"

#. Occurrence 4_4:1903:3672: scene=4_4
#: 4_4:1903
msgctxt "text_id=3672 | speaker=unknown"
msgid "Apparently, they were adamant about maximizing their free time."
msgstr "いかに無駄なく充実した放課後を過ごすかを真剣に論じている。"

#. Occurrence 4_4:1923:3673: scene=4_4
#: 4_4:1923
msgctxt "text_id=3673 | speaker=unknown"
msgid "  She could not figure how they could possibly be so irresponsibly focused on fun, but at the same time was in no mood to make fun of or feel envious of them."
msgstr "　彼らが持つ、<遮二無二|しゃにむに>に遊ぼうという気は知れないけど、馬鹿にする気も、羨ましがる気持ちも青子にはない。"

#. Occurrence 4_4:1928:3674: scene=4_4
#: 4_4:1928
msgctxt "text_id=3674 | speaker=unknown"
msgid "  Two short years prior, she had been just like them."
msgstr "　ほんの二年前まで、そういった自由を心から愛していた自分がいたとしてもだ。"

#. Occurrence 4_4:1949:3675: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0012; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:1949
msgctxt "text_id=3675 | speaker=aoko"
msgid "(I wonder if I'm becoming desensitized to it all.)"
msgstr "『……根は冷めてるのかな、私って』"

#. Occurrence 4_4:1955:3676: scene=4_4
#: 4_4:1955
msgctxt "text_id=3676 | speaker=unknown"
msgid "  She re-tied her scarf, this time more tightly, to give off an air of solitude, but she was fooling no one."
msgstr "　マフラーをきつめに締めてみたが、それで孤独を漂わせるにはまだ経験が少なかった。"

#. Occurrence 4_4:1960:3677: scene=4_4
#: 4_4:1960
msgctxt "text_id=3677 | speaker=unknown"
msgid "  After all, what people who feign solitude are really masking is rejection."
msgstr "　そもそも淋しいと思わない人間が孤独を装っても、それは孤独ではなく拒絶と言うのだ。"

#. Occurrence 4_4:1981:3678: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0013; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:1981
msgctxt "text_id=3678 | speaker=aoko"
msgid "(Solitude, rejection... They're two sides of the same coin.)"
msgstr "『……そうよね。孤独っていうのはああいうのを言うもんでしょうし』"

#. Occurrence 4_4:1989:3679: scene=4_4
#: 4_4:1989
msgctxt "text_id=3679 | speaker=unknown"
msgid "  The area by the school gate was busier than usual."
msgstr "　校門はいつもより騒がしい。"

#. Occurrence 4_4:1994:3680: scene=4_4
#: 4_4:1994
msgctxt "text_id=3680 | speaker=unknown"
msgid "  A group of boys appeared to be huddled behind it."
msgstr "　原因は校門の陰で立往生をしている男子生徒たちだ。"

#. Occurrence 4_4:1999:3681: scene=4_4
#: 4_4:1999
msgctxt "text_id=3681 | speaker=unknown"
msgid "  Their transparent attempt to be discreet in terms of both location and loudness of voices did nothing to hide the fact that they were noisily arguing about a girl standing alone on the other side of the street."
msgstr "　寄り添って密談をしている彼らは、校門の陰に隠れて、表通りに立っている一人の少女について、ざわざわと論じあっていた。"

#. Occurrence 4_4:2079:3682: scene=4_4
#: 4_4:2079
msgctxt "text_id=3682 | speaker=unknown"
msgid "  The girl was cloaked in a black cape."
msgstr "　少女は黒いケープに身を包んでいた。"

#. Occurrence 4_4:2084:3683: scene=4_4
#: 4_4:2084
msgctxt "text_id=3683 | speaker=unknown"
msgid "  At first glance it could have been mistaken for normal attire, but those from Misaki could tell that she wore the uniform of a prestigious girls' school."
msgstr "　一見すると普段着だが、三咲町の人間なら、ケープ下の服がとある名門女子校の制服である事を知っている。"

#. Occurrence 4_4:2089:3684: scene=4_4
#: 4_4:2089
msgctxt "text_id=3684 | speaker=unknown"
msgid "  Said school had no connection to Misaki High in any way, shape, or form. The two schools were miles apart both physically and spiritually."
msgstr "　もっとも、その女学院は三咲高校とは縁もゆかりもない、距離的にも精神的にも遠く離れた存在である。"

#. Occurrence 4_4:2109:3685: scene=4_4
#: 4_4:2109
msgctxt "text_id=3685 | speaker=unknown"
msgid "  A member of that school's student body was a rare sighting, as the majority were forced to live in the school dorm."
msgstr "　彼女達の大半は寮生活を強いられており、町中で見かける事は滅多にない。"

#. Occurrence 4_4:2114:3686: scene=4_4
#: 4_4:2114
msgctxt "text_id=3686 | speaker=unknown"
msgid "  Reien Girls Academy had a reputation as a school for princesses, and it was rare indeed for one to be slumming with the common folk."
msgstr "　お嬢様学園と名こそ響いているが、実際にはそうお目にかかれない礼園女学院の制服だ。"

#. Occurrence 4_4:2134:3687: scene=4_4
#: 4_4:2134
msgctxt "text_id=3687 | speaker=unknown"
msgid "  That alone would have been enough to cause the ruckus among the boys, but this girl looked the epitome of class."
msgstr "　それだけで男どもが騒ぎ立てるには十分だが、くわえて、その少女は上等すぎた。"

#. Occurrence 4_4:2154:3688: scene=4_4
#: 4_4:2154
msgctxt "text_id=3688 | speaker=unknown"
msgid "  One could not help but describe the standing figure as charming."
msgstr "　可憐としか言いようのない立ち姿。"

#. Occurrence 4_4:2159:3689: scene=4_4
#: 4_4:2159
msgctxt "text_id=3689 | speaker=unknown"
msgid "  The way she silently, motionlessly waited was reminiscent of a meticulously composed portrait."
msgstr "　身じろぎひとつせず待ち続ける様は、丁寧に描かれた絵画を思わせる。"

#. Occurrence 4_4:2164:3690: scene=4_4
#: 4_4:2164
msgctxt "text_id=3690 | speaker=unknown"
msgid "  Aoko took one look at her before instantly recalling that one word: solitude."
msgstr "　その姿を見て、一言で青子が『孤独』と断言したように。"

#. Occurrence 4_4:2212:3691: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0014; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:2212
msgctxt "text_id=3691 | speaker=aoko"
msgid "(Okay you lamebrains, don't you have anywhere better to be?)"
msgstr "『……まったく、うちの男子どもは。家に帰りもせず、陰でこそこそやってるのはそういうコト』"

#. Occurrence 4_4:2218:3692: scene=4_4
#: 4_4:2218
msgctxt "text_id=3692 | speaker=unknown"
msgid "  Disgusted, Aoko barged through the gate."
msgstr "　呆れながら、青子はずかずかと校門を通過した。"

#. Occurrence 4_4:2223:3693: scene=4_4
#: 4_4:2223
msgctxt "text_id=3693 | speaker=unknown"
msgid "  At this point she would normally head home, but today, she crossed the street toward the waiting girl."
msgstr "　いつもなら坂道を下りていくところを、まっすぐアスファルトを横断し、道端に立ち続ける少女へと向かう。"

#. Occurrence 4_4:2284:3694: voice_id=F80_4_4_0000; voice_prefix=F80; voice_category=0; scene=4_4
#: 4_4:2284
msgctxt "text_id=3694 | speaker=unknown"
msgid "\"Oh crap! Is that the student council president?!\""
msgstr "「げぇー!?　あれなるは生徒会長さまー!?」"

#. Occurrence 4_4:2290:3695: voice_id=F90_4_4_0000; voice_prefix=F90; voice_category=0; scene=4_4
#: 4_4:2290
msgctxt "text_id=3695 | speaker=unknown"
msgid "\"Damn it, she's trying to chase her away! ...Let the girl be! She has a right to stand there if she wants to!\""
msgstr "「くそ、追っ払う気なのかよぅ。居たいんならいつまでだって居させてあげればいいじゃんかー！」"

#. Occurrence 4_4:2304:3696: voice_id=G10_4_4_0000; voice_prefix=G10; voice_category=0; scene=4_4
#: 4_4:2304
msgctxt "text_id=3696 | speaker=unknown"
msgid "\"She's gonna go nuclear! The president versus the angel!\""
msgstr "「ってか怒られる？　怒られるのあの天使？」"

#. Occurrence 4_4:2310:3697: voice_id=G20_4_4_0000; voice_prefix=G20; voice_category=0; scene=4_4
#: 4_4:2310
msgctxt "text_id=3697 | speaker=unknown"
msgid "\"What gives, man? Who cares if she's from another school! She's not even on school property...right? Right guys?\""
msgstr "「<他校|よそ>の生徒でも、校門前にいるぐらいなら……別に問題はないと思う……けど……」"

#. Occurrence 4_4:2316:3698: voice_id=G30_4_4_9000; voice_prefix=G30; voice_category=0; scene=4_4
#: 4_4:2316
msgctxt "text_id=3698 | speaker=unknown"
msgid "\"Don't mess with Madam Aoko. You're just asking to be smacked.\""
msgstr "「青子女史は容赦ねえからな。下手すると平手だぜ、平手」"

#. Occurrence 4_4:2362:3699: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0015; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:2362
msgctxt "text_id=3699 | speaker=aoko"
msgid "\"...Hah.\""
msgstr "「…………はあ」"

#. Occurrence 4_4:2367:3700: scene=4_4
#: 4_4:2367
msgctxt "text_id=3700 | speaker=unknown"
msgid "  The boys ran their mouths behind her back."
msgstr "　背中では言いたい放題だ。"

#. Occurrence 4_4:2372:3701: scene=4_4
#: 4_4:2372
msgctxt "text_id=3701 | speaker=unknown"
msgid "  Not in the mood to shut them up, Aoko walked right up to the girl and offered an informal wave."
msgstr "　振り返って黙らせる気分でもなく、青子は少女の目前まで歩いて、やあ、とばかりに片手を上げた。"

#. Occurrence 4_4:2425:3702: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0016; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:2425
msgctxt "text_id=3702 | speaker=aoko"
msgid "\"Something the matter, Alice? I told you before, there's nothing of interest for you here.\""
msgstr "「どうしたの有珠？　こんなところに来たって、何も面白いコトはないって言ったのに」"

#. Occurrence 4_4:2445:3703: voice_id=X20_4_4_0000; voice_prefix=X20; voice_category=0; scene=4_4
#: 4_4:2445
msgctxt "text_id=3703 | speaker=unknown"
msgid "\"For real!?\""
msgstr "「ちょ、ありえねーーーーーーー！！！！？」"

#. Occurrence 4_4:2451:3704: scene=4_4
#: 4_4:2451
msgctxt "text_id=3704 | speaker=unknown"
msgid "  Aoko heard the boys by the gate lose their collective minds, and did her best to ignore them."
msgstr "　校門の陰から悲鳴らしきものがハモって聞こえたが、もちろん無視する青子だった。"

#. Occurrence 4_4:2490:3705: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0000_0; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:2490
msgctxt "text_id=3705 | speaker=alice"
msgid "\"I wanted to be sure, but―"
msgstr "「あの事を確かめに。―――"

#. Occurrence 4_4:2504:3706: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0000_1; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:2504
msgctxt "text_id=3706 | speaker=alice"
msgid "Aoko?"
msgstr "青子。"

#. Occurrence 4_4:2543:3707: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0001; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:2543
msgctxt "text_id=3707 | speaker=alice"
msgid "  Those people are a nuisance.\""
msgstr "　あの人たち、邪魔なんだけど」"

#. Occurrence 4_4:2555:3708: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0017; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:2555
msgctxt "text_id=3708 | speaker=aoko"
msgid "\"You think? I'll chase them off.\""
msgstr "「分かってる、いま追っ払うから」"

#. Occurrence 4_4:2561:3709: scene=4_4
#: 4_4:2561
msgctxt "text_id=3709 | speaker=unknown"
msgid "  In contrast to Alice's small voice, Aoko spoke loud and clear."
msgstr "　細い有珠の声に対して、青子ははっきりと、これみよがしに声を大きくしている。"

#. Occurrence 4_4:2566:3710: scene=4_4
#: 4_4:2566
msgctxt "text_id=3710 | speaker=unknown"
msgid "  Naturally, this was on purpose, so as to deal with the riffraff by the gate all at once."
msgstr "　無論、校門の陰に群がる<十把一絡|じっぱひとから>げに聞こえるように。"

#. Occurrence 4_4:2640:3711: voice_id=F80_4_4_0002; voice_prefix=F80; voice_category=0; scene=4_4
#: 4_4:2640
msgctxt "text_id=3711 | speaker=unknown"
msgid "\"Crap, she's coming this way!\""
msgstr "「げ、会長こっち来んぞ!?」"

#. Occurrence 4_4:2646:3712: voice_id=F90_4_4_0001; voice_prefix=F90; voice_category=0; scene=4_4
#: 4_4:2646
msgctxt "text_id=3712 | speaker=unknown"
msgid "\"Hey, stop pushing me! Move it! I'm out!\""
msgstr "「おい、押すなよ、うしろのヤツどけって！　オレ校舎に逃げるから！」"

#. Occurrence 4_4:2652:3713: voice_id=G10_4_4_0001; voice_prefix=G10; voice_category=0; scene=4_4
#: 4_4:2652
msgctxt "text_id=3713 | speaker=unknown"
msgid "\"But... doesn't it look like they're tight? Maybe we could get the prez to introduce us.\""
msgstr "「いや、でも……あの<娘|こ>、会長と知り合いなんでしょ？　うまく会長に紹介してもらう、とか……」"

#. Occurrence 4_4:2658:3714: voice_id=G20_4_4_9000; voice_prefix=G20; voice_category=0; scene=4_4
#: 4_4:2658
msgctxt "text_id=3714 | speaker=unknown"
msgid "\"Hahaha. Rookie mistake. You still haven't experienced the realities of the battlefield. On second thought, don't let dreams be dreams. It's your funeral.\""
msgstr "「あはは、さすが一年坊主。まだ戦場の現実ってもんを理解していねぇ。―――よし、死の<間際|まぎわ>までいい夢見ろよ」"

#. Occurrence 4_4:2730:3715: scene=4_4
#: 4_4:2730
msgctxt "text_id=3715 | speaker=unknown"
msgid "  Perhaps because too many of them had gathered in one place, the mob entered a frenzied panic as they tried to escape."
msgstr "　一ヶ所に集まりすぎたのか、混乱きわまって校門の陰でつまる男子生徒たち。"

#. Occurrence 4_4:2736:3716: scene=4_4
#: 4_4:2736
msgctxt "text_id=3716 | speaker=unknown"
msgid "Aoko addressed them all."
msgstr "そんな彼らを、"

#. Occurrence 4_4:2748:3717: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0018; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:2748
msgctxt "text_id=3717 | speaker=aoko"
msgid "\"Well, well, well, what do we have here? If it isn't the Go Home Early Club? Would you mind telling me what you're all doing gathered in a place like this with no club activities to attend?\""
msgstr "「さーて。部活動があるワケでもなし、ただ家に帰るだけの帰宅部の皆さん？　こんなところで何を集まってるのか、教えてくれる？」"

#. Occurrence 4_4:2759:3718: voice_id=X20_4_4_0001; voice_prefix=X20; voice_category=0; scene=4_4
#: 4_4:2759
msgctxt "text_id=3718 | speaker=unknown"
msgid "\"Eeeep!\""
msgstr "「ひぃぃいい！」"

#. Occurrence 4_4:2765:3719: scene=4_4
#: 4_4:2765
msgctxt "text_id=3719 | speaker=unknown"
msgid "  The student council president stared daggers at the boys."
msgstr "　どーん、と擬音を背負って<睥睨|へいげい>する生徒会長。"

#. Occurrence 4_4:2806:3720: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0019; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:2806
msgctxt "text_id=3720 | speaker=aoko"
msgid "\"In any case, exams are coming up."
msgstr "「なにしろ試験前だもの。"

#. Occurrence 4_4:2812:3721: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0020; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:2812
msgctxt "text_id=3721 | speaker=aoko"
msgid "  It sure would be horrible if, instead of going home to study, you were loitering around just to ogle another school's student, now wouldn't it?"
msgstr "　<実|み>になる事なら私も教えてほしいけど、まさか<雁首|がんくび>並べて女学院のお嬢様を<眺|なが>めてただけ、なんて事はないわよね？"

#. Occurrence 4_4:2818:3722: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0021; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:2818
msgctxt "text_id=3722 | speaker=aoko"
msgid "  It's not like a single one of you had the guts to even go up to her and say something.\""
msgstr "　声をかける勇気もなくて、眺めてただけ、なんて事は」"

#. Occurrence 4_4:2836:3723: scene=4_4
#: 4_4:2836
msgctxt "text_id=3723 | speaker=unknown"
msgid "  Not one of them was brave enough to admit that this hit the nail on the head. If any of them had such courage, they would have already been chatting the young lady up."
msgstr "　はい、実はそうなんです、などと返答できる剛の者はいなかった。それだけの勇気があるならとっくに声をかけている。"

#. Occurrence 4_4:2900:3724: voice_id=F80_4_4_9000; voice_prefix=F80; voice_category=0; scene=4_4
#: 4_4:2900
msgctxt "text_id=3724 | speaker=unknown"
msgid "\"Uh... I think I forgot something in the classroom.\""
msgstr "「……いや、ボク教室にちょっと忘れ物が……」"

#. Occurrence 4_4:2910:3725: voice_id=F90_4_4_9000; voice_prefix=F90; voice_category=0; scene=4_4
#: 4_4:2910
msgctxt "text_id=3725 | speaker=unknown"
msgid "\"If I had known it was going to end like this, I would have at least gone down trying.\""
msgstr "「こんなオチならダメもとで玉砕しとくんだった……」"

#. Occurrence 4_4:2916:3726: voice_id=G10_4_4_9000; voice_prefix=G10; voice_category=0; scene=4_4
#: 4_4:2916
msgctxt "text_id=3726 | speaker=unknown"
msgid "\"What if we go borrow binoculars from the Astronomy Club? I'm sure we could get a good view from the roof.\""
msgstr "「天文部にいって双眼鏡借りるのどうだ？　屋上からお顔を<賜|たまわ>るとか」"

#. Occurrence 4_4:2926:3727: voice_id=G20_4_4_9001; voice_prefix=G20; voice_category=0; scene=4_4
#: 4_4:2926
msgctxt "text_id=3727 | speaker=unknown"
msgid "\"The Astronomy Club doesn't have binoculars, dummy! If anyone does, it would be the Wild Bird Society.\""
msgstr "「天文部にそんなのねえよ！　あるとしたら野鳥同好会じゃね？」"

#. Occurrence 4_4:2951:3728: voice_id=G30_4_4_9001; voice_prefix=G30; voice_category=0; scene=4_4
#: 4_4:2951
msgctxt "text_id=3728 | speaker=unknown"
msgid "\"Haha! The prez destroyed those last month! If you have enough time for bird-watching, you have enough time to find a girlfriend, chicken.\""
msgstr "「あはははは。それ、先月会長が潰したじゃん。<鳥|とり><愛|め>でてる暇があるなら彼女作れって」"

#. Occurrence 4_4:2961:3729: voice_id=G60_4_4_9000; voice_prefix=G60; voice_category=0; scene=4_4
#: 4_4:2961
msgctxt "text_id=3729 | speaker=unknown"
msgid "\"Hahaha. Find a girlfriend? ...S-Sorry, 'Zaki, I'm gonna cut out through the back exit.\""
msgstr "「あはは、は……彼女、作れです、か……すみませんっす、今日は裏口から帰るっす、ザキさん……」"

#. Occurrence 4_4:2971:3730: voice_id=F90_4_4_0003; voice_prefix=F90; voice_category=0; scene=4_4
#: 4_4:2971
msgctxt "text_id=3730 | speaker=unknown"
msgid "\"I gotta jet, too! Later, prez! See ya tomorrow!\""
msgstr "「クソ、じゃあなー会長ー！　また明日ー！」"

#. Occurrence 4_4:3007:3731: scene=4_4
#: 4_4:3007
msgctxt "text_id=3731 | speaker=unknown"
msgid "  And with those oh-so-charming remarks, the boys scattered with their tails between their legs."
msgstr "　愛らしい捨て台詞を残し、負け犬のようにハラハラと散っていく男子生徒たち。"

#. Occurrence 4_4:3040:3732: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0002; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:3040
msgctxt "text_id=3732 | speaker=alice"
msgid "\"You seem to be enjoying yourself, Aoko.\""
msgstr "「楽しそうね、青子」"

#. Occurrence 4_4:3056:3733: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0022; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3056
msgctxt "text_id=3733 | speaker=aoko"
msgid "\"How could you tell?\""
msgstr "「あ、わかる？」"

#. Occurrence 4_4:3061:3734: scene=4_4
#: 4_4:3061
msgctxt "text_id=3734 | speaker=unknown"
msgid "  Aoko's response slipped out all too easily."
msgstr "　有珠の一言に、つい即答する青子。"

#. Occurrence 4_4:3066:3735: scene=4_4
#: 4_4:3066
msgctxt "text_id=3735 | speaker=unknown"
msgid "  In truth, there were not that many bad apples at Misaki High, and dealing with them wasn't really that bad."
msgstr "　事実、三咲高校の生徒たちは嫌味のない人間ばかりで、彼らとのやりとりは愉快ではあるのだ。"

#. Occurrence 4_4:3096:3736: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0023; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3096
msgctxt "text_id=3736 | speaker=aoko"
msgid "\"...So?"
msgstr "「―――で。"

#. Occurrence 4_4:3117:3737: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0024; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3117
msgctxt "text_id=3737 | speaker=aoko"
msgid "  What brings you down here? Did you find something out?\""
msgstr "　ここまで出向くって事は、何か分かったの？」"

#. Occurrence 4_4:3123:3738: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0003; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:3123
msgctxt "text_id=3738 | speaker=alice"
msgid "\"I identified traces of the witness from within the field. All we need to do now is put a name to them.\""
msgstr "「結界に残っていた気配の識別は。あとはここで確かめればいいだけよ」"

#. Occurrence 4_4:3129:3739: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0025; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3129
msgctxt "text_id=3739 | speaker=aoko"
msgid "\"I see. ...Alice, how long have you been waiting here?\""
msgstr "「そう。ん……？　有珠、いつからここに？」"

#. Occurrence 4_4:3135:3740: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0004; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:3135
msgctxt "text_id=3740 | speaker=alice"
msgid "\"Since school was dismissed.\""
msgstr "「下校時刻から」"

#. Occurrence 4_4:3140:3741: scene=4_4
#: 4_4:3140
msgctxt "text_id=3741 | speaker=unknown"
msgid "  So she had been here for roughly an hour."
msgstr "　……という事はかれこれ一時間は経つ。"

#. Occurrence 4_4:3145:3742: scene=4_4
#: 4_4:3145
msgctxt "text_id=3742 | speaker=unknown"
msgid "  Standing in the same place for an hour would be taxing for someone as sensitive to the cold as Alice."
msgstr "　寒がりな彼女にとって、同じ場所に一時間も立つのは辛かっただろう。"

#. Occurrence 4_4:3175:3743: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0026; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3175
msgctxt "text_id=3743 | speaker=aoko"
msgid "\"I'm sorry. If you would have told me...\""
msgstr "「悪いわね、無理させて」"

#. Occurrence 4_4:3181:3744: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0005; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:3181
msgctxt "text_id=3744 | speaker=alice"
msgid "\"...Don't be. I'm just doing it because I wanted to.\""
msgstr "「……別に。好きでやってる事だから」"

#. Occurrence 4_4:3187:3745: scene=4_4
#: 4_4:3187
msgctxt "text_id=3745 | speaker=unknown"
msgid "  As she spoke, her black eyes were fixed upon the gate and the students passing through it."
msgstr "　言いながらも、彼女の黒い瞳は校門を通る生徒たちを見つめている。"

#. Occurrence 4_4:3192:3746: scene=4_4
#: 4_4:3192
msgctxt "text_id=3746 | speaker=unknown"
msgid "  She had likely been observing the gate in this manner for the past hour."
msgstr "　こうやって一時間ものあいだ、有珠は校門を監視していたのだろう。"

#. Occurrence 4_4:3213:3747: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0027; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3213
msgctxt "text_id=3747 | speaker=aoko"
msgid "\"You're weren't waiting for me, were you? ...Well I'm here now anyway so we can go.\""
msgstr "「私を待ってたワケじゃないんでしょ？　今からでも付き合うわ」"

#. Occurrence 4_4:3218:3748: scene=4_4
#: 4_4:3218
msgctxt "text_id=3748 | speaker=unknown"
msgid "  Alice nodded in assent."
msgstr "　こくん、と頷く有珠。"

#. Occurrence 4_4:3223:3749: scene=4_4
#: 4_4:3223
msgctxt "text_id=3749 | speaker=unknown"
msgid "  If Alice was still here, it meant she had not found the witness yet."
msgstr "　有珠が残っているのは、いまだ目撃者を発見できていないからだ。"

#. Occurrence 4_4:3228:3750: scene=4_4
#: 4_4:3228
msgctxt "text_id=3750 | speaker=unknown"
msgid "  If she had found this student, Alice would have already gone home ahead of Aoko and begun to research the student's background."
msgstr "　結界に残った気配に一致する生徒がいたのなら、有珠は青子を待たずに帰宅し、その生徒の素性を調べていただろう。"

#. Occurrence 4_4:3271:3751: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0028; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3271
msgctxt "text_id=3751 | speaker=aoko"
msgid "\"Nothing came up on my end.\""
msgstr "「私の方はダメだった」"

#. Occurrence 4_4:3277:3752: scene=4_4
#: 4_4:3277
msgctxt "text_id=3752 | speaker=unknown"
msgid "  She reported the results of Tobimaru's investigation. Alice remained silent."
msgstr "　鳶丸に調べさせた結果について、青子は結果だけを告げた。有珠に言葉はない。"

#. Occurrence 4_4:3282:3753: scene=4_4
#: 4_4:3282
msgctxt "text_id=3753 | speaker=unknown"
msgid "  With that the conversation ended, leaving the two to silently endure the freezing wind."
msgstr "　会話はそれで打ち止めになり、あとは冷たい風に耐えるだけである。"

#. Occurrence 4_4:3333:3754: scene=4_4
#: 4_4:3333
msgctxt "text_id=3754 | speaker=unknown"
msgid "  ...The silent stakeout dragged on endlessly."
msgstr "　……無言の監視はあてもなく続く。"

#. Occurrence 4_4:3338:3755: scene=4_4
#: 4_4:3338
msgctxt "text_id=3755 | speaker=unknown"
msgid "  Students continued to pass the gate, each shocked at the sight of the unusual combo, and head home."
msgstr "　校門に来た生徒たちは、生徒会長と礼園女学院の生徒という組み合わせに驚きつつ下校していく。"

#. Occurrence 4_4:3343:3756: scene=4_4
#: 4_4:3343
msgctxt "text_id=3756 | speaker=unknown"
msgid "  After twenty minutes Aoko let a sigh escape her mouth, perhaps from boredom, perhaps from the cold, or perhaps from both."
msgstr "　退屈さと冬の寒さも手伝ってか、二十分もすぎると青子はため息をついていた。"

#. Occurrence 4_4:3394:3757: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0029; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3394
msgctxt "text_id=3757 | speaker=aoko"
msgid "\"Hey, on our way home, do you want to drop by Dawn?\""
msgstr "「ね、有珠。帰り、<黎明|レイメイ>に寄ってかない？」"

#. Occurrence 4_4:3400:3758: scene=4_4
#: 4_4:3400
msgctxt "text_id=3758 | speaker=unknown"
msgid "  Aoko quickly turned to Alice to catch her reaction."
msgstr "　ちらり、と有珠の顔を覗きこむ青子。"

#. Occurrence 4_4:3405:3759: scene=4_4
#: 4_4:3405
msgctxt "text_id=3759 | speaker=unknown"
msgid "  Dawn was the name of one of Aoko's favorite coffee shops."
msgstr "　黎明は青子お気に入りの喫茶店の名前である。"

#. Occurrence 4_4:3442:3760: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0006; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:3442
msgctxt "text_id=3760 | speaker=alice"
msgid "\"...\""
msgstr "「……………………」"

#. Occurrence 4_4:3448:3761: scene=4_4
#: 4_4:3448
msgctxt "text_id=3761 | speaker=unknown"
msgid "  Offering no clear indication as to whether she was critical of Aoko's blasé attitude or agreeing to her whims, Alice's gaze shifted ever so slightly."
msgstr "　状況を理解していない青子への非難か、それともわりと同意なのか、有珠は微かに視線を動かした。"

#. Occurrence 4_4:3453:3762: scene=4_4
#: 4_4:3453
msgctxt "text_id=3762 | speaker=unknown"
msgid "  Aoko followed her stare..."
msgstr "　その視線の先には―――"

#. Occurrence 4_4:3492:3763: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0000; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:3492
msgctxt "text_id=3763 | speaker=soujuurou"
msgid "\"Hey, Aozaki. Are you meeting someone here, too?\""
msgstr "「あれ、蒼崎も待ち合わせか？」"

#. Occurrence 4_4:3498:3764: scene=4_4
#: 4_4:3498
msgctxt "text_id=3764 | speaker=unknown"
msgid "  The sudden voice took her off guard."
msgstr "　意識の隙を<衝|つ>くような、突然の声。"

#. Occurrence 4_4:3503:3765: scene=4_4
#: 4_4:3503
msgctxt "text_id=3765 | speaker=unknown"
msgid "  There was only one person who spoke with this gentle, good-natured tone."
msgstr "　自然な、刺のない口調が誰であるかは言うまでもない。"

#. Occurrence 4_4:3564:3766: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0030; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3564
msgctxt "text_id=3766 | speaker=aoko"
msgid "\"...Of course it'd be him.\""
msgstr "「―――そ。やっぱ、そうなるワケか」"

#. Occurrence 4_4:3570:3767: scene=4_4
#: 4_4:3570
msgctxt "text_id=3767 | speaker=unknown"
msgid "  Turning her back to Alice, Aoko moved her focus to the newly appeared student."
msgstr "　有珠に背中を向けて、青子はキッと、やってきた生徒を見据える。"

#. Occurrence 4_4:3620:3768: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0031; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3620
msgctxt "text_id=3768 | speaker=aoko"
msgid "\"Can I help you with something?\""
msgstr "「それで、今日は何の用？」"

#. Occurrence 4_4:3626:3769: scene=4_4
#: 4_4:3626
msgctxt "text_id=3769 | speaker=unknown"
msgid "  All politeness flew out the window."
msgstr "　こんにちはも何もない。"

#. Occurrence 4_4:3631:3770: scene=4_4
#: 4_4:3631
msgctxt "text_id=3770 | speaker=unknown"
msgid "  Already in a bad mood, Aoko's mood plummeted the longer she looked at Soujyuro."
msgstr "　不機嫌な青子の視線は、その険悪さをより増して草十郎に向けられる。"

#. Occurrence 4_4:3636:3771: scene=4_4
#: 4_4:3636
msgctxt "text_id=3771 | speaker=unknown"
msgid "  The subtlety of her expression, however, was lost on him."
msgstr "　が、そんな青子の眼力も草十郎には通じなかったようだ。"

#. Occurrence 4_4:3664:3772: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0001; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:3664
msgctxt "text_id=3772 | speaker=soujuurou"
msgid "\"No thanks, I was just on my way to the station to meet the swimming club captain, and I wanted to say thanks.\""
msgstr "「いや、これから駅前で水泳部の部長と待ち合わせなんだけど、その事でお礼を言っておきたくて」"

#. Occurrence 4_4:3688:3773: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0032; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3688
msgctxt "text_id=3773 | speaker=aoko"
msgid "\"Hmm?\""
msgstr "「？」"

#. Occurrence 4_4:3693:3774: scene=4_4
#: 4_4:3693
msgctxt "text_id=3774 | speaker=unknown"
msgid "  Well, that was completely unexpected."
msgstr "　それは、意外と言えば意外な一言だった筈だ。"

#. Occurrence 4_4:3698:3775: scene=4_4
#: 4_4:3698
msgctxt "text_id=3775 | speaker=unknown"
msgid "  Thanks... Joining a club..."
msgstr "　部活とお礼。"

#. Occurrence 4_4:3703:3776: scene=4_4
#: 4_4:3703
msgctxt "text_id=3776 | speaker=unknown"
msgid "  Aoko had a hunch that he was about to say something brainless."
msgstr "　……ただ、その組み合わせなら、この人物は間の抜けた事を言ってくるだろうと、青子は思ってもいた。なんの根拠もなかったけれど。"

#. Occurrence 4_4:3729:3777: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0033; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3729
msgctxt "text_id=3777 | speaker=aoko"
msgid "\"...And by 'thanks' you mean 'payback,' right?\""
msgstr "「……ふうん。お礼って、お礼参りってこと？」"

#. Occurrence 4_4:3735:3778: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0002; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:3735
msgctxt "text_id=3778 | speaker=soujuurou"
msgid "\"?\""
msgstr "「？」"

#. Occurrence 4_4:3740:3779: scene=4_4
#: 4_4:3740
msgctxt "text_id=3779 | speaker=unknown"
msgid "  Fortunately, Soujyuro was completely unaware of the more sinister implications to the word \"payback.\""
msgstr "　これまた幸運な事に、学生におけるお礼参りの意味も、草十郎はまだ知らずにいたらしい。"

#. Occurrence 4_4:3775:3780: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0003; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:3775
msgctxt "text_id=3780 | speaker=soujuurou"
msgid "\"I'm not sure what you mean by that, but it's no big deal."
msgstr "「よく分からないけど、そんな大した事じゃないよ。"

#. Occurrence 4_4:3781:3781: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0004; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:3781
msgctxt "text_id=3781 | speaker=soujuurou"
msgid "  It's just that the swimming club captain said that the club doesn't get that busy until summer.\""
msgstr "　ただ、水泳部は夏までそう忙しくないって話だったから」"

#. Occurrence 4_4:3787:3782: scene=4_4
#: 4_4:3787
msgctxt "text_id=3782 | speaker=unknown"
msgid "  Soujyuro was just about to thank her for recommending a club that would not take up much of his time, when Aoko cut him off with an expression of disinterest."
msgstr "　そういう部活を<薦|すす>めてくれたんだな、と草十郎は続けようとしたが、青子はつまらなそうな顔で遮った。"

#. Occurrence 4_4:3823:3783: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0034; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3823
msgctxt "text_id=3783 | speaker=aoko"
msgid "\"Well of course. I couldn't very well introduce you to a club that I knew you would never turn up to. All I did was mention some that even someone as busy as you could join.\""
msgstr "「当然でしょう。幽霊部員になりそうな生徒なんて、紹介できないから。忙しい貴方でも<勤|つと>まりそうな場所があったから、口に出しただけよ」"

#. Occurrence 4_4:3843:3784: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0005; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:3843
msgctxt "text_id=3784 | speaker=soujuurou"
msgid "\"I see. Very efficient.\""
msgstr "「なるほど、無駄がないね」"

#. Occurrence 4_4:3863:3785: scene=4_4
#: 4_4:3863
msgctxt "text_id=3785 | speaker=unknown"
msgid "  His open admiration for her sapped Aoko's will to fight."
msgstr "　感心する草十郎に、青子は文句を言う気も無くしてしまった。"

#. Occurrence 4_4:3868:3786: scene=4_4
#: 4_4:3868
msgctxt "text_id=3786 | speaker=unknown"
msgid "  Finding a suitable club and negotiating with its captain hadn't been an efficient use of her time at all."
msgstr "　彼女にとって、彼に似合った部活を探して部長に話をつけること自体が無駄な事だったのだが。"

#. Occurrence 4_4:3895:3787: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0006; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:3895
msgctxt "text_id=3787 | speaker=soujuurou"
msgid "\"Anyway, you really helped me out."
msgstr "「とにかく、お世話になったから。"

#. Occurrence 4_4:3895:3788: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0006; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:3895
msgctxt "text_id=3788 | speaker=soujuurou"
msgid "  I just wanted to say thanks.\""
msgstr "　それで礼を言っときたくて」"

#. Occurrence 4_4:3901:3789: scene=4_4
#: 4_4:3901
msgctxt "text_id=3789 | speaker=unknown"
msgid "  Soujyuro gratefully dipped his head, but not before the flustered Aoko stopped him."
msgstr "　ありがとう、と今にも頭を下げそうな草十郎を、あわてて青子は止める。"

#. Occurrence 4_4:3940:3790: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0035; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3940
msgctxt "text_id=3790 | speaker=aoko"
msgid "\"Gimme a break. You're just going to give me a headache if you do that."
msgstr "「よしてよ。いま貴方にそんな事されても迷惑だから。"

#. Occurrence 4_4:3946:3791: scene=4_4
#: 4_4:3946
msgctxt "text_id=3791 | speaker=unknown"
msgid "  ..."
msgstr "　……"

#. Occurrence 4_4:3958:3792: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0036; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3958
msgctxt "text_id=3792 | speaker=aoko"
msgid " So. How's the swimming club? Does it seem like a good fit?\""
msgstr "それで、水泳部はどう？　やっていけそう？」"

#. Occurrence 4_4:3984:3793: scene=4_4
#: 4_4:3984
msgctxt "text_id=3793 | speaker=unknown"
msgid "  An awkwardness infiltrated her previously sharp gaze."
msgstr "　鋭かった視線が、どこか気まずいものに変わる。"

#. Occurrence 4_4:3989:3794: scene=4_4
#: 4_4:3989
msgctxt "text_id=3794 | speaker=unknown"
msgid "  Soujyuro was able to pick up on the odd change in her behavior, but could not divine its reason."
msgstr "　青子の態度に違和感を覚える草十郎だったが、その理由までは分からない。"

#. Occurrence 4_4:3994:3795: scene=4_4
#: 4_4:3994
msgctxt "text_id=3795 | speaker=unknown"
msgid "  So he simply started with what he knew so far and reported the most recent information he had."
msgstr "　なので、とりあえず分かるところから、と最新のニュースを青子に告げた。"

#. Occurrence 4_4:4032:3796: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0007; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4032
msgctxt "text_id=3796 | speaker=soujuurou"
msgid "\"Oh, I got kicked out of the club already.\""
msgstr "「ああ、水泳部はクビになった」"

#. Occurrence 4_4:4055:3797: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0037; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4055
msgctxt "text_id=3797 | speaker=aoko"
msgid "\"W-"
msgstr "「な、"

msgctxt "text_id=3798 | speaker=unknown"
msgid " WHAT!? Why!?\""
msgstr "なんでよーーー！？」"

#. Occurrence 4_4:4071:3799: scene=4_4
#: 4_4:4071
msgctxt "text_id=3799 | speaker=unknown"
msgid "  Aoko instinctively shouted at the unexpected response."
msgstr "　予想外の返答に、思わず怒鳴る青子。"

#. Occurrence 4_4:4076:3800: scene=4_4
#: 4_4:4076
msgctxt "text_id=3800 | speaker=unknown"
msgid "  Like a human jack-in-the-box."
msgstr "　……びっくり箱の化身にも程がある。"

#. Occurrence 4_4:4081:3801: scene=4_4
#: 4_4:4081
msgctxt "text_id=3801 | speaker=unknown"
msgid "  This unexpected development threw her mind in a tizzy, and she momentarily forgot the complicated feelings she had been wrestling with."
msgstr "　あまりの展開に、青子の複雑にねじれていた心持ちが一瞬で真っ白になるぐらい。"

#. Occurrence 4_4:4108:3802: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0038; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4108
msgctxt "text_id=3802 | speaker=aoko"
msgid "\"B-B-But you just said that you were on your way to meet the captain!\""
msgstr "「だだ、だって、今から待ち合わせだって……！」"

#. Occurrence 4_4:4145:3803: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0008; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4145
msgctxt "text_id=3803 | speaker=soujuurou"
msgid "\"Yeah, the captain's taking me to a heated pool in Yashirogi.\""
msgstr "「それは、これから<社木|やしろぎ>の温水プールに連れていってくれるからだよ」"

#. Occurrence 4_4:4151:3804: scene=4_4
#: 4_4:4151
msgctxt "text_id=3804 | speaker=unknown"
msgid "  Soujyuro stated this very matter-of-factly to the still-reeling Aoko."
msgstr "　驚く青子に、うん、と告げる草十郎。"

#. Occurrence 4_4:4182:3805: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0039; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4182
msgctxt "text_id=3805 | speaker=aoko"
msgid "\"...I'm not following. Things seem to be going fine. Why would they kick you out!?\""
msgstr "「……話が繋がらない。そこまで上手くいってるのに、どうして入部を拒否されるのよ、アンタは！」"

#. Occurrence 4_4:4195:3806: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0009; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4195
msgctxt "text_id=3806 | speaker=soujuurou"
msgid "\"Oh, that's easy. Because I can't swim.\""
msgstr "「そりゃあ、俺が泳げないからだろ」"

#. Occurrence 4_4:4230:3807: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0040; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4230
msgctxt "text_id=3807 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 4_4:4235:3808: scene=4_4
#: 4_4:4235
msgctxt "text_id=3808 | speaker=unknown"
msgid "  Aoko reached up with her fingers and pinched the bridge of her nose as she processed his answer."
msgstr "　なるほど、そうきたか、と眉間を指で押さえる青子。"

#. Occurrence 4_4:4270:3809: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0041; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4270
msgctxt "text_id=3809 | speaker=aoko"
msgid "\"Sizuki, do you remember my question from yesterday? The one where I asked whether you preferred running or swimming?"
msgstr "「……静希君。昨日の私の質問は覚えてる？　走るのか泳ぐのか、どっちがいいかってヤツ。"

#. Occurrence 4_4:4276:3810: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0042; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4276
msgctxt "text_id=3810 | speaker=aoko"
msgid "  I'm confident that I remember your answer, but please repeat it to me."
msgstr "　私の記憶は正しいけど、いちおう確認しておくわね。"

#. Occurrence 4_4:4296:3811: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0043; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4296
msgctxt "text_id=3811 | speaker=aoko"
msgid "  You said you preferred 'swimming.' Right?\""
msgstr "　貴方、たしかに泳ぐ方だって言ったけど……？」"

#. Occurrence 4_4:4323:3812: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0010; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4323
msgctxt "text_id=3812 | speaker=soujuurou"
msgid "\"Yeah. Since I was little, I've always wanted to learn, and I'm already really good at running, so...\""
msgstr "「ああ。昔から、泳げないのはなんとか克服したかったんだ。反対に、走る方は得意だけど」"

#. Occurrence 4_4:4335:3813: scene=4_4
#: 4_4:4335
msgctxt "text_id=3813 | speaker=unknown"
msgid "  Her energy spent, Aoko finally understood."
msgstr "　あっそ、と答えて青子は力尽きた。"

#. Occurrence 4_4:4370:3814: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0011; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4370
msgctxt "text_id=3814 | speaker=soujuurou"
msgid "\"Apparently, they would have taken me in and trained me from square one if I were in my first year."
msgstr "「俺が一年なら一から鍛えてくれたらしいんだけど。"

#. Occurrence 4_4:4376:3815: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0012; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4376
msgctxt "text_id=3815 | speaker=soujuurou"
msgid "  Sadly, it sounds like they can't recruit a second-year like me who sinks like a rock, especially with only three months left in the school year."
msgstr "　あと三ヶ月で三年になる身分なのに、カナヅチの部員は雇えないそうだ。"

#. Occurrence 4_4:4387:3816: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0013; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4387
msgctxt "text_id=3816 | speaker=soujuurou"
msgid "  But the captain was really nice about it and even offered to teach me how to swim.\""
msgstr "　けど部長が親身になってくれて、これから泳ぎを教えてくれる事になったんだよ」"

#. Occurrence 4_4:4409:3817: scene=4_4
#: 4_4:4409
msgctxt "text_id=3817 | speaker=unknown"
msgid "  Soujyuro's words were spoken from a place of joy, a fact that failed to reach Aoko."
msgstr "　どこか嬉しそうに言う草十郎の言葉は、青子にはあまり届いていない。"

#. Occurrence 4_4:4448:3818: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0044_0; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4448
msgctxt "text_id=3818 | speaker=aoko"
msgid "(Hah... So in other words, I tried to palm off defective goods. I'll never be able to show my face to the swimming club captain again."
msgstr "『はあ……つまり、欠陥品を売り付けたってワケか……こりゃ水泳部の部長に合わす顔がない……っと、"

#. Occurrence 4_4:4460:3819: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0044_1; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4460
msgctxt "text_id=3819 | speaker=aoko"
msgid " Wait, but isn't the captain a...)"
msgstr "ちょっと待った』"

#. Occurrence 4_4:4472:3820: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0045; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4472
msgctxt "text_id=3820 | speaker=aoko"
msgid "\"Sizuki, the swimming club captain is...\""
msgstr "「静希君。水泳部の部長って……」"

#. Occurrence 4_4:4478:3821: scene=4_4
#: 4_4:4478
msgctxt "text_id=3821 | speaker=unknown"
msgid "  She stopped herself short of, \"a girl.\""
msgstr "　女子、と言いかけて止めた。"

#. Occurrence 4_4:4483:3822: scene=4_4
#: 4_4:4483
msgctxt "text_id=3822 | speaker=unknown"
msgid "  She was afraid of how that might look, that she might not be able to rein herself in if she started."
msgstr "　口にした途端、自分が変なことを口走りそうで怖くなったからだ。"

#. Occurrence 4_4:4509:3823: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0046; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4509
msgctxt "text_id=3823 | speaker=aoko"
msgid "\"...You know what? It doesn't matter. I understand now, so you can just go. Far, far from here, 'kay? I just can't deal with you right now.\""
msgstr "「……もういいわ。気持ちは分かったから、どこか遠くにいてくれない？　少し疲れてて、とてもじゃないけど貴方の相手はしていられないの」"

#. Occurrence 4_4:4532:3824: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0014; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4532
msgctxt "text_id=3824 | speaker=soujuurou"
msgid "\"Tobimaru said the same thing, come to think of it. He said that you were unusually tired yesterday and today. Did something happen?\""
msgstr "「鳶丸もそんな事を言ってたな。蒼崎は昨日と今日、めずらしく疲れてるって。何かあったのか？」"

#. Occurrence 4_4:4538:3825: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0047; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4538
msgctxt "text_id=3825 | speaker=aoko"
msgid "\"Kind of. But it's fine. It seems to have resolved itself."
msgstr "「ちょっとね。でもいいの。解決したみたいだから。"

#. Occurrence 4_4:4544:3826: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0048; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4544
msgctxt "text_id=3826 | speaker=aoko"
msgid "  Anyway... How do I look to you, Sizuki? Do I really look that exhausted?\""
msgstr "　それより……静希君はどう見える？　私、そんなに疲れて見えるのかな」"

#. Occurrence 4_4:4577:3827: scene=4_4
#: 4_4:4577
msgctxt "text_id=3827 | speaker=unknown"
msgid "  Why had she asked him this?"
msgstr "　何故そんな事を訊ねたのか。"

#. Occurrence 4_4:4583:3828: scene=4_4
#: 4_4:4583
msgctxt "text_id=3828 | speaker=unknown"
msgid "  Blurting out things for no reason and on impulse..."
msgstr "　青子にしては珍しい、"

msgctxt "text_id=3829 | speaker=unknown"
msgid "  This was not usual for Aoko."
msgstr "　理由のない、<惰性|だせい>で口から出た言葉だ。"

#. Occurrence 4_4:4591:3830: scene=4_4
#: 4_4:4591
msgctxt "text_id=3830 | speaker=unknown"
msgid "  Perhaps it was because she realized that this would be their last chance to have a normal conversation."
msgstr "　……あえて言うなら、これが最後だろうから、何かしらか普通の会話をしておこうと思ったのかもしれない。"

#. Occurrence 4_4:4623:3831: scene=4_4
#: 4_4:4623
msgctxt "text_id=3831 | speaker=unknown"
msgid "  After a few moments of contemplation, Soujyuro conjured up a grin that cut straight through the tension."
msgstr "　草十郎はしばし考えこんでから、そのぼんやりした雰囲気からかけ離れた笑顔を浮かべた。"

#. Occurrence 4_4:4649:3832: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0015; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4649
msgctxt "text_id=3832 | speaker=soujuurou"
msgid "\"Well, I would say you look more lively than you do tired. Like a wolf that's been forced to plow fields for a long time, but is excited to finally go on a hunt again.\""
msgstr "「そうだな、疲れているというより生き生きしているように見える。仕方なく畑をたがやしていた狼が、久しぶりに狩りにでる事になって<気炎|きえん>をあげている感じだ」"

#. Occurrence 4_4:4655:3833: scene=4_4
#: 4_4:4655
msgctxt "text_id=3833 | speaker=unknown"
msgid "  He seemed so cheerful."
msgstr "　めでたいな、と。"

#. Occurrence 4_4:4660:3834: scene=4_4
#: 4_4:4660
msgctxt "text_id=3834 | speaker=unknown"
msgid "  Like he was so happy for her."
msgstr "　まるで我が事のように、彼は微笑んだ。"

#. Occurrence 4_4:4693:3835: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0049; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4693
msgctxt "text_id=3835 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 4_4:4699:3836: scene=4_4
#: 4_4:4699
msgctxt "text_id=3836 | speaker=unknown"
msgid "  Without thinking, Aoko's hands went to her cheeks."
msgstr "　知れず、青子は頬に手を当てた。"

#. Occurrence 4_4:4704:3837: scene=4_4
#: 4_4:4704
msgctxt "text_id=3837 | speaker=unknown"
msgid "  If what he said were true, then she was grinning from ear to ear."
msgstr "　彼の言う事が本当なら、今の自分はこの上なく味のあるニヤけ顔をしている事になる。"

#. Occurrence 4_4:4709:3838: scene=4_4
#: 4_4:4709
msgctxt "text_id=3838 | speaker=unknown"
msgid "  There was just no way she would have made such a mistake."
msgstr "　当然、そんなヘマは犯していなかったが。"

#. Occurrence 4_4:4733:3839: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0016; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4733
msgctxt "text_id=3839 | speaker=soujuurou"
msgid "\"Anyway, thanks again! See you tomorrow.\""
msgstr "「とにかくありがとう。じゃあ、また明日」"

#. Occurrence 4_4:4739:3840: scene=4_4
#: 4_4:4739
msgctxt "text_id=3840 | speaker=unknown"
msgid "  Perhaps still not comfortable enough to wave to her, he said his goodbye with sincerity in his voice and smile, and took his leave."
msgstr "　まだ手を上げるほどの気楽さはないのか、草十郎は真摯な声と<表情|かお>だけで挨拶をして去ろうとする。"

#. Occurrence 4_4:4781:3841: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0050; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4781
msgctxt "text_id=3841 | speaker=aoko"
msgid "\"Wait. I have a question for you. Then you can go.\""
msgstr "「待って。こんな話があるの。聞いてから行って」"

#. Occurrence 4_4:4787:3842: scene=4_4
#: 4_4:4787
msgctxt "text_id=3842 | speaker=unknown"
msgid "  Aoko called out after him."
msgstr "　そんな草十郎を青子は呼び止めた。"

#. Occurrence 4_4:4792:3843: scene=4_4
#: 4_4:4792
msgctxt "text_id=3843 | speaker=unknown"
msgid "  Her voice was cold as she admonished herself for having been somewhat affable earlier."
msgstr "　温和になりかけていた自分を<戒|いまし>める、冷たい声で。"

#. Occurrence 4_4:4841:3844: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0017; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4841
msgctxt "text_id=3844 | speaker=soujuurou"
msgid "\"Yeah?\""
msgstr "「うん？」"

#. Occurrence 4_4:4847:3845: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0051; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4847
msgctxt "text_id=3845 | speaker=aoko"
msgid "\"This is just a hypothetical question."
msgstr "「意味のない<喩|たと>え話よ。"

#. Occurrence 4_4:4853:3846: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0052; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4853
msgctxt "text_id=3846 | speaker=aoko"
msgid "  Let's say you're on the brink of starvation and right in front of you are two animals, also starving."
msgstr "　……そうね。貴方が空腹で死にそうな時、目の前に、同じように空腹で死にそうな二匹の動物がいるとするわ。"

#. Occurrence 4_4:4859:3847: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0053; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4859
msgctxt "text_id=3847 | speaker=aoko"
msgid "  Someone gives you a gun and tells you to shoot one of them."
msgstr "　静希君に銃をあげる。それでどちらかの動物を撃って。"

#. Occurrence 4_4:4859:3848: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0053; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4859
msgctxt "text_id=3848 | speaker=aoko"
msgid "  The one on the right is a lion. The one on the left is a kitten. What do you do?\""
msgstr "　右はライオンで左は子猫。選ぶのは貴方の自由だから」"

#. Occurrence 4_4:4912:3849: scene=4_4
#: 4_4:4912
msgctxt "text_id=3849 | speaker=unknown"
msgid "  It was a fable-like moral dilemma,"
msgstr "　どことなく童話めいた質問。"

#. Occurrence 4_4:4917:3850: scene=4_4
#: 4_4:4917
msgctxt "text_id=3850 | speaker=unknown"
msgid "  especially the way in which it was cruel and rather preachy."
msgstr "　残酷さと教訓と、押しつけがましいところがとくに。"

#. Occurrence 4_4:4922:3851: scene=4_4
#: 4_4:4922
msgctxt "text_id=3851 | speaker=unknown"
msgid "  The kind that if you thought too hard about, you would never find an answer."
msgstr "　この手の話は考えこむときりがない。"

#. Occurrence 4_4:4927:3852: scene=4_4
#: 4_4:4927
msgctxt "text_id=3852 | speaker=unknown"
msgid "  Soujyuro answered quickly and calmly."
msgstr "　が、彼はあっさりと返答した。"

#. Occurrence 4_4:4964:3853: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0018; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4964
msgctxt "text_id=3853 | speaker=soujuurou"
msgid "\"I don't think I'd shoot at all. You asked me what I'd do, right? And, come on, all three of us are starving.\""
msgstr "「いや、撃たないと思うよ。だって、自分の好きにしていいんだろう？　それにほら、空腹ならお互い様だ」"

#. Occurrence 4_4:4970:3854: scene=4_4
#: 4_4:4970
msgctxt "text_id=3854 | speaker=unknown"
msgid "  He was not in the least fazed by the dilemma."
msgstr "　おそらくは悩む間もなかっただろう。"

#. Occurrence 4_4:4975:3855: scene=4_4
#: 4_4:4975
msgctxt "text_id=3855 | speaker=unknown"
msgid "  He gave the most innocent response. So innocent, in fact, that it would give anyone pause."
msgstr "　それは本当にどうかと思うぐらい、真っ白な解答だった。"

#. Occurrence 4_4:5008:3856: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0054; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5008
msgctxt "text_id=3856 | speaker=aoko"
msgid "\"...You're going to live a long life, Sizuki.\""
msgstr "「……長生きするわ、貴方」"

#. Occurrence 4_4:5026:3857: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0019; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:5026
msgctxt "text_id=3857 | speaker=soujuurou"
msgid "\"Whoa, you think so? I think that's the first time anyone has ever said that to me.\""
msgstr "「すごい台詞だな。そんなコトを言われたのは、たぶん君が初めてだ」"

#. Occurrence 4_4:5031:3858: scene=4_4
#: 4_4:5031
msgctxt "text_id=3858 | speaker=unknown"
msgid "  Adorning his face was a smile wholly out of sync with his comment."
msgstr "　笑顔には似つかわしくない台詞。"

#. Occurrence 4_4:5050:3859: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0055; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5050
msgctxt "text_id=3859 | speaker=aoko"
msgid "\"...What the heck is that supposed to mean?\""
msgstr "「――――――なによ、それ」"

#. Occurrence 4_4:5055:3860: scene=4_4
#: 4_4:5055
msgctxt "text_id=3860 | speaker=unknown"
msgid "  She regretted stopping him."
msgstr "　……呼び止めるべきではなかったと後悔する。"

#. Occurrence 4_4:5060:3861: scene=4_4
#: 4_4:5060
msgctxt "text_id=3861 | speaker=unknown"
msgid "  If only she had just watched him go, this conversation would have never happened."
msgstr "　あのまま見送っていれば、こんな答えを聞くこともなかったのに、と。"

#. Occurrence 4_4:5105:3862: scene=4_4
#: 4_4:5105
msgctxt "text_id=3862 | speaker=unknown"
msgid "  Soujyuro Sizuki made his way down the sloped street."
msgstr "　そして、静希草十郎はてくてくと坂道を下っていった。"

#. Occurrence 4_4:5110:3863: scene=4_4
#: 4_4:5110
msgctxt "text_id=3863 | speaker=unknown"
msgid "  Today, just like every day, he probably had to work late again."
msgstr "　今日も今日とて、夜遅くまでアルバイトでもあるのだろう。"

#. Occurrence 4_4:5115:3864: scene=4_4
#: 4_4:5115
msgctxt "text_id=3864 | speaker=unknown"
msgid "  Only Aoko and Alice remained, with Alice doing what she could to simply blend in."
msgstr "　残されたのは青子と、今まで背景と化していた有珠だけである。"

#. Occurrence 4_4:5149:3865: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0056; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5149
msgctxt "text_id=3865 | speaker=aoko"
msgid "\"That harmless hick really throws me for a loop.\""
msgstr "「つくづく……こっちのペースを乱してくれるわね、あの人畜無害な田舎者は」"

#. Occurrence 4_4:5155:3866: scene=4_4
#: 4_4:5155
msgctxt "text_id=3866 | speaker=unknown"
msgid "  Aoko clenched her right fist tightly as she cursed out loud."
msgstr "　ぐっと右手を強く握り締めて、青子は独白する。"

#. Occurrence 4_4:5160:3867: scene=4_4
#: 4_4:5160
msgctxt "text_id=3867 | speaker=unknown"
msgid "  Anything to prevent herself from screaming at the top of her lungs."
msgstr "　どこでもいいから体に力を入れておかないと、ここで意味不明の大声を上げかねなかった。"

#. Occurrence 4_4:5165:3868: scene=4_4
#: 4_4:5165
msgctxt "text_id=3868 | speaker=unknown"
msgid "  ...Whether that scream would be directed toward Soujyuro or toward herself was another matter entirely."
msgstr "　……それが相手への罵倒なのか、自分への罵倒なのかは、口にしないと分からない。"

#. Occurrence 4_4:5196:3869: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0007; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:5196
msgctxt "text_id=3869 | speaker=alice"
msgid "\"Aoko.\""
msgstr "「青子」"

#. Occurrence 4_4:5202:3870: scene=4_4
#: 4_4:5202
msgctxt "text_id=3870 | speaker=unknown"
msgid "  Aoko heard Alice's soft voice behind her. Aoko knew what she was going to say, as she had known for the entire time."
msgstr "　後ろから有珠の細い声が聞こえる。彼女が何を言おうとしているかは、ちょっと前から分かっている。"

#. Occurrence 4_4:5207:3871: scene=4_4
#: 4_4:5207
msgctxt "text_id=3871 | speaker=unknown"
msgid "  Ever since Alice, having shown no reaction to any of the other students, changed her expression upon seeing Soujyuro."
msgstr "　……今までどんな生徒にも無反応だった彼女が、草十郎の出現で表情を変えた時から。"

#. Occurrence 4_4:5243:3872: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0057; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5243
msgctxt "text_id=3872 | speaker=aoko"
msgid "\"You don't need to say it. It's him, right? The witness.\""
msgstr "「言わなくてもいい。あいつでしょ、目撃者は」"

#. Occurrence 4_4:5249:3873: scene=4_4
#: 4_4:5249
msgctxt "text_id=3873 | speaker=unknown"
msgid "  Her voice was cold as ice."
msgstr "　それは冷めきった、"

#. Occurrence 4_4:5249:3874: scene=4_4
#: 4_4:5249
msgctxt "text_id=3874 | speaker=unknown"
msgid "  It was the voice of someone talking about a complete stranger."
msgstr "　知らない人間の事を口にする声だった。"

#. Occurrence 4_4:5308:3875: scene=4_4
#: 4_4:5308
msgctxt "text_id=3875 | speaker=unknown"
msgid "  ...The lion and the kitten."
msgstr "　―――ライオンと猫。"

#. Occurrence 4_4:5313:3876: scene=4_4
#: 4_4:5313
msgctxt "text_id=3876 | speaker=unknown"
msgid "  There were pros and cons to choosing either of these animals, the point being that she had asked him to choose one of them."
msgstr "　それぞれ長所短所のある、結局のところ、自分とは違う生き物を選べと彼女は言った。"

#. Occurrence 4_4:5333:3877: scene=4_4
#: 4_4:5333
msgctxt "text_id=3877 | speaker=unknown"
msgid "  In terms of risk, the lion was the more dangerous choice. The instant the gun was pointed at it there was the chance it would fight back."
msgstr "　リスクでいうのならライオンの方が大きい。銃口を向けた瞬間、最後の反撃をする可能性もある。"

#. Occurrence 4_4:5338:3878: scene=4_4
#: 4_4:5338
msgctxt "text_id=3878 | speaker=unknown"
msgid "  Those who chose the lion required more courage, but any sense of guilt that came with holding a gun would be forgotten."
msgstr "　だから、ライオンを狙う方が勇気はいるけれど、同時に銃を持つという後ろめたさはなくなっている。"

#. Occurrence 4_4:5343:3879: scene=4_4
#: 4_4:5343
msgctxt "text_id=3879 | speaker=unknown"
msgid "  Lions were fierce creatures―a poor excuse to shoot an animal, perhaps, but one that certainly helped alleviate the guilt."
msgstr "　なにしろ相手は強い生き物だ。人間側の勝手な言い訳であれ、銃を使うことへの罪悪感は薄れてくれる。"

#. Occurrence 4_4:5363:3880: scene=4_4
#: 4_4:5363
msgctxt "text_id=3880 | speaker=unknown"
msgid "  But what about the kitten―the weaker creature?"
msgstr "　では、猫はどうだろう。弱い生き物。"

#. Occurrence 4_4:5368:3881: scene=4_4
#: 4_4:5368
msgctxt "text_id=3881 | speaker=unknown"
msgid "  It goes without saying that the kitten would be the easier target of the two, but choosing it would be a disquieting decision for anyone."
msgstr "　言うまでもなくライオンを狙うより簡単だ。けれど、誰だって不快な気持ちになる。"

#. Occurrence 4_4:5373:3882: scene=4_4
#: 4_4:5373
msgctxt "text_id=3882 | speaker=unknown"
msgid "  Even if the kitten had no chance to survive, it was still too senseless to carry out."
msgstr "　初めから対等でないとしても、その理不尽さはあまりにも度が過ぎている。"

#. Occurrence 4_4:5378:3883: scene=4_4
#: 4_4:5378
msgctxt "text_id=3883 | speaker=unknown"
msgid "  And to Aoko, Soujyuro was that choice."
msgstr "　青子にとって、草十郎はその“理不尽さ”に該当するものだった。"

#. Occurrence 4_4:5442:3884: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0058; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5442
msgctxt "text_id=3884 | speaker=aoko"
msgid "(...I knew it was him, too.)"
msgstr "『……てっきり、私もそうだと思ってた……』"

#. Occurrence 4_4:5448:3885: scene=4_4
#: 4_4:5448
msgctxt "text_id=3885 | speaker=unknown"
msgid "  When she had felt that sinking feeling in the student council room, she ignored it; there was no getting around what must be done, she told herself."
msgstr "　生徒会室でもしもと危惧した時は、そうであっても仕方がない、と思いきった。"

#. Occurrence 4_4:5454:3886: scene=4_4
#: 4_4:5454
msgctxt "text_id=3886 | speaker=unknown"
msgid "Until, that is, Soujyuro went and said what he did, causing her resolve to waver."
msgstr "けれど去りぎわの草十郎の言葉で、その決心が揺らいでいる。"

#. Occurrence 4_4:5474:3887: scene=4_4
#: 4_4:5474
msgctxt "text_id=3887 | speaker=unknown"
msgid "  But the discomfort in her chest did not stem from any guilt she may have felt."
msgstr "　この胸の不快さは、後ろめたさだけの<躊躇|とまど>いではない。"

#. Occurrence 4_4:5480:3888: scene=4_4
#: 4_4:5480
msgctxt "text_id=3888 | speaker=unknown"
msgid "  She could care less for Soujyuro; he was weak, and would be incredibly easy to deal with."
msgstr "　静希草十郎は気に入らない人間であり、弱い相手であり、誰よりも御しやすい相手だ。"

#. Occurrence 4_4:5485:3889: scene=4_4
#: 4_4:5485
msgctxt "text_id=3889 | speaker=unknown"
msgid "  Yet, for some reason she could not dispel her reservations."
msgstr "　なのになぜ、自分は躊躇いを覚えるのか。"

#. Occurrence 4_4:5526:3890: scene=4_4
#: 4_4:5526
msgctxt "text_id=3890 | speaker=unknown"
msgid "  A transfer student who moved to the city from the middle of nowhere, with no family to speak of..."
msgstr "　田舎から上京してきて身寄りもない転入生。"

#. Occurrence 4_4:5531:3891: scene=4_4
#: 4_4:5531
msgctxt "text_id=3891 | speaker=unknown"
msgid "  Few would notice if he were to suddenly disappear compared to a person of some renown. "
msgstr "　他のまっとうな人間と違って、ここで消えたところで騒ぎだす人間も少ない。"

#. Occurrence 4_4:5536:3892: scene=4_4
#: 4_4:5536
msgctxt "text_id=3892 | speaker=unknown"
msgid "  If she were to kill him, it would be as simple as wringing a cat's neck."
msgstr "　殺すなら、それこそ猫の首をひねるように仕留められる。"

#. Occurrence 4_4:5541:3893: scene=4_4
#: 4_4:5541
msgctxt "text_id=3893 | speaker=unknown"
msgid "  And it all served to just piss her off."
msgstr "　……ほんと、いい事ずくめで頭にくる。"

#. Occurrence 4_4:5546:3894: scene=4_4
#: 4_4:5546
msgctxt "text_id=3894 | speaker=unknown"
msgid "  It was too lucky. Like everything was neatly handed to her. She wanted to just dropkick it right into orbit."
msgstr "　なんて<幸運|ラッキー>。その尻をつま先で蹴り飛ばしてムチャクチャにしたいぐらい、正直、余計なお世話と苛々する―――"

#. Occurrence 4_4:5604:3895: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0059; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5604
msgctxt "text_id=3895 | speaker=aoko"
msgid "\"I can't believe it. I hate it. This isn't how it's supposed to be."
msgstr "「……信じられない。私、嫌がってる。これは違う。"

#. Occurrence 4_4:5610:3896: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0060; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5610
msgctxt "text_id=3896 | speaker=aoko"
msgid "  ...Why am I like this?\""
msgstr "　―――こんなの、私じゃない」"

#. Occurrence 4_4:5616:3897: scene=4_4
#: 4_4:5616
msgctxt "text_id=3897 | speaker=unknown"
msgid "  Standing behind her, Alice heard all of the muttering."
msgstr "　呟きは背後の有珠にも聞こえていたかも知れない。"

#. Occurrence 4_4:5621:3898: scene=4_4
#: 4_4:5621
msgctxt "text_id=3898 | speaker=unknown"
msgid "  Nevertheless, she seemed ignore it and said,"
msgstr "　しかし、有珠は相棒の<癇癪|かんしゃく>など気にもせず、"

#. Occurrence 4_4:5660:3899: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0008; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:5660
msgctxt "text_id=3899 | speaker=alice"
msgid "\"He had something wrapped around his neck.\""
msgstr "「彼、首に布を巻いていたわね」"

#. Occurrence 4_4:5666:3900: scene=4_4
#: 4_4:5666
msgctxt "text_id=3900 | speaker=unknown"
msgid "  A wholly unrelated topic."
msgstr "　などと、まったく関係のない感想を口にした。"

#. Occurrence 4_4:5692:3901: scene=4_4
#: 4_4:5692
msgctxt "text_id=3901 | speaker=unknown"
msgid "  Aoko returned to her senses."
msgstr "　有珠の言葉に青子はハッと我に返る。"

#. Occurrence 4_4:5698:3902: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0061; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5698
msgctxt "text_id=3902 | speaker=aoko"
msgid "\"...His neck?\""
msgstr "「くび……？」"

#. Occurrence 4_4:5709:3903: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0009; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:5709
msgctxt "text_id=3903 | speaker=alice"
msgid "\"...Yes. I wonder if it had something to do with being rejected by the swimming club.\""
msgstr "「……ええ。水泳部のクビとかけていたのかしら」"

#. Occurrence 4_4:5714:3904: scene=4_4
#: 4_4:5714
msgctxt "text_id=3904 | speaker=unknown"
msgid "  Alice had put much thought into this, as if it had a deeper meaning to her somehow."
msgstr "　ほとんど独り言の、心底から考えている有珠だった。"

#. Occurrence 4_4:5753:3905: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0062; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5753
msgctxt "text_id=3905 | speaker=aoko"
msgid "\"Now that you mention it... I saw him wearing the same thing the first time we met. I must have missed it because he always has his collar done up.\""
msgstr "「そういえば……あいつ、初めて会った時も首に布巻いてたっけ。<衿|えり>を行儀よく締めてるから目立たないけど」"

#. Occurrence 4_4:5759:3906: scene=4_4
#: 4_4:5759
msgctxt "text_id=3906 | speaker=unknown"
msgid "  The conversation turned to idle nonsense. "
msgstr "　重要性のない、意味のない会話。"

#. Occurrence 4_4:5764:3907: scene=4_4
#: 4_4:5764
msgctxt "text_id=3907 | speaker=unknown"
msgid "  And though it solved none of her current problems, it did help calm Aoko's frazzled nerves."
msgstr "　何ら解決を生むものではなかったけれど、ぐらぐらと揺れていた青子の思考は、それできっかり落ち着いてくれた。"

#. Occurrence 4_4:5790:3908: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0063; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5790
msgctxt "text_id=3908 | speaker=aoko"
msgid "\"...Thanks, Alice. I'm good."
msgstr "「……サンキュ、落ち着いたわ有珠。"

#. Occurrence 4_4:5801:3909: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0064; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5801
msgctxt "text_id=3909 | speaker=aoko"
msgid "  I'm ready to go."
msgstr "　それと気合いも入った。"

#. Occurrence 4_4:5807:3910: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0065; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5807
msgctxt "text_id=3910 | speaker=aoko"
msgid "  Let's strike while the iron's hot and end this before he spreads any rumors.\""
msgstr "　善は急げ、あいつが言い触らす前に決着をつけよう」"

#. Occurrence 4_4:5827:3911: scene=4_4
#: 4_4:5827
msgctxt "text_id=3911 | speaker=unknown"
msgid "  Pumped once more, Aoko turned her back to the school gate."
msgstr "　よし、とばかりに青子は校門に背を向ける。"

#. Occurrence 4_4:5832:3912: scene=4_4
#: 4_4:5832
msgctxt "text_id=3912 | speaker=unknown"
msgid "  For now, they would retire to the mansion and prepare for battle."
msgstr "　とりあえず、洋館に戻って戦闘準備をしなくてはならない。"

#. Occurrence 4_4:5908:3913: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0010; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:5908
msgctxt "text_id=3913 | speaker=alice"
msgid "\"...Sure, but when and where do you plan to kill him?\""
msgstr "「……いいけど、いつ、どこで彼を殺すの？」"

#. Occurrence 4_4:5921:3914: scene=4_4
#: 4_4:5921
msgctxt "text_id=3914 | speaker=unknown"
msgid "  She said quietly so as not to be overheard by anyone else."
msgstr "　……小さい声だが公衆の面前で口にする言葉ではない。"

#. Occurrence 4_4:5926:3915: scene=4_4
#: 4_4:5926
msgctxt "text_id=3915 | speaker=unknown"
msgid "  Normally, Aoko had to rein in that side of Alice, out in the open as they were. But this was far from a normal situation."
msgstr "　有珠のこういった物騒さをたしなめるのは青子の役割だが、物騒さで言えば今の彼女も大差はないらしい。"

#. Occurrence 4_4:5969:3916: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0066; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5969
msgctxt "text_id=3916 | speaker=aoko"
msgid "\"Tonight. As for the place... We shall meet him in the land of dreams.\""
msgstr "「今日の夜。場所はとっておきの夢の国よ」"

#. Occurrence 4_4:5975:3917: scene=4_4
#: 4_4:5975
msgctxt "text_id=3917 | speaker=unknown"
msgid "  She gave a fearless laugh."
msgstr "　有珠を<咎|とが>めもせず、クスリと不敵な笑みを浮かべる青子。"

#. Occurrence 4_4:5981:3918: scene=4_4
#: 4_4:5981
msgctxt "text_id=3918 | speaker=unknown"
msgid "  A strangely pleasant sound, like the kind one would make when meeting their lover."
msgstr "　それは恋人と待ち合わせる時のような、不思議と<爽|さわ>やかな響きだった。"

#. Occurrence 5A_1:70:3919: scene=5A_1
#: 5A_1:70
msgctxt "text_id=3919 | speaker=unknown"
msgid "  Soujyuro returned to his apartment on foot as per routine, under a blanket of clouds in the night sky."
msgstr "　雲のかかった夜空の下、草十郎はあいかわらずの徒歩でアパートに帰ってきた。"

#. Occurrence 5A_1:90:3920: scene=5A_1
#: 5A_1:90
msgctxt "text_id=3920 | speaker=unknown"
msgid "  The rusty stairs of his apartment building clanged with each step."
msgstr "　カンカンカン、と<錆|さ>びた金属音を踏みながら階段を上っていく。"

#. Occurrence 5A_1:95:3921: scene=5A_1
#: 5A_1:95
msgctxt "text_id=3921 | speaker=unknown"
msgid "  Out of the corner of his eye, he could see the bicycles parked by the apartment building's outer wall."
msgstr "　アパートの塀に置かれた自転車をチラリと見て、"

#. Occurrence 5A_1:100:3922: scene=5A_1
#: 5A_1:100
msgctxt "text_id=3922 | speaker=unknown"
msgid "  He debated the pros and cons of a bicycle―how much easier life would be versus the expense, the convenience versus the necessity―but in the end, decided one was not right for him just now."
msgstr "　自分も自転車があれば楽なのだろうか、でも余分な出費だし、あれば便利だけど無くて死ぬようなものじゃなし、もう少し我慢しよう、などと真剣に悩んでみる。"

#. Occurrence 5A_1:146:3923: scene=5A_1
#: 5A_1:146
msgctxt "text_id=3923 | speaker=unknown"
msgid "  Clutching the bag of apples under his arm, he took out the key to his residence."
msgstr "　ドアに到着して、リンゴのつまった紙袋を抱えたまま鍵を取り出す。"

#. Occurrence 5A_1:153:3924: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_1_0000; voice_prefix=A30; voice_category=3; scene=5A_1
#: 5A_1:153
msgctxt "text_id=3924 | speaker=soujuurou"
msgid "          \"A bike sure would be convenient, but it's not like...\""
msgstr "　　　　　“あれば便利だけど無くて―――”"

#. Occurrence 5A_1:159:3925: scene=5A_1
#: 5A_1:159
msgctxt "text_id=3925 | speaker=unknown"
msgid "  He tilted his head in confusion."
msgstr "　ん？と首をかしげる。"

#. Occurrence 5A_1:164:3926: scene=5A_1
#: 5A_1:164
msgctxt "text_id=3926 | speaker=unknown"
msgid "  More and more he found himself preoccupied with such random thoughts, when the real issue at hand was deciding what to do with the apples he had received."
msgstr "　<益体|やくたい>も無い自分の言葉にひっかかるものを感じた草十郎だったが、もらい物の<果物|リンゴ>をどうさばくかでいっぱいだったコトもあり、あっけなくスルーした。"

#. Occurrence 5A_1:231:3927: scene=5A_1
#: 5A_1:231
msgctxt "text_id=3927 | speaker=unknown"
msgid "  He placed the paper bag by the sink and switched on the lights."
msgstr "　紙袋を流し場に置いて、部屋の電気をつける。"

#. Occurrence 5A_1:236:3928: scene=5A_1
#: 5A_1:236
msgctxt "text_id=3928 | speaker=unknown"
msgid "  It was just after ten in the evening."
msgstr "　時刻は午後十時過ぎ。"

#. Occurrence 5A_1:241:3929: scene=5A_1
#: 5A_1:241
msgctxt "text_id=3929 | speaker=unknown"
msgid "  With the end-of-term exams just around the corner, he had come home an hour earlier than usual."
msgstr "　試験前なのでいつもより一時間早い帰宅。"

#. Occurrence 5A_1:257:3930: scene=5A_1
#: 5A_1:257
msgctxt "text_id=3930 | speaker=unknown"
msgid "  As he made back for the kitchen to pick one of the apples to snack on, he found an envelope stuffed in his mail slot."
msgstr "　とりあえずリンゴをひとつ食べてみるか、と台所を振り返ると、新聞受けに差しこまれた封筒に気が付いた。"

#. Occurrence 5A_1:284:3931: scene=5A_1
#: 5A_1:284
msgctxt "text_id=3931 | speaker=unknown"
msgid "  The envelope had no name, return address, or stamp."
msgstr "　差出人の明記はなく、切手すら貼っていない。"

#. Occurrence 5A_1:289:3932: scene=5A_1
#: 5A_1:289
msgctxt "text_id=3932 | speaker=unknown"
msgid "  Inside was a single piece of paper that had only the sender's name and a short message."
msgstr "　中には一枚の手紙が入っていて、用件と差出人の名前だけが書かれていた。"

#. Occurrence 5A_1:327:3933: scene=5A_1
#: 5A_1:327
msgctxt "text_id=3933 | speaker=unknown"
msgid "  It read:"
msgstr "　内容はいたってシンプルで、"

#. Occurrence 5A_1:334:3934: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_1_0000; voice_prefix=A10; voice_category=1; scene=5A_1
#: 5A_1:334
msgctxt "text_id=3934 | speaker=aoko"
msgid "\"There is something we need to talk about tonight."
msgstr "『話があるので今夜どこそこのここに来られたし、"

#. Occurrence 5A_1:334:3935: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_1_0000; voice_prefix=A10; voice_category=1; scene=5A_1
#: 5A_1:334
msgctxt "text_id=3935 | speaker=aoko"
msgid "  It's important, so I'll be waiting."
msgstr "　大事な用なので来るまでずっと待っている、"

#. Occurrence 5A_1:334:3936: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_1_0000; voice_prefix=A10; voice_category=1; scene=5A_1
#: 5A_1:334
msgctxt "text_id=3936 | speaker=aoko"
msgid "  Needless to say, keep this a secret.\""
msgstr "　言うまでもなく他言無用―――』"

#. Occurrence 5A_1:340:3937: scene=5A_1
#: 5A_1:340
msgctxt "text_id=3937 | speaker=unknown"
msgid "  A concise set of orders, neatly written."
msgstr "　という<旨|むね>が、簡潔、かつ凛々しい文字で<綴|つづ>られていた。"

#. Occurrence 5A_1:360:3938: scene=5A_1
#: 5A_1:360
msgctxt "text_id=3938 | speaker=unknown"
msgid "  It was signed Aoko Aozaki."
msgstr "　差出人の名前は蒼崎青子とある。"

#. Occurrence 5A_1:365:3939: scene=5A_1
#: 5A_1:365
msgctxt "text_id=3939 | speaker=unknown"
msgid "  She had been considerate enough to enclose a detailed map of the meeting place."
msgstr "　丁寧な事に、待ちあわせ場所の詳細な地図まで同封されていた。"

#. Occurrence 5A_1:370:3940: scene=5A_1
#: 5A_1:370
msgctxt "text_id=3940 | speaker=unknown"
msgid "  Puzzled, he cocked his head to the side then headed out the door."
msgstr "　ふむ、と少しだけ首をかしげて、彼はアパートを後にした。"

#. Occurrence 5A_1:428:3941: scene=5A_1
#: 5A_1:428
msgctxt "text_id=3941 | speaker=unknown"
msgid "  Afterward..."
msgstr "　……その後。"

#. Occurrence 5A_1:435:3942: scene=5A_1
#: 5A_1:435
msgctxt "text_id=3942 | speaker=unknown"
msgid "  Upon the room's sole tenant leaving the premises, the envelope burst into flames and evaporated without a trace, as though it had never existed in the first place."
msgstr "　主人のいなくなった部屋で残された封筒はひとりでに燃えだし、はじめから何も無かったかのように、跡形もなく消滅した。"

#. Occurrence 5A_1:499:3943: scene=5A_1
#: 5A_1:499
msgctxt "text_id=3943 | speaker=unknown"
msgid "  By the late '80s, Japan's postwar economic boom had somewhat stabilized and the city experienced a period of steady growth."
msgstr "　高度成長期もひとまずの落ち着きを見せ、安定期に入った８０年代後半。"

#. Occurrence 5A_1:504:3944: scene=5A_1
#: 5A_1:504
msgctxt "text_id=3944 | speaker=unknown"
msgid "  The city's modernization marched on, and the Japan Railways train station, a symbol of the new era, neared completion."
msgstr "　街の近代化は着々と進み、新時代を代表するＪＲの駅が落成しようとしていた頃。"

#. Occurrence 5A_1:510:3945: scene=5A_1
#: 5A_1:510
msgctxt "text_id=3945 | speaker=unknown"
msgid "  In Misaki's neighboring town of Yashirogi, a new symbol of its own was about to be born."
msgstr "　三咲町の隣町である<社木|やしろぎ>に、またひとつ、町の新しいシンボルが生まれようとしていた。"

#. Occurrence 5A_1:564:3946: scene=5A_1
#: 5A_1:564
msgctxt "text_id=3946 | speaker=unknown"
msgid "  Yashirogi Bread & Kitsy Land."
msgstr "　その名はやしろぎブレッド＆キッツィーランド。"

#. Occurrence 5A_1:570:3947: scene=5A_1
#: 5A_1:570
msgctxt "text_id=3947 | speaker=unknown"
msgid "  It was Misaki's worst investment."
msgstr "　三咲市最大の不良債権。"

#. Occurrence 5A_1:575:3948: scene=5A_1
#: 5A_1:575
msgctxt "text_id=3948 | speaker=unknown"
msgid "  Years later, it would be dubbed the fool's gold of the economic bubble, a relic of a bygone age."
msgstr "　<後|のち>にバブルのあだ花と言われる、一つの時代の残骸である。"

#. Occurrence 5A_1:597:3949: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_5A_1_0000; voice_prefix=B90; voice_category=14; scene=5A_1
#: 5A_1:597
msgctxt "text_id=3949 | speaker=yurihiko"
msgid "\"This city lacks aspiration and sophistication.\""
msgstr "“この町には<夢|ゆめ>とか<洒脱|しゃだつ>さが足りない”"

#. Occurrence 5A_1:603:3950: scene=5A_1
#: 5A_1:603
msgctxt "text_id=3950 | speaker=unknown"
msgid "  Ten years ago..."
msgstr "　今をさかのぼること十年前。"

#. Occurrence 5A_1:608:3951: scene=5A_1
#: 5A_1:608
msgctxt "text_id=3951 | speaker=unknown"
msgid "  Yashirogi's renowned Tokitsu Baking Company ran factories all across the nation. Its proprietor was a middle-aged gentleman (then age fifty-six) by the name of Yurihiko Tokitsu, known affectionately by most as Toppan. He took it upon himself to begin development on an estate on the outskirts of Yashirogi and broke ground on a recreational wonderland that he hoped to be the pride of Misaki City."
msgstr "　社木の名士であり、全国に多くの工場をかまえる<土桔|ときつ>製パン株式会社―――通称トッパンの経営者・<土桔|トキツ><由里彦|ユリヒコ>翁（当時五十六歳）はそんな使命感を合い言葉に、所有地であった社木郊外の土地を開放、三咲市を代表するレジャーランドの建築に着手した。"

#. Occurrence 5A_1:628:3952: scene=5A_1
#: 5A_1:628
msgctxt "text_id=3952 | speaker=unknown"
msgid "  The long-awaited opening came in 1981."
msgstr "　こうして運命の１９８１年。"

#. Occurrence 5A_1:633:3953: scene=5A_1
#: 5A_1:633
msgctxt "text_id=3953 | speaker=unknown"
msgid "  After three years of investment, this local amusement park, full of all kinds of hopes and dreams, began its short-lived tenure."
msgstr "　完成までに三年の月日を費やし、夢とユーモアあふれる地域密着型遊園地・やしろぎブレッド＆キッツィーランドはその短い人生をスタートさせた。"

#. Occurrence 5A_1:653:3954: scene=5A_1
#: 5A_1:653
msgctxt "text_id=3954 | speaker=unknown"
msgid "  It covered more than eighty-five square acres."
msgstr "　敷地面積三十五万㎡。"

#. Occurrence 5A_1:660:3955: scene=5A_1
#: 5A_1:660
msgctxt "text_id=3955 | speaker=unknown"
msgid "  Its magnificent merry-go-round dazzled all who passed through the park's gates."
msgstr "　<入り口|ゲート>をくぐった人々の目を奪う豪華絢爛なメリーゴーラウンド。"

#. Occurrence 5A_1:665:3956: scene=5A_1
#: 5A_1:665
msgctxt "text_id=3956 | speaker=unknown"
msgid "  Its roller coaster twisted and turned about the edges of the park like a writhing Japanese dragon."
msgstr "　のたうつ龍のように遊園地をぐるりと囲むコースター。"

#. Occurrence 5A_1:674:3957: scene=5A_1
#: 5A_1:674
msgctxt "text_id=3957 | speaker=unknown"
msgid "  Its Ferris wheel, packed beyond necessity with gimmicks, was said to have tested the limits of modern engineering."
msgstr "　当時の建築技術の限界に挑んだといわれる、無駄にギミック満載な観覧車。"

#. Occurrence 5A_1:695:3958: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_5A_1_0001; voice_prefix=B90; voice_category=14; scene=5A_1
#: 5A_1:695
msgctxt "text_id=3958 | speaker=yurihiko"
msgid "\"It's perfect, infused with everything an amusement park could ever need.\""
msgstr "“完璧だ。遊園地に必要なものはすべてつぎこんだ”"

#. Occurrence 5A_1:703:3959: scene=5A_1
#: 5A_1:703
msgctxt "text_id=3959 | speaker=unknown"
msgid "  Old Yurihiko looked upon his creation and smiled."
msgstr "　自らの仕事っぷりに目を細める由里彦翁。"

#. Occurrence 5A_1:708:3960: scene=5A_1
#: 5A_1:708
msgctxt "text_id=3960 | speaker=unknown"
msgid "  Only boosting his confidence was the fact that its grand opening was staged during a period of prosperity, the springtime of the world."
msgstr "　その自信を裏付けるように、開園当時の盛況はこの世の春だったという。"

#. Occurrence 5A_1:713:3961: scene=5A_1
#: 5A_1:713
msgctxt "text_id=3961 | speaker=unknown"
msgid "  But..."
msgstr "　だが。"

#. Occurrence 5A_1:748:3962: scene=5A_1
#: 5A_1:748
msgctxt "text_id=3962 | speaker=unknown"
msgid "  In spite of this."
msgstr "　だがしかし。"

#. Occurrence 5A_1:753:3963: scene=5A_1
#: 5A_1:753
msgctxt "text_id=3963 | speaker=unknown"
msgid "  They splendidly miscalculated the balance between aspirations and sophistication."
msgstr "　夢と洒脱のバランスを、彼らは豪快に間違えていた。"

#. Occurrence 5A_1:804:3964: scene=5A_1
#: 5A_1:804
msgctxt "text_id=3964 | speaker=unknown"
msgid "  Its mascot, Kitsy, was poorly designed and appeared like a cheap knockoff."
msgstr "　あまりにも不細工、かつパチもん臭いオリジナルマスコット・キッツィーちゃん。"

#. Occurrence 5A_1:809:3965: scene=5A_1
#: 5A_1:809
msgctxt "text_id=3965 | speaker=unknown"
msgid "  The park was stuffed to the brim with bread stands."
msgstr "　必要以上に園内をにぎわす焼きたてブレッドの売店。"

#. Occurrence 5A_1:814:3966: scene=5A_1
#: 5A_1:814
msgctxt "text_id=3966 | speaker=unknown"
msgid "  Even its impossible-to-navigate mirror maze seemed out of date from the start."
msgstr "　８０年初頭から流行しだした大迷路を極限まで難解にしたミラーメイズ。"

#. Occurrence 5A_1:834:3967: scene=5A_1
#: 5A_1:834
msgctxt "text_id=3967 | speaker=unknown"
msgid "\"There are no dreams to be had at Kitsy Land."
msgstr "“キッツィーランドにドリームはない。"

#. Occurrence 5A_1:834:3968: scene=5A_1
#: 5A_1:834
msgctxt "text_id=3968 | speaker=unknown"
msgid "  Only nightmarish satire.\""
msgstr "　ただ悪夢のようなユーモアがあるだけだ”"

#. Occurrence 5A_1:840:3969: scene=5A_1
#: 5A_1:840
msgctxt "text_id=3969 | speaker=unknown"
msgid "  Numerous trade magazines lambasted Kitsy Land's shortcomings, and customer attendance declined."
msgstr "　各種専門誌はこぞってキッツィーランドの欠点をあげつらい、客足は減少。"

#. Occurrence 5A_1:845:3970: scene=5A_1
#: 5A_1:845
msgctxt "text_id=3970 | speaker=unknown"
msgid "  There was even an incident where a six-year-old strayed from his mother, had an accident, and nearly died."
msgstr "　また、不運な事に母親とはぐれた六歳児が園内の施設で遭難し、衰弱死寸前で救出される事件まで起きてしまった。"

#. Occurrence 5A_1:899:3971: scene=5A_1
#: 5A_1:899
msgctxt "text_id=3971 | speaker=unknown"
msgid "  1986, five years after the park opened."
msgstr "　開園から五年後の１９８６年。"

#. Occurrence 5A_1:910:3972: scene=5A_1
#: 5A_1:910
msgctxt "text_id=3972 | speaker=unknown"
msgid "  The situation had grown from bad to worse, and the park was hemorrhaging money."
msgstr "　悪化の一途をたどる経営不振、"

#. Occurrence 5A_1:915:3973: scene=5A_1
#: 5A_1:915
msgctxt "text_id=3973 | speaker=unknown"
msgid "  On top of everything, Yurihiko, who had bet everything on the success of mascot Kitsy, retired, and Kitsy Land's operations were officially in trouble."
msgstr "　キッツィーちゃんのブレイクに余生をかけていた由里彦翁の引退が重なり、キッツィーランドの運営は困難となった。"

#. Occurrence 5A_1:921:3974: scene=5A_1
#: 5A_1:921
msgctxt "text_id=3974 | speaker=unknown"
msgid "  And thus, amidst the scorn of nearly all residents of the area, ended Misaki City's one and only amusement park."
msgstr "　こうして、地域の人々に惜しまれながらも三咲市唯一の遊園地は、その短い一生を終えたのだった。"

#. Occurrence 5A_1:945:3975: scene=5A_1
#: 5A_1:945
msgctxt "text_id=3975 | speaker=unknown"
msgid "  What's more..."
msgstr "　……また。"

msgctxt "text_id=3976 | speaker=unknown"
msgid "  Perhaps best described as a footnote to this debacle, the (self-proclaimed) Parisian artist who designed the mascot, Toki Julich, was said to have snapped his brush in mourning over the closure of the park."
msgstr "　余談ではあるが、キッツィーちゃんをデザインしたパリ在住（自称）のアーティスト、トッキー・ユーリッヒ氏も、閉園を<悼|いた>むようにその筆を折ったという。"

#. Occurrence 5A_1:983:3977: scene=5A_1
#: 5A_1:983
msgctxt "text_id=3977 | speaker=unknown"
msgid "  Returning to the present..."
msgstr "　そして現在。"

#. Occurrence 5A_1:1005:3978: scene=5A_1
#: 5A_1:1005
msgctxt "text_id=3978 | speaker=unknown"
msgid "  It was midnight, and the Kitsy Land of today was a shadow of its former glory."
msgstr "　深夜零時のキッツィーランドは、かつての栄華など微塵も見られない。"

#. Occurrence 5A_1:1010:3979: scene=5A_1
#: 5A_1:1010
msgctxt "text_id=3979 | speaker=unknown"
msgid "  Like a doll abandoned in the corner of a toy box, the lonely park was illuminated only by the light of the town that continued to live around it."
msgstr "　オモチャ箱の片隅においやられた人形のように、ひとり寂しく、今も生き続ける町からの明かりに照らされている。"

#. Occurrence 5A_1:1031:3980: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_1_0001; voice_prefix=A30; voice_category=3; scene=5A_1
#: 5A_1:1031
msgctxt "text_id=3980 | speaker=soujuurou"
msgid "\"So that's what happened.\""
msgstr "「なるほど」"

#. Occurrence 5A_1:1037:3981: scene=5A_1
#: 5A_1:1037
msgctxt "text_id=3981 | speaker=unknown"
msgid "  Soujyuro closed the Yashirogi guidebook that he had picked up on the way here."
msgstr "　草十郎はぱたん、と来る途中で拾った『社木案内のしおり』を閉じた。"

#. Occurrence 5A_1:1042:3982: scene=5A_1
#: 5A_1:1042
msgctxt "text_id=3982 | speaker=unknown"
msgid "  The story of its history was almost difficult to believe, but he supposed this was what people referred to as entropy."
msgstr "　いまいち実感の湧かない歴史だが、これも<必衰|ひっすい>というヤツだろう、と納得する。"

#. Occurrence 5A_1:1088:3983: scene=5A_1
#: 5A_1:1088
msgctxt "text_id=3983 | speaker=unknown"
msgid "  The park's front gate was unlocked."
msgstr "　遊園地の正門は施錠されていなかった。"

#. Occurrence 5A_1:1093:3984: scene=5A_1
#: 5A_1:1093
msgctxt "text_id=3984 | speaker=unknown"
msgid "  When he worked here the previous time, the iron fence was locked shut with a rusty chain, but the chain was nowhere to be seen and the gate left ajar."
msgstr "　以前アルバイトにきた時、<鉄柵|いりぐち>は錆びた鎖によって施錠されていたが、今は外され、鉄柵も少しだけ開いている。"

#. Occurrence 5A_1:1114:3985: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_1_0002; voice_prefix=A30; voice_category=3; scene=5A_1
#: 5A_1:1114
msgctxt "text_id=3985 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5A_1:1133:3986: scene=5A_1
#: 5A_1:1133
msgctxt "text_id=3986 | speaker=unknown"
msgid "  Following the map drawn in the letter, Soujyuro quickly made his way inside."
msgstr "　草十郎は手紙に描かれた地図にしたがって、ひょこっと園内に侵入する。"

#. Occurrence 5A_1:1156:3987: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_1_0003; voice_prefix=A30; voice_category=3; scene=5A_1
#: 5A_1:1156
msgctxt "text_id=3987 | speaker=soujuurou"
msgid "\"...It sounded urgent, but to meet this late at night? What in the world could she want?\""
msgstr "「……急ぎの用なんだろうけど。こんな夜中に、なんなんだいったい」"

#. Occurrence 5A_1:1162:3988: scene=5A_1
#: 5A_1:1162
msgctxt "text_id=3988 | speaker=unknown"
msgid "  Soujyuro complained, quite out of character for him."
msgstr "　らしくなく<愚|ぐ><痴|ち>を言う。"

#. Occurrence 5A_1:1192:3989: scene=5A_1
#: 5A_1:1192
msgctxt "text_id=3989 | speaker=unknown"
msgid "  It was probably because, in spite of his naivety, even he knew that something was amiss."
msgstr "　世間知らずな彼にでも、この行為がよくない事だと分かっているからだろう。"

#. Occurrence 5A_1:1197:3990: scene=5A_1
#: 5A_1:1197
msgctxt "text_id=3990 | speaker=unknown"
msgid "  Though the park was abandoned, this was still trespassing."
msgstr "　廃墟になったとはいえ、立ち入り禁止の遊園地に忍びこんでいる。"

#. Occurrence 5A_1:1202:3991: scene=5A_1
#: 5A_1:1202
msgctxt "text_id=3991 | speaker=unknown"
msgid "  Unlawful entry, larceny, burglary..."
msgstr "　不法侵入、窃盗、泥棒。"

#. Occurrence 5A_1:1208:3992: scene=5A_1
#: 5A_1:1208
msgctxt "text_id=3992 | speaker=unknown"
msgid "These were certainly not things, or perhaps crimes, that Soujyuro was proud to do, but..."
msgstr "決して胸を張れる事ではなく、犯罪と言えば犯罪なのだが―――"

#. Occurrence 5A_1:1229:3993: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_1_0004; voice_prefix=A30; voice_category=3; scene=5A_1
#: 5A_1:1229
msgctxt "text_id=3993 | speaker=soujuurou"
msgid "\"...Sorry, I can't pay you any money."
msgstr "「……すまない、お金は払えないんだ。"

#. Occurrence 5A_1:1235:3994: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_1_0005; voice_prefix=A30; voice_category=3; scene=5A_1
#: 5A_1:1235
msgctxt "text_id=3994 | speaker=soujuurou"
msgid "  I'm really sorry for coming in for free.\""
msgstr "　タダで入って申しわけない」"

#. Occurrence 5A_1:1251:3995: scene=5A_1
#: 5A_1:1251
msgctxt "text_id=3995 | speaker=unknown"
msgid "  Money, apparently, was why his conscience was gnawing at him."
msgstr "　彼にとって後ろめたいのはその一点だけらしい。"

#. Occurrence 5A_1:1256:3996: scene=5A_1
#: 5A_1:1256
msgctxt "text_id=3996 | speaker=unknown"
msgid "  He clapped his hands in apology toward the statue of Kitsy, on whose eyes the paint had begun to aptly dissolve."
msgstr "　目のペンキがいい感じで<融解|とけだ>しているキッツィーちゃん像に、ぱんぱん、と手を合わせる。"

#. Occurrence 5A_1:1261:3997: scene=5A_1
#: 5A_1:1261
msgctxt "text_id=3997 | speaker=unknown"
msgid "  Soujyuro passed the mascot bleeding red paint from its eye sockets and began to walk the night park."
msgstr "　赤ペンキを<眼窩|がんか>から流すマスコットを通過して、草十郎は夜の遊園地へと歩き出した。"

#. Occurrence 5A_1:1307:3998: scene=5A_1
#: 5A_1:1307
msgctxt "text_id=3998 | speaker=unknown"
msgid "  The buildings' colors had faded."
msgstr "　色落ちた建物。"

#. Occurrence 5A_1:1312:3999: scene=5A_1
#: 5A_1:1312
msgctxt "text_id=3999 | speaker=unknown"
msgid "  The collection of machines was rusted."
msgstr "　錆び付いた機械の群。"

#. Occurrence 5A_1:1317:4000: scene=5A_1
#: 5A_1:1317
msgctxt "text_id=4000 | speaker=unknown"
msgid "  The man-made residents no longer felt the passage of time."
msgstr "　もう時を刻むことのない、作り物の住人たち。"

#. Occurrence 5A_1:1322:4001: scene=5A_1
#: 5A_1:1322
msgctxt "text_id=4001 | speaker=unknown"
msgid "  Even the ghosts themselves could not endure the disparity between this forsaken place and its previous grand stature."
msgstr "　かつての栄華とのあまりの落差に、幽霊すらいたたまれず住み着かなくなったゴーストタウン。"

#. Occurrence 5A_1:1342:4002: scene=5A_1
#: 5A_1:1342
msgctxt "text_id=4002 | speaker=unknown"
msgid "  It was like a fossilized dream."
msgstr "　―――まるで<童話|ユメ>の化石だ。"

#. Occurrence 5A_1:1348:4003: scene=5A_1
#: 5A_1:1348
msgctxt "text_id=4003 | speaker=unknown"
msgid "  These were the ruins of a paradise both created and abandoned by man and reality."
msgstr "　ここは<現実|人の手>によって造られながら、<現実|ひとびと>に置き去りにされた楽園の跡。"

#. Occurrence 5A_1:1354:4004: scene=5A_1
#: 5A_1:1354
msgctxt "text_id=4004 | speaker=unknown"
msgid "  The economy had stabilized,"
msgstr "　経済が安定し、"

msgctxt "text_id=4005 | speaker=unknown"
msgid "  and the standard of living was on the rise. Nobody was overly concerned with the future. These were the remains of a wild and exciting era."
msgstr "　人々の生活水準は右肩あがりで、誰もが未来に不安を抱かなかった、狂騒の時代の遺物である。"

#. Occurrence 5A_1:1419:4006: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_1_0006; voice_prefix=A30; voice_category=3; scene=5A_1
#: 5A_1:1419
msgctxt "text_id=4006 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5A_1:1425:4007: scene=5A_1
#: 5A_1:1425
msgctxt "text_id=4007 | speaker=unknown"
msgid "  His breath turning to white wisps before him, Soujyuro continued through the abandoned amusement park."
msgstr "　白い息を吐きながら、草十郎は廃遊園地を歩いていく。"

#. Occurrence 5A_1:1430:4008: scene=5A_1
#: 5A_1:1430
msgctxt "text_id=4008 | speaker=unknown"
msgid "  Though void of human presence, this was not nearly as frightening as the darkness deep in the mountains."
msgstr "　人気はないが、山中の闇に比べればそう怖くもない。"

#. Occurrence 5A_1:1450:4009: scene=5A_1
#: 5A_1:1450
msgctxt "text_id=4009 | speaker=unknown"
msgid "  City suburbs can take many different forms, but Kitsy Land was unusual for an amusement park insomuch as it had been built adjacent to a residential district."
msgstr "　郊外といっても様々で、キッツィーランドは遊園地にしては珍しく、住宅地の<傍|そば>に造られている。"

#. Occurrence 5A_1:1455:4010: scene=5A_1
#: 5A_1:1455
msgctxt "text_id=4010 | speaker=unknown"
msgid "  The park was surrounded by a forest, but even that, ultimately, was man-made. It was no different from the curtains on a classroom window."
msgstr "　遊園地は林に囲まれているが、それも所詮は人工のもの。教室の窓を閉ざすカーテンとなんら変わりはない。"

#. Occurrence 5A_1:1478:4011: scene=5A_1
#: 5A_1:1478
msgctxt "text_id=4011 | speaker=unknown"
msgid "  If he were to scale the iron fence encircling Kitsy Land and break through the twenty yards of afforested trees, he could make it back to the familiar townscape."
msgstr "　キッツィーランドを囲む鉄柵を越え、二十メートルほど造林された木々を抜ければ、簡単に見慣れた町並みに帰ることができる。"

#. Occurrence 5A_1:1483:4012: scene=5A_1
#: 5A_1:1483
msgctxt "text_id=4012 | speaker=unknown"
msgid "  Though the amusement park tended to arouse dread in the city folk, to Soujyuro it was little different from the commotion and terror of downtown."
msgstr "　都会の人間にとって夜の遊園地は恐怖を喚起させるものだが、草十郎にとっては、この遊園地も駅前の喧噪も“怖さ”の深度は同じだった。"

#. Occurrence 5A_10:63:4013: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0000; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:63
msgctxt "text_id=4013 | speaker=aoko"
msgid "\"Just so you know, this is going to be pretty tough for you.\""
msgstr "“結構きついかもね、あなたの役目”"

#. Occurrence 5A_10:69:4014: scene=5A_10
#: 5A_10:69
msgctxt "text_id=4014 | speaker=unknown"
msgid "  Aoko warned Soujyuro, moving as fast as she could without her footfalls causing a din of noise."
msgstr "　草十郎にそう告げて、青子は静かに、可能なかぎり音を殺して走り出した。"

#. Occurrence 5A_10:74:4015: scene=5A_10
#: 5A_10:74
msgctxt "text_id=4015 | speaker=unknown"
msgid "  Soujyuro remained near the center of the spiral maze on the second floor."
msgstr "　二階のほぼ中心、渦の終点には草十郎だけが残っている。"

#. Occurrence 5A_10:131:4016: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0001; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:131
msgctxt "text_id=4016 | speaker=aoko"
msgid "\"I'll let you in on a secret: I have another trap up my sleeve."
msgstr "“実を言うと、もう一つ用意しておいた仕掛けがあるの。"

#. Occurrence 5A_10:137:4017: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0002; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:137
msgctxt "text_id=4017 | speaker=aoko"
msgid "  I think I might have gone overboard with this one, but when you didn't show up on time, I just couldn't help myself.\""
msgstr "　自分でもやりすぎだって呆れたもんだけど、貴方が<遊園地|ここ>に来るのが遅かったから。ちょっと興に乗っちゃって”"

#. Occurrence 5A_10:166:4018: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0000; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:166
msgctxt "text_id=4018 | speaker=soujuurou"
msgid "\"A trap? For me?\""
msgstr "“……？　仕掛けって、俺用の？”"

#. Occurrence 5A_10:186:4019: scene=5A_10
#: 5A_10:186
msgctxt "text_id=4019 | speaker=unknown"
msgid "  Soujyuro tilted his head like a squirrel as Aoko freely discussed the final ace up her sleeve."
msgstr "　リスのように首をかしげる草十郎に、青子はそ、と気軽に答えて、伏せておいた最後の切り札を提示した。"

#. Occurrence 5A_10:234:4020: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0003; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:234
msgctxt "text_id=4020 | speaker=aoko"
msgid "\"I engraved an ignition formula into the support pillars in the basement. If I ignite the central pillar, it will start a chain reaction that will ignite the rest."
msgstr "“地下の<支柱|はしら>に着火型の、ちょっとした魔術式を刻んでおいたの。中心の柱に点火することで、連鎖的に他の柱に仕掛けた魔術も起動する。"

#. Occurrence 5A_10:240:4021: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0004; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:240
msgctxt "text_id=4021 | speaker=aoko"
msgid "  I made it before that thing started jamming me, so if I infuse it with a bit of magical energy, it'll go boom.\""
msgstr "　ジャミングを食らう前に作ったものだから、直接魔力をたたき込めば一気に、こう、いくわ”"

#. Occurrence 5A_10:246:4022: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0001; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:246
msgctxt "text_id=4022 | speaker=soujuurou"
msgid "\"...\""
msgstr "“………………”"

#. Occurrence 5A_10:251:4023: scene=5A_10
#: 5A_10:251
msgctxt "text_id=4023 | speaker=unknown"
msgid "  Soujyuro was a little unsettled by how unclear that last bit was."
msgstr "　具体的な表現を避ける青子に、一抹の不安を隠せない草十郎なのだった。"

#. Occurrence 5A_10:291:4024: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0002; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:291
msgctxt "text_id=4024 | speaker=soujuurou"
msgid "\"...Aozaki, could you, um, clarify? I want to know how much you were going to blow me up. Please be honest."
msgstr "“……蒼崎。こう、じゃ分からない。できるだけ明確に、どこまで爆破する気だったのか白状してくれ。"

#. Occurrence 5A_10:297:4025: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0003; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:297
msgctxt "text_id=4025 | speaker=soujuurou"
msgid "  Also, did I make a mistake agreeing to team up with you?\""
msgstr "　あと、もしかして俺、早まったか？”"

#. Occurrence 5A_10:331:4026: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0005; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:331
msgctxt "text_id=4026 | speaker=aoko"
msgid "\"Don't be silly. It was just an... insurance policy. Yeah."
msgstr "“いや、その……単なる保険って言うか。"

#. Occurrence 5A_10:337:4027: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0006; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:337
msgctxt "text_id=4027 | speaker=aoko"
msgid "  I just thought that if I lost sight of you at any point, I could blow the whole building and you with it.\""
msgstr "　追いかけっこの途中でアンタを見失ったら、いっそ建物ごと爆破しちゃおうかなー、って”"

#. Occurrence 5A_10:525:4028: scene=5A_10
#: 5A_10:525
msgctxt "text_id=4028 | speaker=unknown"
msgid "  It was her policy to be thorough to a fault, after all. She laughed, embarrassed to hear herself say it aloud."
msgstr "　なにごとも徹底しておくものねー、と照れ笑いをしながら頭を<掻|か>く青子。"

#. Occurrence 5A_10:532:4029: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0004; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:532
msgctxt "text_id=4029 | speaker=soujuurou"
msgid "\"Don't you think that's overkill!?\""
msgstr "“いくらなんでも徹底しすぎてる！”"

#. Occurrence 5A_10:538:4030: scene=5A_10
#: 5A_10:538
msgctxt "text_id=4030 | speaker=unknown"
msgid "  Faced with Aoko's cruelty, Soujyuro forgot about the situation at hand and protested from the bottom of his heart."
msgstr "　そんな青子の暴虐ぶりに、草十郎は状況を忘れて、心底からの感想で抗議した。"

#. Occurrence 5A_10:589:4031: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0007; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:589
msgctxt "text_id=4031 | speaker=aoko"
msgid "\"...Stop complaining. At least now we have a way to fight back.\""
msgstr "「……なによ。いいじゃない、そのおかげでなんとかなりそうなんだから」"

#. Occurrence 5A_10:595:4032: scene=5A_10
#: 5A_10:595
msgctxt "text_id=4032 | speaker=unknown"
msgid "  She shot back."
msgstr "　……などと。"

#. Occurrence 5A_10:600:4033: scene=5A_10
#: 5A_10:600
msgctxt "text_id=4033 | speaker=unknown"
msgid "  Aoko dashed down the corridor mumbling things that probably would have sent Soujyuro packing if he heard them."
msgstr "　草十郎が聞いたら<協力|けいかく>を白紙に戻しかねない<愚|グ><痴|チ>をこぼしつつ、青子は通路をひた走る。"

#. Occurrence 5A_10:633:4034: scene=5A_10
#: 5A_10:633
msgctxt "text_id=4034 | speaker=unknown"
msgid "  The strategy was simple."
msgstr "　作戦はシンプルだ。"

#. Occurrence 5A_10:649:4035: scene=5A_10
#: 5A_10:649
msgctxt "text_id=4035 | speaker=unknown"
msgid "  Aoko would use the escape route to the right and avoid the puppet while making her way down to the basement."
msgstr "　青子は右に曲がる抜け道を利用し、人形を避けて地下一階まで移動。"

#. Occurrence 5A_10:654:4036: scene=5A_10
#: 5A_10:654
msgctxt "text_id=4036 | speaker=unknown"
msgid "  Upon reaching the central pillar, she would infuse the formula she had prepared with magical energy and escape."
msgstr "　地下中央の柱まで辿り着き、仕掛けておいた魔術式に直接魔力を注入し、脱出する。"

#. Occurrence 5A_10:659:4037: scene=5A_10
#: 5A_10:659
msgctxt "text_id=4037 | speaker=unknown"
msgid "  Once ignited, it would take about a minute for the chain reaction to spread throughout the whole house of mirrors, and another minute for the building to collapse."
msgstr "　魔術式が起動し、崩壊がミラーハウス全体に広がるまで早くて一分、その後の倒壊まであと一分。"

#. Occurrence 5A_10:675:4038: scene=5A_10
#: 5A_10:675
msgctxt "text_id=4038 | speaker=unknown"
msgid "  ...She would be cutting it a little close, but because she had committed the maze to memory, she was sure she could make it out in time."
msgstr "　……厳しいが、迷路を暗記している青子ならギリギリで脱出できるスケジュールだ。"

#. Occurrence 5A_10:721:4039: scene=5A_10
#: 5A_10:721
msgctxt "text_id=4039 | speaker=unknown"
msgid "  Aoko assumed that the chain reaction caused by the pillar would clear the barrier that the puppet had placed at the entrance."
msgstr "　人形による入り口の<結界|かべ>は、柱の連鎖爆破で吹き飛ぶ程度だろうと青子は予想している。"

#. Occurrence 5A_10:726:4040: scene=5A_10
#: 5A_10:726
msgctxt "text_id=4040 | speaker=unknown"
msgid "  And even if it was strong enough to withstand the blast, it would not be able to stay standing once the foundations buckled. Soujyuro's escape was assured as long as the formula in the basement was activated."
msgstr "　仮にもっと上等な結界だとしても、建物全体が歪んでしまえば消えざるを得ない。地下の魔術式さえ起動させれば草十郎の脱出路は確保できる。"

#. Occurrence 5A_10:761:4041: scene=5A_10
#: 5A_10:761
msgctxt "text_id=4041 | speaker=unknown"
msgid "  Next came the most important part."
msgstr "　最後に、肝心の標的について。"

#. Occurrence 5A_10:779:4042: scene=5A_10
#: 5A_10:779
msgctxt "text_id=4042 | speaker=unknown"
msgid "  The automaton was at a disadvantage in the obstacle-laden house of mirrors and was unable to move at full speed."
msgstr "　あのオートマタは遮蔽物だらけの<この場所|ミラーハウス>を苦手としている。アレは構造上、この地形での全速移動はできない。"

#. Occurrence 5A_10:784:4043: scene=5A_10
#: 5A_10:784
msgctxt "text_id=4043 | speaker=unknown"
msgid "  If it was near the center of the second floor when the building collapsed, it would be caught up and crushed by it."
msgstr "　建物が崩壊しだした時に二階の中心付近にいれば、倒壊に巻きこまれてあえなくスクラップだ。"

#. Occurrence 5A_10:801:4044: scene=5A_10
#: 5A_10:801
msgctxt "text_id=4044 | speaker=unknown"
msgid "  So the problem was keeping the puppet on the second floor until Aoko could make it down to the basement."
msgstr "　なので問題は、青子が地下に行くまで、いかにして人形を二階に押しとどめておくか、という事だった。"

#. Occurrence 5A_10:822:4045: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0008; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:822
msgctxt "text_id=4045 | speaker=aoko"
msgid "\"...I'm counting on you, Sizuki."
msgstr "“……アテにしたからね、静希君。"

#. Occurrence 5A_10:822:4046: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0008; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:822
msgctxt "text_id=4046 | speaker=aoko"
msgid "  I just need you to keep it occupied for three minutes.\""
msgstr "　せめて三分ぐらいは引き付けて―――”"

#. Occurrence 5A_10:883:4047: scene=5A_10
#: 5A_10:883
msgctxt "text_id=4047 | speaker=unknown"
msgid "  Ideally, he would be able to keep it busy until she could activate the formula."
msgstr "　青子が地下に到達し、魔術式を起動させるまで人形を引き付けてくれるなら文句なし。"

#. Occurrence 5A_10:888:4048: scene=5A_10
#: 5A_10:888
msgctxt "text_id=4048 | speaker=unknown"
msgid "  If that failed to work, him luring it down to the first floor would be the next best thing."
msgstr "　もしくは、せめて一階の大広間に下りるまで囮になってくれれば、この作戦は上手くいく。"

#. Occurrence 5A_10:908:4049: scene=5A_10
#: 5A_10:908
msgctxt "text_id=4049 | speaker=unknown"
msgid "  She understood perfectly well the danger she was putting Soujyuro in, but his lucky streak and running speed were nothing to scoff at."
msgstr "　草十郎が危険なのは百も承知だが、<青子|じぶん>からあれだけ逃げ回った草十郎の運と脚力は馬鹿にできない。"

#. Occurrence 5A_10:935:4050: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0009; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:935
msgctxt "text_id=4050 | speaker=aoko"
msgid "\"As long as all he has to do is run, then maybe...just maybe..."
msgstr "“……うん、ただ逃げるだけなら、もしかして―――"

#. Occurrence 5A_10:935:4051: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0009; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:935
msgctxt "text_id=4051 | speaker=aoko"
msgid "  Just maybe... he can actually pull this off.\""
msgstr "　トンデモない事をしてくれるかも、アイツ”"

#. Occurrence 5A_10:1017:4052: scene=5A_10
#: 5A_10:1017
msgctxt "text_id=4052 | speaker=unknown"
msgid "  Aoko made her way through the hidden passage of the maze, her hopes pinned on Soujyuro."
msgstr "　などと。迷路の横道を走りながら、青子はつい、ここには居ない草十郎に期待をよせたのだった。"

#. Occurrence 5A_10:1118:4053: scene=5A_10
#: 5A_10:1118
msgctxt "text_id=4053 | speaker=unknown"
msgid "  Meanwhile..."
msgstr "　―――一方。"

#. Occurrence 5A_10:1124:4054: scene=5A_10
#: 5A_10:1124
msgctxt "text_id=4054 | speaker=unknown"
msgid "  Well out of earshot, Soujyuro was readying himself for another desperate chase."
msgstr "　そんな青子の声が聞こえるはずもなく、草十郎は必死の追いかけっこに挑もうとしていた。"

#. Occurrence 5A_10:1129:4055: scene=5A_10
#: 5A_10:1129
msgctxt "text_id=4055 | speaker=unknown"
msgid "  He calmed his beating heart using a method of his own making."
msgstr "　彼は自分なりの方法で<心|む><臓|ね>の動悸を押さえつける。"

#. Occurrence 5A_10:1134:4056: scene=5A_10
#: 5A_10:1134
msgctxt "text_id=4056 | speaker=unknown"
msgid "  What mattered most was that he remained calm. The plan was simple enough,"
msgstr "　大事なのは落ち着く事だ。作戦自体はシンプルで、そう難しいものじゃない。"

#. Occurrence 5A_10:1139:4057: scene=5A_10
#: 5A_10:1139
msgctxt "text_id=4057 | speaker=unknown"
msgid "  and Aoko's orders were succinct and easy to understand."
msgstr "　青子の指示は短く、実に分かりやすかった。"

#. Occurrence 5A_10:1229:4058: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0010; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:1229
msgctxt "text_id=4058 | speaker=aoko"
msgid "\"Keep a distance of around thirty feet and weave through the corridors as slowly as you can three or four times."
msgstr "“十メートルぐらいの距離を保って、できるだけゆっくり通路を三、四周する事。"

#. Occurrence 5A_10:1235:4059: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0011; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:1235
msgctxt "text_id=4059 | speaker=aoko"
msgid "  Count the mirrors as you move to locate the hidden passages. From here, they are on the sixth, third, seventh, and second mirrors counterclockwise. Use those, and you should be relatively safe.\""
msgstr "　横道は鏡のつなぎ目で覚えて。ここなら左回りで六、三、七、二枚目にあるから、そこをぐるぐる回ってれば比較的安全よ”"

#. Occurrence 5A_10:1255:4060: scene=5A_10
#: 5A_10:1255
msgctxt "text_id=4060 | speaker=unknown"
msgid "  It was essentially a looping marathon."
msgstr "　……要は円を描くマラソンである。"

#. Occurrence 5A_10:1260:4061: scene=5A_10
#: 5A_10:1260
msgctxt "text_id=4061 | speaker=unknown"
msgid "  As long as Soujyuro kept just enough distance from the puppet's extended arm to allow her to track him, she could continue to chase him indefinitely."
msgstr "　人形からは伸びる腕だけが届いて、ぎりぎり追跡できるじれったい距離をキープしていれば、相手はしつこく追いかけてくる筈だ。"

#. Occurrence 5A_10:1265:4062: scene=5A_10
#: 5A_10:1265
msgctxt "text_id=4062 | speaker=unknown"
msgid "  Simple though the task was, Soujyuro was putting his life on the line as bait."
msgstr "　単純作業だが、草十郎にとっては命懸けの囮役である。"

#. Occurrence 5A_10:1270:4063: scene=5A_10
#: 5A_10:1270
msgctxt "text_id=4063 | speaker=unknown"
msgid "  And then there was the final order to run as fast as he could to the exit when the building began to sway."
msgstr "　加えて、建物が揺れだしたら全力で出口まで走れ、という無茶な注文付き。"

#. Occurrence 5A_10:1362:4064: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0005; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:1362
msgctxt "text_id=4064 | speaker=soujuurou"
msgid "\"This is more than just a little tough...\""
msgstr "「……けっこうじゃなくて、かなりきついんじゃないかな、コレは」"

#. Occurrence 5A_10:1430:4065: scene=5A_10
#: 5A_10:1430
msgctxt "text_id=4065 | speaker=unknown"
msgid "  He nervously stuck his head out from around the corner."
msgstr "　おびえおびえのぎこちない動作で、草十郎は曲がり角から顔を出す。"

#. Occurrence 5A_10:1435:4066: scene=5A_10
#: 5A_10:1435
msgctxt "text_id=4066 | speaker=unknown"
msgid "  He could hear the sound of the music box from the other side of the corridor."
msgstr "　……突き当たりの曲がり角からは例のオルゴールの音。"

#. Occurrence 5A_10:1440:4067: scene=5A_10
#: 5A_10:1440
msgctxt "text_id=4067 | speaker=unknown"
msgid "  First he had to make eye contact with it, then head through the shortcut on the right and begin their game of tag."
msgstr "　まずはここで顔を合わせて、右側のショートカットを抜けて、ループ状の鬼ごっこを開始しなくてはいけない。"

#. Occurrence 5A_10:1476:4068: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0006; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:1476
msgctxt "text_id=4068 | speaker=soujuurou"
msgid "\"...!\""
msgstr "「…………！」"

#. Occurrence 5A_10:1548:4069: scene=5A_10
#: 5A_10:1548
msgctxt "text_id=4069 | speaker=unknown"
msgid "  He spotted it and braced himself."
msgstr "　来た、と身構える。"

#. Occurrence 5A_10:1553:4070: scene=5A_10
#: 5A_10:1553
msgctxt "text_id=4070 | speaker=unknown"
msgid "  Closer... Closer..."
msgstr "　引きつけて、引きつけて。"

#. Occurrence 5A_10:1558:4071: scene=5A_10
#: 5A_10:1558
msgctxt "text_id=4071 | speaker=unknown"
msgid "  Fearing that her arm could fly at him at any moment, he went over Aoko's instructions in his head."
msgstr "　いつ伸びてくるか分からない腕におびえながら、草十郎は青子の説明を思いかえ―――"

#. Occurrence 5A_10:1658:4072: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0007; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:1658
msgctxt "text_id=4072 | speaker=soujuurou"
msgid "\"...Wait.\""
msgstr "「…………あれ？」"

#. Occurrence 5A_10:1664:4073: scene=5A_10
#: 5A_10:1664
msgctxt "text_id=4073 | speaker=unknown"
msgid "  However..."
msgstr "　ところで。"

#. Occurrence 5A_10:1669:4074: scene=5A_10
#: 5A_10:1669
msgctxt "text_id=4074 | speaker=unknown"
msgid "  He could not quite remember which pane led to the first hidden passage."
msgstr "　一番はじめの横道は、何枚目だったっけ？"

#. Occurrence 5A_10:1674:4075: scene=5A_10
#: 5A_10:1674
msgctxt "text_id=4075 | speaker=unknown"
msgid "  The third? The sixth? The ninth...?"
msgstr "　三枚目か、六枚目か、九枚目か―――"

#. Occurrence 5A_10:1705:4076: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0008; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:1705
msgctxt "text_id=4076 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5A_10:1711:4077: scene=5A_10
#: 5A_10:1711
msgctxt "text_id=4077 | speaker=unknown"
msgid "  No..."
msgstr "　違う。"

#. Occurrence 5A_10:1716:4078: scene=5A_10
#: 5A_10:1716
msgctxt "text_id=4078 | speaker=unknown"
msgid "  He was sure that was mistaken..."
msgstr "　なんか、全部違う気がする。"

#. Occurrence 5A_10:1721:4079: scene=5A_10
#: 5A_10:1721
msgctxt "text_id=4079 | speaker=unknown"
msgid "  He was confident he had it memorized moments ago, but his nerves had gotten the best of him, and his head was now spinning."
msgstr "　さっきまでは完璧に思い返せたのに、緊張からか、草十郎の頭はぐるんぐるんに回りはじめ―――"

#. Occurrence 5A_10:1765:4080: scene=5A_10
#: 5A_10:1765
msgctxt "text_id=4080 | speaker=unknown"
msgid "  ...Then."
msgstr "　……と。"

#. Occurrence 5A_10:1772:4081: scene=5A_10
#: 5A_10:1772
msgctxt "text_id=4081 | speaker=unknown"
msgid "  Soujyuro realized that the sound of his pursuer was beginning to grow distant."
msgstr "　草十郎は前方にあった追跡者の<物音|プレッシャー>が、唐突に離れていく事に気が付いた。"

#. Occurrence 5A_10:1777:4082: scene=5A_10
#: 5A_10:1777
msgctxt "text_id=4082 | speaker=unknown"
msgid "  And at an incredible speed."
msgstr "　それも予想外のスピードで、ガシャガシャと音をたてながら。"

#. Occurrence 5A_10:2011:4083: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0009; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:2011
msgctxt "text_id=4083 | speaker=soujuurou"
msgid "\"...What's it doing now?\""
msgstr "「……なに？」"

#. Occurrence 5A_10:2017:4084: scene=5A_10
#: 5A_10:2017
msgctxt "text_id=4084 | speaker=unknown"
msgid "  The unusual silhouette of the puppet astonished him."
msgstr "　異様な人形のシルエットに、<唖然|あぜん>とする草十郎。"

#. Occurrence 5A_10:2022:4085: scene=5A_10
#: 5A_10:2022
msgctxt "text_id=4085 | speaker=unknown"
msgid "  Before it had taken the form of a beautiful girl,"
msgstr "　あろうことか、美しい少女のカタチをした人形は唐突に、"

#. Occurrence 5A_10:2076:4086: scene=5A_10
#: 5A_10:2076
msgctxt "text_id=4086 | speaker=unknown"
msgid "  but now it made a bizarre transformation,"
msgstr "　構造的にあり得ない変形をして、"

msgctxt "text_id=4087 | speaker=unknown"
msgid "  and returned to the first floor to pursue her primary target."
msgstr "　一階に下りていった“本命”へと踵を返した。"

#. Occurrence 5A_10:2200:4088: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0010; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:2200
msgctxt "text_id=4088 | speaker=soujuurou"
msgid "\"Oh... This isn't the plan.\""
msgstr "「あ―――いや、それは」"

#. Occurrence 5A_10:2206:4089: scene=5A_10
#: 5A_10:2206
msgctxt "text_id=4089 | speaker=unknown"
msgid "  Soujyuro was no longer sure what to do."
msgstr "　まずいな、と呟いて、途方にくれる草十郎。"

#. Occurrence 5A_10:2211:4090: scene=5A_10
#: 5A_10:2211
msgctxt "text_id=4090 | speaker=unknown"
msgid "  Before he'd even had time to mourn his failure, the puppet had vanished out of sight."
msgstr "　失敗を悔やむ時間すらない。人形はもう影もカタチもなく、草十郎の前から走り去ってしまったのだ。"

#. Occurrence 5A_10:2216:4091: scene=5A_10
#: 5A_10:2216
msgctxt "text_id=4091 | speaker=unknown"
msgid "\"I'll help, so let me go.\""
msgstr "“役に立つから見逃してくれ”"

#. Occurrence 5A_10:2221:4092: scene=5A_10
#: 5A_10:2221
msgctxt "text_id=4092 | speaker=unknown"
msgid "  Or so he had said, but now he could not follow through."
msgstr "　……などと言っておいて、コレでは立場も何もない。"

#. Occurrence 5A_10:2292:4093: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0012; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:2292
msgctxt "text_id=4093 | speaker=soujuurou"
msgid "\"...So, what am I supposed to do now?\""
msgstr "「…………さて、自分はこれからどうしよう」"

#. Occurrence 5A_10:2298:4094: scene=5A_10
#: 5A_10:2298
msgctxt "text_id=4094 | speaker=unknown"
msgid "  Alone, he tilted his head in frustration."
msgstr "　ひとり、困ったように首をかしげる。"

#. Occurrence 5A_10:2303:4095: scene=5A_10
#: 5A_10:2303
msgctxt "text_id=4095 | speaker=unknown"
msgid "  He spoke into the darkness as if Aoko would be there to answer him."
msgstr "　草十郎は<傍|かたわ>らに青子がいるかのように、暗い通路に語りかけた。"

#. Occurrence 5A_10:2391:4096: scene=5A_10
#: 5A_10:2391
msgctxt "text_id=4096 | speaker=unknown"
msgid "  Meanwhile, downstairs..."
msgstr "　同時刻。"

msgctxt "text_id=4097 | speaker=unknown"
msgid " As soon as she arrived on the first floor, Aoko understood what had transpired above her."
msgstr "青子は一階の広間に辿り着いた時、正しく状況を受け入れた。"

#. Occurrence 5A_10:2413:4098: scene=5A_10
#: 5A_10:2413
msgctxt "text_id=4098 | speaker=unknown"
msgid "  She did not even have to strain her ears to hear the puppet."
msgstr "　耳を澄ませるまでもない。"

#. Occurrence 5A_10:2418:4099: scene=5A_10
#: 5A_10:2418
msgctxt "text_id=4099 | speaker=unknown"
msgid "  Even during its heyday, this attraction had never made sounds like the one she heard coming toward her now."
msgstr "　このアトラクションが<栄華|えいが>を誇っていた頃ですら、なかったであろう<騒音|にぎわい>。"

#. Occurrence 5A_10:2423:4100: scene=5A_10
#: 5A_10:2423
msgctxt "text_id=4100 | speaker=unknown"
msgid "  It was the sound of despair, as if a horde of monstrous hedgehogs were scraping their way past the mirrors in her direction."
msgstr "　ハリネズミのお化けが鏡をけずりながら大挙して迫ってくるような、そんな、絶望に似たノイズが聞こえてくる。"

#. Occurrence 5A_10:2453:4101: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0012; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:2453
msgctxt "text_id=4101 | speaker=aoko"
msgid "\"...That ditz. Three minutes? He couldn't even last ten seconds.\""
msgstr "「…………あのドジ。三分どころか十秒<保|も>たないって、どういうコトよ」"

#. Occurrence 5A_10:2459:4102: scene=5A_10
#: 5A_10:2459
msgctxt "text_id=4102 | speaker=unknown"
msgid "  Rather than buying her time, Soujyuro had instead stolen hers."
msgstr "　時間を稼ぐ、どころの話じゃない。"

#. Occurrence 5A_10:2464:4103: scene=5A_10
#: 5A_10:2464
msgctxt "text_id=4103 | speaker=unknown"
msgid "  He had one job―to run away, that was all! She cursed him under her breath."
msgstr "　本当、ただ逃げるだけなのにトンデモない事をしてくれやがった、と悪態のひとつもつきたくなる。"

#. Occurrence 5A_10:2502:4104: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0013; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:2502
msgctxt "text_id=4104 | speaker=aoko"
msgid "\"Multiple footsteps...so it's switched from bipedal to multi-leg form?\""
msgstr "「―――複数の足音―――ってコトは、二足から多脚に切り替えたのね」"

#. Occurrence 5A_10:2508:4105: scene=5A_10
#: 5A_10:2508
msgctxt "text_id=4105 | speaker=unknown"
msgid "  The echoes made it sound like dozens of feet were approaching."
msgstr "　反響する何人もの足音。"

#. Occurrence 5A_10:2513:4106: scene=5A_10
#: 5A_10:2513
msgctxt "text_id=4106 | speaker=unknown"
msgid "  Aoko's mind conjured an image of a giant, six-legged spider tearing its way down the corridor."
msgstr "　それだけで青子は、通路を走る、六足歩行の巨大な蜘蛛を予想した。"

#. Occurrence 5A_10:2615:4107: scene=5A_10
#: 5A_10:2615
msgctxt "text_id=4107 | speaker=unknown"
msgid "  It was little wonder that it was so much faster than before."
msgstr "　敵の移動速度が今までとは比較にならないのは当然だ。"

#. Occurrence 5A_10:2620:4108: scene=5A_10
#: 5A_10:2620
msgctxt "text_id=4108 | speaker=unknown"
msgid "  Its perception of its surroundings through echolocation was of particular use in the dark."
msgstr "　反響定位による環境把握は暗闇でこそ生きる。"

#. Occurrence 5A_10:2625:4109: scene=5A_10
#: 5A_10:2625
msgctxt "text_id=4109 | speaker=unknown"
msgid "  Compared to sight-dependent humans, this automaton was far better equipped to navigate its way through the labyrinth of mirrors."
msgstr "　鏡の迷路において、視力に頼る人間より、自動人形は何倍も精確に周囲を把握している。"

#. Occurrence 5A_10:2630:4110: scene=5A_10
#: 5A_10:2630
msgctxt "text_id=4110 | speaker=unknown"
msgid "  If it could not keep pace earlier, that had been because its bipedal mode made it less maneuverable."
msgstr "　それでも青子に追いつけなかったのは、たんに二本足では小刻みな方向転換に耐えられなかったからだ。"

#. Occurrence 5A_10:2635:4111: scene=5A_10
#: 5A_10:2635
msgctxt "text_id=4111 | speaker=unknown"
msgid "  Now, the stability provided by multiple legs gave it a speed that far exceeded that of any human."
msgstr "　多脚という安定性を持てば、そのスピードは人間を遥かに凌駕する。"

#. Occurrence 5A_10:2732:4112: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0014; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:2732
msgctxt "text_id=4112 | speaker=aoko"
msgid "(What now? What now!?)"
msgstr "“どうする、どうする、どうする―――！”"

#. Occurrence 5A_10:2738:4113: scene=5A_10
#: 5A_10:2738
msgctxt "text_id=4113 | speaker=unknown"
msgid "  Her thoughts spun out as she tried to come up with a Plan B."
msgstr "　混乱する思考のまま、迅速に打開策を模索する。"

#. Occurrence 5A_10:2743:4114: scene=5A_10
#: 5A_10:2743
msgctxt "text_id=4114 | speaker=unknown"
msgid "  All she knew for sure was that this was a pivotal moment."
msgstr "　はっきりしているのは、ここが勝敗の分かれ目というコトだけ。"

#. Occurrence 5A_10:2770:4115: scene=5A_10
#: 5A_10:2770
msgctxt "text_id=4115 | speaker=unknown"
msgid "  If she continued standing still, she had seconds left at most."
msgstr "　このまま足を止めていれば十秒ほどで追いつかれる。"

#. Occurrence 5A_10:2775:4116: scene=5A_10
#: 5A_10:2775
msgctxt "text_id=4116 | speaker=unknown"
msgid "  Even in her current state, she knew she could easily neutralize the Bounded Field blocking the entrance without casting a spell. All she had to do was feed a little of her own energy into it."
msgstr "　入り口の<結界|かべ>は今の青子でも小指一本で解除できる<稚拙さ|レベル>だ。魔術と言わず、魔力を流すだけで中和できる。"

#. Occurrence 5A_10:2780:4117: scene=5A_10
#: 5A_10:2780
msgctxt "text_id=4117 | speaker=unknown"
msgid "  Aoko could sprint with all her might for a little more than three minutes."
msgstr "　青子が全力で走り続けられるのは三分強。"

#. Occurrence 5A_10:2785:4118: scene=5A_10
#: 5A_10:2785
msgctxt "text_id=4118 | speaker=unknown"
msgid "  The puppet had far more stamina than she did."
msgstr "　<我慢|スタミナ>比べはどう見ても人形に分がある。"

#. Occurrence 5A_10:2848:4119: scene=5A_10
#: 5A_10:2848
msgctxt "text_id=4119 | speaker=unknown"
msgid "  She could only come up with three options."
msgstr "　考えられる選択肢は三つ。"

#. Occurrence 5A_10:2853:4120: scene=5A_10
#: 5A_10:2853
msgctxt "text_id=4120 | speaker=unknown"
msgid "  The first was to escape through the exit in front of her."
msgstr "　一つ、出口は目の前、外に逃げる。"

#. Occurrence 5A_10:2858:4121: scene=5A_10
#: 5A_10:2858
msgctxt "text_id=4121 | speaker=unknown"
msgid "  The second was to hide somewhere on the more complicated first floor."
msgstr "　二つ、二階より複雑な一階の迷路に身を隠す。"

#. Occurrence 5A_10:2863:4122: scene=5A_10
#: 5A_10:2863
msgctxt "text_id=4122 | speaker=unknown"
msgid "  And the third was to run into the basement and be stuck like a rat in a trap."
msgstr "　三つ、地下に走って、袋のネズミとばかりに、あの人形に追いつめられる―――"

#. Occurrence 5A_10:2898:4123: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0015; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:2898
msgctxt "text_id=4123 | speaker=aoko"
msgid "\"Well, that's obvious enough.\""
msgstr "「―――なんだ、考えるまでもない」"

#. Occurrence 5A_10:2904:4124: scene=5A_10
#: 5A_10:2904
msgctxt "text_id=4124 | speaker=unknown"
msgid "  She made her decision with zero hesitation,"
msgstr "　決断はまたたきの内に。"

#. Occurrence 5A_10:2909:4125: scene=5A_10
#: 5A_10:2909
msgctxt "text_id=4125 | speaker=unknown"
msgid "  moving her stiff legs again with determined strength."
msgstr "　立ちつくしていた両足には確かな力。"

#. Occurrence 5A_10:2914:4126: scene=5A_10
#: 5A_10:2914
msgctxt "text_id=4126 | speaker=unknown"
msgid "  The oncoming storm was almost upon her."
msgstr "　嵐はもう頭上に迫っている。"

#. Occurrence 5A_10:2950:4127: scene=5A_10
#: 5A_10:2950
msgctxt "text_id=4127 | speaker=unknown"
msgid "  Her resolve firm, she turned and ran, descending into the darkness."
msgstr "　意を決して、少女は眼下の暗闇に向かって走りだした。"

#. Occurrence 5A_11:56:4128: scene=5A_11
#: 5A_11:56
msgctxt "text_id=4128 | speaker=unknown"
msgid "    No matter what, a finale should be glorious."
msgstr "　　何であれ、<終局|フィナーレ>は華やかに。"

#. Occurrence 5A_11:61:4129: scene=5A_11
#: 5A_11:61
msgctxt "text_id=4129 | speaker=unknown"
msgid "    This would be the mirror castle's final scene."
msgstr "　　鏡の城に最後の見せ場が訪れる。"

#. Occurrence 5A_11:83:4130: scene=5A_11
#: 5A_11:83
msgctxt "text_id=4130 | speaker=unknown"
msgid "  Two humans and a puppet."
msgstr "　入場者は二人プラス一体。"

#. Occurrence 5A_11:88:4131: scene=5A_11
#: 5A_11:88
msgctxt "text_id=4131 | speaker=unknown"
msgid "  A young sorceress ran toward the subterranean heart of the castle,"
msgstr "　魔法使いの少女は城の心臓部である地下に走り、"

#. Occurrence 5A_11:93:4132: scene=5A_11
#: 5A_11:93
msgctxt "text_id=4132 | speaker=unknown"
msgid "  while an autonomous antique chased its prey into the depths of a demonic dungeon."
msgstr "　自律するアンティークは少女を追いかけて魔のダンジョンへ。"

#. Occurrence 5A_11:306:4133: scene=5A_11
#: 5A_11:306
msgctxt "text_id=4133 | speaker=unknown"
msgid "  A minute later, a faint, blue charge would ripple through the castle."
msgstr "　一分の<後|のち>、城には微弱な青い電荷が走り抜けた。"

#. Occurrence 5A_11:312:4134: scene=5A_11
#: 5A_11:312
msgctxt "text_id=4134 | speaker=unknown"
msgid "  This was the main pillar in the deepest depths of the basement."
msgstr "　地下一階、最深最奥のメインピラー。"

#. Occurrence 5A_11:317:4135: scene=5A_11
#: 5A_11:317
msgctxt "text_id=4135 | speaker=unknown"
msgid "  Though not critical to the castle's structure, the pillar was a visible symbol of it. The girl concentrated her magical energy into a fist and thrust it at the pillar."
msgstr "　城を支えているワケではないけれど、象徴であった柱を、少女は渾身の魔力をこめた拳で打ち叩いた。"

#. Occurrence 5A_11:473:4136: scene=5A_11
#: 5A_11:473
msgctxt "text_id=4136 | speaker=unknown"
msgid "  This was the blow that would bring down the castle."
msgstr "　この一撃で鏡の城は崩れ去る。"

#. Occurrence 5A_11:478:4137: scene=5A_11
#: 5A_11:478
msgctxt "text_id=4137 | speaker=unknown"
msgid "  She imagined the destruction as she threw the punch, and that scene blossomed into reality seconds later."
msgstr "　そんなイメージの元に放った<正拳|ストレート>は、数秒の後、イメージを真実に変換する。"

#. Occurrence 5A_11:483:4138: scene=5A_11
#: 5A_11:483
msgctxt "text_id=4138 | speaker=unknown"
msgid "  It was simple ignition magecraft, meant to release the condensed magical energy engraved into the four pillars at the corners of the structure."
msgstr "　城の四方の柱、地盤に刻まれた魔力を圧縮、解放させるだけの単純な発火魔術。"

#. Occurrence 5A_11:519:4139: scene=5A_11
#: 5A_11:519
msgctxt "text_id=4139 | speaker=unknown"
msgid "  Using electricity as a switch meant virtually instantaneous activation."
msgstr "　仕掛けは電荷をスイッチにして、ほぼ同時に発動し―――"

#. Occurrence 5A_11:864:4140: scene=5A_11
#: 5A_11:864
msgctxt "text_id=4140 | speaker=unknown"
msgid "  It happened swiftly and elegantly― "
msgstr "　<緩|ゆる>やかに、<速|すみ>やかに。"

#. Occurrence 5A_11:869:4141: scene=5A_11
#: 5A_11:869
msgctxt "text_id=4141 | speaker=unknown"
msgid "  a hammer of destruction descended upon the castle of dreams that had stubbornly resisted its fate for two years."
msgstr "　二年もの歳月、かたくなに滅びを<拒|こば>んだ夢の城に、臨終の<槌|つち>が下ろされる。"

#. Occurrence 5A_11:1037:4142: scene=5A_11
#: 5A_11:1037
msgctxt "text_id=4142 | speaker=unknown"
msgid "  It was almost a joyous sound."
msgstr "　―――それは、喜びに似た音だった。"

#. Occurrence 5A_11:1043:4143: scene=5A_11
#: 5A_11:1043
msgctxt "text_id=4143 | speaker=unknown"
msgid "  And so, the lifeless and abandoned castle of mirrors set the stage for its final and most spectacular performance."
msgstr "　とうに命を失い、訪れる者のいなくなった鏡の城が迎えた、最後にして最大のショウタイム。"

#. Occurrence 5A_11:1048:4144: scene=5A_11
#: 5A_11:1048
msgctxt "text_id=4144 | speaker=unknown"
msgid "  Aoko's magical energy became an electrical charge that activated the magecraft formula engraved into the pillar. The chain reaction would lead to the castle's destruction."
msgstr "　青子の魔力は電荷となって支柱に刻まれた魔術式を起動させ、連鎖的に、建物の息の根を止めていく。"

#. Occurrence 5A_11:1183:4145: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0000; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:1183
msgctxt "text_id=4145 | speaker=aoko"
msgid "\"...You served your purpose."
msgstr "「……ごくろうさま。"

#. Occurrence 5A_11:1189:4146: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0001; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:1189
msgctxt "text_id=4146 | speaker=aoko"
msgid "  But it must've been rough. Looks like you're gonna collapse anytime now.\""
msgstr "　でも、思ってたよりくたびれてたのね。これじゃ一分<保|も>つかどうか」"

#. Occurrence 5A_11:1199:4147: scene=5A_11
#: 5A_11:1199
msgctxt "text_id=4147 | speaker=unknown"
msgid "  The plaza in the center of the basement."
msgstr "　地下一階の中央広場。"

#. Occurrence 5A_11:1204:4148: scene=5A_11
#: 5A_11:1204
msgctxt "text_id=4148 | speaker=unknown"
msgid "  Aoko tried to steady her breathing while rotating her Magic Crest at full speed."
msgstr "　呼吸を整えながら、青子は魔術刻印をフル回転させる。"

#. Occurrence 5A_11:1209:4149: scene=5A_11
#: 5A_11:1209
msgctxt "text_id=4149 | speaker=unknown"
msgid "  She wreathed her arms in blue light, fully aware that she could no longer activate another formula."
msgstr "　魔術式を組めないのを承知の上で、その両手に青い光をまとわせる。"

#. Occurrence 5A_11:1393:4150: scene=5A_11
#: 5A_11:1393
msgctxt "text_id=4150 | speaker=unknown"
msgid "  Her labored breathing refused to settle."
msgstr "　……乱れた呼吸は簡単には治まらない。"

#. Occurrence 5A_11:1398:4151: scene=5A_11
#: 5A_11:1398
msgctxt "text_id=4151 | speaker=unknown"
msgid "  She stood at the center of the basement."
msgstr "　地下一階の中心。"

#. Occurrence 5A_11:1403:4152: scene=5A_11
#: 5A_11:1403
msgctxt "text_id=4152 | speaker=unknown"
msgid "  Without being spotted even once, she had managed to make it all the way to the central pillar. It was a hundred-meter dash in thirteen seconds flat―undoubtedly a new personal best."
msgstr "　中心の柱にたどり着くまで、彼女は追跡者に背中を見せることなく走りきったのだ。百メートル走十三秒の俊足は間違いなく自己記録を更新した。"

#. Occurrence 5A_11:1408:4153: scene=5A_11
#: 5A_11:1408
msgctxt "text_id=4153 | speaker=unknown"
msgid "  She spurred on her weakened heart, knowing full well the fate that awaited her."
msgstr "　その先に待っているのが<こ|・><の|・><状|・><況|・>だと承知した上で、あえぐ心臓に鞭を打った。"

#. Occurrence 5A_11:1519:4154: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0002; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:1519
msgctxt "text_id=4154 | speaker=aoko"
msgid "\"It can't help but follow me. And once down here, there'll be no escape."
msgstr "「……入れば追ってくる。地下に行けば逃げられない。"

#. Occurrence 5A_11:1525:4155: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0003; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:1525
msgctxt "text_id=4155 | speaker=aoko"
msgid "  I should've expected that. It was too much to expect that I could keep up the chase forever.\""
msgstr "　当然よね。最後まで逃げ回ろうなんて、虫のいい話だった」"

#. Occurrence 5A_11:1531:4156: scene=5A_11
#: 5A_11:1531
msgctxt "text_id=4156 | speaker=unknown"
msgid "  Hindsight was 20/20."
msgstr "　反省するわ、と青子は物言わぬ<人形|じぶん>に語りかける。"

#. Occurrence 5A_11:1675:4157: scene=5A_11
#: 5A_11:1675
msgctxt "text_id=4157 | speaker=unknown"
msgid "  The castle was only a minute away from collapsing completely."
msgstr "　城が完全に崩れるまで残り一分。"

#. Occurrence 5A_11:1680:4158: scene=5A_11
#: 5A_11:1680
msgctxt "text_id=4158 | speaker=unknown"
msgid "  If they stayed here, they would both be crushed by the rubble."
msgstr "　ここに留まるかぎり、どちらも瓦礫の下敷きだ。"

#. Occurrence 5A_11:1685:4159: scene=5A_11
#: 5A_11:1685
msgctxt "text_id=4159 | speaker=unknown"
msgid "  The puppet certainly did not care."
msgstr "　あの人形にとってはそれでオッケー。"

#. Occurrence 5A_11:1690:4160: scene=5A_11
#: 5A_11:1690
msgctxt "text_id=4160 | speaker=unknown"
msgid "  With no life of its own, its sole concern was the elimination of its target, Aoko Aozaki."
msgstr "　もとより命のないモノ、標的である蒼崎青子を殺す事だけが彼女の<目的|ねがい>なのだから。"

#. Occurrence 5A_11:1744:4161: scene=5A_11
#: 5A_11:1744
msgctxt "text_id=4161 | speaker=unknown"
msgid "  ...Indeed."
msgstr "　……そう。"

#. Occurrence 5A_11:1749:4162: scene=5A_11
#: 5A_11:1749
msgctxt "text_id=4162 | speaker=unknown"
msgid "  The enemy had been willing to die from the start."
msgstr "　要するに、敵だけが初めから必死だった。"

#. Occurrence 5A_11:1754:4163: scene=5A_11
#: 5A_11:1754
msgctxt "text_id=4163 | speaker=unknown"
msgid "  She resented her own lack of resolve."
msgstr "　決意の甘さに<憤慨|ふんがい>する。"

#. Occurrence 5A_11:1759:4164: scene=5A_11
#: 5A_11:1759
msgctxt "text_id=4164 | speaker=unknown"
msgid "  It wasn't like her to tuck tail and run from an opponent that didn't fear death."
msgstr "　もろとも死ぬ事さえいとわない相手に尻尾を巻くなんて、あまりに自分らしくなかったな、と。"

#. Occurrence 5A_11:1818:4165: voice_id=C40_5A_11_0000_C; voice_prefix=C40; voice_category=0; scene=5A_11
#: 5A_11:1818
msgctxt "text_id=4165 | speaker=unknown"
msgid "                    \"<Vivo in somno. Solitarie putresco in inferis|In slumber, I live. In dirt, I rot.>."
msgstr "　　 “<Vivo in somno. Solitarie putresco in inferis|私は眠りの中で生きている。ひとりきりで土の中で腐っていく。>."

#. Occurrence 5A_11:1818:4166: voice_id=C40_5A_11_0000_C; voice_prefix=C40; voice_category=0; scene=5A_11
#: 5A_11:1818
msgctxt "text_id=4166 | speaker=unknown"
msgid "        <Hic dies meus obitus dies, et meus nativus dies. Te obeam.|Today is the day I died and was born. Now I come to you.>\""
msgstr "@o<Hic dies meus obitus dies, et meus nativus dies. Te obeam.|今日は私の命日であり、誕生日だ。さあ、貴方に会いに行こう。>”"

#. Occurrence 5A_11:1839:4167: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0004; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:1839
msgctxt "text_id=4167 | speaker=aoko"
msgid "(Hmph. It's always been on a suicide mission, huh."
msgstr "“……ふん。そもそも自爆覚悟じゃない、アレ。"

#. Occurrence 5A_11:1845:4168: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0005; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:1845
msgctxt "text_id=4168 | speaker=aoko"
msgid "  It doesn't have enough juice to power the six-legged form and the Finn Shots. The curses aren't recharging it fast enough.)"
msgstr "　六足歩行とフィンの一撃は<使|・><い|・><す|・><ぎ|・>よ。もう呪詛による魔力補給じゃ間に合わない”"

#. Occurrence 5A_11:1867:4169: scene=5A_11
#: 5A_11:1867
msgctxt "text_id=4169 | speaker=unknown"
msgid "  Such a perpetual motion device was only as good as its ability to regulate its energy consumption."
msgstr "　……そう。永久機関と言っても、それは魔力の消費量を抑えてこその永久機関だ。"

#. Occurrence 5A_11:1872:4170: scene=5A_11
#: 5A_11:1872
msgctxt "text_id=4170 | speaker=unknown"
msgid "  Using so many functions at once meant it was burning through fuel quickly and losing the ability to process the curses that powered it."
msgstr "　あれだけの機巧を使えば燃料はすぐにカラになり、電力である呪詛を回す事もできなくなる。"

#. Occurrence 5A_11:1877:4171: scene=5A_11
#: 5A_11:1877
msgctxt "text_id=4171 | speaker=unknown"
msgid "  It was using up all of the functions it had been given to achieve its aim."
msgstr "　<人形|かのじょ>は与えられた機能を、目的の為に燃やし尽くす。"

#. Occurrence 5A_11:1882:4172: scene=5A_11
#: 5A_11:1882
msgctxt "text_id=4172 | speaker=unknown"
msgid "  This was the pride of a tool, if such things could have ego. Those endowed with sentience could never hope to understand."
msgstr "　それは知恵あるものでは届かない器物の誇り。"

#. Occurrence 5A_11:1887:4173: scene=5A_11
#: 5A_11:1887
msgctxt "text_id=4173 | speaker=unknown"
msgid "  A beast born to do nothing but run would burn any human who faced its resolve."
msgstr "　走る為だけに生まれた獣の覚悟に、人が触れれば火傷する。"

#. Occurrence 5A_11:1987:4174: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0006; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:1987
msgctxt "text_id=4174 | speaker=aoko"
msgid "\"...It's a waste when you think about it."
msgstr "“……ホント、勿体ない。"

#. Occurrence 5A_11:1993:4175: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0007; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:1993
msgctxt "text_id=4175 | speaker=aoko"
msgid "  I thought my sister was the only one capable of something this reckless, but I guess I was wrong.\""
msgstr "　こういう無茶をするのは姉貴だけかと思ってたけど、いるところにはいるもんね”"

#. Occurrence 5A_11:2093:4176: scene=5A_11
#: 5A_11:2093
msgctxt "text_id=4176 | speaker=unknown"
msgid "  But Aoko did not intend a sacrifice play here."
msgstr "　だが、共倒れになる気は毛頭無い。"

#. Occurrence 5A_11:2098:4177: scene=5A_11
#: 5A_11:2098
msgctxt "text_id=4177 | speaker=unknown"
msgid "  She respected her adversary now, and she was done regretting her choices."
msgstr "　反省は済ませたし、敬意も払ったし。"

#. Occurrence 5A_11:2103:4178: scene=5A_11
#: 5A_11:2103
msgctxt "text_id=4178 | speaker=unknown"
msgid "  There was no time to waste."
msgstr "　時間もないしいい加減、"

#. Occurrence 5A_11:2168:4179: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0008; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:2168
msgctxt "text_id=4179 | speaker=aoko"
msgid "\"This is it. This ends now.\""
msgstr "「行くわよ。ここで、きっかり―――」"

#. Occurrence 5A_11:2249:4180: scene=5A_11
#: 5A_11:2249
msgctxt "text_id=4180 | speaker=unknown"
msgid "  Aoko had every intention of paying it back double for what it had done to her."
msgstr "　たまったツケを、倍にして返してやる―――！"

#. Occurrence 5A_11:2306:4181: scene=5A_11
#: 5A_11:2306
msgctxt "text_id=4181 | speaker=unknown"
msgid "  The energy Aoko had accumulated exploded out of her right leg."
msgstr "　溜めに溜めた力を、<右脚|みぎあし>に爆発させる。"

#. Occurrence 5A_11:2311:4182: scene=5A_11
#: 5A_11:2311
msgctxt "text_id=4182 | speaker=unknown"
msgid "  She aimed for a single thing: a head-on attack!"
msgstr "　狙いは一点、正面からの直接打撃―――！"

#. Occurrence 5A_11:2407:4183: scene=5A_11
#: 5A_11:2407
msgctxt "text_id=4183 | speaker=unknown"
msgid "  The enemy responded with a lethal curse that reached for her heart like a set of talons."
msgstr "　迎え撃つは心臓を<鷲掴|わしづか>む呪いの一撃。"

#. Occurrence 5A_11:2412:4184: scene=5A_11
#: 5A_11:2412
msgctxt "text_id=4184 | speaker=unknown"
msgid "  Humming with power, it meant to rend Aoko's heart and burn itself out in the process."
msgstr "　燃え尽きる事を恐れない、最大出力の心臓破り。"

#. Occurrence 5A_11:2419:4185: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0009; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:2419
msgctxt "text_id=4185 | speaker=aoko"
msgid "\"Hup!\""
msgstr "“―――っ、フッ―――！”"

#. Occurrence 5A_11:2425:4186: scene=5A_11
#: 5A_11:2425
msgctxt "text_id=4186 | speaker=unknown"
msgid "  As soon as she saw it, Aoko kicked the floor as hard as she could."
msgstr "　それを視認したのと同時に、青子は全力で床を蹴った。"

#. Occurrence 5A_11:2509:4187: scene=5A_11
#: 5A_11:2509
msgctxt "text_id=4187 | speaker=unknown"
msgid "  Her long hair swirled through the air as she flipped aside."
msgstr "　長い髪を尾のようになびかせて、少女の体は真横に<踊|おど>る。"

#. Occurrence 5A_11:2530:4188: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0010; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:2530
msgctxt "text_id=4188 | speaker=aoko"
msgid "\"...Hnngh!\""
msgstr "「っ、き―――」"

#. Occurrence 5A_11:2536:4189: scene=5A_11
#: 5A_11:2536
msgctxt "text_id=4189 | speaker=unknown"
msgid "  This lateral move almost sent her tumbling to the ground, but a quick swing of her arm allowed her to regain her balance."
msgstr "　無理やりな横移動で崩れる<体勢|からだ>を、腕の振りで転ばずに持ち直す。"

#. Occurrence 5A_11:2577:4190: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0011; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:2577
msgctxt "text_id=4190 | speaker=aoko"
msgid "\"...!\""
msgstr "「っ……！」"

#. Occurrence 5A_11:2625:4191: scene=5A_11
#: 5A_11:2625
msgctxt "text_id=4191 | speaker=unknown"
msgid "  A shot grazed her arm,"
msgstr "　散弾が肩をかすめる。"

#. Occurrence 5A_11:2630:4192: scene=5A_11
#: 5A_11:2630
msgctxt "text_id=4192 | speaker=unknown"
msgid "  the curse scorching her left shoulder."
msgstr "　呪詛をうけた左肩が白熱する。"

#. Occurrence 5A_11:2635:4193: scene=5A_11
#: 5A_11:2635
msgctxt "text_id=4193 | speaker=unknown"
msgid "  She did not flinch. Aoko knew she could hold on as long as she continued to avoid a direct Finn Shot."
msgstr "　構わない。どんな不利な体勢になろうと、“フィンの一撃”の直撃だけは回避する―――！"

#. Occurrence 5A_11:2705:4194: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0012; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:2705
msgctxt "text_id=4194 | speaker=aoko"
msgid "\"...!\""
msgstr "「―――！」"

#. Occurrence 5A_11:2713:4195: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0013; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:2713
msgctxt "text_id=4195 | speaker=aoko"
msgid "\"Snap!\""
msgstr "“<弾いて|スナップ>……！”"

#. Occurrence 5A_11:2802:4196: scene=5A_11
#: 5A_11:2802
msgctxt "text_id=4196 | speaker=unknown"
msgid "  Off balance and in pain, it took her half a second to recover."
msgstr "　痛みとバランスの乱れから、立ち直るのに０．５秒。"

#. Occurrence 5A_11:2807:4197: scene=5A_11
#: 5A_11:2807
msgctxt "text_id=4197 | speaker=unknown"
msgid "  The moment she raised her head, she deflected the attack with a fist full of magical energy."
msgstr "　顔を上げた瞬間、目前に迫る凶器を、魔力を帯びた拳で殴り<弾|はじ>く。"

#. Occurrence 5A_11:2908:4198: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0014; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:2908
msgctxt "text_id=4198 | speaker=aoko"
msgid "\"Here goes...!\""
msgstr "「せー、のぉ……！」"

#. Occurrence 5A_11:2913:4199: scene=5A_11
#: 5A_11:2913
msgctxt "text_id=4199 | speaker=unknown"
msgid "  If the puppet had a will of its own, its eyes would have popped right out of its sockets."
msgstr "　人形に意志があったのなら、間違いなく目を見張っただろう。"

#. Occurrence 5A_11:2918:4200: scene=5A_11
#: 5A_11:2918
msgctxt "text_id=4200 | speaker=unknown"
msgid "  It would have been floored."
msgstr "　驚嘆すべきは。"

#. Occurrence 5A_11:2923:4201: scene=5A_11
#: 5A_11:2923
msgctxt "text_id=4201 | speaker=unknown"
msgid "  Shocked at the strong will that allowed this girl to perform a series of moves like this."
msgstr "　その一連の動作をしながらも、足を止めない彼女の意志の強さだった。"

#. Occurrence 5A_11:3011:4202: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0015; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:3011
msgctxt "text_id=4202 | speaker=aoko"
msgid "\"Crack!\""
msgstr "“<砕いて|クラック>……！”"

#. Occurrence 5A_11:3122:4203: scene=5A_11
#: 5A_11:3122
msgctxt "text_id=4203 | speaker=unknown"
msgid "  Aoko's response was instantaneous."
msgstr "　コンマの世界で弾かれる凶器。"

#. Occurrence 5A_11:3127:4204: scene=5A_11
#: 5A_11:3127
msgctxt "text_id=4204 | speaker=unknown"
msgid "  While her power was not sufficient to completely redirect the arm's trajectory, it was just enough to deflect it harmlessly past her hair."
msgstr "　少女の力では完全に弾ききれず、凶器はわずかに軌道を逸らし、長い髪をさらっていく。"

#. Occurrence 5A_11:3210:4205: voice_id=C40_5A_11_0001_C; voice_prefix=C40; voice_category=0; scene=5A_11
#: 5A_11:3210
msgctxt "text_id=4205 | speaker=unknown"
msgid "\"...<Initio erraveramus. Dum vivimus dolores sunt|It was all a mistake. I should have never been born.>."
msgstr "@o“―――<Initio erraveramus. Dum vivimus dolores sunt|すべてが間違いだったのです。生まれなければ良かったのです。>."

#. Occurrence 5A_11:3210:4206: voice_id=C40_5A_11_0001_C; voice_prefix=C40; voice_category=0; scene=5A_11
#: 5A_11:3210
msgctxt "text_id=4206 | speaker=unknown"
msgid "<Nemo adiuvat. Nemo adiuvat. Nemo adiuvat.|Atone for me! Atone for me! Atone for me!>\""
msgstr "<Nemo adiuvat. Nemo adiuvat. Nemo adiuvat.|誰か私を償って。償って。償って。償って。償って。償って。償って。償って。償って―――！>”"

#. Occurrence 5A_11:3216:4207: scene=5A_11
#: 5A_11:3216
msgctxt "text_id=4207 | speaker=unknown"
msgid "  The chant became a curse that robbed Aoko of her vitality."
msgstr "　詠唱は呪いとなって青子から気力を奪う。"

#. Occurrence 5A_11:3275:4208: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0016; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:3275
msgctxt "text_id=4208 | speaker=aoko"
msgid "\"...!\""
msgstr "「―――ハ」"

#. Occurrence 5A_11:3312:4209: scene=5A_11
#: 5A_11:3312
msgctxt "text_id=4209 | speaker=unknown"
msgid "  Did it still have something left in the tank, or was it actually indignant?"
msgstr "　こぼれたのは余裕か怒りか。"

#. Occurrence 5A_11:3317:4210: scene=5A_11
#: 5A_11:3317
msgctxt "text_id=4210 | speaker=unknown"
msgid "  Whatever the reason, Aoko was easily able to resist its weakened defensive maneuver..."
msgstr "　あまりにも脆弱な防衛機能を気迫で<嚥下|レジスト>し、"

#. Occurrence 5A_11:3491:4211: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0017; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:3491
msgctxt "text_id=4211 | speaker=aoko"
msgid "\"Glider!\""
msgstr "“蹴<り上げ|グライダー>る……！”"

#. Occurrence 5A_11:3497:4212: scene=5A_11
#: 5A_11:3497
msgctxt "text_id=4212 | speaker=unknown"
msgid "  ...And her right leg, pulsing with magical energy, shot up into the puppet's chest from below."
msgstr "　魔力を帯びた渾身の右脚が、人形の<心|む><臓|ね>を打ち上げる！"

#. Occurrence 5A_11:3728:4213: scene=5A_11
#: 5A_11:3728
msgctxt "text_id=4213 | speaker=unknown"
msgid "  It was much lighter than Aoko anticipated."
msgstr "　人形の軽さは青子の予想以上だった。"

#. Occurrence 5A_11:3733:4214: scene=5A_11
#: 5A_11:3733
msgctxt "text_id=4214 | speaker=unknown"
msgid "  Or rather, she felt little resistance."
msgstr "　いや、重さではなく力が無かった、と言うべきか。"

#. Occurrence 5A_11:3738:4215: scene=5A_11
#: 5A_11:3738
msgctxt "text_id=4215 | speaker=unknown"
msgid "  An automaton's weight was determined by its internals―the size of its power source."
msgstr "　自動人形の重量はその内部構造―――動力源の大小によって決定される。"

#. Occurrence 5A_11:3743:4216: scene=5A_11
#: 5A_11:3743
msgctxt "text_id=4216 | speaker=unknown"
msgid "  Ironically, it was the superiority of its music box engine that would prove to be its downfall."
msgstr "　自動<詠唱永久|オルゴールエンジン>機関を持つこのオートマタは、皮肉な事に、その優秀さがアダになったのだ。"

#. Occurrence 5A_11:3812:4217: voice_id=C40_5A_11_0002_C; voice_prefix=C40; voice_category=0; scene=5A_11
#: 5A_11:3812
msgctxt "text_id=4217 | speaker=unknown"
msgid "\"...<Venite, Venite, Venite, meum sepulchrum veniteeeeeeee|Welcome! Welcome! Welcome to my graaaaaave>...\""
msgstr "“……<Venite, Venite, Venite, meum sepulchrum|いらっしゃい、いらっしゃい、私の墓穴に、> ^<veniteeeeeeee……|いらっしゃいいいいいい……>”"

#. Occurrence 5A_11:3933:4218: scene=5A_11
#: 5A_11:3933
msgctxt "text_id=4218 | speaker=unknown"
msgid "  A stuttering curse."
msgstr "　途切れ途切れの呪詛。"

#. Occurrence 5A_11:3938:4219: scene=5A_11
#: 5A_11:3938
msgctxt "text_id=4219 | speaker=unknown"
msgid "  Having taken the full brunt of Aoko's kick, the puppet bounced from ceiling to floor, collapsing in a heap."
msgstr "　青子の蹴りと天井への衝突、とどめに落下の衝撃で、人形はほぼ停止していた。"

#. Occurrence 5A_11:3943:4220: scene=5A_11
#: 5A_11:3943
msgctxt "text_id=4220 | speaker=unknown"
msgid "  Its internal construction had been warped by the impact, leaving the drum of the music box that powered the puppet warped as well."
msgstr "　内部構造に歪みが生じ、動力源である<自動詠唱|オルゴール>のドラムが歪んでしまったのだ。"

#. Occurrence 5A_11:3971:4221: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0018; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:3971
msgctxt "text_id=4221 | speaker=aoko"
msgid "\"Take your design flaws up with your maker."
msgstr "「恨むなら設計者を恨みなさい。"

#. Occurrence 5A_11:3979:4222: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0019_0; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:3979
msgctxt "text_id=4222 | speaker=aoko"
msgid "A single dynamo would have been all you needed to―"
msgstr "ダイナモの一つでも積んでいれば、もうちょっとは重たくなったでしょうに……"

#. Occurrence 5A_11:3986:4223: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0019_1; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:3986
msgctxt "text_id=4223 | speaker=aoko"
msgid "Wait, what the―!?\""
msgstr "って、うわ!?」"

#. Occurrence 5A_11:4098:4224: scene=5A_11
#: 5A_11:4098
msgctxt "text_id=4224 | speaker=unknown"
msgid "  Part of the ceiling came crashing down in front of Aoko, snapping her back to her senses."
msgstr "　目の前に落ちてきた天井の衝撃で、青子は正しい意識を取り戻した。"

#. Occurrence 5A_11:4104:4225: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0020; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:4104
msgctxt "text_id=4225 | speaker=aoko"
msgid "(...Did I really just take her out?)"
msgstr "“……ところでいま、どうやってぶっ倒したんだろう？”"

#. Occurrence 5A_11:4109:4226: scene=5A_11
#: 5A_11:4109
msgctxt "text_id=4226 | speaker=unknown"
msgid "  She was so stunned by her own victory that she forgot the house of mirrors had already begun to collapse."
msgstr "　と首をかしげるほど無我夢中だったので失念していたが、ミラーハウスの倒壊はもう始まっている。"

#. Occurrence 5A_11:4147:4227: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0021; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:4147
msgctxt "text_id=4227 | speaker=aoko"
msgid "\"I've gotta get out of here!\""
msgstr "「って、こっちのがやばかった……！」"

#. Occurrence 5A_11:4299:4228: scene=5A_11
#: 5A_11:4299
msgctxt "text_id=4228 | speaker=unknown"
msgid "  There was no time to relish in her victory or pity her opponent."
msgstr "　勝利の余韻にひたっている場合でも、同情している余裕もない。"

#. Occurrence 5A_11:4304:4229: scene=5A_11
#: 5A_11:4304
msgctxt "text_id=4229 | speaker=unknown"
msgid "  Not unless she wanted to meet the same fate."
msgstr "　このままだと数秒後には同じ運命。"

#. Occurrence 5A_11:4309:4230: scene=5A_11
#: 5A_11:4309
msgctxt "text_id=4230 | speaker=unknown"
msgid "  As the situation stood, she found it hard to imagine getting out alive."
msgstr "　青子自身、生還できる未来をイメージできないほど、状況は壊滅的だ。"

#. Occurrence 5A_11:4342:4231: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0022; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:4342
msgctxt "text_id=4231 | speaker=aoko"
msgid "\"Get a move on, Aoko!\""
msgstr "「急げ、ダッシュだ私……！」"

#. Occurrence 5A_11:4361:4232: scene=5A_11
#: 5A_11:4361
msgctxt "text_id=4232 | speaker=unknown"
msgid "  She clapped herself on the cheeks to motivate herself anew."
msgstr "　それでも最善を尽くそうと頬を叩く。"

#. Occurrence 5A_11:4366:4233: scene=5A_11
#: 5A_11:4366
msgctxt "text_id=4233 | speaker=unknown"
msgid "  This was her bounty for finishing their battle in a matter of seconds."
msgstr "　わずか数秒間の交戦の報酬。"

#. Occurrence 5A_11:4371:4234: scene=5A_11
#: 5A_11:4371
msgctxt "text_id=4234 | speaker=unknown"
msgid "  Her breath ragged with excitement, Aoko ran for the exit."
msgstr "　興奮と緊張で乱れた呼吸もそのままに、青子は出口に向かって走りだした。"

#. Occurrence 5A_12:140:4235: scene=5A_12
#: 5A_12:140
msgctxt "text_id=4235 | speaker=unknown"
msgid "  The collapse was intensifying by the second."
msgstr "　秒単位で倒壊は激化していく。"

#. Occurrence 5A_12:145:4236: scene=5A_12
#: 5A_12:145
msgctxt "text_id=4236 | speaker=unknown"
msgid "  Having lost its support pillars, the castle was buckling under its own weight."
msgstr "　支柱を失った城は中心に折りたたまれるよう、自重によって潰れていく。"

#. Occurrence 5A_12:222:4237: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0000; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:222
msgctxt "text_id=4237 | speaker=aoko"
msgid "\"Out of my way!\""
msgstr "「この、邪魔……！」"

#. Occurrence 5A_12:334:4238: scene=5A_12
#: 5A_12:334
msgctxt "text_id=4238 | speaker=unknown"
msgid "  Escaping from the basement was proving to be no easy task."
msgstr "　なので、地下からの脱出は困難を極めた。"

#. Occurrence 5A_12:339:4239: scene=5A_12
#: 5A_12:339
msgctxt "text_id=4239 | speaker=unknown"
msgid "  While she was taking the shortest route possible through the maze, she was nearly crushed by a falling piece of the ceiling along the way."
msgstr "　迷路を最短距離で突っ切った青子だが、途中、崩落した天井に潰されかけたのが一度。"

#. Occurrence 5A_12:345:4240: scene=5A_12
#: 5A_12:345
msgctxt "text_id=4240 | speaker=unknown"
msgid "This was the second time―no, third―she had to deal with fallen rubble along the way."
msgstr "立ちふさがる瓦礫で一秒だけ足を止めたのが二度、いやこれで三度目。"

#. Occurrence 5A_12:500:4241: scene=5A_12
#: 5A_12:500
msgctxt "text_id=4241 | speaker=unknown"
msgid "  She destroyed the debris on the stairs with magic bullets as she ran."
msgstr "　階段に降り積もった瓦礫を、走りながらの魔弾によって粉砕する。"

#. Occurrence 5A_12:505:4242: scene=5A_12
#: 5A_12:505
msgctxt "text_id=4242 | speaker=unknown"
msgid "  The automaton's jamming had long since worn off."
msgstr "　既に、自動人形による<妨害電波|ジャミング>は途絶えている。"

#. Occurrence 5A_12:510:4243: scene=5A_12
#: 5A_12:510
msgctxt "text_id=4243 | speaker=unknown"
msgid "  The earlier attack had damaged the vast majority of its functions."
msgstr "　先ほどの攻防で人形はその大部分の機能を破損したからだ。"

#. Occurrence 5A_12:943:4244: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0001; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:943
msgctxt "text_id=4244 | speaker=aoko"
msgid "\"-, -!\""
msgstr "「―――、っ―――！」"

#. Occurrence 5A_12:949:4245: scene=5A_12
#: 5A_12:949
msgctxt "text_id=4245 | speaker=unknown"
msgid "  Aoko's breathing was heavy as she ran."
msgstr "　息を飲むように走る。"

#. Occurrence 5A_12:954:4246: scene=5A_12
#: 5A_12:954
msgctxt "text_id=4246 | speaker=unknown"
msgid "  Desperation sparked her brain into overdrive."
msgstr "　窮地における緊張から、脳は倍速で稼働する。"

#. Occurrence 5A_12:959:4247: scene=5A_12
#: 5A_12:959
msgctxt "text_id=4247 | speaker=unknown"
msgid "  The ceiling seemed to be collapsing in slow motion."
msgstr "　崩れていく天井が緩やかに流れていく。"

#. Occurrence 5A_12:967:4248: scene=5A_12
#: 5A_12:967
msgctxt "text_id=4248 | speaker=unknown"
msgid "  Life seemed to flash before her very eyes."
msgstr "　まるで死の<間際|まぎわ>の走馬灯。"

#. Occurrence 5A_12:972:4249: scene=5A_12
#: 5A_12:972
msgctxt "text_id=4249 | speaker=unknown"
msgid "  Each second stretched into five."
msgstr "　今の彼女には一秒が五秒に相当する。"

#. Occurrence 5A_12:977:4250: scene=5A_12
#: 5A_12:977
msgctxt "text_id=4250 | speaker=unknown"
msgid "  Her frayed nerves made it hard to tell the time."
msgstr "　研ぎ澄まされた神経が、体感時間を延長する。"

#. Occurrence 5A_12:1079:4251: scene=5A_12
#: 5A_12:1079
msgctxt "text_id=4251 | speaker=unknown"
msgid "  There was debris riddled throughout the stairway, forcing her to crawl up it."
msgstr "　倒壊する地下から、崩落する一階へ。"

#. Occurrence 5A_12:1084:4252: scene=5A_12
#: 5A_12:1084
msgctxt "text_id=4252 | speaker=unknown"
msgid "  She emerged from the destroyed basement into the collapsing first floor."
msgstr "　青子は瓦礫で埋もれかけた階段を這って上りきった。"

#. Occurrence 5A_12:1090:4253: scene=5A_12
#: 5A_12:1090
msgctxt "text_id=4253 | speaker=unknown"
msgid "  That the plaza was still traversable at all was a miracle in itself,"
msgstr "　広間はまだ開けているコト自体が奇跡で、"

#. Occurrence 5A_12:1090:4254: scene=5A_12
#: 5A_12:1090
msgctxt "text_id=4254 | speaker=unknown"
msgid "  and fortunately for her, the crucial path to the exit was still intact."
msgstr "　肝心の出口への通路は―――幸運な事に、まだ崩落していない……！"

#. Occurrence 5A_12:1207:4255: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0002; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:1207
msgctxt "text_id=4255 | speaker=aoko"
msgid "\"I made it!\""
msgstr "“よし、ついてる……！”"

#. Occurrence 5A_12:1213:4256: scene=5A_12
#: 5A_12:1213
msgctxt "text_id=4256 | speaker=unknown"
msgid "  The corridor to the entrance was still intact."
msgstr "　入り口通路は地下に沈まない。"

#. Occurrence 5A_12:1218:4257: scene=5A_12
#: 5A_12:1218
msgctxt "text_id=4257 | speaker=unknown"
msgid "  The basement maze only extended as far as the plaza, so the entrance corridor wouldn't collapse. Only the ceiling would cave in, leaving the scaffolding surround intact."
msgstr "　地下迷路があるのは広間までで、入り口通路は下に崩れようがないからだ。崩れるのは天井だけで、足場は最後まで残るはず。"

#. Occurrence 5A_12:1361:4258: scene=5A_12
#: 5A_12:1361
msgctxt "text_id=4258 | speaker=unknown"
msgid "  She got herself this far by telling herself repeatedly that fate would decide whether or not she reached the plaza."
msgstr "　なので、この運任せの脱出は広場まで辿り着けるかの勝負だ、と青子は自分に言い聞かせて突き進んできた。"

#. Occurrence 5A_12:1367:4259: scene=5A_12
#: 5A_12:1367
msgctxt "text_id=4259 | speaker=unknown"
msgid "  Her gamble paid off. It was her lucky day."
msgstr "　賭けは彼女の勝ちだ。幸運は青子に味方した。"

#. Occurrence 5A_12:1372:4260: scene=5A_12
#: 5A_12:1372
msgctxt "text_id=4260 | speaker=unknown"
msgid "  All she had to do was muster the last of her strength and keep moving forward until―"
msgstr "　ここからは残りの体力を総動員して、脇目もふらず外を目指せば―――"

#. Occurrence 5A_12:1420:4261: scene=5A_12
#: 5A_12:1420
msgctxt "text_id=4261 | speaker=unknown"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5A_12:1456:4262: scene=5A_12
#: 5A_12:1456
msgctxt "text_id=4262 | speaker=unknown"
msgid "  She hesitated for a fraction of a second."
msgstr "　時間にして０．２秒だけ、青子は足を止めかける。"

#. Occurrence 5A_12:1461:4263: scene=5A_12
#: 5A_12:1461
msgctxt "text_id=4263 | speaker=unknown"
msgid "  Was it naivety? A sense of responsibility?"
msgstr "　心の甘さか、責任か。"

#. Occurrence 5A_12:1514:4264: scene=5A_12
#: 5A_12:1514
msgctxt "text_id=4264 | speaker=unknown"
msgid "  She pushed aside the image that popped into her head and continued running down the corridor."
msgstr "　脳裏によぎったイメージを振り払って、彼女は通路に向かって走りだした。"

#. Occurrence 5A_12:1552:4265: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0004; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:1552
msgctxt "text_id=4265 | speaker=aoko"
msgid "\"...We don't have the luxury of coordinating the timing with each other to pull this off."
msgstr "“……言っとくけど時間合わせの余裕はないわよ。"

#. Occurrence 5A_12:1558:4266: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0005; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:1558
msgctxt "text_id=4266 | speaker=aoko"
msgid "  It's not the greatest plan in the world, but we both need to do our parts and get to the exit as quickly as possible.\""
msgstr "　そんな上等な作戦じゃないし。お互い、できるコトをやったら最速で出口に向かいましょう”"

#. Occurrence 5A_12:1580:4267: scene=5A_12
#: 5A_12:1580
msgctxt "text_id=4267 | speaker=unknown"
msgid "  That was five minutes ago."
msgstr "　たった五分前の話だ。"

#. Occurrence 5A_12:1585:4268: scene=5A_12
#: 5A_12:1585
msgctxt "text_id=4268 | speaker=unknown"
msgid "  At the time, Soujyuro had nodded with trepidation."
msgstr "　それに、彼は少しだけ不安そうに頷いた。"

#. Occurrence 5A_12:1590:4269: scene=5A_12
#: 5A_12:1590
msgctxt "text_id=4269 | speaker=unknown"
msgid "  And Aoko had not bothered to ask herself why."
msgstr "　あの顔は―――何に対してのものだったのか。"

#. Occurrence 5A_12:1651:4270: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0006; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:1651
msgctxt "text_id=4270 | speaker=aoko"
msgid "\"What are you spacing out for!? Just focus on running!\""
msgstr "“っ、なに様だっての私、今は走ることだけ考えろ……！”"

#. Occurrence 5A_12:1657:4271: scene=5A_12
#: 5A_12:1657
msgctxt "text_id=4271 | speaker=unknown"
msgid "  This corridor was giving out too."
msgstr "　この通路も、もう<保|も>たない。"

#. Occurrence 5A_12:1662:4272: scene=5A_12
#: 5A_12:1662
msgctxt "text_id=4272 | speaker=unknown"
msgid "  If she were to look back, she was sure she would see the building collapsing in on her."
msgstr "　振り向けば迷路側から崩れている事だろう。"

#. Occurrence 5A_12:1667:4273: scene=5A_12
#: 5A_12:1667
msgctxt "text_id=4273 | speaker=unknown"
msgid "  She was also sure she had no time to waste doing so."
msgstr "　そして、今は振り向く時間すら惜しい。"

#. Occurrence 5A_12:1785:4274: scene=5A_12
#: 5A_12:1785
msgctxt "text_id=4274 | speaker=unknown"
msgid "  Her luck was fading as fast as the building's structural integrity."
msgstr "　建物の強度的にはきっとギリギリで、自分の運も絶対ギリギリ。"

#. Occurrence 5A_12:1790:4275: scene=5A_12
#: 5A_12:1790
msgctxt "text_id=4275 | speaker=unknown"
msgid "  It was a small miracle that she had escaped serious injury up to this point, and she could not afford even the slightest slip-up."
msgstr "　ここまで無傷だった事がそもそも破格のヒロイン補正で、これ以上はどんなトラブルも背負えない。"

#. Occurrence 5A_12:1795:4276: scene=5A_12
#: 5A_12:1795
msgctxt "text_id=4276 | speaker=unknown"
msgid "  An ankle sprain, loss of balance, or even a sneeze would be fatal. A simple pat on the back was enough to end it."
msgstr "　足首の<捻挫|ねんざ>、<目眩|めまい>、くしゃみ、その程度ですら死に繋がる。後ろから肩を叩かれるだけでゲームオーバーだ。"

#. Occurrence 5A_12:1801:4277: scene=5A_12
#: 5A_12:1801
msgctxt "text_id=4277 | speaker=unknown"
msgid "  So, naturally..."
msgstr "　―――なので。"

#. Occurrence 5A_12:1920:4278: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0007; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:1920
msgctxt "text_id=4278 | speaker=aoko"
msgid "\"...Oh.\""
msgstr "「―――、あ」"

#. Occurrence 5A_12:1926:4279: scene=5A_12
#: 5A_12:1926
msgctxt "text_id=4279 | speaker=unknown"
msgid "  There it was, clear as day."
msgstr "　……彼女の瞳には、はっきりと。"

#. Occurrence 5A_12:1931:4280: scene=5A_12
#: 5A_12:1931
msgctxt "text_id=4280 | speaker=unknown"
msgid "  From the detritus of the stairway, death had arisen to take her down with it."
msgstr "　地下へ落ちる階段の瓦礫から、蒼<崎青|じぶん>子を道連れにしようとする“死”が見えた。"

#. Occurrence 5A_12:2021:4281: scene=5A_12
#: 5A_12:2021
msgctxt "text_id=4281 | speaker=unknown"
msgid "  A corpse that had crawled its way up from the depths of hell itself."
msgstr "　<彼女|したい>は<奈落|ならく>から這い出てくる。"

#. Occurrence 5A_12:2026:4282: scene=5A_12
#: 5A_12:2026
msgctxt "text_id=4282 | speaker=unknown"
msgid "  It was still operational."
msgstr "　まだ<稼働|いき>ている。"

#. Occurrence 5A_12:2086:4283: scene=5A_12
#: 5A_12:2086
msgctxt "text_id=4283 | speaker=unknown"
msgid "  And it was still armed with curses."
msgstr "　まだ<呪詛|いし>がある。"

#. Occurrence 5A_12:2091:4284: scene=5A_12
#: 5A_12:2091
msgctxt "text_id=4284 | speaker=unknown"
msgid "  It had crawled after her, watching as Aoko desperately tried to save herself."
msgstr "　<青子|じぶん>と同じように階段を這ってきて、<青子|じぶん>と同じ目で、一人だけ助かろうとする<少女|あおこ>を見つめている。"

#. Occurrence 5A_12:2170:4285: scene=5A_12
#: 5A_12:2170
msgctxt "text_id=4285 | speaker=unknown"
msgid "  The puppet's arm shot forward."
msgstr "　人形の腕が突き出される。"

#. Occurrence 5A_12:2175:4286: scene=5A_12
#: 5A_12:2175
msgctxt "text_id=4286 | speaker=unknown"
msgid "  While Aoko did not turn to meet it, she could see its reflection in the mirrors."
msgstr "　青子が振り向かなくとも、鏡にその姿が映っている。"

#. Occurrence 5A_12:2267:4287: voice_id=C40_5A_12_0000_C; voice_prefix=C40; voice_category=0; scene=5A_12
#: 5A_12:2267
msgctxt "text_id=4287 | speaker=unknown"
msgid "\"Iis salvatio Iis salvatio Iis salvatio Iis salvatio.\""
msgstr "“Iis salvatio Iis salvatio Iis salvatio Iis salvatio”"

#. Occurrence 5A_12:2273:4288: scene=5A_12
#: 5A_12:2273
msgctxt "text_id=4288 | speaker=unknown"
msgid "  Extend. Extend. Extend."
msgstr "　伸びる。伸びる。伸びる。"

#. Occurrence 5A_12:2278:4289: scene=5A_12
#: 5A_12:2278
msgctxt "text_id=4289 | speaker=unknown"
msgid "  This time, she could not dodge it. There was absolutely nothing she could do."
msgstr "　今度こそ<躱|かわ>せない。躱しようがない。"

#. Occurrence 5A_12:2299:4290: scene=5A_12
#: 5A_12:2299
msgctxt "text_id=4290 | speaker=unknown"
msgid "  The puppet with her face sang."
msgstr "　同じ顔をした人形が<詠|うた>っている。"

#. Occurrence 5A_12:2308:4291: voice_id=C40_5A_12_0001_C; voice_prefix=C40; voice_category=0; scene=5A_12
#: 5A_12:2308
msgctxt "text_id=4291 | speaker=unknown"
msgid "  <I invite you|@_Venite domum meam.>."
msgstr "　<招き入れる|@_Venite domum meam.>。"

#. Occurrence 5A_12:2316:4292: voice_id=C40_5A_12_0002_C; voice_prefix=C40; voice_category=0; scene=5A_12
#: 5A_12:2316
msgctxt "text_id=4292 | speaker=unknown"
msgid "  <to die a muddy death|@_Luto simile somnium.>."
msgstr "　<泥のような死を|@_Luto simile somnium>。"

#. Occurrence 5A_12:2324:4293: voice_id=C40_5A_12_0003_C; voice_prefix=C40; voice_category=0; scene=5A_12
#: 5A_12:2324
msgctxt "text_id=4293 | speaker=unknown"
msgid "  <Become as whispering dust|@_et pulveri simile cotidianum.>."
msgstr "　<塵となって囁く|@_et pulveri simile cotidianum>。"

#. Occurrence 5A_12:2332:4294: voice_id=C40_5A_12_0004_C; voice_prefix=C40; voice_category=0; scene=5A_12
#: 5A_12:2332
msgctxt "text_id=4294 | speaker=unknown"
msgid "  <Gouge out your heart|@_Cor privo.>."
msgstr "　<心臓を抉り|@_Cor privo>出して、"

#. Occurrence 5A_12:2342:4295: voice_id=C40_5A_12_0005_C; voice_prefix=C40; voice_category=0; scene=5A_12
#: 5A_12:2342
msgctxt "text_id=4295 | speaker=unknown"
msgid "                                      "
msgstr "　　　　　　　　"

msgctxt "text_id=4296 | speaker=unknown"
msgid "  \"<Death be upon you!|Te iudico.>\""
msgstr "“「オ<マエニ、|Te iudico>死ヲ」”"

#. Occurrence 5A_12:2398:4297: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0008; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:2398
msgctxt "text_id=4297 | speaker=aoko"
msgid "\"Wha―\""
msgstr "「―――、な」"

#. Occurrence 5A_12:2456:4298: scene=5A_12
#: 5A_12:2456
msgctxt "text_id=4298 | speaker=unknown"
msgid "  For a moment, she could not believe her eyes."
msgstr "　瞬間、青子は我が目を疑った。"

#. Occurrence 5A_12:2461:4299: scene=5A_12
#: 5A_12:2461
msgctxt "text_id=4299 | speaker=unknown"
msgid "  It was the last thing she'd expected to see."
msgstr "　最後にとんでもない光景を見せられた。"

#. Occurrence 5A_12:2514:4300: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0000; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:2514
msgctxt "text_id=4300 | speaker=soujuurou"
msgid "\"Don't know when to give up, do you?\""
msgstr "「しつこいぞ、おまえ」"

#. Occurrence 5A_12:2520:4301: scene=5A_12
#: 5A_12:2520
msgctxt "text_id=4301 | speaker=unknown"
msgid "  A fierce expression adorned the face of the boy who had been waiting in the plaza, as he smashed the puppet's outstretched arm."
msgstr "　彼はむっとした顔で、広場にとどまって、伸びきった人形の腕を壊していた。"

#. Occurrence 5A_12:2540:4302: scene=5A_12
#: 5A_12:2540
msgctxt "text_id=4302 | speaker=unknown"
msgid "  Anger really did not suit him at all."
msgstr "　怒っている顔が本当に似合わない。"

#. Occurrence 5A_12:2545:4303: scene=5A_12
#: 5A_12:2545
msgctxt "text_id=4303 | speaker=unknown"
msgid "  His weapon of choice was a fire extinguisher."
msgstr "　手にしている武器は消火器だった。"

#. Occurrence 5A_12:2550:4304: scene=5A_12
#: 5A_12:2550
msgctxt "text_id=4304 | speaker=unknown"
msgid "  He must have searched the maze for something to use as a weapon."
msgstr "　きっと武器になるものを探して、いつまでも迷路の中に。"

#. Occurrence 5A_12:2567:4305: scene=5A_12
#: 5A_12:2567
msgctxt "text_id=4305 | speaker=unknown"
msgid "  No, never mind that!"
msgstr "　……いや、それよりも。"

#. Occurrence 5A_12:2606:4306: scene=5A_12
#: 5A_12:2606
msgctxt "text_id=4306 | speaker=unknown"
msgid "  It was too crazy to contemplate... but had he stayed behind... for her?"
msgstr "　彼がまだ広間にいたのは、考えたくもないけど、まさかそういう理由なんだろうか？"

#. Occurrence 5A_12:2724:4307: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0009; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:2724
msgctxt "text_id=4307 | speaker=aoko"
msgid "\"Sizuki!\""
msgstr "「っ、静希君―――！」"

#. Occurrence 5A_12:2730:4308: scene=5A_12
#: 5A_12:2730
msgctxt "text_id=4308 | speaker=unknown"
msgid "  Aoko stopped the feet she had sworn would never stop moving, and extended a hand out to him."
msgstr "　青子は決して止めまいと誓った足を止めて、無我夢中で手を伸ばす。"

#. Occurrence 5A_12:2765:4309: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0010; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:2765
msgctxt "text_id=4309 | speaker=aoko"
msgid "\"That's enough! Leave it! We have to go!\""
msgstr "「そんなのほっといていいから、早く！」"

#. Occurrence 5A_12:2827:4310: scene=5A_12
#: 5A_12:2827
msgctxt "text_id=4310 | speaker=unknown"
msgid "  Soujyuro tossed the fire extinguisher aside and took off running."
msgstr "　草十郎は消火器を捨てて走りだした。"

#. Occurrence 5A_12:3010:4311: scene=5A_12
#: 5A_12:3010
msgctxt "text_id=4311 | speaker=unknown"
msgid "  Pieces of the ceiling continued to collapse like dominos."
msgstr "　ドミノ倒しに倒壊していく通路の天井。"

#. Occurrence 5A_12:3054:4312: scene=5A_12
#: 5A_12:3054
msgctxt "text_id=4312 | speaker=unknown"
msgid "  They kept moving with dust and dirt following in their wake."
msgstr "　土砂に阻まれながらも先行する背。"

#. Occurrence 5A_12:3190:4313: scene=5A_12
#: 5A_12:3190
msgctxt "text_id=4313 | speaker=unknown"
msgid "  Their shadows raced through the collapsing corridor with all their strength."
msgstr "　崩れ落ちる通路を、全力で走るふたりの影。"

#. Occurrence 5A_12:3311:4314: scene=5A_12
#: 5A_12:3311
msgctxt "text_id=4314 | speaker=unknown"
msgid "  ...The castle was in the throes of death."
msgstr "　……断末魔があがる。"

#. Occurrence 5A_12:3316:4315: scene=5A_12
#: 5A_12:3316
msgctxt "text_id=4315 | speaker=unknown"
msgid "  With a massive crash and a cloud of dust, the final chapter of the fairy tale that had been Kitsy Land came to an abrupt end."
msgstr "　轟音と粉塵をまきあげ、キッツィーランドのシンボルであった御伽の城は、こうして、最後の<見せ場|ショウ>を終えたのだった。"

#. Occurrence 5A_12:3402:4316: scene=5A_12
#: 5A_12:3402
msgctxt "text_id=4316 | speaker=unknown"
msgid "  This duel to the death was over."
msgstr "　生死を賭けたマラソンは終わった。"

#. Occurrence 5A_12:3407:4317: scene=5A_12
#: 5A_12:3407
msgctxt "text_id=4317 | speaker=unknown"
msgid "  For a moment, amidst their swirling emotions, any past enmity was forgotten. The two collapsed on the lawn and basked in strange solidarity."
msgstr "　苦楽とか命運とかを一瞬だけ共にしたふたりは、疲れきった体を芝生にあずけて、妙な連帯感に包まれていた。"

#. Occurrence 5A_12:3427:4318: scene=5A_12
#: 5A_12:3427
msgctxt "text_id=4318 | speaker=unknown"
msgid "  The ringing in their ears subsided before long."
msgstr "　……耳鳴りはもう治まっている。"

#. Occurrence 5A_12:3432:4319: scene=5A_12
#: 5A_12:3432
msgctxt "text_id=4319 | speaker=unknown"
msgid "  A tremor of such magnitude seemed impossible in an amusement park like this."
msgstr "　あれだけ大きかった地響きも、このさびれた遊園地では<彩|いろ>を失う。"

#. Occurrence 5A_12:3457:4320: scene=5A_12
#: 5A_12:3457
msgctxt "text_id=4320 | speaker=unknown"
msgid "  As the sounds of destruction echoed across the park, Aoko addressed the individual at her side."
msgstr "　崩落の残響が廃墟に<沁|し>みこんでいくのを聞き届けながら、青子はとなりの人影に語りかけた。"

#. Occurrence 5A_12:3465:4321: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0011; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3465
msgctxt "text_id=4321 | speaker=aoko"
msgid "\"Hey...you alive?\""
msgstr "「………………ねえ、生きてる？」"

#. Occurrence 5A_12:3471:4322: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0001; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:3471
msgctxt "text_id=4322 | speaker=soujuurou"
msgid "\"Yeah.\""
msgstr "「うん」"

#. Occurrence 5A_12:3477:4323: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0012; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3477
msgctxt "text_id=4323 | speaker=aoko"
msgid "\"Tch.\""
msgstr "「ちぇっ」"

#. Occurrence 5A_12:3482:4324: scene=5A_12
#: 5A_12:3482
msgctxt "text_id=4324 | speaker=unknown"
msgid "  While the click of her tongue was adorable, the meaning behind it was anything but."
msgstr "　可愛らしい舌打ちだったが、その真意は物騒なコトこの上ない。"

#. Occurrence 5A_12:3532:4325: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0002; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:3532
msgctxt "text_id=4325 | speaker=soujuurou"
msgid "\"...Aozaki? What happened to that thing?\""
msgstr "「……蒼崎。あいつ、どうなった？」"

#. Occurrence 5A_12:3538:4326: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0013; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3538
msgctxt "text_id=4326 | speaker=aoko"
msgid "\"What do you think? It was crushed to bits.\""
msgstr "「見ての通りよ。今ごろバラバラ死体になってるんじゃない？」"

#. Occurrence 5A_12:3544:4327: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0003; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:3544
msgctxt "text_id=4327 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5A_12:3564:4328: scene=5A_12
#: 5A_12:3564
msgctxt "text_id=4328 | speaker=unknown"
msgid "  Soujyuro sighed, not wholly relieved by her frank response. His reason..."
msgstr "　身もふたもない青子の返答に、それならいいけど、とため息をつく草十郎。なぜなら、"

#. Occurrence 5A_12:3589:4329: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0014; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3589
msgctxt "text_id=4329 | speaker=aoko"
msgid "\"Never mind that thing. You should be worrying about yourself.\""
msgstr "「でも、そんな心配より自分の心配をした方がいいと思うわよ、静希くん？」"

#. Occurrence 5A_12:3595:4330: scene=5A_12
#: 5A_12:3595
msgctxt "text_id=4330 | speaker=unknown"
msgid "  He wasn't out of the woods yet, after all."
msgstr "　彼の災難は、目下継続中だったからだ。"

#. Occurrence 5A_12:3654:4331: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0004; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:3654
msgctxt "text_id=4331 | speaker=soujuurou"
msgid "\"...Aozaki, I'm guessing you were a bit of a bully as a kid.\""
msgstr "「……蒼崎、子供の頃はいじめっ子だっただろ」"

#. Occurrence 5A_12:3674:4332: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0015; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3674
msgctxt "text_id=4332 | speaker=aoko"
msgid "\"Maybe, but I don't get a kick out of seeing people suffer."
msgstr "「<加虐|かぎゃく>趣味はないって自負してるけど。"

#. Occurrence 5A_12:3680:4333: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0016; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3680
msgctxt "text_id=4333 | speaker=aoko"
msgid "  Never mind that. Do you know the situation you're in right now?\""
msgstr "　それで、今の自分の立場、分かってる？」"

#. Occurrence 5A_12:3702:4334: scene=5A_12
#: 5A_12:3702
msgctxt "text_id=4334 | speaker=unknown"
msgid "  She sat up and smiled."
msgstr "　体を起こしてニコリと微笑む青子。"

#. Occurrence 5A_12:3707:4335: scene=5A_12
#: 5A_12:3707
msgctxt "text_id=4335 | speaker=unknown"
msgid "  Soujyuro hung his head in shame, wondering why her kind tone and expression were so chilling."
msgstr "　口調も表情も優しいのに、なんでぞわっと寒気がするんだろうな、と草十郎はうなだれてみた。"

#. Occurrence 5A_12:3739:4336: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0005; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:3739
msgctxt "text_id=4336 | speaker=soujuurou"
msgid "\"Please accept my sincerest apologies.\""
msgstr "「……<面目|めんぼく>次第もございません」"

#. Occurrence 5A_12:3759:4337: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0017; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3759
msgctxt "text_id=4337 | speaker=aoko"
msgid "\"Oh no, don't you even start. You know what our agreement was, and a deal is a deal. If you held up your end of the bargain, I'd let you go.\""
msgstr "「かしこまってもダメよ。あの提案には大前提があったわよね。これは取引だって。貴方が役に立つのなら見逃してあげるっていう」"

#. Occurrence 5A_12:3770:4338: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0006; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:3770
msgctxt "text_id=4338 | speaker=soujuurou"
msgid "\"Exactly. And that's why I'm apologizing.\""
msgstr "「分かってる。だから面目ないって言ってるだろ」"

#. Occurrence 5A_12:3776:4339: scene=5A_12
#: 5A_12:3776
msgctxt "text_id=4339 | speaker=unknown"
msgid "  Soujyuro made a show of avoiding her eyes,"
msgstr "　草十郎はこれみよがしに顔を背けた。"

#. Occurrence 5A_12:3781:4340: scene=5A_12
#: 5A_12:3781
msgctxt "text_id=4340 | speaker=unknown"
msgid "  like a pouting child."
msgstr "　ふん、と子供のようにふて腐れる。"

#. Occurrence 5A_12:3824:4341: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0018; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3824
msgctxt "text_id=4341 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5A_12:3830:4342: scene=5A_12
#: 5A_12:3830
msgctxt "text_id=4342 | speaker=unknown"
msgid "  Aoko was taken aback by this sulky display."
msgstr "　その拗ねっぷりに面食らう青子。"

#. Occurrence 5A_12:3835:4343: scene=5A_12
#: 5A_12:3835
msgctxt "text_id=4343 | speaker=unknown"
msgid "  Perhaps..."
msgstr "　……おそらく、ではあるが。"

#. Occurrence 5A_12:3841:4344: scene=5A_12
#: 5A_12:3841
msgctxt "text_id=4344 | speaker=unknown"
msgid "He was angry at himself rather than her."
msgstr "草十郎は青子にではなく、自分に対して怒っているのだ。"

#. Occurrence 5A_12:3846:4345: scene=5A_12
#: 5A_12:3846
msgctxt "text_id=4345 | speaker=unknown"
msgid "  He was not mad because she would not let him go. He was mad that he had not done his part."
msgstr "　青子に見逃してもらえない事より、役に立てなかった事が悔しかった、と。"

#. Occurrence 5A_12:3872:4346: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0019; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3872
msgctxt "text_id=4346 | speaker=aoko"
msgid "\"...Haaah.\""
msgstr "「――――――はあ」"

#. Occurrence 5A_12:3878:4347: scene=5A_12
#: 5A_12:3878
msgctxt "text_id=4347 | speaker=unknown"
msgid "  Aoko sighed for what seemed like the millionth time that day."
msgstr "　つい、<本日|ほんじつ>何度目かのため息を青子はもらした。"

#. Occurrence 5A_12:3883:4348: scene=5A_12
#: 5A_12:3883
msgctxt "text_id=4348 | speaker=unknown"
msgid "  She could not figure out what surprised her more: his unconditional kindness, or her naïve approval of it."
msgstr "　……目前の少年のお人好し加減と、その長所を認めてしまった自分の甘さに呆れてしまう。"

#. Occurrence 5A_12:3918:4349: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0020; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3918
msgctxt "text_id=4349 | speaker=aoko"
msgid "\"So, are you ready?\""
msgstr "「じゃあ覚悟は出来てるの？」"

#. Occurrence 5A_12:3930:4350: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0007; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:3930
msgctxt "text_id=4350 | speaker=soujuurou"
msgid "\"Of course not, but a promise is a promise. In the end, I failed to do my part.\""
msgstr "「……そんなのは出来ないけど、約束だからな。結局は、何もしていないし」"

#. Occurrence 5A_12:3936:4351: scene=5A_12
#: 5A_12:3936
msgctxt "text_id=4351 | speaker=unknown"
msgid "  It was certainly the case that he failed to do any of the things she had expected of him."
msgstr "　確かに、青子が期待した事は、なにひとつ。"

#. Occurrence 5A_12:3946:4352: scene=5A_12
#: 5A_12:3946
msgctxt "text_id=4352 | speaker=unknown"
msgid "  But just then, she glanced back at the collapsed house of mirrors."
msgstr "　けど、と青子は崩れ去ったミラーハウスを一瞥した。"

#. Occurrence 5A_12:3951:4353: scene=5A_12
#: 5A_12:3951
msgctxt "text_id=4353 | speaker=unknown"
msgid "  What had he done after failing so spectacularly?"
msgstr "　囮役を見事に失敗し、途方にくれた彼は何を選択したのか。"

#. Occurrence 5A_12:3998:4354: scene=5A_12
#: 5A_12:3998
msgctxt "text_id=4354 | speaker=unknown"
msgid "  He had searched for the extinguisher so he could use it as a weapon,"
msgstr "　……わざわざ武器になるような消火器を探して、"

#. Occurrence 5A_12:4003:4355: scene=5A_12
#: 5A_12:4003
msgctxt "text_id=4355 | speaker=unknown"
msgid "  and waited patiently in the plaza as the maze collapsed all around him just because he thought it was wrong to leave her behind."
msgstr "　崩れだした迷路の中で、ひとりで出るわけにはいかないと、あの広間で足を止めていた。"

#. Occurrence 5A_12:4009:4356: scene=5A_12
#: 5A_12:4009
msgctxt "text_id=4356 | speaker=unknown"
msgid "  It was a foolish choice, and the exact opposite of her choice to run towards the exit without hesitation."
msgstr "　それは<躊躇|ためら>うことなく出口を目指した彼女とは真逆の、あまりにも愚かな選択だ。"

#. Occurrence 5A_12:4035:4357: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0021; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:4035
msgctxt "text_id=4357 | speaker=aoko"
msgid "\"I suppose I'll take it.\""
msgstr "“……ま、それでよしとするか”"

#. Occurrence 5A_12:4041:4358: scene=5A_12
#: 5A_12:4041
msgctxt "text_id=4358 | speaker=unknown"
msgid "  She was satisfied, even as she was shocked at how naive she was being."
msgstr "　甘いなあ、と呆れながらも満足する。"

#. Occurrence 5A_12:4046:4359: scene=5A_12
#: 5A_12:4046
msgctxt "text_id=4359 | speaker=unknown"
msgid "  It was true that he had saved her."
msgstr "　だって救われたのは事実だし。"

#. Occurrence 5A_12:4051:4360: scene=5A_12
#: 5A_12:4051
msgctxt "text_id=4360 | speaker=unknown"
msgid "  She smiled inwardly, admiring―if only for a moment―the bravery he continued to show in the face of such extreme circumstances."
msgstr "　あの状況で待ち続ける勇気は、たとえ一秒だけだとしても賞賛に値すると、彼女は内心微笑んだ。"

#. Occurrence 5A_12:4109:4361: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0022; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:4109
msgctxt "text_id=4361 | speaker=aoko"
msgid "\"You may have blown your chance, but you did make up for it after the fact. I'll keep my promise.\""
msgstr "“……役割は果たさなかったけど、アフターケアは合格だし。約束は、守らなくちゃね”"

#. Occurrence 5A_12:4115:4362: scene=5A_12
#: 5A_12:4115
msgctxt "text_id=4362 | speaker=unknown"
msgid "  With a nod, she pulled herself to her feet."
msgstr "　ひとり頷いて、青子はすくっと立ち上がる。"

#. Occurrence 5A_12:4143:4363: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0023; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:4143
msgctxt "text_id=4363 | speaker=aoko"
msgid "\"But you'll pay back this favor, someday.\""
msgstr "「約束は、ま、いつか守ってもらうとして」"

#. Occurrence 5A_12:4165:4364: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0008; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:4165
msgctxt "text_id=4364 | speaker=soujuurou"
msgid "\"...?\""
msgstr "「？」"

#. Occurrence 5A_12:4200:4365: scene=5A_12
#: 5A_12:4200
msgctxt "text_id=4365 | speaker=unknown"
msgid "  The girl tried to keep a straight face as she offered a hand to the boy still lying on the ground."
msgstr "　少女は出来るだけ無感情を装って、まだ倒れこんでいる少年に手を差し伸べる。"

#. Occurrence 5A_12:4221:4366: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0024; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:4221
msgctxt "text_id=4366 | speaker=aoko"
msgid "\"You managed to help me in the end."
msgstr "「結果はどうあれ手助けしてもらったし。"

#. Occurrence 5A_12:4228:4367: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0025; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:4228
msgctxt "text_id=4367 | speaker=aoko"
msgid "So, because of that, I'll let you off the hook. For tonight.\""
msgstr "特別サービスってコトで、今夜はもう手を出さないであげる」"

#. Occurrence 5A_12:4252:4368: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0009; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:4252
msgctxt "text_id=4368 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5A_12:4299:4369: scene=5A_12
#: 5A_12:4299
msgctxt "text_id=4369 | speaker=unknown"
msgid "  She bashfully averted her gaze."
msgstr "　照れくさそうに顔を逸らす少女。"

#. Occurrence 5A_12:4304:4370: scene=5A_12
#: 5A_12:4304
msgctxt "text_id=4370 | speaker=unknown"
msgid "  Though her profile appeared different than it had in the past, it was clearly still the face of the vibrant girl he met the day he first arrived in town."
msgstr "　その横顔はあの日のものとは違っていたけれど、紛れもなく、少年がこの町に来てはじめて見入った、鮮やかな少女の顔だった。"

#. Occurrence 5A_12:4338:4371: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0026; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:4338
msgctxt "text_id=4371 | speaker=aoko"
msgid "\"What are you staring at!?\""
msgstr "「――――――なによ」"

#. Occurrence 5A_12:4343:4372: scene=5A_12
#: 5A_12:4343
msgctxt "text_id=4372 | speaker=unknown"
msgid "  As if she had felt his eyes on her, she shot him a frowning glare."
msgstr "　視線を感じたのか、口をとがらせてじろりと睨む青子。"

#. Occurrence 5A_12:4363:4373: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0010; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:4363
msgctxt "text_id=4373 | speaker=soujuurou"
msgid "\"Oh, sorry. It's just, as crazy as it is to say it aloud, you really are a fair person, Aozaki.\""
msgstr "「いや。突拍子もないけど、蒼崎は律儀だなって」"

#. Occurrence 5A_12:4387:4374: scene=5A_12
#: 5A_12:4387
msgctxt "text_id=4374 | speaker=unknown"
msgid "  He took her outstretched hand."
msgstr "　差し出された手を握る。"

#. Occurrence 5A_12:4392:4375: scene=5A_12
#: 5A_12:4392
msgctxt "text_id=4375 | speaker=unknown"
msgid "  Feeling his weight as she pulled him up, she could not help but think that he was about the last person she wanted to hear that from."
msgstr "　青子は草十郎の体重を感じながら、貴方にだけは言われたくはないわ、と手を引いた。"

#. Occurrence 5A_12:4437:4376: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0011; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:4437
msgctxt "text_id=4376 | speaker=soujuurou"
msgid "\"By the way, you said you'd let me off the hook for tonight. What about tomorrow?\""
msgstr "「ところで。今夜はって言うけど、明日からは？」"

#. Occurrence 5A_12:4443:4377: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0027; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:4443
msgctxt "text_id=4377 | speaker=aoko"
msgid "\"Well, we'll just have to see.\""
msgstr "「さあ。ま、その時になったら考えるわ」"

#. Occurrence 5A_12:4449:4378: scene=5A_12
#: 5A_12:4449
msgctxt "text_id=4378 | speaker=unknown"
msgid "  She shrugged her shoulders as if she was not sure herself."
msgstr "　自分でもなんだかなあ、と肩をすくめる青子。"

#. Occurrence 5A_12:4454:4379: scene=5A_12
#: 5A_12:4454
msgctxt "text_id=4379 | speaker=unknown"
msgid "  The response was so unlike her that it made Soujyuro smile."
msgstr "　その仕草がおかしく、草十郎も笑ってしまう。"

#. Occurrence 5A_12:4493:4380: scene=5A_12
#: 5A_12:4493
msgctxt "text_id=4380 | speaker=unknown"
msgid "  Was it the solidarity of having escaped death together, or their fleeting camaraderie that made him do so?"
msgstr "　共に死線をくぐり抜けた連帯感とか、つかの間<築|きず>かれた友情とか。"

#. Occurrence 5A_12:4498:4381: scene=5A_12
#: 5A_12:4498
msgctxt "text_id=4381 | speaker=unknown"
msgid "  It might have been for this night only, but the air between them was kind and gentle."
msgstr "　それが今夜かぎりのものでも、ふたりを包む空気は<和|なご>やかで、優しいものだった。"

#. Occurrence 5A_12:4503:4382: scene=5A_12
#: 5A_12:4503
msgctxt "text_id=4382 | speaker=unknown"
msgid "  A lot had transpired, but the midwinter nightmare had come to an end."
msgstr "　色々あったけれど、真冬の夜の悪夢はこれでおしまい。"

#. Occurrence 5A_12:4508:4383: scene=5A_12
#: 5A_12:4508
msgctxt "text_id=4383 | speaker=unknown"
msgid "  The pair had overcome many trials and tribulations and could now leave the mirror realm in their wake."
msgstr "　ふたりはそれぞれの窮地を乗り越え、鏡の国を後にする。"

#. Occurrence 5A_12:4530:4384: scene=5A_12
#: 5A_12:4530
msgctxt "text_id=4384 | speaker=unknown"
msgid "  But before that..."
msgstr "　……けれど、その前に。"

#. Occurrence 5A_12:4577:4385: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5A_12_0000; voice_prefix=A40; voice_category=2; scene=5A_12
#: 5A_12:4577
msgctxt "text_id=4385 | speaker=alice"
msgid "\"...How selfish of you."
msgstr "「―――随分と身勝手ね。"

#. Occurrence 5A_12:4583:4386: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5A_12_0001; voice_prefix=A40; voice_category=2; scene=5A_12
#: 5A_12:4583
msgctxt "text_id=4386 | speaker=alice"
msgid "  And who, may I ask, said you could decide that, Aoko?\""
msgstr "　それは貴女ひとりで決めていい事だったかしら、青子？」"

#. Occurrence 5A_12:4773:4387: scene=5A_12
#: 5A_12:4773
msgctxt "text_id=4387 | speaker=unknown"
msgid "  It was the voice of a beautiful songbird"
msgstr "　それは美しい鳥のさえずりにも、"

#. Occurrence 5A_12:4773:4388: scene=5A_12
#: 5A_12:4773
msgctxt "text_id=4388 | speaker=unknown"
msgid "  and a merciless machine, all rolled into one."
msgstr "　無慈悲な機械の声にも似て。"

#. Occurrence 5A_12:4794:4389: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0028; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:4794
msgctxt "text_id=4389 | speaker=aoko"
msgid "\"...Alice.\""
msgstr "「―――有珠」"

#. Occurrence 5A_12:4800:4390: scene=5A_12
#: 5A_12:4800
msgctxt "text_id=4390 | speaker=unknown"
msgid "  Her voice quivered as she spoke the name."
msgstr "　……震える声で、青子は少女の名を口にした。"

#. Occurrence 5A_12:4857:4391: scene=5A_12
#: 5A_12:4857
msgctxt "text_id=4391 | speaker=unknown"
msgid "  The lady in black made her presence known."
msgstr "　降り立つ黒衣。"

#. Occurrence 5A_12:4863:4392: scene=5A_12
#: 5A_12:4863
msgctxt "text_id=4392 | speaker=unknown"
msgid "  The night was not yet over."
msgstr "　……夜はまだ終わらない。"

#. Occurrence 5A_12:4868:4393: scene=5A_12
#: 5A_12:4868
msgctxt "text_id=4393 | speaker=unknown"
msgid "  Her name was Alice Kuonji."
msgstr "　少女の名は久遠寺有珠。"

#. Occurrence 5A_12:4874:4394: scene=5A_12
#: 5A_12:4874
msgctxt "text_id=4394 | speaker=unknown"
msgid "  She was a witch whose name struck fear into the heart of Aoko―"
msgstr "　青子をして魔女と恐れさせる、"

msgctxt "text_id=4395 | speaker=unknown"
msgid "an avatar of the night who would allow no witnesses."
msgstr "目撃者は例外なく逃がさない、夜の化身がやってきた。"

#. Occurrence 5A_2:79:4396: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0000; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:79
msgctxt "text_id=4396 | speaker=soujuurou"
msgid "\"I guess that's it.\""
msgstr "「あれか」"

#. Occurrence 5A_2:86:4397: scene=5A_2
#: 5A_2:86
msgctxt "text_id=4397 | speaker=unknown"
msgid "  The central plaza was as silent as a grave. According to the map, the meeting spot was west of here."
msgstr "　静まりかえった中央広場から、案内にしたがって西に。"

#. Occurrence 5A_2:91:4398: scene=5A_2
#: 5A_2:91
msgctxt "text_id=4398 | speaker=unknown"
msgid "  Waiting for Soujyuro at his destination was a rugged, imposing, magnificent castle towering before the backdrop of the cloudy night sky."
msgstr "　着いた先には曇天の夜を<背景|バック>に、<凹凸|おうとつ>の多い、<威容|いよう><異彩|いさい>な城がそびえていた。"

#. Occurrence 5A_2:111:4399: scene=5A_2
#: 5A_2:111
msgctxt "text_id=4399 | speaker=unknown"
msgid "  Even for an abandoned park, it was a remarkable structure."
msgstr "　廃遊園地の中でも<一際|ひときわ>大きい建造物。"

#. Occurrence 5A_2:116:4400: scene=5A_2
#: 5A_2:116
msgctxt "text_id=4400 | speaker=unknown"
msgid "  If the roller coasters and the Ferris wheel were loud, intense attractions, this was comparatively quiet and easygoing."
msgstr "　コースターや観覧車が動のアトラクションなら、あれは静のアトラクション。"

#. Occurrence 5A_2:122:4401: scene=5A_2
#: 5A_2:122
msgctxt "text_id=4401 | speaker=unknown"
msgid "  It was one of Kitsy Land's three iconic structures and, in a way, the wicked fortress that guided this paradise down the path of closure."
msgstr "　キッツィーランドの三大シンボルの一つであり、ある意味、この楽園を閉鎖に導いた魔の建物だ。"

#. Occurrence 5A_2:158:4402: scene=5A_2
#: 5A_2:158
msgctxt "text_id=4402 | speaker=unknown"
msgid "  Generally speaking, amusement park mazes generally fell into one of two categories:"
msgstr "　一般的に、遊園地の<迷路|メイズ>は大きく二種類に分類される。"

#. Occurrence 5A_2:164:4403: scene=5A_2
#: 5A_2:164
msgctxt "text_id=4403 | speaker=unknown"
msgid "  Labyrinths, which disorient visitors with their sheer size,"
msgstr "　建物の広さで来訪者を迷わす<大迷路|ラビュリントス>と、"

#. Occurrence 5A_2:164:4404: scene=5A_2
#: 5A_2:164
msgctxt "text_id=4404 | speaker=unknown"
msgid "  and mirror houses, which disorient visitors with optical illusions."
msgstr "　交錯する光で来訪者を迷わすミラーハウスだ。"

#. Occurrence 5A_2:209:4405: scene=5A_2
#: 5A_2:209
msgctxt "text_id=4405 | speaker=unknown"
msgid "  Many of a labyrinth's guests enjoyed the brief sense of adventure that it afforded."
msgstr "　大迷路はその広さ、つかの間の冒険性で、多くの来訪者たちを楽しませた。"

#. Occurrence 5A_2:214:4406: scene=5A_2
#: 5A_2:214
msgctxt "text_id=4406 | speaker=unknown"
msgid "  Over the years, however, it would be usurped by the ever-increasing thrills of new attractions. Such was the way of all trends; the curse of fads."
msgstr "　後年、刺激をより増していく他のアトラクションに押され衰退していく事になるが、それは一世を<風靡|ふうび>したものの宿命だろう。"

#. Occurrence 5A_2:219:4407: scene=5A_2
#: 5A_2:219
msgctxt "text_id=4407 | speaker=unknown"
msgid "  The new must give way to the newer."
msgstr "　新しいものは、次の新しいものに駆逐されなければならないのだから。"

#. Occurrence 5A_2:243:4408: scene=5A_2
#: 5A_2:243
msgctxt "text_id=4408 | speaker=unknown"
msgid "  On the other hand, the house of mirrors was a time-honored, beloved staple."
msgstr "　一方、ミラーハウスは古くから愛されてきた定番だ。"

#. Occurrence 5A_2:248:4409: scene=5A_2
#: 5A_2:248
msgctxt "text_id=4409 | speaker=unknown"
msgid "  Even within the confines of a classroom's dimensions, well-placed mirrors and well-directed light could both perplex and delight its visitors."
msgstr "　学校の教室ほどの広さでも鏡の設置と光の演出で来訪者を楽しませ、迷わせる。"

#. Occurrence 5A_2:253:4410: scene=5A_2
#: 5A_2:253
msgctxt "text_id=4410 | speaker=unknown"
msgid "  And figuring in the cost of maintenance, a well-designed house of mirrors could far outlive its labyrinth brethren."
msgstr "　コスト面に優れたミラーハウスは大迷路より遥かに長生きしたアトラクションだ。"

#. Occurrence 5A_2:258:4411: scene=5A_2
#: 5A_2:258
msgctxt "text_id=4411 | speaker=unknown"
msgid "  Even if both types faded into obscurity, they would remain a staple of what constituted an amusement park."
msgstr "　両者とも新世紀には姿を消す事になるとしても、遊園地を代表する遊び場であるのは間違いない。"

#. Occurrence 5A_2:278:4412: scene=5A_2
#: 5A_2:278
msgctxt "text_id=4412 | speaker=unknown"
msgid "  However..."
msgstr "　……が。"

#. Occurrence 5A_2:289:4413: scene=5A_2
#: 5A_2:289
msgctxt "text_id=4413 | speaker=unknown"
msgid "  That didn't mean that combining them would produce double the fun."
msgstr "　だからといって、その二つを混ぜるのはよろしくない。"

#. Occurrence 5A_2:294:4414: scene=5A_2
#: 5A_2:294
msgctxt "text_id=4414 | speaker=unknown"
msgid "  Together, they transformed from entertainment into an uncanny realm from which those who dared to step within could never leave."
msgstr "　それでは訪れた者を楽しませる迷路というより、踏み入れた者を帰さない魔境になってしまう。"

#. Occurrence 5A_2:299:4415: scene=5A_2
#: 5A_2:299
msgctxt "text_id=4415 | speaker=unknown"
msgid "  In a similar sense,"
msgstr "　さもありなん。"

#. Occurrence 5A_2:304:4416: scene=5A_2
#: 5A_2:304
msgctxt "text_id=4416 | speaker=unknown"
msgid "  Kitsy's Mystery Tour Castle was the park's very own otherworld."
msgstr "　その魔境こそがここ、キッツィーミステリーツアー城なのであった。"

#. Occurrence 5A_2:324:4417: scene=5A_2
#: 5A_2:324
msgctxt "text_id=4417 | speaker=unknown"
msgid "  Indeed, five percent of visitors ended up requesting staff assistance to get out."
msgstr "　係員に助けを求めた入場者、実に５パーセント。"

#. Occurrence 5A_2:329:4418: scene=5A_2
#: 5A_2:329
msgctxt "text_id=4418 | speaker=unknown"
msgid "  Modeled after European castles, it was greater than a football field in length, and the interior was further split into three floors."
msgstr "　西洋の城を模した建物は奥行き百メートルほどもあり、内部はさらに三層に分かれている。"

#. Occurrence 5A_2:349:4419: scene=5A_2
#: 5A_2:349
msgctxt "text_id=4419 | speaker=unknown"
msgid "  Two floors above ground and one below, lined with mirrors from top to bottom, equal parts complex and vast. The maze demanded at least thirty minutes even from veterans."
msgstr "　地上二階、地下一階の迷路はすべて鏡張りで、熟練者でも脱出に三十分を要するほど複雑かつ広大。"

#. Occurrence 5A_2:354:4420: scene=5A_2
#: 5A_2:354
msgctxt "text_id=4420 | speaker=unknown"
msgid "  One visit was all it took to be struck by catoptrophobia for hours. It was this labyrinth that now stood in Soujyuro's way. "
msgstr "　一度足を踏み入れたが最後、むこう半日は鏡面恐怖症におちいる大迷路のなれの果てが、こうして草十郎の目の前に立ちふさがっているのだが―――"

#. Occurrence 5A_2:423:4421: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0001; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:423
msgctxt "text_id=4421 | speaker=soujuurou"
msgid "\"It looks like it's not entirely pitch black... I guess somebody turned the lights on.\""
msgstr "「真っ暗ってワケじゃないな……電気とか、ついてるんだろうか」"

#. Occurrence 5A_2:429:4422: scene=5A_2
#: 5A_2:429
msgctxt "text_id=4422 | speaker=unknown"
msgid "  It seemed that Soujyuro, unaware of what a house of mirrors even was, concerned himself only with its lighting."
msgstr "　そもそもミラーハウスを知らない草十郎の関心は、明かりの有無にのみ向けられている。"

#. Occurrence 5A_2:451:4423: scene=5A_2
#: 5A_2:451
msgctxt "text_id=4423 | speaker=unknown"
msgid "  He checked the letter from Aoko once more."
msgstr "　もう一度、蒼崎青子からの手紙を確認する。"

#. Occurrence 5A_2:456:4424: scene=5A_2
#: 5A_2:456
msgctxt "text_id=4424 | speaker=unknown"
msgid "  The letter read, \"I will be waiting in the first-floor lobby of the house of mirrors.\""
msgstr "　手紙には『ミラーハウス一階ロビーで待っています』とある。"

#. Occurrence 5A_2:476:4425: scene=5A_2
#: 5A_2:476
msgctxt "text_id=4425 | speaker=unknown"
msgid "  That meeting place was definitely in here."
msgstr "　待ち合わせ場所はたしかにこの中だ。"

#. Occurrence 5A_2:481:4426: scene=5A_2
#: 5A_2:481
msgctxt "text_id=4426 | speaker=unknown"
msgid "  There was something to see by at least, as he could just make out light faintly through the open doors."
msgstr "　電灯の有無はともかく、開けっ放しの入り口から見える内部はうっすらと明るい。"

#. Occurrence 5A_2:487:4427: scene=5A_2
#: 5A_2:487
msgctxt "text_id=4427 | speaker=unknown"
msgid "  Putting aside his suspicions, he headed toward the entrance."
msgstr "　なら間違いないだろう、と草十郎はミラーハウスの入り口に向かって歩きだした。"

#. Occurrence 5A_2:535:4428: scene=5A_2
#: 5A_2:535
msgctxt "text_id=4428 | speaker=unknown"
msgid "  ...The sound of his steps against the brick-laid path echoed faintly."
msgstr "　……カツカツと煉瓦の道を踏みならす音。"

#. Occurrence 5A_2:541:4429: scene=5A_2
#: 5A_2:541
msgctxt "text_id=4429 | speaker=unknown"
msgid "  He was far from the hustle and bustle of the city."
msgstr "　街の喧噪は遠く、"

#. Occurrence 5A_2:546:4430: scene=5A_2
#: 5A_2:546
msgctxt "text_id=4430 | speaker=unknown"
msgid "  The park's clocks no longer made tick nor tock,"
msgstr "　時計の秒針は数年前から動かず、"

#. Occurrence 5A_2:551:4431: scene=5A_2
#: 5A_2:551
msgctxt "text_id=4431 | speaker=unknown"
msgid "  and the winter's bite no longer blew in the night."
msgstr "　風の音すら無い冬の夜。"

#. Occurrence 5A_2:571:4432: scene=5A_2
#: 5A_2:571
msgctxt "text_id=4432 | speaker=unknown"
msgid "  From within the silence, the stillness that would cause any onlooker to hold their breath..."
msgstr "　そんな、第三者がいれば<固唾|かたず>を呑んで呼吸を止めそうな静寂のなか。"

#. Occurrence 5A_2:580:4433: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0002; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:580
msgctxt "text_id=4433 | speaker=soujuurou"
msgid "\"...Hello?\""
msgstr "「……えーと」"

#. Occurrence 5A_2:586:4434: scene=5A_2
#: 5A_2:586
msgctxt "text_id=4434 | speaker=unknown"
msgid "  Soujyuro stopped abruptly at the entrance to the house of mirrors."
msgstr "　草十郎はミラーハウスの入り口で、ぴたりと唐突に立ち止まると、"

#. Occurrence 5A_2:623:4435: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0003; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:623
msgctxt "text_id=4435 | speaker=soujuurou"
msgid "\"By the way, why are you over there, Aozaki?\""
msgstr "「ところで蒼崎。そんなところで何してるんだ？」"

#. Occurrence 5A_2:629:4436: scene=5A_2
#: 5A_2:629
msgctxt "text_id=4436 | speaker=unknown"
msgid "  He called out, turning back toward the plaza."
msgstr "　いま歩いてきた広場を振り返って、不思議そうに呼びかけるのだった。"

#. Occurrence 5A_2:666:4437: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0000; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:666
msgctxt "text_id=4437 | speaker=aoko"
msgid "\"?!\""
msgstr "「！？」"

#. Occurrence 5A_2:672:4438: scene=5A_2
#: 5A_2:672
msgctxt "text_id=4438 | speaker=unknown"
msgid "  A sound rang out, as if someone had dove behind a garbage can and it fell to the ground in their haste."
msgstr "　勢い、身を隠していたゴミ箱ごと<突|つ>っ<伏|ぷ>す音。"

#. Occurrence 5A_2:694:4439: scene=5A_2
#: 5A_2:694
msgctxt "text_id=4439 | speaker=unknown"
msgid "  ...A short silence ensued."
msgstr "　……しばしの静寂。"

#. Occurrence 5A_2:699:4440: scene=5A_2
#: 5A_2:699
msgctxt "text_id=4440 | speaker=unknown"
msgid "  For a moment, the abandoned park returned to its previous hush."
msgstr "　一分ほどで廃遊園地はもとの静けさを取り戻した。"

#. Occurrence 5A_2:704:4441: scene=5A_2
#: 5A_2:704
msgctxt "text_id=4441 | speaker=unknown"
msgid "  Resigned to her having been exposed, the girl appeared from her hiding place."
msgstr "　ついでに、観念したように物陰から現れる少女がひとり。"

#. Occurrence 5A_2:752:4442: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0004; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:752
msgctxt "text_id=4442 | speaker=soujuurou"
msgid "\"Ao―\""
msgstr "「あお―――」"

#. Occurrence 5A_2:768:4443: scene=5A_2
#: 5A_2:768
msgctxt "text_id=4443 | speaker=unknown"
msgid "  His voice died in his throat as he took in the sight of the girl's familiar face in unfamiliar attire."
msgstr "　見知った顔と、見慣れない私服姿に声が止まる。"

#. Occurrence 5A_2:773:4444: scene=5A_2
#: 5A_2:773
msgctxt "text_id=4444 | speaker=unknown"
msgid "  This Aoko, with her long hair flowing in the breeze, was different from the Aoko that Soujyuro knew."
msgstr "　はらりと長髪を流して現れた蒼崎青子は、草十郎の知っている彼女とは違っていたからだ。"

#. Occurrence 5A_2:820:4445: scene=5A_2
#: 5A_2:820
msgctxt "text_id=4445 | speaker=unknown"
msgid "  The resolute stance and posture she took exuded the strength of her will."
msgstr "　凛とした背筋と手足が、意志の強さをいっそう際立たせている。"

#. Occurrence 5A_2:825:4446: scene=5A_2
#: 5A_2:825
msgctxt "text_id=4446 | speaker=unknown"
msgid "  She stared directly at him with a sharp-eyed, piercing gaze."
msgstr "　まっすぐに相手を<射|い><貫|ぬ>く瞳。"

#. Occurrence 5A_2:830:4447: scene=5A_2
#: 5A_2:830
msgctxt "text_id=4447 | speaker=unknown"
msgid "  Her eyes were glowing with a dim phosphoric light, enough to give Soujyuro pause that he might be hallucinating."
msgstr "　<澄|す>んだ瞳は<比|ひ><喩|ゆ>ではなく、錯覚でなければ、実際に<燐|うす>い光を帯びている。"

#. Occurrence 5A_2:850:4448: scene=5A_2
#: 5A_2:850
msgctxt "text_id=4448 | speaker=unknown"
msgid "  An icy coldness and a girl's strength."
msgstr "　氷の無機質さと、少女としての力強さ。"

#. Occurrence 5A_2:855:4449: scene=5A_2
#: 5A_2:855
msgctxt "text_id=4449 | speaker=unknown"
msgid "  Soujyuro lacked a sense of danger, but the sense of imbalance caused even him to feel the malice in the air."
msgstr "　その不釣り合いな組み合わせが、危機感の欠如した草十郎をして、良からぬ空気を感じさせた。"

#. Occurrence 5A_2:861:4450: scene=5A_2
#: 5A_2:861
msgctxt "text_id=4450 | speaker=unknown"
msgid "  It was as though the yuki-onna spirit of folklore had climbed out from a ghost story and appeared here in reality."
msgstr "　<喩|たと>えるなら、怪談でいう雪女が現実に現れたような。"

#. Occurrence 5A_2:904:4451: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0005; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:904
msgctxt "text_id=4451 | speaker=soujuurou"
msgid "\"...Aozaki?\""
msgstr "「……蒼崎？」"

#. Occurrence 5A_2:918:4452: scene=5A_2
#: 5A_2:918
msgctxt "text_id=4452 | speaker=unknown"
msgid "  Instinctively, Soujyuro took a step back."
msgstr "　つい、と草十郎はあとずさる。"

#. Occurrence 5A_2:923:4453: scene=5A_2
#: 5A_2:923
msgctxt "text_id=4453 | speaker=unknown"
msgid "  Surprised, he was starting to feel concerned."
msgstr "　小さな驚きと違和感。"

#. Occurrence 5A_2:928:4454: scene=5A_2
#: 5A_2:928
msgctxt "text_id=4454 | speaker=unknown"
msgid "  An unpleasant premonition rose to the surface, bringing with it a sense of anxiety. In spite of this, he felt obliged to honor urban etiquette by seeing if she was all right."
msgstr "　そして、それらを上回る嫌な予感に混乱しつつあるが、とにかく都会の礼儀として声をかけたのだが……"

#. Occurrence 5A_2:949:4455: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0006; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:949
msgctxt "text_id=4455 | speaker=soujuurou"
msgid "\"...Did something happen to you? From the looks of it, I, um...\""
msgstr "「……その顔を見るに、何かあったのかといちおう聞いておくん、だけど―――」"

#. Occurrence 5A_2:972:4456: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0001; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:972
msgctxt "text_id=4456 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5A_2:978:4457: scene=5A_2
#: 5A_2:978
msgctxt "text_id=4457 | speaker=unknown"
msgid "  Without acknowledging him, Aoko took a step forward."
msgstr "　挨拶もなく、青子は一歩前に進んだ。"

#. Occurrence 5A_2:983:4458: scene=5A_2
#: 5A_2:983
msgctxt "text_id=4458 | speaker=unknown"
msgid "  Her figure, this atmosphere... Soujyuro found himself recalling a recent memory."
msgstr "　その姿、その雰囲気が草十郎の曖昧な記憶を揺さぶる。"

#. Occurrence 5A_2:1036:4459: scene=5A_2
#: 5A_2:1036
msgctxt "text_id=4459 | speaker=unknown"
msgid "  His twisted and knotted apprehension melted away and was replaced with a growing realization."
msgstr "　心中、交錯しまくっていた草十郎の不安は、そろそろ確信に変わりつつある。"

#. Occurrence 5A_2:1060:4460: scene=5A_2
#: 5A_2:1060
msgctxt "text_id=4460 | speaker=unknown"
msgid "  The girl before him was very similar to someone he had seen before, that night in the park, though he had only seen her from behind."
msgstr "　あの時は後ろ姿だけだったが、今にして思えば夜の公園で見た人影と目前の少女の姿はなんとなく……"

#. Occurrence 5A_2:1065:4461: scene=5A_2
#: 5A_2:1065
msgctxt "text_id=4461 | speaker=unknown"
msgid "  With increasing certainty causing him to swallow nervously, he noted that they... might as well have been identical."
msgstr "　どころか、うり二つではないだろうか？　と<固唾|かたず>など呑む始末。"

#. Occurrence 5A_2:1095:4462: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0002; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1095
msgctxt "text_id=4462 | speaker=aoko"
msgid "\"You asked me what I was doing. Well, it's exactly what it looks like."
msgstr "「何をしていたかって話なら、見ての通りよ。"

#. Occurrence 5A_2:1103:4463: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0003; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1103
msgctxt "text_id=4463 | speaker=aoko"
msgid "  I was waiting for my prey to pass by. Once you went inside, I was going to follow and cut off your only route of escape.\""
msgstr "　ここで獲物が通り過ぎるのを待ってたの。貴方が入ってから私も入って、逃げ道を無くすつもりだったから」"

#. Occurrence 5A_2:1112:4464: scene=5A_2
#: 5A_2:1112
msgctxt "text_id=4464 | speaker=unknown"
msgid "  Aoko said, perturbed by the swift change in plans."
msgstr "　なのにいきなりコレとはね、と腐りながら青子は言った。"

#. Occurrence 5A_2:1133:4465: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0007; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:1133
msgctxt "text_id=4465 | speaker=soujuurou"
msgid "(Phew, so I came to the right place.)"
msgstr "“そうか。待ち合わせ場所はあってたんだな”"

#. Occurrence 5A_2:1144:4466: scene=5A_2
#: 5A_2:1144
msgctxt "text_id=4466 | speaker=unknown"
msgid "  Soujyuro was mightily relieved he had not got the wrong place."
msgstr "　良かった、と内心でホッとする草十郎。"

#. Occurrence 5A_2:1149:4467: scene=5A_2
#: 5A_2:1149
msgctxt "text_id=4467 | speaker=unknown"
msgid "  It was unclear whether he felt confident about dealing with what was to come, or if he had simply failed to grasp the hopelessness of the situation."
msgstr "　わりと余裕があるのか、それとも事ここに至ってやっぱり現状が把握できていないのか。"

#. Occurrence 5A_2:1154:4468: scene=5A_2
#: 5A_2:1154
msgctxt "text_id=4468 | speaker=unknown"
msgid "  Aoko ignored his obtuse response and continued."
msgstr "　そんな草十郎の<鈍|にぶ>い反応をあえて無視して青子は続けた。"

#. Occurrence 5A_2:1180:4469: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0004; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1180
msgctxt "text_id=4469 | speaker=aoko"
msgid "\"You know, Sizuki."
msgstr "「―――私はね、静希君。"

#. Occurrence 5A_2:1211:4470: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0005; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1211
msgctxt "text_id=4470 | speaker=aoko"
msgid "  Just like anyone else, some people get on my nerves and some people I just really hate."
msgstr "　嫌いな人とか、憎い人とかは人並みにいるんだ。"

#. Occurrence 5A_2:1217:4471: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0006; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1217
msgctxt "text_id=4471 | speaker=aoko"
msgid "  But the funny thing is, my enemies are never people on my shit list.\""
msgstr "　ただ、ちょっとヘンなのが敵になる奴の条件でね」"

#. Occurrence 5A_2:1237:4472: scene=5A_2
#: 5A_2:1237
msgctxt "text_id=4472 | speaker=unknown"
msgid "  Cold emotion burned in her eyes."
msgstr "　凍った<双眸|そうぼう>に火のような感情がともる。"

#. Occurrence 5A_2:1242:4473: scene=5A_2
#: 5A_2:1242
msgctxt "text_id=4473 | speaker=unknown"
msgid "  Her feet had already moved one step closer to Soujyuro."
msgstr "　彼女の足はさらに一歩前へ。"

#. Occurrence 5A_2:1270:4474: scene=5A_2
#: 5A_2:1270
msgctxt "text_id=4474 | speaker=unknown"
msgid "  Soujyuro's sense of foreboding was growing stronger. Wondering if what he sensed was bloodlust, he retreated another step."
msgstr "　草十郎はますます嫌な予感……殺気、というのだろうか？……を覚えてあとじさりする。"

#. Occurrence 5A_2:1276:4475: scene=5A_2
#: 5A_2:1276
msgctxt "text_id=4475 | speaker=unknown"
msgid "  Continuing as so, they maintained a distance of just fifteen feet."
msgstr "　ふたりの距離は、なんだかんだときっかり五メートルをキープしている。"

#. Occurrence 5A_2:1298:4476: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0007; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1298
msgctxt "text_id=4476 | speaker=aoko"
msgid "\"As far as I can recall, I've never thought of someone I didn't like as an enemy."
msgstr "「昔から、私は嫌いな相手でも敵と思った事はなかったの。"

#. Occurrence 5A_2:1304:4477: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0008; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1304
msgctxt "text_id=4477 | speaker=aoko"
msgid "  As it happens, I've even had enemies that I liked."
msgstr "　でも逆に、好きな相手を敵だと思う事もあった。"

#. Occurrence 5A_2:1340:4478: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0009; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1340
msgctxt "text_id=4478 | speaker=aoko"
msgid "  And the reason is simple...\""
msgstr "　理由は単純―――」"

#. Occurrence 5A_2:1403:4479: scene=5A_2
#: 5A_2:1403
msgctxt "text_id=4479 | speaker=unknown"
msgid "  She held her right arm out."
msgstr "　そして、彼女は右腕を目前に<掲|かか>げた。"

#. Occurrence 5A_2:1408:4480: scene=5A_2
#: 5A_2:1408
msgctxt "text_id=4480 | speaker=unknown"
msgid "  The light about her was no illusion."
msgstr "　洋服ごしに光って見えるのは目の錯覚ではなく―――"

#. Occurrence 5A_2:1489:4481: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0010; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1489
msgctxt "text_id=4481 | speaker=aoko"
msgid "\"It's simple, really."
msgstr "「―――当たり前のことだけど。"

#. Occurrence 5A_2:1495:4482: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0011; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1495
msgctxt "text_id=4482 | speaker=aoko"
msgid "  Anyone who throws me out of whack is my enemy.\""
msgstr "　私は、私の感情を乱す奴が敵なのよ」"

#. Occurrence 5A_2:1503:4483: scene=5A_2
#: 5A_2:1503
msgctxt "text_id=4483 | speaker=unknown"
msgid "  Her arm moved again."
msgstr "　掲げられた右腕が振るわれる。"

#. Occurrence 5A_2:1528:4484: scene=5A_2
#: 5A_2:1528
msgctxt "text_id=4484 | speaker=unknown"
msgid "  It was instantaneous."
msgstr "　瞬間、"

#. Occurrence 5A_2:1623:4485: scene=5A_2
#: 5A_2:1623
msgctxt "text_id=4485 | speaker=unknown"
msgid "  Something shot past Soujyuro in the blink of an eye, missing him by just a foot to his left."
msgstr "　何か、視認しづらい物騒なモノが、草十郎から二十センチばかり左にズレて放たれた。"

#. Occurrence 5A_2:1653:4486: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0008; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:1653
msgctxt "text_id=4486 | speaker=soujuurou"
msgid "\"Wai―\""
msgstr "「ちょっ……」"

#. Occurrence 5A_2:1659:4487: scene=5A_2
#: 5A_2:1659
msgctxt "text_id=4487 | speaker=unknown"
msgid "  Before his eyes, a blue light, something akin to a fireball, had ignited from nothing. He finally understood what was happening."
msgstr "　青い光とも、火の玉ともとれる発火現象を目の当たりにして、草十郎はようやく現状を把握した。"

#. Occurrence 5A_2:1689:4488: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0009; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:1689
msgctxt "text_id=4488 | speaker=soujuurou"
msgid "\"Wait a second, I've seen one of those before!\""
msgstr "「ちょっと待った、今のはたいへん見覚えがある！」"

#. Occurrence 5A_2:1694:4489: scene=5A_2
#: 5A_2:1694
msgctxt "text_id=4489 | speaker=unknown"
msgid "  She ignored his dimwitted reaction."
msgstr "　そんな間の抜けた感想は聞き流し、"

#. Occurrence 5A_2:1736:4490: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0012; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1736
msgctxt "text_id=4490 | speaker=aoko"
msgid "\"Damn it. I missed.\""
msgstr "「ち、外したか」"

#. Occurrence 5A_2:1741:4491: scene=5A_2
#: 5A_2:1741
msgctxt "text_id=4491 | speaker=unknown"
msgid "  Aoko muttered to herself."
msgstr "　なんてコトを、青子は呟いた。"

#. Occurrence 5A_2:1761:4492: scene=5A_2
#: 5A_2:1761
msgctxt "text_id=4492 | speaker=unknown"
msgid "  The fist-sized hole the blue light had made in the house of mirrors crackled and smoldered."
msgstr "　青い光はミラーハウスの壁にこぶし大の穴をあけたばかりか、未だにゴウゴウと<燻|くすぶ>っていた。"

#. Occurrence 5A_2:1766:4493: scene=5A_2
#: 5A_2:1766
msgctxt "text_id=4493 | speaker=unknown"
msgid "  A shot like that could easily cave in a human skull in addition to burning it to a crisp."
msgstr "　あれなら人間ひとりの<頭蓋|あたま>を<陥没|かんぼつ>させる事も、まるっと<黒|くろ><焦|こ>げにする事も可能だろう。"

#. Occurrence 5A_2:1794:4494: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0013; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1794
msgctxt "text_id=4494 | speaker=aoko"
msgid "\"...Hah. I'd have to kill myself if Alice saw me miss at this range."
msgstr "「……はあ。こんな射程で外すなんて、有珠に見られたら自殺ものね。"

#. Occurrence 5A_2:1807:4495: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0014; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1807
msgctxt "text_id=4495 | speaker=aoko"
msgid "  But you get it now, right? This is it for you. There won't be a second chance.\""
msgstr "　でもこれで分かったでしょ？　二度目だものね、貴方にとっては」"

#. Occurrence 5A_2:1829:4496: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0010; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:1829
msgctxt "text_id=4496 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5A_2:1849:4497: scene=5A_2
#: 5A_2:1849
msgctxt "text_id=4497 | speaker=unknown"
msgid "  Soujyuro backed away swiftly."
msgstr "　急速に腰が引ける草十郎。"

#. Occurrence 5A_2:1854:4498: scene=5A_2
#: 5A_2:1854
msgctxt "text_id=4498 | speaker=unknown"
msgid "  Things were beyond incomprehensible. He was close to losing the ability to think at all."
msgstr "　理解不能を通り越して思考停止まで一歩手前。"

#. Occurrence 5A_2:1873:4499: scene=5A_2
#: 5A_2:1873
msgctxt "text_id=4499 | speaker=unknown"
msgid "  All he could make out was the figure of the dependable student council president―or at least what he had thought was the president―and the memories of the park that night two days ago."
msgstr "　瞳に<映|うつ>るのは頼れる生徒会長……だったもの……の姿と、二日前に目撃した夜の公園のフラッシュバックだけだ。"

#. Occurrence 5A_2:1908:4500: scene=5A_2
#: 5A_2:1908
msgctxt "text_id=4500 | speaker=unknown"
msgid "  He had never experienced anything like this, though most people living in a civilized country would have never seen anything like it either."
msgstr "　彼には経験がなく、また、法治国家に住むほとんどの人々には経験がない事だが。"

#. Occurrence 5A_2:1913:4501: scene=5A_2
#: 5A_2:1913
msgctxt "text_id=4501 | speaker=unknown"
msgid "  A lethal weapon that could kill with nothing more than the pull of a finger had a way of suspending the ability of its target to determine between not just good and evil, but dreams and reality, past and future."
msgstr "　指を引くだけで人間を殺せる凶器を向けられた時、知性は善悪はおろか夢と現実、過去と未来の判断を停止させる。"

#. Occurrence 5A_2:1918:4502: scene=5A_2
#: 5A_2:1918
msgctxt "text_id=4502 | speaker=unknown"
msgid "  And the more peaceful someone's life had been, the stronger that suspension was likely to be."
msgstr "　それまでの生活が平穏であった分だけ、その停止はより強いものになるだろう。"

#. Occurrence 5A_2:1952:4503: scene=5A_2
#: 5A_2:1952
msgctxt "text_id=4503 | speaker=unknown"
msgid "  All that one could think about was the fact that they were alive at that very moment."
msgstr "　思考にあるのは「生きている今の自分」の姿だけ。"

#. Occurrence 5A_2:1957:4504: scene=5A_2
#: 5A_2:1957
msgctxt "text_id=4504 | speaker=unknown"
msgid "  It was as if he was an unwritten character on a blank piece of white paper."
msgstr "　白紙の上にぽつんと置かれた黒い点と変わらない。"

#. Occurrence 5A_2:1962:4505: scene=5A_2
#: 5A_2:1962
msgctxt "text_id=4505 | speaker=unknown"
msgid "  There was no before, there was no after, there was only what came next."
msgstr "　後も先もない、ただそれだけの状態。"

#. Occurrence 5A_2:1968:4506: scene=5A_2
#: 5A_2:1968
msgctxt "text_id=4506 | speaker=unknown"
msgid "  This was a very common thought process for anyone staring down the barrel of a gun."
msgstr "　それが銃口を向けられた人間の、ごく平均的な思考である。"

#. Occurrence 5A_2:2020:4507: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0015; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:2020
msgctxt "text_id=4507 | speaker=aoko"
msgid "\"Oh, don't bother begging. It's pointless."
msgstr "「あ、<命乞|いのちご>いは止めてね。意味ないから。"

#. Occurrence 5A_2:2026:4508: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0016; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:2026
msgctxt "text_id=4508 | speaker=aoko"
msgid "  But feel free to air your grievances. It's a killer's duty to listen to her victim's last words.\""
msgstr "　でも恨み言ならご自由に。殺す側の義務として、一言一句聞いてあげる」"

#. Occurrence 5A_2:2032:4509: scene=5A_2
#: 5A_2:2032
msgctxt "text_id=4509 | speaker=unknown"
msgid "  By saying it was pointless, she made it sound more like she would not listen to what he had to say."
msgstr "　意味がない、とは、一切聞かない、というコトらしい。"

#. Occurrence 5A_2:2037:4510: scene=5A_2
#: 5A_2:2037
msgctxt "text_id=4510 | speaker=unknown"
msgid "  However, Soujyuro was in such a state of shock that it did not even enter his mind to speak up."
msgstr "　もっとも、草十郎はショック状態で声をあげる行為そのものが思いつかない。"

#. Occurrence 5A_2:2085:4511: scene=5A_2
#: 5A_2:2085
msgctxt "text_id=4511 | speaker=unknown"
msgid "  All he knew, for reasons unknown, was that the girl in front of him wanted him dead."
msgstr "　確かな事は―――そう、理由はともかく、目の前の少女が自分を殺したがっている現実だけ。"

#. Occurrence 5A_2:2106:4512: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0011; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2106
msgctxt "text_id=4512 | speaker=soujuurou"
msgid "(Y-You could have told me, Tobimaru!"
msgstr "『う、嘘つきにもほどがある……！"

#. Occurrence 5A_2:2112:4513: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0012; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2112
msgctxt "text_id=4513 | speaker=soujuurou"
msgid "  You said that no such thing exists!"
msgstr "　鳶丸のバカ、何が“そんな生き物はいない”だ！"

#. Occurrence 5A_2:2112:4514: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0012; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2112
msgctxt "text_id=4514 | speaker=soujuurou"
msgid "  Well, how about now, idiot? There's a monster right in front of me!)"
msgstr "　実際いるじゃないか、こんなお化けみたいなのが……！』"

#. Occurrence 5A_2:2146:4515: scene=5A_2
#: 5A_2:2146
msgctxt "text_id=4515 | speaker=unknown"
msgid "  Soujyuro felt that if he had said that aloud, the second blast would come even quicker than the last, so he kept it to himself."
msgstr "　もし口に出していたら間髪入れず第二撃が飛んできたであろう感想を、草十郎はすんでのところで心にとどめた。"

#. Occurrence 5A_2:2151:4516: scene=5A_2
#: 5A_2:2151
msgctxt "text_id=4516 | speaker=unknown"
msgid "  His mental expletives stirred his mind from paralysis to mere panic."
msgstr "　友人への悪態で<麻痺|ショック>状態から<恐慌|パニック>状態に持ち直す。"

#. Occurrence 5A_2:2198:4517: scene=5A_2
#: 5A_2:2198
msgctxt "text_id=4517 | speaker=unknown"
msgid "  This response came not from confidence, however."
msgstr "　しかし、それは決して余裕からきたものではない。"

#. Occurrence 5A_2:2204:4518: scene=5A_2
#: 5A_2:2204
msgctxt "text_id=4518 | speaker=unknown"
msgid "\"Someday, out of the blue, someone is going to kill me.\""
msgstr "“ある日突然、何者かに殺される”"

#. Occurrence 5A_2:2210:4519: scene=5A_2
#: 5A_2:2210
msgctxt "text_id=4519 | speaker=unknown"
msgid "  While it may have seemed like a baseless belief to hold-"
msgstr "　その、あまりにも<経緯|りゆう>のない非日常は、"

#. Occurrence 5A_2:2231:4520: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0013; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2231
msgctxt "text_id=4520 | speaker=soujuurou"
msgid "(Oh, but now that I think about it, murders happen all the time in cities."
msgstr "『でも、そうだった……都会には<殺|・><人|・><事|・><件|・>がある。"

#. Occurrence 5A_2:2237:4521: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0014; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2237
msgctxt "text_id=4521 | speaker=soujuurou"
msgid "  I should have remembered: if you break the rules, you get killed! I knew that already!)"
msgstr "　ルールを破れば殺されるのは当たり前だって、ちゃんと教えてもらってた……！』"

#. Occurrence 5A_2:2243:4522: scene=5A_2
#: 5A_2:2243
msgctxt "text_id=4522 | speaker=unknown"
msgid "  To Soujyuro, the situation seemed to perfectly align with his inexperienced understanding that the city was a coldly pragmatic place."
msgstr "　都会に慣れていない草十郎にとって、極めて現実的なものだったからだ。"

#. Occurrence 5A_2:2263:4523: scene=5A_2
#: 5A_2:2263
msgctxt "text_id=4523 | speaker=unknown"
msgid "  As far as he was concerned at this moment, being killed by a classmate was not something to be so surprised by."
msgstr "　彼にとって同級生に殺される現実は、そう驚くべき事ではないらしい。"

#. Occurrence 5A_2:2268:4524: scene=5A_2
#: 5A_2:2268
msgctxt "text_id=4524 | speaker=unknown"
msgid "  In a society where murder was possible, he was able to accept this sort of situation as natural. Of virtually no concern was the series of events that led to Aoko's aggression toward him, "
msgstr "　人が人を殺す<事件|ケース>が起こりえる社会ならば、そういうコトもあるだろうと受け止められる。彼は青子の行為、凶行にいたる経緯に、なんら疑問を持っていない。"

#. Occurrence 5A_2:2314:4525: scene=5A_2
#: 5A_2:2314
msgctxt "text_id=4525 | speaker=unknown"
msgid "  The only thing that truly confused him was Aoko's blue fireball."
msgstr "　なので、いま彼を混乱させているものは、青子が起こしている発火現象だけなのだった。"

#. Occurrence 5A_2:2347:4526: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0015; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2347
msgctxt "text_id=4526 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5A_2:2364:4527: scene=5A_2
#: 5A_2:2364
msgctxt "text_id=4527 | speaker=unknown"
msgid "  Soujyuro swallowed with an audible gulp."
msgstr "　草十郎の喉がごくりと唾を飲みこむ。"

#. Occurrence 5A_2:2369:4528: scene=5A_2
#: 5A_2:2369
msgctxt "text_id=4528 | speaker=unknown"
msgid "  To anyone who may have been watching, it was the response of a victim paralyzed by fear."
msgstr "　その反応は、誰の目にも恐怖で<痺|しび>れている犠牲者に見える。"

#. Occurrence 5A_2:2403:4529: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0017; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:2403
msgctxt "text_id=4529 | speaker=aoko"
msgid "\"That's right. So you do finally get it."
msgstr "「そういう事よ。ようやく理解してくれたわね。"

#. Occurrence 5A_2:2409:4530: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0018; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:2409
msgctxt "text_id=4530 | speaker=aoko"
msgid "  I'm all out of words, so I think it's time you died."
msgstr "　多くは語らないけど、貴方にはここで死んでもらう。"

#. Occurrence 5A_2:2427:4531: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0019; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:2427
msgctxt "text_id=4531 | speaker=aoko"
msgid "  I could go on about how magecraft has to stay hidden, but that doesn't really have anything to do with you. All you need to know is that you were in the wrong place at the wrong time. And that it was me who killed you.\""
msgstr "　魔術は<隠匿|いんとく>するもの―――なんて言ってもそっちには関係のない事だし。単に運がなかったって思えばいいわ。大事なのは、私が、貴方を殺したってコトだけだから」"

#. Occurrence 5A_2:2482:4532: scene=5A_2
#: 5A_2:2482
msgctxt "text_id=4532 | speaker=unknown"
msgid "  Done talking, Aoko once again lifted her right arm."
msgstr "　さて、とばかりに青子は再度、右手を<掲|かか>げた。"

#. Occurrence 5A_2:2487:4533: scene=5A_2
#: 5A_2:2487
msgctxt "text_id=4533 | speaker=unknown"
msgid "  There was a hum like a machine."
msgstr "　機械を思わせる駆動音。"

#. Occurrence 5A_2:2492:4534: scene=5A_2
#: 5A_2:2492
msgctxt "text_id=4534 | speaker=unknown"
msgid "  Blue light began to revolve about her arm beneath her sleeve."
msgstr "　<袖|ふく>の下で青い光が回転している。"

#. Occurrence 5A_2:2497:4535: scene=5A_2
#: 5A_2:2497
msgctxt "text_id=4535 | speaker=unknown"
msgid "  This was taking longer than last time, leading Soujyuro to believe that it was going to be much stronger than the attack that was still scorching the wall behind him. The realization caused his panic to heighten."
msgstr "　それがさっきより長い―――つまり、きっと、いま背後の壁を燃やしているものよりずっと強い―――ことに気づいて、草十郎の混乱は加速していく。"

#. Occurrence 5A_2:2570:4536: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0016; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2570
msgctxt "text_id=4536 | speaker=soujuurou"
msgid "(No, wait, it's not about me having to die, or the fact that the monster that night was actually Aozaki, or even whether she's a part of the church... It's not about any of that.)"
msgstr "“いや、なんだ、つまり、始末するとかしないとか、あの夜のお化けは蒼崎だったとか、都会はホントに込み入ってるとか、そういうコトじゃなくて―――”"

#. Occurrence 5A_2:2576:4537: scene=5A_2
#: 5A_2:2576
msgctxt "text_id=4537 | speaker=unknown"
msgid "  His thoughts became jumbled."
msgstr "　混線する思考。"

#. Occurrence 5A_2:2581:4538: scene=5A_2
#: 5A_2:2581
msgctxt "text_id=4538 | speaker=unknown"
msgid "  His heart pounded like a hammer."
msgstr "　早鐘を打つ心臓。"

#. Occurrence 5A_2:2601:4539: scene=5A_2
#: 5A_2:2601
msgctxt "text_id=4539 | speaker=unknown"
msgid "  ...This was no time to be standing still."
msgstr "　―――もう立ち尽くしている場合じゃない。"

#. Occurrence 5A_2:2636:4540: scene=5A_2
#: 5A_2:2636
msgctxt "text_id=4540 | speaker=unknown"
msgid "  He was not sure if the girl in front of him was really human."
msgstr "　目の前の少女が同じ人間であるかさえ怪しいが"

#. Occurrence 5A_2:2661:4541: scene=5A_2
#: 5A_2:2661
msgctxt "text_id=4541 | speaker=unknown"
msgid "  And more importantly, even if he could accept the events unfolding before him, when all was said and done..."
msgstr "　それはともかく、やっぱり、たとえ納得がいくといってもきちんと考えてみたら、"

#. Occurrence 5A_2:2683:4542: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0017; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2683
msgctxt "text_id=4542 | speaker=soujuurou"
msgid "\"Wait! It's wrong to kill people!\""
msgstr "「まて、人殺しはいけないんだぞっ……！」"

#. Occurrence 5A_2:2689:4543: scene=5A_2
#: 5A_2:2689
msgctxt "text_id=4543 | speaker=unknown"
msgid "  Even if it was a fact of life in the city, Soujyuro was not about to lie down and die!"
msgstr "　この通り、いくら都会のルールだからって殺されるのはご<免|めん>こうむる……！"

#. Occurrence 5A_2:2779:4544: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0020; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:2779
msgctxt "text_id=4544 | speaker=aoko"
msgid "\"Don't you think I know that?!\""
msgstr "「分かってるわよ、そんな事はっ！」"

#. Occurrence 5A_2:2805:4545: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0018; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2805
msgctxt "text_id=4545 | speaker=soujuurou"
msgid "\"H-hey―waaaait!\""
msgstr "「ちょっ、待―――！」"

#. Occurrence 5A_2:2811:4546: scene=5A_2
#: 5A_2:2811
msgctxt "text_id=4546 | speaker=unknown"
msgid "  Soujyuro's scream, still entirely oblivious, was just the thing to invoke Aoko's full wrath."
msgstr "　あまりにも空気を読まない草十郎の意見は、的確に青子の<逆鱗|げきりん>に触れまくった。"

#. Occurrence 5A_2:3052:4547: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0019; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3052
msgctxt "text_id=4547 | speaker=soujuurou"
msgid "\"AaaAAAaaah!?\""
msgstr "「うわああああ――――――！！！？」"

#. Occurrence 5A_2:3058:4548: scene=5A_2
#: 5A_2:3058
msgctxt "text_id=4548 | speaker=unknown"
msgid "  Aoko fired a barrage of magical blue bullets."
msgstr "　連続で<撃|う>ち出される青い<魔弾|まだん>と、"

#. Occurrence 5A_2:3063:4549: scene=5A_2
#: 5A_2:3063
msgctxt "text_id=4549 | speaker=unknown"
msgid "  In an instant, Soujyuro dashed into the shadows behind him, into the entrance to the house of mirrors."
msgstr "　とっさに背後の闇―――ミラーハウスの入り口に駆けこむ草十郎。"

#. Occurrence 5A_2:3242:4550: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0020; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3242
msgctxt "text_id=4550 | speaker=soujuurou"
msgid "\"W-w-what the heck was that!?\""
msgstr "「はっ―――なななんだ、今のなんだ―――！？」"

#. Occurrence 5A_2:3249:4551: scene=5A_2
#: 5A_2:3249
msgctxt "text_id=4551 | speaker=unknown"
msgid "  He darted feverishly down the hall."
msgstr "　無我夢中で長い通路を走る。"

#. Occurrence 5A_2:3254:4552: scene=5A_2
#: 5A_2:3254
msgctxt "text_id=4552 | speaker=unknown"
msgid "  After a mere few feet, he was left completely out of breath. This was due to his shock at seeing yet another attack, fiercer than the first, that he'd never seen in his life, and because he couldn't shake the thought that if he had moved even a second later, he would be dead."
msgstr "　たった二メートルの全力疾走で息が上がっているのは初撃を上回る“見たこともない出来事”への驚きと、本気で、あと一秒でも飛びのくのが遅かったら死んでいた、という実感のせいだ。"

#. Occurrence 5A_2:3330:4553: scene=5A_2
#: 5A_2:3330
msgctxt "text_id=4553 | speaker=unknown"
msgid "  He could not afford to stop."
msgstr "　足を止める余裕はない。"

#. Occurrence 5A_2:3339:4554: scene=5A_2
#: 5A_2:3339
msgctxt "text_id=4554 | speaker=unknown"
msgid "  The sound of merciless footsteps closed in behind him."
msgstr "　草十郎の後ろには容赦のない足音が迫っている。"

#. Occurrence 5A_2:3360:4555: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0021; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3360
msgctxt "text_id=4555 | speaker=soujuurou"
msgid "\"I've bought myself some time. Maybe here I'll be able to figure out something...\""
msgstr "「……けど助かった。ここならなんとか―――」"

#. Occurrence 5A_2:3382:4556: scene=5A_2
#: 5A_2:3382
msgctxt "text_id=4556 | speaker=unknown"
msgid "  He threw everything into his legs as he sprinted."
msgstr "　なるかもしれない、と全力で走る。"

#. Occurrence 5A_2:3388:4557: scene=5A_2
#: 5A_2:3388
msgctxt "text_id=4557 | speaker=unknown"
msgid "  A straight, narrow passage about sixty feet long connected the entrance to the main lobby."
msgstr "　ミラーハウスは入り口からエントランスにあたるロビーまで、細長い通路が二十メートルほど続いている。"

#. Occurrence 5A_2:3395:4558: scene=5A_2
#: 5A_2:3395
msgctxt "text_id=4558 | speaker=unknown"
msgid "  At this rate, if he could just make it to the lobby, he was sure he would be able to find as many hiding spots as he needed."
msgstr "　このままロビーまで逃げこめば、あとはいくらでも隠れ場所はありそうだ。"

#. Occurrence 5A_2:3453:4559: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0022; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3453
msgctxt "text_id=4559 | speaker=soujuurou"
msgid "(Thank god!)"
msgstr "『助かった……！』"

#. Occurrence 5A_2:3459:4560: scene=5A_2
#: 5A_2:3459
msgctxt "text_id=4560 | speaker=unknown"
msgid "  He arrived in a large, open space."
msgstr "　大きな空間にたどり着く。"

#. Occurrence 5A_2:3464:4561: scene=5A_2
#: 5A_2:3464
msgctxt "text_id=4561 | speaker=unknown"
msgid "  This was the first-floor lobby. There were three passageways."
msgstr "　ここが一階ロビー。通路は三つ。"

#. Occurrence 5A_2:3469:4562: scene=5A_2
#: 5A_2:3469
msgctxt "text_id=4562 | speaker=unknown"
msgid "  One led to the basement floor."
msgstr "　地下に下りる階段と、"

#. Occurrence 5A_2:3469:4563: scene=5A_2
#: 5A_2:3469
msgctxt "text_id=4563 | speaker=unknown"
msgid "  One connected to the first-floor maze."
msgstr "　一階迷路への入り口通路と、"

#. Occurrence 5A_2:3469:4564: scene=5A_2
#: 5A_2:3469
msgctxt "text_id=4564 | speaker=unknown"
msgid "  The other was a set of stairs leading to the second floor."
msgstr "　二階に上る階段。"

#. Occurrence 5A_2:3489:4565: scene=5A_2
#: 5A_2:3489
msgctxt "text_id=4565 | speaker=unknown"
msgid "  Soujyuro did not particularly care which one he chose, so, trusting his intuition, he made a run for the first-floor maze, when..."
msgstr "　今はどれでもいい、と草十郎は直感的に一階の迷路へ逃げこもうと踏みこんで、"

#. Occurrence 5A_2:3556:4566: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0023; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3556
msgctxt "text_id=4566 | speaker=soujuurou"
msgid "\"Ouch!\""
msgstr "「痛……！？」"

#. Occurrence 5A_2:3562:4567: scene=5A_2
#: 5A_2:3562
msgctxt "text_id=4567 | speaker=unknown"
msgid "  He smacked his head into a transparent wall."
msgstr "　がいーん、と透明の壁に頭からぶつかった。"

#. Occurrence 5A_2:3589:4568: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0024; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3589
msgctxt "text_id=4568 | speaker=soujuurou"
msgid "\"A...mirror!?\""
msgstr "「か、鏡……!?」"

#. Occurrence 5A_2:3595:4569: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0021; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3595
msgctxt "text_id=4569 | speaker=aoko"
msgid "\"That's right. It's annoying, but I guess this makes things fair."
msgstr "「ええ。面倒だけど、それならフェアでしょ？"

#. Occurrence 5A_2:3601:4570: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0022; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3601
msgctxt "text_id=4570 | speaker=aoko"
msgid "  The chaser and the chased are on equal ground.\""
msgstr "　追いかける方にも逃げる方にも有利不利がある」"

#. Occurrence 5A_2:3630:4571: scene=5A_2
#: 5A_2:3630
msgctxt "text_id=4571 | speaker=unknown"
msgid "  A somehow cheerful voice echoed in his direction."
msgstr "　どことなく楽しげな声が届く。"

#. Occurrence 5A_2:3635:4572: scene=5A_2
#: 5A_2:3635
msgctxt "text_id=4572 | speaker=unknown"
msgid "  There was no need for Soujyuro to even turn around."
msgstr "　いちいち振り向くまでもない。"

#. Occurrence 5A_2:3640:4573: scene=5A_2
#: 5A_2:3640
msgctxt "text_id=4573 | speaker=unknown"
msgid "  In the very same mirror he had crashed into he could see Aoko Aozaki's figure slowly approaching."
msgstr "　いま彼を<弾|はじ>いた鏡に、ゆっくりと歩いてくる蒼崎青子の姿が映っている。"

#. Occurrence 5A_2:3661:4574: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0023; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3661
msgctxt "text_id=4574 | speaker=aoko"
msgid "\"You should know, I sealed off the first floor exit deeper inside. Physically, not with a Bounded Field."
msgstr "「それと、一階の奥にある出口は封鎖しといたから。結界じゃなくて物理的に。"

#. Occurrence 5A_2:3667:4575: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0024; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3667
msgctxt "text_id=4575 | speaker=aoko"
msgid "  Is calling it a seal going too far? Maybe plugged or buried works. Either way, if you get too close, you'll be swallowed by a cave-in. I recommend keeping your distance if you don't want to be buried alive.\""
msgstr "　やりすぎて封鎖っていうより瓦礫？　土砂崩れ？　どっちでもいっか。とにかく下手に出口に近づくと崩落に巻き込まれるから。生き埋めがイヤなら近寄らないことね」"

#. Occurrence 5A_2:3711:4576: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0025; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3711
msgctxt "text_id=4576 | speaker=soujuurou"
msgid "\"-, -!\""
msgstr "「―――、―――！」"

#. Occurrence 5A_2:3717:4577: scene=5A_2
#: 5A_2:3717
msgctxt "text_id=4577 | speaker=unknown"
msgid "  Panicked by the impending footsteps, Soujyuro groped for the wall."
msgstr "　近づいてくる足音に焦りながら、草十郎は手探りで壁に向かう。"

#. Occurrence 5A_2:3722:4578: scene=5A_2
#: 5A_2:3722
msgctxt "text_id=4578 | speaker=unknown"
msgid "  He could see the stairs to the second floor."
msgstr "　見えているのは二階への階段だ。"

#. Occurrence 5A_2:3727:4579: scene=5A_2
#: 5A_2:3727
msgctxt "text_id=4579 | speaker=unknown"
msgid "  He did not understand what Aoko had meant earlier, but he at least knew that the first floor was not going to save him."
msgstr "　青子の言っている<内|コ><容|ト>はさっぱりだが、一階はまずい、という事だけは確かだった。"

#. Occurrence 5A_2:3768:4580: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0025; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3768
msgctxt "text_id=4580 | speaker=aoko"
msgid "\"It would save me a lot of trouble if you just died that way, though."
msgstr "「ま、私としてはそっちのが助かるけど。"

#. Occurrence 5A_2:3774:4581: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0026; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3774
msgctxt "text_id=4581 | speaker=aoko"
msgid "  The cleanup is much easier for accidental deaths.\""
msgstr "　形式上、事故死の方が後始末とか楽だから」"

#. Occurrence 5A_2:3786:4582: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0026; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3786
msgctxt "text_id=4582 | speaker=soujuurou"
msgid "\"...!\""
msgstr "「……！」"

#. Occurrence 5A_2:3792:4583: scene=5A_2
#: 5A_2:3792
msgctxt "text_id=4583 | speaker=unknown"
msgid "  Behind him was a creature beyond words."
msgstr "　背後には正体不明の生物。"

#. Occurrence 5A_2:3797:4584: scene=5A_2
#: 5A_2:3797
msgctxt "text_id=4584 | speaker=unknown"
msgid "  As she continued her idle taunting, she lifted her right arm ostentatiously."
msgstr "　彼女は軽口と共に、これみよがしに右腕を持ち上げる。"

#. Occurrence 5A_2:3855:4585: scene=5A_2
#: 5A_2:3855
msgctxt "text_id=4585 | speaker=unknown"
msgid "  Even from above her clothes one could see some kind of strange, incongruous pattern upon her body."
msgstr "　……それは服の上からでも分かる、少女の体には不釣り合いな、一種奇怪な<紋様|もんよう>だった。"

#. Occurrence 5A_2:3860:4586: scene=5A_2
#: 5A_2:3860
msgctxt "text_id=4586 | speaker=unknown"
msgid "  The veins beneath her skin..."
msgstr "　皮膚の下の血管。"

#. Occurrence 5A_2:3865:4587: scene=5A_2
#: 5A_2:3865
msgctxt "text_id=4587 | speaker=unknown"
msgid "  They made it seem as though something inhuman was circulating her body."
msgstr "　身体を巡る機能の一つが、人間以外のモノで回っているような。"

#. Occurrence 5A_2:3923:4588: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0027; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3923
msgctxt "text_id=4588 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5A_2:3928:4589: scene=5A_2
#: 5A_2:3928
msgctxt "text_id=4589 | speaker=unknown"
msgid "  Whether out of pity or repulsion,"
msgstr "　それを傷ましいとも、おぞましいとも感じたのか。"

#. Occurrence 5A_2:3933:4590: scene=5A_2
#: 5A_2:3933
msgctxt "text_id=4590 | speaker=unknown"
msgid "  Soujyuro stopped for just a moment."
msgstr "　一瞬だけ足を止める草十郎と、"

#. Occurrence 5A_2:3933:4591: scene=5A_2
#: 5A_2:3933
msgctxt "text_id=4591 | speaker=unknown"
msgid "  His pursuer evaded his gaze."
msgstr "　その視線を受け流す追跡者。"

#. Occurrence 5A_2:3975:4592: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0027; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3975
msgctxt "text_id=4592 | speaker=aoko"
msgid "\"You've noticed, then. I normally hide it with ointment, but today is special."
msgstr "「ああ、これ？　普段は塗り薬で隠しているんだけど、今日は特別。"

#. Occurrence 5A_2:3986:4593: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0028; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3986
msgctxt "text_id=4593 | speaker=aoko"
msgid "  It's called a Magical Crest. It's proof that I'm a mage."
msgstr "　魔術刻印って言ってね、魔術師の証みたいな物よ。"

#. Occurrence 5A_2:3992:4594: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0029; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3992
msgctxt "text_id=4594 | speaker=aoko"
msgid "  You see this light revolving around me, right? It's the beginning of what formed that Snap―those bullets."
msgstr "　ほら、光が回ってるでしょ？　これがさっきのスナップ……分かりやすくいうと弾丸のもと。"

#. Occurrence 5A_2:4003:4595: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0030; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:4003
msgctxt "text_id=4595 | speaker=aoko"
msgid "  I'm feeling pretty good today, and I've never felt more confident in how to use my magical energy efficiently. I think I'm good for another thirty bullets or so.\""
msgstr "　今日は調子いいし、私、魔力を効率よく使うのだけは自信あるし―――うん、あと三十回ぐらいかな？　さっきみたいな掃射ができるのは」"

#. Occurrence 5A_2:4023:4596: scene=5A_2
#: 5A_2:4023
msgctxt "text_id=4596 | speaker=unknown"
msgid "  Perhaps she was on an emotional high, for her voice had become frightfully friendly."
msgstr "　感情がハイになっているのか、彼女はやけにフレンドリーな口調だった。"

#. Occurrence 5A_2:4049:4597: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0028; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:4049
msgctxt "text_id=4597 | speaker=soujuurou"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence 5A_2:4054:4598: scene=5A_2
#: 5A_2:4054
msgctxt "text_id=4598 | speaker=unknown"
msgid "  The substance of the conversation could not have been any more unsettling, however."
msgstr "　もっとも、会話の内容は物騒なコトこの上ないのだが。"

#. Occurrence 5A_2:4081:4599: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0029; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:4081
msgctxt "text_id=4599 | speaker=soujuurou"
msgid "\"...I don't understand a thing you're saying, Aozaki.\""
msgstr "「……そもそも、何を言っているかよく分からないんだけど、蒼崎」"

#. Occurrence 5A_2:4087:4600: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0031; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:4087
msgctxt "text_id=4600 | speaker=aoko"
msgid "\"You don't? I'm telling you that I have thirty more shots in the tank."
msgstr "「分からない？　弾数はあと三十発って事。"

#. Occurrence 5A_2:4093:4601: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0032; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:4093
msgctxt "text_id=4601 | speaker=aoko"
msgid "  If you can escape before I use them up, it's your win. For today, that is.\""
msgstr "　そこまで逃げ切ればあなたの勝ちよ。とりあえず、今日のところはね」"

#. Occurrence 5A_2:4126:4602: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0030; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:4126
msgctxt "text_id=4602 | speaker=soujuurou"
msgid "(...For today? You mean I have to do this tomorrow, too?)"
msgstr "『……今日はって、明日もあるのかな……』"

#. Occurrence 5A_2:4132:4603: scene=5A_2
#: 5A_2:4132
msgctxt "text_id=4603 | speaker=unknown"
msgid "  Soujyuro knit his brows."
msgstr "　眉をひそめて悩む草十郎。"

#. Occurrence 5A_2:4221:4604: scene=5A_2
#: 5A_2:4221
msgctxt "text_id=4604 | speaker=unknown"
msgid "  Aoko's expression creased into a scowl at his behavior. Although he was panicking, it seemed that deep down he still did not feel the full weight of the crisis."
msgstr "　恐慌しながらも、やはり根っこのところで危機感のない態度に、青子も<微|かす>かに眉を寄せる。"

#. Occurrence 5A_2:4226:4605: scene=5A_2
#: 5A_2:4226
msgctxt "text_id=4605 | speaker=unknown"
msgid "  She knew he still didn't get it."
msgstr "　やっぱりこいつは理解できない、と。"

#. Occurrence 5A_2:4254:4606: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0033; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:4254
msgctxt "text_id=4606 | speaker=aoko"
msgid "\"I said my piece. Free time is over."
msgstr "「宣言はしたわ。自由時間はこれでおしまい。"

#. Occurrence 5A_2:4260:4607: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0034; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:4260
msgctxt "text_id=4607 | speaker=aoko"
msgid "  I may still have some trash talk left in me, but, well, there's never enough time to get it all off my chest, anyway. Just give up already.\""
msgstr "　まだ<罵|ののし>り足りないだろうけど、ま、その手の時間はキリがないしね。このあたりで<諦|あきら>めて」"

#. Occurrence 5A_2:4287:4608: scene=5A_2
#: 5A_2:4287
msgctxt "text_id=4608 | speaker=unknown"
msgid "  It appeared Aoko had prepared this theatrical dialogue ahead of time."
msgstr "　どうも、この<弛緩|しかん>した会話劇は<意|い><図|と>的に用意されたものらしい。"

#. Occurrence 5A_2:4292:4609: scene=5A_2
#: 5A_2:4292
msgctxt "text_id=4609 | speaker=unknown"
msgid "  Not to allow her opponent time for futile pleading, but to give him the time to curse her, his killer."
msgstr "　届かない命乞いではなく、殺人者を呪う<時間|けんり>。"

#. Occurrence 5A_2:4297:4610: scene=5A_2
#: 5A_2:4297
msgctxt "text_id=4610 | speaker=unknown"
msgid "  Such forthrightness was her modus operandi. With this victim, however, it was not going as she had hoped."
msgstr "　……青子流の公正さなのだが、締まらないコトに、今回はうまく機能しなかったようだ。"

#. Occurrence 5A_2:4366:4611: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0035; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:4366
msgctxt "text_id=4611 | speaker=aoko"
msgid "\"Anyway, that's all I have to say."
msgstr "「とにかくそういう事だから。"

#. Occurrence 5A_2:4377:4612: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0036; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:4377
msgctxt "text_id=4612 | speaker=aoko"
msgid "  Shall we begin the hunt?\""
msgstr "　―――じゃ、狩りの時間といきましょうか」"

#. Occurrence 5A_2:4383:4613: scene=5A_2
#: 5A_2:4383
msgctxt "text_id=4613 | speaker=unknown"
msgid "  Her voice was void of emotion, and her eyes ruthless as they bored into her prey."
msgstr "　感情を<排|はい>した声と、冷酷に獲物を見据える瞳。"

#. Occurrence 5A_2:4388:4614: scene=5A_2
#: 5A_2:4388
msgctxt "text_id=4614 | speaker=unknown"
msgid "  This time, Soujyuro finally accepted that he was going to die."
msgstr "　それで今度こそ本当に、自分が殺されるという現実を、草十郎は実感した。"

#. Occurrence 5A_3:60:4615: scene=5A_3
#: 5A_3:60
msgctxt "text_id=4615 | speaker=unknown"
msgid "  ...Silent as the dead, it stepped into the remnants of a dream that had long since seen no visitors."
msgstr "　……長らく入園者のいない夢の<廃墟|あと>に、<彼|ソ><女|レ>は力なく、亡霊のような静けさで足を踏み入れた。"

#. Occurrence 5A_3:66:4616: scene=5A_3
#: 5A_3:66
msgctxt "text_id=4616 | speaker=unknown"
msgid "  There was no wind this night, nor a soul to be seen."
msgstr "　今夜は無風で、周囲は無人。"

#. Occurrence 5A_3:75:4617: scene=5A_3
#: 5A_3:75
msgctxt "text_id=4617 | speaker=unknown"
msgid "  Still, it heard the echoes from within, clasped its hands together, and grinned."
msgstr "　それなのに響いてくる雑音に、<彼|ソ><女|レ>はにんまりと、手を合わせて微笑んだ。"

#. Occurrence 5A_3:134:4618: scene=5A_3
#: 5A_3:134
msgctxt "text_id=4618 | speaker=unknown"
msgid "  Its form, with hands clasped, resembled that of a budding tulip."
msgstr "　可愛らしく合わされた<手|カタチ>は、チューリップの蕾のようだ。"

#. Occurrence 5A_3:140:4619: scene=5A_3
#: 5A_3:140
msgctxt "text_id=4619 | speaker=unknown"
msgid "  The bearing of this artificial flower reflected in the cloudy mirror of the ticket attendant's office next to the gate."
msgstr "　<入|ゲ><り|ー><口|ト>横の係員室の<曇|くも>った鏡に、造花の仕草が映し出される。"

#. Occurrence 5A_3:145:4620: scene=5A_3
#: 5A_3:145
msgctxt "text_id=4620 | speaker=unknown"
msgid "  Next to it stood a display board, corroded by years upon years of rust."
msgstr "　その横には、錆びに錆びた掲示板。"

#. Occurrence 5A_3:209:4621: scene=5A_3
#: 5A_3:209
msgctxt "text_id=4621 | speaker=unknown"
msgid "                              No. of Visitors Today: 2"
msgstr "　　　　　『今日の入園者数：　　２人"

#. Occurrence 5A_3:215:4622: scene=5A_3
#: 5A_3:215
msgctxt "text_id=4622 | speaker=unknown"
msgid "                              No. of ----        Today: __"
msgstr "　　　　　　今日の××××：　　　件』"

#. Occurrence 5A_3:222:4623: scene=5A_3
#: 5A_3:222
msgctxt "text_id=4623 | speaker=unknown"
msgid "                              No. of ----       Today: __"
msgstr "　　　　　　今日の××××：　　　件』"

#. Occurrence 5A_3:257:4624: scene=5A_3
#: 5A_3:257
msgctxt "text_id=4624 | speaker=unknown"
msgid "  The board had graffiti crudely scrawled atop one of the words."
msgstr "　風蝕にさらされた掲示板には心ない落書きが一つ。"

#. Occurrence 5A_3:263:4625: scene=5A_3
#: 5A_3:263
msgctxt "text_id=4625 | speaker=unknown"
msgid "  It was replaced with \"Deaths.\""
msgstr "　今日の××××数は、死亡事故、という単語に書き換えられていた。"

#. Occurrence 5A_3:268:4626: scene=5A_3
#: 5A_3:268
msgctxt "text_id=4626 | speaker=unknown"
msgid "  The records board had long ago fallen to disrepair."
msgstr "　もう使われるコトのない記録表。"

#. Occurrence 5A_3:273:4627: scene=5A_3
#: 5A_3:273
msgctxt "text_id=4627 | speaker=unknown"
msgid "  After taking a full ten seconds to digest what it was looking at, it made its own revision."
msgstr "　それが何であるかたっぷり十秒ほど考えて、<彼|ソ><女|レ>は新たな数字を付け足した。"

#. Occurrence 5A_3:332:4628: scene=5A_3
#: 5A_3:332
msgctxt "text_id=4628 | speaker=unknown"
msgid "                                No. of Visitors Today: 3"
msgstr "　　　　　　『今日の入園者数：　　３人"

msgctxt "text_id=4629 | speaker=unknown"
msgid "                                No. of Deaths  Today: 1"
msgstr "　　　　　　　今日の死亡事故：　　１件』"

#. Occurrence 5A_3:367:4630: scene=5A_3
#: 5A_3:367
msgctxt "text_id=4630 | speaker=unknown"
msgid "  After appending this number with an index finger, she smiled like a flower."
msgstr "　人差し指で数字を付け足して、彼女は花のように微笑む。"

#. Occurrence 5A_3:372:4631: scene=5A_3
#: 5A_3:372
msgctxt "text_id=4631 | speaker=unknown"
msgid "  Then she began to walk toward the source of the sound."
msgstr "　……は、音に向かって歩きだす。"

#. Occurrence 5A_3:433:4632: scene=5A_3
#: 5A_3:433
msgctxt "text_id=4632 | speaker=unknown"
msgid "  It had been ten minutes since this rhapsody had begun to echo from the house of mirrors."
msgstr "　ミラーハウスから狂詩曲じみた雑音が<響|ひび>きだしてから、はや十分。"

#. Occurrence 5A_3:440:4633: scene=5A_3
#: 5A_3:440
msgctxt "text_id=4633 | speaker=unknown"
msgid "  The amusement park's entrance returned to as it was before: soulless."
msgstr "　遊園地の入り口は、ずっと無人のままだった。"

#. Occurrence 5A_4:45:4634: scene=5A_4
#: 5A_4:45
msgctxt "text_id=4634 | speaker=unknown"
msgid "  In the end..."
msgstr "　結論から言えば。"

#. Occurrence 5A_4:50:4635: scene=5A_4
#: 5A_4:50
msgctxt "text_id=4635 | speaker=unknown"
msgid "  Even if Soujyuro had been the luckiest man alive, there was no way he should have been able to escape."
msgstr "　仮に、<草十郎|カレ>が世界で一番強運な男だとしても、逃げきれる筈はなかったのである。"

#. Occurrence 5A_4:88:4636: scene=5A_4
#: 5A_4:88
msgctxt "text_id=4636 | speaker=unknown"
msgid "  The question, however, was how much of this was by design,"
msgstr "　ただ、どこまでが計算通りで、"

#. Occurrence 5A_4:93:4637: scene=5A_4
#: 5A_4:93
msgctxt "text_id=4637 | speaker=unknown"
msgid "  and how much was sheer coincidence?"
msgstr "　どこまでが偶然だったのか。"

#. Occurrence 5A_4:98:4638: scene=5A_4
#: 5A_4:98
msgctxt "text_id=4638 | speaker=unknown"
msgid "  Even Aoko, who had made all the arrangements, had no answer."
msgstr "　それは結末を用意していた青子にも分からない。"

#. Occurrence 5A_4:119:4639: scene=5A_4
#: 5A_4:119
msgctxt "text_id=4639 | speaker=unknown"
msgid "  Indeed, there were only three things she could say:"
msgstr "　彼女に言えるのは三つだけ。"

#. Occurrence 5A_4:124:4640: scene=5A_4
#: 5A_4:124
msgctxt "text_id=4640 | speaker=unknown"
msgid "  It was taking longer than expected,"
msgstr "　思っていたより時間がかかって、"

#. Occurrence 5A_4:129:4641: scene=5A_4
#: 5A_4:129
msgctxt "text_id=4641 | speaker=unknown"
msgid "  he was putting up more resistance than she had anticipated,"
msgstr "　予想していたより<手応|てごた>えがあって、"

#. Occurrence 5A_4:134:4642: scene=5A_4
#: 5A_4:134
msgctxt "text_id=4642 | speaker=unknown"
msgid "  and that choosing the house of mirrors had been a mistake."
msgstr "　それと、ミラーハウスを選んだのは失敗だった、というコトぐらい。"

#. Occurrence 5A_4:202:4643: scene=5A_4
#: 5A_4:202
msgctxt "text_id=4643 | speaker=unknown"
msgid "  She had really screwed the pooch on this one."
msgstr "　……そう、何が失敗かと言うと。"

#. Occurrence 5A_4:207:4644: scene=5A_4
#: 5A_4:207
msgctxt "text_id=4644 | speaker=unknown"
msgid "  The location itself was an excellent choice, as the house of mirrors was perfect as a hunting ground. But seeing her own incompetence reflected in the mirrors was beginning to grate on her."
msgstr "　ミラーハウスは狩り場として文句なしの地形だったけれど、鏡に映る自分と向き合うのは半人前の彼女にとって、少しだけ苛立たしいコトだった。"

#. Occurrence 5A_4:463:4645: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0000; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:463
msgctxt "text_id=4645 | speaker=soujuurou"
msgid "\"Ahhh!\""
msgstr "「うわあ！」"

#. Occurrence 5A_4:469:4646: scene=5A_4
#: 5A_4:469
msgctxt "text_id=4646 | speaker=unknown"
msgid "  The moment Aoko's right arm began to glow, Soujyuro made a beeline for the staircase in front of him."
msgstr "　青子の右腕が光った瞬間、草十郎は目の前の階段に逃げこんだ。"

#. Occurrence 5A_4:474:4647: scene=5A_4
#: 5A_4:474
msgctxt "text_id=4647 | speaker=unknown"
msgid "  A strobing series of blue flashes lit the room behind him."
msgstr "　背後には連続する青い<閃光|ストロボ>。"

#. Occurrence 5A_4:479:4648: scene=5A_4
#: 5A_4:479
msgctxt "text_id=4648 | speaker=unknown"
msgid "  The hunter calmly followed her prey, and the prey desperately ran for his life up the stairs."
msgstr "　無我夢中で階段を駆け上がる獲物を、狩人はあわてずに追っていく。"

#. Occurrence 5A_4:592:4649: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0000; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:592
msgctxt "text_id=4649 | speaker=aoko"
msgid "\"...Just what the doctor ordered."
msgstr "「―――注文通り。"

#. Occurrence 5A_4:598:4650: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0001; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:598
msgctxt "text_id=4650 | speaker=aoko"
msgid "  We can't very well let the best-laid plans go to waste now, can we?\""
msgstr "　そうでなくっちゃ、お<膳立|ぜんだ>てした甲斐がない」"

#. Occurrence 5A_4:604:4651: scene=5A_4
#: 5A_4:604
msgctxt "text_id=4651 | speaker=unknown"
msgid "  In stark contrast to Soujyuro's frenzied escape, Aoko walked briskly up the stairs."
msgstr "　走る草十郎とは対照的に、青子はやや早歩きで階段を上っていく。"

#. Occurrence 5A_4:650:4652: scene=5A_4
#: 5A_4:650
msgctxt "text_id=4652 | speaker=unknown"
msgid "  She elected not to run after her prey in order to maintain a set distance."
msgstr "　青子が走って追わないのは、獲物と一定の距離を保つためだ。"

#. Occurrence 5A_4:655:4653: scene=5A_4
#: 5A_4:655
msgctxt "text_id=4653 | speaker=unknown"
msgid "  As she lacked confidence in her accuracy, she would be the most challenged if Soujyuro bull-rushed her and went down fighting."
msgstr "　命中率に自信のない彼女にとって、もっとも対処に困るのが玉砕覚悟の突進である。"

#. Occurrence 5A_4:751:4654: scene=5A_4
#: 5A_4:751
msgctxt "text_id=4654 | speaker=unknown"
msgid "  But at a distance of thirty or so feet, he posed no threat."
msgstr "　十メートル程度の距離があるのなら問題はない。"

#. Occurrence 5A_4:756:4655: scene=5A_4
#: 5A_4:756
msgctxt "text_id=4655 | speaker=unknown"
msgid "  By the time her prey drew near, she could fire ten shots and hit with at least four of them."
msgstr "　獲物が接近するまで十発中四発は当てられる。"

#. Occurrence 5A_4:761:4656: scene=5A_4
#: 5A_4:761
msgctxt "text_id=4656 | speaker=unknown"
msgid "  Their positioning just a moment ago hadn't been ideal."
msgstr "　しかし先ほどの位置関係は少々まずかった。"

#. Occurrence 5A_4:766:4657: scene=5A_4
#: 5A_4:766
msgctxt "text_id=4657 | speaker=unknown"
msgid "  At this distance, in a space this open, there was a chance, however small, that it could turn into a fistfight if he flanked and charged her."
msgstr "　あの距離、あの広さの空間で迂回されながら突進されたら、わずかではあるが、そのまま接近されて素手での争いになる可能性がある。"

#. Occurrence 5A_4:786:4658: scene=5A_4
#: 5A_4:786
msgctxt "text_id=4658 | speaker=unknown"
msgid "  Currently, Aoko's best weapon was the bullets from her right arm."
msgstr "　現在、青子の最大の武器は右腕の魔弾だ。"

#. Occurrence 5A_4:791:4659: scene=5A_4
#: 5A_4:791
msgctxt "text_id=4659 | speaker=unknown"
msgid "  If she was going to capitalize on that advantage, it was in her best interest not to close the gap between them."
msgstr "　この利点を生かすのなら距離を詰めすぎてはいけない。"

#. Occurrence 5A_4:796:4660: scene=5A_4
#: 5A_4:796
msgctxt "text_id=4660 | speaker=unknown"
msgid "  If there was a good time to approach, it was only after her prey had become exhausted and had lost the will to continue."
msgstr "　近づく時があるとしたら、それは獲物の体力がなくなり、<諦|あきら>めたあと。"

#. Occurrence 5A_4:851:4661: scene=5A_4
#: 5A_4:851
msgctxt "text_id=4661 | speaker=unknown"
msgid "  Would she pierce his leg? Shoot him in the back?"
msgstr "　足を射貫くか、背中を撃つか。"

#. Occurrence 5A_4:856:4662: scene=5A_4
#: 5A_4:856
msgctxt "text_id=4662 | speaker=unknown"
msgid "  Or, perhaps, would he just give up after losing himself in the labyrinth?"
msgstr "　あるいは、この迷路で心が折れるか。"

#. Occurrence 5A_4:861:4663: scene=5A_4
#: 5A_4:861
msgctxt "text_id=4663 | speaker=unknown"
msgid "  The hunt would end when her target sustained some sort of injury and became unable to run."
msgstr "　なんらかの傷を負って標的が走れなくなった時が、この狩りの幕引きとなる。"

#. Occurrence 5A_4:917:4664: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0001; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:917
msgctxt "text_id=4664 | speaker=soujuurou"
msgid "\"...!\""
msgstr "「っ―――！」"

#. Occurrence 5A_4:923:4665: scene=5A_4
#: 5A_4:923
msgctxt "text_id=4665 | speaker=unknown"
msgid "  On Soujyuro's end, he could barely bite back on screaming as he bolted through the maze."
msgstr "　一方、草十郎は悲鳴を<堪|こら>えながら迷路を走っていた。"

#. Occurrence 5A_4:928:4666: scene=5A_4
#: 5A_4:928
msgctxt "text_id=4666 | speaker=unknown"
msgid "  Even running in a straight line had become difficult, much less searching for an exit."
msgstr "　出口など目指しようもなく、まっすぐ走る事すら難しい。"

#. Occurrence 5A_4:988:4667: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0002; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:988
msgctxt "text_id=4667 | speaker=soujuurou"
msgid "\"Ow!\""
msgstr "「あいた！？」"

#. Occurrence 5A_4:994:4668: scene=5A_4
#: 5A_4:994
msgctxt "text_id=4668 | speaker=unknown"
msgid "  The corridor stretched out far before him...or so the mirrors blocking the path had made it seem."
msgstr "　長く伸びている通路は、そう見えるだけで鏡の壁でふさがれている。"

#. Occurrence 5A_4:1000:4669: scene=5A_4
#: 5A_4:1000
msgctxt "text_id=4669 | speaker=unknown"
msgid "  Panicked, he made a turn to the right."
msgstr "　あわてて右に曲がろうとして、"

#. Occurrence 5A_4:1066:4670: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0003; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:1066
msgctxt "text_id=4670 | speaker=soujuurou"
msgid "\"That hurt!\""
msgstr "「あたた！？」"

#. Occurrence 5A_4:1074:4671: scene=5A_4
#: 5A_4:1074
msgctxt "text_id=4671 | speaker=unknown"
msgid "  Clutching his head in his right arm, Soujyuro led with his left, groping through the air to see whether a wall was there or not."
msgstr "　草十郎は額をおさえながら残った左に腕を伸ばし、壁がない事を確認し、"

#. Occurrence 5A_4:1131:4672: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0004; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:1131
msgctxt "text_id=4672 | speaker=soujuurou"
msgid "\"Nngh!\""
msgstr "「！」"

#. Occurrence 5A_4:1136:4673: scene=5A_4
#: 5A_4:1136
msgctxt "text_id=4673 | speaker=unknown"
msgid "  He dove down the hall to the left, narrowly dodging the bullets targeting his life."
msgstr "　とっさに左の通路に飛びこんで、コンマの差で凶弾から身をかわす。"

#. Occurrence 5A_4:1219:4674: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0005; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:1219
msgctxt "text_id=4674 | speaker=soujuurou"
msgid "\"Hah...haah...!\""
msgstr "「はっ―――、は―――！」"

#. Occurrence 5A_4:1225:4675: scene=5A_4
#: 5A_4:1225
msgctxt "text_id=4675 | speaker=unknown"
msgid "  Urged on by the sound of approaching footsteps, he ran without thinking."
msgstr "　近づいてくる足音にせき立てられて、考える前にとにかく走る。"

#. Occurrence 5A_4:1273:4676: scene=5A_4
#: 5A_4:1273
msgctxt "text_id=4676 | speaker=unknown"
msgid "  That last one was close. A hair closer would have meant his life."
msgstr "　今のは本当に紙一重だった。"

#. Occurrence 5A_4:1279:4677: scene=5A_4
#: 5A_4:1279
msgctxt "text_id=4677 | speaker=unknown"
msgid "  He caught the odor of burnt hair from the back of his neck."
msgstr "　後ろ髪の焦げた臭いがする。"

#. Occurrence 5A_4:1284:4678: scene=5A_4
#: 5A_4:1284
msgctxt "text_id=4678 | speaker=unknown"
msgid "  He was very lucky."
msgstr "　きっと強運。"

#. Occurrence 5A_4:1289:4679: scene=5A_4
#: 5A_4:1289
msgctxt "text_id=4679 | speaker=unknown"
msgid "  Or perhaps very unlucky."
msgstr "　あるいは悪運だ。"

#. Occurrence 5A_4:1295:4680: scene=5A_4
#: 5A_4:1295
msgctxt "text_id=4680 | speaker=unknown"
msgid "If he were actually lucky, he would not be in this situation in the first place."
msgstr "幸運の類があるなら、そもそもこんな事態になってはいない。"

#. Occurrence 5A_4:1342:4681: scene=5A_4
#: 5A_4:1342
msgctxt "text_id=4681 | speaker=unknown"
msgid "  The second floor of the house of mirrors was structured like a giant spiral."
msgstr "　ミラーハウスの二階は巨大な渦巻き状になっているらしい。"

#. Occurrence 5A_4:1347:4682: scene=5A_4
#: 5A_4:1347
msgctxt "text_id=4682 | speaker=unknown"
msgid "  It wound left, starting from the outside wall."
msgstr "　外周からはじまって、とにかく左に左にと曲がっていく。"

#. Occurrence 5A_4:1352:4683: scene=5A_4
#: 5A_4:1352
msgctxt "text_id=4683 | speaker=unknown"
msgid "  Eventually, it would lead to a dead end. The more he tried to escape, the more cornered he would become, as though he were trapped in a twisted guillotine."
msgstr "　いきつく先はどんづまり。逃げれば逃げるほど追いつめられる、<蝸牛|かたつむり>のカラに似た断頭台だ。"

#. Occurrence 5A_4:1435:4684: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0006; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:1435
msgctxt "text_id=4684 | speaker=soujuurou"
msgid "\"Huff, huff...\""
msgstr "「…………、っ」"

#. Occurrence 5A_4:1443:4685: scene=5A_4
#: 5A_4:1443
msgctxt "text_id=4685 | speaker=unknown"
msgid "  His stifled screams threatened to leak out as complaints."
msgstr "　<抑|おさ>えつけた悲鳴が、文句になって出てきそうだ。"

#. Occurrence 5A_4:1448:4686: scene=5A_4
#: 5A_4:1448
msgctxt "text_id=4686 | speaker=unknown"
msgid "  No matter what he did, he was going to be killed. All of his struggling merely served to prolong the inevitable."
msgstr "　どのみち殺されるのに、こんなワケの分からない状況がまだ<数秒|すうびょう><数分|すうふん>、自分の頑張り次第で続くなんて―――！"

#. Occurrence 5A_4:1483:4687: scene=5A_4
#: 5A_4:1483
msgctxt "text_id=4687 | speaker=unknown"
msgid "  Yet he ran."
msgstr "　けれど走る。"

#. Occurrence 5A_4:1488:4688: scene=5A_4
#: 5A_4:1488
msgctxt "text_id=4688 | speaker=unknown"
msgid "  No matter how many mirrored walls he rammed himself into, he ran."
msgstr "　何度も鏡の壁にぶつかりながら走る。"

#. Occurrence 5A_4:1493:4689: scene=5A_4
#: 5A_4:1493
msgctxt "text_id=4689 | speaker=unknown"
msgid "  Even after crashing so hard that his forehead bled and he saw stars, he ran."
msgstr "　衝突のたび目に星が舞って、額から出血しても走る。"

#. Occurrence 5A_4:1570:4690: scene=5A_4
#: 5A_4:1570
msgctxt "text_id=4690 | speaker=unknown"
msgid "  Pain shot through him at every turn."
msgstr "　激痛は数秒ごとに。"

#. Occurrence 5A_4:1575:4691: scene=5A_4
#: 5A_4:1575
msgctxt "text_id=4691 | speaker=unknown"
msgid "  The more frantically he ran, the more intensely he smashed into the invisible walls."
msgstr "　がむしゃらに走れば走るほど手ひどく透明の壁にぶつかってしまう。"

#. Occurrence 5A_4:1580:4692: scene=5A_4
#: 5A_4:1580
msgctxt "text_id=4692 | speaker=unknown"
msgid "  His body began to understand this rule and begged him not to run anymore."
msgstr "　体はもうその法則を覚え始めていて、これ以上は走りたくないと<訴|うった>える。"

#. Occurrence 5A_4:1661:4693: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0007; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:1661
msgctxt "text_id=4693 | speaker=soujuurou"
msgid "\"Hah, hah!\""
msgstr "「はっ、は―――！」"

#. Occurrence 5A_4:1667:4694: scene=5A_4
#: 5A_4:1667
msgctxt "text_id=4694 | speaker=unknown"
msgid "  His breath was already ragged after sprinting a couple hundred feet."
msgstr "　結果、たった六十メートル程度の全力疾走で息が上がっていた。"

#. Occurrence 5A_4:1672:4695: scene=5A_4
#: 5A_4:1672
msgctxt "text_id=4695 | speaker=unknown"
msgid "  No matter how he thought about it, this was not normal. This was way too crazy."
msgstr "　そもそも<而|しか>るに、どう考えてもマトモじゃない。いくらなんでも突拍子がなさすぎる。"

#. Occurrence 5A_4:1679:4696: scene=5A_4
#: 5A_4:1679
msgctxt "text_id=4696 | speaker=unknown"
msgid "This was all just a bad joke. If he turned around now, she would apologize to him for taking it too far."
msgstr "こんなのは<性質|たち>の悪い冗談で、振り返ればやりすぎてゴメンと謝る彼女がいるに決まっている。"

#. Occurrence 5A_4:1686:4697: scene=5A_4
#: 5A_4:1686
msgctxt "text_id=4697 | speaker=unknown"
msgid "His mind had gone blank. As his body continued to slam into the mirrors again and again, his feet slowed as they began to believe that perhaps it really was all a joke. But then..."
msgstr "頭は真っ白で、体は度重なる衝突で音を上げて、そうに違いないと足を止めそうになったところに、"

#. Occurrence 5A_4:1729:4698: scene=5A_4
#: 5A_4:1729
msgctxt "text_id=4698 | speaker=unknown"
msgid "  He felt a chill."
msgstr "　ぞくりと。"

#. Occurrence 5A_4:1734:4699: scene=5A_4
#: 5A_4:1734
msgctxt "text_id=4699 | speaker=unknown"
msgid "  A touch of death upon his neck."
msgstr "　首もとに<被|かぶ>さるような、死の手触りを感じ取った。"

#. Occurrence 5A_4:1766:4700: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0008; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:1766
msgctxt "text_id=4700 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5A_4:1772:4701: scene=5A_4
#: 5A_4:1772
msgctxt "text_id=4701 | speaker=unknown"
msgid "  It would not be an exaggeration to say that Soujyuro knew this kind of terrible chill far too well."
msgstr "　大げさな話ではなく、草十郎はこの類の悪寒をイヤというほど知っていた。"

#. Occurrence 5A_4:1777:4702: scene=5A_4
#: 5A_4:1777
msgctxt "text_id=4702 | speaker=unknown"
msgid "  Ever since he had arrived in the city, he had come face-to-face with more than one or two near-death experiences."
msgstr "　なにしろ町にやってきてからこっち、死にかけた事は一度や二度ではなかったのだ。"

#. Occurrence 5A_4:1782:4703: scene=5A_4
#: 5A_4:1782
msgctxt "text_id=4703 | speaker=unknown"
msgid "  For someone who did not understand city life, his present predicament was not unlike when he experienced the traffic on the streets or the commuter rush on the station platform."
msgstr "　道を行く自動車や通勤ラッシュで混雑する駅のホームは、ルールを知らない彼からすれば、いまの状況とそう大差のないものなのだから。"

#. Occurrence 5A_4:1865:4704: scene=5A_4
#: 5A_4:1865
msgctxt "text_id=4704 | speaker=unknown"
msgid "  He was far from an innocent babe unable to comprehend life or fear."
msgstr "　彼はまだ命も恐怖も知らない、無邪気な幼子ではない。"

#. Occurrence 5A_4:1881:4705: scene=5A_4
#: 5A_4:1881
msgctxt "text_id=4705 | speaker=unknown"
msgid "  Rather, everything he had ever known became irrelevant when he was flung into a completely different cultural sphere."
msgstr "　一つの人格としてかたちどられた知性が、ある日突然、まったく違う文化圏に放りこまれただけ。"

#. Occurrence 5A_4:1886:4706: scene=5A_4
#: 5A_4:1886
msgctxt "text_id=4706 | speaker=unknown"
msgid "  Even society's promises of safety―something urbanites took for granted―were threats unknown."
msgstr "　この町にとって当然のもの―――安全が約束されている公共の機構ですら、彼にとっては“未知”の脅威だった。"

#. Occurrence 5A_4:1929:4707: scene=5A_4
#: 5A_4:1929
msgctxt "text_id=4707 | speaker=unknown"
msgid "  ...So, he was used to this already."
msgstr "　……だから、既に慣れてはいたし。"

#. Occurrence 5A_4:1934:4708: scene=5A_4
#: 5A_4:1934
msgctxt "text_id=4708 | speaker=unknown"
msgid "  Though if he were to be honest, he was dissatisfied with some things."
msgstr "　正直に告白すれば、不満に思う事だってあったのだ。"

#. Occurrence 5A_4:1974:4709: scene=5A_4
#: 5A_4:1974
msgctxt "text_id=4709 | speaker=unknown"
msgid "  Things superfluous to necessity."
msgstr "　まったく不要なもの。"

#. Occurrence 5A_4:1979:4710: scene=5A_4
#: 5A_4:1979
msgctxt "text_id=4710 | speaker=unknown"
msgid "  This world was overflowing with valueless things, and they were all dangerous in some way."
msgstr "　まったく価値を見いだせないものにあふれ、それらがすべて危険な役割を持った世界。"

#. Occurrence 5A_4:1984:4711: scene=5A_4
#: 5A_4:1984
msgctxt "text_id=4711 | speaker=unknown"
msgid "  Even the everyday necessities sold at the convenience store were, as far as he was concerned, amazing tools."
msgstr "　コンビニエンスストアにある多くの日用雑貨すら、彼にとってはたいへん優れた“道具”である。"

#. Occurrence 5A_4:2004:4712: scene=5A_4
#: 5A_4:2004
msgctxt "text_id=4712 | speaker=unknown"
msgid "  Civilization had raised the standard of living so high that it had numbed humanity's sense of danger."
msgstr "　文明はその水準を上げるほど、人間の持つ危機感を麻痺させる。"

#. Occurrence 5A_4:2009:4713: scene=5A_4
#: 5A_4:2009
msgctxt "text_id=4713 | speaker=unknown"
msgid "  The city's constant pursuit of wealth and convenience was a poison to a country boy like Soujyuro,"
msgstr "　裕福さ、便利さを進めていく街のあり方は、田舎で育った草十郎にとっては毒そのものだ。"

#. Occurrence 5A_4:2053:4714: scene=5A_4
#: 5A_4:2053
msgctxt "text_id=4714 | speaker=unknown"
msgid "  and he did not have the capacity to accept these conveniences."
msgstr "　そして不幸な事に、彼には便利さを甘受するだけの余裕がなく。"

#. Occurrence 5A_4:2058:4715: scene=5A_4
#: 5A_4:2058
msgctxt "text_id=4715 | speaker=unknown"
msgid "  That it was possible for such conveniences to easily and suddenly be misused and cause unintended accidents had always made him anxious."
msgstr "　扱い方を間違えるだけで<容易|ようい>に、唐突に、誰もが意図しなかった事故が起きる都会の便利さに、ずっと、違和感を抱いていた。"

#. Occurrence 5A_4:2063:4716: scene=5A_4
#: 5A_4:2063
msgctxt "text_id=4716 | speaker=unknown"
msgid "  Why?"
msgstr "　どうして。"

#. Occurrence 5A_4:2068:4717: scene=5A_4
#: 5A_4:2068
msgctxt "text_id=4717 | speaker=unknown"
msgid "  He had to wonder why he was even here."
msgstr "　なんで自分は、こんなところにいるのだろう、と。"

#. Occurrence 5A_4:2200:4718: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0009; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:2200
msgctxt "text_id=4718 | speaker=soujuurou"
msgid "\"...Ah.\""
msgstr "「―――、ああ」"

#. Occurrence 5A_4:2206:4719: scene=5A_4
#: 5A_4:2206
msgctxt "text_id=4719 | speaker=unknown"
msgid "  How ironic."
msgstr "　皮肉にすぎる。"

#. Occurrence 5A_4:2212:4720: scene=5A_4
#: 5A_4:2212
msgctxt "text_id=4720 | speaker=unknown"
msgid "  It took the real threat of death to finally make him realize,"
msgstr "　そんな、今まで気付かなかった本心に、"

msgctxt "text_id=4721 | speaker=unknown"
msgid "  like a divine revelation, what he'd failed to understand until now:"
msgstr "　命を狙われている状況で、<天啓|てんけい>のように思い知るなんて。"

#. Occurrence 5A_4:2234:4722: scene=5A_4
#: 5A_4:2234
msgctxt "text_id=4722 | speaker=unknown"
msgid "  He'd always had to expect the unexpected."
msgstr "　……そう。唐突なのは今に始まった事ではない。"

#. Occurrence 5A_4:2239:4723: scene=5A_4
#: 5A_4:2239
msgctxt "text_id=4723 | speaker=unknown"
msgid "  Near-death experiences were more common than one might think."
msgstr "　死にそうな目に遭うのはそこまで特別な事ではない。"

#. Occurrence 5A_4:2244:4724: scene=5A_4
#: 5A_4:2244
msgctxt "text_id=4724 | speaker=unknown"
msgid "  To begin with, safety was something that came at a price."
msgstr "　本来<安全|あんぜん>というのは対価を支払って得るものなのだし。"

#. Occurrence 5A_4:2249:4725: scene=5A_4
#: 5A_4:2249
msgctxt "text_id=4725 | speaker=unknown"
msgid "  Being alive meant that the opposite was always lurking around the corner."
msgstr "　生きているのなら常に逆の目が待っている。"

#. Occurrence 5A_4:2255:4726: scene=5A_4
#: 5A_4:2255
msgctxt "text_id=4726 | speaker=unknown"
msgid "  It was just like a street light at night."
msgstr "　例えば、夜の街灯のように。"

#. Occurrence 5A_4:2260:4727: scene=5A_4
#: 5A_4:2260
msgctxt "text_id=4727 | speaker=unknown"
msgid "  When the sun rose, its illumination would naturally disappear."
msgstr "　朝になれば当然、その明かりは消えるのだ。"

#. Occurrence 5A_4:2347:4728: scene=5A_4
#: 5A_4:2347
msgctxt "text_id=4728 | speaker=unknown"
msgid "  Another barrage of strange projectiles whizzed mercilessly by him."
msgstr "　容赦なく撃ちだされる正体不明の凶器。"

#. Occurrence 5A_4:2352:4729: scene=5A_4
#: 5A_4:2352
msgctxt "text_id=4729 | speaker=unknown"
msgid "  He recalled in the back of his mind the charred remains of someone at the hands of that blue flame two nights prior."
msgstr "　二日前の夜、青い炎に包まれて消し<炭|ずみ>になった人影が脳裏に蘇る。"

#. Occurrence 5A_4:2385:4730: scene=5A_4
#: 5A_4:2385
msgctxt "text_id=4730 | speaker=unknown"
msgid "  Somehow this situation reminded him of a horse being led by a dangling carrot."
msgstr "　釣られた<人参|にんじん>欲しさに走る馬みたいだ、と彼は思った。"

#. Occurrence 5A_4:2394:4731: scene=5A_4
#: 5A_4:2394
msgctxt "text_id=4731 | speaker=unknown"
msgid "  For now he lifted his head and continued to run through the labyrinth."
msgstr "　とにかくアゴをあげて迷路を走る。"

#. Occurrence 5A_4:2412:4732: scene=5A_4
#: 5A_4:2412
msgctxt "text_id=4732 | speaker=unknown"
msgid "  But for what purpose?"
msgstr "　でも、いったい何のために？"

#. Occurrence 5A_4:2460:4733: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0010; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:2460
msgctxt "text_id=4733 | speaker=soujuurou"
msgid "\"Hah... hah...\""
msgstr "「はっ―――、はっ―――」"

#. Occurrence 5A_4:2466:4734: scene=5A_4
#: 5A_4:2466
msgctxt "text_id=4734 | speaker=unknown"
msgid "  Though he knew the pain in his chest was very real, he felt disconnected from it."
msgstr "　心臓の苦しさは本物なのに、まるで現実感がない。"

#. Occurrence 5A_4:2472:4735: scene=5A_4
#: 5A_4:2472
msgctxt "text_id=4735 | speaker=unknown"
msgid "  The night sky visible through the skylight was a muddy ultramarine, no longer resembling the one he knew."
msgstr "　天窓から見える夜空は泥を流したような<群青|ぐんじょう>で、<草十郎|カレ>の知っている夜空には似ても似つかない。"

#. Occurrence 5A_4:2520:4736: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0011; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:2520
msgctxt "text_id=4736 | speaker=soujuurou"
msgid "\"...Hah.\""
msgstr "「―――、は」"

#. Occurrence 5A_4:2525:4737: scene=5A_4
#: 5A_4:2525
msgctxt "text_id=4737 | speaker=unknown"
msgid "  And managed to calm himself."
msgstr "　唐突に気が<緩|ゆる>む。"

#. Occurrence 5A_4:2530:4738: scene=5A_4
#: 5A_4:2530
msgctxt "text_id=4738 | speaker=unknown"
msgid "  Soujyuro began to laugh in despair, as though something rather precious had been broken."
msgstr "　<捨|す>て<鉢|ばち>気味に草十郎は笑って、わりと大切なものが折れた気がした。"

#. Occurrence 5A_4:2550:4739: scene=5A_4
#: 5A_4:2550
msgctxt "text_id=4739 | speaker=unknown"
msgid "  Everything had become meaningless anyway."
msgstr "　だって、そもそも全てがどうでもいい。"

#. Occurrence 5A_4:2617:4740: scene=5A_4
#: 5A_4:2617
msgctxt "text_id=4740 | speaker=unknown"
msgid "  Even so, his legs somehow made their way forward at the sight of her reflection in the mirror."
msgstr "　それでもなんとか足が進んだのは、合わせ鏡に彼女の姿が映るからだ。"

#. Occurrence 5A_4:2735:4741: scene=5A_4
#: 5A_4:2735
msgctxt "text_id=4741 | speaker=unknown"
msgid "  Like a game of cat and mouse, Soujyuro fled through the labyrinth of mirrors."
msgstr "　追いかけっこをするネコとネズミのように、草十郎は鏡の迷路を<遁走|とんそう>する。"

#. Occurrence 5A_4:2740:4742: scene=5A_4
#: 5A_4:2740
msgctxt "text_id=4742 | speaker=unknown"
msgid "  Then, after four minutes, that strangely unreal tension ended."
msgstr "　その、妙に現実感のない緊迫は、実質四分ほどで終了した。"

#. Occurrence 5A_4:2917:4743: scene=5A_4
#: 5A_4:2917
msgctxt "text_id=4743 | speaker=unknown"
msgid "  The ninth shot of blue light hit inches away from him."
msgstr "　九回目の青い光が、草十郎の真横で発火する。"

#. Occurrence 5A_4:2922:4744: scene=5A_4
#: 5A_4:2922
msgctxt "text_id=4744 | speaker=unknown"
msgid "  It exploded the moment it made impact, launching Soujyuro into the opposite wall."
msgstr "　光は壁に被弾するなり爆発して、その衝撃で草十郎を反対側の壁に叩きつける。"

#. Occurrence 5A_4:2928:4745: scene=5A_4
#: 5A_4:2928
msgctxt "text_id=4745 | speaker=unknown"
msgid "  Of all the fire he had taken thus far, this shot indisputably brought him the closest to death."
msgstr "　文句なく、今までで一番「死」に近い一撃だった。"

#. Occurrence 5A_4:3030:4746: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0012; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:3030
msgctxt "text_id=4746 | speaker=soujuurou"
msgid "\"GAAAH!\""
msgstr "「痛っ……！」"

#. Occurrence 5A_4:3036:4747: scene=5A_4
#: 5A_4:3036
msgctxt "text_id=4747 | speaker=unknown"
msgid "  Groaning, he collapsed to the floor."
msgstr "　呻いて、床に倒れこむ。"

#. Occurrence 5A_4:3041:4748: scene=5A_4
#: 5A_4:3041
msgctxt "text_id=4748 | speaker=unknown"
msgid "  His back was on fire with pain."
msgstr "　背中はひりひりと痛んでいる。"

#. Occurrence 5A_4:3046:4749: scene=5A_4
#: 5A_4:3046
msgctxt "text_id=4749 | speaker=unknown"
msgid "  He was not bleeding, and was lucky he could still even scream."
msgstr "　出血はない。『痛い』程度で済んだのは幸運だろう。"

#. Occurrence 5A_4:3082:4750: scene=5A_4
#: 5A_4:3082
msgctxt "text_id=4750 | speaker=unknown"
msgid "  Yet, his body refused to move."
msgstr "　けれど、体は<頑|がん>として動かなかった。"

#. Occurrence 5A_4:3087:4751: scene=5A_4
#: 5A_4:3087
msgctxt "text_id=4751 | speaker=unknown"
msgid "  Physically and mentally he still had something to spare."
msgstr "　肉体的にも精神的にもまだ余裕はある。"

#. Occurrence 5A_4:3092:4752: scene=5A_4
#: 5A_4:3092
msgctxt "text_id=4752 | speaker=unknown"
msgid "  The pain was not so bad that he couldn't get back up."
msgstr "　起き上がれない程の痛みでもない。"

#. Occurrence 5A_4:3121:4753: scene=5A_4
#: 5A_4:3121
msgctxt "text_id=4753 | speaker=unknown"
msgid "  It was just that there was a skylight above him, and he could glimpse the dark of the night sky beyond."
msgstr "　ただ、倒れてふと見上げた天井には窓があって、暗い夜空が見えてしまった。"

#. Occurrence 5A_4:3126:4754: scene=5A_4
#: 5A_4:3126
msgctxt "text_id=4754 | speaker=unknown"
msgid "  The feeling that overcame him was a raw, selfish bout of grief."
msgstr "　胸に去来した<感|も><情|の>は未熟な、身勝手な嘆きだった。"

#. Occurrence 5A_4:3133:4755: scene=5A_4
#: 5A_4:3133
msgctxt "text_id=4755 | speaker=unknown"
msgid "  Oh, it was just so cruel―"
msgstr "　……ああ、なんて醜い。"

#. Occurrence 5A_4:3138:4756: scene=5A_4
#: 5A_4:3138
msgctxt "text_id=4756 | speaker=unknown"
msgid "  to have to stare at that for the remainder of whatever short life he had left."
msgstr "　こんなものを、これから一生、見続けていく。"

#. Occurrence 5A_4:3189:4757: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0013; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:3189
msgctxt "text_id=4757 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5A_4:3195:4758: scene=5A_4
#: 5A_4:3195
msgctxt "text_id=4758 | speaker=unknown"
msgid "  Soujyuro's ragged breath slowed."
msgstr "　乱れていた呼吸が、熱を失ったように治まった。"

#. Occurrence 5A_4:3200:4759: scene=5A_4
#: 5A_4:3200
msgctxt "text_id=4759 | speaker=unknown"
msgid "  For all intents and purposes, he had given up."
msgstr "　簡単に言うなら、彼はそれで諦めてしまったのだ。"

#. Occurrence 5A_4:3205:4760: scene=5A_4
#: 5A_4:3205
msgctxt "text_id=4760 | speaker=unknown"
msgid "  He had given up fleeing from the pursuing footsteps, and perhaps, even the root of all his problems."
msgstr "　追いかけてくる足音から逃げるという行為と、たぶん、もっと大きな、根本にある問題から。"

#. Occurrence 5A_4:3238:4761: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0014; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:3238
msgctxt "text_id=4761 | speaker=soujuurou"
msgid "(Well, at least it was Aozaki who got to kill me.)"
msgstr "“まあ……蒼崎に殺されるなら、いいかな”"

#. Occurrence 5A_4:3245:4762: scene=5A_4
#: 5A_4:3245
msgctxt "text_id=4762 | speaker=unknown"
msgid "  Soujyuro Sizuki felt things that, in any other circumstance, he would never feel."
msgstr "　静希草十郎という人間にとって、決してあってはならない感想が漏れる。"

#. Occurrence 5A_4:3250:4763: scene=5A_4
#: 5A_4:3250
msgctxt "text_id=4763 | speaker=unknown"
msgid "  Incidentally..."
msgstr "　……余談ではあるが。"

#. Occurrence 5A_4:3256:4764: scene=5A_4
#: 5A_4:3256
msgctxt "text_id=4764 | speaker=unknown"
msgid "Without exaggeration or embellishment, this was the only mistake he had ever made in his entire life."
msgstr "大げさな話ではなく、それは彼にとって、生涯ただ一度の過ちだった。"

#. Occurrence 5A_4:3276:4765: scene=5A_4
#: 5A_4:3276
msgctxt "text_id=4765 | speaker=unknown"
msgid "  Staring vacantly into the night sky above, Soujyuro listened as the footsteps drew nearer."
msgstr "　ぼんやりと夜空を見上げながら、草十郎は近づいてくる足音を聞く。"

#. Occurrence 5A_4:3324:4766: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0002; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3324
msgctxt "text_id=4766 | speaker=aoko"
msgid "\"You give up?\""
msgstr "「ギブアップ？」"

#. Occurrence 5A_4:3330:4767: scene=5A_4
#: 5A_4:3330
msgctxt "text_id=4767 | speaker=unknown"
msgid "  It was the closest her voice had ever been to him."
msgstr "　今までで一番近い声。"

#. Occurrence 5A_4:3335:4768: scene=5A_4
#: 5A_4:3335
msgctxt "text_id=4768 | speaker=unknown"
msgid "  Perhaps feeling that he really had given up, she approached his collapsed form."
msgstr "　これで幕引きと踏んだのか、彼女は倒れこんだ草十郎の目前まで歩み寄った。"

#. Occurrence 5A_4:3355:4769: scene=5A_4
#: 5A_4:3355
msgctxt "text_id=4769 | speaker=unknown"
msgid "  In the dark, mirror-lined corridor, he could not make out her expression."
msgstr "　暗い鏡張りの通路では、その表情はうかがい知れない。"

#. Occurrence 5A_4:3360:4770: scene=5A_4
#: 5A_4:3360
msgctxt "text_id=4770 | speaker=unknown"
msgid "  Without a word, Soujyuro raised his eyes to meet his murderer."
msgstr "　草十郎は何を言うのでもなく、目前の殺人者を見上げている。"

#. Occurrence 5A_4:3460:4771: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0003; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3460
msgctxt "text_id=4771 | speaker=aoko"
msgid "\"...I suppose if you don't care, you don't have to ask."
msgstr "「……返事がないならそれでいいけど。"

#. Occurrence 5A_4:3466:4772: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0004; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3466
msgctxt "text_id=4772 | speaker=aoko"
msgid "  You really do throw me off. Most people would ask me why I'm going to kill them right about now.\""
msgstr "　調子狂うわ。普通、どうして殺そうとするのかぐらい、訊くものじゃない？」"

#. Occurrence 5A_4:3472:4773: scene=5A_4
#: 5A_4:3472
msgctxt "text_id=4773 | speaker=unknown"
msgid "  Aoko spoke from within the shadows."
msgstr "　顔を陰に隠したまま青子は言う。"

#. Occurrence 5A_4:3547:4774: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0015; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:3547
msgctxt "text_id=4774 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5A_4:3553:4775: scene=5A_4
#: 5A_4:3553
msgctxt "text_id=4775 | speaker=unknown"
msgid "  His eyes widened in bewilderment."
msgstr "　きょとんと目を大きくする草十郎。"

#. Occurrence 5A_4:3558:4776: scene=5A_4
#: 5A_4:3558
msgctxt "text_id=4776 | speaker=unknown"
msgid "  Now that she had mentioned it, he realized that would have been the obvious question to ask."
msgstr "　言われて、それが自然な疑問なのだと気が付いた。"

#. Occurrence 5A_4:3563:4777: scene=5A_4
#: 5A_4:3563
msgctxt "text_id=4777 | speaker=unknown"
msgid "  He had more or less picked up on the fact that he was being killed for learning some secret, but it was human nature to want to know more."
msgstr "　なんとなく雰囲気で“秘密を知ったから殺す”と読み取れたが、どうして自分がこんな目にあうのか、理由を聞きたくなるのが人情である。"

#. Occurrence 5A_4:3596:4778: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0016; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:3596
msgctxt "text_id=4778 | speaker=soujuurou"
msgid "\"...That makes sense, now that you mention it.\""
msgstr "「……そっか。それは、そうなるな」"

#. Occurrence 5A_4:3601:4779: scene=5A_4
#: 5A_4:3601
msgctxt "text_id=4779 | speaker=unknown"
msgid "  A simple affirmation."
msgstr "　ああ、という肯定。"

#. Occurrence 5A_4:3606:4780: scene=5A_4
#: 5A_4:3606
msgctxt "text_id=4780 | speaker=unknown"
msgid "  His face was a mixture of resignation and a forlorn longing."
msgstr "　どこか寂しい願いと、諦めのまざった顔。"

#. Occurrence 5A_4:3611:4781: scene=5A_4
#: 5A_4:3611
msgctxt "text_id=4781 | speaker=unknown"
msgid "  He thought for a moment, before..."
msgstr "　彼はしばし考えたあと、"

#. Occurrence 5A_4:3645:4782: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0017; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:3645
msgctxt "text_id=4782 | speaker=soujuurou"
msgid "\"But you don't have to say anything."
msgstr "「でも言う必要はない。"

#. Occurrence 5A_4:3652:4783: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0018; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:3652
msgctxt "text_id=4783 | speaker=soujuurou"
msgid "I don't want to hear it.\""
msgstr "聞きたくないんだ、そういうのは」"

#. Occurrence 5A_4:3658:4784: scene=5A_4
#: 5A_4:3658
msgctxt "text_id=4784 | speaker=unknown"
msgid "  He responded in a mature, subdued voice."
msgstr "　大人びた、静かな声でそう答えた。"

#. Occurrence 5A_4:3761:4785: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0005; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3761
msgctxt "text_id=4785 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5A_4:3767:4786: scene=5A_4
#: 5A_4:3767
msgctxt "text_id=4786 | speaker=unknown"
msgid "  His response was clear―rather, gallantly so."
msgstr "　鮮やかといえば、鮮やかすぎたその回答。"

#. Occurrence 5A_4:3798:4787: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0006; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3798
msgctxt "text_id=4787 | speaker=aoko"
msgid "\"...I see."
msgstr "「―――そ。"

#. Occurrence 5A_4:3804:4788: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0007; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3804
msgctxt "text_id=4788 | speaker=aoko"
msgid "  I'm still going to kill you. Aren't you scared of dying?\""
msgstr "　じゃ、殺すけど。死ぬの、恐くないの？」"

#. Occurrence 5A_4:3810:4789: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0019; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:3810
msgctxt "text_id=4789 | speaker=soujuurou"
msgid "\"Of course I'm scared. It'll probably hurt.\""
msgstr "「恐いに決まってる。なにより痛そうだ」"

#. Occurrence 5A_4:3840:4790: scene=5A_4
#: 5A_4:3840
msgctxt "text_id=4790 | speaker=unknown"
msgid "  His face turned wry as he objected, to which Aoko frowned."
msgstr "　口をとがらせて抗議する草十郎に、青子はむっ、と顔をくもらせる。"

#. Occurrence 5A_4:3846:4791: scene=5A_4
#: 5A_4:3846
msgctxt "text_id=4791 | speaker=unknown"
msgid "As nonchalant as he could be, he was honest about his feelings."
msgstr "投げやりになっていても、自分の気持ちに素直な少年だった。"

#. Occurrence 5A_4:3901:4792: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0008; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3901
msgctxt "text_id=4792 | speaker=aoko"
msgid "\"Of course that would be scary. I'd be scared, too, you know."
msgstr "「そりゃ恐いでしょう。私だって恐いと思うし。"

#. Occurrence 5A_4:3907:4793: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0009; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3907
msgctxt "text_id=4793 | speaker=aoko"
msgid "  Sorry, though. You'll just need to deal with it."
msgstr "　でも悪いわね、我慢して。"

#. Occurrence 5A_4:3913:4794: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0010; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3913
msgctxt "text_id=4794 | speaker=aoko"
msgid "  It's okay if you call me a monster. That's exactly what I am right now."
msgstr "　人でなしと<罵|ののし>ってくれて結構よ。今の私は本当にその通りだから。"

#. Occurrence 5A_4:3930:4795: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0011; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3930
msgctxt "text_id=4795 | speaker=aoko"
msgid "..."
msgstr "……"

msgctxt "text_id=4796 | speaker=unknown"
msgid " I guess in that way I'm just like you. I don't have what you would call normal morals. Helps when I need to murder someone.\""
msgstr "そういった意味じゃアンタと同じ。普通の道徳がないのよ。だから、必要なら人も殺せる」"

#. Occurrence 5A_4:3961:4797: scene=5A_4
#: 5A_4:3961
msgctxt "text_id=4797 | speaker=unknown"
msgid "  Soujyuro's finger twitched in response to her indifferent tone."
msgstr "　淡々とした声に、ぴくりと草十郎の指が反応した。"

#. Occurrence 5A_4:3966:4798: scene=5A_4
#: 5A_4:3966
msgctxt "text_id=4798 | speaker=unknown"
msgid "  As if to say that, despite having given up on just about everything, his body could not let those words slide."
msgstr "　何もかも諦めていた彼の体が、今の言葉は聞き流せないと言うように。"

#. Occurrence 5A_4:4022:4799: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0020; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:4022
msgctxt "text_id=4799 | speaker=soujuurou"
msgid "\"Murder is wrong, you know.\""
msgstr "「人殺しなんて、よくないぞ」"

#. Occurrence 5A_4:4028:4800: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0012; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:4028
msgctxt "text_id=4800 | speaker=aoko"
msgid "\"We went through this. I know that already.\""
msgstr "「分かってるって言ってるでしょ」"

#. Occurrence 5A_4:4039:4801: scene=5A_4
#: 5A_4:4039
msgctxt "text_id=4801 | speaker=unknown"
msgid "  Aoko raised her right hand."
msgstr "　青子の右腕が掲げられる。"

#. Occurrence 5A_4:4044:4802: scene=5A_4
#: 5A_4:4044
msgctxt "text_id=4802 | speaker=unknown"
msgid "  The light from the crest illuminated her face."
msgstr "　刻印の光が顔を照らす。"

#. Occurrence 5A_4:4131:4803: scene=5A_4
#: 5A_4:4131
msgctxt "text_id=4803 | speaker=unknown"
msgid "  It goes without saying that her expression was unchanged."
msgstr "　言うまでもなく、彼女の顔はいつも通りだ。"

#. Occurrence 5A_4:4136:4804: scene=5A_4
#: 5A_4:4136
msgctxt "text_id=4804 | speaker=unknown"
msgid "  She was not crying, nor was she smiling."
msgstr "　泣き顔でもなく笑顔でもない。"

#. Occurrence 5A_4:4141:4805: scene=5A_4
#: 5A_4:4141
msgctxt "text_id=4805 | speaker=unknown"
msgid "  She was a young woman who had excised her feelings."
msgstr "　感情を<排|はい>した、どこにでもいる一人の少女。"

#. Occurrence 5A_4:4146:4806: scene=5A_4
#: 5A_4:4146
msgctxt "text_id=4806 | speaker=unknown"
msgid "  ...\"Deal with it\" was another thing Soujyuro could not let slide."
msgstr "　……我慢して、なんてとんでもない。"

#. Occurrence 5A_4:4151:4807: scene=5A_4
#: 5A_4:4151
msgctxt "text_id=4807 | speaker=unknown"
msgid "  Soujyuro could read on Aoko's face that she was not herself. She was in pain, and to a degree he had never seen in her."
msgstr "　普段の青子を知る草十郎にとって、それは、どんな<表|か><情|お>より<辛|つら>く映った。"

#. Occurrence 5A_4:4276:4808: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0021; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:4276
msgctxt "text_id=4808 | speaker=soujuurou"
msgid "\"...Sorry, but I guess I do have something to say.\""
msgstr "「……すまない。ちょっと、いいかな」"

#. Occurrence 5A_4:4282:4809: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0013; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:4282
msgctxt "text_id=4809 | speaker=aoko"
msgid "\"What is it? But don't think you can trick me into letting you go by making me feel bad.\""
msgstr "「なに？　ここまで<悲愴感|ひそうかん>を盛り上げておいて、やっぱり逃げるなんてのは却下よ」"

#. Occurrence 5A_4:4307:4810: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0022; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:4307
msgctxt "text_id=4810 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5A_4:4313:4811: scene=5A_4
#: 5A_4:4313
msgctxt "text_id=4811 | speaker=unknown"
msgid "  He unconsciously smiled at Aoko's ruthless counter and breathed a sigh of relief."
msgstr "　容赦のない青子の切り返しに、彼はつい頬を<緩|ゆる>ませた。"

#. Occurrence 5A_4:4318:4812: scene=5A_4
#: 5A_4:4318
msgctxt "text_id=4812 | speaker=unknown"
msgid "  He had misread the pain he saw in her face. This was the same Aoko."
msgstr "　ほっと息をつくように。さきほど見えた辛さは勘違いで、青子はやっぱり青子だった。"

#. Occurrence 5A_4:4323:4813: scene=5A_4
#: 5A_4:4323
msgctxt "text_id=4813 | speaker=unknown"
msgid "  Soujyuro laughed out loud in genuine joy, a laugh that most other people would have taken as an insult."
msgstr "　それが嬉しくて草十郎は笑ったのだが、言うまでもなく、彼以外には真逆に見える笑いだった。"

#. Occurrence 5A_4:4401:4814: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0014; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:4401
msgctxt "text_id=4814 | speaker=aoko"
msgid "\"I'm starting to regret letting you say your piece."
msgstr "「……<遺言|ゆいごん>でも聞いてあげようと思った私が甘かった。"

#. Occurrence 5A_4:4407:4815: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0015; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:4407
msgctxt "text_id=4815 | speaker=aoko"
msgid "  Or should I take that attempt to make fun of me as just that?\""
msgstr "　っていうか、今の小馬鹿にした笑いがアンタの遺言ってコトでオッケー？」"

#. Occurrence 5A_4:4458:4816: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0023; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:4458
msgctxt "text_id=4816 | speaker=soujuurou"
msgid "\"No, I'm not laughing at you. I was just wondering if that person over there was a friend of yours, Aozaki.\""
msgstr "「いや、そうじゃなくて。あそこにいる人は、蒼崎の友人なのか？」"

#. Occurrence 5A_4:4464:4817: scene=5A_4
#: 5A_4:4464
msgctxt "text_id=4817 | speaker=unknown"
msgid "  Out of nowhere, Soujyuro pointed behind Aoko."
msgstr "　つい、と指で青子の背後を指す草十郎。"

#. Occurrence 5A_4:4523:4818: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0016; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:4523
msgctxt "text_id=4818 | speaker=aoko"
msgid "\"What?\""
msgstr "「はあ？」"

#. Occurrence 5A_4:4529:4819: scene=5A_4
#: 5A_4:4529
msgctxt "text_id=4819 | speaker=unknown"
msgid "  Aoko thought that it must have been that old, overused distraction technique."
msgstr "　使い古された手だと青子は思った。"

#. Occurrence 5A_4:4535:4820: scene=5A_4
#: 5A_4:4535
msgctxt "text_id=4820 | speaker=unknown"
msgid "If this had been a Japanese comedy act, this would be the part where she gave him a whack with a paper fan."
msgstr "ここがステージならハリセンでダメ出しも辞さないところだ。"

#. Occurrence 5A_4:4535:4821: scene=5A_4
#: 5A_4:4535
msgctxt "text_id=4821 | speaker=unknown"
msgid "  But after giving it a second thought, she realized Soujyuro didn't have the capacity for understanding old, or even new, tricks."
msgstr "　……しかし草十郎にそんな雰囲気はないし、そもそもこの男には<流行|はやり>も古いもなかった、と思い直す。"

#. Occurrence 5A_4:4652:4822: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0017; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:4652
msgctxt "text_id=4822 | speaker=aoko"
msgid "\"What are you...\""
msgstr "「アンタ、なに言って―――」"

#. Occurrence 5A_4:4658:4823: scene=5A_4
#: 5A_4:4658
msgctxt "text_id=4823 | speaker=unknown"
msgid "  Perhaps his honest disposition had been to his benefit."
msgstr "　なんだかんだと律儀な性格が幸いしたのか。"

#. Occurrence 5A_4:4663:4824: scene=5A_4
#: 5A_4:4663
msgctxt "text_id=4824 | speaker=unknown"
msgid "  Without thinking, Aoko gave in to her curiosity and turned her gaze toward the direction in which his finger was pointed."
msgstr "　つい気になって、指差された背後に目を向ける青子。"

#. Occurrence 5A_4:4668:4825: scene=5A_4
#: 5A_4:4668
msgctxt "text_id=4825 | speaker=unknown"
msgid "  And there..."
msgstr "　―――そこには、"

#. Occurrence 5A_4:4758:4826: scene=5A_4
#: 5A_4:4758
msgctxt "text_id=4826 | speaker=unknown"
msgid "  Something that should not have been there in the maze. Something with a creaking, wooden smile..."
msgstr "　ぎい、と。"

#. Occurrence 5A_4:4766:4827: scene=5A_4
#: 5A_4:4766
msgctxt "text_id=4827 | speaker=unknown"
msgid "  It was the ominous, creepy, uncanny figure of a girl."
msgstr "　この迷路には無い木製の<笑顔|きしみ>をあげる、不吉で不気味な“彼女”の姿が―――"

#. Occurrence 5A_5:116:4828: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0000; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:116
msgctxt "text_id=4828 | speaker=aoko"
msgid "\"A... puppet?\""
msgstr "「―――人、形……？」"

#. Occurrence 5A_5:122:4829: scene=5A_5
#: 5A_5:122
msgctxt "text_id=4829 | speaker=unknown"
msgid "  An unusual figure with two arms and two legs stood silently in the darkness."
msgstr "　暗がりに<仄|ほの>浮かぶ<二|ヒ><足|ト><二|ガ><手|タ>の異形。"

#. Occurrence 5A_5:127:4830: scene=5A_5
#: 5A_5:127
msgctxt "text_id=4830 | speaker=unknown"
msgid "  If only for a moment, its beauty―which was even apparent from afar―dulled the insanity of the current situation."
msgstr "　その、物言わぬ<佇|たたず>まいと、遠目からでも分かる造りの美しさが、事の異常性を一瞬だけ漂白し―――"

#. Occurrence 5A_5:293:4831: scene=5A_5
#: 5A_5:293
msgctxt "text_id=4831 | speaker=unknown"
msgid "  Extend. Extend. Extend."
msgstr "　伸びる。伸びる。伸びる。"

#. Occurrence 5A_5:298:4832: scene=5A_5
#: 5A_5:298
msgctxt "text_id=4832 | speaker=unknown"
msgid "  The utterly unknown threat made Aoko freeze on the spot."
msgstr "　その、あまりの“未知”に青子の思考は停止した。"

#. Occurrence 5A_5:303:4833: scene=5A_5
#: 5A_5:303
msgctxt "text_id=4833 | speaker=unknown"
msgid "  Avoiding it didn't even occur to her. Humans possess intelligence and knowledge, but when confronted with the unknown, they fail to process what to do, and―"
msgstr "　避ける、という選択が浮かばない。人間は知性、知識がある故に、“初めて見る”ものに<鈍感|どんかん>で―――"

#. Occurrence 5A_5:393:4834: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0001; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:393
msgctxt "text_id=4834 | speaker=aoko"
msgid "\"AaaAAAhhhHHH!!!\""
msgstr "「っ、ぁあぁあ――――――！！！！」"

#. Occurrence 5A_5:399:4835: scene=5A_5
#: 5A_5:399
msgctxt "text_id=4835 | speaker=unknown"
msgid "  A shriek escaped Aoko's mouth."
msgstr "　青子の口から悲鳴がこぼれる。"

#. Occurrence 5A_5:404:4836: scene=5A_5
#: 5A_5:404
msgctxt "text_id=4836 | speaker=unknown"
msgid "  The magical attack crossed the thirty-foot gap in an instant."
msgstr "　十メートル以上の距離を無視した魔の一撃。"

#. Occurrence 5A_5:409:4837: scene=5A_5
#: 5A_5:409
msgctxt "text_id=4837 | speaker=unknown"
msgid "  The arm of the \"girl\" who had appeared at the rear of the corridor was slender and quick. It extended to a near-impossible length, striking Aoko from behind."
msgstr "　奥の通路に現れた“彼女”の腕は細く速く、どこまでも長く伸び、青子の背中を<撃|う>ち<捉|とら>えた。"

#. Occurrence 5A_5:488:4838: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0002; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:488
msgctxt "text_id=4838 | speaker=aoko"
msgid "\"Gnnngh!\""
msgstr "「っ―――！」"

#. Occurrence 5A_5:495:4839: scene=5A_5
#: 5A_5:495
msgctxt "text_id=4839 | speaker=unknown"
msgid "  Aoko crashed into the wall as she fought back an anguished whimper."
msgstr "　青子は壁に激突しつつも、苦悶の声を飲みくだす。"

#. Occurrence 5A_5:500:4840: scene=5A_5
#: 5A_5:500
msgctxt "text_id=4840 | speaker=unknown"
msgid "  The attacker retracted her arm."
msgstr "　一方、伸びきった腕は速やかに“彼女”へと戻っていく。"

#. Occurrence 5A_5:606:4841: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_5_0000; voice_prefix=A30; voice_category=3; scene=5A_5
#: 5A_5:606
msgctxt "text_id=4841 | speaker=soujuurou"
msgid "\"Aozaki!\""
msgstr "「蒼崎！」"

#. Occurrence 5A_5:652:4842: scene=5A_5
#: 5A_5:652
msgctxt "text_id=4842 | speaker=unknown"
msgid "  Soujyuro sprang to his feet."
msgstr "　草十郎はすぐさま立ち上がっていた。"

#. Occurrence 5A_5:657:4843: scene=5A_5
#: 5A_5:657
msgctxt "text_id=4843 | speaker=unknown"
msgid "  He darted to her side and used all the strength he could muster to get her to her feet."
msgstr "　手足をついて咳きこむ青子に駆け寄ると、力任せに立ち上がらせ―――"

#. Occurrence 5A_5:710:4844: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_5_0001; voice_prefix=A30; voice_category=3; scene=5A_5
#: 5A_5:710
msgctxt "text_id=4844 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5A_5:716:4845: scene=5A_5
#: 5A_5:716
msgctxt "text_id=4845 | speaker=unknown"
msgid "  He could not believe how light she was."
msgstr "　その軽さに、少し戸惑う。"

#. Occurrence 5A_5:721:4846: scene=5A_5
#: 5A_5:721
msgctxt "text_id=4846 | speaker=unknown"
msgid "  In Soujyuro's mind, Aoko was an extraordinary individual."
msgstr "　草十郎にとって、蒼崎青子は普段から凛としていて、中身がぎゅっと詰まっているイメージだった。"

#. Occurrence 5A_5:726:4847: scene=5A_5
#: 5A_5:726
msgctxt "text_id=4847 | speaker=unknown"
msgid "  He'd expected that if he were to ever touch her, it would be apparent she was far stronger than he."
msgstr "　だからきっと、<触|ふ>れた時は自分なんかより確かな力強さがあると思ったのだ。"

#. Occurrence 5A_5:732:4848: scene=5A_5
#: 5A_5:732
msgctxt "text_id=4848 | speaker=unknown"
msgid "But in reality, she felt about as heavy as you would expect a hundred-pound girl to feel."
msgstr "けれど実際は四十五キロ程度の、少女として当たり前の重さだった。"

#. Occurrence 5A_5:829:4849: scene=5A_5
#: 5A_5:829
msgctxt "text_id=4849 | speaker=unknown"
msgid "  Meanwhile,"
msgstr "　……一方。"

#. Occurrence 5A_5:834:4850: scene=5A_5
#: 5A_5:834
msgctxt "text_id=4850 | speaker=unknown"
msgid "  that thing continued to reel in its arm, as if it were some sort of mechanism."
msgstr "　どのような<機巧|カラクリ>か、“彼女”は伸びきった腕を収納していく。"

#. Occurrence 5A_5:839:4851: scene=5A_5
#: 5A_5:839
msgctxt "text_id=4851 | speaker=unknown"
msgid "  Having extended more than thirty feet from the elbow joint, it clanked as it returned to its previous shape and size."
msgstr "　十メートル以上伸びた腕、何倍にも増設された<肘|ひじ>関節が、カシャンカシャンと元の<形状|おおきさ>に戻っていく。"

#. Occurrence 5A_5:934:4852: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_5_0002; voice_prefix=A30; voice_category=3; scene=5A_5
#: 5A_5:934
msgctxt "text_id=4852 | speaker=soujuurou"
msgid "\"Are you okay?\""
msgstr "「大丈夫か？」"

#. Occurrence 5A_5:1030:4853: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0003; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:1030
msgctxt "text_id=4853 | speaker=aoko"
msgid "\"...Are you for real? How can you even look at me like that right now?\""
msgstr "「……やめてよ。分からないわ、なんでそんな顔できるの」"

#. Occurrence 5A_5:1085:4854: scene=5A_5
#: 5A_5:1085
msgctxt "text_id=4854 | speaker=unknown"
msgid "  Aoko tore her hand away from Soujyuro's."
msgstr "　呟きながら草十郎の手から離れる青子。"

#. Occurrence 5A_5:1090:4855: scene=5A_5
#: 5A_5:1090
msgctxt "text_id=4855 | speaker=unknown"
msgid "  Suddenly, she felt her knees buckle from under her, but Soujyuro caught her before she could hit the ground and helped her to her feet."
msgstr "　途端、がくんと膝から倒れこんだが、彼女が膝をつくより早く、草十郎は肩を貸して立ちあがらせていた。"

#. Occurrence 5A_5:1111:4856: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_5_0003; voice_prefix=A30; voice_category=3; scene=5A_5
#: 5A_5:1111
msgctxt "text_id=4856 | speaker=soujuurou"
msgid "\"Don't push yourself too hard. ...So, do you know this thing?\""
msgstr "「無理するな。……で、あいつは知り合いか？」"

#. Occurrence 5A_5:1174:4857: scene=5A_5
#: 5A_5:1174
msgctxt "text_id=4857 | speaker=unknown"
msgid "  He looked back at the eerie shadow thirty feet away as it finished retracting its arm."
msgstr "　草十郎は十メートル向こう、不気味に<佇|たたず>む人影を見据えている。伸びきった腕は、あと少しで完全に収納されようとしていた。"

#. Occurrence 5A_5:1181:4858: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0004; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:1181
msgctxt "text_id=4858 | speaker=aoko"
msgid "\"...Yeah. I fought one of its friends a while back.\""
msgstr "「……そうね。似たような奴とは命を<鬩|せめ>ぎ合った仲よ」"

#. Occurrence 5A_5:1201:4859: scene=5A_5
#: 5A_5:1201
msgctxt "text_id=4859 | speaker=unknown"
msgid "  Aoko grabbed her lower back as she answered."
msgstr "　青子は答えながら、自身の背中に指をはわせた。"

#. Occurrence 5A_5:1262:4860: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0005; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:1262
msgctxt "text_id=4860 | speaker=aoko"
msgid "\"Aaah!\""
msgstr "「っ……！」"

#. Occurrence 5A_5:1267:4861: scene=5A_5
#: 5A_5:1267
msgctxt "text_id=4861 | speaker=unknown"
msgid "  A searing pain shot through her."
msgstr "　途端、火で<炙|あぶ>られるような痛みが走る。"

#. Occurrence 5A_5:1332:4862: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0006; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:1332
msgctxt "text_id=4862 | speaker=aoko"
msgid "\"It's just a bruise. How can it hurt THIS much?"
msgstr "“っ……でも、痛いっちゃあ痛いけど、打撲だけ……？"

#. Occurrence 5A_5:1338:4863: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0007; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:1338
msgctxt "text_id=4863 | speaker=aoko"
msgid "  It could have killed me, catching me off guard like that. Or maybe it can't kill from that distance...?"
msgstr "　あれだけ絶好の奇襲をしておいて？　それとも、この距離じゃ当たっても致命傷にならない？"

#. Occurrence 5A_5:1345:4864: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0008; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:1345
msgctxt "text_id=4864 | speaker=aoko"
msgid "  No, that can't be it. I must be missing something...\""
msgstr "　……なんて、あるワケないか。なにか別の意味があると見るべきね―――”"

#. Occurrence 5A_5:1372:4865: scene=5A_5
#: 5A_5:1372
msgctxt "text_id=4865 | speaker=unknown"
msgid "  Aoko tried to steady her breathing as she assessed the damage done to her back."
msgstr "　背中の<損傷|ダメージ>を量りながら、乱れた呼吸を整える青子。"

#. Occurrence 5A_5:1377:4866: scene=5A_5
#: 5A_5:1377
msgctxt "text_id=4866 | speaker=unknown"
msgid "  The pain was quick to fade and her breathing returned to normal."
msgstr "　痛みも呼吸もすぐに治まった。"

#. Occurrence 5A_5:1382:4867: scene=5A_5
#: 5A_5:1382
msgctxt "text_id=4867 | speaker=unknown"
msgid "  For the time being, her motor functions were no longer hindered."
msgstr "　あくまで今のところではあるが、運動機能に支障はない。"

#. Occurrence 5A_5:1388:4868: scene=5A_5
#: 5A_5:1388
msgctxt "text_id=4868 | speaker=unknown"
msgid "  Which meant the real damage was elsewhere..."
msgstr "　となると、深刻なダメージと言えるのは―――"

#. Occurrence 5A_5:1548:4869: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_5_0004; voice_prefix=A30; voice_category=3; scene=5A_5
#: 5A_5:1548
msgctxt "text_id=4869 | speaker=soujuurou"
msgid "\"Ah, Aozaki! You're―\""
msgstr "「あ、蒼崎、アレ！」"

#. Occurrence 5A_5:1561:4870: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0009; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:1561
msgctxt "text_id=4870 | speaker=aoko"
msgid "\"Ugh, I know. Just shut up already.\""
msgstr "「分かってるわ、黙ってて」"

#. Occurrence 5A_5:1641:4871: scene=5A_5
#: 5A_5:1641
msgctxt "text_id=4871 | speaker=unknown"
msgid "  Blue light glowed across the gloom."
msgstr "　<薄闇|うすやみ>に青い光がともる。"

#. Occurrence 5A_5:1646:4872: scene=5A_5
#: 5A_5:1646
msgctxt "text_id=4872 | speaker=unknown"
msgid "  The magical energy generated by her breathing was accumulating in her right arm."
msgstr "　青子の呼吸に連動して生成された魔力が、その右腕に集められる。"

#. Occurrence 5A_5:1738:4873: scene=5A_5
#: 5A_5:1738
msgctxt "text_id=4873 | speaker=unknown"
msgid "  If magical energy was the fuel, the formula was the igniter."
msgstr "　魔力が燃料なら、術式は点火装置だ。"

#. Occurrence 5A_5:1743:4874: scene=5A_5
#: 5A_5:1743
msgctxt "text_id=4874 | speaker=unknown"
msgid "  For Aoko, this was little more than a reenactment of two evenings ago."
msgstr "　青子にとって、これは二日前の夜の再現にすぎない。"

#. Occurrence 5A_5:1748:4875: scene=5A_5
#: 5A_5:1748
msgctxt "text_id=4875 | speaker=unknown"
msgid "  Next time the puppet extended its arm, Aoko would fire a magic bullet as fast as she could."
msgstr "　あの人形が腕を伸ばしてきた時、最速で術式を走らせ、生成した<魔|た><力|ま>を弾く。"

#. Occurrence 5A_5:1779:4876: scene=5A_5
#: 5A_5:1779
msgctxt "text_id=4876 | speaker=unknown"
msgid "  A battle at approximately thirty feet."
msgstr "　およそ十メートルの格闘戦。"

#. Occurrence 5A_5:1784:4877: scene=5A_5
#: 5A_5:1784
msgctxt "text_id=4877 | speaker=unknown"
msgid "  As long as Aoko could secure a two-second window, she could create a counterattack to end their duel."
msgstr "　生死を分かつクロスカウンターだが、二秒の隙間があるのなら青子でも合わせられる。"

#. Occurrence 5A_5:1832:4878: scene=5A_5
#: 5A_5:1832
msgctxt "text_id=4878 | speaker=unknown"
msgid "  It made its move."
msgstr "“彼女”が動く。"

#. Occurrence 5A_5:1838:4879: scene=5A_5
#: 5A_5:1838
msgctxt "text_id=4879 | speaker=unknown"
msgid "  With its head tilted down, there was no expression to be seen. And in the darkness, its apparent age was impossible to make out."
msgstr "　<俯|うつむ>いているので<表|か><情|お>は見えず、この距離、この暗さでは肉体年齢も判別できない。"

#. Occurrence 5A_5:1843:4880: scene=5A_5
#: 5A_5:1843
msgctxt "text_id=4880 | speaker=unknown"
msgid "  To the two humans, the puppet was not dissimilar to a faceless ghost."
msgstr "　青子たちにとって、人形はいまだ正体のない亡霊と変わらない。"

#. Occurrence 5A_5:1892:4881: scene=5A_5
#: 5A_5:1892
msgctxt "text_id=4881 | speaker=unknown"
msgid "  Its left arm slowly came up with a grinding sound."
msgstr "　キリキリと音をたてて左腕が持ち上がる。"

#. Occurrence 5A_5:1897:4882: scene=5A_5
#: 5A_5:1897
msgctxt "text_id=4882 | speaker=unknown"
msgid "  Its movements were dull, as if the joints were rusty."
msgstr "　<緩慢|かんまん>な、関節が<錆|さ>びきったような動作。"

#. Occurrence 5A_5:1940:4883: scene=5A_5
#: 5A_5:1940
msgctxt "text_id=4883 | speaker=unknown"
msgid "  The right arm, which had been extended earlier, hung at its side."
msgstr "　先ほど伸びた右腕は下げられている。"

#. Occurrence 5A_5:1980:4884: scene=5A_5
#: 5A_5:1980
msgctxt "text_id=4884 | speaker=unknown"
msgid "  Though the puppet's mouth was hidden by its long locks, the sense was that it was smiling."
msgstr "　くすりと、長い髪に隠れた口元が笑った気がした。"

#. Occurrence 5A_5:2062:4885: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0010; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:2062
msgctxt "text_id=4885 | speaker=aoko"
msgid "\"It's changing it up. It's attacking from the left!\""
msgstr "“―――<右手|さっき>と用途が違う、<左|アレ>が本命―――！”"

#. Occurrence 5A_5:2091:4886: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0011; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:2091
msgctxt "text_id=4886 | speaker=aoko"
msgid "\"Move it, Sizuki!\""
msgstr "「静希君、どいて……！！」"

#. Occurrence 5A_5:2215:4887: scene=5A_5
#: 5A_5:2215
msgctxt "text_id=4887 | speaker=unknown"
msgid "  She threw herself into Soujyuro and extended her hand."
msgstr "　青子が草十郎を突きとばしつつ右手をなぎ払うのと、"

#. Occurrence 5A_5:2215:4888: scene=5A_5
#: 5A_5:2215
msgctxt "text_id=4888 | speaker=unknown"
msgid "  Its arm extended at that very moment."
msgstr "“彼女”の左腕が伸びるのは同時だった。"

#. Occurrence 5A_5:2235:4889: scene=5A_5
#: 5A_5:2235
msgctxt "text_id=4889 | speaker=unknown"
msgid "  The timing was impeccable."
msgstr "　タイミングは完璧。"

#. Occurrence 5A_5:2240:4890: scene=5A_5
#: 5A_5:2240
msgctxt "text_id=4890 | speaker=unknown"
msgid "  In a single second, Aoko's Snap bullet scored a direct hit on the puppet's arm, throwing off its trajectory and sending it crashing into the puppet's body with a violent explosion."
msgstr "　一秒の差で青子の<魔弾|スナップ>は人形の<凶|う><器|で>に直撃し、その軌道をズラしながら敵本体に炸裂する。"

#. Occurrence 5A_5:2265:4891: scene=5A_5
#: 5A_5:2265
msgctxt "text_id=4891 | speaker=unknown"
msgid "  ...Or at least, that is what would have happened had the magic formula been invoked."
msgstr "　―――肝心の、魔術式が駆動すればの話だが。"

#. Occurrence 5A_5:2525:4892: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0012; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:2525
msgctxt "text_id=4892 | speaker=aoko"
msgid "\"Huh?!\""
msgstr "「ッ―――！？」"

#. Occurrence 5A_5:2531:4893: scene=5A_5
#: 5A_5:2531
msgctxt "text_id=4893 | speaker=unknown"
msgid "  She barely avoided being struck once again."
msgstr "　撃ち出された腕を紙一重でかわす青子。"

#. Occurrence 5A_5:2536:4894: scene=5A_5
#: 5A_5:2536
msgctxt "text_id=4894 | speaker=unknown"
msgid "  When her magecraft failed her, intuition took over, and she just managed to get away."
msgstr "　魔術は発動しなかったが、相手の攻撃をかわせたのはここ一番の<勘|かん>の良さか。"

#. Occurrence 5A_5:2587:4895: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0013; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:2587
msgctxt "text_id=4895 | speaker=aoko"
msgid "\"She got me! She knew what I was going to do!\""
msgstr "“やられた、最初のはそういうコトか……！”"

#. Occurrence 5A_5:2593:4896: scene=5A_5
#: 5A_5:2593
msgctxt "text_id=4896 | speaker=unknown"
msgid "  She clenched her teeth in frustration, her thoughts racing a mile a minute."
msgstr "　こんちくしょう、と歯がみしつつ青子は思考を巡らせた。"

#. Occurrence 5A_5:2598:4897: scene=5A_5
#: 5A_5:2598
msgctxt "text_id=4897 | speaker=unknown"
msgid "  Fight or flight?"
msgstr "　<走|せ>るべきか、<退|ひ>くべきか。"

#. Occurrence 5A_5:2603:4898: scene=5A_5
#: 5A_5:2603
msgctxt "text_id=4898 | speaker=unknown"
msgid "  It only had one arm left, which would take time to retract."
msgstr "　残る腕は一本。人形の腕は巻き戻しに時間がかかる。"

#. Occurrence 5A_5:2608:4899: scene=5A_5
#: 5A_5:2608
msgctxt "text_id=4899 | speaker=unknown"
msgid "  This was the best shot Aoko had at defeating it."
msgstr "　言うまでもなく好機。やるのなら今だ。"

#. Occurrence 5A_5:2613:4900: scene=5A_5
#: 5A_5:2613
msgctxt "text_id=4900 | speaker=unknown"
msgid "  If she could evade the right arm just a fraction, she could get close enough to..."
msgstr "　右腕だけならもう一度ギリギリでかわして、とにかく近づいてしまえば―――"

#. Occurrence 5A_5:2655:4901: voice_id=C40_5A_5_0000_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:2655
msgctxt "text_id=4901 | speaker=unknown"
msgid "                  \"<Vivo in somno. Solitarie putresco in inferis|In slumber, I live. In dirt, I rot, alone>."
msgstr "　　“<Vivo in somno. Solitarie putresco in inferis|私は眠りの中で生きている。ひとりきりで土の中で腐っていく。>."

#. Occurrence 5A_5:2655:4902: voice_id=C40_5A_5_0000_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:2655
msgctxt "text_id=4902 | speaker=unknown"
msgid "      <Hic dies meus obitus dies, et meus nativus dies. Te obeam.|Today is the day I died and was born. I come to you.>\""
msgstr "@o<Hic dies meus obitus dies, et meus nativus dies. Te obeam.|今日は私の命日であり、誕生日だ。さあ、貴方に会いに行こう。>”"

#. Occurrence 5A_5:2690:4903: scene=5A_5
#: 5A_5:2690
msgctxt "text_id=4903 | speaker=unknown"
msgid "  A crackle echoed through the corridor."
msgstr "　がさついた音が<木霊|こだま>する。"

#. Occurrence 5A_5:2695:4904: scene=5A_5
#: 5A_5:2695
msgctxt "text_id=4904 | speaker=unknown"
msgid "  The poetic murmurs contained enough magical energy for a mage to perceive."
msgstr "　<詩文|しぶん>めいた<囁|ささや>きは、魔術師なら視覚できるほどの魔力の<残|の><留|こ><思|り><念|び>だった。"

#. Occurrence 5A_5:2700:4905: scene=5A_5
#: 5A_5:2700
msgctxt "text_id=4905 | speaker=unknown"
msgid "  The verse itself was Latin, but it contained hints of the language of curses―Gandr."
msgstr "　唄い文句こそラテン語だが、ところどころに<呪詛|ガンド>の韻が含まれている。"

#. Occurrence 5A_5:2705:4906: scene=5A_5
#: 5A_5:2705
msgctxt "text_id=4906 | speaker=unknown"
msgid "  Originally, they were words meant to curse a hated adversary."
msgstr "　本来なら憎い相手を<呪|のろ>う言葉。"

#. Occurrence 5A_5:2710:4907: scene=5A_5
#: 5A_5:2710
msgctxt "text_id=4907 | speaker=unknown"
msgid "  However..."
msgstr "　それを、"

#. Occurrence 5A_5:2765:4908: voice_id=C40_5A_5_0001_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:2765
msgctxt "text_id=4908 | speaker=unknown"
msgid "              \"<Mea anima immortalis. Autem mea futura necata sunt|My life is immortal, though my future was destroyed.>."
msgstr "“<Mea anima immortalis. Autem mea futura necata sunt|私の命は不滅ですが、私の未来は殺されました。>."

#. Occurrence 5A_5:2765:4909: voice_id=C40_5A_5_0001_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:2765
msgctxt "text_id=4909 | speaker=unknown"
msgid "                    <Manes sum. Animam definire ambiguum est|I am a ghost. The definition of life is ethereal.>."
msgstr "　　　<Manes sum. Animam definire ambiguum est|私は亡霊です。生命の定義はあやふやです。>."

#. Occurrence 5A_5:2765:4910: voice_id=C40_5A_5_0001_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:2765
msgctxt "text_id=4910 | speaker=unknown"
msgid "                <Te odi, et te amo. Conveniamus in somnio ipso.|I hate you. I love you. Let us meet in a dream.>\""
msgstr "　　<Te odi, et te amo. Conveniamus in somnio ipso.|憎らしい、愛おしい貴方。どうか、夢で会いましょう。>”"

#. Occurrence 5A_5:2812:4911: scene=5A_5
#: 5A_5:2812
msgctxt "text_id=4911 | speaker=unknown"
msgid "  ...The puppet was directing the words at itself."
msgstr "　……それを、あの人形は自分自身に向けていた。"

#. Occurrence 5A_5:2817:4912: scene=5A_5
#: 5A_5:2817
msgctxt "text_id=4912 | speaker=unknown"
msgid "  Curses beget curses. The victim calls down a curse on the assailant, creating a vicious cycle of negativity."
msgstr "　呪いは呪いを生む。被害者は加害者を呪い返す事で、負の連鎖を回していく。"

#. Occurrence 5A_5:2837:4913: scene=5A_5
#: 5A_5:2837
msgctxt "text_id=4913 | speaker=unknown"
msgid "  The incantation was meant to do just that."
msgstr "　……あの詠唱はそのサイクルを利用したものだ。"

#. Occurrence 5A_5:2842:4914: scene=5A_5
#: 5A_5:2842
msgctxt "text_id=4914 | speaker=unknown"
msgid "  However, this was ultimately a one-puppet show."
msgstr "　ただしあくまで一人芝居。"

#. Occurrence 5A_5:2847:4915: scene=5A_5
#: 5A_5:2847
msgctxt "text_id=4915 | speaker=unknown"
msgid "  An unprecedented source of power akin to autointoxication."
msgstr "　自家中毒にも似た異例の動力源。"

#. Occurrence 5A_5:2852:4916: scene=5A_5
#: 5A_5:2852
msgctxt "text_id=4916 | speaker=unknown"
msgid "  As unbelievable as it seemed, the cycle of curses had been turned into a perpetual motion device."
msgstr "　信じがたい事だが―――アレは呪い呪われる事で、一定の<動力|まりょく>を維持し続ける永久機関……！"

#. Occurrence 5A_5:2929:4917: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0014; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:2929
msgctxt "text_id=4917 | speaker=aoko"
msgid "\"You've got to be kidding me. Isn't this overkill!?\""
msgstr "「なにそれ、レベル高すぎじゃない……！？」"

#. Occurrence 5A_5:2989:4918: scene=5A_5
#: 5A_5:2989
msgctxt "text_id=4918 | speaker=unknown"
msgid "  Aoko abandoned the idea of digging her heels in."
msgstr "　青子は徹底抗戦の選択肢を切り捨てた。"

#. Occurrence 5A_5:2994:4919: scene=5A_5
#: 5A_5:2994
msgctxt "text_id=4919 | speaker=unknown"
msgid "  It was time to flee with all due haste."
msgstr "　反撃はせず、最速で身をひるがえす。"

#. Occurrence 5A_5:3075:4920: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0015; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:3075
msgctxt "text_id=4920 | speaker=aoko"
msgid "\"What do you think you're doing?! Come on!\""
msgstr "「なにしてんの、アンタも来る！」"

#. Occurrence 5A_5:3101:4921: scene=5A_5
#: 5A_5:3101
msgctxt "text_id=4921 | speaker=unknown"
msgid "  She grabbed Soujyuro's hand and ran as fast as she could, deeper into the realm of mirrors."
msgstr "　急展開に置いてけぼりだった草十郎の手をとって、青子は全力で鏡の国の奥地へと走り出す。"

#. Occurrence 5A_5:3119:4922: scene=5A_5
#: 5A_5:3119
msgctxt "text_id=4922 | speaker=unknown"
msgid "  The crackling voice continued its murmuring behind them."
msgstr "　ふたりの背後には、なお続くひび割れた声。"

#. Occurrence 5A_5:3155:4923: voice_id=C40_5A_5_0002_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:3155
msgctxt "text_id=4923 | speaker=unknown"
msgid "    \"<Proximi mihi neglegentes fuerunt. Omnes nos peccantes fuimus|My neighbors neglected me.>,"
msgstr "“<Proximi mihi neglegentes fuerunt. Omnes nos peccante|隣人は私に無関心でした。私たちは誰もが罪深く、>s"

#. Occurrence 5A_5:3155:4924: voice_id=C40_5A_5_0002_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:3155
msgctxt "text_id=4924 | speaker=unknown"
msgid "        <et omnes nos eidem fuimus, omnes nos peccatores sumus|Not an innocent among us, we are all sinners.>."
msgstr "<fuimus, et omnes nos eidem fuimus, omnes nos peccatore|同類でした。私たちは罪人です。>s"

#. Occurrence 5A_5:3155:4925: voice_id=C40_5A_5_0002_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:3155
msgctxt "text_id=4925 | speaker=unknown"
msgid "                    <Venite domum meam. Luto simile somnium|We are all sinners. Welcome to my house.>,"
msgstr "　　<sumus. Venite domum meam. Luto simile somnium|私の家にいらっしゃい。泥のような死を。>,"

#. Occurrence 5A_5:3155:4926: voice_id=C40_5A_5_0002_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:3155
msgctxt "text_id=4926 | speaker=unknown"
msgid "                      <et pulveri simile cotidianum. Cor privo.|May we die a muddy death. From dust to dust. Gouge out my heart.>\""
msgstr "　　　　<et pulveri simile cotidianum. Cor privo.|塵となって囁く。この胸を去った心臓を抉り出して、>”"

#. Occurrence 5A_5:3193:4927: voice_id=C40_5A_5_0003_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:3193
msgctxt "text_id=4927 | speaker=unknown"
msgid "                                      \"<Death be upon you.|Te iudico.>\""
msgstr "　　　　　　　　“「<オマエニ、死ヲ|Te iudico.>」”"

#. Occurrence 5A_6:56:4928: scene=5A_6
#: 5A_6:56
msgctxt "text_id=4928 | speaker=unknown"
msgid "  Aoko fought against the pain in her back as she ran through the mirrored corridor."
msgstr "　青子は背中の痛みに耐えながら、鏡張りの通路を走る。"

#. Occurrence 5A_6:61:4929: scene=5A_6
#: 5A_6:61
msgctxt "text_id=4929 | speaker=unknown"
msgid "  She dragged Soujyuro by the hand."
msgstr "　その手に引かれておまけ状態の草十郎も走る。"

#. Occurrence 5A_6:147:4930: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0000; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:147
msgctxt "text_id=4930 | speaker=soujuurou"
msgid "\"Aozaki, are you okay?\""
msgstr "「蒼崎、傷は？」"

#. Occurrence 5A_6:154:4931: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0000; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:154
msgctxt "text_id=4931 | speaker=aoko"
msgid "\"...My spine is numb, but it could be worse. My internal organs seem fine, and I don't think I'm bleeding internally.\""
msgstr "「……べつに、背骨が<痺|しび>れてる程度よ。内臓は平気だし、出血もないみたい」"

#. Occurrence 5A_6:160:4932: scene=5A_6
#: 5A_6:160
msgctxt "text_id=4932 | speaker=unknown"
msgid "  She cursed inwardly at how much of a mess she felt, though."
msgstr "　ま、肝心の<神経|かいろ>はズタズタだけど、と内心呟く青子。"

#. Occurrence 5A_6:167:4933: scene=5A_6
#: 5A_6:167
msgctxt "text_id=4933 | speaker=unknown"
msgid "  Unlike Soujyuro, Aoko did not run into any transparent walls,"
msgstr "　草十郎と違い、青子は透明の壁にぶつからない。"

#. Occurrence 5A_6:172:4934: scene=5A_6
#: 5A_6:172
msgctxt "text_id=4934 | speaker=unknown"
msgid "  thanks not to superior sight, but rather preparation―she'd hammered the layout of the building into her memory."
msgstr "　目がいいのではなく、ミラーハウスの構造を頭にたたきこんでいるからだ。"

#. Occurrence 5A_6:225:4935: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0001; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:225
msgctxt "text_id=4935 | speaker=soujuurou"
msgid "\"...You're really okay? How can you tell?\""
msgstr "「……平気って、分かるのか？」"

#. Occurrence 5A_6:231:4936: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0001; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:231
msgctxt "text_id=4936 | speaker=aoko"
msgid "\"Because it's my body. One of the first things a mage learns is how to keep track of your body.\""
msgstr "「そりゃ自分の体だもの。身体管理は基礎中の基礎よ」"

#. Occurrence 5A_6:259:4937: scene=5A_6
#: 5A_6:259
msgctxt "text_id=4937 | speaker=unknown"
msgid "  Aoko's matter-of-fact answer contrasted with Soujyuro's nervous questioning."
msgstr "　恐る恐る訊ねる草十郎と、つまらなそうに答える青子。"

#. Occurrence 5A_6:264:4938: scene=5A_6
#: 5A_6:264
msgctxt "text_id=4938 | speaker=unknown"
msgid "  The corridor grew shorter with each and every left turn."
msgstr "　左曲がりの回廊は段々と、その直線距離を短くしていた。"

#. Occurrence 5A_6:269:4939: scene=5A_6
#: 5A_6:269
msgctxt "text_id=4939 | speaker=unknown"
msgid "  At first, they were able to advance in a straight line for about a hundred feet at a time."
msgstr "　先ほどまではまっすぐに三十メートル。"

#. Occurrence 5A_6:274:4940: scene=5A_6
#: 5A_6:274
msgctxt "text_id=4940 | speaker=unknown"
msgid "  But by now, they were forced to turn a corner every fifty feet or so."
msgstr "　今では十五メートルほどで曲がり角に突き当たる。"

#. Occurrence 5A_6:330:4941: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0002; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:330
msgctxt "text_id=4941 | speaker=soujuurou"
msgid "\"Is that the one from... the other night?\""
msgstr "「あいつは、あの夜の……？」"

#. Occurrence 5A_6:336:4942: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0002; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:336
msgctxt "text_id=4942 | speaker=aoko"
msgid "\"Probably the same pattern, at least. Whoever's behind it must be pretty wealthy to be throwing a valuable automaton around like it's a toy.\""
msgstr "「たぶんね。同じタイプだと思う。貴重な<自動人形|オートマタ>を惜し気もなく使い捨てるなんて、よっぽどお金持ちなんだろうけど」"

#. Occurrence 5A_6:366:4943: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0003; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:366
msgctxt "text_id=4943 | speaker=soujuurou"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 5A_6:371:4944: scene=5A_6
#: 5A_6:371
msgctxt "text_id=4944 | speaker=unknown"
msgid "  Soujyuro furrowed his brows."
msgstr "　む、と眉間に<皺|しわ>の草十郎。"

#. Occurrence 5A_6:376:4945: scene=5A_6
#: 5A_6:376
msgctxt "text_id=4945 | speaker=unknown"
msgid "  He was grateful that she was answering his questions, but baffled by the strange words she was using."
msgstr "　質問にきちんと答えてくれるのはありがたいが、聞けば聞くほど聴き慣れない単語が出てくるのは困りものだ。"

#. Occurrence 5A_6:476:4946: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0004; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:476
msgctxt "text_id=4946 | speaker=soujuurou"
msgid "\"Hold up, Aozaki. We've been running for a long time."
msgstr "「蒼崎、ストップ。もうずいぶん走ったぞ。"

#. Occurrence 5A_6:482:4947: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0005; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:482
msgctxt "text_id=4947 | speaker=soujuurou"
msgid "  We're a good corner ahead of it. We can afford to rest a moment.\""
msgstr "　あいつは曲がり<角|かど>一つぶん向こうだ。少し休もう」"

#. Occurrence 5A_6:488:4948: scene=5A_6
#: 5A_6:488
msgctxt "text_id=4948 | speaker=unknown"
msgid "  His words suggested that he was still concerned about her injuries."
msgstr "　青子の傷を気遣って声をかける。"

#. Occurrence 5A_6:493:4949: scene=5A_6
#: 5A_6:493
msgctxt "text_id=4949 | speaker=unknown"
msgid "  Aoko shook her head in irritation."
msgstr "　しかし、彼女は不機嫌そうに首を振った。"

#. Occurrence 5A_6:556:4950: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0003; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:556
msgctxt "text_id=4950 | speaker=aoko"
msgid "\"Not enough against something with that kind of range. We need to keep running until we're two or three turns clear, at least.\""
msgstr "「あの距離を狙ってくる相手に通路一つ分のリードは無意味よ。せめて二つ分に行くまで走るの」"

#. Occurrence 5A_6:576:4951: scene=5A_6
#: 5A_6:576
msgctxt "text_id=4951 | speaker=unknown"
msgid "  Soujyuro nodded."
msgstr "　なるほど、と頷く草十郎。"

#. Occurrence 5A_6:581:4952: scene=5A_6
#: 5A_6:581
msgctxt "text_id=4952 | speaker=unknown"
msgid "  With that matter settled, he asked,"
msgstr "　と、それはともかくとして、"

#. Occurrence 5A_6:602:4953: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0006; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:602
msgctxt "text_id=4953 | speaker=soujuurou"
msgid "\"Why didn't you leave me behind?\""
msgstr "「なんで俺を連れていってるんだ？」"

#. Occurrence 5A_6:642:4954: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0004; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:642
msgctxt "text_id=4954 | speaker=aoko"
msgid "\"Why do you think? So you couldn't get away, idiot.\""
msgstr "「逃げられたくないからじゃない、馬鹿」"

#. Occurrence 5A_6:651:4955: scene=5A_6
#: 5A_6:651
msgctxt "text_id=4955 | speaker=unknown"
msgid "  Answering curtly, Aoko glared at her naïve prey."
msgstr "　実に簡潔な返答をしつつ、平和ぼけした獲物をむっと睨む青子だった。"

#. Occurrence 5A_6:752:4956: scene=5A_6
#: 5A_6:752
msgctxt "text_id=4956 | speaker=unknown"
msgid "  The two of them headed for the next corner."
msgstr "　ふたりはさらに先の曲がり角へ。"

#. Occurrence 5A_6:757:4957: scene=5A_6
#: 5A_6:757
msgctxt "text_id=4957 | speaker=unknown"
msgid "  Their legs began to slow as they rounded one more."
msgstr "　通路二つ分のリードをとって、ようやく足が止められる。"

#. Occurrence 5A_6:832:4958: scene=5A_6
#: 5A_6:832
msgctxt "text_id=4958 | speaker=unknown"
msgid "  Aoko rubbed her back as she tried to catch her breath."
msgstr "　青子は息を整えながら背中に手を当てた。"

#. Occurrence 5A_6:837:4959: scene=5A_6
#: 5A_6:837
msgctxt "text_id=4959 | speaker=unknown"
msgid "  Though Aoko had insisted that she was fine, it appeared to have been bravado."
msgstr "　先ほどは“ぜんぜん平気”と断言した青子だが、どうも強がりだったらしい。"

#. Occurrence 5A_6:842:4960: scene=5A_6
#: 5A_6:842
msgctxt "text_id=4960 | speaker=unknown"
msgid "  Even the usually clueless Soujyuro felt the desperation they were in."
msgstr "　なぜなら、空気の読めない草十郎にも分かるぐらい空気が重い。"

#. Occurrence 5A_6:888:4961: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0007; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:888
msgctxt "text_id=4961 | speaker=soujuurou"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 5A_6:893:4962: scene=5A_6
#: 5A_6:893
msgctxt "text_id=4962 | speaker=unknown"
msgid "  He stood behind Aoko with his arms folded."
msgstr "　そんな青子の後ろで、さて、と腕を組む草十郎。"

#. Occurrence 5A_6:898:4963: scene=5A_6
#: 5A_6:898
msgctxt "text_id=4963 | speaker=unknown"
msgid "  While they had a moment, he tried to make sense of everything."
msgstr "　鬼の居ぬ間になんとやらで、この隙に、彼は彼なりに現状把握などにトライしてみた。"

#. Occurrence 5A_6:956:4964: scene=5A_6
#: 5A_6:956
msgctxt "text_id=4964 | speaker=unknown"
msgid "  First, Aoko had nearly killed him."
msgstr "　まず、自分は蒼崎青子に殺されかけた。"

#. Occurrence 5A_6:977:4965: scene=5A_6
#: 5A_6:977
msgctxt "text_id=4965 | speaker=unknown"
msgid "  Though he was saved at the last possible second, it was by the strange, stretchy woman Aoko had burned to ashes two nights prior."
msgstr "　あわやというところで助けが入ったが、割って入った人物は二日前の夜、青子によって燃やされた『怪奇腕が伸びる人間』だった。"

#. Occurrence 5A_6:982:4966: scene=5A_6
#: 5A_6:982
msgctxt "text_id=4966 | speaker=unknown"
msgid "  He could barely make it out that night, but he considered it a \"her\" because it looked female."
msgstr "　よく見えなかったが、とりあえず女性っぽかったので彼女と呼称する。"

#. Occurrence 5A_6:1021:4967: scene=5A_6
#: 5A_6:1021
msgctxt "text_id=4967 | speaker=unknown"
msgid "  The woman's attack wounded Aoko's back and forced her to flee."
msgstr "　その彼女の攻撃で青子は背中を負傷し、一旦逃走。"

#. Occurrence 5A_6:1026:4968: scene=5A_6
#: 5A_6:1026
msgctxt "text_id=4968 | speaker=unknown"
msgid "  Aoko had taken Soujyuro with her, claiming that the reason she did so was to prevent her prey from escaping."
msgstr "　その際、なぜか草十郎の手を取ったが、それはどさくさに紛れて<草十郎|エモノ>が逃げ出すのを阻止するため、とのコトだった。"

#. Occurrence 5A_6:1037:4969: scene=5A_6
#: 5A_6:1037
msgctxt "text_id=4969 | speaker=unknown"
msgid "  In other words..."
msgstr "　つまり―――"

#. Occurrence 5A_6:1068:4970: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0008; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:1068
msgctxt "text_id=4970 | speaker=soujuurou"
msgid "\"You haven't given up, have you, Aozaki?\""
msgstr "「蒼崎は、まだ<諦|あきら>めてないんだな？」"

#. Occurrence 5A_6:1099:4971: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0005; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1099
msgctxt "text_id=4971 | speaker=aoko"
msgid "\"Of course not! Even if I had to face two of those things, I'd still have plenty left to take care of the likes of you.\""
msgstr "「あったりまえよ。あんなヤツ、仮に二体と半分始末してもアンタ用の余力は残せるわ」"

#. Occurrence 5A_6:1105:4972: scene=5A_6
#: 5A_6:1105
msgctxt "text_id=4972 | speaker=unknown"
msgid "  Her tone was sharp, but even Soujyuro could see that she was struggling to stay confident."
msgstr "　などとタンカをきる青子の表情は、<草十郎|しろうと>目にも厳しい。"

#. Occurrence 5A_6:1110:4973: scene=5A_6
#: 5A_6:1110
msgctxt "text_id=4973 | speaker=unknown"
msgid "  The damage to her body was too much to afford her any optimism."
msgstr "　彼女の体のダメージは無視できるものではなく、状況は楽観できるものではない。"

#. Occurrence 5A_6:1145:4974: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0006; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1145
msgctxt "text_id=4974 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5A_6:1150:4975: scene=5A_6
#: 5A_6:1150
msgctxt "text_id=4975 | speaker=unknown"
msgid "  Still, the fury in her eyes refused to accept her circumstances."
msgstr "　だが、彼女の目に秘められた激情が、その一切を否定する。"

#. Occurrence 5A_6:1202:4976: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0007; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1202
msgctxt "text_id=4976 | speaker=aoko"
msgid "\"My Magic Circuits are shorting out like crazy..."
msgstr "“<魔術回路|なか>がところどころショートしてる……"

#. Occurrence 5A_6:1202:4977: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0007; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1202
msgctxt "text_id=4977 | speaker=aoko"
msgid "  Which means that right arm of hers must be jamming my spells.\""
msgstr "　あの右腕は回路を混線させる<術式妨害|ジャミング>ってワケね―――”"

#. Occurrence 5A_6:1208:4978: scene=5A_6
#: 5A_6:1208
msgctxt "text_id=4978 | speaker=unknown"
msgid "  Though the proper response would have been for her to tremble in fear, she did nothing but shake her fists in anger."
msgstr "　本来ならピンチに震え上がるところだが、青子の拳を震わせたのは怒りだけだ。"

#. Occurrence 5A_6:1235:4979: scene=5A_6
#: 5A_6:1235
msgctxt "text_id=4979 | speaker=unknown"
msgid "  The disruption of formulae was only supposed to work on absolute beginners."
msgstr "　術式妨害なんて初歩の初歩、かけだしの半人前にしか通じない。"

#. Occurrence 5A_6:1240:4980: scene=5A_6
#: 5A_6:1240
msgctxt "text_id=4980 | speaker=unknown"
msgid "  If it had been her roommate, the arm would have been repelled the instant it hit her and the attacker's circuits burned out, rather than her own."
msgstr "　彼女の同居人レベルなら、あんなジャミングはそれこそ腕が触れた時点で弾き、接触しようとした相手の回路を逆に焼き切ってしまうだろう。"

#. Occurrence 5A_6:1245:4981: scene=5A_6
#: 5A_6:1245
msgctxt "text_id=4981 | speaker=unknown"
msgid "  Attempting to establish a link to the Magic Circuits of another mage was like presenting your heart on a silver platter. It would be of no use in a battle against a superior mage."
msgstr "　このように、他の魔術師と回路を繋げよう、なんて行為は自分の心臓を差し出すに等しい。卓越した魔術師同士の術理戦において、何の役にもたたない<駄機能|だきのう>だ。"

#. Occurrence 5A_6:1296:4982: scene=5A_6
#: 5A_6:1296
msgctxt "text_id=4982 | speaker=unknown"
msgid "  And yet, her adversary had been designed to do just that."
msgstr "　なのに、あの敵にはそんな“余分な”機能が備えられていた。"

#. Occurrence 5A_6:1301:4983: scene=5A_6
#: 5A_6:1301
msgctxt "text_id=4983 | speaker=unknown"
msgid "  Coupled with the attacks on areas of Misaki under Aoko's jurisdiction these last few weeks, it was a clear statement from the enemy, who had revealed itself as a fellow mage two days ago."
msgstr "　ここ数週間の、三咲の管理地を巡る戦いっぷりから出た、敵の結論。二日前、正式に魔術師として踏みだした彼女に対する評価がそれ。"

#. Occurrence 5A_6:1308:4984: scene=5A_6
#: 5A_6:1308
msgctxt "text_id=4984 | speaker=unknown"
msgid "  In other words,"
msgstr "　要するに―――"

#. Occurrence 5A_6:1308:4985: scene=5A_6
#: 5A_6:1308
msgctxt "text_id=4985 | speaker=unknown"
msgid "  the puppet saw Aoko as no threat at all."
msgstr "　あの<人形|てき>は、蒼崎青子を完っ全に舐めている。"

#. Occurrence 5A_6:1375:4986: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0008; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1375
msgctxt "text_id=4986 | speaker=aoko"
msgid "\"...Hmph. Played right into their hands, huh.\""
msgstr "「……ふん。敵ながら精確な判断だこと」"

#. Occurrence 5A_6:1381:4987: scene=5A_6
#: 5A_6:1381
msgctxt "text_id=4987 | speaker=unknown"
msgid "  While she was still angry, the whirlwind of emotions within her started to fade."
msgstr "　怒りはそのままに、浮き足立つ激情を冷却する。"

#. Occurrence 5A_6:1386:4988: scene=5A_6
#: 5A_6:1386
msgctxt "text_id=4988 | speaker=unknown"
msgid "  Her face was that of a hunter far beyond her years."
msgstr "　十七歳の少女には似つかわしくない、達観した狩人の顔。"

#. Occurrence 5A_6:1467:4989: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0009; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:1467
msgctxt "text_id=4989 | speaker=soujuurou"
msgid "\"You seem to be more concerned about this thing than you were about hunting me.\""
msgstr "「なんか、俺の時より真剣だな」"

#. Occurrence 5A_6:1487:4990: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0009; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1487
msgctxt "text_id=4990 | speaker=aoko"
msgid "\"Well, naturally. I was only playing with you.\""
msgstr "「まあね。アンタの時は遊びが入ってたし」"

#. Occurrence 5A_6:1502:4991: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0010; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:1502
msgctxt "text_id=4991 | speaker=soujuurou"
msgid "\"...Hm.\""
msgstr "「……む」"

#. Occurrence 5A_6:1508:4992: scene=5A_6
#: 5A_6:1508
msgctxt "text_id=4992 | speaker=unknown"
msgid "  Soujyuro was not sure whether to be happy or sad at that."
msgstr "　喜んでいいのか悲しんでいいのか、草十郎には難しい返答だった。"

#. Occurrence 5A_6:1565:4993: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0011; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:1565
msgctxt "text_id=4993 | speaker=soujuurou"
msgid "\"This is all so confusing that I don't even know where to start, but can I ask just one question?\""
msgstr "「分からない事だらけで何を聞いていいか分からないんだけど、ひとつだけいいか？」"

#. Occurrence 5A_6:1606:4994: scene=5A_6
#: 5A_6:1606
msgctxt "text_id=4994 | speaker=unknown"
msgid "  Aoko didn't respond. Her eyes were focused on the darkness before them."
msgstr "　青子は<応|こた>えず、目前の闇を見詰めている。"

#. Occurrence 5A_6:1611:4995: scene=5A_6
#: 5A_6:1611
msgctxt "text_id=4995 | speaker=unknown"
msgid "  The silence was heavy, and the darkness was like a noose closing in on them."
msgstr "　沈黙は重く、まとわりつく闇は締めつける<真綿|まわた>のようだ。"

#. Occurrence 5A_6:1616:4996: scene=5A_6
#: 5A_6:1616
msgctxt "text_id=4996 | speaker=unknown"
msgid "  But Soujyuro continued in spite of her indifference."
msgstr "　それでも、完全に自分を無いものと扱う青子に臆さず、草十郎は続けた。"

#. Occurrence 5A_6:1638:4997: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0012; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:1638
msgctxt "text_id=4997 | speaker=soujuurou"
msgid "\"Are you going to kill her, too, Aozaki?\""
msgstr "「蒼崎は、あいつも殺すのか」"

#. Occurrence 5A_6:1644:4998: scene=5A_6
#: 5A_6:1644
msgctxt "text_id=4998 | speaker=unknown"
msgid "  A stillness fell over them."
msgstr "　<粛々|しゅくしゅく>と。"

#. Occurrence 5A_6:1649:4999: scene=5A_6
#: 5A_6:1649
msgctxt "text_id=4999 | speaker=unknown"
msgid "  It was as if the gloom was pulling them in."
msgstr "　その行為を、暗闇から引きずりだすように。"

#. Occurrence 5A_6:1703:5000: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0010; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1703
msgctxt "text_id=5000 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5A_6:1709:5001: scene=5A_6
#: 5A_6:1709
msgctxt "text_id=5001 | speaker=unknown"
msgid "  No response."
msgstr "　返事はない。"

#. Occurrence 5A_6:1714:5002: scene=5A_6
#: 5A_6:1714
msgctxt "text_id=5002 | speaker=unknown"
msgid "  Their breathing was the only sound echoing in the dim corridor."
msgstr "　薄影の廊下に、ふたりの息遣いだけが響く。"

#. Occurrence 5A_6:1769:5003: scene=5A_6
#: 5A_6:1769
msgctxt "text_id=5003 | speaker=unknown"
msgid "  There stood Soujyuro, forcing her to confront her sins, and the magician girl who continued to ignore him."
msgstr "　罪を問いかける草十郎と、それを無視し続ける魔法使いの少女。"

#. Occurrence 5A_6:1775:5004: scene=5A_6
#: 5A_6:1775
msgctxt "text_id=5004 | speaker=unknown"
msgid "They spent a few seconds, seemingly frozen in time."
msgstr "……凍りつくような数秒の<後|のち>、"

#. Occurrence 5A_6:1782:5005: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0011; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1782
msgctxt "text_id=5005 | speaker=aoko"
msgid "\"...Yes."
msgstr "「―――そう。"

#. Occurrence 5A_6:1788:5006: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0012; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1788
msgctxt "text_id=5006 | speaker=aoko"
msgid "  That's a sticking point for you, isn't it?\""
msgstr "　それが貴方のキーワードみたいね」"

#. Occurrence 5A_6:1820:5007: scene=5A_6
#: 5A_6:1820
msgctxt "text_id=5007 | speaker=unknown"
msgid "  Aoko whispered in a lifeless tone."
msgstr "　抑揚のない声で、青子は呟いた。"

#. Occurrence 5A_6:1825:5008: scene=5A_6
#: 5A_6:1825
msgctxt "text_id=5008 | speaker=unknown"
msgid "  Her sigh was tinged with both resignation and contempt."
msgstr "　観念したようにも、軽蔑したようにも取れる、ため息をこぼしながら。"

#. Occurrence 5A_6:1873:5009: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0013; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:1873
msgctxt "text_id=5009 | speaker=soujuurou"
msgid "\"A sticky... what?\""
msgstr "「キー……なに？」"

#. Occurrence 5A_6:1902:5010: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0013; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1902
msgctxt "text_id=5010 | speaker=aoko"
msgid "\"Nothing. Forget it."
msgstr "「独り言よ。忘れて。"

#. Occurrence 5A_6:1908:5011: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0014; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1908
msgctxt "text_id=5011 | speaker=aoko"
msgid "  But just so you know, that thing that's following us isn't human."
msgstr "　それと。言っとくけど、あいつは人間じゃないわ。"

#. Occurrence 5A_6:1914:5012: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0015; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1914
msgctxt "text_id=5012 | speaker=aoko"
msgid "  You might not believe this, but it's a puppet that can move of its own will. Just like the one from the other night.\""
msgstr "　信じられないだろうけど自分の意志で動く人形なの。この前のも、今のヤツもね」"

#. Occurrence 5A_6:1919:5013: scene=5A_6
#: 5A_6:1919
msgctxt "text_id=5013 | speaker=unknown"
msgid "  Soujyuro nodded as he processed the information."
msgstr "　ふーん、と素直に頷く草十郎。"

#. Occurrence 5A_6:1932:5014: scene=5A_6
#: 5A_6:1932
msgctxt "text_id=5014 | speaker=unknown"
msgid "  Not only did he not doubt her story, but he seemed to have accepted it at face value."
msgstr "　青子の話を信じないどころか、納得さえしている風だ。"

#. Occurrence 5A_6:1975:5015: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0016; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1975
msgctxt "text_id=5015 | speaker=aoko"
msgid "\"...You're awfully calm.\""
msgstr "「……なんか落ち着いてるわね、貴方」"

#. Occurrence 5A_6:1988:5016: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0014; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:1988
msgctxt "text_id=5016 | speaker=soujuurou"
msgid "\"No way. I have no idea what's going on, so I'm just trying not to think too hard about it."
msgstr "「まさか。もう何がなんだか分からないから、あまり考えない事にしてるだけだ。"

#. Occurrence 5A_6:1995:5017: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0015; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:1995
msgctxt "text_id=5017 | speaker=soujuurou"
msgid "The part about it being a puppet isn't too surprising to me, though.\""
msgstr "ただ、人形に関しては別に、どうという事はない」"

#. Occurrence 5A_6:2009:5018: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0017; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:2009
msgctxt "text_id=5018 | speaker=aoko"
msgid "\"What? Are you saying you've seen one before!?\""
msgstr "「え？　もしかして、他でも自動人形を見た事あるとか！？」"

#. Occurrence 5A_6:2034:5019: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0016; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:2034
msgctxt "text_id=5019 | speaker=soujuurou"
msgid "\"What do you mean? Aren't all puppets in the city like that?\""
msgstr "「？　都会の人形ってああいうものじゃないのか？」"

#. Occurrence 5A_6:2083:5020: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0018; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:2083
msgctxt "text_id=5020 | speaker=aoko"
msgid "\"Wha...\""
msgstr "「な―――」"

#. Occurrence 5A_6:2098:5021: scene=5A_6
#: 5A_6:2098
msgctxt "text_id=5021 | speaker=unknown"
msgid "  She barely stopped herself from falling to her knees."
msgstr "　ばたり、と倒れこみたい衝動をギリギリで<堪|こら>える青子。"

#. Occurrence 5A_6:2103:5022: scene=5A_6
#: 5A_6:2103
msgctxt "text_id=5022 | speaker=unknown"
msgid "  Of course. How could she have forgotten?"
msgstr "　そうなのだった。"

#. Occurrence 5A_6:2109:5023: scene=5A_6
#: 5A_6:2109
msgctxt "text_id=5023 | speaker=unknown"
msgid "She was dealing with a bona fide, natural-born moron."
msgstr "この、神がかった<呆|ほう>け者はそういう男なのだった。"

#. Occurrence 5A_6:2114:5024: scene=5A_6
#: 5A_6:2114
msgctxt "text_id=5024 | speaker=unknown"
msgid "  As a student who transferred from the isolation of the mountains like an endangered species, his utter lack of common sense rendered anything miraculous as mundane."
msgstr "　天然保護動物なみに隔離された山奥からの転入生で、常識はずれの常識の無さで、見るものすべてが奇想天外という異邦人。"

#. Occurrence 5A_6:2141:5025: scene=5A_6
#: 5A_6:2141
msgctxt "text_id=5025 | speaker=unknown"
msgid "  If automobiles were moving hunks of metal, then moving puppets were nothing to write home about."
msgstr "　自動車という鉄の塊が動くなら、人形だって動くと思っても不思議はない。"

#. Occurrence 5A_6:2146:5026: scene=5A_6
#: 5A_6:2146
msgctxt "text_id=5026 | speaker=unknown"
msgid "  Wait. That meant..."
msgstr "　……なので、もしかしたら。"

#. Occurrence 5A_6:2151:5027: scene=5A_6
#: 5A_6:2151
msgctxt "text_id=5027 | speaker=unknown"
msgid "  To him, the incident from the other night hadn't been extraordinary at all."
msgstr "　彼にとってあの夜の出来事は“特別”なことではなく。"

#. Occurrence 5A_6:2156:5028: scene=5A_6
#: 5A_6:2156
msgctxt "text_id=5028 | speaker=unknown"
msgid "  He might have even assumed it was an everyday occurrence in the city."
msgstr "　都会ではよくある風景として、誰に言いふらすような事ではなかったのかもしれない。"

#. Occurrence 5A_6:2183:5029: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0019_A; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:2183
msgctxt "text_id=5029 | speaker=aoko"
msgid "\"...I give up. You know, I'd really like to get a look inside your head someday. I honestly have no idea how you've made it this far in life."
msgstr "「……まいった。いっぺん頭のなか覗いてみたいっていうか、ほんと、ここまでくると感心するわ。"

#. Occurrence 5A_6:2189:5030: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0020; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:2189
msgctxt "text_id=5030 | speaker=aoko"
msgid "  No wonder you're such a weirdo. Normally, people wouldn't react the way you did when I attacked you."
msgstr "　……調子が狂うのも当然だった。普通は私に襲われた時点でもっと違う反応をするはずなのに。"

#. Occurrence 5A_6:2196:5031: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0021; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:2196
msgctxt "text_id=5031 | speaker=aoko"
msgid "I could have been a monster or a ghost, but for you, it was just another new fact of life."
msgstr "化け物とか、お化けとかさ。でも貴方にとっては『そういう事もある』で済まされてたワケなんだ。"

#. Occurrence 5A_6:2227:5032: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0022; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:2227
msgctxt "text_id=5032 | speaker=aoko"
msgid "  ...I'm starting to feel like the real moron here.\""
msgstr "　……なんか<莫|ば><迦|か>みたいね、私」"

#. Occurrence 5A_6:2247:5033: scene=5A_6
#: 5A_6:2247
msgctxt "text_id=5033 | speaker=unknown"
msgid "  Her strained face returned to normal for a moment."
msgstr "　張りつめた彼女の顔が、一瞬だけ元に戻る。"

#. Occurrence 5A_6:2252:5034: scene=5A_6
#: 5A_6:2252
msgctxt "text_id=5034 | speaker=unknown"
msgid "  It hit her; there had been another way to handle this without anyone getting hurt."
msgstr "　そう。それならもっと違った方法で、誰も傷つかずに済む選択があったかも知れない。"

#. Occurrence 5A_6:2257:5035: scene=5A_6
#: 5A_6:2257
msgctxt "text_id=5035 | speaker=unknown"
msgid "  But the damage had already been done."
msgstr "　けれどもう遅い。"

#. Occurrence 5A_6:2262:5036: scene=5A_6
#: 5A_6:2262
msgctxt "text_id=5036 | speaker=unknown"
msgid "  There were no do-overs in life, nor should there be."
msgstr "　基本、人生にやり直しはない。あってはならない。"

#. Occurrence 5A_6:2282:5037: scene=5A_6
#: 5A_6:2282
msgctxt "text_id=5037 | speaker=unknown"
msgid "  Her own mistaken assumptions had sent that situation spiraling out of control."
msgstr "　些細な勘違い、勝手な思いこみで状況は悪化しすぎた。"

#. Occurrence 5A_6:2287:5038: scene=5A_6
#: 5A_6:2287
msgctxt "text_id=5038 | speaker=unknown"
msgid "  But now that Soujyuro was involved, she had to make sure that her secret was safe with him."
msgstr "　ここまで関わった以上、彼女は草十郎を手にかけて秘密を守らなければならない。"

#. Occurrence 5A_6:2293:5039: scene=5A_6
#: 5A_6:2293
msgctxt "text_id=5039 | speaker=unknown"
msgid "  Even if there had been another, better option, that ship had sailed."
msgstr "　……本当はもうひとつぐらい、最善の選択肢があっただろうけど後の祭り。"

#. Occurrence 5A_6:2298:5040: scene=5A_6
#: 5A_6:2298
msgctxt "text_id=5040 | speaker=unknown"
msgid "  Human relationships were ultimately driven by mutual misunderstandings;"
msgstr "　所詮、人間の関わり合いなんて相互誤解で回るもの。"

#. Occurrence 5A_6:2303:5041: scene=5A_6
#: 5A_6:2303
msgctxt "text_id=5041 | speaker=unknown"
msgid "  they were like tapestries, woven from mismatched intentions."
msgstr "　<意|い><図|と>の編み違いで転がっていく<織物|おりもの>だ。"

#. Occurrence 5A_7:58:5042: scene=5A_7
#: 5A_7:58
msgctxt "text_id=5042 | speaker=unknown"
msgid "  Breaktime was over."
msgstr "　―――休憩はここまで。"

#. Occurrence 5A_7:64:5043: scene=5A_7
#: 5A_7:64
msgctxt "text_id=5043 | speaker=unknown"
msgid "  There stood Aoko Aozaki and Soujyuro Sizuki."
msgstr "　蒼崎青子と静希草十郎。"

#. Occurrence 5A_7:69:5044: scene=5A_7
#: 5A_7:69
msgctxt "text_id=5044 | speaker=unknown"
msgid "  Their first ever idle conversation had come to an end, not that they had a choice in the matter."
msgstr "　ふたりが自己紹介を交わした日以来の、なんでもない会話はここで終わり。"

#. Occurrence 5A_7:74:5045: scene=5A_7
#: 5A_7:74
msgctxt "text_id=5045 | speaker=unknown"
msgid "  It was the jarring murmuring from around the corner that cut it short."
msgstr "　彼らの心情とは関係なく、曲がり角の向こうから耳障りな囁きが流れてくる。"

#. Occurrence 5A_7:153:5046: voice_id=C40_5A_7_0000_C; voice_prefix=C40; voice_category=0; scene=5A_7
#: 5A_7:153
msgctxt "text_id=5046 | speaker=unknown"
msgid "    \"<Nemo meum funus meminit, qui doluit exstinctus est|Nobody remembers my funeral. My mourners have long since perished.>."
msgstr "@o“<Nemo meum funus meminit, qui doluit exstinctus est|私のお葬式はもう誰も覚えていません。悲しむ人も消え去りました。>."

#. Occurrence 5A_7:153:5047: voice_id=C40_5A_7_0000_C; voice_prefix=C40; voice_category=0; scene=5A_7
#: 5A_7:153
msgctxt "text_id=5047 | speaker=unknown"
msgid "                    <Initio erraveramus. Dum vivimus dolores sunt|We were born wrong. Life is suffering.>."
msgstr "　　<Initio erraveramus. Dum vivimus dolores sunt|はじまりから私たちは間違えていました。生きているのは苦しいです。>."

#. Occurrence 5A_7:153:5048: voice_id=C40_5A_7_0000_C; voice_prefix=C40; voice_category=0; scene=5A_7
#: 5A_7:153
msgctxt "text_id=5048 | speaker=unknown"
msgid "                                          <Nemo adiuvat|Somebody save me.>.\""
msgstr "　　　　　　　　　<Nemo adiuvat.|誰か、私を救ってください。>”"

#. Occurrence 5A_7:211:5049: scene=5A_7
#: 5A_7:211
msgctxt "text_id=5049 | speaker=unknown"
msgid "  The enemy was just around the corner, visible in the mirrors parallel to it."
msgstr "　合わせ鏡に、曲がり<角|かど>向こうの敵が<映|うつ>る。"

#. Occurrence 5A_7:231:5050: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0000_0; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:231
msgctxt "text_id=5050 | speaker=aoko"
msgid "\"...We don't have time for this. We need to keep our dist―"
msgstr "「……悠長に話してる場合じゃないわね。とにかく今は距離を―――"

#. Occurrence 5A_7:243:5051: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0000_1; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:243
msgctxt "text_id=5051 | speaker=aoko"
msgid " Huh!?\""
msgstr "っ、！？」"

#. Occurrence 5A_7:452:5052: scene=5A_7
#: 5A_7:452
msgctxt "text_id=5052 | speaker=unknown"
msgid "  In contrast to Aoko's elegant blues, its lights were a malicious red."
msgstr "　青子の鮮麗な青色とは違う、怨恨を思わせる赤い光。"

#. Occurrence 5A_7:505:5053: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0001; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:505
msgctxt "text_id=5053 | speaker=aoko"
msgid "\"Gandr Shots!\""
msgstr "“ガンド撃ち……！”"

#. Occurrence 5A_7:589:5054: scene=5A_7
#: 5A_7:589
msgctxt "text_id=5054 | speaker=unknown"
msgid "  There was a momentary flash of light, before she even extended her arm."
msgstr "　伸びる腕より速い、一瞬の閃光。"

#. Occurrence 5A_7:594:5055: scene=5A_7
#: 5A_7:594
msgctxt "text_id=5055 | speaker=unknown"
msgid "  But the instant she saw the enemy, her dormant feelings erupted once more."
msgstr "　が、はっきりと敵の姿を視認した時点で、沈みかけていた青子の感情も一瞬で再熱していた。"

#. Occurrence 5A_7:615:5056: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0002; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:615
msgctxt "text_id=5056 | speaker=aoko"
msgid "\"You're a real pain in the ass!\""
msgstr "「っ、さっきから邪魔なのよ……っ！」"

#. Occurrence 5A_7:743:5057: scene=5A_7
#: 5A_7:743
msgctxt "text_id=5057 | speaker=unknown"
msgid "  She channeled all of her pent-up anger and shunted it into her right arm."
msgstr "　行き場のない、ありったけの怒りをぶつけて彼女の右腕が突き出される。"

#. Occurrence 5A_7:763:5058: scene=5A_7
#: 5A_7:763
msgctxt "text_id=5058 | speaker=unknown"
msgid "  The fog that filled the corridor was no magical weaving, but rather a barrier of raw energy."
msgstr "　展開された霧は魔術によるものではなく、魔力をぶちまけただけの障壁だ。"

#. Occurrence 5A_7:768:5059: scene=5A_7
#: 5A_7:768
msgctxt "text_id=5059 | speaker=unknown"
msgid "  It was equivalent to setting ablaze three buckets of gasoline to create a wall of fire, in the hope it would stop an arrow in flight."
msgstr "　飛来する一本の矢の威力をそぐために、バケツ三杯分のガソリンを燃やして壁を作るようなものである。"

#. Occurrence 5A_7:788:5060: scene=5A_7
#: 5A_7:788
msgctxt "text_id=5060 | speaker=unknown"
msgid "  If the puppet had attacked with its arm, it could have pierced such a wall easily. But, because it had loosed curses with no definite form, the wall of energy repelled the attack."
msgstr "　これが人形の腕であったのなら魔力の壁はたやすく突破されただろうが、実像のない“呪い”だからこそ、魔力の壁に弾かれる。"

#. Occurrence 5A_7:793:5061: scene=5A_7
#: 5A_7:793
msgctxt "text_id=5061 | speaker=unknown"
msgid "  While it was a huge waste of magical energy, it was the only means Aoko had to protect herself at that very moment."
msgstr "　膨大な魔力の無駄遣いだが、今の青子にはそれしか<防|ふせ>ぐ手段がない。"

#. Occurrence 5A_7:902:5062: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0000; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:902
msgctxt "text_id=5062 | speaker=soujuurou"
msgid "\"...Urgh.\""
msgstr "「……う」"

#. Occurrence 5A_7:908:5063: scene=5A_7
#: 5A_7:908
msgctxt "text_id=5063 | speaker=unknown"
msgid "  Unfortunately, its protection was reserved for Aoko alone."
msgstr "　が、それで守りきれるのは青子だけだった。"

#. Occurrence 5A_7:1042:5064: scene=5A_7
#: 5A_7:1042
msgctxt "text_id=5064 | speaker=unknown"
msgid "  Soujyuro held his hand to his mouth."
msgstr "　口を押さえる草十郎。"

#. Occurrence 5A_7:1047:5065: scene=5A_7
#: 5A_7:1047
msgctxt "text_id=5065 | speaker=unknown"
msgid "  While the curse had been weakened to the point where Aoko could no longer feel it, it had plenty of effect on Soujyuro, who was not a mage."
msgstr "　青子には影響を及ぼさないほど小さくなった呪いでも、魔術師ではない草十郎には十分な効果がある。"

#. Occurrence 5A_7:1116:5066: scene=5A_7
#: 5A_7:1116
msgctxt "text_id=5066 | speaker=unknown"
msgid "  As if it understood this fact, the puppet turned its gaze from Aoko to the unanticipated human behind her."
msgstr "　それが理解できるのか、人形は青子ではなく、その背後にいる予定外の人間に視線を向けた。"

#. Occurrence 5A_7:1161:5067: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0003; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:1161
msgctxt "text_id=5067 | speaker=aoko"
msgid "\"T-this has nothing to do with him!\""
msgstr "「この、こいつは関係ないでしょう……！」"

#. Occurrence 5A_7:1204:5068: scene=5A_7
#: 5A_7:1204
msgctxt "text_id=5068 | speaker=unknown"
msgid "  Enraged, she swung her arm forward once again."
msgstr "　カッとなってもう一度腕を振るう。"

#. Occurrence 5A_7:1209:5069: scene=5A_7
#: 5A_7:1209
msgctxt "text_id=5069 | speaker=unknown"
msgid "  The blue light formed a wall to block the Gandr for a scant few seconds."
msgstr "　わずか数秒、青い燐光は<呪い|ガンド>を防ぐ障壁となる。"

#. Occurrence 5A_7:1308:5070: scene=5A_7
#: 5A_7:1308
msgctxt "text_id=5070 | speaker=unknown"
msgid "  It was enough of an opening to exploit."
msgstr "　その隙。"

#. Occurrence 5A_7:1313:5071: scene=5A_7
#: 5A_7:1313
msgctxt "text_id=5071 | speaker=unknown"
msgid "  Just as Aoko was forming the wall, the puppet pointed its right arm at her face, and..."
msgstr "　壁を張ったばかりの青子の顔を指さすように、人形の右腕が突き出され―――"

#. Occurrence 5A_7:1320:5072: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0001; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:1320
msgctxt "text_id=5072 | speaker=soujuurou"
msgid "\"This apparently does have something to do with me. Time to run.\""
msgstr "「関係あるみたいだから、逃げるぞ」"

#. Occurrence 5A_7:1389:5073: scene=5A_7
#: 5A_7:1389
msgctxt "text_id=5073 | speaker=unknown"
msgid "  Before the rocket of death could be fired, Soujyuro scooped her up into his arms."
msgstr "　死のロケット弾が放たれる前に、草十郎はひょいっと青子を抱き抱えた。"

#. Occurrence 5A_7:1455:5074: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0004; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:1455
msgctxt "text_id=5074 | speaker=aoko"
msgid "\"Huh?!\""
msgstr "「へ！？」"

#. Occurrence 5A_7:1461:5075: scene=5A_7
#: 5A_7:1461
msgctxt "text_id=5075 | speaker=unknown"
msgid "  How he mustered the strength to do so was a mystery, but he turned his back on the puppet and took off running."
msgstr "　どこにそんな力が残っていたのか、草十郎は人形に背を向けて走り出した。"

#. Occurrence 5A_7:1549:5076: scene=5A_7
#: 5A_7:1549
msgctxt "text_id=5076 | speaker=unknown"
msgid "  He was a nimble sprinter, resembling a deer leaping across obstacles."
msgstr "　軽快なスプリンターか、岩肌を跳ぶ鹿のようだ。"

#. Occurrence 5A_7:1554:5077: scene=5A_7
#: 5A_7:1554
msgctxt "text_id=5077 | speaker=unknown"
msgid "  Soujyuro rounded two more corners,"
msgstr "　草十郎は曲がり角を二つ越え、"

#. Occurrence 5A_7:1579:5078: scene=5A_7
#: 5A_7:1579
msgctxt "text_id=5078 | speaker=unknown"
msgid "  ignored whatever complaints Aoko was making,"
msgstr "　なにか文句を言いたそうな青子を無視して、"

#. Occurrence 5A_7:1584:5079: scene=5A_7
#: 5A_7:1584
msgctxt "text_id=5079 | speaker=unknown"
msgid "  and eventually stopped in the middle of the second floor. He set her down."
msgstr "　もうじき二階の中心、というところで足を止めて、青子から手を離した。"

#. Occurrence 5A_7:1635:5080: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0002; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:1635
msgctxt "text_id=5080 | speaker=soujuurou"
msgid "\"...All right. I bought us enough time to rest a bit.\""
msgstr "「……よし。ここまでくれば少しは休めるな」"

#. Occurrence 5A_7:1641:5081: scene=5A_7
#: 5A_7:1641
msgctxt "text_id=5081 | speaker=unknown"
msgid "  Soujyuro's shoulders heaved as he caught his breath."
msgstr "　ふう、と肩で息をする草十郎。"

#. Occurrence 5A_7:1646:5082: scene=5A_7
#: 5A_7:1646
msgctxt "text_id=5082 | speaker=unknown"
msgid "  As light as she was, running while carrying someone else would make anyone winded."
msgstr "　いくら軽いとは言え、人間ひとり抱えて走ったので息があがっている。"

#. Occurrence 5A_7:1651:5083: scene=5A_7
#: 5A_7:1651
msgctxt "text_id=5083 | speaker=unknown"
msgid "  She looked up at him in incomprehension."
msgstr "　その顔を、青子は理解不能とばかりに見あげている。"

#. Occurrence 5A_7:1688:5084: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0005; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:1688
msgctxt "text_id=5084 | speaker=aoko"
msgid "\"You had that much stamina all along? Then why...?\""
msgstr "「……こんな体力あったのに、なんで……？」"

#. Occurrence 5A_7:1694:5085: scene=5A_7
#: 5A_7:1694
msgctxt "text_id=5085 | speaker=unknown"
msgid "  It made no sense to her."
msgstr "　道理に合わない。"

#. Occurrence 5A_7:1699:5086: scene=5A_7
#: 5A_7:1699
msgctxt "text_id=5086 | speaker=unknown"
msgid "  If he had the stamina to pick her up and run, surely he could have stood up and escaped when he had been downed earlier."
msgstr "　自分を抱えて走れるだけの体力があったのなら、床に倒れたあの時、まだ立ち上がって逃げられたはずなのにと。"

#. Occurrence 5A_7:1750:5087: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0003; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:1750
msgctxt "text_id=5087 | speaker=soujuurou"
msgid "\"Oh, that time I had given up.\""
msgstr "「ああ、あの時は諦めてたから」"

#. Occurrence 5A_7:1756:5088: scene=5A_7
#: 5A_7:1756
msgctxt "text_id=5088 | speaker=unknown"
msgid "  His words were unfiltered as ever."
msgstr "　取り<繕|つくろ>いのない、さっぱりとした言葉。"

#. Occurrence 5A_7:1761:5089: scene=5A_7
#: 5A_7:1761
msgctxt "text_id=5089 | speaker=unknown"
msgid "  Though right then, fighting for their lives, he lacked some of his usual absentmindedness."
msgstr "　一刻、一命を争う状況だ。普段のぼんやりした雰囲気は、さすがに薄くなっている。"

#. Occurrence 5A_7:1782:5090: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0006; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:1782
msgctxt "text_id=5090 | speaker=aoko"
msgid "\"...But why?\""
msgstr "「……諦めてたって、どうして？」"

#. Occurrence 5A_7:1823:5091: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0004; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:1823
msgctxt "text_id=5091 | speaker=soujuurou"
msgid "\"Who knows? I've forgotten already.\""
msgstr "「さあ。忘れた、そんな事は」"

#. Occurrence 5A_7:1829:5092: scene=5A_7
#: 5A_7:1829
msgctxt "text_id=5092 | speaker=unknown"
msgid "  Though he may have turned away because he regretted saying it aloud, his words spoke volumes."
msgstr "　言いたくない、と顔を背けるものの、律儀に草十郎は答える。"

#. Occurrence 5A_7:1834:5093: scene=5A_7
#: 5A_7:1834
msgctxt "text_id=5093 | speaker=unknown"
msgid "  For some reason, it pained Aoko to see him like that."
msgstr "　その横顔は、青子にはなんだか痛かった。"

#. Occurrence 5A_7:1882:5094: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0005; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:1882
msgctxt "text_id=5094 | speaker=soujuurou"
msgid "\"Also, Aozaki? I'm suddenly feeling really ill."
msgstr "「それより蒼崎、とうとつに気分が悪いんだが……。"

#. Occurrence 5A_7:1888:5095: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0006; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:1888
msgctxt "text_id=5095 | speaker=soujuurou"
msgid "  Was it that red light?\""
msgstr "　あの赤い光も、その……？」"

#. Occurrence 5A_7:1903:5096: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0007; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:1903
msgctxt "text_id=5096 | speaker=aoko"
msgid "\"...Yes. A form of magecraft. They're called Gandr Shots. A curse that originated in Scandinavia. It has no effect on someone with Magic Circuits like myself, but you're defenseless against it.\""
msgstr "「……ええ、魔術の類よ。ガンド撃ちって言ってね。北欧の呪詛の一つ。魔術回路のある私には効かないけど、抵抗のない貴方には効果てきめんみたいね」"

#. Occurrence 5A_7:1948:5097: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0007; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:1948
msgctxt "text_id=5097 | speaker=soujuurou"
msgid "\"...I see. It doesn't work on you."
msgstr "「―――なんだ。蒼崎には効かないのか。"

#. Occurrence 5A_7:1948:5098: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0007; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:1948
msgctxt "text_id=5098 | speaker=soujuurou"
msgid "  Then that arm is the only thing that poses a threat.\""
msgstr "　じゃあ、危ないのはあの腕だけだな」"

#. Occurrence 5A_7:1954:5099: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0008; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:1954
msgctxt "text_id=5099 | speaker=aoko"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 5A_7:2009:5100: scene=5A_7
#: 5A_7:2009
msgctxt "text_id=5100 | speaker=unknown"
msgid "  Aoko had no idea why he was relieved, but she gritted her teeth and fought down the urge to snap at him."
msgstr "　なぜかホッとする草十郎に、青子は奥歯を噛んで、突発的な<感|こ><情|え>を抑えこんだ。"

#. Occurrence 5A_7:2015:5101: scene=5A_7
#: 5A_7:2015
msgctxt "text_id=5101 | speaker=unknown"
msgid "  There was no use in yelling at a time like this."
msgstr "　……こんなところで怒鳴っても仕方がないし。"

#. Occurrence 5A_7:2020:5102: scene=5A_7
#: 5A_7:2020
msgctxt "text_id=5102 | speaker=unknown"
msgid "  Above all, she felt that it would have been petty in the extreme to voice her annoyance right now."
msgstr "　なにより、どうしていま自分が最高にイラっときたかなんて、言語化したらそれこそ何もかもどうでもよくなってしまいそうだ。"

#. Occurrence 5A_7:2079:5103: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0009; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2079
msgctxt "text_id=5103 | speaker=aoko"
msgid "\"...You're right. The extending arm is the only thing I have to worry about. So it's not that tough after all.\""
msgstr "「―――そうね。注意するのは伸ばしてくる腕だけ。大した相手じゃないわ、やっぱり」"

#. Occurrence 5A_7:2085:5104: scene=5A_7
#: 5A_7:2085
msgctxt "text_id=5104 | speaker=unknown"
msgid "  This time it was not false bravado."
msgstr "　嘘偽りのない感想だった。"

#. Occurrence 5A_7:2090:5105: scene=5A_7
#: 5A_7:2090
msgctxt "text_id=5105 | speaker=unknown"
msgid "  Such an enemy would normally be a breeze for Aoko Aozaki."
msgstr "　普段の蒼崎青子なら問題のない相手。"

#. Occurrence 5A_7:2095:5106: scene=5A_7
#: 5A_7:2095
msgctxt "text_id=5106 | speaker=unknown"
msgid "  But her shameful negligence had led to the disruption of her Magic Circuits, making her even less formidable than her enemy."
msgstr "　ただ、目も当てられない油断から魔術回路に介入されて、自分がさらに大した相手じゃなくなっただけの話。"

#. Occurrence 5A_7:2140:5107: scene=5A_7
#: 5A_7:2140
msgctxt "text_id=5107 | speaker=unknown"
msgid "  At this point, Aoko had no way of attacking."
msgstr "　今の青子には攻撃手段がない。"

#. Occurrence 5A_7:2145:5108: scene=5A_7
#: 5A_7:2145
msgctxt "text_id=5108 | speaker=unknown"
msgid "  The only option left to her was to wait for it to expend all of its magical energy, but its perpetual curse mechanism made that a non-starter."
msgstr "　こうなると相手の魔力切れを待つしかないのだが、相手は呪いの永久機関。"

#. Occurrence 5A_7:2150:5109: scene=5A_7
#: 5A_7:2150
msgctxt "text_id=5109 | speaker=unknown"
msgid "  This game of tag would not end until one of them was dead."
msgstr "　この追いかけっこは、どちらかが息絶えるまで終わらない。"

#. Occurrence 5A_7:2156:5110: scene=5A_7
#: 5A_7:2156
msgctxt "text_id=5110 | speaker=unknown"
msgid "  She realized that she was in the same position she had cornered Soujyuro in earlier."
msgstr "　……まるでさっきの自分たちのようだと青子は自嘲する。"

#. Occurrence 5A_7:2194:5111: scene=5A_7
#: 5A_7:2194
msgctxt "text_id=5111 | speaker=unknown"
msgid "  She glanced at her right arm."
msgstr "　右腕をちらりと見る。"

#. Occurrence 5A_7:2201:5112: scene=5A_7
#: 5A_7:2201
msgctxt "text_id=5112 | speaker=unknown"
msgid "  She could not imagine how she had gotten into such a mess with her magical energy at more than half of its capacity."
msgstr "　魔力残量はまだ半分以上もあるのに、このていたらくとは。"

#. Occurrence 5A_7:2206:5113: scene=5A_7
#: 5A_7:2206
msgctxt "text_id=5113 | speaker=unknown"
msgid "  This had to be karma for having enjoyed toying with Soujyuro earlier."
msgstr "　面白がって草十郎を追いかけ回した<罰|ツケ>が、こんな形で回ってきた。"

#. Occurrence 5A_7:2227:5114: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0010; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2227
msgctxt "text_id=5114 | speaker=aoko"
msgid "\"...Hah. Maybe there is a god after all.\""
msgstr "“……呆れた。居るところには居るものね、神さまって”"

#. Occurrence 5A_7:2254:5115: scene=5A_7
#: 5A_7:2254
msgctxt "text_id=5115 | speaker=unknown"
msgid "  She grumbled under her breath as she shifted her focus."
msgstr "　ひとり<愚|ぐ><痴|ち>って、青子は意識を切り替える。"

#. Occurrence 5A_7:2259:5116: scene=5A_7
#: 5A_7:2259
msgctxt "text_id=5116 | speaker=unknown"
msgid "  She had the fuel for the fire but not the igniter."
msgstr "　弾こそ撃てないがまだ燃料のある自分。"

#. Occurrence 5A_7:2264:5117: scene=5A_7
#: 5A_7:2264
msgctxt "text_id=5117 | speaker=unknown"
msgid "  And that killing machine would chase her until the end of time if need be."
msgstr "　尽きない動力で永久に追いかけてくる殺人機巧。"

#. Occurrence 5A_7:2269:5118: scene=5A_7
#: 5A_7:2269
msgctxt "text_id=5118 | speaker=unknown"
msgid "  What she should do next was blindingly clear."
msgstr "　なら、取るべき未来は明白すぎる。"

#. Occurrence 5A_7:2274:5119: scene=5A_7
#: 5A_7:2274
msgctxt "text_id=5119 | speaker=unknown"
msgid "  She had to get back to normal."
msgstr "　あとはいつもの自分に戻るだけだ。"

#. Occurrence 5A_7:2295:5120: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0008; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:2295
msgctxt "text_id=5120 | speaker=soujuurou"
msgid "\"...Aozaki?\""
msgstr "「……蒼崎？」"

#. Occurrence 5A_7:2332:5121: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0011; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2332
msgctxt "text_id=5121 | speaker=aoko"
msgid "\"Sorry, I was thinking."
msgstr "「ごめん、考え事してた。"

#. Occurrence 5A_7:2352:5122: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0012; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2352
msgctxt "text_id=5122 | speaker=aoko"
msgid "Hmm, maybe that could... Okay, Sizuki, I've got it. You see that side passage over there?\""
msgstr "えっと、たしか……よし、あってる。静希君、そこに横道あるの、分かる？」"

#. Occurrence 5A_7:2358:5123: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0009; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:2358
msgctxt "text_id=5123 | speaker=soujuurou"
msgid "\"Huh?\""
msgstr "「は？」"

#. Occurrence 5A_7:2403:5124: scene=5A_7
#: 5A_7:2403
msgctxt "text_id=5124 | speaker=unknown"
msgid "  Aoko pointed, but he could see nothing but the walls of the corridor."
msgstr "　青子が指さした先はどう見ても通路の壁で、横道なんて見あたらない。"

#. Occurrence 5A_7:2408:5125: scene=5A_7
#: 5A_7:2408
msgctxt "text_id=5125 | speaker=unknown"
msgid "  For one thing, the floor had nothing but left turns, and Aoko was pointing to the right."
msgstr "　そもそもこのフロアは左に曲がるだけの造りで、青子が示しているのは右側に抜ける道だ。"

#. Occurrence 5A_7:2436:5126: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0013; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2436
msgctxt "text_id=5126 | speaker=aoko"
msgid "\"At the center of the second floor is a stairway down to the first floor, which I destroyed earlier so you couldn't use it."
msgstr "「二階は中心までいくと一階に下りる階段があるんだけど、それは私が壊したから使えないの。"

#. Occurrence 5A_7:2442:5127: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0014; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2442
msgctxt "text_id=5127 | speaker=aoko"
msgid "  But there's another path that leads to the right, like this place is taunting you by design. It's a secret shortcut that only the hardcore fans know about."
msgstr "　けどここの造りも意地が悪くてね。よく見れば右に曲がる通路もあるのよ。上級者だけに分かる抜け道ってヤツ。"

#. Occurrence 5A_7:2448:5128: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0015; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2448
msgctxt "text_id=5128 | speaker=aoko"
msgid "  If you search carefully, you can find a way to the stairs down to the first floor. Now do as I say and go on without me.\""
msgstr "　あとは注意して探せば、一階の階段までショートカットできる。悪いけどひとりで行って」"

#. Occurrence 5A_7:2498:5129: scene=5A_7
#: 5A_7:2498
msgctxt "text_id=5129 | speaker=unknown"
msgid "  Aoko turned her back to Soujyuro and started walking."
msgstr "　青子は草十郎に背を向けて歩きだした。"

#. Occurrence 5A_7:2503:5130: scene=5A_7
#: 5A_7:2503
msgctxt "text_id=5130 | speaker=unknown"
msgid "  Walking in the opposite direction of the escape route and down the long corridor toward the puppet in pursuit."
msgstr "　逃げ道である右に抜ける通路とは逆の、人形が追いかけてくる長い通路へと。"

#. Occurrence 5A_7:2550:5131: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0016; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2550
msgctxt "text_id=5131 | speaker=aoko"
msgid "\"That thing'll kill anything it sees, so I have to destroy it here and now. It's okay for two mages to fight each other, but dragging normal people into the conflict is strictly forbidden."
msgstr "「あいつは無差別だから、ここで壊さないといけない。魔術師は魔術師同士で争うのはいいんだけど、みだりに一般人に手をだしちゃいけないって決まりがあるの。"

#. Occurrence 5A_7:2556:5132: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0017; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2556
msgctxt "text_id=5132 | speaker=aoko"
msgid "  I'm the target, so this the best outcome for everyone, don't you think?\""
msgstr "　あいつの目的は私のワケだし、結果がどうあれスッキリするでしょ？」"

#. Occurrence 5A_7:2593:5133: scene=5A_7
#: 5A_7:2593
msgctxt "text_id=5133 | speaker=unknown"
msgid "  If Aoko won, the puppet would be destroyed."
msgstr "　青子が勝てば人形は壊れる。"

#. Occurrence 5A_7:2598:5134: scene=5A_7
#: 5A_7:2598
msgctxt "text_id=5134 | speaker=unknown"
msgid "  If Aoko lost, its objective would be complete, and it would shut down."
msgstr "　青子が負けても目的完了という事で人形は停止する。"

#. Occurrence 5A_7:2603:5135: scene=5A_7
#: 5A_7:2603
msgctxt "text_id=5135 | speaker=unknown"
msgid "  Either way, them going their separate ways would mean Soujyuro survived."
msgstr "　どうあれ、ここで別れれば草十郎は無関係のまま生還できる。"

#. Occurrence 5A_7:2608:5136: scene=5A_7
#: 5A_7:2608
msgctxt "text_id=5136 | speaker=unknown"
msgid "  This is what Aoko meant."
msgstr "　そういう事を青子は言っていた。"

#. Occurrence 5A_7:2613:5137: scene=5A_7
#: 5A_7:2613
msgctxt "text_id=5137 | speaker=unknown"
msgid "  Though she explained it as if the events were happening to two totally different people."
msgstr "　事務的に、あくまで他人事のように。"

#. Occurrence 5A_7:2656:5138: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0018; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2656
msgctxt "text_id=5138 | speaker=aoko"
msgid "\"If you're lucky enough, you'll make it back to the gate in one piece."
msgstr "「運が良ければ入り口までたどり着けるわ。"

#. Occurrence 5A_7:2662:5139: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0019; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2662
msgctxt "text_id=5139 | speaker=aoko"
msgid "  So, see you tomorrow then.\""
msgstr "　それじゃ、また明日ね」"

#. Occurrence 5A_7:2697:5140: scene=5A_7
#: 5A_7:2697
msgctxt "text_id=5140 | speaker=unknown"
msgid "  Even Soujyuro could tell she was just trying to act tough."
msgstr "　強がりであるのは草十郎ですら感じ取れた。"

#. Occurrence 5A_7:2702:5141: scene=5A_7
#: 5A_7:2702
msgctxt "text_id=5141 | speaker=unknown"
msgid "  But she had already disappeared around the corner by the time he thought to stop her."
msgstr "　けれど止める間も、その必要もなく、彼女は曲がり角に消えていった。"

#. Occurrence 5A_8:67:5142: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0000; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:67
msgctxt "text_id=5142 | speaker=aoko"
msgid "\"...Well, then.\""
msgstr "「―――さて」"

#. Occurrence 5A_8:73:5143: scene=5A_8
#: 5A_8:73
msgctxt "text_id=5143 | speaker=unknown"
msgid "  Mentally, Aoko bemoaned the disaster she was in."
msgstr "　本格的にまずい事になったな、と青子は心中で呟いた。"

#. Occurrence 5A_8:78:5144: scene=5A_8
#: 5A_8:78
msgctxt "text_id=5144 | speaker=unknown"
msgid "  The quality of this puppet was on a completely different level compared to the one from the park two days ago."
msgstr "　今回の<人|て><形|き>は二日前の公園で倒したものとは<品|か><質|く>が違う。"

#. Occurrence 5A_8:83:5145: scene=5A_8
#: 5A_8:83
msgctxt "text_id=5145 | speaker=unknown"
msgid "  An auto-incanting perpetual motion machine was a rarity in and of itself, but this puppet was also equipped for battle with its extending arms and Gandr-projecting crystalline eyes."
msgstr "　自動詠唱による永久機関だけでも稀少品なのに、腕を伸ばすという荒事にも耐え、両目は<呪詛|ガンド>を投影する水晶製ときた。"

#. Occurrence 5A_8:88:5146: scene=5A_8
#: 5A_8:88
msgctxt "text_id=5146 | speaker=unknown"
msgid "  It was a first-class product that, if put on the market, would sell for hundreds of millions of yen."
msgstr "　日本円に換算すれば九桁に届きかねない超一級品である。"

#. Occurrence 5A_8:123:5147: scene=5A_8
#: 5A_8:123
msgctxt "text_id=5147 | speaker=unknown"
msgid "  Although, that was only when factoring in its value as an antique."
msgstr "　ただし。それはあくまでアンティークとしての話。"

#. Occurrence 5A_8:128:5148: scene=5A_8
#: 5A_8:128
msgctxt "text_id=5148 | speaker=unknown"
msgid "  For the purposes of combat, it would have made more sense to mobilize a significantly less expensive familiar."
msgstr "　戦闘に<用|もち>いるのなら、もっと安価で、かつ戦いに適した使い魔を動員すべきだろうに。"

#. Occurrence 5A_8:133:5149: scene=5A_8
#: 5A_8:133
msgctxt "text_id=5149 | speaker=unknown"
msgid "  To use such a precious commodity as a tool for murder marked this puppet's master as a completely different breed of crazy from the enemies she had faced up until now."
msgstr "　あれだけの高級品を殺人に用いるあたり、あの人形の持ち主は今までの“敵”とは一線を画した変態に違いない。"

#. Occurrence 5A_8:333:5150: voice_id=C40_5A_8_0000_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:333
msgctxt "text_id=5150 | speaker=unknown"
msgid "  \"Vivo in somno. Solitarie putresco in inferis."
msgstr "“<Vivo|ウィウォ> <in|イン> <somno|スォムノ>. <Solitarie|スォリタリエ> <putresco|プトゥレスコ> <in|イン> <inferis|インフェリス>."

#. Occurrence 5A_8:333:5151: voice_id=C40_5A_8_0000_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:333
msgctxt "text_id=5151 | speaker=unknown"
msgid "    Hic dies meus obitus dies, et meus nativus dies. Te obeam.\""
msgstr "@o<Hic|ヒク> <dies|ディエス> <meus|メウス> <obitus|オビトゥス> <dies|ディエス>, <et|エトゥ> <meus|メウス> <nativus|ナティウゥス> <dies|ディエス>. <Te|テ> <obeam|オベアム>.”"

#. Occurrence 5A_8:469:5152: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0001; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:469
msgctxt "text_id=5152 | speaker=aoko"
msgid "\"...Here it comes.\""
msgstr "「―――来たわね」"

#. Occurrence 5A_8:475:5153: scene=5A_8
#: 5A_8:475
msgctxt "text_id=5153 | speaker=unknown"
msgid "  A sound of a crackling music box filled the air."
msgstr "　がさついたオルゴール。"

#. Occurrence 5A_8:480:5154: scene=5A_8
#: 5A_8:480
msgctxt "text_id=5154 | speaker=unknown"
msgid "  The automata, animated by its own curses, approached."
msgstr "　自らを呪う事で動力を得る<自動人形|オートマタ>が近づいてくる。"

#. Occurrence 5A_8:485:5155: scene=5A_8
#: 5A_8:485
msgctxt "text_id=5155 | speaker=unknown"
msgid "  The corridor measured approximately thirty feet in length. Aoko lay in wait around a corner further down the hall, anticipating the puppet's appearance."
msgstr "　通路の長さは約十メートル。青子は一つ奥の曲がり角で、人形が現れるのを待ちかまえる。"

#. Occurrence 5A_8:548:5156: scene=5A_8
#: 5A_8:548
msgctxt "text_id=5156 | speaker=unknown"
msgid "  This was not to buy Soujyuro time to escape. Far from it."
msgstr "　……ここで決着をつけるのは静希草十郎を逃がす為ではない。断じてない。"

#. Occurrence 5A_8:553:5157: scene=5A_8
#: 5A_8:553
msgctxt "text_id=5157 | speaker=unknown"
msgid "  Aoko had concluded that she couldn't make a break for it under the current circumstances."
msgstr "　青子は的確に、今の自分ではあの人形からは逃げきれないと判断しただけだ。"

#. Occurrence 5A_8:573:5158: scene=5A_8
#: 5A_8:573
msgctxt "text_id=5158 | speaker=unknown"
msgid "  Even if she did try to escape, and―by some miracle―made it out of the house of mirrors, that was as far as she would go."
msgstr "　仮に逃走を選んだ場合、幾つかの幸運が働いてミラーハウスから出られたとしてもそこまで。"

#. Occurrence 5A_8:578:5159: scene=5A_8
#: 5A_8:578
msgctxt "text_id=5159 | speaker=unknown"
msgid "  Outside, with no cover, Aoko would quickly be overtaken and skewered from behind."
msgstr "　障害物のない外に出ればあっさりと追いつかれ、背中から串刺しにされる。"

#. Occurrence 5A_8:603:5160: scene=5A_8
#: 5A_8:603
msgctxt "text_id=5160 | speaker=unknown"
msgid "  As long as her magecraft was disabled, escape was impossible."
msgstr "　魔術が封じられている以上、追っ手から逃げきるのは不可能だ。"

#. Occurrence 5A_8:608:5161: scene=5A_8
#: 5A_8:608
msgctxt "text_id=5161 | speaker=unknown"
msgid "  Instead, she chose to force the enemy back."
msgstr "　なので、ここで撃退する選択をとる。"

#. Occurrence 5A_8:613:5162: scene=5A_8
#: 5A_8:613
msgctxt "text_id=5162 | speaker=unknown"
msgid "  Her situation was not the most favorable, but neither was the puppet's."
msgstr "　状況は不利だが、それはあちらも同じこと。"

#. Occurrence 5A_8:680:5163: scene=5A_8
#: 5A_8:680
msgctxt "text_id=5163 | speaker=unknown"
msgid "  Though this narrow hall gave Aoko no place to run, it in turn prevented the puppet from reaching full speed."
msgstr "　この細い通路では青子に逃げ場はないが、反面、あの人形も全速を出せずにいる。"

#. Occurrence 5A_8:685:5164: scene=5A_8
#: 5A_8:685
msgctxt "text_id=5164 | speaker=unknown"
msgid "  That was the weak point of this machine."
msgstr "　機械仕掛けの欠点だ。"

#. Occurrence 5A_8:690:5165: scene=5A_8
#: 5A_8:690
msgctxt "text_id=5165 | speaker=unknown"
msgid "  Automata of its era had a tendency to struggle with minute changes in speed."
msgstr "　<小刻|こきざ>みな加速と減速は、あの時代のオートマタにとっても苦手とする機能だろう。"

#. Occurrence 5A_8:752:5166: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0002; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:752
msgctxt "text_id=5166 | speaker=aoko"
msgid "\"...<Connecting|Set.>.\""
msgstr "「―――<接続|セット>」"

#. Occurrence 5A_8:815:5167: scene=5A_8
#: 5A_8:815
msgctxt "text_id=5167 | speaker=unknown"
msgid "  She flowed energy into her shorted circuits."
msgstr "　断線だらけの魔術回路に魔力を流す。"

#. Occurrence 5A_8:820:5168: scene=5A_8
#: 5A_8:820
msgctxt "text_id=5168 | speaker=unknown"
msgid "  Her blood flow and magical energy supply were unstable."
msgstr "　……血液の流れ、魔力の供給がまったく安定しない。"

#. Occurrence 5A_8:825:5169: scene=5A_8
#: 5A_8:825
msgctxt "text_id=5169 | speaker=unknown"
msgid "  It would be difficult to construct a formula in this state."
msgstr "　これでは魔術式を組むのは難しい。"

#. Occurrence 5A_8:831:5170: scene=5A_8
#: 5A_8:831
msgctxt "text_id=5170 | speaker=unknown"
msgid "  All she could do was harden her right arm by imbuing it with as much energy as she could."
msgstr "　魔力で右手を加工し、大雑把に硬度を上げる事しかできない。"

#. Occurrence 5A_8:837:5171: scene=5A_8
#: 5A_8:837
msgctxt "text_id=5171 | speaker=unknown"
msgid "Doing so turned her arm into an improvised weapon like a hammer or bat. Assuming she could manage to get into close-combat range, this was the best she could do."
msgstr "青子の武器はトンカチ以上、バット未満の<細腕|ほそうで><鈍器|どんき>だ。近づく事が前提の時点で、この上なく頼りない。"

#. Occurrence 5A_8:923:5172: scene=5A_8
#: 5A_8:923
msgctxt "text_id=5172 | speaker=unknown"
msgid "  All she needed now was a plan of attack."
msgstr "　となると、あとは戦法だ。"

#. Occurrence 5A_8:928:5173: scene=5A_8
#: 5A_8:928
msgctxt "text_id=5173 | speaker=unknown"
msgid "  The question wasn't what weapon to use, but how to use the weapon she had."
msgstr "　今はどんな武器を用意するかではなく、この武器でどう戦うかを選ばなくては。"

#. Occurrence 5A_8:933:5174: scene=5A_8
#: 5A_8:933
msgctxt "text_id=5174 | speaker=unknown"
msgid "  The simplest way would be to use the mirrors' reflections to hide and then rush the puppet from its blind spot... except for one major problem."
msgstr "　簡単に考えつくのは鏡の反射を利用して姿を隠し、死角から襲いかかる―――しかし、それは通じまい。"

#. Occurrence 5A_8:953:5175: scene=5A_8
#: 5A_8:953
msgctxt "text_id=5175 | speaker=unknown"
msgid "  It did not have a sense of sight in the first place."
msgstr "　なぜなら、あの人形にはもともと視覚がない。"

#. Occurrence 5A_8:958:5176: scene=5A_8
#: 5A_8:958
msgctxt "text_id=5176 | speaker=unknown"
msgid "  The puppet's view of the world around it did not stem from visual feedback, but from mapping the topography of its surroundings."
msgstr "　人形は視覚情報からではなく、周囲の地形状況から世界を視ている。"

#. Occurrence 5A_8:963:5177: scene=5A_8
#: 5A_8:963
msgctxt "text_id=5177 | speaker=unknown"
msgid "  In theory, it was the same as a bat's echolocation. The environment could be measured based on the emission and return of high-frequency sound waves."
msgstr "　暗闇に棲息するコウモリと同じ理屈だ。高音の波を発し、その反響によって周囲の地形を<測|はか>る反響定位法。"

#. Occurrence 5A_8:968:5178: scene=5A_8
#: 5A_8:968
msgctxt "text_id=5178 | speaker=unknown"
msgid "  Those chants served as sensor pulses. As far as the puppet was concerned, the mirrors were no better than transparent panes, making even the thought of an ambush laughable."
msgstr "　あの詠唱は<音波|センサー>の役割も果たしている。人形にとって壁は透明の板にすぎず、物陰からの奇襲なぞお笑い草だろう。"

#. Occurrence 5A_8:994:5179: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0003; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:994
msgctxt "text_id=5179 | speaker=aoko"
msgid "(...The closer it gets, the more it's able to sense me. I'd really rather fight it at a distance, but... if it's shooting Gandr, it's probably got at least a Finn Shot up its sleeve, too.)"
msgstr "“……近づけば近づくほど、より<明確|リアル>に察知される……ホントは遠距離からの狙撃が最適なんだけど……ガンドを撃ってくるなら、フィンの一撃ぐらい隠してるわよね……”"

#. Occurrence 5A_8:1063:5180: scene=5A_8
#: 5A_8:1063
msgctxt "text_id=5180 | speaker=unknown"
msgid "  Gandr was Scandinavian in origin and, considering its simplicity, highly versatile. It was most effective at impairing a target's health by pointing a finger."
msgstr "　ガンド撃ちは北欧に伝わる、単純にして汎用性の高い呪詛だ。最適化されたものは“指をさす”だけで相手の体調を悪化させる。"

#. Occurrence 5A_8:1068:5181: scene=5A_8
#: 5A_8:1068
msgctxt "text_id=5181 | speaker=unknown"
msgid "  As a single-action magecraft, it was limited to only causing illness, but there was a secret technique said to be the greatest mastery of the Gandr Shot..."
msgstr "　<一工程|シングルアクション>の魔術なので効果はあくまで“<病|やまい>”に限定されるが、ガンド撃ちには最奥と言われる秘術がある。"

#. Occurrence 5A_8:1073:5182: scene=5A_8
#: 5A_8:1073
msgctxt "text_id=5182 | speaker=unknown"
msgid "  The Finn Shot."
msgstr "　<曰|いわ>く“フィンの一撃”。"

#. Occurrence 5A_8:1078:5183: scene=5A_8
#: 5A_8:1078
msgctxt "text_id=5183 | speaker=unknown"
msgid "  It could do more than cause simple illness. It was a deadly curse that could stop the heart."
msgstr "　病ではなく、受けた相手の心臓を停止させる死の呪い。"

#. Occurrence 5A_8:1186:5184: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0004; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:1186
msgctxt "text_id=5184 | speaker=aoko"
msgid "\"...Nnngh.\""
msgstr "「…………っ」"

#. Occurrence 5A_8:1193:5185: scene=5A_8
#: 5A_8:1193
msgctxt "text_id=5185 | speaker=unknown"
msgid "  The wound on her back set her nerves on fire."
msgstr "　背中に受けた傷が神経を<昂|たか>ぶらせる。"

#. Occurrence 5A_8:1198:5186: scene=5A_8
#: 5A_8:1198
msgctxt "text_id=5186 | speaker=unknown"
msgid "  An unarmed girl and a deadly automaton."
msgstr "　武器を失った小娘と、即死の奥の手を持つ自動人形。"

#. Occurrence 5A_8:1203:5187: scene=5A_8
#: 5A_8:1203
msgctxt "text_id=5187 | speaker=unknown"
msgid "  It was clear that she was the one destined for death."
msgstr "　誰がどう見ても殺されるのは自分の方。"

#. Occurrence 5A_8:1208:5188: scene=5A_8
#: 5A_8:1208
msgctxt "text_id=5188 | speaker=unknown"
msgid "  She considered her slim chances of survival."
msgstr "　彼女は、現状の蒼<崎青|じぶん>子に生き延びる手段は<乏|とぼ>しいと考え、"

#. Occurrence 5A_8:1208:5189: scene=5A_8
#: 5A_8:1208
msgctxt "text_id=5189 | speaker=unknown"
msgid "  When..."
msgstr "　そして―――"

#. Occurrence 5A_8:1347:5190: scene=5A_8
#: 5A_8:1347
msgctxt "text_id=5190 | speaker=unknown"
msgid "  A vision sent chills down her spine."
msgstr "　その幻視に、ぞくりとした。"

#. Occurrence 5A_8:1368:5191: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0005; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:1368
msgctxt "text_id=5191 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5A_8:1374:5192: scene=5A_8
#: 5A_8:1374
msgctxt "text_id=5192 | speaker=unknown"
msgid "  Quietly, using everything she could to clamp down on the feeling, Aoko faced her all-too-familiar illusion."
msgstr "　青子は静かに、<努|つと>めて全霊で、いつもの錯覚を堪え忍ぶ。"

#. Occurrence 5A_8:1379:5193: scene=5A_8
#: 5A_8:1379
msgctxt "text_id=5193 | speaker=unknown"
msgid "  She clenched her teeth to keep them from making a deafening clatter."
msgstr "　カチカチと鳴りそうな奥歯をきっと噛みしめる。"

#. Occurrence 5A_8:1384:5194: scene=5A_8
#: 5A_8:1384
msgctxt "text_id=5194 | speaker=unknown"
msgid "  But there, the sensation of fingers crawling up her neck. Behind her the specter stared and laughed."
msgstr "　ああ、でも、首筋にナニモノかの指が<這|は>っていく感触がある。背後にいる<幽霊|さっかく>が彼女を見て笑っている。"

#. Occurrence 5A_8:1389:5195: scene=5A_8
#: 5A_8:1389
msgctxt "text_id=5195 | speaker=unknown"
msgid "  This alone made Aoko want to bolt. On top of it all, when Aoko tried to mentally simulate the coming fight, she estimated a two in ten chance of dying in the first five seconds."
msgstr "　それだけで逃げだす一歩手前なのに、五秒後の<脳内予測|シミュレート>では、十戦して二回も倒れる自分の姿。"

#. Occurrence 5A_8:1531:5196: scene=5A_8
#: 5A_8:1531
msgctxt "text_id=5196 | speaker=unknown"
msgid "  ...Twenty percent. At times, her predictions were harsher than reality."
msgstr "　……二回。彼女の予測は時に現実よりも現実的だ。"

#. Occurrence 5A_8:1537:5197: scene=5A_8
#: 5A_8:1537
msgctxt "text_id=5197 | speaker=unknown"
msgid "  If Aoko fought the puppet ten times, she would die twice. She could not stop herself from visualizing her own corpse."
msgstr "　……十回やって、二回。イメージに留まらない、あまりに<真実|リアル>な自分の亡骸たちを幻視する。"

#. Occurrence 5A_8:1558:5198: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0006; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:1558
msgctxt "text_id=5198 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――、っ」"

#. Occurrence 5A_8:1564:5199: scene=5A_8
#: 5A_8:1564
msgctxt "text_id=5199 | speaker=unknown"
msgid "  She imagined herself collapsing, crumpling under the puppet's curse."
msgstr "　人形の呪いを受けて倒れている自分。"

#. Occurrence 5A_8:1570:5200: scene=5A_8
#: 5A_8:1570
msgctxt "text_id=5200 | speaker=unknown"
msgid "  Her eyeballs swollen like a blowfish, blood and other fluids oozing from every bodily orifice."
msgstr "　眼球は<河|フ><豚|グ>のようにこぼれかけ、<耳鼻口|みみはなくち>からだらしなく垂れる血小便。"

msgctxt "text_id=5201 | speaker=unknown"
msgid " One in five, one in five, one in five..."
msgstr "二回、二回、二回。"

msgctxt "text_id=5202 | speaker=unknown"
msgid " A one in ten chance of death was bad enough, but one in five!? It drove her crazy."
msgstr "一回だけでも耐えられないのに、二回も死ぬなんて、とても正気じゃいられない……！"

#. Occurrence 5A_8:1662:5203: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0007; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:1662
msgctxt "text_id=5203 | speaker=aoko"
msgid "\"...But...\""
msgstr "「―――、―――でも」"

#. Occurrence 5A_8:1668:5204: scene=5A_8
#: 5A_8:1668
msgctxt "text_id=5204 | speaker=unknown"
msgid "  Aoko forced down her heart as it tried to escape from her mouth."
msgstr "　ねじ曲がろうとする心を<抑|おさ>える。"

#. Occurrence 5A_8:1673:5205: scene=5A_8
#: 5A_8:1673
msgctxt "text_id=5205 | speaker=unknown"
msgid "  Taking in a deep breath, she peered at her own reflection."
msgstr "　青子は深呼吸をして、それがどうした、と鏡に映る自分を見つめ返した。"

#. Occurrence 5A_8:1762:5206: scene=5A_8
#: 5A_8:1762
msgctxt "text_id=5206 | speaker=unknown"
msgid "  She thought back to that white night, half a year ago."
msgstr "　―――半年前の、あの白い夜を思い出せ。"

#. Occurrence 5A_8:1767:5207: scene=5A_8
#: 5A_8:1767
msgctxt "text_id=5207 | speaker=unknown"
msgid "  This, she decided, was nothing compared to that."
msgstr "　この程度、ピンチでもなんでもない。"

#. Occurrence 5A_8:1772:5208: scene=5A_8
#: 5A_8:1772
msgctxt "text_id=5208 | speaker=unknown"
msgid "  Six months ago, at the Kuonji Estate..."
msgstr "　半年前の久遠寺の洋館。"

#. Occurrence 5A_8:1777:5209: scene=5A_8
#: 5A_8:1777
msgctxt "text_id=5209 | speaker=unknown"
msgid "  The hound of white roses, the Wandersnatch that appeared from within the thick fog, had killed Aoko a hundred times out of ten. "
msgstr "　深い霧に現れた<白薔薇|しろばら>の<猟犬|ワンダースナッチ>に、自分は十回中<百|・><回|・>は殺されたのではなかったか。"

#. Occurrence 5A_8:1836:5210: voice_id=C40_5A_8_0001_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:1836
msgctxt "text_id=5210 | speaker=unknown"
msgid "\"Mea anima immortalis. Autem mea futura necata sunt."
msgstr "“<Me|メア>a <ani|アニマ>ma <immorta|イムモルタリス>lis. <Aute|アウテム>m <me|メア>a <futu|フトゥラ>ra <nec|ネカタ>ata <sunt|スントゥ>."

#. Occurrence 5A_8:1836:5211: voice_id=C40_5A_8_0001_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:1836
msgctxt "text_id=5211 | speaker=unknown"
msgid "  Manes sum. Animam definire ambiguum est.\""
msgstr "　<Man|マネス>es <su|スム>m. <Anim|アニマム>am <defin|デフィニレ>ire <ambigu|アンビグウム>um <est.|エストゥ>”"

#. Occurrence 5A_8:1856:5212: scene=5A_8
#: 5A_8:1856
msgctxt "text_id=5212 | speaker=unknown"
msgid "  A dark curse shattered Aoko's daydream."
msgstr "　青子の錯覚は、その<昏|くら>い呪詛によってかき消えた。"

#. Occurrence 5A_8:1856:5213: scene=5A_8
#: 5A_8:1856
msgctxt "text_id=5213 | speaker=unknown"
msgid "  It was only thirty feet away."
msgstr "　距離にして約十メートル。"

#. Occurrence 5A_8:1861:5214: scene=5A_8
#: 5A_8:1861
msgctxt "text_id=5214 | speaker=unknown"
msgid "  The puppet rounded the corner."
msgstr "　対面の曲がり角に少女の人形が現れる。"

#. Occurrence 5A_8:1866:5215: scene=5A_8
#: 5A_8:1866
msgctxt "text_id=5215 | speaker=unknown"
msgid "  Either side stood in the shadows, their forms indistinct."
msgstr "　お互い、<輪郭|りんかく>もはっきりしない影の間合い。"

#. Occurrence 5A_8:2032:5216: scene=5A_8
#: 5A_8:2032
msgctxt "text_id=5216 | speaker=unknown"
msgid "  The puppet gave no warning."
msgstr "　人形には前口上も初動もない。"

#. Occurrence 5A_8:2037:5217: scene=5A_8
#: 5A_8:2037
msgctxt "text_id=5217 | speaker=unknown"
msgid "  Without preamble, it swiftly fired a Gandr barrage."
msgstr "　気配の起こりもなく撃ち出される<呪詛|ガンド>を、"

#. Occurrence 5A_8:2146:5218: scene=5A_8
#: 5A_8:2146
msgctxt "text_id=5218 | speaker=unknown"
msgid "  Just as Aoko planned, the curses fizzled out as they hit her mist-like barrier of magical energy."
msgstr "　青子は予測通り、魔力の霧で<削|けず>り<防|ふせ>ぐ。"

#. Occurrence 5A_8:2306:5219: scene=5A_8
#: 5A_8:2306
msgctxt "text_id=5219 | speaker=unknown"
msgid "  The protection would only last a few seconds."
msgstr "　わずか数秒の濃霧。"

#. Occurrence 5A_8:2311:5220: scene=5A_8
#: 5A_8:2311
msgctxt "text_id=5220 | speaker=unknown"
msgid "  Giving her just enough time to..."
msgstr "　その隙をついて、"

#. Occurrence 5A_8:2356:5221: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0008; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:2356
msgctxt "text_id=5221 | speaker=aoko"
msgid "(...Come on!)"
msgstr "“―――来い！”"

#. Occurrence 5A_8:2362:5222: scene=5A_8
#: 5A_8:2362
msgctxt "text_id=5222 | speaker=unknown"
msgid "  Its stretchable spear sprang toward Aoko's face!"
msgstr "　伸縮する槍が、青子の顔へ撃ちだされる！"

#. Occurrence 5A_8:2515:5223: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0009; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:2515
msgctxt "text_id=5223 | speaker=aoko"
msgid "\"Bingo!\""
msgstr "「っ、ビンゴ―――！」"

#. Occurrence 5A_8:2557:5224: scene=5A_8
#: 5A_8:2557
msgctxt "text_id=5224 | speaker=unknown"
msgid "  The lethal weapon grazed her cheek."
msgstr "　横顔をかすめる凶器。"

#. Occurrence 5A_8:2562:5225: scene=5A_8
#: 5A_8:2562
msgctxt "text_id=5225 | speaker=unknown"
msgid "  All her experience analyzing puppet attack patterns gave her the wherewithal to evade the attack by a hair's breadth."
msgstr "　死角からの攻撃を紙一重で<躱|かわ>せたのは、人形の攻撃パターンを既に経験していたからだ。"

#. Occurrence 5A_8:2613:5226: scene=5A_8
#: 5A_8:2613
msgctxt "text_id=5226 | speaker=unknown"
msgid "  It was one thing if a puppeteer were pulling the strings, but autonomous dolls had their limitations."
msgstr "　術者が操っているのならともかく、自律している自動人形の機能は限られている。"

#. Occurrence 5A_8:2618:5227: scene=5A_8
#: 5A_8:2618
msgctxt "text_id=5227 | speaker=unknown"
msgid "  Aoko had bet everything on this killing machine following a predefined template. The puppet would use a given attack for a given range, and she could adjust her tactics to that."
msgstr "　この距離ならこの攻撃、といったテンプレートを行うだけの殺戮機巧なら対応できると、青子は己の運に賭けたのだ。"

#. Occurrence 5A_8:2742:5228: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0010; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:2742
msgctxt "text_id=5228 | speaker=aoko"
msgid "(Now's my chance!)"
msgstr "“いける、このまま―――！”"

#. Occurrence 5A_8:2748:5229: scene=5A_8
#: 5A_8:2748
msgctxt "text_id=5229 | speaker=unknown"
msgid "  Before its arm had a chance to fully retract, she charged the puppet."
msgstr "　伸びきった腕が巻き戻る前に、人形へ突撃する。"

#. Occurrence 5A_8:2753:5230: scene=5A_8
#: 5A_8:2753
msgctxt "text_id=5230 | speaker=unknown"
msgid "  It was a risky gamble, but her overall chances were slim to begin with."
msgstr "　勝算の薄い賭けではあったが、ともかく<勝機|しょうき>はもぎ取った。"

#. Occurrence 5A_8:2758:5231: scene=5A_8
#: 5A_8:2758
msgctxt "text_id=5231 | speaker=unknown"
msgid "  The scales tipped in her favor."
msgstr "　勝利の天秤は青子に<傾|かたむ>いた。"

#. Occurrence 5A_8:2866:5232: scene=5A_8
#: 5A_8:2866
msgctxt "text_id=5232 | speaker=unknown"
msgid "  If her predictions were correct, there were two ways she would die. One was from a Finn Shot fired at that range."
msgstr "　予測による十回中二回の死は、あの間合いでフィンの一撃を使われた場合と。"

#. Occurrence 5A_8:3046:5233: scene=5A_8
#: 5A_8:3046
msgctxt "text_id=5233 | speaker=unknown"
msgid "  And the other..."
msgstr "　このように。"

#. Occurrence 5A_8:3051:5234: scene=5A_8
#: 5A_8:3051
msgctxt "text_id=5234 | speaker=unknown"
msgid "  The other was if the puppet's attack pattern was beyond her ability to foresee."
msgstr "　人形の攻撃パターンが、彼女の予想を大きく上まわった場合である。"

#. Occurrence 5A_8:3072:5235: scene=5A_8
#: 5A_8:3072
msgctxt "text_id=5235 | speaker=unknown"
msgid "  Instantaneous mass transfer."
msgstr "　一瞬の質量移動。"

#. Occurrence 5A_8:3078:5236: scene=5A_8
#: 5A_8:3078
msgctxt "text_id=5236 | speaker=unknown"
msgid "Otherwise known as mass displacement."
msgstr "あるいは<積載|せきさい>。"

#. Occurrence 5A_8:3084:5237: scene=5A_8
#: 5A_8:3084
msgctxt "text_id=5237 | speaker=unknown"
msgid "  Immediately after Aoko dodged the puppet's arm,"
msgstr "　青子が人形の腕という槍を<躱|かわ>した直後、"

#. Occurrence 5A_8:3089:5238: scene=5A_8
#: 5A_8:3089
msgctxt "text_id=5238 | speaker=unknown"
msgid "  something smashed into her abdomen."
msgstr "　正体不明の重量が、彼女の腹部に激突していた。"

#. Occurrence 5A_8:3196:5239: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0011; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:3196
msgctxt "text_id=5239 | speaker=aoko"
msgid "\"GAH!\""
msgstr "「ご、ぶっ……！」"

#. Occurrence 5A_8:3202:5240: scene=5A_8
#: 5A_8:3202
msgctxt "text_id=5240 | speaker=unknown"
msgid "  The head-on collision from its shoulder felt like a rocket."
msgstr "　ロケットで撃ち出されたとしか思えない、肩口からの正面衝突。"

#. Occurrence 5A_8:3207:5241: scene=5A_8
#: 5A_8:3207
msgctxt "text_id=5241 | speaker=unknown"
msgid "  But where had the ability to propel itself come from?"
msgstr "　しかし、その推進力は何処から出たものなのか。"

#. Occurrence 5A_8:3212:5242: scene=5A_8
#: 5A_8:3212
msgctxt "text_id=5242 | speaker=unknown"
msgid "  Puppets like this were not built to have the ability to jet around like that."
msgstr "　自らを飛ばす機能なぞ、あの人形は持ち合わせていないというのに……！"

#. Occurrence 5A_8:3260:5243: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0012; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:3260
msgctxt "text_id=5243 | speaker=aoko"
msgid "\"Hah... hah...\""
msgstr "“は―――、は―――！”"

#. Occurrence 5A_8:3265:5244: scene=5A_8
#: 5A_8:3265
msgctxt "text_id=5244 | speaker=unknown"
msgid "  Doing everything in her power to stay conscious in spite of the pain, Aoko could just make out what had happened."
msgstr "　激痛で<薄|うす>れかける意識を<留|とど>めながら、青子は即座に攻撃の正体を看破した。"

#. Occurrence 5A_8:3272:5245: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0013; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:3272
msgctxt "text_id=5245 | speaker=aoko"
msgid "(It wasn't propelled, it was pulled!)"
msgstr "“今の、<推進力|すいしんりょく>じゃなくて、<牽引力|けんいんりょく>……！”"

#. Occurrence 5A_8:3278:5246: scene=5A_8
#: 5A_8:3278
msgctxt "text_id=5246 | speaker=unknown"
msgid "  Yes. The puppet's arm had not returned to its body. It was lodged in the wall and reeled itself in from the other direction."
msgstr "　そう。人形の腕は本体に戻るのではなく、壁に突き刺さったまま、本体を<引|・><き|・><寄|・><せ|・><た|・>のだ……！"

#. Occurrence 5A_8:3307:5247: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0014; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:3307
msgctxt "text_id=5247 | speaker=aoko"
msgid "(It... it can do that?!)"
msgstr "“そ、そんなのアリか―――！？”"

#. Occurrence 5A_8:3313:5248: scene=5A_8
#: 5A_8:3313
msgctxt "text_id=5248 | speaker=unknown"
msgid "  Swallowing her surprise, she hastily pulled herself back up."
msgstr "　青子は驚きを飲み下しながら、必死に体勢を立て直す。"

#. Occurrence 5A_8:3392:5249: scene=5A_8
#: 5A_8:3392
msgctxt "text_id=5249 | speaker=unknown"
msgid "  Her abdomen, specifically her diaphragm, had been dealt a significant blow."
msgstr "　腹部、<横隔膜|おうかくまく>を強打された。"

#. Occurrence 5A_8:3399:5250: scene=5A_8
#: 5A_8:3399
msgctxt "text_id=5250 | speaker=unknown"
msgid "The attack left her disoriented."
msgstr "衝撃で目も<眩|くら>んでいる。"

#. Occurrence 5A_8:3406:5251: scene=5A_8
#: 5A_8:3406
msgctxt "text_id=5251 | speaker=unknown"
msgid "Thankfully, the puppet was surprisingly lightweight."
msgstr "だが人形は驚くほど軽い。"

#. Occurrence 5A_8:3413:5252: scene=5A_8
#: 5A_8:3413
msgctxt "text_id=5252 | speaker=unknown"
msgid "Her bones and organs were intact, and she had sustained no life-threatening damage. She was having a hard time breathing, however."
msgstr "おかげで骨にも内臓にも深刻なダメージはないが、とにかく呼吸ができない。"

#. Occurrence 5A_8:3420:5253: scene=5A_8
#: 5A_8:3420
msgctxt "text_id=5253 | speaker=unknown"
msgid "She was shaken, though she managed to keep her calm. In another two seconds, she'd be back on her feet―no, that was two seconds too long!"
msgstr "気は動転しているけど根っこの部分ではまだ冷静だ、あと二秒もあれば持ち直す。いや違う、マトモになるまであと二秒もかかってしまう！"

#. Occurrence 5A_8:3440:5254: scene=5A_8
#: 5A_8:3440
msgctxt "text_id=5254 | speaker=unknown"
msgid "  She told herself to calm down, that she was already calm. She'd only briefly lost her bearings, she was fine, she could recover her breath and her vision later if only her body would MOVE―"
msgstr "　いやいや落ち着け、もう落ち着いている、クラクラして位置関係が把握できないだけ、いい、今は呼吸も視力も後回しで、とにかく体を―――"

#. Occurrence 5A_8:3462:5255: voice_id=C40_5A_8_0002_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:3462
msgctxt "text_id=5255 | speaker=unknown"
msgid "\"Intellectus non necessarius est. Pius quiescat.^ O nostra essentia ablata fuit,^ratio fixa tantum est.^ Doloris initium cerebrum fuit.\""
msgstr "“<知性は不必要でした|インテルレクトゥス・ノン・ネケススァリウス・エストゥ>。<敬虔さは重荷でした|ピウス・クウィエスカトゥ>。<ああ、私たち|オ・ノストゥラ><の本質は奪い合いで|エススェンティア・アブラタ・フイトゥ>、<理性は全て後付けでした|ラティオ・フィクサァ・タントゥム・エストゥ>。<苦しみのも|ドロリス・イニティウム><とは、脳髄でした|ケレブルム・フイトゥ>”"

#. Occurrence 5A_8:3468:5256: scene=5A_8
#: 5A_8:3468
msgctxt "text_id=5256 | speaker=unknown"
msgid "  Above her Aoko could hear the warped noise of a powerful force."
msgstr "　頭上には<歪|ゆが>みをあげる駆動音。"

#. Occurrence 5A_8:3475:5257: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0015; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:3475
msgctxt "text_id=5257 | speaker=aoko"
msgid "(Come on legs, move! We've got to get to... to... Where!?)"
msgstr "“足、動け……！　でもどっち、どっちにいけば―――”"

#. Occurrence 5A_8:3560:5258: scene=5A_8
#: 5A_8:3560
msgctxt "text_id=5258 | speaker=unknown"
msgid "  She could once more feel the touch of death."
msgstr "　死の手触りがする。"

#. Occurrence 5A_8:3567:5259: voice_id=C40_5A_8_0003_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:3567
msgctxt "text_id=5259 | speaker=unknown"
msgid "\"<Grant us salvation.|Iis salvatio.> <Grant us salvation.|Iis salvatio.> <Grant us salvation.|Iis salvatio.>\""
msgstr "“<我々に救罪を|イィス・サルヴェティオ>。<我々に救罪を|イィス・サルヴェティオ>。<我々に救罪を|イィス・サルヴェティオ>。”"

#. Occurrence 5A_8:3573:5260: scene=5A_8
#: 5A_8:3573
msgctxt "text_id=5260 | speaker=unknown"
msgid "  The puppet was so close that Aoko could reach out and touch it."
msgstr "　手を伸ばせば届く距離、"

#. Occurrence 5A_8:3578:5261: scene=5A_8
#: 5A_8:3578
msgctxt "text_id=5261 | speaker=unknown"
msgid "  That also meant that it could reach out and kill Aoko."
msgstr "　手を下ろされば殺される距離にお互いがいて、"

#. Occurrence 5A_8:3585:5262: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0016; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:3585
msgctxt "text_id=5262 | speaker=aoko"
msgid "(I need to get my right arm into its blind spot!)"
msgstr "“―――コイツの、右腕の死角に入れる……！”"

#. Occurrence 5A_8:3669:5263: scene=5A_8
#: 5A_8:3669
msgctxt "text_id=5263 | speaker=unknown"
msgid "  By intuition alone Aoko rolled over to the puppet's right flank."
msgstr "　青子は<勘|カン>だけで人形の右側に転がりでた。"

#. Occurrence 5A_8:3674:5264: scene=5A_8
#: 5A_8:3674
msgctxt "text_id=5264 | speaker=unknown"
msgid "  Its arm was still embedded within the wall."
msgstr "　人形の右腕は壁に刺さったままだ。"

#. Occurrence 5A_8:3679:5265: scene=5A_8
#: 5A_8:3679
msgctxt "text_id=5265 | speaker=unknown"
msgid "  From here it could not attack. She had made the right decision, and her dizziness faded."
msgstr "　必然、そちらからの攻撃はない。判断は正しく、一時的な<目眩|めまい>も消えた。"

#. Occurrence 5A_8:3733:5266: voice_id=C40_5A_8_0004_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:3733
msgctxt "text_id=5266 | speaker=unknown"
msgid "                      \"<Intellectus non necessarius est. Pius quiescat|Cast off righteousness. Lay piety to rest.>."
msgstr "　“<Intellectus non necessarius est. Pius quiescat|正しさは脱ぎ捨てなさい。敬虔はお休みなさい。>."

#. Occurrence 5A_8:3733:5267: voice_id=C40_5A_8_0004_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:3733
msgctxt "text_id=5267 | speaker=unknown"
msgid "                                  <  O nostra essentia ablata fuit|We beasts are meant to consume each other. Life is but a decoration.>,"
msgstr "　　　　　　<O nostra essentia ablata fuit|私たちは食み合う獣、その生はすべて装飾。>,"

#. Occurrence 5A_8:3733:5268: voice_id=C40_5A_8_0004_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:3733
msgctxt "text_id=5268 | speaker=unknown"
msgid "                    <ratio fixa tantum est. Doloris initium cerebrum fuit.|Throw away your intellect. Pain powers the mind.>\""
msgstr "<　ratio fixa tantum est. Doloris initium cerebrum fuit|であれ知性のすべてをブチまけて―――>”"

#. Occurrence 5A_8:3753:5269: scene=5A_8
#: 5A_8:3753
msgctxt "text_id=5269 | speaker=unknown"
msgid "  Aoko pulled herself back up. It was her turn."
msgstr "　転がる体を立て直し、今度はこちらの番と顔を上げる青子。"

#. Occurrence 5A_8:3773:5270: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0017; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:3773
msgctxt "text_id=5270 | speaker=aoko"
msgid "(What...?)"
msgstr "“え―――？”"

#. Occurrence 5A_8:3812:5271: scene=5A_8
#: 5A_8:3812
msgctxt "text_id=5271 | speaker=unknown"
msgid "  It was only an instant."
msgstr "　瞬間。"

#. Occurrence 5A_8:3818:5272: scene=5A_8
#: 5A_8:3818
msgctxt "text_id=5272 | speaker=unknown"
msgid "Within this labyrinth of mirrors she saw an image of herself."
msgstr "鏡の迷路の中で、彼女は、自分と同じ<像|すがた>を見た。"

#. Occurrence 5A_8:3860:5273: voice_id=C40_5A_8_0005_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:3860
msgctxt "text_id=5273 | speaker=unknown"
msgid "                                          "
msgstr "　　　　　　　"

msgctxt "text_id=5274 | speaker=unknown"
msgid "\"<We die.|Iis salvatio>...\""
msgstr "“「ワレ<ラ、死セリ|Iis salvatio>―――」”"

#. Occurrence 5A_8:4170:5275: scene=5A_8
#: 5A_8:4170
msgctxt "text_id=5275 | speaker=unknown"
msgid "  A blinding, brilliant light flashed."
msgstr "　ひときわ鮮烈な光。"

#. Occurrence 5A_8:4175:5276: scene=5A_8
#: 5A_8:4175
msgctxt "text_id=5276 | speaker=unknown"
msgid "  Lacerations appeared across the walls."
msgstr "　壁に刻まれていく爪痕じみた裂傷。"

#. Occurrence 5A_8:4180:5277: scene=5A_8
#: 5A_8:4180
msgctxt "text_id=5277 | speaker=unknown"
msgid "  At the last moment, Aoko managed to thicken the magical energy running through her veins into a primitive form of magecraft resistance. It just barely saved her life from what must have been the puppet's ace in the hole."
msgstr "　人形の切札だろう一撃を、青子は体内を走る<血液|まりょく>の濃度をあげる原始的な対魔術で、かろうじて致死手前で踏みとどまった。"

#. Occurrence 5A_8:4274:5278: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0018; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:4274
msgctxt "text_id=5278 | speaker=aoko"
msgid "\"Why you...!\""
msgstr "「っ、こ、の…………！」"

#. Occurrence 5A_8:4280:5279: scene=5A_8
#: 5A_8:4280
msgctxt "text_id=5279 | speaker=unknown"
msgid "  The puppet bore a striking resemblance to Aoko."
msgstr "　自分そっくりの人形。"

#. Occurrence 5A_8:4285:5280: scene=5A_8
#: 5A_8:4285
msgctxt "text_id=5280 | speaker=unknown"
msgid "  This powerful curse was not satisfied with stopping Aoko's heart, but destroying her entire being."
msgstr "　心臓を止めるだけではあきたらず、物質さえ<損傷|しめつ>させる強力な呪詛。"

#. Occurrence 5A_8:4290:5281: scene=5A_8
#: 5A_8:4290
msgctxt "text_id=5281 | speaker=unknown"
msgid "  Aoko did not even have the time to be shocked."
msgstr "　どちらも目を見張る異常さだが、<呆|ほう>けている暇はない。"

#. Occurrence 5A_8:4368:5282: scene=5A_8
#: 5A_8:4368
msgctxt "text_id=5282 | speaker=unknown"
msgid "  This was her chance for a counter-attack."
msgstr "　今度こそ反撃のチャンス。"

#. Occurrence 5A_8:4373:5283: scene=5A_8
#: 5A_8:4373
msgctxt "text_id=5283 | speaker=unknown"
msgid "  The puppet's balance was unsteady, its right arm still embedded in the wall."
msgstr "　右腕を壁に突き刺したままの人形はバランスが悪い。"

#. Occurrence 5A_8:4413:5284: scene=5A_8
#: 5A_8:4413
msgctxt "text_id=5284 | speaker=unknown"
msgid "  Aoko prepared to give its defenseless body a strong kick, but her knees buckled and she collapsed into a heap on the floor."
msgstr "　その無防備な体を蹴り上げようとして、しかし、青子は膝から床に倒れこんだ。"

#. Occurrence 5A_8:4438:5285: voice_id=C40_5A_8_0006_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:4438
msgctxt "text_id=5285 | speaker=unknown"
msgid "                \"<Vivo in somno. Solitarie putresco in inferis|In slumber, I live. In dirt, I rot, alone>."
msgstr "　　 “<Vivo in somno. Solitarie putresco in inferis|私は眠りの中で生きている。ひとりきりで土の中で腐っていく。>."

#. Occurrence 5A_8:4438:5286: voice_id=C40_5A_8_0006_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:4438
msgctxt "text_id=5286 | speaker=unknown"
msgid "          <Hic dies meus obitus dies, et meus nativus dies. Te obeam.|Today is the day I died and was born. I come to you.>\""
msgstr "@o<Hic dies meus obitus dies, et meus nativus dies. Te obeam.|今日は私の命日であり、誕生日だ。さあ、貴方に会いに行こう。>”"

#. Occurrence 5A_8:4507:5287: scene=5A_8
#: 5A_8:4507
msgctxt "text_id=5287 | speaker=unknown"
msgid "  A sudden nausea and light-headedness overcame Aoko."
msgstr "　急激な吐き気と貧血。"

#. Occurrence 5A_8:4512:5288: scene=5A_8
#: 5A_8:4512
msgctxt "text_id=5288 | speaker=unknown"
msgid "  Her body temperature began to rapidly lower."
msgstr "　嘘のように低下していく体温。"

#. Occurrence 5A_8:4518:5289: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0019; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:4518
msgctxt "text_id=5289 | speaker=aoko"
msgid "(This... whole... time... It was spreading its curses the whole time!)"
msgstr "“しまっ……こいつ、呪いをばらまいてるんだった……！”"

#. Occurrence 5A_8:4523:5290: scene=5A_8
#: 5A_8:4523
msgctxt "text_id=5290 | speaker=unknown"
msgid "  She noticed too late."
msgstr "　気付いた時には遅かった。"

#. Occurrence 5A_8:4528:5291: scene=5A_8
#: 5A_8:4528
msgctxt "text_id=5291 | speaker=unknown"
msgid "  The puppet's curses circled the hall."
msgstr "　人形の周囲には呪詛が渦巻いている。"

#. Occurrence 5A_8:4533:5292: scene=5A_8
#: 5A_8:4533
msgctxt "text_id=5292 | speaker=unknown"
msgid "  The cursed chant that the puppet used as a source of power doubled as a defense mechanism, crippling those who drew near with illness."
msgstr "　人形の動力源である呪いの詩は、近寄る者に病をもたらす防衛機巧にもなっている。"

#. Occurrence 5A_8:4569:5293: scene=5A_8
#: 5A_8:4569
msgctxt "text_id=5293 | speaker=unknown"
msgid "  She bore the full brunt the entire time she was in close proximity to it."
msgstr "　それをこんな間近で受け続けた。"

#. Occurrence 5A_8:4574:5294: scene=5A_8
#: 5A_8:4574
msgctxt "text_id=5294 | speaker=unknown"
msgid "  Although Aoko had Magic Circuits, she was succumbing just as Soujyuro had."
msgstr "　魔術回路を持つ青子といえど、草十郎のように体調を崩してしまう。"

#. Occurrence 5A_8:4579:5295: scene=5A_8
#: 5A_8:4579
msgctxt "text_id=5295 | speaker=unknown"
msgid "  Languidly, she forced her deteriorating body to jump back."
msgstr "　<気怠|けだる>く、倒れこみそうな体に鞭を打って、青子は人形から跳び退いた。"

#. Occurrence 5A_8:4627:5296: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0020; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:4627
msgctxt "text_id=5296 | speaker=aoko"
msgid "\"I'm not done yet!\""
msgstr "「っ、負けるかぁ……！」"

#. Occurrence 5A_8:4633:5297: scene=5A_8
#: 5A_8:4633
msgctxt "text_id=5297 | speaker=unknown"
msgid "  With all the energy she could muster, she forced her way past the exhaustion caused by the curse."
msgstr "　気合いで呪詛の気怠さから逃れる。"

#. Occurrence 5A_8:4710:5298: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0021; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:4710
msgctxt "text_id=5298 | speaker=aoko"
msgid "\"...Ah.\""
msgstr "「――――――、ぁ」"

#. Occurrence 5A_8:4716:5299: scene=5A_8
#: 5A_8:4716
msgctxt "text_id=5299 | speaker=unknown"
msgid "  However, Aoko's blood pressure took a steep nose dive, not from the curse-induced anemia, but from what appeared in front of her."
msgstr "　だが。呪いによる貧血ではなく、自らの窮地にざあ、と青子の血圧が低下する。"

#. Occurrence 5A_8:4721:5300: scene=5A_8
#: 5A_8:4721
msgctxt "text_id=5300 | speaker=unknown"
msgid "  They stood in perfect harmony."
msgstr "　絶好の位置関係。"

#. Occurrence 5A_8:4726:5301: scene=5A_8
#: 5A_8:4726
msgctxt "text_id=5301 | speaker=unknown"
msgid "  In front of Aoko was the automata that shared her face, its left arm held out like an arrow."
msgstr "　跳び退いた青子の前には、左腕を矢のように差し出す、自分と同じ顔をした自動人形。"

#. Occurrence 5A_8:4819:5302: scene=5A_8
#: 5A_8:4819
msgctxt "text_id=5302 | speaker=unknown"
msgid "  The deadly weapon shot forward and honed in on her heart."
msgstr "　……凶器は寸分違わず、青子の心臓へと撃ちだされた。"

#. Occurrence 5A_8:4893:5303: scene=5A_8
#: 5A_8:4893
msgctxt "text_id=5303 | speaker=unknown"
msgid "  Then, a moment before it made contact..."
msgstr "　ただ、そのちょっと前。"

#. Occurrence 5A_8:4900:5304: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_8_0000; voice_prefix=A30; voice_category=3; scene=5A_8
#: 5A_8:4900
msgctxt "text_id=5304 | speaker=soujuurou"
msgid "\"Watch out!\""
msgstr "「危ない」"

#. Occurrence 5A_8:4977:5305: scene=5A_8
#: 5A_8:4977
msgctxt "text_id=5305 | speaker=unknown"
msgid "  The moment she heard that fearless voice, completely out of place in this storm of violence, Aoko's body was pulled forcefully to one side."
msgstr "　なんて、まったく危機感のない声がしたかと思うと、青子の体はぐいっと横に引っ張られていた。"

#. Occurrence 5A_8:5030:5306: scene=5A_8
#: 5A_8:5030
msgctxt "text_id=5306 | speaker=unknown"
msgid "  Once again, the extending arm cut through empty air."
msgstr "　伸びる腕はまたも<虚空|こくう>を<掠|かす>めていく。"

#. Occurrence 5A_8:5036:5307: scene=5A_8
#: 5A_8:5036
msgctxt "text_id=5307 | speaker=unknown"
msgid "  While the puppet quickly retracted its left arm, Soujyuro took the brief opportunity to take Aoko by the hand and flee at full speed."
msgstr "　人形は急いで腕を巻き戻すが、彼はその隙にと青子の手を取って、一目散に走りだしていた。"

#. Occurrence 5A_9:55:5308: scene=5A_9
#: 5A_9:55
msgctxt "text_id=5308 | speaker=unknown"
msgid "  Soujyuro ran through the corridor as fast as he could, only stopping when he had put enough distance between them and the puppet."
msgstr "　デタラメに通路を走り、人形から十分離れたところで、草十郎は足を止めてきりだした。"

#. Occurrence 5A_9:111:5309: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0000; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:111
msgctxt "text_id=5309 | speaker=soujuurou"
msgid "\"I was thinking and...\""
msgstr "「その、考えてみると」"

#. Occurrence 5A_9:147:5310: scene=5A_9
#: 5A_9:147
msgctxt "text_id=5310 | speaker=unknown"
msgid "  Though he had saved her, she looked angry rather than grateful."
msgstr "　助けたはずの相手はこの通り、目に見えてご立腹だ。"

#. Occurrence 5A_9:153:5311: scene=5A_9
#: 5A_9:153
msgctxt "text_id=5311 | speaker=unknown"
msgid "This did not keep Soujyuro from saying his piece."
msgstr "それでも彼は彼なりに考え抜いた、気の利いた<台詞|いいわけ>を口にする。"

#. Occurrence 5A_9:184:5312: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0001; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:184
msgctxt "text_id=5312 | speaker=soujuurou"
msgid "\"Tomorrow is going to be a really busy day for me, so...\""
msgstr "「明日は、どうも忙しいみたいなんだ」"

#. Occurrence 5A_9:190:5313: scene=5A_9
#: 5A_9:190
msgctxt "text_id=5313 | speaker=unknown"
msgid "  In other words, let's finish this today."
msgstr "“だから、用件は今日中に済ませてしまわないか？”"

#. Occurrence 5A_9:195:5314: scene=5A_9
#: 5A_9:195
msgctxt "text_id=5314 | speaker=unknown"
msgid "  A rather awkward proposal."
msgstr "　なんて続きそうな、場違いな提案を。"

#. Occurrence 5A_9:237:5315: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0000; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:237
msgctxt "text_id=5315 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5A_9:242:5316: scene=5A_9
#: 5A_9:242
msgctxt "text_id=5316 | speaker=unknown"
msgid "  Aoko remained silent."
msgstr "　青子は黙っている。"

#. Occurrence 5A_9:247:5317: scene=5A_9
#: 5A_9:247
msgctxt "text_id=5317 | speaker=unknown"
msgid "  She was also rather angry,"
msgstr "　ついでにかなり怒ってもいた。"

#. Occurrence 5A_9:252:5318: scene=5A_9
#: 5A_9:252
msgctxt "text_id=5318 | speaker=unknown"
msgid "  not that she could not figure out what made him tick,"
msgstr "　この男の精神構造が理解できないから、ではない。"

#. Occurrence 5A_9:257:5319: scene=5A_9
#: 5A_9:257
msgctxt "text_id=5319 | speaker=unknown"
msgid "  nor because he'd returned after escaping."
msgstr "　せっかく逃がしてやったのに戻ってきた事でもない。"

#. Occurrence 5A_9:262:5320: scene=5A_9
#: 5A_9:262
msgctxt "text_id=5320 | speaker=unknown"
msgid "  Not even because he was spouting his typically airheaded lines."
msgstr "　相変わらずの<間|ま><抜|ぬ>けな台詞に苛ついたからでもない。"

#. Occurrence 5A_9:322:5321: scene=5A_9
#: 5A_9:322
msgctxt "text_id=5321 | speaker=unknown"
msgid "  ...It was, she supposed, that instant."
msgstr "　……なんというか、あの一瞬。"

#. Occurrence 5A_9:327:5322: scene=5A_9
#: 5A_9:327
msgctxt "text_id=5322 | speaker=unknown"
msgid "  The fact that when he grabbed her hand, her mind had gone completely blank-Aoko found it unforgivable."
msgstr "　手を引かれた時、何も考えられなくなって<為|な>すがままになった事が、青子的に許せないらしい。"

#. Occurrence 5A_9:382:5323: scene=5A_9
#: 5A_9:382
msgctxt "text_id=5323 | speaker=unknown"
msgid "  Which beckoned the response..."
msgstr "　なので、"

#. Occurrence 5A_9:393:5324: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0001; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:393
msgctxt "text_id=5324 | speaker=aoko"
msgid "\"Are you insane?\""
msgstr "「貴方、正気？」"

#. Occurrence 5A_9:399:5325: scene=5A_9
#: 5A_9:399
msgctxt "text_id=5325 | speaker=unknown"
msgid "  In the heat of the moment, she blurted it before she could stop herself."
msgstr "　勢いで、つい、そんな言葉を口にしていた。"

#. Occurrence 5A_9:428:5326: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0002; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:428
msgctxt "text_id=5326 | speaker=aoko"
msgid "\"Or maybe you've got a death wish? Don't you realize that either of us could kill you with a snap of a finger?"
msgstr "「それとも自殺願望でもあったワケ？　私も<人形|アイツ>も、アンタなんか殺す対象にすぎないのよ。"

#. Occurrence 5A_9:434:5327: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0003; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:434
msgctxt "text_id=5327 | speaker=aoko"
msgid "  At the very least, I don't owe you a damn thing."
msgstr "　少なくとも恩を売る相手じゃない。"

#. Occurrence 5A_9:445:5328: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0004; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:445
msgctxt "text_id=5328 | speaker=aoko"
msgid "  Saving my life doesn't change a thing between us.\""
msgstr "　言っとくけど、私、助けられたぐらいで曲がる信念は持ち合わせていないから」"

#. Occurrence 5A_9:451:5329: scene=5A_9
#: 5A_9:451
msgctxt "text_id=5329 | speaker=unknown"
msgid "  Soujyuro nodded, clearly unperturbed."
msgstr "　だろうね、と頷く草十郎。"

#. Occurrence 5A_9:492:5330: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0002; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:492
msgctxt "text_id=5330 | speaker=soujuurou"
msgid "\"Don't worry, Aozaki. If tonight taught me anything, it's that you're more ruthless than that.\""
msgstr "「蒼崎がそんな可愛らしいもんじゃないのは、この夜だけで骨身にしみてるよ」"

#. Occurrence 5A_9:525:5331: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0005; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:525
msgctxt "text_id=5331 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5A_9:531:5332: scene=5A_9
#: 5A_9:531
msgctxt "text_id=5332 | speaker=unknown"
msgid "  She found herself slightly offended."
msgstr "　それはそれでちょっと不満な青子だった。"

#. Occurrence 5A_9:583:5333: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0003; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:583
msgctxt "text_id=5333 | speaker=soujuurou"
msgid "\"But I think you need to get one thing straight."
msgstr "「けど君は勘違いをしてるから、少し正そう。"

#. Occurrence 5A_9:589:5334: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0004; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:589
msgctxt "text_id=5334 | speaker=soujuurou"
msgid "  That thing isn't just trying to kill you. I think it's trying to kill me as well.\""
msgstr "　あいつの狙いは蒼崎だけじゃない。君だけじゃなく、俺も殺す気だと思う」"

#. Occurrence 5A_9:627:5335: scene=5A_9
#: 5A_9:627
msgctxt "text_id=5335 | speaker=unknown"
msgid "  She was having none of it."
msgstr "　それは嘘だ、と。"

#. Occurrence 5A_9:632:5336: scene=5A_9
#: 5A_9:632
msgctxt "text_id=5336 | speaker=unknown"
msgid "  Her eyes shot daggers his way."
msgstr "　視線をいっそう鋭くして、青子は草十郎を睨んだ。"

#. Occurrence 5A_9:676:5337: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0005; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:676
msgctxt "text_id=5337 | speaker=soujuurou"
msgid "\"And before you chew me out, you need to know something. Do you remember the first-floor entrance at the end of that long corridor?"
msgstr "「話は最後まで聞く。……どうしてかって言うと、一階の入り口あるだろ？　あの細長い通路。"

#. Occurrence 5A_9:691:5338: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0006; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:691
msgctxt "text_id=5338 | speaker=soujuurou"
msgid "  Well, it's blocked. I tried my best to find a way out, but no luck. There was no choice but to turn right back.\""
msgstr "　なんでかあそこから先に進めないんだ。逃げたくても逃げだせなくて、仕方なく戻ってきた」"

#. Occurrence 5A_9:727:5339: scene=5A_9
#: 5A_9:727
msgctxt "text_id=5339 | speaker=unknown"
msgid "  Aoko's eyes widened ever so slightly in amazement."
msgstr "　青子はわずかに目を見張った。"

#. Occurrence 5A_9:732:5340: scene=5A_9
#: 5A_9:732
msgctxt "text_id=5340 | speaker=unknown"
msgid "  She felt admiration, rather than shock, that her enemy would go to such lengths."
msgstr "　あり得ない、と驚いたのではなく、そこまでしていたか、という敵への称賛だ。"

#. Occurrence 5A_9:788:5341: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0007; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:788
msgctxt "text_id=5341 | speaker=soujuurou"
msgid "\"And besides, it was hostile to me too earlier. I could tell by how it was glaring at me."
msgstr "「それに、さっきので完全に敵扱いされた。あの人形、こっちをじろっと<睨|にら>んできたし。"

#. Occurrence 5A_9:808:5342: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0008; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:808
msgctxt "text_id=5342 | speaker=soujuurou"
msgid "  ...Well, it happened so fast that I didn't really get a good look at it, but it was really unsettling. You should be careful. That thing... she sure has a terrifying face.\""
msgstr "　……いや、一瞬でよく見えなかったけど、生きた心地しなかったな。蒼崎も気をつけた方がいい。たぶん、よっぽど怖い顔をしているに違いないぞ、<彼|ア><女|レ>」"

#. Occurrence 5A_9:878:5343: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0006; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:878
msgctxt "text_id=5343 | speaker=aoko"
msgid "\"...Gee, thanks.\""
msgstr "「―――それはご親切に、どうも」"

#. Occurrence 5A_9:906:5344: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0009; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:906
msgctxt "text_id=5344 | speaker=soujuurou"
msgid "\"You bet. I mean, I can't pretend like this isn't happening to me."
msgstr "「うん。なんで、これはもう他人事じゃないんだ。"

#. Occurrence 5A_9:912:5345: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0010; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:912
msgctxt "text_id=5345 | speaker=soujuurou"
msgid "  Whichever of you wins, I'm a dead man either way, right?\""
msgstr "　蒼崎と人形。結論として、どっちが勝っても俺は殺されてしまうんじゃないか？」"

#. Occurrence 5A_9:932:5346: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0007; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:932
msgctxt "text_id=5346 | speaker=aoko"
msgid "\"...I can't argue with that. If it's willing to go as far as to seal off the entrance, then it'd probably kill any witnesses as well. At least, that's what I'd do.\""
msgstr "「……そうね。そこまでやってるなら、目撃者は消すでしょうね。私みたいに」"

#. Occurrence 5A_9:975:5347: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0011; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:975
msgctxt "text_id=5347 | speaker=soujuurou"
msgid "\"Right? And I don't want her to be the one who kills me.\""
msgstr "「だろう。でも、俺はあいつには殺されたくない」"

#. Occurrence 5A_9:981:5348: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0008; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:981
msgctxt "text_id=5348 | speaker=aoko"
msgid "\"Wait, what?\""
msgstr "「え？」"

#. Occurrence 5A_9:1017:5349: scene=5A_9
#: 5A_9:1017
msgctxt "text_id=5349 | speaker=unknown"
msgid "  His words were decisive."
msgstr "　きっぱりと彼は断言した。"

#. Occurrence 5A_9:1022:5350: scene=5A_9
#: 5A_9:1022
msgctxt "text_id=5350 | speaker=unknown"
msgid "  As Aoko looked up at him, she could swear he was trying to encourage her."
msgstr "　まるで励ますような草十郎の言葉に、顔を上げる青子。"

#. Occurrence 5A_9:1028:5351: scene=5A_9
#: 5A_9:1028
msgctxt "text_id=5351 | speaker=unknown"
msgid "  It was then that she realized."
msgstr "　……そうして、ようやく気づいた。"

#. Occurrence 5A_9:1066:5352: scene=5A_9
#: 5A_9:1066
msgctxt "text_id=5352 | speaker=unknown"
msgid "  Soujyuro was looking even worse than before."
msgstr "　草十郎の顔色の悪さが、さっきより濃くなっている事に。"

#. Occurrence 5A_9:1096:5353: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0009; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1096
msgctxt "text_id=5353 | speaker=aoko"
msgid "\"Hey. Are you okay?\""
msgstr "「ちょっと待って。大丈夫なの、貴方？」"

#. Occurrence 5A_9:1111:5354: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0012; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:1111
msgctxt "text_id=5354 | speaker=soujuurou"
msgid "\"Well, I'm better than if I'd drunk an entire bottle of soy sauce.\""
msgstr "「……まあ、醤油を<一升瓶|いっしょうびん>飲むよりは、ましではないかと」"

#. Occurrence 5A_9:1117:5355: scene=5A_9
#: 5A_9:1117
msgctxt "text_id=5355 | speaker=unknown"
msgid "  He tried to make light of the situation, but his forehead was clearly drenched in sweat."
msgstr "　彼なりに場を<和|なご>ませようとした軽口だが、額に脂汗を浮かべられては余計に重い。"

#. Occurrence 5A_9:1171:5356: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0010; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1171
msgctxt "text_id=5356 | speaker=aoko"
msgid "(Right. It's because he was close to the puppet just now.)"
msgstr "“……そうか、さっき人形に近付いたから……”"

#. Occurrence 5A_9:1177:5357: scene=5A_9
#: 5A_9:1177
msgctxt "text_id=5357 | speaker=unknown"
msgid "  How could he possibly be able to withstand a curse that made even Aoko nauseous?"
msgstr "　青子ですら吐き気に襲われる呪いの圏内に入って、草十郎が平気である筈がない。"

#. Occurrence 5A_9:1189:5358: scene=5A_9
#: 5A_9:1189
msgctxt "text_id=5358 | speaker=unknown"
msgid "  She bit her lip, annoyed at herself for not noticing this earlier."
msgstr "　……自分の洞察力の低さに唇を噛む。"

#. Occurrence 5A_9:1194:5359: scene=5A_9
#: 5A_9:1194
msgctxt "text_id=5359 | speaker=unknown"
msgid "  Soujyuro was such an airhead that she hadn't even paused to consider his plight."
msgstr "　あんまりに彼がぼんやりしているから、そこに考えがいたらなかった。"

#. Occurrence 5A_9:1267:5360: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0011; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1267
msgctxt "text_id=5360 | speaker=aoko"
msgid "\"...Why didn't you consider trying to hide down in the basement?"
msgstr "「……下で隠れていようとか思わなかったの？"

#. Occurrence 5A_9:1267:5361: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0011; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1267
msgctxt "text_id=5361 | speaker=aoko"
msgid "  That would have been the safest bet, wouldn't it?\""
msgstr "　その方がどう考えても安全でしょ？」"

#. Occurrence 5A_9:1272:5362: scene=5A_9
#: 5A_9:1272
msgctxt "text_id=5362 | speaker=unknown"
msgid "  She really could not understand him at all."
msgstr "　ほんとうに分からない、と青子。"

#. Occurrence 5A_9:1287:5363: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0013; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:1287
msgctxt "text_id=5363 | speaker=soujuurou"
msgid "\"You should really take your own advice sometimes, Aozaki."
msgstr "「それは蒼崎が言う台詞じゃないな。"

#. Occurrence 5A_9:1337:5364: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0014; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:1337
msgctxt "text_id=5364 | speaker=soujuurou"
msgid "  ...But hey, this is no time to be chatting. She could catch up at any moment.\""
msgstr "　―――でもまあ、長話をしている時間もない。そろそろ追いついて来る頃だ」"

#. Occurrence 5A_9:1357:5365: scene=5A_9
#: 5A_9:1357
msgctxt "text_id=5365 | speaker=unknown"
msgid "  He turned to look down the corridor."
msgstr "　通路に視線を向ける草十郎。"

#. Occurrence 5A_9:1362:5366: scene=5A_9
#: 5A_9:1362
msgctxt "text_id=5366 | speaker=unknown"
msgid "  The crackling sounds of a music box could be heard creeping forth from the darkness."
msgstr "　……鏡張りの闇からは、ざらついたオルゴールが聞こえだしていた。"

#. Occurrence 5A_9:1394:5367: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0015; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:1394
msgctxt "text_id=5367 | speaker=soujuurou"
msgid "\"I was thinking about this while I was on the first floor earlier. If it kills you, I'm next. That's why we should deal with it first.\""
msgstr "「さっき一階にいて考えたんだ。君がやられても俺は殺される。なら、まずヤツをどうにかするべきだ」"

#. Occurrence 5A_9:1429:5368: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0012; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1429
msgctxt "text_id=5368 | speaker=aoko"
msgid "\"..."
msgstr "「…………………。"

#. Occurrence 5A_9:1442:5369: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0013; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1442
msgctxt "text_id=5369 | speaker=aoko"
msgid "  What are you getting at?\""
msgstr "　貴方、なにが言いたいの？」"

#. Occurrence 5A_9:1492:5370: scene=5A_9
#: 5A_9:1492
msgctxt "text_id=5370 | speaker=unknown"
msgid "  She asked a question to which she already knew the answer."
msgstr "　分かりきった事を、青子はあえて問いただした。"

#. Occurrence 5A_9:1497:5371: scene=5A_9
#: 5A_9:1497
msgctxt "text_id=5371 | speaker=unknown"
msgid "  She did it to put him to the test."
msgstr "　草十郎の決意の程を試すように。"

#. Occurrence 5A_9:1502:5372: scene=5A_9
#: 5A_9:1502
msgctxt "text_id=5372 | speaker=unknown"
msgid "  If he wavered even a little, she would have killed him where he stood."
msgstr "　その先を半端な気持ちで口にするのなら、やっぱり今ここで始末する、と見据えながら。"

#. Occurrence 5A_9:1545:5373: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0016; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:1545
msgctxt "text_id=5373 | speaker=soujuurou"
msgid "\"My proposal is if I agree to help you kill that thing, will you let me go?\""
msgstr "「提案。アイツをやっつけるのに協力したら、俺の事は見逃してくれる？」"

#. Occurrence 5A_9:1582:5374: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0014; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1582
msgctxt "text_id=5374 | speaker=aoko"
msgid "\"...I thought I'd made it clear that helping me wasn't going to change my mind."
msgstr "「……助けられたぐらいじゃ信念は曲げないって言ったでしょう。"

#. Occurrence 5A_9:1589:5375: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0015; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1589
msgctxt "text_id=5375 | speaker=aoko"
msgid "And besides, what do you think you're going to do to it, anyway?\""
msgstr "それに、貴方に何が出来るって言うの？」"

#. Occurrence 5A_9:1606:5376: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0017; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:1606
msgctxt "text_id=5376 | speaker=soujuurou"
msgid "\"Oh, that's your end of the bargain, Aozaki. This is your area of expertise, right?\""
msgstr "「それは蒼崎が考えてくれ。得意だろ、そういうの」"

#. Occurrence 5A_9:1655:5377: scene=5A_9
#: 5A_9:1655
msgctxt "text_id=5377 | speaker=unknown"
msgid "  The commander who had the overall picture was responsible for delegating roles to their teammates."
msgstr "　協力者を適材適所にふりわけるのは指揮者の役割だ。"

#. Occurrence 5A_9:1660:5378: scene=5A_9
#: 5A_9:1660
msgctxt "text_id=5378 | speaker=unknown"
msgid "  It was futile to depend on someone who was unable to grasp the situation or evaluate the enemy's strength. Soujyuro was proud to share that he knew this."
msgstr "　そもそもこの状況をまったく把握できず、また、自身と敵の差を理解できない人間に“何が出来るか”なんてコトを考えさせるのは間違っている、と草十郎は胸を張った。"

#. Occurrence 5A_9:1687:5379: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0016; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1687
msgctxt "text_id=5379 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5A_9:1692:5380: scene=5A_9
#: 5A_9:1692
msgctxt "text_id=5380 | speaker=unknown"
msgid "  He spoke the truth. Aoko was the only one who knew both Soujyuro and the automata."
msgstr "　彼の言う通り、草十郎を知り、自動人形を知っているのは蒼崎青子だけ。"

#. Occurrence 5A_9:1697:5381: scene=5A_9
#: 5A_9:1697
msgctxt "text_id=5381 | speaker=unknown"
msgid "  That was why he pointed out that following her orders to the best of his ability was the only thing he could do."
msgstr "　なので、青子の指示を全力でこなす事が“いまの自分に出来る事”だと彼は言った。"

#. Occurrence 5A_9:1702:5382: scene=5A_9
#: 5A_9:1702
msgctxt "text_id=5382 | speaker=unknown"
msgid "  It may have seemed as though Soujyuro had surrendered his capacity for self-thought, but in accepting that he was helpless, he was in fact giving Aoko his complete trust."
msgstr "　思考放棄に近いが、それでも、草十郎の提案は自分が無力である事を受け入れた末の、最大限の信頼に他ならない。"

#. Occurrence 5A_9:1737:5383: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0017; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1737
msgctxt "text_id=5383 | speaker=aoko"
msgid "\"Fine, then. So you'll do exactly what I tell you to do?\""
msgstr "「……。じゃあ、私の指示に百パーセント従うってこと？」"

#. Occurrence 5A_9:1750:5384: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0018; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:1750
msgctxt "text_id=5384 | speaker=soujuurou"
msgid "\"I will. And just so you know, I'm not doing this out of a sense of obligation or anything."
msgstr "「ああ。それに、これは恩とか義理の話じゃない。"

#. Occurrence 5A_9:1756:5385: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0019; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:1756
msgctxt "text_id=5385 | speaker=soujuurou"
msgid "  It's just obvious that neither of us had a chance on our own. This isn't goodwill or kindness. It's a... transaction.\""
msgstr "　ひとりだと分が悪いからふたりでかかるだけだ。善意でも厚意でもない。取引って言わないか、こういうの？」"

#. Occurrence 5A_9:1762:5386: scene=5A_9
#: 5A_9:1762
msgctxt "text_id=5386 | speaker=unknown"
msgid "  His eyes sparkled, as if this was bartering in its truest form."
msgstr "　信条的な物々交換だ、純朴な<瞳|め>が語っている。"

#. Occurrence 5A_9:1846:5387: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0018; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1846
msgctxt "text_id=5387 | speaker=aoko"
msgid "\"...Oh my god.\""
msgstr "「――――――まったく」"

#. Occurrence 5A_9:1852:5388: scene=5A_9
#: 5A_9:1852
msgctxt "text_id=5388 | speaker=unknown"
msgid "  This child must have learned that from Tobimaru, Aoko thought."
msgstr "　……この少年にそんな知恵をつけたのは鳶丸の阿呆に違いない。"

#. Occurrence 5A_9:1857:5389: scene=5A_9
#: 5A_9:1857
msgctxt "text_id=5389 | speaker=unknown"
msgid "  Though she refused to let him see it, she smiled inwardly."
msgstr "　決して口にはこぼさないが、青子は少しだけ笑いたくなった。"

#. Occurrence 5A_9:1863:5390: scene=5A_9
#: 5A_9:1863
msgctxt "text_id=5390 | speaker=unknown"
msgid "Sure, he had gotten the best of her just now, but there were times when defeat was not the worse outcome in the world."
msgstr "完全に一本とられたけど、なんというか、悔しくない敗北なんてものが、世の中にはあるらしい。"

#. Occurrence 5A_9:1890:5391: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0019; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1890
msgctxt "text_id=5391 | speaker=aoko"
msgid "\"Honest pay for honest work. Makes sense."
msgstr "「労働と報酬ってワケね。それなら理にかなってる。"

#. Occurrence 5A_9:1896:5392: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0020; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1896
msgctxt "text_id=5392 | speaker=aoko"
msgid "  And... I hate to admit it, but...\""
msgstr "　うん、言いたくないけど―――」"

#. Occurrence 5A_9:1929:5393: scene=5A_9
#: 5A_9:1929
msgctxt "text_id=5393 | speaker=unknown"
msgid "  She relaxed her shoulders and sighed."
msgstr "　少し間をおいて、やれやれ、と肩で息をする。"

#. Occurrence 5A_9:1934:5394: scene=5A_9
#: 5A_9:1934
msgctxt "text_id=5394 | speaker=unknown"
msgid "  Her face cracked into a wicked grin, as if her fears had suddenly washed away."
msgstr "　青子はふっきれたような、見ようによっては邪悪な笑みをうかべて、"

#. Occurrence 5A_9:1969:5395: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0021; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1969
msgctxt "text_id=5395 | speaker=aoko"
msgid "\"Your plan is just my style.\""
msgstr "「―――それ、けっこう私の好みよ」"

#. Occurrence 5A_9:1975:5396: scene=5A_9
#: 5A_9:1975
msgctxt "text_id=5396 | speaker=unknown"
msgid "  Aoko repaid Soujyuro's trust in equal measure."
msgstr "　彼が向けたのと同程度の信頼を、まっすぐに投げ返した。"

#. Occurrence 5B_1:78:5397: scene=5B_1
#: 5B_1:78
msgctxt "text_id=5397 | speaker=unknown"
msgid "  The melody stirred an emotion like nostalgia within them."
msgstr "　それは、彼らにとって<郷愁|きょうしゅう>に似た旋律だった。"

#. Occurrence 5B_1:83:5398: scene=5B_1
#: 5B_1:83
msgctxt "text_id=5398 | speaker=unknown"
msgid "  Something once familiar but now lost to this world."
msgstr "　かつてこの世界にありふれていたもの。"

#. Occurrence 5B_1:88:5399: scene=5B_1
#: 5B_1:88
msgctxt "text_id=5399 | speaker=unknown"
msgid "  They believed, beyond a shadow of a doubt, that it would play for all eternity."
msgstr "　物言わぬ彼らのすべてが、永遠に続くと信じて疑わなかったもの。"

#. Occurrence 5B_1:93:5400: scene=5B_1
#: 5B_1:93
msgctxt "text_id=5400 | speaker=unknown"
msgid "  From opening stanza to final coda,"
msgstr "　始まりに一度、終わりに一度。"

#. Occurrence 5B_1:98:5401: scene=5B_1
#: 5B_1:98
msgctxt "text_id=5401 | speaker=unknown"
msgid "  it was a mysterious siren's song, merry yet longing, that heralded a return from dreams to reality."
msgstr "　夢の開園と、現実への帰還を告げる、陽気で、どこか寂しくなる不思議な<音楽|サイレン>。"

#. Occurrence 5B_1:187:5402: scene=5B_1
#: 5B_1:187
msgctxt "text_id=5402 | speaker=unknown"
msgid "  The night shook."
msgstr "　夜が<響|ひび>く。"

#. Occurrence 5B_1:192:5403: scene=5B_1
#: 5B_1:192
msgctxt "text_id=5403 | speaker=unknown"
msgid "  A song was spun."
msgstr "　唄を<紡|つむ>ぐ。"

#. Occurrence 5B_1:197:5404: scene=5B_1
#: 5B_1:197
msgctxt "text_id=5404 | speaker=unknown"
msgid "  Now, their lost paradise was unearthed."
msgstr "　今は失われた彼らの楽園を掘り返す。"

#. Occurrence 5B_1:202:5405: scene=5B_1
#: 5B_1:202
msgctxt "text_id=5405 | speaker=unknown"
msgid "  Abandoned dreams..."
msgstr "　うち捨てられた多くの<夢路|ゆめじ>が、"

#. Occurrence 5B_1:207:5406: scene=5B_1
#: 5B_1:207
msgctxt "text_id=5406 | speaker=unknown"
msgid "  Forsaken idols..."
msgstr "　見放されたかつての偶像が、"

#. Occurrence 5B_1:212:5407: scene=5B_1
#: 5B_1:212
msgctxt "text_id=5407 | speaker=unknown"
msgid "  They all responded to the cry of the blue cat."
msgstr "　青猫の鳴き声に呼応する。"

#. Occurrence 5B_1:236:5408: scene=5B_1
#: 5B_1:236
msgctxt "text_id=5408 | speaker=unknown"
msgid "  ...The name of that bell was Diddle Diddle, Banquet of the Night."
msgstr "　―――その鐘の名は“<夜の饗宴|ディドルディドル>”"

#. Occurrence 5B_1:243:5409: scene=5B_1
#: 5B_1:243
msgctxt "text_id=5409 | speaker=unknown"
msgid "  All fables made possible,"
msgstr "　あらゆる寓話、"

msgctxt "text_id=5410 | speaker=unknown"
msgid "  all marvels made real,"
msgstr "　あらゆる不思議を許容する、"

msgctxt "text_id=5411 | speaker=unknown"
msgid "  by the magecraft of Alice Kuonji, more magical than magic itself."
msgstr "　魔法以上に魔法に近い、久遠寺有珠の魔術である。"

#. Occurrence 5B_1:460:5412: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0000; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:460
msgctxt "text_id=5412 | speaker=alice"
msgid "\"...How selfish of you."
msgstr "「……随分と身勝手ね。"

#. Occurrence 5B_1:466:5413: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0001; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:466
msgctxt "text_id=5413 | speaker=alice"
msgid "  Is that something you can really decide on your own, Aoko?\""
msgstr "　それは貴女ひとりで決めていい事だったかしら、青子？」"

#. Occurrence 5B_1:472:5414: scene=5B_1
#: 5B_1:472
msgctxt "text_id=5414 | speaker=unknown"
msgid "  Alice sat perched atop the clock tower like a black bird of ill omen."
msgstr "　少女は黒い<凶鳥|まがどり>のように時計台の上に降り立った。"

#. Occurrence 5B_1:477:5415: scene=5B_1
#: 5B_1:477
msgctxt "text_id=5415 | speaker=unknown"
msgid "  She smoothed the ruffles of her skirt as if she were preening. "
msgstr "　細い指は静かに、羽をつくろうように、<衣服|スカート>の乱れを直す。"

#. Occurrence 5B_1:502:5416: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0000; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:502
msgctxt "text_id=5416 | speaker=aoko"
msgid "\"...Alice.\""
msgstr "「―――有珠」"

#. Occurrence 5B_1:508:5417: scene=5B_1
#: 5B_1:508
msgctxt "text_id=5417 | speaker=unknown"
msgid "  There was tension in Aoko's voice as she lifted her head."
msgstr "　見上げる青子の声には<微|かす>かな緊張。"

#. Occurrence 5B_1:513:5418: scene=5B_1
#: 5B_1:513
msgctxt "text_id=5418 | speaker=unknown"
msgid "  The calm atmosphere from a moment prior had long since been shooed away by Alice's gaze."
msgstr "　……先ほどまでの穏やかな空気は、有珠の視線だけで霧散していた。"

#. Occurrence 5B_1:547:5419: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_1_0000; voice_prefix=A30; voice_category=3; scene=5B_1
#: 5B_1:547
msgctxt "text_id=5419 | speaker=soujuurou"
msgid "\"That girl... I've seen her somewhere before.\""
msgstr "“あの娘、たしか……”"

#. Occurrence 5B_1:552:5420: scene=5B_1
#: 5B_1:552
msgctxt "text_id=5420 | speaker=unknown"
msgid "  Soujyuro searched his hazy memory."
msgstr "　草十郎は曖昧な記憶を辿る。"

#. Occurrence 5B_1:563:5421: scene=5B_1
#: 5B_1:563
msgctxt "text_id=5421 | speaker=unknown"
msgid "  He could not clearly make out her face at this distance, but he was sure he had seen her around town a number of times."
msgstr "　遠くて顔ははっきりしないが、何度か町で見かけたかもしれない。"

#. Occurrence 5B_1:568:5422: scene=5B_1
#: 5B_1:568
msgctxt "text_id=5422 | speaker=unknown"
msgid "  Where and when eluded him, however, as the tension in the air kept him from connecting all the dots."
msgstr "　それが何処だったかを思い出そうとするのだが、妙な緊張感が邪魔をして、どうにもはっきりしなかった。"

#. Occurrence 5B_1:644:5423: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0001; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:644
msgctxt "text_id=5423 | speaker=aoko"
msgid "\"...Well, isn't this a turn of events. I didn't know you cared so much, Alice."
msgstr "「―――驚いた。ずいぶんと仲間思いになったのね有珠。"

#. Occurrence 5B_1:644:5424: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0001; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:644
msgctxt "text_id=5424 | speaker=aoko"
msgid "  I thought you were going to leave tonight to me.\""
msgstr "　今夜は私に任せるんじゃなかったっけ？」"

#. Occurrence 5B_1:665:5425: scene=5B_1
#: 5B_1:665
msgctxt "text_id=5425 | speaker=unknown"
msgid "  Aoko readied her guard and took half a step forward."
msgstr "　青子はわずかに身構え、半歩だけ前に出た。"

#. Occurrence 5B_1:670:5426: scene=5B_1
#: 5B_1:670
msgctxt "text_id=5426 | speaker=unknown"
msgid "  Unconsciously."
msgstr "　無意識に。"

#. Occurrence 5B_1:675:5427: scene=5B_1
#: 5B_1:675
msgctxt "text_id=5427 | speaker=unknown"
msgid "  From an objective standpoint, it almost looked as though she were protecting the figure beside her."
msgstr "　第三者的に見れば、<傍|かたわ>らの人影をかばうように。"

#. Occurrence 5B_1:726:5428: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0002; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:726
msgctxt "text_id=5428 | speaker=alice"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5B_1:732:5429: scene=5B_1
#: 5B_1:732
msgctxt "text_id=5429 | speaker=unknown"
msgid "  Alice's silence grew ever heavier."
msgstr "　有珠の沈黙はますます重くなっていく。"

#. Occurrence 5B_1:737:5430: scene=5B_1
#: 5B_1:737
msgctxt "text_id=5430 | speaker=unknown"
msgid "  Her eyes, fixed on the ground below her, were devoid of emotion."
msgstr "　地上を<睥睨|へいげい>する瞳は感情に<乏|とぼ>しい。"

#. Occurrence 5B_1:742:5431: scene=5B_1
#: 5B_1:742
msgctxt "text_id=5431 | speaker=unknown"
msgid "  An indescribable sense of dread and pressure laid claim over the plaza."
msgstr "　でありながら、言いようのない不安と重圧でこの広場を支配しつつある。"

#. Occurrence 5B_1:813:5432: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_1_0001; voice_prefix=A30; voice_category=3; scene=5B_1
#: 5B_1:813
msgctxt "text_id=5432 | speaker=soujuurou"
msgid "\"...A bell...?\""
msgstr "“……鐘……？”"

#. Occurrence 5B_1:819:5433: scene=5B_1
#: 5B_1:819
msgctxt "text_id=5433 | speaker=unknown"
msgid "  If he strained his ears, he could make out the faint ringing of a bell echoing in the distance."
msgstr "　耳を澄ますと、どこからか鐘の音が響いていた。"

#. Occurrence 5B_1:824:5434: scene=5B_1
#: 5B_1:824
msgctxt "text_id=5434 | speaker=unknown"
msgid "  The rippling soundwave seemed, unbelievably, to be emanating from under the ground."
msgstr "　寄せ返すさざ波のような<鐘|おと>は、信じがたい事に地面の下から聴こえてくる。"

#. Occurrence 5B_1:851:5435: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_1_0002; voice_prefix=A30; voice_category=3; scene=5B_1
#: 5B_1:851
msgctxt "text_id=5435 | speaker=soujuurou"
msgid "\"Hey Aozaki, that girl... She's―\""
msgstr "「なあ蒼崎、あの<娘|こ>」"

#. Occurrence 5B_1:862:5436: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0002; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:862
msgctxt "text_id=5436 | speaker=aoko"
msgid "\"Quiet.\""
msgstr "「黙ってて」"

#. Occurrence 5B_1:874:5437: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_1_0003; voice_prefix=A30; voice_category=3; scene=5B_1
#: 5B_1:874
msgctxt "text_id=5437 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5B_1:880:5438: scene=5B_1
#: 5B_1:880
msgctxt "text_id=5438 | speaker=unknown"
msgid "  Soujyuro stepped back, trying to stay out of the way."
msgstr "　むう、と邪魔にならないよう引っこむ草十郎。"

#. Occurrence 5B_1:885:5439: scene=5B_1
#: 5B_1:885
msgctxt "text_id=5439 | speaker=unknown"
msgid "  It was as though he had been told to go to hell"
msgstr "　知り合い？　という質問に、"

#. Occurrence 5B_1:890:5440: scene=5B_1
#: 5B_1:890
msgctxt "text_id=5440 | speaker=unknown"
msgid "  for the crime of asking if the girl was Aoko's friend."
msgstr "　死にたい？　と返された感じ。"

#. Occurrence 5B_1:931:5441: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0003; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:931
msgctxt "text_id=5441 | speaker=alice"
msgid "\"I wouldn't go as far as to say I cared. I simply had a feeling something might be wrong and came to check."
msgstr "「……そうね。仲間思い、に当てはまるかは微妙だけど、良くない予感がしたから様子を見に来ただけ。"

#. Occurrence 5B_1:937:5442: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0004; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:937
msgctxt "text_id=5442 | speaker=alice"
msgid "  It's not as though I had any doubts regarding your ability to handle the job.\""
msgstr "　別に、貴女の仕事を疑ったワケじゃないわ。」"

#. Occurrence 5B_1:980:5443: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0003; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:980
msgctxt "text_id=5443 | speaker=aoko"
msgid "\"Much appreciated. It would have been nice if you had thought to come check just a bit earlier, though."
msgstr "「それはどうも。どうせならもう少し早く、その良くない予感とやらに気づいてほしかったけど。"

#. Occurrence 5B_1:986:5444: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0004; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:986
msgctxt "text_id=5444 | speaker=aoko"
msgid "  ...As you can see, things seem to have worked themselves out."
msgstr "　―――でもま、ごらんの通り自己解決したわ。"

#. Occurrence 5B_1:999:5445: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0005; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:999
msgctxt "text_id=5445 | speaker=aoko"
msgid "  It's late, so don't let me keep you, Alice. Since you have no doubts about my ability, right?\""
msgstr "　夜も遅いし、さっさと帰っていいわよ有珠。私の仕事っぷりを疑うワケじゃないんでしょう？」"

#. Occurrence 5B_1:1038:5446: scene=5B_1
#: 5B_1:1038
msgctxt "text_id=5446 | speaker=unknown"
msgid "  Their eyes locked on one another."
msgstr "　両者の視線が交差する。"

#. Occurrence 5B_1:1043:5447: scene=5B_1
#: 5B_1:1043
msgctxt "text_id=5447 | speaker=unknown"
msgid "  Alice's stare was uncomfortably cold."
msgstr "　有珠はやや不快げに、冷たさをこめて。"

#. Occurrence 5B_1:1048:5448: scene=5B_1
#: 5B_1:1048
msgctxt "text_id=5448 | speaker=unknown"
msgid "  Aoko's was bold, daring Alice to air her complaints."
msgstr "　青子は堂々と、文句があるなら言いやがれと挑発するように。"

#. Occurrence 5B_1:1084:5449: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0005; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1084
msgctxt "text_id=5449 | speaker=alice"
msgid "\"...I think I've changed my mind."
msgstr "「……いえ、気が変わったわ。"

#. Occurrence 5B_1:1090:5450: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0006; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1090
msgctxt "text_id=5450 | speaker=alice"
msgid "  I'm here now, so why don't the two of us go home? That's more your style anyway, Aoko. You can tell me all about your adventures with the puppet on the way.\""
msgstr "　せっかくだし<二|・><人|・><で|・><帰|・><り|・><ま|・><し|・><ょ|・><う|・>。その方が貴女らしいわ。帰りしな、人形の話でも聞かせてちょうだい」"

#. Occurrence 5B_1:1096:5451: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0006; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:1096
msgctxt "text_id=5451 | speaker=aoko"
msgid "\"Ha! What's that supposed to mean?"
msgstr "「は。らしいってなによ、らしいって。"

#. Occurrence 5B_1:1102:5452: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0007; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:1102
msgctxt "text_id=5452 | speaker=aoko"
msgid "  Go home, Alice. Shut yourself in your room and make some more of your worthless birds.\""
msgstr "　いいから帰れ帰れ、ぐうたら有珠。部屋に閉じこもって役に立たない<椋鳥|むくどり>でも作ってろっての」"

#. Occurrence 5B_1:1161:5453: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0007; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1161
msgctxt "text_id=5453 | speaker=alice"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence 5B_1:1166:5454: scene=5B_1
#: 5B_1:1166
msgctxt "text_id=5454 | speaker=unknown"
msgid "  A disappointed sigh escaped Alice's delicate lips."
msgstr "　可憐な唇が<落胆|らくたん>の息をこぼす。"

#. Occurrence 5B_1:1171:5455: scene=5B_1
#: 5B_1:1171
msgctxt "text_id=5455 | speaker=unknown"
msgid "  It seemed that the black-clad girl was more astonished than angry."
msgstr "　黒衣の少女は怒るというより呆れたように、"

#. Occurrence 5B_1:1186:5456: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0008; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1186
msgctxt "text_id=5456 | speaker=alice"
msgid "\"...Aoko. I hate to say this, but... seriously?\""
msgstr "「……青子。口にしたくないけど、本気？」"

#. Occurrence 5B_1:1192:5457: scene=5B_1
#: 5B_1:1192
msgctxt "text_id=5457 | speaker=unknown"
msgid "  Quietly,"
msgstr "　静かに。"

#. Occurrence 5B_1:1197:5458: scene=5B_1
#: 5B_1:1197
msgctxt "text_id=5458 | speaker=unknown"
msgid "  Alice questioned her roommate of nearly two years."
msgstr "　二年近くともに暮らした同居人を問いただした。"

#. Occurrence 5B_1:1245:5459: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0008; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:1245
msgctxt "text_id=5459 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5B_1:1267:5460: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0009; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1267
msgctxt "text_id=5460 | speaker=alice"
msgid "\"...You surprise me. Did you not say we would protect our secret together?"
msgstr "「……呆れた。二人で秘密を守ると言ったのに？"

#. Occurrence 5B_1:1273:5461: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0010; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1273
msgctxt "text_id=5461 | speaker=alice"
msgid "  Are you still having trouble letting go of the other side? Or has compassion taken hold of you?\""
msgstr "　まだ半端にそっち側なの？　それとも情でも移った？」"

#. Occurrence 5B_1:1316:5462: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0009; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:1316
msgctxt "text_id=5462 | speaker=aoko"
msgid "\"Not at all. This isn't compassion―I just feel like doing it this way."
msgstr "「別に。情っていうより私の気分よ。"

#. Occurrence 5B_1:1328:5463: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0010; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:1328
msgctxt "text_id=5463 | speaker=aoko"
msgid "  No plan survives contact with the enemy, you know that. The same goes for my mood."
msgstr "　だいたい、方針なんてその場その場で変わるもんでしょ。気分なら尚更よ。"

#. Occurrence 5B_1:1335:5464: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0011; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:1335
msgctxt "text_id=5464 | speaker=aoko"
msgid "Besides, who goes out of her way to keep a promise"
msgstr "そっちこそ、一度した約束は絶対守"

#. Occurrence 5B_1:1335:5465: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0011; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:1335
msgctxt "text_id=5465 | speaker=aoko"
msgid "she made forever ago? A little old-fashioned, if you ask me.\""
msgstr "　るぅー、なんて、時代遅れなんじゃない？」"

#. Occurrence 5B_1:1385:5466: scene=5B_1
#: 5B_1:1385
msgctxt "text_id=5466 | speaker=unknown"
msgid "  The proverbial knives were out, now."
msgstr "　睨みあうふたり。"

#. Occurrence 5B_1:1390:5467: scene=5B_1
#: 5B_1:1390
msgctxt "text_id=5467 | speaker=unknown"
msgid "  No quarter was given nor taken."
msgstr "　歩み寄る気なんて微塵もなし。"

#. Occurrence 5B_1:1395:5468: scene=5B_1
#: 5B_1:1395
msgctxt "text_id=5468 | speaker=unknown"
msgid "  Sadly, their partnership was one of convenience, and had not reached the level of mutual understanding."
msgstr "　悲しい事だが、彼女たちの在り方はあくまで協力関係であって、相互理解の域には達していない。"

#. Occurrence 5B_1:1400:5469: scene=5B_1
#: 5B_1:1400
msgctxt "text_id=5469 | speaker=unknown"
msgid "  Their version of friendship was both delicate and unique. When a conflict of opinion arose, each would refuse to budge until the other crumbled."
msgstr "　なので、友情のカタチは微妙かつ特殊だった。互いの意見が衝突したら、どちらかが砕けるまで先には進まない。"

#. Occurrence 5B_1:1405:5470: scene=5B_1
#: 5B_1:1405
msgctxt "text_id=5470 | speaker=unknown"
msgid "  Neither was concerned for the other's plight, and at least for now, that was how they liked it."
msgstr "　<青子|それ>は<青子|それ>、<有珠|これ>は<有珠|これ>、と綺麗さっぱり切り捨てられるのが、今のところ、彼女たちが良しとする友情である。"

#. Occurrence 5B_1:1436:5471: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0011; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1436
msgctxt "text_id=5471 | speaker=alice"
msgid "\"...You know, I've come to accept stupid outbursts like that from you.\""
msgstr "「……そうね。今の暴言は貴女らしいとは思うけど」"

#. Occurrence 5B_1:1441:5472: scene=5B_1
#: 5B_1:1441
msgctxt "text_id=5472 | speaker=unknown"
msgid "  Once again she let out a sigh, even larger than the one before."
msgstr "　少女はもう一度、今度はさっきより大きなため息をついて、"

#. Occurrence 5B_1:1453:5473: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0012; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1453
msgctxt "text_id=5473 | speaker=alice"
msgid "\"Why don't we save this argument for later?"
msgstr "「言い争いは後にしましょう。"

#. Occurrence 5B_1:1459:5474: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0013; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1459
msgctxt "text_id=5474 | speaker=alice"
msgid "  I can make him disappear on my own.\""
msgstr "　そこの彼を<い|・><な|・><か|・><っ|・><た|・><事|・>にするのは、私だけで十分だし」"

#. Occurrence 5B_1:1465:5475: scene=5B_1
#: 5B_1:1465
msgctxt "text_id=5475 | speaker=unknown"
msgid "  Finally, she struck straight to the point."
msgstr "　つい、と。"

#. Occurrence 5B_1:1470:5476: scene=5B_1
#: 5B_1:1470
msgctxt "text_id=5476 | speaker=unknown"
msgid "  As if making to move a chess piece, Alice lifted her slender finger."
msgstr "　チェスの駒をさすような仕草で、細い指を動かした。"

#. Occurrence 5B_1:1643:5477: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_1_0004; voice_prefix=A30; voice_category=3; scene=5B_1
#: 5B_1:1643
msgctxt "text_id=5477 | speaker=soujuurou"
msgid "\"Hm?\""
msgstr "“うん？”"

#. Occurrence 5B_1:1649:5478: scene=5B_1
#: 5B_1:1649
msgctxt "text_id=5478 | speaker=unknown"
msgid "  Even this simple action seemed mysterious to Soujyuro, the same boy who had been hunted by his classmate Aoko Aozaki and borne witness to an automaton."
msgstr "　それは、蒼崎青子に命を狙われ、まがりなりにも自動人形を目撃した草十郎をして、目を見張る“不思議”だった。"

#. Occurrence 5B_1:1654:5479: scene=5B_1
#: 5B_1:1654
msgctxt "text_id=5479 | speaker=unknown"
msgid "  Aoko's violence and an animated doll―"
msgstr "　……青子の暴挙、動く人形。"

#. Occurrence 5B_1:1659:5480: scene=5B_1
#: 5B_1:1659
msgctxt "text_id=5480 | speaker=unknown"
msgid "  Though perhaps far beyond the realm of logic, both these things were derived from reality. As surprised as he had been, there was no need to think of them as total mysteries."
msgstr "　それらは常識外とは言え、<現|そ><実|こ>にあるものから派生した出来事だ。彼にとっては驚きこそすれ、不思議に思う事はない。"

#. Occurrence 5B_1:1729:5481: scene=5B_1
#: 5B_1:1729
msgctxt "text_id=5481 | speaker=unknown"
msgid "  However..."
msgstr "　しかし。"

#. Occurrence 5B_1:1734:5482: scene=5B_1
#: 5B_1:1734
msgctxt "text_id=5482 | speaker=unknown"
msgid "  When the thing appeared out of thin air from a seemingly unrelated gesture, he had no word for it besides \"mysterious.\""
msgstr "　何もない空間、何の関連もない動作から突如あらわれたソレは、彼にとっては不思議以外の何物でもなかった。"

#. Occurrence 5B_1:1739:5483: scene=5B_1
#: 5B_1:1739
msgctxt "text_id=5483 | speaker=unknown"
msgid "  Soujyuro stood motionless, captivated by this stage performer's magic trick, as the girl's single-finger magecraft turned into an attack directed at him."
msgstr "　草十郎は手品に見惚れるよう、指一本動かせず少女の魔術に襲われる。"

#. Occurrence 5B_1:1768:5484: scene=5B_1
#: 5B_1:1768
msgctxt "text_id=5484 | speaker=unknown"
msgid "  A blue light flew from the side to repel it, annihilating it without a trace."
msgstr "　それを横から<弾|はじ>こう……として、<勢|いきお>い、<跡形|あとかた>もなく粉砕する青い光。"

#. Occurrence 5B_1:1854:5485: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0012; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:1854
msgctxt "text_id=5485 | speaker=aoko"
msgid "\"Oh, crap.\""
msgstr "「あ、やば」"

#. Occurrence 5B_1:1860:5486: scene=5B_1
#: 5B_1:1860
msgctxt "text_id=5486 | speaker=unknown"
msgid "  Aoko immediately regretted her reflexive shot."
msgstr "　青子は脊髄反射で手をだしてしまい、しまった、と反省する。"

#. Occurrence 5B_1:1934:5487: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0014; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1934
msgctxt "text_id=5487 | speaker=alice"
msgid "\"...What are you doing? You're not satisfied with breaking just our promise, so you must break the rules as well?\""
msgstr "「…………どういう事？　<言葉|やくそく>を曲げただけじゃなく、ルールまで破るつもり？」"

#. Occurrence 5B_1:1954:5488: scene=5B_1
#: 5B_1:1954
msgctxt "text_id=5488 | speaker=unknown"
msgid "  The already chilled midwinter air plunged below freezing."
msgstr "　……ただでさえ冷えきっていた真冬の空気が、もう氷結レベルまで落ちこんでいく。"

#. Occurrence 5B_1:1959:5489: scene=5B_1
#: 5B_1:1959
msgctxt "text_id=5489 | speaker=unknown"
msgid "  Alice looked calm and collected on the outside, but in reality she was sometimes even more hot-blooded than Aoko."
msgstr "　有珠はクールそうに見えて、その実、青子以上に激情家なところがあった。"

#. Occurrence 5B_1:1979:5490: scene=5B_1
#: 5B_1:1979
msgctxt "text_id=5490 | speaker=unknown"
msgid "  This was especially true when it concerned her familiars."
msgstr "　その最たるものが、使い魔への扱いである。"

#. Occurrence 5B_1:1984:5491: scene=5B_1
#: 5B_1:1984
msgctxt "text_id=5491 | speaker=unknown"
msgid "  Accidentally breaking one would often result in a week of silent treatment,"
msgstr "　悪意のないミスで壊してしまった場合は一週間程度の無言の抗議で済むが、"

#. Occurrence 5B_1:1989:5492: scene=5B_1
#: 5B_1:1989
msgctxt "text_id=5492 | speaker=unknown"
msgid "  but against someone who maliciously destroyed her things, Alice was prone to retaliate without warning."
msgstr "　悪意をもって破壊したのなら、もうどんな言い訳があろうと報復するのが彼女の性格だった。"

#. Occurrence 5B_1:2010:5493: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0013; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2010
msgctxt "text_id=5493 | speaker=aoko"
msgid "\"Whoops. I figured I'd do that someday, but I couldn't have picked a worse time...\""
msgstr "“あっちゃあ……いつかやるとは思ったけど、ついに<逆鱗|げきりん>に触れちゃったか……”"

#. Occurrence 5B_1:2016:5494: scene=5B_1
#: 5B_1:2016
msgctxt "text_id=5494 | speaker=unknown"
msgid "  Aoko sighed at herself. Even she was exasperated by her own stupidity, yet she couldn't help but feel a pang of relief."
msgstr "　あーあ、と。自分の馬鹿さ加減に呆れながらも、青子は<清々|すがすが>しさを感じていた。"

#. Occurrence 5B_1:2021:5495: scene=5B_1
#: 5B_1:2021
msgctxt "text_id=5495 | speaker=unknown"
msgid "  She did not intend to make any excuses, and she had no regrets."
msgstr "　言い訳をする気はないし、後悔もしていない。"

#. Occurrence 5B_1:2026:5496: scene=5B_1
#: 5B_1:2026
msgctxt "text_id=5496 | speaker=unknown"
msgid "  If she had broken the rules, then so had Alice."
msgstr "　ルールを破ったというのなら、それは有珠も同じである。"

#. Occurrence 5B_1:2097:5497: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0015; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:2097
msgctxt "text_id=5497 | speaker=alice"
msgid "\"Aoko.\""
msgstr "「青子」"

#. Occurrence 5B_1:2119:5498: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0014; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2119
msgctxt "text_id=5498 | speaker=aoko"
msgid "\"How do I put it...\""
msgstr "「ま、なんていうか―――」"

#. Occurrence 5B_1:2131:5499: scene=5B_1
#: 5B_1:2131
msgctxt "text_id=5499 | speaker=unknown"
msgid "  If anything, this took a load off her mind."
msgstr "　逆にさっぱりしたぐらいだ。"

#. Occurrence 5B_1:2136:5500: scene=5B_1
#: 5B_1:2136
msgctxt "text_id=5500 | speaker=unknown"
msgid "  After all, now there was no going back."
msgstr "　だって、こうなった以上はもう色々仕方がない。"

#. Occurrence 5B_1:2141:5501: scene=5B_1
#: 5B_1:2141
msgctxt "text_id=5501 | speaker=unknown"
msgid "  Aoko never intended to break her own rules."
msgstr "　青子には自分のルールを破る気なんて毛頭なく、"

#. Occurrence 5B_1:2183:5502: scene=5B_1
#: 5B_1:2183
msgctxt "text_id=5502 | speaker=unknown"
msgid "  If there was anything for Aoko to regret, it was putting too little power into her shot."
msgstr "　反省する事があるといったら、それは力加減を間違えた事だけで、"

#. Occurrence 5B_1:2190:5503: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0015; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2190
msgctxt "text_id=5503 | speaker=aoko"
msgid "\"I have a problem with this guy dying tonight."
msgstr "「<私|わたし>的に、今夜コイツに死なれるのは困るのよ。"

#. Occurrence 5B_1:2196:5504: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0016; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2196
msgctxt "text_id=5504 | speaker=aoko"
msgid "  So, can we reschedule the execution? What difference does a day make?\""
msgstr "　なんで、日を改めて殺しに来てくれない有珠？　いいでしょ、たった一日ぐらい」"

#. Occurrence 5B_1:2202:5505: scene=5B_1
#: 5B_1:2202
msgctxt "text_id=5505 | speaker=unknown"
msgid "  To Aoko, it was simply natural to take on a pro bono case in defense of an innocent suspect."
msgstr "　とっさに容疑者Ｓをかばったのは、彼女にとって当然の正義だった。"

#. Occurrence 5B_1:2255:5506: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0016; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:2255
msgctxt "text_id=5506 | speaker=alice"
msgid "\"...Is this personal?\""
msgstr "「それは私情？」"

#. Occurrence 5B_1:2264:5507: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0017; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2264
msgctxt "text_id=5507 | speaker=aoko"
msgid "\"So what if it is? You know that paying back my debts is pretty important to me.\""
msgstr "「悪い？　一宿一飯の恩義ってわりと大事にしてるの、私」"

#. Occurrence 5B_1:2273:5508: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0017; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:2273
msgctxt "text_id=5508 | speaker=alice"
msgid "\"More important than our agreement?\""
msgstr "「わたしとの協定より？」"

#. Occurrence 5B_1:2282:5509: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0018; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2282
msgctxt "text_id=5509 | speaker=aoko"
msgid "\"Sure, depending on the time and place.\""
msgstr "「ええ。時と場合によっては」"

#. Occurrence 5B_1:2338:5510: scene=5B_1
#: 5B_1:2338
msgctxt "text_id=5510 | speaker=unknown"
msgid "  Soujyuro's human rights had not yet entered the argument."
msgstr "　この場にいる<草十郎|さんにんめ>の人権もなんのその。"

#. Occurrence 5B_1:2349:5511: scene=5B_1
#: 5B_1:2349
msgctxt "text_id=5511 | speaker=unknown"
msgid "  The girls were busy pouring oil on each other's flames."
msgstr "　少女たちは互いに油をかけあっていく。"

#. Occurrence 5B_1:2370:5512: scene=5B_1
#: 5B_1:2370
msgctxt "text_id=5512 | speaker=unknown"
msgid "  The girl clad in black was the first to move―or rather, to erupt."
msgstr "　感情の切り替え―――いや、感情に火をつけるのは、黒衣の少女の方が先だった。"

#. Occurrence 5B_1:2403:5513: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0018; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:2403
msgctxt "text_id=5513 | speaker=alice"
msgid "\"...I see. I understand how you feel, Aoko."
msgstr "「―――そう。よく分かったわ青子。"

#. Occurrence 5B_1:2433:5514: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0019; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:2433
msgctxt "text_id=5514 | speaker=alice"
msgid "  But I am going to have to kill him here."
msgstr "　わたしは彼をここで殺す。"

#. Occurrence 5B_1:2478:5515: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0020; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:2478
msgctxt "text_id=5515 | speaker=alice"
msgid "  I believe that you would let him live."
msgstr "　貴女は彼をここだけ生かす。"

#. Occurrence 5B_1:2502:5516: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0021; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:2502
msgctxt "text_id=5516 | speaker=alice"
msgid "  Shall I take that to mean you're ready to fight me for it?\""
msgstr "　……つまり。<わ|・><た|・><し|・><と|・><戦|・><う|・>、という事でいい？」"

#. Occurrence 5B_1:2546:5517: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0019; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2546
msgctxt "text_id=5517 | speaker=aoko"
msgid "(...Hmph. You know damn well I'd rather not.)"
msgstr "“……ふん。そんなの、いいワケないじゃない”"

#. Occurrence 5B_1:2555:5518: scene=5B_1
#: 5B_1:2555
msgctxt "text_id=5518 | speaker=unknown"
msgid "  Aoko bit back the retort."
msgstr "　なんて弱音をぐっと堪える。"

#. Occurrence 5B_1:2560:5519: scene=5B_1
#: 5B_1:2560
msgctxt "text_id=5519 | speaker=unknown"
msgid "  She was very familiar with Alice's magecraft,"
msgstr "　青子は有珠の魔術を知っている。"

#. Occurrence 5B_1:2565:5520: scene=5B_1
#: 5B_1:2565
msgctxt "text_id=5520 | speaker=unknown"
msgid "  and knew painfully well how many Mystics were hidden in Alice's tiny body."
msgstr "　あの小さな体にどれほどの神秘を秘めているか、痛いほど経験している。"

#. Occurrence 5B_1:2625:5521: scene=5B_1
#: 5B_1:2625
msgctxt "text_id=5521 | speaker=unknown"
msgid "  The odds of victory were essentially nonexistent."
msgstr "　勝ち目はほとんど、ぜったい<皆無|かいむ>。"

#. Occurrence 5B_1:2630:5522: scene=5B_1
#: 5B_1:2630
msgctxt "text_id=5522 | speaker=unknown"
msgid "  And once the first shot had been fired, Alice Kuonji was without mercy."
msgstr "　そして一度でも口火をきれば、久遠寺有珠は容赦なしだ。"

#. Occurrence 5B_1:2643:5523: scene=5B_1
#: 5B_1:2643
msgctxt "text_id=5523 | speaker=unknown"
msgid "  Whether facing a roommate or a friend,"
msgstr "　同居人であろうと友人だろうと、"

#. Occurrence 5B_1:2648:5524: scene=5B_1
#: 5B_1:2648
msgctxt "text_id=5524 | speaker=unknown"
msgid "  a most beloved family member or a stranger,"
msgstr "　彼女の最愛の肉親であろうと、"

#. Occurrence 5B_1:2653:5525: scene=5B_1
#: 5B_1:2653
msgctxt "text_id=5525 | speaker=unknown"
msgid "  once Alice began to fight as a witch, she became a heartless, unflappable monster."
msgstr "　魔女として戦う以上、あの少女は<冷徹|れいてつ><無|む><比|ひ>な怪物となる。"

#. Occurrence 5B_1:2725:5526: scene=5B_1
#: 5B_1:2725
msgctxt "text_id=5526 | speaker=unknown"
msgid "  Aoko advanced another half step forward as if to encourage herself."
msgstr "　青子はもう半歩、自らを<鼓|こ><舞|ぶ>するよう前進した。"

#. Occurrence 5B_1:2730:5527: scene=5B_1
#: 5B_1:2730
msgctxt "text_id=5527 | speaker=unknown"
msgid "  It was too late to back down now. The situation was no longer a trivial quarrel over a witness."
msgstr "　今さら後には退けない。<事|コ><態|ト>はもう、どうでもいい<目撃者|だいさんしゃ>を<巡|めぐ>っての言い争いではない。"

#. Occurrence 5B_1:2735:5528: scene=5B_1
#: 5B_1:2735
msgctxt "text_id=5528 | speaker=unknown"
msgid "  The bedrock of their so-called friendship had nothing to do with their individual abilities, and everything to do with being equals in will."
msgstr "　彼女たちの友情らしきものは、実力差はどうあれ、精神的に対等である事が成立の条件になっている。"

#. Occurrence 5B_1:2741:5529: scene=5B_1
#: 5B_1:2741
msgctxt "text_id=5529 | speaker=unknown"
msgid "  That is why, in order to stay true to herself, Aoko had no room for compromise or deception."
msgstr "　だからこそ―――『自分』を通すのであれば、妥協も誤魔化しも、する訳にはいかなかった。"

#. Occurrence 5B_1:2775:5530: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0020; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2775
msgctxt "text_id=5530 | speaker=aoko"
msgid "\"Of course. I'm going to make sure this idiot lives, even if it means killing you. And besides...\""
msgstr "「もちろん。アンタを殺す事になっても、そこのバカは生かしきるわ。それに―――」"

#. Occurrence 5B_1:2881:5531: scene=5B_1
#: 5B_1:2881
msgctxt "text_id=5531 | speaker=unknown"
msgid "  Her Magic Circuits howled as they kicked into gear."
msgstr "　うなりをあげて式を走らせる魔術回路。"

#. Occurrence 5B_1:2887:5532: scene=5B_1
#: 5B_1:2887
msgctxt "text_id=5532 | speaker=unknown"
msgid "Her body, which had mostly been dormant during the battle with the puppet, ignited, preparing to demonstrate its true worth."
msgstr "先の人形戦では眠っていた身体が、その真価を発揮させろと燃え上がり―――"

#. Occurrence 5B_1:2939:5533: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0021; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2939
msgctxt "text_id=5533 | speaker=aoko"
msgid "\"We were going to end up killing each other in the end anyway!\""
msgstr "「それに。どのみち最後には殺し合う仲でしょ、私たち……！」"

#. Occurrence 5B_1:2945:5534: scene=5B_1
#: 5B_1:2945
msgctxt "text_id=5534 | speaker=unknown"
msgid "  Her courage overpowered any fear she had for her opponent."
msgstr "　闘志を<以|もっ>て、強敵への恐怖を克服する―――！"

#. Occurrence 5B_1:3153:5535: scene=5B_1
#: 5B_1:3153
msgctxt "text_id=5535 | speaker=unknown"
msgid "  Tuning her body―her Magic Circuits―to become like the barrel of a gun, Aoko fired a magic bullet. It was an exceedingly basic magecraft formula."
msgstr "　青子の魔弾は自身の体……魔術回路を銃身にして魔力を放つ、ごく単純な魔術式だ。"

#. Occurrence 5B_1:3158:5536: scene=5B_1
#: 5B_1:3158
msgctxt "text_id=5536 | speaker=unknown"
msgid "  There was no nature interference: no creating of wind, parting of water, nor hastening of decay."
msgstr "　風を起こす、水を分ける、<劣化|じかん>をかける、といった自然干渉ではない。"

#. Occurrence 5B_1:3163:5537: scene=5B_1
#: 5B_1:3163
msgctxt "text_id=5537 | speaker=unknown"
msgid "  It was simply the process of converting the imaginary activity known as magical energy into something real, before releasing it as heat."
msgstr "　魔力という架空の運動を実在へと加工し、熱量として撃ちだしている。"

#. Occurrence 5B_1:3168:5538: scene=5B_1
#: 5B_1:3168
msgctxt "text_id=5538 | speaker=unknown"
msgid "  Thus Aoko's destructive power was equal to her supply of magical energy."
msgstr "　なので、その破壊力は青子が扱える魔力量がイコールとなる。"

#. Occurrence 5B_1:3188:5539: scene=5B_1
#: 5B_1:3188
msgctxt "text_id=5539 | speaker=unknown"
msgid "  The magic bullets she had used against Soujyuro were among the most basic single-action magecraft that did not require an incantation."
msgstr "　草十郎相手に使用した魔弾は<一工程|シングルアクション>、詠唱を必要としない最低限の魔術だった。"

#. Occurrence 5B_1:3194:5540: scene=5B_1
#: 5B_1:3194
msgctxt "text_id=5540 | speaker=unknown"
msgid "  At her present ability, Aoko's main mode of attack―her magic bullet―could be fired at three levels of power."
msgstr "　現状、青子が主武器とする魔弾には三つの工程がある。"

#. Occurrence 5B_1:3199:5541: scene=5B_1
#: 5B_1:3199
msgctxt "text_id=5541 | speaker=unknown"
msgid "  These were at the second level."
msgstr "　これはその二つめ。"

#. Occurrence 5B_1:3204:5542: scene=5B_1
#: 5B_1:3204
msgctxt "text_id=5542 | speaker=unknown"
msgid "  This required a double-action magecraft―a casting through activation of her crest combined with a simplified incantation."
msgstr "　魔術刻印を<起動|リード>させ、簡略化詠唱を用いた二工程の魔弾である。"

#. Occurrence 5B_1:3345:5543: scene=5B_1
#: 5B_1:3345
msgctxt "text_id=5543 | speaker=unknown"
msgid "  However..."
msgstr "　しかし。"

#. Occurrence 5B_1:3350:5544: scene=5B_1
#: 5B_1:3350
msgctxt "text_id=5544 | speaker=unknown"
msgid "  Without blinking, Alice dispersed the shot that Aoko had mustered all of her spirit to fire."
msgstr "　それなりに気合いを込めた青子の魔弾を、少女は<瞬|またた>き一つせず霧散させた。"

#. Occurrence 5B_1:3550:5545: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0022; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:3550
msgctxt "text_id=5545 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5B_1:3556:5546: scene=5B_1
#: 5B_1:3556
msgctxt "text_id=5546 | speaker=unknown"
msgid "  Aoko tutted in frustration."
msgstr "　ち、と舌打ちする青子。"

#. Occurrence 5B_1:3561:5547: scene=5B_1
#: 5B_1:3561
msgctxt "text_id=5547 | speaker=unknown"
msgid "  A swift sneak attack that used a simplified incantation would not be enough to break Alice's guard."
msgstr "　不意打ちの速攻―――詠唱を簡略した魔術行使では、久遠寺有珠の守りは破れない。"

#. Occurrence 5B_1:3630:5548: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0023; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:3630
msgctxt "text_id=5548 | speaker=aoko"
msgid "\"As stiff as ever, I see. Don't you think that shell is making you complacent?\""
msgstr "「相変わらずお<堅|かた>いこと。その<殻|カラ>、一段と独りよがりになってるんじゃない？」"

#. Occurrence 5B_1:3636:5549: scene=5B_1
#: 5B_1:3636
msgctxt "text_id=5549 | speaker=unknown"
msgid "  Aoko provoked Alice in order to disguise her own lack of composure."
msgstr "　青子は内心の焦りをおくびにも出さず挑発する。"

#. Occurrence 5B_1:3658:5550: scene=5B_1
#: 5B_1:3658
msgctxt "text_id=5550 | speaker=unknown"
msgid "  Somehow Alice seemed delighted by Aoko's bravado."
msgstr "　そのやせ我慢が気に入ったのか。"

#. Occurrence 5B_1:3665:5551: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0022; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:3665
msgctxt "text_id=5551 | speaker=alice"
msgid "\"I suppose this is what they call 'fighting words.'"
msgstr "「売り言葉に買い言葉、というヤツね。"

#. Occurrence 5B_1:3671:5552: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0023; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:3671
msgctxt "text_id=5552 | speaker=alice"
msgid "  I've never fought to the death for such a trivial reason.\""
msgstr "　こういう、勢いだけのきっかけは初めてだけど……」"

#. Occurrence 5B_1:3725:5553: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0024; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:3725
msgctxt "text_id=5553 | speaker=alice"
msgid "\"I'm really shocked. Humans are such conceited creatures.\""
msgstr "「驚いたわ。こんな下らない理由でも、その気になるものなのね、人間って」"

#. Occurrence 5B_1:3731:5554: scene=5B_1
#: 5B_1:3731
msgctxt "text_id=5554 | speaker=unknown"
msgid "  Alice giggled."
msgstr "　くすりと。"

#. Occurrence 5B_1:3736:5555: scene=5B_1
#: 5B_1:3736
msgctxt "text_id=5555 | speaker=unknown"
msgid "  Smiling with heartfelt amazement, Alice gestured her left hand toward the earth."
msgstr "　心の底から感心するように微笑んで、少女は左手の指を地上に向けた。"

#. Occurrence 5B_1:3978:5556: scene=5B_1
#: 5B_1:3978
msgctxt "text_id=5556 | speaker=unknown"
msgid "  <Stab.|Zap.> <Stab.|Zap.> <Stab.|Zap.> <Stab|Zap.>."
msgstr "　<刺|zap>す。<刺|zap>す。<刺|zap>す。<刺|zap>す。"

#. Occurrence 5B_1:3983:5557: scene=5B_1
#: 5B_1:3983
msgctxt "text_id=5557 | speaker=unknown"
msgid "  Countless utensils shot out from underneath the cobblestones paving the plaza."
msgstr "　広場の地面、レンガを破って突き出る無数の槍。"

#. Occurrence 5B_1:4050:5558: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0024; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:4050
msgctxt "text_id=5558 | speaker=aoko"
msgid "\"Sizuki, get back!\""
msgstr "「静希君、後ろに跳んで！」"

#. Occurrence 5B_1:4056:5559: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_1_0005; voice_prefix=A30; voice_category=3; scene=5B_1
#: 5B_1:4056
msgctxt "text_id=5559 | speaker=soujuurou"
msgid "\"...?\""
msgstr "「？」"

#. Occurrence 5B_1:4061:5560: scene=5B_1
#: 5B_1:4061
msgctxt "text_id=5560 | speaker=unknown"
msgid "  She grabbed his hand as she shouted, jumping backward before he even had a chance to respond."
msgstr "　青子は呼びかけながら、彼が反応するより早く手を取って後ろに跳んだ。"

#. Occurrence 5B_1:4128:5561: scene=5B_1
#: 5B_1:4128
msgctxt "text_id=5561 | speaker=unknown"
msgid "  As if they had wills of their own, the utensils that had suddenly appeared from the ground gave chase."
msgstr "　地面から湧き立つ器物は意志を持つように、跳び退く青子たちを追いかける。"

#. Occurrence 5B_1:4133:5562: scene=5B_1
#: 5B_1:4133
msgctxt "text_id=5562 | speaker=unknown"
msgid "  As the barrier of spears grew around them, Aoko and Soujyuro put some distance between themselves and the clock tower."
msgstr "　槍の守りは放射状に広がり、青子と草十郎を時計台から離していく。"

#. Occurrence 5B_1:4191:5563: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0025; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:4191
msgctxt "text_id=5563 | speaker=aoko"
msgid "\"That all you've got?\""
msgstr "「―――え、これで終わり？」"

#. Occurrence 5B_1:4197:5564: scene=5B_1
#: 5B_1:4197
msgctxt "text_id=5564 | speaker=unknown"
msgid "  Just under thirty feet stood between them and Alice."
msgstr "　後ろに下がること十メートル弱。"

#. Occurrence 5B_1:4202:5565: scene=5B_1
#: 5B_1:4202
msgctxt "text_id=5565 | speaker=unknown"
msgid "  The lethal weapons that had crumbled the stone beneath them fell short of what Aoko had anticipated."
msgstr "　地面を砕いて現れる凶器たちの成長は、青子の予想より小規模に留まった。"

#. Occurrence 5B_1:4207:5566: scene=5B_1
#: 5B_1:4207
msgctxt "text_id=5566 | speaker=unknown"
msgid "  They now encircled the clock tower, making the scene look like the burning of a witch at the stake."
msgstr "　少女の立つ時計台を守るソレは、<磔|はりつけ>にされた魔女を責める<薪|たきぎ>のようで―――"

#. Occurrence 5B_1:4228:5567: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0026; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:4228
msgctxt "text_id=5567 | speaker=aoko"
msgid "(Isn't this backwards? You'd expect the spears to try and stop us from escaping...)"
msgstr "“……普通、逆じゃない？　ここは私たちを逃がさないよう、槍で周りを囲むものでしょう……？”"

#. Occurrence 5B_1:4234:5568: scene=5B_1
#: 5B_1:4234
msgctxt "text_id=5568 | speaker=unknown"
msgid "  The path behind them was safe."
msgstr "　青子と草十郎の後ろには安全な道がある。"

#. Occurrence 5B_1:4239:5569: scene=5B_1
#: 5B_1:4239
msgctxt "text_id=5569 | speaker=unknown"
msgid "  If they wanted, they could try to make a break for the main gate and escape."
msgstr "　その気になれば二人は遊園地の入り口まで走って、そのまま町へ逃げられる。"

#. Occurrence 5B_1:4285:5570: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0027; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:4285
msgctxt "text_id=5570 | speaker=aoko"
msgid "\"Are you sure about this, Alice?"
msgstr "「いいの有珠？"

msgctxt "text_id=5571 | speaker=unknown"
msgid "  Sorry, but if you're going to let me escape, I'm not going to pass the chance up.\""
msgstr "　悪いけど、逃げられるなら逃げるわよ、私」"

#. Occurrence 5B_1:4293:5572: scene=5B_1
#: 5B_1:4293
msgctxt "text_id=5572 | speaker=unknown"
msgid "  If she could just make it back to town, it would be Aoko's win."
msgstr "　町にまで出れば青子の勝ちだ。"

#. Occurrence 5B_1:4298:5573: scene=5B_1
#: 5B_1:4298
msgctxt "text_id=5573 | speaker=unknown"
msgid "  All she wanted to do was let Soujyuro get away for the night, so if she could get him back to the city it would be, for the most part, mission accomplished."
msgstr "　今夜だけ草十郎を見逃したい青子にとって、彼を街に逃がしてしまえば目的は大部分達成―――"

#. Occurrence 5B_1:4354:5574: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0028; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:4354
msgctxt "text_id=5574 | speaker=aoko"
msgid "\"...?\""
msgstr "「？」"

#. Occurrence 5B_1:4374:5575: scene=5B_1
#: 5B_1:4374
msgctxt "text_id=5575 | speaker=unknown"
msgid "  ...Or so she had thought."
msgstr "　―――なのだが。"

#. Occurrence 5B_1:4379:5576: scene=5B_1
#: 5B_1:4379
msgctxt "text_id=5576 | speaker=unknown"
msgid "  Without even offering a glance at her targets below, Alice carefully and lovingly pulled out a bottle from her pocket."
msgstr "　有珠は眼下の標的に目もくれず、愛しい、大切なものを扱うように<小瓶|こびん>を取り出した。"

#. Occurrence 5B_1:4425:5577: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0029; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:4425
msgctxt "text_id=5577 | speaker=aoko"
msgid "\"A green... flask?"
msgstr "「緑の……フラスコ？"

#. Occurrence 5B_1:4431:5578: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0030; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:4431
msgctxt "text_id=5578 | speaker=aoko"
msgid "  Wait, that's... Damn it! Fire!\""
msgstr "　あれってたしか―――やばっ、とにかく<撃て|ファイヤ>―――！」"

#. Occurrence 5B_1:4665:5579: scene=5B_1
#: 5B_1:4665
msgctxt "text_id=5579 | speaker=unknown"
msgid "  Her shot was deflected with ease."
msgstr "　防がれる魔弾。"

#. Occurrence 5B_1:4670:5580: scene=5B_1
#: 5B_1:4670
msgctxt "text_id=5580 | speaker=unknown"
msgid "  Gone was Aoko's earlier bravado."
msgstr "　青子の顔には、もう一片の余裕もない。"

#. Occurrence 5B_1:4757:5581: scene=5B_1
#: 5B_1:4757
msgctxt "text_id=5581 | speaker=unknown"
msgid "  It was only natural―"
msgstr "　……そう。"

#. Occurrence 5B_1:4762:5582: scene=5B_1
#: 5B_1:4762
msgctxt "text_id=5582 | speaker=unknown"
msgid "  Aoko had indeed grown as a mage."
msgstr "　増長していたと言えば、青子はたしかに増長していた。"

#. Occurrence 5B_1:4767:5583: scene=5B_1
#: 5B_1:4767
msgctxt "text_id=5583 | speaker=unknown"
msgid "  Over the last two years of study, her studies had progressed well,"
msgstr "　この二年、学び続けた魔術に手応えもあった。"

#. Occurrence 5B_1:4772:5584: scene=5B_1
#: 5B_1:4772
msgctxt "text_id=5584 | speaker=unknown"
msgid "  and she'd more or less gotten a grasp on her roommate's tendencies and abilities."
msgstr "　同居人の性格、魔術もそれなりに把握していた。"

#. Occurrence 5B_1:4812:5585: scene=5B_1
#: 5B_1:4812
msgctxt "text_id=5585 | speaker=unknown"
msgid "  This had made her conceited enough to believe that, under favorable circumstances, she'd be able to show Alice a thing or two in a fight."
msgstr "　だから―――最善の立ち回りをすれば、久遠寺有珠に一杯くわせられると思い上がったのだ。"

#. Occurrence 5B_1:4890:5586: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0031; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:4890
msgctxt "text_id=5586 | speaker=aoko"
msgid "\"Ah...\""
msgstr "「あ―――」"

#. Occurrence 5B_1:4895:5587: scene=5B_1
#: 5B_1:4895
msgctxt "text_id=5587 | speaker=unknown"
msgid "  Alice uncorked the magical bottle."
msgstr "　……魔法の<瓶|びん>の<蓋|ふた>が開く。"

#. Occurrence 5B_1:4936:5588: scene=5B_1
#: 5B_1:4936
msgctxt "text_id=5588 | speaker=unknown"
msgid "  A gentle breeze caressed her cheek."
msgstr "　頬を優しい風が<撫|な>でる。"

#. Occurrence 5B_1:5050:5589: scene=5B_1
#: 5B_1:5050
msgctxt "text_id=5589 | speaker=unknown"
msgid "  Diddle Diddle fled as a new player stepped onto the stage."
msgstr "　夜の饗宴が、新たな主役の登場に尻尾を巻いて逃げ出していく。"

#. Occurrence 5B_1:5104:5590: scene=5B_1
#: 5B_1:5104
msgctxt "text_id=5590 | speaker=unknown"
msgid "  ...But from where would it enter?"
msgstr "　―――どこからか。"

#. Occurrence 5B_1:5109:5591: scene=5B_1
#: 5B_1:5109
msgctxt "text_id=5591 | speaker=unknown"
msgid "  The sound of footsteps, a nostalgic parade, approached."
msgstr "　懐かしい、パレードの足音がやってくる。"

#. Occurrence 5B_1:5380:5592: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0032; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:5380
msgctxt "text_id=5592 | speaker=aoko"
msgid "\"No...way...\""
msgstr "「う、そ―――」"

#. Occurrence 5B_1:5469:5593: scene=5B_1
#: 5B_1:5469
msgctxt "text_id=5593 | speaker=unknown"
msgid "  What emerged..."
msgstr "　それは。"

#. Occurrence 5B_1:5474:5594: scene=5B_1
#: 5B_1:5474
msgctxt "text_id=5594 | speaker=unknown"
msgid "  was a miracle that Aoko Aozaki, an apprentice mage, had never witnessed."
msgstr "　魔術師見習いである蒼崎青子ですら、体験した事のない奇跡だった。"

#. Occurrence 5B_1:5597:5595: scene=5B_1
#: 5B_1:5597
msgctxt "text_id=5595 | speaker=unknown"
msgid "  The dead came to life."
msgstr "　死んでいたモノが蘇る。"

#. Occurrence 5B_1:5602:5596: scene=5B_1
#: 5B_1:5602
msgctxt "text_id=5596 | speaker=unknown"
msgid "  The inanimate awakened."
msgstr "　生きていないモノが目を覚ます。"

#. Occurrence 5B_1:5607:5597: scene=5B_1
#: 5B_1:5607
msgctxt "text_id=5597 | speaker=unknown"
msgid "  The woods were enveloped by the mists."
msgstr "　霧に包まれた深い森。"

#. Occurrence 5B_1:5612:5598: scene=5B_1
#: 5B_1:5612
msgctxt "text_id=5598 | speaker=unknown"
msgid "  Fire-breathing lizards lurked in the swamps."
msgstr "　沼地にひそむ火を噴くトカゲ。"

#. Occurrence 5B_1:5617:5599: scene=5B_1
#: 5B_1:5617
msgctxt "text_id=5599 | speaker=unknown"
msgid "  Puppets made merry at midnight."
msgstr "　午前零時をむかえてはしゃぎだすパペットたち。"

#. Occurrence 5B_1:5627:5600: scene=5B_1
#: 5B_1:5627
msgctxt "text_id=5600 | speaker=unknown"
msgid "  Alice Kuonji's slender fingers had transfigured the entirety of the park, as if gently stroking the back of an elderly cat."
msgstr "　久遠寺有珠の細い指は、年老いた猫の背中を撫でるように優しく、遊園地全体を変貌させ―――"

#. Occurrence 5B_1:5677:5601: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0025_0; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:5677
msgctxt "text_id=5601 | speaker=alice"
msgid "    \"Very well..."
msgstr "　　「いいわ―――"

#. Occurrence 5B_1:5684:5602: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0025_1; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:5684
msgctxt "text_id=5602 | speaker=alice"
msgid " Let us play pretend, Aoko.\""
msgstr "ごっこ遊びをしましょう、青子」"

#. Occurrence 5B_1:5747:5603: scene=5B_1
#: 5B_1:5747
msgctxt "text_id=5603 | speaker=unknown"
msgid "  For one night, the wasteland of dashed hopes and dreams was restored to its former glory."
msgstr "　……ありし日の夢の廃棄場は、一夜かぎりの王国に生まれ変わる。"

#. Occurrence 5B_1:5853:5604: scene=5B_1
#: 5B_1:5853
msgctxt "text_id=5604 | speaker=unknown"
msgid "  It was an immortal monster ready to devour reality-"
msgstr "　それは現実を侵食する不死身の魔物。"

#. Occurrence 5B_1:5858:5605: scene=5B_1
#: 5B_1:5858
msgctxt "text_id=5605 | speaker=unknown"
msgid "  a dark fairy tale that, once unleashed, would never let its prey escape."
msgstr "　<一度|ひとたび>解き放たれれば、決して獲物を逃がさない暗黒童話。"

#. Occurrence 5B_1:5890:5606: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0026; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:5890
msgctxt "text_id=5606 | speaker=alice"
msgid "\"Run if you dare."
msgstr "「逃げられるものなら逃げてみせて。"

#. Occurrence 5B_1:5896:5607: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0027; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:5896
msgctxt "text_id=5607 | speaker=alice"
msgid "  I don't believe you'll get far, but if you can survive the night, I'll concede this round to you.\""
msgstr "　どこまで行けるか分からないけど―――この夜を越える事ができたのなら、貴女の勝ちにしてあげる」"

#. Occurrence 5B_1:5917:5608: scene=5B_1
#: 5B_1:5917
msgctxt "text_id=5608 | speaker=unknown"
msgid "  Her declaration marked the start of a desperate battle."
msgstr "　……絶望的な戦いの開幕宣言。"

#. Occurrence 5B_1:5922:5609: scene=5B_1
#: 5B_1:5922
msgctxt "text_id=5609 | speaker=unknown"
msgid "  The witch in black laughed at her friend,"
msgstr "　親愛と悲しみ、それと無邪気な愉悦をこめて、"

#. Occurrence 5B_1:5927:5610: scene=5B_1
#: 5B_1:5927
msgctxt "text_id=5610 | speaker=unknown"
msgid "  her musical mirth filled with affection, sadness, and innocent delight."
msgstr "　黒衣の魔女は友人へと<歌|わら>いかけた。"

#. Occurrence 5B_10:42:5611: scene=5B_10
#: 5B_10:42
msgctxt "text_id=5611 | speaker=unknown"
msgid "  But hope was something ever fleeting."
msgstr "　けれど、希望はいつだって束の間のもの。"

#. Occurrence 5B_10:47:5612: scene=5B_10
#: 5B_10:47
msgctxt "text_id=5612 | speaker=unknown"
msgid "  In fact, it lasted not even three hundred yards."
msgstr "　彼らの希望は三百メートル分しか続かなかった。"

#. Occurrence 5B_10:53:5613: scene=5B_10
#: 5B_10:53
msgctxt "text_id=5613 | speaker=unknown"
msgid "  The edge of the amusement park may well have been the edge of the world."
msgstr "　遊園地の果ては、何の比喩もなく“世界の果て”そのものだったのだから。"

#. Occurrence 5B_10:250:5614: scene=5B_10
#: 5B_10:250
msgctxt "text_id=5614 | speaker=unknown"
msgid "  Dozens of undulating horizons could be seen,"
msgstr "　波立つ、何十という地平線。"

#. Occurrence 5B_10:255:5615: scene=5B_10
#: 5B_10:255
msgctxt "text_id=5615 | speaker=unknown"
msgid "  crowding the sky like a giant cloud, or a thick curtain,"
msgstr "　それは<群雲|むらくも>のような、<緞帳|どんちょう>のような、"

#. Occurrence 5B_10:260:5616: scene=5B_10
#: 5B_10:260
msgctxt "text_id=5616 | speaker=unknown"
msgid "  or perhaps, groaning lips."
msgstr "　あるいは呻きをもらす<唇|ひだ>のような、"

#. Occurrence 5B_10:265:5617: scene=5B_10
#: 5B_10:265
msgctxt "text_id=5617 | speaker=unknown"
msgid "  It was the end of the road; the outer limit of an outrageous and fantastical realm."
msgstr "　あまりにも奇怪で、あまりにも童話めいた、この世界の行き止まり。"

#. Occurrence 5B_10:271:5618: scene=5B_10
#: 5B_10:271
msgctxt "text_id=5618 | speaker=unknown"
msgid "  And yet..."
msgstr "　―――さながら。"

#. Occurrence 5B_10:271:5619: scene=5B_10
#: 5B_10:271
msgctxt "text_id=5619 | speaker=unknown"
msgid "  Aoko found it to be much like the last page of an enormous picture book."
msgstr "　巨大な紙芝居の最後の一枚だと、彼女は思った。"

#. Occurrence 5B_10:426:5620: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0000; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:426
msgctxt "text_id=5620 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5B_10:432:5621: scene=5B_10
#: 5B_10:432
msgctxt "text_id=5621 | speaker=unknown"
msgid "  The sight turned her mind blank."
msgstr "　その光景を前にした時、青子は不覚にも、一切の思考を放棄した。"

#. Occurrence 5B_10:437:5622: scene=5B_10
#: 5B_10:437
msgctxt "text_id=5622 | speaker=unknown"
msgid "  \"Well, this is about as bad as it gets,\" she thought."
msgstr "　……ああ、たいへんな事になったな、と。"

#. Occurrence 5B_10:442:5623: scene=5B_10
#: 5B_10:442
msgctxt "text_id=5623 | speaker=unknown"
msgid "  The Snark―this island of despair―had, at last, brought Aoko to her knees as she stared at the swelling border."
msgstr "　波立つ境界線を見て、ようやく、この<絶望島|スナーク>に膝を屈した。"

#. Occurrence 5B_10:533:5624: scene=5B_10
#: 5B_10:533
msgctxt "text_id=5624 | speaker=unknown"
msgid "  The park indeed had an end."
msgstr "　遊園地に終わりはあった。"

#. Occurrence 5B_10:538:5625: scene=5B_10
#: 5B_10:538
msgctxt "text_id=5625 | speaker=unknown"
msgid "  Even now, as Aoko and Soujyuro had expected, a fence divided the amusement park from the residential area neighboring it."
msgstr "　青子たちの知っている通り、遊園地と住宅街を<隔|へだ>てる鉄柵はこうして今も。"

#. Occurrence 5B_10:558:5626: scene=5B_10
#: 5B_10:558
msgctxt "text_id=5626 | speaker=unknown"
msgid "  It had both doubled in height and been made sturdier, another hurdle she had foreseen before even laying eyes on it."
msgstr "　鉄柵は二倍ぐらい高くなっていたり、なんだか装飾が頑丈になっていたりするけど、それも想定の範囲内。"

#. Occurrence 5B_10:563:5627: scene=5B_10
#: 5B_10:563
msgctxt "text_id=5627 | speaker=unknown"
msgid "  Expecting it to have been Snarkified, Aoko had come prepared to demolish an obstacle or two."
msgstr "　たとえ鉄柵がスナーク化していようと、壁の一枚や二枚なら撃ち抜く<気概|つもり>で彼女はここまでやって来たのだから。"

#. Occurrence 5B_10:569:5628: scene=5B_10
#: 5B_10:569
msgctxt "text_id=5628 | speaker=unknown"
msgid "  But this..."
msgstr "　……けれど。"

#. Occurrence 5B_10:574:5629: scene=5B_10
#: 5B_10:574
msgctxt "text_id=5629 | speaker=unknown"
msgid "  This construction before her went far beyond a mere wall."
msgstr "　目前に広がるモノは、もはや境界ですらなかった。"

#. Occurrence 5B_10:647:5630: scene=5B_10
#: 5B_10:647
msgctxt "text_id=5630 | speaker=unknown"
msgid "  It was an ocean that separated the underworld from the mortal one."
msgstr "　この異界と外界を分かつ海。"

#. Occurrence 5B_10:652:5631: scene=5B_10
#: 5B_10:652
msgctxt "text_id=5631 | speaker=unknown"
msgid "  The iron fence was like a restless, surging sea."
msgstr "　鉄柵は寄せ返す<波濤|はとう>の如く。"

#. Occurrence 5B_10:657:5632: scene=5B_10
#: 5B_10:657
msgctxt "text_id=5632 | speaker=unknown"
msgid "  One or two walls could easily be toppled."
msgstr "　一枚、二枚はたやすく破れる。"

#. Occurrence 5B_10:662:5633: scene=5B_10
#: 5B_10:662
msgctxt "text_id=5633 | speaker=unknown"
msgid "  Even ten or twenty could be dealt with one way or another."
msgstr "　十枚、二十枚までは何とか進める。"

#. Occurrence 5B_10:667:5634: scene=5B_10
#: 5B_10:667
msgctxt "text_id=5634 | speaker=unknown"
msgid "  Between the power left in her body and that which filled the park, putting on a brave front was within her power. She could fully mobilize her circuits and her crest to the point of burnout in a last-ditch effort, like some reenactment of the parting of the Red Sea."
msgstr "　残った自身の魔力と、遊園地に満ちた魔力と、魔術回路と刻印を焼き切れるまで総動員すれば、ただ一度きり、<十戒|じっかい>の真似事ぐらいはやってみせると強がれる。"

#. Occurrence 5B_10:707:5635: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0001; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:707
msgctxt "text_id=5635 | speaker=aoko"
msgid "\"But then that would be it.\""
msgstr "「―――でも、それで終わり」"

#. Occurrence 5B_10:713:5636: scene=5B_10
#: 5B_10:713
msgctxt "text_id=5636 | speaker=unknown"
msgid "  Even if a path could be opened, she would not have the energy left to walk it."
msgstr "　この海を割った後、青子には立ち上がる体力さえ残らない。"

#. Occurrence 5B_10:718:5637: scene=5B_10
#: 5B_10:718
msgctxt "text_id=5637 | speaker=unknown"
msgid "  And it was obvious what would become of her afterward."
msgstr "　……その後の運命は明白だ。"

#. Occurrence 5B_10:723:5638: scene=5B_10
#: 5B_10:723
msgctxt "text_id=5638 | speaker=unknown"
msgid "  The residents would hardly forgive her for wreaking such havoc around their park. Like ants drawn to honey, they would swarm the helpless girl and tear her to pieces."
msgstr "　さんざん遊園地を壊してまわった青子を、住人たちは決して許しはしないだろう。<蜜|みつ>にたかる<蟻|あり>の如く、動けなくなった少女を八つ裂きにする。"

#. Occurrence 5B_10:757:5639: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0002; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:757
msgctxt "text_id=5639 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5B_10:763:5640: scene=5B_10
#: 5B_10:763
msgctxt "text_id=5640 | speaker=unknown"
msgid "  Despondent and exhausted, she felt the faint sting of remorse."
msgstr "　<落胆|らくたん>と疲れから、微かな後悔がこぼれる。"

#. Occurrence 5B_10:768:5641: scene=5B_10
#: 5B_10:768
msgctxt "text_id=5641 | speaker=unknown"
msgid "  Escaping the park..."
msgstr "　遊園地から外に出る。"

#. Occurrence 5B_10:773:5642: scene=5B_10
#: 5B_10:773
msgctxt "text_id=5642 | speaker=unknown"
msgid "  Looking back on how they had gotten here, Aoko recognized that her choices had been her undoing."
msgstr "　その選択自体が間違いだったと認めて、青子は来た道を振り返った。"

#. Occurrence 5B_10:924:5643: scene=5B_10
#: 5B_10:924
msgctxt "text_id=5643 | speaker=unknown"
msgid "  Under the golden full moon, beams of steel bent and merged like wire-frame sculptures."
msgstr "　<金色|こんじき>の満月の下、鉄骨はうねり、針金細工のように集まっている。"

#. Occurrence 5B_10:939:5644: scene=5B_10
#: 5B_10:939
msgctxt "text_id=5644 | speaker=unknown"
msgid "  It was only a matter of time before the amusement park itself became one colossal monster."
msgstr "　遊園地そのものが巨大な“怪物”になるのも時間の問題だ。"

#. Occurrence 5B_10:944:5645: scene=5B_10
#: 5B_10:944
msgctxt "text_id=5645 | speaker=unknown"
msgid "  The horde of familiars, gathered in the plaza where Alice was, had formed an impenetrable blockade around her."
msgstr "　有珠のいる広場には大量の使い魔が集っており近寄れもしない。"

#. Occurrence 5B_10:957:5646: scene=5B_10
#: 5B_10:957
msgctxt "text_id=5646 | speaker=unknown"
msgid "  Just above the head of the boy beside her, the whispering egg―called Scratch Dumpty―continued to shuffle what appeared on its surface."
msgstr "　傍らに立つ少年の頭上には、かわらず表面をシャッフルし続ける<囁く卵|スクラッチ・ダンプティ>。"

#. Occurrence 5B_10:1020:5647: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0000; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1020
msgctxt "text_id=5647 | speaker=soujuurou"
msgid "\"Aozaki!\""
msgstr "「―――蒼崎！」"

#. Occurrence 5B_10:1071:5648: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0003; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1071
msgctxt "text_id=5648 | speaker=aoko"
msgid "\"Sizuki?\""
msgstr "「静希君……？」"

#. Occurrence 5B_10:1141:5649: scene=5B_10
#: 5B_10:1141
msgctxt "text_id=5649 | speaker=unknown"
msgid "  The boy's voice snapped Aoko out of her trance."
msgstr "　少年の声に、止まっていた思考が動き出す。"

#. Occurrence 5B_10:1146:5650: scene=5B_10
#: 5B_10:1146
msgctxt "text_id=5650 | speaker=unknown"
msgid "  If only for a moment."
msgstr "　……けれど、それも一瞬。"

#. Occurrence 5B_10:1151:5651: scene=5B_10
#: 5B_10:1151
msgctxt "text_id=5651 | speaker=unknown"
msgid "  The stark reality of the situation quickly dawned on the novice mage―"
msgstr "　魔術師である青子は現状を把握してしまう。"

#. Occurrence 5B_10:1156:5652: scene=5B_10
#: 5B_10:1156
msgctxt "text_id=5652 | speaker=unknown"
msgid "  the sheer hopelessness of it all, as it ripped out and snatched away any will she had to resist."
msgstr "　その絶望が、彼女から抗う<選択|いし>を根こそぎ奪っていた。"

#. Occurrence 5B_10:1241:5653: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0001; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1241
msgctxt "text_id=5653 | speaker=soujuurou"
msgid "\"Let's head for the gate. It's hopeless here, but we might have a chance at the entrance."
msgstr "「<正門|ゲート>に行こう。ここはどうしようもないけど、入り口ならもうちょっとマシだろう。"

#. Occurrence 5B_10:1247:5654: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0002; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1247
msgctxt "text_id=5654 | speaker=soujuurou"
msgid "  That Flat Snark thing. You said it has its own set of rules to follow, right?"
msgstr "　フラットスナークだっけ？　コイツにもルールがあるって言ったじゃないか。"

#. Occurrence 5B_10:1254:5655: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0003; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1254
msgctxt "text_id=5655 | speaker=soujuurou"
msgid "Then, we need to think about the basics. The fence would have been impassable from the start, but the gate might still work as an entrance and exit.\""
msgstr "なら、これは役割の問題だ。はじめから鉄柵は通れない壁だけど、正門なら出入り口として機能しているかも知れない」"

#. Occurrence 5B_10:1282:5656: scene=5B_10
#: 5B_10:1282
msgctxt "text_id=5656 | speaker=unknown"
msgid "  Soujyuro had not given in to panic."
msgstr "　草十郎はパニックに<陥|おちい>っていない。"

#. Occurrence 5B_10:1287:5657: scene=5B_10
#: 5B_10:1287
msgctxt "text_id=5657 | speaker=unknown"
msgid "  Aoko found herself honestly admiring Soujyuro's ability to analyze Snark's characteristics, given the circumstances."
msgstr "　この状況でスナークの特性を読み取れるのは凄いな、と青子は素直に感心した。"

#. Occurrence 5B_10:1292:5658: scene=5B_10
#: 5B_10:1292
msgctxt "text_id=5658 | speaker=unknown"
msgid "  Now calm, she steeled her resolve."
msgstr "　冷めきった、覚悟を決めた心持ちで。"

#. Occurrence 5B_10:1326:5659: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0004; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1326
msgctxt "text_id=5659 | speaker=aoko"
msgid "\"You're right. The gate is a good option."
msgstr "「……そうね。たしかに門はあると思う。"

#. Occurrence 5B_10:1332:5660: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0005; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1332
msgctxt "text_id=5660 | speaker=aoko"
msgid "  But just getting there will be a challenge. Even the weakest enemies, those loaves, are becoming hard to deal with."
msgstr "　けど、たどり着くのは難しいわ。一番弱かった焼きたてパンですら、今はもうアレだもの。"

#. Occurrence 5B_10:1338:5661: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0006; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1338
msgctxt "text_id=5661 | speaker=aoko"
msgid "  Plus, the best of her familiars are just going to keep gathering at the plaza and the entrance. I mean, the gate itself might be a monster even worse than the Ferris wheel. It's designed to look like a giant Kitsy.\""
msgstr "　広場や入り口にはもっと上等なのがたむろしてるだろうし、門だって、あの観覧車以上の怪物かもしれない。たしか大きなキッツィーちゃんだったでしょ、正門って」"

#. Occurrence 5B_10:1411:5662: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0004; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1411
msgctxt "text_id=5662 | speaker=soujuurou"
msgid "\"So you're not going to the front gate?\""
msgstr "「……蒼崎は正門には行かないのか？」"

#. Occurrence 5B_10:1417:5663: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0007; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1417
msgctxt "text_id=5663 | speaker=aoko"
msgid "\"Nah. We have a better chance over here.\""
msgstr "「まあね。それよりこっちの方が現実的だし」"

#. Occurrence 5B_10:1431:5664: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0005; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1431
msgctxt "text_id=5664 | speaker=soujuurou"
msgid "\"...?\""
msgstr "「？」"

#. Occurrence 5B_10:1502:5665: scene=5B_10
#: 5B_10:1502
msgctxt "text_id=5665 | speaker=unknown"
msgid "  Aoko took another glance at the undulating iron fences."
msgstr "　青子は波立つ鉄柵を<一瞥|いちべつ>する。"

#. Occurrence 5B_10:1507:5666: scene=5B_10
#: 5B_10:1507
msgctxt "text_id=5666 | speaker=unknown"
msgid "  It was too late to achieve their goal of making it out alive."
msgstr "　既に『生きて脱出する』という目標は達成できない。"

#. Occurrence 5B_10:1512:5667: scene=5B_10
#: 5B_10:1512
msgctxt "text_id=5667 | speaker=unknown"
msgid "  In that case, she decided to prioritize the other promise she had made."
msgstr "　である以上、残ったもう一つの約束を優先しようと、彼女は心を切り替えていた。"

#. Occurrence 5B_10:1541:5668: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0008; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1541
msgctxt "text_id=5668 | speaker=aoko"
msgid "\"I'm gonna go ahead and break down the fences here. You have to escape once you see an opening."
msgstr "「今からこの鉄柵を壊すから、貴方はそこから外に出て。"

#. Occurrence 5B_10:1547:5669: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0009; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1547
msgctxt "text_id=5669 | speaker=aoko"
msgid "  Then my job will be done.\""
msgstr "　それで、私の役割はおしまいよ」"

#. Occurrence 5B_10:1600:5670: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0006; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1600
msgctxt "text_id=5670 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5B_10:1606:5671: scene=5B_10
#: 5B_10:1606
msgctxt "text_id=5671 | speaker=unknown"
msgid "  Though her words were few, her tone told the whole story."
msgstr "　言葉は少なかったが、淡々とした声がすべてを物語っている。"

#. Occurrence 5B_10:1611:5672: scene=5B_10
#: 5B_10:1611
msgctxt "text_id=5672 | speaker=unknown"
msgid "  She was telling him to escape by himself."
msgstr "　彼女は彼に、ひとりで逃げろと言ったのだ。"

#. Occurrence 5B_10:1683:5673: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0007; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1683
msgctxt "text_id=5673 | speaker=soujuurou"
msgid "\"It's not possible."
msgstr "「……信じられない。"

#. Occurrence 5B_10:1689:5674: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0008; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1689
msgctxt "text_id=5674 | speaker=soujuurou"
msgid "  You can't destroy them by yourself, Aozaki.\""
msgstr "　こんなの、蒼崎だけじゃ壊せないだろう」"

#. Occurrence 5B_10:1702:5675: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0010; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1702
msgctxt "text_id=5675 | speaker=aoko"
msgid "\"If I were by myself, you'd be right. But right now, the park is actually helping me. With this much fuel, all I need to do is aim and pull the trigger. One good blast should be enough."
msgstr "「私だけならね。でも、今はこの遊園地が味方してる。燃料がこれだけあるんだから、私は銃身になるだけでいいんだし。一発でかいのお見舞いしてやるわ。"

#. Occurrence 5B_10:1708:5676: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0011; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1708
msgctxt "text_id=5676 | speaker=aoko"
msgid "  That said, I'll only be able to do it once, so as soon as I open a hole, I need you to run like your life depends on it.\""
msgstr "　……ま、それでも一回が限度だから、穴をあけたら、アンタには全力で走り抜けてもらうしかないけど」"

#. Occurrence 5B_10:1728:5677: scene=5B_10
#: 5B_10:1728
msgctxt "text_id=5677 | speaker=unknown"
msgid "  She would carve a path through this iron sea of fences,"
msgstr "　この鉄柵の海に道を作る。"

#. Occurrence 5B_10:1733:5678: scene=5B_10
#: 5B_10:1733
msgctxt "text_id=5678 | speaker=unknown"
msgid "  gambling on one final effort: a great incantation to launch the biggest projectile she could manage."
msgstr "　それは彼女の持てる力を総動員しての、一度きりの大詠唱、大射程の極限魔弾。"

#. Occurrence 5B_10:1801:5679: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0009; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1801
msgctxt "text_id=5679 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5B_10:1807:5680: scene=5B_10
#: 5B_10:1807
msgctxt "text_id=5680 | speaker=unknown"
msgid "  As an outsider, Soujyuro could not even begin to imagine just how much of a burden this would be for her. All he could imagine was a hazy vision of Aoko being left behind in this park."
msgstr "　門外漢である草十郎には、それがどれほどの負担をかけるものか想像もできない。ただ漠然と、遊園地に取り残される青子の姿が思い浮かぶ。"

#. Occurrence 5B_10:1866:5681: scene=5B_10
#: 5B_10:1866
msgctxt "text_id=5681 | speaker=unknown"
msgid "  What would happen to her?"
msgstr "　……残された彼女はどうなるのか。"

#. Occurrence 5B_10:1871:5682: scene=5B_10
#: 5B_10:1871
msgctxt "text_id=5682 | speaker=unknown"
msgid "  Would that girl in black come to save her?"
msgstr "　あの黒衣の少女は彼女を助けるのか。"

#. Occurrence 5B_10:1937:5683: scene=5B_10
#: 5B_10:1937
msgctxt "text_id=5683 | speaker=unknown"
msgid "  Cruel as it was to imagine, he knew she would not."
msgstr "　無慈悲な話だが、それはない。"

#. Occurrence 5B_10:1942:5684: scene=5B_10
#: 5B_10:1942
msgctxt "text_id=5684 | speaker=unknown"
msgid "  After Aoko had exhausted her very best in order to save him, that girl would not stay her hand."
msgstr "　青子が草十郎を助けるために最善を尽くした以上、あの少女も手を<緩|ゆる>めはしないだろう。"

#. Occurrence 5B_10:2014:5685: scene=5B_10
#: 5B_10:2014
msgctxt "text_id=5685 | speaker=unknown"
msgid "  The only way Alice would let Aoko off the hook was if Aoko killed Soujyuro as payment."
msgstr "　有珠が青子を見逃すとしたら、それは青子が自分の<命|いのち>惜しさに草十郎を殺した時だけだ。"

#. Occurrence 5B_10:2019:5686: scene=5B_10
#: 5B_10:2019
msgctxt "text_id=5686 | speaker=unknown"
msgid "  And so..."
msgstr "　そして、"

#. Occurrence 5B_10:2091:5687: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0012; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:2091
msgctxt "text_id=5687 | speaker=aoko"
msgid "\"Get back about fifty feet."
msgstr "「二十メートルぐらい離れてて。"

#. Occurrence 5B_10:2098:5688: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0013; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:2098
msgctxt "text_id=5688 | speaker=aoko"
msgid "It'll take time to cast, but I'll make sure to finish this before that egg gets hardboiled.\""
msgstr "<詠唱|じゅんび>に手間どるけど、その卵の表面がゆで上がるまでには終わらせるから」"

#. Occurrence 5B_10:2104:5689: scene=5B_10
#: 5B_10:2104
msgctxt "text_id=5689 | speaker=unknown"
msgid "  It went without saying that this was the only path."
msgstr "　言うまでもなく、彼女はその道を選ばない。"

#. Occurrence 5B_10:2180:5690: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0010; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2180
msgctxt "text_id=5690 | speaker=soujuurou"
msgid "\"Wait. I want to know."
msgstr "「待ってくれ。"

#. Occurrence 5B_10:2180:5691: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0010; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2180
msgctxt "text_id=5691 | speaker=soujuurou"
msgid "  Is there even a point in letting me go?\""
msgstr "　俺を逃がすっていうけど、それに意味はあるのか、蒼崎」"

#. Occurrence 5B_10:2261:5692: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0014; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:2261
msgctxt "text_id=5692 | speaker=aoko"
msgid "\"None. Even once you get out, there's no way you'll be able to escape Alice forever."
msgstr "「……ないけど。外に出られたところで有珠から逃げきれるとは思えないし。"

#. Occurrence 5B_10:2268:5693: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0015; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:2268
msgctxt "text_id=5693 | speaker=aoko"
msgid "But I'm stubborn to the very end. I said I'd protect you, so I'm damn well going to do my best to keep you alive.\""
msgstr "けど、これぐらいは最後の意地よ。守るって言ったんだから、できるところまでやらないと」"

#. Occurrence 5B_10:2343:5694: scene=5B_10
#: 5B_10:2343
msgctxt "text_id=5694 | speaker=unknown"
msgid "  Surprised by her seemingly moral stance, Soujyuro saw Aoko in a new light."
msgstr "　その芯の強さを、彼は驚きながら再認識した。"

#. Occurrence 5B_10:2348:5695: scene=5B_10
#: 5B_10:2348
msgctxt "text_id=5695 | speaker=unknown"
msgid "  ...Ah. But of course."
msgstr "　……つまりはそういうこと。"

#. Occurrence 5B_10:2353:5696: scene=5B_10
#: 5B_10:2353
msgctxt "text_id=5696 | speaker=unknown"
msgid "  Soujyuro realized that she was not fighting for his sake, but for the sake of her pride."
msgstr "　彼女は草十郎のためではなく、自分の誇りのために戦っている。"

#. Occurrence 5B_10:2435:5697: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0011; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2435
msgctxt "text_id=5697 | speaker=soujuurou"
msgid "\"...Right. I guess you did say that."
msgstr "「……うん、そうだったな。"

#. Occurrence 5B_10:2441:5698: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0012; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2441
msgctxt "text_id=5698 | speaker=soujuurou"
msgid "  But it's not like you to let me go by myself.\""
msgstr "　けど、それなら俺だけ逃がすのはらしくないぞ」"

#. Occurrence 5B_10:2447:5699: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0016; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:2447
msgctxt "text_id=5699 | speaker=aoko"
msgid "\"Oh, give me a break! Just move already!\""
msgstr "「な、なによ。いいから離れてて」"

#. Occurrence 5B_10:2453:5700: scene=5B_10
#: 5B_10:2453
msgctxt "text_id=5700 | speaker=unknown"
msgid "  Aoko eased off, just a bit."
msgstr "　なんとなく、ちょっとだけ後退する青子。"

#. Occurrence 5B_10:2520:5701: scene=5B_10
#: 5B_10:2520
msgctxt "text_id=5701 | speaker=unknown"
msgid "  She recalled how, an hour ago, he had gotten the better of her."
msgstr "　つい一時間ほど前、この顔に一本とられた事を思い出したのだ。"

#. Occurrence 5B_10:2591:5702: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0013; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2591
msgctxt "text_id=5702 | speaker=soujuurou"
msgid "\"Aozaki. If you're still willing to fight, then let's do it some other way."
msgstr "「蒼崎。まだ意地を張れるんなら、他の事をやろう。"

#. Occurrence 5B_10:2642:5703: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0014; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2642
msgctxt "text_id=5703 | speaker=soujuurou"
msgid "  If you can destroy that monster of a fence, then let's put your power to better use.\""
msgstr "　このお化けみたいな鉄柵を壊せるなら、他に壊すべきものがあるはずだ」"

#. Occurrence 5B_10:2722:5704: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0017; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:2722
msgctxt "text_id=5704 | speaker=aoko"
msgid "\"There isn't anything else I can do! Sorry, but all I can do is destroy what I can see. Dying for some forlorn hope isn't how I want to go out."
msgstr "「ないわよ。悪いけど、私は目に見えるものしか壊せないの。最後までカタチのない希望にすがるとか、考えるのも寒気がする。"

#. Occurrence 5B_10:2737:5705: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0018; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:2737
msgctxt "text_id=5705 | speaker=aoko"
msgid "Don't you get it? The fact is, blowing this thing up to let you slip out is all I can manage. I can't beat Flat Snark, or anything else. It's the least I can do after―\""
msgstr "いい？　今はフラットスナークなんかより、この壁を壊してアンタを<足抜|あしぬ>けさせるのが私の現実。私に負える最大限の責任って―――」"

#. Occurrence 5B_10:2765:5706: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0015; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2765
msgctxt "text_id=5706 | speaker=soujuurou"
msgid "\"So you're going to run from this responsibility, too?\""
msgstr "「逃げるのか」"

#. Occurrence 5B_10:2770:5707: scene=5B_10
#: 5B_10:2770
msgctxt "text_id=5707 | speaker=unknown"
msgid "  Aoko was just about to turn her back on him when Soujyuro clutched her hand."
msgstr "　背中を向けようとした青子の手が掴まれる。"

#. Occurrence 5B_10:2845:5708: scene=5B_10
#: 5B_10:2845
msgctxt "text_id=5708 | speaker=unknown"
msgid "  His words caused something inside of her to boil with rage."
msgstr "　その一言が少女の心を<沸騰|ふっとう>させた。"

#. Occurrence 5B_10:2850:5709: scene=5B_10
#: 5B_10:2850
msgctxt "text_id=5709 | speaker=unknown"
msgid "  It was as though someone had set her heart on fire."
msgstr "　本当に、心臓に火を放たれたようだ。"

#. Occurrence 5B_10:2855:5710: scene=5B_10
#: 5B_10:2855
msgctxt "text_id=5710 | speaker=unknown"
msgid "  The surprise that pricked open her true feelings and the disappointment she felt toward herself thawed her frozen limbs."
msgstr "　本心を突かれた驚きと、自分自身への不甲斐なさが、凍っていた手足を蘇らせる。"

#. Occurrence 5B_10:2889:5711: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0019; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:2889
msgctxt "text_id=5711 | speaker=aoko"
msgid "\"Why you...! Don't get it backward! I'M the one letting YOU escape, not the other way around! I'll blow the whole damn park if I feel like it, just you watch!\""
msgstr "「誰が―――！　逃げるのはそっちで、逃がしてあげるのはこっちだって言うのよ！　甘く見ないで、いざとなったら遊園地ごと爆破してみせるわ！」"

#. Occurrence 5B_10:2958:5712: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0016; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2958
msgctxt "text_id=5712 | speaker=soujuurou"
msgid "\"Okay. In that case, it'd be a waste to help me escape right now."
msgstr "「そうか。なら、ここで俺を逃がすのは無駄だな。"

#. Occurrence 5B_10:2965:5713: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0017; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2965
msgctxt "text_id=5713 | speaker=soujuurou"
msgid "Save that move for when you really mean it. I'll give you a hand until then.\""
msgstr "その気迫は本命のためにとっておこう。それまでは俺も手伝うから」"

#. Occurrence 5B_10:3053:5714: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0020; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3053
msgctxt "text_id=5714 | speaker=aoko"
msgid "\"Huh?! YOU help ME?! Talk about a waste of time!"
msgstr "「はあ!?　手伝う!?　それこそ無駄な気遣いよ！"

#. Occurrence 5B_10:3059:5715: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0021; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3059
msgctxt "text_id=5715 | speaker=aoko"
msgid "  Now you're really pissing me off. Just get out of here, you dimwit! What use do I have for a dunce whose special power is running himself ragged?!\""
msgstr "　あったまきた、いいから逃げろバカ！　だいたい、走りづめで息もたえだえなヤツなんか使えないわよ！」"

#. Occurrence 5B_10:3065:5716: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0018; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:3065
msgctxt "text_id=5716 | speaker=soujuurou"
msgid "\"I may be pretty exhausted,"
msgstr "「そりゃいいかげんヘトヘトだけど。"

#. Occurrence 5B_10:3072:5717: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0019; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:3072
msgctxt "text_id=5717 | speaker=soujuurou"
msgid " but you're in worse shape, Aozaki. Just look at yourself. You're tired and injured.\""
msgstr "そういう蒼崎なんか、疲れ以上に傷の方が痛んでるだろ」"

#. Occurrence 5B_10:3155:5718: scene=5B_10
#: 5B_10:3155
msgctxt "text_id=5718 | speaker=unknown"
msgid "  Not to mention the injury to her back that Aoko had nearly forgotten about."
msgstr "　青子本人ですら忘れかけていた背中の痛み。"

#. Occurrence 5B_10:3160:5719: scene=5B_10
#: 5B_10:3160
msgctxt "text_id=5719 | speaker=unknown"
msgid "  Even now, she couldn't ignore the pain that the automaton had inflicted on her spine."
msgstr "　自動人形に強打された彼女の背中は、今では無視できないほどの痛みを<訴|うった>えていた。"

#. Occurrence 5B_10:3165:5720: scene=5B_10
#: 5B_10:3165
msgctxt "text_id=5720 | speaker=unknown"
msgid "  With iron will, she'd managed to push it out of her mind. Mostly."
msgstr "　青子は単に、鉄の自制心で背中の傷を後回しにしていただけなのだ。"

#. Occurrence 5B_10:3186:5721: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0020; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:3186
msgctxt "text_id=5721 | speaker=soujuurou"
msgid "\"Even without any of that magecraft stuff, I'm still in better shape than you are. I could probably even carry you all the way to the entrance if I needed to.\""
msgstr "「ほら。魔術とか抜きにすれば、まだ俺の方がマシじゃないか。入り口までおぶっていくコトぐらいなら、なんとか」"

#. Occurrence 5B_10:3217:5722: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0022; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3217
msgctxt "text_id=5722 | speaker=aoko"
msgid "\"Don't make promises you can't keep."
msgstr "「できないコトは口にしないで。"

#. Occurrence 5B_10:3223:5723: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0023; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3223
msgctxt "text_id=5723 | speaker=aoko"
msgid "  Just... go. I'm used to this, and you're not. This is your first time facing this sort of thing, right?"
msgstr "　……もう、いいから行って。慣れているもの、私は。でも貴方は違う。こういうの初めてでしょ？"

#. Occurrence 5B_10:3229:5724: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0024; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3229
msgctxt "text_id=5724 | speaker=aoko"
msgid "  So, it's okay.\""
msgstr "　だから、いいの」"

#. Occurrence 5B_10:3324:5725: scene=5B_10
#: 5B_10:3324
msgctxt "text_id=5725 | speaker=unknown"
msgid "  The fact that they were a team..."
msgstr "　こうして協力されるのも、"

#. Occurrence 5B_10:3329:5726: scene=5B_10
#: 5B_10:3329
msgctxt "text_id=5726 | speaker=unknown"
msgid "  The fact that she would still have to kill him after all of this..."
msgstr "　結局はそのあと少年を殺さなければいけない事も、"

#. Occurrence 5B_10:3334:5727: scene=5B_10
#: 5B_10:3334
msgctxt "text_id=5727 | speaker=unknown"
msgid "  None of the irony was lost on her as she said these words."
msgstr "　全部ひっくるめて彼女は言った。"

#. Occurrence 5B_10:3340:5728: scene=5B_10
#: 5B_10:3340
msgctxt "text_id=5728 | speaker=unknown"
msgid "  It didn't matter anymore."
msgstr "　もういいの、と。"

#. Occurrence 5B_10:3385:5729: scene=5B_10
#: 5B_10:3385
msgctxt "text_id=5729 | speaker=unknown"
msgid "  Still, Soujyuro didn't let go of her hand;"
msgstr "　けれど、草十郎は手を離さなかった。"

#. Occurrence 5B_10:3390:5730: scene=5B_10
#: 5B_10:3390
msgctxt "text_id=5730 | speaker=unknown"
msgid "  he gripped it even harder."
msgstr "　掴んだ手の力は一段と増している。"

#. Occurrence 5B_10:3395:5731: scene=5B_10
#: 5B_10:3395
msgctxt "text_id=5731 | speaker=unknown"
msgid "  His expression was the same as ever. Aoko frowned, trying to figure out if he was upset with her."
msgstr "　<表情|かお>はいつものままだけど、もしかして怒っているのかな、と青子は眉を<曇|くも>らせた。"

#. Occurrence 5B_10:3449:5732: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0021; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:3449
msgctxt "text_id=5732 | speaker=soujuurou"
msgid "\"You're right. This is my first time with this sort of thing."
msgstr "「たしかに、こういうのは初めてだ。"

#. Occurrence 5B_10:3455:5733: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0022; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:3455
msgctxt "text_id=5733 | speaker=soujuurou"
msgid "  But I've experienced my own fair share of danger in the mountains. I've even been attacked by a deer, you know.\""
msgstr "　けど、山じゃ危険な目ぐらいあってる。<鹿|シカ>に襲われた事だってあるんだぞ、俺は」"

#. Occurrence 5B_10:3522:5734: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0025; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3522
msgctxt "text_id=5734 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5B_10:3542:5735: scene=5B_10
#: 5B_10:3542
msgctxt "text_id=5735 | speaker=unknown"
msgid "  As a city girl, she had no idea what it meant to be attacked by a deer, but his determination was apparent enough."
msgstr "　少女は都会の人間で、シカ、なんて単語を出されてもいまいち実感は湧かなかったけれど、少年には確かな覚悟があると感じ取れた。"

#. Occurrence 5B_10:3569:5736: scene=5B_10
#: 5B_10:3569
msgctxt "text_id=5736 | speaker=unknown"
msgid "  True..."
msgstr "　……たしかに。"

#. Occurrence 5B_10:3574:5737: scene=5B_10
#: 5B_10:3574
msgctxt "text_id=5737 | speaker=unknown"
msgid "  Looking back on it now, he had maintained his composure through it all."
msgstr "　振り返れば、彼は努めて冷静だった。"

#. Occurrence 5B_10:3579:5738: scene=5B_10
#: 5B_10:3579
msgctxt "text_id=5738 | speaker=unknown"
msgid "  A normal person would barely be able to talk through such panic."
msgstr "　普通ならパニック状態で会話する事さえ困難だろう。"

#. Occurrence 5B_10:3584:5739: scene=5B_10
#: 5B_10:3584
msgctxt "text_id=5739 | speaker=unknown"
msgid "  Perhaps growing up deep in the mountains, far from civilization, had taught him how to stay calm in the face of so much."
msgstr "　それをここまで、なんとか冷静でいようと努力できるのは、文明から離れた山奥で暮らしていたからなのか。"

#. Occurrence 5B_10:3666:5740: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0023; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:3666
msgctxt "text_id=5740 | speaker=soujuurou"
msgid "\"So trust me. Just a little.\""
msgstr "「だから信じてくれ。少しでいいから」"

#. Occurrence 5B_10:3672:5741: scene=5B_10
#: 5B_10:3672
msgctxt "text_id=5741 | speaker=unknown"
msgid "  He spoke his plain, unadulterated feelings,"
msgstr "　飾り気のない本心。"

#. Occurrence 5B_10:3677:5742: scene=5B_10
#: 5B_10:3677
msgctxt "text_id=5742 | speaker=unknown"
msgid "  and released his hand."
msgstr "　簡潔な気持ちを口にして、草十郎は手を離した。"

#. Occurrence 5B_10:3682:5743: scene=5B_10
#: 5B_10:3682
msgctxt "text_id=5743 | speaker=unknown"
msgid "  There was no lie in him."
msgstr "　……少年の言葉に嘘はない。"

#. Occurrence 5B_10:3687:5744: scene=5B_10
#: 5B_10:3687
msgctxt "text_id=5744 | speaker=unknown"
msgid "  In fact, he was too honest; so much that she found it hard to believe him."
msgstr "　それが余計、少女には信じられなかった。"

#. Occurrence 5B_10:3772:5745: scene=5B_10
#: 5B_10:3772
msgctxt "text_id=5745 | speaker=unknown"
msgid "  Soujyuro had no reason to go that far."
msgstr "　だって、草十郎にはそこまでの事をする理由がない。"

#. Occurrence 5B_10:3777:5746: scene=5B_10
#: 5B_10:3777
msgctxt "text_id=5746 | speaker=unknown"
msgid "  As it stood, Aoko had no future."
msgstr "　今の青子にはあらゆる未来がない。"

#. Occurrence 5B_10:3782:5747: scene=5B_10
#: 5B_10:3782
msgctxt "text_id=5747 | speaker=unknown"
msgid "  After confessing this and telling him to escape, why did this boy still offer to help a person like her?"
msgstr "　それを白状して逃げろと言っているのに、どうしてこの少年は、こんな自分に協力すると言うのだろう―――"

#. Occurrence 5B_10:3811:5748: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0026; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3811
msgctxt "text_id=5748 | speaker=aoko"
msgid "\"I don't understand. Why do all this?"
msgstr "「分からない。どうしてそこまでするの。"

#. Occurrence 5B_10:3817:5749: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0027; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3817
msgctxt "text_id=5749 | speaker=aoko"
msgid "  You're going to die if you stay with me."
msgstr "　私に付き合えば貴方は死ぬのよ。"

#. Occurrence 5B_10:3824:5750: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0028; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3824
msgctxt "text_id=5750 | speaker=aoko"
msgid "This is it. This is your last chance. Think it through. You should be running.\""
msgstr "これが最後だから、ちゃんと考えてよね。……貴方はここで逃げるべきよ」"

#. Occurrence 5B_10:3901:5751: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0024; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:3901
msgctxt "text_id=5751 | speaker=soujuurou"
msgid "\"I know, but I'm not going anywhere.\""
msgstr "「それは分かるよ。でも行かない」"

#. Occurrence 5B_10:3906:5752: scene=5B_10
#: 5B_10:3906
msgctxt "text_id=5752 | speaker=unknown"
msgid "  Soujyuro answered immediately, realizing that Aoko was looking for his reason."
msgstr "　即答しながら、青子はその理由をこそ求めている、と草十郎は気が付いた。"

#. Occurrence 5B_10:3911:5753: scene=5B_10
#: 5B_10:3911
msgctxt "text_id=5753 | speaker=unknown"
msgid "  This level of insight in Soujyuro demanded a round of applause."
msgstr "　普段の彼からすればまさに<喝采|かっさい>ものの察しの良さで、"

#. Occurrence 5B_10:3926:5754: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0025; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:3926
msgctxt "text_id=5754 | speaker=soujuurou"
msgid "\"If I do, you'll die, Aozaki.\""
msgstr "「そうすると、蒼崎が死んでしまいそうだ」"

#. Occurrence 5B_10:3931:5755: scene=5B_10
#: 5B_10:3931
msgctxt "text_id=5755 | speaker=unknown"
msgid "  His words were as irrational as always."
msgstr "　でた言葉は、いつも通りの理由の無さ。"

#. Occurrence 5B_10:4016:5756: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0029; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:4016
msgctxt "text_id=5756 | speaker=aoko"
msgid "\"But why!? Why do it? Why go so far for me!?\""
msgstr "「だから、どうしてそこまでするのよアンタはっ！」"

#. Occurrence 5B_10:4021:5757: scene=5B_10
#: 5B_10:4021
msgctxt "text_id=5757 | speaker=unknown"
msgid "  She was yelling out of frustration."
msgstr "　苛立ちから怒鳴り付ける。"

#. Occurrence 5B_10:4026:5758: scene=5B_10
#: 5B_10:4026
msgctxt "text_id=5758 | speaker=unknown"
msgid "  After thinking for a moment, Soujyuro replied."
msgstr "　少年は少しだけ考えこんでから、"

#. Occurrence 5B_10:4033:5759: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0026; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:4033
msgctxt "text_id=5759 | speaker=soujuurou"
msgid "\"I guess it's because... I like you.\""
msgstr "「―――そりゃあ、君が好きだからだろ」"

#. Occurrence 5B_10:4047:5760: scene=5B_10
#: 5B_10:4047
msgctxt "text_id=5760 | speaker=unknown"
msgid "  Simple and to the point."
msgstr "　あっさりと。"

#. Occurrence 5B_10:4052:5761: scene=5B_10
#: 5B_10:4052
msgctxt "text_id=5761 | speaker=unknown"
msgid "  His face seemed to ask why she would even question him so."
msgstr "　なんでそんなこと訊くんだ？　なんて顔で返答した。"

#. Occurrence 5B_10:4142:5762: scene=5B_10
#: 5B_10:4142
msgctxt "text_id=5762 | speaker=unknown"
msgid "  There was a pause, no more than two seconds."
msgstr "　……一秒か、たぶん二秒ほど。"

#. Occurrence 5B_10:4147:5763: scene=5B_10
#: 5B_10:4147
msgctxt "text_id=5763 | speaker=unknown"
msgid "  His surprise attack had stopped Aoko in her tracks."
msgstr "　あまりの不意打ちに、青子の時間は止まってしまった。"

#. Occurrence 5B_10:4152:5764: scene=5B_10
#: 5B_10:4152
msgctxt "text_id=5764 | speaker=unknown"
msgid "  Alice was not the only one who had an ace up her sleeve."
msgstr "　切り札を隠していたのは有珠だけではなかったようだ。"

#. Occurrence 5B_10:4157:5765: scene=5B_10
#: 5B_10:4157
msgctxt "text_id=5765 | speaker=unknown"
msgid "  That line reached deeper even than Flat Snark could ever hope to."
msgstr "　今の一言は、フラットスナークなんかより底が深い。"

#. Occurrence 5B_10:4177:5766: scene=5B_10
#: 5B_10:4177
msgctxt "text_id=5766 | speaker=unknown"
msgid "  All Aoko could respond with was an expression of pure shock."
msgstr "　青子にとってはただただ呆れるばかりの返答。"

#. Occurrence 5B_10:4182:5767: scene=5B_10
#: 5B_10:4182
msgctxt "text_id=5767 | speaker=unknown"
msgid "  It was a simple, stubborn reason. The strongest kind on Earth."
msgstr "　けれど単純で頑強な、地上でいちばん強い理由。"

#. Occurrence 5B_10:4215:5768: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0030; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:4215
msgctxt "text_id=5768 | speaker=aoko"
msgid "\"...Ugh.\""
msgstr "「―――はあ」"

#. Occurrence 5B_10:4280:5769: scene=5B_10
#: 5B_10:4280
msgctxt "text_id=5769 | speaker=unknown"
msgid "  Soujyuro Sizuki was indeed incomprehensible, to be able to work unconditionally with someone who was trying to kill him."
msgstr "　自分を殺そうとしている相手に無条件で協力出来るなんて、静希草十郎はやっぱり分からない。"

#. Occurrence 5B_10:4285:5770: scene=5B_10
#: 5B_10:4285
msgctxt "text_id=5770 | speaker=unknown"
msgid "  But she felt as though she'd finally grasped a sliver of his true nature."
msgstr "　ただ少しだけ、青子はこの少年の<為人|ひととなり>が掴めた気がした。"

#. Occurrence 5B_10:4291:5771: scene=5B_10
#: 5B_10:4291
msgctxt "text_id=5771 | speaker=unknown"
msgid "  Tobimaru and the others' assessment of him was correct..."
msgstr "　鳶丸たちの評価は、たぶん、間違ってはいないのだ。"

msgctxt "text_id=5772 | speaker=unknown"
msgid " as vexing as it was to her to admit."
msgstr "口惜しいことに。"

#. Occurrence 5B_10:4378:5773: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0031; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:4378
msgctxt "text_id=5773 | speaker=aoko"
msgid "\"Even though I can't stand you... You sure are a dip, you know.\""
msgstr "「莫迦ね。私は貴方のこと、嫌いなのに」"

#. Occurrence 5B_10:4438:5774: scene=5B_10
#: 5B_10:4438
msgctxt "text_id=5774 | speaker=unknown"
msgid "  He laughed at her sour grumbling. At this point, he was used to her insults."
msgstr "　なんだか負け惜しみのような呟きに、少年は知ってるよ、と苦笑した。"

#. Occurrence 5B_10:4519:5775: scene=5B_10
#: 5B_10:4519
msgctxt "text_id=5775 | speaker=unknown"
msgid "  Their clash of wills ended here."
msgstr "　意地の張り合いはここで終わり。"

#. Occurrence 5B_10:4524:5776: scene=5B_10
#: 5B_10:4524
msgctxt "text_id=5776 | speaker=unknown"
msgid "  Aoko's blood ran hot from her blazing heart."
msgstr "　火を放たれた心臓が、青子の体に熱い血液を走らせる。"

#. Occurrence 5B_10:4529:5777: scene=5B_10
#: 5B_10:4529
msgctxt "text_id=5777 | speaker=unknown"
msgid "  If he was going to make a face like that, all she could do was try to think of a way to get them both home."
msgstr "　だってあんな顔をされたら、ふたりそろって生還する方法しか考えられない。"

#. Occurrence 5B_10:4605:5778: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0032; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:4605
msgctxt "text_id=5778 | speaker=aoko"
msgid "\"Running away isn't really my thing, anyway."
msgstr "「……ま、私だって逃げっぱなしは性に合わないし。"

#. Occurrence 5B_10:4611:5779: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0033; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:4611
msgctxt "text_id=5779 | speaker=aoko"
msgid "  Fine. I'll stick it out to the end. And if you're going to stay with me, Sizuki, I'm sure we can find some way for you to help.\""
msgstr "　いいわよ、最後まで粘ってみる。それに静希君が付き合ってくれるなら、何かの役には立つでしょう」"

#. Occurrence 5B_10:4637:5780: scene=5B_10
#: 5B_10:4637
msgctxt "text_id=5780 | speaker=unknown"
msgid "  Though her tone had lightened, there was still hesitation in her eyes."
msgstr "　軽口を叩きながらも、青子の眼にはまだ迷いがあった。"

#. Occurrence 5B_10:4642:5781: scene=5B_10
#: 5B_10:4642
msgctxt "text_id=5781 | speaker=unknown"
msgid "  It was only natural. Aoko had not even a clue as to how to begin to fight the Snark."
msgstr "　当然だ。戦うも何も、青子にはスナークの正体、その糸口すら掴めていない。"

#. Occurrence 5B_10:4647:5782: scene=5B_10
#: 5B_10:4647
msgctxt "text_id=5782 | speaker=unknown"
msgid "  If only she had been just a bit more skilled, or had trained just a bit more, there might have been some way to look for it."
msgstr "　自分がもう少し器用で、もう少しだけ修練を積んでいたのなら、あるいはスナークを探る手段もあっただろうに。"

#. Occurrence 5B_10:4803:5783: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0034; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:4803
msgctxt "text_id=5783 | speaker=aoko"
msgid "\"I'm better than this. If only I had a way to peel back its true form.\""
msgstr "「……我ながら情けない。せめて、正体を暴く手がかりでもあればいいんだけど」"

#. Occurrence 5B_10:4809:5784: scene=5B_10
#: 5B_10:4809
msgctxt "text_id=5784 | speaker=unknown"
msgid "  Unconsciously, she let her apprehension show."
msgstr "　知らず、不安をこぼす。"

#. Occurrence 5B_10:4814:5785: scene=5B_10
#: 5B_10:4814
msgctxt "text_id=5785 | speaker=unknown"
msgid "  Sniveling was pointless."
msgstr "　こんな弱音、口にしても仕方がない。"

#. Occurrence 5B_10:4819:5786: scene=5B_10
#: 5B_10:4819
msgctxt "text_id=5786 | speaker=unknown"
msgid "  She would just have to figure it out by herself, but―"
msgstr "　その問題は自分が解決するしかない、と青子は自らを<鼓|こ><舞|ぶ>しようとして、"

#. Occurrence 5B_10:4937:5787: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0027; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:4937
msgctxt "text_id=5787 | speaker=soujuurou"
msgid "\"Hmm? What, that's all we need to figure out?\""
msgstr "「ん？　なんだ、正体さえ分かればいいのか？」"

#. Occurrence 5B_10:4951:5788: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0035; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:4951
msgctxt "text_id=5788 | speaker=aoko"
msgid "\"Huh?\""
msgstr "「へ？」"

#. Occurrence 5B_10:4956:5789: scene=5B_10
#: 5B_10:4956
msgctxt "text_id=5789 | speaker=unknown"
msgid "  Aoko gave him a look, as if to ask what *that* was supposed to mean."
msgstr "　なにそれどういうイミ？　なんて顔をする青子と、"

#. Occurrence 5B_10:4970:5790: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0028; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:4970
msgctxt "text_id=5790 | speaker=soujuurou"
msgid "\"I mean, you asked me earlier to look for something weird, right?\""
msgstr "「いや、だからおかしなモノはどれかってコトだろ？」"

#. Occurrence 5B_10:4975:5791: scene=5B_10
#: 5B_10:4975
msgctxt "text_id=5791 | speaker=unknown"
msgid "  Soujyuro also made a face that suggested she should have brought it up sooner."
msgstr "　言ってくれれば良かったのに、なんて顔をする草十郎。"

#. Occurrence 5B_10:5072:5792: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0036; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:5072
msgctxt "text_id=5792 | speaker=aoko"
msgid "\"Wait, you know what it is?!\""
msgstr "「ちょっ―――分かるの、アンタ!?」"

#. Occurrence 5B_10:5078:5793: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0029; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:5078
msgctxt "text_id=5793 | speaker=soujuurou"
msgid "\"I think so. Well, I've been wondering about it for a while, actually.\""
msgstr "「たぶん。いや、けっこう前から気になっていたんだけど」"

#. Occurrence 5B_10:5099:5794: scene=5B_10
#: 5B_10:5099
msgctxt "text_id=5794 | speaker=unknown"
msgid "  Soujyuro whispered in her ear quietly, so as not to be overheard."
msgstr "　草十郎は誰かに聞かれないよう、こっそりと青子に耳打ちをする。"

#. Occurrence 5B_10:5171:5795: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0037; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:5171
msgctxt "text_id=5795 | speaker=aoko"
msgid "\"...Ah.\""
msgstr "「――――――あ」"

#. Occurrence 5B_10:5183:5796: scene=5B_10
#: 5B_10:5183
msgctxt "text_id=5796 | speaker=unknown"
msgid "  It was certainly unexpected,"
msgstr "　意外と言えば意外、"

#. Occurrence 5B_10:5188:5797: scene=5B_10
#: 5B_10:5188
msgctxt "text_id=5797 | speaker=unknown"
msgid "  but then again, equally obvious. After he explained the mistake, she knew right away that he was correct."
msgstr "　当然と言えば当然の“間違い”を教えられて、青子はその“答え”が正しい事を直感した。"

#. Occurrence 5B_10:5194:5798: scene=5B_10
#: 5B_10:5194
msgctxt "text_id=5798 | speaker=unknown"
msgid "  At last, she had an inkling of Flat Snark's original form. Namely..."
msgstr "　敵の正体。フラットスナークの本体とは、つまり―――"

#. Occurrence 5B_11:401:5799: scene=5B_11
#: 5B_11:401
msgctxt "text_id=5799 | speaker=unknown"
msgid "  They strategized for ten minutes."
msgstr "　密談は十分で終わった。"

#. Occurrence 5B_11:406:5800: scene=5B_11
#: 5B_11:406
msgctxt "text_id=5800 | speaker=unknown"
msgid "  After deliberating the Snark's true form and figuring out a plan of attack, the two exchanged nods in acceptance of their roles."
msgstr "　スナーク本体の考察と、その撃破方法を導きだして、ふたりは互いの役割に頷きあう。"

#. Occurrence 5B_11:438:5801: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_11_0000; voice_prefix=A10; voice_category=1; scene=5B_11
#: 5B_11:438
msgctxt "text_id=5801 | speaker=aoko"
msgid "\"We'll be splitting up now."
msgstr "「それじゃ、ここからは別行動ね。"

#. Occurrence 5B_11:444:5802: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_11_0001; voice_prefix=A10; voice_category=1; scene=5B_11
#: 5B_11:444
msgctxt "text_id=5802 | speaker=aoko"
msgid "  Just don't make it a repeat of the blunder in the house of mirrors. You're the crux of this operation. If you bungle the start even a little, there's no coming back from this one.\""
msgstr "　でもミラーハウスの時みたいなのは勘弁してよ。この作戦の<肝|きも>は貴方なんだから。開始一分でドジったら、ホントに打つ手なしだからね」"

#. Occurrence 5B_11:523:5803: scene=5B_11
#: 5B_11:523
msgctxt "text_id=5803 | speaker=unknown"
msgid "  Though she jabbed him for his previous failure as a decoy, her voice was bright."
msgstr "　ミラーハウスでの囮役失敗の件をチクチクとつつく青子だが、その声は明るい。"

#. Occurrence 5B_11:528:5804: scene=5B_11
#: 5B_11:528
msgctxt "text_id=5804 | speaker=unknown"
msgid "  Aoko's original vigor had returned to her at Soujyuro's discovery of the truth."
msgstr "　草十郎の発見からこっち、彼女本来の力強さが戻っている。"

#. Occurrence 5B_11:599:5805: scene=5B_11
#: 5B_11:599
msgctxt "text_id=5805 | speaker=unknown"
msgid "  Meanwhile, Soujyuro was also getting serious in his own way."
msgstr "　一方、草十郎も彼なりに真剣だ。"

#. Occurrence 5B_11:604:5806: scene=5B_11
#: 5B_11:604
msgctxt "text_id=5806 | speaker=unknown"
msgid "  He took Aoko's warning to heart."
msgstr "　青子の注意を真面目に受けとめている。"

#. Occurrence 5B_11:690:5807: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_11_0002; voice_prefix=A10; voice_category=1; scene=5B_11
#: 5B_11:690
msgctxt "text_id=5807 | speaker=aoko"
msgid "\"Good. But remember that our positions are reversed this time."
msgstr "「……ならいいけど。いい、さっきと立場は反対よ。"

#. Occurrence 5B_11:696:5808: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_11_0003; voice_prefix=A10; voice_category=1; scene=5B_11
#: 5B_11:696
msgctxt "text_id=5808 | speaker=aoko"
msgid "  If we fail, I'm not the one who's going to die―you are. I won't be there to clean up your mess, so watch your step.\""
msgstr "　失敗したら死ぬのは私じゃなくてそっち。もうフォローに回れないから、できるだけ慎重にね」"

#. Occurrence 5B_11:768:5809: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_11_0000; voice_prefix=A30; voice_category=3; scene=5B_11
#: 5B_11:768
msgctxt "text_id=5809 | speaker=soujuurou"
msgid "\"I know. After all this, I regret what not taking your advice earlier. I'll be careful.\""
msgstr "「分かってる。いまさらながら、やっぱりさっき逃がしてもらえば良かったと思うぐらい、慎重だ」"

#. Occurrence 5B_11:774:5810: scene=5B_11
#: 5B_11:774
msgctxt "text_id=5810 | speaker=unknown"
msgid "  Soujyuro nodded, telling her to leave it to him. Though he made it sound like he was holding a grudge, it seemed to him to be the only way of showing her his resolve."
msgstr "　任せてくれ、と頷く草十郎。恨み言のような台詞だが、彼なりに決意を表しているらしい。"

#. Occurrence 5B_11:779:5811: scene=5B_11
#: 5B_11:779
msgctxt "text_id=5811 | speaker=unknown"
msgid "  Aoko let out a sigh of defeat. Once more, she couldn't figure him out."
msgstr "　ちぐはぐで分かりづらい草十郎の仕草に、青子はまったく、と降参するようなため息ひとつ。"

#. Occurrence 5B_11:853:5812: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_11_0004; voice_prefix=A10; voice_category=1; scene=5B_11
#: 5B_11:853
msgctxt "text_id=5812 | speaker=aoko"
msgid "\"Seriously, I can't tell if you're a big idiot or a big hero."
msgstr "「ほんと、大バカなんだか大物なんだか。"

#. Occurrence 5B_11:865:5813: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_11_0005; voice_prefix=A10; voice_category=1; scene=5B_11
#: 5B_11:865
msgctxt "text_id=5813 | speaker=aoko"
msgid "  Whichever one it is, I'm counting on you. Don't let me down.\""
msgstr "　―――でも任せた。期待してるわ、静希君」"

#. Occurrence 5B_11:924:5814: scene=5B_11
#: 5B_11:924
msgctxt "text_id=5814 | speaker=unknown"
msgid "  She had wanted to say that she believed in him, but apparently, that was too embarrassing for her."
msgstr "　信じている、と返してやりたかったが、さすがにそれは気恥ずかしかったらしい。"

#. Occurrence 5B_11:1009:5815: scene=5B_11
#: 5B_11:1009
msgctxt "text_id=5815 | speaker=unknown"
msgid "  Aoko turned away from Soujyuro and began to run."
msgstr "　青子は草十郎に背を向けて走り出す。"

#. Occurrence 5B_11:1014:5816: scene=5B_11
#: 5B_11:1014
msgctxt "text_id=5816 | speaker=unknown"
msgid "  She had begun to think that maybe this change of pace was not so bad after all."
msgstr "　まあ、こういう風にペースを崩されるのも、たまにはいいかもしれない、なんて思いながら。"

#. Occurrence 5B_11:1065:5817: scene=5B_11
#: 5B_11:1065
msgctxt "text_id=5817 | speaker=unknown"
msgid "  And so ended the intermission."
msgstr "　―――休憩は終わりを告げた。"

#. Occurrence 5B_11:1070:5818: scene=5B_11
#: 5B_11:1070
msgctxt "text_id=5818 | speaker=unknown"
msgid "  The young cast members were handed their new lines."
msgstr "　未熟な役者に新たな脚本が手渡される。"

#. Occurrence 5B_11:1076:5819: scene=5B_11
#: 5B_11:1076
msgctxt "text_id=5819 | speaker=unknown"
msgid "  Whatever happened next,"
msgstr "　さて、結果はどうあれ。"

#. Occurrence 5B_11:1081:5820: scene=5B_11
#: 5B_11:1081
msgctxt "text_id=5820 | speaker=unknown"
msgid "  the night of witches had, at long last, entered its climax."
msgstr "　長かった魔法使いの夜は、最後の幕に入ったらしい。"

#. Occurrence 5B_12:87:5821: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0000; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:87
msgctxt "text_id=5821 | speaker=alice"
msgid "\"...They split up? You're sure?\""
msgstr "「―――別行動？　あの二人が？」"

#. Occurrence 5B_12:105:5822: scene=5B_12
#: 5B_12:105
msgctxt "text_id=5822 | speaker=unknown"
msgid "  She was filled with foreboding at the robin's report."
msgstr "　駒鳥からの報告に、少女は不吉な響きを感じとった。"

#. Occurrence 5B_12:110:5823: scene=5B_12
#: 5B_12:110
msgctxt "text_id=5823 | speaker=unknown"
msgid "  Apparently, they had gone in opposite directions."
msgstr "　彼らはそれぞれ反対方向に移動したらしい。"

#. Occurrence 5B_12:115:5824: scene=5B_12
#: 5B_12:115
msgctxt "text_id=5824 | speaker=unknown"
msgid "  The park's residents had set off after the boy witness, and it would take them mere minutes to capture him, so the bird said."
msgstr "　遊園地の住人たちは目撃者の少年を追いかけ、あと数分で捕まえ、処理するという。"

#. Occurrence 5B_12:191:5825: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0001; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:191
msgctxt "text_id=5825 | speaker=alice"
msgid "\"What do you mean? Is it actually him they're following? Not Aoko in disguise?\""
msgstr "「……どういう事？　追いかけているのは本当に彼？　青子が変装しているのではなく？」"

#. Occurrence 5B_12:198:5826: scene=5B_12
#: 5B_12:198
msgctxt "text_id=5826 | speaker=unknown"
msgid "  The robin flapped its wings, chirping away any doubt."
msgstr "　駒鳥は羽をすくめて主人の疑いを鳴きとばす。"

#. Occurrence 5B_12:203:5827: scene=5B_12
#: 5B_12:203
msgctxt "text_id=5827 | speaker=unknown"
msgid "  It had seen them with its own two eyes. Aoko was heading for the plaza, while the cocky brat was making a run for the roller coaster."
msgstr "　自分の目に間違いはない、広場方面に向かっているのは青子で、コースター方面に逃げているのはとっぽい小僧だと。"

#. Occurrence 5B_12:270:5828: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0002; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:270
msgctxt "text_id=5828 | speaker=alice"
msgid "\"Are you saying that Aoko abandoned him?"
msgstr "「青子が彼を見捨てた、ですって？"

#. Occurrence 5B_12:306:5829: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0003_0; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:306
msgctxt "text_id=5829 | speaker=alice"
msgid "  ...It sounds a little too good to be true."
msgstr "　……そんな簡単な事ならいいけど。"

#. Occurrence 5B_12:318:5830: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0003_1; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:318
msgctxt "text_id=5830 | speaker=alice"
msgid " Is Dumpty still on his tail?\""
msgstr "ダンプティは彼に張り付いているの？」"

#. Occurrence 5B_12:324:5831: scene=5B_12
#: 5B_12:324
msgctxt "text_id=5831 | speaker=unknown"
msgid "  The robin nodded enthusiastically."
msgstr "　駒鳥は自信満々に頷く。"

#. Occurrence 5B_12:329:5832: scene=5B_12
#: 5B_12:329
msgctxt "text_id=5832 | speaker=unknown"
msgid "  It didn't know about the other birds, but with its superior night vision, it had seen that sucker clearly because he had moved to a high point."
msgstr "　他の鳥はともかく、夜目の利く自分ならここからでもあのカモネギっぽい坊主を見て取れる。なにしろ相手は<高|・><い|・><と|・><こ|・><ろ|・><に|・><登|・><っ|・><て|・><い|・><る|・>し。"

#. Occurrence 5B_12:420:5833: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0004; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:420
msgctxt "text_id=5833 | speaker=alice"
msgid "\"And Dumpty?"
msgstr "「ダンプティはなんて？"

#. Occurrence 5B_12:447:5834: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0005; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:447
msgctxt "text_id=5834 | speaker=alice"
msgid "  He said to let him sing to the very end? That he may never get the chance again to do so for a fool this asinine?\""
msgstr "　……最後まで<吟|うた>わせろ、こんな<褒|ほ>め殺したい<間|ま><抜|ぬ>けはまたとない、ですって？」"

#. Occurrence 5B_12:512:5835: scene=5B_12
#: 5B_12:512
msgctxt "text_id=5835 | speaker=unknown"
msgid "  Scratch Dumpty was a ticking time bomb that would drop and detonate the moment its target averted its gaze."
msgstr "　スクラッチダンプティは、捕捉した対象が目を離した途端に落下し、破裂する時限爆弾だ。"

#. Occurrence 5B_12:517:5836: scene=5B_12
#: 5B_12:517
msgctxt "text_id=5836 | speaker=unknown"
msgid "  That is, as long as his target continued to observe him. In a way, he was a gentlemanly Ploy Kickshaw, though Alice wished he would forgo such niceties when in battle."
msgstr "　対象がきちんと監視していれば落下しない、ある意味紳士的な“<童話の怪物|プロイキッシャー>”。だが乱戦時においてこれほどの嫌がらせもないだろう。"

#. Occurrence 5B_12:554:5837: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0006; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:554
msgctxt "text_id=5837 | speaker=alice"
msgid "\"...Let him have his fun. Keeping an eye on Dumpty won't save the boy anyway. Once the poem on his surface is complete, the door will open."
msgstr "「……そうね。視線を切らないだけではダンプティからは逃げられない。表面の詩が完成すれば扉が開く。"

#. Occurrence 5B_12:560:5838: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0007; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:560
msgctxt "text_id=5838 | speaker=alice"
msgid "  No matter how far he runs, Dumpty will end him for us.\""
msgstr "　彼がどこまで逃げようと、あと少しでダンプティが仕舞ってくれるわ」"

#. Occurrence 5B_12:605:5839: scene=5B_12
#: 5B_12:605
msgctxt "text_id=5839 | speaker=unknown"
msgid "  Until the park, or rather the Snark, was destroyed, Soujyuro would not be able to escape."
msgstr "　何処に行こうと、この遊園地―――いや、スナークが破壊されない以上、少年は逃げられない。"

#. Occurrence 5B_12:610:5840: scene=5B_12
#: 5B_12:610
msgctxt "text_id=5840 | speaker=unknown"
msgid "  Which meant the larger concern was Aoko."
msgstr "　なら気になるのは青子の方だ。"

#. Occurrence 5B_12:615:5841: scene=5B_12
#: 5B_12:615
msgctxt "text_id=5841 | speaker=unknown"
msgid "  Aoko had promised to protect the boy, which begged the question: where was she running to?"
msgstr "　あの少年を守ると言い切った彼女は、いま何処に向かっているのか。"

#. Occurrence 5B_12:687:5842: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0008; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:687
msgctxt "text_id=5842 | speaker=alice"
msgid "\"As long as we stay here, we can't track Aoko.\""
msgstr "「……ここにいるかぎり、青子の動向は掴めない」"

#. Occurrence 5B_12:762:5843: scene=5B_12
#: 5B_12:762
msgctxt "text_id=5843 | speaker=unknown"
msgid "  Alice looked out over the park, ignoring the robin's attempt to get her attention with its plumage."
msgstr "　羽を広げて存在をアピールする駒鳥を無視して、少女は遊園地を見渡した。"

#. Occurrence 5B_12:836:5844: scene=5B_12
#: 5B_12:836
msgctxt "text_id=5844 | speaker=unknown"
msgid "  Flat Snark had nearly reached its full size."
msgstr "　フラットスナークはもうじき育ちきる。"

#. Occurrence 5B_12:841:5845: scene=5B_12
#: 5B_12:841
msgctxt "text_id=5845 | speaker=unknown"
msgid "  It was a different breed of beast compared to the other cheap Ploys."
msgstr "　他の安価なプロイとは根本からして違う怪物。"

#. Occurrence 5B_12:846:5846: scene=5B_12
#: 5B_12:846
msgctxt "text_id=5846 | speaker=unknown"
msgid "  To her, it was one of her three most irreplaceable and precious familiars."
msgstr "　少女にとって代えのきかない、貴重な三体の使い魔のうち一体。"

#. Occurrence 5B_12:932:5847: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0009; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:932
msgctxt "text_id=5847 | speaker=alice"
msgid "\"...Yes. She's all yours, Snark."
msgstr "「……そうね。任せたわスナーク。"

#. Occurrence 5B_12:932:5848: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0009; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:932
msgctxt "text_id=5848 | speaker=alice"
msgid "  Don't hold back until Aoko is brought to her knees.\""
msgstr "　青子が<諦|あきら>めない以上、貴方も手は抜かないで」"

#. Occurrence 5B_12:938:5849: scene=5B_12
#: 5B_12:938
msgctxt "text_id=5849 | speaker=unknown"
msgid "  Alice remained where she was."
msgstr "　少女は動かない。"

#. Occurrence 5B_12:943:5850: scene=5B_12
#: 5B_12:943
msgctxt "text_id=5850 | speaker=unknown"
msgid "  With the same historical merit as the troll under the bridge and the poison-clawed reptile, Flat Snark was one of Alice's ultimate Ploys."
msgstr "　橋の巨人、毒爪トカゲと同じ<歴|か><史|ち>を持つ、<至高|しこう>のプロイ、フラットスナーク。"

#. Occurrence 5B_12:948:5851: scene=5B_12
#: 5B_12:948
msgctxt "text_id=5851 | speaker=unknown"
msgid "  She was placing her trust in its reputation and ability."
msgstr "　その名と能力を、ここは信頼する事にした。"

#. Occurrence 5B_12:998:5852: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0010; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:998
msgctxt "text_id=5852 | speaker=alice"
msgid "\"But don't forget. This is a game."
msgstr "「でも忘れないで。これはゲームよ。"

#. Occurrence 5B_12:1004:5853: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0011; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:1004
msgctxt "text_id=5853 | speaker=alice"
msgid "  When the contest is over, return to me.\""
msgstr "　勝敗がついたのなら、わたしのところに帰ってきて」"

#. Occurrence 5B_12:1068:5854: scene=5B_12
#: 5B_12:1068
msgctxt "text_id=5854 | speaker=unknown"
msgid "\"...\""
msgstr "“―――――――――”"

#. Occurrence 5B_12:1074:5855: scene=5B_12
#: 5B_12:1074
msgctxt "text_id=5855 | speaker=unknown"
msgid "  The drifting fog ignored its master's words."
msgstr "　主の言葉を、<漂|ただよ>う霧は聞き流す。"

#. Occurrence 5B_12:1079:5856: scene=5B_12
#: 5B_12:1079
msgctxt "text_id=5856 | speaker=unknown"
msgid "  It was the one thing that Alice had misread."
msgstr "　……有珠もそこだけは読み違えていた。"

#. Occurrence 5B_12:1085:5857: scene=5B_12
#: 5B_12:1085
msgctxt "text_id=5857 | speaker=unknown"
msgid "Flat Snark was a king, even among the other Ploys, of terrible, vulgar antics."
msgstr "フラットスナークはプロイの中でも<最悪|さいあく><低俗|ていぞく>な道化の王さま。"

#. Occurrence 5B_12:1090:5858: scene=5B_12
#: 5B_12:1090
msgctxt "text_id=5858 | speaker=unknown"
msgid "  Death to the defeated. Gruesome tragedy to the vanquished."
msgstr "　敗者には死を。惨たらしい悲劇を。"

#. Occurrence 5B_12:1096:5859: scene=5B_12
#: 5B_12:1096
msgctxt "text_id=5859 | speaker=unknown"
msgid "It found no pleasure unless it brought about dramatic ruination of life and wealth."
msgstr "財布も命も取りこぼす、素晴らしい破産じゃないと愉しめない。"

#. Occurrence 5B_12:1116:5860: scene=5B_12
#: 5B_12:1116
msgctxt "text_id=5860 | speaker=unknown"
msgid "\"―――――――――\""
msgstr "“―――――――――”"

#. Occurrence 5B_12:1122:5861: scene=5B_12
#: 5B_12:1122
msgctxt "text_id=5861 | speaker=unknown"
msgid "  The fog billowed like wicked laughter."
msgstr "　<邪|よこしま>な笑みのように霧が煙る。"

#. Occurrence 5B_12:1127:5862: scene=5B_12
#: 5B_12:1127
msgctxt "text_id=5862 | speaker=unknown"
msgid "  After all, only a king had the right to decide the fate of the vanquished, and the Snark's greed could not be contained."
msgstr "　そう。負かした相手をどう扱うかなんて、それこそ王さまの特権で、スナークは自分の欲望を止められない。"

#. Occurrence 5B_12:1132:5863: scene=5B_12
#: 5B_12:1132
msgctxt "text_id=5863 | speaker=unknown"
msgid "  Thus..."
msgstr "　なので―――"

#. Occurrence 5B_12:1138:5864: scene=5B_12
#: 5B_12:1138
msgctxt "text_id=5864 | speaker=unknown"
msgid "  It hadn't even the slightest intent to play fair, despite its master's orders."
msgstr "　たとえ主人の言いつけであろうと、行儀の良いフェアプレーなんて、これっぽっちも、守る気はなかったのだ。"

#. Occurrence 5B_13:119:5865: scene=5B_13
#: 5B_13:119
msgctxt "text_id=5865 | speaker=unknown"
msgid "  Over one hundred feet high."
msgstr "　地上四十メートルの高み。"

#. Occurrence 5B_13:124:5866: scene=5B_13
#: 5B_13:124
msgctxt "text_id=5866 | speaker=unknown"
msgid "  One careful step at a time, the figure made its way gingerly up the track which stretched into the heart of the amusement park."
msgstr "　遊園地の中心へ向かって延びる<骨組み|レール>の上を、慎重に慎重に、足場を確認しながら登っていく人影が一つ。"

#. Occurrence 5B_13:145:5867: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0000; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:145
msgctxt "text_id=5867 | speaker=soujuurou"
msgid "\"―, ―\""
msgstr "「―――、―――」"

#. Occurrence 5B_13:151:5868: scene=5B_13
#: 5B_13:151
msgctxt "text_id=5868 | speaker=unknown"
msgid "  He stayed his beating chest and the pounding of his breath."
msgstr "　押さえつけているのは動悸と呼吸だ。"

#. Occurrence 5B_13:156:5869: scene=5B_13
#: 5B_13:156
msgctxt "text_id=5869 | speaker=unknown"
msgid "  Even tiny movements were an obstacle to his progress."
msgstr "　今はそんな、わずかな動作すら前進の邪魔になる。"

#. Occurrence 5B_13:253:5870: scene=5B_13
#: 5B_13:253
msgctxt "text_id=5870 | speaker=unknown"
msgid "  Amazingly, the one making this pale-faced advance higher and higher was Soujyuro Sizuki."
msgstr "　顔面蒼白でより高い位置を目指しているのは、あろう事か静希草十郎である。"

#. Occurrence 5B_13:258:5871: scene=5B_13
#: 5B_13:258
msgctxt "text_id=5871 | speaker=unknown"
msgid "  Far below, he saw that a horde of bread creatures had congregated by the roller coaster platform."
msgstr "　遥か地上を見下ろせば、コースター乗り場には焼きたてパンたちの群れ。"

#. Occurrence 5B_13:263:5872: scene=5B_13
#: 5B_13:263
msgctxt "text_id=5872 | speaker=unknown"
msgid "  As they bustled this way and that, their numbers continued to increase by the minute, seemingly cheering on Soujyuro with raised arms as he made his ascent."
msgstr "　入り口で右往左往している彼らは刻一刻と数を増やしながら、レールを登っていく草十郎へ<諸手|もろて>を挙げての応援中。"

#. Occurrence 5B_13:268:5873: scene=5B_13
#: 5B_13:268
msgctxt "text_id=5873 | speaker=unknown"
msgid "  Or rather, they jeered as if beckoning him to come down."
msgstr "　もとい、下りてこいとブーイングをあげている。"

#. Occurrence 5B_13:289:5874: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0001; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:289
msgctxt "text_id=5874 | speaker=soujuurou"
msgid "\"...Well, at least they don't like heights.\""
msgstr "「……助かった。アレ、高いところは苦手なんだ」"

#. Occurrence 5B_13:329:5875: scene=5B_13
#: 5B_13:329
msgctxt "text_id=5875 | speaker=unknown"
msgid "  Of course, neither did Soujyuro, but his current state was the lesser of two evils."
msgstr "　もちろん草十郎も苦手だが、彼らに包囲されないのなら、これはこれで少しだけマシである。"

#. Occurrence 5B_13:400:5876: scene=5B_13
#: 5B_13:400
msgctxt "text_id=5876 | speaker=unknown"
msgid "  The only thing that followed him now was the floating egg."
msgstr "　追ってきているのは浮遊する卵だけ。"

#. Occurrence 5B_13:405:5877: scene=5B_13
#: 5B_13:405
msgctxt "text_id=5877 | speaker=unknown"
msgid "  After heaving a huge sigh, Soujyuro bent forward a bit and climbed the track that inclined toward the heavens."
msgstr "　草十郎は大きく息をついた後、やや前屈みになって、天に向かって延びるコースターを登っていく。"

#. Occurrence 5B_13:410:5878: scene=5B_13
#: 5B_13:410
msgctxt "text_id=5878 | speaker=unknown"
msgid "  One hundred and fifty feet now."
msgstr "　これで地上四十八メートル。"

#. Occurrence 5B_13:415:5879: scene=5B_13
#: 5B_13:415
msgctxt "text_id=5879 | speaker=unknown"
msgid "  If this were a skyscraper, he would be on the sixteenth floor."
msgstr "　ビルで言うなら十六階の高さに相当する。"

#. Occurrence 5B_13:459:5880: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0002; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:459
msgctxt "text_id=5880 | speaker=soujuurou"
msgid "\"...!\""
msgstr "「っ、―――……！」"

#. Occurrence 5B_13:513:5881: scene=5B_13
#: 5B_13:513
msgctxt "text_id=5881 | speaker=unknown"
msgid "  A strong gust of wind whipped through his hair."
msgstr "　強風が髪をさらう。"

#. Occurrence 5B_13:518:5882: scene=5B_13
#: 5B_13:518
msgctxt "text_id=5882 | speaker=unknown"
msgid "  Humans had an instinctual fear of heights."
msgstr "　人間は根本的に高所を恐れる生き物だ。"

#. Occurrence 5B_13:523:5883: scene=5B_13
#: 5B_13:523
msgctxt "text_id=5883 | speaker=unknown"
msgid "  In particular, a place like this, which called forth visions of falling to one's death, would cause a person's knees to tremble against their will."
msgstr "　ことに、このように落下のイメージを想起させる場所では、本人にその気がなくとも膝が震える。"

#. Occurrence 5B_13:528:5884: scene=5B_13
#: 5B_13:528
msgctxt "text_id=5884 | speaker=unknown"
msgid "  It was an instinct that forewarned death, urging its master to return to the safety of the ground."
msgstr "　死を<警戒|けいかい>する本能が、安全な地上への<回帰|かいき>を<促|うなが>している。"

#. Occurrence 5B_13:548:5885: scene=5B_13
#: 5B_13:548
msgctxt "text_id=5885 | speaker=unknown"
msgid "  It was a reasonable reaction."
msgstr "　それも無理からぬ事。"

#. Occurrence 5B_13:553:5886: scene=5B_13
#: 5B_13:553
msgctxt "text_id=5886 | speaker=unknown"
msgid "  Climbing the roller coaster tracks went beyond funny stories and into the realm of fantasy."
msgstr "　ジェットコースターのレールを人力で登ろうなどと、笑い話を通り越してファンタジーの領域なのだから。"

#. Occurrence 5B_13:562:5887: scene=5B_13
#: 5B_13:562
msgctxt "text_id=5887 | speaker=unknown"
msgid "  The strong winds and change in air pressure were a hindrance."
msgstr "　気圧や強風による妨害。"

#. Occurrence 5B_13:567:5888: scene=5B_13
#: 5B_13:567
msgctxt "text_id=5888 | speaker=unknown"
msgid "  His instincts screamed at him to stop, causing his limbs to go numb, his muscles to go limp, and his mind to race."
msgstr "　本能からの中止勧告、痺れる手足、筋力の衰え、とりとめなく暴走する思考。"

#. Occurrence 5B_13:573:5889: scene=5B_13
#: 5B_13:573
msgctxt "text_id=5889 | speaker=unknown"
msgid "Even if he had been tied to a lifeline, a mere fifteen feet of climbing would still have caused his thoughts to freeze out of sheer terror."
msgstr "仮に命綱をしていようと、五メートルも登れば思考は恐怖で固まってしまう。"

#. Occurrence 5B_13:593:5890: scene=5B_13
#: 5B_13:593
msgctxt "text_id=5890 | speaker=unknown"
msgid "  And it would only get worse from here, exponentially so."
msgstr "　加えて、この苦しみは倍々ゲームだ。"

#. Occurrence 5B_13:598:5891: scene=5B_13
#: 5B_13:598
msgctxt "text_id=5891 | speaker=unknown"
msgid "  Every foot forward increased the load on both his mind and his body by another degree."
msgstr "　一メートル進めば、それだけ肉体と精神にかかる負担はいや増していく。"

#. Occurrence 5B_13:667:5892: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0003; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:667
msgctxt "text_id=5892 | speaker=soujuurou"
msgid "\"...I can do this. Just a little bit more to the top...\""
msgstr "「―――よし。頂上まであと少し―――」"

#. Occurrence 5B_13:673:5893: scene=5B_13
#: 5B_13:673
msgctxt "text_id=5893 | speaker=unknown"
msgid "  The burden on his mind notwithstanding, he carefully measured the toll on his body with every step."
msgstr "　そんな精神の負担はともかく、体の調子を注意深く<測|はか>りながら草十郎は前進する。"

#. Occurrence 5B_13:678:5894: scene=5B_13
#: 5B_13:678
msgctxt "text_id=5894 | speaker=unknown"
msgid "  His legs, which had carried him running this far, threatened to buckle the moment he let down his guard."
msgstr "　走りづめだった足は、気を抜いたとたん、膝から崩れかねない。"

#. Occurrence 5B_13:684:5895: scene=5B_13
#: 5B_13:684
msgctxt "text_id=5895 | speaker=unknown"
msgid "This fatigue was likely why Aoko had stressed that Soujyuro's role was more dangerous than hers."
msgstr "青子が“草十郎の方が危ない”と念を押したのも、疲労しきった体では危険すぎるからだろう。"

#. Occurrence 5B_13:721:5896: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0004; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:721
msgctxt "text_id=5896 | speaker=soujuurou"
msgid "\"Wait. Would Aozaki have been so worried if I wasn't tired?\""
msgstr "「……待てよ。逆を言うと、疲れてなければなんとかなると思ってたんだよな、蒼崎は」"

#. Occurrence 5B_13:775:5897: scene=5B_13
#: 5B_13:775
msgctxt "text_id=5897 | speaker=unknown"
msgid "  Soujyuro laughed as he stared at the floating egg."
msgstr "　ふわふわ浮遊する卵を眺めながら、草十郎は思い出し笑いをする。"

#. Occurrence 5B_13:780:5898: scene=5B_13
#: 5B_13:780
msgctxt "text_id=5898 | speaker=unknown"
msgid "  He reflected on the course of events that had led to this absurd situation."
msgstr "　こんな無茶をする事になった<顛末|てんまつ>。"

#. Occurrence 5B_13:785:5899: scene=5B_13
#: 5B_13:785
msgctxt "text_id=5899 | speaker=unknown"
msgid "  Not even ten minutes ago, they had been engaged in conversation."
msgstr "　ほんの十分前、ふたりはこんな会話を交わしていた。"

#. Occurrence 5B_13:836:5900: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0000; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:836
msgctxt "text_id=5900 | speaker=aoko"
msgid "\"Okay. Since we know what form it's taken, we need to talk about how we're going to destroy it.\""
msgstr "「じゃあ次ね。正体が分かった以上、あとはどう壊すかを話しあいましょう」"

#. Occurrence 5B_13:936:5901: scene=5B_13
#: 5B_13:936
msgctxt "text_id=5901 | speaker=unknown"
msgid "  Soujyuro felt a shudder travel down his spine at Aoko's smug grin."
msgstr "　にんまりと笑う青子に、ぞぞっと背筋が寒くなる草十郎。"

#. Occurrence 5B_13:941:5902: scene=5B_13
#: 5B_13:941
msgctxt "text_id=5902 | speaker=unknown"
msgid "  In hindsight, Aoko had been more than happy at this point to make him do something absurd."
msgstr "　……思えば、この時から青子は草十郎に無茶をさせる気満々だったのだ。"

#. Occurrence 5B_13:1013:5903: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0005; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:1013
msgctxt "text_id=5903 | speaker=soujuurou"
msgid "\"How we're going to destroy it? Can't you just...\""
msgstr "「どう壊すかって、それなら」"

#. Occurrence 5B_13:1019:5904: scene=5B_13
#: 5B_13:1019
msgctxt "text_id=5904 | speaker=unknown"
msgid "  Soujyuro wondered aloud; from what he'd seen, Aoko had enough firepower to tear clean through the fence."
msgstr "　この鉄柵を外まで壊せる魔術があるのなら考えるまでもないのでは、と手を挙げる草十郎。"

#. Occurrence 5B_13:1024:5905: scene=5B_13
#: 5B_13:1024
msgctxt "text_id=5905 | speaker=unknown"
msgid "  He'd refrained from speculating about Flat Snark's true form because he'd felt there was nothing they could do about it, even if they knew."
msgstr "　彼がこれまでフラットスナークの本体について意見しなかったのは、ひとえに『分かっていてもどうしようもない』と思っていたからだ。"

#. Occurrence 5B_13:1044:5906: scene=5B_13
#: 5B_13:1044
msgctxt "text_id=5906 | speaker=unknown"
msgid "  But that had changed."
msgstr "　が、今は条件が違う。"

#. Occurrence 5B_13:1049:5907: scene=5B_13
#: 5B_13:1049
msgctxt "text_id=5907 | speaker=unknown"
msgid "  For Aoko, the impossible was quite literally within her grasp."
msgstr "　青子なら文字通り、不可能に手が届く。"

#. Occurrence 5B_13:1122:5908: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0001; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1122
msgctxt "text_id=5908 | speaker=aoko"
msgid "\"It won't be that easy. By my estimate, I wouldn't get within a hundred and fifty feet of the thing.\""
msgstr "「そうでもないわ。私の目算だと、あと五十メートル分、ギリギリで届かない」"

#. Occurrence 5B_13:1136:5909: scene=5B_13
#: 5B_13:1136
msgctxt "text_id=5909 | speaker=unknown"
msgid "  Despair filled Soujyuro's eyes."
msgstr "　だめじゃないか、と目で<訴|うった>える草十郎。"

#. Occurrence 5B_13:1209:5910: scene=5B_13
#: 5B_13:1209
msgctxt "text_id=5910 | speaker=unknown"
msgid "  Aoko lifted a hand to her long hair and, with a magically charged fingertip, clipped a clean tuft of it."
msgstr "　青子は自分の長髪に手をやると、魔力をこめた指で、<一房|ひとふさ>スパッと切った。"

#. Occurrence 5B_13:1290:5911: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0002; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1290
msgctxt "text_id=5911 | speaker=aoko"
msgid "\"But we can make up the difference with some elbow grease."
msgstr "「足りない分は努力と根性ってね。"

#. Occurrence 5B_13:1296:5912: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0003; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1296
msgctxt "text_id=5912 | speaker=aoko"
msgid "  Get to the highest place you can. When the time is right, I'll give you a sign. Just toss this into the air. That's all you need to do.\""
msgstr "　貴方はできるだけ高いところまで逃げて。頃合いを見て合図をだすから、そうしたらこれを空に放ってくれる？　静希君の役目はそれだけでいいから」"

#. Occurrence 5B_13:1323:5913: scene=5B_13
#: 5B_13:1323
msgctxt "text_id=5913 | speaker=unknown"
msgid "  But based on where Aoko pointed her gaze, she did not really mean to leave it up to Soujyuro to pick the highest place he could find."
msgstr "　そう言う青子の視線は、とても“できるだけ”なんて言ってはいなかった。"

#. Occurrence 5B_13:1328:5914: scene=5B_13
#: 5B_13:1328
msgctxt "text_id=5914 | speaker=unknown"
msgid "  She was staring conspicuously at one of the amusement park's two main attractions: the roller coaster."
msgstr "　彼女はこれみよがしに、遊園地二大アトラクションの一つ、ジェットコースターを見つめている。"

#. Occurrence 5B_13:1349:5915: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0006; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:1349
msgctxt "text_id=5915 | speaker=soujuurou"
msgid "\"...So, in other words, you're saying we split up, then you want me to run away from the monsters chasing me and escape to somewhere high, right?\""
msgstr "「…………。つまり、蒼崎とは別行動をとって、あの怪物たちに追われながら、高いところに逃げこめと？」"

#. Occurrence 5B_13:1370:5916: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0004; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1370
msgctxt "text_id=5916 | speaker=aoko"
msgid "\"Exactly. And hey, wouldn't you know it, the tracks of that winding roller coaster are perfect!\""
msgstr "「そういうコト。ほら、あのうねうね動き出してるコースターのレールとか、よくない？」"

#. Occurrence 5B_13:1390:5917: scene=5B_13
#: 5B_13:1390
msgctxt "text_id=5917 | speaker=unknown"
msgid "  There were two demons in this park."
msgstr "　遊園地に悪魔は二匹いる。"

#. Occurrence 5B_13:1395:5918: scene=5B_13
#: 5B_13:1395
msgctxt "text_id=5918 | speaker=unknown"
msgid "  Her smile made even Soujyuro want to respond that it was far from perfect."
msgstr "　草十郎ですら「よくない」と即答したくなる笑顔だった。"

#. Occurrence 5B_13:1468:5919: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0007; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:1468
msgctxt "text_id=5919 | speaker=soujuurou"
msgid "\"Far be for me to question your motives here, but..."
msgstr "「……疑いたくはないんだが。"

#. Occurrence 5B_13:1474:5920: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0008; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:1474
msgctxt "text_id=5920 | speaker=soujuurou"
msgid "  You're not secretly working with that girl to kill me, are you?\""
msgstr "　ホントはあの子とグルで、俺を遠回しに殺そうとしてるんじゃないか？」"

#. Occurrence 5B_13:1487:5921: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0005; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1487
msgctxt "text_id=5921 | speaker=aoko"
msgid "\"Now now. Wasn't it you who said it was okay if I was the one who killed you?\""
msgstr "「あら。私に殺されるのならいいんでしょう？」"

#. Occurrence 5B_13:1565:5922: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0009; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:1565
msgctxt "text_id=5922 | speaker=soujuurou"
msgid "\"...It's not nice to twist other people's words.\""
msgstr "「……人の失言を悪用するのは、よくないと思う」"

#. Occurrence 5B_13:1593:5923: scene=5B_13
#: 5B_13:1593
msgctxt "text_id=5923 | speaker=unknown"
msgid "  Soujyuro hung his head. This was not sane."
msgstr "　とても正気じゃない、とうなだれる草十郎。"

#. Occurrence 5B_13:1606:5924: scene=5B_13
#: 5B_13:1606
msgctxt "text_id=5924 | speaker=unknown"
msgid "  If he did as she said, he would die from exhaustion before Kitsy even had a chance to eat him."
msgstr "　青子の言う通りにしていたらキッツィーちゃんに食べられる前に過労死しそうだ。"

#. Occurrence 5B_13:1685:5925: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0006; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1685
msgctxt "text_id=5925 | speaker=aoko"
msgid "\"I'm not a monster. Hey, Look at me."
msgstr "「私だって鬼じゃないわ。ほら、こっち向いて。"

#. Occurrence 5B_13:1691:5926: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0007; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1691
msgctxt "text_id=5926 | speaker=aoko"
msgid "  I'll cast a charm on you.\""
msgstr "　おまじない、かけてあげる」"

#. Occurrence 5B_13:1705:5927: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0010; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:1705
msgctxt "text_id=5927 | speaker=soujuurou"
msgid "\"...?\""
msgstr "「？」"

#. Occurrence 5B_13:1804:5928: scene=5B_13
#: 5B_13:1804
msgctxt "text_id=5928 | speaker=unknown"
msgid "  It was the lightest of touches."
msgstr "　軽い接触。"

#. Occurrence 5B_13:1809:5929: scene=5B_13
#: 5B_13:1809
msgctxt "text_id=5929 | speaker=unknown"
msgid "  Close enough for their breath and skin to come in contact."
msgstr "　息と息、肌と肌が触れ合う距離。"

#. Occurrence 5B_13:1876:5930: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0011; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:1876
msgctxt "text_id=5930 | speaker=soujuurou"
msgid "\"...Ao―\""
msgstr "「―――、あ」"

#. Occurrence 5B_13:1882:5931: scene=5B_13
#: 5B_13:1882
msgctxt "text_id=5931 | speaker=unknown"
msgid "  \"...-zaki,\" he finished with a hushed voice."
msgstr "　おざき、と続く声が弱い。"

#. Occurrence 5B_13:1887:5932: scene=5B_13
#: 5B_13:1887
msgctxt "text_id=5932 | speaker=unknown"
msgid "  For one of them, this was a rather mundane magecraft."
msgstr "　それは、一方にとってはごく当たり前の魔術で、"

#. Occurrence 5B_13:1892:5933: scene=5B_13
#: 5B_13:1892
msgctxt "text_id=5933 | speaker=unknown"
msgid "  For the other, it was a head-spinning, intimate ambush."
msgstr "　一方にとっては頭が真っ白になるほどの、柔らかな不意打ちだった。"

#. Occurrence 5B_13:1955:5934: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0008; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1955
msgctxt "text_id=5934 | speaker=aoko"
msgid "            \"<The weight of the air, the tremble of one's breast|Be light and frail, nimble and fast.>."
msgstr "　　『―――空<気のおも|かるく、よわく>り、<胸のふる|うまく、はやく>え。"

#. Occurrence 5B_13:1961:5935: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0009; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1961
msgctxt "text_id=5935 | speaker=aoko"
msgid "                    <Light lags behind while shadows pull ahead.|Tick-tock, tick-tock, there's no time to waste.>\""
msgstr "　　　　　　ひ<かりは先|チクタクチクタク>立つ、<かげは遅|いそげやいそげ>れる。』"

#. Occurrence 5B_13:1981:5936: scene=5B_13
#: 5B_13:1981
msgctxt "text_id=5936 | speaker=unknown"
msgid "  Words that could not be produced by a normal larynx, carrying a peculiar weight to them, reverberated against his eardrums."
msgstr "　通常の声帯では発音できない、何か特殊な重みをもった声が草十郎の鼓膜に響く。"

#. Occurrence 5B_13:1986:5937: scene=5B_13
#: 5B_13:1986
msgctxt "text_id=5937 | speaker=unknown"
msgid "  If words were given colors, these would have been the color of her name: blue."
msgstr "　……もし言葉に色が見えたのなら、きっと彼女の名前通りの色だっただろう。"

#. Occurrence 5B_13:1991:5938: scene=5B_13
#: 5B_13:1991
msgctxt "text_id=5938 | speaker=unknown"
msgid "  Soujyuro's exhausted body and burning blood gently cooled."
msgstr "　疲れきっていた体が、熱くなっていた血液が、緩やかに冷やされていく。"

#. Occurrence 5B_13:2034:5939: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0010; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2034
msgctxt "text_id=5939 | speaker=aoko"
msgid "        \"<A bird in the sky, a fish in the sea, you in the distance|Fly, swim, run.>."
msgstr "　　『<鳥は空に|と　　ぶ>、<魚は海に|お　よ　ぐ>、<貴方は彼方に|か け ぬ け る>。"

#. Occurrence 5B_13:2040:5940: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0011; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2040
msgctxt "text_id=5940 | speaker=aoko"
msgid "        <Stuff doubt and anxiety in a sack.|Tick-tock, tick-tock.> <Begin the journey at dawn|Sound the alarm.>."
msgstr "　　　疑<問も不安も鞄|チクタクチクタク>の底に、旅路<の一歩は|きてきをならせ>曙に。"

#. Occurrence 5B_13:2046:5941: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0012; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2046
msgctxt "text_id=5941 | speaker=aoko"
msgid "        <A shining star falls,|The star is always in the northern sky,> <into your heart.|no matter where you go.>\""
msgstr "　　　輝<く星はするりと降|ほしはいつでもきたのそら>ちて、今は<貴方の心の内|どこまでも、いつまでも>に。』"

#. Occurrence 5B_13:2066:5942: scene=5B_13
#: 5B_13:2066
msgctxt "text_id=5942 | speaker=unknown"
msgid "  In reality, it took but a few seconds,"
msgstr "　実際には五秒ほど。"

#. Occurrence 5B_13:2071:5943: scene=5B_13
#: 5B_13:2071
msgctxt "text_id=5943 | speaker=unknown"
msgid "  but the sudden contact had felt a little longer."
msgstr "　不意を突かれた彼にとってはもう少しだけ長く感じられた触れ合いは、こうして何の失敗もなく、<名残|なごり>惜しくも完了した。"

#. Occurrence 5B_13:2135:5944: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0013; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2135
msgctxt "text_id=5944 | speaker=aoko"
msgid "\"Mesmerize successful! ...I think. This is the first time I've actually felt it take!"
msgstr "「よし、暗示成功！　成功したはず！　ここまで手応えがあったの初めてだし！"

#. Occurrence 5B_13:2141:5945: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0014; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2141
msgctxt "text_id=5945 | speaker=aoko"
msgid "  I guess all those lectures from Alice paid off!\""
msgstr "　有珠の小言もたまには役に立つじゃない！」"

#. Occurrence 5B_13:2190:5946: scene=5B_13
#: 5B_13:2190
msgctxt "text_id=5946 | speaker=unknown"
msgid "  A very merry Aoko stood aside a very confused Soujyuro."
msgstr "　はしゃぐ青子と、とにかく現状が掴めない草十郎。"

#. Occurrence 5B_13:2195:5947: scene=5B_13
#: 5B_13:2195
msgctxt "text_id=5947 | speaker=unknown"
msgid "  After he asked what the heck had occurred, she responded."
msgstr "　今のは一体なんだったのかと訊くと、"

#. Occurrence 5B_13:2222:5948: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0015; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2222
msgctxt "text_id=5948 | speaker=aoko"
msgid "\"It's an elementary suggestion. I temporarily erased your sense of fear, so you should be able to climb up there no problem."
msgstr "「簡単な暗示よ。一時的に恐怖心を消しておいたから、高いところに登っても平気なはず。"

#. Occurrence 5B_13:2228:5949: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0016; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2228
msgctxt "text_id=5949 | speaker=aoko"
msgid "  The biggest thing standing in your way is your nerves, right?"
msgstr "　あの手の作業でいちばん足を引っ張るのは動揺でしょ？"

#. Occurrence 5B_13:2240:5950: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0017; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2240
msgctxt "text_id=5950 | speaker=aoko"
msgid "  If you don't feel fear, then no matter how high you climb, it's no different from walking a balance beam!\""
msgstr "　恐怖も何も感じなければ、地上何メートルだろうと平均台とそう変わらないってワケ」"

#. Occurrence 5B_13:2312:5951: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0012; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:2312
msgctxt "text_id=5951 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5B_13:2354:5952: scene=5B_13
#: 5B_13:2354
msgctxt "text_id=5952 | speaker=unknown"
msgid "  He seemed to get it..."
msgstr "　なるほど、と手を打つ純朴少年。"

#. Occurrence 5B_13:2359:5953: scene=5B_13
#: 5B_13:2359
msgctxt "text_id=5953 | speaker=unknown"
msgid "  It actually all sounded like Greek to Soujyuro, but he accepted it as an explanation for her strange actions."
msgstr "　青子の言っている事は<眉唾|まゆつば>だが、さっきの謎の行為はそういう事か、と納得する草十郎だった。"

#. Occurrence 5B_13:2455:5954: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0013; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:2455
msgctxt "text_id=5954 | speaker=soujuurou"
msgid "\"Hah... Finally, I made it.\""
msgstr "「……はあ。やっと、着いた」"

#. Occurrence 5B_13:2461:5955: scene=5B_13
#: 5B_13:2461
msgctxt "text_id=5955 | speaker=unknown"
msgid "  He'd arrived at the summit of the track."
msgstr "　山なりのレールの頂点。"

#. Occurrence 5B_13:2466:5956: scene=5B_13
#: 5B_13:2466
msgctxt "text_id=5956 | speaker=unknown"
msgid "  From nearly two hundred feet high, Soujyuro had a bird's-eye view of the entire amusement park."
msgstr "　草十郎は地上六十メートル近い高みに到着し、遊園地を俯瞰する。"

#. Occurrence 5B_13:2486:5957: scene=5B_13
#: 5B_13:2486
msgctxt "text_id=5957 | speaker=unknown"
msgid "  He was able to spot Aoko's figure right away."
msgstr "　青子の姿はすぐに発見できた。"

#. Occurrence 5B_13:2491:5958: scene=5B_13
#: 5B_13:2491
msgctxt "text_id=5958 | speaker=unknown"
msgid "  In the plaza not so far from here, she seemed to be occupied with something conspicuous."
msgstr "　この地点からそう離れていない広場で、なにやら怪しげな作業を行っている。"

#. Occurrence 5B_13:2496:5959: scene=5B_13
#: 5B_13:2496
msgctxt "text_id=5959 | speaker=unknown"
msgid "  Her surroundings lay still."
msgstr "　青子の周囲は静かなものだ。"

#. Occurrence 5B_13:2501:5960: scene=5B_13
#: 5B_13:2501
msgctxt "text_id=5960 | speaker=unknown"
msgid "  The bread-men were still busy trying to figure how to reach Soujyuro by trial and error from the roller coaster's entrance."
msgstr "　ブレッドマンたちは草十郎を追いかけようとして、いまだコースター入り口で試行錯誤の真っ最中。"

#. Occurrence 5B_13:2506:5961: scene=5B_13
#: 5B_13:2506
msgctxt "text_id=5961 | speaker=unknown"
msgid "  They were over three hundred feet away, now."
msgstr "　距離にして、もう百メートル以上も離れている。"

#. Occurrence 5B_13:2594:5962: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0014; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:2594
msgctxt "text_id=5962 | speaker=soujuurou"
msgid "\"No wonder I'm drenched in sweat. Look how much ground I've covered.\""
msgstr "「……汗をかくはずだ。こんなに移動したのか」"

#. Occurrence 5B_13:2600:5963: scene=5B_13
#: 5B_13:2600
msgctxt "text_id=5963 | speaker=unknown"
msgid "  The strong winter gales quickly dried the sweat on his brow, but he was drenched underneath his shirt."
msgstr "　真冬の強風で額の汗はすぐに乾くが、シャツの下は汗で濡れている。"

#. Occurrence 5B_13:2605:5964: scene=5B_13
#: 5B_13:2605
msgctxt "text_id=5964 | speaker=unknown"
msgid "  This much sweat was worth at least a half-mile run, not to mention all the scares he had experienced throughout the night."
msgstr "　一キロマラソン以上の運動量プラス、冷や汗分も含まれているに違いない。"

#. Occurrence 5B_13:2633:5965: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0015; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:2633
msgctxt "text_id=5965 | speaker=soujuurou"
msgid "\"Okay. Now all I have to do is wait for the signal.\""
msgstr "「でも良かった。あとは合図を待つだけだ」"

#. Occurrence 5B_13:2639:5966: scene=5B_13
#: 5B_13:2639
msgctxt "text_id=5966 | speaker=unknown"
msgid "  He felt a wave of relief,"
msgstr "　心底から安心する。"

#. Occurrence 5B_13:2644:5967: scene=5B_13
#: 5B_13:2644
msgctxt "text_id=5967 | speaker=unknown"
msgid "  but not at the thought of Aoko destroying the Snark and this nightmarish park."
msgstr "　この方法で、青子が<遊園地|スナーク>を破壊できるから、ではない。"

#. Occurrence 5B_13:2649:5968: scene=5B_13
#: 5B_13:2649
msgctxt "text_id=5968 | speaker=unknown"
msgid "  He was simply happy that he could repay a bit of his debt from the house of mirrors."
msgstr "　彼はそんな事より、ミラーハウスでの借りを少しでも返せる気がして嬉しいのだ。"

#. Occurrence 5B_13:2776:5969: scene=5B_13
#: 5B_13:2776
msgctxt "text_id=5969 | speaker=unknown"
msgid "  A blue bullet rose from the plaza where Aoko was located."
msgstr "　青子のいた広場から青い魔弾が昇る。"

#. Occurrence 5B_13:2782:5970: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0016; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:2782
msgctxt "text_id=5970 | speaker=soujuurou"
msgid "\"That's the signal!\""
msgstr "「合図だ……！」"

#. Occurrence 5B_13:2787:5971: scene=5B_13
#: 5B_13:2787
msgctxt "text_id=5971 | speaker=unknown"
msgid "  Soujyuro stood up atop the tracks, pulled out the pouch he had stowed in his pocket, and tossed it forward."
msgstr "　草十郎はレールの上に立ち上がり、ポケットに仕舞った巾着袋を放り投げた。"

#. Occurrence 5B_13:2875:5972: scene=5B_13
#: 5B_13:2875
msgctxt "text_id=5972 | speaker=unknown"
msgid "  Without any regard for his questionable footing, he gave it a mighty overarm pitch."
msgstr "　ここが不安定な足場である事を考えない、豪快なオーバースロー。"

#. Occurrence 5B_13:2880:5973: scene=5B_13
#: 5B_13:2880
msgctxt "text_id=5973 | speaker=unknown"
msgid "  The small pouch drew a parabolic curve in Aoko's direction, quickly becoming untied in mid-air."
msgstr "　巾着は放物線を描きながら青子のいる方角に向かっていき、ほどなくして空に<解|と>けた。"

#. Occurrence 5B_13:2950:5974: scene=5B_13
#: 5B_13:2950
msgctxt "text_id=5974 | speaker=unknown"
msgid "  Inside the bag was the lock of her hair and a small stone weight."
msgstr "　巾着には彼女の髪と、重しの小石が入っていた。"

#. Occurrence 5B_13:2957:5975: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0018; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2957
msgctxt "text_id=5975 | speaker=aoko"
msgid "\"Just throw it with the wind from somewhere high up, and I'll take it from there.\""
msgstr "“高いところから風に乗せてくれれば、後はなんとかするから”"

#. Occurrence 5B_13:2963:5976: scene=5B_13
#: 5B_13:2963
msgctxt "text_id=5976 | speaker=unknown"
msgid "  Aoko had said, but it was Soujyuro's effort that had set the plan in motion."
msgstr "　青子はそう言ったが、草十郎なりに工夫した結果である。"

#. Occurrence 5B_13:2968:5977: scene=5B_13
#: 5B_13:2968
msgctxt "text_id=5977 | speaker=unknown"
msgid "  The tuft of hair remained airborne, drifting as if watching over its owner."
msgstr "　<一房|ひとふさ>の髪は、持ち主である少女を見守るように<滞空|たいくう>する。"

#. Occurrence 5B_13:3055:5978: scene=5B_13
#: 5B_13:3055
msgctxt "text_id=5978 | speaker=unknown"
msgid "  Soujyuro's job was done."
msgstr "　草十郎に託された仕事は終わった。"

#. Occurrence 5B_13:3060:5979: scene=5B_13
#: 5B_13:3060
msgctxt "text_id=5979 | speaker=unknown"
msgid "  He remained concerned about the egg hovering over him, but there was nothing he could do about it."
msgstr "　いまだ浮遊する卵は気になるが、これは彼にどうにかできる物ではない。"

#. Occurrence 5B_13:3072:5980: scene=5B_13
#: 5B_13:3072
msgctxt "text_id=5980 | speaker=unknown"
msgid "  Soujyuro breathed a sigh of relief, and leaned forward to watch the rest of the plan unfold, but then..."
msgstr "　草十郎はホッと息をついて、事の成り行きを見届けようと身を乗り出し、"

#. Occurrence 5B_13:3151:5981: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0017; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:3151
msgctxt "text_id=5981 | speaker=soujuurou"
msgid "\"Hmm?\""
msgstr "「…………むむ？」"

#. Occurrence 5B_13:3157:5982: scene=5B_13
#: 5B_13:3157
msgctxt "text_id=5982 | speaker=unknown"
msgid "  In the corner of his eye,"
msgstr "　視界の<隅|すみ>。"

#. Occurrence 5B_13:3162:5983: scene=5B_13
#: 5B_13:3162
msgctxt "text_id=5983 | speaker=unknown"
msgid "  he thought he spotted something familiar approaching Aoko."
msgstr "　青子のいる広場に近寄りつつある、なにか、見覚えのあるものを見かけた気がした。"

#. Occurrence 5B_14:139:5984: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0000; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:139
msgctxt "text_id=5984 | speaker=aoko"
msgid "\"<Connecting to Crest|Route, set.>."
msgstr "「<刻印|ルート>、<接続|セット>―――"

#. Occurrence 5B_14:347:5985: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0001; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:347
msgctxt "text_id=5985 | speaker=aoko"
msgid "  Direct current crests: First layer. Second layer. Third layer, reserved."
msgstr "　直<流数|ディレクト>紋、一層、二層―――予備に三層。"

#. Occurrence 5B_14:369:5986: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0002; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:369
msgctxt "text_id=5986 | speaker=aoko"
msgid "  Magical energy supply fixed to Greater Source."
msgstr "　魔力提供、大源に固定。"

#. Occurrence 5B_14:375:5987: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0003; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:375
msgctxt "text_id=5987 | speaker=aoko"
msgid "  Flow, check. Angle, check. Formula stability...good enough.\""
msgstr "　……<循環|じゅんかん>良し、<射角|しゃかく>良し、<術式|じゅつしき>安定、おおまか良し」"

#. Occurrence 5B_14:395:5988: scene=5B_14
#: 5B_14:395
msgctxt "text_id=5988 | speaker=unknown"
msgid "  A pattern began to carve itself into the brick street."
msgstr "　レンガの<路|うえ>に<紋様|もんよう>が刻まれていく。"

#. Occurrence 5B_14:400:5989: scene=5B_14
#: 5B_14:400
msgctxt "text_id=5989 | speaker=unknown"
msgid "  The casting of an unprecedented incantation with unprecedented range."
msgstr "　かつてない大詠唱による、かつてない大射程の魔術行使。"

#. Occurrence 5B_14:405:5990: scene=5B_14
#: 5B_14:405
msgctxt "text_id=5990 | speaker=unknown"
msgid "  Keeping the rising tension contained within her chest, the fledgling mage snapped her fingers."
msgstr "　ほのかな緊張と高揚を胸に<留|とど>めながら、新米魔術師は指を鳴らす。"

#. Occurrence 5B_14:441:5991: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0004; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:441
msgctxt "text_id=5991 | speaker=aoko"
msgid "\"Done. <Bullet configuration|Tour Plan>: <convergent launch!|Starmine!>\""
msgstr "「―――決めた。<魔弾|ツアー><形式|プラン>、<収束|スター><投射|マイン>」"

#. Occurrence 5B_14:447:5992: scene=5B_14
#: 5B_14:447
msgctxt "text_id=5992 | speaker=unknown"
msgid "  She kneeled at the center of the formula and raised her head to the night sky."
msgstr "　術式の中心に膝をつき、夜空を見上げる青子。"

#. Occurrence 5B_14:452:5993: scene=5B_14
#: 5B_14:452
msgctxt "text_id=5993 | speaker=unknown"
msgid "  Not even a glimpse of the transmogrified fantasy land around her entered her vision now."
msgstr "　御伽の国と化した遊園地だったが、もう、その片鱗すら彼女の視界には<映|うつ>らない。"

#. Occurrence 5B_14:457:5994: scene=5B_14
#: 5B_14:457
msgctxt "text_id=5994 | speaker=unknown"
msgid "  Only one thing, one untouchable thing, was reflected in her blue eyes."
msgstr "　青い目に映るのは、たったひとつの触れられぬもの。"

#. Occurrence 5B_14:511:5995: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_14_0000; voice_prefix=A30; voice_category=3; scene=5B_14
#: 5B_14:511
msgctxt "text_id=5995 | speaker=soujuurou"
msgid "\"So, this has been on my mind for a while now...\""
msgstr "「実は、ずっと気になっていた事が」"

#. Occurrence 5B_14:591:5996: scene=5B_14
#: 5B_14:591
msgctxt "text_id=5996 | speaker=unknown"
msgid "  This is how their conversation started a few minutes prior."
msgstr "　つい数分ほど前の話。"

#. Occurrence 5B_14:596:5997: scene=5B_14
#: 5B_14:596
msgctxt "text_id=5997 | speaker=unknown"
msgid "  Soujyuro began with a simple statement of fact."
msgstr "　そう切りだして、草十郎はある事実を口にした。"

#. Occurrence 5B_14:601:5998: scene=5B_14
#: 5B_14:601
msgctxt "text_id=5998 | speaker=unknown"
msgid "  In truth, it really was the simplest of discrepancies."
msgstr "　本当に単純な食い違い。"

#. Occurrence 5B_14:606:5999: scene=5B_14
#: 5B_14:606
msgctxt "text_id=5999 | speaker=unknown"
msgid "  Any difference between the reality of an hour ago and the illusion of the present was both infinitesimal and infinite."
msgstr "　一時間前までの現実と、たった今の幻想と、その最小にして最大の間違い探しを。"

#. Occurrence 5B_14:683:6000: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_14_0001; voice_prefix=A30; voice_category=3; scene=5B_14
#: 5B_14:683
msgctxt "text_id=6000 | speaker=soujuurou"
msgid "\"I thought maybe I didn't know what I was looking at because of the clouds...\""
msgstr "「雲があったから、勘違いしたんだろうけど―――」"

#. Occurrence 5B_14:689:6001: scene=5B_14
#: 5B_14:689
msgctxt "text_id=6001 | speaker=unknown"
msgid "  It was hiding in plain sight―"
msgstr "　見えているのに見えないもの。"

#. Occurrence 5B_14:694:6002: scene=5B_14
#: 5B_14:694
msgctxt "text_id=6002 | speaker=unknown"
msgid "  too impossible to be real, too outlandish to be here."
msgstr "　現実では有りえなくて、ここに有るのもおかしいもの。"

#. Occurrence 5B_14:699:6003: scene=5B_14
#: 5B_14:699
msgctxt "text_id=6003 | speaker=unknown"
msgid "  In this amusement park where every paradigm had shifted, something was brazenly flaunting its normalcy."
msgstr "　あらゆる原型が変わっていく遊園地で、堂々と、正常なカタチを見せつけていた―――"

#. Occurrence 5B_14:781:6004: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_14_0002; voice_prefix=A30; voice_category=3; scene=5B_14
#: 5B_14:781
msgctxt "text_id=6004 | speaker=soujuurou"
msgid "\"Tonight is supposed to be a new moon, Aozaki.\""
msgstr "「今夜は新月なんだ、蒼崎」"

#. Occurrence 5B_14:889:6005: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0005; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:889
msgctxt "text_id=6005 | speaker=aoko"
msgid "\"Yeah...come to think of it, that's actually what you started as.\""
msgstr "「思えば、はじめっからそのカタチだったものね、アンタは」"

#. Occurrence 5B_14:895:6006: scene=5B_14
#: 5B_14:895
msgctxt "text_id=6006 | speaker=unknown"
msgid "  The distance from the Earth to the moon was 238,900 miles."
msgstr "　月までの距離は三十八万キロメートル。"

#. Occurrence 5B_14:900:6007: scene=5B_14
#: 5B_14:900
msgctxt "text_id=6007 | speaker=unknown"
msgid "  If it truly was identical to the actual moon, then this monster indeed lived up to its eerie reputation."
msgstr "　本当に<そ|・><こ|・><ま|・><で|・><同|・><じ|・>であるなら、まさしく異名に恥じない怪物だ。"

#. Occurrence 5B_14:995:6008: scene=5B_14
#: 5B_14:995
msgctxt "text_id=6008 | speaker=unknown"
msgid "  At a distance that vast, there would have been no need to hide. It could flaunt its true form for all to see."
msgstr "　だが、そうであるのなら姿を隠す必要はない。堂々と正体を明かせばいい。"

#. Occurrence 5B_14:1000:6009: scene=5B_14
#: 5B_14:1000
msgctxt "text_id=6009 | speaker=unknown"
msgid "  But if it had to hide its true form, that meant it was vulnerable."
msgstr "　正体を隠すのは手の届く位置にいるからこそ。"

#. Occurrence 5B_14:1005:6010: scene=5B_14
#: 5B_14:1005
msgctxt "text_id=6010 | speaker=unknown"
msgid "  The monster's camouflage implied that it sat within the reach of human hands!"
msgstr "　あの怪物の擬態は、同時に、人間の手で<到|・><達|・><可|・><能|・>である事を示している……！"

#. Occurrence 5B_14:1046:6011: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0006; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:1046
msgctxt "text_id=6011 | speaker=aoko"
msgid "\"At best, my max range is 650 yards or so...\""
msgstr "「こっちの最大射程は、よくて六百ってところだけど……」"

#. Occurrence 5B_14:1199:6012: scene=5B_14
#: 5B_14:1199
msgctxt "text_id=6012 | speaker=unknown"
msgid "  At this point, it was time to give it all she had."
msgstr "　こうなったら力尽きるまで。"

#. Occurrence 5B_14:1204:6013: scene=5B_14
#: 5B_14:1204
msgctxt "text_id=6013 | speaker=unknown"
msgid "  Drawing on the energy surging throughout the park, she extended her firing arm."
msgstr "　この遊園地中の魔力を総動員して、魔弾の手を伸ばしてみせる。"

#. Occurrence 5B_14:1260:6014: scene=5B_14
#: 5B_14:1260
msgctxt "text_id=6014 | speaker=unknown"
msgid "  A blue firework launched into the air."
msgstr "　夜空に青い花火が上がる。"

#. Occurrence 5B_14:1355:6015: scene=5B_14
#: 5B_14:1355
msgctxt "text_id=6015 | speaker=unknown"
msgid "  Looking up at her hair dancing in the wind above, Aoko reached out her right hand as if to catch the night sky."
msgstr "　風に舞う自分の髪を見上げて、青子は虚空をつかむように右手を伸ばした。"

#. Occurrence 5B_14:1360:6016: scene=5B_14
#: 5B_14:1360
msgctxt "text_id=6016 | speaker=unknown"
msgid "  A mage's own body made for the perfect catalyst."
msgstr "　魔術師にとって自身の肉体は一線級の触媒だ。"

#. Occurrence 5B_14:1365:6017: scene=5B_14
#: 5B_14:1365
msgctxt "text_id=6017 | speaker=unknown"
msgid "  And for a female mage, the hair she had grown out over many years made for a particularly valuable and powerful source of fuel."
msgstr "　女性の魔術師であるなら、年月を積み重ねた髪は特に貴重かつ強力な燃料になる。"

#. Occurrence 5B_14:1485:6018: scene=5B_14
#: 5B_14:1485
msgctxt "text_id=6018 | speaker=unknown"
msgid "  To use it, all she had to do was apply her will."
msgstr "　扱いはそれこそ念じるだけでいい。"

#. Occurrence 5B_14:1490:6019: scene=5B_14
#: 5B_14:1490
msgctxt "text_id=6019 | speaker=unknown"
msgid "  She locked the fingers on both her hands together and shouted,"
msgstr "　彼女は力強く、開いた指を握りこみ、"

#. Occurrence 5B_14:1507:6020: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0007; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:1507
msgctxt "text_id=6020 | speaker=aoko"
msgid "\"Deploy third layer! All formulae, commence linked activation!\""
msgstr "「三層展開！　全術式、連結起動―――！」"

#. Occurrence 5B_14:1544:6021: scene=5B_14
#: 5B_14:1544
msgctxt "text_id=6021 | speaker=unknown"
msgid "  She hurled forth a clear challenge to bind the moon to herself."
msgstr "　月と自らを<繋|つな>げる、明確な挑戦状をたたきつけた。"

#. Occurrence 5B_14:1671:6022: scene=5B_14
#: 5B_14:1671
msgctxt "text_id=6022 | speaker=unknown"
msgid "  The mist began to whirl about in a vortex."
msgstr "　霧が渦巻く。"

#. Occurrence 5B_14:1676:6023: scene=5B_14
#: 5B_14:1676
msgctxt "text_id=6023 | speaker=unknown"
msgid "  The monster high above bore its fangs at the sight of the blue spell that appeared in midair."
msgstr "　中空に現れた青い魔術式を見て、高みの怪物がその牙を<剥|む>きだしにする。"

#. Occurrence 5B_14:1738:6024: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_14_0000; voice_prefix=A40; voice_category=2; scene=5B_14
#: 5B_14:1738
msgctxt "text_id=6024 | speaker=alice"
msgid "\"Did she figure it out...?\""
msgstr "「見抜かれた、ですって……？」"

#. Occurrence 5B_14:1757:6025: scene=5B_14
#: 5B_14:1757
msgctxt "text_id=6025 | speaker=unknown"
msgid "  By the time Alice had noticed the change, the hostility between Aoko and the Snark was palpable."
msgstr "　有珠がその変化に気付いた時、青子、スナークの両者は、ともに明確な敵意を向けあっていた。"

#. Occurrence 5B_14:1827:6026: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_14_0001; voice_prefix=A40; voice_category=2; scene=5B_14
#: 5B_14:1827
msgctxt "text_id=6026 | speaker=alice"
msgid "\"...Very well. This round goes to Aoko. Return immediately."
msgstr "「……そう。なら青子の勝ちよ。すぐに戻りなさい。"

#. Occurrence 5B_14:1833:6027: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_14_0002; voice_prefix=A40; voice_category=2; scene=5B_14
#: 5B_14:1833
msgctxt "text_id=6027 | speaker=alice"
msgid "  Perhaps removing the rain clouds was too obvious a hint, but I suppose one can't win them―Flat Snark?\""
msgstr "　たしかに雨雲を消したのはヒントのあげすぎだけど、それぐらいは大目に見て―――スナーク？」"

#. Occurrence 5B_14:1843:6028: scene=5B_14
#: 5B_14:1843
msgctxt "text_id=6028 | speaker=unknown"
msgid "  The fog continued to thicken with no sign of abating."
msgstr "　霧の集結は止まらない。"

#. Occurrence 5B_14:1848:6029: scene=5B_14
#: 5B_14:1848
msgctxt "text_id=6029 | speaker=unknown"
msgid "  The moon that floated in the night sky could not pardon such an insolent mage."
msgstr "　夜空に浮かぶ月は、<不遜|ふそん>極まる魔法使いを許しはしない。"

#. Occurrence 5B_14:1853:6030: scene=5B_14
#: 5B_14:1853
msgctxt "text_id=6030 | speaker=unknown"
msgid "  As if the lord of the night would bow down to such impudence; there was no staying its wrath at a challenge so flagrant."
msgstr "　夜の王たる自分を<敬|うやま>わぬばかりか、あんな、あからさまに挑戦状をたたき付けられては、怒りの<収|おさ>めようがない。"

#. Occurrence 5B_14:1941:6031: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_14_0003; voice_prefix=A40; voice_category=2; scene=5B_14
#: 5B_14:1941
msgctxt "text_id=6031 | speaker=alice"
msgid "\"Snark!\""
msgstr "「スナーク！」"

#. Occurrence 5B_14:1948:6032: scene=5B_14
#: 5B_14:1948
msgctxt "text_id=6032 | speaker=unknown"
msgid "  The robin swooped in to give its report, but Alice waved it away. Her gaze was fixed on the transforming golden moon."
msgstr "　あわてて報告に来る駒鳥を手で払いながら、少女は変貌していく黄金の月を凝視する。"

#. Occurrence 5B_14:2067:6033: scene=5B_14
#: 5B_14:2067
msgctxt "text_id=6033 | speaker=unknown"
msgid "  Her calls of restraint did not reach it."
msgstr "　制止の声は届かない。"

#. Occurrence 5B_14:2072:6034: scene=5B_14
#: 5B_14:2072
msgctxt "text_id=6034 | speaker=unknown"
msgid "  This fairy-tale monster was beholden to nobody, and it would have no qualms unleashing its vast might upon its puny prey."
msgstr "“童話の怪物”は誰はばかることなく、その強大な力を、ちっぽけな<青子|えもの>に振り下ろそうと―――"

#. Occurrence 5B_14:2244:6035: scene=5B_14
#: 5B_14:2244
msgctxt "text_id=6035 | speaker=unknown"
msgid "  The core of her magic bullet howled."
msgstr "　うなりをあげる魔弾の炉心。"

#. Occurrence 5B_14:2249:6036: scene=5B_14
#: 5B_14:2249
msgctxt "text_id=6036 | speaker=unknown"
msgid "  The Magic Circuits within her body spun."
msgstr "　回転する体内の魔術回路。"

#. Occurrence 5B_14:2254:6037: scene=5B_14
#: 5B_14:2254
msgctxt "text_id=6037 | speaker=unknown"
msgid "  Aoko fed them magical energy, scorching her nerves with imaginary flame."
msgstr "　架空の炎に神経を焼かれながら、青子は魔力を走らせる。"

#. Occurrence 5B_14:2274:6038: scene=5B_14
#: 5B_14:2274
msgctxt "text_id=6038 | speaker=unknown"
msgid "  She was linked to the formula inscribed on the ground."
msgstr "　地面に刻んだ術式は青子と<連結|リンク>している。"

#. Occurrence 5B_14:2279:6039: scene=5B_14
#: 5B_14:2279
msgctxt "text_id=6039 | speaker=unknown"
msgid "  The spell was read and executed the same as it always was, but its output was beyond reckoning."
msgstr "　術式を読みこみ実行するのは今まで通りだが、出力はその比ではない。"

#. Occurrence 5B_14:2284:6040: scene=5B_14
#: 5B_14:2284
msgctxt "text_id=6040 | speaker=unknown"
msgid "  With this much firepower, even this mundane process would invite injury upon its caster."
msgstr "　同じ工程でもこれほどの火力なら術者にも害が及ぶ。"

#. Occurrence 5B_14:2289:6041: scene=5B_14
#: 5B_14:2289
msgctxt "text_id=6041 | speaker=unknown"
msgid "  It was enough to burn up the nerves that were acting as the barrel."
msgstr "　あるいは、<砲身|しんけい>が焼き崩れるほどの。"

#. Occurrence 5B_14:2374:6042: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0008; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:2374
msgctxt "text_id=6042 | speaker=aoko"
msgid "\"Rrgh! I can...do this!\""
msgstr "「―――、でも、いける……！」"

#. Occurrence 5B_14:2380:6043: scene=5B_14
#: 5B_14:2380
msgctxt "text_id=6043 | speaker=unknown"
msgid "  The imaginary heat had reached a terrifying temperature."
msgstr "　怖いくらいに上昇する架空の熱量。"

#. Occurrence 5B_14:2385:6044: scene=5B_14
#: 5B_14:2385
msgctxt "text_id=6044 | speaker=unknown"
msgid "  Aoko trembled at this endless feeling, but would have to grin and bear it lest their efforts come to naught."
msgstr "　底なしの感覚に身震いする青子だが、そうでなくてはこの戦法を選んだ意味がない。"

#. Occurrence 5B_14:2405:6045: scene=5B_14
#: 5B_14:2405
msgctxt "text_id=6045 | speaker=unknown"
msgid "  Aoko could no longer move."
msgstr "　青子はもう移動できない。"

#. Occurrence 5B_14:2410:6046: scene=5B_14
#: 5B_14:2410
msgctxt "text_id=6046 | speaker=unknown"
msgid "  When she had learned the Snark's true form from Soujyuro, she gave up on any superiority a moveable turret offered, instead opting to become a stationary cannon."
msgstr "　草十郎からスナークの正体を聞いた時、彼女は“移動する砲台”の優位性を捨てて、設置砲台になる道を選んだ。"

#. Occurrence 5B_14:2415:6047: scene=5B_14
#: 5B_14:2415
msgctxt "text_id=6047 | speaker=unknown"
msgid "  That was the only way she could reach it. It was impossible to hunt the Snark unless she anchored her crest at this location and angle."
msgstr "　そうでなければ届かない。この位置、この角度で刻印を固定しなければ、スナーク<狩り|ハント>はできないのだ。"

#. Occurrence 5B_14:2435:6048: scene=5B_14
#: 5B_14:2435
msgctxt "text_id=6048 | speaker=unknown"
msgid "  At the same time, this action revealed that she was out of options."
msgstr "　同時に、それは“次の手段”がない事を示している。"

#. Occurrence 5B_14:2440:6049: scene=5B_14
#: 5B_14:2440
msgctxt "text_id=6049 | speaker=unknown"
msgid "  Once the fuse was lit, she would have no choice but to fight to the bitter end."
msgstr "　口火をきればこの場所で最後まで戦うしかない。"

#. Occurrence 5B_14:2445:6050: scene=5B_14
#: 5B_14:2445
msgctxt "text_id=6050 | speaker=unknown"
msgid "  Aoko took a deep breath; this was the way she wanted it."
msgstr "　それでいい、と青子は大きく息を吸い込んだ。"

#. Occurrence 5B_14:2450:6051: scene=5B_14
#: 5B_14:2450
msgctxt "text_id=6051 | speaker=unknown"
msgid "  Her preparations were complete. She would be able deliver this maelstrom of magical energy directly to the moon, like a rocket payload!"
msgstr "　準備は万全。ロケットの噴射に等しい魔力の渦を、直接、あの月にまで届かせる―――！"

#. Occurrence 5B_14:2470:6052: scene=5B_14
#: 5B_14:2470
msgctxt "text_id=6052 | speaker=unknown"
msgid "  The third midair layer served as the cannon's muzzle and sight. It would fire the magical energy once it reached criticality, and it allowed Aoko to adjust the angle of fire."
msgstr "　中空に浮かぶ第三層は臨界に達した魔力を撃ち出す銃口であり、射角を調整する<照星|しょうせい>だ。"

#. Occurrence 5B_14:2485:6053: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0009; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:2485
msgctxt "text_id=6053 | speaker=aoko"
msgid "(Fog...?)"
msgstr "“霧……？”"

#. Occurrence 5B_14:2490:6054: scene=5B_14
#: 5B_14:2490
msgctxt "text_id=6054 | speaker=unknown"
msgid "  The moon became warped within her scope."
msgstr "　その照準越しに月が<歪|ゆが>む。"

#. Occurrence 5B_14:2600:6055: scene=5B_14
#: 5B_14:2600
msgctxt "text_id=6055 | speaker=unknown"
msgid "  As Aoko charged her magical energy, the Ploy displayed its golden form as if to mock her."
msgstr "　魔力を充電する青子をあざ笑うように、黄金の月はその正体を現していく。"

#. Occurrence 5B_14:2624:6056: scene=5B_14
#: 5B_14:2624
msgctxt "text_id=6056 | speaker=unknown"
msgid "  Come. Worship the heavens, powerless scion of an innocent bloodline."
msgstr "　さあ―――<宙|てん>を仰げ、異能なき<無|む><辜|こ>の血統。"

#. Occurrence 5B_14:2630:6057: scene=5B_14
#: 5B_14:2630
msgctxt "text_id=6057 | speaker=unknown"
msgid "  For there it was, a point among the otherworldly sky,"
msgstr "　あれこそは魔天の一角、"

msgctxt "text_id=6058 | speaker=unknown"
msgid "  a Mystical visage obfuscated by jade mists and azure clouds."
msgstr "　緑色の霧、<紺碧|こんぺき>の雲にかすむ神秘の<貌|すがた>。"

#. Occurrence 5B_14:2638:6059: scene=5B_14
#: 5B_14:2638
msgctxt "text_id=6059 | speaker=unknown"
msgid "  Called the greatest treasure known to the world of magecraft,"
msgstr "　魔術世界において至宝と称され、"

msgctxt "text_id=6060 | speaker=unknown"
msgid "  a rarity more valuable than an entire kingdom: Crown Phantasm."
msgstr "　一つの王国より稀少と値付けられた<至高の幻想|クラウン・ファンタズム>。"

#. Occurrence 5B_14:2759:6061: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0010; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:2759
msgctxt "text_id=6061 | speaker=aoko"
msgid "(That's it! That's Flat Snark!)"
msgstr "“あれが―――フラットスナーク……！！！！”"

#. Occurrence 5B_14:2765:6062: scene=5B_14
#: 5B_14:2765
msgctxt "text_id=6062 | speaker=unknown"
msgid "  Set apart from the First, the world's greatest fabrication!"
msgstr "　<第一|はじまり>より<別|わか>たれた、この世でもっとも大きな虚構！"

#. Occurrence 5B_14:2896:6063: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0011; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:2896
msgctxt "text_id=6063 | speaker=aoko"
msgid "(...Not yet! Just need...a little more time...)"
msgstr "“っ……まだ早い―――まだ早い、けど―――！”"

#. Occurrence 5B_14:2985:6064: scene=5B_14
#: 5B_14:2985
msgctxt "text_id=6064 | speaker=unknown"
msgid "  Her instincts screamed at her to delay no further."
msgstr "　これ以上の<猶|た><予|め>は許されない、と本能が叫んでいた。"

#. Occurrence 5B_14:2990:6065: scene=5B_14
#: 5B_14:2990
msgctxt "text_id=6065 | speaker=unknown"
msgid "  This fairy-tale monster was the greatest of its kind, and it was about to expose its true form."
msgstr "　正体を暴かれようと敵は最高級の“童話の怪物”。"

#. Occurrence 5B_14:2995:6066: scene=5B_14
#: 5B_14:2995
msgctxt "text_id=6066 | speaker=unknown"
msgid "  Its open hostility made it clear that it was ready to counterattack!"
msgstr "　この状況でも反撃の用意はある事を、剥き出しの敵意が示している……！"

#. Occurrence 5B_14:3016:6067: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0012; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:3016
msgctxt "text_id=6067 | speaker=aoko"
msgid "(I can't move! Not with an incantation this long! If it attacks before me, it's all over!)"
msgstr "“こっちはもう動けない……逃げを捨てての大詠唱、先に撃たれたらそこで終わりだ……！”　"

#. Occurrence 5B_14:3022:6068: scene=5B_14
#: 5B_14:3022
msgctxt "text_id=6068 | speaker=unknown"
msgid "  She had to shoot it down first."
msgstr "　故に、その前に撃ち落とす。"

#. Occurrence 5B_14:3027:6069: scene=5B_14
#: 5B_14:3027
msgctxt "text_id=6069 | speaker=unknown"
msgid "  Magical energy was at eighty percent. The formula was operating normally. All that was left was to pull the trigger, but..."
msgstr "　魔力は八分、術式は正常稼働、あとは<引|ひ>き<金|がね>を引くだけだが―――"

#. Occurrence 5B_14:3071:6070: scene=5B_14
#: 5B_14:3071
msgctxt "text_id=6070 | speaker=unknown"
msgid "  The calm voice inside her head asked if that was really okay."
msgstr "　本当にそれでいいのか、と冷静な自分が告げる。"

#. Occurrence 5B_14:3140:6071: scene=5B_14
#: 5B_14:3140
msgctxt "text_id=6071 | speaker=unknown"
msgid "  She had one shot at this, and there was no going back."
msgstr "　始めてしまえば後戻りはできない。"

#. Occurrence 5B_14:3145:6072: scene=5B_14
#: 5B_14:3145
msgctxt "text_id=6072 | speaker=unknown"
msgid "  It was a battle of precision with no room for miscalculations. Even a tenth of a second of hesitation would tip the scales."
msgstr "　この先はコンマの戦いだ。判断ミスを悔いる瞬間さえない。０．１秒の迷いが天秤をかたむける。"

#. Occurrence 5B_14:3215:6073: scene=5B_14
#: 5B_14:3215
msgctxt "text_id=6073 | speaker=unknown"
msgid "  Was she ready for the pain? Was she ready to deal with the fallout if she missed?"
msgstr "　痛みへの覚悟も、失着への開き直りはできているか？"

#. Occurrence 5B_14:3262:6074: scene=5B_14
#: 5B_14:3262
msgctxt "text_id=6074 | speaker=unknown"
msgid "  Could she really even take down the moon with such a tiny bullet in the first place?"
msgstr "　そもそも本当におまえは、そのちっぽけな魔弾で、月を落とす事ができるのか―――？"

#. Occurrence 5B_14:3325:6075: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0013; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:3325
msgctxt "text_id=6075 | speaker=aoko"
msgid "(Enough! Shoot first, ask questions later!)"
msgstr "“いい―――とりあえず、当たった後で考える！”"

#. Occurrence 5B_14:3331:6076: scene=5B_14
#: 5B_14:3331
msgctxt "text_id=6076 | speaker=unknown"
msgid "  Her eyes, fixed upon the moon, were filled with determination."
msgstr "　月を見据える<双眸|そうぼう>に決意をこめる。"

#. Occurrence 5B_14:3336:6077: scene=5B_14
#: 5B_14:3336
msgctxt "text_id=6077 | speaker=unknown"
msgid "  She knew that the moment she fired, the intense recoil would overwhelm her entire body. Still, she shouted,"
msgstr "　魔弾を放った瞬間、強大なフィードバックが全身を打ちのめす事を念頭にいれて、"

#. Occurrence 5B_14:3443:6078: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0014; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:3443
msgctxt "text_id=6078 | speaker=aoko"
msgid "\"...Bring it on!"
msgstr "「―――上等！"

#. Occurrence 5B_14:3443:6079: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0014; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:3443
msgctxt "text_id=6079 | speaker=aoko"
msgid "  I'm gonna send this thing spinning with all I've got!\""
msgstr "　出し惜しみはなし、めいっぱいブン回すわ……！」"

#. Occurrence 5B_14:3449:6080: scene=5B_14
#: 5B_14:3449
msgctxt "text_id=6080 | speaker=unknown"
msgid "  With every ounce of spirit she possessed, she fired her ultra-long-range projectile into the sky."
msgstr "　<宙|そら>を狙う狙撃手は気勢と共に、一撃必中、超長射程の魔弾を解き放つ……！"

#. Occurrence 5B_14:3760:6081: scene=5B_14
#: 5B_14:3760
msgctxt "text_id=6081 | speaker=unknown"
msgid "  The third layer embraced the magic bullet fired from the surface of the Earth."
msgstr "　地上からの魔弾を抱く第三層。"

#. Occurrence 5B_14:3765:6082: scene=5B_14
#: 5B_14:3765
msgctxt "text_id=6082 | speaker=unknown"
msgid "  The crest, an extension of Aoko's self, unleashed light to pierce the moon."
msgstr "　青子の分身とも言える刻印が、月を射抜けと光を放つ。"

#. Occurrence 5B_14:3770:6083: scene=5B_14
#: 5B_14:3770
msgctxt "text_id=6083 | speaker=unknown"
msgid "  However..."
msgstr "　―――だが。"

#. Occurrence 5B_14:4096:6084: scene=5B_14
#: 5B_14:4096
msgctxt "text_id=6084 | speaker=unknown"
msgid "  An enormous, blue canopy pulverized the beam."
msgstr "　光を砕く<巨|あ><峰|お>の<天蓋|てんがい>。"

#. Occurrence 5B_14:4101:6085: scene=5B_14
#: 5B_14:4101
msgctxt "text_id=6085 | speaker=unknown"
msgid "  It returned the Ether, that 3000-degree flame, to nothing as it came in contact with the bullet."
msgstr "　瞬間火炎温度３０００度に匹敵する<架|エ><空|ー><要|テ><素|ル>が、真っ向から無に帰していく……！"

#. Occurrence 5B_14:4233:6086: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0015; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4233
msgctxt "text_id=6086 | speaker=aoko"
msgid "\"Argh! Rrrrgh!\""
msgstr "「あ、づっ―――！！！！！」"

#. Occurrence 5B_14:4239:6087: scene=5B_14
#: 5B_14:4239
msgctxt "text_id=6087 | speaker=unknown"
msgid "  The recoil of the grand magecraft literally boiled her blood. Her body couldn't handle it."
msgstr "　身に余る大魔術の反動に、全身の血が沸騰する。"

#. Occurrence 5B_14:4244:6088: scene=5B_14
#: 5B_14:4244
msgctxt "text_id=6088 | speaker=unknown"
msgid "  Her heart stopped."
msgstr "　停止した心臓。"

#. Occurrence 5B_14:4249:6089: scene=5B_14
#: 5B_14:4249
msgctxt "text_id=6089 | speaker=unknown"
msgid "  Her brain went numb from the pain and impact."
msgstr "　激痛と衝撃で麻痺する<脳髄|のうずい>。"

#. Occurrence 5B_14:4254:6090: scene=5B_14
#: 5B_14:4254
msgctxt "text_id=6090 | speaker=unknown"
msgid "  Her nerves putrefied from end to end."
msgstr "　末端から<壊|え><死|し>していく神経。"

#. Occurrence 5B_14:4259:6091: scene=5B_14
#: 5B_14:4259
msgctxt "text_id=6091 | speaker=unknown"
msgid "  But her Magic Crest revived them all by force."
msgstr "　それらすべてを、魔術刻印が強引に蘇生させる。"

#. Occurrence 5B_14:4385:6092: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0016; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4385
msgctxt "text_id=6092 | speaker=aoko"
msgid "\"Ah... Gah...!\""
msgstr "「は、ぁつ、ぁ―――！」"

#. Occurrence 5B_14:4391:6093: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0017; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4391
msgctxt "text_id=6093 | speaker=aoko"
msgid "(Ice? It was blocked by ice!)"
msgstr "“氷―――！　氷で<防|ふせ>がれた！”"

#. Occurrence 5B_14:4397:6094: scene=5B_14
#: 5B_14:4397
msgctxt "text_id=6094 | speaker=unknown"
msgid "  Even though her vision had gone white, she could still see it."
msgstr "　真っ白に眩む視界のなか、青子はたしかに見た。"

#. Occurrence 5B_14:4402:6095: scene=5B_14
#: 5B_14:4402
msgctxt "text_id=6095 | speaker=unknown"
msgid "  Swallowing the blood in her mouth, Aoko looked up with a scowl."
msgstr "　<口内|こうない>の血を飲みこんで頭上を<睨|にら>む。"

#. Occurrence 5B_14:4509:6096: scene=5B_14
#: 5B_14:4509
msgctxt "text_id=6096 | speaker=unknown"
msgid "  There it was,"
msgstr "　そこには。"

#. Occurrence 5B_14:4515:6097: scene=5B_14
#: 5B_14:4515
msgctxt "text_id=6097 | speaker=unknown"
msgid " an enormous shield of ice and a sneering, deformed skull."
msgstr "巨大な氷塊を盾にしてあざ笑う、いびつで邪悪な<髑髏|どくろ>の顔が……！"

#. Occurrence 5B_14:4603:6098: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0018; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4603
msgctxt "text_id=6098 | speaker=aoko"
msgid "(Did I fire too late? Did I fire too early!?"
msgstr "“撃つのが遅すぎた、それとも早すぎた……！？"

#. Occurrence 5B_14:4603:6099: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0018; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4603
msgctxt "text_id=6099 | speaker=aoko"
msgid "  Should I have shot before it made that shield?"
msgstr "　盾を作られる前に撃てばよかった！？"

#. Occurrence 5B_14:4603:6100: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0018; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4603
msgctxt "text_id=6100 | speaker=aoko"
msgid "  Was it too reckless to shoot it head-on!?)"
msgstr "　それとも、正面からじゃ無謀すぎた……！？”"

#. Occurrence 5B_14:4697:6101: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0019; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4697
msgctxt "text_id=6101 | speaker=aoko"
msgid "\"Who cares!?"
msgstr "「っ、どっちでもいい！"

#. Occurrence 5B_14:4703:6102: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0020; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4703
msgctxt "text_id=6102 | speaker=aoko"
msgid "  First layer, second layer, reactivate! Hurry!\""
msgstr "　一層、二層、再起動―――！　急いで！」"

#. Occurrence 5B_14:4786:6103: scene=5B_14
#: 5B_14:4786
msgctxt "text_id=6103 | speaker=unknown"
msgid "  There was no time to think or hesitate."
msgstr "　考える余分も、迷っている余裕もない。"

#. Occurrence 5B_14:4849:6104: scene=5B_14
#: 5B_14:4849
msgctxt "text_id=6104 | speaker=unknown"
msgid "  The magical energy throughout the park began to gather."
msgstr "　遊園地<中|じゅう>の魔力が集結する。"

#. Occurrence 5B_14:4856:6105: scene=5B_14
#: 5B_14:4856
msgctxt "text_id=6105 | speaker=unknown"
msgid "  Aoko knelt,"
msgstr "　一方は青子に。"

#. Occurrence 5B_14:4861:6106: scene=5B_14
#: 5B_14:4861
msgctxt "text_id=6106 | speaker=unknown"
msgid "  across from the tyrannical face of the moon."
msgstr "　もう一方は君臨する月の顔に。"

#. Occurrence 5B_14:4866:6107: scene=5B_14
#: 5B_14:4866
msgctxt "text_id=6107 | speaker=unknown"
msgid "  She intuited that the ice had yet to fully form; Flat Snark still hadn't reached its full strength."
msgstr "　今の氷は未完成だ、と青子は直感した。こちらがそうであったように、フラットスナークもまだ<極限|じょうげん>に達していない。"

#. Occurrence 5B_14:4871:6108: scene=5B_14
#: 5B_14:4871
msgctxt "text_id=6108 | speaker=unknown"
msgid "  Which was exactly why..."
msgstr "　そう、だからこそ―――"

#. Occurrence 5B_14:4965:6109: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0021; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4965
msgctxt "text_id=6109 | speaker=aoko"
msgid "(Dammit... Dammit, dammit, dammit!)"
msgstr "“まずい―――まずい、まずい、まずい！”"

#. Occurrence 5B_14:4971:6110: scene=5B_14
#: 5B_14:4971
msgctxt "text_id=6110 | speaker=unknown"
msgid "  By accelerating the spell, Aoko damaged her own body."
msgstr "　術式の加速は青子自身を傷つける。"

#. Occurrence 5B_14:4976:6111: scene=5B_14
#: 5B_14:4976
msgctxt "text_id=6111 | speaker=unknown"
msgid "  The burden of linking the formula to the Snark caused intense pain. All she could do was grit her teeth and endure it."
msgstr "　繋がっている以上、術式に負荷をかけるほど<軋|きし>みは青子の体にのしかかる。それでも今は耐えるしかない。"

#. Occurrence 5B_14:5003:6112: scene=5B_14
#: 5B_14:5003
msgctxt "text_id=6112 | speaker=unknown"
msgid "  All because..."
msgstr "　なぜなら―――"

#. Occurrence 5B_14:5066:6113: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0022; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:5066
msgctxt "text_id=6113 | speaker=aoko"
msgid "(That ice is tougher than my best shot!)"
msgstr "“―――あの氷、<私|・><の|・><マ|・><ッ|・><ク|・><ス|・><よ|・><り|・><も|・><っ|・><と|・><上|・><だ|・>！”"

#. Occurrence 5B_14:5072:6114: scene=5B_14
#: 5B_14:5072
msgctxt "text_id=6114 | speaker=unknown"
msgid "  Aoko had gotten a read on their relative strengths."
msgstr "　今の一撃で互いの戦力が分かってしまった。"

#. Occurrence 5B_14:5077:6115: scene=5B_14
#: 5B_14:5077
msgctxt "text_id=6115 | speaker=unknown"
msgid "  Even if its volume of magical energy was identical, Snark's form―its Mystic scale―was in a different league."
msgstr "　魔力量こそ同じでも、<神秘|カタチ>を成す術式の強度が違う。"

#. Occurrence 5B_14:5082:6116: scene=5B_14
#: 5B_14:5082
msgctxt "text_id=6116 | speaker=unknown"
msgid "  Aoko could charge her energy to her absolute limit, and that would barely make a dent in the ice wall."
msgstr "　青子が限界まで魔力を充電しても、ようやく<今|・><の|・><氷|・><塊|・>を打ち抜ける程度なのだ。"

#. Occurrence 5B_14:5087:6117: scene=5B_14
#: 5B_14:5087
msgctxt "text_id=6117 | speaker=unknown"
msgid "  Meanwhile, there was nothing she could do to prevent her own annihilation if the Snark gathered as much energy as it could...!"
msgstr "　<即|すなわ>ち、スナークが限界まで魔力を集めた場合、何をやっても圧し負ける……！"

#. Occurrence 5B_14:5177:6118: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0023; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:5177
msgctxt "text_id=6118 | speaker=aoko"
msgid "\"Then, before that happens...!\""
msgstr "「なら、その前に―――！」"

#. Occurrence 5B_14:5183:6119: scene=5B_14
#: 5B_14:5183
msgctxt "text_id=6119 | speaker=unknown"
msgid "  She loaded her next shot."
msgstr "　次弾を装填する。"

#. Occurrence 5B_14:5188:6120: scene=5B_14
#: 5B_14:5188
msgctxt "text_id=6120 | speaker=unknown"
msgid "  She issued orders to the floating third layer."
msgstr "　空中の第三層に命令を届かせる。"

#. Occurrence 5B_14:5193:6121: scene=5B_14
#: 5B_14:5193
msgctxt "text_id=6121 | speaker=unknown"
msgid "  Ignoring the toll on her body, she began to accelerate the first layer formula."
msgstr "　体への負担を無視して一層の術式を加速させる。"

#. Occurrence 5B_14:5280:6122: scene=5B_14
#: 5B_14:5280
msgctxt "text_id=6122 | speaker=unknown"
msgid "  The role of her right hand's single layer was to absorb and store surrounding magical energy."
msgstr "　右手の一層は周囲の魔力を吸収、蓄電する役割だ。"

#. Occurrence 5B_14:5285:6123: scene=5B_14
#: 5B_14:5285
msgctxt "text_id=6123 | speaker=unknown"
msgid "  The thick fog that drifted through the park was an ancient Ether spewed out by Flat Snark's own body, but Aoko could pour it into her formula."
msgstr "　遊園地を覆う濃霧。フラットスナーク自身がはき出した太古の<魔力|エーテル>が、術式に注ぎ込まれる。"

#. Occurrence 5B_14:5381:6124: scene=5B_14
#: 5B_14:5381
msgctxt "text_id=6124 | speaker=unknown"
msgid "  Aoko's body, which had integrated with the formula, took on an amount of magical energy that far surpassed its maximum capacity. It seethed in agony."
msgstr "　当然、術式と一体化している青子の身体は、許容量をはるかに超えた魔力に悲鳴をあげる。"

#. Occurrence 5B_14:5386:6125: scene=5B_14
#: 5B_14:5386
msgctxt "text_id=6125 | speaker=unknown"
msgid "  Or rather, it trembled in delight."
msgstr "　いや、歓喜にうち<震|ふる>える。"

#. Occurrence 5B_14:5406:6126: scene=5B_14
#: 5B_14:5406
msgctxt "text_id=6126 | speaker=unknown"
msgid "  For a mage, magical energy was a propellant to reach the realm of Mystics."
msgstr "　魔術師にとって、魔力とは神秘に至る為の推進剤。"

#. Occurrence 5B_14:5418:6127: scene=5B_14
#: 5B_14:5418
msgctxt "text_id=6127 | speaker=unknown"
msgid "  The expansion of internal time..."
msgstr "　体内時間の膨張。"

#. Occurrence 5B_14:5423:6128: scene=5B_14
#: 5B_14:5423
msgctxt "text_id=6128 | speaker=unknown"
msgid "  The liquefaction of the self..."
msgstr "　自我の融解。"

#. Occurrence 5B_14:5428:6129: scene=5B_14
#: 5B_14:5428
msgctxt "text_id=6129 | speaker=unknown"
msgid "  The release from the physical..."
msgstr "　肉体からの解放。"

#. Occurrence 5B_14:5433:6130: scene=5B_14
#: 5B_14:5433
msgctxt "text_id=6130 | speaker=unknown"
msgid "  They were all what one might call a near-death experience."
msgstr "　言ってしまえば臨死体験。"

#. Occurrence 5B_14:5463:6131: scene=5B_14
#: 5B_14:5463
msgctxt "text_id=6131 | speaker=unknown"
msgid "  On the precipice of what lay beyond, Aoko stood firm, and faced reality."
msgstr "　そのギリギリの境界で、青子は現実を直視する。"

#. Occurrence 5B_14:5551:6132: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0024; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:5551
msgctxt "text_id=6132 | speaker=aoko"
msgid "\"...\""
msgstr "“――――――”"

#. Occurrence 5B_14:5557:6133: scene=5B_14
#: 5B_14:5557
msgctxt "text_id=6133 | speaker=unknown"
msgid "  Still, reality had come to break her will."
msgstr "　……その現実が、激痛に耐える意志を、折りにくる。"

#. Occurrence 5B_14:5562:6134: scene=5B_14
#: 5B_14:5562
msgctxt "text_id=6134 | speaker=unknown"
msgid "  The gap between them was plain to any observer."
msgstr "　誰であろうと差は歴然。"

#. Occurrence 5B_14:5568:6135: scene=5B_14
#: 5B_14:5568
msgctxt "text_id=6135 | speaker=unknown"
msgid "  The gun barrel named Aoko Aozaki..."
msgstr "　蒼崎青子という砲身では、"

msgctxt "text_id=6136 | speaker=unknown"
msgid "  ...had not a chance to chip away at that lump of ice."
msgstr "　あの氷塊を<削|けず>る事さえできはしまい―――"

#. Occurrence 5B_14:5683:6137: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0025; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:5683
msgctxt "text_id=6137 | speaker=aoko"
msgid "(Argh! So―)"
msgstr "“っ、<痛|そ><み|れ>が―――”"

#. Occurrence 5B_14:5694:6138: scene=5B_14
#: 5B_14:5694
msgctxt "text_id=6138 | speaker=unknown"
msgid "  She accelerated the spell further."
msgstr "　術式をなお加速させる。"

#. Occurrence 5B_14:5759:6139: scene=5B_14
#: 5B_14:5759
msgctxt "text_id=6139 | speaker=unknown"
msgid "  The skull grinned."
msgstr "　髑髏が笑う。"

msgctxt "text_id=6140 | speaker=unknown"
msgid " That ice was no shield."
msgstr "氷塊は盾ではない。"

msgctxt "text_id=6141 | speaker=unknown"
msgid " It was a hammer to crush mages who did not know their place."
msgstr "アレは身を<弁|わきま>えない魔術師を押しつぶすもの。"

msgctxt "text_id=6142 | speaker=unknown"
msgid " The moon laughed as it prepared to crush not just Aoko, but the boy atop the roller coaster, as well as the park in its entirety."
msgstr "遊園地全体を<陥没|かんぼつ>させる<氷塊|いちげき>で、青子だけでなく、コースターの上にいる彼さえも踏み砕こうと笑っている。"

#. Occurrence 5B_14:5824:6143: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0026; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:5824
msgctxt "text_id=6143 | speaker=aoko"
msgid "(SO WHAT IF IT HURTS!?)"
msgstr "“どうした―――！！！！”"

#. Occurrence 5B_14:5884:6144: scene=5B_14
#: 5B_14:5884
msgctxt "text_id=6144 | speaker=unknown"
msgid "  Her circuits were on the verge of going critical."
msgstr "　臨界寸前の魔術回路。"

#. Occurrence 5B_14:5890:6145: scene=5B_14
#: 5B_14:5890
msgctxt "text_id=6145 | speaker=unknown"
msgid "Her body had been charged with a scorching power supply, from her fingertips to her eyeballs."
msgstr "指先はおろか眼球まで焼く電荷。"

#. Occurrence 5B_14:5895:6146: scene=5B_14
#: 5B_14:5895
msgctxt "text_id=6146 | speaker=unknown"
msgid "  She would see the bullet fired."
msgstr "　それでも魔弾の引き金を<絞|しぼ>る。"

#. Occurrence 5B_14:5900:6147: scene=5B_14
#: 5B_14:5900
msgctxt "text_id=6147 | speaker=unknown"
msgid "  She would arrange the magecraft formula as quickly as her nerves' transmission speed would allow."
msgstr "　神経の伝達速度で魔術式を<強化|アレンジ>する。"

#. Occurrence 5B_14:5927:6148: scene=5B_14
#: 5B_14:5927
msgctxt "text_id=6148 | speaker=unknown"
msgid "  A single attack was not enough."
msgstr "　一撃では越えられない。"

#. Occurrence 5B_14:5932:6149: scene=5B_14
#: 5B_14:5932
msgctxt "text_id=6149 | speaker=unknown"
msgid "  There was no way to shoot it from its flank."
msgstr "　側面から撃つ手段はない。"

#. Occurrence 5B_14:5959:6150: scene=5B_14
#: 5B_14:5959
msgctxt "text_id=6150 | speaker=unknown"
msgid "  Which meant there was only one solution."
msgstr "　なら、<試|や>るべき<手段|こたえ>は明白すぎる―――！"

#. Occurrence 5B_14:6173:6151: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0027; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:6173
msgctxt "text_id=6151 | speaker=aoko"
msgid "\"<Reconnecting to alternating current!|Alternate selector!>\""
msgstr "“<再接続|セレクタ>、<交流数紋|オルタネイト>……！”"

#. Occurrence 5B_14:6179:6152: scene=5B_14
#: 5B_14:6179
msgctxt "text_id=6152 | speaker=unknown"
msgid "  The third layer began to transform."
msgstr "　変革する第三層。"

#. Occurrence 5B_14:6184:6153: scene=5B_14
#: 5B_14:6184
msgctxt "text_id=6153 | speaker=unknown"
msgid "  It switched from direct to alternating current. The spell's supposed strong point was its ability to adjust its trajectory mid-flight, but right now all she wanted was numbers."
msgstr "　直流から交流へ。本来なら軌道の変化を得意とする術式だが、今は単純に数が欲しい……！"

#. Occurrence 5B_14:6228:6154: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0028; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:6228
msgctxt "text_id=6154 | speaker=aoko"
msgid "\"<Connecting.|Set.> Octogram!"
msgstr "「<接続|セット>、<八芒星|オクタグラム>―――！"

#. Occurrence 5B_14:6235:6155: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0029; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:6235
msgctxt "text_id=6155 | speaker=aoko"
msgid "  All layers, max rotation!\""
msgstr "　全界層、ブン回せ―――！」"

#. Occurrence 5B_14:6757:6156: scene=5B_14
#: 5B_14:6757
msgctxt "text_id=6156 | speaker=unknown"
msgid "  A blue sun shined down upon the amusement park."
msgstr "　遊園地を照らす青い太陽。"

#. Occurrence 5B_14:6762:6157: scene=5B_14
#: 5B_14:6762
msgctxt "text_id=6157 | speaker=unknown"
msgid "  Beams of light at maximum output streaked forth to pierce the golden moon."
msgstr "　最大出力の光弾が、黄金の月を射止めに走る。"

#. Occurrence 5B_14:7336:6158: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0030; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:7336
msgctxt "text_id=6158 | speaker=aoko"
msgid "\"Take...this...!\""
msgstr "「こ、のぉ……！」"

#. Occurrence 5B_14:7342:6159: scene=5B_14
#: 5B_14:7342
msgctxt "text_id=6159 | speaker=unknown"
msgid "  Holding down the trigger, she continued to fire, taking in energy ad infinitum."
msgstr "　引き金は<絞|しぼ>ったまま、際限なく取りこむ魔力を、休むことなく放ち続ける。"

#. Occurrence 5B_14:7679:6160: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0031; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:7679
msgctxt "text_id=6160 | speaker=aoko"
msgid "\"Gah... Ahgh...\""
msgstr "“っ―――、ぁ―――…………”"

#. Occurrence 5B_14:7685:6161: scene=5B_14
#: 5B_14:7685
msgctxt "text_id=6161 | speaker=unknown"
msgid "  Blue flames shot forth at critical level."
msgstr "　臨界域から噴き出される青い炎。"

#. Occurrence 5B_14:7690:6162: scene=5B_14
#: 5B_14:7690
msgctxt "text_id=6162 | speaker=unknown"
msgid "  But the ice would neither melt nor mar. "
msgstr "　だが氷塊は融解さえしない。"

#. Occurrence 5B_14:7695:6163: scene=5B_14
#: 5B_14:7695
msgctxt "text_id=6163 | speaker=unknown"
msgid "  No amount of sheer heat could make a dent in something formed from such a colossal amount of magical energy."
msgstr "　温度以前に、カタチ取られた魔力量が違いすぎる。"

#. Occurrence 5B_14:7800:6164: scene=5B_14
#: 5B_14:7800
msgctxt "text_id=6164 | speaker=unknown"
msgid "  The toll on her circuits sent them berserk, and blood began to run free."
msgstr "　体内の魔術回路の負荷が、鮮血となって荒れ狂う。"

#. Occurrence 5B_14:7806:6165: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0032; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:7806
msgctxt "text_id=6165 | speaker=aoko"
msgid "(...Agh! The spin should have been more than enough..."
msgstr "“っ……！！　これだけ、回して、るのに―――"

#. Occurrence 5B_14:7812:6166: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0033; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:7812
msgctxt "text_id=6166 | speaker=aoko"
msgid "  He's...just...too strong!)"
msgstr "　アイツの方が、ぜんぜん、上……！”"

#. Occurrence 5B_14:7890:6167: scene=5B_14
#: 5B_14:7890
msgctxt "text_id=6167 | speaker=unknown"
msgid "  The battle had become a tussle over the magical energy that filled the park."
msgstr "　この戦いは遊園地に満ちた魔力の奪い合いでもある。"

#. Occurrence 5B_14:7895:6168: scene=5B_14
#: 5B_14:7895
msgctxt "text_id=6168 | speaker=unknown"
msgid "  From the very beginning, this had been the Snark's home turf."
msgstr "　もとよりここはスナークの庭。"

#. Occurrence 5B_14:7900:6169: scene=5B_14
#: 5B_14:7900
msgctxt "text_id=6169 | speaker=unknown"
msgid "  The Snark had control over at least eighty percent of the space, while Aoko had twenty at best."
msgstr "　空間の支配率はスナークが八割、青子は二割にすぎない。"

#. Occurrence 5B_14:8030:6170: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0034; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:8030
msgctxt "text_id=6170 | speaker=aoko"
msgid "\"No... I...can't...stop it!\""
msgstr "「だ、め……止められ、ない……！」"

#. Occurrence 5B_14:8150:6171: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0035; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:8150
msgctxt "text_id=6171 | speaker=aoko"
msgid "(No...)"
msgstr "“あ……”"

#. Occurrence 5B_14:8156:6172: scene=5B_14
#: 5B_14:8156
msgctxt "text_id=6172 | speaker=unknown"
msgid "  The castle of ice descended as if to call the match."
msgstr "　勝敗を告げるように、氷の城が落ちてくる。"

#. Occurrence 5B_14:8237:6173: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0036; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:8237
msgctxt "text_id=6173 | speaker=aoko"
msgid "\"Ah...AaaAAAhhhHHH!\""
msgstr "「あ―――ああ、ああぁああ……！」"

#. Occurrence 5B_14:8243:6174: scene=5B_14
#: 5B_14:8243
msgctxt "text_id=6174 | speaker=unknown"
msgid "  All she could do was delay the inevitable."
msgstr "　青子にできるのはその結末を遅らせる程度。"

#. Occurrence 5B_14:8248:6175: scene=5B_14
#: 5B_14:8248
msgctxt "text_id=6175 | speaker=unknown"
msgid "  She knew that she had been backed into a wall, and right now, the only thing she could do was to keep firing."
msgstr "　追いつめられるだけと分かっていながら、今は魔弾を撃ち続けるしかない。"

#. Occurrence 5B_14:8303:6176: scene=5B_14
#: 5B_14:8303
msgctxt "text_id=6176 | speaker=unknown"
msgid "  Then again, perhaps not. There was another option."
msgstr "　ああ、でも―――今ならまだ、他に手はある。"

#. Occurrence 5B_14:8308:6177: scene=5B_14
#: 5B_14:8308
msgctxt "text_id=6177 | speaker=unknown"
msgid "  If she converted all of her magical energy into a defense, there was a tiny chance―no, not tiny. A great possibility, in fact, that she could save just her―"
msgstr "　この魔力をすべて防御に回せば、万が一―――いや、高い確率で、<青子|じぶん>だけは助かるのでは、と―――"

#. Occurrence 5B_14:8412:6178: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0037; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:8412
msgctxt "text_id=6178 | speaker=aoko"
msgid "(Shut up and do it already!"
msgstr "“……っ、うるさい！"

#. Occurrence 5B_14:8412:6179: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0037; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:8412
msgctxt "text_id=6179 | speaker=aoko"
msgid "  Not even that ice has a chance against all the magical energy here!)"
msgstr "　ここの魔力を使い切れば、あの氷だって……！”"

#. Occurrence 5B_14:8418:6180: scene=5B_14
#: 5B_14:8418
msgctxt "text_id=6180 | speaker=unknown"
msgid "  Clinging to that broken hope, Aoko continued to rotate her circuits."
msgstr "　破綻した希望にすがって青子は回路を回し続ける。"

#. Occurrence 5B_14:8533:6181: scene=5B_14
#: 5B_14:8533
msgctxt "text_id=6181 | speaker=unknown"
msgid "  Time seemed to stop at the magical energy overdose."
msgstr "　魔力の<過剰摂取|オーバードウズ>で停止する時間。"

#. Occurrence 5B_14:8538:6182: scene=5B_14
#: 5B_14:8538
msgctxt "text_id=6182 | speaker=unknown"
msgid "  A second of intense pain lasted an eternity."
msgstr "　永遠に続く一秒の激痛。"

#. Occurrence 5B_14:8543:6183: scene=5B_14
#: 5B_14:8543
msgctxt "text_id=6183 | speaker=unknown"
msgid "  Then, amidst everything..."
msgstr "　その中で、"

#. Occurrence 5B_14:8595:6184: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0038; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:8595
msgctxt "text_id=6184 | speaker=aoko"
msgid "(Huh?)"
msgstr "“―――え？”"

#. Occurrence 5B_14:8628:6185: scene=5B_14
#: 5B_14:8628
msgctxt "text_id=6185 | speaker=unknown"
msgid "  Something approached one step at a time."
msgstr "　何かが、ひたひたと、"

#. Occurrence 5B_14:8702:6186: scene=5B_14
#: 5B_14:8702
msgctxt "text_id=6186 | speaker=unknown"
msgid "  Something from among the park's shadows."
msgstr "　何かが、遊園地の物陰から、"

#. Occurrence 5B_14:8749:6187: scene=5B_14
#: 5B_14:8749
msgctxt "text_id=6187 | speaker=unknown"
msgid "  Something..."
msgstr "　何かが、"

msgctxt "text_id=6188 | speaker=unknown"
msgid " Something..."
msgstr "何かが、"

msgctxt "text_id=6189 | speaker=unknown"
msgid " Something..."
msgstr "何かが、"

#. Occurrence 5B_14:8928:6190: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0039; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:8928
msgctxt "text_id=6190 | speaker=aoko"
msgid "(Wai―)"
msgstr "“ちょっ―――”"

#. Occurrence 5B_14:8934:6191: scene=5B_14
#: 5B_14:8934
msgctxt "text_id=6191 | speaker=unknown"
msgid "  She felt goosebumps from head to toe."
msgstr "　全身が総毛立つ。"

#. Occurrence 5B_14:8939:6192: scene=5B_14
#: 5B_14:8939
msgctxt "text_id=6192 | speaker=unknown"
msgid "  The issue was no longer the ice overhead."
msgstr "　頭上の氷塊なんて問題じゃない。"

#. Occurrence 5B_14:8944:6193: scene=5B_14
#: 5B_14:8944
msgctxt "text_id=6193 | speaker=unknown"
msgid "  In the midst of this stillness, the red death drew closer, step by ominous step."
msgstr "　静止した時間の中で、ひたひたと、赤い死がやってくる。"

#. Occurrence 5B_14:8972:6194: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0040; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:8972
msgctxt "text_id=6194 | speaker=aoko"
msgid "(Why here? Why now!?)"
msgstr "“なんで、こんな、ところで…………！”"

#. Occurrence 5B_14:8978:6195: scene=5B_14
#: 5B_14:8978
msgctxt "text_id=6195 | speaker=unknown"
msgid "  Her circuits and her mind began to rupture out of terror."
msgstr "　恐怖で<回路|せいしん>が破裂しかける。"

#. Occurrence 5B_14:8983:6196: scene=5B_14
#: 5B_14:8983
msgctxt "text_id=6196 | speaker=unknown"
msgid "  The composition of her formula and soul began to rip apart."
msgstr "　<術式|こころ>の形成がほころびかける。"

#. Occurrence 5B_14:8988:6197: scene=5B_14
#: 5B_14:8988
msgctxt "text_id=6197 | speaker=unknown"
msgid "  There it was, just behind her."
msgstr "　ソレは彼女の背後にまでやってきて、"

#. Occurrence 5B_14:8993:6198: scene=5B_14
#: 5B_14:8993
msgctxt "text_id=6198 | speaker=unknown"
msgid "  Its footsteps came to a halt."
msgstr "　ひたり、と。"

#. Occurrence 5B_14:8998:6199: scene=5B_14
#: 5B_14:8998
msgctxt "text_id=6199 | speaker=unknown"
msgid "  It reached around and cupped her face in its bloodstained hands."
msgstr "　血まみれの手で、後ろから青子の両頬に手を当てて、"

#. Occurrence 5B_14:9093:6200: voice_id=C70_5B_14_0000; voice_prefix=C70; voice_category=0; scene=5B_14
#: 5B_14:9093
msgctxt "text_id=6200 | speaker=unknown"
msgid "                                                "
msgstr "　　　　　　　　　"

msgctxt "text_id=6201 | speaker=unknown"
msgid "\"Greetings.\""
msgstr "『こんにち　は』"

#. Occurrence 5B_14:9137:6202: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0041; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:9137
msgctxt "text_id=6202 | speaker=aoko"
msgid "\"!!!\""
msgstr "“！！！！！”"

#. Occurrence 5B_14:9143:6203: scene=5B_14
#: 5B_14:9143
msgctxt "text_id=6203 | speaker=unknown"
msgid "  She wanted to scream out with all her might."
msgstr "　あらゆる感情、あらゆる自我が絶叫したがる。"

#. Occurrence 5B_14:9148:6204: scene=5B_14
#: 5B_14:9148
msgctxt "text_id=6204 | speaker=unknown"
msgid "  This is it. Nothing matters! I couldn't care less!"
msgstr "　もういい。どうでもいい、なんでもいい！"

#. Occurrence 5B_14:9153:6205: scene=5B_14
#: 5B_14:9153
msgctxt "text_id=6205 | speaker=unknown"
msgid "  Run or don't run, it doesn't matter!"
msgstr "　逃げられるのなら逃げてしまえ！"

#. Occurrence 5B_14:9158:6206: scene=5B_14
#: 5B_14:9158
msgctxt "text_id=6206 | speaker=unknown"
msgid "  Quit hiding and reveal yourself!"
msgstr "　隠しているのなら明かせばいい！"

#. Occurrence 5B_14:9163:6207: scene=5B_14
#: 5B_14:9163
msgctxt "text_id=6207 | speaker=unknown"
msgid "  Use whatever you can, and show no mercy!"
msgstr "　使えるのなら、そんなもの、いっそ無慈悲に使えばいい！"

#. Occurrence 5B_14:9234:6208: scene=5B_14
#: 5B_14:9234
msgctxt "text_id=6208 | speaker=unknown"
msgid "  That was it."
msgstr "　そうだ。"

#. Occurrence 5B_14:9239:6209: scene=5B_14
#: 5B_14:9239
msgctxt "text_id=6209 | speaker=unknown"
msgid "  She had one final card to play."
msgstr "　彼女は起死回生の切り札を持っている。"

#. Occurrence 5B_14:9244:6210: scene=5B_14
#: 5B_14:9244
msgctxt "text_id=6210 | speaker=unknown"
msgid "  Once, a miracle had been gifted to her, almost as a joke. It made the ice look like child's play."
msgstr "　あんな氷塊、あんな玩具なんて物ともしない奇蹟を、ある日、ポンと冗談みたいに手渡された。"

#. Occurrence 5B_14:9253:6211: scene=5B_14
#: 5B_14:9253
msgctxt "text_id=6211 | speaker=unknown"
msgid "                    That was what the red death had come to kill."
msgstr "　　　　　　　　　　／それを、この赤い死が殺しに来る。"

#. Occurrence 5B_14:9273:6212: scene=5B_14
#: 5B_14:9273
msgctxt "text_id=6212 | speaker=unknown"
msgid "  Using it would spell ruin."
msgstr "　使えば破滅。"

#. Occurrence 5B_14:9278:6213: scene=5B_14
#: 5B_14:9278
msgctxt "text_id=6213 | speaker=unknown"
msgid "  Not using it would mean death by ice."
msgstr "　使わずとも氷に潰されて死滅。"

#. Occurrence 5B_14:9288:6214: scene=5B_14
#: 5B_14:9288
msgctxt "text_id=6214 | speaker=unknown"
msgid "  Then, why hesitate?"
msgstr "　なら、どうしてためらう必要がある？"

#. Occurrence 5B_14:9293:6215: scene=5B_14
#: 5B_14:9293
msgctxt "text_id=6215 | speaker=unknown"
msgid "  There were no conditions on its use."
msgstr "　別に使用制限なんてものはない。"

#. Occurrence 5B_14:9355:6216: scene=5B_14
#: 5B_14:9355
msgctxt "text_id=6216 | speaker=unknown"
msgid "  There was no price to pay for its power."
msgstr "　等価に何かが失われる事もない。"

#. Occurrence 5B_14:9360:6217: scene=5B_14
#: 5B_14:9360
msgctxt "text_id=6217 | speaker=unknown"
msgid "  She simply would cease to be herself."
msgstr "　ただ、彼女が彼女でなくなるだけ。"

#. Occurrence 5B_14:9460:6218: scene=5B_14
#: 5B_14:9460
msgctxt "text_id=6218 | speaker=unknown"
msgid "  That was all."
msgstr "　たったそれだけ。"

#. Occurrence 5B_14:9465:6219: scene=5B_14
#: 5B_14:9465
msgctxt "text_id=6219 | speaker=unknown"
msgid "  Humans loved to exist in areas of gray."
msgstr "　人間なんて曖昧なものだ。"

#. Occurrence 5B_14:9470:6220: scene=5B_14
#: 5B_14:9470
msgctxt "text_id=6220 | speaker=unknown"
msgid "  Dozens of electrical impulses disconnect in the brain every minute; nothing lasts forever, not even one's self."
msgstr "　脳の電流は一分ごとに何十回と断線して、何一つ、“いつまでも続いている<自|も><分|の>”なんてない。"

#. Occurrence 5B_14:9563:6221: scene=5B_14
#: 5B_14:9563
msgctxt "text_id=6221 | speaker=unknown"
msgid "  It was not anything particularly worthy of disdain."
msgstr "　それは別段、<軽蔑|けいべつ>する事でもなく。"

#. Occurrence 5B_14:9570:6222: scene=5B_14
#: 5B_14:9570
msgctxt "text_id=6222 | speaker=unknown"
msgid "  It was not even anything remarkably worthy of being called taboo."
msgstr "　それは格段、<禁忌|きんき>するものでもない。"

#. Occurrence 5B_14:9617:6223: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0042; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:9617
msgctxt "text_id=6223 | speaker=aoko"
msgid "(...Shut up.)"
msgstr "“―――っ、さい”"

#. Occurrence 5B_14:9669:6224: scene=5B_14
#: 5B_14:9669
msgctxt "text_id=6224 | speaker=unknown"
msgid "  What escaped her lips now was rage."
msgstr "　なのに、口から漏れた声は怒りだった。"

#. Occurrence 5B_14:9674:6225: scene=5B_14
#: 5B_14:9674
msgctxt "text_id=6225 | speaker=unknown"
msgid "  Bewilderment from the red silhouette."
msgstr "　赤い影はかすかに首をかしげる。"

#. Occurrence 5B_14:9766:6226: scene=5B_14
#: 5B_14:9766
msgctxt "text_id=6226 | speaker=unknown"
msgid "  The girl let out an inaudible scream."
msgstr "　少女は声なき声で叫ぶ。"

#. Occurrence 5B_14:9829:6227: scene=5B_14
#: 5B_14:9829
msgctxt "text_id=6227 | speaker=unknown"
msgid "  Could True Magic truly be her savior? What an opportunistic load of bull."
msgstr "　魔法を使えば勝てる？　事情も知らないでよくも勝手な。"

#. Occurrence 5B_14:9834:6228: scene=5B_14
#: 5B_14:9834
msgctxt "text_id=6228 | speaker=unknown"
msgid "  After all, to begin with..."
msgstr "　だいたい、そもそも―――"

#. Occurrence 5B_14:9899:6229: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0043; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:9899
msgctxt "text_id=6229 | speaker=aoko"
msgid "(I have no clue how to do that shit yet!)"
msgstr "“あんなの、どうやって使えってぇのよ―――！”"

#. Occurrence 5B_14:9905:6230: scene=5B_14
#: 5B_14:9905
msgctxt "text_id=6230 | speaker=unknown"
msgid "  Indeed, Aoko was still in the dark when it came to that Magic, whatever it was."
msgstr "　彼女には、その魔法とやらの有効な利用法が、どうにも思い当たらない―――！"

#. Occurrence 5B_14:10518:6231: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0044; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:10518
msgctxt "text_id=6231 | speaker=aoko"
msgid "\"...I'm such a moron!\""
msgstr "「―――って、バカか私……！」"

#. Occurrence 5B_14:10524:6232: scene=5B_14
#: 5B_14:10524
msgctxt "text_id=6232 | speaker=unknown"
msgid "  She woke from her momentary hallucination."
msgstr "　一瞬の錯覚から目を覚ます。"

#. Occurrence 5B_14:10529:6233: scene=5B_14
#: 5B_14:10529
msgctxt "text_id=6233 | speaker=unknown"
msgid "  The very illusion her breaking soul had shown her."
msgstr "　折れようとしていた心が見せた幻。"

#. Occurrence 5B_14:10580:6234: scene=5B_14
#: 5B_14:10580
msgctxt "text_id=6234 | speaker=unknown"
msgid "  Whining had had the opposite effect on her; her pride was now ablaze."
msgstr "　最低ラインの弱音が、逆に少女の<誇|ほこ>りに火をつけた。"

#. Occurrence 5B_14:10616:6235: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_14_0003; voice_prefix=A30; voice_category=3; scene=5B_14
#: 5B_14:10616
msgctxt "text_id=6235 | speaker=soujuurou"
msgid "\"So you're going to run from this responsibility, too?\""
msgstr "『―――逃げるのか？』"

#. Occurrence 5B_14:10659:6236: scene=5B_14
#: 5B_14:10659
msgctxt "text_id=6236 | speaker=unknown"
msgid "  Soujyuro was right. Her opponent had put her in check, but she had done the same to it. It was clear why she was losing, so now all she needed was a counter-plan, well within her abilities."
msgstr "　そうだ。自分は王手をかけられているが、それは相手も同じこと。なぜ負けているかは明白で、あとは対策を立てるだけ。それは十分に実行可能だ。"

#. Occurrence 5B_14:10665:6237: scene=5B_14
#: 5B_14:10665
msgctxt "text_id=6237 | speaker=unknown"
msgid "No matter the odds, she was not one to give up without giving it one last shot."
msgstr "たしかに無茶な話だけど、試す前から諦めるのは許されない。"

#. Occurrence 5B_14:10781:6238: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0045; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:10781
msgctxt "text_id=6238 | speaker=aoko"
msgid "(That's right."
msgstr "“……そうだ。"

#. Occurrence 5B_14:10787:6239: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0046; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:10787
msgctxt "text_id=6239 | speaker=aoko"
msgid "  Giving up only comes after you've tried absolutely everything!)"
msgstr "　放りだすのは、やれる事を全部やってから……！”"

#. Occurrence 5B_14:10793:6240: scene=5B_14
#: 5B_14:10793
msgctxt "text_id=6240 | speaker=unknown"
msgid "  Her numbed fingers clenched into a tight fist."
msgstr "　もう感覚さえ無い指を握りしめる。"

#. Occurrence 5B_14:10798:6241: scene=5B_14
#: 5B_14:10798
msgctxt "text_id=6241 | speaker=unknown"
msgid "  She was betting against the house, an unreasonable gamble that should have made her question her sanity."
msgstr "　思考に浮かんだ無理難題は、正気を疑う大博打だ。"

#. Occurrence 5B_14:10803:6242: scene=5B_14
#: 5B_14:10803
msgctxt "text_id=6242 | speaker=unknown"
msgid "  If her first step was off by an inch, her body would be instantly vaporized."
msgstr "　はじめの一歩をコンマでも間違えれば、その時点で青子の体は蒸発する。"

#. Occurrence 5B_14:10835:6243: scene=5B_14
#: 5B_14:10835
msgctxt "text_id=6243 | speaker=unknown"
msgid "  But..."
msgstr "　ああ、でも―――"

#. Occurrence 5B_14:10872:6244: scene=5B_14
#: 5B_14:10872
msgctxt "text_id=6244 | speaker=unknown"
msgid "  She knew a boy who never fled."
msgstr "　彼女は、逃げなかった少年を知っている。"

#. Occurrence 5B_14:10969:6245: scene=5B_14
#: 5B_14:10969
msgctxt "text_id=6245 | speaker=unknown"
msgid "  She knew of a steadfast courage that could shine its light, no matter how small, through any desperate situation."
msgstr "　絶体絶命の窮地なのにギリギリまで耐え続けた、ちっぽけでも輝ける、強い勇気を知っている。"

#. Occurrence 5B_14:11073:6246: scene=5B_14
#: 5B_14:11073
msgctxt "text_id=6246 | speaker=unknown"
msgid "  Yes. There was more than just herself to be concerned about."
msgstr "　そう。この敗北は自分だけの問題ではない。"

#. Occurrence 5B_14:11078:6247: scene=5B_14
#: 5B_14:11078
msgctxt "text_id=6247 | speaker=unknown"
msgid "  If that ice fell, it would mean the destruction of the park in its entirety."
msgstr "　あの氷が落ちれば遊園地そのものが倒壊する。"

#. Occurrence 5B_14:11083:6248: scene=5B_14
#: 5B_14:11083
msgctxt "text_id=6248 | speaker=unknown"
msgid "  Everything he had achieved, everything he had risked and dared and happily put his life on the line for, would all be for naught."
msgstr "　平気な顔で、命懸けの綱渡りをやり通した誰かさんの成果も無駄になる。"

#. Occurrence 5B_14:11090:6249: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0047; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:11090
msgctxt "text_id=6249 | speaker=aoko"
msgid "(...Really."
msgstr "“―――ほんと。"

#. Occurrence 5B_14:11096:6250: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0048; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:11096
msgctxt "text_id=6250 | speaker=aoko"
msgid "  What possessed him to be so bullheaded!?)"
msgstr "　それじゃ、何のために意地を張ったか分からない……！”"

#. Occurrence 5B_14:11243:6251: scene=5B_14
#: 5B_14:11243
msgctxt "text_id=6251 | speaker=unknown"
msgid "  Determination and confidence surged through her like electricity."
msgstr "　決意と自信は、それこそ<迸|はし>る電荷のように。"

#. Occurrence 5B_14:11248:6252: scene=5B_14
#: 5B_14:11248
msgctxt "text_id=6252 | speaker=unknown"
msgid "  She was in no mood to be crushed by a giant sheet of ice."
msgstr "　このまま氷に押しつぶされるのなんて願い下げ。"

#. Occurrence 5B_14:11253:6253: scene=5B_14
#: 5B_14:11253
msgctxt "text_id=6253 | speaker=unknown"
msgid "  If she was going to lose, she'd rather do so as the grandest firework possible."
msgstr "　どうせ負けるのなら自滅がいい、と少女は笑った。"

#. Occurrence 5B_14:11258:6254: scene=5B_14
#: 5B_14:11258
msgctxt "text_id=6254 | speaker=unknown"
msgid "  Aoko was a sore loser. At this point, she would rather burn herself to cinders than let it decide her end."
msgstr "　負けず嫌いでご免あそばせ。こうなったらやられる前に、灰になるまで燃え尽きてやる―――！"

#. Occurrence 5B_14:11413:6255: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0049; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:11413
msgctxt "text_id=6255 | speaker=aoko"
msgid "\"<Disconnect! Expand area! Reconnect!|Change, change, change!>\""
msgstr "「<接|チ><続|ェ><解|ン><除|ジ>―――<領|チ><域|ェ><拡|ン><大|ジ>、<再接続|チェンジ>―――！」"

#. Occurrence 5B_14:11428:6256: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0050; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:11428
msgctxt "text_id=6256 | speaker=aoko"
msgid "  She grunted in pain."
msgstr "“ぐ、つぅ―――！”"

#. Occurrence 5B_14:11433:6257: scene=5B_14
#: 5B_14:11433
msgctxt "text_id=6257 | speaker=unknown"
msgid "  Energy raged through her body."
msgstr "　激流する体内魔力。"

#. Occurrence 5B_14:11438:6258: scene=5B_14
#: 5B_14:11438
msgctxt "text_id=6258 | speaker=unknown"
msgid "  Her circuits were on the verge of disintegration."
msgstr "　分解寸前の魔術回路。"

#. Occurrence 5B_14:11443:6259: scene=5B_14
#: 5B_14:11443
msgctxt "text_id=6259 | speaker=unknown"
msgid "  Inscribed upon her body, her Magic Crest was magecraft given physical form. It did not, however, stop with simply skin and flesh. It burrowed to the very marrow of her bones."
msgstr "　魔術をカタチにした刻印は皮膚や肉のみならず、骨の<髄|ずい>、骨の<芯|しん>までその文字を刻んでいく。"

#. Occurrence 5B_14:11578:6260: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0051; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:11578
msgctxt "text_id=6260 | speaker=aoko"
msgid "\"Grrr.... GAHAH!\""
msgstr "「は―――いっっ、つぅ…………！」"

#. Occurrence 5B_14:11586:6261: scene=5B_14
#: 5B_14:11586
msgctxt "text_id=6261 | speaker=unknown"
msgid "  A playful smile graced her lips."
msgstr "　口元に<諧謔|かいぎゃく>の笑みが浮かぶ。"

#. Occurrence 5B_14:11591:6262: scene=5B_14
#: 5B_14:11591
msgctxt "text_id=6262 | speaker=unknown"
msgid "  Her sense of reason had been turned upside-down by the pain."
msgstr "　あまりの激痛に理性、基準が逆転した。"

#. Occurrence 5B_14:11596:6263: scene=5B_14
#: 5B_14:11596
msgctxt "text_id=6263 | speaker=unknown"
msgid "  That was only natural."
msgstr "　それも当然。"

#. Occurrence 5B_14:11602:6264: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0052; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:11602
msgctxt "text_id=6264 | speaker=aoko"
msgid "(Huh. I can do this!)"
msgstr "“なんだ、やればできるじゃない私……！”"

#. Occurrence 5B_14:11607:6265: scene=5B_14
#: 5B_14:11607
msgctxt "text_id=6265 | speaker=unknown"
msgid "  She had to praise her own body for holding out so long while pushed beyond its limits."
msgstr "　極限を<迎|むか>えてまだ耐えている自分の体を、誉めてやらないでどうするのか―――！"

#. Occurrence 5B_14:11749:6266: scene=5B_14
#: 5B_14:11749
msgctxt "text_id=6266 | speaker=unknown"
msgid "  The skull face noticed the abnormality."
msgstr "　髑髏の面が異常に気付く。"

#. Occurrence 5B_14:11754:6267: scene=5B_14
#: 5B_14:11754
msgctxt "text_id=6267 | speaker=unknown"
msgid "  It finally recognized the challenge for dominance over this space."
msgstr "　空間の支配率が拮抗している事を、彼はようやく観測した。"

#. Occurrence 5B_14:11759:6268: scene=5B_14
#: 5B_14:11759
msgctxt "text_id=6268 | speaker=unknown"
msgid "  It laughed at the conceit it faced."
msgstr "　だがその慢心を笑えようか。"

#. Occurrence 5B_14:11764:6269: scene=5B_14
#: 5B_14:11764
msgctxt "text_id=6269 | speaker=unknown"
msgid "  Never did it expect a Magician to challenge the great Flat Snark, lord of vessels over a millennium, and in such an age of decline!"
msgstr "　千年を越える器物の王、フラットスナークに勝る“魔力使い”が、この末世の時代に現れるなど―――！"

#. Occurrence 5B_14:11858:6270: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0053; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:11858
msgctxt "text_id=6270 | speaker=aoko"
msgid "\"Hrrrgh... UGH!\""
msgstr "「ふ―――っ、うっ……！」"

#. Occurrence 5B_14:11864:6271: scene=5B_14
#: 5B_14:11864
msgctxt "text_id=6271 | speaker=unknown"
msgid "  She tried to catch her breath."
msgstr "　呼吸を整える。"

#. Occurrence 5B_14:11869:6272: scene=5B_14
#: 5B_14:11869
msgctxt "text_id=6272 | speaker=unknown"
msgid "  She braced herself for the coming pain."
msgstr "　この後に来るであろう激痛に身構える。"

#. Occurrence 5B_14:11874:6273: scene=5B_14
#: 5B_14:11874
msgctxt "text_id=6273 | speaker=unknown"
msgid "  She was going to smash that ice to pieces."
msgstr "　<あ|・><の|・><氷|・><を|・><撃|・><ち|・><破|・><る|・>。"

#. Occurrence 5B_14:11879:6274: scene=5B_14
#: 5B_14:11879
msgctxt "text_id=6274 | speaker=unknown"
msgid "  Both had access to the same amount of magical energy."
msgstr "　使用できる魔力量は同じ。"

#. Occurrence 5B_14:11884:6275: scene=5B_14
#: 5B_14:11884
msgctxt "text_id=6275 | speaker=unknown"
msgid "  One of them was greatly outmatched, but..."
msgstr "　なのに力負けしているのは、つまり―――"

#. Occurrence 5B_14:11998:6276: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0054; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:11998
msgctxt "text_id=6276 | speaker=aoko"
msgid "(There was a difference in our output. If I'm losing because of the scale of energy absorption and the size of the barrel, then..."
msgstr "“……出力装置に差があった。魔力の吸飲、砲身の規模で負けているのなら。"

#. Occurrence 5B_14:12004:6277: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0055; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:12004
msgctxt "text_id=6277 | speaker=aoko"
msgid "  The solution is simple. All I need to do is make the formula bigger, and me with it!)"
msgstr "　単純な話、<術式|わたし>を<増築|でかく>するだけでいい―――！”"

#. Occurrence 5B_14:12050:6278: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0056; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:12050
msgctxt "text_id=6278 | speaker=aoko"
msgid "\"<Reconnect bullet configuration!|Change Tour Plan!>\""
msgstr "「―――<再接続|チェンジ>、<魔弾|ツアー><形式|プラン>―――」"

#. Occurrence 5B_14:12275:6279: scene=5B_14
#: 5B_14:12275
msgctxt "text_id=6279 | speaker=unknown"
msgid "  The feedback would go beyond anything she had experienced to date."
msgstr "　フィードバックは今までの比ではないだろう。"

#. Occurrence 5B_14:12280:6280: scene=5B_14
#: 5B_14:12280
msgctxt "text_id=6280 | speaker=unknown"
msgid "  Quite simply, her decision went beyond recklessness."
msgstr "　彼女の選択は単純にして、蛮勇きわまりない。"

#. Occurrence 5B_14:12285:6281: scene=5B_14
#: 5B_14:12285
msgctxt "text_id=6281 | speaker=unknown"
msgid "  She expanded both formulae to maximum size."
msgstr "　最大展開する二つの術式。"

#. Occurrence 5B_14:12290:6282: scene=5B_14
#: 5B_14:12290
msgctxt "text_id=6282 | speaker=unknown"
msgid "  The first layer would transform into a giant vortex, swallowing up the mist."
msgstr "　一層は巨大な渦と化して霧という霧を飲みこみ、"

#. Occurrence 5B_14:12295:6283: scene=5B_14
#: 5B_14:12295
msgctxt "text_id=6283 | speaker=unknown"
msgid "  The second layer would process it from one end and pump it into her, the barrel."
msgstr "　二層はかたっぱしから魔力を加工して<砲身|あおこ>に注ぎ込む。"

#. Occurrence 5B_14:12425:6284: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0057; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:12425
msgctxt "text_id=6284 | speaker=aoko"
msgid "\"...I was naïve,"
msgstr "「―――私の想定が甘かった。"

#. Occurrence 5B_14:12431:6285: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0058; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:12431
msgctxt "text_id=6285 | speaker=aoko"
msgid "  thinking I could do something cute like shoot it down."
msgstr "　撃ち落とす、なんてハンパもいいとこ。"

#. Occurrence 5B_14:12437:6286: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0059; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:12437
msgctxt "text_id=6286 | speaker=aoko"
msgid "  What I need to do is blast it to hell!\""
msgstr "　この場合、跡形もなく<撃|・><ち|・><砕|・><く|・>、だっ……！」"

#. Occurrence 5B_14:12541:6287: scene=5B_14
#: 5B_14:12541
msgctxt "text_id=6287 | speaker=unknown"
msgid "  Primeval power answered the spellcaster's conviction."
msgstr "　術者の確信に、太古の魔力が呼応する。"

#. Occurrence 5B_14:12546:6288: scene=5B_14
#: 5B_14:12546
msgctxt "text_id=6288 | speaker=unknown"
msgid "  It formed the pattern of a writhing serpent."
msgstr "　のたうち回る<大蛇|オロチ>の紋様。"

#. Occurrence 5B_14:12551:6289: scene=5B_14
#: 5B_14:12551
msgctxt "text_id=6289 | speaker=unknown"
msgid "  Voiceless magical power flew a banner of revolution."
msgstr "　反旗を<翻|ひるが>す声なき魔力。"

#. Occurrence 5B_14:12682:6290: scene=5B_14
#: 5B_14:12682
msgctxt "text_id=6290 | speaker=unknown"
msgid "  Now, look upon the earth, o venerable one."
msgstr "　さあ―――いざ地を<省|かえり>みよ<貴|たけ>き遺産。"

#. Occurrence 5B_14:12687:6291: scene=5B_14
#: 5B_14:12687
msgctxt "text_id=6291 | speaker=unknown"
msgid "  See now this pioneer, this first among trailblazers."
msgstr "　あれなるは開拓の<最先端|トップランナー>。"

#. Occurrence 5B_14:12692:6292: scene=5B_14
#: 5B_14:12692
msgctxt "text_id=6292 | speaker=unknown"
msgid "  She embodies a species that knows no fear, that renders naught all manner of Mystic and tradition."
msgstr "　これより数多の神秘、あらゆる伝統を台無しにする、恐れ知らずの人類代表。"

#. Occurrence 5B_14:12830:6293: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0060; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:12830
msgctxt "text_id=6293 | speaker=aoko"
msgid "\"I'm done borrowing from you, you lying boojum."
msgstr "「貸し借りはここまでよ嘘つきブージャム。"

#. Occurrence 5B_14:12836:6294: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0061; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:12836
msgctxt "text_id=6294 | speaker=aoko"
msgid "  If you really want it, I'm more than happy to give it all back!\""
msgstr "　お望み通り、ノシをつけて返してあげる……！」"

#. Occurrence 5B_14:12842:6295: scene=5B_14
#: 5B_14:12842
msgctxt "text_id=6295 | speaker=unknown"
msgid "  For the newest Magician commands the principles of consumption and extinction!"
msgstr "　消費／消滅の理を<担|にな>う、最新の魔法使い―――！"

#. Occurrence 5B_14:13353:6296: scene=5B_14
#: 5B_14:13353
msgctxt "text_id=6296 | speaker=unknown"
msgid "  An aberrant bullet of light melted through the castle of ice."
msgstr "　常識外の光弾が氷の城を融解させる。"

#. Occurrence 5B_14:13358:6297: scene=5B_14
#: 5B_14:13358
msgctxt "text_id=6297 | speaker=unknown"
msgid "  The barrel held fast."
msgstr "　砲身は焼ききれない。"

#. Occurrence 5B_14:13479:6298: scene=5B_14
#: 5B_14:13479
msgctxt "text_id=6298 | speaker=unknown"
msgid "  Her control of magical energy was divine."
msgstr "　彼女の魔力の扱いは神懸かっている。"

#. Occurrence 5B_14:13484:6299: scene=5B_14
#: 5B_14:13484
msgctxt "text_id=6299 | speaker=unknown"
msgid "  One hundred thousand miles of veins, equal to two and a half times the circumference of the Earth, hungrily drank in the magical energy. The subsequent magical strike hurtled straight up at the moon."
msgstr "　最大十万キロ、赤道の二周半に相当する<血管|バイパス>は貪欲に魔力を受け入れ、倍の速度で魔弾を月へとたたき込む―――！"

#. Occurrence 5B_14:13666:6300: scene=5B_14
#: 5B_14:13666
msgctxt "text_id=6300 | speaker=unknown"
msgid "  NO NO NO NO!"
msgstr "　否　否　否　否！"

#. Occurrence 5B_14:13672:6301: scene=5B_14
#: 5B_14:13672
msgctxt "text_id=6301 | speaker=unknown"
msgid "  Death rose from the moon's surface."
msgstr "　月面に死相が浮かぶ。"

#. Occurrence 5B_14:13677:6302: scene=5B_14
#: 5B_14:13677
msgctxt "text_id=6302 | speaker=unknown"
msgid "  A cry of indignant terror echoed through the abandoned park."
msgstr "　廃遊園地に響く、恐怖あるいは<憤怒|ふんぬ>の叫び。"

#. Occurrence 5B_14:13682:6303: scene=5B_14
#: 5B_14:13682
msgctxt "text_id=6303 | speaker=unknown"
msgid "  Reality was burned into the eyes of this creature of fantasy."
msgstr "　幻想に生きるソレにとって、現実はかくもおぞましく<眼|まなこ>を焦がす。"

#. Occurrence 5B_14:13705:6304: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0062; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:13705
msgctxt "text_id=6304 | speaker=aoko"
msgid "\"...Hah.\""
msgstr "「―――ハ」"

#. Occurrence 5B_14:13711:6305: scene=5B_14
#: 5B_14:13711
msgctxt "text_id=6305 | speaker=unknown"
msgid "  To Aoko, its vain struggle was the taste of victory."
msgstr "　その悪あがきに、彼女は勝利を確信した。"

#. Occurrence 5B_14:13716:6306: scene=5B_14
#: 5B_14:13716
msgctxt "text_id=6306 | speaker=unknown"
msgid "  Victory despite her absolute reckless use of magical energy."
msgstr "　あまりにも無駄な魔力の使い方だ。"

#. Occurrence 5B_14:13721:6307: scene=5B_14
#: 5B_14:13721
msgctxt "text_id=6307 | speaker=unknown"
msgid "  The energy scales had been tipped to their breaking point but nevertheless in her favor."
msgstr "　<傾|かたむ>きだしていた魔力の天秤は、完全に彼女のもとへなだれこみ―――"

#. Occurrence 5B_14:13728:6308: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0063; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:13728
msgctxt "text_id=6308 | speaker=aoko"
msgid "\"<Bullet configuration...|Tour Plan...>\""
msgstr "「<魔弾形|　ツアープラン>式―――」"

#. Occurrence 5B_14:13774:6309: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0064; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:13774
msgctxt "text_id=6309 | speaker=aoko"
msgid "\"<Total eclipse, converge|Blacklight, Starbow!>!"
msgstr "「<大月蝕|ブラックライト>、<収斂投|　スターボウ>射―――！"

#. Occurrence 5B_14:13780:6310: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0065; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:13780
msgctxt "text_id=6310 | speaker=aoko"
msgid "  Tear it a new one!\""
msgstr "　一気に、ブチ抜けぇーーーーーえ！！！！！」"

#. Occurrence 5B_14:14342:6311: scene=5B_14
#: 5B_14:14342
msgctxt "text_id=6311 | speaker=unknown"
msgid "  Shatter. Shatter. Shatter. Shatter."
msgstr "　砕く。砕く。砕く。砕く。"

#. Occurrence 5B_14:14347:6312: scene=5B_14
#: 5B_14:14347
msgctxt "text_id=6312 | speaker=unknown"
msgid "  The skyscraper scattered into atomized dust."
msgstr "　微塵と散る摩天楼。"

#. Occurrence 5B_14:14352:6313: scene=5B_14
#: 5B_14:14352
msgctxt "text_id=6313 | speaker=unknown"
msgid "  The island, its unattainability extolled, had swallowed whole the despair of its many challengers."
msgstr "　決して届かぬと謳われ、多くの挑戦者を飲んだ絶望の島。"

#. Occurrence 5B_14:14470:6314: scene=5B_14
#: 5B_14:14470
msgctxt "text_id=6314 | speaker=unknown"
msgid "  Long had it proudly eluded mankind's intellect..."
msgstr "　その、人智<未踏|みとう>を誇った先にあるモノこそ―――"

#. Occurrence 5B_14:14551:6315: scene=5B_14
#: 5B_14:14551
msgctxt "text_id=6315 | speaker=unknown"
msgid "  Yet now, azure mist bemoaned its demise."
msgstr "　破滅を叫ぶ紺碧の霧。"

#. Occurrence 5B_14:14556:6316: scene=5B_14
#: 5B_14:14556
msgctxt "text_id=6316 | speaker=unknown"
msgid "  In the sky, the icy canopy crumbled."
msgstr "　崩壊する絶氷の<天|ソ><蓋|ラ>。"

#. Occurrence 5B_14:14562:6317: scene=5B_14
#: 5B_14:14562
msgctxt "text_id=6317 | speaker=unknown"
msgid "  The Snark-hunting bullet jumped over the moon."
msgstr "　スナーク<狩り|ハント>の魔弾は月を越えて。"

#. Occurrence 5B_14:14568:6318: scene=5B_14
#: 5B_14:14568
msgctxt "text_id=6318 | speaker=unknown"
msgid "  Its throes of death sounded like the roaring sea, reverberating across this fairy-tale land."
msgstr "　断末魔は<潮騒|しおさい>のように、御伽の国に響き渡り―――"

#. Occurrence 5B_14:14715:6319: scene=5B_14
#: 5B_14:14715
msgctxt "text_id=6319 | speaker=unknown"
msgid "  ...The battle was over."
msgstr "　―――勝敗は、ここに決した。"

#. Occurrence 5B_14:14721:6320: scene=5B_14
#: 5B_14:14721
msgctxt "text_id=6320 | speaker=unknown"
msgid "  The thick fog dissipated, and the shattered ice melted away before it hit the ground."
msgstr "　濃霧は途絶え、砕かれた氷は地上に降ることなく霧散していく。"

#. Occurrence 5B_14:14726:6321: scene=5B_14
#: 5B_14:14726
msgctxt "text_id=6321 | speaker=unknown"
msgid "  A lethal bullet unseated the night king from his throne, affording him no time to grieve his loss."
msgstr "　魔弾は敗因を悔やませる間もなく、玉座ごと夜の王を撃ち砕いた。"

#. Occurrence 5B_14:14747:6322: scene=5B_14
#: 5B_14:14747
msgctxt "text_id=6322 | speaker=unknown"
msgid "  The Oil of the Moon."
msgstr "　月の油。"

#. Occurrence 5B_14:14752:6323: scene=5B_14
#: 5B_14:14752
msgctxt "text_id=6323 | speaker=unknown"
msgid "  The Untouched―Flat Snark."
msgstr "　触れられぬもの、フラットスナーク。"

#. Occurrence 5B_14:14758:6324: scene=5B_14
#: 5B_14:14758
msgctxt "text_id=6324 | speaker=unknown"
msgid "  The dreamscape that had begun with its resurrection ended with its demise, drawing a close to the nightmare."
msgstr "　廃棄されたモノを蘇らせる一夜の夢は、自らの死をもって、悪夢に幕を下ろしたのだ。"

#. Occurrence 5B_15:103:6325: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_15_0000; voice_prefix=A10; voice_category=1; scene=5B_15
#: 5B_15:103
msgctxt "text_id=6325 | speaker=aoko"
msgid "\"...Oh man. I guess I kind of went overboard.\""
msgstr "「―――うわ。さすがに、無茶だわ」"

#. Occurrence 5B_15:153:6326: scene=5B_15
#: 5B_15:153
msgctxt "text_id=6326 | speaker=unknown"
msgid "  Flat on her back, Aoko looked up at the night sky."
msgstr "　青子は倒れたまま夜空を見上げている。"

#. Occurrence 5B_15:158:6327: scene=5B_15
#: 5B_15:158
msgctxt "text_id=6327 | speaker=unknown"
msgid "  She lay there perfectly still, not able to move a single finger."
msgstr "　体はもう指一本だって動かない。"

#. Occurrence 5B_15:163:6328: scene=5B_15
#: 5B_15:163
msgctxt "text_id=6328 | speaker=unknown"
msgid "  When she tried, her whole body screamed out in agony."
msgstr "　なんとか体を起こそうと力を入れてみたが、どこもかしこも悲鳴をあげている。"

#. Occurrence 5B_15:183:6329: scene=5B_15
#: 5B_15:183
msgctxt "text_id=6329 | speaker=unknown"
msgid "  She was completely empty of magical energy, and her Magic Crest had come to a halt."
msgstr "　魔力はすっからかんで、魔術刻印も停止していた。"

#. Occurrence 5B_15:188:6330: scene=5B_15
#: 5B_15:188
msgctxt "text_id=6330 | speaker=unknown"
msgid "  She estimated that it would likely require a whole day to recover all her bodily functions."
msgstr "　体力の回復……もとい、身体機能の完全回復には丸一日を要するだろう。"

#. Occurrence 5B_15:193:6331: scene=5B_15
#: 5B_15:193
msgctxt "text_id=6331 | speaker=unknown"
msgid "  Sadly, all she could really do in that moment was take a breath."
msgstr "　情けない話だが、今は呼吸だけで精一杯。"

#. Occurrence 5B_15:212:6332: scene=5B_15
#: 5B_15:212
msgctxt "text_id=6332 | speaker=unknown"
msgid "  At least her chest was swelling with pride."
msgstr "　反面、胸はかつてない達成感に満ちていた。"

#. Occurrence 5B_15:253:6333: scene=5B_15
#: 5B_15:253
msgctxt "text_id=6333 | speaker=unknown"
msgid "  She had gone toe to toe with a fairy-tale monster and had emerged victorious."
msgstr "　なにしろ、あの“童話の怪物”のうち一体を真っ向から撃ち壊したのだ。"

#. Occurrence 5B_15:258:6334: scene=5B_15
#: 5B_15:258
msgctxt "text_id=6334 | speaker=unknown"
msgid "  The battlefield conditions had favored her, it was true, but there was no denying that Aoko had come a long way in the last six months."
msgstr "　自分に有利な状況が続いただけ、とも言えるが、手も足もでなかった半年前に比べれば格段の進歩である。"

#. Occurrence 5B_15:332:6335: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_15_0001; voice_prefix=A10; voice_category=1; scene=5B_15
#: 5B_15:332
msgctxt "text_id=6335 | speaker=aoko"
msgid "(...Luck or not, I owe Alice an apology."
msgstr "“……それはそれとして、有珠には<謝|あやま>っとかないと。"

#. Occurrence 5B_15:338:6336: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_15_0002; voice_prefix=A10; voice_category=1; scene=5B_15
#: 5B_15:338
msgctxt "text_id=6336 | speaker=aoko"
msgid "  Once a Ploy's been broken, it's gone forever.)"
msgstr "　プロイって、壊したらそれっきりだものね”"

#. Occurrence 5B_15:344:6337: scene=5B_15
#: 5B_15:344
msgctxt "text_id=6337 | speaker=unknown"
msgid "  Flat Snark would never again return to this world."
msgstr "　そう。フラットスナークはもう二度と現れない。"

#. Occurrence 5B_15:349:6338: scene=5B_15
#: 5B_15:349
msgctxt "text_id=6338 | speaker=unknown"
msgid "   It was an insanely rare item, so invaluable that it would have been impossible to price it for auction at the Association in London."
msgstr "　ロンドンの協会に売り出せば値の付かない超稀少品、"

#. Occurrence 5B_15:354:6339: scene=5B_15
#: 5B_15:354
msgctxt "text_id=6339 | speaker=unknown"
msgid "  Aoko had sent Alice's priceless treasure to oblivion."
msgstr "　魔術世界の財産とまで言われる秘術を、青子は跡形もなくブッ壊してしまったのだ。"

#. Occurrence 5B_15:359:6340: scene=5B_15
#: 5B_15:359
msgctxt "text_id=6340 | speaker=unknown"
msgid "  Needless to say, things had gotten more than a little out of hand."
msgstr "　なんというか、その場のノリと勢いで。"

#. Occurrence 5B_15:398:6341: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_15_0003; voice_prefix=A10; voice_category=1; scene=5B_15
#: 5B_15:398
msgctxt "text_id=6341 | speaker=aoko"
msgid "(Still...)"
msgstr "“まあ、でも―――”"

#. Occurrence 5B_15:433:6342: scene=5B_15
#: 5B_15:433
msgctxt "text_id=6342 | speaker=unknown"
msgid "  They had both agreed to the fight, so Alice probably would not complain."
msgstr "　お互い納得ずくの戦いだったから、有珠は文句ひとつ言わないだろう。"

#. Occurrence 5B_15:438:6343: scene=5B_15
#: 5B_15:438
msgctxt "text_id=6343 | speaker=unknown"
msgid "  Even if she was furious, she would never be so undignified as to show it."
msgstr "　内心では不満いっぱいと思われるが、あの少女はそういう、自らの品格を落とす真似はしないのだ。"

#. Occurrence 5B_15:514:6344: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_15_0004; voice_prefix=A10; voice_category=1; scene=5B_15
#: 5B_15:514
msgctxt "text_id=6344 | speaker=aoko"
msgid "\"Ugh...\""
msgstr "「っ―――」"

#. Occurrence 5B_15:713:6345: scene=5B_15
#: 5B_15:713
msgctxt "text_id=6345 | speaker=unknown"
msgid "  The second Aoko relaxed, her fatigue finally caught up with her."
msgstr "　安心から気が緩み、積み重なった疲労がなだれこむ。"

#. Occurrence 5B_15:718:6346: scene=5B_15
#: 5B_15:718
msgctxt "text_id=6346 | speaker=unknown"
msgid "  She did everything in her power to fight off the overwhelming drowsiness."
msgstr "　失神じみた眠気を青子は理性で押しとどめた。"

#. Occurrence 5B_15:723:6347: scene=5B_15
#: 5B_15:723
msgctxt "text_id=6347 | speaker=unknown"
msgid "  Aside from a few minor internal injuries, her body was miraculously unscathed. She felt like she could probably stand up and dust herself off after a bit of rest."
msgstr "　体の中は細かい傷だらけだが、奇跡的に外傷はない。このまま<十分|じゅっぷん>も休んでいれば立ち上がる事ぐらいはできそうだ。"

#. Occurrence 5B_15:813:6348: scene=5B_15
#: 5B_15:813
msgctxt "text_id=6348 | speaker=unknown"
msgid "  The golden moon continued to burn in the night sky."
msgstr "　夜空には、いまだ炎上する黄金の月。"

#. Occurrence 5B_15:820:6349: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_15_0005; voice_prefix=A10; voice_category=1; scene=5B_15
#: 5B_15:820
msgctxt "text_id=6349 | speaker=aoko"
msgid "(Well, you are oil, after all. You could probably burn for―)"
msgstr "“正体は油だものね。そりゃあ、いつまでも燃え―――”"

#. Occurrence 5B_15:830:6350: scene=5B_15
#: 5B_15:830
msgctxt "text_id=6350 | speaker=unknown"
msgid "  Aoko's bleary eyes went wide in astonishment."
msgstr "　<漠然|ばくぜん>と空を見ていた目が、<愕然|がくぜん>とした空白に切り替わる。"

#. Occurrence 5B_15:850:6351: scene=5B_15
#: 5B_15:850
msgctxt "text_id=6351 | speaker=unknown"
msgid "  She was still unable to lift a finger."
msgstr "　彼女は指一本動かない状態で、"

#. Occurrence 5B_15:857:6352: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_15_0006; voice_prefix=A10; voice_category=1; scene=5B_15
#: 5B_15:857
msgctxt "text_id=6352 | speaker=aoko"
msgid "(Oh, right. The Baker who found the Snark disappeared along with it...)"
msgstr "“……そっか。スナークを見つけたベイカーも、最後はいっしょに消えるんだっけ―――”"

#. Occurrence 5B_15:1017:6353: scene=5B_15
#: 5B_15:1017
msgctxt "text_id=6353 | speaker=unknown"
msgid "  She sighed in resignation."
msgstr "　あーあ、と。"

#. Occurrence 5B_15:1022:6354: scene=5B_15
#: 5B_15:1022
msgctxt "text_id=6354 | speaker=unknown"
msgid "  Aoko accepted that her final stand left her with only ten seconds before she burned to ash, too."
msgstr "　最後の反撃で燃え尽きる、十秒後の<自分|みらい>を受け入れた。"

#. Occurrence 5B_15:1082:6355: scene=5B_15
#: 5B_15:1082
msgctxt "text_id=6355 | speaker=unknown"
msgid "  Elsewhere, just a short moment prior..."
msgstr "　―――一方、そのちょっと前。"

#. Occurrence 5B_15:1088:6356: scene=5B_15
#: 5B_15:1088
msgctxt "text_id=6356 | speaker=unknown"
msgid "  Buffeted by strong winds atop the roller coaster, Soujyuro gravely peered down at the ground."
msgstr "　強風<荒|すさ>ぶ<鉄骨橋|コースター>の上で、難しい顔のまま、彼は地上に目をこらしていた。"

#. Occurrence 5B_15:1150:6357: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0000; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:1150
msgctxt "text_id=6357 | speaker=soujuurou"
msgid "\"...Hmm?\""
msgstr "「―――むむ？」"

#. Occurrence 5B_15:1197:6358: scene=5B_15
#: 5B_15:1197
msgctxt "text_id=6358 | speaker=unknown"
msgid "  All he could muster was a single murmur."
msgstr "　こぼれた呟きはこの上なく頼りない。"

#. Occurrence 5B_15:1202:6359: scene=5B_15
#: 5B_15:1202
msgctxt "text_id=6359 | speaker=unknown"
msgid "  He could see Aoko on top of some drawing on the ground, and..."
msgstr "　彼の視線の先。地上ではクリーチャーたちの目を盗んで地面に図形を刻んでいる青子の姿と―――"

#. Occurrence 5B_15:1268:6360: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0001; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:1268
msgctxt "text_id=6360 | speaker=soujuurou"
msgid "\"...What in the world is that thing made of?\""
msgstr "「……なんだアレ。いくらなんでも頑丈すぎないか？」"

#. Occurrence 5B_15:1274:6361: scene=5B_15
#: 5B_15:1274
msgctxt "text_id=6361 | speaker=unknown"
msgid "  In the distance..."
msgstr "　そのずっと向こう。"

#. Occurrence 5B_15:1279:6362: scene=5B_15
#: 5B_15:1279
msgctxt "text_id=6362 | speaker=unknown"
msgid "  There was something familiar in the direction of the ruined house of mirrors."
msgstr "　倒壊したミラーハウスの方角に、何か、見覚えのあるモノを見た気がした。"

#. Occurrence 5B_15:1299:6363: scene=5B_15
#: 5B_15:1299
msgctxt "text_id=6363 | speaker=unknown"
msgid "  Soujyuro's job―to throw Aoko's hair from a great height―was complete."
msgstr "　草十郎の役割……地上六十メートルの高みから青子の髪を投げる、という仕事は終わっている。"

#. Occurrence 5B_15:1304:6364: scene=5B_15
#: 5B_15:1304
msgctxt "text_id=6364 | speaker=unknown"
msgid "  While not the most impressive of tasks, it was absolutely a matter of life or death."
msgstr "　派手さこそないが、掛け値無しで命がけの難行だった。"

#. Occurrence 5B_15:1381:6365: scene=5B_15
#: 5B_15:1381
msgctxt "text_id=6365 | speaker=unknown"
msgid "  And to top it all off, just thinking about how he was going to get back down to the ground was making him dizzy."
msgstr "　さらに付け加えるのなら、この後どうやって下りるのかを考えるだけで目眩がする。"

#. Occurrence 5B_15:1386:6366: scene=5B_15
#: 5B_15:1386
msgctxt "text_id=6366 | speaker=unknown"
msgid "  He had experienced more than enough trouble for one day."
msgstr "　これ以上の厄介事なんて、とてもじゃないが頷けない。"

#. Occurrence 5B_15:1422:6367: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0002; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:1422
msgctxt "text_id=6367 | speaker=soujuurou"
msgid "\"Wait, but...\""
msgstr "「―――いや、でも、アレ―――」"

#. Occurrence 5B_15:1717:6368: scene=5B_15
#: 5B_15:1717
msgctxt "text_id=6368 | speaker=unknown"
msgid "  He was flustered as he stood atop the swaying bridge."
msgstr "　ぐらぐら揺れる橋の上で、わたわたと取り乱す。"

#. Occurrence 5B_15:1903:6369: scene=5B_15
#: 5B_15:1903
msgctxt "text_id=6369 | speaker=unknown"
msgid "  A skull suddenly appeared in the sky above."
msgstr "　空には前触れなく現れた髑髏の面。"

#. Occurrence 5B_15:1926:6370: scene=5B_15
#: 5B_15:1926
msgctxt "text_id=6370 | speaker=unknown"
msgid "  On the ground, he could see a circling blue light with Aoko Aozaki in the middle of it."
msgstr "　地上にはぐるんぐるん回転している青い光と、その中心にいる蒼崎青子。"

#. Occurrence 5B_15:1980:6371: scene=5B_15
#: 5B_15:1980
msgctxt "text_id=6371 | speaker=unknown"
msgid "  ...And one more thing."
msgstr "　……そしてもう一つ。"

#. Occurrence 5B_15:1985:6372: scene=5B_15
#: 5B_15:1985
msgctxt "text_id=6372 | speaker=unknown"
msgid "  From an angle that only Soujyuro could see, a shadow stalked Aoko while she challenged the moon."
msgstr "　この位置にいる草十郎にしか知り得ないヒト影が、月に挑む青子へと迫っていた。"

#. Occurrence 5B_15:2048:6373: scene=5B_15
#: 5B_15:2048
msgctxt "text_id=6373 | speaker=unknown"
msgid "  It was shaped like a person missing the lower half of its body."
msgstr "　その影には下半身がない。"

#. Occurrence 5B_15:2053:6374: scene=5B_15
#: 5B_15:2053
msgctxt "text_id=6374 | speaker=unknown"
msgid "  The disembodied torso slowly clawed its way toward Aoko."
msgstr "　上半身だけの体で、ずるずると青子に近づいている。"

#. Occurrence 5B_15:2058:6375: scene=5B_15
#: 5B_15:2058
msgctxt "text_id=6375 | speaker=unknown"
msgid "  They were still over six hundred feet apart."
msgstr "　距離的にはあと二百メートルほど。"

#. Occurrence 5B_15:2063:6376: scene=5B_15
#: 5B_15:2063
msgctxt "text_id=6376 | speaker=unknown"
msgid "  Unfortunately for Aoko, she completely failed to notice it approaching from behind."
msgstr "　不運な事に、青子の背後から<這|・><っ|・><て|・><き|・><て|・>いるため、彼女はその影に気付けない。"

#. Occurrence 5B_15:2087:6377: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0003; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:2087
msgctxt "text_id=6377 | speaker=soujuurou"
msgid "\"It's too far away to make out, but...isn't that...\""
msgstr "「―――遠くて見えないけど、アレは―――」"

#. Occurrence 5B_15:2100:6378: scene=5B_15
#: 5B_15:2100
msgctxt "text_id=6378 | speaker=unknown"
msgid "  He was sure of what it was now."
msgstr "　間違いない。"

#. Occurrence 5B_15:2105:6379: scene=5B_15
#: 5B_15:2105
msgctxt "text_id=6379 | speaker=unknown"
msgid "  There was only one thing in the park that would chase Aoko and not him: the puppet."
msgstr "　この遊園地において、草十郎ではなく青子を狙うのは<あ|・><の|・><人|・><形|・>だけなのだから。"

#. Occurrence 5B_15:2161:6380: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0004; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:2161
msgctxt "text_id=6380 | speaker=soujuurou"
msgid "\"But... I mean, maybe it's..."
msgstr "「いや、でも。ほら、あるいは、ひょっとして―――"

#. Occurrence 5B_15:2161:6381: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0004; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:2161
msgctxt "text_id=6381 | speaker=soujuurou"
msgid "  ...a coincidence, right?\""
msgstr "　ただの偶然、ではないだろうか」"

#. Occurrence 5B_15:2178:6382: scene=5B_15
#: 5B_15:2178
msgctxt "text_id=6382 | speaker=unknown"
msgid "  His mind ran in circles."
msgstr "　幾重にも交錯し、混乱する思考。"

#. Occurrence 5B_15:2183:6383: scene=5B_15
#: 5B_15:2183
msgctxt "text_id=6383 | speaker=unknown"
msgid "  It was a perfectly reasonable reaction."
msgstr "　それも無理からぬ事だろう。"

#. Occurrence 5B_15:2188:6384: scene=5B_15
#: 5B_15:2188
msgctxt "text_id=6384 | speaker=unknown"
msgid "  Any grip on reality he might have had left was long lost when Aoko started firing beams of light at the monstrous moon."
msgstr "　膨張した月と<光弾|ビーム>を撃ちまくってる少女、という状況だけで、草十郎的には目を疑う状況なのだ。"

#. Occurrence 5B_15:2470:6385: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0005; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:2470
msgctxt "text_id=6385 | speaker=soujuurou"
msgid "\"Whoa!\""
msgstr "「うわぁ……！」"

#. Occurrence 5B_15:2476:6386: scene=5B_15
#: 5B_15:2476
msgctxt "text_id=6386 | speaker=unknown"
msgid "  Aoko's merciless fire buffeted the roller coaster like a storm."
msgstr "　青子の容赦のない超距離魔弾は、嵐のようにコースターを揺さぶっていく。"

#. Occurrence 5B_15:2481:6387: scene=5B_15
#: 5B_15:2481
msgctxt "text_id=6387 | speaker=unknown"
msgid "  Just standing on it was almost enough for him to be thrown off and killed."
msgstr "　立っているだけで振り落とされ、転落死しかねない。"

#. Occurrence 5B_15:2607:6388: scene=5B_15
#: 5B_15:2607
msgctxt "text_id=6388 | speaker=unknown"
msgid "  At any rate, Soujyuro couldn't fathom the situation."
msgstr "　とにかく、この状況は草十郎には難しすぎる。"

#. Occurrence 5B_15:2612:6389: scene=5B_15
#: 5B_15:2612
msgctxt "text_id=6389 | speaker=unknown"
msgid "  Should he head back to the entrance of the roller coaster and warn Aoko about the incoming threat?"
msgstr "　ここからコースターの入り口まで戻って青子に注意を<促|うなが>しに行くか？"

#. Occurrence 5B_15:2618:6390: scene=5B_15
#: 5B_15:2618
msgctxt "text_id=6390 | speaker=unknown"
msgid "  No, there was no way he would make it in time, and to make matters worse, there was a horde of bread down there, waiting for him."
msgstr "　いや、間に合うハズもなし、駆け下りたところで入り口には大量の焼きたてパンがいる。"

#. Occurrence 5B_15:2623:6391: scene=5B_15
#: 5B_15:2623
msgctxt "text_id=6391 | speaker=unknown"
msgid "  And it may very well have been the case that Aoko was already aware of the puppet and would take it out as soon as it got closer. If she was, Soujyuro was sure he would only be in the way."
msgstr "　そもそも青子は人形に気付いていて、近づいたとたん一撃で倒す可能性もある。その場合、自慢じゃないが足を引っ張る自信すらある草十郎だった。"

#. Occurrence 5B_15:2884:6392: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0006; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:2884
msgctxt "text_id=6392 | speaker=soujuurou"
msgid "\"But...\""
msgstr "「っ………………」"

#. Occurrence 5B_15:2890:6393: scene=5B_15
#: 5B_15:2890
msgctxt "text_id=6393 | speaker=unknown"
msgid "  It did not seem like there was anything he could do to help."
msgstr "　何を選んでも役に立てそうにない状況。"

#. Occurrence 5B_15:2895:6394: scene=5B_15
#: 5B_15:2895
msgctxt "text_id=6394 | speaker=unknown"
msgid "  And beyond that, Aoko was not the only one in danger. He was in quite a predicament himself."
msgstr "　第一、危険なのは青子だけでなく、草十郎も窮地に立っている。"

#. Occurrence 5B_15:2931:6395: scene=5B_15
#: 5B_15:2931
msgctxt "text_id=6395 | speaker=unknown"
msgid "\"You can't go home again.\""
msgstr "『行きは良い良い帰りは怖い』"

#. Occurrence 5B_15:2986:6396: scene=5B_15
#: 5B_15:2986
msgctxt "text_id=6396 | speaker=unknown"
msgid "  The road home was never as safe as one thought. It was as true here as it had been in the mountains."
msgstr "　帰り道に鬼が待っているのは都会であろうと山奥であろうと同じこと。"

#. Occurrence 5B_15:2991:6397: scene=5B_15
#: 5B_15:2991
msgctxt "text_id=6397 | speaker=unknown"
msgid "  The path he was on was no exception. As risky as the ascent had been, it was even more dangerous to go back down."
msgstr "　この道は特に顕著だ。行きはもちろん、帰り道も危険すぎる。"

#. Occurrence 5B_15:2997:6398: scene=5B_15
#: 5B_15:2997
msgctxt "text_id=6398 | speaker=unknown"
msgid "This was no time to be worrying about others."
msgstr "<他|ひ><人|と>の事を心配する余裕はどこにもない。"

#. Occurrence 5B_15:3002:6399: scene=5B_15
#: 5B_15:3002
msgctxt "text_id=6399 | speaker=unknown"
msgid "  His shaking legs reminded him that only two hundred feet separated him from death."
msgstr "　地上六十メートルの死の淵にいる事を忘れるな、と草十郎は震える足に言い聞かせる。"

#. Occurrence 5B_15:3023:6400: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0007; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:3023
msgctxt "text_id=6400 | speaker=soujuurou"
msgid "(I'll be fine. I know that. Just...)"
msgstr "“……大丈夫、それは分かっている。けど―――”"

#. Occurrence 5B_15:3028:6401: scene=5B_15
#: 5B_15:3028
msgctxt "text_id=6401 | speaker=unknown"
msgid "  His head was pounding."
msgstr "　キリキリと頭が痛む。"

#. Occurrence 5B_15:3033:6402: scene=5B_15
#: 5B_15:3033
msgctxt "text_id=6402 | speaker=unknown"
msgid "  This was reckless and stupid."
msgstr "　無謀である事も、馬鹿げた事なのも分かっている。"

#. Occurrence 5B_15:3039:6403: scene=5B_15
#: 5B_15:3039
msgctxt "text_id=6403 | speaker=unknown"
msgid "Having been raised in the mountains, he was more sensitive to danger than anyone raised in the city, and just thinking about what he was about to do made his throat seize up."
msgstr "山奥育ちの彼は、都会の誰よりも危険に関して敏感で、これからするコトを考えるだけで緊張で喉が嗄れきってしまう。"

#. Occurrence 5B_15:3044:6404: scene=5B_15
#: 5B_15:3044
msgctxt "text_id=6404 | speaker=unknown"
msgid "  There was only one thing he could say for sure."
msgstr "　が、そんな草十郎でもはっきりと言えることは、"

#. Occurrence 5B_15:3054:6405: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0008; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:3054
msgctxt "text_id=6405 | speaker=soujuurou"
msgid "\"Aozaki has no idea that thing is coming for her!\""
msgstr "「蒼崎のことだ、アレにぜったい気付いていない……！」"

#. Occurrence 5B_15:3186:6406: scene=5B_15
#: 5B_15:3186
msgctxt "text_id=6406 | speaker=unknown"
msgid "  With a sobbing shout, Soujyuro started making his way down the two-hundred-foot frame of the roller coaster."
msgstr "　<半|なか>ば泣くような声をあげて、草十郎は高さ六十メートルの鉄骨を駆け下りだした。"

#. Occurrence 5B_15:3290:6407: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0009; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:3290
msgctxt "text_id=6407 | speaker=soujuurou"
msgid "\"Hah... hah... hah... haaa!\""
msgstr "「はっ、はっ、はぁ、はっ―――！」"

#. Occurrence 5B_15:3296:6408: scene=5B_15
#: 5B_15:3296
msgctxt "text_id=6408 | speaker=unknown"
msgid "  His race toward death accelerated."
msgstr "　死の道行きを加速する。"

#. Occurrence 5B_15:3301:6409: scene=5B_15
#: 5B_15:3301
msgctxt "text_id=6409 | speaker=unknown"
msgid "  He never meant to speed up, but the downward slope propelled him forward."
msgstr "　加速するつもりはなくとも、下り坂である以上スピードは増していく。"

#. Occurrence 5B_15:3436:6410: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0010; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:3436
msgctxt "text_id=6410 | speaker=soujuurou"
msgid "\"Here... I... go!\""
msgstr "「っ、この、はっ、よっと―――！」"

#. Occurrence 5B_15:3442:6411: scene=5B_15
#: 5B_15:3442
msgctxt "text_id=6411 | speaker=unknown"
msgid "  It was too late for regrets. Now that he was running, he had no choice but to go even faster."
msgstr "　が、後悔はもう遅い。走りだしたのならもっと早く。"

#. Occurrence 5B_15:3448:6412: scene=5B_15
#: 5B_15:3448
msgctxt "text_id=6412 | speaker=unknown"
msgid "And time was not on his side―he would never make it in time if he took the long way down, never mind the bread-men crowding the exit of the roller coaster."
msgstr "なにしろホントに時間がない、今から全力で下りても間に合わない、ああでもそれより、コースターの出口にはブレッドマンたちで混雑中、"

#. Occurrence 5B_15:3454:6413: scene=5B_15
#: 5B_15:3454
msgctxt "text_id=6413 | speaker=unknown"
msgid "With the exits blocked, the outcome would be the same whether he went slowly or quickly. There was no reason to rush to his death as desperately as he did!"
msgstr "となれば遅いも早いも結果は同じ、どのみち出口が塞がっている。急げ急げと必死になって、一歩ごとに落ちかける必要性とかまったくない……！"

#. Occurrence 5B_15:3562:6414: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0011; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:3562
msgctxt "text_id=6414 | speaker=soujuurou"
msgid "\"So what!?\""
msgstr "「っ、だから！？」"

#. Occurrence 5B_15:3568:6415: scene=5B_15
#: 5B_15:3568
msgctxt "text_id=6415 | speaker=unknown"
msgid "  So what if it was futile?"
msgstr "　それがどうしたと。"

#. Occurrence 5B_15:3573:6416: scene=5B_15
#: 5B_15:3573
msgctxt "text_id=6416 | speaker=unknown"
msgid "  Soujyuro cleared the doubts from his mind."
msgstr "　ごちゃついた<煩悶|はんもん>を、彼は一太刀で切り払った。"

#. Occurrence 5B_15:3578:6417: scene=5B_15
#: 5B_15:3578
msgctxt "text_id=6417 | speaker=unknown"
msgid "  He turned his attention to what he could do: keep his footing and try to arrive at the bottom as quickly as he could."
msgstr "　自分にできる事は足下に意識を集中して、一秒でも早く駆け下りるだけ。"

#. Occurrence 5B_15:3720:6418: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0012; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:3720
msgctxt "text_id=6418 | speaker=soujuurou"
msgid "(Focus! Forget whether you'll be there in time to save her! The most important thing is...)"
msgstr "“間違えるな。いま大事なのは、間に合うとか助けられるとか、そういう結果の話じゃなくて―――”"

#. Occurrence 5B_15:3726:6419: scene=5B_15
#: 5B_15:3726
msgctxt "text_id=6419 | speaker=unknown"
msgid "  He had no idea what impulses were driving his stiff limbs."
msgstr "　ある衝動が、縮こまった手足を駆動させる。"

#. Occurrence 5B_15:3731:6420: scene=5B_15
#: 5B_15:3731
msgctxt "text_id=6420 | speaker=unknown"
msgid "  He just focused on the moment, pushing past the fear and the cold logic."
msgstr "　渇ききった喉を、冷め切った<理屈|こころ>を、草十郎は“思いつき”だけで心の端っこに蹴り飛ばす。"

#. Occurrence 5B_15:3736:6421: scene=5B_15
#: 5B_15:3736
msgctxt "text_id=6421 | speaker=unknown"
msgid "  At his core, he was the kind of person to deal with problems head-on. There would be time to think about the consequences later!"
msgstr "　根が単純な人間の面目躍如、とにかく難しいコトは終わってから考える―――！"

#. Occurrence 5B_15:3889:6422: scene=5B_15
#: 5B_15:3889
msgctxt "text_id=6422 | speaker=unknown"
msgid "  But hesitation was not his only obstacle."
msgstr "　だが、障害は縮こまる自分だけではない。"

#. Occurrence 5B_15:3895:6423: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0013; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:3895
msgctxt "text_id=6423 | speaker=soujuurou"
msgid "\"Not now!\""
msgstr "「こんな時に―――！」"

#. Occurrence 5B_15:3900:6424: scene=5B_15
#: 5B_15:3900
msgctxt "text_id=6424 | speaker=unknown"
msgid "  The worst possible hindrance appeared at a time when not focusing on the track would mean certain death."
msgstr "　レールに集中していなければ落ちる状況で、最悪の邪魔者が出現する。"

#. Occurrence 5B_15:3998:6425: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0014; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:3998
msgctxt "text_id=6425 | speaker=soujuurou"
msgid "\"!\""
msgstr "「！」"

#. Occurrence 5B_15:4003:6426: scene=5B_15
#: 5B_15:4003
msgctxt "text_id=6426 | speaker=unknown"
msgid "  Soujyuro sensed something wrong with the egg he had been so studiously observing out of one eye."
msgstr "　一見いままで通りの卵に違和感を覚える草十郎。"

#. Occurrence 5B_15:4008:6427: scene=5B_15
#: 5B_15:4008
msgctxt "text_id=6427 | speaker=unknown"
msgid "  Something had changed."
msgstr "　何が変わっているのか。"

#. Occurrence 5B_15:4013:6428: scene=5B_15
#: 5B_15:4013
msgctxt "text_id=6428 | speaker=unknown"
msgid "  And at the very moment he realized it..."
msgstr "　その変化に気付いた瞬間、"

#. Occurrence 5B_15:4103:6429: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0015; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:4103
msgctxt "text_id=6429 | speaker=soujuurou"
msgid "\"I can't be looking to the side right now!\""
msgstr "「って、よそ見してる場合じゃない……！」"

#. Occurrence 5B_15:4123:6430: scene=5B_15
#: 5B_15:4123
msgctxt "text_id=6430 | speaker=unknown"
msgid "  Soujyuro stumbled then instinctively caught himself."
msgstr "　踏み<外|はず>しかけた足を本能で持ち直す。"

#. Occurrence 5B_15:4128:6431: scene=5B_15
#: 5B_15:4128
msgctxt "text_id=6431 | speaker=unknown"
msgid "  It was a miracle he had not fallen."
msgstr "　まだ落ちていない事が奇跡だった。"

#. Occurrence 5B_15:4133:6432: scene=5B_15
#: 5B_15:4133
msgctxt "text_id=6432 | speaker=unknown"
msgid "  Descending a roller coaster on foot was an act of suicide."
msgstr "　コースターを駆け下りるのは自殺行為そのものだった。"

#. Occurrence 5B_15:4201:6433: scene=5B_15
#: 5B_15:4201
msgctxt "text_id=6433 | speaker=unknown"
msgid "  The egg stayed right by his side―so close it was likely it would collide with him."
msgstr "　卵はぴったりと並走し、隙あらば体当たりでもしてきそうな<剣呑|けんのん>さ。"

#. Occurrence 5B_15:4207:6434: scene=5B_15
#: 5B_15:4207
msgctxt "text_id=6434 | speaker=unknown"
msgid "Though he was trying not to look at it, he could not help but feel uneasy that the door-like decoration in its center was gradually opening."
msgstr "オマケにあまり直視したくないが、内部に作られた扉らしき飾りが、少しずつ開こうとしているのも気になりすぎる。"

#. Occurrence 5B_15:4320:6435: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0016; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:4320
msgctxt "text_id=6435 | speaker=soujuurou"
msgid "\"Dammit! Why now!?\""
msgstr "「ああもう、畜生！　なんだって、こんな―――！」"

#. Occurrence 5B_15:4326:6436: scene=5B_15
#: 5B_15:4326
msgctxt "text_id=6436 | speaker=unknown"
msgid "  He cursed his rotten situation."
msgstr "　あまりにもどん詰まりな状況に悪態をつく。"

#. Occurrence 5B_15:4331:6437: scene=5B_15
#: 5B_15:4331
msgctxt "text_id=6437 | speaker=unknown"
msgid "  And yet, he refused to slow down."
msgstr "　それでも足は緩めない。"

#. Occurrence 5B_15:4337:6438: scene=5B_15
#: 5B_15:4337
msgctxt "text_id=6438 | speaker=unknown"
msgid "He ran even faster, glaring at the egg on his side."
msgstr "むしろ速度をより増して、彼は並走する卵を睨みつける。"

#. Occurrence 5B_15:4465:6439: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0017; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:4465
msgctxt "text_id=6439 | speaker=soujuurou"
msgid "\"Hah... This is crazy."
msgstr "「ハ―――ほんと、おかしい。"

#. Occurrence 5B_15:4471:6440: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0018; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:4471
msgctxt "text_id=6440 | speaker=soujuurou"
msgid "  What's wrong with me?\""
msgstr "　こんな状況なのに、何で―――」"

#. Occurrence 5B_15:4477:6441: scene=5B_15
#: 5B_15:4477
msgctxt "text_id=6441 | speaker=unknown"
msgid "  Soujyuro was baffled to find that he was smiling."
msgstr "　自分は笑っているのだろう、と草十郎は不思議に思った。"

#. Occurrence 5B_15:4482:6442: scene=5B_15
#: 5B_15:4482
msgctxt "text_id=6442 | speaker=unknown"
msgid "  Perhaps it had something to do with Aoko's charm. Soujyuro could not tell one way or the other."
msgstr "　青子のおまじないとやらの効果……なのかどうか、草十郎には判別できない。"

#. Occurrence 5B_15:4527:6443: scene=5B_15
#: 5B_15:4527
msgctxt "text_id=6443 | speaker=unknown"
msgid "  He could still feel Aoko's fingers on his skin."
msgstr "　彼女の指の感触は、まだ肌に残っている。"

#. Occurrence 5B_15:4569:6444: scene=5B_15
#: 5B_15:4569
msgctxt "text_id=6444 | speaker=unknown"
msgid "  The trust and expectation she had placed in him was etched into his heart."
msgstr "　向けられた信頼も期待も、しっかりと胸に<覚|おぼ>えている。"

#. Occurrence 5B_15:4574:6445: scene=5B_15
#: 5B_15:4574
msgctxt "text_id=6445 | speaker=unknown"
msgid "  But what spurred him on was something entirely different."
msgstr "　……けれど、この衝動はそれらとは違うものだ。"

#. Occurrence 5B_15:4662:6446: scene=5B_15
#: 5B_15:4662
msgctxt "text_id=6446 | speaker=unknown"
msgid "  This all stemmed from a much deeper problem."
msgstr "　この高揚は、もっと深層にある問題。"

#. Occurrence 5B_15:4667:6447: scene=5B_15
#: 5B_15:4667
msgctxt "text_id=6447 | speaker=unknown"
msgid "  It was something inside him that he could not understand at the time, but would eventually come to terms with one day."
msgstr "　今の彼には分からない、いずれ向き合う事になる、埋められるべきがらんどう。"

#. Occurrence 5B_15:4715:6448: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0019; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:4715
msgctxt "text_id=6448 | speaker=soujuurou"
msgid "\"All right, less than five feet left!\""
msgstr "「よし―――距離は、今なら二メートル、弱……！」"

#. Occurrence 5B_15:4770:6449: scene=5B_15
#: 5B_15:4770
msgctxt "text_id=6449 | speaker=unknown"
msgid "  He carefully judged the distance as he ran down the track of death."
msgstr "　死のレールを走りながら、草十郎は正確に距離を<測|はか>る。"

#. Occurrence 5B_15:4775:6450: scene=5B_15
#: 5B_15:4775
msgctxt "text_id=6450 | speaker=unknown"
msgid "  But the distance between what?"
msgstr "　何との？"

#. Occurrence 5B_15:4780:6451: scene=5B_15
#: 5B_15:4780
msgctxt "text_id=6451 | speaker=unknown"
msgid "  That went without saying. It was the distance between himself and the one thing that could save his life."
msgstr "　言うまでもない。この状況でたったひとつ、死の結末を飛び越える大一番との。"

#. Occurrence 5B_15:4877:6452: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0020; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:4877
msgctxt "text_id=6452 | speaker=soujuurou"
msgid "\"Hah... Hah! Haha! Hah...!\""
msgstr "「はっ―――はっ、はっは、はっ！」"

#. Occurrence 5B_15:4883:6453: scene=5B_15
#: 5B_15:4883
msgctxt "text_id=6453 | speaker=unknown"
msgid "  He told himself he was going to do it, over and over, like a mantra."
msgstr "　乱れる呼吸に合わせて、“行くぞ、行くぞ”とハッパをかける。"

#. Occurrence 5B_15:4890:6454: scene=5B_15
#: 5B_15:4890
msgctxt "text_id=6454 | speaker=unknown"
msgid "  Soujyuro could not believe himself."
msgstr "　本当にありえない。"

#. Occurrence 5B_15:4895:6455: scene=5B_15
#: 5B_15:4895
msgctxt "text_id=6455 | speaker=unknown"
msgid "  What he was about to do was incredibly stupid."
msgstr "　自分は馬鹿げた事をしようとしている。"

#. Occurrence 5B_15:4900:6456: scene=5B_15
#: 5B_15:4900
msgctxt "text_id=6456 | speaker=unknown"
msgid "  But what is stupid when smart is not an option?"
msgstr "　でも<そ|・><う|・><し|・><な|・><け|・><れ|・><ば|・><間|・><に|・><合|・><わ|・><な|・><い|・>、と気付いたのだからしようがない！"

#. Occurrence 5B_15:5004:6457: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0021; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:5004
msgctxt "text_id=6457 | speaker=soujuurou"
msgid "\"I'm really going to do this!? This is insane!\""
msgstr "「ほんと―――なんで、そこまでやるんだ！？」"

#. Occurrence 5B_15:5010:6458: scene=5B_15
#: 5B_15:5010
msgctxt "text_id=6458 | speaker=unknown"
msgid "  Amidst it all, he laughed at how pointless such self-reflection was now."
msgstr "　今さらな自問自答を、彼は鼻で笑った。"

#. Occurrence 5B_15:5015:6459: scene=5B_15
#: 5B_15:5015
msgctxt "text_id=6459 | speaker=unknown"
msgid "  Temporary confusion, a psychological thrill ride; both had laid his soul bare."
msgstr "　一時的な混乱。極限状態における精神の高揚が、彼の心を裸にする。"

#. Occurrence 5B_15:5114:6460: scene=5B_15
#: 5B_15:5114
msgctxt "text_id=6460 | speaker=unknown"
msgid "  What really mattered in life?"
msgstr "　大事なものは何なのか。"

#. Occurrence 5B_15:5119:6461: scene=5B_15
#: 5B_15:5119
msgctxt "text_id=6461 | speaker=unknown"
msgid "  The answer to that question was simple."
msgstr "　そんなもの、シンプルな彼には考えるまでもない。"

#. Occurrence 5B_15:5124:6462: scene=5B_15
#: 5B_15:5124
msgctxt "text_id=6462 | speaker=unknown"
msgid "  His primitive values did not crave success or reward."
msgstr "　成功も報酬も、原始の心には美味しそうには映らない。"

#. Occurrence 5B_15:5129:6463: scene=5B_15
#: 5B_15:5129
msgctxt "text_id=6463 | speaker=unknown"
msgid "  All he wanted was..."
msgstr "　彼は、ただ、"

#. Occurrence 5B_15:5174:6464: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0022; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:5174
msgctxt "text_id=6464 | speaker=soujuurou"
msgid "(This is it!)"
msgstr "“よし―――”"

#. Occurrence 5B_15:5180:6465: scene=5B_15
#: 5B_15:5180
msgctxt "text_id=6465 | speaker=unknown"
msgid "  ...to live the way he wanted."
msgstr "　これはただ、そうありたいと望んだだけの話。"

#. Occurrence 5B_15:5185:6466: scene=5B_15
#: 5B_15:5185
msgctxt "text_id=6466 | speaker=unknown"
msgid "  It wasn't an obligation to the people around him."
msgstr "　周りから強制された義務ではなく。"

#. Occurrence 5B_15:5190:6467: scene=5B_15
#: 5B_15:5190
msgctxt "text_id=6467 | speaker=unknown"
msgid "  His desire to live his way was his and his alone."
msgstr "　ただ純粋に、そういう風に生きたいと信じた、愚直な自己の欲望そのもので―――"

#. Occurrence 5B_15:5213:6468: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0023; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:5213
msgctxt "text_id=6468 | speaker=soujuurou"
msgid "(Here we go!)"
msgstr "“行こう！”"

#. Occurrence 5B_15:5272:6469: scene=5B_15
#: 5B_15:5272
msgctxt "text_id=6469 | speaker=unknown"
msgid "\"!?\""
msgstr "『！？』"

#. Occurrence 5B_15:5278:6470: scene=5B_15
#: 5B_15:5278
msgctxt "text_id=6470 | speaker=unknown"
msgid "  If the egg had been equipped with a vocal function, it would have gasped in shock at what happened next."
msgstr "　卵に発声機能があったのなら、そう驚いたに違いない。"

#. Occurrence 5B_15:5283:6471: scene=5B_15
#: 5B_15:5283
msgctxt "text_id=6471 | speaker=unknown"
msgid "  The boy, who had only tried to escape up until this point, suddenly shifted his weight."
msgstr "　逃げるだけだった少年は、自分から大きく足を踏み外したのだ。"

#. Occurrence 5B_15:5363:6472: scene=5B_15
#: 5B_15:5363
msgctxt "text_id=6472 | speaker=unknown"
msgid "  He pointed his feet outward instead of inward."
msgstr "　足は内ではなく、外に向かって。"

#. Occurrence 5B_15:5368:6473: scene=5B_15
#: 5B_15:5368
msgctxt "text_id=6473 | speaker=unknown"
msgid "  On the edge of one rail, he crouched ever so slightly to maintain momentum, and gazed at the floating egg."
msgstr "　レールの端で、勢いを殺さないようわずかに膝を曲げ、浮遊する卵を凝視し―――"

#. Occurrence 5B_15:5442:6474: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0024; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:5442
msgctxt "text_id=6474 | speaker=soujuurou"
msgid "(Close enough! I can do this!)"
msgstr "“やれる―――距離的に問題はない！”"

#. Occurrence 5B_15:5626:6475: scene=5B_15
#: 5B_15:5626
msgctxt "text_id=6475 | speaker=unknown"
msgid "  He soared through the night sky."
msgstr "　夜を駆ける。"

#. Occurrence 5B_15:5631:6476: scene=5B_15
#: 5B_15:5631
msgctxt "text_id=6476 | speaker=unknown"
msgid "  It was a flight that lasted a mere one and a half seconds―"
msgstr "　わずか１．５秒の夜間飛行。"

#. Occurrence 5B_15:5636:6477: scene=5B_15
#: 5B_15:5636
msgctxt "text_id=6477 | speaker=unknown"
msgid "  a cordless bungee jump from a hundred feet above ground."
msgstr "　地上三十メートルの、<紐|ひも>なし<縄|なわ>なしバンジージャンプ。"

#. Occurrence 5B_15:5641:6478: scene=5B_15
#: 5B_15:5641
msgctxt "text_id=6478 | speaker=unknown"
msgid "  His destination:"
msgstr "　その落下先は―――"

#. Occurrence 5B_15:5725:6479: scene=5B_15
#: 5B_15:5725
msgctxt "text_id=6479 | speaker=unknown"
msgid "  the only thing that would stop his fall―the giant flying egg."
msgstr "　唯一の足場となる、空飛ぶ巨大な卵だった。"

#. Occurrence 5B_15:5841:6480: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0025; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:5841
msgctxt "text_id=6480 | speaker=soujuurou"
msgid "\"Hyaaah!\""
msgstr "「う、ひゃああーーーー！」"

#. Occurrence 5B_15:5847:6481: scene=5B_15
#: 5B_15:5847
msgctxt "text_id=6481 | speaker=unknown"
msgid "  He shrieked, this time out of elation, as he desperately clung to the egg's surface."
msgstr "　悲鳴のような、歓声のような声をあげながら、草十郎は必死に卵の表面にしがみつく。"

#. Occurrence 5B_15:5867:6482: scene=5B_15
#: 5B_15:5867
msgctxt "text_id=6482 | speaker=unknown"
msgid "  Just earlier..."
msgstr "　……ほんの少し前。"

#. Occurrence 5B_15:5874:6483: scene=5B_15
#: 5B_15:5874
msgctxt "text_id=6483 | speaker=unknown"
msgid "  The cold-blooded witch had told him that without fear, the top of a building would feel no different than a balance beam."
msgstr "　恐怖心が無ければビルの上も平均台も変わらない、と血も涙もない魔女は言った。"

#. Occurrence 5B_15:5879:6484: scene=5B_15
#: 5B_15:5879
msgctxt "text_id=6484 | speaker=unknown"
msgid "  This from the same witch that would have been left speechless had she witnessed this spectacle."
msgstr "　その魔女とて、この光景を見たら言葉を失っただろう。"

#. Occurrence 5B_15:5884:6485: scene=5B_15
#: 5B_15:5884
msgctxt "text_id=6485 | speaker=unknown"
msgid "  It was one thing to be fearless, and another to be reckless."
msgstr "　いくら恐怖心が無いと言っても、無茶と無謀は別の物だ。"

#. Occurrence 5B_15:5889:6486: scene=5B_15
#: 5B_15:5889
msgctxt "text_id=6486 | speaker=unknown"
msgid "  What the boy did next would give her a headache in the days to come."
msgstr "　あまつさえ、<こ|・><の|・><後|・>の行為に至っては、後日本気で頭にきた程である。"

#. Occurrence 5B_15:5957:6487: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0026; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:5957
msgctxt "text_id=6487 | speaker=soujuurou"
msgid "\"I'm counting on you, egg!\""
msgstr "「頼むぞ、卵！」"

#. Occurrence 5B_15:5966:6488: scene=5B_15
#: 5B_15:5966
msgctxt "text_id=6488 | speaker=unknown"
msgid "  Clinging to the egg, he shifted his gaze away from it."
msgstr "　卵にしがみついたまま、<卵|・><か|・><ら|・><視|・><線|・><を|・><切|・><る|・>。"

#. Occurrence 5B_15:5971:6489: scene=5B_15
#: 5B_15:5971
msgctxt "text_id=6489 | speaker=unknown"
msgid "  He felt the rapid descent."
msgstr "　急速な落下感覚。"

#. Occurrence 5B_15:6052:6490: scene=5B_15
#: 5B_15:6052
msgctxt "text_id=6490 | speaker=unknown"
msgid "  Soujyuro, focusing his half-shut eyes on the ground, leaped off the egg once they were a few feet from the ground, then turned back to it, careful to reestablish eye contact."
msgstr "　草十郎は薄目で風景を確認しながら、残り一メートル付近で視線を戻し、卵を視界に<納|おさ>めながら飛びだした。"

#. Occurrence 5B_15:6118:6491: scene=5B_15
#: 5B_15:6118
msgctxt "text_id=6491 | speaker=unknown"
msgid "  Something so unbelievable, though to Soujyuro..."
msgstr "　―――いや、まことに信じがたい話ではあるが。"

#. Occurrence 5B_15:6124:6492: scene=5B_15
#: 5B_15:6124
msgctxt "text_id=6492 | speaker=unknown"
msgid "  The elevator at the department store"
msgstr "　彼にとってはデパートのエレベーターも、"

#. Occurrence 5B_15:6124:6493: scene=5B_15
#: 5B_15:6124
msgctxt "text_id=6493 | speaker=unknown"
msgid "  and the mysterious floating egg were both just moving objects,"
msgstr "　不思議動力で浮遊する卵も、"

#. Occurrence 5B_15:6124:6494: scene=5B_15
#: 5B_15:6124
msgctxt "text_id=6494 | speaker=unknown"
msgid "  virtually indistinguishable from one another."
msgstr "　そう大差のない「移動道具」に見えたのである……！"

#. Occurrence 5B_15:6240:6495: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0027; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:6240
msgctxt "text_id=6495 | speaker=soujuurou"
msgid "\"All right! It didn't break!"
msgstr "「よし、割れてない！"

#. Occurrence 5B_15:6240:6496: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0027; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:6240
msgctxt "text_id=6496 | speaker=soujuurou"
msgid "It's always a shame when food goes to waste!\""
msgstr "食べ物を粗末にするのはよくないと思う！」"

#. Occurrence 5B_15:6406:6497: scene=5B_15
#: 5B_15:6406
msgctxt "text_id=6497 | speaker=unknown"
msgid "  He landed near the plaza."
msgstr "　着地したのは小広場の近く。"

#. Occurrence 5B_15:6411:6498: scene=5B_15
#: 5B_15:6411
msgctxt "text_id=6498 | speaker=unknown"
msgid "  The shortcut that almost cost him his life had paid off."
msgstr "　命を投げたショートカットは、これ以上ないカタチで実を結んだ。"

#. Occurrence 5B_15:6488:6499: scene=5B_15
#: 5B_15:6488
msgctxt "text_id=6499 | speaker=unknown"
msgid "  Soujyuro took off running the second his feet touched the ground."
msgstr "　草十郎は着地しながら、止まる事なく走りだす。"

#. Occurrence 5B_15:6581:6500: scene=5B_15
#: 5B_15:6581
msgctxt "text_id=6500 | speaker=unknown"
msgid "  The puppet after Aoko was the only thing on his mind."
msgstr "　彼の脳裏にあるのは青子に迫る人形の姿だけ。"

#. Occurrence 5B_15:6608:6501: scene=5B_15
#: 5B_15:6608
msgctxt "text_id=6501 | speaker=unknown"
msgid "  He paid no mind to the moonlight in the sky,"
msgstr "　なので、空から降ってくる月の光も、"

#. Occurrence 5B_15:6706:6502: scene=5B_15
#: 5B_15:6706
msgctxt "text_id=6502 | speaker=unknown"
msgid "  nor to the egg which was furious about being used, and seconds away from self-destructing and blasting fragments all over the place."
msgstr "　利用された怒りに燃えて自ら破裂し、破片をまき散らさんとする卵も視界に映らない。"

#. Occurrence 5B_15:6777:6503: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0028; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:6777
msgctxt "text_id=6503 | speaker=soujuurou"
msgid "\"Aozaki!\""
msgstr "「蒼崎―――！」"

#. Occurrence 5B_15:6834:6504: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_15_0007; voice_prefix=A10; voice_category=1; scene=5B_15
#: 5B_15:6834
msgctxt "text_id=6504 | speaker=aoko"
msgid "\"Huh?\""
msgstr "「なぬ―――？」"

#. Occurrence 5B_15:6840:6505: scene=5B_15
#: 5B_15:6840
msgctxt "text_id=6505 | speaker=unknown"
msgid "  Aoko's dumbfounded expression spurred Soujyuro on."
msgstr "　目を疑う青子の表情が、最後の一足に力を入れる。"

#. Occurrence 5B_15:6940:6506: scene=5B_15
#: 5B_15:6940
msgctxt "text_id=6506 | speaker=unknown"
msgid "  The curse was complete."
msgstr "　<詩篇|のろい>が展開する。"

#. Occurrence 5B_15:6945:6507: scene=5B_15
#: 5B_15:6945
msgctxt "text_id=6507 | speaker=unknown"
msgid "  The empty egg began to sing its warning to let them know there was no escape."
msgstr "　もはや逃がさぬと中身のない卵は<謳|うた>い―――"

#. Occurrence 5B_15:7192:6508: scene=5B_15
#: 5B_15:7192
msgctxt "text_id=6508 | speaker=unknown"
msgid "  Shrapnel from the egg exploded through the air."
msgstr "　カオスに散らかる卵の断片。"

#. Occurrence 5B_15:7197:6509: scene=5B_15
#: 5B_15:7197
msgctxt "text_id=6509 | speaker=unknown"
msgid "  The \"Ode to Queen Alice\" that Alice had engraved into Dumpty quickly robbed him of his senses."
msgstr "　ダンプティに刻まれた“女王アリスを讃える唄”は、急速に五感を奪っていく。"

#. Occurrence 5B_15:7218:6510: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0029; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:7218
msgctxt "text_id=6510 | speaker=soujuurou"
msgid "\"Okay... Was that it?\""
msgstr "「っ―――それは、それとして―――」"

#. Occurrence 5B_15:7224:6511: scene=5B_15
#: 5B_15:7224
msgctxt "text_id=6511 | speaker=unknown"
msgid "  He snapped back to the task at hand and ran to Aoko, still lying on the ground."
msgstr "　途切れていく感覚に<喝|かつ>を入れて、草十郎は横たわる青子に走り寄る。"

#. Occurrence 5B_15:7229:6512: scene=5B_15
#: 5B_15:7229
msgctxt "text_id=6512 | speaker=unknown"
msgid "  His legs moved as if they had a mind of their own,"
msgstr "　足は止まらない。"

#. Occurrence 5B_15:7235:6513: scene=5B_15
#: 5B_15:7235
msgctxt "text_id=6513 | speaker=unknown"
msgid " though he couldn't have stopped them anyway, since he could no longer feel them."
msgstr "そもそも感覚がないので自らの意志で止める事さえできず、"

#. Occurrence 5B_15:7351:6514: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0030; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:7351
msgctxt "text_id=6514 | speaker=soujuurou"
msgid "\"Don't you puppets ever give up!?\""
msgstr "「<人形|おまえ>、驚くほどしつこいぞ……！」"

#. Occurrence 5B_15:7860:6515: scene=5B_15
#: 5B_15:7860
msgctxt "text_id=6515 | speaker=unknown"
msgid "  The Scrambled Murder Case."
msgstr "　<交差点|スクランブル>の<爆発|マーダー><事故|ケース>。"

#. Occurrence 5B_15:7865:6516: scene=5B_15
#: 5B_15:7865
msgctxt "text_id=6516 | speaker=unknown"
msgid "  Piles of rubble became flowers of light blooming from the earth."
msgstr "　三者三様の残骸が、閃光弾となって地上に咲く。"

#. Occurrence 5B_15:7916:6517: scene=5B_15
#: 5B_15:7916
msgctxt "text_id=6517 | speaker=unknown"
msgid "  The final curtain drew closed, and the defeated left the battleground."
msgstr "　……敗者たちがこぞって潰しあった最終幕。"

#. Occurrence 5B_15:7921:6518: scene=5B_15
#: 5B_15:7921
msgctxt "text_id=6518 | speaker=unknown"
msgid "  Had Alice Kuonji seen it happen, she would have been beside herself. The two had escaped by a hair's breadth."
msgstr "　久遠寺有珠が見ていたら頭を抱えそうな結末から、ふたりは間一髪ではじき出された。"

#. Occurrence 5B_15:8049:6519: scene=5B_15
#: 5B_15:8049
msgctxt "text_id=6519 | speaker=unknown"
msgid "  The only person in a position to witness that rare mutual destruction was the girl who had been saved from it."
msgstr "　この、世にも<希|まれ>なつぶし合いを冷静に把握できたのは、助けられた少女だけ。"

#. Occurrence 5B_15:8054:6520: scene=5B_15
#: 5B_15:8054
msgctxt "text_id=6520 | speaker=unknown"
msgid "  The boy who had never stopped running paid it no mind."
msgstr "　走り続けた少年は背後の結末にあまり関心もなく、"

#. Occurrence 5B_15:8137:6521: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0031; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:8137
msgctxt "text_id=6521 | speaker=soujuurou"
msgid "\"Phew. I thought you were a goner.\""
msgstr "「はあ―――死ぬかと、思った」"

#. Occurrence 5B_15:8143:6522: scene=5B_15
#: 5B_15:8143
msgctxt "text_id=6522 | speaker=unknown"
msgid "  The safety of the girl in his arms meant infinitely more to him than the miraculous way in which he saved her."
msgstr "　自分のしでかした奇跡より、抱きかかえた少女の無事を確かめて、安堵の息を漏らしていた。"

#. Occurrence 5B_16:59:6523: scene=5B_16
#: 5B_16:59
msgctxt "text_id=6523 | speaker=unknown"
msgid "  ...The moon did not wait for dawn to set."
msgstr "　……かくして、夜明けを待たず月は落ちた。"

#. Occurrence 5B_16:65:6524: scene=5B_16
#: 5B_16:65
msgctxt "text_id=6524 | speaker=unknown"
msgid "  The ornamental texture of the fairy-tale kingdom faded away."
msgstr "　御伽の国の<装飾|テクスチャ>が溶けていく。"

#. Occurrence 5B_16:70:6525: scene=5B_16
#: 5B_16:70
msgctxt "text_id=6525 | speaker=unknown"
msgid "  All of the illusions returned to the way they were before,"
msgstr "　道に響いていた華やかな<旋律|コード>も、"

#. Occurrence 5B_16:75:6526: scene=5B_16
#: 5B_16:75
msgctxt "text_id=6526 | speaker=unknown"
msgid "  from the ostentatious chords reverberating through the streets,"
msgstr "　来客を歓迎する<人形|パペット>たちの姿も、"

#. Occurrence 5B_16:80:6527: scene=5B_16
#: 5B_16:80
msgctxt "text_id=6527 | speaker=unknown"
msgid "  to the puppets welcoming their guests."
msgstr "　すべて幻となって、本来のカタチに戻っていく。"

#. Occurrence 5B_16:155:6528: scene=5B_16
#: 5B_16:155
msgctxt "text_id=6528 | speaker=unknown"
msgid "  Peace and quiet reigned once more"
msgstr "　<密|ひそ>やかに、<静|しず>やかに。"

#. Occurrence 5B_16:160:6529: scene=5B_16
#: 5B_16:160
msgctxt "text_id=6529 | speaker=unknown"
msgid "  over a forgotten kingdom, never to be awakened again."
msgstr "　もう二度と目覚める事のない、忘却の国に沈んでいく。"

#. Occurrence 5B_16:238:6530: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0000; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:238
msgctxt "text_id=6530 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5B_16:244:6531: scene=5B_16
#: 5B_16:244
msgctxt "text_id=6531 | speaker=unknown"
msgid "  Out flickered the embers of a late-night dream..."
msgstr "　一夜の夢の名残火。"

#. Occurrence 5B_16:249:6532: scene=5B_16
#: 5B_16:249
msgctxt "text_id=6532 | speaker=unknown"
msgid "  ...even the electric lamps that illuminated the park."
msgstr "　遊園地を照らす数多の<電飾|ライト>も、ひとつずつ消えていく。"

#. Occurrence 5B_16:289:6533: scene=5B_16
#: 5B_16:289
msgctxt "text_id=6533 | speaker=unknown"
msgid "  Together, they watched it disappear."
msgstr "　その光景をふたりは眺めていた。"

#. Occurrence 5B_16:309:6534: scene=5B_16
#: 5B_16:309
msgctxt "text_id=6534 | speaker=unknown"
msgid "  Soujyuro lay on the ground, desperately gasping for air like a fish out of water."
msgstr "　草十郎は地面に倒れこんで、必死に酸素を取りこんでいる。"

#. Occurrence 5B_16:314:6535: scene=5B_16
#: 5B_16:314
msgctxt "text_id=6535 | speaker=unknown"
msgid "  The curse of the exploding egg had numbed his pain, and he was understandably exhausted after all he had experienced. He looked like he could be blown away by the lightest of breezes."
msgstr "　爆弾卵の<詩篇|のろい>で痛覚は麻痺し、積み重なった疲労は相当なものだろう。吹けば消えそうとはこの事だ。"

#. Occurrence 5B_16:319:6536: scene=5B_16
#: 5B_16:319
msgctxt "text_id=6536 | speaker=unknown"
msgid "  While Aoko was also exhausted, she was still in better shape."
msgstr "　一方の青子も疲れきってはいたが、草十郎ほど息の乱れはない。"

#. Occurrence 5B_16:325:6537: scene=5B_16
#: 5B_16:325
msgctxt "text_id=6537 | speaker=unknown"
msgid "Focused on taking deep, even breaths, she was already working to recover her strength."
msgstr "今は深呼吸を繰り返し、体力回復に努めている。"

#. Occurrence 5B_16:376:6538: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0001; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:376
msgctxt "text_id=6538 | speaker=aoko"
msgid "\"...So.\""
msgstr "「……あのさ」"

#. Occurrence 5B_16:383:6539: scene=5B_16
#: 5B_16:383
msgctxt "text_id=6539 | speaker=unknown"
msgid "  She addressed Soujyuro indifferently as her gaze remained on the amusement park."
msgstr "　青子は視線を遊園地に向けたまま、関心のない素振りで、草十郎に声をかけた。"

#. Occurrence 5B_16:388:6540: scene=5B_16
#: 5B_16:388
msgctxt "text_id=6540 | speaker=unknown"
msgid "  The abruptness of it was a bit theatrical in nature. She wanted to look at him as she spoke, but her pride was simply too great."
msgstr "　やや芝居がかった唐突さ。本当は面と向かって話しかけたいのを、意地で堪えているのが見え見えである。"

#. Occurrence 5B_16:439:6541: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0002; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:439
msgctxt "text_id=6541 | speaker=aoko"
msgid "\"...You did something kinda amazing, didn't you?\""
msgstr "「……貴方、なんかすごいコトしなかった？」"

#. Occurrence 5B_16:503:6542: scene=5B_16
#: 5B_16:503
msgctxt "text_id=6542 | speaker=unknown"
msgid "  The moment she had accepted death had seemed like an eternity."
msgstr "　……彼女が死を受け入れた、永遠とも言える一瞬。"

#. Occurrence 5B_16:509:6543: scene=5B_16
#: 5B_16:509
msgctxt "text_id=6543 | speaker=unknown"
msgid "  She was beside herself in shock at how indifferent she had been as the shards rained down from the moon."
msgstr "　月の破片に貫かれる自分を、冷静に、自分でもどうかと思うほど客観的に見ていた時。"

#. Occurrence 5B_16:514:6544: scene=5B_16
#: 5B_16:514
msgctxt "text_id=6544 | speaker=unknown"
msgid "  But a reassuring voice had snapped her back into reality."
msgstr "　力強く呼びかける声が、彼女を現実に引き戻した。"

#. Occurrence 5B_16:585:6545: scene=5B_16
#: 5B_16:585
msgctxt "text_id=6545 | speaker=unknown"
msgid "  Why did he do it? What was he thinking? What moronic things had he done to pull it off?"
msgstr "　……いかなる理由で、何を考えて、どんな無茶をして、彼は自分を助けたのか。"

#. Occurrence 5B_16:590:6546: scene=5B_16
#: 5B_16:590
msgctxt "text_id=6546 | speaker=unknown"
msgid "  She had no answers for these questions, lying on the ground as she was. All she knew was that he had more than made up for his failure in the house of mirrors and then some, in those fateful final moments."
msgstr "　倒れていた青子には、そのあたりの経緯がまったく分からない。確かなことは、最後の最後で、最高のフォローをしてもらったという事だけ。"

#. Occurrence 5B_16:610:6547: scene=5B_16
#: 5B_16:610
msgctxt "text_id=6547 | speaker=unknown"
msgid "  She addressed him, hoping to find answers, but found herself unable to probe any further."
msgstr "　それが知りたくて声をかけたが、それ以上のことは言葉にできない。"

#. Occurrence 5B_16:624:6548: scene=5B_16
#: 5B_16:624
msgctxt "text_id=6548 | speaker=unknown"
msgid "  To dig any deeper would feel like defeat, which is why it was so unlike her to ask him in the first place."
msgstr "　言葉にしたら負けな気がして、こんな風に、らしくない態度で声をかけたのだ。"

#. Occurrence 5B_16:629:6549: scene=5B_16
#: 5B_16:629
msgctxt "text_id=6549 | speaker=unknown"
msgid "  Lucky for her, Soujyuro had neither the capacity nor sensitivity to understand how egocentric she was being."
msgstr "　もちろん幸い、話しかけられた彼には、そんな彼女のいじらしさに気付く余裕も情緒も、ありはしなかったのだが。"

#. Occurrence 5B_16:681:6550: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_16_0000; voice_prefix=A30; voice_category=3; scene=5B_16
#: 5B_16:681
msgctxt "text_id=6550 | speaker=soujuurou"
msgid "\"Amazing?"
msgstr "「すごいって、"

msgctxt "text_id=6551 | speaker=unknown"
msgid " You were..."
msgstr "それは、"

msgctxt "text_id=6552 | speaker=unknown"
msgid "...pretty amazing..."
msgstr "蒼崎の方、"

msgctxt "text_id=6553 | speaker=unknown"
msgid "...Aozaki.\""
msgstr "だろ」"

#. Occurrence 5B_16:695:6554: scene=5B_16
#: 5B_16:695
msgctxt "text_id=6554 | speaker=unknown"
msgid "  He stuttered between labored breaths."
msgstr "　草十郎は胸を弾ませながら答える。"

#. Occurrence 5B_16:700:6555: scene=5B_16
#: 5B_16:700
msgctxt "text_id=6555 | speaker=unknown"
msgid "  It was taking him so much effort just to breathe that he could not address her properly."
msgstr "　今は肺に酸素を送るのに手一杯で、青子に顔を向ける余裕もない。"

#. Occurrence 5B_16:706:6556: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0003; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:706
msgctxt "text_id=6556 | speaker=aoko"
msgid "\"....\""
msgstr "「………………」"

#. Occurrence 5B_16:711:6557: scene=5B_16
#: 5B_16:711
msgctxt "text_id=6557 | speaker=unknown"
msgid "  She watched him out of the corner of her eye."
msgstr "　そんな様子を、少女は横目で観察する。"

#. Occurrence 5B_16:766:6558: scene=5B_16
#: 5B_16:766
msgctxt "text_id=6558 | speaker=unknown"
msgid "  Thinking back on it, the boy had performed the same role each time."
msgstr "　振り返れば、少年の役割はどれも同じだった。"

#. Occurrence 5B_16:771:6559: scene=5B_16
#: 5B_16:771
msgctxt "text_id=6559 | speaker=unknown"
msgid "  Each and every time, he did what he could in spite of his fecklessness."
msgstr "　鏡の城でも童話の遊園地でも、彼は自分の無力さを<嗤|わら>わず、自分にできる事と向きあい続けた。"

#. Occurrence 5B_16:776:6560: scene=5B_16
#: 5B_16:776
msgctxt "text_id=6560 | speaker=unknown"
msgid "  It was far more admirable than her nearly suicidal tactics, even if she did defeat her opponent."
msgstr "　相手を打ち負かしたのはいいものの、勢いあまって転びかけた愚か者とは大違いだ。"

#. Occurrence 5B_16:811:6561: scene=5B_16
#: 5B_16:811
msgctxt "text_id=6561 | speaker=unknown"
msgid "  He did not even recognize how extraordinary his last act of courage was."
msgstr "　…………だから今の無謀だって、彼にすればそう特別な事ではなく、"

#. Occurrence 5B_16:842:6562: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_16_0001; voice_prefix=A30; voice_category=3; scene=5B_16
#: 5B_16:842
msgctxt "text_id=6562 | speaker=soujuurou"
msgid "\"Here's an idea. If I help you kill that thing, will you let me go?\""
msgstr "『―――提案。あいつをやっつけるのに協力したら、俺の事は見逃してくれる？』"

#. Occurrence 5B_16:872:6563: scene=5B_16
#: 5B_16:872
msgctxt "text_id=6563 | speaker=unknown"
msgid "  At the very least, he had the courage to keep trying whatever he could."
msgstr "　せめて、自分に出来る事からは目を背けない彼にとっての、<精一杯|できるかぎり>の勇気だった。"

#. Occurrence 5B_16:950:6564: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0004; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:950
msgctxt "text_id=6564 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5B_16:956:6565: scene=5B_16
#: 5B_16:956
msgctxt "text_id=6565 | speaker=unknown"
msgid "  A spectator might have viewed him as a supporting actor."
msgstr "　観客から見ればただの脇役。"

#. Occurrence 5B_16:961:6566: scene=5B_16
#: 5B_16:961
msgctxt "text_id=6566 | speaker=unknown"
msgid "  His actions were not exactly memorable."
msgstr "　目の覚めるような活躍だなんてとても言えない。"

#. Occurrence 5B_16:974:6567: scene=5B_16
#: 5B_16:974
msgctxt "text_id=6567 | speaker=unknown"
msgid "  But the lead actress he supported did not see it that way."
msgstr "　けれど、転ばないよう手を引っ張られた少女にすれば話は別で、"

#. Occurrence 5B_16:1015:6568: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0005; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1015
msgctxt "text_id=6568 | speaker=aoko"
msgid "(Well..."
msgstr "“……まあね。"

#. Occurrence 5B_16:1021:6569: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0006; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1021
msgctxt "text_id=6569 | speaker=aoko"
msgid "  I don't really want to admit it to myself, much less say it out loud, but...)"
msgstr "　認めたくないし、口になんて、もっとしたくないけど”"

#. Occurrence 5B_16:1027:6570: scene=5B_16
#: 5B_16:1027
msgctxt "text_id=6570 | speaker=unknown"
msgid "  Such inspired actions were wasted in a supporting role."
msgstr "　少年の<奮起|ふんき>は脇役扱いされるものではなく。"

#. Occurrence 5B_16:1032:6571: scene=5B_16
#: 5B_16:1032
msgctxt "text_id=6571 | speaker=unknown"
msgid "  This guy really pulled off the impossible. It was so amazing that she wanted to shout it as loud as she possibly could for all the world to hear."
msgstr "　本当にすごい事をしたのはコイツだよ、なんて、まわりに言い聞かせたいほどの奮戦だったのだ。"

#. Occurrence 5B_16:1067:6572: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0007; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1067
msgctxt "text_id=6572 | speaker=aoko"
msgid "\"...Hah.\""
msgstr "「――――――はあ」"

#. Occurrence 5B_16:1073:6573: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_16_0002; voice_prefix=A30; voice_category=3; scene=5B_16
#: 5B_16:1073
msgctxt "text_id=6573 | speaker=soujuurou"
msgid "\"Aozaki?\""
msgstr "「蒼崎？」"

#. Occurrence 5B_16:1080:6574: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0008; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1080
msgctxt "text_id=6574 | speaker=aoko"
msgid "(God. He's so innocent it makes me want to barf.)"
msgstr "“……ホント。人畜無害も、度を過ぎると侮れないわ”"

#. Occurrence 5B_16:1085:6575: scene=5B_16
#: 5B_16:1085
msgctxt "text_id=6575 | speaker=unknown"
msgid "  All Aoko could do was sigh."
msgstr "　はあ、と青子は自分自身にため息をつく。"

#. Occurrence 5B_16:1137:6576: scene=5B_16
#: 5B_16:1137
msgctxt "text_id=6576 | speaker=unknown"
msgid "  How could she not? Even she was forced to admit that the way he'd snatched her from the jaws of death was... dashing."
msgstr "　けれど仕方がない。たったいま窮地から救ってくれた姿は、ほんのちょっとだけ格好良かったし、"

#. Occurrence 5B_16:1144:6577: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0009; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1144
msgctxt "text_id=6577 | speaker=aoko"
msgid "\"I must be getting soft.\""
msgstr "「……ま。評価、甘めだけど」"

#. Occurrence 5B_16:1150:6578: scene=5B_16
#: 5B_16:1150
msgctxt "text_id=6578 | speaker=unknown"
msgid "  Truth be told, he was a lunatic for doing what he did."
msgstr "　正直。こんなのにわざわざ手を下すなんて、<莫|ば><迦|か>らしいにも程がある。"

#. Occurrence 5B_16:1241:6579: scene=5B_16
#: 5B_16:1241
msgctxt "text_id=6579 | speaker=unknown"
msgid "  She steadied her breathing and composed herself."
msgstr "　呼吸を整え、少女はすぅ、と体を起こした。"

#. Occurrence 5B_16:1246:6580: scene=5B_16
#: 5B_16:1246
msgctxt "text_id=6580 | speaker=unknown"
msgid "  While she was in bad shape, she still had her pride as a mage to consider."
msgstr "　……実のところまだ厳しいが、彼女にも魔術師としての誇りがある。"

#. Occurrence 5B_16:1251:6581: scene=5B_16
#: 5B_16:1251
msgctxt "text_id=6581 | speaker=unknown"
msgid "  That was why she felt a need to maintain an air of dignity."
msgstr "　なので、<宣言|せんげん>する時は<威厳|いげん>がなくてはいけないのだ。"

#. Occurrence 5B_16:1303:6582: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0010; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1303
msgctxt "text_id=6582 | speaker=aoko"
msgid "\"Sizuki, I originally meant to let you off the hook for today only, but I'm willing to let the whole thing go."
msgstr "「静希君。見逃すのは今日だけって話だったけど、アレ、なしでいいわ。"

#. Occurrence 5B_16:1310:6583: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0011; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1310
msgctxt "text_id=6583 | speaker=aoko"
msgid "For the time being, I've decided to let you live.\""
msgstr "とりあえず、命は助けてあげるから」"

#. Occurrence 5B_16:1343:6584: scene=5B_16
#: 5B_16:1343
msgctxt "text_id=6584 | speaker=unknown"
msgid "  She hastily extended her right hand."
msgstr "　仕方なさげに差し出される右手。"

#. Occurrence 5B_16:1348:6585: scene=5B_16
#: 5B_16:1348
msgctxt "text_id=6585 | speaker=unknown"
msgid "  It was either to shake his or to help him up."
msgstr "　握手とも、座りこんだ草十郎を立ち上がらせる為のものとも取れる。"

#. Occurrence 5B_16:1368:6586: scene=5B_16
#: 5B_16:1368
msgctxt "text_id=6586 | speaker=unknown"
msgid "  However..."
msgstr "　一方。"

#. Occurrence 5B_16:1444:6587: scene=5B_16
#: 5B_16:1444
msgctxt "text_id=6587 | speaker=unknown"
msgid "  Soujyuro did not take her hand, but instead stood up on his own."
msgstr "　差し出された手を取らず、草十郎は自分の足で立ち上がった。"

#. Occurrence 5B_16:1449:6588: scene=5B_16
#: 5B_16:1449
msgctxt "text_id=6588 | speaker=unknown"
msgid "  This night."
msgstr "　この夜。"

#. Occurrence 5B_16:1455:6589: scene=5B_16
#: 5B_16:1455
msgctxt "text_id=6589 | speaker=unknown"
msgid "Despite the sheer insanity that he had just experienced, his face had not once looked as incredulous as it did now."
msgstr "散々な目にあわされながらも、結局一度も見せなかった、心から意外そうな<表|か><情|お>をして。"

#. Occurrence 5B_16:1522:6590: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0012; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1522
msgctxt "text_id=6590 | speaker=aoko"
msgid "\"W-what? Something wrong?\""
msgstr "「な、なによそのリアクションは」"

#. Occurrence 5B_16:1528:6591: scene=5B_16
#: 5B_16:1528
msgctxt "text_id=6591 | speaker=unknown"
msgid "  She stammered, worried that she had deeply embarrassed herself."
msgstr "　何か、とんでもなく恥ずかしい事をした気になって言い<淀|よど>む青子。"

#. Occurrence 5B_16:1533:6592: scene=5B_16
#: 5B_16:1533
msgctxt "text_id=6592 | speaker=unknown"
msgid "  Soujyuro's gaze was fixed upon Aoko."
msgstr "　そんな彼女を、草十郎はまじまじと見つめている。"

#. Occurrence 5B_16:1589:6593: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0013; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1589
msgctxt "text_id=6593 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5B_16:1595:6594: scene=5B_16
#: 5B_16:1595
msgctxt "text_id=6594 | speaker=unknown"
msgid "  A problem had dawned on Aoko."
msgstr "　……問題は。"

#. Occurrence 5B_16:1601:6595: scene=5B_16
#: 5B_16:1601
msgctxt "text_id=6595 | speaker=unknown"
msgid "Though she normally hated being stared at, this time, she did not mind."
msgstr "じろじろと見つめられれば不快になる筈なのに、嫌悪感がまったくないこと。"

#. Occurrence 5B_16:1606:6596: scene=5B_16
#: 5B_16:1606
msgctxt "text_id=6596 | speaker=unknown"
msgid "  Rather, she was enjoying the warmth in his eyes and felt like it was something she could almost come to appreciate."
msgstr "　むしろ容認しちゃってもいいかも知れない、などと、青子をして思わせるほど温かみのある視線で―――"

#. Occurrence 5B_16:1663:6597: scene=5B_16
#: 5B_16:1663
msgctxt "text_id=6597 | speaker=unknown"
msgid "\"Don't you get it? This isn't just about friendship! And I didn't mean he only 'likes' you, either! Believe me when I say that Sono-G really―\""
msgstr "「いや、そんなお友達感覚の話じゃなくてだな。そういう好き嫌いじゃなくて、草の字は本気でおまえに―――」"

#. Occurrence 5B_16:1725:6598: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0014; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1725
msgctxt "text_id=6598 | speaker=aoko"
msgid "(Oh...)"
msgstr "“……あ……”"

#. Occurrence 5B_16:1731:6599: scene=5B_16
#: 5B_16:1731
msgctxt "text_id=6599 | speaker=unknown"
msgid "  The conversation came rushing back."
msgstr "　そこで。"

#. Occurrence 5B_16:1736:6600: scene=5B_16
#: 5B_16:1736
msgctxt "text_id=6600 | speaker=unknown"
msgid "  It was a memory better left forgotten."
msgstr "　よせばいいのに、忘れていた台詞を思い出した。"

#. Occurrence 5B_16:1789:6601: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0015; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1789
msgctxt "text_id=6601 | speaker=aoko"
msgid "(No, not happening!)"
msgstr "“いかん、それは違う！”"

#. Occurrence 5B_16:1841:6602: scene=5B_16
#: 5B_16:1841
msgctxt "text_id=6602 | speaker=unknown"
msgid "  Pushing Tobimaru's words out of her mind, Aoko turned to Soujyuro."
msgstr "　鳶丸の台詞を心の中で思いっきり否定して、青子は草十郎に向き直る。"

#. Occurrence 5B_16:1870:6603: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0016; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1870
msgctxt "text_id=6603 | speaker=aoko"
msgid "\"D-don't get any ideas!"
msgstr "「そ、それとこれは別だから！"

#. Occurrence 5B_16:1876:6604: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0017; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1876
msgctxt "text_id=6604 | speaker=aoko"
msgid "  I don't care about you in the least!\""
msgstr "　私はアンタの事とか、ホントどうでもいいんだから！」"

#. Occurrence 5B_16:1881:6605: scene=5B_16
#: 5B_16:1881
msgctxt "text_id=6605 | speaker=unknown"
msgid "  Puzzled, Soujyuro tilted his head."
msgstr "　はい？　と首を傾げる草十郎。"

#. Occurrence 5B_16:1915:6606: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_16_0003; voice_prefix=A30; voice_category=3; scene=5B_16
#: 5B_16:1915
msgctxt "text_id=6606 | speaker=soujuurou"
msgid "\"You already told me how much you dislike me.\""
msgstr "「さっき嫌いだって言われたけど」"

#. Occurrence 5B_16:1920:6607: scene=5B_16
#: 5B_16:1920
msgctxt "text_id=6607 | speaker=unknown"
msgid "  He responded matter-of-factly to her sudden declaration."
msgstr "　唐突な青子の発言に疑問こそあれ文句はなく、彼は淡々と言葉を返す。"

#. Occurrence 5B_16:1961:6608: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0018; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1961
msgctxt "text_id=6608 | speaker=aoko"
msgid "\"Uuuh...\""
msgstr "「う―――」"

#. Occurrence 5B_16:1967:6609: scene=5B_16
#: 5B_16:1967
msgctxt "text_id=6609 | speaker=unknown"
msgid "  She certainly had pointed that out. And to his face no less."
msgstr "　……たしかに、面と向かって言った。"

#. Occurrence 5B_16:1972:6610: scene=5B_16
#: 5B_16:1972
msgctxt "text_id=6610 | speaker=unknown"
msgid "  It had a mere figure of speech that he was not meant to take literally, but now was not the time to belabor the point."
msgstr "　けれどあれは言葉のアヤで、本気に取られると困ってしまうし、なによりそれより、今はそんな事を論じている場面ではなく、"

#. Occurrence 5B_16:2001:6611: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0019; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:2001
msgctxt "text_id=6611 | speaker=aoko"
msgid "\"I-I'm not talking about that! I'm just saying... you shouldn't get your hopes up, no matter how far you've fallen for me!\""
msgstr "「そ、そうじゃなくて！　あなたが私に<惚|ほ>れてても、期待しないでって言ってるの！」"

#. Occurrence 5B_16:2007:6612: scene=5B_16
#: 5B_16:2007
msgctxt "text_id=6612 | speaker=unknown"
msgid "  Yet, belabor she did anyway."
msgstr "　つまり彼女は、そういう事を論じたいらしい。"

#. Occurrence 5B_16:2060:6613: scene=5B_16
#: 5B_16:2060
msgctxt "text_id=6613 | speaker=unknown"
msgid "  Aoko blushed slightly, realizing how inane she was being."
msgstr "　柄にもない事を怒鳴って、青子は<微|かす>かに赤面する。"

#. Occurrence 5B_16:2065:6614: scene=5B_16
#: 5B_16:2065
msgctxt "text_id=6614 | speaker=unknown"
msgid "  She wondered how she'd ended up in this position."
msgstr "　なんでこんなコトを口にする羽目になったんだろう、と悩みながら。"

#. Occurrence 5B_16:2106:6615: scene=5B_16
#: 5B_16:2106
msgctxt "text_id=6615 | speaker=unknown"
msgid "  And yet, she knew that she had to get this off her chest."
msgstr "　……それでも、とにかく言いたい事、言うべき事は言ったのだ。"

#. Occurrence 5B_16:2111:6616: scene=5B_16
#: 5B_16:2111
msgctxt "text_id=6616 | speaker=unknown"
msgid "  All that was left was to politely wait for his response."
msgstr "　ここは礼儀として、相手の返答を待つだけである。"

#. Occurrence 5B_16:2146:6617: scene=5B_16
#: 5B_16:2146
msgctxt "text_id=6617 | speaker=unknown"
msgid "\"I can't date you.\""
msgstr "“あなたとは付き合えない”"

#. Occurrence 5B_16:2168:6618: scene=5B_16
#: 5B_16:2168
msgctxt "text_id=6618 | speaker=unknown"
msgid "  Such heartbreakingly painful words were too much for the simple boy to hear. His shoulders slumped as if the world was coming to an end..."
msgstr "　なんてハートブレイクな言葉を受けて、純朴な少年はこの世の終わりのように、がっくりと肩を落とし……"

msgctxt "text_id=6619 | speaker=unknown"
msgid "  ...Or so Aoko had imagined."
msgstr "　てはいなかった。"

#. Occurrence 5B_16:2175:6620: scene=5B_16
#: 5B_16:2175
msgctxt "text_id=6620 | speaker=unknown"
msgid "  On the contrary, Soujyuro was sitting there in deep thought."
msgstr "　それどころか、なにやら真剣に考えこんでいる。"

#. Occurrence 5B_16:2203:6621: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_16_0004; voice_prefix=A30; voice_category=3; scene=5B_16
#: 5B_16:2203
msgctxt "text_id=6621 | speaker=soujuurou"
msgid "\"Did you just say... I'm in love with you?\""
msgstr "「俺が、蒼崎に、惚れてるって……？」"

#. Occurrence 5B_16:2231:6622: scene=5B_16
#: 5B_16:2231
msgctxt "text_id=6622 | speaker=unknown"
msgid "  Soujyuro murmured the words as if they were a magic spell."
msgstr "　呪文のように呟く草十郎。"

#. Occurrence 5B_16:2267:6623: scene=5B_16
#: 5B_16:2267
msgctxt "text_id=6623 | speaker=unknown"
msgid "  She shot right back with the affirmative."
msgstr "　そうよ、と突っ返す青子。"

#. Occurrence 5B_16:2314:6624: scene=5B_16
#: 5B_16:2314
msgctxt "text_id=6624 | speaker=unknown"
msgid "  After a moment of deep contemplation, the boy turned to the expectant girl, and said,"
msgstr "　深く、返事を待つ青子がドギマギするぐらい深く考えこんだ末、少年は少女を見つめ返して、すっぱりと言った。"

#. Occurrence 5B_16:2358:6625: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_16_0005; voice_prefix=A30; voice_category=3; scene=5B_16
#: 5B_16:2358
msgctxt "text_id=6625 | speaker=soujuurou"
msgid "\"Why do you think that?\""
msgstr "「―――なんで？」"

#. Occurrence 5B_16:2496:6626: scene=5B_16
#: 5B_16:2496
msgctxt "text_id=6626 | speaker=unknown"
msgid "  He had to be joking."
msgstr "　………冗談じゃ、"

msgctxt "text_id=6627 | speaker=unknown"
msgid " But he was not."
msgstr "ない。"

#. Occurrence 5B_16:2503:6628: scene=5B_16
#: 5B_16:2503
msgctxt "text_id=6628 | speaker=unknown"
msgid "  He was completely serious."
msgstr "　彼は本気で言っている。"

#. Occurrence 5B_16:2510:6629: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0021; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:2510
msgctxt "text_id=6629 | speaker=aoko"
msgid "(So...)"
msgstr "“と―――”"

#. Occurrence 5B_16:2515:6630: scene=5B_16
#: 5B_16:2515
msgctxt "text_id=6630 | speaker=unknown"
msgid "  He liked her, but he didn't LIKE like her."
msgstr "　つまり、好きではあるけど、好きなダケ。"

#. Occurrence 5B_16:2520:6631: scene=5B_16
#: 5B_16:2520
msgctxt "text_id=6631 | speaker=unknown"
msgid "  Of course the vice-president had jumped to conclusions. This boy had no interest in romance. He probably didn't even know what that was."
msgstr "　ぜんぶ副会長の早とちり。色恋沙汰とか男女の浪漫とか、はじめっからあたまになし。"

#. Occurrence 5B_16:2575:6632: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0022; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:2575
msgctxt "text_id=6632 | speaker=aoko"
msgid "(So... So... So...)"
msgstr "“と、と、と―――”"

#. Occurrence 5B_16:2580:6633: scene=5B_16
#: 5B_16:2580
msgctxt "text_id=6633 | speaker=unknown"
msgid "  She was incredibly embarrassed by how confused Soujyuro still appeared to be."
msgstr "　まだ悩んでいる草十郎の仕草が、よけい恥ずかしい。"

#. Occurrence 5B_16:2585:6634: scene=5B_16
#: 5B_16:2585
msgctxt "text_id=6634 | speaker=unknown"
msgid "  Her rosy complexion spread throughout her entire body."
msgstr "　青子は顔どころか全身熱くなる衝動に襲われて、"

#. Occurrence 5B_16:2632:6635: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_16_0006; voice_prefix=A30; voice_category=3; scene=5B_16
#: 5B_16:2632
msgctxt "text_id=6635 | speaker=soujuurou"
msgid "\"Umm... I'll ask again, but why do you think that?\""
msgstr "「むう。もう一度聞くけど、なんで？」"

#. Occurrence 5B_16:2653:6636: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0023; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:2653
msgctxt "text_id=6636 | speaker=aoko"
msgid "\"THAT'S WHAT I WANNA KNOW!!!\""
msgstr "「そりゃあ、こっちが聞きたいわよーーーー！！！！」"

#. Occurrence 5B_16:2660:6637: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0024; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:2660
msgctxt "text_id=6637 | speaker=aoko"
msgid "(You freaking moron, Tobimaru!!!)"
msgstr "“鳶丸の、大馬鹿野郎ーーーーーーっ！！！！！”"

#. Occurrence 5B_16:2680:6638: scene=5B_16
#: 5B_16:2680
msgctxt "text_id=6638 | speaker=unknown"
msgid "  Just like that..."
msgstr "　……このように。"

#. Occurrence 5B_16:2686:6639: scene=5B_16
#: 5B_16:2686
msgctxt "text_id=6639 | speaker=unknown"
msgid "She had lost her cool and given in to an unjustifiable outburst."
msgstr "もはや<釈明|しゃくめい>のしようもない、あるまじき暴挙に出たのだった。"

#. Occurrence 5B_16:2763:6640: scene=5B_16
#: 5B_16:2763
msgctxt "text_id=6640 | speaker=unknown"
msgid "  It was time to seal off the area and destroy all evidence."
msgstr "　なんという現場封鎖、証拠隠滅。"

#. Occurrence 5B_16:2768:6641: scene=5B_16
#: 5B_16:2768
msgctxt "text_id=6641 | speaker=unknown"
msgid "  Aoko's embarrassment devolved into sheer panic, and her grudge against Tobimaru suddenly manifested as criminal assault."
msgstr "　恥ずかしさで頬が溶けるかのようなパニックと、鳶丸への恨みが彼女を突発的な犯行に走らせた。"

#. Occurrence 5B_16:2773:6642: scene=5B_16
#: 5B_16:2773
msgctxt "text_id=6642 | speaker=unknown"
msgid "  She lashed out with a punch that could have taken down a bird mid-flight. More specifically, it was a brutal right hook."
msgstr "　飛ぶ鳥すら落とす正拳突き。もとい、やや弧を描いたのでストレートではなくフックと言うべきか。"

#. Occurrence 5B_16:2810:6643: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0025; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:2810
msgctxt "text_id=6643 | speaker=aoko"
msgid "\"Ah...\""
msgstr "「あ…………」"

#. Occurrence 5B_16:2816:6644: scene=5B_16
#: 5B_16:2816
msgctxt "text_id=6644 | speaker=unknown"
msgid "  Aoko blinked. Her blow had connected with something solid, snapping her out of her reverie."
msgstr "　会心の手応えに目を点にする青子。"

#. Occurrence 5B_16:2821:6645: scene=5B_16
#: 5B_16:2821
msgctxt "text_id=6645 | speaker=unknown"
msgid "  Her temper had lashed out at the completely defenseless Soujyuro."
msgstr "　無防備だった彼と、激情に乗り出した自分。"

#. Occurrence 5B_16:2826:6646: scene=5B_16
#: 5B_16:2826
msgctxt "text_id=6646 | speaker=unknown"
msgid "  It had been a splendid blow with all her weight behind it, knocking him out cold."
msgstr "　腰の入った一撃は、見事なまでに彼の意識を刈り取った。"

#. Occurrence 5B_16:2908:6647: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_16_0007; voice_prefix=A30; voice_category=3; scene=5B_16
#: 5B_16:2908
msgctxt "text_id=6647 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5B_16:2913:6648: scene=5B_16
#: 5B_16:2913
msgctxt "text_id=6648 | speaker=unknown"
msgid "  Soujyuro groaned, crumpling to the ground."
msgstr "　きゅう、と声をもらして倒れこむ草十郎。"

#. Occurrence 5B_16:2918:6649: scene=5B_16
#: 5B_16:2918
msgctxt "text_id=6649 | speaker=unknown"
msgid "  Her punch finished the job that the curse had started."
msgstr "　受けたばかりの詩篇の呪いと、今の一撃がトドメになったらしい。"

#. Occurrence 5B_16:2923:6650: scene=5B_16
#: 5B_16:2923
msgctxt "text_id=6650 | speaker=unknown"
msgid "  If not for the discomfort on his face, he appeared almost to be sleeping. Aoko convinced herself that he was napping, not concussed."
msgstr "　眠るように……と表現するにはやや苦しい、苦悶に歪んだ寝顔だが、これは気絶ではなく眠ったのだ、と青子は強引に解釈するコトにした。"

#. Occurrence 5B_16:2967:6651: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0026; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:2967
msgctxt "text_id=6651 | speaker=aoko"
msgid "\"...Well, whatever. It was always going to end like this anyway.\""
msgstr "「……ま、いっか。予定通りになったものね」"

#. Occurrence 5B_16:2973:6652: scene=5B_16
#: 5B_16:2973
msgctxt "text_id=6652 | speaker=unknown"
msgid "  The tension in her shoulders eased away as she looked down at Soujyuro. A ton had gotten in her way over the course of today, but the day was saved, for now."
msgstr "　うん、とノックダウンした草十郎を見て、青子は肩の力を抜いた。色々と邪魔が入ったけれど、とりあえずこれで一件落着だ。"

#. Occurrence 5B_16:2978:6653: scene=5B_16
#: 5B_16:2978
msgctxt "text_id=6653 | speaker=unknown"
msgid "  With nobody left to butt heads, she felt exhaustion finally overtake her."
msgstr "　虚勢を張る相手もいなくなると、どっと疲れがやってくる。"

#. Occurrence 5B_16:3014:6654: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0027; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3014
msgctxt "text_id=6654 | speaker=aoko"
msgid "\"Ugh... How the heck am I going to walk home like this?\""
msgstr "「うわ……歩いて帰れるかな、私」"

#. Occurrence 5B_16:3020:6655: scene=5B_16
#: 5B_16:3020
msgctxt "text_id=6655 | speaker=unknown"
msgid "  Her fatigue was enough to make her complain out loud."
msgstr "　つい弱音をこぼすほどの疲労だった。"

#. Occurrence 5B_16:3025:6656: scene=5B_16
#: 5B_16:3025
msgctxt "text_id=6656 | speaker=unknown"
msgid "  When she thought about it, she realized that this was the first time she had used up all of her magical energy and the first time she had participated in a battle of this scale without any prior preparation."
msgstr "　考えてみれば魔力を使いきったのも初めてだし、何の前準備もなしでこれだけの戦いをこなしたのも初めてだ。"

#. Occurrence 5B_16:3030:6657: scene=5B_16
#: 5B_16:3030
msgctxt "text_id=6657 | speaker=unknown"
msgid "  Though in truth..."
msgstr "　いや、そもそも―――"

#. Occurrence 5B_16:3072:6658: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0028; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3072
msgctxt "text_id=6658 | speaker=aoko"
msgid "\"It would have ended in mutual destruction if I'd been alone.\""
msgstr "「私ひとりじゃ、どっちも相打ちだったっけ」"

#. Occurrence 5B_16:3078:6659: scene=5B_16
#: 5B_16:3078
msgctxt "text_id=6659 | speaker=unknown"
msgid "  She felt somewhat proud as she whispered those words."
msgstr "　呟いた声は、どこか誇らしげだった。"

#. Occurrence 5B_16:3083:6660: scene=5B_16
#: 5B_16:3083
msgctxt "text_id=6660 | speaker=unknown"
msgid "  Normally, it was something that she would beat herself up over, but instead, she simply shrugged her shoulders with a bitter smile."
msgstr "　本来なら<自戒|じかい>すべき事なのに、苦笑いしている自分にやれやれと肩をすくめる。"

#. Occurrence 5B_16:3088:6661: scene=5B_16
#: 5B_16:3088
msgctxt "text_id=6661 | speaker=unknown"
msgid "  After all, it was thanks to the person sleeping by her side."
msgstr "　それもこれも、いま傍らで眠っている誰かさんのおかげだろう。"

#. Occurrence 5B_16:3122:6662: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0029; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3122
msgctxt "text_id=6662 | speaker=aoko"
msgid "\"...Hey. You can't hear me, can you?\""
msgstr "「……ね、聞こえてないわよね？」"

#. Occurrence 5B_16:3128:6663: scene=5B_16
#: 5B_16:3128
msgctxt "text_id=6663 | speaker=unknown"
msgid "  As if the night had swallowed her voice before it reached him, she received no response."
msgstr "　夜風よりも小さい呼びかけに、反応はない。"

#. Occurrence 5B_16:3133:6664: scene=5B_16
#: 5B_16:3133
msgctxt "text_id=6664 | speaker=unknown"
msgid "  Confident, she continued in an even quieter voice."
msgstr "　それに安心して、もっと小さい声で彼女は続ける。"

#. Occurrence 5B_16:3155:6665: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0030; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3155
msgctxt "text_id=6665 | speaker=aoko"
msgid "\"So, uh, thank you."
msgstr "「……その、ありがと。"

msgctxt "text_id=6666 | speaker=unknown"
msgid " You really got me out of a jam, there.\""
msgstr "十分に助けてもらったわ」"

#. Occurrence 5B_16:3190:6667: scene=5B_16
#: 5B_16:3190
msgctxt "text_id=6667 | speaker=unknown"
msgid "  Of course, there was no response from Soujyuro, and she was not expecting one. Saying it for the record was enough."
msgstr "　もちろん返事はないし、期待もしていない。たんに言っておきたかっただけだ。"

#. Occurrence 5B_16:3239:6668: scene=5B_16
#: 5B_16:3239
msgctxt "text_id=6668 | speaker=unknown"
msgid "  Aoko watched Soujyuro sleep for a while and then pulled something out of her pocket."
msgstr "　少女はしばしうなされ眠る少年を眺めたあと、よし、と気持ちを入れ替えてポケットに手を伸ばした。"

#. Occurrence 5B_16:3259:6669: scene=5B_16
#: 5B_16:3259
msgctxt "text_id=6669 | speaker=unknown"
msgid "  It was the palm-sized glass bottle her roommate had given her, which she opened with a pop."
msgstr "　同居人にもらった、手のひらに納まりそうなガラスの瓶を取り出して、ポン、と開封する。"

#. Occurrence 5B_16:3266:6670: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0031; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3266
msgctxt "text_id=6670 | speaker=aoko"
msgid "\"But none of this matters.\""
msgstr "「でも、それとこれとは別だから」"

#. Occurrence 5B_16:3317:6671: scene=5B_16
#: 5B_16:3317
msgctxt "text_id=6671 | speaker=unknown"
msgid "  Leaving behind words colder than a winter chill at night, she called out his name."
msgstr "　冬の夜風よりクールな一言を残して、彼女は彼の名前を呼びかけた。"

#. Occurrence 5B_16:3326:6672: scene=5B_16
#: 5B_16:3326
msgctxt "text_id=6672 | speaker=unknown"
msgid "  She barely sensed the bottle moving."
msgstr "　返事もないのに、瓶はことり、と反応する。"

#. Occurrence 5B_16:3331:6673: scene=5B_16
#: 5B_16:3331
msgctxt "text_id=6673 | speaker=unknown"
msgid "  As the silhouette of the fallen boy appeared to blur, she got the feeling that the weight of the bottle had increased slightly."
msgstr "　横になっている少年の姿がぐにゃりと歪んだかと思うと、瓶の重さが少しだけ増した気がした。"

#. Occurrence 5B_16:3394:6674: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0032; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3394
msgctxt "text_id=6674 | speaker=aoko"
msgid "\"Whoa. That's kind of weird.\""
msgstr "「うわ。どうなってんだろ、コレ」"

#. Occurrence 5B_16:3400:6675: scene=5B_16
#: 5B_16:3400
msgctxt "text_id=6675 | speaker=unknown"
msgid "  What appeared to be a human form could clearly be seen inside the glass."
msgstr "　<曇|くも>ったガラスごしには、たしかに人影のような形が見える。"

#. Occurrence 5B_16:3420:6676: scene=5B_16
#: 5B_16:3420
msgctxt "text_id=6676 | speaker=unknown"
msgid "  Alice Kuonji's tools were Mystics that confounded even the most knowledgeable of mages."
msgstr "　久遠寺有珠の道具は、魔術師たちですら頭を悩ます神秘の具現だ。"

#. Occurrence 5B_16:3425:6677: scene=5B_16
#: 5B_16:3425
msgctxt "text_id=6677 | speaker=unknown"
msgid "  As soon as Aoko tried to analyze them with logic or reason, she was already out of her depth."
msgstr "　理屈やら辻褄を合わせようとする時点で、<魔術師|あおこ>には手の届かない魔術である。"

#. Occurrence 5B_16:3449:6678: scene=5B_16
#: 5B_16:3449
msgctxt "text_id=6678 | speaker=unknown"
msgid "  Knowing this all too well, Aoko closed the bottle and watched the boy disappear as if by some magic trick."
msgstr "　それに納得して瓶の蓋を閉めると、少年の姿は手品のようにかき消えた。"

#. Occurrence 5B_16:3519:6679: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0033; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3519
msgctxt "text_id=6679 | speaker=aoko"
msgid "\"Jeez. This is no stage trick. It's actual magic.\""
msgstr "「……まったく。こんなの手品じゃなくて魔法だって」"

#. Occurrence 5B_16:3525:6680: scene=5B_16
#: 5B_16:3525
msgctxt "text_id=6680 | speaker=unknown"
msgid "  She muttered as she looked into the magical bottle."
msgstr "　ひとり呟いて、青子は魔法の瓶を覗きこむ。"

#. Occurrence 5B_16:3530:6681: scene=5B_16
#: 5B_16:3530
msgctxt "text_id=6681 | speaker=unknown"
msgid "  Its weight had not changed significantly, and she had no idea how it worked, but the one thing she did know was that there was a human being inside of it."
msgstr "　瓶の重さはさして変わらないし、どんな仕組みかも青子には分からない。けれどたしかに、人間ひとりが閉じこめられている。"

#. Occurrence 5B_16:3600:6682: scene=5B_16
#: 5B_16:3600
msgctxt "text_id=6682 | speaker=unknown"
msgid "  Its light weight was almost unnerving,"
msgstr "　その軽さは幻のようで、いまいち実感が湧かなかった。"

#. Occurrence 5B_16:3605:6683: scene=5B_16
#: 5B_16:3605
msgctxt "text_id=6683 | speaker=unknown"
msgid "  closer to empty air than a human being."
msgstr "　人の重さというより風の重さだ。"

#. Occurrence 5B_16:3610:6684: scene=5B_16
#: 5B_16:3610
msgctxt "text_id=6684 | speaker=unknown"
msgid "  It was about as heavy as one would expect if they'd bottled a summer breeze."
msgstr "　夏の風を手探りで掻き集めて、この瓶に詰めこんだのなら、ちょうどこれぐらいの重さになるだろう。"

#. Occurrence 5B_16:3616:6685: scene=5B_16
#: 5B_16:3616
msgctxt "text_id=6685 | speaker=unknown"
msgid "  Though, that did fit her image of Soujyuro perfectly."
msgstr "　だから彼女にとって、草十郎はそんなイメージなのだ。"

#. Occurrence 5B_16:3668:6686: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0034; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3668
msgctxt "text_id=6686 | speaker=aoko"
msgid "\"It's just like Alice said...\""
msgstr "「……有珠の言う通り」"

#. Occurrence 5B_16:3674:6687: scene=5B_16
#: 5B_16:3674
msgctxt "text_id=6687 | speaker=unknown"
msgid "  She muttered to no one in particular as she recalled the past."
msgstr "　そんな事を考えてしまった自分を振り返って、ぼんやりと彼女は呟く。"

#. Occurrence 5B_16:3689:6688: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0035; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3689
msgctxt "text_id=6688 | speaker=aoko"
msgid "\"This really isn't like me.\""
msgstr "「ほんと、私らしくない」"

#. Occurrence 5B_16:3735:6689: scene=5B_16
#: 5B_16:3735
msgctxt "text_id=6689 | speaker=unknown"
msgid "  Aoko wore a bittersweet smile. Her usual moodiness was gone."
msgstr "　いつもの不機嫌さではなく、微笑むように苦笑する。"

#. Occurrence 5B_16:3740:6690: scene=5B_16
#: 5B_16:3740
msgctxt "text_id=6690 | speaker=unknown"
msgid "  It was a dangerous world out there. It was good to have someone to keep her on her toes."
msgstr "　世の中は広いのだし。ひとりぐらいは、ペースを乱す相手がいるのも、張り合いがあっていい。"

#. Occurrence 5B_16:3760:6691: scene=5B_16
#: 5B_16:3760
msgctxt "text_id=6691 | speaker=unknown"
msgid "  With a wry chuckle, she flicked the magical bottle with her finger and set off walking."
msgstr "　苦笑しながら、一回だけこつん、と小さな魔法の瓶を指で弾くと、彼女は静かに歩きだした。"

#. Occurrence 5B_16:3827:6692: scene=5B_16
#: 5B_16:3827
msgctxt "text_id=6692 | speaker=unknown"
msgid "  She could hear a bell in the distance, signaling the end of the play."
msgstr "　遠く、終演のベルが鳴る。"

#. Occurrence 5B_16:3834:6693: scene=5B_16
#: 5B_16:3834
msgctxt "text_id=6693 | speaker=unknown"
msgid "  An ephemeral dream gave way to reality. In the grand scheme of things, it had been but an instant."
msgstr "　世は全て事もなく、うたかたの夢も元通り。"

#. Occurrence 5B_16:3839:6694: scene=5B_16
#: 5B_16:3839
msgctxt "text_id=6694 | speaker=unknown"
msgid "  As the actors exited stage left, the last of the lights silently flickered out."
msgstr "　役者の去った遊園地は、静かに<装飾|あかり>を消していく。"

#. Occurrence 5B_16:3860:6695: scene=5B_16
#: 5B_16:3860
msgctxt "text_id=6695 | speaker=unknown"
msgid "  And so, the long-dead amusement park played its final role, as a memory for a boy and a girl."
msgstr "　……こうして。とうに寿命を迎えていた遊園地は少年と少女の思い出の地になって、その役割を終えたのだった。"

#. Occurrence 5B_2:61:6696: scene=5B_2
#: 5B_2:61
msgctxt "text_id=6696 | speaker=unknown"
msgid "  Faded glory returned to Kitsy Land."
msgstr "　かくして、遊園地は遠き日の輝きを取り戻した。"

#. Occurrence 5B_2:168:6697: scene=5B_2
#: 5B_2:168
msgctxt "text_id=6697 | speaker=unknown"
msgid "  The neon glow of innumerable lights illuminated the night."
msgstr "　夜を照らす無数の電飾。"

#. Occurrence 5B_2:173:6698: scene=5B_2
#: 5B_2:173
msgctxt "text_id=6698 | speaker=unknown"
msgid "  Speakers filled the air with the sound of vinyl music."
msgstr "　スピーカーから流れるレコードの音。"

#. Occurrence 5B_2:178:6699: scene=5B_2
#: 5B_2:178
msgctxt "text_id=6699 | speaker=unknown"
msgid "  Merry-go-rounds, small and large, whirled round and round."
msgstr "　くるくると回りだす大小のゴーラウンド。"

#. Occurrence 5B_2:218:6700: scene=5B_2
#: 5B_2:218
msgctxt "text_id=6700 | speaker=unknown"
msgid "  All in all, it made for a mind-bending spectacle."
msgstr "　……言うまでもなく、すべてあり得ない光景だ。"

#. Occurrence 5B_2:223:6701: scene=5B_2
#: 5B_2:223
msgctxt "text_id=6701 | speaker=unknown"
msgid "  It was certainly possible to power the facilities by transmuting magical energy into electricity via alchemy."
msgstr "　魔力を電流に変換して施設を動かす、というのも錬金術なら可能だろう。"

#. Occurrence 5B_2:244:6702: scene=5B_2
#: 5B_2:244
msgctxt "text_id=6702 | speaker=unknown"
msgid "  That said..."
msgstr "　―――だが。"

#. Occurrence 5B_2:273:6703: scene=5B_2
#: 5B_2:273
msgctxt "text_id=6703 | speaker=unknown"
msgid "  Simply supplying the park with electricity would not have brought back to life that which was broken."
msgstr "　仮に電気が供給されたとしても、壊れたものは蘇らない。"

#. Occurrence 5B_2:278:6704: scene=5B_2
#: 5B_2:278
msgctxt "text_id=6704 | speaker=unknown"
msgid "  The young woman did this not by mixing chemicals into a compound, but by melting down divine providence into a witch's brew."
msgstr "　少女が調合しているものは化学式ではなく、摂理を<融|と>かす魔女の鍋に他ならない。"

#. Occurrence 5B_2:370:6705: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0000; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:370
msgctxt "text_id=6705 | speaker=aoko"
msgid "(...This is bad. I've seen her Ploys, and this one is something completely new.)"
msgstr "“……まずいわね。有珠のプロイは何個か見てきたけど、今回のはケタが違う―――”"

#. Occurrence 5B_2:416:6706: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0001; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:416
msgctxt "text_id=6706 | speaker=aoko"
msgid "\"...<Connecting.|Set.>\""
msgstr "「――――<接続|セット>」"

#. Occurrence 5B_2:435:6707: scene=5B_2
#: 5B_2:435
msgctxt "text_id=6707 | speaker=unknown"
msgid "  Stifling her anxiety, Aoko fired up the crest on her right arm."
msgstr "　不安を押し殺し、青子は右腕の刻印に火をいれる。"

#. Occurrence 5B_2:456:6708: scene=5B_2
#: 5B_2:456
msgctxt "text_id=6708 | speaker=unknown"
msgid "  If Magic Circuits were a mage's engine,"
msgstr "　魔術回路が魔術師の<基|エ><本|ン><性|ジ><能|ン>なら、"

msgctxt "text_id=6709 | speaker=unknown"
msgid "  then their crest was software that assisted their magecraft."
msgstr "　刻印は魔術行使を補助する<演算装置|ソフトウェア>だ。"

#. Occurrence 5B_2:464:6710: scene=5B_2
#: 5B_2:464
msgctxt "text_id=6710 | speaker=unknown"
msgid "  For the fledgling mage Aoko, this was her trump card."
msgstr "　魔術師として半人前の青子を助ける切り札。"

#. Occurrence 5B_2:469:6711: scene=5B_2
#: 5B_2:469
msgctxt "text_id=6711 | speaker=unknown"
msgid "  All she had to do was supply magical energy to her crest-based formula. It may not have been the strongest magecraft, but it was hers; proof that she was the successor of the Aozaki lineage."
msgstr "　刻印化された術式なら魔力を通すだけで……その効能は劣化するにしても……再現できる、蒼崎の後継者の証である。"

#. Occurrence 5B_2:550:6712: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0002; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:550
msgctxt "text_id=6712 | speaker=aoko"
msgid "\"Execute double layer. Direct current to crest.\""
msgstr "「―――行使二層、直流数紋」"

#. Occurrence 5B_2:588:6713: scene=5B_2
#: 5B_2:588
msgctxt "text_id=6713 | speaker=unknown"
msgid "  The pattern of her crest shifted to execute the formula, which then connected to her Magic Circuits."
msgstr "　刻印の紋様を術式再現のカタチに切り替え、自身の魔力回路に繋ぐ。"

#. Occurrence 5B_2:593:6714: scene=5B_2
#: 5B_2:593
msgctxt "text_id=6714 | speaker=unknown"
msgid "  The process resembled trains changing rails, a puzzle involving dozens of circuits."
msgstr "　列車の<路線変更|レールチェンジ>じみた、何十という回路の<形成|パズル>。"

#. Occurrence 5B_2:598:6715: scene=5B_2
#: 5B_2:598
msgctxt "text_id=6715 | speaker=unknown"
msgid "  She constructed it as swiftly as possible without sacrificing the quality of its construction."
msgstr "　それをできるだけ迅速に、可能な限り丁寧に組みたてる。"

#. Occurrence 5B_2:707:6716: scene=5B_2
#: 5B_2:707
msgctxt "text_id=6716 | speaker=unknown"
msgid "  Instant magecraft cast without an incantation would not be enough to reach Alice Kuonji."
msgstr "　<無詠唱|そくせき>の魔術では久遠寺有珠に届かない。"

#. Occurrence 5B_2:712:6717: scene=5B_2
#: 5B_2:712
msgctxt "text_id=6717 | speaker=unknown"
msgid "  Aoko had gauged the strength of Alice's defense with her initial shots."
msgstr "　先の魔弾で有珠を守る防壁の強度は<測|はか>った。"

#. Occurrence 5B_2:717:6718: scene=5B_2
#: 5B_2:717
msgctxt "text_id=6718 | speaker=unknown"
msgid "  She would dial up the power five times the next time, driving twenty tons of force into her target."
msgstr "　今度は先の五倍、二十トンの衝撃を叩きこむ。"

#. Occurrence 5B_2:722:6719: scene=5B_2
#: 5B_2:722
msgctxt "text_id=6719 | speaker=unknown"
msgid "  Alice had the protection of the thick, hanging fog and the dense barrier around her."
msgstr "　漂いだした濃霧の守りと、有珠が常に<纏|まと>っている障壁。"

#. Occurrence 5B_2:727:6720: scene=5B_2
#: 5B_2:727
msgctxt "text_id=6720 | speaker=unknown"
msgid "  However, this attack would be more than enough to pierce through both."
msgstr "　両方合わせても十分に貫通する。"

#. Occurrence 5B_2:786:6721: scene=5B_2
#: 5B_2:786
msgctxt "text_id=6721 | speaker=unknown"
msgid "  If Aoko struck home, it could cave in Alice's chest and end the fight."
msgstr "　なので、当たりどころが悪ければ胸骨が心臓に刺さってノックアウト。"

#. Occurrence 5B_2:791:6722: scene=5B_2
#: 5B_2:791
msgctxt "text_id=6722 | speaker=unknown"
msgid "  At worst, it would at least knock Alice down from her position atop the clock tower."
msgstr "　<最悪|さいあく>でも時計台からは撃ち落とせる、のだが―――"

#. Occurrence 5B_2:808:6723: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_2_0000; voice_prefix=A30; voice_category=3; scene=5B_2
#: 5B_2:808
msgctxt "text_id=6723 | speaker=soujuurou"
msgid "\"Hey, I have a question.\""
msgstr "「あの、そろそろいいかな」"

#. Occurrence 5B_2:814:6724: scene=5B_2
#: 5B_2:814
msgctxt "text_id=6724 | speaker=unknown"
msgid "  As always, there was one guy who spoiled the deadly tension, pulling Aoko out of killer mode."
msgstr "　殺し合いモードに入った緊張感を台無しにする男がひとり。"

#. Occurrence 5B_2:834:6725: scene=5B_2
#: 5B_2:834
msgctxt "text_id=6725 | speaker=unknown"
msgid "  Soujyuro had been looking back and forth between Aoko and Alice in confusion."
msgstr "　さっきから難しい顔で青子と有珠を交互に観察していた草十郎は、"

#. Occurrence 5B_2:846:6726: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_2_0001; voice_prefix=A30; voice_category=3; scene=5B_2
#: 5B_2:846
msgctxt "text_id=6726 | speaker=soujuurou"
msgid "\"What's going on now?\""
msgstr "「それで、どういう話になったんだ？」"

#. Occurrence 5B_2:859:6727: scene=5B_2
#: 5B_2:859
msgctxt "text_id=6727 | speaker=unknown"
msgid "  He said it like he might ask"
msgstr "　駅まではどう行くんですか？"

msgctxt "text_id=6728 | speaker=unknown"
msgid "for directions to the train station."
msgstr "　みたいな質問を口にするのだった。"

#. Occurrence 5B_2:909:6729: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0003; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:909
msgctxt "text_id=6729 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5B_2:914:6730: scene=5B_2
#: 5B_2:914
msgctxt "text_id=6730 | speaker=unknown"
msgid "  Normally, she would have lashed out in response, but his deadly serious tone shocked rather than angered her."
msgstr "　怒鳴り返したいところだが、こう真剣に訊かれると怒るより呆れてしまう。"

#. Occurrence 5B_2:944:6731: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0004; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:944
msgctxt "text_id=6731 | speaker=aoko"
msgid "\"...Unbelievable. Is this my life now?\""
msgstr "“……信じられない。慣れてきた、私……”"

#. Occurrence 5B_2:949:6732: scene=5B_2
#: 5B_2:949
msgctxt "text_id=6732 | speaker=unknown"
msgid "  Aoko swallowed back a sigh and returned her focus to activating her crest."
msgstr "　青子はぐっとため息を飲みこんで、刻印の起動に意識を集中する。"

#. Occurrence 5B_2:1018:6733: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0005; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:1018
msgctxt "text_id=6733 | speaker=aoko"
msgid "\"Negotiations have broken down. I pissed her off a bit too much."
msgstr "「交渉は決裂。ちょっと怒らせすぎた。"

#. Occurrence 5B_2:1024:6734: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0006; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:1024
msgctxt "text_id=6734 | speaker=aoko"
msgid "  From her perspective, this is a good chance to kill me off. Along with the entire theme park, I guess.\""
msgstr "　あの子から見れば、まあいい機会だし、遊園地ごと私を亡きものにしようってハラね」"

#. Occurrence 5B_2:1030:6735: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_2_0002; voice_prefix=A30; voice_category=3; scene=5B_2
#: 5B_2:1030
msgctxt "text_id=6735 | speaker=soujuurou"
msgid "\"???\""
msgstr "「？？？」"

#. Occurrence 5B_2:1035:6736: scene=5B_2
#: 5B_2:1035
msgctxt "text_id=6736 | speaker=unknown"
msgid "  Soujyuro tilted his head, as if begging for a simpler explanation."
msgstr "　もっと簡単な言い回しプリーズ、と首をかしげる草十郎。"

#. Occurrence 5B_2:1090:6737: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0007; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:1090
msgctxt "text_id=6737 | speaker=aoko"
msgid "\"She's really got it in for me. I can't even imagine what sort of death she has in store if she catches me."
msgstr "「私、わりとあの子に恨まれてるから。捕まったが最後、どんな風に殺されるか想像すらできないわ。"

#. Occurrence 5B_2:1102:6738: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0008; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:1102
msgctxt "text_id=6738 | speaker=aoko"
msgid "  ...What I'm saying is, neither of us are getting out of this alive unless we do something about her.\""
msgstr "　……要するに、アンタも私も、あの子をどうにかしないと生きて帰れないってコトよ」"

#. Occurrence 5B_2:1183:6739: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_2_0003; voice_prefix=A30; voice_category=3; scene=5B_2
#: 5B_2:1183
msgctxt "text_id=6739 | speaker=soujuurou"
msgid "\"So you're saying I got dragged into your quarrel!?\""
msgstr "「そんな、とばっちりだ！」"

#. Occurrence 5B_2:1283:6740: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0009; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:1283
msgctxt "text_id=6740 | speaker=aoko"
msgid "\"Pretty much!\""
msgstr "「まあ―――そういう事になるかもね！」"

#. Occurrence 5B_2:1377:6741: scene=5B_2
#: 5B_2:1377
msgctxt "text_id=6741 | speaker=unknown"
msgid "  As Soujyuro protested in a tone wholly inappropriate to the situation, Aoko let another blast rip from her right arm."
msgstr "　この期におよんで空気読めていない草十郎の叫びに、青子は渾身の右腕を放つ。"

#. Occurrence 5B_2:1382:6742: scene=5B_2
#: 5B_2:1382
msgctxt "text_id=6742 | speaker=unknown"
msgid "  She was not aiming at Soujyuro, though."
msgstr "　狙いは草十郎ではない。"

#. Occurrence 5B_2:1387:6743: scene=5B_2
#: 5B_2:1387
msgctxt "text_id=6743 | speaker=unknown"
msgid "  A little earlier in the day and Aoko would have been happy to do exactly that, but now, her attention was focused on the girl in black atop the clock tower."
msgstr "　ちょっと前までの青子なら草十郎へ掃射していた気配濃厚だが、今は時計台に立つ黒衣の少女が優先される―――！"

#. Occurrence 5B_2:1713:6744: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0010; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:1713
msgctxt "text_id=6744 | speaker=aoko"
msgid "\"!?!?!?\""
msgstr "「っ―――！！！？」"

#. Occurrence 5B_2:1719:6745: scene=5B_2
#: 5B_2:1719
msgctxt "text_id=6745 | speaker=unknown"
msgid "  Aoko's mind struggled to catch up to her astonishment."
msgstr "　あまりの驚きに状況把握が間に合わない。"

#. Occurrence 5B_2:1724:6746: scene=5B_2
#: 5B_2:1724
msgctxt "text_id=6746 | speaker=unknown"
msgid "  She had fired the strongest, fastest magic bullet she had the ability to conjure, and Alice blocked it."
msgstr "　現状で考えられる最速／最高威力の魔弾を防がれた。"

#. Occurrence 5B_2:1729:6747: scene=5B_2
#: 5B_2:1729
msgctxt "text_id=6747 | speaker=unknown"
msgid "  That much was to be expected;"
msgstr "　それはいい。"

#. Occurrence 5B_2:1734:6748: scene=5B_2
#: 5B_2:1734
msgctxt "text_id=6748 | speaker=unknown"
msgid "  when Alice set her mind to defending herself, such an attack was child's play."
msgstr "　有珠が本気で防御に徹すればそれぐらいはするだろう。"

#. Occurrence 5B_2:1807:6749: scene=5B_2
#: 5B_2:1807
msgctxt "text_id=6749 | speaker=unknown"
msgid "  But what just happened?"
msgstr "　だが今のは何事か。"

#. Occurrence 5B_2:1812:6750: scene=5B_2
#: 5B_2:1812
msgctxt "text_id=6750 | speaker=unknown"
msgid "  Something Aoko had never seen before leapt to Alice's defense."
msgstr "　何か得体の知れないものが飛んできて有珠を守った。"

#. Occurrence 5B_2:1817:6751: scene=5B_2
#: 5B_2:1817
msgctxt "text_id=6751 | speaker=unknown"
msgid "  A team of horses? A plague of locusts? No―those existed in the real world, unlike what Aoko had just witnessed."
msgstr "　馬？バッタ？いや、そもそもあんな生き物はこの世には存在しない。"

#. Occurrence 5B_2:1822:6752: scene=5B_2
#: 5B_2:1822
msgctxt "text_id=6752 | speaker=unknown"
msgid "  Normal creatures could not form like a spontaneous cloud of fog and then dissipate just as quickly into the night sky."
msgstr "　あんな風に―――雲霞のように群をなして、夜空を埋め尽くしたりはしない。"

#. Occurrence 5B_2:2151:6753: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0011; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:2151
msgctxt "text_id=6753 | speaker=aoko"
msgid "\"What...?\""
msgstr "「な―――」"

#. Occurrence 5B_2:2247:6754: scene=5B_2
#: 5B_2:2247
msgctxt "text_id=6754 | speaker=unknown"
msgid "  Impossible things moved in impossible ways."
msgstr "　あり得ないものが、あり得ないカタチで動き出す。"

#. Occurrence 5B_2:2252:6755: scene=5B_2
#: 5B_2:2252
msgctxt "text_id=6755 | speaker=unknown"
msgid "  Alice was not even supplying them with any power source."
msgstr "　少女は彼らに電源など与えていない。"

#. Occurrence 5B_2:2257:6756: scene=5B_2
#: 5B_2:2257
msgctxt "text_id=6756 | speaker=unknown"
msgid "  Those things never needed power in the first place."
msgstr "　そも必要としていない。"

#. Occurrence 5B_2:2262:6757: scene=5B_2
#: 5B_2:2262
msgctxt "text_id=6757 | speaker=unknown"
msgid "  Those broken and discarded things did not follow the rules of mankind."
msgstr "　壊れ、<棄|す>てられた彼らは、もう人間の<法則|ルール>には従わない。"

#. Occurrence 5B_2:2445:6758: scene=5B_2
#: 5B_2:2445
msgctxt "text_id=6758 | speaker=unknown"
msgid "  This was an invasion of fairy tales."
msgstr "　それは、おとぎ話の侵略だった。"

#. Occurrence 5B_2:2450:6759: scene=5B_2
#: 5B_2:2450
msgctxt "text_id=6759 | speaker=unknown"
msgid "  Compared to them, the automaton looked merciful."
msgstr "　<自動人形|オートマタ>なぞ優しいものだ。"

#. Occurrence 5B_2:2455:6760: scene=5B_2
#: 5B_2:2455
msgctxt "text_id=6760 | speaker=unknown"
msgid "  Autonomous puppets were products of magecraft, but even then they behaved as puppets should."
msgstr "　自律する人形は魔術の<業|わざ>によるものだが、それでも、人形としてのあり方を守っていた。"

#. Occurrence 5B_2:2460:6761: scene=5B_2
#: 5B_2:2460
msgctxt "text_id=6761 | speaker=unknown"
msgid "  These newly animated things, however, were nothing of the sort."
msgstr "　だが―――動きだし、新たな命を得た<彼|・><ら|・>は、もう人形ですらない。"

#. Occurrence 5B_2:2513:6762: scene=5B_2
#: 5B_2:2513
msgctxt "text_id=6762 | speaker=unknown"
msgid "  Empty vessels became living creatures―"
msgstr "　器物が生物に、"

#. Occurrence 5B_2:2518:6763: scene=5B_2
#: 5B_2:2518
msgctxt "text_id=6763 | speaker=unknown"
msgid "  dummies warped into malformed beings."
msgstr "　模型が畸形に変貌する。"

#. Occurrence 5B_2:2523:6764: scene=5B_2
#: 5B_2:2523
msgctxt "text_id=6764 | speaker=unknown"
msgid "  There was a fog so dense with magical energy it visibly spread to all corners of the park,"
msgstr "　広がりつつあるのは視覚化できるほど濃密な魔力の霧と、"

#. Occurrence 5B_2:2528:6765: scene=5B_2
#: 5B_2:2528
msgctxt "text_id=6765 | speaker=unknown"
msgid "  bringing with it a monstrous welcoming party that easily numbered over a thousand."
msgstr "　入園者を歓迎する、千を超える<怪物|クリーチャー>たち……！"

#. Occurrence 5B_2:2570:6766: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0012; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:2570
msgctxt "text_id=6766 | speaker=aoko"
msgid "\"...!!!\""
msgstr "「っ、―――！！！！」"

#. Occurrence 5B_2:2602:6767: scene=5B_2
#: 5B_2:2602
msgctxt "text_id=6767 | speaker=unknown"
msgid "  Spurred on by the shuddering sensation running down her spine, Aoko fired a barrage of single-action magic bullets."
msgstr "　背中を走る戦慄につき動かされ、青子は一工程の魔弾を掃射する。"

#. Occurrence 5B_2:2743:6768: scene=5B_2
#: 5B_2:2743
msgctxt "text_id=6768 | speaker=unknown"
msgid "  Her impulsive attack scattered futilely."
msgstr "　無我夢中の攻撃は無様に散った。"

#. Occurrence 5B_2:2818:6769: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0013; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:2818
msgctxt "text_id=6769 | speaker=aoko"
msgid "\"Ah!\""
msgstr "「あ―――」"

#. Occurrence 5B_2:2823:6770: scene=5B_2
#: 5B_2:2823
msgctxt "text_id=6770 | speaker=unknown"
msgid "  The knights of the merry-go-round soared into the sky."
msgstr "　メリーゴーラウンドの騎士は空を飛び、"

#. Occurrence 5B_2:2828:6771: scene=5B_2
#: 5B_2:2828
msgctxt "text_id=6771 | speaker=unknown"
msgid "  Green, fire-breathing lizards flocked."
msgstr "　<緑|みどり>トカゲは火を吹きながら集まりだす。"

#. Occurrence 5B_2:2833:6772: scene=5B_2
#: 5B_2:2833
msgctxt "text_id=6772 | speaker=unknown"
msgid "  The bakeries opened their doors once again, and human-sized loaves of fresh bread marched from their ovens as platoons of newly-baked soldiers."
msgstr "　焼きたてべーカリーは経営を再開し、オーブンからは人間大の焼きたてパンが小隊を組んで進軍する。"

#. Occurrence 5B_2:2885:6773: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_2_0004; voice_prefix=A30; voice_category=3; scene=5B_2
#: 5B_2:2885
msgctxt "text_id=6773 | speaker=soujuurou"
msgid "\"...Aozaki, behind you!\""
msgstr "「―――蒼崎、後ろ！」"

#. Occurrence 5B_2:2891:6774: scene=5B_2
#: 5B_2:2891
msgctxt "text_id=6774 | speaker=unknown"
msgid "  Aoko and Soujyuro were completely surrounded."
msgstr "　青子と草十郎は包囲されつつあった。"

#. Occurrence 5B_2:2896:6775: scene=5B_2
#: 5B_2:2896
msgctxt "text_id=6775 | speaker=unknown"
msgid "  The Ferris wheel creaked as it gently turned."
msgstr "　軋みをあげてゆっくりとまわる観覧車。"

#. Occurrence 5B_2:2901:6776: scene=5B_2
#: 5B_2:2901
msgctxt "text_id=6776 | speaker=unknown"
msgid "  A rickety train car raced about the roller coaster tracks with Kitsy, tears streaming down its face, aboard."
msgstr "　涙に濡れたキッツィーを乗せて、ガラクタの車両がコースターを走っていく。"

#. Occurrence 5B_2:2971:6777: scene=5B_2
#: 5B_2:2971
msgctxt "text_id=6777 | speaker=unknown"
msgid "  It was a grossly twisted fantasy."
msgstr "　あまりにも歪んだ幻想。"

#. Occurrence 5B_2:2976:6778: scene=5B_2
#: 5B_2:2976
msgctxt "text_id=6778 | speaker=unknown"
msgid "  The girl in black reigned over the insanity-fueled park."
msgstr "　赤く回りだした遊園地を背に、黒衣の少女は君臨する。"

#. Occurrence 5B_2:3028:6779: scene=5B_2
#: 5B_2:3028
msgctxt "text_id=6779 | speaker=unknown"
msgid "  Oh, now we're screwed."
msgstr "　ああ、これはない。"

#. Occurrence 5B_2:3033:6780: scene=5B_2
#: 5B_2:3033
msgctxt "text_id=6780 | speaker=unknown"
msgid "  Aoko was transfixed by the scene unfolding around her. Then, she realized what was happening."
msgstr "　これはないわ、と忘我しながら、青子はこの現象が何であるかに当たりをつけた。"

#. Occurrence 5B_2:3066:6781: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0014; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:3066
msgctxt "text_id=6781 | speaker=aoko"
msgid "\"...Oh, I know what this is.\""
msgstr "「―――そうだ、これは」"

#. Occurrence 5B_2:3072:6782: scene=5B_2
#: 5B_2:3072
msgctxt "text_id=6782 | speaker=unknown"
msgid "  Alice had once told her of Meinster's familiars."
msgstr "　有珠に聞いたマインスターの使い魔たち。"

#. Occurrence 5B_2:3077:6783: scene=5B_2
#: 5B_2:3077
msgctxt "text_id=6783 | speaker=unknown"
msgid "  Among them were three of particular notoriety, one of which she recalled being capable of something similar to this."
msgstr "　その中でも三本指に入る折り紙付きの使い魔が、これと似た出来事を起こすハズだ。"

#. Occurrence 5B_2:3082:6784: scene=5B_2
#: 5B_2:3082
msgctxt "text_id=6784 | speaker=unknown"
msgid "  And it was called..."
msgstr "　名前は、たしか―――"

#. Occurrence 5B_2:3104:6785: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0015; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:3104
msgctxt "text_id=6785 | speaker=aoko"
msgid "\"Ploy Kickshaw... Flat Snark!\""
msgstr "「<童話の怪物|プロイキッシャー>、フラットスナーク……！」"

#. Occurrence 5B_2:3140:6786: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_2_0005; voice_prefix=A30; voice_category=3; scene=5B_2
#: 5B_2:3140
msgctxt "text_id=6786 | speaker=soujuurou"
msgid "\"Seriously, Aozaki! Behind you!\""
msgstr "「蒼崎、だから後ろ！」"

#. Occurrence 5B_2:3241:6787: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0016; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:3241
msgctxt "text_id=6787 | speaker=aoko"
msgid "\"...!\""
msgstr "「―――！」"

#. Occurrence 5B_2:3301:6788: scene=5B_2
#: 5B_2:3301
msgctxt "text_id=6788 | speaker=unknown"
msgid "  Struck by Aoko's bullets, the creatures exploded into splinters."
msgstr "　青い魔弾を受け、木っ端微塵に砕け散るクリーチャー。"

#. Occurrence 5B_2:3306:6789: scene=5B_2
#: 5B_2:3306
msgctxt "text_id=6789 | speaker=unknown"
msgid "  It was clear Aoko's shots were becoming more powerful, but it was also the case that these beings were less robust than your average automata."
msgstr "　青子の魔弾の威力があがっている、というのもあるが、一体一体は自動人形ほど頑丈ではないようだ。"

#. Occurrence 5B_2:3360:6790: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0017; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:3360
msgctxt "text_id=6790 | speaker=aoko"
msgid "\"Sizuki, this way!\""
msgstr "「静希君、こっち！」"

#. Occurrence 5B_2:3366:6791: scene=5B_2
#: 5B_2:3366
msgctxt "text_id=6791 | speaker=unknown"
msgid "  Aoko turned away from the clock tower, grabbed his hand, and began to run."
msgstr "　青子は時計台に背を向けて、草十郎の手をとって走りだす。"

#. Occurrence 5B_2:3446:6792: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_2_0006; voice_prefix=A30; voice_category=3; scene=5B_2
#: 5B_2:3446
msgctxt "text_id=6792 | speaker=soujuurou"
msgid "\"Wait, Aozaki?!\""
msgstr "「ちょっ、蒼崎！？」"

#. Occurrence 5B_2:3452:6793: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0018; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:3452
msgctxt "text_id=6793 | speaker=aoko"
msgid "\"Sorry, no time!"
msgstr "「ごめん、これ無理！"

#. Occurrence 5B_2:3459:6794: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0019; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:3459
msgctxt "text_id=6794 | speaker=aoko"
msgid "  We're running!\""
msgstr "　逃げるわよ！」"

#. Occurrence 5B_2:3465:6795: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_2_0007; voice_prefix=A30; voice_category=3; scene=5B_2
#: 5B_2:3465
msgctxt "text_id=6795 | speaker=soujuurou"
msgid "\"Running? To where?!\""
msgstr "「逃げるってどこに！？」"

#. Occurrence 5B_2:3471:6796: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0020; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:3471
msgctxt "text_id=6796 | speaker=aoko"
msgid "\"It doesn't matter! Anywhere!\""
msgstr "「どこって、とにかく行けるところまで……！」"

#. Occurrence 5B_2:3555:6797: scene=5B_2
#: 5B_2:3555
msgctxt "text_id=6797 | speaker=unknown"
msgid "  She shouted as though trying to persuade herself as she valiantly cleared a path."
msgstr "　自分に言い聞かせるように叫んで、青子は気合いで道を<拓|ひら>く。"

#. Occurrence 5B_2:3560:6798: scene=5B_2
#: 5B_2:3560
msgctxt "text_id=6798 | speaker=unknown"
msgid "  Aoko's magic bullets flew like a scream."
msgstr "　放たれる魔弾は悲鳴そのものだ。"

#. Occurrence 5B_2:3565:6799: scene=5B_2
#: 5B_2:3565
msgctxt "text_id=6799 | speaker=unknown"
msgid "  Blowing away the creatures that blocked―or simply gathered around―their path, she made a hole for them to escape through."
msgstr "　立ちふさがる……というより、ただ集まっていただけのクリーチャーたちを吹き飛ばし、ふたりは包囲網を抜けだした。"

#. Occurrence 5B_3:365:6800: scene=5B_3
#: 5B_3:365
msgctxt "text_id=6800 | speaker=unknown"
msgid "  Magical bullets exploded like blue fireworks."
msgstr "　青い火花を散らす魔弾。"

#. Occurrence 5B_3:406:6801: scene=5B_3
#: 5B_3:406
msgctxt "text_id=6801 | speaker=unknown"
msgid "  Aoko and Soujyuro ran down the bumpy brick road."
msgstr "　波うつレンガの道を青子たちはひた走る。"

#. Occurrence 5B_3:411:6802: scene=5B_3
#: 5B_3:411
msgctxt "text_id=6802 | speaker=unknown"
msgid "  Their bond, forged in the heat of battle, went far beyond mutual convenience."
msgstr "　つり橋効果を遥かに超える戦場での信頼感。"

#. Occurrence 5B_3:416:6803: scene=5B_3
#: 5B_3:416
msgctxt "text_id=6803 | speaker=unknown"
msgid "  They headed for the park's exit at full speed without exchanging a word or a look."
msgstr "　ふたりは全速力で、さしたる会話もアイコンタクトもなく、遊園地の出口を目指す。"

#. Occurrence 5B_3:421:6804: scene=5B_3
#: 5B_3:421
msgctxt "text_id=6804 | speaker=unknown"
msgid "  The weirdness only extended as far as the park border,"
msgstr "　この異常は遊園地の中だけのこと。"

#. Occurrence 5B_3:426:6805: scene=5B_3
#: 5B_3:426
msgctxt "text_id=6805 | speaker=unknown"
msgid "  so they would be safe as long as they made it outside."
msgstr "　なら、外に出てしまえば助かるだろうと。"

#. Occurrence 5B_3:476:6806: scene=5B_3
#: 5B_3:476
msgctxt "text_id=6806 | speaker=unknown"
msgid "  But..."
msgstr "　が。"

#. Occurrence 5B_3:481:6807: scene=5B_3
#: 5B_3:481
msgctxt "text_id=6807 | speaker=unknown"
msgid "  Speaking in pure numbers, the difference in strength was two versus an army."
msgstr "　戦力差、数にして二人対数百人。"

#. Occurrence 5B_3:486:6808: scene=5B_3
#: 5B_3:486
msgctxt "text_id=6808 | speaker=unknown"
msgid "  Or rather, one versus an army."
msgstr "　もとい、一人対数百体。"

#. Occurrence 5B_3:491:6809: scene=5B_3
#: 5B_3:491
msgctxt "text_id=6809 | speaker=unknown"
msgid "  Soujyuro was hardly useful in this situation,"
msgstr "　草十郎はほとんど使い物にならないし、"

#. Occurrence 5B_3:491:6810: scene=5B_3
#: 5B_3:491
msgctxt "text_id=6810 | speaker=unknown"
msgid "  and \"man\"-power wasn't really the issue here, since they were facing puppets."
msgstr "　襲いかかってくるのは人というより<人形|パペット>である。"

#. Occurrence 5B_3:543:6811: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0000; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:543
msgctxt "text_id=6811 | speaker=aoko"
msgid "\"You okay!?"
msgstr "「さっきの大丈夫！？"

#. Occurrence 5B_3:543:6812: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0000; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:543
msgctxt "text_id=6812 | speaker=aoko"
msgid "  Those were some giant pincers back there!\""
msgstr "　上からこう、でっかいハサミが落ちてきたけど！」"

#. Occurrence 5B_3:549:6813: scene=5B_3
#: 5B_3:549
msgctxt "text_id=6813 | speaker=unknown"
msgid "  Aoko shouted as she blasted away the monsters that stood in their path."
msgstr "　立ちふさがる怪物を撃ち砕きながら青子が叫ぶ。"

#. Occurrence 5B_3:554:6814: scene=5B_3
#: 5B_3:554
msgctxt "text_id=6814 | speaker=unknown"
msgid "  There was no time to stop for breath, or even to look back."
msgstr "　振り向く余裕も、立ち止まっている暇もない。"

#. Occurrence 5B_3:585:6815: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_3_0000; voice_prefix=A30; voice_category=3; scene=5B_3
#: 5B_3:585
msgctxt "text_id=6815 | speaker=soujuurou"
msgid "\"Yeah, just barely!\""
msgstr "「なんとか、ギリギリ！」"

#. Occurrence 5B_3:591:6816: scene=5B_3
#: 5B_3:591
msgctxt "text_id=6816 | speaker=unknown"
msgid "  As Soujyuro pursued, his voice, too, had naturally become shrill."
msgstr "　青子を追う草十郎も、さすがに声がうわずっている。"

#. Occurrence 5B_3:691:6817: scene=5B_3
#: 5B_3:691
msgctxt "text_id=6817 | speaker=unknown"
msgid "  ...Five minutes earlier."
msgstr "　―――さかのぼること五分前。"

#. Occurrence 5B_3:697:6818: scene=5B_3
#: 5B_3:697
msgctxt "text_id=6818 | speaker=unknown"
msgid "  They had broken out of the siege at the plaza surprisingly fast."
msgstr "　広場の包囲網からは呆気なく抜け出せた。"

#. Occurrence 5B_3:702:6819: scene=5B_3
#: 5B_3:702
msgctxt "text_id=6819 | speaker=unknown"
msgid "  It seemed that the residents' awakening differed case-by-case, with larger creatures taking additional time."
msgstr "　住人たちの“目覚め”には個体差があって、大きなものほど動きだすには時間が必要らしい。"

#. Occurrence 5B_3:772:6820: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0001; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:772
msgctxt "text_id=6820 | speaker=aoko"
msgid "\"We're lucky they're not the morning type!\""
msgstr "「ラッキー、朝に弱いタイプばっかとみた！」"

#. Occurrence 5B_3:778:6821: scene=5B_3
#: 5B_3:778
msgctxt "text_id=6821 | speaker=unknown"
msgid "  Aoko joked as she mowed down the small fry that popped up."
msgstr "　青子は軽口を言って、ひょっこり現れたザコをなぎ払う。"

#. Occurrence 5B_3:799:6822: scene=5B_3
#: 5B_3:799
msgctxt "text_id=6822 | speaker=unknown"
msgid "  But then."
msgstr "　そんな時。"

#. Occurrence 5B_3:825:6823: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0002; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:825
msgctxt "text_id=6823 | speaker=aoko"
msgid "\"Eh?\""
msgstr "「へ？」"

#. Occurrence 5B_3:830:6824: scene=5B_3
#: 5B_3:830
msgctxt "text_id=6824 | speaker=unknown"
msgid "  Without warning, something outrageous extended its way down from above them."
msgstr "　突如、ふたりの頭上にとんでもないモノが伸びてきた。"

#. Occurrence 5B_3:1002:6825: scene=5B_3
#: 5B_3:1002
msgctxt "text_id=6825 | speaker=unknown"
msgid "  It was the claws of the sixty-foot lobster adorning the roof of a seafood restaurant."
msgstr "　ロブスター<専門店|レストラン>の屋根に鎮座していた、全長18メートルのザリガニ、そのハサミである。"

#. Occurrence 5B_3:1122:6826: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0003; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:1122
msgctxt "text_id=6826 | speaker=aoko"
msgid "\"...!\""
msgstr "「…………！」"

#. Occurrence 5B_3:1127:6827: scene=5B_3
#: 5B_3:1127
msgctxt "text_id=6827 | speaker=unknown"
msgid "  Its pincers were like a guillotine."
msgstr "　ほとんどギロチンのようなハサミだった。"

#. Occurrence 5B_3:1132:6828: scene=5B_3
#: 5B_3:1132
msgctxt "text_id=6828 | speaker=unknown"
msgid "  As Aoko and Soujyuro cut across the front of the restaurant, the red king pressed in at tremendous speed, keen on splitting them each in two."
msgstr "　レストラン前を横切る青子たちを、凄まじいスピードでまっ二つにしようと迫る<赤い甲殻類|レッドキング>。"

#. Occurrence 5B_3:1205:6829: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0004; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:1205
msgctxt "text_id=6829 | speaker=aoko"
msgid "\"Sizuki, hard about! This way's no good!\""
msgstr "「静希君、ユーターン！　こっちはダメ！」"

#. Occurrence 5B_3:1211:6830: scene=5B_3
#: 5B_3:1211
msgctxt "text_id=6830 | speaker=unknown"
msgid "  The gate was just on the other side of the restaurant, but they had to take the long way around in order to lose the giant lobster snapping at their heels."
msgstr "　ロブスター店を抜ければすぐに<正門|ゲート>だったが、ふたりは巨大ザリガニから逃れるように遠回りをする。"

#. Occurrence 5B_3:1216:6831: scene=5B_3
#: 5B_3:1216
msgctxt "text_id=6831 | speaker=unknown"
msgid "  Waiting along their detour had been a horde of monsters, too many to count."
msgstr "　そうして迂回した先に待ち受けていたのは、おびただしいまでの怪物の群だった。"

#. Occurrence 5B_3:1263:6832: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_3_0001; voice_prefix=A30; voice_category=3; scene=5B_3
#: 5B_3:1263
msgctxt "text_id=6832 | speaker=soujuurou"
msgid "\"Yeah, just barely!\""
msgstr "「なんとか、ギリギリ！」"

#. Occurrence 5B_3:1303:6833: scene=5B_3
#: 5B_3:1303
msgctxt "text_id=6833 | speaker=unknown"
msgid "  Soujyuro called out in response, recalling just how narrowly he had avoided his head being severed clean from his body."
msgstr "　あやうく首からすっぱり切られそうだったピンチを思いだしながら、草十郎は青子に叫び返す。"

#. Occurrence 5B_3:1355:6834: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_3_0002; voice_prefix=A30; voice_category=3; scene=5B_3
#: 5B_3:1355
msgctxt "text_id=6834 | speaker=soujuurou"
msgid "\"In front of us! What the heck are those? Are they freshly baked!?\""
msgstr "「って前！　うわ、なんだあれ、焼きたてか！？」"

#. Occurrence 5B_3:1361:6835: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0005; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:1361
msgctxt "text_id=6835 | speaker=aoko"
msgid "\"It looks like it! In other words, they're the cannon fodder!\""
msgstr "「そうみたいね、要するに下級兵士よ！」"

#. Occurrence 5B_3:1421:6836: scene=5B_3
#: 5B_3:1421
msgctxt "text_id=6836 | speaker=unknown"
msgid "  Aoko halted her sprint and set her crest into full operation."
msgstr "　青子は駆け足を止めて魔術刻印をフル回転させる。"

#. Occurrence 5B_3:1428:6837: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0006; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:1428
msgctxt "text_id=6837 | speaker=aoko"
msgid "(Range: seven, six, five yards...!"
msgstr "“距離七、六、五メートル……！"

msgctxt "text_id=6838 | speaker=unknown"
msgid "  At this distance, Snap'll take them down!)"
msgstr "　あの程度ならスナップだけで事足りる……！”"

#. Occurrence 5B_3:1523:6839: scene=5B_3
#: 5B_3:1523
msgctxt "text_id=6839 | speaker=unknown"
msgid "  Sliding along the brick path, she brandished her right arm."
msgstr "　レンガの道を滑りながら右腕を一閃する。"

#. Occurrence 5B_3:1528:6840: scene=5B_3
#: 5B_3:1528
msgctxt "text_id=6840 | speaker=unknown"
msgid "  She loosed a shower of magic bullets."
msgstr "　放たれる魔弾の雨。"

#. Occurrence 5B_3:1571:6841: scene=5B_3
#: 5B_3:1571
msgctxt "text_id=6841 | speaker=unknown"
msgid "  Snap was a single-action spell that favored rate of fire over power, and it mowed down the monsters with satisfying pops."
msgstr "　威力より弾数を優先した<一工程|スナップ>は、立ちふさがる怪物たちを小気味良くまき散らかす。"

#. Occurrence 5B_3:1625:6842: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_3_0003; voice_prefix=A30; voice_category=3; scene=5B_3
#: 5B_3:1625
msgctxt "text_id=6842 | speaker=soujuurou"
msgid "\"...Aozaki, more over there!\""
msgstr "「―――蒼崎、そっちも！」"

#. Occurrence 5B_3:1705:6843: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0007; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:1705
msgctxt "text_id=6843 | speaker=aoko"
msgid "\"Roger that!\""
msgstr "「了解……！」"

#. Occurrence 5B_3:1862:6844: scene=5B_3
#: 5B_3:1862
msgctxt "text_id=6844 | speaker=unknown"
msgid "  Blue explosions bloomed along the lamp-lit promenade."
msgstr "　電飾のついた遊歩道に、青い火花が咲き乱れる。"

#. Occurrence 5B_3:1867:6845: scene=5B_3
#: 5B_3:1867
msgctxt "text_id=6845 | speaker=unknown"
msgid "  Aoko's curtain of fire fanned out―it was a marvelous Starmine fireworks show."
msgstr "　扇状に弾幕をはる青子の姿は、空から<俯瞰|ふかん>すれば美しいスターマインそのものだ。"

#. Occurrence 5B_3:1872:6846: scene=5B_3
#: 5B_3:1872
msgctxt "text_id=6846 | speaker=unknown"
msgid "  The toy bread-men turned to charcoal."
msgstr "　焼きたてパンの<遊び道具|レイカンファー>、ブレッドマンではそれこそ消し<炭|ずみ>にされるだけ。"

#. Occurrence 5B_3:1954:6847: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0008; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:1954
msgctxt "text_id=6847 | speaker=aoko"
msgid "(We can do this! They've got us overpowered in numbers, but at this rate we'll be able to get out of here!)"
msgstr "“いける―――数でこそ押されてるけど、この状態が続くなら逃げきれる―――！”"

#. Occurrence 5B_3:1969:6848: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0009; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:1969
msgctxt "text_id=6848 | speaker=aoko"
msgid "\"Sizuki, how's it look over there!?\""
msgstr "「静希君、そっちは！？」"

#. Occurrence 5B_3:2020:6849: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_3_0004; voice_prefix=A30; voice_category=3; scene=5B_3
#: 5B_3:2020
msgctxt "text_id=6849 | speaker=soujuurou"
msgid "\"Looks clear to me! We should be able to approach the exit from the east!\""
msgstr "「いない、空いてる！　ここからなら入り口の東側に出られるはずだ！」"

#. Occurrence 5B_3:2098:6850: scene=5B_3
#: 5B_3:2098
msgctxt "text_id=6850 | speaker=unknown"
msgid "  With a magical barrage that would leave an average spellcaster blue in the face, the novice mage broke through the siege."
msgstr "　並の魔術師なら息切れをする数の魔弾を放ちながら、新米魔術師は敵の囲みを突破する。"

#. Occurrence 5B_3:2105:6851: scene=5B_3
#: 5B_3:2105
msgctxt "text_id=6851 | speaker=unknown"
msgid "  Meanwhile..."
msgstr "　……一方。"

#. Occurrence 5B_3:2110:6852: scene=5B_3
#: 5B_3:2110
msgctxt "text_id=6852 | speaker=unknown"
msgid "  A single bird keenly watched everything unfold."
msgstr "　そんな光景を、じっくりと観察する鳥が一羽。"

#. Occurrence 5B_4:119:6853: scene=5B_4
#: 5B_4:119
msgctxt "text_id=6853 | speaker=unknown"
msgid "  Chirp, cheep-cheep-cheep, chirp!"
msgstr "　チ、チチチ、チ！"

#. Occurrence 5B_4:124:6854: scene=5B_4
#: 5B_4:124
msgctxt "text_id=6854 | speaker=unknown"
msgid "  The moment the blue bird descended into its master's field of vision, it made its high-pitched call."
msgstr "　高度を落として主人の視界に入るなり、かん高く鳴く青い鳥。"

#. Occurrence 5B_4:129:6855: scene=5B_4
#: 5B_4:129
msgctxt "text_id=6855 | speaker=unknown"
msgid "  The girl listened expressionlessly to the report."
msgstr "　その報告を、少女は無表情で聞いている。"

#. Occurrence 5B_4:150:6856: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_4_0000; voice_prefix=A40; voice_category=2; scene=5B_4
#: 5B_4:150
msgctxt "text_id=6856 | speaker=alice"
msgid "\"...No matter. Everything is going as expected."
msgstr "「……かまわないわ、予想通りよ。"

#. Occurrence 5B_4:156:6857: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_4_0001; voice_prefix=A40; voice_category=2; scene=5B_4
#: 5B_4:156
msgctxt "text_id=6857 | speaker=alice"
msgid "  Even if she only knows how to shoot and destroy, the way Aoko uses magical energy is extraordinary. Hastily formed familiars are no match for her.\""
msgstr "　撃つ事、壊す事しか能がなくても、青子の魔力の使い方は並じゃないから。急造の使い魔じゃ、まだ相手にはならないでしょう」"

#. Occurrence 5B_4:178:6858: scene=5B_4
#: 5B_4:178
msgctxt "text_id=6858 | speaker=unknown"
msgid "  The robin flapped its wings as it tweeted in response."
msgstr "　チチチ、と羽をすくめる駒鳥。"

#. Occurrence 5B_4:183:6859: scene=5B_4
#: 5B_4:183
msgctxt "text_id=6859 | speaker=unknown"
msgid "  Perhaps it was criticizing Alice for complimenting Aoko."
msgstr "　青子を<誉|ほ>める有珠を批難しているのか、"

#. Occurrence 5B_4:188:6860: scene=5B_4
#: 5B_4:188
msgctxt "text_id=6860 | speaker=unknown"
msgid "  Or, perhaps it was jealous of Aoko for being praised by Alice."
msgstr "　有珠に誉められる青子に嫉妬しているのか。"

#. Occurrence 5B_4:193:6861: scene=5B_4
#: 5B_4:193
msgctxt "text_id=6861 | speaker=unknown"
msgid "  Alice could barely make sense of its chirping rant."
msgstr "　主人である有珠にも、いまいち読み取れない鳴き声である。"

#. Occurrence 5B_4:297:6862: scene=5B_4
#: 5B_4:297
msgctxt "text_id=6862 | speaker=unknown"
msgid "  Aoko Aozaki was a novice mage."
msgstr "　蒼崎青子は半人前の魔術師だ。"

#. Occurrence 5B_4:302:6863: scene=5B_4
#: 5B_4:302
msgctxt "text_id=6863 | speaker=unknown"
msgid "  Until just two years ago, she had grown up with no background in magecraft. Compared to Alice, who was raised as a witch from birth, Aoko possessed far less talent and experience."
msgstr "　二年前まで魔術とは無関係に育ってきた少女で、生まれた時から魔女として育った有珠とは素質も経験も違いすぎる。"

#. Occurrence 5B_4:307:6864: scene=5B_4
#: 5B_4:307
msgctxt "text_id=6864 | speaker=unknown"
msgid "  There was simply no comparison to be made―"
msgstr "　本来なら相手にすらしない次元。"

#. Occurrence 5B_4:312:6865: scene=5B_4
#: 5B_4:312
msgctxt "text_id=6865 | speaker=unknown"
msgid "  in a contest of skills in magecraft, ten times out of ten, Alice would be declared the victor."
msgstr "　魔術の腕を競うなら十回中十回、有珠に軍配があがるだろう。"

#. Occurrence 5B_4:332:6866: scene=5B_4
#: 5B_4:332
msgctxt "text_id=6866 | speaker=unknown"
msgid "  However, that narrative changed when it came to a battle for life-or-death."
msgstr "　けれど、こと戦い、殺し合いなら話は別だ。"

#. Occurrence 5B_4:337:6867: scene=5B_4
#: 5B_4:337
msgctxt "text_id=6867 | speaker=unknown"
msgid "  Alice Kuonji was not the type of mage suited to combat,"
msgstr "　久遠寺有珠は戦闘向きの魔術師ではなく、"

#. Occurrence 5B_4:342:6868: scene=5B_4
#: 5B_4:342
msgctxt "text_id=6868 | speaker=unknown"
msgid "  while Aoko Aozaki, on the other hand, was built for it."
msgstr "　蒼崎青子は戦いに特化した壊し屋である。"

#. Occurrence 5B_4:348:6869: scene=5B_4
#: 5B_4:348
msgctxt "text_id=6869 | speaker=unknown"
msgid "  In a contest that pitted magical energy against magical energy, even Alice would concede that Aoko had the upper hand."
msgstr "　純粋な魔力勝負では青子の方が上だろう、と有珠は認めてさえいる。"

#. Occurrence 5B_4:368:6870: scene=5B_4
#: 5B_4:368
msgctxt "text_id=6870 | speaker=unknown"
msgid "  Aoko's manipulation of magical energy was extraordinary."
msgstr "　青子は魔力の使い方が抜群に上手い。"

#. Occurrence 5B_4:373:6871: scene=5B_4
#: 5B_4:373
msgctxt "text_id=6871 | speaker=unknown"
msgid "  The scale of her Magic Circuits was smaller than that of Alice, but their rotational speed, durability, and output quality―not to mention efficiency―were otherworldly."
msgstr "　魔術回路の規模は有珠より小さいが、回路の回転の速さ、その耐久構造、魔力の質、燃費の良さが並はずれている。"

#. Occurrence 5B_4:378:6872: scene=5B_4
#: 5B_4:378
msgctxt "text_id=6872 | speaker=unknown"
msgid "  That was Aoko Aozaki's hallmark."
msgstr "　それが蒼崎青子の特性だ。"

#. Occurrence 5B_4:384:6873: scene=5B_4
#: 5B_4:384
msgctxt "text_id=6873 | speaker=unknown"
msgid "  Though she had many failings when handling sophisticated formulae,"
msgstr "　高度な魔術式は凡百に落ちるが、"

msgctxt "text_id=6874 | speaker=unknown"
msgid "  in just two years of practice, Aoko had surpassed Alice in simple formulae that merely required an energy input."
msgstr "　魔力を流動させるだけの単純な魔術式なら、わずか二年の実践で有珠を上回っている。"

#. Occurrence 5B_4:406:6875: scene=5B_4
#: 5B_4:406
msgctxt "text_id=6875 | speaker=unknown"
msgid "  She also had a genius' instincts and adaptability."
msgstr "　……天才的なノリの良さと勘の良さ。"

#. Occurrence 5B_4:411:6876: scene=5B_4
#: 5B_4:411
msgctxt "text_id=6876 | speaker=unknown"
msgid "  Though Aoko was not particularly proficient at executing magecraft, she was terrifyingly fast."
msgstr "　彼女の魔術行使は強いのではなく、おそろしく“速い”のだ。"

#. Occurrence 5B_4:416:6877: scene=5B_4
#: 5B_4:416
msgctxt "text_id=6877 | speaker=unknown"
msgid "  If she had been born outside the Aozaki clan, she would have doubtless risen to fame as a competitive sharpshooter."
msgstr "　蒼崎の家になんて生まれなければ、天才的な射撃手として名を<馳|は>せたに違いない。"

#. Occurrence 5B_4:476:6878: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_4_0002; voice_prefix=A40; voice_category=2; scene=5B_4
#: 5B_4:476
msgctxt "text_id=6878 | speaker=alice"
msgid "\"What a pity.\""
msgstr "「でも、残念ね」"

#. Occurrence 5B_4:482:6879: scene=5B_4
#: 5B_4:482
msgctxt "text_id=6879 | speaker=unknown"
msgid "  In a straight shootout, Alice did not stand a chance."
msgstr "　正面から撃ちあえば有珠に勝ち目はない。"

#. Occurrence 5B_4:487:6880: scene=5B_4
#: 5B_4:487
msgctxt "text_id=6880 | speaker=unknown"
msgid "  Alice Kuonji had never bothered to learn primitive magecraft like magic bullets in the first place."
msgstr "　否、そもそも魔弾などという原始的な魔術を、久遠寺有珠は習得していない。"

#. Occurrence 5B_4:492:6881: scene=5B_4
#: 5B_4:492
msgctxt "text_id=6881 | speaker=unknown"
msgid "  She was the classic puppeteer."
msgstr "　彼女は典型的な人形師。"

#. Occurrence 5B_4:497:6882: scene=5B_4
#: 5B_4:497
msgctxt "text_id=6882 | speaker=unknown"
msgid "  Her familiars served as her arms and legs to carry out all the particulars of a battle."
msgstr "　戦闘はすべて、手足となる使い魔が行うことだ。"

#. Occurrence 5B_4:597:6883: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_4_0003; voice_prefix=A40; voice_category=2; scene=5B_4
#: 5B_4:597
msgctxt "text_id=6883 | speaker=alice"
msgid "\"Clock's ticking, Aoko."
msgstr "「……制限時間には気づいているわよね青子。"

#. Occurrence 5B_4:603:6884: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_4_0004; voice_prefix=A40; voice_category=2; scene=5B_4
#: 5B_4:603
msgctxt "text_id=6884 | speaker=alice"
msgid "  I'm happy to lend you all the ammunition you like, but after an hour, those bullets will be worthless.\""
msgstr "　魔力はいくらでも貸してあげるけど―――貴女の魔弾は、あと半刻で<値崩|ねくず>れするわ」"

#. Occurrence 5B_4:659:6885: scene=5B_4
#: 5B_4:659
msgctxt "text_id=6885 | speaker=unknown"
msgid "  Chirping as if in agreement, the robin took flight."
msgstr "　チチチ、と<頷|うなず>くようにさえずって飛び立つ駒鳥。"

#. Occurrence 5B_4:665:6886: scene=5B_4
#: 5B_4:665
msgctxt "text_id=6886 | speaker=unknown"
msgid "  It had been nearly ten minutes since Alice had made the amusement park into her dominion."
msgstr "　遊園地が少女の支配下に<陥|おちい>ってからじき十分。"

#. Occurrence 5B_4:670:6887: scene=5B_4
#: 5B_4:670
msgctxt "text_id=6887 | speaker=unknown"
msgid "  To what would the green fog give birth next?"
msgstr "　<緑|みどり>色の霧が何を生み出すものなのか。"

#. Occurrence 5B_4:675:6888: scene=5B_4
#: 5B_4:675
msgctxt "text_id=6888 | speaker=unknown"
msgid "  Aoko and Soujyuro, still running about, would soon come to understand the gravity of their situation."
msgstr "　地上を走る青子たちも、そろそろ事の深刻さに気が付く頃だった。"

#. Occurrence 5B_5:103:6889: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0000; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:103
msgctxt "text_id=6889 | speaker=aoko"
msgid "\"Sizuki, is this the way out?!\""
msgstr "「静希君、正門ってこっち！？」"

#. Occurrence 5B_5:109:6890: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0000; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:109
msgctxt "text_id=6890 | speaker=soujuurou"
msgid "\"Yeah, the exit is just around that store!\""
msgstr "「ああ、その店を曲がれば出口だ！」"

#. Occurrence 5B_5:210:6891: scene=5B_5
#: 5B_5:210
msgctxt "text_id=6891 | speaker=unknown"
msgid "  Running nonstop at full speed had them at their limits."
msgstr "　全力とは言わずとも、休まずに走り続けてはや十分。"

#. Occurrence 5B_5:210:6892: scene=5B_5
#: 5B_5:210
msgctxt "text_id=6892 | speaker=unknown"
msgid "  Their breath ragged, the duo rounded a corner at a breakneck pace."
msgstr "　息を乱しながらふたりは曲がり角に飛びこんだ。"

#. Occurrence 5B_5:215:6893: scene=5B_5
#: 5B_5:215
msgctxt "text_id=6893 | speaker=unknown"
msgid "  Amusement park though it was, this was still the infamous Kitsy Land."
msgstr "　遊園地と言っても所詮はキッツィーランド。"

#. Occurrence 5B_5:220:6894: scene=5B_5
#: 5B_5:220
msgctxt "text_id=6894 | speaker=unknown"
msgid "  It would have taken a high school student twenty minutes to sprint the entire circumference of the park."
msgstr "　高校生が全力で走れば二十分ほどで一周できる。"

#. Occurrence 5B_5:248:6895: scene=5B_5
#: 5B_5:248
msgctxt "text_id=6895 | speaker=unknown"
msgid "  And though they were now intimately familiar with the park's geography..."
msgstr "　そんな地域密着型のアミューズメントパークは、しかし。"

#. Occurrence 5B_5:463:6896: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0001; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:463
msgctxt "text_id=6896 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5B_5:469:6897: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0001; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:469
msgctxt "text_id=6897 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5B_5:474:6898: scene=5B_5
#: 5B_5:474
msgctxt "text_id=6898 | speaker=unknown"
msgid "  ...It was changing beyond recognition. "
msgstr "　……このように。"

#. Occurrence 5B_5:479:6899: scene=5B_5
#: 5B_5:479
msgctxt "text_id=6899 | speaker=unknown"
msgid "  The transformation was not limited to the park's residents, either."
msgstr "　住人ばかりか、遊園地そのものを変化させていた。"

#. Occurrence 5B_5:573:6900: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0002; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:573
msgctxt "text_id=6900 | speaker=soujuurou"
msgid "\"Aozaki?\""
msgstr "「……蒼崎」"

#. Occurrence 5B_5:585:6901: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0002; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:585
msgctxt "text_id=6901 | speaker=aoko"
msgid "\"...What?!\""
msgstr "「……なによ」"

#. Occurrence 5B_5:596:6902: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0003; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:596
msgctxt "text_id=6902 | speaker=soujuurou"
msgid "\"I hate to ask, but... is it just me, or is the park getting bigger?\""
msgstr "「……言いたくないんだけど。この遊園地、広くなってないか？」"

#. Occurrence 5B_5:621:6903: scene=5B_5
#: 5B_5:621
msgctxt "text_id=6903 | speaker=unknown"
msgid "  It was."
msgstr "　そう。"

#. Occurrence 5B_5:627:6904: scene=5B_5
#: 5B_5:627
msgctxt "text_id=6904 | speaker=unknown"
msgid "Their problem wasn't as mundane as mistaking the location of the exits, nor the strange terrain."
msgstr "出口を間違えたとか、地形が変わっているとか、そんな現実的な間違いではない。"

#. Occurrence 5B_5:633:6905: scene=5B_5
#: 5B_5:633
msgctxt "text_id=6905 | speaker=unknown"
msgid "  No, the park was warping and twisting in upon itself."
msgstr "　あらゆるものが、ねじ曲がっている。"

#. Occurrence 5B_5:639:6906: scene=5B_5
#: 5B_5:639
msgctxt "text_id=6906 | speaker=unknown"
msgid "  Even as they ran, its structure was expanding and growing, like that of a living creature."
msgstr "　遊園地はそれ自体が生き物のように、いまもって、その規模を成長させていた。"

#. Occurrence 5B_5:749:6907: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0004; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:749
msgctxt "text_id=6907 | speaker=soujuurou"
msgid "\"...\""
msgstr "「―――」"

#. Occurrence 5B_5:755:6908: scene=5B_5
#: 5B_5:755
msgctxt "text_id=6908 | speaker=unknown"
msgid "  Soon, the pair noticed that the mob encircling them had grown even stronger."
msgstr "　気が付けば包囲網は一段と強固になっている。"

#. Occurrence 5B_5:775:6909: scene=5B_5
#: 5B_5:775
msgctxt "text_id=6909 | speaker=unknown"
msgid "  Entrusting her back to Soujyuro, Aoko summoned all of her effort just to keep from whining."
msgstr "　草十郎に背中をあずけながら、青子は懸命に泣き言を抑えこむ。"

#. Occurrence 5B_5:780:6910: scene=5B_5
#: 5B_5:780
msgctxt "text_id=6910 | speaker=unknown"
msgid "  No one would blame Soujyuro for cowering in shock,"
msgstr "　草十郎は驚き、怖がるだけでいい。"

#. Occurrence 5B_5:785:6911: scene=5B_5
#: 5B_5:785
msgctxt "text_id=6911 | speaker=unknown"
msgid "  but for Aoko to do the same?"
msgstr "　けれど青子はそうはいかない。"

#. Occurrence 5B_5:790:6912: scene=5B_5
#: 5B_5:790
msgctxt "text_id=6912 | speaker=unknown"
msgid "  She bore responsibility for causing and then dragging him into this mess."
msgstr "　この状況を招き、彼の手を取った責任がある。"

#. Occurrence 5B_5:795:6913: scene=5B_5
#: 5B_5:795
msgctxt "text_id=6913 | speaker=unknown"
msgid "  She could not afford to succumb to panic."
msgstr "　おいそれとパニックに<陥|おちい>るワケにはいかないのだ。"

#. Occurrence 5B_5:885:6914: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0003; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:885
msgctxt "text_id=6914 | speaker=aoko"
msgid "(...Pull yourself together, Aoko."
msgstr "“……大丈夫、落ち着け私……"

#. Occurrence 5B_5:891:6915: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0004; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:891
msgctxt "text_id=6915 | speaker=aoko"
msgid "  The park has to end somewhere. It may be far, but the fence is right there."
msgstr "　遊園地の果てはある。遠いけど、鉄柵はちゃんと見える。"

#. Occurrence 5B_5:897:6916: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0005; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:897
msgctxt "text_id=6916 | speaker=aoko"
msgid "  Even Flat Snark has limits. Getting to the exit is the right choice, I think."
msgstr "　フラットスナークだって制限無しってワケじゃない。外に逃げるって選択は正しいはず……。"

#. Occurrence 5B_5:903:6917: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0006; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:903
msgctxt "text_id=6917 | speaker=aoko"
msgid "  But from here, it looks the better part of a mile away.)"
msgstr "　現状、外までは目算で一キロぐらいだけど―――”"

#. Occurrence 5B_5:944:6918: scene=5B_5
#: 5B_5:944
msgctxt "text_id=6918 | speaker=unknown"
msgid "  Up until now they had been too concerned with simply running."
msgstr "　ここまで夢中で走りすぎた。"

#. Occurrence 5B_5:949:6919: scene=5B_5
#: 5B_5:949
msgctxt "text_id=6919 | speaker=unknown"
msgid "  Their breathing had become labored."
msgstr "　青子も草十郎も息が上がっている。"

#. Occurrence 5B_5:954:6920: scene=5B_5
#: 5B_5:954
msgctxt "text_id=6920 | speaker=unknown"
msgid "  If they had to run another mile without rest, they'd end up collapsing along the way."
msgstr "　あと一キロ走るのなら、いったん休憩をいれないと途中で足が止まってしまう。"

#. Occurrence 5B_5:975:6921: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0005; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:975
msgctxt "text_id=6921 | speaker=soujuurou"
msgid "\"...Aozaki? How are you holding up? Physically, I mean.\""
msgstr "「……蒼崎。体、大丈夫か？」"

#. Occurrence 5B_5:1044:6922: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0007; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:1044
msgctxt "text_id=6922 | speaker=aoko"
msgid "\"W-what?\""
msgstr "「へ？」"

#. Occurrence 5B_5:1050:6923: scene=5B_5
#: 5B_5:1050
msgctxt "text_id=6923 | speaker=unknown"
msgid "  The whisper from behind pulled Aoko back to reality."
msgstr "　背中ごしに<囁|ささや>きかけられ、青子は現実に引き戻された。"

#. Occurrence 5B_5:1129:6924: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0008; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:1129
msgctxt "text_id=6924 | speaker=aoko"
msgid "\"I'm fine... but... I need to catch my breath.\""
msgstr "「大丈夫だけど……ちょっと、一息いれたいわね」"

#. Occurrence 5B_5:1141:6925: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0006; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:1141
msgctxt "text_id=6925 | speaker=soujuurou"
msgid "\"...Good idea. We'll never make it outside if we don't rest.\""
msgstr "「……賛成。ここから休みなしで外周まで走るのは、やめた方がいい」"

#. Occurrence 5B_5:1153:6926: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0009; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:1153
msgctxt "text_id=6926 | speaker=aoko"
msgid "\"...You know, I never would have thought you'd be okay with making a run for it.\""
msgstr "「―――驚いた。静希君も外まで走ろう派とは」"

#. Occurrence 5B_5:1247:6927: scene=5B_5
#: 5B_5:1247
msgctxt "text_id=6927 | speaker=unknown"
msgid "  She let slip a giggle."
msgstr "　言って、くすりと笑ってしまった。"

#. Occurrence 5B_5:1252:6928: scene=5B_5
#: 5B_5:1252
msgctxt "text_id=6928 | speaker=unknown"
msgid "  Far from debilitated by panic, her comrade-in-arms had been analyzing the situation and forming an escape plan."
msgstr "　背中の戦友はパニック状態どころか、きちんと現状と、その打開策を考えていた。"

#. Occurrence 5B_5:1329:6929: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0007; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:1329
msgctxt "text_id=6929 | speaker=soujuurou"
msgid "\"Why don't we hole up in one of those buildings for a while?\""
msgstr "「ちょっとだけ建物に逃げこむのは？」"

#. Occurrence 5B_5:1341:6930: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0010; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:1341
msgctxt "text_id=6930 | speaker=aoko"
msgid "\"...I don't like it, but it's our best option right now.\""
msgstr "「………気は進まないけど、それしかないわね」"

#. Occurrence 5B_5:1422:6931: scene=5B_5
#: 5B_5:1422
msgctxt "text_id=6931 | speaker=unknown"
msgid "  The bread-men had them completely surrounded."
msgstr "　焼きたてパンたちの包囲網。"

#. Occurrence 5B_5:1427:6932: scene=5B_5
#: 5B_5:1427
msgctxt "text_id=6932 | speaker=unknown"
msgid "  Perhaps this might have been a problem for an average person, but for Aoko, breaking through their formation to get to the building would be a cinch."
msgstr "　常人ならいざ知らず、青子ならこの囲みを破って建物に逃げこむのは<容易|ようい>だ。"

#. Occurrence 5B_5:1432:6933: scene=5B_5
#: 5B_5:1432
msgctxt "text_id=6933 | speaker=unknown"
msgid "  The issue was..."
msgstr "　問題は―――"

#. Occurrence 5B_5:1539:6934: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0011; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:1539
msgctxt "text_id=6934 | speaker=aoko"
msgid "\"...Which store to pick?\""
msgstr "“……問題は、どんな店を選ぶかってコト―――”"

#. Occurrence 5B_5:1601:6935: scene=5B_5
#: 5B_5:1601
msgctxt "text_id=6935 | speaker=unknown"
msgid "  She considered the characteristics of the transforming park."
msgstr "　変貌する遊園地の特性を考慮する。"

#. Occurrence 5B_5:1606:6936: scene=5B_5
#: 5B_5:1606
msgctxt "text_id=6936 | speaker=unknown"
msgid "  What would pose a danger, and what was safe?"
msgstr "　何が危険で、何が安全なのか。"

#. Occurrence 5B_5:1611:6937: scene=5B_5
#: 5B_5:1611
msgctxt "text_id=6937 | speaker=unknown"
msgid "  The most important factor was not the strength or the complexity of the building..."
msgstr "　大事なのは建物の強度や複雑さではなく―――"

#. Occurrence 5B_5:1643:6938: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0012; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:1643
msgctxt "text_id=6938 | speaker=aoko"
msgid "(Keep it simple, stupid!)"
msgstr "“そうだ、選ぶなら<あ|・><の|・><単|・><純|・><さ|・>で正しいはず……！”"

#. Occurrence 5B_5:1751:6939: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0013; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:1751
msgctxt "text_id=6939 | speaker=aoko"
msgid "\"Sizuki, this way!\""
msgstr "「静希君、あっち！」"

#. Occurrence 5B_5:1874:6940: scene=5B_5
#: 5B_5:1874
msgctxt "text_id=6940 | speaker=unknown"
msgid "  After routing the monsters, Aoko hopped behind the counter, soon followed by Soujyuro."
msgstr "　怪物たちを蹴散らしてカウンターに飛びこむ青子と、その後に続く草十郎。"

#. Occurrence 5B_5:2045:6941: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0014; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:2045
msgctxt "text_id=6941 | speaker=aoko"
msgid "\"Get behind the counter!\""
msgstr "「カウンターに隠れてて！」"

#. Occurrence 5B_5:2090:6942: scene=5B_5
#: 5B_5:2090
msgctxt "text_id=6942 | speaker=unknown"
msgid "  Like she was in a Western shootout, Aoko squared off against the monsters, using the counter as cover."
msgstr "　青子は西部劇の銃撃戦のように、カウンターを盾にして怪物たちと対峙する。"

#. Occurrence 5B_5:2384:6943: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0015; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:2384
msgctxt "text_id=6943 | speaker=aoko"
msgid "\"Bingo! Nothing in here can get Snarkified!\""
msgstr "「ビンゴ……！　ここならスナーク化しないんだ！」"

#. Occurrence 5B_5:2390:6944: scene=5B_5
#: 5B_5:2390
msgctxt "text_id=6944 | speaker=unknown"
msgid "  After assessing the current state of the enemy, Aoko sat down under the counter."
msgstr "　敵の様子を確認し、青子もカウンター内部に腰を下ろした。"

#. Occurrence 5B_5:2446:6945: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0008; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:2446
msgctxt "text_id=6945 | speaker=soujuurou"
msgid "\"What are they doing?\""
msgstr "「アイツらは……？」"

#. Occurrence 5B_5:2457:6946: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0016; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:2457
msgctxt "text_id=6946 | speaker=aoko"
msgid "\"They're stamping their feet in frustration, because they're angry that they can't get in.\""
msgstr "「店の周りで<地団駄|じだんだ>踏んでるわ。理由があってね、アイツらはここには入ってこられないのよ」"

#. Occurrence 5B_5:2468:6947: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0009; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:2468
msgctxt "text_id=6947 | speaker=soujuurou"
msgid "\"?\""
msgstr "「？？」"

#. Occurrence 5B_5:2537:6948: scene=5B_5
#: 5B_5:2537
msgctxt "text_id=6948 | speaker=unknown"
msgid "  Aoko gave the perplexed Soujyuro a grin and took a moment to catch her breath."
msgstr "　不思議がる草十郎にまあまあと笑いかけて、青子は大きく胸を上下させた。"

#. Occurrence 5B_5:2542:6949: scene=5B_5
#: 5B_5:2542
msgctxt "text_id=6949 | speaker=unknown"
msgid "  She heaved a heavy sigh of relief and fatigue."
msgstr "　安堵と、おそらくは疲労からきた大きな息継ぎ。"

#. Occurrence 5B_5:2632:6950: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0017; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:2632
msgctxt "text_id=6950 | speaker=aoko"
msgid "\"We'll take five here. This restaurant is the blandest place in the park, which makes it their Achilles' heel."
msgstr "「とりあえずコーヒーブレイクね。ここは遊園地の中でも遊びのない場所だから、アイツらにとっては鬼門なのよ。"

#. Occurrence 5B_5:2638:6951: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0018; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:2638
msgctxt "text_id=6951 | speaker=aoko"
msgid "  The registers and utensils are all modern, and there are no mascot characters. It's just a bit too civilized for Snark to mess with.\""
msgstr "　レジスターも調理道具も最近のものだし、擬人化されたマスコットもないし。スナーク化するには、ちょい文明圏すぎるってコト」"

#. Occurrence 5B_5:2705:6952: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0010; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:2705
msgctxt "text_id=6952 | speaker=soujuurou"
msgid "\"Snark?\""
msgstr "「すなーく？」"

#. Occurrence 5B_5:2752:6953: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0019; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:2752
msgctxt "text_id=6953 | speaker=aoko"
msgid "\"That's their name, though Alice is the one who came up with it... I think. It doesn't really sound like her, but whatever. That's what they're called.\""
msgstr "「アイツらの名前よ。つけたのは私じゃなくて有珠……なのかしらね。あの子の性格的にちょっと想像できないけど、まあ、とにかくそういう名前」"

#. Occurrence 5B_5:2821:6954: scene=5B_5
#: 5B_5:2821
msgctxt "text_id=6954 | speaker=unknown"
msgid "  Perhaps now at ease from knowing they were safe, Soujyuro seemed enthralled in her explanation."
msgstr "　安全と分かって落ち着いたのか、草十郎は興味津々とばかりに耳を傾ける。"

#. Occurrence 5B_5:2826:6955: scene=5B_5
#: 5B_5:2826
msgctxt "text_id=6955 | speaker=unknown"
msgid "  Aoko could not help but chuckle as Soujyuro nodded sagely. It was certain that he had no idea what she was talking about."
msgstr "　なるほど、なんてしかつめらしく頷いているが、きっと分かってないだろうなー、と青子はつい笑ってしまった。"

#. Occurrence 5B_5:2831:6956: scene=5B_5
#: 5B_5:2831
msgctxt "text_id=6956 | speaker=unknown"
msgid "  Normally this would have irritated her, but this time she was grateful for the warmth of his strange sobriety."
msgstr "　普段ならイラっとくるところだが、今は彼の妙な真面目さがありがたく、あたたかい。"

#. Occurrence 5B_5:2869:6957: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0011; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:2869
msgctxt "text_id=6957 | speaker=soujuurou"
msgid "\"It's good that you seem better, Aozaki.\""
msgstr "「それはともかく。調子良さそうだな、蒼崎」"

#. Occurrence 5B_5:2875:6958: scene=5B_5
#: 5B_5:2875
msgctxt "text_id=6958 | speaker=unknown"
msgid "  Mistaking her smile for composure, Soujyuro broke into a smile himself."
msgstr "　そんな青子の笑みを余裕と勘違いして、草十郎も顔をほころばす。"

#. Occurrence 5B_5:2880:6959: scene=5B_5
#: 5B_5:2880
msgctxt "text_id=6959 | speaker=unknown"
msgid "  It was just another link in a chain of misunderstandings, but there was no need to redress it."
msgstr "　誤解の連鎖だが、今はそれを<糾|ただ>すこともない。"

#. Occurrence 5B_5:2960:6960: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0020; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:2960
msgctxt "text_id=6960 | speaker=aoko"
msgid "\"Oh, you can tell?"
msgstr "「あれ、貴方から見ても分かる？"

#. Occurrence 5B_5:2960:6961: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0020; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:2960
msgctxt "text_id=6961 | speaker=aoko"
msgid "  Yeah, my magic bullets are getting more powerful.\""
msgstr "　私の魔弾の威力が上がっているの」"

#. Occurrence 5B_5:2993:6962: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0012; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:2993
msgctxt "text_id=6962 | speaker=soujuurou"
msgid "\"Well, you did chase me all around that house of mirrors while firing those things at me, so I guess I've become really familiar with them, for better or worse.\""
msgstr "「そりゃあ、ミラーハウスでさんざん追いかけ回されたからな。あの時と同じ動作なのに物騒さが増していれば、イヤでも分かる」"

#. Occurrence 5B_5:3019:6963: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0013; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:3019
msgctxt "text_id=6963 | speaker=soujuurou"
msgid "\"Are you sure you're okay, though? I remember you mentioning that you had a limited number of shots, but you've fired at least twenty or thirty so far, right?\""
msgstr "「でもいいのか？　たしか、数にかぎりがあるとか言ってただろ。もうずいぶん撃っちまったけど。二十、三十じゃきかないぞ」"

#. Occurrence 5B_5:3031:6964: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0021; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3031
msgctxt "text_id=6964 | speaker=aoko"
msgid "\"You know, every now and then, you...\""
msgstr "「―――アンタ、時々、アレよね」"

#. Occurrence 5B_5:3042:6965: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0014; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:3042
msgctxt "text_id=6965 | speaker=soujuurou"
msgid "\"?\""
msgstr "「？」"

#. Occurrence 5B_5:3047:6966: scene=5B_5
#: 5B_5:3047
msgctxt "text_id=6966 | speaker=unknown"
msgid "  Her opinion of him improved, just a little bit."
msgstr "　不覚にも、ちょっと見直す青子だった。"

#. Occurrence 5B_5:3074:6967: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0022; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3074
msgctxt "text_id=6967 | speaker=aoko"
msgid "\"Never mind."
msgstr "「なんでもない。"

#. Occurrence 5B_5:3080:6968: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0023; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3080
msgctxt "text_id=6968 | speaker=aoko"
msgid "  My bullets' increase in power is a simple matter of the density of their magical energy. You've seen that fog around the park from a bit ago, right? It's all just magical energy. Think of it as fuel for my bullets.\""
msgstr "　私の魔弾の威力が上がっているのは、単純に魔力の濃度の問題。さっきから霧がかかってるでしょ？　あれ、全部魔力なのよ。<魔|タ><弾|マ>を撃つための燃料と思って」"

#. Occurrence 5B_5:3130:6969: scene=5B_5
#: 5B_5:3130
msgctxt "text_id=6969 | speaker=unknown"
msgid "  Magical energy was divided into two broad categories."
msgstr "　魔力とは大きく二種類あり、"

#. Occurrence 5B_5:3130:6970: scene=5B_5
#: 5B_5:3130
msgctxt "text_id=6970 | speaker=unknown"
msgid "  First was od, produced inside a mage's body."
msgstr "　魔術師が肉体から生成する<小源|オド>と、"

msgctxt "text_id=6971 | speaker=unknown"
msgid "  Second was mana, which filled the atmosphere."
msgstr "　大気に満ちている<大源|マナ>とがある。"

#. Occurrence 5B_5:3137:6972: scene=5B_5
#: 5B_5:3137
msgctxt "text_id=6972 | speaker=unknown"
msgid "  At the moment, the amusement park had turned into a fairy-tale land, overflowing with mana."
msgstr "　この遊園地はいま、マナに満ちあふれた御伽の国だ。"

#. Occurrence 5B_5:3142:6973: scene=5B_5
#: 5B_5:3142
msgctxt "text_id=6973 | speaker=unknown"
msgid "  Although it meant nothing to the average person, to a mage it was a paradise where spells could be cast as much as one pleased."
msgstr "　一般人にとっては何の効果もないが、魔術師にとっては術式を使いたい放題の楽園と化している。"

#. Occurrence 5B_5:3163:6974: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0015; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:3163
msgctxt "text_id=6974 | speaker=soujuurou"
msgid "\"So that means you don't have to worry about how much magic-whatever you have left then."
msgstr "「じゃあ残り魔力とやらは気にしなくていいのか。"

#. Occurrence 5B_5:3169:6975: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0016; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:3169
msgctxt "text_id=6975 | speaker=soujuurou"
msgid "  All we need to worry about are injuries and stamina?\""
msgstr "　注意すべきは怪我と体力だけ？」"

#. Occurrence 5B_5:3196:6976: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0024; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3196
msgctxt "text_id=6976 | speaker=aoko"
msgid "\"...Well, as far as our own lives are concerned, yeah.\""
msgstr "「……まあ、個人的な責任においてはそのかぎりね」"

#. Occurrence 5B_5:3221:6977: scene=5B_5
#: 5B_5:3221
msgctxt "text_id=6977 | speaker=unknown"
msgid "  Soujyuro breathed a sigh of relief."
msgstr "　良かった、と息をつく草十郎。"

#. Occurrence 5B_5:3226:6978: scene=5B_5
#: 5B_5:3226
msgctxt "text_id=6978 | speaker=unknown"
msgid "  From Soujyuro's perspective, more so than the monsters she mowed down, Aoko was the biggest bully on the playground."
msgstr "　草十郎から見れば、青子は怪物たちをなぎ払う遊園地最強の暴れん坊だ。"

#. Occurrence 5B_5:3231:6979: scene=5B_5
#: 5B_5:3231
msgctxt "text_id=6979 | speaker=unknown"
msgid "  He had been concerned about what would happen should her magical energy be exhausted, but luckily for him she was far from surrendering her crown."
msgstr "　不安なのは魔力が尽きる事だったが、それがないのであればまさに百人力である。"

#. Occurrence 5B_5:3311:6980: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0025; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3311
msgctxt "text_id=6980 | speaker=aoko"
msgid "\"It's nice that you trust me and all, but let's not get ahead of ourselves."
msgstr "「頼りにしてくれるのは嬉しいけど、ぬか喜びよ。"

#. Occurrence 5B_5:3318:6981: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0026; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3318
msgctxt "text_id=6981 | speaker=aoko"
msgid "Those minions out there are just walking garbage."
msgstr "あんな雑魚たち、ただ動いているだけのガラクタなんだから。"

#. Occurrence 5B_5:3324:6982: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0027; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3324
msgctxt "text_id=6982 | speaker=aoko"
msgid "  If Alice summons any other fairy-tale monsters, let alone the actual Snark making an appearance, there's nothing I'll be able to do.\""
msgstr "　スナーク本体は当然として、有珠が<他|・><の|・><童|・><話|・><の|・><怪|・><物|・>を出してきたら私じゃどうにもならない」"

#. Occurrence 5B_5:3361:6983: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0017; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:3361
msgctxt "text_id=6983 | speaker=soujuurou"
msgid "\"Other fairy-tale monsters? You mean there are others apart from the thing that changed the park?\""
msgstr "「他の童話の怪物？　……遊園地をこんなふうに変えたヤツ以外に、まだいるのか？」"

#. Occurrence 5B_5:3398:6984: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0028; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3398
msgctxt "text_id=6984 | speaker=aoko"
msgid "\"Yes. They're called Ploy Kickshaws, aberrations that even we mages can't stand to look at."
msgstr "「そ。プロイキッシャーって名付けられた、<魔術師|わたしたち>でさえ目を背けたくなる反則。"

#. Occurrence 5B_5:3405:6985: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0029; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3405
msgctxt "text_id=6985 | speaker=aoko"
msgid "They're nonsense lost to time, used to revive impossible fantasies.\""
msgstr "不可能な夢物語をも再現する、時代に取り残されたデタラメよ」"

#. Occurrence 5B_5:3460:6986: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0018; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:3460
msgctxt "text_id=6986 | speaker=soujuurou"
msgid "\"?\""
msgstr "「？？」"

#. Occurrence 5B_5:3465:6987: scene=5B_5
#: 5B_5:3465
msgctxt "text_id=6987 | speaker=unknown"
msgid "  Soujyuro's expression seemed to be calling her out on the hypocrisy."
msgstr "　自分の事は棚にあげて？　と言いたげな顔である。"

#. Occurrence 5B_5:3545:6988: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0030; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3545
msgctxt "text_id=6988 | speaker=aoko"
msgid "\"Hey, most of us have modern standards, you know."
msgstr "「あのね、私たちはちゃんと現代によりそった魔術師よ。"

#. Occurrence 5B_5:3557:6989: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0031; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3557
msgctxt "text_id=6989 | speaker=aoko"
msgid "  Obviously there are things we can't do, and we're no match for modern weapons. The twentieth century―well, a bunch of wars helped weapons technology catch up to us.\""
msgstr "　できない事もあるし、当たり前の事だけど、近代兵器には敵わない。二十世紀―――ま、色んな戦争の後押しで、兵器の進化は私たちを越えちゃったから」"

#. Occurrence 5B_5:3584:6990: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0032; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3584
msgctxt "text_id=6990 | speaker=aoko"
msgid "\"...But that girl is a different beast altogether. Mankind's evolution can't hold a flame to her power."
msgstr "「……けどあの子のは違う。どんなに人間の技術が進歩しようと関係ないって怪物なの。"

#. Occurrence 5B_5:3597:6991: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0033; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3597
msgctxt "text_id=6991 | speaker=aoko"
msgid "  Take those bread-men, for instance."
msgstr "　たとえば、あのブレッドマンいるでしょ？"

#. Occurrence 5B_5:3603:6992: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0034; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3603
msgctxt "text_id=6992 | speaker=aoko"
msgid "  Something like a machine gun would have no effect on them, probably because guns make no sense to them.\""
msgstr "　あいつには自動拳銃とかきかないわよ。たぶん、意味が分かっていないから」"

#. Occurrence 5B_5:3608:6993: scene=5B_5
#: 5B_5:3608
msgctxt "text_id=6993 | speaker=unknown"
msgid "  Aoko casually gestured outside, past the counter."
msgstr "　ひょい、とカウンターから外を指す青子。"

#. Occurrence 5B_5:3687:6994: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0035; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3687
msgctxt "text_id=6994 | speaker=aoko"
msgid "\"Alice's familiars are Mystics kneaded from fantasies."
msgstr "「有珠の使い魔は全てが空想によってこねられた神秘なの。"

#. Occurrence 5B_5:3693:6995: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0036; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3693
msgctxt "text_id=6995 | speaker=aoko"
msgid "  They're all impossible in the first place, so they don't play nice with the laws of physics. That shouldn't come as a surprise, since fantasy and reality can't exist together.\""
msgstr "　前提からしてあり得ない事だから、通常の物理法則と折り合いが悪い。空想と現実は両立しないっていう、ごく当たり前の理由でね」"

#. Occurrence 5B_5:3759:6996: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0019; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:3759
msgctxt "text_id=6996 | speaker=soujuurou"
msgid "\"...I see. So they're literally walking loaves of bread.\""
msgstr "「……なるほど。ブレッドマンってのは、あの動く焼きたてパンの事なんだな」"

#. Occurrence 5B_5:3764:6997: scene=5B_5
#: 5B_5:3764
msgctxt "text_id=6997 | speaker=unknown"
msgid "  Soujyuro seemed to have ignored the majority of Aoko's explanation and only reacted to the part that caught his curiosity."
msgstr "　青子の説明の大部分をスルーして、気になるコトだけ拾う草十郎だった。"

#. Occurrence 5B_5:3847:6998: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0037; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3847
msgctxt "text_id=6998 | speaker=aoko"
msgid "\"...To get back on topic,"
msgstr "「…………話を戻すけど。"

#. Occurrence 5B_5:3853:6999: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0038; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3853
msgctxt "text_id=6999 | speaker=aoko"
msgid "  Modern arms don't stand a chance against those things. Even rockets would be useless. They aren't part of the same order or shared consciousness as us.\""
msgstr "　あいつらと近代兵器の相性は最悪。ロケット弾でも効果はないわ。意思の疎通、秩序の共有ができてないから」"

#. Occurrence 5B_5:3882:7000: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0039; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3882
msgctxt "text_id=7000 | speaker=aoko"
msgid "\"To the Ploy Kickshaws―to the fairy-tale monsters―anything that doesn't exist in their world, anything they don't understand, disintegrates before it can even touch them."
msgstr "「<童話の怪物|プロイキッシャー>にとって、彼らの世界には存在しないもの、意味が分からないモノは、触れるコトなく霧散する。"

#. Occurrence 5B_5:3895:7001: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0040; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3895
msgctxt "text_id=7001 | speaker=aoko"
msgid "  Only something equally nonsense can touch them, like magical energy infused with the same level of Mystics. They exist wholly in their own conceptual space or cosmos―\""
msgstr "　彼らに<通|つう>じるのは同じ神秘を帯びた“魔力”だけっていうデタラメぶりよ。もう完全に<概念|がいねん>空間っていうか、概念宇宙っていうか―――」"

#. Occurrence 5B_5:3963:7002: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0020; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:3963
msgctxt "text_id=7002 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5B_5:4011:7003: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0041; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4011
msgctxt "text_id=7003 | speaker=aoko"
msgid "\"...Ahem."
msgstr "「…………こほん。"

#. Occurrence 5B_5:4023:7004: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0042; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4023
msgctxt "text_id=7004 | speaker=aoko"
msgid "  In short, they're protected by a special rule known as Folklore Defense, meaning that neither pure force nor strong magecraft have much effect. They can't be taken down without exploiting the weaknesses found in their original stories."
msgstr "　要するに、アイツらは伝承防御っていう特別なルールを持っていて、単純に強い力、強い魔術じゃ効果は薄いの。元になった童話にちなんだ欠点をつかないと倒せない。"

#. Occurrence 5B_5:4035:7005: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0043; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4035
msgctxt "text_id=7005 | speaker=aoko"
msgid "  Are you familiar with the Greek myth of Achilles? It's a good, straightforward example.\""
msgstr "　ギリシャ神話のアキレスあたり分かりやすい喩えなんだけど……知ってる？」"

#. Occurrence 5B_5:4040:7006: scene=5B_5
#: 5B_5:4040
msgctxt "text_id=7006 | speaker=unknown"
msgid "  Soujyuro shook his head."
msgstr "　草十郎はぶんぶんと首を振る。"

#. Occurrence 5B_5:4067:7007: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0044; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4067
msgctxt "text_id=7007 | speaker=aoko"
msgid "\"Of course you aren't. If we get out of this alive, have Tobimaru tell you about it."
msgstr "「そ。無事帰れたら、鳶丸あたりに教えてもらって。"

#. Occurrence 5B_5:4067:7008: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0044; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4067
msgctxt "text_id=7008 | speaker=aoko"
msgid "  It's a cliché, but it's a good story.\""
msgstr "　定番だけどいい<教訓|はなし>よ、アレ」"

#. Occurrence 5B_5:4078:7009: scene=5B_5
#: 5B_5:4078
msgctxt "text_id=7009 | speaker=unknown"
msgid "  Soujyuro was feeling pretty lost, but he did his best to grasp the situation."
msgstr "　……かなりおいてけぼり感ただよう草十郎だが、彼は彼なりに現状把握に努めてみた。"

#. Occurrence 5B_5:4098:7010: scene=5B_5
#: 5B_5:4098
msgctxt "text_id=7010 | speaker=unknown"
msgid "  He thought that Ploy Kickshaws were scary enough to chase Aoko and that puppet from before out of the house barefoot."
msgstr "“<童話の怪物|プロイキッシャー>”とやらは、青子やミラーハウスの自動人形ですら<裸足|はだし>で逃げだすモノだという。"

#. Occurrence 5B_5:4151:7011: scene=5B_5
#: 5B_5:4151
msgctxt "text_id=7011 | speaker=unknown"
msgid "  Certainly, the scene before them was the stuff of nightmares."
msgstr "　たしかに目の前の光景は誰かの悪夢の中に迷いこんだとしか思えない。"

#. Occurrence 5B_5:4229:7012: scene=5B_5
#: 5B_5:4229
msgctxt "text_id=7012 | speaker=unknown"
msgid "  But Soujyuro had a different way of thinking."
msgstr "　だがしかし、と草十郎は思うのだ。"

#. Occurrence 5B_5:4267:7013: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0021; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:4267
msgctxt "text_id=7013 | speaker=soujuurou"
msgid "\"I think you're more scared than me, Aozaki.\""
msgstr "「やっぱり、蒼崎の方が怖くないか？」"

#. Occurrence 5B_5:4345:7014: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0045; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4345
msgctxt "text_id=7014 | speaker=aoko"
msgid "\"Do you want to die?!\""
msgstr "「アンタ死ぬの？」"

#. Occurrence 5B_5:4351:7015: scene=5B_5
#: 5B_5:4351
msgctxt "text_id=7015 | speaker=unknown"
msgid "  Soujyuro waved in protest, silently pointing out that she had made his case for him."
msgstr "　ほら、と無言の抗議をする草十郎。"

#. Occurrence 5B_5:4393:7016: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0046; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4393
msgctxt "text_id=7016 | speaker=aoko"
msgid "\"Listen to me: the things surrounding us now are little more than fodder."
msgstr "「……あのね。いま私たちを取り囲んでるのはオマケにすぎないの。"

#. Occurrence 5B_5:4399:7017: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0047; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4399
msgctxt "text_id=7017 | speaker=aoko"
msgid "  As far as Alice is concerned, the bread-men, the lobster, the meat mincer at the sausage place―they're all worth even less than my magic bullets are to me."
msgstr "　有珠にとって、あのブレッドマンもロブスターもソーセージ屋のミンチマシーンも、全部が全部、私が撃ってる魔弾より価値がない。"

#. Occurrence 5B_5:4411:7018: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0048; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4411
msgctxt "text_id=7018 | speaker=aoko"
msgid "  Got it? The moving mascots and all the rest are a sideshow. They're nothing more than the breath of the monster she unleashed.\""
msgstr "　いい？　あの動くマスコットたちはね、<た|・><だ|・><の|・><オ|・><マ|・><ケ|・>なの。有珠が解放した“童話の怪物”の、一呼吸みたいなものなのよ」"

#. Occurrence 5B_5:4437:7019: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0022; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:4437
msgctxt "text_id=7019 | speaker=soujuurou"
msgid "\"These things...are just the breath?\""
msgstr "「―――呼吸って、これが？」"

#. Occurrence 5B_5:4449:7020: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0049; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4449
msgctxt "text_id=7020 | speaker=aoko"
msgid "\"Yeah, crazy, I know."
msgstr "「……私だって考えたくないわよ。"

#. Occurrence 5B_5:4455:7021: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0050; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4455
msgctxt "text_id=7021 | speaker=aoko"
msgid "  But that's what we're dealing with right now. Just one of those fairy-tale monsters is enough to keep us busy."
msgstr "　でもそれが現状。たった一体の“童話の怪物”だけで私たちは手一杯。"

#. Occurrence 5B_5:4462:7022: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0051; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4462
msgctxt "text_id=7022 | speaker=aoko"
msgid "So if Alice decides to add another, we might as well give up.\""
msgstr "そういう訳だから、有珠があと一体でも追加したら諦めて」"

#. Occurrence 5B_5:4499:7023: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0023; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:4499
msgctxt "text_id=7023 | speaker=soujuurou"
msgid "\"Add another? Isn't there some sort of limit?\""
msgstr "「追加って……これに制限はないのか？」"

#. Occurrence 5B_5:4505:7024: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0052; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4505
msgctxt "text_id=7024 | speaker=aoko"
msgid "\"If she decides not to be stingy, she has a few more up her sleeve. Though... well, there are conditions to bringing them out."
msgstr "「あの子が出し惜しみしなければ、まだ何体かストックはあるでしょうけど……ま、成立する条件はあるわね。"

#. Occurrence 5B_5:4511:7025: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0053; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4511
msgctxt "text_id=7025 | speaker=aoko"
msgid "  Like one monster that won't wake up if there's no river nearby. The park has fountains, sure, but no river, right? Her familiars are bound by their underlying stories.\""
msgstr "　たとえば川がないと目を覚まさない怪物もいる。この遊園地、噴水はあるけど川はないでしょ？　元になった童話しばりなの、あの子の使い魔は」"

#. Occurrence 5B_5:4532:7026: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0024; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:4532
msgctxt "text_id=7026 | speaker=soujuurou"
msgid "\"By fairy tale, you mean like the one about a bowl of soba noodles?\""
msgstr "「童話って、かけそばとか？」"

#. Occurrence 5B_5:4552:7027: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0054; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4552
msgctxt "text_id=7027 | speaker=aoko"
msgid "\"Let me tell you, it's a small mercy there's no river here. Otherwise, something way better at squishing us would have appeared by now.\""
msgstr "「<遊園地|ここ>に川がないのは不幸中の幸いね。もしあったら、もっと直接制圧に向いた奴が出てきてた」"

#. Occurrence 5B_5:4558:7028: scene=5B_5
#: 5B_5:4558
msgctxt "text_id=7028 | speaker=unknown"
msgid "  Aoko continued, completely ignoring Soujyuro."
msgstr "　草十郎の合いの手をサラッと無視する青子だった。"

#. Occurrence 5B_5:4625:7029: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0055; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4625
msgctxt "text_id=7029 | speaker=aoko"
msgid "\"Anyway, as I was saying..."
msgstr "「―――話の続きだけど。"

#. Occurrence 5B_5:4632:7030: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0056_0; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4632
msgctxt "text_id=7030 | speaker=aoko"
msgid "  The foundation of Alice's magecraft is Mother Goose."
msgstr "　有珠の魔術の基本はマザーグース……"

#. Occurrence 5B_5:4645:7031: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0056_1; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4645
msgctxt "text_id=7031 | speaker=aoko"
msgid "Right, you wouldn't know that either. Mother Goose was an author of whimsical English nursery rhymes."
msgstr "って知らないか。イギリスの唄で、遊び心にとんだ、メルヘンチックな内容よ。"

#. Occurrence 5B_5:4651:7032: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0057; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4651
msgctxt "text_id=7032 | speaker=aoko"
msgid "  To be honest, this type of Ploy Kickshaw isn't all that scary."
msgstr "　ただ、そっち系のプロイキッシャーは怖くないの。"

#. Occurrence 5B_5:4658:7033: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0058; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4658
msgctxt "text_id=7033 | speaker=aoko"
msgid "Taking them down with some form of magecraft is totally possible.\""
msgstr "みんなそれなりに、なんとか魔術にも落としこめる範囲だから」"

#. Occurrence 5B_5:4725:7034: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0025; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:4725
msgctxt "text_id=7034 | speaker=soujuurou"
msgid "\"...I'm afraid to ask, but what about the scary kind, then?\""
msgstr "「……聞きたくないんだけど、そっち系じゃないのは？」"

#. Occurrence 5B_5:4828:7035: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0059; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4828
msgctxt "text_id=7035 | speaker=aoko"
msgid "\"They follow another fairy tale inspired by Mother Goose."
msgstr "「マザーグースを下地にした、とある創作童話系。"

#. Occurrence 5B_5:4834:7036: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0060; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4834
msgctxt "text_id=7036 | speaker=aoko"
msgid "  Alice's mother was particularly fond of it, and every single one is bizarre. No mage wants to go up against one of those things.\""
msgstr "　……<有珠|あの子>のお母さんが好きでね、<こ|・><っ|・><ち|・><系|・>のはドイツもコイツも尋常じゃない。<魔術師|わたしたち>から見ても勘弁してって言いたくなるわ」"

#. Occurrence 5B_5:4857:7037: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0061; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4857
msgctxt "text_id=7037 | speaker=aoko"
msgid "\"As it happens, that's exactly what brought the park back to life."
msgstr "「で、この遊園地を生き返らせたのは<こ|・><っ|・><ち|・><系|・>よ。"

#. Occurrence 5B_5:4863:7038: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0062; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4863
msgctxt "text_id=7038 | speaker=aoko"
msgid "  I'm pretty sure it's the one she calls Flat Snark, though I wasn't particularly paying attention, so I'm a little hazy on the details.\""
msgstr "　たぶんフラットスナークってヤツだと思う。……私も聞き流していたから、詳しくは分からないけど」"

#. Occurrence 5B_5:4918:7039: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0026; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:4918
msgctxt "text_id=7039 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5B_5:4924:7040: scene=5B_5
#: 5B_5:4924
msgctxt "text_id=7040 | speaker=unknown"
msgid "  Soujyuro swallowed the discomfort making its way up his throat."
msgstr "　のど元まで出た不満を飲みこむ。"

#. Occurrence 5B_5:4929:7041: scene=5B_5
#: 5B_5:4929
msgctxt "text_id=7041 | speaker=unknown"
msgid "  He really wanted her to explain things a little less vaguely, but something she had just said necessitated further investigation."
msgstr "　こっち系とかそっち系とか曖昧な言い方はやめてほしい草十郎だったが、今の台詞には、他に追及すべき事があったからだ。"

#. Occurrence 5B_5:4955:7042: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0027; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:4955
msgctxt "text_id=7042 | speaker=soujuurou"
msgid "\"Wait a second, Aozaki. You mean to tell me you weren't paying attention?\""
msgstr "「待て蒼崎。あの子の話を聞き流したって、なんで」"

#. Occurrence 5B_5:4975:7043: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0063; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4975
msgctxt "text_id=7043 | speaker=aoko"
msgid "\"Well, you know, it was a while back that she explained it all to me, and I didn't really believe anything she had to say around then."
msgstr "「いやぁ、説明してもらったのは随分と前だし……あの頃は有珠の話、あんまり信じられなかったのよね。"

#. Occurrence 5B_5:4981:7044: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0064; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4981
msgctxt "text_id=7044 | speaker=aoko"
msgid "  I thought that maybe she was talking up her own magecraft to a newbie, or that she wasn't taking me seriously. Ahaha.\""
msgstr "　私が素人だと思って大げさに自分の魔術を語ってくれてるなあ、舐められてるなあ、とか。あはは」"

#. Occurrence 5B_5:5024:7045: scene=5B_5
#: 5B_5:5024
msgctxt "text_id=7045 | speaker=unknown"
msgid "  In truth, if anyone hadn't taken the lesson seriously, it was Aoko."
msgstr "　無論、舐めていたのは青子の方だった。"

#. Occurrence 5B_5:5029:7046: scene=5B_5
#: 5B_5:5029
msgctxt "text_id=7046 | speaker=unknown"
msgid "  She would learn that lesson firsthand soon enough, when she experienced just how real Alice's monsters were."
msgstr "　有珠を守る怪物が「本物」だと青子が経験するのは、二人が出会ってからしばらくしての事だ。"

#. Occurrence 5B_5:5034:7047: scene=5B_5
#: 5B_5:5034
msgctxt "text_id=7047 | speaker=unknown"
msgid "  She'd also discover how heretical the Meinster witches truly were, in the world of magecraft."
msgstr "　マインスターの魔女が魔術世界においてどれほど異端なのか、青子は身をもって経験する事になる。"

#. Occurrence 5B_5:5071:7048: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0028; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:5071
msgctxt "text_id=7048 | speaker=soujuurou"
msgid "\"...Can you remember anything else about them?\""
msgstr "「……その聞き流した内容は？」"

#. Occurrence 5B_5:5083:7049: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0065; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5083
msgctxt "text_id=7049 | speaker=aoko"
msgid "\"From what I understand, it's a Ploy that puts up a powerful Bounded Field."
msgstr "「なんでも強力な結界を張るプロイだって。"

#. Occurrence 5B_5:5090:7050: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0066; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5090
msgctxt "text_id=7050 | speaker=aoko"
msgid "Alice inherited a lot of Ploys, but this is one of her finest."
msgstr "有珠が受け継いだ<玩具|プロイ>は山ほどあるけど、その中でも<選|え>りすぐりの一つよ。"

#. Occurrence 5B_5:5096:7051: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0067; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5096
msgctxt "text_id=7051 | speaker=aoko"
msgid "  It takes discarded and forgotten things and resurrects them like what happens in fairy tales. Supposedly, nobody's ever defeated it."
msgstr "　<棄|す>てられたモノ、忘れられたモノを童話的に蘇らせるヤツで、今まで誰も破ったコトがないとか。"

#. Occurrence 5B_5:5149:7052: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0068; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5149
msgctxt "text_id=7052 | speaker=aoko"
msgid "  Oh, and its nickname is 'The Untouchable.'\""
msgstr "　それで、ついたあだ名が“<触|ふ>れられぬもの”」"

#. Occurrence 5B_5:5170:7053: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0029; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:5170
msgctxt "text_id=7053 | speaker=soujuurou"
msgid "\"So it's not Flat Snark, or whatever it was?\""
msgstr "「？　ふらっとすなーく、じゃないのか？」"

#. Occurrence 5B_5:5183:7054: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0069; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5183
msgctxt "text_id=7054 | speaker=aoko"
msgid "\"That's just a nickname, too. Since nobody knows what its real form is, it picked up a few names along the way."
msgstr "「それもあだ名。とにかく正体が分からないヤツばっかりなんで、一つの個体に複数の名前がつけられるの。"

#. Occurrence 5B_5:5189:7055: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0070; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5189
msgctxt "text_id=7055 | speaker=aoko"
msgid "  One of them is 'Flat Snark,' and it ranks high among her other nonsense in terms of how little is known about it."
msgstr "　フラットスナークはその中でも、正体不明さはトップランクのデタラメぶりよ。"

#. Occurrence 5B_5:5202:7056: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0071; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5202
msgctxt "text_id=7056 | speaker=aoko"
msgid "  Have you heard of the book The Hunting of the Snark by Lewis Carroll?\""
msgstr "　―――貴方、ルイス・キャロルの『スナーク狩り』って本、知ってる？」"

#. Occurrence 5B_5:5251:7057: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0030; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:5251
msgctxt "text_id=7057 | speaker=soujuurou"
msgid "\"No, and who is Loo-wis Car-rel?\""
msgstr "「いや。そもそもルイスキャロルというのは？」"

#. Occurrence 5B_5:5263:7058: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0072; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5263
msgctxt "text_id=7058 | speaker=aoko"
msgid "\"Okay, then... let's start from the beginning. Professor Dodgson was, hmm. He was a delusional gentleman with a peculiar disposition. Not that it matters right now. It's a waste of time to explain to some people.\""
msgstr "「……そっからかあ……えーと、ドジスン教授は、そうね。特殊性癖を持った妄想紳士ってトコ？　ま、こっちは別にどうでもいいか。人によっては時間の無駄だろうし」"

#. Occurrence 5B_5:5289:7059: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0073; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5289
msgctxt "text_id=7059 | speaker=aoko"
msgid "\"What's important is the work he left behind."
msgstr "「いま重要なのは、彼が残した著作の方。"

#. Occurrence 5B_5:5295:7060: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0074; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5295
msgctxt "text_id=7060 | speaker=aoko"
msgid "  The Hunting of the Snark is a book about a band of adventurers who try to capture an unidentified monster known as the Snark.\""
msgstr "　『スナーク狩り』はね、スナークって呼ばれる正体不明の怪物を捕まえようと奔走する冒険家たちの話なの」"

#. Occurrence 5B_5:5358:7061: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0075; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5358
msgctxt "text_id=7061 | speaker=aoko"
msgid "\"It's very Carroll: satirical, nonsensical, and cryptic. It doesn't even really have an ending, either. Though the party does ultimately find the Snark on its island after much hardship, it ends with the protagonist who found it, the Baker, suddenly disappearing."
msgstr "「キャロルらしい、皮肉ばっちり、支離滅裂、意味不明、結末不在のホントに困った本で、一行は島で苦しみつつ、最終的にはスナークを見つけるものの、見つけた<主人公|ベイカー>は唐突に姿を消して終わってしまう。"

#. Occurrence 5B_5:5364:7062: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0076; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5364
msgctxt "text_id=7062 | speaker=aoko"
msgid "  It's a satire about people who run about busily trying to find something they don't understand. But when it comes to the park here, it's pretty clear who the Baker is and who the Snark is, right?\""
msgstr "“よく分からないもの”探しに奔走する人間の風刺なんだけど―――この遊園地において、誰が<主人公|ベイカー>で、何が<怪物|スナーク>かは言うまでもないでしょ？」"

#. Occurrence 5B_5:5391:7063: scene=5B_5
#: 5B_5:5391
msgctxt "text_id=7063 | speaker=unknown"
msgid "  Aoko elected not to share this, but Flat Snark had other popular names as well."
msgstr "　青子は語らないが、フラットスナークには他にも俗称がある。"

#. Occurrence 5B_5:5396:7064: scene=5B_5
#: 5B_5:5396
msgctxt "text_id=7064 | speaker=unknown"
msgid "  The Enigmatic Island. The Five-Dimensional Plane."
msgstr "　不可解の島、五次元平面。"

#. Occurrence 5B_5:5401:7065: scene=5B_5
#: 5B_5:5401
msgctxt "text_id=7065 | speaker=unknown"
msgid "  These names were not given to it by Alice, but rather muttered by mages whom the Meinsters defeated."
msgstr "　こちらは有珠が口にしたものではなく、かつてマインスターに破れた魔術師たちのうわごとだ。"

#. Occurrence 5B_5:5464:7066: scene=5B_5
#: 5B_5:5464
msgctxt "text_id=7066 | speaker=unknown"
msgid "  In mathematics, 'snark' is a term used in graph theory to refer to contradictory and impossible planar graphs."
msgstr "　数学において、スナークとはグラフ理論で用いられる、矛盾した、決してあり得ないある平面グラフを指す。"

#. Occurrence 5B_5:5469:7067: scene=5B_5
#: 5B_5:5469
msgctxt "text_id=7067 | speaker=unknown"
msgid "  A plane, proven to be unable to exist in this world, was given the name, apt for an ill-fated existence paradoxical in nature."
msgstr "　この世に『無い』と立証されながらも名を与えられた平面。逆説のみで構成された不遇の存在。"

#. Occurrence 5B_5:5474:7068: scene=5B_5
#: 5B_5:5474
msgctxt "text_id=7068 | speaker=unknown"
msgid "  The fairy-tale monster ascribed this name was said to hold no form discoverable by man."
msgstr "　その名を冠した“童話の怪物”は、誰にも正体を明かす事がないという。"

#. Occurrence 5B_5:5495:7069: scene=5B_5
#: 5B_5:5495
msgctxt "text_id=7069 | speaker=unknown"
msgid "  Aoko also declined to mention something else:"
msgstr "　……そして、青子は語らない。"

#. Occurrence 5B_5:5500:7070: scene=5B_5
#: 5B_5:5500
msgctxt "text_id=7070 | speaker=unknown"
msgid "  Flat Snark was a fairy-tale monster that could grow."
msgstr "　フラットスナークは成長する“童話の怪物”だ。"

#. Occurrence 5B_5:5505:7071: scene=5B_5
#: 5B_5:5505
msgctxt "text_id=7071 | speaker=unknown"
msgid "  It would hide somewhere in the amusement park, continuously exhaling magical energy until the park completely transformed into a fantasy land."
msgstr "　どこかに隠れている本体は、こうしている今も遊園地を完全な御伽の国に変えようと、<魔|い><力|き>を吐き続けている事を。"

#. Occurrence 5B_5:5586:7072: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0077; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5586
msgctxt "text_id=7072 | speaker=aoko"
msgid "\"...Well, it's not like there's any point in scaring him.\""
msgstr "「……ま、<脅|おど>かしてもしょうがないし」"

#. Occurrence 5B_5:5619:7073: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0031; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:5619
msgctxt "text_id=7073 | speaker=soujuurou"
msgid "\"Did you say something, Aozaki?\""
msgstr "「なにか言ったか？」"

#. Occurrence 5B_5:5630:7074: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0078; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5630
msgctxt "text_id=7074 | speaker=aoko"
msgid "\"Nope. I was just thinking, Flat Snark's power is its ability to bring fairy-tale worlds to life..."
msgstr "「別に。簡単に言って、『童話世界の再生』がフラットスナークの力なの。"

#. Occurrence 5B_5:5636:7075: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0079; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5636
msgctxt "text_id=7075 | speaker=aoko"
msgid "  When you think about it, the park makes for the perfect backdrop. I mean, it was originally a playground based on fairy tales, anyway.\""
msgstr "　この遊園地との相性は抜群でしょうね。なにしろ、元々が童話を元にした遊び場だから」"

#. Occurrence 5B_5:5664:7076: scene=5B_5
#: 5B_5:5664
msgctxt "text_id=7076 | speaker=unknown"
msgid "  If this had been a business district, for example, Flat Snark would have posed far less of a threat."
msgstr "　……仮にオフィス街であったのなら、フラットスナークもここまでの脅威は持たなかっただろう。"

#. Occurrence 5B_5:5669:7077: scene=5B_5
#: 5B_5:5669
msgctxt "text_id=7077 | speaker=unknown"
msgid "  At most, its power would be limited to projecting the shadow of a dinosaur onto a building's window panes."
msgstr "　せいぜいビルの窓硝子に恐竜の影絵を映す程度の力だ。"

#. Occurrence 5B_5:5702:7078: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0032; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:5702
msgctxt "text_id=7078 | speaker=soujuurou"
msgid "\"Ah, so that's why it's safe―"
msgstr "「あ。だからここは安全だって―――"

msgctxt "text_id=7079 | speaker=unknown"
msgid " Hm?\""
msgstr "ん？」"

#. Occurrence 5B_5:5724:7080: scene=5B_5
#: 5B_5:5724
msgctxt "text_id=7080 | speaker=unknown"
msgid "  Soujyuro realized that something was wrong when he noticed a glutinous liquid dripping onto his back."
msgstr "　草十郎が“その異変”に気が付いたのは、背中にぴちょん、と<粘|ねば>つく液体が落ちたからだ。"

#. Occurrence 5B_5:5795:7081: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0033; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:5795
msgctxt "text_id=7081 | speaker=soujuurou"
msgid "\"Uh, um―\""
msgstr "「あ、あ―――」"

#. Occurrence 5B_5:5800:7082: scene=5B_5
#: 5B_5:5800
msgctxt "text_id=7082 | speaker=unknown"
msgid "  He looked up to the ceiling."
msgstr "　天井を見上げる。"

#. Occurrence 5B_5:5806:7083: scene=5B_5
#: 5B_5:5806
msgctxt "text_id=7083 | speaker=unknown"
msgid "Their eyes met."
msgstr "<ソ|・><レ|・>と目が合う。"

#. Occurrence 5B_5:5812:7084: scene=5B_5
#: 5B_5:5812
msgctxt "text_id=7084 | speaker=unknown"
msgid "Before he had a chance to think, Soujyuro hopped up from the floor."
msgstr "どうなっているのか考える前に、草十郎の腰は跳ね上がって―――"

#. Occurrence 5B_5:5857:7085: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0034; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:5857
msgctxt "text_id=7085 | speaker=soujuurou"
msgid "\"Aozaki, get out, now!\""
msgstr "「蒼崎、外だ！」"

#. Occurrence 5B_5:5863:7086: scene=5B_5
#: 5B_5:5863
msgctxt "text_id=7086 | speaker=unknown"
msgid "  Taking the initiative, he jumped out from behind the counter."
msgstr "　彼は<率先|そっせん>してカウンターから飛び出した。"

#. Occurrence 5B_5:5901:7087: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0080; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5901
msgctxt "text_id=7087 | speaker=aoko"
msgid "\"Are you mad? What do you think you're―\""
msgstr "「バカ、何して―――」"

#. Occurrence 5B_5:5921:7088: scene=5B_5
#: 5B_5:5921
msgctxt "text_id=7088 | speaker=unknown"
msgid "  Trying to stop him from committing an act of suicide, she also came to her feet."
msgstr "　自殺行為に等しい愚行を止めようと、つられて青子は腰を浮かす。"

#. Occurrence 5B_5:5926:7089: scene=5B_5
#: 5B_5:5926
msgctxt "text_id=7089 | speaker=unknown"
msgid "  Immediately, she noticed something coming to life overhead."
msgstr "　瞬間、頭上に何が生まれているのかに気が付いた。"

#. Occurrence 5B_5:5994:7090: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0081; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5994
msgctxt "text_id=7090 | speaker=aoko"
msgid "\"What the―!? Oh, crap!\""
msgstr "「！　って、ヤバ―――!?」"

#. Occurrence 5B_5:6225:7091: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0082; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:6225
msgctxt "text_id=7091 | speaker=aoko"
msgid "\"Oh my god, that was close!\""
msgstr "「あ、危なかったぁ……！」"

#. Occurrence 5B_5:6242:7092: scene=5B_5
#: 5B_5:6242
msgctxt "text_id=7092 | speaker=unknown"
msgid "  The gargantuan mouth clamped shut."
msgstr "　ばくん、と閉じられる巨大な口。"

#. Occurrence 5B_5:6247:7093: scene=5B_5
#: 5B_5:6247
msgctxt "text_id=7093 | speaker=unknown"
msgid "  With no mascot to speak of, the burger joint itself began to transform into one giant monster."
msgstr "　呼びこみマスコットのいないバーガーショップは、その店ごと怪物に変貌していた。"

#. Occurrence 5B_5:6322:7094: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0083; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:6322
msgctxt "text_id=7094 | speaker=aoko"
msgid "\"Who the hell paints a giant clown on the ceiling!?"
msgstr "「もうっ、なんで天井にピエロの絵なんて描いてんのよあの店！？"

#. Occurrence 5B_5:6329:7095: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0084; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:6329
msgctxt "text_id=7095 | speaker=aoko"
msgid "  Shouldn't they have flexed their creative muscle somehow else!? If they liked clowns that much, why didn't they put it at the entrance!?\""
msgstr "　普通、もっと違うところに労力さかない！？　そんなにピエロが好きなら入り口にでも飾っとけ！」"

#. Occurrence 5B_5:6335:7096: scene=5B_5
#: 5B_5:6335
msgctxt "text_id=7096 | speaker=unknown"
msgid "  Aoko aired out her grievances as she ran."
msgstr "　罵倒しながら走る青子。"

#. Occurrence 5B_5:6340:7097: scene=5B_5
#: 5B_5:6340
msgctxt "text_id=7097 | speaker=unknown"
msgid "  ...There was no safe haven left."
msgstr "　……もう安全な場所はどこにもない。"

#. Occurrence 5B_5:6345:7098: scene=5B_5
#: 5B_5:6345
msgctxt "text_id=7098 | speaker=unknown"
msgid "  Moment by moment, the last remnants of civilization were being eroded away by fairy tales."
msgstr "　かろうじて残っていた文明圏すら、刻一刻と童話に侵食されていた。"

#. Occurrence 5B_6:310:7099: scene=5B_6
#: 5B_6:310
msgctxt "text_id=7099 | speaker=unknown"
msgid "  The amusement park had reached the final stage of Snarkification."
msgstr "　遊園地のスナーク化は最終段階を迎えていた。"

#. Occurrence 5B_6:315:7100: scene=5B_6
#: 5B_6:315
msgctxt "text_id=7100 | speaker=unknown"
msgid "  It was not just the mascot characters that had been granted life;"
msgstr "　命を与えられたのはマスコットたちだけではない。"

#. Occurrence 5B_6:320:7101: scene=5B_6
#: 5B_6:320
msgctxt "text_id=7101 | speaker=unknown"
msgid "  like the burger joint, even the buildings had begun to transform."
msgstr "　バーガーショップのように、建物すら生き物に変貌しようとしている。"

#. Occurrence 5B_6:325:7102: scene=5B_6
#: 5B_6:325
msgctxt "text_id=7102 | speaker=unknown"
msgid "  The roller coaster that made its way about the park writhed and twisted like a Chinese dragon."
msgstr "　遊園地を巡るコースターは<中華龍|チャイニーズドラゴン>よろしく、うねうねとのたうつ始末。"

#. Occurrence 5B_6:433:7103: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0000; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:433
msgctxt "text_id=7103 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 5B_6:506:7104: scene=5B_6
#: 5B_6:506
msgctxt "text_id=7104 | speaker=unknown"
msgid "  Aoko and Soujyuro stared, dumbfounded by the Ferris wheel, which had grown to over two hundred and fifty feet in height."
msgstr "　呆然と、全長八十メートル近くまで膨張した観覧車を見上げる青子と草十郎。"

#. Occurrence 5B_6:511:7105: scene=5B_6
#: 5B_6:511
msgctxt "text_id=7105 | speaker=unknown"
msgid "  Hordes of bread-men closed in on them, as if to offer tickets."
msgstr "　そんなふたりにチケットを配るように、大量のブレッドマンが襲いかかる。"

#. Occurrence 5B_6:605:7106: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0001; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:605
msgctxt "text_id=7106 | speaker=aoko"
msgid "\"I'm telling you, the line is under control!\""
msgstr "「このっ、列整理は間に合ってるっての！」"

#. Occurrence 5B_6:685:7107: scene=5B_6
#: 5B_6:685
msgctxt "text_id=7107 | speaker=unknown"
msgid "  Mobs of trinkets―actual kickshaws―rampaged the park."
msgstr "　わらわらと大挙するオブジェ。"

#. Occurrence 5B_6:690:7108: scene=5B_6
#: 5B_6:690
msgctxt "text_id=7108 | speaker=unknown"
msgid "  Whenever a hole was punched in the envelopment, it was instantly filled."
msgstr "　包囲網は破っても破っても形成される。"

#. Occurrence 5B_6:695:7109: scene=5B_6
#: 5B_6:695
msgctxt "text_id=7109 | speaker=unknown"
msgid "  It was a battle of attrition with no end in sight."
msgstr "　絶え間ない物量作戦。"

#. Occurrence 5B_6:701:7110: scene=5B_6
#: 5B_6:701
msgctxt "text_id=7110 | speaker=unknown"
msgid "But that was a matter of course, as there were few fairy tales about limited resources."
msgstr "さもありなん、資源の<枯渇|こかつ>で悩むおとぎ<噺|ばなし>は<滅多|めった>にない……！"

#. Occurrence 5B_6:785:7111: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_6_0000; voice_prefix=A30; voice_category=3; scene=5B_6
#: 5B_6:785
msgctxt "text_id=7111 | speaker=soujuurou"
msgid "\"This is hopeless!"
msgstr "「っ、なんかどうしようもないぞ！"

#. Occurrence 5B_6:785:7112: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_6_0000; voice_prefix=A30; voice_category=3; scene=5B_6
#: 5B_6:785
msgctxt "text_id=7112 | speaker=soujuurou"
msgid "  They just keep coming!\""
msgstr "　コイツら、増える一方だ！」"

#. Occurrence 5B_6:853:7113: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0002; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:853
msgctxt "text_id=7113 | speaker=aoko"
msgid "\"Look for the Snark's real form!"
msgstr "「スナーク本体を探して！"

#. Occurrence 5B_6:859:7114: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0003; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:859
msgctxt "text_id=7114 | speaker=aoko"
msgid "  A fairy tale monster always has some vessel for its body! If we can just destroy that, we should be able to get out of here!\""
msgstr "　童話の怪物には本体にあたる器物があるの！　それさえ壊せば遊園地から出られるはず！」"

#. Occurrence 5B_6:1023:7115: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_6_0001; voice_prefix=A30; voice_category=3; scene=5B_6
#: 5B_6:1023
msgctxt "text_id=7115 | speaker=soujuurou"
msgid "\"A body? What kind of body?!\""
msgstr "「本体ってどんな!?」"

#. Occurrence 5B_6:1135:7116: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0004; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1135
msgctxt "text_id=7116 | speaker=aoko"
msgid "\"I already told you, fairy tale monsters can't exist in reality! Anything weird or impossible you've never seen before―that's going to be it!\""
msgstr "「さっき言ったでしょ、童話の怪物は現実に無いものだって！　今までいなかったおかしなヤツとか、現実じゃありえないモノ！　それが本体！」"

#. Occurrence 5B_6:1189:7117: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_6_0002; voice_prefix=A30; voice_category=3; scene=5B_6
#: 5B_6:1189
msgctxt "text_id=7117 | speaker=soujuurou"
msgid "\"Something weird or impossible? I need an example!\""
msgstr "「おかしなヤツって、たとえば!?」"

#. Occurrence 5B_6:1325:7118: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0005; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1325
msgctxt "text_id=7118 | speaker=aoko"
msgid "\"Do I have to spell it out for you?!"
msgstr "「だから！"

#. Occurrence 5B_6:1331:7119: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0006; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1331
msgctxt "text_id=7119 | speaker=aoko"
msgid "  Living puppets, flying go karts...\""
msgstr "　命のある人形とか、空飛ぶゴーカートとか―――」"

#. Occurrence 5B_6:1373:7120: scene=5B_6
#: 5B_6:1373
msgctxt "text_id=7120 | speaker=unknown"
msgid "  Aoko paused her firing for a moment."
msgstr "　魔弾を放つ青子の手が止まる。"

#. Occurrence 5B_6:1378:7121: scene=5B_6
#: 5B_6:1378
msgctxt "text_id=7121 | speaker=unknown"
msgid "  After saying this out loud, she realized just how deep their grave was dug."
msgstr "　口にして、自分たちがどれほど<窮|きわ>まっているかを思い知ったのだ。"

#. Occurrence 5B_6:1383:7122: scene=5B_6
#: 5B_6:1383
msgctxt "text_id=7122 | speaker=unknown"
msgid "  The amusement park was a treasure trove of fairy tale-esque creatures on any given day."
msgstr "　遊園地は“童話の怪物”と思われるモノであふれている。"

#. Occurrence 5B_6:1388:7123: scene=5B_6
#: 5B_6:1388
msgctxt "text_id=7123 | speaker=unknown"
msgid "  Who could say what was impossible amidst the newly transfigured knickknacks running around?"
msgstr "　変形し、自ら動き出したオブジェたちはみな“現実にないモノ”なのだ。"

#. Occurrence 5B_6:1478:7124: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0007; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1478
msgctxt "text_id=7124 | speaker=aoko"
msgid "\"...Damn. Everything in here is weird.\""
msgstr "「……そっか。おかしくないヤツなんて、一つもないんだ」"

#. Occurrence 5B_6:1537:7125: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0008; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1537
msgctxt "text_id=7125 | speaker=aoko"
msgid "(So it's hiding in plain sight...)"
msgstr "“この中に紛れこんでる……？”"

#. Occurrence 5B_6:1553:7126: scene=5B_6
#: 5B_6:1553
msgctxt "text_id=7126 | speaker=unknown"
msgid "  Hoping that she was wrong, Aoko bit her bottom lip."
msgstr "　青子は呟きながら、それはないな、と唇を噛んだ。"

#. Occurrence 5B_6:1573:7127: scene=5B_6
#: 5B_6:1573
msgctxt "text_id=7127 | speaker=unknown"
msgid "  Flat Snark was the type of Ploy that deployed Bounded Fields."
msgstr "　フラットスナークは結界を張るタイプの<怪物|プロイ>だ。"

#. Occurrence 5B_6:1578:7128: scene=5B_6
#: 5B_6:1578
msgctxt "text_id=7128 | speaker=unknown"
msgid "  Seeing as it was commanding so many familiars, it would not be unusual for its main body to have little or even no defenses."
msgstr "　これだけ大量の使い魔を統率している以上、本体の防御力は低いか、もしくは<皆無|かいむ>と見るべきだろう。"

#. Occurrence 5B_6:1584:7129: scene=5B_6
#: 5B_6:1584
msgctxt "text_id=7129 | speaker=unknown"
msgid "  Furthermore, if it was modeled from a story about it being untouchable and unidentifiable, it would be logical to assume that it would collapse in on itself shortly after being discovered."
msgstr "　……加えて、“触れられぬもの”“正体不明”という物語を原型としているのなら、見抜かれたが最後、呆気なく崩壊するのが筋というもの。"

#. Occurrence 5B_6:1623:7130: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0009; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1623
msgctxt "text_id=7130 | speaker=aoko"
msgid "(Which means... We find it, we win."
msgstr "“……逆に言えば、見つければ私たちの勝ち。"

#. Occurrence 5B_6:1629:7131: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0010; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1629
msgctxt "text_id=7131 | speaker=aoko"
msgid "  Would something so fragile really hide among its minions? They do say that the best place to hide a leaf is in the woods...)"
msgstr "　そんな<脆|もろ>いヤツが雑魚に紛れこむ？　木の葉を隠すなら森の中って言うけど―――”"

#. Occurrence 5B_6:1758:7132: scene=5B_6
#: 5B_6:1758
msgctxt "text_id=7132 | speaker=unknown"
msgid "  This was closer to the truth than Aoko realized."
msgstr "　この通り。"

#. Occurrence 5B_6:1763:7133: scene=5B_6
#: 5B_6:1763
msgctxt "text_id=7133 | speaker=unknown"
msgid "  As long as there was the slightest possibility of it being hit by one of Aoko's stray bullets, it would not dare appear in front of them."
msgstr "　流れ弾であっさり吹き飛ぶ可能性がある以上、青子たちの前には現れない。"

#. Occurrence 5B_6:1768:7134: scene=5B_6
#: 5B_6:1768
msgctxt "text_id=7134 | speaker=unknown"
msgid "  Its true form was orchestrating the park from somewhere safe."
msgstr "　スナーク本体はもっと安全な場所で、この遊園地を育てている。"

#. Occurrence 5B_6:1856:7135: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0011; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1856
msgctxt "text_id=7135 | speaker=aoko"
msgid "(I'm sure we've seen it already."
msgstr "“……でもどこかに見えているはず。"

#. Occurrence 5B_6:1862:7136: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0012; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1862
msgctxt "text_id=7136 | speaker=aoko"
msgid "  It's the subject of a book named after it. If it's not standing out on every page, it has no right to be the title character!)"
msgstr "　スナークは本の主題だもの。<常|つね>に<視界|ページ>のどこかにいないと、主人公の資格がない―――！”"

#. Occurrence 5B_6:1868:7137: scene=5B_6
#: 5B_6:1868
msgctxt "text_id=7137 | speaker=unknown"
msgid "  But where?"
msgstr "　それはどこか。"

#. Occurrence 5B_6:1873:7138: scene=5B_6
#: 5B_6:1873
msgctxt "text_id=7138 | speaker=unknown"
msgid "  Put very simply, the Ferris wheel was the safest location in the park, as well as a symbol of its past glory. Perhaps..."
msgstr "　安易に考えるなら、あの観覧車がもっとも安全、かつ遊園地を象徴する“主題”だが―――"

#. Occurrence 5B_6:1944:7139: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_6_0003; voice_prefix=A30; voice_category=3; scene=5B_6
#: 5B_6:1944
msgctxt "text_id=7139 | speaker=soujuurou"
msgid "\"What if we just try to catch her instead!?\""
msgstr "「あの子を捕まえるのは！？」"

#. Occurrence 5B_6:1957:7140: scene=5B_6
#: 5B_6:1957
msgctxt "text_id=7140 | speaker=unknown"
msgid "  Her eyes opened wide at the sudden suggestion."
msgstr "　突然の提案に目を見張る。"

#. Occurrence 5B_6:1962:7141: scene=5B_6
#: 5B_6:1962
msgctxt "text_id=7141 | speaker=unknown"
msgid "  While Aoko had been trying to come up with a plan to overcome this stalemate, it seemed Soujyuro had been racking his brain as well."
msgstr "　青子が打開策を思案していたように、草十郎もまた、彼なりに頭を巡らせていたらしい。"

#. Occurrence 5B_6:2017:7142: scene=5B_6
#: 5B_6:2017
msgctxt "text_id=7142 | speaker=unknown"
msgid "  His proposal was a simple one."
msgstr "　草十郎の提案はシンプルだ。"

#. Occurrence 5B_6:2022:7143: scene=5B_6
#: 5B_6:2022
msgctxt "text_id=7143 | speaker=unknown"
msgid "  If they could not find the Snark, they just needed to take out its master, Alice."
msgstr "　スナークの本体が見つけられないのなら、その持ち主である有珠を倒せばいいのではないか。"

#. Occurrence 5B_6:2027:7144: scene=5B_6
#: 5B_6:2027
msgctxt "text_id=7144 | speaker=unknown"
msgid "  Alice had not moved at all from the clock tower."
msgstr "　有珠は時計台から動いていない。"

#. Occurrence 5B_6:2032:7145: scene=5B_6
#: 5B_6:2032
msgctxt "text_id=7145 | speaker=unknown"
msgid "  Even from here, they could make out her figure, draped in moonlight."
msgstr "　ここからでも、月光に照らされる姿は目に入る。"

#. Occurrence 5B_6:2091:7146: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0013; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:2091
msgctxt "text_id=7146 | speaker=aoko"
msgid "\"That's the worst move we could make!"
msgstr "「それは一番ダメ！"

#. Occurrence 5B_6:2098:7147: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0014; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:2098
msgctxt "text_id=7147 | speaker=aoko"
msgid "  Even if we killed her, it wouldn't stop the Snark, and all of this absurdity would just boil over to outside the park!"
msgstr "　有珠を殺してもフラットスナークは止まらないし、このトンデモが外にあふれだす事になる！"

#. Occurrence 5B_6:2110:7148: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0015; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:2110
msgctxt "text_id=7148 | speaker=aoko"
msgid "  Not to mention, I can't even kill her in the first place! At best, I could only get halfway there!\""
msgstr "　だいたい、私じゃあの子を殺せないから！　よくて半殺しがいいところ！」"

#. Occurrence 5B_6:2230:7149: scene=5B_6
#: 5B_6:2230
msgctxt "text_id=7149 | speaker=unknown"
msgid "  A bread-man, angered at the insults hurled toward its master, moved to attack and was mercilessly burned to a crisp."
msgstr "　主人の悪口にいきりたったブレッドマンが、こんがり無惨に焼け焦げになる。"

#. Occurrence 5B_6:2307:7150: scene=5B_6
#: 5B_6:2307
msgctxt "text_id=7150 | speaker=unknown"
msgid "  The two stood back-to-back, catching their breath."
msgstr "　……じり、と背中をあわせて呼吸を整えるふたり。"

#. Occurrence 5B_6:2312:7151: scene=5B_6
#: 5B_6:2312
msgctxt "text_id=7151 | speaker=unknown"
msgid "  With no plan to speak of and no route of escape, they had reached rock bottom."
msgstr "　目の醒めるような打開策は出ず、いよいよもって八方ふさがりになった状況に消沈する。"

#. Occurrence 5B_7:52:7152: scene=5B_7
#: 5B_7:52
msgctxt "text_id=7152 | speaker=unknown"
msgid "  Meanwhile, the oddities were forming a circle around their prey, as if they smelled blood in the water."
msgstr "　一方。<獲物|えもの>の活きの良さが分かるのか、オブジェたちは輪になって青子たちを観察していた。"

#. Occurrence 5B_7:58:7153: scene=5B_7
#: 5B_7:58
msgctxt "text_id=7153 | speaker=unknown"
msgid "  Were they to be dragged into a bakery for the oven?"
msgstr "　パン屋にひきずりこんで焼き殺すか、"

msgctxt "text_id=7154 | speaker=unknown"
msgid "  Minced in the meat grinder at the butcher shop?"
msgstr "　精肉店の挽肉機ですり潰すか。"

#. Occurrence 5B_7:66:7155: scene=5B_7
#: 5B_7:66
msgctxt "text_id=7155 | speaker=unknown"
msgid "  Skewered and paraded around atop the carousel?"
msgstr "　はたまた串刺しにしてゴーラウンドで引き回すか、"

msgctxt "text_id=7156 | speaker=unknown"
msgid "  Walk the plank of the thorny pirate ship?"
msgstr "　トゲトゲだらけの<海賊船|ゆりかご>に乗せて航海に乗りだすか。"

#. Occurrence 5B_7:112:7157: scene=5B_7
#: 5B_7:112
msgctxt "text_id=7157 | speaker=unknown"
msgid "  After two years of slumber, they were eager to welcome their new guests."
msgstr "　二年間眠っていた分、歓迎意欲は盛りだくさんだ。"

#. Occurrence 5B_7:181:7158: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_7_0000; voice_prefix=A30; voice_category=3; scene=5B_7
#: 5B_7:181
msgctxt "text_id=7158 | speaker=soujuurou"
msgid "\"There's something I need to ask you, Aozaki.\""
msgstr "「……いちおう、聞いておきたいんだけど」"

#. Occurrence 5B_7:198:7159: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0000; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:198
msgctxt "text_id=7159 | speaker=aoko"
msgid "\"What is it? Keep it snappy. I'm thinking here.\""
msgstr "「なに。手短にね、いま考え事してるから」"

#. Occurrence 5B_7:215:7160: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_7_0001; voice_prefix=A30; voice_category=3; scene=5B_7
#: 5B_7:215
msgctxt "text_id=7160 | speaker=soujuurou"
msgid "\"Okay. It's painfully clear what these things want to do to us, but what about her? Does she enjoy this?\""
msgstr "「ああ。……あの連中がなにをしたいか、イヤっていうほど伝わってくるんだけど。それって、あの子の趣味なのかな」"

#. Occurrence 5B_7:254:7161: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0001; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:254
msgctxt "text_id=7161 | speaker=aoko"
msgid "\"I doubt it."
msgstr "「……その疑問はなかったわ。"

#. Occurrence 5B_7:261:7162: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0002; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:261
msgctxt "text_id=7162 | speaker=aoko"
msgid "These things' hatred of humans comes from a deep-seated grudge within the park itself, and maybe even Flat Snark's personality too. Alice's familiars are one big family of freaks."
msgstr "連中の人間嫌いは遊園地の怨念と、フラットスナークの性格じゃない？　基本的にマトモなヤツいないから、有珠の使い魔って。"

#. Occurrence 5B_7:273:7163: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0003; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:273
msgctxt "text_id=7163 | speaker=aoko"
msgid "  Though, now that you mention it...\""
msgstr "　ああ、でも―――」"

#. Occurrence 5B_7:327:7164: scene=5B_7
#: 5B_7:327
msgctxt "text_id=7164 | speaker=unknown"
msgid "  Aoko was unable to deny that there were some similarities."
msgstr "　なんというか、有珠の性格の怖さも否定できない青子だった。"

#. Occurrence 5B_7:354:7165: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_7_0002; voice_prefix=A30; voice_category=3; scene=5B_7
#: 5B_7:354
msgctxt "text_id=7165 | speaker=soujuurou"
msgid "\"Good to know. ...So, did you come up with anything, Aozaki? How do we stop them?\""
msgstr "「それは結構。……それで、蒼崎の考えごとって？　止める方法、考えついたのか？」"

#. Occurrence 5B_7:365:7166: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0004; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:365
msgctxt "text_id=7166 | speaker=aoko"
msgid "\"Sorry to get your hopes up, but I'm all out of ideas. Oh, but I bet they'd stop if you dropped dead.\""
msgstr "「期待させて悪いけどお手上げ。ま、アンタが殺されれば止まるでしょうけど」"

#. Occurrence 5B_7:377:7167: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_7_0003; voice_prefix=A30; voice_category=3; scene=5B_7
#: 5B_7:377
msgctxt "text_id=7167 | speaker=soujuurou"
msgid "\"No, thank you! Let's just get out of here!\""
msgstr "「それはイヤだ！　とりあえず逃げよう！」"

#. Occurrence 5B_7:405:7168: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0005; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:405
msgctxt "text_id=7168 | speaker=aoko"
msgid "\"Hey, wait! Sizuki!?\""
msgstr "「え、ちょっ、静希君！？」"

#. Occurrence 5B_7:474:7169: scene=5B_7
#: 5B_7:474
msgctxt "text_id=7169 | speaker=unknown"
msgid "  She blinked in surprise at the sudden turn of events."
msgstr "　―――突然の<展|こ><開|と>に目を見張る。"

#. Occurrence 5B_7:480:7170: scene=5B_7
#: 5B_7:480
msgctxt "text_id=7170 | speaker=unknown"
msgid "  Soujyuro, who had until now been meekly following her lead, had grabbed Aoko's hand and pulled her with him into a head-on charge at the swarm of bread, in an attempt to break out of the encirclement."
msgstr "　今まで青子に付いてくるだけだった草十郎は強引に青子の手を取って、焼きたてパンの群に突進―――囲みを<破|やぶ>ろうと力任せに特攻する。"

#. Occurrence 5B_7:740:7171: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0006; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:740
msgctxt "text_id=7171 | speaker=aoko"
msgid "\"Are you out of your mind!?"
msgstr "「い、意味わかんなすぎ！"

#. Occurrence 5B_7:746:7172: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0007; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:746
msgctxt "text_id=7172 | speaker=aoko"
msgid "  How on earth do you figure this is what we do next!?\""
msgstr "　なんで今の流れでそうなるのよアンタはーーーー！？」"

#. Occurrence 5B_7:831:7173: scene=5B_7
#: 5B_7:831
msgctxt "text_id=7173 | speaker=unknown"
msgid "  Aoko nonetheless followed Soujyuro's uncharacteristically gung-ho lead, cursing him all the while."
msgstr "　別人のようなアグレッシブさを発揮する草十郎を<罵|ののし>りながら、律儀にフォローする青子。"

#. Occurrence 5B_7:921:7174: scene=5B_7
#: 5B_7:921
msgctxt "text_id=7174 | speaker=unknown"
msgid "  Alone, he had no chance of breaking through the surrounding wall of enemies with brute force."
msgstr "　草十郎の体当たりでは包囲網を突破できない。"

#. Occurrence 5B_7:926:7175: scene=5B_7
#: 5B_7:926
msgctxt "text_id=7175 | speaker=unknown"
msgid "  Aoko regained her bearings and let fly a spray of magic bullets ahead of Soujyuro."
msgstr "　青子はすぐさま体勢をたてなおし、草十郎の正面に魔弾を掃射する。"

#. Occurrence 5B_7:1015:7176: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0008; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:1015
msgctxt "text_id=7176 | speaker=aoko"
msgid "\"Hah...!\""
msgstr "「っ、はっ―――！」"

#. Occurrence 5B_7:1021:7177: scene=5B_7
#: 5B_7:1021
msgctxt "text_id=7177 | speaker=unknown"
msgid "  They burst through the net and ran as hard as they could."
msgstr "　囲いを抜け、全力で走りだす。"

#. Occurrence 5B_7:1026:7178: scene=5B_7
#: 5B_7:1026
msgctxt "text_id=7178 | speaker=unknown"
msgid "  At this point, all that was left to do was what they had planned from the outset: get out of the park."
msgstr "　こうなっては当初の予定通り、遊園地の外を目指すしかない。"

#. Occurrence 5B_7:1046:7179: scene=5B_7
#: 5B_7:1046
msgctxt "text_id=7179 | speaker=unknown"
msgid "  But not before addressing what needed to be addressed."
msgstr "　……まあ、それはともかくとして。"

#. Occurrence 5B_7:1103:7180: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0009; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:1103
msgctxt "text_id=7180 | speaker=aoko"
msgid "\"Where the hell did that come from! Hadn't you already given up back at the house of mirrors?!\""
msgstr "「なんでよ!?　さっきはあんなに諦め良かったのに！」"

#. Occurrence 5B_7:1109:7181: scene=5B_7
#: 5B_7:1109
msgctxt "text_id=7181 | speaker=unknown"
msgid "  Aoko could not begin to comprehend Soujyuro's reaction."
msgstr "　青子には草十郎の反応が、とにかくホントに理解不能。"

#. Occurrence 5B_7:1178:7182: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_7_0004; voice_prefix=A30; voice_category=3; scene=5B_7
#: 5B_7:1178
msgctxt "text_id=7182 | speaker=soujuurou"
msgid "\"That was then and this is now! Just run!\""
msgstr "「ミラーハウスの時と今は違うだろ！　いいから走れ！」"

#. Occurrence 5B_7:1229:7183: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0010; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:1229
msgctxt "text_id=7183 | speaker=aoko"
msgid "\"What are you talking about!? Alice wants to kill you for exactly the same reasons I did! This won't play out any differently!\""
msgstr "「違わないわよ！　アンタを殺そうとした私も、アンタを殺したい有珠も！　理由も結果も同じよ、私たち!?」"

#. Occurrence 5B_7:1281:7184: scene=5B_7
#: 5B_7:1281
msgctxt "text_id=7184 | speaker=unknown"
msgid "  Though she wondered what was getting her so worked up, Aoko did not stop."
msgstr "　何でこんなコトで怒鳴っているんだろう、と思いながらも青子は止まらない。"

#. Occurrence 5B_7:1286:7185: scene=5B_7
#: 5B_7:1286
msgctxt "text_id=7185 | speaker=unknown"
msgid "  She told herself that the degree of Soujyuro's stupidity, charging the bread-men so recklessly, had caused her to lose her cool."
msgstr "　きっと、無謀にもブレッドマンに突進した草十郎の馬鹿さ加減が頭にきているんだ、と自分自身に言い聞かせる。"

#. Occurrence 5B_7:1352:7186: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0011; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:1352
msgctxt "text_id=7186 | speaker=aoko"
msgid "\"Hey, don't get the wrong idea! I'm gonna try and kill you again tomorrow! I'll really do it! So if you don't want to die, you should be trying to escape me too, got it?!\""
msgstr "「あのね、一緒に逃げてるぐらいで勘違いしないでくれる!?　言っとくけど私、明日になったらまたアンタを殺しに行くから！　死にたくないってんなら、ここで私からも逃げだしたら!?」"

#. Occurrence 5B_7:1417:7187: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_7_0005; voice_prefix=A30; voice_category=3; scene=5B_7
#: 5B_7:1417
msgctxt "text_id=7187 | speaker=soujuurou"
msgid "\"Then let's talk about that tomorrow! I don't really care if you kill me, but just don't want to be killed by that girl!\""
msgstr "「それはまた今度の話だろ！　だいたい、蒼崎に殺されるのならいいけど、あの子に殺されるのはイヤだ！」"

#. Occurrence 5B_7:1423:7188: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0012; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:1423
msgctxt "text_id=7188 | speaker=aoko"
msgid "\"Like I said, WHY THE HELL NOT!?\""
msgstr "「だからなんで！？」"

#. Occurrence 5B_7:1429:7189: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_7_0006; voice_prefix=A30; voice_category=3; scene=5B_7
#: 5B_7:1429
msgctxt "text_id=7189 | speaker=soujuurou"
msgid "\"I don't even know what she looks like, nor have I ever spoken to her!\""
msgstr "「だって顔も知らない！　話したコトさえない相手だ！」"

#. Occurrence 5B_7:1483:7190: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0013; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:1483
msgctxt "text_id=7190 | speaker=aoko"
msgid "\"...What?\""
msgstr "「―――は？」"

#. Occurrence 5B_7:1518:7191: scene=5B_7
#: 5B_7:1518
msgctxt "text_id=7191 | speaker=unknown"
msgid "  It was like someone had doused water over her blazing fury."
msgstr "　沸き立っていた激情が、一瞬で鎮火する。"

#. Occurrence 5B_7:1523:7192: scene=5B_7
#: 5B_7:1523
msgctxt "text_id=7192 | speaker=unknown"
msgid "  Aoko's anger was snuffed out by the absurd simplicity of his reasoning."
msgstr "　あまりに簡潔かつどうでもいい理由に、青子の<直情|いかり>はあっさりと消えてしまった。"

#. Occurrence 5B_7:1574:7193: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0014; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:1574
msgctxt "text_id=7193 | speaker=aoko"
msgid "\"Because you don't know what she looks like?\""
msgstr "「顔も知らないって……」"

#. Occurrence 5B_7:1581:7194: scene=5B_7
#: 5B_7:1581
msgctxt "text_id=7194 | speaker=unknown"
msgid "  Could it be that Soujyuro did not mind being killed by someone as long as he had met them?"
msgstr "　草十郎としては、よく知った相手なら殺されてもいいのだろうか？"

#. Occurrence 5B_7:1586:7195: scene=5B_7
#: 5B_7:1586
msgctxt "text_id=7195 | speaker=unknown"
msgid "  Aoko grimaced as she followed him. "
msgstr "　ますますもって理解できない、と顔をしかめながら、青子は草十郎の背中を追いかけるのだった。"

#. Occurrence 5B_8:77:7196: scene=5B_8
#: 5B_8:77
msgctxt "text_id=7196 | speaker=unknown"
msgid "  From her spot atop the clock tower, the girl observed the growth of her familiar."
msgstr "　時計台の上で、少女は使い魔の成長を監視している。"

#. Occurrence 5B_8:82:7197: scene=5B_8
#: 5B_8:82
msgctxt "text_id=7197 | speaker=unknown"
msgid "  Flat Snark."
msgstr "　フラットスナーク。"

#. Occurrence 5B_8:87:7198: scene=5B_8
#: 5B_8:87
msgctxt "text_id=7198 | speaker=unknown"
msgid "  A savior of the discarded."
msgstr "　廃棄されたモノたちの救世主。"

#. Occurrence 5B_8:92:7199: scene=5B_8
#: 5B_8:92
msgctxt "text_id=7199 | speaker=unknown"
msgid "  It was a vile, vulgar fairy-tale monster who provided those abandoned by fate with a glimmer of hope, before snatching it away."
msgstr "　朽ちゆく<運命|さだめ>のモノたちに一時の希望を与え、根こそぎ奪い去る、<性悪|しょうわる>で<低俗|ていぞく>な“童話の怪物”。"

#. Occurrence 5B_8:99:7200: scene=5B_8
#: 5B_8:99
msgctxt "text_id=7200 | speaker=unknown"
msgid "  Alice had it under her control, but she was still keen to keep the Snark from expressing its bad habits."
msgstr "　自らの手駒ではあるが、スナークがその<悪癖|あくへき>を発揮しないよう、少女は目を光らせていた。"

#. Occurrence 5B_8:120:7201: scene=5B_8
#: 5B_8:120
msgctxt "text_id=7201 | speaker=unknown"
msgid "  After completing a lap around the park that had now reached the size of an entire town, the robin made its situation report."
msgstr "　いまやひとつの街ほどまでに広がった遊園地を一周した駒鳥が、少女に現状を報告する。"

#. Occurrence 5B_8:183:7202: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_8_0000; voice_prefix=A40; voice_category=2; scene=5B_8
#: 5B_8:183
msgctxt "text_id=7202 | speaker=alice"
msgid "\"...So. They're trying to get out.\""
msgstr "「……そう。外を目指しているの」"

#. Occurrence 5B_8:189:7203: scene=5B_8
#: 5B_8:189
msgctxt "text_id=7203 | speaker=unknown"
msgid "  It seemed Aoko was prioritizing the safety of the boy."
msgstr "　青子は少年の安全を優先したのだろう。"

#. Occurrence 5B_8:194:7204: scene=5B_8
#: 5B_8:194
msgctxt "text_id=7204 | speaker=unknown"
msgid "  Even if it resulted in wasting an entire day, choosing not to capitulate on a decision was very much like her."
msgstr "　たとえ一日で無駄になる事でも、一度決めた事を曲げないのは実に彼女らしい。"

#. Occurrence 5B_8:267:7205: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_8_0001; voice_prefix=A40; voice_category=2; scene=5B_8
#: 5B_8:267
msgctxt "text_id=7205 | speaker=alice"
msgid "\"That's too bad. I was sure Aoko would attempt to burn down the clock tower and me with it.\""
msgstr "「青子の事だから、時計台ごと私を焼き払いにくるかと思ったけど」"

#. Occurrence 5B_8:273:7206: scene=5B_8
#: 5B_8:273
msgctxt "text_id=7206 | speaker=unknown"
msgid "  The blue bird cheeped in response."
msgstr "　チチチ、と<嘴|くちばし>を鳴らす青い鳥。"

#. Occurrence 5B_8:278:7207: scene=5B_8
#: 5B_8:278
msgctxt "text_id=7207 | speaker=unknown"
msgid "  Was it denying its master's portrait of Aoko,"
msgstr "　主人の語る青子像を否定しているのか、"

#. Occurrence 5B_8:283:7208: scene=5B_8
#: 5B_8:283
msgctxt "text_id=7208 | speaker=unknown"
msgid "  or agreeing that it was Aoko's style to do exactly that?"
msgstr "　青子ならやりかねないと同意しているのか。"

#. Occurrence 5B_8:288:7209: scene=5B_8
#: 5B_8:288
msgctxt "text_id=7209 | speaker=unknown"
msgid "  An outsider might interpret its interjections either way."
msgstr "　傍目にはどちらにも取れる合いの手である。"

#. Occurrence 5B_8:337:7210: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_8_0002; voice_prefix=A40; voice_category=2; scene=5B_8
#: 5B_8:337
msgctxt "text_id=7210 | speaker=alice"
msgid "\"Does this bore you?\""
msgstr "「退屈？」"

#. Occurrence 5B_8:345:7211: scene=5B_8
#: 5B_8:345
msgctxt "text_id=7211 | speaker=unknown"
msgid "  The robin jumped at being addressed so unexpectedly."
msgstr "　突然話しかけられ、ビクッと震える駒鳥。"

#. Occurrence 5B_8:350:7212: scene=5B_8
#: 5B_8:350
msgctxt "text_id=7212 | speaker=unknown"
msgid "  It chirped and flapped its wings like a flustered servant, frantic to say otherwise."
msgstr "　チチチ、と必死に羽を振る仕草は、“そんなコトないっス！”とあわてる<丁稚|でっち>のようだ。"

#. Occurrence 5B_8:445:7213: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_8_0003; voice_prefix=A40; voice_category=2; scene=5B_8
#: 5B_8:445
msgctxt "text_id=7213 | speaker=alice"
msgid "\"...It's rare for us to get along so well."
msgstr "「……珍しく気があったわね。"

#. Occurrence 5B_8:451:7214: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_8_0004; voice_prefix=A40; voice_category=2; scene=5B_8
#: 5B_8:451
msgctxt "text_id=7214 | speaker=alice"
msgid "  Okay then. If it's a game she wants, a game she'll get. Let's liven things up a bit, shall we?\""
msgstr "　いいわ。せっかくのゲームだし、もう少しだけ盛り上げましょう」"

#. Occurrence 5B_8:457:7215: scene=5B_8
#: 5B_8:457
msgctxt "text_id=7215 | speaker=unknown"
msgid "  Calmly, she pulled out a small object from her pocket."
msgstr "　無表情のまま少女は小さな器物を取り出した。"

#. Occurrence 5B_8:462:7216: scene=5B_8
#: 5B_8:462
msgctxt "text_id=7216 | speaker=unknown"
msgid "  It was a dark-gray Easter egg, and emanating from inside it was the ticking of a clock."
msgstr "　カチカチと内から秒針の音をこぼす、鈍色の<装飾卵|イースターエッグ>。"

#. Occurrence 5B_8:531:7217: scene=5B_8
#: 5B_8:531
msgctxt "text_id=7217 | speaker=unknown"
msgid "  The robin knew it to be a Ploy Kickshaw with a bad attitude far exceeding Flat Snark's, known to be among the best in one-on-one situations."
msgstr "　それがフラットスナークには及ばずとも、対個人戦においてトップランクに<性質|タチ>の悪い“<童話の怪物|プロイキッシャー>”である事を、駒鳥は知っている。"

#. Occurrence 5B_8:645:7218: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_8_0005; voice_prefix=A40; voice_category=2; scene=5B_8
#: 5B_8:645
msgctxt "text_id=7218 | speaker=alice"
msgid "\"Go. I've set the extolling time for twenty minutes."
msgstr "「行ってらっしゃい。<讃|たた>える時間は二十分に設定したわ。"

#. Occurrence 5B_8:651:7219: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_8_0006; voice_prefix=A40; voice_category=2; scene=5B_8
#: 5B_8:651
msgctxt "text_id=7219 | speaker=alice"
msgid "  Break, in that subtle way of yours.\""
msgstr "　……いつも通り、控え目に壊れてきて」"

#. Occurrence 5B_8:657:7220: scene=5B_8
#: 5B_8:657
msgctxt "text_id=7220 | speaker=unknown"
msgid "  And together with the witch's breath, the egg filled with praise disappeared."
msgstr "　魔女の一息と共に、<祝|いわ>いの言葉がつまった卵が消える。"

#. Occurrence 5B_8:724:7221: scene=5B_8
#: 5B_8:724
msgctxt "text_id=7221 | speaker=unknown"
msgid "  Suddenly, a strong wind swept through the park."
msgstr "　不意に、遊園地に強い風が吹いた。"

#. Occurrence 5B_8:730:7222: scene=5B_8
#: 5B_8:730
msgctxt "text_id=7222 | speaker=unknown"
msgid "      The words \"I could have killed them all by myself\" floated through the air."
msgstr "　　　『彼らを殺すのは、自分だけで十分なのに』と。"

#. Occurrence 5B_8:736:7223: scene=5B_8
#: 5B_8:736
msgctxt "text_id=7223 | speaker=unknown"
msgid "  It was the disappointment of something enormous that was visible to all, yet overlooked."
msgstr "　それは、目に映っていながら見過ごしてしまう、巨大な何かの嘆息のようだった。"

#. Occurrence 5B_9:94:7224: scene=5B_9
#: 5B_9:94
msgctxt "text_id=7224 | speaker=unknown"
msgid "  Aoko and Soujyuro continued their dash toward the boundary separating the park from outside."
msgstr "　遊園地と外を分ける境界線に向かって、青子たちは走り続ける。"

#. Occurrence 5B_9:248:7225: scene=5B_9
#: 5B_9:248
msgctxt "text_id=7225 | speaker=unknown"
msgid "  The curio horde that stood in their way had reduced in number."
msgstr "　行く手を阻むオブジェの数は減ってきていた。"

#. Occurrence 5B_9:253:7226: scene=5B_9
#: 5B_9:253
msgctxt "text_id=7226 | speaker=unknown"
msgid "  The iron fence that separated the two from the outside world was just over three hundred yards away."
msgstr "　<外|そ><界|と>に通じる東側の鉄柵まで、あと三百メートル弱。"

#. Occurrence 5B_9:318:7227: scene=5B_9
#: 5B_9:318
msgctxt "text_id=7227 | speaker=unknown"
msgid "  Fortunately, there were no particularly large buildings barring their path."
msgstr "　幸運な事に、鉄柵への道中にはこれといって巨大な建物はない。"

#. Occurrence 5B_9:325:7228: scene=5B_9
#: 5B_9:325
msgctxt "text_id=7228 | speaker=unknown"
msgid "  If the Ferris wheel had stood in their way, that would have spelled the end, but thankfully, it had yet to reach its full strength."
msgstr "　あの観覧車に立ち<塞|ふさ>がられたらそれこそ終わりだが、観覧車が動き出すまであと幾ばくかの<猶予|ゆうよ>があるようだ。"

#. Occurrence 5B_9:330:7229: scene=5B_9
#: 5B_9:330
msgctxt "text_id=7229 | speaker=unknown"
msgid "  The only things that appeared before them were weak oddities that could easily be handled by Aoko's simple magecraft."
msgstr "　現れるのは青子の簡易魔術で吹き飛ばせる程度のオブジェのみ。"

#. Occurrence 5B_9:351:7230: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0000; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:351
msgctxt "text_id=7230 | speaker=aoko"
msgid "\"At this rate, we just might...\""
msgstr "“これなら、なんとか―――”"

#. Occurrence 5B_9:410:7231: scene=5B_9
#: 5B_9:410
msgctxt "text_id=7231 | speaker=unknown"
msgid "  She would have said \"make it to the fence,\" if only her lungs would allow it."
msgstr "　鉄柵まで辿り着ける、と青子は呼吸を整える。"

#. Occurrence 5B_9:415:7232: scene=5B_9
#: 5B_9:415
msgctxt "text_id=7232 | speaker=unknown"
msgid "  Since Aoko was utilizing the ample mana filling the park, her tank of magical energy was nearly full."
msgstr "　遊園地に満ちている<魔力|マナ>を使用しているので、青子本人の魔力はほぼ満タン。"

#. Occurrence 5B_9:420:7233: scene=5B_9
#: 5B_9:420
msgctxt "text_id=7233 | speaker=unknown"
msgid "  Moreover, the condition of her body's circuits was steadily improving, to the extent that she would be able to unleash at least one all-out onslaught."
msgstr "　<身体|からだ>の魔術回路は調子をあげる一方だし、一度ぐらいは全開で魔術行使をしてもいいぐらいだ。"

#. Occurrence 5B_9:520:7234: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0001; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:520
msgctxt "text_id=7234 | speaker=aoko"
msgid "\"...?\""
msgstr "「―――？」"

#. Occurrence 5B_9:526:7235: scene=5B_9
#: 5B_9:526
msgctxt "text_id=7235 | speaker=unknown"
msgid "  Until..."
msgstr "　と。"

#. Occurrence 5B_9:532:7236: scene=5B_9
#: 5B_9:532
msgctxt "text_id=7236 | speaker=unknown"
msgid "Something unusual was hovering above her field of vision."
msgstr "そんな青子の視界上空に、なにやら系統の違うモノが浮遊していた。"

#. Occurrence 5B_9:537:7237: scene=5B_9
#: 5B_9:537
msgctxt "text_id=7237 | speaker=unknown"
msgid "  It was locked on Soujyuro, hovering ten feet above him over to one side."
msgstr "　それは草十郎のななめ上空に張りつき、三メートルの高さを維持したまま移動している。"

#. Occurrence 5B_9:616:7238: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0002; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:616
msgctxt "text_id=7238 | speaker=aoko"
msgid "\"Sizuki! Look!\""
msgstr "「静希君、ちょっと」"

#. Occurrence 5B_9:622:7239: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0000; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:622
msgctxt "text_id=7239 | speaker=soujuurou"
msgid "\"What? That thing? It's been on us for a while.\""
msgstr "「ああ。さっきから付いてきてる」"

#. Occurrence 5B_9:628:7240: scene=5B_9
#: 5B_9:628
msgctxt "text_id=7240 | speaker=unknown"
msgid "  Soujyuro had seemingly noticed it before Aoko, hence his previous awkward glances toward the sky."
msgstr "　青子より先に気づいていたのか、草十郎はイヤそうに上空を盗み見ていた。"

#. Occurrence 5B_9:633:7241: scene=5B_9
#: 5B_9:633
msgctxt "text_id=7241 | speaker=unknown"
msgid "  In truth, it would have been stranger for him not to notice as the thing was practically glued to him."
msgstr "　なにしろ自分にぴったりとくっついて来ているのだ。気にならない方がおかしい。"

#. Occurrence 5B_9:766:7242: scene=5B_9
#: 5B_9:766
msgctxt "text_id=7242 | speaker=unknown"
msgid "  In terms of its size, the floating object measured about three feet in diameter."
msgstr "　浮遊物は大きさにして直径一メートルほど。"

#. Occurrence 5B_9:771:7243: scene=5B_9
#: 5B_9:771
msgctxt "text_id=7243 | speaker=unknown"
msgid "  Tiles covered its exterior, about which a multitude of spinning lights danced about."
msgstr "　表面のタイルには<十|と><重|え><二|は><十|た><重|え>に廻る光の躍動。"

#. Occurrence 5B_9:792:7244: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0001; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:792
msgctxt "text_id=7244 | speaker=soujuurou"
msgid "\"Is that an... egg?\""
msgstr "「……卵、かな」"

#. Occurrence 5B_9:797:7245: scene=5B_9
#: 5B_9:797
msgctxt "text_id=7245 | speaker=unknown"
msgid "  Soujyuro asked, not really sure what to call it."
msgstr "　草十郎は自信なさげに呟いた。"

#. Occurrence 5B_9:865:7246: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0003; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:865
msgctxt "text_id=7246 | speaker=aoko"
msgid "\"An egg? If it's an egg, then that means it'll crack!\""
msgstr "「卵……？　卵って言ったら―――割れる卵！」"

#. Occurrence 5B_9:1010:7247: scene=5B_9
#: 5B_9:1010
msgctxt "text_id=7247 | speaker=unknown"
msgid "  Her bullets bounced off like it was made of rubber."
msgstr "　<衛星|たまご>はゴムのように魔弾を弾く。"

#. Occurrence 5B_9:1015:7248: scene=5B_9
#: 5B_9:1015
msgctxt "text_id=7248 | speaker=unknown"
msgid "  That trait―the ability to deflect all outside interference―confirmed to Aoko that this thing was undoubtedly a Ploy Kickshaw."
msgstr "　その特性―――干渉を当然のように無効化するのは、間違いなく“<童話の怪物|プロイキッシャー>”……！"

#. Occurrence 5B_9:1099:7249: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0004; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1099
msgctxt "text_id=7249 | speaker=aoko"
msgid "\"Knew it. I can't break its rules from the outside."
msgstr "「やっぱり外からのルールじゃ壊れないか……"

#. Occurrence 5B_9:1105:7250: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0005; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1105
msgctxt "text_id=7250 | speaker=aoko"
msgid "  Sizuki, don't take your eyes off it even for a second!"
msgstr "　静希君、アレから絶対に目をそらさないで！"

#. Occurrence 5B_9:1111:7251: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0006; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1111
msgctxt "text_id=7251 | speaker=aoko"
msgid "  No matter what happens, keep your eyes locked on it! Even if it's just in the corner of your vision!\""
msgstr "　いい、何があっても見続けること！　視界の<隅|すみ>に入れとくだけでいいから！」"

#. Occurrence 5B_9:1117:7252: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0002; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:1117
msgctxt "text_id=7252 | speaker=soujuurou"
msgid "\"O-Okay?\""
msgstr "「あ、ああ!?」"

#. Occurrence 5B_9:1155:7253: scene=5B_9
#: 5B_9:1155
msgctxt "text_id=7253 | speaker=unknown"
msgid "  Aoko picked up her pace as she barked orders."
msgstr "　草十郎に指示をだしながら、青子は走る速度を速める。"

#. Occurrence 5B_9:1160:7254: scene=5B_9
#: 5B_9:1160
msgctxt "text_id=7254 | speaker=unknown"
msgid "  The egg man who sat on a wall..."
msgstr "　……アレは文字通り、割れる卵だ。"

#. Occurrence 5B_9:1165:7255: scene=5B_9
#: 5B_9:1165
msgctxt "text_id=7255 | speaker=unknown"
msgid "  He would crack, just as the tale spoke of."
msgstr "　塀の上に乗った卵人間。"

#. Occurrence 5B_9:1170:7256: scene=5B_9
#: 5B_9:1170
msgctxt "text_id=7256 | speaker=unknown"
msgid "  Nothing anyone could do or say would cause him to fall, but the moment they stopped looking, he would tumble down and break into pieces."
msgstr "　何をしても、何を言っても決して落ちる事はないが、目を離した途端に落下して破片をまき散らす。"

#. Occurrence 5B_9:1224:7257: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0007; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1224
msgctxt "text_id=7257 | speaker=aoko"
msgid "\"'All the king's horses and all the king's men could put him back together again.' Or so it's said.\""
msgstr "「曰く、王様の軍隊でも元に戻せない数の破片―――」"

#. Occurrence 5B_9:1230:7258: scene=5B_9
#: 5B_9:1230
msgctxt "text_id=7258 | speaker=unknown"
msgid "  It was the Mother Goose poem, Humpty Dumpty."
msgstr "　それがマザーグースに唄われるハンプティ・ダンプティの一節だ。"

#. Occurrence 5B_9:1235:7259: scene=5B_9
#: 5B_9:1235
msgctxt "text_id=7259 | speaker=unknown"
msgid "  If Soujyuro was its target, then the moment he averted his gaze, it would tumble and explode."
msgstr "　あの卵の標的が草十郎なら、草十郎が卵から視線をきった瞬間、落下して爆発する……！"

#. Occurrence 5B_9:1299:7260: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0008; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1299
msgctxt "text_id=7260 | speaker=aoko"
msgid "\"Except for the exploding part. Who knows what'll happen when it falls.\""
msgstr "「……まあ、爆発するかどうかは知らないけど」"

#. Occurrence 5B_9:1305:7261: scene=5B_9
#: 5B_9:1305
msgctxt "text_id=7261 | speaker=unknown"
msgid "  Either way, it was going to scatter something troublesome when it fell."
msgstr "　どうあれ、厄介なモノをまき散らすに違いない。"

#. Occurrence 5B_9:1310:7262: scene=5B_9
#: 5B_9:1310
msgctxt "text_id=7262 | speaker=unknown"
msgid "  Its oval shape, the keyhole adorning the front, and writing inscribed upon it... They all made her anxious."
msgstr "　卵という形状、錠門の装飾、刻まれた詩文も気になる。"

#. Occurrence 5B_9:1315:7263: scene=5B_9
#: 5B_9:1315
msgctxt "text_id=7263 | speaker=unknown"
msgid "  If it was an egg, that meant it was going to hatch at some point."
msgstr "　アレが卵ならいつかは<孵|かえ>る。"

#. Occurrence 5B_9:1320:7264: scene=5B_9
#: 5B_9:1320
msgctxt "text_id=7264 | speaker=unknown"
msgid "  Even if he continued his stare, once the time came for whatever was inside to come out, they would have even less ability to conserve their energy."
msgstr "　ずっと見続けていても、時間がくれば“中身が出る”としたら、ますます余力を残している場合ではない。"

#. Occurrence 5B_9:1384:7265: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0003; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:1384
msgctxt "text_id=7265 | speaker=soujuurou"
msgid "\"Aozaki, slow down, would you!"
msgstr "「蒼崎、速すぎないか!?"

#. Occurrence 5B_9:1390:7266: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0004; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:1390
msgctxt "text_id=7266 | speaker=soujuurou"
msgid "  If you use up all of your energy now, you'll―\""
msgstr "　あんまり全力で走ると―――」"

#. Occurrence 5B_9:1436:7267: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0009; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1436
msgctxt "text_id=7267 | speaker=aoko"
msgid "\"Forget about what comes next!"
msgstr "「後の事は考えないで！"

#. Occurrence 5B_9:1442:7268: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0010; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1442
msgctxt "text_id=7268 | speaker=aoko"
msgid "  Just focus on watching that egg!\""
msgstr "　いいから静希君は卵だけに集中して―――」"

#. Occurrence 5B_9:1492:7269: scene=5B_9
#: 5B_9:1492
msgctxt "text_id=7269 | speaker=unknown"
msgid "  At this critical juncture, bread-men stepped out to join the egg and block their path."
msgstr "　卵の出現にあわせて、ここぞとばかりに立ちふさがるブレッドマン。"

#. Occurrence 5B_9:1543:7270: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0011; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1543
msgctxt "text_id=7270 | speaker=aoko"
msgid "\"Out of the way!\""
msgstr "「邪魔―――！」"

#. Occurrence 5B_9:1671:7271: scene=5B_9
#: 5B_9:1671
msgctxt "text_id=7271 | speaker=unknown"
msgid "  The bread-men were marching forth in a grand battalion."
msgstr "　かつてない大軍で押し寄せる焼きたてパンを、"

msgctxt "text_id=7272 | speaker=unknown"
msgid "  At her level of firepower, Aoko should have easily mowed them down. However..."
msgstr "　青子はこれまで以上の火力でなぎ払うのだが―――"

#. Occurrence 5B_9:1831:7273: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0012; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1831
msgctxt "text_id=7273 | speaker=aoko"
msgid "\"These have hard crusts? Take this!\""
msgstr "「っ、<堅|かた>焼きか、この―――！」"

#. Occurrence 5B_9:1961:7274: scene=5B_9
#: 5B_9:1961
msgctxt "text_id=7274 | speaker=unknown"
msgid "  If Snap failed to do the job, that meant it was time for her to put her crest to use."
msgstr "　<弾く|スナップ>が効かないというのなら、刻印を用いた魔弾を放つ。"

#. Occurrence 5B_9:1966:7275: scene=5B_9
#: 5B_9:1966
msgctxt "text_id=7275 | speaker=unknown"
msgid "  Draw: a formula-triggered bullet encased in a full wind jacket."
msgstr "　<術式|だんがん>を用いた<風圧甲弾|ドロウ>。"

#. Occurrence 5B_9:1971:7276: scene=5B_9
#: 5B_9:1971
msgctxt "text_id=7276 | speaker=unknown"
msgid "  If her previous shots were the equivalent of a machine gun volley, then this was her artillery shot."
msgstr "　先ほどまでのが機関銃の掃射なら、これは大砲の一撃だ。"

#. Occurrence 5B_9:2095:7277: scene=5B_9
#: 5B_9:2095
msgctxt "text_id=7277 | speaker=unknown"
msgid "  The hard-crust bread that had absorbed her Snap without a dent scattered into thousands of tiny pieces at her Draw's torrent."
msgstr "　<魔力|スナップ>に耐えきった堅焼きパンたちは、<魔術|ドロウ>の<奔流|ほんりゅう>を受けて焼き千切れていった。"

#. Occurrence 5B_9:2179:7278: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0005; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:2179
msgctxt "text_id=7278 | speaker=soujuurou"
msgid "\"Whoa...\""
msgstr "「うわ……」"

#. Occurrence 5B_9:2185:7279: scene=5B_9
#: 5B_9:2185
msgctxt "text_id=7279 | speaker=unknown"
msgid "  Of course, the destruction did not end with just the bread-men."
msgstr "　もちろん、破壊はブレッドマンだけに留まらない。"

#. Occurrence 5B_9:2191:7280: scene=5B_9
#: 5B_9:2191
msgctxt "text_id=7280 | speaker=unknown"
msgid "  What had once been a brick road was now thoroughly stripped of its pavement."
msgstr "　レンガの道は舗装をふっ飛ばされ丸裸にされ、"

#. Occurrence 5B_9:2196:7281: scene=5B_9
#: 5B_9:2196
msgctxt "text_id=7281 | speaker=unknown"
msgid "  The nearby stalls had been warped into twisted steel skeletons."
msgstr "　近くにあった売店は鉄骨だけを残した<骸骨|スケルトン>と化していた。"

#. Occurrence 5B_9:2284:7282: scene=5B_9
#: 5B_9:2284
msgctxt "text_id=7282 | speaker=unknown"
msgid "  It was a spectacle that made Soujyuro question what the greater obstacle to their escape was―the wall of bread-men, or Aoko's ability to lay waste to things?"
msgstr "　ブレッドマンの壁より青子の破壊活動の方がいずれ行く手を阻むのでは、と草十郎でなくとも不安に思う惨状である。"

#. Occurrence 5B_9:2350:7283: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0013; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2350
msgctxt "text_id=7283 | speaker=aoko"
msgid "\"Hey! Don't wander off! It's dangerous if you don't stick close to me!"
msgstr "「ちょっと。なんで距離とるのよ、そこ。<傍|そば>にいないと危ないじゃない。"

#. Occurrence 5B_9:2366:7284: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0014; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2366
msgctxt "text_id=7284 | speaker=aoko"
msgid "  Come on, get closer!"
msgstr "　ほら、もっとこっち！"

#. Occurrence 5B_9:2373:7285: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0015; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2373
msgctxt "text_id=7285 | speaker=aoko"
msgid "  We're out of strikes, you know? If they surround you, you're a goner! You should know, hostages don't mean squat to me, and it's not like I can pick out my targets precisely anyway!\""
msgstr "　言っとくけどアンタがアイツらに囲まれちゃったらアウトよ？　私、人質とか意味ないタイプだし。そもそも区別して撃つとか、そういうのできないし」"

#. Occurrence 5B_9:2415:7286: scene=5B_9
#: 5B_9:2415
msgctxt "text_id=7286 | speaker=unknown"
msgid "  This made a lot of sense to Soujyuro."
msgstr "　なるほど、と頷く草十郎。"

#. Occurrence 5B_9:2420:7287: scene=5B_9
#: 5B_9:2420
msgctxt "text_id=7287 | speaker=unknown"
msgid "  He had not fully appreciated the part about hostages, but he got the gist of it."
msgstr "　人質は意味をなさない、という言葉の意味は分からずとも、彼女の言わんとするところは分かる。"

#. Occurrence 5B_9:2464:7288: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0006; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:2464
msgctxt "text_id=7288 | speaker=soujuurou"
msgid "\"So basically, I'm in danger no matter where I stand.\""
msgstr "「つまり、今はどこであろうと危険なのか」"

#. Occurrence 5B_9:2480:7289: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0016; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2480
msgctxt "text_id=7289 | speaker=aoko"
msgid "\"You...\""
msgstr "「……アンタね」"

#. Occurrence 5B_9:2523:7290: scene=5B_9
#: 5B_9:2523
msgctxt "text_id=7290 | speaker=unknown"
msgid "  Offended though she was by his typical naive response, she could not help but be impressed."
msgstr "　草十郎の相変わらずの天然っぷりにカチンときながらも、青子は少しだけ感心した。"

#. Occurrence 5B_9:2528:7291: scene=5B_9
#: 5B_9:2528
msgctxt "text_id=7291 | speaker=unknown"
msgid "  Soujyuro was a straight arrow through and through."
msgstr "　草十郎はいたって真面目だ。"

#. Occurrence 5B_9:2533:7292: scene=5B_9
#: 5B_9:2533
msgctxt "text_id=7292 | speaker=unknown"
msgid "  His eyes stayed firmly focused on the egg overhead, even amidst the chaos of the melee unfolding before him."
msgstr "　彼の視線は、今の乱戦の中でもしっかり頭上の卵に向けられている。"

#. Occurrence 5B_9:2559:7293: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0017; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2559
msgctxt "text_id=7293 | speaker=aoko"
msgid "\"I don't know why I worried."
msgstr "「その分なら安心か。"

#. Occurrence 5B_9:2565:7294: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0018; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2565
msgctxt "text_id=7294 | speaker=aoko"
msgid "  You may not be the sharpest tool, but you sure are good at following orders.\""
msgstr "　物分かりは悪いけど、一度言われた事はきっちり守るあたり、貴方のいいところよね」"

#. Occurrence 5B_9:2598:7295: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0007; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:2598
msgctxt "text_id=7295 | speaker=soujuurou"
msgid "\"One thing, Aozaki. Am I imagining it, or do those bread men seem tougher than before?\""
msgstr "「そんなことより蒼崎。俺の気のせいならいいんだけど、さっきのパン、堅くなかったか？」"

#. Occurrence 5B_9:2645:7296: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0019; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2645
msgctxt "text_id=7296 | speaker=aoko"
msgid "\"...No, you weren't imagining that. They're getting stronger."
msgstr "「……まあね。アイツら、少しずつ強くなってきてるわ。"

#. Occurrence 5B_9:2651:7297: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0020; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2651
msgctxt "text_id=7297 | speaker=aoko"
msgid "  They must have nailed down their mass-production process, so they've turned their attention to upping the quality.\""
msgstr "　大量生産が軌道に乗ったんで、今度はクオリティアップをテーマにしたのかも」"

#. Occurrence 5B_9:2694:7298: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0021; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2694
msgctxt "text_id=7298 | speaker=aoko"
msgid "\"As you figured out already, they're just going to get tougher as we go. It seems like even those bread guys have started to develop individuality."
msgstr "「静希君でもお察しの通り、ここからは手強くなっていく一方よ。あのパンたちでさえ個体差がでてきたみたいだし。"

#. Occurrence 5B_9:2700:7299: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0022; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2700
msgctxt "text_id=7299 | speaker=aoko"
msgid "  I hate to think about it, but they might start spreading themselves with jelly, or wearing other fillings and merging with one another.\""
msgstr "　考えたくないけど、そのうちジャム塗ったりレタス乗っけたり、はては合体したりして」"

#. Occurrence 5B_9:2744:7300: scene=5B_9
#: 5B_9:2744
msgctxt "text_id=7300 | speaker=unknown"
msgid "  Though she was joking, her eyes were dead serious."
msgstr "　冗談を言いながらも青子の目は真剣だ。"

#. Occurrence 5B_9:2754:7301: scene=5B_9
#: 5B_9:2754
msgctxt "text_id=7301 | speaker=unknown"
msgid "  Soujyuro shuddered at the thought of the situation growing even more dire."
msgstr "　容赦なく悪化していく状況に、草十郎は今更ながら戦慄を覚えてしまう。"

#. Occurrence 5B_9:2780:7302: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0008; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:2780
msgctxt "text_id=7302 | speaker=soujuurou"
msgid "\"So you're saying that those guys are going to become as terrifying as the puppet from the house of mirrors soon?\""
msgstr "「じゃあ、そのうちミラーハウスの人形ぐらいに恐くなるのか、あいつら？」"

#. Occurrence 5B_9:2808:7303: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0023; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2808
msgctxt "text_id=7303 | speaker=aoko"
msgid "\"Oh, you can count on it. And I'll have my hands full with bread that rare. Say, Sizuki. Think you can handle yourself against one of those?\""
msgstr "「間違いなくね。そこまで<高価|レア>なパンになったら私も自分だけで手一杯になる。ところで静希君、ああいうのとケンカできる？」"

#. Occurrence 5B_9:2818:7304: scene=5B_9
#: 5B_9:2818
msgctxt "text_id=7304 | speaker=unknown"
msgid "  Soujyuro shook his head, a look of complete aversion upon his face."
msgstr "　ぶんぶん、と草十郎は心底イヤそうな顔で首を振る。"

#. Occurrence 5B_9:2830:7305: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0024; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2830
msgctxt "text_id=7305 | speaker=aoko"
msgid "\"I didn't think so. So let's get moving, we can't afford to hang around here.\""
msgstr "「でしょ？　なら急ぎましょ。色々余裕ないんだから」"

#. Occurrence 5B_9:2881:7306: scene=5B_9
#: 5B_9:2881
msgctxt "text_id=7306 | speaker=unknown"
msgid "  Aoko took a quick, deep breath, then began to sprint once again."
msgstr "　青子は短く深呼吸をして、駆け足を再開する。"

#. Occurrence 5B_9:2886:7307: scene=5B_9
#: 5B_9:2886
msgctxt "text_id=7307 | speaker=unknown"
msgid "  Far in the distance, through the fog, the iron fence waited, three hundred paces away."
msgstr "　視界<遥|はる>か、霧の向こうの鉄柵まであと三百メートルほど。"

#. Occurrence 5B_9:2891:7308: scene=5B_9
#: 5B_9:2891
msgctxt "text_id=7308 | speaker=unknown"
msgid "  As long as nothing happened, they would make it there in one piece."
msgstr "　……このまま何事もなければ無事にたどり着けるかもしれない。"

#. Occurrence 5B_9:2901:7309: scene=5B_9
#: 5B_9:2901
msgctxt "text_id=7309 | speaker=unknown"
msgid "  Soujyuro followed after Aoko, holding onto that all too convenient hope."
msgstr "　そんな都合のいい希望を抱きながら、草十郎は青子の後に続いていった。"

#. Occurrence 6_1:49:7310: scene=6_1
#: 6_1:49
msgctxt "text_id=7310 | speaker=unknown"
msgid "  He was still in a deep sleep..."
msgstr "　彼はまだ、深い眠りの中にいる―――"

#. Occurrence 6_1:88:7311: scene=6_1
#: 6_1:88
msgctxt "text_id=7311 | speaker=unknown"
msgid "  It all seemed ablaze in a mad, fiery red."
msgstr "　それは一面の、燃えるような<茜|あかね>色だった。"

#. Occurrence 6_1:96:7312: scene=6_1
#: 6_1:96
msgctxt "text_id=7312 | speaker=unknown"
msgid "  Unbearable idle thoughts..."
msgstr "　<忍|しの>びない雑念。"

#. Occurrence 6_1:101:7313: scene=6_1
#: 6_1:101
msgctxt "text_id=7313 | speaker=unknown"
msgid "  Incessant obstinacy..."
msgstr "　絶え間のない<我執|がしゅう>。"

#. Occurrence 6_1:106:7314: scene=6_1
#: 6_1:106
msgctxt "text_id=7314 | speaker=unknown"
msgid "  Melancholy sights and gloomy, bittersweet talk..."
msgstr "　見るも悲哀、語るも<陰鬱|いんうつ>な<悲喜交々|ひきこもごも>。"

#. Occurrence 6_1:111:7315: scene=6_1
#: 6_1:111
msgctxt "text_id=7315 | speaker=unknown"
msgid "  Fickle wickedness born of human interaction..."
msgstr "　人と人の<交|まじ>わりから生じる<有為|うい><悪作|あくさ>。"

#. Occurrence 6_1:116:7316: scene=6_1
#: 6_1:116
msgctxt "text_id=7316 | speaker=unknown"
msgid "  Namely, the voice of a forsaken coexistence."
msgstr "　即ち、救いようのない共存の<声|おと>。"

#. Occurrence 6_1:122:7317: scene=6_1
#: 6_1:122
msgctxt "text_id=7317 | speaker=unknown"
msgid "  This, however, was the scenery of a world far removed from that."
msgstr "　これはその一切から、あまりにも遠い世界の<風景|はなし>。"

#. Occurrence 6_1:142:7318: scene=6_1
#: 6_1:142
msgctxt "text_id=7318 | speaker=unknown"
msgid "  If there were those praying this was Paradise,"
msgstr "　天上<楽土|らくど>と手を合わせる者もいれば、"

#. Occurrence 6_1:147:7319: scene=6_1
#: 6_1:147
msgctxt "text_id=7319 | speaker=unknown"
msgid "  then there were likely also those lamenting it as the underworld."
msgstr "　死後の<幽世|かくりよ>と目を伏せる者もいるだろう。"

#. Occurrence 6_1:152:7320: scene=6_1
#: 6_1:152
msgctxt "text_id=7320 | speaker=unknown"
msgid "  In a decade,"
msgstr "　あと十年、"

#. Occurrence 6_1:157:7321: scene=6_1
#: 6_1:157
msgctxt "text_id=7321 | speaker=unknown"
msgid "  or perhaps longer, this would all change. But for now, the autumn leaves remained yet untrampled by human soles."
msgstr "　あるいは何十年後かにはあり方を変えていく、いまだ人の靴を知らぬ<紅葉|こうよう>の海。"

#. Occurrence 6_1:163:7322: scene=6_1
#: 6_1:163
msgctxt "text_id=7322 | speaker=unknown"
msgid "  It was scenery he knew well."
msgstr "　それが、彼にとって当たり前の風景だった。"

#. Occurrence 6_1:205:7323: scene=6_1
#: 6_1:205
msgctxt "text_id=7323 | speaker=unknown"
msgid "  Life in the mountains was humble and modest."
msgstr "　<山中|さんちゅう>において人間の<営|いとな>みは<慎|つつ>ましくささやかだ。"

#. Occurrence 6_1:210:7324: scene=6_1
#: 6_1:210
msgctxt "text_id=7324 | speaker=unknown"
msgid "  There were no conspicuous buildings among this wilderness he called home."
msgstr "　彼の住まいである山にも、向かいのお山にも目立つほどの建物はない。"

#. Occurrence 6_1:215:7325: scene=6_1
#: 6_1:215
msgctxt "text_id=7325 | speaker=unknown"
msgid "  They gathered and stockpiled only what they needed to survive, without pillaging the land."
msgstr "　衣食住に関する事柄は必要な分だけ、多くを奪うことなく積み重ねられている。"

#. Occurrence 6_1:235:7326: scene=6_1
#: 6_1:235
msgctxt "text_id=7326 | speaker=unknown"
msgid "  Serpentine trails could be seen woven through the fields, and the stone steps leading to the summit were obscured by the forest, only visible once upon them."
msgstr "　見れば蛇のように身をくねらせる野道や、<頂|いただき>に続く石段なども造られているが、それも山中に踏み入らなければ気付かない程度だ。"

#. Occurrence 6_1:240:7327: scene=6_1
#: 6_1:240
msgctxt "text_id=7327 | speaker=unknown"
msgid "  The mountain inhabitants probably intended it that way."
msgstr "　この山で暮らす者たちの方針だろう。"

#. Occurrence 6_1:245:7328: scene=6_1
#: 6_1:245
msgctxt "text_id=7328 | speaker=unknown"
msgid "  There was no sign of mankind's exploitation among the mountain landscape."
msgstr "　人の手によるもので、山の景色を損なう物は一つもない。"

#. Occurrence 6_1:291:7329: scene=6_1
#: 6_1:291
msgctxt "text_id=7329 | speaker=unknown"
msgid "  He suddenly remembered that this was the season he liked the most."
msgstr "　ふと、この<季節|しきさい>が一番好きだった事を思い出す。"

#. Occurrence 6_1:296:7330: scene=6_1
#: 6_1:296
msgctxt "text_id=7330 | speaker=unknown"
msgid "  Or rather, it suited him the most."
msgstr "　好きというより己の性に合っていた。"

#. Occurrence 6_1:301:7331: scene=6_1
#: 6_1:301
msgctxt "text_id=7331 | speaker=unknown"
msgid "  There was much to be done to prepare for winter, but whenever he had a free moment, he would make his way toward the mountaintop."
msgstr "　冬に備えてやるべき事は山積みだったが、<暇|ひま>を見付けては<頂|いただき>近くにまで足を運んだ。"

#. Occurrence 6_1:306:7332: scene=6_1
#: 6_1:306
msgctxt "text_id=7332 | speaker=unknown"
msgid "  Gazing idly at the setting sun while breathing deep the crisp autumn air was probably the second favorite of his daily joys."
msgstr "　深く呼吸をして、ぼんやりと斜陽の<兆|きざ>しを眺めていた時が、たぶん、毎日で二番目ぐらいに幸せだった。"

#. Occurrence 6_1:374:7333: scene=6_1
#: 6_1:374
msgctxt "text_id=7333 | speaker=unknown"
msgid "  It relaxed him, the cold but comforting wind at dusk,"
msgstr "　茜の山をいっそう赤く染める夕日。"

#. Occurrence 6_1:379:7334: scene=6_1
#: 6_1:379
msgctxt "text_id=7334 | speaker=unknown"
msgid "  and the way the sunset dyed the peaks a vibrant crimson."
msgstr "　<黄昏|たそがれ>時に吹く風は冷たくも、安らげるものだった。"

#. Occurrence 6_1:384:7335: scene=6_1
#: 6_1:384
msgctxt "text_id=7335 | speaker=unknown"
msgid "  Not two months had passed since coming down from the mountains, and already it pained him that the memories had begun to fade."
msgstr "　山を下りてからまだ二ヶ月も<経|た>っていないのに、記憶が<薄|うす>れている事が少し<淋|さみ>しい。"

#. Occurrence 6_1:389:7336: scene=6_1
#: 6_1:389
msgctxt "text_id=7336 | speaker=unknown"
msgid "  Someone once told him that memories fade every day, so the best you one do is make as many new ones as possible."
msgstr "　日々の記憶は薄れていくから、それに負けないように思い出は重ねていくしかないのだと、誰かが口にしていたっけ。"

#. Occurrence 6_1:411:7337: scene=6_1
#: 6_1:411
msgctxt "text_id=7337 | speaker=unknown"
msgid "  Recollections grew hazy."
msgstr "　思い出はかくも<霞|かす>んでいく。"

#. Occurrence 6_1:416:7338: scene=6_1
#: 6_1:416
msgctxt "text_id=7338 | speaker=unknown"
msgid "  A new place to live meant the beginning of a new life."
msgstr "　住む場所が変われば、新しい生活は始まっていく。"

#. Occurrence 6_1:421:7339: scene=6_1
#: 6_1:421
msgctxt "text_id=7339 | speaker=unknown"
msgid "  He wasn't sure if he was reluctant to let go of the scenery he'd cherished for so long, or if he'd merely been spoiled by it."
msgstr "　その中で、長く親しんできた景色を引きずるのは<贅沢|ぜいたく>なのか、未練なのか。"

#. Occurrence 6_1:426:7340: scene=6_1
#: 6_1:426
msgctxt "text_id=7340 | speaker=unknown"
msgid "  Despite his new home in a city surrounded by tall buildings, he felt guilty for wanting those memories alone to remain clear in his mind."
msgstr "　<現在|いま>の住み家は高いビルディングに囲まれた都会なのに、この記憶だけは鮮明であってほしいと思うのが後ろめたい。"

#. Occurrence 6_1:446:7341: scene=6_1
#: 6_1:446
msgctxt "text_id=7341 | speaker=unknown"
msgid "  Either way, he had to make the best of a fresh start."
msgstr "　なにしろせっかくの新生活。"

#. Occurrence 6_1:451:7342: scene=6_1
#: 6_1:451
msgctxt "text_id=7342 | speaker=unknown"
msgid "  \"What kind of man thinks more about where he came from than where he's going?\" he contemplated."
msgstr "　新居より故郷を思うのはちょっと、男としてどうか、と彼は生真面目に反省して、"

#. Occurrence 6_1:476:7343: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_1_0000; voice_prefix=A30; voice_category=3; scene=6_1
#: 6_1:476
msgctxt "text_id=7343 | speaker=soujuurou"
msgid "\"Oh. This is a dream.\""
msgstr "「そうか。これ、夢だ」"

#. Occurrence 6_1:482:7344: scene=6_1
#: 6_1:482
msgctxt "text_id=7344 | speaker=unknown"
msgid "  He tried to stop himself from indulging in uncharacteristic sentimentality."
msgstr "　そう、ガラにもなく<耽|ふけ>っていた感傷を止めてみた。"

#. Occurrence 6_1:487:7345: scene=6_1
#: 6_1:487
msgctxt "text_id=7345 | speaker=unknown"
msgid "  It wouldn't be a dream if it was easy to understand."
msgstr "　我が事ながら、何の迷いもなく夢と<判|わか>ってしまうあたり夢がない、と思いながら。"

#. Occurrence 6_1:564:7346: scene=6_1
#: 6_1:564
msgctxt "text_id=7346 | speaker=unknown"
msgid "  The moment he realized he was dreaming, angular shadows began to rise from the autumn colors."
msgstr "　夢と断じた途端、紅葉に鋭角な影がそびえ立っていく。"

#. Occurrence 6_1:569:7347: scene=6_1
#: 6_1:569
msgctxt "text_id=7347 | speaker=unknown"
msgid "  They were concrete buildings, previously unknown and yet familiar to him at the same time."
msgstr "　それはかつて知らず、今は<既|き><知|ち>となったコンクリートの建物たちだ。"

#. Occurrence 6_1:574:7348: scene=6_1
#: 6_1:574
msgctxt "text_id=7348 | speaker=unknown"
msgid "  This was how his current life was washing away his memories."
msgstr "　思い出はこうやって、今の暮らしに<融|と>かされていく。"

#. Occurrence 6_1:579:7349: scene=6_1
#: 6_1:579
msgctxt "text_id=7349 | speaker=unknown"
msgid "  Struggle as he might, there was no stopping the degradation of human memory or impressions."
msgstr "　もとより人間の記憶、人間の印象は、どうあがこうと劣化していく。"

#. Occurrence 6_1:599:7350: scene=6_1
#: 6_1:599
msgctxt "text_id=7350 | speaker=unknown"
msgid "  It was merely a fact of life."
msgstr "　それは仕方のない事だ。"

#. Occurrence 6_1:604:7351: scene=6_1
#: 6_1:604
msgctxt "text_id=7351 | speaker=unknown"
msgid "  By nature, humans lived in the present over the past."
msgstr "　何であれ、人間は過去より今に期待するものだし。"

#. Occurrence 6_1:609:7352: scene=6_1
#: 6_1:609
msgctxt "text_id=7352 | speaker=unknown"
msgid "  Eventually, even his most cherished memories would be swallowed up the buildings."
msgstr "　いずれ過去の思い出でさえ、ビルディングに飲みこまれていくだろう。"

#. Occurrence 6_1:614:7353: scene=6_1
#: 6_1:614
msgctxt "text_id=7353 | speaker=unknown"
msgid "  It was neither cruel nor heartless."
msgstr "　無情も薄情もない。"

#. Occurrence 6_1:619:7354: scene=6_1
#: 6_1:619
msgctxt "text_id=7354 | speaker=unknown"
msgid "  If they were sure to disappear, then for now he would content himself with dreaming about the memories he could clearly recall."
msgstr "　かならず消えると予感しているのなら、今はただ、鮮明に思いだせる記憶を夢見ていればいい。"

#. Occurrence 6_1:639:7355: scene=6_1
#: 6_1:639
msgctxt "text_id=7355 | speaker=unknown"
msgid "  Whether in the mountains or the city, the days flew by."
msgstr "　山であろうと町であろうと、日々はもとより一瞬だ。"

#. Occurrence 6_1:644:7356: scene=6_1
#: 6_1:644
msgctxt "text_id=7356 | speaker=unknown"
msgid "  Yesterday's scenery was not the same as today's."
msgstr "　たとえ一日後の今日でも、昨日と同じ風景はどこにもないのだから。"

#. Occurrence 6_1:653:7357: scene=6_1
#: 6_1:653
msgctxt "text_id=7357 | speaker=unknown"
msgid "  ...And such."
msgstr "　…………などと。"

#. Occurrence 6_1:658:7358: scene=6_1
#: 6_1:658
msgctxt "text_id=7358 | speaker=unknown"
msgid "  She had given him no time to grieve."
msgstr "　しんみりする暇を、彼女はまったく与えてくれなかった。"

#. Occurrence 6_1:663:7359: scene=6_1
#: 6_1:663
msgctxt "text_id=7359 | speaker=unknown"
msgid "  Distant nostalgia was beautiful, but that made it fleeting."
msgstr "　<懐|なつ>かしく遠い記憶は、美しいが故に<儚|はかな>いらしい。"

#. Occurrence 6_1:684:7360: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_1_0001; voice_prefix=A30; voice_category=3; scene=6_1
#: 6_1:684
msgctxt "text_id=7360 | speaker=soujuurou"
msgid "\"You're no 'miage nyudo,' Aozaki. I can't talk my way past you.\""
msgstr "「……<見|み><上|あ>げ<入道|にゅうどう>じゃないんだぞ、蒼崎」"

#. Occurrence 6_1:713:7361: scene=6_1
#: 6_1:713
msgctxt "text_id=7361 | speaker=unknown"
msgid "  A faint dizziness made him close his eyes."
msgstr "　軽い目眩から目を閉じる。"

#. Occurrence 6_1:718:7362: scene=6_1
#: 6_1:718
msgctxt "text_id=7362 | speaker=unknown"
msgid "  Without sight, the mountainous landscape vanished, but in its place a familiar voice could be heard."
msgstr "　<視界|いしき>を切ったことで山の風景は見えなくなり、かわりに聞き覚えのある声が響いてきた。"

#. Occurrence 6_1:723:7363: scene=6_1
#: 6_1:723
msgctxt "text_id=7363 | speaker=unknown"
msgid "  It was a booming voice that seemed to shake not only the mountainside he stood upon, but the entire mountain as well."
msgstr "　彼のいる山の中腹はおろか、山全体を震わすような大声だ。"

#. Occurrence 6_1:766:7364: scene=6_1
#: 6_1:766
msgctxt "text_id=7364 | speaker=unknown"
msgid "  And of course, Aoko Aozaki reappeared, towering in the distance."
msgstr "　それも当然で、さっき幻のように現れた蒼崎青子は山の向こうにでーんとそびえていたのだ。"

#. Occurrence 6_1:771:7365: scene=6_1
#: 6_1:771
msgctxt "text_id=7365 | speaker=unknown"
msgid "  He must have been tired, he thought, diagnosing himself while trying to make out what she was saying."
msgstr "　本当に疲れてるんだな、と彼は自分の状態を確認しつつ、彼女の声に気を<配|くば>った。"

#. Occurrence 6_1:776:7366: scene=6_1
#: 6_1:776
msgctxt "text_id=7366 | speaker=unknown"
msgid "  Fearing the vertigo would return if he reopened his eyes, he decided to keep them closed."
msgstr "　目を開けているとまた目眩がしそうなので、目は閉じたままである。"

#. Occurrence 6_1:812:7367: scene=6_1
#: 6_1:812
msgctxt "text_id=7367 | speaker=unknown"
msgid "  ...It sounded like she was arguing with someone, though the tone was all he could make out."
msgstr "　……おおよその雰囲気しか分からないが、彼女は誰かと口論しているようだった。"

#. Occurrence 6_1:817:7368: scene=6_1
#: 6_1:817
msgctxt "text_id=7368 | speaker=unknown"
msgid "  It wasn't violent, but certainly aggressive."
msgstr "　激しくはないが攻撃的な口調。"

#. Occurrence 6_1:822:7369: scene=6_1
#: 6_1:822
msgctxt "text_id=7369 | speaker=unknown"
msgid "  Maybe she was picking a fight with another mountain across the way."
msgstr "　たぶん向かいの山にでも喧嘩を売っているのだろう。"

#. Occurrence 6_1:827:7370: scene=6_1
#: 6_1:827
msgctxt "text_id=7370 | speaker=unknown"
msgid "  He wouldn't put it past her."
msgstr "　彼女なら十分にありえる、と彼はひとり頷いた。"

#. Occurrence 6_1:832:7371: scene=6_1
#: 6_1:832
msgctxt "text_id=7371 | speaker=unknown"
msgid "  After all, she was a troublemaker who blew up the moon."
msgstr "　なにしろ月まで吹っ飛ばした暴れん坊だ。"

#. Occurrence 6_1:901:7372: scene=6_1
#: 6_1:901
msgctxt "text_id=7372 | speaker=unknown"
msgid "  He couldn't quite grasp the conversation."
msgstr "　会話の内容はよく掴めない。"

#. Occurrence 6_1:906:7373: scene=6_1
#: 6_1:906
msgctxt "text_id=7373 | speaker=unknown"
msgid "  Though somehow, vaguely, he had the sense that his human rights were being largely ignored. ...It was deeply unsettling, even for a dream."
msgstr "　彼はなんとなく、漠然と、自分の人権あたりが盛大に無視されている気がした。……いかに夢中の出来事とはいえ、<甚|はなは>だよろしくない。"

#. Occurrence 6_1:911:7374: scene=6_1
#: 6_1:911
msgctxt "text_id=7374 | speaker=unknown"
msgid "  After several minutes..."
msgstr "　数分の後。"

#. Occurrence 6_1:916:7375: scene=6_1
#: 6_1:916
msgctxt "text_id=7375 | speaker=unknown"
msgid "  It seemed that the high-impact argument ended in Aoko's victory."
msgstr "　大迫力の口論は、青子側の勝利で終わったらしい。"

#. Occurrence 6_1:939:7376: scene=6_1
#: 6_1:939
msgctxt "text_id=7376 | speaker=unknown"
msgid "  Then suddenly, the boisterous voice faded."
msgstr "　そうして、強風のようだった声も聞こえなくなった。"

#. Occurrence 6_1:944:7377: scene=6_1
#: 6_1:944
msgctxt "text_id=7377 | speaker=unknown"
msgid "  Praying everything would be back to normal, he opened his eyes."
msgstr "　次はマトモな光景でありますように、と他力本願<気|ぎ><味|み>に目を開ける。"

#. Occurrence 6_1:1027:7378: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_1_0002; voice_prefix=A30; voice_category=3; scene=6_1
#: 6_1:1027
msgctxt "text_id=7378 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 6_1:1033:7379: scene=6_1
#: 6_1:1033
msgctxt "text_id=7379 | speaker=unknown"
msgid "  He took a deep, slow breath."
msgstr "　わずかに息をのむ。"

#. Occurrence 6_1:1038:7380: scene=6_1
#: 6_1:1038
msgctxt "text_id=7380 | speaker=unknown"
msgid "  The scenery was a far cry from the nostalgic dreamscape he had just left, albeit not unpleasant either."
msgstr "　先ほどまでの懐かしい記憶とは何もかも違う、けれど、そう嫌いでもない風景。"

#. Occurrence 6_1:1043:7381: scene=6_1
#: 6_1:1043
msgctxt "text_id=7381 | speaker=unknown"
msgid "  Without a doubt, it was the amusement park."
msgstr "　確かめるまでもなく、そこはあの遊園地だった。"

#. Occurrence 6_1:1063:7382: scene=6_1
#: 6_1:1063
msgctxt "text_id=7382 | speaker=unknown"
msgid "  To him, his was his freshest memory."
msgstr "　彼にとって最も鮮明な<過去|いぜん>の記憶。"

#. Occurrence 6_1:1068:7383: scene=6_1
#: 6_1:1068
msgctxt "text_id=7383 | speaker=unknown"
msgid "  He recalled the house of mirrors that Aoko Aozaki destroyed."
msgstr "　蒼崎青子が爆破したミラーハウスが懐かしい。"

#. Occurrence 6_1:1073:7384: scene=6_1
#: 6_1:1073
msgctxt "text_id=7384 | speaker=unknown"
msgid "  This park was a flawless replica of reality, but he was the only one there."
msgstr "　現実と寸分の狂いもない遊園地だが、今いるのは彼だけだ。"

#. Occurrence 6_1:1078:7385: scene=6_1
#: 6_1:1078
msgctxt "text_id=7385 | speaker=unknown"
msgid "  Without having to worry about anyone chasing him, he sat down on the wreckage of Kitsy's rides and looked up at the moon that should have been shot down."
msgstr "　誰に追いかけられる心配もないので、キッツィーちゃんの残骸に腰を下ろして、撃ち抜かれた筈の月を見上げた。"

#. Occurrence 6_1:1138:7386: scene=6_1
#: 6_1:1138
msgctxt "text_id=7386 | speaker=unknown"
msgid "  The winter moon shone white like a jewel."
msgstr "　白い、<玻璃|はり>を思わせる冬の月。"

#. Occurrence 6_1:1143:7387: scene=6_1
#: 6_1:1143
msgctxt "text_id=7387 | speaker=unknown"
msgid "  It was layered over the figure of the girl who'd tried to kill him."
msgstr "　その月を背に、彼を殺そうとした少女の姿が重なった。"

#. Occurrence 6_1:1148:7388: scene=6_1
#: 6_1:1148
msgctxt "text_id=7388 | speaker=unknown"
msgid "  ...If a mage was a witch, then she definitely fit the bill."
msgstr "　……魔術師が魔女だと言うのなら、あの瞬間の彼女は確かにそうだったのだろう。"

#. Occurrence 6_1:1153:7389: scene=6_1
#: 6_1:1153
msgctxt "text_id=7389 | speaker=unknown"
msgid "\"I don't mind being killed.\""
msgstr "“殺されてもいい”"

#. Occurrence 6_1:1158:7390: scene=6_1
#: 6_1:1158
msgctxt "text_id=7390 | speaker=unknown"
msgid "  Such an absurd thing to say, but it spilled out of him so naturally."
msgstr "　そんな、あまりにも馬鹿げた言葉が、ごく自然にこぼれたぐらいには。"

#. Occurrence 6_1:1179:7391: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_1_0004; voice_prefix=A30; voice_category=3; scene=6_1
#: 6_1:1179
msgctxt "text_id=7391 | speaker=soujuurou"
msgid "\"...Well, maybe...\""
msgstr "「……いや、でも―――」"

#. Occurrence 6_1:1185:7392: scene=6_1
#: 6_1:1185
msgctxt "text_id=7392 | speaker=unknown"
msgid "  That had nothing to do with witches or magecraft."
msgstr "　あれは魔女やら魔術やらとは関係ない。"

#. Occurrence 6_1:1190:7393: scene=6_1
#: 6_1:1190
msgctxt "text_id=7393 | speaker=unknown"
msgid "  There was an echo in the gaps of his heart."
msgstr "　<胸|こころ>の隙をついた響き。"

#. Occurrence 6_1:1195:7394: scene=6_1
#: 6_1:1195
msgctxt "text_id=7394 | speaker=unknown"
msgid "  If she had not spoken those words, then he would not have responded as he did."
msgstr "　彼女があんな言葉さえ口にしなければ、彼もあんな言葉を返さなかった。"

#. Occurrence 6_1:1218:7395: scene=6_1
#: 6_1:1218
msgctxt "text_id=7395 | speaker=unknown"
msgid "  In that moment, what had Aoko Aozaki said to him?"
msgstr "　……あのとき、蒼崎青子はどんな言葉を投げたのか。"

#. Occurrence 6_1:1223:7396: scene=6_1
#: 6_1:1223
msgctxt "text_id=7396 | speaker=unknown"
msgid "  As he tried to remember, his deep slumber drew to an end."
msgstr "　それを思い出そうとしているうちに、深かった彼の眠りは終わりを告げた。"

#. Occurrence 6_1:1229:7397: scene=6_1
#: 6_1:1229
msgctxt "text_id=7397 | speaker=unknown"
msgid "  And with it, his chance to find the answers he so wished he could find."
msgstr "　もしかすると、夢見より長かった回想の答えもないままに。"

#. Occurrence 6_2:61:7398: scene=6_2
#: 6_2:61
msgctxt "text_id=7398 | speaker=unknown"
msgid "  Then..."
msgstr "　……そうして。"

#. Occurrence 6_2:66:7399: scene=6_2
#: 6_2:66
msgctxt "text_id=7399 | speaker=unknown"
msgid "  Soujyuro woke up in an unfamiliar room, gasping."
msgstr "　見知らぬ部屋のベッドで目を覚ました瞬間、草十郎は大きく息を呑んだ。"

#. Occurrence 6_2:71:7400: scene=6_2
#: 6_2:71
msgctxt "text_id=7400 | speaker=unknown"
msgid "  Not because the plush mattress he was on was softer than his apartment's cheap futon,"
msgstr "　アパートの安布団とは段違いのベッドの感触や、"

#. Occurrence 6_2:76:7401: scene=6_2
#: 6_2:76
msgctxt "text_id=7401 | speaker=unknown"
msgid "  or because everything from the carpet to the wallpaper looked expensive..."
msgstr "　絨毯はおろか壁紙まで高価そうな部屋の雰囲気に……ではなく。"

#. Occurrence 6_2:105:7402: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0000; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:105
msgctxt "text_id=7402 | speaker=soujuurou"
msgid "\"...\""
msgstr "「―――、―――」"

#. Occurrence 6_2:111:7403: scene=6_2
#: 6_2:111
msgctxt "text_id=7403 | speaker=unknown"
msgid "  Bewildered, he tried to catch his breath."
msgstr "　眼を白黒させたまま、こぼれかけた息を呑みこむ。"

#. Occurrence 6_2:116:7404: scene=6_2
#: 6_2:116
msgctxt "text_id=7404 | speaker=unknown"
msgid "  She was the cause of his surprise."
msgstr "　驚きの<原因|モト>はそれだ。"

#. Occurrence 6_2:121:7405: scene=6_2
#: 6_2:121
msgctxt "text_id=7405 | speaker=unknown"
msgid "  The moment Soujyuro's eyes snapped open, there she was, the girl dressed in black, sitting at his bedside."
msgstr "　草十郎がぱちりと目を覚ました<傍|かたわ>らに、あの、黒衣の少女が座っていた。"

#. Occurrence 6_2:157:7406: scene=6_2
#: 6_2:157
msgctxt "text_id=7406 | speaker=unknown"
msgid "  The silence was deafening."
msgstr "　物音ひとつない静寂だった。"

#. Occurrence 6_2:162:7407: scene=6_2
#: 6_2:162
msgctxt "text_id=7407 | speaker=unknown"
msgid "  Still supine on the bed, Soujyuro gazed at her."
msgstr "　草十郎はベッドに横になったまま少女を見つめる。"

#. Occurrence 6_2:167:7408: scene=6_2
#: 6_2:167
msgctxt "text_id=7408 | speaker=unknown"
msgid "  His impulse was to sit up, but he refrained, thinking it might be rude to be it staring at the person sitting next to him."
msgstr "　なんとなく<上半身|からだ>を起こしたい衝動にかられもしたが、真っ正面からまじまじと見るのは無遠慮かもしれない、と思いとどまった。"

#. Occurrence 6_2:223:7409: scene=6_2
#: 6_2:223
msgctxt "text_id=7409 | speaker=unknown"
msgid "  She was just sitting there, on a chair,"
msgstr "　少女は椅子に座っているようだ。"

#. Occurrence 6_2:228:7410: scene=6_2
#: 6_2:228
msgctxt "text_id=7410 | speaker=unknown"
msgid "  dressed in black, modest clothes."
msgstr "　黒い、飾り気のない服装。"

#. Occurrence 6_2:233:7411: scene=6_2
#: 6_2:233
msgctxt "text_id=7411 | speaker=unknown"
msgid "  Still, she projected an air that was anything but plain; her monochrome outfit evoked indescribable elegance."
msgstr "　そのくせ質素な印象はなく、単色なのに言いようのない気品を感じる。"

#. Occurrence 6_2:238:7412: scene=6_2
#: 6_2:238
msgctxt "text_id=7412 | speaker=unknown"
msgid "  Like a costume handmade just for her, from the finest fabrics."
msgstr "　高級な繊維で作られた、この少女の為の装飾―――"

#. Occurrence 6_2:243:7413: scene=6_2
#: 6_2:243
msgctxt "text_id=7413 | speaker=unknown"
msgid "  It was enough to inspire poetic sentiments even in Soujyuro."
msgstr "　そんな詩的な感想を、草十郎をして抱かせるほどの。"

#. Occurrence 6_2:281:7414: scene=6_2
#: 6_2:281
msgctxt "text_id=7414 | speaker=unknown"
msgid "  The girl continued to sit, completely motionless."
msgstr "　少女は座ったままぴくりとも動かない。"

#. Occurrence 6_2:287:7415: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0001; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:287
msgctxt "text_id=7415 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 6_2:292:7416: scene=6_2
#: 6_2:292
msgctxt "text_id=7416 | speaker=unknown"
msgid "  Without realizing it, Soujyuro had stopped breathing."
msgstr "　草十郎の呼吸は知らず止まっていた。"

#. Occurrence 6_2:297:7417: scene=6_2
#: 6_2:297
msgctxt "text_id=7417 | speaker=unknown"
msgid "  Genuine astonishment had him captivated."
msgstr "　呼吸を忘れて少女に見入ったのは、純粋な驚きからだ。"

#. Occurrence 6_2:302:7418: scene=6_2
#: 6_2:302
msgctxt "text_id=7418 | speaker=unknown"
msgid "  Such beauty..."
msgstr "　ただ美しい。"

#. Occurrence 6_2:307:7419: scene=6_2
#: 6_2:307
msgctxt "text_id=7419 | speaker=unknown"
msgid "  It was the first time he had ever thought to use such a simple, plain expression to describe another human being."
msgstr "　その、あまりにも単純で、あんまりにも理由のない表現を同じ<人間|いきもの>に用いたのは、初めてのことだった。"

#. Occurrence 6_2:357:7420: scene=6_2
#: 6_2:357
msgctxt "text_id=7420 | speaker=unknown"
msgid "  She was the daffodil, in perfect bloom."
msgstr "　純潔のまま成長した<水仙|すいせん>の花。"

#. Occurrence 6_2:363:7421: scene=6_2
#: 6_2:363
msgctxt "text_id=7421 | speaker=unknown"
msgid "  Or the ideal female form, seen only in dreams."
msgstr "　あるいは、夢に描かれた理想の少女像。"

#. Occurrence 6_2:409:7422: scene=6_2
#: 6_2:409
msgctxt "text_id=7422 | speaker=unknown"
msgid "  This quality was something to be cherished and admired in her."
msgstr "　少女のソレは、鑑賞され、愛でられる為の美しさだ。"

#. Occurrence 6_2:414:7423: scene=6_2
#: 6_2:414
msgctxt "text_id=7423 | speaker=unknown"
msgid "  It was different from Aoko Aozaki's blindingly radiant vitality."
msgstr "　蒼崎青子の華やかな、生命に満ちた輝きとは違う。"

#. Occurrence 6_2:419:7424: scene=6_2
#: 6_2:419
msgctxt "text_id=7424 | speaker=unknown"
msgid "  After all, the flame that burns twice as bright burns half as long,"
msgstr "　なぜなら、生命あるかぎり人は老いて尽きる。"

#. Occurrence 6_2:424:7425: scene=6_2
#: 6_2:424
msgctxt "text_id=7425 | speaker=unknown"
msgid "  and there was no way this girl would be allowed such a happy ending."
msgstr "　そのような結末―――幸福な完結は、この少女には許される筈がない。"

#. Occurrence 6_2:444:7426: scene=6_2
#: 6_2:444
msgctxt "text_id=7426 | speaker=unknown"
msgid "  Her life was a solitary fable of someone who left the world in exactly the same way they entered it."
msgstr "　それはこの<奇跡|カタチ>のまま生まれ、このカタチのまま滅び去るひとつの<寓話|ぐうわ>。"

#. Occurrence 6_2:449:7427: scene=6_2
#: 6_2:449
msgctxt "text_id=7427 | speaker=unknown"
msgid "  With her humanity stolen at birth, hers was an existence not of this world."
msgstr "　生まれながらに人間としての生を奪われた、この世ならざる命のあり方。"

#. Occurrence 6_2:455:7428: scene=6_2
#: 6_2:455
msgctxt "text_id=7428 | speaker=unknown"
msgid "  ...The more beautiful something was, the more tragic its fate."
msgstr "　……<過|か><度|ど>に美しいものほど、結末は<無惨|むざん>なものになる。"

#. Occurrence 6_2:460:7429: scene=6_2
#: 6_2:460
msgctxt "text_id=7429 | speaker=unknown"
msgid "  Growing up in the mountains, this was not something Soujyuro was taught, but something he learned from experience."
msgstr "　山奥育ちの草十郎にとって、それは教えられるまでもなく経験している事だった。"

#. Occurrence 6_2:514:7430: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0002; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:514
msgctxt "text_id=7430 | speaker=soujuurou"
msgid "(...It looks like she's sleeping.)"
msgstr "『……眠ってるみたいだ』"

#. Occurrence 6_2:523:7431: scene=6_2
#: 6_2:523
msgctxt "text_id=7431 | speaker=unknown"
msgid "  Soujyuro turned his head, as though he was being lured in."
msgstr "　草十郎は誘われるように、首を横に向ける。"

#. Occurrence 6_2:528:7432: scene=6_2
#: 6_2:528
msgctxt "text_id=7432 | speaker=unknown"
msgid "  He knew it was rude to stare, but he couldn't fight his instincts."
msgstr "　横顔を盗み見るのは無遠慮だと知りつつ、本能には逆らえなかった。"

#. Occurrence 6_2:533:7433: scene=6_2
#: 6_2:533
msgctxt "text_id=7433 | speaker=unknown"
msgid "  Then..."
msgstr "　そうして―――"

#. Occurrence 6_2:599:7434: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0003; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:599
msgctxt "text_id=7434 | speaker=soujuurou"
msgid "\"...Huh?\""
msgstr "「……え？」"

#. Occurrence 6_2:605:7435: scene=6_2
#: 6_2:605
msgctxt "text_id=7435 | speaker=unknown"
msgid "  This time, his heart actually skipped a beat."
msgstr "　今度こそ本当に、一瞬、心臓が止まった。"

#. Occurrence 6_2:610:7436: scene=6_2
#: 6_2:610
msgctxt "text_id=7436 | speaker=unknown"
msgid "  She was not asleep at all."
msgstr "　少女は眠ってなどいなかった。"

#. Occurrence 6_2:615:7437: scene=6_2
#: 6_2:615
msgctxt "text_id=7437 | speaker=unknown"
msgid "  Expressionless, she was merely watching over him while he recovered."
msgstr "　無表情に、横たわる怪我人を見つめていただけだったのだ。"

#. Occurrence 6_2:673:7438: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0004; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:673
msgctxt "text_id=7438 | speaker=soujuurou"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence 6_2:678:7439: scene=6_2
#: 6_2:678
msgctxt "text_id=7439 | speaker=unknown"
msgid "  Soujyuro froze, unable to turn his head away or think of something clever to say. It was like staring into her eyes turned him to stone."
msgstr "　草十郎はベッドに横になったまま、動かした首を戻す事もできず、かといって気のきいた台詞も浮かばず、少女と無言で見つめあう。"

#. Occurrence 6_2:698:7440: scene=6_2
#: 6_2:698
msgctxt "text_id=7440 | speaker=unknown"
msgid "  Perhaps because of her delicate features, she looked somewhat younger than him."
msgstr "　……<華奢|きゃしゃ>な輪郭からか、自分よりいくぶん幼く見える。"

#. Occurrence 6_2:703:7441: scene=6_2
#: 6_2:703
msgctxt "text_id=7441 | speaker=unknown"
msgid "  On the other hand, her tranquil expression made him feel like she was older."
msgstr "　反面、落ち着いた表情が年上のようにも感じさせた。"

#. Occurrence 6_2:708:7442: scene=6_2
#: 6_2:708
msgctxt "text_id=7442 | speaker=unknown"
msgid "  Jet-black hair, just to her shoulders."
msgstr "　肩口までの髪はにごりのない黒。"

#. Occurrence 6_2:713:7443: scene=6_2
#: 6_2:713
msgctxt "text_id=7443 | speaker=unknown"
msgid "  Her large eyes were set like onyx stones, matching her hair."
msgstr "　そんな髪に合わせたように、大きめの瞳も混ざり気のない黒一色。"

#. Occurrence 6_2:752:7444: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0005; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:752
msgctxt "text_id=7444 | speaker=soujuurou"
msgid "\"......\""
msgstr "「……………………」"

#. Occurrence 6_2:758:7445: scene=6_2
#: 6_2:758
msgctxt "text_id=7445 | speaker=unknown"
msgid "  Devoid of emotion, her gaze stayed fixed on Soujyuro."
msgstr "　少女は感情のない瞳を草十郎に向けている。"

#. Occurrence 6_2:763:7446: scene=6_2
#: 6_2:763
msgctxt "text_id=7446 | speaker=unknown"
msgid "  Even after their eyes met, she did not turn away."
msgstr "　草十郎と見つめ合うカタチになっても目は逸らさない。"

#. Occurrence 6_2:796:7447: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0006; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:796
msgctxt "text_id=7447 | speaker=soujuurou"
msgid "\".........\""
msgstr "「…………………………」"

#. Occurrence 6_2:802:7448: scene=6_2
#: 6_2:802
msgctxt "text_id=7448 | speaker=unknown"
msgid "  He wanted to speak, but could not find the words."
msgstr "　草十郎は声をかけようにもかけられない。"

#. Occurrence 6_2:807:7449: scene=6_2
#: 6_2:807
msgctxt "text_id=7449 | speaker=unknown"
msgid "  It was not unlike a frog being stared down by a snake. Nevertheless he just could not bring himself to say something."
msgstr "　蛇に睨まれた蛙、という程でもないけれど、いま少女に話しかけるのは<躊躇|ためら>われた。"

#. Occurrence 6_2:812:7450: scene=6_2
#: 6_2:812
msgctxt "text_id=7450 | speaker=unknown"
msgid "  Additionally..."
msgstr "　それに、"

#. Occurrence 6_2:906:7451: scene=6_2
#: 6_2:906
msgctxt "text_id=7451 | speaker=unknown"
msgid "  No matter how carefree Soujyuro might have been, he was painfully aware that this girl was as powerful as Aoko."
msgstr "　いかに<暢気|のんき>な草十郎でも、この少女が青子と同じ種類の<爆|にん><弾|げん>である事は身に染みて知っていた。"

#. Occurrence 6_2:912:7452: scene=6_2
#: 6_2:912
msgctxt "text_id=7452 | speaker=unknown"
msgid "  Less talkative, to be sure, but still powerful."
msgstr "　一方、少女は少女で<堅|かた>く口を閉ざしている。"

#. Occurrence 6_2:917:7453: scene=6_2
#: 6_2:917
msgctxt "text_id=7453 | speaker=unknown"
msgid "  Objectively, the scene was not unlike that of someone nursing a bedridden stranger."
msgstr "　一心に、雑念なく、横になった異邦人を看病する……ような雰囲気。"

#. Occurrence 6_2:952:7454: scene=6_2
#: 6_2:952
msgctxt "text_id=7454 | speaker=unknown"
msgid "  He had no idea what she may have been thinking about, but it seemed to him this harsh silence might last forever."
msgstr "　少女が何を考えているかは不明だが、草十郎にとっては辛い沈黙が続いていく。"

#. Occurrence 6_2:957:7455: scene=6_2
#: 6_2:957
msgctxt "text_id=7455 | speaker=unknown"
msgid "  All he could say for sure was that the quiet did not appear to bother her in the slightest."
msgstr "　草十郎に分かるのは、少女はこの沈黙をまったく気にしていない、という事だけ。"

#. Occurrence 6_2:962:7456: scene=6_2
#: 6_2:962
msgctxt "text_id=7456 | speaker=unknown"
msgid "  It was like some bizarre form of punishment."
msgstr "　これでは何らかの罰ゲーム、<罰則|ペナルティ>と言えなくもない。"

#. Occurrence 6_2:988:7457: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0007; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:988
msgctxt "text_id=7457 | speaker=soujuurou"
msgid "(...If this is some kind of test from Aozaki, it sure is elaborate.)"
msgstr "『……。これが蒼崎の仕込みなら手がこみすぎる……』"

#. Occurrence 6_2:994:7458: scene=6_2
#: 6_2:994
msgctxt "text_id=7458 | speaker=unknown"
msgid "  He thought, keeping his eyes on the girl."
msgstr "　などと思いつつも、草十郎は少女から目を離せなかった。"

#. Occurrence 6_2:999:7459: scene=6_2
#: 6_2:999
msgctxt "text_id=7459 | speaker=unknown"
msgid "  He felt like the moment he turned his head or blinked, she might stab him in the chest with a hidden blade..."
msgstr "　自分が首を戻したり目を閉じた瞬間、少女が隠し持ったナイフで自分の胸を刺すのでは……"

#. Occurrence 6_2:1004:7460: scene=6_2
#: 6_2:1004
msgctxt "text_id=7460 | speaker=unknown"
msgid "  ...and not because his imagination was running away with him."
msgstr "　なんて想像をかきたてられたからではない。"

#. Occurrence 6_2:1031:7461: scene=6_2
#: 6_2:1031
msgctxt "text_id=7461 | speaker=unknown"
msgid "  In the stifling silence, it was only natural that Soujyuro would think back on what had happened in the amusement park, and it made him uneasy."
msgstr "　たしかに重苦しい沈黙で、遊園地での事を思い返すと不安になるけれど―――"

#. Occurrence 6_2:1036:7462: scene=6_2
#: 6_2:1036
msgctxt "text_id=7462 | speaker=unknown"
msgid "  But stronger than any anxiety was his fascination with the girl."
msgstr "　それ以上に少女は魅力的だと、彼は思ったのだ。"

#. Occurrence 6_2:1084:7463: scene=6_2
#: 6_2:1084
msgctxt "text_id=7463 | speaker=unknown"
msgid "  Her slender frame and milky white skin..."
msgstr "　細い体と白い肌。"

#. Occurrence 6_2:1089:7464: scene=6_2
#: 6_2:1089
msgctxt "text_id=7464 | speaker=unknown"
msgid "  The chill of her guarded stare, the warmth of her lingering femininity..."
msgstr "　人を寄せ付けない瞳の冷たさと、いまだ残った少女の面影の温かさ。"

#. Occurrence 6_2:1094:7465: scene=6_2
#: 6_2:1094
msgctxt "text_id=7465 | speaker=unknown"
msgid "  It was the mixture of those two latter qualities that was almost magical."
msgstr "　その二つが混ざりあった姿は、魔的なものと言ってもいい。"

#. Occurrence 6_2:1115:7466: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0008; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1115
msgctxt "text_id=7466 | speaker=soujuurou"
msgid "(...?)"
msgstr "『…………？』"

#. Occurrence 6_2:1120:7467: scene=6_2
#: 6_2:1120
msgctxt "text_id=7467 | speaker=unknown"
msgid "  He stared at her for so long, he began to get the feeling that they had met somewhere before."
msgstr "　そこまで少女と向き合って、草十郎は彼女とは以前会っているような気がした。"

#. Occurrence 6_2:1125:7468: scene=6_2
#: 6_2:1125
msgctxt "text_id=7468 | speaker=unknown"
msgid "  Sometime before the conflict at Kitsy Land..."
msgstr "　遊園地の一件よりもう少し前。"

#. Occurrence 6_2:1130:7469: scene=6_2
#: 6_2:1130
msgctxt "text_id=7469 | speaker=unknown"
msgid "  He could not quite put his finger on it, but he was sure he had seen her previously."
msgstr "　どこでだったかは思い出せないけれど、たしかに以前見かけた気がする。"

#. Occurrence 6_2:1166:7470: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0009; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1166
msgctxt "text_id=7470 | speaker=soujuurou"
msgid "\"Um, I don't know if this is the right time to ask this, but...\""
msgstr "「その、いまさらだけど」"

#. Occurrence 6_2:1172:7471: scene=6_2
#: 6_2:1172
msgctxt "text_id=7471 | speaker=unknown"
msgid "  His voice shattered the frozen silence in the room."
msgstr "　凍りついた部屋に、白々しく響く自分の声。"

#. Occurrence 6_2:1177:7472: scene=6_2
#: 6_2:1177
msgctxt "text_id=7472 | speaker=unknown"
msgid "  He almost felt sorry for making noise as he spoke out to her."
msgstr "　その場違いさに申し訳ない気持ちになりながら、草十郎は少女に語りかけた。"

#. Occurrence 6_2:1182:7473: scene=6_2
#: 6_2:1182
msgctxt "text_id=7473 | speaker=unknown"
msgid "  But they could not very well just sit and stare at each other forever."
msgstr "　いつまでも見つめ合っている訳にもいかない。"

#. Occurrence 6_2:1187:7474: scene=6_2
#: 6_2:1187
msgctxt "text_id=7474 | speaker=unknown"
msgid "  ...Though, he might have been the only one thinking they were \"staring,\" and perhaps she thought they were \"glaring\" at each other."
msgstr "　……見つめ合っていると思っていたのは自分だけで、少女は睨み合っていたつもりかも知れないし。"

#. Occurrence 6_2:1253:7475: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0010; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1253
msgctxt "text_id=7475 | speaker=soujuurou"
msgid "\"Where am I, and who might you be?\""
msgstr "「ここはどこで、君は誰だか分かるかな」"

#. Occurrence 6_2:1259:7476: scene=6_2
#: 6_2:1259
msgctxt "text_id=7476 | speaker=unknown"
msgid "  She narrowed her eyes slightly,"
msgstr "　少女は黒い瞳をかすかに細める。"

#. Occurrence 6_2:1264:7477: scene=6_2
#: 6_2:1264
msgctxt "text_id=7477 | speaker=unknown"
msgid "  though apparently, not out of offense."
msgstr "　気分を害した……風ではなさそうだ。"

#. Occurrence 6_2:1285:7478: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_2_0000; voice_prefix=A40; voice_category=2; scene=6_2
#: 6_2:1285
msgctxt "text_id=7478 | speaker=alice"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 6_2:1291:7479: scene=6_2
#: 6_2:1291
msgctxt "text_id=7479 | speaker=unknown"
msgid "  There was no response."
msgstr "　質問の返事はない。"

#. Occurrence 6_2:1296:7480: scene=6_2
#: 6_2:1296
msgctxt "text_id=7480 | speaker=unknown"
msgid "  Just as he was thinking it would have been better to keep quiet, she quietly raised her hand."
msgstr "　やっぱり黙ってよう、と草十郎が思った矢先、少女は静かに片腕を上げた。"

#. Occurrence 6_2:1366:7481: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_2_0001; voice_prefix=A40; voice_category=2; scene=6_2
#: 6_2:1366
msgctxt "text_id=7481 | speaker=alice"
msgid "\"This is yours, is it not?\""
msgstr "「これ、あなたのでしょう」"

#. Occurrence 6_2:1372:7482: scene=6_2
#: 6_2:1372
msgctxt "text_id=7482 | speaker=unknown"
msgid "  Her voice was cold, but melodic."
msgstr "　冷たいが、唄のような声。"

#. Occurrence 6_2:1377:7483: scene=6_2
#: 6_2:1377
msgctxt "text_id=7483 | speaker=unknown"
msgid "  A white piece of cloth was wrapped in her fingers."
msgstr "　少女の指には白い布が<絡|から>まっている。"

#. Occurrence 6_2:1382:7484: scene=6_2
#: 6_2:1382
msgctxt "text_id=7484 | speaker=unknown"
msgid "  There was no need to tell him what it was."
msgstr "　それが何であるかなど、草十郎には語るまでもない。"

#. Occurrence 6_2:1387:7485: scene=6_2
#: 6_2:1387
msgctxt "text_id=7485 | speaker=unknown"
msgid "  He was conscious enough to recognize his own possessions."
msgstr "　自分の持ち物を忘れるほど寝ぼけてはいなかったらしい。"

#. Occurrence 6_2:1440:7486: scene=6_2
#: 6_2:1440
msgctxt "text_id=7486 | speaker=unknown"
msgid "  Soujyuro sat speechless as she tossed it to him."
msgstr "　無言の草十郎に、少女はふわりと布を落とした。"

#. Occurrence 6_2:1447:7487: scene=6_2
#: 6_2:1447
msgctxt "text_id=7487 | speaker=unknown"
msgid "  Picking it up, he wrapped it around his neck."
msgstr "　草十郎は布を拾い上げ、くるくると自分の首に巻く。"

#. Occurrence 6_2:1501:7488: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_2_0002; voice_prefix=A40; voice_category=2; scene=6_2
#: 6_2:1501
msgctxt "text_id=7488 | speaker=alice"
msgid "\"...Does Aoko know about that?\""
msgstr "「……青子は、それを知っているの？」"

#. Occurrence 6_2:1507:7489: scene=6_2
#: 6_2:1507
msgctxt "text_id=7489 | speaker=unknown"
msgid "  He looked away in response to her blunt question,"
msgstr "　ぶしつけな問いから、草十郎は目を逸らす。"

#. Occurrence 6_2:1512:7490: scene=6_2
#: 6_2:1512
msgctxt "text_id=7490 | speaker=unknown"
msgid "  distracted by something unrelated."
msgstr "　彼の頭に浮かんだのはまったく関係のない事だ。"

#. Occurrence 6_2:1517:7491: scene=6_2
#: 6_2:1517
msgctxt "text_id=7491 | speaker=unknown"
msgid "  She called Aoko Aozaki by her given name,"
msgstr "　少女は蒼崎青子を『青子』と呼んだ。"

#. Occurrence 6_2:1522:7492: scene=6_2
#: 6_2:1522
msgctxt "text_id=7492 | speaker=unknown"
msgid "  which led him to believe that the mountain Aoko had argued with in his dream was actually the girl beside him."
msgstr "　では、青子が喧嘩を売っていたのは向かいの山ではなく彼女だったのだろう、と。"

#. Occurrence 6_2:1558:7493: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0011; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1558
msgctxt "text_id=7493 | speaker=soujuurou"
msgid "\"I'm not sure.\""
msgstr "「さあ、どうだろう」"

#. Occurrence 6_2:1564:7494: scene=6_2
#: 6_2:1564
msgctxt "text_id=7494 | speaker=unknown"
msgid "  As sincerely as he could, he answered without presumption."
msgstr "　できるだけ真摯に、予断を<交|まじ>えず草十郎は返答する。"

#. Occurrence 6_2:1584:7495: scene=6_2
#: 6_2:1584
msgctxt "text_id=7495 | speaker=unknown"
msgid "  There are things that should be known, and things that need not be."
msgstr "　知るべき事と、知らなくてもいい事。"

#. Occurrence 6_2:1589:7496: scene=6_2
#: 6_2:1589
msgctxt "text_id=7496 | speaker=unknown"
msgid "  There are also things that should be told, and other things that must not be."
msgstr "　伝えるべき事と、伝わってはいけない事。"

#. Occurrence 6_2:1594:7497: scene=6_2
#: 6_2:1594
msgctxt "text_id=7497 | speaker=unknown"
msgid "  Soujyuro was not exactly sure what \"that\" she was referring to. However..."
msgstr "　少女の言う「それ」がどちらなのか、草十郎には考えられない。ただ、"

#. Occurrence 6_2:1601:7498: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0012; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1601
msgctxt "text_id=7498 | speaker=soujuurou"
msgid "\"But, maybe it's better that way.\""
msgstr "「でも、その方がいいとは思うよ」"

#. Occurrence 6_2:1618:7499: scene=6_2
#: 6_2:1618
msgctxt "text_id=7499 | speaker=unknown"
msgid "  He smiled slightly at her question."
msgstr "　ごく自然に、少女の問いに微笑んだ。"

#. Occurrence 6_2:1638:7500: scene=6_2
#: 6_2:1638
msgctxt "text_id=7500 | speaker=unknown"
msgid "  Perhaps impressed by his response, the overwhelming pressure in the room dissipated noticeably."
msgstr "　そんな草十郎の対応に感じ入るものがあったのか、部屋を支配していた重圧は目に見えて薄れていった。"

#. Occurrence 6_2:1643:7501: scene=6_2
#: 6_2:1643
msgctxt "text_id=7501 | speaker=unknown"
msgid "  Or maybe she had been more nervous than he was the entire time,"
msgstr "　もしかすると、緊張の度合いは草十郎より少女の方が上だったのかも知れない。"

#. Occurrence 6_2:1648:7502: scene=6_2
#: 6_2:1648
msgctxt "text_id=7502 | speaker=unknown"
msgid "  projecting the image that his room was her domain a tad too strongly."
msgstr "　……この場を支配していた少女の心の在り方が、部屋に投影されていたのなら。"

#. Occurrence 6_2:1707:7503: scene=6_2
#: 6_2:1707
msgctxt "text_id=7503 | speaker=unknown"
msgid "  The tension faded."
msgstr "　緊張は消えた。"

#. Occurrence 6_2:1720:7504: scene=6_2
#: 6_2:1720
msgctxt "text_id=7504 | speaker=unknown"
msgid "  Soujyuro tried to sit up and prop his arms beneath him."
msgstr "　草十郎は体を起こそうとベッドに腕をたてる。"

#. Occurrence 6_2:1725:7505: scene=6_2
#: 6_2:1725
msgctxt "text_id=7505 | speaker=unknown"
msgid "  Now that they were talking, it seemed awkward to stay lying down."
msgstr "　こうして話し合える以上、寝たままなのは不便だと思ったらしい。"

#. Occurrence 6_2:1730:7506: scene=6_2
#: 6_2:1730
msgctxt "text_id=7506 | speaker=unknown"
msgid "  However, his body felt strange as he tried to move, and it surprised him how difficult it was to sit up."
msgstr "　が。起きようとした途端、体の異様なだるさに驚いてしまって、簡単には起き上がれなかった。"

#. Occurrence 6_2:1736:7507: scene=6_2
#: 6_2:1736
msgctxt "text_id=7507 | speaker=unknown"
msgid "  It took everything he had just to raise his upper body to a sitting position."
msgstr "　もぞもぞと動いて、ようやく上半身を起こすのが精一杯だ。"

#. Occurrence 6_2:1786:7508: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0013; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1786
msgctxt "text_id=7508 | speaker=soujuurou"
msgid "\"...Huh? I'm still in my clothes.\""
msgstr "「……あれ？　洋服のままだ」"

#. Occurrence 6_2:1792:7509: scene=6_2
#: 6_2:1792
msgctxt "text_id=7509 | speaker=unknown"
msgid "  As he threw the covers back, he tilted his head quizzically."
msgstr "　かかっていた毛布を<剥|は>ぐなり、不思議そうに首をかしげる。"

#. Occurrence 6_2:1819:7510: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0014; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1819
msgctxt "text_id=7510 | speaker=soujuurou"
msgid "\"I'm sorry. This is such a nice bed, too. I shouldn't be in my clothes under the sheets. What a waste of a good bed.\""
msgstr "「申し訳ない。こんないい布団なのに、これじゃ不釣り合いだ。……というより、勿体ない」"

#. Occurrence 6_2:1845:7511: scene=6_2
#: 6_2:1845
msgctxt "text_id=7511 | speaker=unknown"
msgid "  She stared at him, not expecting him to complain about not wearing pajamas while sleeping."
msgstr "　どうせならベッドに似合う寝間着で寝たかった、などとぼやく草十郎を、少女は意外そうに見つめている。"

#. Occurrence 6_2:1850:7512: scene=6_2
#: 6_2:1850
msgctxt "text_id=7512 | speaker=unknown"
msgid "  Somehow, it appeared that he had done something to surprise her."
msgstr "　何か、少女にとって予想外の事をしてしまったらしい。"

#. Occurrence 6_2:1886:7513: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0015; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1886
msgctxt "text_id=7513 | speaker=soujuurou"
msgid "(But why? I didn't do anything.)"
msgstr "『なんでだ。何もしてないぞ、俺』"

#. Occurrence 6_2:1892:7514: scene=6_2
#: 6_2:1892
msgctxt "text_id=7514 | speaker=unknown"
msgid "  Pouting a bit at the unwarranted curiosity, he turned to face her."
msgstr "　<謂|い>われのない好奇心を向けられ、なんとなく拗ねながら草十郎は少女に体を向けた。"

#. Occurrence 6_2:1897:7515: scene=6_2
#: 6_2:1897
msgctxt "text_id=7515 | speaker=unknown"
msgid "  Although he was still mostly laying down, it was at least a more dignified position."
msgstr "　まだベッドの上に横たわってはいるものの、幾分ましな姿勢になっている。"

#. Occurrence 6_2:1931:7516: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0016; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1931
msgctxt "text_id=7516 | speaker=soujuurou"
msgid "\"So... any chance you'll tell me...?\""
msgstr "「それで、さっきの続きだけど」"

#. Occurrence 6_2:1937:7517: scene=6_2
#: 6_2:1937
msgctxt "text_id=7517 | speaker=unknown"
msgid "  Indeed, he needed to find out where he was and who she was before anything else."
msgstr "　そう、ここが何処で少女が何者なのか、まずそれを教えてもらわないと始まらない。"

#. Occurrence 6_2:1942:7518: scene=6_2
#: 6_2:1942
msgctxt "text_id=7518 | speaker=unknown"
msgid "  Actually, the more he thought about what happened at the amusement park, the more he got a sinking feeling in his stomach."
msgstr "　実際のところ、遊園地の事を思い出せば思い出すほど、そら恐ろしい想像しかできないのだが。"

#. Occurrence 6_2:1981:7519: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_2_0003; voice_prefix=A40; voice_category=2; scene=6_2
#: 6_2:1981
msgctxt "text_id=7519 | speaker=alice"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 6_2:1987:7520: scene=6_2
#: 6_2:1987
msgctxt "text_id=7520 | speaker=unknown"
msgid "  Perhaps finally getting through to her, she calmly moved her arm from behind her back, when..."
msgstr "　そんな草十郎の決意が伝わったのか、少女も冷徹に、背中に回していた手を動かそうとした時。"

#. Occurrence 6_2:2025:7521: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_2_0004; voice_prefix=A40; voice_category=2; scene=6_2
#: 6_2:2025
msgctxt "text_id=7521 | speaker=alice"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence 6_2:2031:7522: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0017; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:2031
msgctxt "text_id=7522 | speaker=soujuurou"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence 6_2:2036:7523: scene=6_2
#: 6_2:2036
msgctxt "text_id=7523 | speaker=unknown"
msgid "  Once again, they silently locked eyes."
msgstr "　またも無言で見つめ合ってしまう。"

#. Occurrence 6_2:2041:7524: scene=6_2
#: 6_2:2041
msgctxt "text_id=7524 | speaker=unknown"
msgid "  Thump, thump, thump."
msgstr "　バタバタバタ。"

#. Occurrence 6_2:2046:7525: scene=6_2
#: 6_2:2046
msgctxt "text_id=7525 | speaker=unknown"
msgid "  There was a startling sound of rapidly approaching footsteps."
msgstr "　外から響いてくる足音は、何者かが走って来るものだ。"

#. Occurrence 6_2:2052:7526: scene=6_2
#: 6_2:2052
msgctxt "text_id=7526 | speaker=unknown"
msgid "  They both had a pretty good idea of who it was."
msgstr "　それが誰のものか、少女はともかく草十郎にさえもありありと予測でき―――"

#. Occurrence 6_2:2161:7527: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_2_0000; voice_prefix=A10; voice_category=1; scene=6_2
#: 6_2:2161
msgctxt "text_id=7527 | speaker=aoko"
msgid "\"Alice! You promised!\""
msgstr "「有珠っ、約束！」"

#. Occurrence 6_2:2167:7528: scene=6_2
#: 6_2:2167
msgctxt "text_id=7528 | speaker=unknown"
msgid "  Just as expected."
msgstr "　この通り。"

#. Occurrence 6_2:2172:7529: scene=6_2
#: 6_2:2172
msgctxt "text_id=7529 | speaker=unknown"
msgid "  Aoko Aozaki burst through the door with a thunderous roar."
msgstr "　乱暴な<一喝|いっかつ>と共に入ってきたのは予想通り、蒼崎青子その人だった。"

#. Occurrence 6_3:57:7530: scene=6_3
#: 6_3:57
msgctxt "text_id=7530 | speaker=unknown"
msgid "  She entered wearing her school uniform, her long hair flowing behind her."
msgstr "　彼女は制服姿で、長い髪をなびかせて登場した。"

#. Occurrence 6_3:62:7531: scene=6_3
#: 6_3:62
msgctxt "text_id=7531 | speaker=unknown"
msgid "  Her breathing was heavy and her forehead was wrinkled by a scowl, granting her a demonic appearance."
msgstr "　乱れた呼吸と不機嫌そうにつり上がった瞳が、どことなく修羅めいている。"

#. Occurrence 6_3:83:7532: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0000; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:83
msgctxt "text_id=7532 | speaker=aoko"
msgid "\"Alice!\""
msgstr "「有珠っ！」"

#. Occurrence 6_3:104:7533: scene=6_3
#: 6_3:104
msgctxt "text_id=7533 | speaker=unknown"
msgid "  This girl named Alice scowled slightly in response."
msgstr "　青子にそう呼ばれた少女―――有珠はわずかに眉を<顰|ひそ>めた。"

#. Occurrence 6_3:109:7534: scene=6_3
#: 6_3:109
msgctxt "text_id=7534 | speaker=unknown"
msgid "  She may have even let a sigh of disappointment slip out."
msgstr "　……はあ、とかため息をこぼしたのかもしれない。"

#. Occurrence 6_3:138:7535: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0000; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:138
msgctxt "text_id=7535 | speaker=alice"
msgid "\"Aoko. Home early, I see.\""
msgstr "「早かったわね、青子」"

#. Occurrence 6_3:144:7536: scene=6_3
#: 6_3:144
msgctxt "text_id=7536 | speaker=unknown"
msgid "  Her calm voice was the polar opposite of Aoko's."
msgstr "　激している青子とは正反対の落ち着いた声。"

#. Occurrence 6_3:149:7537: scene=6_3
#: 6_3:149
msgctxt "text_id=7537 | speaker=unknown"
msgid "  Needless to say, her voice dripped with a brazen coldness."
msgstr "　どこか白々しいのは言うまでもない。"

#. Occurrence 6_3:203:7538: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0001; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:203
msgctxt "text_id=7538 | speaker=aoko"
msgid "\"That's because I know you all too well."
msgstr "「そりゃあ、アンタの性格は知り抜いてるからね。"

#. Occurrence 6_3:209:7539: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0002; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:209
msgctxt "text_id=7539 | speaker=aoko"
msgid "  Over the past two years, I've come to expect how quickly you jump to conclusions. You might act mild-mannered, but as soon as things don't go your way, the veil drops.\""
msgstr "　こういう時の短絡思考はこの二年で経験済みよ。お行儀がいいようで、面倒になったらあっさり投げ捨てるのがアンタでしょ」"

#. Occurrence 6_3:254:7540: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0001; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:254
msgctxt "text_id=7540 | speaker=alice"
msgid "\"Oh dear, you make it sound so scandalous.\""
msgstr "「いやね、人聞きの悪い」"

#. Occurrence 6_3:274:7541: scene=6_3
#: 6_3:274
msgctxt "text_id=7541 | speaker=unknown"
msgid "  Effortlessly, she brushed aside Aoko's jab."
msgstr "　青子の指摘を軽く受け流す有珠。"

#. Occurrence 6_3:279:7542: scene=6_3
#: 6_3:279
msgctxt "text_id=7542 | speaker=unknown"
msgid "  In doing so, Soujyuro had the distinct impression that she no longer even realized he was in the room."
msgstr "　もう草十郎なんて目に入っていない、と言わんばかりの態度だった。"

#. Occurrence 6_3:326:7543: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0003; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:326
msgctxt "text_id=7543 | speaker=aoko"
msgid "\"Ha! Let the record show that I've lost count of how many times you've gone back on your word."
msgstr "「はん。それで今日まで何度<煮|に>え湯を飲まされたコトか。"

#. Occurrence 6_3:338:7544: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0004; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:338
msgctxt "text_id=7544 | speaker=aoko"
msgid "  I'm tired of hearing the same old story after the fact: 'I know I said I would leave it to you, but after careful consideration I decided to take care of it myself.'"
msgstr "　青子に<譲|ゆず>るといったけど、よく考えると面倒だから私の方で処理しておいたわ―――なんて事<後承|いいわけ>諾、もう聞き飽きたっつーの。"

#. Occurrence 6_3:365:7545: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0005; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:365
msgctxt "text_id=7545 | speaker=aoko"
msgid "  I may have come to terms with your short fuse, but the least you can do in return is to trust your partner to set things right, no?\""
msgstr "　短気なのはそっちの自由だけど、それなら後の始末は相方に任せるのが最低限の筋ってもんじゃないの？」"

#. Occurrence 6_3:394:7546: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0002; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:394
msgctxt "text_id=7546 | speaker=alice"
msgid "\"You're right. We wouldn't be partners otherwise."
msgstr "「そうね。そうでなければ協闘している意味がないわ。"

#. Occurrence 6_3:400:7547: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0003; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:400
msgctxt "text_id=7547 | speaker=alice"
msgid "  Though... you're hardly one to talk, after unilaterally deciding our plan from here on out.\""
msgstr "　……まあ。今後の方針を勝手に決めた人の台詞じゃないとは思うけど」"

#. Occurrence 6_3:435:7548: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0006; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:435
msgctxt "text_id=7548 | speaker=aoko"
msgid "\"We've been over this already."
msgstr "「それもきっちり片をつけたでしょう。"

#. Occurrence 6_3:441:7549: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0007; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:441
msgctxt "text_id=7549 | speaker=aoko"
msgid "  We won, okay! Besides, who was the one who said we should let him live if he escaped? Yet again you've gone back on your word, Alice."
msgstr "　いい、勝ったのは<私|・><た|・><ち|・>よ。逃げ切れば見逃してあげるって言ったのは誰？　言動には責任を持ちなさい有珠。"

#. Occurrence 6_3:447:7550: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0008; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:447
msgctxt "text_id=7550 | speaker=aoko"
msgid "  Oh, don't tell me. Next you'll be saying *that's* the reason you can't let sleeping dogs lie!\""
msgstr "　それともなに。もしかして、一番気に食わないのはそのあたりの理由なワケ？」"

#. Occurrence 6_3:483:7551: scene=6_3
#: 6_3:483
msgctxt "text_id=7551 | speaker=unknown"
msgid "  Alice frowned slightly and fell silent."
msgstr "　む、と考えこむ有珠。"

#. Occurrence 6_3:488:7552: scene=6_3
#: 6_3:488
msgctxt "text_id=7552 | speaker=unknown"
msgid "  Her housemate seemed to have struck a nerve that Alice herself did not know was there."
msgstr "　青子の詰問は、有珠自身気付いていなかったところを突いたらしい。"

#. Occurrence 6_3:531:7553: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0009; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:531
msgctxt "text_id=7553 | speaker=aoko"
msgid "\"Anyway..."
msgstr "「とにかく。"

#. Occurrence 6_3:537:7554: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0010; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:537
msgctxt "text_id=7554 | speaker=aoko"
msgid "  We agreed to decide what to do with him when he wakes up, after hearing him out, right?"
msgstr "　コイツの扱いは、ちゃんと目が覚めて、本人の意志でどうするか決めるまで保留ってコトで合意したでしょ。"

#. Occurrence 6_3:543:7555: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0011; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:543
msgctxt "text_id=7555 | speaker=aoko"
msgid "  So stop trying to flip the script every time my back's turned.\""
msgstr "　人の留守中に出し抜くのはやめてよね」"

#. Occurrence 6_3:584:7556: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0004; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:584
msgctxt "text_id=7556 | speaker=alice"
msgid "\"...Speaking of which, aren't you supposed to be at school?"
msgstr "「……それ。青子、学校はどうしたの。"

#. Occurrence 6_3:584:7557: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0004; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:584
msgctxt "text_id=7557 | speaker=alice"
msgid "  It's noon already.\""
msgstr "　まだ正午になったばかりなのに」"

#. Occurrence 6_3:627:7558: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0012; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:627
msgctxt "text_id=7558 | speaker=aoko"
msgid "\"I remembered you only had your school's end-of-term ceremony today, so I told them I had to leave early for personal reasons. This is so warped. I have finals coming up, for goodness' sake.\""
msgstr "「有珠の<学|と><校|こ>が今日で<終業式|おわり>って思い出して、家庭の事情って事で早退したのよ。期末試験前だってのに、ほんと、なにやってんだか」"

#. Occurrence 6_3:633:7559: scene=6_3
#: 6_3:633
msgctxt "text_id=7559 | speaker=unknown"
msgid "  Aoko grumbled, more to herself than anyone else in the room."
msgstr "　誰かに同意を求めるのではなく、自分自身に言い聞かせるように青子は言う。"

#. Occurrence 6_3:676:7560: scene=6_3
#: 6_3:676
msgctxt "text_id=7560 | speaker=unknown"
msgid "  Then, she locked eyes with Alice."
msgstr "　そうして青子と有珠は見つめ合った。"

#. Occurrence 6_3:681:7561: scene=6_3
#: 6_3:681
msgctxt "text_id=7561 | speaker=unknown"
msgid "  Or more accurately, they glared daggers at each other."
msgstr "　いや、正しくは睨み合っている。"

#. Occurrence 6_3:709:7562: scene=6_3
#: 6_3:709
msgctxt "text_id=7562 | speaker=unknown"
msgid "  The room had become tense once again, and it felt like a fight could break out at any moment. With no way to escape, Soujyuro had no choice but to sit and watch."
msgstr "　今まさにとっくみ合いの喧嘩が始まりそうな緊迫感だが、<第三者|そうじゅうろう>としてはなす術なく眺めているしかない。"

#. Occurrence 6_3:755:7563: scene=6_3
#: 6_3:755
msgctxt "text_id=7563 | speaker=unknown"
msgid "  But then..."
msgstr "　……もっとも。"

#. Occurrence 6_3:760:7564: scene=6_3
#: 6_3:760
msgctxt "text_id=7564 | speaker=unknown"
msgid "  The electric silence that seemed like it would last forever suddenly broke about a minute later."
msgstr "　しばらく続くと思われた沈黙は、一分ほどであっさりと終わってしまった。"

#. Occurrence 6_3:765:7565: scene=6_3
#: 6_3:765
msgctxt "text_id=7565 | speaker=unknown"
msgid "  Apparently this sort of clash was an everyday occurrence."
msgstr "　この程度のぶつかり合いは日常茶飯事らしい。"

#. Occurrence 6_3:808:7566: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0005; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:808
msgctxt "text_id=7566 | speaker=alice"
msgid "\"...I'll be in the drawing room."
msgstr "「……わたしは居間に行っているから。"

#. Occurrence 6_3:814:7567: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0006; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:814
msgctxt "text_id=7567 | speaker=alice"
msgid "  Explain the circumstances to him.\""
msgstr "　彼に事情を説明してあげて」"

#. Occurrence 6_3:841:7568: scene=6_3
#: 6_3:841
msgctxt "text_id=7568 | speaker=unknown"
msgid "  Alice stood up from the chair and made for the door."
msgstr "　有珠は椅子から立ち上がり、扉へと歩きだす。"

#. Occurrence 6_3:861:7569: scene=6_3
#: 6_3:861
msgctxt "text_id=7569 | speaker=unknown"
msgid "  Watching her go, Soujyuro cocked his head."
msgstr "　その背中を見て草十郎は首を<傾|かし>げてしまった。"

#. Occurrence 6_3:866:7570: scene=6_3
#: 6_3:866
msgctxt "text_id=7570 | speaker=unknown"
msgid "  In her hand was what could only be described as..."
msgstr "　有珠の手には何か、どう控えめに表現しても、"

#. Occurrence 6_3:886:7571: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_3_0000; voice_prefix=A30; voice_category=3; scene=6_3
#: 6_3:886
msgctxt "text_id=7571 | speaker=soujuurou"
msgid "(...A fruit knife?)"
msgstr "『……果物、ナイフ……？』"

#. Occurrence 6_3:891:7572: scene=6_3
#: 6_3:891
msgctxt "text_id=7572 | speaker=unknown"
msgid "  He had no other words to describe the tool she was clutching."
msgstr "　としか言い表せない<得物|えもの>が握られていたからだ。"

#. Occurrence 6_3:936:7573: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0013; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:936
msgctxt "text_id=7573 | speaker=aoko"
msgid "\"Alice. I hate to ask, but what's in your hand?\""
msgstr "「有珠。あえて聞くけど、その手に持ってるの、なに？」"

#. Occurrence 6_3:941:7574: scene=6_3
#: 6_3:941
msgctxt "text_id=7574 | speaker=unknown"
msgid "  Aoko asked Alice as she walked past."
msgstr "　横を通り過ぎる有珠に問いかける青子。"

#. Occurrence 6_3:979:7575: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0007; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:979
msgctxt "text_id=7575 | speaker=alice"
msgid "\"A dagger, what else?\""
msgstr "「短剣ね、どう見ても」"

#. Occurrence 6_3:1009:7576: scene=6_3
#: 6_3:1009
msgctxt "text_id=7576 | speaker=unknown"
msgid "  Alice answered expressionlessly, before briskly walking out of the room."
msgstr "　有珠は無表情で返答し、スタスタと部屋から立ち去った。"

#. Occurrence 6_3:1044:7577: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_3_0001; voice_prefix=A30; voice_category=3; scene=6_3
#: 6_3:1044
msgctxt "text_id=7577 | speaker=soujuurou"
msgid "\"...\""
msgstr "「……………………」"

#. Occurrence 6_3:1049:7578: scene=6_3
#: 6_3:1049
msgctxt "text_id=7578 | speaker=unknown"
msgid "  Soujyuro thought it best to not think too deeply about the scene he had just witnessed."
msgstr "　よし。今の会話に関しては深く考えないようにしよう、と自己防衛する草十郎なのだった。"

#. Occurrence 6_4:69:7579: scene=6_4
#: 6_4:69
msgctxt "text_id=7579 | speaker=unknown"
msgid "  At any rate, the girl in black had withdrawn, and along with her the feeling of tension."
msgstr "　ともあれ、緊張感の大本であった黒衣の少女は立ち去った。"

#. Occurrence 6_4:74:7580: scene=6_4
#: 6_4:74
msgctxt "text_id=7580 | speaker=unknown"
msgid "  Leaving a bedridden Soujyuro alone with an Aoko still dressed for school."
msgstr "　部屋にはベッドに横になった草十郎と、制服姿の蒼崎青子がいる。"

#. Occurrence 6_4:79:7581: scene=6_4
#: 6_4:79
msgctxt "text_id=7581 | speaker=unknown"
msgid "  From Soujyuro's perspective, this was a perfect chance to get answers to his ever growing list of questions."
msgstr "　草十郎からすれば、たまりにたまった疑問を解決するには絶好の機会だ。"

#. Occurrence 6_4:111:7582: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0000; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:111
msgctxt "text_id=7582 | speaker=soujuurou"
msgid "\"My head's spinning, Aozaki.\""
msgstr "「ワケの分からない事だらけだ、蒼崎」"

#. Occurrence 6_4:141:7583: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0000; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:141
msgctxt "text_id=7583 | speaker=aoko"
msgid "\"I bet. I'll explain everything in order, so just shut up and listen.\""
msgstr "「でしょうね。順序だてて説明してあげるから、ちょっと黙ってて」"

#. Occurrence 6_4:191:7584: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0001; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:191
msgctxt "text_id=7584 | speaker=aoko"
msgid "\"I see the facial paralysis is gone, and your breathing has stabilized. It looks like you're through the worst of it.\""
msgstr "「顔の麻痺も取れてるし、呼吸も再開、と……これならもう安心かな」"

#. Occurrence 6_4:211:7585: scene=6_4
#: 6_4:211
msgctxt "text_id=7585 | speaker=unknown"
msgid "  She nodded, satisfied, as she took a seat."
msgstr "　青子はよし、と頷いて椅子に腰を下ろした。"

#. Occurrence 6_4:238:7586: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0002; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:238
msgctxt "text_id=7586 | speaker=aoko"
msgid "\"How do you feel?\""
msgstr "「どう、調子は？」"

#. Occurrence 6_4:257:7587: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0001; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:257
msgctxt "text_id=7587 | speaker=soujuurou"
msgid "\"A bit...sluggish.\""
msgstr "「…………なんか、だるい」"

#. Occurrence 6_4:263:7588: scene=6_4
#: 6_4:263
msgctxt "text_id=7588 | speaker=unknown"
msgid "  He answered meekly, dropping his shoulders."
msgstr "　がっくりと肩を落として、草十郎は弱々しく返答する。"

#. Occurrence 6_4:268:7589: scene=6_4
#: 6_4:268
msgctxt "text_id=7589 | speaker=unknown"
msgid "  He opened and closed his left hand a few times, but moving his fingers felt slow and awkward. It was clear he was still in bad shape."
msgstr "　答えながらも左手を何度か握りしめたが、指の動きは緩慢で、ぎこちない。体がまだ不調であるのは明白だ。"

#. Occurrence 6_4:309:7590: scene=6_4
#: 6_4:309
msgctxt "text_id=7590 | speaker=unknown"
msgid "  Meanwhile, Aoko was blinking her eyes in wonder."
msgstr "　一方、青子は目をしばたたいていた。"

#. Occurrence 6_4:314:7591: scene=6_4
#: 6_4:314
msgctxt "text_id=7591 | speaker=unknown"
msgid "  Or was it admiration?"
msgstr "　驚き……というより、感心しているようだ。"

#. Occurrence 6_4:319:7592: scene=6_4
#: 6_4:319
msgctxt "text_id=7592 | speaker=unknown"
msgid "  Between Alice and Aoko, Soujyuro did not know which of the girls was the harder to read."
msgstr "　有珠といい青子といい、草十郎には彼女たちの表情を読み取るのは難しい。"

#. Occurrence 6_4:347:7593: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0003; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:347
msgctxt "text_id=7593 | speaker=aoko"
msgid "\"Well, you're bound to feel a bit sluggish."
msgstr "「ま、体が重いのは当然よ。"

#. Occurrence 6_4:354:7594: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0004; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:354
msgctxt "text_id=7594 | speaker=aoko"
msgid "Lying in bed for two days straight would make anyone feel weak."
msgstr "まる二日経ってるし、寝てるだけでも体は弱ってるだろうし。"

#. Occurrence 6_4:360:7595: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0005; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:360
msgctxt "text_id=7595 | speaker=aoko"
msgid "  But, I never thought you would be well enough to speak."
msgstr "　でも、もう話せるくらい回復してるとは思わなかった。"

#. Occurrence 6_4:360:7596: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0005; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:360
msgctxt "text_id=7596 | speaker=aoko"
msgid "  You're a lot tougher than you look.\""
msgstr "　アンタって見かけより頑丈にできてるのね」"

#. Occurrence 6_4:366:7597: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0002; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:366
msgctxt "text_id=7597 | speaker=soujuurou"
msgid "\"...Two days...?\""
msgstr "「？　……二日って？」"

#. Occurrence 6_4:394:7598: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0006; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:394
msgctxt "text_id=7598 | speaker=aoko"
msgid "\"It's been two days. Don't worry about the school, I submitted a notice of absence."
msgstr "「あれからそれだけ経ってるの。学校には欠席届だしといたから、その点は安心して。"

#. Occurrence 6_4:400:7599: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0007; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:400
msgctxt "text_id=7599 | speaker=aoko"
msgid "  In the meantime, Alice and I dispelled the Gandr curse and Dumpty poem.\""
msgstr "　ガンドの呪いもダンプティの<詩篇|のろい>も、私と有珠とで解呪しといたから」"

#. Occurrence 6_4:434:7600: scene=6_4
#: 6_4:434
msgctxt "text_id=7600 | speaker=unknown"
msgid "  Soujyuro nodded at the word \"curse\" as if recalling it suddenly."
msgstr "　呪いと聞いて、草十郎はああ、と頷いた。"

#. Occurrence 6_4:439:7601: scene=6_4
#: 6_4:439
msgctxt "text_id=7601 | speaker=unknown"
msgid "  It was all coming back to him now."
msgstr "　そういえば、そんな事もあったなぁ、と。"

#. Occurrence 6_4:481:7602: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0008; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:481
msgctxt "text_id=7602 | speaker=aoko"
msgid "\"What's wrong? You look troubled by something.\""
msgstr "「どうかした？　そんな遠い目しちゃって」"

#. Occurrence 6_4:496:7603: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0003; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:496
msgctxt "text_id=7603 | speaker=soujuurou"
msgid "\"I just forgot everything that really happened is all. Was I really asleep for two days? Getting cursed is pretty scary.\""
msgstr "「ああ、忘れてた。それで二日も寝こんでたのか。恐いもんだな、呪われるって事は」"

#. Occurrence 6_4:507:7604: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0009; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:507
msgctxt "text_id=7604 | speaker=aoko"
msgid "\"You're as cool as a cucumber, aren't you? It's as if two days on death's door hasn't changed you a bit. Do you realize you were one step away from becoming a vegetable for the rest of your life?\""
msgstr "「……ほんと緊張感ないわねアンタ。蝋のように眠ってたのが嘘みたいよ。下手すると一生あのまま、石膏もどきだったかもしれないのに」"

#. Occurrence 6_4:564:7605: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0004; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:564
msgctxt "text_id=7605 | speaker=soujuurou"
msgid "\"...Wait just a second. Was it really that bad?\""
msgstr "「……ちょっと待った。今、すごいコト言わなかったか？」"

#. Occurrence 6_4:577:7606: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0010; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:577
msgctxt "text_id=7606 | speaker=aoko"
msgid "\"It was, and I guess you're proof that ignorance is bliss after all."
msgstr "「言ったけど聞かぬが花よ。"

#. Occurrence 6_4:602:7607: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0011; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:602
msgctxt "text_id=7607 | speaker=aoko"
msgid "  Anyway, what's done is done. Be sure to thank Alice later. I couldn't have lifted the curses without her help.\""
msgstr "　ま、経緯はどうあれ、後で有珠にお礼を言っときなさい。私じゃ解呪できなかったんだから」"

#. Occurrence 6_4:616:7608: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0005; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:616
msgctxt "text_id=7608 | speaker=soujuurou"
msgid "\"...Sometimes bliss is overrated."
msgstr "「……ひどい花もあったもんだ。"

#. Occurrence 6_4:629:7609: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0006; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:629
msgctxt "text_id=7609 | speaker=soujuurou"
msgid "  Oh, and yeah, you said the name 'Alice.' Was that girl Alice?"
msgstr "　あ、けど、有珠っていうのはさっきの<娘|こ>か？"

#. Occurrence 6_4:629:7610: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0006; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:629
msgctxt "text_id=7610 | speaker=soujuurou"
msgid "  Was she the one who, you know, tried to kill us at the amusement park?\""
msgstr "　遊園地で、その……俺たちを殺そうとした？」"

#. Occurrence 6_4:648:7611: scene=6_4
#: 6_4:648
msgctxt "text_id=7611 | speaker=unknown"
msgid "  Aoko replied that it was."
msgstr "　それにまあね、と答える青子。"

#. Occurrence 6_4:669:7612: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0007; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:669
msgctxt "text_id=7612 | speaker=soujuurou"
msgid "\"She was sitting by my side for ages. Is this her room or something?\""
msgstr "「彼女、ずっとそこに座ってたけど。……ここは彼女の部屋なのか？」"

#. Occurrence 6_4:688:7613: scene=6_4
#: 6_4:688
msgctxt "text_id=7613 | speaker=unknown"
msgid "  Soujyuro scanned the room again."
msgstr "　草十郎は改めて部屋を見渡す。"

#. Occurrence 6_4:693:7614: scene=6_4
#: 6_4:693
msgctxt "text_id=7614 | speaker=unknown"
msgid "  He was not accustomed to sleeping on anything other than a futon, and the room looked especially foreign to him."
msgstr "　自分が眠っていたベッド共々、彼の見聞にはない洋風の部屋。"

#. Occurrence 6_4:726:7615: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0012; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:726
msgctxt "text_id=7615 | speaker=aoko"
msgid "\"No, this is just a guest room. It hasn't been used in forever, hence the dust over everything."
msgstr "「ううん、ここはただの客室。長いこと使ってなかったから埃だらけでしょ。"

#. Occurrence 6_4:732:7616: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0013; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:732
msgctxt "text_id=7616 | speaker=aoko"
msgid "  More importantly, what did you and Alice talk about?\""
msgstr "　それより有珠と何か話したの、あなた？」"

#. Occurrence 6_4:749:7617: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0008; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:749
msgctxt "text_id=7617 | speaker=soujuurou"
msgid "\"...Well..."
msgstr "「―――。"

#. Occurrence 6_4:756:7618: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0009; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:756
msgctxt "text_id=7618 | speaker=soujuurou"
msgid "We didn't really talk so much as...\""
msgstr "いや、あれを会話と言うのは、ちょっと」"

#. Occurrence 6_4:761:7619: scene=6_4
#: 6_4:761
msgctxt "text_id=7619 | speaker=unknown"
msgid "  He brought his hand to his mouth, and recalled the few words they exchanged."
msgstr "　草十郎は口に手を当てて、さっき交わした言葉を思い返す。"

#. Occurrence 6_4:790:7620: scene=6_4
#: 6_4:790
msgctxt "text_id=7620 | speaker=unknown"
msgid "  As Soujyuro said, calling it a conversation would be a gross overstatement."
msgstr "　……彼の言う通り、アレを会話と言うのはおこがましい。"

#. Occurrence 6_4:795:7621: scene=6_4
#: 6_4:795
msgctxt "text_id=7621 | speaker=unknown"
msgid "  And yet, thinking back on it, it seemed like they had talked for hours, which brought an uncomfortable smile to his face."
msgstr "　なのに、思い返してみると何時間も話していた気がして、草十郎はかすかに苦笑してしまった。"

#. Occurrence 6_4:828:7622: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0010; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:828
msgctxt "text_id=7622 | speaker=soujuurou"
msgid "\"But it's fine, I'm no longer worried."
msgstr "「とはいえ、緊張は解けたと思うよ。"

#. Occurrence 6_4:834:7623: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0011; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:834
msgctxt "text_id=7623 | speaker=soujuurou"
msgid "  Although, it would have been nice if you had come a little later, Aozaki.\""
msgstr "　蒼崎がやってくるのがもう少し遅かったら良かったのに」"

#. Occurrence 6_4:869:7624: scene=6_4
#: 6_4:869
msgctxt "text_id=7624 | speaker=unknown"
msgid "  Aoko narrowed her eyes at his innocent slip of the tongue."
msgstr "　本心からの一言に、青子はムッと瞳を細める。"

#. Occurrence 6_4:874:7625: scene=6_4
#: 6_4:874
msgctxt "text_id=7625 | speaker=unknown"
msgid "  She knew Soujyuro did not mean to treat her like a nuisance, but nevertheless, she found it hard to take the full brunt of the words said to her face."
msgstr "　草十郎が<青子|じぶん>を邪魔者扱いしていないのは分かるが、面と向かって言われるのは面白くない。"

#. Occurrence 6_4:886:7626: scene=6_4
#: 6_4:886
msgctxt "text_id=7626 | speaker=unknown"
msgid "  Even worse, she sensed she was getting used to his manner of speaking."
msgstr "　さらに面白くないのは、彼のそんな言動に慣れはじめている自分がいる事だ。"

#. Occurrence 6_4:928:7627: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0014; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:928
msgctxt "text_id=7627 | speaker=aoko"
msgid "\"So that's why she... You really do have a knack for surviving by the skin of your teeth, don't you?\""
msgstr "「でも、だから、なのかもね。相変わらず首の皮一枚の人生送ってるわ、貴方って」"

#. Occurrence 6_4:933:7628: scene=6_4
#: 6_4:933
msgctxt "text_id=7628 | speaker=unknown"
msgid "  He tilted his head, clearly confused."
msgstr "　それにはい？　と首を傾げる草十郎。"

#. Occurrence 6_4:960:7629: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0015; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:960
msgctxt "text_id=7629 | speaker=aoko"
msgid "\"I'm saying you did something to please Alice."
msgstr "「だから、アンタはよっぽど有珠好みの対応をしたのよ。"

#. Occurrence 6_4:960:7630: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0015; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:960
msgctxt "text_id=7630 | speaker=aoko"
msgid "  That's the reason you're still alive.\""
msgstr "　まだ生きてるって、そういうコト」"

#. Occurrence 6_4:983:7631: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0012; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:983
msgctxt "text_id=7631 | speaker=soujuurou"
msgid "\"???\""
msgstr "「？？？」"

#. Occurrence 6_4:988:7632: scene=6_4
#: 6_4:988
msgctxt "text_id=7632 | speaker=unknown"
msgid "  No matter how hard he tried, he could not grasp what she was getting at."
msgstr "　青子の言いたい事はどうにも草十郎には掴めなかった。"

#. Occurrence 6_4:993:7633: scene=6_4
#: 6_4:993
msgctxt "text_id=7633 | speaker=unknown"
msgid "  He decided to change the subject to something else."
msgstr "　掴めなかったので、その事はあえて訊かない事にする。"

#. Occurrence 6_4:1037:7634: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0013; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1037
msgctxt "text_id=7634 | speaker=soujuurou"
msgid "\"...By the way, where are we, exactly?"
msgstr "「……ところで、ここは何処なんだ？"

#. Occurrence 6_4:1037:7635: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0013; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1037
msgctxt "text_id=7635 | speaker=soujuurou"
msgid "  I asked the other girl, but she wouldn't tell me. You can tell me, right, Aozaki?\""
msgstr "　あの<娘|こ>に訊いても教えてくれなかったけど、蒼崎なら教えてくれるだろ」"

#. Occurrence 6_4:1065:7636: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0016; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1065
msgctxt "text_id=7636 | speaker=aoko"
msgid "\"You are inside Misaki's infamous haunted house. But you can call it the Kuonji Estate."
msgstr "「ここは三咲町の幽霊屋敷よ。正確には<久遠寺|くおんじ>邸と言えばいいかしらね。"

#. Occurrence 6_4:1087:7637: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0017; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1087
msgctxt "text_id=7637 | speaker=aoko"
msgid "  And that girl...that's Alice Kuonji. This is her mansion, which happens to be the place I currently call home. After the other night, I, uh, brought you here. You don't remember, do you?\""
msgstr "　さっきの娘……久遠寺有珠の持ち家で、私が住んでるところでもある。あの後、貴方をここまで持ってきたんだけど、<覚|おぼ>えてないでしょ？」"

#. Occurrence 6_4:1093:7638: scene=6_4
#: 6_4:1093
msgctxt "text_id=7638 | speaker=unknown"
msgid "  Something about the way she said that made him feel uncomfortable."
msgstr "　持ってきた、という単語にいまいち違和感を覚える草十郎だった。"

#. Occurrence 6_4:1114:7639: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0014; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1114
msgctxt "text_id=7639 | speaker=soujuurou"
msgid "\"Kuonji... I've heard that name before. Hey, I know, some old guys in the shopping district were talking about it. The Kuonji's are a rich and famous family, or something.\""
msgstr "「久遠寺って言う名前は聞きおぼえがあるような……そうだ、よく商店街でおじさんたちが話してた。なんでもえらいお金持ちだとか、なんとか」"

#. Occurrence 6_4:1120:7640: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0018; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1120
msgctxt "text_id=7640 | speaker=aoko"
msgid "\"Don't you dare say that in front of Alice."
msgstr "「それ、有珠の前ではご<法度|はっと>よ。"

#. Occurrence 6_4:1120:7641: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0018; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1120
msgctxt "text_id=7641 | speaker=aoko"
msgid "  If you want to live here in peace, that is.\""
msgstr "　穏便にここで暮らしたいならね」"

#. Occurrence 6_4:1145:7642: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0015; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1145
msgctxt "text_id=7642 | speaker=soujuurou"
msgid "\"...?\""
msgstr "「……？」"

#. Occurrence 6_4:1150:7643: scene=6_4
#: 6_4:1150
msgctxt "text_id=7643 | speaker=unknown"
msgid "  Confused yet again, Soujyuro tilted his head for what seemed like the hundredth time that day."
msgstr "　本日何度目かになる首傾げだった。"

#. Occurrence 6_4:1155:7644: scene=6_4
#: 6_4:1155
msgctxt "text_id=7644 | speaker=unknown"
msgid "  And once again, he had heard something to make him feel uneasy."
msgstr "　今、またも引っ掛かる単語が出てきた気がする。"

#. Occurrence 6_4:1190:7645: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0016; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1190
msgctxt "text_id=7645 | speaker=soujuurou"
msgid "\"Aozaki...? Did you just say...?\""
msgstr "「蒼崎。君、今なんて言った？」"

#. Occurrence 6_4:1211:7646: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0019; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1211
msgctxt "text_id=7646 | speaker=aoko"
msgid "\"Sizuki. I have very little patience for liars, idiots, and people that make me repeat myself."
msgstr "「静希君。私ね、あからさまな嘘を言う人と、同じ事を何度も言わせる人と、察しの悪い人には容赦しないから。"

#. Occurrence 6_4:1217:7647: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0020; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1217
msgctxt "text_id=7647 | speaker=aoko"
msgid "  Do your best to remember that if you want to enjoy your stay here.\""
msgstr "　そのあたり覚えておいてね、ここで平穏に暮らしたいなら」"

#. Occurrence 6_4:1223:7648: scene=6_4
#: 6_4:1223
msgctxt "text_id=7648 | speaker=unknown"
msgid "  With her best smile, Aoko made her threatening proclamation."
msgstr "　極上の笑顔で、さわやかに不穏な宣言をする青子。"

#. Occurrence 6_4:1228:7649: scene=6_4
#: 6_4:1228
msgctxt "text_id=7649 | speaker=unknown"
msgid "  Needless to say, it caught Soujyuro completely off guard."
msgstr "　もちろん、草十郎にとっては寝耳に水の話である。"

#. Occurrence 6_4:1275:7650: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0017; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1275
msgctxt "text_id=7650 | speaker=soujuurou"
msgid "\"I must have misheard you, because I could have sworn you said something about me living here.\""
msgstr "「……気のせいならいいんだけど、君の言葉には、俺がここに住むような響きが感じられる」"

#. Occurrence 6_4:1302:7651: scene=6_4
#: 6_4:1302
msgctxt "text_id=7651 | speaker=unknown"
msgid "  He shot her an honest stare of disapproval."
msgstr "　草十郎は正直に、心底から嫌そうな顔で青子を見る。"

#. Occurrence 6_4:1307:7652: scene=6_4
#: 6_4:1307
msgctxt "text_id=7652 | speaker=unknown"
msgid "  It was the best resistance he could muster."
msgstr "　彼なりの精一杯の<反政府運動|レジスタンス>だ。"

#. Occurrence 6_4:1312:7653: scene=6_4
#: 6_4:1312
msgctxt "text_id=7653 | speaker=unknown"
msgid "  But it was not in the slightest effective against Aoko's overpowering ruthless glare."
msgstr "　が、そんな貧弱な運動は効かない、とばかりに青子は冷酷な視線を返すのだった。"

#. Occurrence 6_4:1348:7654: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0021; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1348
msgctxt "text_id=7654 | speaker=aoko"
msgid "\"The quicker you understand the position you're in, the better it'll be for you.\""
msgstr "「貴方、自分の立場を分かってる？」"

#. Occurrence 6_4:1354:7655: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0018; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1354
msgctxt "text_id=7655 | speaker=soujuurou"
msgid "\"You mean...\""
msgstr "「えーと、」"

#. Occurrence 6_4:1359:7656: scene=6_4
#: 6_4:1359
msgctxt "text_id=7656 | speaker=unknown"
msgid "  He considered her words carefully."
msgstr "　それが分かっていれば蒼崎が苦労しない、というのは分かるよ―――"

#. Occurrence 6_4:1364:7657: scene=6_4
#: 6_4:1364
msgctxt "text_id=7657 | speaker=unknown"
msgid "  He wanted to openly express his feelings on the matter, but instead he swallowed his words and shook his head."
msgstr "　なんて感想を喉もとで止めて、草十郎は首を横に振った。"

#. Occurrence 6_4:1405:7658: scene=6_4
#: 6_4:1405
msgctxt "text_id=7658 | speaker=unknown"
msgid "  Despite his typical inability to read people's emotions, he at least seemed to understand the gravity of the situation."
msgstr "　空気を読めない彼でも、今は自重すべきだと感じ取ったらしい。"

#. Occurrence 6_4:1410:7659: scene=6_4
#: 6_4:1410
msgctxt "text_id=7659 | speaker=unknown"
msgid "  It appeared that he had finally realized that it was his carefree mood that typically got on Aoko's nerves."
msgstr "　そんなのんびりした態度こそが青子の癪に障る事を、彼もそろそろ気付くべきだ。"

#. Occurrence 6_4:1453:7660: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0022; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1453
msgctxt "text_id=7660 | speaker=aoko"
msgid "\"...Ugh. My mistake. I forgot there's no use beating around the bush with you."
msgstr "「……はあ。そうだった。アンタに回りくどいこと言っても無駄だったのよね。"

#. Occurrence 6_4:1460:7661: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0023; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1460
msgctxt "text_id=7661 | speaker=aoko"
msgid "Fine, I wanted to give you time to think, but we're way past that, so I'll just come right out and say it.\""
msgstr "いいわ、考える時間ぐらいあげたかったけど、時間もないし、はっきりと言ってあげる」"

#. Occurrence 6_4:1492:7662: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0024; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1492
msgctxt "text_id=7662 | speaker=aoko"
msgid "\"Listen to me, Sizuki."
msgstr "「いい、静希君？"

#. Occurrence 6_4:1509:7663: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0025; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1509
msgctxt "text_id=7663 | speaker=aoko"
msgid "  As of now, you're being placed under our supervision. You will be living here, together with us, for the time being."
msgstr "　このたび、貴方は私たちの監視下に置かれることになりました。しばらくはここで一緒に暮らしてもらいます。"

#. Occurrence 6_4:1515:7664: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0026; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1515
msgctxt "text_id=7664 | speaker=aoko"
msgid "  Naturally, I reserve the right to decide whether you live or die.\""
msgstr "　もちろん、生殺与奪の権利はこちらにあるという条件で」"

#. Occurrence 6_4:1565:7665: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0019; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1565
msgctxt "text_id=7665 | speaker=soujuurou"
msgid "\"Wha...?\""
msgstr "「なっ……！」"

#. Occurrence 6_4:1571:7666: scene=6_4
#: 6_4:1571
msgctxt "text_id=7666 | speaker=unknown"
msgid "  The blatant tyranny in her voice caused him to sputter."
msgstr "　あまりの<横暴|おうぼう>さに吹き出しかける草十郎。"

#. Occurrence 6_4:1607:7667: scene=6_4
#: 6_4:1607
msgctxt "text_id=7667 | speaker=unknown"
msgid "  He wished that she would stop smiling in an attempt to make it seem any less outrageous."
msgstr "　笑顔で言えば傍若無人が通ると思うのもやめてほしい。"

#. Occurrence 6_4:1644:7668: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0020; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1644
msgctxt "text_id=7668 | speaker=soujuurou"
msgid "\"L-Live together? ...With you?!\""
msgstr "「い、一緒に住むって蒼崎とか！？」"

#. Occurrence 6_4:1650:7669: scene=6_4
#: 6_4:1650
msgctxt "text_id=7669 | speaker=unknown"
msgid "  It was not the faint expectation of living under the same roof with Aoko that had him flustered."
msgstr "　あわてているのは青子と一つ屋根の下で暮らす事に淡い期待を持ってのこと―――"

#. Occurrence 6_4:1655:7670: scene=6_4
#: 6_4:1655
msgctxt "text_id=7670 | speaker=unknown"
msgid "  Rather..."
msgstr "　では当然なく、"

#. Occurrence 6_4:1675:7671: scene=6_4
#: 6_4:1675
msgctxt "text_id=7671 | speaker=unknown"
msgid "  He was genuinely concerned about his own safety."
msgstr "　純粋に、己が身を案じてだ。"

#. Occurrence 6_4:1695:7672: scene=6_4
#: 6_4:1695
msgctxt "text_id=7672 | speaker=unknown"
msgid "  Regardless of how good-natured he was, it seemed he finally had come to grips with the fact that he just escaped death."
msgstr "　いかに彼がお人好しでも、一度殺されかけた事実はきちんと受けとめていたらしい。"

#. Occurrence 6_4:1729:7673: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0021; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1729
msgctxt "text_id=7673 | speaker=soujuurou"
msgid "\"You can't be serious!"
msgstr "「とんでもない！"

#. Occurrence 6_4:1729:7674: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0021; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1729
msgctxt "text_id=7674 | speaker=soujuurou"
msgid "  That's like seeking warmth next to a bear before it goes into hibernation!\""
msgstr "　冬眠前の熊と、一緒に<暖|だん>を取るようなもんだ！」"

#. Occurrence 6_4:1747:7675: scene=6_4
#: 6_4:1747
msgctxt "text_id=7675 | speaker=unknown"
msgid "  Aoko agreed, as blunt a comparison as it was."
msgstr "　失礼な感想に、青子はそうね、と平然と答える。"

#. Occurrence 6_4:1774:7676: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0027; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1774
msgctxt "text_id=7676 | speaker=aoko"
msgid "\"Once in a while you have some pretty accurate metaphors, you know?"
msgstr "「たまには的確な<比|ひ><喩|ゆ>をするじゃない。"

#. Occurrence 6_4:1780:7677: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0028; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1780
msgctxt "text_id=7677 | speaker=aoko"
msgid "  But I'm glad you figured it out. Make a wrong move or break a rule and I'll end you, for real this time."
msgstr "　貴方の言う通り、下手なコトをしたり決まりを破ったりしたら今度こそ息の根止めるからね。"

#. Occurrence 6_4:1793:7678: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0029; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1793
msgctxt "text_id=7678 | speaker=aoko"
msgid "  Plus, it's just me and Alice you'll be living with."
msgstr "　それと、ここに住んでるのは私と有珠のふたりだけよ。"

#. Occurrence 6_4:1799:7679: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0030; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1799
msgctxt "text_id=7679 | speaker=aoko"
msgid "  She has way less common sense than I do, so if you're not careful, you'll wind up dead by her hands, too.\""
msgstr "　あの子、私なんかより数倍常識ないから。気をつけないと死んじゃうぞ」"

#. Occurrence 6_4:1838:7680: scene=6_4
#: 6_4:1838
msgctxt "text_id=7680 | speaker=unknown"
msgid "  Aoko was one hundred percent serious."
msgstr "　青子は１００パーセント本気である。"

#. Occurrence 6_4:1843:7681: scene=6_4
#: 6_4:1843
msgctxt "text_id=7681 | speaker=unknown"
msgid "  It was her sincerity that made it all the more believable."
msgstr "　<嘘|うそ><偽|いつわ>りない発言こそ誠意と言わんばかりだ。"

#. Occurrence 6_4:1877:7682: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0022; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1877
msgctxt "text_id=7682 | speaker=soujuurou"
msgid "\"No! No no no!\""
msgstr "「いや、いやいやいや！」"

#. Occurrence 6_4:1882:7683: scene=6_4
#: 6_4:1882
msgctxt "text_id=7683 | speaker=unknown"
msgid "  Obviously, there was no way the victim, Soujyuro, could accept these terms."
msgstr "　無論、そんなんで被害者である草十郎が納得できる筈もない。"

#. Occurrence 6_4:1904:7684: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0023; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1904
msgctxt "text_id=7684 | speaker=soujuurou"
msgid "\"Wait a minute. You're not making any sense, Aozaki!"
msgstr "「待ってくれ、俺にはちっとも蒼崎が分からない！"

#. Occurrence 6_4:1911:7685: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0024_0; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1911
msgctxt "text_id=7685 | speaker=soujuurou"
msgid "  You say I'm under your supervision, but why is that necessary? If you think about it, I haven't even done anything wrong, so there's really no point in keeping an eye on me!  "
msgstr "　監視するって言うけど、なんでそんな話になってるんだ？　考えられる範囲、悪いコトとかしてないし、そもそも俺を見張っても得なコトなんていっこもないし！　"

#. Occurrence 6_4:1920:7686: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0024_1; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1920
msgctxt "text_id=7686 | speaker=soujuurou"
msgid "This has to be a misunderstanding!\""
msgstr "蒼崎は色々まちがってる！」"

#. Occurrence 6_4:1963:7687: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0025; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1963
msgctxt "text_id=7687 | speaker=soujuurou"
msgid "\"...Is it... Are all mages like you, Aozaki?\""
msgstr "「―――む。いや、それとも魔術師っていうのは、みんな蒼崎みたいなのか？」"

#. Occurrence 6_4:1989:7688: scene=6_4
#: 6_4:1989
msgctxt "text_id=7688 | speaker=unknown"
msgid "  Arrogant and selfish...were the words that the harmless boy's gaze seemed to imply."
msgstr "　ぼうじゃくとかぶじんなのか？　と心底困った視線を向けてくる人畜無害。"

#. Occurrence 6_4:1994:7689: scene=6_4
#: 6_4:1994
msgctxt "text_id=7689 | speaker=unknown"
msgid "  Aoko felt a headache coming on."
msgstr "　……青子からすれば頭痛のタネもいいところだ。"

#. Occurrence 6_4:2016:7690: scene=6_4
#: 6_4:2016
msgctxt "text_id=7690 | speaker=unknown"
msgid "  Due to his innate easygoing persona, Soujyuro had not thought to question that Aoko being a mage was out of the ordinary."
msgstr "　素直すぎるのも考えもので、この通り、草十郎は青子が魔術師であることを異常だと思っていないのである。"

#. Occurrence 6_4:2065:7691: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0031; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2065
msgctxt "text_id=7691 | speaker=aoko"
msgid "\"That's the problem! We need to keep an eye on you so you don't go around saying things like that and blow our cover, you dunce!\""
msgstr "「だ、か、らっ！　アンタが、そういう風に、誰はばかることなく私たちの事を言い触らさないかを見張ってんじゃない、この常識なしッ！」"

#. Occurrence 6_4:2071:7692: scene=6_4
#: 6_4:2071
msgctxt "text_id=7692 | speaker=unknown"
msgid "  Aoko flew out of her chair."
msgstr "　青子は勢いあまって椅子から立ち上がった。"

#. Occurrence 6_4:2076:7693: scene=6_4
#: 6_4:2076
msgctxt "text_id=7693 | speaker=unknown"
msgid "  She had been doing her best to keep her cool, but it seemed her well of patience had finally run dry."
msgstr "　先ほどから我慢してきた青子の堪忍袋の緒はすっぱりさっぱり、気分よく断ち切れたらしい。"

#. Occurrence 6_4:2081:7694: scene=6_4
#: 6_4:2081
msgctxt "text_id=7694 | speaker=unknown"
msgid "  Witnessing Aoko snap, Soujyuro clapped his hands together."
msgstr "　そんな青子を見て、ぽん、と草十郎は両手を合わせる。"

#. Occurrence 6_4:2116:7695: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0026; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2116
msgctxt "text_id=7695 | speaker=soujuurou"
msgid "\"Oh now I get it. The reason you tried to kill me was because you have to hide the fact that you're a mage."
msgstr "「そうか。蒼崎が俺を殺そうとしたのは、魔術師であることを隠さなくちゃいけないからだったっけ。"

#. Occurrence 6_4:2129:7696: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0027; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2129
msgctxt "text_id=7696 | speaker=soujuurou"
msgid "  Okay, if that's the case then I get it. You're monitoring me to protect your secret, and not taking my life is your way of throwing me a bone.\""
msgstr "　うん、それなら分かる。監視するのは蒼崎の秘密のコトで、俺の命云々はオマケみたいなものか」"

#. Occurrence 6_4:2149:7697: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0032; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2149
msgctxt "text_id=7697 | speaker=aoko"
msgid "\"...I mean, those aren't the words I would use, but sure."
msgstr "「…………。そりゃあ本質的に言えば、そうだけど。"

#. Occurrence 6_4:2149:7698: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0032; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2149
msgctxt "text_id=7698 | speaker=aoko"
msgid "  It sounds a bit harsh when you put it that way.\""
msgstr "　身もフタもないわね、その言い方」"

#. Occurrence 6_4:2180:7699: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0028; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2180
msgctxt "text_id=7699 | speaker=soujuurou"
msgid "\"But, isn't this all a little unrealistic?"
msgstr "「けど、それはあまり意味がないんじゃないか？"

#. Occurrence 6_4:2186:7700: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0029; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2186
msgctxt "text_id=7700 | speaker=soujuurou"
msgid "  I have school and work to go to. I can't stay locked up inside this house all day.\""
msgstr "　学校もあるし、バイトだってあるんだ。一日中、この家から出ないワケにはいかないんだぞ」"

#. Occurrence 6_4:2233:7701: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0033; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2233
msgctxt "text_id=7701 | speaker=aoko"
msgid "\"...\""
msgstr "「……………………」"

#. Occurrence 6_4:2238:7702: scene=6_4
#: 6_4:2238
msgctxt "text_id=7702 | speaker=unknown"
msgid "  In an instant, Soujyuro's objectivity had her stumped, leaving her at a loss for words."
msgstr "　自分を客観視できる草十郎に感心したのも一瞬、あまりの返答に絶句する青子だった。"

#. Occurrence 6_4:2243:7703: scene=6_4
#: 6_4:2243
msgctxt "text_id=7703 | speaker=unknown"
msgid "  He honestly had no idea what position he was in."
msgstr "　ほんとーに、この男は自分の立場というものが分かっていない。"

#. Occurrence 6_4:2248:7704: scene=6_4
#: 6_4:2248
msgctxt "text_id=7704 | speaker=unknown"
msgid "  To believe that he had any sort of freedom at this point was shocking, to say the least."
msgstr "　ここまでの話の流れで、そんな自由があると思っているあたり大物ではあるが。"

#. Occurrence 6_4:2275:7705: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0034; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2275
msgctxt "text_id=7705 | speaker=aoko"
msgid "\"...Just breathe, Aoko. If anything, this will speed things along.\""
msgstr "「……いや、落ち着け私。話が早くなってある意味助かるし」"

#. Occurrence 6_4:2281:7706: scene=6_4
#: 6_4:2281
msgctxt "text_id=7706 | speaker=unknown"
msgid "  Aoko somehow managed to compose herself."
msgstr "　なんとか体裁を整える青子。"

#. Occurrence 6_4:2286:7707: scene=6_4
#: 6_4:2286
msgctxt "text_id=7707 | speaker=unknown"
msgid "  As a matter of fact, she never had any intention of imprisoning him."
msgstr "　実のところ、青子も監獄じみた拘束をする気はない。"

#. Occurrence 6_4:2291:7708: scene=6_4
#: 6_4:2291
msgctxt "text_id=7708 | speaker=unknown"
msgid "  Stripping him of his freedom and incarcerating him would go against their agreement, anyway."
msgstr "　あらゆる自由を禁じ屋敷に閉じこめる、なんて方法では草十郎との約束に反してしまう。"

#. Occurrence 6_4:2296:7709: scene=6_4
#: 6_4:2296
msgctxt "text_id=7709 | speaker=unknown"
msgid "  Besides, if she was going to go that far it would be easier to just kill him."
msgstr "　第一、そこまでするなら亡き者にしたほうが早い。"

#. Occurrence 6_4:2301:7710: scene=6_4
#: 6_4:2301
msgctxt "text_id=7710 | speaker=unknown"
msgid "  To Aoko, letting him live meant showing a modicum of respect to Soujyuro's way of life."
msgstr "　青子にとって『生かす』という事は、静希草十郎という人間の生活を最低限尊重する事である。"

#. Occurrence 6_4:2338:7711: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0030; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2338
msgctxt "text_id=7711 | speaker=soujuurou"
msgid "\"You're not saying... W-Wait, don't tell me I can't even leave this room?!\""
msgstr "「あ。……も、もしかして、この部屋から出ちゃいけないのか、俺！？」"

#. Occurrence 6_4:2356:7712: scene=6_4
#: 6_4:2356
msgctxt "text_id=7712 | speaker=unknown"
msgid "  A light bulb went on in his head as he blurted out what he was thinking."
msgstr "　ピコーン、と音が鳴りかねない顔で、思いつきを口にする草十郎。"

#. Occurrence 6_4:2361:7713: scene=6_4
#: 6_4:2361
msgctxt "text_id=7713 | speaker=unknown"
msgid "  It appeared he had finally got the grim message."
msgstr "　悪い方向での想像にようやく行き着いてくれたらしい。"

#. Occurrence 6_4:2366:7714: scene=6_4
#: 6_4:2366
msgctxt "text_id=7714 | speaker=unknown"
msgid "  Aoko looked somewhat satisfied at his dismay."
msgstr "　そんな狼狽ぶりに、少しだけ<溜飲|りゅういん>をさげる青子だった。"

#. Occurrence 6_4:2411:7715: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0035; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2411
msgctxt "text_id=7715 | speaker=aoko"
msgid "\"Relax. Locking you up would actually be more trouble than it's worth."
msgstr "「大丈夫よ。監禁生活なんて面倒なコトだけはしないから。"

#. Occurrence 6_4:2417:7716: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0036; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2417
msgctxt "text_id=7716 | speaker=aoko"
msgid "  Your freedom was taken into consideration. To what degree you are free will be left to the discretion of Alice and her abilities, so you won't have to worry about that.\""
msgstr "　貴方の自由はそれなりに考慮してあります。そのあたりのさじ加減は有珠の手腕に任せてあるから、貴方は心配しなくていいわ」"

#. Occurrence 6_4:2423:7717: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0031; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2423
msgctxt "text_id=7717 | speaker=soujuurou"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 6_4:2428:7718: scene=6_4
#: 6_4:2428
msgctxt "text_id=7718 | speaker=unknown"
msgid "  A gloomy look fell over Soujyuro's face, as he found his concern growing by the second."
msgstr "　草十郎は無言で、それはよけいに心配なのでは、と顔を曇らせた。"

#. Occurrence 6_4:2455:7719: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0037; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2455
msgctxt "text_id=7719 | speaker=aoko"
msgid "\"All right, look. Sparing your life is based on the premise that you will live in this house under supervision, and that's only until a more permanent solution is found."
msgstr "「いい？　貴方の処遇は、この家に住むコトを前提にした監視で、それも解決策が見つかるまでの期間限定。"

#. Occurrence 6_4:2461:7720: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0038; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2461
msgctxt "text_id=7720 | speaker=aoko"
msgid "  It's a lot more amicable than just disposing of the witness, don't you think?"
msgstr "　何でもいいから目撃者を殺す、なんて事より、こっちの方がよっぽど穏便でしょ。"

#. Occurrence 6_4:2474:7721: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0039; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2474
msgctxt "text_id=7721 | speaker=aoko"
msgid "  ...At any rate, this is my way of keeping our promise, so no complaining. This cold war I'm waging with Alice is enough of a headache, already.\""
msgstr "　……だいたい、これは私と貴方との約束なんだから、いちいち文句言わないでよね。ただでさえ有珠との冷戦が続いてて頭痛いんだから」"

#. Occurrence 6_4:2479:7722: scene=6_4
#: 6_4:2479
msgctxt "text_id=7722 | speaker=unknown"
msgid "  She sighed as she stared Soujyuro down as he lay on the bed."
msgstr "　ため息まじりに言いつつ、青子はベッドの上の草十郎をキッと睨みつける。"

#. Occurrence 6_4:2523:7723: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0040; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2523
msgctxt "text_id=7723 | speaker=aoko"
msgid "\"But make no mistake."
msgstr "「けど勘違いはしないで。"

#. Occurrence 6_4:2529:7724: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0041; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2529
msgctxt "text_id=7724 | speaker=aoko"
msgid "  Your status here is the lowest of the low, even lower than a dog's. Since that night, I'm the one to decide whether you live or die, which means you belong to me now."
msgstr "　ここじゃアンタの地位は最下層のさらに下、番犬より下なんだから。アンタの生殺与奪はあの夜から私が握ってるんだから、アンタは私に所有されてるようなもんなの。"

#. Occurrence 6_4:2535:7725: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0042; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2535
msgctxt "text_id=7725 | speaker=aoko"
msgid "  Is that clear enough for you?\""
msgstr "　さ、これで自分の立場、<判|わか>った？」"

#. Occurrence 6_4:2605:7726: scene=6_4
#: 6_4:2605
msgctxt "text_id=7726 | speaker=unknown"
msgid "  As Aoko finished her declaration, Soujyuro subtly looked up at the ceiling so she would not notice his reaction."
msgstr "　<大|おお><威|い><張|ば>りでそう言われて、青子に気付かれないよう、草十郎は天を仰いだ。"

#. Occurrence 6_4:2610:7727: scene=6_4
#: 6_4:2610
msgctxt "text_id=7727 | speaker=unknown"
msgid "  He meant no offense to Aoko, but he had to hide the fact that he fundamentally disagreed with her analogy."
msgstr "　青子には申し訳ないが、ちっともぜんぜん判らない。"

#. Occurrence 6_4:2615:7728: scene=6_4
#: 6_4:2615
msgctxt "text_id=7728 | speaker=unknown"
msgid "  In Soujyuro's opinion, it was disrespectful to both dogs and humans to call him lower than a dog. A more accurate analogy of their power dynamic would be that of a rabbit and a wild boar, hence why he chose not to voice this opinion."
msgstr "　個人的な感想と言えば、犬より簡単と言われて怒らないのは人間としても、お犬さまにも礼を欠くと思うのだが、自分と彼女の戦力差は兎と猪ほどもあるので反論もできない。"

#. Occurrence 6_4:2662:7729: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0032; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2662
msgctxt "text_id=7729 | speaker=soujuurou"
msgid "\"...Haa.\""
msgstr "「……………………はあ」"

#. Occurrence 6_4:2668:7730: scene=6_4
#: 6_4:2668
msgctxt "text_id=7730 | speaker=unknown"
msgid "  Unlike his apartment, the ceiling here was decorated with ornate patterns."
msgstr "　見上げた天井は、自分の安アパートとは違って豪奢な紋様があしらわれている。"

#. Occurrence 6_4:2673:7731: scene=6_4
#: 6_4:2673
msgctxt "text_id=7731 | speaker=unknown"
msgid "  Putting aside how he would be treated here, in terms of lodging, it was a definite upgrade."
msgstr "　……自分の扱いはともかく、建物に関しては文句なしにグレードが上がっている。"

#. Occurrence 6_4:2686:7732: scene=6_4
#: 6_4:2686
msgctxt "text_id=7732 | speaker=unknown"
msgid "  Maybe it would not be all that bad."
msgstr "　つまり、悪いことだけじゃないだろう、と。"

#. Occurrence 6_4:2691:7733: scene=6_4
#: 6_4:2691
msgctxt "text_id=7733 | speaker=unknown"
msgid "  Soujyuro nodded slowly, as if to persuade himself."
msgstr "　自分に言い聞かせるように、草十郎はうんうんと頷いた。"

#. Occurrence 6_4:2696:7734: scene=6_4
#: 6_4:2696
msgctxt "text_id=7734 | speaker=unknown"
msgid "  And..."
msgstr "　それに―――"

#. Occurrence 6_4:2760:7735: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0043; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2760
msgctxt "text_id=7735 | speaker=aoko"
msgid "\"For the time being, I've decided to let you live.\""
msgstr "“とりあえず、命は助けてあげるから”"

#. Occurrence 6_4:2767:7736: scene=6_4
#: 6_4:2767
msgctxt "text_id=7736 | speaker=unknown"
msgid "  That is what she had told him."
msgstr "　あの時。"

msgctxt "text_id=7737 | speaker=unknown"
msgid " Not two days ago."
msgstr "彼女は確かにそう言ったのだ。"

#. Occurrence 6_4:2818:7738: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0033; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2818
msgctxt "text_id=7738 | speaker=soujuurou"
msgid "\"While I don't really accept what you're saying, I understand my position."
msgstr "「あまり納得したくないけど、自分の立場は分かったよ。"

#. Occurrence 6_4:2818:7739: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0033; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2818
msgctxt "text_id=7739 | speaker=soujuurou"
msgid "  I remember what you promised me now. There are lots of things I could disagree with, but I admit you did promise me at least that."
msgstr "　うん、たしかにそんな約束だった。色々と言いたい事はあるけど、それは認めるしかない。"

#. Occurrence 6_4:2824:7740: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0034; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2824
msgctxt "text_id=7740 | speaker=soujuurou"
msgid "  Are you really serious about me living with the two of you?"
msgstr "　だけど、君たちと一緒に住めっていうのは本気なのか？"

#. Occurrence 6_4:2824:7741: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0034; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2824
msgctxt "text_id=7741 | speaker=soujuurou"
msgid "  I know you're pretty easygoing, but that girl seems pretty against it, and I'm not exactly―\""
msgstr "　蒼崎は細かいコトは気にしないとしても、さっきの娘は嫌がりそうだし、俺だって少しは……」"

#. Occurrence 6_4:2829:7742: scene=6_4
#: 6_4:2829
msgctxt "text_id=7742 | speaker=unknown"
msgid "  At that point, he zipped his lips."
msgstr "　そこで、草十郎はぴたりと黙りこんだ。"

#. Occurrence 6_4:2845:7743: scene=6_4
#: 6_4:2845
msgctxt "text_id=7743 | speaker=unknown"
msgid "  Aoko's eyes were tinged with bloodlust."
msgstr "　青子の目がひどく殺気を帯びて見えたからだ。"

#. Occurrence 6_4:2872:7744: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0044; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2872
msgctxt "text_id=7744 | speaker=aoko"
msgid "\"Oh. Please excuse me. I'm sorry to hear that you're dissatisfied with the arrangement.\""
msgstr "「あら、静希君はご不満？」"

#. Occurrence 6_4:2891:7745: scene=6_4
#: 6_4:2891
msgctxt "text_id=7745 | speaker=unknown"
msgid "  Her contrived smile, so obviously forced, struck despair into Soujyuro's heart."
msgstr "　無理に笑ってるとしか思えない彼女の口元に、草十郎は絶望を見た気がした。"

#. Occurrence 6_4:2896:7746: scene=6_4
#: 6_4:2896
msgctxt "text_id=7746 | speaker=unknown"
msgid "  Come to think of it, he vaguely recalled her warning to him to not make her repeat herself."
msgstr "　そういえば、さっき同じ事は何度も言わせるなと忠告された気がする。"

#. Occurrence 6_4:2935:7747: scene=6_4
#: 6_4:2935
msgctxt "text_id=7747 | speaker=unknown"
msgid "  Furthermore..."
msgstr "　さらにさらに。"

#. Occurrence 6_4:2940:7748: scene=6_4
#: 6_4:2940
msgctxt "text_id=7748 | speaker=unknown"
msgid "  As a practical matter, Soujyuro Sizuki's life was now in the hands of Aoko Aozaki."
msgstr "　実際問題として、どんなに実感が湧かないとしても、静希草十郎の命は蒼崎青子に握られている。"

#. Occurrence 6_4:2945:7749: scene=6_4
#: 6_4:2945
msgctxt "text_id=7749 | speaker=unknown"
msgid "  It would be unwise to anger her further, he told himself as if speaking to a third person."
msgstr "　怒らせるのは<賢|かしこ>くない、と他人事のように頷く草十郎なのだった。"

#. Occurrence 6_4:2973:7750: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0035; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2973
msgctxt "text_id=7750 | speaker=soujuurou"
msgid "\"N-Not at all. I mean, what choice do I have anyway?\""
msgstr "「……いや、別に。だってそれ以外ないんだろう？」"

#. Occurrence 6_4:2979:7751: scene=6_4
#: 6_4:2979
msgctxt "text_id=7751 | speaker=unknown"
msgid "  \"None,\" Aoko said with a firm nod of her head."
msgstr "　当然、と頷く青子と、"

#. Occurrence 6_4:2984:7752: scene=6_4
#: 6_4:2984
msgctxt "text_id=7752 | speaker=unknown"
msgid "  Soujyuro slumped his shoulders in surrender."
msgstr "　降伏するようにがっくりと肩を落とす草十郎。"

#. Occurrence 6_4:3033:7753: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0036; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3033
msgctxt "text_id=7753 | speaker=soujuurou"
msgid "\"All right. I understand you now, Aozaki."
msgstr "「……うん、蒼崎の言い分は分かった。"

#. Occurrence 6_4:3039:7754: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0037; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3039
msgctxt "text_id=7754 | speaker=soujuurou"
msgid "  Just, let me ask you this one thing. Do I have any human rights?\""
msgstr "　ただ、いちおう聞いておきたいんだけど。俺の人権はどこにいってしまったんだろう？」"

#. Occurrence 6_4:3066:7755: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0045; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3066
msgctxt "text_id=7755 | speaker=aoko"
msgid "\"Poor little Sizuki. You never had any in the first place. Now, stop wasting my time with stupid questions.\""
msgstr "「莫迦ね、そんな形のない物なんて初めからあるワケないでしょ。つまんないこと言わないでよ」"

#. Occurrence 6_4:3072:7756: scene=6_4
#: 6_4:3072
msgctxt "text_id=7756 | speaker=unknown"
msgid "  Soujyuro reflected upon her answer, now feeling like his question was, indeed, stupid."
msgstr "　……うん、たしかに今のはつまらない事だった、と草十郎は噛みしめる。"

#. Occurrence 6_4:3077:7757: scene=6_4
#: 6_4:3077
msgctxt "text_id=7757 | speaker=unknown"
msgid "  He should have already known the answer before he asked."
msgstr "　そもそも彼にしてみれば、いまの青子の答えは分かりきっていた事だ。"

#. Occurrence 6_4:3138:7758: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0038; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3138
msgctxt "text_id=7758 | speaker=soujuurou"
msgid "\"That's...what I thought."
msgstr "「……ああ、だと思った。"

#. Occurrence 6_4:3138:7759: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0038; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3138
msgctxt "text_id=7759 | speaker=soujuurou"
msgid "  I had a feeling this was going to happen, even before waking up.\""
msgstr "　そんな気はしてたんだ、目が覚める前から」"

#. Occurrence 6_4:3151:7760: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0046; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3151
msgctxt "text_id=7760 | speaker=aoko"
msgid "\"?\""
msgstr "「？」"

#. Occurrence 6_4:3157:7761: scene=6_4
#: 6_4:3157
msgctxt "text_id=7761 | speaker=unknown"
msgid "  His muttering provoked a dubious stare from Aoko, before she quickly retracted it."
msgstr "　草十郎の独白に青子は不審げな目を向けたが、すぐに気を取り直した。"

#. Occurrence 6_4:3162:7762: scene=6_4
#: 6_4:3162
msgctxt "text_id=7762 | speaker=unknown"
msgid "  If she questioned every little thing he said, they would be there until sundown."
msgstr "　この男の発言をいちいち気にしていたら日が暮れてしまう、と骨身に染みているからだろう。"

#. Occurrence 6_4:3190:7763: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0047; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3190
msgctxt "text_id=7763 | speaker=aoko"
msgid "\"Well, as long as you understand."
msgstr "「とにかく納得いったみたいね。"

#. Occurrence 6_4:3196:7764: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0048; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3196
msgctxt "text_id=7764 | speaker=aoko"
msgid "  Now, we need to get down to brass tacks. Let's move to the drawing room."
msgstr "　じゃあ次、いよいよ本題。居間に移動するわよ。"

#. Occurrence 6_4:3196:7765: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0048; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3196
msgctxt "text_id=7765 | speaker=aoko"
msgid "  I have a ton of explaining to do."
msgstr "　説明しなくちゃいけない事が山ほどあるんだから。"

#. Occurrence 6_4:3223:7766: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0049; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3223
msgctxt "text_id=7766 | speaker=aoko"
msgid "  Can you stand on your own?\""
msgstr "　―――って、ひとりで立てる？」"

#. Occurrence 6_4:3236:7767: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0039; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3236
msgctxt "text_id=7767 | speaker=soujuurou"
msgid "\"I was able to move my hands earlier, so blood is at least flowing."
msgstr "「さっきから手を動かしてたから、血は巡ってる。"

#. Occurrence 6_4:3236:7768: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0039; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3236
msgctxt "text_id=7768 | speaker=soujuurou"
msgid "  I should be able to walk.\""
msgstr "　歩くぐらいならいけそうだ」"

#. Occurrence 6_4:3273:7769: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0050; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3273
msgctxt "text_id=7769 | speaker=aoko"
msgid "\"Good. You'll be fine then.\""
msgstr "「そ。なら問題ないわね」"

#. Occurrence 6_4:3304:7770: scene=6_4
#: 6_4:3304
msgctxt "text_id=7770 | speaker=unknown"
msgid "  With that, she turned her back and walked away from him."
msgstr "　言うなり、彼女はくるりと草十郎に背を向けて歩きだした。"

#. Occurrence 6_4:3309:7771: scene=6_4
#: 6_4:3309
msgctxt "text_id=7771 | speaker=unknown"
msgid "  He had seen this bold form of hers many times before."
msgstr "　その背中は、もう何度と見てきた颯爽とした後ろ姿だ。"

#. Occurrence 6_4:3352:7772: scene=6_4
#: 6_4:3352
msgctxt "text_id=7772 | speaker=unknown"
msgid "  Instantly, the memories flashed back to him like lightning."
msgstr "　瞬間、落雷のように記憶が巻き戻される。"

#. Occurrence 6_4:3401:7773: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0040; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3401
msgctxt "text_id=7773 | speaker=soujuurou"
msgid "(I remember now. This is the Aozaki I know.)"
msgstr "『……そうだった。蒼崎は、こういうヤツだった』"

#. Occurrence 6_4:3407:7774: scene=6_4
#: 6_4:3407
msgctxt "text_id=7774 | speaker=unknown"
msgid "  Without knowing it, he cracked a smile."
msgstr "　知らず、頬がほころぶ。"

#. Occurrence 6_4:3412:7775: scene=6_4
#: 6_4:3412
msgctxt "text_id=7775 | speaker=unknown"
msgid "  He was so lost that he did not know his left from his right, but recalling this alone was enough to calm him."
msgstr "　草十郎にとっては右も左も分からない状況だったけれど、それだけで彼は充分に落ち着けた。"

#. Occurrence 6_4:3451:7776: scene=6_4
#: 6_4:3451
msgctxt "text_id=7776 | speaker=unknown"
msgid "  The Aoko he knew was different from the one in the house of mirrors."
msgstr "　……今の青子は、ミラーハウスでの彼女とは違う。"

#. Occurrence 6_4:3456:7777: scene=6_4
#: 6_4:3456
msgctxt "text_id=7777 | speaker=unknown"
msgid "  She was not that brooding girl he saw there."
msgstr "　あんな、無理やりに思い詰めた彼女ではない。"

#. Occurrence 6_4:3461:7778: scene=6_4
#: 6_4:3461
msgctxt "text_id=7778 | speaker=unknown"
msgid "  He felt a pang of nostalgia; the Aoko he knew was brisk in movement and unfaltering in gaze, just like this one."
msgstr "　きびきびとした動作もためらいのない視線も、なんだかひどく懐かしい。"

#. Occurrence 6_4:3466:7779: scene=6_4
#: 6_4:3466
msgctxt "text_id=7779 | speaker=unknown"
msgid "  She was the same as when he first met her; moody, yet overflowing with confidence; in her element."
msgstr "　それは初めて会った時と同じ、不機嫌そうで、そのくせ自信に満ちた彼女本来のあり方だった。"

#. Occurrence 6_4:3528:7780: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0051; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3528
msgctxt "text_id=7780 | speaker=aoko"
msgid "\"Let's go, let's go. Chop-chop."
msgstr "「ほら、急いだ急いだ。"

#. Occurrence 6_4:3534:7781: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0052; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3534
msgctxt "text_id=7781 | speaker=aoko"
msgid "  Alice is waiting for us in the drawing room.\""
msgstr "　有珠がさっきから居間でお待ちかねよ」"

#. Occurrence 6_4:3540:7782: scene=6_4
#: 6_4:3540
msgctxt "text_id=7782 | speaker=unknown"
msgid "  She was already outside the door, standing in the chilly corridor."
msgstr "　彼女はとっくに扉から出て、薄ら寒そうな廊下に立っている。"

#. Occurrence 6_4:3574:7783: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0041; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3574
msgctxt "text_id=7783 | speaker=soujuurou"
msgid "\"Hngh... You must not know what it's like to be bedridden, Aozaki.\""
msgstr "「はあ。寝たきりの辛さを知らないだろう、蒼崎は」"

#. Occurrence 6_4:3594:7784: scene=6_4
#: 6_4:3594
msgctxt "text_id=7784 | speaker=unknown"
msgid "  Grunting and groaning, Soujyuro eventually got to his feet."
msgstr "　ぼやきつつ、草十郎はなんとかベッドから起き上がった。"

#. Occurrence 6_4:3640:7785: scene=6_4
#: 6_4:3640
msgctxt "text_id=7785 | speaker=unknown"
msgid "  His body, heavy and stiff while he was lying down, cried out in pain as he tried to stand and walk."
msgstr "　横臥中だるかった体は、立ち上がって歩こうとすると逆に硬く痛む。"

#. Occurrence 6_4:3645:7786: scene=6_4
#: 6_4:3645
msgctxt "text_id=7786 | speaker=unknown"
msgid "  Every step sent shooting pains through his bones."
msgstr "　一歩前に出るだけで骨に<痺|しび>れと痛みが響いた。"

#. Occurrence 6_4:3650:7787: scene=6_4
#: 6_4:3650
msgctxt "text_id=7787 | speaker=unknown"
msgid "  Despite this, he put on a calm face and made his way toward Aoko."
msgstr "　それでもしれっとした顔で青子へと歩きだす。"

#. Occurrence 6_4:3670:7788: scene=6_4
#: 6_4:3670
msgctxt "text_id=7788 | speaker=unknown"
msgid "  Typically, he was quick to not pay any mind to life's little struggles, but these pains... He needed to force himself to consciously ignore them."
msgstr "　苦いもの、厳しいものは無意識に受け入れる草十郎だったが、今回にかぎっては意識的に受け流した。"

#. Occurrence 6_4:3675:7789: scene=6_4
#: 6_4:3675
msgctxt "text_id=7789 | speaker=unknown"
msgid "  In other words, he was displaying false bravado. An uncharacteristic reaction for someone who never suppressed their true feelings."
msgstr "　要するにやせ我慢だ。彼がこんなふうに、不自然に自分の気持ちを抑えこむのは珍しい。"

#. Occurrence 6_4:3727:7790: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0053; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3727
msgctxt "text_id=7790 | speaker=aoko"
msgid "\"Amazing. You really are tough, huh?\""
msgstr "「驚いた。アンタ、ほんとにタフね」"

#. Occurrence 6_4:3733:7791: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0042; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3733
msgctxt "text_id=7791 | speaker=soujuurou"
msgid "\"Thanks. It's just my heart that's fragile.\""
msgstr "「ありがとう。けど、心は弱いんだ」"

#. Occurrence 6_4:3745:7792: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0054; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3745
msgctxt "text_id=7792 | speaker=aoko"
msgid "\"Oh yeah? I'll keep that in mind and try not to hurt your precious feelings.\""
msgstr "「そ。参考までに心に留めておくわ。出来るだけ優しく扱えるようにね」"

#. Occurrence 6_4:3750:7793: scene=6_4
#: 6_4:3750
msgctxt "text_id=7793 | speaker=unknown"
msgid "  Naturally, her voice was devoid of any true empathy."
msgstr "　もちろん、青子の声には優しさなど微塵もない。"

#. Occurrence 6_4:3755:7794: scene=6_4
#: 6_4:3755
msgctxt "text_id=7794 | speaker=unknown"
msgid "  She turned away from the once-more dejected Soujyuro, and began walking briskly down the corridor."
msgstr "　がっくりとする草十郎をよそに、青子はスタスタと廊下を歩きはじめる。"

#. Occurrence 6_4:3794:7795: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0055; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3794
msgctxt "text_id=7795 | speaker=aoko"
msgid "\"...Oh, and...\""
msgstr "「―――、と」"

#. Occurrence 6_4:3799:7796: scene=6_4
#: 6_4:3799
msgctxt "text_id=7796 | speaker=unknown"
msgid "  Just then, she stopped, feet snapped together, as though something had popped into her head."
msgstr "　その時、何かを思い立ったように彼女はピタリと足を止めて振り向いた。"

#. Occurrence 6_4:3804:7797: scene=6_4
#: 6_4:3804
msgctxt "text_id=7797 | speaker=unknown"
msgid "  And just as if she was remembering something she had forgotten, in a completely trivial way..."
msgstr "　言い忘れていた事、それでいて何でもない事を告げるように、"

#. Occurrence 6_4:3858:7798: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0056; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3858
msgctxt "text_id=7798 | speaker=aoko"
msgid "\"Follow me, Soujyuro.\""
msgstr "「それじゃ行くわよ。付いてきて、草十郎」"

#. Occurrence 6_4:3864:7799: scene=6_4
#: 6_4:3864
msgctxt "text_id=7799 | speaker=unknown"
msgid "  She gallantly turned back the way she was heading, the words sounding so natural as she spoke them."
msgstr "　颯爽と振り向いて、彼女は自然にそう言った。"

#. Occurrence 6_4:3917:7800: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0043; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3917
msgctxt "text_id=7800 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 6_4:3924:7801: scene=6_4
#: 6_4:3924
msgctxt "text_id=7801 | speaker=unknown"
msgid "  Aoko did not see the look in Soujyuro's eyes as he heard her words."
msgstr "　その時に開かれた視界を、彼女は知らない。"

#. Occurrence 6_4:3929:7802: scene=6_4
#: 6_4:3929
msgctxt "text_id=7802 | speaker=unknown"
msgid "  For though she worked in the arcane, the spell Aoko had woven was apparent to everyone but her."
msgstr "　彼女が魔法使いだと言うのなら、この言葉こそ魔法だったことを、口にした当人だけが知らずじまい。"

#. Occurrence 6_4:3934:7803: scene=6_4
#: 6_4:3934
msgctxt "text_id=7803 | speaker=unknown"
msgid "  After blinking his eyes as if blinded by something, Soujyuro casually nodded, and followed behind her."
msgstr "　彼は眩しいものを見たようにまばたきをした後、自然に頷いて、その背中を追いかけた。"

#. Occurrence 6_5:49:7804: scene=6_5
#: 6_5:49
msgctxt "text_id=7804 | speaker=unknown"
msgid "  The sheer size of the interior was daunting."
msgstr "　館の広さはかなりのものだった。"

#. Occurrence 6_5:54:7805: scene=6_5
#: 6_5:54
msgctxt "text_id=7805 | speaker=unknown"
msgid "  The three floors of this mansion contained more rooms than Soujyuro's entire apartment building."
msgstr "　三階建ての洋館は、部屋の数でも草十郎の住むアパートを上回っている。"

#. Occurrence 6_5:59:7806: scene=6_5
#: 6_5:59
msgctxt "text_id=7806 | speaker=unknown"
msgid "  Except, their size was excessive."
msgstr "　ただ、その広さは持てあまし気味だ。"

#. Occurrence 6_5:64:7807: scene=6_5
#: 6_5:64
msgctxt "text_id=7807 | speaker=unknown"
msgid "  Here, the mansion's rooms seemed too numerous for so few inhabitants; its lavish carpeted halls cold and dreary."
msgstr "　部屋数と住人の比率は合っていない。絨毯張りの廊下は、その豪華さとは裏腹に寒々しかった。"

#. Occurrence 6_5:84:7808: scene=6_5
#: 6_5:84
msgctxt "text_id=7808 | speaker=unknown"
msgid "  The guest room that Soujyuro had been sleeping in was on the second floor of the east wing."
msgstr "　草十郎が眠っていた客室は二階の東側にあった。"

#. Occurrence 6_5:89:7809: scene=6_5
#: 6_5:89
msgctxt "text_id=7809 | speaker=unknown"
msgid "  A staircase leading down to the first floor was at the end of the corridor, at the center of the mansion."
msgstr "　一階に下りる階段はこの廊下の先、館の中央にあるらしい。"

#. Occurrence 6_5:94:7810: scene=6_5
#: 6_5:94
msgctxt "text_id=7810 | speaker=unknown"
msgid "  Winter sunlight beamed through the windows, which only made the empty corridor appear even lonelier."
msgstr "　窓から差しこむ冬の日射しが、廃墟じみた廊下をいっそう寂しく見せている。"

#. Occurrence 6_5:146:7811: scene=6_5
#: 6_5:146
msgctxt "text_id=7811 | speaker=unknown"
msgid "  The center of the mansion was topped by a vaulted skylight overlooking the first floor."
msgstr "　館の中央部は吹き抜けになっていて、そのまま一階の様子が見下ろせた。"

#. Occurrence 6_5:151:7812: scene=6_5
#: 6_5:151
msgctxt "text_id=7812 | speaker=unknown"
msgid "  The staircase, connecting the first and second floors, lined its walls."
msgstr "　階段は壁に<沿|そ>って造られている。"

#. Occurrence 6_5:156:7813: scene=6_5
#: 6_5:156
msgctxt "text_id=7813 | speaker=unknown"
msgid "  Another staircase at the other end of the second floor corridor presumably led to an attic, or storeroom of sorts on the third floor."
msgstr "　一階と二階を繋ぐ階段の他に、二階のホール裏には三階への階段もある。おそらく屋根裏に倉庫でもあるのだろう。"

#. Occurrence 6_5:177:7814: scene=6_5
#: 6_5:177
msgctxt "text_id=7814 | speaker=unknown"
msgid "  Paying no mind to Soujyuro's gawking, Aoko descended the stairs with familiar steps."
msgstr "　きょろきょろと見渡している草十郎をよそに、青子は慣れた足取りで階段を下りていく。"

#. Occurrence 6_5:203:7815: scene=6_5
#: 6_5:203
msgctxt "text_id=7815 | speaker=unknown"
msgid "  The foyer was a place of white and woodgrain."
msgstr "　ロビーは一転して白色と木の空間だった。"

#. Occurrence 6_5:209:7816: scene=6_5
#: 6_5:209
msgctxt "text_id=7816 | speaker=unknown"
msgid "  Its hardwood floors shone brightly under the sunlight coming in from the ceiling,"
msgstr "　天井からの日射しが木の床を明るく照らす。"

#. Occurrence 6_5:214:7817: scene=6_5
#: 6_5:214
msgctxt "text_id=7817 | speaker=unknown"
msgid "  and the tall, white walls were spotless and brawny."
msgstr "　壁は一面の白色。一点の汚れもなく、高い壁をより堅固に見せている。"

#. Occurrence 6_5:235:7818: scene=6_5
#: 6_5:235
msgctxt "text_id=7818 | speaker=unknown"
msgid "  There, was a staircase leading to the second floor,"
msgstr "　二階に続く階段と、"

msgctxt "text_id=7819 | speaker=unknown"
msgid "  and a long unused fireplace;"
msgstr "　長らく使われていない暖炉。"

#. Occurrence 6_5:243:7820: scene=6_5
#: 6_5:243
msgctxt "text_id=7820 | speaker=unknown"
msgid "  a neglected telephone sat on a table,"
msgstr "　ぞんざいに放置された電話機と、"

msgctxt "text_id=7821 | speaker=unknown"
msgid "  opposite a solemn grandfather clock."
msgstr "　独りぼっちで時を刻む大時計。"

#. Occurrence 6_5:272:7822: scene=6_5
#: 6_5:272
msgctxt "text_id=7822 | speaker=unknown"
msgid "  It was more like an old castle than a mansion."
msgstr "　ここは洋館というより古城の様だ。"

#. Occurrence 6_5:277:7823: scene=6_5
#: 6_5:277
msgctxt "text_id=7823 | speaker=unknown"
msgid "  Aoko shot Soujyuro a callous stare, who stood captivated by the otherworldly scenery."
msgstr "　あまりの異世界っぷりに呆然としている草十郎に、青子は冷たい視線を向ける。"

#. Occurrence 6_5:304:7824: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0000; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:304
msgctxt "text_id=7824 | speaker=aoko"
msgid "\"Hey, snap out of it. The drawing room is this way.\""
msgstr "「居間はこっちよ。ぼさっとしない」"

#. Occurrence 6_5:310:7825: scene=6_5
#: 6_5:310
msgctxt "text_id=7825 | speaker=unknown"
msgid "  She grabbed the knob of the door next to the stairs."
msgstr "　彼女は階段横の扉に手を掛けた。"

#. Occurrence 6_5:347:7826: scene=6_5
#: 6_5:347
msgctxt "text_id=7826 | speaker=unknown"
msgid "  There were four doors to the foyer, and the easternmost as you entered the house led to the drawing room."
msgstr "　ロビーには四つの扉があって、玄関から見て東側の扉が居間に続いているらしい。"

#. Occurrence 6_5:352:7827: scene=6_5
#: 6_5:352
msgctxt "text_id=7827 | speaker=unknown"
msgid "  The door on the opposite side of the foyer led to the mansion's west wing."
msgstr "　反対側にある西の扉は館の左翼に。"

#. Occurrence 6_5:372:7828: scene=6_5
#: 6_5:372
msgctxt "text_id=7828 | speaker=unknown"
msgid "  To the south was the entrance."
msgstr "　南側の扉は玄関。"

#. Occurrence 6_5:393:7829: scene=6_5
#: 6_5:393
msgctxt "text_id=7829 | speaker=unknown"
msgid "  On the north side was one more door next to the fireplace."
msgstr "　北側、暖炉の横にはさらにもう一つ。"

#. Occurrence 6_5:398:7830: scene=6_5
#: 6_5:398
msgctxt "text_id=7830 | speaker=unknown"
msgid "  Tucked underneath the stairs, this door connected to a bathroom, unbeknownst to Soujyuro."
msgstr "　階段の下に隠れている扉は浴場に続いているのだが、今の草十郎には知るよしもない。"

#. Occurrence 6_5:445:7831: scene=6_5
#: 6_5:445
msgctxt "text_id=7831 | speaker=unknown"
msgid "  Due to the lack of windows, the first floor's corridors were not well lit."
msgstr "　一階の廊下には窓がないため、全体的に薄暗い。"

#. Occurrence 6_5:450:7832: scene=6_5
#: 6_5:450
msgctxt "text_id=7832 | speaker=unknown"
msgid "  If the second floor was a seldom-attended infirmary, and the foyer a stairwell in some foreign castle,"
msgstr "　さながら、二階は放置された診療所で、ロビーは日本とは思えない西洋の城。"

#. Occurrence 6_5:455:7833: scene=6_5
#: 6_5:455
msgctxt "text_id=7833 | speaker=unknown"
msgid "  then the first floor corridor was a windowless labyrinth, not unlike the corridors of a hotel."
msgstr "　そして一階廊下はホテルを思わせる窓なき迷路。"

#. Occurrence 6_5:476:7834: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0000; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:476
msgctxt "text_id=7834 | speaker=soujuurou"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence 6_5:481:7835: scene=6_5
#: 6_5:481
msgctxt "text_id=7835 | speaker=unknown"
msgid "  Although it had not been long since Soujyuro came to the city, even he could feel this place was out of the ordinary."
msgstr "　都会に来て日が浅い草十郎にも、この洋館がただならぬものである事は感じ取れる。"

#. Occurrence 6_5:486:7836: scene=6_5
#: 6_5:486
msgctxt "text_id=7836 | speaker=unknown"
msgid "  Seeing as how he was going to be stuck here for the foreseeable future, he found it hard to get excited about living in a haunted house."
msgstr "　手放しで喜べないのは、そのお化け屋敷としばらく付き合う事になりそうだからだ。"

#. Occurrence 6_5:521:7837: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0001; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:521
msgctxt "text_id=7837 | speaker=aoko"
msgid "\"So that's the drawing room, and a little farther down is the kitchen. It's fine for cooking simple meals."
msgstr "「そこが居間で、奥が厨房ね。簡単な料理ぐらいはできるようになってるから。"

#. Occurrence 6_5:528:7838: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0002_0; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:528
msgctxt "text_id=7838 | speaker=aoko"
msgid "  Here, next to the drawing room, is the sunroom, which we use as a dining room,"
msgstr "　居間のとなりにはサンルームがあるんだけど、ここが食卓の代わり……"

#. Occurrence 6_5:540:7839: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0002_1; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:540
msgctxt "text_id=7839 | speaker=aoko"
msgid " but we'll get into that later.\""
msgstr "って、そんなの後でいっか」"

#. Occurrence 6_5:546:7840: scene=6_5
#: 6_5:546
msgctxt "text_id=7840 | speaker=unknown"
msgid "  Aoko said, reaching for a door along the dim corridor."
msgstr "　言って、青子は暗い廊下の扉に手を掛ける。"

#. Occurrence 6_5:590:7841: scene=6_5
#: 6_5:590
msgctxt "text_id=7841 | speaker=unknown"
msgid "  However, she paused before turning the knob."
msgstr "　ドアノブを回す<間際|まぎわ>。"

#. Occurrence 6_5:623:7842: scene=6_5
#: 6_5:623
msgctxt "text_id=7842 | speaker=unknown"
msgid "  She flashed Soujyuro a meaningful glance, which she quickly withdrew."
msgstr "　青子は意味ありげな<視線|コンタクト>を草十郎に送ったが、すぐに消した。"

#. Occurrence 6_5:628:7843: scene=6_5
#: 6_5:628
msgctxt "text_id=7843 | speaker=unknown"
msgid "  Then, without further ado, she opened the door."
msgstr "　ドアノブは待ったなしで回される。"

#. Occurrence 6_5:699:7844: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0003; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:699
msgctxt "text_id=7844 | speaker=aoko"
msgid "\"Sorry for the wait. He's on board,\""
msgstr "「お待たせ。承諾したわよ、あいつ」"

#. Occurrence 6_5:705:7845: scene=6_5
#: 6_5:705
msgctxt "text_id=7845 | speaker=unknown"
msgid "  she said to Alice as she entered the drawing room."
msgstr "　青子は居間に入りながら、中にいる有珠に語りかける。"

#. Occurrence 6_5:710:7846: scene=6_5
#: 6_5:710
msgctxt "text_id=7846 | speaker=unknown"
msgid "  After hesitating for a moment, Soujyuro entered after her."
msgstr "　草十郎も少しだけ迷ってから、居間へと足を踏み入れた。"

#. Occurrence 6_5:750:7847: scene=6_5
#: 6_5:750
msgctxt "text_id=7847 | speaker=unknown"
msgid "  Compared to the corridor, the drawing room was unexpectedly modern."
msgstr "　廊下とは違い、居間は思いのほか現代的だった。"

#. Occurrence 6_5:755:7848: scene=6_5
#: 6_5:755
msgctxt "text_id=7848 | speaker=unknown"
msgid "  The carpeted floor, leather sofas, and a large, 30-inch television were more what Soujyuro had come to expect in a normal home."
msgstr "　絨毯の敷き詰められた床も、革のソファーも、30インチの大きなテレビも、草十郎がこれまで知り得た一般家庭の趣きに満ちている。"

#. Occurrence 6_5:761:7849: scene=6_5
#: 6_5:761
msgctxt "text_id=7849 | speaker=unknown"
msgid "  In this family-oriented room, a girl far removed from said setting sat quietly on the sofa."
msgstr "　その家庭的な居間のソファーに、家庭的な団らんとはかけ離れた少女が座っていた。"

#. Occurrence 6_5:806:7850: scene=6_5
#: 6_5:806
msgctxt "text_id=7850 | speaker=unknown"
msgid "  Aoko sat on the sofa across from the girl in all-black."
msgstr "　青子は黒い少女の向かいのソファーに座る。"

#. Occurrence 6_5:811:7851: scene=6_5
#: 6_5:811
msgctxt "text_id=7851 | speaker=unknown"
msgid "  This gave Soujyuro two seating options:"
msgstr "　草十郎に残された席は二つ。"

#. Occurrence 6_5:835:7852: scene=6_5
#: 6_5:835
msgctxt "text_id=7852 | speaker=unknown"
msgid "  Next to Aoko Aozaki,"
msgstr "　蒼崎青子のとなりか、"

#. Occurrence 6_5:862:7853: scene=6_5
#: 6_5:862
msgctxt "text_id=7853 | speaker=unknown"
msgid "  or next to Alice Kuonji."
msgstr "　久遠寺有珠のとなりか。"

#. Occurrence 6_5:902:7854: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0001; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:902
msgctxt "text_id=7854 | speaker=soujuurou"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence 6_5:938:7855: scene=6_5
#: 6_5:938
msgctxt "text_id=7855 | speaker=unknown"
msgid "  After about two seconds of deliberation, he decided to stand by the wall, as neither option appealed."
msgstr "　草十郎は二秒ほど悩んだ末、どっちも不吉な気がしたので壁ぎわで立つ道を選んだ。"

#. Occurrence 6_5:943:7856: scene=6_5
#: 6_5:943
msgctxt "text_id=7856 | speaker=unknown"
msgid "  Aoko and Alice were facing each other across a coffee table."
msgstr "　テーブルを挟んで青子と有珠は向き合っている。"

#. Occurrence 6_5:948:7857: scene=6_5
#: 6_5:948
msgctxt "text_id=7857 | speaker=unknown"
msgid "  The clean, perfectly level table somehow added to the austere atmosphere."
msgstr "　何も載せられていない真っ平らなテーブルが、どことなく寒い。"

#. Occurrence 6_5:982:7858: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0004; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:982
msgctxt "text_id=7858 | speaker=aoko"
msgid "\"And since he agreed, you shouldn't have any objections, right, Alice?\""
msgstr "「当事者も認めた事だし、これで何の問題もないわね、有珠」"

#. Occurrence 6_5:1009:7859: scene=6_5
#: 6_5:1009
msgctxt "text_id=7859 | speaker=unknown"
msgid "  Alice gave one, deep nod in response to her non-question."
msgstr "　青子の念押しに、有珠はこくんとうなずいた。"

#. Occurrence 6_5:1050:7860: scene=6_5
#: 6_5:1050
msgctxt "text_id=7860 | speaker=unknown"
msgid "  From his position against the wall, they looked as though they were clearing up some niggling grievance."
msgstr "　……こうして壁ぎわから見ていると、目に見えない文句のぶつけ合いが手に取るようだ。"

#. Occurrence 6_5:1055:7861: scene=6_5
#: 6_5:1055
msgctxt "text_id=7861 | speaker=unknown"
msgid "  Soujyuro got the feeling that the two did not entirely see eye to eye concerning what to do with him."
msgstr "　彼女たちの間で、自分の扱いについて一波乱あったんだな、と今更ながら草十郎は感じ取った。"

#. Occurrence 6_5:1097:7862: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0000; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:1097
msgctxt "text_id=7862 | speaker=alice"
msgid "\"...I suppose not. But we still need to investigate the cause.\""
msgstr "「……そうね。原因も究明しないといけないし」"

#. Occurrence 6_5:1131:7863: scene=6_5
#: 6_5:1131
msgctxt "text_id=7863 | speaker=unknown"
msgid "  She cast a sideways look at Soujyuro with those darkly shaded eyes of hers."
msgstr "　<昏|くら>い色をした目が草十郎を流し見る。"

#. Occurrence 6_5:1136:7864: scene=6_5
#: 6_5:1136
msgctxt "text_id=7864 | speaker=unknown"
msgid "  Her voice shared the same, cold indifference,"
msgstr "　視線と同じ<抑揚|よくよう>のない声。"

#. Occurrence 6_5:1141:7865: scene=6_5
#: 6_5:1141
msgctxt "text_id=7865 | speaker=unknown"
msgid "  making it abundantly clear that she had no intention of accepting him as a housemate."
msgstr "　そのくせ、草十郎の同居を認めていない意志がありありと伝わってくる。"

#. Occurrence 6_5:1167:7866: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0001; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:1167
msgctxt "text_id=7866 | speaker=alice"
msgid "\"And you, you're fine with this?"
msgstr "「けれど、貴方はそれでいいの？"

#. Occurrence 6_5:1173:7867: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0002; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:1173
msgctxt "text_id=7867 | speaker=alice"
msgid "  I do hope you haven't forgotten about what happened at the amusement park.\""
msgstr "　遊園地での事を忘れてはいないでしょう？」"

#. Occurrence 6_5:1179:7868: scene=6_5
#: 6_5:1179
msgctxt "text_id=7868 | speaker=unknown"
msgid "  Alice's voice was a mixture of judgment and scrutiny."
msgstr "　有珠の声には批難と、試しの色が混ざっている。"

#. Occurrence 6_5:1184:7869: scene=6_5
#: 6_5:1184
msgctxt "text_id=7869 | speaker=unknown"
msgid "  She was aware that from an outsider's perspective she and Aoko appeared dangerous. She wanted to know if Soujyuro was up to the challenge of living with such people."
msgstr "　自分も青子も一般人からすれば危険物だ。そんな得体の知れない人間の<傍|そば>にいられるのか、と。"

#. Occurrence 6_5:1229:7870: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0002; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:1229
msgctxt "text_id=7870 | speaker=soujuurou"
msgid "\"I wish it had all been a bad dream, but I remember it perfectly.\""
msgstr "「そりゃあ夢だと思いこみたいけど、ちゃんと覚えてるし。できるだけ無事に済ませるには、これが一番<無難|ぶなん>そうだ」"

#. Occurrence 6_5:1243:7871: scene=6_5
#: 6_5:1243
msgctxt "text_id=7871 | speaker=unknown"
msgid "  Above all else, it was the only way they would let him live."
msgstr "　なにより命の保証はされてるみたいだし、と。"

#. Occurrence 6_5:1277:7872: scene=6_5
#: 6_5:1277
msgctxt "text_id=7872 | speaker=unknown"
msgid "  Alice responded apathetically with a noncommittal murmur."
msgstr "　返答する草十郎に、有珠はそう、と無関心げに答えた。"

#. Occurrence 6_5:1282:7873: scene=6_5
#: 6_5:1282
msgctxt "text_id=7873 | speaker=unknown"
msgid "  She silently placed a small object on the table with a clink."
msgstr "　そうして無言のまま、コトリ、とテーブルに小物を置く。"

#. Occurrence 6_5:1350:7874: scene=6_5
#: 6_5:1350
msgctxt "text_id=7874 | speaker=unknown"
msgid "  She pulled her pale fingers away from a small glass bottle."
msgstr "　白い指が置いた物は、<硝子|ガラス>の<小瓶|こびん>だった。"

#. Occurrence 6_5:1355:7875: scene=6_5
#: 6_5:1355
msgctxt "text_id=7875 | speaker=unknown"
msgid "  The glass, more pale blue than transparent, was enough to signify its high quality."
msgstr "　ガラスは透明というより薄い青色をしていて、その色あいだけでも高級品だと見て取れる。"

#. Occurrence 6_5:1360:7876: scene=6_5
#: 6_5:1360
msgctxt "text_id=7876 | speaker=unknown"
msgid "  With a crane-like motion, she removed the stopper."
msgstr "　有珠はその瓶の<蓋|ふた>を、鶴か何かを思わせる仕草で抜いた。"

#. Occurrence 6_5:1404:7877: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0003; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:1404
msgctxt "text_id=7877 | speaker=soujuurou"
msgid "(...?)"
msgstr "『………………？』"

#. Occurrence 6_5:1410:7878: scene=6_5
#: 6_5:1410
msgctxt "text_id=7878 | speaker=unknown"
msgid "  Even though this was the first time he had seen such a thing, something about it made him uneasy."
msgstr "　草十郎にとっては初めて見る小瓶だったが、妙にひっかかる物がある。"

#. Occurrence 6_5:1415:7879: scene=6_5
#: 6_5:1415
msgctxt "text_id=7879 | speaker=unknown"
msgid "  Was it that it made him sad, or...?"
msgstr "　しかし悲しいかな、何がネックなのか思い当たらない。"

#. Occurrence 6_5:1467:7880: scene=6_5
#: 6_5:1467
msgctxt "text_id=7880 | speaker=unknown"
msgid "  Aoko's standoffish behavior only added to his concern."
msgstr "　青子が<傍観|ぼうかん>を決めこんでいるのも気にかかる。"

#. Occurrence 6_5:1478:7881: scene=6_5
#: 6_5:1478
msgctxt "text_id=7881 | speaker=unknown"
msgid "  Alice once again fixed her eyes on Soujyuro, who was bracing himself for the worst."
msgstr "　そんな、イヤな予感に気を張る草十郎に、有珠はもう一度視線を投げた。"

#. Occurrence 6_5:1522:7882: scene=6_5
#: 6_5:1522
msgctxt "text_id=7882 | speaker=unknown"
msgid "  The glint in her eyes was bewitching."
msgstr "　……少女の瞳は、やはり魔的な感じがする。"

#. Occurrence 6_5:1527:7883: scene=6_5
#: 6_5:1527
msgctxt "text_id=7883 | speaker=unknown"
msgid "  With not a single emotion apparent on her face, she called his name."
msgstr "　そんなコトを思っていた草十郎に、有珠は表情のない顔で呼び掛けた。"

#. Occurrence 6_5:1566:7884: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0003; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:1566
msgctxt "text_id=7884 | speaker=alice"
msgid "\"Sizuki.\""
msgstr "「静希君」、と。"

#. Occurrence 6_5:1644:7885: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0004; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:1644
msgctxt "text_id=7885 | speaker=soujuurou"
msgid "  (Ye- huh?)"
msgstr "　{{{は―――い？}}}"

#. Occurrence 6_5:1650:7886: scene=6_5
#: 6_5:1650
msgctxt "text_id=7886 | speaker=unknown"
msgid "  The moment he responded to her whispered call,"
msgstr "　<囁|ささや>くような有珠の呼びかけに応えた瞬間。"

#. Occurrence 6_5:1655:7887: scene=6_5
#: 6_5:1655
msgctxt "text_id=7887 | speaker=unknown"
msgid "  his surroundings began to transform."
msgstr "　<彼|・>の周囲の風景は、かくのように一変していた。"

#. Occurrence 6_5:1660:7888: scene=6_5
#: 6_5:1660
msgctxt "text_id=7888 | speaker=unknown"
msgid "  The air grew thick; so thick, it took on a color and shape."
msgstr "　空気は色と形を持ったように<濁|にご>っている。"

#. Occurrence 6_5:1665:7889: scene=6_5
#: 6_5:1665
msgctxt "text_id=7889 | speaker=unknown"
msgid "  The density and discomfort that coiled around his skin made it seem like the air had become words."
msgstr "　重く肌に<纏|まと>わりつく密度の濃さ、不自由さは、さながら空気が文字になったようだ。"

#. Occurrence 6_5:1730:7890: scene=6_5
#: 6_5:1730
msgctxt "text_id=7890 | speaker=unknown"
msgid "  (...!)"
msgstr "　{{{、―――、、―――！}}}"

#. Occurrence 6_5:1736:7891: scene=6_5
#: 6_5:1736
msgctxt "text_id=7891 | speaker=unknown"
msgid "  Opening his mouth to gasp for air, the words invaded his lungs."
msgstr "　息を吸う口から、<文字|いぶつ>が肺に入る錯覚に襲われる。"

#. Occurrence 6_5:1741:7892: scene=6_5
#: 6_5:1741
msgctxt "text_id=7892 | speaker=unknown"
msgid "  Instinctively, he covered his mouth with his right hand, and clutched his chest with his left, both hands appearing clear as mud."
msgstr "　咄嗟に口を<塞|ふさ>ぐ右手も、胸を押さえる左手も、きちんと見えるのによく見えない。"

#. Occurrence 6_5:1746:7893: scene=6_5
#: 6_5:1746
msgctxt "text_id=7893 | speaker=unknown"
msgid "  Even the thickest of mountain fogs never seized his senses like this."
msgstr "　山で出会った深い霧だって、ここまで意識を<拐|かどわ>かす事はなかったはずだ。"

#. Occurrence 6_5:1804:7894: scene=6_5
#: 6_5:1804
msgctxt "text_id=7894 | speaker=unknown"
msgid "  If he had to come up with an analogy..."
msgstr "　―――喩えるなら、そう。"

#. Occurrence 6_5:1810:7895: scene=6_5
#: 6_5:1810
msgctxt "text_id=7895 | speaker=unknown"
msgid "  ...no words could quite describe it, but it was like he was standing in the pages of a newspaper."
msgstr "　まったく見当違いの比喩ではあるが、まるで生身のまま、<新|・><聞|・><紙|・><の|・><中|・><で|・>立っているような。"

#. Occurrence 6_5:1859:7896: scene=6_5
#: 6_5:1859
msgctxt "text_id=7896 | speaker=unknown"
msgid "  The first sense to adjust to this new sensation was his hearing."
msgstr "　味わった事のない方位感覚に、まず聴覚から慣れていく。"

#. Occurrence 6_5:1864:7897: scene=6_5
#: 6_5:1864
msgctxt "text_id=7897 | speaker=unknown"
msgid "  Then his breathing stabilized, yet the feeling of suffocation remained."
msgstr "　呼吸は普段通りだが、ざらついた圧迫感がある。"

#. Occurrence 6_5:1869:7898: scene=6_5
#: 6_5:1869
msgctxt "text_id=7898 | speaker=unknown"
msgid "  There was nothing restraining him that he could see, but he felt an intense claustrophobia."
msgstr "　別に閉じこめられている訳ではないのに、この周りはひどく<狭|せま>い。"

#. Occurrence 6_5:1874:7899: scene=6_5
#: 6_5:1874
msgctxt "text_id=7899 | speaker=unknown"
msgid "  Before he'd even felt shock at the sudden change, he reached out in an attempt to find an escape."
msgstr "　突然の異変に驚くより先に、その狭さから逃れるために手を伸ばしたほどだ。"

#. Occurrence 6_5:1901:7900: scene=6_5
#: 6_5:1901
msgctxt "text_id=7900 | speaker=unknown"
msgid "  But his outstretched hands found only emptiness."
msgstr "　けれど伸ばした手は<空|くう>を切るだけ。"

#. Occurrence 6_5:1906:7901: scene=6_5
#: 6_5:1906
msgctxt "text_id=7901 | speaker=unknown"
msgid "  It seemed contradictory that a place with no walls and a wide view could feel so cramped."
msgstr "　周囲に壁はなく、これだけ見晴らしのいい場所で「狭い」と感じること自体、常軌を逸している。"

#. Occurrence 6_5:1911:7902: scene=6_5
#: 6_5:1911
msgctxt "text_id=7902 | speaker=unknown"
msgid "  Spirited away in a dense fog..."
msgstr "　深い霧の日は神隠しに遭う―――"

#. Occurrence 6_5:1916:7903: scene=6_5
#: 6_5:1916
msgctxt "text_id=7903 | speaker=unknown"
msgid "  Back in the mountains, such superstitions never seemed real to him. Until now."
msgstr "　山でのそんな<口伝|くでん>を信じていた<彼|・>ではなかったが、これは本当に神隠しの領域では、と思いかけて、"

#. Occurrence 6_5:1986:7904: scene=6_5
#: 6_5:1986
msgctxt "text_id=7904 | speaker=unknown"
msgid "  And then,"
msgstr "　そこでようやく、"

#. Occurrence 6_5:1993:7905: scene=6_5
#: 6_5:1993
msgctxt "text_id=7905 | speaker=unknown"
msgid "  he finally noticed:"
msgstr "　彼はもっと別の、"

#. Occurrence 6_5:2000:7906: scene=6_5
#: 6_5:2000
msgctxt "text_id=7906 | speaker=unknown"
msgid "  a surprise to beat all surprises."
msgstr "　驚かなくてはいけないコトに気が付いた。"

#. Occurrence 6_5:2020:7907: scene=6_5
#: 6_5:2020
msgctxt "text_id=7907 | speaker=unknown"
msgid "  The drawing room had not changed into another world at all."
msgstr "　そもそもの話、居間が別世界に一変した訳ではない。"

#. Occurrence 6_5:2025:7908: scene=6_5
#: 6_5:2025
msgctxt "text_id=7908 | speaker=unknown"
msgid "  He knew this for certain because he could still see the room he was just in through the fog,"
msgstr "　なぜなら霧ごしに見える景色は、間違いなく<彼|・>が先ほどまで居た居間の物だったし、"

#. Occurrence 6_5:2030:7909: scene=6_5
#: 6_5:2030
msgctxt "text_id=7909 | speaker=unknown"
msgid "  as well as the two girls, Aoko Aozaki and Alice Kuonji, watching him closely."
msgstr "　その場にいた二人の少女―――蒼崎青子と久遠寺有珠の姿もきちんと見えている。"

#. Occurrence 6_5:2036:7910: scene=6_5
#: 6_5:2036
msgctxt "text_id=7910 | speaker=unknown"
msgid "  It was simply a problem of perspective."
msgstr "　ただ、その見え方に問題があっただけだ。"

#. Occurrence 6_5:2120:7911: scene=6_5
#: 6_5:2120
msgctxt "text_id=7911 | speaker=unknown"
msgid "  The floor was dark and perfectly flat."
msgstr "　地面は黒い、真っ平らな地平だった。"

#. Occurrence 6_5:2125:7912: scene=6_5
#: 6_5:2125
msgctxt "text_id=7912 | speaker=unknown"
msgid "  Looking up, there the two of them stood."
msgstr "　そこから見上げるようにして二人の姿が見える。"

#. Occurrence 6_5:2131:7913: scene=6_5
#: 6_5:2131
msgctxt "text_id=7913 | speaker=unknown"
msgid "  The two girls were like two impossibly gargantuan clouds, coldly looking down at him."
msgstr "　現実味のない、入道雲の様に大きな少女が、冷たい瞳を向けている。"

#. Occurrence 6_5:2151:7914: scene=6_5
#: 6_5:2151
msgctxt "text_id=7914 | speaker=unknown"
msgid "  Remembering the structure of the room and layout of the furniture, Soujyuro's unsurpassed candor finally grasped his predicament."
msgstr "　部屋の構造、そこにあった家具の位置関係を思い出し、<彼|・>は信じがたい素直さで、この事態を把握した。"

#. Occurrence 6_5:2156:7915: scene=6_5
#: 6_5:2156
msgctxt "text_id=7915 | speaker=unknown"
msgid "  The parade at the amusement park had nothing on this."
msgstr "　あの遊園地でのパレードを経験しておいて、なお信じられない、と頭を抱えそうだが。"

#. Occurrence 6_5:2215:7916: scene=6_5
#: 6_5:2215
msgctxt "text_id=7916 | speaker=unknown"
msgid "  Somehow, he was inside the glass bottle that Alice Kuonji produced only moments ago."
msgstr "　<此|・><処|・>は間違いなく、久遠寺有珠が取り出した小瓶の中であるらしい。"

#. Occurrence 6_5:2249:7917: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0005; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2249
msgctxt "text_id=7917 | speaker=aoko"
msgid "\"That was unexpected.\""
msgstr "「<図|はか>らずも」"

#. Occurrence 6_5:2255:7918: scene=6_5
#: 6_5:2255
msgctxt "text_id=7918 | speaker=unknown"
msgid "  Marveling at Alice's wickedness, Aoko glanced at the small bottle on the table."
msgstr "　青子は有珠の性根の悪さに呆れながら、テーブルに置かれた小瓶をチラ見する。"

#. Occurrence 6_5:2272:7919: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0006; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2272
msgctxt "text_id=7919 | speaker=aoko"
msgid "\"It's the same as two nights ago,"
msgstr "「二日前の夜と同じ状況になったわね。"

#. Occurrence 6_5:2272:7920: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0006; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2272
msgctxt "text_id=7920 | speaker=aoko"
msgid "  only this time, he's awake.\""
msgstr "　今回、<草十郎|ソイツ>は起きてるけど」"

#. Occurrence 6_5:2303:7921: scene=6_5
#: 6_5:2303
msgctxt "text_id=7921 | speaker=unknown"
msgid "  Aoko calmly mused."
msgstr "　淡々と青子は語った。"

#. Occurrence 6_5:2327:7922: scene=6_5
#: 6_5:2327
msgctxt "text_id=7922 | speaker=unknown"
msgid "  Alice, however, was not looking down at the bottle Instead her eyes were locked on Aoko."
msgstr "　有珠はというと、小瓶には視線も落とさず、目前の青子を見つめている。"

#. Occurrence 6_5:2354:7923: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0004; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:2354
msgctxt "text_id=7923 | speaker=alice"
msgid "\"...I'm surprised. I thought you would be upset.\""
msgstr "「……意外ね。青子は怒ると思ってたのに」"

#. Occurrence 6_5:2374:7924: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0007; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2374
msgctxt "text_id=7924 | speaker=aoko"
msgid "\"Not really. I thought about doing something similar."
msgstr "「いや、私も似たようなコト考えてたから。"

#. Occurrence 6_5:2380:7925: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0008; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2380
msgctxt "text_id=7925 | speaker=aoko"
msgid "  He needed to be taught a little lesson about magecraft, anyway."
msgstr "　少しは魔術ってもんを思い知らせておかないと困るでしょ。"

#. Occurrence 6_5:2387:7926: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0009; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2387
msgctxt "text_id=7926 | speaker=aoko"
msgid "You're saving me the trouble, to tell the truth. I'm not even mad."
msgstr "有珠がやってくれるなら止めはしないし<怒|おこ>りもしないわ。"

#. Occurrence 6_5:2393:7927: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0010; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2393
msgctxt "text_id=7927 | speaker=aoko"
msgid "  ...Though, this is pretty hardcore even for me.\""
msgstr "　……ま、こっちが予定していたものより何倍もメチャクチャだけど」"

#. Occurrence 6_5:2429:7928: scene=6_5
#: 6_5:2429
msgctxt "text_id=7928 | speaker=unknown"
msgid "  Aoko did not take her eyes off the bottle as she spoke."
msgstr "　言いつつ、青子は小瓶から視線を外さない。"

#. Occurrence 6_5:2434:7929: scene=6_5
#: 6_5:2434
msgctxt "text_id=7929 | speaker=unknown"
msgid "  Although she did her best to feign indifference toward Alice's magecraft, she could not completely hide her curiosity."
msgstr "　有珠の魔術に無関心を装っているものの、興味を隠しきれていない。"

#. Occurrence 6_5:2454:7930: scene=6_5
#: 6_5:2454
msgctxt "text_id=7930 | speaker=unknown"
msgid "  The figure inside the bottle, likely having caught on to what was happening, tried various things like flailing its arms and sprinting around."
msgstr "　小瓶の中の人影はようやく事態が飲みこめたのか、バタバタと手を伸ばしたり、全力で走ってみたり、色々と試行錯誤しているように見えた。"

#. Occurrence 6_5:2459:7931: scene=6_5
#: 6_5:2459
msgctxt "text_id=7931 | speaker=unknown"
msgid "  The surface of the bottle was cloudy, so it was hard to make out exactly what was happening inside."
msgstr "　小瓶の表面が<濁|にご>っているため、<外|そ><界|と>からでは<瓶|なか>の様子はぼんやりとしか分からない。"

#. Occurrence 6_5:2499:7932: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0011; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2499
msgctxt "text_id=7932 | speaker=aoko"
msgid "\"...By the way, this looks totally different from the one you gave me.\""
msgstr "「……ところで、これって私にくれたヤツとは別物みたいだけど」"

#. Occurrence 6_5:2523:7933: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0005; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:2523
msgctxt "text_id=7933 | speaker=alice"
msgid "\"This one took more time to create."
msgstr "「アレより作りは細かいわ。"

#. Occurrence 6_5:2530:7934: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0006; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:2530
msgctxt "text_id=7934 | speaker=alice"
msgid "The one I gave you was disposable, and only made to isolate the subject. This one allows for two-way communication.\""
msgstr "青子にあげたのは使い捨ての、隔離するだけの物よ。コレはお互いの声も聞こえるから」"

#. Occurrence 6_5:2574:7935: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0012; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2574
msgctxt "text_id=7935 | speaker=aoko"
msgid "\"Really? He doesn't seem to be replying, though.\""
msgstr "「へえ。けど、そのわりには何の反応もないわね」"

#. Occurrence 6_5:2587:7936: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0007; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:2587
msgctxt "text_id=7936 | speaker=alice"
msgid "\"You just can't hear him.\""
msgstr "「青子には聞こえないだけよ」"

#. Occurrence 6_5:2610:7937: scene=6_5
#: 6_5:2610
msgctxt "text_id=7937 | speaker=unknown"
msgid "  Alice said calmly, finally dropping her gaze to the bottle."
msgstr "　平然と言って、有珠は小瓶へ視線を落とした。"

#. Occurrence 6_5:2615:7938: scene=6_5
#: 6_5:2615
msgctxt "text_id=7938 | speaker=unknown"
msgid "  Just then, the figure inside stopped moving."
msgstr "　同時に人影の動きが止まる。"

#. Occurrence 6_5:2620:7939: scene=6_5
#: 6_5:2620
msgctxt "text_id=7939 | speaker=unknown"
msgid "  It appeared only Alice had a connection to the world inside the bottle."
msgstr "　どうやら有珠だけが、小瓶の中の別世界と関わりが持てるようだ。"

#. Occurrence 6_5:2654:7940: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0013; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2654
msgctxt "text_id=7940 | speaker=aoko"
msgid "(Lame. Only the caster gets to have fun?)"
msgstr "『……なんだ、術者にしか特典はないんだ』"

#. Occurrence 6_5:2660:7941: scene=6_5
#: 6_5:2660
msgctxt "text_id=7941 | speaker=unknown"
msgid "  Aoko sighed, losing interest."
msgstr "　つまらなそうに<嘆息|たんそく>する青子。"

#. Occurrence 6_5:2665:7942: scene=6_5
#: 6_5:2665
msgctxt "text_id=7942 | speaker=unknown"
msgid "  Ignoring Aoko, Alice opened her mouth as if to speak to someone not altogether there."
msgstr "　そんな青子をよそに、有珠は誰に話しかけるのでもなく口を開けた。"

#. Occurrence 6_5:2710:7943: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0008; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:2710
msgctxt "text_id=7943 | speaker=alice"
msgid "\"How about now? Still think this is the safest option?\""
msgstr "「どう？　これでも一番、無難だと思う……？」"

#. Occurrence 6_5:2716:7944: scene=6_5
#: 6_5:2716
msgctxt "text_id=7944 | speaker=unknown"
msgid "  The person she was talking to was none other than the one inside the bottle."
msgstr "　語りかける相手は、言うまでもなく小瓶の中の人影だ。"

#. Occurrence 6_5:2721:7945: scene=6_5
#: 6_5:2721
msgctxt "text_id=7945 | speaker=unknown"
msgid "  She was, of course, referring to Soujyuro's earlier comment."
msgstr "　先ほどの会話。"

#. Occurrence 6_5:2726:7946: scene=6_5
#: 6_5:2726
msgctxt "text_id=7946 | speaker=unknown"
msgid "  It was her way of testing the boy who implied that living in this mansion seemed safe."
msgstr "　この洋館に住む事が無難だと言った彼の言葉を、少女はこんなカタチで確認しているのだ。"

#. Occurrence 6_5:2770:7947: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0014; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2770
msgctxt "text_id=7947 | speaker=aoko"
msgid "(Suddenly trapping him in a bottle and interrogating him is pretty ruthless, but even more worrisome is her attachment to this mansion.)"
msgstr "『……いきなり小瓶に閉じこめて聞き返すあたり容赦ないというか……この子の洋館への執着も問題よね……』"

#. Occurrence 6_5:2776:7948: scene=6_5
#: 6_5:2776
msgctxt "text_id=7948 | speaker=unknown"
msgid "  Then again, considering Aoko had invited this witness to a house of mirrors for a fight to the death, she was in no position to criticize."
msgstr "　が、目撃者をミラーハウスに誘いこんで、正々堂々と殺し合いをしよう、と提案した自分が批難できる事でもない。"

#. Occurrence 6_5:2787:7949: scene=6_5
#: 6_5:2787
msgctxt "text_id=7949 | speaker=unknown"
msgid "  She would make sure Alice did not let her emotions get the best of her, but for now she was content to observe as a bystander."
msgstr "　青子は有珠が感情的になって手をあげないよう注意しつつ、あくまで傍観者として事の顛末を見定めている。"

#. Occurrence 6_5:2844:7950: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0009; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:2844
msgctxt "text_id=7950 | speaker=alice"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 6_5:2849:7951: scene=6_5
#: 6_5:2849
msgctxt "text_id=7951 | speaker=unknown"
msgid "  After a moment, Alice's expression changed."
msgstr "　少し間をおいて、有珠の表情が変化した。"

#. Occurrence 6_5:2854:7952: scene=6_5
#: 6_5:2854
msgctxt "text_id=7952 | speaker=unknown"
msgid "  She must have gotten an answer to her question."
msgstr "　少女の問いかけに、人影は何らかの返答をしたらしい。"

#. Occurrence 6_5:2859:7953: scene=6_5
#: 6_5:2859
msgctxt "text_id=7953 | speaker=unknown"
msgid "  Without any way to tell what the situation was inside the bottle, Aoko had no idea what that answer was, however."
msgstr "　小瓶の中の様子を探れない青子には彼がなんと返答したかは分からない。"

#. Occurrence 6_5:2864:7954: scene=6_5
#: 6_5:2864
msgctxt "text_id=7954 | speaker=unknown"
msgid "  Only..."
msgstr "　ただ、"

#. Occurrence 6_5:2896:7955: scene=6_5
#: 6_5:2896
msgctxt "text_id=7955 | speaker=unknown"
msgid "  That Alice's face was the one she had made when the boy she was talking to said what she wanted to hear."
msgstr "　相方がああいう顔をしている時は、完膚無きまで、相手の言い分が正しかった時なのだった。"

#. Occurrence 6_5:2958:7956: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0010; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:2958
msgctxt "text_id=7956 | speaker=alice"
msgid "\"...I suppose I'm not one to talk, but....\""
msgstr "「……わたしが言える事でもないけど」"

#. Occurrence 6_5:2981:7957: scene=6_5
#: 6_5:2981
msgctxt "text_id=7957 | speaker=unknown"
msgid "  For an instant, she glanced at Aoko."
msgstr "　少女は一瞬、青子を<一瞥|いちべつ>する。"

#. Occurrence 6_5:2986:7958: scene=6_5
#: 6_5:2986
msgctxt "text_id=7958 | speaker=unknown"
msgid "  Slightly shaking her head, she reached for the small bottle."
msgstr "　有珠はかすかにかぶりをふって小瓶に手を伸ばし、"

#. Occurrence 6_5:3024:7959: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0011; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:3024
msgctxt "text_id=7959 | speaker=alice"
msgid "\"This Sizuki is quite a strange one.\""
msgstr "「……本当。物好きね、静希君は」"

#. Occurrence 6_5:3030:7960: scene=6_5
#: 6_5:3030
msgctxt "text_id=7960 | speaker=unknown"
msgid "  She said his name with what seemed like a forlorn frown."
msgstr "　<憂鬱|ゆううつ>げなため息のように、彼の名前を口にした。"

#. Occurrence 6_5:3072:7961: scene=6_5
#: 6_5:3072
msgctxt "text_id=7961 | speaker=unknown"
msgid "  As soon as she removed the stopper, the air in the room quivered."
msgstr "　<蓋|フタ>が抜かれた瞬間、居間の空気がわずかに揺れた。"

#. Occurrence 6_5:3077:7962: scene=6_5
#: 6_5:3077
msgctxt "text_id=7962 | speaker=unknown"
msgid "  The boy, who had been casting a shadow on the wall until a minute ago, now leaned against it for support again."
msgstr "　かと思うと、先ほどまで壁際に影だけ映していた少年が、<憮然|ぶぜん>とした顔で壁に寄りかかっていた。"

#. Occurrence 6_5:3082:7963: scene=6_5
#: 6_5:3082
msgctxt "text_id=7963 | speaker=unknown"
msgid "  Aoko turned around to face Soujyuro right behind her, resting her elbow over the back of the sofa."
msgstr "　ちょうど自分の背後にいる草十郎へ、青子は片肘をついたまま振り向く。"

#. Occurrence 6_5:3116:7964: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0015; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3116
msgctxt "text_id=7964 | speaker=aoko"
msgid "\"How do you feel?\""
msgstr "「どう、気分は？」"

#. Occurrence 6_5:3141:7965: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0006; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:3141
msgctxt "text_id=7965 | speaker=soujuurou"
msgid "\"What does it look like? Messed up.\""
msgstr "「見ての通り、めちゃくちゃだ」"

#. Occurrence 6_5:3147:7966: scene=6_5
#: 6_5:3147
msgctxt "text_id=7966 | speaker=unknown"
msgid "  Soujyuro answered with unusual hostility."
msgstr "　草十郎は柄にもなく敵意をむき出しにしていた。"

#. Occurrence 6_5:3152:7967: scene=6_5
#: 6_5:3152
msgctxt "text_id=7967 | speaker=unknown"
msgid "  Aoko was reminded of his strange behavior, as she was sure that he would be scared or shocked, not angry."
msgstr "　<怯|おび>えや驚きではなく怒っているあたり、相変わらず謎なヤツ、と青子は思う。"

#. Occurrence 6_5:3190:7968: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0007; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:3190
msgctxt "text_id=7968 | speaker=soujuurou"
msgid "\"If I hadn't already seen something similar in a dream, my heart probably would have stopped. I'm lucky it didn't."
msgstr "「……夢で似たようなものを見てなかったら、今ごろ心臓が止まってたところだ。そこはついてたと思う。"

#. Occurrence 6_5:3197:7969: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0008_0; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:3197
msgctxt "text_id=7969 | speaker=soujuurou"
msgid "  What I can't believe is why you felt the need to use magecraft on me. You could have just said it was scary and left it at that."
msgstr "　信じられないのは、なんでいちいち実践するかって事だ。魔術は恐いものなんだって言えば済むだろうに。"

#. Occurrence 6_5:3211:7970: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0008_1; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:3211
msgctxt "text_id=7970 | speaker=soujuurou"
msgid " Plus, I could hear the threatening things you said, Aozaki.\""
msgstr "それと、ぶっそうな蒼崎の声、聞こえてたぞ」"

#. Occurrence 6_5:3251:7971: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0016; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3251
msgctxt "text_id=7971 | speaker=aoko"
msgid "\"My sincerest apologies."
msgstr "「ぶっそうで悪うございました。"

#. Occurrence 6_5:3258:7972: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0017; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3258
msgctxt "text_id=7972 | speaker=aoko"
msgid "But it is true that I wanted you to feel it for yourself."
msgstr "けど、言葉じゃなくてきちんと実感してもらいたかったのは本当よ。"

#. Occurrence 6_5:3264:7973: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0018; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3264
msgctxt "text_id=7973 | speaker=aoko"
msgid "  At least now you'll take magecraft seriously, won't you, Soujyuro?\""
msgstr "　どう？　魔術ってもんを甘く見てたでしょ、草十郎？」"

#. Occurrence 6_5:3297:7974: scene=6_5
#: 6_5:3297
msgctxt "text_id=7974 | speaker=unknown"
msgid "  As much as he hated to admit it, she was right."
msgstr "　不本意ながらも、むう、と納得する草十郎。"

#. Occurrence 6_5:3302:7975: scene=6_5
#: 6_5:3302
msgctxt "text_id=7975 | speaker=unknown"
msgid "  Though, it was not that he had taken magecraft lightly, but merely that he couldn't understand it."
msgstr "　彼の場合、『甘く見ていた』と言うより『分かっていなかった』と言う方が正しいのだが。"

#. Occurrence 6_5:3323:7976: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0009; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:3323
msgctxt "text_id=7976 | speaker=soujuurou"
msgid "\"I still don't really get it, though, even after that experience."
msgstr "「けど、実感うんぬん言われても困る。"

#. Occurrence 6_5:3329:7977: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0010; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:3329
msgctxt "text_id=7977 | speaker=soujuurou"
msgid "  Compared to the crazy stuff I've seen you do, Aozaki, whatever the heck just happened to me was hardly unbelievable.\""
msgstr "　これまでの蒼崎の無茶っぷりと、今の訳の分からなさはとても比べられない」"

#. Occurrence 6_5:3348:7978: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0019; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3348
msgctxt "text_id=7978 | speaker=aoko"
msgid "\"W-Wha..."
msgstr "「ちょ、"

msgctxt "text_id=7979 | speaker=unknown"
msgid " Of course not! Alice and I are totally different."
msgstr "そりゃそうよ、有珠と比べないでよね。"

#. Occurrence 6_5:3361:7980: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0020; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3361
msgctxt "text_id=7980 | speaker=aoko"
msgid "  I already told you, even in our world, her magecraft is considered over-the-top and unspeakably horrible.\""
msgstr "　有珠の魔術は私たちの中でもデタラメで、もう言葉にできないぐらい最悪なんだって言ったでしょ」"

#. Occurrence 6_5:3401:7981: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0012; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:3401
msgctxt "text_id=7981 | speaker=alice"
msgid "\"...How rude. When it comes to which of us is more of a threat to human life, I think you're far more dangerous than me."
msgstr "「……失礼ね。人命を<脅|おびや>かす、という点なら青子の方がよっぽど酷いと思うけど。"

#. Occurrence 6_5:3413:7982: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0013; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:3413
msgctxt "text_id=7982 | speaker=alice"
msgid "  And that's besides the point. I'm starting to harbor doubts about you even wanting to kill him in the first place."
msgstr "　それより貴女、本当に彼を殺す気はあったの？"

#. Occurrence 6_5:3419:7983: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0014; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:3419
msgctxt "text_id=7983 | speaker=alice"
msgid "  You must have been pretty soft on him for him to say he believes that he's 'safe' here.\""
msgstr "　一体どんな追いつめ方をすれば、蒼崎ならたぶん安全、なんて言葉が返ってくるのかしらね」"

#. Occurrence 6_5:3464:7984: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0021; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3464
msgctxt "text_id=7984 | speaker=aoko"
msgid "\"W-Well..."
msgstr "「そ―――"

msgctxt "text_id=7985 | speaker=unknown"
msgid " Of course I wanted to kill him!"
msgstr "そんなのあったに決まってるでしょ！"

#. Occurrence 6_5:3478:7986: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0022; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3478
msgctxt "text_id=7986 | speaker=aoko"
msgid "  I don't know what he's told you, but you've got it all twisted!"
msgstr "　コイツがなんて言ったか知らないけど、ぜったい意味違うから！"

#. Occurrence 6_5:3484:7987: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0023; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3484
msgctxt "text_id=7987 | speaker=aoko"
msgid "  This guy doesn't realize he's in danger until he gets burned."
msgstr "　<草十郎|コイツ>はね、そもそも何が危ないのか<火傷|ヤケド>するまで気付かない……"

#. Occurrence 6_5:3496:7988: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0024; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3496
msgctxt "text_id=7988 | speaker=aoko"
msgid "And even then, he'd probably think 'well at least I'm still alive' and whistle all the way home!"
msgstr "っていうか、火傷しても“よし、死ななきゃ安い”なんて本気で思っちゃう天然ボケなのっ！"

#. Occurrence 6_5:3531:7989: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0025; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3531
msgctxt "text_id=7989 | speaker=aoko"
msgid "  Isn't that right, Soujyuro?!\""
msgstr "　ね、そうでしょ草十郎！？」"

#. Occurrence 6_5:3567:7990: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0011; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:3567
msgctxt "text_id=7990 | speaker=soujuurou"
msgid "\"Huh?\""
msgstr "「え？」"

#. Occurrence 6_5:3572:7991: scene=6_5
#: 6_5:3572
msgctxt "text_id=7991 | speaker=unknown"
msgid "  He had no idea why she was suddenly shouting, but he nodded anyway just to be safe."
msgstr "　とつぜん怒鳴られ、よく分からないクセに「うん、まあ」とうなずく天然なんとか。"

#. Occurrence 6_5:3610:7992: scene=6_5
#: 6_5:3610
msgctxt "text_id=7992 | speaker=unknown"
msgid "  The drawing room had become awfully noisy."
msgstr "　居間は騒がしいコトこの上ない。"

#. Occurrence 6_5:3621:7993: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0015; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:3621
msgctxt "text_id=7993 | speaker=alice"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 6_5:3626:7994: scene=6_5
#: 6_5:3626
msgctxt "text_id=7994 | speaker=unknown"
msgid "  Alice sat watching the two at a complete loss."
msgstr "　そんなふたりを、有珠は<呆|あき>れたように見つめていた。"

#. Occurrence 6_6:54:7995: scene=6_6
#: 6_6:54
msgctxt "text_id=7995 | speaker=unknown"
msgid "  And so, Soujyuro accepted his supervised life in the mansion,"
msgstr "　ともあれ、草十郎は洋館での監視生活を承諾した。"

#. Occurrence 6_6:59:7996: scene=6_6
#: 6_6:59
msgctxt "text_id=7996 | speaker=unknown"
msgid "  and that he would be living under the same roof as two professional mages."
msgstr "　魔術を<生業|なりわい>とする者と屋根を同じくすること。"

#. Occurrence 6_6:64:7997: scene=6_6
#: 6_6:64
msgctxt "text_id=7997 | speaker=unknown"
msgid "  Having experienced firsthand how dangerous that life could get, he was finally at peace with the situation."
msgstr "　それがどれだけ危険であるのか、身をもって体験させられた上で、"

#. Occurrence 6_6:117:7998: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0000; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:117
msgctxt "text_id=7998 | speaker=soujuurou"
msgid "\"If that's how it's going to be, then oh well.\""
msgstr "「うん、まあ、そういう事なら」"

#. Occurrence 6_6:123:7999: scene=6_6
#: 6_6:123
msgctxt "text_id=7999 | speaker=unknown"
msgid "  Even if he did not seem like it, he had thought it through in his own way and come to a clear resolution."
msgstr "　とてもそうは見えないが、彼なりに真剣に考えた末で、はっきりと答えたのである。"

#. Occurrence 6_6:156:8000: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0000; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:156
msgctxt "text_id=8000 | speaker=aoko"
msgid "\"Okay, down to business."
msgstr "「それじゃ、やっと本題に入れるわね。"

#. Occurrence 6_6:162:8001: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0001; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:162
msgctxt "text_id=8001 | speaker=aoko"
msgid "  So, I know we said that you'd be under supervision, but we haven't really talked about how we'll be doing that, or the 'magecraft' that is responsible for enforcing it. Let me start with a brief explanation.\""
msgstr "　監視するとは言ったけど、どうやって草十郎を監視するのか。そもそも、貴方を監視する原因になった『魔術』とは何なのか。そのあたり、ざざっと説明させてもらうわ」"

#. Occurrence 6_6:199:8002: scene=6_6
#: 6_6:199
msgctxt "text_id=8002 | speaker=unknown"
msgid "  Perhaps he was brought up to listen closely to lectures about new information, because Soujyuro suddenly looked attentive."
msgstr "　新しい規則のレクチャーはきちんと聞くように教育されているのか、草十郎はいいぞ、と身構える。"

#. Occurrence 6_6:227:8003: scene=6_6
#: 6_6:227
msgctxt "text_id=8003 | speaker=unknown"
msgid "  Alice, on the other hand, kept her mouth shut in silent defiance."
msgstr "　一方、有珠はまだ不満があるようで、かたくなに口を閉ざしていた。"

#. Occurrence 6_6:274:8004: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0002; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:274
msgctxt "text_id=8004 | speaker=aoko"
msgid "\"First off, the time you'll be made to live here has been predetermined."
msgstr "「最初に言っておくと、アンタをここに住まわせる期限は決まってるから。"

#. Occurrence 6_6:280:8005: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0003; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:280
msgctxt "text_id=8005 | speaker=aoko"
msgid "  In short, until the end of that period, if you don't tell anyone about us or die for some reason, you're free to go."
msgstr "　要はその期限まで、誰にも私たちの事をしゃべらず、また、勝手に死ななければ晴れて自由の身ってこと。"

#. Occurrence 6_6:297:8006: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0004; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:297
msgctxt "text_id=8006 | speaker=aoko"
msgid "  Good so far, Alice?\""
msgstr "　ね、そうよね有珠？」"

#. Occurrence 6_6:337:8007: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0000; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:337
msgctxt "text_id=8007 | speaker=alice"
msgid "\"...Indeed. Provided he refrains from angering us, that is, he has a chance of survival.\""
msgstr "「……そうね。わたしたちを怒らせなければ、そういう可能性もあるわね」"

#. Occurrence 6_6:362:8008: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0001; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:362
msgctxt "text_id=8008 | speaker=soujuurou"
msgid "\"Yup, this is already off on the wrong foot.\""
msgstr "「よし、いきなり話が食い違ってる」"

#. Occurrence 6_6:367:8009: scene=6_6
#: 6_6:367
msgctxt "text_id=8009 | speaker=unknown"
msgid "  Soujyuro's head dropped, like he knew what was coming."
msgstr "　<予|う><想|ん><通|う><り|ん>、とうなずく草十郎と、"

#. Occurrence 6_6:403:8010: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0005; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:403
msgctxt "text_id=8010 | speaker=aoko"
msgid "\"That's enough, Alice."
msgstr "「ちょっと黙ってて有珠。"

#. Occurrence 6_6:419:8011: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0006; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:419
msgctxt "text_id=8011 | speaker=aoko"
msgid "And you, shut up.\""
msgstr "あとアンタも黙ってろ」"

#. Occurrence 6_6:424:8012: scene=6_6
#: 6_6:424
msgctxt "text_id=8012 | speaker=unknown"
msgid "  She scowled at the two of them, already at her wits' end."
msgstr "　そんなふたりを睨みつける、気苦労の多い青子。"

#. Occurrence 6_6:469:8013: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0007; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:469
msgctxt "text_id=8013 | speaker=aoko"
msgid "\"As I was saying..."
msgstr "「……話を続けるけど。"

#. Occurrence 6_6:481:8014: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0008; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:481
msgctxt "text_id=8014 | speaker=aoko"
msgid "  Having you live with us for the sake of confidentiality means other problems are bound to come up."
msgstr "　秘密保持のためにアンタを住まわせる場合、二次災害はどうしても避けられない。"

#. Occurrence 6_6:487:8015: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0009; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:487
msgctxt "text_id=8015 | speaker=aoko"
msgid "  You'll likely be exposed to even more of our secrets. That's what has Alice so bent out of shape.\""
msgstr "　同じ家にいる以上、余計に秘密を見せる事になるからね。有珠はそれがイヤなんだろうけど」"

#. Occurrence 6_6:519:8016: scene=6_6
#: 6_6:519
msgctxt "text_id=8016 | speaker=unknown"
msgid "  Now that Aoko mentioned it, Soujyuro could see her point."
msgstr "　言われてみればその通りだ。"

#. Occurrence 6_6:524:8017: scene=6_6
#: 6_6:524
msgctxt "text_id=8017 | speaker=unknown"
msgid "  With their target of observation under house arrest, the disclosure of more confidential information was inevitable."
msgstr "　監視対象を軟禁した場合、更なる内部事情の<露呈|ろてい>は避けられない。"

#. Occurrence 6_6:561:8018: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0002; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:561
msgctxt "text_id=8018 | speaker=soujuurou"
msgid "\"Hold on a second. Doesn't that make me being here a little counterproductive?\""
msgstr "「ちょっと待ってくれ。どうどう巡りじゃないか、それ？」"

#. Occurrence 6_6:567:8019: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0010; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:567
msgctxt "text_id=8019 | speaker=aoko"
msgid "\"It's not a problem. In the end, we'll just have you forget everything about us, and about living here at all.\""
msgstr "「大丈夫、問題ないわ。だって、最後にはここで暮らした記憶ごと、私たちの事を忘れてもらう事にしたから」"

#. Occurrence 6_6:589:8020: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0003; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:589
msgctxt "text_id=8020 | speaker=soujuurou"
msgid "\"...Have me forget?\""
msgstr "「―――忘れてもらう？」"

#. Occurrence 6_6:610:8021: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0011; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:610
msgctxt "text_id=8021 | speaker=aoko"
msgid "\"Right. From the incident in the park onward, you'll forget everything."
msgstr "「そ。公園での一件からまるごと全部、忘れてもらう。"

#. Occurrence 6_6:616:8022: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0012; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:616
msgctxt "text_id=8022 | speaker=aoko"
msgid "  There's a kind of magecraft called 'runes' that has the power to make one forget memories."
msgstr "　ルーンっていう魔術系統があるんだけどね、その中でサクッと記憶を忘れさせる物があるのよ。"

#. Occurrence 6_6:622:8023: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0013; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:622
msgctxt "text_id=8023 | speaker=aoko"
msgid "  It's a bit inhumane, but erasing memories seems a bit better than, well, erasing your life.\""
msgstr "　非人道的であるのは変わらないけど、ま、命を消すかわりに記憶を消すって事で妥協して」"

#. Occurrence 6_6:649:8024: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0004; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:649
msgctxt "text_id=8024 | speaker=soujuurou"
msgid "\"...Do I get a say in―\""
msgstr "「――――蒼崎、それは」"

#. Occurrence 6_6:674:8025: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0014; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:674
msgctxt "text_id=8025 | speaker=aoko"
msgid "\"Sorry, but no objections."
msgstr "「悪いけど反論は却下。"

#. Occurrence 6_6:680:8026: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0015; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:680
msgctxt "text_id=8026 | speaker=aoko"
msgid "  Anyway, an amnesia rune is outside of our field of expertise, so it's going to take some time for us to find the rune and learn everything about it."
msgstr "　で、肝心の<忘却|ぼうきゃく>のルーンなんだけど。私も有珠も専門外だから、文献を探して修得するのに時間がかかる。"

#. Occurrence 6_6:686:8027: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0016; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:686
msgctxt "text_id=8027 | speaker=aoko"
msgid "  In other words, that's when you get to leave."
msgstr "　つまり、それが監視の期限ってワケ。"

#. Occurrence 6_6:692:8028: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0017; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:692
msgctxt "text_id=8028 | speaker=aoko"
msgid "  Until we find this rune, we're using your life as collateral so you keep your mouth shut.\""
msgstr "　私たちが忘却のルーンを見つけるまで、命を担保に口を閉じていてもらうわ」"

#. Occurrence 6_6:719:8029: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0018; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:719
msgctxt "text_id=8029 | speaker=aoko"
msgid "\"Alice's idea is that we destroy your five senses and be done with you to avoid the extra effort."
msgstr "「有珠はそんなややこしい事はせずに、五感全部壊してしまおうなんて言ってるけど。"

#. Occurrence 6_6:732:8030: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0019; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:732
msgctxt "text_id=8030 | speaker=aoko"
msgid "  So, Sizuki? What do you say? Fancy becoming a living statue?\""
msgstr "　―――静希君、<彫像生活|リビングスタチュー>とか嫌でしょ？」"

#. Occurrence 6_6:769:8031: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0005; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:769
msgctxt "text_id=8031 | speaker=soujuurou"
msgid "\"Hmm.\""
msgstr "「む」"

#. Occurrence 6_6:774:8032: scene=6_6
#: 6_6:774
msgctxt "text_id=8032 | speaker=unknown"
msgid "  Soujyuro only understood about eighty percent of what Aoko had explained, and the last part about a living statue had gone straight over his head."
msgstr "　青子の言っている事は八割納得できる草十郎だったが、最後のリビングスタチュー、という単語はあまりにも意味不明だった。"

#. Occurrence 6_6:779:8033: scene=6_6
#: 6_6:779
msgctxt "text_id=8033 | speaker=unknown"
msgid "  He had tried his best to visualize what Aoko was going on about, but the only thing he could conjure in his mind was an image of the mascot creature Kitsy."
msgstr "　できるかぎり想像力を働かせるも、こう、キッツィーちゃんばりのクリーチャーしか想像できない。"

#. Occurrence 6_6:800:8034: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0006; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:800
msgctxt "text_id=8034 | speaker=soujuurou"
msgid "\"Yeah, I'd rather not.\""
msgstr "「うん。それは、たしかにイヤだな」"

#. Occurrence 6_6:824:8035: scene=6_6
#: 6_6:824
msgctxt "text_id=8035 | speaker=unknown"
msgid "  Aoko agreed with the bewildered Soujyuro, neither one the wiser to the other's misinterpretation."
msgstr "　難しい顔で頷く草十郎に、青子もでしょう、と同意する。二人の<齟齬|そご>はとても深い。"

#. Occurrence 6_6:864:8036: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0020; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:864
msgctxt "text_id=8036 | speaker=aoko"
msgid "\"Anyway, at most it will probably take about a month to find this amnesia rune, and another two to put it to use."
msgstr "「とにかく、遅くても一ヶ月で“忘却のルーン”は見つけだせるだろうし、一回きりの実行ならプラス二ヶ月ぐらいでなんとかなるわ。"

#. Occurrence 6_6:870:8037: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0021; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:870
msgctxt "text_id=8037 | speaker=aoko"
msgid "  Until then, that means you'll be living with us. However, we can't just let you wander around without a clue what's going on. That's a surefire way to get yourself killed.\""
msgstr "　それまで<草十郎|アンタ>にはここで暮らしてもらうワケだけど……私たちについて無知なまま歩き回られると、命の保証はできないのよ」"

#. Occurrence 6_6:891:8038: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0022; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:891
msgctxt "text_id=8038 | speaker=aoko"
msgid "\"I doubt you would be comfortable being left in the dark about us, either. So starting now, I'm going to fill you in on what it's like to be a modern magician."
msgstr "「そっちもこっちの事情を知らないのは気持ち悪いだろうし。なんで、今から簡潔に、現代の魔法使いのなんたるかを教えてあげる。"

#. Occurrence 6_6:897:8039: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0023; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:897
msgctxt "text_id=8039 | speaker=aoko"
msgid "  At the very least, it'll hopefully prevent any more misunderstandings.\""
msgstr "　それで少しは私たちへの勘違いもなくなるだろうし」"

#. Occurrence 6_6:926:8040: scene=6_6
#: 6_6:926
msgctxt "text_id=8040 | speaker=unknown"
msgid "  Not that she thought this country bumpkin had any idea of old or new anyway. The thought brought a smug grin to her lips."
msgstr "　ま、この山奥育ちに現代も過去もないだろうけど、と青子は自分の台詞に苦笑いをこぼした。"

#. Occurrence 6_6:957:8041: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0024; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:957
msgctxt "text_id=8041 | speaker=aoko"
msgid "\"Let's leave a tour of the mansion for later, and start with who and what mages are."
msgstr "「洋館のことは後にして、まずは<魔術師|わたしたち>の立場についてね。"

#. Occurrence 6_6:963:8042: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0025; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:963
msgctxt "text_id=8042 | speaker=aoko"
msgid "  And don't worry―you don't need to understand everything right away."
msgstr "　あ、でも一から百まで理解する必要はないから。"

#. Occurrence 6_6:969:8043: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0026; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:969
msgctxt "text_id=8043 | speaker=aoko"
msgid "  You're an outsider, after all, so just bite off only what you can chew.\""
msgstr "　どうせ門外漢なんだし、感じ入った事だけしっかり噛みしめておきなさい」"

#. Occurrence 6_6:1003:8044: scene=6_6
#: 6_6:1003
msgctxt "text_id=8044 | speaker=unknown"
msgid "  Soujyuro nodded obediently to Aoko's professorial instructions."
msgstr "　教師めいた言葉に、草十郎は素直に頷いた。"

#. Occurrence 6_6:1008:8045: scene=6_6
#: 6_6:1008
msgctxt "text_id=8045 | speaker=unknown"
msgid "  This was Aoko's way of telling him not to ask questions when he did not understand something."
msgstr "　要するに、理解できない事は聞き返さなくていい、と青子は言ったのだ。"

#. Occurrence 6_6:1013:8046: scene=6_6
#: 6_6:1013
msgctxt "text_id=8046 | speaker=unknown"
msgid "  And though Soujyuro had taken issue with her statement, he meekly obeyed knowing better than to object now."
msgstr "　その発言自体に納得のいかない草十郎だったが、聞き返すのはダメらしいので素直に従った。"

#. Occurrence 6_6:1052:8047: scene=6_6
#: 6_6:1052
msgctxt "text_id=8047 | speaker=unknown"
msgid "  Aoko nodded approvingly at his attentiveness, and started her lecture."
msgstr "　よろしい、と頷いて、青子は話をはじめる。"

#. Occurrence 6_6:1057:8048: scene=6_6
#: 6_6:1057
msgctxt "text_id=8048 | speaker=unknown"
msgid "  Her long, long lecture."
msgstr "　長く、それは長くなる話を。"

#. Occurrence 6_6:1092:8049: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0027; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1092
msgctxt "text_id=8049 | speaker=aoko"
msgid "\"Let's start with mages-magicians, basically."
msgstr "「まず魔術師、魔法使いの話からね。"

#. Occurrence 6_6:1098:8050: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0028; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1098
msgctxt "text_id=8050 | speaker=aoko"
msgid "  Since it doesn't concern you, I'll skip the part about how magecraft and Magic are not the same. All you need to remember is that they are two different things."
msgstr "　<魔|・><術|・>と<魔|・><法|・>の違いは草十郎には関わりのない話だからしないけど、それぞれ別種の物だと思ってくれればいいわ。"

#. Occurrence 6_6:1113:8051: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0029; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1113
msgctxt "text_id=8051 | speaker=aoko"
msgid "  Mages, as an absolute rule, must operate in secrecy."
msgstr "　で、魔術師の事だけど、これは絶対条件として隠された存在でなくてはならないの。"

#. Occurrence 6_6:1119:8052: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0030; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1119
msgctxt "text_id=8052 | speaker=aoko"
msgid "  Naturally, mages will find out about other mages, so it's only a crime if an outsider like you finds out about one of us. A crime punishable by death, I should add.\""
msgstr "　<魔術師|どうぎょうしゃ>に知られるのは仕方ないとしても、貴方みたいに関わりのない人間に知られるのは罪にあたる。ほとんど死罪クラスのね」"

#. Occurrence 6_6:1140:8053: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0031; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1140
msgctxt "text_id=8053 | speaker=aoko"
msgid "\"The reason being, that the more magecraft is exposed, the weaker it becomes."
msgstr "「何故かって言うと、魔術ってのは隠されていないと力が薄れてしまうものだから。"

#. Occurrence 6_6:1146:8054: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0032; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1146
msgctxt "text_id=8054 | speaker=aoko"
msgid "  You'll often hear us say 'Mystic' or 'mystery,' which come from a Greek word that means 'to shut the mouth.' It follows that magecraft would cease to be if its secrets were revealed."
msgstr "　神秘の語源は閉ざす、というギリシャ語だけど、魔術は限られた密儀でなければ魔術でなくなってしまう。"

#. Occurrence 6_6:1152:8055: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0033; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1152
msgctxt "text_id=8055 | speaker=aoko"
msgid "  Civilization has always treated the unexplored and the unknown as things to be feared because of their mysterious nature.\""
msgstr "　文明にとって、未知なるモノ、未開なる<場所|モノ>は<拓|ひら>かれていないからこそ恐怖に値するのと同じね」"

#. Occurrence 6_6:1196:8056: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0034; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1196
msgctxt "text_id=8056 | speaker=aoko"
msgid "\"But we don't hide ourselves because we fear persecution if we're discovered."
msgstr "「知られたら迫害されるから隠す、じゃないの。"

#. Occurrence 6_6:1202:8057: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0035; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1202
msgctxt "text_id=8057 | speaker=aoko"
msgid "  What we fear is the loss of the unknown itself."
msgstr "　未知でなくなった魔術師……というより魔術ね。"

#. Occurrence 6_6:1208:8058: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0036; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1208
msgctxt "text_id=8058 | speaker=aoko"
msgid "  When our arts are revealed, they become weaker. So by protecting our secrecy, we're also protecting our own future.\""
msgstr "　明かされた魔術は力を弱めてしまう。だから<隠匿|いんとく>するのよ。何より、<魔術師|わたしたち>の未来のために」"

#. Occurrence 6_6:1247:8059: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0007; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:1247
msgctxt "text_id=8059 | speaker=soujuurou"
msgid "\"...I'm not clear on how magecraft works yet, but I think what you're saying is that if you don't keep it a secret, it gets weaker."
msgstr "「……魔術の仕組みはよく分からないけど、とにかく自分だけの秘密でないと弱くなるって事か。"

#. Occurrence 6_6:1259:8060: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0008; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:1259
msgctxt "text_id=8060 | speaker=soujuurou"
msgid "  So then, does that mean you got weaker now that I saw you, Aozaki?\""
msgstr "　じゃあ蒼崎も弱くなってるのか？　俺が見ちゃったから」"

#. Occurrence 6_6:1293:8061: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0037; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1293
msgctxt "text_id=8061 | speaker=aoko"
msgid "\"No, not particularly."
msgstr "「いいえ、別に。"

#. Occurrence 6_6:1305:8062: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0038; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1305
msgctxt "text_id=8062 | speaker=aoko"
msgid "  ...Let me explain in a little more detail."
msgstr "　……ここからはちょっと込みいった話でね。"

#. Occurrence 6_6:1311:8063: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0039; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1311
msgctxt "text_id=8063 | speaker=aoko"
msgid "  When I say it loses power, I mean magecraft as a whole will get weaker in the future. I'm not talking about individuals."
msgstr "　弱くなる、っていうのはあくまで全体、それも随分と未来の話。個人単位では関係のない話よ。"

#. Occurrence 6_6:1323:8064: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0040; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1323
msgctxt "text_id=8064 | speaker=aoko"
msgid "  The unwritten law that 'Thou shalt conceal thyself' was an adage from a bygone age, but at some point it became a law of the highest order.\""
msgstr "　汝、<隠匿|いんとく>すべし―――って不文律は、この大本の仕組みが<形骸|けいがい>化して、いつのまにか絶対のルールになっているだけなの」"

#. Occurrence 6_6:1365:8065: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0041; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1365
msgctxt "text_id=8065 | speaker=aoko"
msgid "\"It's like laws in a civilized society: we like to think that it's human nature to punish crime and immorality, but ultimately a structural solution is needed to maintain order."
msgstr "「文明社会の法律と一緒よ。犯罪、不道徳を罰するのは人間的であろうとする意識の高さと、それとはまったく別の、全体の仕組みを守るための構造的な結論でしょ。"

#. Occurrence 6_6:1371:8066: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0042; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1371
msgctxt "text_id=8066 | speaker=aoko"
msgid "  If crimes were left unpunished, the society we strived so hard to build would collapse."
msgstr "　犯罪が罰せられるのは、野放しにしたらせっかく築いた社会がうまく機能しなくなるから。"

#. Occurrence 6_6:1377:8067: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0043; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1377
msgctxt "text_id=8067 | speaker=aoko"
msgid "  And what we mages consider to be a crime is dissemination and vulgarization of the Mystic. Merely immoral things like murder, well... those are a matter of perspective, and they generally aren't considered outright crimes.\""
msgstr "　で、<魔|わ><術|た><師|し>たちにとって犯罪にあたるのは神秘の一般化、低俗化であって、不道徳とか殺人とかは―――ま、それぞれの良心次第ってコトで、基本的に罪にもならない」"

#. Occurrence 6_6:1420:8068: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0044; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1420
msgctxt "text_id=8068 | speaker=aoko"
msgid "\"The good-for-nothing bunch responsible for imposing this law is a group called the Mage's Association. Think of them as a labor union."
msgstr "そんなろくでもない連中にルールを敷いたのが、魔術協会っていう集まり。組合みたいなものよ。"

#. Occurrence 6_6:1426:8069: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0045; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1426
msgctxt "text_id=8069 | speaker=aoko"
msgid "The phrase 'Make eternal the mysticism of magecraft' is nothing more than a rule they created to perpetuate magecraft itself.\""
msgstr "“魔術を不朽の神秘とせよ”……というのは、魔術を魔術として永続させるために敷いたルールにすぎないわ」"

#. Occurrence 6_6:1464:8070: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0046; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1464
msgctxt "text_id=8070 | speaker=aoko"
msgid "\"Nevertheless, the rule is absolute."
msgstr "「けど、その原則は絶対でさ。"

#. Occurrence 6_6:1470:8071: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0047; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1470
msgctxt "text_id=8071 | speaker=aoko"
msgid "  Those who violate it cease to exist in the magical world."
msgstr "　これを破った者は、魔術世界には居られなくなる。"

#. Occurrence 6_6:1476:8072: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0048; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1476
msgctxt "text_id=8072 | speaker=aoko"
msgid "  Or rather, it would be difficult for them to go on living at all."
msgstr "　いえ、実際問題として、<生|・><き|・><て|・><い|・><く|・><の|・><が|・><困|・><難|・><に|・><な|・><る|・>。"

#. Occurrence 6_6:1519:8073: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0049; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1519
msgctxt "text_id=8073 | speaker=aoko"
msgid "  For us, that's our...well, our life as mages, I guess."
msgstr "　私たちは私たちの……まあ、魔術師としての命？"

#. Occurrence 6_6:1525:8074: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0050; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1525
msgctxt "text_id=8074 | speaker=aoko"
msgid "  In order to protect it, we had no choice but to erase you, the witness to our magecraft.\""
msgstr "　そういうのを守るために、目撃者であるアンタを消さなくちゃいけなかった」"

#. Occurrence 6_6:1560:8075: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0009; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:1560
msgctxt "text_id=8075 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 6_6:1579:8076: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0051; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1579
msgctxt "text_id=8076 | speaker=aoko"
msgid "\"Don't give me those puppy-dog eyes. Just because you know a little about our lives doesn't mean we're not fessing up to what happened at the amusement park."
msgstr "「そこ、同情とかしなくていいから。私たちの事情を知ったぐらいで、遊園地のことを帳消しにしないでよ。"

#. Occurrence 6_6:1585:8077: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0052; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1585
msgctxt "text_id=8077 | speaker=aoko"
msgid "  It was our decision to try and kill you. It wasn't anyone else's fault."
msgstr "　私たちは私たちの判断でアンタを殺そうとしたんだから、誰彼のせいってワケじゃない。"

#. Occurrence 6_6:1598:8078: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0053; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1598
msgctxt "text_id=8078 | speaker=aoko"
msgid "  So if you're going to blame anyone, blame me.\""
msgstr "　恨むなら、きちんと私を恨んでちょうだい」"

#. Occurrence 6_6:1637:8079: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0054; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1637
msgctxt "text_id=8079 | speaker=aoko"
msgid "\"Okay, back to the topic."
msgstr "「ま、それはともかく。"

#. Occurrence 6_6:1643:8080: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0055; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1643
msgctxt "text_id=8080 | speaker=aoko"
msgid "  In the past, mages were recognized in society enough for it to be considered an occupation, but they took their own magecraft with them to their graves."
msgstr "　過去、魔術師は職業として成りたったぐらい社会に認知されていたけど、その魔術自体は墓まで持っていく秘密だった。"

#. Occurrence 6_6:1650:8081: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0056; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1650
msgctxt "text_id=8081 | speaker=aoko"
msgid "I don't know what led to things getting so twisted, but even the profession itself has to be kept secret these days."
msgstr "それがどう<歪|ゆが>んだかは知らないけど、現代ではその職業すら秘密にしなくてはならなくなった。"

#. Occurrence 6_6:1656:8082: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0057; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1656
msgctxt "text_id=8082 | speaker=aoko"
msgid "  If they didn't go that far, the Association feared that in the distant future, magecraft would be used up and the Association would fall apart.\""
msgstr "　そこまでしないと、遠い未来、魔術すら消費するだけのものに解体されると協会は恐れたのよ」"

#. Occurrence 6_6:1677:8083: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0058; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1677
msgctxt "text_id=8083 | speaker=aoko"
msgid "\"We had reached a point where everything became explainable through human knowledge, from the building blocks of nature to the fabric of the cosmos, once considered to be the realm of the gods."
msgstr "「自然界の仕組みも、かつて天上の領域だった宇宙の運営すら、私たちは人智で解き明かせるほどになった。"

#. Occurrence 6_6:1683:8084: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0059; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1683
msgctxt "text_id=8084 | speaker=aoko"
msgid "  Maybe the founders believed that magecraft would become the last bastion for the unknown, for Mystics-that which is beyond human reach."
msgstr "　人の手にあまるもの。神秘という未知の領域にとって、魔術が最後の砦になると協会の設立者は信じたのかもしれない。"

#. Occurrence 6_6:1689:8085: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0060; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1689
msgctxt "text_id=8085 | speaker=aoko"
msgid "  Or maybe, they thought that in the long run magecraft would eventually become meaningless.\""
msgstr "　それとも、魔術なんてもう意味がないって達観したのかもね」"

#. Occurrence 6_6:1736:8086: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0061; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1736
msgctxt "text_id=8086 | speaker=aoko"
msgid "\"Whatever the reason, mages hid their identities and passed on their individual rituals in secret. And since they couldn't pass it on to outsiders, it was only natural that they taught it to their descendants."
msgstr "「そんなわけで、魔術師はその正体を隠して各々の秘儀を伝えていった。他人に教えるワケにはいかないから、必然的にその伝承者は子孫になる。"

#. Occurrence 6_6:1742:8087: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0062; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1742
msgctxt "text_id=8087 | speaker=aoko"
msgid "  Alice and I are both products of generations of lineage."
msgstr "　私も有珠も、そうやって何代か続いた連中の<末|すえ>なのよ。"

#. Occurrence 6_6:1748:8088: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0063; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1748
msgctxt "text_id=8088 | speaker=aoko"
msgid "  The Mage's Association I mentioned earlier is a vast organization that governs those magecraft wielders still dedicated to their field. Mages think of them as their ruling body.\""
msgstr "　さっき言った魔術協会っていうのは、そんな細々と続いてる連中を束ねる一大組織。魔術師にとって司法の神ってところかしらね」"

#. Occurrence 6_6:1769:8089: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0064; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1769
msgctxt "text_id=8089 | speaker=aoko"
msgid "\"The Association is actually made up of a bunch of factions, and the vast majority of mages are affiliated with the London chapter."
msgstr "「協会も色んな派閥に分かれるんだけど、大抵の魔術師はロンドンの魔術協会に属している。"

#. Occurrence 6_6:1769:8090: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0064; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1769
msgctxt "text_id=8090 | speaker=aoko"
msgid "  The law to conceal ourselves was one of their three main principles."
msgstr "　汝隠匿すべしっていうのも協会の三大原則の一つよ。"

#. Occurrence 6_6:1775:8091: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0065; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1775
msgctxt "text_id=8091 | speaker=aoko"
msgid "  If a mage reveals their secret to a civilian, the Association is quick to make an example of them."
msgstr "　魔術師が一般人に秘密を漏らすと協会から罰が下される仕組みになっている。"

#. Occurrence 6_6:1781:8092: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0066; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1781
msgctxt "text_id=8092 | speaker=aoko"
msgid "  But even if the mage doesn't get punished, the witness should still be eliminated to protect the mage and their family's magecraft.\""
msgstr "　ま、そんな罰なんかなくても、自分と血族が伝えた魔術のために、目撃者は消さないといけないんだけど」"

#. Occurrence 6_6:1829:8093: scene=6_6
#: 6_6:1829
msgctxt "text_id=8093 | speaker=unknown"
msgid "  And that was the end of the first part of the lecture. Aoko paused for a moment."
msgstr "　まずはここまで、と青子は話を区切る。"

#. Occurrence 6_6:1834:8094: scene=6_6
#: 6_6:1834
msgctxt "text_id=8094 | speaker=unknown"
msgid "  Soujyuro was doing his best to process the information."
msgstr "　草十郎は草十郎なりに話をまとめているようだ。"

#. Occurrence 6_6:1867:8095: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0067; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1867
msgctxt "text_id=8095 | speaker=aoko"
msgid "\"Ready to move on?\""
msgstr "「次いくけど、いい？」"

#. Occurrence 6_6:1887:8096: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0010; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:1887
msgctxt "text_id=8096 | speaker=soujuurou"
msgid "\"Sure, but let me see if I understand so far:"
msgstr "「いいけど、その前に確認したい。"

#. Occurrence 6_6:1899:8097: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0011; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:1899
msgctxt "text_id=8097 | speaker=soujuurou"
msgid "  Mages used to hide their identities not for their own sake, but for the sake of magecraft. Now, they're more concerned with hiding themselves."
msgstr "　魔術師が正体を隠すのは自分のためじゃなく魔術のためだったけど、最近では自分の正体を隠すことの方が重要になっている。"

#. Occurrence 6_6:1906:8098: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0012; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:1906
msgctxt "text_id=8098 | speaker=soujuurou"
msgid "And if you break the rules, you'll be punished by a place called the Association."
msgstr "そして、その決まりを破ると協会というところからお<咎|とが>めがくる。"

#. Occurrence 6_6:1918:8099: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0013; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:1918
msgctxt "text_id=8099 | speaker=soujuurou"
msgid "  ...Does that mean that you two are members of the Association?\""
msgstr "　……つまり、蒼崎たちもその協会に入っているのか？」"

#. Occurrence 6_6:1958:8100: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0068; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1958
msgctxt "text_id=8100 | speaker=aoko"
msgid "\"No, we're freelance, though we walk in similar circles."
msgstr "「いいえ、私たちはフリーよ。いちおう協会と繋がりはあるけどね。"

#. Occurrence 6_6:1965:8101: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0069; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1965
msgctxt "text_id=8101 | speaker=aoko"
msgid "They're simply the largest organized group. Even though no one asked them to, they've taken it upon themselves to police the world of magecraft."
msgstr "単純に、協会は最大勢力ってだけ。連中は頼まれもしないのに魔術世界全体の秩序を守ってるの。"

#. Occurrence 6_6:1971:8102: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0070; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1971
msgctxt "text_id=8102 | speaker=aoko"
msgid "  So no matter how unaffiliated we are as mages, if we break the rules we'll get punished anyway.\""
msgstr "　だから私たちが何であれ、彼らとの関わりがないにしても、魔術師としての決まりを破ったら罰しにくるわ」"

#. Occurrence 6_6:2006:8103: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0014; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2006
msgctxt "text_id=8103 | speaker=soujuurou"
msgid "\"...Okay. I think I got the gist of it.\""
msgstr "「……分かった。だいたい呑みこめた」"

#. Occurrence 6_6:2012:8104: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0071; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2012
msgctxt "text_id=8104 | speaker=aoko"
msgid "\"It's all right. Just focus on the parts important to you."
msgstr "「よしよし。そうやって自分に必要な部分だけ手に入れなさい。"

#. Occurrence 6_6:2018:8105: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0072; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2018
msgctxt "text_id=8105 | speaker=aoko"
msgid "  Next is magecraft. Though... I've barely learned enough to talk about it, myself.\""
msgstr "　じゃ、次は魔術について。……といっても、私自身、語れるほど学んでいないんだけどね」"

#. Occurrence 6_6:2024:8106: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0015; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2024
msgctxt "text_id=8106 | speaker=soujuurou"
msgid "\"?\""
msgstr "「？」"

#. Occurrence 6_6:2047:8107: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0073; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2047
msgctxt "text_id=8107 | speaker=aoko"
msgid "\"Sorry, forget I said that."
msgstr "「ごめん、こっちの話だから忘れて。"

#. Occurrence 6_6:2053:8108: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0074; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2053
msgctxt "text_id=8108 | speaker=aoko"
msgid "  ...I touched on this already, but these days, magecraft is losing its meaning."
msgstr "　―――さっきも言ったけど、現代において魔術は無意味な物になりつつある。"

#. Occurrence 6_6:2059:8109: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0075; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2059
msgctxt "text_id=8109 | speaker=aoko"
msgid "  If you created fire a long time ago when there were no lighters, that was enough to count as a Mystic feat. But nowadays, life is awfully convenient, right? You of all people can appreciate that.\""
msgstr "　ライターのない大昔なら火を起こせればそれは<神秘|まじゅつ>として成り立つわ。けど<現代|いま>は何かと便利でしょう？　貴方ならよく分かると思うけど」"

#. Occurrence 6_6:2105:8110: scene=6_6
#: 6_6:2105
msgctxt "text_id=8110 | speaker=unknown"
msgid "  Soujyuro nodded with a glum look on his face."
msgstr "　青子の問いかけに、草十郎はまあ、と浮かない顔で同意した。"

#. Occurrence 6_6:2110:8111: scene=6_6
#: 6_6:2110
msgctxt "text_id=8111 | speaker=unknown"
msgid "  He had been made painfully aware of such conveniences."
msgstr "　草十郎も、その便利さを痛いほど実感している。"

#. Occurrence 6_6:2115:8112: scene=6_6
#: 6_6:2115
msgctxt "text_id=8112 | speaker=unknown"
msgid "  Difficult tasks that would occupy an entire day of work in the mountains, could be performed easily here."
msgstr "　山では一日かける大仕事が、ここでは簡単に出来てしまう。"

#. Occurrence 6_6:2121:8113: scene=6_6
#: 6_6:2121
msgctxt "text_id=8113 | speaker=unknown"
msgid "For him, having been brought up in the mountains without electricity or running water, city life was by definition magic."
msgstr "電気も水道もない世界で育った彼にしてみれば、都会の生活そのものが魔法だ。"

#. Occurrence 6_6:2126:8114: scene=6_6
#: 6_6:2126
msgctxt "text_id=8114 | speaker=unknown"
msgid "  He only wished it would not be such backbreaking work to adapt to said conveniences."
msgstr "　この便利さが常識なのだと順応するのに、どれだけ苦労したことか。"

#. Occurrence 6_6:2153:8115: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0016; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2153
msgctxt "text_id=8115 | speaker=soujuurou"
msgid "\"Oh."
msgstr "「あ。"

#. Occurrence 6_6:2160:8116: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0017; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2160
msgctxt "text_id=8116 | speaker=soujuurou"
msgid "I do think that creating fire without tools should be a god's job, though.\""
msgstr "でも、道具を使わずに火を起こせるのは神さまの仕事だと思うけど」"

#. Occurrence 6_6:2185:8117: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0076; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2185
msgctxt "text_id=8117 | speaker=aoko"
msgid "\"Even though we've worked out how to do it more efficiently with a flamethrower?\""
msgstr "「そのために積み重ねた手間は、火炎放射器を手に入れるより面倒だとしても？」"

#. Occurrence 6_6:2213:8118: scene=6_6
#: 6_6:2213
msgctxt "text_id=8118 | speaker=unknown"
msgid "  Soujyuro wasn't sure how to answer Aoko."
msgstr "　青子の言葉に、草十郎は答えられない。"

#. Occurrence 6_6:2218:8119: scene=6_6
#: 6_6:2218
msgctxt "text_id=8119 | speaker=unknown"
msgid "  It would have been easy for him to ask Aoko how much accumulated effort she thought it had taken humans to imitate those gods, but he knew it would come across as an insult."
msgstr "　人間が神さまの真似事をする為にはどれだけの尽力があったのか、安易に答える事は彼女への侮辱だと思ったからだ。"

#. Occurrence 6_6:2256:8120: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0018; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2256
msgctxt "text_id=8120 | speaker=soujuurou"
msgid "\"...From what I just saw, I was under the impression that magecraft could do anything, but maybe I misunderstood.\""
msgstr "「……。さっきのを見るかぎり、魔術ってのはなんでも出来ると思ったけど、それは誤解なのか」"

#. Occurrence 6_6:2262:8121: scene=6_6
#: 6_6:2262
msgctxt "text_id=8121 | speaker=unknown"
msgid "  He glanced at the glass bottle on the table."
msgstr "　ちらり、とテーブルの上の小瓶に目をやる草十郎。"

#. Occurrence 6_6:2267:8122: scene=6_6
#: 6_6:2267
msgctxt "text_id=8122 | speaker=unknown"
msgid "  Mentally, he sighed in relief."
msgstr "　内心、それはそれでホッとできる。"

#. Occurrence 6_6:2272:8123: scene=6_6
#: 6_6:2272
msgctxt "text_id=8123 | speaker=unknown"
msgid "  He still had not come to terms with the fact that he had been trapped inside that tiny thing."
msgstr "　あんな小瓶の中に閉じこめられていたなんて、今でも現実だと信じられない。"

#. Occurrence 6_6:2315:8124: scene=6_6
#: 6_6:2315
msgctxt "text_id=8124 | speaker=unknown"
msgid "  However..."
msgstr "　―――しかし。"

#. Occurrence 6_6:2322:8125: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0077; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2322
msgctxt "text_id=8125 | speaker=aoko"
msgid "\"Oh, that's a misunderstanding all right."
msgstr "「あら、それこそ誤解よ。"

#. Occurrence 6_6:2322:8126: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0077; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2322
msgctxt "text_id=8126 | speaker=aoko"
msgid "  If magecraft wasn't all-powerful, why would anyone bother to learn it?\""
msgstr "　万能じゃなければ誰が魔術なんて学ぶと思ってるの？」"

#. Occurrence 6_6:2349:8127: scene=6_6
#: 6_6:2349
msgctxt "text_id=8127 | speaker=unknown"
msgid "  Aoko puffed out her chest as she chided him."
msgstr "　胸を張って青子は言い返した。"

#. Occurrence 6_6:2376:8128: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0078; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2376
msgctxt "text_id=8128 | speaker=aoko"
msgid "\"It might take some doing, but there's nothing magecraft can't do."
msgstr "「手間暇かかるけど、魔術に出来ない事はないわ。"

#. Occurrence 6_6:2382:8129: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0079; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2382
msgctxt "text_id=8129 | speaker=aoko"
msgid "  Granted, some users are able to trick you into thinking something's possible when it really isn't."
msgstr "　中には“出来ていないけど出来ているように見せる”みたいな、何らかのイカサマはあるけどね。"

#. Occurrence 6_6:2388:8130: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0080; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2388
msgctxt "text_id=8130 | speaker=aoko"
msgid "  But since we were born into this world, there's nothing that we can't do within its limits. Besides True Magic, of course, but we'll get into that some other time.\""
msgstr "　この世界に生まれた以上、その許容範囲で出来ない事なんてないの。そこで魔法がでてくるんだけど、それはまた改めて」"

#. Occurrence 6_6:2426:8131: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0081; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2426
msgctxt "text_id=8131 | speaker=aoko"
msgid "\"What I'm trying to say is that magecraft doesn't create miracles. It's only the process that's miraculous."
msgstr "「私が言いたかったのは、魔術は奇跡を起こしているのではなくて、その過程が奇跡だってこと。"

#. Occurrence 6_6:2432:8132: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0082; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2432
msgctxt "text_id=8132 | speaker=aoko"
msgid "  To produce a real miracle, you need True Magic.\""
msgstr "　結果が奇跡になるのは魔法の方なの」"

#. Occurrence 6_6:2459:8133: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0083; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2459
msgctxt "text_id=8133 | speaker=aoko"
msgid "\"A great mage is someone who can fly a passenger jet with only their own magecraft."
msgstr "「偉大な魔術師っていうのは、個人の魔術だけで旅客機飛ばしたりする人のこと。"

#. Occurrence 6_6:2465:8134: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0084; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2465
msgctxt "text_id=8134 | speaker=aoko"
msgid "  Meanwhile, a Magician deals in making the impossible possible."
msgstr "　対して、偉大な魔法使いっていうのは、<現|い><在|ま>不可能な事を可能にする人の事よ。"

#. Occurrence 6_6:2484:8135: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0085; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2484
msgctxt "text_id=8135 | speaker=aoko"
msgid "  ...Which is why we might just turn out to be the last Magicians.\""
msgstr "　……そういった意味じゃ、私たちは最後の魔法使いになるかも知れないけどね」"

#. Occurrence 6_6:2523:8136: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0001; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:2523
msgctxt "text_id=8136 | speaker=alice"
msgid "\"Focus, Aoko.\""
msgstr "「脱線してるわよ、青子」"

#. Occurrence 6_6:2529:8137: scene=6_6
#: 6_6:2529
msgctxt "text_id=8137 | speaker=unknown"
msgid "  Alice had been quietly listening until she muttered her rebuke,"
msgstr "　触れてはいけない一線に踏みこんだのか。"

#. Occurrence 6_6:2534:8138: scene=6_6
#: 6_6:2534
msgctxt "text_id=8138 | speaker=unknown"
msgid "  as if Aoko had crossed a line."
msgstr "　黙って聞いていた有珠が、<窘|たしな>めるように呟いた。"

#. Occurrence 6_6:2561:8139: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0002; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:2561
msgctxt "text_id=8139 | speaker=alice"
msgid "\"He doesn't need to know that."
msgstr "「……そこまで教える必要はないでしょう。"

#. Occurrence 6_6:2567:8140: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0003; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:2567
msgctxt "text_id=8140 | speaker=alice"
msgid "  Shouldn't we be educating Sizuki on the dangers of living with us?\""
msgstr "　静希君に教えるべき事は、わたしたちと暮らす上で危険になる事だけじゃなかった？」"

#. Occurrence 6_6:2612:8141: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0086; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2612
msgctxt "text_id=8141 | speaker=aoko"
msgid "\"Sorry. You're right. Slip of the tongue."
msgstr "「悪かったわ、ちょい口<滑|すべ>らせた。"

#. Occurrence 6_6:2624:8142: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0087; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2624
msgctxt "text_id=8142 | speaker=aoko"
msgid "  Anyway, mages spend every waking moment experimenting in magecraft, and would become devils in a heartbeat in order to protect their magecraft, by which I mean their family secrets.\""
msgstr "　ともかく、魔術師っていうのは暇さえあれば魔術の実験をしてる連中で―――自分の家系が伝えてきた秘儀を守るためなら鬼でも悪魔にでもなる」"

#. Occurrence 6_6:2651:8143: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0088; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2651
msgctxt "text_id=8143 | speaker=aoko"
msgid "\"Their lairs―which we call workshops―are like fortresses packed with all kinds of magical mechanisms."
msgstr "「必然、そのアジト……工房って言うんだけど、工房も魔術的な機構が積み重なって、要塞みたいになっちゃうのよ。"

#. Occurrence 6_6:2657:8144: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0089; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2657
msgctxt "text_id=8144 | speaker=aoko"
msgid "  Like traps that kill intruders before they even know what hit them. It's all to protect our secrets."
msgstr "　秘儀を守るために、入ってきた相手を問答無用で叩きのめす仕掛けとか。"

#. Occurrence 6_6:2669:8145: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0090; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2669
msgctxt "text_id=8145 | speaker=aoko"
msgid "  This mansion is no different."
msgstr "　この洋館も、そういった工房と同じなの。"

#. Occurrence 6_6:2675:8146: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0091; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2675
msgctxt "text_id=8146 | speaker=aoko"
msgid "  If you wind up trapped like you were before because you wandered around carelessly, even I won't be able to help you, so be careful of the dark. You might even find yourself stuck inside a mirror! ...Seriously, that can actually happen.\""
msgstr "　不用心に歩き回って、さっきみたいな事になったら私でも助けてあげられないから、暗闇には気をつけなさい。気が付いたら鏡の中にいる！とか本気であるから」"

#. Occurrence 6_6:2720:8147: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0019; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2720
msgctxt "text_id=8147 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 6_6:2726:8148: scene=6_6
#: 6_6:2726
msgctxt "text_id=8148 | speaker=unknown"
msgid "  Soujyuro so hoped they would provide him with a general idea of what to watch out for, but he passed, knowing that he was unlikely to get a straight answer."
msgstr "　その気をつけ方を具体的に教えてくれないものか、と心底思う草十郎だが、口にしたところでいい返事はなさそうだった。"

#. Occurrence 6_6:2761:8149: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0092; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2761
msgctxt "text_id=8149 | speaker=aoko"
msgid "\"That was a lot to take in in one go, but my point is: keep your nose out of where it doesn't belong."
msgstr "「枝葉から入っちゃったけど、要は私たちのプライベートに関わるなってコト。"

#. Occurrence 6_6:2767:8150: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0093; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2767
msgctxt "text_id=8150 | speaker=aoko"
msgid "  Even though we're going to erase your memory in the end, there are still things that we'd have to kill you for seeing.\""
msgstr "　いくら最後には記憶を消すっていっても、それを<見|・><ら|・><れ|・><た|・><段|・><階|・><で|・><消|・><す|・><し|・><か|・><な|・><い|・>ものもあるから」"

#. Occurrence 6_6:2799:8151: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0020; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2799
msgctxt "text_id=8151 | speaker=soujuurou"
msgid "\"...Got it. The mansion has rules I have to follow, I understand. Is there anything else I should...\""
msgstr "「……なるほど。この<館|なか>にもルールがある事はよく分かった。他に注意すべきコトは―――」"

#. Occurrence 6_6:2813:8152: scene=6_6
#: 6_6:2813
msgctxt "text_id=8152 | speaker=unknown"
msgid "  His eyes wandered as he trailed off mid-sentence, pondering."
msgstr "　言いかけて、はてな、と草十郎は視線を泳がす。"

#. Occurrence 6_6:2818:8153: scene=6_6
#: 6_6:2818
msgctxt "text_id=8153 | speaker=unknown"
msgid "  He understood that the mansion was more dangerous than outside, and that magecraft needed to stay secret."
msgstr "　館の方が危ない、とか、魔術は隠すものだ、とか。"

#. Occurrence 6_6:2823:8154: scene=6_6
#: 6_6:2823
msgctxt "text_id=8154 | speaker=unknown"
msgid "  But the explanation seemed to contradict his current problem."
msgstr "　その説明は彼がこうなった原因と矛盾する。"

#. Occurrence 6_6:2829:8155: scene=6_6
#: 6_6:2829
msgctxt "text_id=8155 | speaker=unknown"
msgid "For starters, how had he managed to witness something that they took such pains to keep hidden?"
msgstr "そもそも、そこまでして隠すものを、どうして草十郎は目の当たりにする事になったのか。"

#. Occurrence 6_6:2856:8156: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0021; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2856
msgctxt "text_id=8156 | speaker=soujuurou"
msgid "\"I'm sorry, it just occurred to me."
msgstr "「すまない。話の腰を折るんだけど、いいかな。"

#. Occurrence 6_6:2862:8157: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0022; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2862
msgctxt "text_id=8157 | speaker=soujuurou"
msgid "  Mages are all united under the organization called the Association, right? If that's the case, why were you attacked by that puppet, Aozaki?"
msgstr "　魔術師は協会という組織で結ばれてるんだろう？　なら、どうして蒼崎はあんな人形に襲われたんだ？"

#. Occurrence 6_6:2887:8158: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0023; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2887
msgctxt "text_id=8158 | speaker=soujuurou"
msgid "  If its master was a mage, wouldn't that mean that you were fighting an ally? Am I missing something here?\""
msgstr "　あれの持ち主が魔術師なら、君たちは味方同士で争っている事になる。なにか、説明が不足していないか？」"

#. Occurrence 6_6:2947:8159: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0094; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2947
msgctxt "text_id=8159 | speaker=aoko"
msgid "\"...I was saving that for last."
msgstr "「……それは最後にしようと思ってたのよ。"

#. Occurrence 6_6:2958:8160: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0095; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2958
msgctxt "text_id=8160 | speaker=aoko"
msgid "  Normally, this would be the point in the story where you'd say I made it all up or laugh it off."
msgstr "　普通はここまでの話だけで<眉唾|まゆつば>ものっていうか、笑い飛ばすっていうか。"

#. Occurrence 6_6:2970:8161: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0096; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2970
msgctxt "text_id=8161 | speaker=aoko"
msgid "  Even if you've experienced it, the existence of magecraft shouldn't be something you accept so easily...\""
msgstr "　いくら経験済みだからって、魔術なんて<存在|モン>をあっさり受け入れるなんて出来ないって言うか―――」"

#. Occurrence 6_6:3010:8162: scene=6_6
#: 6_6:3010
msgctxt "text_id=8162 | speaker=unknown"
msgid "  Aoko scratched her head as though troubled by how Soujyuro could take every word at face value."
msgstr "　すっかり自分の話を信じこんでいる草十郎に対して、青子は困ったように頬をかく。"

#. Occurrence 6_6:3015:8163: scene=6_6
#: 6_6:3015
msgctxt "text_id=8163 | speaker=unknown"
msgid "  Across from her, Alice's face betrayed no expression, but she shared the same opinion."
msgstr "　向かい合った有珠も、表情にこそ出ていないが同意見のようだ。"

#. Occurrence 6_6:3060:8164: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0024; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:3060
msgctxt "text_id=8164 | speaker=soujuurou"
msgid "\"Is that so weird?\""
msgstr "「？　おかしいのか、それ？」"

#. Occurrence 6_6:3085:8165: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0097; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3085
msgctxt "text_id=8165 | speaker=aoko"
msgid "\"It's mega weird."
msgstr "「おかしいわよ。"

#. Occurrence 6_6:3085:8166: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0097; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3085
msgctxt "text_id=8166 | speaker=aoko"
msgid "  In fact, you've been weird from the get-go."
msgstr "　そもそも、あんたは第一ステップから変だった。"

#. Occurrence 6_6:3091:8167: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0098; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3091
msgctxt "text_id=8167 | speaker=aoko"
msgid "  A normal person would be shocked, scared, unwilling to accept our existence. Why do you of all people believe me when I say I'm a magician?\""
msgstr "　普通は驚いたり恐がったり無視したりするものなのに、どうして魔法使いだ、なんて言った私を信じたの？」"

#. Occurrence 6_6:3117:8168: scene=6_6
#: 6_6:3117
msgctxt "text_id=8168 | speaker=unknown"
msgid "  In retrospect, this question should have been posed at the house of mirrors."
msgstr "　思えば、それはミラーハウスで訊くべき問いだった。"

#. Occurrence 6_6:3122:8169: scene=6_6
#: 6_6:3122
msgctxt "text_id=8169 | speaker=unknown"
msgid "  Back then, though Soujyuro was surprised by seeing the phenomenon of magecraft for the first time, he showed no surprise or discomfort toward Aoko, the mage wielding it."
msgstr "　あの時、静希草十郎は見た事のない『魔術』という現象に驚いたのであって、それを使う青子自身に何の驚きも、不快感も表さなかったのだ。"

#. Occurrence 6_6:3186:8170: scene=6_6
#: 6_6:3186
msgctxt "text_id=8170 | speaker=unknown"
msgid "  Feeling the probing stares of the two girls―no, the two mages―made Soujyuro feel uneasy."
msgstr "　ふたりの少女―――いや、魔術師の疑惑の眼差しを一身に受けて、草十郎は困ってしまう。"

#. Occurrence 6_6:3191:8171: scene=6_6
#: 6_6:3191
msgctxt "text_id=8171 | speaker=unknown"
msgid "  From where he was standing, their suspicion was suspicious in and of itself."
msgstr "　彼にしてみれば、そんな疑問すら疑問なのだ。"

#. Occurrence 6_6:3234:8172: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0025; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:3234
msgctxt "text_id=8172 | speaker=soujuurou"
msgid "\"There's no reason at all, really. Up in the mountains, people just accept things as they are."
msgstr "「なんでも何もない。蒼崎。山ではね、有る物は有るのが当たり前なんだよ。"

#. Occurrence 6_6:3240:8173: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0026; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:3240
msgctxt "text_id=8173 | speaker=soujuurou"
msgid "  We don't deny something we see in front of us just because we don't have the knowledge to explain it."
msgstr "　理由をつけられるだけの知識がなかったからにしても、実際に見た物を信じない、なんて事はないんだ。"

#. Occurrence 6_6:3246:8174: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0027; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:3246
msgctxt "text_id=8174 | speaker=soujuurou"
msgid "  You said it yourself. Lighters and magic might as well be the same thing, right?\""
msgstr "　それに君も言ったろう。貴方にとっては魔法もライターも同じ物なんだろうって」"

#. Occurrence 6_6:3252:8175: scene=6_6
#: 6_6:3252
msgctxt "text_id=8175 | speaker=unknown"
msgid "  Thought they weren't really the same to him anymore, he added quietly before shutting up."
msgstr "　いやまあ、今では違うけど、と付け足して草十郎は言葉をきった。"

#. Occurrence 6_6:3284:8176: scene=6_6
#: 6_6:3284
msgctxt "text_id=8176 | speaker=unknown"
msgid "  What he said about those innocent days in the mountains had come from the heart."
msgstr "　素朴だった山での日々を語った、本心からの言葉。"

#. Occurrence 6_6:3289:8177: scene=6_6
#: 6_6:3289
msgctxt "text_id=8177 | speaker=unknown"
msgid "  And the words resonated with not only Aoko Aozaki, but also Alice Kuonji."
msgstr "　それは蒼崎青子だけでなく、久遠寺有珠まで<得心|とくしん>させる響きがあった。"

#. Occurrence 6_6:3313:8178: scene=6_6
#: 6_6:3313
msgctxt "text_id=8178 | speaker=unknown"
msgid "  It was something everyone should have―principles to stand by."
msgstr "　誰であれ持っているだろう、胸を張れる<矜持|きょうじ>。"

#. Occurrence 6_6:3318:8179: scene=6_6
#: 6_6:3318
msgctxt "text_id=8179 | speaker=unknown"
msgid "  Indeed, to this boy, those words were an unshakable truth."
msgstr "　きっとこの少年にとって、今の言葉こそが揺るぎのない真実だったのだ。"

#. Occurrence 6_6:3362:8180: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0099; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3362
msgctxt "text_id=8180 | speaker=aoko"
msgid "\"Some things are the way they are. I see what you're saying.\""
msgstr "「有るものは有る、か」"

#. Occurrence 6_6:3368:8181: scene=6_6
#: 6_6:3368
msgctxt "text_id=8181 | speaker=unknown"
msgid "  She was impressed, if only slightly."
msgstr "　ちょっとだけ感心する。"

#. Occurrence 6_6:3373:8182: scene=6_6
#: 6_6:3373
msgctxt "text_id=8182 | speaker=unknown"
msgid "  If this boy, no matter how much of an outlier he was, could accept the things around him, he would be able to get through this just fine."
msgstr "　この少年自体がどんなに異端でも、彼自身が周りの物をそんな風に受けとめているのなら、たしかに、いつだって自然に生きられるはずだ。"

#. Occurrence 6_6:3401:8183: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0100; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3401
msgctxt "text_id=8183 | speaker=aoko"
msgid "\"That's a good way of explaining it, Soujyuro."
msgstr "「そうね。草十郎はそうなのよね。"

#. Occurrence 6_6:3407:8184: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0101; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3407
msgctxt "text_id=8184 | speaker=aoko"
msgid "  I guess the fault's with us for not believing you sincerely.\""
msgstr "　簡単に信じてもらえるコトが信じられない、なんて、私たちの方がどうかしてたわ」"

#. Occurrence 6_6:3419:8185: scene=6_6
#: 6_6:3419
msgctxt "text_id=8185 | speaker=unknown"
msgid "  Much like when Aoko met Soujyuro for the first time..."
msgstr "　……たとえば、初めて出逢った時のように。"

#. Occurrence 6_6:3424:8186: scene=6_6
#: 6_6:3424
msgctxt "text_id=8186 | speaker=unknown"
msgid "  In that classroom on his first day, Soujyuro took everything that was happening in his stride. The memory brought a bitter smile to Aoko's face."
msgstr "　あの教室でも、この少年は全ての出来事を<是|よし>と受けとめていたんだと、少女は懐かしく苦笑した。"

#. Occurrence 6_6:3506:8187: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0102; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3506
msgctxt "text_id=8187 | speaker=aoko"
msgid "\"All right, let's get back on track."
msgstr "「じゃ、気を取り直してっと……"

#. Occurrence 6_6:3512:8188: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0103; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3512
msgctxt "text_id=8188 | speaker=aoko"
msgid "  To your earlier question, for various reasons, there are mages that don't belong to the Association at all."
msgstr "　草十郎の疑問だけどね。魔術師も色々あって、協会に属していない連中もいるの。"

#. Occurrence 6_6:3519:8189: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0104; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3519
msgctxt "text_id=8189 | speaker=aoko"
msgid "They do as they please behind the Association's back and fight other mages for their personal gain. That puppet's master is one of those types.\""
msgstr "こういった連中は協会の目を盗んでやりたい放題で、利益目的で他の魔術師にケンカを売ってくる。あの人形の持ち主もその<類|たぐい>」"

#. Occurrence 6_6:3560:8190: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0105; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3560
msgctxt "text_id=8190 | speaker=aoko"
msgid "\"To those jerkwads, we're a convenient, easy target."
msgstr "「そんな連中にとって、私たちは都合のいい、格好のカモなのよ。"

#. Occurrence 6_6:3567:8191: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0106; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3567
msgctxt "text_id=8191 | speaker=aoko"
msgid "But just because we have an arrangement with the Association doesn't mean we're one of them. It's not like they'll come to save the day if we're at risk of being killed.\""
msgstr "私たちは協会と協定関係にあるだけで門下ってワケじゃないから。私たちが殺されたところで、協会は助けてくれないしね」"

#. Occurrence 6_6:3603:8192: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0028; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:3603
msgctxt "text_id=8192 | speaker=soujuurou"
msgid "\"But aren't mages forbidden from using magecraft?\""
msgstr "「？　でも、魔術師が魔術を使うのは禁じてるんだろ？」"

#. Occurrence 6_6:3628:8193: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0107; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3628
msgctxt "text_id=8193 | speaker=aoko"
msgid "\"As long as it's not in public, the Association turns a blind eye."
msgstr "「それが<公|おおやけ>にならないのなら、協会は目をつむるわ。"

#. Occurrence 6_6:3634:8194: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0108; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3634
msgctxt "text_id=8194 | speaker=aoko"
msgid "  Heck, they practically encourage fights between mages, as long as it's kept a secret. Like if we don't use it, we'll get rusty or something."
msgstr "　むしろ、バレなければ魔術師同士の争いを<奨励|しょうれい>してるぐらいよ。技術も使わないと<錆|さ>びるってね。"

#. Occurrence 6_6:3640:8195: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0109; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3640
msgctxt "text_id=8195 | speaker=aoko"
msgid "  ...Anyway, the attacks on us are a different story and have to do with the fact that we own land.\""
msgstr "　……まあ。私たちが襲われてるのはそれとは別の話で、たんに土地を持ってるからなんだけど」"

#. Occurrence 6_6:3681:8196: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0029; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:3681
msgctxt "text_id=8196 | speaker=soujuurou"
msgid "\"...By land, you mean this house?\""
msgstr "「……土地って、この家？」"

#. Occurrence 6_6:3694:8197: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0110; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3694
msgctxt "text_id=8197 | speaker=aoko"
msgid "\"Oh, please. Just this house? Alice and I hold the rights to the entirety of Misaki City. We're administrators of the whole region.\""
msgstr "「まさか。この三咲市一帯の管理地の権利を持ってるのよ、私と有珠は」"

#. Occurrence 6_6:3785:8198: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0030; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:3785
msgctxt "text_id=8198 | speaker=soujuurou"
msgid "\"Administrators? You own... all the land in Misaki?!\""
msgstr "「管理地って、つまり土地の利権―――！？」"

#. Occurrence 6_6:3848:8199: scene=6_6
#: 6_6:3848
msgctxt "text_id=8199 | speaker=unknown"
msgid "  Dazzled, Soujyuro looked away."
msgstr "　眩しい、と目を<背|そむ>ける草十郎。"

#. Occurrence 6_6:3853:8200: scene=6_6
#: 6_6:3853
msgctxt "text_id=8200 | speaker=unknown"
msgid "  He was sure he could see a halo of light around Aoko."
msgstr "　いま、彼が見ている青子には確実に<後光|ごこう>が差している。"

#. Occurrence 6_6:3858:8201: scene=6_6
#: 6_6:3858
msgctxt "text_id=8201 | speaker=unknown"
msgid "  He had only been renting an apartment for two weeks, but he was already aware of how magnificent the prospect of owning land in the city might be."
msgstr "　貸しアパート生活いまだ二週間の草十郎だが、都会において土地の権利がいかに偉大なものか、ほんと身をもって知っていたからだ。"

#. Occurrence 6_6:3908:8202: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0031; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:3908
msgctxt "text_id=8202 | speaker=soujuurou"
msgid "\"You're r-r-r...\""
msgstr "「お……おお……」"

#. Occurrence 6_6:3914:8203: scene=6_6
#: 6_6:3914
msgctxt "text_id=8203 | speaker=unknown"
msgid "  The word Soujyuro was trying to articulate was \"rich.\""
msgstr "　お金、持ちだ―――！"

#. Occurrence 6_6:3919:8204: scene=6_6
#: 6_6:3919
msgctxt "text_id=8204 | speaker=unknown"
msgid "  He shook all over with an emotion he did not fully grasp."
msgstr "　などと、草十郎はよく分からない感動でワナワナ震えている。"

#. Occurrence 6_6:3954:8205: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0111; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3954
msgctxt "text_id=8205 | speaker=aoko"
msgid "\"...Hold it, you're thinking about this all wrong."
msgstr "「……悪いけど、そういうんじゃないから。"

#. Occurrence 6_6:3960:8206: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0112; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3960
msgctxt "text_id=8206 | speaker=aoko"
msgid "  When we say land, we're talking about the ownership and control of spiritual grounds, as mages."
msgstr "　私たちで土地って言ったら、魔術師としての霊地の所有権、支配権のコトを言うの。"

#. Occurrence 6_6:3972:8207: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0113; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3972
msgctxt "text_id=8207 | speaker=aoko"
msgid "  The Aozaki family might be a minor player, but we've got old roots here as mages, which is why Misaki falls under our jurisdiction.\""
msgstr "　<蒼崎|うち>はマイナーだけど古くからこのあたりに根を下ろしてた魔術師で、三咲町もうちの管理下ってワケ」"

#. Occurrence 6_6:4005:8208: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0114; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4005
msgctxt "text_id=8208 | speaker=aoko"
msgid "\"When I say we administer the land, I'm talking about a place where spiritual power is distorted and gathers easily. This type of land has always been valuable, and it's vital to the experimentation and practice of magecraft."
msgstr "「管理地って言うのはね、霊的な力が<歪|ゆが>んで、集まりやすい土地のコト。そういう土地は昔から貴重で、魔術の実践、実験には不可欠でもある。"

#. Occurrence 6_6:4011:8209: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0115; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4011
msgctxt "text_id=8209 | speaker=aoko"
msgid "  After all, the three pillars of what makes a successful mages are a strong workshop, lots of disciples, and fertile spiritual grounds."
msgstr "　成功への絶対条件は優れた霊地、堅固な工房、多くの弟子たちってね。"

#. Occurrence 6_6:4017:8210: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0116; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4017
msgctxt "text_id=8210 | speaker=aoko"
msgid "  To us, owning administered land and a residence to live in are number one on the priority list.\""
msgstr "　魔術師たちにとって、土地つき館つきの住み家を持つのは一つの野望なんだから」"

#. Occurrence 6_6:4056:8211: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0033; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:4056
msgctxt "text_id=8211 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 6_6:4061:8212: scene=6_6
#: 6_6:4061
msgctxt "text_id=8212 | speaker=unknown"
msgid "  Soujyuro let her continue while wondering exactly who these two girls were to have achieved both ambitions already."
msgstr "　その野望を二つも叶えている青子たちは何様なんだろう、と思いつつ草十郎は先を<促|うなが>した。"

#. Occurrence 6_6:4105:8213: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0117; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4105
msgctxt "text_id=8213 | speaker=aoko"
msgid "\"However, most sacred grounds have already been claimed by the Association. There's nothing left for anyone else."
msgstr "「でも、その管理地は大部分が協会に仕切られてて、もう余っている土地はないの。"

#. Occurrence 6_6:4111:8214: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0118; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4111
msgctxt "text_id=8214 | speaker=aoko"
msgid "  Rogue and landless mages have no choice but to borrow land from the organization in exchange for a monthly donation. They're basically worker bees, slaving away for the top dogs of the Association.\""
msgstr "　はぐれ魔術師や土地のない魔術師は、協会に毎月寄付金を納めて土地を借りるしかない。ま、ていよく協会のお偉いさんたちに尽くす働きバチってところね」"

#. Occurrence 6_6:4145:8215: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0119; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4145
msgctxt "text_id=8215 | speaker=aoko"
msgid "\"But this land here, it's been in my family for hundreds of years, so the Association can't get their grubby hands on it."
msgstr "「でも、ここの土地は何百年も前から蒼崎の物だから協会とは関係がないの。"

#. Occurrence 6_6:4151:8216: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0120; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4151
msgctxt "text_id=8216 | speaker=aoko"
msgid "  Do you understand what I'm saying, Soujyuro?"
msgstr "　ここまで言えば分かるでしょ？"

#. Occurrence 6_6:4157:8217: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0121; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4157
msgctxt "text_id=8217 | speaker=aoko"
msgid "  To rogue mages, our land is the juiciest fruit there is.\""
msgstr "　そういったフリーの連中からすれば、私たちの管理地はこの上ないご馳走なんだって」"

#. Occurrence 6_6:4177:8218: scene=6_6
#: 6_6:4177
msgctxt "text_id=8218 | speaker=unknown"
msgid "  Soujyuro nodded to himself, unsure whether to call the conversation mundane or outright disturbing."
msgstr "　……物騒なんだか所帯染みているのか微妙な話になってきたな、と内心うなずく草十郎。"

#. Occurrence 6_6:4197:8219: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0034; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:4197
msgctxt "text_id=8219 | speaker=soujuurou"
msgid "\"I get it."
msgstr "「よく分かった。"

#. Occurrence 6_6:4197:8220: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0034; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:4197
msgctxt "text_id=8220 | speaker=soujuurou"
msgid "So you're basically fighting over the land.\""
msgstr "　蒼崎たちは土地の奪い合いをしているんだな？」"

#. Occurrence 6_6:4231:8221: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0122; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4231
msgctxt "text_id=8221 | speaker=aoko"
msgid "\"Pretty much."
msgstr "「そういう事。"

#. Occurrence 6_6:4238:8222: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0123; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4238
msgctxt "text_id=8222 | speaker=aoko"
msgid "But because the administered land of Misaki is so minor, its challengers have all been third-rate."
msgstr "ただ三咲の管理地はマイナーのさらにマイナーだから、やってくる挑戦者も三流ばっかりよ。"

#. Occurrence 6_6:4244:8223: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0124; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4244
msgctxt "text_id=8223 | speaker=aoko"
msgid "  The enemy this time is probably some small fry thinking this place was low-hanging fruit. Though for now, we're on a ceasefire because of your intrusion.\""
msgstr "　今回の敵だって、どっかの三流魔術師がここなら楽に奪えると思ってやってきたんだろうし。ま、それもアンタの乱入で休戦してるんだけど」"

#. Occurrence 6_6:4286:8224: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0004; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4286
msgctxt "text_id=8224 | speaker=alice"
msgid "\"...That's enough about administered land, Aoko."
msgstr "「……管理地の話はそれで十分よ、青子。"

#. Occurrence 6_6:4299:8225: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0005; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4299
msgctxt "text_id=8225 | speaker=alice"
msgid "  Sizuki seems to understand the point that there are other mages out there apart from us."
msgstr "　静希君も、他に魔術師がいると分かってくれたようだし。"

#. Occurrence 6_6:4305:8226: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0006; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4305
msgctxt "text_id=8226 | speaker=alice"
msgid "  If any danger exists, it's more likely to arise as a result of him becoming involved in one of our battles.\""
msgstr "　危険があるとすれば、わたしたちの戦いに彼が巻きこまれる可能性だけど」"

#. Occurrence 6_6:4349:8227: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0125; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4349
msgctxt "text_id=8227 | speaker=aoko"
msgid "\"He'll be fine."
msgstr "「それは大丈夫でしょ。"

#. Occurrence 6_6:4355:8228: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0126; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4355
msgctxt "text_id=8228 | speaker=aoko"
msgid "  Besides, this guy has zero trace of magical energy, so there's no chance of him being sensed. Plus, he has less tactical value than a watchdog, so he shouldn't be a target anyway."
msgstr "　だってコイツ、魔力の欠片もないじゃない。魔力感知にはひっかからないし、番犬以下の人間は戦力って言わないから、狙われる事もないだろうし。"

#. Occurrence 6_6:4361:8229: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0127; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4361
msgctxt "text_id=8229 | speaker=aoko"
msgid "  We just have to make sure he doesn't escape before we can find the amnesia rune.\""
msgstr "　私たちはただ、忘却のルーンを見つけるまでコイツを逃がさなければいいだけでしょ」"

#. Occurrence 6_6:4402:8230: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0007; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4402
msgctxt "text_id=8230 | speaker=alice"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 6_6:4408:8231: scene=6_6
#: 6_6:4408
msgctxt "text_id=8231 | speaker=unknown"
msgid "  Alice silently stared her partner down."
msgstr "　有珠は無言で、相棒である少女を見つめる。"

#. Occurrence 6_6:4413:8232: scene=6_6
#: 6_6:4413
msgctxt "text_id=8232 | speaker=unknown"
msgid "  Their ideas of 'involving' Soujyuro differed greatly in both gravity and risk."
msgstr "　有珠の言う“巻きこまれる”と、青子の言う“巻きこまれる”は、その深刻さ、過酷さが違っていた。"

#. Occurrence 6_6:4454:8233: scene=6_6
#: 6_6:4454
msgctxt "text_id=8233 | speaker=unknown"
msgid "  Aoko's lack of experience had led her to believe that Soujyuro would not get directly involved in any fighting."
msgstr "　青子はその浅い経験から、彼が直接的な戦いには巻きこまれないと断じている。"

#. Occurrence 6_6:4459:8234: scene=6_6
#: 6_6:4459
msgctxt "text_id=8234 | speaker=unknown"
msgid "  It was an honest and rational thought."
msgstr "　清廉潔白で合理的。"

#. Occurrence 6_6:4465:8235: scene=6_6
#: 6_6:4465
msgctxt "text_id=8235 | speaker=unknown"
msgid "Aoko despised wasted action, so it was natural for her to expect the same frugality from her enemies."
msgstr "無駄を嫌う彼女は、敵にも同じ効率を求めてしまう節がある。"

#. Occurrence 6_6:4470:8236: scene=6_6
#: 6_6:4470
msgctxt "text_id=8236 | speaker=unknown"
msgid "  However, there were those in this world who could not tell right from wrong until it was too late."
msgstr "　だが―――世の中には、そも事を終えるまで、自らの正否を量れぬ者もいる。"

#. Occurrence 6_6:4519:8237: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0008; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4519
msgctxt "text_id=8237 | speaker=alice"
msgid "\"...No one knows what the future will bring."
msgstr "「…………先の事は誰にも分からないから。"

#. Occurrence 6_6:4525:8238: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0009; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4525
msgctxt "text_id=8238 | speaker=alice"
msgid "  I only hope that when the time comes, we won't regret this.\""
msgstr "　その時になって、後悔がなければいいけれど」"

#. Occurrence 6_6:4540:8239: scene=6_6
#: 6_6:4540
msgctxt "text_id=8239 | speaker=unknown"
msgid "  With a gloomy sigh, Alice came to her feet."
msgstr "　陰鬱なため息をついて、有珠は席を立った。"

#. Occurrence 6_6:4580:8240: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0128; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4580
msgctxt "text_id=8240 | speaker=aoko"
msgid "\"Ahem. I'm not done with the lecture yet. You don't think that was entirely for Sizuki's benefit, do you?"
msgstr "「ちょっと。何のために<長話|ながばなし>したと思ってるのよ。"

#. Occurrence 6_6:4586:8241: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0129; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4586
msgctxt "text_id=8241 | speaker=aoko"
msgid "  Your opinion matters the most, and we still haven't heard it yet.\""
msgstr "　いちばん重要なアンタの<同意|いけん>、聞いてないんですけど？」"

#. Occurrence 6_6:4609:8242: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0010; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4609
msgctxt "text_id=8242 | speaker=alice"
msgid "\"If you must stick to your plan, that's fine."
msgstr "「貴女が貴女の方針を守るというのなら、それでいいわ。"

#. Occurrence 6_6:4615:8243: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0011; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4615
msgctxt "text_id=8243 | speaker=alice"
msgid "  I'll stick to mine.\""
msgstr "　わたしも好きにするだけよ」"

#. Occurrence 6_6:4649:8244: scene=6_6
#: 6_6:4649
msgctxt "text_id=8244 | speaker=unknown"
msgid "  Alice glided soundlessly to the door."
msgstr "　音もなく扉に向かう有珠。"

#. Occurrence 6_6:4693:8245: scene=6_6
#: 6_6:4693
msgctxt "text_id=8245 | speaker=unknown"
msgid "  As the girl in black opened it, she paused, barely lit by the dim corridor."
msgstr "　黒衣の少女は扉を開け、薄暗い廊下の前で立ち止まった。"

#. Occurrence 6_6:4698:8246: scene=6_6
#: 6_6:4698
msgctxt "text_id=8246 | speaker=unknown"
msgid "  Then,"
msgstr "　同時に、"

#. Occurrence 6_6:4762:8247: scene=6_6
#: 6_6:4762
msgctxt "text_id=8247 | speaker=unknown"
msgid "  without warning..."
msgstr "　つい、と。"

#. Occurrence 6_6:4776:8248: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0035; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:4776
msgctxt "text_id=8248 | speaker=soujuurou"
msgid "\"?!\""
msgstr "「！？」"

#. Occurrence 6_6:4781:8249: scene=6_6
#: 6_6:4781
msgctxt "text_id=8249 | speaker=unknown"
msgid "  To the rhythm of her footsteps, the small glass bottle floated into the air and shattered, without mercy."
msgstr "　少女の足取りに合わせるよう、テーブルにあった小瓶が<宙|ちゅう>に浮き―――慈悲も<躊躇|ためら>いもなく、無惨に砕け散った。"

#. Occurrence 6_6:4913:8250: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0012; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4913
msgctxt "text_id=8250 | speaker=alice"
msgid "\"That is what I should have done earlier.\""
msgstr "「……あの時、こうしておけばよかった」"

#. Occurrence 6_6:4919:8251: scene=6_6
#: 6_6:4919
msgctxt "text_id=8251 | speaker=unknown"
msgid "  Her sharp tone made Soujyuro's face go pale."
msgstr "　さらりとした声に、顔面蒼白になる草十郎。"

#. Occurrence 6_6:4924:8252: scene=6_6
#: 6_6:4924
msgctxt "text_id=8252 | speaker=unknown"
msgid "  Alice's voice was so quiet, it was hard to tell if she was being serious or mocking him."
msgstr "　有珠の声は静かすぎて、本気なのか冗談なのかまったく読み取れない。"

#. Occurrence 6_6:4982:8253: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0013; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4982
msgctxt "text_id=8253 | speaker=alice"
msgid "\"I forgot to mention something.\""
msgstr "「わたしも言い忘れていたけど」"

#. Occurrence 6_6:4994:8254: scene=6_6
#: 6_6:4994
msgctxt "text_id=8254 | speaker=unknown"
msgid "  She icily eyed them before turning away,"
msgstr "　少女の横顔が、いっそう冷たく青子と草十郎を流し見る。"

#. Occurrence 6_6:4999:8255: scene=6_6
#: 6_6:4999
msgctxt "text_id=8255 | speaker=unknown"
msgid "  and in a voice even colder than her gaze, stated,"
msgstr "　洋館の主は、その表情よりなお冷たい声で、"

#. Occurrence 6_6:5026:8256: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0014; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:5026
msgctxt "text_id=8256 | speaker=alice"
msgid "\"I'm still not happy with this arrangement.\""
msgstr "「まだ、<認|みと>めていないから」"

#. Occurrence 6_6:5066:8257: scene=6_6
#: 6_6:5066
msgctxt "text_id=8257 | speaker=unknown"
msgid "  Her frigid departure seemed to forbode the many difficulties that lay ahead."
msgstr "　あまりにも前途多難な伝言を残していった。"

#. Occurrence 6_7:53:8258: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0000; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:53
msgctxt "text_id=8258 | speaker=aoko"
msgid "\"...She is *such* a sore loser.\""
msgstr "「……ったく、往生際が悪い」"

#. Occurrence 6_7:60:8259: scene=6_7
#: 6_7:60
msgctxt "text_id=8259 | speaker=unknown"
msgid "  Aoko leaned back on the sofa while hurling abusive epithets."
msgstr "　ソファーにもたれながら悪態をつく青子。"

#. Occurrence 6_7:65:8260: scene=6_7
#: 6_7:65
msgctxt "text_id=8260 | speaker=unknown"
msgid "  Her face looked even more irritated than usual."
msgstr "　不機嫌そうな顔は、普段よりイライラ度を増している。"

#. Occurrence 6_7:86:8261: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0001; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:86
msgctxt "text_id=8261 | speaker=aoko"
msgid "\"She says letting you go and letting you stay here are out of the question, but I don't see *her* coming up with any bright ideas."
msgstr "「見逃すのと<洋館|ここ>に住まわせるのは別問題よって、じゃあそれ以外にどんな方法があるってのよ。"

#. Occurrence 6_7:92:8262: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0002; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:92
msgctxt "text_id=8262 | speaker=aoko"
msgid "  She's as stubborn as a mule. I wouldn't put it past her to resort to violence to get her way.\""
msgstr "　……譲る気もなさそうだし。この分じゃ実力行使に出るかもね、あの<娘|こ>」"

#. Occurrence 6_7:125:8263: scene=6_7
#: 6_7:125
msgctxt "text_id=8263 | speaker=unknown"
msgid "  Soujyuro threw a wary glance at Aoko while she grumbled."
msgstr "　ぶつぶつと呟く青子に、草十郎は不審げな視線を送る。"

#. Occurrence 6_7:154:8264: scene=6_7
#: 6_7:154
msgctxt "text_id=8264 | speaker=unknown"
msgid "  He wondered what Alice's show of defiance meant, shattering the glass bottle like she did."
msgstr "　今の決意表明―――小瓶を粉々にする―――はどういう^事なのか、と。"

#. Occurrence 6_7:184:8265: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0003; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:184
msgctxt "text_id=8265 | speaker=aoko"
msgid "\"I thought I could convince her by including the backstop that we could erase your memory, but she's having none of it."
msgstr "「草十郎には“記憶を無くしてもらう”ってコトで話はつけたけど、心の底から納得してないってコトでしょ。"

#. Occurrence 6_7:190:8266: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0004; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:190
msgctxt "text_id=8266 | speaker=aoko"
msgid "  ...It's rare that Alice is even cognizant of other people, but maybe having you live here was a step too far for her."
msgstr "　……有珠にしちゃあ珍しく他人を意識してたけど、やっぱりここに住まわせるとなると難しいみたい。"

#. Occurrence 6_7:196:8267: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0005; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:196
msgctxt "text_id=8267 | speaker=aoko"
msgid "  She was fine while you were sleeping, but once she saw you awake, it must have roused her sadistic side.\""
msgstr "　寝てる分には良かったけど、起きてるアンタを見たらこう、<得|え>も言わぬ<嗜虐心|しぎゃくしん>を刺激されたとかさ」"

#. Occurrence 6_7:224:8268: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0006; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:224
msgctxt "text_id=8268 | speaker=aoko"
msgid "\"Watch your back, Soujyuro."
msgstr "「気をつけてね草十郎。"

#. Occurrence 6_7:230:8269: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0007; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:230
msgctxt "text_id=8269 | speaker=aoko"
msgid "  She just might come to finish you off.\""
msgstr "　あの娘、アンタを殺しにくるかもしれないから」"

#. Occurrence 6_7:236:8270: scene=6_7
#: 6_7:236
msgctxt "text_id=8270 | speaker=unknown"
msgid "  If anything, Aoko's warning was an indication that persuading Alice had hit a dead end."
msgstr "　などと忠告しつつ、青子自身、これ以上有珠を説得する気はなさそうだった。"

#. Occurrence 6_7:273:8271: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0000; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:273
msgctxt "text_id=8271 | speaker=soujuurou"
msgid "\"...Somehow, it doesn't seem like the situation has changed much from the other night, Aozaki.\""
msgstr "「……なんか、状況はあの夜からあまり変わってないようだね、蒼崎」"

#. Occurrence 6_7:279:8272: scene=6_7
#: 6_7:279
msgctxt "text_id=8272 | speaker=unknown"
msgid "  She shot him an unconcerned look in reply."
msgstr "　思わず呟いた一言に、青子はそう？　と軽く視線を返す。"

#. Occurrence 6_7:313:8273: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0001; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:313
msgctxt "text_id=8273 | speaker=soujuurou"
msgid "\"I mean it, really."
msgstr "「そう？　じゃないぞ。"

#. Occurrence 6_7:319:8274: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0002; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:319
msgctxt "text_id=8274 | speaker=soujuurou"
msgid "  That girl is just itching to finish what you started. The next time I make eye contact with her, I might not walk away alive."
msgstr "　蒼崎の次はあの娘がやる気満々じゃないか。さっきみたいな目にあったら逃げることもできない。"

#. Occurrence 6_7:325:8275: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0003; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:325
msgctxt "text_id=8275 | speaker=soujuurou"
msgid "  This must be what people call a cliffhanger.\""
msgstr "　こういうの、生殺しって言うんじゃないか？」"

#. Occurrence 6_7:365:8276: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0008; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:365
msgctxt "text_id=8276 | speaker=aoko"
msgid "\"I'll try to make sure that doesn't happen."
msgstr "「そうならないように努力するのね。"

#. Occurrence 6_7:371:8277: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0009; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:371
msgctxt "text_id=8277 | speaker=aoko"
msgid "  Besides, Alice isn't feeling as urgent as I was at the amusement park, so there's always a chance that she'll get over it by herself.\""
msgstr "　ま、有珠の理由は遊園地の時ほど切迫したものじゃないから、そのうち<諦|あきら>めてくれるとは思うんだけど」"

#. Occurrence 6_7:399:8278: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0004; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:399
msgctxt "text_id=8278 | speaker=soujuurou"
msgid "\"You mean her reason for wanting me dead is... different from yours?\""
msgstr "「蒼崎の時とは違う、有珠の理由……？」"

#. Occurrence 6_7:443:8279: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0010; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:443
msgctxt "text_id=8279 | speaker=aoko"
msgid "\"Yeah. That time at the park was because of our strict adherence to the secrecy law, but we've solved it for now. Even Alice understands how creepily earnest you are."
msgstr "「ええ。遊園地の時は秘密厳守のためだったけど、それは一応解決してる。アンタが底抜けに律儀なヤツだってのは、有珠だってもう分かってるし。"

#. Occurrence 6_7:449:8280: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0011; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:449
msgctxt "text_id=8280 | speaker=aoko"
msgid "  So she should have no reason left to worry about confidentiality. At this point, she probably just doesn't want you to live here, hence her desire to murder you.\""
msgstr "　なんで、秘密厳守云々であそこまで反対する理由はないの。あの娘は単にね、ここに住んでほしくないだけなのよ。それだけで、有珠はアンタを殺したがってる」"

#. Occurrence 6_7:500:8281: scene=6_7
#: 6_7:500
msgctxt "text_id=8281 | speaker=unknown"
msgid "  She said so matter-of-factly, her eyes cold and serious."
msgstr "　きっぱりと言う青子の目は真剣そのものだ。"

#. Occurrence 6_7:505:8282: scene=6_7
#: 6_7:505
msgctxt "text_id=8282 | speaker=unknown"
msgid "  Soujyuro had hoped for a trace of deceit or exaggeration, but alas."
msgstr "　そこには嘘も<誇張|こちょう>も影すらない。困った事に。"

#. Occurrence 6_7:538:8283: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0005; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:538
msgctxt "text_id=8283 | speaker=soujuurou"
msgid "\"I did get that impression from her."
msgstr "「たしかに、あの娘はそんな素振りだったけど。"

#. Occurrence 6_7:544:8284: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0006; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:544
msgctxt "text_id=8284 | speaker=soujuurou"
msgid "  ...But it's strange. If that's how she really feels, then surely we can find another solution.\""
msgstr "　……変だね、それならもっと他の手段をとればいいのに」"

#. Occurrence 6_7:550:8285: scene=6_7
#: 6_7:550
msgctxt "text_id=8285 | speaker=unknown"
msgid "  Perhaps feeling guilty about putting Alice out, Soujyuro looked uncharacteristically concerned."
msgstr "　有珠に申し訳ないものを感じているのか、柄にもなく深刻に悩む草十郎。"

#. Occurrence 6_7:555:8286: scene=6_7
#: 6_7:555
msgctxt "text_id=8286 | speaker=unknown"
msgid "  Aoko immediately knew what his words really meant."
msgstr "　その言葉の意味を、青子は瞬時に読み取った。"

#. Occurrence 6_7:599:8287: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0012; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:599
msgctxt "text_id=8287 | speaker=aoko"
msgid "\"You mean like keeping you locked up inside that tiny glass bottle until we find the magecraft needed to erase your memory?\""
msgstr "「例えば、記憶を消す魔術が見つかるまで、さっきの小瓶の中に閉じこめておくとか？」"

#. Occurrence 6_7:630:8288: scene=6_7
#: 6_7:630
msgctxt "text_id=8288 | speaker=unknown"
msgid "  The apathy in her voice until now was gone."
msgstr "　青子の声に、先ほどまでの<気怠|けだる>さはない。"

#. Occurrence 6_7:647:8289: scene=6_7
#: 6_7:647
msgctxt "text_id=8289 | speaker=unknown"
msgid "  Soujyuro answered with a simple nod."
msgstr "　草十郎は頷きだけで答えた。"

#. Occurrence 6_7:652:8290: scene=6_7
#: 6_7:652
msgctxt "text_id=8290 | speaker=unknown"
msgid "  In truth, it was undoubtedly the easiest solution for all parties concerned."
msgstr "　事実、彼女たちにとってそれが最も<安易|イージー>な方法である事は間違いない。"

#. Occurrence 6_7:657:8291: scene=6_7
#: 6_7:657
msgctxt "text_id=8291 | speaker=unknown"
msgid "  However..."
msgstr "　だが、"

#. Occurrence 6_7:690:8292: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0013; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:690
msgctxt "text_id=8292 | speaker=aoko"
msgid "\"Soujyuro. I don't break promises. Remember that.\""
msgstr "「草十郎。私、約束は破らないの。覚えておいて」"

#. Occurrence 6_7:696:8293: scene=6_7
#: 6_7:696
msgctxt "text_id=8293 | speaker=unknown"
msgid "  She hated taking the easy way out, "
msgstr "　その安易さを、彼女は嫌った。"

#. Occurrence 6_7:701:8294: scene=6_7
#: 6_7:701
msgctxt "text_id=8294 | speaker=unknown"
msgid "  and that quiet fury was clear in her soft words."
msgstr "　静かな言葉にはかすかな怒りがある。"

#. Occurrence 6_7:706:8295: scene=6_7
#: 6_7:706
msgctxt "text_id=8295 | speaker=unknown"
msgid "  As for where that fury was directed, Soujyuro was acutely aware."
msgstr "　その怒りが何に対して向けられているのか、草十郎には痛いほどよく分かった。"

#. Occurrence 6_7:711:8296: scene=6_7
#: 6_7:711
msgctxt "text_id=8296 | speaker=unknown"
msgid "  The pain in his chest made him regret making her say those words."
msgstr "　胸の痛みは、彼女にそんな台詞を言わせてしまった後悔によるものだ。"

#. Occurrence 6_7:745:8297: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0007; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:745
msgctxt "text_id=8297 | speaker=soujuurou"
msgid "\"I'm sorry. I wasn't thinking.\""
msgstr "「すまない。考えが足りなかった」"

#. Occurrence 6_7:772:8298: scene=6_7
#: 6_7:772
msgctxt "text_id=8298 | speaker=unknown"
msgid "  His sudden apology caused her usual sullen expression to return."
msgstr "　草十郎の突然の謝罪に、青子はいつもの不機嫌そうな表情に戻る。"

#. Occurrence 6_7:777:8299: scene=6_7
#: 6_7:777
msgctxt "text_id=8299 | speaker=unknown"
msgid "  Aoko had not appreciated how angry she was, let alone the reason for it."
msgstr "　青子本人、自分が怒った理由はおろか、怒っていた事すら気付いていない。"

#. Occurrence 6_7:782:8300: scene=6_7
#: 6_7:782
msgctxt "text_id=8300 | speaker=unknown"
msgid "  To her, his apology had come out of nowhere."
msgstr "　そんな青子からすると、草十郎の謝罪はまさに寝耳に水だ。"

#. Occurrence 6_7:817:8301: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0014; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:817
msgctxt "text_id=8301 | speaker=aoko"
msgid "\"...I don't get you at all sometimes."
msgstr "「……アンタって、ほんと分かんないわね。"

#. Occurrence 6_7:817:8302: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0014; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:817
msgctxt "text_id=8302 | speaker=aoko"
msgid "  What are you apologizing for this time?\""
msgstr "　なんでそこで謝るのよ」"

#. Occurrence 6_7:822:8303: scene=6_7
#: 6_7:822
msgctxt "text_id=8303 | speaker=unknown"
msgid "  She stared at Soujyuro, unblinking."
msgstr "　青子はまじまじと草十郎を見る。"

#. Occurrence 6_7:844:8304: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0008; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:844
msgctxt "text_id=8304 | speaker=soujuurou"
msgid "\"Mmm? Oh... er... I'm not sure, myself."
msgstr "「？　……あれ、そうだな。自分でもよく分からない。"

msgctxt "text_id=8305 | speaker=unknown"
msgid "  I guess I just felt like I should.\""
msgstr "　たぶん、そういう気分になったからだろう」"

#. Occurrence 6_7:857:8306: scene=6_7
#: 6_7:857
msgctxt "text_id=8306 | speaker=unknown"
msgid "  Even in saying he was not sure, Soujyuro had answered honestly. Aoko was at a loss for words."
msgstr "　よく分からない、などと言いつつ、草十郎は真剣に返答する。青子は呆れて言葉もない。"

#. Occurrence 6_7:884:8307: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0009; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:884
msgctxt "text_id=8307 | speaker=soujuurou"
msgid "\"But, I get what you're trying to say, Aozaki."
msgstr "「ただ、蒼崎の言いたい事は分かった。"

#. Occurrence 6_7:890:8308: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0010; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:890
msgctxt "text_id=8308 | speaker=soujuurou"
msgid "  Keeping a promise is more about the process than the outcome.\""
msgstr "　約束を守るっていう事は、結果じゃなく、過程を守るって事なんだな」"

#. Occurrence 6_7:896:8309: scene=6_7
#: 6_7:896
msgctxt "text_id=8309 | speaker=unknown"
msgid "  He shot her a brazenly honest smile."
msgstr "　恥ずかしげもなくまっすぐに、草十郎は青子に笑いかけた。"

#. Occurrence 6_7:901:8310: scene=6_7
#: 6_7:901
msgctxt "text_id=8310 | speaker=unknown"
msgid "  That smiling face, filled with blissful ignorance, almost made her smile back instinctively."
msgstr "　純粋な嬉しさに満ちた笑顔は、思わず笑みを返したくなるほどだ。"

#. Occurrence 6_7:943:8311: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0015; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:943
msgctxt "text_id=8311 | speaker=aoko"
msgid "\"N-Now you get it. If life were only a means to an end, I couldn't live with myself.\""
msgstr "「あ、当たり前じゃない。オチだけ合っていればいいなんて、恥ずかしくてできないでしょ」"

#. Occurrence 6_7:949:8312: scene=6_7
#: 6_7:949
msgctxt "text_id=8312 | speaker=unknown"
msgid "  Aoko attempted to cover for her embarrassment with a quick retort."
msgstr "　照れたように顔を背けて、青子は小さく言い返す。"

#. Occurrence 6_7:954:8313: scene=6_7
#: 6_7:954
msgctxt "text_id=8313 | speaker=unknown"
msgid "  Though unintentional, having her true feelings exposed like that made Aoko a little uncomfortable."
msgstr "　不覚にも自分の本音を言い当てられ、少しだけくすぐったかったのだ。"

#. Occurrence 6_7:998:8314: scene=6_7
#: 6_7:998
msgctxt "text_id=8314 | speaker=unknown"
msgid "  Finding offense in something was second nature to Aoko. Being made to feel uncomfortable was not."
msgstr "　いつもなら不快なだけ。"

#. Occurrence 6_7:1003:8315: scene=6_7
#: 6_7:1003
msgctxt "text_id=8315 | speaker=unknown"
msgid "  Though far from being unhappy at the remark, she turned away from its speaker."
msgstr "　が、何故か今は嬉しくて、つい顔を背けてしまった。"

#. Occurrence 6_7:1008:8316: scene=6_7
#: 6_7:1008
msgctxt "text_id=8316 | speaker=unknown"
msgid "  To disguise her perceived shame, Aoko started up the conversation again."
msgstr "　そんな自分が余計にみっともなく、青子は誤魔化すように言葉を続ける。"

#. Occurrence 6_7:1050:8317: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0016; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1050
msgctxt "text_id=8317 | speaker=aoko"
msgid "\"If I say I'll let you go, you can be sure I'm going to do just that, regardless of how I feel."
msgstr "「貴方を見逃すって言うなら、気持ちの問題じゃなくて、ちゃんと状況もそうなるようにするのは当たり前なの。"

#. Occurrence 6_7:1056:8318: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0017; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1056
msgctxt "text_id=8318 | speaker=aoko"
msgid "  And if letting you live here is what it takes to keep my promise, I can take it, even if it means Alice and I butt heads."
msgstr "　草十郎をここに住まわせる事があの約束を守る事になるんなら、厄介な有珠だって言い伏せるわよ。"

#. Occurrence 6_7:1062:8319: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0018; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1062
msgctxt "text_id=8319 | speaker=aoko"
msgid "  ...Even if they're just idle threats, there's no way I would let her bottle you up forever.\""
msgstr "　……<脅|おど>かすだけならまだしも、ずっと瓶づけなんてさせられるワケないでしょう」"

#. Occurrence 6_7:1107:8320: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0011; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1107
msgctxt "text_id=8320 | speaker=soujuurou"
msgid "\"Thanks. Now I get why you've given up trying to persuade her―she won't be persuaded anymore."
msgstr "「そっか。蒼崎があの娘を説得しない素振りなのは、もうできるだけの説得をした後だからなのか。"

#. Occurrence 6_7:1120:8321: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0012; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1120
msgctxt "text_id=8321 | speaker=soujuurou"
msgid "  Oh, so that's why you called it cold war.\""
msgstr "　あ。それで彼女とは冷戦中なんだ」"

#. Occurrence 6_7:1149:8322: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0019; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1149
msgctxt "text_id=8322 | speaker=aoko"
msgid "\"...It's not as if I'm doing this for you. I'm just keeping my promise."
msgstr "「……別にアンタのためじゃないわ。私は私のために約束を守ってるだけだし。"

#. Occurrence 6_7:1155:8323: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0020; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1155
msgctxt "text_id=8323 | speaker=aoko"
msgid "  Like you said, I've done my part. Now it's your turn, Soujyuro-the ball's in your court.\""
msgstr "　お察しの通り、私のやるべき事はもう終わってるし？　あとは<草十郎|そっち>が努力する番だから、勝手にすれば？」"

#. Occurrence 6_7:1168:8324: scene=6_7
#: 6_7:1168
msgctxt "text_id=8324 | speaker=unknown"
msgid "  \"Huh?\" he replied, tilting his head."
msgstr "　言われて、はい？　と首をかしげる草十郎。"

#. Occurrence 6_7:1202:8325: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0021; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1202
msgctxt "text_id=8325 | speaker=aoko"
msgid "\"All right, listen up. I spent two entire days arguing and trying to convince Alice into agreeing to this co-habitation idea because, hello, I was the only one capable of doing it. But I've hit a dead end."
msgstr "「あのね。いい？　同居案をなんとか認めさせる事が出来るのは私だけだから、二日間ぶっ通しで有珠を言い伏せもした。けどそれ以上は無理。"

#. Occurrence 6_7:1208:8326: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0022; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1208
msgctxt "text_id=8326 | speaker=aoko"
msgid "  From now on, I'm taking a hands-off approach."
msgstr "　私、ここから先はノータッチだから。"

#. Occurrence 6_7:1214:8327: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0023; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1214
msgctxt "text_id=8327 | speaker=aoko"
msgid "  I'll protect you from Alice for the time being, but in the meantime you're the only one who can convince her to accept you, Soujyuro.\""
msgstr "　しばらくは有珠から守ってあげるけど、その間にあの子にアンタを認めさせる事は、アンタにしか出来ないんだからね、草十郎」"

#. Occurrence 6_7:1290:8328: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0013; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1290
msgctxt "text_id=8328 | speaker=soujuurou"
msgid "\"What?!\""
msgstr "「なんと！」"

#. Occurrence 6_7:1296:8329: scene=6_7
#: 6_7:1296
msgctxt "text_id=8329 | speaker=unknown"
msgid "  Soujyuro had not expected that at all."
msgstr "　そういう流れになるのか、と面食らう草十郎。"

#. Occurrence 6_7:1307:8330: scene=6_7
#: 6_7:1307
msgctxt "text_id=8330 | speaker=unknown"
msgid "  Alice Kuonji."
msgstr "　久遠寺有珠。"

#. Occurrence 6_7:1312:8331: scene=6_7
#: 6_7:1312
msgctxt "text_id=8331 | speaker=unknown"
msgid "  The girl in black who kept everyone at arm's length."
msgstr "　他人を寄せ付けない黒衣の少女。"

#. Occurrence 6_7:1317:8332: scene=6_7
#: 6_7:1317
msgctxt "text_id=8332 | speaker=unknown"
msgid "  If Aoko was a modern day mage in hiding, then Alice was a bona fide witch from the middle ages."
msgstr "　青子が現代に隠れ住む魔法使いなら、彼女は中世に実在した魔女さながらだ。"

#. Occurrence 6_7:1346:8333: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0014; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1346
msgctxt "text_id=8333 | speaker=soujuurou"
msgid "\"...Aozaki, you understand how difficult that will be, right?\""
msgstr "「……蒼崎。君、自分がどれだけ難しい事を言っているか分かってるか？」"

#. Occurrence 6_7:1371:8334: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0024; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1371
msgctxt "text_id=8334 | speaker=aoko"
msgid "\"Of course I do, and now you know how I feel.\""
msgstr "「そうね。私もこの件に関してだけは同情するわ」"

#. Occurrence 6_7:1412:8335: scene=6_7
#: 6_7:1412
msgctxt "text_id=8335 | speaker=unknown"
msgid "  Aoko stood up from the sofa."
msgstr "　青子はソファーから立ち上がる。"

#. Occurrence 6_7:1417:8336: scene=6_7
#: 6_7:1417
msgctxt "text_id=8336 | speaker=unknown"
msgid "  This was the end of the discussion, at least for now."
msgstr "　とりあえず話はここまでらしい。"

#. Occurrence 6_7:1455:8337: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0025; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1455
msgctxt "text_id=8337 | speaker=aoko"
msgid "\"So now you have an idea of what kind of people we are."
msgstr "「私たちがどんな人間かはおおよそ<判|わか>ったでしょ。"

#. Occurrence 6_7:1461:8338: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0026; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1461
msgctxt "text_id=8338 | speaker=aoko"
msgid "  The less involved you are in magecraft the better, so I'll spare you any further lectures."
msgstr "　魔術に関してはこれ以上立ち入らない方がアンタのためだから、説明はここまでね。"

#. Occurrence 6_7:1472:8339: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0027; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1472
msgctxt "text_id=8339 | speaker=aoko"
msgid "  The long and short of it is, you'll be living here for three months."
msgstr "　で、肝心の今後の方針だけど、三ヶ月間ここで暮らす。"

#. Occurrence 6_7:1478:8340: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0028; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1478
msgctxt "text_id=8340 | speaker=aoko"
msgid "  Your first objective... or first trial, if you like, is to somehow get Alice to accept you as her roommate.\""
msgstr "　当初の目標……というより最初の試練は、なんとか有珠に同居人として認めてもらう事」"

#. Occurrence 6_7:1524:8341: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0015; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1524
msgctxt "text_id=8341 | speaker=soujuurou"
msgid "\"A trial? You just called it a trial.\""
msgstr "「試練って言った。いま、そういうたぐいのコトを言った」"

#. Occurrence 6_7:1549:8342: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0029; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1549
msgctxt "text_id=8342 | speaker=aoko"
msgid "\"Sugarcoating it won't do you any favors."
msgstr "「誤魔化してもいいコトないでしょ、この手のコトは。"

#. Occurrence 6_7:1555:8343: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0030; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1555
msgctxt "text_id=8343 | speaker=aoko"
msgid "  After all, blow it and you're a dead man, remember?\""
msgstr "　うまくいかなきゃ<粉々|こなごな>なワケだし？」"

#. Occurrence 6_7:1576:8344: scene=6_7
#: 6_7:1576
msgctxt "text_id=8344 | speaker=unknown"
msgid "  With her cold-blooded remark, Aoko started walking toward the door."
msgstr "　血も涙もない発言をして、青子はドアへと歩きだす。"

#. Occurrence 6_7:1633:8345: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0031; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1633
msgctxt "text_id=8345 | speaker=aoko"
msgid "\"Oh, and one more thing."
msgstr "「あ、そうそう。"

#. Occurrence 6_7:1639:8346: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0032; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1639
msgctxt "text_id=8346 | speaker=aoko"
msgid "  About your room, it's up on the third floor. There's a set of stairs on the far side of the second floor hall, so use those. Also, this is not a dorm, so you're free to spend your time however you want."
msgstr "　草十郎の部屋だけど、三階に用意しといたから。二階のホールの裏側に階段があるから使って。ここは寮ってワケでもないし、時間は自由に使いなさい。"

#. Occurrence 6_7:1650:8347: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0033; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1650
msgctxt "text_id=8347 | speaker=aoko"
msgid "  But whatever you do, do not go into the west wing. I rent the east wing, so it should be relatively safe in comparison, but still, it's generally safer to not wander around."
msgstr "　ただし、西館にだけは入らないようにね。東館は私が借りてるから比較的安全だけど、それでも歩き回らない方が無難だわ。"

#. Occurrence 6_7:1657:8348: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0034; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1657
msgctxt "text_id=8348 | speaker=aoko"
msgid "In other words, the safest places for you are your room and the drawing room.\""
msgstr "ま、基本安全なのはアンタの部屋と<居間|ここ>だけよ」"

#. Occurrence 6_7:1695:8349: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0016; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1695
msgctxt "text_id=8349 | speaker=soujuurou"
msgid "\"W-Wait, is that really all you're going to tell me about the mansion?!"
msgstr "「な―――<館|なか>の説明って、まさかそれだけ！？"

#. Occurrence 6_7:1714:8350: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0017; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1714
msgctxt "text_id=8350 | speaker=soujuurou"
msgid "  Aozaki, that's messed up! That seems way more important to explain than magecraft!\""
msgstr "　蒼崎はいろいろおかしい、魔術なんかよりもっと大事な説明があると思う！」"

#. Occurrence 6_7:1720:8351: scene=6_7
#: 6_7:1720
msgctxt "text_id=8351 | speaker=unknown"
msgid "  He desperately called out to her as she began to leave the drawing room."
msgstr "　じゃあね、とばかりに居間から出ていこうとする青子を、草十郎は決死の面持ちで呼び止める。"

#. Occurrence 6_7:1749:8352: scene=6_7
#: 6_7:1749
msgctxt "text_id=8352 | speaker=unknown"
msgid "  Aoko could not help by pity Soujyuro."
msgstr "　そんな草十郎を、心底かったりー、と<憐|あわ>れむ青子。"

#. Occurrence 6_7:1786:8353: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0018; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1786
msgctxt "text_id=8353 | speaker=soujuurou"
msgid "\"Can't you at least show me around?\""
msgstr "「せめてほら、案内とか」"

#. Occurrence 6_7:1816:8354: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0035; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1816
msgctxt "text_id=8354 | speaker=aoko"
msgid "\"Sorry, but I'll have to pass. Showing a country bumpkin the lay of the land twice is plenty enough for me."
msgstr "「面倒なんでパス。お上りさんを案内するなんて二回もやれば十分よ。"

#. Occurrence 6_7:1822:8355: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0036; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1822
msgctxt "text_id=8355 | speaker=aoko"
msgid "  Plus, you just woke up. Why not take it easy in your room for the rest of the night?"
msgstr "　起きたばっかりだし、とりあえず今日は部屋で休んだら？"

#. Occurrence 6_7:1822:8356: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0036; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1822
msgctxt "text_id=8356 | speaker=aoko"
msgid "  I'll show you how to get to school in the morning.\""
msgstr "　朝になったら学校まで案内してあげるから」"

#. Occurrence 6_7:1849:8357: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0037; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1849
msgctxt "text_id=8357 | speaker=aoko"
msgid "\"It's not like I'm made of free time. My obligation to put up with you ends as soon as final exams are over."
msgstr "「もっとも、私もそう暇じゃなし、側についてあげられるのは期末試験が終わるまでってコトで。"

#. Occurrence 6_7:1855:8358: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0038; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1855
msgctxt "text_id=8358 | speaker=aoko"
msgid "  If you don't find some way to make nice with Alice, or find some way to blackmail her within a week, well, you know what that means.\""
msgstr "　一週間以内に有珠と仲良くなるなり、弱みを握るなりしないと、ま、アレよね」"

#. Occurrence 6_7:1903:8359: scene=6_7
#: 6_7:1903
msgctxt "text_id=8359 | speaker=unknown"
msgid "  With barely a wave of goodbye the student council tyrant walked out."
msgstr "　じゃあねー、と去っていく最終鬼畜会長。"

#. Occurrence 6_7:1937:8360: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0019; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1937
msgctxt "text_id=8360 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 6_7:1943:8361: scene=6_7
#: 6_7:1943
msgctxt "text_id=8361 | speaker=unknown"
msgid "  He unconsciously clenched the hand he had raised."
msgstr "　挙げた手を、思わずニギニギしてしまう。"

#. Occurrence 6_7:1953:8362: scene=6_7
#: 6_7:1953
msgctxt "text_id=8362 | speaker=unknown"
msgid "  Left all alone, he was at a complete loss."
msgstr "　ひとり残されて、本気で途方にくれる草十郎。"

#. Occurrence 6_7:1958:8363: scene=6_7
#: 6_7:1958
msgctxt "text_id=8363 | speaker=unknown"
msgid "  Then, as if to encourage him..."
msgstr "　そんな彼を励ますように、"

#. Occurrence 6_7:1996:8364: scene=6_7
#: 6_7:1996
msgctxt "text_id=8364 | speaker=unknown"
msgid "  Chirp chirp chirp."
msgstr "　チチチ、と。"

#. Occurrence 6_7:2001:8365: scene=6_7
#: 6_7:2001
msgctxt "text_id=8365 | speaker=unknown"
msgid "  With the sound of lightly fluttering wings, a blue robin appeared out of nowhere."
msgstr "　軽快な羽音と共に、いずこともなく現れる青い<駒鳥|コマドリ>。"

#. Occurrence 6_7:2053:8366: scene=6_7
#: 6_7:2053
msgctxt "text_id=8366 | speaker=unknown"
msgid "  The tiny, chubby bird innocently looked Soujyuro up and down."
msgstr "　でっぷりとした小鳥は無邪気そうな瞳を草十郎に向けている。"

#. Occurrence 6_7:2063:8367: scene=6_7
#: 6_7:2063
msgctxt "text_id=8367 | speaker=unknown"
msgid "  The blue robin, a bird said to bring happiness according to folklore, flapped its little wings as if to cheer him on."
msgstr "　俗説で言うところの幸福を運ぶ青い鳥は、まるで彼の先行きを応援するように羽ばたくと、"

#. Occurrence 6_7:2105:8368: scene=6_7
#: 6_7:2105
msgctxt "text_id=8368 | speaker=unknown"
msgid "  Then, with a flutter, it mercilessly flicked off the lights."
msgstr "　情け容赦なく、居間の電気を消したのだった。"

#. Occurrence 6_8:81:8369: scene=6_8
#: 6_8:81
msgctxt "text_id=8369 | speaker=unknown"
msgid "  Leaving Soujyuro alone in the drawing room, Aoko returned to her bedroom."
msgstr "　草十郎を居間に残したまま、青子は自室に戻ってきた。"

#. Occurrence 6_8:86:8370: scene=6_8
#: 6_8:86
msgctxt "text_id=8370 | speaker=unknown"
msgid "  She closed the door to her room, and as soon as she sat on her bed she was overcome by a unexpected wave of exhaustion."
msgstr "　ドアを閉めベッドに腰を下ろすと、どっと疲れが押し寄せてくる。"

#. Occurrence 6_8:91:8371: scene=6_8
#: 6_8:91
msgctxt "text_id=8371 | speaker=unknown"
msgid "  Soujyuro had no way of knowing, but she had been preparing for war."
msgstr "　草十郎には知るよしもないが、青子は青子で臨戦態勢だったのだ。"

#. Occurrence 6_8:96:8372: scene=6_8
#: 6_8:96
msgctxt "text_id=8372 | speaker=unknown"
msgid "  In the event that Alice impulsively pulled out a Ploy, Aoko had to be ready to react in an instant."
msgstr "　いつ有珠が直情にかられてプロイを持ちだしても、即座に反応できるように。"

#. Occurrence 6_8:130:8373: scene=6_8
#: 6_8:130
msgctxt "text_id=8373 | speaker=unknown"
msgid "  She sighed heavily."
msgstr "　はあ、とため息をつく。"

#. Occurrence 6_8:135:8374: scene=6_8
#: 6_8:135
msgctxt "text_id=8374 | speaker=unknown"
msgid "  But not from the fatigue she felt at fighting with Alice."
msgstr "　それは有珠との暗闘による気疲れ―――ではなく。"

#. Occurrence 6_8:156:8375: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0000; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:156
msgctxt "text_id=8375 | speaker=aoko"
msgid "\"...Was I too hard on him?\""
msgstr "「……ちょっと突っぱねすぎたか？」"

#. Occurrence 6_8:162:8376: scene=6_8
#: 6_8:162
msgctxt "text_id=8376 | speaker=unknown"
msgid "  She frowned a dejected frown."
msgstr "　むう、と眉を<顰|ひそ>める。"

#. Occurrence 6_8:167:8377: scene=6_8
#: 6_8:167
msgctxt "text_id=8377 | speaker=unknown"
msgid "  What weighed on Aoko's mind was not Alice."
msgstr "　彼女の頭を重くしているのは、まったく別の問題だった。"

#. Occurrence 6_8:201:8378: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0001; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:201
msgctxt "text_id=8378 | speaker=aoko"
msgid "\"...I mean, going easy on him wouldn't do him any favors, either."
msgstr "「……でも甘くするのはアイツのためにならないし。"

#. Occurrence 6_8:207:8379: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0002; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:207
msgctxt "text_id=8379 | speaker=aoko"
msgid "  The best thing he can do for himself is to lay low.\""
msgstr "　基本、大人しくしてもらった方がいいワケだし……」"

#. Occurrence 6_8:213:8380: scene=6_8
#: 6_8:213
msgctxt "text_id=8380 | speaker=unknown"
msgid "  It would be trouble if he wandered around like he owned the place, after all."
msgstr "　安心されて我が家のように歩き回られるのも困る。"

#. Occurrence 6_8:218:8381: scene=6_8
#: 6_8:218
msgctxt "text_id=8381 | speaker=unknown"
msgid "  The safest thing for him would be if he holed up in his room, too scared out of his wits to leave it."
msgstr "　彼にはおっかなびっくり、極力、自分の部屋に閉じこもってもらった方が安全なのだ。"

#. Occurrence 6_8:245:8382: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0003; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:245
msgctxt "text_id=8382 | speaker=aoko"
msgid "\"God, I hope he doesn't think I'm his ally or something."
msgstr "「ま、蒼崎は味方だ、なんて勘違いされても困るしね。"

#. Occurrence 6_8:251:8383: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0004; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:251
msgctxt "text_id=8383 | speaker=aoko"
msgid "  Alice is the lucky one, I'd kill to have him treat me as a stranger.\""
msgstr "　有珠同様、人でなし扱いされた方が楽だわ」"

#. Occurrence 6_8:278:8384: scene=6_8
#: 6_8:278
msgctxt "text_id=8384 | speaker=unknown"
msgid "  She nodded to herself, agreeing with her take on the situation."
msgstr "　よし、と自分の選択に納得する青子。"

#. Occurrence 6_8:283:8385: scene=6_8
#: 6_8:283
msgctxt "text_id=8385 | speaker=unknown"
msgid "  For the most part, it was a sound plan."
msgstr "　彼女の方針はおおむね正しい。"

#. Occurrence 6_8:302:8386: scene=6_8
#: 6_8:302
msgctxt "text_id=8386 | speaker=unknown"
msgid "  If there were a problem, it would be this."
msgstr "　問題があるとすれば、"

#. Occurrence 6_8:337:8387: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_8_0000; voice_prefix=A30; voice_category=3; scene=6_8
#: 6_8:337
msgctxt "text_id=8387 | speaker=soujuurou"
msgid "\"Sorry Aozaki. I just have one quick question.\""
msgstr "「すまない蒼崎。ひとつ聞きたい事があるんだが……」"

#. Occurrence 6_8:356:8388: scene=6_8
#: 6_8:356
msgctxt "text_id=8388 | speaker=unknown"
msgid "  Not ten minutes had passed since leaving him in the drawing room."
msgstr "　居間で別れてから十分弱。"

#. Occurrence 6_8:361:8389: scene=6_8
#: 6_8:361
msgctxt "text_id=8389 | speaker=unknown"
msgid "  For Soujyuro to shirk off what she had said and visit her room so fast, it was like he had no sense of danger at all."
msgstr "　最速とも言える開き直りで青子の部屋を訪れた、静希草十郎の危機感の無さだった。"

#. Occurrence 6_8:429:8390: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_8_0001; voice_prefix=A30; voice_category=3; scene=6_8
#: 6_8:429
msgctxt "text_id=8390 | speaker=soujuurou"
msgid "\"I need to go outside.\""
msgstr "「実は、外に出たいんだ」"

#. Occurrence 6_8:435:8391: scene=6_8
#: 6_8:435
msgctxt "text_id=8391 | speaker=unknown"
msgid "  Of course he would ask to leave the house."
msgstr "　それがこの男の言い分だった。"

#. Occurrence 6_8:463:8392: scene=6_8
#: 6_8:463
msgctxt "text_id=8392 | speaker=unknown"
msgid "  Aoko lacked the energy for a sarcastic barb."
msgstr "　青子には嫌味を返す気力もない。"

#. Occurrence 6_8:493:8393: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_8_0002; voice_prefix=A30; voice_category=3; scene=6_8
#: 6_8:493
msgctxt "text_id=8393 | speaker=soujuurou"
msgid "\"I won't wander around the mansion, and I'll come right back when I'm finished. I just figured I should check if there was a curfew or anything.\""
msgstr "「洋館の中は歩き回らないし、用を済ませたらきちんと戻ってくる。ただ、門限とかあったら聞いておこうと思って」"

#. Occurrence 6_8:539:8394: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0005; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:539
msgctxt "text_id=8394 | speaker=aoko"
msgid "\"Work, is it?\""
msgstr "「でも、アルバイトには行くのよね」"

#. Occurrence 6_8:555:8395: scene=6_8
#: 6_8:555
msgctxt "text_id=8395 | speaker=unknown"
msgid "  \"How did you know?!\" Soujyuro exclaimed in surprise."
msgstr "　なんで分かる!?　と驚く草十郎。"

#. Occurrence 6_8:560:8396: scene=6_8
#: 6_8:560
msgctxt "text_id=8396 | speaker=unknown"
msgid "  When it was Aoko who desired to display her shock at him."
msgstr "　正直、驚きたいのは青子の方である。"

#. Occurrence 6_8:587:8397: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0006; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:587
msgctxt "text_id=8397 | speaker=aoko"
msgid "\"Fine. You can go."
msgstr "「……まあいいわ。"

#. Occurrence 6_8:593:8398: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0007; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:593
msgctxt "text_id=8398 | speaker=aoko"
msgid "  You should make sure you're back on the estate by ten every night."
msgstr "　基本、午後十時まで。その時間には必ず屋敷にいること。"

#. Occurrence 6_8:593:8399: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0007; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:593
msgctxt "text_id=8399 | speaker=aoko"
msgid "  As long as you keep to the curfew, you can go work your after-school job, have a barbecue in the garden, do whatever you want. I don't care."
msgstr "　その後は夜勤にでかけるなり、庭でバーベキューするなり、なんでも好きにしていい。"

#. Occurrence 6_8:605:8400: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0008; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:605
msgctxt "text_id=8400 | speaker=aoko"
msgid "  The front door is never locked anyway.\""
msgstr "　それと、玄関に鍵はかかってないから」"

#. Occurrence 6_8:629:8401: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_8_0003; voice_prefix=A30; voice_category=3; scene=6_8
#: 6_8:629
msgctxt "text_id=8401 | speaker=soujuurou"
msgid "\"...I get the impression you're, err..."
msgstr "「……気のせいじゃなければだけど。"

#. Occurrence 6_8:635:8402: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_8_0004; voice_prefix=A30; voice_category=3; scene=6_8
#: 6_8:635
msgctxt "text_id=8402 | speaker=soujuurou"
msgid "  Angry with me.\""
msgstr "　蒼崎、すごく怒ってないか？」"

#. Occurrence 6_8:678:8403: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0009; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:678
msgctxt "text_id=8403 | speaker=aoko"
msgid "\"I'm angry all right, just not with you. I'm angry at myself for caring what happens to you."
msgstr "「アンタ相手に気を遣った自分に<呆|あき>れ果ててるだけよ。"

#. Occurrence 6_8:690:8404: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0010; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:690
msgctxt "text_id=8404 | speaker=aoko"
msgid "  And before you go out, take this pill.\""
msgstr "　外に出るのはいいけど、その前にこの<錠剤|じょうざい>飲んで」"

#. Occurrence 6_8:696:8405: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_8_0005; voice_prefix=A30; voice_category=3; scene=6_8
#: 6_8:696
msgctxt "text_id=8405 | speaker=soujuurou"
msgid "\"??\""
msgstr "「？？」"

#. Occurrence 6_8:701:8406: scene=6_8
#: 6_8:701
msgctxt "text_id=8406 | speaker=unknown"
msgid "  Soujyuro took the purple pill from her outstretched hand and dubiously put it in his mouth."
msgstr "　青子から差し出された紫色の錠剤を、半信半疑で草十郎は口に入れた。"

#. Occurrence 6_8:706:8407: scene=6_8
#: 6_8:706
msgctxt "text_id=8407 | speaker=unknown"
msgid "  He told himself that it must have been some kind of medicine."
msgstr "　体に<良|い>い薬か何かだろう、と思いこんでいる風だ。"

#. Occurrence 6_8:745:8408: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_8_0006; voice_prefix=A30; voice_category=3; scene=6_8
#: 6_8:745
msgctxt "text_id=8408 | speaker=soujuurou"
msgid "\"All right, I'm off then. Thanks for everything, Aozaki.\""
msgstr "「それじゃ行ってくる。色々ありがとう、蒼崎」"

#. Occurrence 6_8:751:8409: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0011; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:751
msgctxt "text_id=8409 | speaker=aoko"
msgid "\"Oh and...don't leave through the window this time, okay?\""
msgstr "「あっそ。今度は窓から出ていかないでよね」"

#. Occurrence 6_8:784:8410: scene=6_8
#: 6_8:784
msgctxt "text_id=8410 | speaker=unknown"
msgid "  Soujyuro laughed himself all the way to the foyer, unsure of what exactly he had found funny."
msgstr "　何が嬉しいのか、あはは、などと平和ぼけに笑って草十郎はホールへ向かっていった。"

#. Occurrence 6_8:789:8411: scene=6_8
#: 6_8:789
msgctxt "text_id=8411 | speaker=unknown"
msgid "  Aoko watched him go, both indifferent and amazed all at once."
msgstr "　その背中を、青子は<半|なか>ば冷たく、半ば不思議そうに観察する。"

#. Occurrence 6_8:825:8412: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0012; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:825
msgctxt "text_id=8412 | speaker=aoko"
msgid "\"Well that happened about half a day earlier than planned."
msgstr "「ま、予定が半日早まっただけか。"

#. Occurrence 6_8:832:8413: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0013; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:832
msgctxt "text_id=8413 | speaker=aoko"
msgid "He was supposed to take his first pill tomorrow morning.\""
msgstr "あの薬を飲ませるの、明日の朝にしてあげようと思ったのに」"

#. Occurrence 6_8:896:8414: scene=6_8
#: 6_8:896
msgctxt "text_id=8414 | speaker=unknown"
msgid "  She huffed, ruffling her hair in exasperation and returning to her room."
msgstr "　やれやれと髪をかいて自室に戻る。"

#. Occurrence 6_8:901:8415: scene=6_8
#: 6_8:901
msgctxt "text_id=8415 | speaker=unknown"
msgid "  Discerning what made Soujyuro tick was a waste of brain matter."
msgstr "　彼の行動原理なんて考えるまでもない。"

#. Occurrence 6_8:906:8416: scene=6_8
#: 6_8:906
msgctxt "text_id=8416 | speaker=unknown"
msgid "  In all likeliness, he was more concerned about missing two days of work than his own well-being after being bedridden for two days."
msgstr "　おおかた、二日間寝こんでいた自分の体より、アルバイトを休んでいた事の方が気になっていたのだろう。"

#. Occurrence 6_9:91:8417: scene=6_9
#: 6_9:91
msgctxt "text_id=8417 | speaker=unknown"
msgid "  With the day's work behind him, Soujyuro returned to the mansion."
msgstr "　一日の仕事を終え、草十郎は洋館に戻ってきた。"

#. Occurrence 6_9:113:8418: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0000; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:113
msgctxt "text_id=8418 | speaker=soujuurou"
msgid "\"This must be it. It's the only set of stairs leading up from the second floor hall.\""
msgstr "「よし。どこを探しても、二階のホールから上がれる階段はここだけだ」"

#. Occurrence 6_9:119:8419: scene=6_9
#: 6_9:119
msgctxt "text_id=8419 | speaker=unknown"
msgid "  It was just before midnight."
msgstr "　日付も替わろうとする零時前。"

#. Occurrence 6_9:124:8420: scene=6_9
#: 6_9:124
msgctxt "text_id=8420 | speaker=unknown"
msgid "  This was the scene that awaited him beyond the rickety staircase."
msgstr "　くたびれた階段の先には、このような景色が広がっていた。"

#. Occurrence 6_9:173:8421: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0001; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:173
msgctxt "text_id=8421 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 6_9:179:8422: scene=6_9
#: 6_9:179
msgctxt "text_id=8422 | speaker=unknown"
msgid "  Not much surprised Soujyuro. Or rather, being surprised had become normal to him. This scene, however, was enough to leave him speechless."
msgstr "　たいていのコトには驚かない……もう驚きなれてしまった……草十郎をして、それは、言葉を失う光景だった。"

#. Occurrence 6_9:201:8423: scene=6_9
#: 6_9:201
msgctxt "text_id=8423 | speaker=unknown"
msgid "  The room allotted to Soujyuro,"
msgstr "　草十郎にあてがわれた部屋は、"

#. Occurrence 6_9:206:8424: scene=6_9
#: 6_9:206
msgctxt "text_id=8424 | speaker=unknown"
msgid "  no matter how he looked at it,"
msgstr "　どこをどう見ても、"

#. Occurrence 6_9:211:8425: scene=6_9
#: 6_9:211
msgctxt "text_id=8425 | speaker=unknown"
msgid "  no matter how he ran it through in his mind,"
msgstr "　何をとりつくろうとも、"

#. Occurrence 6_9:216:8426: scene=6_9
#: 6_9:216
msgctxt "text_id=8426 | speaker=unknown"
msgid "  was without a shadow of a doubt, an attic."
msgstr "　まがうことなき屋根裏部屋でした。"

#. Occurrence 6_9:238:8427: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0002; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:238
msgctxt "text_id=8427 | speaker=soujuurou"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 6_9:260:8428: scene=6_9
#: 6_9:260
msgctxt "text_id=8428 | speaker=unknown"
msgid "  This treatment stirred a tinge of anxiety in him."
msgstr "　むう、と己の<処遇|しょぐう>に<一抹|いちまつ>の不安を覚える。"

#. Occurrence 6_9:266:8429: scene=6_9
#: 6_9:266
msgctxt "text_id=8429 | speaker=unknown"
msgid "  Just as he was about to flop onto the taut sheets of his bed, wondering if he could make this work despite his share of other problems,"
msgstr "　ただでさえ気の重いことばかりなのに、こんなんでやっていけるのかな、とシーツの敷かれたベッドに倒れこもうとした時、"

#. Occurrence 6_9:273:8430: scene=6_9
#: 6_9:273
msgctxt "text_id=8430 | speaker=unknown"
msgid "  he noticed an awkward courtesy, so meager as to be useless."
msgstr "　ささやかすぎて役に立たない、ちぐはぐな気遣いがあった。"

#. Occurrence 6_9:296:8431: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_9_0000; voice_prefix=A10; voice_category=1; scene=6_9
#: 6_9:296
msgctxt "text_id=8431 | speaker=aoko"
msgid "\"Something to use if you get cold. Consider it a gift.\""
msgstr "『寒かったら重ねて使うこと。これはサービスとする』"

#. Occurrence 6_9:302:8432: scene=6_9
#: 6_9:302
msgctxt "text_id=8432 | speaker=unknown"
msgid "  The message in the memo pointed to the meticulous personality of the author."
msgstr "　メモにある文字は、几帳面な性格がにじみ出ている。"

#. Occurrence 6_9:307:8433: scene=6_9
#: 6_9:307
msgctxt "text_id=8433 | speaker=unknown"
msgid "  The bed had been perfectly prepared."
msgstr "　布団は十分用意されていた。"

#. Occurrence 6_9:314:8434: scene=6_9
#: 6_9:314
msgctxt "text_id=8434 | speaker=unknown"
msgid "  Carefully, setting aside the blanket that had been painstakingly placed on the edge of the bed for him in case he needed it, he looked up at the sky."
msgstr "　その上で、念のためにと置かれた毛布を大事そうに<端|はし>にどけて、草十郎は空を仰いだ。"

#. Occurrence 6_9:377:8435: scene=6_9
#: 6_9:377
msgctxt "text_id=8435 | speaker=unknown"
msgid "  Though faint, the stars twinkled through the skylight."
msgstr "　おぼろげではあるが、天窓には星が<瞬|またた>いている。"

#. Occurrence 6_9:382:8436: scene=6_9
#: 6_9:382
msgctxt "text_id=8436 | speaker=unknown"
msgid "  For a mountain boy, that meager light was more than enough for him."
msgstr "　山育ちである彼にすれば、不満はあれ十分な明かりといえる。"

#. Occurrence 6_9:387:8437: scene=6_9
#: 6_9:387
msgctxt "text_id=8437 | speaker=unknown"
msgid "  The stark contrast with the drawing room had caught him off guard, but now that he had collected himself, it was not so bad."
msgstr "　居間との格差から面食らってしまったが、冷静になれば落胆するコトでもない。"

#. Occurrence 6_9:407:8438: scene=6_9
#: 6_9:407
msgctxt "text_id=8438 | speaker=unknown"
msgid "  This room fit his personality."
msgstr "　この部屋はこの部屋で彼の性格に合っているのだし。"

#. Occurrence 6_9:412:8439: scene=6_9
#: 6_9:412
msgctxt "text_id=8439 | speaker=unknown"
msgid "  Even if he still was not used to the building, he felt more at ease here than he did in any building in the city, "
msgstr "　いまだ勝手の分からない建物だとしても、町の建物よりは安心できた。"

#. Occurrence 6_9:417:8440: scene=6_9
#: 6_9:417
msgctxt "text_id=8440 | speaker=unknown"
msgid "  perhaps because it was built on a hill, surrounded by woods."
msgstr "　丘の上、森の中に建っているからだろう。"

#. Occurrence 6_9:422:8441: scene=6_9
#: 6_9:422
msgctxt "text_id=8441 | speaker=unknown"
msgid "  The atmosphere here was a little closer to the mountains where he used to live."
msgstr "　ここは少しだけ彼の住んでいた山の空気に近いのだ。"

#. Occurrence 6_9:443:8442: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0003; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:443
msgctxt "text_id=8442 | speaker=soujuurou"
msgid "\"...Oh. Is it normal for there to be fog inside the house?\""
msgstr "「……あ。でも、家の中に霧が出るのはどうなんだろう？」"

#. Occurrence 6_9:468:8443: scene=6_9
#: 6_9:468
msgctxt "text_id=8443 | speaker=unknown"
msgid "  He crooked his neck, pondering over the spectacle he had witnessed."
msgstr "　先ほどの光景を思い返して首をかしげる。"

#. Occurrence 6_9:473:8444: scene=6_9
#: 6_9:473
msgctxt "text_id=8444 | speaker=unknown"
msgid "  On the way to his room, Soujyuro had encountered what looked like fog in the foyer on the second floor."
msgstr "　草十郎はここに来る途中、二階のホールで霧らしきものを見かけていた。"

#. Occurrence 6_9:544:8445: scene=6_9
#: 6_9:544
msgctxt "text_id=8445 | speaker=unknown"
msgid "  The misty fog drifted into a portion of the corridor, reminding him of a swarm of mosquitoes."
msgstr "　白い霧は廊下の一部分にだけ漂っていて、<藪蚊|やぶか>の群を思わせた。"

#. Occurrence 6_9:555:8446: scene=6_9
#: 6_9:555
msgctxt "text_id=8446 | speaker=unknown"
msgid "  As he stared at it, he swore he could make out a strange landscape, and as he moved closer to get a better look..."
msgstr "　じっと見ていると、おかしな風景が見えた気がして近寄ったのだが、"

#. Occurrence 6_9:568:8447: scene=6_9
#: 6_9:568
msgctxt "text_id=8447 | speaker=unknown"
msgid "  Again, out of nowhere, here inside of the mansion, a little blue bird darted purposefully in front of him."
msgstr "　これまたとつぜん、不自然なことに青い小鳥が目の前を横切ったのだ。館内で。"

#. Occurrence 6_9:634:8448: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0004; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:634
msgctxt "text_id=8448 | speaker=soujuurou"
msgid "\"...A bird?\""
msgstr "「―――鳥？」"

#. Occurrence 6_9:640:8449: scene=6_9
#: 6_9:640
msgctxt "text_id=8449 | speaker=unknown"
msgid "  The bird caught his attention, stopping him in his tracks."
msgstr "　小鳥に気を取られて立ち止まる。"

#. Occurrence 6_9:645:8450: scene=6_9
#: 6_9:645
msgctxt "text_id=8450 | speaker=unknown"
msgid "  When he looked to check on the fog again, the strange scene had disappeared."
msgstr "　もう一度霧を見ると、おかしな風景は消えていた。"

#. Occurrence 6_9:695:8451: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0005; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:695
msgctxt "text_id=8451 | speaker=soujuurou"
msgid "\"...This house must have a draft."
msgstr "「……この家、隙間でもあるのかな。"

#. Occurrence 6_9:695:8452: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0005; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:695
msgctxt "text_id=8452 | speaker=soujuurou"
msgid "  I'll ask Aozaki about it tomorrow,\""
msgstr "　明日、蒼崎に訊いてみるか」"

#. Occurrence 6_9:701:8453: scene=6_9
#: 6_9:701
msgctxt "text_id=8453 | speaker=unknown"
msgid "  he muttered to himself as he sat on the bed."
msgstr "　ベッドに腰掛けながら呟く。"

#. Occurrence 6_9:706:8454: scene=6_9
#: 6_9:706
msgctxt "text_id=8454 | speaker=unknown"
msgid "  Meager as it was, the starlight peeping in through the skylight calmed him."
msgstr "　天窓から<覗|のぞ>く星の光は、ささやかではあるが気持ちを落ち着かせてくれた。"

#. Occurrence 6_9:733:8455: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0006; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:733
msgctxt "text_id=8455 | speaker=soujuurou"
msgid "\"Yeah, this will work.\""
msgstr "「うん、これなら―――」"

#. Occurrence 6_9:746:8456: scene=6_9
#: 6_9:746
msgctxt "text_id=8456 | speaker=unknown"
msgid "  Exhaling slowly, he laid down."
msgstr "　ほう、と息を吐いてベッドに体を預ける。"

#. Occurrence 6_9:751:8457: scene=6_9
#: 6_9:751
msgctxt "text_id=8457 | speaker=unknown"
msgid "  For the time being, he had the essentials needed to live, and his bed was many times softer than it appeared."
msgstr "　とりあえず衣食住はあるのだし、ベッドは見た目より何倍も柔らかいし。"

#. Occurrence 6_9:756:8458: scene=6_9
#: 6_9:756
msgctxt "text_id=8458 | speaker=unknown"
msgid "  Thinking his worries seemed smaller than they were, he quickly drifted off to sleep."
msgstr "　心配事はあまりないな、と草十郎は速やかに眠りに落ちていった。"

#. Occurrence 6_9:805:8459: scene=6_9
#: 6_9:805
msgctxt "text_id=8459 | speaker=unknown"
msgid "  That was the story of from when he opened his eyes, to when he fell asleep."
msgstr "　以上が、彼の目覚めてから眠るまでの話。"

#. Occurrence 6_9:811:8460: scene=6_9
#: 6_9:811
msgctxt "text_id=8460 | speaker=unknown"
msgid "  Just like that, the short night following the long night was over."
msgstr "　長い夜のあとの、短い夜はこうして終わった。"

#. Occurrence 6_9:817:8461: scene=6_9
#: 6_9:817
msgctxt "text_id=8461 | speaker=unknown"
msgid "  For one thing was true..."
msgstr "　……どうあれ。"

#. Occurrence 6_9:822:8462: scene=6_9
#: 6_9:822
msgctxt "text_id=8462 | speaker=unknown"
msgid "  Soujyuro was an optimist to a fault, but it wasn't the end of the world."
msgstr "　楽観的すぎるけれど、やっていけない事はなさそうだ。"

#. Occurrence 6_9:873:8463: scene=6_9
#: 6_9:873
msgctxt "text_id=8463 | speaker=unknown"
msgid "  Now, let us rewind five hours prior to this glutton for punishment going to bed."
msgstr "　そんな、踏まれても踏まれても応えない<天然草|てんねんそう>の話から、時間は五時間ほどさかのぼる。"

#. Occurrence 6_9:939:8464: scene=6_9
#: 6_9:939
msgctxt "text_id=8464 | speaker=unknown"
msgid "  It was seven o'clock in the evening, just after the unproductive discussion between the two mages and the boy had ended."
msgstr "　魔術師の当事者ふたりと、おまけの少年の不毛な話し合いが終わった午後七時。"

#. Occurrence 6_9:944:8465: scene=6_9
#: 6_9:944
msgctxt "text_id=8465 | speaker=unknown"
msgid "  Leaving her roommate and the intruder in the drawing room, the girl walked alone through the foyer."
msgstr "　居間に<同居人|あおこ>と<闖入者|そうじゅうろう>を残したまま、少女はひとりロビーを歩いていた。"

#. Occurrence 6_9:949:8466: scene=6_9
#: 6_9:949
msgctxt "text_id=8466 | speaker=unknown"
msgid "  From there, she headed to the west wing."
msgstr "　向かう先は館の西館。"

#. Occurrence 6_9:954:8467: scene=6_9
#: 6_9:954
msgctxt "text_id=8467 | speaker=unknown"
msgid "  These were Alice Kuonji's personal chambers, in which even her roommate, Aoko Aozaki, seldom dared to step foot."
msgstr "　同居人である蒼崎青子でさえ滅多に足を踏み入れない、久遠寺有珠の居住区である。"

#. Occurrence 6_9:998:8468: scene=6_9
#: 6_9:998
msgctxt "text_id=8468 | speaker=unknown"
msgid "  The foyer was illuminated only by pale moonlight."
msgstr "　月明かりだけのロビー。"

#. Occurrence 6_9:1003:8469: scene=6_9
#: 6_9:1003
msgctxt "text_id=8469 | speaker=unknown"
msgid "  Hard footsteps echoed through the dreary, moonlit lobby."
msgstr "　寒々しい明かりの下、硬い足音が<木霊|こだま>している。"

#. Occurrence 6_9:1008:8470: scene=6_9
#: 6_9:1008
msgctxt "text_id=8470 | speaker=unknown"
msgid "  In such mansions in Japan, there was no custom for removing shoes at the door."
msgstr "　洋風の屋敷では靴を脱ぐ習慣はない。"

#. Occurrence 6_9:1013:8471: scene=6_9
#: 6_9:1013
msgctxt "text_id=8471 | speaker=unknown"
msgid "  Hence, Alice crossed the foyer in her boots."
msgstr "　有珠はブーツのままロビーを横断する。"

#. Occurrence 6_9:1018:8472: scene=6_9
#: 6_9:1018
msgctxt "text_id=8472 | speaker=unknown"
msgid "  She only removed them when she relaxed in her bedroom."
msgstr "　彼女が靴を脱ぐのは寝室で休む時だけだ。"

#. Occurrence 6_9:1080:8473: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0000; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1080
msgctxt "text_id=8473 | speaker=alice"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 6_9:1086:8474: scene=6_9
#: 6_9:1086
msgctxt "text_id=8474 | speaker=unknown"
msgid "  ...Suddenly, she remembered something from her childhood."
msgstr "　……ふと、有珠は子供の頃の出来事を思い出した。"

#. Occurrence 6_9:1091:8475: scene=6_9
#: 6_9:1091
msgctxt "text_id=8475 | speaker=unknown"
msgid "  She used to enjoy the feeling of the cold hardwood floor on her bare feet, and would walk around the foyer on particularly sunny days."
msgstr "　冷たい床の感覚を楽しみたくて、日射しの強い日は裸足でこのロビーを歩いた。"

#. Occurrence 6_9:1096:8476: scene=6_9
#: 6_9:1096
msgctxt "text_id=8476 | speaker=unknown"
msgid "  After her father affectionately scolded her for it, she never did it again."
msgstr "　それを父に優しく<咎|とが>められて以来、彼女は裸足で歩く事はなくなったのだが―――"

#. Occurrence 6_9:1141:8477: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0001; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1141
msgctxt "text_id=8477 | speaker=alice"
msgid "\"And I don't know why I bother. Aoko never does.\""
msgstr "「……そうだったわね。青子は結局、守らなかった」"

#. Occurrence 6_9:1147:8478: scene=6_9
#: 6_9:1147
msgctxt "text_id=8478 | speaker=unknown"
msgid "  She let out a quiet sigh."
msgstr "　かすかなため息がもれる。"

#. Occurrence 6_9:1152:8479: scene=6_9
#: 6_9:1152
msgctxt "text_id=8479 | speaker=unknown"
msgid "  Alice's new roommate, whom she took on after coming to Japan, would not comply with her instructions."
msgstr "　日本に来てから得た新しい同居人は、有珠の言いつけには従わなかった。"

#. Occurrence 6_9:1193:8480: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_9_0001; voice_prefix=A10; voice_category=1; scene=6_9
#: 6_9:1193
msgctxt "text_id=8480 | speaker=aoko"
msgid "\"Old habits die hard.\""
msgstr "“落ち着かないものはしょうがない”"

#. Occurrence 6_9:1199:8481: scene=6_9
#: 6_9:1199
msgctxt "text_id=8481 | speaker=unknown"
msgid "  Aoko would say, changing into her slippers."
msgstr "　と、青子はスリッパに履き替える事がある。"

#. Occurrence 6_9:1204:8482: scene=6_9
#: 6_9:1204
msgctxt "text_id=8482 | speaker=unknown"
msgid "  Aoko might have found it natural to do so given that she lived in a typical Japanese house through middle school, but every time Alice heard her flip-flopping through the foyer, she wanted to cancel their cohabitation."
msgstr "　中学生まで一般家屋で暮らしていた青子にすれば自然なのだろうが、あのペタペタいう足音でロビーを移動される度に、有珠は彼女との共同生活を破棄したくなったものだ。"

#. Occurrence 6_9:1240:8483: scene=6_9
#: 6_9:1240
msgctxt "text_id=8483 | speaker=unknown"
msgid "  By now, Alice was not particularly bothered by it anymore."
msgstr "　それも今ではさして気にはならない。"

#. Occurrence 6_9:1245:8484: scene=6_9
#: 6_9:1245
msgctxt "text_id=8484 | speaker=unknown"
msgid "  Human adaptability was remarkable at times, and ungracious at others."
msgstr "　人間の順応性は時に優秀で、不義理だ。"

#. Occurrence 6_9:1250:8485: scene=6_9
#: 6_9:1250
msgctxt "text_id=8485 | speaker=unknown"
msgid "  The emotional attachments of the past had proved far too brittle under the weight of reality."
msgstr "　現実の<忙|いそが>しさの前には、昔からの思い入れなんて<脆|もろ>すぎる。"

#. Occurrence 6_9:1294:8486: scene=6_9
#: 6_9:1294
msgctxt "text_id=8486 | speaker=unknown"
msgid "  A little blue bird was perched on the banister."
msgstr "　階段の手すりには青い小鳥が止まっていた。"

#. Occurrence 6_9:1302:8487: scene=6_9
#: 6_9:1302
msgctxt "text_id=8487 | speaker=unknown"
msgid "  Its tiny chirping made Alice stop and look its way."
msgstr "　小さな鳴き声に、少女は足を止めて視線を向ける。"

#. Occurrence 6_9:1319:8488: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0002; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1319
msgctxt "text_id=8488 | speaker=alice"
msgid "\"...Leave him be for tonight. Right now, he's Aoko's problem.\""
msgstr "「……今夜は放っておくわ。今は青子の問題よ」"

#. Occurrence 6_9:1371:8489: scene=6_9
#: 6_9:1371
msgctxt "text_id=8489 | speaker=unknown"
msgid "  The lack of feeling in her voice made the bird tilt its head as it sang."
msgstr "　感情の乏しい声に、小鳥は首をかしげながら鳴いた。"

#. Occurrence 6_9:1377:8490: scene=6_9
#: 6_9:1377
msgctxt "text_id=8490 | speaker=unknown"
msgid "  Tweet tweet tweet."
msgstr "　チチチ、と。"

#. Occurrence 6_9:1382:8491: scene=6_9
#: 6_9:1382
msgctxt "text_id=8491 | speaker=unknown"
msgid "  It trilled, as though questioning its master's uncharacteristic leniency."
msgstr "　いつもの<主人|アリス>からは考えつかない、懐の深さを<訝|いぶか>しむように。"

#. Occurrence 6_9:1423:8492: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0003; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1423
msgctxt "text_id=8492 | speaker=alice"
msgid "\"A promise is a promise. I can at least tolerate him for tonight."
msgstr "「約束は約束よ。今夜ぐらいは大目に見ないと。"

#. Occurrence 6_9:1429:8493: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0004; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1429
msgctxt "text_id=8493 | speaker=alice"
msgid "  Aoko and the boy did go to such lengths, after all.\""
msgstr "　……青子と彼は、それだけの活躍をしたのだし」"

#. Occurrence 6_9:1435:8494: scene=6_9
#: 6_9:1435
msgctxt "text_id=8494 | speaker=unknown"
msgid "  She said to the bird, her voice betraying her discontent."
msgstr "　小鳥に言い聞かせる声は、内容とは裏腹に不機嫌気味だ。"

#. Occurrence 6_9:1440:8495: scene=6_9
#: 6_9:1440
msgctxt "text_id=8495 | speaker=unknown"
msgid "\"If you win, I'll let you go.\""
msgstr "“勝負に勝てば見逃してあげる”"

#. Occurrence 6_9:1445:8496: scene=6_9
#: 6_9:1445
msgctxt "text_id=8496 | speaker=unknown"
msgid "  She would keep that promise, in spite of the unquenchable desire to fight that burned in her chest."
msgstr "　その約束を守ってはいるものの、少女の胸には消しがたい戦意が灯っている。"

#. Occurrence 6_9:1480:8497: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0005; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1480
msgctxt "text_id=8497 | speaker=alice"
msgid "\"...But I didn't make any guarantees after that."
msgstr "「……でも、その後の処遇は別の話。"

#. Occurrence 6_9:1486:8498: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0006; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1486
msgctxt "text_id=8498 | speaker=alice"
msgid "  She scraped a win even with a handicap in our little game, but I won't let her strut around childishly rubbing it my face forever.\""
msgstr "　条件付きのゲームに勝ったぐらいで、いつまでも得意げでいられるのは心外だわ」"

#. Occurrence 6_9:1492:8499: scene=6_9
#: 6_9:1492
msgctxt "text_id=8499 | speaker=unknown"
msgid "  Perhaps it was perfectionism born of fastidiousness, but "
msgstr "　潔癖性からくる完全主義か。"

#. Occurrence 6_9:1497:8500: scene=6_9
#: 6_9:1497
msgctxt "text_id=8500 | speaker=unknown"
msgid "  despite her prim demeanor, Alice Kuonji was a sore loser."
msgstr "　こう見えて久遠寺有珠は負けず嫌いらしい。"

#. Occurrence 6_9:1502:8501: scene=6_9
#: 6_9:1502
msgctxt "text_id=8501 | speaker=unknown"
msgid "  It did not matter to her whose magecraft was superior. Losing the game had proven hard to move on from."
msgstr "　魔術の優劣などどうでもいいが、ゲームに負けた事が今も不満で仕方がないのだ。"

#. Occurrence 6_9:1548:8502: scene=6_9
#: 6_9:1548
msgctxt "text_id=8502 | speaker=unknown"
msgid "  The little bird fluttered its wings in agreement."
msgstr "　シュタ、と翼をあげて同意する小鳥。"

#. Occurrence 6_9:1553:8503: scene=6_9
#: 6_9:1553
msgctxt "text_id=8503 | speaker=unknown"
msgid "  Drinking in Alice's contempt, it was itching to dive-bomb the invader."
msgstr "　有珠の嫌悪感を汲んで、<草十郎|がいてき>を打ちのめさんとやる気に満ちている。"

#. Occurrence 6_9:1558:8504: scene=6_9
#: 6_9:1558
msgctxt "text_id=8504 | speaker=unknown"
msgid "  It looked like a soldier saluting a superior officer as it preened itself."
msgstr "　その<羽繕|はづくろ>いは、上官に<敬礼|けいれい>する仕草に見えなくもない。"

#. Occurrence 6_9:1618:8505: scene=6_9
#: 6_9:1618
msgctxt "text_id=8505 | speaker=unknown"
msgid "  The blue bird turned to face its master."
msgstr "　かくして、青い小鳥は主人に向き直る。"

#. Occurrence 6_9:1625:8506: scene=6_9
#: 6_9:1625
msgctxt "text_id=8506 | speaker=unknown"
msgid "  Tweet tweet tweet, tweet tweet tweet."
msgstr "　チチチ、チチチ。"

#. Occurrence 6_9:1630:8507: scene=6_9
#: 6_9:1630
msgctxt "text_id=8507 | speaker=unknown"
msgid "  Its lighthearted tweeting seemed to display a desire to deal with Soujyuro first thing in the morning."
msgstr "　軽快な鳴き声は、明日の朝一番で<草十郎|アイツ>をヤりましょう、と宣言するかのようだ。"

#. Occurrence 6_9:1677:8508: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0007; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1677
msgctxt "text_id=8508 | speaker=alice"
msgid "\"...Indeed. If he gives us a reason, let us put him in a bottle, or perhaps a book.\""
msgstr "「…………そうね。理由さえできたのなら、瓶なり本なりに入ってもらいましょう」"

#. Occurrence 6_9:1706:8509: scene=6_9
#: 6_9:1706
msgctxt "text_id=8509 | speaker=unknown"
msgid "  Except, her words lacked any bite."
msgstr "　だが、少女の声には張りがなかった。"

#. Occurrence 6_9:1712:8510: scene=6_9
#: 6_9:1712
msgctxt "text_id=8510 | speaker=unknown"
msgid "  On the face of it, they were the chilling kind one might come to expect from a witch's lips, but then again so tame as to remind you of a certain robin's flapping."
msgstr "　魔女らしい、容赦のない台詞だったが、よくよく考えてみれば<生温|なまぬる>いコトこの上ない。コマドリ的に。"

#. Occurrence 6_9:1747:8511: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0008; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1747
msgctxt "text_id=8511 | speaker=alice"
msgid "\"It's only a matter of time, and there's not very much at that. My patience has its limits."
msgstr "「しばらくの話よ。けど、それも<一時|いっとき>だけ。わたしの我慢も長くは続かないし。"

#. Occurrence 6_9:1753:8512: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0009; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1753
msgctxt "text_id=8512 | speaker=alice"
msgid "  Aoko is in no position to dote on others in the first place. I give her five days. And then...\""
msgstr "　……だいたい、青子も人にかまけていられる立場じゃないわ。五日もすれば思い知るでしょう。そうすれば―――」"

#. Occurrence 6_9:1792:8513: scene=6_9
#: 6_9:1792
msgctxt "text_id=8513 | speaker=unknown"
msgid "  When that time came, expelling him would be simple."
msgstr "　その時こそ、彼を<排斥|はいせき>するのは<容易|たやす>い。"

#. Occurrence 6_9:1797:8514: scene=6_9
#: 6_9:1797
msgctxt "text_id=8514 | speaker=unknown"
msgid "  Alice was well aware her roommate was a pragmatist with no vision."
msgstr "　同居人が夢のない合理主義者である事を、有珠はよく分かっている。"

#. Occurrence 6_9:1817:8515: scene=6_9
#: 6_9:1817
msgctxt "text_id=8515 | speaker=unknown"
msgid "  The situation she'd created would not allow her to wait around."
msgstr "　青子の置かれた状況は、いつまでもあんな余分を許しはしない。"

#. Occurrence 6_9:1822:8516: scene=6_9
#: 6_9:1822
msgctxt "text_id=8516 | speaker=unknown"
msgid "  She could only afford to protect that boy for three or four days at most."
msgstr "　あの少年の保護に割り当てる<時間|よゆう>は、せいぜい三日から四日ほど。"

#. Occurrence 6_9:1827:8517: scene=6_9
#: 6_9:1827
msgctxt "text_id=8517 | speaker=unknown"
msgid "  Beyond that, Alice sensed Aoko would crack and say something like, \"You take care of this, Alice.\""
msgstr "　それを過ぎれば青子の方から“あとは有珠の判断に任せる”と折れるだろう。"

#. Occurrence 6_9:1848:8518: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0010; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1848
msgctxt "text_id=8518 | speaker=alice"
msgid "\"Will I wait until then, or will I lose my patience first?"
msgstr "「それまで待つか、あるいはわたしの我慢がきかなくなるか。"

#. Occurrence 6_9:1854:8519: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0011; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1854
msgctxt "text_id=8519 | speaker=alice"
msgid "  Whichever comes first, the end result will be the same.\""
msgstr "　どちらにしても結果は変わらないわ」"

#. Occurrence 6_9:1860:8520: scene=6_9
#: 6_9:1860
msgctxt "text_id=8520 | speaker=unknown"
msgid "  Alice Kuonji would suffer no more irritations."
msgstr "　久遠寺有珠はこれ以上の厄介事を許さない。"

#. Occurrence 6_9:1867:8521: scene=6_9
#: 6_9:1867
msgctxt "text_id=8521 | speaker=unknown"
msgid "  And protecting a witness, let alone allowing them to live in her mansion, was an *indignity*."
msgstr "　目撃者の保護や、まして、この洋館に住まわせるなんてもってのほかで―――"

#. Occurrence 6_9:1936:8522: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0012; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1936
msgctxt "text_id=8522 | speaker=alice"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 6_9:1942:8523: scene=6_9
#: 6_9:1942
msgctxt "text_id=8523 | speaker=unknown"
msgid "  Alice looked up, fascinated by the dense fog that had crawled into the foyer."
msgstr "　<漏|も>れだした<濃霧|のうむ>に引かれるよう、有珠は視線を上げた。"

#. Occurrence 6_9:1947:8524: scene=6_9
#: 6_9:1947
msgctxt "text_id=8524 | speaker=unknown"
msgid "  Above the fireplace was a single mirror."
msgstr "　暖炉の上には一枚の鏡がある。"

#. Occurrence 6_9:1998:8525: scene=6_9
#: 6_9:1998
msgctxt "text_id=8525 | speaker=unknown"
msgid "  Roughly three feet in diameter, it decorated the wall where one might find a painting."
msgstr "　本来なら絵画が飾られるだろう壁には、直径一メートルほどの鏡。"

#. Occurrence 6_9:2003:8526: scene=6_9
#: 6_9:2003
msgctxt "text_id=8526 | speaker=unknown"
msgid "  Its surface was faintly clouded, and vaguely reflected the foyer's appearance."
msgstr "　鏡の表面はぼんやりと<曇|くも>り、ロビーの様子を<曖昧|あいまい>に映している。"

#. Occurrence 6_9:2032:8527: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0013; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:2032
msgctxt "text_id=8527 | speaker=alice"
msgid "\"This is what I get for losing the Snark."
msgstr "「……スナークを<喪|な>くした影響でしょうね。"

#. Occurrence 6_9:2038:8528: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0014; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:2038
msgctxt "text_id=8528 | speaker=alice"
msgid "  I suppose that means the mirror is out of commission for the time being.\""
msgstr "　鏡の機能、しばらくは制御できないみたい」"

#. Occurrence 6_9:2067:8529: scene=6_9
#: 6_9:2067
msgctxt "text_id=8529 | speaker=unknown"
msgid "  The little bird joyfully chirped at its master's mumbling."
msgstr "　主人の呟きに、小鳥は喜びの<鳴|こえ>をあげた。"

#. Occurrence 6_9:2072:8530: scene=6_9
#: 6_9:2072
msgctxt "text_id=8530 | speaker=unknown"
msgid "  The bird attempted to imply that there was no need for her to lift a finger, not if the nuisance would fall into the mirror of his own accord."
msgstr "　それなら自分たちが手を下すまでもなく、邪魔者は鏡に落ちて退場すると。"

#. Occurrence 6_9:2099:8531: scene=6_9
#: 6_9:2099
msgctxt "text_id=8531 | speaker=unknown"
msgid "  Or perhaps..."
msgstr "　……あるいは。"

#. Occurrence 6_9:2104:8532: scene=6_9
#: 6_9:2104
msgctxt "text_id=8532 | speaker=unknown"
msgid "  Had the little bird had not sang, Alice would have come to the same conclusion."
msgstr "　この小鳥さえそんな鳴き声をあげなければ、有珠も同じ意見だっただろう。"

#. Occurrence 6_9:2131:8533: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0015; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:2131
msgctxt "text_id=8533 | speaker=alice"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 6_9:2137:8534: scene=6_9
#: 6_9:2137
msgctxt "text_id=8534 | speaker=unknown"
msgid "  For some reason, she recalled an earlier conversation."
msgstr "　少女はなんとなしに、先ほどの会話を思い出した。"

#. Occurrence 6_9:2204:8535: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0016; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:2204
msgctxt "text_id=8535 | speaker=alice"
msgid "\"How about now? Still think this is the safest option?\""
msgstr "“これでも一番、無難だと思う？”"

#. Occurrence 6_9:2210:8536: scene=6_9
#: 6_9:2210
msgctxt "text_id=8536 | speaker=unknown"
msgid "  In response to her question, the boy inside the bottle shrugged his shoulders and answered."
msgstr "　そう問うた少女に、小瓶の中の少年は肩をすくめながら答えた。"

#. Occurrence 6_9:2236:8537: scene=6_9
#: 6_9:2236
msgctxt "text_id=8537 | speaker=unknown"
msgid "  From his perspective, the city and the mansion were no different."
msgstr "　自分にとっては町も<洋|こ><館|こ>も変わらない、と。"

#. Occurrence 6_9:2242:8538: scene=6_9
#: 6_9:2242
msgctxt "text_id=8538 | speaker=unknown"
msgid "  It seemed that having just moved from the countryside, everything was \"something he had never seen before.\""
msgstr "　なんでも、田舎から出てきたばかりの彼にすれば、あらゆるものが“見たこともないもの”なのだそうだ。"

#. Occurrence 6_9:2263:8539: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0007; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:2263
msgctxt "text_id=8539 | speaker=soujuurou"
msgid "\"I'm not proud of it, but I still have trouble writing, and the city rules are so complicated that I don't even know right from wrong.\""
msgstr "『自慢できるコトじゃないが、まだ書き物さえ満足にできないし、都会のルールは複雑すぎて、何が正しいのかさえ区別がつかない』"

#. Occurrence 6_9:2269:8540: scene=6_9
#: 6_9:2269
msgctxt "text_id=8540 | speaker=unknown"
msgid "  More than embarrassment, his voice was full of resentment."
msgstr "　……あれは恥ずかしさより、<憤|いきどお>りに満ちた声だった。"

#. Occurrence 6_9:2274:8541: scene=6_9
#: 6_9:2274
msgctxt "text_id=8541 | speaker=unknown"
msgid "  He was angry about something, though Alice could not tell what."
msgstr "　彼が何に対して怒っているのか、有珠には読み取れない。"

#. Occurrence 6_9:2279:8542: scene=6_9
#: 6_9:2279
msgctxt "text_id=8542 | speaker=unknown"
msgid "  But..."
msgstr "　ただ、"

#. Occurrence 6_9:2347:8543: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0008; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:2347
msgctxt "text_id=8543 | speaker=soujuurou"
msgid "\"That's why no matter where I go I'm always in danger."
msgstr "『だから、どこにいても危ない事に変わりはないんだ。"

#. Occurrence 6_9:2353:8544: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0009; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:2353
msgctxt "text_id=8544 | speaker=soujuurou"
msgid "  It may be an exaggeration, but even walking down the street, or talking to someone makes me anxious. No matter where I am, there's no guarantee I'll make it out."
msgstr "　極端な話、道を歩くだけでも、人と話すだけでも不安になる。俺は、どこでだろうと上手くやっていける保証はないんだよ。"

#. Occurrence 6_9:2359:8545: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0010; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:2359
msgctxt "text_id=8545 | speaker=soujuurou"
msgid "  But here, there's someone that might show concern for a person like me. Sure, my reasoning is a little messed up, but I've never known such luxury.\""
msgstr "　けど、ここにはそんなヤツに気を遣ってくれる人がいる。気遣ってくれる理由は物騒なものっぽいけど、それは本当に、贅沢なコトだと思うんだ』"

#. Occurrence 6_9:2416:8546: scene=6_9
#: 6_9:2416
msgctxt "text_id=8546 | speaker=unknown"
msgid "  Her eyes welled up ever so slightly."
msgstr "　……少女の瞳がわずかに曇る。"

#. Occurrence 6_9:2421:8547: scene=6_9
#: 6_9:2421
msgctxt "text_id=8547 | speaker=unknown"
msgid "  Those soft words were something she could not brush off,"
msgstr "　静かにこぼれたあの言葉は、無視できるものではなかった。"

#. Occurrence 6_9:2426:8548: scene=6_9
#: 6_9:2426
msgctxt "text_id=8548 | speaker=unknown"
msgid "  because they made sense to her."
msgstr "　だって、きちんと筋が通っている。"

#. Occurrence 6_9:2431:8549: scene=6_9
#: 6_9:2431
msgctxt "text_id=8549 | speaker=unknown"
msgid "  Given that everything in the city was a danger to him, nothing had changed after coming to the mansion."
msgstr "　彼にとって都会はどこであろうと危険なら、この洋館ですら“何も”変わらないのだ。"

#. Occurrence 6_9:2451:8550: scene=6_9
#: 6_9:2451
msgctxt "text_id=8550 | speaker=unknown"
msgid "  In reality, he had no reason to fear this place in particular;"
msgstr "　本当に、この洋館を恐れるだけの理由がない。"

#. Occurrence 6_9:2456:8551: scene=6_9
#: 6_9:2456
msgctxt "text_id=8551 | speaker=unknown"
msgid "  if anything was different from the outside, it would be that someone here was his ally."
msgstr "　外との違いがあるとしたら、それは味方になってくれる誰かがいるかいないかという点だけ。"

#. Occurrence 6_9:2476:8552: scene=6_9
#: 6_9:2476
msgctxt "text_id=8552 | speaker=unknown"
msgid "  With that view, he had been entirely sincere."
msgstr "　その説でいけば、彼は何ひとつ嘘を言っていない。"

#. Occurrence 6_9:2483:8553: scene=6_9
#: 6_9:2483
msgctxt "text_id=8553 | speaker=unknown"
msgid "  His explanation hadn't contained any flattery towards Alice Kuonji,"
msgstr "　久遠寺有珠へのご機嫌とりでもなく、"

msgctxt "text_id=8554 | speaker=unknown"
msgid "  mor pandering to Aoko Aozaki."
msgstr "　蒼崎青子に頼ろうとしたのでもなく。"

#. Occurrence 6_9:2491:8555: scene=6_9
#: 6_9:2491
msgctxt "text_id=8555 | speaker=unknown"
msgid "  He was simply speaking from the heart: \"I like it here.\""
msgstr "　心から、『ここがいい』と告げたのだ。"

#. Occurrence 6_9:2540:8556: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0017; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:2540
msgctxt "text_id=8556 | speaker=alice"
msgid "\"Perhaps having him wander into the mirror is more trouble than it's worth right now."
msgstr "「……いま、鏡に迷いこまれるのは迷惑ね。"

#. Occurrence 6_9:2546:8557: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0018; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:2546
msgctxt "text_id=8557 | speaker=alice"
msgid "  I want to dedicate the mirror's function to searching for intruders, so if it looks like he's going to be swallowed up by it, do stop him, will you?\""
msgstr "　鏡の機能は侵入者の探索に専念させたいし、彼が迷いこみそうになったら止めてあげて」"

#. Occurrence 6_9:2558:8558: scene=6_9
#: 6_9:2558
msgctxt "text_id=8558 | speaker=unknown"
msgid "  The bird shook its feathers at her strange instruction."
msgstr "　予想外の言葉に小鳥の羽が震える。"

#. Occurrence 6_9:2599:8559: scene=6_9
#: 6_9:2599
msgctxt "text_id=8559 | speaker=unknown"
msgid "  Alice looked away from the mirror and continued her walk."
msgstr "　少女は鏡から視線を逸らして歩きだした。"

#. Occurrence 6_9:2646:8560: scene=6_9
#: 6_9:2646
msgctxt "text_id=8560 | speaker=unknown"
msgid "  The bird chirped in protest."
msgstr "　抗議の<鳴|こえ>をあげる小鳥。"

#. Occurrence 6_9:2652:8561: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0019; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:2652
msgctxt "text_id=8561 | speaker=alice"
msgid "\"It is your job, Robin. At least get that right, would you?\""
msgstr "「貴方の仕事よロビン。それぐらいの役には立って」"

#. Occurrence 6_9:2659:8562: scene=6_9
#: 6_9:2659
msgctxt "text_id=8562 | speaker=unknown"
msgid "  Leaving the bird with that icy retort, she vanished into the west wing."
msgstr "　それに冷たい言葉を返して、少女は西館に消えていった。"

#. Occurrence 6_9:2723:8563: scene=6_9
#: 6_9:2723
msgctxt "text_id=8563 | speaker=unknown"
msgid "  All that remained was the moonlight,"
msgstr "　後に残されたのは月の明かりと、"

#. Occurrence 6_9:2743:8564: scene=6_9
#: 6_9:2743
msgctxt "text_id=8564 | speaker=unknown"
msgid "  and the little blue bird, trembling at an perilous prospect of unprecedented change."
msgstr "　かつてない変化の予兆に激震する、青い小鳥だけだった。"

#. Occurrence 7_1:78:8565: scene=7_1
#: 7_1:78
msgctxt "text_id=8565 | speaker=unknown"
msgid "            Once, long ago, I saw a beautiful bird fly overhead."
msgstr "　　　　　　むかし、うつくしい鳥を見た。"

#. Occurrence 7_1:98:8566: scene=7_1
#: 7_1:98
msgctxt "text_id=8566 | speaker=unknown"
msgid "  Round and round, it circled the distant blue sky."
msgstr "　はるかな青い空を、ぐるぐると、回るように飛んでいる。"

#. Occurrence 7_1:166:8567: scene=7_1
#: 7_1:166
msgctxt "text_id=8567 | speaker=unknown"
msgid "  How high it flew in this era when humans,"
msgstr "　もう鳥たちの時代も終わって、"

#. Occurrence 7_1:171:8568: scene=7_1
#: 7_1:171
msgctxt "text_id=8568 | speaker=unknown"
msgid "  not birds, reigned supreme."
msgstr "　とっくに人間の時代になっているのに。"

#. Occurrence 7_1:177:8569: scene=7_1
#: 7_1:177
msgctxt "text_id=8569 | speaker=unknown"
msgid "  And yet the bird was completely uninterested"
msgstr "　あの鳥は地上で増え続けるわたしたちのことも、"

#. Occurrence 7_1:182:8570: scene=7_1
#: 7_1:182
msgctxt "text_id=8570 | speaker=unknown"
msgid "  in humanity's endless desire for expansion,"
msgstr "　より高さを増していくわたしたちの家にも、"

#. Occurrence 7_1:187:8571: scene=7_1
#: 7_1:187
msgctxt "text_id=8571 | speaker=unknown"
msgid "  our creation of even higher homes,"
msgstr "　工場の煙突から<煤|すす>をまき散らすわたしたちの文明にも、"

#. Occurrence 7_1:192:8572: scene=7_1
#: 7_1:192
msgctxt "text_id=8572 | speaker=unknown"
msgid "  or the smoke bellowing from industry's chimneys."
msgstr "　まるで関心がないようだった。"

#. Occurrence 7_1:252:8573: scene=7_1
#: 7_1:252
msgctxt "text_id=8573 | speaker=unknown"
msgid "  The sky extends further than the eye can see."
msgstr "　いつまでも、いつまでも。"

#. Occurrence 7_1:258:8574: scene=7_1
#: 7_1:258
msgctxt "text_id=8574 | speaker=unknown"
msgid "  It belongs to no one, not now, not then."
msgstr "　大空はもう誰のものでもないのに。"

#. Occurrence 7_1:263:8575: scene=7_1
#: 7_1:263
msgctxt "text_id=8575 | speaker=unknown"
msgid "  The bird was a truly noble creature."
msgstr "　鳥は<気高|けだか>く。"

#. Occurrence 7_1:268:8576: scene=7_1
#: 7_1:268
msgctxt "text_id=8576 | speaker=unknown"
msgid "  Flapping its wings powerfully across the wild, ancient sky."
msgstr "　古い野生の空のまま、力強く羽ばたいていた。"

#. Occurrence 7_1:326:8577: scene=7_1
#: 7_1:326
msgctxt "text_id=8577 | speaker=unknown"
msgid "  Until... The sudden sound of cold iron."
msgstr "　……けれど、鉄の音は響いて。"

#. Occurrence 7_1:331:8578: scene=7_1
#: 7_1:331
msgctxt "text_id=8578 | speaker=unknown"
msgid "  A wing is shot, its symmetry gone forever."
msgstr "　羽は撃たれて、シンメトリは失われ。"

#. Occurrence 7_1:336:8579: scene=7_1
#: 7_1:336
msgctxt "text_id=8579 | speaker=unknown"
msgid "  Cruel and tragic, its body plummets downwards."
msgstr "　地に落ちた姿はずるずると無惨に映り。"

#. Occurrence 7_1:389:8580: scene=7_1
#: 7_1:389
msgctxt "text_id=8580 | speaker=unknown"
msgid "  Not knowing its fate, the bird frantically beats its wings till the very end."
msgstr "　ああ―――それでも彼は、最後まで鳥として羽ばたいて。"

#. Occurrence 7_1:395:8581: scene=7_1
#: 7_1:395
msgctxt "text_id=8581 | speaker=unknown"
msgid "  One moment soaring with eyes to the sky, the next crashing down to the dry, hardened earth."
msgstr "　わずかに風をきって、瞳を<北|ソラ>に向けたまま、乾いた地面に墜落した。"

#. Occurrence 7_1:435:8582: scene=7_1
#: 7_1:435
msgctxt "text_id=8582 | speaker=unknown"
msgid "  ...This was the dream I saw."
msgstr "　……そんな光景を、今になって夢に見た。"

#. Occurrence 7_1:440:8583: scene=7_1
#: 7_1:440
msgctxt "text_id=8583 | speaker=unknown"
msgid "  No matter how much I thought about it, its details remained clouded."
msgstr "　あんなにも心に残ったのに、どうしてか、よく覚えていない。"

#. Occurrence 7_1:465:8584: scene=7_1
#: 7_1:465
msgctxt "text_id=8584 | speaker=unknown"
msgid "  What did that bird look like, for instance?"
msgstr "　あの鳥は―――どんなカタチをしていただろう？"

#. Occurrence 7_1:528:8585: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0000; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:528
msgctxt "text_id=8585 | speaker=yamashiro"
msgid "\"All right, class dismissed!"
msgstr "「はい、今日の授業はここまで。"

#. Occurrence 7_1:550:8586: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0001; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:550
msgctxt "text_id=8586 | speaker=yamashiro"
msgid "  That's everything that will be on the test. Please don't share it with the other classes. You're the only ones I'm telling-think of it as a homeroom bonus."
msgstr "　試験範囲の総まとめなんかやっちゃいましたけど、これ、うちのクラスだけですから。よそのクラスには内密にお願いしますね。担任特権と思ってください。"

#. Occurrence 7_1:558:8587: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0002; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:558
msgctxt "text_id=8587 | speaker=yamashiro"
msgid "  Remember, if this class gets the highest scores you can brag about it to all the other classes!\""
msgstr "　ほら、現国の平均点ぐらいは学年一番にしておくと、皆さんも鼻が高いと思いまして」"

#. Occurrence 7_1:583:8588: scene=7_1
#: 7_1:583
msgctxt "text_id=8588 | speaker=unknown"
msgid "  Mr. Yamasiro chuckled as he finished."
msgstr "　ははは、と穏和な笑顔で語りかける山城教諭。"

#. Occurrence 7_1:588:8589: scene=7_1
#: 7_1:588
msgctxt "text_id=8589 | speaker=unknown"
msgid "  This was typical of the kind teacher responsible for Year 2 Class C, the master at relaxing his pupils."
msgstr "　２－Ｃの担任らしい、心温まる気遣いに教室中が和むのであった。"

#. Occurrence 7_1:610:8590: voice_id=D90_7_1_0000; voice_prefix=D90; voice_category=0; scene=7_1
#: 7_1:610
msgctxt "text_id=8590 | speaker=unknown"
msgid "\"I think you've got that backward, Mr. Yamasiro. You're the one who's after bragging rights!\""
msgstr "「せんせい、口元に本音出てるー。鼻を高くしたいのはあたしたちじゃないですよねー」"

#. Occurrence 7_1:621:8591: voice_id=E20_7_1_9000; voice_prefix=E20; voice_category=0; scene=7_1
#: 7_1:621
msgctxt "text_id=8591 | speaker=unknown"
msgid "\"Yeah, then he can finally get Mr. Satonaka off his back. We know he's been making fun of you all semester for our bad grades, sir.\""
msgstr "「鼻っていうか面子ですよねー。センセ、里中先生に嫌味言われてばっかりだしー」"

#. Occurrence 7_1:627:8592: voice_id=E30_7_1_0000; voice_prefix=E30; voice_category=0; scene=7_1
#: 7_1:627
msgctxt "text_id=8592 | speaker=unknown"
msgid "\"Err, duuh! We're like, total washouts, except for our totally excellent sports skills!\""
msgstr "「つーかハッキリ言えばいいんすよ、オマエらあたま悪すぎだってー。いやあまあ、うちのクラス見事なまでに体育会系ばっかりだけどさー！」"

#. Occurrence 7_1:661:8593: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0003; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:661
msgctxt "text_id=8593 | speaker=yamashiro"
msgid "\"Please, though it might not mean much coming from me, high school is about more than just your test scores."
msgstr "「いえいえ。テストの点数だけが学生生活ではありませんから、僕から言うべきコトは何も。"

#. Occurrence 7_1:667:8594: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0004; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:667
msgctxt "text_id=8594 | speaker=yamashiro"
msgid "  Teachers don't really care that much about your grades, you know. Even if you all fail, it's not like anything bad will happen to us."
msgstr "　先生方もそこまで目くじらたててるワケじゃないので、別にクラス全員が赤点でも僕の人生には何ら関わりはないんですけどねー。"

#. Occurrence 7_1:673:8595: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0005; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:673
msgctxt "text_id=8595 | speaker=yamashiro"
msgid "  But there is one student who does bother me...\""
msgstr "　しかし一方ではひとり、厄介な御仁がおりまして」"

#. Occurrence 7_1:703:8596: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0006; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:703
msgctxt "text_id=8596 | speaker=yamashiro"
msgid "\"I think you know who I'm talking about-you chose her to represent the entire student body, a monumentally awful decision."
msgstr "「皆さんが選んだ全校生徒代表の方なんですが、これが恐ろしいのなんの。"

#. Occurrence 7_1:709:8597: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0007; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:709
msgctxt "text_id=8597 | speaker=yamashiro"
msgid "  She makes a daily point to threaten to report me to the Board of Education, claiming my students' grades are the result of poor instruction rather than lack of studying."
msgstr "“テストの点数が低いのは生徒ではなく教育する側が無能だからです。教育委員会への報告準備はいつでも出来ていますので”と日夜<脅|おど>してくるんですよ。"

#. Occurrence 7_1:720:8598: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0008; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:720
msgctxt "text_id=8598 | speaker=yamashiro"
msgid "  She said if students' scores don't improve, she'd come supervise my classes herself. What kind of student even says such a thing?!\""
msgstr "　それでも生徒たちが直らないようなら、その時は直接私が監督します、とか。生徒としてどうなんですかね、アレ」"

#. Occurrence 7_1:758:8599: voice_id=D80_7_1_0000; voice_prefix=D80; voice_category=0; scene=7_1
#: 7_1:758
msgctxt "text_id=8599 | speaker=unknown"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 7_1:764:8600: scene=7_1
#: 7_1:764
msgctxt "text_id=8600 | speaker=unknown"
msgid "  The warm atmosphere in the room suddenly fell below freezing."
msgstr "　<和気藹々|わきあいあい>としていた空気が、一瞬にして氷点下まで落ちこんでいく。"

#. Occurrence 7_1:770:8601: scene=7_1
#: 7_1:770
msgctxt "text_id=8601 | speaker=unknown"
msgid "  The students of Class C now knew who their true enemy was."
msgstr "　２－Ｃ組の生徒たちも、誰が本当の敵なのかなんとなく悟ったようだ。"

#. Occurrence 7_1:800:8602: voice_id=E20_7_1_9001; voice_prefix=E20; voice_category=0; scene=7_1
#: 7_1:800
msgctxt "text_id=8602 | speaker=unknown"
msgid "\"Right... I forgot Mr. Yamasiro was the student body advisor.\""
msgstr "「あー……そっか、山城センセ生徒会の顧問だったっけ……南無南無」"

#. Occurrence 7_1:806:8603: voice_id=E30_7_1_0001; voice_prefix=E30; voice_category=0; scene=7_1
#: 7_1:806
msgctxt "text_id=8603 | speaker=unknown"
msgid "\"The student president managed to revive the cheer squad, so I wouldn't be surprised if she can force a teacher out of their job, too.\""
msgstr "「さすがは応援団を立ち直らせた女傑。教師一人退職に追いこむなど造作もねぇ……」"

#. Occurrence 7_1:846:8604: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0000; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:846
msgctxt "text_id=8604 | speaker=kinomi"
msgid "\"Yeah. I heard the she can guess teachers' ages with 100% accuracy."
msgstr "「やっぱりなあ。会長、ぜったい歳サバ読んでるって。"

#. Occurrence 7_1:846:8605: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0000; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:846
msgctxt "text_id=8605 | speaker=kinomi"
msgid "  I can't believe she's the same age as us!"
msgstr "　あの迫力、同年代と思えねーし！"

#. Occurrence 7_1:854:8606: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0001; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:854
msgctxt "text_id=8606 | speaker=kinomi"
msgid "  "
msgstr "　"

msgctxt "text_id=8607 | speaker=unknown"
msgid "I mean, look at her compared to the girls in our class. Her boobs are way bigger!\""
msgstr "ほら、うちの女子と比べると特に。こう、おっぱい的に」"

#. Occurrence 7_1:880:8608: voice_id=D90_7_1_0002; voice_prefix=D90; voice_category=0; scene=7_1
#: 7_1:880
msgctxt "text_id=8608 | speaker=unknown"
msgid "\"Oh my god, please get Kinomi moved to Class A, sir! It's hard enough with a class full of apes, but he's such a pig!\""
msgstr "「せんせー、木乃美だけでもＡ組に引き取ってもらえませんかー。そりゃ男子はみんなサルですけど、コイツだけレベルの違うサルですよ絶対！」"

#. Occurrence 7_1:901:8609: voice_id=E30_7_1_0002; voice_prefix=E30; voice_category=0; scene=7_1
#: 7_1:901
msgctxt "text_id=8609 | speaker=unknown"
msgid "\"But y'know, that girl doesn't even get the grades for a Class A member. Kinda middle of the pack, right?\""
msgstr "「あれ。でも女史、Ａ組だけどあんまり成績よくねえよな？　中の上ぐらいじゃなかったっけ？」"

#. Occurrence 7_1:907:8610: voice_id=E20_7_1_0000; voice_prefix=E20; voice_category=0; scene=7_1
#: 7_1:907
msgctxt "text_id=8610 | speaker=unknown"
msgid "\"That's the point, dumbass. She doesn't need to go to cram school, she's on the student council, and sometimes does a job or two. It'd be heinous if she got awesome grades too.\""
msgstr "「そうだけど、別にいいんじゃない？　塾もいってないし、生徒会しきって、たまにバイトまでしてるんだから。あれで学年トップだったら逆に気持ち悪すぎ」"

#. Occurrence 7_1:913:8611: voice_id=E40_7_1_0000; voice_prefix=E40; voice_category=0; scene=7_1
#: 7_1:913
msgctxt "text_id=8611 | speaker=unknown"
msgid "\"Totally... We should leave the good grades to the vice-president.\""
msgstr "「だよなー。首位は副会長に任せとけばいいんだよー」"

#. Occurrence 7_1:943:8612: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0009; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:943
msgctxt "text_id=8612 | speaker=yamashiro"
msgid "\"Hahaha. All right, that's enough gossiping, everyone. It's not nice to talk about people behind their backs."
msgstr "「はっはっは。まあまあ皆さん、うわさ話はそのあたりで。地獄耳という言葉もありますから。"

#. Occurrence 7_1:949:8613: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0010; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:949
msgctxt "text_id=8613 | speaker=yamashiro"
msgid "  In any case, good luck with your studies. Remember, if your grades don't improve then winter vacation gets canceled!"
msgstr "　じゃ、それなりに復習をよろしく。あんまり点数が悪いと冬休みそのものがなくなりますからねぇ。"

#. Occurrence 7_1:960:8614: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0011; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:960
msgctxt "text_id=8614 | speaker=yamashiro"
msgid "  Oh, and Sizuki, could I have a word before you go?\""
msgstr "　あ、それと静希君、ちょっといいですか？」"

#. Occurrence 7_1:999:8615: scene=7_1
#: 7_1:999
msgctxt "text_id=8615 | speaker=unknown"
msgid "  Mr. Yamasiro gathered his things and beckoned for Soujyuro to join him in the hallway."
msgstr "　山城教諭は教材をまとめると、草十郎に手招きをしながら廊下に出て行った。"

#. Occurrence 7_1:1048:8616: scene=7_1
#: 7_1:1048
msgctxt "text_id=8616 | speaker=unknown"
msgid "  There were no other students to be seen despite it being break time between classes."
msgstr "　休み時間だというのに、廊下に生徒の姿は見られない。"

#. Occurrence 7_1:1053:8617: scene=7_1
#: 7_1:1053
msgctxt "text_id=8617 | speaker=unknown"
msgid "  Voices were audible in the distance, but the hall itself felt strangely quiet and calm."
msgstr "　生徒たちの騒ぎ声は聞こえるものの、廊下はひっそりと落ち着いている。"

#. Occurrence 7_1:1058:8618: scene=7_1
#: 7_1:1058
msgctxt "text_id=8618 | speaker=unknown"
msgid "  Perhaps it was due to the sense of confinement created by the lack of windows."
msgstr "　窓のない廊下は閉塞感があるためだろう。"

#. Occurrence 7_1:1063:8619: scene=7_1
#: 7_1:1063
msgctxt "text_id=8619 | speaker=unknown"
msgid "  Usually students spent their breaks either in their classrooms or on the veranda."
msgstr "　生徒たちにとって休み時間の憩いの場は教室内か、そのベランダになっていた。"

#. Occurrence 7_1:1084:8620: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0000; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1084
msgctxt "text_id=8620 | speaker=soujuurou"
msgid "\"What is it, sir?\""
msgstr "「なんですか、山城先生？」"

#. Occurrence 7_1:1107:8621: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0012; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:1107
msgctxt "text_id=8621 | speaker=yamashiro"
msgid "\"Oh, nothing major."
msgstr "「いえ、そう大した用事じゃないんですけどね。"

#. Occurrence 7_1:1113:8622: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0013; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:1113
msgctxt "text_id=8622 | speaker=yamashiro"
msgid "  Sorry to bring this up right before exams, but I've been meaning to ask: how's everything going with school? You settling in all right?\""
msgstr "　試験前にこんな話をするのもデリカシーがないんですが、気になったので。どうだろう、学校には慣れたかな？」"

#. Occurrence 7_1:1138:8623: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0001; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1138
msgctxt "text_id=8623 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 7_1:1172:8624: scene=7_1
#: 7_1:1172
msgctxt "text_id=8624 | speaker=unknown"
msgid "  Though this level of concern from a teacher startled him, Soujyuro felt reassured."
msgstr "　担任の気遣いに驚きつつも、なんとなく嬉しくなる草十郎だった。"

#. Occurrence 7_1:1177:8625: scene=7_1
#: 7_1:1177
msgctxt "text_id=8625 | speaker=unknown"
msgid "  It was only natural."
msgstr "　さもありなん。"

#. Occurrence 7_1:1183:8626: scene=7_1
#: 7_1:1183
msgctxt "text_id=8626 | speaker=unknown"
msgid "After having had to deal with such difficult personalities lately, Mr. Yamasiro's trivial questions were refreshing."
msgstr "ここのところ不条理な人間に振り回されてばかりだったので、<些細|ささい>な<心配|こころくば>りでもぐっっと励まされるのだ。"

#. Occurrence 7_1:1221:8627: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0002; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1221
msgctxt "text_id=8627 | speaker=soujuurou"
msgid "\"Yes. I think I understand the basics of school life for now. And I've made friends, too.\""
msgstr "「はい。学校の造りや決まりなら、自分なりに分かってきました。友達も増えましたし」"

#. Occurrence 7_1:1227:8628: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0014; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:1227
msgctxt "text_id=8628 | speaker=yamashiro"
msgid "\"Good, glad to hear it. Students in my class tend to mouth off, so don't take them too seriously. I'm glad you're able to fit in.\""
msgstr "「そっか、それは良かった。うちのクラスは口の悪い面々だけど、その分気を遣わなくていいからね。静希君と相性がよくて助かったよ」"

#. Occurrence 7_1:1262:8629: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0003; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1262
msgctxt "text_id=8629 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 7_1:1267:8630: scene=7_1
#: 7_1:1267
msgctxt "text_id=8630 | speaker=unknown"
msgid "  Soujyuro's eyes shone brightly in appreciation."
msgstr "　おお、と草十郎は目を輝かせる。"

#. Occurrence 7_1:1272:8631: scene=7_1
#: 7_1:1272
msgctxt "text_id=8631 | speaker=unknown"
msgid "  In Aoko's words, Mr. Yamasiro was a brutish, forgettable, downright detestable man who did not even deserve the title of teacher. But Soujyuro found him considerate in his own way."
msgstr "　蒼崎青子に『憎むべき<昼行灯|ひるあんどん>、教師にあるまじきのれんに腕押し野郎』と酷評される山城教諭だが、彼は彼なりに気配りの人なのだった。"

#. Occurrence 7_1:1310:8632: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0015; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:1310
msgctxt "text_id=8632 | speaker=yamashiro"
msgid "\"Take it easy with your part-time jobs. We give students a lot of time off before exams, but don't push yourself too hard."
msgstr "「アルバイトもほどほどにね。試験前だって言えばたいていのところは休ませてくれるから、あまり無理はしないように。"

#. Occurrence 7_1:1316:8633: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0016; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:1316
msgctxt "text_id=8633 | speaker=yamashiro"
msgid "  And if you have trouble with exams just ask the other students for help. There's no need to suffer in silence. If this school has anything it's plenty of people to talk to.\""
msgstr "　また、試験で困ったコトがあったら周りに相談しなさい。ひとりで悩んでいても時間の無駄だよ。ほら、学校っていうのは話し相手にだけは困らないから」"

#. Occurrence 7_1:1355:8634: scene=7_1
#: 7_1:1355
msgctxt "text_id=8634 | speaker=unknown"
msgid "  With a wave of his hand Mr. Yamasiro was gone."
msgstr "　それじゃあ、と手を挙げて山城教諭は去っていった。"

#. Occurrence 7_1:1367:8635: scene=7_1
#: 7_1:1367
msgctxt "text_id=8635 | speaker=unknown"
msgid "  The pure-hearted Soujyuro gave him a solemn nod as if to say he accepted the advice of his so-called forgettable teacher, and went back into his classroom."
msgstr "　純朴な少年は昼行灯な忠告をまっすぐに受けとめ、なるほど、と頷きながら教室に引き返す。"

#. Occurrence 7_1:1427:8636: scene=7_1
#: 7_1:1427
msgctxt "text_id=8636 | speaker=unknown"
msgid "  And then..."
msgstr "　そうして、"

#. Occurrence 7_1:1444:8637: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0002; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:1444
msgctxt "text_id=8637 | speaker=kinomi"
msgid "\"Come again? You want my advice about girls?!\""
msgstr "「ちょっ、女のコトで相談だあ！？」"

#. Occurrence 7_1:1451:8638: scene=7_1
#: 7_1:1451
msgctxt "text_id=8638 | speaker=unknown"
msgid "  Soujyuro had not wasted a moment in putting Mr. Yamasiro's advice into practice."
msgstr "　一分も待たず、山城教諭から受けたアドバイスを実行した。"

#. Occurrence 7_1:1485:8639: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0004; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1485
msgctxt "text_id=8639 | speaker=soujuurou"
msgid "\"Yeah... It's like I've hit a wall with them."
msgstr "「そうらしい。難問にぶち当たっているんだ。"

#. Occurrence 7_1:1492:8640: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0005; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1492
msgctxt "text_id=8640 | speaker=soujuurou"
msgid "I thought about it and thought about it, but I realized that I'm no good at figuring them out.\""
msgstr "深く考えてみて気付いたんだが、どうも、自分は発想が貧困らしい」"

#. Occurrence 7_1:1503:8641: scene=7_1
#: 7_1:1503
msgctxt "text_id=8641 | speaker=unknown"
msgid "  Soujyuro averted his eyes out of shame over his lack of insight."
msgstr "　いまじねーしょんがよわいのだ、と無念そうに目を伏せる草十郎。"

#. Occurrence 7_1:1524:8642: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0003; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:1524
msgctxt "text_id=8642 | speaker=kinomi"
msgid "\"You coulda fooled me. I thought you were man with the ladies! Well, you came to the right guy. Follow me.\""
msgstr "「いや、豊かだと思ってたコトがビックリなんだけど……まあいい、こっちこい」"

#. Occurrence 7_1:1580:8643: scene=7_1
#: 7_1:1580
msgctxt "text_id=8643 | speaker=unknown"
msgid "  Shocked as he was, Kinomi grabbed Soujyuro by the shoulder and pulled him over to the wall."
msgstr "　木乃美は呆れながらも草十郎の肩をつかみ、教室の<端|はし>に移動した。"

#. Occurrence 7_1:1585:8644: scene=7_1
#: 7_1:1585
msgctxt "text_id=8644 | speaker=unknown"
msgid "  Kinomi had nearly burst out laughing when Soujyuro, with a straight face, had admitted his difficulty with girls. But, he realized it was the first time Soujyuro had ever turned to him for advice."
msgstr "　真顔で「女の子は難しいと訊く」と切り出された時は吹きそうになった木乃美だが、考えてみると草十郎が自分から相談ごとにくるのは初めてだ。"

#. Occurrence 7_1:1636:8645: scene=7_1
#: 7_1:1636
msgctxt "text_id=8645 | speaker=unknown"
msgid "  Soujyuro was always able to break down any task at his part-time jobs into bite-size pieces, but he was clearly struggling with a different problem now."
msgstr "　バイト先でもたいていのものは辛抱強くこなしてしまうこの男が悩んでいるのだ。"

#. Occurrence 7_1:1641:8646: scene=7_1
#: 7_1:1641
msgctxt "text_id=8646 | speaker=unknown"
msgid "  This was going to take some serious effort."
msgstr "　これは、よっぽどのコトとかからねばなるまい。"

#. Occurrence 7_1:1667:8647: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0004; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:1667
msgctxt "text_id=8647 | speaker=kinomi"
msgid "\"Okay. Give it to me straight, pal. How big did you screw up?\""
msgstr "「で。なんかやっちまったのか、ｙｏｕ」"

#. Occurrence 7_1:1678:8648: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0006; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1678
msgctxt "text_id=8648 | speaker=soujuurou"
msgid "\"I didn't screw up yet... but it might happen soon.\""
msgstr "「……。これから、やるのかもしれない」"

#. Occurrence 7_1:1723:8649: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0007; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1723
msgctxt "text_id=8649 | speaker=soujuurou"
msgid "\"Let's say a girl walked into The Mad Bear who's as prickly as a porcupine."
msgstr "「木乃美。たとえばの話、まっどべあにハリセンボンみたいな女の子が入ってきたとする。"

#. Occurrence 7_1:1730:8650: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0008; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1730
msgctxt "text_id=8650 | speaker=soujuurou"
msgid "She doesn't like me and wants me to leave, but I don't want to.\""
msgstr "その子は俺が嫌いで、まっどべあから出ていってほしいようなんだけど、俺はまっどべあを辞めるワケにはいかない」"

#. Occurrence 7_1:1755:8651: scene=7_1
#: 7_1:1755
msgctxt "text_id=8651 | speaker=unknown"
msgid "  Soujyuro explained that he couldn't just quit his part-time job at the restaurant-he needed the money."
msgstr "　なによりお金のために、と草十郎は熱弁する。"

#. Occurrence 7_1:1770:8652: scene=7_1
#: 7_1:1770
msgctxt "text_id=8652 | speaker=unknown"
msgid "  Kinomi grunted a few times to indicate he was still following Soujyuro's story."
msgstr "　とりあえず頷くしかない木乃美だった。"

#. Occurrence 7_1:1810:8653: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0005; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:1810
msgctxt "text_id=8653 | speaker=kinomi"
msgid "\"So, like, you want the girl to split?\""
msgstr "「……つまり、その女を追い出したいと？」"

#. Occurrence 7_1:1834:8654: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0009; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1834
msgctxt "text_id=8654 | speaker=soujuurou"
msgid "\"No, no. I want her to be okay with me working there."
msgstr "「逆だ。なんとか認めてもらいたい。"

#. Occurrence 7_1:1840:8655: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0010; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1840
msgctxt "text_id=8655 | speaker=soujuurou"
msgid "  Because the thing is... I sort of... don't not like her.\""
msgstr "　隠していたけど、俺はその女の子が嫌いというワケじゃなくて……」"

#. Occurrence 7_1:1865:8656: scene=7_1
#: 7_1:1865
msgctxt "text_id=8656 | speaker=unknown"
msgid "  Soujyuro furrowed his brow."
msgstr "　草十郎はむう、と眉間に<皺|しわ>を寄せる。"

#. Occurrence 7_1:1870:8657: scene=7_1
#: 7_1:1870
msgctxt "text_id=8657 | speaker=unknown"
msgid "  Kinomi could not help but laugh at his friend's lack of manly resolve in his answer."
msgstr "　この男らしからぬ歯切れの悪さに、木乃美はははあんと事情を察した。"

#. Occurrence 7_1:1893:8658: scene=7_1
#: 7_1:1893
msgctxt "text_id=8658 | speaker=unknown"
msgid "  Girls were the one area where Housuke's skills and experience were triple those of Soujyuro."
msgstr "　こと女性関係においてのみ、木乃美芳助の巡りの良さは三倍以上になるのである。"

#. Occurrence 7_1:1920:8659: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0006; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:1920
msgctxt "text_id=8659 | speaker=kinomi"
msgid "\"A-ha. Now I see."
msgstr "「―――ははあん。はっはっーん。"

#. Occurrence 7_1:1926:8660: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0007; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:1926
msgctxt "text_id=8660 | speaker=kinomi"
msgid "  That's just the art of flirting, man. You want to get along with her, right?\""
msgstr "　なんだよ、ようはナンパかよ。むしろ仲良くなりたいってワケ？」"

#. Occurrence 7_1:1958:8661: scene=7_1
#: 7_1:1958
msgctxt "text_id=8661 | speaker=unknown"
msgid "  Soujyuro wasn't sure how to respond."
msgstr "　木乃美の指摘に、む？　と思案する草十郎。"

#. Occurrence 7_1:1968:8662: scene=7_1
#: 7_1:1968
msgctxt "text_id=8662 | speaker=unknown"
msgid "  He nodded slowly without really understanding the implication of what Kinomi had said."
msgstr "　彼本人、それがどういうコトなのかよく分からないまま、こくんと頷いた。"

#. Occurrence 7_1:1995:8663: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0011; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1995
msgctxt "text_id=8663 | speaker=soujuurou"
msgid "\"But I don't know what to do. How can I get along with girls my age?\""
msgstr "「けど、どうすればいいのか分からない。そもそもどうやって、同い年の女の子と仲良く話ができるんだ？」"

#. Occurrence 7_1:2006:8664: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0008; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2006
msgctxt "text_id=8664 | speaker=kinomi"
msgid "\"You talk to girls in our class all the time! Honestly, you make all the other guys look bad, you're a natural at it."
msgstr "「クラスの女どもとは話してんじゃん。あれでいいんだっつの、オレは羨ましいっつの。"

#. Occurrence 7_1:2017:8665: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0009; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2017
msgctxt "text_id=8665 | speaker=kinomi"
msgid "  Just keep being your usual clueless self and I'm sure you'll be fine."
msgstr "　持ち前の天然系で押してけばいいべ。"

#. Occurrence 7_1:2023:8666: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0010; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2023
msgctxt "text_id=8666 | speaker=kinomi"
msgid "  Being raised in the mountains makes you Mr. Mysterious. You gotta use that unique identity to your advantage.\""
msgstr "　山育ちってのは稀少なアイデンティティだと思うぜ？　珍しいものは<活|い>かさないとさー」"

#. Occurrence 7_1:2050:8667: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0012; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:2050
msgctxt "text_id=8667 | speaker=soujuurou"
msgid "\"Really? I don't think being unusual is such a good thing, though."
msgstr "「そうかな。珍しいというのは、あんまりいいコトじゃない気がする。"

#. Occurrence 7_1:2080:8668: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0013; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:2080
msgctxt "text_id=8668 | speaker=soujuurou"
msgid "  Like, how do you talk to someone who hates your guts? People in class are nice, but I'm dealing with a thorny beast here! O-Or maybe a hedgehog is a better metaphor...\""
msgstr "　だいたい、そもそも嫌われている場合はどうすればいいんだ？　クラスのみんなは親切だけど、相手はハリセンボンだ。いや、このさいハリネズミでもいい」"

#. Occurrence 7_1:2104:8669: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0011; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2104
msgctxt "text_id=8669 | speaker=kinomi"
msgid "\"Don't be a chicken, man. You know what they say, a tiny thorn can stop a lion. She'll come around.\""
msgstr "「そういう場合はめげなきゃいいんだよ。相手が折れるのを待つって寸法だな。トゲだけに」"

#. Occurrence 7_1:2130:8670: scene=7_1
#: 7_1:2130
msgctxt "text_id=8670 | speaker=unknown"
msgid "  Soujyuro's brow sunk deeper still."
msgstr "　むむう、と草十郎の皺はますます深くなる。"

#. Occurrence 7_1:2154:8671: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0014; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:2154
msgctxt "text_id=8671 | speaker=soujuurou"
msgid "\"All these abstract metaphors are too much for me.\""
msgstr "「このたとえ話は、ダメだ」"

#. Occurrence 7_1:2159:8672: scene=7_1
#: 7_1:2159
msgctxt "text_id=8672 | speaker=unknown"
msgid "  He needed more concrete material to work with."
msgstr "　などと右往左往するものの、他にうまい喩えが見つからない模様。"

#. Occurrence 7_1:2207:8673: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0012; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2207
msgctxt "text_id=8673 | speaker=kinomi"
msgid "\"Come on, dude. You have to put in the work to get on a girl's good side."
msgstr "「ばっか。女なんてのは機嫌を取ってればいいんだよ。"

#. Occurrence 7_1:2213:8674: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0013; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2213
msgctxt "text_id=8674 | speaker=kinomi"
msgid "  First ask about her hobbies and stuff she likes, then go from there. Think about what she wants, not what you want. You gotta blitz 'em from where they're weak, as they say.\""
msgstr "　まずは女の趣味とか、大事にしてるもんとか聞いて、そこをフォローすればいい。自分の都合より相手の都合だ。まずは<外堀|そとぼり>から攻めろってコトだな」"

#. Occurrence 7_1:2224:8675: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0015; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:2224
msgctxt "text_id=8675 | speaker=soujuurou"
msgid "\"You mean... don't be too direct?\""
msgstr "「外堀……外回りか」"

#. Occurrence 7_1:2251:8676: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0014; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2251
msgctxt "text_id=8676 | speaker=kinomi"
msgid "\"You got it. And then comes the most important part: bribery. You gotta shower her with presents."
msgstr "「もち。その後は、ま、結局はこれが一番効果的なんだけどな。袖の下ってヤツ？　プレゼントで釣れ。"

#. Occurrence 7_1:2257:8677: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0015; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2257
msgctxt "text_id=8677 | speaker=kinomi"
msgid "  If the supply matches the demand, she'll accept your gift even if she don't like you. Then you've got her, she'll feel like she owes you one.\""
msgstr "　そん時の<需要|じゅよう>と<供給|きょうきゅう>さえ合えば、嫌われてても受け取ってもらえる。受け取らせちまえば、あとはそれが義理になるってもんだ」"

#. Occurrence 7_1:2272:8678: scene=7_1
#: 7_1:2272
msgctxt "text_id=8678 | speaker=unknown"
msgid "  Kinomi then proclaimed with an odd sense of pride that this approach had resulted in only failure for him."
msgstr "　いまのところオレはこれで連戦連敗さ！　と力強く語る友人に、何か間違った頼もしさを覚える草十郎だった。"

#. Occurrence 7_1:2327:8679: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0016; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:2327
msgctxt "text_id=8679 | speaker=soujuurou"
msgid "\"There's just one problem, Kinomi."
msgstr "「―――けど問題がある木乃美。"

#. Occurrence 7_1:2333:8680: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0017; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:2333
msgctxt "text_id=8680 | speaker=soujuurou"
msgid "  I get that girls like being taken out to dinner, but...\""
msgstr "　たしかにごはんとか、そういうのをおごってもらうと嬉しい。けど」"

#. Occurrence 7_1:2360:8681: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0016; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2360
msgctxt "text_id=8681 | speaker=kinomi"
msgid "\"You can't afford it. I know, I know."
msgstr "「そんな<余裕|かね>はないってんだろ。分かってる分かってる。"

#. Occurrence 7_1:2366:8682: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0017; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2366
msgctxt "text_id=8682 | speaker=kinomi"
msgid "  I got you covered, haha. I'm gonna let you in on a sweet little secret-an easy way to get you some cold hard dough.\""
msgstr "　……ひひひ、仕方ないねぇ。そういう静希君のために、いっちょ割のいいバイトを紹介してやろうじゃねえのよ」"

#. Occurrence 7_1:2378:8683: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0018; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:2378
msgctxt "text_id=8683 | speaker=soujuurou"
msgid "\"?\""
msgstr "「？」"

#. Occurrence 7_1:2430:8684: scene=7_1
#: 7_1:2430
msgctxt "text_id=8684 | speaker=unknown"
msgid "  They slid from the side of the classroom deeper to one corner."
msgstr "　教室の<端|はし>から、さらに<隅|すみ>へ。"

#. Occurrence 7_1:2440:8685: scene=7_1
#: 7_1:2440
msgctxt "text_id=8685 | speaker=unknown"
msgid "  To in front of the lockers, where no one ever stayed for long."
msgstr "　木乃美は人気のないロッカーの前まで草十郎を連れこんだ。"

#. Occurrence 7_1:2445:8686: scene=7_1
#: 7_1:2445
msgctxt "text_id=8686 | speaker=unknown"
msgid "  It would be days before Soujyuro realized the suggestion he was receiving was of the illegitimate kind, the kind he should not have shared with anyone."
msgstr "　それが他人には聞かせられない、悪質な勧誘の<類|たぐい>であるコトを草十郎が知るのは、これより何日か後の話である。"

#. Occurrence 7_1:2496:8687: scene=7_1
#: 7_1:2496
msgctxt "text_id=8687 | speaker=unknown"
msgid "  That night..."
msgstr "　その夜。"

#. Occurrence 7_1:2502:8688: scene=7_1
#: 7_1:2502
msgctxt "text_id=8688 | speaker=unknown"
msgid "  Dinner at the mansion was a feast of bread."
msgstr "　洋館の夕食は、一面のパン尽くしだった。"

#. Occurrence 7_1:2548:8689: scene=7_1
#: 7_1:2548
msgctxt "text_id=8689 | speaker=unknown"
msgid "  Soft slices lay stacked in the center of the table,"
msgstr "　テーブルの中央にはカットされたソフトブレッドが積まれ、"

#. Occurrence 7_1:2554:8690: scene=7_1
#: 7_1:2554
msgctxt "text_id=8690 | speaker=unknown"
msgid "  surrounded by variously colored jams."
msgstr "　周りには色とりどりのジャムが置かれ、"

#. Occurrence 7_1:2559:8691: scene=7_1
#: 7_1:2559
msgctxt "text_id=8691 | speaker=unknown"
msgid "  In a bowl was salad-mainly lettuce-"
msgstr "　ボウルにはレタスを中心にしたサラダ、"

#. Occurrence 7_1:2564:8692: scene=7_1
#: 7_1:2564
msgctxt "text_id=8692 | speaker=unknown"
msgid "  with a small plate of unevenly cut ham."
msgstr "　小皿には太さがマチマチなハムが並んでいた。"

#. Occurrence 7_1:2604:8693: scene=7_1
#: 7_1:2604
msgctxt "text_id=8693 | speaker=unknown"
msgid "  Soujyuro may have had no frame of reference for what an average family dinner should be, but he could tell that this was most certainly not normal."
msgstr "　一般家庭の夕食、その平均をまだ知らない草十郎ではあるが、これがおかしな<夕食|もの>であるコトは感じ取れる。"

#. Occurrence 7_1:2610:8694: scene=7_1
#: 7_1:2610
msgctxt "text_id=8694 | speaker=unknown"
msgid "  In truth, it was a first-rate case of laziness."
msgstr "　率直に言って、手を抜いているコトこの上ない。"

#. Occurrence 7_1:2649:8695: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0000; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:2649
msgctxt "text_id=8695 | speaker=aoko"
msgid "\"Ugh. We're out of chocolate spread."
msgstr "「あ。チョコのペースト切れたままじゃん。"

#. Occurrence 7_1:2655:8696: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0001; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:2655
msgctxt "text_id=8696 | speaker=aoko"
msgid "  Didn't I tell you to buy some more, Alice?\""
msgstr "　有珠、新しいの買っておいてって言わなかった？」"

#. Occurrence 7_1:2674:8697: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0000; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:2674
msgctxt "text_id=8697 | speaker=alice"
msgid "\"I've been locked away in my room all day."
msgstr "「……今日は一日、部屋に籠もっていたから。"

#. Occurrence 7_1:2680:8698: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0001; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:2680
msgctxt "text_id=8698 | speaker=alice"
msgid "  And more importantly, you're the only one that eats that stuff, so you should buy it.\""
msgstr "　第一、チョコレイトを食べるのは貴女だけよ。自分のものは自分で調達をするべきね」"

#. Occurrence 7_1:2718:8699: scene=7_1
#: 7_1:2718
msgctxt "text_id=8699 | speaker=unknown"
msgid "  For these two girls, however, this dinner seemed to be completely normal."
msgstr "　が、彼女たち的に、この夕食は普通らしい。"

#. Occurrence 7_1:2724:8700: scene=7_1
#: 7_1:2724
msgctxt "text_id=8700 | speaker=unknown"
msgid "  They had a system of irregularly taking turns being in charge of meals, and tonight was Alice's turn."
msgstr "　食事の準備は変則的な当番制で、今夜は久遠寺有珠のターンだった。"

#. Occurrence 7_1:2729:8701: scene=7_1
#: 7_1:2729
msgctxt "text_id=8701 | speaker=unknown"
msgid "  Normally she would spend as little time and effort as possible, only truly applying herself when there was something to celebrate."
msgstr "　有珠にとって食事当番とは、平時は手間暇を最小限に抑える作業であり、祝時のみ腕によりをかけて調理する……ものだった。"

#. Occurrence 7_1:2773:8702: scene=7_1
#: 7_1:2773
msgctxt "text_id=8702 | speaker=unknown"
msgid "  Of course, Soujyuro was none the wiser to Alice's unique approach to food preparation."
msgstr "　無論、そんな有珠の哲学を草十郎が知るよしもない。"

#. Occurrence 7_1:2778:8703: scene=7_1
#: 7_1:2778
msgctxt "text_id=8703 | speaker=unknown"
msgid "  For him it was a plain, lackluster meal."
msgstr "　草十郎から見ても簡素な食事。"

#. Occurrence 7_1:2783:8704: scene=7_1
#: 7_1:2783
msgctxt "text_id=8704 | speaker=unknown"
msgid "  And when it came to dinner..."
msgstr "　加えて、"

#. Occurrence 7_1:2837:8705: scene=7_1
#: 7_1:2837
msgctxt "text_id=8705 | speaker=unknown"
msgid "  Not saying anything to each other was another staple of their meals."
msgstr "　ふたりの間にはこれといった会話はない。"

#. Occurrence 7_1:2842:8706: scene=7_1
#: 7_1:2842
msgctxt "text_id=8706 | speaker=unknown"
msgid "  The sounds of cutlery, the scraping of chairs, and the tick-tock of the clock were the only things to be heard in the sunroom."
msgstr "　食器の音、椅子ずれの音、時計の音だけが、サンルームに流れている。"

#. Occurrence 7_1:2867:8707: scene=7_1
#: 7_1:2867
msgctxt "text_id=8707 | speaker=unknown"
msgid "  Soujyuro himself had already eaten. At this moment he was watching the goings-on from the drawing room."
msgstr "　ちなみに草十郎はと言うと、夕食は済ませていたので居間からサンルームの様子を眺めているだけだった。"

#. Occurrence 7_1:2904:8708: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0002; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:2904
msgctxt "text_id=8708 | speaker=aoko"
msgid "\"Your part-time job starts at nine, right, Soujyuro? See you later then. Don't mind us.\""
msgstr "「草十郎、九時からアルバイトでしょ。行ってらっしゃい。私たちの事は気にしないでいいから」"

#. Occurrence 7_1:2930:8709: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0019; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:2930
msgctxt "text_id=8709 | speaker=soujuurou"
msgid "\"Okay. I'll get going then.\""
msgstr "「ああ。じゃあ行ってくる」"

#. Occurrence 7_1:2980:8710: scene=7_1
#: 7_1:2980
msgctxt "text_id=8710 | speaker=unknown"
msgid "  Soujyuro donned his coat with a goodbye nod."
msgstr "　青子の声に頷いて、コートを羽織る。"

#. Occurrence 7_1:2997:8711: scene=7_1
#: 7_1:2997
msgctxt "text_id=8711 | speaker=unknown"
msgid "  When Soujyuro glanced again at the sunroom"
msgstr "　草十郎がもう一度サンルームに目をやると、"

#. Occurrence 7_1:3023:8712: scene=7_1
#: 7_1:3023
msgctxt "text_id=8712 | speaker=unknown"
msgid "  he momentarily locked eyes with Alice, or so he imagined."
msgstr "　気のせいか、ばったりと有珠と視線が合った。"

#. Occurrence 7_1:3070:8713: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0020; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:3070
msgctxt "text_id=8713 | speaker=soujuurou"
msgid "\"Huh?\""
msgstr "「？」"

#. Occurrence 7_1:3076:8714: scene=7_1
#: 7_1:3076
msgctxt "text_id=8714 | speaker=unknown"
msgid "  She had been ignoring him all day."
msgstr "　今日一日、有珠は草十郎を無視し続けた。"

#. Occurrence 7_1:3081:8715: scene=7_1
#: 7_1:3081
msgctxt "text_id=8715 | speaker=unknown"
msgid "  And not just refusing to talk to him-she had avoided him so much so as to not look at him all day until this very moment."
msgstr "　視界にさえ入れない、という徹底ぶりである。"

#. Occurrence 7_1:3086:8716: scene=7_1
#: 7_1:3086
msgctxt "text_id=8716 | speaker=unknown"
msgid "  He could understand if he was annoying her as the outsider in the mansion, but he felt no animosity in her gaze just now."
msgstr "　邪魔者として睨まれているのであれば合点がいくが、先ほどの視線に敵意はなかった。"

#. Occurrence 7_1:3112:8717: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0021; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:3112
msgctxt "text_id=8717 | speaker=soujuurou"
msgid "\"Maybe she was just glancing in the general direction of the drawing room.\""
msgstr "「……居間の様子を見てた、のかな」"

#. Occurrence 7_1:3190:8718: scene=7_1
#: 7_1:3190
msgctxt "text_id=8718 | speaker=unknown"
msgid "  Soujyuro looked nervously at his surroundings for a moment before heading to the foyer."
msgstr "　きょろきょろと居間を見渡して、草十郎はロビーへと向かっていった。"

#. Occurrence 7_1:3243:8719: scene=7_1
#: 7_1:3243
msgctxt "text_id=8719 | speaker=unknown"
msgid "  Alice only let her gaze return to normal when she was completely sure he was gone."
msgstr "　草十郎の退出を認めると、有珠は不自然だった視線を戻す。"

#. Occurrence 7_1:3263:8720: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0003; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3263
msgctxt "text_id=8720 | speaker=aoko"
msgid "\"Ugh. So much drama.\""
msgstr "「―――はあ、めんどくさ」"

#. Occurrence 7_1:3268:8721: scene=7_1
#: 7_1:3268
msgctxt "text_id=8721 | speaker=unknown"
msgid "  Aoko was appalled by Alice's brazen display."
msgstr "　青子からすれば露骨すぎて呆れてしまう。"

#. Occurrence 7_1:3273:8722: scene=7_1
#: 7_1:3273
msgctxt "text_id=8722 | speaker=unknown"
msgid "  So much so, her immaculate veneer of apathy crumbled."
msgstr "　無関心を装っているのがバレバレなのだ。"

#. Occurrence 7_1:3314:8723: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0002; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3314
msgctxt "text_id=8723 | speaker=alice"
msgid "\"What's that, Aoko? Still upset over tonight's lack of chocolate?\""
msgstr "「……なに。<献立|こんだて>に不満でもあるの、青子」"

#. Occurrence 7_1:3320:8724: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0004; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3320
msgctxt "text_id=8724 | speaker=aoko"
msgid "\"I would be, but I'm so over expecting other people to pull their weight."
msgstr "「もちろんあるけど、いつもの事だし慣れてるわよ。"

#. Occurrence 7_1:3339:8725: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0005; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3339
msgctxt "text_id=8725 | speaker=aoko"
msgid "  No, what I can't stand is your attitude."
msgstr "　私が呆れてるのはアンタの意地の悪さの方。"

#. Occurrence 7_1:3345:8726: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0006; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3345
msgctxt "text_id=8726 | speaker=aoko"
msgid "  It's pretty sissy of you to pretend to ignore him while watching his every move. Could you be any more obvious with such a cheap trap?\""
msgstr "　徹底的に無視してるクセに、相手の反応を<窺|うかが>ってるなんて女々しくない？　罠張って待ち受けるようなもんじゃない」"

#. Occurrence 7_1:3378:8727: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0003; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3378
msgctxt "text_id=8727 | speaker=alice"
msgid "\"I was not watching his every move. I could care less what he does. And mind how you use the word 'sissy.' It reeks of sexism."
msgstr "「彼の反応なんて探ってないわ。そもそも興味がないもの。それと、今のは差別発言ね。女々しいという表現は女性軽視にすぎるわ。"

#. Occurrence 7_1:3385:8728: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0004; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3385
msgctxt "text_id=8728 | speaker=alice"
msgid "Next time, just say 'you're a hypocrite,' okay?\""
msgstr "今の場合なら、貴女は矛盾している、と言ってちょうだい」"

#. Occurrence 7_1:3407:8729: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0007; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3407
msgctxt "text_id=8729 | speaker=aoko"
msgid "\"Well look who suddenly found a soap box.\""
msgstr "「うわ、自覚ありときた」"

#. Occurrence 7_1:3446:8730: scene=7_1
#: 7_1:3446
msgctxt "text_id=8730 | speaker=unknown"
msgid "  Choosing not to rise to her roommate's jibe, Alice resumed eating."
msgstr "　同居人の指摘を聞き流して、有珠は夕食を再開する。"

#. Occurrence 7_1:3451:8731: scene=7_1
#: 7_1:3451
msgctxt "text_id=8731 | speaker=unknown"
msgid "  Aoko tore off pieces of bread and ate them one by one, anger still visible on her face."
msgstr "　青子は呆れ顔のまま、ソフトブレッドをちぎっては食べ、ちぎっては食べるのだった。"

#. Occurrence 7_1:3488:8732: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0008; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3488
msgctxt "text_id=8732 | speaker=aoko"
msgid "\"Forget whatever issues you and me have for a minute, and take some advice from someone who knows a thing or two about messing with that boy."
msgstr "「じゃあここからは蒼崎青子としてじゃなく、共犯者としての質問ね。"

#. Occurrence 7_1:3512:8733: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0009; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3512
msgctxt "text_id=8733 | speaker=aoko"
msgid "  Maybe, we need to cut him some slack."
msgstr "　有珠的に、彼を見逃していいと思える判断材料はない？"

#. Occurrence 7_1:3518:8734: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0010; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3518
msgctxt "text_id=8734 | speaker=aoko"
msgid "  Hypothetically, let's say it turns out that he's a mage too. Then would you be okay with him living here?\""
msgstr "　ありえないけど、実は彼も魔術師でした、なんてオチであったとしても、<洋|こ><館|こ>に住まわせるのは容認できない？」"

#. Occurrence 7_1:3558:8735: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0005; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3558
msgctxt "text_id=8735 | speaker=alice"
msgid "\"Sure. But not for his benefit. I couldn't think of a more fitting punishment for you and I for not recognizing his ability sooner."
msgstr "「その理由なら認めるわ。彼を許すのではなく、そんな事に気付かなかったわたしたちへのペナルティとして。"

#. Occurrence 7_1:3570:8736: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0006; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3570
msgctxt "text_id=8736 | speaker=alice"
msgid "  So, yes, hypothetically speaking, I would. But we can burn that bridge when we come to it."
msgstr "　……そうね。今のは絶対にありえない話だけど、それと同じに、絶対の結論もまたないわ。"

#. Occurrence 7_1:3576:8737: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0007; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3576
msgctxt "text_id=8737 | speaker=alice"
msgid "  But until then, perhaps I should accept his presence here, perhaps not. I reserve the right to have whims of my own.\""
msgstr "　彼がここに住む選択を呑む場合すらあるかもしれない。気の迷いは、わたしにだってあるのだし」"

#. Occurrence 7_1:3613:8738: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0011; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3613
msgctxt "text_id=8738 | speaker=aoko"
msgid "\"Then we're agreed."
msgstr "「ええそう、そういうコトよ。"

#. Occurrence 7_1:3619:8739: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0012; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3619
msgctxt "text_id=8739 | speaker=aoko"
msgid "  You can keep your chilly distance out of duty to me or personal pride, but if he shows signs of improving, then maybe-\""
msgstr "　今は私との義理とかプライドで冷静をたもってるアンタだけど、アイツの努力次第で少しは、」"

#. Occurrence 7_1:3654:8740: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0008; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3654
msgctxt "text_id=8740 | speaker=alice"
msgid "\"Dream on. It doesn't matter what he does, he'll never change."
msgstr "「それは諦めて。彼が何をしようと無駄だから。"

#. Occurrence 7_1:3660:8741: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0009; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3660
msgctxt "text_id=8741 | speaker=alice"
msgid "  As you very well know.\""
msgstr "　貴女も知っていると思うけど―――」"

#. Occurrence 7_1:3681:8742: scene=7_1
#: 7_1:3681
msgctxt "text_id=8742 | speaker=unknown"
msgid "  Alice had never been the type to let her guard down around others."
msgstr "　そもそも、この少女は他人に気を許す事が出来ない。"

#. Occurrence 7_1:3686:8743: scene=7_1
#: 7_1:3686
msgctxt "text_id=8743 | speaker=unknown"
msgid "  The young witch despised humans, having recreated so many of their objects and fairy tales."
msgstr "　多くの器物、多くの童話を再現する代償として、魔女は人間を嫌うものなのだ。"

#. Occurrence 7_1:3725:8744: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0013; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3725
msgctxt "text_id=8744 | speaker=aoko"
msgid "\"You can't use being a witch as an excuse for every personal issue you have. Yet another example of you being sissy, if you ask me."
msgstr "「そんなのアンタ個人のトラウマでしょ。自分の意固地さを魔女の血統云々で棚上げするのはそれこそ女々しいわ。"

#. Occurrence 7_1:3731:8745: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0014; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3731
msgctxt "text_id=8745 | speaker=aoko"
msgid "  It's fine if you dislike him, just come out and act like it."
msgstr "　いいじゃない、嫌いなら嫌いでハッキリしてれば。"

#. Occurrence 7_1:3743:8746: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0015; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3743
msgctxt "text_id=8746 | speaker=aoko"
msgid "  Stop trying to have it both ways.\""
msgstr "　私が気にくわないのはね、アンタのどっちつかずの態度よ有珠」"

#. Occurrence 7_1:3768:8747: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0010; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3768
msgctxt "text_id=8747 | speaker=alice"
msgid "\"And what's that supposed to mean?\""
msgstr "「どっちつかずの態度……？」"

#. Occurrence 7_1:3804:8748: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0016; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3804
msgctxt "text_id=8748 | speaker=aoko"
msgid "\"That if you want to ignore him then ignore him for real."
msgstr "「そ。無視するなら徹底して無視してやれって言ってるの。"

#. Occurrence 7_1:3810:8749: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0017; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3810
msgctxt "text_id=8749 | speaker=aoko"
msgid "  You're fortifying the castle walls while leaving the front gate wide open, waiting for him to make the horrible mistake of exactly what you're urging him to do. It's gross to watch."
msgstr "　ガチガチに守りをかためて、そのクセ城門だけ開けて、獲物が油断して入ってきたら串刺しにする気満々とか、相棒として見てられないわ。"

#. Occurrence 7_1:3821:8750: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0018; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3821
msgctxt "text_id=8750 | speaker=aoko"
msgid "  If you don't want him to come inside, then shut the damn door already!\""
msgstr "　アイツにできるコトなんて閉ざされた門をあける事ぐらいだっていうのに、その機会さえ無くすのはどうなの？」"

#. Occurrence 7_1:3868:8751: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0011; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3868
msgctxt "text_id=8751 | speaker=alice"
msgid "\"I'm sorry, Aoko, you've lost me."
msgstr "「……ごめんなさい青子。もう少し簡単に言って。"

#. Occurrence 7_1:3874:8752: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0012; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3874
msgctxt "text_id=8752 | speaker=alice"
msgid "  Say that again in plain English.\""
msgstr "　その喩えは、ちょっと……」"

#. Occurrence 7_1:3880:8753: scene=7_1
#: 7_1:3880
msgctxt "text_id=8753 | speaker=unknown"
msgid "  Alice seemed unable to grasp Aoko's metaphor."
msgstr "　何を比喩しているのか分からない、と言いよどむ有珠。"

#. Occurrence 7_1:3905:8754: scene=7_1
#: 7_1:3905
msgctxt "text_id=8754 | speaker=unknown"
msgid "  Meanwhile, Aoko had had it up to here with her roommate's lack of self-awareness and was starting to lose her cool."
msgstr "　そんな相棒の無自覚さに、青子の苛立ちは一瞬だけ沸点を超えたようだ。"

#. Occurrence 7_1:3939:8755: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0019; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3939
msgctxt "text_id=8755 | speaker=aoko"
msgid "\"If you really don't care, then quit worrying so much about him! If he notices you gawking at him, he might just get the wrong idea!"
msgstr "「だから興味ないとか言っておきながらコナかけるなってコト！　あんなにチラチラ盗み見たら、アイツ、ヘンに勘違いしちゃうかもしれないでしょ？"

#. Occurrence 7_1:3951:8756: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0020_0; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3951
msgctxt "text_id=8756 | speaker=aoko"
msgid "  He's probably thinking, 'Alice looked like she wanted to patch things up. Maybe I should go stop by her room.'"
msgstr "“有珠はああ見えて、本当は自分と仲直りしたがっているに違いない。じゃあさっそく部屋に押しかけてみよう”"

#. Occurrence 7_1:3963:8757: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0020_1; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3963
msgctxt "text_id=8757 | speaker=aoko"
msgid " Or even worse!\""
msgstr "とか！」"

#. Occurrence 7_1:4015:8758: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0013; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4015
msgctxt "text_id=8758 | speaker=alice"
msgid "\"...You really think so?\""
msgstr "「―――そういうコトに、なるの？」"

#. Occurrence 7_1:4039:8759: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0021; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:4039
msgctxt "text_id=8759 | speaker=aoko"
msgid "\"Yes! If it were me you were doing that to, I'd be dragging you out back and smacking you senseless. Bitch.\""
msgstr "「なる。少なくとも、私だったらいいかげんイライラして“話があるなら校舎裏まで来い”って決着つけかねないレベル。この<毒婦|どくふ>」"

#. Occurrence 7_1:4079:8760: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0014; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4079
msgctxt "text_id=8760 | speaker=alice"
msgid "\"Very well. I'll be more careful."
msgstr "「……そうだったのね。気をつけるわ。"

#. Occurrence 7_1:4085:8761: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0015; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4085
msgctxt "text_id=8761 | speaker=alice"
msgid "  It's not like I want to talk to him anyway. And for the record I didn't look at him, exactly. Only at his arms and legs.\""
msgstr "　別に、彼と話をする気はないんだし。わたしも、彼を見ていたというより、彼の手足を見ていたのだし」"

#. Occurrence 7_1:4108:8762: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0022; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:4108
msgctxt "text_id=8762 | speaker=aoko"
msgid "\"And why in the world would you look at his arms and legs?\""
msgstr "「？　手足って、なんで？」"

#. Occurrence 7_1:4143:8763: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0016; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4143
msgctxt "text_id=8763 | speaker=alice"
msgid "\"Because of what happened the other night, though I doubt he even remembers."
msgstr "「手足は手足よ。彼個人には思うところはないけど、あの夜の出来事はまだ記憶に新しいから。"

#. Occurrence 7_1:4155:8764: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0017; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4155
msgctxt "text_id=8764 | speaker=alice"
msgid "I was thinking about it and just...happened to glance over at his arms and legs.\""
msgstr "それが少しだけ気になって、つい視線で追っていたのね」"

#. Occurrence 7_1:4177:8765: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0023; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:4177
msgctxt "text_id=8765 | speaker=aoko"
msgid "\"You mean at the amusement park? I don't remember him doing anything special.\""
msgstr "「あの夜って、遊園地のこと？　なんかしたっけアイツ？」"

#. Occurrence 7_1:4218:8766: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0018; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4218
msgctxt "text_id=8766 | speaker=alice"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence 7_1:4241:8767: scene=7_1
#: 7_1:4241
msgctxt "text_id=8767 | speaker=unknown"
msgid "  Alice's expression soured."
msgstr "　有珠の表情が見るからに不機嫌になる。"

#. Occurrence 7_1:4246:8768: scene=7_1
#: 7_1:4246
msgctxt "text_id=8768 | speaker=unknown"
msgid "  She still felt the sting of her defeat."
msgstr "　遊園地での敗北をいまだ引きずっているらしい。"

#. Occurrence 7_1:4267:8769: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0019; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4267
msgctxt "text_id=8769 | speaker=alice"
msgid "\"You saw the way he flew through the air, didn't you?"
msgstr "「飛んだでしょう、彼。"

#. Occurrence 7_1:4273:8770: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0020; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4273
msgctxt "text_id=8770 | speaker=alice"
msgid "  Off the track, straight at my Dumpty.\""
msgstr "　レールの上から、私のダンプティに向かって」"

#. Occurrence 7_1:4285:8771: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0024; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:4285
msgctxt "text_id=8771 | speaker=aoko"
msgid "\"Sure, you were raving about how he flew a whole couple of feet.\""
msgstr "「ええ、そんなコト言ってたわね。勢いでつい、一メートルぐらいだから飛んじゃったー、とか」"

#. Occurrence 7_1:4311:8772: scene=7_1
#: 7_1:4311
msgctxt "text_id=8772 | speaker=unknown"
msgid "  Aoko had not actually seen it in person, luckily."
msgstr "　幸運な事に、青子はあの現場を見ていない。"

#. Occurrence 7_1:4316:8773: scene=7_1
#: 7_1:4316
msgctxt "text_id=8773 | speaker=unknown"
msgid "  All she knew was that the spell she had placed on Soujyuro was part of the reason he survived that jump of death."
msgstr "　草十郎が死のジャンプをこなした理由のひとつが、<自分|あおこ>がかけた暗示によるもの、としか知らないのだ。"

#. Occurrence 7_1:4383:8774: scene=7_1
#: 7_1:4383
msgctxt "text_id=8774 | speaker=unknown"
msgid "  Alice on the other hand had observed the whole scene from the clock tower."
msgstr "　一方、有珠はあの光景を時計台から目撃していた。"

#. Occurrence 7_1:4388:8775: scene=7_1
#: 7_1:4388
msgctxt "text_id=8775 | speaker=unknown"
msgid "  It had only lasted an instant"
msgstr "　本当にわずか一瞬だけだったが、"

#. Occurrence 7_1:4393:8776: scene=7_1
#: 7_1:4393
msgctxt "text_id=8776 | speaker=unknown"
msgid "  but it had burned itself into her mind's eye,"
msgstr "　崩れ去るスナークよりも"

#. Occurrence 7_1:4398:8777: scene=7_1
#: 7_1:4398
msgctxt "text_id=8777 | speaker=unknown"
msgid "  more than when her precious moon had fallen at Aoko's hands"
msgstr "　地上で月を落とす青子よりも、"

#. Occurrence 7_1:4403:8778: scene=7_1
#: 7_1:4403
msgctxt "text_id=8778 | speaker=unknown"
msgid "  and Flat Snark had come tumbling down."
msgstr "　目を奪ったその光景。"

#. Occurrence 7_1:4441:8779: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0025; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:4441
msgctxt "text_id=8779 | speaker=aoko"
msgid "\"So that's it. You wanna get back at him for what happened to Dumpty, do you?\""
msgstr "「でも、それがどうしたの？　卵の仇討ちってワケ？」"

#. Occurrence 7_1:4463:8780: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0021_0; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4463
msgctxt "text_id=8780 | speaker=alice"
msgid "\"Dumpty's destruction was purely business. I feel no need for retaliation."
msgstr "「ダンプティは壊れるのが仕事だから、仇討ちも何もないわ。"

#. Occurrence 7_1:4476:8781: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0021_1; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4476
msgctxt "text_id=8781 | speaker=alice"
msgid " I was just intrigued to observe the movement of a human body.\""
msgstr "ただ……人間の体って、あんな風に動くんだなって」"

#. Occurrence 7_1:4509:8782: scene=7_1
#: 7_1:4509
msgctxt "text_id=8782 | speaker=unknown"
msgid "  As it goes..."
msgstr "　そう。"

#. Occurrence 7_1:4515:8783: scene=7_1
#: 7_1:4515
msgctxt "text_id=8783 | speaker=unknown"
msgid "For someone with as little human interaction as Alice, Soujyuro's leap must have appeared quite remarkable."
msgstr "人付き合いの少ない有珠にとって、草十郎の跳躍は初めて見る衝撃だった。"

#. Occurrence 7_1:4542:8784: scene=7_1
#: 7_1:4542
msgctxt "text_id=8784 | speaker=unknown"
msgid "  Particularly because his legs were orders of magnitude less capable than those of an animal in the forest."
msgstr "　森の動物たちより何倍もバランスの悪い、二本の手足。"

#. Occurrence 7_1:4547:8785: scene=7_1
#: 7_1:4547
msgctxt "text_id=8785 | speaker=unknown"
msgid "  And yet, even with such feeble legs, with those meek arms of his, he managed to fly through the open air like a bird."
msgstr "　あんな頼りのない足なのに、あんなに無力な両手だったのに、鳥のように虚空を駆った人のカタチ。"

#. Occurrence 7_1:4553:8786: scene=7_1
#: 7_1:4553
msgctxt "text_id=8786 | speaker=unknown"
msgid "  To her, it was akin to the feeling city folk get when they see a wild creature in its natural habitat."
msgstr "　それは都市で暮らす人間が、野生の<動物|ピューマ>の躍動を見る感動に近かった。"

#. Occurrence 7_1:4604:8787: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0022; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4604
msgctxt "text_id=8787 | speaker=alice"
msgid "\"...Forget I mentioned it. I just hope I can witness that again someday."
msgstr "「……気にしないで。機会があるなら、もう一度見たいと思っただけ。"

#. Occurrence 7_1:4611:8788: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0023; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4611
msgctxt "text_id=8788 | speaker=alice"
msgid "And when I say 'human' I am not referring to him.\""
msgstr "別に、彼に何を期待しているワケじゃないわ」"

#. Occurrence 7_1:4635:8789: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0026; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:4635
msgctxt "text_id=8789 | speaker=aoko"
msgid "\"...I see. It was novel for you. It makes sense considering most of your Ploys have non-human forms.\""
msgstr "「……なるほど。有珠のプロイってだいたいが人型じゃないしね。たんに物珍しさで見ていただけか」"

#. Occurrence 7_1:4659:8790: scene=7_1
#: 7_1:4659
msgctxt "text_id=8790 | speaker=unknown"
msgid "  Aoko sighed and released the tension from her shoulders."
msgstr "　はーあ、と両肩を落とす青子。"

#. Occurrence 7_1:4664:8791: scene=7_1
#: 7_1:4664
msgctxt "text_id=8791 | speaker=unknown"
msgid "  She was disappointed to discover that Alice's behavior stemmed from simple curiosity, like that of a child with a new toy."
msgstr "　有珠の思わせぶりな態度が、新しい玩具を欲しがる子供の好奇心と知って落胆したのだ。"

#. Occurrence 7_1:4698:8792: scene=7_1
#: 7_1:4698
msgctxt "text_id=8792 | speaker=unknown"
msgid "  And Alice was in no position to take issue with her reaction."
msgstr "　そんな同居人の態度に、有珠も異論を唱えなかった。"

#. Occurrence 7_1:4703:8793: scene=7_1
#: 7_1:4703
msgctxt "text_id=8793 | speaker=unknown"
msgid "  And how could she? She was not entirely sure what it was that she herself was feeling."
msgstr "　彼女自身、自分の抱いた感動が何なのか、よく分かっていなかったからだ。"

#. Occurrence 7_1:4755:8794: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0027; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:4755
msgctxt "text_id=8794 | speaker=aoko"
msgid "\"I'll make dinner tomorrow."
msgstr "「夕食、明日は私が作るから。"

#. Occurrence 7_1:4761:8795: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0028; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:4761
msgctxt "text_id=8795 | speaker=aoko"
msgid "  Another meal like this before exams is going to make it impossible to study.\""
msgstr "　試験前だってのにこんなしょぼくれたもん食べさせられたら、一夜漬けする気合いも湧かないわよ」"

#. Occurrence 7_1:4792:8796: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0024; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4792
msgctxt "text_id=8796 | speaker=alice"
msgid "\"No complaints from me. I certainly wouldn't mind the free time.\""
msgstr "「ご自由に。わたしも手が空いて助かるわ」"

#. Occurrence 7_1:4844:8797: scene=7_1
#: 7_1:4844
msgctxt "text_id=8797 | speaker=unknown"
msgid "  Night came and went in the mansion."
msgstr "　洋館の夜は過ぎていく。"

#. Occurrence 7_1:4849:8798: scene=7_1
#: 7_1:4849
msgctxt "text_id=8798 | speaker=unknown"
msgid "  For better or worse, the disturbances caused by the foreign invader had not yet caused the kettle to boil over."
msgstr "　幸か不幸か、異物混入による変化は、まだ表面化していないようだ。"

#. Occurrence 7_1:4960:8799: scene=7_1
#: 7_1:4960
msgctxt "text_id=8799 | speaker=unknown"
msgid "  The next morning, at six-thirty, as sunlight spread out across the sky..."
msgstr "　翌朝、空に白みがかかりだした午前六時半。"

#. Occurrence 7_1:4965:8800: scene=7_1
#: 7_1:4965
msgctxt "text_id=8800 | speaker=unknown"
msgid "  Soujyuro walked to school with Aoko in the chilly morning air."
msgstr "　冷えこんだ空気の中、なぜか草十郎は青子と一緒に登校していた。"

#. Occurrence 7_1:5012:8801: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0029; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:5012
msgctxt "text_id=8801 | speaker=aoko"
msgid "\"So try not to ever be alone in the house. Okay?\""
msgstr "“いい？　洋館にいる時は、極力一人にならない事。”"

#. Occurrence 7_1:5018:8802: scene=7_1
#: 7_1:5018
msgctxt "text_id=8802 | speaker=unknown"
msgid "  It was her intention to keep Soujyuro safe until he left the mansion."
msgstr "　青子はその忠告通り、こうして洋館を出るまでは草十郎の安全を確保している。"

#. Occurrence 7_1:5023:8803: scene=7_1
#: 7_1:5023
msgctxt "text_id=8803 | speaker=unknown"
msgid "  Nonetheless..."
msgstr "　……にしても、"

#. Occurrence 7_1:5062:8804: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0030; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:5062
msgctxt "text_id=8804 | speaker=aoko"
msgid "\"God I'm sleepy. What's the deal with going to school so early?\""
msgstr "「眠い。六時から登校とか、アンタも働き者ね」"

#. Occurrence 7_1:5068:8805: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0022; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:5068
msgctxt "text_id=8805 | speaker=soujuurou"
msgid "\"I'm not. I have to pull a thirty-minute shift helping with deliveries.\""
msgstr "「そうでもないよ。三十分<仕|し><出|だ>しを手伝うだけだし」"

#. Occurrence 7_1:5113:8806: scene=7_1
#: 7_1:5113
msgctxt "text_id=8806 | speaker=unknown"
msgid "  His work ethic was a little too strong for a student entering finals."
msgstr "　期末試験を控えた状況とは思えない、<逞|たくま>しいまでの労働意欲である。"

#. Occurrence 7_1:5140:8807: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0023; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:5140
msgctxt "text_id=8807 | speaker=soujuurou"
msgid "\"Are you sure you're not pushing yourself too hard, Aozaki?"
msgstr "「それより蒼崎、無理してないか？"

#. Occurrence 7_1:5140:8808: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0023; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:5140
msgctxt "text_id=8808 | speaker=soujuurou"
msgid "  You don't need to keep tabs on me, you know.\""
msgstr "　別に、こっちに付き合う事ないんだぞ」"

#. Occurrence 7_1:5176:8809: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0031; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:5176
msgctxt "text_id=8809 | speaker=aoko"
msgid "\"Oh don't you worry. I'll catch up on some sleep in the student council's room when we're done."
msgstr "「ご心配なく、生徒会室で仮眠とるから。"

#. Occurrence 7_1:5176:8810: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0031; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:5176
msgctxt "text_id=8810 | speaker=aoko"
msgid "  I promised I'd walk you as far as the front gate, and I plan to stick to it.\""
msgstr "　約束だし、門までは一緒に行くわよ」"

#. Occurrence 7_1:5241:8811: scene=7_1
#: 7_1:5241
msgctxt "text_id=8811 | speaker=unknown"
msgid "  But internally, Aoko was worried."
msgstr "　青子は思う。"

#. Occurrence 7_1:5246:8812: scene=7_1
#: 7_1:5246
msgctxt "text_id=8812 | speaker=unknown"
msgid "  What traps did her roommate have in store for him?"
msgstr "　はたして、同居人がどんな罠を仕掛けているか。"

#. Occurrence 7_1:5251:8813: scene=7_1
#: 7_1:5251
msgctxt "text_id=8813 | speaker=unknown"
msgid "  She could not imagine Alice had planned anything to go down in the woods, but she wanted to be safer than sorry."
msgstr "　まさか森の中まで<禁忌|タブー>を仕掛けているとは思えないが、念のためだ。"

#. Occurrence 7_1:5256:8814: scene=7_1
#: 7_1:5256
msgctxt "text_id=8814 | speaker=unknown"
msgid "  The least she could do was accompany Soujyuro to school. That much she was firmly committed to."
msgstr "　せめて行き道ぐらいは草十郎の味方になろう、と決めた青子である。"

#. Occurrence 7_1:5317:8815: scene=7_1
#: 7_1:5317
msgctxt "text_id=8815 | speaker=unknown"
msgid "  Any traps that presented themselves could then be dealt with on the spot."
msgstr "　罠があるのなら行き道で解除すればいい。"

#. Occurrence 7_1:5322:8816: scene=7_1
#: 7_1:5322
msgctxt "text_id=8816 | speaker=unknown"
msgid "  Well, not \"dealt with\" so much as destroyed, since that was Aoko's forte. But that would be enough to keep him safe for the time being."
msgstr "　一度解除……といっても青子には壊す程度しかできないのだが……してしまえば、しばらくは安全になるだろう。"

#. Occurrence 7_1:5370:8817: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0032; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:5370
msgctxt "text_id=8817 | speaker=aoko"
msgid "\"As for when you get out of school, all we can do is hope that Alice is short on free time today.\""
msgstr "「ま、帰り道に関しては、有珠もそこまで暇ではないと信じるしかないんだけど」"

#. Occurrence 7_1:5383:8818: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0024; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:5383
msgctxt "text_id=8818 | speaker=soujuurou"
msgid "\"Err... Okay?\""
msgstr "「？」"

#. Occurrence 7_1:5455:8819: scene=7_1
#: 7_1:5455
msgctxt "text_id=8819 | speaker=unknown"
msgid "  If Alice was willing to put all her energy into a new trap after the first had failed, then they were as good as dead anyway."
msgstr "　夜に罠を仕掛けて、解除されたら休むことなく日中に仕掛けてまわる……なんてマメさを発揮されてはお手上げだ。"

#. Occurrence 7_1:5460:8820: scene=7_1
#: 7_1:5460
msgctxt "text_id=8820 | speaker=unknown"
msgid "  But Aoko would cross that road when she came to it."
msgstr "　その時はその時。"

#. Occurrence 7_1:5465:8821: scene=7_1
#: 7_1:5465
msgctxt "text_id=8821 | speaker=unknown"
msgid "  It all depended on how deep Alice's dislike of Soujyuro really went."
msgstr "　久遠寺有珠にとって、静希草十郎はそこまでするほどの外敵だっただけの話だ。"

#. Occurrence 7_1:5470:8822: scene=7_1
#: 7_1:5470
msgctxt "text_id=8822 | speaker=unknown"
msgid "  It would have to be enough to make her abandon her pride as a witch, something she had protected fervently until now."
msgstr "　あの少女が頑なに守ってきた、魔女としての<矜持|プライド>を台無しにしてもいい程の。"

#. Occurrence 7_1:5553:8823: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0033; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:5553
msgctxt "text_id=8823 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 7_1:5558:8824: scene=7_1
#: 7_1:5558
msgctxt "text_id=8824 | speaker=unknown"
msgid "  If that were the case Aoko knew she would never be able to keep him safe. The moment twenty-four seven protection became necessary was the moment she had failed."
msgstr "　そもそも、その場合は青子がどれだけ尽力してもこの少年は守りきれない。日中のコトまで気を回すのは意味がなかった。"

#. Occurrence 7_1:5563:8825: scene=7_1
#: 7_1:5563
msgctxt "text_id=8825 | speaker=unknown"
msgid "  Her character led her to focus on what she could do in the here and now, and ignore the rest."
msgstr "　自分にできるかぎりの事ならするが、自分の範疇を超えた事はあっさりと切り捨てるのが青子の人間性である。"

#. Occurrence 7_1:5568:8826: scene=7_1
#: 7_1:5568
msgctxt "text_id=8826 | speaker=unknown"
msgid "  And this current plan of hers was her best attempt at doing right by everyone."
msgstr "　彼女にとっては、この方針が最大限の譲歩だった。"

#. Occurrence 7_1:5633:8827: scene=7_1
#: 7_1:5633
msgctxt "text_id=8827 | speaker=unknown"
msgid "  They left behind the Kuonji Estate."
msgstr "　久遠寺の敷地から出る。"

#. Occurrence 7_1:5638:8828: scene=7_1
#: 7_1:5638
msgctxt "text_id=8828 | speaker=unknown"
msgid "  And the two remained together until the residential area at the bottom of the hill."
msgstr "　坂を下りて住宅地に出るまでふたり一緒だ。"

#. Occurrence 7_1:5643:8829: scene=7_1
#: 7_1:5643
msgctxt "text_id=8829 | speaker=unknown"
msgid "  Where Aoko glanced casually at Soujyuro."
msgstr "　ふと、青子は傍らの少年を盗み見る。"

#. Occurrence 7_1:5650:8830: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0034; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:5650
msgctxt "text_id=8830 | speaker=aoko"
msgid "\"So, any thoughts?\""
msgstr "「ところで、何か考えてる？」"

#. Occurrence 7_1:5691:8831: scene=7_1
#: 7_1:5691
msgctxt "text_id=8831 | speaker=unknown"
msgid "  Surprisingly, Soujyuro saw through her harmless question and sensed the bigger issue."
msgstr "　青子は気まぐれで問いただしたが、意外な事に草十郎は質問の意図を察していた。"

#. Occurrence 7_1:5697:8832: scene=7_1
#: 7_1:5697
msgctxt "text_id=8832 | speaker=unknown"
msgid "  How was he going to win Alice over?"
msgstr "“有珠をどう納得させるのか”"

#. Occurrence 7_1:5703:8833: scene=7_1
#: 7_1:5703
msgctxt "text_id=8833 | speaker=unknown"
msgid "  In fact he had been thinking about that very question."
msgstr "　その難問を、彼は彼なりに考えていたらしい。"

#. Occurrence 7_1:5752:8834: scene=7_1
#: 7_1:5752
msgctxt "text_id=8834 | speaker=unknown"
msgid "  According to his friend..."
msgstr "　友人曰く。"

#. Occurrence 7_1:5757:8835: scene=7_1
#: 7_1:5757
msgctxt "text_id=8835 | speaker=unknown"
msgid "  There were three basic approaches he could take."
msgstr "　この手の難問には大きく三通りの対応法があるという。"

#. Occurrence 7_1:5762:8836: scene=7_1
#: 7_1:5762
msgctxt "text_id=8836 | speaker=unknown"
msgid "  One was the roundabout approach."
msgstr "　一つは外回り。"

#. Occurrence 7_1:5789:8837: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0018; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:5789
msgctxt "text_id=8837 | speaker=kinomi"
msgid "\"This way takes the longest, but it's the most natural."
msgstr "“こいつは時間がかかるが、もっとも自然だ。"

#. Occurrence 7_1:5795:8838: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0019; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:5795
msgctxt "text_id=8838 | speaker=kinomi"
msgid "  Humans love it when you pay attention to the things they like, just as friends do.\""
msgstr "　人間ってのは自分が好きなものを大切にされると、コロッと気を許しちまう。仲間意識ってヤツだな！”"

#. Occurrence 7_1:5801:8839: scene=7_1
#: 7_1:5801
msgctxt "text_id=8839 | speaker=unknown"
msgid "  In other words, instead of focusing on the person one wishes to win over, one should focus on their interests."
msgstr "　つまり、ターゲット本人ではなく、ターゲットが大事にしているものに気を遣え、というコトらしい。"

#. Occurrence 7_1:5826:8840: scene=7_1
#: 7_1:5826
msgctxt "text_id=8840 | speaker=unknown"
msgid "  It was a surprisingly mature opinion coming from Kinomi. Unfortunately, Soujyuro had no idea what sort of things Alice liked."
msgstr "　木乃美らしからぬ大人な意見ではあったが、残念なことに、草十郎は有珠の<嗜好|しこう>を知らなかった。"

#. Occurrence 7_1:5831:8841: scene=7_1
#: 7_1:5831
msgctxt "text_id=8841 | speaker=unknown"
msgid "  She seemed very fond of the mansion, but what could he do-clean it for her? He sensed that would have a reverse effect."
msgstr "　洋館を大切にしているコトは感じ取っているが、ここで洋館の掃除などをしても逆効果な気がする。"

#. Occurrence 7_1:5836:8842: scene=7_1
#: 7_1:5836
msgctxt "text_id=8842 | speaker=unknown"
msgid "  He had the distinct feeling she would not want him touching what was precious to her."
msgstr "　草十郎としては、大切すぎるものには簡単に触れて欲しくないのではないか、と思うのだ。"

#. Occurrence 7_1:5856:8843: scene=7_1
#: 7_1:5856
msgctxt "text_id=8843 | speaker=unknown"
msgid "  The second approach was to take the inner track."
msgstr "　二つめは内回り。"

#. Occurrence 7_1:5871:8844: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0020; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:5871
msgctxt "text_id=8844 | speaker=kinomi"
msgid "\"It's the fastest way to get someone to fall for you. When you can't coast on your natural good looks and charm, that's what your wallet is for."
msgstr "“でも、やっぱり本人を落とすのが一番早い。オレたちに魅力がないのなら、魅力のある外付け装備に頼るのだ。"

#. Occurrence 7_1:5877:8845: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0021; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:5877
msgctxt "text_id=8845 | speaker=kinomi"
msgid "  You know what I'm talking about-gifts!\""
msgstr "　―――そう、プレゼントなンだよ静希クン！”"

#. Occurrence 7_1:5889:8846: scene=7_1
#: 7_1:5889
msgctxt "text_id=8846 | speaker=unknown"
msgid "  A quick-and-dirty strategy-the assassin's strike."
msgstr "　即ち短期決戦。かつ、一撃必殺。"

#. Occurrence 7_1:5894:8847: scene=7_1
#: 7_1:5894
msgctxt "text_id=8847 | speaker=unknown"
msgid "  Manipulate someone's feelings with an expensive gift."
msgstr "　高価な贈り物で相手の意識を変えろ、というコトらしい。"

#. Occurrence 7_1:5919:8848: scene=7_1
#: 7_1:5919
msgctxt "text_id=8848 | speaker=unknown"
msgid "  To Soujyuro, this sounded like his best chance."
msgstr "　素晴らしい作戦だ、と草十郎も思う。"

#. Occurrence 7_1:5924:8849: scene=7_1
#: 7_1:5924
msgctxt "text_id=8849 | speaker=unknown"
msgid "  The approach was easy for him to grasp, and he appreciated its simplicity."
msgstr "　なによりシンプルなのがいい。わかりやすいのは彼にとってありがたい。"

#. Occurrence 7_1:5929:8850: scene=7_1
#: 7_1:5929
msgctxt "text_id=8850 | speaker=unknown"
msgid "  However, he had the same concerns as with the first approach."
msgstr "　しかし―――つまるところ、それも一つ目の作戦と同じ気がする。"

#. Occurrence 7_1:5934:8851: scene=7_1
#: 7_1:5934
msgctxt "text_id=8851 | speaker=unknown"
msgid "  A step was missing, and without this step the plan was bound to fail."
msgstr "　なにより、先立つものがないのが致命的だ。"

#. Occurrence 7_1:5963:8852: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0022_0; voice_prefix=B50; voice_category=6; scene=7_1
#. Occurrence 7_1:5970:8852: scene=7_1
#: 7_1:5963 7_1:5970
msgctxt "text_id=8852 | speaker=kinomi"
msgid "\"The only other option is...well, I guess you could call it 'wait and see.'"
msgstr "“あとは……まあ、<見|ケン>ってヤツ？"

#. Occurrence 7_1:5983:8853: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0022_1; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:5983
msgctxt "text_id=8853 | speaker=kinomi"
msgid "  I don't fully understand it myself, but they say if you try too hard, your plan's bound to backfire."
msgstr "　オレにはよくわかんねえけどさー、やりすぎると悪い印象を持たれるとか殿下がいってたなー。"

#. Occurrence 7_1:5995:8854: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0023; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:5995
msgctxt "text_id=8854 | speaker=kinomi"
msgid "  Like, you don't ever want the girl to have a sudden epiphany of 'Oh, now I love him!' It's better that it dawns on her after you've hung out together for a while, like, 'Wait...I think I like him!'\""
msgstr "　アタシ、いま落とされてる！　って意識させちゃダメなんだとよ。付き合った後で、アレ、アタシ落とされた？　と気づかせるのが上等なんだとか”"

#. Occurrence 7_1:6027:8855: scene=7_1
#: 7_1:6027
msgctxt "text_id=8855 | speaker=unknown"
msgid "  Though Soujyuro did not quite grasp the details he understood the basic idea: Don't press your luck."
msgstr "　言わんとするところはまったく分からないが、要は無理をするな、というコトらしい。"

#. Occurrence 7_1:6032:8856: scene=7_1
#: 7_1:6032
msgctxt "text_id=8856 | speaker=unknown"
msgid "  He knew that much was good advice."
msgstr "　まったく同感だ。"

#. Occurrence 7_1:6043:8857: scene=7_1
#: 7_1:6043
msgctxt "text_id=8857 | speaker=unknown"
msgid "  He would have to try extremely hard to get on Alice's good side."
msgstr "　気に入られる為に努力するのは正しい。"

#. Occurrence 7_1:6048:8858: scene=7_1
#: 7_1:6048
msgctxt "text_id=8858 | speaker=unknown"
msgid "  And he could tell it would be a long process to get there."
msgstr "　けれど、それにも段階があるのでは、と草十郎は思うのだ。"

#. Occurrence 7_1:6076:8859: scene=7_1
#: 7_1:6076
msgctxt "text_id=8859 | speaker=unknown"
msgid "  Soujyuro recalled the time he had wandered inside a fox's territory in the mountains."
msgstr "　昔、山で見知らぬ狐のテリトリーに入ってしまったコトを思いだす。"

#. Occurrence 7_1:6081:8860: scene=7_1
#: 7_1:6081
msgctxt "text_id=8860 | speaker=unknown"
msgid "  He had left some food on the ground for the fox, and then it never bothered him again."
msgstr "　あの時は手持ちの食べ物などを置いてしまったが、それ以降、狐の気配はなくなってしまった。"

#. Occurrence 7_1:6086:8861: scene=7_1
#: 7_1:6086
msgctxt "text_id=8861 | speaker=unknown"
msgid "  What is considered good will and kindness varies from person to person."
msgstr "　善意、懇意のカタチは人それぞれ。"

#. Occurrence 7_1:6091:8862: scene=7_1
#: 7_1:6091
msgctxt "text_id=8862 | speaker=unknown"
msgid "  But if there is enough good will from one side, regardless of whether that good will is reciprocated, the other side will eventually start to feel an obligation to do so."
msgstr "　一方的な善意は時として重荷になる。"

#. Occurrence 7_1:6096:8863: scene=7_1
#: 7_1:6096
msgctxt "text_id=8863 | speaker=unknown"
msgid "  That was key."
msgstr "　なので、"

#. Occurrence 7_1:6142:8864: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0025; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:6142
msgctxt "text_id=8864 | speaker=soujuurou"
msgid "\"It's okay, I'll think of something. For now, I can only do... what I can do."
msgstr "「大丈夫、考えてるよ。とりあえず自分にできるコトとか、したいコトをしようと思う。"

#. Occurrence 7_1:6149:8865: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0026; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:6149
msgctxt "text_id=8865 | speaker=soujuurou"
msgid "Don't worry. I've taken your counsel to heart, Aozaki.\""
msgstr "安心してくれ。蒼崎に忠告されたコトすら、きちんと守る方針だ」"

#. Occurrence 7_1:6178:8866: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0035; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:6178
msgctxt "text_id=8866 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 7_1:6185:8867: scene=7_1
#: 7_1:6185
msgctxt "text_id=8867 | speaker=unknown"
msgid "  Soujyuro seemed ready to face things head on."
msgstr "　まかせろ、と胸を張る草十郎。"

#. Occurrence 7_1:6190:8868: scene=7_1
#: 7_1:6190
msgctxt "text_id=8868 | speaker=unknown"
msgid "  His answer did little to reassure Aoko, however. She found herself more concerned about his safety than ever before."
msgstr "　まったく頼り甲斐のない返答に、ほんと大丈夫かコイツ、とつい親身になってしまう青子だった。"

#. Occurrence 7_1:6244:8869: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_1_0000; voice_prefix=B10; voice_category=5; scene=7_1
#: 7_1:6244
msgctxt "text_id=8869 | speaker=kojika"
msgid "\"You're looking for a broom like the ones at school?\""
msgstr "「学校にあるような<箒|ほうき>がほしい？」"

#. Occurrence 7_1:6289:8870: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0027; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:6289
msgctxt "text_id=8870 | speaker=soujuurou"
msgid "\"Yeah. The cheaper the better.\""
msgstr "「そうなんだ。できれば安く買えるところ」"

#. Occurrence 7_1:6301:8871: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_1_0001; voice_prefix=B10; voice_category=5; scene=7_1
#: 7_1:6301
msgctxt "text_id=8871 | speaker=kojika"
msgid "\"Don't you live in an apartment? Who needs a broom in an apartment?\""
msgstr "「……静希の家、アパートよね。箒なんてモノ必要とは思えないけど」"

#. Occurrence 7_1:6327:8872: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0028; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:6327
msgctxt "text_id=8872 | speaker=soujuurou"
msgid "\"Well, you know, I've been wanting to clean things up a little. I could use some trash bags, too.\""
msgstr "「いや、ちょっと気になるところがあって掃除がしたいんだ。ゴミ袋もあると助かる」"

#. Occurrence 7_1:6374:8873: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_1_0002; voice_prefix=B10; voice_category=5; scene=7_1
#: 7_1:6374
msgctxt "text_id=8873 | speaker=kojika"
msgid "\"Aren't you supposed to be broke or something?"
msgstr "「無駄な出費はできないって言ってたクセに。"

#. Occurrence 7_1:6380:8874: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_1_0003; voice_prefix=B10; voice_category=5; scene=7_1
#: 7_1:6380
msgctxt "text_id=8874 | speaker=kojika"
msgid "  Whatever. Wanna use my broom then? I'll lend it to you if you want.\""
msgstr "　ま、どうでもいいけど。うちのでよければ使う？　貸してあげましょうか？」"

#. Occurrence 7_1:6391:8875: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0029; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:6391
msgctxt "text_id=8875 | speaker=soujuurou"
msgid "\"Actually... I need it for longer than one day, so maybe it's best I buy my own."
msgstr "「たぶん一日じゃ終わらないから自分で買うよ。"

#. Occurrence 7_1:6397:8876: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0030; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:6397
msgctxt "text_id=8876 | speaker=soujuurou"
msgid "  I mean, I always wanted my own broom. Brooms are nice to have around, you know?\""
msgstr "　もとから欲しかったものだし。あると便利だよ、箒」"

#. Occurrence 7_1:6449:8877: scene=7_1
#: 7_1:6449
msgctxt "text_id=8877 | speaker=unknown"
msgid "  Soujyuro was on his way home from his part-time job after school."
msgstr "　学校が終わってから、アルバイトの帰り道。"

#. Occurrence 7_1:6467:8878: scene=7_1
#: 7_1:6467
msgctxt "text_id=8878 | speaker=unknown"
msgid "  It was four in the afternoon, two hours earlier than his part-time job would have normally ended."
msgstr "　時刻はバイト終了時間から二時間ほど早い午後四時。"

#. Occurrence 7_1:6472:8879: scene=7_1
#: 7_1:6472
msgctxt "text_id=8879 | speaker=unknown"
msgid "  The Mad Bear's head chef had gotten in trouble with the accountant for making a student work the day before exams. Thus, Soujyuro's boss had tearfully sent him home early."
msgstr "　試験前日に学生を拘束するとは何事か、とお店の会計係に叱られたまっどべあ料理長は泣く泣く草十郎を送りだしてくれた。"

#. Occurrence 7_1:6491:8880: scene=7_1
#: 7_1:6491
msgctxt "text_id=8880 | speaker=unknown"
msgid "  And that is when it happened."
msgstr "　そして。"

#. Occurrence 7_1:6496:8881: scene=7_1
#: 7_1:6496
msgctxt "text_id=8881 | speaker=unknown"
msgid "  The interruption to his standard schedule must have been just the shock he needed."
msgstr "　この二時間のタイムラグこそが、草十郎の明暗を分けるのだ。多分。"

#. Occurrence 7_1:6530:8882: scene=7_1
#: 7_1:6530
msgctxt "text_id=8882 | speaker=unknown"
msgid "  Normally, he would meet up with Aoko after she was done with student council affairs and go home with her."
msgstr "　本来の予定では、草十郎は生徒会の作業を終えてから下校する青子と合流し、久遠寺邸に向かわなければならない。"

#. Occurrence 7_1:6551:8883: scene=7_1
#: 7_1:6551
msgctxt "text_id=8883 | speaker=unknown"
msgid "  However, today, Soujyuro was asking the other students who worked at the same place if they knew any shops in the area where he could buy a broom."
msgstr "　が、何を思ったか草十郎はバイト仲間の同期生に、この近くで竹箒を売っている店はないかと訊ねていた。"

#. Occurrence 7_1:6584:8884: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_1_0004; voice_prefix=B10; voice_category=5; scene=7_1
#: 7_1:6584
msgctxt "text_id=8884 | speaker=kojika"
msgid "\"God, what's wrong with you? People from the countryside are like, so weird."
msgstr "「田舎者の趣味って理解不能ね。<酔狂|すいきょう>すぎ。"

#. Occurrence 7_1:6590:8885: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_1_0005; voice_prefix=B10; voice_category=5; scene=7_1
#: 7_1:6590
msgctxt "text_id=8885 | speaker=kojika"
msgid "  Anyway... You know that nasty ramen place near school? Just go to the end of that street and there's a hardware store called Okita."
msgstr "　<三咲高|うち>の近くにまっずいラーメン屋あるでしょ。あそこの通りを終わりまで行けば沖田って<金物|かなもの>店がある。"

#. Occurrence 7_1:6597:8886: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_1_0006; voice_prefix=B10; voice_category=5; scene=7_1
#: 7_1:6597
msgctxt "text_id=8886 | speaker=kojika"
msgid "It's way cheaper than the home supply store to the west of the station, as long as they have what you want, anyway."
msgstr "一式揃えるなら西口のホームセンターより安くあがるわ。"

#. Occurrence 7_1:6618:8887: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_1_0007; voice_prefix=B10; voice_category=5; scene=7_1
#: 7_1:6618
msgctxt "text_id=8887 | speaker=kojika"
msgid "  Use my bicycle if you want, I don't care. I won't need it until exams are over anyway.\""
msgstr "　……どうでもいいけど、わたしの<自転車|チャリ>使う？　どうせ試験明けまで使わないし」"

#. Occurrence 7_1:6652:8888: scene=7_1
#: 7_1:6652
msgctxt "text_id=8888 | speaker=unknown"
msgid "  Soujyuro's eyes lit up as if he had met his savior. But biking uphill to the mansion, let alone with a package to carry, was not a pretty thought."
msgstr "　思わぬ助け船に目を輝かせるが、久遠寺邸までの坂道を自転車で、しかも荷物を抱えて走るのは難しそうだ。"

#. Occurrence 7_1:6663:8889: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0031; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:6663
msgctxt "text_id=8889 | speaker=soujuurou"
msgid "\"I appreciate the offer, but I'll pass. See you at school tomorrow!\""
msgstr "「いや、自転車には乗ってみたいけど、今回は遠慮するよ。じゃあまた明日、学校で」"

#. Occurrence 7_1:6700:8890: scene=7_1
#: 7_1:6700
msgctxt "text_id=8890 | speaker=unknown"
msgid "  Saying farewell to his co-workers he headed to the hardware store."
msgstr "　少女に礼を言って金物店に向かう。"

#. Occurrence 7_1:6710:8891: scene=7_1
#: 7_1:6710
msgctxt "text_id=8891 | speaker=unknown"
msgid "  He needed a cheap and sturdy bamboo broom and a large dustpan to go with it."
msgstr "　目的は安くて丈夫な竹箒と、大型のチリ取り。"

#. Occurrence 7_1:6715:8892: scene=7_1
#: 7_1:6715
msgctxt "text_id=8892 | speaker=unknown"
msgid "  If possible, a pushcart and stick for a splint would have been nice, too. As it happened, Soujyuro wanted quite a few things."
msgstr "　できれば台車や添え木用の棒もほしい、といざ考えだすと色々なものが欲しい草十郎だった。"

#. Occurrence 7_1:6753:8893: scene=7_1
#: 7_1:6753
msgctxt "text_id=8893 | speaker=unknown"
msgid "  Alice returned to her work after waking from her nap."
msgstr "　<午睡|ごすい>から目を覚ますと、少女は作業を再開した。"

#. Occurrence 7_1:6786:8894: scene=7_1
#: 7_1:6786
msgctxt "text_id=8894 | speaker=unknown"
msgid "  The Kuonji Estate had an annex that housed a library."
msgstr "　久遠寺邸には別館があり、その内部は図書室になっている。"

#. Occurrence 7_1:6791:8895: scene=7_1
#: 7_1:6791
msgctxt "text_id=8895 | speaker=unknown"
msgid "  The library was filled with books handed down to her from her mother, so it was Alice's territory such that even Aoko dared not enter."
msgstr "　少女の母から受け継いだ書物を収蔵したそこは、同居人である蒼崎青子も立ち入る事を<躊躇|ちゅうちょ>する領域だ。"

#. Occurrence 7_1:6796:8896: scene=7_1
#: 7_1:6796
msgctxt "text_id=8896 | speaker=unknown"
msgid "  If the mansion was a witch's abode, left behind by the times,"
msgstr "　久遠寺邸が時代に取り残された魔女の館なら、"

#. Occurrence 7_1:6801:8897: scene=7_1
#: 7_1:6801
msgctxt "text_id=8897 | speaker=unknown"
msgid "  the library was a fairy-tale quarters, lost to the ages."
msgstr "　この図書室は時代に忘れ去られた<御伽|おとぎ>の部屋。"

#. Occurrence 7_1:6806:8898: scene=7_1
#: 7_1:6806
msgctxt "text_id=8898 | speaker=unknown"
msgid "  It was a natural sanctuary for the young witch who could command Ploys to do her bidding."
msgstr "　童話を操る幼い魔女からすれば、必然、相性の良い聖域と言える。"

#. Occurrence 7_1:6864:8899: scene=7_1
#: 7_1:6864
msgctxt "text_id=8899 | speaker=unknown"
msgid "  She relied on her memory to recall the location of each book on the many shelves."
msgstr "　少女は記憶を頼りに本棚を巡っていく。"

#. Occurrence 7_1:6869:8900: scene=7_1
#: 7_1:6869
msgctxt "text_id=8900 | speaker=unknown"
msgid "  And then she saw it."
msgstr "　……と。"

#. Occurrence 7_1:6880:8901: scene=7_1
#: 7_1:6880
msgctxt "text_id=8901 | speaker=unknown"
msgid "  Upon raising her head she was met with the most unusual of sights."
msgstr "　なんとなしに顔を上げた時、おかしな風景を見てしまった。"

#. Occurrence 7_1:6914:8902: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0025; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:6914
msgctxt "text_id=8902 | speaker=alice"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence 7_1:6920:8903: scene=7_1
#: 7_1:6920
msgctxt "text_id=8903 | speaker=unknown"
msgid "  Her elegant eyebrows bristled in distaste."
msgstr "　優美な眉が不満げに寄せられる。"

#. Occurrence 7_1:6930:8904: scene=7_1
#: 7_1:6930
msgctxt "text_id=8904 | speaker=unknown"
msgid "  From that moment on, she failed to accomplish anything she had planned for that day."
msgstr "　その後の予定は、なにひとつ守れなかった。"

#. Occurrence 7_1:6935:8905: scene=7_1
#: 7_1:6935
msgctxt "text_id=8905 | speaker=unknown"
msgid "  She was instead forced to stare at the strange sight outside her window, eyebrows fixed in that position until the sun set."
msgstr "　少女は日が暮れるまで眉のカタチを変えず、じっと、窓の外のおかしな景色を眺めていたからだ。"

#. Occurrence 7_1:7026:8906: scene=7_1
#: 7_1:7026
msgctxt "text_id=8906 | speaker=unknown"
msgid "  Ah well."
msgstr "　―――とまあ。"

#. Occurrence 7_1:7032:8907: scene=7_1
#: 7_1:7032
msgctxt "text_id=8907 | speaker=unknown"
msgid "  Moving into the grand mansion on the hill had not brought any major changes to Soujyuro's day-to-day schedule."
msgstr "　丘の上の洋館で寝泊りするようになっても、草十郎の日常に、とりわけ大きな変化は訪れなかった。"

#. Occurrence 7_1:7052:8908: scene=7_1
#: 7_1:7052
msgctxt "text_id=8908 | speaker=unknown"
msgid "  He woke up,"
msgstr "　起床、"

msgctxt "text_id=8909 | speaker=unknown"
msgid " went to his part-time job,"
msgstr "アルバイト、"

msgctxt "text_id=8910 | speaker=unknown"
msgid " ate breakfast,"
msgstr "朝食、"

msgctxt "text_id=8911 | speaker=unknown"
msgid " and went to school."
msgstr "登校。"

#. Occurrence 7_1:7106:8912: scene=7_1
#: 7_1:7106
msgctxt "text_id=8912 | speaker=unknown"
msgid "  Classes came and went, still strange and new,"
msgstr "　慣れない授業、"

msgctxt "text_id=8913 | speaker=unknown"
msgid " broken up by rare and brief moments of rest,"
msgstr "数少ない憩いの休み時間、"

msgctxt "text_id=8914 | speaker=unknown"
msgid " until the school day ended."
msgstr "放課後。"

#. Occurrence 7_1:7147:8915: scene=7_1
#: 7_1:7147
msgctxt "text_id=8915 | speaker=unknown"
msgid "  He left school,"
msgstr "　下校、"

msgctxt "text_id=8916 | speaker=unknown"
msgid " went to his part-time job,"
msgstr "アルバイト、"

msgctxt "text_id=8917 | speaker=unknown"
msgid " slept,"
msgstr "仮眠、"

msgctxt "text_id=8918 | speaker=unknown"
msgid " woke up,"
msgstr "起床、"

msgctxt "text_id=8919 | speaker=unknown"
msgid " and studied for exams."
msgstr "試験勉強。"

#. Occurrence 7_1:7240:8920: scene=7_1
#: 7_1:7240
msgctxt "text_id=8920 | speaker=unknown"
msgid "  A modest life for a modest young man, continuing every day in the same fashion despite his best efforts to change his fortune."
msgstr "　ささやかな少年のささやかな日常は、本人の努力とは正反対に、<為|な>す<術|すべ>なく流れていく。"

#. Occurrence 7_1:7260:8921: scene=7_1
#: 7_1:7260
msgctxt "text_id=8921 | speaker=unknown"
msgid "  But nothing ever really changes."
msgstr "　状況は一向に変わらない。"

#. Occurrence 7_1:7265:8922: scene=7_1
#: 7_1:7265
msgctxt "text_id=8922 | speaker=unknown"
msgid "  Whether Aoko was by his side in the mansion, as was frequently the case,"
msgstr "　館内では頻繁に青子が隣にいたり、"

#. Occurrence 7_1:7270:8923: scene=7_1
#: 7_1:7270
msgctxt "text_id=8923 | speaker=unknown"
msgid "  or whether Alice was making him drink some potion she prepared before going to bed."
msgstr "　眠る前に有珠の用意した薬を飲まされたりするのも同じ。"

#. Occurrence 7_1:7276:8924: scene=7_1
#: 7_1:7276
msgctxt "text_id=8924 | speaker=unknown"
msgid "  The former was an attempt by Aoko to make him feel better,"
msgstr "　前者は草十郎の安全を考慮した青子のフォローであり、"

#. Occurrence 7_1:7281:8925: scene=7_1
#: 7_1:7281
msgctxt "text_id=8925 | speaker=unknown"
msgid "  the latter was some attempt to keep him safe, even if he did not fully appreciate it."
msgstr "　後者は、理屈は分からないが、やっぱり彼の安全のためだという。"

#. Occurrence 7_1:7328:8926: scene=7_1
#: 7_1:7328
msgctxt "text_id=8926 | speaker=unknown"
msgid "  Then, one day, a day like any other, while Soujyuro was pouring himself some tea as he worried over the lack of change in his life..."
msgstr "　そして。今朝も今朝とて何の変化もない状況に頭を悩ませつつ、草十郎は朝の紅茶を淹れていた。"

#. Occurrence 7_1:7335:8927: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0032; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:7335
msgctxt "text_id=8927 | speaker=soujuurou"
msgid "\"...Oh, by the way.\""
msgstr "「…………ああ、そう言えば」"

#. Occurrence 7_1:7341:8928: scene=7_1
#: 7_1:7341
msgctxt "text_id=8928 | speaker=unknown"
msgid "  His relationship with Alice was the same as ever, but there was one major change this morning-he was drinking black tea instead of green."
msgstr "　有珠との関係に変化はないが、大きな変化はここにある。草十郎の朝の一服は、煎茶から紅茶に変わっていた。"

#. Occurrence 7_1:7373:8929: scene=7_1
#: 7_1:7373
msgctxt "text_id=8929 | speaker=unknown"
msgid "  Though there were all sorts of different types of tea to be found in the kitchen, a newcomer to the world of tea like Soujyuro could not tell one of them from the next."
msgstr "　台所には様々な紅茶の葉があるが、ビギナーである草十郎には無用の長物だ。"

#. Occurrence 7_1:7379:8930: scene=7_1
#: 7_1:7379
msgctxt "text_id=8930 | speaker=unknown"
msgid "  Naturally his tea-making skills were limited to tea bags, one of which he placed in his cup before returning to the dining table."
msgstr "　彼の用意する紅茶は当然ティーバッグで、自分用に一杯<淹|い>れて<食卓|サンルーム>に移動する。"

#. Occurrence 7_1:7399:8931: scene=7_1
#: 7_1:7399
msgctxt "text_id=8931 | speaker=unknown"
msgid "  Alice and Aoko were already seated."
msgstr "　テーブルには先客が二名。"

#. Occurrence 7_1:7404:8932: scene=7_1
#: 7_1:7404
msgctxt "text_id=8932 | speaker=unknown"
msgid "  The two were eating in silence."
msgstr "　青子と有珠は無言で朝食を<摂|と>っている。"

#. Occurrence 7_1:7410:8933: scene=7_1
#: 7_1:7410
msgctxt "text_id=8933 | speaker=unknown"
msgid "  In this household it was everyone for themselves when it came to breakfast."
msgstr "　久遠寺邸において、朝食は完全個人主義だ。"

#. Occurrence 7_1:7415:8934: scene=7_1
#: 7_1:7415
msgctxt "text_id=8934 | speaker=unknown"
msgid "  The diplomatic description of their breakfasts would be \"simple.\" The more accurate description would be \"two slices of stale bread prepared in seconds.\""
msgstr "　ふたりの朝食は<婉曲|えんきょく>に言えば質素な―――真実を言うと用意に二秒もかからない、堅そうな石窯パン一つきりである。"

#. Occurrence 7_1:7449:8935: scene=7_1
#: 7_1:7449
msgctxt "text_id=8935 | speaker=unknown"
msgid "  Aoko exchanged a word or two with Alice, took a sip of tea, and stood up from her seat."
msgstr "　青子たちは<時折|ときおり>言葉を交わすと、最後に紅茶を一口だけ<啜|すす>って席を立つ。"

#. Occurrence 7_1:7460:8936: scene=7_1
#: 7_1:7460
msgctxt "text_id=8936 | speaker=unknown"
msgid "  Since it was winter break for the high-schooler Alice, she returned to her room after eating as she normally did,"
msgstr "　有珠はもう高校が冬休みに入っているのでそのまま自室へ戻り、"

msgctxt "text_id=8937 | speaker=unknown"
msgid " while Aoko headed to the front door, shoes in hand, ready for school."
msgstr "青子はこれから学校なので鞄を片手に玄関へ。"

#. Occurrence 7_1:7479:8938: scene=7_1
#: 7_1:7479
msgctxt "text_id=8938 | speaker=unknown"
msgid "  After hurriedly clearing the table, Soujyuro rushed out the door after Aoko."
msgstr "　草十郎も食器を片づけた後、青子の後を追って洋館を後にする。"

#. Occurrence 7_1:7484:8939: scene=7_1
#: 7_1:7484
msgctxt "text_id=8939 | speaker=unknown"
msgid "  Together they walked down the long hill in the direction of school."
msgstr "　ふたりは長い坂を下りて学校へ。"

#. Occurrence 7_1:7513:8940: scene=7_1
#: 7_1:7513
msgctxt "text_id=8940 | speaker=unknown"
msgid "  They had spent three days following this very simple routine."
msgstr "　三日間はこんな風に、実に簡潔に過ぎてしまった。"

#. Occurrence 7_1:7559:8941: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0036; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:7559
msgctxt "text_id=8941 | speaker=aoko"
msgid "\"So, any word on you-know-who?\""
msgstr "「ところで、あれから動きはあった？」"

#. Occurrence 7_1:7583:8942: scene=7_1
#: 7_1:7583
msgctxt "text_id=8942 | speaker=unknown"
msgid "  School had ended, and evening had arrived."
msgstr "　授業も終えた夕刻時。"

#. Occurrence 7_1:7588:8943: scene=7_1
#: 7_1:7588
msgctxt "text_id=8943 | speaker=unknown"
msgid "  Buttered bread roll in one hand, Alice replied with a simple, silent shake of her head."
msgstr "　青子の問いに、有珠は掴んだバターロールもそのままに、首を横に振るだけで『いいえ』と答えた。"

#. Occurrence 7_1:7610:8944: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0037; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:7610
msgctxt "text_id=8944 | speaker=aoko"
msgid "\"Thought so. The enemy must be considering their next move too."
msgstr "「そう。なら、<敵側|あっち>も次の手を考えているんでしょうね。"

#. Occurrence 7_1:7610:8945: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0037; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:7610
msgctxt "text_id=8945 | speaker=aoko"
msgid "  Have you figured out where the mage is?\""
msgstr "　魔術師本体の居場所は見当ついてる？」"

#. Occurrence 7_1:7631:8946: scene=7_1
#: 7_1:7631
msgctxt "text_id=8946 | speaker=unknown"
msgid "  Her response was exactly the same."
msgstr "　返答はまったく同じ。"

#. Occurrence 7_1:7653:8947: scene=7_1
#: 7_1:7653
msgctxt "text_id=8947 | speaker=unknown"
msgid "  Without showing the slightest sign of dejection she continued to chew the roll and took a stab at her salad."
msgstr "　落胆した風もなく、青子はバターロールを一口噛んでからサラダにフォークを突き刺した。"

#. Occurrence 7_1:7681:8948: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0038; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:7681
msgctxt "text_id=8948 | speaker=aoko"
msgid "\"Okay then. I'll help you once exams are over if you can manage on your own till then. I have to help that idiot study so my schedule is pretty warped.\""
msgstr "「そ。私も試験が終わったら手伝うから、それまで悪いけどひとりでやってて。今日からあのバカを一夜漬けにしなくちゃいけないんで、余裕ないの」"

#. Occurrence 7_1:7704:8949: scene=7_1
#: 7_1:7704
msgctxt "text_id=8949 | speaker=unknown"
msgid "  Alice's face grew dour as if she had something to get off her chest."
msgstr "　それには思うところがあるのか、有珠はわずかに顔を曇らせた。"

#. Occurrence 7_1:7740:8950: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0039; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:7740
msgctxt "text_id=8950 | speaker=aoko"
msgid "\"Don't give me that look. You're on winter break, you can spend all day working on it, can't you?\""
msgstr "「？　問題ないでしょ、有珠はもう休みに入ってるんだから。一日ぜんぶ使えるじゃない」"

#. Occurrence 7_1:7778:8951: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0026; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:7778
msgctxt "text_id=8951 | speaker=alice"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 7_1:7783:8952: scene=7_1
#: 7_1:7783
msgctxt "text_id=8952 | speaker=unknown"
msgid "  Alice was indeed on vacation and could spend all day every day on her work as a mage."
msgstr "　たしかに有珠は冬休み中で、一日のすべてを魔術師としての生活に<費|つい>やしている。"

#. Occurrence 7_1:7788:8953: scene=7_1
#: 7_1:7788
msgctxt "text_id=8953 | speaker=unknown"
msgid "  Yet she had spent the past few days holed up in the library instead."
msgstr "　ただ、ここ数日はある理由で図書室に籠もりきりだった。"

#. Occurrence 7_1:7793:8954: scene=7_1
#: 7_1:7793
msgctxt "text_id=8954 | speaker=unknown"
msgid "  She was hardly devoting herself to \"dealing with the challenger,\" as Aoko put it."
msgstr "　青子の言う“挑戦者への対策”に徹していたワケでもない。"

#. Occurrence 7_1:7839:8955: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0040; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:7839
msgctxt "text_id=8955 | speaker=aoko"
msgid "\"Alice? Are you listening?\""
msgstr "「有珠？　聞いてる？」"

#. Occurrence 7_1:7872:8956: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0027; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:7872
msgctxt "text_id=8956 | speaker=alice"
msgid "\"Yes. I'll get to work on it tonight.\""
msgstr "「……分かってる。今夜から、そっちもやるから」"

#. Occurrence 7_1:7883:8957: scene=7_1
#: 7_1:7883
msgctxt "text_id=8957 | speaker=unknown"
msgid "  Sighing, she stood up."
msgstr "　ため息まじりに返答して席を立つ。"

#. Occurrence 7_1:7914:8958: scene=7_1
#: 7_1:7914
msgctxt "text_id=8958 | speaker=unknown"
msgid "  What was bothering Alice, and what was it she wanted to say?"
msgstr "　……何が気になって、何が言いたかったのか。"

#. Occurrence 7_1:7919:8959: scene=7_1
#: 7_1:7919
msgctxt "text_id=8959 | speaker=unknown"
msgid "  What had she been doing only two hours earlier?"
msgstr "　ほんの二時間前、彼女が何をしていたのか。"

#. Occurrence 7_1:7935:8960: scene=7_1
#: 7_1:7935
msgctxt "text_id=8960 | speaker=unknown"
msgid "  The young witch took her leave from the breakfast table without offering a single clue."
msgstr "　それらの出来事を飲みこんで、有珠は食卓から去っていった。"

msgctxt "text_id=8961 | speaker=unknown"
msgid "  Two hours earlier..."
msgstr "　その、二時間前の話―――"

msgctxt "text_id=8962 | speaker=unknown"
msgid "  Her dreams at night often involved"
msgstr "　眠りに落ちて見る夢は、"

msgctxt "text_id=8963 | speaker=unknown"
msgid "  memories from when she was young."
msgstr "　たいてい、幼い頃の記憶だった。"

msgctxt "text_id=8964 | speaker=unknown"
msgid "  In the northeast of England,"
msgstr "　イングランドの北西部。"

msgctxt "text_id=8965 | speaker=unknown"
msgid "  there was a misty oak forest."
msgstr "　深い霧に覆われたオークの森。"

msgctxt "text_id=8966 | speaker=unknown"
msgid "  This was a land of birds and beasts, a land untouched by the modern era, where no human dared to enter."
msgstr "　二十世紀にあっても人を寄せ付けない、鳥と獣たちの王国。"

msgctxt "text_id=8967 | speaker=unknown"
msgid "  There, deep within the woods, was the home where she was born and raised."
msgstr "　その一角に、彼女の生まれ育った家があった。"

msgctxt "text_id=8968 | speaker=unknown"
msgid "  The woods were an ancient creature unto themselves, existing for generations."
msgstr "　何代と続いてきた古い生き物。"

msgctxt "text_id=8969 | speaker=unknown"
msgid "  Her venerable-or perhaps foolish-ancestors had insisted on maintaining its purity, passing this tradition of the First Witches down to their descendants."
msgstr "　偉大な、あるいは愚かな先祖の言いつけ通り、かたくなに純潔を守り続けた、原初の魔女の<末裔|まつえい>たち。"

msgctxt "text_id=8970 | speaker=unknown"
msgid "  Alice did not know for certain how far back her family line extended."
msgstr "　先代たちがどれほどの年月を重ねてきたのか、少女は正確に把握していない。"

msgctxt "text_id=8971 | speaker=unknown"
msgid "  This knowledge had been passed down the generations without fail until her mother, but Alice only knew what she'd been taught via oral tradition."
msgstr "　少女の母までは確かに伝わっていたが、少女には<口伝|くでん>でしか教えられなかった。"

msgctxt "text_id=8972 | speaker=unknown"
msgid "  Thus, no one alive knew exactly when those first women made those woods their home."
msgstr "　だから、彼女たちがその土地に根を下ろしてどれほどの年月が経っていたのか、知るものはもう誰もいない。"

msgctxt "text_id=8973 | speaker=unknown"
msgid "  The traditions had been forgotten,"
msgstr "　伝統はすっかり<剥|は>がれ落ちて、"

msgctxt "text_id=8974 | speaker=unknown"
msgid "  and by the time she was born"
msgstr "　角をいただいた白馬も、"

msgctxt "text_id=8975 | speaker=unknown"
msgid "  there were no horned white horses,"
msgstr "　虹色にはばたく鳥も、"

msgctxt "text_id=8976 | speaker=unknown"
msgid "  no rainbow-colored birds flying in the sky."
msgstr "　少女が生まれた時には影も形も見あたらなかった。"

msgctxt "text_id=8977 | speaker=unknown"
msgid "  Instead, what she had was a collection of modern furniture."
msgstr "　代わりにあるものと言えば、少女の家には不釣り合いな、近代的な家具の数々だった。"

msgctxt "text_id=8978 | speaker=unknown"
msgid "  Furniture that was neither befitting those woods' legacy, nor the rooms it sat in. And though their fabric was far too rough for a young woman's skin, still they were not wholly uncomfortable to sit on."
msgstr "　それらは森の空気にも少女の肌にも合わなかったが、決して不快なものではなかったと憶えている。"

msgctxt "text_id=8979 | speaker=unknown"
msgid "  The collection was her inheritance granted to her mother and then to her,"
msgstr "　時代遅れの母と、"

msgctxt "text_id=8980 | speaker=unknown"
msgid "  both old-fashioned women from a bygone era."
msgstr "　時代遅れの自分に贈られた記念品。"

msgctxt "text_id=8981 | speaker=unknown"
msgid "  She knew the furniture had been a gift from a man from nearby Manchester who visited her mother once a week,"
msgstr "　それらに愛情を抱いたのは、"

msgctxt "text_id=8982 | speaker=unknown"
msgid "  and this pleased her somehow in a childlike way, stoking her sense of nostalgia."
msgstr "　一週間に一度、<近くの都市|マンチェスター>からやってくる男性からの贈り物である事を、子供心に分かっていたからだろう。"

msgctxt "text_id=8983 | speaker=unknown"
msgid "  Indeed, only nostalgia and old furniture remained."
msgstr "　……それも、今では失われた。"

msgctxt "text_id=8984 | speaker=unknown"
msgid "  No sparkling Cadillac with a chauffeur,"
msgstr "　きらきら光る運転手付きの<高級車|キャデラック>も、"

msgctxt "text_id=8985 | speaker=unknown"
msgid "  no gardens grand enough for a castle,"
msgstr "　お城のような<花園|ガーデン>も、"

msgctxt "text_id=8986 | speaker=unknown"
msgid "  and no adults filling the space with life."
msgstr "　たくさんの大人たちも、"

msgctxt "text_id=8987 | speaker=unknown"
msgid "  They had all disappeared like the mist."
msgstr "　<霧|きり>のように消えてしまった。"

msgctxt "text_id=8988 | speaker=unknown"
msgid "  ...Or perhaps they disappeared into the mist."
msgstr "　あるいは、霧の中に消えてしまった。"

msgctxt "text_id=8989 | speaker=unknown"
msgid "  No longer could Alice see the smiling faces of her parents, her mother's filled with happiness"
msgstr "　幸せに満ちた母の笑顔も、"

msgctxt "text_id=8990 | speaker=unknown"
msgid "  and her father's sweet as a honeycomb."
msgstr "　はにかむような父の笑顔もない。"

msgctxt "text_id=8991 | speaker=unknown"
msgid "  The woods had prohibited such things from her earliest days."
msgstr "　そんなもの、初めから森が<赦|ゆる>しはしなかったのだ。"

msgctxt "text_id=8992 | speaker=unknown"
msgid "  ...All that remained were hazy doubts."
msgstr "　……今はただ、疑問だけが残っている。"

msgctxt "text_id=8993 | speaker=unknown"
msgid "  Still, countless oddities around the mansion remained."
msgstr "　洋館には不釣り合いだった数々の異物。"

msgctxt "text_id=8994 | speaker=unknown"
msgid "  There were priceless items which she had never wished for."
msgstr "　何ひとつ自分が望んだわけではない高級品。"

msgctxt "text_id=8995 | speaker=unknown"
msgid "  Gifts, which only served to irritate her."
msgstr "　ただ<厭|いや>らしいだけの贈り物。"

msgctxt "text_id=8996 | speaker=unknown"
msgid "  How could she have ever handled them so fondly? Alice found herself unable to relate to her former self."
msgstr "　それを、あんなにも<愛|いと>おしく<触|ふ>れていたのは、一体どんな気の迷いだったのか―――"

msgctxt "text_id=8997 | speaker=unknown"
msgid "\"...\""
msgstr "「――――――」"

msgctxt "text_id=8998 | speaker=unknown"
msgid "  Her closed eyelids fluttered."
msgstr "　閉じられた<目蓋|まぶた>がかすかに動く。"

msgctxt "text_id=8999 | speaker=unknown"
msgid "  It was afternoon, the sun still hiding behind clouds."
msgstr "　日が<翳|かげ>りだす前の午後。"

msgctxt "text_id=9000 | speaker=unknown"
msgid "  She was called back to the waking world, not by the sound her own ears could hear, but by the mansion reacting to it."
msgstr "　少女は自分の耳ではなく、館が聞き届けた音に反応して、うっすらと意識を起こした。"

msgctxt "text_id=9001 | speaker=unknown"
msgid "  A small bluish bird piped up, perhaps worried by the painful-looking way she squeezed her eyes shut."
msgstr "　辛そうに目蓋を押さえる少女を気遣ってか、鳴き声をあげる青い小鳥。"

msgctxt "text_id=9002 | speaker=unknown"
msgid "  Her vision was still blurred with sleep."
msgstr "　少女はぼんやりとした目で、"

msgctxt "text_id=9003 | speaker=unknown"
msgid "\"How odd. You look just like a bird I met in my dreams once upon a time.\""
msgstr "「……不思議ね。ずっと昔の、鳥の夢を見たわ」"

msgctxt "text_id=9004 | speaker=unknown"
msgid "  Speaking these words, she felt the details of her dream fading."
msgstr "　薄れていく夢の<内容|きおく>に<縋|すが>るように、独り言を口にした。"

msgctxt "text_id=9005 | speaker=unknown"
msgid "  The robin frolicked, as if proud to be the bird of which she spoke."
msgstr "　鳥と聞いて、我が事のようにはしゃぐ駒鳥。"

msgctxt "text_id=9006 | speaker=unknown"
msgid "\"Don't worry. I can scarcely recall the dream now, but I know it wasn't you I dreamt of."
msgstr "「……安心して。ほとんど覚えていないけど、貴方じゃない事だけは確かだから。"

msgctxt "text_id=9007 | speaker=unknown"
msgid "  ...And what's making that noise?\""
msgstr "　それよりこの音、なに？」"

msgctxt "text_id=9008 | speaker=unknown"
msgid "  She stared coldly at the now disappointed bird as she demanded her answer."
msgstr "　<肩|はね>を落としてがっかりする駒鳥に、少女は冷たい目のまま追及する。"

msgctxt "text_id=9009 | speaker=unknown"
msgid "  Then, she realized what had drawn her out of her slumber."
msgstr "　……彼女が目を覚ました原因。"

msgctxt "text_id=9010 | speaker=unknown"
msgid "  It was the grating noise ringing out from the mansion's rear courtyard."
msgstr "　館の裏庭の方から響く、<耳障|みみざわ>りな雑音について。"

msgctxt "text_id=9011 | speaker=unknown"
msgid "  The robin had detected the clamor, and come to alert the head of household."
msgstr "　裏庭からの雑音がなんなのか熟知していた駒鳥は、胸を張って主人に報告する。"

msgctxt "text_id=9012 | speaker=unknown"
msgid "  She listened. And all at once her grogginess vanished without a trace."
msgstr "　聞いて。少女の眠気は、今度こそ霧散した。"

msgctxt "text_id=9013 | speaker=unknown"
msgid "\"Ah yes. He's not only hard on the eyes, but also on the ears, it seems.\""
msgstr "「…………そう。<目障|めざわ>りなだけでなく、<耳障|みみざわ>りにまでさせてくれるのね、彼」"

msgctxt "text_id=9014 | speaker=unknown"
msgid "  Her disinterested remark had less to do with her position as resident witch, than with her irrational irritation."
msgstr "　つまらなげに漏らした言葉は、魔女としての責務とはまた違う、いわれのない個人的な<感情|いらだち>を含んでいた。"

msgctxt "text_id=9015 | speaker=unknown"
msgid "  A long-unused pump was the source of the ruckus."
msgstr "　長らく使われていなかったポンプが、ギッコギッコと音を立てる。"

msgctxt "text_id=9016 | speaker=unknown"
msgid "  There, in the Kuonji Estate's courtyard..."
msgstr "　久遠寺邸の裏庭。"

msgctxt "text_id=9017 | speaker=unknown"
msgid "  A slim silhouette was visible against the trees, as the day crept closer to sundown."
msgstr "　じき日没を迎える森には<痩身|そうしん>の人影があった。"

msgctxt "text_id=9018 | speaker=unknown"
msgid "  Glancing furtively around the trees, the figure was gathering everything from plastic bags to an illegally abandoned bicycle. At times, the figure attempted to mend broken tree branches, while at other times he resolutely pruned them."
msgstr "　人影はきょろきょろと森を見渡しながら、草むらに埋もれたビニール袋や不法投棄された自転車を片付けたり、まれに、折れかかった木の枝などを補強したり、ひと思いに伐採などしていたりする。"

msgctxt "text_id=9019 | speaker=unknown"
msgid "\"Hrm. What a mess.\""
msgstr "「む、これはひどい」"

msgctxt "text_id=9020 | speaker=unknown"
msgid "  It was surely the fault of one of the two roommates."
msgstr "　おそらく洋館に住んでいる人物、どちらかの手によるものだろう。"

msgctxt "text_id=9021 | speaker=unknown"
msgid "  Wild dogs had gotten into the mansion's storage shed, torn open some trash bags, and made an enormous mess."
msgstr "　館の物置に放置されたゴミ袋が野犬によってここまで運ばれ、無惨に食い散らかされていた。"

msgctxt "text_id=9022 | speaker=unknown"
msgid "  Bamboo broom in hand, Soujyuro set himself to silently tidying things up."
msgstr "　彼は持参した竹箒を片手に、黙々とゴミを片づける。"

msgctxt "text_id=9023 | speaker=unknown"
msgid "\"...\""
msgstr "「………………」"

msgctxt "text_id=9024 | speaker=unknown"
msgid "  Alice approached the figure on the pretense of taking a morning walk."
msgstr "　有珠は散歩中という<体|てい>で、その人影に出くわした。"

msgctxt "text_id=9025 | speaker=unknown"
msgid "  She took such walks once a month at most, but she had special reason for taking this one."
msgstr "　<一月|ひとつき>に一度あるかないかの森の散歩が今である理由は、あえて語るまでもない。"

msgctxt "text_id=9026 | speaker=unknown"
msgid "\"Sizuki.\""
msgstr "「静希君」"

msgctxt "text_id=9027 | speaker=unknown"
msgid "\"Hello. Are you going out?\""
msgstr "「こんにちは。今から外出？」"

msgctxt "text_id=9028 | speaker=unknown"
msgid "  He replied casually."
msgstr "　気軽に挨拶など返される。"

msgctxt "text_id=9029 | speaker=unknown"
msgid "  Alice surveyed the trees around her with as cold a gaze as she could muster."
msgstr "　有珠は努めて視線を冷たくして、森の様子を観察した。"

msgctxt "text_id=9030 | speaker=unknown"
msgid "\"No, I'm not going anywhere."
msgstr "「出かけないわ。"

msgctxt "text_id=9031 | speaker=unknown"
msgid "And what, may I ask, are you doing out here? I thought you would be coming home from school with Aoko later. Where is she?\""
msgstr "そういう貴方は何を？　青子と一緒に帰ってくるものと思っていたけど、青子は？」"

msgctxt "text_id=9032 | speaker=unknown"
msgid "\"Aozaki's still at school. I finished work early today, so I'm just passing the time."
msgstr "「蒼崎ならまだ学校。こっちはバイトが早めに終わったんで、ここで暇を潰している。"

msgctxt "text_id=9033 | speaker=unknown"
msgid "I'll meet her at the front gate later and walk her back.\""
msgstr "夕方になったら正門で蒼崎と合流して、洋館に戻るよ」"

msgctxt "text_id=9034 | speaker=unknown"
msgid "\"I see. But did you tell her you were coming home early today?\""
msgstr "「……そう。でも、貴方が先に帰ってきている事を、青子には伝えてあるの？」"

msgctxt "text_id=9035 | speaker=unknown"
msgid "\"Oh. Uh...\""
msgstr "「あ」"

msgctxt "text_id=9036 | speaker=unknown"
msgid "  Soujyuro stumbled over his words with obvious unease."
msgstr "　しまった、と草十郎は不安げに言葉を切った。"

msgctxt "text_id=9037 | speaker=unknown"
msgid "\"So we'll meet at the mansion's front gate at five! Got it?\" "
msgstr "“いい？　洋館の正門前、五時だからね！”"

msgctxt "text_id=9038 | speaker=unknown"
msgid "  And he had every intension of doing as promised."
msgstr "　その約束は当然守る気満々だった。"

msgctxt "text_id=9039 | speaker=unknown"
msgid "  But maybe what Aoko really meant to say was \"Stay away from the mansion until five o'clock!\""
msgstr "　が、今にして思うと、それは“五時まで洋館に入るな”というコトだったのかもしれない。"

msgctxt "text_id=9040 | speaker=unknown"
msgid "\"I'm sorry. Please don't tell Aozaki about this.\""
msgstr "「……申し訳ない。蒼崎には黙っていてくれると助かる」"

msgctxt "text_id=9041 | speaker=unknown"
msgid "\"Don't worry, I won't. Besides, we never talk about you anyway."
msgstr "「別に。青子との会話で、貴方の話題があがる事はないから気にしないで。"

msgctxt "text_id=9042 | speaker=unknown"
msgid "  What exactly are you doing here? I thought you and Aoko have exams. Shouldn't you be studying?\""
msgstr "　……それより何をしているの？　貴方と青子、今日から期末試験でしょう？　勉強、しなくていいの？」"

msgctxt "text_id=9043 | speaker=unknown"
msgid "\"What? Oh, I haven't neglected to study."
msgstr "「うん？　勉強ならちゃんとするよ。"

msgctxt "text_id=9044 | speaker=unknown"
msgid "  I do two hours every night before I go to bed.\""
msgstr "　寝る前にきちんと、二時間」"

msgctxt "text_id=9045 | speaker=unknown"
msgid "  He was not yet familiar with the common student concept of \"cramming.\""
msgstr "　どうも、彼にはまだ“試験前は念入りに復習をする”知恵がないようだ。"

msgctxt "text_id=9046 | speaker=unknown"
msgid "  He would be in a few hours from now, however."
msgstr "　その考えはこの数時間後に<改|あらた>められる事になるが、今はまだ先の話だ。"

msgctxt "text_id=9047 | speaker=unknown"
msgid "\"I was more worried about the condition of the woods around the mansion."
msgstr "「それより森の荒れ具合が気になって。"

msgctxt "text_id=9048 | speaker=unknown"
msgid "  When was the last time someone tended to this hill?\""
msgstr "　この丘、どのくらいほったらかしだったんだ？」"

msgctxt "text_id=9049 | speaker=unknown"
msgid "\"...\""
msgstr "「…………」"

msgctxt "text_id=9050 | speaker=unknown"
msgid "  Alice stood speechless."
msgstr "　有珠は答えない。"

msgctxt "text_id=9051 | speaker=unknown"
msgid "  She had lived here for three years, but there was no need to tell him that."
msgstr "　彼女がこの土地に住みはじめて三年ほど経つが、口にする必要はない。"

msgctxt "text_id=9052 | speaker=unknown"
msgid "  Soujyuro casually continued collecting trash as if Alice had not been standing before him in silence."
msgstr "　沈黙する有珠が気にならないのか、草十郎はひょいひょいとマイペースにゴミを拾っていく。"

msgctxt "text_id=9053 | speaker=unknown"
msgid "  For her, it was one of the most brazen insults she had ever received."
msgstr "　少女から見ると<厚|あつ>かましいコトこの上ない。"

msgctxt "text_id=9054 | speaker=unknown"
msgid "\"Why, you...\""
msgstr "「―――貴方」"

msgctxt "text_id=9055 | speaker=unknown"
msgid "  Her voice full of desire to extinguish his life."
msgstr "　今すぐ消えて、と続きかねない声。"

msgctxt "text_id=9056 | speaker=unknown"
msgid "\"Yowch!\""
msgstr "「あいたっ」"

msgctxt "text_id=9057 | speaker=unknown"
msgid "  His simple cry interrupted her before she could finish."
msgstr "　それを、間の抜けた声が押し止めた。"

msgctxt "text_id=9058 | speaker=unknown"
msgid "\"Ouch... I just kicked something really hard.\""
msgstr "「いたた……なんか硬いの蹴ったぞ、今」"

msgctxt "text_id=9059 | speaker=unknown"
msgid "  A rusty mass of metal lay buried at his feet."
msgstr "　草十郎の足下には、錆びた金属の固まりが埋もれていた。"

msgctxt "text_id=9060 | speaker=unknown"
msgid "\"What's this spiky metal thing? I should shut this before someone gets hurt.\""
msgstr "「鉄の……なんだろう、このギサギザ。危ないけど、これ閉じるのか？」"

msgctxt "text_id=9061 | speaker=unknown"
msgid "  He inspected the dangerous object before him with a befuddled expression."
msgstr "　不思議そうに足下の危険物を観察する。"

msgctxt "text_id=9062 | speaker=unknown"
msgid "  Apparently, he had no idea that it was a common trap used to catch wild animals."
msgstr "　それが野生の獣の<脚|あし>を捕らえる<道具|ワナ>である事を、彼は知らないらしい。"

msgctxt "text_id=9063 | speaker=unknown"
msgid "\"That's a bear trap. We used to have a stray dog problem up here."
msgstr "「……<虎挟|とらばさ>みね。昔、この山には野犬が多くいたというから、その頃のものでしょう。"

msgctxt "text_id=9064 | speaker=unknown"
msgid "  Someone from town must have left it there.\""
msgstr "　街の人たちが忘れていったのよ、きっと」"

msgctxt "text_id=9065 | speaker=unknown"
msgid "\"Strays, huh? Do people really use this to catch dogs?\""
msgstr "「野犬……これ、犬を捕まえる道具なのか？」"

msgctxt "text_id=9066 | speaker=unknown"
msgid "\"Yes. When an animal steps on it a spring makes that sharp part clamp onto their leg."
msgstr "「ええ。踏みつけると、その口みたいなのがバネで閉じると聞いたわ。"

msgctxt "text_id=9067 | speaker=unknown"
msgid "Though I've never actually seen one in action, come to think of it.\""
msgstr "実際に稼働するところは見た事がないけれど」"

msgctxt "text_id=9068 | speaker=unknown"
msgid "\"Really? It's so obvious it's a trap, though. What animal would fall for it?\""
msgstr "「そうなのか。でもこんな見え見えの仕掛け、引っかかる動物がいるのかな」"

msgctxt "text_id=9069 | speaker=unknown"
msgid "  Alice could only nod in agreement with his naive observation."
msgstr "　素朴な疑問に、たしかに、と有珠は頷いた。"

msgctxt "text_id=9070 | speaker=unknown"
msgid "  Though she had not seen one of the devices since her childhood, she remembered harboring the same doubts back then."
msgstr "　虎挟みなんてものを見たのは子供の時以来だが、彼女も前から妙に思っていたのだ。"

msgctxt "text_id=9071 | speaker=unknown"
msgid "  Alice knew very well how smart wild animals really were."
msgstr "　有珠は獣たちの<賢|かしこ>さを知っている。"

msgctxt "text_id=9072 | speaker=unknown"
msgid "  How could they so easily be fooled and delivered into human hands by such a simplistic contraption?"
msgstr "　なのにどうして、彼らはこんなあからさまな罠に食いつかれて、人間の手にかかってきたのか？"

msgctxt "text_id=9073 | speaker=unknown"
msgid "\"...Some people use food as bait.\""
msgstr "「…………食べ物とか、置くのかも」"

msgctxt "text_id=9074 | speaker=unknown"
msgid "  Alice let slip."
msgstr "　つい、思いつきが声にでる。"

msgctxt "text_id=9075 | speaker=unknown"
msgid "\"And the hungry animal approaches even though it's obviously dangerous?\""
msgstr "「食べ物ほしさに、こんな、見るからに痛そうなものに近づくかな」"

msgctxt "text_id=9076 | speaker=unknown"
msgid "\"Yes, but timing and circumstance play a key part."
msgstr "「それはそうだけど、時と場合によるでしょう。"

msgctxt "text_id=9077 | speaker=unknown"
msgid "  You see, if an animal is starving to death, curiosity is bound to get the better of it."
msgstr "　動物だって、死にそうなぐらいお腹が減っていたら、誘惑には勝てないわ。"

msgctxt "text_id=9078 | speaker=unknown"
msgid "  The worst that could happen is injuring one leg. Even if the animal recognizes the danger, suffering an injury to its leg is far better than dying from starvation.\""
msgstr "　罠にかかっても傷つくのは片足だけでしょうし。危ないと分かっていても、飢えて死ぬよりはいいと食べてしまうのではないかしら」"

msgctxt "text_id=9079 | speaker=unknown"
msgid "  Indeed."
msgstr "　……そう。"

msgctxt "text_id=9080 | speaker=unknown"
msgid "  An animal lives knowing it might ultimately die at a hunter's hand, but the prospect of dying from hunger is unbearable."
msgstr "　たとえその後、猟師の手による死が待っていようと、目前の飢餓には耐えられない。"

msgctxt "text_id=9081 | speaker=unknown"
msgid "  That was doubly true for any creature that had young to look after."
msgstr "　それが子供を養う親だったら尚更だ。"

msgctxt "text_id=9082 | speaker=unknown"
msgid "  A dog willing to sacrifice a leg to obtain food for its pup was easy prey for a trapper."
msgstr "　親犬は子供のために片足を犠牲にして、餌を手に入れた代償として狩られてしまう。"

msgctxt "text_id=9083 | speaker=unknown"
msgid "  Perhaps it would try anyway, knowing full well the risk."
msgstr "　はじめから危険と分かった上での挑戦……なのかもしれない。"

msgctxt "text_id=9084 | speaker=unknown"
msgid "  The end result was the same: the animal would risk its leg to survive, and end up dead."
msgstr "　動物たちは生き残る為なら片足ぐらいと決断して、結果的に殺されてしまうだけの話。"

msgctxt "text_id=9085 | speaker=unknown"
msgid "\"Humans are no different."
msgstr "「人間と変わらないわ。"

msgctxt "text_id=9086 | speaker=unknown"
msgid "  If losing a leg is what it takes to survive, anyone would make the same choice.\""
msgstr "　片手を失うことで死なずに済むのなら、それぐらいの取捨選択はすると思う」"

msgctxt "text_id=9087 | speaker=unknown"
msgid "  She spoke assertively as if trying to convince herself at the same time."
msgstr "　自分を納得させるように少女は断言する。"

msgctxt "text_id=9088 | speaker=unknown"
msgid "  That was―"
msgstr "　それを、"

msgctxt "text_id=9089 | speaker=unknown"
msgid "  \"Humans and animals are kinda different, don't you think?\""
msgstr "「どうだろう。人間と動物は、ちょっと違うんじゃないかな」"

msgctxt "text_id=9090 | speaker=unknown"
msgid "Once again, his timid voice cut her off mid-thought."
msgstr "　再度、自信なげな声が押し止めた。"

msgctxt "text_id=9091 | speaker=unknown"
msgid "\"What do you mean 'different'?\""
msgstr "「……違うって、なにが？」"

msgctxt "text_id=9092 | speaker=unknown"
msgid "\"I mean, the whole idea that losing a leg could help you..."
msgstr "「片足を犠牲にして助かろうってところ、かな。"

msgctxt "text_id=9093 | speaker=unknown"
msgid "  Animals do not squander anything. And they don't have such complicated thoughts, either."
msgstr "　動物には無駄がない。あれこれ考える知恵もない。"

msgctxt "text_id=9094 | speaker=unknown"
msgid "  They don't consider giving up one thing in order to gain another the way humans do.\""
msgstr "　だから俺たちみたいに、<無|・><く|・><な|・><っ|・><た|・><ら|・><別|・><の|・><物|・><で|・><補|・><う|・>、なんて選択が、そもそもないんだ」"

msgctxt "text_id=9095 | speaker=unknown"
msgid "\"For them, losing a leg is the same as dying."
msgstr "「動物にとって、片足を無くすコトは命を無くすコトと変わらない。"

msgctxt "text_id=9096 | speaker=unknown"
msgid "Living without waste is the same as living without losing anything at all. Every animal knows that losing even a part of themselves means they're as good as dead.\""
msgstr "無駄がないという在り方は、何も失えない在り方なんだと思う。動物はみんな、少しでも自分の<価値|からだ>が欠けたら、もう生きていけない事を知っている」"

msgctxt "text_id=9097 | speaker=unknown"
msgid "\"No animal calculates whether it's worth losing a leg or not at the moment they see a trap and decide to approach it."
msgstr "「……だから、この罠を見て、それでも進もうとした時、彼らには“足ぐらいなくなっても”なんて思いはないんじゃないかな。"

msgctxt "text_id=9098 | speaker=unknown"
msgid "  That kind of thinking doesn't work for them. When they know they'll lose a leg, they're already prepared to sacrifice their whole life.\""
msgstr "　はじめから助かる気はない。片足を失うと認めた時点で、彼らは自分の命そのものを差しだしている」"

msgctxt "text_id=9099 | speaker=unknown"
msgid "  It was far from the response she had expected him to give, but she found herself nodding nonetheless."
msgstr "　予想外の意見だったが、なるほど、と少女は受け入れた。"

msgctxt "text_id=9100 | speaker=unknown"
msgid "  He had been raised in a mountain village where people had to coexist with nature, not in crowded urban area."
msgstr "　この少年は都会生まれではなく、まだ自然と共存している山村で育った人間だ。"

msgctxt "text_id=9101 | speaker=unknown"
msgid "  His childhood environment was not a civilized or cultured one where the weak and old were protected."
msgstr "　文明で武装し、弱いもの、老いたものを助けてくれる社会に生まれたものではない。"

msgctxt "text_id=9102 | speaker=unknown"
msgid "  No, he was accustomed to a lifestyle where mankind and nature coexisted, not one of infinite possibilities and convenience."
msgstr "　これまでの彼の在り方は、創意工夫に満ちた便利な日々ではなく、自然との共存による生活だったのだろう。"

msgctxt "text_id=9103 | speaker=unknown"
msgid "  It was no wonder that Soujyuro saw injuries as something that, once inflicted, lasted forever."
msgstr "　そんな草十郎にとって、傷とは傷のまま、永遠に残るものだったに違いない。"

msgctxt "text_id=9104 | speaker=unknown"
msgid "  If not, then he would not have explained the way wild animals live in nature in such detail."
msgstr "　そうでなければ、自然に生きる動物の在り方を口にできない。"

msgctxt "text_id=9105 | speaker=unknown"
msgid "  His words rang very true."
msgstr "　……彼の言うことはもっともだ。"

msgctxt "text_id=9106 | speaker=unknown"
msgid "  A horse rendered unable to run by a leg injury could no longer function in the way a horse is meant to function. It would thus no longer be seen as a horse at all in human society."
msgstr "　足を負傷して走れなくなった馬は、もう「馬」として機能せず、人々からも「馬」として見られないように。"

msgctxt "text_id=9107 | speaker=unknown"
msgid "  Once a wild animal loses its ability to run, though it may still live, it loses its sense of significance in the world."
msgstr "　野生の獣は、その手足を走らせる機能を<損|そこ>なった時点で、<生命|いのち>より先に己の<意義|かち>を<喪|うしな>うのだ―――"

msgctxt "text_id=9108 | speaker=unknown"
msgid "\"I wonder if this one has ever caught anything.\""
msgstr "「でもコレ、一度でも獲物を捕まえたコトがあるのかな」"

msgctxt "text_id=9109 | speaker=unknown"
msgid "\"Well, we'd have to be the people who put it here to know that, wouldn't we?\""
msgstr "「さあ。仕掛けたのはわたしじゃないから」"

msgctxt "text_id=9110 | speaker=unknown"
msgid "  Alice's tone was tense in response to his friendly and candid observations."
msgstr "　親しげに話しかけられ、有珠は気を引き締めて返答した。"

msgctxt "text_id=9111 | speaker=unknown"
msgid "  Though she'd been the one to strike up a conversation, she still found the bear trap far less of a nuisance than Soujyuro himself."
msgstr "　つい話し込んでしまったが、有珠にとってみれば虎挟みよりこの少年の方が何倍も邪魔なのだ。"

msgctxt "text_id=9112 | speaker=unknown"
msgid "\"In any case, I can see that you're trying to clean things up, but what's this all in aid of? Is this your attempt to get on my good side?\""
msgstr "「それより。森の手入れをしているようだけど、何のつもり？　わたしへのご機嫌<伺|うかが>い？」"

msgctxt "text_id=9113 | speaker=unknown"
msgid "  Animosity burned in her eyes."
msgstr "　少女の瞳に敵意がともる。"

msgctxt "text_id=9114 | speaker=unknown"
msgid "  She did not like being sucked up to, and decided that the moment he did so would be the moment she disposed of him."
msgstr "　自分に媚びへつらった時点で、有珠は草十郎を自分流に処置しようと決めていた。"

msgctxt "text_id=9115 | speaker=unknown"
msgid "  It was one thing to be ingracious, treacherous, or even to cut off relations with her."
msgstr "　不義理もいい。絶交もいい。裏切りもいい。"

msgctxt "text_id=9116 | speaker=unknown"
msgid "  But she could not abide being spoken to insincerely."
msgstr "　けれど、心にもない言葉で話しかけられる事だけは許せない。"

msgctxt "text_id=9117 | speaker=unknown"
msgid "  For her, that was the ultimate insult."
msgstr "　それは少女にとって、何よりも重い侮辱だった。"

msgctxt "text_id=9118 | speaker=unknown"
msgid "\"How would cleaning the woods make you happy?"
msgstr "「うん？　森の手入れをすると、なんでそっちの機嫌が良くなるんだ？"

msgctxt "text_id=9119 | speaker=unknown"
msgid "  It's only this bad because neither of you care, right? I thought I was the only one who felt bad seeing the grounds in this state.\""
msgstr "　こんなに荒れ放題なんだから、ふたりともこの森はあんまり好きじゃないんだろ。森がきれいになって気分が良くなるのは、俺だけだと思うけど」"

msgctxt "text_id=9120 | speaker=unknown"
msgid "  It seemed he had not picked up on her animosity one bit."
msgstr "　が。有珠の敵意も、この少年にはまったく伝わらなかったようだ。"

msgctxt "text_id=9121 | speaker=unknown"
msgid "\"...Excuse me, I'm well aware that I haven't kept the grounds in the best shape, but it's not because I don't care. In fact, I love the trees in a way.\""
msgstr "「……待って。たしかに森には手を入れていないけれど、嫌いな訳じゃない。愛情はそれなりにあるわ」"

msgctxt "text_id=9122 | speaker=unknown"
msgid "\"Really? Then why don't you groom them?\""
msgstr "「それはヘンだ。なら、どうして放っておく」"

msgctxt "text_id=9123 | speaker=unknown"
msgid "\"I love them, but I don't dote on them."
msgstr "「愛情はあっても愛着はないだけよ。"

msgctxt "text_id=9124 | speaker=unknown"
msgid "However, I've reconsidered. I'm going to make tending to the grounds a part of my daily routine."
msgstr "……でも反省したわ。これからは森の手入れも日課にいれる。"

msgctxt "text_id=9125 | speaker=unknown"
msgid "  In any case, the only strange thing here is your behavior."
msgstr "　けど、貴方だっておかしいでしょう？"

msgctxt "text_id=9126 | speaker=unknown"
msgid "  What interest do you have in these woods?\""
msgstr "　この森のどこに、貴方が気に入るものがあるの？」"

msgctxt "text_id=9127 | speaker=unknown"
msgid "\"It's not strange at all."
msgstr "「おかしくはない。"

msgctxt "text_id=9128 | speaker=unknown"
msgid "I love woods, and this hill reminds me of the mountains back home."
msgstr "森はたいてい好きだし、この丘、ちょっと故郷の山に似ているし。"

msgctxt "text_id=9129 | speaker=unknown"
msgid "  When you see a person struggling who kinda looks like someone you were once sweet on, don't you feel like stepping in to help?\""
msgstr "　ほら。好きだった子にそっくりな子が困ってたら、なんとかしてあげようと思わないか？」"

msgctxt "text_id=9130 | speaker=unknown"
msgid "\"You know... as a fellow human being,\""
msgstr "“なんというか、人間として”"

msgctxt "text_id=9131 | speaker=unknown"
msgid "  he concluded."
msgstr "　などと締めくくる草十郎。"

msgctxt "text_id=9132 | speaker=unknown"
msgid "  His last uncalled-for remark upset Alice."
msgstr "　その余計な一言は、有珠の心をかき乱すには十分だった。"

msgctxt "text_id=9133 | speaker=unknown"
msgid "\"So being raised in the mountains makes you want to clean up the backyard? No, I'm not convinced."
msgstr "「……納得いかない。それだけで大切に扱うの？"

msgctxt "text_id=9134 | speaker=unknown"
msgid "  I think this is all an effort to butter me up."
msgstr "　本当はわたしへの当てつけなんでしょう？"

msgctxt "text_id=9135 | speaker=unknown"
msgid "  Why would you feel so attached to an otherwise unremarkable wood like this? It doesn't even have any oak trees.\""
msgstr "　だいたい、こんな森が好きなんておかしいわ。オークの木も根付かない、どこにでもある普通の森なのに」"

msgctxt "text_id=9136 | speaker=unknown"
msgid "\"So? I like it. Isn't that enough?"
msgstr "「？　別にそれでいいじゃないか。"

msgctxt "text_id=9137 | speaker=unknown"
msgid "  I like these woods just because they're here. I don't think there's anything wrong with finding something beautiful for no particular reason.\""
msgstr "　森は普通にあるだけでいいんだ。なにもおかしくない。きれいなものをきれいと思うのは、いい事だと思うんだが」"

msgctxt "text_id=9138 | speaker=unknown"
msgid "\"No particular reason? Are you telling me you like every wooded area on earth?"
msgstr "「……明確な理由もないのに？　この世のすべての森が好きだっていうの？"

msgctxt "text_id=9139 | speaker=unknown"
msgid "  You have no relationship with this wood."
msgstr "　貴方とこの森には何の因果関係もないわ。"

msgctxt "text_id=9140 | speaker=unknown"
msgid "  There is no context or reason for your liking it."
msgstr "　文脈として、貴方がこの森を好きになる理由がない。"

msgctxt "text_id=9141 | speaker=unknown"
msgid "  And if there's no external reason, then it must be because you're up to something.\""
msgstr "　理由がないなら、それはわたしへの―――」"

msgctxt "text_id=9142 | speaker=unknown"
msgid "\"...Do I need a reason to like something?\""
msgstr "「？　好きってコトに理由は必要なのか？」"

msgctxt "text_id=9143 | speaker=unknown"
msgid "\"Huh?\""
msgstr "「え―――」"

msgctxt "text_id=9144 | speaker=unknown"
msgid "  Soujyuro had uttered his question as if he had been confronted with an entirely new concept."
msgstr "　不思議なものを見るように少年は言った。"

msgctxt "text_id=9145 | speaker=unknown"
msgid "  The cliché \"love needs no reason\" was certainly not what he intended to throw in her face."
msgstr "　それは、愛情に理由はいらない、という意味ではなく。"

msgctxt "text_id=9146 | speaker=unknown"
msgid "  He had simply asked whether feeling without reason could be real."
msgstr "　理由のない<感|も><情|の>はすべて嘘なのかと、問い返すような言葉だった。"

msgctxt "text_id=9147 | speaker=unknown"
msgid "  After boiling over at him, Alice simmered down."
msgstr "　……カッと沸き立っていた胸が冷めていく。"

msgctxt "text_id=9148 | speaker=unknown"
msgid "  She took a step back, embarrassed to have raised her voice at him."
msgstr "　少女は声を荒らげた自分を恥じて、一歩、少年から身を引いた。"

msgctxt "text_id=9149 | speaker=unknown"
msgid "\"...\""
msgstr "「――――――」"

msgctxt "text_id=9150 | speaker=unknown"
msgid "\"...\""
msgstr "「………………」"

msgctxt "text_id=9151 | speaker=unknown"
msgid "  It was an unbearably awkward silence."
msgstr "　気まずい沈黙。"

msgctxt "text_id=9152 | speaker=unknown"
msgid "  Alice searched for the words to regain her pride."
msgstr "　有珠は何か、自分なりの<矜持|きょうじ>を示そうと言葉を探していた。"

msgctxt "text_id=9153 | speaker=unknown"
msgid "  She could not leave it on that note or it would have looked like he won the argument."
msgstr "　やりこめられたままでは立場が逆だ。"

msgctxt "text_id=9154 | speaker=unknown"
msgid "  At the end of the day this was her wood; her world."
msgstr "　何しろここは自分の森、彼女の世界。"

msgctxt "text_id=9155 | speaker=unknown"
msgid "  Losing an argument to a mere human was enough to make any witch bite her lip at the dishonor."
msgstr "　こんな、ただの人間に言い負かされたままでは魔女の<沽券|こけん>に関わると唇を噛んでいる。"

msgctxt "text_id=9156 | speaker=unknown"
msgid "\"By the way, should I leave this here?\""
msgstr "「ところで。これは残しておく？」"

msgctxt "text_id=9157 | speaker=unknown"
msgid "  Soujyuro casually reached out toward the bear trap as if Alice's animosity had been a mild gust of wind."
msgstr "　一方。そんな彼女の戦意もどこ吹く風で、草十郎は虎挟みに手を伸ばす。"

msgctxt "text_id=9158 | speaker=unknown"
msgid "\"I don't need it. I said it's not mine, remember?\""
msgstr "「……必要ないわ。わたしのものではないと言ったでしょう」"

msgctxt "text_id=9159 | speaker=unknown"
msgid "\"Okay, then I'll get rid of it. It's rusty and I doubt it still works, and those teeth look pretty sharp. If I leave it here, I'll probably have a bad dream about it.\""
msgstr "「そっか。なら回収しよう。もう錆びて動かないけど、犬の歯みたいで物騒だ。残しておくと夢に見そうだし」"

msgctxt "text_id=9160 | speaker=unknown"
msgid "  Soujyuro lifted up the heavy mass of iron with a loud exhale of breath."
msgstr "　よいしょ、と重い鉄の塊を持ち上げる草十郎。"

msgctxt "text_id=9161 | speaker=unknown"
msgid "  He preceded to walk over to the shade of a nearby tree and toss it inside something unusual-looking."
msgstr "　少年はそのまま木の陰まで歩いていくと、おかしなモノに虎挟みを放りこんだ。"

msgctxt "text_id=9162 | speaker=unknown"
msgid "\"Where did you find that trailer, Sizuki?\""
msgstr "「……静希君。そのリヤカー、どこにあったの？」"

msgctxt "text_id=9163 | speaker=unknown"
msgid "\"A shop in town."
msgstr "「どこって、町のお店だよ。"

msgctxt "text_id=9164 | speaker=unknown"
msgid "  I thought I might need it, and boy was I right. I'm getting good at listening to my gut instincts.\""
msgstr "　もしかしたらと思って買ってきて正解だった。ここのところ、どうしてか悪い予感だけはあたるんだ」"

msgctxt "text_id=9165 | speaker=unknown"
msgid "  What an odd master of good deeds he must have appeared, so proudly dragging along that trailer of his."
msgstr "　嬉しそうにリヤカーを移動させる、謎のボランティアマスター。"

msgctxt "text_id=9166 | speaker=unknown"
msgid "  Seeing the grin on his face, Alice realized just how pointless it was to try to converse with the boy any further."
msgstr "　その笑顔を見て、この少年につっかかるのがどれだけ時間の無駄なのか、有珠はようやく悟った。"

msgctxt "text_id=9167 | speaker=unknown"
msgid "\"...It's my own fault for trying to talk to him. I should have known better.\""
msgstr "「………そう。話しかけたわたしが、どうかしていたわ」"

msgctxt "text_id=9168 | speaker=unknown"
msgid "  She turned away and headed back toward the mansion."
msgstr "　少年に背を向けて、洋館に足を向ける。"

msgctxt "text_id=9169 | speaker=unknown"
msgid "  Aoko had been right all along."
msgstr "　……まったく、青子の言うとおりだ。"

msgctxt "text_id=9170 | speaker=unknown"
msgid "  Realizing how much time she had wasted, Alice now fully agreed: she should do everything in her power to ignore him, utterly and completely."
msgstr "　余計な時間を使ったと反省しながら、有珠は徹底的に、あの少年は無視しようと<自|みずか>らに言い聞かせた。"

#. Occurrence 7_2:49:9171: scene=7_2
#: 7_2:49
msgctxt "text_id=9171 | speaker=unknown"
msgid "  Misaki High was a private school, and as such its winter break started earlier than public schools."
msgstr "　私立という事もあって、三咲高校の冬休みは早い。"

#. Occurrence 7_2:54:9172: scene=7_2
#: 7_2:54
msgctxt "text_id=9172 | speaker=unknown"
msgid "  The end-of-term ceremony was in mid-December, followed by a brief respite before the next term began."
msgstr "　十二月の<半|なか>ばには終業式を<迎|むか>え、校舎と生徒たちはつかの間、二学期までの疲れを癒す事になる。"

#. Occurrence 7_2:59:9173: scene=7_2
#: 7_2:59
msgctxt "text_id=9173 | speaker=unknown"
msgid "  Of course..."
msgstr "　無論。"

#. Occurrence 7_2:64:9174: scene=7_2
#: 7_2:64
msgctxt "text_id=9174 | speaker=unknown"
msgid "  That was if and only if they overcame the classic obstacle lying between them and an extended break from school: final exams."
msgstr "　彼らにとっては恒例の関門、幸せな長期休日の前に立ちはだかる<期末試験|みっかかん>を無事に乗り越えられたら、の話であるが。"

#. Occurrence 7_2:122:9175: scene=7_2
#: 7_2:122
msgctxt "text_id=9175 | speaker=unknown"
msgid "  The radio continued its broadcast late into the night."
msgstr "　深夜放送を受信するラジオ。"

#. Occurrence 7_2:127:9176: scene=7_2
#: 7_2:127
msgctxt "text_id=9176 | speaker=unknown"
msgid "  A thermos of hot tea eliminated the need to venture down to the kitchen."
msgstr "　<台所|した>まで下りる手間をはぶく、紅茶用の魔法瓶。"

#. Occurrence 7_2:132:9177: scene=7_2
#: 7_2:132
msgctxt "text_id=9177 | speaker=unknown"
msgid "  An electric blanket kept away the winter cold, and a crab-shaped pastry staved off any dinnertime hunger."
msgstr "　冬の寒さから足を守る電気毛布と、夜食のカニパン。"

#. Occurrence 7_2:150:9178: scene=7_2
#: 7_2:150
msgctxt "text_id=9178 | speaker=unknown"
msgid "  These were the lengths Aoko had gone to."
msgstr "　このように。"

#. Occurrence 7_2:155:9179: scene=7_2
#: 7_2:155
msgctxt "text_id=9179 | speaker=unknown"
msgid "  She needed to ensure that every aspect of her surroundings helped her pull a successful all-nighter."
msgstr "　青子の部屋は<一分|いちぶ>の<隙|すき>もない、一夜漬け強制空間になっていた。"

#. Occurrence 7_2:187:9180: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0000; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:187
msgctxt "text_id=9180 | speaker=aoko"
msgid "\"Congrats on surviving the first day of exams."
msgstr "「期末試験一日目、ご苦労さま。"

#. Occurrence 7_2:193:9181: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0001; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:193
msgctxt "text_id=9181 | speaker=aoko"
msgid "  Are you ready to leave your old study habits behind and be reborn as a new student?\""
msgstr "　それで、生まれ変わる覚悟はできた？」"

#. Occurrence 7_2:214:9182: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0000; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:214
msgctxt "text_id=9182 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 7_2:219:9183: scene=7_2
#: 7_2:219
msgctxt "text_id=9183 | speaker=unknown"
msgid "  Soujyuro nodded earnestly."
msgstr "　こくこく、と頷く草十郎。"

#. Occurrence 7_2:224:9184: scene=7_2
#: 7_2:224
msgctxt "text_id=9184 | speaker=unknown"
msgid "  Upon returning from work he encountered not the mage he expected but the demon student council president-Aozaki."
msgstr "　アルバイトから戻ってきた彼を待っていたのは、魔術師ではなく、鬼の生徒会長としての蒼崎青子だった。"

#. Occurrence 7_2:257:9185: scene=7_2
#: 7_2:257
msgctxt "text_id=9185 | speaker=unknown"
msgid "  Half a day earlier."
msgstr "　時をさかのぼること半日前。"

#. Occurrence 7_2:275:9186: scene=7_2
#: 7_2:275
msgctxt "text_id=9186 | speaker=unknown"
msgid "  The first day of exams were over, and Soujyuro was about to head back to the mansion where he hoped to put his plan into practice, when..."
msgstr "　期末試験一日目を終え、かねてからの計画を実行しようと洋館に向かう草十郎の前に、"

#. Occurrence 7_2:300:9187: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0002; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:300
msgctxt "text_id=9187 | speaker=aoko"
msgid "\"Tonight, I'm holding you prisoner."
msgstr "「今夜、私の部屋で監禁ね。"

#. Occurrence 7_2:306:9188: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0003; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:306
msgctxt "text_id=9188 | speaker=aoko"
msgid "  Your grades are simply unacceptable. Cancel your shift and any other plans you have.\""
msgstr "　あ、夕方からのアルバイトは当然キャンセル。ちょっと本気で、あの点数はあり得ないから」"

#. Occurrence 7_2:316:9189: scene=7_2
#: 7_2:316
msgctxt "text_id=9189 | speaker=unknown"
msgid "  ...a cold, blue grin greeted him in the hallway."
msgstr "　青い炎に包まれた笑顔が現れたのである。"

#. Occurrence 7_2:321:9190: scene=7_2
#: 7_2:321
msgctxt "text_id=9190 | speaker=unknown"
msgid "  Clenched in her fist was Soujyuro's exam paper."
msgstr "　その手にはしわくちゃに握りしめられた静希草十郎のテスト用紙。"

#. Occurrence 7_2:361:9191: scene=7_2
#: 7_2:361
msgctxt "text_id=9191 | speaker=unknown"
msgid "  Mr. Yamasiro had no doubt said,"
msgstr "　おそらく職員室で山城教諭から"

#. Occurrence 7_2:367:9192: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_2_0000; voice_prefix=B60; voice_category=7; scene=7_2
#: 7_2:367
msgctxt "text_id=9192 | speaker=yamashiro"
msgid "\"He only just transferred. We can't expect miracles.\""
msgstr "『ま、転校してきたばかりだし、しょうがないよね』"

#. Occurrence 7_2:372:9193: scene=7_2
#: 7_2:372
msgctxt "text_id=9193 | speaker=unknown"
msgid "  But she had snatched the exam out of the teacher's hands the minute he tried to show her."
msgstr "　と見せられたものを、<勢|いきお>い<奪|うば>い取ってきたに違いない。"

#. Occurrence 7_2:419:9194: scene=7_2
#: 7_2:419
msgctxt "text_id=9194 | speaker=unknown"
msgid "  That was how Soujyuro had ended up in Aoko's room, instead of the room in the attic to which he was accustomed."
msgstr "　かくして、今日まで屋根裏部屋で寝泊りしていた草十郎は、この日にかぎって青子の部屋に通された。"

#. Occurrence 7_2:439:9195: scene=7_2
#: 7_2:439
msgctxt "text_id=9195 | speaker=unknown"
msgid "  Though her situation was far from normal, at the end of the day she was an adolescent girl like any other."
msgstr "　色々疑問視する点はあるものの、青子とて年頃の女学生である。"

#. Occurrence 7_2:445:9196: scene=7_2
#: 7_2:445
msgctxt "text_id=9196 | speaker=unknown"
msgid "Naturally, she felt uncomfortable letting a boy her own age into her room."
msgstr "同年代の男子を自分の部屋に立ち入らせることに抵抗はある。"

#. Occurrence 7_2:450:9197: scene=7_2
#: 7_2:450
msgctxt "text_id=9197 | speaker=unknown"
msgid "  However, his grades were truly something that called for desperate measures."
msgstr "　が、それ以上に草十郎の答案用紙はあり得なかったのだ。"

#. Occurrence 7_2:455:9198: scene=7_2
#: 7_2:455
msgctxt "text_id=9198 | speaker=unknown"
msgid "  That explained why her mood was even worse than normal today and the vein on her forehead was pulsing visibly with anger."
msgstr "　なので、今日の不機嫌度は五割増し。彼女のこめかみから怒りマークがとれないのも無理からぬ事である。"

#. Occurrence 7_2:480:9199: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0004; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:480
msgctxt "text_id=9199 | speaker=aoko"
msgid "\"I need to finish my own studies first."
msgstr "「先に自分の復習、済ませる。"

#. Occurrence 7_2:486:9200: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0005; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:486
msgctxt "text_id=9200 | speaker=aoko"
msgid "  You can use that table in the meantime.\""
msgstr "　アンタはそのテーブル使ってて」"

#. Occurrence 7_2:496:9201: scene=7_2
#: 7_2:496
msgctxt "text_id=9201 | speaker=unknown"
msgid "  Aoko turned her back to him and sat down at her favorite desk."
msgstr "　青子はテーブルに背を向け、愛用の机に向かった。"

#. Occurrence 7_2:501:9202: scene=7_2
#: 7_2:501
msgctxt "text_id=9202 | speaker=unknown"
msgid "  Soujyuro was left standing before a cheap-looking glass table."
msgstr "　一方、草十郎の前には安物のガラステーブルが一つ。"

#. Occurrence 7_2:526:9203: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0001; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:526
msgctxt "text_id=9203 | speaker=soujuurou"
msgid "\"I'm still really not used to all this."
msgstr "「……なんか色々と慣れないな。"

#. Occurrence 7_2:545:9204: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0002; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:545
msgctxt "text_id=9204 | speaker=soujuurou"
msgid "  What's that blue thing over there, Aozaki?\""
msgstr "　なあ蒼崎、この青いのなんだ？」"

#. Occurrence 7_2:551:9205: scene=7_2
#: 7_2:551
msgctxt "text_id=9205 | speaker=unknown"
msgid "  Restless, Soujyuro found his eyes drawn to the guitar propped up in the corner."
msgstr "　落ち着かないのか、草十郎は部屋の隅にたてかけられたギターを眺める。"

#. Occurrence 7_2:587:9206: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0003; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:587
msgctxt "text_id=9206 | speaker=soujuurou"
msgid "\"It's thin, blue and intense-looking, it's got your name written all over it."
msgstr "「なんか薄いし青いしとんがってるし、きっと蒼崎の事だし。"

#. Occurrence 7_2:594:9207: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0004; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:594
msgctxt "text_id=9207 | speaker=soujuurou"
msgid "Don't tell me it's some kind of weapon?\""
msgstr "……もしかしなくても、武器か？」"

#. Occurrence 7_2:600:9208: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0006; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:600
msgctxt "text_id=9208 | speaker=aoko"
msgid "\"It's a musical instrument. I understand if you've never seen an electric one, but you must've seen an acoustic guitar in the music room. Keep talking, though, and you'll soon see if it also works as a weapon.\""
msgstr "「楽器よそれ。エレキはともかく、アコギは音楽室で似たようなのあったでしょう。あとこれ以上<青青|あおあお>言ったら、そのとんがってるので殴るからね」"

#. Occurrence 7_2:632:9209: scene=7_2
#: 7_2:632
msgctxt "text_id=9209 | speaker=unknown"
msgid "  Soujyuro plopped himself down onto a cushion, struggling to suppress the desire to retort that it was a weapon after all."
msgstr "　やっぱり武器じゃないか、という感想を<堪|こら>えて、草十郎もクッションに腰を下ろす。"

#. Occurrence 7_2:684:9210: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0005; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:684
msgctxt "text_id=9210 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 7_2:706:9211: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0007; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:706
msgctxt "text_id=9211 | speaker=aoko"
msgid "\"Don't play the victim. Usually you're as oblivious as an old and deaf dog. What's got you worked up this time?\""
msgstr "「ちょっとは落ち着きなさいよ。いつもは耳の遠い大型犬みたいに鈍感なクセに。何か気になるものでもあるの？」"

#. Occurrence 7_2:725:9212: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0006; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:725
msgctxt "text_id=9212 | speaker=soujuurou"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 7_2:730:9213: scene=7_2
#: 7_2:730
msgctxt "text_id=9213 | speaker=unknown"
msgid "  In fact it was Aoko who was oblivious for once."
msgstr "　この場合、鈍感なのは青子の方なのだが、"

#. Occurrence 7_2:735:9214: scene=7_2
#: 7_2:735
msgctxt "text_id=9214 | speaker=unknown"
msgid "  For his part, Soujyuro could not figure out why he felt so restless either. Suffice it to say, they were both pretty clueless in this moment."
msgstr "　草十郎もなぜ自分が落ち着かないのか分かっていないので、鈍感なのはお互い様である。"

#. Occurrence 7_2:759:9215: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0008; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:759
msgctxt "text_id=9215 | speaker=aoko"
msgid "\"Is it the way I decorated my room? My furniture's totally different to the stuff in the drawing room, so I understand if it seems a little weird."
msgstr "「あ、もしかして内装？　この部屋の家具のグレードが居間とは違うから不思議がってるのね。"

#. Occurrence 7_2:765:9216: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0009; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:765
msgctxt "text_id=9216 | speaker=aoko"
msgid "  I brought everything from home except the bed. It's been two years since I moved here, but I still don't feel like me and my stuff belong in this big, old house.\""
msgstr "　ここ、ベッド以外は私の家から持ちこんだ物なの。引っ越してから二年経つけど、まだ屋敷には馴染んでないでしょ？」"

#. Occurrence 7_2:801:9217: scene=7_2
#: 7_2:801
msgctxt "text_id=9217 | speaker=unknown"
msgid "  Though she misunderstood the real reason for Soujyuro's nervousness, Aoko seemed satisfied that she had resolved Soujyuro's anxiety for the time being and returned to her studies."
msgstr "　そわそわと落ち着かない草十郎の心情を曲解、納得いったのか、青子は自分の勉強を始めてしまう。"

#. Occurrence 7_2:806:9218: scene=7_2
#: 7_2:806
msgctxt "text_id=9218 | speaker=unknown"
msgid "  She flipped through her notes and textbooks as if fast-forwarding a tape."
msgstr "　早送りのようにめくられていくノートと教科書。"

#. Occurrence 7_2:811:9219: scene=7_2
#: 7_2:811
msgctxt "text_id=9219 | speaker=unknown"
msgid "  There was no opening for an outsider like him to intrude in her high-speed study session."
msgstr "　そこに余人の立ち入る隙間はない。"

#. Occurrence 7_2:831:9220: scene=7_2
#: 7_2:831
msgctxt "text_id=9220 | speaker=unknown"
msgid "  Repelled by her intensity, he retreated to his table. He was at least sensitive enough to pick up on her desire to be left alone."
msgstr "　青子の背中から立ち上るオーラに圧倒され、草十郎も気を引き締めてテーブルに向かった。"

#. Occurrence 7_2:836:9221: scene=7_2
#: 7_2:836
msgctxt "text_id=9221 | speaker=unknown"
msgid "  It was a testament to Soujyuro that having his needs utterly ignored was now second nature to him, to the extent that he could now happily go about his business in solitude."
msgstr "　完全に無視されていながら平然と自分の作業に入れるあたり、草十郎も只者ではない。"

#. Occurrence 7_2:885:9222: scene=7_2
#: 7_2:885
msgctxt "text_id=9222 | speaker=unknown"
msgid "  Two hours passed."
msgstr "　それから二時間。"

#. Occurrence 7_2:908:9223: scene=7_2
#: 7_2:908
msgctxt "text_id=9223 | speaker=unknown"
msgid "  Then, as the clock neared eleven, Aoko's speed and concentration began to slip."
msgstr "　十一時近くなって、ようやく青子の<集中力|スピード>が減速していった。"

#. Occurrence 7_2:913:9224: scene=7_2
#: 7_2:913
msgctxt "text_id=9224 | speaker=unknown"
msgid "  Seeing his window of opportunity, Soujyuro seized the moment to strike up a conversation."
msgstr "　それを<頃合|ころあ>いと見て、草十郎は凛と伸びた青子の背中に話しかけた。"

#. Occurrence 7_2:934:9225: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0007; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:934
msgctxt "text_id=9225 | speaker=soujuurou"
msgid "\"Aozaki, can I talk to you for a minute?\""
msgstr "「蒼崎、ちょっといいかな」"

#. Occurrence 7_2:940:9226: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0010; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:940
msgctxt "text_id=9226 | speaker=aoko"
msgid "\"What is it?\""
msgstr "「ん、なに？」"

#. Occurrence 7_2:946:9227: scene=7_2
#: 7_2:946
msgctxt "text_id=9227 | speaker=unknown"
msgid "  She spoke hesitantly, not bothering to turn to face him."
msgstr "　遠慮がちな声に、青子は振り向かずに応えた。"

#. Occurrence 7_2:951:9228: scene=7_2
#: 7_2:951
msgctxt "text_id=9228 | speaker=unknown"
msgid "  She continued to flip the pages of her textbook, albeit at a slower speed than before."
msgstr "　減速しているといっても、青子のノートをめくる動作は止まらない。"

#. Occurrence 7_2:972:9229: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0008; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:972
msgctxt "text_id=9229 | speaker=soujuurou"
msgid "\"I noticed how you and Alice have been acting at dinner these past three days, and, uh..."
msgstr "「この三日間、蒼崎たちの夕食事情を見てきたけど。"

#. Occurrence 7_2:978:9230: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0009; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:978
msgctxt "text_id=9230 | speaker=soujuurou"
msgid "  Is it always like that?\""
msgstr "　君たちの食事はいつもああなのか？」"

#. Occurrence 7_2:984:9231: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0011; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:984
msgctxt "text_id=9231 | speaker=aoko"
msgid "\"Yes, it's normal. Do we not look normal?\""
msgstr "「そうだけど、おかしい？」"

#. Occurrence 7_2:1000:9232: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0010; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:1000
msgctxt "text_id=9232 | speaker=soujuurou"
msgid "\"Hm... I'm not sure how to answer that."
msgstr "「む……そう言われると困るな。"

#. Occurrence 7_2:1011:9233: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0011; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:1011
msgctxt "text_id=9233 | speaker=soujuurou"
msgid "  It's just, at school people seem to enjoy eating together, so I thought it was strange that the two of you don't look like you enjoy it, and I thought maybe it's because of... you know...\""
msgstr "　ただ、学校じゃみんな楽しそうだった。誰かと食事を摂るって事は、ああいう風になるコトだって思ってた。だから、もしかすると」"

#. Occurrence 7_2:1045:9234: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0012; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1045
msgctxt "text_id=9234 | speaker=aoko"
msgid "\"Don't worry, it's not because of you that we haven't been talking at mealtimes. We've never talked to each other during meals.\""
msgstr "「もしかしないわよ。別にアンタのせいで有珠と話さないワケじゃないわ。私たちはいつもああだから」"

#. Occurrence 7_2:1051:9235: scene=7_2
#: 7_2:1051
msgctxt "text_id=9235 | speaker=unknown"
msgid "  Aoko spoke calmly with her back still turned, seemingly unaware of what he was getting at."
msgstr "　平然と語る青子の背中は、そんな事実をどうも思っていないようだった。"

#. Occurrence 7_2:1082:9236: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0012; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:1082
msgctxt "text_id=9236 | speaker=soujuurou"
msgid "\"Well, it can get pretty tense."
msgstr "「張りつめた食卓だな。"

#. Occurrence 7_2:1088:9237: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0013; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:1088
msgctxt "text_id=9237 | speaker=soujuurou"
msgid "  And here I thought you two were close friends.\""
msgstr "　蒼崎と有珠は、仲がいいと思ってたのに」"

#. Occurrence 7_2:1094:9238: scene=7_2
#: 7_2:1094
msgctxt "text_id=9238 | speaker=unknown"
msgid "  She neither confirmed nor denied his statement."
msgstr "　青子は否定も肯定もしない。"

#. Occurrence 7_2:1099:9239: scene=7_2
#: 7_2:1099
msgctxt "text_id=9239 | speaker=unknown"
msgid "  She was, however, surprised by the disappointed tone in which he had made it."
msgstr "　ただ、草十郎の残念そうな呟きが、少しだけ意外だった。"

#. Occurrence 7_2:1120:9240: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0013; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1120
msgctxt "text_id=9240 | speaker=aoko"
msgid "\"You're not wrong. It can get tense."
msgstr "「ま、張りつめた食卓っていうのは合ってるわね。"

#. Occurrence 7_2:1126:9241: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0014; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1126
msgctxt "text_id=9241 | speaker=aoko"
msgid "  I can't remember how many times she's put mescaline in your drink, and yesterday she was adding rowan to your salad."
msgstr "　有珠が何回アンタの飲み物にメスカリンを入れてたかなんてもう覚えてないし、昨日なんか堂々とサラダの中にナナカマドなんか混ざってるし。"

#. Occurrence 7_2:1132:9242: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0015; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1132
msgctxt "text_id=9242 | speaker=aoko"
msgid "  ...Beats me what the hell she was thinking.\""
msgstr "　……ほんと、あの娘なに考えてるんだろう」"

#. Occurrence 7_2:1137:9243: scene=7_2
#: 7_2:1137
msgctxt "text_id=9243 | speaker=unknown"
msgid "  A bitter smile spread across her face in reminiscence. The pages of her textbook continued to turn."
msgstr "　思い出すように苦笑しながら、青子は教科書をめくっていく。"

#. Occurrence 7_2:1163:9244: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0014; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:1163
msgctxt "text_id=9244 | speaker=soujuurou"
msgid "\"Mescaline? What's that?\""
msgstr "「メスカリン……？」"

#. Occurrence 7_2:1169:9245: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0016; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1169
msgctxt "text_id=9245 | speaker=aoko"
msgid "\"It's a hallucinogenic alkaloid produced by the peyote cactus. I'm assuming it's more than just your average hallucinogen if Alice is using it, though... And I'm done!\""
msgstr "「サボテンからとれる<植物塩基|アルカロイド>よ。有珠が使う以上、ただの幻覚剤じゃないでしょうけどね。……っと、私はこんなもんでいっか」"

#. Occurrence 7_2:1178:9246: scene=7_2
#: 7_2:1178
msgctxt "text_id=9246 | speaker=unknown"
msgid "  With that she slammed shut her fourth textbook of the night."
msgstr "　そう言う彼女の手元で、ぱたん、と四冊目の教科書が閉じられた。"

#. Occurrence 7_2:1184:9247: scene=7_2
#: 7_2:1184
msgctxt "text_id=9247 | speaker=unknown"
msgid "  After having scarcely changed position the whole night she finally turned in her chair to face him."
msgstr "　今まで微動だにしなかった背中がくるりと反転する。"

#. Occurrence 7_2:1221:9248: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0017; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1221
msgctxt "text_id=9248 | speaker=aoko"
msgid "\"Now it's time to put you to work."
msgstr "「さ、今度はアンタを仕込まなくちゃね。"

#. Occurrence 7_2:1227:9249: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0018; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1227
msgctxt "text_id=9249 | speaker=aoko"
msgid "  I don't know what else I was expecting, but I still almost fainted when I saw your scores.\""
msgstr "　今日の四科目の答案、実に草十郎らしい出来栄えで卒倒しそうになったわ、私」"

#. Occurrence 7_2:1233:9250: scene=7_2
#: 7_2:1233
msgctxt "text_id=9250 | speaker=unknown"
msgid "  Her tone was light but her gaze was heavy as she stared at Soujyuro, seated cross-legged on the floor."
msgstr "　口調は楽しそうに、けれど視線は不機嫌そうに、青子はあぐらをかく草十郎を見つめる。"

#. Occurrence 7_2:1254:9251: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0019; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1254
msgctxt "text_id=9251 | speaker=aoko"
msgid "\"Modern literature, geography, math, and electronics..."
msgstr "「現国、地理、数学、電子工学。"

#. Occurrence 7_2:1260:9252: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0020; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1260
msgctxt "text_id=9252 | speaker=aoko"
msgid "  If you don't up your grades over the next two days your winter break is as good as gone. And that'll be more of a problem for me than you.\""
msgstr "　あの調子であと二日続けたら、冬休みが消えるのは当然でしょうね。そうなると困るのは私なのよ、実際」"

#. Occurrence 7_2:1295:9253: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0015; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:1295
msgctxt "text_id=9253 | speaker=soujuurou"
msgid "\"I disagree. I think it'll be worse. Going to school during the break would not work out for me.\""
msgstr "「いや、俺も困るぞ。休みなのに学校に行くのは、なんか気が乗らない」"

#. Occurrence 7_2:1300:9254: scene=7_2
#: 7_2:1300
msgctxt "text_id=9254 | speaker=unknown"
msgid "  Soujyuro calmly corrected her."
msgstr "　冷静に誤りを訂正する草十郎。"

#. Occurrence 7_2:1322:9255: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0021; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1322
msgctxt "text_id=9255 | speaker=aoko"
msgid "\"For you?! If you have to go to school over the break, what do you think will happen to me?\""
msgstr "「そりゃあ私の台詞だ！　アンタが学校に行くってコトは、必然、こっちまでとばっちりがくるっての！」"

#. Occurrence 7_2:1327:9256: scene=7_2
#: 7_2:1327
msgctxt "text_id=9256 | speaker=unknown"
msgid "  All she could think about, as much as she tried not to, was Mr. Yamasiro and his annoying grin."
msgstr "　思い出したくもない、山城教諭のニヤニヤ顔を想像してしまう青子だった。"

#. Occurrence 7_2:1353:9257: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0022; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1353
msgctxt "text_id=9257 | speaker=aoko"
msgid "\"I cannot allow any student to fail every single class. Not on my watch."
msgstr "「それ以前に、私の目が黒いうちはオール赤なんて<生徒|ヤツ>は許さない。"

#. Occurrence 7_2:1359:9258: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0023; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1359
msgctxt "text_id=9258 | speaker=aoko"
msgid "  If I could beat good grades out of you I would.\""
msgstr "　本来なら性根から叩き直すところだけど……」"

#. Occurrence 7_2:1380:9259: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0024; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1380
msgctxt "text_id=9259 | speaker=aoko"
msgid "\"Lucky for you, you have 'extenuating circumstances,' shall we say, so I'll give you a pass just this once."
msgstr "「ま、アンタは色々事情があるから、とりあえず点数だけで勘弁してあげる。"

#. Occurrence 7_2:1391:9260: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0025; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1391
msgctxt "text_id=9260 | speaker=aoko"
msgid "  A good all-nighter is usually enough for me to prepare for exams, so it shouldn't take too long to get you up to speed either.\""
msgstr "　私もテストは一夜漬けで片付ける方だから、アンタ一人仕込むのに、そう時間はかからないだろうし」"

#. Occurrence 7_2:1412:9261: scene=7_2
#: 7_2:1412
msgctxt "text_id=9261 | speaker=unknown"
msgid "  Soujyuro's expression openly soured in response to her declaration."
msgstr "　青子の宣言に、草十郎は露骨に表情を曇らせる。"

#. Occurrence 7_2:1412:9262: scene=7_2
#: 7_2:1412
msgctxt "text_id=9262 | speaker=unknown"
msgid "  It was obvious he did not think he needed her meddling in his studies."
msgstr "　そんなお節介はいらない、とでも言いたげな顔である。"

#. Occurrence 7_2:1446:9263: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0026; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1446
msgctxt "text_id=9263 | speaker=aoko"
msgid "\"Oh, please. Which of us do you think is going to have the harder time of it, me or you?\""
msgstr "「アンタね。苦労するのは私と貴方、どっちだと思う？」"

#. Occurrence 7_2:1451:9264: scene=7_2
#: 7_2:1451
msgctxt "text_id=9264 | speaker=unknown"
msgid "  Soujyuro got the feeling that it would be him, but he nodded slowly nonetheless."
msgstr "　間違いなく自分だな、と運命的に悟りながらも草十郎は静かにうなだれた。"

#. Occurrence 7_2:1456:9265: scene=7_2
#: 7_2:1456
msgctxt "text_id=9265 | speaker=unknown"
msgid "  Then again, it would probably take more effort on her part than on his, and in any case he knew there was no way to talk her out of it."
msgstr "　どのみち断ったところで断りきれるはずがないし、青子の言う通り、苦労の度合いは彼女の方が大きいだろう。"

#. Occurrence 7_2:1493:9266: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0016; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:1493
msgctxt "text_id=9266 | speaker=soujuurou"
msgid "\"...I feel bad for making you do this.\""
msgstr "「……この度は、ご迷惑をおかけします」"

#. Occurrence 7_2:1499:9267: scene=7_2
#: 7_2:1499
msgctxt "text_id=9267 | speaker=unknown"
msgid "  Soujyuro summarily bowed his head to show gratitude and willingness to work."
msgstr "　観念と感謝の意をこめて、ぺこりと一礼する草十郎。"

#. Occurrence 7_2:1535:9268: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0027; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1535
msgctxt "text_id=9268 | speaker=aoko"
msgid "\"Good."
msgstr "「よろしい。"

#. Occurrence 7_2:1542:9269: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0028; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1542
msgctxt "text_id=9269 | speaker=aoko"
msgid "And don't worry, I'm not a demon, like they say."
msgstr "安心なさい、私だって鬼じゃないから。"

#. Occurrence 7_2:1548:9270: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0029; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1548
msgctxt "text_id=9270 | speaker=aoko"
msgid "  You can get less than average marks and still pass. You'll probably be able to go to bed by three.\""
msgstr "　別に平均点狙うってワケでもなし、予定通りこなしていけば三時には眠れるわよ」"

#. Occurrence 7_2:1568:9271: scene=7_2
#: 7_2:1568
msgctxt "text_id=9271 | speaker=unknown"
msgid "  She nodded with satisfaction, pleased by his studious attitude."
msgstr "　殊勝な教え子の態度に、青子は満足そうに頷いた。"

#. Occurrence 7_2:1578:9272: scene=7_2
#: 7_2:1578
msgctxt "text_id=9272 | speaker=unknown"
msgid "  He had plenty of obstacles ahead of him, but that sense of humility might be enough to see him through."
msgstr "　ほんとうに色々問題のある草十郎だが、この素直さがあれば大抵のコトはなんとか出来てしまうだろう、と。"

#. Occurrence 7_2:1604:9273: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0030; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1604
msgctxt "text_id=9273 | speaker=aoko"
msgid "\"Wait, what was I thinking? I can't afford to be this soft on you."
msgstr "「……って、なにホトケ心だしてるんだ私。"

#. Occurrence 7_2:1623:9274: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0031; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1623
msgctxt "text_id=9274 | speaker=aoko"
msgid "  Sizuki, let me be straight about this... temporary arrangement. It's not every day I offer private, one-on-one lessons like this."
msgstr "　いい、静希君？　このあと頼られちゃたまんないから<釘|くぎ>さしておくけど、私がマンツーマンで誰かを仕込むなんてコト、滅多にないから。"

#. Occurrence 7_2:1629:9275: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0032; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1629
msgctxt "text_id=9275 | speaker=aoko"
msgid "  This is beyond rare, an exception among exceptions. And don't you go forgetting that.\""
msgstr "　これはあくまで、異例中の異例だって覚えておいてね」"

#. Occurrence 7_2:1659:9276: scene=7_2
#: 7_2:1659
msgctxt "text_id=9276 | speaker=unknown"
msgid "  She spoke more to convince herself than him, but his expression still darkened."
msgstr "　自分に言い聞かせるような青子の宣言に、えー、と顔を曇らせる草十郎。"

#. Occurrence 7_2:1678:9277: scene=7_2
#: 7_2:1678
msgctxt "text_id=9277 | speaker=unknown"
msgid "  It made one want to hang a side around his neck that read, \"please take me home,\" like an abandoned pet. Aoko chided herself for being so soft."
msgstr "　その顔の上に“拾ってください”なんて単語を連想してしまい、自らの甘さにうなだれる青子だった。"

#. Occurrence 7_2:1686:9278: scene=7_2
#: 7_2:1686
msgctxt "text_id=9278 | speaker=unknown"
msgid "  For some reason, in that moment she recalled that it had been raining the day they met each other."
msgstr "　そう言えば、初めて出会った日は雨だったっけ、などと思いながら。"

#. Occurrence 7_3:39:9279: scene=7_3
#: 7_3:39
msgctxt "text_id=9279 | speaker=unknown"
msgid "  Time passed like the falling grains of an hourglass."
msgstr "　……時間は、砂が落ちるようにすぎていく。"

#. Occurrence 7_3:103:9280: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_9000; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:103
msgctxt "text_id=9280 | speaker=aoko"
msgid "\"...Finished.\""
msgstr "「―――結局」"

#. Occurrence 7_3:108:9281: scene=7_3
#: 7_3:108
msgctxt "text_id=9281 | speaker=unknown"
msgid "  Aoko squinted as light poured through the window and she downed another cup of tea. She had lost count of exactly how many she had drank long ago."
msgstr "　窓から差しこむ朝の光に目を細めて、青子は何杯目かの紅茶を飲み干した。"

#. Occurrence 7_3:123:9282: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0001; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:123
msgctxt "text_id=9282 | speaker=soujuurou"
msgid "\"And it only took the whole night, eh, Aozaki?\""
msgstr "「一晩かかったね、蒼崎」"

#. Occurrence 7_3:128:9283: scene=7_3
#: 7_3:128
msgctxt "text_id=9283 | speaker=unknown"
msgid "  Soujyuro picked up on what she left unspoken."
msgstr "　不思議だ、とばかりに青子の独白を拾う草十郎。"

#. Occurrence 7_3:148:9284: scene=7_3
#: 7_3:148
msgctxt "text_id=9284 | speaker=unknown"
msgid "  Aoko had used up all her pep."
msgstr "　青子にはいつもの覇気がない。"

#. Occurrence 7_3:153:9285: scene=7_3
#: 7_3:153
msgctxt "text_id=9285 | speaker=unknown"
msgid "  In staying up all night, but also in shouting at him."
msgstr "　徹夜明けプラス、一晩じゅう草十郎を怒鳴りつけた疲労のためだ。"

#. Occurrence 7_3:158:9286: scene=7_3
#: 7_3:158
msgctxt "text_id=9286 | speaker=unknown"
msgid "  He looked pale and uncomfortable, just as he had all night long."
msgstr "　一方、草十郎は昨夜とまったく同じ顔色である。"

#. Occurrence 7_3:188:9287: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0000; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:188
msgctxt "text_id=9287 | speaker=aoko"
msgid "\"I underestimated you, Soujyuro Sizuki.\""
msgstr "「……ええ。甘く見てたわ、アンタの事を」"

#. Occurrence 7_3:199:9288: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0002; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:199
msgctxt "text_id=9288 | speaker=soujuurou"
msgid "\"Come on, Aozaki, you know I get weirded out when you compliment me.\""
msgstr "「だから、誉めても何も出ないって」"

#. Occurrence 7_3:210:9289: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0001; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:210
msgctxt "text_id=9289 | speaker=aoko"
msgid "\"No, no. You deserve a pat on the head.\""
msgstr "「ある意味、誉めるに値するかもね……」"

#. Occurrence 7_3:220:9290: scene=7_3
#: 7_3:220
msgctxt "text_id=9290 | speaker=unknown"
msgid "  She was at the end of her rope, but she could not help the bit of pride that swelled up in her."
msgstr "　呆れる青子だが、半分は本気で感心していた。"

#. Occurrence 7_3:257:9291: scene=7_3
#: 7_3:257
msgctxt "text_id=9291 | speaker=unknown"
msgid "  His lack of even the most basic comprehension was shocking, even taking into account his upbringing in the wilderness."
msgstr "　この山奥育ちには下積みがなさすぎる。"

#. Occurrence 7_3:262:9292: scene=7_3
#: 7_3:262
msgctxt "text_id=9292 | speaker=unknown"
msgid "  His ability was that of a middle school student, and that was being generous."
msgstr "　控えめに言うと、かろうじて中学生レベルの学力だ。"

#. Occurrence 7_3:267:9293: scene=7_3
#: 7_3:267
msgctxt "text_id=9293 | speaker=unknown"
msgid "  Preparing him for exams by teaching him new concepts and ideas was a waste of time."
msgstr "　なので、理解、修得を目的にした試験勉強は諦めるしかない。"

#. Occurrence 7_3:272:9294: scene=7_3
#: 7_3:272
msgctxt "text_id=9294 | speaker=unknown"
msgid "  Rote memorization was his only hope for passing."
msgstr "　基本は点数稼ぎの暗記だけ。"

#. Occurrence 7_3:277:9295: scene=7_3
#: 7_3:277
msgctxt "text_id=9295 | speaker=unknown"
msgid "  Everything he memorized could collapse like a house of cards afterwards for all she cared. So long as he remembered for his exams."
msgstr "　明日になれば忘れるハリボテの一夜漬けでいい、と青子は教官役を買ってでたのだ。"

#. Occurrence 7_3:297:9296: scene=7_3
#: 7_3:297
msgctxt "text_id=9296 | speaker=unknown"
msgid "  Assuming he had the capacity to be a good student in the first place had been her mistake."
msgstr "　……誤算だったのは、思いの外、この生徒が優秀だった事だろう。"

#. Occurrence 7_3:302:9297: scene=7_3
#: 7_3:302
msgctxt "text_id=9297 | speaker=unknown"
msgid "  It took all night to cover the content for just four exams, and she still did not feel confident he could apply what he so earnestly tried to memorize."
msgstr "　四教科の試験範囲を終えるのに一晩かかってしまったが、それでもここまで熱心に、覚えたことを無駄にしないよう真剣に取り組むとは思わなかった。"

#. Occurrence 7_3:339:9298: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0002; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:339
msgctxt "text_id=9298 | speaker=aoko"
msgid "\"I appreciate your effort, but you just take too long to memorize new information.\""
msgstr "「でもねぇ。真面目なのはいいコトだけど、アンタ、暗記するのに時間かかりすぎ」"

#. Occurrence 7_3:352:9299: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0003; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:352
msgctxt "text_id=9299 | speaker=soujuurou"
msgid "\"Come on, go easy on me. I'm used to learning things with my body, not my head.\""
msgstr "「そこは大目に見てほしい。今まで、頭より体で覚えるコトのが多かったんだ」"

#. Occurrence 7_3:388:9300: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0003; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:388
msgctxt "text_id=9300 | speaker=aoko"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence 7_3:393:9301: scene=7_3
#: 7_3:393
msgctxt "text_id=9301 | speaker=unknown"
msgid "  Aoko let out an exasperated sigh."
msgstr "　青子は仕方なさげにため息をつく。"

#. Occurrence 7_3:398:9302: scene=7_3
#: 7_3:398
msgctxt "text_id=9302 | speaker=unknown"
msgid "  Naturally, physical prowess mattered more in mountain life than the intellectual kind, but still."
msgstr "　たしかに、山奥での生活で重要なのは知識ではなく経験則なのだろう、と。"

#. Occurrence 7_3:424:9303: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0004; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:424
msgctxt "text_id=9303 | speaker=aoko"
msgid "\"Whatever. At least now you should do well enough to satisfy Yamasiro."
msgstr "「……まあいいわ。これで山城からアンタの成績について相談される事もないでしょうし。"

#. Occurrence 7_3:430:9304: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0005; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:430
msgctxt "text_id=9304 | speaker=aoko"
msgid "  Mind making some more tea?\""
msgstr "　紅茶、もう一杯<淹|い>れてくれる？」"

#. Occurrence 7_3:448:9305: scene=7_3
#: 7_3:448
msgctxt "text_id=9305 | speaker=unknown"
msgid "  Soujyuro stood up and obeyed, as Aoko stretched her aching back."
msgstr "　疲れきって背中を伸ばす青子に、はいはいと応えて立ち上がる草十郎。"

#. Occurrence 7_3:453:9306: scene=7_3
#: 7_3:453
msgctxt "text_id=9306 | speaker=unknown"
msgid "  She had apparently bought the tea bags in bulk, so there were still plenty to use."
msgstr "　ティーバッグの紅茶は大量に買いこんでいたらしく、まだ十分に余っている。"

#. Occurrence 7_3:486:9307: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0004; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:486
msgctxt "text_id=9307 | speaker=soujuurou"
msgid "\"Good grief. This is so wasteful.\""
msgstr "「まったく。無駄遣いだな、蒼崎は」"

#. Occurrence 7_3:492:9308: scene=7_3
#: 7_3:492
msgctxt "text_id=9308 | speaker=unknown"
msgid "  He spoke under his breath so she wouldn't hear."
msgstr "　青子に聞こえないよう呟く。"

#. Occurrence 7_3:497:9309: scene=7_3
#: 7_3:497
msgctxt "text_id=9309 | speaker=unknown"
msgid "  It made him somehow happy to see her so tired and unfocused after the grueling all-night lesson she had given him."
msgstr "　一晩<厳|きび>しく教えられた反撃か、青子のだらしのない点が見られて嬉しいらしい。"

#. Occurrence 7_3:502:9310: scene=7_3
#: 7_3:502
msgctxt "text_id=9310 | speaker=unknown"
msgid "  It did not cross his mind that the excess tea bags, far from being an indulgent purchase, were purchased intentionally to sustain them through the night."
msgstr "　……その買いすぎたティーバッグは失敗ではなく、<今|・><夜|・>の補給物資になる事を、この時点では想像もできない草十郎だった。"

#. Occurrence 7_3:541:9311: scene=7_3
#: 7_3:541
msgctxt "text_id=9311 | speaker=unknown"
msgid "  A relaxed expression came across Aoko's face as she watched him, naive and peaceful as could be."
msgstr "　そんな平和ぼけしまくった草十郎を、青子は弛緩した面持ちで眺めている。"

#. Occurrence 7_3:568:9312: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0006; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:568
msgctxt "text_id=9312 | speaker=aoko"
msgid "\"Not bad. But I should teach him how to make it from tea leaves instead.\""
msgstr "「……悪くないけど。せめて、リーフティーで淹れられるように仕込まなくちゃダメかな……」"

#. Occurrence 7_3:573:9313: scene=7_3
#: 7_3:573
msgctxt "text_id=9313 | speaker=unknown"
msgid "  Seeming to have overheard her not-so inner monologue, Soujyuro made to face her."
msgstr "　独り言じみた青子の所感が聞こえたのか、草十郎はひょいと青子を振り返る。"

#. Occurrence 7_3:610:9314: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0005; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:610
msgctxt "text_id=9314 | speaker=soujuurou"
msgid "\"Does it really make a difference?\""
msgstr "「やっぱり味は違うのか？」"

#. Occurrence 7_3:631:9315: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0007; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:631
msgctxt "text_id=9315 | speaker=aoko"
msgid "\"Yeah, big time."
msgstr "「違う違う、もうぜーんぜん。"

#. Occurrence 7_3:637:9316: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0008; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:637
msgctxt "text_id=9316 | speaker=aoko"
msgid "  ...Although, honestly I don't really care. Alice is the one who's really picky about her tea."
msgstr "　……ま、正直私はどうでもいいんだけど、有珠はね、かなりお茶にはうるさいよ。"

#. Occurrence 7_3:648:9317: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0009; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:648
msgctxt "text_id=9317 | speaker=aoko"
msgid "  Which reminds me. How are things going between you two?\""
msgstr "　―――そうだ。草十郎、有珠と上手くいってる？」"

#. Occurrence 7_3:668:9318: scene=7_3
#: 7_3:668
msgctxt "text_id=9318 | speaker=unknown"
msgid "  Aoko cheerfully slumped over the table, now covered with textbooks and scribbled notes."
msgstr "　まだ教科書やらテキストやらが散乱しているテーブルに体を寝かせて、楽しそうに青子は言う。"

#. Occurrence 7_3:673:9319: scene=7_3
#: 7_3:673
msgctxt "text_id=9319 | speaker=unknown"
msgid "  Soujyuro watched her with a hint of resentment in his eyes."
msgstr "　そんな彼女に、草十郎は恨みがましい視線を送った。"

#. Occurrence 7_3:712:9320: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0006; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:712
msgctxt "text_id=9320 | speaker=soujuurou"
msgid "\"We only ever see each other at dinner, and you know how that goes. Honestly, I don't know why I should bother getting along with her.\""
msgstr "「彼女と会えるのは食事の時だけで、食事といったらアレだろう。どうやって仲良くなれって言うんだ」"

#. Occurrence 7_3:733:9321: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0010; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:733
msgctxt "text_id=9321 | speaker=aoko"
msgid "\"Really? And here's me thinking you'd have lots of motivation to play nice."
msgstr "「そう？　私はじゅうぶん脈アリだと思ったけど。"

#. Occurrence 7_3:739:9322: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0011; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:739
msgctxt "text_id=9322 | speaker=aoko"
msgid "  It's not like you're scared of her, for one. Plus, she's looking for any reason to kick you out."
msgstr "　<草|そ><十|っ><郎|ち>は有珠を恐がってないし、有珠は<草|そ><十|っ><郎|ち>を追い出す理由を見つけようと躍起になってるし。"

#. Occurrence 7_3:745:9323: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0012; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:745
msgctxt "text_id=9323 | speaker=aoko"
msgid "  Sounds like a great reason to make nice, if you ask me.\""
msgstr "　いい条件よ、これって」"

#. Occurrence 7_3:782:9324: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0007; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:782
msgctxt "text_id=9324 | speaker=soujuurou"
msgid "\"...Are you sure about that?"
msgstr "「……ぜんぜん分からないな。"

#. Occurrence 7_3:788:9325: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0008; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:788
msgctxt "text_id=9325 | speaker=soujuurou"
msgid "  Because to me, it feels a lot like me and you before everything at the amusement park. How is that a 'good' reason?\""
msgstr "　あの娘とこっちの関係は、遊園地前の蒼崎と俺の関係と同じじゃないか。いったいドコがいい条件なんだ？」"

#. Occurrence 7_3:820:9326: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0013; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:820
msgctxt "text_id=9326 | speaker=aoko"
msgid "\"My point is, there's no hostility between you, right?"
msgstr "「とりあえず反目しあってはいないでしょ？"

#. Occurrence 7_3:826:9327: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0014; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:826
msgctxt "text_id=9327 | speaker=aoko"
msgid "  It's a one-sided relationship, but that's not actually bad considering this is Alice we're talking about. You have a chance as long as she hasn't found a reason to off you."
msgstr "　一方通行の関係だけど、それはそれ、有珠にしちゃあ上出来っていうか。理由を探している時点で可能性アリってね。"

#. Occurrence 7_3:832:9328: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0015; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:832
msgctxt "text_id=9328 | speaker=aoko"
msgid "  She's usually quick to respond to hostility, and it's her enemies that usually end up destroying themselves.\""
msgstr "　あの娘は反感に応える事がクセになっちゃってるから、大抵、相手を自滅させちゃうのよ」"

#. Occurrence 7_3:873:9329: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0009; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:873
msgctxt "text_id=9329 | speaker=soujuurou"
msgid "\"?\""
msgstr "「？？」"

#. Occurrence 7_3:878:9330: scene=7_3
#: 7_3:878
msgctxt "text_id=9330 | speaker=unknown"
msgid "  Her ominous words only confused Soujyuro further."
msgstr "　抽象的な青子の言に、草十郎はますます首を傾げる。"

#. Occurrence 7_3:899:9331: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0016; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:899
msgctxt "text_id=9331 | speaker=aoko"
msgid "\"Once you understand that, it's actually pretty simple."
msgstr "「知ってしまえば単純な話なんだけどね、あの娘の場合。"

#. Occurrence 7_3:905:9332: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0017; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:905
msgctxt "text_id=9332 | speaker=aoko"
msgid "  Except...\""
msgstr "　ただ―――」"

#. Occurrence 7_3:910:9333: scene=7_3
#: 7_3:910
msgctxt "text_id=9333 | speaker=unknown"
msgid "  Whether or not he could put it into practice was another story altogether."
msgstr "　知ったところで、そのスタンスを実践できるかは別の話。"

#. Occurrence 7_3:943:9334: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0010; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:943
msgctxt "text_id=9334 | speaker=soujuurou"
msgid "\"Sounds like a difficult situation, then, Aozaki.\""
msgstr "「難しいよ、蒼崎は」"

#. Occurrence 7_3:949:9335: scene=7_3
#: 7_3:949
msgctxt "text_id=9335 | speaker=unknown"
msgid "  He carried their tea cups back to the table as he spoke."
msgstr "　言いつつ、草十郎はふたり分のティーカップを持ってテーブルに戻る。"

#. Occurrence 7_3:955:9336: scene=7_3
#: 7_3:955
msgctxt "text_id=9336 | speaker=unknown"
msgid "Aoko picked hers up and took a sip as if to dispel her exhaustion."
msgstr "青子はカップを受け取ると、疲れを打ち消すようにと口に運んだ。"

#. Occurrence 7_3:986:9337: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0011; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:986
msgctxt "text_id=9337 | speaker=soujuurou"
msgid "\"But, I think you're right."
msgstr "「でも、たしかに君の言う通りだ。"

#. Occurrence 7_3:992:9338: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0012; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:992
msgctxt "text_id=9338 | speaker=soujuurou"
msgid "  I still don't know her at all. The problem is, my knowledge of Alice Kuonji ends with her name.\""
msgstr "　俺はまだ、あの<娘|こ>の顔しか知らない。久遠寺有珠という名前すら<定|さだ>かじゃないのは、問題があるね」"

#. Occurrence 7_3:998:9339: scene=7_3
#: 7_3:998
msgctxt "text_id=9339 | speaker=unknown"
msgid "  He followed Aoko's lead and took a sip of his own."
msgstr "　青子に<倣|なら>ってカップに口をつける。"

#. Occurrence 7_3:1004:9340: scene=7_3
#: 7_3:1004
msgctxt "text_id=9340 | speaker=unknown"
msgid "His cup contained not tea but plain hot water."
msgstr "草十郎のカップに注がれたのは紅茶ではなく、ただのお湯だ。"

#. Occurrence 7_3:1029:9341: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0018; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1029
msgctxt "text_id=9341 | speaker=aoko"
msgid "\"Hm. Well, would you like me to tell you a bit about her?\""
msgstr "「ふーん。あの娘のこと、教えてほしい？」"

#. Occurrence 7_3:1034:9342: scene=7_3
#: 7_3:1034
msgctxt "text_id=9342 | speaker=unknown"
msgid "  Aoko scrutinized him carefully as she sat."
msgstr "　真横に座った草十郎を<覗|のぞ>きこむ青子。"

#. Occurrence 7_3:1039:9343: scene=7_3
#: 7_3:1039
msgctxt "text_id=9343 | speaker=unknown"
msgid "  Most boys would have been captivated by her gaze in that moment..."
msgstr "　まっとうな人間なら見惚れかねない青子の仕草に、"

#. Occurrence 7_3:1051:9344: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0013; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1051
msgctxt "text_id=9344 | speaker=soujuurou"
msgid "\"No. I think I should ask her myself.\""
msgstr "「いや。そういう事は、本人に訊いてあげるべきだと思う」"

#. Occurrence 7_3:1056:9345: scene=7_3
#: 7_3:1056
msgctxt "text_id=9345 | speaker=unknown"
msgid "  ...but he ignored her and stared straight ahead as if speaking directly to Alice herself."
msgstr "　彼は真摯に、居もしない少女に語りかけるよう、きっぱりと返答した。"

#. Occurrence 7_3:1083:9346: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0019; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1083
msgctxt "text_id=9346 | speaker=aoko"
msgid "\"...Fine."
msgstr "「……そうね。"

#. Occurrence 7_3:1090:9347: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0020; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1090
msgctxt "text_id=9347 | speaker=aoko"
msgid "You really want to do this her way, don't you?"
msgstr "ほんと、アンタって有珠好みの対応をするわ。"

#. Occurrence 7_3:1102:9348: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0021; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1102
msgctxt "text_id=9348 | speaker=aoko"
msgid "  Speaking of which, what exactly did you say to her in the guest room? I know she and I have an agreement, but I've never known her to just ignore a visitor for half a day.\""
msgstr "　ね。前から気になってたけど、客室で有珠に何を言ったの？　いくら私との約束とはいえ、あの娘が部外者を半日も放置するなんてあり得ないのよ？」"

#. Occurrence 7_3:1113:9349: scene=7_3
#: 7_3:1113
msgctxt "text_id=9349 | speaker=unknown"
msgid "  He thought back to that moment."
msgstr "　あの時―――"

#. Occurrence 7_3:1174:9350: scene=7_3
#: 7_3:1174
msgctxt "text_id=9350 | speaker=unknown"
msgid "  He could recall only two or three words he had exchanged with Alice after awakening in the guest room."
msgstr "　客室で目が覚めて、有珠と交わした二、三の言葉を草十郎は思い出した。"

#. Occurrence 7_3:1179:9351: scene=7_3
#: 7_3:1179
msgctxt "text_id=9351 | speaker=unknown"
msgid "  He did not recall the conversation being anything special, but he could not bring himself to casually share it with Aoko now."
msgstr "　あの会話が特別なものであったとは思えないが、だからといって、気軽に話すことはできない。"

#. Occurrence 7_3:1184:9352: scene=7_3
#: 7_3:1184
msgctxt "text_id=9352 | speaker=unknown"
msgid "  After all..."
msgstr "　あれは、その―――"

#. Occurrence 7_3:1220:9353: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0022; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1220
msgctxt "text_id=9353 | speaker=aoko"
msgid "\"Hey, what did you say that had such an effect on her?\""
msgstr "「ね、どんな台詞であの娘の気を変えたの？」"

#. Occurrence 7_3:1225:9354: scene=7_3
#: 7_3:1225
msgctxt "text_id=9354 | speaker=unknown"
msgid "  Aoko eagerly pressed him for answers."
msgstr "　教えなさい、と詰め寄ってくる青子。"

#. Occurrence 7_3:1231:9355: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0014; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1231
msgctxt "text_id=9355 | speaker=soujuurou"
msgid "\"...\""
msgstr "「―――」"

#. Occurrence 7_3:1236:9356: scene=7_3
#: 7_3:1236
msgctxt "text_id=9356 | speaker=unknown"
msgid "  Soujyuro frowned, unsure of what to say."
msgstr "　草十郎はむう、と難しそうに眉をひそめる。"

#. Occurrence 7_3:1241:9357: scene=7_3
#: 7_3:1241
msgctxt "text_id=9357 | speaker=unknown"
msgid "  He did not know what the interaction had been like for Alice, but for him it had felt special, sacred almost."
msgstr "　有珠にとってどうであったかは不明だが、彼にとって、あれは<侵|おか>しがたいものだった。"

#. Occurrence 7_3:1246:9358: scene=7_3
#: 7_3:1246
msgctxt "text_id=9358 | speaker=unknown"
msgid "  The question was, why-and for whom-was he so concerned?"
msgstr "　ある一点。なにを、誰に対して気遣ったか。"

#. Occurrence 7_3:1272:9359: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0023; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1272
msgctxt "text_id=9359 | speaker=aoko"
msgid "\"Come on, just tell me."
msgstr "「ほら、白状しなさいってば。"

#. Occurrence 7_3:1272:9360: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0023; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1272
msgctxt "text_id=9360 | speaker=aoko"
msgid "  I can tell you're just dying to let it out.\""
msgstr "　隠しごとなんて似合わないわよ？」"

#. Occurrence 7_3:1293:9361: scene=7_3
#: 7_3:1293
msgctxt "text_id=9361 | speaker=unknown"
msgid "  Her disconcerting smile moved even closer."
msgstr "　意地の悪い笑顔が、ずいっとにじり寄る。"

#. Occurrence 7_3:1299:9362: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0015; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1299
msgctxt "text_id=9362 | speaker=soujuurou"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 7_3:1304:9363: scene=7_3
#: 7_3:1304
msgctxt "text_id=9363 | speaker=unknown"
msgid "  Soujyuro did not look like he was able to stay silent much longer."
msgstr "　どうにも黙秘ではやり過ごせそうにない。"

#. Occurrence 7_3:1309:9364: scene=7_3
#: 7_3:1309
msgctxt "text_id=9364 | speaker=unknown"
msgid "  As he would eventually come to realize, Aoko Aozaki had a sometimes troubling propensity to gossip."
msgstr "　草十郎もいずれ知ることになるが、蒼崎青子はこれでゴシップ好きの困った一面があったりするのだ。"

#. Occurrence 7_3:1349:9365: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0016; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1349
msgctxt "text_id=9365 | speaker=soujuurou"
msgid "\"...Well, I can't tell you what we talked about."
msgstr "「―――まあ。あの<娘|こ>と何を話したかは言わないけど。"

#. Occurrence 7_3:1355:9366: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0017; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1355
msgctxt "text_id=9366 | speaker=soujuurou"
msgid "  But I will say that she wasn't as flirtatious as the way you are right now."
msgstr "　今の蒼崎に比べれば、花も浪漫もなかったのだけは確かかな。"

#. Occurrence 7_3:1362:9367: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0018; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1362
msgctxt "text_id=9367 | speaker=soujuurou"
msgid "After how strict you were earlier I didn't realize you had such a friendly side.\""
msgstr "さっきまでは蒼崎が鬼みたいだったから、いいもんだなって気が付かなかった」"

#. Occurrence 7_3:1368:9368: scene=7_3
#: 7_3:1368
msgctxt "text_id=9368 | speaker=unknown"
msgid "  He stared directly into her eyes as he spoke."
msgstr "　横から覗きこんでいる青子に、草十郎は真顔で視線を返す。"

#. Occurrence 7_3:1405:9369: scene=7_3
#: 7_3:1405
msgctxt "text_id=9369 | speaker=unknown"
msgid "  Aoko nearly leapt out of her seat in panic."
msgstr "　慌てて飛びのく青子。"

#. Occurrence 7_3:1410:9370: scene=7_3
#: 7_3:1410
msgctxt "text_id=9370 | speaker=unknown"
msgid "  Now that he pointed it out, she realized their bodies were practically touching."
msgstr "　言われてみれば、さっきまで体が触れ合うぐらい近寄っていた気がする。"

#. Occurrence 7_3:1437:9371: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0024; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1437
msgctxt "text_id=9371 | speaker=aoko"
msgid "\"S-So you noticed, huh? I was just u-using the most effective way to break you, of course!"
msgstr "「し、仕方ないでしょ、この方が効率良かったんだから。"

#. Occurrence 7_3:1460:9372: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0025; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1460
msgctxt "text_id=9372 | speaker=aoko"
msgid "  And besides, the moment you leave my side, all hell seems to break loose.\""
msgstr "　アンタ、横にいないとすぐ間違えるし」"

#. Occurrence 7_3:1474:9373: scene=7_3
#: 7_3:1474
msgctxt "text_id=9373 | speaker=unknown"
msgid "  Aoko stood up as she lashed back at him."
msgstr "　悪態を吐きつつ青子は立ち上がった。"

#. Occurrence 7_3:1509:9374: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0019; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1509
msgctxt "text_id=9374 | speaker=soujuurou"
msgid "\"You got me there. I haven't felt so focused in years."
msgstr "「そうだね。なんか昔みたいで、久しぶりに集中できた。"

#. Occurrence 7_3:1515:9375: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0020; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1515
msgctxt "text_id=9375 | speaker=soujuurou"
msgid "  Too bad this was just 'an exception among exceptions.'\""
msgstr "　これが異例中の異例っていうのが、本当に残念だ」"

#. Occurrence 7_3:1548:9376: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0026; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1548
msgctxt "text_id=9376 | speaker=aoko"
msgid "\"...Well look at you, Soujyuro. Before you know it, you'll be acing your exams and your relationship with Alice.\""
msgstr "「……余裕あるじゃない。その分じゃ今日のテストだけじゃなく、有珠との話し合いも上手くいきそうね、草十郎？」"

#. Occurrence 7_3:1566:9377: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0021; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1566
msgctxt "text_id=9377 | speaker=soujuurou"
msgid "\"I will, Aozaki. Don't you worry.\""
msgstr "「ああ、それはもちろん」"

#. Occurrence 7_3:1590:9378: scene=7_3
#: 7_3:1590
msgctxt "text_id=9378 | speaker=unknown"
msgid "  His cool response caught her off guard, and for a moment she was at a loss for words."
msgstr "　爽やかな返答に、青子はつい絶句する。"

#. Occurrence 7_3:1595:9379: scene=7_3
#: 7_3:1595
msgctxt "text_id=9379 | speaker=unknown"
msgid "  She meant it sarcastically, and yet he responded with a warm smile."
msgstr "　嫌味のつもりだったのに、まさか笑顔で返されるとは思ってもいなかったのだ。"

#. Occurrence 7_3:1629:9380: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0022; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1629
msgctxt "text_id=9380 | speaker=soujuurou"
msgid "\"I'm gonna change my strategy. The first step: engage her directly."
msgstr "「方針変更だ。まずは近くで話しかけてみるよ。"

#. Occurrence 7_3:1629:9381: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0022; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1629
msgctxt "text_id=9381 | speaker=soujuurou"
msgid "  You can't stay mad forever, as they say.\""
msgstr "　嫌なことは、いずれ終わるって分かったから」"

#. Occurrence 7_3:1635:9382: scene=7_3
#: 7_3:1635
msgctxt "text_id=9382 | speaker=unknown"
msgid "  Aoko remained in a state of silent shock as he spoke and rose to his feet."
msgstr "　そう言って立ち上がる草十郎の姿を、青子は絶句したまま見つめた。"

#. Occurrence 7_3:1640:9383: scene=7_3
#: 7_3:1640
msgctxt "text_id=9383 | speaker=unknown"
msgid "  She could not help but feel a reluctant respect for what seemed to be his newfound confidence and competence."
msgstr "　……頼りがいがある姿というか、きちんと芯の通った振る舞いというか。不覚にも、少しだけ尊敬してしまった程だ。"

#. Occurrence 7_3:1664:9384: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0023; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1664
msgctxt "text_id=9384 | speaker=soujuurou"
msgid "\"I'll go home by myself today and speak to Alice."
msgstr "「とりあえず今日はひとりで帰って、有珠と話してみる。"

#. Occurrence 7_3:1670:9385: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0024; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1670
msgctxt "text_id=9385 | speaker=soujuurou"
msgid "  You have a student council meeting after class, right?\""
msgstr "　蒼崎は放課後、生徒会だろう？」"

#. Occurrence 7_3:1679:9386: scene=7_3
#: 7_3:1679
msgctxt "text_id=9386 | speaker=unknown"
msgid "  He was right. It was their last meeting before winter break."
msgstr "　草十郎の言う通り、青子には冬休み直前の最後の会議が待ち受けていた。"

#. Occurrence 7_3:1684:9387: scene=7_3
#: 7_3:1684
msgctxt "text_id=9387 | speaker=unknown"
msgid "  Normally he would have waited until the meeting ended, or else gone straight to his part-time job."
msgstr "　本来なら会議の終わりまで待つか、学校からそのままアルバイトに行くのが草十郎の日課である。"

#. Occurrence 7_3:1702:9388: scene=7_3
#: 7_3:1702
msgctxt "text_id=9388 | speaker=unknown"
msgid "  This was part of Aoko's plan to make sure he and Alice were never alone in the mansion together."
msgstr "　それも、ひとえに洋館で草十郎と有珠が二人きりにならないよう、青子なりの配慮なのだが―――"

#. Occurrence 7_3:1724:9389: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0027; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1724
msgctxt "text_id=9389 | speaker=aoko"
msgid "\"...Hold it. You mean you're planning to face Alice by yourself?\""
msgstr "「……待った。まさかアンタ、ひとりで有珠とやりあうつもりなの？」"

#. Occurrence 7_3:1740:9390: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0025; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1740
msgctxt "text_id=9390 | speaker=soujuurou"
msgid "\"You make it sound like we're gonna get into a fight. I wouldn't stand a chance, you know that.\""
msgstr "「別にやりあうつもりはないぞ。<試|し><合|あ>っても勝てないだろ、有珠には」"

#. Occurrence 7_3:1745:9391: scene=7_3
#: 7_3:1745
msgctxt "text_id=9391 | speaker=unknown"
msgid "  His reply made complete sense, which floored her."
msgstr "　驚く青子に、平然と草十郎は返答する。"

#. Occurrence 7_3:1771:9392: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0026; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1771
msgctxt "text_id=9392 | speaker=soujuurou"
msgid "\"Even I can see that things only get more messy when you're around, Aozaki. That's why I'd appreciate it if you take your time with Tobimaru today.\""
msgstr "「でも、蒼崎がいたら話が複雑になるのは目に見えてるんだ。そんなワケで、今日はゆっくり鳶丸の相手でもしててくれ」"

#. Occurrence 7_3:1795:9393: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0028; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1795
msgctxt "text_id=9393 | speaker=aoko"
msgid "\"...Are you serious?\""
msgstr "「…………本気？」"

#. Occurrence 7_3:1815:9394: scene=7_3
#: 7_3:1815
msgctxt "text_id=9394 | speaker=unknown"
msgid "  He felt like he was being tested but nodded nonchalantly nonetheless."
msgstr "　試すような青子の問いに、草十郎は気軽に頷いた。"

#. Occurrence 7_3:1820:9395: scene=7_3
#: 7_3:1820
msgctxt "text_id=9395 | speaker=unknown"
msgid "  Knowing how grave the situation really was,"
msgstr "　事の深刻さを理解している青子と、"

#. Occurrence 7_3:1825:9396: scene=7_3
#: 7_3:1825
msgctxt "text_id=9396 | speaker=unknown"
msgid "  Aoko was not sure how to respond to his apparent lack of concern."
msgstr "　その深刻さは<要|い>らないと語る草十郎。"

#. Occurrence 7_3:1830:9397: scene=7_3
#: 7_3:1830
msgctxt "text_id=9397 | speaker=unknown"
msgid "  The morning light coming through the window marked a stark contrast between the two."
msgstr "　窓から差しこむ朝の光が、立ったまま話し合うふたりを光と影とに<別|わ>けている。"

#. Occurrence 7_3:1870:9398: scene=7_3
#: 7_3:1870
msgctxt "text_id=9398 | speaker=unknown"
msgid "  Which stood bathed in light?"
msgstr "　どちらが光に照らされているのか、"

#. Occurrence 7_3:1875:9399: scene=7_3
#: 7_3:1875
msgctxt "text_id=9399 | speaker=unknown"
msgid "  Which lurked in darkness? That went without saying."
msgstr "　どちらが影に佇んでいるかは、語るまでもない。"

#. Occurrence 7_3:1881:9400: scene=7_3
#: 7_3:1881
msgctxt "text_id=9400 | speaker=unknown"
msgid "  The silence lasted for only a brief moment."
msgstr "　短かな、ほんの数秒ほどの沈黙。"

#. Occurrence 7_3:1886:9401: scene=7_3
#: 7_3:1886
msgctxt "text_id=9401 | speaker=unknown"
msgid "  Staring at him gravely, she said,"
msgstr "　青子は草十郎を真顔で見つめて、"

#. Occurrence 7_3:1921:9402: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0029; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1921
msgctxt "text_id=9402 | speaker=aoko"
msgid "\"Fine. Then I won't stop you.\""
msgstr "「そ。なら止めはしないわ」"

#. Occurrence 7_3:1928:9403: scene=7_3
#: 7_3:1928
msgctxt "text_id=9403 | speaker=unknown"
msgid "  That was all she had."
msgstr "　青子はそう口にした。"

#. Occurrence 7_3:1933:9404: scene=7_3
#: 7_3:1933
msgctxt "text_id=9404 | speaker=unknown"
msgid "  Her dry tone hid the significance of their pregnant silence, not revealing the slightest sign of discord."
msgstr "　先ほどまでの沈黙の意図も、わずかな葛藤も感じさせない、彼女らしい<冷徹|ドライ>さ。"

#. Occurrence 7_3:1966:9405: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0027; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1966
msgctxt "text_id=9405 | speaker=soujuurou"
msgid "\"Are you sure you're not angry, Aozaki?\""
msgstr "「……なんか怒ってないか、蒼崎？」"

#. Occurrence 7_3:1984:9406: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0030; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1984
msgctxt "text_id=9406 | speaker=aoko"
msgid "\"Yes, I'm sure. But do you have some kind of plan? You need a good plan of attack with her, you know.\""
msgstr "「別に。それで、何か考えはあるの？　下手な考えは通じないわよ、あの娘には」"

#. Occurrence 7_3:2003:9407: scene=7_3
#: 7_3:2003
msgctxt "text_id=9407 | speaker=unknown"
msgid "  Soujyuro furrowed his brow in deep thought."
msgstr "　む、と眉をよせて考えこむ草十郎。"

#. Occurrence 7_3:2008:9408: scene=7_3
#: 7_3:2008
msgctxt "text_id=9408 | speaker=unknown"
msgid "  He knew it would be hard to get close to her through talk alone. In fact, it felt nearly impossible."
msgstr "　たしかに会話だけで有珠と親しくなるのは難しい。というか、不可能な気さえする。"

#. Occurrence 7_3:2029:9409: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_3_0000; voice_prefix=B50; voice_category=6; scene=7_3
#: 7_3:2029
msgctxt "text_id=9409 | speaker=kinomi"
msgid "\"Gifts work where words fail.\""
msgstr "“言葉で落ちないヤツは物で釣れ”"

#. Occurrence 7_3:2035:9410: scene=7_3
#: 7_3:2035
msgctxt "text_id=9410 | speaker=unknown"
msgid "  Kinomi had been the voice of wisdom (and folly) for him countless times in the past."
msgstr "　彼の数少ない相談相手（勘違い含む）である木乃美芳助はそんな助言をしてくれた。"

#. Occurrence 7_3:2040:9411: scene=7_3
#: 7_3:2040
msgctxt "text_id=9411 | speaker=unknown"
msgid "  Incidentally, Kinomi had been referring to Aoko at the time he shared that pearl of wisdom,"
msgstr "　ちなみに木乃美の助言は対青子用のものだったが、その時の草十郎の感想は、"

#. Occurrence 7_3:2045:9412: scene=7_3
#: 7_3:2045
msgctxt "text_id=9412 | speaker=unknown"
msgid "but Soujyuro had had the distinct impression that trying to buy Aozaki's kindness with gifts would not end well."
msgstr "“蒼崎を物で釣ると、後が恐そうだ”である。"

#. Occurrence 7_3:2081:9413: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0028; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:2081
msgctxt "text_id=9413 | speaker=soujuurou"
msgid "\"Hm. I don't know what kind of stuff Alice is in to."
msgstr "「……む。だいたい、有珠の趣味も分からないじゃないか。"

#. Occurrence 7_3:2087:9414: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0029; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:2087
msgctxt "text_id=9414 | speaker=soujuurou"
msgid "  We probably have almost nothing in common.\""
msgstr "　考えてみると、今の自分と彼女はまるで接点がない」"

#. Occurrence 7_3:2093:9415: scene=7_3
#: 7_3:2093
msgctxt "text_id=9415 | speaker=unknown"
msgid "  Soujyuro crossed his arms at a loss."
msgstr "　困ったな、と腕を組む草十郎。"

#. Occurrence 7_3:2126:9416: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0031; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2126
msgctxt "text_id=9416 | speaker=aoko"
msgid "\"In other words, you haven't got any plan, as usual.\""
msgstr "「いつもの事だけど、何も考えてなかったワケね」"

#. Occurrence 7_3:2139:9417: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0030; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:2139
msgctxt "text_id=9417 | speaker=soujuurou"
msgid "\"Right. But I don't want to overthink this too much, either."
msgstr "「うん。でもまあ、あれこれ考えなくてもいいと思う。"

#. Occurrence 7_3:2159:9418: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0031; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:2159
msgctxt "text_id=9418 | speaker=soujuurou"
msgid "  It's not like I'm going to explain things to her and then she'll suddenly understand. I mean...\""
msgstr "　有珠にはあれこれ説明するとか、分かってもらおうとか、そういうんじゃなくて、なんていうか―――」"

#. Occurrence 7_3:2179:9419: scene=7_3
#: 7_3:2179
msgctxt "text_id=9419 | speaker=unknown"
msgid "  He pondered intently as he tried to put his vague thoughts into something concrete."
msgstr "　言葉にできない印象を、なんとか言葉にしようと悩む。"

#. Occurrence 7_3:2179:9420: scene=7_3
#: 7_3:2179
msgctxt "text_id=9420 | speaker=unknown"
msgid "  But he did not spend much time in thought."
msgstr "　思考時間は短かった。"

#. Occurrence 7_3:2184:9421: scene=7_3
#: 7_3:2184
msgctxt "text_id=9421 | speaker=unknown"
msgid "  With a nod he concluded,"
msgstr "　草十郎はああ、と小さく頷いて、"

#. Occurrence 7_3:2191:9422: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0032; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:2191
msgctxt "text_id=9422 | speaker=soujuurou"
msgid "\"What's more important is whether I like her or not, right?\""
msgstr "「要は、俺が彼女を好きかどうかって事じゃないか？」"

#. Occurrence 7_3:2197:9423: scene=7_3
#: 7_3:2197
msgctxt "text_id=9423 | speaker=unknown"
msgid "  He articulated that which is often so hard to say, with surprising clarity and calm."
msgstr "　あっさりと、言いづらい感想を口にした。"

#. Occurrence 7_3:2229:9424: scene=7_3
#: 7_3:2229
msgctxt "text_id=9424 | speaker=unknown"
msgid "  It was certainly a prerequisite for the task he hoped to achieve."
msgstr "　確かに、それは全ての前提だ。"

#. Occurrence 7_3:2234:9425: scene=7_3
#: 7_3:2234
msgctxt "text_id=9425 | speaker=unknown"
msgid "  He had no hope of making her appreciate him with words,"
msgstr "　認められるために話すのではなく、"

#. Occurrence 7_3:2239:9426: scene=7_3
#: 7_3:2239
msgctxt "text_id=9426 | speaker=unknown"
msgid "  or with acts of giving with the expectation of reciprocation."
msgstr "　見返りを求めての求愛でもない。"

#. Occurrence 7_3:2244:9427: scene=7_3
#: 7_3:2244
msgctxt "text_id=9427 | speaker=unknown"
msgid "  He simply wished to get to know her better because he liked her."
msgstr "　まずその人が好きだから、触れ合ってみようと思う。"

#. Occurrence 7_3:2249:9428: scene=7_3
#: 7_3:2249
msgctxt "text_id=9428 | speaker=unknown"
msgid "  That was his honest, uncontrived intention, and it reflected the purity of his heart."
msgstr "　それは打算のない、清潔な心のあり方だ。"

#. Occurrence 7_3:2269:9429: scene=7_3
#: 7_3:2269
msgctxt "text_id=9429 | speaker=unknown"
msgid "  But whether that was in his best interest or not was another story altogether."
msgstr "　けれど、それが人間として幸福かどうかは、また別の話。"

#. Occurrence 7_3:2275:9430: scene=7_3
#: 7_3:2275
msgctxt "text_id=9430 | speaker=unknown"
msgid "  Calculation and compromise, selfishness and conflict."
msgstr "　計算と妥協、我欲と食い合い。"

#. Occurrence 7_3:2280:9431: scene=7_3
#: 7_3:2280
msgctxt "text_id=9431 | speaker=unknown"
msgid "  Purity such as his often irritated people who believed that morals went against human nature."
msgstr "　道徳が非人間と<糾|うた>うものこそが正しい人間性と信じる者には、その清潔さは目に痛い。"

#. Occurrence 7_3:2285:9432: scene=7_3
#: 7_3:2285
msgctxt "text_id=9432 | speaker=unknown"
msgid "  Or rather..."
msgstr "　……いや、正しくは。"

#. Occurrence 7_3:2291:9433: scene=7_3
#: 7_3:2291
msgctxt "text_id=9433 | speaker=unknown"
msgid "People who were inevitably forced to believe it."
msgstr "そう信じざるを得なくなってしまった者にとっては。"

#. Occurrence 7_3:2333:9434: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0032; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2333
msgctxt "text_id=9434 | speaker=aoko"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 7_3:2339:9435: scene=7_3
#: 7_3:2339
msgctxt "text_id=9435 | speaker=unknown"
msgid "  Aoko silently walked away without responding to what Soujyuro said."
msgstr "　草十郎の言葉に何も返さず、青子は音もなく歩きだした。"

#. Occurrence 7_3:2344:9436: scene=7_3
#: 7_3:2344
msgctxt "text_id=9436 | speaker=unknown"
msgid "  Her long hair swung from side to side as she passed him."
msgstr "　長い髪を揺らして、草十郎の前を通り過ぎる。"

#. Occurrence 7_3:2365:9437: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0033; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:2365
msgctxt "text_id=9437 | speaker=soujuurou"
msgid "\"Aozaki?\""
msgstr "「蒼崎？」"

#. Occurrence 7_3:2370:9438: scene=7_3
#: 7_3:2370
msgctxt "text_id=9438 | speaker=unknown"
msgid "  Noting her strangely cold manner, he called out to her."
msgstr "　どこか冷たい素振りの彼女を、草十郎は呼び止める。"

#. Occurrence 7_3:2375:9439: scene=7_3
#: 7_3:2375
msgctxt "text_id=9439 | speaker=unknown"
msgid "  However, she was already opening the door to leave."
msgstr "　青子はもう部屋のドアを開けていた。"

#. Occurrence 7_3:2409:9440: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0033; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2409
msgctxt "text_id=9440 | speaker=aoko"
msgid "\"I'm going to take a shower downstairs."
msgstr "「下でシャワー浴びてくるから。"

#. Occurrence 7_3:2409:9441: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0033; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2409
msgctxt "text_id=9441 | speaker=aoko"
msgid "  You can go back to your room.\""
msgstr "　貴方は自分の部屋に戻ってて」"

#. Occurrence 7_3:2415:9442: scene=7_3
#: 7_3:2415
msgctxt "text_id=9442 | speaker=unknown"
msgid "  Her words lacked any expressive inflection."
msgstr "　<抑揚|よくよう>のない台詞。"

#. Occurrence 7_3:2420:9443: scene=7_3
#: 7_3:2420
msgctxt "text_id=9443 | speaker=unknown"
msgid "  In his confusion, all Soujyuro could do was nod."
msgstr "　それに戸惑いながらも草十郎は頷いた。"

#. Occurrence 7_3:2441:9444: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0034; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:2441
msgctxt "text_id=9444 | speaker=soujuurou"
msgid "\"Okay... But are you sure you're not mad?\""
msgstr "「いいけど……やっぱり怒ってないか、蒼崎？」"

#. Occurrence 7_3:2454:9445: scene=7_3
#: 7_3:2454
msgctxt "text_id=9445 | speaker=unknown"
msgid "  Emotion returned to her face as he spoke."
msgstr "　言われて、青子の顔に表情が戻る。"

#. Occurrence 7_3:2459:9446: scene=7_3
#: 7_3:2459
msgctxt "text_id=9446 | speaker=unknown"
msgid "  Yet it was not the typical irritated look to which he had grown so accustomed."
msgstr "　それはいつもの、もう見慣れた不機嫌そうな顔ではなかった。"

#. Occurrence 7_3:2487:9447: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0034; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2487
msgctxt "text_id=9447 | speaker=aoko"
msgid "\"I guess I might be what someone like you would call mad."
msgstr "「……そうね。アンタ流に言えば、たぶん私は怒ってる。"

#. Occurrence 7_3:2493:9448: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0035; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2493
msgctxt "text_id=9448 | speaker=aoko"
msgid "  I'd rather not discuss the reason why, though.\""
msgstr "　何に対してのものかは、あんまり言いたくないけど」"

#. Occurrence 7_3:2511:9449: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0035; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:2511
msgctxt "text_id=9449 | speaker=soujuurou"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence 7_3:2517:9450: scene=7_3
#: 7_3:2517
msgctxt "text_id=9450 | speaker=unknown"
msgid "  Poor Soujyuro did not even realize that he himself was the reason."
msgstr "　その原因が自分である事すら草十郎には分からない。"

#. Occurrence 7_3:2522:9451: scene=7_3
#: 7_3:2522
msgctxt "text_id=9451 | speaker=unknown"
msgid "  She looked at him, and for an instant he witnessed an emotion on her face of which he had never seen the likes of before."
msgstr "　そんな草十郎を見て、彼女はほんの一瞬だけ、今まで草十郎が見たことのない表情を見せた。"

#. Occurrence 7_3:2556:9452: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0036; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2556
msgctxt "text_id=9452 | speaker=aoko"
msgid "\"See you. This might be the last time we meet, so I should say goodbye."
msgstr "「じゃあね。これが最後になるかも知れないから、お別れぐらいは言っておくわ。"

#. Occurrence 7_3:2562:9453: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0037; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2562
msgctxt "text_id=9453 | speaker=aoko"
msgid "  You take Alice far too lightly, you know."
msgstr "　貴方は有珠を甘く見すぎてる。"

#. Occurrence 7_3:2568:9454: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0038; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2568
msgctxt "text_id=9454 | speaker=aoko"
msgid "  For you that's a strength, but for us, it's pure poison.\""
msgstr "　……でも、それが同時にアンタの強みなのよね。私たちには、毒にしかならないけれど」"

#. Occurrence 7_3:2595:9455: scene=7_3
#: 7_3:2595
msgctxt "text_id=9455 | speaker=unknown"
msgid "  The door slammed loudly shut behind her."
msgstr "　バタン、と音をたてて閉められるドア。"

#. Occurrence 7_3:2600:9456: scene=7_3
#: 7_3:2600
msgctxt "text_id=9456 | speaker=unknown"
msgid "  Her steps were audible as she walked away on the other side of the wall."
msgstr "　壁ごしに歩み去っていく足音が聞こえてくる。"

#. Occurrence 7_3:2605:9457: scene=7_3
#: 7_3:2605
msgctxt "text_id=9457 | speaker=unknown"
msgid "  The corridor must have been nearly freezing without any central heating, but Aoko seemed perfectly comfortable."
msgstr "　暖房のない廊下は冷蔵庫なみの寒さのはずだが、青子は慣れているようだった。"

#. Occurrence 7_3:2653:9458: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0039; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2653
msgctxt "text_id=9458 | speaker=aoko"
msgid "\"Wait, why am I leaving first?"
msgstr "「―――って、なんで私から出ていくんだっ。"

#. Occurrence 7_3:2659:9459: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0040; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2659
msgctxt "text_id=9459 | speaker=aoko"
msgid "  This is all backward! It's my room, you go first!\""
msgstr "　順番が逆！　普通、先に出てくのは<男子|そっち>じゃない」"

#. Occurrence 7_3:2701:9460: scene=7_3
#: 7_3:2701
msgctxt "text_id=9460 | speaker=unknown"
msgid "  Aoko promptly kicked Soujyuro out of her room."
msgstr "　しっしっ、と青子にうながされ、部屋からほっぽり出される草十郎。"

#. Occurrence 7_3:2711:9461: scene=7_3
#: 7_3:2711
msgctxt "text_id=9461 | speaker=unknown"
msgid "  Once again the wooden door closed with a slam."
msgstr "　バタン、と閉じられる木製の扉。"

#. Occurrence 7_3:2716:9462: scene=7_3
#: 7_3:2716
msgctxt "text_id=9462 | speaker=unknown"
msgid "  The corridor was not as cold as he had expected."
msgstr "　思っていたほど廊下は冷えこんでいなかった。"

#. Occurrence 7_3:2722:9463: scene=7_3
#: 7_3:2722
msgctxt "text_id=9463 | speaker=unknown"
msgid "  Not quite as bad as a freezer, at least."
msgstr "　―――まあ、冷蔵庫よりはマシな程度には。"

#. Occurrence 7_5:123:9464: scene=7_5
#: 7_5:123
msgctxt "text_id=9464 | speaker=unknown"
msgid "  The second day of exams ended and Soujyuro was on his way back to the mansion."
msgstr "　二日目の期末試験が終わって、草十郎はひとり洋館への帰路についた。"

#. Occurrence 7_5:128:9465: scene=7_5
#: 7_5:128
msgctxt "text_id=9465 | speaker=unknown"
msgid "  The road grew steeper and the woods thicker as he made his way up the familiar slope."
msgstr "　坂道は上に行くほど傾斜を増していき、森も深さを増していく。"

#. Occurrence 7_5:133:9466: scene=7_5
#: 7_5:133
msgctxt "text_id=9466 | speaker=unknown"
msgid "  People in town called it not a hill but a mountain, simply because it took over twenty minutes to climb."
msgstr "　それが二十分以上も続くのだから、地域住人たちにとって久遠寺邸のある丘は山以外の何物でもない。"

#. Occurrence 7_5:153:9467: scene=7_5
#: 7_5:153
msgctxt "text_id=9467 | speaker=unknown"
msgid "  This did not sit well with Soujyuro, for whom a mountain was something that could not be overcome so easily."
msgstr "　一方、草十郎にすれば歩くだけで踏破できる森を山と呼ぶには抵抗がある。"

#. Occurrence 7_5:158:9468: scene=7_5
#: 7_5:158
msgctxt "text_id=9468 | speaker=unknown"
msgid "  The road was paved, for one thing,"
msgstr "　舗装された道があり、"

#. Occurrence 7_5:163:9469: scene=7_5
#: 7_5:163
msgctxt "text_id=9469 | speaker=unknown"
msgid "  and the canopy overhead let in plenty of sunlight to guide the way."
msgstr "　日射しで方角を確かめられる程度の森であり、"

#. Occurrence 7_5:168:9470: scene=7_5
#: 7_5:168
msgctxt "text_id=9470 | speaker=unknown"
msgid "  None of the inclines were especially steep, and no animals lurked in the underbrush."
msgstr "　急な斜面も、<茂|しげ>みに<潜|ひそ>む動物の姿もない。"

#. Occurrence 7_5:173:9471: scene=7_5
#: 7_5:173
msgctxt "text_id=9471 | speaker=unknown"
msgid "  There was no chance of losing his way, no reason to worry about getting lost."
msgstr "　ここでは遭難の恐れはおろか、迷う事を心配する必要もないのだから。"

#. Occurrence 7_5:205:9472: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0000; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:205
msgctxt "text_id=9472 | speaker=soujuurou"
msgid "\"...How sad. I'm still complaining.\""
msgstr "「……情けない。まだ未練ばっかりだ」"

#. Occurrence 7_5:211:9473: scene=7_5
#: 7_5:211
msgctxt "text_id=9473 | speaker=unknown"
msgid "  Soujyuro quietly reprimanded himself for getting so wrapped up in his own little world."
msgstr "　知らず知らずのうち回想していた自分を、草十郎は静かに罵倒した。"

#. Occurrence 7_5:216:9474: scene=7_5
#: 7_5:216
msgctxt "text_id=9474 | speaker=unknown"
msgid "  In the past few weeks since moving here he had been constantly comparing the town with his former mountain home."
msgstr "　町に引っ越してきてからの数週間は、山と町を比較してばかりだった。"

#. Occurrence 7_5:236:9475: scene=7_5
#: 7_5:236
msgctxt "text_id=9475 | speaker=unknown"
msgid "  Normally he would not get upset over it,"
msgstr "　その時はこんな風に自分を叱る事もなかったが、"

#. Occurrence 7_5:236:9476: scene=7_5
#: 7_5:236
msgctxt "text_id=9476 | speaker=unknown"
msgid "  but in recent days--since meeting Aoko, as it happened--he had become rather hung up on the differences."
msgstr "　ここ数日―――蒼崎青子と知り合ってからは、それが後ろ向きだという事にようやく気が付いたのだ。"

#. Occurrence 7_5:241:9477: scene=7_5
#: 7_5:241
msgctxt "text_id=9477 | speaker=unknown"
msgid "  The reasons for this eluded him, but he knew that Aoko was a force that could not be stopped."
msgstr "　理由、理念はどうあれ立ち止まらない少女。"

#. Occurrence 7_5:250:9478: scene=7_5
#: 7_5:250
msgctxt "text_id=9478 | speaker=unknown"
msgid "  This naturally made him want to quicken his own pace."
msgstr "　その姿を目で追ううちに、自分も自然と早足になっていたらしい。"

#. Occurrence 7_5:290:9479: scene=7_5
#: 7_5:290
msgctxt "text_id=9479 | speaker=unknown"
msgid "  The mansion where they both lived was the antipathy of her lively personality."
msgstr "　その青子が住む洋館は、活き活きとした彼女には不釣り合いな<趣|おもむき>だ。"

#. Occurrence 7_5:295:9480: scene=7_5
#: 7_5:295
msgctxt "text_id=9480 | speaker=unknown"
msgid "  It stood out like a sore thumb, even in a town like Misaki."
msgstr "　三咲町の中でも<一際|ひときわ>異彩な建物。"

#. Occurrence 7_5:300:9481: scene=7_5
#: 7_5:300
msgctxt "text_id=9481 | speaker=unknown"
msgid "  Some people said it was haunted."
msgstr "　幽霊屋敷と呼ばれる洋館。"

#. Occurrence 7_5:305:9482: scene=7_5
#: 7_5:305
msgctxt "text_id=9482 | speaker=unknown"
msgid "  There were no ghosts, per se, but it was inhabited by magicians, so their claims were closer to the truth than they could have possibly known."
msgstr "　実際住んでいるのは幽霊ではなく魔法使いなのだけど、どっちもどっちなので、世論というのはわりと正しいのかもしれない。"

#. Occurrence 7_5:347:9483: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0001; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:347
msgctxt "text_id=9483 | speaker=soujuurou"
msgid "\"Speaking of which, I wonder. Between ghosts and magicians, which would be more surprising?\""
msgstr "「……そう言えば。幽霊と魔法使いっていうのは、どっちが常識はずれなんだろう？」"

#. Occurrence 7_5:353:9484: scene=7_5
#: 7_5:353
msgctxt "text_id=9484 | speaker=unknown"
msgid "  Lost in contemplation as he was, the boy failed to notice how his own lack of familiarity with city life played into the equation."
msgstr "　都会の生活に慣れていない自分を棚に上げて、草十郎ははて、と首をひねる。"

#. Occurrence 7_5:358:9485: scene=7_5
#: 7_5:358
msgctxt "text_id=9485 | speaker=unknown"
msgid "  In any case, none of his pondering changed what needed to be done."
msgstr "　ともあれ、どちらにしてもやるべき事は変わらない。"

#. Occurrence 7_5:378:9486: scene=7_5
#: 7_5:378
msgctxt "text_id=9486 | speaker=unknown"
msgid "  Tomorrow was the last day of exams."
msgstr "　期末試験は明日で終わりだ。"

#. Occurrence 7_5:383:9487: scene=7_5
#: 7_5:383
msgctxt "text_id=9487 | speaker=unknown"
msgid "  That meant he only had a little longer until Aoko stopped taking responsibility for his safety."
msgstr "　青子が責任持って草十郎を保護する、といったリミットまであとわずか。"

#. Occurrence 7_5:388:9488: scene=7_5
#: 7_5:388
msgctxt "text_id=9488 | speaker=unknown"
msgid "  If possible, today was going to be the day when the mansion's owner accepted his continued residence there."
msgstr "　可能であるなら今日のうちに、草十郎は洋館の主に同居人として認められなくてはいけない。"

#. Occurrence 7_5:426:9489: scene=7_5
#: 7_5:426
msgctxt "text_id=9489 | speaker=unknown"
msgid "  Soujyuro slipped between the trees encircling the mansion and walked down the naturally tree-lined avenue that led him to the front door."
msgstr "　館をぐるりと囲む木々の隙間、自然の並木道を通って、草十郎は玄関まで歩いていく。"

#. Occurrence 7_5:435:9490: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0002; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:435
msgctxt "text_id=9490 | speaker=soujuurou"
msgid "\"...Here goes.\""
msgstr "「――――――よし」"

#. Occurrence 7_5:440:9491: scene=7_5
#: 7_5:440
msgctxt "text_id=9491 | speaker=unknown"
msgid "  Taking a deep breath he stepped across the threshold."
msgstr "　玄関の前で一度だけ深呼吸をし、草十郎は館内へと入っていった。"

#. Occurrence 7_5:445:9492: scene=7_5
#: 7_5:445
msgctxt "text_id=9492 | speaker=unknown"
msgid "  The drawing room was where he expected to find Alice."
msgstr "　目指すは有珠がいるであろう居間である。"

#. Occurrence 7_5:483:9493: scene=7_5
#: 7_5:483
msgctxt "text_id=9493 | speaker=unknown"
msgid "  However..."
msgstr "　しかし。"

#. Occurrence 7_5:488:9494: scene=7_5
#: 7_5:488
msgctxt "text_id=9494 | speaker=unknown"
msgid "  He found himself face to face with a most unexpected scene."
msgstr "　そんな草十郎を迎えたのは、予想外の光景だった。"

#. Occurrence 7_5:508:9495: scene=7_5
#: 7_5:508
msgctxt "text_id=9495 | speaker=unknown"
msgid "  A few steps in, he arrived at the large foyer extending from the mansion's entrance."
msgstr "　少し歩いて、玄関から館のホールであるロビーに辿り着く。"

#. Occurrence 7_5:528:9496: scene=7_5
#: 7_5:528
msgctxt "text_id=9496 | speaker=unknown"
msgid "  But one thing was clearly out of place."
msgstr "　そのロビーにひとつ、大きな違和感がある。"

#. Occurrence 7_5:533:9497: scene=7_5
#: 7_5:533
msgctxt "text_id=9497 | speaker=unknown"
msgid "  The foyer of the mansion was like a hall in a medieval castle."
msgstr "　中世の城を思わせる洋館のロビー。"

#. Occurrence 7_5:538:9498: scene=7_5
#: 7_5:538
msgctxt "text_id=9498 | speaker=unknown"
msgid "  It was illuminated by the cold winter sun casting down through the skylight, unaided by artificial light."
msgstr "　人工の明かりは一切なく、冬の肌寒い日射しが、さあ、と天窓から影を落としている。"

#. Occurrence 7_5:574:9499: scene=7_5
#: 7_5:574
msgctxt "text_id=9499 | speaker=unknown"
msgid "  The wooden tiles smelled of the outdoors."
msgstr "　緑薫る、木製のタイル。"

#. Occurrence 7_5:592:9500: scene=7_5
#: 7_5:592
msgctxt "text_id=9500 | speaker=unknown"
msgid "  And there was Alice, dressed all in black, huddled against a column so enormous it resembled a sharply cornered tree trunk."
msgstr "　四角い大樹によりそう黒衣。"

#. Occurrence 7_5:610:9501: scene=7_5
#: 7_5:610
msgctxt "text_id=9501 | speaker=unknown"
msgid "  The mansion was quite literally supporting her frail body."
msgstr "　少女は文字通り、洋館に体を預けている。"

#. Occurrence 7_5:628:9502: scene=7_5
#: 7_5:628
msgctxt "text_id=9502 | speaker=unknown"
msgid "  Like a mother's lullaby, or a gently rocking cradle."
msgstr "　母親の子守歌か、穏やかな揺りかごか。"

#. Occurrence 7_5:646:9503: scene=7_5
#: 7_5:646
msgctxt "text_id=9503 | speaker=unknown"
msgid "  The heavy atmosphere within this old building suppressed even the slightest stir, almost as if warding away any disturbance to her slumber."
msgstr "　洋館は少女の眠りを守るように、空気のざわめきさえ飲みこんでいた。"

#. Occurrence 7_5:680:9504: scene=7_5
#: 7_5:680
msgctxt "text_id=9504 | speaker=unknown"
msgid "  There she slept in the shadows of home."
msgstr "　館の影で眠る少女。"

#. Occurrence 7_5:685:9505: scene=7_5
#: 7_5:685
msgctxt "text_id=9505 | speaker=unknown"
msgid "  Hidden away from outsiders, her sleeping figure was enough to mesmerize anyone who laid eyes upon her."
msgstr "　余人の目から隠された有珠の姿は、このロビーで最も鮮明に、見る者を魅了する。"

#. Occurrence 7_5:706:9506: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0003; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:706
msgctxt "text_id=9506 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 7_5:711:9507: scene=7_5
#: 7_5:711
msgctxt "text_id=9507 | speaker=unknown"
msgid "  Soujyuro instinctively looked up at the ceiling out of sheer awkwardness."
msgstr "　草十郎は当惑から、つい天井をあおいでしまった。"

#. Occurrence 7_5:717:9508: scene=7_5
#: 7_5:717
msgctxt "text_id=9508 | speaker=unknown"
msgid "  He wanted to surprise her, but not in this way."
msgstr "　……だって、不意打ちにも程がある。"

#. Occurrence 7_5:722:9509: scene=7_5
#: 7_5:722
msgctxt "text_id=9509 | speaker=unknown"
msgid "  Her slender frame lay asleep by the fireplace."
msgstr "　少女は暖炉の傍で、その細い体を預けて眠っている。"

#. Occurrence 7_5:727:9510: scene=7_5
#: 7_5:727
msgctxt "text_id=9510 | speaker=unknown"
msgid "  The scene was as beautiful as a painting, yet hard on his heart at the same time."
msgstr "　いかに美しい絵画のようでも、この状況は心臓に悪い。"

#. Occurrence 7_5:761:9511: scene=7_5
#: 7_5:761
msgctxt "text_id=9511 | speaker=unknown"
msgid "  Her slumber seemed...breathless."
msgstr "　……命を感じさせない眠り。"

#. Occurrence 7_5:766:9512: scene=7_5
#: 7_5:766
msgctxt "text_id=9512 | speaker=unknown"
msgid "  She was too still, with not even a hint of movement."
msgstr "　あまりにも静かで、取り除くもののないカタチ。"

#. Occurrence 7_5:780:9513: scene=7_5
#: 7_5:780
msgctxt "text_id=9513 | speaker=unknown"
msgid "  And yet, slumped against that frigid column under the cold winter sky, happiness appeared to be her blanket."
msgstr "　この寒空の下、冷たい柱にしなだれているのに、彼女は幸福に包まれていた。"

#. Occurrence 7_5:786:9514: scene=7_5
#: 7_5:786
msgctxt "text_id=9514 | speaker=unknown"
msgid "  A passerby would not be blamed for thinking she was in that most peaceful state of eternal slumber: death."
msgstr "　死という名の永眠を、見る者に思わせてしまうほどの。"

#. Occurrence 7_5:859:9515: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0004; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:859
msgctxt "text_id=9515 | speaker=soujuurou"
msgid "\"She must be pretty cold.\""
msgstr "「……寒くないのかな、この子は」"

#. Occurrence 7_5:865:9516: scene=7_5
#: 7_5:865
msgctxt "text_id=9516 | speaker=unknown"
msgid "  Soujyuro spoke to himself as he gazed idly upon her."
msgstr "　ぼんやりと有珠を眺めながら、ぽつりと呟く。"

#. Occurrence 7_5:870:9517: scene=7_5
#: 7_5:870
msgctxt "text_id=9517 | speaker=unknown"
msgid "  Bringing her a blanket or something warm did not so much as cross the boy's mind."
msgstr "　毛布でも持ってくる……なんて気の利いた案を、彼は微塵も考えなかった。"

#. Occurrence 7_5:886:9518: scene=7_5
#: 7_5:886
msgctxt "text_id=9518 | speaker=unknown"
msgid "  Instead, odd as it sounds, the first thing he thought to do was to go prepare some tea."
msgstr "　代わりに思いついた事は、なぜか、ふたり分のお茶を淹れる事だった。"

#. Occurrence 7_5:927:9519: scene=7_5
#: 7_5:927
msgctxt "text_id=9519 | speaker=unknown"
msgid "  He made sure to be as quiet as possible as he opened the drawing room door."
msgstr "　静かにドアを開けて居間に移動する。"

#. Occurrence 7_5:932:9520: scene=7_5
#: 7_5:932
msgctxt "text_id=9520 | speaker=unknown"
msgid "  On the table, waiting for him, were three pills."
msgstr "　テーブルの上には三粒の錠剤。"

#. Occurrence 7_5:937:9521: scene=7_5
#: 7_5:937
msgctxt "text_id=9521 | speaker=unknown"
msgid "  They were the medicine Aoko required him to take every day when he arrived home."
msgstr "　毎日帰ってきたら飲むように、と青子から言われている薬である。"

#. Occurrence 7_5:942:9522: scene=7_5
#: 7_5:942
msgctxt "text_id=9522 | speaker=unknown"
msgid "  Gulping down the vaguely sweet pills and continuing on to the kitchen, he selected a box of tea from among the many in the cabinet and brewed enough for two people."
msgstr "　わずかに甘い錠剤を飲みこんで台所に足を運び、数ある紅茶の箱からひとつを選んで、ふたり分の紅茶を淹れる。"

#. Occurrence 7_5:958:9523: scene=7_5
#: 7_5:958
msgctxt "text_id=9523 | speaker=unknown"
msgid "  Alice was still asleep when he returned to the foyer."
msgstr "　そうしてロビーに戻ってみても、少女は眠ったままだった。"

#. Occurrence 7_5:1005:9524: scene=7_5
#: 7_5:1005
msgctxt "text_id=9524 | speaker=unknown"
msgid "  Careful not to make any noise, he crouched close to the ground."
msgstr "　物音に少しだけ気を配って床に腰を下ろす。"

#. Occurrence 7_5:1010:9525: scene=7_5
#: 7_5:1010
msgctxt "text_id=9525 | speaker=unknown"
msgid "  He was startled by how cold the floor felt through his pants."
msgstr "　ズボン越しに伝わってくる床の<感触|つめたさ>にビックリする。"

#. Occurrence 7_5:1015:9526: scene=7_5
#: 7_5:1015
msgctxt "text_id=9526 | speaker=unknown"
msgid "  He thought it would be warmer here by the fireplace, but then again he recalled how Aoko had referred to it as \"a useless hole in the wall.\""
msgstr "　暖炉の<傍|そば>なら温かいのでは、と考えもしたが、青子曰く、あの暖炉は無用の長物とかなんとか。"

#. Occurrence 7_5:1020:9527: scene=7_5
#: 7_5:1020
msgctxt "text_id=9527 | speaker=unknown"
msgid "  What was likely the case was that neither she nor Alice knew how to use it properly."
msgstr "　青子も有珠も手入れの仕方を知らないらしい。"

#. Occurrence 7_5:1053:9528: scene=7_5
#: 7_5:1053
msgctxt "text_id=9528 | speaker=unknown"
msgid "  After taking the teacups from the tray and placing one in front of each of them, Soujyuro carefully pulled his textbook on classical literature from his satchel."
msgstr "　草十郎は盆に載せたティーカップを有珠と自分の前に置くと、おもむろに鞄から古典の教科書を取り出した。"

#. Occurrence 7_5:1074:9529: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0005; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:1074
msgctxt "text_id=9529 | speaker=soujuurou"
msgid "\"I better get to work or Aozaki will get mad at me again.\""
msgstr "「……蒼崎、怒ってたからな」"

#. Occurrence 7_5:1080:9530: scene=7_5
#: 7_5:1080
msgctxt "text_id=9530 | speaker=unknown"
msgid "  He could still see her angry face from this morning."
msgstr "　今朝の青子の顔を思い出して、つい独白する。"

#. Occurrence 7_5:1085:9531: scene=7_5
#: 7_5:1085
msgctxt "text_id=9531 | speaker=unknown"
msgid "  The reason for her anger was still as much a mystery as the unusual look he saw briefly come across her face."
msgstr "　彼女が怒っていた理由も、あの一瞬の顔もまったく意味不明のままだ。"

#. Occurrence 7_5:1105:9532: scene=7_5
#: 7_5:1105
msgctxt "text_id=9532 | speaker=unknown"
msgid "  In any case, one thing was certain-he needed to start studying for tomorrow."
msgstr "　それはそれとして、明日にそなえて復習をしなくてはいけない事だけはハッキリしていた。"

#. Occurrence 7_5:1110:9533: scene=7_5
#: 7_5:1110
msgctxt "text_id=9533 | speaker=unknown"
msgid "  Thanks to Aoko's instruction, today's exams went well enough, but tomorrow's would be an even more formidable challenge."
msgstr "　青子のおかげで今日のテストは幾分ましになったけれど、明日の科目はさらに難敵だ。"

#. Occurrence 7_5:1115:9534: scene=7_5
#: 7_5:1115
msgctxt "text_id=9534 | speaker=unknown"
msgid "  After how angry she was this morning, he could not expect her to help him again tonight."
msgstr "　今朝から怒っている彼女が今夜も手伝ってくれるとは思えない。"

#. Occurrence 7_5:1143:9535: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0006; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:1143
msgctxt "text_id=9535 | speaker=soujuurou"
msgid "\"Which means I'll probably do poorly, and then she'll get mad at me again. Not that my grades have anything to do with her in the first place.\""
msgstr "「そのくせ点数悪いと怒るし。別に、蒼崎が怒る筋合いじゃないと思う」"

#. Occurrence 7_5:1150:9536: scene=7_5
#: 7_5:1150
msgctxt "text_id=9536 | speaker=unknown"
msgid "  He complained under his breath as he cracked open his textbook."
msgstr "　文句を言いつつ教科書を開く。"

#. Occurrence 7_5:1168:9537: scene=7_5
#: 7_5:1168
msgctxt "text_id=9537 | speaker=unknown"
msgid "  Apparently, he intended to spend his time in this fashion until Alice finally awoke."
msgstr "　有珠の目が覚めるまで、そうやって待つつもりらしい。"

#. Occurrence 7_5:1188:9538: scene=7_5
#: 7_5:1188
msgctxt "text_id=9538 | speaker=unknown"
msgid "  The sound of the pages turning was the only audible noise in the grand hall."
msgstr "　ホールにはページをめくる音だけが響いていく。"

#. Occurrence 7_5:1193:9539: scene=7_5
#: 7_5:1193
msgctxt "text_id=9539 | speaker=unknown"
msgid "  There was no ticking of clocks, or rustling of leaves to disturb her sleep."
msgstr "　時計の針も、森のざわめきも届かない<午睡|ごすい>。"

#. Occurrence 7_5:1199:9540: scene=7_5
#: 7_5:1199
msgctxt "text_id=9540 | speaker=unknown"
msgid "  After a few hours Soujyuro quietly rose to his feet."
msgstr "　……数時間が経って、草十郎は静かに立ち上がった。"

#. Occurrence 7_5:1204:9541: scene=7_5
#: 7_5:1204
msgctxt "text_id=9541 | speaker=unknown"
msgid "  The light that filled the foyer was beginning to turn from white to red."
msgstr "　ロビーに差しこむ日射しは、白から赤に変わりつつある。"

#. Occurrence 7_5:1225:9542: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0007; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:1225
msgctxt "text_id=9542 | speaker=soujuurou"
msgid "\"Time to go to work.\""
msgstr "「そろそろバイトの時間か」"

#. Occurrence 7_5:1244:9543: scene=7_5
#: 7_5:1244
msgctxt "text_id=9543 | speaker=unknown"
msgid "  He glanced again at Alice as he stretched his stiff back."
msgstr "　固まった背筋を伸ばして、草十郎はちらりと有珠を見た。"

#. Occurrence 7_5:1249:9544: scene=7_5
#: 7_5:1249
msgctxt "text_id=9544 | speaker=unknown"
msgid "  She slept in perfect stillness just as she had this entire time."
msgstr "　眠りは変わらず穏やかだ。"

#. Occurrence 7_5:1255:9545: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0008; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:1255
msgctxt "text_id=9545 | speaker=soujuurou"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 7_5:1260:9546: scene=7_5
#: 7_5:1260
msgctxt "text_id=9546 | speaker=unknown"
msgid "  Soujyuro arched his brow in speculation."
msgstr "　む、と草十郎は真剣に眉をよせる。"

#. Occurrence 7_5:1265:9547: scene=7_5
#: 7_5:1265
msgctxt "text_id=9547 | speaker=unknown"
msgid "  He had no idea what her normal sleeping schedule was like, so he had no idea as to whether he should wake her."
msgstr "　このまま寝かせておいていいのか、有珠の日常を知らない彼には悩みどころだ。"

#. Occurrence 7_5:1286:9548: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0009; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:1286
msgctxt "text_id=9548 | speaker=soujuurou"
msgid "\"...Never mind. Aozaki will be home soon anyway. She'll be fine.\""
msgstr "「……いや。蒼崎も帰ってくるだろうし、いらぬ世話かな」"

#. Occurrence 7_5:1304:9549: scene=7_5
#: 7_5:1304
msgctxt "text_id=9549 | speaker=unknown"
msgid "  As if reaching the end of a long train of thought, Soujyuro gave a quick nod of his head and took his leave of the mansion."
msgstr "　いかなる思考が生み出した結論か、草十郎はひとり頷いて洋館を後にした。"

#. Occurrence 7_5:1320:9550: scene=7_5
#: 7_5:1320
msgctxt "text_id=9550 | speaker=unknown"
msgid "  Today, work was a shift at the Chinese restaurant in Misaki's shopping district, The Mad Bear."
msgstr "　今日のバイト先は三咲町商店街にある、中華飯店まっどべあである。"

#. Occurrence 7_6:69:9551: scene=7_6
#: 7_6:69
msgctxt "text_id=9551 | speaker=unknown"
msgid "  Their uniforms had been made by someone with an obvious preference for garish colors."
msgstr "　その制服は、輝かんばかりの色彩センスで作られていた。"

#. Occurrence 7_6:74:9552: scene=7_6
#: 7_6:74
msgctxt "text_id=9552 | speaker=unknown"
msgid "  The orange apron was emblazoned with a cartoonish polar bear slashing a wok in two with its powerful claws."
msgstr "　オレンジ一色のエプロンにはデフォルメされた白熊が一頭、その強靱な爪で中華鍋を<爆砕|ばくさい>している。"

#. Occurrence 7_6:79:9553: scene=7_6
#: 7_6:79
msgctxt "text_id=9553 | speaker=unknown"
msgid "  The design resembled warning signs about wild animals seen in the mountains and stood out in Misaki for its one-of-a-kind originality."
msgstr "　三咲町周辺では他の追随を許さないほど独創的な、山岳地帯の標識と見まがうデザインだ。"

#. Occurrence 7_6:115:9554: scene=7_6
#: 7_6:115
msgctxt "text_id=9554 | speaker=unknown"
msgid "  This was the Chinese restaurant The Mad Bear."
msgstr "　ここは中華飯店まっどべあ。"

#. Occurrence 7_6:120:9555: scene=7_6
#: 7_6:120
msgctxt "text_id=9555 | speaker=unknown"
msgid "  Aside from its name and logo, the restaurant was the type of cheap, hole-in-the-wall dive that could be found anywhere."
msgstr "　地域密着型の、名前とロゴ以外はどこにでもある大衆食堂。"

#. Occurrence 7_6:125:9556: scene=7_6
#: 7_6:125
msgctxt "text_id=9556 | speaker=unknown"
msgid "  It faced competition from the ever-increasing number of chain restaurants, though it had managed to last longer than other dining spots, having received rave reviews on a regular basis."
msgstr "　近年増えはじめているファミリーレストランに押されはじめているものの、食事処として日々絶賛営業中の老舗である。"

#. Occurrence 7_6:145:9557: scene=7_6
#: 7_6:145
msgctxt "text_id=9557 | speaker=unknown"
msgid "  The Mad Bear prioritized the personal touch, focusing on its local clientèle, and thus made a point to offer home delivery."
msgstr "　近隣住民との触れ合いを大切にする彼らは、サービスの一環として出張配達も行っていた。"

#. Occurrence 7_6:150:9558: scene=7_6
#: 7_6:150
msgctxt "text_id=9558 | speaker=unknown"
msgid "  It had earned the affectionate moniker QKS, the Quick Killer Stop."
msgstr "　人呼んで『<Ｑ|クイック>　<Ｋ|キラー>　<Ｓ|サービス>　・森のクマさん』。"

#. Occurrence 7_6:155:9559: scene=7_6
#: 7_6:155
msgctxt "text_id=9559 | speaker=unknown"
msgid "  Making these deliveries was Soujyuro's responsibility for the time being."
msgstr "　現在、草十郎のおもな仕事はその出前役である。"

#. Occurrence 7_6:160:9560: scene=7_6
#: 7_6:160
msgctxt "text_id=9560 | speaker=unknown"
msgid "  Places in Misaki within cycling distance fell under his domain. Anything beyond that was handled by a more experienced staff member on the legendary 50cc King Salmon motorbike, but anyway..."
msgstr "　自転車で宅配が可能な三咲丘周辺は彼の受け持ちで、出前先が遠くなると先輩方の愛車・万能50ccキングサーモン号の出番となるがどうでもいい。"

#. Occurrence 7_6:193:9561: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_6_0000; voice_prefix=B50; voice_category=6; scene=7_6
#: 7_6:193
msgctxt "text_id=9561 | speaker=kinomi"
msgid "\"You'll never guess what a buddy in Yashirogi told me...\""
msgstr "「<社木|やしろぎ>のダチから聞いたんだけどな」"

#. Occurrence 7_6:199:9562: scene=7_6
#: 7_6:199
msgctxt "text_id=9562 | speaker=unknown"
msgid "  When delivery workers were not out on deliveries they spent their shift busing tables or washing dishes."
msgstr "　出前待機中の配達人は、暇さえあればウェイターと洗い物を一身に引き受ける。"

#. Occurrence 7_6:204:9563: scene=7_6
#: 7_6:204
msgctxt "text_id=9563 | speaker=unknown"
msgid "  The dinner rush was yet to come, and Soujyuro and his fellow delivery boys were shooting the breeze while washing dishes in the back."
msgstr "　今日はまだ夕飯時になっていないので、宅配専門の彼らは厨房で仲良く皿洗いをしていた。"

#. Occurrence 7_6:236:9564: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_6_0001; voice_prefix=B50; voice_category=6; scene=7_6
#: 7_6:236
msgctxt "text_id=9564 | speaker=kinomi"
msgid "\"Yo, Sizuki!\""
msgstr "「聞いてるか、静希」"

#. Occurrence 7_6:242:9565: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0000; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:242
msgctxt "text_id=9565 | speaker=soujuurou"
msgid "\"I'm listening, Kinomi, I'm listening.\""
msgstr "「聞いてるよ、木乃美」"

#. Occurrence 7_6:248:9566: scene=7_6
#: 7_6:248
msgctxt "text_id=9566 | speaker=unknown"
msgid "  The two were elbow deep in a giant sink as they enthusiastically scrubbed. At least, that was what they pretended to do while they gossiped."
msgstr "　学生バイトである彼らは大きな流し台に両手をつっこんだまま、熱心に仕事をしている……フリをしながら話しこんでいる。"

#. Occurrence 7_6:274:9567: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_6_0002; voice_prefix=B50; voice_category=6; scene=7_6
#: 7_6:274
msgctxt "text_id=9567 | speaker=kinomi"
msgid "\"He said it's not just that Japanese place, you know, Keniya? He heard Imperial Metropolis and Messiaen here in Misaki got orders, too!"
msgstr "「和食のケニヤだけじゃねえんだってよ。三咲町の<大帝都|だいていと>にもメシアンにもその手の注文があったらしいぜ。"

#. Occurrence 7_6:280:9568: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_6_0003; voice_prefix=B50; voice_category=6; scene=7_6
#: 7_6:280
msgctxt "text_id=9568 | speaker=kinomi"
msgid "  I mean, if you want that much meat just go to Shitaichi! Man! Who the heck orders raw meat and an entire salmon?"
msgstr "　そんなに肉がほしいなら<下市|したいち>に行けばいいのにな。なんだって、生肉だの大物の鮭まるごとだのを出前させやがるのか。"

#. Occurrence 7_6:291:9569: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_6_0004; voice_prefix=B50; voice_category=6; scene=7_6
#: 7_6:291
msgctxt "text_id=9569 | speaker=kinomi"
msgid "  I tell ya, there's some weird shit going on at that place, for real. Maybe they have a pet alligator or something!\""
msgstr "　どうよ。こう、露骨にやばそうな話じゃねえ？　ワニとかアザラシでも飼ってるんじゃねえかな、そいつ」"

#. Occurrence 7_6:312:9570: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0001; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:312
msgctxt "text_id=9570 | speaker=soujuurou"
msgid "\"I've definitely never heard of an order like that before. What's an 'alligator'?\""
msgstr "「他に比べてみると、たしかに珍しい話だと思う。ところで木乃美、ワニってなんだ？」"

#. Occurrence 7_6:335:9571: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_6_0005; voice_prefix=B50; voice_category=6; scene=7_6
#: 7_6:335
msgctxt "text_id=9571 | speaker=kinomi"
msgid "\"An alligator's an alligator, dude. You've really never seen one? I mean, I've never actually seen one in real life, either, but even I know what an alligator is."
msgstr "「ワニはワニだろー。だっせぇ、実物見たコトないのかよー。まあオレもねえけどな。"

#. Occurrence 7_6:346:9572: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_6_0006; voice_prefix=B50; voice_category=6; scene=7_6
#: 7_6:346
msgctxt "text_id=9572 | speaker=kinomi"
msgid "  You know what? I'll lend you my tape of 'The World's Most Terrifying Animals' episode on Africa.\""
msgstr "　んー、今度がくがく動物ランドのアフリカ特集ビデオを貸してやるから、見とけよ」"

#. Occurrence 7_6:351:9573: scene=7_6
#: 7_6:351
msgctxt "text_id=9573 | speaker=unknown"
msgid "  This was a familiar pattern of conversation between the two, especially now Kinomi was used to Soujyuro's lack of general knowledge."
msgstr "　木乃美も慣れたもので、草十郎への対応が板に付いてきている。"

#. Occurrence 7_6:387:9574: scene=7_6
#: 7_6:387
msgctxt "text_id=9574 | speaker=unknown"
msgid "  Their banter was interrupted by the delivery phone. The manager snapped up the receiver and quickly jotted down the order and address."
msgstr "　そんなとりとめのない会話をしていると、出前の注文を告げる電話が鳴った。マネージャーが素早く受話器を取り、注文と住所を確認する。"

#. Occurrence 7_6:392:9575: scene=7_6
#: 7_6:392
msgctxt "text_id=9575 | speaker=unknown"
msgid "  Once he hung up, everyone in the kitchen did their best to avoid making eye contact with him."
msgstr "　受話器が置かれると、厨房に集まっている宅配者たちはみんなそっぽを向いた。"

#. Occurrence 7_6:397:9576: scene=7_6
#: 7_6:397
msgctxt "text_id=9576 | speaker=unknown"
msgid "  Nobody wanted to go rushing out for a delivery on such a cold day."
msgstr "　この寒空の中、風をきって出前に行くのは誰だって嫌なものだ。"

#. Occurrence 7_6:420:9577: voice_id=D20_7_6_0000; voice_prefix=D20; voice_category=0; scene=7_6
#: 7_6:420
msgctxt "text_id=9577 | speaker=unknown"
msgid "\"Sizuki. This one's a little far away, but I want you to handle it.\""
msgstr "「静希くん。ちょっと遠いけど、配達お願い」"

#. Occurrence 7_6:426:9578: scene=7_6
#: 7_6:426
msgctxt "text_id=9578 | speaker=unknown"
msgid "  The manager singled Soujyuro out for the task, seemingly unfazed by his staff's laziness."
msgstr "　そんな根性無しのアルバイターたちに失望する様子もなく、マネージャーは草十郎へ声をかけた。"

#. Occurrence 7_6:447:9579: voice_id=D20_7_6_0001; voice_prefix=D20; voice_category=0; scene=7_6
#: 7_6:447
msgctxt "text_id=9579 | speaker=unknown"
msgid "\"Here's the order, and it's an unusual one, so keep it to yourself, okay?\""
msgstr "「はいこれ、届けるもののリスト。異例だからあまり他のバイトには他言しないようにね」"

#. Occurrence 7_6:453:9580: scene=7_6
#: 7_6:453
msgctxt "text_id=9580 | speaker=unknown"
msgid "  The manager tore the sheet with the order and address written on it from his memo pad."
msgstr "　マネージャーの手には注文と住所を書き留めたメモ用紙が一枚。"

#. Occurrence 7_6:458:9581: scene=7_6
#: 7_6:458
msgctxt "text_id=9581 | speaker=unknown"
msgid "  Soujyuro took one look at it before a grimace quietly spread across his face."
msgstr "　それを受け取って、草十郎は静かに顔をしかめた。"

#. Occurrence 7_6:487:9582: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0002; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:487
msgctxt "text_id=9582 | speaker=soujuurou"
msgid "\"Uh, boss?\""
msgstr "「マネージャー」"

#. Occurrence 7_6:493:9583: voice_id=D20_7_6_0002; voice_prefix=D20; voice_category=0; scene=7_6
#: 7_6:493
msgctxt "text_id=9583 | speaker=unknown"
msgid "\"Yeah?\""
msgstr "「なんだい？」"

#. Occurrence 7_6:498:9584: scene=7_6
#: 7_6:498
msgctxt "text_id=9584 | speaker=unknown"
msgid "  The manager stared right back at him as if he could tell what it was he wanted to say."
msgstr "　言いたい事は分かっている、とばかりにマネージャーは草十郎を見つめ返す。"

#. Occurrence 7_6:519:9585: voice_id=D20_7_6_0003; voice_prefix=D20; voice_category=0; scene=7_6
#: 7_6:519
msgctxt "text_id=9585 | speaker=unknown"
msgid "\"Look, I know what you're thinking. But I've been in this business a long time, and this is far from the strangest thing I've seen. It's no big deal."
msgstr "「君の疑問はもっともだ。しかし、まあ、長いことこの商売をやっていると、時にはこんな馬鹿な話が転がってくる事もある。そうおかしなコトじゃない。"

#. Occurrence 7_6:525:9586: voice_id=D20_7_6_0004; voice_prefix=D20; voice_category=0; scene=7_6
#: 7_6:525
msgctxt "text_id=9586 | speaker=unknown"
msgid "  Now help me get the stuff from cold storage.\""
msgstr "　じゃ、冷蔵庫から品物持ってくるから」"

#. Occurrence 7_6:530:9587: scene=7_6
#: 7_6:530
msgctxt "text_id=9587 | speaker=unknown"
msgid "  Soujyuro stared in admiration as the manager, dressed in black, marched out of the kitchen in his all-business way."
msgstr "　ごく自然に厨房を後にする黒服のマネージャーの姿を、なるほど、と感心して草十郎は眺めた。"

#. Occurrence 7_6:535:9588: scene=7_6
#: 7_6:535
msgctxt "text_id=9588 | speaker=unknown"
msgid "  Nowhere was free from the odd occurrence now and then."
msgstr "　どんな所でも、おかしな話はあるものらしい。"

#. Occurrence 7_6:624:9589: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0000; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:624
msgctxt "text_id=9589 | speaker=aoko"
msgid "\"You're late!\""
msgstr "「遅いっ！」"

#. Occurrence 7_6:652:9590: scene=7_6
#: 7_6:652
msgctxt "text_id=9590 | speaker=unknown"
msgid "  It was after ten at night."
msgstr "　午後十時過ぎ。"

#. Occurrence 7_6:657:9591: scene=7_6
#: 7_6:657
msgctxt "text_id=9591 | speaker=unknown"
msgid "  Soujyuro had taken a small detour on his way home from work, and now faced an outraged Aoko, as expected."
msgstr "　アルバイトを終え、ちょっとした寄り道をしてきた草十郎を迎えたのは、ごらんの通り、<怒|いか>れる蒼崎青子だった。"

#. Occurrence 7_6:691:9592: scene=7_6
#: 7_6:691
msgctxt "text_id=9592 | speaker=unknown"
msgid "  Seeing her so visibly irritated made him feel a rush of relief."
msgstr "　目に見えて不機嫌そうな彼女を見て、草十郎はホッと胸をなで下ろす。"

#. Occurrence 7_6:696:9593: scene=7_6
#: 7_6:696
msgctxt "text_id=9593 | speaker=unknown"
msgid "  He did not know why she was angry, but he could tell it was a different type of anger than what he saw earlier that morning."
msgstr "　青子がなぜ怒っているのか不明だが、今朝の分かりづらい怒りとは別種のものだったからだ。"

#. Occurrence 7_6:722:9594: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0003; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:722
msgctxt "text_id=9594 | speaker=soujuurou"
msgid "\"Really? But it's only a little after ten."
msgstr "「遅いって、まだ十時になったばかりだろう。"

#. Occurrence 7_6:722:9595: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0003; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:722
msgctxt "text_id=9595 | speaker=soujuurou"
msgid "  Did something happen, Aozaki?\""
msgstr "　どうしたんだ、蒼崎」"

#. Occurrence 7_6:744:9596: scene=7_6
#: 7_6:744
msgctxt "text_id=9596 | speaker=unknown"
msgid "  He set down the cardboard box he had been carrying in his arms and glanced toward the fireplace."
msgstr "　両手に抱えたダンボールを床に下ろしながら、草十郎は暖炉のあたりに視線を向ける。"

#. Occurrence 7_6:749:9597: scene=7_6
#: 7_6:749
msgctxt "text_id=9597 | speaker=unknown"
msgid "  The sleeping girl was there no more."
msgstr "　ひとり眠っていた少女の姿はない。"

#. Occurrence 7_6:783:9598: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0001; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:783
msgctxt "text_id=9598 | speaker=aoko"
msgid "\"It's not 'only a little after' ten... You arrived after curfew!"
msgstr "「違うわ。もう十時になった、の間違いでしょ。"

#. Occurrence 7_6:789:9599: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0002; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:789
msgctxt "text_id=9599 | speaker=aoko"
msgid "  You've got no clue why I'm angry, do you?\""
msgstr "　アンタってほんと、自分がどんな状態にあるか分かってないのね」"

#. Occurrence 7_6:807:9600: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0004; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:807
msgctxt "text_id=9600 | speaker=soujuurou"
msgid "\"?\""
msgstr "「？」"

#. Occurrence 7_6:813:9601: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0003; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:813
msgctxt "text_id=9601 | speaker=aoko"
msgid "\"Just come with me to the drawing room.\""
msgstr "「いいから、居間に来て」"

#. Occurrence 7_6:849:9602: scene=7_6
#: 7_6:849
msgctxt "text_id=9602 | speaker=unknown"
msgid "  She walked briskly to the other room without pausing, leaving Soujyuro standing in confusion, head tilted to one side."
msgstr "　首を傾げる草十郎をよそに、青子はスタスタと居間へと歩いて行く。"

#. Occurrence 7_6:854:9603: scene=7_6
#: 7_6:854
msgctxt "text_id=9603 | speaker=unknown"
msgid "  He proceeded to pick his box back up and follow after her eagerly."
msgstr "　ダンボール箱を抱え直し、草十郎もいそいそと後に続く。"

#. Occurrence 7_6:901:9604: scene=7_6
#: 7_6:901
msgctxt "text_id=9604 | speaker=unknown"
msgid "  He removed his coat and hung it on a hanger as he entered the living room."
msgstr "　草十郎はコートを脱いで、コートハンガーに掛けながら居間に入った。"

#. Occurrence 7_6:906:9605: scene=7_6
#: 7_6:906
msgctxt "text_id=9605 | speaker=unknown"
msgid "  Apparently today was one of those days where Alice kept herself locked away in her room."
msgstr "　有珠は自室に引きこもっているようだ。"

#. Occurrence 7_6:911:9606: scene=7_6
#: 7_6:911
msgctxt "text_id=9606 | speaker=unknown"
msgid "  On the table were the familiar pills."
msgstr "　テーブルの上にはお馴染みの錠剤が置かれている。"

#. Occurrence 7_6:947:9607: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0004; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:947
msgctxt "text_id=9607 | speaker=aoko"
msgid "\"It's partly my fault for not being more clear about this, but you need to come home on time. Your curfew exists for a reason.\""
msgstr "「……説明しなかった私も悪いけど、貴方も帰ってくる時間は守ってよね。こっちはそのつもりで作ってるんだから」"

#. Occurrence 7_6:959:9608: scene=7_6
#: 7_6:959
msgctxt "text_id=9608 | speaker=unknown"
msgid "  Aoko handed him the pills and a glass of water with an expectant look on her face."
msgstr "　はい、とテーブル上の錠剤と、水の入ったコップを差しだす青子。"

#. Occurrence 7_6:992:9609: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0005; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:992
msgctxt "text_id=9609 | speaker=soujuurou"
msgid "\"But I already took the pills before I went out."
msgstr "「？　薬なら出かける前に飲んだけど。"

#. Occurrence 7_6:992:9610: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0005; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:992
msgctxt "text_id=9610 | speaker=soujuurou"
msgid "  And I feel fine, anyway. I don't think I need any more pills today.\""
msgstr "　体の調子だって悪くないし、そんなにあわてるコトか？」"

#. Occurrence 7_6:1011:9611: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0005; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1011
msgctxt "text_id=9611 | speaker=aoko"
msgid "\"Excuse me? You think this has anything to do with how you feel?\""
msgstr "「は？　なんだって私たちがアンタの健康気にかけなくちゃいけないのよ」"

#. Occurrence 7_6:1058:9612: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0006; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1058
msgctxt "text_id=9612 | speaker=aoko"
msgid "\"Let's get real. These pills that you take every day when you come home... They're poison."
msgstr "「勘違いしてるようだけど、アンタが帰ってくる度に飲んでるのって、平たく言えば毒よ？"

#. Occurrence 7_6:1064:9613: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0007; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1064
msgctxt "text_id=9613 | speaker=aoko"
msgid "  Slow-acting poison, mind, and they take half a day to kick in. If you don't take more pills before that happens, the older poison will kill you."
msgstr "　速効性じゃないから効き目は半日すると出てくるんだけど、その前に新しい<錠剤|どくやく>を飲んでおかないと、古い毒が体に回ってばったり逝くって寸法ね。"

#. Occurrence 7_6:1102:9614: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0008; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1102
msgctxt "text_id=9614 | speaker=aoko"
msgid "  This is how much rope Alice is willing to give you.\""
msgstr "　有珠のヤツ、これぐらいしないと信用できないって言い張ったのよ」"

#. Occurrence 7_6:1142:9615: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0009; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1142
msgctxt "text_id=9615 | speaker=aoko"
msgid "\"Get it? So drink up."
msgstr "「ほら、分かったらさっさと飲む。"

#. Occurrence 7_6:1155:9616: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0010; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1155
msgctxt "text_id=9616 | speaker=aoko"
msgid "  I'm enjoying this just about as much as you are."
msgstr "　……ま、私もこれ、面倒だと思うし。"

#. Occurrence 7_6:1161:9617: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0011; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1161
msgctxt "text_id=9617 | speaker=aoko"
msgid "  And until I think of a way around this, you're going to have to deal with it.\""
msgstr "　近いうちもっと形のある方法を考えてみるから、それまでこの方法で我慢して」"

#. Occurrence 7_6:1209:9618: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0006; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1209
msgctxt "text_id=9618 | speaker=soujuurou"
msgid "\"...Maybe I misheard you for a second. Did you say that these pills I've been taking this whole time are actually bad for me?\""
msgstr "「……言ってる事は支離滅裂だが、とにかく今までよくない物を飲んでたんだな？」"

#. Occurrence 7_6:1249:9619: scene=7_6
#: 7_6:1249
msgctxt "text_id=9619 | speaker=unknown"
msgid "  Soujyuro took the pills from her and gulped it down."
msgstr "　青子から錠剤を受け取って、草十郎は一口で飲みこんだ。"

#. Occurrence 7_6:1274:9620: scene=7_6
#: 7_6:1274
msgctxt "text_id=9620 | speaker=unknown"
msgid "  The fact that it was poison gave him no pause at all."
msgstr "　毒物だと聞いて<怯|ひる>んだ素振りもない。"

#. Occurrence 7_6:1279:9621: scene=7_6
#: 7_6:1279
msgctxt "text_id=9621 | speaker=unknown"
msgid "  And as for his roommates' tyrannical behavior, he showed no signs of standing up to it."
msgstr "　どうも、青子たちの横暴を非難する気はないらしい。"

#. Occurrence 7_6:1318:9622: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0007; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1318
msgctxt "text_id=9622 | speaker=soujuurou"
msgid "\"Using poison to cancel poison... You two are really taking the old-fashioned approach, huh?\""
msgstr "「まったく。毒をもって毒を制するなんて、また古風な真似するな、蒼崎も有珠も」"

#. Occurrence 7_6:1324:9623: scene=7_6
#: 7_6:1324
msgctxt "text_id=9623 | speaker=unknown"
msgid "  Soujyuro's face relaxed into a smile upon finding the funny side of the situation."
msgstr "　笑いのツボに入ったらしく、草十郎は頬を<緩|ゆる>ませる。"

#. Occurrence 7_6:1344:9624: scene=7_6
#: 7_6:1344
msgctxt "text_id=9624 | speaker=unknown"
msgid "  Aoko was utterly dumbfounded as to how he could be happy at a time like this."
msgstr "　一方、青子的には、どうしてそこで笑うのかまったくもって理解不能なのだった。"

#. Occurrence 7_6:1373:9625: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0008; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1373
msgctxt "text_id=9625 | speaker=soujuurou"
msgid "\"I was running late on the way home because I dropped by my old apartment to get all my stuff. You could've tried calling me if it was such a big deal, you know.\""
msgstr "「今日帰りが遅れたのは、アパートまで荷物を取りにいっていたからなんだ。そういうコトなら、電話のひとつでもすればよかった」"

#. Occurrence 7_6:1385:9626: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0012; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1385
msgctxt "text_id=9626 | speaker=aoko"
msgid "\"Your stuff? Wait...is that everything?\""
msgstr "「……荷物って、まさかそれじゃないでしょうね」"

#. Occurrence 7_6:1391:9627: scene=7_6
#: 7_6:1391
msgctxt "text_id=9627 | speaker=unknown"
msgid "  Soujyuro nodded emphatically as she pointed incredulously at the cardboard box in his hands."
msgstr "　持ってきたダンボール箱を指差され、草十郎はもちろん、と頷く。"

#. Occurrence 7_6:1426:9628: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0009; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1426
msgctxt "text_id=9628 | speaker=soujuurou"
msgid "\"It's stupid to pay rent when I don't even live there, so I thought I should move everything out. But I arranged it so I can go back any time within the next three months.\""
msgstr "「住んでいないのに家賃を払うのは馬鹿らしいから、今日で引き上げてきた。いちおう、いつでも戻れるように話はつけてあるから、三ヶ月ぐらいは大丈夫だよ」"

#. Occurrence 7_6:1445:9629: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0013; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1445
msgctxt "text_id=9629 | speaker=aoko"
msgid "\"Rent...?"
msgstr "「家賃……？"

#. Occurrence 7_6:1475:9630: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0014_0; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1475
msgctxt "text_id=9630 | speaker=aoko"
msgid "  Oh, right."
msgstr "　あ、そっか。そうよね、"

#. Occurrence 7_6:1488:9631: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0014_1; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1488
msgctxt "text_id=9631 | speaker=aoko"
msgid " How could I forget? I'm sure Alice will be thrilled to hear about this.\""
msgstr "私ってばなんでそんな事を忘れてたんだろう。有珠が聞いたら喜ぶわ、そりゃ」"

#. Occurrence 7_6:1513:9632: scene=7_6
#: 7_6:1513
msgctxt "text_id=9632 | speaker=unknown"
msgid "  A smile blossomed across her face, as they say."
msgstr "　華のような笑顔、とはこのコトか。"

#. Occurrence 7_6:1518:9633: scene=7_6
#: 7_6:1518
msgctxt "text_id=9633 | speaker=unknown"
msgid "  It was the open, bold-faced look of a child who just came up with a mischievous plan."
msgstr "　一点の曇りもない、ズバリ、新しい<悪巧|わるだく>みを思いついた子供のような笑顔である。"

#. Occurrence 7_6:1523:9634: scene=7_6
#: 7_6:1523
msgctxt "text_id=9634 | speaker=unknown"
msgid "  Soujyuro shook with fear at the thought of what that smile might bring his way."
msgstr "　不吉なコトこの上ない、と来るべき脅威に震える草十郎だった。"

#. Occurrence 7_6:1571:9635: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0015; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1571
msgctxt "text_id=9635 | speaker=aoko"
msgid "\"You sure don't have much. That one cardboard box contains all your worldly possessions?\""
msgstr "「けど随分少ないのね、荷物。ダンボール一箱分しかないの？」"

#. Occurrence 7_6:1577:9636: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0010; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1577
msgctxt "text_id=9636 | speaker=soujuurou"
msgid "\"This is a lot to me. Is Alice upstairs?\""
msgstr "「そうかな、十分多いだろ。それより有珠は自室か？」"

#. Occurrence 7_6:1583:9637: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0016; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1583
msgctxt "text_id=9637 | speaker=aoko"
msgid "\"She just went to her room, although she stayed at the dinner table longer than usual. I guess she got tired of waiting.\""
msgstr "「ちょっと前に戻ったわ。珍しく食後もここに残ってたんだけど、待ちきれなかったみたいね」"

#. Occurrence 7_6:1600:9638: scene=7_6
#: 7_6:1600
msgctxt "text_id=9638 | speaker=unknown"
msgid "  She gave Soujyuro a meaningful look while continuing to smile that sinister smile."
msgstr "　青子は不敵な笑顔のまま、意味ありげな視線を草十郎に投げかける。"

#. Occurrence 7_6:1649:9639: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0011; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1649
msgctxt "text_id=9639 | speaker=soujuurou"
msgid "\"She got tired of waiting? For what?\""
msgstr "「待ちきれなかったって、何を」"

#. Occurrence 7_6:1689:9640: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0017; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1689
msgctxt "text_id=9640 | speaker=aoko"
msgid "\"I imagine she wanted to punish whoever decided to use the last of her Fauchon and Blue Calico.\""
msgstr "「そりゃあ、有珠が眠ってるのをいいことに在庫のないフォションとブルーキャリコを勝手に使ってくれた、どこかの誰かさんにお仕置きするためなんじゃない？」"

#. Occurrence 7_6:1734:9641: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0012; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1734
msgctxt "text_id=9641 | speaker=soujuurou"
msgid "\"Why do I know that name...? I think 'Fauchon' is that brand of tea I used.\""
msgstr "「フォション……って、あのお茶の葉？」"

#. Occurrence 7_6:1740:9642: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0018; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1740
msgctxt "text_id=9642 | speaker=aoko"
msgid "\"It sure is. To be honest even I was shocked when I first walked in. I know how she falls asleep all over the mansion, but I've never seen her prepare tea first."
msgstr "「そう。私もびっくりしたけどね。有珠がどっかで寝入るのはよくある事だけど、紅茶を用意して眠るなんてのは初めてだったから。"

#. Occurrence 7_6:1746:9643: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0019; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1746
msgctxt "text_id=9643 | speaker=aoko"
msgid "  I woke her up to see if she was okay, and she was just as surprised as I was. We couldn't imagine who would do such a thing.\""
msgstr "　どんな心境の変化か知りたくて起こしたら、有珠の方が驚いてたわ。一体、誰の仕業なんだって」"

#. Occurrence 7_6:1771:9644: scene=7_6
#: 7_6:1771
msgctxt "text_id=9644 | speaker=unknown"
msgid "  Soujyuro clapped his hands together as if remembering something important."
msgstr "　ぽん、と手を叩く草十郎。"

#. Occurrence 7_6:1782:9645: scene=7_6
#: 7_6:1782
msgctxt "text_id=9645 | speaker=unknown"
msgid "  He had forgotten to clean up the tea before leaving."
msgstr "　お茶の用意はしたけれど、<後|あと><片付|かたづ>けをした記憶はまったくない。"

#. Occurrence 7_6:1802:9646: scene=7_6
#: 7_6:1802
msgctxt "text_id=9646 | speaker=unknown"
msgid "  The regret written from forehead to chin delighted Aoko immensely."
msgstr "　まずいな、という顔をする草十郎と、そんな彼を見て楽しむ青子。"

#. Occurrence 7_6:1837:9647: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0013; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1837
msgctxt "text_id=9647 | speaker=soujuurou"
msgid "\"I see... How mad was she?\""
msgstr "「そうか……それじゃあ、有珠は怒っていただろう」"

#. Occurrence 7_6:1856:9648: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0020; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1856
msgctxt "text_id=9648 | speaker=aoko"
msgid "\"Pretty mad. Robin was all aflutter about it, too.\""
msgstr "「当然。駒鳥がとばっちりでドリブルされてたしね」"

#. Occurrence 7_6:1869:9649: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0014; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1869
msgctxt "text_id=9649 | speaker=soujuurou"
msgid "\"Well I'm mad at myself, too, if that helps. I can't believe I forget to take them back to the kitchen.\""
msgstr "「ああ、俺でも怒る。片付けをきちんとしないなんて、だらしないにもほどがある」"

#. Occurrence 7_6:1880:9650: scene=7_6
#: 7_6:1880
msgctxt "text_id=9650 | speaker=unknown"
msgid "  Soujyuro harshly scolded himself for his failure."
msgstr "　なんたる失態、と草十郎は激しく自分を責めた。"

#. Occurrence 7_6:1904:9651: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0021; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1904
msgctxt "text_id=9651 | speaker=aoko"
msgid "\"No dummy! She's mad at you because you sat and watched her sleep!\""
msgstr "「論点違うっ！　あのね、寝顔をまぢかで見られたから怒ってるのよ有珠は！」"

#. Occurrence 7_6:1989:9652: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0015; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1989
msgctxt "text_id=9652 | speaker=soujuurou"
msgid "\"Oh... I didn't think she would mind all that much.\""
msgstr "「え…………そうかな。有珠は、そういうのは気にしないと思うんだけど」"

#. Occurrence 7_6:2029:9653: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0022; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2029
msgctxt "text_id=9653 | speaker=aoko"
msgid "\"Well WE do mind when you watch us sleep, just so you know!\""
msgstr "「アンタはそうかもしれないけど、私たちは気にするの！」"

#. Occurrence 7_6:2070:9654: scene=7_6
#: 7_6:2070
msgctxt "text_id=9654 | speaker=unknown"
msgid "  Aoko's glare was enough to make glass shatter."
msgstr "　ぎりり、とガラスを裂く擬音のような目で睨む青子。"

#. Occurrence 7_6:2075:9655: scene=7_6
#: 7_6:2075
msgctxt "text_id=9655 | speaker=unknown"
msgid "  There was an indescribable intensity in the way she said that."
msgstr "　私たち、という響きに言いようのない迫力を感じる草十郎だった。"

#. Occurrence 7_6:2126:9656: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0016; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2126
msgctxt "text_id=9656 | speaker=soujuurou"
msgid "\"You mean it's a personal pet peeve for you and Alice?\""
msgstr "「それは蒼崎たち限定の話か？」"

#. Occurrence 7_6:2166:9657: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0023; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2166
msgctxt "text_id=9657 | speaker=aoko"
msgid "\"No, it's common sense! If you go around assuming that other people feel the same way as you, you're asking for trouble.\""
msgstr "「世間一般での常識よ。自分が気にしないからって他人もそうだと思ってると、いつか火傷するからね」"

#. Occurrence 7_6:2206:9658: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0017; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2206
msgctxt "text_id=9658 | speaker=soujuurou"
msgid "\"Huh. But isn't it kind of her fault for falling asleep in the foyer in the first place? It would be stranger if I saw her like that and didn't want to look out for her.\""
msgstr "「む。でもそれだったら、ロビーで寝ている有珠にだって問題ないか？　見かけたら放っておけないだろう、あんなの」"

#. Occurrence 7_6:2233:9659: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0024; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2233
msgctxt "text_id=9659 | speaker=aoko"
msgid "\"Look, I appreciate that's what you thought, but you just have to understand that that's how the lady of the house is."
msgstr "「……その心意気は立派だけど、そこはそれ、この館の持ち主は彼女だから。"

#. Occurrence 7_6:2239:9660: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0025; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2239
msgctxt "text_id=9660 | speaker=aoko"
msgid "  While you live here, responsibility for any and all mistakes or bad judgment on your part will be laid at your feet and your feet alone."
msgstr "　この洋館内で貴方が出会ったあらゆる<不義|ふぎ><不始末|ふしまつ>、<失敗|しっぱい><失|しっ><態|たい>の責任は草十郎に押しつけられるの。"

#. Occurrence 7_6:2245:9661: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0026; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2245
msgctxt "text_id=9661 | speaker=aoko"
msgid "  Do you get what I'm trying to say here?\""
msgstr "　この意味、分かる？」"

#. Occurrence 7_6:2262:9662: scene=7_6
#: 7_6:2262
msgctxt "text_id=9662 | speaker=unknown"
msgid "  Aoko's question sent Soujyuro into a trance of deep thought until finally he uttered,"
msgstr "　あんまりな青子の言葉に、草十郎はむむ、と考えこんで、"

#. Occurrence 7_6:2304:9663: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0018; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2304
msgctxt "text_id=9663 | speaker=soujuurou"
msgid "\"So in other words, I'm in Alice's kingdom now?\""
msgstr "「―――つまり、ここは有珠の自治領なんだな？」"

#. Occurrence 7_6:2316:9664: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0027; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2316
msgctxt "text_id=9664 | speaker=aoko"
msgid "\"Yes, congratulations. Although technically this kingdom belongs to both me and her."
msgstr "「はい、よくできました。正確には私と有珠のだけどね。"

#. Occurrence 7_6:2316:9665: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0027; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2316
msgctxt "text_id=9665 | speaker=aoko"
msgid "  Which means what we say goes.\""
msgstr "　領主は何をやっても許されるってコトよ」"

#. Occurrence 7_6:2363:9666: scene=7_6
#: 7_6:2363
msgctxt "text_id=9666 | speaker=unknown"
msgid "  She smiled as she spoke and plopped herself down on the sofa."
msgstr "　笑顔で言って、青子はソファーに腰を下ろした。"

#. Occurrence 7_6:2368:9667: scene=7_6
#: 7_6:2368
msgctxt "text_id=9667 | speaker=unknown"
msgid "  Soujyuro remained standing behind the sofa opposite her as he ran over their conversation again and again in his head."
msgstr "　草十郎は青子の向かいのソファーの後ろに立ったまま、今の会話を振り返っていた。"

#. Occurrence 7_6:2373:9668: scene=7_6
#: 7_6:2373
msgctxt "text_id=9668 | speaker=unknown"
msgid "  The notion of this being their kingdom made him realize he actually had no idea where the girls had come from or their families' background."
msgstr "　有珠の自治領、青子の自治領と言うが、そもそも彼女の家族、実家はどうなっているのか。"

#. Occurrence 7_6:2409:9669: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0019; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2409
msgctxt "text_id=9669 | speaker=soujuurou"
msgid "\"Where are your parents, Aozaki?\""
msgstr "「蒼崎。君、ご両親はどうしてるんだ？」"

#. Occurrence 7_6:2414:9670: scene=7_6
#: 7_6:2414
msgctxt "text_id=9670 | speaker=unknown"
msgid "  He inadvertently blurted out, this being the question foremost on his mind."
msgstr "　草十郎はつい、思いついた疑問を口にする。"

#. Occurrence 7_6:2435:9671: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0028; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2435
msgctxt "text_id=9671 | speaker=aoko"
msgid "\"They're alive and well. They own a place in Toukawa, four stops from Misaki. I learned everything I know from my grandfather, who's retired now and lives with them.\""
msgstr "「生きてるわよ。三咲町から下りに四駅いった<陶川|とうかわ>ってところの地主。師は祖父だけど、今は隠居して両親と一緒の土地に住んでるわ」"

#. Occurrence 7_6:2468:9672: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0020; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2468
msgctxt "text_id=9672 | speaker=soujuurou"
msgid "\"Huh. Sounds like a pretty normal family.\""
msgstr "「……む。そう聞くと、なんだか普通の家庭だな」"

#. Occurrence 7_6:2473:9673: scene=7_6
#: 7_6:2473
msgctxt "text_id=9673 | speaker=unknown"
msgid "  Soujyuro had imagined something more outrageous for a family of magicians."
msgstr "　魔法使いの一族というから、草十郎はもっと破天荒なものを想像していたらしい。"

#. Occurrence 7_6:2494:9674: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0029; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2494
msgctxt "text_id=9674 | speaker=aoko"
msgid "\"Sure, as far as my parents go. My father sucked as a mage. My grandfather says it skipped a generation so I get double the power, but I'm not so sure about that."
msgstr "「両親はね。父さんにはあんまり魔術回路は作られなかったみたいだから。その分、私には二世代分の潜在能力があるって祖父は言ってるけど、どうだか。"

#. Occurrence 7_6:2510:9675: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0030; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2510
msgctxt "text_id=9675 | speaker=aoko"
msgid "  I think Alice has more the type of family you're imagining. She's from England, you know.\""
msgstr "　草十郎の期待してるような一族は、どっちかって言うと有珠のほうよ。私と違って英国出身だからね、彼女」"

#. Occurrence 7_6:2522:9676: scene=7_6
#: 7_6:2522
msgctxt "text_id=9676 | speaker=unknown"
msgid "  Aoko offered nothing more, as if to suggest that was as far as she was willing to reveal for now."
msgstr "　そこまで口にして、いけない、と青子は会話を止めた。"

#. Occurrence 7_6:2527:9677: scene=7_6
#: 7_6:2527
msgctxt "text_id=9677 | speaker=unknown"
msgid "  Soujyuro had insisted on talking to Alice directly rather than hearing things secondhand, so chose not to go back on his word by pushing the topic further."
msgstr "　有珠の事は本人から訊く―――目の前の少年はそう言った。その方針を、こんなところで台無しにする訳にはいかない。"

#. Occurrence 7_6:2555:9678: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0031; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2555
msgctxt "text_id=9678 | speaker=aoko"
msgid "\"Ask her if you want to know more. Now you know why she loves English blends of tea so much."
msgstr "「ま、詳しくは本人から訊きなさい。有珠の紅茶好きもそこからきてるんだし。"

#. Occurrence 7_6:2579:9679: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0032; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2579
msgctxt "text_id=9679 | speaker=aoko"
msgid "  ...Speaking of which, why did you use tea leaves today of all days? You should've stuck to the tea bags.\""
msgstr "　……そう言えば、なんで今日にかぎってリーフティーなんか淹れたの？　ティーバッグを使ったほうがまだマシだったでしょうに」"

#. Occurrence 7_6:2606:9680: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0021; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2606
msgctxt "text_id=9680 | speaker=soujuurou"
msgid "\"But you said the leaves taste better."
msgstr "「蒼崎が、そっちの方がいいって言ったじゃないか。"

#. Occurrence 7_6:2606:9681: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0021; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2606
msgctxt "text_id=9681 | speaker=soujuurou"
msgid "  And also that Alice is picky about her tea.\""
msgstr "　有珠は紅茶にうるさいって」"

#. Occurrence 7_6:2630:9682: scene=7_6
#: 7_6:2630
msgctxt "text_id=9682 | speaker=unknown"
msgid "  Aoko was momentarily at a loss for words."
msgstr "　むう、と自らの失言に青子は言いよどむ。"

#. Occurrence 7_6:2635:9683: scene=7_6
#: 7_6:2635
msgctxt "text_id=9683 | speaker=unknown"
msgid "  He seemed so oblivious most of the time, but apparently he was attentive to some details, at least selectively."
msgstr "　大雑把に見えて細かい事を覚えているヤツめ、と。"

#. Occurrence 7_6:2662:9684: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0033; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2662
msgctxt "text_id=9684 | speaker=aoko"
msgid "\"Just forget it. Anyway, think you can make it home by yourself tomorrow?"
msgstr "「……ま、いいわ。それより明日の放課後だけど、またひとりで帰ってくれない？"

#. Occurrence 7_6:2668:9685: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0034; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2668
msgctxt "text_id=9685 | speaker=aoko"
msgid "  They accepted my proposal for a mochi-making festival in the new year, so I'll be pretty busy with that.\""
msgstr "　年明けの行事があるんだけど、その場しのぎで言った<餅|もち>つき大会が通っちゃってさ。明日も忙しいのよ、私」"

#. Occurrence 7_6:2691:9686: scene=7_6
#: 7_6:2691
msgctxt "text_id=9686 | speaker=unknown"
msgid "  Soujyuro nodded in acceptance."
msgstr "　了解、と頷く草十郎。"

#. Occurrence 7_6:2696:9687: scene=7_6
#: 7_6:2696
msgctxt "text_id=9687 | speaker=unknown"
msgid "  In fact he had already been planning to do so before she even asked."
msgstr "　青子に言われずともそのつもりだったらしい。"

#. Occurrence 7_6:2724:9688: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0022; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2724
msgctxt "text_id=9688 | speaker=soujuurou"
msgid "\"I'll be fine, but what about you? You haven't even slept since yesterday.\""
msgstr "「それはいいけど、体は大丈夫か蒼崎？　昨日から寝てないだろう」"

#. Occurrence 7_6:2750:9689: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0035; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2750
msgctxt "text_id=9689 | speaker=aoko"
msgid "\"Oh, I took a quick three-hour nap earlier. I'll be fine."
msgstr "「夕方に三時間ちょい仮眠をとったから調子はいいわ。"

#. Occurrence 7_6:2756:9690: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0036; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2756
msgctxt "text_id=9690 | speaker=aoko"
msgid "  What about you for that matter? I hope you didn't forget about our session tonight.\""
msgstr "　そう言うアンタこそ体は<保|も>つんでしょうね？　もう少ししたら昨日の続き、始めるわよ」"

#. Occurrence 7_6:2793:9691: scene=7_6
#: 7_6:2793
msgctxt "text_id=9691 | speaker=unknown"
msgid "  She meant the all-night cramming session, of course."
msgstr "　昨日の続き、とはマンツーマンによる一夜漬けだ。"

#. Occurrence 7_6:2798:9692: scene=7_6
#: 7_6:2798
msgctxt "text_id=9692 | speaker=unknown"
msgid "  Needless to say, Soujyuro was more than likely to struggle given that he, too, had not slept a wink."
msgstr "　あれから一睡もしていない草十郎にとって、厳しい荒行なのは言うまでもないが―――"

#. Occurrence 7_6:2835:9693: scene=7_6
#: 7_6:2835
msgctxt "text_id=9693 | speaker=unknown"
msgid "  All he could do was give a relieved smile."
msgstr "　それ以上に、嬉しくてつい頬が緩んでしまう。"

#. Occurrence 7_6:2840:9694: scene=7_6
#: 7_6:2840
msgctxt "text_id=9694 | speaker=unknown"
msgid "  He thought back to the days just after he transferred here, when she watched his every move from the sidelines and showed a startling amount of concern for him."
msgstr "　転校当時、物陰からはらはらと自分の行動を監視していた彼女の、分かりづらい心遣いが思い出される。"

#. Occurrence 7_6:2867:9695: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0023; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2867
msgctxt "text_id=9695 | speaker=soujuurou"
msgid "\"I didn't forget. And besides, it's tougher on you than me, Aozaki."
msgstr "「いいよ。どのみち苦労するのは蒼崎の方だし。"

#. Occurrence 7_6:2867:9696: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0023; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2867
msgctxt "text_id=9696 | speaker=soujuurou"
msgid "  I'm still glad to be your exception among exceptions.\""
msgstr "　異例中の異例は、有り難く受け取っておくとしよう」"

#. Occurrence 7_6:2907:9697: scene=7_6
#: 7_6:2907
msgctxt "text_id=9697 | speaker=unknown"
msgid "  His cheery response grated on her just a little."
msgstr "　晴れ晴れとした顔で返され、青子は小さく呆れながら、"

#. Occurrence 7_6:2930:9698: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0037; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2930
msgctxt "text_id=9698 | speaker=aoko"
msgid "\"Wow. You manage to forget everything except the most irritating little details, don't you?\""
msgstr "「……ほんと。くだらない事だけは、しつこく覚えてるんだから」"

#. Occurrence 7_6:2936:9699: scene=7_6
#: 7_6:2936
msgctxt "text_id=9699 | speaker=unknown"
msgid "  She heaved her shoulders in exasperation and dropped her head as an excuse to look away from the beaming smile on his face."
msgstr "　その笑顔から視線を逸らすように、やれやれと肩をすくめるのだった。"

#. Occurrence 7_7:86:9700: scene=7_7
#: 7_7:86
msgctxt "text_id=9700 | speaker=unknown"
msgid "  The following day..."
msgstr "　翌日。"

#. Occurrence 7_7:91:9701: scene=7_7
#: 7_7:91
msgctxt "text_id=9701 | speaker=unknown"
msgid "  The last day of finals had ended without a hitch."
msgstr "　期末試験、その最終日は滞りなく終了した。"

#. Occurrence 7_7:106:9702: scene=7_7
#: 7_7:106
msgctxt "text_id=9702 | speaker=unknown"
msgid "  That final December hurdle was finally a thing of the past."
msgstr "　多くの学生たちにとって十二月最大の難問は、晴れて過去の歴史と消え去った。"

#. Occurrence 7_7:111:9703: scene=7_7
#: 7_7:111
msgctxt "text_id=9703 | speaker=unknown"
msgid "  For all but one student, that is."
msgstr "　だが。"

#. Occurrence 7_7:126:9704: scene=7_7
#: 7_7:126
msgctxt "text_id=9704 | speaker=unknown"
msgid "  To Soujyuro, the greatest challenge was yet to come."
msgstr "　草十郎にとって最大の難問は、この後にこそ控えている。"

#. Occurrence 7_7:169:9705: scene=7_7
#: 7_7:169
msgctxt "text_id=9705 | speaker=unknown"
msgid "  He bid farewell to his classmates, all jittery with excitement for the last day of term, and headed into the Shiroinuzuka woods."
msgstr "　明日の終業式に向けて浮き足立つクラスメイトたちと町中で別れを告げ、白犬塚の森の中へ。"

#. Occurrence 7_7:174:9706: scene=7_7
#: 7_7:174
msgctxt "text_id=9706 | speaker=unknown"
msgid "  The road home was no different than yesterday,"
msgstr "　昨日通りの帰宅風景、"

#. Occurrence 7_7:179:9707: scene=7_7
#: 7_7:179
msgctxt "text_id=9707 | speaker=unknown"
msgid "  like he was reliving yet another day striding up that hill."
msgstr "　昨日の焼き直しのような気分で、草十郎は坂道を登っていく。"

#. Occurrence 7_7:223:9708: scene=7_7
#: 7_7:223
msgctxt "text_id=9708 | speaker=unknown"
msgid "  Yet today, there was a fierce determination in his steps."
msgstr "　草十郎とて確固たる決意に燃えている。"

#. Occurrence 7_7:228:9709: scene=7_7
#: 7_7:228
msgctxt "text_id=9709 | speaker=unknown"
msgid "  Today was his last chance, and he wanted nothing more than to talk to the girl."
msgstr "　今日が最終期限であるし、なにより草十郎自身、あの少女の<話|こえ>を聞きたがっていた。"

#. Occurrence 7_7:233:9710: scene=7_7
#: 7_7:233
msgctxt "text_id=9710 | speaker=unknown"
msgid "  He did not care if she was cruel to him or ignored him, nor whether Aoko was being truthful when she said that she could trap him in a mirror land or something like that. All he really cared about was having the chance to speak with her face-to-face."
msgstr "　多少邪険に扱われても、とことん無視されても、果ては“怒らせると鏡の国に放りこまれるわよ”とニヤけ顔で笑う青子の忠告を実現させる事になったとしても、挨拶ぐらいはしたいのである。"

#. Occurrence 7_7:275:9711: scene=7_7
#: 7_7:275
msgctxt "text_id=9711 | speaker=unknown"
msgid "  But nothing is ever that simple."
msgstr "　―――しかし。"

#. Occurrence 7_7:281:9712: scene=7_7
#: 7_7:281
msgctxt "text_id=9712 | speaker=unknown"
msgid "  To tell the truth, what he found upon finally entering the mansion was not wholly unexpected."
msgstr "　草十郎を待ち受けていたものは、半分以上、なんとなく予感していた通りの光景だった。"

#. Occurrence 7_7:315:9713: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0000; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:315
msgctxt "text_id=9713 | speaker=soujuurou"
msgid "\"...She sure sleeps a lot.\""
msgstr "「…………よく寝る子だな、ほんと」"

#. Occurrence 7_7:350:9714: scene=7_7
#: 7_7:350
msgctxt "text_id=9714 | speaker=unknown"
msgid "  The déjà vu he was experiencing made him dizzy."
msgstr "　目眩を覚えるほどの既視感。"

#. Occurrence 7_7:355:9715: scene=7_7
#: 7_7:355
msgctxt "text_id=9715 | speaker=unknown"
msgid "  Faced with an exact reenactment of the previous day, he could not help but blurt out what he was thinking."
msgstr "　見た目だけなら昨日と何ら変わらない風景に迎えられて、草十郎は素直な感想を漏らした。"

#. Occurrence 7_7:375:9716: scene=7_7
#: 7_7:375
msgctxt "text_id=9716 | speaker=unknown"
msgid "  Alice was sleeping by the fireplace, just as she had done yesterday."
msgstr "　少女は今日も暖炉の<傍|そば>で眠っている。"

#. Occurrence 7_7:380:9717: scene=7_7
#: 7_7:380
msgctxt "text_id=9717 | speaker=unknown"
msgid "  The way her legs draped to one side resembled those of a princess in a children's book."
msgstr "　正座から横にしなだれ落ちた両足は、絵本で見る少女の座り方に似ていた。"

#. Occurrence 7_7:385:9718: scene=7_7
#: 7_7:385
msgctxt "text_id=9718 | speaker=unknown"
msgid "  She looked more comfortable than she had the day before."
msgstr "　昨日よりは<幾分|いくぶん>居心地のいい座り方だろう。"

#. Occurrence 7_7:403:9719: scene=7_7
#: 7_7:403
msgctxt "text_id=9719 | speaker=unknown"
msgid "  Miraculously, he had a rare flash of insight that enabled him to read the situation more clearly."
msgstr "　たまに奇跡的な察しの良さを発揮する彼は、それで事の<絡|から><繰|くり>が読めてしまった。"

#. Occurrence 7_7:424:9720: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0001; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:424
msgctxt "text_id=9720 | speaker=soujuurou"
msgid "(...What could Tobimaru be doing at school on his own?)"
msgstr "『……学校で、鳶丸はひとり何をしているんだろう……』"

#. Occurrence 7_7:438:9721: scene=7_7
#: 7_7:438
msgctxt "text_id=9721 | speaker=unknown"
msgid "  Upon glancing back at the entrance, he made his decision, took a deep breath, and rolled up his sleeves."
msgstr "　ちらりと入ってきた玄関へ視線を投げて、よし、と気合いを入れて腕まくりをする。"

#. Occurrence 7_7:443:9722: scene=7_7
#: 7_7:443
msgctxt "text_id=9722 | speaker=unknown"
msgid "  If today was a reenactment of yesterday, then he supposed he would play along with that idea."
msgstr "　何もかも昨日の通りなら、自分もそれに合わせてみようと思ったのか。"

#. Occurrence 7_7:448:9723: scene=7_7
#: 7_7:448
msgctxt "text_id=9723 | speaker=unknown"
msgid "  Soujyuro removed his shoes and headed for the kitchen."
msgstr "　草十郎は鞄を置いて台所に向かった。"

#. Occurrence 7_7:453:9724: scene=7_7
#: 7_7:453
msgctxt "text_id=9724 | speaker=unknown"
msgid "  He was off to prepare another ill-fated pot of tea."
msgstr "　もちろん昨日と同じ、不出来な紅茶を淹れるために。"

#. Occurrence 7_7:494:9725: scene=7_7
#: 7_7:494
msgctxt "text_id=9725 | speaker=unknown"
msgid "  Since she was angry about him using her precious Fauchon, this time he turned to Jacksons' Fruit & Herb brew."
msgstr "　フォションは怒られたので、今日は反省してジャクソンのフルーツハーブを手に取る。"

#. Occurrence 7_7:500:9726: scene=7_7
#: 7_7:500
msgctxt "text_id=9726 | speaker=unknown"
msgid "  ...Sadly, this was about as much as Soujyuro could manage to amend his behavior."
msgstr "　……悲しいかな、これが今の草十郎の限界だった。"

#. Occurrence 7_7:505:9727: scene=7_7
#: 7_7:505
msgctxt "text_id=9727 | speaker=unknown"
msgid "  He had failed to realize that it was not the brand of tea that had landed him in hot water, but rather his incorrect brewing method."
msgstr "　お茶の葉の種類で怒られたのではなく、それを使いこなせなかった事が問題だったと気付いていない。"

#. Occurrence 7_7:551:9728: scene=7_7
#: 7_7:551
msgctxt "text_id=9728 | speaker=unknown"
msgid "  After filling the pot with tea, he carried it back to the foyer."
msgstr "　ポットに紅茶を淹れてロビーに戻る。"

#. Occurrence 7_7:557:9729: scene=7_7
#: 7_7:557
msgctxt "text_id=9729 | speaker=unknown"
msgid "  His breath was visible in the cold air as he sat himself down by the fireplace."
msgstr "　白い息をこぼして草十郎は暖炉の前にあぐらをかいた。"

#. Occurrence 7_7:562:9730: scene=7_7
#: 7_7:562
msgctxt "text_id=9730 | speaker=unknown"
msgid "  Soujyuro took a sip of the fruity tea he prepared for himself and pulled his textbook from his bag."
msgstr "　自分で淹れたフルーツミックスを口にし、鞄から教科書を取りだす。"

#. Occurrence 7_7:567:9731: scene=7_7
#: 7_7:567
msgctxt "text_id=9731 | speaker=unknown"
msgid "  Exams were over now, but he had been instructed to take extra classes for the subjects from day one of school. Quite inevitable."
msgstr "　期末試験は終わったけれど、一日目の科目はいくつか補習を宣言されたので、やっぱりこうなる運命なのだ。"

#. Occurrence 7_7:597:9732: scene=7_7
#: 7_7:597
msgctxt "text_id=9732 | speaker=unknown"
msgid "  The foyer was warmer than outside but still far from comfortable. It was enough to make anyone yearn for some source of warmth."
msgstr "　ロビーは外より<幾分|いくぶん>暖かいが、快適にはほど遠い。何らかの暖が恋しくなる寒さだ。"

#. Occurrence 7_7:602:9733: scene=7_7
#: 7_7:602
msgctxt "text_id=9733 | speaker=unknown"
msgid "  Soujyuro dove into his electronics textbook in the winter-chilled hall."
msgstr "　冬の寒気を色濃く残すホールで、草十郎は電子工学のテキストに没頭した。"

#. Occurrence 7_7:607:9734: scene=7_7
#: 7_7:607
msgctxt "text_id=9734 | speaker=unknown"
msgid "  The class was not very popular, which is why it had been recommended to him in the first place. That fact that everyone who took it started on equal footing made it more appealing to him than other classes."
msgstr "　選択する生徒が少ないという理由で勧められた科目だが、高校から基礎が始まる分、他の科目より少しだけ面白い。"

#. Occurrence 7_7:628:9735: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0002; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:628
msgctxt "text_id=9735 | speaker=soujuurou"
msgid "(Aozaki was right...)"
msgstr "『けど、蒼崎の言う通り』"

#. Occurrence 7_7:634:9736: scene=7_7
#: 7_7:634
msgctxt "text_id=9736 | speaker=unknown"
msgid "  He downed the rest of the tea, having no appreciation for its flavor, and refilled his cup."
msgstr "　味の分からない紅茶を空にして、カップに二杯目を注ぐ。"

#. Occurrence 7_7:639:9737: scene=7_7
#: 7_7:639
msgctxt "text_id=9737 | speaker=unknown"
msgid "  The tea was still warm, since the ceramic teapot had excellent heat retention."
msgstr "　陶磁器のポットは保温性に勝れているので、紅茶はまだ温かい。"

#. Occurrence 7_7:645:9738: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0003; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:645
msgctxt "text_id=9738 | speaker=soujuurou"
msgid "(I can't seem to remember anything that's written down.)"
msgstr "『文字で物事を覚えるのは、苦手みたいだ』"

#. Occurrence 7_7:663:9739: scene=7_7
#: 7_7:663
msgctxt "text_id=9739 | speaker=unknown"
msgid "  He vaguely recalled their conversation as his eyes advanced across the page."
msgstr "　ぼんやりと思いながら、草十郎は文字の羅列を読み進める。"

#. Occurrence 7_7:683:9740: scene=7_7
#: 7_7:683
msgctxt "text_id=9740 | speaker=unknown"
msgid "  The lack of lighting in the foyer was forcing him to rely on illumination from the skylight."
msgstr "　ロビーに電灯はなく、天窓からの日射しだけが頼りだ。"

#. Occurrence 7_7:688:9741: scene=7_7
#: 7_7:688
msgctxt "text_id=9741 | speaker=unknown"
msgid "  The light cut into the room at a diagonal angle in such a way as to divide the foyer into light and dark areas, with the fireplace in shadow."
msgstr "　斜に差しこむ光はロビーに明暗を作り、壁際の暖炉はじき影に沈もうとしている。"

#. Occurrence 7_7:722:9742: scene=7_7
#: 7_7:722
msgctxt "text_id=9742 | speaker=unknown"
msgid "  The room resembled ancient ruins covered in ash."
msgstr "　見ようによっては、灰に<浸|ひた>された廃墟の風景。"

#. Occurrence 7_7:727:9743: scene=7_7
#: 7_7:727
msgctxt "text_id=9743 | speaker=unknown"
msgid "  Or perhaps the quiet, forgotten world of a faded fairy tale."
msgstr "　あるいは、くすんだ童話の中に忘れられた、色あせた挿し絵の世界。"

#. Occurrence 7_7:733:9744: scene=7_7
#: 7_7:733
msgctxt "text_id=9744 | speaker=unknown"
msgid "  Time slipped on by within the white walls of this room, hidden away from the sun."
msgstr "　白い城壁の部屋で、時間は人知れず、太陽の目を盗むようにこつこつと流れていった。"

#. Occurrence 7_7:808:9745: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0004; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:808
msgctxt "text_id=9745 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 7_7:814:9746: scene=7_7
#: 7_7:814
msgctxt "text_id=9746 | speaker=unknown"
msgid "  The minutes passed slowly for some time. Until..."
msgstr "　そうして、ゆるやかに時間が過ぎたあと。"

#. Occurrence 7_7:820:9747: scene=7_7
#: 7_7:820
msgctxt "text_id=9747 | speaker=unknown"
msgid "  The sound of a textbook slamming shut brought the room back to reality."
msgstr "　ぱたんと教科書を閉じた音が、くすんだ風景を現実に引き戻した。"

#. Occurrence 7_7:825:9748: scene=7_7
#: 7_7:825
msgctxt "text_id=9748 | speaker=unknown"
msgid "  Soujyuro stretched his stiff back and eagerly got started on clearing up."
msgstr "　草十郎は腕を伸ばして肩の凝りをほぐすと、いそいそと後片づけをはじめる。"

#. Occurrence 7_7:846:9749: scene=7_7
#: 7_7:846
msgctxt "text_id=9749 | speaker=unknown"
msgid "  He put his textbook back in his bag,"
msgstr "　本を鞄にしまい、"

msgctxt "text_id=9750 | speaker=unknown"
msgid "placed his cup on the tray,"
msgstr "　有珠のカップはそのまま床に残し、"

msgctxt "text_id=9751 | speaker=unknown"
msgid "leaving Alice's sitting in front of her on the floor."
msgstr "　自分の使ったカップをトレイに載せて立ち上がって、"

#. Occurrence 7_7:859:9752: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0005; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:859
msgctxt "text_id=9752 | speaker=soujuurou"
msgid "\"Well, time to go to work,\""
msgstr "「バイトの時間だ」"

#. Occurrence 7_7:864:9753: scene=7_7
#: 7_7:864
msgctxt "text_id=9753 | speaker=unknown"
msgid "  he said unceremoniously."
msgstr "　あっさりと。"

#. Occurrence 7_7:882:9754: scene=7_7
#: 7_7:882
msgctxt "text_id=9754 | speaker=unknown"
msgid "  He spoke as if to convince himself that he had no other choice as he prepared to leave the sleepy foyer behind."
msgstr "　そういう事なら仕方ない、と納得するように口にして、眠るロビーを後にした。"

#. Occurrence 7_7:917:9755: scene=7_7
#: 7_7:917
msgctxt "text_id=9755 | speaker=unknown"
msgid "  But before he could..."
msgstr "　―――その直前。"

#. Occurrence 7_7:927:9756: scene=7_7
#: 7_7:927
msgctxt "text_id=9756 | speaker=unknown"
msgid "  A sound behind him stopped him in his tracks."
msgstr "　背後からの物音を聞いて、草十郎は足を止めた。"

#. Occurrence 7_7:942:9757: scene=7_7
#: 7_7:942
msgctxt "text_id=9757 | speaker=unknown"
msgid "  He turned around with his bag under his arm and tray in his hands."
msgstr "　鞄を<脇|わき>に挟んだままトレイ片手に振り返る。"

#. Occurrence 7_7:957:9758: scene=7_7
#: 7_7:957
msgctxt "text_id=9758 | speaker=unknown"
msgid "  So as not to cause even a ripple in her teacup, he greeted her,"
msgstr "　有珠用のカップに注がれた紅茶に波ひとつ立てず、"

#. Occurrence 7_7:976:9759: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0006; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:976
msgctxt "text_id=9759 | speaker=soujuurou"
msgid "\"Hey,\""
msgstr "「や」"

#. Occurrence 7_7:981:9760: scene=7_7
#: 7_7:981
msgctxt "text_id=9760 | speaker=unknown"
msgid "  in a light, easygoing manner."
msgstr "　気軽な口振りで、草十郎はそう語りかけた。"

#. Occurrence 7_7:1000:9761: scene=7_7
#: 7_7:1000
msgctxt "text_id=9761 | speaker=unknown"
msgid "  She remained seated next to the fireplace like a black-eyed sleeping beauty."
msgstr "　暖炉の横で座ったままの、黒い瞳の眠り姫に。"

#. Occurrence 7_7:1031:9762: scene=7_7
#: 7_7:1031
msgctxt "text_id=9762 | speaker=unknown"
msgid "  Her face was as still as a statue, almost no different than it had been in slumber."
msgstr "　有珠は彫像のようだった寝顔と変わらない静かさで草十郎を見ている。"

#. Occurrence 7_7:1036:9763: scene=7_7
#: 7_7:1036
msgctxt "text_id=9763 | speaker=unknown"
msgid "  Looking at Alice now, he realized just how different she and Aoko really were."
msgstr "　それを見て、草十郎は今更ながら有珠と青子の違いに気が付いた。"

#. Occurrence 7_7:1070:9764: scene=7_7
#: 7_7:1070
msgctxt "text_id=9764 | speaker=unknown"
msgid "  Aoko communicated her feelings openly, even if he never could quite tell where they came from."
msgstr "　青子は、その思考経路は謎としても、実に分かりやすい意思表示をしてくれる。"

#. Occurrence 7_7:1075:9765: scene=7_7
#: 7_7:1075
msgctxt "text_id=9765 | speaker=unknown"
msgid "  Her trademark expression of irritation would keep him guessing as to the reason she was angry, but to her credit her emotional state was always clear."
msgstr "　トレードマークである不機嫌そうな顔は、何に不機嫌なのかはさておくとして、常に意思を反映している。"

#. Occurrence 7_7:1080:9766: scene=7_7
#: 7_7:1080
msgctxt "text_id=9766 | speaker=unknown"
msgid "  Alice, on the other hand, was completely unreadable."
msgstr "　対して、有珠はそもそも感情が読めない。"

#. Occurrence 7_7:1085:9767: scene=7_7
#: 7_7:1085
msgctxt "text_id=9767 | speaker=unknown"
msgid "  She might be angry, or then again sad; he could not tell either way."
msgstr "　怒っているのか悲しんでいるのかさえ表れない。"

#. Occurrence 7_7:1106:9768: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0000; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1106
msgctxt "text_id=9768 | speaker=alice"
msgid "\"What do you think you're doing?\""
msgstr "「何の、つもり―――？」"

#. Occurrence 7_7:1123:9769: scene=7_7
#: 7_7:1123
msgctxt "text_id=9769 | speaker=unknown"
msgid "  Her question gave him a sinking feeling in the pit of his stomach."
msgstr "　沈みこむような問いかけ。"

#. Occurrence 7_7:1128:9770: scene=7_7
#: 7_7:1128
msgctxt "text_id=9770 | speaker=unknown"
msgid "  He could not decide whether it was animosity or perplexity that he heard in her voice."
msgstr "　敵意なのか疑問なのかすら、草十郎には判別がつかない。"

#. Occurrence 7_7:1133:9771: scene=7_7
#: 7_7:1133
msgctxt "text_id=9771 | speaker=unknown"
msgid "  If the former, this was likely to turn into a replay of their interaction from the other night."
msgstr "　もし前者なら、有珠を相手にあの夜の再現になるかもしれない。"

#. Occurrence 7_7:1163:9772: scene=7_7
#: 7_7:1163
msgctxt "text_id=9772 | speaker=unknown"
msgid "  An image of the shattered bottle sprang to his mind."
msgstr "　粉々に散った小瓶が草十郎の脳裏をよぎる。"

#. Occurrence 7_7:1168:9773: scene=7_7
#: 7_7:1168
msgctxt "text_id=9773 | speaker=unknown"
msgid "  Soujyuro knew his response would be extremely important,"
msgstr "　返答次第では無事では済まないと承知して、"

#. Occurrence 7_7:1173:9774: scene=7_7
#: 7_7:1173
msgctxt "text_id=9774 | speaker=unknown"
msgid "  and after struggling for a few moments he finally worked up the courage to say something."
msgstr "　しばし迷ったあと、草十郎は覚悟を決めた。"

#. Occurrence 7_7:1178:9775: scene=7_7
#: 7_7:1178
msgctxt "text_id=9775 | speaker=unknown"
msgid "  Just not the correct thing, unfortunately."
msgstr "　と、言うより―――"

#. Occurrence 7_7:1211:9776: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0007; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1211
msgctxt "text_id=9776 | speaker=soujuurou"
msgid "\"Right, about that... It'll take awhile to explain, so let me just have a seat first.\""
msgstr "「そうだな。一口じゃ説明できないから、座るよ」"

#. Occurrence 7_7:1217:9777: scene=7_7
#: 7_7:1217
msgctxt "text_id=9777 | speaker=unknown"
msgid "  He had no idea what the correct approach would be, so he simply did whatever came into his mind instead."
msgstr "　何が正しい選択か考えもつかなかったので、単純に、自分のしたい事をする事にした。"

#. Occurrence 7_7:1251:9778: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0001; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1251
msgctxt "text_id=9778 | speaker=alice"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 7_7:1256:9779: scene=7_7
#: 7_7:1256
msgctxt "text_id=9779 | speaker=unknown"
msgid "  She gave him no response."
msgstr "　返事はない。"

#. Occurrence 7_7:1261:9780: scene=7_7
#: 7_7:1261
msgctxt "text_id=9780 | speaker=unknown"
msgid "  Her face said that she detested his presence, but he plowed ahead regardless."
msgstr "　黒衣の少女は嫌がっているようにも見えたが、草十郎はあえて無視した。"

#. Occurrence 7_7:1296:9781: scene=7_7
#: 7_7:1296
msgctxt "text_id=9781 | speaker=unknown"
msgid "  Soujyuro took a seat and set down the tray once more. Their eyes met."
msgstr "　もう一度床に座ってトレイを置くと、ふたりの視線はぴったりと合った。"

#. Occurrence 7_7:1301:9782: scene=7_7
#: 7_7:1301
msgctxt "text_id=9782 | speaker=unknown"
msgid "  Her inscrutable gaze was enough to turn most people away."
msgstr "　底の見えない有珠の瞳は、依然として余人を寄せつけない。"

#. Occurrence 7_7:1318:9783: scene=7_7
#: 7_7:1318
msgctxt "text_id=9783 | speaker=unknown"
msgid "  But, the target of her animosity appeared not to notice it at all."
msgstr "　が。肝心の草十郎は、そんな重圧をまったく感じてはいないようだった。"

#. Occurrence 7_7:1355:9784: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0002; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1355
msgctxt "text_id=9784 | speaker=alice"
msgid "\"Yes...?\""
msgstr "「それで、なに……？」"

#. Occurrence 7_7:1361:9785: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0008; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1361
msgctxt "text_id=9785 | speaker=soujuurou"
msgid "\"Ah, well, I guess I should have done this a long time ago, but I've been wanting to talk to you about something, Alice.\""
msgstr "「ああ。遅くなったけど、こうして話がしたかったんだ、有珠と」"

#. Occurrence 7_7:1373:9786: scene=7_7
#: 7_7:1373
msgctxt "text_id=9786 | speaker=unknown"
msgid "  Despite having suggested that it would take time to explain, he managed to sum things up succinctly."
msgstr "　一口じゃ説明できないらしいのに、草十郎はあっさりと一口で説明した。"

#. Occurrence 7_7:1400:9787: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0003; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1400
msgctxt "text_id=9787 | speaker=alice"
msgid "\"Me? Not Aoko?\""
msgstr "「わたしと……？　青子とではなく？」"

#. Occurrence 7_7:1406:9788: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0009; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1406
msgctxt "text_id=9788 | speaker=soujuurou"
msgid "\"Hm? Well, I have lots to talk to Aozaki about. In fact, I think all three of us should sit down at some point...\""
msgstr "「ん？　そうだね、蒼崎とはもっと話したいところだけど、それよりは三人で話してみたい」"

#. Occurrence 7_7:1412:9789: scene=7_7
#: 7_7:1412
msgctxt "text_id=9789 | speaker=unknown"
msgid "  Alice found herself out of kilter, unable to read his true intentions."
msgstr "　草十郎の意図が読めず、戸惑う有珠。"

#. Occurrence 7_7:1417:9790: scene=7_7
#: 7_7:1417
msgctxt "text_id=9790 | speaker=unknown"
msgid "  Soujyuro continued on, failing to notice her bewilderment."
msgstr "　そんな有珠の困惑に気付かず、草十郎はしかつめらしく話を続ける。"

#. Occurrence 7_7:1451:9791: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0010; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1451
msgctxt "text_id=9791 | speaker=soujuurou"
msgid "\"Aozaki said you two rarely speak to each other. I'd feel bad if that's because of me, but I'd feel even worse if it isn't."
msgstr "「蒼崎は普段から有珠とは会話がないって言うんだ。それが俺のせいなら困るし、俺のせいじゃないならもっと困る。"

#. Occurrence 7_7:1457:9792: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0011; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1457
msgctxt "text_id=9792 | speaker=soujuurou"
msgid "  It's sad that we live together but never talk.\""
msgstr "　せっかく同じ場所に居るのに会話がないなんて、もったいないと思うんだ」"

#. Occurrence 7_7:1477:9793: scene=7_7
#: 7_7:1477
msgctxt "text_id=9793 | speaker=unknown"
msgid "  Each word he spoke was heavy with emotion."
msgstr "　噛みしめるような、やけに情感の籠もった声。"

#. Occurrence 7_7:1482:9794: scene=7_7
#: 7_7:1482
msgctxt "text_id=9794 | speaker=unknown"
msgid "  Alice remained utterly unable to discern this boy's intentions."
msgstr "　有珠には少年の意図はこれっぽっちも掴めない。"

#. Occurrence 7_7:1487:9795: scene=7_7
#: 7_7:1487
msgctxt "text_id=9795 | speaker=unknown"
msgid "  All she could parse was that there was something he wanted from her."
msgstr "　けれど、彼が自分に対して強く、何かを願っているのは感じ取れる。"

#. Occurrence 7_7:1502:9796: scene=7_7
#: 7_7:1502
msgctxt "text_id=9796 | speaker=unknown"
msgid "  ...But what could that be?"
msgstr "　……それが。"

#. Occurrence 7_7:1507:9797: scene=7_7
#: 7_7:1507
msgctxt "text_id=9797 | speaker=unknown"
msgid "  What she found even stranger was that he was not speaking to her from a place of fear."
msgstr "　恐れに起因するものでない事が、彼女には意外だった。"

#. Occurrence 7_7:1542:9798: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0004; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1542
msgctxt "text_id=9798 | speaker=alice"
msgid "\"Aren't you afraid of me?\""
msgstr "「貴方は、わたしが恐くないの……？」"

#. Occurrence 7_7:1564:9799: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0012; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1564
msgctxt "text_id=9799 | speaker=soujuurou"
msgid "\"No. I don't know enough about you to be scared of you, to tell the truth.\""
msgstr "「ああ。だってそう言えるほど、俺は君をよく知らない」"

#. Occurrence 7_7:1600:9800: scene=7_7
#: 7_7:1600
msgctxt "text_id=9800 | speaker=unknown"
msgid "  Her gleaming eyes looked like they were made of polished quartz."
msgstr "　見開いた瞳は<玻|は><璃|り>細工のように。"

#. Occurrence 7_7:1605:9801: scene=7_7
#: 7_7:1605
msgctxt "text_id=9801 | speaker=unknown"
msgid "  His response had not been what she expected."
msgstr "　少女にとって、少年の予想外さはもう驚きの域だった。"

#. Occurrence 7_7:1610:9802: scene=7_7
#: 7_7:1610
msgctxt "text_id=9802 | speaker=unknown"
msgid "  He spoke with pure honesty and unfettered truth."
msgstr "　あまりにも素直な、脊髄反射のような答え。"

#. Occurrence 7_7:1615:9803: scene=7_7
#: 7_7:1615
msgctxt "text_id=9803 | speaker=unknown"
msgid "  Such boldness, however, did not actually upset her."
msgstr "　そんな無遠慮極まりない言葉が、なぜか不快と感じない。"

#. Occurrence 7_7:1661:9804: scene=7_7
#: 7_7:1661
msgctxt "text_id=9804 | speaker=unknown"
msgid "  Their conversation ground to a halt,"
msgstr "　ふたりの会話はそこで途絶えた。"

#. Occurrence 7_7:1688:9805: scene=7_7
#: 7_7:1688
msgctxt "text_id=9805 | speaker=unknown"
msgid "  if you could even call it a conversation in the first place."
msgstr "　いや、もとより会話は成立していない。"

#. Occurrence 7_7:1705:9806: scene=7_7
#: 7_7:1705
msgctxt "text_id=9806 | speaker=unknown"
msgid "  Alice grew tense, as if displeased by the strangely comfortable moment of silence between them."
msgstr "　不思議と居心地のいい沈黙を嫌うように、少女は気を引き締める。"

#. Occurrence 7_7:1710:9807: scene=7_7
#: 7_7:1710
msgctxt "text_id=9807 | speaker=unknown"
msgid "  Soujyuro endured her cold stare, showing no sign of flinching."
msgstr "　少年はそんな少女の視線を、怯えることなく受けとめる。"

#. Occurrence 7_7:1731:9808: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0005; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1731
msgctxt "text_id=9808 | speaker=alice"
msgid "\"...Talk.\""
msgstr "「…………話」"

#. Occurrence 7_7:1750:9809: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0013; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1750
msgctxt "text_id=9809 | speaker=soujuurou"
msgid "\"Hm?\""
msgstr "「ん？」"

#. Occurrence 7_7:1768:9810: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0006; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1768
msgctxt "text_id=9810 | speaker=alice"
msgid "\"You said you wanted to talk to me."
msgstr "「わたしと話をしたいと言ったでしょう。"

#. Occurrence 7_7:1774:9811: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0007; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1774
msgctxt "text_id=9811 | speaker=alice"
msgid "  So... be my guest. Whatever topic you like.\""
msgstr "　なら、好きにしてみたら……？」"

#. Occurrence 7_7:1808:9812: scene=7_7
#: 7_7:1808
msgctxt "text_id=9812 | speaker=unknown"
msgid "  It was more a challenge than an invitation."
msgstr "　できるものならしてみろ、という少女の誘い。"

#. Occurrence 7_7:1813:9813: scene=7_7
#: 7_7:1813
msgctxt "text_id=9813 | speaker=unknown"
msgid "  He had neither a topic on hand, nor were they intimate enough to strike up a casual conversation."
msgstr "　草十郎には彼女に話しかける話題も、親密さもない。"

#. Occurrence 7_7:1818:9814: scene=7_7
#: 7_7:1818
msgctxt "text_id=9814 | speaker=unknown"
msgid "  Nonetheless, her challenge hanged in the air, waiting for a response."
msgstr "　意地の悪い少女の挑発は、しかし。"

#. Occurrence 7_7:1853:9815: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0014; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1853
msgctxt "text_id=9815 | speaker=soujuurou"
msgid "\"Well, what about that bird? The blue one over there."
msgstr "「じゃあ、あの鳥の話を。ほら、そこにいる青い鳥。"

#. Occurrence 7_7:1859:9816: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0015; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1859
msgctxt "text_id=9816 | speaker=soujuurou"
msgid "  I see it around now and then. Is it your pet?"
msgstr "　たまに見かけるんだけど、君の飼い鳥か？"

#. Occurrence 7_7:1865:9817: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0016; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1865
msgctxt "text_id=9817 | speaker=soujuurou"
msgid "  Or is it one of those, what are they called... 'Ploys'? A magical familiar?\""
msgstr "　それともほら、なんて言ったかな。プロイ、だっけ。あの鳥も有珠の使い魔？」"

#. Occurrence 7_7:1885:9818: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0008; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1885
msgctxt "text_id=9818 | speaker=alice"
msgid "\"...\""
msgstr "「っ―――」"

#. Occurrence 7_7:1890:9819: scene=7_7
#: 7_7:1890
msgctxt "text_id=9819 | speaker=unknown"
msgid "  Her eyes let slip for a moment a very natural response."
msgstr "　一瞬、少女の瞳に人間らしい色が灯る。"

#. Occurrence 7_7:1895:9820: scene=7_7
#: 7_7:1895
msgctxt "text_id=9820 | speaker=unknown"
msgid "  It was annoyance, such as that which one might feel toward a troublemaker."
msgstr "　あの厄介者、と睨みつけるような視線だった。"

#. Occurrence 7_7:1943:9821: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0009; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1943
msgctxt "text_id=9821 | speaker=alice"
msgid "\"Yes, it's a Ploy, but the stupid bird isn't mine. It's lived here longer than I have, and I'm afraid I don't know much about it.\""
msgstr "「……アレもプロイだけど、わたしとは何の関係もない<駄鳥|だちょう>。ずいぶん古くから<在|い>るだけで、わたしもよく知らないわ」"

#. Occurrence 7_7:1962:9822: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0017; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1962
msgctxt "text_id=9822 | speaker=soujuurou"
msgid "\"You mean... it just decided to live here of its own free will?\""
msgstr "「？　じゃあ勝手に住んでるのか、この家に？」"

#. Occurrence 7_7:1995:9823: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0010; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1995
msgctxt "text_id=9823 | speaker=alice"
msgid "\"Of course not. I would never allow such a thing."
msgstr "「勝手になんて、わたしが許す筈がないでしょう。"

#. Occurrence 7_7:2001:9824: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0011; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2001
msgctxt "text_id=9824 | speaker=alice"
msgid "  Robin's useless, but I inherited it from my mother. As such, I permit it to continue living here, despite its constant failures and shortcomings.\""
msgstr "　……ロビンは本当に役に立たないけど、あんなのでも母から譲り受けたものだから。失敗続きでも、特別に住まわせてあげてるの」"

#. Occurrence 7_7:2038:9825: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0018; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2038
msgctxt "text_id=9825 | speaker=soujuurou"
msgid "\"I see. That's a relief. Here I was thinking I'm the only useless one in the house.\""
msgstr "「そっか、安心した。ここに住むの、役に立たなきゃダメってワケでもないんだね」"

#. Occurrence 7_7:2058:9826: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0012; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2058
msgctxt "text_id=9826 | speaker=alice"
msgid "\"...\""
msgstr "「っ―――」"

#. Occurrence 7_7:2092:9827: scene=7_7
#: 7_7:2092
msgctxt "text_id=9827 | speaker=unknown"
msgid "  She turned away in silence to avoid looking at his hapless grin."
msgstr "　無防備な笑顔を向けられて、少女は顔を<逸|そ>らして黙りこんでしまった。"

#. Occurrence 7_7:2097:9828: scene=7_7
#: 7_7:2097
msgctxt "text_id=9828 | speaker=unknown"
msgid "  Thus began Soujyuro's very lengthy monologue."
msgstr "　あとの時間は、草十郎が喋るだけの一方通行だ。"

#. Occurrence 7_7:2102:9829: scene=7_7
#: 7_7:2102
msgctxt "text_id=9829 | speaker=unknown"
msgid "  It started with his part-time job, then moved on to the school. Next came the amusement park and random gossip around town, and last the subject of rent."
msgstr "　日々のアルバイトのこと。学校のこと。遊園地でのこと。町のこと。家賃のこと。"

#. Occurrence 7_7:2107:9830: scene=7_7
#: 7_7:2107
msgctxt "text_id=9830 | speaker=unknown"
msgid "  He spent all of twenty minutes on mindless small talk."
msgstr "　そんな益体のない話をすること二十分。"

#. Occurrence 7_7:2112:9831: scene=7_7
#: 7_7:2112
msgctxt "text_id=9831 | speaker=unknown"
msgid "  Then he ran out of things to say and finally stopped."
msgstr "　さすがにこれ以上は延ばせない、と少年は会話を切った。"

#. Occurrence 7_7:2144:9832: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0019; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2144
msgctxt "text_id=9832 | speaker=soujuurou"
msgid "\"Sorry. I'm on the clock soon, so I should get going.\""
msgstr "「ごめん。アルバイトがあるから、もう行くよ」"

#. Occurrence 7_7:2162:9833: scene=7_7
#: 7_7:2162
msgctxt "text_id=9833 | speaker=unknown"
msgid "  And that was that."
msgstr "　……この通り。"

#. Occurrence 7_7:2167:9834: scene=7_7
#: 7_7:2167
msgctxt "text_id=9834 | speaker=unknown"
msgid "  After finally getting his long-awaited chance to talk to her, he realized he had no exit plan in place."
msgstr "　せっかくの機会をあっさり諦めるあたり、本当に何も考えていなかったらしい。"

#. Occurrence 7_7:2200:9835: scene=7_7
#: 7_7:2200
msgctxt "text_id=9835 | speaker=unknown"
msgid "  So he returned the tray to the kitchen, placed his bag in the foyer, and headed for the door."
msgstr "　草十郎はトレイを厨房に戻し、鞄をロビーに置いて玄関に向かう。"

#. Occurrence 7_7:2205:9836: scene=7_7
#: 7_7:2205
msgctxt "text_id=9836 | speaker=unknown"
msgid "  She had never seen the boy so candid."
msgstr "　有珠は彼のそんな淡泊さを知らなかった。"

#. Occurrence 7_7:2210:9837: scene=7_7
#: 7_7:2210
msgctxt "text_id=9837 | speaker=unknown"
msgid "  Which was why, overcome with surprise, she found herself calling out to him."
msgstr "　なので、意表をつかれて見届けそうになって、つい、"

#. Occurrence 7_7:2229:9838: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0013; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2229
msgctxt "text_id=9838 | speaker=alice"
msgid "\"...Wait.\""
msgstr "「―――待って」"

#. Occurrence 7_7:2235:9839: scene=7_7
#: 7_7:2235
msgctxt "text_id=9839 | speaker=unknown"
msgid "  She had no reason to do so, and yet she called out anyway."
msgstr "　必要もないのに、その背中を呼び止めていた。"

#. Occurrence 7_7:2268:9840: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0020; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2268
msgctxt "text_id=9840 | speaker=soujuurou"
msgid "\"Hm? Yes?\""
msgstr "「ん、なに？」"

#. Occurrence 7_7:2288:9841: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0014; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2288
msgctxt "text_id=9841 | speaker=alice"
msgid "\"...It's just..."
msgstr "「…………その。"

#. Occurrence 7_7:2300:9842: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0015; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2300
msgctxt "text_id=9842 | speaker=alice"
msgid "  I saw the pot you used today.\""
msgstr "　今日は、ポットがあったけど」"

#. Occurrence 7_7:2320:9843: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0021; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2320
msgctxt "text_id=9843 | speaker=soujuurou"
msgid "\"Oh, right. I wasn't going to make the same mistake as yesterday. But I guess I'm the only one who drank any today, so...\""
msgstr "「あ、うん。昨日の反省点だったから。結局、使ったのは自分だけだけど」"

#. Occurrence 7_7:2354:9844: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0016; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2354
msgctxt "text_id=9844 | speaker=alice"
msgid "\"Well, that pot is normally used for coffee, so you shouldn't put tea leaves in it.\""
msgstr "「そう。……そのポットはコーヒーとの兼用だから、ハーブティーには合わないわ」"

#. Occurrence 7_7:2360:9845: scene=7_7
#: 7_7:2360
msgctxt "text_id=9845 | speaker=unknown"
msgid "  Soujyuro's eyes grew wide with shock."
msgstr "　む、と目を見張る草十郎。"

#. Occurrence 7_7:2365:9846: scene=7_7
#: 7_7:2365
msgctxt "text_id=9846 | speaker=unknown"
msgid "  Now he remembered that there had been all sorts of cups and teapots in the cupboard. Each one specially designed for a different type of tea!"
msgstr "　言われてみれば、紅茶のポットとカップは何種類もあった。どうも各紅茶には専用のティーセットが定められているらしい。"

#. Occurrence 7_7:2386:9847: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0022; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2386
msgctxt "text_id=9847 | speaker=soujuurou"
msgid "\"Who knew there was so much to brewing tea?"
msgstr "「……なかなかに奥深い。"

#. Occurrence 7_7:2392:9848: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0023; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2392
msgctxt "text_id=9848 | speaker=soujuurou"
msgid "  I guess a beginner like me shouldn't mess with things he doesn't understand, huh?\""
msgstr "　あれかな、慣れない事はするもんじゃないってコトか」"

#. Occurrence 7_7:2397:9849: scene=7_7
#: 7_7:2397
msgctxt "text_id=9849 | speaker=unknown"
msgid "  She let out a vexed sigh."
msgstr "　やれやれと嘆息する。"

#. Occurrence 7_7:2416:9850: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0017; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2416
msgctxt "text_id=9850 | speaker=alice"
msgid "\"Why didn't you wake me?\""
msgstr "「……どうして、わたしを起こさなかったの？」"

#. Occurrence 7_7:2421:9851: scene=7_7
#: 7_7:2421
msgctxt "text_id=9851 | speaker=unknown"
msgid "  Either she had not heard what he said, or she had been waiting this whole time for a chance to ask him that."
msgstr "　草十郎の言葉なんて聞いていないのか、それとも、それが本当に訊ねたかった事なのか。"

#. Occurrence 7_7:2426:9852: scene=7_7
#: 7_7:2426
msgctxt "text_id=9852 | speaker=unknown"
msgid "  In any case, her question abruptly interrupted his stream of thought."
msgstr "　有珠は彼の言葉を<遮|さえぎ>って問いただした。"

#. Occurrence 7_7:2465:9853: scene=7_7
#: 7_7:2465
msgctxt "text_id=9853 | speaker=unknown"
msgid "  He fell silent with introspection."
msgstr "　草十郎はむ、と自問するように黙りこむ。"

#. Occurrence 7_7:2470:9854: scene=7_7
#: 7_7:2470
msgctxt "text_id=9854 | speaker=unknown"
msgid "  The thought of waking her had not so much as crossed his mind either that day or the previous one."
msgstr "　言われて見れば、昨日も今日も“有珠を起こす”という発想に、まったく思い至らなかったからだ。"

#. Occurrence 7_7:2502:9855: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0018; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2502
msgctxt "text_id=9855 | speaker=alice"
msgid "\"...Tell me."
msgstr "「……言って。"

#. Occurrence 7_7:2509:9856: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0019; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2509
msgctxt "text_id=9856 | speaker=alice"
msgid "You didn't wake me. Did you expect me to just keep sleeping?\""
msgstr "起こす気も、起きることも期待していなかったのは、なぜ？」"

#. Occurrence 7_7:2515:9857: scene=7_7
#: 7_7:2515
msgctxt "text_id=9857 | speaker=unknown"
msgid "  Her eyes were filled with animosity."
msgstr "　その視線には殺意すら含まれている。"

#. Occurrence 7_7:2520:9858: scene=7_7
#: 7_7:2520
msgctxt "text_id=9858 | speaker=unknown"
msgid "  Lies were useless against such an all-piercing gaze."
msgstr "　深い瞳にはどんな嘘も通用しない。"

#. Occurrence 7_7:2525:9859: scene=7_7
#: 7_7:2525
msgctxt "text_id=9859 | speaker=unknown"
msgid "  The setting sun transformed the foyer into a battle of life and death."
msgstr "　夕暮れのロビーは一転して、生死を分かつ法廷になっていた。"

#. Occurrence 7_7:2557:9860: scene=7_7
#: 7_7:2557
msgctxt "text_id=9860 | speaker=unknown"
msgid "  Lies or deceptive answers would not be permitted."
msgstr "　嘘も、つまらない答えも許さない。"

#. Occurrence 7_7:2562:9861: scene=7_7
#: 7_7:2562
msgctxt "text_id=9861 | speaker=unknown"
msgid "  Amidst the palpable tension that filled the room, where any move, wrong or otherwise, was likely to get him killed, he felt pain rather than fear."
msgstr "　何を口にしようと心臓を貫かれそうな雰囲気の中、草十郎が抱いた感情は恐れより痛みだった。"

#. Occurrence 7_7:2567:9862: scene=7_7
#: 7_7:2567
msgctxt "text_id=9862 | speaker=unknown"
msgid "  Alice's voice was icy cold, preemptively rejecting any response he was to give."
msgstr "　久遠寺有珠の声は冷たく、また、回答を拒絶している。"

#. Occurrence 7_7:2572:9863: scene=7_7
#: 7_7:2572
msgctxt "text_id=9863 | speaker=unknown"
msgid "  The boy vaguely imagined a newborn chick that had fallen from the nest, struggling to survive on its own."
msgstr "　少年は漠然と、地面に落ちながら<独|ひと>り立ちしたひな鳥を連想した。"

#. Occurrence 7_7:2578:9864: scene=7_7
#: 7_7:2578
msgctxt "text_id=9864 | speaker=unknown"
msgid "  It gasped, hanging on to a thread of hope, yet detesting where that thread hung."
msgstr "　一縷の希望を待ちながら、その希望の<在処|ありか>を憎む、取り残されたモノの喘ぎ。"

#. Occurrence 7_7:2611:9865: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0024; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2611
msgctxt "text_id=9865 | speaker=soujuurou"
msgid "\"Do you really want to know?\""
msgstr "「言わなきゃいけないか？」"

#. Occurrence 7_7:2616:9866: scene=7_7
#: 7_7:2616
msgctxt "text_id=9866 | speaker=unknown"
msgid "  Alice nodded sharply."
msgstr "　有珠はこくりと頷く。"

#. Occurrence 7_7:2629:9867: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0025; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2629
msgctxt "text_id=9867 | speaker=soujuurou"
msgid "\"Fine, but it's not especially meaningful or anything."
msgstr "「じゃあ言うけど、別に深い考えがあったワケじゃない。"

#. Occurrence 7_7:2629:9868: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0025; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2629
msgctxt "text_id=9868 | speaker=soujuurou"
msgid "  I just think it's rude to wake someone who's asleep.\""
msgstr "　単に、寝た子を起こすのはよくないだろ」"

#. Occurrence 7_7:2635:9869: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0020; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2635
msgctxt "text_id=9869 | speaker=alice"
msgid "\"...I have no time for jokes.\""
msgstr "「……冗談は聞いてないわ」"

#. Occurrence 7_7:2641:9870: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0026; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2641
msgctxt "text_id=9870 | speaker=soujuurou"
msgid "\"That is the truth. I just thought I should let you sleep. I really wanted to talk, but I decided to wait till the next time we saw each other.\""
msgstr "「冗談じゃないよ。眠っているのならそのままでいいと思ったんだ。話はしたいけど、それはまた、目が覚めた次の機会にするべきだって」"

#. Occurrence 7_7:2677:9871: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0021; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2677
msgctxt "text_id=9871 | speaker=alice"
msgid "\"How sweet of you. That reminds me, Aoko's protection over you ends today, doesn't it?"
msgstr "「……ずいぶんと悠長なのね。青子が貴方を守るのは今日までだって聞いているけど。"

#. Occurrence 7_7:2683:9872: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0022; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2683
msgctxt "text_id=9872 | speaker=alice"
msgid "  That makes this your last chance to win me over."
msgstr "　わたしに取り入る機会はこれが最後なのに。"

#. Occurrence 7_7:2689:9873: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0023; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2689
msgctxt "text_id=9873 | speaker=alice"
msgid "  So, have you, or have you not, learned your lesson, hmm?\""
msgstr "　それとも―――あれだけ忠告されておいて、まだ何も分かっていないの？」"

#. Occurrence 7_7:2710:9874: scene=7_7
#: 7_7:2710
msgctxt "text_id=9874 | speaker=unknown"
msgid "  He had not."
msgstr "　何も分かっていない。"

#. Occurrence 7_7:2715:9875: scene=7_7
#: 7_7:2715
msgctxt "text_id=9875 | speaker=unknown"
msgid "  He swore to her, agreed to her terms, and gone as far as to sit face to face with her to get to know her. Surely, he thought, this was enough to escape death."
msgstr "　約束はした、事情も分かった、同じ人間として話し合えた。だから―――もう殺される事はないはずだ、と。"

#. Occurrence 7_7:2720:9876: scene=7_7
#: 7_7:2720
msgctxt "text_id=9876 | speaker=unknown"
msgid "  And she believed, as a mage, that his naive goodwill and simplemindedness were all the reasons she needed to execute him."
msgstr "　そんな良識、常識からの判断なら、少女はこの場で魔女としての鉄槌を振り下ろす。"

#. Occurrence 7_7:2725:9877: scene=7_7
#: 7_7:2725
msgctxt "text_id=9877 | speaker=unknown"
msgid "  Trivial misunderstandings would only make things worse at this point."
msgstr "　くだらない勘違いは、どちらにとっても害にしかならないからだ。"

#. Occurrence 7_7:2759:9878: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0027; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2759
msgctxt "text_id=9878 | speaker=soujuurou"
msgid "\"What lesson? What am I supposed to have learned? All this magic and magecraft stuff is way over my head."
msgstr "「そりゃ何も分からないよ。魔術とか魔法とか、たった数日で分かるもんか。"

#. Occurrence 7_7:2765:9879: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0028; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2765
msgctxt "text_id=9879 | speaker=soujuurou"
msgid "  All I know is I've done everything you and Aozaki have asked of me.\""
msgstr "　はっきりしているのは、有珠も蒼崎も言った事はきっちり守るってコトだけだ」"

#. Occurrence 7_7:2785:9880: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0024; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2785
msgctxt "text_id=9880 | speaker=alice"
msgid "\"Then why...?\""
msgstr "「なら、どうして」"

#. Occurrence 7_7:2790:9881: scene=7_7
#: 7_7:2790
msgctxt "text_id=9881 | speaker=unknown"
msgid "  Her gaze said what she really wanted to ask. She wanted to know why he did not beg for his life."
msgstr "　眠っている自分を起こして、命を<乞|こ>わなかったのかと視線で問う。"

#. Occurrence 7_7:2824:9882: scene=7_7
#: 7_7:2824
msgctxt "text_id=9882 | speaker=unknown"
msgid "  She knew the answer."
msgstr "　有珠は知っている。"

#. Occurrence 7_7:2842:9883: scene=7_7
#: 7_7:2842
msgctxt "text_id=9883 | speaker=unknown"
msgid "  She saw the look on his face when he turned to leave without so much as trying to wake her."
msgstr "　この少年が自分を起こさず立ち去ろうとした時に見せた表情を。"

#. Occurrence 7_7:2877:9884: scene=7_7
#: 7_7:2877
msgctxt "text_id=9884 | speaker=unknown"
msgid "  A look of resignation."
msgstr "“そういう事なら仕方がない―――”"

#. Occurrence 7_7:2882:9885: scene=7_7
#: 7_7:2882
msgctxt "text_id=9885 | speaker=unknown"
msgid "  What on earth had it meant?"
msgstr "　あの顔は、一体どういう意味だったのか。"

#. Occurrence 7_7:2917:9886: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0029; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2917
msgctxt "text_id=9886 | speaker=soujuurou"
msgid "\"What do you expect me to say?"
msgstr "「どうしてって、そう言われても困る。"

#. Occurrence 7_7:2933:9887: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0030; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2933
msgctxt "text_id=9887 | speaker=soujuurou"
msgid "  I thought if the opportunity didn't present itself, then so be it."
msgstr "　……そうだな。機会が訪れなかったのなら、それはそういう事だと思ったのかもしれない。"

#. Occurrence 7_7:2945:9888: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0031; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2945
msgctxt "text_id=9888 | speaker=soujuurou"
msgid "  When I saw you sleeping again I didn't know what to do. You're not exactly the easiest people to approach, you and Aozaki, though Aozaki is a little different...\""
msgstr "　君の寝顔はそれぐらい、なんていうか判断に困った。蒼崎とは違う意味で、簡単には関われないと思ったんだ」"

#. Occurrence 7_7:2965:9889: scene=7_7
#: 7_7:2965
msgctxt "text_id=9889 | speaker=unknown"
msgid "  Soujyuro struggled to find the right words, but said what he was feeling in the moment anyway."
msgstr "　うまく言葉にできないながらも、草十郎はあの時の気持ちを口にする。"

#. Occurrence 7_7:2984:9890: scene=7_7
#: 7_7:2984
msgctxt "text_id=9890 | speaker=unknown"
msgid "  He'd seen a sleeping witch of the wood who clearly needed someone's help yet sought the help of no one."
msgstr "　誰かを必要としているクセに誰も望んでいない、眠りの森の少女の姿を。"

#. Occurrence 7_7:3005:9891: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0025; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:3005
msgctxt "text_id=9891 | speaker=alice"
msgid "\"But here you are trying to approach me anyway."
msgstr "「……そう。でも、静希君は関わろうとしているのね。"

#. Occurrence 7_7:3011:9892: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0026; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:3011
msgctxt "text_id=9892 | speaker=alice"
msgid "  Even though the opportunity never presented itself.\""
msgstr "　その機会は、訪れなかったのに」"

#. Occurrence 7_7:3044:9893: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0032; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3044
msgctxt "text_id=9893 | speaker=soujuurou"
msgid "\"Oh, but it did. That's why I decided to do things my way today, even if nothing could go right to begin with.\""
msgstr "「機会はやってきたよ。なんで、こっちも今日ぐらいは自分の勝手にして、無茶をしたくなったんだ」"

#. Occurrence 7_7:3061:9894: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0027; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:3061
msgctxt "text_id=9894 | speaker=alice"
msgid "\"You talk as though you always expected me to reject you.\""
msgstr "「静希君の言う通りなら、わたしは貴方を拒絶するしかないのに？」"

#. Occurrence 7_7:3082:9895: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0033; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3082
msgctxt "text_id=9895 | speaker=soujuurou"
msgid "\"Err, yeah, I guess it's hard to explain.\""
msgstr "「まあ、そこが難しいところなんだけど」"

#. Occurrence 7_7:3099:9896: scene=7_7
#: 7_7:3099
msgctxt "text_id=9896 | speaker=unknown"
msgid "  Soujyuro glanced at the entrance."
msgstr "　草十郎はちらりと玄関に視線を向ける。"

#. Occurrence 7_7:3104:9897: scene=7_7
#: 7_7:3104
msgctxt "text_id=9897 | speaker=unknown"
msgid "  He had no reason to-he just felt an urge to do so."
msgstr "　今は何の意味もない行為だが、そうせずにはいられなかったのだ。"

#. Occurrence 7_7:3111:9898: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0034; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3111
msgctxt "text_id=9898 | speaker=soujuurou"
msgid "\"I doubt I'm the only one who'd like to see this situation solved.\""
msgstr "「たぶん、そこを解決したがってるのは俺だけじゃないと思うよ」"

#. Occurrence 7_7:3144:9899: scene=7_7
#: 7_7:3144
msgctxt "text_id=9899 | speaker=unknown"
msgid "  He muttered as if speaking to himself, but it was clearly meant for her to hear."
msgstr "　自問めいた答えは少女に対して向けられたものでもある。"

#. Occurrence 7_7:3149:9900: scene=7_7
#: 7_7:3149
msgctxt "text_id=9900 | speaker=unknown"
msgid "  Alice knew full well how poorly he had understood the situation."
msgstr "　それが大きな間違いだという事を、有珠は分かっている。"

#. Occurrence 7_7:3154:9901: scene=7_7
#: 7_7:3154
msgctxt "text_id=9901 | speaker=unknown"
msgid "  All of this was one giant misunderstanding on his part."
msgstr "　全て彼の勘違い。"

#. Occurrence 7_7:3159:9902: scene=7_7
#: 7_7:3159
msgctxt "text_id=9902 | speaker=unknown"
msgid "  His tiny gesture of goodwill, pitiful and pure, resembled that of someone reaching out to help a dying kitten."
msgstr "　死に瀕した子猫に手を伸ばそうとする程度の、清らかで浅ましい、小さな善性。"

#. Occurrence 7_7:3164:9903: scene=7_7
#: 7_7:3164
msgctxt "text_id=9903 | speaker=unknown"
msgid "  For Alice, doing so would be akin to clutching the thorns of a rose."
msgstr "　それが、有珠には<茨|いばら>のようにいとわしかった。"

#. Occurrence 7_7:3170:9904: scene=7_7
#: 7_7:3170
msgctxt "text_id=9904 | speaker=unknown"
msgid "  She felt pain in her chest for the first time in quite a while."
msgstr "　……久しぶりに、胸に痛いと感じたのだ。"

#. Occurrence 7_7:3205:9905: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0028; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:3205
msgctxt "text_id=9905 | speaker=alice"
msgid "\"I still don't want you in the mansion.\""
msgstr "「……けど、わたしは貴方の同居を認めてはいないわ」"

#. Occurrence 7_7:3223:9906: scene=7_7
#: 7_7:3223
msgctxt "text_id=9906 | speaker=unknown"
msgid "  She addressed the floor at her feet to avoid showing him how she truly felt."
msgstr "　そんな心を隠すように、うつむき加減に有珠は言った。"

#. Occurrence 7_7:3228:9907: scene=7_7
#: 7_7:3228
msgctxt "text_id=9907 | speaker=unknown"
msgid "  If he had, he would have seen that her face looked just the way Aoko's had earlier."
msgstr "　立っている草十郎からでは、今の有珠が、あの時の青子と同じ顔をしている事には気づけない。"

#. Occurrence 7_7:3262:9908: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0035; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3262
msgctxt "text_id=9908 | speaker=soujuurou"
msgid "\"I'm sure you don't. And I doubt that'll change anytime soon."
msgstr "「だろうな。それはきっと、今は解決できない問題だ。"

#. Occurrence 7_7:3268:9909: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0036; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3268
msgctxt "text_id=9909 | speaker=soujuurou"
msgid "  But that doesn't mean we can't work something out. It's okay if you keep hating me in the meantime.\""
msgstr "　でもそのうち、何かの気まぐれであっさり終わるものかもしれない。だからその時まで、有珠はずっと、俺を嫌っていていいんだと思う」"

#. Occurrence 7_7:3289:9910: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0029; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:3289
msgctxt "text_id=9910 | speaker=alice"
msgid "\"...\""
msgstr "「―――――――――」"

#. Occurrence 7_7:3295:9911: scene=7_7
#: 7_7:3295
msgctxt "text_id=9911 | speaker=unknown"
msgid "  Her gasp of breath was like a response in itself."
msgstr "　息を飲む気配は、それこそ声のように。"

#. Occurrence 7_7:3300:9912: scene=7_7
#: 7_7:3300
msgctxt "text_id=9912 | speaker=unknown"
msgid "  To suggest she could keep hating him..."
msgstr "　その時まで、嫌ってもいいと。"

#. Occurrence 7_7:3305:9913: scene=7_7
#: 7_7:3305
msgctxt "text_id=9913 | speaker=unknown"
msgid "  She had once wished to hear those words so dearly, if only the once."
msgstr "　そんな言葉を、少女は今まで、いや、一度だけ、強く願った事があって―――"

#. Occurrence 7_7:3332:9914: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0037; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3332
msgctxt "text_id=9914 | speaker=soujuurou"
msgid "\"I mean, you're not the only one. That goes for Aozaki, too. I don't think she wants me here, either."
msgstr "「だいたいだぞ。有珠だけじゃなく、蒼崎も同居を認めてない節があるじゃないか。"

#. Occurrence 7_7:3338:9915: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0038; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3338
msgctxt "text_id=9915 | speaker=soujuurou"
msgid "  Expecting to feel welcomed would be a big mistake on my part. We're fundamentally different people, and that's never going to change."
msgstr "　だから、認めてもらう、なんて意気ごみ自体が間違いなんだ。どうあっても俺は蒼崎や君たちとは違うんだし。"

#. Occurrence 7_7:3344:9916: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0039; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3344
msgctxt "text_id=9916 | speaker=soujuurou"
msgid "  I just want you to tolerate me."
msgstr "　となると、あとは我慢してもらうしかない。"

#. Occurrence 7_7:3351:9917: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0040; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3351
msgctxt "text_id=9917 | speaker=soujuurou"
msgid "I know it's a lot to ask, but is there a way I could live here without bothering you too much?\""
msgstr "難しい話だけど、一緒にいても邪魔にならないぐらいなら、その可能性はあがらないか？」"

#. Occurrence 7_7:3383:9918: scene=7_7
#: 7_7:3383
msgctxt "text_id=9918 | speaker=unknown"
msgid "  Thinking that of course it was possible, but if it were that easy none of this would have been necessary in the first place, Alice nodded in agreement."
msgstr "　たしかにその通りなのだけど、それが出来るのなら苦労はしない―――と、そこまで思って、有珠はなるほど、と頷いてしまった。"

#. Occurrence 7_7:3388:9919: scene=7_7
#: 7_7:3388
msgctxt "text_id=9919 | speaker=unknown"
msgid "  There was no way he could have planned for things to work out this well."
msgstr "　彼が企んだ訳ではないのだろうが。"

#. Occurrence 7_7:3393:9920: scene=7_7
#: 7_7:3393
msgctxt "text_id=9920 | speaker=unknown"
msgid "  But his plan in fact had worked, if inadvertently, from the moment the conversation began."
msgstr "　こうして会話が成立している時点で、自分は術中に<嵌|はま>ってしまったのだ。"

#. Occurrence 7_7:3426:9921: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0030; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:3426
msgctxt "text_id=9921 | speaker=alice"
msgid "\"You mean, so that I can sleep undisturbed even with you sitting right next to me?\""
msgstr "「例えば、貴方が<隣|となり>にいても眠っていられるぐらいに？」"

#. Occurrence 7_7:3444:9922: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0041; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3444
msgctxt "text_id=9922 | speaker=soujuurou"
msgid "\"Sure, why not.\""
msgstr "「そうだね、例えばの話」"

#. Occurrence 7_7:3461:9923: scene=7_7
#: 7_7:3461
msgctxt "text_id=9923 | speaker=unknown"
msgid "  Beaming, Soujyuro stood up and left the foyer."
msgstr "　笑顔で返して草十郎はロビーを後にする。"

#. Occurrence 7_7:3466:9924: scene=7_7
#: 7_7:3466
msgctxt "text_id=9924 | speaker=unknown"
msgid "  Alice did not stop him this time."
msgstr "　その後ろ姿を有珠はもう止めなかった。"

#. Occurrence 7_7:3518:9925: scene=7_7
#: 7_7:3518
msgctxt "text_id=9925 | speaker=unknown"
msgid "  He had a newfound spring in his step as he headed to work."
msgstr "　玄関から外に出た少年は、心機一転してアルバイト先に足を向ける。"

#. Occurrence 7_7:3523:9926: scene=7_7
#: 7_7:3523
msgctxt "text_id=9926 | speaker=unknown"
msgid "  But something gave him a moment's pause."
msgstr "　ただ、その前に。"

#. Occurrence 7_7:3530:9927: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0042; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3530
msgctxt "text_id=9927 | speaker=soujuurou"
msgid "\"It's not nice to spy on people.\""
msgstr "「じっさい、覗き見は趣味が悪いと思う」"

#. Occurrence 7_7:3536:9928: scene=7_7
#: 7_7:3536
msgctxt "text_id=9928 | speaker=unknown"
msgid "  He complained aloud to make sure a certain someone heard him."
msgstr "　誰かに告げるように、そんな文句を呟いた。"

#. Occurrence 7_8:49:9929: scene=7_8
#: 7_8:49
msgctxt "text_id=9929 | speaker=unknown"
msgid "  No more than two minutes had passed since Soujyuro left the mansion when a long-haired figure came creeping into the foyer."
msgstr "　草十郎が洋館を後にしてから二分ほど経った後、足音を忍ばせて、長い髪の人影がロビーに入ってきた。"

#. Occurrence 7_8:54:9930: scene=7_8
#: 7_8:54
msgctxt "text_id=9930 | speaker=unknown"
msgid "  Aoko Aozaki had been just outside the entire time, eavesdropping."
msgstr "　今まで外から様子を<窺|うかが>っていた、蒼崎青子その人である。"

#. Occurrence 7_8:86:9931: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0000; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:86
msgctxt "text_id=9931 | speaker=alice"
msgid "\"...When did you get home?\""
msgstr "「……帰ってたの？」"

#. Occurrence 7_8:104:9932: scene=7_8
#: 7_8:104
msgctxt "text_id=9932 | speaker=unknown"
msgid "  With a sullen glare, Alice addressed the interloper."
msgstr "　むっとした目付きで、有珠は青子に語りかけた。"

#. Occurrence 7_8:109:9933: scene=7_8
#: 7_8:109
msgctxt "text_id=9933 | speaker=unknown"
msgid "  Aoko was shivering from head to toe after standing in the cold for so long."
msgstr "　どれほど外に居たのか、青子の体は寒さで震えている。"

#. Occurrence 7_8:114:9934: scene=7_8
#: 7_8:114
msgctxt "text_id=9934 | speaker=unknown"
msgid "  She deemed gloves an abomination and refused to wear them except in the most extreme cold. As a result, her slender fingers were pitifully swollen and red."
msgstr "　手袋は悪、と公言している青子は、よほどの寒さでなければ手袋はつけない。それが災いして、長い指が哀れなほど赤くなっていた。"

#. Occurrence 7_8:150:9935: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0000; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:150
msgctxt "text_id=9935 | speaker=aoko"
msgid "\"Don't know, a while ago. Anyway, how did it go? You two were talking for so long...\""
msgstr "「ちょっと前にね。それでどうだったの有珠？　ずいぶんと話してたみたいだけど」"

#. Occurrence 7_8:156:9936: scene=7_8
#: 7_8:156
msgctxt "text_id=9936 | speaker=unknown"
msgid "  She looked strangely elated, as she blew on her hands to warm them."
msgstr "　吐息で両手を温めながら、青子はどこか楽しそうに問いただす。"

#. Occurrence 7_8:192:9937: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0001; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:192
msgctxt "text_id=9937 | speaker=alice"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 7_8:197:9938: scene=7_8
#: 7_8:197
msgctxt "text_id=9938 | speaker=unknown"
msgid "  Alice was not fooled at all by Aoko's facade, clear from the ill-tempered look she wore on her face."
msgstr "　その意地の悪い顔で、有珠は事の<絡繰|からくり>を読み取った。"

#. Occurrence 7_8:224:9939: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0002; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:224
msgctxt "text_id=9939 | speaker=alice"
msgid "\"...I never expected you to be so overprotective."
msgstr "「……貴女がここまで過保護とは思わなかったわ。"

#. Occurrence 7_8:230:9940: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0003; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:230
msgctxt "text_id=9940 | speaker=alice"
msgid "  But did you do it out of stubbornness, or obligation?\""
msgstr "　意地？　それとも義務？」"

#. Occurrence 7_8:249:9941: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0001; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:249
msgctxt "text_id=9941 | speaker=aoko"
msgid "\"Oh, please, I was just going with the flow."
msgstr "「どっちかっていうと成り行きね。"

#. Occurrence 7_8:255:9942: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0002; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:255
msgctxt "text_id=9942 | speaker=aoko"
msgid "  But seriously, how did it go? You told me you'd resort to force if he made you mad.\""
msgstr "　で、どうだったのよ結果は。気にくわなかったら実力行使に出るって言ってたじゃない」"

#. Occurrence 7_8:300:9943: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0004; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:300
msgctxt "text_id=9943 | speaker=alice"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 7_8:305:9944: scene=7_8
#: 7_8:305
msgctxt "text_id=9944 | speaker=unknown"
msgid "  Alice's mood was growing darker and darker the longer she had to look at Aoko's cheerful posturing."
msgstr "　上機嫌な青子を前に、有珠はますます面持ちを暗くしていく。"

#. Occurrence 7_8:338:9945: scene=7_8
#: 7_8:338
msgctxt "text_id=9945 | speaker=unknown"
msgid "  It all went back to their dinner together the previous night."
msgstr "　話は昨日の夕食までさかのぼる。"

#. Occurrence 7_8:343:9946: scene=7_8
#: 7_8:343
msgctxt "text_id=9946 | speaker=unknown"
msgid "  After everything that happened in the foyer, Alice was both more suspicious of and intrigued by Soujyuro than ever before. She insisted that Aoko let him walk home alone the next day."
msgstr "　ロビーでの一件で草十郎への不信感、および関心がメーターを振り切ったのか、有珠は“明日も彼をひとりで帰して”と青子に強要した。"

#. Occurrence 7_8:363:9947: scene=7_8
#: 7_8:363
msgctxt "text_id=9947 | speaker=unknown"
msgid "  She then used a concoction to fake her slumber and recreate the same scene as the previous day."
msgstr "　今日の眠りは薬による擬似的なもので、意図的に昨日の状況を再現したものである。"

#. Occurrence 7_8:368:9948: scene=7_8
#: 7_8:368
msgctxt "text_id=9948 | speaker=unknown"
msgid "  That portion of her plan went well, but the rest had veered totally off course. It did not help to know her roommate had savored every moment of it from the other side of the wall, either."
msgstr "　状況はうまくいったが結果は彼女の予想から外れ、また、お節介な同居人が壁越しに手に汗握っていた、というのも面白くない。"

#. Occurrence 7_8:373:9949: scene=7_8
#: 7_8:373
msgctxt "text_id=9949 | speaker=unknown"
msgid "  To make matters worse, Alice was frustrated at herself for letting such trivial matters bother her."
msgstr "　さらに付け足すのなら、そんなどうでもいい事に腹を立てている自分にも呆れてしまう有珠だった。"

#. Occurrence 7_8:403:9950: scene=7_8
#: 7_8:403
msgctxt "text_id=9950 | speaker=unknown"
msgid "  She stared at the teacup still sitting on the floor."
msgstr "　床に置かれたティーカップを見つめる有珠。"

#. Occurrence 7_8:408:9951: scene=7_8
#: 7_8:408
msgctxt "text_id=9951 | speaker=unknown"
msgid "  Her pale finger traced its cold rim."
msgstr "　その白い指が冷えたカップの<縁|ふち>をなぞっていく。"

#. Occurrence 7_8:425:9952: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0005; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:425
msgctxt "text_id=9952 | speaker=alice"
msgid "\"It's as you said. He is harmless."
msgstr "「……青子の言う通り、害にはならない人ね。"

#. Occurrence 7_8:431:9953: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0006; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:431
msgctxt "text_id=9953 | speaker=alice"
msgid "  ...For the time being.\""
msgstr "　あくまで、今のところの話だけど」"

#. Occurrence 7_8:436:9954: scene=7_8
#: 7_8:436
msgctxt "text_id=9954 | speaker=unknown"
msgid "  She forced a tone of indifference in order to hide her irritation with her apprentice."
msgstr "　青子に内心の苛立ちを見せないよう、有珠は冷淡な感想を述べた。"

#. Occurrence 7_8:441:9955: scene=7_8
#: 7_8:441
msgctxt "text_id=9955 | speaker=unknown"
msgid "  It was in this moment that Soujyuro's fate was decided."
msgstr "　その時点で、もう結論は出ているようなものだが。"

#. Occurrence 7_8:476:9956: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0003; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:476
msgctxt "text_id=9956 | speaker=aoko"
msgid "\"That's it? You were talking for what seemed like forever.\""
msgstr "「あら、それだけ？　有珠にしては長く話してたのに」"

#. Occurrence 7_8:481:9957: scene=7_8
#: 7_8:481
msgctxt "text_id=9957 | speaker=unknown"
msgid "  Relentless, Aoko continued her line of questioning."
msgstr "　白状しろ、とばかりに青子はしつこく繰り返す。"

#. Occurrence 7_8:486:9958: scene=7_8
#: 7_8:486
msgctxt "text_id=9958 | speaker=unknown"
msgid "  Alice only stared back icily."
msgstr "　有珠はそんな同居人を冷徹に見据えると、"

#. Occurrence 7_8:507:9959: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0007; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:507
msgctxt "text_id=9959 | speaker=alice"
msgid "\"Aoko, I know you were eavesdropping.\""
msgstr "「青子。貴女、隠していたわね」"

#. Occurrence 7_8:512:9960: scene=7_8
#: 7_8:512
msgctxt "text_id=9960 | speaker=unknown"
msgid "  She voiced her displeasure at Aoko's behavior in no uncertain terms."
msgstr "　敵意すらこめて、彼女の不義を糾弾した。"

#. Occurrence 7_8:549:9961: scene=7_8
#: 7_8:549
msgctxt "text_id=9961 | speaker=unknown"
msgid "  Suddenly the air in the foyer felt cold as ice."
msgstr "　ロビーの空気が凍る。"

#. Occurrence 7_8:554:9962: scene=7_8
#: 7_8:554
msgctxt "text_id=9962 | speaker=unknown"
msgid "  They stared at one another, each trying to guess the other's next move."
msgstr "　ふたりの少女は相手の出方を探るように見つめ合った。"

#. Occurrence 7_8:591:9963: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0004; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:591
msgctxt "text_id=9963 | speaker=aoko"
msgid "\"...So you did notice. This... doesn't change anything about our deal. I hope that's clear.\""
msgstr "「…………流石ね。よくそこに気が付いたもんだわ。でも、こればかりは譲れないのよ」"

#. Occurrence 7_8:597:9964: scene=7_8
#: 7_8:597
msgctxt "text_id=9964 | speaker=unknown"
msgid "  Aoko widened her stance and glared at Alice."
msgstr "　じり、と腰を落として有珠を睨む青子。"

#. Occurrence 7_8:631:9965: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0008; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:631
msgctxt "text_id=9965 | speaker=alice"
msgid "\"I'm a reasonable person, Aoko. It's fine with me if you take thirty percent.\""
msgstr "「なにも全て奪うとは言っていないわ。……そうね。貴女にも三割ぐらいは回すつもり」"

#. Occurrence 7_8:637:9966: scene=7_8
#: 7_8:637
msgctxt "text_id=9966 | speaker=unknown"
msgid "  Completely unperturbed by Aoko's warlike posturing, a simple look was all Alice needed to keep her roommate in check."
msgstr "　戦闘態勢に入った青子に動じず、有珠は視線だけで青子を牽制する。"

#. Occurrence 7_8:676:9967: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0005; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:676
msgctxt "text_id=9967 | speaker=aoko"
msgid "\"Down from all of it? Hah! Not a chance.\""
msgstr "「ふん。十が三に化けちゃあ、ちょっと黙ってらんないわね」"

#. Occurrence 7_8:697:9968: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0009; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:697
msgctxt "text_id=9968 | speaker=alice"
msgid "\"Fly too high and you may lose those wings, Aoko.\""
msgstr "「高望みは命取りよ、青子」"

#. Occurrence 7_8:703:9969: scene=7_8
#: 7_8:703
msgctxt "text_id=9969 | speaker=unknown"
msgid "  Alice remained calm and dignified, not moving a muscle."
msgstr "　凛とした姿勢のままで有珠は動かない。"

#. Occurrence 7_8:746:9970: scene=7_8
#: 7_8:746
msgctxt "text_id=9970 | speaker=unknown"
msgid "  It felt like hours passed as the two stared at each other in silence."
msgstr "　そうして無言のまま、両者は長いこと見つめ合った。"

#. Occurrence 7_8:751:9971: scene=7_8
#: 7_8:751
msgctxt "text_id=9971 | speaker=unknown"
msgid "  Aoko was grinding her teeth in frustration."
msgstr "　ぎり、と悔しげに歯を鳴らす青子。"

#. Occurrence 7_8:759:9972: scene=7_8
#: 7_8:759
msgctxt "text_id=9972 | speaker=unknown"
msgid "  At this rate, their alliance would be in tatters before they even confronted their foe."
msgstr "　このままでは外敵との対決を前にして、仲間割れという形で幕は下りかねない。"

#. Occurrence 7_8:791:9973: scene=7_8
#: 7_8:791
msgctxt "text_id=9973 | speaker=unknown"
msgid "  And worst of all,"
msgstr "　……加えて。"

#. Occurrence 7_8:796:9974: scene=7_8
#: 7_8:796
msgctxt "text_id=9974 | speaker=unknown"
msgid "  she knew Alice had the upper hand."
msgstr "　どう考えても、分が悪いのは自分だった。"

#. Occurrence 7_8:840:9975: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0006; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:840
msgctxt "text_id=9975 | speaker=aoko"
msgid "\"...Cheapskate.\""
msgstr "「…………けち」"

#. Occurrence 7_8:845:9976: scene=7_8
#: 7_8:845
msgctxt "text_id=9976 | speaker=unknown"
msgid "  Aoko accepted her defeat with a \"tsk.\""
msgstr "　青子はちっ、と舌打ちして敗北を認める。"

#. Occurrence 7_8:875:9977: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0007; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:875
msgctxt "text_id=9977 | speaker=aoko"
msgid "\"Fine. You get sixty, I get forty.\""
msgstr "「悔しいけど有珠が六、私が四で手を打つわ」"

#. Occurrence 7_8:881:9978: scene=7_8
#: 7_8:881
msgctxt "text_id=9978 | speaker=unknown"
msgid "  It pained her to settle for less. Alice nodded in satisfaction."
msgstr "　無念げに妥協する青子と、満足げにうなずく有珠。"

#. Occurrence 7_8:916:9979: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0010; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:916
msgctxt "text_id=9979 | speaker=alice"
msgid "\"Very well. But I'm the head of the house, and you're the one who brought him here, so it's your job to collect rent.\""
msgstr "「そうね。<家主|やぬし>はわたしだけど、彼を招いたのは青子だから。そのかわり、<家賃|やちん>の取り立ては貴女の役割ね」"

#. Occurrence 7_8:935:9980: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0008; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:935
msgctxt "text_id=9980 | speaker=aoko"
msgid "\"Fine. Ugh, this sucks. I should've gone into alchemy instead, then all my problems would be solved.\""
msgstr "「……いいけど。あーあ、情けない。こんな事なら錬金術でもかじっておくんだった。そうすれば、こんな思いをしなくてもすんだのに」"

#. Occurrence 7_8:941:9981: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0011; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:941
msgctxt "text_id=9981 | speaker=alice"
msgid "\"Not really. Not even alchemists are immune to market downturns.\""
msgstr "「そうでもないわ。彼ら、バブルが弾けて大変だって話よ」"

#. Occurrence 7_8:969:9982: scene=7_8
#: 7_8:969
msgctxt "text_id=9982 | speaker=unknown"
msgid "  Alice spoke with the confidence of someone with first-hand experience of such matters, yet Aoko only nodded absentmindedly in response."
msgstr "　妙に実感のこもった有珠の言葉に、青子ははいはいと空返事をする。"

#. Occurrence 7_8:974:9983: scene=7_8
#: 7_8:974
msgctxt "text_id=9983 | speaker=unknown"
msgid "  Their bitter fight was over how to split the take of Soujyuro's rent now that he was officially going to move in."
msgstr "　ふたりは草十郎を住まわせた後の、彼が支払う家賃の取り分を真剣に議論していたのだ。"

#. Occurrence 7_8:980:9984: scene=7_8
#: 7_8:980
msgctxt "text_id=9984 | speaker=unknown"
msgid "  Not the most becoming quarrel for a pair of mages."
msgstr "　魔術師にあるまじき口論である。"

#. Occurrence 7_8:985:9985: scene=7_8
#: 7_8:985
msgctxt "text_id=9985 | speaker=unknown"
msgid "  Forcing a boy to live with them and then demanding he pay rent was beyond extortion-it was truly vicious."
msgstr "　無理やり同居を強制しておいて家賃を取るあたり、詐欺を通り越してもはや暴力と言っていいレベル。"

#. Occurrence 7_8:1018:9986: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0009; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:1018
msgctxt "text_id=9986 | speaker=aoko"
msgid "\"Since we're even discussing this, I assume that means you've accepted his presence in the mansion?\""
msgstr "「でも、そんな台詞が出るって事は有珠もようやく認めたってコトね」"

#. Occurrence 7_8:1023:9987: scene=7_8
#: 7_8:1023
msgctxt "text_id=9987 | speaker=unknown"
msgid "  Aoko was triumphantly satisfied with herself."
msgstr "　よしよし、と満足する青子。"

#. Occurrence 7_8:1040:9988: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0012; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:1040
msgctxt "text_id=9988 | speaker=alice"
msgid "\"The only thing I've accepted is my responsibility for not catching him with the Bounded Field in the park that night."
msgstr "「……認めてはいないけど、公園での夜、彼を結界で捕捉しなかった責任があるから。"

#. Occurrence 7_8:1046:9989: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0013; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:1046
msgctxt "text_id=9989 | speaker=alice"
msgid "  I mean, it's not as if I can blame it all on you and your promise to him.\""
msgstr "　彼と約束をした青子だけを責められないでしょう」"

#. Occurrence 7_8:1081:9990: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0010; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:1081
msgctxt "text_id=9990 | speaker=aoko"
msgid "\"...Oh, *that* promise.\""
msgstr "「……約束、か」"

#. Occurrence 7_8:1087:9991: scene=7_8
#: 7_8:1087
msgctxt "text_id=9991 | speaker=unknown"
msgid "  Aoko looked up at the ceiling as she recalled the night at the amusement park."
msgstr "　遊園地の夜を思い出すように、青子は天井を見上げた。"

#. Occurrence 7_8:1092:9992: scene=7_8
#: 7_8:1092
msgctxt "text_id=9992 | speaker=unknown"
msgid "  Only a week at most had passed since then, but Aoko already felt that Soujyuro's fate and her own had become intrinsically linked."
msgstr "　たかだか一週間ほど前の出来事なのに、あれから随分と草十郎との縁が強くなった気がする。"

#. Occurrence 7_8:1097:9993: scene=7_8
#: 7_8:1097
msgctxt "text_id=9993 | speaker=unknown"
msgid "  Or perhaps they had always been connected by fate since the moment they'd met."
msgstr "　それとも、初めて会ったあの時から縁は強いものだったのだろうか。"

#. Occurrence 7_8:1102:9994: scene=7_8
#: 7_8:1102
msgctxt "text_id=9994 | speaker=unknown"
msgid "  She could not see into the future, so there was no way to know for sure."
msgstr "　未来視ではない青子には、とうてい預かり知らぬコトではあるが。"

#. Occurrence 7_8:1136:9995: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0011; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:1136
msgctxt "text_id=9995 | speaker=aoko"
msgid "\"Destiny and fate aside,"
msgstr "「ま、縁とか運とかはともかく。"

#. Occurrence 7_8:1142:9996: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0012; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:1142
msgctxt "text_id=9996 | speaker=aoko"
msgid "  he's not a bad egg. Besides being weird, I mean.\""
msgstr "　変だけどいい奴よね、あいつ」"

#. Occurrence 7_8:1148:9997: scene=7_8
#: 7_8:1148
msgctxt "text_id=9997 | speaker=unknown"
msgid "  A thought uttered to herself in self-confirmation more than to Alice."
msgstr "　有珠に同意を求めるワケでもなく呟く青子。"

#. Occurrence 7_8:1167:9998: scene=7_8
#: 7_8:1167
msgctxt "text_id=9998 | speaker=unknown"
msgid "  Alice could only look on in annoyance."
msgstr "　それを有珠は不機嫌そうに眺める。"

#. Occurrence 7_8:1172:9999: scene=7_8
#: 7_8:1172
msgctxt "text_id=9999 | speaker=unknown"
msgid "  Perhaps in an attempt to voice her displeasure at her comment."
msgstr "　なにか、今の台詞が気に入らなかったのかも知れない。"

#. Occurrence 7_8:1199:10000: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0014; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:1199
msgctxt "text_id=10000 | speaker=alice"
msgid "\"Do you know about his injury, Aoko?\""
msgstr "「青子、あの傷を知ってる？」"

#. Occurrence 7_8:1205:10001: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0013; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:1205
msgctxt "text_id=10001 | speaker=aoko"
msgid "\"Injury? What injury?\""
msgstr "「傷……？」"

#. Occurrence 7_8:1217:10002: scene=7_8
#: 7_8:1217
msgctxt "text_id=10002 | speaker=unknown"
msgid "  Alice raised her slender fingers to her mouth as if to push the words back in."
msgstr "　思わず口にでた声を、有珠は細い指で押し止めた。"

#. Occurrence 7_8:1222:10003: scene=7_8
#: 7_8:1222
msgctxt "text_id=10003 | speaker=unknown"
msgid "  She had blurted it out in the heat of the moment."
msgstr "　感情的に出てしまった質問。"

#. Occurrence 7_8:1227:10004: scene=7_8
#: 7_8:1227
msgctxt "text_id=10004 | speaker=unknown"
msgid "  A secret that no one else was supposed to know, but that which one couldn't keep to herself."
msgstr "　人に話す事ではないと分かっていたのに訊かずには―――知らさずにはいられなかった、自分しか知らない秘密。"

#. Occurrence 7_8:1261:10005: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0014; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:1261
msgctxt "text_id=10005 | speaker=aoko"
msgid "\"?\""
msgstr "「？？」"

#. Occurrence 7_8:1266:10006: scene=7_8
#: 7_8:1266
msgctxt "text_id=10006 | speaker=unknown"
msgid "  Aoko tilted her head in confusion."
msgstr "　有珠の問いに首を傾げる青子。"

#. Occurrence 7_8:1286:10007: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0015; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:1286
msgctxt "text_id=10007 | speaker=alice"
msgid "\"...I see.\""
msgstr "「―――そう」"

#. Occurrence 7_8:1291:10008: scene=7_8
#: 7_8:1291
msgctxt "text_id=10008 | speaker=unknown"
msgid "  Alice looked relieved for some reason."
msgstr "　なぜか胸を撫でおろす。"

#. Occurrence 7_8:1296:10009: scene=7_8
#: 7_8:1296
msgctxt "text_id=10009 | speaker=unknown"
msgid "  Her sudden antipathy towards Aoko had dissipated as well."
msgstr "　青子に感じた突発的な反感も、それで晴れてくれたようだ。"

#. Occurrence 7_8:1330:10010: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0016; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:1330
msgctxt "text_id=10010 | speaker=alice"
msgid "\"Ignorance is bliss, I suppose.\""
msgstr "「―――<倖|しあわ>せな人」"

#. Occurrence 7_8:1336:10011: scene=7_8
#: 7_8:1336
msgctxt "text_id=10011 | speaker=unknown"
msgid "  Said Alice, as she took a sip of her cold tea."
msgstr "　そうして。"

#. Occurrence 7_8:1341:10012: scene=7_8
#: 7_8:1341
msgctxt "text_id=10012 | speaker=unknown"
msgid "  She made no attempt to explain who was fortunate, or why."
msgstr "　誰がどう倖せなのか口にせず、有珠は冷めきった紅茶を口にした。"

#. Occurrence 7_8:1359:10013: scene=7_8
#: 7_8:1359
msgctxt "text_id=10013 | speaker=unknown"
msgid "  A moment later, her beautiful face contorted in revulsion."
msgstr "　とたん、その可憐な顔が苦々しい<貌|かお>を作る。"

#. Occurrence 7_8:1391:10014: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0017; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:1391
msgctxt "text_id=10014 | speaker=alice"
msgid "\"...Yuck.\""
msgstr "「……まずい」"

#. Occurrence 7_8:1402:10015: scene=7_8
#: 7_8:1402
msgctxt "text_id=10015 | speaker=unknown"
msgid "  She abandoned the cup to the floor once more."
msgstr "　無情にも床に放置されるカップ。"

#. Occurrence 7_8:1408:10016: scene=7_8
#: 7_8:1408
msgctxt "text_id=10016 | speaker=unknown"
msgid "  Her black dress unceremoniously scrunched up as she stood."
msgstr "　少女の黒衣がおごそかに揺れる。"

#. Occurrence 7_8:1413:10017: scene=7_8
#: 7_8:1413
msgctxt "text_id=10017 | speaker=unknown"
msgid "  Just one sip of the under-brewed tea sent her fleeing to the drawing room to remove the bad taste from her mouth."
msgstr "　未熟な紅茶を一口だけ飲んだ有珠は、口直しとばかりに居間へと歩いていってしまった。"

#. Occurrence 7_8:1445:10018: scene=7_8
#: 7_8:1445
msgctxt "text_id=10018 | speaker=unknown"
msgid "  As soon as she was gone Aoko hesitatingly took the teacup in her own hands."
msgstr "　それを見送った後、ためらいながらも青子は残されたティーカップを手に取った。"

#. Occurrence 7_8:1450:10019: scene=7_8
#: 7_8:1450
msgctxt "text_id=10019 | speaker=unknown"
msgid "  It was almost certainly better left untasted, but she could not help but wonder how Soujyuro's tea could arouse such a strong response."
msgstr "　よせばいいのに、有珠の酷評を受けた草十郎のお茶を飲む気になったのだ。"

#. Occurrence 7_8:1461:10020: scene=7_8
#: 7_8:1461
msgctxt "text_id=10020 | speaker=unknown"
msgid "  After one small sip she returned it quietly to the floor."
msgstr "　くいと一口に試した後、青子も静かにカップを戻す。"

#. Occurrence 7_8:1502:10021: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0015; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:1502
msgctxt "text_id=10021 | speaker=aoko"
msgid "\"Yep, he should have used the tea bags like I told him to. Dummy.\""
msgstr "「……だからティーバッグにしろって言ったのに、あの莫迦」"

#. Occurrence 7_8:1508:10022: scene=7_8
#: 7_8:1508
msgctxt "text_id=10022 | speaker=unknown"
msgid "  The expression on her face was nearly identical to that of her roommate's."
msgstr "　有珠と同じ、苦いような困ったような顔をして、青子はそう呟いた。"

#. Occurrence 7_EX:97:10023: scene=7_EX
#: 7_EX:97
msgctxt "text_id=10023 | speaker=unknown"
msgid "  Walking around the mansion at night often led to mysterious encounters."
msgstr "　夜中、洋館を歩いていると不思議なコトに遭遇する。"

#. Occurrence 7_EX:131:10024: scene=7_EX
#: 7_EX:131
msgctxt "text_id=10024 | speaker=unknown"
msgid "  Mist might suddenly fill the hallway,"
msgstr "　館内にただよう霧や、"

#. Occurrence 7_EX:171:10025: scene=7_EX
#: 7_EX:171
msgctxt "text_id=10025 | speaker=unknown"
msgid "  or doors might appear and disappear."
msgstr "　増えたり減ったりするドア。"

#. Occurrence 7_EX:210:10026: scene=7_EX
#: 7_EX:210
msgctxt "text_id=10026 | speaker=unknown"
msgid "  Just when Soujyuro thought he had seen it all with pig-shaped shadows mending the carpet,"
msgstr "　絨毯の手入れをする子豚っぽい影を見たかと思えば、このように、"

#. Occurrence 7_EX:236:10027: scene=7_EX
#: 7_EX:236
msgctxt "text_id=10027 | speaker=unknown"
msgid "  he heard the sound of a bird's flapping coming from the sunroom."
msgstr "　サンルームに向かってはかき消える、鳥たちの羽音を聞いたりもする。"

#. Occurrence 7_EX:285:10028: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0000; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:285
msgctxt "text_id=10028 | speaker=soujuurou"
msgid "\"What's going on over there?!\""
msgstr "「なにごと……！？」"

#. Occurrence 7_EX:294:10029: scene=7_EX
#: 7_EX:294
msgctxt "text_id=10029 | speaker=unknown"
msgid "  As much as he had become accustomed to turning a blind eye to such occurrences, the sound of flapping wings in the sunroom was too much to ignore."
msgstr "　たいていの事は見ざる聞かざるな草十郎も、今の羽音は聞き過ごせなかった。"

#. Occurrence 7_EX:315:10030: scene=7_EX
#: 7_EX:315
msgctxt "text_id=10030 | speaker=unknown"
msgid "  And not just one bird, or even two, it sounded like dozens."
msgstr "　一羽や二羽の話ではないのだ。"

#. Occurrence 7_EX:320:10031: scene=7_EX
#: 7_EX:320
msgctxt "text_id=10031 | speaker=unknown"
msgid "  So many birds packed in the sunroom would inevitably lead to shattered windows and broken glass."
msgstr "　十羽単位の鳥がサンルームに突撃したとすれば、窓ガラスとて無事では済むまい。"

#. Occurrence 7_EX:337:10032: scene=7_EX
#: 7_EX:337
msgctxt "text_id=10032 | speaker=unknown"
msgid "  Soujyuro grabbed a broom and dashed toward the sound, prepared for the worst."
msgstr "　いてもたってもいられず、草十郎はちり取りと<箒|ほうき>を手にして走りだした。"

#. Occurrence 7_EX:342:10033: scene=7_EX
#: 7_EX:342
msgctxt "text_id=10033 | speaker=unknown"
msgid "  Perhaps he was moved by his natural impulse to help, or desperate self-defense."
msgstr "　生来の小姑根性か、せいいっぱいの自己防衛か。"

#. Occurrence 7_EX:347:10034: scene=7_EX
#: 7_EX:347
msgctxt "text_id=10034 | speaker=unknown"
msgid "  His mind flashed to what a teacher had said at school."
msgstr "　今日の授業でたまたま、"

#. Occurrence 7_EX:380:10035: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_EX_0000; voice_prefix=B60; voice_category=7; scene=7_EX
#: 7_EX:380
msgctxt "text_id=10035 | speaker=yamashiro"
msgid "\"You should all make sure to keep your rooms orderly and clean. Work ethic and self-discipline will have a positive impact on your surroundings."
msgstr "「皆さんも部屋の整頓は心がけてくださいね。人間の自制心って環境に流されるらしいですから。"

#. Occurrence 7_EX:387:10036: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_EX_0001; voice_prefix=B60; voice_category=7; scene=7_EX
#: 7_EX:387
msgctxt "text_id=10036 | speaker=yamashiro"
msgid "Think about it. Even in a nice neighborhood where there isn't much crime, it only takes one ill-kept house to send the whole block into a spiral of depravity."
msgstr "ほら、それまで犯罪の少ない街だったのに、一つボロボロの家が出来ただけで近隣住人がみーんな自堕落になるというアレ。"

#. Occurrence 7_EX:393:10037: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_EX_0002; voice_prefix=B60; voice_category=7; scene=7_EX
#: 7_EX:393
msgctxt "text_id=10037 | speaker=yamashiro"
msgid "  Of course, we all know a messy room won't turn you into a criminal. But I'd better not catch any of you breaking windows in the hallway or going for a joy ride on stolen motorcycles. Think of all the pain you'd be causing your poor teacher!\""
msgstr "　環境への無関心さがすさんだ精神を作り上げるとか眉唾ですけど、正直なところ、ブームだからって盗んだバイクで走り回ったり、学校の廊下の窓ガラスとか割ってまわっちゃダメですよ。先生の仕事が増えますから」"

#. Occurrence 7_EX:433:10038: scene=7_EX
#: 7_EX:433
msgctxt "text_id=10038 | speaker=unknown"
msgid "  At the time, school gangs had garnered a certain reputation among the youths."
msgstr "　時に、校内暴力がある種の若者にとってステータスになっていた時代の話である。"

#. Occurrence 7_EX:473:10039: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0001; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:473
msgctxt "text_id=10039 | speaker=soujuurou"
msgid "\"Broken windows lead to broken hearts.\""
msgstr "「窓が割れると、心が荒れる」"

#. Occurrence 7_EX:479:10040: scene=7_EX
#: 7_EX:479
msgctxt "text_id=10040 | speaker=unknown"
msgid "  Soujyuro appreciated the basic message of the lecture as he ruminated over it."
msgstr "　草十郎はなるほど、と今日聞いた話を<反芻|はんすう>する。"

#. Occurrence 7_EX:484:10041: scene=7_EX
#: 7_EX:484
msgctxt "text_id=10041 | speaker=unknown"
msgid "  The thought of broken windows had given him a sense of urgency, as if the mansion's very moral foundations were at stake."
msgstr "　割れ窓理論を聞いていた彼にとって、洋館内のモラル低下は放っておけない。"

#. Occurrence 7_EX:529:10042: scene=7_EX
#: 7_EX:529
msgctxt "text_id=10042 | speaker=unknown"
msgid "  His roommates were harsh enough with him already; anything further would only lead to rampant rumors at school about their cruelty."
msgstr "　……同居人は<既|すで>にして十分なほど凶暴だが、これ以上<横暴|おうぼう>さが増しては、なにより本人の為にならない。また学校でよからぬ噂が流れてしまう。"

#. Occurrence 7_EX:547:10043: scene=7_EX
#: 7_EX:547
msgctxt "text_id=10043 | speaker=unknown"
msgid "  He had to protect the honor of the student council president."
msgstr "　我らが生徒会長の名誉を守る為。"

#. Occurrence 7_EX:552:10044: scene=7_EX
#: 7_EX:552
msgctxt "text_id=10044 | speaker=unknown"
msgid "  It was also concern for his own safety that sent him rushing to the sunroom. However..."
msgstr "　ひいては実害から自分の身を守る為、草十郎はサンルームの掃除に向かったのだが―――"

#. Occurrence 7_EX:621:10045: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0002; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:621
msgctxt "text_id=10045 | speaker=soujuurou"
msgid "\"Huh?\""
msgstr "「む？」"

#. Occurrence 7_EX:628:10046: scene=7_EX
#: 7_EX:628
msgctxt "text_id=10046 | speaker=unknown"
msgid "  There wasn't a bird to be seen or a chirp to be heard upon his arrival."
msgstr "　この通り、サンルームには鳥の姿はおろか、鳴き声さえ有りはしなかった。"

#. Occurrence 7_EX:666:10047: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_EX_0000; voice_prefix=A10; voice_category=1; scene=7_EX
#: 7_EX:666
msgctxt "text_id=10047 | speaker=aoko"
msgid "\"Oh, hey.\""
msgstr "「あら」"

#. Occurrence 7_EX:685:10048: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_EX_0000; voice_prefix=A40; voice_category=2; scene=7_EX
#: 7_EX:685
msgctxt "text_id=10048 | speaker=alice"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 7_EX:706:10049: scene=7_EX
#: 7_EX:706
msgctxt "text_id=10049 | speaker=unknown"
msgid "  Only Alice and Aoko, sipping afternoon tea at the table that overlooked the courtyard, were present."
msgstr "　中庭を<臨|のぞ>むテーブルには、午後のお茶を<愉|たの>しむ蒼崎青子と久遠寺有珠の姿のみ。"

#. Occurrence 7_EX:711:10050: scene=7_EX
#: 7_EX:711
msgctxt "text_id=10050 | speaker=unknown"
msgid "  The dozens of birds Soujyuro had sensed with his mountain intuition were nowhere to be seen."
msgstr "　草十郎ソナー探知で十八羽は居たであろう鳥の気配はどこにもない。"

#. Occurrence 7_EX:753:10051: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0003; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:753
msgctxt "text_id=10051 | speaker=soujuurou"
msgid "\"Did anyone see a flock of birds?!\""
msgstr "「いまここに鳥がこなかった！？」"

#. Occurrence 7_EX:789:10052: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_EX_0001; voice_prefix=A10; voice_category=1; scene=7_EX
#: 7_EX:789
msgctxt "text_id=10052 | speaker=aoko"
msgid "\"Alice?\""
msgstr "「有珠、見た？」"

#. Occurrence 7_EX:801:10053: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_EX_0001; voice_prefix=A40; voice_category=2; scene=7_EX
#: 7_EX:801
msgctxt "text_id=10053 | speaker=alice"
msgid "\"Who knows. If can't see them, there must not be any birds.\""
msgstr "「さあ。もう見えないのなら、いないという事でしょう」"

#. Occurrence 7_EX:813:10054: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_EX_0002; voice_prefix=A10; voice_category=1; scene=7_EX
#: 7_EX:813
msgctxt "text_id=10054 | speaker=aoko"
msgid "\"You heard her; no birds.\""
msgstr "「だって。いないよ、鳥」"

#. Occurrence 7_EX:848:10055: scene=7_EX
#: 7_EX:848
msgctxt "text_id=10055 | speaker=unknown"
msgid "  It was a lie so blatant even Soujyuro could see through it."
msgstr "　草十郎ですら感じ取れる、<清々|すがすが>しいまでの嘘である。"

#. Occurrence 7_EX:885:10056: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0004; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:885
msgctxt "text_id=10056 | speaker=soujuurou"
msgid "\"That can't be true.\""
msgstr "「そんなバカな」"

#. Occurrence 7_EX:899:10057: scene=7_EX
#: 7_EX:899
msgctxt "text_id=10057 | speaker=unknown"
msgid "  He knew for a fact he had heard the flapping of a flock of birds."
msgstr "　さっきの羽音は聞き間違いではない。"

#. Occurrence 7_EX:904:10058: scene=7_EX
#: 7_EX:904
msgctxt "text_id=10058 | speaker=unknown"
msgid "  Unable to accept that there really were no wild animals in the room, Soujyuro approached the windows with suspicion."
msgstr "　こと野生動物の生態については<一家言|いっかげん>あるのか、草十郎は急ぎ足で窓まで移動し、ますます眉を<曇|くも>らせた。"

#. Occurrence 7_EX:909:10059: scene=7_EX
#: 7_EX:909
msgctxt "text_id=10059 | speaker=unknown"
msgid "  There were no feathers or any other signs of birds having been outside, either."
msgstr "　窓ガラスには鳥の跡はおろか、羽の一枚すら落ちていない。"

#. Occurrence 7_EX:962:10060: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_EX_0003; voice_prefix=A10; voice_category=1; scene=7_EX
#: 7_EX:962
msgctxt "text_id=10060 | speaker=aoko"
msgid "\"Oh right, dinner. Chicken stew, was it?\""
msgstr "「あ。夕食、<鶏|とり>鍋？」"

#. Occurrence 7_EX:976:10061: scene=7_EX
#: 7_EX:976
msgctxt "text_id=10061 | speaker=unknown"
msgid "  Of course Aoko would say something like that as she watched Soujyuro search desperately."
msgstr "　鳥を探す草十郎を見て、なぜその発想にいきつくのか。"

#. Occurrence 7_EX:1017:10062: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0005; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:1017
msgctxt "text_id=10062 | speaker=soujuurou"
msgid "\"Sorry, I'm working at the fish place tonight. But I've got you covered if you want sardines.\""
msgstr "「あいにく、今日のバイトは魚屋さんだ。<鰯|いわし>でよければ土産にするけど」"

#. Occurrence 7_EX:1039:10063: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_EX_0004; voice_prefix=A10; voice_category=1; scene=7_EX
#: 7_EX:1039
msgctxt "text_id=10063 | speaker=aoko"
msgid "\"Sardines... Sardines, huh... I don't like sardine pie..."
msgstr "「鰯……鰯か……私、あのパイ嫌いなのよね……。"

#. Occurrence 7_EX:1051:10064: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_EX_0005; voice_prefix=A10; voice_category=1; scene=7_EX
#: 7_EX:1051
msgctxt "text_id=10064 | speaker=aoko"
msgid "  Not that I've ever had it.\""
msgstr "　いえ、むしろ鰯のパイとか食べたコトないのよね……」"

#. Occurrence 7_EX:1084:10065: scene=7_EX
#: 7_EX:1084
msgctxt "text_id=10065 | speaker=unknown"
msgid "  Aoko's stand-up routine was far ahead of its time."
msgstr "　青子の<独|ひと>り芸は、この時代ではあまりに高度すぎたようだ。"

#. Occurrence 7_EX:1103:10066: scene=7_EX
#: 7_EX:1103
msgctxt "text_id=10066 | speaker=unknown"
msgid "  Soujyuro backed away from the window and begrudgingly left the sunroom,"
msgstr "　草十郎は窓ガラスから離れ、とぼとぼサンルームを後にし、"

#. Occurrence 7_EX:1127:10067: scene=7_EX
#: 7_EX:1127
msgctxt "text_id=10067 | speaker=unknown"
msgid "  feeling Alice's all-too-familiar inscrutable gaze upon his back."
msgstr "　今まで幾度とあった、有珠からのよく分からない視線を感じた。"

#. Occurrence 7_EX:1207:10068: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0006; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:1207
msgctxt "text_id=10068 | speaker=soujuurou"
msgid "\"What's up, Alice-\""
msgstr "「なんだい、<有|アリ>―――」"

#. Occurrence 7_EX:1213:10069: scene=7_EX
#: 7_EX:1213
msgctxt "text_id=10069 | speaker=unknown"
msgid "  Just as he opened his mouth to ask her what she wanted..."
msgstr "　何か聞きたい事でもあるのだろうか、と声をかけ、"

#. Occurrence 7_EX:1247:10070: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0007; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:1247
msgctxt "text_id=10070 | speaker=soujuurou"
msgid "\"Ow!\""
msgstr "「あいたっ」"

#. Occurrence 7_EX:1254:10071: scene=7_EX
#: 7_EX:1254
msgctxt "text_id=10071 | speaker=unknown"
msgid "  A blue comet crashed into his head."
msgstr "　そんな草十郎の頭部に、青い流星が直撃した。"

#. Occurrence 7_EX:1311:10072: scene=7_EX
#: 7_EX:1311
msgctxt "text_id=10072 | speaker=unknown"
msgid "  It needed no explanation."
msgstr "　流星の正体は言うまでもない。"

#. Occurrence 7_EX:1318:10073: scene=7_EX
#: 7_EX:1318
msgctxt "text_id=10073 | speaker=unknown"
msgid "  It could only be Robin, the mysterious bird that appeared frequently in the mansion."
msgstr "　洋館に出没する謎の駒鳥である。"

#. Occurrence 7_EX:1376:10074: scene=7_EX
#: 7_EX:1376
msgctxt "text_id=10074 | speaker=unknown"
msgid "  Chirp, chirp, chirp! It shrilled accusingly."
msgstr "　チチチチチチ、と甲高く駒鳥は<訴|うった>える。"

#. Occurrence 7_EX:1382:10075: scene=7_EX
#: 7_EX:1382
msgctxt "text_id=10075 | speaker=unknown"
msgid "  The truth was..."
msgstr "　……実のところ。"

#. Occurrence 7_EX:1387:10076: scene=7_EX
#: 7_EX:1387
msgctxt "text_id=10076 | speaker=unknown"
msgid "  The tiny aggressor that assaulted him just now was the greatest of the mansion's seven wonders."
msgstr "　草十郎に激突するコレこそが洋館の七不思議、その最たるものだった。"

#. Occurrence 7_EX:1547:10077: scene=7_EX
#: 7_EX:1547
msgctxt "text_id=10077 | speaker=unknown"
msgid "  Soujyuro encountered all sorts of people along his route to work."
msgstr "　アルバイトに向かう途中、多くの人々とすれ違う。"

#. Occurrence 7_EX:1554:10078: scene=7_EX
#: 7_EX:1554
msgctxt "text_id=10078 | speaker=unknown"
msgid "  Still new to city life, he found the crowds of people outside the station utterly fascinating. In fact, they were the highlight of his commute."
msgstr "　まだ都会慣れしていない草十郎にとって、駅前通りの人の流れは圧巻だ。"

#. Occurrence 7_EX:1559:10079: scene=7_EX
#: 7_EX:1559
msgctxt "text_id=10079 | speaker=unknown"
msgid "  No two people wore exactly the same clothes or walked in the same fashion."
msgstr "　誰一人として、同じ服装や歩き方の人間がいない。"

#. Occurrence 7_EX:1564:10080: scene=7_EX
#: 7_EX:1564
msgctxt "text_id=10080 | speaker=unknown"
msgid "  With so many people, you would think they would all melt into an indistinguishable huddle, but each person he saw was different and unique."
msgstr "　ここまで人が多ければ似たような外見の人間がいそうなものだが、ただの一人も<被|かぶ>っていない。"

#. Occurrence 7_EX:1569:10081: scene=7_EX
#: 7_EX:1569
msgctxt "text_id=10081 | speaker=unknown"
msgid "  Soujyuro was excited as a child as he looked out at the bustling, diverse streets of the city."
msgstr "　多種多様な街の<賑|にぎ>わいに、子供のように感心してしまう。"

#. Occurrence 7_EX:1619:10082: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0008; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:1619
msgctxt "text_id=10082 | speaker=soujuurou"
msgid "\"...Stop it.\""
msgstr "「―――いや」"

#. Occurrence 7_EX:1625:10083: scene=7_EX
#: 7_EX:1625
msgctxt "text_id=10083 | speaker=unknown"
msgid "  Closing his eyes in shame, he sighed."
msgstr "　草十郎は目を閉じて反省した。"

#. Occurrence 7_EX:1630:10084: scene=7_EX
#: 7_EX:1630
msgctxt "text_id=10084 | speaker=unknown"
msgid "  He was upset with himself for behaving like a bumbling tourist from the countryside."
msgstr "　こんな事で感心しているようじゃまだまだ田舎者だ、とため息をつく。"

#. Occurrence 7_EX:1671:10085: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0000; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:1671
msgctxt "text_id=10085 | speaker=kojika"
msgid "\"Hey, you'll get in people's way spacing out in front of the crosswalk like that. Daydream somewhere else.\""
msgstr "「ちょっと。青信号で突っ立ってられるの、邪魔なんだけど。なにガラにもなく<黄昏|たそが>れてるんだか」"

#. Occurrence 7_EX:1677:10086: scene=7_EX
#: 7_EX:1677
msgctxt "text_id=10086 | speaker=unknown"
msgid "  A stern and familiar voice behind him snapped him out of his navel-gazing."
msgstr "　と。ややセンチになっていた背中に、聞き覚えのある、刺々しい声がかけられた。"

#. Occurrence 7_EX:1736:10087: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0001; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:1736
msgctxt "text_id=10087 | speaker=kojika"
msgid "\"Let me guess. On your way to The Mad Bear?"
msgstr "「なんだ、まっどべあに行く途中だったんだ。"

#. Occurrence 7_EX:1748:10088: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0002; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:1748
msgctxt "text_id=10088 | speaker=kojika"
msgid "  My shift at the convenience store that starts at five. You?\""
msgstr "　……ふーん。わたしはコンビニのバイト。こっちは五時からだけど、静希は？」"

#. Occurrence 7_EX:1760:10089: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0009; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:1760
msgctxt "text_id=10089 | speaker=soujuurou"
msgid "\"Same. Five o'clock start. Were you on your way somewhere else?\""
msgstr "「同じく五時から。<久|く><万|ま><梨|り>はどこか寄るところでも？」"

#. Occurrence 7_EX:1787:10090: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0003; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:1787
msgctxt "text_id=10090 | speaker=kojika"
msgid "\"I just stopped by a bookstore. I'm out of stuff to read, so I thought I'd look for something new.\""
msgstr "「本屋に寄った帰り。読みたかった本がなくなってたから、仕方なく出歩いてたところよ」"

#. Occurrence 7_EX:1799:10091: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0010; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:1799
msgctxt "text_id=10091 | speaker=soujuurou"
msgid "\"I see. I guess we both have some time to spare.\""
msgstr "「なるほど。時間を持て余しているところも同じだね」"

#. Occurrence 7_EX:1850:10092: scene=7_EX
#: 7_EX:1850
msgctxt "text_id=10092 | speaker=unknown"
msgid "  The girl who greeted him was Kojika Kumari, a work friend who was also in the same year at Misaki High."
msgstr "　声をかけてきたのはバイト先の知り合いでもあり、同期生でもある<久万梨|くまり><金鹿|こじか>だった。"

#. Occurrence 7_EX:1855:10093: scene=7_EX
#: 7_EX:1855
msgctxt "text_id=10093 | speaker=unknown"
msgid "  Though, it would have been more accurate to say she was looking for a pretext to fight him rather than greet him."
msgstr "　声をかけてきた、というよりは因縁をつけてきた、という表現の方が正しいのだが。"

#. Occurrence 7_EX:1888:10094: scene=7_EX
#: 7_EX:1888
msgctxt "text_id=10094 | speaker=unknown"
msgid "  To Soujyuro, Kumari had been the first person in the city he could look up to."
msgstr "　久万梨は草十郎にとってはじめての先輩でもある。"

#. Occurrence 7_EX:1933:10095: scene=7_EX
#: 7_EX:1933
msgctxt "text_id=10095 | speaker=unknown"
msgid "  They'd met at his first job,"
msgstr "　最初のアルバイト先で知り合い、"

#. Occurrence 7_EX:1974:10096: scene=7_EX
#: 7_EX:1974
msgctxt "text_id=10096 | speaker=unknown"
msgid "  where she insisted he wasn't cut out to work the register after many mistakes, and convinced him to quit working at convenience stores altogether."
msgstr "　レジ打ちを間違え続けた事からコンビニは向いてないから辞めろと本気で軽蔑され、なぜか最後に、"

#. Occurrence 7_EX:1999:10097: scene=7_EX
#: 7_EX:1999
msgctxt "text_id=10097 | speaker=unknown"
msgid "  In the end, she introduced him to his current job at the Chinese restaurant, The Mad Bear, a much better fit for Soujyuro."
msgstr "“こっちの方が貴方に向いてる”と<中華飯店|まっどべあ>を紹介してくれた人物だ。"

#. Occurrence 7_EX:2036:10098: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0004; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2036
msgctxt "text_id=10098 | speaker=kojika"
msgid "\"You look a little worse for wear, Sizuki. Why the long face? I've never seen you so pouty."
msgstr "「なにその無理矢理な顔。なんか元気ない。いつも以上にイラっとくるわ。"

#. Occurrence 7_EX:2042:10099: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0005; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2042
msgctxt "text_id=10099 | speaker=kojika"
msgid "  Usually, standing up straight is the one thing you're good at."
msgstr "　静希のいいところなんて、いつもピシッとしている背筋ぐらいなのに、みっともなく丸まってるし。"

#. Occurrence 7_EX:2101:10100: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0006; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2101
msgctxt "text_id=10100 | speaker=kojika"
msgid "  Something on your mind? ...Wait, are you getting bullied by the older guys at The Mad Bear? You can tell me anything, you know.\""
msgstr "　もしかして悩みとかあるの？　……まっどべあに質の悪い先輩でもいるとか。それなら話ぐらいは聞いてあげるから、言ってみたら？」"

#. Occurrence 7_EX:2142:10101: scene=7_EX
#: 7_EX:2142
msgctxt "text_id=10101 | speaker=unknown"
msgid "  Though her tone was stern, her eyes were earnest."
msgstr "　態度こそ厳しいものの、久万梨の目は真剣である。"

#. Occurrence 7_EX:2147:10102: scene=7_EX
#: 7_EX:2147
msgctxt "text_id=10102 | speaker=unknown"
msgid "  Having grown up in the city herself, she was irritated by virtually everything Soujyuro said and did."
msgstr "　都会育ちの久万梨にとって、静希草十郎という人間はそのすべてが癪に障るらしい。"

#. Occurrence 7_EX:2152:10103: scene=7_EX
#: 7_EX:2152
msgctxt "text_id=10103 | speaker=unknown"
msgid "  Nevertheless, she still treated him like an equal."
msgstr "　が、それはそれとして、彼女は草十郎を対等の知人として捉えている。"

#. Occurrence 7_EX:2157:10104: scene=7_EX
#: 7_EX:2157
msgctxt "text_id=10104 | speaker=unknown"
msgid "  Introducing him to his current job was just one example of her sincerity."
msgstr "　バイト先を紹介してくれたのも、そういう彼女の生真面目さ故だった。"

#. Occurrence 7_EX:2210:10105: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0011; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2210
msgctxt "text_id=10105 | speaker=soujuurou"
msgid "\"No, nothing like that. It's just, something strange happened. Something really unusual...\""
msgstr "「いや、別に悩みとかそういうんじゃなくて。不思議なコトがあったというか、珍しいものを見たというか……」"

#. Occurrence 7_EX:2262:10106: scene=7_EX
#: 7_EX:2262
msgctxt "text_id=10106 | speaker=unknown"
msgid "  Soujyuro could not find the words to explain his situation, but that did not stop him from trying."
msgstr "　どう説明するべきか考えながら、草十郎は用件だけを口にした。"

#. Occurrence 7_EX:2267:10107: scene=7_EX
#: 7_EX:2267
msgctxt "text_id=10107 | speaker=unknown"
msgid "  There were no problems at The Mad Bear to speak of."
msgstr "　まっどべあには何の問題もない。"

#. Occurrence 7_EX:2272:10108: scene=7_EX
#: 7_EX:2272
msgctxt "text_id=10108 | speaker=unknown"
msgid "  He liked it just as much as his other job at Uotatsu, the fishmongers in the shopping district."
msgstr "　商店街の<魚達|ウオタツ>と同じぐらい好い職場だ。"

#. Occurrence 7_EX:2277:10109: scene=7_EX
#: 7_EX:2277
msgctxt "text_id=10109 | speaker=unknown"
msgid "  In fact, his problem had nothing to do with work at all."
msgstr "　そういった仕事の話とはまったく関係なく、"

#. Occurrence 7_EX:2282:10110: scene=7_EX
#: 7_EX:2282
msgctxt "text_id=10110 | speaker=unknown"
msgid "  No, his problem was a certain blue bird that would not stop pecking at him recently."
msgstr "　最近、青い鳥によくつっつかれるのだと。"

#. Occurrence 7_EX:2320:10111: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0007; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2320
msgctxt "text_id=10111 | speaker=kojika"
msgid "\"You're getting pecked? By a bird? ...Wow. And here I was thinking the world had ended."
msgstr "「鳥につっつかれる？　なにそれ、小さい悩み。"

#. Occurrence 7_EX:2326:10112: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0008; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2326
msgctxt "text_id=10112 | speaker=kojika"
msgid "  ...It is pretty unusual for a bird to be blue, I guess.\""
msgstr "　……でもまあ、青い鳥っていうのは確かに珍しいわね」"

#. Occurrence 7_EX:2332:10113: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0012; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2332
msgctxt "text_id=10113 | speaker=soujuurou"
msgid "\"And that's not the only thing unusual about it.\""
msgstr "「いや、珍しいのは外見の話じゃなくて……」"

#. Occurrence 7_EX:2338:10114: scene=7_EX
#: 7_EX:2338
msgctxt "text_id=10114 | speaker=unknown"
msgid "  He stopped, unsure of how to proceed."
msgstr "　うまく説明できず言いよどむ。"

#. Occurrence 7_EX:2380:10115: scene=7_EX
#: 7_EX:2380
msgctxt "text_id=10115 | speaker=unknown"
msgid "  Words alone were not enough to convey the bird's plump body or the sound of its chirping."
msgstr "　あの青い鳥の、でっぷりとした外見や鳴き声を、人語でどう表現したものだろうか？"

#. Occurrence 7_EX:2427:10116: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0009; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2427
msgctxt "text_id=10116 | speaker=kojika"
msgid "\"Hmm. There is a beautifully colored bird called the mountain bluebird, but they're not native to Japan."
msgstr "「……ふーん。綺麗な青色といったらマウンテンブルーバードだけど、日本にはいないわよね。"

#. Occurrence 7_EX:2433:10117: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0010; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2433
msgctxt "text_id=10117 | speaker=kojika"
msgid "  Maybe it's a blue swallow?\""
msgstr "　青いツバメだったらいるかもしれないけど」"

#. Occurrence 7_EX:2444:10118: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0013; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2444
msgctxt "text_id=10118 | speaker=soujuurou"
msgid "\"No, it's more round than a swallow. I tried to look it up in a bird book and the closest thing I found was a robin.\""
msgstr "「いや、ツバメじゃなくて、丸っこいんだ。図鑑で調べたんだけど、どうもコマドリっぽい。けど」"

#. Occurrence 7_EX:2471:10119: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0011; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2471
msgctxt "text_id=10119 | speaker=kojika"
msgid "\"Yeah, but robins aren't blue."
msgstr "「うん、青色のコマドリは存在しない。"

#. Occurrence 7_EX:2483:10120: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0012; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2483
msgctxt "text_id=10120 | speaker=kojika"
msgid "  ...You know those blue chicks they have at fairs in the city? Of course you don't, why would you? Just forget it."
msgstr "　……静希は縁日の青ひよこって知ってる？　知らないわよね。いい、そう面白い話じゃないから忘れて。"

#. Occurrence 7_EX:2489:10121: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0013; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2489
msgctxt "text_id=10121 | speaker=kojika"
msgid "  Anyway, this robin-is it the only one?\""
msgstr "　それより、そのコマドリって一羽だけなの？」"

#. Occurrence 7_EX:2524:10122: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0014; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2524
msgctxt "text_id=10122 | speaker=soujuurou"
msgid "\"Yeah, there's only one. It doesn't seem to have a mate.\""
msgstr "「ああ、一羽だけだ。つがいは見あたらない」"

#. Occurrence 7_EX:2545:10123: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0014; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2545
msgctxt "text_id=10123 | speaker=kojika"
msgid "\"Hmm. Well, if it's the only one of its kind, then I feel kinda sorry for it."
msgstr "「ふーん。突然変異だとしたらちょっと可哀想ね。"

#. Occurrence 7_EX:2551:10124: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0015; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2551
msgctxt "text_id=10124 | speaker=kojika"
msgid "  Imagine being the last one of your kind since the day you're born. Talk about lonely!"
msgstr "　……生まれた時から最後の一羽だなんて、孤独にもほどがあるわ。"

#. Occurrence 7_EX:2563:10125: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0016; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2563
msgctxt "text_id=10125 | speaker=kojika"
msgid "  I have no idea what species it could be. Maybe you should try being nice to it next time. It might bring you something special, like when you find a ten yen coin in a vending machine!\""
msgstr "　どんな鳥かは知らないけど、次に見かけたら優しくしてあげたら？　自販機で十円を拾う、ぐらいの幸運は運んでくれるかもよ」"

#. Occurrence 7_EX:2601:10126: scene=7_EX
#: 7_EX:2601
msgctxt "text_id=10126 | speaker=unknown"
msgid "  Her words were perfectly kind, but he could hardly sympathize with the creature after all the painful pecking to which it had subjected him."
msgstr "　久万梨の言い分は優しさあふれるものだが、あの駒鳥につっつかれる草十郎としては、何とも頷きがたいものだった。"

#. Occurrence 7_EX:2606:10127: scene=7_EX
#: 7_EX:2606
msgctxt "text_id=10127 | speaker=unknown"
msgid "  He wouldn't have called the bird lonely, either."
msgstr "　そもそも孤独なんて、あの駒鳥にもっとも似合わない表現ではないだろうか？"

#. Occurrence 7_EX:2643:10128: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0017; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2643
msgctxt "text_id=10128 | speaker=kojika"
msgid "\"If one little bird is all that's bothering you, you're lucky."
msgstr "「いいじゃない、小鳥一羽ぐらい。"

#. Occurrence 7_EX:2649:10129: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0018; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2649
msgctxt "text_id=10129 | speaker=kojika"
msgid "  The pecking part is weird for sure, especially in a city like this, but it could be way worse. Imagine getting attacked by an army of crows that swarm around the dumpsters!\""
msgstr "　そりゃ都会で鳥につつかれるのは珍しいけど、いい方の珍事よ、それ。これがゴミ袋をあさるカラスの大軍だったら困りものでしょうけど」"

#. Occurrence 7_EX:2669:10130: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0015; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2669
msgctxt "text_id=10130 | speaker=soujuurou"
msgid "\"Right. Actually, there was something else bothering me, too.\""
msgstr "「あ。そういえば、他にも気になる事が」"

#. Occurrence 7_EX:2689:10131: scene=7_EX
#: 7_EX:2689
msgctxt "text_id=10131 | speaker=unknown"
msgid "  Her example had reminded him of the mystery of the disappearing birds at the mansion."
msgstr "　久万梨の言葉から、草十郎は久遠寺邸・とり集団失踪事件を思い出した。"

#. Occurrence 7_EX:2694:10132: scene=7_EX
#: 7_EX:2694
msgctxt "text_id=10132 | speaker=unknown"
msgid "  A stranger than strange event."
msgstr "　あの鳥たちも不思議と言えば不思議すぎる。"

#. Occurrence 7_EX:2761:10133: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0016; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2761
msgctxt "text_id=10133 | speaker=soujuurou"
msgid "\"See that hill? I actually live on it."
msgstr "「実は今、あそこに見える丘に住んでるんだけど。"

#. Occurrence 7_EX:2767:10134: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0017; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2767
msgctxt "text_id=10134 | speaker=soujuurou"
msgid "  I see lots of starlings around there, but for some reason they never come down to town.\""
msgstr "　でるんだ、大量のムクドリが頻繁に。そのクセ、街に出ると見かけない」"

#. Occurrence 7_EX:2788:10135: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0019; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2788
msgctxt "text_id=10135 | speaker=kojika"
msgid "\"Well, duh, you never see birds in town. But on a mountain like that there are bound to be wild animals!"
msgstr "「当たり前でしょ。町じゃ鳥なんて見かけないし、あそこは山だから動物は多いんじゃない？"

#. Occurrence 7_EX:2821:10136: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0020; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2821
msgctxt "text_id=10136 | speaker=kojika"
msgid "  Why would you move way out there, anyway? I mean, I heard you moved out of your old apartment, but isn't it a pain getting to school? What are you doing out there in the boonies?\""
msgstr "　それより貴方、あの山に引っ越したの？　前のアパートは引き払ったって聞いてたけど。……学校まで通うの、大変じゃない。なんだってあんな<辺鄙|へんぴ>なところに」"

#. Occurrence 7_EX:2857:10137: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0018; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2857
msgctxt "text_id=10137 | speaker=soujuurou"
msgid "\"Things just worked out that way. And the commute isn't hard. If anything is painful, it's what happens inside that place.\""
msgstr "「ちょっとした成り行きだよ。それに通うのは大変じゃない。大変なのは中の話なんだ」"

#. Occurrence 7_EX:2868:10138: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0021; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2868
msgctxt "text_id=10138 | speaker=kojika"
msgid "\"Huh?\""
msgstr "「？」"

#. Occurrence 7_EX:2873:10139: scene=7_EX
#: 7_EX:2873
msgctxt "text_id=10139 | speaker=unknown"
msgid "  It took thirty minutes to reach town on foot."
msgstr "　街に出るまで徒歩三十分。"

#. Occurrence 7_EX:2878:10140: scene=7_EX
#: 7_EX:2878
msgctxt "text_id=10140 | speaker=unknown"
msgid "  The forty minutes to the nearest convenience store would be the real kicker for most people, but for Soujyuro it was no inconvenience."
msgstr "　近場のコンビニエンスストアまで四十分はかかる立地条件だが、草十郎にとって交通の不便さはそう問題ではない。"

#. Occurrence 7_EX:2883:10141: scene=7_EX
#: 7_EX:2883
msgctxt "text_id=10141 | speaker=unknown"
msgid "  The real problem was the dark forces beyond human understanding that lurked within the grounds."
msgstr "　問題は住んでいる建物の人外魔境っぷりである。"

#. Occurrence 7_EX:2920:10142: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0019; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2920
msgctxt "text_id=10142 | speaker=soujuurou"
msgid "\"Sorry, I didn't mean to bring all my complaints to you."
msgstr "「すまない、それは久万梨に話すことじゃなかった。"

#. Occurrence 7_EX:2932:10143: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0020; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2932
msgctxt "text_id=10143 | speaker=soujuurou"
msgid "  I'm curious about how you said there aren't many birds in town, though. Why is that?\""
msgstr "　それより今の話だ。町には鳥が少ないと言ったけど、どうして？」"

#. Occurrence 7_EX:2958:10144: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0022; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2958
msgctxt "text_id=10144 | speaker=kojika"
msgid "\"Simple. They failed to adapt to the environment."
msgstr "「……たんに、環境に適応できなかったのよ。"

#. Occurrence 7_EX:2982:10145: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0023; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2982
msgctxt "text_id=10145 | speaker=kojika"
msgid "  I didn't know you were so interested in birds. Are you an animal lover or something?\""
msgstr "　なに、鳥の話には随分と食いつくわね。静希、動物好き？」"

#. Occurrence 7_EX:3001:10146: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0021; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3001
msgctxt "text_id=10146 | speaker=soujuurou"
msgid "\"I guess I do like animals more than I dislike them.\""
msgstr "「どちらかというと好きな方だけど」"

#. Occurrence 7_EX:3022:10147: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0024; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3022
msgctxt "text_id=10147 | speaker=kojika"
msgid "\"Really? I can't stand them. I'm surprised you didn't pick up on it sooner.\""
msgstr "「そ。わたしは嫌い。そんなわたしに鳥の話とかしてほしい？」"

#. Occurrence 7_EX:3072:10148: scene=7_EX
#: 7_EX:3072
msgctxt "text_id=10148 | speaker=unknown"
msgid "  Her statement could hardly be more self-contradictory."
msgstr "　久万梨の言葉は矛盾に満ちている。"

#. Occurrence 7_EX:3077:10149: scene=7_EX
#: 7_EX:3077
msgctxt "text_id=10149 | speaker=unknown"
msgid "  Minutes after telling him to be nice to a bird that attacked him, she was now claiming she did not even like animals."
msgstr "　動物嫌いという彼女が、なぜ先ほど“鳥には優しく”と口にしたのか。"

#. Occurrence 7_EX:3112:10150: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0022; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3112
msgctxt "text_id=10150 | speaker=soujuurou"
msgid "\"Well, even if you can't stand animals, I'd still like to hear what you know about birds.\""
msgstr "「そうだな。嫌いなだけで苦手でないのなら、知ってる範囲で聞かせてほしい」"

#. Occurrence 7_EX:3133:10151: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0025; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3133
msgctxt "text_id=10151 | speaker=kojika"
msgid "\"Can't take a hint, huh."
msgstr "「痛いトコつくじゃない。"

#. Occurrence 7_EX:3162:10152: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0026; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3162
msgctxt "text_id=10152 | speaker=kojika"
msgid "  Fine. I need to kill some time until work starts anyway."
msgstr "　いいわ、バイトまでの時間つぶしにしてあげる。"

#. Occurrence 7_EX:3168:10153: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0027; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3168
msgctxt "text_id=10153 | speaker=kojika"
msgid "  So, like I was saying, survival is all about being able to adapt to your environment.\""
msgstr "　さっきの続き。環境に適応できるかできないかってところからね」"

#. Occurrence 7_EX:3221:10154: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0028; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3221
msgctxt "text_id=10154 | speaker=kojika"
msgid "\"Misaki's pretty big now, but it wasn't always like this."
msgstr "「今でこそこんなだけど、三咲はここまで大きな町じゃなかったんだって。"

#. Occurrence 7_EX:3227:10155: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0029; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3227
msgctxt "text_id=10155 | speaker=kojika"
msgid "  Half of it used to be woodland, which was closer to the type of environment the poor things were used to living in.\""
msgstr "　昔はその半分が森だったから、彼らはもともと森に適した生活をしていたのよ」"

#. Occurrence 7_EX:3247:10156: scene=7_EX
#: 7_EX:3247
msgctxt "text_id=10156 | speaker=unknown"
msgid "  The way Kumari addressed them was of note."
msgstr "　久万梨は鳥たちを「彼ら」と呼んだ。"

#. Occurrence 7_EX:3252:10157: scene=7_EX
#: 7_EX:3252
msgctxt "text_id=10157 | speaker=unknown"
msgid "  Whether she liked them or not, she seemed to at least have some respect for them."
msgstr "　好きか嫌いかはともかく、鳥たちに敬意を払っている証だろう。"

#. Occurrence 7_EX:3286:10158: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0030; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3286
msgctxt "text_id=10158 | speaker=kojika"
msgid "\"Nature ended up with the short straw as the city modernized. Humans always change their surroundings to suit their needs, after all."
msgstr "「でも近代化した街じゃ自然のサイクルも成り立たない。人間ってのは、まず環境を自分たちの都合に変えるから。"

#. Occurrence 7_EX:3292:10159: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0031; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3292
msgctxt "text_id=10159 | speaker=kojika"
msgid "  Diverting streams to get rid of mosquitoes, covering everything in town with concrete... It made the area unlivable for the birds."
msgstr "　<藪蚊|やぶか>が多いって事で小さな川の流れを変えたり、町中コンクリートで塗り固めちゃえば鳥的にはお手上げよ。"

#. Occurrence 7_EX:3298:10160: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0032; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3298
msgctxt "text_id=10160 | speaker=kojika"
msgid "  Without enough bugs or trees they had no choice but to flee. Chased out of their home they moved from the forest to the mountains."
msgstr "　虫も森も少ないんじゃもう山に逃げるしかない。彼らは故郷を追われて、この森から山に移った。"

#. Occurrence 7_EX:3304:10161: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0033; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3304
msgctxt "text_id=10161 | speaker=kojika"
msgid "  A convenient urban center for humans isn't the kind of place that can support a colony of birds.\""
msgstr "　人間にとって都合のいい町は、鳥たちが生きるコロニーにはなり得ないから」"

#. Occurrence 7_EX:3345:10162: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0023; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3345
msgctxt "text_id=10162 | speaker=soujuurou"
msgid "\"And that's all it took to get rid of birds in the city?"
msgstr "「……そんな事ぐらいで減るものか？"

#. Occurrence 7_EX:3351:10163: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0024; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3351
msgctxt "text_id=10163 | speaker=soujuurou"
msgid "  Just like that, and we never see them again?\""
msgstr "　その、姿を見なくなるぐらいに？」"

#. Occurrence 7_EX:3362:10164: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0034; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3362
msgctxt "text_id=10164 | speaker=kojika"
msgid "\"It's not *that* extreme. I mean, come on, you just said you see starlings."
msgstr "「そこまで極端じゃない……とは思う。現に貴方だってムクドリを見てるでしょう？"

#. Occurrence 7_EX:3368:10165: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0035; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3368
msgctxt "text_id=10165 | speaker=kojika"
msgid "  It's all relative. There are so many humans in town, the number of birds seems small in comparison. It feels special just to spot one here or there.\""
msgstr "　比較の問題よ。町には人間が多いから、鳥の姿はよけい稀少に感じるだけ。たまに見かけるだけで、珍しいと思えるぐらいにね」"

#. Occurrence 7_EX:3403:10166: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0025; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3403
msgctxt "text_id=10166 | speaker=soujuurou"
msgid "\"That's true. So they all just left town and moved to the mountains...\""
msgstr "「ああ、たしかに。じゃあ鳥は町から居なくなっただけで、あの山に移り住んで―――」"

#. Occurrence 7_EX:3409:10167: scene=7_EX
#: 7_EX:3409
msgctxt "text_id=10167 | speaker=unknown"
msgid "  Humans might not be able to see them in day-to-day life, but they were alive and well nonetheless."
msgstr "　目立たないだけで、きちんと今も生き続けている。"

#. Occurrence 7_EX:3414:10168: scene=7_EX
#: 7_EX:3414
msgctxt "text_id=10168 | speaker=unknown"
msgid "  Their habitat and lifestyle changed with the times, but they never truly disappeared."
msgstr "　時代と共に、その在り方、カタチは変わっても、まったくの無に帰する事はない。"

#. Occurrence 7_EX:3419:10169: scene=7_EX
#: 7_EX:3419
msgctxt "text_id=10169 | speaker=unknown"
msgid "  Soujyuro's sense of relief was sharply disrupted by a serious look from Kumari."
msgstr "　そう安心して気を取り直す草十郎を、久万梨は冷めた顔で否定した。"

#. Occurrence 7_EX:3453:10170: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0036; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3453
msgctxt "text_id=10170 | speaker=kojika"
msgid "\"But the birds aren't safe in the mountains."
msgstr "「あの山に天敵がいなければね。"

#. Occurrence 7_EX:3459:10171: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0037; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3459
msgctxt "text_id=10171 | speaker=kojika"
msgid "  There's still overfishing by humans and conflict between the birds and their new ecosystem. With everything going on I doubt they'll last very long. Even a century might be optimistic."
msgstr "　人間の手による<乱獲|らんかく>か、移った先にいる生態系との衝突か。どちらにせよ、居場所を失った彼らの寿命は短いと思う。一世紀持てばいい方かもしれない。"

#. Occurrence 7_EX:3465:10172: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0038; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3465
msgctxt "text_id=10172 | speaker=kojika"
msgid "  Just look at what happened to passenger pigeons. Once humans noticed what they'd done to them, it was already too late. That's how it always is.\""
msgstr "　……リョコウバトの例もあるし。気が付いた時には取り返しつかないのが動物と人間の関係よ」"

#. Occurrence 7_EX:3500:10173: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0026; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3500
msgctxt "text_id=10173 | speaker=soujuurou"
msgid "\"...What are passenger pigeons?\""
msgstr "「リョコウバト……？」"

#. Occurrence 7_EX:3517:10174: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0039; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3517
msgctxt "text_id=10174 | speaker=kojika"
msgid "\"Oh, they were large, beautiful birds, about sixteen inches from head to tail."
msgstr "「そ、リョコウバト。体長は四十センチほどもある、大型のきれいな鳥。"

#. Occurrence 7_EX:3523:10175: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0040; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3523
msgctxt "text_id=10175 | speaker=kojika"
msgid "  The males were a deep blue, with vivid red on their breast. The cutest part was their orange eyes-like something out of a book! And they could fly up to sixty miles per hour over great distances.\""
msgstr "　オスの翼は深い青色で、胸は鮮やかな<臙脂|えんじ>色。オレンジ色の目は嘘みたいに愛らしくて、その羽は時速百キロで長い距離を旅するの」"

#. Occurrence 7_EX:3543:10176: scene=7_EX
#: 7_EX:3543
msgctxt "text_id=10176 | speaker=unknown"
msgid "  Her voice had a certain tenderness to it."
msgstr "　久万梨の声は、少しだけ優しい。"

#. Occurrence 7_EX:3548:10177: scene=7_EX
#: 7_EX:3548
msgctxt "text_id=10177 | speaker=unknown"
msgid "  She was daydreaming about birds she had never even seen in the flesh."
msgstr "　彼女は図鑑でしか観ることのない鳥の姿を、ひとり夢想しているようだった。"

#. Occurrence 7_EX:3593:10178: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0041; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3593
msgctxt "text_id=10178 | speaker=kojika"
msgid "\"They were a type of pigeon native to North America, so they used to fly north in spring and then back south in winter until it got warm again."
msgstr "「北アメリカにいた<鳩|ハト>でね、春は南から北へ、冬は冬越えのために北から南に移動するの。"

#. Occurrence 7_EX:3599:10179: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0042; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3599
msgctxt "text_id=10179 | speaker=kojika"
msgid "  But that was over a century ago."
msgstr "　今から百年以上も前の話よ。"

#. Occurrence 7_EX:3605:10180: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0043; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3605
msgctxt "text_id=10180 | speaker=kojika"
msgid "  They used to be the most common higher animal on Earth."
msgstr "　彼らはかつて地上でもっとも繁殖した高等動物だった。"

#. Occurrence 7_EX:3611:10181: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0044; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3611
msgctxt "text_id=10181 | speaker=kojika"
msgid "  There were five billion of them in total-that's more passenger pigeons than humans! Pretty amazing, right?\""
msgstr "　なにしろその数は五十億。当時の総人口より多かったっていうんだから、圧巻よね」"

#. Occurrence 7_EX:3645:10182: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0027; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3645
msgctxt "text_id=10182 | speaker=soujuurou"
msgid "\"Wow. I never thought about an animal being more common than humans.\""
msgstr "「なんと。人間より数の多い動物がいたっていうのか？」"

#. Occurrence 7_EX:3667:10183: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0045; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3667
msgctxt "text_id=10183 | speaker=kojika"
msgid "\"Yeah, I know. But now they're all extinct, thanks to those same humans."
msgstr "「うん。でも彼らは絶滅したわ。他ならぬ人間の手によって。"

#. Occurrence 7_EX:3673:10184: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0046; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3673
msgctxt "text_id=10184 | speaker=kojika"
msgid "  Settlers from Europe who went to the Americas in the sixteenth century mentioned flocks of passenger pigeons so vast they covered the entire sky."
msgstr "　１６世紀にヨーロッパからアメリカ大陸にやってきた探検家たちは、空を覆いつくすほどの鳥の群を見た。"

#. Occurrence 7_EX:3679:10185: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0047; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3679
msgctxt "text_id=10185 | speaker=kojika"
msgid "  Those are the oldest written references to them that we have.\""
msgstr "　それがリョコウバトを<記|しる>した、一番古くて確かな記録」"

#. Occurrence 7_EX:3714:10186: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0048; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3714
msgctxt "text_id=10186 | speaker=kojika"
msgid "\"Books are the only way to know anything about them these days."
msgstr "「……まあ、わたしも本で知った知識だけど。"

#. Occurrence 7_EX:3720:10187: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0049; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3720
msgctxt "text_id=10187 | speaker=kojika"
msgid "  It's hard to imagine so many birds that they block out the sun, cover whole forests, and rain down droppings like snow. It sounds like something out of a dream, doesn't it?"
msgstr "　太陽を隠して、そのおびただしい数で森を覆って、雪のように糞を落としていく光景なんて、今じゃもう夢物語でしょうね。"

#. Occurrence 7_EX:3726:10188: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0050; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3726
msgctxt "text_id=10188 | speaker=kojika"
msgid "  But for people back then it was more like a nightmare."
msgstr "　でも当時の人にとっては悪夢だった。"

#. Occurrence 7_EX:3732:10189: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0051; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3732
msgctxt "text_id=10189 | speaker=kojika"
msgid "  Sure, each individual bird was beautiful, but together they amounted to a violent force of nature.\""
msgstr "　リョコウバト一羽一羽は美しいフォルムをしていても、それだけの数が集まれば、それはもう暴力なんだから」"

#. Occurrence 7_EX:3766:10190: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0052; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3766
msgctxt "text_id=10190 | speaker=kojika"
msgid "\"They were downright demonic with the power to destroy forests and threaten everyone."
msgstr "「彼らはその時点では、森を破壊し、人間を脅かす悪魔のような存在だった。"

#. Occurrence 7_EX:3772:10191: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0053; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3772
msgctxt "text_id=10191 | speaker=kojika"
msgid "  Their nesting grounds were up to six miles wide, and just one colony could have fifty thousand birds in it, so you can imagine how loud it got."
msgstr "　営巣地は十キロメートルにまでおよんで、一コロニーにつき五万羽近い鳥の鳴き声が響いたのよ。"

#. Occurrence 7_EX:3778:10192: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0054; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3778
msgctxt "text_id=10192 | speaker=kojika"
msgid "  A flock of birds so big it could instantly transform the landscape and cover the whole land with its cries... I can see why the settlers were scared at first.\""
msgstr "　一瞬にして風景を変えるほどの鳥の群れと、世界を覆うほどの鳴き声。冒険家たちが<竦|すく>んだのもうなずけるわね」"

#. Occurrence 7_EX:3814:10193: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0028; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3814
msgctxt "text_id=10193 | speaker=soujuurou"
msgid "\"Fifty thousand birds, all in one spot...\""
msgstr "「一つの住み処に五万羽―――」"

#. Occurrence 7_EX:3820:10194: scene=7_EX
#: 7_EX:3820
msgctxt "text_id=10194 | speaker=unknown"
msgid "  Soujyuro trailed off as he attempted to count the number with his digits."
msgstr "　草十郎は指折り数えながら絶句した。"

#. Occurrence 7_EX:3825:10195: scene=7_EX
#: 7_EX:3825
msgctxt "text_id=10195 | speaker=unknown"
msgid "  He could barely count the number of people in the crowd outside the station. This would be far beyond his capacity."
msgstr "　駅前の人の流れだけで手一杯な彼では、想像が追いつかないらしい。"

#. Occurrence 7_EX:3851:10196: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0029; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3851
msgctxt "text_id=10196 | speaker=soujuurou"
msgid "\"But if there were so many of them, how could humans wipe them out?\""
msgstr "「でも、そんな数の鳥を、人間の手でどうやって？」"

#. Occurrence 7_EX:3862:10197: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0055; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3862
msgctxt "text_id=10197 | speaker=kojika"
msgid "\"Good question. No one back then thought it was possible, either."
msgstr "「ええ。当時、誰もがそう思ったんでしょうね。"

#. Occurrence 7_EX:3868:10198: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0056; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3868
msgctxt "text_id=10198 | speaker=kojika"
msgid "  But it's simple when you realize that passenger pigeons were both a threat and a cheap commodity.\""
msgstr "　でも話は簡単だったの。人間にとってリョコウバトは脅威でもあったけど、同時に安価な<実|みの>りでもあったから」"

#. Occurrence 7_EX:3904:10199: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0057; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3904
msgctxt "text_id=10199 | speaker=kojika"
msgid "\"All the flying was what made the meat of migratory birds so delicious to humans."
msgstr "「渡り鳥の胸肉は美味しいでしょ。よく鍛えられてるから。"

#. Occurrence 7_EX:3910:10200: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0058; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3910
msgctxt "text_id=10200 | speaker=kojika"
msgid "  And all you had to do was point your gun in the air. Bang! And there's dinner. What would you do in their shoes?"
msgstr "　そんな食材が、空に向かって鉄砲を撃つだけでバタバタと落ちてきたとしたら、貴方はどうする？"

#. Occurrence 7_EX:3916:10201: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0059; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3916
msgctxt "text_id=10201 | speaker=kojika"
msgid "  This might sound heartless, but the passenger pigeons were a species that could easily be converted into cold, hard cash.\""
msgstr "　ま―――身もフタもないコトを言えば、リョコウバトって鳥は、簡単にお金にできる生き物だった」"

#. Occurrence 7_EX:3965:10202: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0060; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3965
msgctxt "text_id=10202 | speaker=kojika"
msgid "\"Naturally, the hunting went on and on."
msgstr "「かくして、狩りは延々と続けられた。"

#. Occurrence 7_EX:3971:10203: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0061; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3971
msgctxt "text_id=10203 | speaker=kojika"
msgid "  People would pluck their feathers, stick them in a barrel with salt, and ship them out.\""
msgstr "　落ちた鳥は羽をむしられて、塩漬けのタルにおしこまれて、次々と出荷された」"

#. Occurrence 7_EX:3992:10204: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0062; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3992
msgctxt "text_id=10204 | speaker=kojika"
msgid "\"It wasn't hunting after a point, just consuming a resource. It didn't feel like work or labor to the people doing it."
msgstr "「それはもう狩りですらなかった。ただの消費。人間側は労働の実感も、作業の手間すら感じなくなっていた。"

#. Occurrence 7_EX:3998:10205: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0063; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3998
msgctxt "text_id=10205 | speaker=kojika"
msgid "  In those days you could get a whole passenger pigeon for one cent. That's roughly equal to one yen."
msgstr "　その頃、リョコウバトは一羽一セントで手に入れる事が出来たんだって。ここでいうならたった一円。"

#. Occurrence 7_EX:4004:10206: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0064; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4004
msgctxt "text_id=10206 | speaker=kojika"
msgid "  Can you believe it?"
msgstr "　―――ほんと、信じられる？"

#. Occurrence 7_EX:4010:10207: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0065; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4010
msgctxt "text_id=10207 | speaker=kojika"
msgid "  The smallest denomination of currency in society was enough to purchase an entire life.\""
msgstr "　その国最小の通貨一枚で売買される命が、この地球にはあったなんて」"

#. Occurrence 7_EX:4061:10208: scene=7_EX
#: 7_EX:4061
msgctxt "text_id=10208 | speaker=unknown"
msgid "  Kumari spoke as if reciting from a textbook."
msgstr "　久万梨はあくまで他人事のように語る。"

#. Occurrence 7_EX:4066:10209: scene=7_EX
#: 7_EX:4066
msgctxt "text_id=10209 | speaker=unknown"
msgid "  Her voice nevertheless had a certain darkness to it-was it pity for the slain birds, or disgust for her fellow man?"
msgstr "　……なのに、声にかすかな翳りがあるのは、鳥たちへの謝罪か、同種への嫌悪からか。"

#. Occurrence 7_EX:4071:10210: scene=7_EX
#: 7_EX:4071
msgctxt "text_id=10210 | speaker=unknown"
msgid "  Either way, the passenger pigeons' fate was a cruel joke carried out by humanity. Typical, some might say."
msgstr "　どちらにせよ人間らしい、身勝手な<諧謔|かいぎゃく>だ。"

#. Occurrence 7_EX:4076:10211: scene=7_EX
#: 7_EX:4076
msgctxt "text_id=10211 | speaker=unknown"
msgid "  Poor Soujyuro had yet to comprehend just how typical that side of humanity was."
msgstr "　一方。そんな人間らしさを、草十郎はまだ理解できないでいる。"

#. Occurrence 7_EX:4115:10212: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0066; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4115
msgctxt "text_id=10212 | speaker=kojika"
msgid "\"And that was only the beginning. The real damage began in the nineteenth century."
msgstr "「けど、それはまだまだ序の口で、本番は１９世紀に入ってからだった。"

#. Occurrence 7_EX:4121:10213: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0067; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4121
msgctxt "text_id=10213 | speaker=kojika"
msgid "  Passenger pigeon hunting became more popular than ever before."
msgstr "　人間のリョコウバト狩りはますます熱狂していった。"

#. Occurrence 7_EX:4127:10214: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0068; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4127
msgctxt "text_id=10214 | speaker=kojika"
msgid "  Remember learning about the Gold Rush, and the American Civil War? America was expanding really fast back then."
msgstr "　学校で習ったでしょ。ゴールドラッシュ、南北戦争を経て、アメリカ合衆国は急激に成長していく。"

#. Occurrence 7_EX:4133:10215: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0069; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4133
msgctxt "text_id=10215 | speaker=kojika"
msgid "  Immigrants kept flooding in from Europe, and by 1870 there were forty million people living in America. Passenger pigeons were the perfect thing for their purses and stomachs.\""
msgstr "　西欧からの移民は増え続け、１８７０年には４０００万もの人口に達していたわ。そんな移民たちの胃袋と財布を満たす材料として、リョコウバトは最高の獲物だった」"

#. Occurrence 7_EX:4175:10216: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0070; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4175
msgctxt "text_id=10216 | speaker=kojika"
msgid "\"But the worst part is how scheming people were."
msgstr "「で、もっと最悪な事に、人間は工夫する生き物だった。"

#. Occurrence 7_EX:4181:10217: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0071; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4181
msgctxt "text_id=10217 | speaker=kojika"
msgid "  They competed to find the fastest, most efficient way to catch as many passenger pigeons as possible."
msgstr "　彼らはより速く、より多く、より簡単にリョコウバトを乱獲する手段を競い合った。"

#. Occurrence 7_EX:4187:10218: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0072; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4187
msgctxt "text_id=10218 | speaker=kojika"
msgid "  One thing they used to do is blind one pigeon and then use it as a lure for the group, sometimes catching ten thousand in a single day. Yet no one had a single qualm about what they were doing."
msgstr "　目を潰したハトを囮にして集団を誘いこんで、一日で一万羽以上捕らえたヤツさえいた。それでも彼らは乱獲に疑問すら持たなかった。"

#. Occurrence 7_EX:4193:10219: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0073; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4193
msgctxt "text_id=10219 | speaker=kojika"
msgid "  Any sane person could see that the balance between breeding and hunting was clearly out of whack.\""
msgstr "　―――繁殖と狩猟のバランスは、誰が見ても明らかに狂っていたのに」"

#. Occurrence 7_EX:4242:10220: scene=7_EX
#: 7_EX:4242
msgctxt "text_id=10220 | speaker=unknown"
msgid "  She was doing everything she could to speak in calm, measured tones."
msgstr "　淡々と、努めて冷静でいるように淡々と、久万梨は語る。"

#. Occurrence 7_EX:4247:10221: scene=7_EX
#: 7_EX:4247
msgctxt "text_id=10221 | speaker=unknown"
msgid "  Soujyuro, meanwhile, was completely enraptured by her words."
msgstr "　一方、草十郎はただ感心するばかりだった。"

#. Occurrence 7_EX:4252:10222: scene=7_EX
#: 7_EX:4252
msgctxt "text_id=10222 | speaker=unknown"
msgid "  Having been raised in the mountains it was by no means a happy story for him, but right now he was more interested in knowing why it ever happened in the first place."
msgstr "　山育ちである草十郎からすれば気持ちのいい話ではないのに、今は、「どうしてそうなったのか」という疑問の方が強いらしい。"

#. Occurrence 7_EX:4279:10223: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0030; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:4279
msgctxt "text_id=10223 | speaker=soujuurou"
msgid "\"Something seems off about that. If their numbers were decreasing so fast the passenger pigeons should've tried harder to avoid humans.\""
msgstr "「それ、一方的すぎないか？　リョコウバトだって数が減ってくれば、人間には近寄らないんじゃ」"

#. Occurrence 7_EX:4290:10224: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0074; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4290
msgctxt "text_id=10224 | speaker=kojika"
msgid "\"That's where they were unlucky."
msgstr "「そこが彼らの不幸だったのよ。"

#. Occurrence 7_EX:4296:10225: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0075; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4296
msgctxt "text_id=10225 | speaker=kojika"
msgid "  They had really low fertility rates and no means of protecting themselves. All they knew to do was live together in groups. That was their only form of self-defense.\""
msgstr "　リョコウバトは繁殖力が非常に弱くて、自衛手段を持たない鳥だった。大群で暮らすこと。それだけが、彼らの身を守る手段だったの」"

#. Occurrence 7_EX:4330:10226: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0076; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4330
msgctxt "text_id=10226 | speaker=kojika"
msgid "\"Passenger pigeons managed to build an empire of five billion only because they lacked natural predators. Indigenous people didn't hunt them either, apparently."
msgstr "「彼らが五十億の王国を築けたのは、それまで天敵がいなかったからなんでしょうね。先住民であるインディアンも彼らを乱獲する事はなかったと言うし。"

#. Occurrence 7_EX:4336:10227: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0077; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4336
msgctxt "text_id=10227 | speaker=kojika"
msgid "  It was the settlers who wrecked the local ecosystem."
msgstr "　けど入植者たちは自然のサイクルにはてんで<疎|うと>かった。"

#. Occurrence 7_EX:4342:10228: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0078; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4342
msgctxt "text_id=10228 | speaker=kojika"
msgid "  No one ever imagined in their wildest dreams that so many birds could just go extinct."
msgstr "　何より、あの<夥|おびただ>しい数の鳥が絶滅するなんて夢にも思わなかった。"

#. Occurrence 7_EX:4348:10229: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0079; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4348
msgctxt "text_id=10229 | speaker=kojika"
msgid "  The passenger pigeons couldn't have been prepared for a predator showing up centuries later out of the blue from across the ocean.\""
msgstr "　リョコウバトにしたら青天の霹靂よ。まさか何世紀も遅れて、海の向こうから天敵がやってくるなんて」"

#. Occurrence 7_EX:4382:10230: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0080; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4382
msgctxt "text_id=10230 | speaker=kojika"
msgid "\"Finally, in 1896 humans began to realize what their crazed enthusiasm had brought about."
msgstr "「そうして１８９６年。人間はようやく、熱狂を覚ますほどの現実に直面したわ。"

#. Occurrence 7_EX:4388:10231: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0081; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4388
msgctxt "text_id=10231 | speaker=kojika"
msgid "  A quarter of a million passenger pigeons..."
msgstr "　たったの２５万羽。"

#. Occurrence 7_EX:4394:10232: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0082; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4394
msgctxt "text_id=10232 | speaker=kojika"
msgid "  That's how many they estimated were still left. But it was too late. The government tried passing laws to protect them, but human habits are hard to break.\""
msgstr "　それが確認されたリョコウバトの総数。何もかも手遅れよ。急いで保護法が作られたけど、人間の習慣はそう簡単には変わらないわ」"

#. Occurrence 7_EX:4424:10233: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0083; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4424
msgctxt "text_id=10233 | speaker=kojika"
msgid "\"Or maybe hunters just thought that with two hundred and fifty thousand passenger pigeons still left,"
msgstr "「あるいは、狩人たちはこう思ったのかもしれない。"

#. Occurrence 7_EX:4430:10234: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0084; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4430
msgctxt "text_id=10234 | speaker=kojika"
msgid "  taking one or two thousand wouldn't be a big deal in the greater scheme of things.\""
msgstr "　<ま|・><だ|・><２|・><５|・><万|・><羽|・><も|・><い|・><る|・><じ|・><ゃ|・><な|・><い|・><か|・>、千羽や二千羽ぐらいなら独り占めしても構わないだろう、って」"

#. Occurrence 7_EX:4451:10235: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0085; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4451
msgctxt "text_id=10235 | speaker=kojika"
msgid "\"Hunters started using the latest technological breakthrough, the telegraph, to keep track of where the passenger pigeons were. Soon they had shot down two hundred thousand, and injured forty thousand more."
msgstr "「そうしてハンターたちは当時最新の技術―――電報でリョコウバトたちの所在を報せあって、実に２０万羽のリョコウバトを仕留め、４万羽を傷つけた。"

#. Occurrence 7_EX:4457:10236: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0086; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4457
msgctxt "text_id=10236 | speaker=kojika"
msgid "  That left only five thousand passenger pigeons in the world. And at that point they could no longer survive in the wild.\""
msgstr "　生き延びたのは５０００羽だけ。この時点で、彼らは野生で生きられる種ではなくなったのよ」"

#. Occurrence 7_EX:4489:10237: scene=7_EX
#: 7_EX:4489
msgctxt "text_id=10237 | speaker=unknown"
msgid "  Soujyuro's face sunk into a scowl."
msgstr "　草十郎は顔をしかめている。"

#. Occurrence 7_EX:4494:10238: scene=7_EX
#: 7_EX:4494
msgctxt "text_id=10238 | speaker=unknown"
msgid "  No longer able to survive in the wild..."
msgstr "“野生で生きられる種ではない。”"

#. Occurrence 7_EX:4499:10239: scene=7_EX
#: 7_EX:4499
msgctxt "text_id=10239 | speaker=unknown"
msgid "  He knew all too well what that phrase meant."
msgstr "　その言葉の意味を、彼は言われるまでもなく知っているからだ。"

#. Occurrence 7_EX:4519:10240: scene=7_EX
#: 7_EX:4519
msgctxt "text_id=10240 | speaker=unknown"
msgid "  No wild animal can last long on its own."
msgstr "　野生動物は単体で生き続けるものではない。"

#. Occurrence 7_EX:4524:10241: scene=7_EX
#: 7_EX:4524
msgctxt "text_id=10241 | speaker=unknown"
msgid "  No animal can survive without a sufficiently large population of their fellow kind and sufficient feeding grounds to support the group."
msgstr "　全体の数と、それを支える餌場を一定数維持できなければ、存続する事ができない。"

#. Occurrence 7_EX:4529:10242: scene=7_EX
#: 7_EX:4529
msgctxt "text_id=10242 | speaker=unknown"
msgid "  Strength in their massive numbers was all the passenger pigeons ever had, and so once that was gone they were as good as extinct."
msgstr "　<大|・><群|・><で|・><あ|・><る|・><事|・>がリョコウバトのシステムであったのなら、もうその時点で、彼らは袋小路に入っていた。"

#. Occurrence 7_EX:4555:10243: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0031; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:4555
msgctxt "text_id=10243 | speaker=soujuurou"
msgid "\"What happened to them in the end, though?\""
msgstr "「それで、リョコウバトはどうなったんだ？」"

#. Occurrence 7_EX:4575:10244: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0087; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4575
msgctxt "text_id=10244 | speaker=kojika"
msgid "\"Eventually there were only *three* passenger pigeons left."
msgstr "「最後に保護されたリョコウバトはたったの三羽。"

#. Occurrence 7_EX:4581:10245: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0088; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4581
msgctxt "text_id=10245 | speaker=kojika"
msgid "  Two males and one female were kept in captivity at the Cincinnati Zoo, but within the year both the males had died."
msgstr "　シンシナティの動物園ではオス二羽、メス一羽のリョコウバトが飼育されたけど、一年でオスたちは死んじゃったわ。"

#. Occurrence 7_EX:4587:10246: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0089; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4587
msgctxt "text_id=10246 | speaker=kojika"
msgid "  Then only the female was left."
msgstr "　残されたのはメス一羽だけ。"

#. Occurrence 7_EX:4593:10247: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0090; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4593
msgctxt "text_id=10247 | speaker=kojika"
msgid "  At that moment when the other two died, she became the single loneliest creature on earth.\""
msgstr "　その時点で、彼女は地上でもっとも孤独な生き物になった」"

#. Occurrence 7_EX:4614:10248: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0091; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4614
msgctxt "text_id=10248 | speaker=kojika"
msgid "\"Her name was Martha."
msgstr "「名前はマーサ。"

#. Occurrence 7_EX:4620:10249: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0092; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4620
msgctxt "text_id=10249 | speaker=kojika"
msgid "  The last of her species that had once soared over North America, she would never fly free again, trapped forever in her cage."
msgstr "　北アメリカを旅する鳥たちの最後の一羽でありながら、ただの一度も空を飛ぶ事ができなかった<籠|かご>の鳥。"

#. Occurrence 7_EX:4626:10250: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0093; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4626
msgctxt "text_id=10250 | speaker=kojika"
msgid "  At the age of twenty nine she finally passed."
msgstr "　結局、２９年で彼女はその命を終えたわ。"

#. Occurrence 7_EX:4632:10251: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0094; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4632
msgctxt "text_id=10251 | speaker=kojika"
msgid "  It happened at 1:00 PM on September 1st, 1914."
msgstr "　１９１４年９月１日午後１時。"

#. Occurrence 7_EX:4638:10252: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0095; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4638
msgctxt "text_id=10252 | speaker=kojika"
msgid "  The only case in all of Earth history where we know the exact moment a species went extinct.\""
msgstr "　一つの種が終わる時間がここまで正確に残っている例は、今のところこれだけよ」"

#. Occurrence 7_EX:4684:10253: scene=7_EX
#: 7_EX:4684
msgctxt "text_id=10253 | speaker=unknown"
msgid "  The story of five billion deaths had finally come to an end."
msgstr "　……五十億の死にまつわる話は終わった。"

#. Occurrence 7_EX:4689:10254: scene=7_EX
#: 7_EX:4689
msgctxt "text_id=10254 | speaker=unknown"
msgid "  The birds had been swallowed up by the machinations of human civilization."
msgstr "　文明に飲みこまれた鳥の末路。"

#. Occurrence 7_EX:4694:10255: scene=7_EX
#: 7_EX:4694
msgctxt "text_id=10255 | speaker=unknown"
msgid "  Kumari had intended to show her sympathy for the lost species, but the emotional impact had clearly been all but lost on Soujyuro."
msgstr "　失われた鳥たちへの哀歌のような久万梨の話は、しかし、草十郎にはあまり伝わらなかったようだ。"

#. Occurrence 7_EX:4724:10256: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0096; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4724
msgctxt "text_id=10256 | speaker=kojika"
msgid "\"Huh. I tried to make it sound all poetic and tragic, but I guess I failed."
msgstr "「意外。できるだけ詩的に語ったつもりだけど、ウケ、悪いみたい。"

#. Occurrence 7_EX:4731:10257: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0097; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4731
msgctxt "text_id=10257 | speaker=kojika"
msgid "Aren't you angry, as someone raised around nature in the mountains?\""
msgstr "山育ちの貴方には<憤慨|ふんがい>ものの話だと思ったのに」"

#. Occurrence 7_EX:4748:10258: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0032; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:4748
msgctxt "text_id=10258 | speaker=soujuurou"
msgid "\"Oh... It was definitely an amazing story."
msgstr "「え―――いや、すごい話だったけど。"

#. Occurrence 7_EX:4754:10259: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0033; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:4754
msgctxt "text_id=10259 | speaker=soujuurou"
msgid "  But it doesn't make sense. Why would humans keep passenger pigeons in captivity after working so hard to kill them?\""
msgstr "　その、整理がつかなくて。当時の人たちは自分たちの手で減らしておいたのに、なんで最後は保護したのかって」"

#. Occurrence 7_EX:4786:10260: scene=7_EX
#: 7_EX:4786
msgctxt "text_id=10260 | speaker=unknown"
msgid "  Kumari stared blankly at him, eyebrows raised high."
msgstr "　その呟きを聞いて、久万梨はきょとんと眉を上げた。"

#. Occurrence 7_EX:4791:10261: scene=7_EX
#: 7_EX:4791
msgctxt "text_id=10261 | speaker=unknown"
msgid "  What he likely meant to ask was why humans would protect the last of a species"
msgstr "　おそらく、草十郎はこう言いたかったのだ。"

#. Occurrence 7_EX:4797:10262: scene=7_EX
#: 7_EX:4797
msgctxt "text_id=10262 | speaker=unknown"
msgid "  they themselves had hunted into extinction."
msgstr "“奪うために減らしたのに、なぜ最後の一羽を守ろうとしたのか”と。"

#. Occurrence 7_EX:4817:10263: scene=7_EX
#: 7_EX:4817
msgctxt "text_id=10263 | speaker=unknown"
msgid "  Kumari could hardly be blamed for her bewilderment."
msgstr "　久万梨が思い違いをしたのも無理はない。"

#. Occurrence 7_EX:4822:10264: scene=7_EX
#: 7_EX:4822
msgctxt "text_id=10264 | speaker=unknown"
msgid "  Having been raised in the city she failed to recognize the danger inherent in his cluelessness."
msgstr "　都会育ちの彼女には、草十郎の疑問の危うさは理解できない。"

#. Occurrence 7_EX:4860:10265: scene=7_EX
#: 7_EX:4860
msgctxt "text_id=10265 | speaker=unknown"
msgid "  He felt neither anger toward humans"
msgstr "　この少年にはまだ、"

#. Occurrence 7_EX:4865:10266: scene=7_EX
#: 7_EX:4865
msgctxt "text_id=10266 | speaker=unknown"
msgid "  for their base selfishness, nor sympathy for the birds"
msgstr "　人間の身勝手な行為への怒りも、"

#. Occurrence 7_EX:4870:10267: scene=7_EX
#: 7_EX:4870
msgctxt "text_id=10267 | speaker=unknown"
msgid "  who remained in their natural habitat even at the cost of their lives."
msgstr "　<住処|すみか>から移動しなかった鳥たちへの同情もない。"

#. Occurrence 7_EX:4876:10268: scene=7_EX
#: 7_EX:4876
msgctxt "text_id=10268 | speaker=unknown"
msgid "  His upbringing had not provided him with the necessary sense of self-righteousness to produce feelings in either direction."
msgstr "　そのどちらかに肩入れする<独善|じぶん>を、ここまで育てずに暮らしてきた。"

#. Occurrence 7_EX:4911:10269: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0098; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4911
msgctxt "text_id=10269 | speaker=kojika"
msgid "\"You don't get it, do you?"
msgstr "「……あいかわらず、よく分かんないヤツ。"

#. Occurrence 7_EX:4922:10270: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0099; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4922
msgctxt "text_id=10270 | speaker=kojika"
msgid "  My point was that no matter how strong and beautiful animals might look, they don't stand a chance outside of their natural habitat."
msgstr "　ま、わたしが言いたかったのは、どんなに強く美しく見えても、居場所から追われた生き物ははかないってコト。"

#. Occurrence 7_EX:4933:10271: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0100; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4933
msgctxt "text_id=10271 | speaker=kojika"
msgid "  Think about it, Sizuki."
msgstr "　静希くん。"

#. Occurrence 7_EX:4939:10272: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0101; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4939
msgctxt "text_id=10272 | speaker=kojika"
msgid "  That bird you're complaining about might be the very last of its kind.\""
msgstr "　貴方が見た鳥は、その最後の一羽かもしれないわよ？」"

#. Occurrence 7_EX:4985:10273: scene=7_EX
#: 7_EX:4985
msgctxt "text_id=10273 | speaker=unknown"
msgid "  And with that, their idle conversation came to an end."
msgstr "　……<益体|やくたい>のない立ち話は終わった。"

#. Occurrence 7_EX:4990:10274: scene=7_EX
#: 7_EX:4990
msgctxt "text_id=10274 | speaker=unknown"
msgid "  It was nearly time for their shifts to begin, and Soujyuro was the first to head off."
msgstr "　アルバイトの時間が近づき、草十郎は一足先にバイト先へ向かっていった。"

#. Occurrence 7_EX:5014:10275: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0102; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:5014
msgctxt "text_id=10275 | speaker=kojika"
msgid "\"What was I even thinking? It's not like me to rant like that.\""
msgstr "「……らしくない。なに熱く語ってたんだろ、わたし」"

#. Occurrence 7_EX:5020:10276: scene=7_EX
#: 7_EX:5020
msgctxt "text_id=10276 | speaker=unknown"
msgid "  Kumari remained in the park after Soujyuro left."
msgstr "　草十郎と別れた後も、久万梨は公園に留まっていた。"

#. Occurrence 7_EX:5025:10277: scene=7_EX
#: 7_EX:5025
msgctxt "text_id=10277 | speaker=unknown"
msgid "  Martha. The last of her species..."
msgstr "　マーサ。最後の一羽。"

#. Occurrence 7_EX:5030:10278: scene=7_EX
#: 7_EX:5030
msgctxt "text_id=10278 | speaker=unknown"
msgid "  She had not been referring to the blue bird when she mentioned Martha, but..."
msgstr "　そのフレーズは青い鳥にあてられたものではなく―――"

#. Occurrence 7_EX:5063:10279: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0103; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:5063
msgctxt "text_id=10279 | speaker=kojika"
msgid "\"No, stop it. Thinking something is special just because it's rare is dumb.\""
msgstr "「やめやめ。珍しいから特別視するとか、バカみたいだし」"

#. Occurrence 7_EX:5069:10280: scene=7_EX
#: 7_EX:5069
msgctxt "text_id=10280 | speaker=unknown"
msgid "  She rubbed the back of her head, apparently angry at herself for getting involved in something that was none of her business."
msgstr "　我が事のように愚痴りながら頭をかく。"

#. Occurrence 7_EX:5074:10281: scene=7_EX
#: 7_EX:5074
msgctxt "text_id=10281 | speaker=unknown"
msgid "  She and Soujyuro were not even in the same class at school; he was a total stranger as far as she was concerned."
msgstr "　久万梨からすれば草十郎は赤の他人で、同じクラスの仲間でもない。"

#. Occurrence 7_EX:5079:10282: scene=7_EX
#: 7_EX:5079
msgctxt "text_id=10282 | speaker=unknown"
msgid "  The more something bothered her, the more she felt compelled to investigate it. It was a personal quirk of hers and the only reason she had gotten so worked up about the passenger pigeons."
msgstr "　リョコウバトの話に熱が入ったのは、嫌いなコトの話ほど熱心に調べてしまう彼女の悪癖の結果である。"

#. Occurrence 7_EX:5104:10283: scene=7_EX
#: 7_EX:5104
msgctxt "text_id=10283 | speaker=unknown"
msgid "  Kumari's well-groomed brow furrowed."
msgstr "　カタチのいい眉をひそめる。"

#. Occurrence 7_EX:5109:10284: scene=7_EX
#: 7_EX:5109
msgctxt "text_id=10284 | speaker=unknown"
msgid "  She had only spoken to Soujyuro to make sure he was doing okay at The Mad Bear. Or maybe, it was that she had been strangely drawn to him."
msgstr "　まっどべあで働く以上、ヘンな悩みを抱えて欲しくないので話し相手になったが、あるいは、あの少年に妙な磁力があるのだろうか？"

#. Occurrence 7_EX:5114:10285: scene=7_EX
#: 7_EX:5114
msgctxt "text_id=10285 | speaker=unknown"
msgid "  The more they spoke the more she felt drawn to him."
msgstr "　話せば話すほど深みに<嵌|はま>っている気がする。"

#. Occurrence 7_EX:5148:10286: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0104; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:5148
msgctxt "text_id=10286 | speaker=kojika"
msgid "\"At first glance he looks like the last guy you would rely on, but when you get to talking to him you realize he's really got it together.\""
msgstr "「まあ、見てて頼りないってのが一番だろうけど……話してみるとしっかりしすぎてるのよね、彼」"

#. Occurrence 7_EX:5154:10287: scene=7_EX
#: 7_EX:5154
msgctxt "text_id=10287 | speaker=unknown"
msgid "  Amidst her muttered complaints she recalled their conversation upon parting."
msgstr "　久万梨はそうぼやきながら、別れ際の会話を思い出した。"

#. Occurrence 7_EX:5198:10288: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0105; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:5198
msgctxt "text_id=10288 | speaker=kojika"
msgid "\"So, gotten used to everything yet?\""
msgstr "“で、少しは町に慣れた？”"

#. Occurrence 7_EX:5204:10289: scene=7_EX
#: 7_EX:5204
msgctxt "text_id=10289 | speaker=unknown"
msgid "  to which he had given a weak shake of his head."
msgstr "　そう訊いた久万梨に、草十郎は頼りなげに首を振った。"

#. Occurrence 7_EX:5241:10290: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0034; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:5241
msgctxt "text_id=10290 | speaker=soujuurou"
msgid "\"Not at all. There are so many things to keep track of.\""
msgstr "“全然。何にせよ、覚えなくちゃいけない事が多すぎて”"

#. Occurrence 7_EX:5247:10291: scene=7_EX
#: 7_EX:5247
msgctxt "text_id=10291 | speaker=unknown"
msgid "  He was trying his best to keep up with the overwhelming amount of new information every day."
msgstr "　日々新しい出会いがあって、それを飲みこむだけで手一杯。"

#. Occurrence 7_EX:5252:10292: scene=7_EX
#: 7_EX:5252
msgctxt "text_id=10292 | speaker=unknown"
msgid "  However, despite his apparent naivety and frailty, he was in fact trying to learn everything he could about his new surroundings."
msgstr "　あの純朴な少年は弱々しく見えるものの、町のすべてを受け入れようと全力で立っているのだ。"

#. Occurrence 7_EX:5272:10293: scene=7_EX
#: 7_EX:5272
msgctxt "text_id=10293 | speaker=unknown"
msgid "  But at the same, there was no reason it needed to be so overwhelming in the first place."
msgstr "　しかし―――日々新しい出会いがある、というのは大仰すぎるのではないか。"

#. Occurrence 7_EX:5277:10294: scene=7_EX
#: 7_EX:5277
msgctxt "text_id=10294 | speaker=unknown"
msgid "  It was only due to his own naively subordinate frame of mind that he felt compelled to memorize each and every detail."
msgstr "　出会ったものを一つも取り落とさないよう努力するのは、彼が素直すぎるからだ。"

#. Occurrence 7_EX:5303:10295: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0035; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:5303
msgctxt "text_id=10295 | speaker=soujuurou"
msgid "\"I wonder...I don't think I'm exactly being subordinate."
msgstr "“どうだろう。素直って言うのはちょっと違うと思うよ。"

#. Occurrence 7_EX:5309:10296: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0036; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:5309
msgctxt "text_id=10296 | speaker=soujuurou"
msgid "  The fact is I'm still just figuring out what's right and wrong.\""
msgstr "　単に、それが良いことか悪いことか、まだ分かってないだけかもしれないし”"

#. Occurrence 7_EX:5315:10297: scene=7_EX
#: 7_EX:5315
msgctxt "text_id=10297 | speaker=unknown"
msgid "  He awkwardly claimed."
msgstr "　彼はばつが悪そうに返す。"

#. Occurrence 7_EX:5350:10298: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0106; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:5350
msgctxt "text_id=10298 | speaker=kojika"
msgid "\"Right. But, maybe... Just maybe...\""
msgstr "“そうね。でも、もしかしたら、そもそも―――”"

#. Occurrence 7_EX:5356:10299: scene=7_EX
#: 7_EX:5356
msgctxt "text_id=10299 | speaker=unknown"
msgid "  Kumari stopped herself mid-train of thought, deciding to instead wave goodbye and take her leave."
msgstr "　そこまで言いかけて、久万梨はまた今度、と手を振って別れる事にした。"

#. Occurrence 7_EX:5399:10300: scene=7_EX
#: 7_EX:5399
msgctxt "text_id=10300 | speaker=unknown"
msgid "  She sighed aloud every time she replayed the scene in her head."
msgstr "　思い返すとますますため息がでてきた。"

#. Occurrence 7_EX:5404:10301: scene=7_EX
#: 7_EX:5404
msgctxt "text_id=10301 | speaker=unknown"
msgid "  Work at the convenience store started in five minutes."
msgstr "　コンビニエンスストアのアルバイトまであと五分ほど。"

#. Occurrence 7_EX:5409:10302: scene=7_EX
#: 7_EX:5409
msgctxt "text_id=10302 | speaker=unknown"
msgid "  She gave herself a light slap on the face in an effort to forget their conversation."
msgstr "　久万梨は頬を叩いて先ほどの会話を飲み下す。"

#. Occurrence 7_EX:5414:10303: scene=7_EX
#: 7_EX:5414
msgctxt "text_id=10303 | speaker=unknown"
msgid "  She reminded herself that she had neither the energy to worry about other people's problems nor the obligation to do so."
msgstr "　他人のコトで気を病む余裕も、考察にふける義理もない。"

#. Occurrence 7_EX:5419:10304: scene=7_EX
#: 7_EX:5419
msgctxt "text_id=10304 | speaker=unknown"
msgid "  She had her own concerns-saving up enough money for college, for example."
msgstr "　彼女は彼女で、大学進学の費用を貯める野望がある。"

#. Occurrence 7_EX:5424:10305: scene=7_EX
#: 7_EX:5424
msgctxt "text_id=10305 | speaker=unknown"
msgid "  Fighting against her parents' opposition every night was draining enough. There was no room for burdening herself with other students' issues."
msgstr "　<日夜|にちや>両親の反対と戦う久万梨金鹿にとって、同級生の悩みなど二の次だ。"

#. Occurrence 7_EX:5457:10306: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0107; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:5457
msgctxt "text_id=10306 | speaker=kojika"
msgid "\"Right. But, maybe... Just maybe...\""
msgstr "「……でも、もしかしたら、そもそも、か」"

#. Occurrence 7_EX:5463:10307: scene=7_EX
#: 7_EX:5463
msgctxt "text_id=10307 | speaker=unknown"
msgid "  It was not like her to get so tongue-tied, she thought to herself under a strained smile."
msgstr "　我ながらなんて思わせぶりで、実のない言い回しかと苦笑いする。"

#. Occurrence 7_EX:5489:10308: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0108; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:5489
msgctxt "text_id=10308 | speaker=kojika"
msgid "\"I should have made my point more clearly."
msgstr "「ほんと、はっきり言ってやればよかった。"

#. Occurrence 7_EX:5495:10309: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0109; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:5495
msgctxt "text_id=10309 | speaker=kojika"
msgid "  I should have flat-out asked him if he cares at all about human morality.\""
msgstr "　貴方は単に、<人の善悪|そういうの>に関わる気が、これっぽっちもないんじゃないのかって」"

#. Occurrence 7_EX:5501:10310: scene=7_EX
#: 7_EX:5501
msgctxt "text_id=10310 | speaker=unknown"
msgid "  He really did annoy her."
msgstr "　だからアイツ嫌いなのよ、と。"

#. Occurrence 7_EX:5506:10311: scene=7_EX
#: 7_EX:5506
msgctxt "text_id=10311 | speaker=unknown"
msgid "  Now in a thoroughly bad mood, she left the park in a huff."
msgstr "　悪態にもとれるため息をこぼして、彼女は公園を後にした。"

#. Occurrence 7_EX:5606:10312: scene=7_EX
#: 7_EX:5606
msgctxt "text_id=10312 | speaker=unknown"
msgid "  When Soujyuro entered the drawing room after work with a gift of sardines for his roommates, he came face to face with Alice sitting on the sofa."
msgstr "　草十郎がアルバイトを終え、土産の<鰯|いわし>を片手に居間に入ると、ソファーには有珠の姿があった。"

#. Occurrence 7_EX:5637:10313: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0037; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:5637
msgctxt "text_id=10313 | speaker=soujuurou"
msgid "\"Oh, err... Hi, Alice.\""
msgstr "「や。こんばんは、有珠」"

#. Occurrence 7_EX:5648:10314: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0038; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:5648
msgctxt "text_id=10314 | speaker=soujuurou"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 7_EX:5653:10315: scene=7_EX
#: 7_EX:5653
msgctxt "text_id=10315 | speaker=unknown"
msgid "  The sense of familiarity to be able to say \"I'm home\" when entering the mansion still eluded Soujyuro."
msgstr "　さすがの草十郎も、まだ「ただいま」と言えるだけの親しみはないらしい。"

#. Occurrence 7_EX:5684:10316: scene=7_EX
#: 7_EX:5684
msgctxt "text_id=10316 | speaker=unknown"
msgid "  He headed straight to the kitchen to fill a bucket with water to keep the sardines fresh,"
msgstr "　草十郎はそのまま台所に移動し、バケツに水を溜めて魚を保存しようとして、"

msgctxt "text_id=10317 | speaker=unknown"
msgid " but the icy stare on his back sent him anxiously to the refrigerator instead."
msgstr "背後からイヤそうな視線を感じ、しずしずと冷蔵庫を開けた。"

#. Occurrence 7_EX:5717:10318: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0039; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:5717
msgctxt "text_id=10318 | speaker=soujuurou"
msgid "(Buckets are not allowed in the kitchen, remember?)"
msgstr "『台所にバケツはダメなんだな……』"

#. Occurrence 7_EX:5722:10319: scene=7_EX
#: 7_EX:5722
msgctxt "text_id=10319 | speaker=unknown"
msgid "  Calmly accepting the change in plans, he shoved the sardines into the fridge and peeked back into the drawing room."
msgstr "　仕方ない、とお手軽に魚を冷蔵庫にしまって、草十郎は居間の様子を窺った。"

#. Occurrence 7_EX:5748:10320: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0040; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:5748
msgctxt "text_id=10320 | speaker=soujuurou"
msgid "\"Alice, have you seen Aozaki?\""
msgstr "「有珠、蒼崎は？」"

#. Occurrence 7_EX:5768:10321: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_EX_9000; voice_prefix=A40; voice_category=2; scene=7_EX
#: 7_EX:5768
msgctxt "text_id=10321 | speaker=alice"
msgid "\"Well, either she's in her room or she's gone out somewhere.\""
msgstr "「さあ。自分の部屋にいるか、出かけているんでしょう」"

#. Occurrence 7_EX:5774:10322: scene=7_EX
#: 7_EX:5774
msgctxt "text_id=10322 | speaker=unknown"
msgid "  Her reply was curt."
msgstr "　にべもなく返される。"

#. Occurrence 7_EX:5792:10323: scene=7_EX
#: 7_EX:5792
msgctxt "text_id=10323 | speaker=unknown"
msgid "  He nodded and got to work cleaning the kitchen."
msgstr "　そうかと頷いて、草十郎はやや散らかった台所を片づけはじめた。"

#. Occurrence 7_EX:5797:10324: scene=7_EX
#: 7_EX:5797
msgctxt "text_id=10324 | speaker=unknown"
msgid "  There was nothing in particular he wanted to say to her and also sensed that it would not be a good idea to start up a conversation needlessly."
msgstr "　特に話題もないし、無理に話をする必要性も感じなかったからだろう。"

#. Occurrence 7_EX:5817:10325: scene=7_EX
#: 7_EX:5817
msgctxt "text_id=10325 | speaker=unknown"
msgid "  So he tidied up the sink area, washed the cutting board, wiped down the knives, and put away the cutlery so they could be easily found."
msgstr "　水回りを片づけ、まな板を洗い、包丁を拭き、食器を調理時に出しやすい位置に整理整頓する。"

#. Occurrence 7_EX:5822:10326: scene=7_EX
#: 7_EX:5822
msgctxt "text_id=10326 | speaker=unknown"
msgid "  Her black eyes monitored every action in his streamlined work flow,"
msgstr "　そんな、いずれ凄腕のハウスキーパーになる事を約束された、よどみのない作業っぷりを、"

#. Occurrence 7_EX:5843:10327: scene=7_EX
#: 7_EX:5843
msgctxt "text_id=10327 | speaker=unknown"
msgid "  a rhythm that even the most seasoned housekeeper would be envious of."
msgstr "　じっと観察する黒い目が、二つ。"

#. Occurrence 7_EX:5863:10328: scene=7_EX
#: 7_EX:5863
msgctxt "text_id=10328 | speaker=unknown"
msgid "  He would surely notice her gaze before too long."
msgstr "　草十郎がその視線に気が付くのは時間の問題だ。"

#. Occurrence 7_EX:5882:10329: scene=7_EX
#: 7_EX:5882
msgctxt "text_id=10329 | speaker=unknown"
msgid "  He bent over to store a large pot under the sink when it happened."
msgstr "　身をかがめて、台所の収納に<寸胴|ずんどう>をしまう。"

#. Occurrence 7_EX:5887:10330: scene=7_EX
#: 7_EX:5887
msgctxt "text_id=10330 | speaker=unknown"
msgid "  As he began to stand back up he locked eyes with Alice, and then..."
msgstr "　そのまま立ち上がれば、居間にいる有珠と視線がばったり合って、"

#. Occurrence 7_EX:5922:10331: voice_id=BA0_7_EX_0000; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:5922
msgctxt "text_id=10331 | speaker=unknown"
msgid "\"MAYDAY! MAYDAY!"
msgstr "『メェーーーデーーーっすよーーーー！"

#. Occurrence 7_EX:5922:10332: voice_id=BA0_7_EX_0000; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:5922
msgctxt "text_id=10332 | speaker=unknown"
msgid "  Sling yer hook, boy!\""
msgstr "　小僧、今すぐロビーに顔を貸すっスーー！』"

#. Occurrence 7_EX:5969:10333: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0041; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:5969
msgctxt "text_id=10333 | speaker=soujuurou"
msgid "\"Owww!\""
msgstr "「あいたっ」"

#. Occurrence 7_EX:5975:10334: scene=7_EX
#: 7_EX:5975
msgctxt "text_id=10334 | speaker=unknown"
msgid "  Before he could make another move,"
msgstr "　その直前。"

#. Occurrence 7_EX:5981:10335: scene=7_EX
#: 7_EX:5981
msgctxt "text_id=10335 | speaker=unknown"
msgid " he felt something slam into the back of his head―a bright shock of blue."
msgstr "立ち上がろうとした草十郎の後頭部に、青い衝撃が突き刺さった。"

#. Occurrence 7_EX:6001:10336: scene=7_EX
#: 7_EX:6001
msgctxt "text_id=10336 | speaker=unknown"
msgid "  He knew what it was without looking."
msgstr "　確かめるまでもない。"

#. Occurrence 7_EX:6035:10337: scene=7_EX
#: 7_EX:6035
msgctxt "text_id=10337 | speaker=unknown"
msgid "  It could only be the mansion's blue robin."
msgstr "　洋館内せましと飛び回る、青い駒鳥だった。"

#. Occurrence 7_EX:6071:10338: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0042; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:6071
msgctxt "text_id=10338 | speaker=soujuurou"
msgid "\"Why does that thing have to start messing with me as soon as I get home?\""
msgstr "「……洋館に戻ってくるなり、駒鳥に呼び出される」"

#. Occurrence 7_EX:6077:10339: scene=7_EX
#: 7_EX:6077
msgctxt "text_id=10339 | speaker=unknown"
msgid "  Soujyuro muttered under his breath."
msgstr "　ぼそっと呟く。"

#. Occurrence 7_EX:6082:10340: scene=7_EX
#: 7_EX:6082
msgctxt "text_id=10340 | speaker=unknown"
msgid "  It was a rare situation that made Soujyuro feel like complaining."
msgstr "　草十郎なりに、誰かにグチを言いたい気分だったのだろう。"

#. Occurrence 7_EX:6118:10341: voice_id=BA0_7_EX_0001; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6118
msgctxt "text_id=10341 | speaker=unknown"
msgid "\"Pull up a chair, boy!\""
msgstr "『小僧、ちょっとそこに座るッス』"

#. Occurrence 7_EX:6124:10342: scene=7_EX
#: 7_EX:6124
msgctxt "text_id=10342 | speaker=unknown"
msgid "  The robin chirped in its shrill tone."
msgstr "　チチチと駒鳥はさえずる。"

#. Occurrence 7_EX:6129:10343: scene=7_EX
#: 7_EX:6129
msgctxt "text_id=10343 | speaker=unknown"
msgid "  You see..."
msgstr "　……さて。"

#. Occurrence 7_EX:6134:10344: scene=7_EX
#: 7_EX:6134
msgctxt "text_id=10344 | speaker=unknown"
msgid "  This little creature that loved to attack Soujyuro so, was the greatest of the mansion's many wonders."
msgstr "　実のところ、<頻繁|ひんぱん>に激突してくるコレこそが洋館の七不思議、その最たるものだった。"

#. Occurrence 7_EX:6139:10345: scene=7_EX
#: 7_EX:6139
msgctxt "text_id=10345 | speaker=unknown"
msgid "  And with good reason."
msgstr "　なぜなら、"

#. Occurrence 7_EX:6189:10346: voice_id=BA0_7_EX_0002; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6189
msgctxt "text_id=10346 | speaker=unknown"
msgid "\"Are you havin' a bird bath, mate? You think you're better than me, ey? And what the bloody hell is chicken stew supposed to mean anyway? You got somefink against a Richard the Third?\""
msgstr "『なめてるっすね？　ジブン駒鳥だってなめてるッスね？　ところで鳥鍋ってどういうコトっすか、それ美味しいんっスか、今度みまってほしいッス！』"

#. Occurrence 7_EX:6195:10347: scene=7_EX
#: 7_EX:6195
msgctxt "text_id=10347 | speaker=unknown"
msgid "  Like so."
msgstr "　この通り。"

#. Occurrence 7_EX:6200:10348: scene=7_EX
#: 7_EX:6200
msgctxt "text_id=10348 | speaker=unknown"
msgid "  Soujyuro had an inkling of what the bird was getting at."
msgstr "　駒鳥が何を伝えたいのか、草十郎にはなんとなく分かってしまうのだ。"

#. Occurrence 7_EX:6236:10349: scene=7_EX
#: 7_EX:6236
msgctxt "text_id=10349 | speaker=unknown"
msgid "  For someone raised in the mountains this was an utter nightmare."
msgstr "　山育ちの草十郎にとって、これこそが悪夢だった。"

#. Occurrence 7_EX:6241:10350: scene=7_EX
#: 7_EX:6241
msgctxt "text_id=10350 | speaker=unknown"
msgid "  Animals were not supposed to be able to talk."
msgstr "　しゃべる動物なんて聞いた事もない。"

#. Occurrence 7_EX:6246:10351: scene=7_EX
#: 7_EX:6246
msgctxt "text_id=10351 | speaker=unknown"
msgid "  Then again, having lived in the mountains for over a decade he did sometimes feel like he could understand what birds were trying to say. He knew it was just his imagination, but sometimes he thought they even saw him as a friend."
msgstr "　そりゃあ、ごく<希|まれ>に、十年以上も山で暮らしていれば鳥の気持ちが分かるような時はある。もちろん錯覚だが、ちょっとだけ友情を感じる時もあった。"

#. Occurrence 7_EX:6266:10352: scene=7_EX
#: 7_EX:6266
msgctxt "text_id=10352 | speaker=unknown"
msgid "  That was not the case with this bird."
msgstr "　だがこれはない。"

#. Occurrence 7_EX:6271:10353: scene=7_EX
#: 7_EX:6271
msgctxt "text_id=10353 | speaker=unknown"
msgid "  Soujyuro had a realist's attitude toward wild animals as a result of being so familiar with them, in contrast to the ever mysterious humans who lived in the city."
msgstr "　都会人より動物に馴れている分、草十郎は野<生動|かれら>物に対しては徹底的なリアリストなのである。"

#. Occurrence 7_EX:6302:10354: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0043; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:6302
msgctxt "text_id=10354 | speaker=soujuurou"
msgid "\"It's... really talking to me.\""
msgstr "「しかし、現実だ」"

#. Occurrence 7_EX:6308:10355: scene=7_EX
#: 7_EX:6308
msgctxt "text_id=10355 | speaker=unknown"
msgid "  As much as he wanted to deny the reality he was facing, he could not help but recall Kumari's story."
msgstr "　頭を抱えて無視したいところだが、久万梨に聞いた話が脳裏をよぎる。"

#. Occurrence 7_EX:6313:10356: scene=7_EX
#: 7_EX:6313
msgctxt "text_id=10356 | speaker=unknown"
msgid "  She had said to try and be nice to the bird the next time he saw it."
msgstr "　鳥には優しく。"

#. Occurrence 7_EX:6318:10357: scene=7_EX
#: 7_EX:6318
msgctxt "text_id=10357 | speaker=unknown"
msgid "  According to her, any rare or one-of-a-kind creature must accordingly feel very lonely."
msgstr "　それが珍しいものなら、珍しいものなりに孤独を抱えているのだとか、なんとか。"

#. Occurrence 7_EX:6355:10358: voice_id=BA0_7_EX_0003; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6355
msgctxt "text_id=10358 | speaker=unknown"
msgid "\"I said sit your pipe and drum down! You hearin' me all right, mate?"
msgstr "『座れって言ってるのにシカトっすか。"

#. Occurrence 7_EX:6361:10359: voice_id=BA0_7_EX_0004; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6361
msgctxt "text_id=10359 | speaker=unknown"
msgid "  Hang on, there's no chair in 'ere! All right, just stand. I mean, I've stood up with you enough for the both of us!"
msgstr "　あ、でもイスないッスねココ。じゃあ立ってるッス。小坊主だけに、廊下に立ってるのがお似合いッス。"

#. Occurrence 7_EX:6367:10360: voice_id=BA0_7_EX_0005; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6367
msgctxt "text_id=10360 | speaker=unknown"
msgid "  Get it? Pretty clever, if I say so myself!\""
msgstr "　あれ、いまウマイこと言ったっスかねジブン！？』"

#. Occurrence 7_EX:6414:10361: scene=7_EX
#: 7_EX:6414
msgctxt "text_id=10361 | speaker=unknown"
msgid "  The bird perched itself on the telephone receiver, seemingly worn out from all the flapping."
msgstr "　羽ばたいているのも疲れたのか、駒鳥は受話器の横に着陸する。"

#. Occurrence 7_EX:6419:10362: scene=7_EX
#: 7_EX:6419
msgctxt "text_id=10362 | speaker=unknown"
msgid "  Soujyuro was dumbfounded."
msgstr "　草十郎に打つ手はない。"

#. Occurrence 7_EX:6424:10363: scene=7_EX
#: 7_EX:6424
msgctxt "text_id=10363 | speaker=unknown"
msgid "  Listening in silence to the bird's chatter was his way of expressing his denial."
msgstr "　基本、この鳥の鳴き声を聞くだけが対抗手段なのだった。"

#. Occurrence 7_EX:6494:10364: voice_id=BA0_7_EX_0006; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6494
msgctxt "text_id=10364 | speaker=unknown"
msgid "\"I'm pretty old, ya know, on account of me long career as a Ploy."
msgstr "『ジブン長いッス。プロイ<歴|れき>長いッスよ。"

#. Occurrence 7_EX:6501:10365: voice_id=BA0_7_EX_0007; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6501
msgctxt "text_id=10365 | speaker=unknown"
msgid "I've served Miss Alice from when the Goddess Mum was around. Don't ask why I'm blue."
msgstr "マイ女神の頃からアリスさんに仕えてるっス。なんで青いかとかどうでもいいっス。"

#. Occurrence 7_EX:6513:10366: voice_id=BA0_7_EX_0008; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6513
msgctxt "text_id=10366 | speaker=unknown"
msgid "My best skills are playin' the detective and the victim. But my detective side always dies first so no one can ever figure out who killed me!\""
msgstr "特技はズバリ探偵役と被害者役。でも探偵であるジブンが真っ先にコロコロするんで、誰がジブンを殺したか、結局誰も分からないッス』"

#. Occurrence 7_EX:6532:10367: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0044; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:6532
msgctxt "text_id=10367 | speaker=soujuurou"
msgid "\"Wait, you're a Ploy? I've heard that word before. What does it mean again?\""
msgstr "「プロイ？　待ってくれ、それには聞き覚えがある。プロイってなんなんだ？」"

#. Occurrence 7_EX:6571:10368: voice_id=BA0_7_EX_0009; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6571
msgctxt "text_id=10368 | speaker=unknown"
msgid "\"Say what? Is you askin' what I is?"
msgstr "『？？？　なんなんだと言われても困るッス。"

#. Occurrence 7_EX:6577:10369: voice_id=BA0_7_EX_0010; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6577
msgctxt "text_id=10369 | speaker=unknown"
msgid "  I don't know what to feel right now―sexy or terrified!\""
msgstr "　エロイ、とかヤクイ、とかの最上級じゃないっスか？』"

#. Occurrence 7_EX:6606:10370: scene=7_EX
#: 7_EX:6606
msgctxt "text_id=10370 | speaker=unknown"
msgid "  Thusly, the conversation began between the two most powerless residents of the Kuonji Estate."
msgstr "　ふむふむと話し合う久遠寺邸最弱のコンビ。"

#. Occurrence 7_EX:6611:10371: scene=7_EX
#: 7_EX:6611
msgctxt "text_id=10371 | speaker=unknown"
msgid "  Humankind and birdkind, able to"
msgstr "　かくして、"

#. Occurrence 7_EX:6616:10372: scene=7_EX
#: 7_EX:6616
msgctxt "text_id=10372 | speaker=unknown"
msgid "  understand one another after all."
msgstr "　鳥と人間は分かり合えたらしい。"

#. Occurrence 7_EX:6636:10373: scene=7_EX
#: 7_EX:6636
msgctxt "text_id=10373 | speaker=unknown"
msgid "  Soujyuro was tired of letting the bird get to him, fully aware that ignoring it took more energy than it was worth."
msgstr "　いちいち悩むのも疲れたのか、無視するのも体力がいると気が付いたのか。"

#. Occurrence 7_EX:6641:10374: scene=7_EX
#: 7_EX:6641
msgctxt "text_id=10374 | speaker=unknown"
msgid "  Filled with a sense of resignation, by the time he finally did make an attempt to interject, both parties' guards were firmly down."
msgstr "　観念した草十郎が合いの手を入れはじめたところ、二人はすっかりうち解けていた。"

#. Occurrence 7_EX:6647:10375: scene=7_EX
#: 7_EX:6647
msgctxt "text_id=10375 | speaker=unknown"
msgid "  Soujyuro was focused on how rare the bird was,"
msgstr "　草十郎は珍しい話し相手として、"

#. Occurrence 7_EX:6652:10376: scene=7_EX
#: 7_EX:6652
msgctxt "text_id=10376 | speaker=unknown"
msgid "  while Robin was focused on his showdown with his rival that was to be eliminated at all costs."
msgstr "　駒鳥は<排斥|はいせき>すべきライバルとして、ではあるが。"

#. Occurrence 7_EX:6689:10377: voice_id=BA0_7_EX_0011; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6689
msgctxt "text_id=10377 | speaker=unknown"
msgid "\"Don't get your knickers in a twist. Let's talk about something more important, like my beloved Miss Alice! The Angel Mum herself!\""
msgstr "『いいんスよ、細けぇ事は。そんなコトよりマイ天使・アリスさんの話をするッス』"

#. Occurrence 7_EX:6731:10378: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0045; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:6731
msgctxt "text_id=10378 | speaker=soujuurou"
msgid "\"Wait. She's an angel?\""
msgstr "「なんと。有珠って天使なのか？」"

#. Occurrence 7_EX:6737:10379: scene=7_EX
#: 7_EX:6737
msgctxt "text_id=10379 | speaker=unknown"
msgid "  It was an impressive sign of progress that he did not need to ask what an \"angel\" was."
msgstr "　ところで天使ってなんだ、と続けないあたり、草十郎にも学習の跡が見られる。"

#. Occurrence 7_EX:6758:10380: voice_id=BA0_7_EX_0012; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6758
msgctxt "text_id=10380 | speaker=unknown"
msgid "\"Aye bruv, an angel! The way she's above the hustle and bustle of the masses, the way she doesn't give me the time of day... Absolutely angelic, I tell ya!"
msgstr "『ヒユっす。ジブンにとって天使のような存在ってコトっす。下界の喧噪とか、ジブンの言葉をガン無視するところとかマジ天使。"

#. Occurrence 7_EX:6769:10381: voice_id=BA0_7_EX_0013; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6769
msgctxt "text_id=10381 | speaker=unknown"
msgid "  She's holy and sacred she is, but she's also cruel and inhuman. Pretty fittin' for an angel, don't you think?"
msgstr "　アリスさんは神聖<不可侵|ふかしん>にして冷酷非道。マイ女神であったところの<母君|ははぎみ>とはちょっと、毛色が違うッス。"

#. Occurrence 7_EX:6775:10382: voice_id=BA0_7_EX_0014; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6775
msgctxt "text_id=10382 | speaker=unknown"
msgid "  Honestly, sometimes I think Goddess Mum didn't do the best job raisin' Angel Mum.\""
msgstr "　ショージキ<女神|ははぎみ>、ちょっと育てかた間違ったッスね』"

#. Occurrence 7_EX:6819:10383: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0046; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:6819
msgctxt "text_id=10383 | speaker=soujuurou"
msgid "\"Okay... So Alice has a mom?"
msgstr "「そうか。そりゃあ有珠にもお母さんはいるんだよな。"

#. Occurrence 7_EX:6825:10384: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0047; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:6825
msgctxt "text_id=10384 | speaker=soujuurou"
msgid "  I thought maybe she didn't have any family at all.\""
msgstr "　この家にはいないようだけど」"

#. Occurrence 7_EX:6848:10385: voice_id=BA0_7_EX_0015; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6848
msgctxt "text_id=10385 | speaker=unknown"
msgid "\"Oh yes, she has one all right, but it's a sob story, innit? All the birds in England cried out that day! Her mum was even more smashing than Alice. Gots photos later if you like. Fer only sixpence! How 'bout it, lad?\""
msgstr "『イエス、悲しいコトにみまかられたっス。あの頃は全英の鳥が泣いたッス。アリスさんに負けないぐらい美しかったッス。あ、後でアルバムとか見るッスか？　６ペンスで手を打つッスよ』"

#. Occurrence 7_EX:6883:10386: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0048; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:6883
msgctxt "text_id=10386 | speaker=soujuurou"
msgid "\"Uh, no thanks. I wouldn't want to do that without her permission.\""
msgstr "「いや。そういうのは、本人の許しがないと」"

#. Occurrence 7_EX:6889:10387: scene=7_EX
#: 7_EX:6889
msgctxt "text_id=10387 | speaker=unknown"
msgid "  Soujyuro said earnestly as he tilted his head."
msgstr "　いけないんじゃないかな？　と首をかしげる草十郎。"

#. Occurrence 7_EX:6894:10388: scene=7_EX
#: 7_EX:6894
msgctxt "text_id=10388 | speaker=unknown"
msgid "  The reason for his unease was also due to the fact that he had grown more interested in Alice than before."
msgstr "　やや弱気なのは、以前と比べて有珠への興味が高まっているせいだ。"

#. Occurrence 7_EX:6899:10389: scene=7_EX
#: 7_EX:6899
msgctxt "text_id=10389 | speaker=unknown"
msgid "  Despite his detached and passive attitude, he was still a young man like any other, after all."
msgstr "　人畜無害な顔をして、彼も健康な青年男子であるらしい。"

#. Occurrence 7_EX:6941:10390: voice_id=BA0_7_EX_0016; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6941
msgctxt "text_id=10390 | speaker=unknown"
msgid "\"And right you'd be, lad."
msgstr "『イエス、それはそうッスね。"

#. Occurrence 7_EX:6947:10391: voice_id=BA0_7_EX_0017; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6947
msgctxt "text_id=10391 | speaker=unknown"
msgid "  You know, you make sum sense for a feral human. You're right, I shouldn't go blabbin' about people's pasts."
msgstr "　おまえ、シャバ僧のわりにいいコト言うッス。人の<過去話|カコバナ>とかみだりにしちゃいけないッス。"

#. Occurrence 7_EX:6953:10392: voice_id=BA0_7_EX_0018; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6953
msgctxt "text_id=10392 | speaker=unknown"
msgid "  But maybe you'd 'ike to hear about her childhood! How 'bout it, lad? I'd love to lay bare some of her deepest, darkest secrets for ya. It'd make me feel like a heap 'o dosh!\""
msgstr "　―――ところでアリスさんの子供時代の話とかしていいっスか？　ジブン、シャバ僧の知らないアリスさんを<赤裸々|せきらら>にアピールして、精神的上位に立ちたいッス』"

#. Occurrence 7_EX:6964:10393: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0049; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:6964
msgctxt "text_id=10393 | speaker=soujuurou"
msgid "\"Err... I just said I don't want to-\""
msgstr "「あ、いや、だからそういう話は」"

#. Occurrence 7_EX:7010:10394: voice_id=BA0_7_EX_0019; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7010
msgctxt "text_id=10394 | speaker=unknown"
msgid "\"Lighten up, lad. I won't tell Alice about our little rabbit and pork."
msgstr "『安心しろっス、アリスさんには黙っておいてやるっスから。"

#. Occurrence 7_EX:7017:10395: voice_id=BA0_7_EX_0020; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7017
msgctxt "text_id=10395 | speaker=unknown"
msgid "Let me start with the day we first met. Despite 'er looks she didn't have so much as a single friend in the world, ya see. I was the only one that mother 'o pearl had to talk to."
msgstr "まずはアレすね、ジブンとアリスさんが初めて出会った時のメモリーを聞くっスよ。アリスさんああ見えて友達一人しかいなかったッスから、もっぱらジブンが話し相手っつーか。"

#. Occurrence 7_EX:7023:10396: voice_id=BA0_7_EX_0021; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7023
msgctxt "text_id=10396 | speaker=unknown"
msgid "  Imagine playin' that game where you bounce a ball against a wall by your lonesome. It was just like that. Fourteen years of memories with her, I have. So lemme start at the beginning...\""
msgstr "　ほら、壁相手にカコンカコーンってピンポン玉打ち返すゲーム。あんな感じっス。アリスさんのメモリーはおよそ十四年分。じゃあ一年目から行くッスよ』"

#. Occurrence 7_EX:7049:10397: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0050; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:7049
msgctxt "text_id=10397 | speaker=soujuurou"
msgid "\"I just said-\""
msgstr "「あ、いや、だから」"

#. Occurrence 7_EX:7075:10398: voice_id=BA0_7_EX_0022; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7075
msgctxt "text_id=10398 | speaker=unknown"
msgid "\"Here we go!"
msgstr "『行くッスよー！"

#. Occurrence 7_EX:7081:10399: voice_id=BA0_7_EX_0023; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7081
msgctxt "text_id=10399 | speaker=unknown"
msgid "  Buckle in 'cause this is gonna get good!\""
msgstr "　もう誰もジブンを止められないッスー！』"

#. Occurrence 7_EX:7115:10400: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0051; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:7115
msgctxt "text_id=10400 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――っ」"

#. Occurrence 7_EX:7121:10401: scene=7_EX
#: 7_EX:7121
msgctxt "text_id=10401 | speaker=unknown"
msgid "  This bird was trouble."
msgstr "　この鳥は、まずい。"

#. Occurrence 7_EX:7126:10402: scene=7_EX
#: 7_EX:7126
msgctxt "text_id=10402 | speaker=unknown"
msgid "  The word \"bird-brained\" had taken on a whole new meaning to Soujyuro."
msgstr "　<鳥頭|とりあたま>にも程がある。"

#. Occurrence 7_EX:7131:10403: scene=7_EX
#: 7_EX:7131
msgctxt "text_id=10403 | speaker=unknown"
msgid "  If he were stuck here listening any longer, he had the feeling he might hear something he would not be able to unhear."
msgstr "　加えて、このまま話を聞いていたら取り返しのつかないコトになる、と察する草十郎だった。"

#. Occurrence 7_EX:7164:10404: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0052; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:7164
msgctxt "text_id=10404 | speaker=soujuurou"
msgid "\"Sorry, but I should really get going.\""
msgstr "「すまない。そろそろいいかな」"

#. Occurrence 7_EX:7172:10405: scene=7_EX
#: 7_EX:7172
msgctxt "text_id=10405 | speaker=unknown"
msgid "  With a wave of his hand he attempted to flee to the attic above the second floor."
msgstr "　草十郎は手をあげて、じゃあ、と三階の屋根裏部屋への逃走を試みた。"

#. Occurrence 7_EX:7207:10406: voice_id=BA0_7_EX_0024; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7207
msgctxt "text_id=10406 | speaker=unknown"
msgid "\"Now wait just one minute, boy! You're about to miss the best part! Who do you think you are, Scarlet O'Hara? You think you're the most important character in this war?!"
msgstr "『ちょっ、待つッスーーー！　ここからがいいところなのにナンデ去るっスか。スカーレットオハラっすか。激動の主人公気取りっスか！"

#. Occurrence 7_EX:7218:10407: voice_id=BA0_7_EX_0025; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7218
msgctxt "text_id=10407 | speaker=unknown"
msgid "  You're not foolin' me, that's for sure. What's a saucepan and lid like you gettin' all Angel Mum's attention? Why, you're all she looks at. I can't stand it! So you'd better tell me your secret! I'm serious, and you ne'er wanna see me get serious!\""
msgstr "　そのあたりジブン、なんか納得いかないッス。まだうちに入ったばかりの新参ものが、なんでアリスさんの視線をひとりじめしてるっスか？　許せないスけど、その秘訣を教えてほしいっス。<切実|せつじつ>に。ジブン、本気だしたら凄いッスよ』"

#. Occurrence 7_EX:7252:10408: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0053; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:7252
msgctxt "text_id=10408 | speaker=soujuurou"
msgid "\"What?\""
msgstr "「なに？」"

#. Occurrence 7_EX:7259:10409: scene=7_EX
#: 7_EX:7259
msgctxt "text_id=10409 | speaker=unknown"
msgid "  Halfway up the stairs already, Soujyuro quickly retraced his steps."
msgstr "　もう半分ほど登っていた階段から、草十郎はトコトコと舞い戻る。"

#. Occurrence 7_EX:7270:10410: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0054; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:7270
msgctxt "text_id=10410 | speaker=soujuurou"
msgid "\"What did you just say?\""
msgstr "「君。いまのはどういう？」"

#. Occurrence 7_EX:7304:10411: voice_id=BA0_7_EX_0026; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7304
msgctxt "text_id=10411 | speaker=unknown"
msgid "\"That whenever Angel Mum has a moment to spare, she starts watchin' you like a hawk, that's what!"
msgstr "『だからアリスさん、スキあらばオマエを見てるッス。"

#. Occurrence 7_EX:7310:10412: voice_id=BA0_7_EX_0027; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7310
msgctxt "text_id=10412 | speaker=unknown"
msgid "  And now I remember why I wanted to talk to you! I wanted to make sure you don't go gettin' any big ideas just 'cause she's looking you over with that burning look in her mince pies!"
msgstr "　思い出したッスよ、そもそもジブン、熱視線でサーチされてるからってつけあがるなと釘刺しにきたんス。"

#. Occurrence 7_EX:7321:10413: voice_id=BA0_7_EX_0028; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7321
msgctxt "text_id=10413 | speaker=unknown"
msgid "  I've already saved you more times than you know, Mr. Sono-G."
msgstr "　だいたい草の字は何度もジブンに助けられてるッス。"

#. Occurrence 7_EX:7327:10414: voice_id=BA0_7_EX_0029; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7327
msgctxt "text_id=10414 | speaker=unknown"
msgid "  If it wasn't for Miss Alice's orders you'd be stuck in some old mirror, you know. What's really going on? Is this that crazy rubber and glove that you humans get all Moby Dick over?\""
msgstr "　アリスさんの命令がなかったら、今ごろ草の字、鏡の中でおだぶつっス。コレなんスかね。人間の感情とかわかんないっスけど、魚へんに里とか描くっスかね？』"

#. Occurrence 7_EX:7393:10415: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0055; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:7393
msgctxt "text_id=10415 | speaker=soujuurou"
msgid "\"...You're saying she saved me? Alice? Saved me?\""
msgstr "「助けられてるって、俺が？」"

#. Occurrence 7_EX:7400:10416: voice_id=BA0_7_EX_0030; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7400
msgctxt "text_id=10416 | speaker=unknown"
msgid "\"Yeah, well, she's also the one tryin' to kill you, but come off it!"
msgstr "『まあ、殺そうとしてるのもアリスさんっスけどね！"

#. Occurrence 7_EX:7407:10417: voice_id=BA0_7_EX_0031_0; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7407
msgctxt "text_id=10417 | speaker=unknown"
msgid "  Here's what she told me. She said to save you if you ever were about to get lost in the mirror or got too close to somefin dangerous... but don't go gettin' no big 'ead, you hear me? It's not like anyone cares what happens to yo-"
msgstr "　アリスさんはこう言ったっス。彼が鏡の中に迷いこみそうになったら助けてあげて、危険なモノには近寄らないように誘導もしてあげて、ええ、でも思い上がらないコトねシズキクン、別にアンタのコトが心配なワケ"

#. Occurrence 7_EX:7422:10418: voice_id=BA0_7_EX_0031_1; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7422
msgctxt "text_id=10418 | speaker=unknown"
msgid "GYARGH!\""
msgstr "じゃぶきゃっ！？』"

#. Occurrence 7_EX:7442:10419: scene=7_EX
#: 7_EX:7442
msgctxt "text_id=10419 | speaker=unknown"
msgid "  It happened in a flash."
msgstr "　一瞬の早技だった。"

#. Occurrence 7_EX:7447:10420: scene=7_EX
#: 7_EX:7447
msgctxt "text_id=10420 | speaker=unknown"
msgid "  With a swift, unhesitating strike of her hand, Alice squashed the bird right then and there as it sat on the telephone receiver stand in the foyer."
msgstr "　突如ロビーにやってきた有珠は、一瞬の<躊躇|ちゅうちょ>もなく受話器台の駒鳥を片手で粉砕した。"

#. Occurrence 7_EX:7452:10421: scene=7_EX
#: 7_EX:7452
msgctxt "text_id=10421 | speaker=unknown"
msgid "  Her pressed palm continued to pin it down."
msgstr "　もとい、片手で押さえつけた。"

#. Occurrence 7_EX:7472:10422: scene=7_EX
#: 7_EX:7472
msgctxt "text_id=10422 | speaker=unknown"
msgid "  The bird's crushed form resembled a bright rubber ball, like what a child might play with."
msgstr "　青い鳥はぶにゃ、と潰されたカラーボールのように変形しながら、"

#. Occurrence 7_EX:7483:10423: voice_id=BA0_7_EX_0032; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7483
msgctxt "text_id=10423 | speaker=unknown"
msgid "\"Hey! What's the big idea, Miss Alice!"
msgstr "『ちょっ、アリスさん暗いッスー！"

#. Occurrence 7_EX:7489:10424: voice_id=BA0_7_EX_0033; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7489
msgctxt "text_id=10424 | speaker=unknown"
msgid "  You're killin' me! I can feel all the blood in my body gushing out me beak!\""
msgstr "　そして痛い、体中の血液がくちばしからこう、右方向に流れていく感覚とかー！』"

#. Occurrence 7_EX:7495:10425: scene=7_EX
#: 7_EX:7495
msgctxt "text_id=10425 | speaker=unknown"
msgid "  The bird raised a mighty uproar."
msgstr "　たくましい鳴き声をあげている。"

#. Occurrence 7_EX:7550:10426: scene=7_EX
#: 7_EX:7550
msgctxt "text_id=10426 | speaker=unknown"
msgid "\"..."
msgstr "「…………"

#. Occurrence 7_EX:7558:10427: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_EX_0002; voice_prefix=A40; voice_category=2; scene=7_EX
#: 7_EX:7558
msgctxt "text_id=10427 | speaker=alice"
msgid "...Ignore everything the bird says.\""
msgstr "コレの言うことは、気にしないで」"

#. Occurrence 7_EX:7580:10428: scene=7_EX
#: 7_EX:7580
msgctxt "text_id=10428 | speaker=unknown"
msgid "  Alice returned to the drawing room, taking the bird with her."
msgstr "　駒鳥を回収し、居間に去っていく有珠。"

#. Occurrence 7_EX:7585:10429: scene=7_EX
#: 7_EX:7585
msgctxt "text_id=10429 | speaker=unknown"
msgid "  Her dark silhouette cloaked in shadow was the complete opposite of the gaudy little bird."
msgstr "　その後ろ姿は駒鳥とは正反対の、暗い<翳|かげ>りを帯びている。"

#. Occurrence 7_EX:7618:10430: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0056; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:7618
msgctxt "text_id=10430 | speaker=soujuurou"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence 7_EX:7623:10431: scene=7_EX
#: 7_EX:7623
msgctxt "text_id=10431 | speaker=unknown"
msgid "  Soujyuro folded his arms as he stood alone, no less confused than before, and whispered,"
msgstr "　草十郎は困った顔のまま腕を組んで、"

#. Occurrence 7_EX:7634:10432: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0057; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:7634
msgctxt "text_id=10432 | speaker=soujuurou"
msgid "\"Things get stranger by the day around here,\""
msgstr "「こうして、ますます疑問は増えていくのだった」"

#. Occurrence 7_EX:7640:10433: scene=7_EX
#: 7_EX:7640
msgctxt "text_id=10433 | speaker=unknown"
msgid "  up at the night sky visible through the skylight."
msgstr "　ひとり、天窓から<覗|のぞ>く夜空に呟いた。"

#. Occurrence 8_1:54:10434: scene=8_1
#: 8_1:54
msgctxt "text_id=10434 | speaker=unknown"
msgid "  Misaki High School's winter vacation began in mid-December."
msgstr "　三咲高校の冬休みは十二月の中旬から始まる。"

#. Occurrence 8_1:61:10435: scene=8_1
#: 8_1:61
msgctxt "text_id=10435 | speaker=unknown"
msgid "  The tranquil air of the school was a refreshing change of pace from the more competitive schools and their nationally famous sports teams and exam-oriented curriculum."
msgstr "　全国に名を馳せる運動部もなく、熱心な進学校でもない学校の静けさは清潔感すらある。"

#. Occurrence 8_1:66:10436: scene=8_1
#: 8_1:66
msgctxt "text_id=10436 | speaker=unknown"
msgid "  The empty, newly constructed building evoked images of a pure white swan descending upon a still winter lake."
msgstr "　<人気|ひとけ>の<絶|た>えた新築の建物は、冬の湖に舞い下りた白鳥を思わせる。"

#. Occurrence 8_1:71:10437: scene=8_1
#: 8_1:71
msgctxt "text_id=10437 | speaker=unknown"
msgid "  The modern school building felt alive in its stillness, in spite of the absence of its lifeblood of students."
msgstr "　近代化の進んだ校舎は、その血液である生徒を<欠|か>いても在り方を損なわず、粛々と<佇|たたず>んでいる。"

#. Occurrence 8_1:92:10438: scene=8_1
#: 8_1:92
msgctxt "text_id=10438 | speaker=unknown"
msgid "  Most students never knew what this building used to look like."
msgstr "　だが、生徒の多くはその前身を知らない。"

#. Occurrence 8_1:97:10439: scene=8_1
#: 8_1:97
msgctxt "text_id=10439 | speaker=unknown"
msgid "  It was just a small, rundown wooden building, a shadow of its former self."
msgstr "　今の姿とは比べようのない、木造の小さな<学舎|まなびや>。"

#. Occurrence 8_1:102:10440: scene=8_1
#: 8_1:102
msgctxt "text_id=10440 | speaker=unknown"
msgid "  The former school was never torn down and now stood in lonely silence."
msgstr "　その旧校舎は取り壊される事もなく、今でも<鎮|しず>かに眠っている。"

#. Occurrence 8_1:107:10441: scene=8_1
#: 8_1:107
msgctxt "text_id=10441 | speaker=unknown"
msgid "  It was tucked away deep in a seemingly infinite wood that stretched across the mountains."
msgstr "　裏山に<延々|えんえん>と続く森のただ中に、ひっそりとその身を隠すように。"

#. Occurrence 8_1:143:10442: scene=8_1
#: 8_1:143
msgctxt "text_id=10442 | speaker=unknown"
msgid "  The sound of brooms sweeping dead leaves resonated in the air."
msgstr "　枯葉を<掃|は>く竹ぼうきの音が響く。"

#. Occurrence 8_1:148:10443: scene=8_1
#: 8_1:148
msgctxt "text_id=10443 | speaker=unknown"
msgid "  The ocean of leaves had accumulated into piles as big as sand dunes; sweeping was a futile venture at this point."
msgstr "　裏山に枯れ落ちた葉は、砂浜に打ち寄せる波のようだ。掃いても掃いてもきりがない。"

#. Occurrence 8_1:153:10444: scene=8_1
#: 8_1:153
msgctxt "text_id=10444 | speaker=unknown"
msgid "  An ominous feeling lingered in the air, perhaps the result of two years of abandonment."
msgstr "　なにしろ二年間以上放置された魔境である。"

#. Occurrence 8_1:158:10445: scene=8_1
#: 8_1:158
msgctxt "text_id=10445 | speaker=unknown"
msgid "  Cleaning the inside of the building alone would take more than a few days to finish."
msgstr "　仮に校内あげての清掃を始めたところで、一日二日でどうにかなるものではない。"

#. Occurrence 8_1:163:10446: scene=8_1
#: 8_1:163
msgctxt "text_id=10446 | speaker=unknown"
msgid "  Not to mention,"
msgstr "　<況|いわ>んや、"

#. Occurrence 8_1:197:10447: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0000; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:197
msgctxt "text_id=10447 | speaker=kinomi"
msgid "\"Ugh, this SUCKS! We're students, dammit! Not machines!"
msgstr "「あー、ほんとだりぃー、存在価値がみいだせねぇー。"

#. Occurrence 8_1:203:10448: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0001; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:203
msgctxt "text_id=10448 | speaker=kinomi"
msgid "  We barely get any winter break and then the student council has us out here doing this crap?\""
msgstr "　バッカじゃねえの、冬休みは短いってのに、なんでこんな事やらせんだよ生徒会は」"

#. Occurrence 8_1:216:10449: scene=8_1
#: 8_1:216
msgctxt "text_id=10449 | speaker=unknown"
msgid "  The misguided youth sent here for the job wasted no time making it clear he wanted no part in the beautification efforts."
msgstr "　その参加者がこのような<不心得|ふこころえ><者|もの>では、裏山の美化など望むべくもないのだった。"

#. Occurrence 8_1:246:10450: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0002; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:246
msgctxt "text_id=10450 | speaker=kinomi"
msgid "\"At least let us wear a jacket or something! It's freezing out here!"
msgstr "「っていうかジャージでやらせんなよ、ジャンパーぐらい着させろよなー。"

#. Occurrence 8_1:253:10451: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0003; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:253
msgctxt "text_id=10451 | speaker=kinomi"
msgid "Is this part of gym class or something? Winter marathon training? And I'm saying this as someone who NEVER skips gym class!\""
msgstr "なにこれ、もしかして体育の補習？　寒中マラソン？　オレ体育だけはサボったコトねぇんスけどねー！」"

#. Occurrence 8_1:259:10452: scene=8_1
#: 8_1:259
msgctxt "text_id=10452 | speaker=unknown"
msgid "  Housuke Kinomi continued to mumble and grumble to himself as he reluctantly swept away at the ground."
msgstr "　なげやりに竹ぼうきをブンブンと振り回し、<罵詈|ばり><雑言|ぞうごん>をまき散らす<木乃美|きのみ><芳助|ほうすけ>。"

#. Occurrence 8_1:276:10453: scene=8_1
#: 8_1:276
msgctxt "text_id=10453 | speaker=unknown"
msgid "  Meanwhile, Soujyuro silently and swiftly continued his sweeping, glaring at Kinomi out of the corner of his eye."
msgstr "　それを横目にしながら、草十郎は無言でざっざっと竹ぼうきを動かしていた。"

#. Occurrence 8_1:310:10454: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0004; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:310
msgctxt "text_id=10454 | speaker=kinomi"
msgid "\"Are you seriously trying to clean up all this for real? There's only, like, forty of us out here. There's no way we're going to get all this cleaned up, so who cares?\""
msgstr "「おい、なに真面目にやってんだよ。こんなの適当でいいんだって。だいたい四十人しかいねえのに、こんな山みたいな庭の掃除なんか終わるかってんだ」"

#. Occurrence 8_1:316:10455: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0000; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:316
msgctxt "text_id=10455 | speaker=soujuurou"
msgid "\"Anything can be completed with diligence, Kinomi. Stop complaining so hard.\""
msgstr "「終わらない事なんてない。少しうるさいぞ、木乃美は」"

#. Occurrence 8_1:324:10456: scene=8_1
#: 8_1:324
msgctxt "text_id=10456 | speaker=unknown"
msgid "  Kinomi went back to idly swinging his broom without even glancing over at Soujyuro."
msgstr "　振り向きもせず<窘|たしな>める草十郎に、木乃美はますます詰まらなそうに竹ぼうきを振り回した。"

#. Occurrence 8_1:354:10457: scene=8_1
#: 8_1:354
msgctxt "text_id=10457 | speaker=unknown"
msgid "  Mornings on the mountain were cold."
msgstr "　朝の裏山は寒い。"

#. Occurrence 8_1:359:10458: scene=8_1
#: 8_1:359
msgctxt "text_id=10458 | speaker=unknown"
msgid "  There was no hint of sun in the cloudy sky above; ash-gray light illuminated the rear courtyard; the sharp cold of mid-winter pierced through everyone's gloves as if they did not exist."
msgstr "　曇った空には太陽の影もなく、灰色の光が裏庭を照らしていた。真冬の見本みたいな寒さは、軍手ごしにも手をかじかませる。"

#. Occurrence 8_1:364:10459: scene=8_1
#: 8_1:364
msgctxt "text_id=10459 | speaker=unknown"
msgid "  A day like this was best spent indoors under warm blankets, but for some reason they were out here cleaning."
msgstr "　こんな日は部屋でぬくんでいるべきなのに、何の因果か、彼らは裏山の掃除なんてやっていた。"

#. Occurrence 8_1:384:10460: scene=8_1
#: 8_1:384
msgctxt "text_id=10460 | speaker=unknown"
msgid "  The Special Winter Cleaning Team."
msgstr "　冬期特別清掃班。"

#. Occurrence 8_1:404:10461: scene=8_1
#: 8_1:404
msgctxt "text_id=10461 | speaker=unknown"
msgid "  That was the name given to this elite force sent to clean up this dilapidated, overgrown mountain."
msgstr "　それは、いいかげん荒れ放題の裏山をどうにかしようと集結した有志たちによる、決死隊の呼称である。"

#. Occurrence 8_1:409:10462: scene=8_1
#: 8_1:409
msgctxt "text_id=10462 | speaker=unknown"
msgid "  The other students had put their faith into this team to fulfill this beautification mission, respecting them for their sacrifice."
msgstr "　一般生徒は彼らを美化という名の神に信心を捧げた、鋼のお掃除部隊と思うだろう。"

#. Occurrence 8_1:429:10463: scene=8_1
#: 8_1:429
msgctxt "text_id=10463 | speaker=unknown"
msgid "  The reality, however, was that this was nothing more than a ragtag dare-losing gang of students needing remedial lessons before their exams."
msgstr "　しかし、その実態は期末試験の補習の一貫として用意された、ただの罰ゲーム部隊だった。"

#. Occurrence 8_1:434:10464: scene=8_1
#: 8_1:434
msgctxt "text_id=10464 | speaker=unknown"
msgid "  They were the victims of a year-long arm-twisting scheme by the student council."
msgstr "　今年度の生徒会が力技で実行した、一年計画の犠牲者である。"

#. Occurrence 8_1:467:10465: scene=8_1
#: 8_1:467
msgctxt "text_id=10465 | speaker=unknown"
msgid "  Who in their right mind would come out here to sweep up leaves with a blizzard looming on the horizon?"
msgstr "　そろそろ雪が降ってもおかしくないこの季節に、誰が好き好んで枯葉拾いなぞやるものか。"

#. Occurrence 8_1:472:10466: scene=8_1
#: 8_1:472
msgctxt "text_id=10466 | speaker=unknown"
msgid "  Other than one of the forty assembled, none of them had any semblance of interest in the task at hand."
msgstr "　結局集まった四十人のうち一人を除いて、有志でもなんでもなかったりする。"

#. Occurrence 8_1:506:10467: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0005; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:506
msgctxt "text_id=10467 | speaker=kinomi"
msgid "\"Hey, Sizuki, look over there. Akabane and those guys are over there roasting sweet potatoes! What is this, the 50s or something?!"
msgstr "「げ。おい見ろよ<静希|しずき>。<赤羽|あかばね>たち、向こうで焼き芋とかレトロなマネしてやがる！"

#. Occurrence 8_1:522:10468: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0006; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:522
msgctxt "text_id=10468 | speaker=kinomi"
msgid "  Looks like they don't even know how to roast them properly. Oh, I know! Wanna grill some squid?\""
msgstr "　んが、二番煎じはいかにもあたま悪いしな。そうだ、オレたちはイカでも焼かねぇ？」"

#. Occurrence 8_1:542:10469: scene=8_1
#: 8_1:542
msgctxt "text_id=10469 | speaker=unknown"
msgid "  Kinomi did not want to be here to begin with, and was constantly trying to break Soujyuro into joining him."
msgstr "　もとより掃除をする気のない木乃美はしきりに草十郎を懐柔しようとしていた。"

#. Occurrence 8_1:559:10470: scene=8_1
#: 8_1:559
msgctxt "text_id=10470 | speaker=unknown"
msgid "  The cleaning squad was divided into groups. Soujyuro and Kinomi were in charge of cleaning behind the gymnasium."
msgstr "　清掃班はグループに分けられており、草十郎と木乃美は体育館裏の担当だ。"

#. Occurrence 8_1:564:10471: scene=8_1
#: 8_1:564
msgctxt "text_id=10471 | speaker=unknown"
msgid "  Soujyuro was the leader of the platoon. Kinomi was the grunt."
msgstr "　リーダーは草十郎で、一般兵士は木乃美である。"

#. Occurrence 8_1:588:10472: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0001; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:588
msgctxt "text_id=10472 | speaker=soujuurou"
msgid "\"Look, when we finish cleaning up around this fence you can go off and eat your sweet potato or squid or whatever it is you want because it'll be lunch time.\""
msgstr "「ああ。こことあっちの垣根をきれいにしたら、焼き芋だろうと焼きイカだろうとネコ鍋だろうと好きにしよう。その頃にはちょうどお昼だ」"

#. Occurrence 8_1:609:10473: scene=8_1
#: 8_1:609
msgctxt "text_id=10473 | speaker=unknown"
msgid "  Soujyuro said, as he expertly packed his swept leaves into trash bags."
msgstr "　草十郎は慣れた手つきで、かき集めた枯葉をビニールのゴミ袋に詰めていく。"

#. Occurrence 8_1:618:10474: scene=8_1
#: 8_1:618
msgctxt "text_id=10474 | speaker=unknown"
msgid "  Two hours had passed since they assembled on this foggy morning at seven o'clock."
msgstr "　うっすらと霧が立ち籠める朝七時から集まって、すでに二時間。"

#. Occurrence 8_1:623:10475: scene=8_1
#: 8_1:623
msgctxt "text_id=10475 | speaker=unknown"
msgid "  While everyone else chatted and laughed as they worked, Soujyuro alone had worked in complete silence at the same blistering pace since he started."
msgstr "　誰もが<音|ね>を上げてだらけ始めている中、草十郎は開始時と同じペースで黙々と働いていた。"

#. Occurrence 8_1:628:10476: scene=8_1
#: 8_1:628
msgctxt "text_id=10476 | speaker=unknown"
msgid "  The sheer amount of work he put in was likely the only thing keeping him from complaining of the cold in his thin jersey."
msgstr "　掃除用に着替えたジャージはえらく寒いのに、泣き言一つないのは運動量の多さ故だろう。"

#. Occurrence 8_1:661:10477: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0007; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:661
msgctxt "text_id=10477 | speaker=kinomi"
msgid "\"Come on, let's take a break. Look at that pond...or should I say ice skating rink? No, on second thought, it's just a pond."
msgstr "「なー、やめようぜ。みろ、そこの池……スケートリンク……？　いや、やっぱ池……？"

#. Occurrence 8_1:668:10478: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0008; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:668
msgctxt "text_id=10478 | speaker=kinomi"
msgid "  But it's frozen solid, dude! That's how cold it is out here!"
msgstr "　とにかく、そこの池らしきモノだってカチカチに凍ってるぐらいなんだぜ？"

#. Occurrence 8_1:674:10479: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0009; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:674
msgctxt "text_id=10479 | speaker=kinomi"
msgid "  A normal human can't work in these snowy conditions unless they're some kind of robot. We're going to have to start eating each other to survive if this keeps up!\""
msgstr "　こんな雪原じゃ人体はフツー動かねえよ、機械伯爵でもなきゃだよ、そろそろ人間狩りがはじまるよー」"

#. Occurrence 8_1:716:10480: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0010; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:716
msgctxt "text_id=10480 | speaker=kinomi"
msgid "\"Why won't you just take a break for a minute?"
msgstr "「なんで、いいかげん休憩しねえ？"

#. Occurrence 8_1:722:10481: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0011; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:722
msgctxt "text_id=10481 | speaker=kinomi"
msgid "  We got all these leaves together, why don't we burn 'em and get warmed up! Nobody's really watching, come on let's grill some squiiid! Pleeeeeease!\""
msgstr "　せっかく枯葉集めたんだから、燃やして暖まんないとさー。どうせ監視役は殿下しかいないんだしさー。な、焼きイカやろうぜ、焼きイカー」"

#. Occurrence 8_1:742:10482: scene=8_1
#: 8_1:742
msgctxt "text_id=10482 | speaker=unknown"
msgid "  For some reason, Kinomi was droning on about his squid."
msgstr "　イカに思い入れがあるのか、木乃美はしつこく主張する。"

#. Occurrence 8_1:747:10483: scene=8_1
#: 8_1:747
msgctxt "text_id=10483 | speaker=unknown"
msgid "  Soujyuro had managed to withstand the barrage of complaints from his comrade, but even he was reaching his limit."
msgstr "　相棒の泣き言を黙って受けとめていた草十郎だが、それもそろそろ限界らしかった。"

#. Occurrence 8_1:775:10484: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0002; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:775
msgctxt "text_id=10484 | speaker=soujuurou"
msgid "\"Kinomi, please...\""
msgstr "「木乃美、頼むから……」"

#. Occurrence 8_1:817:10485: scene=8_1
#: 8_1:817
msgctxt "text_id=10485 | speaker=unknown"
msgid "  Just then, Soujyuro saw the Grim Reaper himself creeping behind Kinomi."
msgstr "　その時、草十郎は相棒の背後に死神の姿を認めた。"

#. Occurrence 8_1:822:10486: scene=8_1
#: 8_1:822
msgctxt "text_id=10486 | speaker=unknown"
msgid "  In his hands he held a rake instead of a soft bamboo broom."
msgstr "　手に持っている物が竹ぼうきではなくクマデなのがまたらしい。"

#. Occurrence 8_1:848:10487: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0000; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:848
msgctxt "text_id=10487 | speaker=tobimaru"
msgid "\"Sounds good to me. I'll let a bit of grilled squid slide. Far be it for me to get between the big man and his squid. I tell you what, I'll even get you the soy sauce.\""
msgstr "「いいぜ。おまえがイカなんてモンを用意してるほどの大人物だってんなら、<謹|つつし>んでイカ焼きぐらい許可してやるよ。なんなら醤油はこっちで用意してやろう」"

#. Occurrence 8_1:867:10488: scene=8_1
#: 8_1:867
msgctxt "text_id=10488 | speaker=unknown"
msgid "  Kinomi shot to attention at the voice behind him."
msgstr "　背中からの声に、木乃美はびくり、と背筋を伸ばし、"

#. Occurrence 8_1:873:10489: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0012; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:873
msgctxt "text_id=10489 | speaker=kinomi"
msgid "\"Ahhh! Tsukiji, is that you?!\""
msgstr "「ひゃあ！　その物言い、槻司<某|なにがし>―――！」"

#. Occurrence 8_1:879:10490: scene=8_1
#: 8_1:879
msgctxt "text_id=10490 | speaker=unknown"
msgid "  Before quickly turning around, swinging his broom in the process."
msgstr "　時代劇めいた台詞を吐いて、振り向きざまに竹ぼうきを振るう。"

#. Occurrence 8_1:887:10491: scene=8_1
#: 8_1:887
msgctxt "text_id=10491 | speaker=unknown"
msgid "  Tobimaru easily blocked the swing with his rake."
msgstr "　それを鳶丸はクマデでがっしりと受けとめた。"

#. Occurrence 8_1:913:10492: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0001; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:913
msgctxt "text_id=10492 | speaker=tobimaru"
msgid "\"Oh, so NOW you wanna use that broom, huh? Just can't contain all that hard-working spirit, I see. Maybe I should assign you to the special Siberian trail, then!\""
msgstr "「ああ？　テメエ、やる気十分じゃねえか。あふれる労働意欲を抑えきれないってワケか？　なんなら<特別|シベリア>コースにでも行っちまうか？」"

#. Occurrence 8_1:931:10493: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0013; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:931
msgctxt "text_id=10493 | speaker=kinomi"
msgid "\"Hah. All you've done is stand over by the furnace with the girls pretending like you're on a Caribbean holiday instead of out here in the freezing cold.\""
msgstr "「はん。女ども集めて焼却炉に陣どってる野郎の言葉なんざ聞かねえよ。真冬に南国気分とかマジ寒いわ」"

#. Occurrence 8_1:970:10494: scene=8_1
#: 8_1:970
msgctxt "text_id=10494 | speaker=unknown"
msgid "  Both boys glared at each other with a wry smile, broom and rake locked in an embrace."
msgstr "　竹ぼうきとクマデを交差させて、ふたりは不敵な笑みを浮かべている。"

#. Occurrence 8_1:975:10495: scene=8_1
#: 8_1:975
msgctxt "text_id=10495 | speaker=unknown"
msgid "  These two were only friendly with each other on school grounds."
msgstr "　これでも学園内限定で仲のいいコンビだった。"

#. Occurrence 8_1:1020:10496: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0003; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1020
msgctxt "text_id=10496 | speaker=soujuurou"
msgid "\"Tobimaru, please don't distract him any more than he already is.\""
msgstr "「鳶丸。いちおう、彼は戦力なんだから邪魔しないでくれ」"

#. Occurrence 8_1:1026:10497: scene=8_1
#: 8_1:1026
msgctxt "text_id=10497 | speaker=unknown"
msgid "  Both of them scoffed angrily and put away their weapons."
msgstr "　チ、と心底忌々しそうに舌打ちし、矛を納める両者。"

#. Occurrence 8_1:1031:10498: scene=8_1
#: 8_1:1031
msgctxt "text_id=10498 | speaker=unknown"
msgid "  They both knew better than to argue with Soujyuro, the only one cleaning with a garbage bag in hand."
msgstr "　なんというか、ゴミ袋片手に、俗世のコトなど関心ありません、と掃除をする草十郎の<言|げん>には逆らえない。"

#. Occurrence 8_1:1068:10499: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0004; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1068
msgctxt "text_id=10499 | speaker=soujuurou"
msgid "\"Something we can help you with, Tobimaru?"
msgstr "「それで、何しに来たんだ鳶丸。"

#. Occurrence 8_1:1074:10500: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0005; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1074
msgctxt "text_id=10500 | speaker=soujuurou"
msgid "  I thought you were too busy pretending to tend the fire over at the furnace.\""
msgstr "　君はあったかい焼却炉の前で、永遠に火の管理をすると豪語していたんじゃなかったっけ？」"

#. Occurrence 8_1:1080:10501: scene=8_1
#: 8_1:1080
msgctxt "text_id=10501 | speaker=unknown"
msgid "  A harsh comment."
msgstr "　もとい。"

#. Occurrence 8_1:1085:10502: scene=8_1
#: 8_1:1085
msgctxt "text_id=10502 | speaker=unknown"
msgid "  Apparently even Soujyuro had a slight taste for drama."
msgstr "　この男も、多少は俗世に関心があったらしい。"

#. Occurrence 8_1:1118:10503: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0002; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1118
msgctxt "text_id=10503 | speaker=tobimaru"
msgid "\"So it's come to this. Even the upstanding students like you are looking down on me now.\""
msgstr "「なんてこった……善良な生徒ですら、俺をそんな目で見るのか……」"

#. Occurrence 8_1:1124:10504: scene=8_1
#: 8_1:1124
msgctxt "text_id=10504 | speaker=unknown"
msgid "  Tobimaru seemed sad at Soujyuro's observation."
msgstr "　悲しそうに鳶丸は言う。"

#. Occurrence 8_1:1129:10505: scene=8_1
#: 8_1:1129
msgctxt "text_id=10505 | speaker=unknown"
msgid "  But as long as Tobimaru continued to claim he was helping the girls clean by doing nothing more than standing in front of a pile of burning leaves, Soujyuro found it hard to sympathize."
msgstr "　が、集められた落ち葉を燃やして<暖|だん>を取りながら、女子の清掃班を手伝いと称してはべらせている以上、かける情けは落ち葉一枚分もないのである。"

#. Occurrence 8_1:1165:10506: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0014; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:1165
msgctxt "text_id=10506 | speaker=kinomi"
msgid "\"Just tell us what you want. We're actually busy doing work over here, unlike some people.\""
msgstr "「いいから用件を言えよ。殿下と違ってオレらはヒマじゃねえんだ」"

#. Occurrence 8_1:1181:10507: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0003; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1181
msgctxt "text_id=10507 | speaker=tobimaru"
msgid "\"Oh is that so? Well, lucky for you it's almost break time."
msgstr "「ああそうかよ。草十郎、そろそろ小休止だ。"

#. Occurrence 8_1:1181:10508: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0003; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1181
msgctxt "text_id=10508 | speaker=tobimaru"
msgid "  Let's get warmed up over there.\""
msgstr "　向こうで<暖|あたた>まろうや」"

#. Occurrence 8_1:1201:10509: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0015; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:1201
msgctxt "text_id=10509 | speaker=kinomi"
msgid "\"Oh, break time! Now you're talking!\""
msgstr "「お、なんだブレイクかよ！　話せるじゃん、殿下！」"

#. Occurrence 8_1:1234:10510: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0004; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1234
msgctxt "text_id=10510 | speaker=tobimaru"
msgid "\"Huh? Not for you, idiot. Only people who've actually done some work today can take a break."
msgstr "「あ？　テメエは除外に決まってんだろ。特権は功労者にのみ与えられるモンだ。"

#. Occurrence 8_1:1240:10511: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0005; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1240
msgctxt "text_id=10511 | speaker=tobimaru"
msgid "  If you wanna come stand by the furnace then bring me enough leaves to fill a cart. Until then, keep sweeping.\""
msgstr "　焼却炉の前に来たけりゃ、それ相応の貢ぎ物を持ってきやがれ。具体的に言うと、リヤカー一台分のゴミ袋な」"

#. Occurrence 8_1:1265:10512: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0016; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:1265
msgctxt "text_id=10512 | speaker=kinomi"
msgid "\"Argh! I have rights, you know! This is abuse of power!\""
msgstr "「ひっでぇ、生徒会横暴ー！」"

#. Occurrence 8_1:1285:10513: scene=8_1
#: 8_1:1285
msgctxt "text_id=10513 | speaker=unknown"
msgid "  Kinomi's complaints naturally fell on deaf ears."
msgstr "　木乃美の抗議は当然のように届かない。"

#. Occurrence 8_1:1290:10514: scene=8_1
#: 8_1:1290
msgctxt "text_id=10514 | speaker=unknown"
msgid "  Tobimaru had been selected to lead the cleaning operation, and his word was final."
msgstr "　清掃班の指揮役として<抜擢|ばってき>された鳶丸には、こんなんでも絶対的な権力があった。"

#. Occurrence 8_1:1295:10515: scene=8_1
#: 8_1:1295
msgctxt "text_id=10515 | speaker=unknown"
msgid "  If Kinomi were to continue to push his buttons, he knew he would be on cleaning duty tomorrow and the next day, too."
msgstr "　彼がちょっと記録に手を加えれば、木乃美は明日も明後日も清掃班に参加する事になる。"

#. Occurrence 8_1:1335:10516: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0006; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1335
msgctxt "text_id=10516 | speaker=tobimaru"
msgid "\"All right, here we go, people. Don't ask me why, but we have a bunch of cans of sweet red-bean soup. Some meat buns would've been better, but that would have required a certain someone to use their brain. We've also got some emergency chocolate."
msgstr "「さ、行くぞ。誰の趣味かしらねえが、なぜかしるこの缶が山ほどあってな。中華まんの一つでもあった方が気が利くってもんなんだがねぇ。アレか、遭難用のチョコレートみたいなもんか？"

#. Occurrence 8_1:1341:10517: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0007; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1341
msgctxt "text_id=10517 | speaker=tobimaru"
msgid "  ...Goddammit. What the hell was she thinking?\""
msgstr "　……ったく、アイツの考えはいまだに分かんねぇなあ」"

#. Occurrence 8_1:1357:10518: scene=8_1
#: 8_1:1357
msgctxt "text_id=10518 | speaker=unknown"
msgid "  Soujyuro reassured Tobimaru by saying that he thought the food would do just fine for everyone."
msgstr "　それはそれで気が利いているのでは、と感心する草十郎。"

#. Occurrence 8_1:1391:10519: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0008; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1391
msgctxt "text_id=10519 | speaker=tobimaru"
msgid "\"Huh? Wait, you're not coming?\""
msgstr "「ん？　なんだよ、行かねえのか草十郎？」"

#. Occurrence 8_1:1397:10520: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0006; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1397
msgctxt "text_id=10520 | speaker=soujuurou"
msgid "\"No, I'm gonna stay here. We can just burn some leaves to stay warm like Kinomi said. We've got a pond right there, so we can easily put it out when we're done.\""
msgstr "「ああ、自分はここに残るよ。<暖|だん>なら木乃美の言うように葉を燃やせばいい。そこに池もある。火の始末なら安心だ」"

#. Occurrence 8_1:1420:10521: scene=8_1
#: 8_1:1420
msgctxt "text_id=10521 | speaker=unknown"
msgid "  This was clearly for Kinomi's benefit."
msgstr "　木乃美に気をつかっての返答である。"

#. Occurrence 8_1:1425:10522: scene=8_1
#: 8_1:1425
msgctxt "text_id=10522 | speaker=unknown"
msgid "  Tobimaru furrowed his brow while Kinomi shivered from the cold."
msgstr "　鳶丸は眉をひそめ、木乃美はプルプル震えている。"

#. Occurrence 8_1:1463:10523: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0017; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:1463
msgctxt "text_id=10523 | speaker=kinomi"
msgid "\"Ohhh... Ohhhhhhhh!"
msgstr "「おお……ぉおおお……！"

#. Occurrence 8_1:1475:10524: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0018; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:1475
msgctxt "text_id=10524 | speaker=kinomi"
msgid "  I-Is that a glimmer of friendship I just saw! You know what? You're as pure as the snow is white!"
msgstr "　オ、オレはいま友情ってもんを実感している！　すげえな、真心ってほんとにあったんだ！"

#. Occurrence 8_1:1482:10525: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0019; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:1482
msgctxt "text_id=10525 | speaker=kinomi"
msgid "  This is nuts, but just wait here, Sizuki! I'm gonna go grab some potatoes from Akabane!\""
msgstr "　クソ、待ってろ静希！　いま赤羽たちからイモ奪ってくる！」"

#. Occurrence 8_1:1495:10526: scene=8_1
#: 8_1:1495
msgctxt "text_id=10526 | speaker=unknown"
msgid "  Perhaps shy to show his true feelings, Kinomi ran off to the neighboring group."
msgstr "　根は照れ屋なのか、木乃美はとなりの班の集まりへ走っていった。"

#. Occurrence 8_1:1529:10527: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0009; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1529
msgctxt "text_id=10527 | speaker=tobimaru"
msgid "\"...Eh, I figured you'd say that. Here.\""
msgstr "「……ま、予想はしてたけどな。ほらよ」"

#. Occurrence 8_1:1548:10528: scene=8_1
#: 8_1:1548
msgctxt "text_id=10528 | speaker=unknown"
msgid "  Tobimaru pulled out a hot can from his jersey pocket, scratching his head in exacerbation."
msgstr "　やれやれと頭をかきながら、鳶丸はジャージのポケットからホット缶を取りだした。"

#. Occurrence 8_1:1553:10529: scene=8_1
#: 8_1:1553
msgctxt "text_id=10529 | speaker=unknown"
msgid "  He pulled out three in all, one from each jersey pocket and one from his pants pocket."
msgstr "　左右のポケットと、ズボンの後ろ、合わせて三本。"

#. Occurrence 8_1:1574:10530: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0010; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1574
msgctxt "text_id=10530 | speaker=tobimaru"
msgid "\"Let's get a fire going."
msgstr "「さっさと焚火の用意をしようぜ。"

#. Occurrence 8_1:1574:10531: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0010; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1574
msgctxt "text_id=10531 | speaker=tobimaru"
msgid "  I'm gonna chill over here too.\""
msgstr "　俺もこっちで休む事にするわ」"

#. Occurrence 8_1:1590:10532: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0007; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1590
msgctxt "text_id=10532 | speaker=soujuurou"
msgid "\"I guess we both know how to deal with people, huh?\""
msgstr "「付き合いがいいのはお互いさまだな」"

#. Occurrence 8_1:1601:10533: scene=8_1
#: 8_1:1601
msgctxt "text_id=10533 | speaker=unknown"
msgid "  Soujyuro quickly prepared the leaves for the fire."
msgstr "　草十郎は手早く焚火の用意を済ませる。"

#. Occurrence 8_1:1612:10534: scene=8_1
#: 8_1:1612
msgctxt "text_id=10534 | speaker=unknown"
msgid "  Carefully gathering them up for them to burn neatly."
msgstr "　落ち葉を集め、きちんと<燻|くすぶ>るよう、あっさりと燃やしてみせた。"

#. Occurrence 8_1:1641:10535: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0011; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1641
msgctxt "text_id=10535 | speaker=tobimaru"
msgid "\"...You're pretty good at that.\""
msgstr "「…………慣れてるな」"

#. Occurrence 8_1:1647:10536: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0008; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1647
msgctxt "text_id=10536 | speaker=soujuurou"
msgid "\"Eh, it's easy when you have matches.\""
msgstr "「マッチがあるから、楽なんだ」"

#. Occurrence 8_1:1653:10537: scene=8_1
#: 8_1:1653
msgctxt "text_id=10537 | speaker=unknown"
msgid "  Soujyuro crouched down in front of the burning leaves and warmed his hands near the flames."
msgstr "　草十郎は火をつけた落ち葉の前にしゃがみこんで、かじかんだ両手をかざした。"

#. Occurrence 8_1:1658:10538: scene=8_1
#: 8_1:1658
msgctxt "text_id=10538 | speaker=unknown"
msgid "  Even though he showed no signs of being cold, underneath it all, Soujyuro was cold, too."
msgstr "　寒そうな素振りは見られなかったが、草十郎は草十郎なりに寒かったらしい。"

#. Occurrence 8_1:1678:10539: scene=8_1
#: 8_1:1678
msgctxt "text_id=10539 | speaker=unknown"
msgid "  He gazed into the fire as the smoke rose from the pile of leaves, as if remembering the good times from his past."
msgstr "　ぱちぱちと煙る落ち葉の山を、懐かしむように草十郎は眺めている。"

#. Occurrence 8_1:1694:10540: scene=8_1
#: 8_1:1694
msgctxt "text_id=10540 | speaker=unknown"
msgid "  Tobimaru felt a touch of concern as he looked at Soujyuro."
msgstr "　……その姿に、鳶丸は一抹の不安を感じた。"

#. Occurrence 8_1:1699:10541: scene=8_1
#: 8_1:1699
msgctxt "text_id=10541 | speaker=unknown"
msgid "  He saw within him homesickness and retrospection. He also saw a dark shadow looming over him, like a stranger in a foreign land without a home."
msgstr "　望郷や追想。住む場所を奪われ追われた、異邦人のような暗い<翳|かげ>りを、その姿に見たからだ。"

#. Occurrence 8_1:1720:10542: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0012; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1720
msgctxt "text_id=10542 | speaker=tobimaru"
msgid "\"You don't look so good, Soujyuro.\""
msgstr "「元気ねえな、草十郎」"

#. Occurrence 8_1:1726:10543: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0009; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1726
msgctxt "text_id=10543 | speaker=soujuurou"
msgid "\"I suppose I *am* a little tired.\""
msgstr "「……まあね。少し、疲れてる」"

#. Occurrence 8_1:1746:10544: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0013; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1746
msgctxt "text_id=10544 | speaker=tobimaru"
msgid "\"If you need to talk, I'm here for you. Just let me know.\""
msgstr "「悩みごとなら相談にのるぜ。気が向いたら話してくれ」"

#. Occurrence 8_1:1753:10545: scene=8_1
#: 8_1:1753
msgctxt "text_id=10545 | speaker=unknown"
msgid "  Tobimaru continued speaking with the pull-tab from the can of sweet red-bean soup still around his index finger."
msgstr "　お汁粉缶を開けて、人差し指に残ったリングプルを持て余しながら鳶丸は続ける。"

#. Occurrence 8_1:1758:10546: scene=8_1
#: 8_1:1758
msgctxt "text_id=10546 | speaker=unknown"
msgid "  Soujyuro was focused on the fire."
msgstr "　草十郎は焚火に意識を向けたままだ。"

#. Occurrence 8_1:1793:10547: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0014; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1793
msgctxt "text_id=10547 | speaker=tobimaru"
msgid "\"Oh yeah, while you were taking a break from school, Aozaki slugged me. She said I've got a big mouth.\""
msgstr "「そういえばな。おまえが学校休んでる時、蒼崎に殴られたぜ。なんでも俺は大ぼら吹きだそうだ」"

#. Occurrence 8_1:1811:10548: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0010; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1811
msgctxt "text_id=10548 | speaker=soujuurou"
msgid "\"Wow, congratulations.\""
msgstr "「すごいな、大抜擢じゃないか」"

#. Occurrence 8_1:1828:10549: scene=8_1
#: 8_1:1828
msgctxt "text_id=10549 | speaker=unknown"
msgid "  Sometimes Soujyuro would reply incoherently like this."
msgstr "　草十郎の返答は、時々このように脈絡がない。"

#. Occurrence 8_1:1838:10550: scene=8_1
#: 8_1:1838
msgctxt "text_id=10550 | speaker=unknown"
msgid "  Tobimaru chalked it up to cultural differences."
msgstr "　おそらく文化圏の違いだろう、と鳶丸は気にしない事にした。"

#. Occurrence 8_1:1864:10551: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0015; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1864
msgctxt "text_id=10551 | speaker=tobimaru"
msgid "\"Say, how are things going with Aozaki anyway? You used to walk with her to the train station before exams. Have things been going well since then?\""
msgstr "「なあ、蒼崎とはどうなってんだ？　テスト前は駅まで一緒に帰ってただろ。うまくいってんのか、あれから？」"

#. Occurrence 8_1:1869:10552: scene=8_1
#: 8_1:1869
msgctxt "text_id=10552 | speaker=unknown"
msgid "  It was obvious to everyone that that was far from the case, yet Tobimaru asked anyway."
msgstr "　そんなハズはあるまい、と誰よりも分かっているクセに問いただす。そんな鳶丸に、"

#. Occurrence 8_1:1891:10553: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0011; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1891
msgctxt "text_id=10553 | speaker=soujuurou"
msgid "\"Yeah, we live together now.\""
msgstr "「ああ、今は一緒に住んでるよ」"

#. Occurrence 8_1:1897:10554: scene=8_1
#: 8_1:1897
msgctxt "text_id=10554 | speaker=unknown"
msgid "  Soujyuro went with the truthful, blunt response."
msgstr "　草十郎はあっさりと真実を告げるのだった。"

#. Occurrence 8_1:1934:10555: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0016; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1934
msgctxt "text_id=10555 | speaker=tobimaru"
msgid "\"Wow. I see, I see. That was quick, dating already, huh?\""
msgstr "「ほー。そうか、一緒ときたか」"

#. Occurrence 8_1:1939:10556: scene=8_1
#: 8_1:1939
msgctxt "text_id=10556 | speaker=unknown"
msgid "  Tobimaru tried to laugh off Soujyuro's all-too casual confession, however..."
msgstr "　あまりに自然な返答にハハハ、と鳶丸は相づちを打ち、"

#. Occurrence 8_1:1987:10557: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0017; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1987
msgctxt "text_id=10557 | speaker=tobimaru"
msgid "\"Wait, you LIVE TOGETHER?!\""
msgstr "「あん、一緒に住んでるだぁーー！？」"

#. Occurrence 8_1:2022:10558: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0012; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2022
msgctxt "text_id=10558 | speaker=soujuurou"
msgid "\"Are you okay, Tobimaru? Did a spark hit you?\""
msgstr "「どうした鳶丸。火でも飛んだか？」"

#. Occurrence 8_1:2038:10559: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0018; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2038
msgctxt "text_id=10559 | speaker=tobimaru"
msgid "\"No, worse. My friend just said the wildest thing I've ever heard.\""
msgstr "「飛んでねえし、それより怖ぇ。おい、今の聞き捨てならねえ<戯言|たわごと>はホントの話か？」"

#. Occurrence 8_1:2048:10560: scene=8_1
#: 8_1:2048
msgctxt "text_id=10560 | speaker=unknown"
msgid "  Soujyuro protested Tobimaru's reply with silence."
msgstr "　戯言とは何事だ、と草十郎は無言で抗議。"

#. Occurrence 8_1:2074:10561: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0019; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2074
msgctxt "text_id=10561 | speaker=tobimaru"
msgid "\"...Y-You're not joking, are you? One day you're barely interested in girls and the next you're shacked up with one?!\""
msgstr "「っ―――その余裕、マジか……女に興味なさそうな顔してて、やる事やってんじゃねえかテメエ」"

#. Occurrence 8_1:2080:10562: scene=8_1
#: 8_1:2080
msgctxt "text_id=10562 | speaker=unknown"
msgid "  Tobimaru had always felt that he and Soujyuro were an equal match strength-wise, but for some reason he could not shake the feeling that Soujyuro was now his superior in the brain department."
msgstr "　物理的に先を越された訳でもないのに、なぜか精神的に先を越された気がする鳶丸だった。"

#. Occurrence 8_1:2085:10563: scene=8_1
#: 8_1:2085
msgctxt "text_id=10563 | speaker=unknown"
msgid "  Soujyuro cast a rare angry glare in Tobimaru's direction."
msgstr "　そんな彼に、草十郎は珍しく怒りの視線を向ける。"

#. Occurrence 8_1:2111:10564: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0013; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2111
msgctxt "text_id=10564 | speaker=soujuurou"
msgid "\"That was awfully rude."
msgstr "「こっちこそ聞き捨てならない。"

#. Occurrence 8_1:2117:10565: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0014; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2117
msgctxt "text_id=10565 | speaker=soujuurou"
msgid "  What do you mean I'm not interested in girls?\""
msgstr "　なんだ、その女に興味はないってのは」"

#. Occurrence 8_1:2123:10566: scene=8_1
#: 8_1:2123
msgctxt "text_id=10566 | speaker=unknown"
msgid "  Soujyuro seemed genuinely angry, and his voice was icy."
msgstr "　本気で怒っているらしく言葉も冷たい。"

#. Occurrence 8_1:2128:10567: scene=8_1
#: 8_1:2128
msgctxt "text_id=10567 | speaker=unknown"
msgid "  This uncharacteristic level of anger from Soujyuro was enough to get Tobimaru to back down."
msgstr "　草十郎のかつてない不機嫌さに、鳶丸も平静さを取り戻す。"

#. Occurrence 8_1:2155:10568: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0020_0; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2155
msgctxt "text_id=10568 | speaker=tobimaru"
msgid "\"Hey look, I was out of line. I just assumed a few things. I apologize."
msgstr "「いや、悪い。そんな雰囲気あったんだよ、おまえさんは。それは謝る。"

#. Occurrence 8_1:2167:10569: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0020_1; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2167
msgctxt "text_id=10569 | speaker=tobimaru"
msgid " But seriously, what do you mean you're living with her? This all seems way too fast for you.\""
msgstr "けどよ、蒼崎と一緒に住んでるってどういうことだ？　いくらなんでも<一足|いっそく>飛びすぎだろ」"

#. Occurrence 8_1:2193:10570: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0015; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2193
msgctxt "text_id=10570 | speaker=soujuurou"
msgid "\"It's not what you think. I'm just renting a room in her house."
msgstr "「別に、君が期待しているような事はない。彼女が住んでいるところの部屋を借りる事になっただけだ。"

#. Occurrence 8_1:2199:10571: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0016; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2199
msgctxt "text_id=10571 | speaker=soujuurou"
msgid "  It's up in the attic, but it reminds me of a mountain cottage so I kind of like it.\""
msgstr "　屋根の裏にある部屋なんだけど、板張で山小屋を思い出すんで気に入ってる」"

#. Occurrence 8_1:2205:10572: scene=8_1
#: 8_1:2205
msgctxt "text_id=10572 | speaker=unknown"
msgid "  Tobimaru did not bat an eyelid at hearing that Soujyuro now lived in an attic, and continued his questioning."
msgstr "　それは屋根裏部屋というのだが、あえて鳶丸はスルーした。"

#. Occurrence 8_1:2239:10573: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0021; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2239
msgctxt "text_id=10573 | speaker=tobimaru"
msgid "\"I mean we're talking about *that* mansion, right? The Kuonji mansion?"
msgstr "「屋敷って、あの久遠寺の屋敷か……？"

#. Occurrence 8_1:2245:10574: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0022; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2245
msgctxt "text_id=10574 | speaker=tobimaru"
msgid "  This is out of this world! What kind of wizard are you to pull that off?\""
msgstr "　それこそまさかだぜ。草十郎。おまえ、いったいどんな手品を使いやがった？」"

#. Occurrence 8_1:2251:10575: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0017; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2251
msgctxt "text_id=10575 | speaker=soujuurou"
msgid "\"Huh? You know the place, Tobimaru?\""
msgstr "「？　鳶丸こそ、あの家を知ってるのか？」"

#. Occurrence 8_1:2257:10576: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0023; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2257
msgctxt "text_id=10576 | speaker=tobimaru"
msgid "\"Come on, dude, you're talking to the heir to the Tsukiji throne here. Of course I know about the mansion where the first daughter of the Kuonji Group lives. She's a sophomore at the Reien Girls Academy, right?\""
msgstr "「そりゃあな。これでも槻司家期待の跡取り候補だぜ、俺は。久遠寺グループのご令嬢が住んでる屋敷ぐらいは知ってるさ。礼園女学院の二年生だろ、たしか」"

#. Occurrence 8_1:2289:10577: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0018; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2289
msgctxt "text_id=10577 | speaker=soujuurou"
msgid "\"Kuonji... what?\""
msgstr "「久遠寺……なに？」"

#. Occurrence 8_1:2294:10578: scene=8_1
#: 8_1:2294
msgctxt "text_id=10578 | speaker=unknown"
msgid "  Soujyuro was looking more confused than ever, so Tobimaru reluctantly explained everything as simply as he could so Soujyuro could understand."
msgstr "　ますます首をかしげる草十郎に、鳶丸はやれやれと説明を続けた。もちろん、草十郎が分かるレベルに落としこんで。"

#. Occurrence 8_1:2327:10579: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0024; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2327
msgctxt "text_id=10579 | speaker=tobimaru"
msgid "\"The Kuonji Group. Well, they're more like a foundation, really."
msgstr "「久遠寺グループ……つーか財団だな。"

#. Occurrence 8_1:2333:10580: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0025; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2333
msgctxt "text_id=10580 | speaker=tobimaru"
msgid "  All you need to know is, the whole family is loaded and they own and manage various companies together. They're not quite a conglomerate, but they're a big deal in the exports industry.\""
msgstr "　平たく言えば一族全部がお金持ちで、仲良く会社を経営してる連中だと思えばいい。複合企業とまではいかないが、輸出業じゃあかなりのもんだ」"

#. Occurrence 8_1:2354:10581: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0026; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2354
msgctxt "text_id=10581 | speaker=tobimaru"
msgid "\"They used to operate out of England because their old chairman loved the place, but things went south about five years ago so they moved all their operations back here."
msgstr "「ホームグラウンドは国外で、先代の会長の英国びいきがたたって一時期は沈みかけてたんだが、五年くらい前かね。本拠地をこっちに移してからはご存じの通りだ。"

#. Occurrence 8_1:2360:10582: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0027; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2360
msgctxt "text_id=10582 | speaker=tobimaru"
msgid "  Since their son took over, things have rebounded for them and that's why you see their name plastered around town. They contributed, like, half the funds required to rebuild our school.\""
msgstr "　会長が息子に移ってからはきちんと持ち直して、今や町の名士だろ。ここでも久遠寺の名前はそこかしこで目に入る。この学校の建て直し予算の半分は連中からだしな」"

#. Occurrence 8_1:2392:10583: scene=8_1
#: 8_1:2392
msgctxt "text_id=10583 | speaker=unknown"
msgid "  Despite the oversimplified explanation, Soujyuro still seemed to not be getting it."
msgstr "　極めて簡単に言ったのだが、それでも草十郎には早すぎたようだ。"

#. Occurrence 8_1:2397:10584: scene=8_1
#: 8_1:2397
msgctxt "text_id=10584 | speaker=unknown"
msgid "  With that, Tobimaru decided to give up on trying to explain."
msgstr "　仕方なく鳶丸は話をきる。"

#. Occurrence 8_1:2430:10585: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0028; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2430
msgctxt "text_id=10585 | speaker=tobimaru"
msgid "\"They're filthy rich, okay?"
msgstr "「あれだ、想像もできない金持ちってコト。"

#. Occurrence 8_1:2436:10586: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0029; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2436
msgctxt "text_id=10586 | speaker=tobimaru"
msgid "  You know that coffee place you work at? The Kuonjis brought that franchise here. Now they're a national chain!\""
msgstr "　草の字が働いてる喫茶店だって、久遠寺が向こうから持ってきたブランドだぜ？　今じゃ全国チェーンになっちまったがな」"

#. Occurrence 8_1:2442:10587: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0019; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2442
msgctxt "text_id=10587 | speaker=soujuurou"
msgid "\"Okay, so they're very rich and very important. ...Weird. If that's the case, then why is she so frugal all the time?\""
msgstr "「つまりすごく偉いんだね。……おかしいな、ならなんであんなに倹約してるんだろう……」"

#. Occurrence 8_1:2457:10588: scene=8_1
#: 8_1:2457
msgctxt "text_id=10588 | speaker=unknown"
msgid "  Soujyuro mumbled incoherently to himself."
msgstr "　ぶつぶつと呟く草十郎。"

#. Occurrence 8_1:2462:10589: scene=8_1
#: 8_1:2462
msgctxt "text_id=10589 | speaker=unknown"
msgid "  Tobimaru looked at him with a complex expression on his face, somewhere between envy and heartfelt sympathy."
msgstr "　そんな草十郎に、鳶丸は羨ましいような、心底から同情しているような、複雑な顔を向ける。"

#. Occurrence 8_1:2483:10590: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0030; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2483
msgctxt "text_id=10590 | speaker=tobimaru"
msgid "\"Whatever the case, you've done good for yourself, buddy."
msgstr "「しっかし、うまい事やったな草十郎。"

#. Occurrence 8_1:2503:10591: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0031; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2503
msgctxt "text_id=10591 | speaker=tobimaru"
msgid "  Tell me the truth, though. When a guy and a girl are living under the same roof, only one thing can be happening, am I right?\""
msgstr "　それで、本当のところはどうなんだ？　男と女が同じ屋根の下にいれば、やる事はひとつだろう？」"

#. Occurrence 8_1:2514:10592: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0020; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2514
msgctxt "text_id=10592 | speaker=soujuurou"
msgid "\"That's a surprisingly old-fashioned thought for you to have, Tobimaru.\""
msgstr "「あんがい古いな、鳶丸も」"

#. Occurrence 8_1:2525:10593: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0032; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2525
msgctxt "text_id=10593 | speaker=tobimaru"
msgid "\"Oh give me a break! What kind of guy is afraid to talk about this kind of stuff?\""
msgstr "「ぬかせ。そのあたりを誤魔化してたら男なんざやってらんねえ」"

#. Occurrence 8_1:2536:10594: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0021; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2536
msgctxt "text_id=10594 | speaker=soujuurou"
msgid "\"I suppose you're right. So, the truth is...\""
msgstr "「そりゃごもっとも。実を言うと、正直な話―――」"

#. Occurrence 8_1:2574:10595: scene=8_1
#: 8_1:2574
msgctxt "text_id=10595 | speaker=unknown"
msgid "  Though Soujyuro and Aoko were living together, there was absolutely no chemistry between them. Though that was not to say that living in such close quarters as they did, unintended mishaps did not occur from time to time."
msgstr "　今のところまったく色気のない雑居ではあるが、同じ家で生活している以上、不意打ち気味のニアミスはある。"

#. Occurrence 8_1:2579:10596: scene=8_1
#: 8_1:2579
msgctxt "text_id=10596 | speaker=unknown"
msgid "  But, even still..."
msgstr "　あるのではあるが、しかし―――"

#. Occurrence 8_1:2618:10597: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0022; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2618
msgctxt "text_id=10597 | speaker=soujuurou"
msgid "\"You'd be surprised how nothing like that goes on."
msgstr "「驚くぐらい、そういうコトにはなってない。"

#. Occurrence 8_1:2618:10598: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0022; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2618
msgctxt "text_id=10598 | speaker=soujuurou"
msgid "  The mansion is pretty huge, after all.\""
msgstr "　あの屋敷、すごく広いし」"

#. Occurrence 8_1:2624:10599: scene=8_1
#: 8_1:2624
msgctxt "text_id=10599 | speaker=unknown"
msgid "  Everyone was often busy with their own affairs, so there was no opportunity for that sort of thing to happen."
msgstr "　青子たちも草十郎も私用で忙しいため、そんな浮き足だった状況にはなっていなかった。"

#. Occurrence 8_1:2650:10600: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0023; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2650
msgctxt "text_id=10600 | speaker=soujuurou"
msgid "\"I mean, answer me this. Would you suddenly make advances on Aozaki just because you were living under the same roof?\""
msgstr "「そもそもだな。もし鳶丸だったら、下宿先が同じって理由だけで、蒼崎に言い寄る気になるかい？」"

#. Occurrence 8_1:2661:10601: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0033; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2661
msgctxt "text_id=10601 | speaker=tobimaru"
msgid "\"...Nope, never.\""
msgstr "「……いや。ならねえな、そりゃあ」"

#. Occurrence 8_1:2666:10602: scene=8_1
#: 8_1:2666
msgctxt "text_id=10602 | speaker=unknown"
msgid "  Tobimaru nodded intently, as if he was thinking back over his many ex-relationships."
msgstr "　数々の彼女の戦歴を思い出しているのか、感慨深くうなずく鳶丸。"

#. Occurrence 8_1:2710:10603: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0034; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2710
msgctxt "text_id=10603 | speaker=tobimaru"
msgid "\"Well, this all sounds very wholesome.\""
msgstr "「いや、健全だな」"

#. Occurrence 8_1:2716:10604: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0024; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2716
msgctxt "text_id=10604 | speaker=soujuurou"
msgid "\"Yeah, I feel great.\""
msgstr "「ああ、健全だろ」"

#. Occurrence 8_1:2722:10605: scene=8_1
#: 8_1:2722
msgctxt "text_id=10605 | speaker=unknown"
msgid "  Soujyuro gave no more than a quick affirmation to Tobimaru's despondent murmur."
msgstr "　虚脱感のある鳶丸の呟きに、のんびりと焚火にあたりながら短く同意する草十郎。"

#. Occurrence 8_1:2727:10606: scene=8_1
#: 8_1:2727
msgctxt "text_id=10606 | speaker=unknown"
msgid "  He was doing fine."
msgstr "　もっとも。"

#. Occurrence 8_1:2732:10607: scene=8_1
#: 8_1:2732
msgctxt "text_id=10607 | speaker=unknown"
msgid "  But besides his physical health, it was surely Soujyuro's personality that enabled him to maintain any semblance of peace dealing with both Aoko and Alice while living in that mansion."
msgstr "　健全であるかは別にして、あの洋館に寝泊りし、青子と有珠相手に平静を保てているのは、間違いなく草十郎の<人柄|さいのう>だろう。"

#. Occurrence 8_1:2765:10608: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0025; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2765
msgctxt "text_id=10608 | speaker=soujuurou"
msgid "\"On an unrelated note, I'm totally indebted to Aozaki."
msgstr "「でも、それとは別の話で蒼崎には頭があがらないんだ。"

#. Occurrence 8_1:2771:10609: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0026; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2771
msgctxt "text_id=10609 | speaker=soujuurou"
msgid "  I'm not sure how I can ever repay her for what she's done for me.\""
msgstr "　彼女には、もう返せない借りがあってさ」"

#. Occurrence 8_1:2777:10610: scene=8_1
#: 8_1:2777
msgctxt "text_id=10610 | speaker=unknown"
msgid "  Soujyuro's eyes turned slightly serious as he stared into the fire."
msgstr "　ぼんやりとしていた彼の瞳が、少しだけ真剣になって焚火を見詰める。"

#. Occurrence 8_1:2782:10611: scene=8_1
#: 8_1:2782
msgctxt "text_id=10611 | speaker=unknown"
msgid "  Tobimaru felt that there was more to those words than what Soujyuro was letting on."
msgstr "　それが額面通りの意味でない事は、鳶丸にも感じ取れた。"

#. Occurrence 8_1:2803:10612: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0035; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2803
msgctxt "text_id=10612 | speaker=tobimaru"
msgid "\"So you owe her big time, huh?\""
msgstr "「もう返せない借りだあ？」"

#. Occurrence 8_1:2809:10613: scene=8_1
#: 8_1:2809
msgctxt "text_id=10613 | speaker=unknown"
msgid "  Soujyuro merely nodded in silence at Tobimaru's inquisitive acknowledgment."
msgstr "　繰り返す鳶丸に、草十郎は無言でうなずく。"

#. Occurrence 8_1:2827:10614: scene=8_1
#: 8_1:2827
msgctxt "text_id=10614 | speaker=unknown"
msgid "  And just then..."
msgstr "　―――と。"

#. Occurrence 8_1:2832:10615: scene=8_1
#: 8_1:2832
msgctxt "text_id=10615 | speaker=unknown"
msgid "  A strange scream pierced through the still silence of the wood like a knife."
msgstr "　深刻な沈黙を破るように、森の奥から妙な叫び声が届いてきた。"

#. Occurrence 8_1:2858:10616: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0036; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2858
msgctxt "text_id=10616 | speaker=tobimaru"
msgid "\"...Did you hear that?\""
msgstr "「……なんか聞こえたな？」"

#. Occurrence 8_1:2867:10617: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0027; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2867
msgctxt "text_id=10617 | speaker=soujuurou"
msgid "\"Yeah, and it was Kinomi.\""
msgstr "「ああ、木乃美だ」"

#. Occurrence 8_1:2873:10618: scene=8_1
#: 8_1:2873
msgctxt "text_id=10618 | speaker=unknown"
msgid "  Soujyuro had already stood up before he responded."
msgstr "　答えるより早く草十郎は立ち上がる。"

#. Occurrence 8_1:2892:10619: scene=8_1
#: 8_1:2892
msgctxt "text_id=10619 | speaker=unknown"
msgid "  He bolted to the frozen pond, broke the ice with his broom,"
msgstr "　そのまま凍った池まで走り、竹ぼうきで氷を叩き割り、"

msgctxt "text_id=10620 | speaker=unknown"
msgid " scooped up some of the frigid water in a bucket and threw it on the fire, all in less than ten seconds."
msgstr "バケツに水を汲んで焚火にぶちまける。十秒足らずの早技だった。"

#. Occurrence 8_1:2915:10621: scene=8_1
#: 8_1:2915
msgctxt "text_id=10621 | speaker=unknown"
msgid "  Then he immediately ran off into the depths of the woods from where he heard the scream."
msgstr "　草十郎は絶叫が聞こえた森の奥へと走り出す。"

#. Occurrence 8_1:2920:10622: scene=8_1
#: 8_1:2920
msgctxt "text_id=10622 | speaker=unknown"
msgid "  Tobimaru followed after him in panicked confusion."
msgstr "　何事かとあわてながら鳶丸も後を追う。"

#. Occurrence 8_1:2971:10623: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0028; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2971
msgctxt "text_id=10623 | speaker=soujuurou"
msgid "\"Tobimaru, do you know what's down this way?\""
msgstr "「鳶丸、この先に何かあるのか？」"

#. Occurrence 8_1:2977:10624: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0037; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2977
msgctxt "text_id=10624 | speaker=tobimaru"
msgid "\"The remains of the old school building should be there.\""
msgstr "「たしか旧校舎が残ってるはずだ」"

#. Occurrence 8_1:2983:10625: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0029; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2983
msgctxt "text_id=10625 | speaker=soujuurou"
msgid "\"Anything else? You know, like a pack of wild dogs, or bad stuff like that?\""
msgstr "「他には？　野犬の住みかとか、そういうイヤな話は？」"

#. Occurrence 8_1:2989:10626: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0038; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2989
msgctxt "text_id=10626 | speaker=tobimaru"
msgid "\"Huh? No, dude. If anything it'd just be some deer, or rabbits, or something.\""
msgstr "「はあ？　いや、いるとしても鹿か兎じゃねえか？」"

#. Occurrence 8_1:2995:10627: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0030; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2995
msgctxt "text_id=10627 | speaker=soujuurou"
msgid "\"Then there's nothing to be afraid of. Let's hurry.\""
msgstr "「なら怖がるコトもないか。急ごう、鳶丸」"

#. Occurrence 8_1:3015:10628: scene=8_1
#: 8_1:3015
msgctxt "text_id=10628 | speaker=unknown"
msgid "  Perhaps because of his time spent growing up in the mountains, Soujyuro quickly sprinted over the slippery dead leaves."
msgstr "　山育ちで慣れているのか、草十郎は腐葉土の上でも軽々と走っていく。"

#. Occurrence 8_1:3020:10629: scene=8_1
#: 8_1:3020
msgctxt "text_id=10629 | speaker=unknown"
msgid "  Tobimaru was not particularly cautious himself, but nevertheless he could not keep up with Soujyuro in here."
msgstr "　鳶丸も足には自信がある方だが、森の中では草十郎には付いていけない。"

#. Occurrence 8_1:3066:10630: scene=8_1
#: 8_1:3066
msgctxt "text_id=10630 | speaker=unknown"
msgid "  Before long, Soujyuro found himself running alone."
msgstr "　そうして、いつしか草十郎はひとりきりで走っていた。"

#. Occurrence 8_1:3071:10631: scene=8_1
#: 8_1:3071
msgctxt "text_id=10631 | speaker=unknown"
msgid "  When foliage blocked the natural trail, he would sometimes clear it away by brute force. But just as often, he would expertly weave through the brush."
msgstr "　木々の葉で閉ざされた獣道を、時には両手で力強く払い除けながら、時には柳のように擦り抜けながら。"

#. Occurrence 8_1:3076:10632: scene=8_1
#: 8_1:3076
msgctxt "text_id=10632 | speaker=unknown"
msgid "  It was clear that he was used to dealing with this level of nature."
msgstr "　この程度の緑の深さなら慣れたものらしい。"

#. Occurrence 8_1:3125:10633: scene=8_1
#: 8_1:3125
msgctxt "text_id=10633 | speaker=unknown"
msgid "  After a few minutes, Soujyuro arrived at a clearing."
msgstr "　数分後、草十郎はその広場に辿り着いた。"

#. Occurrence 8_1:3130:10634: scene=8_1
#: 8_1:3130
msgctxt "text_id=10634 | speaker=unknown"
msgid "  The wall of trees had ended."
msgstr "　木々の壁はここで終わっている。"

#. Occurrence 8_1:3135:10635: scene=8_1
#: 8_1:3135
msgctxt "text_id=10635 | speaker=unknown"
msgid "  It was an obviously man-made clearing here on the mountainside."
msgstr "　山の中腹に<拓|ひら>かれた人工の広場。"

#. Occurrence 8_1:3140:10636: scene=8_1
#: 8_1:3140
msgctxt "text_id=10636 | speaker=unknown"
msgid "  In the distance was what looked like an old wooden school building."
msgstr "　遠くに見える木造の建物が旧校舎だろう。"

#. Occurrence 8_1:3145:10637: scene=8_1
#: 8_1:3145
msgctxt "text_id=10637 | speaker=unknown"
msgid "  It was a small, aesthetically pleasing building no larger than an elementary school, lost in the depths of the winter wilderness."
msgstr "　小学校ほどの、小さいが趣のある建物が、人知れず冬の荒れ野に埋没していた。"

#. Occurrence 8_1:3178:10638: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0031; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3178
msgctxt "text_id=10638 | speaker=soujuurou"
msgid "\"Kinomi.\""
msgstr "「木乃美」"

#. Occurrence 8_1:3183:10639: scene=8_1
#: 8_1:3183
msgctxt "text_id=10639 | speaker=unknown"
msgid "  Kinomi stood alone on the old school's grounds."
msgstr "　その旧校舎のグラウンドに、木乃美はひとりで立ちつくしていた。"

#. Occurrence 8_1:3192:10640: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0020; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:3192
msgctxt "text_id=10640 | speaker=kinomi"
msgid "\"Hey. What are you doing here, Sizuki?\""
msgstr "「お？　なんで静希まで追いかけてきたん？」"

#. Occurrence 8_1:3197:10641: scene=8_1
#: 8_1:3197
msgctxt "text_id=10641 | speaker=unknown"
msgid "  A sour expression came over Soujyuro's face as Kinomi tilted his head in confusion."
msgstr "　不思議そうに首をかしげる木乃美に、草十郎はむっと顔をしかめる。"

#. Occurrence 8_1:3203:10642: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0032; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3203
msgctxt "text_id=10642 | speaker=soujuurou"
msgid "\"That's what I want to know. And what was that scream all about?\""
msgstr "「そっちこそどうしたんだ。へんな声あげて」"

#. Occurrence 8_1:3234:10643: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0021; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:3234
msgctxt "text_id=10643 | speaker=kinomi"
msgid "\"Huh? What scream? I was just pissed at this dumb kid."
msgstr "「声ぇ？　いや、そりゃガキ相手に怒鳴ったけどよ。"

#. Occurrence 8_1:3240:10644: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0022; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:3240
msgctxt "text_id=10644 | speaker=kinomi"
msgid "  Look, there he is. I know he's got some potatoes on him. Dammit, we let him run off inside!\""
msgstr "　ほら、あのガキだよ。イモ持ってるだろ……ってああ、中に逃げこみやがった！」"

#. Occurrence 8_1:3246:10645: scene=8_1
#: 8_1:3246
msgctxt "text_id=10645 | speaker=unknown"
msgid "  Kinomi pointed resentfully toward the old school building."
msgstr "　旧校舎を指差しながら<憤慨|ふんがい>する木乃美。"

#. Occurrence 8_1:3251:10646: scene=8_1
#: 8_1:3251
msgctxt "text_id=10646 | speaker=unknown"
msgid "  There was indeed somebody standing at the entrance to the building just over three hundred feet in the distance."
msgstr "　確かに、百メートルほど離れた旧校舎の入り口に、人影らしきものが立っている。"

#. Occurrence 8_1:3277:10647: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0023; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:3277
msgctxt "text_id=10647 | speaker=kinomi"
msgid "\"What the hell is he doing up here anyway? Is this where kids hang out nowadays?\""
msgstr "「ったく、こんな上まで来やがって。いつから子供の遊び場になってんだ、ここ」"

#. Occurrence 8_1:3283:10648: scene=8_1
#: 8_1:3283
msgctxt "text_id=10648 | speaker=unknown"
msgid "  Kinomi shrugged his shoulders to signal how little he cared what the young children did with their time."
msgstr "　まあどうでもいいけど、と木乃美は肩をすくめる。"

#. Occurrence 8_1:3288:10649: scene=8_1
#: 8_1:3288
msgctxt "text_id=10649 | speaker=unknown"
msgid "  This place was deep in the woods, but it was not particularly dangerous."
msgstr "　ここの森は深くはあるが、遭難するほどの場所でもない。"

#. Occurrence 8_1:3293:10650: scene=8_1
#: 8_1:3293
msgctxt "text_id=10650 | speaker=unknown"
msgid "  Soujyuro had run through the wood to get here, but there was also a paved road leading to this spot from outside the woods, too."
msgstr "　草十郎は森の中をつっきってきたが、外にはコンクリートで舗装された道があるのだ。"

#. Occurrence 8_1:3298:10651: scene=8_1
#: 8_1:3298
msgctxt "text_id=10651 | speaker=unknown"
msgid "  Kinomi apparently followed that road to get here."
msgstr "　木乃美はそちらを使って登ってきたようだ。"

#. Occurrence 8_1:3333:10652: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0033; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3333
msgctxt "text_id=10652 | speaker=soujuurou"
msgid "\"Hmm... a child?\""
msgstr "「んー……子供………？」"

#. Occurrence 8_1:3338:10653: scene=8_1
#: 8_1:3338
msgctxt "text_id=10653 | speaker=unknown"
msgid "  Soujyuro squinted."
msgstr "　目を細めて草十郎は呟く。"

#. Occurrence 8_1:3356:10654: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0024; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:3356
msgctxt "text_id=10654 | speaker=kinomi"
msgid "\"Yeah, he had blond hair, which kinda freaked me out at first. Foreign kids are scary, man!\""
msgstr "「ああ。金髪なんでさっきはちょっと驚いたけどな。外国人の子供って、なんか怖いだろ？」"

#. Occurrence 8_1:3376:10655: scene=8_1
#: 8_1:3376
msgctxt "text_id=10655 | speaker=unknown"
msgid "  It was indeed quite rare to see a foreigner in a provincial town such as Misaki."
msgstr "　地方都市において、まだ外国人の姿は珍しい。"

#. Occurrence 8_1:3381:10656: scene=8_1
#: 8_1:3381
msgctxt "text_id=10656 | speaker=unknown"
msgid "  Soujyuro had never even seen a foreigner in person, which made the whole thing even more mysterious."
msgstr "　テレビならいざしらず、生で外国の子供を見た事がない草十郎にはよけい不思議な感覚だった。"

#. Occurrence 8_1:3419:10657: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0034; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3419
msgctxt "text_id=10657 | speaker=soujuurou"
msgid "\"Why did you feel the need to run all the way up here again?\""
msgstr "「それで、木乃美はなんでここまで？」"

#. Occurrence 8_1:3439:10658: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0025; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:3439
msgctxt "text_id=10658 | speaker=kinomi"
msgid "\"Eh, Akabane said that stupid kid stole their food, so I was chasing him down and ended up here."
msgstr "「いや、赤羽たちがよ、ガキに食料奪われたって言うからここまで追いかけてきたんだ。"

#. Occurrence 8_1:3446:10659: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0026; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:3446
msgctxt "text_id=10659 | speaker=kinomi"
msgid "Since you're here, let's team up and see if we can catch him.\""
msgstr "そういう事だから、ふたりがかりであのお子さまとっちめようぜ」"

#. Occurrence 8_1:3464:10660: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0035; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3464
msgctxt "text_id=10660 | speaker=soujuurou"
msgid "\"That's a little menacing, Kinomi.\""
msgstr "「怖いことを考えるな、木乃美は」"

#. Occurrence 8_1:3470:10661: scene=8_1
#: 8_1:3470
msgctxt "text_id=10661 | speaker=unknown"
msgid "  Soujyuro could not find it in him to agree with his plan."
msgstr "　賛同しかねる、と草十郎。"

#. Occurrence 8_1:3475:10662: scene=8_1
#: 8_1:3475
msgctxt "text_id=10662 | speaker=unknown"
msgid "  It seemed unfair to team up against a little kid."
msgstr "　<多勢|たぜい>に<無勢|ぶぜい>は義に反する、といわんばかりである。"

#. Occurrence 8_1:3501:10663: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0036; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3501
msgctxt "text_id=10663 | speaker=soujuurou"
msgid "\"Come on, let's head back. That kid is over there just staring at us."
msgstr "「いいから帰ろう。あの子、こっちを睨んでるじゃないか。"

#. Occurrence 8_1:3507:10664: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0037; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3507
msgctxt "text_id=10664 | speaker=soujuurou"
msgid "  And besides, if Tobimaru sees us up here slacking off we're gonna be cleaning this mountain for the whole of winter break.\""
msgstr "　それに、鳶丸にこんなところ見られたら冬休み中ずっと山の掃除で終わる事になるぞ？」"

#. Occurrence 8_1:3542:10665: scene=8_1
#: 8_1:3542
msgctxt "text_id=10665 | speaker=unknown"
msgid "  Soujyuro took Kinomi by the shoulders and began leading him back to the path he came from."
msgstr "　ぽん、と木乃美の肩に手を置いて、草十郎はもと来た道を戻りはじめた。"

#. Occurrence 8_1:3547:10666: scene=8_1
#: 8_1:3547
msgctxt "text_id=10666 | speaker=unknown"
msgid "  Kinomi cast one last gaze at the old school building before reluctantly following."
msgstr "　木乃美は口惜しげに旧校舎に視線を投げて、草十郎に付いていく。"

#. Occurrence 8_1:3579:10667: scene=8_1
#: 8_1:3579
msgctxt "text_id=10667 | speaker=unknown"
msgid "  Just then, Tobimaru appeared, panting and out of breath."
msgstr "　そんなふたりを出迎えるように、息を切らした鳶丸が登ってきた。"

#. Occurrence 8_1:3613:10668: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0039; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:3613
msgctxt "text_id=10668 | speaker=tobimaru"
msgid "\"How... are you... so fast?!\""
msgstr "「は、速いな、草十郎」"

#. Occurrence 8_1:3619:10669: scene=8_1
#: 8_1:3619
msgctxt "text_id=10669 | speaker=unknown"
msgid "  Tobimaru could hardly catch his breath."
msgstr "　鳶丸の息は乱れている。"

#. Occurrence 8_1:3624:10670: scene=8_1
#: 8_1:3624
msgctxt "text_id=10670 | speaker=unknown"
msgid "  He arrived about three minutes behind Soujyuro, despite having a good set of legs on him."
msgstr "　草十郎に遅れること三分弱だが、十分に健脚だ。"

#. Occurrence 8_1:3645:10671: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0040; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:3645
msgctxt "text_id=10671 | speaker=tobimaru"
msgid "\"So what's going on? Are you all right, Kinomi?\""
msgstr "「それでどうした。木乃美、無事か？」"

#. Occurrence 8_1:3666:10672: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0027; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:3666
msgctxt "text_id=10672 | speaker=kinomi"
msgid "\"Huh? Yeah I'm fine. What about you, Your Highness?\""
msgstr "「？　無事も何も、殿下こそどったん？」"

#. Occurrence 8_1:3672:10673: scene=8_1
#: 8_1:3672
msgctxt "text_id=10673 | speaker=unknown"
msgid "  Kinomi seemed perplexed at Tobimaru's first-ever display of concern for him."
msgstr "　鳶丸に心配されるコトなど初めてなのか、目をしばたたく木乃美。"

#. Occurrence 8_1:3709:10674: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0041; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:3709
msgctxt "text_id=10674 | speaker=tobimaru"
msgid "\"What the hell is that supposed to mean? You're out here in the middle of nowhere screaming bloody murder and what am I supposed to think? We were worried!\""
msgstr "「なんだそりゃ。テメェ、あれだけの大声をあげておいてしらばっくれる気か？　上で何かあったんだろうが」"

#. Occurrence 8_1:3737:10675: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0038; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3737
msgctxt "text_id=10675 | speaker=soujuurou"
msgid "\"That was my fault. I guess I jumped to conclusions."
msgstr "「すまない、こっちの早とちりだった。"

#. Occurrence 8_1:3743:10676: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0039; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3743
msgctxt "text_id=10676 | speaker=soujuurou"
msgid "  You've probably never heard him do it, but sometimes at work Kinomi has this habit of letting out a weird yell like that.\""
msgstr "　鳶丸は知らないだろうけど、木乃美は時々、バイト先でも奇声をあげる癖があるんだ」"

#. Occurrence 8_1:3748:10677: scene=8_1
#: 8_1:3748
msgctxt "text_id=10677 | speaker=unknown"
msgid "  Kinomi looked disapproving as Soujyuro nonchalantly shared this insight. This was the first he had ever heard of it."
msgstr "　堂々と言う草十郎の横で、木乃美は不満げに顔をしかめる。彼的に、そんな噂は初耳だった。"

#. Occurrence 8_1:3792:10678: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0042; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:3792
msgctxt "text_id=10678 | speaker=tobimaru"
msgid "\"...I'm not buying it. You're up to something, aren't you?\""
msgstr "「……怪しいな。また良からぬ事でも企んでるんじゃねえか、そこの？」"

#. Occurrence 8_1:3809:10679: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0040; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3809
msgctxt "text_id=10679 | speaker=soujuurou"
msgid "\"Of course not. Come on, Tobimaru, there's cleaning to be done.\""
msgstr "「無いよ。戻って掃除の続きをするぞ、鳶丸」"

#. Occurrence 8_1:3815:10680: scene=8_1
#: 8_1:3815
msgctxt "text_id=10680 | speaker=unknown"
msgid "  Soujyuro pat Tobimaru on the shoulder a couple of times and started walking."
msgstr "　ぽんぽんと鳶丸の肩を叩いて草十郎は歩きだす。"

#. Occurrence 8_1:3820:10681: scene=8_1
#: 8_1:3820
msgctxt "text_id=10681 | speaker=unknown"
msgid "  Tobimaru cast a doubtful glare in his direction as he meandered off."
msgstr "　そんな草十郎に、鳶丸は不審げな眼差しを向けた。"

#. Occurrence 8_1:3825:10682: scene=8_1
#: 8_1:3825
msgctxt "text_id=10682 | speaker=unknown"
msgid "  He had a feeling that Soujyuro was covering for Kinomi somehow."
msgstr "　なんとなく、草十郎が木乃美の悪事を<庇|かば>っているように思えたからだ。"

#. Occurrence 8_1:3861:10683: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0043; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:3861
msgctxt "text_id=10683 | speaker=tobimaru"
msgid "\"You didn't set the old school building on fire or something, did you?\""
msgstr "「まさか、旧校舎に火なんてつけてないだろうな？」"

#. Occurrence 8_1:3867:10684: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0041; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3867
msgctxt "text_id=10684 | speaker=soujuurou"
msgid "\"Of course not. Who would even do that?\""
msgstr "「誰もしないよ、そんな事は」"

#. Occurrence 8_1:3874:10685: scene=8_1
#: 8_1:3874
msgctxt "text_id=10685 | speaker=unknown"
msgid "  Soujyuro kept walking and did not even look back at Tobimaru as he spoke."
msgstr "　さっさと掃除に戻りたいらしく、草十郎は背後の鳶丸を振り向きもせず歩いていく。"

#. Occurrence 8_1:3879:10686: scene=8_1
#: 8_1:3879
msgctxt "text_id=10686 | speaker=unknown"
msgid "  Tobimaru and Kinomi tilted their heads in confusion as they reluctantly followed the unusually aggressive Soujyuro back to their cleaning spot."
msgstr "　鳶丸と木乃美は首をかしげながらも、めずらしく強引な草十郎に従った。"

#. Occurrence 8_2:47:10687: scene=8_2
#: 8_2:47
msgctxt "text_id=10687 | speaker=unknown"
msgid "  And so, the Special Winter Cleaning Team's activities ended uneventfully."
msgstr "　これといった快事も不祥事もなく、本日の特別清掃班の活動は終了した。"

#. Occurrence 8_2:52:10688: scene=8_2
#: 8_2:52
msgctxt "text_id=10688 | speaker=unknown"
msgid "  The time was three in the afternoon."
msgstr "　ただいまの時刻、午後三時。"

#. Occurrence 8_2:57:10689: scene=8_2
#: 8_2:57
msgctxt "text_id=10689 | speaker=unknown"
msgid "  Upon departing, Kinomi and his crew invited Soujyuro to come hang out with them, but he declined politely due to his job that evening."
msgstr "　別れ際、草十郎は木乃美たちから遊びに誘われたが、夕方からアルバイトが入っている、と丁寧に断った。"

#. Occurrence 8_2:78:10690: scene=8_2
#: 8_2:78
msgctxt "text_id=10690 | speaker=unknown"
msgid "  He had about two hours until his shift began."
msgstr "　夕方からのバイトまであと二時間ほど。"

#. Occurrence 8_2:83:10691: scene=8_2
#: 8_2:83
msgctxt "text_id=10691 | speaker=unknown"
msgid "  Not quite enough time to do anything fun, but just enough time to have to fill it with something."
msgstr "　遊ぶほどの時間はないが、さりとて、暇つぶしには持て余す長さと言える。"

#. Occurrence 8_2:110:10692: scene=8_2
#: 8_2:110
msgctxt "text_id=10692 | speaker=unknown"
msgid "  Soujyuro thought about relaxing in a park somewhere, but quickly changed his mind after remembering how cold it was, even in the city."
msgstr "　公園で体を休める、という考えも浮かんだが、町中でも冬の寒さはそれなりに堪えるので却下。"

#. Occurrence 8_2:130:10693: scene=8_2
#: 8_2:130
msgctxt "text_id=10693 | speaker=unknown"
msgid "  Not to forget that Aoko handed him those pills in the morning."
msgstr "　ちなみに、例の錠剤は朝のうちに青子から手渡されていた。"

#. Occurrence 8_2:135:10694: scene=8_2
#: 8_2:135
msgctxt "text_id=10694 | speaker=unknown"
msgid "  Aoko was absolutely correct in her prediction. Heading back to the mansion now would just be a waste of time."
msgstr "　青子の読みはまったく正しい。今から洋館に戻ってもすぐとんぼ返りになるだけである。"

#. Occurrence 8_2:140:10695: scene=8_2
#: 8_2:140
msgctxt "text_id=10695 | speaker=unknown"
msgid "  There was no reason for him to return to the mansion until after his shift at work."
msgstr "　骨折り損のなんとやらで、アルバイトを終えるまで洋館に戻る必要はまったくない。"

#. Occurrence 8_2:183:10696: scene=8_2
#: 8_2:183
msgctxt "text_id=10696 | speaker=unknown"
msgid "  Still, Soujyuro found himself on the way back anyway."
msgstr "　―――まったくないのだが、草十郎はすんなり帰途についていた。"

#. Occurrence 8_2:188:10697: scene=8_2
#: 8_2:188
msgctxt "text_id=10697 | speaker=unknown"
msgid "  Having grown up deep in the mountains, a little two hour walk was really no sweat off his back."
msgstr "　山奥育ちにとって、二時間程度の散歩は苦でもなんでもないのである。"

#. Occurrence 8_2:221:10698: scene=8_2
#: 8_2:221
msgctxt "text_id=10698 | speaker=unknown"
msgid "  Misaki was one of the more quiet residential areas in Misaki City."
msgstr "　この三咲町は三咲市の中でも閑静な住宅地に入る。"

#. Occurrence 8_2:226:10699: scene=8_2
#: 8_2:226
msgctxt "text_id=10699 | speaker=unknown"
msgid "  The only thing that really stood out here was Shiroinuzuka."
msgstr "　その中でひときわ異質なのがここ白犬塚だ。"

#. Occurrence 8_2:231:10700: scene=8_2
#: 8_2:231
msgctxt "text_id=10700 | speaker=unknown"
msgid "  It was a hill that lead directly into the woods."
msgstr "　森に向かうひとつきりの坂道。"

#. Occurrence 8_2:236:10701: scene=8_2
#: 8_2:236
msgctxt "text_id=10701 | speaker=unknown"
msgid "  The silhouette of the mountains served as backdrop to suburbia, silently overshadowing the small human actions of the people who lived there."
msgstr "　住宅地の奥にそびえる山影は、物言わずとも人々の営みを威圧している。"

#. Occurrence 8_2:256:10702: scene=8_2
#: 8_2:256
msgctxt "text_id=10702 | speaker=unknown"
msgid "  Even in this modern day of technological progress, the people here were always careful to pay reverence to the nature around them."
msgstr "　近代化の進む現代においても、自然への<崇拝|すうはい>は住民たちの心に根付いている。"

#. Occurrence 8_2:261:10703: scene=8_2
#: 8_2:261
msgctxt "text_id=10703 | speaker=unknown"
msgid "  If that mansion were a shrine, it would not be a haunted house but a famous tourist attraction."
msgstr "　あの洋館も、何らかの<社|やしろ>であれば幽霊屋敷などではなく、霊験あらたかな観光名所になっていたかもしれない。"

#. Occurrence 8_2:282:10704: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_2_0000; voice_prefix=A30; voice_category=3; scene=8_2
#: 8_2:282
msgctxt "text_id=10704 | speaker=soujuurou"
msgid "\"...Wait, I just realized something.\""
msgstr "「……というより、今さら気付いたけど……」"

#. Occurrence 8_2:288:10705: scene=8_2
#: 8_2:288
msgctxt "text_id=10705 | speaker=unknown"
msgid "  The houses around Shiroinuzuka were all magnificent."
msgstr "　白犬塚周辺の家は、どれもたいへん立派である。"

#. Occurrence 8_2:293:10706: scene=8_2
#: 8_2:293
msgctxt "text_id=10706 | speaker=unknown"
msgid "  Soujyuro understood as he looked from the bottom of this hill where the rest of the town lived at the roof of the mansion tucked away in the woods."
msgstr "　人々の住む坂の下から、森の中にある洋館の屋根を見上げ、なるほど、と草十郎は納得した。"

#. Occurrence 8_2:298:10707: scene=8_2
#: 8_2:298
msgctxt "text_id=10707 | speaker=unknown"
msgid "  He understood what Tobimaru was talking about, about how the Kuonji family who owned that mansion might be the richest people in town."
msgstr "　鳶丸の言う通り、あの洋館を所有する久遠寺家はこの町一番のお金持ちなのだ、と。"

#. Occurrence 8_2:319:10708: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_2_0001; voice_prefix=A30; voice_category=3; scene=8_2
#: 8_2:319
msgctxt "text_id=10708 | speaker=soujuurou"
msgid "\"They really do hate me. Why else would they ask for rent?\""
msgstr "「……そのわりに家賃を取るところを見ると、やっぱり嫌われていると見るべきか」"

#. Occurrence 8_2:325:10709: scene=8_2
#: 8_2:325
msgctxt "text_id=10709 | speaker=unknown"
msgid "  Soujyuro began walking towards the mansion with such thoughts simmering in his mind."
msgstr "　ふむ、とそんな事を考えつつ、草十郎は洋館への坂道を歩きはじめた。"

#. Occurrence 8_2:330:10710: scene=8_2
#: 8_2:330
msgctxt "text_id=10710 | speaker=unknown"
msgid "  The feeling of the hard asphalt beneath his feet instead of soft dirt felt lonely and isolating."
msgstr "　土の感触のないアスファルトの道が少し<淋|さみ>しい。"

#. Occurrence 8_2:375:10711: scene=8_2
#: 8_2:375
msgctxt "text_id=10711 | speaker=unknown"
msgid "  He walked along the paved road for ten minutes or so before reaching the iron fence of the wood."
msgstr "　舗装された道を十分ほど歩いて、森の鉄柵にたどり着く。"

#. Occurrence 8_2:380:10712: scene=8_2
#: 8_2:380
msgctxt "text_id=10712 | speaker=unknown"
msgid "  Beyond this fence was the private property of the Kuonji family."
msgstr "　この先は久遠寺の私有地だ。"

#. Occurrence 8_2:385:10713: scene=8_2
#: 8_2:385
msgctxt "text_id=10713 | speaker=unknown"
msgid "  It was bereft of any awkward no-trespassing signs."
msgstr "　関係者以外立ち入り禁止、といった不粋な看板はない。"

#. Occurrence 8_2:390:10714: scene=8_2
#: 8_2:390
msgctxt "text_id=10714 | speaker=unknown"
msgid "  The tall, overbearing iron fence was more than enough to remind visitors that they were unwelcome there."
msgstr "　ただ、訪れた者の精神を圧迫する、いかつい鉄柵が<人避|ひとよ>けの結界となっている。"

#. Occurrence 8_2:423:10715: scene=8_2
#: 8_2:423
msgctxt "text_id=10715 | speaker=unknown"
msgid "  Soujyuro casually pushed on the iron gate."
msgstr "　そんな鉄柵を、草十郎は気軽に押し開ける。"

#. Occurrence 8_2:428:10716: scene=8_2
#: 8_2:428
msgctxt "text_id=10716 | speaker=unknown"
msgid "  Only two days had passed since the end of final exams, and he already seemed more than comfortable with the idea of entering this wood alone."
msgstr "　期末試験が終わってからまだ二日しか経っていないのに、ひとりでこの森に入る事に慣れきった風である。"

#. Occurrence 8_2:458:10717: scene=8_2
#: 8_2:458
msgctxt "text_id=10717 | speaker=unknown"
msgid "  The path to the mansion from inside the wood curved and bent like a snake."
msgstr "　森から洋館までの林道は、やはり蛇のように曲がりくねっている。"

#. Occurrence 8_2:463:10718: scene=8_2
#: 8_2:463
msgctxt "text_id=10718 | speaker=unknown"
msgid "  It took about fifteen minutes to reach the mansion on this path."
msgstr "　林道を使うと洋館の敷地まで約十五分。"

#. Occurrence 8_2:468:10719: scene=8_2
#: 8_2:468
msgctxt "text_id=10719 | speaker=unknown"
msgid "  He could have chosen to ignore the long incline and travel in a straight line through the wood, but he would have expended significantly more energy in doing so. No, using the wooded path was the sensible option, barring an emergency."
msgstr "　なだらかな坂道を無視して森を一直線に歩いてもいいのだが、その場合、疲労は何倍にもなる。火急の用でもないかぎり、林道を使うのが常識的だ。"

#. Occurrence 8_2:542:10720: scene=8_2
#: 8_2:542
msgctxt "text_id=10720 | speaker=unknown"
msgid "  Upon entering the foyer, Soujyuro heard a conversation coming from the drawing room."
msgstr "　ロビーに入ると、居間から話し声が聞こえてきた。"

#. Occurrence 8_2:547:10721: scene=8_2
#: 8_2:547
msgctxt "text_id=10721 | speaker=unknown"
msgid "  It was no doubt Aoko and Alice. Soujyuro decided to join them."
msgstr "　青子と有珠のものであるのは間違いなく、とりあえず草十郎は居間へと向かう。"

#. Occurrence 8_2:582:10722: scene=8_2
#: 8_2:582
msgctxt "text_id=10722 | speaker=unknown"
msgid "  Ever since final exams had ended, Aoko and Alice had switched from their daily routine to a more irregular schedule."
msgstr "　期末試験が終わった日から、青子と有珠の生活スタイルは日常から非日常へと切り替わっていた。"

#. Occurrence 8_2:589:10723: scene=8_2
#: 8_2:589
msgctxt "text_id=10723 | speaker=unknown"
msgid "  Aoko would disappear into Alice's room in the west wing of the mansion for a while, where she would remain,"
msgstr "　青子が有珠の部屋……館の西館、左翼一帯……に行ったきり戻ってこなかったり、"

#. Occurrence 8_2:596:10724: scene=8_2
#: 8_2:596
msgctxt "text_id=10724 | speaker=unknown"
msgid "  and Alice would go into Aoko's room, not to be seen again."
msgstr "　有珠が青子の部屋に入ったきり出てこなかったりと、"

#. Occurrence 8_2:601:10725: scene=8_2
#: 8_2:601
msgctxt "text_id=10725 | speaker=unknown"
msgid "  Or they would vanish into the corridors leading around to the rear of the mansion doing who knows what, where Soujyuro was most certainly not allowed to enter."
msgstr "　絶対立ち入り禁止とされる屋敷裏手に回る廊下の先に向かったりと、草十郎の知らないところで絶賛活動中だ。"

#. Occurrence 8_2:635:10726: scene=8_2
#: 8_2:635
msgctxt "text_id=10726 | speaker=unknown"
msgid "  Not that he was interested in what they were doing since Aoko and Alice did not seem to want to include him either, serving both parties nicely."
msgstr "　もっとも、草十郎はそれに関わる気もないし、青子たちも関わらせる気もないので、今のところ問題はない。"

#. Occurrence 8_2:640:10727: scene=8_2
#: 8_2:640
msgctxt "text_id=10727 | speaker=unknown"
msgid "  For the time being, the Kuonji Estate was pretty peaceful."
msgstr "　久遠寺邸はとりあえず平穏である。"

#. Occurrence 8_2:698:10728: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_2_0002; voice_prefix=A30; voice_category=3; scene=8_2
#: 8_2:698
msgctxt "text_id=10728 | speaker=soujuurou"
msgid "\"I'm home.\""
msgstr "「ただいま」"

#. Occurrence 8_2:704:10729: scene=8_2
#: 8_2:704
msgctxt "text_id=10729 | speaker=unknown"
msgid "  Soujyuro quietly opened the door to the drawing room."
msgstr "　草十郎は静かに居間の扉を開けた。"

#. Occurrence 8_2:709:10730: scene=8_2
#: 8_2:709
msgctxt "text_id=10730 | speaker=unknown"
msgid "  Even though they tried not to be involved in each other's business, Soujyuro made it a habit to greet them."
msgstr "　お互い関わらないようにしているといっても、挨拶はきちんとする。それが彼の方針である。"

#. Occurrence 8_2:744:10731: scene=8_2
#: 8_2:744
msgctxt "text_id=10731 | speaker=unknown"
msgid "  The two girls sat across from him on the sofa."
msgstr "　ふたりは向かい合うかたちでソファーに座っていた。"

#. Occurrence 8_2:749:10732: scene=8_2
#: 8_2:749
msgctxt "text_id=10732 | speaker=unknown"
msgid "  On the table in front of them was a large, extravagantly decorated mirror."
msgstr "　テーブルの上には豪華な装飾をした、大きな鏡が置かれている。"

#. Occurrence 8_2:754:10733: scene=8_2
#: 8_2:754
msgctxt "text_id=10733 | speaker=unknown"
msgid "  Aoko was dressed for comfort; wearing jeans instead of her usual skirt."
msgstr "　青子の服装は動きやすさを重視したもので、下はスカートではなくジーンズを穿いていた。"

#. Occurrence 8_2:759:10734: scene=8_2
#: 8_2:759
msgctxt "text_id=10734 | speaker=unknown"
msgid "  In stark contrast, Alice was dressed in her usual all black."
msgstr "　そんな青子とは対照的に、有珠はいつもの黒衣のままだ。"

#. Occurrence 8_2:764:10735: scene=8_2
#: 8_2:764
msgctxt "text_id=10735 | speaker=unknown"
msgid "  Even though the break from school was well underway, the witch still insisted on wearing black."
msgstr "　学校はとっくに休みに入っているというが、<頑|かたく>なにあの黒衣を通している。"

#. Occurrence 8_2:800:10736: scene=8_2
#: 8_2:800
msgctxt "text_id=10736 | speaker=unknown"
msgid "  As Aoko had explained, it was probably because it was too much effort for Alice to wear anything else."
msgstr "　青子曰く、「単に面倒だからでしょ」とのコト。"

#. Occurrence 8_2:805:10737: scene=8_2
#: 8_2:805
msgctxt "text_id=10737 | speaker=unknown"
msgid "  Soujyuro's thought was that he would like to see her wear something different."
msgstr "　少しは違う服装を見たいな、と思う草十郎である。"

#. Occurrence 8_2:836:10738: scene=8_2
#: 8_2:836
msgctxt "text_id=10738 | speaker=unknown"
msgid "  Aoko and Alice seemed to be in the middle of some sort of dispute; the air in the drawing room was tense."
msgstr "　何か口論していたようで、居間の雰囲気はどこか張り詰めていた。"

#. Occurrence 8_2:841:10739: scene=8_2
#: 8_2:841
msgctxt "text_id=10739 | speaker=unknown"
msgid "  They both ignored his greeting."
msgstr "　草十郎の挨拶にも反応しない。"

#. Occurrence 8_2:846:10740: scene=8_2
#: 8_2:846
msgctxt "text_id=10740 | speaker=unknown"
msgid "  Alice only briefly looked up at him."
msgstr "　ただ有珠がちらり、と草十郎に視線を向けただけだった。"

#. Occurrence 8_2:876:10741: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0000; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:876
msgctxt "text_id=10741 | speaker=aoko"
msgid "\"Hmm, what about the Toukawa point? That pillar is white, so hopefully it won't be so easy to remove.\""
msgstr "「じゃあ<陶川|とうかわ>の<支点|してん>は？　あそこの柱は白色だし、そう簡単には奪われないでしょう？」"

#. Occurrence 8_2:890:10742: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0000; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:890
msgctxt "text_id=10742 | speaker=alice"
msgid "\"...Yes. The Toukawa one is still active, but the Suzuho support next to it has gone, so we can't really be too careful."
msgstr "「……ええ。今のところ陶川は侵食されていないけど、ひとつ隣りの<鈴穂|すずほ>の支点が消された以上、楽観はできないわ。"

#. Occurrence 8_2:890:10743: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0000; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:890
msgctxt "text_id=10743 | speaker=alice"
msgid "  With each sigil they discover, they get better at finding the others.\""
msgstr "　残りの割り出しは今までより早くなる」"

#. Occurrence 8_2:910:10744: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0001; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:910
msgctxt "text_id=10744 | speaker=aoko"
msgid "\"That makes sense. I guess once they've found one, they can easily find the other connections."
msgstr "「そっか。一個釣れれば、あとは芋づる式だもんね。"

#. Occurrence 8_2:927:10745: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0002; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:927
msgctxt "text_id=10745 | speaker=aoko"
msgid "  ...I really messed up. I should have been more careful. This is going to turn into a weekly battle soon.\""
msgstr "　……反省したわ。甘く見てたのはこっちの方だった。ここからは、一週間単位の攻防になるわね」"

#. Occurrence 8_2:963:10746: scene=8_2
#: 8_2:963
msgctxt "text_id=10746 | speaker=unknown"
msgid "  The two continued their heated discussion from opposite sides of the table."
msgstr "　テーブルを挟んでの会話は続く。"

#. Occurrence 8_2:968:10747: scene=8_2
#: 8_2:968
msgctxt "text_id=10747 | speaker=unknown"
msgid "  Aoko neglected to even glance up at Soujyuro."
msgstr "　青子は帰ってきた草十郎を見ようともしない。"

#. Occurrence 8_2:973:10748: scene=8_2
#: 8_2:973
msgctxt "text_id=10748 | speaker=unknown"
msgid "  Soujyuro sensed that she wanted to concentrate on the discussion at hand."
msgstr "　それとも話に集中するため、気を配る必要性を感じていないだけか。"

#. Occurrence 8_2:1017:10749: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0003; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:1017
msgctxt "text_id=10749 | speaker=aoko"
msgid "\"...It's so strange, though."
msgstr "「……でも解せないな。"

#. Occurrence 8_2:1023:10750: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0004; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:1023
msgctxt "text_id=10750 | speaker=aoko"
msgid "  Setting aside the timing of the puppet that night and how quickly they were able to find our expertly hidden sigil, whoever it is most definitely has to have some kind of hideout in the city."
msgstr "　あの夜に人形をだしてくるタイミングといい、隠し方だけは一級品なうちの支点を短期間で特定する事といい、コイツ、まず間違いなく市内に<隠れ家|アジト>を敷いてるわよね。"

#. Occurrence 8_2:1029:10751: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0005; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:1029
msgctxt "text_id=10751 | speaker=aoko"
msgid "  But if that's the case, why aren't we detecting any abnormalities in the field? The dragnet around Misaki City hasn't been broken for nearly a hundred years.\""
msgstr "　なのになんで結界に異常がないんだろう。三咲市一帯の索敵網は、もう百年近く破られた事がないのに」"

#. Occurrence 8_2:1058:10752: scene=8_2
#: 8_2:1058
msgctxt "text_id=10752 | speaker=unknown"
msgid "  Aoko bit her nails nervously, while Alice nodded along."
msgstr "　爪をかむ青子に、有珠は小さくうなずいた。"

#. Occurrence 8_2:1063:10753: scene=8_2
#: 8_2:1063
msgctxt "text_id=10753 | speaker=unknown"
msgid "  It seemed as though she was wondering the same thing."
msgstr "　彼女も青子と同じ疑問を持っているらしい。"

#. Occurrence 8_2:1090:10754: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0001; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:1090
msgctxt "text_id=10754 | speaker=alice"
msgid "\"...Even my mother wasn't able to touch this Bounded Field."
msgstr "「……母もここの結界には触れなかった。"

#. Occurrence 8_2:1096:10755: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0002; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:1096
msgctxt "text_id=10755 | speaker=alice"
msgid "  The only person capable of getting through Misaki's Bounded Field would have been your grandfather or an even more capable mage."
msgstr "　三咲の結界をかいくぐるには貴女のお<祖父|じい>さんか、それ以上の技量を持つ魔術師でないと難しい。"

#. Occurrence 8_2:1103:10756: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0003; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:1103
msgctxt "text_id=10756 | speaker=alice"
msgid "But someone exuding that level of magical energy would find it that much harder to cover his or her tracks."
msgstr "けど、それほどの魔術師なら逆に<魔力|けはい>は隠しきれない。"

#. Occurrence 8_2:1115:10757: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0004; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:1115
msgctxt "text_id=10757 | speaker=alice"
msgid "  ...It could be some kind of unique concealment ward, but I haven't heard anything about any new faerie circles forming these past few years.\""
msgstr "　……なにか特殊な<隠行法|おんぎょうほう>かもしれないわね。ここ数年、新しい<妖精環|サークル>の話は聞かないけど」"

#. Occurrence 8_2:1151:10758: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0006; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:1151
msgctxt "text_id=10758 | speaker=aoko"
msgid "\"Where was it, Sherwood Forest? The May King was able to break through your mist, remember? Do you think there's some sort of concealment stronger than that?\""
msgstr "「なに、シャーウッドの森？　<皐|メ><月|イ><の|キ><王|ン><様|グ>なら以前、有珠の霧が粉砕したじゃない。アレ以上の隠行があるっていうの？」"

#. Occurrence 8_2:1170:10759: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0005; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:1170
msgctxt "text_id=10759 | speaker=alice"
msgid "\"All I'm saying is if whoever we're dealing with has skills greater than our own, maybe there are some techniques we aren't aware of."
msgstr "「例えばの話よ。今回の相手はこちら以上の技量を持っているか、こちらの知らない技術を持っているか。"

#. Occurrence 8_2:1188:10760: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0006; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:1188
msgctxt "text_id=10760 | speaker=alice"
msgid "  Either way we need to reevaluate things. We might be under more pressure than we thought.\""
msgstr "　どちらにせよ評価を改めるべきね。わたしたち、気づかないうちに追い詰められているのかも」"

#. Occurrence 8_2:1218:10761: scene=8_2
#: 8_2:1218
msgctxt "text_id=10761 | speaker=unknown"
msgid "  The two fell silent."
msgstr "　ふたりはそれきり黙りこむ。"

#. Occurrence 8_2:1223:10762: scene=8_2
#: 8_2:1223
msgctxt "text_id=10762 | speaker=unknown"
msgid "  Soujyuro, after some internal deliberation, decided to break the silence."
msgstr "　草十郎はしばし迷ってから、もう一度声をかけてみる事にした。"

#. Occurrence 8_2:1258:10763: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_2_0003; voice_prefix=A30; voice_category=3; scene=8_2
#: 8_2:1258
msgctxt "text_id=10763 | speaker=soujuurou"
msgid "\"So... I'm home.\""
msgstr "「やあ、ただいま」"

#. Occurrence 8_2:1263:10764: scene=8_2
#: 8_2:1263
msgctxt "text_id=10764 | speaker=unknown"
msgid "  Aoko finally looked up at him in response to his hesitant declaration."
msgstr "　遠慮がちなその一言に、青子はようやく草十郎に視線を向けた。"

#. Occurrence 8_2:1294:10765: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0007; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:1294
msgctxt "text_id=10765 | speaker=aoko"
msgid "\"That's fine, Soujyuro, but will you please take a bath? You're dirty.\""
msgstr "「いいからお風呂に入ってきたら？　汚れてるわよ、草十郎」"

#. Occurrence 8_2:1324:10766: scene=8_2
#: 8_2:1324
msgctxt "text_id=10766 | speaker=unknown"
msgid "  And with that, Aoko returned her gaze to the mirror."
msgstr "　それだけ言って、青子は鏡に視線を戻す。"

#. Occurrence 8_2:1329:10767: scene=8_2
#: 8_2:1329
msgctxt "text_id=10767 | speaker=unknown"
msgid "  Alice briefly looked up at Soujyuro again before also returning her gaze to the mirror."
msgstr "　有珠はもう一度だけちらりと草十郎に視線を向けたあと、テーブルの上の鏡に見入った。"

#. Occurrence 8_2:1347:10768: scene=8_2
#: 8_2:1347
msgctxt "text_id=10768 | speaker=unknown"
msgid "  Perhaps feeling at least somewhat satisfied that his greeting was acknowledged, Soujyuro left the drawing room and closed the door behind him."
msgstr "　とりあえず挨拶を済ませて満足したのか、草十郎はぱたんと扉を閉め、居間を<後|あと>にした。"

#. Occurrence 8_2:1393:10769: scene=8_2
#: 8_2:1393
msgctxt "text_id=10769 | speaker=unknown"
msgid "  Aoko was right. His clothes were a little soiled."
msgstr "　青子の言う通り、服の端々はわずかに汚れていた。"

#. Occurrence 8_2:1399:10770: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_2_0004; voice_prefix=A30; voice_category=3; scene=8_2
#: 8_2:1399
msgctxt "text_id=10770 | speaker=soujuurou"
msgid "\"...It's a waste of water, but I guess I should.\""
msgstr "「……そうだな。もったいないけど、確かに」"

#. Occurrence 8_2:1410:10771: scene=8_2
#: 8_2:1410
msgctxt "text_id=10771 | speaker=unknown"
msgid "  Soujyuro returned to his room, thinking that a bath might actually feel pretty nice in this cold weather, despite not really having broken a sweat at all during the day."
msgstr "　別に汗をかいた訳でもないが、この寒さの中での湯浴みはちょっと楽しそうだ、と草十郎は自室に戻る。"

#. Occurrence 8_2:1457:10772: scene=8_2
#: 8_2:1457
msgctxt "text_id=10772 | speaker=unknown"
msgid "  He climbed the stairs from the foyer and up the second flight into the attic."
msgstr "　ロビーから二階へ、さらに階段を上がって屋根裏の部屋に入る。"

#. Occurrence 8_2:1498:10773: scene=8_2
#: 8_2:1498
msgctxt "text_id=10773 | speaker=unknown"
msgid "  Unlike the other rooms in the mansion, this one had no frills to its decor."
msgstr "　ここは他の部屋と違い余計な装飾がない。"

#. Occurrence 8_2:1503:10774: scene=8_2
#: 8_2:1503
msgctxt "text_id=10774 | speaker=unknown"
msgid "  It was a little cumbersome to use as a living space, but comfortable enough for Soujyuro."
msgstr "　暮らすにはいささか不便だが、草十郎にとっては落ち着ける場所でもある。"

#. Occurrence 8_2:1508:10775: scene=8_2
#: 8_2:1508
msgctxt "text_id=10775 | speaker=unknown"
msgid "  Everywhere else in the mansion was a little too gaudy for his tastes."
msgstr "　洋館はどこもかしこも豪華すぎて気を遣うのだろう。"

#. Occurrence 8_2:1513:10776: scene=8_2
#: 8_2:1513
msgctxt "text_id=10776 | speaker=unknown"
msgid "  As far as shelter and a place to sleep went, Soujyuro was more than satisfied with his accommodations."
msgstr "　経緯はどうあれ寝泊りする部屋に関してなら、草十郎はたいへん満足していた。"

#. Occurrence 8_2:1547:10777: scene=8_2
#: 8_2:1547
msgctxt "text_id=10777 | speaker=unknown"
msgid "  There was no electricity in the attic."
msgstr "　屋根裏には電気は通っていない。"

#. Occurrence 8_2:1552:10778: scene=8_2
#: 8_2:1552
msgctxt "text_id=10778 | speaker=unknown"
msgid "  The only light was that which crept in from a small skylight."
msgstr "　明かりは小さな天窓だけだ。"

#. Occurrence 8_2:1557:10779: scene=8_2
#: 8_2:1557
msgctxt "text_id=10779 | speaker=unknown"
msgid "  Not that Soujyuro minded. He was more accustomed to living without electricity than living with it."
msgstr "　が、そもそも電灯に馴染めない草十郎にとって、それはどうでもいい事だ。"

#. Occurrence 8_2:1562:10780: scene=8_2
#: 8_2:1562
msgctxt "text_id=10780 | speaker=unknown"
msgid "  With only the faint winter light to guide him, he readied a change of clothes and a towel before heading down to the foyer."
msgstr "　冬の暗い日射しだけをたよりに着替えとタオルを用意して、ロビーへとって返す。"

#. Occurrence 8_2:1608:10781: scene=8_2
#: 8_2:1608
msgctxt "text_id=10781 | speaker=unknown"
msgid "  Despite the magnificent size of the mansion, there was only one bath in the whole building."
msgstr "　これだけ大きな建物なのに、館には浴場が一つしかない。"

#. Occurrence 8_2:1613:10782: scene=8_2
#: 8_2:1613
msgctxt "text_id=10782 | speaker=unknown"
msgid "  And not a particularly large one at that. Whoever the architect was, he or she must not have thought a bath to be so important, or perhaps they were not the bath type."
msgstr "　その浴場もあまり広くないので、館の設計者は風呂を重要視しなかったのだろう。あるいは、湯浴みに馴染みがなかったのか。"

#. Occurrence 8_2:1645:10783: scene=8_2
#: 8_2:1645
msgctxt "text_id=10783 | speaker=unknown"
msgid "  Soujyuro descended to the foyer and made his way to the back of the stairs."
msgstr "　草十郎はロビーまで下り、階段の裏側に回りこむ。"

#. Occurrence 8_2:1651:10784: scene=8_2
#: 8_2:1651
msgctxt "text_id=10784 | speaker=unknown"
msgid "  He knocked on the door to the bath. As expected, there was no answer from the other side. The only other two occupants of the mansion were still talking in the drawing room."
msgstr "　浴場へ続く扉をノックする。当然ながら返事はない。二人はいまも居間で会議中である。"

#. Occurrence 8_2:1657:10785: scene=8_2
#: 8_2:1657
msgctxt "text_id=10785 | speaker=unknown"
msgid "  After confirming it was unoccupied, Soujyuro quietly entered the bathroom."
msgstr "　それを確認して、軽い足取りで草十郎は中へと入っていった。"

#. Occurrence 8_2:1703:10786: scene=8_2
#: 8_2:1703
msgctxt "text_id=10786 | speaker=unknown"
msgid "  Even though Soujyuro was not aware of it himself, as was common for him, "
msgstr "　彼らしい話ではあるが。"

#. Occurrence 8_2:1708:10787: scene=8_2
#: 8_2:1708
msgctxt "text_id=10787 | speaker=unknown"
msgid "  the only hobby he had acquired since coming down from the mountain was taking a nice, relaxing bath."
msgstr "　山から下りて出来た唯一の趣味が湯浴みであるという事を、草十郎本人はまだ自覚していなかった。"

#. Occurrence 8_2:1771:10788: scene=8_2
#: 8_2:1771
msgctxt "text_id=10788 | speaker=unknown"
msgid "  Soujyuro had left, but the two girls were still locked in their heated discussion."
msgstr "　草十郎が去った後も、少女たちの協議は続いていた。"

#. Occurrence 8_2:1777:10789: scene=8_2
#: 8_2:1777
msgctxt "text_id=10789 | speaker=unknown"
msgid "  Needless to say, the topic of their conversation was still that of the outsider mage who had appeared in Misaki City last month."
msgstr "　議題は言うまでもなく、先月から三咲市に現れた外部の魔術師について。"

#. Occurrence 8_2:1782:10790: scene=8_2
#: 8_2:1782
msgctxt "text_id=10790 | speaker=unknown"
msgid "  This was, after all, the problem that had occupied their time before this whole situation with Soujyuro arose―dealing with and eliminating the interloper who had set his or her sights on their territory."
msgstr "　<目撃者|そうじゅうろう>の一件で中断されていた、彼女たち本来の責務……管理地を奪いに来た略奪者への対応、その排除である。"

#. Occurrence 8_2:1814:10791: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0008; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:1814
msgctxt "text_id=10791 | speaker=aoko"
msgid "\"...All this time we'd been preoccupied by a decoy. No doubt also a part of their plan."
msgstr "「……今までは囮にばっかり食いついてたから甘く見てたけど……それも計算尽くだったのかしらね。"

#. Occurrence 8_2:1821:10792: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0009; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:1821
msgctxt "text_id=10792 | speaker=aoko"
msgid "Then, while we're distracted, they've crept in and stolen another one."
msgstr "こっちが油断してる隙に、本命を一つ奪われた。"

#. Occurrence 8_2:1833:10793: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0010; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:1833
msgctxt "text_id=10793 | speaker=aoko"
msgid "  The fight against this mage has only just begun.\""
msgstr "　この<魔|あ><術|い><師|て>との戦いは、これからが本番ってコトか」"

#. Occurrence 8_2:1865:10794: scene=8_2
#: 8_2:1865
msgctxt "text_id=10794 | speaker=unknown"
msgid "  The situation was growing more dire by the day."
msgstr "　事態は深刻化している。"

#. Occurrence 8_2:1870:10795: scene=8_2
#: 8_2:1870
msgctxt "text_id=10795 | speaker=unknown"
msgid "  Until only a couple of days ago, the enemy had limited themselves to small skirmishes. But now they had shifted to a full-on offensive."
msgstr "　敵魔術師は二日前までの散漫的な小競り合いから、巧みな攻勢に転じてきていた。"

#. Occurrence 8_2:1890:10796: scene=8_2
#: 8_2:1890
msgctxt "text_id=10796 | speaker=unknown"
msgid "  Aoko had two major Bounded Fields she used for defense."
msgstr "　青子たちには、大きく分けて二つの結界の守りがある。"

#. Occurrence 8_2:1906:10797: scene=8_2
#: 8_2:1906
msgctxt "text_id=10797 | speaker=unknown"
msgid "  One, the larger of the two, was placed around Misaki City to detect magical energy and magecraft."
msgstr "　一つは三咲市一帯に張られた、魔力・魔術の働きを測定する大結界。"

#. Occurrence 8_2:1911:10798: scene=8_2
#: 8_2:1911
msgctxt "text_id=10798 | speaker=unknown"
msgid "  This was used to observe and monitor visitors from outside the city, and was initially set up by Aozaki's ancestors, the administrators of this territory, and had no way to be removed."
msgstr "　これは外部からの来訪者を把握、監視する為のもので、管理地のオーナーである蒼崎の先祖が敷いた、消しようのない機能だ。"

#. Occurrence 8_2:1931:10799: scene=8_2
#: 8_2:1931
msgctxt "text_id=10799 | speaker=unknown"
msgid "  The other was set up to energize and manage leylines from within the territory."
msgstr "　もう一つは土地の霊脈を生かし、その力を管理するもの。"

#. Occurrence 8_2:1936:10800: scene=8_2
#: 8_2:1936
msgctxt "text_id=10800 | speaker=unknown"
msgid "  The five sigils carved into the earth made up a standard square-type array, protecting all that lay within its bounds."
msgstr "　大地に刻まれた五つの支点によって、そのサークルの内部を守る典型的な方陣である。"

#. Occurrence 8_2:1953:10801: scene=8_2
#: 8_2:1953
msgctxt "text_id=10801 | speaker=unknown"
msgid "  After some manipulation of the mana flow, the power within was directed to accumulate at the Kuonji Estate. That is to say, the Bounded Field existed to monopolize the magical energy within Misaki City."
msgstr "　人為的に<大|マ><源|ナ>の流れに手を加え、その力の終点が久遠寺邸に集まる―――ありていにいえば、三咲市における魔力を独占する為の結界だ。"

#. Occurrence 8_2:1973:10802: scene=8_2
#: 8_2:1973
msgctxt "text_id=10802 | speaker=unknown"
msgid "  There were five sigils in total, with the Kuonji Estate located in the center."
msgstr "　支点は久遠寺邸を中心にして、全部で五点。"

#. Occurrence 8_2:1978:10803: scene=8_2
#: 8_2:1978
msgctxt "text_id=10803 | speaker=unknown"
msgid "  If all five sigils were forcibly removed, Aoko's jurisdiction over this territory would be in title only."
msgstr "　これを全て退去させられた場合、青子たちの『管理地の持ち主』という事実は、文字通り、ただの肩書きになり下がる。"

#. Occurrence 8_2:1984:10804: scene=8_2
#: 8_2:1984
msgctxt "text_id=10804 | speaker=unknown"
msgid "  Without the power of the land to back them up, they would be forced to fight back against their invaders on equal ground, with only their own innate abilities to protect them."
msgstr "　土地のバックアップを失った管理人は、外部から現れた略奪者と同じ条件になり―――個人の力量だけで、敵を撃退しなければならなくなるのだ。"

#. Occurrence 8_2:2016:10805: scene=8_2
#: 8_2:2016
msgctxt "text_id=10805 | speaker=unknown"
msgid "  The only reason Alice and the inexperienced Aoko were able to defend this territory so far was because of these two fields."
msgstr "　有珠はともかく、まだ未熟な青子が管理地を死守できているのは、この二つに頼るところが大きい。"

#. Occurrence 8_2:2022:10806: scene=8_2
#: 8_2:2022
msgctxt "text_id=10806 | speaker=unknown"
msgid "  The dragnet that notified Aozaki of any threats was also her lifeline."
msgstr "　とくに蒼崎に伝わる<索敵網|だいけっかい>は彼女の生命線ですらある。"

#. Occurrence 8_2:2027:10807: scene=8_2
#: 8_2:2027
msgctxt "text_id=10807 | speaker=unknown"
msgid "  But this time, their enemy had somehow slipped through the cracks and was running rampant."
msgstr "　が、今回の敵はこの大結界の目をかいくぐり、好き勝手<町|まち>を<跋扈|ばっこ>していた。"

#. Occurrence 8_2:2032:10808: scene=8_2
#: 8_2:2032
msgctxt "text_id=10808 | speaker=unknown"
msgid "  This was what the girls had to face up to."
msgstr "　結果、彼女たちはこうして受けに回っている。"

#. Occurrence 8_2:2075:10809: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0007; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2075
msgctxt "text_id=10809 | speaker=alice"
msgid "\"Either way, it's just a matter of time at this point."
msgstr "「……どちらにせよ時間の問題ね。"

#. Occurrence 8_2:2082:10810: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0008_0; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2082
msgctxt "text_id=10810 | speaker=alice"
msgid "  Once all the sigils are destroyed, this mansion will be our last stronghold of defense."
msgstr "　支点がすべて潰されたら、いよいよ<洋|こ><館|こ>での籠城になるけど……"

#. Occurrence 8_2:2094:10811: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0008_1; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2094
msgctxt "text_id=10811 | speaker=alice"
msgid " Are you okay with that, Aoko?\""
msgstr "いいの、青子？」"

#. Occurrence 8_2:2135:10812: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0011; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2135
msgctxt "text_id=10812 | speaker=aoko"
msgid "\"I mean, what other choice do we have? Like you said, it's only a matter of time before the sigils are destroyed."
msgstr "「？　別にいいんじゃないの？　有珠の言う通り、残りの支点を消されるのは時間の問題なんだし。"

#. Occurrence 8_2:2147:10813: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0012; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2147
msgctxt "text_id=10813 | speaker=aoko"
msgid "  Our best chance would be to find their hideout, but it's not exactly a necessity. They can remove the sigils for all I care.\""
msgstr "　そりゃ<魔術師|てき>の<隠れ家|アジト>を発見できれば御の字だけど、それは絶対必要ってワケでもないでしょ。支点を消されても私にはあんまり関係ないし」"

#. Occurrence 8_2:2174:10814: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0013; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2174
msgctxt "text_id=10814 | speaker=aoko"
msgid "\"As long as you're here then the mansion itself shouldn't be a problem to defend."
msgstr "「なにより、館の守りはアンタがいるかぎり万全だしね。"

#. Occurrence 8_2:2180:10815: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0014; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2180
msgctxt "text_id=10815 | speaker=aoko"
msgid "  And if they do, then they're marching to their own demise."
msgstr "　あっちの方からやって来てくれるなら、それこそ飛んで火にいる、よ。"

#. Occurrence 8_2:2202:10816: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0015; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2202
msgctxt "text_id=10816 | speaker=aoko"
msgid "  What else is there to worry about?\""
msgstr "　他に心配事なんてないでしょ？」"

#. Occurrence 8_2:2263:10817: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0009; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2263
msgctxt "text_id=10817 | speaker=alice"
msgid "\"...Nothing, I suppose. With only a single opponent to deal with, we're better off focusing the field of the mirror on the estate, and making this mansion our last line of defense.\""
msgstr "「……そうね。敵が一人だけなら、その時は鏡の範囲を<洋館|ここ>に集中させて、戦場にすればいい。わたしたちにとって、その方が有利だったわ」"

#. Occurrence 8_2:2293:10818: scene=8_2
#: 8_2:2293
msgctxt "text_id=10818 | speaker=unknown"
msgid "  Alice touched the mirror on the table with her pale fingers."
msgstr "　有珠はその白い指で、テーブルに置かれた鏡に触れる。"

#. Occurrence 8_2:2298:10819: scene=8_2
#: 8_2:2298
msgctxt "text_id=10819 | speaker=unknown"
msgid "  The surface of the mirror rippled like water."
msgstr "　途端、水のように波立つ鏡面。"

#. Occurrence 8_2:2386:10820: scene=8_2
#: 8_2:2386
msgctxt "text_id=10820 | speaker=unknown"
msgid "  The mirror was another protector of Misaki City, separate from Aozaki's Bounded Fields."
msgstr "　蒼崎の結界とは別の、三咲市の守り神。"

#. Occurrence 8_2:2391:10821: scene=8_2
#: 8_2:2391
msgctxt "text_id=10821 | speaker=unknown"
msgid "  More accurately, it was a Ploy that existed only to protect Alice Kuonji rather than Misaki City itself. It generated a thick fog and acted as an invitation to any visitors, drawing them in to its board game-like world."
msgstr "　正しくは三咲市ではなく、久遠寺有珠だけを守る“童話の怪物”。濃霧を生み、訪れる者をゲーム盤の世界に<誘|いざな>う招待状。"

#. Occurrence 8_2:2396:10822: scene=8_2
#: 8_2:2396
msgctxt "text_id=10822 | speaker=unknown"
msgid "  Alice referred to it only as \"the mirror,\""
msgstr "　持ち主である少女は鏡とだけ呼び、"

#. Occurrence 8_2:2401:10823: scene=8_2
#: 8_2:2401
msgctxt "text_id=10823 | speaker=unknown"
msgid "  but it was known to her friends as the Mirror of Slumber."
msgstr "　少女の友人に<午睡|ごすい>の鏡と名付けられた、"

#. Occurrence 8_2:2406:10824: scene=8_2
#: 8_2:2406
msgctxt "text_id=10824 | speaker=unknown"
msgid "  This was a magecraft that Alice Kuonji wielded."
msgstr "　久遠寺有珠の扱う魔術である。"

#. Occurrence 8_2:2459:10825: scene=8_2
#: 8_2:2459
msgctxt "text_id=10825 | speaker=unknown"
msgid "  Within the rippling surface of the mirror, an image of a castle began to form and also a lush forest, a field, and a river."
msgstr "　波打つ鏡面には、一つの城と多くの森、平原と川が浮かび上がっている。"

#. Occurrence 8_2:2464:10826: scene=8_2
#: 8_2:2464
msgctxt "text_id=10826 | speaker=unknown"
msgid "  Aoko stared at the mirror in silence"
msgstr "　その様子を無言で眺めていた青子だったが、"

#. Occurrence 8_2:2491:10827: scene=8_2
#: 8_2:2491
msgctxt "text_id=10827 | speaker=unknown"
msgid "  before suddenly jumping to her feet off the sofa."
msgstr "　突然、よし、とばかりにソファーから立ち上がった。"

#. Occurrence 8_2:2526:10828: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0016; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2526
msgctxt "text_id=10828 | speaker=aoko"
msgid "\"Now that that's all decided, we can get back to actually doing stuff."
msgstr "「そうと決まれば、<後|あと>は行動あるのみね。"

#. Occurrence 8_2:2532:10829: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0017; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2532
msgctxt "text_id=10829 | speaker=aoko"
msgid "  I'm going out, Alice. We can't do anything until we have eyes on the ground.\""
msgstr "　出かけるわよ有珠。とにかく現場を見ない事には始まらない」"

#. Occurrence 8_2:2563:10830: scene=8_2
#: 8_2:2563
msgctxt "text_id=10830 | speaker=unknown"
msgid "  Alice let out a tired sigh in response to Aoko's determination, then gave the mirror a gentle caress."
msgstr "　決意に満ちた青子の声に、有珠は気だるげに吐息をもらして、鏡面をさらりと<撫|な>でる。"

#. Occurrence 8_2:2570:10831: scene=8_2
#: 8_2:2570
msgctxt "text_id=10831 | speaker=unknown"
msgid "  ...The sound of dripping water filled the room."
msgstr "　……とぷ、と水の騒ぐ音。"

#. Occurrence 8_2:2575:10832: scene=8_2
#: 8_2:2575
msgctxt "text_id=10832 | speaker=unknown"
msgid "  The mirror began to consume the table in a thick fog with a single caress from Alice."
msgstr "　鏡は有珠の<一|ひと><撫|な>でで濃霧に包まれ、テーブルに沈み消えた。"

#. Occurrence 8_2:2609:10833: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0010; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2609
msgctxt "text_id=10833 | speaker=alice"
msgid "\"If we're visiting each sigil, we definitely won't be back until morning.\""
msgstr "「順番に回るのなら、帰るのは朝になるわね」"

#. Occurrence 8_2:2634:10834: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0018; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2634
msgctxt "text_id=10834 | speaker=aoko"
msgid "\"Nah. We'll be home in no time!"
msgstr "「まあまあ、そう億劫がらないで。"

#. Occurrence 8_2:2646:10835: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0019; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2646
msgctxt "text_id=10835 | speaker=aoko"
msgid "  Oh right, I meant to ask you. Is this the proper way to do a fire pentagram banishment?\""
msgstr "　ところで有珠、火の五芒星の退去ってこうだっけ」"

#. Occurrence 8_2:2665:10836: scene=8_2
#: 8_2:2665
msgctxt "text_id=10836 | speaker=unknown"
msgid "  Aoko traced a shape in the air with her fingers."
msgstr "　青子は中空に指を滑らせる。"

#. Occurrence 8_2:2670:10837: scene=8_2
#: 8_2:2670
msgctxt "text_id=10837 | speaker=unknown"
msgid "  She mimed a star shape starting from the top, moving down and to the right, from there to the upper left, and so on."
msgstr "　上から始まって右下へ、右下から左上、左上から……と星型の軌跡が描かれる。"

#. Occurrence 8_2:2696:10838: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0011; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2696
msgctxt "text_id=10838 | speaker=alice"
msgid "\"It's about time you learned something other than how to break things, Aoko.\""
msgstr "「……そろそろ壊すこと以外も覚えないと駄目よ、青子」"

#. Occurrence 8_2:2717:10839: scene=8_2
#: 8_2:2717
msgctxt "text_id=10839 | speaker=unknown"
msgid "  Alice sat up from the sofa, letting out a heavy sigh."
msgstr "　ため息をつきながら、有珠もソファーから腰をあげる。"

#. Occurrence 8_2:2743:10840: scene=8_2
#: 8_2:2743
msgctxt "text_id=10840 | speaker=unknown"
msgid "  They both took their coats from their hangers and left the drawing room."
msgstr "　ふたりは<上着掛け|コートハンガー>からそれぞれのコートを手に取り、居間を後にする。"

#. Occurrence 8_2:2787:10841: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0020; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2787
msgctxt "text_id=10841 | speaker=aoko"
msgid "\"Well, excuse me. I guess I need to study some more on top of all the studying I already do."
msgstr "「失礼ね、私だって日々成長してるわよ。"

#. Occurrence 8_2:2794:10842: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0021; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2794
msgctxt "text_id=10842 | speaker=aoko"
msgid "Remember that charm I pulled off just the other day?\""
msgstr "この<間|あいだ>のお<呪|まじな>いだってちゃんと成功したんだから」"

#. Occurrence 8_2:2812:10843: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0012; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2812
msgctxt "text_id=10843 | speaker=alice"
msgid "\"...What charm?\""
msgstr "「……お呪い？」"

#. Occurrence 8_2:2829:10844: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0022; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2829
msgctxt "text_id=10844 | speaker=aoko"
msgid "\"That simple Mesmerize."
msgstr "「簡単な暗示の呪文。"

#. Occurrence 8_2:2835:10845: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0023; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2835
msgctxt "text_id=10845 | speaker=aoko"
msgid "  You know, the one you taught me. 'Light and frail, nimble and quick. Tick-tock, tick-tock, there's no time to waste.' That one!\""
msgstr "　ほら、有珠が教えてくれた、空<気のおも|かるく、よわく>り、胸<のふる|うまく、はやく>え。ひ<かりは先|チクタクチクタク>立つ、か<げは遅れ|いそげやいそげ>る。ってヤツ」"

#. Occurrence 8_2:2867:10846: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0013; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2867
msgctxt "text_id=10846 | speaker=alice"
msgid "\"...Are you being serious right now?\""
msgstr "「………………それ、本当？」"

#. Occurrence 8_2:2873:10847: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0024; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2873
msgctxt "text_id=10847 | speaker=aoko"
msgid "\"Yes, I'm serious! You can ask Soujyuro later if you don't believe me.\""
msgstr "「ホントもホント。後で草十郎に聞いてみなさい」"

#. Occurrence 8_2:2884:10848: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0014; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2884
msgctxt "text_id=10848 | speaker=alice"
msgid "\"...\""
msgstr "「…………………………」"

#. Occurrence 8_2:2889:10849: scene=8_2
#: 8_2:2889
msgctxt "text_id=10849 | speaker=unknown"
msgid "  Alice swallowed her words, clearly displeased."
msgstr "　有珠は納得のいかない面持ちで、喉まで出かけた言葉を飲みこんだ。"

#. Occurrence 8_2:2894:10850: scene=8_2
#: 8_2:2894
msgctxt "text_id=10850 | speaker=unknown"
msgid "  She likely stopped herself in time to realize it was not worth the effort to take issue with it."
msgstr "　特に話題にする事でもない、とギリギリで疑問を止められたのだろう。"

#. Occurrence 8_2:2920:10851: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0015; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2920
msgctxt "text_id=10851 | speaker=alice"
msgid "\"On the topic, what will he do while we're away?\""
msgstr "「……けど。留守中、その彼はどうするの？」"

#. Occurrence 8_2:2939:10852: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0025; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2939
msgctxt "text_id=10852 | speaker=aoko"
msgid "\"He'll be fine. As long as he doesn't try to go into the west wing or anything like that, there shouldn't be any immediate threat to his...\""
msgstr "「大丈夫でしょ。有珠の西館と開かずの間に入らなきゃ即死するような事は……」"

#. Occurrence 8_2:2946:10853: scene=8_2
#: 8_2:2946
msgctxt "text_id=10853 | speaker=unknown"
msgid "  Aoko responded hastily as she opened the door to the foyer."
msgstr "　青子は答えながらロビーに通じる扉を開ける。"

#. Occurrence 8_2:2977:10854: scene=8_2
#: 8_2:2977
msgctxt "text_id=10854 | speaker=unknown"
msgid "  As soon as she did..."
msgstr "　直後。"

#. Occurrence 8_2:2982:10855: scene=8_2
#: 8_2:2982
msgctxt "text_id=10855 | speaker=unknown"
msgid "  Just as quickly as Alice's doubts had gotten stuck in her throat, Aoko suddenly froze, unable to speak."
msgstr "　突然の疑問に声をあげる有珠のように、青子の喉は凍りついた。"

#. Occurrence 8_3:130:10856: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0000; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:130
msgctxt "text_id=10856 | speaker=aoko"
msgid "\"...What?\""
msgstr "「……………、ですって？」"

#. Occurrence 8_3:136:10857: scene=8_3
#: 8_3:136
msgctxt "text_id=10857 | speaker=unknown"
msgid "  For a moment, Aoko wasn't sure who was standing before her."
msgstr "　それが誰なのか、青子は咄嗟に思いつけなかった。"

#. Occurrence 8_3:171:10858: scene=8_3
#: 8_3:171
msgctxt "text_id=10858 | speaker=unknown"
msgid "  She could only stare at the glinting rays of sunlight creeping into the room as she reeled from the shock."
msgstr "　不意打ち気味の<当惑|とうわく>に<眩|くら>みながら、午後の<斜光|さしび>を眺めている事しかできない。"

#. Occurrence 8_3:178:10859: scene=8_3
#: 8_3:178
msgctxt "text_id=10859 | speaker=unknown"
msgid "  Her mind was completely blank."
msgstr "　びっくり箱に驚いた時のような、"

#. Occurrence 8_3:200:10860: scene=8_3
#: 8_3:200
msgctxt "text_id=10860 | speaker=unknown"
msgid "  It was as if she had just woken up from a nap, or a jack-in-the-box had just opened in her face."
msgstr "　寝起きの時のような空白。"

#. Occurrence 8_3:205:10861: scene=8_3
#: 8_3:205
msgctxt "text_id=10861 | speaker=unknown"
msgid "  Soujyuro was probably the only person who truly knew how long that dumbfounded silence went on."
msgstr "　そんな沈黙がどれだけ続いたのか、正確に知り得たのは、当の人影だけだろう。"

#. Occurrence 8_3:251:10862: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0001; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:251
msgctxt "text_id=10862 | speaker=aoko"
msgid "\"...What the hell are you doing standing there like that?\""
msgstr "「……アンタ、こんなところで何してるのよ、いったい」"

#. Occurrence 8_3:257:10863: scene=8_3
#: 8_3:257
msgctxt "text_id=10863 | speaker=unknown"
msgid "  Aoko had finally found her voice."
msgstr "　どれほどか経って、ようやく青子は口を開いた。"

#. Occurrence 8_3:297:10864: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0000; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:297
msgctxt "text_id=10864 | speaker=soujuurou"
msgid "\"What? I'm changing clothes.\""
msgstr "「何って、着替えてるんだけど」"

#. Occurrence 8_3:303:10865: scene=8_3
#: 8_3:303
msgctxt "text_id=10865 | speaker=unknown"
msgid "  Soujyuro's response was matter-of-fact."
msgstr "　青子の質問に、その人影は平然と答えた。"

#. Occurrence 8_3:308:10866: scene=8_3
#: 8_3:308
msgctxt "text_id=10866 | speaker=unknown"
msgid "  He offered no explanation as to why he was changing in the foyer and not the bathroom."
msgstr "　なぜ脱衣場ではなくロビーで着替えているのか、その経緯を説明しないまま。"

#. Occurrence 8_3:348:10867: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0002; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:348
msgctxt "text_id=10867 | speaker=aoko"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 8_3:353:10868: scene=8_3
#: 8_3:353
msgctxt "text_id=10868 | speaker=unknown"
msgid "  Aoko was too shocked to read him the riot act."
msgstr "　そんな草十郎に一声……率直に言うと怒鳴り……あげなくてはいけないのに、青子は言葉を止めてしまう。"

#. Occurrence 8_3:389:10869: scene=8_3
#: 8_3:389
msgctxt "text_id=10869 | speaker=unknown"
msgid "  Soujyuro was putting a shirt on after presumably just getting out from the bath."
msgstr "　今まで浴場にいたであろう彼は、ちょうどシャツを着ようとしているところだった。"

#. Occurrence 8_3:394:10870: scene=8_3
#: 8_3:394
msgctxt "text_id=10870 | speaker=unknown"
msgid "  His neck was wrapped in bandages, and he was completely shirtless."
msgstr "　上半身<裸|はだか>で、首には布が巻かれている。"

#. Occurrence 8_3:399:10871: scene=8_3
#: 8_3:399
msgctxt "text_id=10871 | speaker=unknown"
msgid "  His hair was wet, but his skin wasn't glistening from the steam of hot water. He must have washed himself with nothing more than cold water."
msgstr "　髪は濡れているものの、肌に上気したところは見られない。おそらく水で体を洗ったのだろう。"

#. Occurrence 8_3:426:10872: scene=8_3
#: 8_3:426
msgctxt "text_id=10872 | speaker=unknown"
msgid "  Though shocked as to why anyone would do such a thing in this cold weather, she let it slide."
msgstr "　この寒空によく、と呆れるところだが、そんな<所感|しょかん>は些細な事だ。"

#. Occurrence 8_3:431:10873: scene=8_3
#: 8_3:431
msgctxt "text_id=10873 | speaker=unknown"
msgid "  The source of her silent stupor was simply his body."
msgstr "　<沈黙|おどろき>は、純粋に彼の体に起因する。"

#. Occurrence 8_3:458:10874: scene=8_3
#: 8_3:458
msgctxt "text_id=10874 | speaker=unknown"
msgid "  Until now, she'd only seen him as harmless. Without his clothing to hide him, however, he was more fit than she'd ever imagined."
msgstr "　今まで線の細い人畜無害っぷりだったのに、<装飾|ようふく>を取ればこの通り、弱々しいイメージなど見られない。"

#. Occurrence 8_3:463:10875: scene=8_3
#: 8_3:463
msgctxt "text_id=10875 | speaker=unknown"
msgid "  For a rough mountain upbringing where one's body and strength meant survival, perhaps he was even a bit underdeveloped."
msgstr "　何事も体が資本な山育ちなら、むしろ鍛え方が足りないのかもしれないが、青子にとっては予想外の体つきだった。"

#. Occurrence 8_3:468:10876: scene=8_3
#: 8_3:468
msgctxt "text_id=10876 | speaker=unknown"
msgid "  And on top of that..."
msgstr "　それと、おまけに、"

#. Occurrence 8_3:515:10877: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0003; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:515
msgctxt "text_id=10877 | speaker=aoko"
msgid "\"...Are those scars?\""
msgstr "「……それ、傷跡なの？」"

#. Occurrence 8_3:521:10878: scene=8_3
#: 8_3:521
msgctxt "text_id=10878 | speaker=unknown"
msgid "  Aoko asked cautiously."
msgstr "　青子は恐る恐る口にする。"

#. Occurrence 8_3:537:10879: scene=8_3
#: 8_3:537
msgctxt "text_id=10879 | speaker=unknown"
msgid "  Soujyuro followed her gaze."
msgstr "　草十郎はうん？　と視線を落とした。"

#. Occurrence 8_3:542:10880: scene=8_3
#: 8_3:542
msgctxt "text_id=10880 | speaker=unknown"
msgid "  He had something that looked like a burn scar on his arm."
msgstr "　彼の腕にはうっすらと火傷の跡らしきものがある。"

#. Occurrence 8_3:547:10881: scene=8_3
#: 8_3:547
msgctxt "text_id=10881 | speaker=unknown"
msgid "  It was random in appearance, nothing like Aoko's Magic Crest with its ordered patterns."
msgstr "　青子の魔術刻印のような秩序のある紋様ではなく、不幸な事故を思わせる<斑|まだら>模様。"

#. Occurrence 8_3:582:10882: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0001; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:582
msgctxt "text_id=10882 | speaker=soujuurou"
msgid "\"Oh, this? A long time ago I was attacked by a pack of wild dogs and they bit me. It's a miracle I'm even still alive, so if anything I'm fond of the scar.\""
msgstr "「ああ、これか。ずいぶん前に野犬の群れに襲われて、噛みつかれたんだ。命があっただけでも幸運だから、傷跡ぐらいはご愛敬だ」"

#. Occurrence 8_3:602:10883: scene=8_3
#: 8_3:602
msgctxt "text_id=10883 | speaker=unknown"
msgid "  A long time ago... He must be talking about when he was a child."
msgstr "　……ずいぶん前、とは子供の頃の出来事らしい。"

#. Occurrence 8_3:607:10884: scene=8_3
#: 8_3:607
msgctxt "text_id=10884 | speaker=unknown"
msgid "  Though his life was saved, it was apparent that he hadn't been able to receive proper treatment deep in the mountains where he lived."
msgstr "　<一命|いちめい>は取り留めたものの、彼の住んでいた山奥では満足な治療もできなかったのだろう。"

#. Occurrence 8_3:640:10885: scene=8_3
#: 8_3:640
msgctxt "text_id=10885 | speaker=unknown"
msgid "  Those scars were proof of that."
msgstr "　その傷跡は消えていない。"

#. Occurrence 8_3:645:10886: scene=8_3
#: 8_3:645
msgctxt "text_id=10886 | speaker=unknown"
msgid "  Considering it had happened so many years ago, it was likely they would never fade."
msgstr "　何年も前に受けてあの状態なら、もう一<生涯|しょうがい>変わらないだろう。"

#. Occurrence 8_3:650:10887: scene=8_3
#: 8_3:650
msgctxt "text_id=10887 | speaker=unknown"
msgid "  If only for an instant, Aoko thought the wild scars left on his skin suited his lean body perfectly."
msgstr "　……半面、肌に残る野性の<傷|あ><痕|と>は、無駄のない体に相応しかった。直視した彼女が、たとえ一瞬だけだろうと、感じ入った程度には。"

#. Occurrence 8_3:683:10888: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0002; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:683
msgctxt "text_id=10888 | speaker=soujuurou"
msgid "\"...I know it's not pleasant to look at."
msgstr "「……たしかにあまり気持ちのいいものじゃないな。"

#. Occurrence 8_3:683:10889: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0002; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:683
msgctxt "text_id=10889 | speaker=soujuurou"
msgid "  I should have just changed in my own room.\""
msgstr "　自分の部屋で着替えるべきだった」"

#. Occurrence 8_3:689:10890: scene=8_3
#: 8_3:689
msgctxt "text_id=10890 | speaker=unknown"
msgid "  Soujyuro sounded slightly ashamed as he put on his shirt, looking at Aoko standing there in cold silence."
msgstr "　無言で固まった青子を見て、草十郎はシャツを着ながら、少しだけ恥じ入るように弁明した。"

#. Occurrence 8_3:694:10891: scene=8_3
#: 8_3:694
msgctxt "text_id=10891 | speaker=unknown"
msgid "  The two girls had no response."
msgstr "　ふたりからは何の返答もない。"

#. Occurrence 8_3:704:10892: scene=8_3
#: 8_3:704
msgctxt "text_id=10892 | speaker=unknown"
msgid "  Soujyuro headed for the stairs to go back to his room."
msgstr "　草十郎は自分の部屋に戻ろうと階段に向かう。"

#. Occurrence 8_3:749:10893: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0004; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:749
msgctxt "text_id=10893 | speaker=aoko"
msgid "\"W-Wait a second, Soujyuro.\""
msgstr "「ちょ、ちょっと待って、草十郎」"

#. Occurrence 8_3:762:10894: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0003; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:762
msgctxt "text_id=10894 | speaker=soujuurou"
msgid "\"Hm?\""
msgstr "「？」"

#. Occurrence 8_3:767:10895: scene=8_3
#: 8_3:767
msgctxt "text_id=10895 | speaker=unknown"
msgid "  Soujyuro stopped and turned around."
msgstr "　足を止めて振り返る草十郎。"

#. Occurrence 8_3:779:10896: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0005; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:779
msgctxt "text_id=10896 | speaker=aoko"
msgid "\"Ummm, so, how do I say this...\""
msgstr "「え―――あ、うん、なんていうか―――」"

#. Occurrence 8_3:790:10897: scene=8_3
#: 8_3:790
msgctxt "text_id=10897 | speaker=unknown"
msgid "  Aoko looked away awkwardly, apparently not knowing why she had stopped him herself."
msgstr "　自分でも呼び止めた意図が分からず、青子は気まずそうに視線を逸らす。"

#. Occurrence 8_3:827:10898: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0004; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:827
msgctxt "text_id=10898 | speaker=soujuurou"
msgid "\"Huh? This isn't like you, Aozaki."
msgstr "「？？　……なんか蒼崎らしくない。"

#. Occurrence 8_3:833:10899: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0005; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:833
msgctxt "text_id=10899 | speaker=soujuurou"
msgid "  You're acting strange. Did you get a fever or something?"
msgstr "　さっきからヘンだけど、熱でもあるんじゃないのか？"

#. Occurrence 8_3:833:10900: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0005; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:833
msgctxt "text_id=10900 | speaker=soujuurou"
msgid "  I bet neither of you have gotten enough sleep since all that, have you?\""
msgstr "　あれから満足に寝てないだろ、ふたりとも」"

#. Occurrence 8_3:839:10901: scene=8_3
#: 8_3:839
msgctxt "text_id=10901 | speaker=unknown"
msgid "  He was of course referring to the final exams."
msgstr "　あれから、とは期末試験からの話である。"

#. Occurrence 8_3:844:10902: scene=8_3
#: 8_3:844
msgctxt "text_id=10902 | speaker=unknown"
msgid "  From Soujyuro's perspective, the amount of work Aoko put in seemed strange."
msgstr "　草十郎から見ると、青子の働きぶりは“おかしい”“ヘンな人”レベルの扱いになっているらしい。"

#. Occurrence 8_3:880:10903: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0006; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:880
msgctxt "text_id=10903 | speaker=aoko"
msgid "\"I-I don't have a fever!"
msgstr "「ね、熱なんてないったらっ！"

#. Occurrence 8_3:886:10904: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0007; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:886
msgctxt "text_id=10904 | speaker=aoko"
msgid "  That's not what this is about... I just want to know why the hell you're changing clothes here!\""
msgstr "　そうじゃなくて―――ど、どうしてこんなところで着替えてたのよ、アンタはっ！」"

#. Occurrence 8_3:912:10905: scene=8_3
#: 8_3:912
msgctxt "text_id=10905 | speaker=unknown"
msgid "  Aoko was doing her best to keep up appearances."
msgstr "　目に見えてとりつくろう青子。"

#. Occurrence 8_3:917:10906: scene=8_3
#: 8_3:917
msgctxt "text_id=10906 | speaker=unknown"
msgid "  But..."
msgstr "　一方―――"

#. Occurrence 8_3:941:10907: scene=8_3
#: 8_3:941
msgctxt "text_id=10907 | speaker=unknown"
msgid "  For some reason, Soujyuro was hesitant to say too much more."
msgstr "　なぜか、そんな青子以上に言いよどむ草十郎。"

#. Occurrence 8_3:962:10908: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0006; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:962
msgctxt "text_id=10908 | speaker=soujuurou"
msgid "\"So, well, this isn't easy to say..."
msgstr "「それは、その。"

#. Occurrence 8_3:968:10909: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0007; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:968
msgctxt "text_id=10909 | speaker=soujuurou"
msgid "  But you need to take care of your underwear better. I don't know whose it is, though.\""
msgstr "　……言いづらいんだが、下着の管理は、きちんとした方がいいと思う。どっちだかは知らないけど」"

#. Occurrence 8_3:996:10910: scene=8_3
#: 8_3:996
msgctxt "text_id=10910 | speaker=unknown"
msgid "  Alice, who had been completely silent behind Aoko, couldn't resist responding to that statement."
msgstr "　草十郎の台詞に、今まで青子の後ろで黙っていた有珠がぴくりと反応した。"

#. Occurrence 8_3:1001:10911: scene=8_3
#: 8_3:1001
msgctxt "text_id=10911 | speaker=unknown"
msgid "  Although she hadn't wanted to get involved, this was something she couldn't ignore."
msgstr "　我関せずを貫くつもりだった彼女も、今の台詞は無視できなかったらしい。"

#. Occurrence 8_3:1042:10912: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_3_0000; voice_prefix=A40; voice_category=2; scene=8_3
#: 8_3:1042
msgctxt "text_id=10912 | speaker=alice"
msgid "\"I must point out, it was most definitely Aoko.\""
msgstr "「言っておくけど、それは青子だから」"

#. Occurrence 8_3:1048:10913: scene=8_3
#: 8_3:1048
msgctxt "text_id=10913 | speaker=unknown"
msgid "  Alice's response was quick and to the point."
msgstr "　あまりにも素早い正当性の主張だった。"

#. Occurrence 8_3:1090:10914: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0008; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:1090
msgctxt "text_id=10914 | speaker=aoko"
msgid "\"...I may have been in charge of laundry, but...\""
msgstr "「……洗濯の当番は、たしかに私だったけど」"

#. Occurrence 8_3:1096:10915: scene=8_3
#: 8_3:1096
msgctxt "text_id=10915 | speaker=unknown"
msgid "  Aoko seemed like she was just holding back on going critical."
msgstr "　その後に何か続きそうな、険悪極まりない青子の切り返しである。"

#. Occurrence 8_3:1117:10916: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0008; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:1117
msgctxt "text_id=10916 | speaker=soujuurou"
msgid "\"Anyway, I really have to get dressed, or I'm going to be late for work.\""
msgstr "「とにかく、もうすぐアルバイトだから着替えてくる」"

#. Occurrence 8_3:1123:10917: scene=8_3
#: 8_3:1123
msgctxt "text_id=10917 | speaker=unknown"
msgid "  Sensing that those two were probably about to get into an argument, Soujyuro took his chance to leave."
msgstr "　そんなふたりの言い合いに破滅の前兆を感じ取り、素早く戦場から離脱する草十郎。"

#. Occurrence 8_3:1159:10918: scene=8_3
#: 8_3:1159
msgctxt "text_id=10918 | speaker=unknown"
msgid "  And with that, Soujyuro briskly left the scene."
msgstr "　かくて、人騒がせな人影は早足で去っていった。"

#. Occurrence 8_3:1233:10919: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0009; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:1233
msgctxt "text_id=10919 | speaker=aoko"
msgid "\"...Alice.\""
msgstr "「……………有珠」"

#. Occurrence 8_3:1244:10920: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_3_0001; voice_prefix=A40; voice_category=2; scene=8_3
#: 8_3:1244
msgctxt "text_id=10920 | speaker=alice"
msgid "\"...I'll go clean up.\""
msgstr "「……………とりあえず、片づけてくるわ」"

#. Occurrence 8_3:1255:10921: scene=8_3
#: 8_3:1255
msgctxt "text_id=10921 | speaker=unknown"
msgid "  Alice calmly walked into the bathroom."
msgstr "　一見して冷静なまま、有珠は脱衣場に消えていった。"

#. Occurrence 8_3:1292:10922: scene=8_3
#: 8_3:1292
msgctxt "text_id=10922 | speaker=unknown"
msgid "  A few minutes later..."
msgstr "　数分後。"

#. Occurrence 8_3:1308:10923: scene=8_3
#: 8_3:1308
msgctxt "text_id=10923 | speaker=unknown"
msgid "  Just as the two were about to head out and fulfill their duties as mages, Aoko remembered something she wanted to ask."
msgstr "　気を取り直し、魔術師として外出しようとする直前、思いだしたように青子は相方の少女に訊ねた。"

#. Occurrence 8_3:1329:10924: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0010; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:1329
msgctxt "text_id=10924 | speaker=aoko"
msgid "\"Alice, do you think those scars were...?\""
msgstr "「そうだ有珠。傷ってアレの事？」"

#. Occurrence 8_3:1344:10925: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_3_0002; voice_prefix=A40; voice_category=2; scene=8_3
#: 8_3:1344
msgctxt "text_id=10925 | speaker=alice"
msgid "\"...I don't think so."
msgstr "「……アレは傷跡じゃないわ。"

#. Occurrence 8_3:1350:10926: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_3_0003; voice_prefix=A40; voice_category=2; scene=8_3
#: 8_3:1350
msgctxt "text_id=10926 | speaker=alice"
msgid "  He seemed so proud, after all.\""
msgstr "　だって、あんなにも誇らしいもの」"

#. Occurrence 8_3:1370:10927: scene=8_3
#: 8_3:1370
msgctxt "text_id=10927 | speaker=unknown"
msgid "  Aoko agreed."
msgstr "　たしかに、と青子は思う。"

#. Occurrence 8_3:1375:10928: scene=8_3
#: 8_3:1375
msgctxt "text_id=10928 | speaker=unknown"
msgid "  What had impressed her the most about those scars was how he treated them simply as a part of his past, absent of any regret."
msgstr "　あの傷跡に感じ入ったのは、彼本人が過去の出来事として受け入れ、何の後悔も持っていなかったからだ。"

#. Occurrence 8_3:1391:10929: scene=8_3
#: 8_3:1391
msgctxt "text_id=10929 | speaker=unknown"
msgid "  Aoko wouldn't have gone so far as to say he was proud, but it seemed her instincts had been correct."
msgstr "　それを有珠のように誇らしい、とは思えなかった青子だが、一瞬だけよぎった印象に間違いはなかったらしい。"

#. Occurrence 8_3:1396:10930: scene=8_3
#: 8_3:1396
msgctxt "text_id=10930 | speaker=unknown"
msgid "  That, and one more thing."
msgstr "　それと、もう一つ。"

#. Occurrence 8_3:1422:10931: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0011; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:1422
msgctxt "text_id=10931 | speaker=aoko"
msgid "\"One thing is clear, though."
msgstr "「でも一つだけはっきりしたわ。"

#. Occurrence 8_3:1428:10932: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0012; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:1428
msgctxt "text_id=10932 | speaker=aoko"
msgid "  I wasn't the only one who was pleasantly surprised at what I saw. Was I, Alice?\""
msgstr "　それじゃあ、不覚にも見惚れてたのは私ひとりじゃなかったってコトよね、有珠？」"

#. Occurrence 8_3:1464:10933: scene=8_3
#: 8_3:1464
msgctxt "text_id=10933 | speaker=unknown"
msgid "  Aoko smiled wryly at Alice, like a child who knew they were doing something they shouldn't with their friend."
msgstr "　<悪戯|いたずら>の共犯の事実を求めるように、青子は楽しげに問いかける。"

#. Occurrence 8_3:1469:10934: scene=8_3
#: 8_3:1469
msgctxt "text_id=10934 | speaker=unknown"
msgid "  Alice was trying to ignore her as best she could."
msgstr "　一部始終、我関せずと無視していた少女に向かって。"

#. Occurrence 8_3:1474:10935: scene=8_3
#: 8_3:1474
msgctxt "text_id=10935 | speaker=unknown"
msgid "  She looked away without saying a word."
msgstr "　有珠は答えず、ただ視線を逸らしただけだった。"

#. Occurrence 8_3:1479:10936: scene=8_3
#: 8_3:1479
msgctxt "text_id=10936 | speaker=unknown"
msgid "  Aoko let out a satisfied snicker and began walking towards the front door."
msgstr "　それで満足いったのか、青子はくすりと<微笑|わら>って玄関へ歩きだす。"

#. Occurrence 8_3:1524:10937: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0013; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:1524
msgctxt "text_id=10937 | speaker=aoko"
msgid "\"Let's get going. We should probably start at that park, right?"
msgstr "「じゃ、行こうか。まずはあの公園からでいいでしょ？"

#. Occurrence 8_3:1524:10938: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0013; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:1524
msgctxt "text_id=10938 | speaker=aoko"
msgid "  Since that's where this all started.\""
msgstr "　今回の件は、あそこから全てが始まったわけだし」"

#. Occurrence 8_3:1530:10939: scene=8_3
#: 8_3:1530
msgctxt "text_id=10939 | speaker=unknown"
msgid "  She was talking about the local park in Misaki."
msgstr "　三咲町の公園。"

#. Occurrence 8_3:1550:10940: scene=8_3
#: 8_3:1550
msgctxt "text_id=10940 | speaker=unknown"
msgid "  The place where they had run into the enemy puppets and, of course, where their involvement with Soujyuro had all begun."
msgstr "　奇しくもそこは、敵の人形とも、草十郎とも関わりが始まった因縁の土地である。"

#. Occurrence 8_4:64:10941: scene=8_4
#: 8_4:64
msgctxt "text_id=10941 | speaker=unknown"
msgid "  Early the next morning..."
msgstr "　翌日、早朝。"

#. Occurrence 8_4:69:10942: scene=8_4
#: 8_4:69
msgctxt "text_id=10942 | speaker=unknown"
msgid "  It was five o'clock in the morning. Most people were still in their beds sleeping."
msgstr "　まだ多くの人々が眠りについている午前五時。"

#. Occurrence 8_4:74:10943: scene=8_4
#: 8_4:74
msgctxt "text_id=10943 | speaker=unknown"
msgid "  Although some twenty-four hour convenience stores had opened last year, Misaki Town was still very much living in the good old days of the early eighties."
msgstr "　去年あたりから二十四時間営業のコンビニエンスストアがぽつぽつと現れてはいるが、三咲町は古き良き八十年代前期の色が濃い。"

#. Occurrence 8_4:79:10944: scene=8_4
#: 8_4:79
msgctxt "text_id=10944 | speaker=unknown"
msgid "  Even the tofu shop in the shopping district, known for opening earlier than anywhere else, didn't open until six."
msgstr "　商店街で一番の早起きと言われる豆腐屋ですら、店開きは六時からだ。"

#. Occurrence 8_4:99:10945: scene=8_4
#: 8_4:99
msgctxt "text_id=10945 | speaker=unknown"
msgid "  But this was the late eighties, during the latter half of Japan's bubble economy."
msgstr "　八十年代後半。"

#. Occurrence 8_4:104:10946: scene=8_4
#: 8_4:104
msgctxt "text_id=10946 | speaker=unknown"
msgid "  It was a time when metropolitan areas never slept. Those in the countryside, however, remained in the past."
msgstr "　バブル末期と言えど、地方都市の人々の生活はいまだ不夜城にはほど遠い。"

#. Occurrence 8_4:109:10947: scene=8_4
#: 8_4:109
msgctxt "text_id=10947 | speaker=unknown"
msgid "  The homes were blanketed in silence, the streets were empty of commuters, and not a single automobile could be heard."
msgstr "　住宅地は静まりかえり、道を行く会社員の姿もなく、自動車の音すらしない。"

#. Occurrence 8_4:114:10948: scene=8_4
#: 8_4:114
msgctxt "text_id=10948 | speaker=unknown"
msgid "  The sun was just barely peeking over the horizon."
msgstr "　太陽は地平線に半身を残している。"

#. Occurrence 8_4:119:10949: scene=8_4
#: 8_4:119
msgctxt "text_id=10949 | speaker=unknown"
msgid "  The town would still be asleep for at least an hour longer before it began waking up."
msgstr "　町が目覚めるには、あと半刻ばかりの眠りが必要だった。"

#. Occurrence 8_4:153:10950: scene=8_4
#: 8_4:153
msgctxt "text_id=10950 | speaker=unknown"
msgid "  It was during this time that someone stepped onto the Kuonji Estate."
msgstr "　そんな中、久遠寺邸に足を踏み入れる影がひとつ。"

#. Occurrence 8_4:158:10951: scene=8_4
#: 8_4:158
msgctxt "text_id=10951 | speaker=unknown"
msgid "  Soujyuro was working the late shift during winter vacation and had just come home."
msgstr "　冬休みという事で深夜割り当てのアルバイトに精を出し、たったいま帰ってきた草十郎である。"

#. Occurrence 8_4:172:10952: scene=8_4
#: 8_4:172
msgctxt "text_id=10952 | speaker=unknown"
msgid "  He moved quietly through the drawing room so he wouldn't wake up Aoko and Alice, who were presumably still asleep."
msgstr "　それぞれ自室で眠っているであろう青子と有珠を起こさないように、草十郎は静かに居間へ移動する。"

#. Occurrence 8_4:218:10953: scene=8_4
#: 8_4:218
msgctxt "text_id=10953 | speaker=unknown"
msgid "  The Kuonji Estate had a few established rules."
msgstr "　話は変わるが、久遠寺邸には幾つかのルールがある。"

#. Occurrence 8_4:223:10954: scene=8_4
#: 8_4:223
msgctxt "text_id=10954 | speaker=unknown"
msgid "  One of those rules forbade more Japanese tea."
msgstr "　その一つがノーモア日本茶。"

#. Occurrence 8_4:228:10955: scene=8_4
#: 8_4:228
msgctxt "text_id=10955 | speaker=unknown"
msgid "  This new rule had only came into effect three days prior."
msgstr "　この、まったく新しい法案が可決されたのは三日前。"

#. Occurrence 8_4:233:10956: scene=8_4
#: 8_4:233
msgctxt "text_id=10956 | speaker=unknown"
msgid "  It was proposed after Alice saw Soujyuro drinking green tea in the kitchen after dinner one night."
msgstr "　ある夕食後、台所でのほほんとほうじ茶を飲んでいた草十郎を見て、久遠寺有珠が「あ」と発音した事に由来する。"

#. Occurrence 8_4:268:10957: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0000; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:268
msgctxt "text_id=10957 | speaker=alice"
msgid "\"Ah.\""
msgstr "「あ」"

#. Occurrence 8_4:302:10958: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0000; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:302
msgctxt "text_id=10958 | speaker=soujuurou"
msgid "\"Ah?\""
msgstr "「あ？」"

#. Occurrence 8_4:327:10959: scene=8_4
#: 8_4:327
msgctxt "text_id=10959 | speaker=unknown"
msgid "  Looking back on it, the decision had been made rather abruptly."
msgstr "　思えば、突然の出来事だった。"

#. Occurrence 8_4:332:10960: scene=8_4
#: 8_4:332
msgctxt "text_id=10960 | speaker=unknown"
msgid "  That single gasp of surprise was all Alice said."
msgstr "　背後からの声は有珠の一言であり、"

#. Occurrence 8_4:360:10961: scene=8_4
#: 8_4:360
msgctxt "text_id=10961 | speaker=unknown"
msgid "  She grasped her head as if she was battling the most vicious of migraines, called for Aoko, and then made the decision to ban all Japanese teas from this mansion."
msgstr "　彼女は頭痛を堪えるような仕草をした後、青子を呼びつけて、以後、この洋館における番茶・梅昆布茶の錬成を禁止させた。"

#. Occurrence 8_4:365:10962: scene=8_4
#: 8_4:365
msgctxt "text_id=10962 | speaker=unknown"
msgid "  By some miracle, Aoko managed to negotiate and keep Soujyuro's privileges to barley tea during the summer."
msgstr "　青子の交渉で、夏場の麦茶だけはＯＫ、と<言|げん>をとれたのは奇跡と言えるだろう。"

#. Occurrence 8_4:410:10963: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0000; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:410
msgctxt "text_id=10963 | speaker=aoko"
msgid "\"Even the British only drank green tea at first, you know.\""
msgstr "“だいたい、イギリスさんだって初めはグリーンティーが主流だったじゃない”"

#. Occurrence 8_4:416:10964: scene=8_4
#: 8_4:416
msgctxt "text_id=10964 | speaker=unknown"
msgid "  Aoko had clearly hit a nerve with this argument."
msgstr "　といった青子の反撃が、痛いところをついた結果である。"

#. Occurrence 8_4:434:10965: scene=8_4
#: 8_4:434
msgctxt "text_id=10965 | speaker=unknown"
msgid "  Aoko stared at Alice, fairly certain why she was so taken aback by Soujyuro's actions."
msgstr "　ちなみに、「あ」は「ありえない」の「あ」ではないか、と蒼崎青子は睨んでいる。"

#. Occurrence 8_4:486:10966: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0001; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:486
msgctxt "text_id=10966 | speaker=soujuurou"
msgid "\"I don't get why it's such a big deal... Tea is good no matter what kind it is...\""
msgstr "「そこまで嫌がらなくてもなあ……お茶はなんだって美味しいのに」"

#. Occurrence 8_4:492:10967: scene=8_4
#: 8_4:492
msgctxt "text_id=10967 | speaker=unknown"
msgid "  Soujyuro grumbled to himself while sipping his hot green tea."
msgstr "　ひとり呟きながら、温かい緑茶を飲む草十郎。"

#. Occurrence 8_4:508:10968: scene=8_4
#: 8_4:508
msgctxt "text_id=10968 | speaker=unknown"
msgid "  He didn't realize that Alice was upset because he had poured his green tea into a teacup meant for black tea."
msgstr "　紅茶用のカップにほうじ茶を注いだ事が有珠のわななきの最たる理由であった事を、彼は知らない。"

#. Occurrence 8_4:513:10969: scene=8_4
#: 8_4:513
msgctxt "text_id=10969 | speaker=unknown"
msgid "  In Soujyuro's defense, this was the only tea cup that Alice had given him permission to use."
msgstr "　また彼の名誉のために付け加えると、使ったティーカップは有珠が草十郎に使ってもよい、と許可したものである。"

#. Occurrence 8_4:533:10970: scene=8_4
#: 8_4:533
msgctxt "text_id=10970 | speaker=unknown"
msgid "  At any rate, the early morning was his to enjoy."
msgstr "　ともあれ、今は彼だけの幸福空間だ。"

#. Occurrence 8_4:538:10971: scene=8_4
#: 8_4:538
msgctxt "text_id=10971 | speaker=unknown"
msgid "  This was his moment to relax with the Japanese tea set he'd smuggled in."
msgstr "　内緒で持ちこんだ日本茶セット一式を使って、草十郎は労働後の<一時|ひととき>にひたりきる。"

#. Occurrence 8_4:558:10972: scene=8_4
#: 8_4:558
msgctxt "text_id=10972 | speaker=unknown"
msgid "  He didn't use this time to read books or watch TV. He just drank his tea and gazed fondly at the garden-or rather, the dense woods outside."
msgstr "　特別、本を読むワケでも、テレビをつけるワケでもなく、窓越しの庭……というより密林……を、<慈|いつく>しみの目で眺める。"

#. Occurrence 8_4:563:10973: scene=8_4
#: 8_4:563
msgctxt "text_id=10973 | speaker=unknown"
msgid "  Soujyuro simply sat, relaxed, and let his mind wander."
msgstr "　アレはなんとかしたいなー、などと思いつつ、まったりし続ける草十郎だった。"

#. Occurrence 8_4:631:10974: scene=8_4
#: 8_4:631
msgctxt "text_id=10974 | speaker=unknown"
msgid "  About an hour passed."
msgstr "　彼がぼんやりすること、約半刻。"

#. Occurrence 8_4:636:10975: scene=8_4
#: 8_4:636
msgctxt "text_id=10975 | speaker=unknown"
msgid "  Just as he was beginning to feel refreshed, he heard sounds coming from the foyer."
msgstr "　疲れがじゅうぶんにとれた頃、ホールから物音が聞こえてきた。"

#. Occurrence 8_4:672:10976: scene=8_4
#: 8_4:672
msgctxt "text_id=10976 | speaker=unknown"
msgid "  He knew it was Aoko and Alice talking, so he rushed to hide his teacup, teapot, and tea leaves in the kitchen."
msgstr "　それが青子と有珠の話し声と知って、草十郎は神速で湯呑みや急須、お茶の葉をキッチンに隠す。"

#. Occurrence 8_4:677:10977: scene=8_4
#: 8_4:677
msgctxt "text_id=10977 | speaker=unknown"
msgid "  Hiding the contraband was easy enough, considering just how many unused shelves there were in the kitchen. Soujyuro was perturbed by how they wasted the potential of such a splendid kitchen."
msgstr "　台所には使われていない棚が山ほどあるので<隠蔽|いんぺい>自体は簡単だ。むしろ、青子たちの食事事情を如実に語る台所の在り方に困る草十郎である。"

#. Occurrence 8_4:730:10978: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0001; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:730
msgctxt "text_id=10978 | speaker=aoko"
msgid "\"Oh, you're up early, Soujyuro.\""
msgstr "「あら。早いのね、草十郎」"

#. Occurrence 8_4:740:10979: scene=8_4
#: 8_4:740
msgctxt "text_id=10979 | speaker=unknown"
msgid "  Aoko spoke as she took off her white down jacket."
msgstr "　青子は白いダウンジャケットを脱ぎながら声をかけた。"

#. Occurrence 8_4:746:10980: scene=8_4
#: 8_4:746
msgctxt "text_id=10980 | speaker=unknown"
msgid "  Next to her, Alice silently took off her black coat."
msgstr "　彼女の横では、有珠が無言で黒いコートを脱いでいる。"

#. Occurrence 8_4:770:10981: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0002; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:770
msgctxt "text_id=10981 | speaker=soujuurou"
msgid "\"No, I just got home actually. I started working the late shift at a food factory over in Amagihama.\""
msgstr "「いや、いま帰ってきたんだ。<天城浜|あまぎはま>の食品工場に深夜のパートで入ることになって、その帰り」"

#. Occurrence 8_4:780:10982: scene=8_4
#: 8_4:780
msgctxt "text_id=10982 | speaker=unknown"
msgid "  Soujyuro stuck his head out from the kitchen and gestured that he was about to put on some water to boil."
msgstr "　台所から顔をだしながら、さも今からお湯を沸かしますよー、というジェスチャーをする草十郎。"

#. Occurrence 8_4:809:10983: scene=8_4
#: 8_4:809
msgctxt "text_id=10983 | speaker=unknown"
msgid "  Alice tilted her head slightly at him."
msgstr "　それに有珠は<微|かす>かに首を傾げた。"

#. Occurrence 8_4:814:10984: scene=8_4
#: 8_4:814
msgctxt "text_id=10984 | speaker=unknown"
msgid "  It wasn't that she thought his gesturing was funny or anything like that."
msgstr "　……別に、草十郎のジェスチャーが彼女の笑いのツボに入った訳ではない。"

#. Occurrence 8_4:825:10985: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0001; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:825
msgctxt "text_id=10985 | speaker=alice"
msgid "\"Amagihama...?\""
msgstr "「天城浜から……？」"

#. Occurrence 8_4:830:10986: scene=8_4
#: 8_4:830
msgctxt "text_id=10986 | speaker=unknown"
msgid "  Alice glanced up at the clock in the drawing room, and her expression darkened."
msgstr "　有珠はちらりと居間の時計を見て、いっそう表情を曇らせる。"

#. Occurrence 8_4:864:10987: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0002; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:864
msgctxt "text_id=10987 | speaker=aoko"
msgid "\"What's wrong, Alice?\""
msgstr "「どうしたの、有珠？」"

#. Occurrence 8_4:869:10988: scene=8_4
#: 8_4:869
msgctxt "text_id=10988 | speaker=unknown"
msgid "  Aoko asked this from her comfortable seat on the sofa."
msgstr "　いち早くソファーに腰を下ろした青子が、立ったままの有珠に問いかけた。"

#. Occurrence 8_4:878:10989: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0002; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:878
msgctxt "text_id=10989 | speaker=alice"
msgid "\"Nothing.\""
msgstr "「別に」"

#. Occurrence 8_4:888:10990: scene=8_4
#: 8_4:888
msgctxt "text_id=10990 | speaker=unknown"
msgid "  Alice responded indifferently before finally sitting down as well."
msgstr "　素っ気なく答えて、有珠もソファーに腰を下ろす。"

#. Occurrence 8_4:918:10991: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0003; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:918
msgctxt "text_id=10991 | speaker=aoko"
msgid "\"Soujyuro! Just one spoon of sugar, remember?\""
msgstr "「草十郎ー。砂糖は一杯だけだからねー」"

#. Occurrence 8_4:924:10992: scene=8_4
#: 8_4:924
msgctxt "text_id=10992 | speaker=unknown"
msgid "  Aoko yelled her matter-of-course request into the kitchen."
msgstr "　青子はごく当然とばかりに、台所に声を投げた。"

#. Occurrence 8_4:929:10993: scene=8_4
#: 8_4:929
msgctxt "text_id=10993 | speaker=unknown"
msgid "  Soujyuro didn't respond, but it was an affirmative silence."
msgstr "　返事はないが、あっちはそれで了解しているらしい。"

#. Occurrence 8_4:934:10994: scene=8_4
#: 8_4:934
msgctxt "text_id=10994 | speaker=unknown"
msgid "  This was the result of two entire nights' worth of cramming that Alice knew nothing about."
msgstr "　有珠には<与|あずか>り知れない、二晩にわたる一夜漬けの成果だった。"

#. Occurrence 8_4:961:10995: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0004; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:961
msgctxt "text_id=10995 | speaker=aoko"
msgid "\"What about you, Alice?\""
msgstr "「有珠は？」"

#. Occurrence 8_4:982:10996: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0003; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:982
msgctxt "text_id=10996 | speaker=alice"
msgid "\"I'll just have mine with milk.\""
msgstr "「……わたしは、ミルクだけでいいけど」"

#. Occurrence 8_4:987:10997: scene=8_4
#: 8_4:987
msgctxt "text_id=10997 | speaker=unknown"
msgid "  Alice responded out of obligation."
msgstr "　仕方なく答える有珠に、"

#. Occurrence 8_4:1006:10998: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0003; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1006
msgctxt "text_id=10998 | speaker=soujuurou"
msgid "\"Tea with milk, got it.\""
msgstr "「了解、ミルクティーだね」"

#. Occurrence 8_4:1011:10999: scene=8_4
#: 8_4:1011
msgctxt "text_id=10999 | speaker=unknown"
msgid "  For some reason, Soujyuro dutifully answered Alice's request."
msgstr "　と、なぜか律儀に返ってくる声があった。"

#. Occurrence 8_4:1049:11000: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0005; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1049
msgctxt "text_id=11000 | speaker=aoko"
msgid "\"Fine. I'd get sick of his voice if he replied every time, anyway."
msgstr "「ま、いいけど。いちいちつっこんでたらキリがないし。"

#. Occurrence 8_4:1071:11001: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0006; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1071
msgctxt "text_id=11001 | speaker=aoko"
msgid "  Anyway, isn't it pretty rare for you to be drinking tea from a tea bag, Alice?\""
msgstr "　それより珍しいじゃない。有珠がティーバッグのお茶飲むなんて」"

#. Occurrence 8_4:1090:11002: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0004; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:1090
msgctxt "text_id=11002 | speaker=alice"
msgid "\"...I'm just tired today. I thought I might as well.\""
msgstr "「……今日は疲れたから、たまには」"

#. Occurrence 8_4:1095:11003: scene=8_4
#: 8_4:1095
msgctxt "text_id=11003 | speaker=unknown"
msgid "  It seemed she had allowed herself to accept another's kindness, at least for today."
msgstr "　人の厚意を受け取ろう、と思ったらしい。"

#. Occurrence 8_4:1116:11004: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0007; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1116
msgctxt "text_id=11004 | speaker=aoko"
msgid "\"Hmph, if you say so. More importantly, Soujyuro?"
msgstr "「ふーん。ま、いいか。それより草十郎ー。"

#. Occurrence 8_4:1132:11005: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0008; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1132
msgctxt "text_id=11005 | speaker=aoko"
msgid "  Didn't you say something weird earlier?\""
msgstr "　アンタ、さっきおかしなこと言わなかった？」"

#. Occurrence 8_4:1151:11006: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0004; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1151
msgctxt "text_id=11006 | speaker=soujuurou"
msgid "\"Hm? I don't think so.\""
msgstr "「？　別に言ってないぞ、そんな事」"

#. Occurrence 8_4:1171:11007: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0009; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1171
msgctxt "text_id=11007 | speaker=aoko"
msgid "\"Oh? I could've sworn you said something.\""
msgstr "「そう？　ならいいんだけど」"

#. Occurrence 8_4:1176:11008: scene=8_4
#: 8_4:1176
msgctxt "text_id=11008 | speaker=unknown"
msgid "  The two were conversing over a distance of four yards."
msgstr "　居間と台所、実に四メートルもの距離で会話をするふたり。"

#. Occurrence 8_4:1181:11009: scene=8_4
#: 8_4:1181
msgctxt "text_id=11009 | speaker=unknown"
msgid "  Alice decided to add her opinion to the conversation."
msgstr "　それに、ぽつりと有珠は付け足した。"

#. Occurrence 8_4:1217:11010: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0005; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:1217
msgctxt "text_id=11010 | speaker=alice"
msgid "\"...I don't think a day has ever gone by when he hasn't said something weird, to be honest.\""
msgstr "「……静希君がおかしな事を言わない日はないと思うわ、わたし」"

#. Occurrence 8_4:1223:11011: scene=8_4
#: 8_4:1223
msgctxt "text_id=11011 | speaker=unknown"
msgid "  Her quiet tone was luckily just low enough that Soujyuro couldn't hear her from the kitchen."
msgstr "　あんまりな有珠の声は、幸運なことに、台所にいる草十郎には聞こえなかった。"

#. Occurrence 8_4:1262:11012: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0010; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1262
msgctxt "text_id=11012 | speaker=aoko"
msgid "\"I agree, but seriously... Wasn't he talking kind of strangely just now?"
msgstr "「そりゃあそうだけど、いま、ちょっと変だったでしょ？"

#. Occurrence 8_4:1274:11013: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0011; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1274
msgctxt "text_id=11013 | speaker=aoko"
msgid "  ...I don't exactly know how to describe it.\""
msgstr "　……いや、何が引っかかったのかまでは分からないんだけどさ」"

#. Occurrence 8_4:1297:11014: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0006; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:1297
msgctxt "text_id=11014 | speaker=alice"
msgid "\"True. The conversation itself was normal, but something did seem off about what he was saying.\""
msgstr "「そうね。会話自体は普通だったけれど、内容を考えてみると、どこかおかしいわね」"

#. Occurrence 8_4:1330:11015: scene=8_4
#: 8_4:1330
msgctxt "text_id=11015 | speaker=unknown"
msgid "  Aoko became gradually more irritated as she failed to grasp what had been odd about the conversation."
msgstr "　要領のつかめない会話に、ますます不機嫌さをます青子。"

#. Occurrence 8_4:1336:11016: scene=8_4
#: 8_4:1336
msgctxt "text_id=11016 | speaker=unknown"
msgid "  Just then, Soujyuro appeared holding a tray with a teacup for each of them."
msgstr "　そこへ、三人分のティーカップをトレイに載せて草十郎が現れた。"

#. Occurrence 8_4:1376:11017: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0005; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1376
msgctxt "text_id=11017 | speaker=soujuurou"
msgid "\"What are you guys talking about?"
msgstr "「なにを話してるんだ。"

#. Occurrence 8_4:1376:11018: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0005; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1376
msgctxt "text_id=11018 | speaker=soujuurou"
msgid "  I literally just said I started a new part-time job. That's all.\""
msgstr "　単に、新しいアルバイトを始めただけだろ」"

#. Occurrence 8_4:1395:11019: scene=8_4
#: 8_4:1395
msgctxt "text_id=11019 | speaker=unknown"
msgid "  He put the cups down on the black table without making even the slightest sound."
msgstr "　音をたてず、黒テーブルにカップを置く草十郎。"

#. Occurrence 8_4:1400:11020: scene=8_4
#: 8_4:1400
msgctxt "text_id=11020 | speaker=unknown"
msgid "  Alice couldn't complain about how proper his job as a waiter had made him."
msgstr "　ウェイターのアルバイトもやっているらしく、その折り目正しさは有珠をして文句のつけどころがない。"

#. Occurrence 8_4:1434:11021: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0007; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:1434
msgctxt "text_id=11021 | speaker=alice"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence 8_4:1439:11022: scene=8_4
#: 8_4:1439
msgctxt "text_id=11022 | speaker=unknown"
msgid "  While she didn't say anything out loud, she did nod in his direction to show some gratitude."
msgstr "　お礼までは口にしないが、かすかに<顎|あご>を引いて感謝の意を示す有珠。"

#. Occurrence 8_4:1444:11023: scene=8_4
#: 8_4:1444
msgctxt "text_id=11023 | speaker=unknown"
msgid "  Aoko, however..."
msgstr "　一方、"

#. Occurrence 8_4:1468:11024: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0012; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1468
msgctxt "text_id=11024 | speaker=aoko"
msgid "\"Amagihama, was it? There's a huge stadium over there that I go to sometimes when a band I like is on tour.\""
msgstr "「天城浜だっけ？　あそこってスタジアムがある所でしょ。ツアーの会場になるから時々行くけど」"

#. Occurrence 8_4:1479:11025: scene=8_4
#: 8_4:1479
msgctxt "text_id=11025 | speaker=unknown"
msgid "  The student council president, a supposed model student, loved rock bands."
msgstr "　全校生徒の見本になるべき生徒会長は、あろう事かロックバンドの話に夢中だった。"

#. Occurrence 8_4:1499:11026: scene=8_4
#: 8_4:1499
msgctxt "text_id=11026 | speaker=unknown"
msgid "  Aoko was secretly obsessed with a number of bands and used to travel way out of town just to see them perform live when she was in middle school."
msgstr "　青子は密かなバンド好きで、中学の頃は暇さえあれば遠出して小さなライブハウスに入り浸っていたらしい。"

#. Occurrence 8_4:1519:11027: scene=8_4
#: 8_4:1519
msgctxt "text_id=11027 | speaker=unknown"
msgid "  Of course, this was a world that Soujyuro was far from familiar with."
msgstr "　もちろん、草十郎にはよく分からない世界である。"

#. Occurrence 8_4:1556:11028: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0013; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1556
msgctxt "text_id=11028 | speaker=aoko"
msgid "\"Anyway, I can't believe you've started yet another part-time job. What are you trying to accomplish working that hard, Soujyuro?\""
msgstr "「それよりまた新しいバイトはじめたんだ。そんなに働いてどうする気なのよ、草十郎は」"

#. Occurrence 8_4:1597:11029: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0006; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1597
msgctxt "text_id=11029 | speaker=soujuurou"
msgid "\"...Oh, you were listening."
msgstr "「……ああ、よく聞いてくれたね。"

#. Occurrence 8_4:1603:11030: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0007; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1603
msgctxt "text_id=11030 | speaker=soujuurou"
msgid "  Well, I have to work more because there are a couple of people in my life who like to take all my money from me for every little thing you can imagine.\""
msgstr "　本人の名誉のために名前は伏せるけど、誰かさんと誰かさんが俺の少ない収入を無慈悲に奪っていくから、働く先を増やしたんだ」"

#. Occurrence 8_4:1613:11031: scene=8_4
#: 8_4:1613
msgctxt "text_id=11031 | speaker=unknown"
msgid "  This was as much resistance as Soujyuro was able to give."
msgstr "　静希草十郎、せいいっぱいの抵抗だった。"

#. Occurrence 8_4:1618:11032: scene=8_4
#: 8_4:1618
msgctxt "text_id=11032 | speaker=unknown"
msgid "  Aoko lifted her teacup to her mouth as if she was completely oblivious to Soujyuro's monologue."
msgstr "　そんな草十郎の独白をまったく聞いていないように、青子はティーカップを口に運ぶ。"

#. Occurrence 8_4:1659:11033: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0008; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:1659
msgctxt "text_id=11033 | speaker=alice"
msgid "\"Sounds rough.\""
msgstr "「それは大変ね」"

#. Occurrence 8_4:1664:11034: scene=8_4
#: 8_4:1664
msgctxt "text_id=11034 | speaker=unknown"
msgid "  Alice said this as she set her teacup down quietly."
msgstr "　ことり、と静かにカップを置く有珠。"

#. Occurrence 8_4:1669:11035: scene=8_4
#: 8_4:1669
msgctxt "text_id=11035 | speaker=unknown"
msgid "  There were some things she just did not understand."
msgstr "　……彼女にいたっては、本気で分かっていない節もある。"

#. Occurrence 8_4:1692:11036: scene=8_4
#: 8_4:1692
msgctxt "text_id=11036 | speaker=unknown"
msgid "  Aoko had to hold back her laughter as she looked at Alice and Soujyuro."
msgstr "　そんな有珠と草十郎を見て、青子はくっくっと笑いを堪えていた。"

#. Occurrence 8_4:1728:11037: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0008; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1728
msgctxt "text_id=11037 | speaker=soujuurou"
msgid "\"I should've known better than to say anything.\""
msgstr "「……はあ。言った自分が未熟だった」"

#. Occurrence 8_4:1734:11038: scene=8_4
#: 8_4:1734
msgctxt "text_id=11038 | speaker=unknown"
msgid "  Soujyuro's shoulders fell as he said this."
msgstr "　がっくりと肩を落とし紅茶を一口飲んでみる。"

#. Occurrence 8_4:1752:11039: scene=8_4
#: 8_4:1752
msgctxt "text_id=11039 | speaker=unknown"
msgid "  He took a sip of his black tea, still unsure about the taste."
msgstr "　やっぱり、彼にはいまいち不鮮明な味わいだ。"

#. Occurrence 8_4:1789:11040: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0009; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1789
msgctxt "text_id=11040 | speaker=soujuurou"
msgid "\"As long as you know I'm working a lot, I guess that's fine."
msgstr "「ま、アルバイトが多いって分かってくれるだけでいいか。"

#. Occurrence 8_4:1795:11041: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0010; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1795
msgctxt "text_id=11041 | speaker=soujuurou"
msgid "  So that means I'll also be away at night during winter vacation. I'll have to take those pills at work, though...\""
msgstr "　そういったワケだから、冬休み中は夜も留守にする。例の薬はアルバイト先で飲むしかないんだけど―――」"

#. Occurrence 8_4:1821:11042: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0014; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1821
msgctxt "text_id=11042 | speaker=aoko"
msgid "\"Oh, don't worry about that. I'm done with those."
msgstr "「ああ、それなら心配いらないわ。もうあれは止めたから。"

#. Occurrence 8_4:1833:11043: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0015; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1833
msgctxt "text_id=11043 | speaker=aoko"
msgid "  They were a pain to make, and I found something more suitable for you anyway.\""
msgstr "　いちいち作るのも面倒だし、もっと静希クンに似合うのを見付けてきたの」"

#. Occurrence 8_4:1869:11044: scene=8_4
#: 8_4:1869
msgctxt "text_id=11044 | speaker=unknown"
msgid "  Aoko had a huge, ominous grin on her face."
msgstr "　ニマア、と性悪<極|きわ>まりない笑み。"

#. Occurrence 8_4:1875:11045: scene=8_4
#: 8_4:1875
msgctxt "text_id=11045 | speaker=unknown"
msgid "  She put her hand into her jacket pocket and pulled out a little paper bag."
msgstr "　青子はジャケットのポケットに手をいれて、愛らしい紙袋を取り出した。"

#. Occurrence 8_4:1880:11046: scene=8_4
#: 8_4:1880
msgctxt "text_id=11046 | speaker=unknown"
msgid "  It was a small, circular object about twenty inches in diameter, wrapped up nicely like a present."
msgstr "　直径二十センチもない円形の何かを、プレゼント用の袋で包んでいる。"

#. Occurrence 8_4:1928:11047: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0016; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1928
msgctxt "text_id=11047 | speaker=aoko"
msgid "\"Here's a little something to celebrate your moving in here. I want you to wear that from now on, Soujyuro.\""
msgstr "「はい、これは入居祝い。これからはそれを付けておくのよ、草十郎」"

#. Occurrence 8_4:1934:11048: scene=8_4
#: 8_4:1934
msgctxt "text_id=11048 | speaker=unknown"
msgid "  Soujyuro opened the paper bag."
msgstr "　紙袋を開ける草十郎。"

#. Occurrence 8_4:1964:11049: scene=8_4
#: 8_4:1964
msgctxt "text_id=11049 | speaker=unknown"
msgid "  Inside was a white belt."
msgstr "　出てきたのは白色のベルトだった。"

#. Occurrence 8_4:1969:11050: scene=8_4
#: 8_4:1969
msgctxt "text_id=11050 | speaker=unknown"
msgid "  But it wasn't a belt for putting around your waist to keep your pants up."
msgstr "　ズボンの腰に付けるものではない。"

#. Occurrence 8_4:1974:11051: scene=8_4
#: 8_4:1974
msgctxt "text_id=11051 | speaker=unknown"
msgid "  To put it as clearly as possible, it was a collar."
msgstr "　嘘偽りなく、極めて端的に説明すると、首輪以外の何物でもないのだった。"

#. Occurrence 8_4:2010:11052: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0009; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:2010
msgctxt "text_id=11052 | speaker=alice"
msgid "\"Aoko...\""
msgstr "「青子……」"

#. Occurrence 8_4:2016:11053: scene=8_4
#: 8_4:2016
msgctxt "text_id=11053 | speaker=unknown"
msgid "  Alice's expression darkened at this turn of events."
msgstr "　さすがにどうかと思ったのか、有珠は顔を曇らせる。"

#. Occurrence 8_4:2021:11054: scene=8_4
#: 8_4:2021
msgctxt "text_id=11054 | speaker=unknown"
msgid "  But it wasn't clear whether it was her friend's insidiousness or sympathy for Soujyuro that concerned her."
msgstr "　友人の人の悪さに呆れたのか、草十郎への同情かは不明である。"

#. Occurrence 8_4:2060:11055: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0017; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:2060
msgctxt "text_id=11055 | speaker=aoko"
msgid "\"So, what do you think?\""
msgstr "「どう、気に入った？」"

#. Occurrence 8_4:2066:11056: scene=8_4
#: 8_4:2066
msgctxt "text_id=11056 | speaker=unknown"
msgid "  Aoko was clearly a little crazy."
msgstr "　一方、青子は明らかに正気ではない。"

#. Occurrence 8_4:2071:11057: scene=8_4
#: 8_4:2071
msgctxt "text_id=11057 | speaker=unknown"
msgid "  At least she wasn't totally serious."
msgstr "　もとい、本気ではない。"

#. Occurrence 8_4:2076:11058: scene=8_4
#: 8_4:2076
msgctxt "text_id=11058 | speaker=unknown"
msgid "  It was obvious that it was at least half a prank to just see how Soujyuro would react."
msgstr "　これは冗談半分の<悪戯|いたずら>で、嫌がる草十郎の反応を期待しているだけなのは見え見えだ。"

#. Occurrence 8_4:2109:11059: scene=8_4
#: 8_4:2109
msgctxt "text_id=11059 | speaker=unknown"
msgid "  But..."
msgstr "　―――が。"

#. Occurrence 8_4:2126:11060: scene=8_4
#: 8_4:2126
msgctxt "text_id=11060 | speaker=unknown"
msgid "  Soujyuro was solemnly considering the collar he had just been gifted."
msgstr "　贈られた本人である草十郎は、わりかし真剣に首輪を見つめているのだった。"

#. Occurrence 8_4:2138:11061: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0011; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2138
msgctxt "text_id=11061 | speaker=soujuurou"
msgid "\"I'm not exactly sure what this means, but it's the first time anyone has given me something like this.\""
msgstr "「うん。意味は掴みかねるけど、こういうものを人から貰うのは、これが初めてだ」"

#. Occurrence 8_4:2158:11062: scene=8_4
#: 8_4:2158
msgctxt "text_id=11062 | speaker=unknown"
msgid "  ...He actually sounded like this would be a happy memory for him."
msgstr "　……幸せな思い出にひたるような呟き。"

#. Occurrence 8_4:2182:11063: scene=8_4
#: 8_4:2182
msgctxt "text_id=11063 | speaker=unknown"
msgid "  Alice narrowed her eyes at what was transpiring."
msgstr "　それを横で見ながら、何か間違っていると有珠は目を細める。"

#. Occurrence 8_4:2214:11064: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0012; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2214
msgctxt "text_id=11064 | speaker=soujuurou"
msgid "\"But what exactly am I supposed to use this for?\""
msgstr "「けど、これは何に使うんだ？」"

#. Occurrence 8_4:2240:11065: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0018; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:2240
msgctxt "text_id=11065 | speaker=aoko"
msgid "\"It's simple. It's like the golden headband in Journey to the West. Wukong had to wear it if he stepped out of line, though this you wear around your neck like a dog collar.\""
msgstr "「簡単よ。<緊箍児|きんこじ>と同じで、飼い犬が主人に逆らうと首を絞めるの。あっちは頭につけてたけど、それよりは首のがマシでしょう？」"

#. Occurrence 8_4:2245:11066: scene=8_4
#: 8_4:2245
msgctxt "text_id=11066 | speaker=unknown"
msgid "  Soujyuro grimaced when he finally understood Aoko's mean-spirited gift."
msgstr "　む、とようやく青子の意地悪さに気が付く草十郎。"

#. Occurrence 8_4:2250:11067: scene=8_4
#: 8_4:2250
msgctxt "text_id=11067 | speaker=unknown"
msgid "  He really wanted to ask her what kind of person comes up with such an evil idea."
msgstr "　その緊箍児とやらは一体どんな経緯で、どんな悪党が使用するに至ったのか、ぜひ聞かせてほしいところである。"

#. Occurrence 8_4:2286:11068: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0013; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2286
msgctxt "text_id=11068 | speaker=soujuurou"
msgid "\"So basically, if I divulge any secrets or disobey you, then that collar will choke me. Is that right?"
msgstr "「……つまり、秘密をばらしたり逆らったりしたら首が絞まる、と。"

#. Occurrence 8_4:2292:11069: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0014; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2292
msgctxt "text_id=11069 | speaker=soujuurou"
msgid "  ...Are you *sure* you're feeling well, Aozaki?\""
msgstr "　―――やっぱり熱でもあるんじゃないのか、蒼崎は」"

#. Occurrence 8_4:2314:11070: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0019; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:2314
msgctxt "text_id=11070 | speaker=aoko"
msgid "\"Oh, do you not like it? I tried to pick out what I thought would suit you best!\""
msgstr "「あら、首輪はいや？　せっかく草十郎に似合いそうな物を見付けたのに」"

#. Occurrence 8_4:2334:11071: scene=8_4
#: 8_4:2334
msgctxt "text_id=11071 | speaker=unknown"
msgid "  Aoko still had an evil grin on her face."
msgstr "　からかいの入った微笑み。"

#. Occurrence 8_4:2339:11072: scene=8_4
#: 8_4:2339
msgctxt "text_id=11072 | speaker=unknown"
msgid "  But Soujyuro had a surprising response to this gift that Aoko had clearly gotten as a prank."
msgstr "　しかし。青子本人、半ば冗談のつもりで用意したソレを、"

#. Occurrence 8_4:2380:11073: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0015; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2380
msgctxt "text_id=11073 | speaker=soujuurou"
msgid "\"Hmm... I guess you're right. I mean, it's better than taking poison every day, and the belt itself looks well-made."
msgstr "「……それもそうか。毎日毒を飲むよりはましだし、このベルト自体、いいものだし。"

#. Occurrence 8_4:2391:11074: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0016; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2391
msgctxt "text_id=11074 | speaker=soujuurou"
msgid "  I actually like it. Thank you, Aozaki.\""
msgstr "　うん、気に入った。ありがとう蒼崎」"

#. Occurrence 8_4:2413:11075: scene=8_4
#: 8_4:2413
msgctxt "text_id=11075 | speaker=unknown"
msgid "  He spoke one hundred percent truthfully."
msgstr "　お世辞ではなく、彼は本気でそう言った。"

#. Occurrence 8_4:2423:11076: scene=8_4
#: 8_4:2423
msgctxt "text_id=11076 | speaker=unknown"
msgid "  Aoko's face contorted in disbelief, and she could only mumble if he was serious."
msgstr "　さすがに青子も意表をつかれたのか、ほんと？　と小声で聞き返す。"

#. Occurrence 8_4:2457:11077: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0017; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2457
msgctxt "text_id=11077 | speaker=soujuurou"
msgid "\"I'm happy about any act of kindness."
msgstr "「人の厚意はどんなものだって嬉しいよ。"

#. Occurrence 8_4:2463:11078: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0018; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2463
msgctxt "text_id=11078 | speaker=soujuurou"
msgid "  Even more so when it's from you, Aozaki.\""
msgstr "　それに、それが蒼崎なら尚更だ」"

#. Occurrence 8_4:2492:11079: scene=8_4
#: 8_4:2492
msgctxt "text_id=11079 | speaker=unknown"
msgid "  And with that, Soujyuro put the \"belt\" around his neck."
msgstr "　言って、草十郎は<首輪|ベルト>を首に巻いた。"

#. Occurrence 8_4:2497:11080: scene=8_4
#: 8_4:2497
msgctxt "text_id=11080 | speaker=unknown"
msgid "  He placed it over the bandages already there."
msgstr "　首に巻いた布を覆うように。"

#. Occurrence 8_4:2520:11081: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0019; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2520
msgctxt "text_id=11081 | speaker=soujuurou"
msgid "\"I guess this works. It's a little tight, but I'm sure I'll get used to it.\""
msgstr "「こんな感じかな。きついけど、そのうち慣れるだろ」"

#. Occurrence 8_4:2526:11082: scene=8_4
#: 8_4:2526
msgctxt "text_id=11082 | speaker=unknown"
msgid "  Despite his words to the contrary, Soujyuro tugged at the belt uncomfortably and adjusted it."
msgstr "　言いつつ、居心地が悪そうにベルトをずらす。"

#. Occurrence 8_4:2531:11083: scene=8_4
#: 8_4:2531
msgctxt "text_id=11083 | speaker=unknown"
msgid "  It was such a perverse scene that even Aoko's face was red as a beet, even though this had all been her idea."
msgstr "　その仕草はどことなく倒錯的で、言い出した青子本人も赤面してしまった。"

#. Occurrence 8_4:2536:11084: scene=8_4
#: 8_4:2536
msgctxt "text_id=11084 | speaker=unknown"
msgid "  Perhaps it was because it gave her such a clear reminder of the scars she had seen the day before."
msgstr "　昨日見た傷跡が、鮮明に思い出されたせいかもしれない。"

#. Occurrence 8_4:2574:11085: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0020; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2574
msgctxt "text_id=11085 | speaker=soujuurou"
msgid "\"Okay. Is it on right?\""
msgstr "「よし。留め方はこれでいいのか」"

#. Occurrence 8_4:2602:11086: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0020; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:2602
msgctxt "text_id=11086 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 8_4:2607:11087: scene=8_4
#: 8_4:2607
msgctxt "text_id=11087 | speaker=unknown"
msgid "  Aoko retreated guiltily as Soujyuro came closer for her to check the fit of his new collar."
msgstr "　確認のために近寄る草十郎に、うっ、と罪悪感から後退する青子。"

#. Occurrence 8_4:2642:11088: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0021; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2642
msgctxt "text_id=11088 | speaker=soujuurou"
msgid "\"If you don't say anything, how will I know if it fits right?"
msgstr "「？　黙ってちゃ分からないのに。"

#. Occurrence 8_4:2648:11089: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0022; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2648
msgctxt "text_id=11089 | speaker=soujuurou"
msgid "  It's okay. I'll just ask Alice.\""
msgstr "　いいよ、有珠に聞くから」"

#. Occurrence 8_4:2688:11090: scene=8_4
#: 8_4:2688
msgctxt "text_id=11090 | speaker=unknown"
msgid "  Soujyuro shifted his gaze from Aoko to Alice."
msgstr "　青子から有珠に視線を移す草十郎。"

#. Occurrence 8_4:2693:11091: scene=8_4
#: 8_4:2693
msgctxt "text_id=11091 | speaker=unknown"
msgid "  Alice stared intently at Soujyuro wearing his new collar and said,"
msgstr "　有珠はしみじみと首輪をした草十郎を見つめて、"

#. Occurrence 8_4:2720:11092: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0010; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:2720
msgctxt "text_id=11092 | speaker=alice"
msgid "\"...Punk rock, hm? Aoko, stop trying to dress him how you want him to look.\""
msgstr "「―――ロックね。青子、趣味に走りすぎよ」"

#. Occurrence 8_4:2745:11093: scene=8_4
#: 8_4:2745
msgctxt "text_id=11093 | speaker=unknown"
msgid "  She could not have put it any more bluntly."
msgstr "　同居人へのとどめを口にした。"

#. Occurrence 8_4:2774:11094: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0021; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:2774
msgctxt "text_id=11094 | speaker=aoko"
msgid "\"Sh-"
msgstr "「や、"

msgctxt "text_id=11095 | speaker=unknown"
msgid " Shut up! That's not what I was trying to do!"
msgstr "やかましい、そんなんじゃないっ！"

#. Occurrence 8_4:2803:11096: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0022; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:2803
msgctxt "text_id=11096 | speaker=aoko"
msgid "  Just ignore her! From now on, that collar will replace those pills I was giving you. Don't you go divulging any of our secrets!\""
msgstr "　もういい、とにかくそういう事よ！　これからはその首輪が薬の代わりよ、せいぜい秘密を守ることね！」"

#. Occurrence 8_4:2838:11097: scene=8_4
#: 8_4:2838
msgctxt "text_id=11097 | speaker=unknown"
msgid "  Aoko was oddly emphatic as she spoke before stomping off toward the hallway."
msgstr "　なぜか語尾を強調して、青子はドスドスと廊下に向かう。"

#. Occurrence 8_4:2876:11098: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0023; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:2876
msgctxt "text_id=11098 | speaker=aoko"
msgid "\"I'm going to take a nap until lunch. If you wake me up for ANY stupid reason, I WILL murder you!\""
msgstr "「それと、これからお昼まで仮眠をとるけど、くだらないコトで起こしたら殺すから！」"

#. Occurrence 8_4:2888:11099: scene=8_4
#: 8_4:2888
msgctxt "text_id=11099 | speaker=unknown"
msgid "  Aoko slammed the door behind her as she left the drawing room."
msgstr "　壁よ砕けよとばかりに扉を閉め、青子は居間を後にした。"

#. Occurrence 8_4:2893:11100: scene=8_4
#: 8_4:2893
msgctxt "text_id=11100 | speaker=unknown"
msgid "  Soujyuro stared in amazement."
msgstr "　そんな青子を、草十郎は不思議そうに見送っている。"

#. Occurrence 8_4:2924:11101: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0023; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2924
msgctxt "text_id=11101 | speaker=soujuurou"
msgid "\"...I'll never understand why she gets so mad like that all of a sudden.\""
msgstr "「……なんで蒼崎は、いつもいきなり怒るんだろう」"

#. Occurrence 8_4:2929:11102: scene=8_4
#: 8_4:2929
msgctxt "text_id=11102 | speaker=unknown"
msgid "  He murmured to himself, forgetting that Alice was standing right there in front of him."
msgstr "　有珠が目前にいる事を忘れて、つい呟く草十郎。"

#. Occurrence 8_4:2954:11103: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0011; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:2954
msgctxt "text_id=11103 | speaker=alice"
msgid "\"I assume it's because her ill intent doesn't seem to get through to you."
msgstr "「静希君には悪意が通じないからでしょう。"

#. Occurrence 8_4:2954:11104: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0011; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:2954
msgctxt "text_id=11104 | speaker=alice"
msgid "  I wouldn't worry about it if I were you.\""
msgstr "　気にする必要はないわ」"

#. Occurrence 8_4:2990:11105: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0024; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2990
msgctxt "text_id=11105 | speaker=soujuurou"
msgid "\"Ill intent? What? Just now?\""
msgstr "「悪意って、今のが？」"

#. Occurrence 8_4:3010:11106: scene=8_4
#: 8_4:3010
msgctxt "text_id=11106 | speaker=unknown"
msgid "  Alice looked up at Soujyuro's innocent response."
msgstr "　聞き返されて、有珠はハッと顔を上げた。"

#. Occurrence 8_4:3015:11107: scene=8_4
#: 8_4:3015
msgctxt "text_id=11107 | speaker=unknown"
msgid "  There was a glimmer in her eyes that showed surprise at her current actions."
msgstr "　その目は、今の自分の行為に驚いたものだ。"

#. Occurrence 8_4:3044:11108: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0012; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:3044
msgctxt "text_id=11108 | speaker=alice"
msgid "\"It's nothing. Don't worry about it.\""
msgstr "「……なんでもないから、気にしないで」"

#. Occurrence 8_4:3050:11109: scene=8_4
#: 8_4:3050
msgctxt "text_id=11109 | speaker=unknown"
msgid "  With that terse reply, she returned to her usual expressionless self."
msgstr "　簡潔に答えて、いつもの無表情に戻る有珠。"

#. Occurrence 8_4:3055:11110: scene=8_4
#: 8_4:3055
msgctxt "text_id=11110 | speaker=unknown"
msgid "  There was no use explaining Aoko's feelings."
msgstr "　青子の気持ちなど、いちいち説明するまでもない。"

#. Occurrence 8_4:3074:11111: scene=8_4
#: 8_4:3074
msgctxt "text_id=11111 | speaker=unknown"
msgid "  Aoko bought that collar for the sole purpose of annoying Soujyuro and causing mischief. When things didn't turn out how she'd planned, her conscience got the better of her."
msgstr "　青子は草十郎の困る顔が見たくて首輪を買ってきたのに、その悪戯心が素直に喜ばれ、自らの良心に背中をくすぐられただけなのだ。"

#. Occurrence 8_4:3094:11112: scene=8_4
#: 8_4:3094
msgctxt "text_id=11112 | speaker=unknown"
msgid "  Soujyuro mistakenly thought that Aoko was angry at him, when in reality she was only angry at herself."
msgstr "　草十郎は青子に怒られたと勘違いしているが、今のは青子の自爆にすぎない。"

#. Occurrence 8_4:3111:11113: scene=8_4
#: 8_4:3111
msgctxt "text_id=11113 | speaker=unknown"
msgid "  Alice didn't bother telling Soujyuro all these heartwarming details, though."
msgstr "　その微笑ましい行き違いを、有珠は草十郎に語らない。"

#. Occurrence 8_4:3116:11114: scene=8_4
#: 8_4:3116
msgctxt "text_id=11114 | speaker=unknown"
msgid "  Not because it was too much work, just because she was never one to have meaningless conversation."
msgstr "　面倒だからではなく―――そもそも『意味のない会話をする』思考そのものがない。"

#. Occurrence 8_4:3136:11115: scene=8_4
#: 8_4:3136
msgctxt "text_id=11115 | speaker=unknown"
msgid "  That was how she had been raised."
msgstr "　久遠寺有珠はそういう風に育てられている。"

#. Occurrence 8_4:3163:11116: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0013; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:3163
msgctxt "text_id=11116 | speaker=alice"
msgid "\"So what are your plans for the rest of the day, Sizuki?\""
msgstr "「……静希君は、これからどうするの？」"

#. Occurrence 8_4:3169:11117: scene=8_4
#: 8_4:3169
msgctxt "text_id=11117 | speaker=unknown"
msgid "  Alice suddenly changed the topic."
msgstr "　唐突に、有珠はそんな事を問いただした。"

#. Occurrence 8_4:3195:11118: scene=8_4
#: 8_4:3195
msgctxt "text_id=11118 | speaker=unknown"
msgid "  Soujyuro thought for a while before replying."
msgstr "　草十郎はしばし考えこんで、"

#. Occurrence 8_4:3231:11119: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0025; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:3231
msgctxt "text_id=11119 | speaker=soujuurou"
msgid "\"I'm just going to relax until the evening. I've been way too busy recently."
msgstr "「夕方までゆっくりするよ。ここのところ忙しすぎた。"

#. Occurrence 8_4:3237:11120: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0026; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:3237
msgctxt "text_id=11120 | speaker=soujuurou"
msgid "  I want to watch some TV now since we have to wake up Aozaki at lunchtime, right?\""
msgstr "　せっかくだからテレビも見ていたいし、お昼には蒼崎を起こさないといけないだろ？」"

#. Occurrence 8_4:3273:11121: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0014; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:3273
msgctxt "text_id=11121 | speaker=alice"
msgid "\"...Right. Just keep it quiet, then.\""
msgstr "「……そう。なら静かにしていて」"

#. Occurrence 8_4:3284:11122: scene=8_4
#: 8_4:3284
msgctxt "text_id=11122 | speaker=unknown"
msgid "  Alice let out a gentle sigh and rose to her feet."
msgstr "　有珠は小さくため息をついて立ち上がった。"

#. Occurrence 8_4:3289:11123: scene=8_4
#: 8_4:3289
msgctxt "text_id=11123 | speaker=unknown"
msgid "  Just keep it quiet..."
msgstr "　静かにしていて。"

#. Occurrence 8_4:3306:11124: scene=8_4
#: 8_4:3306
msgctxt "text_id=11124 | speaker=unknown"
msgid "  Soujyuro would understand exactly what she meant by those words in just a few minutes."
msgstr "　その言葉が何を示していたのか、草十郎は数分後に実感する事になる。"

#. Occurrence 8_5:62:11125: scene=8_5
#: 8_5:62
msgctxt "text_id=11125 | speaker=unknown"
msgid "  The sun shining through the window was bright."
msgstr "　窓からの日射しが明るい。"

#. Occurrence 8_5:67:11126: scene=8_5
#: 8_5:67
msgctxt "text_id=11126 | speaker=unknown"
msgid "  It was just about nine o'clock, about time for the morning television programs to get going."
msgstr "　そろそろテレビのお茶の間番組にエンジンがかかってくる午前九時。"

#. Occurrence 8_5:72:11127: scene=8_5
#: 8_5:72
msgctxt "text_id=11127 | speaker=unknown"
msgid "  Soujyuro was sitting on the sofa, staring out the window at the scene outside."
msgstr "　草十郎はソファーに座って、外の様子を眺めていた。"

#. Occurrence 8_5:95:11128: scene=8_5
#: 8_5:95
msgctxt "text_id=11128 | speaker=unknown"
msgid "  The view from the neighboring sunroom showed a courtyard in a state of disrepair."
msgstr "　隣室のサンルームから見える中庭の荒廃ぶりは、とても一言では表せない。"

#. Occurrence 8_5:100:11129: scene=8_5
#: 8_5:100
msgctxt "text_id=11129 | speaker=unknown"
msgid "  Soujyuro could appreciate the outdoors in both its natural, wild state, and when tamed by human hands."
msgstr "　あるがままの自然は<尊|とうと>いが、人の手によって整頓された自然にも理解のある草十郎である。"

#. Occurrence 8_5:121:11130: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0000; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:121
msgctxt "text_id=11130 | speaker=soujuurou"
msgid "\"...I really need to do something about that sometime soon.\""
msgstr "“……アレは、近いうちになんとかせねばなるまい”"

#. Occurrence 8_5:136:11131: scene=8_5
#: 8_5:136
msgctxt "text_id=11131 | speaker=unknown"
msgid "  Soujyuro muttered to himself, turning another page in his textbook."
msgstr "　などと、こぢんまりとした野望に燃えながら、教科書のページをまた一枚めくる。"

#. Occurrence 8_5:141:11132: scene=8_5
#: 8_5:141
msgctxt "text_id=11132 | speaker=unknown"
msgid "  On the table before him was a mathematics textbook and a notebook with Aoko's name on it."
msgstr "　テーブルには数学のテキストと青子印のノート。"

#. Occurrence 8_5:152:11133: scene=8_5
#: 8_5:152
msgctxt "text_id=11133 | speaker=unknown"
msgid "  Although at first glance he appeared to be a diligent student studying on his day off, he was in truth only doing so as a compromise."
msgstr "　一見して休日も予習を怠らない優等生……ではあるが、その実、これは妥協の結果である。"

#. Occurrence 8_5:157:11134: scene=8_5
#: 8_5:157
msgctxt "text_id=11134 | speaker=unknown"
msgid "  He had given up on his main intent of watching the morning television shows."
msgstr "　草十郎が第一目的とした朝のテレビ観賞は、ある理由から断念されてしまったからだ。"

#. Occurrence 8_5:188:11135: scene=8_5
#: 8_5:188
msgctxt "text_id=11135 | speaker=unknown"
msgid "  The reason why he gave up was simple."
msgstr "　理由は言うまでもない。"

#. Occurrence 8_5:211:11136: scene=8_5
#: 8_5:211
msgctxt "text_id=11136 | speaker=unknown"
msgid "  He was being considerate of Alice, who sat in front of him with her nose buried in a book."
msgstr "　こうして、今も草十郎の正面で読書に没頭する、久遠寺有珠に気を遣っての事だ。"

#. Occurrence 8_5:216:11137: scene=8_5
#: 8_5:216
msgctxt "text_id=11137 | speaker=unknown"
msgid "  Instead of holing herself up in her room, she'd brought out her old, dusty books to read."
msgstr "　てっきり自室に引きこもると思われていた彼女は、古びた本を持ち出して読書を始めてしまった。"

#. Occurrence 8_5:235:11138: scene=8_5
#: 8_5:235
msgctxt "text_id=11138 | speaker=unknown"
msgid "  This is what she meant when she had said to keep quiet. Soujyuro found it difficult to turn on the TV."
msgstr "　静かにしていて、とはこういう事で、もはや無遠慮にテレビをつける事は難しい。"

#. Occurrence 8_5:259:11139: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0001; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:259
msgctxt "text_id=11139 | speaker=soujuurou"
msgid "(...I guess I won't be watching TV for a while.)"
msgstr "“……とりあえず、しばらくテレビは控えよう”"

#. Occurrence 8_5:265:11140: scene=8_5
#: 8_5:265
msgctxt "text_id=11140 | speaker=unknown"
msgid "  With that decided, Soujyuro resigned himself to reviewing some of the practice problems he'd gotten wrong."
msgstr "　そんな結論に達し、それじゃあ、と草十郎は赤点の補習課題に手を出したのだ。"

#. Occurrence 8_5:270:11141: scene=8_5
#: 8_5:270
msgctxt "text_id=11141 | speaker=unknown"
msgid "  ...In the drawing room, for some reason."
msgstr "　なぜか居間で。"

#. Occurrence 8_5:276:11142: scene=8_5
#: 8_5:276
msgctxt "text_id=11142 | speaker=unknown"
msgid "There wasn't any particular purpose in doing it there, but he also had no real reason to study back up in his room."
msgstr "ここに留まる理由もなかったが、自室に戻る理由も、同じぐらいなかったらしい。"

#. Occurrence 8_5:301:11143: scene=8_5
#: 8_5:301
msgctxt "text_id=11143 | speaker=unknown"
msgid "  And so there he was, leisurely highlighting his textbook with Alice there in the same room."
msgstr "　かくて、彼は有珠がいるにも拘わらず、<暢気|のんき>に<教科書|テキスト>に蛍光ペンなどを引いていたりする。"

#. Occurrence 8_5:306:11144: scene=8_5
#: 8_5:306
msgctxt "text_id=11144 | speaker=unknown"
msgid "  To Soujyuro, there really was no difference between his room in the attic and the drawing room with Alice."
msgstr "　草十郎にしてみれば屋根裏の自室も、有珠のいる居間もそう変わりはない。"

#. Occurrence 8_5:311:11145: scene=8_5
#: 8_5:311
msgctxt "text_id=11145 | speaker=unknown"
msgid "  To be fair, he could probably live with a tiger as long as it didn't cause any trouble."
msgstr "　波乱の予兆さえなければ人食い虎とでも同居する―――"

#. Occurrence 8_5:316:11146: scene=8_5
#: 8_5:316
msgctxt "text_id=11146 | speaker=unknown"
msgid "  That was both Soujyuro's biggest strength and his biggest weakness."
msgstr "　それが静希草十郎の、最大にして最悪の長所だった。"

#. Occurrence 8_5:363:11147: scene=8_5
#: 8_5:363
msgctxt "text_id=11147 | speaker=unknown"
msgid "  Before he knew it, the clock was showing eleven."
msgstr "　気が付けば、時計の針が十一時を指していた。"

#. Occurrence 8_5:368:11148: scene=8_5
#: 8_5:368
msgctxt "text_id=11148 | speaker=unknown"
msgid "  He'd spent two hours doing his math problems but wasn't even halfway finished."
msgstr "　二時間近くかけても、数学の課題は半分も終わらない。"

#. Occurrence 8_5:373:11149: scene=8_5
#: 8_5:373
msgctxt "text_id=11149 | speaker=unknown"
msgid "  More than that, he was disappointed in himself for lacking the courage to speak up at all."
msgstr "　この程度で音をあげる自分の根性の無さに、草十郎は消沈する。"

#. Occurrence 8_5:391:11150: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0002; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:391
msgctxt "text_id=11150 | speaker=soujuurou"
msgid "(...In comparison, Aozaki is really working hard.)"
msgstr "『……それにくらべて、蒼崎は頑張ってる』"

#. Occurrence 8_5:396:11151: scene=8_5
#: 8_5:396
msgctxt "text_id=11151 | speaker=unknown"
msgid "  He dropped his mechanical pencil onto the notebook and watched it roll away."
msgstr "　ぽん、とノートの上を転がっていくシャープペン。"

#. Occurrence 8_5:422:11152: scene=8_5
#: 8_5:422
msgctxt "text_id=11152 | speaker=unknown"
msgid "  He knew that Aoko and Alice were busy with something since final exams had ended."
msgstr "　試験が終わってからこっち、青子たちが何やら活動している事は知っている。"

#. Occurrence 8_5:427:11153: scene=8_5
#: 8_5:427
msgctxt "text_id=11153 | speaker=unknown"
msgid "  He also knew that she had hardly gotten any sleep recently."
msgstr "　それで彼女がほとんど眠っていない事も、"

#. Occurrence 8_5:432:11154: scene=8_5
#: 8_5:432
msgctxt "text_id=11154 | speaker=unknown"
msgid "  If she had been able to ignore him during exams, she probably would have had an easier time."
msgstr "　試験中、自分を無視していればもっと楽になっていたであろう事も、分かっていた。"

#. Occurrence 8_5:452:11155: scene=8_5
#: 8_5:452
msgctxt "text_id=11155 | speaker=unknown"
msgid "  Today's nap was probably the first proper sleep Aoko had gotten in days."
msgstr "　今日の仮眠だって、青子にとっては何日かぶりのまともな睡眠だろう。"

#. Occurrence 8_5:457:11156: scene=8_5
#: 8_5:457
msgctxt "text_id=11156 | speaker=unknown"
msgid "  Though, she showed no signs of exhaustion despite the fact that she must have hit peak long ago. She always seemed raring to go."
msgstr "　疲労はとうにピークの筈だ。なのに、そんな素振りも見せないで青子はきびきびと歩いている。"

#. Occurrence 8_5:488:11157: scene=8_5
#: 8_5:488
msgctxt "text_id=11157 | speaker=unknown"
msgid "  It wasn't that she was trying to act tough;"
msgstr "　弱音を吐かない、のではなく。"

#. Occurrence 8_5:493:11158: scene=8_5
#: 8_5:493
msgctxt "text_id=11158 | speaker=unknown"
msgid "  that was just the kind of person she was. Always positive, always tough as nails."
msgstr "　弱音そのものが浮かんでいない、前向きで強い<信念|こころ>。"

#. Occurrence 8_5:498:11159: scene=8_5
#: 8_5:498
msgctxt "text_id=11159 | speaker=unknown"
msgid "  And that was exactly why she came off as completely irrational at times."
msgstr "　彼女が時に理不尽として映るのは、そのまっすぐさ故だろう。"

#. Occurrence 8_5:531:11160: scene=8_5
#: 8_5:531
msgctxt "text_id=11160 | speaker=unknown"
msgid "  But if that was the case, you could probably describe Alice in exactly the same way."
msgstr "　それを言うなら目前の有珠だって同じかもしれない。"

#. Occurrence 8_5:556:11161: scene=8_5
#: 8_5:556
msgctxt "text_id=11161 | speaker=unknown"
msgid "  Soujyuro couldn't help but feel a bit inadequate when he saw their single-minded focus on their goals."
msgstr "　目的に向かってひた走る彼女たちを見ていると、漠然と自分の中途半端さを考えてしまう。"

#. Occurrence 8_5:562:11162: scene=8_5
#: 8_5:562
msgctxt "text_id=11162 | speaker=unknown"
msgid "  He'd been so preoccupied with adjusting to his new life that he'd neglected to think about what he was going to do with himself after."
msgstr "　今までは新生活に慣れようと必死だったけれど、もし慣れてしまったのなら、その後はどうする気なのか、と。"

#. Occurrence 8_5:597:11163: scene=8_5
#: 8_5:597
msgctxt "text_id=11163 | speaker=unknown"
msgid "  Thinking about this cast a gloomy cloud over his heart."
msgstr "　それを思うと、草十郎の心は暗い影に<覆|おお>われる。"

#. Occurrence 8_5:602:11164: scene=8_5
#: 8_5:602
msgctxt "text_id=11164 | speaker=unknown"
msgid "  He felt like he'd never find a clear purpose in life like Aoko and Alice seemed to have."
msgstr "　自分は彼女たちのような、明確な目的はもう見つからない気がするからだ。"

#. Occurrence 8_5:618:11165: scene=8_5
#: 8_5:618
msgctxt "text_id=11165 | speaker=unknown"
msgid "  ...At least not since he'd left the mountains."
msgstr "　……山から下りた時から。"

#. Occurrence 8_5:623:11166: scene=8_5
#: 8_5:623
msgctxt "text_id=11166 | speaker=unknown"
msgid "  His old life was gone now, never to return."
msgstr "　彼の糸は断ち切れて、二度と戻ることはない。"

#. Occurrence 8_5:643:11167: scene=8_5
#: 8_5:643
msgctxt "text_id=11167 | speaker=unknown"
msgid "  He was like a kite cut from its string, destined to fly only where the winds took it."
msgstr "　糸の切れた<凧|たこ>は<惰性|だせい>で流れていくだけだ。"

#. Occurrence 8_5:658:11168: scene=8_5
#: 8_5:658
msgctxt "text_id=11168 | speaker=unknown"
msgid "  And without anything to ground him, he couldn't do anything about the empty future that lay ahead."
msgstr "　その先には何もないと分かっていても、地に足がついていないのでどうにもならない。"

#. Occurrence 8_5:663:11169: scene=8_5
#: 8_5:663
msgctxt "text_id=11169 | speaker=unknown"
msgid "  He could only let himself fly where the currents took him, slowly losing sight of the ground below."
msgstr "　いずれ空にまぎれて、地上から見えなくなる。"

#. Occurrence 8_5:697:11170: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0003; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:697
msgctxt "text_id=11170 | speaker=soujuurou"
msgid "(There's all the conveniences you could ask for here, but nothing I truly desire...)"
msgstr "『……そうだな。便利な物はあふれているけど、本当に望むものは―――』"

#. Occurrence 8_5:703:11171: scene=8_5
#: 8_5:703
msgctxt "text_id=11171 | speaker=unknown"
msgid "  The town was full of options, but he could find nothing."
msgstr "　町を歩くだけで山ほどある筈なのに、どうしても見つけ出せない。"

#. Occurrence 8_5:723:11172: scene=8_5
#: 8_5:723
msgctxt "text_id=11172 | speaker=unknown"
msgid "  He'd asked himself the same questions time and time again."
msgstr "　もう何度も繰り返した自問。"

#. Occurrence 8_5:728:11173: scene=8_5
#: 8_5:728
msgctxt "text_id=11173 | speaker=unknown"
msgid "  It never made him feel any better. If anything, it only made him feel worse and worse."
msgstr "　自分に言い聞かせたところで気持ちは晴れるどころか、暗くなっていく一方だった。"

#. Occurrence 8_5:733:11174: scene=8_5
#: 8_5:733
msgctxt "text_id=11174 | speaker=unknown"
msgid "  That, or..."
msgstr "　それとも、あるいは。"

#. Occurrence 8_5:738:11175: scene=8_5
#: 8_5:738
msgctxt "text_id=11175 | speaker=unknown"
msgid "  Maybe he felt that lamenting his own ineptitude would lead to finding some kind of goal or desire someday."
msgstr "　己の半端さを嘆くほどには、いつか、希望らしきものが見つかると<縋|すが>っているのだろうか……？"

#. Occurrence 8_5:765:11176: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0004; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:765
msgctxt "text_id=11176 | speaker=soujuurou"
msgid "\"...Hah.\""
msgstr "「―――――はあ」"

#. Occurrence 8_5:772:11177: scene=8_5
#: 8_5:772
msgctxt "text_id=11177 | speaker=unknown"
msgid "  Tired of his own sniveling, Soujyuro dejectedly closed his notebook."
msgstr "　自分の弱音に呆れて、草十郎はノートを閉じた。"

#. Occurrence 8_5:788:11178: scene=8_5
#: 8_5:788
msgctxt "text_id=11178 | speaker=unknown"
msgid "  When he looked up, he saw his own face reflected back at him in the TV screen."
msgstr "　ふと視線をあげると、ブラウン管に自分の顔が映っている。"

#. Occurrence 8_5:793:11179: scene=8_5
#: 8_5:793
msgctxt "text_id=11179 | speaker=unknown"
msgid "  His new collar was there around his neck, looking as out of place as ever."
msgstr "　昨日まではなかった首の飾りは、まだ居心地が悪そうに巻かれていた。"

#. Occurrence 8_5:840:11180: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0005; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:840
msgctxt "text_id=11180 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 8_5:846:11181: scene=8_5
#: 8_5:846
msgctxt "text_id=11181 | speaker=unknown"
msgid "  Perhaps a fool like him who felt weak when faced with others' strengths did need to wear a collar after all."
msgstr "　なるほど。他人の強さを見て自分の弱さを嘆く馬鹿者には、首輪の一つも着けていなくては危なっかしい。"

#. Occurrence 8_5:875:11182: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0006; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:875
msgctxt "text_id=11182 | speaker=soujuurou"
msgid "(This is silly. I shouldn't worry about this until I'm actually an adult.)"
msgstr "『まったくだ。悩むのはいっちょ前になってから』"

#. Occurrence 8_5:887:11183: scene=8_5
#: 8_5:887
msgctxt "text_id=11183 | speaker=unknown"
msgid "  He shook off his thoughts of doom and gloom and sat up straight."
msgstr "　弱音を振り払って、背中を伸ばす。"

#. Occurrence 8_5:892:11184: scene=8_5
#: 8_5:892
msgctxt "text_id=11184 | speaker=unknown"
msgid "  After psyching himself up a little, he stood up from the sofa."
msgstr "　<鈍|にぶ>った体に活を入れて、草十郎は立ち上がった。"

#. Occurrence 8_5:933:11185: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0007; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:933
msgctxt "text_id=11185 | speaker=soujuurou"
msgid "\"I'm gonna make some food. You want anything, Alice?\""
msgstr "「よし。何か作るけど、有珠は？」"

#. Occurrence 8_5:939:11186: scene=8_5
#: 8_5:939
msgctxt "text_id=11186 | speaker=unknown"
msgid "  Soujyuro asked casually."
msgstr "　ついでに。"

#. Occurrence 8_5:945:11187: scene=8_5
#: 8_5:945
msgctxt "text_id=11187 | speaker=unknown"
msgid "While Soujyuro had been doing his own thing, he had remained mindful of Alice."
msgstr "今までやりたい放題していた草十郎だが、きちんと有珠を気にかけていたらしい。"

#. Occurrence 8_5:985:11188: scene=8_5
#: 8_5:985
msgctxt "text_id=11188 | speaker=unknown"
msgid "  Alice looked up, surprised at hearing her name."
msgstr "　名前を呼ばれて、有珠はハッとあたりを見渡した。"

#. Occurrence 8_5:990:11189: scene=8_5
#: 8_5:990
msgctxt "text_id=11189 | speaker=unknown"
msgid "  She had completely forgotten Soujyuro was even there."
msgstr "　草十郎とは逆に、完全に草十郎を失念していたようだ。"

#. Occurrence 8_5:1017:11190: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_5_0000; voice_prefix=A40; voice_category=2; scene=8_5
#: 8_5:1017
msgctxt "text_id=11190 | speaker=alice"
msgid "\"M-Me...?\""
msgstr "「わ、わたし……？」"

#. Occurrence 8_5:1038:11191: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0008; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:1038
msgctxt "text_id=11191 | speaker=soujuurou"
msgid "\"Yes, you. You've only had some tea all morning. If I'm going to be cooking, I might as well cook for everyone.\""
msgstr "「ああ。有珠、朝から紅茶しか飲んでないだろ。どうせ作るなら、いっぱい作った方がお得なんだ」"

#. Occurrence 8_5:1064:11192: scene=8_5
#: 8_5:1064
msgctxt "text_id=11192 | speaker=unknown"
msgid "  Without waiting for her reply, Soujyuro headed off to the kitchen while putting on his apron."
msgstr "　有珠の返事も待たず、草十郎はエプロンをしながら台所へと歩いていく。"

#. Occurrence 8_5:1070:11193: scene=8_5
#: 8_5:1070
msgctxt "text_id=11193 | speaker=unknown"
msgid "  Alice tried to wave at him to stop, but by then he'd already disappeared into the kitchen."
msgstr "　それを有珠は手だけで呼び止めるが、草十郎はもう台所に移動していた。"

#. Occurrence 8_5:1117:11194: scene=8_5
#: 8_5:1117
msgctxt "text_id=11194 | speaker=unknown"
msgid "  She was hesitant to walk all the way in there just to tell him she didn't need anything."
msgstr "　……わざわざ台所まで足を運び、自分の分はいらない、というのも<躊躇|ためら>われる。"

#. Occurrence 8_5:1122:11195: scene=8_5
#: 8_5:1122
msgctxt "text_id=11195 | speaker=unknown"
msgid "  And besides, she was actually hungry."
msgstr "　というか、空腹なのは事実なのだ。"

#. Occurrence 8_5:1127:11196: scene=8_5
#: 8_5:1127
msgctxt "text_id=11196 | speaker=unknown"
msgid "  Soujyuro's proposal made sense, and her empty stomach agreed."
msgstr "　草十郎の提案は、今の彼女の健康状態から見れば合理的である。"

#. Occurrence 8_5:1147:11197: scene=8_5
#: 8_5:1147
msgctxt "text_id=11197 | speaker=unknown"
msgid "  Alice was hungry, and Soujyuro was going to make lunch."
msgstr "　有珠は空腹で、草十郎は昼食を作る。"

#. Occurrence 8_5:1152:11198: scene=8_5
#: 8_5:1152
msgctxt "text_id=11198 | speaker=unknown"
msgid "  Making lunch for both of them would save the time and trouble of cooking two separate meals."
msgstr "　一緒に作るのなら、別々に昼食を用意する時間を短縮できる。"

#. Occurrence 8_5:1157:11199: scene=8_5
#: 8_5:1157
msgctxt "text_id=11199 | speaker=unknown"
msgid "  There was no logical reason for Alice to refuse his gesture."
msgstr "　感情論を除けば、有珠にはまったく反論の余地がない。"

#. Occurrence 8_5:1185:11200: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_5_0001; voice_prefix=A40; voice_category=2; scene=8_5
#: 8_5:1185
msgctxt "text_id=11200 | speaker=alice"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 8_5:1191:11201: scene=8_5
#: 8_5:1191
msgctxt "text_id=11201 | speaker=unknown"
msgid "  She decided to stay quiet, and tacitly accept his offer."
msgstr "　喉まで出た声を飲みこんで、有珠は草十郎を黙認する事にした。"

#. Occurrence 8_5:1248:11202: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_5_0002; voice_prefix=A40; voice_category=2; scene=8_5
#: 8_5:1248
msgctxt "text_id=11202 | speaker=alice"
msgid "\"...He is so strange.\""
msgstr "『……変な人』"

#. Occurrence 8_5:1253:11203: scene=8_5
#: 8_5:1253
msgctxt "text_id=11203 | speaker=unknown"
msgid "  She whispered the words softly, not for anyone in particular to hear but herself."
msgstr "　わずかに間をおいて、誰に聞かせるでもなく、控えめに呟きながら。"

#. Occurrence 8_6:64:11204: scene=8_6
#: 8_6:64
msgctxt "text_id=11204 | speaker=unknown"
msgid "  The truth was, however..."
msgstr "　とは言いつつも実のところ。"

#. Occurrence 8_6:69:11205: scene=8_6
#: 8_6:69
msgctxt "text_id=11205 | speaker=unknown"
msgid "  Alice had been in a bad mood all morning."
msgstr "　今朝からこっち、久遠寺有珠はたいへん立腹していた。"

#. Occurrence 8_6:130:11206: scene=8_6
#: 8_6:130
msgctxt "text_id=11206 | speaker=unknown"
msgid "  After checking all the sigils around Misaki City and boarding the first train back from Toukawa, all she wanted to do was spend the rest of her day reading until the words turned into a jumble."
msgstr "　三咲市の支点をチェックして回り、始発の電車で陶川から帰ってくる時から、彼女はずっと、今日は居間で日が暮れるまで読書、文字がゲシュタルトるまで読書、と決めていたのである。"

#. Occurrence 8_6:135:11207: scene=8_6
#: 8_6:135
msgctxt "text_id=11207 | speaker=unknown"
msgid "  Her iron resolve to complete this task would not be interrupted by someone else milling about in the drawing room."
msgstr "　そんな鉄の意志は、居間に余人がいたところで<覆|くつがえ>されるものではない。"

#. Occurrence 8_6:158:11208: scene=8_6
#: 8_6:158
msgctxt "text_id=11208 | speaker=unknown"
msgid "  This was her mansion and there was no way she was going to lock herself up in her room on account of Soujyuro."
msgstr "　ましてや自分は館の主人なのだから、草十郎の為に自室に引きこもるなんてもっての外だ。"

#. Occurrence 8_6:178:11209: scene=8_6
#: 8_6:178
msgctxt "text_id=11209 | speaker=unknown"
msgid "  However..."
msgstr "　……しかし。"

#. Occurrence 8_6:184:11210: scene=8_6
#: 8_6:184
msgctxt "text_id=11210 | speaker=unknown"
msgid "With that said, she knew it would be wrong to kick Soujyuro out for no real reason."
msgstr "そうは言いつつも、理由なく草十郎を追い出すのもなんだか間違っている。"

#. Occurrence 8_6:200:11211: scene=8_6
#: 8_6:200
msgctxt "text_id=11211 | speaker=unknown"
msgid "  As it stood, Soujyuro had actually kept quiet like she'd asked."
msgstr "　現状において、草十郎はたしかに“静かに”している。"

#. Occurrence 8_6:205:11212: scene=8_6
#: 8_6:205
msgctxt "text_id=11212 | speaker=unknown"
msgid "  He wasn't in the wrong here. If Alice had really wanted to be alone, she should have gone to her room."
msgstr "　彼に問題はない。それでもひとりでいたいなら、有珠の方が自室に戻るべきなのである。"

#. Occurrence 8_6:251:11213: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0000; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:251
msgctxt "text_id=11213 | speaker=alice"
msgid "\"I should have told him to leave me alone instead of just telling him to be quiet...\""
msgstr "“……静かにして、じゃなくて、ひとりにさせて、と言うべきだった―――”"

#. Occurrence 8_6:257:11214: scene=8_6
#: 8_6:257
msgctxt "text_id=11214 | speaker=unknown"
msgid "  Alice had defiantly stayed in the drawing room despite realizing the dilemma she'd put herself in."
msgstr "　そんなジレンマに陥りながら、少しだけ意地になって有珠は居間に残ったのだ。"

#. Occurrence 8_6:262:11215: scene=8_6
#: 8_6:262
msgctxt "text_id=11215 | speaker=unknown"
msgid "  She had figured Soujyuro would eventually make a ruckus and run off to hide in his attic room."
msgstr "　どうせ、草十郎の方が音をあげて屋根裏部屋に逃げこむだろうと予想して。"

#. Occurrence 8_6:299:11216: scene=8_6
#: 8_6:299
msgctxt "text_id=11216 | speaker=unknown"
msgid "  Her assumption could not have been more wrong."
msgstr "　結果、予想は大きく外れる事になった。"

#. Occurrence 8_6:304:11217: scene=8_6
#: 8_6:304
msgctxt "text_id=11217 | speaker=unknown"
msgid "  Soujyuro never left the drawing room."
msgstr "　彼は居間から退散しなかったし、"

#. Occurrence 8_6:309:11218: scene=8_6
#: 8_6:309
msgctxt "text_id=11218 | speaker=unknown"
msgid "  Moreover, she had actually stopped caring that he was there."
msgstr "　不思議なことに、少女も草十郎の<存在|こと>が気にならなくなったからだ。"

#. Occurrence 8_6:329:11219: scene=8_6
#: 8_6:329
msgctxt "text_id=11219 | speaker=unknown"
msgid "  Though he hadn't paid her any attention, he hadn't ignored her either."
msgstr "　彼は有珠を意識する事なく、また、無視しているわけでもなかった。"

#. Occurrence 8_6:337:11220: scene=8_6
#: 8_6:337
msgctxt "text_id=11220 | speaker=unknown"
msgid "  They had simply sat in silence together without any awkwardness."
msgstr "　お互い無言でいたのに、それで気まずいという事もない。"

#. Occurrence 8_6:342:11221: scene=8_6
#: 8_6:342
msgctxt "text_id=11221 | speaker=unknown"
msgid "  Alice felt the freedom of being alone along with the comfort of someone being by her side."
msgstr "　ひとりでいるような解放感があるのに、誰かが<傍|そば>にいるという安心感がある。"

#. Occurrence 8_6:362:11222: scene=8_6
#: 8_6:362
msgctxt "text_id=11222 | speaker=unknown"
msgid "  To put it into words, Soujyuro was just that kind of person."
msgstr "　……言葉にすると、静希草十郎という人間はそんな感じだった。"

#. Occurrence 8_6:380:11223: scene=8_6
#: 8_6:380
msgctxt "text_id=11223 | speaker=unknown"
msgid "  That was probably the only reason Alice had been able to sleep so soundly with him there next to her."
msgstr "　だからこそ、すぐ傍に他人がいたのに眠り続ける、なんて事が出来たのかも知れない。"

#. Occurrence 8_6:432:11224: scene=8_6
#: 8_6:432
msgctxt "text_id=11224 | speaker=unknown"
msgid "  Soujyuro continued cooking in the kitchen, oblivious to the thoughts that went through Alice's head."
msgstr "　そんな有珠の内面も知らず、草十郎は台所で何やら調理を続けている。"

#. Occurrence 8_6:437:11225: scene=8_6
#: 8_6:437
msgctxt "text_id=11225 | speaker=unknown"
msgid "  She couldn't see him from the drawing room, but she could easily imagine him cooking in the kitchen."
msgstr "　居間からは見えないけれど、有珠には気楽に調理している後ろ姿が容易に想像できた。"

#. Occurrence 8_6:473:11226: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0001; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:473
msgctxt "text_id=11226 | speaker=alice"
msgid "\"...He really is strange.\""
msgstr "「……変な人ね、ほんとうに」"

#. Occurrence 8_6:479:11227: scene=8_6
#: 8_6:479
msgctxt "text_id=11227 | speaker=unknown"
msgid "  Alice resumed reading after unwittingly stating her feelings out loud a second time."
msgstr "　二度目の所感を漏らして、有珠は読書を再開した。"

#. Occurrence 8_6:484:11228: scene=8_6
#: 8_6:484
msgctxt "text_id=11228 | speaker=unknown"
msgid "  The sunlight beaming into the drawing room showed that it was noon."
msgstr "　居間から差しこむ光はじき正午である事を示している。"

#. Occurrence 8_6:489:11229: scene=8_6
#: 8_6:489
msgctxt "text_id=11229 | speaker=unknown"
msgid "  The sunlight actually looked warm, despite it being a cloudy winter day."
msgstr "　冬の曇った天気にしては、その日射しはどこか温かそうだった。"

#. Occurrence 8_6:536:11230: scene=8_6
#: 8_6:536
msgctxt "text_id=11230 | speaker=unknown"
msgid "  Just as noon struck, Soujyuro returned to the drawing room with two sets of plates."
msgstr "　ちょうど正午にさしかかろうとした時、草十郎は二人分の食器を持って居間へ戻ってきた。"

#. Occurrence 8_6:541:11231: scene=8_6
#: 8_6:541
msgctxt "text_id=11231 | speaker=unknown"
msgid "  Some food of an indescribable color was piled on the large cream-colored plates."
msgstr "　大きなクリーム色のお皿には、なんとも言えない色合いの料理が盛られている。"

#. Occurrence 8_6:597:11232: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0002; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:597
msgctxt "text_id=11232 | speaker=alice"
msgid "\"This is, um...\""
msgstr "「これ、は―――」"

#. Occurrence 8_6:603:11233: scene=8_6
#: 8_6:603
msgctxt "text_id=11233 | speaker=unknown"
msgid "  She hadn't expected much."
msgstr "　期待など、してはいなかった。"

#. Occurrence 8_6:608:11234: scene=8_6
#: 8_6:608
msgctxt "text_id=11234 | speaker=unknown"
msgid "  And since she also hadn't requested anything, she could just refuse if it was something she didn't want..."
msgstr "　期待などしてはいなかったので、粗末なものがきたらそれを理由に断ろう―――"

#. Occurrence 8_6:613:11235: scene=8_6
#: 8_6:613
msgctxt "text_id=11235 | speaker=unknown"
msgid "  But this \"food\" left her at a loss for words despite psyching herself up."
msgstr "　なんて<覚悟|かくご><装填|そうてん>済みの有珠をして、それは、絶句させるに足る魔料理だった。"

#. Occurrence 8_6:662:11236: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0003; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:662
msgctxt "text_id=11236 | speaker=alice"
msgid "\"What... is this?\""
msgstr "「これ、は、なに？」"

#. Occurrence 8_6:667:11237: scene=8_6
#: 8_6:667
msgctxt "text_id=11237 | speaker=unknown"
msgid "  Alice spoke as though she was terrified of what had been placed before her."
msgstr "　おそるおそる口にする有珠。"

#. Occurrence 8_6:709:11238: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0000; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:709
msgctxt "text_id=11238 | speaker=soujuurou"
msgid "\"Huh? I just put some stuff on top of stir-fried udon noodles.\""
msgstr "「ん？　なにって、焼きうどんになんか掛けてみた」"

#. Occurrence 8_6:743:11239: scene=8_6
#: 8_6:743
msgctxt "text_id=11239 | speaker=unknown"
msgid "  If Aoko had been there, she probably would have punched him."
msgstr "　青子がいたら鉄拳制裁ものの発言である。"

#. Occurrence 8_6:765:11240: scene=8_6
#: 8_6:765
msgctxt "text_id=11240 | speaker=unknown"
msgid "  But Soujyuro just confidently placed the two large plates on the table."
msgstr "　草十郎はなに恥じらう事なく、どん、どん、とテーブルに大皿を置いていく。"

#. Occurrence 8_6:770:11241: scene=8_6
#: 8_6:770
msgctxt "text_id=11241 | speaker=unknown"
msgid "  Steam billowed from the mountain of food like an angry volcano ready to erupt at any moment."
msgstr "　ごうごうと立ち上る、<恐山|おそれざん>の憤怒のごとき湯気。"

#. Occurrence 8_6:775:11242: scene=8_6
#: 8_6:775
msgctxt "text_id=11242 | speaker=unknown"
msgid "  The thick mystery sauce flowed over the plates as magma might from said eruption."
msgstr "　どろどろとドロドロする、エトナ火山の<溶岩|マグマ>のごときなんか。"

#. Occurrence 8_6:780:11243: scene=8_6
#: 8_6:780
msgctxt "text_id=11243 | speaker=unknown"
msgid "  And below it all were a seemingly infinite number of slimy tentacle-like noodles."
msgstr "　その下に身を潜める、ごんぶとな無数の<触手|うどん>たち。"

#. Occurrence 8_6:800:11244: scene=8_6
#: 8_6:800
msgctxt "text_id=11244 | speaker=unknown"
msgid "  There was really nothing more to say about it."
msgstr "　……もはや語るまでもない。"

#. Occurrence 8_6:805:11245: scene=8_6
#: 8_6:805
msgctxt "text_id=11245 | speaker=unknown"
msgid "  This was clearly the food of a poor, struggling student who favored quantity over quality."
msgstr "　これは質より量を重視する、一人暮らしの男子学生にのみ伝わる味わい。"

#. Occurrence 8_6:825:11246: scene=8_6
#: 8_6:825
msgctxt "text_id=11246 | speaker=unknown"
msgid "  All that was required was a basic recipe, the will to cook something, and what few ingredients were needed."
msgstr "　必要なものはレシピとやる気と材料だけ。"

#. Occurrence 8_6:830:11247: scene=8_6
#: 8_6:830
msgctxt "text_id=11247 | speaker=unknown"
msgid "  The pile of stir-fried noodles with sauce slathered on top was so horrifically bad, it was almost an art form."
msgstr "　喩えるなら、大量の焼きうどんに、大量のあんかけを組み合わせた芸術的なまでの芸術性のなさ。"

#. Occurrence 8_6:835:11248: scene=8_6
#: 8_6:835
msgctxt "text_id=11248 | speaker=unknown"
msgid "  This was a bachelor's cooking, if she'd ever seen it."
msgstr "　そう、これこそは紛うことなき<男|おとこ>料理。"

#. Occurrence 8_6:841:11249: scene=8_6
#: 8_6:841
msgctxt "text_id=11249 | speaker=unknown"
msgid "  There was really nothing else you could call it."
msgstr "　またの名をまかないとも言う。"

#. Occurrence 8_6:905:11250: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0004; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:905
msgctxt "text_id=11250 | speaker=alice"
msgid "\"...\""
msgstr "「……………………」"

#. Occurrence 8_6:910:11251: scene=8_6
#: 8_6:910
msgctxt "text_id=11251 | speaker=unknown"
msgid "  She had wondered what he was doing for an hour in there, and it turned out he had been making this sauce."
msgstr "　一時間も何をやっていたかと思えば、せっせとあんかけを作っていたらしい。"

#. Occurrence 8_6:915:11252: scene=8_6
#: 8_6:915
msgctxt "text_id=11252 | speaker=unknown"
msgid "  No sauce would've been fine, but Soujyuro had wholeheartedly gone the extra mile."
msgstr "　焼きうどんだけで十分なのに、もう<一手間|ひとてま>加えたのは草十郎なりに真心だろう。"

#. Occurrence 8_6:920:11253: scene=8_6
#: 8_6:920
msgctxt "text_id=11253 | speaker=unknown"
msgid "  Soujyuro bowed his head slightly and picked up his chopsticks."
msgstr "　草十郎は小さくおじぎをしてから箸を手にとった。"

#. Occurrence 8_6:925:11254: scene=8_6
#: 8_6:925
msgctxt "text_id=11254 | speaker=unknown"
msgid "  He had brought a fork for Alice."
msgstr "　有珠にはフォークが用意されている。"

#. Occurrence 8_6:949:11255: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0005; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:949
msgctxt "text_id=11255 | speaker=alice"
msgid "\"...\""
msgstr "「……………………」"

#. Occurrence 8_6:957:11256: scene=8_6
#: 8_6:957
msgctxt "text_id=11256 | speaker=unknown"
msgid "  She picked up the fork and stuck it into the noodles half-drowning in sauce."
msgstr "　フォークを手にとって、有珠はあんかけに半分埋まっている麺をつついてみる。"

#. Occurrence 8_6:962:11257: scene=8_6
#: 8_6:962
msgctxt "text_id=11257 | speaker=unknown"
msgid "  Soujyuro began eating, not seeming to care that Alice sat there looking like she was about to eat poison."
msgstr "　毒見にしか見えない有珠の様子を気にした風もなく、草十郎は行儀よく食べはじめていた。"

#. Occurrence 8_6:1019:11258: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0006; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1019
msgctxt "text_id=11258 | speaker=alice"
msgid "\"...\""
msgstr "「……………………」"

#. Occurrence 8_6:1024:11259: scene=8_6
#: 8_6:1024
msgctxt "text_id=11259 | speaker=unknown"
msgid "  Seeming to view this as a challenge, Alice furrowed her brow and slowly brought the mass of noodles to her mouth."
msgstr "　有珠的には挑戦と映ったのか、むっと眉をひそめながら、大雑把すぎる料理を口に運ぶ。"

#. Occurrence 8_6:1077:11260: scene=8_6
#: 8_6:1077
msgctxt "text_id=11260 | speaker=unknown"
msgid "  ...It was a little salty and ugly to look at, but it didn't taste all that bad. If anything, it was actually pretty good."
msgstr "　……形容し辛い味ではあるが、食べられないほど不味くはない。あえて批評するのなら、わりとクセになる味、というところだった。"

#. Occurrence 8_6:1125:11261: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0001; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:1125
msgctxt "text_id=11261 | speaker=soujuurou"
msgid "\"So, I want to ask you something.\""
msgstr "「ひとつ、聞きたいんだけど」"

#. Occurrence 8_6:1143:11262: scene=8_6
#: 8_6:1143
msgctxt "text_id=11262 | speaker=unknown"
msgid "  Soujyuro put down his chopsticks and turned to speak to Alice."
msgstr "　焼きうどんを食べるのを中断して、草十郎は有珠に語りかけた。"

#. Occurrence 8_6:1149:11263: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0002; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:1149
msgctxt "text_id=11263 | speaker=soujuurou"
msgid "\"Be honest with me. Mage or not, Aozaki hasn't actually taken a life yet, has she?\""
msgstr "「実際の話。魔術師の話はともかくとして、蒼崎はまだ誰にも手をだしてないんじゃないか？」"

#. Occurrence 8_6:1190:11264: scene=8_6
#: 8_6:1190
msgctxt "text_id=11264 | speaker=unknown"
msgid "  Alice looked up quietly at the sudden question."
msgstr "　唐突な問いに、有珠は静かに顔を上げた。"

#. Occurrence 8_6:1195:11265: scene=8_6
#: 8_6:1195
msgctxt "text_id=11265 | speaker=unknown"
msgid "  She had been inspecting Soujyuro's meal, but now she looked straight at him."
msgstr "　今まで男料理の観察にうつむいていた有珠の視線が、まっすぐに草十郎と向き合う。"

#. Occurrence 8_6:1236:11266: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0007; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1236
msgctxt "text_id=11266 | speaker=alice"
msgid "\"...That's a rather odd question, Sizuki.\""
msgstr "「……おかしな事を訊くのね、静希君は」"

#. Occurrence 8_6:1255:11267: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0003; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:1255
msgctxt "text_id=11267 | speaker=soujuurou"
msgid "\"I know. I hate to ask you, but it's just not something I feel comfortable asking Aozaki directly. If you don't want to answer, you don't have to.\""
msgstr "「有珠には悪いけど、これは蒼崎本人には訊きようのない事だから。言いたくなければ答えないでくれ」"

#. Occurrence 8_6:1287:11268: scene=8_6
#: 8_6:1287
msgctxt "text_id=11268 | speaker=unknown"
msgid "  Alice didn't respond."
msgstr "　有珠からの返答はない。"

#. Occurrence 8_6:1292:11269: scene=8_6
#: 8_6:1292
msgctxt "text_id=11269 | speaker=unknown"
msgid "  Soujyuro resumed eating, not seeming disappointed."
msgstr "　それを残念に思う事もなく、草十郎は食事を再開した。"

#. Occurrence 8_6:1297:11270: scene=8_6
#: 8_6:1297
msgctxt "text_id=11270 | speaker=unknown"
msgid "  Alice stared blankly at him slurping his noodles."
msgstr "　つるつると麺を食べていく草十郎を、有珠は何の感情もなく眺めている。"

#. Occurrence 8_6:1302:11271: scene=8_6
#: 8_6:1302
msgctxt "text_id=11271 | speaker=unknown"
msgid "  After much hesitation, she replied."
msgstr "　少女は何度か<逡巡|しゅんじゅん>した後、"

#. Occurrence 8_6:1342:11272: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0008; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1342
msgctxt "text_id=11272 | speaker=alice"
msgid "\"No. Just like you said, Aoko hasn't killed anyone yet."
msgstr "「……静希君の言う通り、青子はまだ人を殺した事はないわ。"

#. Occurrence 8_6:1349:11273: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0009; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1349
msgctxt "text_id=11273 | speaker=alice"
msgid "She has been involved in that sort of thing multiple times, though.\""
msgstr "その行為自体は、何回かこなしてはいるけれど」"

#. Occurrence 8_6:1355:11274: scene=8_6
#: 8_6:1355
msgctxt "text_id=11274 | speaker=unknown"
msgid "  Alice's response was slow and measured."
msgstr "　途切れがちに有珠は言う。"

#. Occurrence 8_6:1360:11275: scene=8_6
#: 8_6:1360
msgctxt "text_id=11275 | speaker=unknown"
msgid "  Soujyuro still looked troubled."
msgstr "　それに、草十郎はまた困ったように顔をしかめた。"

#. Occurrence 8_6:1395:11276: scene=8_6
#: 8_6:1395
msgctxt "text_id=11276 | speaker=unknown"
msgid "  But not at the conversation they were having. Rather, he looked apologetic towards Alice."
msgstr "　彼は会話の内容にではなく、有珠に対してすまなそうに顔を曇らせている。"

#. Occurrence 8_6:1400:11277: scene=8_6
#: 8_6:1400
msgctxt "text_id=11277 | speaker=unknown"
msgid "  He'd said she didn't have to answer if she didn't want to."
msgstr "　言いたくなければ、答えなくてよかったのに、と。"

#. Occurrence 8_6:1405:11278: scene=8_6
#: 8_6:1405
msgctxt "text_id=11278 | speaker=unknown"
msgid "  But Alice kept talking despite the face he was making."
msgstr "　そんな草十郎の顔に動じず、有珠は淡々と続けていく。"

#. Occurrence 8_6:1426:11279: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0010; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1426
msgctxt "text_id=11279 | speaker=alice"
msgid "\"That day you saw us in the park was the first time Aoko had ever killed anything. That was just a puppet, though.\""
msgstr "「静希君が見た公園での出来事が、青子にとって初めての殺人行為よ。あいにく相手は人形だったけど」"

#. Occurrence 8_6:1454:11280: scene=8_6
#: 8_6:1454
msgctxt "text_id=11280 | speaker=unknown"
msgid "  Soujyuro silently nodded."
msgstr "　静かに頷く草十郎。"

#. Occurrence 8_6:1459:11281: scene=8_6
#: 8_6:1459
msgctxt "text_id=11281 | speaker=unknown"
msgid "  Alice narrowed her eyes at him suspiciously."
msgstr "　その仕草に、有珠は不審そうに目を細めた。"

#. Occurrence 8_6:1496:11282: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0011; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1496
msgctxt "text_id=11282 | speaker=alice"
msgid "\"It almost seems like you knew all of this from the beginning.\""
msgstr "「まるで、はじめから分かっていた素振りね」"

#. Occurrence 8_6:1515:11283: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0004; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:1515
msgctxt "text_id=11283 | speaker=soujuurou"
msgid "\"No, not... well, maybe?"
msgstr "「そうじゃな……いや、そうなのかな。"

#. Occurrence 8_6:1521:11284: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0005; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:1521
msgctxt "text_id=11284 | speaker=soujuurou"
msgid "  She just says stuff like that sometimes, but it's never felt like she's ever actually killed anyone before."
msgstr "　たまにその手の台詞を言うけど、何か違う気がしたんだ。……だからたぶん、蒼崎はまだ人殺しというのを体験していないんじゃないかって。"

#. Occurrence 8_6:1527:11285: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0006; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:1527
msgctxt "text_id=11285 | speaker=soujuurou"
msgid "  But more than that, I guess the best evidence is...\""
msgstr "　でもまあ、そんな事よりもっと確かなのは」"

#. Occurrence 8_6:1552:11286: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0012; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1552
msgctxt "text_id=11286 | speaker=alice"
msgid "\"The fact that you're still alive?\""
msgstr "「静希君が、いま生きているという事ね」"

#. Occurrence 8_6:1571:11287: scene=8_6
#: 8_6:1571
msgctxt "text_id=11287 | speaker=unknown"
msgid "  Soujyuro chuckled at Alice's stellar response."
msgstr "　ご名答、とばかりに草十郎は苦笑した。"

#. Occurrence 8_6:1621:11288: scene=8_6
#: 8_6:1621
msgctxt "text_id=11288 | speaker=unknown"
msgid "  Exactly."
msgstr "　……そう。"

#. Occurrence 8_6:1626:11289: scene=8_6
#: 8_6:1626
msgctxt "text_id=11289 | speaker=unknown"
msgid "  Things would have been more clear-cut that night if Aoko had actually killed someone before."
msgstr "　あの夜、もし彼女がそういった<手応|てごた>えを知っていたのなら、あんな回りくどい事にはならなかった。"

#. Occurrence 8_6:1631:11290: scene=8_6
#: 8_6:1631
msgctxt "text_id=11290 | speaker=unknown"
msgid "  Soujyuro would have been dead before he ever even saw her face."
msgstr "　草十郎は青子の顔を見る事なく殺されていただろう。"

#. Occurrence 8_6:1636:11291: scene=8_6
#: 8_6:1636
msgctxt "text_id=11291 | speaker=unknown"
msgid "  For better or for worse, Aoko remained inexperienced in spite of her ruthlessness and decisiveness."
msgstr "　幸か不幸か、あれだけの非情さと行動力を持っていながら、蒼崎青子はいまだ<そ|・><の|・><感|・><覚|・>を知らないのだ。"

#. Occurrence 8_6:1669:11292: scene=8_6
#: 8_6:1669
msgctxt "text_id=11292 | speaker=unknown"
msgid "  Soujyuro relaxed his shoulders."
msgstr "　ホッと肩を下ろす草十郎。"

#. Occurrence 8_6:1674:11293: scene=8_6
#: 8_6:1674
msgctxt "text_id=11293 | speaker=unknown"
msgid "  His stern face gradually returned to its normal carefree state."
msgstr "　今まで苦々しかった表情も、いつも通りのぼんやりとしたものに戻る。"

#. Occurrence 8_6:1679:11294: scene=8_6
#: 8_6:1679
msgctxt "text_id=11294 | speaker=unknown"
msgid "  Then..."
msgstr "　そこへ、"

#. Occurrence 8_6:1721:11295: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0013; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1721
msgctxt "text_id=11295 | speaker=alice"
msgid "\"...But even so, none of that really matters."
msgstr "「―――でも、そんな事は関係ないわ。"

#. Occurrence 8_6:1727:11296: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0014; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1727
msgctxt "text_id=11296 | speaker=alice"
msgid "  That's just the way she is. She acts with reason and uses her knowledge to make up for any inexperience she might have."
msgstr "　あの子はそのあたりが異常だから。行為は理性に、経験は知識でたやすく補ってしまう。"

#. Occurrence 8_6:1753:11297: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0015; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1753
msgctxt "text_id=11297 | speaker=alice"
msgid "  Sizuki, I think if she really felt like it, she could take another person's life, as you put it.\""
msgstr "　……そうね。青子はその気になれば、迷う事なく<他人|ひと>の命に手をだせる。静希君ふうに言うのなら、だけど」"

#. Occurrence 8_6:1773:11298: scene=8_6
#: 8_6:1773
msgctxt "text_id=11298 | speaker=unknown"
msgid "  And with that, Alice went back to twirling noodles around her fork."
msgstr "　それだけ言って、有珠はまたフォークで麺をコネコネする。"

#. Occurrence 8_6:1791:11299: scene=8_6
#: 8_6:1791
msgctxt "text_id=11299 | speaker=unknown"
msgid "  She looks like she's having fun, Soujyuro thought as he ruminated over what she'd just said."
msgstr "　……もしかして楽しくてやっているのだろうか、などと思いながら、草十郎は有珠の言葉を<反芻|はんすう>していた。"

#. Occurrence 8_6:1816:11300: scene=8_6
#: 8_6:1816
msgctxt "text_id=11300 | speaker=unknown"
msgid "  She was rational enough to accept herself despite acting against society's morals,"
msgstr "　道徳を犯す自分を容認できる理性と、"

#. Occurrence 8_6:1821:11301: scene=8_6
#: 8_6:1821
msgctxt "text_id=11301 | speaker=unknown"
msgid "  and possessed of an intellect that exceeded even the confidence gained through experience."
msgstr "　実経験から得られる確信を超える知性。"

#. Occurrence 8_6:1826:11302: scene=8_6
#: 8_6:1826
msgctxt "text_id=11302 | speaker=unknown"
msgid "  Had Aoko been raised to utilize her logic and reason to forge reality from fiction?"
msgstr "　そんな理屈だけの絵空事を実現できるように、青子は育てられてきたのだろうか。"

#. Occurrence 8_6:1843:11303: scene=8_6
#: 8_6:1843
msgctxt "text_id=11303 | speaker=unknown"
msgid "  If that was the case, then perhaps they really were different from Soujyuro."
msgstr "　それなら、確かに―――彼女たちが自分と違うのは、納得のいく事ではあるが。"

#. Occurrence 8_6:1864:11304: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0007; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:1864
msgctxt "text_id=11304 | speaker=soujuurou"
msgid "\"...I'm sorry. Can you please not tell Aozaki that I asked you this?\""
msgstr "「……すまない。こんなことを訊いたのは、蒼崎には内緒にしておいてくれないか？」"

#. Occurrence 8_6:1882:11305: scene=8_6
#: 8_6:1882
msgctxt "text_id=11305 | speaker=unknown"
msgid "  Soujyuro seemed serious, as if he really regretted asking."
msgstr "　反省するような、思い詰めた顔。"

#. Occurrence 8_6:1903:11306: scene=8_6
#: 8_6:1903
msgctxt "text_id=11306 | speaker=unknown"
msgid "  Alice's expression remained unchanged, but she had never intended on saying anything to Aoko anyway."
msgstr "　有珠の表情に変化はないが、彼女も初めからそのつもりだったようだ。"

#. Occurrence 8_6:1937:11307: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0008; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:1937
msgctxt "text_id=11307 | speaker=soujuurou"
msgid "\"Thank you. I'm not sure why, but I seem to have a lot of secret conversations with you.\""
msgstr "「ありがとう。なんだか、有珠には内緒話ばかりたまっていくね」"

#. Occurrence 8_6:1974:11308: scene=8_6
#: 8_6:1974
msgctxt "text_id=11308 | speaker=unknown"
msgid "  Soujyuro went back to eating his food."
msgstr "　草十郎は食事を再開する。"

#. Occurrence 8_6:1992:11309: scene=8_6
#: 8_6:1992
msgctxt "text_id=11309 | speaker=unknown"
msgid "  Though Alice had still only had a single bite, he was already scraping his clean."
msgstr "　まだ有珠は一口しか食べていないのに、彼はそれでたいらげてしまっていた。"

#. Occurrence 8_6:2013:11310: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0009; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2013
msgctxt "text_id=11310 | speaker=soujuurou"
msgid "\"I already asked Aozaki this, but do the two of you always get along like that?\""
msgstr "「そういえば蒼崎にも訊いたんだけど、有珠と蒼崎はいつもああなのか？」"

#. Occurrence 8_6:2038:11311: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0016; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2038
msgctxt "text_id=11311 | speaker=alice"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 8_6:2043:11312: scene=8_6
#: 8_6:2043
msgctxt "text_id=11312 | speaker=unknown"
msgid "  Soujyuro had suddenly decided to change the topic of conversation."
msgstr "　先ほどまでの会話など何処へやら、草十郎はまったく違う話をはじめた。"

#. Occurrence 8_6:2048:11313: scene=8_6
#: 8_6:2048
msgctxt "text_id=11313 | speaker=unknown"
msgid "  His new topic was the rather cold and dry relationship between Aoko and Alice."
msgstr "　どこかドライな青子と有珠の関係。"

#. Occurrence 8_6:2053:11314: scene=8_6
#: 8_6:2053
msgctxt "text_id=11314 | speaker=unknown"
msgid "  Aoko said their relationship was normal, but maybe Alice had a different opinion."
msgstr "　青子はそれが普通だと語っていたが、有珠からならまた別の見解があるかもしれない。"

#. Occurrence 8_6:2081:11315: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0017; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2081
msgctxt "text_id=11315 | speaker=alice"
msgid "\"...If you're talking about how we rarely talk to each other, that's just what happens."
msgstr "「……会話が少ない事を言っているのなら、そうなるわ。"

#. Occurrence 8_6:2087:11316: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0018; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2087
msgctxt "text_id=11316 | speaker=alice"
msgid "  It's convenient. It isn't something that bothers us.\""
msgstr "　けど、別に不便じゃないから」"

#. Occurrence 8_6:2093:11317: scene=8_6
#: 8_6:2093
msgctxt "text_id=11317 | speaker=unknown"
msgid "  Alice was still twirling noodles with her fork as she gave her concise answer."
msgstr "　簡潔に答えて、有珠はフォークで麺をくるくると巻いている。"

#. Occurrence 8_6:2098:11318: scene=8_6
#: 8_6:2098
msgctxt "text_id=11318 | speaker=unknown"
msgid "  Around and around the noodles went, but none made it into her mouth."
msgstr "　巻いてはいるけど、食べるそぶりはまったくなかった。"

#. Occurrence 8_6:2139:11319: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0010; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2139
msgctxt "text_id=11319 | speaker=soujuurou"
msgid "\"What do you mean, 'It's convenient'? Do you mean that you're friends?\""
msgstr "「不便じゃないって……そういうの、仲がいいって言わないんじゃないか？」"

#. Occurrence 8_6:2145:11320: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0019; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2145
msgctxt "text_id=11320 | speaker=alice"
msgid "\"...Would it make things difficult for you if we didn't get along?\""
msgstr "「……？　わたしと青子の仲が良くないと、静希君は困るの？」"

#. Occurrence 8_6:2183:11321: scene=8_6
#: 8_6:2183
msgctxt "text_id=11321 | speaker=unknown"
msgid "  Soujyuro swallowed his words at Alice's perplexed reply."
msgstr "　不思議そうに言う有珠に、草十郎は言葉を呑んでしまった。"

#. Occurrence 8_6:2188:11322: scene=8_6
#: 8_6:2188
msgctxt "text_id=11322 | speaker=unknown"
msgid "  It would, actually, but he wasn't sure how to respond when asked so directly."
msgstr "　実はかなり困るのだけど、そんな風に素直に聞かれると答えにも困る。"

#. Occurrence 8_6:2222:11323: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0011; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2222
msgctxt "text_id=11323 | speaker=soujuurou"
msgid "\"...No, maybe I was just thinking about it the wrong way."
msgstr "「……いや、なんかこっちの考え方が悪かったみたいだ。"

#. Occurrence 8_6:2222:11324: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0011; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2222
msgctxt "text_id=11324 | speaker=soujuurou"
msgid "  I promise I won't bring it up again, so just forget I asked."
msgstr "　もうその話題には触れない事にしたから忘れてくれ。"

#. Occurrence 8_6:2233:11325: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0012; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2233
msgctxt "text_id=11325 | speaker=soujuurou"
msgid "  More importantly, Alice...\""
msgstr "　それより、有珠」"

#. Occurrence 8_6:2253:11326: scene=8_6
#: 8_6:2253
msgctxt "text_id=11326 | speaker=unknown"
msgid "  Soujyuro gave Alice a piercing stare that was more intense than any time they'd talked before."
msgstr "　今までのどんな時よりも真剣な、<射|い><貫|ぬ>くような視線で草十郎は有珠を見る。"

#. Occurrence 8_6:2279:11327: scene=8_6
#: 8_6:2279
msgctxt "text_id=11327 | speaker=unknown"
msgid "  Alice was taken slightly aback at the unusually intense look in his eyes."
msgstr "　彼には似合わない、強い視線を前にして有珠は少し体を引いてしまう。"

#. Occurrence 8_6:2345:11328: scene=8_6
#: 8_6:2345
msgctxt "text_id=11328 | speaker=unknown"
msgid "  Her face became slightly flushed out of nervousness."
msgstr "　かすかな緊張が有珠の頬を紅潮させる。"

#. Occurrence 8_6:2350:11329: scene=8_6
#: 8_6:2350
msgctxt "text_id=11329 | speaker=unknown"
msgid "  Nobody besides Aoko had ever stared at her like this before."
msgstr "　他人にここまで強く見つめられる事なんて、青子以外なかったからだ。"

#. Occurrence 8_6:2393:11330: scene=8_6
#: 8_6:2393
msgctxt "text_id=11330 | speaker=unknown"
msgid "  Whether or not he noticed, Soujyuro waited a few moments before speaking slowly and with complete conviction."
msgstr "　有珠の緊張を知ってか知らずか、草十郎はしばらく黙ってから、ゆっくりと、偽りのない気持ちを口にした。"

#. Occurrence 8_6:2417:11331: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0013; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2417
msgctxt "text_id=11331 | speaker=soujuurou"
msgid "\"If you're not going to eat that, do you mind if I have it?\""
msgstr "「それ、食べないなら欲しいんだけど」"

#. Occurrence 8_6:2527:11332: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0020; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2527
msgctxt "text_id=11332 | speaker=alice"
msgid "\"...\""
msgstr "「……………………」"

#. Occurrence 8_6:2532:11333: scene=8_6
#: 8_6:2532
msgctxt "text_id=11333 | speaker=unknown"
msgid "  An awkward silence followed."
msgstr "　どこか気まずい沈黙が流れる。"

#. Occurrence 8_6:2558:11334: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0021; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2558
msgctxt "text_id=11334 | speaker=alice"
msgid "\"Sorry, this is mine.\""
msgstr "「悪いけど。これ、わたしのだから」"

#. Occurrence 8_6:2564:11335: scene=8_6
#: 8_6:2564
msgctxt "text_id=11335 | speaker=unknown"
msgid "  Sizuki had cooked it, sure, but Alice wasn't wrong. He had made it for her after all."
msgstr "　作ったのは静希君だけど、とにかくそういうコトだから、と有珠は切り捨てる。"

#. Occurrence 8_6:2569:11336: scene=8_6
#: 8_6:2569
msgctxt "text_id=11336 | speaker=unknown"
msgid "  There was a slight tinge of anger in her voice, but even she wasn't sure why it was there."
msgstr "　多少、自分でもよく分からない怒気をこめて。"

#. Occurrence 8_6:2605:11337: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0014; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2605
msgctxt "text_id=11337 | speaker=soujuurou"
msgid "\"You're right. Sorry, I shouldn't have asked.\""
msgstr "「そうだね。少し意地汚かった」"

#. Occurrence 8_6:2612:11338: scene=8_6
#: 8_6:2612
msgctxt "text_id=11338 | speaker=unknown"
msgid "  Soujyuro plopped himself down on the sofa."
msgstr "　すとん、とソファーに戻る草十郎。"

#. Occurrence 8_6:2617:11339: scene=8_6
#: 8_6:2617
msgctxt "text_id=11339 | speaker=unknown"
msgid "  This must have looked particularly pathetic to Alice since she responded with,"
msgstr "　その仕草があまりにも哀れだったからか。"

#. Occurrence 8_6:2624:11340: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0022; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2624
msgctxt "text_id=11340 | speaker=alice"
msgid "\"Umm, are there any ingredients left to cook some more?\""
msgstr "「……その、材料はもう残ってないの？」"

#. Occurrence 8_6:2648:11341: scene=8_6
#: 8_6:2648
msgctxt "text_id=11341 | speaker=unknown"
msgid "  She quickly covered her mouth. Apparently she had surprised even herself."
msgstr "　つい口にして、あわてて有珠は口を<塞|ふさ>いだ。"

#. Occurrence 8_6:2653:11342: scene=8_6
#: 8_6:2653
msgctxt "text_id=11342 | speaker=unknown"
msgid "  It was quite unusual for her to ask something like that."
msgstr "　そんな事を訊くなんて、まったく彼女らしくない。"

#. Occurrence 8_6:2674:11343: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0015; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2674
msgctxt "text_id=11343 | speaker=soujuurou"
msgid "\"Nope. I used everything and made some for Aozaki as well.\""
msgstr "「残ってないよ。蒼崎の分も作っちゃったから」"

#. Occurrence 8_6:2680:11344: scene=8_6
#: 8_6:2680
msgctxt "text_id=11344 | speaker=unknown"
msgid "  Soujyuro stared a bit regretfully at Alice's plate as he responded."
msgstr "　まだ未練があるのか、有珠のお皿を見ながら草十郎は答える。"

#. Occurrence 8_6:2685:11345: scene=8_6
#: 8_6:2685
msgctxt "text_id=11345 | speaker=unknown"
msgid "  Alice could have just let it go, but for some reason she felt the need to speak up again."
msgstr "　その言葉も有珠的に無視できなかったのか、よせばいいのに、彼女は再度声をかけてしまった。"

#. Occurrence 8_6:2711:11346: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0023; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2711
msgctxt "text_id=11346 | speaker=alice"
msgid "\"...But Aoko is still sleeping.\""
msgstr "「……青子なら、眠っているけど」"

#. Occurrence 8_6:2733:11347: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0016; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2733
msgctxt "text_id=11347 | speaker=soujuurou"
msgid "\"Yeah, but I'm gonna wake her up soon, and she'd have told me to make her something anyway."
msgstr "「いや、もうすぐ起こすから。起きた後で作らされるより、一緒に作っておいた方が楽だしね。"

#. Occurrence 8_6:2744:11348: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0017; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2744
msgctxt "text_id=11348 | speaker=soujuurou"
msgid "  ...Speaking of which, it's almost one o'clock. I'll go and wake her up now.\""
msgstr "　……と、もうすぐ一時か。ちょうどいい、行って起こしてくるよ」"

#. Occurrence 8_6:2797:11349: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0024; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2797
msgctxt "text_id=11349 | speaker=alice"
msgid "\"Didn't she say she'd kill you if you woke her up?\""
msgstr "「青子は、起こしたら殺すって言ってたけど」"

#. Occurrence 8_6:2802:11350: scene=8_6
#: 8_6:2802
msgctxt "text_id=11350 | speaker=unknown"
msgid "  Alice wasn't sure why Soujyuro was willing to take such a risk."
msgstr "　なんでそんな事をするのか疑問、と有珠は首を傾げる。"

#. Occurrence 8_6:2807:11351: scene=8_6
#: 8_6:2807
msgctxt "text_id=11351 | speaker=unknown"
msgid "  Soujyuro agreed, but started walking anyway."
msgstr "　まったくだ、と同意しながらも草十郎は歩きだす。"

#. Occurrence 8_6:2847:11352: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0018; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2847
msgctxt "text_id=11352 | speaker=soujuurou"
msgid "\"Maybe so, but I feel like if I don't wake her up now, she's going to end up killing me later anyway.\""
msgstr "「でもさ。いま起こしておかないと、やっぱり後で殺される運命にあると思うんだ」"

#. Occurrence 8_6:2853:11353: scene=8_6
#: 8_6:2853
msgctxt "text_id=11353 | speaker=unknown"
msgid "  His words were surprisingly affectionate."
msgstr "　悪態なのに、親愛に満ちた言葉。"

#. Occurrence 8_6:2863:11354: scene=8_6
#: 8_6:2863
msgctxt "text_id=11354 | speaker=unknown"
msgid "  Leaving Alice with only that, Soujyuro headed to Aoko's room."
msgstr "　同情に値する言葉を残して、草十郎は青子の部屋へと向かっていった。"

#. Occurrence 8_6:2905:11355: scene=8_6
#: 8_6:2905
msgctxt "text_id=11355 | speaker=unknown"
msgid "  Alice watched him leave in silence before taking another bite of the stir-fried noodles."
msgstr "　それを無言で見送ってから、有珠はあんかけ焼きうどんを一口食べてみる。"

#. Occurrence 8_6:2924:11356: scene=8_6
#: 8_6:2924
msgctxt "text_id=11356 | speaker=unknown"
msgid "  Glancing at the door to the hallway to make sure nobody was coming, she took another bite."
msgstr "　ちらりと廊下への扉に目をやって、誰も来そうにない事を確認すると、さらに一口。"

#. Occurrence 8_6:2942:11357: scene=8_6
#: 8_6:2942
msgctxt "text_id=11357 | speaker=unknown"
msgid "  She repeated that process many times before finishing her food. It was then that she heard Aoko's wrath coming from the second floor."
msgstr "　そんな事を何回も繰り返すうちにクリーム色のお皿は空になって、二階から青子の怒鳴り声が聞こえた気がした。"

#. Occurrence 8_6:2962:11358: scene=8_6
#: 8_6:2962
msgctxt "text_id=11358 | speaker=unknown"
msgid "  Alice stood up and began solemnly clearing the table, feeling a bit sorry for what Soujyuro was dealing with."
msgstr "　それに少しだけ同情して、厳かな仕草で、有珠は自分と草十郎の食器を片付けはじめた。"

#. Occurrence 8_6:2978:11359: scene=8_6
#: 8_6:2978
msgctxt "text_id=11359 | speaker=unknown"
msgid "  She knew she didn't really have to, but she felt like it was the least she could do for him."
msgstr "　そんな気はなかったけれど、これぐらいはしてあげないといけない、と思ったらしい。"

#. Occurrence 8_6:2999:11360: scene=8_6
#: 8_6:2999
msgctxt "text_id=11360 | speaker=unknown"
msgid "  ...She'd never really expected to feel this way."
msgstr "　……不覚にも。"

#. Occurrence 8_6:3013:11361: scene=8_6
#: 8_6:3013
msgctxt "text_id=11361 | speaker=unknown"
msgid "  But he'd cooked for her, and it was surprisingly good. Almost enough to make her forget how bad he was at making tea."
msgstr "　はじめて食べた彼の手料理は、紅茶の不出来な淹れ方を忘れさせるほどには、まあ、悪くはない味だったのだから。"

#. Occurrence 8_EX:80:11362: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0000; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:80
msgctxt "text_id=11362 | speaker=kojika"
msgid "\"Hi. Kumari from Class 2-D."
msgstr "「失礼します。２－Ｄの<久万梨|くまり>です。"

#. Occurrence 8_EX:86:11363: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0001; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:86
msgctxt "text_id=11363 | speaker=kojika"
msgid "  I returned the key to the gym's storage to the faculty room.\""
msgstr "　体育館倉庫の鍵、職員室に返してきました」"

#. Occurrence 8_EX:92:11364: scene=8_EX
#: 8_EX:92
msgctxt "text_id=11364 | speaker=unknown"
msgid "  Only Aoko was present in the second student council room when Kojika Kumari entered."
msgstr "　<久万梨|くまり><金鹿|こじか>が第二生徒会室に入ると、室内にいるのは蒼崎青子だけだった。"

#. Occurrence 8_EX:127:11365: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0000; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:127
msgctxt "text_id=11365 | speaker=aoko"
msgid "\"Oh, thank you."
msgstr "「おつかれ。"

#. Occurrence 8_EX:127:11366: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0000; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:127
msgctxt "text_id=11366 | speaker=aoko"
msgid "  I'm almost done with this, so just have a seat there.\""
msgstr "　もうちょっとでバイト終わるから、そこ座ってて」"

#. Occurrence 8_EX:133:11367: scene=8_EX
#: 8_EX:133
msgctxt "text_id=11367 | speaker=unknown"
msgid "  Aoko was seated at a long table, surrounded by a pile of textbooks and using her pen to write rapidly."
msgstr "　青子は長テーブルに陣取って、大量の教科書に囲まれながら、スラスラとリズムよくボールペンを走らせていた。"

#. Occurrence 8_EX:138:11368: scene=8_EX
#: 8_EX:138
msgctxt "text_id=11368 | speaker=unknown"
msgid "  Strewn about the table were not school-specified notebooks, but rather papers for writing reports."
msgstr "　机上にあるのは学校指定のノートではなく、こじゃれたレポート用紙である。"

#. Occurrence 8_EX:170:11369: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0002; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:170
msgctxt "text_id=11369 | speaker=kojika"
msgid "\"What are you working on? Homework? Review questions?"
msgstr "「なにしてんの蒼崎。課題？　それとも補習？"

#. Occurrence 8_EX:176:11370: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0003; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:176
msgctxt "text_id=11370 | speaker=kojika"
msgid "  Looks pretty intense, whatever it is. Winter vacation just started! I mean, we have this special winter cleaning thing to do too, I guess.\""
msgstr "　どっちにしても真面目なこと。冬休み、始まったばかりなのに。そりゃあ、こんなところで特別清掃なんかに付き合わされているけどさ」"

#. Occurrence 8_EX:195:11371: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0001; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:195
msgctxt "text_id=11371 | speaker=aoko"
msgid "\"Mm, this is separate from all that. A university student I know gave me some work as a ghostwriter."
msgstr "「んー、これは別件。知り合いの大学生から流してもらった代筆のバイト。"

#. Occurrence 8_EX:202:11372: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0002; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:202
msgctxt "text_id=11372 | speaker=aoko"
msgid "They want me to copy this old report from a few years ago verbatim for their graduate thesis.\""
msgstr "何年も前に提出されたレポートを丸写しにして、卒論クリアしようって話」"

#. Occurrence 8_EX:235:11373: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0004; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:235
msgctxt "text_id=11373 | speaker=kojika"
msgid "\"Tch, they've got you copying a whole book, it looks like!"
msgstr "「チッ、写本ならぬ写レポートかよ。結構な量だなオイ。"

#. Occurrence 8_EX:241:11374: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0005; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:241
msgctxt "text_id=11374 | speaker=kojika"
msgid "  What university do they go to? Not Mizora, is it?\""
msgstr "　それ、どこの大学生？　まさか<渠裸|みぞら>大じゃないでしょうね」"

#. Occurrence 8_EX:262:11375: scene=8_EX
#: 8_EX:262
msgctxt "text_id=11375 | speaker=unknown"
msgid "  Kumari couldn't seem to hide her discomfort as she started thumbing through some of the reports next to Aoko."
msgstr "　不快さを隠しもせず、久万梨は青子の傍らにあるレポートをめくっていく。"

#. Occurrence 8_EX:267:11376: scene=8_EX
#: 8_EX:267
msgctxt "text_id=11376 | speaker=unknown"
msgid "  The slightly brown-tinged reports had to be at least ten years old."
msgstr "　やや茶色に変色したレポート用紙は、少なく見積もっても十年は前の物だ。"

#. Occurrence 8_EX:304:11377: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0003; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:304
msgctxt "text_id=11377 | speaker=aoko"
msgid "\"Of course they go to Mizora. I don't know students from any other university."
msgstr "「そのまさかよ。知り合いの大学生なんてミゾラ以外にいるかっていうの。"

#. Occurrence 8_EX:310:11378: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0004; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:310
msgctxt "text_id=11378 | speaker=aoko"
msgid "  Don't worry, Kuma, it's not from your brother and his crew. Aren't they all planning to stay back another year again this year anyway?\""
msgstr "　安心なさい、クマの兄貴たちからの仕事じゃないから。そもそもアンタの兄貴軍団、今年も<留年|のこ>る気満々なんでしょ？」"

#. Occurrence 8_EX:316:11379: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0006; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:316
msgctxt "text_id=11379 | speaker=kojika"
msgid "\"Can you stop calling me that? And please stop referring to them as a crew?\""
msgstr "「クマ言わないで。軍団もやめろ」"

#. Occurrence 8_EX:336:11380: scene=8_EX
#: 8_EX:336
msgctxt "text_id=11380 | speaker=unknown"
msgid "  Her voice was snappy."
msgstr "　久万梨の声は刺々しい。"

#. Occurrence 8_EX:341:11381: scene=8_EX
#: 8_EX:341
msgctxt "text_id=11381 | speaker=unknown"
msgid "  Not that Aoko could judge, but this girl's unfriendliness could rival even her own at times."
msgstr "　いつも不機嫌な青子が言える事ではないが、この女生徒も青子に負けず劣らずの愛想の無さである。"

#. Occurrence 8_EX:346:11382: scene=8_EX
#: 8_EX:346
msgctxt "text_id=11382 | speaker=unknown"
msgid "  Kumari's speech was dry enough as it was, but when she got riled up about something she really let it all out."
msgstr "　平時は素っ気ない口調の久万梨は、本音がむき出しになると乱暴な口調になる。"

#. Occurrence 8_EX:351:11383: scene=8_EX
#: 8_EX:351
msgctxt "text_id=11383 | speaker=unknown"
msgid "  Apparently she got it from her father. She was trying to work on it, but it was hard to fix an old habit she had since elementary school."
msgstr "　どうも父親<譲|ゆず>りの癖らしい。本人はその癖を改善しようと努めているが、小学生までの習慣は中々抜けない。"

#. Occurrence 8_EX:402:11384: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0007; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:402
msgctxt "text_id=11384 | speaker=kojika"
msgid "\"Is this even going to work with a report that old, though? Don't you think they'll notice?\""
msgstr "「けどこれ、どうなのよ。丸写しにしても古すぎて通らないんじゃない？」"

#. Occurrence 8_EX:425:11385: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0005; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:425
msgctxt "text_id=11385 | speaker=aoko"
msgid "\"Well, it's better than nothing, isn't it?"
msgstr "「そこはそれ、腐っても鯛というか。"

#. Occurrence 8_EX:431:11386: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0006; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:431
msgctxt "text_id=11386 | speaker=aoko"
msgid "  They told me they marked all the out of date data and that I just need to change those numbers by looking at the textbooks.\""
msgstr "“技術的に古い部分はピックアップしてあるから、<教科書|テキスト>参考にして数字だけ変えておいて”だってさ」"

#. Occurrence 8_EX:468:11387: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0008; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:468
msgctxt "text_id=11387 | speaker=kojika"
msgid "\"That's dumb. If they did all that, they could just change it themselves! How long have you been working on this?\""
msgstr "「なにそれ、ホントにバカじゃないの？　そこまで分かってるなら自分でやればいいのに。で、いつからやってるの」"

#. Occurrence 8_EX:492:11388: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0007; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:492
msgctxt "text_id=11388 | speaker=aoko"
msgid "\"Since this morning. It's really not bad money for a half day's work."
msgstr "「今日の朝から。半日の稼ぎにしちゃあ悪くないわよ。"

#. Occurrence 8_EX:492:11389: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0007; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:492
msgctxt "text_id=11389 | speaker=aoko"
msgid "  They're paying me 10,000 yen per report.\""
msgstr "　レポート一冊分で一万円」"

#. Occurrence 8_EX:516:11390: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0009; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:516
msgctxt "text_id=11390 | speaker=kojika"
msgid "\"I can't believe the student council president actually has a side hustle like this."
msgstr "「ケッ、生徒会長が内職かよ。"

#. Occurrence 8_EX:516:11391: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0009; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:516
msgctxt "text_id=11391 | speaker=kojika"
msgid "  No wonder you left Tsukiji in charge.\""
msgstr "　どうりで槻司に監督を任せたワケだ」"

#. Occurrence 8_EX:539:11392: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0008; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:539
msgctxt "text_id=11392 | speaker=aoko"
msgid "\"Right. Let's just keep this between us, shall we?\""
msgstr "「はい。他言は無用でお願いします」"

#. Occurrence 8_EX:574:11393: scene=8_EX
#: 8_EX:574
msgctxt "text_id=11393 | speaker=unknown"
msgid "  Kumari relaxed a bit at Aoko's pleasant response and decided to sit down in the nearest chair."
msgstr "　爽やかな笑顔で返されて毒気を抜かれたのか、久万梨はぶすっとした顔のままパイプ椅子に腰を掛けた。"

#. Occurrence 8_EX:594:11394: scene=8_EX
#: 8_EX:594
msgctxt "text_id=11394 | speaker=unknown"
msgid "  The room was silent save for the sound of the scratching of Aoko's ballpoint pen."
msgstr "　生徒会室にはボールペンの音だけ。"

#. Occurrence 8_EX:613:11395: scene=8_EX
#: 8_EX:613
msgctxt "text_id=11395 | speaker=unknown"
msgid "  The sky was clear blue and there were boys in the rear courtyard playing baseball in their jerseys."
msgstr "　ふと見上げた空は青く高く、裏庭にはジャージ姿で野球をしている男子たちの姿があった。"

#. Occurrence 8_EX:618:11396: scene=8_EX
#: 8_EX:618
msgctxt "text_id=11396 | speaker=unknown"
msgid "  With the special winter cleaning finished, it seemed they'd decided to start enjoying their free time."
msgstr "　特別清掃も終わり、なし崩し的に遊び始めたらしい。"

#. Occurrence 8_EX:624:11397: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0010; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:624
msgctxt "text_id=11397 | speaker=kojika"
msgid "\"I don't know how they can stand it out there in the cold like that."
msgstr "「この寒いのによくもまあ。"

#. Occurrence 8_EX:630:11398: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0011; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:630
msgctxt "text_id=11398 | speaker=kojika"
msgid "  ...Wait, those're the second-year boys.\""
msgstr "　―――って、アレ二年の男どもだ」"

#. Occurrence 8_EX:650:11399: scene=8_EX
#: 8_EX:650
msgctxt "text_id=11399 | speaker=unknown"
msgid "  Said boys were playing in teams of five since they apparently could not get enough people together to play a proper game."
msgstr "　十分な人数が集まらなかったのか、彼らは五人一チームで試合をしている。"

#. Occurrence 8_EX:655:11400: scene=8_EX
#: 8_EX:655
msgctxt "text_id=11400 | speaker=unknown"
msgid "  It was a boring game of mostly strikeouts and poor hits, but they sure seemed to be having fun."
msgstr "　凡打、三振の多いグダグダな試合内容だが、当人たちはたいへん盛り上がっているようだ。"

#. Occurrence 8_EX:660:11401: scene=8_EX
#: 8_EX:660
msgctxt "text_id=11401 | speaker=unknown"
msgid "  Their yelling and hollering mostly consisted of bad words, surprised yells, and cackling laughter."
msgstr "　聞こえてくる喚声は口汚いものばかりだが、罵声をあびせながらもみな笑っているあたり、ホントに男子はバカばっかりだ。"

#. Occurrence 8_EX:692:11402: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0012; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:692
msgctxt "text_id=11402 | speaker=kojika"
msgid "\"Oh, of course Housuke and Sizuki are together, but Tsukiji looks like he's with them too... Are they friends?\""
msgstr "「あれ。<芳助|ほうすけ>と<静希|しずき>が一緒なのは分かるけど、<槻司|つきじ>も一緒じゃん。蒼崎、あいつら仲いいの？」"

#. Occurrence 8_EX:710:11403: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0009; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:710
msgctxt "text_id=11403 | speaker=aoko"
msgid "\"Huh? Why the heck is he hanging out with the Class C crowd? Well, as long as they're done with their cleanup, they can do whatever they want I guess.\""
msgstr "「はあ？　なんで<Ｃ|よ><組|そ>のクラスの集まりに顔だしてんのよ<鳶|ア><丸|イツ>。……まあ、裏山の清掃が終わってるなら文句はないけど」"

#. Occurrence 8_EX:727:11404: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0013; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:727
msgctxt "text_id=11404 | speaker=kojika"
msgid "\"Wow, I didn't know Tsukiji could pitch.\""
msgstr "「あ、投げた。槻司、ピッチャーできるんだ」"

#. Occurrence 8_EX:748:11405: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0010; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:748
msgctxt "text_id=11405 | speaker=aoko"
msgid "\"He can kind of do it all."
msgstr "「基本、<鳶丸|アイツ>はなんでもできるからねー。"

#. Occurrence 8_EX:754:11406: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0011; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:754
msgctxt "text_id=11406 | speaker=aoko"
msgid "  He's lazy, so he never accomplishes much. He can do just about anything when he puts his mind to it, though. If there's anything he's lacking, it's the ability to just be a kid sometimes.\""
msgstr "　本人さぼり症でめったに動かないけど、本気だせば何だってこなすのよ。唯一足りない才能があるとしたら、子供らしさってヤツでしょうね」"

#. Occurrence 8_EX:772:11407: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0014; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:772
msgctxt "text_id=11407 | speaker=kojika"
msgid "\"Hmph, you seem to know a lot about him."
msgstr "「ふーん。詳しいじゃない。"

#. Occurrence 8_EX:778:11408: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0015; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:778
msgctxt "text_id=11408 | speaker=kojika"
msgid "  ...Are the two of you dating?\""
msgstr "　……蒼崎、槻司と付き合ってるってホント？」"

#. Occurrence 8_EX:811:11409: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0012; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:811
msgctxt "text_id=11409 | speaker=aoko"
msgid "\"Seriously? I'd date you before I dated him. Give me a break."
msgstr "「アイツと付き合うぐらいならアンタと付き合うわ。"

#. Occurrence 8_EX:817:11410: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0013; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:817
msgctxt "text_id=11410 | speaker=aoko"
msgid "  I'm not into the pretty boys. I need a macho man. Like that Austrian.\""
msgstr "　顔の良い男は好きじゃないし。やっぱり男はシュワちゃんぐらいじゃないと」"

#. Occurrence 8_EX:839:11411: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0016; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:839
msgctxt "text_id=11411 | speaker=kojika"
msgid "\"What Austrian?\""
msgstr "「シュワ……誰それ？」"

#. Occurrence 8_EX:845:11412: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0014; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:845
msgctxt "text_id=11412 | speaker=aoko"
msgid "\"You know, the guy that starred in those barbarian movies!\""
msgstr "「グレートの方のコナンの主役やった人」"

#. Occurrence 8_EX:856:11413: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0017; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:856
msgctxt "text_id=11413 | speaker=kojika"
msgid "\"Ohhh, so you like a chiseled jawline? I didn't know you were into the musclehead types!\""
msgstr "「へえ、アゴ割れてないとダメなんだ。蒼崎って面食いかと思ってたけど、ごっつい系が趣味なの？」"

#. Occurrence 8_EX:877:11414: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0015; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:877
msgctxt "text_id=11414 | speaker=aoko"
msgid "\"I mean, not exclusively..."
msgstr "「……別にそういうワケじゃないけど。"

#. Occurrence 8_EX:883:11415: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0016; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:883
msgctxt "text_id=11415 | speaker=aoko"
msgid "  I'm trying to say that you can't trust smooth-talking, carefree guys just because they happen to look attractive.\""
msgstr "　教訓よ、教訓。なよっとしたヤツとか、やけに口がうまいヤツとか、気軽な男はほんと信用ならないっていうか」"

#. Occurrence 8_EX:920:11416: scene=8_EX
#: 8_EX:920
msgctxt "text_id=11416 | speaker=unknown"
msgid "  They continued their conversation..."
msgstr "　青子はレポート用紙を、"

#. Occurrence 8_EX:926:11417: scene=8_EX
#: 8_EX:926
msgctxt "text_id=11417 | speaker=unknown"
msgid "  ...one staring at the report pages and the other gazing out at the schoolyard."
msgstr "　久万梨は校庭を眺めながら、とりとめのない会話をする。"

#. Occurrence 8_EX:931:11418: scene=8_EX
#: 8_EX:931
msgctxt "text_id=11418 | speaker=unknown"
msgid "  They had met in high school and soon grew to be friends who enjoyed chatting together."
msgstr "　ふたりが知り合ったのは高校生になってからだが、根本的なところで気が合うらしく、今ではこうして<駄弁|だべ>りあう仲になっていた。"

#. Occurrence 8_EX:952:11419: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0018; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:952
msgctxt "text_id=11419 | speaker=kojika"
msgid "\"So what are your plans over the winter vacation? Wanna do something?\""
msgstr "「蒼崎、冬休みはどうする？　予定、ある？」"

#. Occurrence 8_EX:958:11420: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0017; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:958
msgctxt "text_id=11420 | speaker=aoko"
msgid "\"Hmm... I want to, but I'm going to be so busy. How about around the start of the new year?"
msgstr "「うーん、一回ぐらいは遊びに行きたいんだけど、ちょい忙しくて。年明けに時間つくるから、それまで待って。"

#. Occurrence 8_EX:964:11421: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0018; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:964
msgctxt "text_id=11421 | speaker=aoko"
msgid "  Should we invite Yamase and those other girls from Class B? I think they went up to Tokyo last winter vacation.\""
msgstr "　あ、Ｂ組の山瀬さんたち誘う？　たしか去年も冬休みに上京してたでしょ、彼女ら」"

#. Occurrence 8_EX:985:11422: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0019; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:985
msgctxt "text_id=11422 | speaker=kojika"
msgid "\"They aren't really our style, are they? They'd freak if they found out what kind of stuff you're into! I wouldn't bother with them.\""
msgstr "「あー、ありゃわたしたちと系統が違う。生粋のお嬢さまだからねぇ。蒼崎の趣味知ったらドン引きされるから、やめといた方がいい」"

#. Occurrence 8_EX:1013:11423: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0020; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1013
msgctxt "text_id=11423 | speaker=kojika"
msgid "\"Uh oh, Tsukiji allowed a hit."
msgstr "「あ、打たれた。"

#. Occurrence 8_EX:1020:11424: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0021; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1020
msgctxt "text_id=11424 | speaker=kojika"
msgid "Wow, it went over the fence."
msgstr "あ、<柵|さく>越えた。"

#. Occurrence 8_EX:1027:11425: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0022; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1027
msgctxt "text_id=11425 | speaker=kojika"
msgid "Nice home run, Sizuki. He's more athletic than I thought if he managed to hit a home run off of Tsukiji like that.\""
msgstr "あれってホームランってヤツだ。やるじゃん静希。槻司から一本とるなんて、運動神経<抜群|ばつぐん>ね」"

#. Occurrence 8_EX:1048:11426: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0019; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1048
msgctxt "text_id=11426 | speaker=aoko"
msgid "\"He grew up in the mountains. He's gotta be at least a little strong."
msgstr "「そりゃ山育ちだし、それぐらい取り柄がないと。"

#. Occurrence 8_EX:1054:11427: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0020; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1054
msgctxt "text_id=11427 | speaker=aoko"
msgid "  He might beat Tobimaru for the top spot in next year's fitness check. It's a piece of cake for someone out in the mountains to walk for two hours straight. He should've been on the track team instead of swimming.\""
msgstr "　来年の身体測定、鳶丸とトップ争うんじゃない？　山じゃ二時間歩きっぱなしとかザラだったそうだし。水泳部じゃなく陸上部に紹介すればよかった」"

#. Occurrence 8_EX:1060:11428: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0023; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1060
msgctxt "text_id=11428 | speaker=kojika"
msgid "\"Wow, you know a lot about him too. Maybe *he's* the one you're dating? ...Nah, can't be.\""
msgstr "「ふーん。詳しいのね。もしかして付き合ってるのあっちとか。あ、いや、さすがにないかー」"

#. Occurrence 8_EX:1091:11429: scene=8_EX
#: 8_EX:1091
msgctxt "text_id=11429 | speaker=unknown"
msgid "  The constant sound of Aoko's ballpoint pen moving across paper suddenly stopped."
msgstr "　よどみのなかったボールペンの音が止まる。"

#. Occurrence 8_EX:1108:11430: scene=8_EX
#: 8_EX:1108
msgctxt "text_id=11430 | speaker=unknown"
msgid "  She stood up naturally from her seat,"
msgstr "　青子はごく自然な仕草で席を立ち、"

msgctxt "text_id=11431 | speaker=unknown"
msgid " took a quick break to pour some fresh tea,"
msgstr "小休止といわんばかりにお茶を淹れて、"

msgctxt "text_id=11432 | speaker=unknown"
msgid " and returned to her work without acknowledging what had been said."
msgstr "何事もなかったように作業に戻った。"

#. Occurrence 8_EX:1144:11433: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0021; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1144
msgctxt "text_id=11433 | speaker=aoko"
msgid "\"Is there anything in particular you want to do over the winter break?\""
msgstr "「冬休みの予定だけど。久万梨、何かリクエストある？」"

#. Occurrence 8_EX:1162:11434: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0024; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1162
msgctxt "text_id=11434 | speaker=kojika"
msgid "\"Not really. There are a lot of movies I've been wanting to see though. I'd love to run through all the ones that don't get shown here. What about you?\""
msgstr "「別に。見たい映画がたまってるだけ。<三咲|こっち>じゃ上映しない映画をハシゴしたい。蒼崎は？」"

#. Occurrence 8_EX:1180:11435: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0022; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1180
msgctxt "text_id=11435 | speaker=aoko"
msgid "\"I'm thinking of getting some winter clothes or a CD... I'd need a CD player first, though. Should be able to get one for under 30,000 yen soon.\""
msgstr "「私は新しい冬物とＣＤ買えればいいかな。デヴィッドボウイの。あ、その前にまずはＣＤプレーヤーか。そろそろ三万円きるはずなのよ、アレ」"

#. Occurrence 8_EX:1215:11436: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0025; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1215
msgctxt "text_id=11436 | speaker=kojika"
msgid "\"You like all that new stuff, don't you? CDs are just an expensive fad. They won't be around for long, I think."
msgstr "「はあ。新しいもの好きよね、アンタ。ＣＤなんて高いだけで、騒がれてるのは今だけだってば。"

#. Occurrence 8_EX:1221:11437: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0026; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1221
msgctxt "text_id=11437 | speaker=kojika"
msgid "  You can just rent whatever music you want and record it onto a tape for 500 yen! CDs are going the way of Betamax, you'll see.\""
msgstr "　だいたい、音楽なんてレンタルしてカセットテープに落とせば５００円で済むじゃない。ベータデッキみたいにそのうち<廃|すた>れるって」"

#. Occurrence 8_EX:1242:11438: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0023; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1242
msgctxt "text_id=11438 | speaker=aoko"
msgid "\"Really? I think CDs are going to be the new standard. If anything's going the way of Betamax, it's cassette tapes.\""
msgstr "「そう？　私、ＣＤは定番になると思うけどな。過去になるのはカセットテープの方よ、きっと」"

#. Occurrence 8_EX:1248:11439: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0027; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1248
msgctxt "text_id=11439 | speaker=kojika"
msgid "\"No way! I'd bet anything on it! How could CDs ever be better than cassettes when you can't even record to them!\""
msgstr "「それはない。絶対ない。賭けてもいい。だって、ＣＤって録音できないんでしょ？　そんなのにカセットテープが負けるはずない」"

#. Occurrence 8_EX:1278:11440: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0024; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1278
msgctxt "text_id=11440 | speaker=aoko"
msgid "\"You're so conservative, Kuma. Watch out for when that party change happens, 'cause it always does."
msgstr "「クマは保守派だからなー。政権交代は何にだってあるでしょうに。"

#. Occurrence 8_EX:1285:11441: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0025; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1285
msgctxt "text_id=11441 | speaker=aoko"
msgid "But hey, I'll take that bet. I'm going to put it down here in the student council minutes. I look forward to winning ten...no, not even... five years from now!\""
msgstr "でもまあ、その賭け乗った。生徒会の歴史に書いておくからね。十年……いえ、五年後を楽しみにしていましょう」"

#. Occurrence 8_EX:1291:11442: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0028; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1291
msgctxt "text_id=11442 | speaker=kojika"
msgid "\"Five years, huh? Sounds good. We should be finishing up college around then. You're planning on going to college in Tokyo, right? Where are you thinking exactly?\""
msgstr "「五年後か。いいね、ちょうど大学の終わりだ。蒼崎、東京の大学に行くんでしょ？　どこ志望してるのか教えてよ」"

#. Occurrence 8_EX:1312:11443: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0026; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1312
msgctxt "text_id=11443 | speaker=aoko"
msgid "\"I haven't decided yet. I just know I definitely want to be in Tokyo.\""
msgstr "「実はまだ決めてないのよ。上京したいのは山々なんだけど」"

#. Occurrence 8_EX:1318:11444: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0029; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1318
msgctxt "text_id=11444 | speaker=kojika"
msgid "\"I'm surprised! I thought you'd have the next three years of your life completely planned by now.\""
msgstr "「ありゃ意外。アンタのことだから、むこう三年分ぐらいスケジュール組んでると思ったのに」"

#. Occurrence 8_EX:1350:11445: scene=8_EX
#: 8_EX:1350
msgctxt "text_id=11445 | speaker=unknown"
msgid "  Aoko laughed dryly at the obvious jab."
msgstr "　あはは、と青子は苦笑いで誤魔化す。"

#. Occurrence 8_EX:1355:11446: scene=8_EX
#: 8_EX:1355
msgctxt "text_id=11446 | speaker=unknown"
msgid "  Aoko knew what direction she wanted her life to go in, but she didn't usually think too much about the details."
msgstr "　生き方の方針は決まっているものの、将来の展望はいまいち考えていない青子だった。"

#. Occurrence 8_EX:1360:11447: scene=8_EX
#: 8_EX:1360
msgctxt "text_id=11447 | speaker=unknown"
msgid "  Once she made a decision, she followed through with it. That was why she didn't actually write out a schedule."
msgstr "　やると決めた事はやる性格のため、いちいちスケジュールを紙に起こす習慣がないせいもある。"

#. Occurrence 8_EX:1388:11448: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0027; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1388
msgctxt "text_id=11448 | speaker=aoko"
msgid "\"Anyway, come grab some food with me at that ramen shop in front of the station when I'm done with this."
msgstr "「クマ、終わったら駅前のラーメン屋付き合ってよ。"

#. Occurrence 8_EX:1388:11449: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0027; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1388
msgctxt "text_id=11449 | speaker=aoko"
msgid "  I'm getting hungry from all this work.\""
msgstr "　体力つかったから、なんかお腹減ってきた」"

#. Occurrence 8_EX:1407:11450: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0030; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1407
msgctxt "text_id=11450 | speaker=kojika"
msgid "\"I feel like most girls would want something sweet after doing all that work, but okay."
msgstr "「……そこは、頭つかったから甘いもの食べたくなった、にしといた方が女らしいと思うけどね。"

#. Occurrence 8_EX:1418:11451: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0031; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1418
msgctxt "text_id=11451 | speaker=kojika"
msgid "  I'm interested. If you come to my place, you can eat for free though. What do you say?\""
msgstr "　いいよ。うちでいいならサービスしとくけど、よってく？」"

#. Occurrence 8_EX:1436:11452: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0028; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1436
msgctxt "text_id=11452 | speaker=aoko"
msgid "\"Of course! Everyone needs a good girl friend like you!\""
msgstr "「もっちろん！　持つべきものは女の友情！」"

#. Occurrence 8_EX:1470:11453: scene=8_EX
#: 8_EX:1470
msgctxt "text_id=11453 | speaker=unknown"
msgid "  The girls waited patiently for winter vacation to start in the student council room."
msgstr "　冬休みを間近に控えた生徒会室。"

#. Occurrence 8_EX:1475:11454: scene=8_EX
#: 8_EX:1475
msgctxt "text_id=11454 | speaker=unknown"
msgid "  Their free time after school was spent through this kind of frivolous conversation."
msgstr "　ふたりは他愛のない会話で放課後を消費していく。"

#. Occurrence 8_EX:1480:11455: scene=8_EX
#: 8_EX:1480
msgctxt "text_id=11455 | speaker=unknown"
msgid "  Aoko spent her nights as a mage and her days as a normal high school student. The conversations she had with her friends were no different from any other girls her age."
msgstr "　夜は魔術師として歩く青子も、昼間はいたってノーマルな学生だ。友人と話すときは年相応の無邪気さを隠しもしない。"

#. Occurrence 8_EX:1485:11456: scene=8_EX
#: 8_EX:1485
msgctxt "text_id=11456 | speaker=unknown"
msgid "  She enjoyed both aspects of her life equally, even if one of those involved fighting against mortal enemies."
msgstr "　たとえ敵との戦いが本格化していようと、二足のわらじを履くと決めた以上、どちらも楽しむのが青子である。"

#. Occurrence 8_EX:1519:11457: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0032; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1519
msgctxt "text_id=11457 | speaker=kojika"
msgid "\"So, Aozaki. How much are we going to wager on that bet earlier?\""
msgstr "「ところで蒼崎。さっきの賭け金はどうする？」"

#. Occurrence 8_EX:1532:11458: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0029; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1532
msgctxt "text_id=11458 | speaker=aoko"
msgid "\"I'm not completely evil, so I'll just take ten percent of whatever savings you have at the time. I don't want to clean you out, after all.\""
msgstr "「そうね。私も鬼じゃないし、その時の貯金一割で手を打つわ。根こそぎ奪うのは勘弁してあげる」"

#. Occurrence 8_EX:1538:11459: scene=8_EX
#: 8_EX:1538
msgctxt "text_id=11459 | speaker=unknown"
msgid "  She wasn't lying."
msgstr "　もっとも。"

#. Occurrence 8_EX:1543:11460: scene=8_EX
#: 8_EX:1543
msgctxt "text_id=11460 | speaker=unknown"
msgid "  But fundamentally she was still an imp at heart."
msgstr "　この通り、根本的な意地の悪さは変わらないのだが。"

#. Occurrence 8_EX:1604:11461: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0000; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:1604
msgctxt "text_id=11461 | speaker=soujuurou"
msgid "\"I just got a bad feeling all of a sudden.\""
msgstr "「なんかゾワッときたな、今」"

#. Occurrence 8_EX:1610:11462: scene=8_EX
#: 8_EX:1610
msgctxt "text_id=11462 | speaker=unknown"
msgid "  Victim A whispered quietly after sneezing."
msgstr "　くしゅん、と気の抜けたクシャミをして、被害者Ａはそう呟いた。"

#. Occurrence 8_EX:1647:11463: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0000; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:1647
msgctxt "text_id=11463 | speaker=kinomi"
msgid "\"You catch a cold or something, Sizuki?"
msgstr "「なんだよ、風邪でもひいたかー静希？"

#. Occurrence 8_EX:1658:11464: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0001; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:1658
msgctxt "text_id=11464 | speaker=kinomi"
msgid "  Let's wrap up this game and head into town. Whaddya say?\""
msgstr "　よし、んじゃこんなとこで野球やっててもしょうがねえし！　町にくりだすとしましょうか！」"

#. Occurrence 8_EX:1693:11465: scene=8_EX
#: 8_EX:1693
msgctxt "text_id=11465 | speaker=unknown"
msgid "  This was their fourth game of five-man baseball."
msgstr "　五人野球、四試合目。"

#. Occurrence 8_EX:1698:11466: scene=8_EX
#: 8_EX:1698
msgctxt "text_id=11466 | speaker=unknown"
msgid "  They'd gained some spectators since starting an hour ago, and were playing special rules where infield grounders were called out when caught, and home runs were rewarded with leftover sweet red-bean soup cans."
msgstr "　内野ゴロはキャッチされた時点でアウト、ホームランには余ったお汁粉缶をプレゼント、という特殊ルールを聞きつけて野次馬が集まりだし、リーグ戦が始まってから既に一時間。"

#. Occurrence 8_EX:1703:11467: scene=8_EX
#: 8_EX:1703
msgctxt "text_id=11467 | speaker=unknown"
msgid "  Housuke Kinomi had gotten bored once he realized it was still going to be a while until it was his turn to play."
msgstr "　自分たちの試合がまだ先であるコトに痺れを切らした木乃美芳助は、早くも飽きはじめていた。"

#. Occurrence 8_EX:1734:11468: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0000; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:1734
msgctxt "text_id=11468 | speaker=tobimaru"
msgid "\"Seriously? You're the one who came up with the stupid idea of playing baseball in the first place!\""
msgstr "「おまえホント猿だったんだな。先立つものがねえから野球やろうぜって言いだしたのはテメエだろうが」"

#. Occurrence 8_EX:1752:11469: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0002; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:1752
msgctxt "text_id=11469 | speaker=kinomi"
msgid "\"That was then, this is now!"
msgstr "「えー。それはそれ、これはこれっしょ。"

#. Occurrence 8_EX:1758:11470: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0003; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:1758
msgctxt "text_id=11470 | speaker=kinomi"
msgid "  All these losers from Class A showed up, and I hate 'em. Can't get along with 'em at all.\""
msgstr "　だってＡ組の奴らとか集まってきたしさあ、オレ、あいつら嫌いだしさあ。なんかノリが合わないっていうか」"

#. Occurrence 8_EX:1791:11471: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0001; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:1791
msgctxt "text_id=11471 | speaker=tobimaru"
msgid "\"Don't worry, I don't think they like you either."
msgstr "「安心しろ、<Ａ組|あっち>もテメエとは合わねえとよ。"

#. Occurrence 8_EX:1797:11472: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0002; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:1797
msgctxt "text_id=11472 | speaker=tobimaru"
msgid "  But hey, this will be a good chance to show them up. I'll actually try to play for real if you will.\""
msgstr "　いい機会じゃねえか、気にくわないんなら試合で片づけてやれよ。こっちも本気でやってやるから」"

#. Occurrence 8_EX:1817:11473: scene=8_EX
#: 8_EX:1817
msgctxt "text_id=11473 | speaker=unknown"
msgid "  Tobimaru calmly punched back down at Kinomi while practicing his pitching at the wall."
msgstr "　鳶丸は壁に向かってピッチングなどしながら木乃美をたしなめる。"

#. Occurrence 8_EX:1822:11474: scene=8_EX
#: 8_EX:1822
msgctxt "text_id=11474 | speaker=unknown"
msgid "  He was throwing harder than usual. Maybe he was angry because of that home run he gave up earlier."
msgstr "　先ほどホームランを打たれてご立腹なのか、普段より当たりがきつい。"

#. Occurrence 8_EX:1827:11475: scene=8_EX
#: 8_EX:1827
msgctxt "text_id=11475 | speaker=unknown"
msgid "  He was in Class A and had taken on the role of captain for the other boys from Class A who showed up to play."
msgstr "　ちなみに、彼もＡ組の生徒であり、集まってきたＡ組男子のキャプテンに収まっている。"

#. Occurrence 8_EX:1858:11476: voice_id=D50_8_EX_0000; voice_prefix=D50; voice_category=0; scene=8_EX
#: 8_EX:1858
msgctxt "text_id=11476 | speaker=unknown"
msgid "\"Hold on. That's not entirely true."
msgstr "「ちょっと待った、そりゃ誤解だぜ殿下。"

#. Occurrence 8_EX:1864:11477: voice_id=D50_8_EX_0001; voice_prefix=D50; voice_category=0; scene=8_EX
#: 8_EX:1864
msgctxt "text_id=11477 | speaker=unknown"
msgid "  We actually kind of like Kinomi."
msgstr "　オレたち木乃美けっこう好きよ？"

#. Occurrence 8_EX:1871:11478: voice_id=D50_8_EX_0002; voice_prefix=D50; voice_category=0; scene=8_EX
#: 8_EX:1871
msgctxt "text_id=11478 | speaker=unknown"
msgid "  We like how much of a spaz he is, how he'll openly rate girls on how hot they are, how he's always planning matchmaking parties... There's nobody else like him!\""
msgstr "　バカなところとか、平気で女連中の品評会ひらくところとか、合コン企画するところとか。真似できねーよ、ホント」"

#. Occurrence 8_EX:1877:11479: scene=8_EX
#: 8_EX:1877
msgctxt "text_id=11479 | speaker=unknown"
msgid "  All the other boys in Class A nodded affirmatively."
msgstr "　うんうん、と力強くうなずくＡ組男子一同。"

#. Occurrence 8_EX:1903:11480: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0004; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:1903
msgctxt "text_id=11480 | speaker=kinomi"
msgid "\"Really? Don't act like you're all about fun and games like that without telling the whole truth!"
msgstr "「ざけんな、テメエらいつも美味しいところだけ持っていきやがって！"

#. Occurrence 8_EX:1910:11481: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0005; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:1910
msgctxt "text_id=11481 | speaker=kinomi"
msgid "'You should host a karaoke party.' 'Oh, get together some cute girls so we can all hang out together.'"
msgstr "“カラオケ会ひらいてよー”“女の子と遊びたいよー”、"

msgctxt "text_id=11482 | speaker=unknown"
msgid "  And then what happens? You all leave me to pay the bill! And when we went to go check out the girls in the tennis club, who caught all the heat for it? Me! You think I can't tell when I'm being used?\""
msgstr "　なんて甘えてきやがって、なんで気が付いたらオレ一人だけで会計してたの？　一緒にテニス部のぞきに行ったのにどうしてオレだけ悪者なの？　もしかして利用されてるだけってそろそろ気が付いていいの？」"

#. Occurrence 8_EX:1947:11483: voice_id=D60_8_EX_0000; voice_prefix=D60; voice_category=0; scene=8_EX
#: 8_EX:1947
msgctxt "text_id=11483 | speaker=unknown"
msgid "\"What? You only figured that out now? Haha!\""
msgstr "「やべ、まだ気付いてなかった！　本物だ！」"

#. Occurrence 8_EX:1953:11484: voice_id=D70_8_EX_0000; voice_prefix=D70; voice_category=0; scene=8_EX
#: 8_EX:1953
msgctxt "text_id=11484 | speaker=unknown"
msgid "\"Sorry Kinomi, but thanks to you I finally got a girlfriend! She always tells me, 'It could be worse, I could be dating Kinomi!"
msgstr "「ごめん、木乃美のおかげで僕にも彼女ができました！　彼女の口癖は“木乃美クンよりマシよ"

#. Occurrence 8_EX:1953:11485: voice_id=D70_8_EX_0000; voice_prefix=D70; voice_category=0; scene=8_EX
#: 8_EX:1953
msgctxt "text_id=11485 | speaker=unknown"
msgid "'\""
msgstr "”です！」"

#. Occurrence 8_EX:1981:11486: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0006; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:1981
msgctxt "text_id=11486 | speaker=kinomi"
msgid "\"Ugh! You guys are so lame!"
msgstr "「があー！　テメエら本気でむかつく！"

#. Occurrence 8_EX:1981:11487: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0006; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:1981
msgctxt "text_id=11487 | speaker=kinomi"
msgid "  I don't need to know about that kinda shit!\""
msgstr "　青くせぇ学生生活おくってんじゃねえ！」"

#. Occurrence 8_EX:2005:11488: scene=8_EX
#: 8_EX:2005
msgctxt "text_id=11488 | speaker=unknown"
msgid "  Kinomi took his bat and swung it around as he chased after the boys in Class A. They seemed to be having fun running from him while sarcastically thanking him."
msgstr "　木乃美はバットを振り回してＡ組男子を追い回し、Ａ組男子たちは陽気に逃げ回りながら木乃美に感謝する。"

#. Occurrence 8_EX:2010:11489: scene=8_EX
#: 8_EX:2010
msgctxt "text_id=11489 | speaker=unknown"
msgid "  One of Kinomi's best virtues was his ability to remain good-natured in the face of insults."
msgstr "　基本、<罵|ののし>りあいなのに<和気|わき><藹々|あいあい>としているのは、木乃美芳助の人徳のなせる業だ。"

#. Occurrence 8_EX:2046:11490: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0001; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:2046
msgctxt "text_id=11490 | speaker=soujuurou"
msgid "\"Hahaha! You're as popular as ever, Kinomi!\""
msgstr "「ははは。木乃美は人気者だなあ」"

#. Occurrence 8_EX:2052:11491: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0003; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2052
msgctxt "text_id=11491 | speaker=tobimaru"
msgid "\"It's a good thing he's dumb. If he was clever, he'd probably end up as some kind of criminal."
msgstr "「ああ、バカなのが救いだな。あれで下手に<利口|りこう>だったら犯罪者になってるところだ。"

#. Occurrence 8_EX:2058:11492: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0004; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2058
msgctxt "text_id=11492 | speaker=tobimaru"
msgid "  After all that's happened though, he'd probably end up on the wrong end of Aozaki's fists. She doesn't have time to deal with someone like that!\""
msgstr "　いや、その前に今度こそ蒼崎にしめられるか。あいつ、小ずるいチンピラには容赦ねえからな」"

#. Occurrence 8_EX:2078:11493: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0002; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:2078
msgctxt "text_id=11493 | speaker=soujuurou"
msgid "\"You think so? ...Hm? All that's happened?\""
msgstr "「そうなのか。―――ん？　今度こそ？」"

#. Occurrence 8_EX:2098:11494: scene=8_EX
#: 8_EX:2098
msgctxt "text_id=11494 | speaker=unknown"
msgid "  Soujyuro fell deep into thought."
msgstr "　む、と考えこむ草十郎。"

#. Occurrence 8_EX:2103:11495: scene=8_EX
#: 8_EX:2103
msgctxt "text_id=11495 | speaker=unknown"
msgid "  From the way that sounded, Kinomi seemed to have some kind of history with Aoko Aozaki."
msgstr "　今の言いぶりだと、木乃美に蒼崎青子に関して、なにやら前科があるようだ。"

#. Occurrence 8_EX:2144:11496: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0003; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:2144
msgctxt "text_id=11496 | speaker=soujuurou"
msgid "\"Have Kinomi and Aozaki ever been an 'item'?\""
msgstr "「木乃美は蒼崎に、その、ケソウ、してた事があるのか？」"

#. Occurrence 8_EX:2155:11497: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0005; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2155
msgctxt "text_id=11497 | speaker=tobimaru"
msgid "\"An item? You mean a couple?"
msgstr "「あん、ケソウ？　ああ、懸想か。"

#. Occurrence 8_EX:2166:11498: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0006; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2166
msgctxt "text_id=11498 | speaker=tobimaru"
msgid "  You really think that idiot would have standards? There was a little incident between the two, but nothing more than that."
msgstr "　あのバカにそんな風情があるかって。ちょいとな、蒼崎と木乃美には条件反射じみた事件があったんだよ。"

#. Occurrence 8_EX:2172:11499: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0007; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2172
msgctxt "text_id=11499 | speaker=tobimaru"
msgid "  Back at the school entrance ceremony. Right, Kinomi?\""
msgstr "　ありゃあ入学式の事だ。そうだよな、木乃美！」"

#. Occurrence 8_EX:2177:11500: scene=8_EX
#: 8_EX:2177
msgctxt "text_id=11500 | speaker=unknown"
msgid "  Kinomi froze and glanced back at Tobimaru's provocation."
msgstr "　鳶丸に怒鳴られ、木乃美は足を止めて振り返る。"

#. Occurrence 8_EX:2218:11501: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0007; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2218
msgctxt "text_id=11501 | speaker=kinomi"
msgid "\"Oh yeah, duh! I just remember seeing this chick with a smoking bod, and before I knew it I was reaching out to touch her!"
msgstr "「おう、入学式な！　すげー<身体|からだ>してる女子がいたからさあ、つい声をかけたんだよな！」"

#. Occurrence 8_EX:2224:11502: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0008; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2224
msgctxt "text_id=11502 | speaker=kinomi"
msgid "  I was like, 'Hey, so what class are you in, girl?'"
msgstr "“かーのじょ、どの<組|クラス>ぅ？”って。"

#. Occurrence 8_EX:2235:11503: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0009; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2235
msgctxt "text_id=11503 | speaker=kinomi"
msgid "  I didn't really mean to touch her like that though."
msgstr "　いや、でもまさか、手が出るとは思わなかった。"

#. Occurrence 8_EX:2241:11504: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0010; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2241
msgctxt "text_id=11504 | speaker=kinomi"
msgid "  I really tried to stop myself, but I think my brain had a major malfunction, and my hand just went for it!\""
msgstr "　オレ的には一センチ前で<寸止|すんど>めしようとしたんだけど、目測をあやまった。オレの視覚情報より、蒼崎の肉体のサイズがやや<勝|まさ>っていたというコトさね」"

#. Occurrence 8_EX:2280:11505: scene=8_EX
#: 8_EX:2280
msgctxt "text_id=11505 | speaker=unknown"
msgid "  Kinomi laughed loudly as he gazed up at the sky."
msgstr "　はっはっは、と遠い目で空を見上げる木乃美芳助。"

#. Occurrence 8_EX:2290:11506: scene=8_EX
#: 8_EX:2290
msgctxt "text_id=11506 | speaker=unknown"
msgid "  That was all the explanation Soujyuro needed to know what really happened that day at the entrance ceremony."
msgstr "　草十郎は草十郎で、今の言葉だけで入学式に何が起きたのか、正確に把握したらしい。"

#. Occurrence 8_EX:2316:11507: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0004; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:2316
msgctxt "text_id=11507 | speaker=soujuurou"
msgid "\"...You idiot."
msgstr "「―――バカな。"

#. Occurrence 8_EX:2323:11508: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0005; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:2323
msgctxt "text_id=11508 | speaker=soujuurou"
msgid "How are you even still alive after that?\""
msgstr "なぜ命がある、木乃美」"

#. Occurrence 8_EX:2358:11509: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0011; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2358
msgctxt "text_id=11509 | speaker=kinomi"
msgid "\"I know, right?! I thought she knocked my jaw clean off!"
msgstr "「だろー？　オレのアゴ、垂直に跳ね上がったんだぜ!?"

#. Occurrence 8_EX:2392:11510: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0012; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2392
msgctxt "text_id=11510 | speaker=kinomi"
msgid "  It wasn't just a slap or a fist, you know? People were sayin' that it was like her foot was one of those swimboards if you dunk 'em deep in the water, shooting up to my chin like BAM!"
msgstr "　平手とか拳とかそういうレベルじゃねえの、下からギャーンだぜギャーン！　周りにいたギャラリーいわく、“プールで縦に沈めたビート板が浮上するように蒼崎の靴が閃いた”らしい。"

#. Occurrence 8_EX:2423:11511: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0013; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2423
msgctxt "text_id=11511 | speaker=kinomi"
msgid "  ...I can tell you this now, but I don't have the slightest memory of anything that happened after that!\""
msgstr "　…………あの、今だから言いますけど、オレ、あの後の記憶がすっぽりないのです」"

#. Occurrence 8_EX:2449:11512: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0006; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:2449
msgctxt "text_id=11512 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 8_EX:2456:11513: scene=8_EX
#: 8_EX:2456
msgctxt "text_id=11513 | speaker=unknown"
msgid "  Rubbing his jaw, Kinomi returned to their side, tired of wasting his energy chasing after the Class A boys."
msgstr "　Ａ組男子を追い回すのも疲れたのか、木乃美はアゴをさすりながら戻ってきた。"

#. Occurrence 8_EX:2496:11514: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0014; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2496
msgctxt "text_id=11514 | speaker=kinomi"
msgid "\"Anyway, enough of all that talk. Let's go do something fun!"
msgstr "「そんなコトより遊びにいこうぜー。"

#. Occurrence 8_EX:2496:11515: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0014; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2496
msgctxt "text_id=11515 | speaker=kinomi"
msgid "  You can pay, Your Highness! I know you're loaded. \""
msgstr "　殿下、金持ってるだろー。おごってくれよー」"

#. Occurrence 8_EX:2507:11516: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0008; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2507
msgctxt "text_id=11516 | speaker=tobimaru"
msgid "\"Well, I suppose I could manage a movie or something."
msgstr "「……ったく。まあ、映画なら考えない事もない。"

#. Occurrence 8_EX:2513:11517: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0009; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2513
msgctxt "text_id=11517 | speaker=tobimaru"
msgid "  There's this B-movie I really wanna see. It's one of those that's more fun to heckle than watch, but it should be fun."
msgstr "　ちょうど見たい映画あんだよ。映画の内容より、見終わった後に文句言い合う方が楽しい部類のＢ級でな。"

#. Occurrence 8_EX:2519:11518: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0010; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2519
msgctxt "text_id=11518 | speaker=tobimaru"
msgid "  But for that I need an unsuspecting victim to watch it with me. I guess for that you'll do just fine!\""
msgstr "　犠牲者が必要なんで、この際テメエでもいいぞ」"

#. Occurrence 8_EX:2545:11519: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0015; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2545
msgctxt "text_id=11519 | speaker=kinomi"
msgid "\"Ugh, no way! Movies are so boring! You really think I want to just sit still and be quiet for two hours?"
msgstr "「やだー、映画とかつまんねえよ！　大の男がさあ、二時間も同じところ座ってられねえって！"

#. Occurrence 8_EX:2551:11520: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0016; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2551
msgctxt "text_id=11520 | speaker=kinomi"
msgid "  I'd rather go to an arcade. Hell, I'd take being a mall rat and just hang around eating or whatever.\""
msgstr "　そんなんだったらゲーセンか、コンビニの駐車場で駄菓子食ってる方が楽しいって！」"

#. Occurrence 8_EX:2562:11521: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0011; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2562
msgctxt "text_id=11521 | speaker=tobimaru"
msgid "\"...What's the difference between that and what we're doing right now?\""
msgstr "「……おまえ、それ今の状況と何が違うんだ？」"

#. Occurrence 8_EX:2588:11522: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0017; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2588
msgctxt "text_id=11522 | speaker=kinomi"
msgid "\"Come on! It's fun to go out somewhere just to hang out!"
msgstr "「いいんだよ、外で<駄弁|だべ>ってれば楽しいんだって！"

#. Occurrence 8_EX:2599:11523: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0018; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2599
msgctxt "text_id=11523 | speaker=kinomi"
msgid "  Or, we could start a band! British rock is really hot right now. A friend at my part-time job said anybody can play punk rock.\""
msgstr "　あ、それともバンドでもやるか。いまＵＫロックが熱い。バイト先の先輩にパンクロックなら誰でもできるときいた」"

#. Occurrence 8_EX:2610:11524: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0012; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2610
msgctxt "text_id=11524 | speaker=tobimaru"
msgid "\"Oh, is that so? Make sure it's not just some fad.\""
msgstr "「ああそうかよ。ファッションにならねえようにな」"

#. Occurrence 8_EX:2630:11525: scene=8_EX
#: 8_EX:2630
msgctxt "text_id=11525 | speaker=unknown"
msgid "  This was the rear courtyard during winter vacation."
msgstr "　冬休みの裏庭。"

#. Occurrence 8_EX:2635:11526: scene=8_EX
#: 8_EX:2635
msgctxt "text_id=11526 | speaker=unknown"
msgid "  Kinomi and Tobimaru spent their relaxing reprieve chattering away about nothing of much substance."
msgstr "　のんびりとした労働後のひとときを、木乃美と鳶丸はどうでもいい話題で消費していく。"

#. Occurrence 8_EX:2674:11527: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0019; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2674
msgctxt "text_id=11527 | speaker=kinomi"
msgid "\"Let's go pick up girls in front of the station, then! I bet we can get some hot older chicks too with you around."
msgstr "「じゃあナンパ。駅前でナンパしようぜ！　殿下がいれば年上のお姉さんも釣れるし。"

#. Occurrence 8_EX:2681:11528: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0020; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2681
msgctxt "text_id=11528 | speaker=kinomi"
msgid "And hey, if we're short on cash, we can get some nice ladies to spend some money on us for a change!\""
msgstr "そうだ。お金がないなら、レディたちにおごってもらえばいいんじゃない？」"

#. Occurrence 8_EX:2687:11529: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0013; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2687
msgctxt "text_id=11529 | speaker=tobimaru"
msgid "\"You really want to go out with a woman for their money at your age? You make my head hurt sometimes.\""
msgstr "「その歳でヒモか。テメエの人生設計、明るすぎて頭痛がするぜ」"

#. Occurrence 8_EX:2722:11530: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0021; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2722
msgctxt "text_id=11530 | speaker=kinomi"
msgid "\"Come on, I know what I want out of life!"
msgstr "「うん、オレ将来の展望だけはできてるからね！"

#. Occurrence 8_EX:2728:11531: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0022; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2728
msgctxt "text_id=11531 | speaker=kinomi"
msgid "  And I know deep down you wanna go pick up girls and have some fun with them too. Right, Sizuki?"
msgstr "　なあ静希、おまえからも言ってやれよー。ナンパに行こうって、女の子たちと楽しく騒ごうって！"

#. Occurrence 8_EX:2734:11532: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0023; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2734
msgctxt "text_id=11532 | speaker=kinomi"
msgid "  You can be a cute younger brother type to older women. Your Highness can just stand around."
msgstr "　殿下は立ってるだけでいいし、静希だって年上のお姉さんから見たら弟属性っていうの？"

#. Occurrence 8_EX:2740:11533: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0024; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2740
msgctxt "text_id=11533 | speaker=kinomi"
msgid "  If all goes well, in just an hour or so we'll be having a magical winter love affair with some cute girls, like that one time, remember?!\""
msgstr "　うまくいけば、こう―――オレの時みたいに、一時間後にはひと冬の、アヴァン、チュゥゥゥル」"

#. Occurrence 8_EX:2769:11534: scene=8_EX
#: 8_EX:2769
msgctxt "text_id=11534 | speaker=unknown"
msgid "  Kinomi's hands were flailing around in excitement, dancing around like so many waving tentacles."
msgstr "　木乃美の両手が、彼の腕からは独立した一つの触手生命のように活動する。わきわきと。"

#. Occurrence 8_EX:2774:11535: scene=8_EX
#: 8_EX:2774
msgctxt "text_id=11535 | speaker=unknown"
msgid "  His mind was apparently still swimming in the memories of a golden time he had once had."
msgstr "　かつて体験した黄金時間の残像が、彼の脳髄を侵しているらしい。"

#. Occurrence 8_EX:2779:11536: scene=8_EX
#: 8_EX:2779
msgctxt "text_id=11536 | speaker=unknown"
msgid "  Anyway..."
msgstr "　それはともかく、"

#. Occurrence 8_EX:2815:11537: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0007; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:2815
msgctxt "text_id=11537 | speaker=soujuurou"
msgid "\"Kinomi. What did you say that time?\""
msgstr "「木乃美。その時、なんて言ったんだ？」"

#. Occurrence 8_EX:2826:11538: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0025; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2826
msgctxt "text_id=11538 | speaker=kinomi"
msgid "\"Huh? Oh, you mean my surefire pickup line?"
msgstr "「へ？　ああ、そん時の決め台詞ね。"

#. Occurrence 8_EX:2832:11539: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0026; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2832
msgctxt "text_id=11539 | speaker=kinomi"
msgid "  I was like, 'Wow. You're beautiful! My dad actually owns that building over there. Do you wanna hang out and do something?'"
msgstr "“お姉さんキレイっすね、オレ、そこのビルのオーナーの息子なんすけどちょっと遊んでいきません？”って。"

#. Occurrence 8_EX:2838:11540: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0027; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2838
msgctxt "text_id=11540 | speaker=kinomi"
msgid "  She ended up running off when she found out I was lying, though!\""
msgstr "　嘘だってバレたら逃げられたけどな！」"

#. Occurrence 8_EX:2864:11541: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0008; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:2864
msgctxt "text_id=11541 | speaker=soujuurou"
msgid "\"I'm not talking about that. I meant at the entrance ceremony.\""
msgstr "「そうじゃなくて、入学式」"

#. Occurrence 8_EX:2875:11542: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0028; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2875
msgctxt "text_id=11542 | speaker=kinomi"
msgid "\"Oh, that!"
msgstr "「ああそっちか。"

#. Occurrence 8_EX:2881:11543: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0029; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2881
msgctxt "text_id=11543 | speaker=kinomi"
msgid "  Well, I looked Aozaki up and down and I said,"
msgstr "　えーと、蒼崎の首から下の部分に向かって、"

#. Occurrence 8_EX:2892:11544: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0030; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2892
msgctxt "text_id=11544 | speaker=kinomi"
msgid "'Wow, your knockers are HUGE!"
msgstr "“うはっ、おまえ胸でかくねー？"

#. Occurrence 8_EX:2892:11545: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0030; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2892
msgctxt "text_id=11545 | speaker=kinomi"
msgid "'\""
msgstr "”」"

#. Occurrence 8_EX:2917:11546: scene=8_EX
#: 8_EX:2917
msgctxt "text_id=11546 | speaker=unknown"
msgid "  He let out a loud guffaw as he recalled his story. His lack of intelligence and propriety was truly remarkable."
msgstr "　だったかなぁあははは！　などと言いながら、<蛮勇|バカ>・木乃美芳助は頭を<欠|か>いている。"

#. Occurrence 8_EX:2923:11547: scene=8_EX
#: 8_EX:2923
msgctxt "text_id=11547 | speaker=unknown"
msgid "Or rather, mind-boggling."
msgstr "もとい、<掻|か>いている。"

#. Occurrence 8_EX:2928:11548: scene=8_EX
#: 8_EX:2928
msgctxt "text_id=11548 | speaker=unknown"
msgid "  Nonetheless, Kinomi was now in high spirits after recalling this exciting memory."
msgstr "　かつての思い出に鼓舞されたのか、木乃美はひたすら陽気だ。"

#. Occurrence 8_EX:2938:11549: scene=8_EX
#: 8_EX:2938
msgctxt "text_id=11549 | speaker=unknown"
msgid "  Conversely, Soujyuro was standing in complete sullen silence."
msgstr "　一方、草十郎は苦虫をかみつぶしたかのような、重い沈黙に包まれている。"

#. Occurrence 8_EX:2964:11550: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0031; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2964
msgctxt "text_id=11550 | speaker=kinomi"
msgid "\"Hm? What's wrong, Sizuki?"
msgstr "「うん？　どうした静希？"

#. Occurrence 8_EX:2970:11551: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0032; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2970
msgctxt "text_id=11551 | speaker=kinomi"
msgid "  Not interested in picking up girls?\""
msgstr "　あ、やっぱりナンパとか興味ないか？」"

#. Occurrence 8_EX:2990:11552: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0014; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2990
msgctxt "text_id=11552 | speaker=tobimaru"
msgid "\"Of course he's not! Soujyuro isn't some kind of creepy pervert like you!\""
msgstr "「あったりめえだ。テメエみたいな色ボケと草十郎を一緒にするな」"

#. Occurrence 8_EX:3024:11553: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0009; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:3024
msgctxt "text_id=11553 | speaker=soujuurou"
msgid "\"No. I'm interested, actually."
msgstr "「いや。興味はある。"

#. Occurrence 8_EX:3030:11554: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0010; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:3030
msgctxt "text_id=11554 | speaker=soujuurou"
msgid "  I see girls who I think are cute, and when they're wearing something revealing I find it hard to control where my eyes go, just like anyone else.\""
msgstr "　可愛い女の子は可愛いと思うし、たまに薄着なところに出くわすと目のやり場に困るだろ。ああいう時、自分が男だって事を実感するよな」"

#. Occurrence 8_EX:3079:11555: scene=8_EX
#: 8_EX:3079
msgctxt "text_id=11555 | speaker=unknown"
msgid "  His words shot through the air like a bolt of lightning."
msgstr "　せいてん　の　へきれき　だった。"

#. Occurrence 8_EX:3085:11556: scene=8_EX
#: 8_EX:3085
msgctxt "text_id=11556 | speaker=unknown"
msgid "  It was as shocking as when a kid sees the head of a character at an amusement park fall off, revealing the person inside."
msgstr "　部屋に飾ってあった愛らしいテディベアが、口をあけたら中の人がフィリップ・マーロゥぐらいの衝撃だった。"

#. Occurrence 8_EX:3122:11557: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0033; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:3122
msgctxt "text_id=11557 | speaker=kinomi"
msgid "\"...Yeah!"
msgstr "「―――は！？"

#. Occurrence 8_EX:3128:11558: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0034; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:3128
msgctxt "text_id=11558 | speaker=kinomi"
msgid "  I-I guess you're right! Sorry for thinking otherwise! So you're one of us then, eh Sizuki?\""
msgstr "　そ、そりゃそうだよな！　すまん、見くびっていた。つまり静希も、オレたちの同士ってコトでいいんだな？」"

#. Occurrence 8_EX:3139:11559: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0011; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:3139
msgctxt "text_id=11559 | speaker=soujuurou"
msgid "\"What do you mean by 'one of us?'\""
msgstr "「同士？」"

#. Occurrence 8_EX:3165:11560: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0035; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:3165
msgctxt "text_id=11560 | speaker=kinomi"
msgid "\"You get excited when you see sweat rolling down the nape of a girl's neck in the summer heat, or the cute outfits the girls in the tennis club wear, or when you see a girl in a swimsuit from behind!\""
msgstr "「そうだ。たとえばこう―――夏場の女子のうなじにひかる汗とか、テニス部の女子の肩からワキにかけての清涼感とか、ぶっちゃけ水泳部の競泳水着の後ろ姿だよ！」"

#. Occurrence 8_EX:3191:11561: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0012; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:3191
msgctxt "text_id=11561 | speaker=soujuurou"
msgid "\"...?\""
msgstr "「？？」"

#. Occurrence 8_EX:3196:11562: scene=8_EX
#: 8_EX:3196
msgctxt "text_id=11562 | speaker=unknown"
msgid "  Soujyuro's eyes were filled with question marks."
msgstr "　はてな？　と目をしばたたかせる草十郎。"

#. Occurrence 8_EX:3201:11563: scene=8_EX
#: 8_EX:3201
msgctxt "text_id=11563 | speaker=unknown"
msgid "  Apparently he hadn't quite understood Kinomi's explanation."
msgstr "　木乃美の説明がいまいち実感できていない。"

#. Occurrence 8_EX:3236:11564: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0036; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:3236
msgctxt "text_id=11564 | speaker=kinomi"
msgid "\"Come on, you know! Don't you get worked up when you see a girl our own age do something that makes her look all inviting?\""
msgstr "「いや、だから普段は同い年のガキにしか見えない女どもでも、たまに見せる無防備な仕草とか、ぐっとくるよな？」"

#. Occurrence 8_EX:3260:11565: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0013; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:3260
msgctxt "text_id=11565 | speaker=soujuurou"
msgid "\"Sure, but I'd urge you to reconsider that choice of words.\""
msgstr "「うん。無防備なのは、ちょっと考えてほしい」"

#. Occurrence 8_EX:3277:11566: scene=8_EX
#: 8_EX:3277
msgctxt "text_id=11566 | speaker=unknown"
msgid "  Whether it was because Soujyuro was unsure if Kinomi was referring to someone in particular..."
msgstr "　無防備な誰かにか、"

#. Occurrence 8_EX:3282:11567: scene=8_EX
#: 8_EX:3282
msgctxt "text_id=11567 | speaker=unknown"
msgid "  ...or whether he was just concerned about how this related to himself, a troubled look washed over his face."
msgstr "　それとも、それに気を取られてしまう自分に対してか、草十郎は居づらそうに顔を曇らせた。"

#. Occurrence 8_EX:3315:11568: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0037; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:3315
msgctxt "text_id=11568 | speaker=kinomi"
msgid "\"Don't overthink the details! It's fine, guys our age are made up of sixty percent sex drive anyway!"
msgstr "「いいんだって、それでいいんだって！　なぜなら、高校生男子の六割は性欲で出来ていますからね！"

#. Occurrence 8_EX:3321:11569: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0038; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:3321
msgctxt "text_id=11569 | speaker=kinomi"
msgid "  So that decides it! We're going to pick up girls! Besides, a new face might increase our luck!\""
msgstr "　よし、そうと決まればさっそくナンパに行こうぜ！　面子が変われば<釣果|ちょうか>も変わるってもんだ！」"

#. Occurrence 8_EX:3341:11570: scene=8_EX
#: 8_EX:3341
msgctxt "text_id=11570 | speaker=unknown"
msgid "  And with that, he happily put his arm around Soujyuro's shoulders and headed off towards the train station."
msgstr "　何が嬉しいのか、木乃美は草十郎の肩を抱いて、共に駅前方面へと歩きだす。"

#. Occurrence 8_EX:3374:11571: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0015; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:3374
msgctxt "text_id=11571 | speaker=tobimaru"
msgid "\"Wait just a second. This isn't right. I don't think you two are even talking about the same thing."
msgstr "「ちょっと待て。あまりのコトに絶句しちまったが、テメエは根本的に間違ってる。"

#. Occurrence 8_EX:3380:11572: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0016; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:3380
msgctxt "text_id=11572 | speaker=tobimaru"
msgid "  Soujyuro, do you even know what he means when he's talking about 'picking up' girls?\""
msgstr "　草十郎。そもそもナンパって言葉がなんなのか、知ってるか？」"

#. Occurrence 8_EX:3386:11573: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0014; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:3386
msgctxt "text_id=11573 | speaker=soujuurou"
msgid "\"Huh?\""
msgstr "「？？」"

#. Occurrence 8_EX:3418:11574: scene=8_EX
#: 8_EX:3418
msgctxt "text_id=11574 | speaker=unknown"
msgid "Q: Define \"pickup.\""
msgstr "【軟派】"

#. Occurrence 8_EX:3424:11575: scene=8_EX
#: 8_EX:3424
msgctxt "text_id=11575 | speaker=unknown"
msgid "  (1) to answer a telephone call"
msgstr "　①軟弱な意見の党派。「―議員」"

#. Occurrence 8_EX:3429:11576: scene=8_EX
#: 8_EX:3429
msgctxt "text_id=11576 | speaker=unknown"
msgid "  (2) to recite a Shakespearean work"
msgstr "　②文芸上エロチシズムを主とするもの。「江戸―」"

#. Occurrence 8_EX:3434:11577: scene=8_EX
#: 8_EX:3434
msgctxt "text_id=11577 | speaker=unknown"
msgid "  (3) to transport someone from one place to another"
msgstr "　③社会面や文学における艶物の担当。「―記者」"

#. Occurrence 8_EX:3439:11578: scene=8_EX
#: 8_EX:3439
msgctxt "text_id=11578 | speaker=unknown"
msgid "  (4) to pay someone's bill"
msgstr "　④軟弱な風潮に同調する人々。"

#. Occurrence 8_EX:3444:11579: scene=8_EX
#: 8_EX:3444
msgctxt "text_id=11579 | speaker=unknown"
msgid "  (5) to try and persuade someone to have a romantic relationship"
msgstr "　⑤転じて、女性などを誘惑すること。硬派"

#. Occurrence 8_EX:3478:11580: scene=8_EX
#: 8_EX:3478
msgctxt "text_id=11580 | speaker=unknown"
msgid "\"..."
msgstr "「…………"

msgctxt "text_id=11581 | speaker=unknown"
msgid "...Number two?\""
msgstr "二番か？」"

#. Occurrence 8_EX:3496:11582: scene=8_EX
#: 8_EX:3496
msgctxt "text_id=11582 | speaker=unknown"
msgid "  Wrong."
msgstr "　論外である。"

#. Occurrence 8_EX:3501:11583: scene=8_EX
#: 8_EX:3501
msgctxt "text_id=11583 | speaker=unknown"
msgid "  Nine times out of ten, when a bunch of high schoolers are talking about picking up girls, they mean definition number five."
msgstr "　いずれ死語になる言葉ではあるが、８０年代の高校生にとってナンパとは十中八九、五番に該当する。"

#. Occurrence 8_EX:3534:11584: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0017; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:3534
msgctxt "text_id=11584 | speaker=tobimaru"
msgid "\"See? Soujyuro isn't after the same thing you are, Kinomi."
msgstr "「ほら見ろ。テメエとは興味の度合いが違うんだよ。"

#. Occurrence 8_EX:3540:11585: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0018; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:3540
msgctxt "text_id=11585 | speaker=tobimaru"
msgid "  If you're looking to pick up girls, go on your own. And don't do it at Misaki Station because you'll make us all look bad. Do it at the next town over or something.\""
msgstr "　<女|おんな>引っかけに行くなら一人で行け。ああ、あと三咲の駅前はやめとけよ、うちの評判が悪くなるから。ナンパなら隣町でやりやがれ」"

#. Occurrence 8_EX:3546:11586: scene=8_EX
#: 8_EX:3546
msgctxt "text_id=11586 | speaker=unknown"
msgid "  Tobimaru waved his hand at Kinomi as if he was shooing away a pest."
msgstr "　鳶丸はシッシッと手を振って悪い虫を追い払う。"

#. Occurrence 8_EX:3551:11587: scene=8_EX
#: 8_EX:3551
msgctxt "text_id=11587 | speaker=unknown"
msgid "  Kinomi clicked his tongue in frustration and removed his arm from around Soujyuro's shoulders."
msgstr "　ちぇっ、と舌打ちして木乃美は草十郎から肩を離した。"

#. Occurrence 8_EX:3589:11588: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0039; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:3589
msgctxt "text_id=11588 | speaker=kinomi"
msgid "\"This is so damn boring! Fine, I'll just play stupid baseball then."
msgstr "「くそ面白くねぇ。あいよ、大人しく野球やってますよ。"

#. Occurrence 8_EX:3589:11589: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0039; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:3589
msgctxt "text_id=11589 | speaker=kinomi"
msgid "  Looks like it's our time to play anyway.\""
msgstr "　いつのまにかオレたちの番が回ってきたみたいだし？」"

#. Occurrence 8_EX:3601:11590: scene=8_EX
#: 8_EX:3601
msgctxt "text_id=11590 | speaker=unknown"
msgid "  He complained all the way to the pitcher's mound."
msgstr "　悪態をつきながら木乃美はマウンドに向かう。"

#. Occurrence 8_EX:3606:11591: scene=8_EX
#: 8_EX:3606
msgctxt "text_id=11591 | speaker=unknown"
msgid "  Soujyuro looked on regretfully."
msgstr "　それを草十郎は名残惜しそうに見送っている。"

#. Occurrence 8_EX:3643:11592: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0019; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:3643
msgctxt "text_id=11592 | speaker=tobimaru"
msgid "\"Whoa, hold on. Did you really wanna go pick up girls with him?\""
msgstr "「おい。まさか、本気でナンパに行きたかったのか？」"

#. Occurrence 8_EX:3654:11593: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0016; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:3654
msgctxt "text_id=11593 | speaker=soujuurou"
msgid "\"Oh, not really. I just had something I wanted to do in town. There's something I've had my eye on for a while now..."
msgstr "「？　いや、ナンパはよく分からないけど、町には用があったんだ。ちょっと欲しいものがあって……"

#. Occurrence 8_EX:3665:11594: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0017; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:3665
msgctxt "text_id=11594 | speaker=soujuurou"
msgid "  Say, Tobimaru, you know that white thing in the student council room? Do you know where I can buy one of those?\""
msgstr "　そうだ鳶丸。生徒会室にあるあの白いヤツ、どこにいけば買えるか知ってるか？」"

#. Occurrence 8_EX:3676:11595: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0020; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:3676
msgctxt "text_id=11595 | speaker=tobimaru"
msgid "\"?\""
msgstr "「？」"

#. Occurrence 8_EX:3696:11596: scene=8_EX
#: 8_EX:3696
msgctxt "text_id=11596 | speaker=unknown"
msgid "  Soujyuro spread his arms wide, making a bizarre gesture."
msgstr "　草十郎は両手をいっぱいに広げて、奇妙なジェスチャーをした。"

#. Occurrence 8_EX:3732:11597: scene=8_EX
#: 8_EX:3732
msgctxt "text_id=11597 | speaker=unknown"
msgid "  One hour later, at the department store in front of the train station..."
msgstr "　一時間後、駅前デパート。"

#. Occurrence 8_EX:3737:11598: scene=8_EX
#: 8_EX:3737
msgctxt "text_id=11598 | speaker=unknown"
msgid "  Tobimaru was still confused after he figured out what Soujyuro wanted to buy."
msgstr "　草十郎が欲しがっていたものが何であるか知った後でも、鳶丸は首をかしげていた。"

#. Occurrence 8_EX:3744:11599: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0021; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:3744
msgctxt "text_id=11599 | speaker=tobimaru"
msgid "\"...So, why did you want this?\""
msgstr "「―――しかし、なんだってこんなものを？」"

#. Occurrence 8_EX:3791:11600: scene=8_EX
#: 8_EX:3791
msgctxt "text_id=11600 | speaker=unknown"
msgid "  The Kuonji Estate was surprisingly comfortable for all three of its occupants this evening."
msgstr "　有珠の用意した夕飯があまりにも素晴らしかったからなのか。"

#. Occurrence 8_EX:3796:11601: scene=8_EX
#: 8_EX:3796
msgctxt "text_id=11601 | speaker=unknown"
msgid "  Maybe it was because the dinner Alice had prepared was so wonderful."
msgstr "　久遠寺邸の夜は珍しく、三者三様に上機嫌なくつろぎ空間と化していた。"

#. Occurrence 8_EX:3825:11602: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0018; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:3825
msgctxt "text_id=11602 | speaker=soujuurou"
msgid "\"Seven? You really had seven meals a day when you were living with your family?"
msgstr "「七回？　有珠の実家じゃ一日に七回も食事を<摂|と>るのか？"

#. Occurrence 8_EX:3832:11603: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0019; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:3832
msgctxt "text_id=11603 | speaker=soujuurou"
msgid "  ...How is that even possible?\""
msgstr "　……いったい、どうやって？」"

#. Occurrence 8_EX:3838:11604: scene=8_EX
#: 8_EX:3838
msgctxt "text_id=11604 | speaker=unknown"
msgid "  Soujyuro asked Alice this question in the sunroom from the third sofa, brought up from the mansion's basement by himself."
msgstr "　三つ目のソファー……屋敷の地下室から実力でゲットした記念品……に座りながら、草十郎はサンルームの有珠に話しかける。"

#. Occurrence 8_EX:3871:11605: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0000; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:3871
msgctxt "text_id=11605 | speaker=alice"
msgid "\"It's not seven full meals. I'm just saying it's ideal to have seven tea times a day."
msgstr "「食事を摂っているわけじゃないわ。ティータイムは一日七回行うのが理想というだけ。"

#. Occurrence 8_EX:3877:11606: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0001; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:3877
msgctxt "text_id=11606 | speaker=alice"
msgid "  An early tea after waking up, breakfast tea, elevenses after that in the morning, low tea in the early afternoon, afternoon tea, high tea in the evening, and then after-dinner tea."
msgstr "　寝起きのアーリー、朝食のブレックファースト、午前のイレブンジズ、午後のミィディティーブレイク、午後の社交界アフタヌーン、夜会のハイティー、ディナー後のアフターディナー。"

#. Occurrence 8_EX:3883:11607: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0002; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:3883
msgctxt "text_id=11607 | speaker=alice"
msgid "  The only one that implies a meal is high tea, at least out in the countryside.\""
msgstr "　この中で食事に該当するのはハイティーだけよ。田舎での話だけれど」"

#. Occurrence 8_EX:3915:11608: scene=8_EX
#: 8_EX:3915
msgctxt "text_id=11608 | speaker=unknown"
msgid "  Alice was enjoying her black tea by herself in the sunroom."
msgstr "　有珠はサンルームでひとり、紅茶を<愉|たの>しんでいる。"

#. Occurrence 8_EX:3920:11609: scene=8_EX
#: 8_EX:3920
msgctxt "text_id=11609 | speaker=unknown"
msgid "  She was drinking a royal blend:"
msgstr "　口にしているのはロイヤルブレンドティー。"

#. Occurrence 8_EX:3925:11610: scene=8_EX
#: 8_EX:3925
msgctxt "text_id=11610 | speaker=unknown"
msgid "  a fine blend of Darjeeling, Ceylon, and Assam orange pekoe tea leaves."
msgstr "　ダージリン、セイロン、アッサムの<茶葉|オレンジペコー>を<配合|ブレンド>した逸品だ。"

#. Occurrence 8_EX:3930:11611: scene=8_EX
#: 8_EX:3930
msgctxt "text_id=11611 | speaker=unknown"
msgid "  To accompany her tea, she had some strawberries dipped in sugar."
msgstr "　お茶請けには砂糖をまぶした苺を完備。"

#. Occurrence 8_EX:3935:11612: scene=8_EX
#: 8_EX:3935
msgctxt "text_id=11612 | speaker=unknown"
msgid "  She was in a world all her own."
msgstr "　もう完全に自分だけの世界を形成している。"

#. Occurrence 8_EX:3968:11613: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0020; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:3968
msgctxt "text_id=11613 | speaker=soujuurou"
msgid "\"So basically you just drink tea all day long?\""
msgstr "「つまり、一日中お茶を飲んでいるのか？」"

#. Occurrence 8_EX:3986:11614: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0003; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:3986
msgctxt "text_id=11614 | speaker=alice"
msgid "\"Ideally, yes.\""
msgstr "「そうね。そう暮らせるのなら、理想的ね」"

#. Occurrence 8_EX:3992:11615: scene=8_EX
#: 8_EX:3992
msgctxt "text_id=11615 | speaker=unknown"
msgid "  She couldn't understand why this was so hard for Soujyuro to grasp."
msgstr "　草十郎のボケ倒しも通用しない。"

#. Occurrence 8_EX:4002:11616: scene=8_EX
#: 8_EX:4002
msgctxt "text_id=11616 | speaker=unknown"
msgid "  Alice picked a strawberry up with her slender fingers and carried it to her mouth as if she were going to give it a kiss."
msgstr "　有珠は細い指でじかに苺を摘んで、口づけるように舌に運んだ。"

#. Occurrence 8_EX:4052:11617: scene=8_EX
#: 8_EX:4052
msgctxt "text_id=11617 | speaker=unknown"
msgid "  Soujyuro was briefly transfixed by the graceful sight, and shook his head to clear his thoughts."
msgstr "　その満足げな横顔に見惚れそうになって、草十郎はぶんぶんと頭を振る。"

#. Occurrence 8_EX:4057:11618: scene=8_EX
#: 8_EX:4057
msgctxt "text_id=11618 | speaker=unknown"
msgid "  He had become slightly too sensitive to the fact that they were indeed of the opposite sex, perhaps due to his conversation earlier that day."
msgstr "　昼間の話が尾を引いているのか、同居人たちが垣間見せる“異性らしさ”に、やや過敏になっているようだ。"

#. Occurrence 8_EX:4092:11619: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0021; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:4092
msgctxt "text_id=11619 | speaker=soujuurou"
msgid "\"But that sounds like you haven't been able to achieve your ideal seven tea times a day.\""
msgstr "「でもその口ぶりだと、有珠は七回できてないんだ」"

#. Occurrence 8_EX:4098:11620: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0004; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:4098
msgctxt "text_id=11620 | speaker=alice"
msgid "\"Three was the best we could do. My partner is still in training, so that means I have to do a lot more than usual.\""
msgstr "「三回が限度よ。相方が未熟だから、やらなくちゃいけない事が増えてしまって」"

#. Occurrence 8_EX:4104:11621: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0022; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:4104
msgctxt "text_id=11621 | speaker=soujuurou"
msgid "\"Partner.\""
msgstr "「相方」"

#. Occurrence 8_EX:4110:11622: scene=8_EX
#: 8_EX:4110
msgctxt "text_id=11622 | speaker=unknown"
msgid "  Soujyuro turned to look to his side."
msgstr "　草十郎は真横に視線を移す。"

#. Occurrence 8_EX:4115:11623: scene=8_EX
#: 8_EX:4115
msgctxt "text_id=11623 | speaker=unknown"
msgid "  There he saw..."
msgstr "　そこには、"

#. Occurrence 8_EX:4156:11624: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0030; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4156
msgctxt "text_id=11624 | speaker=aoko"
msgid "\"What's the deal? Three times a day is more than enough."
msgstr "「なによ、一日三回も開いてれば上出来じゃない。"

#. Occurrence 8_EX:4162:11625: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0031; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4162
msgctxt "text_id=11625 | speaker=aoko"
msgid "  Our student council just sits and sips tea quietly. Considering you have to boil water, get a teapot, and steep the tea, drinking it in the afternoon and after dinner is plenty."
msgstr "　うちの生徒会なんて黙ってお茶飲んでるだけよ？　いちいち鍋からお湯沸かして、ポット使って、たっぷり蒸らすなんて、三時のおやつと夕食後だけで十分でしょう。"

#. Occurrence 8_EX:4168:11626: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0032; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4168
msgctxt "text_id=11626 | speaker=aoko"
msgid "  You just always do too much. Look, I like the fancy lifestyle, but I'm never going to get used to it.\""
msgstr "　有珠は手間をかけすぎ。私、贅沢は好きだけど、贅沢に慣れるのはご免だから」"

#. Occurrence 8_EX:4174:11627: scene=8_EX
#: 8_EX:4174
msgctxt "text_id=11627 | speaker=unknown"
msgid "  Even though Aoko was arguing, she still seemed to be in a good mood."
msgstr "　有珠に反論しつつも、これまた上機嫌な青子がいる。"

#. Occurrence 8_EX:4210:11628: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0005; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:4210
msgctxt "text_id=11628 | speaker=alice"
msgid "\"Well, I'm not the one who's too fancy to drink the tap water here. I can't believe you haven't figured out how delicious Japanese tap water is yet.\""
msgstr "「贅沢なのは青子たちの方よ。日本の水道水はこんなにも美味しいのに。どうして貴方たちは、この<軟水|おうごん>の価値に気付かないのかしら？」"

#. Occurrence 8_EX:4227:11629: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0033; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4227
msgctxt "text_id=11629 | speaker=aoko"
msgid "\"I guess we're just not as *cultured* as you. After all, we're not the type to want to have tea seven times a day."
msgstr "「一日七回もお茶会開く国民性じゃないからでしょ。"

#. Occurrence 8_EX:4233:11630: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0034; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4233
msgctxt "text_id=11630 | speaker=aoko"
msgid "  Be careful, Soujyuro. If you go and buy bottled water to make a nice cup of tea, she'll lecture you for an hour about how dumb and barbaric you are.\""
msgstr "　気をつけなさいね草十郎。美味しい紅茶を淹れようとしてペットボトルの水なんて買ってきたら、有珠に一時間近くお説教されるから。知識も心構えもなってない、って」"

#. Occurrence 8_EX:4263:11631: scene=8_EX
#: 8_EX:4263
msgctxt "text_id=11631 | speaker=unknown"
msgid "  It was true that better water should make a better cup of tea."
msgstr "　水が美味しければ紅茶も美味しくなるはずだ。"

#. Occurrence 8_EX:4268:11632: scene=8_EX
#: 8_EX:4268
msgctxt "text_id=11632 | speaker=unknown"
msgid "  That was why Aoko went out and bought bottles of natural spring water as soon as she moved into the Kuonji Estate."
msgstr "　久遠寺邸に引っ越してすぐの頃、青子はそう考えてペットボトルの自然水を買ってきた。"

#. Occurrence 8_EX:4273:11633: scene=8_EX
#: 8_EX:4273
msgctxt "text_id=11633 | speaker=unknown"
msgid "  Her proud show-and-tell to Alice had led to their first petty argument."
msgstr "　これでどうよ、と自信満々の青子だったが、結果は同居人とのはじめての“人間らしい”口論だった。"

#. Occurrence 8_EX:4278:11634: scene=8_EX
#: 8_EX:4278
msgctxt "text_id=11634 | speaker=unknown"
msgid "  The two were exhausted after quarreling about something one would think wasn't nearly as significant as magecraft."
msgstr "　魔術以外のコトであんなに<罵|ののし>りあい、終わった時は二人とも疲れきって、"

#. Occurrence 8_EX:4309:11635: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0006; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:4309
msgctxt "text_id=11635 | speaker=alice"
msgid "\"Do you have enough energy left to cook dinner, Miss Aozaki?\" Alice asked."
msgstr "『……蒼崎さん。夕食を作る気力、残ってる？』"

#. Occurrence 8_EX:4315:11636: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0035; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4315
msgctxt "text_id=11636 | speaker=aoko"
msgid "\"...Nah. It goes against my better nature, but let's just order takeout.\""
msgstr "『……パス。主義に反するけど、<店屋物|てんやもの>を頼んでみよう』"

#. Occurrence 8_EX:4321:11637: scene=8_EX
#: 8_EX:4321
msgctxt "text_id=11637 | speaker=unknown"
msgid "  And that had been her first time ordering from a soba noodle shop by phone."
msgstr "　これまたはじめて、蕎麦屋に電話で注文する経験をした。"

#. Occurrence 8_EX:4326:11638: scene=8_EX
#: 8_EX:4326
msgctxt "text_id=11638 | speaker=unknown"
msgid "  Their slovenly attitude toward household chores had only accelerated since then."
msgstr "　以来、二人の<自堕落|じだらく>っぷりは加速の<一途|いっと>を辿ったのである。"

#. Occurrence 8_EX:4369:11639: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0036; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4369
msgctxt "text_id=11639 | speaker=aoko"
msgid "\"After that, I looked up everything I could about tea. I asked Alice a lot of questions, and had many heated debates which led to me becoming more of a black tea person."
msgstr "「いやー、あの後は悔しくってお茶について調べまくったもんだわ。有珠に質問したり競い合ってたら、いつのまにか私も紅茶党の仲間入りよ。"

#. Occurrence 8_EX:4375:11640: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0037; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4375
msgctxt "text_id=11640 | speaker=aoko"
msgid "  Up until middle school, I was more into coffee because of my older sister.\""
msgstr "　私、姉貴の影響で中学までコーヒー党だったのに」"

#. Occurrence 8_EX:4405:11641: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0007; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:4405
msgctxt "text_id=11641 | speaker=alice"
msgid "\"...Well, I'm glad you changed your mind."
msgstr "「……そこには感謝しているわ。"

#. Occurrence 8_EX:4411:11642: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0008; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:4411
msgctxt "text_id=11642 | speaker=alice"
msgid "  If you hadn't taken me out shopping that one time, I never would have found that antique Copeland teacup.\""
msgstr "　青子が連れ出してくれなかったら、コープランドのアンティークカップに出会えなかったもの」"

#. Occurrence 8_EX:4417:11643: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0038; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4417
msgctxt "text_id=11643 | speaker=aoko"
msgid "\"Ahahaha! You're right. Last year we were all about antique shopping, weren't we?\""
msgstr "「あはは。気が付いたら骨董品回りしてたものね、去年の私たち」"

#. Occurrence 8_EX:4437:11644: scene=8_EX
#: 8_EX:4437
msgctxt "text_id=11644 | speaker=unknown"
msgid "  The drawing room and the sunroom."
msgstr "　居間とサンルーム。"

#. Occurrence 8_EX:4442:11645: scene=8_EX
#: 8_EX:4442
msgctxt "text_id=11645 | speaker=unknown"
msgid "  Though they were not even in the same room, the two were enjoying a fun and lively conversation nonetheless."
msgstr "　離れてはいるものの二人は楽しげに会話をしている。"

#. Occurrence 8_EX:4461:11646: scene=8_EX
#: 8_EX:4461
msgctxt "text_id=11646 | speaker=unknown"
msgid "  Soujyuro wondered why they didn't just sit together and chat in the drawing room since they got along so well."
msgstr "　せっかく仲が良いんだから、居間で向き合って話をすればいいのに、と草十郎は首をかしげる。"

#. Occurrence 8_EX:4466:11647: scene=8_EX
#: 8_EX:4466
msgctxt "text_id=11647 | speaker=unknown"
msgid "  He didn't yet understand how the physical distance between them made those stories of old memories more meaningful."
msgstr "　離れているからこそ思い出話には興が乗ることを、彼はまだ知らないのだ。"

#. Occurrence 8_EX:4492:11648: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0023; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:4492
msgctxt "text_id=11648 | speaker=soujuurou"
msgid "\"Huh. So you weren't the type to go out much, Alice?\""
msgstr "「ふうん。有珠は外に出ない子だったんだ」"

#. Occurrence 8_EX:4511:11649: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0039; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4511
msgctxt "text_id=11649 | speaker=aoko"
msgid "\"That's right. She was a total indoor type. She only went out to go to school, and that's about it."
msgstr "「ええ、この子ったらほーんと屋内派で、外に出るのは学校だけだったんだから。"

#. Occurrence 8_EX:4511:11650: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0039; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4511
msgctxt "text_id=11650 | speaker=aoko"
msgid "  I mean, just look at today. You've been inside the mansion all day, haven't you, Alice?\""
msgstr "　今日だってずっと洋館にいたんでしょう、有珠？」"

#. Occurrence 8_EX:4544:11651: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0009; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:4544
msgctxt "text_id=11651 | speaker=alice"
msgid "\"It's not that I'm an indoor type. I simply have no reason to go outside."
msgstr "「―――違うわ。外に用がないだけよ。"

#. Occurrence 8_EX:4544:11652: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0009; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:4544
msgctxt "text_id=11652 | speaker=alice"
msgid "  Today I was busy replenishing the Ploys, anyway.\""
msgstr "　今日はプロイの補充に忙しかっただけだし」"

#. Occurrence 8_EX:4562:11653: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0024; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:4562
msgctxt "text_id=11653 | speaker=soujuurou"
msgid "\"About that... Do you make those things here? Like the ones at the amusement park?\""
msgstr "「それだ。プロイの補充ってコトは、遊園地の時みたいなのはここで生まれてるのか？」"

#. Occurrence 8_EX:4613:11654: scene=8_EX
#: 8_EX:4613
msgctxt "text_id=11654 | speaker=unknown"
msgid "  Ever since that terrible incident, Soujyuro had been sensitive whenever Ploys came up. He'd only been worried about escaping with his life at the time, but as time passed..."
msgstr "　遊園地で酷い目にあって以来、草十郎はプロイと聞くと過敏に反応する。あの時は逃げるのに手一杯だったが、時間が経つにつれ、"

#. Occurrence 8_EX:4618:11655: scene=8_EX
#: 8_EX:4618
msgctxt "text_id=11655 | speaker=unknown"
msgid "'What were those mysterious things?'"
msgstr "“あの不思議なものはなんだったのか？”"

#. Occurrence 8_EX:4623:11656: scene=8_EX
#: 8_EX:4623
msgctxt "text_id=11656 | speaker=unknown"
msgid "  He became filled with curiosity."
msgstr "　と気になって仕方がなかったらしい。"

#. Occurrence 8_EX:4644:11657: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0040; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4644
msgctxt "text_id=11657 | speaker=aoko"
msgid "\"Oh, you wanna know?\""
msgstr "「なに、知りたい草十郎？」"

#. Occurrence 8_EX:4662:11658: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0025; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:4662
msgctxt "text_id=11658 | speaker=soujuurou"
msgid "\"I do, if you are willing to tell me. Uh, should I not have asked? But I am curious...\""
msgstr "「教えてくれるなら知りたいけど……いや、よく考えると聞かない方がいいような、やっぱり知りたいような―――」"

#. Occurrence 8_EX:4698:11659: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0041; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4698
msgctxt "text_id=11659 | speaker=aoko"
msgid "\"Fine, I'll tell you then!"
msgstr "「よし、そういう事なら話してあげましょう！"

#. Occurrence 8_EX:4704:11660: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0042; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4704
msgctxt "text_id=11660 | speaker=aoko"
msgid "  You don't mind if I give a brief rundown, do you, Alice?\""
msgstr "　ちょっとした触りだけなら怒らないわよね、有珠？」"

#. Occurrence 8_EX:4709:11661: scene=8_EX
#: 8_EX:4709
msgctxt "text_id=11661 | speaker=unknown"
msgid "  Aoko quickly recrossed her legs in anticipation."
msgstr "　勢いよく脚を組み替える青子。"

#. Occurrence 8_EX:4715:11662: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0010; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:4715
msgctxt "text_id=11662 | speaker=alice"
msgid "\"...Doesn't matter to me."
msgstr "「……別に。"

#. Occurrence 8_EX:4715:11663: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0010; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:4715
msgctxt "text_id=11663 | speaker=alice"
msgid "  As long as you talk about the difference between me and you, that's perfectly fine.\""
msgstr "　わたしと貴女の違いを話すぐらいなら、いいけど」"

#. Occurrence 8_EX:4749:11664: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0043; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4749
msgctxt "text_id=11664 | speaker=aoko"
msgid "\"All right, it's settled then!"
msgstr "「よし決まった！"

#. Occurrence 8_EX:4756:11665: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0044; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4756
msgctxt "text_id=11665 | speaker=aoko"
msgid "  ...Now what's with that look on your face? You're the one who brought it up.\""
msgstr "　……ってなによアンタ、妙な顔して。自分から言っておいて尻尾まくの？」"

#. Occurrence 8_EX:4772:11666: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0026; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:4772
msgctxt "text_id=11666 | speaker=soujuurou"
msgid "\"Ah, no, it's just that... Umm...\""
msgstr "「―――いや、そうではなく」"

#. Occurrence 8_EX:4778:11667: scene=8_EX
#: 8_EX:4778
msgctxt "text_id=11667 | speaker=unknown"
msgid "  Soujyuro diverted his eyes at Aoko's direct stare."
msgstr "　青子に正面から見つめられて、草十郎はつい視線を泳がす。"

#. Occurrence 8_EX:4808:11668: scene=8_EX
#: 8_EX:4808
msgctxt "text_id=11668 | speaker=unknown"
msgid "  Soujyuro and Aoko currently only spent time together after dinner. Every once in a while, however, he would catch a glimpse of some innocent gesture of hers and wouldn't know how to respond."
msgstr "　現状、青子との接点は食後のひとときだけなので<接触事故|ニアミス>はないのだが、たまに、こういう無防備な仕草を目にしてしまい、対応に困る草十郎だった。"

#. Occurrence 8_EX:4829:11669: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0027; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:4829
msgctxt "text_id=11669 | speaker=soujuurou"
msgid "\"It's nothing. Keep going. I'm interested.\""
msgstr "「いいんだ、続けてくれ。興味はある」"

#. Occurrence 8_EX:4845:11670: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0045; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4845
msgctxt "text_id=11670 | speaker=aoko"
msgid "\"Great. Let's get started then. For this, I'll need to call in my robin!"
msgstr "「よし。じゃあ<駒鳥|コマドリ>呼ばないとね。"

#. Occurrence 8_EX:4851:11671: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0046; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:4851
msgctxt "text_id=11671 | speaker=aoko"
msgid "  Today in this special class you're going to learn all about Ploy Kickshaws!\""
msgstr "　それでは特別授業、なぜなにプロイキッシャー、はじまりはじまり～」"

#. Occurrence 8_EX:4873:11672: scene=8_EX
#: 8_EX:4873
msgctxt "text_id=11672 | speaker=unknown"
msgid "  Aoko snapped her fingers."
msgstr "　青子はパチンと指を鳴らす。"

#. Occurrence 8_EX:4878:11673: scene=8_EX
#: 8_EX:4878
msgctxt "text_id=11673 | speaker=unknown"
msgid "  Apparently she was trying to mimic turning on the switch to a TV."
msgstr "　テレビのスイッチを入れる真似ごとらしい。"

#. Occurrence 8_EX:4884:11674: scene=8_EX
#: 8_EX:4884
msgctxt "text_id=11674 | speaker=unknown"
msgid "  It was a veritable TV special."
msgstr "　……<一時|いっとき>の番外編。"

#. Occurrence 8_EX:4889:11675: scene=8_EX
#: 8_EX:4889
msgctxt "text_id=11675 | speaker=unknown"
msgid "  That's how a lecture about a certain brand of magecraft, performed and directed by Alice Kuonji, first aired."
msgstr "　久遠寺有珠監修、久遠寺有珠出演による、ある魔術系統のレクチャーはこうして始まった。"

#. Occurrence 8_EX:4937:11676: scene=8_EX
#: 8_EX:4937
msgctxt "text_id=11676 | speaker=unknown"
msgid "  Unfortunately..."
msgstr "　が。"

#. Occurrence 8_EX:4942:11677: scene=8_EX
#: 8_EX:4942
msgctxt "text_id=11677 | speaker=unknown"
msgid "  The special production was cancelled only thirty minutes after it began."
msgstr "　せっかくの特番は三十分ほどで打ち切りと相成った。"

#. Occurrence 8_EX:4947:11678: scene=8_EX
#: 8_EX:4947
msgctxt "text_id=11678 | speaker=unknown"
msgid "  Apparently, the content had been a little too esoteric for Soujyuro."
msgstr "　聞き手である草十郎をおいてけぼりにした、あまりにマニアックな内容だったからである。"

#. Occurrence 8_EX:4987:11679: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0011; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:4987
msgctxt "text_id=11679 | speaker=alice"
msgid "\"...I knew this would happen."
msgstr "「……分かってはいたけど。"

#. Occurrence 8_EX:4993:11680: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0012; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:4993
msgctxt "text_id=11680 | speaker=alice"
msgid "  Sizuki probably has the worst memory in the universe.\""
msgstr "　静希君の覚えの悪さは、三千世界に響き渡るわね」"

#. Occurrence 8_EX:4999:11681: scene=8_EX
#: 8_EX:4999
msgctxt "text_id=11681 | speaker=unknown"
msgid "  She almost said he was better off dead, but took a deep breath to avoid being hurtful."
msgstr "　死ねばいいのに、と言葉にならないため息をつく有珠。"

#. Occurrence 8_EX:5024:11682: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0047; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5024
msgctxt "text_id=11682 | speaker=aoko"
msgid "\"I'm sorry, Alice. I feel for you on this one."
msgstr "「可哀想な有珠。さすがに今回は同情するわ。"

#. Occurrence 8_EX:5030:11683: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0048; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5030
msgctxt "text_id=11683 | speaker=aoko"
msgid "  I've no idea how he can reduce our magecraft down to 'amazingly convenient.' If any other mage heard that, they'd faint from the pure insult of it.\""
msgstr "　ソイツにとっちゃ私の魔術も有珠の魔術も“すごく便利”でくくられちゃうものだなんて。他の魔術師が聞いたら失神ものの屈辱よ」"

#. Occurrence 8_EX:5050:11684: scene=8_EX
#: 8_EX:5050
msgctxt "text_id=11684 | speaker=unknown"
msgid "  Aoko was exasperated;"
msgstr "　青子も本格的に呆れている。"

#. Occurrence 8_EX:5055:11685: scene=8_EX
#: 8_EX:5055
msgctxt "text_id=11685 | speaker=unknown"
msgid "  she also felt some measure of regret."
msgstr "　もっとも、彼女の場合は反省も混じっていた。"

#. Occurrence 8_EX:5060:11686: scene=8_EX
#: 8_EX:5060
msgctxt "text_id=11686 | speaker=unknown"
msgid "  She should've realized this would be the outcome."
msgstr "　考えてみればこの結果は見えていたからだ。"

#. Occurrence 8_EX:5095:11687: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0028; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5095
msgctxt "text_id=11687 | speaker=soujuurou"
msgid "\"That's not true at all. I can tell the difference between your magecraft."
msgstr "「そんな事はない。ちゃんと区別はつく。"

#. Occurrence 8_EX:5101:11688: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0029; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5101
msgctxt "text_id=11688 | speaker=soujuurou"
msgid "  Aozaki just breaks stuff. Alice makes things to break stuff with. Therefore, Alice is a little more productive.\""
msgstr "　蒼崎は壊すだけで、有珠はいろんなものを作って、それで壊すんだろ。有珠の方がやや生産的だ」"

#. Occurrence 8_EX:5145:11689: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0013; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:5145
msgctxt "text_id=11689 | speaker=alice"
msgid "\"This is scary, Aoko. It hurts. There's a pain in my chest and I don't know what to do with it."
msgstr "「怖いわ青子。わたし、どうしてか胸が苦しい。こういうコトって本当にあるのね。"

#. Occurrence 8_EX:5151:11690: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0014; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:5151
msgctxt "text_id=11690 | speaker=alice"
msgid "  This feels like when someone breaks your favorite teacup and tries to cheer you up by saying that at least there wasn't a troll in the kitchen.\""
msgstr "　まるで、お気に入りのカップを割ってしまった時、通りかかったキリンに“でもトロルよりマシですよ”と<慰|なぐさ>められた気分だわ」"

#. Occurrence 8_EX:5173:11691: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0049; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5173
msgctxt "text_id=11691 | speaker=aoko"
msgid "\"What's *that* supposed to mean?\""
msgstr "「どういう意味よそれ」"

#. Occurrence 8_EX:5193:11692: scene=8_EX
#: 8_EX:5193
msgctxt "text_id=11692 | speaker=unknown"
msgid "  Aoko glared at Alice sitting across from her."
msgstr "　むっと対面に座った相方を睨む青子。"

#. Occurrence 8_EX:5198:11693: scene=8_EX
#: 8_EX:5198
msgctxt "text_id=11693 | speaker=unknown"
msgid "  Alice had alluded to a fairy tale about a less-than-intelligent giant who lived under a bridge."
msgstr "　トロルとは童話で言うところの、少々おつむの足りない暴れん坊の巨人の名だ。"

#. Occurrence 8_EX:5224:11694: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0050; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5224
msgctxt "text_id=11694 | speaker=aoko"
msgid "\"...Hmph. I think Soujyuro's observation was pretty accurate though, to be honest."
msgstr "「……ふん。今の草十郎の指摘、けっこうあってると思うけど。"

#. Occurrence 8_EX:5231:11695: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0051; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5231
msgctxt "text_id=11695 | speaker=aoko"
msgid "I've never seen your Ploys doing anything to help around here. The robin and the twins both only mess things up.\""
msgstr "私、有珠のプロイが生活の役に立つトコ見たことないし。駒鳥も双子も最後はドジって終わりじゃない」"

#. Occurrence 8_EX:5249:11696: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0015; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:5249
msgctxt "text_id=11696 | speaker=alice"
msgid "\"You're only looking at the final outcomes. They are at least *trying* to help. It's not my responsibility that they only end up ruining things.\""
msgstr "「それは結果論よ。役立とうという初志は尊重するべきだわ。……だいたい。<駒鳥|アレ>や<双子|ソレ>が最後にぜんぶ台無しにするのは、わたしの責任じゃないのだし」"

#. Occurrence 8_EX:5269:11697: scene=8_EX
#: 8_EX:5269
msgctxt "text_id=11697 | speaker=unknown"
msgid "  Both girls were now just intent on calling the other out."
msgstr "　両者は互いのダメだしに余念がない。"

#. Occurrence 8_EX:5274:11698: scene=8_EX
#: 8_EX:5274
msgctxt "text_id=11698 | speaker=unknown"
msgid "  It seemed neither wanted to admit their own shortcomings when it came to magecraft."
msgstr "　こと魔術の技量に関して、両者とも譲れない一線があるようだ。"

#. Occurrence 8_EX:5279:11699: scene=8_EX
#: 8_EX:5279
msgctxt "text_id=11699 | speaker=unknown"
msgid "  Even when it came down to a silly argument about who was the worst at breaking things."
msgstr "　どちらがより厄介な壊し屋なのかを押しつける、<底辺|ていへん>の争いにしても。"

#. Occurrence 8_EX:5313:11700: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0030; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5313
msgctxt "text_id=11700 | speaker=soujuurou"
msgid "\"But wait, Alice's familiar does help out sometimes."
msgstr "「いや、でも有珠の使い魔は役に立ってるぞ。"

#. Occurrence 8_EX:5319:11701: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0031; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5319
msgctxt "text_id=11701 | speaker=soujuurou"
msgid "  I saw a pig in the woods picking up leaves before. If that's your familiar, then why don't you tell Aozaki?"
msgstr "　前に森で落ち葉を集めているブタを見かけた。あれは有珠の使い魔なのに、なんで蒼崎に言ってやらないんだ。"

#. Occurrence 8_EX:5325:11702: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0032; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5325
msgctxt "text_id=11702 | speaker=soujuurou"
msgid "  Though I guess Mr. Yamasiro did try to teach us that it's good to be humble and not brag...\""
msgstr "　……まあ、いいことをしたのに黙っているのは美徳だって、山城先生は言ってたけど」"

#. Occurrence 8_EX:5354:11703: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0052; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5354
msgctxt "text_id=11703 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 8_EX:5374:11704: scene=8_EX
#: 8_EX:5374
msgctxt "text_id=11704 | speaker=unknown"
msgid "  Alice had simply sent the Chatty Twins out into the forest to break them in, as it were. To Soujyuro, this had seemed like a good deed."
msgstr "　有珠にしてみれば慣らし運転、ただの準備運動で“お喋り双子”を森に派遣したのだが、草十郎から見れば立派な善行だったらしい。"

#. Occurrence 8_EX:5379:11705: scene=8_EX
#: 8_EX:5379
msgctxt "text_id=11705 | speaker=unknown"
msgid "  Aoko was visibly getting more fed up with this conversation since Soujyuro had decided Alice was the victor here."
msgstr "　有珠の勝ち、と納得する草十郎に、青子はますます面白くない。"

#. Occurrence 8_EX:5406:11706: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0053; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5406
msgctxt "text_id=11706 | speaker=aoko"
msgid "\"Hmph. You think cleaning is productive? I guess you can't see the bigger picture.\""
msgstr "「ハン。掃除をしているから生産的とか、ずいぶん小さな判断ですこと。もっとこう、大きな視点で評価できないのかしらね、このお掃除マシーンは」"

#. Occurrence 8_EX:5428:11707: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0033; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5428
msgctxt "text_id=11707 | speaker=soujuurou"
msgid "\"The bigger picture?"
msgstr "「大きな視点―――"

msgctxt "text_id=11708 | speaker=unknown"
msgid " Like making money or something?\""
msgstr "たとえば、お金<儲|もう>けとか？」"

#. Occurrence 8_EX:5467:11709: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0054; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5467
msgctxt "text_id=11709 | speaker=aoko"
msgid "\"?!\""
msgstr "「！？」"

#. Occurrence 8_EX:5485:11710: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0016; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:5485
msgctxt "text_id=11710 | speaker=alice"
msgid "\"Urgh...\""
msgstr "「ご」"

#. Occurrence 8_EX:5521:11711: scene=8_EX
#: 8_EX:5521
msgctxt "text_id=11711 | speaker=unknown"
msgid "  The two girls both tried to remain calm in face of such a direct question."
msgstr "　あまりに直球な質問に、少女たちは平静を装いつつ顔を見合わせる。"

#. Occurrence 8_EX:5526:11712: scene=8_EX
#: 8_EX:5526
msgctxt "text_id=11712 | speaker=unknown"
msgid "  Even a fool could think of a good idea sometimes."
msgstr "　時に、愚者の思いつきは会議を新たなステージに押し上げるのだった。"

#. Occurrence 8_EX:5554:11713: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0055; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5554
msgctxt "text_id=11713 | speaker=aoko"
msgid "\"...You know, I've never thought about that."
msgstr "「……呆れた。我ながらその発想はなかったわ。"

#. Occurrence 8_EX:5560:11714: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0056; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5560
msgctxt "text_id=11714 | speaker=aoko"
msgid "  Magecraft has always been something that only brings loss.\""
msgstr "　盲点すぎたっていうか、基本、魔術って損失しか産まないものだから」"

#. Occurrence 8_EX:5572:11715: scene=8_EX
#: 8_EX:5572
msgctxt "text_id=11715 | speaker=unknown"
msgid "  Alice nodded affirmatively."
msgstr "　青子の意見に、うんうん、と頷く有珠。"

#. Occurrence 8_EX:5608:11716: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0057; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5608
msgctxt "text_id=11716 | speaker=aoko"
msgid "\"So... What are you thinking?"
msgstr "「それで、たとえば？"

#. Occurrence 8_EX:5614:11717: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0058; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5614
msgctxt "text_id=11717 | speaker=aoko"
msgid "  How do you think my magecraft can make us money?\""
msgstr "　貴方から見て、私の魔術はどんな金策ができると思う？」"

#. Occurrence 8_EX:5620:11718: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0034; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5620
msgctxt "text_id=11718 | speaker=soujuurou"
msgid "\"Hmm, let's see... For you, maybe you could use it to catch tuna or something?\""
msgstr "「蒼崎なら……そうだな、マグロを捕まえるのはどうだろう」"

#. Occurrence 8_EX:5626:11719: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0059; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5626
msgctxt "text_id=11719 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 8_EX:5631:11720: scene=8_EX
#: 8_EX:5631
msgctxt "text_id=11720 | speaker=unknown"
msgid "  Silence."
msgstr "　しばし沈黙。"

#. Occurrence 8_EX:5664:11721: scene=8_EX
#: 8_EX:5664
msgctxt "text_id=11721 | speaker=unknown"
msgid "  Aoko adjusted the position of her crossed legs."
msgstr "　青子は静かに足を組み直して、"

#. Occurrence 8_EX:5673:11722: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0060; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5673
msgctxt "text_id=11722 | speaker=aoko"
msgid "\"Why tuna, exactly?\""
msgstr "「なんでマグロ？」"

#. Occurrence 8_EX:5679:11723: scene=8_EX
#: 8_EX:5679
msgctxt "text_id=11723 | speaker=unknown"
msgid "  She asked this question seriously."
msgstr "　わりと真剣に聞き返した。"

#. Occurrence 8_EX:5712:11724: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0035; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5712
msgctxt "text_id=11724 | speaker=soujuurou"
msgid "\"Ah, I just heard they fetch a really high price at the morning fish market."
msgstr "「いや。<朝市|あさいち>でたいへん高価だと聞いた。"

#. Occurrence 8_EX:5718:11725: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0036; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5718
msgctxt "text_id=11725 | speaker=soujuurou"
msgid "  But they're hard to catch. They're huge, but they can swim at high speeds.\""
msgstr "　でも捕まえるのは難しいって。あんな巨大なものが、水の中では車より速く泳ぐと」"

#. Occurrence 8_EX:5724:11726: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0061; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5724
msgctxt "text_id=11726 | speaker=aoko"
msgid "\"Well, they are one of Earth's greatest predator fish, and one of the most popular types of sushi. I heard they travel at an average speed of 38 miles per hour and can reach a max speed of 112 miles per hour if need be.\""
msgstr "「そりゃ地球が誇る大型肉食魚だからね。お寿司屋さんでも最強だし。平均時速60キロ、マックススピードは時速180キロに迫ると聞くわ」"

#. Occurrence 8_EX:5730:11727: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0037; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5730
msgctxt "text_id=11727 | speaker=soujuurou"
msgid "\"You're good at swimming, aren't you, Aozaki? Couldn't you swim and catch one?\""
msgstr "「部長いわく、蒼崎は泳ぎがうまいって。泳いで捕まえられないか？」"

#. Occurrence 8_EX:5751:11728: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0062; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5751
msgctxt "text_id=11728 | speaker=aoko"
msgid "\"What does that have to do with magecraft?"
msgstr "「もう魔術関係ないわねそれ。"

#. Occurrence 8_EX:5757:11729: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0063; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5757
msgctxt "text_id=11729 | speaker=aoko"
msgid "  Even if I could hit one with a magic bullet, it would be too damaging. I'm only good at speeding things up, not stopping things. What about you, Alice?\""
msgstr "　仮に魔弾で迎撃できたとしても、保存できないわ。私、回転を速めるのが専門で止めるのはちょっと。有珠は？」"

#. Occurrence 8_EX:5763:11730: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0017; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:5763
msgctxt "text_id=11730 | speaker=alice"
msgid "\"I rather hate fish.\""
msgstr "「魚は苦手」"

#. Occurrence 8_EX:5768:11731: scene=8_EX
#: 8_EX:5768
msgctxt "text_id=11731 | speaker=unknown"
msgid "  Alice quietly added that some of them were oddly interesting to her, so she wouldn't feel comfortable harming them."
msgstr "　たまに妙に気を引くのがいるから、と小さく付け足す有珠だった。"

#. Occurrence 8_EX:5797:11732: scene=8_EX
#: 8_EX:5797
msgctxt "text_id=11732 | speaker=unknown"
msgid "  Aoko shrugged her shoulders, throwing that idea to the side."
msgstr "　そう、じゃあ無理ね、と青子は両肩を落とす。"

#. Occurrence 8_EX:5823:11733: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0064; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5823
msgctxt "text_id=11733 | speaker=aoko"
msgid "\"Anyway, are you trying to start a fight or something, Sizuki?\""
msgstr "「ところでケンカ売ってる、静希君？」"

#. Occurrence 8_EX:5843:11734: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0038; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5843
msgctxt "text_id=11734 | speaker=soujuurou"
msgid "\"S-Sorry... I may have been m-mocking you... just a little...\""
msgstr "「す、すまない。実は、ちょっとからかっ、てみた」"

#. Occurrence 8_EX:5855:11735: scene=8_EX
#: 8_EX:5855
msgctxt "text_id=11735 | speaker=unknown"
msgid "  The collar around his neck tightened for a good five seconds."
msgstr "　首輪の圧迫は五秒ほどで止まった。"

#. Occurrence 8_EX:5860:11736: scene=8_EX
#: 8_EX:5860
msgctxt "text_id=11736 | speaker=unknown"
msgid "  It was as tight as a sleeper hold."
msgstr "　微妙にシャレにならない<締め時間|チョークスリーパー>だ。"

#. Occurrence 8_EX:5886:11737: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0039; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5886
msgctxt "text_id=11737 | speaker=soujuurou"
msgid "\"So I guess we can only count on Aozaki to do violent things... How about you, Alice?  "
msgstr "「とまあ、蒼崎には乱暴なことしか期待できないとして、有珠はどうなんだ？　"

#. Occurrence 8_EX:5898:11738: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0040; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:5898
msgctxt "text_id=11738 | speaker=soujuurou"
msgid "You haven't said anything, so I guess you're opposed to using magecraft for profit?\""
msgstr "何も言わないということは、魔術でお金儲けは気に入らない？」"

#. Occurrence 8_EX:5916:11739: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0018; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:5916
msgctxt "text_id=11739 | speaker=alice"
msgid "\"...It's not really about liking it or not. Having money is always a good thing. If there's something Aoko can do while also evading the watching eyes of the Association, I'm all for it.\""
msgstr "「……そうね。好き嫌いはともかく、お金があるのはいいことだわ。協会の目をくぐりぬける事ができるなら、青子には頑張ってほしい」"

#. Occurrence 8_EX:5953:11740: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0065; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5953
msgctxt "text_id=11740 | speaker=aoko"
msgid "\"So I'm the only one sticking my neck out?!"
msgstr "「危ない目に<遭|あ>うのは私だけかッ！？"

#. Occurrence 8_EX:5959:11741: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0066; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5959
msgctxt "text_id=11741 | speaker=aoko"
msgid "  Isn't there something your Ploys can do? Like, I don't know, a hippo that eats dirt and turns it into gold or something?!"
msgstr "　有珠のプロイにはなんかないの？　<土|つち>食べたら<金|きん>に変換するようなカバとか!?"

#. Occurrence 8_EX:5965:11742: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0067; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:5965
msgctxt "text_id=11742 | speaker=aoko"
msgid "  You know, like alchemists who spent day and night researching how to make gold in the middle ages!\""
msgstr "　ほら、中世の貴族はお抱えの錬金術師で、日夜<金|きん>を作り出す研究をしてたっていうじゃない!?」"

#. Occurrence 8_EX:6004:11743: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0019; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6004
msgctxt "text_id=11743 | speaker=alice"
msgid "\"Alchemists were a waste of time and money."
msgstr "「<錬金術師|アレ>はただの金食い虫。"

#. Occurrence 8_EX:6010:11744: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0020; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6010
msgctxt "text_id=11744 | speaker=alice"
msgid "  ...Granted, in some cases they used the wealth of the rich to discover new technologies, so it wasn't all bad."
msgstr "　……まあ、騙した貴族たちの貯蓄を食いつぶして新しい技術を生み出したから、無意味ではなかったけど。"

#. Occurrence 8_EX:6016:11745: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0021; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6016
msgctxt "text_id=11745 | speaker=alice"
msgid "  For example, this Meissen porcelain was the product of a desperate alchemist who boasted the ability to create gold.\""
msgstr "　このマイセンも、元々は<金|きん>を作ると豪語した錬金術師が苦し紛れに産んだ磁器なワケだし」"

#. Occurrence 8_EX:6021:11746: scene=8_EX
#: 8_EX:6021
msgctxt "text_id=11746 | speaker=unknown"
msgid "  Alice ran a finger along the edge of the teacup in her hand."
msgstr "　有珠は手元のティーカップの縁を指でなぞる。"

#. Occurrence 8_EX:6059:11747: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0068; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:6059
msgctxt "text_id=11747 | speaker=aoko"
msgid "\"I guess there's nobody more unreliable than an alchemist then, huh? I hear the alchemists in Prague deal in securities, and the ones in Egypt make weapons now.\""
msgstr "「……はあ。錬金術師ほどアテにならない奴はいないってワケか。今じゃプラハの錬金術師は証券魔術師、エジプトの方は兵器作ってるって話だしね……」"

#. Occurrence 8_EX:6089:11748: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0022; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6089
msgctxt "text_id=11748 | speaker=alice"
msgid "\"Right? I got my hopes up a little, but our kind should honestly never deal with the real world. We're too specialized in Mystics.\""
msgstr "「ええ。ちょっと期待してしまったけど、もともとわたしたちは現実社会と折り合いが悪いのよ。神秘に特化しすぎているから」"

#. Occurrence 8_EX:6115:11749: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0023; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6115
msgctxt "text_id=11749 | speaker=alice"
msgid "\"I've heard that a noble mage family in London has abandoned their traditions and is only taking in disciples for finance now."
msgstr "「ロンドンの名門になると、家訓と事業は別物と割り切っていて、金融専門の弟子をとっているわ。"

#. Occurrence 8_EX:6121:11750: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0024; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6121
msgctxt "text_id=11750 | speaker=alice"
msgid "  It's only a rumor, but apparently the leader of this big financial group drank the blood of all their employees to create a shared information network."
msgstr "　……噂だけど、ある財閥の総帥は社員全員の血を吸って、情報を共有するネットワークを作っているとか。"

#. Occurrence 8_EX:6127:11751: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0025; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6127
msgctxt "text_id=11751 | speaker=alice"
msgid "  Supposedly he became a vampire so that his employees would all be mentally linked, creating the world's only financial group without internal conflict.\""
msgstr "　なんでも吸血鬼になった理由が“精神的に繋がった、決して内部闘争しない商会を作りたいから”だったとか」"

#. Occurrence 8_EX:6171:11752: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0069; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:6171
msgctxt "text_id=11752 | speaker=aoko"
msgid "\"...Sounds extreme. But I guess that's the lengths you have to go to if you want to make money from magecraft."
msgstr "「―――極まってるなあ。要は、そこまで徹底しないと魔術でお金儲けは難しいってコトかぁ。"

#. Occurrence 8_EX:6182:11753: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0070; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:6182
msgctxt "text_id=11753 | speaker=aoko"
msgid "  Hey, what if your Ploys started their own amusement park?\""
msgstr "　あ、有珠のプロイで遊園地をやるのはどう？」"

#. Occurrence 8_EX:6201:11754: scene=8_EX
#: 8_EX:6201
msgctxt "text_id=11754 | speaker=unknown"
msgid "  Soujyuro clapped his hands together in excitement."
msgstr "　ポン、と手を叩く草十郎。"

#. Occurrence 8_EX:6207:11755: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0041; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:6207
msgctxt "text_id=11755 | speaker=soujuurou"
msgid "\"That's a great idea! I've had enough of getting attacked, but in an amusement park that would be a huge hit for sure!\""
msgstr "「それはいい。襲われるのはもうこりごりだけど、あの遊園地なら連日連夜大盛況だ」"

#. Occurrence 8_EX:6235:11756: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0026; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6235
msgctxt "text_id=11756 | speaker=alice"
msgid "\"You mean you want my Ploys to be some kind of show or exhibit?\""
msgstr "「わたしのプロイを見せ物にする気？」"

#. Occurrence 8_EX:6258:11757: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0071; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:6258
msgctxt "text_id=11757 | speaker=aoko"
msgid "\"I bet it would actually be popular. You could just tell everyone they're robots, and they would definitely believe you.\""
msgstr "「でも大ウケよ、絶対。ロボットって言い張ればみんな騙されるし」"

#. Occurrence 8_EX:6297:11758: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0027; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6297
msgctxt "text_id=11758 | speaker=alice"
msgid "\"No way, Aoko. Bring this up again and we're through.\""
msgstr "「却下よ青子。この話、もう一度したら絶交だから」"

#. Occurrence 8_EX:6308:11759: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0072; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:6308
msgctxt "text_id=11759 | speaker=aoko"
msgid "\"Oof, you're actually mad. All right, Soujyuro. That's it for the amusement park idea. No point losing a friendship over it.\""
msgstr "「う、本気で怒らせたか。だってさ草十郎、遊園地はあきらめましょ。今度こそ友情を失っちゃうし」"

#. Occurrence 8_EX:6341:11760: scene=8_EX
#: 8_EX:6341
msgctxt "text_id=11760 | speaker=unknown"
msgid "  Aoko backed down after Alice's cold rejection of the idea."
msgstr "　冷たく拒絶する有珠と、やれやれと引き下がる青子。"

#. Occurrence 8_EX:6346:11761: scene=8_EX
#: 8_EX:6346
msgctxt "text_id=11761 | speaker=unknown"
msgid "  The small talk continued, but the girls grew more distant as they tried to avoid further conflict."
msgstr "　雑談をしつつも、少女たちは互いの距離感、踏みこんではいけない線を心得ていた。"

#. Occurrence 8_EX:6363:11762: scene=8_EX
#: 8_EX:6363
msgctxt "text_id=11762 | speaker=unknown"
msgid "  Soujyuro looked at the two with a perplexed expression."
msgstr "　草十郎はそんなふたりを不思議そうに見つめている。"

#. Occurrence 8_EX:6389:11763: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0042; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:6389
msgctxt "text_id=11763 | speaker=soujuurou"
msgid "\"Hold on, there's something I really have to ask about now.\""
msgstr "「ちょっといいかな。いま、猛烈に気になったんだが」"

#. Occurrence 8_EX:6406:11764: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0073; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:6406
msgctxt "text_id=11764 | speaker=aoko"
msgid "\"What is it?\""
msgstr "「なに？」"

#. Occurrence 8_EX:6424:11765: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0043; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:6424
msgctxt "text_id=11765 | speaker=soujuurou"
msgid "\"It's just, you guys were both trying to seriously kill each other at that amusement park, weren't you?"
msgstr "「いや。蒼崎も有珠も、遊園地で本気で殺し合っただろ。"

#. Occurrence 8_EX:6430:11766: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0044; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:6430
msgctxt "text_id=11766 | speaker=soujuurou"
msgid "  How were you able to stay friends after that?\""
msgstr "　それなのに、まだ友達だったのか？」"

#. Occurrence 8_EX:6491:11767: scene=8_EX
#: 8_EX:6491
msgctxt "text_id=11767 | speaker=unknown"
msgid "  It was certainly a rude question to ask."
msgstr "　失礼と言えば失礼、"

#. Occurrence 8_EX:6496:11768: scene=8_EX
#: 8_EX:6496
msgctxt "text_id=11768 | speaker=unknown"
msgid "  But it was also an obvious thing to ask. Aoko and Alice looked at each other as they thought of the answer."
msgstr "　当然と言えば当然の疑問に、青子たちは顔を見合わせる。"

#. Occurrence 8_EX:6501:11769: scene=8_EX
#: 8_EX:6501
msgctxt "text_id=11769 | speaker=unknown"
msgid "  The stared at each other for about two seconds."
msgstr "　ふたりは二秒ほど見つめ合ったあと、"

#. Occurrence 8_EX:6552:11770: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0074; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:6552
msgctxt "text_id=11770 | speaker=aoko"
msgid "\"Hmm... It happens, I guess?\""
msgstr "「んー、ギリギリあり？」"

#. Occurrence 8_EX:6563:11771: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0028; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6563
msgctxt "text_id=11771 | speaker=alice"
msgid "\"Yeah, these things happen.\""
msgstr "「まあ、ギリギリ」"

#. Occurrence 8_EX:6583:11772: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0045; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:6583
msgctxt "text_id=11772 | speaker=soujuurou"
msgid "\"They do?!\""
msgstr "「ありなんだ！」"

#. Occurrence 8_EX:6589:11773: scene=8_EX
#: 8_EX:6589
msgctxt "text_id=11773 | speaker=unknown"
msgid "  Though their friendship was surprisingly lighthearted..."
msgstr "　あまりに軽く、"

#. Occurrence 8_EX:6594:11774: scene=8_EX
#: 8_EX:6594
msgctxt "text_id=11774 | speaker=unknown"
msgid "  ...it also seemed to be forged from bonds harder than steel."
msgstr "　また鉄より堅い、驚愕の友情なのだった。"

#. Occurrence 8_EX:6662:11775: scene=8_EX
#: 8_EX:6662
msgctxt "text_id=11775 | speaker=unknown"
msgid "  Their long and extended tea party had just started to get going when Soujyuro had to leave."
msgstr "　おもいのほか長く続いたお茶会は、草十郎の退席でお開きとなった。"

#. Occurrence 8_EX:6667:11776: scene=8_EX
#: 8_EX:6667
msgctxt "text_id=11776 | speaker=unknown"
msgid "  He didn't really want to since he was enjoying himself, but he couldn't miss his part-time job."
msgstr "　草十郎としても名残惜しいが、アルバイトは休めない。"

#. Occurrence 8_EX:6691:11777: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0075; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:6691
msgctxt "text_id=11777 | speaker=aoko"
msgid "\"It's rare for us to talk for two hours like this."
msgstr "「二時間も話してたなんて珍しいわね。"

#. Occurrence 8_EX:6691:11778: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0075; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:6691
msgctxt "text_id=11778 | speaker=aoko"
msgid "  You were unusually chatty today, Alice.\""
msgstr "　有珠もいつになく<饒舌|じょうぜつ>だったし」"

#. Occurrence 8_EX:6700:11779: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0029; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6700
msgctxt "text_id=11779 | speaker=alice"
msgid "\"I had to be. Sizuki kept asking you questions, and you kept putting them off onto me."
msgstr "「成り行きよ。静希君があれこれ青子に質問して、貴女がそれをわたしにも向けてきただけ。"

#. Occurrence 8_EX:6706:11780: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0030; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6706
msgctxt "text_id=11780 | speaker=alice"
msgid "  I don't even understand why he's so concerned with what we do all day anyway.\""
msgstr "　……本当。わたしたちが一日なにをしているのかなんて、聞いても仕方がないのに」"

#. Occurrence 8_EX:6742:11781: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0046; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:6742
msgctxt "text_id=11781 | speaker=soujuurou"
msgid "\"I don't know, I think it was actually a helpful conversation.\""
msgstr "「いや、それがそうでもない。たいへん役に立ちました」"

#. Occurrence 8_EX:6760:11782: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0076; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:6760
msgctxt "text_id=11782 | speaker=aoko"
msgid "\"Huh?\""
msgstr "「はい？」"

#. Occurrence 8_EX:6780:11783: scene=8_EX
#: 8_EX:6780
msgctxt "text_id=11783 | speaker=unknown"
msgid "  Soujyuro was carrying something down the hallway, ignoring Aoko's surprise."
msgstr "　驚く青子をよそに、草十郎は廊下から何やら運んでくる。"

#. Occurrence 8_EX:6798:11784: scene=8_EX
#: 8_EX:6798
msgctxt "text_id=11784 | speaker=unknown"
msgid "  It was a large whiteboard, much like the one in the student council room."
msgstr "　生徒会室にあるタイプの、大型のホワイトボード。"

#. Occurrence 8_EX:6803:11785: scene=8_EX
#: 8_EX:6803
msgctxt "text_id=11785 | speaker=unknown"
msgid "  On the shiny new board was written,"
msgstr "　真新しいボードには油性ペンで、以下の内容が書かれていた。"

#. Occurrence 8_EX:6823:11786: scene=8_EX
#: 8_EX:6823
msgctxt "text_id=11786 | speaker=unknown"
msgid "  Chores List"
msgstr "　～これからの役割分担表～"

#. Occurrence 8_EX:6829:11787: scene=8_EX
#: 8_EX:6829
msgctxt "text_id=11787 | speaker=unknown"
msgid "        - Mansion cleaning (1F east wing only)"
msgstr "　　　　・館内清掃（一階東館にかぎる）"

#. Occurrence 8_EX:6829:11788: scene=8_EX
#: 8_EX:6829
msgctxt "text_id=11788 | speaker=unknown"
msgid "        - Breakfast"
msgstr "　　　　・朝食当番"

#. Occurrence 8_EX:6829:11789: scene=8_EX
#: 8_EX:6829
msgctxt "text_id=11789 | speaker=unknown"
msgid "        - Dinner"
msgstr "　　　　・夕食当番"

#. Occurrence 8_EX:6829:11790: scene=8_EX
#: 8_EX:6829
msgctxt "text_id=11790 | speaker=unknown"
msgid "        - Cleaning the bath"
msgstr "　　　　・風呂当番"

#. Occurrence 8_EX:6860:11791: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0077; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:6860
msgctxt "text_id=11791 | speaker=aoko"
msgid "\"I knew there had to be some reason you were asking so many questions!\""
msgstr "「な―――なんか色々と詮索してくると思ったら、そういう裏があったワケ……!?」"

#. Occurrence 8_EX:6884:11792: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0047; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:6884
msgctxt "text_id=11792 | speaker=soujuurou"
msgid "\"Right. If you want to correct something, you need to first find out what's broken, right?"
msgstr "「うん。歪みを正したかったら、まずどこがおかしいのか知らないといけないからね。"

#. Occurrence 8_EX:6890:11793: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0048; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:6890
msgctxt "text_id=11793 | speaker=soujuurou"
msgid "  Well, based on tonight's conversation, you both have at least one hour of free time a day. Since all three of us share the kitchen, I think it's best if we assign a rotation. You both need to help out where you can.\""
msgstr "　今夜の話じゃ、ふたりとも一日に一時間ぐらいは使える時間があるみたいだし。三人で一つの台所を使っているんだから、ローテーションを組んだ方がいいだろ。協力できるところは協力しないと」"

#. Occurrence 8_EX:6896:11794: scene=8_EX
#: 8_EX:6896
msgctxt "text_id=11794 | speaker=unknown"
msgid "  Soujyuro was clearly proud of his attempt at making things better around here."
msgstr "　たいしつかいぜんだ、と胸を張る草十郎。"

#. Occurrence 8_EX:6937:11795: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0031; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:6937
msgctxt "text_id=11795 | speaker=alice"
msgid "\"Wait just a second. Didn't I make it clear that I'm just letting you live here and don't have any intention to help with things like this?\""
msgstr "「待って。わたしは貴方を住まわせているだけで、協力なんてする気はないって言ったでしょう」"

#. Occurrence 8_EX:6961:11796: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0049; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:6961
msgctxt "text_id=11796 | speaker=soujuurou"
msgid "\"You did, yes."
msgstr "「うん、言ったね。"

#. Occurrence 8_EX:6961:11797: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0049; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:6961
msgctxt "text_id=11797 | speaker=soujuurou"
msgid "  But if you can ask me to make dinner for you while I'm cooking for myself, then it's only fair that you reciprocate."
msgstr "　でも“夕食を用意するならわたしの分もお願い”と言いたいのなら、<相互扶助|そうごふじょ>は当然の義務だと思うんだ。"

#. Occurrence 8_EX:6973:11798: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0050; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:6973
msgctxt "text_id=11798 | speaker=soujuurou"
msgid "  Plus, if all three of us pitch in, I think we can eat better food in general.\""
msgstr "　あと、三人で食費を集めれば、その分美味しいものが食べられるよ」"

#. Occurrence 8_EX:7012:11799: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0032; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:7012
msgctxt "text_id=11799 | speaker=alice"
msgid "\"Urgh.\""
msgstr "「こ」"

#. Occurrence 8_EX:7018:11800: scene=8_EX
#: 8_EX:7018
msgctxt "text_id=11800 | speaker=unknown"
msgid "  Soujyuro's words pierced Alice's heart. She knew she had asked him to make dinner for her on many occasions."
msgstr "　今まで何度か“わたしの分もお願い”をやってしまった有珠にとって、草十郎の言葉はまさに神の鉄槌。"

#. Occurrence 8_EX:7023:11801: scene=8_EX
#: 8_EX:7023
msgctxt "text_id=11801 | speaker=unknown"
msgid "  It was a carefully planned attack designed to make her repent for her sins, and she knew it."
msgstr "　神罰に等しい、汝の罪を悔い改めよ系の攻撃だった。"

#. Occurrence 8_EX:7061:11802: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0078; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:7061
msgctxt "text_id=11802 | speaker=aoko"
msgid "\"Even so, do we really need an entire whiteboard? We always managed without writing any chores down before...\""
msgstr "「で、でもホワイトボードを用意するコトはないんじゃない？　当番なんて、今まで口約束で決めてきたんだし……」"

#. Occurrence 8_EX:7085:11803: scene=8_EX
#: 8_EX:7085
msgctxt "text_id=11803 | speaker=unknown"
msgid "  Alice nodded her agreement."
msgstr "　うんうん、と頷く有珠。"

#. Occurrence 8_EX:7090:11804: scene=8_EX
#: 8_EX:7090
msgctxt "text_id=11804 | speaker=unknown"
msgid "  There was nothing less reliable in this world than a verbal promise."
msgstr "　口約束ほどアテに出来ないものはない。"

#. Occurrence 8_EX:7095:11805: scene=8_EX
#: 8_EX:7095
msgctxt "text_id=11805 | speaker=unknown"
msgid "  Even if they didn't say so, Soujyuro could tell by the look on their faces that they intended to skip out on whatever task they were assigned to do."
msgstr "　ふたりとも口にはしないものの、イザとなったらさぼる気満々の顔である。"

#. Occurrence 8_EX:7133:11806: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0051; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:7133
msgctxt "text_id=11806 | speaker=soujuurou"
msgid "\"No way. If you want things to be done right, then everyone needs to know their responsibilities. If we write it down like this, then nobody will have an excuse to forget.\""
msgstr "「ダメだ。正しい生活を送るには、正しい役割を把握しないと。こういう風に書いておけば、後になっても忘れないだろ？」"

#. Occurrence 8_EX:7156:11807: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0079; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:7156
msgctxt "text_id=11807 | speaker=aoko"
msgid "\"Urrrggghhh...\""
msgstr "「うっ―――」"

#. Occurrence 8_EX:7176:11808: scene=8_EX
#: 8_EX:7176
msgctxt "text_id=11808 | speaker=unknown"
msgid "  Aoko recoiled at this new development."
msgstr "　底の見えない笑顔にたじろぐ青子。"

#. Occurrence 8_EX:7181:11809: scene=8_EX
#: 8_EX:7181
msgctxt "text_id=11809 | speaker=unknown"
msgid "  She couldn't tell if Soujyuro was just being nice, or if he was saying he wouldn't tolerate any slackers."
msgstr "　親切心で言っているのか、今から“サボらせないぞ”と<釘|くぎ>をさしているのか、まったく読めない。"

#. Occurrence 8_EX:7220:11810: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0033; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:7220
msgctxt "text_id=11810 | speaker=alice"
msgid "\"...I can't believe you're making us sign off on these specific responsibilities like this.\""
msgstr "「……なんてこと。証明文を書かせて、責任の所在を明らかにしようだなんて……」"

#. Occurrence 8_EX:7226:11811: scene=8_EX
#: 8_EX:7226
msgctxt "text_id=11811 | speaker=unknown"
msgid "  Alice was absolutely terrified at the prospect of daily chores."
msgstr "　有珠は有珠で、これから日常になるっぽい当番制に<戦慄|せんりつ>していた。"

#. Occurrence 8_EX:7259:11812: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0052; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:7259
msgctxt "text_id=11812 | speaker=soujuurou"
msgid "\"So that settles it. Tomorrow we'll figure out who to assign to which tasks. I know this is going to be difficult for you two, so I'll take on the majority of tasks myself for the time being.\""
msgstr "「決まりだな。誰がどこを担当するかは、また明日話しあおう。今のふたりがたいへんなのは分かってるから、しばらくの間はこっちが多目に受け持つよ」"

#. Occurrence 8_EX:7271:11813: scene=8_EX
#: 8_EX:7271
msgctxt "text_id=11813 | speaker=unknown"
msgid "  And with that, Soujyuro left."
msgstr "　それじゃ、と草十郎は去っていった。"

#. Occurrence 8_EX:7276:11814: scene=8_EX
#: 8_EX:7276
msgctxt "text_id=11814 | speaker=unknown"
msgid "  The two girls left behind could only sit and stare, stunned at the shiny new whiteboard."
msgstr "　残されたふたりはやるせなく、新品のホワイトボードを見つめている。"

#. Occurrence 8_EX:7316:11815: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0034; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:7316
msgctxt "text_id=11815 | speaker=alice"
msgid "\"This is like a dog biting the hand that feeds it. I never knew he was so brazen.\""
msgstr "「……こういうのを、飼い犬に手を噛まれる、というのかしら。わりと<小癪|こしゃく>な性格をしていたのね、彼」"

#. Occurrence 8_EX:7327:11816: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0080; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:7327
msgctxt "text_id=11816 | speaker=aoko"
msgid "\"I knew. I knew it from the moment I met him.\""
msgstr "「知ってた。私、アイツがそういうヤツって知ってたわ」"

#. Occurrence 8_EX:7347:11817: scene=8_EX
#: 8_EX:7347
msgctxt "text_id=11817 | speaker=unknown"
msgid "  But now it was too late. They'd already been caught in the trap."
msgstr "　<罠|わな>にかかったと気付いても後の祭り。"

#. Occurrence 8_EX:7352:11818: scene=8_EX
#: 8_EX:7352
msgctxt "text_id=11818 | speaker=unknown"
msgid "  Just this morning, Aoko had received a portion of the salad Soujyuro prepared."
msgstr "　そもそも今日の青子の朝食も、草十郎が調理したサラダを分けて貰ったものである。"

#. Occurrence 8_EX:7357:11819: scene=8_EX
#: 8_EX:7357
msgctxt "text_id=11819 | speaker=unknown"
msgid "  She knew it would be wrong for her to veto the idea of them all helping each other out."
msgstr "　今から“じゃあこれから助け合いはなし”と言うには、助け合いの味をしめてしまった。"

#. Occurrence 8_EX:7377:11820: scene=8_EX
#: 8_EX:7377
msgctxt "text_id=11820 | speaker=unknown"
msgid "  The concept of dividing up specific chores made perfect sense to Aoko, after all."
msgstr "　そもそも当番制は青子の合理性に合っている。"

#. Occurrence 8_EX:7382:11821: scene=8_EX
#: 8_EX:7382
msgctxt "text_id=11821 | speaker=unknown"
msgid "  Even so, she wanted to be able to tip the ratio of chores in her favor, at least sometimes."
msgstr "　ただ、できれば作業の割合を、たまにでいいから誤魔化したかっただけなのだ。"

#. Occurrence 8_EX:7408:11822: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0035; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:7408
msgctxt "text_id=11822 | speaker=alice"
msgid "\"...Aoko, I already know what you're thinking.\""
msgstr "「……青子。貴女、なにを考えているか丸わかりよ」"

#. Occurrence 8_EX:7419:11823: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0081; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:7419
msgctxt "text_id=11823 | speaker=aoko"
msgid "\"I'm sure you do."
msgstr "「そうでしょうとも。"

#. Occurrence 8_EX:7419:11824: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0081; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:7419
msgctxt "text_id=11824 | speaker=aoko"
msgid "  Because I'm pretty sure we're both thinking the same thing.\""
msgstr "　間違いなく同じコトを考えてたからね、私たち」"

#. Occurrence 8_EX:7439:11825: scene=8_EX
#: 8_EX:7439
msgctxt "text_id=11825 | speaker=unknown"
msgid "  Aoko sighed as she grabbed the whiteboard. She was going to hang it up in the kitchen so that they could all see it."
msgstr "　ため息まじりの返答をして、青子はホワイトボードを手に取った。全員共通の持ち物として、台所の壁に立てかける気らしい。"

#. Occurrence 8_EX:7469:11826: scene=8_EX
#: 8_EX:7469
msgctxt "text_id=11826 | speaker=unknown"
msgid "  Alice was still staring at the whiteboard blankly."
msgstr "　有珠はじっとホワイトボードを見ながら、"

#. Occurrence 8_EX:7481:11827: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_EX_0036; voice_prefix=A40; voice_category=2; scene=8_EX
#: 8_EX:7481
msgctxt "text_id=11827 | speaker=alice"
msgid "\"...I just hope he doesn't add any new chores to the list.\""
msgstr "「……せめて、新しい項目が増えなければいいけど」"

#. Occurrence 8_EX:7487:11828: scene=8_EX
#: 8_EX:7487
msgctxt "text_id=11828 | speaker=unknown"
msgid "  She would come to regret ever saying those words."
msgstr "　なんて、世にも不吉な言葉を口にした。"

#. Occurrence 8DOT5:38:11829: scene=8DOT5
#: 8DOT5:38
msgctxt "text_id=11829 | speaker=unknown"
msgid "  No matter how busy one is, any person living within human means is certain to have at least some free time."
msgstr "　いかに多忙と言え、人間として暮らしている以上、ある程度の余分は生まれてくる。"

#. Occurrence 8DOT5:56:11830: scene=8DOT5
#: 8DOT5:56
msgctxt "text_id=11830 | speaker=unknown"
msgid "  Before or after eating, for example."
msgstr "　たとえば食事の前後。"

#. Occurrence 8DOT5:61:11831: scene=8DOT5
#: 8DOT5:61
msgctxt "text_id=11831 | speaker=unknown"
msgid "  It's difficult to eliminate the time required to prepare a meal and the time after one finishes eating."
msgstr "　調理の手間と食後の<一服|ひととき>は無くす方が難しい。"

#. Occurrence 8DOT5:66:11832: scene=8DOT5
#: 8DOT5:66
msgctxt "text_id=11832 | speaker=unknown"
msgid "  This is particularly the case for those who do a lot of thinking."
msgstr "　頭脳労働者の場合、特に顕著である。"

#. Occurrence 8DOT5:71:11833: scene=8DOT5
#: 8DOT5:71
msgctxt "text_id=11833 | speaker=unknown"
msgid "  Since the body needs to use energy to digest after eating, there's less available for the brain to use..."
msgstr "　食後、体は消化にエネルギーを使うため、肝心の頭にまで血が回らない。なので、"

#. Occurrence 8DOT5:105:11834: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0000; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:105
msgctxt "text_id=11834 | speaker=aoko"
msgid "\"That brand was named after the Greek goddess Nike, right?"
msgstr "「ナイキはあれでしょ、ニケーのもじりでしょ？"

#. Occurrence 8DOT5:105:11835: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0000; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:105
msgctxt "text_id=11835 | speaker=aoko"
msgid "  I guess it represents winning in sports, since she was the goddess of victory.\""
msgstr "　アテナの持ってる、盾じゃなくて小さな勝利の女神の方。陸上競技に勝つってイメージじゃない？」"

#. Occurrence 8DOT5:112:11836: voice_id=BA0_8DOT5_0000; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:112
msgctxt "text_id=11836 | speaker=unknown"
msgid "\"You've got a lot fillin' your head about these brands, Miss Aoko. Don't know where ya put it all!\""
msgstr "『さすがブランド品とか大好きな青子さん、どうでもいい知識だけはそれなりッスね！』"

#. Occurrence 8DOT5:118:11837: scene=8DOT5
#: 8DOT5:118
msgctxt "text_id=11837 | speaker=unknown"
msgid "  The studious resident of the mansion was now taking refuge on the sofa, looking exhausted."
msgstr "　洋館における頭脳労働者は、だらけきった姿勢でソファーに体を<預|あず>けているのだった。"

#. Occurrence 8DOT5:155:11838: scene=8DOT5
#: 8DOT5:155
msgctxt "text_id=11838 | speaker=unknown"
msgid "  Aoko was talking to the robin perched on the table."
msgstr "　青子の話し相手はテーブルの上にいる駒鳥だ。"

#. Occurrence 8DOT5:160:11839: scene=8DOT5
#: 8DOT5:160
msgctxt "text_id=11839 | speaker=unknown"
msgid "  The blue bird flapped its wings, doing its best to join in on the after dinner conversation."
msgstr "　青い鳥はパタパタと羽を鳴らしながら、食後の団らんの真似事なぞ<勤|いそ>しんでいる。"

#. Occurrence 8DOT5:199:11840: scene=8DOT5
#: 8DOT5:199
msgctxt "text_id=11840 | speaker=unknown"
msgid "  Alice was reading in the sunroom."
msgstr "　有珠はサンルームで読書中。"

#. Occurrence 8DOT5:204:11841: scene=8DOT5
#: 8DOT5:204
msgctxt "text_id=11841 | speaker=unknown"
msgid "  Discussion of how to deal with the encroaching enemy mage wouldn't start for at least another thirty minutes."
msgstr "　外部からやってきた敵魔術師への対策は、あと三十分ほど休んでからの話となる。"

#. Occurrence 8DOT5:247:11842: voice_id=BA0_8DOT5_0001; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:247
msgctxt "text_id=11842 | speaker=unknown"
msgid "\"So you fink"
msgstr "『んじゃアディダスは？"

#. Occurrence 8DOT5:247:11843: voice_id=BA0_8DOT5_0001; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:247
msgctxt "text_id=11843 | speaker=unknown"
msgid "  that other one is sum play on adios?\""
msgstr "　もしかしてアディオスのもじりっスか？』"

#. Occurrence 8DOT5:267:11844: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0001; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:267
msgctxt "text_id=11844 | speaker=aoko"
msgid "\"It's just a name, isn't it?"
msgstr "「あれは普通に名前じゃなかったっけ？"

#. Occurrence 8DOT5:273:11845: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0002; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:273
msgctxt "text_id=11845 | speaker=aoko"
msgid "  It's like the Grimm Fairy Tales where they just used the name of the brothers who came up with it for the brand name.\""
msgstr "　ほら、グリム童話みたいに、作った兄弟の名前がそのままブランド名になっちゃったのよ」"

#. Occurrence 8DOT5:309:11846: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0000; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:309
msgctxt "text_id=11846 | speaker=alice"
msgid "\"The brothers Grimm didn't make up those fairy tales."
msgstr "「ブラザーグリムは童話を作った訳じゃないわ。"

#. Occurrence 8DOT5:315:11847: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0001; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:315
msgctxt "text_id=11847 | speaker=alice"
msgid "  They're a collection of folk tales passed down by oral tradition. The brothers rewrote and carefully compiled them into proper stories. They're more like scholars than craftsmen in that sense."
msgstr "　埋もれていた口伝を<蒐集|しゅうしゅう>して、物語に仕立て直して、丁寧に<編纂|へんさん>した人たちよ。職人というより学者の<類|たぐい>ね。"

#. Occurrence 8DOT5:321:11848: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0002; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:321
msgctxt "text_id=11848 | speaker=alice"
msgid "  ...And in some sense, kind of like con men.\""
msgstr "　……まあ、多少は詐欺師めいたところもあるけれど」"

#. Occurrence 8DOT5:356:11849: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0003; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:356
msgctxt "text_id=11849 | speaker=aoko"
msgid "\"Huh. Well what about Andersen? The Little Mermaid and Thumbelina are super famous. Oh, and The Ugly Duckling!\""
msgstr "「へー。じゃあアンデルセンは？　人魚姫とか親指姫とか超メジャーだけど。ああ、あとみにくいアヒルの子」"

#. Occurrence 8DOT5:362:11850: voice_id=BA0_8DOT5_0002; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:362
msgctxt "text_id=11850 | speaker=unknown"
msgid "\"I personally like The Emperor's New Clothes. Me 'n 'im got a lot in common.\""
msgstr "『ジブン、裸の王様とかたまんないッス。シンパシー感じるッスよ、あの<透けてる|クリスタル>キングに』"

#. Occurrence 8DOT5:396:11851: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0003; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:396
msgctxt "text_id=11851 | speaker=alice"
msgid "\"Andersen was more of a writer than a scholar."
msgstr "「アンデルセンは学者というより作家でしょうね。"

#. Occurrence 8DOT5:402:11852: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0004; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:402
msgctxt "text_id=11852 | speaker=alice"
msgid "  His creativity is said to have been inspired by everything from the elite and wealthy, to the common people and what makes them happy, to a resentment of the female image. He didn't write from intellectual curiosity, but rather from his own emotions.\""
msgstr "　彼の創作意欲は裕福層や大衆、平凡な幸福を得ている人々、はては女性像への<憤|いきどお>りから生まれたものだと言われているし。知的好奇心から筆をとったのではなく、感情を訴えるために筆をとった人」"

#. Occurrence 8DOT5:428:11853: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0005; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:428
msgctxt "text_id=11853 | speaker=alice"
msgid "\"I hate to explain it this way, but..."
msgstr "「……あまり、こういう説明はしたくないのだけれど。"

#. Occurrence 8DOT5:434:11854: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0006; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:434
msgctxt "text_id=11854 | speaker=alice"
msgid "  If Mother Goose is a song, the brothers Grimm tell a story. Andersen is more like a fable or an allegory.\""
msgstr "　それぞれ分けて説明するなら、マザーグースは歌、ブラザーグリムは物語。アンデルセンは寓話ね」"

#. Occurrence 8DOT5:464:11855: voice_id=BA0_8DOT5_0003_A; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:464
msgctxt "text_id=11855 | speaker=unknown"
msgid "\"Some of their stories are now cartoons!"
msgstr "『みつばちマッチはアニメっすね。"

#. Occurrence 8DOT5:470:11856: voice_id=BA0_8DOT5_0004_A; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:470
msgctxt "text_id=11856 | speaker=unknown"
msgid "  Anyway, Aoko, you know the dicky bird behind that Japanese sportswear name?\""
msgstr "　ところで青子さん、アシックスの由来はなんスか』"

#. Occurrence 8DOT5:506:11857: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0004; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:506
msgctxt "text_id=11857 | speaker=aoko"
msgid "\"Hmm, I heard this once from a friend of mine in elementary school, so I don't know if it's true or not."
msgstr "「え？　うーん、これは私も小学校の頃、友達に聞いたものなんで真偽は分からないんだけど。"

#. Occurrence 8DOT5:512:11858: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0005; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:512
msgctxt "text_id=11858 | speaker=aoko"
msgid "  They were formed from a merger of three separate companies. So the name comes from the Japanese word for foot, ashi, and the number six, since the three CEOs would have six feet when together. It's probably just a myth.\""
msgstr "　アシックスって、もともと三つの会社が合併して出来た会社なのよ。で、三社の社長があつまると足が六本になるじゃない？　だから<足|アシ>、シックス　あくまで俗説だけどね」"

#. Occurrence 8DOT5:547:11859: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0007; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:547
msgctxt "text_id=11859 | speaker=alice"
msgid "\"...\""
msgstr "「っ―――――――」"

#. Occurrence 8DOT5:552:11860: scene=8DOT5
#: 8DOT5:552
msgctxt "text_id=11860 | speaker=unknown"
msgid "  Alice had dropped her book on the floor of the sunroom and was biting her lip."
msgstr "　サンルームでは本を床に落とし、きゅっと唇を噛んでいる有珠の姿。"

#. Occurrence 8DOT5:557:11861: scene=8DOT5
#: 8DOT5:557
msgctxt "text_id=11861 | speaker=unknown"
msgid "  She was clearly trying to feign calm and to breathe as if nothing had happened."
msgstr "　彼女は努めて冷静に、何事もなかったように呼吸を整えている。"

#. Occurrence 8DOT5:562:11862: scene=8DOT5
#: 8DOT5:562
msgctxt "text_id=11862 | speaker=unknown"
msgid "  She thought she was doing a convincing job of it."
msgstr "　少なくとも、本人はそう演じきれていると信じている。"

#. Occurrence 8DOT5:593:11863: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0006; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:593
msgctxt "text_id=11863 | speaker=aoko"
msgid "\"...I really don't understand her sense of humor or why she thinks that was so funny.\""
msgstr "「……あの子の笑いのツボも分かんないわね……」"

#. Occurrence 8DOT5:636:11864: voice_id=BA0_8DOT5_9000; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:636
msgctxt "text_id=11864 | speaker=unknown"
msgid "\"Hmm, maybe it wasn't funny at all, and she's all marbles and conkers 'bout how unfunny it was?"
msgstr "『それはどうっスかね。あんまりにもつまんなかったから怒ってるのかもしれないっス。"

#. Occurrence 8DOT5:658:11865: voice_id=BA0_8DOT5_9001; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:658
msgctxt "text_id=11865 | speaker=unknown"
msgid "I mean, Alice usually smiles even when she's angry. I've seen it. Whenever I half inch her diary to have a look at it, that's always the look she's givin'."
msgstr "だってアリスさん、怒り心頭しても笑顔になるんスよ。ジブンたまに見るッス。アリスさんの日記を盗み見てると、後ろでそういう顔してるッス。"

#. Occurrence 8DOT5:668:11866: voice_id=BA0_8DOT5_9002; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:668
msgctxt "text_id=11866 | speaker=unknown"
msgid "She's like, 'Look at that again, and I'll kill you!' But I can't help it! I wanna read it! If you take my curiosity away from me, I've got nofink left!\""
msgstr "それ以上見ると死ぬわよって。でもカンベンしてほしいッス、見ちゃうものは見ちゃうっスよー！　ジブンから素行調査をとったら、もう帰巣本能しか残らない気もするッス』"

#. Occurrence 8DOT5:702:11867: scene=8DOT5
#: 8DOT5:702
msgctxt "text_id=11867 | speaker=unknown"
msgid "  The robin felt compelled to give a counter-argument for some reason."
msgstr "　ぱたぱたと異論をはさむ駒鳥。"

#. Occurrence 8DOT5:707:11868: scene=8DOT5
#: 8DOT5:707
msgctxt "text_id=11868 | speaker=unknown"
msgid "  Aoko let out a sigh. Even Alice sympathized with her over the difficult familiar."
msgstr "　青子はため息をつきながら、有珠も厄介な使い魔を押しつけられたもんね、と同情した。"

#. Occurrence 8DOT5:734:11869: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0000; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:734
msgctxt "text_id=11869 | speaker=soujuurou"
msgid "\"I'm home! Oh, you're both here today.\""
msgstr "「ただいま。お、今日はふたりともいるんだな」"

#. Occurrence 8DOT5:740:11870: scene=8DOT5
#: 8DOT5:740
msgctxt "text_id=11870 | speaker=unknown"
msgid "  It was at this time that Soujyuro returned."
msgstr "　そんな中、草十郎が顔を見せた。"

#. Occurrence 8DOT5:745:11871: scene=8DOT5
#: 8DOT5:745
msgctxt "text_id=11871 | speaker=unknown"
msgid "  He must have just gotten home from his part-time job."
msgstr "　アルバイトから帰ってきたところらしい。"

#. Occurrence 8DOT5:779:11872: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0007; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:779
msgctxt "text_id=11872 | speaker=aoko"
msgid "\"Welcome back!\""
msgstr "「おかえりー。お疲れさまー」"

#. Occurrence 8DOT5:785:11873: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0008; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:785
msgctxt "text_id=11873 | speaker=alice"
msgid "\"...\""
msgstr "「……………」"

#. Occurrence 8DOT5:791:11874: scene=8DOT5
#: 8DOT5:791
msgctxt "text_id=11874 | speaker=unknown"
msgid "  Aoko's warm welcome was quite the opposite from the faint response from the sunroom."
msgstr "　駒鳥の話し相手で<緩|ゆる>みきった青子の出迎えと、サンルームからのかすかな反応。"

#. Occurrence 8DOT5:820:11875: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0001; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:820
msgctxt "text_id=11875 | speaker=soujuurou"
msgid "\"I already ate dinner, so I don't need anything to eat tonight."
msgstr "「夕食は済ませてきたから要らないよ。"

#. Occurrence 8DOT5:826:11876: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0002; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:826
msgctxt "text_id=11876 | speaker=soujuurou"
msgid "  I'm gonna go take a nap before my night job.\""
msgstr "　じゃ、夜のバイトにそなえてちょっと寝てくる」"

#. Occurrence 8DOT5:836:11877: scene=8DOT5
#: 8DOT5:836
msgctxt "text_id=11877 | speaker=unknown"
msgid "  Soujyuro still gave Alice a wave as he left."
msgstr "　草十郎はサンルームの有珠にも手を振って立ち去った。"

#. Occurrence 8DOT5:842:11878: scene=8DOT5
#: 8DOT5:842
msgctxt "text_id=11878 | speaker=unknown"
msgid "  The dull thud of something dropping was heard as he entered the hallway."
msgstr "　廊下に消える直前、不審な物音を立てながら。"

#. Occurrence 8DOT5:876:11879: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0008; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:876
msgctxt "text_id=11879 | speaker=aoko"
msgid "\"Hey! You dropped something!\""
msgstr "「おーい、なんか落ちたわよー」"

#. Occurrence 8DOT5:882:11880: scene=8DOT5
#: 8DOT5:882
msgctxt "text_id=11880 | speaker=unknown"
msgid "  Aoko peeked out from the sofa to yell for Soujyuro."
msgstr "　青子はソファーから顔だけ出して草十郎を呼び止めた。"

#. Occurrence 8DOT5:920:11881: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0003; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:920
msgctxt "text_id=11881 | speaker=soujuurou"
msgid "\"Ah, it's been in my pocket this whole time.\""
msgstr "「ああ、ポケットに入れっぱなしだった」"

#. Occurrence 8DOT5:926:11882: scene=8DOT5
#: 8DOT5:926
msgctxt "text_id=11882 | speaker=unknown"
msgid "  Soujyuro calmly and naturally walked back to pick up what looked to be some kind of envelope."
msgstr "　草十郎は慌てた風もなく、ごく自然に戻ってきて、床に落ちた何か―――封筒のようなもの―――に手を伸ばす。"

#. Occurrence 8DOT5:943:11883: scene=8DOT5
#: 8DOT5:943
msgctxt "text_id=11883 | speaker=unknown"
msgid "  Perhaps it was instinct, but..."
msgstr "　人間の<性|さが>だろう。"

#. Occurrence 8DOT5:948:11884: scene=8DOT5
#: 8DOT5:948
msgctxt "text_id=11884 | speaker=unknown"
msgid "  The human eye was drawn to motion, even if it was something one had no personal interest in."
msgstr "　興味はなくとも動くものは<野次馬|やじうま>根性で追ってしまう。"

#. Occurrence 8DOT5:953:11885: scene=8DOT5
#: 8DOT5:953
msgctxt "text_id=11885 | speaker=unknown"
msgid "  Aoko keenly followed Soujyuro's hand with her eyes..."
msgstr "　青子はどれどれ、と草十郎の手を目で追って―――"

#. Occurrence 8DOT5:1001:11886: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0009; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:1001
msgctxt "text_id=11886 | speaker=aoko"
msgid "\"Aha!\""
msgstr "「さ―――！」"

#. Occurrence 8DOT5:1007:11887: scene=8DOT5
#: 8DOT5:1007
msgctxt "text_id=11887 | speaker=unknown"
msgid "(A wad of cash!)"
msgstr "“札束、だっ！”"

#. Occurrence 8DOT5:1012:11888: scene=8DOT5
#: 8DOT5:1012
msgctxt "text_id=11888 | speaker=unknown"
msgid "  She had to restrain herself from shouting her thoughts out loud as she leaped up from the sofa."
msgstr "　などと、はしたない心の叫びを抑えつつ、青子はソファーから跳ね上がった。"

#. Occurrence 8DOT5:1043:11889: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0004; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:1043
msgctxt "text_id=11889 | speaker=soujuurou"
msgid "\"Huh? What's wrong, Aozaki?\""
msgstr "「？　どうした蒼崎？」"

#. Occurrence 8DOT5:1061:11890: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0010; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:1061
msgctxt "text_id=11890 | speaker=aoko"
msgid "\"Eh, umm, that's err...\""
msgstr "「え、どうしたって、その……」"

#. Occurrence 8DOT5:1067:11891: scene=8DOT5
#: 8DOT5:1067
msgctxt "text_id=11891 | speaker=unknown"
msgid "  Aoko found it difficult to come up with a proper response to the pure, innocent eyes staring back at her."
msgstr "　<汚|けが>れのない純朴な目で見つめられては、さすがの青子も言い返せない。"

#. Occurrence 8DOT5:1072:11892: scene=8DOT5
#: 8DOT5:1072
msgctxt "text_id=11892 | speaker=unknown"
msgid "  She was ashamed at how she had jumped up at the enticing sight of so much money."
msgstr "　相乗効果的に、お金を見て飛び上がった自分のがめつさに頭を抱えたくなるほどだ。"

#. Occurrence 8DOT5:1098:11893: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0011; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:1098
msgctxt "text_id=11893 | speaker=aoko"
msgid "\"I-It's nothing!"
msgstr "「な、なんでもないっ！"

#. Occurrence 8DOT5:1104:11894: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0012; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:1104
msgctxt "text_id=11894 | speaker=aoko"
msgid "  I just forgot that today was pay day... You're earning a lot more than I thought.\""
msgstr "　そうよね、フツーにアルバイトの給料日よね。……にしても、けっこうもらってんのね、アンタ」"

#. Occurrence 8DOT5:1145:11895: scene=8DOT5
#: 8DOT5:1145
msgctxt "text_id=11895 | speaker=unknown"
msgid "  There was an awkward pause before Soujyuro smiled and returned back to his room."
msgstr "　納得する青子に妙な間で笑顔を返して、草十郎は自室へ戻っていった。"

#. Occurrence 8DOT5:1176:11896: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0013; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:1176
msgctxt "text_id=11896 | speaker=aoko"
msgid "\"?\""
msgstr "「？」"

#. Occurrence 8DOT5:1187:11897: scene=8DOT5
#: 8DOT5:1187
msgctxt "text_id=11897 | speaker=unknown"
msgid "  Aoko sat back down on the sofa, still feeling a bit awkward."
msgstr "　微妙に引っかかるものを感じながら、青子もソファーに腰を下ろす。"

#. Occurrence 8DOT5:1205:11898: scene=8DOT5
#: 8DOT5:1205
msgctxt "text_id=11898 | speaker=unknown"
msgid "  ...This was what set it all off."
msgstr "　―――以上が事の発端。"

#. Occurrence 8DOT5:1211:11899: scene=8DOT5
#: 8DOT5:1211
msgctxt "text_id=11899 | speaker=unknown"
msgid "  It began a series of events that the robin would later name \"The Dosh Affair.\""
msgstr "　のちにカーモネーギー事件と駒鳥が名付けた、ありふれた<騒動|いちにち>の始まりだった。"

#. Occurrence 8DOT5:1298:11900: scene=8DOT5
#: 8DOT5:1298
msgctxt "text_id=11900 | speaker=unknown"
msgid "  It was the next day, and around the same time as the previous day's incident."
msgstr "　翌日、昨日の一件とほぼ同じ時間。"

#. Occurrence 8DOT5:1314:11901: scene=8DOT5
#: 8DOT5:1314
msgctxt "text_id=11901 | speaker=unknown"
msgid "  Aoko was coming to pour some tea and relax when she heard Soujyuro and the robin engaged in some kind of debate in the drawing room."
msgstr "　青子が息抜きをかねて紅茶を淹れに来ると、居間では草十郎と駒鳥が何やら議論を交わしていた。"

#. Occurrence 8DOT5:1348:11902: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0005; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:1348
msgctxt "text_id=11902 | speaker=soujuurou"
msgid "\"What they mean is that you should try to be kind in some way every time you meet someone. Then, when that day ends, you need to take time to reflect on what that kindness has brought you."
msgstr "「その人が言うには、人と会うたびに小さな親切を尽くしてあげるべきだ、と。そうして一日が終わったら、その親切が何をもたらしたか、よくかみしめなさいって。"

#. Occurrence 8DOT5:1359:11903: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0006; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:1359
msgctxt "text_id=11903 | speaker=soujuurou"
msgid "  Even if it's just a kind word, it might mean a lot to someone and could bring great and unexpected happiness your way.\""
msgstr "　たった一回の言葉だけの親切でも、相手にとっては大きな意味があるんだそうだ。それが思いも寄らない幸福を運んでくる」"

#. Occurrence 8DOT5:1404:11904: voice_id=BA0_8DOT5_0006; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:1404
msgctxt "text_id=11904 | speaker=unknown"
msgid "\"Ah, so that's why you gave me some beef jerky?"
msgstr "『うはっ、だからジブンにビーフジャーキーくれたっスか！"

#. Occurrence 8DOT5:1410:11905: voice_id=BA0_8DOT5_0007; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:1410
msgctxt "text_id=11905 | speaker=unknown"
msgid "  Are you sure that wasn't just a bribe? I can see right through you, lad!\""
msgstr "　でもそれ、親切じゃなくてソデノシタって言う伝統芸能じゃないっスかね？　アンダーハート見え見えッス』"

#. Occurrence 8DOT5:1430:11906: scene=8DOT5
#: 8DOT5:1430
msgctxt "text_id=11906 | speaker=unknown"
msgid "  Soujyuro's serious demeanor was more like a consultation or a proposal than it was idle chatter."
msgstr "　草十郎の真剣さは、雑談というより相談・勧誘の<類|たぐい>に見える。"

#. Occurrence 8DOT5:1452:11907: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0014; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:1452
msgctxt "text_id=11907 | speaker=aoko"
msgid "\"Well, I guess he's just being a weirdo like normal...\""
msgstr "「……まあ、アイツが妙なのはいつものコトか……」"

#. Occurrence 8DOT5:1457:11908: scene=8DOT5
#: 8DOT5:1457
msgctxt "text_id=11908 | speaker=unknown"
msgid "  Aoko decided to ignore what was going on in the drawing room and head straight for the sunroom."
msgstr "　青子は居間の様子をスルーしてサンルームに入る。"

#. Occurrence 8DOT5:1462:11909: scene=8DOT5
#: 8DOT5:1462
msgctxt "text_id=11909 | speaker=unknown"
msgid "  There, she saw Soujyuro's coat on the chair."
msgstr "　……と、椅子には草十郎のコートがかけられていた。"

#. Occurrence 8DOT5:1486:11910: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0015; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:1486
msgctxt "text_id=11910 | speaker=aoko"
msgid "\"Soujyuro, you've just left your coat here!"
msgstr "「ちょっと草十郎、コート置きっぱなしじゃない。"

#. Occurrence 8DOT5:1492:11911: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0016; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:1492
msgctxt "text_id=11911 | speaker=aoko"
msgid "  Take this to the coat rack in the drawing room or back to your...\""
msgstr "　居間のコート掛けか、自分の部屋に持っていって―――」"

#. Occurrence 8DOT5:1498:11912: scene=8DOT5
#: 8DOT5:1498
msgctxt "text_id=11912 | speaker=unknown"
msgid "  She stopped herself mid-sentence."
msgstr "　いいかけて、言葉を飲む。"

#. Occurrence 8DOT5:1549:11913: scene=8DOT5
#: 8DOT5:1549
msgctxt "text_id=11913 | speaker=unknown"
msgid "  She could see the same kind of envelope that Soujyuro had dropped on the ground yesterday inside his coat pocket."
msgstr "　草十郎のコートのポケットから、昨日と同じような封筒が顔を覗かせていた。"

#. Occurrence 8DOT5:1554:11914: scene=8DOT5
#: 8DOT5:1554
msgctxt "text_id=11914 | speaker=unknown"
msgid "  And it was even thicker than the one she saw the day before."
msgstr "　それも昨日よりいくぶん厚く、あまりにも無造作に。"

#. Occurrence 8DOT5:1580:11915: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0017; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:1580
msgctxt "text_id=11915 | speaker=aoko"
msgid "\"H-Hmm.\""
msgstr "「ふ、ふーん」"

#. Occurrence 8DOT5:1585:11916: scene=8DOT5
#: 8DOT5:1585
msgctxt "text_id=11916 | speaker=unknown"
msgid "  She wouldn't allow herself to make a spectacle about it like she did yesterday."
msgstr "　昨日のような、大金に目を輝かす愚は犯せない。"

#. Occurrence 8DOT5:1590:11917: scene=8DOT5
#: 8DOT5:1590
msgctxt "text_id=11917 | speaker=unknown"
msgid "  She reminded herself that she was a model student and student council president."
msgstr "　青子とて学園の模範生たる生徒会長の自覚はあるのだ。"

#. Occurrence 8DOT5:1616:11918: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0018; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:1616
msgctxt "text_id=11918 | speaker=aoko"
msgid "\"A-Anyway, it's time for some tea.\""
msgstr "「さ、さーて、紅茶紅茶っと」"

#. Occurrence 8DOT5:1622:11919: scene=8DOT5
#: 8DOT5:1622
msgctxt "text_id=11919 | speaker=unknown"
msgid "  Feigning disinterest, she listened in on the conversation going on in the drawing room."
msgstr "　無関心を装いつつ、居間の会話に聞き耳を立てる。"

#. Occurrence 8DOT5:1627:11920: scene=8DOT5
#: 8DOT5:1627
msgctxt "text_id=11920 | speaker=unknown"
msgid "  Soujyuro was still in deep conversation with the robin. Perhaps he hadn't heard her calls."
msgstr "　青子の呼びかけが聞こえなかったのか、草十郎は駒鳥との雑談に夢中だった。"

#. Occurrence 8DOT5:1660:11921: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0007; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:1660
msgctxt "text_id=11921 | speaker=soujuurou"
msgid "\"Everyone feels lonely in a city."
msgstr "「都会の孤独は万人に平等だ。"

#. Occurrence 8DOT5:1666:11922: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0008; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:1666
msgctxt "text_id=11922 | speaker=soujuurou"
msgid "  Acts of kindness, even if they look like they are done for selfish reasons at first, can do real good in the long run.\""
msgstr "　一見して身勝手な、暴力じみたお仕着せの善意も、長い目で見ればその人のためになる」"

#. Occurrence 8DOT5:1685:11923: voice_id=BA0_8DOT5_0008; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:1685
msgctxt "text_id=11923 | speaker=unknown"
msgid "\"I see... And it don't cost a thing to be kind to people! I'm tryin' to help people as much as I can now!\""
msgstr "『なるほどー。親切の押しつけには<一銭|いっせん>もかからないッスからね！　ジャンジャン人助けするッスよ』"

#. Occurrence 8DOT5:1706:11924: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0009; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:1706
msgctxt "text_id=11924 | speaker=soujuurou"
msgid "\"True, though they say nothing in life is truly free.\""
msgstr "「うん。タダより高いものはないって言うけどね」"

#. Occurrence 8DOT5:1727:11925: voice_id=BA0_8DOT5_0009; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:1727
msgctxt "text_id=11925 | speaker=unknown"
msgid "\"Hahaha! So which is it then, o wise one?\""
msgstr "『ハハハどっちっスかこのシャバ僧！』"

#. Occurrence 8DOT5:1763:11926: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0019; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:1763
msgctxt "text_id=11926 | speaker=aoko"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 8DOT5:1769:11927: scene=8DOT5
#: 8DOT5:1769
msgctxt "text_id=11927 | speaker=unknown"
msgid "  Aoko was so intent on eavesdropping, she'd completely forgotten that she'd come to pour a cup of tea."
msgstr "　自分の用事……紅茶を淹れに来た……も忘れて、青子は居間からの声に耳をすませる。"

#. Occurrence 8DOT5:1774:11928: scene=8DOT5
#: 8DOT5:1774
msgctxt "text_id=11928 | speaker=unknown"
msgid "  There was no way she could ignore such a suspicious conversation."
msgstr "　これはもう、無視できる<怪|あや>しさではない。"

#. Occurrence 8DOT5:1809:11929: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0010; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:1809
msgctxt "text_id=11929 | speaker=soujuurou"
msgid "\"Well, let me put it this way. If you want to be happy, you must first be hated."
msgstr "「こうも言うんだ。幸福になりたければ、はじめは恨まれてもいいと。"

#. Occurrence 8DOT5:1815:11930: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0011; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:1815
msgctxt "text_id=11930 | speaker=soujuurou"
msgid "  People shouldn't care if they're called a scam artist, for example. They just need to realize that what they're doing is for the good of others."
msgstr "　やれ金を返せだの詐欺師だのと言われても、いずれその人のためになると分かっていれば心を鬼にできる。"

#. Occurrence 8DOT5:1822:11931: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0012; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:1822
msgctxt "text_id=11931 | speaker=soujuurou"
msgid "The joy you give to others will cancel out the sense of guilt you might feel.\""
msgstr "人に尽くしている喜びが、後ろめたさとか帳消しにするらしい」"

#. Occurrence 8DOT5:1841:11932: voice_id=BA0_8DOT5_0010; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:1841
msgctxt "text_id=11932 | speaker=unknown"
msgid "\"I've heard somefink like that, but what you're saying's different.\""
msgstr "『それ知ってるッス。でも、微妙に違うような』"

#. Occurrence 8DOT5:1876:11933: scene=8DOT5
#: 8DOT5:1876
msgctxt "text_id=11933 | speaker=unknown"
msgid "  Aoko agreed with the robin in this case."
msgstr "　不本意ではあるが、青子は駒鳥に同意する。"

#. Occurrence 8DOT5:1881:11934: scene=8DOT5
#: 8DOT5:1881
msgctxt "text_id=11934 | speaker=unknown"
msgid "  Soujyuro was referring to the words of a famous entrepreneur,"
msgstr "　今のは有名な事業家の言葉で、正しくは"

#. Occurrence 8DOT5:1887:11935: scene=8DOT5
#: 8DOT5:1887
msgctxt "text_id=11935 | speaker=unknown"
msgid "\"If we want to find happiness, let's stop thinking about gratitude or ingratitude and give for the inner joy of giving.\""
msgstr "“幸せになりたければ、誰が恩を返した、誰が恩を返さないなどと考えるのはやめて、人に貢献できる喜びを大切にしよう”"

#. Occurrence 8DOT5:1893:11936: scene=8DOT5
#: 8DOT5:1893
msgctxt "text_id=11936 | speaker=unknown"
msgid "  That was the actual quote."
msgstr "　だったはずだ。"

#. Occurrence 8DOT5:1928:11937: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0013; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:1928
msgctxt "text_id=11937 | speaker=soujuurou"
msgid "\"In other words..."
msgstr "「あるいはこうとも。"

#. Occurrence 8DOT5:1934:11938: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0014; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:1934
msgctxt "text_id=11938 | speaker=soujuurou"
msgid "  People should not save up their wealth. Instead, they are bound to administer it to help their company prosper.\""
msgstr "　貯金のある人は、その富を温存するよりも、会社がより豊かになるために使うべきだと」"

#. Occurrence 8DOT5:1941:11939: voice_id=BA0_8DOT5_0011; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:1941
msgctxt "text_id=11939 | speaker=unknown"
msgid "\"I know that one, too. But you've got it all dodgy this time.\""
msgstr "『それも知ってるッス。でも、もう完全に違うような』"

#. Occurrence 8DOT5:1973:11940: scene=8DOT5
#: 8DOT5:1973
msgctxt "text_id=11940 | speaker=unknown"
msgid "  Aoko was becoming upset with how much she was agreeing with the robin at this point."
msgstr "　<甚|はなは>だ不本意ではあるが、またも青子は同意する。"

#. Occurrence 8DOT5:1980:11941: scene=8DOT5
#: 8DOT5:1980
msgctxt "text_id=11941 | speaker=unknown"
msgid "  This was a quote from an even more famous entrepreneur,"
msgstr "　今のはより有名な実業家の言葉で、正しくは"

#. Occurrence 8DOT5:1986:11942: scene=8DOT5
#: 8DOT5:1986
msgctxt "text_id=11942 | speaker=unknown"
msgid "\"Surplus wealth is a sacred trust which its possessor is bound to administer in his lifetime for the good of the community.\""
msgstr "“富める者は、その富を社会の改善のために使うべきである”"

#. Occurrence 8DOT5:1992:11943: scene=8DOT5
#: 8DOT5:1992
msgctxt "text_id=11943 | speaker=unknown"
msgid "  This was how that one was supposed to go."
msgstr "　だったはず。"

#. Occurrence 8DOT5:2027:11944: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0015; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2027
msgctxt "text_id=11944 | speaker=soujuurou"
msgid "\"The only thing you can trust in life is money."
msgstr "「信じられるのはお金だけなのかもしれない。"

#. Occurrence 8DOT5:2033:11945: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0016; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2033
msgctxt "text_id=11945 | speaker=soujuurou"
msgid "  Even if you're married with children, it's not like they're always going to be by your side. They could die in an unfortunate accident and leave you behind."
msgstr "　だって奥さんも子供も、ずっと一緒にいてくれるわけじゃない。不幸な事故で先立たれるコトだってある。"

#. Occurrence 8DOT5:2039:11946: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0017; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2039
msgctxt "text_id=11946 | speaker=soujuurou"
msgid "  Money is different. You can't buy happiness, but happiness can bring you wealth. They said that as long as you have the kindness of others and a warm bed to sleep in, you don't need anything else.\""
msgstr "　でもお金は別だった。お金で幸福は買えないけど、幸福はお金になる。いまは人の親切と、温かい布団があればそれでいいと、その人は言った」"

#. Occurrence 8DOT5:2073:11947: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0020; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2073
msgctxt "text_id=11947 | speaker=aoko"
msgid "\"Whatever he's talking about is not like him at all...\""
msgstr "「なんか……無性にらしくないコト言ってるわね、アイツ」"

#. Occurrence 8DOT5:2081:11948: scene=8DOT5
#: 8DOT5:2081
msgctxt "text_id=11948 | speaker=unknown"
msgid "  Though his words were a bit strange and worrisome, Aoko couldn't spend much time worrying about it."
msgstr "　<一抹|いちまつ>の不安を覚えるものの、草十郎の発言を気にしていては日が暮れる。"

#. Occurrence 8DOT5:2086:11949: scene=8DOT5
#: 8DOT5:2086
msgctxt "text_id=11949 | speaker=unknown"
msgid "  She didn't have the capacity to worry about anyone else right now."
msgstr "　第一、今の青子には<他人|ひと>に神経をさく余裕はない。"

#. Occurrence 8DOT5:2091:11950: scene=8DOT5
#: 8DOT5:2091
msgctxt "text_id=11950 | speaker=unknown"
msgid "  Her battle with the enemy mage was always lurking just beneath the surface."
msgstr "　敵魔術師との戦いは目下、水面下で進行中なのだ。"

#. Occurrence 8DOT5:2124:11951: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0021; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2124
msgctxt "text_id=11951 | speaker=aoko"
msgid "\"This isn't any of my business anyway.\""
msgstr "「どっちにしろ私には関係ないか」"

#. Occurrence 8DOT5:2130:11952: scene=8DOT5
#: 8DOT5:2130
msgctxt "text_id=11952 | speaker=unknown"
msgid "  Aoko shrugged it off and turned her attention away from the drawing room."
msgstr "　やれやれと肩をすくめて、青子は居間から意識を逸らした。"

#. Occurrence 8DOT5:2135:11953: scene=8DOT5
#: 8DOT5:2135
msgctxt "text_id=11953 | speaker=unknown"
msgid "  She told herself that she would forget about all this commotion by tomorrow anyway."
msgstr "　こんな騒ぎも明日になれば忘れるだろう、と楽観して。"

#. Occurrence 8DOT5:2228:11954: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0018; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2228
msgctxt "text_id=11954 | speaker=soujuurou"
msgid "\"I'm hooooome!\""
msgstr "「ただいまー」"

#. Occurrence 8DOT5:2271:11955: scene=8DOT5
#: 8DOT5:2271
msgctxt "text_id=11955 | speaker=unknown"
msgid "  Soujyuro was back from his job with a smile on his face again today."
msgstr "　今日も今日とて笑顔で帰ってくる勤労少年。"

#. Occurrence 8DOT5:2276:11956: scene=8DOT5
#: 8DOT5:2276
msgctxt "text_id=11956 | speaker=unknown"
msgid "  Work truly was its own reward."
msgstr "　何であれ労働は美しい。"

#. Occurrence 8DOT5:2281:11957: scene=8DOT5
#: 8DOT5:2281
msgctxt "text_id=11957 | speaker=unknown"
msgid "  His mood was infectious, and Aoko smiled back while relaxing on the sofa."
msgstr "　なので、ソファーでくつろぐ青子の返答も自然、微笑ましいものになる。"

#. Occurrence 8DOT5:2312:11958: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0022; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2312
msgctxt "text_id=11958 | speaker=aoko"
msgid "\"Hey, welcome home."
msgstr "「はい、おつかれさま。"

#. Occurrence 8DOT5:2318:11959: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0023; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2318
msgctxt "text_id=11959 | speaker=aoko"
msgid "  Take a load off. You've been working since noon today, haven't you?"
msgstr "　休んでていいわよ。今日は昼からずっとバイトだったんでしょ。"

#. Occurrence 8DOT5:2326:11960: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0024; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2326
msgctxt "text_id=11960 | speaker=aoko"
msgid "I'll go start making something for di―"
msgstr "夕飯ならこれから作ってあ―――"

msgctxt "text_id=11961 | speaker=unknown"
msgid " What...?\""
msgstr "なにぃ？」"

#. Occurrence 8DOT5:2339:11962: scene=8DOT5
#: 8DOT5:2339
msgctxt "text_id=11962 | speaker=unknown"
msgid "  Her smile suddenly turned frigid."
msgstr "　が。その笑顔も、唐突に凍りついた。"

#. Occurrence 8DOT5:2372:11963: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0019; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2372
msgctxt "text_id=11963 | speaker=soujuurou"
msgid "\"Hm? What's wrong, Aozaki? You look like you just heard one of Kinomi's jokes.\""
msgstr "「ん？　どうした蒼崎、木乃美の冗談を聞いた時みたいな顔して」"

#. Occurrence 8DOT5:2383:11964: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0025; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2383
msgctxt "text_id=11964 | speaker=aoko"
msgid "\"Don't play dumb with me! I can't keep quiet about this any longer!"
msgstr "「どうしたじゃない、いいかげん黙っていられなくなった！"

#. Occurrence 8DOT5:2383:11965: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0025; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2383
msgctxt "text_id=11965 | speaker=aoko"
msgid "  Empty your pockets. Right now!\""
msgstr "　いいから、そのポケットの<物|もん>だしなさい！」"

#. Occurrence 8DOT5:2403:11966: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0020; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2403
msgctxt "text_id=11966 | speaker=soujuurou"
msgid "\"Err...\""
msgstr "「む」"

#. Occurrence 8DOT5:2423:11967: scene=8DOT5
#: 8DOT5:2423
msgctxt "text_id=11967 | speaker=unknown"
msgid "  Soujyuro reached in and pulled out the contents of his pockets without knowing why he was being scolded."
msgstr "　なぜ<叱|しか>られるのか納得いかないまま、草十郎はポケットの中の物を取り出した。"

#. Occurrence 8DOT5:2457:11968: scene=8DOT5
#: 8DOT5:2457
msgctxt "text_id=11968 | speaker=unknown"
msgid "  He placed the now all too familiar brown envelope on the table."
msgstr "　テーブルに置かれる、お馴染みの茶封筒。"

#. Occurrence 8DOT5:2463:11969: scene=8DOT5
#: 8DOT5:2463
msgctxt "text_id=11969 | speaker=unknown"
msgid "  It was far too thick to be any normal envelope."
msgstr "　しかし、それは普通の封筒と言うにはぶ厚すぎた。"

#. Occurrence 8DOT5:2469:11970: scene=8DOT5
#: 8DOT5:2469
msgctxt "text_id=11970 | speaker=unknown"
msgid "  Bright and enticing, it was imbued with a enchanting aura all its own..."
msgstr "　<眩|まぶ>しく、<荘厳|そうごん>で、人を惑わす魔力がありすぎた。"

#. Occurrence 8DOT5:2476:11971: scene=8DOT5
#: 8DOT5:2476
msgctxt "text_id=11971 | speaker=unknown"
msgid "  There was nothing else it could be than a stack of cash."
msgstr "　なんていうか、それはまさしく札束だった。"

#. Occurrence 8DOT5:2511:11972: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0009; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:2511
msgctxt "text_id=11972 | speaker=alice"
msgid "\"Well. What do we have here?\""
msgstr "「―――まあ。これはどうしたの、静希君」"

#. Occurrence 8DOT5:2517:11973: scene=8DOT5
#: 8DOT5:2517
msgctxt "text_id=11973 | speaker=unknown"
msgid "  Alice innocently asked Soujyuro."
msgstr "　あどけない有珠の声。"

#. Occurrence 8DOT5:2522:11974: scene=8DOT5
#: 8DOT5:2522
msgctxt "text_id=11974 | speaker=unknown"
msgid "  She was a bit dazzled at the sight, but there was no mistaking it for an illusion."
msgstr "　心なしか目が輝いているように見えるが、間違いなく錯覚ではない。"

#. Occurrence 8DOT5:2560:11975: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0021; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2560
msgctxt "text_id=11975 | speaker=soujuurou"
msgid "\"It's my pay from my part-time job.\""
msgstr "「バイト代だよ」"

#. Occurrence 8DOT5:2578:11976: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0010; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:2578
msgctxt "text_id=11976 | speaker=alice"
msgid "\"Well isn't that nice? Looks like dinner is on you tomorrow, then.\""
msgstr "「そう。それはいいコトだわ。明日はご馳走ね」"

#. Occurrence 8DOT5:2584:11977: scene=8DOT5
#: 8DOT5:2584
msgctxt "text_id=11977 | speaker=unknown"
msgid "  The two remained calm, despite the abnormally large wad of cash before them."
msgstr "　札束を前にしても淡々としたふたりである。"

#. Occurrence 8DOT5:2589:11978: scene=8DOT5
#: 8DOT5:2589
msgctxt "text_id=11978 | speaker=unknown"
msgid "  That being said, the one with the most common sense in the house finally had to speak up."
msgstr "　一方、この<館|いえ>唯一の常識人はと言うと、"

#. Occurrence 8DOT5:2625:11979: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0026; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2625
msgctxt "text_id=11979 | speaker=aoko"
msgid "\"I know you're lying! Soujyuro, you kneel right here and explain to me what is going on!\""
msgstr "「んなワケないでしょう！？　ちょっと草十郎、そこに正座！　どういうコトか説明なさい！」"

#. Occurrence 8DOT5:2631:11980: scene=8DOT5
#: 8DOT5:2631
msgctxt "text_id=11980 | speaker=unknown"
msgid "  She knew more than anyone how serious this was."
msgstr "　この通り、コトの重大さを当事者より理解していた。"

#. Occurrence 8DOT5:2657:11981: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0022; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2657
msgctxt "text_id=11981 | speaker=soujuurou"
msgid "\"Huh? Explain what?\""
msgstr "「？　説明って、なにをだ？」"

#. Occurrence 8DOT5:2668:11982: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0027; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2668
msgctxt "text_id=11982 | speaker=aoko"
msgid "\"Explain where you got this money!"
msgstr "「決まってるでしょ、この札束の正体よ！"

#. Occurrence 8DOT5:2674:11983: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0028; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2674
msgctxt "text_id=11983 | speaker=aoko"
msgid "  What the hell are you doing to earn this kind of cash? There's no way it's anything legal!\""
msgstr "　アンタいま何やってんの！？　どう考えてもまっとうな職種とは思えないんですけど！？」"

#. Occurrence 8DOT5:2700:11984: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0023; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2700
msgctxt "text_id=11984 | speaker=soujuurou"
msgid "\"It really is fine!"
msgstr "「まっとうだぞ。"

#. Occurrence 8DOT5:2706:11985: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0024; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2706
msgctxt "text_id=11985 | speaker=soujuurou"
msgid "  This new job I got is at least not illegal. And if I do it properly, it's not dangerous at all."
msgstr "　この新しいバイトは、少なくとも法には触れていないと聞いた。ちゃんとやれば危ない目にも遭わない。"

#. Occurrence 8DOT5:2712:11986: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0025; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2712
msgctxt "text_id=11986 | speaker=soujuurou"
msgid "  It pays better than the convenience store, and it's easy enough that even I can handle it without a problem.\""
msgstr "　コンビニエンスストアより割がいいし、俺でも簡単にできると言う」"

#. Occurrence 8DOT5:2752:11987: scene=8DOT5
#: 8DOT5:2752
msgctxt "text_id=11987 | speaker=unknown"
msgid "  Unbelievable."
msgstr "　クラッと。"

#. Occurrence 8DOT5:2757:11988: scene=8DOT5
#: 8DOT5:2757
msgctxt "text_id=11988 | speaker=unknown"
msgid "  Aoko was just about dizzy with rage by this point."
msgstr "　青子は失意を通り越した苛立ちのあまり、目眩を起こしかけた。"

#. Occurrence 8DOT5:2762:11989: scene=8DOT5
#: 8DOT5:2762
msgctxt "text_id=11989 | speaker=unknown"
msgid "(At least not illegal.)"
msgstr "“少なくとも法には触れていない”"

#. Occurrence 8DOT5:2767:11990: scene=8DOT5
#: 8DOT5:2767
msgctxt "text_id=11990 | speaker=unknown"
msgid "  That's like when an obviously drunk person tries to contend that they are indeed quite the contrary."
msgstr "　泥酔した酔っぱらいが“酔っていない”と言い張るのと何が違おう。"

#. Occurrence 8DOT5:2802:11991: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0029; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2802
msgctxt "text_id=11991 | speaker=aoko"
msgid "\"Use your brain! What kind of part-time job pays out more and more money exponentially every day?"
msgstr "「正気に戻れ！　日ごとお金が倍々に増えていくバイトなんてあるワケないでしょう？"

#. Occurrence 8DOT5:2808:11992: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0030; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2808
msgctxt "text_id=11992 | speaker=aoko"
msgid "  Tell us exactly what you're doing! You are being scammed! You have to be!\""
msgstr "　いいから仕事の内容を言いなさい、内容を！　アンタ、どう考えても騙されてるから！」"

#. Occurrence 8DOT5:2826:11993: scene=8DOT5
#: 8DOT5:2826
msgctxt "text_id=11993 | speaker=unknown"
msgid "  Soujyuro kept his mouth shut."
msgstr "　む、と草十郎は口を閉ざす。"

#. Occurrence 8DOT5:2831:11994: scene=8DOT5
#: 8DOT5:2831
msgctxt "text_id=11994 | speaker=unknown"
msgid "  He didn't seem to be too threatened by Aoko's reprimands."
msgstr "　青子の剣幕を前にして一歩も引かない構えだ。"

#. Occurrence 8DOT5:2865:11995: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0026; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2865
msgctxt "text_id=11995 | speaker=soujuurou"
msgid "\"Sorry, I can't. Not even to you. It's not really something I'm supposed to talk about."
msgstr "「だめだ。いくら蒼崎でも教えられない。あんまり<他人|ひと>に話すことでもない。"

#. Occurrence 8DOT5:2871:11996: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0027; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:2871
msgctxt "text_id=11996 | speaker=soujuurou"
msgid "  But please, don't worry. It's honestly something that helps people. I've only met the person who recommended me for the job once, and I'm always paid in cash.\""
msgstr "　でも安心してくれ。分類的には、ちょっとした人助けと言えるだろう。あと紹介してくれた人とは一度しか会ってないし、支払いは常に現金だ」"

#. Occurrence 8DOT5:2877:11997: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0031; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:2877
msgctxt "text_id=11997 | speaker=aoko"
msgid "\"You bumpkin! All of that sounds suspicious as hell!\""
msgstr "「この田舎バカ、その文脈からして怪しすぎるんだっていうのーーー！」"

#. Occurrence 8DOT5:2910:11998: scene=8DOT5
#: 8DOT5:2910
msgctxt "text_id=11998 | speaker=unknown"
msgid "  Aoko stamped her foot in frustration."
msgstr "　ああもう、と地団駄を踏む青子。"

#. Occurrence 8DOT5:2915:11999: scene=8DOT5
#: 8DOT5:2915
msgctxt "text_id=11999 | speaker=unknown"
msgid "  But who could blame her after hearing the standard lines for a scam: \"it's a new job,\" \"the pay is good and anyone can do it,\" and \"I'm not supposed to talk about it.\""
msgstr "『新しいバイト』『割がいい、誰でもできる』『だが内容公開は断る』なんて禁句を連発されて、冷静でいられるはずがない。"

#. Occurrence 8DOT5:2935:12000: scene=8DOT5
#: 8DOT5:2935
msgctxt "text_id=12000 | speaker=unknown"
msgid "  Despite all that..."
msgstr "　が、"

#. Occurrence 8DOT5:2954:12001: scene=8DOT5
#: 8DOT5:2954
msgctxt "text_id=12001 | speaker=unknown"
msgid "  Soujyuro was still refusing to spill the beans."
msgstr "　草十郎はかたくなに口を閉ざしている。"

#. Occurrence 8DOT5:2959:12002: scene=8DOT5
#: 8DOT5:2959
msgctxt "text_id=12002 | speaker=unknown"
msgid "  They hadn't known each other for that long, but Aoko was well aware of Soujyuro's personality."
msgstr "　付き合いは短いが、青子はこの少年の性格をそれなりに思い知っている。"

#. Occurrence 8DOT5:2964:12003: scene=8DOT5
#: 8DOT5:2964
msgctxt "text_id=12003 | speaker=unknown"
msgid "  *Steadfast* explained him well. Once he made a decision, nothing could make him change his mind about it."
msgstr "　義理堅いというか、自分の中でこれと決めた事はちょっとやそっとでは<覆|くつがえ>らないのだ。"

#. Occurrence 8DOT5:2969:12004: scene=8DOT5
#: 8DOT5:2969
msgctxt "text_id=12004 | speaker=unknown"
msgid "  At times like this, it was near impossible to get him to talk."
msgstr "　こういう時の草十郎はとんでもなく口が堅い。"

#. Occurrence 8DOT5:3004:12005: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0032; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:3004
msgctxt "text_id=12005 | speaker=aoko"
msgid "\"Argh... You really are making this difficult...\""
msgstr "「……くぅ、厄介な……」"

#. Occurrence 8DOT5:3010:12006: scene=8DOT5
#: 8DOT5:3010
msgctxt "text_id=12006 | speaker=unknown"
msgid "  Aoko backed off, realizing it would be a challenge to get him to say anything at this point."
msgstr "　無理やり<喋|しゃべ>らせるのは困難か、と青子は引き下がる。"

#. Occurrence 8DOT5:3030:12007: scene=8DOT5
#: 8DOT5:3030
msgctxt "text_id=12007 | speaker=unknown"
msgid "  Soujyuro couldn't figure out what was upsetting her."
msgstr "　そんな彼女の内心をまったく分かっていないらしく、草十郎は不思議そうに、"

#. Occurrence 8DOT5:3053:12008: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0028; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:3053
msgctxt "text_id=12008 | speaker=soujuurou"
msgid "\"Why are you so mad?\""
msgstr "「なんで蒼崎は怒ってるんだ？」"

#. Occurrence 8DOT5:3077:12009: scene=8DOT5
#: 8DOT5:3077
msgctxt "text_id=12009 | speaker=unknown"
msgid "  Aoko decided to give up on getting anything useful out of him."
msgstr "　うん、こいつは役に立たない、と諦める青子。"

#. Occurrence 8DOT5:3116:12010: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0033; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:3116
msgctxt "text_id=12010 | speaker=aoko"
msgid "\"There's just no job in the world like that. It's too good to be true. You agree, right, Alice?\""
msgstr "「そんなうまい話はないからよ。有珠もそう思うでしょう？」"

#. Occurrence 8DOT5:3140:12011: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0011; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:3140
msgctxt "text_id=12011 | speaker=alice"
msgid "\"Hmm, I suppose. I'm not sure what Aoko is trying to say, but I think you can do more, Sizuki.\""
msgstr "「そうね。青子の言いたいコトは分からないけど、静希君はもっとやるべきだと思う」"

#. Occurrence 8DOT5:3164:12012: scene=8DOT5
#: 8DOT5:3164
msgctxt "text_id=12012 | speaker=unknown"
msgid "  And so, Alice contributed absolutely nothing useful."
msgstr "　そして有珠は、はじめから役に立たない。"

#. Occurrence 8DOT5:3199:12013: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0034; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:3199
msgctxt "text_id=12013 | speaker=aoko"
msgid "\"...Ugh.\""
msgstr "「…………はあ」"

#. Occurrence 8DOT5:3205:12014: scene=8DOT5
#: 8DOT5:3205
msgctxt "text_id=12014 | speaker=unknown"
msgid "  Aoko collapsed onto the sofa."
msgstr "　青子はソファーに腰を落とす。"

#. Occurrence 8DOT5:3226:12015: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0029; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:3226
msgctxt "text_id=12015 | speaker=soujuurou"
msgid "\"Aozaki...\""
msgstr "「蒼崎」"

#. Occurrence 8DOT5:3232:12016: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0035; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:3232
msgctxt "text_id=12016 | speaker=aoko"
msgid "\"It's fine. I know you don't want to talk about it."
msgstr "「いいわよ、もう。よく分かんない理由で話す気ないんでしょ、草十郎は。"

#. Occurrence 8DOT5:3238:12017: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0036; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:3238
msgctxt "text_id=12017 | speaker=aoko"
msgid "  And when it comes down to it, you're just a roommate. There's no point in me trying to tell you what to do with your life.\""
msgstr "　考えてみればアンタなんてただの同居人なワケだし、私があれこれ文句いう筋合いはなかったわ」"

#. Occurrence 8DOT5:3267:12018: scene=8DOT5
#: 8DOT5:3267
msgctxt "text_id=12018 | speaker=unknown"
msgid "  Aoko shooed Soujyuro away with her hand."
msgstr "　しっしっ、と手を振って草十郎を追っ払う。"

#. Occurrence 8DOT5:3272:12019: scene=8DOT5
#: 8DOT5:3272
msgctxt "text_id=12019 | speaker=unknown"
msgid "  Unfortunately, she wasn't going to be able to sit there and stew like she wanted to."
msgstr "　それっきり不機嫌に押し黙る青子だが、もちろん、このまま済ませる気はない。"

#. Occurrence 8DOT5:3277:12020: scene=8DOT5
#: 8DOT5:3277
msgctxt "text_id=12020 | speaker=unknown"
msgid "  She couldn't just ignore this problem like Alice."
msgstr "　有珠の見解はともかく、草十郎を放っておく事はできないからだ。"

#. Occurrence 8DOT5:3303:12021: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0037; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:3303
msgctxt "text_id=12021 | speaker=aoko"
msgid "\"He's clearly being scammed. In the end, it's going to affect me too if I don't do something about it...\""
msgstr "「……アイツはどう見ても騙されてるし……最終的にとばっちりくらうのは私だし……」"

#. Occurrence 8DOT5:3309:12022: scene=8DOT5
#: 8DOT5:3309
msgctxt "text_id=12022 | speaker=unknown"
msgid "  She needed to be bold and make him quit this new job of his immediately."
msgstr "　ここは心を鬼にして、今すぐにでも新しいバイトとやらを辞めさせるべきである。"

#. Occurrence 8DOT5:3314:12023: scene=8DOT5
#: 8DOT5:3314
msgctxt "text_id=12023 | speaker=unknown"
msgid "  It was what a true friend would do,"
msgstr "　それが友人としての思いやりであり、"

#. Occurrence 8DOT5:3319:12024: scene=8DOT5
#: 8DOT5:3319
msgctxt "text_id=12024 | speaker=unknown"
msgid "  and it was also her duty as the student council president."
msgstr "　生徒会長としての義務だろう。"

#. Occurrence 8DOT5:3345:12025: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0038; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:3345
msgctxt "text_id=12025 | speaker=aoko"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence 8DOT5:3351:12026: scene=8DOT5
#: 8DOT5:3351
msgctxt "text_id=12026 | speaker=unknown"
msgid "  However..."
msgstr "　しかし。"

#. Occurrence 8DOT5:3356:12027: scene=8DOT5
#: 8DOT5:3356
msgctxt "text_id=12027 | speaker=unknown"
msgid "  Aoko started to think otherwise."
msgstr "　しかしだ、と青子は自分に言い聞かせる。"

#. Occurrence 8DOT5:3361:12028: scene=8DOT5
#: 8DOT5:3361
msgctxt "text_id=12028 | speaker=unknown"
msgid "  Morals and a clear conscience were important, sure, but for a student living solely off of their parents' generosity, that kind of money was hard to pass up!"
msgstr "　道徳も良心も大切だが、正直なところ、仕送りだけで生きている学生として、あのお金は捨てがたい……！"

#. Occurrence 8DOT5:3392:12029: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0039; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:3392
msgctxt "text_id=12029 | speaker=aoko"
msgid "\"...Right. So, even if I do get him to quit the job, it would be a total waste for him to just give all that money up..."
msgstr "「……そうね。最終的に辞めさせるのは絶対にしても、これまで稼いだお金を捨てるのは勿体ないし……"

#. Occurrence 8DOT5:3399:12030: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0040; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:3399
msgctxt "text_id=12030 | speaker=aoko"
msgid "Guess I'll have to approach this from a different angle...\""
msgstr "仕方ない、ここは<搦|から>め手でいくか」"

#. Occurrence 8DOT5:3405:12031: scene=8DOT5
#: 8DOT5:3405
msgctxt "text_id=12031 | speaker=unknown"
msgid "  The wicked, scheming student council president sank deeper into the sofa."
msgstr "　などと画策しながら、ソファーにずぶずぶと沈む悪の生徒会長。"

#. Occurrence 8DOT5:3410:12032: scene=8DOT5
#: 8DOT5:3410
msgctxt "text_id=12032 | speaker=unknown"
msgid "  Her ability to play things by ear and her miserly nature were both her strongest and weakest points."
msgstr "　いちいち覚悟を決めずともデフォルトで心が<守銭奴|お　に>なのが彼女の長所であり、短所である。"

#. Occurrence 8DOT5:3456:12033: scene=8DOT5
#: 8DOT5:3456
msgctxt "text_id=12033 | speaker=unknown"
msgid "  The next day, noon."
msgstr "　翌日、正午。"

#. Occurrence 8DOT5:3496:12034: scene=8DOT5
#: 8DOT5:3496
msgctxt "text_id=12034 | speaker=unknown"
msgid "  Aoko waited until her roommates were gone, then picked up the phone in the foyer."
msgstr "　青子は同居人たちが出かけたのを<見計|みはか>らって、ロビーの電話を手に取った。"

#. Occurrence 8DOT5:3503:12035: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0041; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:3503
msgctxt "text_id=12035 | speaker=aoko"
msgid "\"Hey, Tobimaru? Soujyuro's gotten himself into something recently. Does anything ring a bell?\""
msgstr "「もしもし、鳶丸？　草十郎がこんなコトになってるんだけど、アンタ、心当たりない？」"

#. Occurrence 8DOT5:3550:12036: scene=8DOT5
#: 8DOT5:3550
msgctxt "text_id=12036 | speaker=unknown"
msgid "  The sound of the first train leaving the station could be heard far off in the distance."
msgstr "　始発電車の音が遠い。"

#. Occurrence 8DOT5:3555:12037: scene=8DOT5
#: 8DOT5:3555
msgctxt "text_id=12037 | speaker=unknown"
msgid "  This was that time of morning when the town was deciding if it felt like waking up or not."
msgstr "　町が目を覚ますか覚まさないか、どちらつかずの時間帯。"

#. Occurrence 8DOT5:3560:12038: scene=8DOT5
#: 8DOT5:3560
msgctxt "text_id=12038 | speaker=unknown"
msgid "  Tobimaru Tsukiji was having a walk down the city streets at sunrise, enjoying the fresh, crisp morning air."
msgstr "　<槻司|つきじ><鳶丸|とびまる>は日が<昇|のぼ>ったばかりの繁華街をそぞろ歩きながら、早朝の雑多にして清浄な空気に感心していた。"

#. Occurrence 8DOT5:3590:12039: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0000; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:3590
msgctxt "text_id=12039 | speaker=tobimaru"
msgid "\"This town really is beautiful when it isn't swarming with people.\""
msgstr "「本当、町ってのは人間がいないだけでキレイなもんだ」"

#. Occurrence 8DOT5:3596:12040: scene=8DOT5
#: 8DOT5:3596
msgctxt "text_id=12040 | speaker=unknown"
msgid "  The crowds had become a common complaint of Tobimaru's."
msgstr "　鳶丸にとっては通例化しているぼやきである。"

#. Occurrence 8DOT5:3628:12041: scene=8DOT5
#: 8DOT5:3628
msgctxt "text_id=12041 | speaker=unknown"
msgid "  To him, the tacky, over-decorated street corners were the embodiments of human desire."
msgstr "　派手派手しく<飾|かざ>られた<町角|まちかど>は、人間の欲望の具現だ。"

#. Occurrence 8DOT5:3633:12042: scene=8DOT5
#: 8DOT5:3633
msgctxt "text_id=12042 | speaker=unknown"
msgid "  At this time of day, the streets were nothing like the circus tent of activity they usually were."
msgstr "　見せ物小屋と何ら変わりのない連なりだが、この時間帯だけはまったく違うものになる。"

#. Occurrence 8DOT5:3638:12043: scene=8DOT5
#: 8DOT5:3638
msgctxt "text_id=12043 | speaker=unknown"
msgid "  The main street was completely empty."
msgstr "　人のいない大通り。"

#. Occurrence 8DOT5:3643:12044: scene=8DOT5
#: 8DOT5:3643
msgctxt "text_id=12044 | speaker=unknown"
msgid "  It was like a lonely, tranquil morning after a festival."
msgstr "　静まりかえった朝の町は、祭りの後のような寂しさに染まっている。"

#. Occurrence 8DOT5:3676:12045: scene=8DOT5
#: 8DOT5:3676
msgctxt "text_id=12045 | speaker=unknown"
msgid "  Weary men in black were busy cleaning up and restoring order in the bars after the previous night's revelry."
msgstr "　ふと目に入った<酒場|バー>の入り口には、けだるそうに昨夜の後始末をする黒服。"

#. Occurrence 8DOT5:3681:12046: scene=8DOT5
#: 8DOT5:3681
msgctxt "text_id=12046 | speaker=unknown"
msgid "  Around the back entrance of the local restaurants, the kitchen crew were busy bringing in their daily ingredients while stifling back tired yawns."
msgstr "　あるいは、飲食店の裏口ではあくびをかみ殺しながら今日の仕込みをはじめる<料理人|コックコート>。"

#. Occurrence 8DOT5:3686:12047: scene=8DOT5
#: 8DOT5:3686
msgctxt "text_id=12047 | speaker=unknown"
msgid "  Birds carelessly wandered the streets."
msgstr "　鳥は無防備に道を歩き、"

#. Occurrence 8DOT5:3691:12048: scene=8DOT5
#: 8DOT5:3691
msgctxt "text_id=12048 | speaker=unknown"
msgid "  There wasn't even the sound of a single car engine to be heard."
msgstr "　自動車のエンジン音も途絶えている。"

#. Occurrence 8DOT5:3724:12049: scene=8DOT5
#: 8DOT5:3724
msgctxt "text_id=12049 | speaker=unknown"
msgid "  This was a uniquely refreshing sensation that could only be felt from a city morning."
msgstr "　この独特の清涼感は都市の朝にしかないものだ。"

#. Occurrence 8DOT5:3729:12050: scene=8DOT5
#: 8DOT5:3729
msgctxt "text_id=12050 | speaker=unknown"
msgid "  It existed somewhere between daily life and exciting entertainment."
msgstr "　生活と娯楽の狭間。"

#. Occurrence 8DOT5:3734:12051: scene=8DOT5
#: 8DOT5:3734
msgctxt "text_id=12051 | speaker=unknown"
msgid "  This was the only time of day when the bustling modern world stepped aside for a slower, more nostalgic pace."
msgstr "　忙しい<人間社会|ダイヤル>の中で、この時間だけは昔ながらのスピードで回っている。"

#. Occurrence 8DOT5:3772:12052: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0001; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:3772
msgctxt "text_id=12052 | speaker=tobimaru"
msgid "\"...Tch. 'Kay.\""
msgstr "「―――チッ。そうか」"

#. Occurrence 8DOT5:3778:12053: scene=8DOT5
#: 8DOT5:3778
msgctxt "text_id=12053 | speaker=unknown"
msgid "  Tobimaru searched through his coat pockets, but only found some old receipts."
msgstr "　口元に<寂|さみ>しさを感じてコートのポケットをあさったが、中にあるのはレシートばかりだ。"

#. Occurrence 8DOT5:3783:12054: scene=8DOT5
#: 8DOT5:3783
msgctxt "text_id=12054 | speaker=unknown"
msgid "  He rearranged the scarf around his neck to keep the cold wind at bay."
msgstr "　鳶丸はマフラーを巻き直して、冷えきった風をやり過ごした。"

#. Occurrence 8DOT5:3817:12055: scene=8DOT5
#: 8DOT5:3817
msgctxt "text_id=12055 | speaker=unknown"
msgid "  Meandering through the city streets, he'd ended up at Central Park just as the morning magic began to fade."
msgstr "　鳶丸は繁華街を適当にぶらついて、朝の魔力がきれる頃に中央公園に流れていく。"

#. Occurrence 8DOT5:3822:12056: scene=8DOT5
#: 8DOT5:3822
msgctxt "text_id=12056 | speaker=unknown"
msgid "  His stroll had no particular purpose."
msgstr "　散策に目的はない。"

#. Occurrence 8DOT5:3827:12057: scene=8DOT5
#: 8DOT5:3827
msgctxt "text_id=12057 | speaker=unknown"
msgid "  It wasn't for his health or anything like that."
msgstr "　健康のための散歩でもジョギングでもない。"

#. Occurrence 8DOT5:3832:12058: scene=8DOT5
#: 8DOT5:3832
msgctxt "text_id=12058 | speaker=unknown"
msgid "  He was merely making his way home after a night out on the town."
msgstr "　これは単に、夜通し遊んだ後の<自堕落|じだらく>な朝帰りだ。"

#. Occurrence 8DOT5:3865:12059: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0002; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:3865
msgctxt "text_id=12059 | speaker=tobimaru"
msgid "\"What the hell am I even doing?\""
msgstr "「馬鹿らしい。なにやってんだか」"

#. Occurrence 8DOT5:3871:12060: scene=8DOT5
#: 8DOT5:3871
msgctxt "text_id=12060 | speaker=unknown"
msgid "  Tobimaru had a moment of unabashed self-reflection as he drank a can of vending machine coffee."
msgstr "　自動販売機で買った缶コーヒーを飲みながら、臆面もなく自虐する。"

#. Occurrence 8DOT5:3876:12061: scene=8DOT5
#: 8DOT5:3876
msgctxt "text_id=12061 | speaker=unknown"
msgid "  He didn't particularly hate partying all night long, but it was pretty boring since he still wasn't old enough to drink alcohol."
msgstr "　夜通し遊ぶのは嫌いではないが、まだ酒も飲めないのでは退屈極まりない。"

#. Occurrence 8DOT5:3882:12062: scene=8DOT5
#: 8DOT5:3882
msgctxt "text_id=12062 | speaker=unknown"
msgid "  He'd been at it for a few days now, thinking it was at least better than being at home, but he was quickly growing bored of it."
msgstr "　それでも家に居るよりはマシだろう、とここ数日は朝帰りだが、いい加減、それも飽きてきたところだった。"

#. Occurrence 8DOT5:3916:12063: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0003; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:3916
msgctxt "text_id=12063 | speaker=tobimaru"
msgid "\"I suppose it's only natural for relatives to get together at New Year's, though.\""
msgstr "「……ま、年末に親戚筋が集まるのは仕方がねえし」"

#. Occurrence 8DOT5:3922:12064: scene=8DOT5
#: 8DOT5:3922
msgctxt "text_id=12064 | speaker=unknown"
msgid "  He grinned wryly at his own lame excuse."
msgstr "　言い訳がましい呟きに、いっそう苦笑いを強めてしまう。"

#. Occurrence 8DOT5:3927:12065: scene=8DOT5
#: 8DOT5:3927
msgctxt "text_id=12065 | speaker=unknown"
msgid "  It was true that he was out wasting time like this because he didn't really have a place to go home to at the moment."
msgstr "　彼がこうして時間を潰しているのは、ある意味、帰る場所がないからだ。"

#. Occurrence 8DOT5:3947:12066: scene=8DOT5
#: 8DOT5:3947
msgctxt "text_id=12066 | speaker=unknown"
msgid "  The Tsukiji family always had a congregation of relatives over on New Year's Day, as per his grandfather's orders."
msgstr "　槻司家では祖父の方針で、毎年元旦に親戚会議が行われる。"

#. Occurrence 8DOT5:3952:12067: scene=8DOT5
#: 8DOT5:3952
msgctxt "text_id=12067 | speaker=unknown"
msgid "  This was why his siblings and other relatives had been staying over at the Tsukiji home for a few days now."
msgstr "　必然、数日前からちりぢりになっていた<兄姉|きょうだい>、親族筋が槻司の家に宿泊する事になる。"

#. Occurrence 8DOT5:3972:12068: scene=8DOT5
#: 8DOT5:3972
msgctxt "text_id=12068 | speaker=unknown"
msgid "  If Tobimaru was there, he'd just provide fuel for the fire."
msgstr "　そんな場で<鳶丸|じぶん>がいては火種になる。"

#. Occurrence 8DOT5:3977:12069: scene=8DOT5
#: 8DOT5:3977
msgctxt "text_id=12069 | speaker=unknown"
msgid "  He'd decided to avoid the family drama and not go home while everyone was there."
msgstr "　降りかかる火の粉を払うのはやぶさかではないが、争いごとは極力避けるため、鳶丸は家に帰らない選択をした。"

#. Occurrence 8DOT5:4012:12070: scene=8DOT5
#: 8DOT5:4012
msgctxt "text_id=12070 | speaker=unknown"
msgid "  They'd just greet him with insults, anyway."
msgstr "　家にいては何であろうと攻撃される。"

#. Occurrence 8DOT5:4017:12071: scene=8DOT5
#: 8DOT5:4017
msgctxt "text_id=12071 | speaker=unknown"
msgid "  And if someone tried to start a fight, he knew he wouldn't be able to resist the bait."
msgstr "　ケンカを売られては買ってしまうのが彼の性分だ。"

#. Occurrence 8DOT5:4022:12072: scene=8DOT5
#: 8DOT5:4022
msgctxt "text_id=12072 | speaker=unknown"
msgid "  It would only cause even more resentment and trouble for his father."
msgstr "　その都度に相手を打ち負かしていては憎しみはつのるばかりだし、父にも面倒が及ぶ。"

#. Occurrence 8DOT5:4027:12073: scene=8DOT5
#: 8DOT5:4027
msgctxt "text_id=12073 | speaker=unknown"
msgid "  So, for Tobimaru, there was nothing more pointless or less enticing than getting involved in his siblings' squabbles over the inheritance."
msgstr "　そしてなにより、兄姉たちのように血眼になって相続争いをするのは、この上なく面倒で、どうでもいい話だった。"

#. Occurrence 8DOT5:4078:12074: scene=8DOT5
#: 8DOT5:4078
msgctxt "text_id=12074 | speaker=unknown"
msgid "  Tobimaru Tsukiji was the fifthborn son to the Tsukiji family, which owned multiple plots of land in Misaki City."
msgstr "　槻司鳶丸は三咲市でも有数の地主、槻司家の五男として生まれた。"

#. Occurrence 8DOT5:4083:12075: scene=8DOT5
#: 8DOT5:4083
msgctxt "text_id=12075 | speaker=unknown"
msgid "  However, most of that land had been acquired after the war. Before that, they had been a minor noble family on the brink of ruin."
msgstr "　今では大地主として君臨する槻司家だが、その大部分は戦後に財を成したもので、それ以前は小さな、没落を前にした華族にすぎなかった。"

#. Occurrence 8DOT5:4088:12076: scene=8DOT5
#: 8DOT5:4088
msgctxt "text_id=12076 | speaker=unknown"
msgid "  The man who built the Tsukiji family into its current glory was Kimikuni Tsukiji, Tobimaru's grandfather and the current patriarch."
msgstr "　その槻司家を立て直したのが婿養子として迎えられた槻司<喜実國|きみくに>―――現槻司家の家長にして、鳶丸の祖父にあたる人物だ。"

#. Occurrence 8DOT5:4108:12077: scene=8DOT5
#: 8DOT5:4108
msgctxt "text_id=12077 | speaker=unknown"
msgid "  Kimikuni married into the struggling Tsukiji family and saved them after they lost all their power during the war."
msgstr "　戦時中に力を失い、やせ細った槻司家を救ったのは、この男、喜実國の豪腕によるものである。"

#. Occurrence 8DOT5:4113:12078: scene=8DOT5
#: 8DOT5:4113
msgctxt "text_id=12078 | speaker=unknown"
msgid "  The Tsukiji clan were local Shinto clergy and relied upon Kimikuni's financial assets."
msgstr "　<檀家|だんけ><総代|そうだい>、神職として地域を取り仕切っていた槻司家は喜実國の資産を、"

#. Occurrence 8DOT5:4118:12079: scene=8DOT5
#: 8DOT5:4118
msgctxt "text_id=12079 | speaker=unknown"
msgid "  Kimikuni, on the other hand, had leveraged clan connections to establish himself in Misaki City."
msgstr "　喜実國は三咲市に根を下ろすために槻司家の人脈を必要とした。"

#. Occurrence 8DOT5:4171:12080: scene=8DOT5
#: 8DOT5:4171
msgctxt "text_id=12080 | speaker=unknown"
msgid "  While both parties came together for mutual gain, the Tsukiji family failed to recognize just how ambitious Kimikuni was when they accepted him into their family."
msgstr "　利益目的で結びついた両者だが、槻司家の誤算は、一時だけと甘んじて迎え入れた喜実國の経営手腕が並々ならぬものだった事だろう。"

#. Occurrence 8DOT5:4176:12081: scene=8DOT5
#: 8DOT5:4176
msgctxt "text_id=12081 | speaker=unknown"
msgid "  He wasn't the obedient son-in-law they had imagined. He had grand plans of his own, growing and developing industries within Misaki City and many other areas as well."
msgstr "　婿養子として下に置くはずだった喜実國は三咲の産業を発展させ、それを基盤として町の外に多くの会社を興していった。"

#. Occurrence 8DOT5:4196:12082: scene=8DOT5
#: 8DOT5:4196
msgctxt "text_id=12082 | speaker=unknown"
msgid "  Kimikuni controlled all of these areas not as a member of the Tsukiji family, but under his own name."
msgstr "　彼は三咲市の内を支配しながら、その周りを槻司の親族たちとは関わりのない、自分だけの勢力で制圧した。"

#. Occurrence 8DOT5:4201:12083: scene=8DOT5
#: 8DOT5:4201
msgctxt "text_id=12083 | speaker=unknown"
msgid "  A castle's greatest defense was its moat, not the walls. And Kimikuni bridged the moat."
msgstr "　内側より先に外堀を。"

#. Occurrence 8DOT5:4206:12084: scene=8DOT5
#: 8DOT5:4206
msgctxt "text_id=12084 | speaker=unknown"
msgid "  It was the economic equivalent of starving out the enemy."
msgstr "　言ってしまえば経済的な兵糧攻めである。"

#. Occurrence 8DOT5:4211:12085: scene=8DOT5
#: 8DOT5:4211
msgctxt "text_id=12085 | speaker=unknown"
msgid "  Kimikuni's financial might subdued the noble Tsukiji family completely."
msgstr "　喜実國は経済の力で槻司家の“由緒正しい血筋”を押さえつけたのだ。"

#. Occurrence 8DOT5:4246:12086: scene=8DOT5
#: 8DOT5:4246
msgctxt "text_id=12086 | speaker=unknown"
msgid "  In less than ten years, there was no one in the family who could stand up against him."
msgstr "　十年を待たずして、槻司家では喜実國に対抗できる者は一人としていなくなった。"

#. Occurrence 8DOT5:4251:12087: scene=8DOT5
#: 8DOT5:4251
msgctxt "text_id=12087 | speaker=unknown"
msgid "  This businessman, accepted into the family as a mere son-in-law, had seized the Tsukiji name and the entirety of the family fortune."
msgstr "　婿養子として招かれた商人は、名実ともに槻司家の<家督|かとく>を手にしたのである。"

#. Occurrence 8DOT5:4287:12088: scene=8DOT5
#: 8DOT5:4287
msgctxt "text_id=12088 | speaker=unknown"
msgid "  However, Kimikuni had fathered many children."
msgstr "　一方、喜実國は多くの子供を儲けていた。"

#. Occurrence 8DOT5:4292:12089: scene=8DOT5
#: 8DOT5:4292
msgctxt "text_id=12089 | speaker=unknown"
msgid "  He would not allow the Tsukiji bloodline to die out. That was also the only way to maintain the family fortune."
msgstr "　槻司の血を絶やさないこと。それが家督を継ぐ条件でもあったからだ。"

#. Occurrence 8DOT5:4297:12090: scene=8DOT5
#: 8DOT5:4297
msgctxt "text_id=12090 | speaker=unknown"
msgid "  His three sons and one daughter all married relatives of the Tsukiji family, thus strengthening the familial bonds that Kimikuni had weakened."
msgstr "　彼の三人の息子とひとり娘は槻司家縁の親戚と結婚し、喜実國によって弱体化した槻司家の<絆|きずな>をなんとか持ち直そうとした。"

#. Occurrence 8DOT5:4307:12091: scene=8DOT5
#: 8DOT5:4307
msgctxt "text_id=12091 | speaker=unknown"
msgid "  Tobimaru was the fifth son of Hitoyoshi Tsukiji, Kimikuni's eldest son."
msgstr "　その長男にあたる槻司<一義|ひとよし>の、五人目の子供が鳶丸である。"

#. Occurrence 8DOT5:4359:12092: scene=8DOT5
#: 8DOT5:4359
msgctxt "text_id=12092 | speaker=unknown"
msgid "  However, his mother was not a member of the family."
msgstr "　　……だが、彼の母親は槻司家には存在しない。"

#. Occurrence 8DOT5:4365:12093: scene=8DOT5
#: 8DOT5:4365
msgctxt "text_id=12093 | speaker=unknown"
msgid "  Tobimaru was the result of a fling with a mistress."
msgstr "　父、一義が<戯|たわむ>れに関係し生まれた<妾|めかけ>の子。"

#. Occurrence 8DOT5:4371:12094: scene=8DOT5
#: 8DOT5:4371
msgctxt "text_id=12094 | speaker=unknown"
msgid "  That ignoble birth defined his place in the family."
msgstr "　それが槻司鳶丸の、槻司家における身分だった。"

#. Occurrence 8DOT5:4391:12095: scene=8DOT5
#: 8DOT5:4391
msgctxt "text_id=12095 | speaker=unknown"
msgid "  He was his father's love child."
msgstr "　鳶丸は父と愛人との間に生まれた子供である。"

#. Occurrence 8DOT5:4396:12096: scene=8DOT5
#: 8DOT5:4396
msgctxt "text_id=12096 | speaker=unknown"
msgid "  Although the family's dignity was somehow maintained since he was the son of Hitoyoshi, it wasn't difficult to imagine the level of mistreatment Tobimaru faced from his siblings and other relatives."
msgstr "　長男である一義の子という事で最低限の威厳は守られたが、立場の弱い鳶丸が親戚、兄姉たちにどんな迫害を受けたかは想像に難くない。"

#. Occurrence 8DOT5:4416:12097: scene=8DOT5
#: 8DOT5:4416
msgctxt "text_id=12097 | speaker=unknown"
msgid "  Being raised in such a hostile environment made Tobimaru grow up far faster than he should have."
msgstr "　そんな幼年期の環境が、鳶丸の人となりをいち早く成長させた。"

#. Occurrence 8DOT5:4421:12098: scene=8DOT5
#: 8DOT5:4421
msgctxt "text_id=12098 | speaker=unknown"
msgid "  His ability to think quickly and objectively was honed naturally within this challenging environment."
msgstr "　独特の理解の早さ、自分の役回りを演じる客観性は、槻司家で生きる上で自然に<磨|みが>かれたものだろう。"

#. Occurrence 8DOT5:4471:12099: scene=8DOT5
#: 8DOT5:4471
msgctxt "text_id=12099 | speaker=unknown"
msgid "  However, those exact traits also brought Tobimaru a great deal of trouble."
msgstr "　しかし、その<如才|じょさい>のなさが鳶丸により大きな問題を運んでしまった。"

#. Occurrence 8DOT5:4476:12100: scene=8DOT5
#: 8DOT5:4476
msgctxt "text_id=12100 | speaker=unknown"
msgid "  Kimikuni Tsukiji."
msgstr "　槻司喜実國。"

#. Occurrence 8DOT5:4481:12101: scene=8DOT5
#: 8DOT5:4481
msgctxt "text_id=12101 | speaker=unknown"
msgid "  Unfortunately, against all odds, this great leader of the Tsukiji family favored Tobimaru over everyone else, including his own eldest son."
msgstr "　困った事にこの大人物は今<以|もっ>て現役であり、多くの息子たちより―――鳶丸の父親である一義より、どこの女の子供とも知れない<鳶|ま><丸|ご>を気に入ってしまったのだ。"

#. Occurrence 8DOT5:4501:12102: scene=8DOT5
#: 8DOT5:4501
msgctxt "text_id=12102 | speaker=unknown"
msgid "  Since Kimikuni had been a commoner himself, he did not believe in blood inheritance alone."
msgstr "　もともと庶民の出であった喜実國は、血縁による相続を良しとしない節がある。"

#. Occurrence 8DOT5:4506:12103: scene=8DOT5
#: 8DOT5:4506
msgctxt "text_id=12103 | speaker=unknown"
msgid "  To make matters worse, not a single coin from his great fortune had been given to any of his sons yet."
msgstr "　加えて、この人物はいまだ息子たちに、自身の財産をこれっぽっちも譲り渡していなかった。"

#. Occurrence 8DOT5:4557:12104: scene=8DOT5
#: 8DOT5:4557
msgctxt "text_id=12104 | speaker=unknown"
msgid "\"The most loathsome thing in this world is the blood of the Tsukiji family."
msgstr "“この世でもっとも忌まわしいのは槻司の血だ。"

#. Occurrence 8DOT5:4562:12105: scene=8DOT5
#: 8DOT5:4562
msgctxt "text_id=12105 | speaker=unknown"
msgid "  I never would have had any of you if I could have helped it.\""
msgstr "　儂は貴様らなぞ作りたくもなかったわ”"

#. Occurrence 8DOT5:4568:12106: scene=8DOT5
#: 8DOT5:4568
msgctxt "text_id=12106 | speaker=unknown"
msgid "  Those words were spoken at every family gathering, and they were the absolute truth."
msgstr "　親族一同が集まるたびに出るその言葉は、嘘偽りのない本音だった。"

#. Occurrence 8DOT5:4573:12107: scene=8DOT5
#: 8DOT5:4573
msgctxt "text_id=12107 | speaker=unknown"
msgid "  He'd taken a liking to Tobimaru after speaking with him at these annual family gatherings and enjoyed playing chess with him in his spare time ever since."
msgstr "　恒例の親戚会議のおり、喜実國はたまたま話し相手になった鳶丸を気に入り、以後、仕事の合間に帰ってきては孫と囲碁などに興じる間柄になっていた。"

#. Occurrence 8DOT5:4593:12108: scene=8DOT5
#: 8DOT5:4593
msgctxt "text_id=12108 | speaker=unknown"
msgid "  Everyone in the family was worried Kimikuni would name Tobimaru his successor."
msgstr "　その喜実國がいつ鳶丸を後継者にと言いだすか、親戚一同は気が気でない。"

#. Occurrence 8DOT5:4598:12109: scene=8DOT5
#: 8DOT5:4598
msgctxt "text_id=12109 | speaker=unknown"
msgid "  In this way, Tobimaru had gone from being worthless to a threat in the eyes of Kimikuni's sons."
msgstr "　喜実國の息子たちにとって鳶丸は『居る価値のない』ものから、『居てもらっては困るもの』に格上げされたワケである。"

#. Occurrence 8DOT5:4633:12110: scene=8DOT5
#: 8DOT5:4633
msgctxt "text_id=12110 | speaker=unknown"
msgid "  The son who felt the most fear and hatred was Tobimaru's own father, Hitoyoshi, who would have been the unquestionable heir as the eldest son."
msgstr "　その危機感がもはや恐怖、嫌悪の域にまで達しているのは他でもない、本来なら無条件で喜実國の跡を継ぐはずだった長男であり、鳶丸の父親である、槻司一義その人だった。"

#. Occurrence 8DOT5:4665:12111: scene=8DOT5
#: 8DOT5:4665
msgctxt "text_id=12111 | speaker=unknown"
msgid "  And this was how Tobimaru became estranged from his father."
msgstr "　こうして、鳶丸は実の父親にまで疎まれる立場になった。"

#. Occurrence 8DOT5:4671:12112: scene=8DOT5
#: 8DOT5:4671
msgctxt "text_id=12112 | speaker=unknown"
msgid "  They no longer even lived in the same house."
msgstr "　現在、鳶丸は父である一義と同じ家には住んでいない。"

#. Occurrence 8DOT5:4676:12113: scene=8DOT5
#: 8DOT5:4676
msgctxt "text_id=12113 | speaker=unknown"
msgid "  Hitoyoshi always acted like they had a great father-son relationship in front of Kimikuni, but that would only last until his father was no longer around or until Tobimaru was officially named the heir."
msgstr "　一義は喜実國の手前、<鳶丸|むすこ>とは良好な親子関係だとアピールしているが、それも喜実國が床に臥せるか、喜実國が本格的に鳶丸を跡継ぎにすると言いだすまでだ。"

#. Occurrence 8DOT5:4681:12114: scene=8DOT5
#: 8DOT5:4681
msgctxt "text_id=12114 | speaker=unknown"
msgid "  When that happened, it would be all-out war."
msgstr "　その後は戦争である。"

#. Occurrence 8DOT5:4686:12115: scene=8DOT5
#: 8DOT5:4686
msgctxt "text_id=12115 | speaker=unknown"
msgid "  In any case, it would not be a pleasant story."
msgstr "　どちらにせよろくな話にはならないだろう。"

#. Occurrence 8DOT5:4710:12116: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0004; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:4710
msgctxt "text_id=12116 | speaker=tobimaru"
msgid "\"Grandpa really has a hard time reading between the lines sometimes...\""
msgstr "「……<祖|じ><父|い>さんも空気読めねぇからなあ、ホント」"

#. Occurrence 8DOT5:4716:12117: scene=8DOT5
#: 8DOT5:4716
msgctxt "text_id=12117 | speaker=unknown"
msgid "  Tobimaru scratched his head in frustration."
msgstr "　呆れながらバリバリと頭を掻く。"

#. Occurrence 8DOT5:4721:12118: scene=8DOT5
#: 8DOT5:4721
msgctxt "text_id=12118 | speaker=unknown"
msgid "  He really wasn't all that worried, though."
msgstr "　といっても、鳶丸はさして苦には思っていなかった。"

#. Occurrence 8DOT5:4755:12119: scene=8DOT5
#: 8DOT5:4755
msgctxt "text_id=12119 | speaker=unknown"
msgid "  In public, it looked like they had a good father-son relationship."
msgstr "　表向きは仲の良い親子関係。"

#. Occurrence 8DOT5:4760:12120: scene=8DOT5
#: 8DOT5:4760
msgctxt "text_id=12120 | speaker=unknown"
msgid "  In private, they were in the midst of a bitter inheritance dispute."
msgstr "　裏では怨念うずまく相続争い。"

#. Occurrence 8DOT5:4765:12121: scene=8DOT5
#: 8DOT5:4765
msgctxt "text_id=12121 | speaker=unknown"
msgid "  Things had always been that way, even before he met Kimikuni."
msgstr "　そんなもの、別に喜実國と出会う前と変わらない。"

#. Occurrence 8DOT5:4785:12122: scene=8DOT5
#: 8DOT5:4785
msgctxt "text_id=12122 | speaker=unknown"
msgid "  The only difference was that his sole protector, his father, was now his mortal enemy."
msgstr "　今まで唯一の<擁護者|ようごしゃ>だった父親が最大の敵にまわっただけだ。"

#. Occurrence 8DOT5:4790:12123: scene=8DOT5
#: 8DOT5:4790
msgctxt "text_id=12123 | speaker=unknown"
msgid "  Tobimaru had always been at odds with his family. His father was just one more enemy to add to that pile."
msgstr "　家族と良質な関係を結ばなかった鳶丸にとって、いまさら敵がひとり増えたところで何をかいわんや、という境地である。"

#. Occurrence 8DOT5:4822:12124: scene=8DOT5
#: 8DOT5:4822
msgctxt "text_id=12124 | speaker=unknown"
msgid "  Staying out all night like this was Tobimaru's way of avoiding his family."
msgstr "　鳶丸がこうして朝帰りを繰り返すのは、親戚一同との顔合わせを避けるためだ。"

#. Occurrence 8DOT5:4827:12125: scene=8DOT5
#: 8DOT5:4827
msgctxt "text_id=12125 | speaker=unknown"
msgid "  If he was home, he knew they would try to gauge his feelings."
msgstr "　今ではあちらが鳶丸の顔色を<窺|うかが>っている。"

#. Occurrence 8DOT5:4847:12126: scene=8DOT5
#: 8DOT5:4847
msgctxt "text_id=12126 | speaker=unknown"
msgid "  However, they wouldn't openly attack him now."
msgstr "　見下していた親戚たちも、"

#. Occurrence 8DOT5:4852:12127: scene=8DOT5
#: 8DOT5:4852
msgctxt "text_id=12127 | speaker=unknown"
msgid "  Even the relatives who looked down on him and his siblings who had bullied him as a child."
msgstr "　<戯|たわむ>れに暴力をふるってきた兄姉たちも、今では表だっての攻撃はしてこない。"

#. Occurrence 8DOT5:4857:12128: scene=8DOT5
#: 8DOT5:4857
msgctxt "text_id=12128 | speaker=unknown"
msgid "  The worst they would do was make snide remarks."
msgstr "　せいぜい嫌味を言う程度だ。"

#. Occurrence 8DOT5:4885:12129: scene=8DOT5
#: 8DOT5:4885
msgctxt "text_id=12129 | speaker=unknown"
msgid "  Tobimaru was, at his core, a peaceful person,"
msgstr "　鳶丸は基本、平和主義者である。"

#. Occurrence 8DOT5:4890:12130: scene=8DOT5
#: 8DOT5:4890
msgctxt "text_id=12130 | speaker=unknown"
msgid "  who preferred to avoid trouble whenever possible."
msgstr "　面倒ごとは避けて通るのが信条だ。"

#. Occurrence 8DOT5:4895:12131: scene=8DOT5
#: 8DOT5:4895
msgctxt "text_id=12131 | speaker=unknown"
msgid "  Petty revenge or even stepping up to Kimikuni's expectations weren't on his to-do list."
msgstr "　なので、今までの意趣返しをする気も、喜実國の期待に応えるつもりもない。"

#. Occurrence 8DOT5:4900:12132: scene=8DOT5
#: 8DOT5:4900
msgctxt "text_id=12132 | speaker=unknown"
msgid "  His father's worries were unfounded, his relatives were getting riled up for no reason, and Tobimaru had no intention of stepping out of his role as the prodigal son."
msgstr "　<一義|ちち>の不安は杞憂であり、親戚たちは勝手に踊っているだけであり、鳶丸は放蕩息子の域から出るつもりは毛頭無い。"

#. Occurrence 8DOT5:4920:12133: scene=8DOT5
#: 8DOT5:4920
msgctxt "text_id=12133 | speaker=unknown"
msgid "  However, his siblings who were around the same age as him held a different kind of resentment."
msgstr "　しかし。その一方で、歳の近い兄弟たちは、父親たちとは違う憎しみを帯びていた。"

#. Occurrence 8DOT5:4925:12134: scene=8DOT5
#: 8DOT5:4925
msgctxt "text_id=12134 | speaker=unknown"
msgid "  Perhaps they felt guilty for tormenting him all those years. Perhaps it was the result of their roles being reversed."
msgstr "　今まで迫害してきた負い目、あるいは立場の逆転からくる反動だろう。"

#. Occurrence 8DOT5:4930:12135: scene=8DOT5
#: 8DOT5:4930
msgctxt "text_id=12135 | speaker=unknown"
msgid "\"He's going to get back at us one day.\""
msgstr "『きっと、いつかやり返される』"

#. Occurrence 8DOT5:4935:12136: scene=8DOT5
#: 8DOT5:4935
msgctxt "text_id=12136 | speaker=unknown"
msgid "  They lived in such fear of this that they didn't dare ignore Tobimaru."
msgstr "　そう怯える彼らには、もう、鳶丸を無視する事はできないらしい。"

#. Occurrence 8DOT5:4977:12137: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0005; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:4977
msgctxt "text_id=12137 | speaker=tobimaru"
msgid "\"I'm not good at dealing with all that talking behind my back."
msgstr "「……そのクセ根回しはうまくねえときた。"

#. Occurrence 8DOT5:4983:12138: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0006; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:4983
msgctxt "text_id=12138 | speaker=tobimaru"
msgid "  If they'd just confront me like Aozaki, it might at least be interesting.\""
msgstr "　蒼崎ぐらいの大胆さでつっこんでくるんなら、まだスリルがあるってもんだがな」"

#. Occurrence 8DOT5:5003:12139: scene=8DOT5
#: 8DOT5:5003
msgctxt "text_id=12139 | speaker=unknown"
msgid "  His family problems were simply a chore. They never really worried him much."
msgstr "　鳶丸にとって、家庭の問題はただ面倒なだけで、あれこれ悩むものではない。"

#. Occurrence 8DOT5:5008:12140: scene=8DOT5
#: 8DOT5:5008
msgctxt "text_id=12140 | speaker=unknown"
msgid "  He was used to human malice,"
msgstr "　もう人間の悪意には慣れている。"

#. Occurrence 8DOT5:5013:12141: scene=8DOT5
#: 8DOT5:5013
msgctxt "text_id=12141 | speaker=unknown"
msgid "  although he'd nearly died from the physical abuse of his siblings."
msgstr "　いきすぎた<兄姉|きょうだい>の暴力で死にかけた事も、"

#. Occurrence 8DOT5:5018:12142: scene=8DOT5
#: 8DOT5:5018
msgctxt "text_id=12142 | speaker=unknown"
msgid "  Even though someone had once tried to kill him with true murderous intent."
msgstr "　明確な意志のもと、殺されかけた事もある。"

#. Occurrence 8DOT5:5023:12143: scene=8DOT5
#: 8DOT5:5023
msgctxt "text_id=12143 | speaker=unknown"
msgid "  Even though he had been exposed to how the elite, untouchable class of society treated others by his eldest brother."
msgstr "　特権階級、選民思想にこりかたまった長兄の顕示欲から、他人の命を扱う現場を見せつけられた事もある。"

#. Occurrence 8DOT5:5056:12144: scene=8DOT5
#: 8DOT5:5056
msgctxt "text_id=12144 | speaker=unknown"
msgid "  It was all such a pain in the ass."
msgstr "　……まったく面倒くさい。"

#. Occurrence 8DOT5:5061:12145: scene=8DOT5
#: 8DOT5:5061
msgctxt "text_id=12145 | speaker=unknown"
msgid "  These were all events that would change a person's outlook on life, but he always remained coolheaded."
msgstr "　どれも人生観を変える衝撃だったが、心の底はいつも冷めていた。"

#. Occurrence 8DOT5:5066:12146: scene=8DOT5
#: 8DOT5:5066
msgctxt "text_id=12146 | speaker=unknown"
msgid "  That was just how things were for Tobimaru."
msgstr "　そんなものか、と。"

#. Occurrence 8DOT5:5071:12147: scene=8DOT5
#: 8DOT5:5071
msgctxt "text_id=12147 | speaker=unknown"
msgid "  He had grown bored of his relatives getting worked up over everything."
msgstr "　そんなことのためにこの連中は躍起になっているのかと、鳶丸は白けてしまったのだ。"

#. Occurrence 8DOT5:5100:12148: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0007; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:5100
msgctxt "text_id=12148 | speaker=tobimaru"
msgid "\"...Eh, I guess everyone is different."
msgstr "「……ま、そのあたりは人それぞれか。"

#. Occurrence 8DOT5:5106:12149: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0008; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:5106
msgctxt "text_id=12149 | speaker=tobimaru"
msgid "  I do sympathize with my dad. You'd have to be tough to be the son of that old man.\""
msgstr "　親父殿には同情するけどな。あの<祖|じ><父|い>さんの息子なんて並の根性じゃつとまらねえ」"

#. Occurrence 8DOT5:5139:12150: scene=8DOT5
#: 8DOT5:5139
msgctxt "text_id=12150 | speaker=unknown"
msgid "  Tobimaru honestly could not care less about who would be the next heir."
msgstr "　後継者問題なぞ鳶丸にはどうでもいい。"

#. Occurrence 8DOT5:5144:12151: scene=8DOT5
#: 8DOT5:5144
msgctxt "text_id=12151 | speaker=unknown"
msgid "  He had no clear plans for the future yet."
msgstr "　彼にはまだ、明確な将来への展望はない。"

#. Occurrence 8DOT5:5149:12152: scene=8DOT5
#: 8DOT5:5149
msgctxt "text_id=12152 | speaker=unknown"
msgid "  His only real goal was to wash his hands of his family and start fresh when he became an adult."
msgstr "　あるとしたら、二十歳になった時に彼らが信じる価値観をキレイサッパリ捨てて、あっさり自由になる事ぐらいだ。"

#. Occurrence 8DOT5:5169:12153: scene=8DOT5
#: 8DOT5:5169
msgctxt "text_id=12153 | speaker=unknown"
msgid "  Until then, everything that happened was a life experience."
msgstr "　それまでは何事も人生経験。"

#. Occurrence 8DOT5:5174:12154: scene=8DOT5
#: 8DOT5:5174
msgctxt "text_id=12154 | speaker=unknown"
msgid "  He continued his morning walk, thinking it was better to enjoy the nightlife now while he was still young."
msgstr "　くだらない夜遊びも今のうちにちゃっかり楽しんでおこう、と自虐気味に朝の遊歩道をそぞろ歩くのだった。"

#. Occurrence 8DOT5:5206:12155: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0009; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:5206
msgctxt "text_id=12155 | speaker=tobimaru"
msgid "\"Huh?\""
msgstr "「お？」"

#. Occurrence 8DOT5:5212:12156: scene=8DOT5
#: 8DOT5:5212
msgctxt "text_id=12156 | speaker=unknown"
msgid "  Someone was already sitting on the bench when Tobimaru entered the plaza."
msgstr "　遊歩道から広場に出ると、ベンチには先客の姿があった。"

#. Occurrence 8DOT5:5218:12157: scene=8DOT5
#: 8DOT5:5218
msgctxt "text_id=12157 | speaker=unknown"
msgid "  The crows gathered there flew off at his approach."
msgstr "　広場にたむろしていた、<鴉|からす>に似た黒鳥が舞い散っていく。"

#. Occurrence 8DOT5:5223:12158: scene=8DOT5
#: 8DOT5:5223
msgctxt "text_id=12158 | speaker=unknown"
msgid "  On the bench sat a girl dressed in black."
msgstr "　ベンチに座っているのは黒い服の少女と、"

#. Occurrence 8DOT5:5228:12159: scene=8DOT5
#: 8DOT5:5228
msgctxt "text_id=12159 | speaker=unknown"
msgid "  A well-dressed old man with a cane sat with her."
msgstr "　杖を手にうなだれている、身なりのいい老人だ。"

#. Occurrence 8DOT5:5255:12160: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0010; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:5255
msgctxt "text_id=12160 | speaker=tobimaru"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 8DOT5:5261:12161: scene=8DOT5
#: 8DOT5:5261
msgctxt "text_id=12161 | speaker=unknown"
msgid "  These were familiar faces, so he approached the bench to say hello."
msgstr "　知らぬ顔でもなし、出くわしたからには挨拶をしなくてはなるまい、と鳶丸はベンチへと足を向けた。"

#. Occurrence 8DOT5:5296:12162: scene=8DOT5
#: 8DOT5:5296
msgctxt "text_id=12162 | speaker=unknown"
msgid "  The old man and girl looked as if they were grandfather and granddaughter."
msgstr "　少女と老人は、傍から見れば祖父と孫のようだった。"

#. Occurrence 8DOT5:5301:12163: scene=8DOT5
#: 8DOT5:5301
msgctxt "text_id=12163 | speaker=unknown"
msgid "  He seemed like a kind old man spending time with his grandchild."
msgstr "　パッと見は孫の相手をしている心優しい老人。"

#. Occurrence 8DOT5:5306:12164: scene=8DOT5
#: 8DOT5:5306
msgctxt "text_id=12164 | speaker=unknown"
msgid "  However, the truth was..."
msgstr "　しかし、その実態は、"

#. Occurrence 8DOT5:5342:12165: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0000; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5342
msgctxt "text_id=12165 | speaker=yurihiko"
msgid "\"Alice, I still don't understand what went wrong."
msgstr "「アリス、ボクは今でも思うんだ。いったい何がいけなかったのかって。"

#. Occurrence 8DOT5:5348:12166: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0001; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5348
msgctxt "text_id=12166 | speaker=yurihiko"
msgid "  We provided every service we could think of. We always thanked our employees and greeted visitors with a smile."
msgstr "　考えられるサービスはすべて実現させた。従業員への感謝も、来園者への笑顔も忘れたコトはない。"

#. Occurrence 8DOT5:5354:12167: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0002; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5354
msgctxt "text_id=12167 | speaker=yurihiko"
msgid "  But the times haven't favored me. What's worse, my art was outright rejected!\""
msgstr "　なのに時代はボクを選ばなかった。それどころか、ボクの内なる芸術性を否定した」"

#. Occurrence 8DOT5:5389:12168: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0003; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5389
msgctxt "text_id=12168 | speaker=yurihiko"
msgid "\"I'll never forgive them! Those media vultures can die, for all I care!"
msgstr "「無念だ、死ぬがいい腐った魚のようなマスコミどもめ！"

#. Occurrence 8DOT5:5395:12169: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0004; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5395
msgctxt "text_id=12169 | speaker=yurihiko"
msgid "  How dare they call them nightmarish creatures! Why, they only wish they could dream up such mascots!"
msgstr "　何が悪夢のクリーチャーか、あんな、夢にまで見そうなマスコットが他にあるだろうか？　いやあるまい。"

#. Occurrence 8DOT5:5402:12170: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0005; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5402
msgctxt "text_id=12170 | speaker=yurihiko"
msgid "But give them a mouse that walks on two legs, and they fawn over it!"
msgstr "なのに連中ときたら、ネズミを二足歩行させれば満足ときた！"

#. Occurrence 8DOT5:5413:12171: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0006; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5413
msgctxt "text_id=12171 | speaker=yurihiko"
msgid "  If you really think about it, a rodent that owns a dog as a pet? That's a nightmare! How can an animal keep another animal as a pet? If anything, an animal should keep a human as a pet! Don't you think?!\""
msgstr "　そもそも犬をペットにする<齧歯|げっし>類とか、冷静に考えたら怖いぞ。動物が動物をペットにするなんて、モラルが低いにも程がある。あそこはやはり、人間をペットにするべきじゃないんだろうか？」"

#. Occurrence 8DOT5:5447:12172: scene=8DOT5
#: 8DOT5:5447
msgctxt "text_id=12172 | speaker=unknown"
msgid "  Actually..."
msgstr "　しかして、その実態は。"

#. Occurrence 8DOT5:5452:12173: scene=8DOT5
#: 8DOT5:5452
msgctxt "text_id=12173 | speaker=unknown"
msgid "  This poor young woman was getting an earful from this old man."
msgstr "　かくも厄介な老人にからまれている、悲劇の少女の図なのだった。"

#. Occurrence 8DOT5:5458:12174: scene=8DOT5
#: 8DOT5:5458
msgctxt "text_id=12174 | speaker=unknown"
msgid "After his outburst, he paused for a moment."
msgstr "老人は激した後、"

#. Occurrence 8DOT5:5470:12175: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0007; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5470
msgctxt "text_id=12175 | speaker=yurihiko"
msgid "\"I'm sorry. I forgot myself.\""
msgstr "「いや、これは失礼。<由里彦|ゆりひこ>よ、紳士たれ」"

#. Occurrence 8DOT5:5476:12176: scene=8DOT5
#: 8DOT5:5476
msgctxt "text_id=12176 | speaker=unknown"
msgid "  He scolded himself and hung his head."
msgstr "　と自らに言い聞かせて、力なくうなだれる。"

#. Occurrence 8DOT5:5511:12177: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0008; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5511
msgctxt "text_id=12177 | speaker=yurihiko"
msgid "\"Just answer me this, Alice. What was so wrong with my Kitsy?\""
msgstr "「答えてくれアリス。いったい、ボクのキッツィーちゃんは何がいけなかったんだ？」"

#. Occurrence 8DOT5:5533:12178: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0012; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:5533
msgctxt "text_id=12178 | speaker=alice"
msgid "\"Horns. You should have given it horns.\""
msgstr "「角よ。角をつけるべきだったのよ」"

#. Occurrence 8DOT5:5539:12179: scene=8DOT5
#: 8DOT5:5539
msgctxt "text_id=12179 | speaker=unknown"
msgid "  The girl in black returned the old man's solemn bow with a grim answer of her own."
msgstr "　うなだれる老人の顔を覗きこみながら、黒衣の少女は真剣に返答する。"

#. Occurrence 8DOT5:5574:12180: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0009; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5574
msgctxt "text_id=12180 | speaker=yurihiko"
msgid "\"No, no, no! Horns won't do! A kid could get injured by something like that. I don't want to harm them physically, just mentally!\""
msgstr "「いや、角はいけない。子供たちが怪我をしてしまうからね。ボクは、傷をつけるなら体ではなく心にしたい」"

#. Occurrence 8DOT5:5580:12181: scene=8DOT5
#: 8DOT5:5580
msgctxt "text_id=12181 | speaker=unknown"
msgid "  The girl nodded deeply, thinking over the implications of what this old man had just said."
msgstr "　<含蓄|がんちく>のある言葉ね、と更に真剣に頷く少女。"

#. Occurrence 8DOT5:5613:12182: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0011; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:5613
msgctxt "text_id=12182 | speaker=tobimaru"
msgid "\"...Anyway.\""
msgstr "「…………さて」"

#. Occurrence 8DOT5:5619:12183: scene=8DOT5
#: 8DOT5:5619
msgctxt "text_id=12183 | speaker=unknown"
msgid "  Tobimaru didn't really want to get involved, but he was already too close."
msgstr "　あの組み合わせには関わりたくない鳶丸だが、もう完全に射程圏内だ。"

#. Occurrence 8DOT5:5624:12184: scene=8DOT5
#: 8DOT5:5624
msgctxt "text_id=12184 | speaker=unknown"
msgid "  If he passed by without saying anything, the old man would certainly make a fuss."
msgstr "　このまま無視して通り過ぎれば、少女はともかく老人の方がうるさく文句を言ってくるだろう。"

#. Occurrence 8DOT5:5663:12185: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0012; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:5663
msgctxt "text_id=12185 | speaker=tobimaru"
msgid "\"Good morning. Isn't it a bit early for so much regret, Mr. Tokitsu? Seems it's about time you passed on to a better place and stopped worrying your kids.\""
msgstr "「こんちは。こんな朝っぱらからジクジク後悔中かい、<土桔|ときつ>の爺さん。いつまでも引きずってると死に損なうぜ。さっさと<往生|おうじょう>して、息子たちを安心させてやんな」"

#. Occurrence 8DOT5:5672:12186: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0010; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5672
msgctxt "text_id=12186 | speaker=yurihiko"
msgid "\"Well, well, well! If it isn't the Tsukiji's bratty black sheep."
msgstr "「おや、どこの悪ガキかと思えば<夜鷹|よたか>の子供か。"

#. Occurrence 8DOT5:5678:12187: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0011; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5678
msgctxt "text_id=12187 | speaker=yurihiko"
msgid "  Morning, Toby. You're up early, as usual.\""
msgstr "　おはようトビー。君も、あいかわらず早起きだね」"

#. Occurrence 8DOT5:5705:12188: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0013; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:5705
msgctxt "text_id=12188 | speaker=tobimaru"
msgid "\"I'm just heading home after being out all night. I don't live a healthy lifestyle like you two."
msgstr "「俺は朝帰りですよ。お二人みたいに健康的じゃあない。"

#. Occurrence 8DOT5:5711:12189: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0014; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:5711
msgctxt "text_id=12189 | speaker=tobimaru"
msgid "  And good morning to you too, Miss Kuonji.\""
msgstr "　そら、久遠寺のお嬢さんもおはようさん」"

#. Occurrence 8DOT5:5717:12190: scene=8DOT5
#: 8DOT5:5717
msgctxt "text_id=12190 | speaker=unknown"
msgid "  The girl looked up calmly at Tobimaru's greeting."
msgstr "　鳶丸の挨拶を聞いて、少女は静かに顔を上げる。"

#. Occurrence 8DOT5:5736:12191: scene=8DOT5
#: 8DOT5:5736
msgctxt "text_id=12191 | speaker=unknown"
msgid "  It was none other than the witch on the hill, Alice Kuonji."
msgstr "　ベンチに座っていたのは丘の上の魔女、久遠寺有珠その人だ。"

#. Occurrence 8DOT5:5769:12192: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0015; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:5769
msgctxt "text_id=12192 | speaker=tobimaru"
msgid "\"Hm. How long has it been since we really talked? Maybe it was at that party two years ago? Well, it's rare to see you out like this.\""
msgstr "「ん？　こうしてまともに挨拶するのは二年前のパーティー以来か？　なんにせよ珍しいな。アンタがお付きなしで町に下りて来てるなんてよ」"

#. Occurrence 8DOT5:5790:12193: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0013; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:5790
msgctxt "text_id=12193 | speaker=alice"
msgid "\"That's not true. I walk through the park at this time of morning quite often, actually.\""
msgstr "「……そうでもないわ。この時間の公園は鳥を入れ替えるのにちょうどいいから。ひとりで、散歩によく使うの」"

#. Occurrence 8DOT5:5817:12194: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0016; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:5817
msgctxt "text_id=12194 | speaker=tobimaru"
msgid "\"Huh, that's kind of surprising. I always thought of you as kind of a shut-in.\""
msgstr "「ほう、そりゃ驚いた。箱入り娘じゃなかったのか、アンタ」"

#. Occurrence 8DOT5:5829:12195: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0014; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:5829
msgctxt "text_id=12195 | speaker=alice"
msgid "\"As proof, I can say I've seen you walking around here looking like a mess on many an occasion."
msgstr "「ええ。その証拠に、貴方がひどい顔で歩いているのを何度か見かけたわ。"

#. Occurrence 8DOT5:5836:12196: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0015; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:5836
msgctxt "text_id=12196 | speaker=alice"
msgid "Whatever you do is your business, just try not to cause any trouble for Aoko.\""
msgstr "……遊び歩くのは結構だけど、青子に迷惑かけないよう気をつけなさい」"

#. Occurrence 8DOT5:5863:12197: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0017; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:5863
msgctxt "text_id=12197 | speaker=tobimaru"
msgid "\"Thank you for the words of caution. I will do my best.\""
msgstr "「ご忠告どうも。肝に<銘|めい>じておくよ」"

#. Occurrence 8DOT5:5896:12198: scene=8DOT5
#: 8DOT5:5896
msgctxt "text_id=12198 | speaker=unknown"
msgid "  Despite their casual greeting, Tobimaru and Alice rarely interacted, though their fathers were acquainted."
msgstr "　気軽に挨拶を交わしたものの、鳶丸は久遠寺有珠とそこまでの面識はない。父親たちに交友があるだけだ。"

#. Occurrence 8DOT5:5901:12199: scene=8DOT5
#: 8DOT5:5901
msgctxt "text_id=12199 | speaker=unknown"
msgid "  Even so..."
msgstr "　と言っても、"

#. Occurrence 8DOT5:5901:12200: scene=8DOT5
#: 8DOT5:5901
msgctxt "text_id=12200 | speaker=unknown"
msgid "  The histories and spheres of influence of the two families were very different."
msgstr "　あくまで三咲市限定の有力者である槻司と、"

#. Occurrence 8DOT5:5901:12201: scene=8DOT5
#: 8DOT5:5901
msgctxt "text_id=12201 | speaker=unknown"
msgid "  Though the Tsukijis held sway in Misaki City, the Kuonjis influenced the whole of Japan."
msgstr "　日本全国に広がる久遠寺では規模も歴史も違う。"

#. Occurrence 8DOT5:5921:12202: scene=8DOT5
#: 8DOT5:5921
msgctxt "text_id=12202 | speaker=unknown"
msgid "  Normally, someone like Tobimaru would not be in the same social circles as Alice."
msgstr "　本来なら久遠寺有珠は槻司鳶丸をしても身分違いの相手である。"

#. Occurrence 8DOT5:5926:12203: scene=8DOT5
#: 8DOT5:5926
msgctxt "text_id=12203 | speaker=unknown"
msgid "  The only reason they could interact like this at all was because they were both friends with Aoko Aozaki."
msgstr "　その有珠とこうして話せるのも、蒼崎青子という共通の友人がいるおかげだろう。"

#. Occurrence 8DOT5:5966:12204: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0012; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5966
msgctxt "text_id=12204 | speaker=yurihiko"
msgid "\"Huh, I didn't realize you and Alice were friends, Toby."
msgstr "「バカな。トビー、君はアリスと友人関係だったのか。"

#. Occurrence 8DOT5:5979:12205: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0013; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5979
msgctxt "text_id=12205 | speaker=yurihiko"
msgid "  W-Wait a second. You're not *dating*, are you?!"
msgstr "　は!?　も、ももも、ももももしかして、二人はステディな関係だとか言うまいな？"

#. Occurrence 8DOT5:5991:12206: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0014; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:5991
msgctxt "text_id=12206 | speaker=yurihiko"
msgid "  Don't tell me. If that's true, I'll die of a heart attack right here and now. You'd be the murderer, and Alice would be your weapon."
msgstr "　やめたまえ。言ったら大事になるぞトビー。ボクは心臓麻痺で急死しかねない。犯人は君であり、凶器はアリスだ。"

#. Occurrence 8DOT5:6002:12207: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0015; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6002
msgctxt "text_id=12207 | speaker=yurihiko"
msgid "  Be sure to write that down as my cause of death."
msgstr "　無論、死因はこう書いてくれ。"

#. Occurrence 8DOT5:6002:12208: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0015; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6002
msgctxt "text_id=12208 | speaker=yurihiko"
msgid "  O, say it isn't so! This heartless love shall be the cause of my demise...!\""
msgstr "　そう、聞くも無情な、恋の、<病|やまい>と―――」"

#. Occurrence 8DOT5:6029:12209: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0018; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6029
msgctxt "text_id=12209 | speaker=tobimaru"
msgid "\"So tell me again why a girl like you hangs around with this pathetic old man?"
msgstr "「久遠寺のお嬢さんはどうしてこんなダメ老人と？"

#. Occurrence 8DOT5:6035:12210: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0019; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6035
msgctxt "text_id=12210 | speaker=tobimaru"
msgid "  Is it the same reason I do? Because of your father?\""
msgstr "　俺と同じ、親父関係の付き合いか？」"

#. Occurrence 8DOT5:6047:12211: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0016; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:6047
msgctxt "text_id=12211 | speaker=alice"
msgid "\"He's my pen pal."
msgstr "「この人とはペンフレンド。"

#. Occurrence 8DOT5:6053:12212: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0017; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:6053
msgctxt "text_id=12212 | speaker=alice"
msgid "  He has more antiques than he can handle, so Aoko and I are taking some off his hands.\""
msgstr "　分不相応にいいアンティークを持っているから、青子と二人で少しずつとりあげているの」"

#. Occurrence 8DOT5:6059:12213: scene=8DOT5
#: 8DOT5:6059
msgctxt "text_id=12213 | speaker=unknown"
msgid "  Despite this being one of the only times they'd really talked, Tobimaru and Alice both manage to completely ignore the old man."
msgstr "　ほぼ初対面でありながら、鳶丸と有珠は抜群のコンビネーションで老人をスルーする。"

#. Occurrence 8DOT5:6096:12214: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0016; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6096
msgctxt "text_id=12214 | speaker=yurihiko"
msgid "\"Hahaha! Oh, Alice, even the way you hide your embarrassment is charming."
msgstr "「はは、まいったな、アリスは照れ隠しもチャーミングだ。"

#. Occurrence 8DOT5:6102:12215: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0017; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6102
msgctxt "text_id=12215 | speaker=yurihiko"
msgid "  By the way, you can call me Julich.\""
msgstr "　ところで、ボクのことはユーリッヒと呼んでくれていいんだよ」"

#. Occurrence 8DOT5:6107:12216: scene=8DOT5
#: 8DOT5:6107
msgctxt "text_id=12216 | speaker=unknown"
msgid "  Mr. Tokitsu gently took Alice's hand."
msgstr "　そっと有珠の手を握る土桔老人。"

#. Occurrence 8DOT5:6127:12217: scene=8DOT5
#: 8DOT5:6127
msgctxt "text_id=12217 | speaker=unknown"
msgid "  Alice face remained neutral, like a doll's."
msgstr "　有珠は人形のような仕草で、"

#. Occurrence 8DOT5:6146:12218: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0018; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:6146
msgctxt "text_id=12218 | speaker=alice"
msgid "\"Tokie, I'm looking for a nice painted teacup. Something from the 1900s, maybe from Dresden?\""
msgstr "「トッキィー。わたし、いい絵付けのティーカップを探しているの。1900年代の、ラム工房のものとか、どうかしら」"

#. Occurrence 8DOT5:6152:12219: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0018; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6152
msgctxt "text_id=12219 | speaker=yurihiko"
msgid "\"I have just the thing! I'll be sure to bring it out for you next time you come by with that terrifying friend of yours.\""
msgstr "「あるとも。もちろんあるとも。今度、あのおっかないお友達と遊びにくる時までに用意しておこう」"

#. Occurrence 8DOT5:6158:12220: scene=8DOT5
#: 8DOT5:6158
msgctxt "text_id=12220 | speaker=unknown"
msgid "  He responded to her request like an obedient marionette."
msgstr "　このように、老人の下心を華麗に誘導するのだった。"

#. Occurrence 8DOT5:6190:12221: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0020; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6190
msgctxt "text_id=12221 | speaker=tobimaru"
msgid "\"You know, I'm surprised you haven't ruined yourself looking for love in all the wrong places, old man.\""
msgstr "「老いらくの恋って柄かよ。よくもまあ<身代|しんだい>潰さなかったもんだ、トッパンは」"

#. Occurrence 8DOT5:6208:12222: scene=8DOT5
#: 8DOT5:6208
msgctxt "text_id=12222 | speaker=unknown"
msgid "  You see..."
msgstr "　そう。"

#. Occurrence 8DOT5:6223:12223: scene=8DOT5
#: 8DOT5:6223
msgctxt "text_id=12223 | speaker=unknown"
msgid "  This old man was none other than Yurihiko Tokitsu. He was famous in Yashirogi as the former head of the Tokitsu Baking Company with factories all across Japan. He still served as an adviser."
msgstr "　この老人こそ<社木|やしろぎ>の名士であり、全国に多くの工場をかまえる土桔製パン株式会社の<元|もと>総帥にして、<現|げん>相談役の<土桔|ときつ><由|ゆ><里彦|りひこ>翁その人なのである。"

#. Occurrence 8DOT5:6258:12224: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0019; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6258
msgctxt "text_id=12224 | speaker=yurihiko"
msgid "\"Who are you calling old? An artist is only old when he's lost his sensibility. My fire hasn't burned out yet."
msgstr "「老人とはなんだ。芸術家にとっての老いとは感性の凍結であり、しかるに我が心の火は絶えていない。"

#. Occurrence 8DOT5:6270:12225: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0020; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6270
msgctxt "text_id=12225 | speaker=yurihiko"
msgid "I'm so young, it's almost stifling! I still look forward to passionate chats with a young woman."
msgstr "ボクはまだ暑苦しいくらいに若いんだ。<蕾|つぼみ>のような少女と恋を語らう楽しみは残っているさ。"

#. Occurrence 8DOT5:6281:12226: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0021; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6281
msgctxt "text_id=12226 | speaker=yurihiko"
msgid "  Hahaha! Once you get my age, you stop giving a damn about keeping up appearances. Talking to girls is what gives meaning to life.\""
msgstr "　ははは、この歳になるともう世間体とかどうでもよくてね。女の子と話すことだけが人生の意味になるんだぞう」"

#. Occurrence 8DOT5:6299:12227: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0021; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6299
msgctxt "text_id=12227 | speaker=tobimaru"
msgid "\"So wait, are you young or old?\""
msgstr "「若いのか爺さんなのか、どっちなんだよ」"

#. Occurrence 8DOT5:6333:12228: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0022; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6333
msgctxt "text_id=12228 | speaker=yurihiko"
msgid "\"Oh, a slip of the tongue. Forget that last bit."
msgstr "「おっと失言失言、最後の方のは聞き流してくれ。"

#. Occurrence 8DOT5:6345:12229: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0023; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6345
msgctxt "text_id=12229 | speaker=yurihiko"
msgid "  What I'm trying to say here is that there's nothing quite like having a nice time with a young woman."
msgstr "　ボクが言いたいのは、女の子と穏やかな時間を過ごすのは最高ってコトさ。"

#. Occurrence 8DOT5:6358:12230: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0024; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6358
msgctxt "text_id=12230 | speaker=yurihiko"
msgid "I'm sure we can at least agree on that, can't we, Toby?\""
msgstr "トビー。そういうの、君も好きだろ？」"

#. Occurrence 8DOT5:6393:12231: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0022; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6393
msgctxt "text_id=12231 | speaker=tobimaru"
msgid "\"Don't lump me in with you. I like older women."
msgstr "「一緒にしないでください、あいにく俺は年上好みですよ。"

#. Occurrence 8DOT5:6399:12232: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0023; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6399
msgctxt "text_id=12232 | speaker=tobimaru"
msgid "  I definitely don't have a thing for girls who are less than half my age, I can tell you that much.\""
msgstr "　おまけに言うなら、二回り以上も年下の女に欲情する趣味もねえワケで」"

#. Occurrence 8DOT5:6411:12233: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0025; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6411
msgctxt "text_id=12233 | speaker=yurihiko"
msgid "\"I should hope not. That'd be quite the crime."
msgstr "「うん、それはそうだろう。君がやったら犯罪だ。"

#. Occurrence 8DOT5:6417:12234: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0026; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6417
msgctxt "text_id=12234 | speaker=yurihiko"
msgid "  You're only seventeen. I don't even want to think about what age you'd be talking about.\""
msgstr "　トビーは十七歳。その二回り下が何歳になるとか、口にだしたらいけないよ」"

#. Occurrence 8DOT5:6437:12235: scene=8DOT5
#: 8DOT5:6437
msgctxt "text_id=12235 | speaker=unknown"
msgid "  Mr. Tokitsu nodded his head in self-affirmation."
msgstr "　うむ、と頷く土桔老人。"

#. Occurrence 8DOT5:6442:12236: scene=8DOT5
#: 8DOT5:6442
msgctxt "text_id=12236 | speaker=unknown"
msgid "  He chose to ignore Tobimaru's off-color remarks."
msgstr "　鳶丸の無礼な発言もまったく気にしていない。"

#. Occurrence 8DOT5:6452:12237: scene=8DOT5
#: 8DOT5:6452
msgctxt "text_id=12237 | speaker=unknown"
msgid "  Tobimaru was reluctantly impressed with the man's magnanimity, in the end."
msgstr "　これはこれで大人物なんだよなあ、とつい感心してしまう鳶丸だった。"

#. Occurrence 8DOT5:6488:12238: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0024; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6488
msgctxt "text_id=12238 | speaker=tobimaru"
msgid "\"At any rate, I just wanted to say good morning. I'll get out of your hair now. Sorry to interrupt your fun.\""
msgstr "「ともかく挨拶はしましたから。邪魔者はこれで消えますよ。あとは仲良し同士、気兼ねなくどうぞ」"

#. Occurrence 8DOT5:6499:12239: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0027; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6499
msgctxt "text_id=12239 | speaker=yurihiko"
msgid "\"Oh, don't be like that, Toby. Fate has led you here. Relax and spend some time with us."
msgstr "「なんだトビー。これも縁だ、ゆっくりしていけばいい。"

#. Occurrence 8DOT5:6499:12240: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0027; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6499
msgctxt "text_id=12240 | speaker=yurihiko"
msgid "  Why don't you come and stay at my villa for a bit? We could take a helicopter. It'd be fun.\""
msgstr "　なんなら、今からボクの別荘に来るかね？　ヘリコ呼ぶよ？楽しいぞ？」"

#. Occurrence 8DOT5:6526:12241: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0025; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6526
msgctxt "text_id=12241 | speaker=tobimaru"
msgid "\"Ah, I'll pass, but thanks for the invitation. If anyone I know sees me, they'll think I'm even more of a spoiled rich kid. I feel like avoiding that right now.\""
msgstr "「いや、お気持ちは嬉しいんですけどね。知る人が見ればとんでもなくブルジョワな面子でしょ、コレ。今は避けたい気分なんですよ、そういうの」"

#. Occurrence 8DOT5:6546:12242: scene=8DOT5
#: 8DOT5:6546
msgctxt "text_id=12242 | speaker=unknown"
msgid "  Tobimaru's choice of words made his present situation clear to Mr. Tokitsu, and he reluctantly backed off."
msgstr "　鳶丸の言い回しで事情を察したのか、それは残念だ、と土桔老人は引き下がった。"

#. Occurrence 8DOT5:6551:12243: scene=8DOT5
#: 8DOT5:6551
msgctxt "text_id=12243 | speaker=unknown"
msgid "  Such intuitive understanding made it obvious how this man had expanded the Tokitsu Baking Company nationwide."
msgstr "　引退したとはいえ、こんなんでもトッパンを全国規模にまで発展させた偉人である。"

#. Occurrence 8DOT5:6556:12244: scene=8DOT5
#: 8DOT5:6556
msgctxt "text_id=12244 | speaker=unknown"
msgid "  He had divined Tobimaru's complicated family situation in an instant."
msgstr "　鳶丸の複雑な家庭環境を瞬時に察したのだろう。"

#. Occurrence 8DOT5:6591:12245: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_8DOT5_0028; voice_prefix=B90; voice_category=14; scene=8DOT5
#: 8DOT5:6591
msgctxt "text_id=12245 | speaker=yurihiko"
msgid "\"Tell Mick I said hello, and that he should retire and make up with his kids soon, will ya?\""
msgstr "「ミックによろしく。そろそろ引退して子供たちと仲直りするよう、ボクが言っていたと伝えてくれ」"

#. Occurrence 8DOT5:6609:12246: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0026; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6609
msgctxt "text_id=12246 | speaker=tobimaru"
msgid "\"I'm sure it'll fall on deaf ears, but okay."
msgstr "「はいはい、<糠|ぬか>に釘だろうけど伝えておきますよ。"

#. Occurrence 8DOT5:6620:12247: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0027; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6620
msgctxt "text_id=12247 | speaker=tobimaru"
msgid "  See you around, Miss Kuonji. I'll be sure to say hello next time I see you around in the morning.\""
msgstr "　じゃあな久遠寺さん。また朝に出会うことがあったら、その時は改めて挨拶させてくれ」"

#. Occurrence 8DOT5:6653:12248: scene=8DOT5
#: 8DOT5:6653
msgctxt "text_id=12248 | speaker=unknown"
msgid "  Alice's silence neither encouraged nor discouraged this."
msgstr "　同意とも拒絶ともつかない無言の返答。"

#. Occurrence 8DOT5:6658:12249: scene=8DOT5
#: 8DOT5:6658
msgctxt "text_id=12249 | speaker=unknown"
msgid "  Tobimaru shrugged and left the plaza."
msgstr "　それにやれやれと肩をすくめて、鳶丸は広場を後にした。"

#. Occurrence 8DOT5:6737:12250: scene=8DOT5
#: 8DOT5:6737
msgctxt "text_id=12250 | speaker=unknown"
msgid "  He walked leisurely away from the park and came to an area of the city that was under redevelopment."
msgstr "　公園を出て気ままに歩いていると、いつのまにか再開発地区にやってきていた。"

#. Occurrence 8DOT5:6742:12251: scene=8DOT5
#: 8DOT5:6742
msgctxt "text_id=12251 | speaker=unknown"
msgid "  There was a radio tower under construction there that the Tsukiji family had a hand in, but most of the capital for that project was funded by foreign firms."
msgstr "　これは建設途中の電波塔で、この開発には槻司家も噛んでいるが、大部分の資金は外資企業からのものだった。"

#. Occurrence 8DOT5:6775:12252: voice_id=D40_8DOT5_0000; voice_prefix=D40; voice_category=0; scene=8DOT5
#: 8DOT5:6775
msgctxt "text_id=12252 | speaker=unknown"
msgid "\"We're looking ten years into the future with this radio tower."
msgstr "“この電波塔は十年先を見越しての物です。"

#. Occurrence 8DOT5:6781:12253: voice_id=D40_8DOT5_0001; voice_prefix=D40; voice_category=0; scene=8DOT5
#: 8DOT5:6781
msgctxt "text_id=12253 | speaker=unknown"
msgid "  Many advancements will be made in the field of mobile communications."
msgstr "　いずれ携帯通信は目まぐるしい進歩をとげるでしょう。"

#. Occurrence 8DOT5:6787:12254: voice_id=D40_8DOT5_0002; voice_prefix=D40; voice_category=0; scene=8DOT5
#: 8DOT5:6787
msgctxt "text_id=12254 | speaker=unknown"
msgid "  We want to bring our technology into Misaki City ahead of the rest.\""
msgstr "　まずはそのモデルケースとして、私どもの技術をミサキ市に普及させたいのです―――”"

#. Occurrence 8DOT5:6807:12255: scene=8DOT5
#: 8DOT5:6807
msgctxt "text_id=12255 | speaker=unknown"
msgid "  The man from the foreign firm shook on the deal with Tobimaru's father, Hitoyoshi."
msgstr "　外資企業から派遣された男は、そんなうたい文句で父、一義と握手を交わしていた。"

#. Occurrence 8DOT5:6839:12256: voice_id=D40_8DOT5_0003; voice_prefix=D40; voice_category=0; scene=8DOT5
#: 8DOT5:6839
msgctxt "text_id=12256 | speaker=unknown"
msgid "\"Eventually I want my daughter to live here in Misaki City."
msgstr "“いずれは娘もミサキ市に住まわせようと思っています。"

#. Occurrence 8DOT5:6845:12257: voice_id=D40_8DOT5_0004; voice_prefix=D40; voice_category=0; scene=8DOT5
#: 8DOT5:6845
msgctxt "text_id=12257 | speaker=unknown"
msgid "  I hope that she and your son can get to know each other better when that day comes.\""
msgstr "　その時は貴方の息子さんとも、ぜひ交友を深めて―――”"

#. Occurrence 8DOT5:6865:12258: scene=8DOT5
#: 8DOT5:6865
msgctxt "text_id=12258 | speaker=unknown"
msgid "  He was a handsome man who had the calm command of a leader."
msgstr "　白人特有の、穏やかな威圧感を持つ優男だった。"

#. Occurrence 8DOT5:6870:12259: scene=8DOT5
#: 8DOT5:6870
msgctxt "text_id=12259 | speaker=unknown"
msgid "  The fact that he had offered up his daughter to Tobimaru showed that he had researched the Tsukiji family's inheritance issues well."
msgstr "　自分の娘を鳶丸にあてがおうとするあたり、槻司家の相続問題も調査済みなのだろう。"

#. Occurrence 8DOT5:6891:12260: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0028; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6891
msgctxt "text_id=12260 | speaker=tobimaru"
msgid "\"When are you gonna realize you're getting played, Dad? It's so obvious."
msgstr "「親父も舐められてるって気付けよな。親父より先に俺に色目使いやがってクソヤンキーが。"

#. Occurrence 8DOT5:6897:12261: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0029; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6897
msgctxt "text_id=12261 | speaker=tobimaru"
msgid "  And I'm not interested in blondes, anyway. She can take her skanky, money-grubbing hands elsewhere. I'll pass.\""
msgstr "　そもそも金髪女の相手なんざ願い下げだぜ。向こうで海兵相手に<尻|ケツ>振ってろってんだ」"

#. Occurrence 8DOT5:6928:12262: scene=8DOT5
#: 8DOT5:6928
msgctxt "text_id=12262 | speaker=unknown"
msgid "  Tobimaru stopped in his tracks after these muttered complaints."
msgstr "　そう愚痴をこぼすと鳶丸は足を止めた。"

#. Occurrence 8DOT5:6933:12263: scene=8DOT5
#: 8DOT5:6933
msgctxt "text_id=12263 | speaker=unknown"
msgid "  He decided to stop himself before he said anything worse."
msgstr "　本気の悪態が口から出るようではおしまいである。"

#. Occurrence 8DOT5:6938:12264: scene=8DOT5
#: 8DOT5:6938
msgctxt "text_id=12264 | speaker=unknown"
msgid "  He'd walked far enough already anyway. The sun was completely up now."
msgstr "　じゅうぶんに歩いたし、日も完全に昇ってしまった。"

#. Occurrence 8DOT5:6943:12265: scene=8DOT5
#: 8DOT5:6943
msgctxt "text_id=12265 | speaker=unknown"
msgid "  There was nothing more to gain from wandering mindlessly."
msgstr "　これ以上の放浪は何ら得るものがない。"

#. Occurrence 8DOT5:6964:12266: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0030; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:6964
msgctxt "text_id=12266 | speaker=tobimaru"
msgid "\"...Guess I should head back.\""
msgstr "「―――戻るか」"

#. Occurrence 8DOT5:6971:12267: scene=8DOT5
#: 8DOT5:6971
msgctxt "text_id=12267 | speaker=unknown"
msgid "  He turned his back to the radio tower and began heading home."
msgstr "　建設途中の電波塔に背を向けて、鳶丸は家路につく。"

#. Occurrence 8DOT5:7005:12268: scene=8DOT5
#: 8DOT5:7005
msgctxt "text_id=12268 | speaker=unknown"
msgid "  One hour later..."
msgstr "　一時間後。"

#. Occurrence 8DOT5:7011:12269: voice_id=G40_8DOT5_0000; voice_prefix=G40; voice_category=0; scene=8DOT5
#: 8DOT5:7011
msgctxt "text_id=12269 | speaker=unknown"
msgid "\"Young master, you have a phone call.\""
msgstr "「坊ちゃん、お電話です」"

#. Occurrence 8DOT5:7016:12270: scene=8DOT5
#: 8DOT5:7016
msgctxt "text_id=12270 | speaker=unknown"
msgid "  Tobimaru had returned to the Tsukiji residence. He took the phone from the housemaid."
msgstr "　槻司の本邸に帰った鳶丸は、家政婦から受話器を受け取った。"

#. Occurrence 8DOT5:7037:12271: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0042; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7037
msgctxt "text_id=12271 | speaker=aoko"
msgid "\"Hey, Tobimaru? Soujyuro's gotten himself into something recently. Does anything ring a bell?\""
msgstr "『もしもし、鳶丸？　草十郎がこんなコトになってるんだけど、アンタ、心当たりない？』"

#. Occurrence 8DOT5:7043:12272: scene=8DOT5
#: 8DOT5:7043
msgctxt "text_id=12272 | speaker=unknown"
msgid "  Aoko Aozaki was on the line. That was never a good sign."
msgstr "　風雲急を告げる、蒼崎青子からの電話である。"

#. Occurrence 8DOT5:7107:12273: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0043; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7107
msgctxt "text_id=12273 | speaker=aoko"
msgid "\"So yeah, that's as much as I know about it.\""
msgstr "「とまあ、こういう<事情|ワケ>なのよ」"

#. Occurrence 8DOT5:7116:12274: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0031; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7116
msgctxt "text_id=12274 | speaker=tobimaru"
msgid "\"Geez. Everything about that is as suspicious as it gets.\""
msgstr "「すげえな。安心できる要素がひとつもねえ」"

#. Occurrence 8DOT5:7150:12275: scene=8DOT5
#: 8DOT5:7150
msgctxt "text_id=12275 | speaker=unknown"
msgid "\"Soujyuro seems caught up in a strange part-time job."
msgstr "“草十郎がおかしな<仕事|バイト>に<嵌|はま>っている模様。"

#. Occurrence 8DOT5:7150:12276: scene=8DOT5
#: 8DOT5:7150
msgctxt "text_id=12276 | speaker=unknown"
msgid "  I'll wait for you in Central Park to talk about it.\""
msgstr "　急遽相談に乗られたし。中央公園で待つ”"

#. Occurrence 8DOT5:7182:12277: scene=8DOT5
#: 8DOT5:7182
msgctxt "text_id=12277 | speaker=unknown"
msgid "  Ten minutes had passed since he had received this call from Aoko and returned to the park."
msgstr "　そんな電話を受け、公園にとんぼ返りしてからはや十分。"

#. Occurrence 8DOT5:7187:12278: scene=8DOT5
#: 8DOT5:7187
msgctxt "text_id=12278 | speaker=unknown"
msgid "  Tobimaru felt a light migraine coming on after hearing about the situation."
msgstr "　ある意味、いつかは起こるだろう、と危惧していた状況を聞かされ、槻司鳶丸は軽い<偏頭痛|へんずつう>に襲われた。"

#. Occurrence 8DOT5:7192:12279: scene=8DOT5
#: 8DOT5:7192
msgctxt "text_id=12279 | speaker=unknown"
msgid "  The young girl and the old man from before were nowhere to be seen."
msgstr "　ちなみに、ベンチに少女と老人の姿はない。"

#. Occurrence 8DOT5:7223:12280: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0044; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7223
msgctxt "text_id=12280 | speaker=aoko"
msgid "\"Well, you don't have to tell me that."
msgstr "「そんなコト言われるまでもなく分かってるわよ。"

#. Occurrence 8DOT5:7229:12281: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0045; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7229
msgctxt "text_id=12281 | speaker=aoko"
msgid "  I'm not trying to be judgmental about what someone does for work, but this just doesn't seem right."
msgstr "　私だって人のアルバイトにケチつけたくないけど、どう考えても普通じゃないでしょ？"

#. Occurrence 8DOT5:7240:12282: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0046; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7240
msgctxt "text_id=12282 | speaker=aoko"
msgid "  He hasn't told you anything about this?\""
msgstr "　アンタ、アイツから何か聞いてない？」"

#. Occurrence 8DOT5:7258:12283: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0032; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7258
msgctxt "text_id=12283 | speaker=tobimaru"
msgid "\"Sorry, but I haven't heard anything. He's super secretive about his job. He said he can't talk to anyone about it, or something.\""
msgstr "「悪いな、期待には応えられん。草十郎はバイトに関しちゃ秘密主義だ。任されているからには他言はできない、とかなんとかな」"

#. Occurrence 8DOT5:7291:12284: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0047; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7291
msgctxt "text_id=12284 | speaker=aoko"
msgid "\"Yeah, he's always so tight-lipped about anything that involves other people. He's not going to talk easily.\""
msgstr "「……そうなのよね。アイツ、他人の事情に関しちゃ缶詰みたいに義理堅いから。ガキガキにされないかぎり口割らないのよ」"

#. Occurrence 8DOT5:7309:12285: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0033; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7309
msgctxt "text_id=12285 | speaker=tobimaru"
msgid "\"Hm, I guess he must be pretty loyal if even you think that about him.\""
msgstr "「ほう、それはそれは。蒼崎にそこまで言わせるとはね。草十郎も信頼されたもんだ」"

#. Occurrence 8DOT5:7344:12286: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0048; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7344
msgctxt "text_id=12286 | speaker=aoko"
msgid "\"What is that supposed to mean?\""
msgstr "「どういう意味よそれ」"

#. Occurrence 8DOT5:7355:12287: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0034; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7355
msgctxt "text_id=12287 | speaker=tobimaru"
msgid "\"I'm not implying anything. I'm just saying."
msgstr "「他意はねえ、言葉通りに受け取ってくれ。"

#. Occurrence 8DOT5:7361:12288: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0035; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7361
msgctxt "text_id=12288 | speaker=tobimaru"
msgid "  You get mad about pretty much everything. If you're watching his back outside of school, you must really like him.\""
msgstr "　おまえ、基本的に何にだって怒るだろ。そんな女が学校外で世話をやくなんて、よっぽど気に入ったのかと思ってな」"

#. Occurrence 8DOT5:7396:12289: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0049; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7396
msgctxt "text_id=12289 | speaker=aoko"
msgid "\"Not really. It's just that if he causes any problems, we're going to take the heat for it in the student council."
msgstr "「違うわよ。アイツが問題を起こしたら<生徒会|わたしたち>にまで飛び火するじゃない。"

#. Occurrence 8DOT5:7402:12290: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0050; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7402
msgctxt "text_id=12290 | speaker=aoko"
msgid "  This is just risk aversion, plain and simple.\""
msgstr "　こんなの、誰がどう見ても、ただのリスク回避でしょう」"

#. Occurrence 8DOT5:7408:12291: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0036; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7408
msgctxt "text_id=12291 | speaker=tobimaru"
msgid "\"Ah okay, so you're just doing your duty.\""
msgstr "「なるほど、公務として見過ごせないってワケか」"

#. Occurrence 8DOT5:7429:12292: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0051; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7429
msgctxt "text_id=12292 | speaker=aoko"
msgid "\"That's right. Any problem with that?\""
msgstr "「そうよ。悪い？」"

#. Occurrence 8DOT5:7435:12293: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0037; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7435
msgctxt "text_id=12293 | speaker=tobimaru"
msgid "\"No, none. I respect it, actually."
msgstr "「いやぁ、悪かねえさ。むしろ尊敬するよ。"

#. Occurrence 8DOT5:7441:12294: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0038; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7441
msgctxt "text_id=12294 | speaker=tobimaru"
msgid "  You're the perfect student council president. I mean, it's not even a school day, and you're out here just to make sure our school's reputation is upheld.\""
msgstr "　ほんと、鉄の生徒会長だぜ。休日だっていうのに学校の評判を守るため<だ|・><け|・>に働けるとは」"

#. Occurrence 8DOT5:7472:12295: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0052; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7472
msgctxt "text_id=12295 | speaker=aoko"
msgid "\"You really don't have to say it like that."
msgstr "「だけ、ってところを妙に強調するじゃない。"

#. Occurrence 8DOT5:7478:12296: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0053; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7478
msgctxt "text_id=12296 | speaker=aoko"
msgid "  ...Though, I suppose you're right.\""
msgstr "　……まあ、事実その通りだけど」"

#. Occurrence 8DOT5:7486:12297: scene=8DOT5
#: 8DOT5:7486
msgctxt "text_id=12297 | speaker=unknown"
msgid "  Aoko's glare seemed to suggest she wasn't interested in hearing any objections."
msgstr "　青子は何か文句でも？　と睨みを利かせた。"

#. Occurrence 8DOT5:7491:12298: scene=8DOT5
#: 8DOT5:7491
msgctxt "text_id=12298 | speaker=unknown"
msgid "  This little bluff was rather charming to Tobimaru, who was well aware of Soujyuro and Aoko's current living situation."
msgstr "　すでに草十郎と青子の雑居を知っている鳶丸からすると、その虚勢はたいへん微笑ましい。"

#. Occurrence 8DOT5:7524:12299: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0039; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7524
msgctxt "text_id=12299 | speaker=tobimaru"
msgid "\"At any rate, I guess it's my duty as vice-president to tag along with this investigation then."
msgstr "「べっつにぃー。しかしま、そういうコトなら副会長として付き合わなくっちゃな。"

#. Occurrence 8DOT5:7530:12300: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0040; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7530
msgctxt "text_id=12300 | speaker=tobimaru"
msgid "  You continue investigating Soujyuro. For the reputation of our school, of course."
msgstr "　会長は学校のために草十郎を調査する。"

#. Occurrence 8DOT5:7537:12301: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0041; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7537
msgctxt "text_id=12301 | speaker=tobimaru"
msgid "I'll provide support however I can, and will watch out for Soujyuro as his friend.\""
msgstr "俺はそのサポートをしつつ、友人として草十郎を気に掛けるってコトで」"

#. Occurrence 8DOT5:7555:12302: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0054; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7555
msgctxt "text_id=12302 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 8DOT5:7561:12303: scene=8DOT5
#: 8DOT5:7561
msgctxt "text_id=12303 | speaker=unknown"
msgid "  Tobimaru said he would do as Aoko asked, but for some reason she did not seem satisfied."
msgstr "　鳶丸の発言は<注文|オーダー>通りなのだが、なんとなく納得のいかない青子だった。"

#. Occurrence 8DOT5:7597:12304: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0042; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7597
msgctxt "text_id=12304 | speaker=tobimaru"
msgid "\"Now that it's all settled, let's get started."
msgstr "「んじゃ、そうと決まればさっそく始めますか。"

#. Occurrence 8DOT5:7603:12305: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0043; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7603
msgctxt "text_id=12305 | speaker=tobimaru"
msgid "  You should at least know where he's working, right? What's the address?\""
msgstr "　蒼崎のコトだから草十郎の<勤|つと>め先ぐらい突き止めてんだろ？住所どこだよ」"

#. Occurrence 8DOT5:7630:12306: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0055; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7630
msgctxt "text_id=12306 | speaker=aoko"
msgid "\"I tried to tail him and find that out, actually... but I got nowhere."
msgstr "「それが……尾行したんだけど、うまくまかれちゃって。"

#. Occurrence 8DOT5:7636:12307: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0056; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7636
msgctxt "text_id=12307 | speaker=aoko"
msgid "  All I know is that he turned and walked towards 2nd Street from the train station.\""
msgstr "　駅前から二丁目方面に曲がっていったのまでは確実なんだけど」"

#. Occurrence 8DOT5:7647:12308: scene=8DOT5
#: 8DOT5:7647
msgctxt "text_id=12308 | speaker=unknown"
msgid "  The vice-president was used to this."
msgstr "　さすが副会長、慣れたものである。"

#. Occurrence 8DOT5:7652:12309: scene=8DOT5
#: 8DOT5:7652
msgctxt "text_id=12309 | speaker=unknown"
msgid "  He didn't bother saying anything about her going so far as to tail Soujyuro."
msgstr "『尾行したのかよ』なんて<批難|ツッコミ>は当然スルー。"

#. Occurrence 8DOT5:7686:12310: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0044; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7686
msgctxt "text_id=12310 | speaker=tobimaru"
msgid "\"2nd Street, huh... There's just a bunch of pachinko parlors and arcades around there. I can't think of anywhere that'd be paying him tens of thousands of yen a day.\""
msgstr "「二丁目か……あのあたりだとパチンコとゲームセンターぐらいしか思い当たらねえな。一日に何万も稼げる店なんざねえぞ？」"

#. Occurrence 8DOT5:7692:12311: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0057; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7692
msgctxt "text_id=12311 | speaker=aoko"
msgid "\"I know, right? I mean, if I knew a place like that, I'd be inclined to work there myself."
msgstr "「そうなのよ。というか、知ってたら私が試したい気分だわ。"

#. Occurrence 8DOT5:7711:12312: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0058; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7711
msgctxt "text_id=12312 | speaker=aoko"
msgid "  I just want to make sure, but the only place you can gamble in Misaki is the pachinko parlor, right?\""
msgstr "　鳶丸。念のために訊くけど、三咲町にある“お金の稼げる遊び場”ってパチンコだけよね？」"

#. Occurrence 8DOT5:7741:12313: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0045; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7741
msgctxt "text_id=12313 | speaker=tobimaru"
msgid "\"According to my dad, there are no gambling spots that violate the Entertainment Business Act in town."
msgstr "「ああ。親父の話じゃ風営法にひっかかる<賭|と><場|ば>はねえとさ。"

#. Occurrence 8DOT5:7747:12314: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0046; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7747
msgctxt "text_id=12314 | speaker=tobimaru"
msgid "  He said the owner of the pachinko parlor is an agreeable sort who seems happy sticking to his current business.\""
msgstr "　三咲町の顔役は話の分かるおっさんで、クリーンな<極道|ごくどう>を目指してるらしい。パチンコ経営だけで満足してるって話だ」"

#. Occurrence 8DOT5:7758:12315: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0059; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7758
msgctxt "text_id=12315 | speaker=aoko"
msgid "\"Yeah, I know. I just wanted to make sure.\""
msgstr "「うん、それは知ってる。一応確認しただけ」"

#. Occurrence 8DOT5:7810:12316: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0060; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7810
msgctxt "text_id=12316 | speaker=aoko"
msgid "\"That just makes this whole thing even more mysterious."
msgstr "「でも、そうなるとますます謎ね。"

#. Occurrence 8DOT5:7816:12317: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0061; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7816
msgctxt "text_id=12317 | speaker=aoko"
msgid "  I can't think of any way other than gambling that you can make money that quickly.\""
msgstr "　ギャンブル以外でお金を倍々にしていく仕事なんて、ちょっと思い当たらないんだけど」"

#. Occurrence 8DOT5:7828:12318: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0047; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7828
msgctxt "text_id=12318 | speaker=tobimaru"
msgid "\"Yeah, nothing except maybe selling his body. Maybe people are paying him for a night.\""
msgstr "「ああ、体でも売ってるとしか思えない羽振りの良さだ。一晩いくら、みたいな」"

#. Occurrence 8DOT5:7849:12319: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0062; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7849
msgctxt "text_id=12319 | speaker=aoko"
msgid "\"...Huh?\""
msgstr "「―――へ？」"

#. Occurrence 8DOT5:7869:12320: scene=8DOT5
#: 8DOT5:7869
msgctxt "text_id=12320 | speaker=unknown"
msgid "  There was a slight delay in Aoko's reaction."
msgstr "　間の抜けた声がもれる。"

#. Occurrence 8DOT5:7874:12321: scene=8DOT5
#: 8DOT5:7874
msgctxt "text_id=12321 | speaker=unknown"
msgid "  It took her a few seconds to register what he was saying, but then her jaw dropped."
msgstr "　理解するのに数瞬を必要としたのか、青子はぽかんと口を開けた。"

#. Occurrence 8DOT5:7901:12322: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0063; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7901
msgctxt "text_id=12322 | speaker=aoko"
msgid "\"W-Wait, s-selling his body?! Are you serious?!\""
msgstr "「ちょっ、か、体って、あ、アンタ！」"

#. Occurrence 8DOT5:7907:12323: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0048; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7907
msgctxt "text_id=12323 | speaker=tobimaru"
msgid "\"Oh, chill out! I meant as a model or something. I heard they make pretty good money.\""
msgstr "「ほら、絵画のモデルとか。バイト代は高いときくぜ」"

#. Occurrence 8DOT5:7933:12324: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0064; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7933
msgctxt "text_id=12324 | speaker=aoko"
msgid "\"Ahh... Yeah, I've heard that too. And art school kids are usually pretty rich. Maybe that's all it is. That's not so bad.\""
msgstr "「あ―――うん、割はいいって言うわね。美大生ってお金持ちだし。そうよね、それぐらいなら別に」"

#. Occurrence 8DOT5:7939:12325: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0049; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:7939
msgctxt "text_id=12325 | speaker=tobimaru"
msgid "\"I mean, he would be nude, of course.\""
msgstr "「まあ、ヌードなのは当然だが」"

#. Occurrence 8DOT5:7950:12326: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0065; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:7950
msgctxt "text_id=12326 | speaker=aoko"
msgid "\"So he *is* getting naked for money!\""
msgstr "「結局はだかじゃない！」"

#. Occurrence 8DOT5:7983:12327: scene=8DOT5
#: 8DOT5:7983
msgctxt "text_id=12327 | speaker=unknown"
msgid "  Without any real information to go on, the conversation was quickly diverging further from the topic at hand."
msgstr "　決定的な情報を欠くため、話せば話すほど核心から遠ざかっていくようだ。"

#. Occurrence 8DOT5:7988:12328: scene=8DOT5
#: 8DOT5:7988
msgctxt "text_id=12328 | speaker=unknown"
msgid "  Without knowing the location or type of work..."
msgstr "　アルバイトの種類も、"

#. Occurrence 8DOT5:7993:12329: scene=8DOT5
#: 8DOT5:7993
msgctxt "text_id=12329 | speaker=unknown"
msgid "  There really wasn't much to talk about."
msgstr "　アルバイトの現場も分からないのでは話にならない。"

#. Occurrence 8DOT5:8024:12330: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0066; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8024
msgctxt "text_id=12330 | speaker=aoko"
msgid "\"Let's try to tail him again tomorrow. It'll be harder to lose him if there's two of us.\""
msgstr "「明日、もう一度草十郎を尾行するしかないわね。二人がかりなら見失うコトもないだろうし」"

#. Occurrence 8DOT5:8042:12331: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0050; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:8042
msgctxt "text_id=12331 | speaker=tobimaru"
msgid "\"Yeah, you're right. We don't have any other clues at the moment, so let's just pick this up tomorrow."
msgstr "「そうだな。他に手がかりもねえし、明日にするか。"

#. Occurrence 8DOT5:8049:12332: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0051_0; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:8049
msgctxt "text_id=12332 | speaker=tobimaru"
msgid "  All we know is he's making lots of money, and that's not really..."
msgstr "“草十郎の羽振りがいい”だけじゃどうしようも―――"

#. Occurrence 8DOT5:8062:12333: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0051_1; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:8062
msgctxt "text_id=12333 | speaker=tobimaru"
msgid " Hmm...\""
msgstr "あん？　羽振りがいい？」"

#. Occurrence 8DOT5:8082:12334: scene=8DOT5
#: 8DOT5:8082
msgctxt "text_id=12334 | speaker=unknown"
msgid "  Tobimaru furrowed his brow. It seemed he had thought of something."
msgstr "　む、と眉を寄せて思案する鳶丸。"

#. Occurrence 8DOT5:8092:12335: scene=8DOT5
#: 8DOT5:8092
msgctxt "text_id=12335 | speaker=unknown"
msgid "  His expression turned more dire by the second."
msgstr "　考えれば考えるほどイヤな予感が満ちていくのか、その<表|か><情|お>は苦虫をかみ潰したように険しくなっていく。"

#. Occurrence 8DOT5:8128:12336: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0067; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8128
msgctxt "text_id=12336 | speaker=aoko"
msgid "\"What's wrong, Tobimaru? Did you remember something?\""
msgstr "「どうしたの鳶丸。何か思い出した？」"

#. Occurrence 8DOT5:8139:12337: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0052; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:8139
msgctxt "text_id=12337 | speaker=tobimaru"
msgid "\"Hmm, kind of. I just remembered one other idiot who's been making a lot of cash recently."
msgstr "「……あー、ちょっとな。そういえば、最近妙に羽振りのいいバカがひとりいたなって。"

#. Occurrence 8DOT5:8145:12338: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0053; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:8145
msgctxt "text_id=12338 | speaker=tobimaru"
msgid "  Since about three days ago, he's been flaunting a lot of money and going to all these expensive mixer parties. And he's in the same class as Soujyuro.\""
msgstr "　そいつ、三日ぐらい前から金にあかして合コンし放題って話なんだが……頭の痛いコトに、草十郎と同じクラスのバカなんだよ、これが」"

#. Occurrence 8DOT5:8179:12339: scene=8DOT5
#: 8DOT5:8179
msgctxt "text_id=12339 | speaker=unknown"
msgid "  There were a few seconds of silence."
msgstr "　数秒、沈黙。"

#. Occurrence 8DOT5:8184:12340: scene=8DOT5
#: 8DOT5:8184
msgctxt "text_id=12340 | speaker=unknown"
msgid "  Aoko nodded. She had put two and two together."
msgstr "　青子はなるほど、と心底<合点|がてん>がいったように頷いて、"

#. Occurrence 8DOT5:8196:12341: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0068; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8196
msgctxt "text_id=12341 | speaker=aoko"
msgid "\"...I know who you're talking about.\""
msgstr "「―――アイツね」"

#. Occurrence 8DOT5:8202:12342: scene=8DOT5
#: 8DOT5:8202
msgctxt "text_id=12342 | speaker=unknown"
msgid "  The two immediately left the park to go and find the suspect."
msgstr "　さっそく捕まえに行きましょう、と公園を後にした。"

#. Occurrence 8DOT5:8253:12343: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0000; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8253
msgctxt "text_id=12343 | speaker=kinomi"
msgid "\"What's happenin'?"
msgstr "「ちゃりーす！"

#. Occurrence 8DOT5:8259:12344: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0001; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8259
msgctxt "text_id=12344 | speaker=kinomi"
msgid "  You know I can't turn down an invite even if I'm in the middle of studying. I'm here to party, guys!\""
msgstr "　およびとあらば補習だろうと即サボり、遊びのお誘いだけは断らない<木|き><乃|の><美|み>クンでーす！」"

#. Occurrence 8DOT5:8291:12345: scene=8DOT5
#: 8DOT5:8291
msgctxt "text_id=12345 | speaker=unknown"
msgid "  Suspect A was apprehended with ease."
msgstr "　容疑者Ａはたやすく捕獲できた。"

#. Occurrence 8DOT5:8296:12346: scene=8DOT5
#: 8DOT5:8296
msgctxt "text_id=12346 | speaker=unknown"
msgid "  Aoko and Tobimaru were both on the student council, so they knew their target would be at school for remedial lessons."
msgstr "　ターゲットが赤点の補習で学校にいる事は、生徒会であるふたりには既知の事実だったからだ。"

#. Occurrence 8DOT5:8301:12347: scene=8DOT5
#: 8DOT5:8301
msgctxt "text_id=12347 | speaker=unknown"
msgid "  Tobimaru got a girl in Kinomi's class to tell him he had some good news to share outside."
msgstr "　鳶丸が女生徒に「ちょっといい話があるから出てきてくれ」と伝言を伝えてから約十分。"

#. Occurrence 8DOT5:8306:12348: scene=8DOT5
#: 8DOT5:8306
msgctxt "text_id=12348 | speaker=unknown"
msgid "  Kinomi took the bait and came running out the school's front gate as fast as he could."
msgstr "　木乃美<芳助|ほうすけ>は神速の早足で正門前にやってきた。"

#. Occurrence 8DOT5:8346:12349: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0054; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:8346
msgctxt "text_id=12349 | speaker=tobimaru"
msgid "\"Hey, sorry to call you out when you're trying to study.\""
msgstr "「おう。補習中呼び出して悪かったな」"

#. Occurrence 8DOT5:8358:12350: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0002; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8358
msgctxt "text_id=12350 | speaker=kinomi"
msgid "\"No worries! I was actually just using school as an excuse to skip my job, but then that was boring too, so I was just having a nap in the nurse's office.\""
msgstr "「別に悪くないぜー？　補習を口実にバイトをさぼってみたものの、やっぱり補習もかったるかったんで、出席だけとって保健室で寝てただけだし」"

#. Occurrence 8DOT5:8384:12351: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0003; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8384
msgctxt "text_id=12351 | speaker=kinomi"
msgid "\"Then that's when I got the call from you!"
msgstr "「んで、ちょうど暇してたところに殿下からコールだろ。"

#. Occurrence 8DOT5:8384:12352: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0003; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8384
msgctxt "text_id=12352 | speaker=kinomi"
msgid "  So I'm all ready to party. What's going on?\""
msgstr "　豪遊できると飛んできたワケさ！」"

#. Occurrence 8DOT5:8390:12353: scene=8DOT5
#: 8DOT5:8390
msgctxt "text_id=12353 | speaker=unknown"
msgid "  Kinomi gave a double thumbs up to show he was really ready to have some fun."
msgstr "　バチィ！とサムズアップでやる気をアピール。"

#. Occurrence 8DOT5:8416:12354: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0055; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:8416
msgctxt "text_id=12354 | speaker=tobimaru"
msgid "\"I thought you'd be out and about, so I'm glad I caught you. I heard you've been holed up in the arcade for the past few days.\""
msgstr "「そうか。てっきり外で遊び歩いてるかと思ったが、助かったぜ。おまえ、連日ゲームセンターに入り浸りだって聞いてたからよ」"

#. Occurrence 8DOT5:8458:12355: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0004; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8458
msgctxt "text_id=12355 | speaker=kinomi"
msgid "\"Ah, yeah. I was there giving out free games and stuff, which is fun, but not so much once you run out of cash."
msgstr "「あー、あれね。ちょうど昨日ですっからかんよ。ゲーセンでおごりまくるのは気持ちいいけど、後に残るのは空しさばかりだよなあ。"

#. Occurrence 8DOT5:8464:12356: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0005; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8464
msgctxt "text_id=12356 | speaker=kinomi"
msgid "  Plus, I'm not really interested in becoming friends with punks from other schools, and it's all guys in there. Why don't girls like hanging out in arcades?\""
msgstr "　他校のヤンキーどもと仲良くなっても嬉しくねえっつうか、女っ気カイムというか。なんで女の子はゲーセンいやがるかねぇ」"

#. Occurrence 8DOT5:8491:12357: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0006; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8491
msgctxt "text_id=12357 | speaker=kinomi"
msgid "\"Anyway, that's all in the past. No point in talking about dough that's already spent. Easy come, easy go."
msgstr "「ま、それも過去の話だけどな。しょせんポッと湧いたあぶく銭、使っちまった金の話をしてもしょうがねえ。"

#. Occurrence 8DOT5:8497:12358: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0007; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8497
msgctxt "text_id=12358 | speaker=kinomi"
msgid "  Let's focus on the now! You're rich, right? You feel like taking a broke guy like me out on the town today, or what?\""
msgstr "　オレたちは明るく今の話をしよう。そうだろう、リッチな鳶丸クン。そのありあまる財力で、今日はボクを何処に連れて行ってくれるんだい？」"

#. Occurrence 8DOT5:8509:12359: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0056; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:8509
msgctxt "text_id=12359 | speaker=tobimaru"
msgid "\"Sure, but first this bigwig here has a few questions for you.\""
msgstr "「ああ。その前に、こちらの<御仁|ごじん>がおまえに話があるってよ」"

#. Occurrence 8DOT5:8515:12360: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0008; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8515
msgctxt "text_id=12360 | speaker=kinomi"
msgid "\"Huh?\""
msgstr "「へ？」"

#. Occurrence 8DOT5:8550:12361: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0069; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8550
msgctxt "text_id=12361 | speaker=aoko"
msgid "\"Hello there, Kinomi."
msgstr "「こんにちは木乃美君。"

#. Occurrence 8DOT5:8556:12362: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0070; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8556
msgctxt "text_id=12362 | speaker=aoko"
msgid "  Do you mind telling me a little about all this money you came into recently?\""
msgstr "　その、あぶく銭の話を聞かせてもらえるかしら」"

#. Occurrence 8DOT5:8574:12363: scene=8DOT5
#: 8DOT5:8574
msgctxt "text_id=12363 | speaker=unknown"
msgid "  Kinomi's expression went blank."
msgstr "　木乃美の表情が停止する。"

#. Occurrence 8DOT5:8579:12364: scene=8DOT5
#: 8DOT5:8579
msgctxt "text_id=12364 | speaker=unknown"
msgid "  If anyone could sniff out danger, it was him. And it stank like his impending doom."
msgstr "　危険に敏感な彼は、この時点で自らの終わりを察したらしい。"

#. Occurrence 8DOT5:8605:12365: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0009; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8605
msgctxt "text_id=12365 | speaker=kinomi"
msgid "\"Umm, well, you see, I... I really need to get back to studying, so... Is it okay if I head back?\""
msgstr "「アノー。ボク、勉強シタインデ、戻ッテイイデショウカ？」"

#. Occurrence 8DOT5:8626:12366: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0071; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8626
msgctxt "text_id=12366 | speaker=aoko"
msgid "\"Of course. Once you answer all of my questions. We don't have much time either, so I hope you'll confess quickly.\""
msgstr "「もちろん。洗いざらい質問に答え終わったら戻っていいわよ。こっちも時間が惜しいから、スムーズな自白を期待するわ」"

#. Occurrence 8DOT5:8652:12367: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0072; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8652
msgctxt "text_id=12367 | speaker=aoko"
msgid "\"So again, tell me about this money you recently came into."
msgstr "「それで、あぶく銭って何の話？"

#. Occurrence 8DOT5:8658:12368: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0073; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8658
msgctxt "text_id=12368 | speaker=aoko"
msgid "  I know you make around 20,000 yen a month from your part-time job. I don't think that's quite enough to live like a king for three days.\""
msgstr "　貴方の月々のバイト料は二万円前後よね。その金額で三日近くも王様の真似事は難しいと思うのだけど」"

#. Occurrence 8DOT5:8664:12369: scene=8DOT5
#: 8DOT5:8664
msgctxt "text_id=12369 | speaker=unknown"
msgid "  It seemed the next logical question would be to ask if he had begun a life of crime."
msgstr "　犯罪にでも手を染めた？　と続きそうな<質問|こえ>である。"

#. Occurrence 8DOT5:8703:12370: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0010; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8703
msgctxt "text_id=12370 | speaker=kinomi"
msgid "\"W-Why is this even any of your business?!"
msgstr "「な、なんだよ、会長には関係ないだろー！"

#. Occurrence 8DOT5:8709:12371: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0011; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8709
msgctxt "text_id=12371 | speaker=kinomi"
msgid "  You're treating me like a criminal! I don't have anything to confess! This isn't fair! What's going on?\""
msgstr "　そもそも自白って何デスカ。いきなり犯人扱いとか、いくらなんでも横暴じゃねえの？　つーか何の事件、これ？」"

#. Occurrence 8DOT5:8744:12372: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0074; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8744
msgctxt "text_id=12372 | speaker=aoko"
msgid "\"Nothing, yet. We just heard about some students who recently came into a significant amount of money, and we're looking into it."
msgstr "「まだ事件かどうかは何とも。最近お金の回りがいい生徒がいると聞いて、調べはじめたばかりだから。"

#. Occurrence 8DOT5:8750:12373: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0075; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8750
msgctxt "text_id=12373 | speaker=aoko"
msgid "  A job that pays tens of thousands of yen a day is very tempting to a broke student, but we haven't heard of any such jobs reported to the school."
msgstr "　毎日何万円ももらえる仕事なんて学生には目の毒だし、そういったアルバイトは学校側に報告されてないしね。"

#. Occurrence 8DOT5:8756:12374: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0076; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8756
msgctxt "text_id=12374 | speaker=aoko"
msgid "  It's our job as the student council to be on the look out for any dangers to our students. That's all.\""
msgstr "　生徒会として、危ない仕事だったら注意してあげないと」"

#. Occurrence 8DOT5:8792:12375: scene=8DOT5
#: 8DOT5:8792
msgctxt "text_id=12375 | speaker=unknown"
msgid "  Aoko was still smiling as she inched closer to Kinomi."
msgstr "　青子は微笑みをキープしたまま、じりじりと木乃美に近づいていく。"

#. Occurrence 8DOT5:8797:12376: scene=8DOT5
#: 8DOT5:8797
msgctxt "text_id=12376 | speaker=unknown"
msgid "  She had never spoken to him this nicely after what he had done at the entrance ceremony. That alone was enough to make him think he was in big trouble."
msgstr "　木乃美にしてみれば、入学からこっち、青子にこれほど愛想良く話しかけられた事はなく、なんというか、もうそれだけで自らの死期を悟らざるを得ない状況だった。"

#. Occurrence 8DOT5:8836:12377: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0012; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8836
msgctxt "text_id=12377 | speaker=kinomi"
msgid "\"R-Really? I haven't heard about anything like that..."
msgstr "「へ、へえ、それは初耳だなあ。最近金回りがいい生徒ねえ。"

#. Occurrence 8DOT5:8842:12378: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0013; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8842
msgctxt "text_id=12378 | speaker=kinomi"
msgid "  Ah, umm, my case is different. I was just using money I'd saved up. It's just before Christmas, so I thought I'd go a bit wild with my spending. Sort of a cleansing of the spirit, you know?\""
msgstr "　あ、オレのは違うよ。今まで貯めた貯金をなんとなく使っただけ。クリスマス前だから、こう派手に<浄財|じょうざい>しとこうかなって。<厄|やく>落とし的に？」"

#. Occurrence 8DOT5:8870:12379: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0057; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:8870
msgctxt "text_id=12379 | speaker=tobimaru"
msgid "\"Isn't this time of year usually when people are trying to save money?\""
msgstr "「普通、クリスマス前は貯金するもんだけどな」"

#. Occurrence 8DOT5:8904:12380: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0077; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8904
msgctxt "text_id=12380 | speaker=aoko"
msgid "\"Now, now, Tsukiji. Let's be more sensitive."
msgstr "「ダメよ槻司君、デリカシーが足りないわ。"

#. Occurrence 8DOT5:8910:12381: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0078; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8910
msgctxt "text_id=12381 | speaker=aoko"
msgid "  That being said, I hate to point this out, but it's obvious that Kinomi here has no date for Christmas Eve. It would be a shame if word of that got around school.\""
msgstr "　残酷な事実は口にしたくはないけど、木乃美君にはイヴを過ごす相手がいないって事でしょう。学友として、そこを追及したら可哀想よ」"

#. Occurrence 8DOT5:8956:12382: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0014; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:8956
msgctxt "text_id=12382 | speaker=kinomi"
msgid "\"I-I totally have a date! Seriously! Also, you're the one being insensitive here!\""
msgstr "「い、いるわい本命ぐらい！　真剣に同情する方がデリカシーに欠けると思うよオレは！」"

#. Occurrence 8DOT5:8976:12383: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0079; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:8976
msgctxt "text_id=12383 | speaker=aoko"
msgid "\"Oh, really? Then I guess you have some money saved up for your big Christmas Eve date then?\""
msgstr "「あら。じゃあ、イヴ用の資金はとってあるの？」"

#. Occurrence 8DOT5:9010:12384: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0015; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9010
msgctxt "text_id=12384 | speaker=kinomi"
msgid "\"Of course I do! Extra income and savings are two separate things."
msgstr "「あったりめえさ。臨時収入と貯金は別。"

#. Occurrence 8DOT5:9016:12385: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0016; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9016
msgctxt "text_id=12385 | speaker=kinomi"
msgid "  Look, my dad is super strict about watching my bank statements. He'd yell at me the moment he saw anything odd, thinking I was doing something bad. And my sister searches my room, so I can't hide anything there. They even found the porn mags I hid up in the ceiling. If they found an envelope full of cash, they'd take me down to the police station! So I used the money right away...\""
msgstr "　オレ、通帳オヤジに握られてるからさー、予定外の入金とかすぐバレて怒られるんだよ。どこで悪さしてきやがったって。部屋も妹がチェックするしさー、隠し場所とかないんだよー。天井裏に隠したエロ本すら見付けられるんだぜ、万札入った封筒とか見つかった日にゃ警察につれていかれる。だからソッコー使うしかなくってさー」"

#. Occurrence 8DOT5:9036:12386: scene=8DOT5
#: 8DOT5:9036
msgctxt "text_id=12386 | speaker=unknown"
msgid "  Kinomi laughed awkwardly, as if he was ashamed."
msgstr "　何が恥ずかしいのか、ははは、と照れ隠しに笑う木乃美。"

#. Occurrence 8DOT5:9041:12387: scene=8DOT5
#: 8DOT5:9041
msgctxt "text_id=12387 | speaker=unknown"
msgid "  He wasn't even aware of just how much he had let slip."
msgstr "　基本おしゃべりで感情だだもれな性格を、本人だけは気付いていない悲劇だった。"

#. Occurrence 8DOT5:9079:12388: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0080; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9079
msgctxt "text_id=12388 | speaker=aoko"
msgid "\"Oh, extra income? That's not what you said earlier.\""
msgstr "「へえ、臨時収入？　さっきと話、違うみたい」"

#. Occurrence 8DOT5:9093:12389: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0017; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9093
msgctxt "text_id=12389 | speaker=kinomi"
msgid "\"...Ah, no, I mean... It was a bonus from my part-time job. They just gave me an extra 5,000 yen! Just a little! It's nothing crazy!\""
msgstr "「―――あ。いや、それはほら、バイト先のボーナスみたいな。五千円ぐらい上乗せしてもらったの！　ほんのちょっと、ちょっとだけだって！　事件性とかないって！」"

#. Occurrence 8DOT5:9124:12390: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0081; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9124
msgctxt "text_id=12390 | speaker=aoko"
msgid "\"So why were you talking about an envelope full of cash?\""
msgstr "「万札入った封筒について詳しく」"

#. Occurrence 8DOT5:9150:12391: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0018; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9150
msgctxt "text_id=12391 | speaker=kinomi"
msgid "\"Urgh, I'm talking myself into a hole here! Are you trying to entrap me or something?"
msgstr "「うおお、話せば話すほど食い違っていくぜ！　なんだこれ孔明のワナか？"

#. Occurrence 8DOT5:9159:12392: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0019; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9159
msgctxt "text_id=12392 | speaker=kinomi"
msgid "  Y-You're getting a little close... You're kinda scaring me! Also, are you wearing boots?! You know, this feels oddly familiar!\""
msgstr "　ちょっ、会長近い、オーラすごい、なんか寒い！　しかもローファーじゃなくてブーツですか!?　この間合い、封じられたオレの記憶が蘇りそうなんですけどー！」"

#. Occurrence 8DOT5:9179:12393: scene=8DOT5
#: 8DOT5:9179
msgctxt "text_id=12393 | speaker=unknown"
msgid "  Kinomi backed away slowly."
msgstr "　じりじりと後退する木乃美と、"

#. Occurrence 8DOT5:9202:12394: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0082; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9202
msgctxt "text_id=12394 | speaker=aoko"
msgid "\"Kinomi? Do I have to remind you that we're running short on time here?\""
msgstr "「木乃美君？　時間がないって言ったの、もう一度アピールするべきかしら？」"

#. Occurrence 8DOT5:9215:12395: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0083; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9215
msgctxt "text_id=12395 | speaker=aoko"
msgid "\"I don't want to have to get physical with you.\""
msgstr "“直接、体に。”"

#. Occurrence 8DOT5:9221:12396: scene=8DOT5
#: 8DOT5:9221
msgctxt "text_id=12396 | speaker=unknown"
msgid "  The threat of a kick to the face from Aoko was enough to show him that she was serious."
msgstr "　そう、ぼそっと付け足すハイキックの鬼。"

#. Occurrence 8DOT5:9254:12397: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0020; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9254
msgctxt "text_id=12397 | speaker=kinomi"
msgid "\"Okay, okay. I'll talk! I'll talk!"
msgstr "「わかった、話す！　話すってばもー！"

#. Occurrence 8DOT5:9260:12398: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0021; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9260
msgctxt "text_id=12398 | speaker=kinomi"
msgid "  Yes, I am making extra income from a new part-time job. I got a bonus for introducing Sizuki to them, that's all!\""
msgstr "　臨時収入ってのはホントだよ！　新しいバイトがあってさ、そこに静希を紹介したら先輩にボーナスもらったんだよ！」"

#. Occurrence 8DOT5:9278:12399: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0084; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9278
msgctxt "text_id=12399 | speaker=aoko"
msgid "\"...What did you just say?\""
msgstr "「―――なんですって？」"

#. Occurrence 8DOT5:9298:12400: scene=8DOT5
#: 8DOT5:9298
msgctxt "text_id=12400 | speaker=unknown"
msgid "  If Kinomi really was working at the same part-time job as Soujyuro, she wanted to get as much information from him as she could."
msgstr "　仮に、木乃美が草十郎と同じバイトをしているのなら情報を引きずりだそう。"

#. Occurrence 8DOT5:9303:12401: scene=8DOT5
#: 8DOT5:9303
msgctxt "text_id=12401 | speaker=unknown"
msgid "  This was the exact response she had wanted from Kinomi, if not better."
msgstr "　そう考えていた青子にとって、木乃美の返答は期待通りであり、ちょっとばかり想像を超えていた。"

#. Occurrence 8DOT5:9347:12402: scene=8DOT5
#: 8DOT5:9347
msgctxt "text_id=12402 | speaker=unknown"
msgid "  But she felt dizzy from the implications."
msgstr "　悪い予感に目眩を覚える。"

#. Occurrence 8DOT5:9355:12403: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0085; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9355
msgctxt "text_id=12403 | speaker=aoko"
msgid "\"So you get a bonus for getting other people to join? That sounds like...\""
msgstr "「紹介したらボーナスをもらえるって、それ―――」"

#. Occurrence 8DOT5:9361:12404: scene=8DOT5
#: 8DOT5:9361
msgctxt "text_id=12404 | speaker=unknown"
msgid "  It was the oldest trick in the book for pyramid schemes and other unscrupulous business practices."
msgstr "　悪徳商法と名高い、ネズミ講のうたい文句そのものだ。"

#. Occurrence 8DOT5:9397:12405: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0022; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9397
msgctxt "text_id=12405 | speaker=kinomi"
msgid "\"It's not what you think."
msgstr "「いや、それがさー。"

#. Occurrence 8DOT5:9403:12406: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0023; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9403
msgctxt "text_id=12406 | speaker=kinomi"
msgid "  Sizuki said he was looking to make some extra money, so I told him about this kinda shady job.\""
msgstr "　静希が稼ぎを増やしたいっていうんで、ちょい怪しいバイトを紹介したんだよね」"

#. Occurrence 8DOT5:9435:12407: scene=8DOT5
#: 8DOT5:9435
msgctxt "text_id=12407 | speaker=unknown"
msgid "  This went back all the way to before final exams."
msgstr "　事は期末試験前にさかのぼる。"

#. Occurrence 8DOT5:9440:12408: scene=8DOT5
#: 8DOT5:9440
msgctxt "text_id=12408 | speaker=unknown"
msgid "  Kinomi told Soujyuro about a job he'd heard of from an older student."
msgstr "　とある理由から先立つものがない、と相談してきたクラスメイトに、木乃美は先輩経由で回ってきたアルバイトを紹介した。"

#. Occurrence 8DOT5:9445:12409: scene=8DOT5
#: 8DOT5:9445
msgctxt "text_id=12409 | speaker=unknown"
msgid "  Since the job required a \"kind, honest young man,\" Kinomi reluctantly gave up on it for himself and instead passed it on to a friend he thought fit that description."
msgstr "　先方が求めた人材が「心優しい、素直な青年」だったため、木乃美は泣く泣く出馬をあきらめ、代わりに条件の合う友人を送り出した―――という訳である。"

#. Occurrence 8DOT5:9474:12410: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0086; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9474
msgctxt "text_id=12410 | speaker=aoko"
msgid "\"I can't believe you did that to someone you consider a friend. You yourself knew it sounded shady."
msgstr "「信じられない。そんな怪しい話にクラスメイトを放り出しておいて、まだ友人顔するとか。"

#. Occurrence 8DOT5:9480:12411: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0087; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9480
msgctxt "text_id=12411 | speaker=aoko"
msgid "  What were you thinking?\""
msgstr "　木乃美君、普段なに考えて生きてるの？」"

#. Occurrence 8DOT5:9486:12412: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0024; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9486
msgctxt "text_id=12412 | speaker=kinomi"
msgid "\"Huh? Why wouldn't I pass something like this on to a friend?"
msgstr "「えー。トモダチでも紹介するでしょ、こういうの。"

#. Occurrence 8DOT5:9492:12413: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0025; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9492
msgctxt "text_id=12413 | speaker=kinomi"
msgid "  Dude needed help, so I tried to help him out. Plus, we both profited.\""
msgstr "　むしろ本当の友情ってこういうものよ？　静希も助かってオレも<潤|うるお>うんだからさー。無償の友情とかもうはやんないですよ？」"

#. Occurrence 8DOT5:9523:12414: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0088; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9523
msgctxt "text_id=12414 | speaker=aoko"
msgid "\"Well yeah, but then you also have to do your due diligence first before you tell them about something like that.\""
msgstr "「そりゃそうだけど、そういうのはちゃんと<責任|ケツ>持つ覚悟がある時だけ口にするものじゃないの？」"

#. Occurrence 8DOT5:9529:12415: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0026; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9529
msgctxt "text_id=12415 | speaker=kinomi"
msgid "\"That's way too much effort for a guy like me. I don't think you understand how friendship between guys works. You realize we're all dumb, right?\""
msgstr "「なにそれメンドくさーい。会長、男同士の友情に幻想持ちすぎだってば。基本、オレたちみんなバカよ？」"

#. Occurrence 8DOT5:9535:12416: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0089; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9535
msgctxt "text_id=12416 | speaker=aoko"
msgid "\"I do start to believe that the more I look at you, honestly."
msgstr "「貴方を見てると本気でそう思えてくるから不思議ね。"

#. Occurrence 8DOT5:9541:12417: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0090; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9541
msgctxt "text_id=12417 | speaker=aoko"
msgid "  How do you hang out with him, Tobimaru?\""
msgstr "　鳶丸。アンタ、よくこんなのと<連|つる>んでるわね」"

#. Occurrence 8DOT5:9572:12418: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0058; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:9572
msgctxt "text_id=12418 | speaker=tobimaru"
msgid "\"Okay, that's enough. You can lecture him later."
msgstr "「はいはいそこまで。説教するならまた後でな蒼崎。"

#. Occurrence 8DOT5:9578:12419: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0059; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:9578
msgctxt "text_id=12419 | speaker=tobimaru"
msgid "  It'll take at least a full day to reform someone as dense as him.\""
msgstr "　そいつ素で<最低|バカ>だから、本気で更生させたかったら一日使うぞ」"

#. Occurrence 8DOT5:9587:12420: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0027; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9587
msgctxt "text_id=12420 | speaker=kinomi"
msgid "\"Hey, come on. Give me a little credit at least. I can reform in a day!"
msgstr "「いや、足りますよ。ちゃんと一日で更生できますボク。"

#. Occurrence 8DOT5:9599:12421: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0028; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9599
msgctxt "text_id=12421 | speaker=kinomi"
msgid "  I'll probably forget everything once I sleep on it, though.\""
msgstr "　ただ、寝ると忘れちゃうだけで」"

#. Occurrence 8DOT5:9612:12422: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0091; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9612
msgctxt "text_id=12422 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 8DOT5:9633:12423: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0060; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:9633
msgctxt "text_id=12423 | speaker=tobimaru"
msgid "\"Hey, at least you're self-aware. It's easier than talking to someone who doesn't realize they're an idiot."
msgstr "「ほらな。まあ、<手前|テメエ>がバカだって自覚している分、気付いてない奴よりは付き合いやすい。"

#. Occurrence 8DOT5:9640:12424: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0061; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:9640
msgctxt "text_id=12424 | speaker=tobimaru"
msgid "There's not many people who realize that compassion is not for other people's benefit at such a young age.\""
msgstr "この若さで情けは人のためならず、を<実践|じっせん>してる野郎はそうはいねえし」"

#. Occurrence 8DOT5:9651:12425: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0092; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9651
msgctxt "text_id=12425 | speaker=aoko"
msgid "\"That makes sense. I guess I can see how you two would get along then.\""
msgstr "「……納得。たしかに、アンタと気が合いそうな性格ね」"

#. Occurrence 8DOT5:9684:12426: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0029; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9684
msgctxt "text_id=12426 | speaker=kinomi"
msgid "\"Wait, huh?"
msgstr "「え？　いやまいったなぁ！"

#. Occurrence 8DOT5:9690:12427: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0030; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9690
msgctxt "text_id=12427 | speaker=kinomi"
msgid "  Are you both trying to pick on me? I thought you were praising me just now!\""
msgstr "　なんだよ二人とも、いくらオレでも照れるじゃんか。いま、オレのこと褒めてなかった？」"

#. Occurrence 8DOT5:9696:12428: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0062; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:9696
msgctxt "text_id=12428 | speaker=tobimaru"
msgid "\"We're not praising you.\""
msgstr "「褒めてねえ」"

#. Occurrence 8DOT5:9702:12429: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0093; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9702
msgctxt "text_id=12429 | speaker=aoko"
msgid "\"Definitely not.\""
msgstr "「褒めてないわよ」"

#. Occurrence 8DOT5:9708:12430: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0031; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9708
msgctxt "text_id=12430 | speaker=kinomi"
msgid "\"Hmph, thought so.\""
msgstr "「うん、ですよね」"

#. Occurrence 8DOT5:9768:12431: scene=8DOT5
#: 8DOT5:9768
msgctxt "text_id=12431 | speaker=unknown"
msgid "  With Kinomi leading the way, Aoko and Tobimaru arrived at the part-time job in question."
msgstr "　木乃美を先頭に、青子たちは問題のアルバイト先へと到着した。"

#. Occurrence 8DOT5:9773:12432: scene=8DOT5
#: 8DOT5:9773
msgctxt "text_id=12432 | speaker=unknown"
msgid "  They moved past the new entertainment district in front of the station and into the seedy part of 2nd Street."
msgstr "　駅前の新繁華街から奥に移動し、気持ち、いかがわしい空気ただよう二丁目。"

#. Occurrence 8DOT5:9778:12433: scene=8DOT5
#: 8DOT5:9778
msgctxt "text_id=12433 | speaker=unknown"
msgid "  Aoko pointed to where she had lost Soujyuro when she was following him."
msgstr "　青子が草十郎を見失った場所とぴったり符合する。"

#. Occurrence 8DOT5:9800:12434: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0094; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9800
msgctxt "text_id=12434 | speaker=aoko"
msgid "\"It was right around here. So Kinomi, where is this place?\""
msgstr "「このあたりね。木乃美君、そのバイト先ってどこ？」"

#. Occurrence 8DOT5:9806:12435: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0032; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9806
msgctxt "text_id=12435 | speaker=kinomi"
msgid "\"Umm, just over there.\""
msgstr "「えーと、あのへん」"

#. Occurrence 8DOT5:9823:12436: scene=8DOT5
#: 8DOT5:9823
msgctxt "text_id=12436 | speaker=unknown"
msgid "  Kinomi pointed at a four-story office building."
msgstr "　木乃美が指さしたのは四階建てのオフィスビルだ。"

#. Occurrence 8DOT5:9828:12437: scene=8DOT5
#: 8DOT5:9828
msgctxt "text_id=12437 | speaker=unknown"
msgid "  The entrance was on one side of the first floor. At first glance, it looked no different from an apartment complex."
msgstr "　入り口は一階の端にあり、パッと見はマンションに見える。"

#. Occurrence 8DOT5:9848:12438: scene=8DOT5
#: 8DOT5:9848
msgctxt "text_id=12438 | speaker=unknown"
msgid "  The hallway on the first floor continued around to the back of the building."
msgstr "　一階の通路はビルの裏側まで続いている。"

#. Occurrence 8DOT5:9853:12439: scene=8DOT5
#: 8DOT5:9853
msgctxt "text_id=12439 | speaker=unknown"
msgid "  The stairs were located at the beginning of that hallway and were the first thing you saw after entering."
msgstr "　階段はその通路のはじめ、入り口から入ってすぐ正面に造られていた。"

#. Occurrence 8DOT5:9874:12440: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0095; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9874
msgctxt "text_id=12440 | speaker=aoko"
msgid "\"Let's go into that back alley.\""
msgstr "「ちょっと、そこの路地裏に入りましょう」"

#. Occurrence 8DOT5:9896:12441: scene=8DOT5
#: 8DOT5:9896
msgctxt "text_id=12441 | speaker=unknown"
msgid "  Aoko hurried off into the back alley where they were not likely to be seen."
msgstr "　ササッと人目につかない路地裏に移動する青子。"

#. Occurrence 8DOT5:9901:12442: scene=8DOT5
#: 8DOT5:9901
msgctxt "text_id=12442 | speaker=unknown"
msgid "  Three students stuck out like a sore thumb in an entertainment district like this."
msgstr "　風俗店の多い界隈で学生三人は目立つからだ。"

#. Occurrence 8DOT5:9932:12443: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0096; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9932
msgctxt "text_id=12443 | speaker=aoko"
msgid "\"So what goes on in here?"
msgstr "「で、中はどうなってんの？"

#. Occurrence 8DOT5:9938:12444: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0097; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:9938
msgctxt "text_id=12444 | speaker=aoko"
msgid "  You said it was an office, but what's the work like?\""
msgstr "　事務所って言ってたけど、どんな仕事？」"

#. Occurrence 8DOT5:9951:12445: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0033; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:9951
msgctxt "text_id=12445 | speaker=kinomi"
msgid "\"Huh? You're asking me? That's literally all I know. I just heard about the job from that student. I don't know the details. I brought Soujyuro here, they gave me the money, and that was it.\""
msgstr "「？　オレに訊いてんの？　やだなあ、オレが知ってるのはここまでだぜ？　オレだって先輩に言われただけで、中のコトなんて知らないし。草十郎をここまで連れてきたら、先輩が紹介料くれただけだし」"

#. Occurrence 8DOT5:9989:12446: scene=8DOT5
#: 8DOT5:9989
msgctxt "text_id=12446 | speaker=unknown"
msgid "  Their top suspect just admitted he knew no further details."
msgstr "　最有力容疑者はここにきて無知をさらけ出した。"

#. Occurrence 8DOT5:9994:12447: scene=8DOT5
#: 8DOT5:9994
msgctxt "text_id=12447 | speaker=unknown"
msgid "  Housuke Kinomi, co-defendant, or perhaps who they thought may have been the main culprit, was really no more than an annoying witness."
msgstr "　共犯者、もしくは主犯と思われた木乃美芳助は、その実、はた迷惑なだけの通行人Ａにすぎなかったのである。"

#. Occurrence 8DOT5:10020:12448: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0098; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10020
msgctxt "text_id=12448 | speaker=aoko"
msgid "\"...Well, this is no good. I still can't believe you're this irresponsible, Kinomi."
msgstr "「……まいった。ここまで無責任だといっそ<清々|すがすが>しい。"

#. Occurrence 8DOT5:10031:12449: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0099; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10031
msgctxt "text_id=12449 | speaker=aoko"
msgid "  Have you ever seen any westerns?"
msgstr "　ところで木乃美君、西部劇とか見たコトある？"

#. Occurrence 8DOT5:10031:12450: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0099; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10031
msgctxt "text_id=12450 | speaker=aoko"
msgid "  Do you know what they do with informants who are no longer useful?\""
msgstr "　役にたたない情報提供者の末路とか、ご存じかしら？」"

#. Occurrence 8DOT5:10054:12451: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0034; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:10054
msgctxt "text_id=12451 | speaker=kinomi"
msgid "\"I-I don't really watch many movies, honestly."
msgstr "「い、いやあ、オレ映画って苦手なんだよ。"

#. Occurrence 8DOT5:10054:12452: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0034; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:10054
msgctxt "text_id=12452 | speaker=kinomi"
msgid "  I have seen \"Sailor Suit and Machine Gun\" though. Mostly because I think the lead actress is hot.\""
msgstr "　でも『セーラー服と機関銃』なら見た。主演目当てで」"

#. Occurrence 8DOT5:10082:12453: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0100; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10082
msgctxt "text_id=12453 | speaker=aoko"
msgid "\"Ah, that's too bad. You should at least watch For a Few Dollars More sometime. The informant in that film meets an untimely demise, by the way.\""
msgstr "「そ、残念ね。『夕陽のガンマン』ぐらいは見とけば良かったのに。ま、どうあれ情報提供者は悲惨な死をとげるんだけど」"

#. Occurrence 8DOT5:10091:12454: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0035; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:10091
msgctxt "text_id=12454 | speaker=kinomi"
msgid "\"A-Are you serious? Your Highness! You need to put a collar on this girl! She's like a wild dog over here!\""
msgstr "「ちょっ、やる気満々だぜこの女！　殿下、こんな<凶獣|きょうじゅう>ほったらかしにしちゃまずいって、首輪とかつけないとさあ！」"

#. Occurrence 8DOT5:10117:12455: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0036; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:10117
msgctxt "text_id=12455 | speaker=kinomi"
msgid "\"...Tsukiji? Why are you making that face?"
msgstr "「……って槻司？　なんだよしけた顔しちゃって。"

#. Occurrence 8DOT5:10123:12456: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0037; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:10123
msgctxt "text_id=12456 | speaker=kinomi"
msgid "  Do you know something about that building?\""
msgstr "　あのビルがなにか知ってんの？」"

#. Occurrence 8DOT5:10150:12457: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0063; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10150
msgctxt "text_id=12457 | speaker=tobimaru"
msgid "\"...This is bad."
msgstr "「……まずいな。"

#. Occurrence 8DOT5:10156:12458: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0064; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10156
msgctxt "text_id=12458 | speaker=tobimaru"
msgid "  I know all about it. They're a fraudulent sales company that just came into town. They're a complete racket.\""
msgstr "　知ってるも何も、ありゃあ最近やってきた詐欺まがいのセールス屋だ。英会話セットの販売と何ら変わらねえ」"

#. Occurrence 8DOT5:10191:12459: scene=8DOT5
#: 8DOT5:10191
msgctxt "text_id=12459 | speaker=unknown"
msgid "  Aoko was sad to hear that the truth was as bad as she thought."
msgstr "　やはりそうか、と憂鬱になる青子と、"

#. Occurrence 8DOT5:10196:12460: scene=8DOT5
#: 8DOT5:10196
msgctxt "text_id=12460 | speaker=unknown"
msgid "  Kinomi seemed confused as usual."
msgstr "　英会話セット？　と首をかしげる木乃美。"

#. Occurrence 8DOT5:10231:12461: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0101; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10231
msgctxt "text_id=12461 | speaker=aoko"
msgid "\"Are you sure about that?\""
msgstr "「それ、確かなの鳶丸？」"

#. Occurrence 8DOT5:10237:12462: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0065; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10237
msgctxt "text_id=12462 | speaker=tobimaru"
msgid "\"Definitely. My dad heard it from his secretary, and she wouldn't lie."
msgstr "「ああ。親父の秘書さんから聞いた話だ、間違いない。"

#. Occurrence 8DOT5:10243:12463: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0066; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10243
msgctxt "text_id=12463 | speaker=tobimaru"
msgid "  They front as a kind of new religion, but they're actually selling down quilts. They target the elderly and sell them these super low quality quilts at extremely marked up prices.\""
msgstr "　表向きは新興宗教なんだが、やってるコトは<羽毛布団|うもうぶとん>の販売だとさ。じいさまばあさま相手に質の低い羽毛布団を高額で売りつけているらしい」"

#. Occurrence 8DOT5:10264:12464: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0067; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10264
msgctxt "text_id=12464 | speaker=tobimaru"
msgid "\"That's a leased office, so after they make their money here for a month or so, they're probably planning on skipping town."
msgstr "「あの事務所も貸事務所だ。一ヶ月もこの街で稼いだらあっさりドロンするつもりだろう。"

#. Occurrence 8DOT5:10270:12465: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0068; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10270
msgctxt "text_id=12465 | speaker=tobimaru"
msgid "  Soujyuro is most certainly being scammed. He's the perfect target for a group like that.\""
msgstr "　……間違いなく草十郎は騙されてるな。最高のカモだろ、詐欺師にとっちゃ」"

#. Occurrence 8DOT5:10289:12466: scene=8DOT5
#: 8DOT5:10289
msgctxt "text_id=12466 | speaker=unknown"
msgid "  Tobimaru slumped his shoulders in defeat."
msgstr "　ガックリと肩を落とす鳶丸。"

#. Occurrence 8DOT5:10294:12467: scene=8DOT5
#: 8DOT5:10294
msgctxt "text_id=12467 | speaker=unknown"
msgid "  Aoko, however, was already in full on battle mode."
msgstr "　一方、青子はもう完全に戦闘状態に移行していた。"

#. Occurrence 8DOT5:10319:12468: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0102; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10319
msgctxt "text_id=12468 | speaker=aoko"
msgid "\"I'll put a stop to this. And then I'm going to string you up on the school's flagpole, Kinomi!\""
msgstr "「よし潰す。そのあと木乃美は学校の旗のところに<吊|つる>す」"

#. Occurrence 8DOT5:10333:12469: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0038; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:10333
msgctxt "text_id=12469 | speaker=kinomi"
msgid "\"What?! You mean you're going to hang me?! That's murder, you know!\""
msgstr "「え、<直|じか>？　今の台詞だと<縄|なわ>じゃなくて首？　<脊髄|せきずい>にぐっさり？　殺人？」"

#. Occurrence 8DOT5:10346:12470: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0069; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10346
msgctxt "text_id=12470 | speaker=tobimaru"
msgid "\"Wait a second, Aozaki. Something's not right here."
msgstr "「あ、いや待て蒼崎。それだと辻褄が合わん。"

#. Occurrence 8DOT5:10352:12471: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0070; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10352
msgctxt "text_id=12471 | speaker=tobimaru"
msgid "  Soujyuro had wads of cash, right? Then how is he being scammed?\""
msgstr "　草十郎は大金を持ってたんだよな？　それじゃカモとは呼べねえぞ」"

#. Occurrence 8DOT5:10391:12472: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0103; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10391
msgctxt "text_id=12472 | speaker=aoko"
msgid "\"Hmm... You're right. I got so caught up with Kinomi that I forgot about all the money."
msgstr "「……そう言えばそうだった。木乃美君の発言に気を取られすぎて、あの大金のコトを忘れてた。"

#. Occurrence 8DOT5:10402:12473: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0104; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10402
msgctxt "text_id=12473 | speaker=aoko"
msgid "  So does that mean...?\""
msgstr "　あれ、ってコトは、まさか―――」"

#. Occurrence 8DOT5:10413:12474: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0071; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10413
msgctxt "text_id=12474 | speaker=tobimaru"
msgid "\"Right. If he was being scammed, he'd be the one losing money."
msgstr "「ああ。騙されている側だったら金は減っていく。"

#. Occurrence 8DOT5:10419:12475: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0072; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10419
msgctxt "text_id=12475 | speaker=tobimaru"
msgid "  But he's making money. I hope it isn't true, but maybe Soujyuro's the one doing the scamming.\""
msgstr "　……だが増えてるなら話は別だ。考えたくねえが、草十郎のヤツはセールス側に回ってるんじゃないか？」"

#. Occurrence 8DOT5:10460:12476: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0105; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10460
msgctxt "text_id=12476 | speaker=aoko"
msgid "\"...I can't believe it. Do you really think he'd join a group of scammers?\""
msgstr "「……信じられない。草十郎が、詐欺グループの一員になっている、ですって―――？」"

#. Occurrence 8DOT5:10473:12477: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0039; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:10473
msgctxt "text_id=12477 | speaker=kinomi"
msgid "\"Pfft, are you kidding me? Who in their right mind would be duped by Sizuki? He couldn't lie his way outta a paper bag! There's no way he's out here scheming.\""
msgstr "「はあ？　まっさかあ。静希に騙されるようなヤツはいねーよぉ。だいたい嘘つけないじゃんアイツ。羽毛布団を売りさばくとか、ぜったい無理だって」"

#. Occurrence 8DOT5:10498:12478: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0073; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10498
msgctxt "text_id=12478 | speaker=tobimaru"
msgid "\"Yeah, but maybe he doesn't realize what he's doing is scamming people. He probably really believes he's selling a good product.\""
msgstr "「だから、草十郎自身それが悪質なサギだと気づいてないんじゃないか？　アイツはアイツで、心からいいものだと思って売ってるんだよ。真心の固まりで」"

#. Occurrence 8DOT5:10510:12479: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0040_0; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:10510
msgctxt "text_id=12479 | speaker=kinomi"
msgid "\"That makes sense! His pure innocence is probably just the thing old folks like to see in a salesman! Maybe he'll give me a cut of his profits next time I see him―"
msgstr "「おお！　なるほど、そりゃ納得だ！　あの純真さがお年寄りに大人気ってワケだな！　やるじゃん静希、今度あったらオレもお<裾|すそ>分けしてもら、"

#. Occurrence 8DOT5:10528:12480: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0040_1; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:10528
msgctxt "text_id=12480 | speaker=kinomi"
msgid " Owwwww?!\""
msgstr "あいたぁ!?」"

#. Occurrence 8DOT5:10573:12481: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0106; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10573
msgctxt "text_id=12481 | speaker=aoko"
msgid "\"Looks like I'll have to teach you a lesson later after all."
msgstr "「……木乃美君の更生は今後の課題として。"

#. Occurrence 8DOT5:10579:12482: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0107; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10579
msgctxt "text_id=12482 | speaker=aoko"
msgid "  So what do we do, Tobimaru? Do we wait it out and gather more information? If he's really involved, he could be arrested for fraud. Though he is still a minor at least.\""
msgstr "　どうしよう鳶丸？　もう少し様子を見た方がいいと思う？仮に静希君が関わってたら、彼にも詐欺罪が適用される？　まだ未成年だけど」"

#. Occurrence 8DOT5:10590:12483: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0074; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10590
msgctxt "text_id=12483 | speaker=tobimaru"
msgid "\"If he's just an employee, he probably won't get any kind of real sentence. I guess it all depends on what his contract said when they hired him.\""
msgstr "「あくまで従業員だから実刑はかからねえとは思うが、敵さんはアレで食ってる連中だからな。草十郎が雇われた時の、契約書の内容次第だ」"

#. Occurrence 8DOT5:10629:12484: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0108; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10629
msgctxt "text_id=12484 | speaker=aoko"
msgid "\"Yeah that's true. He might already be a member of their group by now.\""
msgstr "「そう。そうよね。下手したら草十郎自身、もう入会してるかもしれない」"

#. Occurrence 8DOT5:10635:12485: scene=8DOT5
#: 8DOT5:10635
msgctxt "text_id=12485 | speaker=unknown"
msgid "  Aoko looked a lot more cool-headed now."
msgstr "　気が付けば、青子の顔つきは冷徹なものに変わっていた。"

#. Occurrence 8DOT5:10647:12486: scene=8DOT5
#: 8DOT5:10647
msgctxt "text_id=12486 | speaker=unknown"
msgid "  Tobimaru had been serving with her on the student council for over a year."
msgstr "　生徒会役員として一年以上付き合ってきた鳶丸だ。"

#. Occurrence 8DOT5:10652:12487: scene=8DOT5
#: 8DOT5:10652
msgctxt "text_id=12487 | speaker=unknown"
msgid "  He knew exactly what she was thinking at a time like this."
msgstr "　こういう時の彼女が何を考えているか、言われずとも分かっている。"

#. Occurrence 8DOT5:10685:12488: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0075; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10685
msgctxt "text_id=12488 | speaker=tobimaru"
msgid "\"If he's signed a contract, it's going to be hard to get him out of it. Even if he wants to leave, it's legally binding."
msgstr "「入会していたら脱会は難しいな。アイツ本人にその気がなくとも、<判子|はんこ>の力は絶大だ。"

#. Occurrence 8DOT5:10691:12489: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0076; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10691
msgctxt "text_id=12489 | speaker=tobimaru"
msgid "  ...How far do you wanna go with this?\""
msgstr "　……それで蒼崎、どこまでやる気だ？」"

#. Occurrence 8DOT5:10697:12490: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0109; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10697
msgctxt "text_id=12490 | speaker=aoko"
msgid "\"We have to at least stop their business. If they want to say they're free to practice their beliefs, they'll have to go worship elsewhere.\""
msgstr "「営業停止は最低ライン。信仰は自由だっていうなら、よその土地でやってもらうまでよ」"

#. Occurrence 8DOT5:10718:12491: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0077; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10718
msgctxt "text_id=12491 | speaker=tobimaru"
msgid "\"I could tell by the look on your face you weren't messing around."
msgstr "「だろうなあ、そんな顔してるぜおまえさん。"

#. Occurrence 8DOT5:10724:12492: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0078; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10724
msgctxt "text_id=12492 | speaker=tobimaru"
msgid "  What do we do about Soujyuro, then? Get him to quit first?\""
msgstr "　で、草十郎はどうする？　とりあえず辞めさせるか？」"

#. Occurrence 8DOT5:10730:12493: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0110; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10730
msgctxt "text_id=12493 | speaker=aoko"
msgid "\"Of course. This isn't only his problem anymore. The fact that they're trying to recruit our students makes it our problem too."
msgstr "「当然。けど、もう彼だけの問題じゃないわ。そもそもうちの生徒を雇おうとした時点で私たちの問題よ。"

#. Occurrence 8DOT5:10736:12494: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0111; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10736
msgctxt "text_id=12494 | speaker=aoko"
msgid "  We have to take them down, regardless of Sizuki's involvement.\""
msgstr "　静希君とは関係なしで、あの事務所<潰|つぶ>すから」"

#. Occurrence 8DOT5:10784:12495: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0079; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10784
msgctxt "text_id=12495 | speaker=tobimaru"
msgid "\"Fine, but you know they won't go down without a fight. They're technically a legal business, just like predatory loan services."
msgstr "「……いいけどな。厄介だぞあの手の連中は。サラ金と同じで法律上は何の問題もねえ。"

#. Occurrence 8DOT5:10791:12496: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0080; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10791
msgctxt "text_id=12496 | speaker=tobimaru"
msgid "The police can only give them a warning, and if we disrupt their business, they'll try and sue us for damages. We shouldn't rush into this.\""
msgstr "警察じゃせいぜい厳重注意レベル、下手に商売の邪魔をすれば<損害|そんがい><賠償|ばいしょう>と言いだしかねん。急いては事をなんとやらだ」"

#. Occurrence 8DOT5:10803:12497: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0112_0; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10803
msgctxt "text_id=12497 | speaker=aoko"
msgid "\"I know. First we need to find out more about the company, who their president is, and how many employees they have. We also need to look for possible victims, "
msgstr "「分かってる。まずは会社の概要と社長の素性、構成員の数を調べながら被害者の洗い出し、"

#. Occurrence 8DOT5:10815:12498: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0112_1; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10815
msgctxt "text_id=12498 | speaker=aoko"
msgid "then we can...\""
msgstr "を―――」"

#. Occurrence 8DOT5:10836:12499: scene=8DOT5
#: 8DOT5:10836
msgctxt "text_id=12499 | speaker=unknown"
msgid "  Aoko suddenly stopped talking in the middle of her detailed plans."
msgstr "　静かに、しかし大胆に密談していた青子の口が止まる。"

#. Occurrence 8DOT5:10848:12500: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0081_0; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10848
msgctxt "text_id=12500 | speaker=tobimaru"
msgid "\"What's wrong?"
msgstr "「どうした蒼崎―――って、"

#. Occurrence 8DOT5:10860:12501: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0081_1; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:10860
msgctxt "text_id=12501 | speaker=tobimaru"
msgid " Ah...\""
msgstr "げ」"

#. Occurrence 8DOT5:10865:12502: scene=8DOT5
#: 8DOT5:10865
msgctxt "text_id=12502 | speaker=unknown"
msgid "  Tobimaru noticed right away what Aoko had spotted."
msgstr "　物陰からオフィスビルを覗いていた鳶丸もその変化に気付いたようだ。"

#. Occurrence 8DOT5:10900:12503: scene=8DOT5
#: 8DOT5:10900
msgctxt "text_id=12503 | speaker=unknown"
msgid "  Aoko was looking at the crowd on the street."
msgstr "　青子の視線は通りの雑踏に向けられている。"

#. Occurrence 8DOT5:10910:12504: scene=8DOT5
#: 8DOT5:10910
msgctxt "text_id=12504 | speaker=unknown"
msgid "  A familiar young man wearing a coat was walking through the lively 2nd Street."
msgstr "　見慣れたコート姿の少年がいかがわしい二丁目を歩いている。"

#. Occurrence 8DOT5:10947:12505: scene=8DOT5
#: 8DOT5:10947
msgctxt "text_id=12505 | speaker=unknown"
msgid "  He walked confidently up to the office building and disappeared inside."
msgstr "　少年はわずかな迷いもなくオフィスビルまでやってくると、トコトコと足音をたてて入り口に消えていった。"

#. Occurrence 8DOT5:10957:12506: scene=8DOT5
#: 8DOT5:10957
msgctxt "text_id=12506 | speaker=unknown"
msgid "  He hadn't seemed to notice the worried trio watching from the shadows."
msgstr "　物陰に隠れている青子たちの気苦労もどこ吹く風。"

#. Occurrence 8DOT5:10962:12507: scene=8DOT5
#: 8DOT5:10962
msgctxt "text_id=12507 | speaker=unknown"
msgid "  The young man, clearly Soujyuro Sizuki, had just started his shift, still oblivious to the severity of the situation he was in."
msgstr "　少年……静希草十郎は軽い足取りで、自分が騙されている事にも気付かず、今日も一日、まじめに働きに来たらしい。"

#. Occurrence 8DOT5:10995:12508: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0113; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:10995
msgctxt "text_id=12508 | speaker=aoko"
msgid "\"That... that... little...\""
msgstr "「あ、あ、あの―――」"

#. Occurrence 8DOT5:11001:12509: scene=8DOT5
#: 8DOT5:11001
msgctxt "text_id=12509 | speaker=unknown"
msgid "  Aoko was shaking with rage."
msgstr "　青子は肩を震わせながら、<懸命|けんめい>に怒りを<堪|こら>えている。"

#. Occurrence 8DOT5:11022:12510: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0082; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11022
msgctxt "text_id=12510 | speaker=tobimaru"
msgid "\"Calm down."
msgstr "「待て、落ち着け蒼崎。"

#. Occurrence 8DOT5:11022:12511: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0082; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11022
msgctxt "text_id=12511 | speaker=tobimaru"
msgid "  I know how you feel, but he doesn't realize what he's doing.\""
msgstr "　気持ちは分かるが、あいつに悪気はだな」"

#. Occurrence 8DOT5:11043:12512: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0114; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11043
msgctxt "text_id=12512 | speaker=aoko"
msgid "\"Ahhhhh! I just can't stand this!\""
msgstr "「ああもう、なんか無性にあったまきたー！」"

#. Occurrence 8DOT5:11063:12513: scene=8DOT5
#: 8DOT5:11063
msgctxt "text_id=12513 | speaker=unknown"
msgid "  Aoko raised her head up in a fury and clenched her fists."
msgstr "　がばり、と俯いていた顔をあげ、拳を握る。"

#. Occurrence 8DOT5:11069:12514: scene=8DOT5
#: 8DOT5:11069
msgctxt "text_id=12514 | speaker=unknown"
msgid "  She was no longer her usual calm and collected self."
msgstr "　そこにあるのはいつもの冷淡な彼女ではなく、"

#. Occurrence 8DOT5:11074:12515: scene=8DOT5
#: 8DOT5:11074
msgctxt "text_id=12515 | speaker=unknown"
msgid "  This was the student council president who ruled with an iron fist, fueled by her own righteous indignation."
msgstr "　正義と<義憤|ぎふん>と個人的な感情で燃え上がる、鉄の生徒会長の姿だった。"

#. Occurrence 8DOT5:11129:12516: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0115; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11129
msgctxt "text_id=12516 | speaker=aoko"
msgid "\"Tobimaru, call up Mino and tell him we need twenty of the most intimidating guys from his team here immediately!"
msgstr "「鳶丸、応援団の<美濃|みの>先輩に連絡とって、いますぐ強面の団員二十人ほど集めてきて！"

#. Occurrence 8DOT5:11136:12517: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0116; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11136
msgctxt "text_id=12517 | speaker=aoko"
msgid "  Tell them to gear up because we might have a fight on our hands!\""
msgstr "　ケンカになるかもしれないから、それなりの装備こみでって！」"

#. Occurrence 8DOT5:11142:12518: scene=8DOT5
#: 8DOT5:11142
msgctxt "text_id=12518 | speaker=unknown"
msgid "  Aoko darted out into the main street as she barked her orders."
msgstr "　言いつつ、青子は表通りに飛びだした。"

#. Occurrence 8DOT5:11147:12519: scene=8DOT5
#: 8DOT5:11147
msgctxt "text_id=12519 | speaker=unknown"
msgid "  She looked like an esteemed general charging into battle against an enemy squadron."
msgstr "　その姿は<敵陣突入|カチコミ>にいく番長そのものである。"

#. Occurrence 8DOT5:11173:12520: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0083; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11173
msgctxt "text_id=12520 | speaker=tobimaru"
msgid "\"Mino? You mean the captain of the cheer squad?!"
msgstr "「美濃って応援団の団長のか!?"

#. Occurrence 8DOT5:11173:12521: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0083; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11173
msgctxt "text_id=12521 | speaker=tobimaru"
msgid "  Also, twenty guys?! What the hell are you planning on doing?!\""
msgstr "　しかも二十人って、おまえいったい何する気だ!?」"

#. Occurrence 8DOT5:11199:12522: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0117; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11199
msgctxt "text_id=12522 | speaker=aoko"
msgid "\"What do you think?! We're gonna crack some skulls!"
msgstr "「決まってるでしょ、殴り込みよ！"

#. Occurrence 8DOT5:11206:12523: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0118_0; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11206
msgctxt "text_id=12523 | speaker=aoko"
msgid "  We won't get anywhere trying to make this into a legal battle!"
msgstr "　まずは法律面での制裁から、なんて考えが甘かった！"

msgctxt "text_id=12524 | speaker=unknown"
msgid "  Any organization that's grooming students into committing crimes on their behalf will only answer to physical force!  "
msgstr "　学生だまして私腹を肥やすような悪党には物理的な制裁で十分よ！　そもそもスケールが小さいっての！　"

#. Occurrence 8DOT5:11221:12525: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0118_1; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11221
msgctxt "text_id=12525 | speaker=aoko"
msgid "I mean, what is this 'Light of Truth' garbage on their sign?! They can't just come into our town and sell their dingy down quilts to our unsuspecting citizens!\""
msgstr "なによ『ほんものの光』って、こんなしけた町で羽毛布団とか売ってんなー！」"

#. Occurrence 8DOT5:11248:12526: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0084; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11248
msgctxt "text_id=12526 | speaker=tobimaru"
msgid "\"Okay, just calm down! What happened to our peaceful plan just a minute ago? Only the police are allowed to use violence against criminals! Come back here!\""
msgstr "「待て落ち着け、さっきまでの平和的な<対処法|プラン>はどこにいった!?　悪党を暴力で押さえつけていいのは警察だけだ！　いいから戻りやがれ！」"

#. Occurrence 8DOT5:11271:12527: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0119; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11271
msgctxt "text_id=12527 | speaker=aoko"
msgid "\"Hey!"
msgstr "「ちょっ！"

msgctxt "text_id=12528 | speaker=unknown"
msgid "\""
msgstr "」"

#. Occurrence 8DOT5:11327:12529: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0120; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11327
msgctxt "text_id=12529 | speaker=aoko"
msgid "\"What was that for?! We're doing this precisely because you said the police can't do much! If you have a problem with it, then come up with a better plan!\""
msgstr "「なによ！　その警察が使えないから私たちが出張るんじゃない！　文句あるなら代案だせ！」"

#. Occurrence 8DOT5:11354:12530: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0085; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11354
msgctxt "text_id=12530 | speaker=tobimaru"
msgid "\"I don't necessarily have a problem with it, I'm just telling you to calm down for a minute!"
msgstr "「文句はねえ、まず落ち着けって話だ！"

#. Occurrence 8DOT5:11360:12531: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0086; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11360
msgctxt "text_id=12531 | speaker=tobimaru"
msgid "  I haven't had time to think of an alternative plan, even if I wanted to. What were you thinking of earlier? You said something about going through the legal system.\""
msgstr "　そもそも代案なんざ立てるまでもねえ。おまえさん、さっきはどんな手を考えてたか口にしてみろ。まずは法律面での制裁を、とか言ってただろう」"

#. Occurrence 8DOT5:11386:12532: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0121; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11386
msgctxt "text_id=12532 | speaker=aoko"
msgid "\"You know what I was getting at."
msgstr "「そんなのアンタだって分かってるでしょ。"

#. Occurrence 8DOT5:11392:12533: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0122; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11392
msgctxt "text_id=12533 | speaker=aoko"
msgid "  While we investigate the company, we should also help victims of the scam come together."
msgstr "　あの会社の調査と並行して、詐欺の被害にあった人たちを探して、私たちが間に入って連盟を作る。"

#. Occurrence 8DOT5:11398:12534: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0123; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11398
msgctxt "text_id=12534 | speaker=aoko"
msgid "  The reason why this company is targeting the elderly is likely because they're out of touch with the times."
msgstr "　ご老人ばかりを標的にしてるのは、お爺さんたちは世間の事情に<疎|うと>いとみくびってるからだろうし。"

#. Occurrence 8DOT5:11404:12535: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0124; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11404
msgctxt "text_id=12535 | speaker=aoko"
msgid "  If we can help them understand this issue, they'll be able to work together.\""
msgstr "　なんで、お爺さんたちだけじゃ分からない問題を私たちでフォローしてあげれば、被害者の会ぐらいは作れるわ」"

#. Occurrence 8DOT5:11425:12536: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0087; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11425
msgctxt "text_id=12536 | speaker=tobimaru"
msgid "\"That sounds great."
msgstr "「よし、その調子だ。"

#. Occurrence 8DOT5:11432:12537: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0088; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11432
msgctxt "text_id=12537 | speaker=tobimaru"
msgid "The victims will be able to do more if they work together as a group, rather than as individuals."
msgstr "たしかにひとりひとりでかけ合っても連中にとっちゃ痛くもかゆくもねえ。横の繋がりを作るのは大事だからな。"

#. Occurrence 8DOT5:11438:12538: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0089; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11438
msgctxt "text_id=12538 | speaker=tobimaru"
msgid "  Then what? If we assume there was no kind of contract involved, we just try and get their money back?\""
msgstr "　それで？　契約をなかった事にして、とられた金を取り戻すか？」"

#. Occurrence 8DOT5:11465:12539: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0125; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11465
msgctxt "text_id=12539 | speaker=aoko"
msgid "\"...Yeah, but that's probably going to be impossible."
msgstr "「……それは無理でしょうね。"

#. Occurrence 8DOT5:11471:12540: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0126; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11471
msgctxt "text_id=12540 | speaker=aoko"
msgid "  They almost definitely will have a contract. It's annoying, but if they signed something, we can't overturn that. All we can do now is try and stop the damages from getting worse. Cancel loans, cancel memberships, and...\""
msgstr "　契約書は絶対よ。あったまくるけど、書かれた事はくつがえらない。今から出来るのはこれ以上の被害を抑えるコトだけ。ローンの解約、入会の破棄、それと―――」"

#. Occurrence 8DOT5:11477:12541: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0090; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11477
msgctxt "text_id=12541 | speaker=tobimaru"
msgid "\"And?\""
msgstr "「それと？」"

#. Occurrence 8DOT5:11518:12542: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0127; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11518
msgctxt "text_id=12542 | speaker=aoko"
msgid "\"Get as much money back as we can."
msgstr "「可能なかぎり、金銭を回収する。"

#. Occurrence 8DOT5:11524:12543: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0128; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11524
msgctxt "text_id=12543 | speaker=aoko"
msgid "  There should be a cooling-off period for the down quilts, so some might be able to get a refund.\""
msgstr "　羽毛布団ならクーリングオフが適用されるはず。全ての返品は無理でも、やるにこしたことはないわ」"

#. Occurrence 8DOT5:11575:12544: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0091; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11575
msgctxt "text_id=12544 | speaker=tobimaru"
msgid "\"That sounds like a plan. Let's go with that."
msgstr "「上出来だ。それで行こうぜ蒼崎。"

#. Occurrence 8DOT5:11581:12545: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0092; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11581
msgctxt "text_id=12545 | speaker=tobimaru"
msgid "  There's no need for you to become the bad guy here. Let's try to solve this peacefully and within the law.\""
msgstr "　何もおまえさんが悪役になる必要はねえ。せっかくの法治国家だ、平和的に解決しよう」"

#. Occurrence 8DOT5:11592:12546: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0129; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11592
msgctxt "text_id=12546 | speaker=aoko"
msgid "\"That's true, but it's easy for you to say that since you weren't one of the victims. For those that were scammed, that money is lost forever.\""
msgstr "「それはそうだけど……こんなの部外者だから言えることよ。詐欺にあった人たちからすれば、<奪|と>られたものは奪られたままなんだし……」"

#. Occurrence 8DOT5:11637:12547: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0093; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11637
msgctxt "text_id=12547 | speaker=tobimaru"
msgid "\"Yeah, but it's not your job to worry about that."
msgstr "「それを気に病むのは、それこそおまえの仕事じゃねえ。"

#. Occurrence 8DOT5:11643:12548: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0094; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11643
msgctxt "text_id=12548 | speaker=tobimaru"
msgid "  We should get in touch with Kumari. She was raised in the shopping district and should know the best way to go about things.\""
msgstr "　まずは<久|く><万|ま><梨|り>に連絡しよう。あいつ、商店街の娘だからな。被害者の調査に向いているだろ」"

#. Occurrence 8DOT5:11669:12549: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0130; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11669
msgctxt "text_id=12549 | speaker=aoko"
msgid "\"Kojika?"
msgstr "「<金鹿|こじか>に？"

#. Occurrence 8DOT5:11676:12550: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0131; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11676
msgctxt "text_id=12550 | speaker=aoko"
msgid "  ...I hate to get her involved in this, but we don't have much of a choice."
msgstr "　……あんまり<荒事|あらごと>に巻きこみたくないけど、仕方ないか。"

#. Occurrence 8DOT5:11683:12551: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0132; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11683
msgctxt "text_id=12551 | speaker=aoko"
msgid "Okay, I'll get in touch with her. I still need you to call up Mino.\""
msgstr "ＯＫ、私の方から連絡する。鳶丸は<美|み><濃|の>先輩への電話、お願い」"

#. Occurrence 8DOT5:11709:12552: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0095; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11709
msgctxt "text_id=12552 | speaker=tobimaru"
msgid "\"Huh? Why do we still need the cheer squad with this plan?\""
msgstr "「あ？　こっちの話なら応援団、必要ねえだろ？」"

#. Occurrence 8DOT5:11735:12553: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0133; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11735
msgctxt "text_id=12553 | speaker=aoko"
msgid "\"They're good for more than just intimidation. They can help support the victims when we find them."
msgstr "「必要だってば。脅し要員だけじゃなく、お爺さん<間|かん>の連携に走ってもらわなくっちゃ。"

#. Occurrence 8DOT5:11741:12554: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0134; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11741
msgctxt "text_id=12554 | speaker=aoko"
msgid "  I know Mino's team looks scary, but they're all good at heart, right? Once we've made sure there's a cooling-off period for those contracts, they can take care of the paperwork for them.\""
msgstr "　先輩たち、いかつい顔して優しいでしょ？　クーリングオフは書面に起こす事が大前提。書類に弱いお爺さんたちの代わりに、先輩たちに代筆してもらうのよ」"

#. Occurrence 8DOT5:11777:12555: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0096; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:11777
msgctxt "text_id=12555 | speaker=tobimaru"
msgid "\"That's not a bad idea! I bet those idiots won't know what to do when twenty big strong guys come in demanding refunds!\""
msgstr "「なるほど、そりゃあいい！　数の暴力だな、連中も二十人からの返品は夢にも思ってねえだろうさ！」"

#. Occurrence 8DOT5:11783:12556: scene=8DOT5
#: 8DOT5:11783
msgctxt "text_id=12556 | speaker=unknown"
msgid "  Aoko and Tobimaru both nodded in agreement."
msgstr "　うんうんと頷きあう青子と鳶丸。"

#. Occurrence 8DOT5:11788:12557: scene=8DOT5
#: 8DOT5:11788
msgctxt "text_id=12557 | speaker=unknown"
msgid "  Kinomi had been completely left to the wayside in this whole discussion."
msgstr "　端で見ている木乃美は完全に置いてけぼりだ。"

#. Occurrence 8DOT5:11824:12558: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0041; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:11824
msgctxt "text_id=12558 | speaker=kinomi"
msgid "\"Hey, so... What's a cooling-off period?"
msgstr "「なー。クーリングオフってなんだよー？"

#. Occurrence 8DOT5:11830:12559: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0042; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:11830
msgctxt "text_id=12559 | speaker=kinomi"
msgid "  I've never heard of it.\""
msgstr "　オレ、聞いたことねぇんだけど」"

#. Occurrence 8DOT5:11843:12560: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0135; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11843
msgctxt "text_id=12560 | speaker=aoko"
msgid "\"It's a clause that allows you to return an item you purchased and get a refund for the full amount paid at the time of purchase. It was officially put into practice in Japan about ten years ago. You really haven't heard of it?\""
msgstr "「買った商品を返品して、購入時の金額を返して貰うコトよ。日本じゃ十年ぐらい前から正式に採用されてるけど、木乃美君、聞いたことない？」"

#. Occurrence 8DOT5:11869:12561: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0043; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:11869
msgctxt "text_id=12561 | speaker=kinomi"
msgid "\"No, never. How is that any different from a normal return?\""
msgstr "「いやまったく。ただの返品と違うの？」"

#. Occurrence 8DOT5:11880:12562: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0136; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11880
msgctxt "text_id=12562 | speaker=aoko"
msgid "\"Well, it's the same, but it's just legally protected. If the Light of Truth wants to use the law to their advantage, then we can do the same."
msgstr "「同じだけど、こっちは国が後ろ盾になってくれるわ。ほんものの光が法を盾にするなら、こっちも法で突き破るだけよ。"

#. Occurrence 8DOT5:11886:12563: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0137; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:11886
msgctxt "text_id=12563 | speaker=aoko"
msgid "  The elderly victims probably won't know a thing about it either, so that's why we're going to fight for them.\""
msgstr "　お爺さんたちには馴染みのない話だろうから、そこは私たちが代わりにやるってワケ」"

#. Occurrence 8DOT5:11921:12564: scene=8DOT5
#: 8DOT5:11921
msgctxt "text_id=12564 | speaker=unknown"
msgid "  In reality, only a very narrow range of products were applicable for the satisfaction period law, and it was currently unclear if those handled by the Light of Truth fell under that umbrella."
msgstr "　実際のところ、クーリングオフの選定商品には細かい指定があり、ほんものの光が扱っている商品がその規定内かは現状<定|さだ>かではない。"

#. Occurrence 8DOT5:11926:12565: scene=8DOT5
#: 8DOT5:11926
msgctxt "text_id=12565 | speaker=unknown"
msgid "  If it was not applicable under this law, Aoko would have to think of another plan."
msgstr "　もし規定外であるならクーリングオフ制度による金銭回収はできず、青子は別の手段を講じる必要がある。"

#. Occurrence 8DOT5:11946:12566: scene=8DOT5
#: 8DOT5:11946
msgctxt "text_id=12566 | speaker=unknown"
msgid "  However..."
msgstr "　……もっとも。"

#. Occurrence 8DOT5:11951:12567: scene=8DOT5
#: 8DOT5:11951
msgctxt "text_id=12567 | speaker=unknown"
msgid "  Not thirty minutes later, that worry would vanish when they got the chance to examine an actual quilt sold by the Light of Truth."
msgstr "　三十分後、実際に売られた羽毛布団を調べた時点で、その不安材料は霧散することになるのだが。"

#. Occurrence 8DOT5:11987:12568: scene=8DOT5
#: 8DOT5:11987
msgctxt "text_id=12568 | speaker=unknown"
msgid "  Once Aoko has an established plan, she will not waver from it."
msgstr "　方針さえ決めてしまえば青子に迷いはない。"

#. Occurrence 8DOT5:11992:12569: scene=8DOT5
#: 8DOT5:11992
msgctxt "text_id=12569 | speaker=unknown"
msgid "  They had made a cafe with a view of the office building their command center."
msgstr "　オフィスビルを見渡せる喫茶店を司令室に、"

#. Occurrence 8DOT5:11997:12570: scene=8DOT5
#: 8DOT5:11997
msgctxt "text_id=12570 | speaker=unknown"
msgid "  And, after they got together others from the student council for backup..."
msgstr "　生徒会の人材を手足にし、"

#. Occurrence 8DOT5:12002:12571: scene=8DOT5
#: 8DOT5:12002
msgctxt "text_id=12571 | speaker=unknown"
msgid "  Their one-day blitz tactic plan began."
msgstr "　一日かぎりの電撃作戦がはじまった。"

#. Occurrence 8DOT5:12037:12572: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0138; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12037
msgctxt "text_id=12572 | speaker=aoko"
msgid "\"I want this over with quickly."
msgstr "「そうと決まれば迅速にね。"

#. Occurrence 8DOT5:12045:12573: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0139; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12045
msgctxt "text_id=12573 | speaker=aoko"
msgid "  You two, take care of all the communications. Let's get this done today.\""
msgstr "　二人とも連絡係よろしく。サクッと、今日中に決着をつけましょ」"

#. Occurrence 8DOT5:12079:12574: scene=8DOT5
#: 8DOT5:12079
msgctxt "text_id=12574 | speaker=unknown"
msgid "  Tobimaru sighed at the thought of trying to complete everything in a day's time."
msgstr "　一日で終わらせる気かよ、と呆れる副会長と、"

#. Occurrence 8DOT5:12084:12575: scene=8DOT5
#: 8DOT5:12084
msgctxt "text_id=12575 | speaker=unknown"
msgid "  Kinomi, on the other hand, wondered why he had been dragged in to help."
msgstr "　なんでオレまで数に入ってんの？　と嫌がる事件の発端を使いに出して、青子はクーリングオフ以外の手はないかと資料を読み<耽|ふけ>っている。"

#. Occurrence 8DOT5:12090:12576: scene=8DOT5
#: 8DOT5:12090
msgctxt "text_id=12576 | speaker=unknown"
msgid "  Although Tobimaru had gotten Aoko to abandon the idea of a physical fight, Aoko knew that the contact plan would be difficult to pull off and continued to research other options."
msgstr "　鳶丸にはタンカを切ったものの、青子自身、クーリングオフ作戦は難しいと理解していたからだ。"

#. Occurrence 8DOT5:12123:12577: scene=8DOT5
#: 8DOT5:12123
msgctxt "text_id=12577 | speaker=unknown"
msgid "  There were many conditions that needed to be met for this plan to actually work."
msgstr "　クーリングオフを成立させるには様々な条件がある。"

#. Occurrence 8DOT5:12128:12578: scene=8DOT5
#: 8DOT5:12128
msgctxt "text_id=12578 | speaker=unknown"
msgid "  The major issue was the amount of time elapsed from the time of purchase."
msgstr "　その中で最大のネックになるのが購買してからの経過時間だ。"

#. Occurrence 8DOT5:12133:12579: scene=8DOT5
#: 8DOT5:12133
msgctxt "text_id=12579 | speaker=unknown"
msgid "  For consumable goods, the time limit for a legal return was eight days."
msgstr "　消耗品なら八日以内の返却でなければならない。"

#. Occurrence 8DOT5:12138:12580: scene=8DOT5
#: 8DOT5:12138
msgctxt "text_id=12580 | speaker=unknown"
msgid "  If there were thirty or so victims, this would probably only be applicable to one or two of them."
msgstr "　被害者が三十人いるとしても、該当するのは一人か二人だろう。"

#. Occurrence 8DOT5:12143:12581: scene=8DOT5
#: 8DOT5:12143
msgctxt "text_id=12581 | speaker=unknown"
msgid "  If that was the case, they needed to look for some other consumer protection besides the satisfaction clause."
msgstr "　となると、クーリングオフ以外での、消費者の保護を扱った抜け道を探すしかない。"

#. Occurrence 8DOT5:12174:12582: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0140; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12174
msgctxt "text_id=12582 | speaker=aoko"
msgid "\"Wait, really...? If items of low value are sold at an unfair price, the contract may be invalidated as profiteering. However, this must be founded in public order and morality... Doesn't this generally always favor the seller?"
msgstr "「……なになに……安価なものを不当な金額で売りつけた場合、暴利行為として公序良俗違反で契約が無効となる場合がある……ただし公序良俗を根拠とする……って、なによこれ、ほとんど売る側の勝ちじゃない。"

#. Occurrence 8DOT5:12180:12583: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0141; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12180
msgctxt "text_id=12583 | speaker=aoko"
msgid "  The courts can't punish solely on the basis of suspicion. We'd be at the disadvantage if it came to an extended argument.\""
msgstr "　疑わしきは罰せずが法廷の基本だし。水掛け論じゃこっちが不利だ」"

#. Occurrence 8DOT5:12212:12584: scene=8DOT5
#: 8DOT5:12212
msgctxt "text_id=12584 | speaker=unknown"
msgid "  It was a difficult situation."
msgstr "　だが状況は<厳|きび>しい。"

#. Occurrence 8DOT5:12217:12585: scene=8DOT5
#: 8DOT5:12217
msgctxt "text_id=12585 | speaker=unknown"
msgid "  They wouldn't be able to stand up to an experienced group of scam artists with their limited knowledge of the law."
msgstr "　相手が<百戦錬磨|ひゃくせんれんま>の詐欺集団なら、素人の知識では太刀打ちできまい。"

#. Occurrence 8DOT5:12222:12586: scene=8DOT5
#: 8DOT5:12222
msgctxt "text_id=12586 | speaker=unknown"
msgid "  They'd need to fight fire with fire. Or in this case, a scam with a scam."
msgstr "　最終的には同じ土俵での戦い―――詐欺には詐欺でまるめこむ事になる。"

#. Occurrence 8DOT5:12243:12587: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0142; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12243
msgctxt "text_id=12587 | speaker=aoko"
msgid "\"...So basically we scam them out of the same amount of money they scammed out of the victims.\""
msgstr "「……だまし取られた金額分だけ、美味しい話でだましとるって<寸法|はなし>か……」"

#. Occurrence 8DOT5:12249:12588: scene=8DOT5
#: 8DOT5:12249
msgctxt "text_id=12588 | speaker=unknown"
msgid "  To do that, they'd need more intel."
msgstr "　その場合であっても情報は必要だ。"

#. Occurrence 8DOT5:12254:12589: scene=8DOT5
#: 8DOT5:12254
msgctxt "text_id=12589 | speaker=unknown"
msgid "  Aoko was studying the materials they'd collected for something they could use."
msgstr "　青子は期末の一夜漬けもかくやという集中力で、かき集めた資料を頭に叩きこんでいく。"

#. Occurrence 8DOT5:12312:12590: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8DOT5_0000; voice_prefix=B10; voice_category=5; scene=8DOT5
#: 8DOT5:12312
msgctxt "text_id=12590 | speaker=kojika"
msgid "\"Thanks for waiting, everyone. I've got the addresses of ten additional candidates and one of the actual quilts sold.\""
msgstr "「お待たせ。とりあえず追加候補十人分の住所と、布団の現物、持ってきたわよ」"

#. Occurrence 8DOT5:12318:12591: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_9000; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12318
msgctxt "text_id=12591 | speaker=aoko"
msgid "\"Thank you. You really get things done fast when you put your mind to it!\""
msgstr "「サンキュー。さっすが久万梨、本気だせば仕事の速いこと速いこと」"

#. Occurrence 8DOT5:12353:12592: scene=8DOT5
#: 8DOT5:12353
msgctxt "text_id=12592 | speaker=unknown"
msgid "  Aoko took the list of victims from the student council secretary, Kojika Kumari, and immediately contacted Tobimaru on his pager."
msgstr "　生徒会書記・久万梨金鹿から被害者のリストを受け取って、すぐさま鳶丸の小型無線機に連絡をいれる。"

#. Occurrence 8DOT5:12358:12593: scene=8DOT5
#: 8DOT5:12358
msgctxt "text_id=12593 | speaker=unknown"
msgid "  Although pagers could only receive short messages like 'Call me,' they were a powerful means of communication in an age where people relied on public telephones."
msgstr "　小<型無線|ポケベル>機は“連絡求む”程度の短いメッセージしか送信できないが、連絡手段を公衆電話に頼っている昨今では強力な通信装置だ。"

#. Occurrence 8DOT5:12363:12594: scene=8DOT5
#: 8DOT5:12363
msgctxt "text_id=12594 | speaker=unknown"
msgid "  Tobimaru called the cafe to give Aoko an update and hear about the list of newly discovered victims."
msgstr "　青子は折り返しで喫茶店に連絡を入れてきた鳶丸に新しい被害者たちを伝え、鳶丸たちの現状も報告してもらう。"

#. Occurrence 8DOT5:12393:12595: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0143; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12393
msgctxt "text_id=12595 | speaker=aoko"
msgid "\"You've got all the victims together? Let Aoyama handle the proceedings. If you could get some business cards made up to throw them off, that'd be helpful too."
msgstr "「被害者の会はできたのね？　仕切りは青山クンにやらせて。一応、相手への牽制として名刺も作ってくれると助かる。"

#. Occurrence 8DOT5:12402:12596: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0144; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12402
msgctxt "text_id=12596 | speaker=aoko"
msgid "  Remember that fake organization we made up for the school festival? Use that and put that phone number on the cards. We can have Mr. Yamasiro field the calls.\""
msgstr "　事務局はほら、文化祭の時に作ったニセ団体あるじゃない。あそこの電話番号にしておいて。電話番は山城センセに頼みこむわ」"

#. Occurrence 8DOT5:12438:12597: scene=8DOT5
#: 8DOT5:12438
msgctxt "text_id=12597 | speaker=unknown"
msgid "  The victims' advocacy group was currently at just over ten members."
msgstr "　被害者友の会は現状で十人強。"

#. Occurrence 8DOT5:12443:12598: scene=8DOT5
#: 8DOT5:12443
msgctxt "text_id=12598 | speaker=unknown"
msgid "  The group's aim was to help the victims of the scam get their money back and remove themselves from the Light of Truth."
msgstr "　返品、脱会を望む人々の力になるのが会の趣旨である。"

#. Occurrence 8DOT5:12448:12599: scene=8DOT5
#: 8DOT5:12448
msgctxt "text_id=12599 | speaker=unknown"
msgid "  Some of the victims had not even realized they'd been scammed. So with some explanation, about ten more members were added."
msgstr "　そもそも騙されていた事すら分かっていなかった人もおり、きちんと説明すれば二十人はたやすく超えるとの事だった。"

#. Occurrence 8DOT5:12453:12600: scene=8DOT5
#: 8DOT5:12453
msgctxt "text_id=12600 | speaker=unknown"
msgid "  It helped that it was polite, young, well-dressed students who were giving them this information."
msgstr "　礼儀正しい学生服の好漢が説得にあたっているのも大きい。"

#. Occurrence 8DOT5:12458:12601: scene=8DOT5
#: 8DOT5:12458
msgctxt "text_id=12601 | speaker=unknown"
msgid "  The elderly generally seemed more accepting of anyone who was around the age of their grandchildren."
msgstr "　おじいさんおばあさんは基本、孫に対して<寛大|かんだい>なものである。"

#. Occurrence 8DOT5:12493:12602: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0145; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12493
msgctxt "text_id=12602 | speaker=aoko"
msgid "\"We've done a good job getting this far. We got our goal of twenty people in no time.\""
msgstr "「にしてもよくここまで調べたもんだわ。規定の二十人なんてあっという間だったわね」"

#. Occurrence 8DOT5:12526:12603: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8DOT5_0002; voice_prefix=B10; voice_category=5; scene=8DOT5
#: 8DOT5:12526
msgctxt "text_id=12603 | speaker=kojika"
msgid "\"You laid out all the conditions clearly, which made it easy for us."
msgstr "「アンタの言う条件が分かりやすかったから。"

#. Occurrence 8DOT5:12532:12604: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8DOT5_0003; voice_prefix=B10; voice_category=5; scene=8DOT5
#: 8DOT5:12532
msgctxt "text_id=12604 | speaker=kojika"
msgid "  We looked for anyone over the age of sixty who lived alone and was not a member of their local neighborhood association. We just did exactly what the salespeople from the Light of Truth did."
msgstr "　六十歳過ぎのご老人で、ひとり暮らしで、町内会に入っていない人を探せば良かったんだし。やってる事はほんものの光の販売員と一緒。"

#. Occurrence 8DOT5:12543:12605: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8DOT5_0004; voice_prefix=B10; voice_category=5; scene=8DOT5
#: 8DOT5:12543
msgctxt "text_id=12605 | speaker=kojika"
msgid "  Our work is just getting started though."
msgstr "　でも、こんなんでなんとかなる話じゃないと思うけど。"

#. Occurrence 8DOT5:12550:12606: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8DOT5_0005_0; voice_prefix=B10; voice_category=5; scene=8DOT5
#: 8DOT5:12550
msgctxt "text_id=12606 | speaker=kojika"
msgid "  It's still going to be all we can do to make a complaint against their..."
msgstr "　結局のところ、抗議するのが関の山じゃ―――"

#. Occurrence 8DOT5:12562:12607: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8DOT5_0005_1; voice_prefix=B10; voice_category=5; scene=8DOT5
#: 8DOT5:12562
msgctxt "text_id=12607 | speaker=kojika"
msgid "Aozaki?"
msgstr "蒼崎？"

#. Occurrence 8DOT5:12562:12608: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8DOT5_0005_1; voice_prefix=B10; voice_category=5; scene=8DOT5
#: 8DOT5:12562
msgctxt "text_id=12608 | speaker=kojika"
msgid "  What's with the weird smile all of a sudden?\""
msgstr "　ちょっと、なに薄気味悪い顔で笑ってるのよ」"

#. Occurrence 8DOT5:12582:12609: scene=8DOT5
#: 8DOT5:12582
msgctxt "text_id=12609 | speaker=unknown"
msgid "  Aoko looked up after being called out by her friend."
msgstr "　友人に指摘され、青子は俯いていた顔をあげる。"

#. Occurrence 8DOT5:12600:12610: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0146; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12600
msgctxt "text_id=12610 | speaker=aoko"
msgid "\"Oh, I just found something very interesting is all."
msgstr "「いやあ、面白いもん見付けちゃって。"

#. Occurrence 8DOT5:12606:12611: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0147; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12606
msgctxt "text_id=12611 | speaker=aoko"
msgid "  We may be fighting an uphill battle, but this might change the tides in our favor. Look here at this tag.\""
msgstr "　成果の乏しい戦いになると思ってたけど、風向きが変わったわ。ほら、見てクマ。この羽毛布団のマーク」"

#. Occurrence 8DOT5:12612:12612: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8DOT5_0006; voice_prefix=B10; voice_category=5; scene=8DOT5
#: 8DOT5:12612
msgctxt "text_id=12612 | speaker=kojika"
msgid "\"Hm?\""
msgstr "「？」"

#. Occurrence 8DOT5:12643:12613: scene=8DOT5
#: 8DOT5:12643
msgctxt "text_id=12613 | speaker=unknown"
msgid "  Aoko showed her the product label sewn into the down quilt."
msgstr "　青子は羽毛布団に縫いつけられた商品タグを久万梨に見せつけた。"

#. Occurrence 8DOT5:12648:12614: scene=8DOT5
#: 8DOT5:12648
msgctxt "text_id=12614 | speaker=unknown"
msgid "  There on the tag was what looked like the Japanese Industrial Standards logo."
msgstr "　タグにはお馴染みのＪＩＳのマーク。"

#. Occurrence 8DOT5:12653:12615: scene=8DOT5
#: 8DOT5:12653
msgctxt "text_id=12615 | speaker=unknown"
msgid "  The Japanese Industrial Standards helped maintain the quality of industrial products in Japan. Products with this mark were required to be produced in accordance with the Industrial Standardization Law."
msgstr "　工業製品の品質を表すもので、ＪＩＳのマークがある商品は国が定めた工業標準化法に基づいている、のだが……"

#. Occurrence 8DOT5:12674:12616: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8DOT5_0007; voice_prefix=B10; voice_category=5; scene=8DOT5
#: 8DOT5:12674
msgctxt "text_id=12616 | speaker=kojika"
msgid "\"Huh? Jay... El... Ess?\""
msgstr "「あれ？　じぇい……える……えす？」"

#. Occurrence 8DOT5:12693:12617: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0148; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12693
msgctxt "text_id=12617 | speaker=aoko"
msgid "\"Yep. This actually makes the contracts work in our favor. I thought we were dealing with professionals, but it turns out they're actually a group of amateurs."
msgstr "「そ。こうなると契約書が逆に武器になる。百戦錬磨かと思ったけど、実際は兎しか相手にしない素人ってコト。"

#. Occurrence 8DOT5:12699:12618: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0149; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12699
msgctxt "text_id=12618 | speaker=aoko"
msgid "  If we do this right, we could get all the money back to the victims. It's going to feel so good to put these scammers in their place!\""
msgstr "　……ええ、うまく話をもっていけば全額返済も夢じゃないわ。勝利の勝ちどきは、さぞ気持ちのいいものになるでしょうねぇ」"

#. Occurrence 8DOT5:12723:12619: scene=8DOT5
#: 8DOT5:12723
msgctxt "text_id=12619 | speaker=unknown"
msgid "  Aoko took a seat, still grinning from ear to ear."
msgstr "　にやりと笑って青子は席を立った。"

#. Occurrence 8DOT5:12745:12620: scene=8DOT5
#: 8DOT5:12745
msgctxt "text_id=12620 | speaker=unknown"
msgid "  She didn't ring Tobimaru's pager. Instead, she dialed a different number on the red phone while humming to herself."
msgstr "　鳶丸へのポケベルは鳴らさず、赤電話を鼻歌まじりにダイヤルする。"

#. Occurrence 8DOT5:12750:12621: scene=8DOT5
#: 8DOT5:12750
msgctxt "text_id=12621 | speaker=unknown"
msgid "  Aoko heard the familiar ringing tone through the receiver."
msgstr "　受話器からはお馴染みのコールの音がリピート中。"

#. Occurrence 8DOT5:12785:12622: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8DOT5_0008; voice_prefix=B10; voice_category=5; scene=8DOT5
#: 8DOT5:12785
msgctxt "text_id=12622 | speaker=kojika"
msgid "\"Aozaki? I thought you were calling Tsukiji? You need to tell him about our change of plans.\""
msgstr "「蒼崎？　槻司に連絡入れるんじゃないの？　作戦が変わったって」"

#. Occurrence 8DOT5:12791:12623: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0150; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12791
msgctxt "text_id=12623 | speaker=aoko"
msgid "\"I will after this. Right now I have to figure out who to put in charge of the negotiations. I don't think Tobimaru or myself could do such an important role justice."
msgstr "「それは後。いま大事なのは交渉役を誰にするかよ。私や鳶丸じゃさすがに貫禄不足だしね。"

#. Occurrence 8DOT5:12797:12624: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0151; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12797
msgctxt "text_id=12624 | speaker=aoko"
msgid "  Even if we have the advantage for now, we're still in an evenly matched battle."
msgstr "　こっちが有利になったとしても、まだ状況は五分だし。"

#. Occurrence 8DOT5:12803:12625: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0152; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12803
msgctxt "text_id=12625 | speaker=aoko"
msgid "  They could completely turn the tables on us in the discussions, so we need someone ruthless to represent us.\""
msgstr "　会話次第じゃひっくり返されるだろうから、被害者の会の代表は、それはもう、性根のひん曲がった悪魔でないと」"

#. Occurrence 8DOT5:12829:12626: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8DOT5_0009; voice_prefix=B10; voice_category=5; scene=8DOT5
#: 8DOT5:12829
msgctxt "text_id=12626 | speaker=kojika"
msgid "\"I thought that was going to be you.\""
msgstr "「それアンタの事だと思うんだけど。違うの？」"

#. Occurrence 8DOT5:12835:12627: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0153; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12835
msgctxt "text_id=12627 | speaker=aoko"
msgid "\"No, no, no. For this we need an adult with some kind of social standing."
msgstr "「いえいえ、こういうのは社会的立場のある大人じゃないと務まりません。"

#. Occurrence 8DOT5:12841:12628: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0154; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12841
msgctxt "text_id=12628 | speaker=aoko"
msgid "  Don't worry. I actually know the perfect person for the job.\""
msgstr "　安心して久万梨、ぴったりのヤツを知ってるから」"

#. Occurrence 8DOT5:12875:12629: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0155; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12875
msgctxt "text_id=12629 | speaker=aoko"
msgid "\"Let's just say you need a scammer to fight a scammer."
msgstr "「ま、詐欺師には詐欺師ってね。"

#. Occurrence 8DOT5:12881:12630: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0156; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12881
msgctxt "text_id=12630 | speaker=aoko"
msgid "  I know someone whose sole job is to win arguments against people in town. I doubt she has anything going on today, so I thought we might put her to work."
msgstr "　この町には人を言い負かすのだけが仕事のヤツっていちゃったりするのよ。今日もやることなくて暇してるだろうし、たまには働いてもらわないと。"

#. Occurrence 8DOT5:12887:12631: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0157; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:12887
msgctxt "text_id=12631 | speaker=aoko"
msgid "  Anyone who goes up against her is guaranteed to have a mental breakdown in an hour, no matter what kind of scam they're running.\""
msgstr "　彼女にかかっちゃサラ金だろうが教祖だろうが一時間で精神崩壊、<裸足|はだし>で山に逃げこむわ」"

#. Occurrence 8DOT5:12907:12632: scene=8DOT5
#: 8DOT5:12907
msgctxt "text_id=12632 | speaker=unknown"
msgid "  Aoko kept the phone receiver at her ear as she delivered these cutting remarks."
msgstr "　これ以上ない嫌味を言いながら、青子は受話器に耳を当てる。"

#. Occurrence 8DOT5:12912:12633: scene=8DOT5
#: 8DOT5:12912
msgctxt "text_id=12633 | speaker=unknown"
msgid "  The ringing tone had long since gone silent."
msgstr "　ちなみに、受話器から漏れていたコール音はとっくに消えていた。"

#. Occurrence 8DOT5:12945:12634: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_8DOT5_0000; voice_prefix=B20; voice_category=10; scene=8DOT5
#: 8DOT5:12945
msgctxt "text_id=12634 | speaker=yuika"
msgid "\"...Hello? I don't want to assume anything, but were you talking about me this whole time Aoko?\""
msgstr "『―――もしもし。まさかとは思いますが、今の話は私の事でしょうか、青子さん？』"

#. Occurrence 8DOT5:12951:12635: scene=8DOT5
#: 8DOT5:12951
msgctxt "text_id=12635 | speaker=unknown"
msgid "  An eloquent woman's voice could be heard from the phone's earpiece."
msgstr "　受話器から<流暢|りゅうちょう>な女性の声が響く。"

#. Occurrence 8DOT5:12956:12636: scene=8DOT5
#: 8DOT5:12956
msgctxt "text_id=12636 | speaker=unknown"
msgid "  Aoko innocently said her greetings and smiled like a hunter who had just gotten their prey to take the bait."
msgstr "　青子は白々しく挨拶しながら、獲物が挑発にのってくれたとほくそ笑んだ。"

#. Occurrence 8DOT5:13017:12637: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_8DOT5_0001; voice_prefix=B20; voice_category=10; scene=8DOT5
#: 8DOT5:13017
msgctxt "text_id=12637 | speaker=yuika"
msgid "\"You know, I've always thought this about you..."
msgstr "「つねづね思っていましたが。"

#. Occurrence 8DOT5:13023:12638: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_8DOT5_0002; voice_prefix=B20; voice_category=10; scene=8DOT5
#: 8DOT5:13023
msgctxt "text_id=12638 | speaker=yuika"
msgid "  But you really don't have enough respect for your elders, Aoko.\""
msgstr "　貴女には年長者への敬意が足りていないようですね、青子さん」"

#. Occurrence 8DOT5:13047:12639: voice_id=X70_8DOT5_0000; voice_prefix=X70; voice_category=0; scene=8DOT5
#: 8DOT5:13047
msgctxt "text_id=12639 | speaker=unknown"
msgid "\"Huh?\""
msgstr "「「へ？」」"

#. Occurrence 8DOT5:13067:12640: scene=8DOT5
#: 8DOT5:13067
msgctxt "text_id=12640 | speaker=unknown"
msgid "  Tobimaru and Kinomi had returned from their tasks and stood there wide-eyed."
msgstr "　役割を終えて集結していた鳶丸たちが目を見張る。"

#. Occurrence 8DOT5:13072:12641: scene=8DOT5
#: 8DOT5:13072
msgctxt "text_id=12641 | speaker=unknown"
msgid "  The person Aoko had invited to the cafe looked so out of place that it was a shock to everyone."
msgstr "　青子の呼び出しでやってきた人物は、この場にはあまりにも不釣り合いで、予想外だったからだ。"

#. Occurrence 8DOT5:13113:12642: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0158; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:13113
msgctxt "text_id=12642 | speaker=aoko"
msgid "\"Thank you so much for coming, Yuika."
msgstr "「はあい、<唯架|ゆいか>さん。わざわざ来てもらって助かるわ。"

#. Occurrence 8DOT5:13119:12643: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0159; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:13119
msgctxt "text_id=12643 | speaker=aoko"
msgid "  I pretty much told you all the details over the phone, but is there anything else you want me to go over?\""
msgstr "　事情は電話で説明したけど、もう少し詳しく説明する？」"

#. Occurrence 8DOT5:13130:12644: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_8DOT5_0003; voice_prefix=B20; voice_category=10; scene=8DOT5
#: 8DOT5:13130
msgctxt "text_id=12644 | speaker=yuika"
msgid "\"That's okay. I received a full report about the Light of Truth from Ritsuka. I do not require any lectures from you on that matter.\""
msgstr "「結構です。ほんものの光の事は、先ほど<律架|りつか>から報告を受けましたから。貴女に教授していただく事柄は一つもありません」"

#. Occurrence 8DOT5:13156:12645: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0160; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:13156
msgctxt "text_id=12645 | speaker=aoko"
msgid "\"Well aren't we in a mood? That's perfect, though. Take that attitude to them. When you're in the zone, your glare alone is enough to make someone faint!\""
msgstr "「ありゃまご機嫌ななめ。良かった、そのテンションのままカチコミお願いね。一般人のひとりやふたり、唯架さんが本性をだせば睨むだけで<卒倒|そっとう>させられるでしょ？」"

#. Occurrence 8DOT5:13174:12646: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0044; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:13174
msgctxt "text_id=12646 | speaker=kinomi"
msgid "\"Whoa, seriously?! Isn't this lady a nun at Aida Church? I actually really look up to her!"
msgstr "「うえ、そうなの!?　このお姉さん、合田教会のシスターさんだよね!?　オレ、ひそかに<憧|あこが>れてたんですけど！"

#. Occurrence 8DOT5:13180:12647: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0045; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:13180
msgctxt "text_id=12647 | speaker=kinomi"
msgid "  Oh, crap, now is not the time. Umm, hi, my name's Housuke Kinomi! Aozaki and I aren't really friends!\""
msgstr "　あ、いや、そんな場合じゃねえ、どうも木乃美芳助ッス！　蒼崎サンとはあんまり仲良くありません！」"

#. Occurrence 8DOT5:13200:12648: scene=8DOT5
#: 8DOT5:13200
msgctxt "text_id=12648 | speaker=unknown"
msgid "  Kinomi was clearly trying to earn points by showing that he also was not that friendly with Aoko."
msgstr "　咄嗟に青子とシスターの仲が悪いと察し、さりげなくポイントアップを図る木乃美。"

#. Occurrence 8DOT5:13213:12649: scene=8DOT5
#: 8DOT5:13213
msgctxt "text_id=12649 | speaker=unknown"
msgid "  Sister Yuika gave him an angelic smile back."
msgstr "　そんなやんちゃな青少年に、シスターは天使のような微笑みを投げるのだった。"

#. Occurrence 8DOT5:13234:12650: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_8DOT5_0004; voice_prefix=B20; voice_category=10; scene=8DOT5
#: 8DOT5:13234
msgctxt "text_id=12650 | speaker=yuika"
msgid "\"Well, hello there. I am indeed a sister at Aida Church. My name is Yuika Suse. It's a pleasure to meet you, Mr. Housuke.\""
msgstr "「これはご丁寧に。合田教会で僧職を勤める、<周|す><瀬|せ><唯架|ゆいか>です。はじめまして、芳助さん」"

#. Occurrence 8DOT5:13246:12651: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0046; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:13246
msgctxt "text_id=12651 | speaker=kinomi"
msgid "\"Ahhhhh! This is crazy! She's really a nun!"
msgstr "「ひゃー！　すげえ、ホントにシスターだよシスター！"

#. Occurrence 8DOT5:13246:12652: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0046; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:13246
msgctxt "text_id=12652 | speaker=kinomi"
msgid "  I can't believe you had something this amazing up your sleeve the whole time, Aoko!"
msgstr "　会長とんでもない隠し球つれてきたな！"

#. Occurrence 8DOT5:13258:12653: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0047; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:13258
msgctxt "text_id=12653 | speaker=kinomi"
msgid "  ...Wait, but what are you going to have her do? I mean, I'm fine with just having her around in general.\""
msgstr "　……あれ？　でも、唯架さんに何してもらうの？　いや、オレはいてくれるだけで嬉しいけど」"

#. Occurrence 8DOT5:13296:12654: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0097; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:13296
msgctxt "text_id=12654 | speaker=tobimaru"
msgid "\"I think we can all imagine..."
msgstr "「……まあ、だいたい想像できるが。"

#. Occurrence 8DOT5:13307:12655: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0098; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:13307
msgctxt "text_id=12655 | speaker=tobimaru"
msgid "  It's a pleasure to meet you, Sister Yuika. My name is Tobimaru Tsukiji, student council vice-president.\""
msgstr "　はじめまして、シスター唯架。三咲高校生徒会副会長、槻司鳶丸です」"

#. Occurrence 8DOT5:13336:12656: scene=8DOT5
#: 8DOT5:13336
msgctxt "text_id=12656 | speaker=unknown"
msgid "  Tobimaru didn't look so well. Perhaps he had figured out where this course of events was headed."
msgstr "　一方、事の成り行きが読めたのか、鳶丸は元気がない。"

#. Occurrence 8DOT5:13341:12657: scene=8DOT5
#: 8DOT5:13341
msgctxt "text_id=12657 | speaker=unknown"
msgid "  The JLS label was indeed illegal."
msgstr "　ＪＬＳマークが違法であること。"

#. Occurrence 8DOT5:13346:12658: scene=8DOT5
#: 8DOT5:13346
msgctxt "text_id=12658 | speaker=unknown"
msgid "  This discovery made Aoko realize how they could get the victims' money back and run the Light of Truth out of town completely."
msgstr "　羽毛布団が<偽物|バッタ>ものである事が判った時点で、青子は被害者たちの支払金の全額回収と、ほんものの光を町から追い出す算段を立てた。"

#. Occurrence 8DOT5:13351:12659: scene=8DOT5
#: 8DOT5:13351
msgctxt "text_id=12659 | speaker=unknown"
msgid "  Sister Yuika was her solution."
msgstr "　その結論が、目の前のシスターだと察したからだ。"

#. Occurrence 8DOT5:13384:12660: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0099; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:13384
msgctxt "text_id=12660 | speaker=tobimaru"
msgid "\"...I thought the plan was to let the evidence do the talking, and if they don't want to be sued, get them to settle out of court. They'd pay back the money and get out of town."
msgstr "「……てっきり証拠にものをいわせて、訴えられたくなければ示談ですませろ、全額返して出て行けー、って話かと思ったが。"

#. Occurrence 8DOT5:13391:12661: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0100; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:13391
msgctxt "text_id=12661 | speaker=tobimaru"
msgid "But this is something else. She doesn't want to just kick them out of town. She wants to fleece them for all they've got!\""
msgstr "……恐ろしい女だぜ。追い出すだけじゃなく、<素寒貧|すかんぴん>にして放りだそうってハラか」"

#. Occurrence 8DOT5:13409:12662: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0048; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:13409
msgctxt "text_id=12662 | speaker=kinomi"
msgid "\"Huh? How can she even do that? I mean, I know she's beautiful, but does a nun really have that kind of power?\""
msgstr "「は？　なんでそうなるの？　なに、美人なだけじゃなく、シスターさんってそんな権利持ってるの？」"

#. Occurrence 8DOT5:13442:12663: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0161; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:13442
msgctxt "text_id=12663 | speaker=aoko"
msgid "\"It's not because she's a nun. That's just the kind of pull Yuika has around here. Anyway, here's the signatures of everyone in the advocacy group. The cheer team is also helping. Do you want to take some of them?\""
msgstr "「シスターさんが、じゃなくて唯架さんの人間力と言うべきね。はい、これ被害者の会からの連名書。一応、うちの応援団の先輩たちも待機してるけど、何人か連れていく？」"

#. Occurrence 8DOT5:13485:12664: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_8DOT5_0005; voice_prefix=B20; voice_category=10; scene=8DOT5
#: 8DOT5:13485
msgctxt "text_id=12664 | speaker=yuika"
msgid "\"...Hmm. If things get too heated, it's going to be a pain to resolve later. Let's just bring five to keep the peace."
msgstr "「……そうですね。<逆上|ぎゃくじょう>して手を上げられては後片づけが面倒ですので、抑止力として五人ほど。"

#. Occurrence 8DOT5:13491:12665: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_8DOT5_0006; voice_prefix=B20; voice_category=10; scene=8DOT5
#: 8DOT5:13491
msgctxt "text_id=12665 | speaker=yuika"
msgid "  You are also welcome to accompany me if you'd like, Aoko.\""
msgstr "　あとは青子さんが同行してくれるのでしたら、私としては不満はありません」"

#. Occurrence 8DOT5:13538:12666: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0049; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:13538
msgctxt "text_id=12666 | speaker=kinomi"
msgid "\"Huh? Wait, is Yuika going to go talk to them? I thought you were going to do that, prez.\""
msgstr "「え？　どゆこと？　もしかしてシスターさんが話つけにいくの？　会長のがよくね？」"

#. Occurrence 8DOT5:13549:12667: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0162; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:13549
msgctxt "text_id=12667 | speaker=aoko"
msgid "\"No, no, it's fine. She may not look it, but she's actually a specialist in these kinds of situations. Isn't that right, Yuika?\""
msgstr "「いいのいいの。唯架さんはこう見えて荒事の専門家なんだから。ねー、唯架さん？」"

#. Occurrence 8DOT5:13598:12668: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_8DOT5_0007; voice_prefix=B20; voice_category=10; scene=8DOT5
#: 8DOT5:13598
msgctxt "text_id=12668 | speaker=yuika"
msgid "\"Not as much as you, but yes, you could say that."
msgstr "「貴女ほどではありませんが。"

#. Occurrence 8DOT5:13604:12669: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_8DOT5_0008; voice_prefix=B20; voice_category=10; scene=8DOT5
#: 8DOT5:13604
msgctxt "text_id=12669 | speaker=yuika"
msgid "  Since that office is indeed operating an illegal business, I'm willing to help. We both will benefit, after all."
msgstr "　……いいでしょう、今回は利益が一致します。あの事務所の方々が違法を働いているのは事実ですから。"

#. Occurrence 8DOT5:13610:12670: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_8DOT5_0009; voice_prefix=B20; voice_category=10; scene=8DOT5
#: 8DOT5:13610
msgctxt "text_id=12670 | speaker=yuika"
msgid "  Sins must not go unpunished. They must feel the pain that they inflicted upon the good people of this town.\""
msgstr "　罪には罰を。善良な人々を、とくに私たちの同胞を苦しめた手合いには、相応の痛みが必要です」"

#. Occurrence 8DOT5:13649:12671: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0163; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:13649
msgctxt "text_id=12671 | speaker=aoko"
msgid "\"You certainly live up to your reputation, Sister."
msgstr "「さっすが泣く子も黙る鬼のシスター。"

#. Occurrence 8DOT5:13655:12672: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0164; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:13655
msgctxt "text_id=12672 | speaker=aoko"
msgid "  I'm sure you'll win. You've been crushing the competition for a long time, now.\""
msgstr "　期待してるわ。昔っから、商売<敵|がたき>を潰すのは得意だものね、貴女たち」"

#. Occurrence 8DOT5:13673:12673: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_8DOT5_0010; voice_prefix=B20; voice_category=10; scene=8DOT5
#: 8DOT5:13673
msgctxt "text_id=12673 | speaker=yuika"
msgid "\"Yes, well."
msgstr "「言われるまでもありません。"

#. Occurrence 8DOT5:13679:12674: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_8DOT5_0011; voice_prefix=B20; voice_category=10; scene=8DOT5
#: 8DOT5:13679
msgctxt "text_id=12674 | speaker=yuika"
msgid "  There's simply no need for two schools of thought in a single place.\""
msgstr "　一つの土地に、二つの教えがあっては迷惑です」"

#. Occurrence 8DOT5:13748:12675: scene=8DOT5
#: 8DOT5:13748
msgctxt "text_id=12675 | speaker=unknown"
msgid "  Though the two continued to antagonize each other, they entered the office building fighting for the same team."
msgstr "　ふたりは反目の火花を散らしながらも、肩を並べてオフィスビルへと入っていった。"

#. Occurrence 8DOT5:13753:12676: scene=8DOT5
#: 8DOT5:13753
msgctxt "text_id=12676 | speaker=unknown"
msgid "  The five burly members of the cheer team filed in behind them."
msgstr "　五人のむくつけき応援団員ものっしのっしと後に続く。"

#. Occurrence 8DOT5:13758:12677: scene=8DOT5
#: 8DOT5:13758
msgctxt "text_id=12677 | speaker=unknown"
msgid "  They had left behind a glum Tobimaru and a completely clueless Kinomi."
msgstr "　残されたのは肩をすくめる鳶丸と、事情をいっさい把握できない木乃美だけ。"

#. Occurrence 8DOT5:13797:12678: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0050; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:13797
msgctxt "text_id=12678 | speaker=kinomi"
msgid "\"...I really don't know what's going on."
msgstr "「……わっかんねー。"

#. Occurrence 8DOT5:13797:12679: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0050; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:13797
msgctxt "text_id=12679 | speaker=kinomi"
msgid "  What is Aozaki trying to get that poor woman to do for her?\""
msgstr "　蒼崎、あの美人さんに何やらせる気なんだよ？」"

#. Occurrence 8DOT5:13821:12680: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0101; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:13821
msgctxt "text_id=12680 | speaker=tobimaru"
msgid "\"Oh, you do not even want to know what kind of cruelty Aozaki is capable of inflicting upon her enemies."
msgstr "「そりゃおまえ、口にはできない残虐行為だろ。相手の弱みをにぎったらとことん叩きのめすのが蒼崎だからな。"

#. Occurrence 8DOT5:13827:12681: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0102; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:13827
msgctxt "text_id=12681 | speaker=tobimaru"
msgid "  Once they get the company to terminate everyone's contracts based on the illegal sales, the two will take legal action against them. That's where Sister Yuika comes in."
msgstr "　違法販売をネタにして、契約解除をさせた後に告訴するって流れ。訴えるのはシスターの役目だな。"

#. Occurrence 8DOT5:13834:12682: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0103; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:13834
msgctxt "text_id=12682 | speaker=tobimaru"
msgid "She's far more qualified than Aozaki, who's just a student."
msgstr "立場上、学生である蒼崎よりシスターのほうがお題目が立つ。"

#. Occurrence 8DOT5:13845:12683: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0104; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:13845
msgctxt "text_id=12683 | speaker=tobimaru"
msgid "  I've heard some less than savory rumors about that church, too. This company will be lucky if losing all their funds is the worst that happens.\""
msgstr "　……なによりあの教会、たまにイヤな噂を聞くしなあ。連中、貯めた財産根こそぎ奪られるだけで済めばいいが」"

#. Occurrence 8DOT5:13870:12684: scene=8DOT5
#: 8DOT5:13870
msgctxt "text_id=12684 | speaker=unknown"
msgid "  After taking a few deep breaths, Tobimaru also headed towards the office building."
msgstr "　さて、と一息ついてから、鳶丸もオフィスビルへと足を向けた。"

#. Occurrence 8DOT5:13881:12685: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0051; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:13881
msgctxt "text_id=12685 | speaker=kinomi"
msgid "\"You're going in there too? Isn't it a little scary?\""
msgstr "「え、殿下も事務所に行くの？　怖くない？」"

#. Occurrence 8DOT5:13899:12686: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0105; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:13899
msgctxt "text_id=12686 | speaker=tobimaru"
msgid "\"I'm not going. Are you crazy? I just have some business to attend to."
msgstr "「いかねえよ、おっかねえ。俺のはちょっとした野暮用だ。"

#. Occurrence 8DOT5:13905:12687: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0106; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:13905
msgctxt "text_id=12687 | speaker=tobimaru"
msgid "  You need to get back to school. I'll compensate you for all this later, don't worry.\""
msgstr "　テメエも補習に戻れよ。今日の礼は、また改めてくれてやるから」"

#. Occurrence 8DOT5:13938:12688: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0052; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:13938
msgctxt "text_id=12688 | speaker=kinomi"
msgid "\"Man, you know school's done by now, right? It's almost night. Hey, it was fun though!\""
msgstr "「ばっか、補習なんてもう終わってるじゃんか。気が付けばもうすぐ夕方だぜ、夕方。楽しかったからいいけどな！」"

#. Occurrence 8DOT5:13956:12689: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0107; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:13956
msgctxt "text_id=12689 | speaker=tobimaru"
msgid "\"Wow, you're right. Half the day's gone.\""
msgstr "「違いない。あっというまの半日だった」"

#. Occurrence 8DOT5:13966:12690: scene=8DOT5
#: 8DOT5:13966
msgctxt "text_id=12690 | speaker=unknown"
msgid "  Tobimaru waved goodbye and disappeared into the office building."
msgstr "　それじゃあ、と手を振って、鳶丸はオフィスビルの入り口に消えていった。"

#. Occurrence 8DOT5:13997:12691: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8DOT5_0053; voice_prefix=B50; voice_category=6; scene=8DOT5
#: 8DOT5:13997
msgctxt "text_id=12691 | speaker=kinomi"
msgid "\"Wait, what?\""
msgstr "「？」"

#. Occurrence 8DOT5:14002:12692: scene=8DOT5
#: 8DOT5:14002
msgctxt "text_id=12692 | speaker=unknown"
msgid "  Kinomi thought it was strange since Tobimaru had just said he wasn't going in there."
msgstr "　それを疑問に思いながらも、"

#. Occurrence 8DOT5:14014:12693: scene=8DOT5
#: 8DOT5:14014
msgctxt "text_id=12693 | speaker=unknown"
msgid "  However, he left as well after hearing a noise that sounded like glass breaking on the third floor of the office building."
msgstr "　オフィスビルの三階から響いた、どうみても窓ガラスの割れる音を聴いて、木乃美も現場を後にした。"

#. Occurrence 8DOT5:14023:12694: scene=8DOT5
#: 8DOT5:14023
msgctxt "text_id=12694 | speaker=unknown"
msgid "  A wise man never courts danger, as they say."
msgstr "　君子危うきに近寄らず、である。"

#. Occurrence 8DOT5:14064:12695: scene=8DOT5
#: 8DOT5:14064
msgctxt "text_id=12695 | speaker=unknown"
msgid "  The discussion ended without any major issues."
msgstr "　何事もなく話し合いは終了した。"

#. Occurrence 8DOT5:14069:12696: scene=8DOT5
#: 8DOT5:14069
msgctxt "text_id=12696 | speaker=unknown"
msgid "  The inside of the office was mostly untouched. Only the center line of desks had been pulverized by Sister Yuika. Things had been resolved peacefully without any bloodshed."
msgstr "　事務所の内部はモーゼの十戒よろしく、シスターの一蹴りによって真ん中の机の列がきれいさっぱり吹っ飛んでいるだけで、ひとりの流血もない、実に平和的な解決だった。"

#. Occurrence 8DOT5:14075:12697: scene=8DOT5
#: 8DOT5:14075
msgctxt "text_id=12697 | speaker=unknown"
msgid "  The office had been conquered in about an hour, and Aoko was now surveying it."
msgstr "　そんなわけで、およそ半刻ほどで事務所の制圧を終えた蒼崎青子は、きょろきょろとあたりを見渡している。"

#. Occurrence 8DOT5:14095:12698: scene=8DOT5
#: 8DOT5:14095
msgctxt "text_id=12698 | speaker=unknown"
msgid "  A large desk had gone right through the window, flung through the air with a single swing of Sister Yuika's hand."
msgstr "　シスターの、鶴を思わせる手の一振りで宙に舞ったまま窓ガラスにつきささった大型デスク。"

#. Occurrence 8DOT5:14100:12699: scene=8DOT5
#: 8DOT5:14100
msgctxt "text_id=12699 | speaker=unknown"
msgid "  The sales staff were shaking in the corner like they'd just seen the devil incarnate."
msgstr "　悪魔でも見たかのように部屋の隅でガクガクと震える販売員たち。"

#. Occurrence 8DOT5:14105:12700: scene=8DOT5
#: 8DOT5:14105
msgctxt "text_id=12700 | speaker=unknown"
msgid "  Sister Yuika brought in the five members of the cheer team to seize the office's permits and other important documents."
msgstr "　五人の応援団員をひきつれ、事務所の利権証明書等を押さえていくシスター。"

#. Occurrence 8DOT5:14130:12701: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0165; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:14130
msgctxt "text_id=12701 | speaker=aoko"
msgid "\"Huh?\""
msgstr "「あれ？」"

#. Occurrence 8DOT5:14136:12702: scene=8DOT5
#: 8DOT5:14136
msgctxt "text_id=12702 | speaker=unknown"
msgid "  Unfortunately, the one thing Aoko was looking for was nowhere to be found."
msgstr "　しかし、青子の探しものは影も形も見あたらない。"

#. Occurrence 8DOT5:14141:12703: scene=8DOT5
#: 8DOT5:14141
msgctxt "text_id=12703 | speaker=unknown"
msgid "  She went to ask the sales staff still quivering in the corner of the room."
msgstr "　首をかしげながら、部屋の隅の販売員に声をかける。"

#. Occurrence 8DOT5:14168:12704: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0166; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:14168
msgctxt "text_id=12704 | speaker=aoko"
msgid "\"About three hours ago, did you see a harmless looking teenage boy come in here? I know he hasn't left the building, so he must still be in here somewhere.\""
msgstr "「ちょっと。三時間ぐらい前、ここに人畜無害そうなのこなかった？　ビルから出てきてないから、まだ中にいると思うんだけど」"

#. Occurrence 8DOT5:14174:12705: scene=8DOT5
#: 8DOT5:14174
msgctxt "text_id=12705 | speaker=unknown"
msgid "  Everyone shook their heads no."
msgstr "　販売員たちはブンブンと首をふる。"

#. Occurrence 8DOT5:14179:12706: scene=8DOT5
#: 8DOT5:14179
msgctxt "text_id=12706 | speaker=unknown"
msgid "  Nobody had seen a student who fit that description in the office."
msgstr "　事務所には純朴そうな学生の姿など何処にもない。"

#. Occurrence 8DOT5:14205:12707: scene=8DOT5
#: 8DOT5:14205
msgctxt "text_id=12707 | speaker=unknown"
msgid "  Aoko was looking even more confused at this point."
msgstr "　どういう事？　とさらに首をかしげるも、"

#. Occurrence 8DOT5:14218:12708: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0167; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:14218
msgctxt "text_id=12708 | speaker=aoko"
msgid "\"Ah, well...\""
msgstr "「でもまあ」"

#. Occurrence 8DOT5:14224:12709: scene=8DOT5
#: 8DOT5:14224
msgctxt "text_id=12709 | speaker=unknown"
msgid "  She was still happy that she'd done a good deed here today."
msgstr "　イイコトしたからいっか、と満足する生徒会長なのだった。"

#. Occurrence 8DOT5:14260:12710: scene=8DOT5
#: 8DOT5:14260
msgctxt "text_id=12710 | speaker=unknown"
msgid "  Tobimaru entered the office building and headed straight down the hallway."
msgstr "　鳶丸はオフィスビルに足を踏み入れると、そのまま通路を直進した。"

#. Occurrence 8DOT5:14265:12711: scene=8DOT5
#: 8DOT5:14265
msgctxt "text_id=12711 | speaker=unknown"
msgid "  He glanced at the stairs in front of him as he walked by, passing several tenants and heading towards the emergency exit at the back of the building."
msgstr "　入って正面にある上層への階段には視線を投げただけで、いくつかの<貸部屋|テナント>を通り過ぎ、ビルの裏手に出る非常口まで歩いていく。"

#. Occurrence 8DOT5:14285:12712: scene=8DOT5
#: 8DOT5:14285
msgctxt "text_id=12712 | speaker=unknown"
msgid "  Tobimaru knew the geography of 2nd Street well."
msgstr "　鳶丸はここ二丁目の地理に明るい。"

#. Occurrence 8DOT5:14290:12713: scene=8DOT5
#: 8DOT5:14290
msgctxt "text_id=12713 | speaker=unknown"
msgid "  If his memory served correctly, there were some old one-story houses behind this building that had been around forever."
msgstr "　彼の記憶によると、このビルの裏手には開発の手がかかっていない、昔ながらの平屋が並んでいる。"

#. Occurrence 8DOT5:14295:12714: scene=8DOT5
#: 8DOT5:14295
msgctxt "text_id=12714 | speaker=unknown"
msgid "  They were old tin-roofed rental houses that stood against the tides of time."
msgstr "　時代の波に取り残されたトタンの貸し屋。"

#. Occurrence 8DOT5:14300:12715: scene=8DOT5
#: 8DOT5:14300
msgctxt "text_id=12715 | speaker=unknown"
msgid "  Though overshadowed by the recent trend of two-story apartments, they were still there, alive and kicking."
msgstr "　近代的な二階建てアパートの影に飲まれてはいるが、まだ十分に<活|い>きている一角だ。"

#. Occurrence 8DOT5:14352:12716: scene=8DOT5
#: 8DOT5:14352
msgctxt "text_id=12716 | speaker=unknown"
msgid "  At the back of the office building there was a river for processing waste water."
msgstr "　裏口から出ると、正面には下水を処理するための川があった。"

#. Occurrence 8DOT5:14357:12717: scene=8DOT5
#: 8DOT5:14357
msgctxt "text_id=12717 | speaker=unknown"
msgid "  Beyond the river and a fence, there were many one-story houses."
msgstr "　川とフェンスの向こうには平屋住宅が並んでいる。"

#. Occurrence 8DOT5:14362:12718: scene=8DOT5
#: 8DOT5:14362
msgctxt "text_id=12718 | speaker=unknown"
msgid "  Next to the building there was a bridge that crossed over to the other side."
msgstr "　ビルのすぐ横には向こう岸に渡る橋がある。"

#. Occurrence 8DOT5:14367:12719: scene=8DOT5
#: 8DOT5:14367
msgctxt "text_id=12719 | speaker=unknown"
msgid "  It was a shortcut only neighborhood locals would know about."
msgstr "　この界隈の人間しか知り得ない、ちょっとした近道のようだ。"

#. Occurrence 8DOT5:14399:12720: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0108; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:14399
msgctxt "text_id=12720 | speaker=tobimaru"
msgid "\"...This is a pretty intense shortcut. Maps can't help you here, that's for sure.\""
msgstr "「……なるほど、大したショートカットだ。地図なんてアテになんねえな」"

#. Occurrence 8DOT5:14405:12721: scene=8DOT5
#: 8DOT5:14405
msgctxt "text_id=12721 | speaker=unknown"
msgid "  As Tobimaru walked towards the bridge, he saw a familiar face exit one of the old tin-roof houses."
msgstr "　鳶丸が橋に向かって足を進めると、平屋から見慣れた少年が出てくるところだった。"

#. Occurrence 8DOT5:14414:12722: scene=8DOT5
#: 8DOT5:14414
msgctxt "text_id=12722 | speaker=unknown"
msgid "  The young man was wearing a coat and was without a doubt Soujyuro Sizuki."
msgstr "　コートに着られている姿は、間違いなく静希草十郎である。"

#. Occurrence 8DOT5:14448:12723: voice_id=E60_8DOT5_0000; voice_prefix=E60; voice_category=0; scene=8DOT5
#: 8DOT5:14448
msgctxt "text_id=12723 | speaker=unknown"
msgid "\"See you tomorrow!\""
msgstr "「明日もまた来ておくれね」"

#. Occurrence 8DOT5:14454:12724: scene=8DOT5
#: 8DOT5:14454
msgctxt "text_id=12724 | speaker=unknown"
msgid "  Soujyuro crossed the bridge while the old woman who resided there saw him off."
msgstr "　平屋の主人であろう、年老いた老婆に見送られて、草十郎は橋を渡る。"

#. Occurrence 8DOT5:14489:12725: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0030; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14489
msgctxt "text_id=12725 | speaker=soujuurou"
msgid "\"Huh? Is that you, Tobimaru?\""
msgstr "「あれ、副会長？」"

#. Occurrence 8DOT5:14497:12726: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0109; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:14497
msgctxt "text_id=12726 | speaker=tobimaru"
msgid "\"Yo! Fancy meeting you here, slick.\""
msgstr "「よ。奇遇だな色男」"

#. Occurrence 8DOT5:14517:12727: scene=8DOT5
#: 8DOT5:14517
msgctxt "text_id=12727 | speaker=unknown"
msgid "  The two exchanged glances as they crossed paths on the bridge."
msgstr "　必然、二人は橋の上で顔を合わせた。"

#. Occurrence 8DOT5:14522:12728: scene=8DOT5
#: 8DOT5:14522
msgctxt "text_id=12728 | speaker=unknown"
msgid "  Soujyuro looked fairly spent."
msgstr "　草十郎の顔は心なしか元気がない。"

#. Occurrence 8DOT5:14527:12729: scene=8DOT5
#: 8DOT5:14527
msgctxt "text_id=12729 | speaker=unknown"
msgid "  That was all Tobimaru needed to see."
msgstr "　その様子を見て鳶丸は納得した。"

#. Occurrence 8DOT5:14532:12730: scene=8DOT5
#: 8DOT5:14532
msgctxt "text_id=12730 | speaker=unknown"
msgid "  Soujyuro's new job was a lot harder than working for any scam artists."
msgstr "　この男の新しいバイトとやらは、詐欺の片棒を担ぐより、何倍も気難しい話だったのだと。"

#. Occurrence 8DOT5:14582:12731: scene=8DOT5
#: 8DOT5:14582
msgctxt "text_id=12731 | speaker=unknown"
msgid "  They both stopped to talk on the footbridge."
msgstr "　なんとなしにふたりは帰り道を同じにし、歩道橋の上で立ち止まった。"

#. Occurrence 8DOT5:14597:12732: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0110; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:14597
msgctxt "text_id=12732 | speaker=tobimaru"
msgid "\"You have relatives around there or something?\""
msgstr "「あのあたりに親戚でもいんのか？」"

#. Occurrence 8DOT5:14603:12733: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0031; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14603
msgctxt "text_id=12733 | speaker=soujuurou"
msgid "\"Ah, no. I was just keeping the old woman who lives there company. Someone told me about it, and it sounded like something I could do.\""
msgstr "「いや、いない。人づてに紹介されて、おばあさんの話し相手をしていただけだ」"

#. Occurrence 8DOT5:14608:12734: scene=8DOT5
#: 8DOT5:14608
msgctxt "text_id=12734 | speaker=unknown"
msgid "  For some reason, Soujyuro readily revealed what he had refused to tell Aoko."
msgstr "　青子に問いつめられても話さなかった事を、草十郎はあっさり口にした。"

#. Occurrence 8DOT5:14629:12735: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0111; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:14629
msgctxt "text_id=12735 | speaker=tobimaru"
msgid "\"Is it okay to be talking about it? Sounds like something they might want to be kept secret.\""
msgstr "「そんなに気軽に話していいのか？　守秘義務とかありそうだが」"

#. Occurrence 8DOT5:14635:12736: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0032; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14635
msgctxt "text_id=12736 | speaker=soujuurou"
msgid "\"Oh, no it's fine. It's not really anything I need to keep quiet about."
msgstr "「いや、秘密にしなくちゃいけない話でもないんだ。"

#. Occurrence 8DOT5:14635:12737: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0032; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14635
msgctxt "text_id=12737 | speaker=soujuurou"
msgid "  I just thought maybe I shouldn't before."
msgstr "　ただ話しちゃいけない気がしただけで。"

#. Occurrence 8DOT5:14641:12738: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0033; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14641
msgctxt "text_id=12738 | speaker=soujuurou"
msgid "  You saw me coming out of there, and I actually have been wanting to tell someone about it. I didn't want to complain, but since you asked...\""
msgstr "　鳶丸には出てくるところを見られたし、正直、誰かに言いたい気持ちはあった。弱音みたいなものだから、副会長が聞いてくれるならちょうどいい」"

#. Occurrence 8DOT5:14661:12739: scene=8DOT5
#: 8DOT5:14661
msgctxt "text_id=12739 | speaker=unknown"
msgid "  Leaning on the rail of the footbridge, Tobimaru urged him to go on."
msgstr "　歩道橋の<欄干|らんかん>に寄りかかりながら、鳶丸は先を<促|うなが>した。"

#. Occurrence 8DOT5:14666:12740: scene=8DOT5
#: 8DOT5:14666
msgctxt "text_id=12740 | speaker=unknown"
msgid "  It turned out that Soujyuro's story was nothing out of the ordinary."
msgstr "　草十郎の話は、フタを開けてみれば平凡なものだった。"

#. Occurrence 8DOT5:14672:12741: scene=8DOT5
#: 8DOT5:14672
msgctxt "text_id=12741 | speaker=unknown"
msgid "  His new part-time job was to be a home helper in that old one-story house."
msgstr "　彼の新しいアルバイトは、あの平屋住宅の、とある家のホームヘルパーだった。"

#. Occurrence 8DOT5:14677:12742: scene=8DOT5
#: 8DOT5:14677
msgctxt "text_id=12742 | speaker=unknown"
msgid "  This resident was a widow who had been left alone after her son moved off to the city."
msgstr "　ただ少し風向きが違うのは、その家の老婆は夫に先立たれ、息子も都会に出たまま便りをよこさなくなった事だ。"

#. Occurrence 8DOT5:14712:12743: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0034; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14712
msgctxt "text_id=12743 | speaker=soujuurou"
msgid "\"At first, I was just helping around the house.\""
msgstr "「はじめは、ただのお手伝いだったんだけどね」"

#. Occurrence 8DOT5:14718:12744: scene=8DOT5
#: 8DOT5:14718
msgctxt "text_id=12744 | speaker=unknown"
msgid "  He spoke with a troubled, slightly regretful smile."
msgstr "　困ったような、悔いるような笑顔で彼は言った。"

#. Occurrence 8DOT5:14723:12745: scene=8DOT5
#: 8DOT5:14723
msgctxt "text_id=12745 | speaker=unknown"
msgid "  Maybe he was ashamed of something he'd done?"
msgstr "　あるいは、不当な行為への嫌悪か。"

#. Occurrence 8DOT5:14728:12746: scene=8DOT5
#: 8DOT5:14728
msgctxt "text_id=12746 | speaker=unknown"
msgid "  There was a tinge of darkness behind the wry, tormented smile on his face."
msgstr "　自虐的にすら見える苦笑いは、暗い<翳|かげ>りを帯びている。"

#. Occurrence 8DOT5:14761:12747: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0112; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:14761
msgctxt "text_id=12747 | speaker=tobimaru"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence 8DOT5:14772:12748: scene=8DOT5
#: 8DOT5:14772
msgctxt "text_id=12748 | speaker=unknown"
msgid "  Tobimaru found himself surprised at his own thoughts and slapped himself lightly on the cheek."
msgstr "　鳶丸はかすかに驚いて、すぐに自分の頬を叩いた。"

#. Occurrence 8DOT5:14777:12749: scene=8DOT5
#: 8DOT5:14777
msgctxt "text_id=12749 | speaker=unknown"
msgid "  This was his way of punishing himself. He wasn't sure why his imagination was running so wild now."
msgstr "　この少年が、その手の感情を見せるとは夢にも思っていなかった―――そんな身勝手な思いこみを恥じ入って、自分自身を罰したのだ。"

#. Occurrence 8DOT5:14798:12750: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0113; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:14798
msgctxt "text_id=12750 | speaker=tobimaru"
msgid "\"You seem oddly glum, though. Oh, I get it. You have a problem with the son who left his mom like that, even though she clearly needs help around the house, huh?\""
msgstr "「珍しくうかない顔だが。あれか、出ていった息子さんとやらに文句があるのか？　<介護|かいご>が必要なお<袋|ふくろ>さんを放って、好きかってに暮らしていることに？」"

#. Occurrence 8DOT5:14816:12751: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0035; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14816
msgctxt "text_id=12751 | speaker=soujuurou"
msgid "\"...I wonder. It is an odd story, I think."
msgstr "「……どうだろう。確かにおかしな話だとは思う。"

#. Occurrence 8DOT5:14822:12752: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0036; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14822
msgctxt "text_id=12752 | speaker=soujuurou"
msgid "  But I don't really mean to blame him. I mean, that's...\""
msgstr "　けど、俺はその息子さんを責める気にはなれない。だって、それは」"

#. Occurrence 8DOT5:14847:12753: scene=8DOT5
#: 8DOT5:14847
msgctxt "text_id=12753 | speaker=unknown"
msgid "  Soujyuro stopped himself mid-sentence."
msgstr "　言いかけて口を<噤|つぐ>む。"

#. Occurrence 8DOT5:14852:12754: scene=8DOT5
#: 8DOT5:14852
msgctxt "text_id=12754 | speaker=unknown"
msgid "  He didn't think the son hated his mother so much as he did the town;"
msgstr "　おそらく、その息子は母を嫌ったのではなく、この町を嫌ったのだ。"

#. Occurrence 8DOT5:14857:12755: scene=8DOT5
#: 8DOT5:14857
msgctxt "text_id=12755 | speaker=unknown"
msgid "  he had probably just found somewhere better to live, and moved away."
msgstr "　単に、ここより好きな場所があったら、この町から出ていっただけの話。"

#. Occurrence 8DOT5:14862:12756: scene=8DOT5
#: 8DOT5:14862
msgctxt "text_id=12756 | speaker=unknown"
msgid "  Soujyuro swallowed those bitter words."
msgstr "　草十郎はそれを<苦々|にがにが>しげに、声にせず飲みこんだ。"

#. Occurrence 8DOT5:14898:12757: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0037; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14898
msgctxt "text_id=12757 | speaker=soujuurou"
msgid "\"At first, I took the full amount as payment."
msgstr "「お手伝いの料金は初めに全部もらってたんだ。"

#. Occurrence 8DOT5:14898:12758: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0037; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14898
msgctxt "text_id=12758 | speaker=soujuurou"
msgid "  But I thought 100,000 yen was way too much for a job that'll only last the month.\""
msgstr "　今月だけという話なのに、十万円は高すぎると思う」"

#. Occurrence 8DOT5:14904:12759: scene=8DOT5
#: 8DOT5:14904
msgctxt "text_id=12759 | speaker=unknown"
msgid "  He trailed off, muttering that he really didn't need that much money."
msgstr "　本気で、こんなにお金はいらないのに、と呟く。"

#. Occurrence 8DOT5:14909:12760: scene=8DOT5
#: 8DOT5:14909
msgctxt "text_id=12760 | speaker=unknown"
msgid "  The old woman had thanked him for his honesty."
msgstr "　そんな少年に老婆は感謝をした。"

#. Occurrence 8DOT5:14914:12761: scene=8DOT5
#: 8DOT5:14914
msgctxt "text_id=12761 | speaker=unknown"
msgid "  That was part of Soujyuro's appeal, most likely."
msgstr "　草十郎の頼りないところも微笑ましかったのだろう。"

#. Occurrence 8DOT5:14919:12762: scene=8DOT5
#: 8DOT5:14919
msgctxt "text_id=12762 | speaker=unknown"
msgid "  In a matter of days, the old woman put all her trust into Soujyuro and treated him like her own grandson."
msgstr "　老婆はすぐに心を許し、数日を待たずして草十郎を孫と同一視するようになったらしい。"

#. Occurrence 8DOT5:14940:12763: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0038; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14940
msgctxt "text_id=12763 | speaker=soujuurou"
msgid "\"I was honestly happy about that. The problem is...\""
msgstr "「……ああ。それは素直に嬉しいんだけど、問題は」"

#. Occurrence 8DOT5:14946:12764: scene=8DOT5
#: 8DOT5:14946
msgctxt "text_id=12764 | speaker=unknown"
msgid "  She always saw him off with a smile, and asked him to return tomorrow."
msgstr "　問題は、明日も来ておくれ、と。"

#. Occurrence 8DOT5:14951:12765: scene=8DOT5
#: 8DOT5:14951
msgctxt "text_id=12765 | speaker=unknown"
msgid "  Every time he left, she gave him a stack of cash in the hope that he wouldn't forget her."
msgstr "　わたしを忘れないでおくれと、別れ際に草十郎に大金を手渡した事だ。"

#. Occurrence 8DOT5:14986:12766: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0114; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:14986
msgctxt "text_id=12766 | speaker=tobimaru"
msgid "\"Whoa, really? That's what you're getting all that money for?\""
msgstr "「ああ？　それだけで大金もらってたのか？」"

#. Occurrence 8DOT5:14992:12767: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0039; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14992
msgctxt "text_id=12767 | speaker=soujuurou"
msgid "\"Yeah. She says she wants me to be her grandson."
msgstr "「うん。お孫さんの代わりをしてほしい、と言われた。"

#. Occurrence 8DOT5:14999:12768: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0040; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:14999
msgctxt "text_id=12768 | speaker=soujuurou"
msgid "She says she can trust me, so she wants me to act like I'm her grandson.\""
msgstr "貴方は信じられるから、これで孫のようにふるまってくれって」"

#. Occurrence 8DOT5:15026:12769: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0115; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15026
msgctxt "text_id=12769 | speaker=tobimaru"
msgid "\"Wow, that's crazy! It's hard to believe, but I guess a grandson-for-hire isn't much different from a house helper...\""
msgstr "「……なんだそりゃ。少しも信じてねえよそれ。金で動く孫がいるか。そりゃあヘルパーと変わらねえ」"

#. Occurrence 8DOT5:15037:12770: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0041; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15037
msgctxt "text_id=12770 | speaker=soujuurou"
msgid "\"No, it's different. She said she doesn't pay helpers because she can't trust them. She says she can only trust money.\""
msgstr "「いや。おばあさんはヘルパーさんにはお金は払わないと言った。信頼できないから。あのおばあさんが信じられるのはお金だけなんだ」"

#. Occurrence 8DOT5:15079:12771: scene=8DOT5
#: 8DOT5:15079
msgctxt "text_id=12771 | speaker=unknown"
msgid "  She seemed to have some quirks about her, probably because she'd been living alone for so long."
msgstr "　長くひとりきりで暮らしてきたからか、それとも生来の偏屈さからひとりになったのか。"

#. Occurrence 8DOT5:15084:12772: scene=8DOT5
#: 8DOT5:15084
msgctxt "text_id=12772 | speaker=unknown"
msgid "  By this point she'd lost all faith in the goodwill of humankind."
msgstr "　老婆は「人間の善意」をまるっきり信じられないようになっていた。"

#. Occurrence 8DOT5:15089:12773: scene=8DOT5
#: 8DOT5:15089
msgctxt "text_id=12773 | speaker=unknown"
msgid "  To her, the bonds of a family were nothing but fantasy."
msgstr "　彼女にとって、家族の絆は絵空事にすぎない。"

#. Occurrence 8DOT5:15094:12774: scene=8DOT5
#: 8DOT5:15094
msgctxt "text_id=12774 | speaker=unknown"
msgid "  After being cast aside by her own family for so many years, the only thing that remained faithful to her was the money she'd saved."
msgstr "　長年そういったものに見捨てられてきた彼女にとって、確かなものは手元に残った貯金だけ。"

#. Occurrence 8DOT5:15114:12775: scene=8DOT5
#: 8DOT5:15114
msgctxt "text_id=12775 | speaker=unknown"
msgid "  Over time, this led to her developing a strange complex."
msgstr "　……だから、逆に。"

#. Occurrence 8DOT5:15119:12776: scene=8DOT5
#: 8DOT5:15119
msgctxt "text_id=12776 | speaker=unknown"
msgid "  For her, the money she'd scrimped and saved, the last thing she could rely on, was the only way she could conceive of keeping someone in her life."
msgstr "　偏屈に、<無駄遣|むだづか>いせず、最後の心の拠り所として貯めに貯めた<金|ソレ>だけが、彼女にとって、人をつなぎ止める絆になっていたのだろう。"

#. Occurrence 8DOT5:15154:12777: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0116; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15154
msgctxt "text_id=12777 | speaker=tobimaru"
msgid "\"That's crazy."
msgstr "「……バカらしい。"

#. Occurrence 8DOT5:15160:12778: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0117; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15160
msgctxt "text_id=12778 | speaker=tobimaru"
msgid "  She's just hiring help. It's not like she can just buy a grandson.\""
msgstr "　それって結局、金で雇った他人じゃねえか。孫の代わりとは言えねえな」"

#. Occurrence 8DOT5:15181:12779: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0042; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15181
msgctxt "text_id=12779 | speaker=soujuurou"
msgid "\"I think she knows that more than anyone."
msgstr "「それはおばあさんが誰よりも分かってるよ。"

#. Occurrence 8DOT5:15187:12780: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0043; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15187
msgctxt "text_id=12780 | speaker=soujuurou"
msgid "  Even if she knows it isn't real, that's just how hard it is for her to trust anyone."
msgstr "　でも、偽者だと分かっていても、それぐらいしか信じられるモノはなかったんだ。"

#. Occurrence 8DOT5:15193:12781: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0044; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15193
msgctxt "text_id=12781 | speaker=soujuurou"
msgid "  What she wants most in this world is for her grandchildren to visit her, but since that's not happening, she turned to the one thing she could trust to make that a reality.\""
msgstr "　おばあさんにとって、家によりつかなくなったお孫さんはいま一番欲しいものだから、その代償として、彼女が一番信用できるものを真心として渡してくれたんだ」"

#. Occurrence 8DOT5:15214:12782: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0118; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15214
msgctxt "text_id=12782 | speaker=tobimaru"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 8DOT5:15220:12783: scene=8DOT5
#: 8DOT5:15220
msgctxt "text_id=12783 | speaker=unknown"
msgid "  She wasn't buying him, though."
msgstr "　買収ではない。"

#. Occurrence 8DOT5:15225:12784: scene=8DOT5
#: 8DOT5:15225
msgctxt "text_id=12784 | speaker=unknown"
msgid "  She just trusted Soujyuro from the bottom of her heart and was thanking him the only way she knew how."
msgstr "　老婆は心の底から草十郎を信頼したから、一番確かなもので感謝の気持ちを表した。"

#. Occurrence 8DOT5:15231:12785: scene=8DOT5
#: 8DOT5:15231
msgctxt "text_id=12785 | speaker=unknown"
msgid "  She didn't realize how that looked from other people's perspectives."
msgstr "　……それが、<傍目|はため>には<醜|みにく>い行為だと気づく事もできずに。"

#. Occurrence 8DOT5:15275:12786: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0119; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15275
msgctxt "text_id=12786 | speaker=tobimaru"
msgid "\"...Well, looks like you've gotten yourself into a real sticky situation again."
msgstr "「……また厄介な事情に首つっこんだもんだ。"

#. Occurrence 8DOT5:15281:12787: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0120; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15281
msgctxt "text_id=12787 | speaker=tobimaru"
msgid "  But hey, try not to worry about it too much."
msgstr "　まあ、あんまり深く思い詰めるな。"

#. Occurrence 8DOT5:15287:12788: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0121; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15287
msgctxt "text_id=12788 | speaker=tobimaru"
msgid "  I mean, it's a nice story. She's found something in her life that's even more important than money. It's something to be proud of.\""
msgstr "　いい話じゃねえか。命より金が大事だった婆さんが、今になって思い出の方に転んだワケだ。まっとうな話だよ」"

#. Occurrence 8DOT5:15293:12789: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0045; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15293
msgctxt "text_id=12789 | speaker=soujuurou"
msgid "\"Really? I hope so.\""
msgstr "「そうかな。そうだといいけど」"

#. Occurrence 8DOT5:15298:12790: scene=8DOT5
#: 8DOT5:15298
msgctxt "text_id=12790 | speaker=unknown"
msgid "  It was obvious from Soujyuro's expression that all this still weighed heavily on him."
msgstr "　うなずく草十郎の顔には、まだ重苦しい翳りが残っている。"

#. Occurrence 8DOT5:15340:12791: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0122; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15340
msgctxt "text_id=12791 | speaker=tobimaru"
msgid "\"Come on, cheer up. Knowing you, I bet you haven't spent any of the money she's given you."
msgstr "「なんだよ煮えきらねえな。どうせおまえさんの事だ、もらった金は一銭も使ってねえんだろ？"

#. Occurrence 8DOT5:15346:12792: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0123; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15346
msgctxt "text_id=12792 | speaker=tobimaru"
msgid "  Are you saving it all up to give back to her when she inevitably runs out? Is that why you didn't tell Aozaki?\""
msgstr "　んな事してりゃいずれ年金も底をつく。そうなった時にまるまる返すつもりだから蒼崎にも黙ってたんじゃないのか？」"

#. Occurrence 8DOT5:15363:12793: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0046; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15363
msgctxt "text_id=12793 | speaker=soujuurou"
msgid "\"Huh? How did you know?\""
msgstr "「？　なんで鳶丸がそんなコト知ってるんだ？」"

#. Occurrence 8DOT5:15375:12794: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0124; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15375
msgctxt "text_id=12794 | speaker=tobimaru"
msgid "\"It was just a guess. But I know how you are.\""
msgstr "「あー、いや、なんとなく。そんな気がした」"

#. Occurrence 8DOT5:15409:12795: scene=8DOT5
#: 8DOT5:15409
msgctxt "text_id=12795 | speaker=unknown"
msgid "  Tobimaru decided it was best not to tell Soujyuro about all the trouble they went through for him today."
msgstr "　今日一日、草十郎の為に<奔走|ほんそう>した事は黙っておくが吉だ。"

#. Occurrence 8DOT5:15414:12796: scene=8DOT5
#: 8DOT5:15414
msgctxt "text_id=12796 | speaker=unknown"
msgid "  He knew Aoko would only make him regret it later if he did."
msgstr "　後々、なんで喋ったのか、と鉄の生徒会長に<祟|たた>られるのが目に見えている。"

#. Occurrence 8DOT5:15435:12797: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0047; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15435
msgctxt "text_id=12797 | speaker=soujuurou"
msgid "\"So, let me tell you the worst thing about all this."
msgstr "「そっか。でもこの話の一番難しいところはね、鳶丸。"

#. Occurrence 8DOT5:15441:12798: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0048; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15441
msgctxt "text_id=12798 | speaker=soujuurou"
msgid "  The truth is, this old lady doesn't have any grandchildren.\""
msgstr "　その人には、お孫さんはいなかったんだ」"

#. Occurrence 8DOT5:15457:12799: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0125; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15457
msgctxt "text_id=12799 | speaker=tobimaru"
msgid "\"Huh...?\""
msgstr "「あ―――？」"

#. Occurrence 8DOT5:15468:12800: scene=8DOT5
#: 8DOT5:15468
msgctxt "text_id=12800 | speaker=unknown"
msgid "  After a few moments of surprise, Tobimaru let out a sigh."
msgstr "　ぼんやりと口をあけて、ああ、と鳶丸は息を吐いた。"

#. Occurrence 8DOT5:15473:12801: scene=8DOT5
#: 8DOT5:15473
msgctxt "text_id=12801 | speaker=unknown"
msgid "  He understood."
msgstr "　そういう事か、と。"

#. Occurrence 8DOT5:15504:12802: scene=8DOT5
#: 8DOT5:15504
msgctxt "text_id=12802 | speaker=unknown"
msgid "  Being widowed with a son who's moved into the city and grandchildren who never visit..."
msgstr "　夫に先立たれ、息子は町を出て、孫は寄りつきもしない。"

#. Occurrence 8DOT5:15509:12803: scene=8DOT5
#: 8DOT5:15509
msgctxt "text_id=12803 | speaker=unknown"
msgid "  That was a normal, full and rich life."
msgstr "　なんて恵まれた、スタンダードな一生だろう。"

#. Occurrence 8DOT5:15514:12804: scene=8DOT5
#: 8DOT5:15514
msgctxt "text_id=12804 | speaker=unknown"
msgid "  Sometimes, however, a person's dreams were all that kept them going."
msgstr "　世の中には、そんな“もしも”を信じる事でしか、立ちゆかない人生もある。"

#. Occurrence 8DOT5:15519:12805: scene=8DOT5
#: 8DOT5:15519
msgctxt "text_id=12805 | speaker=unknown"
msgid "  The bottom is limitless. For every tragic life there is another even more tragic than that."
msgstr "　底はない。悲惨な人生の下には、より悲惨な底が待っているだけの話。"

#. Occurrence 8DOT5:15540:12806: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0049; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15540
msgctxt "text_id=12806 | speaker=soujuurou"
msgid "\"You know, sometimes this town catches me off guard."
msgstr "「時々、油断すると思うんだ。この町について。"

#. Occurrence 8DOT5:15546:12807: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0050; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15546
msgctxt "text_id=12807 | speaker=soujuurou"
msgid "  Everyone looks so happy and blessed, but if you look hard enough you start to see that's not always the case. It's like the entire town is fooling me.\""
msgstr "　みんな幸福そうに見えるのに、裏を覗くとそうでもないのはなんでだろうって。なんか、町全体に騙されてるみたいだ」"

#. Occurrence 8DOT5:15552:12808: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0126; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15552
msgctxt "text_id=12808 | speaker=tobimaru"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence 8DOT5:15557:12809: scene=8DOT5
#: 8DOT5:15557
msgctxt "text_id=12809 | speaker=unknown"
msgid "  Tobimaru leaned over the railing and looked down at the bustling town below."
msgstr "　鳶丸は<欄干|らんかん>によりかかって、賑わう町並みを見下ろしている。"

#. Occurrence 8DOT5:15591:12810: scene=8DOT5
#: 8DOT5:15591
msgctxt "text_id=12810 | speaker=unknown"
msgid "  In the end, Soujyuro's worries stemmed from his feeling lost in this environment."
msgstr "　草十郎の悩みは、つまるところ環境への戸惑いだ。"

#. Occurrence 8DOT5:15596:12811: scene=8DOT5
#: 8DOT5:15596
msgctxt "text_id=12811 | speaker=unknown"
msgid "  The woman who walked through life alone into old age..."
msgstr "　年老いるまで独りだった老婆の人生も、"

#. Occurrence 8DOT5:15601:12812: scene=8DOT5
#: 8DOT5:15601
msgctxt "text_id=12812 | speaker=unknown"
msgid "  Tobimaru's struggle with being antagonized by his entire family..."
msgstr "　親戚一同に敵視されている鳶丸の生い立ちも、"

#. Occurrence 8DOT5:15606:12813: scene=8DOT5
#: 8DOT5:15606
msgctxt "text_id=12813 | speaker=unknown"
msgid "  Those were both personal matters."
msgstr "　所詮は個人の事情でしかない。"

#. Occurrence 8DOT5:15611:12814: scene=8DOT5
#: 8DOT5:15611
msgctxt "text_id=12814 | speaker=unknown"
msgid "  Soujyuro's problems stemmed from the nebulous entity of the town itself."
msgstr "　少年の相手は、この得体の知れない町そのものらしい。"

#. Occurrence 8DOT5:15631:12815: scene=8DOT5
#: 8DOT5:15631
msgctxt "text_id=12815 | speaker=unknown"
msgid "  For every bit of progress made through modernization, there were also people left in growing misfortune."
msgstr "　近代化して豊かになった分、豊かになれなかった人間の悲惨さは増している。"

#. Occurrence 8DOT5:15636:12816: scene=8DOT5
#: 8DOT5:15636
msgctxt "text_id=12816 | speaker=unknown"
msgid "  It didn't matter whether they were unequal in wealth or compassion. It was all the same."
msgstr "　それは富の差であれ、心の差であれ同じ事だ。"

#. Occurrence 8DOT5:15641:12817: scene=8DOT5
#: 8DOT5:15641
msgctxt "text_id=12817 | speaker=unknown"
msgid "  The larger a town grows, the harder it becomes for the weak to thrive."
msgstr "　大きくなった町は弱者に<厳|きび>しい。"

#. Occurrence 8DOT5:15646:12818: scene=8DOT5
#: 8DOT5:15646
msgctxt "text_id=12818 | speaker=unknown"
msgid "  For a young man who spent his life in the countryside where everyone helped each other, this was hard to understand."
msgstr "　すべてが相互扶助でなりたっていた田舎育ちの少年にとっては、その在り方は耐え難い“なぜ”なのだろう。"

#. Occurrence 8DOT5:15681:12819: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0127; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15681
msgctxt "text_id=12819 | speaker=tobimaru"
msgid "\"Soujyuro... Do you really like it in this town?\""
msgstr "「草十郎。おまえ、この町は好きか？」"

#. Occurrence 8DOT5:15687:12820: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0051; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15687
msgctxt "text_id=12820 | speaker=soujuurou"
msgid "\"I honestly don't know yet. What about you?\""
msgstr "「……まだ分からない。そういう鳶丸は？」"

#. Occurrence 8DOT5:15708:12821: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0128; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15708
msgctxt "text_id=12821 | speaker=tobimaru"
msgid "\"Eh, similar. Sometimes I like it, sometimes I don't. Sometimes I feel like it doesn't matter either way."
msgstr "「ま、似たようなもんだ。好き嫌いも半々で、たまに何もかもどうでもよくなる時はある。"

#. Occurrence 8DOT5:15714:12822: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0129; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15714
msgctxt "text_id=12822 | speaker=tobimaru"
msgid "  Then again, I'm kind of the total opposite of you."
msgstr "　だがまあ、おまえさんとは真逆だな。"

#. Occurrence 8DOT5:15720:12823: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0130; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15720
msgctxt "text_id=12823 | speaker=tobimaru"
msgid "  In town, I can ignore my problems if I want. It's better than a place like this, anyway. There's something to this bustle and chaos that you can't discount. Even if it does feel hollow at times.\""
msgstr "　俺はこの町のおかげで<手前|テメエ>の悩みなんざ無視できる。ここに比べりゃマシだってな。空虚であろうと、この忙しさ、節操のなさは捨てたもんじゃねえってな」"

#. Occurrence 8DOT5:15741:12824: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0052; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15741
msgctxt "text_id=12824 | speaker=soujuurou"
msgid "\"It's better than here?\""
msgstr "「ここに比べたらマシ？」"

#. Occurrence 8DOT5:15747:12825: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0131; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15747
msgctxt "text_id=12825 | speaker=tobimaru"
msgid "\"Ah, not exactly. I just mean that I'd have more options."
msgstr "「……あー、違うな。マシというよりはアリって感じか。"

#. Occurrence 8DOT5:15753:12826: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0132; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15753
msgctxt "text_id=12826 | speaker=tobimaru"
msgid "  I'm sure you've thought this at your part-time jobs, but a town like this never leaves any gaps. Wherever there's an opening, that opening is going to be filled.\""
msgstr "　バイトしてればたまに思うだろ？　町ってのは隙間を作らないように回ってるんだ。欠席にしろ空席にしろ、空きが出来たらすぐに埋められるように出来ている」"

#. Occurrence 8DOT5:15785:12827: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0133; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15785
msgctxt "text_id=12827 | speaker=tobimaru"
msgid "\"A city is a really well-constructed community when you think about it."
msgstr "「当たり前のようで、コイツはよく出来た共同体なんだよ。"

#. Occurrence 8DOT5:15791:12828: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0134; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15791
msgctxt "text_id=12828 | speaker=tobimaru"
msgid "  Someone you never knew the day before, might be a neighbor you need to call on the very next day."
msgstr "　昨日までは誰でもなかった他人が、明日には必要な隣人になってるかもしれない。"

#. Occurrence 8DOT5:15797:12829: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0135; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15797
msgctxt "text_id=12829 | speaker=tobimaru"
msgid "  A street corner that had nothing on it yesterday, might have a new building on it today.\""
msgstr "　昨日まではなかった町角に、新しい建物ができている事もある」"

#. Occurrence 8DOT5:15818:12830: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0136; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15818
msgctxt "text_id=12830 | speaker=tobimaru"
msgid "\"Every single day in the city is like living through a major surgery in progress. It's seriously impressive that it works as well as it does."
msgstr "「まるで毎日が切った<縫|ぬ>ったの大手術だ。それでもうまく回ってる事に、真剣に感心する。"

#. Occurrence 8DOT5:15824:12831: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0137; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15824
msgctxt "text_id=12831 | speaker=tobimaru"
msgid "  Something always makes me think that."
msgstr "　本当に、何かのはずみで思うんだよ。"

#. Occurrence 8DOT5:15831:12832: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0138; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15831
msgctxt "text_id=12832 | speaker=tobimaru"
msgid "I'm not just living on my own. I'm able to survive thanks to the accomplishments of people I'll never know about."
msgstr "俺はテメエだけで生きてるんじゃなくて、どうでもいい誰かのどうでもいい頑張りのおかげで、こうしてクダまけてるんだってな。"

#. Occurrence 8DOT5:15837:12833: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0139; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15837
msgctxt "text_id=12833 | speaker=tobimaru"
msgid "  It's all a bunch of give-and-take. The fact that it works at all is a feat in and of itself.\""
msgstr "　持ちつ持たれつだ。そういう巡り合わせを成立させているだけでも、どんなバランスなんだって呆れるわけだ」"

#. Occurrence 8DOT5:15870:12834: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0053; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15870
msgctxt "text_id=12834 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 8DOT5:15876:12835: scene=8DOT5
#: 8DOT5:15876
msgctxt "text_id=12835 | speaker=unknown"
msgid "  Just as the mountains are alive, so is the city."
msgstr "　山が生き物であるように、町もまた生き物だ。"

#. Occurrence 8DOT5:15881:12836: scene=8DOT5
#: 8DOT5:15881
msgctxt "text_id=12836 | speaker=unknown"
msgid "  Tobimaru didn't seem to like the way that living creature had manifested itself."
msgstr "　鳶丸はその生き物のカタチをいまいち気に入っていないらしい。"

#. Occurrence 8DOT5:15886:12837: scene=8DOT5
#: 8DOT5:15886
msgctxt "text_id=12837 | speaker=unknown"
msgid "  But even still..."
msgstr "　ただそれでも、"

#. Occurrence 8DOT5:15912:12838: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0054; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:15912
msgctxt "text_id=12838 | speaker=soujuurou"
msgid "\"I see. You really respect it, huh?\""
msgstr "「そうか。敬意を払ってるんだな、鳶丸は」"

#. Occurrence 8DOT5:15930:12839: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0140; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15930
msgctxt "text_id=12839 | speaker=tobimaru"
msgid "\"I mean, it's a little embarrassing, but yeah.\""
msgstr "「……まあ。照れくさいが、そういうこった」"

#. Occurrence 8DOT5:15936:12840: scene=8DOT5
#: 8DOT5:15936
msgctxt "text_id=12840 | speaker=unknown"
msgid "  As someone who was born and raised in the city, Tobimaru was thankful that complete strangers were able to help each other out."
msgstr "　町に生まれた人間として、顔も知らない人間が、顔も知らないクセに助け合っている事実に、感謝している。"

#. Occurrence 8DOT5:15962:12841: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0141; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15962
msgctxt "text_id=12841 | speaker=tobimaru"
msgid "\"Honestly, you're just asking for too much!"
msgstr "「つーか、おまえさんは贅沢すぎる！"

#. Occurrence 8DOT5:15968:12842: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0142; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:15968
msgctxt "text_id=12842 | speaker=tobimaru"
msgid "  Nobody likes where they live in the beginning. You can't choose where you were born, after all. You have to learn to like wherever it is you've decided to live, not the other way around!\""
msgstr "　はじめから好きなところに住めるヤツなんていねえだろ。生まれる場所は選べねえしな。単純な話、自分が住むって決めたところを好きになるしかねえってことだ！」"

#. Occurrence 8DOT5:16004:12843: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0055; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:16004
msgctxt "text_id=12843 | speaker=soujuurou"
msgid "\"Gah!\""
msgstr "「っ！」"

#. Occurrence 8DOT5:16010:12844: scene=8DOT5
#: 8DOT5:16010
msgctxt "text_id=12844 | speaker=unknown"
msgid "  Tobimaru gave Soujyuro's back a hard slap."
msgstr "　鳶丸の手が草十郎の背中を叩く。"

#. Occurrence 8DOT5:16015:12845: scene=8DOT5
#: 8DOT5:16015
msgctxt "text_id=12845 | speaker=unknown"
msgid "  It made Soujyuro straighten up his posture and snap him out of his slump a bit."
msgstr "　丸まりかけた背を叩かれて、草十郎は目を点にして跳ね起きた。"

#. Occurrence 8DOT5:16062:12846: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0056; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:16062
msgctxt "text_id=12846 | speaker=soujuurou"
msgid "\"Okay, but what if you decide to live somewhere and you just can't like it no matter how hard you try?\""
msgstr "「……でも鳶丸。そこに住むって決めても、好きになれなかったらどうするんだ？」"

#. Occurrence 8DOT5:16068:12847: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0143; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16068
msgctxt "text_id=12847 | speaker=tobimaru"
msgid "\"If you really don't like it, you can just move somewhere else. Don't be scared to run away from a bad place. You're meant to wander a bit in life.\""
msgstr "「どうしても好きになれないヤツは違う土地に行けばいい。イヤなら逃げてもいいんだよ。放浪するのも人生だぜ」"

#. Occurrence 8DOT5:16089:12848: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0057; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:16089
msgctxt "text_id=12848 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 8DOT5:16094:12849: scene=8DOT5
#: 8DOT5:16094
msgctxt "text_id=12849 | speaker=unknown"
msgid "  Soujyuro was so impressed with Tobimaru's words he couldn't speak. They gave him a new perspective."
msgstr "　鳶丸の発言は目から鱗だったのか、草十郎は感心して息を呑んでいる。"

#. Occurrence 8DOT5:16099:12850: scene=8DOT5
#: 8DOT5:16099
msgctxt "text_id=12850 | speaker=unknown"
msgid "  It wasn't just the words, \"don't be scared to run away from a bad place.\""
msgstr "　イヤなら逃げていい、という言葉にではなく、"

#. Occurrence 8DOT5:16104:12851: scene=8DOT5
#: 8DOT5:16104
msgctxt "text_id=12851 | speaker=unknown"
msgid "  What had really left a strong impression was Tobimaru's confidence."
msgstr "　そう言い切れる槻司鳶丸に、強い<感銘|かんめい>を受けたのだ。"

#. Occurrence 8DOT5:16109:12852: scene=8DOT5
#: 8DOT5:16109
msgctxt "text_id=12852 | speaker=unknown"
msgid "  Although he had been born in this town, he spoke freely of abandoning it."
msgstr "　この町に生まれながら、この町をあっさり捨てられると言った彼の自由さに。"

#. Occurrence 8DOT5:16153:12853: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0058; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:16153
msgctxt "text_id=12853 | speaker=soujuurou"
msgid "\"I never thought I'd hear you talk about running away.\""
msgstr "「鳶丸から、逃げるなんて言葉がでるとは思わなかった」"

#. Occurrence 8DOT5:16179:12854: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0144; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16179
msgctxt "text_id=12854 | speaker=tobimaru"
msgid "\"There's nothing wrong with running away if you have somewhere to run to."
msgstr "「逃げる先があるなら逃げてもいいだろって話。"

#. Occurrence 8DOT5:16185:12855: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0145; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16185
msgctxt "text_id=12855 | speaker=tobimaru"
msgid "  That's not to say you shouldn't hold on to words like victory and success, or fortune and fame."
msgstr "　……そりゃ勝ちとか成功とか、そういう言葉に固執するのも悪くはねえさ。富と名声はいいもんだしな。"

#. Occurrence 8DOT5:16191:12856: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0146; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16191
msgctxt "text_id=12856 | speaker=tobimaru"
msgid "  I just think it's easy to feel stifled if you're always trying to win. I don't have the willpower of someone like Aozaki who can just power through things. I like to keep life... light.\""
msgstr "　だが、俺にはどうも、勝ち続けるっていうのは固まるってコトに見える。息苦しくてしょうがない。蒼崎みたいにがんじがらめになっても突き進むパワーもねえしな。身上は軽い方がいいだろうよ」"

#. Occurrence 8DOT5:16218:12857: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0059; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:16218
msgctxt "text_id=12857 | speaker=soujuurou"
msgid "\"You think life is better when it's light?\""
msgstr "「？　人生は軽い方がいいのか？」"

#. Occurrence 8DOT5:16229:12858: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0147; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16229
msgctxt "text_id=12858 | speaker=tobimaru"
msgid "\"I don't really mean lightweight or secure, or anything like that. I just want more adventure or, you know...\""
msgstr "「いや、軽いとか手堅いとか、そういうんじゃなくて、オレはもっと、こう、<浪漫|ろまん>あふれるっつーか……」"

#. Occurrence 8DOT5:16264:12859: scene=8DOT5
#: 8DOT5:16264
msgctxt "text_id=12859 | speaker=unknown"
msgid "  Tobimaru furrowed his brow at his inability to find the proper words."
msgstr "　言いかけて、それも違うな、と鳶丸は眉をひそめる。"

#. Occurrence 8DOT5:16269:12860: scene=8DOT5
#: 8DOT5:16269
msgctxt "text_id=12860 | speaker=unknown"
msgid "  What he wanted was simple."
msgstr "　欲しいものは単純なものだ。"

#. Occurrence 8DOT5:16276:12861: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0148; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16276
msgctxt "text_id=12861 | speaker=tobimaru"
msgid "\"Look, I just want to live a life that I can laugh about.\""
msgstr "「そうだな。俺はきっと、笑える人生が送りたいんだ」"

#. Occurrence 8DOT5:16282:12862: scene=8DOT5
#: 8DOT5:16282
msgctxt "text_id=12862 | speaker=unknown"
msgid "  That was how he saw life."
msgstr "　こういうものだろ、と。"

#. Occurrence 8DOT5:16287:12863: scene=8DOT5
#: 8DOT5:16287
msgctxt "text_id=12863 | speaker=unknown"
msgid "  Tobimaru tried his best to put into words his thoughts, hoping his friend would find them useful."
msgstr "　鳶丸は自分が良しとするものが、いま目の前で悩む友人の指針になればいいと願って口にした。"

#. Occurrence 8DOT5:16331:12864: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0060; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:16331
msgctxt "text_id=12864 | speaker=soujuurou"
msgid "\"...Like... a comedian?\""
msgstr "「………………漫才師か？」"

#. Occurrence 8DOT5:16337:12865: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0149; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16337
msgctxt "text_id=12865 | speaker=tobimaru"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 8DOT5:16342:12866: scene=8DOT5
#: 8DOT5:16342
msgctxt "text_id=12866 | speaker=unknown"
msgid "  Tobimaru's shoulders slumped in disappointment."
msgstr "　ガックリと肩を落とす。"

#. Occurrence 8DOT5:16347:12867: scene=8DOT5
#: 8DOT5:16347
msgctxt "text_id=12867 | speaker=unknown"
msgid "  But even so..."
msgstr "　落としたものの、"

#. Occurrence 8DOT5:16353:12868: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0150; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16353
msgctxt "text_id=12868 | speaker=tobimaru"
msgid "\"Actually, yeah. Sure.\""
msgstr "「いや、そんなもんか、実際」"

#. Occurrence 8DOT5:16358:12869: scene=8DOT5
#: 8DOT5:16358
msgctxt "text_id=12869 | speaker=unknown"
msgid "  The more he thought about it, the more he realized that Soujyuro wasn't really wrong."
msgstr "　よくよく考えると的はずれでもない、と納得する鳶丸だった。"

#. Occurrence 8DOT5:16378:12870: scene=8DOT5
#: 8DOT5:16378
msgctxt "text_id=12870 | speaker=unknown"
msgid "  There was no end to human desire."
msgstr "　人間、望めば望むほど果てがない。"

#. Occurrence 8DOT5:16383:12871: scene=8DOT5
#: 8DOT5:16383
msgctxt "text_id=12871 | speaker=unknown"
msgid "  The perfect life was an unattainable dream."
msgstr "　最高の人生なんてものは誰であろうと迎えられない。"

#. Occurrence 8DOT5:16388:12872: scene=8DOT5
#: 8DOT5:16388
msgctxt "text_id=12872 | speaker=unknown"
msgid "  The only way to really win was to be able to say with your dying breath that you had truly enjoyed living."
msgstr "　なら、いまわの際で「俺の人生は愉快だった」とニヤつけるなら、最後の最後で勝ち組だろうと。"

#. Occurrence 8DOT5:16427:12873: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0151; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16427
msgctxt "text_id=12873 | speaker=tobimaru"
msgid "\"...Man, I wonder if this is Aozaki's influence. She's the type to take a gamble on anything. I bet she loves Bonnie and Clyde.\""
msgstr "「……ったく、蒼崎の影響かねえ。考えなしの<博徒|ばくと>かっていうの。あいつ、ボニー＆クライドとか大好きなんだろうなあ」"

#. Occurrence 8DOT5:16433:12874: scene=8DOT5
#: 8DOT5:16433
msgctxt "text_id=12874 | speaker=unknown"
msgid "  Tobimaru tiredly scratched his head."
msgstr "　やれやれと鳶丸は頭を掻いた。"

#. Occurrence 8DOT5:16438:12875: scene=8DOT5
#: 8DOT5:16438
msgctxt "text_id=12875 | speaker=unknown"
msgid "  He never would have said something like this last year, considering how pessimistic he had been then."
msgstr "　一年前までは厭世的だった自分が、よくもまあここまで偉そうに語れるものだと。"

#. Occurrence 8DOT5:16473:12876: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0152; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16473
msgctxt "text_id=12876 | speaker=tobimaru"
msgid "\"Anyway, there's no end to it if you worry about everyone else's business."
msgstr "「ともかくだ。他人の事情にいちいち落ちこんでるようじゃ日が暮れるぜ。"

#. Occurrence 8DOT5:16479:12877: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0153; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16479
msgctxt "text_id=12877 | speaker=tobimaru"
msgid "  Look, the sun's already going down. We've been out here forever.\""
msgstr "　いや、実際もう暮れかけてるけどな。とんだ道草だ」"

#. Occurrence 8DOT5:16485:12878: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0061; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:16485
msgctxt "text_id=12878 | speaker=soujuurou"
msgid "\"Sorry to keep you. Do you have something else you need to be doing?\""
msgstr "「そうか。引き留めてすまなかった。鳶丸は他に用事が？」"

#. Occurrence 8DOT5:16506:12879: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0154; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16506
msgctxt "text_id=12879 | speaker=tobimaru"
msgid "\"...Nah, maybe I'll just be good and head home."
msgstr "「……俺も大人しく家に帰るとするか。"

#. Occurrence 8DOT5:16512:12880: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0155; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16512
msgctxt "text_id=12880 | speaker=tobimaru"
msgid "  You should get home before it gets totally dark, too. If they ask you what you were doing, just be honest. It's not as bad as you think it sounds.\""
msgstr "　そっちも日が落ちる前に帰れよ。何をしていたか聞かれたら、隠さず事情は説明しとけ。その話、おまえが思ってるほどひでえ話じゃねえから」"

#. Occurrence 8DOT5:16543:12881: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0062; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:16543
msgctxt "text_id=12881 | speaker=soujuurou"
msgid "\"Hm...\""
msgstr "「む」"

#. Occurrence 8DOT5:16549:12882: scene=8DOT5
#: 8DOT5:16549
msgctxt "text_id=12882 | speaker=unknown"
msgid "  Soujyuro frowned and fell silent."
msgstr "　鳶丸の言葉に、眉を八の字にして黙りこむ草十郎。"

#. Occurrence 8DOT5:16554:12883: scene=8DOT5
#: 8DOT5:16554
msgctxt "text_id=12883 | speaker=unknown"
msgid "  He still hadn't come to terms with his arrangement with that old woman yet."
msgstr "　彼の中では、あの老婆にしてしまった行為の折り合いが付いていない。"

#. Occurrence 8DOT5:16574:12884: scene=8DOT5
#: 8DOT5:16574
msgctxt "text_id=12884 | speaker=unknown"
msgid "  If he hadn't gone there in the first place, she might not have felt like anything was missing from her life."
msgstr "　そもそも草十郎があの家を訪れなければ、彼女が自分の人生に絶望する事はなかったはずだ。"

#. Occurrence 8DOT5:16579:12885: scene=8DOT5
#: 8DOT5:16579
msgctxt "text_id=12885 | speaker=unknown"
msgid "  That feeling of regret was exactly why he wanted to talk to someone."
msgstr "　そう悔いているからこそ、草十郎は誰かに話したかったのだ。"

#. Occurrence 8DOT5:16614:12886: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0156; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16614
msgctxt "text_id=12886 | speaker=tobimaru"
msgid "\"I bet you think you've done something cruel to her, don't you?"
msgstr "「おまえ、残酷なことをしたと思ってんだろ。"

#. Occurrence 8DOT5:16620:12887: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0157; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16620
msgctxt "text_id=12887 | speaker=tobimaru"
msgid "  Like you showed her something that she can never have. Am I right?\""
msgstr "　婆さんの人生に、今からじゃ取り戻せないモノを見せつけた、とかな」"

#. Occurrence 8DOT5:16639:12888: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0063; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:16639
msgctxt "text_id=12888 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 8DOT5:16644:12889: scene=8DOT5
#: 8DOT5:16644
msgctxt "text_id=12889 | speaker=unknown"
msgid "  Soujyuro was stunned into silence."
msgstr "　核心をつかれて黙りこむ。"

#. Occurrence 8DOT5:16649:12890: scene=8DOT5
#: 8DOT5:16649
msgctxt "text_id=12890 | speaker=unknown"
msgid "  Tobimaru knew exactly what Soujyuro regretted."
msgstr "　その後悔を、鳶丸ははっきりと切り捨てた。"

#. Occurrence 8DOT5:16655:12891: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0158; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16655
msgctxt "text_id=12891 | speaker=tobimaru"
msgid "\"You shouldn't think that you have that much power over someone, Soujyuro.\""
msgstr "「そりゃ違う。思い上がりだぜ草十郎」"

#. Occurrence 8DOT5:16689:12892: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0159; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16689
msgctxt "text_id=12892 | speaker=tobimaru"
msgid "\"Listen. If she thinks she messed up her life, then you should do whatever you can to help her."
msgstr "「いいか。その婆さんも、自分は人生に失敗した、なんて思ってんなら、今の自分に出来ることをさせればいい。"

#. Occurrence 8DOT5:16695:12893: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0160; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16695
msgctxt "text_id=12893 | speaker=tobimaru"
msgid "  She's stinking rich, right?"
msgstr "　幸い、金は腐るほどあるんだろ？"

#. Occurrence 8DOT5:16701:12894: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0161; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16701
msgctxt "text_id=12894 | speaker=tobimaru"
msgid "  Then get her to help people with it. There are so many problems in this world she can fix with her money."
msgstr "　なら、思いっきり人助けをさせてみろ。金で救える不幸なんざ山ほどあるだろ。"

#. Occurrence 8DOT5:16707:12895: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0162; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16707
msgctxt "text_id=12895 | speaker=tobimaru"
msgid "  If you can get her to be proud of herself, then you'll have done a good job. It would make me happy at least.\""
msgstr "　んで、婆さんがどんなもんだと胸を張れたんなら、そりゃ間違いなくいい仕事だ。少なくとも俺は気持ちがいい」"

#. Occurrence 8DOT5:16733:12896: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0064; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:16733
msgctxt "text_id=12896 | speaker=soujuurou"
msgid "\"Hm... But that still doesn't get rid of her suffering.\""
msgstr "「……む。それは、おばあさんの苦しみを解決していない」"

#. Occurrence 8DOT5:16753:12897: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0163; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16753
msgctxt "text_id=12897 | speaker=tobimaru"
msgid "\"Don't worry about problems you can't solve."
msgstr "「解決できねえ問題は放っておけ。"

#. Occurrence 8DOT5:16759:12898: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0164; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16759
msgctxt "text_id=12898 | speaker=tobimaru"
msgid "  Focus on the problems you can help with."
msgstr "　その婆さんには今、他に解決できる問題があるんだからそれでいいじゃねえか。んで、"

#. Occurrence 8DOT5:16765:12899: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0165; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16765
msgctxt "text_id=12899 | speaker=tobimaru"
msgid "  If you can convince her to let you give that money back so she can use it to help others and herself, then she's won."
msgstr "『悪いけどお金はこれから世のため人のため自分のために使うから返しておくれ』となったらば婆さんの勝ち。"

#. Occurrence 8DOT5:16771:12900: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0166; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16771
msgctxt "text_id=12900 | speaker=tobimaru"
msgid "  That will give more meaning to her life than a fake grandson ever could.\""
msgstr "　偽者の孫なんざより、よっぽどいい生き甲斐に目覚めたわけだな」"

#. Occurrence 8DOT5:16792:12901: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0167; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16792
msgctxt "text_id=12901 | speaker=tobimaru"
msgid "\"But..."
msgstr "「しかし、"

#. Occurrence 8DOT5:16792:12902: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0167; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16792
msgctxt "text_id=12902 | speaker=tobimaru"
msgid "  If she says she's done enough, and she wants you to have the rest of her money..."
msgstr "『これで満足したから残りはやっぱり貰っておくれ』"

#. Occurrence 8DOT5:16798:12903: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0168; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16798
msgctxt "text_id=12903 | speaker=tobimaru"
msgid "  That means you've won."
msgstr "　と言えばおまえさんの勝ち。"

#. Occurrence 8DOT5:16804:12904: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0169; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16804
msgctxt "text_id=12904 | speaker=tobimaru"
msgid "  She'd prefer to think of you as her grandson. If that's the case, then there's no shame in taking that money from her.\""
msgstr "　婆さんにとってはやっぱり孫の方がいいって事で、そん時は大手を振って大金もって帰りやがれ」"

#. Occurrence 8DOT5:16835:12905: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0065; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:16835
msgctxt "text_id=12905 | speaker=soujuurou"
msgid "\"...I see now.\""
msgstr "「―――なるほど」"

#. Occurrence 8DOT5:16840:12906: scene=8DOT5
#: 8DOT5:16840
msgctxt "text_id=12906 | speaker=unknown"
msgid "  Soujyuro clapped his hands together. He was finally able to accept these conditions as fair."
msgstr "　鮮やかな大岡裁きに、ポン、と手を打つ草十郎。"

#. Occurrence 8DOT5:16853:12907: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0066; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:16853
msgctxt "text_id=12907 | speaker=soujuurou"
msgid "\"Hey, thanks for the talk, Tobimaru.\""
msgstr "「すまない。ありがとう鳶丸」"

#. Occurrence 8DOT5:16858:12908: scene=8DOT5
#: 8DOT5:16858
msgctxt "text_id=12908 | speaker=unknown"
msgid "  His smile was no longer bitter."
msgstr "　苦笑いは既にない。"

#. Occurrence 8DOT5:16863:12909: scene=8DOT5
#: 8DOT5:16863
msgctxt "text_id=12909 | speaker=unknown"
msgid "  He would do whatever he could to help that old woman choose to assist others in need."
msgstr "　今の一言で、彼は老婆の選択が前者になるよう、努力しようと決めたのだ。"

#. Occurrence 8DOT5:16896:12910: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0170; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16896
msgctxt "text_id=12910 | speaker=tobimaru"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 8DOT5:16901:12911: scene=8DOT5
#: 8DOT5:16901
msgctxt "text_id=12911 | speaker=unknown"
msgid "  Tobimaru thought that such unwavering confidence was the sign of true freedom."
msgstr "　鳶丸に言わせれば、その迷いのなさこそ、よっぽど自由に眩しく見える。"

#. Occurrence 8DOT5:16912:12912: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0171; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16912
msgctxt "text_id=12912 | speaker=tobimaru"
msgid "\"Don't worry about it. I needed it just as much as you."
msgstr "「気にするな、礼を言うならお互いさまだ。"

#. Occurrence 8DOT5:16918:12913: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8DOT5_0172; voice_prefix=B70; voice_category=4; scene=8DOT5
#: 8DOT5:16918
msgctxt "text_id=12913 | speaker=tobimaru"
msgid "  See you after the break.\""
msgstr "　じゃあな草十郎。休み明けに、また学校で」"

#. Occurrence 8DOT5:16951:12914: scene=8DOT5
#: 8DOT5:16951
msgctxt "text_id=12914 | speaker=unknown"
msgid "  His goodbye wasn't the friendliest, but Soujyuro didn't mind. He ran home with a big smile on his face."
msgstr "　愛想のない捨て台詞だったが、そんな鳶丸の態度も気にせず、草十郎は満面の笑みで手を挙げて走っていった。"

#. Occurrence 8DOT5:16956:12915: scene=8DOT5
#: 8DOT5:16956
msgctxt "text_id=12915 | speaker=unknown"
msgid "  Tobimaru's smile was a bit less carefree as he left the footbridge."
msgstr "　それに心底から困った笑みを浮かべて、鳶丸も歩道橋を後にする。"

#. Occurrence 8DOT5:16963:12916: scene=8DOT5
#: 8DOT5:16963
msgctxt "text_id=12916 | speaker=unknown"
msgid "  The time was four-thirty in the evening."
msgstr "　時刻は午後四時半。"

#. Occurrence 8DOT5:16968:12917: scene=8DOT5
#: 8DOT5:16968
msgctxt "text_id=12917 | speaker=unknown"
msgid "  Night would soon fall over the midwinter landscape."
msgstr "　真冬の町並みはほどなくして、夜の<帳|とばり>を降ろしていった。"

#. Occurrence 8DOT5:17055:12918: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0067; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:17055
msgctxt "text_id=12918 | speaker=soujuurou"
msgid "\"I'm home! Looks like it's going to be a cold one tonight again.\""
msgstr "「ただいま。今夜はまた、一段と冷えるね」"

#. Occurrence 8DOT5:17071:12919: scene=8DOT5
#: 8DOT5:17071
msgctxt "text_id=12919 | speaker=unknown"
msgid "  Aoko and Alice were both in the drawing room when he returned."
msgstr "　草十郎が戻ると、居間には青子と有珠の姿があった。"

#. Occurrence 8DOT5:17076:12920: scene=8DOT5
#: 8DOT5:17076
msgctxt "text_id=12920 | speaker=unknown"
msgid "  Neither of them had eaten dinner yet."
msgstr "　ふたりともまだ夕食前らしい。"

#. Occurrence 8DOT5:17081:12921: scene=8DOT5
#: 8DOT5:17081
msgctxt "text_id=12921 | speaker=unknown"
msgid "  Aoko looked displeased."
msgstr "　青子はむすっとした顔で、"

#. Occurrence 8DOT5:17098:12922: scene=8DOT5
#: 8DOT5:17098
msgctxt "text_id=12922 | speaker=unknown"
msgid "  Alice sat uncomfortably on the sofa."
msgstr "　有珠はどことなく落ち着かない様子でソファーに座っている。"

#. Occurrence 8DOT5:17129:12923: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0068; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:17129
msgctxt "text_id=12923 | speaker=soujuurou"
msgid "\"Huh, were you two waiting for me to get home?\""
msgstr "「あれ。もしかして、こっちの帰りを待っていたのか？」"

#. Occurrence 8DOT5:17147:12924: scene=8DOT5
#: 8DOT5:17147
msgctxt "text_id=12924 | speaker=unknown"
msgid "  Alice quietly affirmed his assumption."
msgstr "　かすかに肯定する有珠と、"

#. Occurrence 8DOT5:17162:12925: scene=8DOT5
#: 8DOT5:17162
msgctxt "text_id=12925 | speaker=unknown"
msgid "  Aoko vehemently denied it."
msgstr "　あからさまに否定する青子。"

#. Occurrence 8DOT5:17195:12926: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0069; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:17195
msgctxt "text_id=12926 | speaker=soujuurou"
msgid "\"Aozaki, I might just be imagining things, but you seem even more worked up than you were last night.\""
msgstr "「蒼崎。俺の気のせいならいいんだけど、なんだか昨夜以上にどうかしてないか？」"

#. Occurrence 8DOT5:17201:12927: scene=8DOT5
#: 8DOT5:17201
msgctxt "text_id=12927 | speaker=unknown"
msgid "  Soujyuro had gotten slightly better at reading the room, but he still had difficulty choosing the right words."
msgstr "　多少は空気が読めるようになった草十郎だが、言葉遣いはまだまだお粗末である。"

#. Occurrence 8DOT5:17233:12928: scene=8DOT5
#: 8DOT5:17233
msgctxt "text_id=12928 | speaker=unknown"
msgid "  (I'll show you worked up!)"
msgstr "　どうかしてるかっ！"

#. Occurrence 8DOT5:17239:12929: scene=8DOT5
#: 8DOT5:17239
msgctxt "text_id=12929 | speaker=unknown"
msgid "  ...Was what she wanted to say, but she stopped herself."
msgstr "　……と切り返したい青子ではあるが、ぐっと堪える。"

#. Occurrence 8DOT5:17244:12930: scene=8DOT5
#: 8DOT5:17244
msgctxt "text_id=12930 | speaker=unknown"
msgid "  She wasn't actually all that angry with Soujyuro."
msgstr "　彼女は別に、草十郎が気にしているほど怒ってはいないからだ。"

#. Occurrence 8DOT5:17249:12931: scene=8DOT5
#: 8DOT5:17249
msgctxt "text_id=12931 | speaker=unknown"
msgid "  But..."
msgstr "　が。"

#. Occurrence 8DOT5:17282:12932: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0019; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:17282
msgctxt "text_id=12932 | speaker=alice"
msgid "\"Wait, what are you worked up about Aoko?\""
msgstr "「どうかしてるの、青子？」"

#. Occurrence 8DOT5:17302:12933: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0168; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:17302
msgctxt "text_id=12933 | speaker=aoko"
msgid "\"I'm not worked up about anything! If anybody's worked up about something, it's Soujyuro!\""
msgstr "「してないわよ！　してるのは草十郎の方だっていうの！」"

#. Occurrence 8DOT5:17308:12934: scene=8DOT5
#: 8DOT5:17308
msgctxt "text_id=12934 | speaker=unknown"
msgid "  Alice's additional remark seemed to have been the tipping point."
msgstr "　有珠からの波状攻撃によって、むなしくも決壊してしまった。"

#. Occurrence 8DOT5:17338:12935: scene=8DOT5
#: 8DOT5:17338
msgctxt "text_id=12935 | speaker=unknown"
msgid "  Soujyuro thought this showed she was indeed worked up about something."
msgstr "　ほら、どうかしてるじゃないか、と草十郎は無言で指摘する。"

#. Occurrence 8DOT5:17370:12936: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0020; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:17370
msgctxt "text_id=12936 | speaker=alice"
msgid "\"You think so? I thought he seemed more normal than usual tonight.\""
msgstr "「静希君がどうかしたの？　彼、今夜は比較的まともだけど」"

#. Occurrence 8DOT5:17380:12937: scene=8DOT5
#: 8DOT5:17380
msgctxt "text_id=12937 | speaker=unknown"
msgid "  Soujyuro felt like that was pretty offensive too, but let it slide."
msgstr "　その言葉もどうかと思う草十郎だった。"

#. Occurrence 8DOT5:17415:12938: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0169; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:17415
msgctxt "text_id=12938 | speaker=aoko"
msgid "\"Fine, if that's how you want to play it. I was going to wait for you to say something, but I'll just go ahead and ask."
msgstr "「ああもう、分かったわよ。そっちから切りだすまで黙っていようと思ったけど、私の方から訊いてあげる。"

#. Occurrence 8DOT5:17421:12939: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0170; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:17421
msgctxt "text_id=12939 | speaker=aoko"
msgid "  Soujyuro, have you ever heard of an organization called the Light of Truth?\""
msgstr "　草十郎。アンタ、ほんものの光って名前に聞き覚えはない？」"

#. Occurrence 8DOT5:17439:12940: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0070; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:17439
msgctxt "text_id=12940 | speaker=soujuurou"
msgid "\"No, not before now.\""
msgstr "「いやまったく。はじめて聞いた」"

#. Occurrence 8DOT5:17470:12941: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0171; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:17470
msgctxt "text_id=12941 | speaker=aoko"
msgid "\"I didn't think so. Your name wasn't in their records anywhere. How could we have messed that up so badly..."
msgstr "「でしょうね。名簿にアンタの名前はなかったもの。なんだってあんな勘違いしちゃったんだろ。"

#. Occurrence 8DOT5:17476:12942: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0172; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:17476
msgctxt "text_id=12942 | speaker=aoko"
msgid "  It wasn't all for naught, but now I've set more bad rumors afloat.\""
msgstr "　骨折り損……とまではいかないけど、また良くない評判たてちゃった」"

#. Occurrence 8DOT5:17496:12943: scene=8DOT5
#: 8DOT5:17496
msgctxt "text_id=12943 | speaker=unknown"
msgid "  Aoko let out an exaggerated sigh and flopped down onto the sofa."
msgstr "　青子は大げさにため息をついて、ソファーにぐったりとよりかかる。"

#. Occurrence 8DOT5:17501:12944: scene=8DOT5
#: 8DOT5:17501
msgctxt "text_id=12944 | speaker=unknown"
msgid "  Seeing Aoko in this weakened state as an opportunity..."
msgstr "　そんな青子の弱体化を好機と見たのか。"

#. Occurrence 8DOT5:17506:12945: scene=8DOT5
#: 8DOT5:17506
msgctxt "text_id=12945 | speaker=unknown"
msgid "  ...the blue robin flew jauntily down from the sunroom."
msgstr "　サンルームから<颯爽|さっそう>とテーブルに飛来する青い星が一つ。"

#. Occurrence 8DOT5:17557:12946: voice_id=BA0_8DOT5_0012; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:17557
msgctxt "text_id=12946 | speaker=unknown"
msgid "\"Hahaha! I saw it with me own mince pies! The whole neighborhood is like, 'Oh that Aozaki girl has gone and done it again! She took down a whole business with the snap of her fingers!' You're an urban legend at this point! Hahahaha!\""
msgstr "『ハハハ、見てたっス、ジブン見てたっス！　ご近所じゃもう尾ひれつきまくりッス！　蒼崎さんトコの娘さんがまた指一本で店潰したとかマジパネェ、指先一つでダウンとかどこまで都市伝説作る気っスかwwwwww』"

#. Occurrence 8DOT5:17577:12947: scene=8DOT5
#: 8DOT5:17577
msgctxt "text_id=12947 | speaker=unknown"
msgid "  The robin continued to chatter praise for Aoko's deeds of valor."
msgstr "　チチチ、と青子の健闘をたたえる駒鳥。"

#. Occurrence 8DOT5:17696:12948: scene=8DOT5
#: 8DOT5:17696
msgctxt "text_id=12948 | speaker=unknown"
msgid "  Aoko knocked it away with a flick of her finger, and picked herself up off the sofa."
msgstr "　それを指先一つで弾き飛ばして、青子はのっそりと体を起こした。"

#. Occurrence 8DOT5:17742:12949: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0173; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:17742
msgctxt "text_id=12949 | speaker=aoko"
msgid "\"...I see you don't have an envelope of money today. Is your part-time job finished?\""
msgstr "「……今日はお金、持ってないわね。例のアルバイトはもう終わったの？」"

#. Occurrence 8DOT5:17748:12950: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0071; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:17748
msgctxt "text_id=12950 | speaker=soujuurou"
msgid "\"No, it's still going. I'm actually just holding that money. I made a separate bank account for it and deposited it this morning.\""
msgstr "「いや、まだ続いているよ。あのお金は預かりものだから、朝のうちに口座を作って預けておいた」"

#. Occurrence 8DOT5:17768:12951: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0174; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:17768
msgctxt "text_id=12951 | speaker=aoko"
msgid "\"You're holding it?\""
msgstr "「預かりもの？」"

#. Occurrence 8DOT5:17785:12952: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0072; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:17785
msgctxt "text_id=12952 | speaker=soujuurou"
msgid "\"Yep. I'll be giving it all back eventually.\""
msgstr "「そう、預かりもの。きっと全額<返|かえ>すことになる」"

#. Occurrence 8DOT5:17815:12953: scene=8DOT5
#: 8DOT5:17815
msgctxt "text_id=12953 | speaker=unknown"
msgid "  Soujyuro took off his coat and began talking about his job as a home helper."
msgstr "　そうして、草十郎はコートを脱ぎながらホームヘルパーのアルバイトを説明した。"

#. Occurrence 8DOT5:17820:12954: scene=8DOT5
#: 8DOT5:17820
msgctxt "text_id=12954 | speaker=unknown"
msgid "  He kept it simple, explaining how things began and the conclusion he'd come to with Tobimaru earlier."
msgstr "　あくまで簡素に。事の発端と、さきほど友人と一緒にだした結論だけを口にする。"

#. Occurrence 8DOT5:17844:12955: scene=8DOT5
#: 8DOT5:17844
msgctxt "text_id=12955 | speaker=unknown"
msgid "  Aoko seemed stunned by the outlandish circumstances, but in the end..."
msgstr "　はじめは突拍子のない内容に面食らった青子だったが、終わる頃には、"

#. Occurrence 8DOT5:17857:12956: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0175; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:17857
msgctxt "text_id=12956 | speaker=aoko"
msgid "\"Okay, okay, I should've known. I don't know if I'm relieved or disappointed. You really are incapable of doing any wrong, aren't you?\""
msgstr "「はいはい、やっぱりね。安心したっていうか、ガッカリしたっていうか。そうよね、どう頑張っても悪事を働ける人間じゃないわよね、貴方」"

#. Occurrence 8DOT5:17863:12957: scene=8DOT5
#: 8DOT5:17863
msgctxt "text_id=12957 | speaker=unknown"
msgid "  She was back to her usual offensive self."
msgstr "　などと、いつもの憎まれ口に戻っていた。"

#. Occurrence 8DOT5:17905:12958: scene=8DOT5
#: 8DOT5:17905
msgctxt "text_id=12958 | speaker=unknown"
msgid "  However..."
msgstr "　一方。"

#. Occurrence 8DOT5:17910:12959: scene=8DOT5
#: 8DOT5:17910
msgctxt "text_id=12959 | speaker=unknown"
msgid "  There was another girl in the room who had at this point gone pale."
msgstr "　ホッと一息ついた青子の対面で、ひっそり青ざめる少女がひとり。"

#. Occurrence 8DOT5:17931:12960: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0021; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:17931
msgctxt "text_id=12960 | speaker=alice"
msgid "\"Wait. So you're saying that wasn't your money?\""
msgstr "「待って。という事は、それは静希君のお金ではないの？」"

#. Occurrence 8DOT5:17953:12961: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0073; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:17953
msgctxt "text_id=12961 | speaker=soujuurou"
msgid "\"That's right. I'm just holding it for someone else.\""
msgstr "「ああ。<他人様|ひとさま>のお金だよ」"

#. Occurrence 8DOT5:18000:12962: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0176; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18000
msgctxt "text_id=12962 | speaker=aoko"
msgid "\"Alice?"
msgstr "「有珠？"

#. Occurrence 8DOT5:18006:12963: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0177; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18006
msgctxt "text_id=12963 | speaker=aoko"
msgid "  The expression on your face right now is something else. Are you okay?\""
msgstr "　なんかとんでもない顔してるけど、どうかした？」"

#. Occurrence 8DOT5:18025:12964: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0022; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:18025
msgctxt "text_id=12964 | speaker=alice"
msgid "\"...No, I'm fine. I just ordered takeout.\""
msgstr "「……それが。どうかはしてないけど、出前はしたわ」"

#. Occurrence 8DOT5:18031:12965: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0178; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18031
msgctxt "text_id=12965 | speaker=aoko"
msgid "\"Huh?\""
msgstr "「はい？」"

#. Occurrence 8DOT5:18037:12966: scene=8DOT5
#: 8DOT5:18037
msgctxt "text_id=12966 | speaker=unknown"
msgid "  Alice handed out menus for the local soba noodle shop and a cafe."
msgstr "　そっと、壊れ物を扱うように蕎麦屋と喫茶店のメニューを差しだす有珠。"

#. Occurrence 8DOT5:18076:12967: scene=8DOT5
#: 8DOT5:18076
msgctxt "text_id=12967 | speaker=unknown"
msgid "  The blood drained from Aoko's face as she took everything in."
msgstr "　それだけで事態を飲みこんでしまったのか、ざあ、と青子から血の気が引いていく。"

#. Occurrence 8DOT5:18086:12968: scene=8DOT5
#: 8DOT5:18086
msgctxt "text_id=12968 | speaker=unknown"
msgid "  Alice quietly passed her a small note."
msgstr "　さらにそそっと、有珠から一枚のメモが差し出される。"

#. Occurrence 8DOT5:18091:12969: scene=8DOT5
#: 8DOT5:18091
msgctxt "text_id=12969 | speaker=unknown"
msgid "  On it was a hastily written order that was more than enough food for the three of them."
msgstr "　走り書きとおぼしきメモには、三人分にしては余りある量の注文が―――"

#. Occurrence 8DOT5:18119:12970: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0179; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18119
msgctxt "text_id=12970 | speaker=aoko"
msgid "\"Wha- W-W-Wait, you already ordered?!\""
msgstr "「な―――ままま、まさかもう注文を!?」"

#. Occurrence 8DOT5:18131:12971: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0023; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:18131
msgctxt "text_id=12971 | speaker=alice"
msgid "\"Well, yeah. I thought it was about time someone treated us...\""
msgstr "「……だって。そろそろ、ご馳走のタイミングかと思って」"

#. Occurrence 8DOT5:18137:12972: scene=8DOT5
#: 8DOT5:18137
msgctxt "text_id=12972 | speaker=unknown"
msgid "  Alice's accusing gaze fell on Soujyuro."
msgstr "　うなだれる有珠の視線は、どことなく草十郎を非難していた。"

#. Occurrence 8DOT5:18175:12973: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0074; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:18175
msgctxt "text_id=12973 | speaker=soujuurou"
msgid "\"Huh? Me? Why?\""
msgstr "「え？　俺？　なんで？」"

#. Occurrence 8DOT5:18197:12974: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0180; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18197
msgctxt "text_id=12974 | speaker=aoko"
msgid "\"Because you got everyone's hopes up! Alice was looking forward to you treating us to dinner, you know!\""
msgstr "「そりゃ、アンタがいらない期待を持たせたからでしょ。有珠、あんなに喜んでたじゃない。明日はご馳走ねって」"

#. Occurrence 8DOT5:18214:12975: scene=8DOT5
#: 8DOT5:18214
msgctxt "text_id=12975 | speaker=unknown"
msgid "  Soujyuro clapped his hands together for the second time today."
msgstr "　ポン、と本日二度目の手打ち音が響く。"

#. Occurrence 8DOT5:18219:12976: scene=8DOT5
#: 8DOT5:18219
msgctxt "text_id=12976 | speaker=unknown"
msgid "  He remembered that Alice had said that yesterday."
msgstr "　そう言えば昨日の夜、有珠はそんな事を言っていた。"

#. Occurrence 8DOT5:18252:12977: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0024; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:18252
msgctxt "text_id=12977 | speaker=alice"
msgid "\"Yes, and you agreed!\""
msgstr "「ええ。あの夜、静希君は同意してくれたわ」"

#. Occurrence 8DOT5:18257:12978: scene=8DOT5
#: 8DOT5:18257
msgctxt "text_id=12978 | speaker=unknown"
msgid "  Alice was eager to emphasize that this was not her fault."
msgstr "　なので自分は悪くない、と有珠は主張する。"

#. Occurrence 8DOT5:18274:12979: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0075; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:18274
msgctxt "text_id=12979 | speaker=soujuurou"
msgid "\"Yeah, but...\""
msgstr "「いや、それは」"

#. Occurrence 8DOT5:18308:12980: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0181; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18308
msgctxt "text_id=12980 | speaker=aoko"
msgid "\"Alice may have messed up, but it's your fault! This is why you shouldn't walk around with so much money."
msgstr "「そうね。有珠のミスなのは確かだけど、悪いのはアンタもよ。大金を持ち歩くってのはそれだけで危険なんだから。"

#. Occurrence 8DOT5:18314:12981: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0182; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18314
msgctxt "text_id=12981 | speaker=aoko"
msgid "  I hope you've learned your lesson. You two are just going to have to split the bill.\""
msgstr "　いい教訓になったんじゃない？　観念して、二人で勘定を折半しなさいよ」"

#. Occurrence 8DOT5:18351:12982: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0076; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:18351
msgctxt "text_id=12982 | speaker=soujuurou"
msgid "\"No way, I can't! That money is in the bank, and I only have five hundred yen on me.\""
msgstr "「いや、それはできない。あのお金は預けてきたし、そもそも五百円しか持ち合わせがない」"

#. Occurrence 8DOT5:18360:12983: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0025; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:18360
msgctxt "text_id=12983 | speaker=alice"
msgid "\"...He's right. Even if we pool our money together, we won't have enough. Can we cancel the order...?\""
msgstr "「……そう。合わせても足りないわね。……試した事はないけど、出前にキャンセルはきくのかしら……」"

#. Occurrence 8DOT5:18380:12984: scene=8DOT5
#: 8DOT5:18380
msgctxt "text_id=12984 | speaker=unknown"
msgid "  An air of despair fell upon the Kuonji Estate."
msgstr "　絶望に包まれる久遠寺邸。"

#. Occurrence 8DOT5:18385:12985: scene=8DOT5
#: 8DOT5:18385
msgctxt "text_id=12985 | speaker=unknown"
msgid "  Aoko sighed as if none of this involved her."
msgstr "　それを他人事のように眺めつつ、やれやれと青子はため息をついた。"

#. Occurrence 8DOT5:18390:12986: scene=8DOT5
#: 8DOT5:18390
msgctxt "text_id=12986 | speaker=unknown"
msgid "  She hated to coddle them, but perhaps this was her fate."
msgstr "　……甘やかすのはよくないが、これも星の巡り合わせなのだろう、と。"

#. Occurrence 8DOT5:18434:12987: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0183; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18434
msgctxt "text_id=12987 | speaker=aoko"
msgid "\"I should've known this would happen."
msgstr "「―――ま、そうなるか。"

#. Occurrence 8DOT5:18440:12988: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0184; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18440
msgctxt "text_id=12988 | speaker=aoko"
msgid "  It's fine. I'll pay for it. I got some unexpected income today, so I might as well use it.\""
msgstr "　いいわよ、私が出してあげる。今日は臨時収入があったから、パァーッと派手に使いましょう」"

#. Occurrence 8DOT5:18468:12989: scene=8DOT5
#: 8DOT5:18468
msgctxt "text_id=12989 | speaker=unknown"
msgid "  Aoko's sudden proposal made both Soujyuro and Alice perk up."
msgstr "　思いがけぬ青子の提案に、ふたりは何事かと顔を上げる。"

#. Occurrence 8DOT5:18489:12990: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8DOT5_0077; voice_prefix=A30; voice_category=3; scene=8DOT5
#: 8DOT5:18489
msgctxt "text_id=12990 | speaker=soujuurou"
msgid "\"Wait, you're going to treat us, Aozaki?\""
msgstr "「つまり、蒼崎のおごり？」"

#. Occurrence 8DOT5:18495:12991: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8DOT5_0026; voice_prefix=A40; voice_category=2; scene=8DOT5
#: 8DOT5:18495
msgctxt "text_id=12991 | speaker=alice"
msgid "\"I can't believe my ears. Are you sure, Aoko?\""
msgstr "「そんな……信じられない。いいの青子……？」"

#. Occurrence 8DOT5:18532:12992: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0185; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18532
msgctxt "text_id=12992 | speaker=aoko"
msgid "\"Well, you've already called in the order. We can't cancel now."
msgstr "「呼んじゃったものは今さら止められないでしょ。"

#. Occurrence 8DOT5:18538:12993: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0186; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18538
msgctxt "text_id=12993 | speaker=aoko"
msgid "  If you called them earlier, they're probably already on their way up the hill."
msgstr "　さっき電話したんなら、今ごろはもう坂を登ってきてるだろうし。"

#. Occurrence 8DOT5:18544:12994: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0187; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18544
msgctxt "text_id=12994 | speaker=aoko"
msgid "  We got this money because of Soujyuro, anyway. It's a thank you present from the victim's advocacy group.\""
msgstr "　……まあ、そもそも。このお金も草十郎が発端だしね。人助けをしたら、被害者の会からお礼をもらっちゃったのよ」"

#. Occurrence 8DOT5:18570:12995: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0188; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18570
msgctxt "text_id=12995 | speaker=aoko"
msgid "\"It felt weird taking it from them, and this way it goes back into the shopping district anyway. So don't worry about it. I do think it's a bit of a waste, though, if I'm being honest.\""
msgstr "「だから気にしないで。なんか居心地悪かったし、浄財と思って商店街に還元する。……本音いうと、ちょっともったいないけどね」"

#. Occurrence 8DOT5:18576:12996: scene=8DOT5
#: 8DOT5:18576
msgctxt "text_id=12996 | speaker=unknown"
msgid "  Her roommates began celebrating."
msgstr "　おお、と<喝采|かっさい>をあげる同居人たち。"

#. Occurrence 8DOT5:18586:12997: scene=8DOT5
#: 8DOT5:18586
msgctxt "text_id=12997 | speaker=unknown"
msgid "  Aoko sank back onto the sofa upon seeing the happiness her gesture brought."
msgstr "　その喜びようを見ながら、青子はぼすん、とソファーに沈みこんだ。"

#. Occurrence 8DOT5:18619:12998: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0189; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18619
msgctxt "text_id=12998 | speaker=aoko"
msgid "\"Oh well... Easy come, easy go. All that extra money, gone just like that.\""
msgstr "「……あーあ。悪銭身に付かずって言うけど、ホントその通り。臨時収入は泡と消えた、か」"

#. Occurrence 8DOT5:18625:12999: scene=8DOT5
#: 8DOT5:18625
msgctxt "text_id=12999 | speaker=unknown"
msgid "  And thus..."
msgstr "　……かくして。"

#. Occurrence 8DOT5:18630:13000: scene=8DOT5
#: 8DOT5:18630
msgctxt "text_id=13000 | speaker=unknown"
msgid "  The curtain closed on a little incident involving a lot of cash."
msgstr "　降って湧いた大金にまつわる、ちょっとした事件はこうして幕を下ろしたのである。"

#. Occurrence 8DOT5:18650:13001: scene=8DOT5
#: 8DOT5:18650
msgctxt "text_id=13001 | speaker=unknown"
msgid "  The blue robin flew down to the table again."
msgstr "　テーブルには再度飛来する青い星。"

#. Occurrence 8DOT5:18668:13002: voice_id=BA0_8DOT5_0013; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:18668
msgctxt "text_id=13002 | speaker=unknown"
msgid "\"...Whew! That one'd knock you right out of yer Goldilocks, eh?\""
msgstr "『……ああ。まったく、イヤな<事|ヤ><件|マ>だったぜ……』"

#. Occurrence 8DOT5:18674:13003: scene=8DOT5
#: 8DOT5:18674
msgctxt "text_id=13003 | speaker=unknown"
msgid "  The robin chirped and mimicked puffing on a cigarette."
msgstr "　駒鳥はチチチと鳴き声をあげながら、煙草を吹かすジェスチャーなどに興じている。"

#. Occurrence 8DOT5:18714:13004: voice_id=BA0_8DOT5_0014; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:18714
msgctxt "text_id=13004 | speaker=unknown"
msgid "\"Anyway, all 'er that aside..."
msgstr "『まあ、それはそれとして。"

#. Occurrence 8DOT5:18720:13005: voice_id=BA0_8DOT5_0015; voice_prefix=BA0; voice_category=0; scene=8DOT5
#: 8DOT5:18720
msgctxt "text_id=13005 | speaker=unknown"
msgid "  Let's always remember this as 'The Dosh Affair' so that we never forget the gravel and grit Miss Aoko dragged herself through!\""
msgstr "　青子さんの空回りっぷりを忘れないよう、これをカーモネーギー事件として記録しとくッスね！』"

#. Occurrence 8DOT5:18726:13006: scene=8DOT5
#: 8DOT5:18726
msgctxt "text_id=13006 | speaker=unknown"
msgid "  The blue robin continued to laugh at that day's hero."
msgstr "　つぶらな瞳で、今日最大の功労者に笑いかける青い鳥。"

#. Occurrence 8DOT5:18775:13007: scene=8DOT5
#: 8DOT5:18775
msgctxt "text_id=13007 | speaker=unknown"
msgid "  Aoko flicked the bird away just as someone knocked at the door."
msgstr "　それを指先一つでバウンドさせた頃、玄関からのノックがあった。"

#. Occurrence 8DOT5:18809:13008: scene=8DOT5
#: 8DOT5:18809
msgctxt "text_id=13008 | speaker=unknown"
msgid "  Alice had ordered her favorite omelet dish and a set of cakes from the cafe."
msgstr "　有珠が頼んだメニューはお気に入りの洋食店のオムライスと、喫茶店からのケーキセット。"

#. Occurrence 8DOT5:18816:13009: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8DOT5_0190; voice_prefix=A10; voice_category=1; scene=8DOT5
#: 8DOT5:18816
msgctxt "text_id=13009 | speaker=aoko"
msgid "\"Might as well enjoy...\""
msgstr "「まあ、それなら―――」"

#. Occurrence 8DOT5:18822:13010: scene=8DOT5
#: 8DOT5:18822
msgctxt "text_id=13010 | speaker=unknown"
msgid "  Aoko was quietly satisfied with the spoils of an honest day's work."
msgstr "　労働の報酬にしては悪くない、と現代の魔女はこっそり気を取り直すのだった。"

#. Occurrence 9_0:47:13011: scene=9_0
#: 9_0:47
msgctxt "text_id=13011 | speaker=unknown"
msgid "  December, the month when even monks were busy at work."
msgstr "　師匠も走る十二月。"

#. Occurrence 9_0:52:13012: scene=9_0
#: 9_0:52
msgctxt "text_id=13012 | speaker=unknown"
msgid "  It was the culmination of the year."
msgstr "　一年の総決算。"

#. Occurrence 9_0:57:13013: scene=9_0
#: 9_0:57
msgctxt "text_id=13013 | speaker=unknown"
msgid "  Perhaps due to all the put-off tasks built up through the seasons, the month always seemed to pass by in the blink of an eye."
msgstr "　やり残しを溜めに溜めた<不始末|ふしまつ>故か、<師走|しわす>の月日は<瞬|またた>く間に過ぎ去っていく。"

#. Occurrence 9_0:79:13014: scene=9_0
#: 9_0:79
msgctxt "text_id=13014 | speaker=unknown"
msgid "  It was a day^ like any other in December."
msgstr "　時に十二月某日。"

#. Occurrence 9_0:84:13015: scene=9_0
#: 9_0:84
msgctxt "text_id=13015 | speaker=unknown"
msgid "  Though none of them were any the wiser to what the others were doing, Aoko, Alice, and Soujyuro had spent the day attending to their own affairs."
msgstr "　何をやっているんだか互いに不明であるが、青子も有珠も草十郎も、忙しげな毎日を過ごしていた。"

#. Occurrence 9_0:137:13016: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0000; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:137
msgctxt "text_id=13016 | speaker=aoko"
msgid "\"What...is this?\""
msgstr "「なに、コレ」"

#. Occurrence 9_0:161:13017: scene=9_0
#: 9_0:161
msgctxt "text_id=13017 | speaker=unknown"
msgid "  Aoko kept the urge to kill out of her voice, but her menacing tone still reverberated in the room."
msgstr "　殺意を押し殺した、険悪<極|きわ>まりない声が響く。"

#. Occurrence 9_0:194:13018: scene=9_0
#: 9_0:194
msgctxt "text_id=13018 | speaker=unknown"
msgid "  The sunroom was often used to dine in when the weather was nice, since it overlooked the courtyard."
msgstr "　サンルームは中庭を一望できるため、天気の良い日など食堂として使われる。"

#. Occurrence 9_0:199:13019: scene=9_0
#: 9_0:199
msgctxt "text_id=13019 | speaker=unknown"
msgid "  It was a room decorated with high-quality furniture and upholstery befitting an historic western style mansion."
msgstr "　歴史のある洋館に相応しい、家具も内装も一級品で纏められた空間である。"

#. Occurrence 9_0:228:13020: scene=9_0
#: 9_0:228
msgctxt "text_id=13020 | speaker=unknown"
msgid "  The fusion of Chinese Chippendale aesthetics and traditional English Georgian elegance caused even Aoko, a commoner, to think twice about doing anything \"unaristocratic\" on the grounds."
msgstr "　中国風の様式美を混ぜ合わせたチッペンデール式と、スマートながら英国の歴史を受け継ぐジョージアン式との融合は、庶民である青子ですら“ここでの非貴族的行為は自粛しよう”と誓わせる程だ。"

#. Occurrence 9_0:233:13021: scene=9_0
#: 9_0:233
msgctxt "text_id=13021 | speaker=unknown"
msgid "  Truthfully, she was sickened by the flagrant waste of money, but none of it was paid for out of her pocket, so she could have cared less what the purchaser spent their money on."
msgstr "　正直なところ<無|む><駄|だ><遣|づか>い以外の何物でもないと呆れもしているが、自分の財布が痛んだ訳でもないのでいいぞもっとやれ、という心境でもある。"

#. Occurrence 9_0:253:13022: scene=9_0
#: 9_0:253
msgctxt "text_id=13022 | speaker=unknown"
msgid "  Three unbelievably out-of-place offerings sat atop the lavish sunroom's table, as if enshrined."
msgstr "　そんな高級感あふれるサンルームのテーブルに、目を疑う異物が三つ、鎮座していた。"

#. Occurrence 9_0:271:13023: scene=9_0
#: 9_0:271
msgctxt "text_id=13023 | speaker=unknown"
msgid "  In stark contrast to the room, they appeared like meals prepared by aliens."
msgstr "　この部屋で見ると、得体の知れない宇宙食に見えなくもない。"

#. Occurrence 9_0:297:13024: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0001; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:297
msgctxt "text_id=13024 | speaker=aoko"
msgid "\"Soujyuro. Is this your idea of a practical joke?\""
msgstr "「草十郎。これ、なんか新しい冗談？」"

#. Occurrence 9_0:303:13025: scene=9_0
#: 9_0:303
msgctxt "text_id=13025 | speaker=unknown"
msgid "  Aoko's trembling fists clenched and unclenched, as she questioned the one responsible for today's menu."
msgstr "　ふるふると<片手|かたて><拳|こぶし>を震わせながら、青子は今日の食事当番に問いかける。"

#. Occurrence 9_0:308:13026: scene=9_0
#: 9_0:308
msgctxt "text_id=13026 | speaker=unknown"
msgid "  The clock struck nine in the evening."
msgstr "　時刻は午後九時。"

#. Occurrence 9_0:313:13027: scene=9_0
#: 9_0:313
msgctxt "text_id=13027 | speaker=unknown"
msgid "  Tonight's executive chef nodded dutifully, eager to explain."
msgstr "　夕食を用意したシェフはうん、と素直に頷いた。"

#. Occurrence 9_0:347:13028: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0000; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:347
msgctxt "text_id=13028 | speaker=soujuurou"
msgid "\"It's a new product from my workplace."
msgstr "「コレはうちの会社の新製品。"

#. Occurrence 9_0:353:13029: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0001; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:353
msgctxt "text_id=13029 | speaker=soujuurou"
msgid "  Kinomi said it looks and tastes fake, but honestly I think it's better than the real thing."
msgstr "　パチモンくさいが中身はほんとにパチモンだ、と木乃美が言ってた。でも俺は本物よりいいと思う。"

#. Occurrence 9_0:364:13030: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0002; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:364
msgctxt "text_id=13030 | speaker=soujuurou"
msgid "  Besides, they're only forty yen each after the company discount."
msgstr "　そんなコトより評価すべきは、社内販売なんで一個四十円をきる低価格だ。"

#. Occurrence 9_0:371:13031: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0003; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:371
msgctxt "text_id=13031 | speaker=soujuurou"
msgid "A steal, right? Even with the egg on top it's still only sixty yen or so.\""
msgstr "すごいぞ、卵をつけても六十円とか」"

#. Occurrence 9_0:390:13032: scene=9_0
#: 9_0:390
msgctxt "text_id=13032 | speaker=unknown"
msgid "  The corner-cutting chef seemed pleased with himself."
msgstr "　驚きだ、と感心する手抜きシェフ。"

#. Occurrence 9_0:405:13033: scene=9_0
#: 9_0:405
msgctxt "text_id=13033 | speaker=unknown"
msgid "  Aoko wanted to grumble that the real steal was her appetite."
msgstr "　そりゃ誰だって驚くわ、とひとり吐き捨てる青子だった。"

#. Occurrence 9_0:426:13034: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0002; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:426
msgctxt "text_id=13034 | speaker=aoko"
msgid "\"Well, isn't that nice for you."
msgstr "「そう、良かったわね。"

#. Occurrence 9_0:432:13035: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0003; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:432
msgctxt "text_id=13035 | speaker=aoko"
msgid "  Now, where's tonight's dinner?\""
msgstr "　ところで今日の夕飯はどこにあるの？」"

#. Occurrence 9_0:461:13036: scene=9_0
#: 9_0:461
msgctxt "text_id=13036 | speaker=unknown"
msgid "  Chef Soujyuro thought for a second or two, then clapped his hands together in realization."
msgstr "　シェフは二秒ほど考えこんで、ぽん、と両手を合わせた。"

#. Occurrence 9_0:472:13037: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0004; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:472
msgctxt "text_id=13037 | speaker=soujuurou"
msgid "\"Aozaki, you know if you eat too much you'll get fat.\""
msgstr "「蒼崎、そんなに食べると太るよ」"

#. Occurrence 9_0:514:13038: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0004; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:514
msgctxt "text_id=13038 | speaker=aoko"
msgid "\"So what you're telling me is..."
msgstr "「つまり、"

#. Occurrence 9_0:514:13039: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0004; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:514
msgctxt "text_id=13039 | speaker=aoko"
msgid "  This slop is what you call dinner!?\""
msgstr "　これが夕飯だって言い張る気なのねアンタはーっ！」"

#. Occurrence 9_0:527:13040: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0005; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:527
msgctxt "text_id=13040 | speaker=soujuurou"
msgid "\"No complaints. I'm not making anything else.\""
msgstr "「言い張るも何も、これ以外用意していない」"

#. Occurrence 9_0:561:13041: scene=9_0
#: 9_0:561
msgctxt "text_id=13041 | speaker=unknown"
msgid "  The two stood there, glaring at each other."
msgstr "　ふたりはそこで睨み合う。"

#. Occurrence 9_0:566:13042: scene=9_0
#: 9_0:566
msgctxt "text_id=13042 | speaker=unknown"
msgid "  Aoko gave off an air that said she would rather die than eat his \"food,\""
msgstr "　青子はこんなもの食べるものかと徹底抗戦の意を示し、"

#. Occurrence 9_0:571:13043: scene=9_0
#: 9_0:571
msgctxt "text_id=13043 | speaker=unknown"
msgid "  while Soujyuro was convinced she would capitulate eventually."
msgstr "　草十郎は食べてもらえる事を大前提と信じており、"

#. Occurrence 9_0:576:13044: scene=9_0
#: 9_0:576
msgctxt "text_id=13044 | speaker=unknown"
msgid "  He even considered chiding her for being a picky eater."
msgstr "　あまつさえ、好き嫌いはいけないぞ、なんて教育理念まで持ち始めていた。"

#. Occurrence 9_0:581:13045: scene=9_0
#: 9_0:581
msgctxt "text_id=13045 | speaker=unknown"
msgid "  As usual, the two could not see eye to eye."
msgstr "　相変わらず両者の思考は噛み合わない。"

#. Occurrence 9_0:613:13046: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0005; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:613
msgctxt "text_id=13046 | speaker=aoko"
msgid "\"No way. There's no way I'm eating... whatever this is.\""
msgstr "「イヤ。私は食べないからね、こんなの」"

#. Occurrence 9_0:630:13047: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0006; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:630
msgctxt "text_id=13047 | speaker=soujuurou"
msgid "\"Don't be such a spoiled princess. Besides, tonight's dinner only cost two hundred yen for the three of us.\""
msgstr "「お姫さまみたいなこと言うんじゃない。大体、今日の夕食代はこれで三名さま二百円未満なんだぞ」"

#. Occurrence 9_0:636:13048: scene=9_0
#: 9_0:636
msgctxt "text_id=13048 | speaker=unknown"
msgid "  Soujyuro puffed his chest out at his penny-pinching prowess."
msgstr "　けいざい的だ、と胸を張る草十郎。"

#. Occurrence 9_0:698:13049: scene=9_0
#: 9_0:698
msgctxt "text_id=13049 | speaker=unknown"
msgid "  Alice alternated her gaze between the two quarreling roommates and the strange food before her, which she had also never seen before. She remained a mere bystander in all this."
msgstr "　有珠はふたりの言い合いと、目前に置かれた未知の食器……実物を見るのは初めてらしい……を交互に眺めていた。もはや完全に傍観者である。"

#. Occurrence 9_0:735:13050: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0006; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:735
msgctxt "text_id=13050 | speaker=aoko"
msgid "\"U-unbelievable... a sixty-yen meal for one person? What year is it!?"
msgstr "「し、信じられない……ひとり六十円の食事って、アンタ一体いつの生まれよ!?"

#. Occurrence 9_0:742:13051: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0007; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:742
msgctxt "text_id=13051 | speaker=aoko"
msgid "  These days, even cheap beef bowl places spend more on ingredients!\""
msgstr "　このご時世、新しくできた牛丼屋ですら贅沢に原価あげてるわよ、ばか！」"

#. Occurrence 9_0:755:13052: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0007; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:755
msgctxt "text_id=13052 | speaker=soujuurou"
msgid "\"...Aozaki. If we ate the way you wanted with only thirty thousand yen for food each month, I'm pretty sure we would all starve to death before you two could kill me.\""
msgstr "「…………蒼崎。一ヶ月の食費が三万円だけで、あんな好き勝手な食生活をしていたら、俺が君たちに殺される前に全員が飢え死ぬと思うんだ」"

#. Occurrence 9_0:814:13053: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0008; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:814
msgctxt "text_id=13053 | speaker=soujuurou"
msgid "\"I mean, sure, the meat Alice cooked yesterday was really something."
msgstr "「たしかに昨日の有珠の肉料理は素晴らしかった。"

#. Occurrence 9_0:820:13054: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0009; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:820
msgctxt "text_id=13054 | speaker=soujuurou"
msgid "  I was impressed at the difference in quality at seven hundred yen per ounce."
msgstr "　グラム七百円から肉は種類が変わるんだって感動した。"

#. Occurrence 9_0:826:13055: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0010; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:826
msgctxt "text_id=13055 | speaker=soujuurou"
msgid "  Even the 100% juice from the co-op made me rethink the idea of fresh food."
msgstr "　生協の果汁百パーセントジュースだって、ちょっと本気で馬鹿にできるもんじゃないと反省したよ。"

#. Occurrence 9_0:836:13056: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0011; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:836
msgctxt "text_id=13056 | speaker=soujuurou"
msgid "  But, if we keep eating like we have for the last three days, we'll go broke.\""
msgstr "　けど、あれが三日続いたらこの家はどうなってしまうんだい？」"

#. Occurrence 9_0:856:13057: scene=9_0
#: 9_0:856
msgctxt "text_id=13057 | speaker=unknown"
msgid "  Soujyuro was making perfect sense, for once."
msgstr "　珍しく常識的な事を口にする草十郎。"

#. Occurrence 9_0:861:13058: scene=9_0
#: 9_0:861
msgctxt "text_id=13058 | speaker=unknown"
msgid "  Fortunately, neither Aoko nor Soujyuro noticed the silent stare of disapproval coming from Alice."
msgstr "　ひっそりと抗議の眼差しを向ける有珠だが、幸い、青子も草十郎も気付かなかった。"

#. Occurrence 9_0:901:13059: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0008; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:901
msgctxt "text_id=13059 | speaker=aoko"
msgid "\"We'll cross that bridge when we come to it."
msgstr "「その時はその時よ。"

#. Occurrence 9_0:907:13060: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0009; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:907
msgctxt "text_id=13060 | speaker=aoko"
msgid "  And I should note, a meal like yesterday's was a rarity. But maybe I should thank you, since your meals have inspired Alice to put some effort into hers for a change!\""
msgstr "　それにね、昨日みたいなのは滅多にないの。有珠はアンタの料理に触発されて柄にもなく頑張ったみたいだけど！」"

#. Occurrence 9_0:925:13061: scene=9_0
#: 9_0:925
msgctxt "text_id=13061 | speaker=unknown"
msgid "  With Aoko's words, Alice closed her eyes."
msgstr "　青子の言葉に、有珠は静かに瞳を閉じる。"

#. Occurrence 9_0:930:13062: scene=9_0
#: 9_0:930
msgctxt "text_id=13062 | speaker=unknown"
msgid "  ...She might have been trying to quell her anger."
msgstr "　……もしかすると、ああして怒りを抑えているのかもしれない。"

#. Occurrence 9_0:963:13063: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0012; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:963
msgctxt "text_id=13063 | speaker=soujuurou"
msgid "\"You astonish me, you know. How did you even get by before me?\""
msgstr "「……信じられない。じゃあ、今までどんな生活してたんだ、蒼崎たちは」"

#. Occurrence 9_0:982:13064: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0010; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:982
msgctxt "text_id=13064 | speaker=aoko"
msgid "\"We made it work, thank you very much. Besides, living life one step from starvation keeps you on your toes.\""
msgstr "「その時は、それぞれでなんとかやってたわ。飢え死に一歩手前ぐらい、いい精神修行じゃない」"

#. Occurrence 9_0:988:13065: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0013; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:988
msgctxt "text_id=13065 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 9_0:993:13066: scene=9_0
#: 9_0:993
msgctxt "text_id=13066 | speaker=unknown"
msgid "  Her brazen response left him speechless."
msgstr "　あまりの潔さに絶句する。"

#. Occurrence 9_0:1031:13067: scene=9_0
#: 9_0:1031
msgctxt "text_id=13067 | speaker=unknown"
msgid "  Though a story for another time, Soujyuro remembered a warning from a certain vice president who had complained about a certain president incessantly bugging him to take her to lunch at the end of the month."
msgstr "　……また、これは後の話ではあるが、月の終わりになると頻繁に某会長が昼食をおごらせにやってくる、と某副会長は告発するのだった。"

#. Occurrence 9_0:1037:13068: scene=9_0
#: 9_0:1037
msgctxt "text_id=13068 | speaker=unknown"
msgid "  But that was neither here nor there."
msgstr "　それはともかくとして。"

#. Occurrence 9_0:1071:13069: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0011; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:1071
msgctxt "text_id=13069 | speaker=aoko"
msgid "\"That was then, and this is now!"
msgstr "「そんな昔のコトより今のコト！"

#. Occurrence 9_0:1077:13070: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0012; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:1077
msgctxt "text_id=13070 | speaker=aoko"
msgid "  Where are those cooking skills you displayed before, Soujyuro!? That's the only reason I trusted you with today's meal!\""
msgstr "　前に見せたあの腕はどこにいったのよ草十郎!?　あれを見こんで今日の夕飯を任せたっていうのに！」"

#. Occurrence 9_0:1083:13071: scene=9_0
#: 9_0:1083
msgctxt "text_id=13071 | speaker=unknown"
msgid "  Out of everything, that seemed to be what ate at Aoko the most."
msgstr "　……なんだかんだと、青子はそれが一番悔しいらしい。"

#. Occurrence 9_0:1088:13072: scene=9_0
#: 9_0:1088
msgctxt "text_id=13072 | speaker=unknown"
msgid "  The stir-fried yaki-udon he had prepared previously had been very well received. It had even melted away Aoko's morning grumpiness with just one bite."
msgstr "　あの時の焼きうどんはいたく好評で、起きたばかりの青子の不機嫌っぷりは一口で解消してしまったほどだ。"

#. Occurrence 9_0:1108:13073: scene=9_0
#: 9_0:1108
msgctxt "text_id=13073 | speaker=unknown"
msgid "  However, Soujyuro had not seen fit to tell them that it was one of the only dishes in his limited repertoire."
msgstr "　しかし草十郎は、あれが数少ないレパートリーの一つだという事を語っていない。"

#. Occurrence 9_0:1113:13074: scene=9_0
#: 9_0:1113
msgctxt "text_id=13074 | speaker=unknown"
msgid "  For a bachelor, the ability to cook is as close to a superpower as one could get."
msgstr "　男料理とは、基本的に<独身|ひとり>に<唯一|ひとつ>の<異能力|レシピ>なのだ。"

#. Occurrence 9_0:1118:13075: scene=9_0
#: 9_0:1118
msgctxt "text_id=13075 | speaker=unknown"
msgid "  Fifteen years into the future, it would likely become a highly desirable trait."
msgstr "　あと十五年ぐらいしたら流行りそうな特殊能力みたいなもんである。"

#. Occurrence 9_0:1153:13076: scene=9_0
#: 9_0:1153
msgctxt "text_id=13076 | speaker=unknown"
msgid "  Regardless, that misunderstanding had led Aoko and Alice to overestimate Soujyuro's culinary talents."
msgstr "　以上の誤解から、有珠と青子は草十郎の料理技術を過大評価していたりする。"

#. Occurrence 9_0:1158:13077: scene=9_0
#: 9_0:1158
msgctxt "text_id=13077 | speaker=unknown"
msgid "  Her ire finally made sense to Soujyuro."
msgstr "　そこに原因があったのか、と納得する草十郎。"

#. Occurrence 9_0:1193:13078: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0014; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:1193
msgctxt "text_id=13078 | speaker=soujuurou"
msgid "\"...All right. Fine. We can order in. There's nothing here to cook anyway."
msgstr "「……分かった、自腹を切るから出前をとろう。作るにしても材料がないからな。"

#. Occurrence 9_0:1204:13079: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_0_0015; voice_prefix=A30; voice_category=3; scene=9_0
#: 9_0:1204
msgctxt "text_id=13079 | speaker=soujuurou"
msgid "  But only if you clear up.\""
msgstr "　そのかわり、それは回収する」"

#. Occurrence 9_0:1230:13080: scene=9_0
#: 9_0:1230
msgctxt "text_id=13080 | speaker=unknown"
msgid "  Aoko basked in her victory."
msgstr "　うむ、と自らの勝利を喜ぶ青子。"

#. Occurrence 9_0:1266:13081: scene=9_0
#: 9_0:1266
msgctxt "text_id=13081 | speaker=unknown"
msgid "  It was then, after seeing Soujyuro's face as he went to fetch the delivery menu, Aoko realized her misreading of him."
msgstr "　が。出前の献立を取りに行く草十郎の顔を見て、青子は自分の勘違いに気付いてしまった。"

#. Occurrence 9_0:1271:13082: scene=9_0
#: 9_0:1271
msgctxt "text_id=13082 | speaker=unknown"
msgid "  What annoyed Aoko most was the fact that such little effort was put into dinner."
msgstr "　青子がカチンときたのは、夕食に手を抜くとは何事か、という点が大きい。"

#. Occurrence 9_0:1276:13083: scene=9_0
#: 9_0:1276
msgctxt "text_id=13083 | speaker=unknown"
msgid "  But to Soujyuro, this dinner had not been about cutting corners, but rather about a meal he had legitimately wanted to try."
msgstr "　けれど草十郎にとって、この夕食は手抜きでもなんでもなく、本気で食べてみたかったのだろう。"

#. Occurrence 9_0:1309:13084: scene=9_0
#: 9_0:1309
msgctxt "text_id=13084 | speaker=unknown"
msgid "  Aoko ruminated on how it could probably pass as food for someone raised in the mountains."
msgstr "　山育ちはこういう物でも喜ぶのか、と青子はつくづく感心する。"

#. Occurrence 9_0:1314:13085: scene=9_0
#: 9_0:1314
msgctxt "text_id=13085 | speaker=unknown"
msgid "  ...And then."
msgstr "　……と。"

#. Occurrence 9_0:1341:13086: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0013; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:1341
msgctxt "text_id=13086 | speaker=aoko"
msgid "\"...? Alice, what are you doing?\""
msgstr "「……？　有珠、何してるの？」"

#. Occurrence 9_0:1347:13087: scene=9_0
#: 9_0:1347
msgctxt "text_id=13087 | speaker=unknown"
msgid "  Aoko noticed Alice standing near the table, holding one of the bowls tightly."
msgstr "　青子はようやく、有珠がテーブルに近寄り、しっかりとどんぶりを持っている事に気がついた。"

#. Occurrence 9_0:1378:13088: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0014_A; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:1378
msgctxt "text_id=13088 | speaker=aoko"
msgid "\"Would you put that down already?"
msgstr "「もうそれはいいんだってば。"

#. Occurrence 9_0:1384:13089: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_0_0015; voice_prefix=A10; voice_category=1; scene=9_0
#: 9_0:1384
msgctxt "text_id=13089 | speaker=aoko"
msgid "  I need to give those back to Soujyuro so we can eat a proper meal.\""
msgstr "　草十郎に返して、きちんとした出前にしましょ」"

#. Occurrence 9_0:1404:13090: scene=9_0
#: 9_0:1404
msgctxt "text_id=13090 | speaker=unknown"
msgid "  Despite Aoko's words, Alice stood her ground, firmly clutching the bowl."
msgstr "　青子に言われても、有珠はどんぶりから手を離さない。"

#. Occurrence 9_0:1409:13091: scene=9_0
#: 9_0:1409
msgctxt "text_id=13091 | speaker=unknown"
msgid "  In fact, she seemed to be embracing it."
msgstr "　むしろ抱くように持ちあげ、"

#. Occurrence 9_0:1420:13092: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_0_0000; voice_prefix=A40; voice_category=2; scene=9_0
#: 9_0:1420
msgctxt "text_id=13092 | speaker=alice"
msgid "\"This one is mine.\""
msgstr "「これ、わたしのだから」"

#. Occurrence 9_0:1442:13093: scene=9_0
#: 9_0:1442
msgctxt "text_id=13093 | speaker=unknown"
msgid "  Alice's faint voice drifted across the sunroom."
msgstr "　静かな有珠の声が、閑散としたサンルームに響きわたる。"

#. Occurrence 9_0:1465:13094: scene=9_0
#: 9_0:1465
msgctxt "text_id=13094 | speaker=unknown"
msgid "  And just like that, the night's menu had been decided by majority rule."
msgstr "　どうやら多数決によって、今夜の献立は決定したらしい。"

#. Occurrence 9_0:1470:13095: scene=9_0
#: 9_0:1470
msgctxt "text_id=13095 | speaker=unknown"
msgid "  Aoko's shoulders sank in disappointment at her lot that evening."
msgstr "　まさかそんな、と青子は力なく肩を落とす。"

#. Occurrence 9_0:1475:13096: scene=9_0
#: 9_0:1475
msgctxt "text_id=13096 | speaker=unknown"
msgid "  Come to think of it, Alice was always peculiar about things she deemed \"hers.\""
msgstr "　そういえば、有珠の『自分の物』に対する執着心は異常なものがあったなぁ、と思い返しながら。"

#. Occurrence 9_1:50:13097: scene=9_1
#: 9_1:50
msgctxt "text_id=13097 | speaker=unknown"
msgid "  It was morning, and there were ten days left in December."
msgstr "　十二月も残すところ十日をきった朝。"

#. Occurrence 9_1:67:13098: scene=9_1
#: 9_1:67
msgctxt "text_id=13098 | speaker=unknown"
msgid "  While the rest of the city was preparing for Christmas festivities, Soujyuro headed to his part-time job."
msgstr "　もうじきクリスマスと浮かれる町並みに逆行するように、草十郎はアルバイトに向かっていた。"

#. Occurrence 9_1:72:13099: scene=9_1
#: 9_1:72
msgctxt "text_id=13099 | speaker=unknown"
msgid "  Though it looked like it could snow at any minute, the tree-lined streets were busy with foot traffic."
msgstr "　今にも雪が降ってきそうな空の下、並木道は鮮やかに賑わっている。"

#. Occurrence 9_1:77:13100: scene=9_1
#: 9_1:77
msgctxt "text_id=13100 | speaker=unknown"
msgid "  These days were particularly merry."
msgstr "　ここ数日は特に華やかだ。"

#. Occurrence 9_1:82:13101: scene=9_1
#: 9_1:82
msgctxt "text_id=13101 | speaker=unknown"
msgid "  Students on winter break spent their days hanging out with friends while they counted down the days until the holidays."
msgstr "　冬休みの学生たちは日々親しい友人と顔を合わせ、間近に迫ったイベントを指折り数えて待っている。"

#. Occurrence 9_1:110:13102: scene=9_1
#: 9_1:110
msgctxt "text_id=13102 | speaker=unknown"
msgid "  Colorful Christmas cakes lined storefronts, placed like charms to ward off evil."
msgstr "　魔よけのお札のように乱立する特製ケーキの見出し。"

#. Occurrence 9_1:115:13103: scene=9_1
#: 9_1:115
msgctxt "text_id=13103 | speaker=unknown"
msgid "  Huge advertisements adorned the sides of buildings."
msgstr "　ビルの壁一面に貼られた巨大広告。"

#. Occurrence 9_1:120:13104: scene=9_1
#: 9_1:120
msgctxt "text_id=13104 | speaker=unknown"
msgid "  The station plaza bustled with pop-up stalls."
msgstr "　駅前広場に集まった数々の露店。"

#. Occurrence 9_1:149:13105: scene=9_1
#: 9_1:149
msgctxt "text_id=13105 | speaker=unknown"
msgid "  Soujyuro stepped out of the milling crowd and into a phone booth."
msgstr "　そういった都会の町の賑わいを横目に、草十郎は電話ボックスに入る。"

#. Occurrence 9_1:154:13106: scene=9_1
#: 9_1:154
msgctxt "text_id=13106 | speaker=unknown"
msgid "  Safe from the winter wind, the inside seemed warm by comparison."
msgstr "　中も冷えきっていたが、冬の風が入らないだけ暖かい。"

#. Occurrence 9_1:172:13107: scene=9_1
#: 9_1:172
msgctxt "text_id=13107 | speaker=unknown"
msgid "  The thought that it would actually be nice to have one in the mountains "
msgstr "　雪山にこういうのを置いたら便利なんじゃないか、などと思いつつ、"

msgctxt "text_id=13108 | speaker=unknown"
msgid "crossed his mind as he inserted a coin into the phone."
msgstr "草十郎は電話に十円玉を投入する。"

#. Occurrence 9_1:195:13109: scene=9_1
#: 9_1:195
msgctxt "text_id=13109 | speaker=unknown"
msgid "  He dialed a number from memory, his fingers punching the keys with a somewhat practiced motion."
msgstr "　それなりに慣れた手つきで、暗記したナンバーをプッシュする。"

#. Occurrence 9_1:200:13110: scene=9_1
#: 9_1:200
msgctxt "text_id=13110 | speaker=unknown"
msgid "  After about five seconds, the phone began to ring."
msgstr "　コールが鳴るまで約五秒。"

#. Occurrence 9_1:206:13111: scene=9_1
#: 9_1:206
msgctxt "text_id=13111 | speaker=unknown"
msgid "  Another five seconds, another ring..."
msgstr "　コールが鳴ってから、またも五秒。"

#. Occurrence 9_1:225:13112: scene=9_1
#: 9_1:225
msgctxt "text_id=13112 | speaker=unknown"
msgid "  Ten seconds had passed."
msgstr "　十秒間の待ち時間。"

#. Occurrence 9_1:230:13113: scene=9_1
#: 9_1:230
msgctxt "text_id=13113 | speaker=unknown"
msgid "  He gazed through the window at the various signs on the surrounding buildings, and marveled at the sheer number of people out and about so early."
msgstr "　電話ボックスからビルの壁に飾られた広告を見上げて、今さらながら人々の多種多様さに感心したりする。"

#. Occurrence 9_1:250:13114: scene=9_1
#: 9_1:250
msgctxt "text_id=13114 | speaker=unknown"
msgid "  The number he dialed was that of Tobimaru Tsukiji."
msgstr "　電話番号は槻司鳶丸のものである。"

#. Occurrence 9_1:255:13115: scene=9_1
#: 9_1:255
msgctxt "text_id=13115 | speaker=unknown"
msgid "  The Tsukiji name was well-known in Misaki as a distinguished landowning family going back generations."
msgstr "　槻司家は三咲市に深く関わりのある家―――古くからの地主、名家であるらしい。"

#. Occurrence 9_1:260:13116: scene=9_1
#: 9_1:260
msgctxt "text_id=13116 | speaker=unknown"
msgid "  Incidentally, their residence was located in the neighboring town of Yashirogi."
msgstr "　その豪邸は隣町である<社木|やしろぎ>にある。"

#. Occurrence 9_1:278:13117: scene=9_1
#: 9_1:278
msgctxt "text_id=13117 | speaker=unknown"
msgid "  A kind, elderly female voice finally replaced the ringtone."
msgstr "　呼び出し音に取ってかわったのは、感じの良い初老の婦人の声だった。"

#. Occurrence 9_1:283:13118: scene=9_1
#: 9_1:283
msgctxt "text_id=13118 | speaker=unknown"
msgid "  After her polite greeting, she handed over the phone to Soujyuro's target."
msgstr "　婦人は丁寧な挨拶の後、目的の人物に繋げてくれた。"

#. Occurrence 9_1:304:13119: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_1_0000; voice_prefix=A30; voice_category=3; scene=9_1
#: 9_1:304
msgctxt "text_id=13119 | speaker=soujuurou"
msgid "\"Morning, Tobimaru.\""
msgstr "「おはよう、鳶丸」"

#. Occurrence 9_1:310:13120: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_9_1_0000; voice_prefix=B70; voice_category=4; scene=9_1
#: 9_1:310
msgctxt "text_id=13120 | speaker=tobimaru"
msgid "\"'Ey. Mornin'.\""
msgstr "『……あい、おはよう』"

#. Occurrence 9_1:315:13121: scene=9_1
#: 9_1:315
msgctxt "text_id=13121 | speaker=unknown"
msgid "  He was still half-asleep, or so it sounded to Soujyuro."
msgstr "　寝惚けているのか、そんな返答が受話器ごしに返される。"

#. Occurrence 9_1:321:13122: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_1_0001; voice_prefix=A30; voice_category=3; scene=9_1
#: 9_1:321
msgctxt "text_id=13122 | speaker=soujuurou"
msgid "\"I need to ask you something. Do you have a second?\""
msgstr "「ひとつ相談があるんだけど、いいか？」"

#. Occurrence 9_1:327:13123: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_9_1_0001; voice_prefix=B70; voice_category=4; scene=9_1
#: 9_1:327
msgctxt "text_id=13123 | speaker=tobimaru"
msgid "\"Mm. Speak.\""
msgstr "『うむ、よきにはからえ』"

#. Occurrence 9_1:357:13124: scene=9_1
#: 9_1:357
msgctxt "text_id=13124 | speaker=unknown"
msgid "  His response did not exactly inspire confidence in Soujyuro, but he cut right to the chase."
msgstr "　……大丈夫かなこの男、と不安に思いつつ、草十郎はまっすぐ本題を切りだした。"

#. Occurrence 9_1:363:13125: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_9_1_0002; voice_prefix=B70; voice_category=4; scene=9_1
#: 9_1:363
msgctxt "text_id=13125 | speaker=tobimaru"
msgid "\"...\""
msgstr "『………………』"

#. Occurrence 9_1:368:13126: scene=9_1
#: 9_1:368
msgctxt "text_id=13126 | speaker=unknown"
msgid "  There was a long pause."
msgstr "　しばらく無音。"

#. Occurrence 9_1:373:13127: scene=9_1
#: 9_1:373
msgctxt "text_id=13127 | speaker=unknown"
msgid "  He was hard to read from this end of the receiver."
msgstr "　受話器の向こうの副会長が、どんな呆れ顔をしているかは分からない。"

#. Occurrence 9_1:394:13128: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_9_1_0003; voice_prefix=B70; voice_category=4; scene=9_1
#: 9_1:394
msgctxt "text_id=13128 | speaker=tobimaru"
msgid "\"...This is what you wake me up for?"
msgstr "『……あのな、んな単純なコトで俺を起こすな。"

#. Occurrence 9_1:400:13129: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_9_1_0004; voice_prefix=B70; voice_category=4; scene=9_1
#: 9_1:400
msgctxt "text_id=13129 | speaker=tobimaru"
msgid "  Listen here, Soujyuro. If she's mad at you, take her out somewhere. Try to butter her up, show her a good time. If that doesn't do the trick, then cut her loose. What do you want me to say?\""
msgstr "　いいか草十郎。仲が悪けりゃ遊びに行け。機嫌をとりたきゃいいとこ見せろ。んで、それが合わなきゃ早めに手を切れ。俺ができるアドバイスはそんなもんだ』"

#. Occurrence 9_1:421:13130: scene=9_1
#: 9_1:421
msgctxt "text_id=13130 | speaker=unknown"
msgid "  And with a \"peace,\" Tobimaru hung up."
msgstr "　以上、と鳶丸は電話を切った。"

#. Occurrence 9_1:426:13131: scene=9_1
#: 9_1:426
msgctxt "text_id=13131 | speaker=unknown"
msgid "  It may have been ten in the morning to Soujyuro, but after dealing with what seemed like a six o'clock Tobimaru, all he could do nod earnestly."
msgstr "　もう朝の十時だというのに、まるで朝の六時のような鳶丸の対応に、うむ、と草十郎は真剣に頷いた。"

#. Occurrence 9_1:443:13132: scene=9_1
#: 9_1:443
msgctxt "text_id=13132 | speaker=unknown"
msgid "  He had a feeling his friend had just been trying to end the call, but deep down, he knew that the advice was sound."
msgstr "　適当にあしらわれた気はするが、たしかにそれは一番現実的な気がする、と感心しながら。"

#. Occurrence 9_2:52:13133: scene=9_2
#: 9_2:52
msgctxt "text_id=13133 | speaker=unknown"
msgid "  After the phone ordeal, Soujyuro finished up his shopping and returned to the mansion just before noon."
msgstr "　電話ボックスの一件から買い物を済ませ、正午前。"

#. Occurrence 9_2:57:13134: scene=9_2
#: 9_2:57
msgctxt "text_id=13134 | speaker=unknown"
msgid "  He was greeted by the sight of Aoko and Alice sitting in silent gloom."
msgstr "　草十郎が洋館に戻ると、青子と有珠は暗い面持ちで黙りこんでいた。"

#. Occurrence 9_2:77:13135: scene=9_2
#: 9_2:77
msgctxt "text_id=13135 | speaker=unknown"
msgid "  Though he was unsure of the circumstances, from the outside looking in, it seemed like the aftermath of an argument."
msgstr "　事情を知らない第三者が見れば喧嘩の後にしか見えない。"

#. Occurrence 9_2:107:13136: scene=9_2
#: 9_2:107
msgctxt "text_id=13136 | speaker=unknown"
msgid "  The silence was as deafening as a blizzard...or rather, the biting cold and stinging wind of it."
msgstr "　それは<吹雪|ふぶ>くような、チクチク痛いやらヒリヒリ寒いやらな、沈黙による暴力である。"

#. Occurrence 9_2:112:13137: scene=9_2
#: 9_2:112
msgctxt "text_id=13137 | speaker=unknown"
msgid "  One might also compare the drawing room to an enormous walk-in freezer."
msgstr "　居間は巨大な冷蔵庫と化している。"

#. Occurrence 9_2:117:13138: scene=9_2
#: 9_2:117
msgctxt "text_id=13138 | speaker=unknown"
msgid "  It would not have been surprising to look up and see icicles hanging from the ceiling."
msgstr "　ちょっと天井を見上げれば、<氷柱|つらら>が垂れていても不思議ではないぐらいだ。"

#. Occurrence 9_2:157:13139: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0000; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:157
msgctxt "text_id=13139 | speaker=soujuurou"
msgid "(They're at it again.)"
msgstr "“やっぱり、今日もか”"

#. Occurrence 9_2:169:13140: scene=9_2
#: 9_2:169
msgctxt "text_id=13140 | speaker=unknown"
msgid "  He felt like a zookeeper pained to see the raccoon and penguin at each other's throats."
msgstr "　アライグマとペンギンの仲違いに心痛める飼育員……"

msgctxt "text_id=13141 | speaker=unknown"
msgid " In fact, he had seen this literally happen the other day at his zoo janitor job,"
msgstr "つい先日、日雇いで動物園の清掃をしてきた草十郎である……"

msgctxt "text_id=13142 | speaker=unknown"
msgid " and now, he glanced between them like a zookeeper trying to gauge the animals' temper."
msgstr "のような顔つきで、草十郎は青子たちを流し見る。"

#. Occurrence 9_2:194:13143: scene=9_2
#: 9_2:194
msgctxt "text_id=13143 | speaker=unknown"
msgid "  Needless to say, the silence meant they were not fighting at this moment."
msgstr "　言うまでもなく、ふたりは喧嘩などしていない。"

#. Occurrence 9_2:199:13144: scene=9_2
#: 9_2:199
msgctxt "text_id=13144 | speaker=unknown"
msgid "  Dinner served as a respite from the conflict."
msgstr "　食事以外では終始この調子なだけだ。"

#. Occurrence 9_2:204:13145: scene=9_2
#: 9_2:204
msgctxt "text_id=13145 | speaker=unknown"
msgid "  Soujyuro was oblivious to the circumstances surrounding the quarrel, but their day-in day-out battles against the mysterious mage was clearly taking a toll."
msgstr "　<草十郎|じぶん>の知らないところでの問題――他所からやってきた魔術師との戦いは、日に日に厳しいものになっているらしい。"

#. Occurrence 9_2:225:13146: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0001; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:225
msgctxt "text_id=13146 | speaker=soujuurou"
msgid "(Not that Alice looks anything but grumpy.)"
msgstr "“もっとも、有珠はいつも通りだけど”"

#. Occurrence 9_2:246:13147: scene=9_2
#: 9_2:246
msgctxt "text_id=13147 | speaker=unknown"
msgid "  Across from the quiet and contemplative Aoko, Alice was reading an old book in her lap, as she was accustomed to."
msgstr "　瞑想っぽく口を閉ざしている青子に対して、有珠は古ぼけた本を両膝に置いて読む、いつものスタンスである。"

#. Occurrence 9_2:251:13148: scene=9_2
#: 9_2:251
msgctxt "text_id=13148 | speaker=unknown"
msgid "  The book seemed somehow heavier than the other ones."
msgstr "　違うところといえば、その本が今までの物より遥かに重そうな物であるコトぐらい。"

#. Occurrence 9_2:286:13149: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0002; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:286
msgctxt "text_id=13149 | speaker=soujuurou"
msgid "\"I'm home. Looks like I just missed the discussion.\""
msgstr "「ただいま。煮詰まってるな、ここんところ」"

#. Occurrence 9_2:291:13150: scene=9_2
#: 9_2:291
msgctxt "text_id=13150 | speaker=unknown"
msgid "  He greeted them as he took off his coat."
msgstr "　コートを脱ぎつつ青子たちに声をかける。"

#. Occurrence 9_2:307:13151: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_2_0000; voice_prefix=A10; voice_category=1; scene=9_2
#: 9_2:307
msgctxt "text_id=13151 | speaker=aoko"
msgid "\"If only. 'Discussion' implies progress."
msgstr "「煮詰まるぐらい事態が進んでるなら、まだ面白みもあるんでしょうけどね。"

#. Occurrence 9_2:318:13152: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_2_0001; voice_prefix=A10; voice_category=1; scene=9_2
#: 9_2:318
msgctxt "text_id=13152 | speaker=aoko"
msgid "  You're way off, Soujyuro.\""
msgstr "　今の誤用よ、草十郎」"

#. Occurrence 9_2:351:13153: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0003; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:351
msgctxt "text_id=13153 | speaker=soujuurou"
msgid "\"?\""
msgstr "「？」"

#. Occurrence 9_2:356:13154: scene=9_2
#: 9_2:356
msgctxt "text_id=13154 | speaker=unknown"
msgid "  Without quite knowing what Aoko was getting at, Soujyuro quizzically tilted his head."
msgstr "　青子の言わんとするところが分からず、草十郎は首をかしげる。"

#. Occurrence 9_2:361:13155: scene=9_2
#: 9_2:361
msgctxt "text_id=13155 | speaker=unknown"
msgid "  He told himself not to think too hard into it, but it only made him more curious."
msgstr "　考えすぎはよくないぞ、とリラックスさせるつもりが、逆に注意されてしまった。"

#. Occurrence 9_2:400:13156: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_2_0002; voice_prefix=A10; voice_category=1; scene=9_2
#: 9_2:400
msgctxt "text_id=13156 | speaker=aoko"
msgid "\"In fact, we're not even close to an agreement."
msgstr "「煮詰まってるってコトはもうじき完成ってコトでしょ。"

#. Occurrence 9_2:406:13157: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_2_0003; voice_prefix=A10; voice_category=1; scene=9_2
#: 9_2:406
msgctxt "text_id=13157 | speaker=aoko"
msgid "  If anything, I'd say we've debated ourselves into a corner.\""
msgstr "　進展がないって意味合いなら、行き詰まってると言うべきね」"

#. Occurrence 9_2:418:13158: scene=9_2
#: 9_2:418
msgctxt "text_id=13158 | speaker=unknown"
msgid "  Seemingly too preoccupied to scold Soujyuro, Aoko waved her hand as though shooing off an insect."
msgstr "　草十郎を叱る余裕もないのか、青子は邪険に手を振って“余所にいってて”とジェスチャーする。"

#. Occurrence 9_2:423:13159: scene=9_2
#: 9_2:423
msgctxt "text_id=13159 | speaker=unknown"
msgid "  But Soujyuro being Soujyuro..."
msgstr "　無論、"

#. Occurrence 9_2:457:13160: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0004; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:457
msgctxt "text_id=13160 | speaker=soujuurou"
msgid "\"Okay, let me start over."
msgstr "「じゃあ言い直して。"

#. Occurrence 9_2:463:13161: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0005; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:463
msgctxt "text_id=13161 | speaker=soujuurou"
msgid "  Hey, you two. Any progress since last time?\""
msgstr "　やあ、あれから進展はあったかい？」"

#. Occurrence 9_2:469:13162: scene=9_2
#: 9_2:469
msgctxt "text_id=13162 | speaker=unknown"
msgid "  Soujyuro held his ground."
msgstr "　それぐらいでめげる草十郎ではないのだった。"

#. Occurrence 9_2:502:13163: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_2_0004; voice_prefix=A10; voice_category=1; scene=9_2
#: 9_2:502
msgctxt "text_id=13163 | speaker=aoko"
msgid "\"That's none of your business."
msgstr "「草十郎には関係ないわ。"

#. Occurrence 9_2:508:13164: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_2_0005; voice_prefix=A10; voice_category=1; scene=9_2
#: 9_2:508
msgctxt "text_id=13164 | speaker=aoko"
msgid "  What did l tell you? Mage affairs are not for your ears.\""
msgstr "　<魔術|こっち>の事情に関しては不可侵だって、言わなかった？」"

#. Occurrence 9_2:514:13165: scene=9_2
#: 9_2:514
msgctxt "text_id=13165 | speaker=unknown"
msgid "  Her response was calm, but pointed."
msgstr "　静かではあるがトゲのある返答。"

#. Occurrence 9_2:519:13166: scene=9_2
#: 9_2:519
msgctxt "text_id=13166 | speaker=unknown"
msgid "  Surliness was her weapon of choice, and today she seemed determined to swing it at will."
msgstr "　ご機嫌斜めなのはいつものコトだが、今日は六割増しのようだ。"

#. Occurrence 9_2:554:13167: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0006; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:554
msgctxt "text_id=13167 | speaker=soujuurou"
msgid "\"Yes, I remember. ...Did you two eat yet?\""
msgstr "「もちろん聞いてる。ところで、お昼はまだだろう？」"

#. Occurrence 9_2:560:13168: scene=9_2
#: 9_2:560
msgctxt "text_id=13168 | speaker=unknown"
msgid "  Soujyuro chose to brush off Aoko's attitude."
msgstr "　そんな青子の不機嫌さも気にせず、草十郎は食い下がった。"

#. Occurrence 9_2:566:13169: scene=9_2
#: 9_2:566
msgctxt "text_id=13169 | speaker=unknown"
msgid "If Aoko's weapon was surliness, Soujyuro's was blitheness."
msgstr "青子が六割増しなら、彼の<暢気|のんき>さは二倍に増強というところ。"

#. Occurrence 9_2:585:13170: scene=9_2
#: 9_2:585
msgctxt "text_id=13170 | speaker=unknown"
msgid "  He wielded just enough of it to make Aoko flinch."
msgstr "　その強引さに、さすがの青子もわずかに怯む。"

#. Occurrence 9_2:611:13171: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_2_0006; voice_prefix=A10; voice_category=1; scene=9_2
#: 9_2:611
msgctxt "text_id=13171 | speaker=aoko"
msgid "\"What's with you today? Did something nice happen to you?\""
msgstr "「どうしたの、今日は。なにかいい事でもあったわけ？」"

#. Occurrence 9_2:616:13172: scene=9_2
#: 9_2:616
msgctxt "text_id=13172 | speaker=unknown"
msgid "  Soujyuro shook his head."
msgstr "　別に、と草十郎は首をふる。"

#. Occurrence 9_2:640:13173: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0007; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:640
msgctxt "text_id=13173 | speaker=soujuurou"
msgid "\"Not yet. But I do have a proposal for you.\""
msgstr "「まだなんだ。じゃあちょっと、提案がある」"

#. Occurrence 9_2:660:13174: scene=9_2
#: 9_2:660
msgctxt "text_id=13174 | speaker=unknown"
msgid "  He dug around in the pocket of his coat, which was now on a hanger."
msgstr "　言って、ハンガーにかけたコートのポケットをあさる。"

#. Occurrence 9_2:665:13175: scene=9_2
#: 9_2:665
msgctxt "text_id=13175 | speaker=unknown"
msgid "  Aoko gave him a dubious stare, while Alice's ears perked up at his upbeat tone."
msgstr "　今日にかぎって積極的な草十郎の様子を、青子は訝しげに見据え、有珠は本を読みながら聞き耳をたてている。"

#. Occurrence 9_2:697:13176: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0008; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:697
msgctxt "text_id=13176 | speaker=soujuurou"
msgid "\"Actually, today was payday."
msgstr "「実は今日、給料日だったんだ。"

#. Occurrence 9_2:697:13177: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0008; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:697
msgctxt "text_id=13177 | speaker=soujuurou"
msgid "  Which means I have money. We should go out and do something.\""
msgstr "　お金も入った事だし、外に遊びにいこう」"

#. Occurrence 9_2:715:13178: scene=9_2
#: 9_2:715
msgctxt "text_id=13178 | speaker=unknown"
msgid "  He spoke with a warm smile as he removed his wallet from his coat pocket."
msgstr "　コートから財布を取り出し、心温まる笑顔で言う。"

#. Occurrence 9_2:746:13179: scene=9_2
#: 9_2:746
msgctxt "text_id=13179 | speaker=unknown"
msgid "  The other two did not know what to make of it."
msgstr "　一方、ふたりは複雑な顔である。"

#. Occurrence 9_2:786:13180: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_2_0007; voice_prefix=A10; voice_category=1; scene=9_2
#: 9_2:786
msgctxt "text_id=13180 | speaker=aoko"
msgid "\"Soujyuro...?\""
msgstr "「……草十郎」"

#. Occurrence 9_2:792:13181: scene=9_2
#: 9_2:792
msgctxt "text_id=13181 | speaker=unknown"
msgid "  She wanted to take exception to his bright mood, but found herself wrestling with the idea of reacting positively to it."
msgstr "　何か文句を言ってやりたかったけど、それと同じぐらい青子は草十郎に同情した。"

#. Occurrence 9_2:797:13182: scene=9_2
#: 9_2:797
msgctxt "text_id=13182 | speaker=unknown"
msgid "  After all, he was making a gesture of good faith to try and make things better with what little funds he had."
msgstr "　彼はいまだ不仲な有珠と融和するため、なけなしの給料をはたいて行動に出たのだろう。"

#. Occurrence 9_2:829:13183: scene=9_2
#: 9_2:829
msgctxt "text_id=13183 | speaker=unknown"
msgid "  The thought itself was not a bad one."
msgstr "　考え自体は悪くない。"

#. Occurrence 9_2:834:13184: scene=9_2
#: 9_2:834
msgctxt "text_id=13184 | speaker=unknown"
msgid "  While there was always the chance that Alice would keep quiet until the slightest thing annoyed her―at which point she would ruin everything―Aoko wanted to accept his goodwill."
msgstr "　そんな事じゃ有珠の“とりあえず今は黙っていてあげるけど、何か目障りな事をしたら消す”感は消えないと分かっていても、その健気な努力に応援ぐらいはしてあげたい。"

#. Occurrence 9_2:839:13185: scene=9_2
#: 9_2:839
msgctxt "text_id=13185 | speaker=unknown"
msgid "  However, she was not in the mood to walk around town with either of the two, nor was the timing ideal."
msgstr "　けれど、今は三人で街を歩いている気分じゃないし、状況でもないのだ。"

#. Occurrence 9_2:865:13186: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_2_0008; voice_prefix=A10; voice_category=1; scene=9_2
#: 9_2:865
msgctxt "text_id=13186 | speaker=aoko"
msgid "\"Sorry, but I'm kinda busy. I'll take you up on it some other time though. Just remind me.\""
msgstr "「悪いけど、いま忙しいの。暇になったら思い出してあげるから、しばらく我慢して」"

#. Occurrence 9_2:883:13187: scene=9_2
#: 9_2:883
msgctxt "text_id=13187 | speaker=unknown"
msgid "  Alice seemed to give the same response, though wordlessly."
msgstr "　何も言わないが有珠も同意見らしい。"

#. Occurrence 9_2:888:13188: scene=9_2
#: 9_2:888
msgctxt "text_id=13188 | speaker=unknown"
msgid "  Soujyuro was not about to be held back by the sullen mood."
msgstr "　そんな重苦しい空気にもめげず、"

#. Occurrence 9_2:920:13189: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0009; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:920
msgctxt "text_id=13189 | speaker=soujuurou"
msgid "\"Busy doing what, sitting here in silence?"
msgstr "「忙しいって、ここで黙りあってるだけじゃないか。"

#. Occurrence 9_2:926:13190: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0010; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:926
msgctxt "text_id=13190 | speaker=soujuurou"
msgid "  Wasn't it you, Aozaki, that said a change of pace was important when working overnight? Sometimes you need to take one step back to take two steps forward.\""
msgstr "　徹夜漬けの時、気分転換は必要だって言ったのは蒼崎だろ。行き詰まったら回れ右して戻らないと、どこにも行けない」"

#. Occurrence 9_2:957:13191: scene=9_2
#: 9_2:957
msgctxt "text_id=13191 | speaker=unknown"
msgid "  Soujyuro spoke with unusual confidence, as he drew two tickets from his wallet and slapped them on the table."
msgstr "　いつになく強気に言って、草十郎は財布から二枚のチケットを取り出し、とん、とテーブルに置いた。"

#. Occurrence 9_2:962:13192: scene=9_2
#: 9_2:962
msgctxt "text_id=13192 | speaker=unknown"
msgid "  At first glance, they looked like advance tickets to a movie...but not quite. They were tickets to a famous aquarium."
msgstr "　それは映画の前売券……なんてありきたりなものではなく、有名な水族館のチケットだった。"

#. Occurrence 9_2:982:13193: scene=9_2
#: 9_2:982
msgctxt "text_id=13193 | speaker=unknown"
msgid "  To get there, they would take the rapid train and subway to a city several times more modern than Misaki."
msgstr "　行き先は、快速と地下鉄を乗り継いだ先にある、三咲市より何倍も近代化の進んだ街。"

#. Occurrence 9_2:987:13194: scene=9_2
#: 9_2:987
msgctxt "text_id=13194 | speaker=unknown"
msgid "  It housed not only the biggest shopping mall in the prefecture, but also a multi-purpose auditorium―set to open next year―designed to host international conferences and stage productions."
msgstr "　県内最大をうたうショッピングモールだけでなく、来年開場予定の、国際的な規模の演劇、講演を可能とする多目的ホールまで造られているという。"

#. Occurrence 9_2:1019:13195: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0011; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:1019
msgctxt "text_id=13195 | speaker=soujuurou"
msgid "\"Oh, and eat some curry at Messiaen, on me.\""
msgstr "「それと、夜はメシアンでカレーでも食べてくれ」"

#. Occurrence 9_2:1038:13196: scene=9_2
#: 9_2:1038
msgctxt "text_id=13196 | speaker=unknown"
msgid "  Saying that, he slapped two bills on the table, as if he had struck it rich."
msgstr "　さらに、見ようによっては黄金にも見えるお札を二枚ほどぽん、とテーブルにそえる。"

#. Occurrence 9_2:1043:13197: scene=9_2
#: 9_2:1043
msgctxt "text_id=13197 | speaker=unknown"
msgid "  It was Soujyuro's turn to make dinner tonight, after all."
msgstr "　そういえば、夕食の食事当番は草十郎だった。"

#. Occurrence 9_2:1111:13198: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0012; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:1111
msgctxt "text_id=13198 | speaker=soujuurou"
msgid "\"Be seeing you.\""
msgstr "「じゃ、そういう事で」"

#. Occurrence 9_2:1118:13199: scene=9_2
#: 9_2:1118
msgctxt "text_id=13199 | speaker=unknown"
msgid "  His business concluded, Soujyuro returned his wallet to his coat pocket."
msgstr "　草十郎は用件だけ告げ、財布をコートに戻す。"

#. Occurrence 9_2:1123:13200: scene=9_2
#: 9_2:1123
msgctxt "text_id=13200 | speaker=unknown"
msgid "  It was then that Aoko realized what Soujyuro meant by \"be seeing you.\""
msgstr "　それで、青子はようやく自分の間違いに気が付いた。"

#. Occurrence 9_2:1158:13201: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_2_0009; voice_prefix=A10; voice_category=1; scene=9_2
#: 9_2:1158
msgctxt "text_id=13201 | speaker=aoko"
msgid "\"Y-you mean you're not coming with us?\""
msgstr "「ちょっと待った！　そういうアンタはどうするのよ」"

#. Occurrence 9_2:1164:13202: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_2_0013; voice_prefix=A30; voice_category=3; scene=9_2
#: 9_2:1164
msgctxt "text_id=13202 | speaker=soujuurou"
msgid "\"I have to work tonight.\""
msgstr "「今日はアルバイト」"

#. Occurrence 9_2:1175:13203: scene=9_2
#: 9_2:1175
msgctxt "text_id=13203 | speaker=unknown"
msgid "  Soujyuro was almost too quick with his response, helping Aoko to see things for what they really were."
msgstr "　さらっと答える草十郎に、そういうコト、と察する青子。"

#. Occurrence 9_2:1200:13204: scene=9_2
#: 9_2:1200
msgctxt "text_id=13204 | speaker=unknown"
msgid "  Rather than for Soujyuro's benefit, his gesture was instead an attempt to ease the tension that had built up between Aoko and Alice."
msgstr "　草十郎は自分の為でなく、ここのところギスギスしている青子と有珠の仲をほぐそうとしているのだ。"

#. Occurrence 9_2:1210:13205: scene=9_2
#: 9_2:1210
msgctxt "text_id=13205 | speaker=unknown"
msgid "  Though if asked, both girls would tell you it was an unnecessary gesture."
msgstr "　そんなのは彼の勝手な勘違いで、言ってしまえば迷惑なお節介に分類される。"

#. Occurrence 9_2:1215:13206: scene=9_2
#: 9_2:1215
msgctxt "text_id=13206 | speaker=unknown"
msgid "  Still..."
msgstr "　……しかし。"

#. Occurrence 9_2:1220:13207: scene=9_2
#: 9_2:1220
msgctxt "text_id=13207 | speaker=unknown"
msgid "  For him to pay this much attention to the household, if anything, gave Aoko reason to reflect on her own immaturity."
msgstr "　そんな風に気を配ってくれた事と、なにより、そこまで気を遣わせてしまった自分の未熟さに反省する。"

#. Occurrence 9_2:1260:13208: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_2_0010; voice_prefix=A10; voice_category=1; scene=9_2
#: 9_2:1260
msgctxt "text_id=13208 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 9_2:1266:13209: scene=9_2
#: 9_2:1266
msgctxt "text_id=13209 | speaker=unknown"
msgid "  Aoko glanced over to the still-seated Alice."
msgstr "　青子は対面に座る有珠を覗き見た。"

#. Occurrence 9_2:1295:13210: scene=9_2
#: 9_2:1295
msgctxt "text_id=13210 | speaker=unknown"
msgid "  At the same time, Alice peeked up at Aoko from behind her book."
msgstr "　すると、ちょうど有珠も青子に視線を投げかけているところだった。"

#. Occurrence 9_2:1326:13211: scene=9_2
#: 9_2:1326
msgctxt "text_id=13211 | speaker=unknown"
msgid "  They kept still, staring at each other."
msgstr "　ふたりはしばし無言で見つめ合う。"

#. Occurrence 9_2:1366:13212: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_2_0000; voice_prefix=A40; voice_category=2; scene=9_2
#: 9_2:1366
msgctxt "text_id=13212 | speaker=alice"
msgid "\"...I'll go if you go."
msgstr "「……わたしはかまわないけど。"

#. Occurrence 9_2:1366:13213: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_2_0000; voice_prefix=A40; voice_category=2; scene=9_2
#: 9_2:1366
msgctxt "text_id=13213 | speaker=alice"
msgid "  I'm almost done with my book.\""
msgstr "　いまやれる事は全部やってあるし」"

#. Occurrence 9_2:1384:13214: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_2_0011; voice_prefix=A10; voice_category=1; scene=9_2
#: 9_2:1384
msgctxt "text_id=13214 | speaker=aoko"
msgid "\"Okay. It would be a waste not to.\""
msgstr "「そうね。そういう事なら、せっかくだし」"

#. Occurrence 9_2:1403:13215: scene=9_2
#: 9_2:1403
msgctxt "text_id=13215 | speaker=unknown"
msgid "  Aoko stood up from the sofa, resigned to her decision."
msgstr "　観念したように言って、青子はソファーから立ち上がる。"

#. Occurrence 9_2:1419:13216: scene=9_2
#: 9_2:1419
msgctxt "text_id=13216 | speaker=unknown"
msgid "  Soujyuro watched on, a satisfied smile on his face."
msgstr "　そんなふたりを、草十郎は満足げに眺めていた。"

#. Occurrence 9_3:46:13217: scene=9_3
#: 9_3:46
msgctxt "text_id=13217 | speaker=unknown"
msgid "  Twenty minutes later."
msgstr "　それから二十分ほど後。"

#. Occurrence 9_3:51:13218: scene=9_3
#: 9_3:51
msgctxt "text_id=13218 | speaker=unknown"
msgid "  As Aoko and Alice were done getting ready, Aoko called out to Soujyuro in the drawing room."
msgstr "　青子と有珠は外出の支度を済ませ、居間にいる草十郎に声をかけた。"

#. Occurrence 9_3:72:13219: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0000; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:72
msgctxt "text_id=13219 | speaker=aoko"
msgid "\"All right, we're leaving now. ...Soujyuro?\""
msgstr "「それじゃ出かけてくるからアンタもバイト―――草十郎？」"

#. Occurrence 9_3:104:13220: scene=9_3
#: 9_3:104
msgctxt "text_id=13220 | speaker=unknown"
msgid "  Soujyuro was crouched in front of the television, unaware that the two had entered the room."
msgstr "　立ち寄ったふたりに気付かず、草十郎はなにやらテレビの前にしゃがみこんでいる。"

#. Occurrence 9_3:111:13221: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0001; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:111
msgctxt "text_id=13221 | speaker=aoko"
msgid "\"Are you fiddling with the VCR?\""
msgstr "「もしかして、ビデオいじってるの？」"

#. Occurrence 9_3:144:13222: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0000; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:144
msgctxt "text_id=13222 | speaker=soujuurou"
msgid "\"Oh, hey. Good timing. How do I―\""
msgstr "「ああ、ちょうど良かった。蒼崎、これ―――」"

#. Occurrence 9_3:150:13223: scene=9_3
#: 9_3:150
msgctxt "text_id=13223 | speaker=unknown"
msgid "  Pausing his audiovisual struggles, Soujyuro turned around."
msgstr "　作業を中断し、青子たちに振り向く草十郎。"

#. Occurrence 9_3:242:13224: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0001; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:242
msgctxt "text_id=13224 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 9_3:247:13225: scene=9_3
#: 9_3:247
msgctxt "text_id=13225 | speaker=unknown"
msgid "  He froze in shock, forgetting what he was about to say."
msgstr "　振り向いて、驚きのあまり言葉を失った。"

#. Occurrence 9_3:289:13226: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0002; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:289
msgctxt "text_id=13226 | speaker=aoko"
msgid "\"You okay? Listen, we're taking you up on your offer and going out. ...Did you drop something behind the TV?\""
msgstr "「？　私たち、お言葉に甘えて出かけてくるけど……どうしたのよ、一体。<棚|たな>の後ろに落とし物でもしたの？」"

#. Occurrence 9_3:295:13227: scene=9_3
#: 9_3:295
msgctxt "text_id=13227 | speaker=unknown"
msgid "  Soujyuro appeared to have gone stiff. Aoko stared at him curiously."
msgstr "　固まっている草十郎を青子は不思議そうに見る。"

#. Occurrence 9_3:305:13228: scene=9_3
#: 9_3:305
msgctxt "text_id=13228 | speaker=unknown"
msgid "  Though Alice silently nodded along with his bizarre reaction,"
msgstr "　その挙動不審さに有珠もうんうん、と無言で同意した。"

#. Occurrence 9_3:310:13229: scene=9_3
#: 9_3:310
msgctxt "text_id=13229 | speaker=unknown"
msgid "  she kept her thoughts to herself."
msgstr "　……実際、頷いてはいなかったが。"

#. Occurrence 9_3:349:13230: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0002; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:349
msgctxt "text_id=13230 | speaker=soujuurou"
msgid "\"...No."
msgstr "「―――いや。"

#. Occurrence 9_3:371:13231: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0003; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:371
msgctxt "text_id=13231 | speaker=soujuurou"
msgid "  ...It's just..."
msgstr "　なんか、"

msgctxt "text_id=13232 | speaker=unknown"
msgid " Um...\""
msgstr "こう」"

#. Occurrence 9_3:411:13233: scene=9_3
#: 9_3:411
msgctxt "text_id=13233 | speaker=unknown"
msgid "  Still gawking, his voice stuck in his throat."
msgstr "　すごく驚いたんだ、と続くところを、草十郎は喉を絞めて押し伏せた。"

#. Occurrence 9_3:416:13234: scene=9_3
#: 9_3:416
msgctxt "text_id=13234 | speaker=unknown"
msgid "  He was blissfully unaware that the shock he was experiencing was the direct result of his emotional state."
msgstr "　その驚きが感動に由来するものである事を、彼はまだ知り得なかったからである。"

#. Occurrence 9_3:449:13235: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0003; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:449
msgctxt "text_id=13235 | speaker=aoko"
msgid "\"Spit it out already."
msgstr "「それじゃ分からないってば。"

#. Occurrence 9_3:460:13236: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0004; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:460
msgctxt "text_id=13236 | speaker=aoko"
msgid "  God, I wish your weird reactions made sense sometimes. Does Alice have something on her face, or...?\""
msgstr "　まったく、落ち着いてるクセに妙に挙動不審なんだから。有珠に<煙|けむ>たがられても仕方ないって言うか―――」"

#. Occurrence 9_3:485:13237: scene=9_3
#: 9_3:485
msgctxt "text_id=13237 | speaker=unknown"
msgid "  Alice looked on in silence."
msgstr "　有珠は無言で観察している。"

#. Occurrence 9_3:490:13238: scene=9_3
#: 9_3:490
msgctxt "text_id=13238 | speaker=unknown"
msgid "  He was not confused, or in a daydream. That much he could tell. But this frozen look was by all accounts a first for Soujyuro."
msgstr "　あわてるのでもなく、ぼんやりするのでもなく、こんな風に固まる草十郎を見るのは初めてだったからだ。"

#. Occurrence 9_3:526:13239: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0005; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:526
msgctxt "text_id=13239 | speaker=aoko"
msgid "\"So what is it then?\""
msgstr "「それで、何かあったの？」"

#. Occurrence 9_3:543:13240: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0004; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:543
msgctxt "text_id=13240 | speaker=soujuurou"
msgid "\"Oh, uhhh... This thing, here."
msgstr "「ああ、いや―――これなんだけど。"

#. Occurrence 9_3:549:13241: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0005; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:549
msgctxt "text_id=13241 | speaker=soujuurou"
msgid "  How exactly do I use it?\""
msgstr "　蒼崎、ビデオってどう使うんだ？」"

#. Occurrence 9_3:554:13242: scene=9_3
#: 9_3:554
msgctxt "text_id=13242 | speaker=unknown"
msgid "  Shaking his head to regain his composure, Soujyuro pointed to the VCR."
msgstr "　動揺が顔に出ないよう気を取り直し、草十郎はビデオデッキを指さした。"

#. Occurrence 9_3:559:13243: scene=9_3
#: 9_3:559
msgctxt "text_id=13243 | speaker=unknown"
msgid "  A VHS player sat on a shelf beneath the TV."
msgstr "　テレビの下にはＶＨＳ型のビデオデッキが置かれている。"

#. Occurrence 9_3:592:13244: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0006; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:592
msgctxt "text_id=13244 | speaker=aoko"
msgid "\"What? You want to record something?\""
msgstr "「なに、タイマー録画でもするの？」"

#. Occurrence 9_3:598:13245: scene=9_3
#: 9_3:598
msgctxt "text_id=13245 | speaker=unknown"
msgid "  Aoko walked over and crouched next to Soujyuro in front of the TV."
msgstr "　青子はテレビの前でしゃがんでいる草十郎のとなりへ歩いていく。"

#. Occurrence 9_3:631:13246: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0006; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:631
msgctxt "text_id=13246 | speaker=soujuurou"
msgid "\"No, I just borrowed a video from Kinomi, but it won't play.\""
msgstr "「いや、木乃美からビデオを借りたんだけど、映らない」"

#. Occurrence 9_3:643:13247: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0007; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:643
msgctxt "text_id=13247 | speaker=aoko"
msgid "\"Well... for starters, the TV isn't turned on.\""
msgstr "「……まず、テレビの電源が入ってない」"

#. Occurrence 9_3:714:13248: scene=9_3
#: 9_3:714
msgctxt "text_id=13248 | speaker=unknown"
msgid "  With a click, the TV screen flickered alive."
msgstr "　ぱちり、と音を立ててブラウン管に光がともる。"

#. Occurrence 9_3:742:13249: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0008; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:742
msgctxt "text_id=13249 | speaker=aoko"
msgid "\"Next, you have to switch to the video input..."
msgstr "「次、チャンネルを外線に合わせて……"

#. Occurrence 9_3:764:13250: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0009; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:764
msgctxt "text_id=13250 | speaker=aoko"
msgid "  That's weird, it's all dark. Knowing Kinomi, I'm surprised the recording doesn't start from the very beginning.\""
msgstr "　あら、意外にも真っ黒。木乃美くんの事だからテープ頭から録画してると思ったけど」"

#. Occurrence 9_3:781:13251: scene=9_3
#: 9_3:781
msgctxt "text_id=13251 | speaker=unknown"
msgid "  During this time period, video tapes were still rather expensive."
msgstr "　この時代、ビデオテープはそれなりに高価である。"

#. Occurrence 9_3:786:13252: scene=9_3
#: 9_3:786
msgctxt "text_id=13252 | speaker=unknown"
msgid "  Therefore, it was only natural for people to not want to waste a single second of the tape's one-hundred and twenty minute capacity."
msgstr "　120分の記録容量をフルに使うため、せっかちな人間なら一秒も無駄にしたがらないのが常だった。"

#. Occurrence 9_3:819:13253: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0010; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:819
msgctxt "text_id=13253 | speaker=aoko"
msgid "\"Especially considering how serious he is about his hobbies. Oh well, we'll have to fast-forward.\""
msgstr "「わりと趣味には気を遣う性格なのね。じゃ、早送りっと」"

#. Occurrence 9_3:837:13254: scene=9_3
#: 9_3:837
msgctxt "text_id=13254 | speaker=unknown"
msgid "  Aoko picked the small remote up, and quickly pushed the button marked FWD."
msgstr "　小さなリモコンを手にとって、青子はささっと早送りボタンを押す。"

#. Occurrence 9_3:855:13255: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0011; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:855
msgctxt "text_id=13255 | speaker=aoko"
msgid "\"Hm?\""
msgstr "「ん？」"

#. Occurrence 9_3:867:13256: scene=9_3
#: 9_3:867
msgctxt "text_id=13256 | speaker=unknown"
msgid "  The VCR beeped in protest."
msgstr "　ビデオデッキからの反応はない。"

#. Occurrence 9_3:872:13257: scene=9_3
#: 9_3:872
msgctxt "text_id=13257 | speaker=unknown"
msgid "  With several clicks and thuds, there was an empty whirr from within the machine."
msgstr "　ガチャンガチャン、と内部でモーターの空回る音がする。"

#. Occurrence 9_3:904:13258: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0007; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:904
msgctxt "text_id=13258 | speaker=soujuurou"
msgid "\"Don't look at me. I didn't break it. I think...\""
msgstr "「……壊してないぞ、たぶん」"

#. Occurrence 9_3:909:13259: scene=9_3
#: 9_3:909
msgctxt "text_id=13259 | speaker=unknown"
msgid "  The vast majority of people who say this are actually very prone to destroying electrical equipment. But that is a separate matter."
msgstr "　そういう事を言う人間の多くが電気機器を破壊する特殊技能を有しているのだが、それは置いておいて。"

#. Occurrence 9_3:943:13260: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0012; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:943
msgctxt "text_id=13260 | speaker=aoko"
msgid "\"Umm... There's no tape in here.\""
msgstr "「……おまけに、テープが入ってない」"

#. Occurrence 9_3:948:13261: scene=9_3
#: 9_3:948
msgctxt "text_id=13261 | speaker=unknown"
msgid "  As soon as the words left her lips, it all made sense."
msgstr "　青子はトドメとばかりに言い捨てた。"

#. Occurrence 9_3:968:13262: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0008; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:968
msgctxt "text_id=13262 | speaker=soujuurou"
msgid "\"Tape?\""
msgstr "「テープ？」"

#. Occurrence 9_3:973:13263: scene=9_3
#: 9_3:973
msgctxt "text_id=13263 | speaker=unknown"
msgid "  Soujyuro imagined adhesive tape, clearly confused."
msgstr "　両面か？　などとベタな思案をする草十郎。"

#. Occurrence 9_3:1006:13264: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0013; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1006
msgctxt "text_id=13264 | speaker=aoko"
msgid "\"Soujyuro. Did Kinomi give you something?\""
msgstr "「草十郎。木乃美くんから、何か渡されなかった？」"

#. Occurrence 9_3:1023:13265: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0009; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:1023
msgctxt "text_id=13265 | speaker=soujuurou"
msgid "\"You mean the thing on the table?\""
msgstr "「渡されたけど。ほら、テーブルの上」"

#. Occurrence 9_3:1041:13266: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0014; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1041
msgctxt "text_id=13266 | speaker=aoko"
msgid "\"...\""
msgstr "「……………………」"

#. Occurrence 9_3:1046:13267: scene=9_3
#: 9_3:1046
msgctxt "text_id=13267 | speaker=unknown"
msgid "  Though she should have been used to it by now, she caught herself wondering if Soujyuro was being stupid deliberately."
msgstr "　慣れたとはいえ、時々こいつわざとやってるんじゃないのか、と疑うほどのボケっぷりだった。"

#. Occurrence 9_3:1082:13268: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0015; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1082
msgctxt "text_id=13268 | speaker=aoko"
msgid "\"Soujyuro. What exactly did Kinomi say? Do you remember?\""
msgstr "「木乃美くんがなんて言ったか、覚えてる？」"

#. Occurrence 9_3:1099:13269: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0010; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:1099
msgctxt "text_id=13269 | speaker=soujuurou"
msgid "\"Yeah, he said, 'I'll totally lend you this tape. When you get home, ^just watch the TV.'\""
msgstr "「テープ貸してやるから、家に帰ったらビデオを見ろ、と……」"

#. Occurrence 9_3:1127:13270: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0016; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1127
msgctxt "text_id=13270 | speaker=aoko"
msgid "\"Great. So he left out the most important part."
msgstr "「一番大事な言葉が抜けてたワケね。"

#. Occurrence 9_3:1140:13271: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0017; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1140
msgctxt "text_id=13271 | speaker=aoko"
msgid "  Honestly... This is so sad it's almost scary. Just when I thought you were finally adapting. How you make it through a day is a mystery to me.\""
msgstr "　……はあ。失望を通り越して怖くなるわ。あっさり順応しているように見えてこれだものね。どんだけ<綱渡|つなわた>りな毎日送ってんのよ、アンタは」"

#. Occurrence 9_3:1184:13272: scene=9_3
#: 9_3:1184
msgctxt "text_id=13272 | speaker=unknown"
msgid "  Exasperated, Aoko fetched the tape in question."
msgstr "　ちょっと疲れて、青子は問題のテープを手に取った。"

#. Occurrence 9_3:1189:13273: scene=9_3
#: 9_3:1189
msgctxt "text_id=13273 | speaker=unknown"
msgid "  It was labeled \"GAKUGAKU Animal Kingdom: African Adventure.\""
msgstr "　ラベルにはサインペンで『GAKUGAKU動物ランド暗黒大陸編』と書かれている。"

#. Occurrence 9_3:1227:13274: scene=9_3
#: 9_3:1227
msgctxt "text_id=13274 | speaker=unknown"
msgid "  To Aoko, this knocked Housuke Kinomi down a level on the ratings file she kept with the student council."
msgstr "　……生徒会における木乃美芳助の評価レベルをひとつ下げる青子だった。"

#. Occurrence 9_3:1261:13275: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0018; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1261
msgctxt "text_id=13275 | speaker=aoko"
msgid "\"Okay, you put the tape in the VCR, and push 'Play'. The tab isn't broken, so just be careful not to hit the record button.\""
msgstr "「……で、このテープをデッキに入れて、再生すればいいの。ツメは折ってないから、録画ボタンだけは押さないようにね」"

#. Occurrence 9_3:1267:13276: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0011; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:1267
msgctxt "text_id=13276 | speaker=soujuurou"
msgid "\"What's a tab?\""
msgstr "「ツメとは？」"

#. Occurrence 9_3:1288:13277: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0019; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1288
msgctxt "text_id=13277 | speaker=aoko"
msgid "\"Right here. See the indent on the side of the tape here? The 'tab' is this little plastic cover."
msgstr "「ここ。テープの側面にへこみがあるでしょ。これをカバーしているのがツメ。"

#. Occurrence 9_3:1295:13278: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0020; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1295
msgctxt "text_id=13278 | speaker=aoko"
msgid "If you snap this tab off, you can't record on this tape anymore."
msgstr "これを切り取っておくと、もうそのテープは上書き録画できなくなるのよ。"

#. Occurrence 9_3:1301:13279: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0021; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1301
msgctxt "text_id=13279 | speaker=aoko"
msgid "  How can I explain this...? Think of it like a notebook for class."
msgstr "　えーと……そうね、喩えるなら授業のノート。"

#. Occurrence 9_3:1307:13280: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0022; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1307
msgctxt "text_id=13280 | speaker=aoko"
msgid "  It's like a sealant you spray over the page so it can't be erased. Think of it as a physical barrier against common human error.\""
msgstr "　大事なものだから、消しゴムで消えないようにフィキサチーフをかけたっていうか。ヒューマンエラーを物理的に防止する、<力技|アナログ>な防御法ってワケ」"

#. Occurrence 9_3:1328:13281: scene=9_3
#: 9_3:1328
msgctxt "text_id=13281 | speaker=unknown"
msgid "  She inserted the tape into the VCR, and handed the remote to Soujyuro."
msgstr "　デッキにビデオを入れ、草十郎にリモコンを手渡す。"

#. Occurrence 9_3:1345:13282: scene=9_3
#: 9_3:1345
msgctxt "text_id=13282 | speaker=unknown"
msgid "  Just this small interaction used up a fair bit of Aoko's patience."
msgstr "　たったこれだけの事でひどく精神力を消耗してしまった。"

#. Occurrence 9_3:1364:13283: scene=9_3
#: 9_3:1364
msgctxt "text_id=13283 | speaker=unknown"
msgid "  Completely ignorant of Aoko's feelings, Soujyuro gleefully pressed the play button."
msgstr "　そんな青子の気苦労も知らず、ピッと再生ボタンを押して喜ぶ草十郎。"

#. Occurrence 9_3:1397:13284: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0023; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1397
msgctxt "text_id=13284 | speaker=aoko"
msgid "\"Whew... I was afraid we weren't going to make it this far for a second there. That was a bit much, even for someone as out of place as you are."
msgstr "「……はあ。前から危なっかしいと思ってたけど、まさかここまでとはね。時代錯誤にも程がある。"

#. Occurrence 9_3:1413:13285: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0024; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1413
msgctxt "text_id=13285 | speaker=aoko"
msgid "  What were you doing up there in the mountains? Don't tell me you were some karate master, training against bears or something?\""
msgstr "　アンタ、山で何やってたの？　空手家じゃあるまいし、熊を倒す修業でもしてた、とか言わないでしょうね？」"

#. Occurrence 9_3:1430:13286: scene=9_3
#: 9_3:1430
msgctxt "text_id=13286 | speaker=unknown"
msgid "  Even Soujyuro managed to pick up on Aoko's rude tone, and he frowned disapprovingly."
msgstr "　さすがにこれは嫌味だと分かったのか、草十郎は批難の目を青子に向けた。"

#. Occurrence 9_3:1456:13287: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0012; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:1456
msgctxt "text_id=13287 | speaker=soujuurou"
msgid "\"Was that an attempt to insult me?\""
msgstr "「それは、もしかして俺を馬鹿にしてるのか？」"

#. Occurrence 9_3:1462:13288: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0025; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1462
msgctxt "text_id=13288 | speaker=aoko"
msgid "\"Umm... You mean just now, or all the other times?\""
msgstr "「心外ね、事実馬鹿にしてるんだけど」"

#. Occurrence 9_3:1473:13289: scene=9_3
#: 9_3:1473
msgctxt "text_id=13289 | speaker=unknown"
msgid "  Aoko answered, unapologetically."
msgstr "　きっぱりと青子は答える。"

#. Occurrence 9_3:1478:13290: scene=9_3
#: 9_3:1478
msgctxt "text_id=13290 | speaker=unknown"
msgid "  On the TV, a crocodile's yawning mouth appeared."
msgstr "　テレビでは問題のワニがむはぁー、とあくびをしているところだった。"

#. Occurrence 9_3:1504:13291: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0013; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:1504
msgctxt "text_id=13291 | speaker=soujuurou"
msgid "\"Don't be ridiculous. Why would anyone train against bears?\""
msgstr "「そんな馬鹿な話があるもんか。なんで熊を倒すために修業しなくちゃいけないんだ？」"

#. Occurrence 9_3:1514:13292: scene=9_3
#: 9_3:1514
msgctxt "text_id=13292 | speaker=unknown"
msgid "  Soujyuro turned toward the TV in a huff."
msgstr "　ぷいっと顔をテレビに逸らす草十郎。"

#. Occurrence 9_3:1531:13293: scene=9_3
#: 9_3:1531
msgctxt "text_id=13293 | speaker=unknown"
msgid "  Perhaps because of his rare outburst, as he turned face to face with the gaping maw of the crocodile on the TV, he fell backwards in surprise."
msgstr "　彼にしては珍しく怒ったのだが、顔を背けた先で大口を開けるワニの映像と向き合い、びくっと後退したりする。"

#. Occurrence 9_3:1568:13294: scene=9_3
#: 9_3:1568
msgctxt "text_id=13294 | speaker=unknown"
msgid "  Aoko unpursed her lips upon seeing this, delighted."
msgstr "　そんな光景を見て、青子は嬉しげに口元を緩めた。"

#. Occurrence 9_3:1573:13295: scene=9_3
#: 9_3:1573
msgctxt "text_id=13295 | speaker=unknown"
msgid "  It was relieving to see the boy disarmed."
msgstr "　この少年はやっぱりこうでなくてはいけない、と安心するように。"

#. Occurrence 9_3:1608:13296: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0014; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:1608
msgctxt "text_id=13296 | speaker=soujuurou"
msgid "\"Hey, Aozaki. These machines have gotten kinda dusty. Don't you clean them?\""
msgstr "「けど蒼崎。この機械、ずいぶんほこりがつもっているけど、掃除はしていないのか？」"

#. Occurrence 9_3:1641:13297: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0026; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1641
msgctxt "text_id=13297 | speaker=aoko"
msgid "\"Why bother? I hardly ever use them, and Alice doesn't watch TV."
msgstr "「私はあんまり使わないし、有珠は見ないから今までほっぽってただけよ。"

#. Occurrence 9_3:1647:13298: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0027; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1647
msgctxt "text_id=13298 | speaker=aoko"
msgid "  I bought some exercise videos to train with, but got bored of them. Who would have thought you actually need to do the exercises instead of just watching the damn thing?\""
msgstr "　ダメもとでトレーニング用に買ってもらったんだけど、飽きちゃった。イメージでどうにかできる問題じゃなかったっていうか」"

#. Occurrence 9_3:1679:13299: scene=9_3
#: 9_3:1679
msgctxt "text_id=13299 | speaker=unknown"
msgid "  Aoko shrugged at her past superficiality."
msgstr "　昔の自分の浅はかさを<嗤|わら>うように、青子は両肩をすくめる。"

#. Occurrence 9_3:1699:13300: scene=9_3
#: 9_3:1699
msgctxt "text_id=13300 | speaker=unknown"
msgid "  And Soujyuro was led to believe yet another falsehood about modern life-that VCRs would go out of fashion."
msgstr "　またひとつ、ビデオデッキは飽きるもの、という間違った単語を覚える草十郎である。"

#. Occurrence 9_3:1735:13301: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0028; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1735
msgctxt "text_id=13301 | speaker=aoko"
msgid "\"Well then, we're off. Try not to burn the place to the ground."
msgstr "「それじゃ、留守番お願いね。"

#. Occurrence 9_3:1741:13302: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3_0029; voice_prefix=A10; voice_category=1; scene=9_3
#: 9_3:1741
msgctxt "text_id=13302 | speaker=aoko"
msgid "  And in case you were wondering, I know you don't have work tonight.\""
msgstr "　バイト、ほんとは無いんでしょう？」"

#. Occurrence 9_3:1762:13303: scene=9_3
#: 9_3:1762
msgctxt "text_id=13303 | speaker=unknown"
msgid "  Aoko walked out of the drawing room, smiling."
msgstr "　微笑みながら言って、青子は居間から立ち去っていった。"

#. Occurrence 9_3:1793:13304: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_3_0015; voice_prefix=A30; voice_category=3; scene=9_3
#: 9_3:1793
msgctxt "text_id=13304 | speaker=soujuurou"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 9_3:1798:13305: scene=9_3
#: 9_3:1798
msgctxt "text_id=13305 | speaker=unknown"
msgid "  Her grin was the cheap shot that left Soujyuro speechless."
msgstr "　青子の笑顔に虚を突かれて、言葉につまる草十郎。"

#. Occurrence 9_3:1803:13306: scene=9_3
#: 9_3:1803
msgctxt "text_id=13306 | speaker=unknown"
msgid "  As he scratched his cheek, he was reminded that she was not someone to be trifled with."
msgstr "　やっぱり、あんな嘘が通じる相手ではなかったのだ、と頬をかく。"

#. Occurrence 9_3:1836:13307: scene=9_3
#: 9_3:1836
msgctxt "text_id=13307 | speaker=unknown"
msgid "  After watching the end of the drama between her housemates, Alice made for the reception area as well."
msgstr "　そんなふたりのやりとりを最後まで傍観してから、有珠もロビーに向かっていった。"

#. Occurrence 9_3:1871:13308: scene=9_3
#: 9_3:1871
msgctxt "text_id=13308 | speaker=unknown"
msgid "  Left alone in the room, Soujyuro took his seat on the sofa."
msgstr "　ひとり居間に残され、さて、と草十郎はソファーに座る。"

#. Occurrence 9_3:1876:13309: scene=9_3
#: 9_3:1876
msgctxt "text_id=13309 | speaker=unknown"
msgid "  ...Well."
msgstr "　……まあ。"

#. Occurrence 9_3:1881:13310: scene=9_3
#: 9_3:1881
msgctxt "text_id=13310 | speaker=unknown"
msgid "  It was certainly not easy making everything run smoothly around these parts."
msgstr "　とりあえず、やりたいコトはきちんと機能したのだし。"

#. Occurrence 9_3:1886:13311: scene=9_3
#: 9_3:1886
msgctxt "text_id=13311 | speaker=unknown"
msgid "  Until they came back, he could enjoy his crocodile-watching in peace."
msgstr "　あとは彼女たちが帰ってくるまで、こうしてワニを観察していよう、と思いながら。"

#. Occurrence 9_3C:89:13312: scene=9_3C
#: 9_3C:89
msgctxt "text_id=13312 | speaker=unknown"
msgid "  They took the subway from Misaki for six stations."
msgstr "　三咲町から地下鉄線で六駅分。"

#. Occurrence 9_3C:94:13313: scene=9_3C
#: 9_3C:94
msgctxt "text_id=13313 | speaker=unknown"
msgid "  From there, they rode another three stops by express train."
msgstr "　そこから更に快速で三駅分。"

#. Occurrence 9_3C:100:13314: scene=9_3C
#: 9_3C:100
msgctxt "text_id=13314 | speaker=unknown"
msgid "  After about an hour, Aoko and Alice arrived at Arisaka Station."
msgstr "　一時間ほどかけて、青子と有珠は<有坂|ありさか>駅に到着した。"

#. Occurrence 9_3C:120:13315: scene=9_3C
#: 9_3C:120
msgctxt "text_id=13315 | speaker=unknown"
msgid "  While Misaki City was a mixture of old and new architecture, Arisaka was a brand-new town built in accordance with recent government ordinance."
msgstr "　有坂は政令指定によって一から開発された都市だ。"

#. Occurrence 9_3C:125:13316: scene=9_3C
#: 9_3C:125
msgctxt "text_id=13316 | speaker=unknown"
msgid "  It was as though an entire town full of tall buildings sprouted up in the middle of nowhere."
msgstr "　三咲町は古きを残し、新しきを築く方針で生まれ変わった町だが、有坂は何もなかった土地に<高層建築|ビルディング>を築き上げた街である。"

#. Occurrence 9_3C:184:13317: scene=9_3C
#: 9_3C:184
msgctxt "text_id=13317 | speaker=unknown"
msgid "  It was near the end of December, in the middle of winter break."
msgstr "　十二月末、冬休みまっただ中。"

#. Occurrence 9_3C:189:13318: scene=9_3C
#: 9_3C:189
msgctxt "text_id=13318 | speaker=unknown"
msgid "  Even the bustling plaza in Misaki was quiet compared to Arisaka in the evening."
msgstr "　午後を過ぎた有坂の街の賑わいは、三咲町とは比べものにならない。"

#. Occurrence 9_3C:194:13319: scene=9_3C
#: 9_3C:194
msgctxt "text_id=13319 | speaker=unknown"
msgid "  Whether it was the huge mall full of countless specialty stores, or the crowded multi-purpose auditorium, there really was something for everyone here."
msgstr "　なにしろ大型デパートや各種専門店、多目的ホールで賑わう、県内有数の近代都市だ。"

#. Occurrence 9_3C:199:13320: scene=9_3C
#: 9_3C:199
msgctxt "text_id=13320 | speaker=unknown"
msgid "  For that reason, beyond its local residents, Arisaka's station was crowded with people from far and wide."
msgstr "　その結果、有坂駅前は地元の人々より、遠方からの来訪者が集まる歓楽地になっていた。"

#. Occurrence 9_3C:257:13321: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0000; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:257
msgctxt "text_id=13321 | speaker=aoko"
msgid "\"Cool. That must be their fancy new performance arts center."
msgstr "「へえ、あれが新しい演劇ホールかあ。"

#. Occurrence 9_3C:257:13322: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0000; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:257
msgctxt "text_id=13322 | speaker=aoko"
msgid "  It's supposed to have the biggest concert hall in the prefecture. I wonder what it's like inside. Look how much grander it is than the buildings around it!\""
msgstr "　県内最大のコンサートホールらしいけど、中はどうなってんだろ。なんか周りのビルより背が高くない？」"

#. Occurrence 9_3C:320:13323: scene=9_3C
#: 9_3C:320
msgctxt "text_id=13323 | speaker=unknown"
msgid "  They made their way to the aquarium, weaving through the crowds."
msgstr "　目当ての水族館に向かう途中、多くの人々とすれ違う。"

#. Occurrence 9_3C:325:13324: scene=9_3C
#: 9_3C:325
msgctxt "text_id=13324 | speaker=unknown"
msgid "  Aoko might have been used to city life,"
msgstr "　青子は雑踏に慣れたものだが、"

#. Occurrence 9_3C:330:13325: scene=9_3C
#: 9_3C:330
msgctxt "text_id=13325 | speaker=unknown"
msgid "  but Alice was silently anxious."
msgstr "　<傍|かたわ>らの有珠は終始無言だ。"

#. Occurrence 9_3C:364:13326: scene=9_3C
#: 9_3C:364
msgctxt "text_id=13326 | speaker=unknown"
msgid "  The people passing by must have thought this pale girl out of place, which Alice happened to agree with."
msgstr "　有珠自身も、有珠とすれ違う人々も、道を行く白い少女の姿に違和感を覚えている。"

#. Occurrence 9_3C:431:13327: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0001_0; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:431
msgctxt "text_id=13327 | speaker=aoko"
msgid "\"Oh! It says a big artist is coming summer of next year... "
msgstr "「来年夏にはビッグアーティストも来日予定……"

#. Occurrence 9_3C:444:13328: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0001_1; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:444
msgctxt "text_id=13328 | speaker=aoko"
msgid "Oh my god, it's Pink Trudy!"
msgstr "って、ピンクトゥルーデが入ってない！？"

msgctxt "text_id=13329 | speaker=unknown"
msgid "  Alice, this says it'll be their first live appearance in Japan!\""
msgstr "　ちょっと、これ日本初ライブよ有珠！？」"

#. Occurrence 9_3C:457:13330: scene=9_3C
#: 9_3C:457
msgctxt "text_id=13330 | speaker=unknown"
msgid "  Aoko exclaimed, overcome by excitement."
msgstr "　看板にある予定表に一喜一憂する青子。"

#. Occurrence 9_3C:500:13331: scene=9_3C
#: 9_3C:500
msgctxt "text_id=13331 | speaker=unknown"
msgid "  This kind of pop-rock band was right up Aoko's alley, but naturally, Alice did not seem very interested."
msgstr "　青子的に注目株のロックバンドらしいのだが、当然、有珠はあまり関心を持っていない。"

#. Occurrence 9_3C:532:13332: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0000; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:532
msgctxt "text_id=13332 | speaker=alice"
msgid "\"I'm more amazed by the Polish orchestra they've invited to open for them."
msgstr "「それより、セレモニーに予定されてるポーランド楽団の方が驚きだと思うけど。"

#. Occurrence 9_3C:538:13333: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0001; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:538
msgctxt "text_id=13333 | speaker=alice"
msgid "  This must be costing them a fortune."
msgstr "　随分とお金がかかっているようね。"

#. Occurrence 9_3C:545:13334: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0002; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:545
msgctxt "text_id=13334 | speaker=alice"
msgid "How incorrigible...\""
msgstr "……本当、懲りない人」"

#. Occurrence 9_3C:600:13335: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0002; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:600
msgctxt "text_id=13335 | speaker=aoko"
msgid "\"Ah.\""
msgstr "「あ」"

#. Occurrence 9_3C:610:13336: scene=9_3C
#: 9_3C:610
msgctxt "text_id=13336 | speaker=unknown"
msgid "  Aoko cursed under her breath before hurrying them along."
msgstr "　しまった、と口を<塞|ふさ>いで青子は足を速めた。"

#. Occurrence 9_3C:655:13337: scene=9_3C
#: 9_3C:655
msgctxt "text_id=13337 | speaker=unknown"
msgid "  Underneath the construction map read, \"With the support of the Kuonji Group.\""
msgstr "　建設予定図の下にはお馴染みの、久遠寺財閥ゆかりの企業名があったからだ。"

#. Occurrence 9_3C:721:13338: scene=9_3C
#: 9_3C:721
msgctxt "text_id=13338 | speaker=unknown"
msgid "  The aquarium they were looking for was on the top floor of a massive building."
msgstr "　お目当ての水族館は、高層ビルの最上階に造られていた。"

#. Occurrence 9_3C:762:13339: scene=9_3C
#: 9_3C:762
msgctxt "text_id=13339 | speaker=unknown"
msgid "  Maybe it was because it was no longer a new attraction,"
msgstr "　もう目新しさはないのか、"

#. Occurrence 9_3C:767:13340: scene=9_3C
#: 9_3C:767
msgctxt "text_id=13340 | speaker=unknown"
msgid "  or perhaps it was because the first-floor cinema drew the crowds..."
msgstr "　階下の映画館に客足をとられているのか。"

#. Occurrence 9_3C:772:13341: scene=9_3C
#: 9_3C:772
msgctxt "text_id=13341 | speaker=unknown"
msgid "  With only a few people scattered around the entrance, the atmosphere inside was very calm."
msgstr "　エントランスの人影はまばらで、館内の空気は落ち着いている。"

#. Occurrence 9_3C:792:13342: scene=9_3C
#: 9_3C:792
msgctxt "text_id=13342 | speaker=unknown"
msgid "  It wasn't quiet, but desolate,"
msgstr "　無音というほど寂しくはなく、"

#. Occurrence 9_3C:797:13343: scene=9_3C
#: 9_3C:797
msgctxt "text_id=13343 | speaker=unknown"
msgid "  and far removed from the hustle and bustle outside."
msgstr "　町中ほど騒がしくはない。"

#. Occurrence 9_3C:802:13344: scene=9_3C
#: 9_3C:802
msgctxt "text_id=13344 | speaker=unknown"
msgid "  Perhaps they were going for a museum-like mood."
msgstr "　そんな美術館さながらの<趣|おもむき>が気に入ったのか。"

#. Occurrence 9_3C:824:13345: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0003; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:824
msgctxt "text_id=13345 | speaker=alice"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 9_3C:829:13346: scene=9_3C
#: 9_3C:829
msgctxt "text_id=13346 | speaker=unknown"
msgid "  Alice quietly caught her breath, staring in awe."
msgstr "　有珠は静かに、感じ入るように息を呑んでいた。"

#. Occurrence 9_3C:849:13347: scene=9_3C
#: 9_3C:849
msgctxt "text_id=13347 | speaker=unknown"
msgid "  She was like a child seeing the circus for the first time,"
msgstr "　はじめてサーカスを見た子供のようだ。"

#. Occurrence 9_3C:854:13348: scene=9_3C
#: 9_3C:854
msgctxt "text_id=13348 | speaker=unknown"
msgid "  her eyes wide in anticipation and wonder."
msgstr "　驚きと期待に、知らず、目を見開かせている。"

#. Occurrence 9_3C:883:13349: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0003; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:883
msgctxt "text_id=13349 | speaker=aoko"
msgid "\"It's to the lady's liking I see. Good, good."
msgstr "「お、気に入ったみたいね。良かった良かった。"

#. Occurrence 9_3C:889:13350: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0004; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:889
msgctxt "text_id=13350 | speaker=aoko"
msgid "  I guess Soujyuro's idea wasn't totally off the mark, then, huh?\""
msgstr "　草十郎お薦めの物件は、気むずかしい有珠さんのお眼鏡にかないましたか」"

#. Occurrence 9_3C:895:13351: scene=9_3C
#: 9_3C:895
msgctxt "text_id=13351 | speaker=unknown"
msgid "  Aoko found herself smiling as well."
msgstr "　青子もつられて笑顔になる。"

#. Occurrence 9_3C:921:13352: scene=9_3C
#: 9_3C:921
msgctxt "text_id=13352 | speaker=unknown"
msgid "  There was a certain joy in seeing Alice's wonderment."
msgstr "　有珠の驚きはそれぐらい微笑ましいものだったのだ。"

#. Occurrence 9_3C:965:13353: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0004; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:965
msgctxt "text_id=13353 | speaker=alice"
msgid "\"Not really. I just find rooftop aquariums to be kind of novel.\""
msgstr "「……別に。屋上にある水族館が珍しいだけ」"

#. Occurrence 9_3C:971:13354: scene=9_3C
#: 9_3C:971
msgctxt "text_id=13354 | speaker=unknown"
msgid "  According to the guide on the wall, the entrance to the aquarium was nearly as big as the Kuonji mansion's foyer."
msgstr "　水族館のエントランスは久遠寺邸のホールほどの大きさで、壁には館内の見取り図が展示されている。"

#. Occurrence 9_3C:1006:13355: scene=9_3C
#: 9_3C:1006
msgctxt "text_id=13355 | speaker=unknown"
msgid "  The outdoor penguin show was apparently suspended due to the star penguin \"Flippy\" undergoing treatment for an injury."
msgstr "　野外のペンギンショウは休演中だった。ペンギンのペン太くんが怪我につき治療中らしい。"

#. Occurrence 9_3C:1011:13356: scene=9_3C
#: 9_3C:1011
msgctxt "text_id=13356 | speaker=unknown"
msgid "  It was an unfortunate state of affairs, but one that did not stop Alice from continuing to read over the guide. Apparently, she was quite familiar with penguin shows."
msgstr "　少し残念だが、有珠は気にとめず館内案内を目で追う。彼女にとってペンギンはそう珍しいものではないらしい。"

#. Occurrence 9_3C:1021:13357: scene=9_3C
#: 9_3C:1021
msgctxt "text_id=13357 | speaker=unknown"
msgid "  Then..."
msgstr "　……と。"

#. Occurrence 9_3C:1072:13358: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0005; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1072
msgctxt "text_id=13358 | speaker=alice"
msgid "\"...Eh?\""
msgstr "「―――、え」"

#. Occurrence 9_3C:1078:13359: scene=9_3C
#: 9_3C:1078
msgctxt "text_id=13359 | speaker=unknown"
msgid "\" I can't believe it,\""
msgstr "“そんな、嘘よ”……と。"

#. Occurrence 9_3C:1083:13360: scene=9_3C
#: 9_3C:1083
msgctxt "text_id=13360 | speaker=unknown"
msgid "  Alice quietly whimpered, as if holding back a scream."
msgstr "　有珠は悲鳴を飲みこむように喉を鳴らすのだった。"

#. Occurrence 9_3C:1104:13361: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0005; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:1104
msgctxt "text_id=13361 | speaker=aoko"
msgid "\"Hey hey, what's wrong?\""
msgstr "「なになに、どうしたの？」"

#. Occurrence 9_3C:1138:13362: scene=9_3C
#: 9_3C:1138
msgctxt "text_id=13362 | speaker=unknown"
msgid "  Aoko said, still looking at the floor plan."
msgstr "　館内案内を見る青子。"

#. Occurrence 9_3C:1143:13363: scene=9_3C
#: 9_3C:1143
msgctxt "text_id=13363 | speaker=unknown"
msgid "  It was rare to see Alice getting this emotional outside of the mansion."
msgstr "　屋敷内ではたまに見られるが、外で有珠が取り乱すのはまずあり得ない。"

#. Occurrence 9_3C:1148:13364: scene=9_3C
#: 9_3C:1148
msgctxt "text_id=13364 | speaker=unknown"
msgid "  For some reason, she was trembling."
msgstr "　一体なにが有珠を<戦|おのの>かせたのか。"

#. Occurrence 9_3C:1153:13365: scene=9_3C
#: 9_3C:1153
msgctxt "text_id=13365 | speaker=unknown"
msgid "  Nothing seemed terribly off about the aquarium's offerings."
msgstr "　案内にはこれといって珍しい部分はないが……"

#. Occurrence 9_3C:1193:13366: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0006; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1193
msgctxt "text_id=13366 | speaker=alice"
msgid "\"There's no giant tortoises.\""
msgstr "「ゾウガメがいない」"

#. Occurrence 9_3C:1229:13367: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0006; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:1229
msgctxt "text_id=13367 | speaker=aoko"
msgid "\"No what?\""
msgstr "「え？」"

#. Occurrence 9_3C:1240:13368: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0007; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1240
msgctxt "text_id=13368 | speaker=alice"
msgid "\"It's all wrong, Aoko."
msgstr "「話が違うわ青子。"

#. Occurrence 9_3C:1240:13369: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0007; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1240
msgctxt "text_id=13369 | speaker=alice"
msgid "  Why is there no giant tortoise exhibit?\""
msgstr "　どうしてゾウガメの展示スペースがないの？」"

#. Occurrence 9_3C:1280:13370: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0007; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:1280
msgctxt "text_id=13370 | speaker=aoko"
msgid "\"Why? I don't know. Are giant tortoises even aquatic? Maybe it's because they take up too much space.\""
msgstr "「どうしてって……そりゃあ、ゾウガメぐらいになったらもうほとんど陸上生物だからじゃない？　大きいし」"

#. Occurrence 9_3C:1298:13371: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0008; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1298
msgctxt "text_id=13371 | speaker=alice"
msgid "\"Why though? They have penguins. It's not fair."
msgstr "「なんで。ペンギンはいるのに、不公平よ。"

#. Occurrence 9_3C:1305:13372: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0009; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1305
msgctxt "text_id=13372 | speaker=alice"
msgid "Look, they even have a dolphin. This is absurd.\""
msgstr "イルカだって許せないわ」"

#. Occurrence 9_3C:1311:13373: scene=9_3C
#: 9_3C:1311
msgctxt "text_id=13373 | speaker=unknown"
msgid "  It was a bitter pill for Alice to swallow."
msgstr "　なんだかぜんぜん納得できない。"

#. Occurrence 9_3C:1316:13374: scene=9_3C
#: 9_3C:1316
msgctxt "text_id=13374 | speaker=unknown"
msgid "  The idea that they did not have a giant tortoise, despite having a dolphin, had Alice's eyes hot with indignation."
msgstr "　ゾウガメが不在ならイルカだって不在であるべきだ、と妙な公正さからメラメラ瞳を燃やす有珠だった。"

#. Occurrence 9_3C:1352:13375: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0008; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:1352
msgctxt "text_id=13375 | speaker=aoko"
msgid "\"Ahhh... Now that you mention it..."
msgstr "「あー……言われてみれば、確かに。"

#. Occurrence 9_3C:1358:13376: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0009; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:1358
msgctxt "text_id=13376 | speaker=aoko"
msgid "  If penguins and dolphins are standard fare, you'd have thought they would at least have a giant tortoise. What were they thinking?\""
msgstr "　ペンギンとイルカは定番なのに、なぜゾウガメだけ外されるのか。ちょっとした日常の落とし穴ね」"

#. Occurrence 9_3C:1364:13377: scene=9_3C
#: 9_3C:1364
msgctxt "text_id=13377 | speaker=unknown"
msgid "  Aoko said, certain something like a giant tortoise would be boring and unpopular."
msgstr "　ま、単に不人気だからだろうけど。"

#. Occurrence 9_3C:1369:13378: scene=9_3C
#: 9_3C:1369
msgctxt "text_id=13378 | speaker=unknown"
msgid "  She was sensible enough to read the room, however, and kept her thought to herself."
msgstr "　そんな感想を心の中だけに留める青子。彼女なりに空気を読んだ結果である。"

#. Occurrence 9_3C:1413:13379: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0010; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:1413
msgctxt "text_id=13379 | speaker=aoko"
msgid "\"Let's go, Alice. We have tickets so we can skip the line.\""
msgstr "「有珠、こっち。チケットはあるから、<販売機|そっち>に並ぶことはないわよ」"

#. Occurrence 9_3C:1436:13380: scene=9_3C
#: 9_3C:1436
msgctxt "text_id=13380 | speaker=unknown"
msgid "  A few moments after the giant tortoise fiasco..."
msgstr "　ゾウガメ論争から一分後。"

#. Occurrence 9_3C:1441:13381: scene=9_3C
#: 9_3C:1441
msgctxt "text_id=13381 | speaker=unknown"
msgid "  Presenting the tickets they received from Soujyuro, they headed toward the once popular entrance."
msgstr "　草十郎から貰ったチケットを受付に渡して、<人気|ひとけ>の途絶えた入り口に向かう。"

#. Occurrence 9_3C:1446:13382: scene=9_3C
#: 9_3C:1446
msgctxt "text_id=13382 | speaker=unknown"
msgid "  From the entrance gate, the corridor stretched into a dark hallway completely illuminated in blue."
msgstr "　青一色で染められたエントランスとは対照的に、ゲートから延びる通路は暗く細長い。"

#. Occurrence 9_3C:1489:13383: scene=9_3C
#: 9_3C:1489
msgctxt "text_id=13383 | speaker=unknown"
msgid "  Figures and faces became mere silhouettes in the darkness."
msgstr "　ここから先は隣人の顔も見えない密閉空間。"

#. Occurrence 9_3C:1494:13384: scene=9_3C
#: 9_3C:1494
msgctxt "text_id=13384 | speaker=unknown"
msgid "  It was no darkness born from magecraft, but a man-made area of twilight..."
msgstr "　魔術の手でもなく魔法の手でもない、文明の手によって現実と切り離された小宇宙だ。"

#. Occurrence 9_3C:1556:13385: scene=9_3C
#: 9_3C:1556
msgctxt "text_id=13385 | speaker=unknown"
msgid "  A world of shadow and blue, the only light being from the illuminated tanks."
msgstr "　水槽だけがライトアップされた、影と水色の世界。"

#. Occurrence 9_3C:1561:13386: scene=9_3C
#: 9_3C:1561
msgctxt "text_id=13386 | speaker=unknown"
msgid "  The two witches continued walking down the artificial ocean corridor."
msgstr "　ガラス一枚<隔|へだ>てた人工の海を眺めながら、ふたりの魔女は歩を進ませる。"

#. Occurrence 9_3C:1581:13387: scene=9_3C
#: 9_3C:1581
msgctxt "text_id=13387 | speaker=unknown"
msgid "  Water tanks seemed like windows into hundreds of different worlds."
msgstr "　百の<異世界|コロニー>を<航|わた>る旅。"

#. Occurrence 9_3C:1587:13388: scene=9_3C
#: 9_3C:1587
msgctxt "text_id=13388 | speaker=unknown"
msgid "  Each had their own separate temperature and environment."
msgstr "　それぞれ温度も環境も違う水槽たち。"

#. Occurrence 9_3C:1592:13389: scene=9_3C
#: 9_3C:1592
msgctxt "text_id=13389 | speaker=unknown"
msgid "  It was as if they were snapshots of the same place at different times."
msgstr "　ひとつひとつが同じようで別の時間。"

#. Occurrence 9_3C:1597:13390: scene=9_3C
#: 9_3C:1597
msgctxt "text_id=13390 | speaker=unknown"
msgid "  Mesmerized by the refracting images of the ocean floor, the housemates' conversation grew sparse."
msgstr "　光の屈折する<水底|みなそこ>では方角は不確かで、彼女たちの会話でさえ、断片的に消えていく。"

#. Occurrence 9_3C:1647:13391: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0011; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:1647
msgctxt "text_id=13391 | speaker=aoko"
msgid "\"That reminds me, Alice. You have this huge mansion without a pool. What's up with that?\""
msgstr "「そういえば、有珠の家ってあれだけ大きいのにプールとかないわよね。なんで？」"

#. Occurrence 9_3C:1671:13392: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0010; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1671
msgctxt "text_id=13392 | speaker=alice"
msgid "\"Figures. You come to an aquarium and that's what you think about."
msgstr "「……呆れた。水槽を観て何を想像したのかは聞かないけど。"

#. Occurrence 9_3C:1677:13393: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0011; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1677
msgctxt "text_id=13393 | speaker=alice"
msgid "  Wanting superfluous things is a bad habit of yours, Aoko.\""
msgstr "　必要ないものを欲しがるのは貴女の悪い癖ね、青子」"

#. Occurrence 9_3C:1701:13394: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0012; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:1701
msgctxt "text_id=13394 | speaker=aoko"
msgid "\"Aww, a pool isn't superfluous. Besides, aren't pools more common in England than Japan?"
msgstr "「えー、必要ないってコトはないんじゃない？　水遊びは<日|こ><本|っち>より<英国|そっち>の方が馴染み深いでしょうに。"

#. Occurrence 9_3C:1707:13395: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0013; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:1707
msgctxt "text_id=13395 | speaker=aoko"
msgid "  Or... could it be that you can't swim?\""
msgstr "　あ。もしかして有珠、泳げない？」"

#. Occurrence 9_3C:1746:13396: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0012; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1746
msgctxt "text_id=13396 | speaker=alice"
msgid "\"I've spent enough time in a swimsuit. I often swam in the lake as a child."
msgstr "「泳ぎの経験ぐらいあるわ。夏は湖で何度も遊んだもの。"

#. Occurrence 9_3C:1753:13397: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0013; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1753
msgctxt "text_id=13397 | speaker=alice"
msgid "And I never once lost a race to our big St. Bernard.\""
msgstr "わたし、大型のセントバーナードにだって負けなかったのよ」"

#. Occurrence 9_3C:1777:13398: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0014; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:1777
msgctxt "text_id=13398 | speaker=aoko"
msgid "\"A St. Bernard...? Wait, don't tell me. You had trouble with your breathing, didn't you?\""
msgstr "「セントバーナードって……有珠さんったら、もしかして<息|いき><継|つ>ぎとか苦手かしら？」"

#. Occurrence 9_3C:1796:13399: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0014; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1796
msgctxt "text_id=13399 | speaker=alice"
msgid "\"Ugh. Spare me the swimming lesson."
msgstr "「この世でもっとも聞きたくない言葉のひとつね。"

#. Occurrence 9_3C:1802:13400: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0015; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1802
msgctxt "text_id=13400 | speaker=alice"
msgid "  'Crawl'? 'Butterfly'? The people who invented those were probably half-fish anyway.\""
msgstr "　クロールとかバタフライとか、発明した人は半魚人になればいいのに」"

#. Occurrence 9_3C:1839:13401: scene=9_3C
#: 9_3C:1839
msgctxt "text_id=13401 | speaker=unknown"
msgid "  Clack, clack, clack."
msgstr "　かつ、かつ、かつ。"

#. Occurrence 9_3C:1845:13402: scene=9_3C
#: 9_3C:1845
msgctxt "text_id=13402 | speaker=unknown"
msgid "  Their pace was more delicate and solemn than a stroll along the beach."
msgstr "　海を巡る足取りは、普段のものよりおごそかに、繊細に。"

#. Occurrence 9_3C:1850:13403: scene=9_3C
#: 9_3C:1850
msgctxt "text_id=13403 | speaker=unknown"
msgid "  It was the sort of absent-minded chat one might hear between girls anywhere in the world."
msgstr "　少女たちの会話はうわのそら。"

#. Occurrence 9_3C:1855:13404: scene=9_3C
#: 9_3C:1855
msgctxt "text_id=13404 | speaker=unknown"
msgid "  In here, the only thing to do was look at blue screens."
msgstr "　ここでは、視線は青いスクリーンにのみ向けられるので。"

#. Occurrence 9_3C:1885:13405: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0015; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:1885
msgctxt "text_id=13405 | speaker=aoko"
msgid "\"I'm surprised you were willing to leave him alone in the house. You're not worried he'll go snooping in the west wing, are you?\""
msgstr "「でも驚いた。あんなにあっさり館の留守を任せるなんて。アイツがこっそり西館に入るかも、とか考えなかった？」"

#. Occurrence 9_3C:1891:13406: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0016; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1891
msgctxt "text_id=13406 | speaker=alice"
msgid "\"He... can't possibly be that foolish."
msgstr "「……彼、そこまで考えなしじゃないでしょう。"

#. Occurrence 9_3C:1897:13407: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0017; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1897
msgctxt "text_id=13407 | speaker=alice"
msgid "  Besides...\""
msgstr "　それに―――」"

#. Occurrence 9_3C:1915:13408: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0016; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:1915
msgctxt "text_id=13408 | speaker=aoko"
msgid "\"It'd save us trouble if he did?\""
msgstr "「それに、それならそれで手間が省けてせいせいした？」"

#. Occurrence 9_3C:1940:13409: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0018; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1940
msgctxt "text_id=13409 | speaker=alice"
msgid "\"...It's not that."
msgstr "「……そうじゃなくて。"

#. Occurrence 9_3C:1960:13410: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0019; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:1960
msgctxt "text_id=13410 | speaker=alice"
msgid "  I just don't think he's the type to break his word.\""
msgstr "　一度交わした約束は、破らないんじゃないかって」"

#. Occurrence 9_3C:1997:13411: scene=9_3C
#: 9_3C:1997
msgctxt "text_id=13411 | speaker=unknown"
msgid "  That he was not."
msgstr "　なるほど、そういうコトもあるだろう。"

#. Occurrence 9_3C:2002:13412: scene=9_3C
#: 9_3C:2002
msgctxt "text_id=13412 | speaker=unknown"
msgid "  Aoko nodded, her long hair waving back and forth,"
msgstr "　長い髪の少女は感心したように頷いた。"

#. Occurrence 9_3C:2007:13413: scene=9_3C
#: 9_3C:2007
msgctxt "text_id=13413 | speaker=unknown"
msgid "  a certain gleam of surprise in her eyes."
msgstr "　ちょっとだけ目が開いたところを見ると、驚きも何割か。"

#. Occurrence 9_3C:2013:13414: scene=9_3C
#: 9_3C:2013
msgctxt "text_id=13414 | speaker=unknown"
msgid "  Onward they meandered to the next aquatic world."
msgstr "　少女たちは次の世界にふわふわと。"

#. Occurrence 9_3C:2019:13415: scene=9_3C
#: 9_3C:2019
msgctxt "text_id=13415 | speaker=unknown"
msgid "  Clack, clack, clack."
msgstr "　かつ、かつ、かつ。"

#. Occurrence 9_3C:2055:13416: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0017; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2055
msgctxt "text_id=13416 | speaker=aoko"
msgid "\"By the way, is this your first time at an aquarium?\""
msgstr "「ところで、水族館は初めて？」"

#. Occurrence 9_3C:2061:13417: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0020; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:2061
msgctxt "text_id=13417 | speaker=alice"
msgid "\"Second. I went with a friend long ago.\""
msgstr "「これで二度目。昔、友達とふたりで行ったきりよ」"

#. Occurrence 9_3C:2085:13418: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0018; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2085
msgctxt "text_id=13418 | speaker=aoko"
msgid "\"No way. Really?\""
msgstr "「うそ、ほんと？」"

#. Occurrence 9_3C:2109:13419: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0021; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:2109
msgctxt "text_id=13419 | speaker=alice"
msgid "\"Yes, really. More than six years ago, when I was still in England.\""
msgstr "「本当。六年以上も前。まだイギリスにいた頃」"

#. Occurrence 9_3C:2115:13420: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0019; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2115
msgctxt "text_id=13420 | speaker=aoko"
msgid "\"No, I mean the friend part. I thought you said you didn't have any friends.\""
msgstr "「そうじゃなくて友達の方。アンタ、友人はいないって言ったじゃない」"

#. Occurrence 9_3C:2154:13421: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0022; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:2154
msgctxt "text_id=13421 | speaker=alice"
msgid "\"That was... a long time ago. We even had the same name."
msgstr "「……昔の話よ。わたしたち、同じ名前だったの。"

#. Occurrence 9_3C:2160:13422: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0023; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:2160
msgctxt "text_id=13422 | speaker=alice"
msgid "  We used to play all the time, but we fell out of touch.\""
msgstr "　それが縁でよく遊んでいたけれど、長続きはしなかったわ」"

#. Occurrence 9_3C:2184:13423: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0020; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2184
msgctxt "text_id=13423 | speaker=aoko"
msgid "\"That's right, Alice must be a pretty common name over there. Here it's all 'Ryoko' or 'Hanako' and such.\""
msgstr "「そっか、あっちじゃそう珍しくない名前なのね、アリスって。こっちでいうところの良子とか、花子みたいなもの？」"

#. Occurrence 9_3C:2203:13424: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0024; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:2203
msgctxt "text_id=13424 | speaker=alice"
msgid "\"Indeed. Or names referencing colors, like 'Aoko,' 'Akako,' 'Kuroko,' or 'Shirako.'\""
msgstr "「ええ。<青子|あおこ>とか<赤子|あかこ>とか、<黒子|くろこ>とか<白子|しらこ>みたいなものよ」"

#. Occurrence 9_3C:2221:13425: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0021; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2221
msgctxt "text_id=13425 | speaker=aoko"
msgid "\"They do all end with 'ko,' don't they...\""
msgstr "「……後半はみんな普通名詞なんですけど」"

#. Occurrence 9_3C:2258:13426: scene=9_3C
#: 9_3C:2258
msgctxt "text_id=13426 | speaker=unknown"
msgid "  To each their own, a society of names."
msgstr "　ひとつひとつに名前があるのが彼らの社会。"

#. Occurrence 9_3C:2263:13427: scene=9_3C
#: 9_3C:2263
msgctxt "text_id=13427 | speaker=unknown"
msgid "  The swirling of the waters was dizzying,"
msgstr "　水の中もくるくると目まぐるしいけれど、"

#. Occurrence 9_3C:2268:13428: scene=9_3C
#: 9_3C:2268
msgctxt "text_id=13428 | speaker=unknown"
msgid "  much like the hectic world of humans."
msgstr "　人間も人間で、いろいろどうでも忙しいよう。"

#. Occurrence 9_3C:2274:13429: scene=9_3C
#: 9_3C:2274
msgctxt "text_id=13429 | speaker=unknown"
msgid "  Their hands swung back and forth as they walked toward the next world."
msgstr "　少女たちは手を振りながら、次の世界にかつ、かつと。"

#. Occurrence 9_3C:2304:13430: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0025; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:2304
msgctxt "text_id=13430 | speaker=alice"
msgid "\"Incidentally, Aoko, what exactly is your plan for him?\""
msgstr "「そう言う青子は、彼をどうするつもりなの？」"

#. Occurrence 9_3C:2322:13431: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0022; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2322
msgctxt "text_id=13431 | speaker=aoko"
msgid "\"Well, once our current issue is resolved and things calm down, I'll find the rune for erasing his memory, and he'll forget we ever existed. He won't be a bother for much longer.\""
msgstr "「どうって、今の一件を終わらせるまで大人しくしてもらって、落ち着いたら忘却のルーン探して、なかった事にするだけでしょ？　これ以上迷惑かけられないわよ」"

#. Occurrence 9_3C:2328:13432: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0026; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:2328
msgctxt "text_id=13432 | speaker=alice"
msgid "\"...A bother to whom? Me?\""
msgstr "「……それは、わたしに？」"

#. Occurrence 9_3C:2362:13433: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0023_0; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2362
msgctxt "text_id=13433 | speaker=aoko"
msgid "\"Hm...? O-oh, yeah. Obviously."
msgstr "「へ……？　―――あ、うん、そう。そうに決まってるじゃない。"

#. Occurrence 9_3C:2381:13434: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0023_1; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2381
msgctxt "text_id=13434 | speaker=aoko"
msgid "Wow, this fish is really pretty! It makes me want to swim. Hey, we should go to the beach next summer!\""
msgstr "ところでこの魚、キレイよね。なんか泳ぎたくなってくる。有珠、来年の夏は海にでも行ってみよっか？」"

#. Occurrence 9_3C:2421:13435: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0027; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:2421
msgctxt "text_id=13435 | speaker=alice"
msgid "\"The beach... You mean...by the ocean?\""
msgstr "「海って……あの、海？」"

#. Occurrence 9_3C:2445:13436: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0024; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2445
msgctxt "text_id=13436 | speaker=aoko"
msgid "\"Of course. You know, fun under the hot summer sun, sand between your toes, watching the sun set on the horizon..."
msgstr "「もちろん。夏の海っていったら灼熱の太陽と砂浜、水平線に沈む夕日ってね。"

#. Occurrence 9_3C:2451:13437: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0025; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2451
msgctxt "text_id=13437 | speaker=aoko"
msgid "  We couldn't go this year, so why don't we go together next year?\""
msgstr "　今年は行けなかったけど、来年は一緒に行かない？」"

#. Occurrence 9_3C:2470:13438: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0028; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:2470
msgctxt "text_id=13438 | speaker=alice"
msgid "\"Your optimism is exhausting."
msgstr "「呆れた。本当、貴女って楽観的。"

#. Occurrence 9_3C:2476:13439: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0029; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:2476
msgctxt "text_id=13439 | speaker=alice"
msgid "  But... that does sound nice. If we manage to survive until next summer, that is.\""
msgstr "　……でも、そうね。夏まで生きていられたのなら、そういう事もあるかもしれない」"

#. Occurrence 9_3C:2513:13440: scene=9_3C
#: 9_3C:2513
msgctxt "text_id=13440 | speaker=unknown"
msgid "  Clack, clack, clack."
msgstr "　かつ、かつ、かつ。"

#. Occurrence 9_3C:2519:13441: scene=9_3C
#: 9_3C:2519
msgctxt "text_id=13441 | speaker=unknown"
msgid "  The two girls journeyed to the next oceanic wonderland,"
msgstr "　人間の少女たちは次の水場に跳んでいく。"

#. Occurrence 9_3C:2524:13442: scene=9_3C
#: 9_3C:2524
msgctxt "text_id=13442 | speaker=unknown"
msgid "  mutually taking in the sights."
msgstr "　眺めていたのはお互いさま。"

#. Occurrence 9_3C:2529:13443: scene=9_3C
#: 9_3C:2529
msgctxt "text_id=13443 | speaker=unknown"
msgid "  The visitors to these winter waters had begun to leave, satisfied by their tour."
msgstr "　冬の海に訪れた客人は、涼しい顔で消えていった。"

#. Occurrence 9_3C:2535:13444: scene=9_3C
#: 9_3C:2535
msgctxt "text_id=13444 | speaker=unknown"
msgid "  The sound of their footsteps heralded their farewell."
msgstr "　それではさよなら、かつ、かつ、ばたん。"

#. Occurrence 9_3C:2624:13445: scene=9_3C
#: 9_3C:2624
msgctxt "text_id=13445 | speaker=unknown"
msgid "  An hour into the wayfaring sea voyage..."
msgstr "　……徒歩による航海は一時間に及んだ。"

#. Occurrence 9_3C:2641:13446: scene=9_3C
#: 9_3C:2641
msgctxt "text_id=13446 | speaker=unknown"
msgid "  Losing themselves in the maze-like corridors of seemingly endless exhibits, they somehow found themselves on the next floor."
msgstr "　展示物の多さもさることながら、入り組んだ通路は迷路のようで、気付かないうちに一フロア上の階層にあがっていたりもした。"

#. Occurrence 9_3C:2646:13447: scene=9_3C
#: 9_3C:2646
msgctxt "text_id=13447 | speaker=unknown"
msgid "  Aoko had heard that the aquarium was situated on the top floor, and was shocked to find out there was yet another above it."
msgstr "　最上階と聞いていた事もあり、青子も二層構造と気付いた時は感心したものだ。"

#. Occurrence 9_3C:2690:13448: scene=9_3C
#: 9_3C:2690
msgctxt "text_id=13448 | speaker=unknown"
msgid "  It was likely by design that the actual top floor could only be accessed from within the aquarium."
msgstr "　おそらく、本当の最上階には水族館からしか行けない作りになっているのだろう。"

#. Occurrence 9_3C:2695:13449: scene=9_3C
#: 9_3C:2695
msgctxt "text_id=13449 | speaker=unknown"
msgid "  Moments of intrigue such as this are what attractions were made for."
msgstr "　どのようなアトラクションであれ、サプライズはあるに越したことはない。"

#. Occurrence 9_3C:2736:13450: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0026; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2736
msgctxt "text_id=13450 | speaker=aoko"
msgid "\"Alice?\""
msgstr "「有珠？」"

#. Occurrence 9_3C:2763:13451: scene=9_3C
#: 9_3C:2763
msgctxt "text_id=13451 | speaker=unknown"
msgid "  Turning this way and that, she found Alice had disappeared."
msgstr "　ふと振り返ると有珠の姿がない。"

#. Occurrence 9_3C:2768:13452: scene=9_3C
#: 9_3C:2768
msgctxt "text_id=13452 | speaker=unknown"
msgid "  Her houesmate had just been there, however, and Aoko took to looking for her."
msgstr "　さっきまで一緒にいたのに、と同居人の姿を探す。"

#. Occurrence 9_3C:2791:13453: scene=9_3C
#: 9_3C:2791
msgctxt "text_id=13453 | speaker=unknown"
msgid "  She soon found her nearby."
msgstr "　探し人はすぐに見つかった。"

#. Occurrence 9_3C:2796:13454: scene=9_3C
#: 9_3C:2796
msgctxt "text_id=13454 | speaker=unknown"
msgid "  Her white overcoat shone brightly in front of the dimly lit exhibit."
msgstr "　闇に映える白い<外套|コート>が、ライトアップされた水槽の前に佇んでいる。"

#. Occurrence 9_3C:2836:13455: scene=9_3C
#: 9_3C:2836
msgctxt "text_id=13455 | speaker=unknown"
msgid "  She was staring motionless into the water tank."
msgstr "　少女はじっと青い水槽を見つめていた。"

#. Occurrence 9_3C:2841:13456: scene=9_3C
#: 9_3C:2841
msgctxt "text_id=13456 | speaker=unknown"
msgid "  Alice almost looked to be staring through it, as though distracted by something."
msgstr "　散漫と、ありきたりな風景を見つめるように。"

#. Occurrence 9_3C:2862:13457: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0027; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2862
msgctxt "text_id=13457 | speaker=aoko"
msgid "\"What's wrong, Alice? Are you feeling okay?\""
msgstr "「どうしたの有珠？　気分でも悪くなった？」"

#. Occurrence 9_3C:2868:13458: scene=9_3C
#: 9_3C:2868
msgctxt "text_id=13458 | speaker=unknown"
msgid "  She spoke, hoping to snap her out of it."
msgstr "　微妙な様子の変化を感じて声をかける。"

#. Occurrence 9_3C:2873:13459: scene=9_3C
#: 9_3C:2873
msgctxt "text_id=13459 | speaker=unknown"
msgid "  Alice's typically cold aura seemed to have all but left her."
msgstr "　有珠の体にある、いつもの張りつめた空気がなくなっている気がしたからだ。"

#. Occurrence 9_3C:2940:13460: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0028; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:2940
msgctxt "text_id=13460 | speaker=aoko"
msgid "\"Is it a rare fish? ...This looks like the tank they use for all the fish that don't fit anywhere else.\""
msgstr "「珍しい魚でもいた？　それ、余り物を端においやりましたって感じの水槽だけど」"

#. Occurrence 9_3C:2946:13461: scene=9_3C
#: 9_3C:2946
msgctxt "text_id=13461 | speaker=unknown"
msgid "  Alice gave a noncommittal response."
msgstr "　有珠はそうね、とだけ返答した。"

#. Occurrence 9_3C:2951:13462: scene=9_3C
#: 9_3C:2951
msgctxt "text_id=13462 | speaker=unknown"
msgid "  Just ahead of her gaze was a single shadow."
msgstr "　少女の視線の先にあるのはひとつの影。"

#. Occurrence 9_3C:3011:13463: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0029; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:3011
msgctxt "text_id=13463 | speaker=aoko"
msgid "\"Wow, an ocean sunfish.\""
msgstr "「ワォ、マンボウ」"

#. Occurrence 9_3C:3017:13464: scene=9_3C
#: 9_3C:3017
msgctxt "text_id=13464 | speaker=unknown"
msgid "  Alice remained motionless, unresponsive to Aoko's sarcasm."
msgstr "　芝居がかった青子の声に、有珠は無言でうなずく。"

#. Occurrence 9_3C:3022:13465: scene=9_3C
#: 9_3C:3022
msgctxt "text_id=13465 | speaker=unknown"
msgid "  She stood in silence, watching the poor little fish, drifting listlessly in the tank where they put the fish that did not fit anywhere else, here at the end of the hall."
msgstr "　この、端においやられた水槽のさらに端っこで、彼は静かに漂っていた。"

#. Occurrence 9_3C:3078:13466: scene=9_3C
#: 9_3C:3078
msgctxt "text_id=13466 | speaker=unknown"
msgid "  To put it lightly, sunfish were not especially pleasant to look at."
msgstr "　一般的に言って、マンボウはカタチのいい魚ではない。"

#. Occurrence 9_3C:3083:13467: scene=9_3C
#: 9_3C:3083
msgctxt "text_id=13467 | speaker=unknown"
msgid "  When looking at one, it begged the question of what direction evolution wanted to take with it."
msgstr "　海を泳ぐ生物として、なぜこんな進化を？　と聞きたくなる形状だ。"

#. Occurrence 9_3C:3088:13468: scene=9_3C
#: 9_3C:3088
msgctxt "text_id=13468 | speaker=unknown"
msgid "  It looked like it swam using rudder-like fins on its top and bottom, but lacked the grace of other fish."
msgstr "　平べったい魚身の上下にある舵びれで泳ぐらしいが、他の魚のようなスピードは期待できまい。"

#. Occurrence 9_3C:3093:13469: scene=9_3C
#: 9_3C:3093
msgctxt "text_id=13469 | speaker=unknown"
msgid "  To Aoko, its eyes, body, and strange movements made it an awkward creature."
msgstr "　青子からすれば、体も目も、その在り方ものっぺりとした不思議生物である。"

#. Occurrence 9_3C:3098:13470: scene=9_3C
#: 9_3C:3098
msgctxt "text_id=13470 | speaker=unknown"
msgid "  But..."
msgstr "　が。"

#. Occurrence 9_3C:3153:13471: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0030; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:3153
msgctxt "text_id=13471 | speaker=aoko"
msgid "\"Hey, Alice, let's check out the whale shark exhibit over there. It sounds really exciting, don't you think?\""
msgstr "「ね。有珠、あっちの水槽みない？　ジンベエザメの回遊とか、<見|み><目|め><麗|うるわ>しいわよ？」"

#. Occurrence 9_3C:3191:13472: scene=9_3C
#: 9_3C:3191
msgctxt "text_id=13472 | speaker=unknown"
msgid "  Alice, unmoved, fixated on the sunfish."
msgstr "　有珠はこのように、マンボウに夢中である。"

#. Occurrence 9_3C:3211:13473: scene=9_3C
#: 9_3C:3211
msgctxt "text_id=13473 | speaker=unknown"
msgid "  It clumsily drifted around its tank, occasionally bumping into the glass as it turned."
msgstr "　ふらふらと漂う魚界の<金平糖|こんぺいとう>を見つめ、彼がうまく<転回|ターン>できずコツコツと水槽にぶつかる度に、"

#. Occurrence 9_3C:3227:13474: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0030; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:3227
msgctxt "text_id=13474 | speaker=alice"
msgid "\"Aoko, this little one can't swim well.\""
msgstr "「青子。この子、泳ぐのが下手だわ」"

#. Occurrence 9_3C:3281:13475: scene=9_3C
#: 9_3C:3281
msgctxt "text_id=13475 | speaker=unknown"
msgid "  Alice extended her finger toward the glass, then retracted it, feeling childish."
msgstr "　水槽に触れようと指を伸ばし、大人げないと引っ込めていた。"

#. Occurrence 9_3C:3310:13476: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0031; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:3310
msgctxt "text_id=13476 | speaker=aoko"
msgid "\"Well, whatever. I suppose sunfish have their own charm.\""
msgstr "「……ま、いっか。<愛嬌|あいきょう>だけはあるしね、マンボウ」"

#. Occurrence 9_3C:3316:13477: scene=9_3C
#: 9_3C:3316
msgctxt "text_id=13477 | speaker=unknown"
msgid "  It did not seem like Alice was going to budge."
msgstr "　こうなっては有珠はテコでも動かない。"

#. Occurrence 9_3C:3329:13478: scene=9_3C
#: 9_3C:3329
msgctxt "text_id=13478 | speaker=unknown"
msgid "  Resigning herself, Aoko stayed with Alice while she stared at the cushion-shaped fish."
msgstr "　仕方ないと観念して、青子は有珠に付き合い、<座布団|ざぶとん>のような硬骨魚を眺めるのだった。"

#. Occurrence 9_3C:3358:13479: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0032; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:3358
msgctxt "text_id=13479 | speaker=aoko"
msgid "\"Huh. They have eyes like puffer fish. It also says here that the females can produce more eggs than any other known vertebrate, up to three hundred million at a time. Neat..."
msgstr "「へー。マンボウってフグ目だったんだ。なになに、マンボウのメスは一度に三億個の卵を海中に放出する、地上でもっとも多くの卵を産む脊椎動物である……なるほどねー。"

#. Occurrence 9_3C:3364:13480: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0033; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:3364
msgctxt "text_id=13480 | speaker=aoko"
msgid "  The babies become prey to other fish, so in a way giving birth to so many is a means of survival for them.\""
msgstr "　他の魚たちにとっちゃ格好のエサになるから、多く産むこと、それ自体が生存のための手段になるワケか」"

#. Occurrence 9_3C:3424:13481: scene=9_3C
#: 9_3C:3424
msgctxt "text_id=13481 | speaker=unknown"
msgid "  Though Aoko seemed taken in by the biological details of the fish, Alice couldn't have cared less."
msgstr "　興味深く解説を読む青子だが、有珠はマンボウの生態はどうでもいいらしい。"

#. Occurrence 9_3C:3429:13482: scene=9_3C
#: 9_3C:3429
msgctxt "text_id=13482 | speaker=unknown"
msgid "  She was lost in the ebb and flow of emotions between wonder and woe with every clumsy bump of the fish into the glass."
msgstr "　平たい魚影がコツコツと水槽の壁に当たるたび、目を輝かせたり、落ちこんだりする。"

#. Occurrence 9_3C:3434:13483: scene=9_3C
#: 9_3C:3434
msgctxt "text_id=13483 | speaker=unknown"
msgid "  Out of nowhere, she softly spoke."
msgstr "　そんな中、不意に少女は呟いた。"

#. Occurrence 9_3C:3440:13484: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0031; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:3440
msgctxt "text_id=13484 | speaker=alice"
msgid "\"About before...\""
msgstr "「さっきの話だけど」"

#. Occurrence 9_3C:3468:13485: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0034; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:3468
msgctxt "text_id=13485 | speaker=aoko"
msgid "\"Huh? Before? When?\""
msgstr "「へ？　さっきの話って、なに？」"

#. Occurrence 9_3C:3491:13486: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0032; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:3491
msgctxt "text_id=13486 | speaker=alice"
msgid "\"About him. About leaving the house in his care.\""
msgstr "「彼について。留守を任せるとか、そういうの」"

#. Occurrence 9_3C:3511:13487: scene=9_3C
#: 9_3C:3511
msgctxt "text_id=13487 | speaker=unknown"
msgid "  It seemed like Alice had returned to her normal self."
msgstr "　気が付けば、少女はいつもの姿に戻っていた。"

#. Occurrence 9_3C:3516:13488: scene=9_3C
#: 9_3C:3516
msgctxt "text_id=13488 | speaker=unknown"
msgid "  There was that cold aura."
msgstr "　張りつめた空気。"

#. Occurrence 9_3C:3521:13489: scene=9_3C
#: 9_3C:3521
msgctxt "text_id=13489 | speaker=unknown"
msgid "  Whether inside the mansion or out, that stubborn chill that pushed people away was back."
msgstr "　何処であろうと、あの洋館の中であろうと、<頑|かたく>なに人を拒む冷たさに。"

#. Occurrence 9_3C:3542:13490: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0033; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:3542
msgctxt "text_id=13490 | speaker=alice"
msgid "\"I haven't changed my mind."
msgstr "「わたしの気が変わった訳じゃないわ。"

#. Occurrence 9_3C:3548:13491: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0034; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:3548
msgctxt "text_id=13491 | speaker=alice"
msgid "  He is still a complete unknown. How can I trust someone I know nothing about?\""
msgstr "　依然として彼の事は分からないもの。分からない人を、どうやって信頼すればいいの？」"

#. Occurrence 9_3C:3573:13492: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0035; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:3573
msgctxt "text_id=13492 | speaker=aoko"
msgid "\"...I guess. But then why let him...?\""
msgstr "「……まあね。でも、じゃあどうして？」"

#. Occurrence 9_3C:3579:13493: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0035; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:3579
msgctxt "text_id=13493 | speaker=alice"
msgid "\"Because I know you, Aoko. You always make the right decision. So... I'm trusting your judgment on the matter.\""
msgstr "「青子の事は分かるわ。貴女はいつも正しい選択をする。……だから、青子を信じる彼の人間性は、信じてもいい」"

#. Occurrence 9_3C:3600:13494: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0036; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:3600
msgctxt "text_id=13494 | speaker=aoko"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 9_3C:3641:13495: scene=9_3C
#: 9_3C:3641
msgctxt "text_id=13495 | speaker=unknown"
msgid "  It was true. She did not know Soujyuro, nor had any intention to."
msgstr "　草十郎の事は分からないし、理解する気もない。"

#. Occurrence 9_3C:3646:13496: scene=9_3C
#: 9_3C:3646
msgctxt "text_id=13496 | speaker=unknown"
msgid "  But because of her trust in Aoko, she could trust in Aoko's decision to allow him to stay."
msgstr "　けれど、<有珠|じぶん>の協力者である青子を信じているのなら、その選択に免じて許してもいい。"

#. Occurrence 9_3C:3652:13497: scene=9_3C
#: 9_3C:3652
msgctxt "text_id=13497 | speaker=unknown"
msgid "  It seemed Alice was challenging her own feelings."
msgstr "　有珠は今の自分の感情を、そう落としこんだらしい。"

#. Occurrence 9_3C:3685:13498: scene=9_3C
#: 9_3C:3685
msgctxt "text_id=13498 | speaker=unknown"
msgid "  She said she could not trust someone she did not know."
msgstr "　分からない人は信頼できない、と少女は言う。"

#. Occurrence 9_3C:3690:13499: scene=9_3C
#: 9_3C:3690
msgctxt "text_id=13499 | speaker=unknown"
msgid "  In other words, she wished to trust him, and in order to do so, she needed to know more about him."
msgstr "　けれど逆に言えば、それは―――誰かを信じたいから、深く理解したいと望んでいるようにもとれた。"

#. Occurrence 9_3C:3724:13500: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0037; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:3724
msgctxt "text_id=13500 | speaker=aoko"
msgid "\"Well, I don't really know how to respond to that, Alice."
msgstr "「……ま、口にするのは何だからつっこまないけどね。"

#. Occurrence 9_3C:3766:13501: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_3C_0038; voice_prefix=A10; voice_category=1; scene=9_3C
#: 9_3C:3766
msgctxt "text_id=13501 | speaker=aoko"
msgid "  Also, I had no idea you trusted me that much.\""
msgstr "　それより、なに？　そんなに私のこと信頼してくれてたの、有珠？」"

#. Occurrence 9_3C:3772:13502: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0036; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:3772
msgctxt "text_id=13502 | speaker=alice"
msgid "\"I do trust you. I may not be fond of you, but I trust you."
msgstr "「……ええ。好意はともかく、信頼だけはしているわ。"

#. Occurrence 9_3C:3778:13503: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0037; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:3778
msgctxt "text_id=13503 | speaker=alice"
msgid "  Because we're partners in crime, aren't we?\""
msgstr "　だって共犯者でしょう、わたしたち」"

#. Occurrence 9_3C:3863:13504: scene=9_3C
#: 9_3C:3863
msgctxt "text_id=13504 | speaker=unknown"
msgid "  Her white coat swayed to and fro."
msgstr "　白いコートが揺れる。"

#. Occurrence 9_3C:3868:13505: scene=9_3C
#: 9_3C:3868
msgctxt "text_id=13505 | speaker=unknown"
msgid "  Just like that, their short excursion had come to an end."
msgstr "　……ひとときの旅は終わった。"

#. Occurrence 9_3C:3873:13506: scene=9_3C
#: 9_3C:3873
msgctxt "text_id=13506 | speaker=unknown"
msgid "  Straight ahead was the exit back to the real world."
msgstr "　水の国の出口はすぐそこだ。"

#. Occurrence 9_3C:3878:13507: scene=9_3C
#: 9_3C:3878
msgctxt "text_id=13507 | speaker=unknown"
msgid "  A step away from the exhibit was a step toward becoming better roommates."
msgstr "　少女は水槽から視線を逸らして、付き合いのいい同居人へと歩きだした。"

#. Occurrence 9_3C:3939:13508: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_3C_0038; voice_prefix=A40; voice_category=2; scene=9_3C
#: 9_3C:3939
msgctxt "text_id=13508 | speaker=alice"
msgid "\"...Such a kind face, but so clearly scarred.\""
msgstr "「……優しい顔をしているのに、傷だらけね」"

#. Occurrence 9_3C:3951:13509: scene=9_3C
#: 9_3C:3951
msgctxt "text_id=13509 | speaker=unknown"
msgid "  One last, small whisper."
msgstr "　最後に小さく。"

#. Occurrence 9_3C:3956:13510: scene=9_3C
#: 9_3C:3956
msgctxt "text_id=13510 | speaker=unknown"
msgid "  And with that, she bid farewell to the lonely figure in the tank."
msgstr "　水槽の孤影に別れを告げるよう、呟いて。"

#. Occurrence 9_4:67:13511: scene=9_4
#: 9_4:67
msgctxt "text_id=13511 | speaker=unknown"
msgid "  The sun set early during winter."
msgstr "　冬の日没は早い。"

#. Occurrence 9_4:72:13512: scene=9_4
#: 9_4:72
msgctxt "text_id=13512 | speaker=unknown"
msgid "  By four in the afternoon, it had already fallen below the horizon."
msgstr "　午後の斜陽が完全に失われた午後四時。"

#. Occurrence 9_4:77:13513: scene=9_4
#: 9_4:77
msgctxt "text_id=13513 | speaker=unknown"
msgid "  Evening seemed to arrive at the mansion earlier than in the city."
msgstr "　洋館は町中よりいくぶん早く夕暮れを迎えようとしている。"

#. Occurrence 9_4:107:13514: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0000; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:107
msgctxt "text_id=13514 | speaker=soujuurou"
msgid "\"I see. Now I know all about crocodiles.\""
msgstr "「―――なるほど。君の生態はよく解った」"

#. Occurrence 9_4:113:13515: scene=9_4
#: 9_4:113
msgctxt "text_id=13515 | speaker=unknown"
msgid "  Soujyuro sat alone, sipping his warm tea in the chilly room."
msgstr "　冷えこんできた中、お茶だけを<暖|だん>にして草十郎はひとりうなずいた。"

#. Occurrence 9_4:129:13516: scene=9_4
#: 9_4:129
msgctxt "text_id=13516 | speaker=unknown"
msgid "  He relaxed on the couch staring out the window, having had his fill of crocodiles."
msgstr "　いいかげんワニは飽きたのか、ソファーに身を預けて、ぼんやりと窓の外を眺めている。"

#. Occurrence 9_4:160:13517: scene=9_4
#: 9_4:160
msgctxt "text_id=13517 | speaker=unknown"
msgid "  Once he sprawled out on the sofa, his body refused to move. Maybe he'd had always wanted to try it."
msgstr "　一度やってみたかったのか、ソファーに寝そべったまま草十郎は動かない。"

#. Occurrence 9_4:165:13518: scene=9_4
#: 9_4:165
msgctxt "text_id=13518 | speaker=unknown"
msgid "  After three straight hours of crocodile-watching, he intently pondered what it would be like to laze there for the remainder of the day like a reptile."
msgstr "　三時間近くワニを観察していた影響か、あんなふうに日がな一日横になって暮らすのはどんな気持ちなのか、と真剣に悩んでいるようにも見える。"

#. Occurrence 9_4:186:13519: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0001; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:186
msgctxt "text_id=13519 | speaker=soujuurou"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence 9_4:192:13520: scene=9_4
#: 9_4:192
msgctxt "text_id=13520 | speaker=unknown"
msgid "  Just as he was considering the opportunity nap until Aoko and Alice returned, an unnatural noise echoed through the halls of the mansion."
msgstr "　いい機会だし、いっそ青子たちが帰ってくるまでソファーで眠ってみようか、などと草十郎が考えた矢先、洋館には不釣り合いな怪音が響いてきた。"

#. Occurrence 9_4:225:13521: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0002; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:225
msgctxt "text_id=13521 | speaker=soujuurou"
msgid "\"...?\""
msgstr "「……？」"

#. Occurrence 9_4:231:13522: scene=9_4
#: 9_4:231
msgctxt "text_id=13522 | speaker=unknown"
msgid "  Sluggishly, he rose from all fours to a bipedal state, as if undergoing an evolution of his own."
msgstr "　<四足|ワニ>から<二足|ヒト>に進化するように、のっそりと起き上がる。"

#. Occurrence 9_4:236:13523: scene=9_4
#: 9_4:236
msgctxt "text_id=13523 | speaker=unknown"
msgid "  It was a knocking sound that repeated itself regularly, with patient pauses in between."
msgstr "　ごんごん、という音は辛抱強く定期的に続いていた。"

#. Occurrence 9_4:241:13524: scene=9_4
#: 9_4:241
msgctxt "text_id=13524 | speaker=unknown"
msgid "  He recognized the cadence from something he'd experienced at his apartment before."
msgstr "　アパート暮らしの時に何度か経験した、玄関からの呼び音である。"

#. Occurrence 9_4:263:13525: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0003; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:263
msgctxt "text_id=13525 | speaker=soujuurou"
msgid "\"...Hm? A newspaper salesman?\""
msgstr "「……むう。新聞の勧誘か？」"

#. Occurrence 9_4:269:13526: scene=9_4
#: 9_4:269
msgctxt "text_id=13526 | speaker=unknown"
msgid "  Making for the foyer, Soujyuro was impressed that they had hiked all the way up the hill."
msgstr "　こんな丘の上までたいしたもんだ、と感心しながら草十郎はロビーに向かった。"

#. Occurrence 9_4:311:13527: scene=9_4
#: 9_4:311
msgctxt "text_id=13527 | speaker=unknown"
msgid "  The knocking resounded eerily."
msgstr "　音は妙に響き渡る。"

#. Occurrence 9_4:316:13528: scene=9_4
#: 9_4:316
msgctxt "text_id=13528 | speaker=unknown"
msgid "  Without a doorbell of any kind, visitors had no choice but to rap on the door using whatever they had in hand."
msgstr "　あの玄関には呼び鈴らしきものはないし、来訪者はいかなる道具で扉を叩いているのか。"

#. Occurrence 9_4:321:13529: scene=9_4
#: 9_4:321
msgctxt "text_id=13529 | speaker=unknown"
msgid "  It would take a literal iron fist to produce the din Soujyuro heard now."
msgstr "　手だとしたら、なんていうか、<畏|い><怖|ふ>すべき鉄拳勧誘である。"

#. Occurrence 9_4:368:13530: scene=9_4
#: 9_4:368
msgctxt "text_id=13530 | speaker=unknown"
msgid "  From his position in the hall, the front door looked like an ornately built fortification."
msgstr "　館の入り口にあたる玄関は、草十郎から見れば要塞の如き堅固さ、豪華さだ。"

#. Occurrence 9_4:373:13531: scene=9_4
#: 9_4:373
msgctxt "text_id=13531 | speaker=unknown"
msgid "  The sturdy double doors looked as though they could withstand any onslaught of blows."
msgstr "　両開きの扉は頑丈で、<破城鎚|はじょうづち>でも持ってこないかぎり破られる事はないだろう。"

#. Occurrence 9_4:385:13532: scene=9_4
#: 9_4:385
msgctxt "text_id=13532 | speaker=unknown"
msgid "  But now, they rattled in protest to the repeated knocking."
msgstr "　そんな扉が、何度目かのノックで悲鳴を上げるように軋んでいる。"

#. Occurrence 9_4:405:13533: scene=9_4
#: 9_4:405
msgctxt "text_id=13533 | speaker=unknown"
msgid "  Whoever the visitor was, they seemed determined to breach the castle gate by force if its defender refused to sally forth."
msgstr "　どうも相手は、このまま出てこないのなら城門突破も<辞|じ>さないかまえらしい。"

#. Occurrence 9_4:410:13534: scene=9_4
#: 9_4:410
msgctxt "text_id=13534 | speaker=unknown"
msgid "  Fortunately for them, Soujyuro was sympathetic, having experience selling newspapers himself."
msgstr "　新聞の勧誘バイトも経験済みの草十郎である。なので、"

#. Occurrence 9_4:430:13535: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0004; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:430
msgctxt "text_id=13535 | speaker=soujuurou"
msgid "\"Just a second!\""
msgstr "「はーい、いま開けまーす」"

#. Occurrence 9_4:436:13536: scene=9_4
#: 9_4:436
msgctxt "text_id=13536 | speaker=unknown"
msgid "  He knew what it was like to be in those shoes, so was unsurprised by their persistence."
msgstr "　彼らは彼らなりに必死な事を知っているので、別段そこには驚かなかった。"

#. Occurrence 9_4:537:13537: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0005; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:537
msgctxt "text_id=13537 | speaker=soujuurou"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence 9_4:543:13538: scene=9_4
#: 9_4:543
msgctxt "text_id=13538 | speaker=unknown"
msgid "  There stood the second surprise of the day."
msgstr "　それは本日二度目の、正体不明の驚きだった。"

#. Occurrence 9_4:548:13539: scene=9_4
#: 9_4:548
msgctxt "text_id=13539 | speaker=unknown"
msgid "  Soujyuro was struck speechless."
msgstr "　草十郎は言葉なく立ち尽くす。"

#. Occurrence 9_4:582:13540: scene=9_4
#: 9_4:582
msgctxt "text_id=13540 | speaker=unknown"
msgid "  He was greeted by a young woman who hardly looked the part of a newspaper hawker."
msgstr "　新聞の勧誘にしては珍しく、若い女性だったから……ではない。"

#. Occurrence 9_4:587:13541: scene=9_4
#: 9_4:587
msgctxt "text_id=13541 | speaker=unknown"
msgid "  Standing in the courtyard against a dusk-lit horizon, she appeared more at home in the European mansion than Soujyuro did."
msgstr "　日没前の中庭を背景にした女性の姿は、自分なんかよりよほど、この洋館に相応しく思えたからだ。"

#. Occurrence 9_4:622:13542: scene=9_4
#: 9_4:622
msgctxt "text_id=13542 | speaker=unknown"
msgid "  She carried a dignified air, in spite of her dainty frame."
msgstr "　細いが、しかし、凛とした女性だった。"

#. Occurrence 9_4:627:13543: scene=9_4
#: 9_4:627
msgctxt "text_id=13543 | speaker=unknown"
msgid "  While a tad shorter than Soujyuro, she was tall for her sex."
msgstr "　背の程は草十郎よりやや低い。女性としては長身の部類だろう。"

#. Occurrence 9_4:632:13544: scene=9_4
#: 9_4:632
msgctxt "text_id=13544 | speaker=unknown"
msgid "  Her green clothing was subtly colored yet flashy, and clearly inspired by foreign fashion."
msgstr "　緑色の服は地味な色彩のクセに派手で、この国の文化とは系統が違っていた。"

#. Occurrence 9_4:652:13545: scene=9_4
#: 9_4:652
msgctxt "text_id=13545 | speaker=unknown"
msgid "  She seemed prim and proper, yet bold―"
msgstr "　<清楚|せいそ>なのに堂々としている。"

#. Occurrence 9_4:657:13546: scene=9_4
#: 9_4:657
msgctxt "text_id=13546 | speaker=unknown"
msgid "  though vaguely garish, her appearance spoke of strength and confidence."
msgstr "　華やかなようで、その実、強い芯が通っている感じ。"

#. Occurrence 9_4:684:13547: scene=9_4
#: 9_4:684
msgctxt "text_id=13547 | speaker=unknown"
msgid "  Soujyuro knew all too well that such a woman was not to be trifled with."
msgstr "　そんな、本来ならあまり混ざらない要素を持つ女性を、草十郎はよく知っている。"

#. Occurrence 9_4:725:13548: scene=9_4
#: 9_4:725
msgctxt "text_id=13548 | speaker=unknown"
msgid "  Only, unlike the one he knew, this stranger appeared more friendly than intimidating."
msgstr "　ただ、草十郎の知っている彼女と違い、この女性は威圧より優しさの方が際だっていた。"

#. Occurrence 9_4:730:13549: scene=9_4
#: 9_4:730
msgctxt "text_id=13549 | speaker=unknown"
msgid "  Perhaps it was her short hair that made her look approachable."
msgstr "　中性的に見えるのは短髪だからだろう。"

#. Occurrence 9_4:735:13550: scene=9_4
#: 9_4:735
msgctxt "text_id=13550 | speaker=unknown"
msgid "  Bright and brown, it stopped just above the nape of her neck."
msgstr "　見るも鮮やかなブラウンの髪はうなじまでしかない。"

#. Occurrence 9_4:740:13551: scene=9_4
#: 9_4:740
msgctxt "text_id=13551 | speaker=unknown"
msgid "  Soujyuro silently thought that it was a shame she hadn't grown it out."
msgstr "　呆然と、もったいないな、と思う草十郎だった。"

#. Occurrence 9_4:765:13552: scene=9_4
#: 9_4:765
msgctxt "text_id=13552 | speaker=unknown"
msgid "  She looked at him and offered a smile."
msgstr "　そんな草十郎を見て、女性は小さく微笑んだ。"

#. Occurrence 9_4:770:13553: scene=9_4
#: 9_4:770
msgctxt "text_id=13553 | speaker=unknown"
msgid "  Despite seeming visibly older than him, this made her appear impish and cute."
msgstr "　ずいぶん年上のように見えるのに、そんな仕草が悪戯っぽくて可愛いことこの上ない。"

#. Occurrence 9_4:809:13554: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0006; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:809
msgctxt "text_id=13554 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 9_4:814:13555: scene=9_4
#: 9_4:814
msgctxt "text_id=13555 | speaker=unknown"
msgid "  Soujyuro reacted with suspicion, knowing better by now than to fall for a charming smile."
msgstr "　自分は惚れっぽい<性質|たち>ではないと信じていた草十郎だが、なんだかそれも怪しいな、とうなだれる。"

#. Occurrence 9_4:819:13556: scene=9_4
#: 9_4:819
msgctxt "text_id=13556 | speaker=unknown"
msgid "  At any rate, it was rude to stare."
msgstr "　ともあれ、こうして黙りこんでいては失礼だ。"

#. Occurrence 9_4:855:13557: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0007; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:855
msgctxt "text_id=13557 | speaker=soujuurou"
msgid "\"Um, can I help you?\""
msgstr "「ええと、どちら様でしょうか」"

#. Occurrence 9_4:861:13558: scene=9_4
#: 9_4:861
msgctxt "text_id=13558 | speaker=unknown"
msgid "  He tried not to look flustered as he greeted the visitor."
msgstr "　微妙にドギマギしている心臓を落ち着けて問いかける。"

#. Occurrence 9_4:866:13559: scene=9_4
#: 9_4:866
msgctxt "text_id=13559 | speaker=unknown"
msgid "  To which she replied,"
msgstr "　それに、"

#. Occurrence 9_4:905:13560: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0000; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:905
msgctxt "text_id=13560 | speaker=touko"
msgid "\"Good evening. Is Aoko home?\""
msgstr "「こんばんは。青子います？」"

#. Occurrence 9_4:929:13561: scene=9_4
#: 9_4:929
msgctxt "text_id=13561 | speaker=unknown"
msgid "  She smiled as she used Aoko's first name with a familiar tone."
msgstr "　女性は青子という言葉に親しみをこめて、笑顔で返してきたのだった。"

#. Occurrence 9_4:980:13562: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0008; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:980
msgctxt "text_id=13562 | speaker=soujuurou"
msgid "\"Aozaki isn't home right now.\""
msgstr "「蒼崎はいないんです」"

#. Occurrence 9_4:1015:13563: scene=9_4
#: 9_4:1015
msgctxt "text_id=13563 | speaker=unknown"
msgid "  She smiled again, this time deviously upon learning of Aoko's absence."
msgstr "　青子の留守を告げる草十郎に、女性はあら、という意外そうな顔をした。"

#. Occurrence 9_4:1042:13564: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0001; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1042
msgctxt "text_id=13564 | speaker=touko"
msgid "\"Then I take it Miss Kuonji is away, too?\""
msgstr "「それじゃあ久遠寺さんも留守なんだ」"

#. Occurrence 9_4:1048:13565: scene=9_4
#: 9_4:1048
msgctxt "text_id=13565 | speaker=unknown"
msgid "  Soujyuro looked perplexed."
msgstr "　草十郎はしばし戸惑う。"

#. Occurrence 9_4:1053:13566: scene=9_4
#: 9_4:1053
msgctxt "text_id=13566 | speaker=unknown"
msgid "  This was the first time he had heard Alice referred to by her last name only, and again, with the familiarity of an old friend."
msgstr "　有珠を『久遠寺』と呼ぶ人間は今までいなかった。それも親しげに、十年来の友人のようにだ。"

#. Occurrence 9_4:1081:13567: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0002; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1081
msgctxt "text_id=13567 | speaker=touko"
msgid "\"I see. It's nice to hear that they can get out during the day, instead of only during the dead of night."
msgstr "「そっかあ。夜ならともかく、日中から二人で出かけるとは感心感心。"

#. Occurrence 9_4:1088:13568: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0003; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1088
msgctxt "text_id=13568 | speaker=touko"
msgid "I was under the impression that living together was merely a facade, but they really do get along.\""
msgstr "カタチだけの雑居だろうと思ったけど、ちゃんと上手くいってるのね」"

#. Occurrence 9_4:1108:13569: scene=9_4
#: 9_4:1108
msgctxt "text_id=13569 | speaker=unknown"
msgid "  Soujyuro found himself nodding in response to her smile."
msgstr "　にこりと微笑まれて、つい頷く草十郎。"

#. Occurrence 9_4:1113:13570: scene=9_4
#: 9_4:1113
msgctxt "text_id=13570 | speaker=unknown"
msgid "  It was strange enough that the visitor knew both Aoko and Alice, but Soujyuro found her odd as well."
msgstr "　青子たちと面識がありそうなのも驚きだが、この女性はそもそも印象がおかしい。"

#. Occurrence 9_4:1118:13571: scene=9_4
#: 9_4:1118
msgctxt "text_id=13571 | speaker=unknown"
msgid "  Likely in her early twenties, she did not appear much older than he was."
msgstr "　歳の頃は二十代前半だろうけれど、そう<草十郎|じぶん>と歳が離れている気がしない。"

#. Occurrence 9_4:1123:13572: scene=9_4
#: 9_4:1123
msgctxt "text_id=13572 | speaker=unknown"
msgid "  She was clearly hiding something behind her nonchalant manner and bright smile."
msgstr "　屈託のない口調と明るい表情が、本来の美貌を<曖昧|あいまい>にしているような。"

#. Occurrence 9_4:1151:13573: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0004; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1151
msgctxt "text_id=13573 | speaker=touko"
msgid "\"So they won't be home until the evening, then?\""
msgstr "「それじゃあ、帰ってくるにしても夜？」"

#. Occurrence 9_4:1169:13574: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0009; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:1169
msgctxt "text_id=13574 | speaker=soujuurou"
msgid "\"That's correct, though I expect them back before the last train.\""
msgstr "「はい。終電前には帰ってくると思いますけど」"

#. Occurrence 9_4:1175:13575: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0005; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1175
msgctxt "text_id=13575 | speaker=touko"
msgid "\"I see. And who might you be?\""
msgstr "「そう。ところで君、誰？」"

#. Occurrence 9_4:1181:13576: scene=9_4
#: 9_4:1181
msgctxt "text_id=13576 | speaker=unknown"
msgid "  Soujyuro, troubled by her forwardness, wanted to ask her the same."
msgstr "　それはこっちの台詞なんだけど、と心の中でちょっとだけ困る草十郎だった。"

#. Occurrence 9_4:1186:13577: scene=9_4
#: 9_4:1186
msgctxt "text_id=13577 | speaker=unknown"
msgid "  Alas, \"who are you?\" was a question far too difficult for Soujyuro."
msgstr "　誰？　という問いへの返答は、草十郎には難しすぎる。"

#. Occurrence 9_4:1207:13578: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0010; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:1207
msgctxt "text_id=13578 | speaker=soujuurou"
msgid "\"I'm sorry. I don't really know how to answer that."
msgstr "「すみません。誰か、と言われてもよく分からなくて。"

#. Occurrence 9_4:1213:13579: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0011; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:1213
msgctxt "text_id=13579 | speaker=soujuurou"
msgid "  For now, I'm the house-sitter. I'm a friend of Aozaki's, to tell the truth.\""
msgstr "　とりあえず、今は留守番してますけど、実は蒼崎の友人なんです」"

#. Occurrence 9_4:1219:13580: scene=9_4
#: 9_4:1219
msgctxt "text_id=13580 | speaker=unknown"
msgid "  It was a response without an ounce of persuasion to it."
msgstr "　まったく頼り気のない返答。"

#. Occurrence 9_4:1224:13581: scene=9_4
#: 9_4:1224
msgctxt "text_id=13581 | speaker=unknown"
msgid "  The young woman's face lit up at what she believed was the boy's attempt to tease her."
msgstr "　馬鹿にしているとしか思えない少年に、女性はぱあ、と顔を明るくした。"

#. Occurrence 9_4:1258:13582: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0006; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1258
msgctxt "text_id=13582 | speaker=touko"
msgid "\"Aren't you a funny one? What's your name, dear?\""
msgstr "「へえ、面白いこと言うのね君。名前はなんて言うの？」"

#. Occurrence 9_4:1264:13583: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0012; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:1264
msgctxt "text_id=13583 | speaker=soujuurou"
msgid "\"It's... Soujyuro Sizuki.\""
msgstr "「あの……静希草十郎、と言うのですが」"

#. Occurrence 9_4:1287:13584: scene=9_4
#: 9_4:1287
msgctxt "text_id=13584 | speaker=unknown"
msgid "  His shy answer made her giggle."
msgstr "　さらに自信なげな答えに、女性は笑いだしてしまった。"

#. Occurrence 9_4:1292:13585: scene=9_4
#: 9_4:1292
msgctxt "text_id=13585 | speaker=unknown"
msgid "  Soujyuro had no idea what he'd said that was so funny, but her laugh did not offend him. It came across as warm and affable, rather than derogatory."
msgstr "　草十郎にはどのあたりが可笑しかったのか分からなかったが、そう気分の悪い笑い声ではない。そこには卑下するものはなく、包むような温かさがあったからだ。"

#. Occurrence 9_4:1312:13586: scene=9_4
#: 9_4:1312
msgctxt "text_id=13586 | speaker=unknown"
msgid "  Then..."
msgstr "　そうして。"

#. Occurrence 9_4:1317:13587: scene=9_4
#: 9_4:1317
msgctxt "text_id=13587 | speaker=unknown"
msgid "  After she finished giggling, the woman fixed him with rather a rather tender look."
msgstr "　女性はひとしきり笑った後、やけに親しげな眼差しで草十郎を見つめ直した。"

#. Occurrence 9_4:1355:13588: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0007; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1355
msgctxt "text_id=13588 | speaker=touko"
msgid "\"I think I like you. Soujyuro, was it?"
msgstr "「いや、気に入ったわ。えーと、草十郎くんだっけ？"

#. Occurrence 9_4:1383:13589: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0008; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1383
msgctxt "text_id=13589 | speaker=touko"
msgid "  A fine name for hypnosis, though it doesn't really suit you. Now then, pour me some tea, would you?\""
msgstr "　君には合わない名前だけど、それも暗示的で素敵だし。じゃ、そういうワケでお茶でも淹れてくれない？」"

#. Occurrence 9_4:1389:13590: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0013; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:1389
msgctxt "text_id=13590 | speaker=soujuurou"
msgid "\"Huh? Uh, wait―\""
msgstr "「？　あ、いや」"

#. Occurrence 9_4:1395:13591: scene=9_4
#: 9_4:1395
msgctxt "text_id=13591 | speaker=unknown"
msgid "  She slipped past him into the house, boldly striding through the entrance hall."
msgstr "　女性は草十郎を置き去りに、堂々と玄関を抜けていく。"

#. Occurrence 9_4:1431:13592: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0009; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1431
msgctxt "text_id=13592 | speaker=touko"
msgid "\"Wow, it's just as I remember it."
msgstr "「うわ、呆れた。ほんと以前のまんまじゃない。"

#. Occurrence 9_4:1437:13593: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0010; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1437
msgctxt "text_id=13593 | speaker=touko"
msgid "  I thought she would have repaired the damaged pieces, what with taking the trouble to bring them all the way here. I would have fixed up the warped columns, at least.\""
msgstr "　せっかくこっちに持ってきたんだから、悪いところは<修復|リフォーム>したものと思ったけど。なにも柱の歪みまで再現しなくてもいいのにねー」"

#. Occurrence 9_4:1473:13594: scene=9_4
#: 9_4:1473
msgctxt "text_id=13594 | speaker=unknown"
msgid "  The visitor cheerfully inspected the foyer."
msgstr "　女性は楽しげにロビーを観察する。"

#. Occurrence 9_4:1482:13595: scene=9_4
#: 9_4:1482
msgctxt "text_id=13595 | speaker=unknown"
msgid "  Soujyuro still stood at the entrance."
msgstr "　草十郎は玄関に置き去り状態。"

#. Occurrence 9_4:1487:13596: scene=9_4
#: 9_4:1487
msgctxt "text_id=13596 | speaker=unknown"
msgid "  The clicking of her heels on the wooden floor echoed as she moved toward the drawing room."
msgstr "　<靴|ヒール>の音はロビーを横切って、居間に続く扉に向かっていく。"

#. Occurrence 9_4:1520:13597: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0011; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1520
msgctxt "text_id=13597 | speaker=touko"
msgid "\"Why are you standing there? The drawing room is this way, isn't it?\""
msgstr "「どうしたの？　こっちでしょ、居間は」"

#. Occurrence 9_4:1530:13598: scene=9_4
#: 9_4:1530
msgctxt "text_id=13598 | speaker=unknown"
msgid "  She disappeared from the foyer into the drawing room, oddly familiar with the layout of the house."
msgstr "　勝手知ったる<他人|ひと>の家状態で、女性は迷いなく居間に続く廊下に消えていった。"

#. Occurrence 9_4:1563:13599: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0014; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:1563
msgctxt "text_id=13599 | speaker=soujuurou"
msgid "\"Does she know Aozaki from school? Or maybe she knows Alice?\""
msgstr "「蒼崎か有珠、どっちかの先輩……かな？」"

#. Occurrence 9_4:1568:13600: scene=9_4
#: 9_4:1568
msgctxt "text_id=13600 | speaker=unknown"
msgid "  Soujyuro muttered to himself, walking to the drawing room."
msgstr "　ぽつりと呟いて、草十郎も居間に向かった。"

#. Occurrence 9_4:1614:13601: scene=9_4
#: 9_4:1614
msgctxt "text_id=13601 | speaker=unknown"
msgid "  He entered to see the woman walking around the room gleefully."
msgstr "　草十郎が居間に入ると、女性は感心しきった顔で、居間中を<漫|すず>ろ歩いていた。"

#. Occurrence 9_4:1625:13602: scene=9_4
#: 9_4:1625
msgctxt "text_id=13602 | speaker=unknown"
msgid "  Like someone strolling down a park boulevard,"
msgstr "　公園の並木道を散策するような、"

#. Occurrence 9_4:1630:13603: scene=9_4
#: 9_4:1630
msgctxt "text_id=13603 | speaker=unknown"
msgid "  she peered around, breathing in the nostalgia,"
msgstr "　懐かしい空気を吸って踊りだしそうな、"

#. Occurrence 9_4:1635:13604: scene=9_4
#: 9_4:1635
msgctxt "text_id=13604 | speaker=unknown"
msgid "  twirling with ladylike―or rather, girlish―glee."
msgstr "　女性というより少女らしい軽やかさで。"

#. Occurrence 9_4:1669:13605: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0012; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1669
msgctxt "text_id=13605 | speaker=touko"
msgid "\"Hm? Wait a minute... This TV is...\""
msgstr "「ん？　よく見れば、このテレビって―――」"

#. Occurrence 9_4:1678:13606: scene=9_4
#: 9_4:1678
msgctxt "text_id=13606 | speaker=unknown"
msgid "  She stared at the television inquisitively. Perhaps she had never seen a thirty-inch television before."
msgstr "　３０インチのテレビが珍しいのか、女性は食い入るように居間に不釣り合いなテレビを見つめた。"

#. Occurrence 9_4:1698:13607: scene=9_4
#: 9_4:1698
msgctxt "text_id=13607 | speaker=unknown"
msgid "  Awkwardly for Soujyuro, the cathode-ray tube was still displaying images of the animal kingdom."
msgstr "　……間の悪いことに、ブラウン管には流しっぱなしのがくがく動物ランドの映像。"

#. Occurrence 9_4:1703:13608: scene=9_4
#: 9_4:1703
msgctxt "text_id=13608 | speaker=unknown"
msgid "  He wished he'd stopped the video before he answered the door."
msgstr "　ちゃんと停止ボタンを押しておけば良かった、と草十郎は悔やみつつ反省した。"

#. Occurrence 9_4:1737:13609: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0015; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:1737
msgctxt "text_id=13609 | speaker=soujuurou"
msgid "\"Er, may I...\""
msgstr "「あの、もし」"

#. Occurrence 9_4:1742:13610: scene=9_4
#: 9_4:1742
msgctxt "text_id=13610 | speaker=unknown"
msgid "  He blurted half a question, attempting to regain his composure."
msgstr "　気を取り直して話しかける。"

#. Occurrence 9_4:1747:13611: scene=9_4
#: 9_4:1747
msgctxt "text_id=13611 | speaker=unknown"
msgid "  There were many questions to be answered, but he first resolved to ask her name, at least."
msgstr "　とりあえず色々問題はある気はするけど、まず<女性|あいて>の名前ぐらいは聞かなければ、と意を決したのだ。"

#. Occurrence 9_4:1752:13612: scene=9_4
#: 9_4:1752
msgctxt "text_id=13612 | speaker=unknown"
msgid "  The woman turned a coldly observant gaze on him."
msgstr "　そんな草十郎に、女性は一転して冷たい視線を向けた。"

#. Occurrence 9_4:1757:13613: scene=9_4
#: 9_4:1757
msgctxt "text_id=13613 | speaker=unknown"
msgid "  Her intimidating eyes and long, thin eyebrows bored into Soujyuro through her spectacles."
msgstr "　細く長い眉と、相手を圧倒する瞳が、眼鏡ごしに草十郎を睨む。"

#. Occurrence 9_4:1789:13614: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0013; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1789
msgctxt "text_id=13614 | speaker=touko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 9_4:1800:13615: scene=9_4
#: 9_4:1800
msgctxt "text_id=13615 | speaker=unknown"
msgid "  Soujyuro had intended no offense, but now he felt like he had chosen his words very poorly."
msgstr "　そんなつもりはなかったけど、自分に重大な落ち度があったらしい―――と思うしかない批難の眼差しだった。"

#. Occurrence 9_4:1820:13616: scene=9_4
#: 9_4:1820
msgctxt "text_id=13616 | speaker=unknown"
msgid "  He apologetically clammed up."
msgstr "　草十郎は申し訳なさそうに言葉を失う。"

#. Occurrence 9_4:1825:13617: scene=9_4
#: 9_4:1825
msgctxt "text_id=13617 | speaker=unknown"
msgid "  Then..."
msgstr "　そこへ、"

#. Occurrence 9_4:1852:13618: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0014; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1852
msgctxt "text_id=13618 | speaker=touko"
msgid "\"Come now, Soujyuro. 'May I'? Really?"
msgstr "「やだなあ草十郎くん。もし、なんてかしこまって。"

#. Occurrence 9_4:1858:13619: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0015; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1858
msgctxt "text_id=13619 | speaker=touko"
msgid "  Do I look like some old lady to you?\""
msgstr "　私、そんなおばさんに見える？」"

#. Occurrence 9_4:1863:13620: scene=9_4
#: 9_4:1863
msgctxt "text_id=13620 | speaker=unknown"
msgid "  She snickered."
msgstr "　くすりと。"

#. Occurrence 9_4:1868:13621: scene=9_4
#: 9_4:1868
msgctxt "text_id=13621 | speaker=unknown"
msgid "  Her disapproving glare melted into a teasing smile."
msgstr "　鋭い眼差しを崩して、からかうように女性は笑った。"

#. Occurrence 9_4:1914:13622: scene=9_4
#: 9_4:1914
msgctxt "text_id=13622 | speaker=unknown"
msgid "  Of course, that wasn't true at all. It would be more accurate to say she had the air of an older sister."
msgstr "　もちろんそんな事は全然なくて、比喩するならお姉さんという単語がぴったりくる。"

#. Occurrence 9_4:1919:13623: scene=9_4
#: 9_4:1919
msgctxt "text_id=13623 | speaker=unknown"
msgid "  Or at least, that was what Soujyuro attempted to express with body language, to which she grinned smugly."
msgstr "　そんな気持ちを全身で表現する草十郎に、女性は満足気に微笑んだ。"

#. Occurrence 9_4:1948:13624: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0016; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:1948
msgctxt "text_id=13624 | speaker=touko"
msgid "\"Very well. Let's do away with the formalities, shall we? They're beginning to bore me, anyway.\""
msgstr "「よろしい。なら、そんな他人行儀な話し方はやめましょ。つまらないし、<柄|がら>じゃないわ」"

#. Occurrence 9_4:1967:13625: scene=9_4
#: 9_4:1967
msgctxt "text_id=13625 | speaker=unknown"
msgid "  Without making a sound, she took an effortless seat on the sofa,"
msgstr "　言って、彼女はソファーに腰を下ろした。"

#. Occurrence 9_4:1972:13626: scene=9_4
#: 9_4:1972
msgctxt "text_id=13626 | speaker=unknown"
msgid "  as naturally as if she belonged there."
msgstr "　あくまで自然に、優雅に、物音ひとつ立てずに。"

#. Occurrence 9_4:1979:13627: scene=9_4
#: 9_4:1979
msgctxt "text_id=13627 | speaker=unknown"
msgid "  Her posture and movements exuded sophistication,"
msgstr "　その、あまりにも洗練された動作と姿勢が、"

#. Occurrence 9_4:1984:13628: scene=9_4
#: 9_4:1984
msgctxt "text_id=13628 | speaker=unknown"
msgid "and she required no words to instruct him to hurry along and make the tea."
msgstr "『さあ、早くお茶淹れてきて』と語っている。"

#. Occurrence 9_4:2015:13629: scene=9_4
#: 9_4:2015
msgctxt "text_id=13629 | speaker=unknown"
msgid "  Without pressing her further, Soujyuro headed to the kitchen."
msgstr "　疑問は究明されないまま、仕方なく草十郎は台所に向かった。"

#. Occurrence 9_4:2021:13630: scene=9_4
#: 9_4:2021
msgctxt "text_id=13630 | speaker=unknown"
msgid "It seemed that the conversation would not proceed until tea had been served."
msgstr "とにかくお茶を淹れないと話は進まないらしい。"

#. Occurrence 9_4:2042:13631: scene=9_4
#: 9_4:2042
msgctxt "text_id=13631 | speaker=unknown"
msgid "  He chose the Fauchon he was forced to replace once before, after using it without permission."
msgstr "　葉は以前、無断使用の<咎|とが>で弁償させられたフォションを選んだ。"

#. Occurrence 9_4:2047:13632: scene=9_4
#: 9_4:2047
msgctxt "text_id=13632 | speaker=unknown"
msgid "  Since she was here to see Aoko, he decided to serve her using Aoko's Sèvres tea cup."
msgstr "　カップは青子を訪ねてきた人なので、青子の持ち物であるセーブルのカップで紅茶を淹れる事にする。"

#. Occurrence 9_4:2052:13633: scene=9_4
#: 9_4:2052
msgctxt "text_id=13633 | speaker=unknown"
msgid "  Into the cup as blue as the ocean depths, he carefully poured the tea before returning to the drawing room."
msgstr "　深海を思わせるカップにお茶をそそいで、草十郎は居間へとまい戻った。"

#. Occurrence 9_4:2083:13634: scene=9_4
#: 9_4:2083
msgctxt "text_id=13634 | speaker=unknown"
msgid "  Gently, he placed the teacup on the table, and faced the woman."
msgstr "　<恭|うやうや>しくティーカップをテーブルにおいて、草十郎は女性を見る。"

#. Occurrence 9_4:2119:13635: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0016; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:2119
msgctxt "text_id=13635 | speaker=soujuurou"
msgid "\"Um. Forgive me for not asking earlier, but should I take it that you're an acquaintance of Aozaki's...or whatever?\""
msgstr "「あの。訊ねるのが遅れましたけど、蒼崎の知り合い……かな？」"

#. Occurrence 9_4:2125:13636: scene=9_4
#: 9_4:2125
msgctxt "text_id=13636 | speaker=unknown"
msgid "  Despite being told otherwise, Soujyuro could not help but stand on ceremony."
msgstr "　言われた事はすぐに直す草十郎だが、この女性にはつい丁寧語になってしまった。"

#. Occurrence 9_4:2130:13637: scene=9_4
#: 9_4:2130
msgctxt "text_id=13637 | speaker=unknown"
msgid "  His clumsy effort to make the question sound casual only jumbled it further."
msgstr "　ので、強引に語尾を砕けたものにする。"

#. Occurrence 9_4:2135:13638: scene=9_4
#: 9_4:2135
msgctxt "text_id=13638 | speaker=unknown"
msgid "  The visitor's eyes narrowed again in displeasure."
msgstr "　それが不満だったのか、女性はまたも眼差しを険しくした。"

#. Occurrence 9_4:2167:13639: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0017; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2167
msgctxt "text_id=13639 | speaker=touko"
msgid "\"That's what I mean. Would you stop calling her 'Aozaki'? It's beginning to grate on me. Just use 'Aoko.'\""
msgstr "「それ。その蒼崎って言うの、やめてくれない？　なんだかくすぐったくて。青子でいいでしょ、呼び方は」"

#. Occurrence 9_4:2205:13640: scene=9_4
#: 9_4:2205
msgctxt "text_id=13640 | speaker=unknown"
msgid "  The woman kept the rest of her expression indifferent as she slowly raised the cup to take a sip."
msgstr "　女性はすました顔でカップを手にして、一口だけ口をつけた。"

#. Occurrence 9_4:2210:13641: scene=9_4
#: 9_4:2210
msgctxt "text_id=13641 | speaker=unknown"
msgid "  Smiling, she tolerated the tea that Aoko and Alice regularly criticized as bitter and clumsily brewed."
msgstr "　青子たちには下手、苦い、と不評なソレを、女性は笑顔ひとつで受け流す。"

#. Occurrence 9_4:2215:13642: scene=9_4
#: 9_4:2215
msgctxt "text_id=13642 | speaker=unknown"
msgid "  Soujyuro had yet to learn that society thoughtfully awarded participation trophies to people merely for trying, regardless of the outcome."
msgstr "　<結果|あじ>はどうあれ頑張ったで賞、という温情が存在する事を、のちに知る草十郎なのだった。"

#. Occurrence 9_4:2249:13643: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0018; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2249
msgctxt "text_id=13643 | speaker=touko"
msgid "\"Come. Don't stand there. Sit."
msgstr "「ほら、立ってないで座って。"

#. Occurrence 9_4:2249:13644: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0018; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2249
msgctxt "text_id=13644 | speaker=touko"
msgid "  I don't like being looked down on.\""
msgstr "　見下ろされるのは好きじゃないんだ、私」"

#. Occurrence 9_4:2266:13645: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0017; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:2266
msgctxt "text_id=13645 | speaker=soujuurou"
msgid "\"...?\""
msgstr "「……？」"

#. Occurrence 9_4:2272:13646: scene=9_4
#: 9_4:2272
msgctxt "text_id=13646 | speaker=unknown"
msgid "  Soujyuro tilted his head, noting a slight familiarity to her manner of speech."
msgstr "　よく知る同居人に似た話し方に、ますます首をかしげる草十郎。"

#. Occurrence 9_4:2278:13647: scene=9_4
#: 9_4:2278
msgctxt "text_id=13647 | speaker=unknown"
msgid "It was almost...as if they'd met somewhere before."
msgstr "そう言えば―――唐突ではあるが、この光景にも見覚えのあるような―――"

#. Occurrence 9_4:2316:13648: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0018; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:2316
msgctxt "text_id=13648 | speaker=soujuurou"
msgid "\"Wait...\""
msgstr "「…………あれ？」"

#. Occurrence 9_4:2322:13649: scene=9_4
#: 9_4:2322
msgctxt "text_id=13649 | speaker=unknown"
msgid "  The sight of her sitting on the sofa began to stir forgotten memories."
msgstr "　ソファーに座っている女性の姿から、忘れかけていた記憶が蘇る。"

#. Occurrence 9_4:2340:13650: scene=9_4
#: 9_4:2340
msgctxt "text_id=13650 | speaker=unknown"
msgid "  Noticing his reaction, the woman became visibly delighted."
msgstr "　そんな彼を、女性は楽しげに見上げている。"

#. Occurrence 9_4:2373:13651: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0019; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2373
msgctxt "text_id=13651 | speaker=touko"
msgid "\"You remember me. I can tell you I was as surprised as you are."
msgstr "「思い出した？　私もちょっと驚いたわ。"

#. Occurrence 9_4:2380:13652: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0020; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2380
msgctxt "text_id=13652 | speaker=touko"
msgid "I came all the way here to see Aoko, and instead I find you standing there to greet me.\""
msgstr "青子を訪ねにきたら、いつか見た君が出迎えてくるんだから」"

#. Occurrence 9_4:2386:13653: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0019; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:2386
msgctxt "text_id=13653 | speaker=soujuurou"
msgid "\"...Oh!\""
msgstr "「――――――、あ」"

#. Occurrence 9_4:2417:13654: scene=9_4
#: 9_4:2417
msgctxt "text_id=13654 | speaker=unknown"
msgid "  Now that she was chuckling, Soujyuro remembered everything."
msgstr "　くすくすと笑う女性を見て、草十郎は完全に思い出した。"

#. Occurrence 9_4:2436:13655: scene=9_4
#: 9_4:2436
msgctxt "text_id=13655 | speaker=unknown"
msgid "  He had only glimpsed her for a moment, but there was no mistaking it."
msgstr "　あの時は一瞬しか見ていなかったが、間違いない。"

#. Occurrence 9_4:2441:13656: scene=9_4
#: 9_4:2441
msgctxt "text_id=13656 | speaker=unknown"
msgid "  It had to be her―the woman smoking the long cigarette who had cleaned out the pachinko parlor!"
msgstr "　この女性こそ、いつかのパチンコ屋でフィーバーを出していた長い煙草の<達人|ひと>……！"

#. Occurrence 9_4:2480:13657: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0021; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2480
msgctxt "text_id=13657 | speaker=touko"
msgid "\"You gave me quite the fright that day, Soujyuro."
msgstr "「あの時は私もショックだったなぁ。"

#. Occurrence 9_4:2486:13658: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0022; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2486
msgctxt "text_id=13658 | speaker=touko"
msgid "  You took one look at me and ran away."
msgstr "　草十郎くん、目が合うなりいきなり逃げ出したでしょ？"

#. Occurrence 9_4:2492:13659: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0023; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2492
msgctxt "text_id=13659 | speaker=touko"
msgid "  How terrifying you must think I am, reacting like that. You hurt my feelings, you know.\""
msgstr "　そんなに私ってこわもてなのかしらって、あの日の晩は真剣に悩んだんだから」"

#. Occurrence 9_4:2512:13660: scene=9_4
#: 9_4:2512
msgctxt "text_id=13660 | speaker=unknown"
msgid "  In spite of her words, she clearly enjoyed the memory."
msgstr "　そんな思い出話を、女性は楽しそうに語る。"

#. Occurrence 9_4:2517:13661: scene=9_4
#: 9_4:2517
msgctxt "text_id=13661 | speaker=unknown"
msgid "  She was right. He'd mistaken her for the murderous shadow (Aoko) in the park from the previous night, and fled in mortal terror."
msgstr "　そう。あの時は青子の秘密を知った翌日で、草十郎は公園にいた<青子|ひとかげ>を、この女性と勘違いして逃げだしたのだ。"

#. Occurrence 9_4:2523:13662: scene=9_4
#: 9_4:2523
msgctxt "text_id=13662 | speaker=unknown"
msgid "  Even though it was clearly a case of mistaken identity, he could now see why he had mixed them up."
msgstr "　結局は人違いだったけど、あの時、なぜあんな事を思ったかと言うと―――"

#. Occurrence 9_4:2556:13663: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0020; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:2556
msgctxt "text_id=13663 | speaker=soujuurou"
msgid "(...So that's why. They feel similar.)"
msgstr "『……そうか。雰囲気が似てるんだ』"

#. Occurrence 9_4:2569:13664: scene=9_4
#: 9_4:2569
msgctxt "text_id=13664 | speaker=unknown"
msgid "  Finally, Soujyuro realized who the visitor was. He chided himself for not realizing it sooner."
msgstr "　そこまで思って、草十郎はやっと来客の正体に気が付いた。ちょっと考えればすぐに分かった事じゃないか、と自分を叱りながら。"

#. Occurrence 9_4:2607:13665: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_4_0021; voice_prefix=A30; voice_category=3; scene=9_4
#: 9_4:2607
msgctxt "text_id=13665 | speaker=soujuurou"
msgid "\"You must be―\""
msgstr "「それじゃあ、あなたは」"

#. Occurrence 9_4:2613:13666: scene=9_4
#: 9_4:2613
msgctxt "text_id=13666 | speaker=unknown"
msgid "  Just as he was about to say it, she held up her hand to interrupt him."
msgstr "　言い掛ける草十郎の口を塞ぐように、女性は片手を上げた。"

#. Occurrence 9_4:2624:13667: scene=9_4
#: 9_4:2624
msgctxt "text_id=13667 | speaker=unknown"
msgid "  She pointed at him like she was aiming a gun."
msgstr "　人差し指で草十郎の顔をばん、と射つように。"

#. Occurrence 9_4:2657:13668: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0024; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2657
msgctxt "text_id=13668 | speaker=touko"
msgid "\"Forgive me. Your reaction was just so cute, I got carried away teasing you."
msgstr "「ごめんなさい。君の仕草がちょっと可愛くて、からかいがすぎちゃった。"

#. Occurrence 9_4:2663:13669: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0025; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2663
msgctxt "text_id=13669 | speaker=touko"
msgid "  It's a little late, but my name is Touko Aozaki."
msgstr "　自己紹介が遅れたけど、私は蒼崎<橙子|とうこ>。"

#. Occurrence 9_4:2681:13670: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0026; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2681
msgctxt "text_id=13670 | speaker=touko"
msgid "  Surprise―I'm Aoko's big sister.\""
msgstr "　率直に言うと、青子の実の姉ってワケね」"

#. Occurrence 9_4:2701:13671: scene=9_4
#: 9_4:2701
msgctxt "text_id=13671 | speaker=unknown"
msgid "  That figured. No wonder he'd been charmed at first sight."
msgstr "　なるほど、見惚れるはずだと納得する。"

#. Occurrence 9_4:2706:13672: scene=9_4
#: 9_4:2706
msgctxt "text_id=13672 | speaker=unknown"
msgid "  It wasn't hard to envision Touko as a not-too-distant future version of Aoko, with her smile that imparted courage to any who glimpsed it."
msgstr "　見るものを勇気づける笑顔を持った女性は、確かに青子の未来の姿を映していたのだから。"

#. Occurrence 9_4:2737:13673: scene=9_4
#: 9_4:2737
msgctxt "text_id=13673 | speaker=unknown"
msgid "  Only..."
msgstr "　……もっとも。"

#. Occurrence 9_4:2742:13674: scene=9_4
#: 9_4:2742
msgctxt "text_id=13674 | speaker=unknown"
msgid "  While Aoko was earnest and diligent, Touko seemed to be shrewd and playful."
msgstr "　常に前向きな青子と違って、この人物はななめ前あたりを面白がって眺めているタイプのようだけど。"

#. Occurrence 9_4:2775:13675: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0027; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2775
msgctxt "text_id=13675 | speaker=touko"
msgid "\"I heard my sister was in trouble."
msgstr "「あの子が困ってるって聞いてね。"

#. Occurrence 9_4:2781:13676: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_4_0028; voice_prefix=A20; voice_category=11; scene=9_4
#: 9_4:2781
msgctxt "text_id=13676 | speaker=touko"
msgid "  So I came all the way over here to set her straight.\""
msgstr "　いいかげん忠告してあげる気で、はるばるやってきたわけなのでした」"

#. Occurrence 9_4:2799:13677: scene=9_4
#: 9_4:2799
msgctxt "text_id=13677 | speaker=unknown"
msgid "  Aoko's sister chuckled coyly while sipping her tea."
msgstr "　ふふ、と妖しい笑みを浮かべて、青子のお姉さんは紅茶を一口。"

#. Occurrence 9_4:2805:13678: scene=9_4
#: 9_4:2805
msgctxt "text_id=13678 | speaker=unknown"
msgid "  Lured by her charm, Soujyuro sat on the sofa as well. He felt like he could relax a little, now that the initial shock of an unexpected guest had subsided."
msgstr "　その仕草に釣られて、草十郎もソファーに腰を下ろした。急な来客に驚いてばかりだったが、そういうコトなら安心できる。"

#. Occurrence 9_4:2835:13679: scene=9_4
#: 9_4:2835
msgctxt "text_id=13679 | speaker=unknown"
msgid "  Just like that, it was almost five in the afternoon."
msgstr "　そうして、時刻は午後五時前。"

#. Occurrence 9_4:2840:13680: scene=9_4
#: 9_4:2840
msgctxt "text_id=13680 | speaker=unknown"
msgid "  Aoko and Alice would be returning from their excursion soon."
msgstr "　遠出した青子たちも、そろそろ帰途につく頃だった。"

#. Occurrence 9_5:57:13681: scene=9_5
#: 9_5:57
msgctxt "text_id=13681 | speaker=unknown"
msgid "  This was Misaki City's only subway line."
msgstr "　三咲市唯一の地下鉄線。"

#. Occurrence 9_5:62:13682: scene=9_5
#: 9_5:62
msgctxt "text_id=13682 | speaker=unknown"
msgid "  Only half a year had passed since its opening, and at the end of the fairly new platform, there the two girls stood."
msgstr "　開通からまだ半年ほどしか経っていない真新しいホームの先端に、彼女たちは<佇|たたず>んでいた。"

#. Occurrence 9_5:67:13683: scene=9_5
#: 9_5:67
msgctxt "text_id=13683 | speaker=unknown"
msgid "  The time was six-thirty in the evening."
msgstr "　時刻は午後六時半。"

#. Occurrence 9_5:73:13684: scene=9_5
#: 9_5:73
msgctxt "text_id=13684 | speaker=unknown"
msgid "  They had been idling for around twenty minutes since returning from Arisaka and had yet to return to street level."
msgstr "　有坂から戻ってきた青子たちは地上には上がらず、既に二十分近い時間をここで浪費していた。"

#. Occurrence 9_5:94:13685: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0000; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:94
msgctxt "text_id=13685 | speaker=alice"
msgid "\"Aoko.\""
msgstr "「青子」"

#. Occurrence 9_5:111:13686: scene=9_5
#: 9_5:111
msgctxt "text_id=13686 | speaker=unknown"
msgid "  There was a hint of irritation in Alice's voice."
msgstr "　呆れ声で有珠は語りかける。"

#. Occurrence 9_5:121:13687: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0000; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:121
msgctxt "text_id=13687 | speaker=aoko"
msgid "\"I'm not done yet. Just one more, okay?\""
msgstr "「ちょっと待って。あともう一回だけ、ね？」"

#. Occurrence 9_5:141:13688: scene=9_5
#: 9_5:141
msgctxt "text_id=13688 | speaker=unknown"
msgid "  Aoko begged Alice, hands together, trembling from the cold."
msgstr "　寒さに震えながら、両手を合わせて有珠にお願いする。"

#. Occurrence 9_5:146:13689: scene=9_5
#: 9_5:146
msgctxt "text_id=13689 | speaker=unknown"
msgid "  It was rare to see her act this childish."
msgstr "　彼女がここまで甘える事は珍しい。"

#. Occurrence 9_5:151:13690: scene=9_5
#: 9_5:151
msgctxt "text_id=13690 | speaker=unknown"
msgid "  No doubt Tobimaru would consider this behavior more strange than cute if he were here."
msgstr "　鳶丸あたりが見たら可愛いというより不気味だと用心するに違いない。"

#. Occurrence 9_5:184:13691: scene=9_5
#: 9_5:184
msgctxt "text_id=13691 | speaker=unknown"
msgid "  From the end of the platform, Aoko peered into the creeping darkness to where the tracks led."
msgstr "　青子はホームの先端―――深い闇になっている、レールの先を見つめている。"

#. Occurrence 9_5:201:13692: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0001; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:201
msgctxt "text_id=13692 | speaker=alice"
msgid "\"You have the strangest taste.\""
msgstr "「……貴女の趣味、変わってるわ」"

#. Occurrence 9_5:218:13693: scene=9_5
#: 9_5:218
msgctxt "text_id=13693 | speaker=unknown"
msgid "  Alice muttered, sitting on the bench with forbearance."
msgstr "　呟いて、仕方なく有珠はベンチに座った。"

#. Occurrence 9_5:238:13694: scene=9_5
#: 9_5:238
msgctxt "text_id=13694 | speaker=unknown"
msgid "  Any other day and she would have been fine heading back by herself, but today she was in a good mood and decided to humor Aoko."
msgstr "　いつもならひとりで先に帰るところだが、今日は気分がいいので付き合う事にしたらしい。"

#. Occurrence 9_5:243:13695: scene=9_5
#: 9_5:243
msgctxt "text_id=13695 | speaker=unknown"
msgid "  Knowing full well that her rare spells of positivity were about as fragile as freshly fallen snow, she hoped to go home while she was still in high spirits."
msgstr "　できるのなら今日はこのまま、すぐに溶けてしまう雪のような手触りであっても、幸せな気分のまま帰りたい。"

#. Occurrence 9_5:248:13696: scene=9_5
#: 9_5:248
msgctxt "text_id=13696 | speaker=unknown"
msgid "  Eyes closed, her placid demeanor conveyed her feelings well enough."
msgstr "　……穏やかに閉じられた有珠の<目蓋|まぶた>は、そんな気持ちを代弁しているようだった。"

#. Occurrence 9_5:277:13697: scene=9_5
#: 9_5:277
msgctxt "text_id=13697 | speaker=unknown"
msgid "  Thus, the two of them waited on the platform alone for a subway train they had no intention of riding."
msgstr "　かくして、人影のない地下鉄のホームで、ふたりは乗る予定のない電車を待つ事となった。"

#. Occurrence 9_5:297:13698: scene=9_5
#: 9_5:297
msgctxt "text_id=13698 | speaker=unknown"
msgid "  The subway had recently opened for service."
msgstr "　開通したばかりの地下鉄。"

#. Occurrence 9_5:302:13699: scene=9_5
#: 9_5:302
msgctxt "text_id=13699 | speaker=unknown"
msgid "  The people of Misaki were humble folk, and for now, few passengers were drawn to the novelty and high prices of the new train."
msgstr "　高めの料金設定や、そもそも地下鉄に馴染みのない三咲市の人々の気質もあって、利用客はまだまだ少ない。"

#. Occurrence 9_5:307:13700: scene=9_5
#: 9_5:307
msgctxt "text_id=13700 | speaker=unknown"
msgid "  Thanks to the low foot traffic, the platform was still as good as new."
msgstr "　活気がないのは問題だが、そのおかげでホームはいまだ新品同様だ。"

#. Occurrence 9_5:327:13701: scene=9_5
#: 9_5:327
msgctxt "text_id=13701 | speaker=unknown"
msgid "  There was something primeval about a subway devoid of people."
msgstr "　思えば、人のいない地下鉄はこの上なく原始的だ。"

#. Occurrence 9_5:333:13702: scene=9_5
#: 9_5:333
msgctxt "text_id=13702 | speaker=unknown"
msgid "  It was a picture of tranquility, free of human interference―"
msgstr "　此処はもともと人の住まぬ<安寧|あんねい>の地。"

#. Occurrence 9_5:338:13703: scene=9_5
#: 9_5:338
msgctxt "text_id=13703 | speaker=unknown"
msgid "  not just silent, but lifeless."
msgstr "　無音にして無生。"

#. Occurrence 9_5:343:13704: scene=9_5
#: 9_5:343
msgctxt "text_id=13704 | speaker=unknown"
msgid "  This was a realm unmolested by living creatures, where only speechless organisms dwelt."
msgstr "　物言わぬ微生物たちが息づく、生者には辿り着けぬ<根|ね>の国である。"

#. Occurrence 9_5:373:13705: scene=9_5
#: 9_5:373
msgctxt "text_id=13705 | speaker=unknown"
msgid "  The harshly artificial fluorescent lighting underscored its soullessness."
msgstr "　真白すぎる人工の明かりは生命を感じさせない。"

#. Occurrence 9_5:378:13706: scene=9_5
#: 9_5:378
msgctxt "text_id=13706 | speaker=unknown"
msgid "  It was a cave where light ended and shadows began,"
msgstr "　はっきりと光と影に分かれた空洞。"

#. Occurrence 9_5:383:13707: scene=9_5
#: 9_5:383
msgctxt "text_id=13707 | speaker=unknown"
msgid "  where riderless vessels disappeared into the dark."
msgstr "　<電車|ふね>は乗客のないまま闇に出航する。"

#. Occurrence 9_5:388:13708: scene=9_5
#: 9_5:388
msgctxt "text_id=13708 | speaker=unknown"
msgid "  The platform was wedged between two tracks, like a jetty built upon a subterranean sea."
msgstr "　レールに挟まれたホームは、地底の海に造られた桟橋のようだ。"

#. Occurrence 9_5:393:13709: scene=9_5
#: 9_5:393
msgctxt "text_id=13709 | speaker=unknown"
msgid "  In this place, far removed from the world above, Aoko waited with eyes closed for the familiar rumble."
msgstr "　そんな、地上の風景とはかけ離れた場所で、青子は目を<瞑|つむ>って<振動|ふなで>を待つ。"

#. Occurrence 9_5:428:13710: scene=9_5
#: 9_5:428
msgctxt "text_id=13710 | speaker=unknown"
msgid "  It was she who had proposed that they delay their return and rest at the platform."
msgstr "　青子は帰宅を少し遅らせて、ホームで休もうと提案した。"

#. Occurrence 9_5:433:13711: scene=9_5
#: 9_5:433
msgctxt "text_id=13711 | speaker=unknown"
msgid "  The reason was simple:"
msgstr "　理由は単純。"

#. Occurrence 9_5:438:13712: scene=9_5
#: 9_5:438
msgctxt "text_id=13712 | speaker=unknown"
msgid "  Aoko Aozaki enjoyed the soothing sound of passing subway trains."
msgstr "　蒼崎青子は地下鉄の通過音に安らぎを覚える、奇妙な趣味を持っていたからだ。"

#. Occurrence 9_5:470:13713: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0001; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:470
msgctxt "text_id=13713 | speaker=aoko"
msgid "\"I probably won't get to see any more live bands this year, so at least let me have this,\""
msgstr "「今年はもうライブハウスに行けそうもないし、これぐらいのワガママはいいでしょ」"

#. Occurrence 9_5:476:13714: scene=9_5
#: 9_5:476
msgctxt "text_id=13714 | speaker=unknown"
msgid "  she had said to Alice, her eyes still closed."
msgstr "　青子は目を閉じたまま有珠に語りかける。"

#. Occurrence 9_5:493:13715: scene=9_5
#: 9_5:493
msgctxt "text_id=13715 | speaker=unknown"
msgid "  Alice had neither nodded nor objected, and so they'd watched three trains come and go."
msgstr "　付き合いで三回ほど電車を見送っている有珠はうなずきもしない。"

#. Occurrence 9_5:524:13716: scene=9_5
#: 9_5:524
msgctxt "text_id=13716 | speaker=unknown"
msgid "  Silence fell again."
msgstr "　それきり静寂。"

#. Occurrence 9_5:529:13717: scene=9_5
#: 9_5:529
msgctxt "text_id=13717 | speaker=unknown"
msgid "  Aoko waited for the next train with anticipation."
msgstr "　青子はあと数分後の電車の到着を心待ちにしながら。"

#. Occurrence 9_5:534:13718: scene=9_5
#: 9_5:534
msgctxt "text_id=13718 | speaker=unknown"
msgid "  Alice sat and stared at the tunnel wall patiently."
msgstr "　有珠は、そんな青子に付き合いながらも地下鉄の壁を見つめながら。"

#. Occurrence 9_5:554:13719: scene=9_5
#: 9_5:554
msgctxt "text_id=13719 | speaker=unknown"
msgid "  According to the display board, the next train was due to arrive in five minutes."
msgstr "　掲示板によると、次の電車は五分後に到着予定。"

#. Occurrence 9_5:559:13720: scene=9_5
#: 9_5:559
msgctxt "text_id=13720 | speaker=unknown"
msgid "  From the dark tunnel came wind and rumbling."
msgstr "　暗い穴からは、カタカタと風の音が響いてくる。"

#. Occurrence 9_5:593:13721: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0002; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:593
msgctxt "text_id=13721 | speaker=alice"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 9_5:598:13722: scene=9_5
#: 9_5:598
msgctxt "text_id=13722 | speaker=unknown"
msgid "  A purposefully placed Bounded Field now surrounded the platform."
msgstr "　地下鉄のホームは人工の結界だ。"

#. Occurrence 9_5:606:13723: scene=9_5
#: 9_5:606
msgctxt "text_id=13723 | speaker=unknown"
msgid "  There was no sign of any station personnel, and entrances and exits were few and narrow."
msgstr "　駅員の姿はなく、出入り口にあたる通路はあまりにも狭く、少ない。"

#. Occurrence 9_5:614:13724: scene=9_5
#: 9_5:614
msgctxt "text_id=13724 | speaker=unknown"
msgid "  The lack of bystanders made the field hardly necessary."
msgstr "　結界を張るまでもなく<人避|ひとよ>けは成立している。"

#. Occurrence 9_5:634:13725: scene=9_5
#: 9_5:634
msgctxt "text_id=13725 | speaker=unknown"
msgid "  Suddenly, six figures appeared in front of the stairs to the surface."
msgstr "　地上に通じる階段の前には、いつのまにか六人ほどの人影が立っていた。"

#. Occurrence 9_5:654:13726: scene=9_5
#: 9_5:654
msgctxt "text_id=13726 | speaker=unknown"
msgid "  ...They all shared the same face."
msgstr "　―――ただし、全員同じ顔。"

#. Occurrence 9_5:659:13727: scene=9_5
#: 9_5:659
msgctxt "text_id=13727 | speaker=unknown"
msgid "  Motionless and with smiles like the crescent moon, they stared at Aoko and Alice."
msgstr "　一歩も動かず、三日月のような笑顔のまま、ホームにいる有珠たちを眺めている。"

#. Occurrence 9_5:696:13728: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0003; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:696
msgctxt "text_id=13728 | speaker=alice"
msgid "\"...I can't believe I missed that.\""
msgstr "「……<鈍|にぶ>っているにも、程があるわね」"

#. Occurrence 9_5:702:13729: scene=9_5
#: 9_5:702
msgctxt "text_id=13729 | speaker=unknown"
msgid "  Alice let out a quiet, dejected sigh."
msgstr "　自分への落胆から、静かに有珠はため息をついた。"

#. Occurrence 9_5:737:13730: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0002; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:737
msgctxt "text_id=13730 | speaker=aoko"
msgid "\"Alice? What's wrong?\""
msgstr "「？　どうかした、有珠」"

#. Occurrence 9_5:757:13731: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0004; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:757
msgctxt "text_id=13731 | speaker=alice"
msgid "\"...Must you ask? Didn't you notice that you and I were the only ones to get off at this station?\""
msgstr "「……どうもなにも。この駅で降りたのは貴女とわたしだけなの、気付いていた？」"

#. Occurrence 9_5:778:13732: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0003; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:778
msgctxt "text_id=13732 | speaker=aoko"
msgid "\"I mean, this subway is usually pretty dead anyway, so...\""
msgstr "「そりゃあね。相変わらず、ここの地下鉄ってば利用客が少ないって…………」"

#. Occurrence 9_5:783:13733: scene=9_5
#: 9_5:783
msgctxt "text_id=13733 | speaker=unknown"
msgid "  Aoko trailed off, tutting in annoyance."
msgstr "　そこまで言いかけて、青子はち、と舌を鳴らした。"

#. Occurrence 9_5:810:13734: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0004; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:810
msgctxt "text_id=13734 | speaker=aoko"
msgid "\"So, what tipped you off?\""
msgstr "「で。そう言う有珠はいつ気が付いたの？」"

#. Occurrence 9_5:826:13735: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0005; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:826
msgctxt "text_id=13735 | speaker=alice"
msgid "\"The impending gloom I felt a moment ago."
msgstr "「……憂鬱なコトにたった今よ。"

#. Occurrence 9_5:832:13736: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0006; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:832
msgctxt "text_id=13736 | speaker=alice"
msgid "  I'm not entirely blaming you. This wouldn't have happened if we were a better team.\""
msgstr "　青子ばかり責められないわね。貴女とわたしが一つなら、こんな事もなかったのに」"

#. Occurrence 9_5:844:13737: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0005; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:844
msgctxt "text_id=13737 | speaker=aoko"
msgid "\"Enough sniveling.\""
msgstr "「つまらない喩え話は口にしない」"

#. Occurrence 9_5:879:13738: scene=9_5
#: 9_5:879
msgctxt "text_id=13738 | speaker=unknown"
msgid "  They traded stoic and calm words, never moving or making eye contact."
msgstr "　淡々と、視線も合わさず言葉を交わすふたり。"

#. Occurrence 9_5:884:13739: scene=9_5
#: 9_5:884
msgctxt "text_id=13739 | speaker=unknown"
msgid "  In contrast, the figures near the stairs began to stir."
msgstr "　そんな彼女たちとは対照的に、階段を<塞|ふさ>いでいた人影が動きはじめた。"

#. Occurrence 9_5:899:13740: scene=9_5
#: 9_5:899
msgctxt "text_id=13740 | speaker=unknown"
msgid "  As though regressing from primates to wild beasts, they dropped prone in unison..."
msgstr "　彼らは一律、二足歩行の生き物である事を忘れたように倒れこみ、四つんばいになって前進する。"

#. Occurrence 9_5:919:13741: scene=9_5
#: 9_5:919
msgctxt "text_id=13741 | speaker=unknown"
msgid "  ...and scrambled forth, like man-sized ants."
msgstr "　……その姿は巨大な<蟻|あり>そのものだ。"

#. Occurrence 9_5:924:13742: scene=9_5
#: 9_5:924
msgctxt "text_id=13742 | speaker=unknown"
msgid "  They advanced as a stream, one after another."
msgstr "　ぞろぞろと、次々と。"

#. Occurrence 9_5:929:13743: scene=9_5
#: 9_5:929
msgctxt "text_id=13743 | speaker=unknown"
msgid "  Soon, the clattering came not just from the platform entrances, but from the subway tunnel as well."
msgstr "　階段のみならず、レールのある洞穴からもカタカタと音を響かせて大挙してくる。"

#. Occurrence 9_5:982:13744: scene=9_5
#: 9_5:982
msgctxt "text_id=13744 | speaker=unknown"
msgid "  At a glance, they numbered at least thirty strong."
msgstr "　その数、目測で三十体以上。"

#. Occurrence 9_5:987:13745: scene=9_5
#: 9_5:987
msgctxt "text_id=13745 | speaker=unknown"
msgid "  The eerie skittering multiplied, echoing off the subway walls."
msgstr "　おぞましい事に、響いてくる足音は増していくばかりだ。"

#. Occurrence 9_5:1031:13746: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0006; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:1031
msgctxt "text_id=13746 | speaker=aoko"
msgid "\"This is ridiculous. Forget Misaki; with this many automata, you could take over all of southern France.\""
msgstr "「信じられない。これだけの自動人形、集めたら<三咲|うち>どころか南<仏|フランス>の一等地も買えるんじゃない？」"

#. Occurrence 9_5:1049:13747: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0007; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:1049
msgctxt "text_id=13747 | speaker=alice"
msgid "\"...True, but I doubt there would be much demand for dolls of such poor quality.\""
msgstr "「……ええ。もっとも、こんな出来じゃ買手は見つからないでしょうけど」"

#. Occurrence 9_5:1075:13748: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0007; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:1075
msgctxt "text_id=13748 | speaker=aoko"
msgid "\"Junk is junk, after all.\""
msgstr "「なんだ、ガラクタはガラクタか」"

#. Occurrence 9_5:1095:13749: scene=9_5
#: 9_5:1095
msgctxt "text_id=13749 | speaker=unknown"
msgid "  One of the horde leapt forward in response to Aoko's insult."
msgstr "　青子の罵倒に応じて、人影の一体が飛び跳ねる。"

#. Occurrence 9_5:1151:13750: scene=9_5
#: 9_5:1151
msgctxt "text_id=13750 | speaker=unknown"
msgid "  It was a sudden charge, like a hurtling dump truck."
msgstr "　ダンプカーに<撥|は>ねられたような、唐突な突進。"

#. Occurrence 9_5:1156:13751: scene=9_5
#: 9_5:1156
msgctxt "text_id=13751 | speaker=unknown"
msgid "  Alice remained still."
msgstr "　有珠は動かず。"

#. Occurrence 9_5:1181:13752: scene=9_5
#: 9_5:1181
msgctxt "text_id=13752 | speaker=unknown"
msgid "  As though expecting the attack, Aoko swung her right arm in an arc."
msgstr "　青子はそれを待っていたかのように、振り向きながら右腕を振るった。"

#. Occurrence 9_5:1295:13753: scene=9_5
#: 9_5:1295
msgctxt "text_id=13753 | speaker=unknown"
msgid "  The blue missile of light was easily repelled."
msgstr "　青い光弾はたやすく外皮に防がれた。"

#. Occurrence 9_5:1309:13754: scene=9_5
#: 9_5:1309
msgctxt "text_id=13754 | speaker=unknown"
msgid "  Her magic bullet, Snap, had little to no effect on the puppets."
msgstr "　魔力を弾いただけの<魔弾|スナップ>では、この人形たちには通用しない。"

#. Occurrence 9_5:1315:13755: scene=9_5
#: 9_5:1315
msgctxt "text_id=13755 | speaker=unknown"
msgid "  They scrambled over each other like frogs, heads jerking and twisting in search of prey."
msgstr "　人影はカエルのように地面に這い、首をくるりと一回転させて<獲物|あおこ>を探し求めている。"

#. Occurrence 9_5:1336:13756: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0008; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:1336
msgctxt "text_id=13756 | speaker=aoko"
msgid "\"I count...thirty total. Sorry Alice, but I'm gonna need you to hang back. I can't have you thinking last time was my best.\""
msgstr "「……全部で三十か。悪いけど一人でやらせてもらうわよ有珠。この前のを実力と思われたままじゃ不愉快だ」"

#. Occurrence 9_5:1360:13757: scene=9_5
#: 9_5:1360
msgctxt "text_id=13757 | speaker=unknown"
msgid "  As she spoke to Alice, who was still sitting on a bench, Aoko stepped toward the edge of the platform."
msgstr "　ホームの端にまで移動して、青子はベンチに座ったままの少女に語りかけた。"

#. Occurrence 9_5:1380:13758: scene=9_5
#: 9_5:1380
msgctxt "text_id=13758 | speaker=unknown"
msgid "  Among the myriad regrets she still had from the amusement park, the house of mirrors stung the most."
msgstr "　あの遊園地での反省は山ほどあるが、特に痛恨なのはミラーハウスでの一戦だ。"

#. Occurrence 9_5:1385:13759: scene=9_5
#: 9_5:1385
msgctxt "text_id=13759 | speaker=unknown"
msgid "  She had been caught off guard in her last battle against that puppet."
msgstr "　人形戦に関して言うと、青子はまったく戦闘準備をしていなかった。"

#. Occurrence 9_5:1405:13760: scene=9_5
#: 9_5:1405
msgctxt "text_id=13760 | speaker=unknown"
msgid "  But today, she'd come prepared, and she had Alice as backup."
msgstr "　けれど今日は万全の態勢で、フォロー役として有珠までいる。"

#. Occurrence 9_5:1461:13761: scene=9_5
#: 9_5:1461
msgctxt "text_id=13761 | speaker=unknown"
msgid "  Aoko ignited her Magic Crest. This time, she would restore her honor, and―"
msgstr "　ここで思う存分、雪辱を果たそうと青子は魔術刻印に火を灯し―――。"

#. Occurrence 9_5:1483:13762: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0008; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:1483
msgctxt "text_id=13762 | speaker=alice"
msgid "\"Get behind me, Aoko. It'll eat you too if you stand there.\""
msgstr "「私の後ろまで下がって青子。そこにいたら、貴女まで食べてしまう」"

#. Occurrence 9_5:1489:13763: scene=9_5
#: 9_5:1489
msgctxt "text_id=13763 | speaker=unknown"
msgid "  All it took to stop Aoko was one raised finger."
msgstr "　有珠はそれを、持ち上げた一指だけで停止させた。"

#. Occurrence 9_5:1564:13764: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0009; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:1564
msgctxt "text_id=13764 | speaker=aoko"
msgid "\"Alice, wait, you can't―\""
msgstr "「待って―――有珠、それは」"

#. Occurrence 9_5:1587:13765: scene=9_5
#: 9_5:1587
msgctxt "text_id=13765 | speaker=unknown"
msgid "  In the depths of the ocean black, the bells of night chimed out."
msgstr "　地中の深海に、夜の鐘が響いていく。"

#. Occurrence 9_5:1610:13766: scene=9_5
#: 9_5:1610
msgctxt "text_id=13766 | speaker=unknown"
msgid "  The jetty, as if embraced by a sea god like Poseidon or Wadatsumi,"
msgstr "　桟橋は<海神|わだつみ>の腕に抱かれるように、"

#. Occurrence 9_5:1616:13767: scene=9_5
#: 9_5:1616
msgctxt "text_id=13767 | speaker=unknown"
msgid "  became awash with white..."
msgstr "　白い、"

msgctxt "text_id=13768 | speaker=unknown"
msgid "  White motes, which seemed to engulf everything."
msgstr "　白い粒子に覆われていく。"

#. Occurrence 9_5:1639:13769: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0009; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:1639
msgctxt "text_id=13769 | speaker=alice"
msgid "\"You always leave a mess, Aoko."
msgstr "「……青子のやり方じゃ<疵痕|あと>が残るでしょう。"

#. Occurrence 9_5:1645:13770: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0010; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:1645
msgctxt "text_id=13770 | speaker=alice"
msgid "  Not to mention the next train will be arriving soon, and...\""
msgstr "　もうじき次の電車も来るし、それに―――」"

#. Occurrence 9_5:1673:13771: scene=9_5
#: 9_5:1673
msgctxt "text_id=13771 | speaker=unknown"
msgid "  Behind the white veil, her form blurred and stretched upward."
msgstr "　白いヴェールの向こうで、不確かに伸び上がる少女のカタチ。"

#. Occurrence 9_5:1728:13772: scene=9_5
#: 9_5:1728
msgctxt "text_id=13772 | speaker=unknown"
msgid "  She was like a melancholy ballerina."
msgstr "　悲壮な<群舞|バレエ>のようだ。"

#. Occurrence 9_5:1733:13773: scene=9_5
#: 9_5:1733
msgctxt "text_id=13773 | speaker=unknown"
msgid "  The figures surrounding the prima ballerina bristled in response to the strange aura."
msgstr "　<主役|プリマ>の周りを囲む人形たちは異常を察してざわめいている。"

#. Occurrence 9_5:1738:13774: scene=9_5
#: 9_5:1738
msgctxt "text_id=13774 | speaker=unknown"
msgid "  Though puppets were inhuman Mystical vessels,"
msgstr "　彼らとて人間外の、神秘に属する器物である。"

#. Occurrence 9_5:1743:13775: scene=9_5
#: 9_5:1743
msgctxt "text_id=13775 | speaker=unknown"
msgid "  they had far more reason to fear Alice than they did the human Aoko."
msgstr "　あの少女が恐れるに足りるモノだと、人間である青子より何倍も悟っている。"

#. Occurrence 9_5:1802:13776: scene=9_5
#: 9_5:1802
msgctxt "text_id=13776 | speaker=unknown"
msgid "  They began to flee."
msgstr "　なので逃げる。"

#. Occurrence 9_5:1807:13777: scene=9_5
#: 9_5:1807
msgctxt "text_id=13777 | speaker=unknown"
msgid "  Whoever their master was, they sensed enough danger to order a retreat."
msgstr "　人形たちの主人も、危険を感じたのなら撤退しろと言っていたのだ。"

#. Occurrence 9_5:1844:13778: scene=9_5
#: 9_5:1844
msgctxt "text_id=13778 | speaker=unknown"
msgid "  However... "
msgstr "　けれど、"

msgctxt "text_id=13779 | speaker=unknown"
msgid "it was too late. The dancers were captivated by their prima, transfixed in place,"
msgstr "もう動けない。<主役|プリマ>を見守るダンサーたちは、のきなみ、"

msgctxt "text_id=13780 | speaker=unknown"
msgid " as if their Achilles tendons had been severed."
msgstr "アキレス腱を外されてしまったらしい。"

#. Occurrence 9_5:1872:13781: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0011; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:1872
msgctxt "text_id=13781 | speaker=alice"
msgid "\"Besides..."
msgstr "「―――それに。"

#. Occurrence 9_5:1922:13782: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0012; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:1922
msgctxt "text_id=13782 | speaker=alice"
msgid "  It wasn't just you who ruined my mood.\""
msgstr "　気分を台無しにされたのは、貴女だけじゃないわ」"

#. Occurrence 9_5:1942:13783: scene=9_5
#: 9_5:1942
msgctxt "text_id=13783 | speaker=unknown"
msgid "  She removed her black glove."
msgstr "　外される黒い手袋。"

#. Occurrence 9_5:1947:13784: scene=9_5
#: 9_5:1947
msgctxt "text_id=13784 | speaker=unknown"
msgid "  Unlike her subdued demeanor at the mansion, Alice's aura away from home was a biting, frigid blizzard that none could approach."
msgstr "　洋館の中とは一変して、外では異常な寒がりである彼女の防寒ぶりは凄まじい。"

#. Occurrence 9_5:1952:13785: scene=9_5
#: 9_5:1952
msgctxt "text_id=13785 | speaker=unknown"
msgid "  Her discarded gloves floated down, settling on the platform deck."
msgstr "　二枚重ねの手袋が、ぱさりとホームに落ちる。"

#. Occurrence 9_5:1986:13786: scene=9_5
#: 9_5:1986
msgctxt "text_id=13786 | speaker=unknown"
msgid "  The pale haze grew even thicker."
msgstr "　濃度を増していく白い闇。"

#. Occurrence 9_5:2016:13787: scene=9_5
#: 9_5:2016
msgctxt "text_id=13787 | speaker=unknown"
msgid "  Terrified, the mass of shadows cried out for mercy."
msgstr "　<見|ギ><逃|チ><し|ギ><て|チ><く|ギ><れ|チ>、と悲鳴をあげる影の集団。"

#. Occurrence 9_5:2102:13788: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0013; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:2102
msgctxt "text_id=13788 | speaker=alice"
msgid "        \"Now...let us play make-believe.\""
msgstr "　　　　“さあ―――ごっこ遊びをしましょう”"

#. Occurrence 9_5:2122:13789: scene=9_5
#: 9_5:2122
msgctxt "text_id=13789 | speaker=unknown"
msgid "  Within the nebulous mist, a dark fairy tale came to life."
msgstr "　何もかも不確かな、濃霧に映し出される暗黒童話。"

#. Occurrence 9_5:2127:13790: scene=9_5
#: 9_5:2127
msgctxt "text_id=13790 | speaker=unknown"
msgid "  Inside that fog,"
msgstr "　その中で。"

#. Occurrence 9_5:2134:13791: scene=9_5
#: 9_5:2134
msgctxt "text_id=13791 | speaker=unknown"
msgid "  only the macabre melody of her voice felt real."
msgstr "　<凶歌|まがうた>のような彼女の声だけが、血のように<鮮明|リアル>だった。"

#. Occurrence 9_5:2226:13792: scene=9_5
#: 9_5:2226
msgctxt "text_id=13792 | speaker=unknown"
msgid "  Feast / Grind / Crunch."
msgstr "　がつがつ／ざりざり／ぎしゃむ。"

#. Occurrence 9_5:2236:13793: scene=9_5
#: 9_5:2236
msgctxt "text_id=13793 | speaker=unknown"
msgid "  At last, the final puppet fell."
msgstr "　最後に残った人影が消失した。"

#. Occurrence 9_5:2251:13794: scene=9_5
#: 9_5:2251
msgctxt "text_id=13794 | speaker=unknown"
msgid "  On the walls / On the floor / On the ceiling / "
msgstr "　壁には／床には／天井には／"

#. Occurrence 9_5:2260:13795: scene=9_5
#: 9_5:2260
msgctxt "text_id=13795 | speaker=unknown"
msgid "  the grotesque, mechanical sounds of their demise filled the air."
msgstr "　あえなく、異質な<擬音|オノマトペ>が染みついている。"

#. Occurrence 9_5:2307:13796: scene=9_5
#: 9_5:2307
msgctxt "text_id=13796 | speaker=unknown"
msgid "  Their twisted shrieks plastered the subway surfaces, like indelible bloodstains."
msgstr "　……彼らの悲鳴は、<拭|ぬぐ>っても消えない血の跡のようだ。"

#. Occurrence 9_5:2312:13797: scene=9_5
#: 9_5:2312
msgctxt "text_id=13797 | speaker=unknown"
msgid "  Some amorphous abomination had―hastily, yet just slowly enough to savor the taste―chewed and devoured all thirty puppets."
msgstr "　三十体におよぶ人形たちは、速やかに、けれど味わうようにゆっくりと、得体の知れない怪物に<咀嚼|そしゃく>された。"

#. Occurrence 9_5:2317:13798: scene=9_5
#: 9_5:2317
msgctxt "text_id=13798 | speaker=unknown"
msgid "  Only a lone, severed arm remained on the platform."
msgstr "　わずか一体分……それも片腕一本だけが、淋しくホームに残されている。"

#. Occurrence 9_5:2354:13799: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0010; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:2354
msgctxt "text_id=13799 | speaker=aoko"
msgid "\"You had that thing on you this whole time?\""
msgstr "「……持ってきてたの、アレ？」"

#. Occurrence 9_5:2360:13800: scene=9_5
#: 9_5:2360
msgctxt "text_id=13800 | speaker=unknown"
msgid "  Aoko spoke sideways to Alice, making no attempt to hide her disgust."
msgstr "　青子は嫌悪を隠さずに、傍らの少女に語りかける。"

#. Occurrence 9_5:2406:13801: scene=9_5
#: 9_5:2406
msgctxt "text_id=13801 | speaker=unknown"
msgid "  The brutal gluttony they'd just witnessed had a name."
msgstr "　―――濃霧の怪物。"

#. Occurrence 9_5:2412:13802: scene=9_5
#: 9_5:2412
msgctxt "text_id=13802 | speaker=unknown"
msgid "  It was the beast of the fog, one of her Three Great Ploys Kickshaw,"
msgstr "　三体の<貴重品|プロイキッシャー>の一つ、マインスターの薔薇の猟犬。"

#. Occurrence 9_5:2417:13803: scene=9_5
#: 9_5:2417
msgctxt "text_id=13803 | speaker=unknown"
msgid "  the Meinster's Rose Hound: Wandersnatch."
msgstr "　それが、いま吹き荒れた暴力の名称だ。"

#. Occurrence 9_5:2429:13804: scene=9_5
#: 9_5:2429
msgctxt "text_id=13804 | speaker=unknown"
msgid "  Aoko's words stung, since Alice was the one harboring its true form."
msgstr "　青子の言葉に刺があるのは、有珠が、その正体にあたる器物を持ち歩いていたからだ。"

#. Occurrence 9_5:2461:13805: scene=9_5
#: 9_5:2461
msgctxt "text_id=13805 | speaker=unknown"
msgid "  The Great Three Ploys wielded terrifyingly powerful curses."
msgstr "　三大のプロイはそれだけで強力な呪力を放つ。"

#. Occurrence 9_5:2466:13806: scene=9_5
#: 9_5:2466
msgctxt "text_id=13806 | speaker=unknown"
msgid "  While Wandersnatch had its uses in combat, Aoko was not at all amused to learn that her companion had been carrying it around town all day."
msgstr "　防衛戦ならともかく、今日のようなプライベートで持ち歩かれては、相方である青子も面白くはない。"

#. Occurrence 9_5:2472:13807: scene=9_5
#: 9_5:2472
msgctxt "text_id=13807 | speaker=unknown"
msgid "  Without hyperbole, it was akin to going out for dinner with a bunker buster bomb in one's pocket."
msgstr "　大げさな表現ではなく、外食の際、巨大な爆弾を忍ばせているようなものなのだから。"

#. Occurrence 9_5:2508:13808: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0011; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:2508
msgctxt "text_id=13808 | speaker=aoko"
msgid "\"Just... tell me next time, okay?"
msgstr "「ま、次からは一言お願いね。"

#. Occurrence 9_5:2514:13809: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0012; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:2514
msgctxt "text_id=13809 | speaker=aoko"
msgid "  Other Ploys are fine, but not that one. Try to leave it at home, would you?\""
msgstr "　他のプロイならいいけど、今の<玩具|ヤツ>だけは別よ。できれば洋館限定にしてほしいぐらい」"

#. Occurrence 9_5:2556:13810: scene=9_5
#: 9_5:2556
msgctxt "text_id=13810 | speaker=unknown"
msgid "\"..."
msgstr "「…………"

#. Occurrence 9_5:2569:13811: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0014; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:2569
msgctxt "text_id=13811 | speaker=alice"
msgid "I apologize. It's just that I haven't let him feed lately, so...\""
msgstr "悪かったわ。でも、最近なにも食べさせてなかったから」"

#. Occurrence 9_5:2600:13812: scene=9_5
#: 9_5:2600
msgctxt "text_id=13812 | speaker=unknown"
msgid "  Alice walked slowly toward the severed arm."
msgstr "　有珠はホームに転がった人形の腕へと歩いていく。"

#. Occurrence 9_5:2605:13813: scene=9_5
#: 9_5:2605
msgctxt "text_id=13813 | speaker=unknown"
msgid "  Indeed, all she'd done was feed her Ploy."
msgstr "　たしかに、今のは食事以外の何物でもなかった。"

#. Occurrence 9_5:2628:13814: scene=9_5
#: 9_5:2628
msgctxt "text_id=13814 | speaker=unknown"
msgid "  No one had died, and no blood had been shed, since the meal was made of plastic."
msgstr "　食べる者も見えなければ、食べられる物も血を流さないプラスチックな<情事|もの>だったけれど。"

#. Occurrence 9_5:2649:13815: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0015; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:2649
msgctxt "text_id=13815 | speaker=alice"
msgid "\"Aoko, over here.\""
msgstr "「青子、ちょっと」"

#. Occurrence 9_5:2669:13816: scene=9_5
#: 9_5:2669
msgctxt "text_id=13816 | speaker=unknown"
msgid "  Alice picked up the arm and beckoned Aoko over."
msgstr "　残された人形の右腕を拾い上げ、青子を呼びつける。"

#. Occurrence 9_5:2708:13817: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0016; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:2708
msgctxt "text_id=13817 | speaker=alice"
msgid "\"Look at this. Until now, we were thinking our opponent was a puppet master. But... I think we were wrong."
msgstr "「これを見て。わたしたちは今まで、相手を人形<遣|つか>いと思っていたけど―――正確には違ったみたい。"

#. Occurrence 9_5:2720:13818: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0017; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:2720
msgctxt "text_id=13818 | speaker=alice"
msgid "  Can you see it? These puppets are too new."
msgstr "　分かる？　この人形たちは新しすぎる。"

#. Occurrence 9_5:2732:13819: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0018; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:2732
msgctxt "text_id=13819 | speaker=alice"
msgid "  They must have been made no earlier than the seventeenth century. Even that seems hard to believe.\""
msgstr "　この子たちが造られたのは十七世紀以後よ。……それはそれで、信じがたいコトだけど」"

#. Occurrence 9_5:2744:13820: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0013; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:2744
msgctxt "text_id=13820 | speaker=aoko"
msgid "\"What did you just say?\""
msgstr "「なんですって？」"

#. Occurrence 9_5:2791:13821: scene=9_5
#: 9_5:2791
msgctxt "text_id=13821 | speaker=unknown"
msgid "  Although it sounded counterintuitive, automata typically performed better with age."
msgstr "　……矛盾した話ではあるが、<自動人形|オートマタ>は古いものほど性能が良い。"

#. Occurrence 9_5:2796:13822: scene=9_5
#: 9_5:2796
msgctxt "text_id=13822 | speaker=unknown"
msgid "  Since the seventeenth century, the magical concept of using puppets and mannequins had declined. Consequently, it became much harder to produce combat-effective automata."
msgstr "　十七世紀以後、人形・人体模造の魔術概念が衰退した結果、魔術戦に堪えうる<自動人形|オートマタ>の製造は困難になったからだ。"

#. Occurrence 9_5:2820:13823: scene=9_5
#: 9_5:2820
msgctxt "text_id=13823 | speaker=unknown"
msgid "  If one wanted to build an automaton these days, it was far more cost-effective to train even a low-class familiar, and it would be better constructed, too."
msgstr "　近年ではオートマタを一体造るのなら、たとえ低級でも使い魔を錬成した方が遥かにコストが安く、優秀な出来になる。"

#. Occurrence 9_5:2825:13824: scene=9_5
#: 9_5:2825
msgctxt "text_id=13824 | speaker=unknown"
msgid "  Therefore, it was common for modern puppet masters to collect parts made before the seventeenth century and use them in their creations."
msgstr "　故に、この時代の人形遣いは十七世紀以前に造られた作品を蒐集し、手足とするのが常になっていた。"

#. Occurrence 9_5:2830:13825: scene=9_5
#: 9_5:2830
msgctxt "text_id=13825 | speaker=unknown"
msgid "  The high price of automata often came not from their antiquated combat abilities, but from the rarity of the parts used to make them."
msgstr "　自動人形に高値がつくのは、戦闘品としては時代遅れだが、稀少品としての価値がある為である。"

#. Occurrence 9_5:2863:13826: scene=9_5
#: 9_5:2863
msgctxt "text_id=13826 | speaker=unknown"
msgid "  Despite that,"
msgstr "　が。"

#. Occurrence 9_5:2870:13827: scene=9_5
#: 9_5:2870
msgctxt "text_id=13827 | speaker=unknown"
msgid " the enemy mage controlling these puppets used them as fodder, as if they grew on trees."
msgstr "その稀少品を、敵魔術師は湯水のように、それこそ使い捨てのコマのように扱ってきた。"

#. Occurrence 9_5:2875:13828: scene=9_5
#: 9_5:2875
msgctxt "text_id=13828 | speaker=unknown"
msgid "  The only conclusion to be drawn was that their current opponent was a spoiled upstart with wealth, but no territory."
msgstr "　その事実から、今回の敵は“莫大な資金とコレクションを持ちながら、管理地を与えられていない成り上がり者の魔術師である”"

#. Occurrence 9_5:2880:13829: scene=9_5
#: 9_5:2880
msgctxt "text_id=13829 | speaker=unknown"
msgid "  Or so Alice and Aoko imagined, anyway."
msgstr "　そう有珠たちは予想していたのだが―――"

#. Occurrence 9_5:2901:13830: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0019; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:2901
msgctxt "text_id=13830 | speaker=alice"
msgid "\"There's something else."
msgstr "「それともう一つ。"

#. Occurrence 9_5:2927:13831: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0020; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:2927
msgctxt "text_id=13831 | speaker=alice"
msgid "  The internal formulae remind me of Misaki's Bounded Field."
msgstr "　この内部<術式|こうぞう>は三咲市の結界に似ているわ。"

#. Occurrence 9_5:2939:13832: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0021; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:2939
msgctxt "text_id=13832 | speaker=alice"
msgid "  It's as if their maker is asserting that these are the rightful defenders of our city.\""
msgstr "　……まるで自分たちこそが、この街を守る兵士だって主張するぐらい」"

#. Occurrence 9_5:2959:13833: scene=9_5
#: 9_5:2959
msgctxt "text_id=13833 | speaker=unknown"
msgid "  Alice presented the evidence to Aoko, who was still waving fog out of her face."
msgstr "　霧を払いながらやってきた青子へ、有珠は証拠品を差しだした。"

#. Occurrence 9_5:3012:13834: scene=9_5
#: 9_5:3012
msgctxt "text_id=13834 | speaker=unknown"
msgid "  The revelations stirred profound surprise, and then rapid realization."
msgstr "　心底からの驚きと、瞬間の理解。"

#. Occurrence 9_5:3052:13835: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0014; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:3052
msgctxt "text_id=13835 | speaker=aoko"
msgid "\"I see..."
msgstr "「……そう。"

msgctxt "text_id=13836 | speaker=unknown"
msgid "now I get it,\""
msgstr "そういう事なのね」"

#. Occurrence 9_5:3082:13837: scene=9_5
#: 9_5:3082
msgctxt "text_id=13837 | speaker=unknown"
msgid "  Aoko growled, violently smashing the arm on the ground."
msgstr "　青子はいまいましげに呟くと、人形の腕をホームに叩きつけた。"

#. Occurrence 9_5:3087:13838: scene=9_5
#: 9_5:3087
msgctxt "text_id=13838 | speaker=unknown"
msgid "  Her face twisted with anger and a hint of fear."
msgstr "　彼女の顔には怒りと、かすかな恐れが混ざっている。"

#. Occurrence 9_5:3108:13839: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0015; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:3108
msgctxt "text_id=13839 | speaker=aoko"
msgid "\"She didn't bother holding back any of her knickknacks because they weren't worth keeping in reserve, to begin with."
msgstr "「惜し気もなく骨董品を出してくると思ったら、そもそも出し惜しむ程のものじゃなかったワケか。"

#. Occurrence 9_5:3141:13840: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0016; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:3141
msgctxt "text_id=13840 | speaker=aoko"
msgid "  ...Tch. That's why the town's barrier didn't have any effect on her, and how she knew my weaknesses. No wonder she found and removed the sigils so easily."
msgstr "　……チッ。たしかにあの女なら<祖父|まち>の結界にも反応しないし、私の欠点も知ってて当然。支点の退去だって簡単にやってのけるわよね。"

#. Occurrence 9_5:3147:13841: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0017; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:3147
msgctxt "text_id=13841 | speaker=aoko"
msgid "  I should've known.\""
msgstr "　だって―――」"

#. Occurrence 9_5:3187:13842: scene=9_5
#: 9_5:3187
msgctxt "text_id=13842 | speaker=unknown"
msgid "  Alice quietly listened to Aoko's furious rambling, bemused."
msgstr "　狂気を含んだ独白に、有珠は静かに瞳を曇らせる。"

#. Occurrence 9_5:3199:13843: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_5_0022; voice_prefix=A40; voice_category=2; scene=9_5
#: 9_5:3199
msgctxt "text_id=13843 | speaker=alice"
msgid "\"Aoko. So you're saying the one who made these is none other than...\""
msgstr "「青子。これを造ったのは、そうなの？」"

#. Occurrence 9_5:3220:13844: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0018; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:3220
msgctxt "text_id=13844 | speaker=aoko"
msgid "\"That's right. When it came to making things, she always had me beat.\""
msgstr "「ええ。昔から物を造る事に関しちゃズバ抜けていたからね、あの人は」"

#. Occurrence 9_5:3243:13845: scene=9_5
#: 9_5:3243
msgctxt "text_id=13845 | speaker=unknown"
msgid "  Aoko glared at the severed arm."
msgstr "　青子は人形の腕を睨みつける。"

#. Occurrence 9_5:3248:13846: scene=9_5
#: 9_5:3248
msgctxt "text_id=13846 | speaker=unknown"
msgid "  She was furious at its creator, and herself for taking so long to figure it out."
msgstr "　人形の持ち主と、今までそれに気が付かなかった自分自身を責めるように。"

#. Occurrence 9_5:3277:13847: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0019; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:3277
msgctxt "text_id=13847 | speaker=aoko"
msgid "\"But it all adds up, now."
msgstr "「……でも、ようやく合点がいった。"

#. Occurrence 9_5:3283:13848: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0020; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:3283
msgctxt "text_id=13848 | speaker=aoko"
msgid "  As much as I hate to admit it, our current enemy is my big sister, no doubt about it."
msgstr "　認めたくないけど、今回の敵は間違いなく私の<姉貴|あねき>。"

#. Occurrence 9_5:3289:13849: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_5_0021; voice_prefix=A10; voice_category=1; scene=9_5
#: 9_5:3289
msgctxt "text_id=13849 | speaker=aoko"
msgid "  She's the one who was meant to inherit our land, Alice.\""
msgstr "　この土地の<元|もと>継承者、蒼崎<橙子|とうこ>その人よ、有珠」"

#. Occurrence 9_5:3347:13850: scene=9_5
#: 9_5:3347
msgctxt "text_id=13850 | speaker=unknown"
msgid "  The desolate subway platform returned to silence,"
msgstr "　人気の絶えた地下の歩廊で。"

#. Occurrence 9_5:3352:13851: scene=9_5
#: 9_5:3352
msgctxt "text_id=13851 | speaker=unknown"
msgid "  Aoko's words lingering uncomfortably in the air."
msgstr "　負の念を噛むように、青子はそう言い切った。"

#. Occurrence 9_6:97:13852: scene=9_6
#: 9_6:97
msgctxt "text_id=13852 | speaker=unknown"
msgid "  A short time ago, at the Kuonji Estate..."
msgstr "　少しだけ時間を巻き戻して、久遠寺邸。"

#. Occurrence 9_6:102:13853: scene=9_6
#: 9_6:102
msgctxt "text_id=13853 | speaker=unknown"
msgid "  The videotape finished playing."
msgstr "　再生していたビデオが終わる。"

#. Occurrence 9_6:107:13854: scene=9_6
#: 9_6:107
msgctxt "text_id=13854 | speaker=unknown"
msgid "  The VCR had automatically stopped playback, forgoing the need to hit the stop button to avoid the static storm."
msgstr "　耳障りなノイズは停止ボタンを押すまでもなく、自動的に停止した。"

#. Occurrence 9_6:132:13855: scene=9_6
#: 9_6:132
msgctxt "text_id=13855 | speaker=unknown"
msgid "  What remained on-screen was the reflection of Soujyuro and Touko Aozaki, sitting opposite each other in conversation."
msgstr "　ブラウン管に映るのは、テーブルをはさんで談話する草十郎と、蒼崎橙子の姿だけ。"

#. Occurrence 9_6:162:13856: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0000; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:162
msgctxt "text_id=13856 | speaker=touko"
msgid "\"A direct attack without warning because her secret was exposed... Aoko never did play well with others.\""
msgstr "「……秘密を知られたから宣誓なしの直接攻撃、ね……懐柔策を考えもしないのは青子らしいけど」"

#. Occurrence 9_6:182:13857: scene=9_6
#: 9_6:182
msgctxt "text_id=13857 | speaker=unknown"
msgid "  It was hard to tell if she was being patronizing or indifferent."
msgstr "　呆れているのか、どうでもいいのか。"

#. Occurrence 9_6:200:13858: scene=9_6
#: 9_6:200
msgctxt "text_id=13858 | speaker=unknown"
msgid "  Touko Aozaki took a sip from her cup as she listened to Soujyuro's story."
msgstr "　蒼崎橙子は紅茶を口にしながら、草十郎の体験談を聞いている。"

#. Occurrence 9_6:205:13859: scene=9_6
#: 9_6:205
msgctxt "text_id=13859 | speaker=unknown"
msgid "  She would have savored the anecdote about the amusement park kerfuffle, were it not for the poor excuse for a cup of tea in her hands."
msgstr "　失敗だらけだった遊園地での逸話を、不出来な紅茶で飲み下すように。"

#. Occurrence 9_6:239:13860: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0001; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:239
msgctxt "text_id=13860 | speaker=touko"
msgid "\"Thank you for that. I feel so informed."
msgstr "「ありがとう、参考になったわ。"

#. Occurrence 9_6:245:13861: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0002; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:245
msgctxt "text_id=13861 | speaker=touko"
msgid "  I haven't seen Aoko in ages, so I can only imagine the kind of woman she's grown into.\""
msgstr "　ここしばらく青子とは顔を合わせていなかったから、あの子がどんな風に成長したかなんて、想像するしかなかったし」"

#. Occurrence 9_6:277:13862: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0003; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:277
msgctxt "text_id=13862 | speaker=touko"
msgid "\"And, as her sister, the least I can do is apologize."
msgstr "「それと、いちおう肉親としてあやまっておかないとね。"

#. Occurrence 9_6:283:13863: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0004; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:283
msgctxt "text_id=13863 | speaker=touko"
msgid "  I'm sorry you had to experience such a tragic event, Soujyuro."
msgstr "　災難に付き合わせて悪かったわ草十郎くん。"

#. Occurrence 9_6:290:13864: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0005; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:290
msgctxt "text_id=13864 | speaker=touko"
msgid "That girl does have a tendency to be rather... headstrong.\""
msgstr "ほんと、あの子ったら昔っから迷いってものがなかったから」"

#. Occurrence 9_6:309:13865: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0000; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:309
msgctxt "text_id=13865 | speaker=soujuurou"
msgid "\"You said it.\""
msgstr "「なさすぎると思います」"

#. Occurrence 9_6:329:13866: scene=9_6
#: 9_6:329
msgctxt "text_id=13866 | speaker=unknown"
msgid "  Soujyuro was enjoying the conversation, despite having to relive those events."
msgstr "　草十郎は憮然とした顔で抗議するも、会話そのものは楽しいものだった。"

#. Occurrence 9_6:346:13867: scene=9_6
#: 9_6:346
msgctxt "text_id=13867 | speaker=unknown"
msgid "  About an hour passed by while the two of them sat in conversation, neither short on topics to discuss."
msgstr "　ふたりきりになってもう一時間近く経過するが、話題には事欠かない。"

#. Occurrence 9_6:351:13868: scene=9_6
#: 9_6:351
msgctxt "text_id=13868 | speaker=unknown"
msgid "  Aoko was an easy topic for both of them, so the conversation centered mostly around her."
msgstr "　話にのぼるのは青子の事だけだったが、その青子が何かと話題になりやすかったのだ。"

#. Occurrence 9_6:385:13869: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0006; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:385
msgctxt "text_id=13869 | speaker=touko"
msgid "\"By the way, I've been curious about something."
msgstr "「ところで、さっきから気になってる事があるんだけど。"

#. Occurrence 9_6:385:13870: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0006; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:385
msgctxt "text_id=13870 | speaker=touko"
msgid "  And I hope you don't mind me asking...\""
msgstr "　訊いていいかな？」"

#. Occurrence 9_6:391:13871: scene=9_6
#: 9_6:391
msgctxt "text_id=13871 | speaker=unknown"
msgid "  While she kept her posture dignified, Touko's eyes shone with eager curiosity."
msgstr "　礼儀正しい姿勢のまま、目だけが好奇心に輝いている。"

#. Occurrence 9_6:396:13872: scene=9_6
#: 9_6:396
msgctxt "text_id=13872 | speaker=unknown"
msgid "  Her elegance caused Soujyuro's heart to beat a little faster."
msgstr "　その人あたりの良さに、やっぱりドギマギしてしまう草十郎だった。"

#. Occurrence 9_6:431:13873: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0001; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:431
msgctxt "text_id=13873 | speaker=soujuurou"
msgid "\"Curious? About what?\""
msgstr "「気になってる事……ですか？」"

#. Occurrence 9_6:437:13874: scene=9_6
#: 9_6:437
msgctxt "text_id=13874 | speaker=unknown"
msgid "  Despite his caution, he found himself speaking politely."
msgstr "　結果、気をつけても敬語調になってしまう。"

#. Occurrence 9_6:442:13875: scene=9_6
#: 9_6:442
msgctxt "text_id=13875 | speaker=unknown"
msgid "  She smiled affectionately, as if she found him pleasing."
msgstr "　そんな草十郎が微笑ましいのか、橙子は親しみをこめて頷いた。"

#. Occurrence 9_6:474:13876: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0007; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:474
msgctxt "text_id=13876 | speaker=touko"
msgid "\"Well, you see, you surprised me the last time when you ran away, but today I'm surprised by something new."
msgstr "「ええ。一度目はダッシュで逃げられて驚いたけど、今日は違った意味で驚かされた。"

#. Occurrence 9_6:493:13877: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0008; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:493
msgctxt "text_id=13877 | speaker=touko"
msgid "  Is that some kind of in-vogue fashion accessory?\""
msgstr "　ね、そういうのが若い子たちの<流行|はやり>なの？」"

#. Occurrence 9_6:517:13878: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0002; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:517
msgctxt "text_id=13878 | speaker=soujuurou"
msgid "\"Come again?\""
msgstr "「はい？」"

#. Occurrence 9_6:539:13879: scene=9_6
#: 9_6:539
msgctxt "text_id=13879 | speaker=unknown"
msgid "  Touko tilted her head, her eyes fixated on the collar that Aoko had snugly secured around his neck."
msgstr "　橙子の視線は草十郎の首……青子から貰った首輪に向けられている。"

#. Occurrence 9_6:569:13880: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0009; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:569
msgctxt "text_id=13880 | speaker=touko"
msgid "\"Is that a new style of choker? You know, I could swear it was a...\""
msgstr "「新手のチョーカー？　でも、どこから見ても、ほら」"

#. Occurrence 9_6:575:13881: scene=9_6
#: 9_6:575
msgctxt "text_id=13881 | speaker=unknown"
msgid "  The bespectacled woman made a show of holding her tongue."
msgstr "　言いにくそうに言葉をにごす眼鏡の美女。"

#. Occurrence 9_6:580:13882: scene=9_6
#: 9_6:580
msgctxt "text_id=13882 | speaker=unknown"
msgid "  On a completely unrelated note, in another decade, similar accessories would become a standard part of any visual kei artist's wardrobe."
msgstr "　年頃の少年がこういった<装飾|アクセ>をするのはあと十年……<Ｖ系|ヴィジュアル　 　>の台頭を待たねばならないのだが、それは置いておくとして。"

#. Occurrence 9_6:617:13883: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0003; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:617
msgctxt "text_id=13883 | speaker=soujuurou"
msgid "\"Oh, not at all. It's obviously a collar. For dogs.\""
msgstr "「まさか。どこから見ても首輪ですよ。犬用の」"

#. Occurrence 9_6:636:13884: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0010; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:636
msgctxt "text_id=13884 | speaker=touko"
msgid "\"I knew it! It's rather charming, and very much suits you, I might add. Did you put it on yourself?\""
msgstr "「やっぱり？　けどその首輪、すごく可愛いわ。よく似合ってるけど、自分でつけたの？」"

#. Occurrence 9_6:664:13885: scene=9_6
#: 9_6:664
msgctxt "text_id=13885 | speaker=unknown"
msgid "  Touko stared intently, examining the strap."
msgstr "　まじまじとベルトを観察する橙子。"

#. Occurrence 9_6:669:13886: scene=9_6
#: 9_6:669
msgctxt "text_id=13886 | speaker=unknown"
msgid "  While he had never been very conscious of the collar till now, for some reason, Soujyuro found himself blushing."
msgstr "　今までは何も感じなかったクセに、草十郎は少しだけ照れている。"

#. Occurrence 9_6:690:13887: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0004; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:690
msgctxt "text_id=13887 | speaker=soujuurou"
msgid "\"Yes. I put it on... by myself.\""
msgstr "「はい。つけたのは、自分ですけど」"

#. Occurrence 9_6:702:13888: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0011; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:702
msgctxt "text_id=13888 | speaker=touko"
msgid "\"No, silly. I mean, who gave it to you? Was it Aoko? Or perhaps Miss Kuonji?\""
msgstr "「そうじゃなくて、誰から貰ったの？　青子？　それとも久遠寺さん？」"

#. Occurrence 9_6:722:13889: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0005; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:722
msgctxt "text_id=13889 | speaker=soujuurou"
msgid "\"Aoko gave it to me.\""
msgstr "「くれたのは青子ですね」"

#. Occurrence 9_6:727:13890: scene=9_6
#: 9_6:727
msgctxt "text_id=13890 | speaker=unknown"
msgid "  Touko nodded in satisfaction at Soujyuro's candid response."
msgstr "　きっぱりと答える草十郎に、橙子はそう、と満足げに呟いた。"

#. Occurrence 9_6:769:13891: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0012; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:769
msgctxt "text_id=13891 | speaker=touko"
msgid "\"...That makes you Aoko's property.\""
msgstr "「……つまり、君は青子の持ち物な訳か」"

#. Occurrence 9_6:775:13892: scene=9_6
#: 9_6:775
msgctxt "text_id=13892 | speaker=unknown"
msgid "  She coldly muttered. With this, the cordial atmosphere began to turn."
msgstr "　呟いた声は冷たい。それこそ、ここまで打ち解けた雰囲気を一変させるような。"

#. Occurrence 9_6:794:13893: scene=9_6
#: 9_6:794
msgctxt "text_id=13893 | speaker=unknown"
msgid "  Soujyuro nodded, naturally oblivious to the edge in her words."
msgstr "　そんな橙子の鋭さに気づきもしないで、草十郎は頷いた。"

#. Occurrence 9_6:805:13894: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0006; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:805
msgctxt "text_id=13894 | speaker=soujuurou"
msgid "\"She does like to own things.\""
msgstr "「なんでも所有されてるそうです」"

#. Occurrence 9_6:848:13895: scene=9_6
#: 9_6:848
msgctxt "text_id=13895 | speaker=unknown"
msgid "  The blunt observation made Touko burst out laughing."
msgstr "　他人事のように言う草十郎に、橙子はまた笑いだした。"

#. Occurrence 9_6:867:13896: scene=9_6
#: 9_6:867
msgctxt "text_id=13896 | speaker=unknown"
msgid "  Apparently, Touko was the quirky type of person to laugh when least appropriate."
msgstr "　些細な事に笑いだす奇癖を、この人物は持っているらしい。"

#. Occurrence 9_6:872:13897: scene=9_6
#: 9_6:872
msgctxt "text_id=13897 | speaker=unknown"
msgid "  As her laugh tapered off into a giggle, she picked up her now empty teacup."
msgstr "　ひとしきり笑い終わった後、橙子は<空|から>になったティーカップを手に取った。"

#. Occurrence 9_6:904:13898: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0013; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:904
msgctxt "text_id=13898 | speaker=touko"
msgid "\"So, this must belong to Aoko as well? How funny, considering she hates blue things on account of the 'blue' character in her name.\""
msgstr "「じゃ、これも青子のでしょ？　青っていう名前にコンプレックスがある癖に、青い物がわりと好きだから」"

#. Occurrence 9_6:910:13899: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0007; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:910
msgctxt "text_id=13899 | speaker=soujuurou"
msgid "\"Yeah, that's right. ...Would you like another cup?"
msgstr "「そうですけど。……おかわりしますか？"

#. Occurrence 9_6:916:13900: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0008; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:916
msgctxt "text_id=13900 | speaker=soujuurou"
msgid "  I'm not sure when they'll be back.\""
msgstr "　ふたりとも、まだ帰ってきそうにありませんから」"

#. Occurrence 9_6:933:13901: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0014; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:933
msgctxt "text_id=13901 | speaker=touko"
msgid "\"No, thank you. Actually, they'll be returning shortly, as I calculated.\""
msgstr "「いいえ、そろそろ帰ってくる頃よ。そういう風に仕向けたから」"

#. Occurrence 9_6:954:13902: scene=9_6
#: 9_6:954
msgctxt "text_id=13902 | speaker=unknown"
msgid "  Soujyuro nodded along heedlessly."
msgstr "　あ、そうなんですか、と草十郎は相づちを打つ。"

#. Occurrence 9_6:959:13903: scene=9_6
#: 9_6:959
msgctxt "text_id=13903 | speaker=unknown"
msgid "  Finally, the strangeness of her phrasing dawned on him, and he tilted his head in confusion."
msgstr "　……打って、今の言葉のおかしさに首を傾げた。"

#. Occurrence 9_6:990:13904: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0009; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:990
msgctxt "text_id=13904 | speaker=soujuurou"
msgid "\"Miss Touko?\""
msgstr "「橙子さん？」"

#. Occurrence 9_6:995:13905: scene=9_6
#: 9_6:995
msgctxt "text_id=13905 | speaker=unknown"
msgid "  Touko sighed once."
msgstr "　聞き返す草十郎に、橙子は一度だけ嘆息する。"

#. Occurrence 9_6:1029:13906: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0015; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1029
msgctxt "text_id=13906 | speaker=touko"
msgid "\"Forgive me, Soujyuro, but would you allow me to take off my glasses?\""
msgstr "「ごめんね、草十郎くん。眼鏡、外してもいいかしら？」"

#. Occurrence 9_6:1035:13907: scene=9_6
#: 9_6:1035
msgctxt "text_id=13907 | speaker=unknown"
msgid "  He wondered why she would need to ask his permission, but nodded anyway."
msgstr "　なんでそんな事を謝るんだろう、と思いつつ、草十郎はどうぞ、と促す。"

#. Occurrence 9_6:1047:13908: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0016; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1047
msgctxt "text_id=13908 | speaker=touko"
msgid "\"That's very kind of you."
msgstr "「それじゃあ、お言葉に甘えて。"

#. Occurrence 9_6:1053:13909: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0017; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1053
msgctxt "text_id=13909 | speaker=touko"
msgid "  Though, I do wish I could have enjoyed more of your hospitality.\""
msgstr "　もう少しぐらいは、君の反応を見ていたかったけど」"

#. Occurrence 9_6:1088:13910: scene=9_6
#: 9_6:1088
msgctxt "text_id=13910 | speaker=unknown"
msgid "  Touko touched the temples of her glasses."
msgstr "　橙子の指が眼鏡の<蔓|つる>に触れる。"

#. Occurrence 9_6:1093:13911: scene=9_6
#: 9_6:1093
msgctxt "text_id=13911 | speaker=unknown"
msgid "  If one were to look closely enough, one might have noticed the scars on her slender fingers."
msgstr "　彼女の長い指は、よく見ると傷があった。"

#. Occurrence 9_6:1098:13912: scene=9_6
#: 9_6:1098
msgctxt "text_id=13912 | speaker=unknown"
msgid "  They were small, fine scars, from years of repeated cuts."
msgstr "　細かな、年月を積み重ねた切り傷だ。"

#. Occurrence 9_6:1125:13913: scene=9_6
#: 9_6:1125
msgctxt "text_id=13913 | speaker=unknown"
msgid "  Before her fingers even left the eyeglass frames, the spectacles crumbled."
msgstr "　その指が眼鏡を外すより早く、彼女の眼鏡はひとりでに壊れて落ちた。"

#. Occurrence 9_6:1130:13914: scene=9_6
#: 9_6:1130
msgctxt "text_id=13914 | speaker=unknown"
msgid "  It happened so fast that Soujyuro barely registered it."
msgstr "　驚く暇もない。"

#. Occurrence 9_6:1135:13915: scene=9_6
#: 9_6:1135
msgctxt "text_id=13915 | speaker=unknown"
msgid "  The frame cracked into pieces, sliding down her face and into her lap."
msgstr "　フレームは粉々に砕けて、眼鏡は彼女の顔を滑り落ちて、その<両股|あし>に不時着する。"

#. Occurrence 9_6:1203:13916: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0018; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1203
msgctxt "text_id=13916 | speaker=touko"
msgid "\"...Kudos to you, sister. Thirty in one go. Not bad.\""
msgstr "「……やるもんだ。三十体を一瞬とはね」"

#. Occurrence 9_6:1209:13917: scene=9_6
#: 9_6:1209
msgctxt "text_id=13917 | speaker=unknown"
msgid "  The low voice belonged to someone entirely different."
msgstr "　そう呟いた橙子は、今までの彼女ではなかった。"

#. Occurrence 9_6:1217:13918: scene=9_6
#: 9_6:1217
msgctxt "text_id=13918 | speaker=unknown"
msgid "  All she had done was take off her glasses, but her elegant grace had completely faded."
msgstr "　眼鏡が外れただけ。それだけなのに、今までの彼女の趣は完全に消え去っていた。"

#. Occurrence 9_6:1237:13919: scene=9_6
#: 9_6:1237
msgctxt "text_id=13919 | speaker=unknown"
msgid "  Any semblance of warmth and kindness had disappeared."
msgstr "　先ほどまでの温かな印象は何処にもない。"

#. Occurrence 9_6:1242:13920: scene=9_6
#: 9_6:1242
msgctxt "text_id=13920 | speaker=unknown"
msgid "  Sitting upon on the sofa was a deplorable mage, her very presence darkening the room."
msgstr "　そこにいるのは、<在|い>るだけで空気を黒く<淀|よど>ませる、ひとりの醜悪な魔術師だった。"

#. Occurrence 9_6:1294:13921: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0010; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:1294
msgctxt "text_id=13921 | speaker=soujuurou"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 9_6:1299:13922: scene=9_6
#: 9_6:1299
msgctxt "text_id=13922 | speaker=unknown"
msgid "  Soujyuro sat speechless."
msgstr "　草十郎はソファーに座ったままで、言葉もない。"

#. Occurrence 9_6:1314:13923: scene=9_6
#: 9_6:1314
msgctxt "text_id=13923 | speaker=unknown"
msgid "  Across from him was a completely changed Touko, glaring back at him menacingly."
msgstr "　もはや別人になった橙子は、そんな草十郎を性悪そうに眺めている。"

#. Occurrence 9_6:1334:13924: scene=9_6
#: 9_6:1334
msgctxt "text_id=13924 | speaker=unknown"
msgid "  More malice and magical energy was now emanating from Touko than when Aoko had tried to kill Soujyuro."
msgstr "　青子が彼を殺そうとした時以上の敵意と魔力を、これみよがしに立ち<昇|のぼ>らせる。"

#. Occurrence 9_6:1354:13925: scene=9_6
#: 9_6:1354
msgctxt "text_id=13925 | speaker=unknown"
msgid "  She seemed titillated at the prospect of the boy's shock at her transformation."
msgstr "　この少年が自分の変化にどんな反応を示すのか、その怯えや豹変を楽しむように。"

#. Occurrence 9_6:1371:13926: scene=9_6
#: 9_6:1371
msgctxt "text_id=13926 | speaker=unknown"
msgid "  Such expectations, however, were often left unfulfilled when it came to Soujyuro."
msgstr "　しかし。そんなまっとうな<愉悦|かんがえ>は、彼にはまったく適用されなかった。"

#. Occurrence 9_6:1407:13927: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0011; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:1407
msgctxt "text_id=13927 | speaker=soujuurou"
msgid "\"You broke your glasses.\""
msgstr "「眼鏡、壊れましたね」"

#. Occurrence 9_6:1412:13928: scene=9_6
#: 9_6:1412
msgctxt "text_id=13928 | speaker=unknown"
msgid "  Soujyuro blurted out in surprise."
msgstr "　いやぁ驚いた、とばかりに口走る草十郎。"

#. Occurrence 9_6:1431:13929: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0019; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1431
msgctxt "text_id=13929 | speaker=touko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 9_6:1436:13930: scene=9_6
#: 9_6:1436
msgctxt "text_id=13930 | speaker=unknown"
msgid "  Her hand stopped as she reached for a cigarette, the wind taken out of her sails."
msgstr "　<予想|テンポ>を崩したのか、<煙草|シガレット>を取りだそうとした橙子の手が止まってしまう。"

#. Occurrence 9_6:1470:13931: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0012; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:1470
msgctxt "text_id=13931 | speaker=soujuurou"
msgid "\"That was unfortunate. Do you have another pair?\""
msgstr "「もったいない。大丈夫ですか、それ」"

#. Occurrence 9_6:1477:13932: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0020; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1477
msgctxt "text_id=13932 | speaker=touko"
msgid "\"No, forget them. It's not as if I actually need them to see correctly."
msgstr "「……いや、そんな物はいいんだ。多少、視力が落ちたところで大事にはならないし。"

#. Occurrence 9_6:1492:13933: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0021; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1492
msgctxt "text_id=13933 | speaker=touko"
msgid "  As long as my self exists, data is received subjectively by my five senses. The entire world is in a fog. You shouldn't trust what you can only see with your eyes.\""
msgstr "　そもそも<我欲|わたし>があるかぎり、五感による情報にすら主観が入る。全てこの世は霧の中だ。もともと目に見える<だ|・><け|・>のものは信じていない<質|たち>でね」"

#. Occurrence 9_6:1522:13934: scene=9_6
#: 9_6:1522
msgctxt "text_id=13934 | speaker=unknown"
msgid "  Her speech had taken on a clinical tone."
msgstr "　橙子は口調まで中性的なものに変わっている。"

#. Occurrence 9_6:1527:13935: scene=9_6
#: 9_6:1527
msgctxt "text_id=13935 | speaker=unknown"
msgid "  This, too, did not seem to shake Soujyuro."
msgstr "　それすらも草十郎は気にしてはいないようだ。"

#. Occurrence 9_6:1561:13936: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0013; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:1561
msgctxt "text_id=13936 | speaker=soujuurou"
msgid "\"Right... So what you're saying is...\""
msgstr "「そうですか。それで、さっきの言葉の意味ですけど」"

#. Occurrence 9_6:1577:13937: scene=9_6
#: 9_6:1577
msgctxt "text_id=13937 | speaker=unknown"
msgid "  Soujyuro began forming another question, unflinchingly."
msgstr "　変わらずに訊ねてくる草十郎と、"

#. Occurrence 9_6:1594:13938: scene=9_6
#: 9_6:1594
msgctxt "text_id=13938 | speaker=unknown"
msgid "  Touko scowled, as if she'd found a bug in her food."
msgstr "　苦虫をかむように沈黙する橙子。"

#. Occurrence 9_6:1599:13939: scene=9_6
#: 9_6:1599
msgctxt "text_id=13939 | speaker=unknown"
msgid "  After some consideration, she came to the conclusion she needed to be blunt with the boy."
msgstr "　少しの思案の末、橙子はこの少年にははっきり言わないと駄目なんだな、という真理に到達した。"

#. Occurrence 9_6:1615:13940: scene=9_6
#: 9_6:1615
msgctxt "text_id=13940 | speaker=unknown"
msgid "  By some twist of fate, it was a headache she now unknowingly shared with her sister."
msgstr "　何の因果か、おかしな頭痛に悩まされる姉妹である。"

#. Occurrence 9_6:1649:13941: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0022; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1649
msgctxt "text_id=13941 | speaker=touko"
msgid "\"It's like this, Soujyuro. I placed some obstacles in Aoko's way. I'm only here now because she's still dealing with them."
msgstr "「意味も何もない。青子たちの帰り道に、多少の障害を置いただけだ。私がここにいる間は、外で足止めをするように。"

#. Occurrence 9_6:1665:13942: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0023_0; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1665
msgctxt "text_id=13942 | speaker=touko"
msgid "  As I mentioned, you are are merely her property."
msgstr "　君は青子の持ち物だと言ったな。"

#. Occurrence 9_6:1675:13943: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0023_1; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1675
msgctxt "text_id=13943 | speaker=touko"
msgid "So, I won't worry that pretty little head of yours."
msgstr "なら、<殊更|ことさら>丁寧に教えてやる必要もない。"

#. Occurrence 9_6:1696:13944: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0023_2; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1696
msgctxt "text_id=13944 | speaker=touko"
msgid "I must confess, dear Soujyuro―I am your enemy.\""
msgstr "告白してしまうとね、草十郎くん。私が君たちの敵なんだ」"

#. Occurrence 9_6:1778:13945: scene=9_6
#: 9_6:1778
msgctxt "text_id=13945 | speaker=unknown"
msgid "  Though he understood her words, the clock's second hand would rotate fully twice over before anyone next spoke."
msgstr "　草十郎が橙子の発言を理解するのに、たっぷり秒針二周分の時間がかかった。"

#. Occurrence 9_6:1783:13946: scene=9_6
#: 9_6:1783
msgctxt "text_id=13946 | speaker=unknown"
msgid "  They sat across from each other, eyes locked."
msgstr "　ソファーに座ったまま、ふたりは互いに見つめ合う。"

#. Occurrence 9_6:1788:13947: scene=9_6
#: 9_6:1788
msgctxt "text_id=13947 | speaker=unknown"
msgid "  Soujyuro's shoulders tightened nervously."
msgstr "　草十郎の両肩に緊張らしき力みが入る。"

#. Occurrence 9_6:1793:13948: scene=9_6
#: 9_6:1793
msgctxt "text_id=13948 | speaker=unknown"
msgid "  He had finally understood the true danger of the situation."
msgstr "　彼にもようやく、この場がどれほど危険なのか理解できたらしい。"

#. Occurrence 9_6:1837:13949: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0024; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1837
msgctxt "text_id=13949 | speaker=touko"
msgid "\"Surprised?\""
msgstr "「驚いた？」"

#. Occurrence 9_6:1843:13950: scene=9_6
#: 9_6:1843
msgctxt "text_id=13950 | speaker=unknown"
msgid "  Touko asked with a grin."
msgstr "　楽しげに微笑む橙子。"

#. Occurrence 9_6:1860:13951: scene=9_6
#: 9_6:1860
msgctxt "text_id=13951 | speaker=unknown"
msgid "  She was still the same woman, but without her glasses, Touko's smile was rather sinister."
msgstr "　カタチは同じなのに、眼鏡がないだけで冷たい微笑に変わっている。"

#. Occurrence 9_6:1881:13952: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0014; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:1881
msgctxt "text_id=13952 | speaker=soujuurou"
msgid "\"Even though... you're Aozaki's sister?\""
msgstr "「あなたは、蒼崎の姉なのに……？」"

#. Occurrence 9_6:1901:13953: scene=9_6
#: 9_6:1901
msgctxt "text_id=13953 | speaker=unknown"
msgid "  Her smile pierced him as he asked the obvious."
msgstr "　橙子の微笑に圧されながら、草十郎はそんな、当然の疑問を口にした。"

#. Occurrence 9_6:1906:13954: scene=9_6
#: 9_6:1906
msgctxt "text_id=13954 | speaker=unknown"
msgid "  Touko was no longer surprised that Soujyuro would be more concerned about the safety of others than his own."
msgstr "　この状況で自身の安全ではなく<他人事|ひとごと>の質問をする草十郎に、しかし橙子は驚かない。"

#. Occurrence 9_6:1911:13955: scene=9_6
#: 9_6:1911
msgctxt "text_id=13955 | speaker=unknown"
msgid "  In just one short hour, she had come to understand Soujyuro Sizuki better than he knew himself."
msgstr "　彼女は彼以上に、この一時間で静希草十郎という人間を把握していた。"

#. Occurrence 9_6:1940:13956: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0025; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1940
msgctxt "text_id=13956 | speaker=touko"
msgid "\"On the contrary. It's *because* I'm her sister. I'm obligated to take away what is hers."
msgstr "「逆だよ。姉だから敵なんだ。私には青子からあらゆる権利を奪う義務がある。"

#. Occurrence 9_6:1947:13957: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0026; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1947
msgctxt "text_id=13957 | speaker=touko"
msgid "I won't stop until I crush every last thing she holds physically and emotionally dear."
msgstr "物質的な物も、精神的な物も、その全てを踏みにじらなければ気が済まない。"

#. Occurrence 9_6:1963:13958: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0027; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1963
msgctxt "text_id=13958 | speaker=touko"
msgid "  For instance, if she has come to rely on this city, then I will happily go so far as to destroy it."
msgstr "　尺度として言うなら、もし青子がこの街に頼っていたのなら、まず街から壊していたぐらい。"

#. Occurrence 9_6:1974:13959: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0028; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:1974
msgctxt "text_id=13959 | speaker=touko"
msgid "  But you... I wasn't expecting you.\""
msgstr "　―――けど、君の事は予想外だった」"

#. Occurrence 9_6:2007:13960: scene=9_6
#: 9_6:2007
msgctxt "text_id=13960 | speaker=unknown"
msgid "  Touko, her eyes closed, felt sorrow."
msgstr "　橙子は<悼|いた>むように瞳を閉じる。"

#. Occurrence 9_6:2012:13961: scene=9_6
#: 9_6:2012
msgctxt "text_id=13961 | speaker=unknown"
msgid "  Behind her troubled expression, there was a silent conflict."
msgstr "　その顔は静かな葛藤に満ちている。"

#. Occurrence 9_6:2042:13962: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0029; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2042
msgctxt "text_id=13962 | speaker=touko"
msgid "\"I don't know if I should rage at the impartiality of the world, or lament the serendipity of life. I suppose it's all part of the Counter Force."
msgstr "「……世の平等に怒るべきか、<幸運|ぐうぜん>の出会いとやらに嘆くべきか。これも抑止力というヤツかな。"

#. Occurrence 9_6:2048:13963: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0030; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2048
msgctxt "text_id=13963 | speaker=touko"
msgid "  Innocent outsiders get killed all the time in this world of ours, but I've never met anyone quite like you."
msgstr "　無垢な部外者を手に掛けるのは世の常だが、この手合いに会ったのは初めてだ。"

#. Occurrence 9_6:2054:13964: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0031; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2054
msgctxt "text_id=13964 | speaker=touko"
msgid "  Or rather, never imagined a guy like you could exist.\""
msgstr "　いや。そもそも居るなどと、考えた事すらなかったな」"

#. Occurrence 9_6:2077:13965: scene=9_6
#: 9_6:2077
msgctxt "text_id=13965 | speaker=unknown"
msgid "  Touko sighed at the ceiling, and stirred in her seat."
msgstr "　まったく、と空に向かってグチをこぼし、橙子は体を起こす。"

#. Occurrence 9_6:2082:13966: scene=9_6
#: 9_6:2082
msgctxt "text_id=13966 | speaker=unknown"
msgid "  She seemed to have overcome an unexpected moment of uncertainty."
msgstr "　彼女が予想もしていなかった類の迷いは、それで断ち切れたらしい。"

#. Occurrence 9_6:2117:13967: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0032; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2117
msgctxt "text_id=13967 | speaker=touko"
msgid "\"You don't look like Aoko's ace in the hole."
msgstr "「君は青子の切札には見えない。"

#. Occurrence 9_6:2123:13968: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0033; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2123
msgctxt "text_id=13968 | speaker=touko"
msgid "  You're just a dim-but-nice stranger, too pitiful to put out of his misery."
msgstr "　排除しておくまでもない、善良かつ無能な部外者だ。"

#. Occurrence 9_6:2134:13969: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0034; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2134
msgctxt "text_id=13969 | speaker=touko"
msgid "  But as much as I want to leave you be, my sixth sense is screaming that I should erase you now and be done with it.\""
msgstr "　だから放っておきたいのだけど、私の六感がこう告げているんだ。君を逃すな、いいからさっさと済ませてしまえ、と」"

#. Occurrence 9_6:2166:13970: scene=9_6
#: 9_6:2166
msgctxt "text_id=13970 | speaker=unknown"
msgid "  More plainly put, she had made up her mind to kill him."
msgstr "　分かりやすく言うと『よし、いま殺そう』という意味らしい。"

#. Occurrence 9_6:2171:13971: scene=9_6
#: 9_6:2171
msgctxt "text_id=13971 | speaker=unknown"
msgid "  Though Soujyuro was somewhat flattered at how grossly she inflated his importance, he was struck more by the karmic irony―Touko had arrived at the same conclusion as her sister."
msgstr "　過大評価をしてくれる分には嬉しいけれどいきすぎるのも問題で、それより何より、なんだかんだと<青子|いもうと>と同じ結論になるあたり姉妹の<業|ごう>を感じる草十郎である。"

#. Occurrence 9_6:2217:13972: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0015; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:2217
msgctxt "text_id=13972 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 9_6:2223:13973: scene=9_6
#: 9_6:2223
msgctxt "text_id=13973 | speaker=unknown"
msgid "  However, this was no time for idle thoughts."
msgstr "　しかし、悠長に感想を述べている場合でもない。"

#. Occurrence 9_6:2229:13974: scene=9_6
#: 9_6:2229
msgctxt "text_id=13974 | speaker=unknown"
msgid "  Soujyuro readied himself to stand up from the sofa in such a way as to not draw attention to the plan so clearly written all over his face―to make a run for it."
msgstr "　草十郎はできるだけさりげなく―――具体的には逃げだそうとしているのが見え見えな慎重さで―――ソファーから腰をあげようと努力する。"

#. Occurrence 9_6:2256:13975: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0035; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2256
msgctxt "text_id=13975 | speaker=touko"
msgid "\"Silly boy. Don't give yourself away like that. If you're going to run, then run. But if you value your life, then don't move a muscle."
msgstr "「バカもの、こういう時は半端に動くな。逃げるならサッサと逃げる、交渉するならテコでも動くな。"

#. Occurrence 9_6:2268:13976: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0036; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2268
msgctxt "text_id=13976 | speaker=touko"
msgid "  In other words, you won't make it halfway to the door before I get you. Now, be a good boy and sit still.\""
msgstr "　……なんというか、そんな風に動かれるとその気がなくともつい反応してしまうだろう。ほら、命が惜しいのなら大人しく固まっていなさい」"

#. Occurrence 9_6:2304:13977: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0016; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:2304
msgctxt "text_id=13977 | speaker=soujuurou"
msgid "\"So you're... not going to kill me?\""
msgstr "「えっと……殺さない、んですか？」"

#. Occurrence 9_6:2323:13978: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0037; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2323
msgctxt "text_id=13978 | speaker=touko"
msgid "\"For the time being. I like you, kid."
msgstr "「今のところはね。私は君が気に入ったし。"

#. Occurrence 9_6:2329:13979: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0038; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2329
msgctxt "text_id=13979 | speaker=touko"
msgid "  Well, not exactly. The truth is, I might be the only one who can save you.\""
msgstr "　いや、違うな、正しくはこう。私ぐらいしか、君を救ってあげられないのかも、かな」"

#. Occurrence 9_6:2335:13980: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0017; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:2335
msgctxt "text_id=13980 | speaker=soujuurou"
msgid "\"...What?\""
msgstr "「―――はい？」"

#. Occurrence 9_6:2374:13981: scene=9_6
#: 9_6:2374
msgctxt "text_id=13981 | speaker=unknown"
msgid "  She looked the perplexed Soujyuro straight in the eyes."
msgstr "　当惑する草十郎を、正面から見据える橙子。"

#. Occurrence 9_6:2379:13982: scene=9_6
#: 9_6:2379
msgctxt "text_id=13982 | speaker=unknown"
msgid "  Though actually brown, her eyes gleamed a piercing red, like the edge of blade."
msgstr "　赤くさえ見える茶色の瞳は、剣のような鋭さで目前の少年を捕らえている。"

#. Occurrence 9_6:2438:13983: scene=9_6
#: 9_6:2438
msgctxt "text_id=13983 | speaker=unknown"
msgid "  It was at this moment an overwhelming sense of dizziness overcame Soujyuro."
msgstr "　一瞬、草十郎は軽い<眩暈|めまい>に襲われた。"

#. Occurrence 9_6:2443:13984: scene=9_6
#: 9_6:2443
msgctxt "text_id=13984 | speaker=unknown"
msgid "  His mind went numb, like he couldn't tell who he was."
msgstr "　正体のつかめない浮遊感と、脳の痺れ。"

#. Occurrence 9_6:2448:13985: scene=9_6
#: 9_6:2448
msgctxt "text_id=13985 | speaker=unknown"
msgid "  It was like drifting into a sinister sleep from which he'd never wake."
msgstr "　魔物のような眠気、というのがもっとも近いイメージだった。"

#. Occurrence 9_6:2473:13986: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0018; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:2473
msgctxt "text_id=13986 | speaker=soujuurou"
msgid "\"...\""
msgstr "「―――、――――――」"

#. Occurrence 9_6:2479:13987: scene=9_6
#: 9_6:2479
msgctxt "text_id=13987 | speaker=unknown"
msgid "  Soujyuro clenched his jaw, desperate to maintain consciousness."
msgstr "　草十郎は歯を食いしばって意識を保つ。"

#. Occurrence 9_6:2503:13988: scene=9_6
#: 9_6:2503
msgctxt "text_id=13988 | speaker=unknown"
msgid "  Touko's eyes devoured him like a bottomless pit of quicksand."
msgstr "　目前にはあまりにも深い、底なし沼のような橙子の瞳。"

#. Occurrence 9_6:2523:13989: scene=9_6
#: 9_6:2523
msgctxt "text_id=13989 | speaker=unknown"
msgid "  In that moment, it all became clear to him."
msgstr "　……それで、草十郎は漠然と理解した。"

#. Occurrence 9_6:2529:13990: scene=9_6
#: 9_6:2529
msgctxt "text_id=13990 | speaker=unknown"
msgid "  It no longer mattered that she was Aoko's sister,"
msgstr "　アレは青子の姉とかそういったモノでなく、"

#. Occurrence 9_6:2534:13991: scene=9_6
#: 9_6:2534
msgctxt "text_id=13991 | speaker=unknown"
msgid "  or that she was Alice's sworn enemy."
msgstr "　有珠たちの敵というモノでもない。"

#. Occurrence 9_6:2539:13992: scene=9_6
#: 9_6:2539
msgctxt "text_id=13992 | speaker=unknown"
msgid "  Touko Aozaki's deadly battle with the girls, had become his battle."
msgstr "　彼女たちの事情とは別の次元で、蒼崎橙子という人物は自分にとって<危|あや>うい生き物なのだと。"

#. Occurrence 9_6:2572:13993: scene=9_6
#: 9_6:2572
msgctxt "text_id=13993 | speaker=unknown"
msgid "  Which is why..."
msgstr "　何故なら―――"

#. Occurrence 9_6:2577:13994: scene=9_6
#: 9_6:2577
msgctxt "text_id=13994 | speaker=unknown"
msgid "  When you find yourself feeling a special spark for a stranger met mere moments ago, that feeling is not to be trusted."
msgstr "　たった一時間足らずの会話で、理由もないのに他人に心底から共感してしまうのは、良くないことだ。"

#. Occurrence 9_6:2582:13995: scene=9_6
#: 9_6:2582
msgctxt "text_id=13995 | speaker=unknown"
msgid "  You may simply be attempting to fill a void shaped like yourself, with more emptiness."
msgstr "　それはただ、同じ<金型|カタチ>のものが、空洞を埋める為だけに、同じものを求めているにすぎない。"

#. Occurrence 9_6:2616:13996: scene=9_6
#: 9_6:2616
msgctxt "text_id=13996 | speaker=unknown"
msgid "  Soujyuro tried to drag his body away from this heretofore unencountered sense of danger, but found that it would not respond."
msgstr "　これまで感じた事のない危機感に身を引く草十郎だが、体はまったく言う事をきかない。"

#. Occurrence 9_6:2621:13997: scene=9_6
#: 9_6:2621
msgctxt "text_id=13997 | speaker=unknown"
msgid "  Touko tilted her head forward at him, eyes fixated on his."
msgstr "　そんな草十郎を見つめて、橙子は微かにうなずいた。"

#. Occurrence 9_6:2655:13998: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0039; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2655
msgctxt "text_id=13998 | speaker=touko"
msgid "\"Your instincts weren't wrong; you do have something in common with me. Or maybe you're just close to me. Maybe we're picky about all the same foods. It's something to consider."
msgstr "「君の思う通り、私は君と似たところがある。それとも君が私に近いのかな。なに、食べ物の好き嫌い程度の類似だが、軽視する事でもない。"

#. Occurrence 9_6:2673:13999: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0040; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2673
msgctxt "text_id=13999 | speaker=touko"
msgid "  The problem is, you're more... biased than I am.\""
msgstr "　問題は、君が私より<偏|かたよ>っている、という事でね」"

#. Occurrence 9_6:2693:14000: scene=9_6
#: 9_6:2693
msgctxt "text_id=14000 | speaker=unknown"
msgid "  Biased."
msgstr "　偏っている。"

#. Occurrence 9_6:2709:14001: scene=9_6
#: 9_6:2709
msgctxt "text_id=14001 | speaker=unknown"
msgid "  She clearly used a different definition of the word than the one Soujyuro knew."
msgstr "　その言葉を、草十郎は違う意味にしかとれなかった。"

#. Occurrence 9_6:2732:14002: scene=9_6
#: 9_6:2732
msgctxt "text_id=14002 | speaker=unknown"
msgid "  \"Biased.\""
msgstr "　偏っている。"

msgctxt "text_id=14003 | speaker=unknown"
msgid " It meant that he was alone―"
msgstr "傍には誰もいない。"

msgctxt "text_id=14004 | speaker=unknown"
msgid "that he was an outsider who didn't belong in this town."
msgstr "おまえはこの町では、仲間外れの異邦人だと。"

#. Occurrence 9_6:2742:14005: scene=9_6
#: 9_6:2742
msgctxt "text_id=14005 | speaker=unknown"
msgid "  A sudden and seething anger eclipsed his gentle heart."
msgstr "　急激な反感が、温厚な彼の<性格|こころ>を沸騰させる。"

#. Occurrence 9_6:2782:14006: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0019; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:2782
msgctxt "text_id=14006 | speaker=soujuurou"
msgid "\"But... I'm not alone.\""
msgstr "「俺、ひとりじゃないですけど」"

#. Occurrence 9_6:2790:14007: scene=9_6
#: 9_6:2790
msgctxt "text_id=14007 | speaker=unknown"
msgid "  Soujyuro shot back with all the enmity he could muster,"
msgstr "　心底からの嫌悪をこめて、草十郎は言い返す。"

#. Occurrence 9_6:2795:14008: scene=9_6
#: 9_6:2795
msgctxt "text_id=14008 | speaker=unknown"
msgid "  as he faced this witch named Touko Aozaki."
msgstr "　蒼崎橙子と名乗る目前の魔女に。"

#. Occurrence 9_6:2800:14009: scene=9_6
#: 9_6:2800
msgctxt "text_id=14009 | speaker=unknown"
msgid "  If he had not, he feared he would never escape her gaze."
msgstr "　そう言い返さなければ、彼女の目から逃れられなくなりそうで恐ろしかった。"

#. Occurrence 9_6:2837:14010: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0041; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2837
msgctxt "text_id=14010 | speaker=touko"
msgid "\"See. That's precisely what makes you biased. And the sooner you realize that, the better. It's the fastest way out of your predicament."
msgstr "「だろうな。だからこそ君は偏っているんだ。早くそれに気付きなさい。一番てっとり早い解決は、それでいいんだと認める事だ。"

#. Occurrence 9_6:2844:14011: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0042; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2844
msgctxt "text_id=14011 | speaker=touko"
msgid "Humans are hardy creatures. No matter what life throws at them, they find a way to survive."
msgstr "人間なんて逞しいもんでね。別に、何もかも放り投げても上手くいくものなのさ。"

#. Occurrence 9_6:2850:14012: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0043; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2850
msgctxt "text_id=14012 | speaker=touko"
msgid "  But... Aoko can't tolerate them, because she's the sort of stranger who can't stand anything.\""
msgstr "　けれど―――青子にはそれは許せない。アレは他人であれ、あらゆる事を許さない人間だからな」"

#. Occurrence 9_6:2881:14013: scene=9_6
#: 9_6:2881
msgctxt "text_id=14013 | speaker=unknown"
msgid "  Touko leaned over the table."
msgstr "　言って、橙子はテーブルに身を乗り出した。"

#. Occurrence 9_6:2887:14014: scene=9_6
#: 9_6:2887
msgctxt "text_id=14014 | speaker=unknown"
msgid "  She reached out, grabbed Soujyuro's collar, and roughly pulled him toward her."
msgstr "　片手を伸ばして草十郎の首輪を掴むと、力任せに自分へと引き寄せる。"

#. Occurrence 9_6:2919:14015: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0044; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2919
msgctxt "text_id=14015 | speaker=touko"
msgid "\"But enough about her. All I care about is getting to have you. In fact, I wanted you from the moment you mumbled your name like it's not even yours.\""
msgstr "「いや、そんな事はいいんだ。ただ純粋に、私は君が欲しいと思った。君が、自分の名前すら定かではないと名乗った時にね」"

#. Occurrence 9_6:2940:14016: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0045; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2940
msgctxt "text_id=14016 | speaker=touko"
msgid "\"I want you with your lack of self-awareness, and your sense of powerlessness."
msgstr "「自分の認識が不明で、自分自身が不能と感じる。"

#. Occurrence 9_6:2946:14017: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0046; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2946
msgctxt "text_id=14017 | speaker=touko"
msgid "  The future must seem like such a foreign concept to someone like you. Your mind inevitably looks to the past."
msgstr "　未来というものが、とても自分に関わりのある事とは思えない。となれば必然、心情は過去への逆行を試みる。"

#. Occurrence 9_6:2955:14018: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0047; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2955
msgctxt "text_id=14018 | speaker=touko"
msgid "  But just as moi―the lesser self―comes before soi― the greater self―the normal flow of time will always reject time travel."
msgstr "　しかし、所詮<大我|ソア>の前の<小我|モア>のように、正常な流れの前には時間旅行は押し戻されてしまう。"

#. Occurrence 9_6:2961:14019: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0048; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2961
msgctxt "text_id=14019 | speaker=touko"
msgid "  It's the same for me as it is for you."
msgstr "　それも私にあって君にある物だ。"

#. Occurrence 9_6:2972:14020: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0049; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:2972
msgctxt "text_id=14020 | speaker=touko"
msgid "  Argh, I've done it again, haven't I? How could you possibly even begin to...\""
msgstr "　ああ、なんて無様な私。なんて哀れな―――」"

#. Occurrence 9_6:2997:14021: scene=9_6
#: 9_6:2997
msgctxt "text_id=14021 | speaker=unknown"
msgid "  Touko trailed off mid-sentence."
msgstr "　言いかけて、橙子は口を塞ぐ。"

#. Occurrence 9_6:3006:14022: scene=9_6
#: 9_6:3006
msgctxt "text_id=14022 | speaker=unknown"
msgid "  As she pulled Soujyuro closer, her own eyes reflected in his, she noticed the merciful expression on her face."
msgstr "　引き寄せられた草十郎の目に映るのは、橙子の目に映った、憐れみの表情をうかべた自分だけだった。"

#. Occurrence 9_6:3026:14023: scene=9_6
#: 9_6:3026
msgctxt "text_id=14023 | speaker=unknown"
msgid "  Soujyuro got to thinking."
msgstr "　草十郎は思う。"

#. Occurrence 9_6:3031:14024: scene=9_6
#: 9_6:3031
msgctxt "text_id=14024 | speaker=unknown"
msgid "  He held no hostility toward this woman."
msgstr "　この女性に敵意はない。"

#. Occurrence 9_6:3036:14025: scene=9_6
#: 9_6:3036
msgctxt "text_id=14025 | speaker=unknown"
msgid "  He bore her no grudge, harbored no desire to kill her."
msgstr "　殺意も、失意もない。"

#. Occurrence 9_6:3041:14026: scene=9_6
#: 9_6:3041
msgctxt "text_id=14026 | speaker=unknown"
msgid "  He was aware only of his anger and aimless compassion."
msgstr "　あるのは怒りと、行く当てのない<憐憫|れんびん>だけだ。"

#. Occurrence 9_6:3046:14027: scene=9_6
#: 9_6:3046
msgctxt "text_id=14027 | speaker=unknown"
msgid "  He wished that he could give her the answers she wanted."
msgstr "　出来れば彼女の望む答えを口にしてやりたい。"

#. Occurrence 9_6:3051:14028: scene=9_6
#: 9_6:3051
msgctxt "text_id=14028 | speaker=unknown"
msgid "  But..."
msgstr "　けれど―――"

#. Occurrence 9_6:3087:14029: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0020; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:3087
msgctxt "text_id=14029 | speaker=soujuurou"
msgid "\"I don't really know what you're talking about.\""
msgstr "「あなたの言っている事は、よく分からない」"

#. Occurrence 9_6:3104:14030: scene=9_6
#: 9_6:3104
msgctxt "text_id=14030 | speaker=unknown"
msgid "  Soujyuro replied apologetically."
msgstr "　申し訳ないように草十郎は返答した。"

#. Occurrence 9_6:3109:14031: scene=9_6
#: 9_6:3109
msgctxt "text_id=14031 | speaker=unknown"
msgid "  A verbal reply to the visible question he perceived in her eyes."
msgstr "　視線で問われた事を、はっきりと言葉にして。"

#. Occurrence 9_6:3114:14032: scene=9_6
#: 9_6:3114
msgctxt "text_id=14032 | speaker=unknown"
msgid "  Touko showed no sign of disappointment."
msgstr "　橙子に落胆の色はない。"

#. Occurrence 9_6:3119:14033: scene=9_6
#: 9_6:3119
msgctxt "text_id=14033 | speaker=unknown"
msgid "  Instead, the corners of her lips turned upward in delight."
msgstr "　むしろ楽しげに、かすかに唇をつり上げた。"

#. Occurrence 9_6:3157:14034: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0050; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3157
msgctxt "text_id=14034 | speaker=touko"
msgid "\"Of course, you wouldn't comprehend the language of magecraft."
msgstr "「そうか。君には言葉の<魔術|あんじ>は通じないんだな。"

#. Occurrence 9_6:3163:14035: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0051; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3163
msgctxt "text_id=14035 | speaker=touko"
msgid "  And here I am trying to wax philosophical to you. How foolish of me. Small courtesies can have the opposite effect, after all. I should have put it in plainer, more primitive terms."
msgstr "　意味深な台詞回しで丸飲みにしてやろうとも思ったが、いや、失敗失敗。<小奇麗|こぎれい>な建前は逆効果だった。君には剥き出しの、原始的な語りの方が良かったんだな。"

#. Occurrence 9_6:3179:14036: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0052; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3179
msgctxt "text_id=14036 | speaker=touko"
msgid "  Oh, I *do* like you, Soujyuro.\""
msgstr "　―――いいよ、ますます気に入った」"

#. Occurrence 9_6:3213:14037: scene=9_6
#: 9_6:3213
msgctxt "text_id=14037 | speaker=unknown"
msgid "  Her fingers dug into his throat as if she were tearing at the leather."
msgstr "　首輪を掴む指が、革を引き裂くように喉元に食いこむ。"

#. Occurrence 9_6:3218:14038: scene=9_6
#: 9_6:3218
msgctxt "text_id=14038 | speaker=unknown"
msgid "  Perhaps he could be hers if only she could rip it off."
msgstr "　それを裂いてしまえば、この少年は自分の物になると言うかのように。"

#. Occurrence 9_6:3255:14039: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0053; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3255
msgctxt "text_id=14039 | speaker=touko"
msgid "\"Sweet boy. Leave Aoko and be with me."
msgstr "「―――少年。青子なぞより私のもとにこい。"

#. Occurrence 9_6:3261:14040: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0054; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3261
msgctxt "text_id=14040 | speaker=touko"
msgid "  I may not have a use for you, but at least I can protect you. Or maybe if I'm bored, you could be my plaything.\""
msgstr "　使い道はないが保護ぐらいはしてやろう。手が空いた時なら、気晴らしに愛してやってもいい」"

#. Occurrence 9_6:3281:14041: scene=9_6
#: 9_6:3281
msgctxt "text_id=14041 | speaker=unknown"
msgid "  It had taken many approaches, but she seemed to have decided on this one."
msgstr "　色々回り道はしたが、それが彼女の結論らしい。"

#. Occurrence 9_6:3286:14042: scene=9_6
#: 9_6:3286
msgctxt "text_id=14042 | speaker=unknown"
msgid "  The lengths to which she went to seduce him were not lost on Soujyuro, and truth be told, they were not wholly unwelcome."
msgstr "　誘われている草十郎は、そこまで買われている事が不思議でしようがない。嬉しくないというのも嘘になる。"

#. Occurrence 9_6:3291:14043: scene=9_6
#: 9_6:3291
msgctxt "text_id=14043 | speaker=unknown"
msgid "  But back to the matter at hand..."
msgstr "　しかし、それはそれとして、"

#. Occurrence 9_6:3298:14044: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0021; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:3298
msgctxt "text_id=14044 | speaker=soujuurou"
msgid "\"I respectfully decline.\""
msgstr "「それは、お断りします」"

#. Occurrence 9_6:3304:14045: scene=9_6
#: 9_6:3304
msgctxt "text_id=14045 | speaker=unknown"
msgid "  Soujyuro chose the direct response, as he did."
msgstr "　またもきっぱりと、草十郎は即答した。"

#. Occurrence 9_6:3332:14046: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0055; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3332
msgctxt "text_id=14046 | speaker=touko"
msgid "\"...Why?\""
msgstr "「―――なぜ？」"

#. Occurrence 9_6:3338:14047: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0022; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:3338
msgctxt "text_id=14047 | speaker=soujuurou"
msgid "\"Because it wouldn't be good for you.\""
msgstr "「だって、貴方のためにならない」"

#. Occurrence 9_6:3357:14048: scene=9_6
#: 9_6:3357
msgctxt "text_id=14048 | speaker=unknown"
msgid "  He had confidence in that, at least."
msgstr "　それだけは胸を張って断言できる。"

#. Occurrence 9_6:3362:14049: scene=9_6
#: 9_6:3362
msgctxt "text_id=14049 | speaker=unknown"
msgid "  Touko's overestimation of him aside, Soujyuro knew for a fact that he had to escape this woman's clutches."
msgstr "　橙子の過大評価はともかく、草十郎は、自分がこの人物をどうにかしてはいけない、と強く感じていた。"

#. Occurrence 9_6:3367:14050: scene=9_6
#: 9_6:3367
msgctxt "text_id=14050 | speaker=unknown"
msgid "  This tête-à-tête could only be concluded by one of its two participants: Touko, or the individual she was currently infatuated with."
msgstr "　結論を出すのは彼女本人か、彼女が<拘|こだわ>っている相手の手でなければ間違っている、と。"

#. Occurrence 9_6:3407:14051: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0056; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3407
msgctxt "text_id=14051 | speaker=touko"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 9_6:3413:14052: scene=9_6
#: 9_6:3413
msgctxt "text_id=14052 | speaker=unknown"
msgid "  On a hunch, the boy mustered all the conviction he could feign."
msgstr "　直感を通り越した、信念めいた少年の断言。"

#. Occurrence 9_6:3428:14053: scene=9_6
#: 9_6:3428
msgctxt "text_id=14053 | speaker=unknown"
msgid "  She gently removed her hand from his collar and jabbed him in the chest, causing him to topple back onto the sofa."
msgstr "　橙子はそっと首輪から指をぬいて、とん、と近寄っていた草十郎をソファーへと押し戻した。"

#. Occurrence 9_6:3460:14054: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0057; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3460
msgctxt "text_id=14054 | speaker=touko"
msgid "\"Very well. If that's the way it must be."
msgstr "「そうか。なら仕方がない。"

#. Occurrence 9_6:3466:14055: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0058; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3466
msgctxt "text_id=14055 | speaker=touko"
msgid "  I'll just have to think of you as Aoko's personal property then.\""
msgstr "　君も、青子の大切な持ち物として考える事にしよう」"

#. Occurrence 9_6:3486:14056: scene=9_6
#: 9_6:3486
msgctxt "text_id=14056 | speaker=unknown"
msgid "  The Scarred Red mage quietly stood up."
msgstr "　橙色の魔術師は静かに立ち上がる。"

#. Occurrence 9_6:3510:14057: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0059; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3510
msgctxt "text_id=14057 | speaker=touko"
msgid "\"Well, Aoko will be here any moment. I'd best be on my way."
msgstr "「青子が帰ってくる頃だから、私は行くよ。"

#. Occurrence 9_6:3517:14058: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0060; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3517
msgctxt "text_id=14058 | speaker=touko"
msgid "She has no chance of defeating me. Tell her that for me, won't you?\""
msgstr "青子では私には勝てない、とだけ伝えておいてくれればいい」"

#. Occurrence 9_6:3523:14059: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0023; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:3523
msgctxt "text_id=14059 | speaker=soujuurou"
msgid "\"Sure, but...\""
msgstr "「それはいいんですけど」"

#. Occurrence 9_6:3555:14060: scene=9_6
#: 9_6:3555
msgctxt "text_id=14060 | speaker=unknown"
msgid "  Before she left the room, Touko paused to let Soujyuro continue."
msgstr "　ソファーに座ったまま、草十郎は立ち去ろうとする橙子を呼び止めた。"

#. Occurrence 9_6:3560:14061: scene=9_6
#: 9_6:3560
msgctxt "text_id=14061 | speaker=unknown"
msgid "  Like a student humbly inquiring of a teacher, Soujyuro pointed to the object in Touko's hand and asked,"
msgstr "　そうして、師匠に質問する弟子のように控え目に、橙子が持っている物を指差す。"

#. Occurrence 9_6:3586:14062: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_6_0024; voice_prefix=A30; voice_category=3; scene=9_6
#: 9_6:3586
msgctxt "text_id=14062 | speaker=soujuurou"
msgid "\"...Um. What are you going to do with that cup?\""
msgstr "「……あの。そのカップ、どうするんです？」"

#. Occurrence 9_6:3592:14063: scene=9_6
#: 9_6:3592
msgctxt "text_id=14063 | speaker=unknown"
msgid "  Surprised, she looked down at the teacup in her right hand that she had forgotten she was holding."
msgstr "　頼りのない弟子の指摘に、ああ、と橙子は右手に持ったティーカップに視線を落とした。"

#. Occurrence 9_6:3597:14064: scene=9_6
#: 9_6:3597
msgctxt "text_id=14064 | speaker=unknown"
msgid "  She hadn't even realized that she had been holding the cup the entire time."
msgstr "　橙子本人、自分がカップを持っていた事実を意識していなかったとしか思えない。"

#. Occurrence 9_6:3630:14065: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0061; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3630
msgctxt "text_id=14065 | speaker=touko"
msgid "\"Oh, this? I might as well take it with me.\""
msgstr "「これ？　うん、せっかくだから貰っていく」"

#. Occurrence 9_6:3636:14066: scene=9_6
#: 9_6:3636
msgctxt "text_id=14066 | speaker=unknown"
msgid "  The act of taking something without the owner's permission is commonly referred to as \"theft.\""
msgstr "　……持ち主の許しもなく持っていくのは『貰う』ではなく『奪う』という。"

#. Occurrence 9_6:3641:14067: scene=9_6
#: 9_6:3641
msgctxt "text_id=14067 | speaker=unknown"
msgid "  However, this was more likely the typical relationship between Aoko and Touko. Share and share alike, and so forth."
msgstr "　けれど、青子と橙子の間ではそれぐらいの交流は普通なのかも知れない。あの妹にしてこの姉あり、みたいな。"

#. Occurrence 9_6:3674:14068: scene=9_6
#: 9_6:3674
msgctxt "text_id=14068 | speaker=unknown"
msgid "  Soujyuro nodded to show that he understood."
msgstr "　なるほど、と草十郎は頷く。"

#. Occurrence 9_6:3679:14069: scene=9_6
#: 9_6:3679
msgctxt "text_id=14069 | speaker=unknown"
msgid "  Unsure if his nod was sincere or not, Touko smiled that gleeful grin for the second time since taking her glasses off."
msgstr "　そんな、真面目なんだか不真面目なんだか分からない草十郎の仕草に、橙子は眼鏡を外してから二度目の、楽しげな笑みをこぼすのだった。"

#. Occurrence 9_6:3715:14070: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_9_6_0062; voice_prefix=A20; voice_category=11; scene=9_6
#: 9_6:3715
msgctxt "text_id=14070 | speaker=touko"
msgid "\"You certainly are an odd one, the question of your worth aside.\""
msgstr "「やはり変わり種だね、君は。逸材かどうかは別の話だが」"

#. Occurrence 9_6:3736:14071: scene=9_6
#: 9_6:3736
msgctxt "text_id=14071 | speaker=unknown"
msgid "  For just a moment, she had returned to the affable Touko Aozaki he met before the glasses came off."
msgstr "　一瞬だけ、彼女は眼鏡をはずす前の、穏和な蒼崎橙子に戻っていた。"

#. Occurrence 9_6:3741:14072: scene=9_6
#: 9_6:3741
msgctxt "text_id=14072 | speaker=unknown"
msgid "  Leaving him with the image of her smile, she departed the mansion."
msgstr "　その微笑みを最後にして、橙子は洋館から去っていった。"

#. Occurrence 9_6:3760:14073: scene=9_6
#: 9_6:3760
msgctxt "text_id=14073 | speaker=unknown"
msgid "  Her broken glasses remained on the drawing-room table."
msgstr "　居間のテーブルに、壊れた眼鏡を残したままで。"

#. Occurrence 9_7:89:14074: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0000; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:89
msgctxt "text_id=14074 | speaker=aoko"
msgid "\"We're hooome!\""
msgstr "「ただいまー！」"

#. Occurrence 9_7:96:14075: scene=9_7
#: 9_7:96
msgctxt "text_id=14075 | speaker=unknown"
msgid "  No sooner had the eerie visitor left, did Aoko and Alice return home."
msgstr "　不意の来客と入れ替わるように、青子たちは帰ってきた。"

#. Occurrence 9_7:101:14076: scene=9_7
#: 9_7:101
msgctxt "text_id=14076 | speaker=unknown"
msgid "  Despite Aoko's sour mood, she seemed as merry as ever."
msgstr "　青子の表情は不機嫌ながらも活き活きとしている。"

#. Occurrence 9_7:106:14077: scene=9_7
#: 9_7:106
msgctxt "text_id=14077 | speaker=unknown"
msgid "  Despite everything that had happened and their trip having its fair share of problems, she still had fun."
msgstr "　とりあえず問題は山積みだけど目的が決まってスッキリした、と言いたげなハイテンションさだ。"

#. Occurrence 9_7:126:14078: scene=9_7
#: 9_7:126
msgctxt "text_id=14078 | speaker=unknown"
msgid "  Whereas Alice was her usual stoic self,"
msgstr "　一方、傍らの有珠はいつも通り。"

#. Occurrence 9_7:131:14079: scene=9_7
#: 9_7:131
msgctxt "text_id=14079 | speaker=unknown"
msgid "  her manner not unlike a parent following behind a rampaging toddler, cleaning up their mess."
msgstr "　相棒の暴走っぷりをフォローできるよう裏方に徹している……と見えなくもない。"

#. Occurrence 9_7:136:14080: scene=9_7
#: 9_7:136
msgctxt "text_id=14080 | speaker=unknown"
msgid "  The scene of their return was like something out of a TV sitcom, and lost in thought, Soujyuro forgot to greet them."
msgstr "　ふたりの颯爽とした登場はテレビの映像のように思えて、草十郎はお帰りと言うのも忘れてしまった。"

#. Occurrence 9_7:170:14081: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0001; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:170
msgctxt "text_id=14081 | speaker=aoko"
msgid "\"Did anything happen while we were out, Soujyuro?\""
msgstr "「草十郎、留守中なにかあった？」"

#. Occurrence 9_7:176:14082: scene=9_7
#: 9_7:176
msgctxt "text_id=14082 | speaker=unknown"
msgid "  Aoko asked, more so out of etiquette than curiosity, while removing her coat."
msgstr "　青子は上着を脱ぎながら、社交辞令じみた質問をした。"

#. Occurrence 9_7:181:14083: scene=9_7
#: 9_7:181
msgctxt "text_id=14083 | speaker=unknown"
msgid "  Without answering, he stood up from the sofa."
msgstr "　それには答えず、草十郎はソファーから立ち上がる。"

#. Occurrence 9_7:205:14084: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0000; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:205
msgctxt "text_id=14084 | speaker=soujuurou"
msgid "\"Yeah, it took up half of my day, actually."
msgstr "「そりゃあ半日分の出来事はあったけど。"

#. Occurrence 9_7:211:14085: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0001; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:211
msgctxt "text_id=14085 | speaker=soujuurou"
msgid "  Other than that, it was just cold. Want me to make some tea?\""
msgstr "　それより寒かっただろう。お茶を淹れようか？」"

#. Occurrence 9_7:222:14086: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0002; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:222
msgctxt "text_id=14086 | speaker=aoko"
msgid "\"Yes, please."
msgstr "「あ、お願い。"

#. Occurrence 9_7:222:14087: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0002; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:222
msgctxt "text_id=14087 | speaker=aoko"
msgid "  You can't plan anything without a hot cup of tea in your hands.\""
msgstr "　こっちも一から作戦練り上げようってトコだから」"

#. Occurrence 9_7:264:14088: scene=9_7
#: 9_7:264
msgctxt "text_id=14088 | speaker=unknown"
msgid "  Soujyuro was on his way to the kitchen to prepare tea even before Aoko had finished her upbeat response."
msgstr "　上機嫌な青子の台詞を聞き流して、草十郎は台所に向かい、二人分の紅茶を淹れはじめる。"

#. Occurrence 9_7:271:14089: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0002; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:271
msgctxt "text_id=14089 | speaker=soujuurou"
msgid "\"...Wait a minute. Something feels off.\""
msgstr "「……なんだろう。どこか、変だ」"

#. Occurrence 9_7:276:14090: scene=9_7
#: 9_7:276
msgctxt "text_id=14090 | speaker=unknown"
msgid "  He was following his same tea-brewing routine as always, but somehow something did not feel the same."
msgstr "　いつもの手順で紅茶を淹れているのに、作っている実感が湧かない。"

#. Occurrence 9_7:282:14091: scene=9_7
#: 9_7:282
msgctxt "text_id=14091 | speaker=unknown"
msgid "  As though in a trance, Soujyuro returned to the drawing room where they were settling down, and placed the tea on the table."
msgstr "　<夢現|ゆめうつつ>な気分で、草十郎は青子たちがくつろいでいる居間に戻り、テーブルにティーカップを置く。"

#. Occurrence 9_7:316:14092: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_7_0000; voice_prefix=A40; voice_category=2; scene=9_7
#: 9_7:316
msgctxt "text_id=14092 | speaker=alice"
msgid "\"What do you intend to do now, Aoko?\""
msgstr "「これからどうするつもりなの、青子」"

#. Occurrence 9_7:322:14093: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0003; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:322
msgctxt "text_id=14093 | speaker=aoko"
msgid "\"We'll have to search for her on foot. We can't play this one defensively. If we spend time fortifying defenses here, she'll just have more time to create more puppets.\""
msgstr "「とりあえず足で探すしかないわね。あいつ相手に守りに入るのは良くない。こっちが城壁を作ってる間に、一個師団の人形をこさえかねないわ」"

#. Occurrence 9_7:342:14094: scene=9_7
#: 9_7:342
msgctxt "text_id=14094 | speaker=unknown"
msgid "  They conversed with each other while ignoring Soujyuro's presence."
msgstr "　ふたりは草十郎を無視して話をしている。"

#. Occurrence 9_7:347:14095: scene=9_7
#: 9_7:347
msgctxt "text_id=14095 | speaker=unknown"
msgid "  Upon hearing what they said, he stood up and spoke abruptly."
msgstr "　それをつっ立ったまま聞きながら、ぽつりと草十郎は話しかけた。"

#. Occurrence 9_7:380:14096: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0003; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:380
msgctxt "text_id=14096 | speaker=soujuurou"
msgid "\"Are you going to look for Miss Touko?\""
msgstr "「探すって、橙子さんを？」"

#. Occurrence 9_7:398:14097: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0004; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:398
msgctxt "text_id=14097 | speaker=aoko"
msgid "\"Yeah, who else would we―"
msgstr "「それ以外誰を探すって―――"

#. Occurrence 9_7:410:14098: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0005; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:410
msgctxt "text_id=14098 | speaker=aoko"
msgid "  Wait. What did you just say?\""
msgstr "　ちょっと。アンタ、今なんて言ったの？」"

#. Occurrence 9_7:416:14099: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0004; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:416
msgctxt "text_id=14099 | speaker=soujuurou"
msgid "\"Touko. She's your enemy, right? You just missed her.\""
msgstr "「橙子さんなんだろ、蒼崎たちの敵は。さっきまでここにいたよ」"

#. Occurrence 9_7:436:14100: scene=9_7
#: 9_7:436
msgctxt "text_id=14100 | speaker=unknown"
msgid "  He answered so casually, Aoko standing there dumbfounded."
msgstr "　呆然とする青子に、平然と答える草十郎。"

#. Occurrence 9_7:452:14101: scene=9_7
#: 9_7:452
msgctxt "text_id=14101 | speaker=unknown"
msgid "  Alice stood up from the sofa and went to where the two of them were standing."
msgstr "　そんな間の抜けたふたりを余所に、有珠はソファーから立ち上がった。"

#. Occurrence 9_7:457:14102: scene=9_7
#: 9_7:457
msgctxt "text_id=14102 | speaker=unknown"
msgid "  Her typically kind and somber features turned reproachable."
msgstr "　可憐な顔立ちを、厳しい叱責の<貌|かたち>に変えて。"

#. Occurrence 9_7:491:14103: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_7_0001; voice_prefix=A40; voice_category=2; scene=9_7
#: 9_7:491
msgctxt "text_id=14103 | speaker=alice"
msgid "\"Sizuki. Tell me exactly what she did when she was here.\""
msgstr "「静希君。その人、何かしていった？」"

#. Occurrence 9_7:512:14104: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0005_0; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:512
msgctxt "text_id=14104 | speaker=soujuurou"
msgid "\"We drank some tea, then she took off her glasses..."
msgstr "「お茶を飲んで、眼鏡を外して帰っていっただけだけど。"

#. Occurrence 9_7:524:14105: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0005_1; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:524
msgctxt "text_id=14105 | speaker=soujuurou"
msgid " Huh... I can't remember anything after that.\""
msgstr "あれ……よく、思い出せないな……」"

#. Occurrence 9_7:530:14106: scene=9_7
#: 9_7:530
msgctxt "text_id=14106 | speaker=unknown"
msgid "  What was once a clear memory seemed to have been scrubbed clean from his mind."
msgstr "　さっきまで確かだった記憶が、消しゴムにかけられるように消えていく。"

#. Occurrence 9_7:535:14107: scene=9_7
#: 9_7:535
msgctxt "text_id=14107 | speaker=unknown"
msgid "  Soujyuro was overcome by the same dizziness he had felt earlier."
msgstr "　草十郎は、つい先ほど感じた、眠気のような目眩に襲われて、"

#. Occurrence 9_7:580:14108: scene=9_7
#: 9_7:580
msgctxt "text_id=14108 | speaker=unknown"
msgid "  A sharp dry smack echoed through the room."
msgstr "　ぱん、と乾いた音が居間に響く。"

#. Occurrence 9_7:585:14109: scene=9_7
#: 9_7:585
msgctxt "text_id=14109 | speaker=unknown"
msgid "  What snapped him out of his haze was an unexpected slap from Alice."
msgstr "　草十郎の目眩を止めたのは、彼が思ってもいなかった有珠の平手打ちだった。"

#. Occurrence 9_7:613:14110: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_7_0002; voice_prefix=A40; voice_category=2; scene=9_7
#: 9_7:613
msgctxt "text_id=14110 | speaker=alice"
msgid "\"I won't warn you again."
msgstr "「―――二度は言わないわ。"

#. Occurrence 9_7:613:14111: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_7_0002; voice_prefix=A40; voice_category=2; scene=9_7
#: 9_7:613
msgctxt "text_id=14111 | speaker=alice"
msgid "  *Never* let anyone else into my house.\""
msgstr "　他人を、わたしの家に立ち入らせないで」"

#. Occurrence 9_7:642:14112: scene=9_7
#: 9_7:642
msgctxt "text_id=14112 | speaker=unknown"
msgid "  Deep within her eyes, beyond the normal cool indifference, was an intense fury."
msgstr "　有珠の目には、<潜|ひそ>めた、けれど激情が灯っている。"

#. Occurrence 9_7:647:14113: scene=9_7
#: 9_7:647
msgctxt "text_id=14113 | speaker=unknown"
msgid "  Realizing, however, that it was no ordinary anger, Soujyuro understood how careless he had been."
msgstr "　それが怒りだけのものではないと気付いて、草十郎はようやく、自分の軽率さを悔いた。"

#. Occurrence 9_7:668:14114: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0006; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:668
msgctxt "text_id=14114 | speaker=soujuurou"
msgid "\"...I'm sorry. This place is very important to you. I should have known better.\""
msgstr "「……すまない。有珠にとってここが大事な場所なのは、分かってたのに」"

#. Occurrence 9_7:689:14115: scene=9_7
#: 9_7:689
msgctxt "text_id=14115 | speaker=unknown"
msgid "  A heavy silence followed."
msgstr "　重い沈黙。"

#. Occurrence 9_7:707:14116: scene=9_7
#: 9_7:707
msgctxt "text_id=14116 | speaker=unknown"
msgid "  Both Soujyuro and Alice stood there, chained to the spot by their own regret."
msgstr "　有珠も草十郎も、自分への後悔に縛られて動けない。"

#. Occurrence 9_7:738:14117: scene=9_7
#: 9_7:738
msgctxt "text_id=14117 | speaker=unknown"
msgid "  Aoko looked on in amazement, wondering if they would stay this way all night if left alone."
msgstr "　放っておけば一晩中そうやっていそうなふたりを、青子は呆れて眺めている。"

#. Occurrence 9_7:766:14118: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0006; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:766
msgctxt "text_id=14118 | speaker=aoko"
msgid "\"So, hey. I know Soujyuro screwed up by letting my sister in, but Alice, you never told him he shouldn't."
msgstr "「あのね。姉貴を通した草十郎も悪いけど、言ってなかった有珠も悪いでしょ。"

#. Occurrence 9_7:772:14119: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0007; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:772
msgctxt "text_id=14119 | speaker=aoko"
msgid "  We're not children anymore, so how about we put this behind us, and focus on the problem at hand, okay?\""
msgstr "　子供じゃないんだからいつまでも反省してないで、もっと前向きに話をしない？」"

#. Occurrence 9_7:799:14120: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_7_0003; voice_prefix=A40; voice_category=2; scene=9_7
#: 9_7:799
msgctxt "text_id=14120 | speaker=alice"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 9_7:824:14121: scene=9_7
#: 9_7:824
msgctxt "text_id=14121 | speaker=unknown"
msgid "  Alice hung her head and sat back down at Aoko's insistence."
msgstr "　青子に促され、有珠はうつむきがちにソファーに座った。"

#. Occurrence 9_7:829:14122: scene=9_7
#: 9_7:829
msgctxt "text_id=14122 | speaker=unknown"
msgid "  Soujyuro stood where he was, nursing his stinging right cheek."
msgstr "　草十郎は立ったままで、有珠に叩かれた右頬に手を当てた。"

#. Occurrence 9_7:834:14123: scene=9_7
#: 9_7:834
msgctxt "text_id=14123 | speaker=unknown"
msgid "  Pain was pain, but he knew how to take a knock."
msgstr "　痛む事は痛むけど、体の痛みには慣れている。"

#. Occurrence 9_7:850:14124: scene=9_7
#: 9_7:850
msgctxt "text_id=14124 | speaker=unknown"
msgid "  More to the point, the crisp strike from Alice snapped him out of his fog, jogging his memory."
msgstr "　それよりいま重要なのは、有珠の平手で記憶が鮮明になったという事だ。"

#. Occurrence 9_7:871:14125: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0007; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:871
msgctxt "text_id=14125 | speaker=soujuurou"
msgid "\"I remember... She told me to tell you that you have no chance of defeating her, Aoko.\""
msgstr "「思い出した。青子じゃ私には勝てないって、伝えておいてほしいって」"

#. Occurrence 9_7:887:14126: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0008; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:887
msgctxt "text_id=14126 | speaker=aoko"
msgid "\"Hmmm... Pretty full of herself. Anything else?\""
msgstr "「ふーん、大した自信ね。他には？」"

#. Occurrence 9_7:928:14127: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0008; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:928
msgctxt "text_id=14127 | speaker=soujuurou"
msgid "\"She also said... Well, most of it was small talk... To be honest, she said a lot of other stuff I didn't really understand.\""
msgstr "「他は……基本的に世間話だったというか……ああ、そあとかもあとか、よく分からないコトを口にしてたな」"

#. Occurrence 9_7:950:14128: scene=9_7
#: 9_7:950
msgctxt "text_id=14128 | speaker=unknown"
msgid "  Considering the small talk was mostly about Aoko and her flaws, Soujyuro decided it would be better to take that part to his grave."
msgstr "　それはともかく、世間話の大半が青子の失敗談だった事は墓まで持っていこう、と誓う草十郎だった。"

#. Occurrence 9_7:971:14129: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0009; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:971
msgctxt "text_id=14129 | speaker=aoko"
msgid "\"She mentioned the greater and lesser self? I wonder if she's been to India."
msgstr "「大我と小我？　あの人、インドにでも行ってたのかしら。"

#. Occurrence 9_7:977:14130: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0010; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:977
msgctxt "text_id=14130 | speaker=aoko"
msgid "  In case you didn't catch on, Soujyuro, she must have done something to you.\""
msgstr "　ところで草十郎。アンタ、姉貴に何かされたわね」"

#. Occurrence 9_7:995:14131: scene=9_7
#: 9_7:995
msgctxt "text_id=14131 | speaker=unknown"
msgid "  Aoko turned to him, glaring sharply."
msgstr "　じろり、と鋭い視線を青子は向ける。"

#. Occurrence 9_7:1000:14132: scene=9_7
#: 9_7:1000
msgctxt "text_id=14132 | speaker=unknown"
msgid "  He had nothing to be ashamed of, but he looked away guiltily anyway."
msgstr "　後ろめたい事は何もないのに、草十郎はそれについ顔を背けてしまった。"

#. Occurrence 9_7:1021:14133: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0009; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:1021
msgctxt "text_id=14133 | speaker=soujuurou"
msgid "\"She did? What did she do...exactly?\""
msgstr "「何かって、何さ」"

#. Occurrence 9_7:1033:14134: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0011_0; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1033
msgctxt "text_id=14134 | speaker=aoko"
msgid "\"You said you couldn't remember what she said, right? And up until a second ago you looked like a zombie."
msgstr "「思い出せない、とか言ってたでしょ。さっきまでの態度もふわふわしてたし。"

#. Occurrence 9_7:1045:14135: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0011_1; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1045
msgctxt "text_id=14135 | speaker=aoko"
msgid "I see. You remember right up to when she took her glasses off, which means you must have been entranced by her Mystic Eyes.\""
msgstr "……そうか、眼鏡を外したまでは覚えてたって事は、魔眼にでも魅入られたか」"

#. Occurrence 9_7:1065:14136: scene=9_7
#: 9_7:1065
msgctxt "text_id=14136 | speaker=unknown"
msgid "  As quickly as she had jumped to that conclusion, Aoko went quiet again, as if the information was of little importance."
msgstr "　そうやって勝手に結論に辿り着くと、青子はもう興味なし、とばかりに黙りこむ。"

#. Occurrence 9_7:1070:14137: scene=9_7
#: 9_7:1070
msgctxt "text_id=14137 | speaker=unknown"
msgid "  But it was not enough to detract Soujyuro from bringing it up again."
msgstr "　しっくりいかないのは草十郎である。"

#. Occurrence 9_7:1111:14138: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0010; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:1111
msgctxt "text_id=14138 | speaker=soujuurou"
msgid "\"Aozaki, what are 'Mystic Eyes'?\""
msgstr "「蒼崎、まがんって何だ？」"

#. Occurrence 9_7:1139:14139: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0012; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1139
msgctxt "text_id=14139 | speaker=aoko"
msgid "\"Eyes infused with magical energy. Simple forms of Mystic Eyes can cause temporary confusion, while more advanced ones can kill with just a glance. Stuff like that."
msgstr "「……魔力を帯びた目の事よ。簡単な物は一時的な混乱を、上級な物は睨んだだけで相手を殺す、とかね。"

#. Occurrence 9_7:1145:14140: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0013; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1145
msgctxt "text_id=14140 | speaker=aoko"
msgid "  Eh, eyes like Balor's are really just the stuff of legends. If there were eyes like that, we could really use them right about now.\""
msgstr "　……ま、バロールみたいな魔眼の持ち主なんて伝説だけだろうし、そもそもそんな魔眼持ちが生まれてくるなら私たちの悩みもあっさり終わるってものだけど」"

#. Occurrence 9_7:1182:14141: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0011; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:1182
msgctxt "text_id=14141 | speaker=soujuurou"
msgid "\"...?\""
msgstr "「……？」"

#. Occurrence 9_7:1188:14142: scene=9_7
#: 9_7:1188
msgctxt "text_id=14142 | speaker=unknown"
msgid "  Without further context, Aoko knew her explanation was completely lost on Soujyuro."
msgstr "　青子の説明は事情を知らない<草十郎|いちげんさん>にはさっぱりである。"

#. Occurrence 9_7:1221:14143: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0014; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1221
msgctxt "text_id=14143 | speaker=aoko"
msgid "\"So... yeah."
msgstr "「……んー、そうね。"

#. Occurrence 9_7:1228:14144: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0015; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1228
msgctxt "text_id=14144 | speaker=aoko"
msgid "To put it simply, it's like my magic bullet, only you use your eyes to shoot it.\""
msgstr "分かりやすく言うと、私の魔弾みたいなのを目から照射するようなもんよ」"

#. Occurrence 9_7:1248:14145: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0012; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:1248
msgctxt "text_id=14145 | speaker=soujuurou"
msgid "\"You can shoot... bullets from your eyes?\""
msgstr "「目から……蒼崎……が？」"

#. Occurrence 9_7:1254:14146: scene=9_7
#: 9_7:1254
msgctxt "text_id=14146 | speaker=unknown"
msgid "  Soujyuro's confusion deepened along with Aoko's frustration."
msgstr "　退屈そうな青子とは反対に、草十郎の混乱はより深くなっていく。"

#. Occurrence 9_7:1296:14147: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0016; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1296
msgctxt "text_id=14147 | speaker=aoko"
msgid "\"Anyway! You looked into Touko's eyes after she blinked once, right? That's the moment she put the whammy on you with her Mystic Eyes!"
msgstr "「だから！　貴方、一度目を閉じた後の橙子の目を見たんでしょ？　その一瞬で姉貴の魔眼に捕まったってコト！"

#. Occurrence 9_7:1302:14148: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0017; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1302
msgctxt "text_id=14148 | speaker=aoko"
msgid "  Some mages even replace their eyes with cat's-eye stones, but my sister doesn't need to bother with that."
msgstr "　目を猫目石に入れ替える魔術師もいるけど、姉貴はそんな事する必要はないから。"

#. Occurrence 9_7:1308:14149: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0018; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1308
msgctxt "text_id=14149 | speaker=aoko"
msgid "  She was born with hers. She doesn't even need to say anything to use them; she can just blink, like a camera shutter.\""
msgstr "　あの人、生まれながらの魔眼持ちだしね。さしたる準備も詠唱もなしで、<閉塞|シャッター>するだけで切り替え自由なの」"

#. Occurrence 9_7:1348:14150: scene=9_7
#: 9_7:1348
msgctxt "text_id=14150 | speaker=unknown"
msgid "  Soujyuro pounded his fist in understanding."
msgstr "　ぽん、と手を叩く草十郎。"

#. Occurrence 9_7:1353:14151: scene=9_7
#: 9_7:1353
msgctxt "text_id=14151 | speaker=unknown"
msgid "  Now he thought about it, he vaguely remembered her doing something exactly like that."
msgstr "　たしかに、橙子はそんな仕草をしていた気がする。"

#. Occurrence 9_7:1358:14152: scene=9_7
#: 9_7:1358
msgctxt "text_id=14152 | speaker=unknown"
msgid "  Everything after was foggy and muddled, and her Mystic Eyes seemed the only logical cause."
msgstr "　あの直後から心が惑わされたのは、魔眼とやらの力が大きいらしい。"

#. Occurrence 9_7:1385:14153: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0013; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:1385
msgctxt "text_id=14153 | speaker=soujuurou"
msgid "\"...That's one mystery solved."
msgstr "「……その話は分かったけど。"

#. Occurrence 9_7:1412:14154: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0014; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:1412
msgctxt "text_id=14154 | speaker=soujuurou"
msgid "  But Aozaki, isn't she your sister? Why would sisters try to kill each other?\""
msgstr "　橙子さんは蒼崎のお姉さんなんだろう？　なんで<姉妹|しまい>で殺し合いをしてるんだ」"

#. Occurrence 9_7:1424:14155: scene=9_7
#: 9_7:1424
msgctxt "text_id=14155 | speaker=unknown"
msgid "  He knew it was not something he should ask, but he did it anyway."
msgstr "　聞くべきではない事と分かっていても、あえて草十郎は問いただした。"

#. Occurrence 9_7:1444:14156: scene=9_7
#: 9_7:1444
msgctxt "text_id=14156 | speaker=unknown"
msgid "  The question was against the rules."
msgstr "　条約違反である質問。"

#. Occurrence 9_7:1471:14157: scene=9_7
#: 9_7:1471
msgctxt "text_id=14157 | speaker=unknown"
msgid "  He had no business being involved in this dispute."
msgstr "　彼には関係のない、関わらせてはいけない争い。"

#. Occurrence 9_7:1487:14158: scene=9_7
#: 9_7:1487
msgctxt "text_id=14158 | speaker=unknown"
msgid "  Aoko closed her eyes to collect her thoughts."
msgstr "　青子はしばし瞳を閉じて状況を整理し―――"

#. Occurrence 9_7:1492:14159: scene=9_7
#: 9_7:1492
msgctxt "text_id=14159 | speaker=unknown"
msgid "  She decided it was best for all involved to at least share some background information, if only to head off further questions."
msgstr "　ここでつっぱねるより、概要だけ話して黙らせる方がお互いの為と判断した。"

#. Occurrence 9_7:1513:14160: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0019; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1513
msgctxt "text_id=14160 | speaker=aoko"
msgid "\"Fine, here's what you need to know now that you've met her. Besides, keeping you in the dark would be more dangerous."
msgstr "「いいわ、話してあげる。姉貴に関わった以上、事情を説明しておかないと危ないし。"

#. Occurrence 9_7:1519:14161: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0020; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1519
msgctxt "text_id=14161 | speaker=aoko"
msgid "  But no more questions. This is my story to tell, got it?\""
msgstr "　けど、なんであれ聞き返すのはナシね。この件に関しては、私は私の事情を話すだけだから」"

#. Occurrence 9_7:1551:14162: scene=9_7
#: 9_7:1551
msgctxt "text_id=14162 | speaker=unknown"
msgid "  She stared down Soujyuro until he nodded slowly in recognition."
msgstr "　物わかり良さげに頷く草十郎に、どうだか、と青子は疑いの視線を向けた。"

#. Occurrence 9_7:1556:14163: scene=9_7
#: 9_7:1556
msgctxt "text_id=14163 | speaker=unknown"
msgid "  Knowing him, she knew this was confirmation enough."
msgstr "　草十郎の性格は、それなりに把握できている。"

#. Occurrence 9_7:1566:14164: scene=9_7
#: 9_7:1566
msgctxt "text_id=14164 | speaker=unknown"
msgid "  The conversation was becoming oddly friendly again, but Aoko sat up a little straighter as she prepared to tell the tale."
msgstr "　またヘンに親身になったりするのは目に見えているが、話すと言ったからには話そう、と青子は姿勢を切り替えた。"

#. Occurrence 9_7:1593:14165: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0021; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1593
msgctxt "text_id=14165 | speaker=aoko"
msgid "\"Before we talk about my sister, I have to explain the Aozaki family, and more importantly, magecraft versus Magic."
msgstr "「……姉貴の話をするってコトは、私と蒼崎の家の話と、なにより魔術と魔法の話をしないといけない。"

#. Occurrence 9_7:1599:14166: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0022; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1599
msgctxt "text_id=14166 | speaker=aoko"
msgid "  We're going to cover a lot of ground and it'll include stuff you can't tell anyone, but we can always wipe your memories later, so it's fine.\""
msgstr "　少し遠回りになるし他言無用な内容だけど、いずれアンタの記憶は消えるから問題ないってコトで」"

#. Occurrence 9_7:1621:14167: scene=9_7
#: 9_7:1621
msgctxt "text_id=14167 | speaker=unknown"
msgid "  Aoko made sure to add that disclaimer as a condition for telling him the information in the first place."
msgstr "　誰に対しての断りか、そういう前提付きだから話してあげるのよ、と青子は念を押す。"

#. Occurrence 9_7:1657:14168: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0023; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1657
msgctxt "text_id=14168 | speaker=aoko"
msgid "\"You see, Soujyuro, magecraft follows a set of common rules."
msgstr "「魔術っていうのはね、草十郎。いわば共通のルールなのよ。"

#. Occurrence 9_7:1664:14169: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0024; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1664
msgctxt "text_id=14169 | speaker=aoko"
msgid "There are different schools of magecraft, such as runes or Kabbalah. Think of them as different textbooks or manuals that the whole world uses."
msgstr "ルーンやカバラといった魔術系統はそれぞれの科目……世界共通の<教科書|マニュアル>だと思えばいい。"

#. Occurrence 9_7:1670:14170: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0025; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1670
msgctxt "text_id=14170 | speaker=aoko"
msgid "  Anyone that has a proper textbook, and a suitable bloodline, can become a mage."
msgstr "　教科書さえきちんと持っているのなら、あとは血脈次第で誰でも魔術師にはなれるわ。"

#. Occurrence 9_7:1676:14171: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0026; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1676
msgctxt "text_id=14171 | speaker=aoko"
msgid "  But using Magic is something else entirely."
msgstr "　けど魔法を使うのは別。"

#. Occurrence 9_7:1682:14172: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0027; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1682
msgctxt "text_id=14172 | speaker=aoko"
msgid "  Magic, *True Magic*, isn't just some manuscript derived from the Swirl of the Root like magecraft is, but something that comes directly from the Root itself.\""
msgstr "　魔法は魔術みたいに『根源の渦』から派生した写本じゃなくて、根源の渦に直接つながる物だから」"

#. Occurrence 9_7:1714:14173: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0028_0; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1714
msgctxt "text_id=14173 | speaker=aoko"
msgid "\"As for the Swirl of the Root, well..."
msgstr "「この根源の渦っていうのは……"

#. Occurrence 9_7:1727:14174: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0028_1; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1727
msgctxt "text_id=14174 | speaker=aoko"
msgid " The simplest way I can describe it so you'll understand is to compare it to the sun."
msgstr "あー、草十郎の分かるレベルに落としこむと……ま、太陽みたいなものと考えて。"

#. Occurrence 9_7:1739:14175: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0029; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1739
msgctxt "text_id=14175 | speaker=aoko"
msgid "  The Sun is really far away, and has been there from the beginning as far as we're concerned. Without it, you and I wouldn't be able to live.\""
msgstr "　遠くにあって、なにより初めにあるもので、それなくしては私たちは生活できない、といった」"

#. Occurrence 9_7:1797:14176: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0030; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1797
msgctxt "text_id=14176 | speaker=aoko"
msgid "\"Magecraft merely lets us take advantage of the Sun's benefits, so to speak."
msgstr "「魔術っていうのは、この太陽からの恩恵を利用しただけのものよ。"

#. Occurrence 9_7:1803:14177: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0031; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1803
msgctxt "text_id=14177 | speaker=aoko"
msgid "  Magecraft is all about imitating or paying for natural phenomena. We can use it to study, practice, and recreate Mystics―mysteries―but we can never truly create them."
msgstr "　自然現象の模倣、ないし代償が魔術の本質だから。神秘を学び、実践し、再現するけど、神秘そのものを作る事はできない。"

#. Occurrence 9_7:1814:14178: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0032; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1814
msgctxt "text_id=14178 | speaker=aoko"
msgid "  Actually, no matter how much you learn, you eventually hit a wall. It's like a limiter that human knowledge can never overcome.\""
msgstr "　いえ、研究の末にたどり着くんでしょうけど、そこには大きな壁がある。人知では超えられない、リミッターみたいな壁がね」"

#. Occurrence 9_7:1841:14179: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0033; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1841
msgctxt "text_id=14179 | speaker=aoko"
msgid "\"And beyond that wall is where Magic, the Sun itself, exists."
msgstr "「で、魔法っていうのは太陽そのものを扱うコト。"

#. Occurrence 9_7:1859:14180: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0034; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1859
msgctxt "text_id=14180 | speaker=aoko"
msgid "  To attain it means to go where no one can go,"
msgstr "　誰にも到達できない場所に行って、"

#. Occurrence 9_7:1865:14181: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0035; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1865
msgctxt "text_id=14181 | speaker=aoko"
msgid "  and awaken miracles no one could possibly reproduce."
msgstr "　何者にも<再現|マネ>できない奇跡を起こす。"

#. Occurrence 9_7:1871:14182: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0036; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1871
msgctxt "text_id=14182 | speaker=aoko"
msgid "  A technique to make things happen that humanity could never hope to accomplish with any amount of time or resources... that's *True* Magic.\""
msgstr "　お金をかけようが時間をかけようが、今の人類には到達できない技術―――それが魔法」"

#. Occurrence 9_7:1894:14183: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0037; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1894
msgctxt "text_id=14183 | speaker=aoko"
msgid "\"It's about overcoming that dimensional wall―like, running until you reach the end where you'll find a world with completely different rules from ours. That's the only way you can, well, learn it.\""
msgstr "「次元の壁を越えるっていうか。最後まで走ってみたら、まったく違うルールで出来た世界があって、そのルールを学んじゃった……ってとこかしら」"

#. Occurrence 9_7:1915:14184: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0038; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1915
msgctxt "text_id=14184 | speaker=aoko"
msgid "\"I told you before that magecraft has no limits, right? Well, I meant that it has no limits within the scope of human knowledge."
msgstr "「前に、魔術に限界はないって言ったでしょ。あれは人知の及ぶ範囲なら限界はない、って意味ね。"

#. Occurrence 9_7:1921:14185: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0039; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:1921
msgctxt "text_id=14185 | speaker=aoko"
msgid "  Meanwhile, Magic has lots of limits; actually, it can only do one thing, and one thing alone. Makes sense, right? I mean, we're talking about unique, rule-breaking concepts and mechanisms that exist outside the boundaries of the very universe.\""
msgstr "　対して、魔法は限界だらけ―――っていうか、ひとつの事しかできないけど、それも当然なの。だってこの宇宙の<概念|しくみ>から仲間はずれの、ひとつっきりの光点なんだから」"

#. Occurrence 9_7:1967:14186: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0015; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:1967
msgctxt "text_id=14186 | speaker=soujuurou"
msgid "\"So... Magic is more amazing than magecraft. I think I get the general idea, but..."
msgstr "「……魔術より魔法の方が凄い……というのは、流れ的に分かるんだけど。"

#. Occurrence 9_7:1974:14187: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0016; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:1974
msgctxt "text_id=14187 | speaker=soujuurou"
msgid "It's really limited?\""
msgstr "限界だらけ、なんだよな？」"

#. Occurrence 9_7:2001:14188: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0040; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2001
msgctxt "text_id=14188 | speaker=aoko"
msgid "\"Kinda. It's more like an exception, a special privilege, or an abuse of power."
msgstr "「限界っていうか特例、特権、越権の類ね。"

#. Occurrence 9_7:2007:14189: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0041; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2007
msgctxt "text_id=14189 | speaker=aoko"
msgid "  It's not versatile, but in making the impossible possible, it's all-powerful as far as magecraft is concerned.\""
msgstr "　汎用性はないけど、誰にも出来ない事を可能とする時点で、魔術世界にとっては万能とされる」"

#. Occurrence 9_7:2034:14190: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0042; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2034
msgctxt "text_id=14190 | speaker=aoko"
msgid "\"Magic is like a reward a mage gets when reaching the Swirl of the Root, and that even goes for mages who don't possess the mettle to wield it. Just making a path to the Root gives them free reign to use it, in magecraft terms."
msgstr "「そもそも魔法は『根源の渦』にたどり着いた魔術師へのご褒美みたいなもので、たとえその術者に魔法を使うだけの肉体性能がなくても、根源への<路|パス>ができただけで魔術的にはやりたい放題ってわけ。"

#. Occurrence 9_7:2046:14191: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0043; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2046
msgctxt "text_id=14191 | speaker=aoko"
msgid "  In short, it's like becoming the richest person in the world.\""
msgstr "　要は、地球で一番のお金持ちになるってコト」"

#. Occurrence 9_7:2086:14192: scene=9_7
#: 9_7:2086
msgctxt "text_id=14192 | speaker=unknown"
msgid "  Soujyuro made an appreciative sound, impressed."
msgstr "　力強い発言に、おお、と感動する草十郎。"

#. Occurrence 9_7:2111:14193: scene=9_7
#: 9_7:2111
msgctxt "text_id=14193 | speaker=unknown"
msgid "  On the other hand, Alice looked as though she wished to make many revisions to Aoko's account."
msgstr "　一方、青子の暴論を色々改めたくて仕方のない有珠。"

#. Occurrence 9_7:2144:14194: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0017; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:2144
msgctxt "text_id=14194 | speaker=soujuurou"
msgid "\"The richest person in the world... In which case, does it mean that no matter how rich you are, only the richest person gets to have Magic?\""
msgstr "「一番の大金持ちか……じゃあ、どんなにお金持ちでも、一番目でない以上は魔法は貰えないんだな？」"

#. Occurrence 9_7:2184:14195: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0044; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2184
msgctxt "text_id=14195 | speaker=aoko"
msgid "\"...I guess so, sure."
msgstr "「―――まあ、そういう事。"

#. Occurrence 9_7:2196:14196: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0045; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2196
msgctxt "text_id=14196 | speaker=aoko"
msgid "  ...Sometimes you sure get to the right conclusion from the weirdest of places. It's like you said―there are many routes and theories to reach the Root, but unless you're first to the post, Magic will elude you."
msgstr "　……時々とんでもない角度で核心をつくわね、コイツ……アンタの言う通り、同じ<理論|ルート>、同じ方法で根源に辿り着いても、一番目じゃないと魔法にはたどり着けない。"

#. Occurrence 9_7:2202:14197: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0046; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2202
msgctxt "text_id=14197 | speaker=aoko"
msgid "  No matter how good you are, if you're not the first, you're everyone else.\""
msgstr "　どんなに優れていても二番目以降には意味がないのよ」"

#. Occurrence 9_7:2233:14198: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0047; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2233
msgctxt "text_id=14198 | speaker=aoko"
msgid "\"There are only five... no, four Magicians."
msgstr "「魔法使いが五人……いえ、四人か。"

#. Occurrence 9_7:2239:14199: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0048; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2239
msgctxt "text_id=14199 | speaker=aoko"
msgid "  And there are only four because once that path to the Root has been taken by one Magician, it's closed off to all others."
msgstr "　現存する魔法使いが四人しかいないのは、一度使われた<未|ル><知|ート>は<確定|とざ>されてしまうから。"

#. Occurrence 9_7:2245:14200: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0049; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2245
msgctxt "text_id=14200 | speaker=aoko"
msgid "  But it wasn't always like that, in ancient times."
msgstr "　大昔はそうでもなかったって話だけどね。"

#. Occurrence 9_7:2251:14201: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0050; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2251
msgctxt "text_id=14201 | speaker=aoko"
msgid "  Ironically, mankind is responsible for closing off the paths to the Root; we've built walls that stand between us and the 'truth.'\""
msgstr "　根源への路……真理への到達に壁を作ったのは、皮肉なことに人間自身だった」"

#. Occurrence 9_7:2276:14202: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0051; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2276
msgctxt "text_id=14202 | speaker=aoko"
msgid "\"The mages of old could never have imagined that the more we explored the unknown, the more paths we would seal off."
msgstr "「未知を解明すればするほどルートが閉じていくなんて、昔の魔術師たちは思いもしなかったんでしょう。"

#. Occurrence 9_7:2282:14203: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0052; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2282
msgctxt "text_id=14203 | speaker=aoko"
msgid "  But the result was exactly that, and by the time they realized it, it was too late. After all that studying, True Magic had all but disappeared from the world.\""
msgstr "　でも結果はこの通り、気が付いた時には後の祭りっていうか。多くの研鑽の末、この世から魔法は消えていっちゃったワケ」"

#. Occurrence 9_7:2327:14204: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0018; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:2327
msgctxt "text_id=14204 | speaker=soujuurou"
msgid "\"...Huh. So it's kind of like how the city has dwarfed the countryside, then?\""
msgstr "「……ふーん。それは、山と町の関係に似てる……と思っていいのかな」"

#. Occurrence 9_7:2360:14205: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0053; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2360
msgctxt "text_id=14205 | speaker=aoko"
msgid "\"In a microscopic sense, that example works."
msgstr "「ミクロな視点で言うなら、似たようなものよ。"

#. Occurrence 9_7:2372:14206: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0054; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2372
msgctxt "text_id=14206 | speaker=aoko"
msgid "  So... up until recently, modern mages have been vying for that final seat in a game of magical musical chairs, but some country bumpkin snagged it a while ago, so their little race is over."
msgstr "　で―――つい最近まで、現代の魔術師たちは残された最後の席を求めていたけど、それもちょっと前にどこぞの田舎者が横取りしちゃって、イス取りゲームはあえなく終了。"

#. Occurrence 9_7:2378:14207: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0055; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2378
msgctxt "text_id=14207 | speaker=aoko"
msgid "  After that, all further research into the Root was limited to mundane and meaningless magecraft.\""
msgstr "　あとは魔法抜きで根源にたどり着くため、地味で無意味な魔術の研究を続ける事になった」"

#. Occurrence 9_7:2405:14208: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0056; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2405
msgctxt "text_id=14208 | speaker=aoko"
msgid "\"Though, only a small fraction of mages were chasing Magic anyway, while the rest had already thrown in the towel."
msgstr "「……ま、もともと魔法なんてのを優先してたのは一部の魔術師だけで、他のまっとうな連中はとっくに見切りをつけてたんだけどね。"

#. Occurrence 9_7:2417:14209: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0057; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2417
msgctxt "text_id=14209 | speaker=aoko"
msgid "  Magic gained from reaching the Swirl of the Root isn't necessarily a mage's only goal."
msgstr "　だって、魔術師にとって最終目的は根源の渦への到達であって魔法じゃないし。"

#. Occurrence 9_7:2423:14210: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0058; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2423
msgctxt "text_id=14210 | speaker=aoko"
msgid "  But that's a whole other convoluted mess in itself. The chicken or the egg dilemma, if you will.\""
msgstr "　そのあたりいつのまにかごっちゃになっちゃったんでしょ。卵が先か鶏が先かって話」"

#. Occurrence 9_7:2466:14211: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0019; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:2466
msgctxt "text_id=14211 | speaker=soujuurou"
msgid "\"...Okay. Well, I at least understand that I understand absolutely nothing. Do you mind if we get to the point?"
msgstr "「……よし。まったく分からないってコトは分かったんで、そろそろ本題に入ってくれ。"

#. Occurrence 9_7:2478:14212: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0020; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:2478
msgctxt "text_id=14212 | speaker=soujuurou"
msgid "  Oh, right. How can there be multiple wielders of True Magic if only the first one there can learn it?\""
msgstr "　あ。けど、一番目の人間しか魔法使いになれないのに、魔法使いは何人もいるのか？」"

#. Occurrence 9_7:2524:14213: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0059; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2524
msgctxt "text_id=14213 | speaker=aoko"
msgid "\"Well, there were five at one time. There were five final tasks left to humanity, so the first―\""
msgstr "「五人いたわ。最終的に、人間に残される最後の課題は五つだろうって一番初めの―――」"

#. Occurrence 9_7:2552:14214: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_7_0004; voice_prefix=A40; voice_category=2; scene=9_7
#: 9_7:2552
msgctxt "text_id=14214 | speaker=alice"
msgid "\"Aoko.\""
msgstr "「青子」"

#. Occurrence 9_7:2598:14215: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0060; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2598
msgctxt "text_id=14215 | speaker=aoko"
msgid "\"...Right, to the point."
msgstr "「―――じゃ、本題ね。"

#. Occurrence 9_7:2604:14216: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0061; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2604
msgctxt "text_id=14216 | speaker=aoko"
msgid "  Now that I've explained the relationship between magecraft and Magic, I can finally talk about my family.\""
msgstr "　魔法と魔術の関係が分かったところで、ようやくうちの話になるんだけど」"

#. Occurrence 9_7:2631:14217: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0062; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2631
msgctxt "text_id=14217 | speaker=aoko"
msgid "\"Remember when I mentioned that the Aozaki family has been mages for generations?"
msgstr "「蒼崎の家が代々魔術師だったのは前に言ったでしょ？"

#. Occurrence 9_7:2637:14218: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0063; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2637
msgctxt "text_id=14218 | speaker=aoko"
msgid "  Our history isn't ancient, but we've been blessed with good luck and talent,"
msgstr "　歴史的には浅いけど、運と才能には恵まれていたのね。"

#. Occurrence 9_7:2643:14219: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0064; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2643
msgctxt "text_id=14219 | speaker=aoko"
msgid "  because somehow or another, an Aozaki finally attained True Magic.\""
msgstr "　蒼崎は、なんだかんだって魔法にまで辿り着いたんだから」"

#. Occurrence 9_7:2678:14220: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0021; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:2678
msgctxt "text_id=14220 | speaker=soujuurou"
msgid "\"Hold on just a second. Aozaki, so you mean―\""
msgstr "「―――ちょっと待った。じゃあ、蒼崎が、その、」"

#. Occurrence 9_7:2705:14221: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0065; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2705
msgctxt "text_id=14221 | speaker=aoko"
msgid "\"I'm an apprentice mage, nothing more."
msgstr "「私はあくまで魔術師見習い。"

#. Occurrence 9_7:2711:14222: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0066; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2711
msgctxt "text_id=14222 | speaker=aoko"
msgid "  I can't wield Magic, nor do I want to. I'm just the successor to the Aozaki family.\""
msgstr "　使えないし、使う気もないわよ、魔法なんて。私はただ、蒼崎の家を継いだだけだもの」"

#. Occurrence 9_7:2741:14223: scene=9_7
#: 9_7:2741
msgctxt "text_id=14223 | speaker=unknown"
msgid "  Aoko asserted obtusely, her voice devoid of emotion."
msgstr "　青子は簡潔に、感情のない声で言い切った。"

#. Occurrence 9_7:2746:14224: scene=9_7
#: 9_7:2746
msgctxt "text_id=14224 | speaker=unknown"
msgid "  She became a mage not to wield Magic,"
msgstr "　魔法使いになるために魔術師になったのではなく、"

#. Occurrence 9_7:2751:14225: scene=9_7
#: 9_7:2751
msgctxt "text_id=14225 | speaker=unknown"
msgid "  but simply because the succession of her family's magecraft was forced on her."
msgstr "　蒼崎の家を継ぐコトになったから、魔術師として生きていく道を選んだのだと。"

#. Occurrence 9_7:2786:14226: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0067; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2786
msgctxt "text_id=14226 | speaker=aoko"
msgid "\"Anyway..."
msgstr "「……ま、とにかく。"

#. Occurrence 9_7:2825:14227: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0068; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2825
msgctxt "text_id=14227 | speaker=aoko"
msgid "  in order to reach the Swirl of the Root, generations upon generations of mages have to dedicate their lives to research. Since every special snowflake is trying a unique approach and doesn't want to share, it obviously takes forever."
msgstr "　根源の渦に辿り着くには、何代も何代も魔術を研究しなくちゃいけない。自分独自の川を造るようなものなんだから、もちろんその過程は果てがない。"

#. Occurrence 9_7:2837:14228: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0069; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2837
msgctxt "text_id=14228 | speaker=aoko"
msgid "  At any rate, you can't create Magic unless you have the innate ability to, or through some sort of divine intervention.\""
msgstr "　よほどの天賦か天啓でもないかぎり魔法を創るなんてできないしね」"

#. Occurrence 9_7:2873:14229: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0070; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2873
msgctxt "text_id=14229 | speaker=aoko"
msgid "\"Just making it to the Root isn't enough. If you lack a worthy heir to pass it on to, the miracle stops there. So much for your lineage."
msgstr "「そしてもし根源に辿り着いても、相応しい後継者がいなければ一代かぎりの奇跡で終わってしまう。"

#. Occurrence 9_7:2879:14230: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0071; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2879
msgctxt "text_id=14230 | speaker=aoko"
msgid "  That's why mages cultivate their bloodlines, to pass magical energy from one generation to the next, and to create an heir more powerful than oneself.\""
msgstr "　だから魔術師は血脈を重ねて、代々の魔力を次代に積み重ねていく。自分より勝れた後継者を生むために」"

#. Occurrence 9_7:2899:14231: scene=9_7
#: 9_7:2899
msgctxt "text_id=14231 | speaker=unknown"
msgid "  Aoko wrapped up the explanation by remarking that it was like producing a thoroughbred."
msgstr "　要するにサラブレッドを作っているのよ、と青子は一度話を切った。"

#. Occurrence 9_7:2904:14232: scene=9_7
#: 9_7:2904
msgctxt "text_id=14232 | speaker=unknown"
msgid "  Not that Soujyuro knew what a thoroughbred was to begin with, leaving him as perplexed at the end of the story as he was at the beginning."
msgstr "　もともと草十郎に理解させる気はこれっぽっちもないので、サラブレッド？　と首をひねる草十郎を華麗にスルーする。"

#. Occurrence 9_7:2933:14233: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0072; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2933
msgctxt "text_id=14233 | speaker=aoko"
msgid "\"So mages pass along their uniquely created Mystics to later generations, protecting their legacy in the process."
msgstr "「そうやって代を重ねて、魔術師は作り上げた独自の神秘、守り続けた魔術を次の世代に伝えていくの。"

#. Occurrence 9_7:2939:14234: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0073; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2939
msgctxt "text_id=14234 | speaker=aoko"
msgid "  And at the very end, they say that there should be an answer sufficient enough to satisfy all our questions.\""
msgstr "　きっと最後の最後に、全ての疑問を打ち消すに足る答えがある筈だって」"

#. Occurrence 9_7:2967:14235: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0074; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2967
msgctxt "text_id=14235 | speaker=aoko"
msgid "\"But, you see, mages―no, Magicians too―all understand one very important thing:"
msgstr "「でも魔術師―――いえ、魔法使いだって、みんな悟ってるのよ。"

#. Occurrence 9_7:2973:14236: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0075; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2973
msgctxt "text_id=14236 | speaker=aoko"
msgid "  their own generation, and every single one thereafter, will all die before they ever reach their ultimate goal."
msgstr "　自分の代でも、その次の代でも、きっと最後の最後の最後まで、誰もゴールには辿り着けないって結末を。"

#. Occurrence 9_7:2999:14237: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0076; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:2999
msgctxt "text_id=14237 | speaker=aoko"
msgid "  My grandfather always used to say that it was the destiny of those who obsess over Mystics to end up learning only magecraft."
msgstr "　それを解っていながら魔術を研究していくのが神秘学に取り憑かれた者の宿命だって、祖父はよく口にしてた。"

#. Occurrence 9_7:3005:14238: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0077; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3005
msgctxt "text_id=14238 | speaker=aoko"
msgid "  Funny how my sister didn't turn out like that...\""
msgstr "　けど、私の姉はそうじゃなかったみたい」"

#. Occurrence 9_7:3045:14239: scene=9_7
#: 9_7:3045
msgctxt "text_id=14239 | speaker=unknown"
msgid "  She left \"I can see why\" hanging in the air."
msgstr "　その気持ちも分かるけどね、と青子はひとり呟く。"

#. Occurrence 9_7:3064:14240: scene=9_7
#: 9_7:3064
msgctxt "text_id=14240 | speaker=unknown"
msgid "  Alice had no response."
msgstr "　有珠はそれには無反応だ。"

#. Occurrence 9_7:3079:14241: scene=9_7
#: 9_7:3079
msgctxt "text_id=14241 | speaker=unknown"
msgid "  The Aozaki family, passing down True Magic..."
msgstr "　魔法を伝える蒼崎の家。"

#. Occurrence 9_7:3088:14242: scene=9_7
#: 9_7:3088
msgctxt "text_id=14242 | speaker=unknown"
msgid "  Aoko, the reluctant successor."
msgstr "　その後継者となった青子。"

#. Occurrence 9_7:3102:14243: scene=9_7
#: 9_7:3102
msgctxt "text_id=14243 | speaker=unknown"
msgid "  And Touko Aozaki, her elder sister."
msgstr "　そして―――青子の姉である蒼崎橙子。"

#. Occurrence 9_7:3123:14244: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0078; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3123
msgctxt "text_id=14244 | speaker=aoko"
msgid "\"Actually, my sister was the Aozaki heir."
msgstr "「……ほんとは、蒼崎の後継者は姉貴だった。"

#. Occurrence 9_7:3129:14245: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0079; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3129
msgctxt "text_id=14245 | speaker=aoko"
msgid "  They told me about the family legacy, but I never had to learn any of it."
msgstr "　私もうちの家業がなんであるかは教えられてきたけど、実践する事はなかったのよ。"

#. Occurrence 9_7:3135:14246: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0080; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3135
msgctxt "text_id=14246 | speaker=aoko"
msgid "  For mage lineages, unless they're super rich, they usually only raise one heir. I guess that wasn't the case for an average income household like ours...\""
msgstr "　魔術師の家系はよっぽど裕福でもないかぎり、基本的に一子相伝だからね。うち、ホント財力的には一般家庭レベルだし」"

#. Occurrence 9_7:3183:14247: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0081; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3183
msgctxt "text_id=14247 | speaker=aoko"
msgid "\"Successors are supposed to be chosen based on their affinity for magecraft... and in that sense, my sister was definitely a prodigy."
msgstr "「で、後継者にはより魔術に適した者が選ばれるワケだけど……姉貴はたしかに天才だった。"

#. Occurrence 9_7:3189:14248: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0082; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3189
msgctxt "text_id=14248 | speaker=aoko"
msgid "  But, her talent just wasn't fit for an heir, for whatever reason.\""
msgstr "　けどそれは、蒼崎の後継者にはいらない才能だった」"

#. Occurrence 9_7:3216:14249: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0083; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3216
msgctxt "text_id=14249 | speaker=aoko"
msgid "\"Instead, I turned out to be more suited to succeed it."
msgstr "「そのかわり、私は心底蒼崎の後継者として相応しかったみたい。"

#. Occurrence 9_7:3222:14250: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0084; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3222
msgctxt "text_id=14250 | speaker=aoko"
msgid "  And... while I don't really agree with him, my grandfather seemed dead set on switching it over to me during the winter when I was fifteen."
msgstr "　……まあ、それはそれでどうも思わないけど、祖父がはっきりと私に鞍替えしたのが十五歳の冬の頃でさ。"

#. Occurrence 9_7:3228:14251: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0085; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3228
msgctxt "text_id=14251 | speaker=aoko"
msgid "  To my sister, I suddenly stole her entire birthright, while not only being four years younger, but also lacking any magical knowledge.\""
msgstr "　姉貴はいきなり、四つ年下で、今まで魔術に関わってなかった妹に魔法の相続権利を奪われたってワケよ」"

#. Occurrence 9_7:3263:14252: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0022; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:3263
msgctxt "text_id=14252 | speaker=soujuurou"
msgid "\"I see. So that's why.\""
msgstr "「…………そうか、それで」"

#. Occurrence 9_7:3281:14253: scene=9_7
#: 9_7:3281
msgctxt "text_id=14253 | speaker=unknown"
msgid "  Touko had said that she was \"obligated\" to take what was Aoko's."
msgstr "　……私にはその<義|・><務|・>がある、と。"

#. Occurrence 9_7:3300:14254: scene=9_7
#: 9_7:3300
msgctxt "text_id=14254 | speaker=unknown"
msgid "  He recalled how resentful her voice had been when she said it."
msgstr "　蒼崎橙子は、憎しみに満ちた声で言い切ったのだ。"

#. Occurrence 9_7:3341:14255: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0086; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3341
msgctxt "text_id=14255 | speaker=aoko"
msgid "\"I'm not her, so I don't know how she feels about the whole thing."
msgstr "「<姉貴|あのひと>がどんな思いをしたか、私は本人じゃないから知らないけど。"

#. Occurrence 9_7:3347:14256: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0087; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3347
msgctxt "text_id=14256 | speaker=aoko"
msgid "  It's been three and a half years since she fought with grandfather, smashed her glasses, and left our home."
msgstr "　祖父と言い争って、今まで愛用してた眼鏡を叩き壊して家を出ていったのが三年と半年前。"

#. Occurrence 9_7:3353:14257: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0088; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3353
msgctxt "text_id=14257 | speaker=aoko"
msgid "  No one has heard from her since then, and I became her replacement. I guess this is why we're squabbling.\""
msgstr "　それからまったく消息なしで、私は姉の代わりになったの。これが、私と姉貴の争う原因でしょうね」"

#. Occurrence 9_7:3391:14258: scene=9_7
#: 9_7:3391
msgctxt "text_id=14258 | speaker=unknown"
msgid "  Soujyuro thought the story was tragic, but Aoko's voice had a tone of relief in it."
msgstr "　かなり重い話だと草十郎は思うのだけど、青子の声はさっぱりしている。"

#. Occurrence 9_7:3396:14259: scene=9_7
#: 9_7:3396
msgctxt "text_id=14259 | speaker=unknown"
msgid "  Soujyuro did not know exactly who he should feel bad for anymore."
msgstr "　それが幼い頃から植え付けられた魔術師の思考だとしたら、同情すべきはどちらにあるのだろうか。"

#. Occurrence 9_7:3433:14260: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0023; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:3433
msgctxt "text_id=14260 | speaker=soujuurou"
msgid "\"She...broke her glasses?\""
msgstr "「……眼鏡を壊した、か」"

#. Occurrence 9_7:3452:14261: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0089; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3452
msgctxt "text_id=14261 | speaker=aoko"
msgid "\"Correct. Her eyesight has always been perfect. The bitch was even born with Mystic Eyes."
msgstr "「そう。あの人、昔はすっごく目が良かった。生まれながら魔眼を持ってたって化物だからね。"

#. Occurrence 9_7:3458:14262: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0090; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3458
msgctxt "text_id=14262 | speaker=aoko"
msgid "  But in trying to live up to our grandfather's expectations, she probably overdid it and her eyes suffered as a result.\""
msgstr "　けど祖父の期待に応えようとして、無理して頑張ったあげく視力が下がっちゃったみたい」"

#. Occurrence 9_7:3496:14263: scene=9_7
#: 9_7:3496
msgctxt "text_id=14263 | speaker=unknown"
msgid "  Aoko wrestled with the memory, not sure if she had everything down exactly right."
msgstr "　なんだかねー、と呆れる青子。"

#. Occurrence 9_7:3517:14264: scene=9_7
#: 9_7:3517
msgctxt "text_id=14264 | speaker=unknown"
msgid "  Soujyuro knew how well Aoko could hide her emotions, and this was not one of those moments."
msgstr "　青子の冷徹さを知っている草十郎だが、さすがに今のは見ていて気持ちのいいものではない。"

#. Occurrence 9_7:3549:14265: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0091; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3549
msgctxt "text_id=14265 | speaker=aoko"
msgid "\"You know, now that I think of it, was Touko trying to give him a message?"
msgstr "「けど、あれに何の意味があったんだろう。"

#. Occurrence 9_7:3555:14266: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0092; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3555
msgctxt "text_id=14266 | speaker=aoko"
msgid "  Why did she throw her glasses at my grandfather, when she could have smoked him with a single Finn Shot?"
msgstr "　眼鏡を<祖父|じじい>に叩きつけるぐらいなら、フィンの一撃でも叩きこめば良かったのに。"

#. Occurrence 9_7:3561:14267: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0093; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3561
msgctxt "text_id=14267 | speaker=aoko"
msgid "  She was in her prime back then, so she could have wiped a senile old man out in an instant if she had wanted to.\""
msgstr "　あの人、あの頃が才能のピークだったんだし、<耄碌|もうろく>した<祖|じ><父|じい>なんてそれこそ一撃だったと思うんだけど……」"

#. Occurrence 9_7:3602:14268: scene=9_7
#: 9_7:3602
msgctxt "text_id=14268 | speaker=unknown"
msgid "  Soujyuro shook his head, disappointed at Aoko's misjudgment of the situation."
msgstr "　はて、と今更ながら考えこむ青子に、草十郎はうつむいて批難する。"

#. Occurrence 9_7:3630:14269: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0024; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:3630
msgctxt "text_id=14269 | speaker=soujuurou"
msgid "\"This isn't about any grudge."
msgstr "「恨み辛みの話じゃない。"

#. Occurrence 9_7:3642:14270: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0025; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:3642
msgctxt "text_id=14270 | speaker=soujuurou"
msgid "  Those glasses... They were important to her. It was a symbol of all of her efforts that everyone could see."
msgstr "　……その眼鏡は、大事な物だったんだ。だってそれは、誰にだって分かる努力の証なんだから。"

#. Occurrence 9_7:3648:14271: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0026; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:3648
msgctxt "text_id=14271 | speaker=soujuurou"
msgid "  To break them like that... it must have been painful. Painful enough for her to feel like she had to break them.\""
msgstr "　それを叩きつけたんだ。痛かったんだろうな、橙子さんは。思い出を、自分で壊さなくちゃいけないぐらいに」"

#. Occurrence 9_7:3688:14272: scene=9_7
#: 9_7:3688
msgctxt "text_id=14272 | speaker=unknown"
msgid "  As Soujyuro spoke, neither Aoko nor Alice noticed the grief he was fighting to hold in."
msgstr "　そう語る草十郎自身、痛みをかみ殺している事に青子も有珠も気付かない。"

#. Occurrence 9_7:3693:14273: scene=9_7
#: 9_7:3693
msgctxt "text_id=14273 | speaker=unknown"
msgid "  Or more accurately, they could not understand his point of view."
msgstr "　というより、二人には草十郎の心情が理解できない。"

#. Occurrence 9_7:3698:14274: scene=9_7
#: 9_7:3698
msgctxt "text_id=14274 | speaker=unknown"
msgid "  After all, in a world where mages are raised to fight other mages, empathy was in short supply."
msgstr "　魔術師として育てられ、戦うべき敵として認識しあう彼女たちには、そういった感傷は必要ないからだ。"

#. Occurrence 9_7:3735:14275: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_9_7_0005; voice_prefix=A40; voice_category=2; scene=9_7
#: 9_7:3735
msgctxt "text_id=14275 | speaker=alice"
msgid "\"I wonder why she chose to come back now. Like Aoko said, Touko could have taken Misaki City any time she wanted to.\""
msgstr "「……けど、どうして今ごろになって戻ってきたのかしら。青子の言う通り、橙子さんならもっと早く三咲市を奪えたのに」"

#. Occurrence 9_7:3755:14276: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0094; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3755
msgctxt "text_id=14276 | speaker=aoko"
msgid "\"That's right. If she wanted this land so badly, she should have come back three years ago, killed me, and reclaimed her rights."
msgstr "「そうね。そんなに土地が欲しかったのなら、三年前に私を殺せば後継者に戻れたのに。"

#. Occurrence 9_7:3767:14277: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0095; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3767
msgctxt "text_id=14277 | speaker=aoko"
msgid "  ...Maybe she had a change of heart after seeing the world, I dunno.\""
msgstr "　……世間の荒波にもまれて気が変わったとか……？」"

#. Occurrence 9_7:3788:14278: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0027; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:3788
msgctxt "text_id=14278 | speaker=soujuurou"
msgid "\"You really don't get it, do you, Aozaki?\""
msgstr "「違う。蒼崎は本当に分からないのか」"

#. Occurrence 9_7:3808:14279: scene=9_7
#: 9_7:3808
msgctxt "text_id=14279 | speaker=unknown"
msgid "  Soujyuro shook with a faint anger."
msgstr "　微かな<憤|いきどお>りが草十郎を揺り動かす。"

#. Occurrence 9_7:3813:14280: scene=9_7
#: 9_7:3813
msgctxt "text_id=14280 | speaker=unknown"
msgid "  His voice changed from the boy they thought they knew."
msgstr "　その声は、二人の知っている少年とは少しだけ違っていた。"

#. Occurrence 9_7:3855:14281: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0096; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:3855
msgctxt "text_id=14281 | speaker=aoko"
msgid "\"Oh, and you do?\""
msgstr "「な、なによ。アンタなら分かるっていうの？」"

#. Occurrence 9_7:3861:14282: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0028; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:3861
msgctxt "text_id=14282 | speaker=soujuurou"
msgid "\"Yes, like anyone would."
msgstr "「誰だって分かる。"

#. Occurrence 9_7:3887:14283: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0029; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:3887
msgctxt "text_id=14283 | speaker=soujuurou"
msgid "  Touko was waiting for you to become a fully-fledged mage so that you would lose the same thing that was stolen from her. That's how deep her hurt and hatred goes.\""
msgstr "　橙子さんは、蒼崎が一人前になるまで待っていたんだ。自分が失った物と同じぐらい、大切な物を無くさせるために。そうしないとどうにもならない。そこまでしなくちゃいけないほど、あの人の怒りは深かったんだ」"

#. Occurrence 9_7:3966:14284: scene=9_7
#: 9_7:3966
msgctxt "text_id=14284 | speaker=unknown"
msgid "  Soujyuro gazed at them, wondering why they could not see what he could."
msgstr "　なんでそれが分からない、と草十郎は二人を見据える。"

#. Occurrence 9_7:3971:14285: scene=9_7
#: 9_7:3971
msgctxt "text_id=14285 | speaker=unknown"
msgid "  Only, he was the one that did not understand."
msgstr "　だが、分かっていないのは彼の方だ。"

#. Occurrence 9_7:3976:14286: scene=9_7
#: 9_7:3976
msgctxt "text_id=14286 | speaker=unknown"
msgid "  The two girls, and above all Touko Aozaki, deny themselves the type of relationships that other normal people are allowed to experience."
msgstr "　そういった人間らしい関係を、彼女たちは、何より蒼崎橙子は、一番初めに断っているのだから。"

#. Occurrence 9_7:4008:14287: scene=9_7
#: 9_7:4008
msgctxt "text_id=14287 | speaker=unknown"
msgid "  Touko's actions were not fueled by hatred."
msgstr "　橙子を動かしているのは憎しみではない。"

#. Occurrence 9_7:4013:14288: scene=9_7
#: 9_7:4013
msgctxt "text_id=14288 | speaker=unknown"
msgid "  While there certainly was hatred behind them, the real reason was and always has been Touko's pursuit of True Magic."
msgstr "　たしかにそれもあるにはあるが、彼女を突き動かす最大の理由は魔法に至ること一点。"

#. Occurrence 9_7:4018:14289: scene=9_7
#: 9_7:4018
msgctxt "text_id=14289 | speaker=unknown"
msgid "  She was an ambitious and talented mage; her hatred was only her veneer."
msgstr "　彼女は貪欲で優秀な魔術師であり、憎しみなど後付の<外皮|りゆう>でしかない。"

#. Occurrence 9_7:4023:14290: scene=9_7
#: 9_7:4023
msgctxt "text_id=14290 | speaker=unknown"
msgid "  Thinking of her in any other way would be an insult to the elder sister who devoted her life to the study of magecraft."
msgstr "　それを間違えては、なにより、魔術に己を捧げた姉を侮辱する事になる。"

#. Occurrence 9_7:4056:14291: scene=9_7
#: 9_7:4056
msgctxt "text_id=14291 | speaker=unknown"
msgid "  All of this Aoko wanted to tell Soujyuro, but instead stopped herself."
msgstr "　そう口にしようとして、青子は止めた。"

#. Occurrence 9_7:4061:14292: scene=9_7
#: 9_7:4061
msgctxt "text_id=14292 | speaker=unknown"
msgid "  Even if she had, Soujyuro was not a mage and could never understand, and besides, arguing with him any further would not have brought her any joy."
msgstr "　魔術師でもない草十郎に言っても意味がないし、彼にその事実を突きつけるのは面白くない。"

#. Occurrence 9_7:4066:14293: scene=9_7
#: 9_7:4066
msgctxt "text_id=14293 | speaker=unknown"
msgid "  She could not have put it into words even if she had tried."
msgstr "　言語化できないが、それはしたくないと思ってしまった。"

#. Occurrence 9_7:4071:14294: scene=9_7
#: 9_7:4071
msgctxt "text_id=14294 | speaker=unknown"
msgid "  And so..."
msgstr "　なので―――"

#. Occurrence 9_7:4105:14295: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0097; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:4105
msgctxt "text_id=14295 | speaker=aoko"
msgid "\"Hmmm... You sure are taking her side a lot, Soujyuro."
msgstr "「ふーん。やけに姉貴の肩を持つじゃない、草十郎。"

#. Occurrence 9_7:4111:14296: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0098; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:4111
msgctxt "text_id=14296 | speaker=aoko"
msgid "  Could it be... love at first sight?\""
msgstr "　もしかして、一目惚れでもした？」"

#. Occurrence 9_7:4136:14297: scene=9_7
#: 9_7:4136
msgctxt "text_id=14297 | speaker=unknown"
msgid "  In her own cowardly way, Aoko dodged the subject."
msgstr "　自分でも卑怯と思う方法で、青子は逃げた。"

#. Occurrence 9_7:4141:14298: scene=9_7
#: 9_7:4141
msgctxt "text_id=14298 | speaker=unknown"
msgid "  She smirked childishly."
msgstr "　にやっと笑う青子。"

#. Occurrence 9_7:4182:14299: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0030; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:4182
msgctxt "text_id=14299 | speaker=soujuurou"
msgid "\"I get how she feels, a little. I pity her.\""
msgstr "「肩ぐらい持つ。あの人は、可哀相な人だからな」"

#. Occurrence 9_7:4236:14300: scene=9_7
#: 9_7:4236
msgctxt "text_id=14300 | speaker=unknown"
msgid "  Soujyuro did not take the bait."
msgstr "　しかし、草十郎はまったく動じていなかった。"

#. Occurrence 9_7:4241:14301: scene=9_7
#: 9_7:4241
msgctxt "text_id=14301 | speaker=unknown"
msgid "  Aoko was frustrated at his reply."
msgstr "　そこまで言われては青子もカチンとくる。"

#. Occurrence 9_7:4253:14302: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0099; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:4253
msgctxt "text_id=14302 | speaker=aoko"
msgid "\"And why, might I ask?\""
msgstr "「なぜ？」"

#. Occurrence 9_7:4258:14303: scene=9_7
#: 9_7:4258
msgctxt "text_id=14303 | speaker=unknown"
msgid "  An icy glare replaced her smile."
msgstr "　作り笑いを消して、真剣な眼差しで青子は問いかけた。"

#. Occurrence 9_7:4278:14304: scene=9_7
#: 9_7:4278
msgctxt "text_id=14304 | speaker=unknown"
msgid "  He did not falter,"
msgstr "　草十郎に<躊躇|ためら>いはない。"

#. Occurrence 9_7:4283:14305: scene=9_7
#: 9_7:4283
msgctxt "text_id=14305 | speaker=unknown"
msgid "  only plainly stating,"
msgstr "　彼は当然のように、"

#. Occurrence 9_7:4310:14306: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0031; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:4310
msgctxt "text_id=14306 | speaker=soujuurou"
msgid "\"Because she has to fight her only sister."
msgstr "「だって実の妹と争わなくちゃいけないんだろ。"

#. Occurrence 9_7:4336:14307: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_7_0032; voice_prefix=A30; voice_category=3; scene=9_7
#: 9_7:4336
msgctxt "text_id=14307 | speaker=soujuurou"
msgid "  That's sad, isn't it?\""
msgstr "　それは可哀相な事じゃないのか？」"

#. Occurrence 9_7:4359:14308: scene=9_7
#: 9_7:4359
msgctxt "text_id=14308 | speaker=unknown"
msgid "  This was the source of his frustration."
msgstr "　何に対して怒っているのかを明言した。"

#. Occurrence 9_7:4387:14309: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0100; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:4387
msgctxt "text_id=14309 | speaker=aoko"
msgid "\"...It's sad, all right.\""
msgstr "「…………たしかに、ね」"

#. Occurrence 9_7:4393:14310: scene=9_7
#: 9_7:4393
msgctxt "text_id=14310 | speaker=unknown"
msgid "  Aoko's eyes narrowed unconsciously,"
msgstr "　知らず、青子は目を細めた。"

#. Occurrence 9_7:4398:14311: scene=9_7
#: 9_7:4398
msgctxt "text_id=14311 | speaker=unknown"
msgid "  as if hiding from a painful truth."
msgstr "　胸を衝かれた事実を隠すように。"

#. Occurrence 9_7:4403:14312: scene=9_7
#: 9_7:4403
msgctxt "text_id=14312 | speaker=unknown"
msgid "  \"This guy is a poison,\" she thought to herself."
msgstr "　コイツは毒だな、と思いながら。"

#. Occurrence 9_7:4408:14313: scene=9_7
#: 9_7:4408
msgctxt "text_id=14313 | speaker=unknown"
msgid "  A poison with no antidote; with his words, he was unwittingly bringing her weakness to light."
msgstr "　薬にもなりはしない。この男の言葉は、知らず知らずのうちに自分の弱い部分を浮き彫りにする、と。"

#. Occurrence 9_7:4441:14314: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0101; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:4441
msgctxt "text_id=14314 | speaker=aoko"
msgid "\"My sister and I... We don't think of it in that way, though."
msgstr "「だけど私も姉貴も、それをなんとも思ってないのよ。"

#. Occurrence 9_7:4447:14315: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_7_0102; voice_prefix=A10; voice_category=1; scene=9_7
#: 9_7:4447
msgctxt "text_id=14315 | speaker=aoko"
msgid "  To us, this was always the way it would turn out.\""
msgstr "　だって、それ以外に解決策はないんだから」"

#. Occurrence 9_7:4453:14316: scene=9_7
#: 9_7:4453
msgctxt "text_id=14316 | speaker=unknown"
msgid "  Soujyuro looked down and frowned in defeat."
msgstr "　青子の答えに、草十郎はそうか、と表情を曇らせる。"

#. Occurrence 9_7:4458:14317: scene=9_7
#: 9_7:4458
msgctxt "text_id=14317 | speaker=unknown"
msgid "\"And that's sad too,\" he muttered."
msgstr "「それも、悲しい話だね」と呟いて。"

#. Occurrence 9_8:81:14318: scene=9_8
#: 9_8:81
msgctxt "text_id=14318 | speaker=unknown"
msgid "  The curtain of night had already fallen."
msgstr "　夜の<帳|とばり>はとっくに落ちている。"

#. Occurrence 9_8:101:14319: scene=9_8
#: 9_8:101
msgctxt "text_id=14319 | speaker=unknown"
msgid "  Not even an hour had passed since Touko left the estate, and Soujyuro was feeling the distance between him and the girls."
msgstr "　橙子が去ってからまだ一時間も経っていないのに、草十郎には彼女の顔がひどく遠いものに感じられた。"

#. Occurrence 9_8:106:14320: scene=9_8
#: 9_8:106
msgctxt "text_id=14320 | speaker=unknown"
msgid "  Aoko and Alice felt much the same way about Touko Aozaki, who seemed more elusive than a phantom."
msgstr "　青子と有珠にしてみれば、現在の蒼崎橙子の姿は幻よりさらに遠いに違いない。"

#. Occurrence 9_8:138:14321: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_8_0000; voice_prefix=A10; voice_category=1; scene=9_8
#: 9_8:138
msgctxt "text_id=14321 | speaker=aoko"
msgid "\"Anyway! Soujyuro, you at least understand that she's our enemy, right? If so, stop arguing with me, and let sleeping bears lie!"
msgstr "「とにかく！　姉貴が敵だって事は草十郎にも分かったでしょう？　ならつべこべ言わず、君子危うきに近寄らずよ！"

#. Occurrence 9_8:144:14322: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_8_0001; voice_prefix=A10; voice_category=1; scene=9_8
#: 9_8:144
msgctxt "text_id=14322 | speaker=aoko"
msgid "  Although, after meeting you, she must have realized that you have nothing to do with us, so I doubt we need to worry about her going after you.\""
msgstr "　……ま、姉貴もアンタと会って、私たちとはまったくの無関係だって分かっただろうから、そっちには手を出してこないでしょうけど」"

#. Occurrence 9_8:177:14323: scene=9_8
#: 9_8:177
msgctxt "text_id=14323 | speaker=unknown"
msgid "  Aoko seemed absolutely certain in her assessment, as if to proclaim that Soujyuro had dodged a bullet."
msgstr "　だから安全、気にするな、と青子は胸を張る。"

#. Occurrence 9_8:182:14324: scene=9_8
#: 9_8:182
msgctxt "text_id=14324 | speaker=unknown"
msgid "  Strangely, she was placing her trust in her enemy's sense of reason."
msgstr "　おかしな話だが、たとえ敵であっても橙子の合理性を青子は信頼しきっていた。"

#. Occurrence 9_8:224:14325: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_8_0000_0; voice_prefix=A30; voice_category=3; scene=9_8
#: 9_8:224
msgctxt "text_id=14325 | speaker=soujuurou"
msgid "\"...Really? ...Are you sure about that?"
msgstr "「……そうかな。……そうなのかな。"

#. Occurrence 9_8:251:14326: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_8_0000_1; voice_prefix=A30; voice_category=3; scene=9_8
#: 9_8:251
msgctxt "text_id=14326 | speaker=soujuurou"
msgid "I hope you're right...\""
msgstr "……そうだといいんだけどな」"

#. Occurrence 9_8:257:14327: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_8_0002; voice_prefix=A10; voice_category=1; scene=9_8
#: 9_8:257
msgctxt "text_id=14327 | speaker=aoko"
msgid "\"Really. So relax; she never paid any attention to things that were of no use to her anyway.\""
msgstr "「そうだから安心なさい。昔から要らない物には手を出さないんだから、あの人は」"

#. Occurrence 9_8:283:14328: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_8_0001; voice_prefix=A30; voice_category=3; scene=9_8
#: 9_8:283
msgctxt "text_id=14328 | speaker=soujuurou"
msgid "\"Okay. If you say so, Aozaki, then that's good enough for me."
msgstr "「そっか。蒼崎がそこまで言うなら安心する。"

#. Occurrence 9_8:294:14329: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_8_0002; voice_prefix=A30; voice_category=3; scene=9_8
#: 9_8:294
msgctxt "text_id=14329 | speaker=soujuurou"
msgid "  Oh, right. Speaking of things she has no use for, Touko took your teacup. The nice Sèvres one.\""
msgstr "　あ、要らない物っていえば、橙子さんが蒼崎のティーカップを貰うって。セーブルのやつ」"

#. Occurrence 9_8:326:14330: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_8_0003; voice_prefix=A10; voice_category=1; scene=9_8
#: 9_8:326
msgctxt "text_id=14330 | speaker=aoko"
msgid "\"She did WHAT!?"
msgstr "「え……ちょ、ちょっと待って！"

#. Occurrence 9_8:332:14331: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_8_0004; voice_prefix=A10; voice_category=1; scene=9_8
#: 9_8:332
msgctxt "text_id=14331 | speaker=aoko"
msgid "  And you just stood by and let her!?\""
msgstr "　アンタ、それを黙って見てたっていうの!?」"

#. Occurrence 9_8:338:14332: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_8_0003; voice_prefix=A30; voice_category=3; scene=9_8
#: 9_8:338
msgctxt "text_id=14332 | speaker=soujuurou"
msgid "\"I did. ...So she really was stealing it after all, huh.\""
msgstr "「そうだけど。……む。やっぱりあれは奪っていったのか」"

#. Occurrence 9_8:379:14333: scene=9_8
#: 9_8:379
msgctxt "text_id=14333 | speaker=unknown"
msgid "  Soujyuro nodded sagely, while Aoko fumed."
msgstr "　怒る青子に、草十郎はなるほど、と納得する。"

#. Occurrence 9_8:384:14334: scene=9_8
#: 9_8:384
msgctxt "text_id=14334 | speaker=unknown"
msgid "  She wondered where his serious manner and tone had gone."
msgstr "　さっきまでの深刻な顔つきと口調はどこへいったのか。"

#. Occurrence 9_8:389:14335: scene=9_8
#: 9_8:389
msgctxt "text_id=14335 | speaker=unknown"
msgid "  Soujyuro's frustrating absentmindedness had returned."
msgstr "　今ここにいやがるのは、いつものぼんやりとした草十郎だった。"

#. Occurrence 9_8:439:14336: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_8_0005; voice_prefix=A10; voice_category=1; scene=9_8
#: 9_8:439
msgctxt "text_id=14336 | speaker=aoko"
msgid "\"It had to be the Sèvres cup too... my favorite one.\""
msgstr "「しかもセーブルのカップって、私の一番のお気に入り……」"

#. Occurrence 9_8:445:14337: scene=9_8
#: 9_8:445
msgctxt "text_id=14337 | speaker=unknown"
msgid "  Aoko's fist trembled violently, but as much as she wanted to, she knew better than to plant it into Soujyuro's carefree face."
msgstr "　ぬぬぬ、と拳を震わす青子だが、草十郎の<暢気顔|のんきがお>を殴りつけるワケにもいかない。"

#. Occurrence 9_8:450:14338: scene=9_8
#: 9_8:450
msgctxt "text_id=14338 | speaker=unknown"
msgid "  Not that he was even capable, but even if Soujyuro did try to stop Touko, it would have gone tragically for him."
msgstr "　もし草十郎が橙子を止めていたら大惨事だったろうし、なにより草十郎に、あの姉を止められた筈もないのである。"

#. Occurrence 9_8:496:14339: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_8_0006; voice_prefix=A10; voice_category=1; scene=9_8
#: 9_8:496
msgctxt "text_id=14339 | speaker=aoko"
msgid "\"...Nothing to do now, I guess. She always did have a habit of stealing my things."
msgstr "「……仕方ないか。そういえばあの人、よく私の持ち物を奪っていったっけ。"

#. Occurrence 9_8:503:14340: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_8_0007; voice_prefix=A10; voice_category=1; scene=9_8
#: 9_8:503
msgctxt "text_id=14340 | speaker=aoko"
msgid "Always wanting what others have... I guess old habits die hard.\""
msgstr "他人の物を欲しがるクセ、まだ治ってないんだ」"

#. Occurrence 9_8:509:14341: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_8_0004; voice_prefix=A30; voice_category=3; scene=9_8
#: 9_8:509
msgctxt "text_id=14341 | speaker=soujuurou"
msgid "\"Isn't everybody like that, as children?\""
msgstr "「？　子供の頃は、みんなそうなんじゃないのか？」"

#. Occurrence 9_8:530:14342: scene=9_8
#: 9_8:530
msgctxt "text_id=14342 | speaker=unknown"
msgid "  He wondered aloud, curiously."
msgstr "　つい聞き返してしまう草十郎。"

#. Occurrence 9_8:569:14343: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_8_0008; voice_prefix=A10; voice_category=1; scene=9_8
#: 9_8:569
msgctxt "text_id=14343 | speaker=aoko"
msgid "\"Maybe. So many of my crayons and dolls, she took as she pleased... And broke them, too.\""
msgstr "「そうかな。私のクレヨンとか人形とかとっても仕方ないと思うけど。どうせ粉々にしちゃうんだし」"

#. Occurrence 9_8:575:14344: scene=9_8
#: 9_8:575
msgctxt "text_id=14344 | speaker=unknown"
msgid "  Soujyuro felt his heart jump into his mouth."
msgstr "　その言葉に草十郎は息を呑んだ。"

#. Occurrence 9_8:580:14345: scene=9_8
#: 9_8:580
msgctxt "text_id=14345 | speaker=unknown"
msgid "  The ominous foreshadowing was not lost on him."
msgstr "　なにかいま、不吉な意味が含まれていた気がする。"

#. Occurrence 9_8:601:14346: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_8_0005; voice_prefix=A30; voice_category=3; scene=9_8
#: 9_8:601
msgctxt "text_id=14346 | speaker=soujuurou"
msgid "\"Why... do you think that was?\""
msgstr "「………それは、どういう？」"

#. Occurrence 9_8:622:14347: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_8_0009; voice_prefix=A10; voice_category=1; scene=9_8
#: 9_8:622
msgctxt "text_id=14347 | speaker=aoko"
msgid "\"Because she made a hobby out of taking my property and smashing it to pieces, obviously! Once she had her eye on something, I had to kiss it goodbye.\""
msgstr "「だから、あの人って私の持ち物を横取りしてはぶっ壊すのが趣味なのよ。苦節十四年、姉貴に目をつけられて無事だった物なんてひとつも無いもの」"

#. Occurrence 9_8:644:14348: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_8_0006; voice_prefix=A30; voice_category=3; scene=9_8
#: 9_8:644
msgctxt "text_id=14348 | speaker=soujuurou"
msgid "\"...\""
msgstr "「…………………………」"

#. Occurrence 9_8:664:14349: scene=9_8
#: 9_8:664
msgctxt "text_id=14349 | speaker=unknown"
msgid "  Listening to Aoko, Soujyuro recalled his conversation with Touko."
msgstr "　青子の独白を聞いて、草十郎は橙子との会話を思い出す。"

#. Occurrence 9_8:669:14350: scene=9_8
#: 9_8:669
msgctxt "text_id=14350 | speaker=unknown"
msgid "  He hoped he was imagining it, but he vaguely recalled her declaring Soujyuro Sizuki as someone's property..."
msgstr "　……気のせいだといいのだけど、彼女はしきりに静希草十郎を、誰かさんの持ち物だと決め付けていたような……。"

#. Occurrence 9_8:695:14351: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_8_0007; voice_prefix=A30; voice_category=3; scene=9_8
#: 9_8:695
msgctxt "text_id=14351 | speaker=soujuurou"
msgid "\"That... is troubling.\""
msgstr "「……それは……ちょっと、難儀だな」"

#. Occurrence 9_8:701:14352: scene=9_8
#: 9_8:701
msgctxt "text_id=14352 | speaker=unknown"
msgid "  Soujyuro's face turned grim, not unlike a detective at the scene of a crime―"
msgstr "　手強い難問に出会った刑事よろしく、顔をしかめて呟く草十郎。"

#. Occurrence 9_8:706:14353: scene=9_8
#: 9_8:706
msgctxt "text_id=14353 | speaker=unknown"
msgid "  a scene which left no traces of evidence or clues as to how the case could be solved."
msgstr "　解決策がまったく見つからないあたりまで、ホントよく似ている。"

#. Occurrence 9_8:738:14354: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_8_0010; voice_prefix=A10; voice_category=1; scene=9_8
#: 9_8:738
msgctxt "text_id=14354 | speaker=aoko"
msgid "\"Right? She was a terrible sister. The worst.\""
msgstr "「でしょ？　ひどい姉貴なのよ、あの人って」"

#. Occurrence 9_8:744:14355: scene=9_8
#: 9_8:744
msgctxt "text_id=14355 | speaker=unknown"
msgid "  Unaware of Soujyuro's turmoil, Aoko calmly sipped her tea."
msgstr "　草十郎の気持ちも知らず、青子は気楽に答えて紅茶を飲んだ。"

#. Occurrence 9_8:749:14356: scene=9_8
#: 9_8:749
msgctxt "text_id=14356 | speaker=unknown"
msgid "  Soujyuro watched as Aoko shrugged her shoulders before looking over to the drawing room clock. No matter how heavy the mood, time kept on ticking."
msgstr "　肩をすくめる青子を半眼で見つめながら、草十郎は居間の時計に目をやった。気分がどんなに<陰欝|いんうつ>でも、時間だけはきっちりと回っている。"

#. Occurrence 9_8:781:14357: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_8_0008; voice_prefix=A30; voice_category=3; scene=9_8
#: 9_8:781
msgctxt "text_id=14357 | speaker=soujuurou"
msgid "\"...Gloomy days ahead, I guess,\""
msgstr "「……明日から、大変になるね」"

#. Occurrence 9_8:787:14358: scene=9_8
#: 9_8:787
msgctxt "text_id=14358 | speaker=unknown"
msgid "  muttered the undeniable victim of today's injustices."
msgstr "　ぽつりと呟く本日最大の被害者。"

#. Occurrence 9_8:792:14359: scene=9_8
#: 9_8:792
msgctxt "text_id=14359 | speaker=unknown"
msgid "  Aoko looked ready to move on from the incident, adding,"
msgstr "　そこに、青子はからっとした趣で付け足した。"

#. Occurrence 9_8:834:14360: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_9_8_0011; voice_prefix=A10; voice_category=1; scene=9_8
#: 9_8:834
msgctxt "text_id=14360 | speaker=aoko"
msgid "\"Probably. But right now, I'm just looking forward to tonight's dinner.\""
msgstr "「そうね。でも今は、そんな事より今日の夕飯のが楽しみなんだ、私」"

#. Occurrence 9_8:874:14361: scene=9_8
#: 9_8:874
msgctxt "text_id=14361 | speaker=unknown"
msgid "  Alice seemed to second that opinion with her silence."
msgstr "　青子の意見に、有珠も賛同するように黙りこんでいる。"

#. Occurrence 9_8:879:14362: scene=9_8
#: 9_8:879
msgctxt "text_id=14362 | speaker=unknown"
msgid "  Comfortable and relaxed, neither of them seemed to have any intention of leaving the sofa to prepare food."
msgstr "　ゆったりくつろぐふたりは、夕飯が用意されるまでソファーから動く意志が、見事なまでに皆無だった。"

#. Occurrence 9_8:914:14363: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_8_0009; voice_prefix=A30; voice_category=3; scene=9_8
#: 9_8:914
msgctxt "text_id=14363 | speaker=soujuurou"
msgid "\"...\""
msgstr "「……………………」"

#. Occurrence 9_8:920:14364: scene=9_8
#: 9_8:920
msgctxt "text_id=14364 | speaker=unknown"
msgid "  Tonight was supposed to be his night off from work..."
msgstr "　たしかに夜のアルバイトはない。"

#. Occurrence 9_8:925:14365: scene=9_8
#: 9_8:925
msgctxt "text_id=14365 | speaker=unknown"
msgid "  ...at least, until midnight."
msgstr "　けれど深夜となると話は別だ。"

#. Occurrence 9_8:930:14366: scene=9_8
#: 9_8:930
msgctxt "text_id=14366 | speaker=unknown"
msgid "  But Soujyuro knew that until the clock struck midnight, he would be serving on hand and foot the two ladies of the house."
msgstr "　これから本当にアルバイトが待っている草十郎にとって、ふたりの期待は苛酷な命令以外の何物でもない。"

#. Occurrence 9_8:950:14367: scene=9_8
#: 9_8:950
msgctxt "text_id=14367 | speaker=unknown"
msgid "  For one, it would take at least another hour to prepare something to eat."
msgstr "　そもそも、今から調理したら食べるのは一時間後になってしまう。"

#. Occurrence 9_8:955:14368: scene=9_8
#: 9_8:955
msgctxt "text_id=14368 | speaker=unknown"
msgid "  And there was no way the exhausted Aoko and Alice would stand for that, so the only other option, in the end, was to have something delivered."
msgstr "　そんなコトを何やら疲れきったふたりが容認するはずもなく、となると結局、残された手段は出前のみ。"

#. Occurrence 9_8:988:14369: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_9_8_0010; voice_prefix=A30; voice_category=3; scene=9_8
#: 9_8:988
msgctxt "text_id=14369 | speaker=soujuurou"
msgid "(Maybe I should have taken Touko up on her offer after all.)"
msgstr "“……なんと。橙子さんに付いていけば良かったかもしれないな、俺”"

#. Occurrence 9_8:995:14370: scene=9_8
#: 9_8:995
msgctxt "text_id=14370 | speaker=unknown"
msgid "  Soujyuro opened his wallet as he second-guessed his situation."
msgstr "　グチをこぼしつつ、草十郎はお財布の中身を確かめた。"

#. Occurrence 9_8:1000:14371: scene=9_8
#: 9_8:1000
msgctxt "text_id=14371 | speaker=unknown"
msgid "  His eyes settled on the third and final ten-thousand yen bill in his wallet. It stared back at him forlornly, reluctant to leave its home."
msgstr "　慎ましげに残っている三枚目の諭吉は、別れを惜しむようにしかめっ面をしている。"

#. Occurrence 9_8:1005:14372: scene=9_8
#: 9_8:1005
msgctxt "text_id=14372 | speaker=unknown"
msgid "  With a heavy heart, he bid it farewell."
msgstr "　それが、草十郎にはちょこっとだけ痛かった。"

#. Occurrence A_0:44:14373: scene=A_0
#: A_0:44
msgctxt "text_id=14373 | speaker=unknown"
msgid "  This everyday tale started like any other."
msgstr "　とりあえずは、そんな日常の話から。"

#. Occurrence A_0:129:14374: scene=A_0
#: A_0:129
msgctxt "text_id=14374 | speaker=unknown"
msgid "  The morning sun alerted Soujyuro that a day of work lay ahead."
msgstr "　星の運びは、今日一日を労働に<捧|ささ>げるべしと告げていた。"

#. Occurrence A_0:134:14375: scene=A_0
#: A_0:134
msgctxt "text_id=14375 | speaker=unknown"
msgid "  Specifically, the gardens needed tending to,"
msgstr "　具体的に言うと庭の清掃。"

#. Occurrence A_0:139:14376: scene=A_0
#: A_0:139
msgctxt "text_id=14376 | speaker=unknown"
msgid "  and an unkempt garden made for an unhappy Soujyuro."
msgstr "　草十郎にとって、これ以上アレを放置しておくのは精神衛生上よろしくない。"

#. Occurrence A_0:144:14377: scene=A_0
#: A_0:144
msgctxt "text_id=14377 | speaker=unknown"
msgid "  Luckily, today was his day off from all his part-time jobs."
msgstr "　幸い、アルバイトの<当番|シフト>は丸一日オフ。"

#. Occurrence A_0:149:14378: scene=A_0
#: A_0:149
msgctxt "text_id=14378 | speaker=unknown"
msgid "  It was the perfect opportunity to get his hands dirty."
msgstr "　彼にとって今日はまたとない好機だった。"

#. Occurrence A_0:194:14379: scene=A_0
#: A_0:194
msgctxt "text_id=14379 | speaker=unknown"
msgid "  There was one problem, however: the mansion's grounds were vast."
msgstr "　―――しかし。洋館の<園|にわ>は本気で広い。"

#. Occurrence A_0:200:14380: scene=A_0
#: A_0:200
msgctxt "text_id=14380 | speaker=unknown"
msgid "  Not only had the courtyard been left to run wild, but the area around the front door had been neglected, too."
msgstr "　荒れ放題なのは中庭だけでなく、館の正面玄関まわりですら手入れが行き届いていなかった。"

#. Occurrence A_0:205:14381: scene=A_0
#: A_0:205
msgctxt "text_id=14381 | speaker=unknown"
msgid "  To tend to these problems thoroughly, he would have to work on them week in, week out."
msgstr "　本気で掃除をするのなら、一週間単位で計画を組まなくてはいけない広さである。"

#. Occurrence A_0:227:14382: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0000; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:227
msgctxt "text_id=14382 | speaker=soujuurou"
msgid "\"All right. First, let's level things out.\""
msgstr "「よし。まずは地ならしだな」"

#. Occurrence A_0:233:14383: scene=A_0
#: A_0:233
msgctxt "text_id=14383 | speaker=unknown"
msgid "  In an ideal world, his task would only take a day, but for its enormity."
msgstr "　理想は一日で成し遂げられるものではない。"

#. Occurrence A_0:238:14384: scene=A_0
#: A_0:238
msgctxt "text_id=14384 | speaker=unknown"
msgid "  For the moment, Soujyuro decided to set foot into the mansion's wilderness and evict the weeds."
msgstr "　今日は雑草の除去だけに専念しよう、と草十郎は決意を新たに荒れ野に踏み出した。"

#. Occurrence A_0:274:14385: scene=A_0
#: A_0:274
msgctxt "text_id=14385 | speaker=unknown"
msgid "  Wasting none of the early light, he started tackling the ones around the mansion."
msgstr "　朝も早くから館の周りの雑草を引き抜いていく。"

#. Occurrence A_0:280:14386: scene=A_0
#: A_0:280
msgctxt "text_id=14386 | speaker=unknown"
msgid "  By his estimation, he could clear the forecourt, courtyard, and backyard, then take a small rest."
msgstr "　計算によれば、午後までには玄関付近、中庭、裏庭をぐるりと一回りし、一休みできる予定になっていた。"

#. Occurrence A_0:496:14387: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_0_0000; voice_prefix=A40; voice_category=2; scene=A_0
#: A_0:496
msgctxt "text_id=14387 | speaker=alice"
msgid "\"What's gotten into him?\""
msgstr "「どうしたの、彼」"

#. Occurrence A_0:536:14388: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0000; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:536
msgctxt "text_id=14388 | speaker=aoko"
msgid "\"Beats me. I doubt he's out there for fun.\""
msgstr "「さあ。草摘みが趣味ってワケじゃなさそうだけど」"

#. Occurrence A_0:542:14389: scene=A_0
#: A_0:542
msgctxt "text_id=14389 | speaker=unknown"
msgid "  It was just before noon in the sunroom."
msgstr "　正午前のサンルーム。"

#. Occurrence A_0:554:14390: scene=A_0
#: A_0:554
msgctxt "text_id=14390 | speaker=unknown"
msgid "  Alice had come down, book in hand, to find Aoko sitting down with a fashion magazine and elegantly sipping tea."
msgstr "　有珠が本を片手にやってきた時、先客である青子は優雅に紅茶を飲みつつ、ファッション誌を読んでいた。"

#. Occurrence A_0:598:14391: scene=A_0
#: A_0:598
msgctxt "text_id=14391 | speaker=unknown"
msgid "  Through the window she could see the crouched figure of Soujyuro shuffling by."
msgstr "　窓ガラスの向こうには、しゃがみこんだまま後退していく人影がひとつ。"

#. Occurrence A_0:627:14392: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0001; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:627
msgctxt "text_id=14392 | speaker=aoko"
msgid "\"He's been at it all morning."
msgstr "「朝からやってるみたいよ。"

#. Occurrence A_0:633:14393: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0002; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:633
msgctxt "text_id=14393 | speaker=aoko"
msgid "  Hunched over since I saw him first thing from my bedroom window. I told him to clean the incinerator, too. Any objections?\""
msgstr "　起きてカーテンを開けたら、もうあの格好でスパスパやってたから。ついでに焼却炉の掃除も言いつけといたけど、いいでしょ？」"

#. Occurrence A_0:647:14394: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_0_0001; voice_prefix=A40; voice_category=2; scene=A_0
#: A_0:647
msgctxt "text_id=14394 | speaker=alice"
msgid "\"Not really. He always works so hard. Even in the cold.\""
msgstr "「いいけど。……頑張るのね、彼。外はあんなにも寒いのに」"

#. Occurrence A_0:701:14395: scene=A_0
#: A_0:701
msgctxt "text_id=14395 | speaker=unknown"
msgid "  Alice quietly sat down."
msgstr "　有珠は静かに腰を下ろした。"

#. Occurrence A_0:707:14396: scene=A_0
#: A_0:707
msgctxt "text_id=14396 | speaker=unknown"
msgid "  Her teacup had been placed on the table for her."
msgstr "　テーブルには彼女の分のティーカップも用意されていた。"

#. Occurrence A_0:712:14397: scene=A_0
#: A_0:712
msgctxt "text_id=14397 | speaker=unknown"
msgid "  She poured herself some tea and proceeded to open her book."
msgstr "　有珠はポットからカップに紅茶を注いで、持ちこんだ本を開く。"

#. Occurrence A_0:758:14398: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0003; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:758
msgctxt "text_id=14398 | speaker=aoko"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence A_0:773:14399: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_0_0002; voice_prefix=A40; voice_category=2; scene=A_0
#: A_0:773
msgctxt "text_id=14399 | speaker=alice"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence A_0:781:14400: scene=A_0
#: A_0:781
msgctxt "text_id=14400 | speaker=unknown"
msgid "  The two sat passing the time in silence."
msgstr "　二人は無言で時間を過ごす。"

#. Occurrence A_0:786:14401: scene=A_0
#: A_0:786
msgctxt "text_id=14401 | speaker=unknown"
msgid "  Having happened to have the same idea: a nice, relaxing cup of tea in the sunroom."
msgstr "　青子も有珠も気まぐれに、部屋で休むのだったらサンルームでお茶にしよう、とやって来ただけだった。"

#. Occurrence A_0:791:14402: scene=A_0
#: A_0:791
msgctxt "text_id=14402 | speaker=unknown"
msgid "  With their evening roles decided, there was no need for idle chatter."
msgstr "　談話のネタもなく、夜にそなえての役割分担も既に済んでいる。"

#. Occurrence A_0:820:14403: scene=A_0
#: A_0:820
msgctxt "text_id=14403 | speaker=unknown"
msgid "  Aoko stared out the window, intermittently turning her gaze to her magazine."
msgstr "　青子は雑誌をパラ読みしながら、基本的には窓の外の風景を眺め、"

#. Occurrence A_0:825:14404: scene=A_0
#: A_0:825
msgctxt "text_id=14404 | speaker=unknown"
msgid "  Alice was immersed in a book on rune magecraft, occasionally tilting her head up as if to recall something."
msgstr "　有珠はルーン魔術に関する書物に没頭しながら、時折、思い出したように顔をあげる。"

#. Occurrence A_0:897:14405: scene=A_0
#: A_0:897
msgctxt "text_id=14405 | speaker=unknown"
msgid "  As if by unspoken agreement, in unison they pressed their teacups to their lips and glanced outside."
msgstr "　ティーカップに口をつけ、二人は申し合わせたように窓の外に視線を送った。"

#. Occurrence A_0:902:14406: scene=A_0
#: A_0:902
msgctxt "text_id=14406 | speaker=unknown"
msgid "  To the two girls, Soujyuro appeared as if he were an animal in a zoo. Neither was interested in lending a hand."
msgstr "　手伝う気など爪の先ほどもないのか、少女たちは他人事のように庭職人（駆け出し）の動きを観察する。"

#. Occurrence A_0:907:14407: scene=A_0
#: A_0:907
msgctxt "text_id=14407 | speaker=unknown"
msgid "  Despite his sluggish movement, he was making good progress."
msgstr "　草十郎の動きは緩慢ではあるけれど、なぜか作業は<迅速|じんそく>にこなされていった。"

#. Occurrence A_0:952:14408: scene=A_0
#: A_0:952
msgctxt "text_id=14408 | speaker=unknown"
msgid "  As Aoko's attention turned back to the sunroom, her eyes met Alice's."
msgstr "　……ふと青子が視線を逸らすと、対面の相方と目が合った。"

#. Occurrence A_0:1024:14409: scene=A_0
#: A_0:1024
msgctxt "text_id=14409 | speaker=unknown"
msgid "  Alice returned her gaze to her book."
msgstr "　有珠は取り<繕|つくろ>うように書物に視線を戻し、"

#. Occurrence A_0:1024:14410: scene=A_0
#: A_0:1024
msgctxt "text_id=14410 | speaker=unknown"
msgid "  Though moments later, she raised her head again."
msgstr "　しばらくした後、もう一度顔をあげて、"

#. Occurrence A_0:1279:14411: scene=A_0
#: A_0:1279
msgctxt "text_id=14411 | speaker=unknown"
msgid "\""
msgstr "「―――、"

#. Occurrence A_0:1287:14412: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_0_0003; voice_prefix=A40; voice_category=2; scene=A_0
#: A_0:1287
msgctxt "text_id=14412 | speaker=alice"
msgid "Ahem...\""
msgstr "ぽこ」"

#. Occurrence A_0:1357:14413: scene=A_0
#: A_0:1357
msgctxt "text_id=14413 | speaker=unknown"
msgid "  Clearing her throat, she attempted to focus on reading."
msgstr "　コホンと咳払いをして、読書に集中しようと目を伏せる。"

#. Occurrence A_0:1377:14414: scene=A_0
#: A_0:1377
msgctxt "text_id=14414 | speaker=unknown"
msgid "  It was no surprise that Alice admired Soujyuro's diligence."
msgstr "　……有珠が驚くのも無理はない。"

#. Occurrence A_0:1390:14415: scene=A_0
#: A_0:1390
msgctxt "text_id=14415 | speaker=unknown"
msgid "  Not even thirty minutes had passed before he had cleared the courtyard of its unsightly weeds."
msgstr "　草十郎は三十分も経たないうちに中庭を横断して、あれほど見苦しかった雑草を綺麗に片付けてしまったのだ。"

#. Occurrence A_0:1395:14416: scene=A_0
#: A_0:1395
msgctxt "text_id=14416 | speaker=unknown"
msgid "  Without stopping once, the mysterious gardener left the courtyard, puffing clouds of white breath."
msgstr "　謎の庭師は休憩も入れず、白い息を吐きながら、中庭から退場していった。"

#. Occurrence A_0:1400:14417: scene=A_0
#: A_0:1400
msgctxt "text_id=14417 | speaker=unknown"
msgid "  The area he left behind was spotless."
msgstr "　立つ鳥跡を<濁|にご>さず、どころの話ではない。"

#. Occurrence A_0:1421:14418: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0004; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:1421
msgctxt "text_id=14418 | speaker=aoko"
msgid "\"Has he done this before?\""
msgstr "「……プロかしらね、あいつ」"

#. Occurrence A_0:1448:14419: scene=A_0
#: A_0:1448
msgctxt "text_id=14419 | speaker=unknown"
msgid "  Aoko muttered after scanning over his work."
msgstr "　青子はその一部始終を見届けて、ぽつりと呟く。"

#. Occurrence A_0:1453:14420: scene=A_0
#: A_0:1453
msgctxt "text_id=14420 | speaker=unknown"
msgid "  A stalwart, Soujyuro worked confidently and ceaselessly."
msgstr "　あまりにも迷いのない、鉄人の作業だった。"

#. Occurrence A_0:1458:14421: scene=A_0
#: A_0:1458
msgctxt "text_id=14421 | speaker=unknown"
msgid "  She was impressed, like she was watching a scene from a great movie, but before long she grew irked. Why would he waste his energy like that, she thought."
msgstr "　良くできた映画を見た気分にすらなって、青子は感心……を通り越して、草十郎の無駄な芸達者ぶりに呆れている。"

#. Occurrence A_0:1463:14422: scene=A_0
#: A_0:1463
msgctxt "text_id=14422 | speaker=unknown"
msgid "  Alice looked at the clock."
msgstr "　一方、有珠は顔をあげて時計を確認していた。"

#. Occurrence A_0:1504:14423: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_0_0004; voice_prefix=A40; voice_category=2; scene=A_0
#: A_0:1504
msgctxt "text_id=14423 | speaker=alice"
msgid "\"If he starts now, it'll be evening before he's done with the incinerator.\""
msgstr "「……焼却炉、今から手入れをしたら夕方ね」"

#. Occurrence A_0:1524:14424: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0005; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:1524
msgctxt "text_id=14424 | speaker=aoko"
msgid "\"Actually, he already took care of it. I watched him do it from upstairs."
msgstr "「そっちはもう終わってるわ。朝、上から見てたもの。"

#. Occurrence A_0:1524:14425: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0005; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:1524
msgctxt "text_id=14425 | speaker=aoko"
msgid "  I didn't want him breaking it, so I gave him some pointers."
msgstr "　壊されちゃいけないからあれこれ指示だしてね。"

#. Occurrence A_0:1535:14426: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0006; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:1535
msgctxt "text_id=14426 | speaker=aoko"
msgid "  Y'know, I yelled at him for so long from my window my room almost froze over.\""
msgstr "　いやあ、窓開けてさんざん怒鳴ったから部屋が冷えるコト冷えるコト」"

#. Occurrence A_0:1577:14427: scene=A_0
#: A_0:1577
msgctxt "text_id=14427 | speaker=unknown"
msgid "  It was safe to assume Aoko had come to the sunroom to escape her cold room."
msgstr "　青子が居間にやって来た理由は、自分の部屋が冷えきってしまったから、と推測される。"

#. Occurrence A_0:1582:14428: scene=A_0
#: A_0:1582
msgctxt "text_id=14428 | speaker=unknown"
msgid "  Between barking orders from a window and cleaning in the cold, it was clear who had the harder job."
msgstr "　……部屋から指図をするのと外で掃除をするのとでは、どちらが<極寒|ハード>か言うまでもない。"

#. Occurrence A_0:1609:14429: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_0_0005; voice_prefix=A40; voice_category=2; scene=A_0
#: A_0:1609
msgctxt "text_id=14429 | speaker=alice"
msgid "\"Did Sizuki have anything to say?\""
msgstr "「静希君、何か言ってこなかった？」"

#. Occurrence A_0:1631:14430: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0007; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:1631
msgctxt "text_id=14430 | speaker=aoko"
msgid "\"Yeah, a lot, but I couldn't really hear him.\""
msgstr "「言ってたけど、よく聞こえなかったわ」"

#. Occurrence A_0:1658:14431: scene=A_0
#: A_0:1658
msgctxt "text_id=14431 | speaker=unknown"
msgid "  In other words, his complaints fell on deaf ears."
msgstr "　つまり、草十郎の文句は一切<効|き>かなかったという事か。"

#. Occurrence A_0:1703:14432: scene=A_0
#: A_0:1703
msgctxt "text_id=14432 | speaker=unknown"
msgid "  With nothing else to discuss, the two resumed their reading."
msgstr "　共通の話題もなくなって、二人は読書を再開する。"

#. Occurrence A_0:1749:14433: scene=A_0
#: A_0:1749
msgctxt "text_id=14433 | speaker=unknown"
msgid "  The ever-so tense silence was broken by Soujyuro, entering the house after finishing his cleaning."
msgstr "　そんな、少しだけ張りつめた沈黙を破るように、掃除を終えた草十郎がやってきた。"

#. Occurrence A_0:1800:14434: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0001; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:1800
msgctxt "text_id=14434 | speaker=soujuurou"
msgid "\"...\""
msgstr "「……………………」"

#. Occurrence A_0:1805:14435: scene=A_0
#: A_0:1805
msgctxt "text_id=14435 | speaker=unknown"
msgid "  He stared at the two of them, displeased."
msgstr "　気に食わない事があったのか、草十郎は険しい目で青子たちを一瞥する。"

#. Occurrence A_0:1851:14436: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0002; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:1851
msgctxt "text_id=14436 | speaker=soujuurou"
msgid "\"Warm enough in here, Aozaki?\""
msgstr "「あったかそうだね、蒼崎」"

#. Occurrence A_0:1874:14437: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0008; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:1874
msgctxt "text_id=14437 | speaker=aoko"
msgid "\"Warmer than outside. Unless you're walking the halls."
msgstr "「外よりは幾分ね。廊下の気温は外とあまり変わらないけど。"

#. Occurrence A_0:1880:14438: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0009; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:1880
msgctxt "text_id=14438 | speaker=aoko"
msgid "  What made you decide to take care of the gardens, anyway?\""
msgstr "　それで、どうして庭の掃除なんてはじめたのよ、草十郎」"

#. Occurrence A_0:1912:14439: scene=A_0
#: A_0:1912
msgctxt "text_id=14439 | speaker=unknown"
msgid "  Soujyuro's subtle jibe had failed to find its target."
msgstr "　草十郎の嫌味なんてこれっぽっちも効いていない。"

#. Occurrence A_0:1917:14440: scene=A_0
#: A_0:1917
msgctxt "text_id=14440 | speaker=unknown"
msgid "  He had no chance of winning, and so just hung his shoulders in defeat."
msgstr "　<青子|てき>の丈夫さに、草十郎は今更ながらガッカリと肩を落とした。"

#. Occurrence A_0:1955:14441: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0003; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:1955
msgctxt "text_id=14441 | speaker=soujuurou"
msgid "\"It's so cold out today. Snow's probably going to fall tomorrow, so I thought I should tidy up while I could."
msgstr "「今日は本当に寒い。明日あたり雪でも降ってくるだろうから、外の掃除は早くに済ませたかったのに。"

#. Occurrence A_0:1961:14442: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0004; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:1961
msgctxt "text_id=14442 | speaker=soujuurou"
msgid "  I didn't think I'd have to work on the incinerator, too...\""
msgstr "　……焼却炉は予定外だったぞ」"

#. Occurrence A_0:1990:14443: scene=A_0
#: A_0:1990
msgctxt "text_id=14443 | speaker=unknown"
msgid "  He sounded resentful, but his problem was not with the additional work. If anything, he was glad to do it."
msgstr "　恨みがましく言うが、草十郎にとって焼却炉の掃除などお菓子のおまけみたいな物だった。"

#. Occurrence A_0:1995:14444: scene=A_0
#: A_0:1995
msgctxt "text_id=14444 | speaker=unknown"
msgid "  What he did not care for was how nobody had even bothered to lend a hand."
msgstr "　彼が不満に思っているのは、誰も手伝いにこなかった、お寒い事実だけである。"

#. Occurrence A_0:2016:14445: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0010; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2016
msgctxt "text_id=14445 | speaker=aoko"
msgid "\"So what? We all need to use it."
msgstr "「いいじゃない、焼却炉はみんな使うんだから。"

#. Occurrence A_0:2039:14446: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0011; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2039
msgctxt "text_id=14446 | speaker=aoko"
msgid "  Hey, seeing as you're in a generous mood, vacuum the upstairs corridor, will you?"
msgstr "　じゃ、その殊勝な心がけついでに、二階の廊下に掃除機かけといてね。"

#. Occurrence A_0:2045:14447: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0012; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2045
msgctxt "text_id=14447 | speaker=aoko"
msgid "  Oh, and that brace for the beech tree out back is on its last legs. Put that toolbox in your room in the attic to good use.\""
msgstr "　それと裏庭のブナの添え木、壊れかけてたでしょ。工具箱はアンタの<屋根裏|へや>に置きっぱなしだから、それを使うこと」"

#. Occurrence A_0:2071:14448: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0013; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2071
msgctxt "text_id=14448 | speaker=aoko"
msgid "\"And once you're done with that, come to my room."
msgstr "「で、ぜんぶ終わったら私の部屋に来てくれる？"

#. Occurrence A_0:2071:14449: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0013; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2071
msgctxt "text_id=14449 | speaker=aoko"
msgid "  I have a bunch of things I'd like you to throw in the incinerator.\""
msgstr "　いらない物まとめておくから、焼却炉で焼いておいて」"

#. Occurrence A_0:2103:14450: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0005; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:2103
msgctxt "text_id=14450 | speaker=soujuurou"
msgid "\"...\""
msgstr "「……………………」"

#. Occurrence A_0:2109:14451: scene=A_0
#: A_0:2109
msgctxt "text_id=14451 | speaker=unknown"
msgid "  Hence why she made him clean the incinerator."
msgstr "　そのために焼却炉の手入れをさせたらしい。"

#. Occurrence A_0:2114:14452: scene=A_0
#: A_0:2114
msgctxt "text_id=14452 | speaker=unknown"
msgid "  Cruel, but clever."
msgstr "　憎らしいぐらいの段取りの良さである。"

#. Occurrence A_0:2151:14453: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0006; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:2151
msgctxt "text_id=14453 | speaker=soujuurou"
msgid "\"And what're you going to do while I'm doing all that?\" "
msgstr "「それで蒼崎、君は何をするんだ？」"

#. Occurrence A_0:2157:14454: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0014; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2157
msgctxt "text_id=14454 | speaker=aoko"
msgid "\"Hmm. No plans, really. Maybe I'll play a little guitar.\""
msgstr "「そうね、やる事もないしギターにでも触ってようかしら」"

#. Occurrence A_0:2181:14455: scene=A_0
#: A_0:2181
msgctxt "text_id=14455 | speaker=unknown"
msgid "  Aoko thought hard about how to spend her afternoon."
msgstr "　うーん、と有意義な午後の過ごし方を模索する青子。"

#. Occurrence A_0:2186:14456: scene=A_0
#: A_0:2186
msgctxt "text_id=14456 | speaker=unknown"
msgid "  Yet the thought of cleaning did not cross her mind, as had always been the case."
msgstr "　嫌味に対して嫌味で返しているワケではない。"

#. Occurrence A_0:2191:14457: scene=A_0
#: A_0:2191
msgctxt "text_id=14457 | speaker=unknown"
msgid "  No, it was not out of spite that she did not think to help clean, it was because the word \"cleaning\" was not in her vocabulary."
msgstr "　きっと、彼女の予定には『掃除』という単語が存在しないのだ。"

#. Occurrence A_0:2227:14458: scene=A_0
#: A_0:2227
msgctxt "text_id=14458 | speaker=unknown"
msgid "  Soujyuro knew exactly why the mansion"
msgstr "　この洋館はなぜ荒れ果てているのか。"

#. Occurrence A_0:2232:14459: scene=A_0
#: A_0:2232
msgctxt "text_id=14459 | speaker=unknown"
msgid "  was in the state it was in."
msgstr "　その理由を、はっきりと草十郎は思い知った。"

#. Occurrence A_0:2261:14460: scene=A_0
#: A_0:2261
msgctxt "text_id=14460 | speaker=unknown"
msgid "  Still, that did not change the fact the corridor upstairs was very long."
msgstr "　……それにしても二階の廊下は長い。"

#. Occurrence A_0:2266:14461: scene=A_0
#: A_0:2266
msgctxt "text_id=14461 | speaker=unknown"
msgid "  And Aoko was not lying about how cold it was-inside was not much different than outside."
msgstr "　おまけに青子の言う通り、廊下の気温は外とそう変わりはない極寒だ。"

#. Occurrence A_0:2297:14462: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0007; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:2297
msgctxt "text_id=14462 | speaker=soujuurou"
msgid "\"You really have no intention of helping me, do you? "
msgstr "「……そうか、あくまで掃除をする気はないんだな蒼崎。"

#. Occurrence A_0:2303:14463: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0008; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:2303
msgctxt "text_id=14463 | speaker=soujuurou"
msgid "  I mean, I do enjoy cleaning, but...I don't know..."
msgstr "　まあ、掃除はしたいからするけど、こう、なんだろう。"

#. Occurrence A_0:2331:14464: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0009; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:2331
msgctxt "text_id=14464 | speaker=soujuurou"
msgid "  Don't you even feel a little bit guilty using a roommate like this? Or do you just not feel guilt at all?\""
msgstr "　一緒に住んでる人間をそこまでこき使って良心は痛まないか？　それとも、わりと気付いてはいたけど、良心そのものがないのか？」"

#. Occurrence A_0:2390:14465: scene=A_0
#: A_0:2390
msgctxt "text_id=14465 | speaker=unknown"
msgid "  As usual, he might have gone too far."
msgstr "　相変わらず、一言多い男である。"

#. Occurrence A_0:2409:14466: scene=A_0
#: A_0:2409
msgctxt "text_id=14466 | speaker=unknown"
msgid "  His remarks had hit too close to home. Aoko closed her magazine and turned to face him."
msgstr "　草十郎の的確すぎる指摘に、青子はファッション誌を置いて向き直る。"

#. Occurrence A_0:2425:14467: scene=A_0
#: A_0:2425
msgctxt "text_id=14467 | speaker=unknown"
msgid "  Infuriated, she glared, her sharp, blue eyes piercing into him."
msgstr "　透き通る青い目が、苛立ちをこめて草十郎を直視する。"

#. Occurrence A_0:2457:14468: scene=A_0
#: A_0:2457
msgctxt "text_id=14468 | speaker=unknown"
msgid "  Soujyuro knew he had not said anything unjust, but he always backed down first."
msgstr "　その目力に、正義は１００パーセント自分側にありながら、つい気合い負けをする草十郎だった。"

#. Occurrence A_0:2479:14469: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0015; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2479
msgctxt "text_id=14469 | speaker=aoko"
msgid "\"Soujyuro."
msgstr "「草十郎。"

msgctxt "text_id=14470 | speaker=unknown"
msgid " Let me explain it. One. More. Time.\""
msgstr "何度も言うようだけど」"

#. Occurrence A_0:2493:14471: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0010; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:2493
msgctxt "text_id=14471 | speaker=soujuurou"
msgid "\"Okay...\""
msgstr "「はい」"

#. Occurrence A_0:2498:14472: scene=A_0
#: A_0:2498
msgctxt "text_id=14472 | speaker=unknown"
msgid "  He replied automatically, straightening his back in response to Aoko's cold, calm tone."
msgstr "　落ち着いた青子の声に、反射的に背中を伸ばす草十郎。"

#. Occurrence A_0:2535:14473: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0016; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2535
msgctxt "text_id=14473 | speaker=aoko"
msgid "\"Don't be mistaken. We're not letting you stay here out of kindness."
msgstr "「勘違いはしないで。私たちはアンタを同居させてあげてるんじゃない。"

#. Occurrence A_0:2541:14474: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0017; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2541
msgctxt "text_id=14474 | speaker=aoko"
msgid "  We're putting up with you, because we have to.\""
msgstr "　これ以上ないって譲歩の末、仕方なく飼ってあげてるだけなんだからね」"

#. Occurrence A_0:2557:14475: scene=A_0
#: A_0:2557
msgctxt "text_id=14475 | speaker=unknown"
msgid "  Aoko did not mince her words."
msgstr "　きっぱりと青子は言う。"

#. Occurrence A_0:2562:14476: scene=A_0
#: A_0:2562
msgctxt "text_id=14476 | speaker=unknown"
msgid "  Soujyuro nodded in defeat."
msgstr "　草十郎はなるほど、と頷いた。"

#. Occurrence A_0:2604:14477: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0011; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:2604
msgctxt "text_id=14477 | speaker=soujuurou"
msgid "\"So, I'm basically a pet.\""
msgstr "「そうか、飼ってもらってるのか」"

#. Occurrence A_0:2626:14478: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0018; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2626
msgctxt "text_id=14478 | speaker=aoko"
msgid "\"Exactly. And not a very useful one at that.\""
msgstr "「そ。番犬にもならないだろうけど」"

#. Occurrence A_0:2632:14479: scene=A_0
#: A_0:2632
msgctxt "text_id=14479 | speaker=unknown"
msgid "  Aoko responded, already tired of the conversation."
msgstr "　草十郎の呟きに、青子はつまらなそうに言い返す。"

#. Occurrence A_0:2637:14480: scene=A_0
#: A_0:2637
msgctxt "text_id=14480 | speaker=unknown"
msgid "  While Soujyuro had little room to counter, he still tried."
msgstr "　それはそれで事実なのだが、草十郎にも一つや二つ反論もあるというもの。"

#. Occurrence A_0:2674:14481: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0012; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:2674
msgctxt "text_id=14481 | speaker=soujuurou"
msgid "\"Last time I checked, most pets don't have to buy food or pay rent.\""
msgstr "「しかし一方、番犬は間違っても自分の食い<扶持|ぶち>を入れたり、あまつさえ家賃を払ったりしないのも事実であった」"

#. Occurrence A_0:2691:14482: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0019; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2691
msgctxt "text_id=14482 | speaker=aoko"
msgid "\"Did you say something?\""
msgstr "「何か言った？」"

#. Occurrence A_0:2741:14483: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0013; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:2741
msgctxt "text_id=14483 | speaker=soujuurou"
msgid "\"Nothing. I'm just a dumb mutt barking up the wrong tree.\""
msgstr "「いや。負け犬の遠吠えを、少しばかり」"

#. Occurrence A_0:2747:14484: scene=A_0
#: A_0:2747
msgctxt "text_id=14484 | speaker=unknown"
msgid "  He raised his hand dismissively, knowing he could not win."
msgstr "　参りました、とばかりに手をあげる草十郎。"

#. Occurrence A_0:2752:14485: scene=A_0
#: A_0:2752
msgctxt "text_id=14485 | speaker=unknown"
msgid "  To Aoko's ears, his attempt at self-deprecation sounded facetious."
msgstr "　自虐的なセリフは、彼が言うと間の抜けた冗談にしか聞こえない。"

#. Occurrence A_0:2797:14486: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0020; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2797
msgctxt "text_id=14486 | speaker=aoko"
msgid "\"You do understand the position you're in, right?\""
msgstr "「……草十郎。アンタ、ほんとに分かってる？」"

#. Occurrence A_0:2803:14487: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0014; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:2803
msgctxt "text_id=14487 | speaker=soujuurou"
msgid "\"Yeah. One where I do all the work.\""
msgstr "「そうだな。君たちがどうあっても掃除をする気がないぐらいは、なんとか」"

#. Occurrence A_0:2815:14488: scene=A_0
#: A_0:2815
msgctxt "text_id=14488 | speaker=unknown"
msgid "  Aoko grinned at her pet's obedience."
msgstr "　それだけ理解していれば上等である。"

#. Occurrence A_0:2826:14489: scene=A_0
#: A_0:2826
msgctxt "text_id=14489 | speaker=unknown"
msgid "  As long as he knew his place, that was all that mattered to her."
msgstr "　そんな草十郎の態度に、青子はにっこりと笑みをうかべた。"

#. Occurrence A_0:2831:14490: scene=A_0
#: A_0:2831
msgctxt "text_id=14490 | speaker=unknown"
msgid "  She seemed to be extremely satisfied with his response."
msgstr "　どうも、今の返答がたいへんお気に召した模様。"

#. Occurrence A_0:2853:14491: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0021; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2853
msgctxt "text_id=14491 | speaker=aoko"
msgid "\"Heh. You don't have a care in the world, do you?\""
msgstr "「ふーん。余裕あるんだ、静希くんってば」"

#. Occurrence A_0:2887:14492: scene=A_0
#: A_0:2887
msgctxt "text_id=14492 | speaker=unknown"
msgid "  Her playful smile darkened, as did Soujyuro's expression."
msgstr "　楽しげな青子の笑みと同時に、草十郎の顔が<曇|くも>る。"

#. Occurrence A_0:2927:14493: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0015; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:2927
msgctxt "text_id=14493 | speaker=soujuurou"
msgid "\"Aozaki, I...I can't breathe.\""
msgstr "「……蒼崎。なんだか、息ができないんだけど」"

#. Occurrence A_0:2933:14494: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0022; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2933
msgctxt "text_id=14494 | speaker=aoko"
msgid "\"You know, if I keep this up you'll never be able to complain again. Shall we give it a try?\""
msgstr "「このまま放っておくとそんなコトも言ってられなくなるんだけど、試してみる？」"

#. Occurrence A_0:2938:14495: scene=A_0
#: A_0:2938
msgctxt "text_id=14495 | speaker=unknown"
msgid "  He shook his head, his expression growing more and more grim."
msgstr "　草十郎は顔をますます曇らせながら、いや、と首を横に振って答えた。"

#. Occurrence A_0:2988:14496: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0023; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:2988
msgctxt "text_id=14496 | speaker=aoko"
msgid "\"Smart choice. I don't want to see you suffocate. If I can help it.\""
msgstr "「賢明ね。私も窒息死体なんて見たくないもの」"

#. Occurrence A_0:3025:14497: scene=A_0
#: A_0:3025
msgctxt "text_id=14497 | speaker=unknown"
msgid "  The grating sound subsided."
msgstr "　耳障りな音が途絶える。"

#. Occurrence A_0:3030:14498: scene=A_0
#: A_0:3030
msgctxt "text_id=14498 | speaker=unknown"
msgid "  Soujyuro gingerly touched his throat."
msgstr "　草十郎はそろりと首に手を当てる。"

#. Occurrence A_0:3035:14499: scene=A_0
#: A_0:3035
msgctxt "text_id=14499 | speaker=unknown"
msgid "  The collar that had suddenly tightened around his neck returned to its normal size."
msgstr "　さっきまで独りでに絞まってきた首輪は、今ではもとのサイズに戻っていた。"

#. Occurrence A_0:3075:14500: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0016; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:3075
msgctxt "text_id=14500 | speaker=soujuurou"
msgid "\"Do you have any idea how painful it is to suffocate? It's excruciating.\""
msgstr "「……気管が<塞|ふさ>がれた時の苦しさを知らないんだろ、蒼崎は。本当に抵抗できなくなるんだぞ、あれは」"

#. Occurrence A_0:3097:14501: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0024; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:3097
msgctxt "text_id=14501 | speaker=aoko"
msgid "\"I told you that's what your collar was for."
msgstr "「だから、そのための首輪だって言ったでしょ。"

#. Occurrence A_0:3103:14502: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0025; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:3103
msgctxt "text_id=14502 | speaker=aoko"
msgid "  You're always so naive, so I took the opportunity to give it a test run... Now you know your place."
msgstr "　今まで実践したコトなかったし、アンタはあいかわらず危機感ないし。ここらで一度<躾|しつ>けておいたの。"

#. Occurrence A_0:3130:14503: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0026; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:3130
msgctxt "text_id=14503 | speaker=aoko"
msgid "  Anyway. Chores. You're wasting daylight.\""
msgstr "　―――それより掃除。急がないと日が暮れるんじゃないの？」"

#. Occurrence A_0:3163:14504: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0017; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:3163
msgctxt "text_id=14504 | speaker=soujuurou"
msgid "\"Okay..."
msgstr "「……はあ。わかったよ。"

#. Occurrence A_0:3169:14505: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_0_0018; voice_prefix=A30; voice_category=3; scene=A_0
#: A_0:3169
msgctxt "text_id=14505 | speaker=soujuurou"
msgid "  So that's what the sun was trying to tell me this morning...\""
msgstr "　結局、今日はこうなる星の運びだったんだ」"

#. Occurrence A_0:3211:14506: scene=A_0
#: A_0:3211
msgctxt "text_id=14506 | speaker=unknown"
msgid "  Soujyuro left the sunroom, his shoulders slumped and his tail between his legs."
msgstr "　負け犬よろしく肩を落として、草十郎はサンルームから立ち去っていった。"

#. Occurrence A_0:3224:14507: scene=A_0
#: A_0:3224
msgctxt "text_id=14507 | speaker=unknown"
msgid "  Aoko watched him leave before turning to her magazine as if nothing had happened."
msgstr "　それを見送った後、何事もなかったように青子は雑誌に視線を戻す。"

#. Occurrence A_0:3258:14508: scene=A_0
#: A_0:3258
msgctxt "text_id=14508 | speaker=unknown"
msgid "  Alice paid no attention. None of that had anything to do with her."
msgstr "　以上のやりとりを、有珠は我関せずと聞き流していた。"

#. Occurrence A_0:3263:14509: scene=A_0
#: A_0:3263
msgctxt "text_id=14509 | speaker=unknown"
msgid "  With Soujyuro gone, the room once again fell silent."
msgstr "　何度目かの沈黙。"

#. Occurrence A_0:3268:14510: scene=A_0
#: A_0:3268
msgctxt "text_id=14510 | speaker=unknown"
msgid "  As the clock ticked on, Alice suddenly stopped flipping through her book."
msgstr "　刻々と時計の針が回る中、不意に、ページをめくる有珠の手が止まった。"

#. Occurrence A_0:3289:14511: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_0_0006; voice_prefix=A40; voice_category=2; scene=A_0
#: A_0:3289
msgctxt "text_id=14511 | speaker=alice"
msgid "\"Any reason why you push him so hard?\""
msgstr "「ねえ。どうして彼を酷使するの？」"

#. Occurrence A_0:3295:14512: scene=A_0
#: A_0:3295
msgctxt "text_id=14512 | speaker=unknown"
msgid "  She asked as though talking to herself."
msgstr "　独り言のような問い。"

#. Occurrence A_0:3300:14513: scene=A_0
#: A_0:3300
msgctxt "text_id=14513 | speaker=unknown"
msgid "  Aoko replied without so much as looking up."
msgstr "　青子は雑誌をめくる手を止めず、"

#. Occurrence A_0:3335:14514: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_0_0027; voice_prefix=A10; voice_category=1; scene=A_0
#: A_0:3335
msgctxt "text_id=14514 | speaker=aoko"
msgid "\"Nope. We're just going to erase his memories in the end anyway. Why get his hopes up?\""
msgstr "「別に。最後には記憶を消させてもらうんだから、楽しかったら困るじゃない」"

#. Occurrence A_0:3341:14515: scene=A_0
#: A_0:3341
msgctxt "text_id=14515 | speaker=unknown"
msgid "  Obscure as ever, but sincere in her own way."
msgstr "　極めて分かりにくい、彼女らしい誠実さを口にした。"

#. Occurrence A_0:3374:14516: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_0_0007; voice_prefix=A40; voice_category=2; scene=A_0
#: A_0:3374
msgctxt "text_id=14516 | speaker=alice"
msgid "\"When you put it like that...I suppose you are right.\""
msgstr "「…………そう。言われてみれば、そうだったわね」"

#. Occurrence A_0:3380:14517: scene=A_0
#: A_0:3380
msgctxt "text_id=14517 | speaker=unknown"
msgid "  Alice could not believe she had forgotten about the situation."
msgstr "　……そんなコトを、忘れていた自分に驚いてしまう。"

#. Occurrence A_0:3385:14518: scene=A_0
#: A_0:3385
msgctxt "text_id=14518 | speaker=unknown"
msgid "  Silently, she looked up from her book and gazed outside once again."
msgstr "　有珠は静かに顔を上げ、硝子ごしの風景を眺めた。"

#. Occurrence A_0:3430:14519: scene=A_0
#: A_0:3430
msgctxt "text_id=14519 | speaker=unknown"
msgid "  The courtyard through the window reminded her of where she lived a decade ago."
msgstr "　窓から見える彼女の中庭は、十年前の故郷を思わせる。"

#. Occurrence A_0:3435:14520: scene=A_0
#: A_0:3435
msgctxt "text_id=14520 | speaker=unknown"
msgid "  Nothing could compare to the beauty of those gardens."
msgstr "　あの頃に比べれば何もかも<見窄|みすぼ>らしい、荒れ野とさえ言える庭。"

#. Occurrence A_0:3440:14521: scene=A_0
#: A_0:3440
msgctxt "text_id=14521 | speaker=unknown"
msgid "  But if that was the case, why did the scenery make her feel nostalgic?"
msgstr "　なのに、どうして面影が重なるのか。"

#. Occurrence A_0:3479:14522: scene=A_0
#: A_0:3479
msgctxt "text_id=14522 | speaker=unknown"
msgid "  All Soujyuro had done was take care of the gardens with the goodness of his own heart."
msgstr "　ただ大切に、真心だけで手入れをされた彼女の庭。"

#. Occurrence A_0:3485:14523: scene=A_0
#: A_0:3485
msgctxt "text_id=14523 | speaker=unknown"
msgid "  In only half a day, he had achieved so much."
msgstr "　それが今日半日の、草十郎の成果だった。"

#. Occurrence A_1:42:14524: scene=A_1
#: A_1:42
msgctxt "text_id=14524 | speaker=unknown"
msgid "  It was Christmas Eve, and snow had started to fall."
msgstr "　イヴの日に、雪はしんしんと降りはじめた。"

#. Occurrence A_1:83:14525: scene=A_1
#: A_1:83
msgctxt "text_id=14525 | speaker=unknown"
msgid "  Its timing was too good, as though it had waited for that day specifically."
msgstr "　自らの価値を知っていたのか、今年の初雪は誰もが喜ぶ記念日に顔を見せた。"

#. Occurrence A_1:88:14526: scene=A_1
#: A_1:88
msgctxt "text_id=14526 | speaker=unknown"
msgid "  The cold, bustling main street seemed bright and vibrant under the layer of frosty white."
msgstr "　大通りでの<賑|にぎ>わいは白く寒く、それでいて明るいものになっているだろう。"

#. Occurrence A_1:108:14527: scene=A_1
#: A_1:108
msgctxt "text_id=14527 | speaker=unknown"
msgid "  Reindeer statues illuminated the surroundings..."
msgstr "　トナカイを<象|かたど>るイルミネーション。"

#. Occurrence A_1:113:14528: scene=A_1
#: A_1:113
msgctxt "text_id=14528 | speaker=unknown"
msgid "  Children danced merrily to \"Jingle Bells\"..."
msgstr "　子供たちの足を弾ませるジングルベル。"

#. Occurrence A_1:118:14529: scene=A_1
#: A_1:118
msgctxt "text_id=14529 | speaker=unknown"
msgid "  People walked along the brick road, smiling broadly..."
msgstr "　レンガの道を行く人々は、一様に満ち足りた微笑みをうかべている。"

#. Occurrence A_1:162:14530: scene=A_1
#: A_1:162
msgctxt "text_id=14530 | speaker=unknown"
msgid "  These festivities, however,"
msgstr "　しかし。"

#. Occurrence A_1:167:14531: scene=A_1
#: A_1:167
msgctxt "text_id=14531 | speaker=unknown"
msgid "  had not reached the mansion on the hill."
msgstr "　そんな街の<彩|いろど>りも、丘の上の洋館には届かない。"

#. Occurrence A_1:172:14532: scene=A_1
#: A_1:172
msgctxt "text_id=14532 | speaker=unknown"
msgid "  Silence enveloped the isolated building."
msgstr "　人里から離れた館は静かに。"

#. Occurrence A_1:177:14533: scene=A_1
#: A_1:177
msgctxt "text_id=14533 | speaker=unknown"
msgid "  The shadow of the snow-covered woodland grew longer,"
msgstr "　森は白い粉雪に覆われ、いっそう影を濃くしていた。"

#. Occurrence A_1:183:14534: scene=A_1
#: A_1:183
msgctxt "text_id=14534 | speaker=unknown"
msgid "  beckoning in the darkness."
msgstr "　いずれ来るであろう<黄昏時|たそがれどき>。"

#. Occurrence A_1:188:14535: scene=A_1
#: A_1:188
msgctxt "text_id=14535 | speaker=unknown"
msgid "  People returned to the warmth of their homes, knowing a bitter night lay ahead."
msgstr "　人々が<家路|いえじ>に就き、街頭から<人気|ひとけ>の絶える静夜を、じっと待ち続けるように。"

#. Occurrence A_1:260:14536: scene=A_1
#: A_1:260
msgctxt "text_id=14536 | speaker=unknown"
msgid "  Something had been amiss in the mansion all day."
msgstr "　その日の洋館は、朝から空気が違っていた。"

#. Occurrence A_1:265:14537: scene=A_1
#: A_1:265
msgctxt "text_id=14537 | speaker=unknown"
msgid "  Perhaps it was the calm before the storm."
msgstr "　嵐の前の静けさである。"

#. Occurrence A_1:290:14538: scene=A_1
#: A_1:290
msgctxt "text_id=14538 | speaker=unknown"
msgid "  Two days had passed since Touko Aozaki had revealed herself."
msgstr "　敵の正体―――蒼崎橙子の存在が明らかになってから二日。"

#. Occurrence A_1:295:14539: scene=A_1
#: A_1:295
msgctxt "text_id=14539 | speaker=unknown"
msgid "  Aoko and Alice spent more and more time locked in their rooms; mealtimes had grown noticeably quieter."
msgstr "　青子も有珠も自室に閉じこもる事が多くなり、食事<時|どき>の談話も目に見えて少なくなった。"

#. Occurrence A_1:300:14540: scene=A_1
#: A_1:300
msgctxt "text_id=14540 | speaker=unknown"
msgid "  With their roles decided, they were too busy with their own jobs to worry about each other."
msgstr "　役割分担を終えた少女たちは、それぞれの仕事を<全|まっと>うするため、自分の事だけで手一杯なのだ。"

#. Occurrence A_1:359:14541: scene=A_1
#: A_1:359
msgctxt "text_id=14541 | speaker=unknown"
msgid "  On this day, the two had been relaxing in the drawing room since morning."
msgstr "　そんな二人が、今日は朝から居間でくつろいでいる。"

#. Occurrence A_1:364:14542: scene=A_1
#: A_1:364
msgctxt "text_id=14542 | speaker=unknown"
msgid "  The mood was calm."
msgstr "　張りつめた様子もない。"

#. Occurrence A_1:369:14543: scene=A_1
#: A_1:369
msgctxt "text_id=14543 | speaker=unknown"
msgid "  Well, mostly at least―Soujyuro was fretting that tonight would be the same."
msgstr "　だから逆に今夜がそうなのだと、草十郎は悟ってしまった。"

#. Occurrence A_1:403:14544: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_1_0000; voice_prefix=A30; voice_category=3; scene=A_1
#: A_1:403
msgctxt "text_id=14544 | speaker=soujuurou"
msgid "\"The snow just couldn't wait till tomorrow, could it?\""
msgstr "「雪が明日なら良かったのに」"

#. Occurrence A_1:410:14545: scene=A_1
#: A_1:410
msgctxt "text_id=14545 | speaker=unknown"
msgid "  He aimed his words towards the girls on the sofa,"
msgstr "　草十郎はソファーに座った二人に話しかける。"

#. Occurrence A_1:415:14546: scene=A_1
#: A_1:415
msgctxt "text_id=14546 | speaker=unknown"
msgid "  despite knowing they would be ignored."
msgstr "　返事は期待していない。"

#. Occurrence A_1:420:14547: scene=A_1
#: A_1:420
msgctxt "text_id=14547 | speaker=unknown"
msgid "  Whether the snow fell today, tomorrow, or not at all, it did not affect them."
msgstr "　大体、雪が明日になったところで彼女たちに変化があるわけでもない。"

#. Occurrence A_1:425:14548: scene=A_1
#: A_1:425
msgctxt "text_id=14548 | speaker=unknown"
msgid "  The snow just meant a white Christmas."
msgstr "　クリスマスが、ホワイトクリスマスになるだけの話である。"

#. Occurrence A_1:457:14549: scene=A_1
#: A_1:457
msgctxt "text_id=14549 | speaker=unknown"
msgid "  Aoko remained silent."
msgstr "　青子から言葉はなかった。"

#. Occurrence A_1:462:14550: scene=A_1
#: A_1:462
msgctxt "text_id=14550 | speaker=unknown"
msgid "  She wasn't ignoring him per se; she just had other things on her mind."
msgstr "　無視しているのではなく、単純に、そこまでの余裕がないだけだ。"

#. Occurrence A_1:467:14551: scene=A_1
#: A_1:467
msgctxt "text_id=14551 | speaker=unknown"
msgid "  Soujyuro knew this, but still cast a lonely glance around the sunroom."
msgstr "　分かり切った事とはいえ少し淋しいな、と草十郎はサンルームに視線を投げる。"

#. Occurrence A_1:502:14552: scene=A_1
#: A_1:502
msgctxt "text_id=14552 | speaker=unknown"
msgid "  The courtyard he had cleaned only a few days ago was hidden by a layer of white."
msgstr "　何日か前に手入れをした中庭は、白一色に染まっている。"

#. Occurrence A_1:507:14553: scene=A_1
#: A_1:507
msgctxt "text_id=14553 | speaker=unknown"
msgid "  The falling snow would stop every so often, but then resume again as if teasing Soujyuro."
msgstr "　粉雪は降ったり止んだりと気まぐれだが、この分ではかなりの厚さで地面に残るに違いない。"

#. Occurrence A_1:512:14554: scene=A_1
#: A_1:512
msgctxt "text_id=14554 | speaker=unknown"
msgid "  By the next morning, the courtyard would be a winter wonderland."
msgstr "　夜には一面の銀世界になるだろう。"

#. Occurrence A_1:517:14555: scene=A_1
#: A_1:517
msgctxt "text_id=14555 | speaker=unknown"
msgid "  Aoko and Alice sipped tea in an effort to fight the cold."
msgstr "　伝わる寒気から身を暖めるように、青子たちは紅茶を口に運んでいる。"

#. Occurrence A_1:522:14556: scene=A_1
#: A_1:522
msgctxt "text_id=14556 | speaker=unknown"
msgid "  In fact, that was all they were doing."
msgstr "　思えばそれだけが、今の彼女たちの行動だった。"

#. Occurrence A_1:555:14557: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_1_0001; voice_prefix=A30; voice_category=3; scene=A_1
#: A_1:555
msgctxt "text_id=14557 | speaker=soujuurou"
msgid "\"You know, Touko's hair was darker than yours, Aozaki."
msgstr "「そういえば、橙子さんの髪の色は蒼崎より濃かったね。"

#. Occurrence A_1:555:14558: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_1_0001; voice_prefix=A30; voice_category=3; scene=A_1
#: A_1:555
msgctxt "text_id=14558 | speaker=soujuurou"
msgid "  I've never seen such beautiful red hair. Shame it was so short.\""
msgstr "　あんな綺麗な赤毛は初めて見た。短くしてるのはもったいなかったな」"

#. Occurrence A_1:560:14559: scene=A_1
#: A_1:560
msgctxt "text_id=14559 | speaker=unknown"
msgid "  Soujyuro rambled on, not expecting a response."
msgstr "　これも返事は期待せず、ぼんやりと呟く草十郎。"

#. Occurrence A_1:565:14560: scene=A_1
#: A_1:565
msgctxt "text_id=14560 | speaker=unknown"
msgid "  However..."
msgstr "　しかし。"

#. Occurrence A_1:592:14561: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0000; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:592
msgctxt "text_id=14561 | speaker=aoko"
msgid "\"Her hair was cut short...?\""
msgstr "「……短かったって、姉貴の髪が……？」"

#. Occurrence A_1:598:14562: scene=A_1
#: A_1:598
msgctxt "text_id=14562 | speaker=unknown"
msgid "  Aoko's expression went from nonchalant to its usual sharpness."
msgstr "　心ここにあらずだった青子の表情が、普段の鋭さを取り戻した。"

#. Occurrence A_1:633:14563: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0001; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:633
msgctxt "text_id=14563 | speaker=aoko"
msgid "\"What do you mean short? You are talking about her hair, right?\""
msgstr "「それどういうこと？　短くしてるって、髪の毛の事よね？」"

#. Occurrence A_1:652:14564: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_1_0002; voice_prefix=A30; voice_category=3; scene=A_1
#: A_1:652
msgctxt "text_id=14564 | speaker=soujuurou"
msgid "\"Yeah. Even shorter than Alice's. Is that a big deal?\""
msgstr "「ああ。有珠より短かったけど、それがどうしたんだ？」"

#. Occurrence A_1:658:14565: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0002; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:658
msgctxt "text_id=14565 | speaker=aoko"
msgid "\"No. She just used to have longer hair than mine."
msgstr "「別に。あの人、前は私より長かったってだけ。"

#. Occurrence A_1:678:14566: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0003; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:678
msgctxt "text_id=14566 | speaker=aoko"
msgid "  Hm... So she really cut it all off.\""
msgstr "　―――そう。あの髪を切ったのね、姉貴は」"

#. Occurrence A_1:684:14567: scene=A_1
#: A_1:684
msgctxt "text_id=14567 | speaker=unknown"
msgid "  Aoko spoke in a grave tone."
msgstr "　深刻な独白。"

#. Occurrence A_1:689:14568: scene=A_1
#: A_1:689
msgctxt "text_id=14568 | speaker=unknown"
msgid "  Showing slight interest, Alice turned to Soujyuro."
msgstr "　有珠も関心があるのか、黒い瞳を草十郎に向けていた。"

#. Occurrence A_1:748:14569: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_1_0003; voice_prefix=A30; voice_category=3; scene=A_1
#: A_1:748
msgctxt "text_id=14569 | speaker=soujuurou"
msgid "\"What's so bad about her getting a haircut? Does it affect you in any way, Aozaki?\""
msgstr "「……普通じゃないな。髪を切ったぐらいでどうしたんだ、一体。橙子さんの髪が短いと蒼崎が困るのか？」"

#. Occurrence A_1:767:14570: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0004; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:767
msgctxt "text_id=14570 | speaker=aoko"
msgid "\"Well, yeah, it does."
msgstr "「…………まあ、その通りだけど。"

#. Occurrence A_1:779:14571: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0005; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:779
msgctxt "text_id=14571 | speaker=aoko"
msgid "  As we have nothing to do until nightfall, I suppose I'll explain."
msgstr "　いいわ、どうせ夜まで暇だし、説明ぐらいはしてあげる。"

#. Occurrence A_1:785:14572: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0006; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:785
msgctxt "text_id=14572 | speaker=aoko"
msgid "  You're lucky. If you hadn't said anything, we'd have been oblivious when fighting her.\""
msgstr "　アンタがそんなコト言わなければ、未知数のまま橙子と戦うはめになっただろうし」"

#. Occurrence A_1:817:14573: scene=A_1
#: A_1:817
msgctxt "text_id=14573 | speaker=unknown"
msgid "  Aoko knowingly glanced at Alice, her expression suggesting she was treating her."
msgstr "　ま、ご褒美ね、と青子は有珠を一瞥した。"

#. Occurrence A_1:822:14574: scene=A_1
#: A_1:822
msgctxt "text_id=14574 | speaker=unknown"
msgid "  She was also likely seeking approval."
msgstr "　おそらく有珠に同意を求めているのだろう。"

#. Occurrence A_1:827:14575: scene=A_1
#: A_1:827
msgctxt "text_id=14575 | speaker=unknown"
msgid "  Alice remained stoic as ever, her expression showing neither approval nor disapproval."
msgstr "　有珠はやっぱり無表情で、青子の視線に肯定も否定もしない。"

#. Occurrence A_1:859:14576: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0007; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:859
msgctxt "text_id=14576 | speaker=aoko"
msgid "\"How can I put this... Mages can use their hair as a weapon."
msgstr "「簡単に言うと、魔術師にとっては髪の毛も武器ってコトよ。"

#. Occurrence A_1:865:14577: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0008; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:865
msgctxt "text_id=14577 | speaker=aoko"
msgid "  For the longest time, hair and eyes have been vital to magecraft. Especially in my sister's case."
msgstr "　昔っから人間の髪や目は魔術の材料になりやすいの。女の場合は<殊更|ことさら>にね。"

#. Occurrence A_1:871:14578: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0009; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:871
msgctxt "text_id=14578 | speaker=aoko"
msgid "  The more colorful the eyes, the better. The longer the hair, the higher the quality."
msgstr "　瞳の色は<多彩|おおい>ほどいいし、髪も長いほど質がいい。"

#. Occurrence A_1:877:14579: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0010; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:877
msgctxt "text_id=14579 | speaker=aoko"
msgid "  Hair has the same qualities as the body, and when grown over many years it becomes a strong base component."
msgstr "　髪の毛は自身と同一視しやすいし、長い年月をかけて育てられる、原始的で強力な“原料”と思ってくれていいわ。"

#. Occurrence A_1:896:14580: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0011; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:896
msgctxt "text_id=14580 | speaker=aoko"
msgid "  That's why I'm growing mine out. Looking after it is a pain sometimes, but I like styling it.\""
msgstr "　私が髪を伸ばしてるのはまあ、そういうこと。手入れが大変なんだけど、そこは女だから半分趣味みたいなもんよね」"

#. Occurrence A_1:916:14581: scene=A_1
#: A_1:916
msgctxt "text_id=14581 | speaker=unknown"
msgid "  Soujyuro glanced furtively at Alice, wondering if the same held true for her."
msgstr "　……はて。そうなると有珠はどうなのだろうか、と草十郎は有珠の横顔を盗み見る。"

#. Occurrence A_1:934:14582: scene=A_1
#: A_1:934
msgctxt "text_id=14582 | speaker=unknown"
msgid "  Maybe Alice had cut it because it was a hassle to maintain."
msgstr "　青子の言う通り、手入れが面倒なので切ってしまったのか。"

#. Occurrence A_1:939:14583: scene=A_1
#: A_1:939
msgctxt "text_id=14583 | speaker=unknown"
msgid "  It sounded stupid, but then again this was Alice. Soujyuro nodded to himself."
msgstr "　バカらしい考えだが、有珠ならありうるな、と草十郎は内心うなずいた。"

#. Occurrence A_1:977:14584: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_1_0004; voice_prefix=A30; voice_category=3; scene=A_1
#: A_1:977
msgctxt "text_id=14584 | speaker=soujuurou"
msgid "\"So that's good for you then, right, Aozaki?"
msgstr "「ん？　じゃあ蒼崎としてはいい事じゃないか。"

#. Occurrence A_1:983:14585: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_1_0005; voice_prefix=A30; voice_category=3; scene=A_1
#: A_1:983
msgctxt "text_id=14585 | speaker=soujuurou"
msgid "  I mean that Touko's got short hair.\""
msgstr "　橙子さんの髪、短いんだから」"

#. Occurrence A_1:1017:14586: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0012; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1017
msgctxt "text_id=14586 | speaker=aoko"
msgid "\"If she's used all her hair before coming here, then yes."
msgstr "「それが<三咲町|ここ>に来る前に使い切ったものならいいんだけど。"

#. Occurrence A_1:1023:14587: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0013; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1023
msgctxt "text_id=14587 | speaker=aoko"
msgid "  Long hair can be used in tons of ways."
msgstr "　伸ばした髪には色々と使い道があるのよ。"

#. Occurrence A_1:1029:14588: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0014; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1029
msgctxt "text_id=14588 | speaker=aoko"
msgid "  I can only use it to temporarily reinforce magecraft, but my sister can use it to complement longer-lasting spells."
msgstr "　私は瞬間的な術の強化にしか使えないけど、姉貴だったら恒久的な術の補佐に使うはず。"

#. Occurrence A_1:1047:14589: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0015; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1047
msgctxt "text_id=14589 | speaker=aoko"
msgid "  With all those thoughts and memories in that hair, it's like having a mage clone."
msgstr "　年月と想念を蓄えた髪は魔術師の分身とも言える。"

#. Occurrence A_1:1053:14590: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0016; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1053
msgctxt "text_id=14590 | speaker=aoko"
msgid "  You can even use it on a dead dog or cat, reviving them and making them the mage's familiar.\""
msgstr "　そういった物をね、死んじゃった犬だの猫だのを反魂させる時に与えると、術者に<服従|ふくじゅう>する使い魔が出来上がるの」"

#. Occurrence A_1:1086:14591: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0017; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1086
msgctxt "text_id=14591 | speaker=aoko"
msgid "\"Familiars with no previous magical energy, like said dog or cat, can acquire Magic Circuits. All thanks to the hair."
msgstr "「生前魔力のなかった使い魔……例えば猫とか、犬ね。これらは術者の髪を取りこんで独自の魔術回路を得る。"

#. Occurrence A_1:1092:14592: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0018; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1092
msgctxt "text_id=14592 | speaker=aoko"
msgid "  The reanimated creature becomes something entirely different. They can even speak and take human form."
msgstr "　新生する事でまったく違う生き物―――<猫|・><の|・><魔|・><術|・><師|・>になるってコト。たとえば人語を解したり、人間に化けてみたりって。"

#. Occurrence A_1:1098:14593: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0019; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1098
msgctxt "text_id=14593 | speaker=aoko"
msgid "  Their behavior changes, too, to something resembling a regular mage. Right, Alice?\""
msgstr "　行動原理も変わってしまって、たいていは術者に似通った性格になるわ。そうよね、有珠？」"

#. Occurrence A_1:1128:14594: scene=A_1
#: A_1:1128
msgctxt "text_id=14594 | speaker=unknown"
msgid "  Her last words came with a mocking smile."
msgstr "　青子の最後の言葉は、どこか意地の悪い笑みが含まれていた。"

#. Occurrence A_1:1133:14595: scene=A_1
#: A_1:1133
msgctxt "text_id=14595 | speaker=unknown"
msgid "  Alice silently ignored it."
msgstr "　有珠はそれを無言で受け流す。"

#. Occurrence A_1:1166:14596: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_1_0006; voice_prefix=A30; voice_category=3; scene=A_1
#: A_1:1166
msgctxt "text_id=14596 | speaker=soujuurou"
msgid "\"So, Touko has familiars like Alice?\""
msgstr "「じゃあ、橙子さんには有珠のみたいな使い魔がいると……？」"

#. Occurrence A_1:1172:14597: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0020; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1172
msgctxt "text_id=14597 | speaker=aoko"
msgid "\"I think that's a safe bet."
msgstr "「そう見るのが妥当でしょうね。"

#. Occurrence A_1:1178:14598: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0021; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1178
msgctxt "text_id=14598 | speaker=aoko"
msgid "  She must have been growing her hair for over twenty years. She could have an army of powerful familiars.\""
msgstr "　姉貴は二十年以上伸ばし続けた髪と引き替えに、強力な使い魔を用意したってことよ」"

#. Occurrence A_1:1199:14599: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_1_0007; voice_prefix=A30; voice_category=3; scene=A_1
#: A_1:1199
msgctxt "text_id=14599 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence A_1:1219:14600: scene=A_1
#: A_1:1219
msgctxt "text_id=14600 | speaker=unknown"
msgid "  The fight at the amusement park..."
msgstr "　遊園地での戦い。"

#. Occurrence A_1:1239:14601: scene=A_1
#: A_1:1239
msgctxt "text_id=14601 | speaker=unknown"
msgid "  Just the thought of Alice Kuonji releasing Flat Snark sent a shiver down Soujyuro's spine."
msgstr "　久遠寺有珠が解放したフラットスナークを思い出して、草十郎は息を呑む。"

#. Occurrence A_1:1244:14602: scene=A_1
#: A_1:1244
msgctxt "text_id=14602 | speaker=unknown"
msgid "  The Oil of the Moon had been a unique familiar, out of this world..."
msgstr "　あの月の油は特注も特注で、あれだけの使い魔は世界に二つとないという話だが―――"

#. Occurrence A_1:1290:14603: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0022; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1290
msgctxt "text_id=14603 | speaker=aoko"
msgid "\"Hey, don't worry about it. She couldn't create a familiar that could destroy Misaki or anything."
msgstr "「ほら、そこ心配しない、三咲町をぶっ壊す規模の使い魔なんてありっこないから。"

#. Occurrence A_1:1296:14604: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0023; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1296
msgctxt "text_id=14604 | speaker=aoko"
msgid "  Still, a familiar created with hair that long would be incredibly powerful.\""
msgstr "　たしかに長く歴史のある髪を使用するほど、強力な使い魔が出来上がる」"

#. Occurrence A_1:1323:14605: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0024; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1323
msgctxt "text_id=14605 | speaker=aoko"
msgid "\"Mages that use their hair though, they need to reset one of the three pillars from the beginning."
msgstr "「けど、髪を使った魔術師はそれまで溜めこんできた三柱のうちの一つを、初めからやり直さないといけない。"

#. Occurrence A_1:1329:14606: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0025; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1329
msgctxt "text_id=14606 | speaker=aoko"
msgid "  They have to grow their hair again. Making familiars is easy, but not leading them.\""
msgstr "　切った髪はまた伸ばさないといけないでしょ？　使い魔を造るのは簡単だけど、そう多く従えないのはそういう事なの」"

#. Occurrence A_1:1364:14607: scene=A_1
#: A_1:1364
msgctxt "text_id=14607 | speaker=unknown"
msgid "  As Aoko spoke, her mood visibly improved, as though she had made a breakthrough."
msgstr "　話しているうちに何かふっきれたのか、青子は上機嫌になりつつある。"

#. Occurrence A_1:1376:14608: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_1_0008; voice_prefix=A30; voice_category=3; scene=A_1
#: A_1:1376
msgctxt "text_id=14608 | speaker=soujuurou"
msgid "\"...Dogs and cats...\" "
msgstr "『……犬とか猫、か……』"

#. Occurrence A_1:1381:14609: scene=A_1
#: A_1:1381
msgctxt "text_id=14609 | speaker=unknown"
msgid "  tilting his head to the side."
msgstr "　一方、青子の話を聞いて首を傾げる草十郎。"

#. Occurrence A_1:1386:14610: scene=A_1
#: A_1:1386
msgctxt "text_id=14610 | speaker=unknown"
msgid "  He could not imagine a world where dogs and cats were so powerful."
msgstr "　彼の想像力では、どう考えても、犬と猫から強そうなイメージは生まれないようだ。"

#. Occurrence A_1:1419:14611: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0000; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1419
msgctxt "text_id=14611 | speaker=alice"
msgid "\"It's strange..."
msgstr "「……変ね。"

#. Occurrence A_1:1425:14612: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0001; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1425
msgctxt "text_id=14612 | speaker=alice"
msgid "  Touko is a puppet master. I wonder why she would lower herself to make familiars?\""
msgstr "　橙子さんは人形師よ。使い魔を造って自分のレベルを下げるのは、どうなのかしら」"

#. Occurrence A_1:1450:14613: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0026; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1450
msgctxt "text_id=14613 | speaker=aoko"
msgid "\"She probably has nobody to help her. And she wouldn't ask for assistance with a personal matter concerning the family.\""
msgstr "「協力者がいないだけでしょ。蒼崎のお家騒動に<他人|ひと>の手を借りたくないから、自分だけで全部やるつもりなのよ」"

#. Occurrence A_1:1477:14614: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0027; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1477
msgctxt "text_id=14614 | speaker=aoko"
msgid "\"Actually... maybe the puppet at the amusement park wasn't made from her hair.\""
msgstr "「あ……もしかして、遊園地の人形って姉貴の髪で造られたんじゃないだろうな……」"

#. Occurrence A_1:1501:14615: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0002; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1501
msgctxt "text_id=14615 | speaker=alice"
msgid "\"...Now that you mention it, you did say that it seemed highly customized."
msgstr "「……たしかに、話に聞いたかぎりだと特注品ね。"

#. Occurrence A_1:1507:14616: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0003; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1507
msgctxt "text_id=14616 | speaker=alice"
msgid "  Its curse-based perpetual-motion, coiled arms, Finn Shot, the depths of its obsession... It's unlikely Touko created the puppet from scratch.\""
msgstr "　呪いによる永久機関、両手のギミック、フィンの一撃、執念深さ。橙子さんでもゼロから造るのは難しいでしょうけど……」"

#. Occurrence A_1:1528:14617: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0028; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1528
msgctxt "text_id=14617 | speaker=aoko"
msgid "\"Meaning...?\" "
msgstr "「けど、なによ有珠？」"

#. Occurrence A_1:1561:14618: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0004; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1561
msgctxt "text_id=14618 | speaker=alice"
msgid "\"Touko's not the type to put herself into her creations."
msgstr "「……あの人は、人形に自己を投影するような人じゃないわ。"

#. Occurrence A_1:1567:14619: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0005; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1567
msgctxt "text_id=14619 | speaker=alice"
msgid "  She might consider doing it for a perfect replica, but the ones we destroyed weren't even faint copies of her."
msgstr "　完璧な偽物なら許すけど、偽物にすぎない偽物は容赦なく壊してきた。"

#. Occurrence A_1:1574:14620: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0006; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1574
msgctxt "text_id=14620 | speaker=alice"
msgid "Aoko, did that puppet have the same power as Touko?\""
msgstr "青子から見て、その特注人形は橙子さんと同じ力量を持っていた？」"

#. Occurrence A_1:1580:14621: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0029; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1580
msgctxt "text_id=14621 | speaker=aoko"
msgid "\"No way. Not even close.\""
msgstr "「……まさか。遠く及ばないわよ、あんなの」"

#. Occurrence A_1:1607:14622: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0007; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1607
msgctxt "text_id=14622 | speaker=alice"
msgid "\"Then it would not have been made using her hair."
msgstr "「なら橙子さんの髪と、あの人形は別件よ。"

#. Occurrence A_1:1613:14623: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0008; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1613
msgctxt "text_id=14623 | speaker=alice"
msgid "  Meaning we have to keep our eyes open for a familiar fused with her magical energy.\""
msgstr "　あの人が自分の魔力を分け与えたほどの使い魔が、あと一体はいると見るべきね」"

#. Occurrence A_1:1647:14624: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0030; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1647
msgctxt "text_id=14624 | speaker=aoko"
msgid "\"So in your expert opinion..."
msgstr "「……専門家としての意見？"

#. Occurrence A_1:1653:14625: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0031; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1653
msgctxt "text_id=14625 | speaker=aoko"
msgid "  ...you think that her familiar could be stronger than my sister herself?\""
msgstr "　つまり、その使い魔は<姉|・><貴|・><よ|・><り|・><強|・><い|・>？」"

#. Occurrence A_1:1671:14626: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0009; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1671
msgctxt "text_id=14626 | speaker=alice"
msgid "\"If it's not, then what's the point of creating one?"
msgstr "「そうでないと意味がないわ。"

#. Occurrence A_1:1677:14627: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0010; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1677
msgctxt "text_id=14627 | speaker=alice"
msgid "  She needs help. It's two of us versus one of her.\""
msgstr "　……人手が足りないというのもあるでしょうけど。だってわたしたちは二人、彼女は一人だもの」"

#. Occurrence A_1:1709:14628: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0032; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1709
msgctxt "text_id=14628 | speaker=aoko"
msgid "\"So she's going to attack with the familiar at the same time."
msgstr "「―――同時制圧も想定済みってワケ。"

#. Occurrence A_1:1715:14629: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0033; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1715
msgctxt "text_id=14629 | speaker=aoko"
msgid "  That makes sense. It would at least be a fair fight."
msgstr "　なるほどね。その場合、どっちが強い方を引き当てても恨みっこなしよ有珠。"

#. Occurrence A_1:1727:14630: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0034; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1727
msgctxt "text_id=14630 | speaker=aoko"
msgid "  Well, *fairer.* When it comes to familiars, I think you have the upper hand.\""
msgstr "　ま、こと使い魔でアンタが後れを取るとは思えないけど」"

#. Occurrence A_1:1757:14631: scene=A_1
#: A_1:1757
msgctxt "text_id=14631 | speaker=unknown"
msgid "  Alice had never been defeated by a familiar."
msgstr "　使い魔同士の戦いなら久遠寺有珠に敗北はない。"

#. Occurrence A_1:1762:14632: scene=A_1
#: A_1:1762
msgctxt "text_id=14632 | speaker=unknown"
msgid "  She sighed at Aoko's overconfidence."
msgstr "　そう楽観する青子に、有珠はため息まじりに忠告する。"

#. Occurrence A_1:1783:14633: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0011; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1783
msgctxt "text_id=14633 | speaker=alice"
msgid "\"Aoko, even if she utilizes her twenty-year stockpile, she can only use small animals as vessels."
msgstr "「青子。たとえ二十年間の蓄えを付与したとしても、その器が小動物では限度があるわ。"

#. Occurrence A_1:1789:14634: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0012; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1789
msgctxt "text_id=14634 | speaker=alice"
msgid "  If Touko was to prepare a familiar as her trump card...\""
msgstr "　あの橙子さんが切札になる使い魔を用意したのなら、それは」"

#. Occurrence A_1:1827:14635: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0035; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1827
msgctxt "text_id=14635 | speaker=aoko"
msgid "\"...Don't you say it."
msgstr "「……よしてよ。"

#. Occurrence A_1:1833:14636: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0036; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1833
msgctxt "text_id=14636 | speaker=aoko"
msgid "  No sister of mine would stoop that low.\""
msgstr "　いくらなんでも、姉貴はそこまで悪趣味じゃないわ」"

#. Occurrence A_1:1866:14637: scene=A_1
#: A_1:1866
msgctxt "text_id=14637 | speaker=unknown"
msgid "  Aoko and Alice stared at each other."
msgstr "　意味ありげに見つめ合うふたり。"

#. Occurrence A_1:1888:14638: scene=A_1
#: A_1:1888
msgctxt "text_id=14638 | speaker=unknown"
msgid "  The conversation had returned to the drawing room, but the subject matter was not for the faint of heart."
msgstr "　居間に会話が戻ってきた事は嬉しいが、不穏すぎるのも困りものだ。"

#. Occurrence A_1:1929:14639: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0013; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1929
msgctxt "text_id=14639 | speaker=alice"
msgid "\"I suppose. Still, nothing hunts down a human better than a human."
msgstr "「……そうね。けれど、人間を追いつめるのに最も効果的な相手は、やっぱり人間なのよ。"

#. Occurrence A_1:1935:14640: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_1_0014; voice_prefix=A40; voice_category=2; scene=A_1
#: A_1:1935
msgctxt "text_id=14640 | speaker=alice"
msgid "  Touko may not have raised the dead, but she probably has something just as powerful up her sleeve.\""
msgstr "　橙子さんが死者を亡者にしていなくても、それと同格の相手がいる、ぐらいは覚悟しておいて」"

#. Occurrence A_1:1958:14641: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0037; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:1958
msgctxt "text_id=14641 | speaker=aoko"
msgid "\"Yeah, yeah, okay. I admit geniuses can get stuck in their own world sometimes. Whatever corpse she throws at me, I'll be ready.\""
msgstr "「……はいはい、分かったわよ。たしかに天才ってヤツは空気読めないから。どんな生き物の死体を用意してきても驚かないわ」"

#. Occurrence A_1:1984:14642: scene=A_1
#: A_1:1984
msgctxt "text_id=14642 | speaker=unknown"
msgid "  Aoko nodded reluctantly at Alice's directness."
msgstr "　有珠の冷たい言葉に、青子は不本意そうに頷いた。"

#. Occurrence A_1:1989:14643: scene=A_1
#: A_1:1989
msgctxt "text_id=14643 | speaker=unknown"
msgid "  Needless to say, Soujyuro was completely lost."
msgstr "　言うまでもなく、草十郎にはちんぷんかんぷんである。"

#. Occurrence A_1:2026:14644: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_1_0009; voice_prefix=A30; voice_category=3; scene=A_1
#: A_1:2026
msgctxt "text_id=14644 | speaker=soujuurou"
msgid "\"Um... I don't quite follow."
msgstr "「……その、よく分からないけど。"

#. Occurrence A_1:2032:14645: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_1_0010; voice_prefix=A30; voice_category=3; scene=A_1
#: A_1:2032
msgctxt "text_id=14645 | speaker=soujuurou"
msgid "  Why're you both convinced the familiar is dead?\""
msgstr "　なんで蒼崎たちは死んでるって事に固執するんだ？　生きてる物じゃ駄目なのか？」"

#. Occurrence A_1:2062:14646: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0038; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:2062
msgctxt "text_id=14646 | speaker=aoko"
msgid "\"Because living partners aren't familiars; they're co-conspirators. Familiars can't live with a mage to sustain them."
msgstr "「それは使い魔じゃなくて協力者でしょ。使い魔は基本、術者なくしては生きられないものにしないと。"

#. Occurrence A_1:2068:14647: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0039; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:2068
msgctxt "text_id=14647 | speaker=aoko"
msgid "  Still, they're the perfect foil: strong-willed, and smart enough to compensate for their mage's shortcomings. Everything you'd want from a great familiar."
msgstr "　それでいて優れた<人格|いし>を持ち、術者の死角や盲点を補える知性もある―――それが一流の使い魔の条件よ。"

#. Occurrence A_1:2074:14648: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0040; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:2074
msgctxt "text_id=14648 | speaker=aoko"
msgid "  Let's be real. Who wouldn't want to bring that kind of partner back to life?\""
msgstr "　正直な話、それだけ都合のいいヤツは死から作り直すしかないってワケ」"

#. Occurrence A_1:2107:14649: scene=A_1
#: A_1:2107
msgctxt "text_id=14649 | speaker=unknown"
msgid "  Completely obedient, and capable of compensating for their mage's weaknesses..."
msgstr "　絶対服従でありながら、術者の死角……勘違いやドジをフォローする役回り。"

#. Occurrence A_1:2112:14650: scene=A_1
#: A_1:2112
msgctxt "text_id=14650 | speaker=unknown"
msgid "  Soujyuro felt that a familiar was little different than himself."
msgstr "　つまるところ、使い魔というのは今の自分とあんまり変わらない連中なのか、と草十郎は納得した。"

#. Occurrence A_1:2139:14651: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0041; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:2139
msgctxt "text_id=14651 | speaker=aoko"
msgid "\"Now then..."
msgstr "「……さて。"

#. Occurrence A_1:2145:14652: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0042; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:2145
msgctxt "text_id=14652 | speaker=aoko"
msgid "  My sister has always been a rune user, so we can somewhat predict her tactics."
msgstr "　姉貴は昔からルーン使いだったから戦術は予測できる。"

#. Occurrence A_1:2151:14653: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0043; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:2151
msgctxt "text_id=14653 | speaker=aoko"
msgid "  Her trump card, which we need to be worried about, is probably a familiar."
msgstr "　問題の切札もどうやら使い魔らしい。"

#. Occurrence A_1:2163:14654: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0044; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:2163
msgctxt "text_id=14654 | speaker=aoko"
msgid "  And it's likely she used up all of her automata already...\""
msgstr "　自動人形もさすがにこの前で使いきっただろうし……」"

#. Occurrence A_1:2169:14655: scene=A_1
#: A_1:2169
msgctxt "text_id=14655 | speaker=unknown"
msgid "  Aoko spoke directly to Alice, looking for confirmation."
msgstr "　確認するように言いながら、青子は有珠と視線を合わせた。"

#. Occurrence A_1:2174:14656: scene=A_1
#: A_1:2174
msgctxt "text_id=14656 | speaker=unknown"
msgid "  Alice nodded in agreement."
msgstr "　有珠は頷きだけで同意する。"

#. Occurrence A_1:2201:14657: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0045; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:2201
msgctxt "text_id=14657 | speaker=aoko"
msgid "\"So we stick to the plan. Let's call it a night."
msgstr "「じゃあ予定通り、今日で終わりにしよう。"

#. Occurrence A_1:2230:14658: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_1_0046; voice_prefix=A10; voice_category=1; scene=A_1
#: A_1:2230
msgctxt "text_id=14658 | speaker=aoko"
msgid "  I'm gonna make her pay for all the crap she's put us through for the last month!\""
msgstr "　この一ヶ月、好き放題やられた借り―――ぎったんぎったんにして、あのバカ姉貴に返してやる……！」"

#. Occurrence A_1:2236:14659: scene=A_1
#: A_1:2236
msgctxt "text_id=14659 | speaker=unknown"
msgid "  Aoko clenched teeth and balled her fists."
msgstr "　ぐっと握りこぶしを作る青子。"

#. Occurrence A_1:2241:14660: scene=A_1
#: A_1:2241
msgctxt "text_id=14660 | speaker=unknown"
msgid "  It all seemed like nothing more than sibling rivalry. In fact, that's probably all it was."
msgstr "　こうして見るとごく一般的な姉妹ゲンカにしか見えないのは、おそらく、本当に姉妹ゲンカにすぎないからだろう。"

#. Occurrence A_1:2280:14661: scene=A_1
#: A_1:2280
msgctxt "text_id=14661 | speaker=unknown"
msgid "  Looking at Aoko, Soujyuro let out a sigh of relief."
msgstr "　そんな青子の様子に、草十郎はそっと安堵の息をついた。"

#. Occurrence A_1:2285:14662: scene=A_1
#: A_1:2285
msgctxt "text_id=14662 | speaker=unknown"
msgid "  With what happened with Touko, and how they reacted to her visit, the atmosphere had been deathly tense."
msgstr "　先日やってきた橙子と、その後の青子たちの緊張感は、本気で殺し合うような空気だった。"

#. Occurrence A_1:2290:14663: scene=A_1
#: A_1:2290
msgctxt "text_id=14663 | speaker=unknown"
msgid "  For now though, Aoko seemed much calmer."
msgstr "　が、今の青子には、そんな凄惨さはまったくない。"

#. Occurrence A_1:2318:14664: scene=A_1
#: A_1:2318
msgctxt "text_id=14664 | speaker=unknown"
msgid "  He took comfort in the thought that perhaps the sisters would just bury the hatchet."
msgstr "　結局、刀はもとの鞘に戻るのだろうな、とぼんやりと考えて、草十郎は安心したのだ。"

#. Occurrence A_1:2323:14665: scene=A_1
#: A_1:2323
msgctxt "text_id=14665 | speaker=unknown"
msgid "  Even if Aoko and Touko were not sisters, he would not want to see what would happen if they fought."
msgstr "　青子と橙子。たとえ両者が赤の他人であったとしても、彼は彼女たちの争う姿は見たくはなかった。"

#. Occurrence A_1:2329:14666: scene=A_1
#: A_1:2329
msgctxt "text_id=14666 | speaker=unknown"
msgid "  The hands of the clock turned gently."
msgstr "　……時間は緩やかに過ぎていく。"

#. Occurrence A_1:2334:14667: scene=A_1
#: A_1:2334
msgctxt "text_id=14667 | speaker=unknown"
msgid "  approaching Judgment night, a merciless silence would soon come to mock Soujyuro's complacency."
msgstr "　青子の言う決着の夜―――彼の浅はかな間違いを正す、無慈悲な夜の静寂へと。"

#. Occurrence A_2:51:14668: scene=A_2
#: A_2:51
msgctxt "text_id=14668 | speaker=unknown"
msgid "  As night appeared, two things vanished."
msgstr "　夜の訪れと共に、二つのものが消え去った。"

#. Occurrence A_2:57:14669: scene=A_2
#: A_2:57
msgctxt "text_id=14669 | speaker=unknown"
msgid "  The first was the whimsical snowfall."
msgstr "　一つは気まぐれな<白雪|しらゆき>。"

#. Occurrence A_2:62:14670: scene=A_2
#: A_2:62
msgctxt "text_id=14670 | speaker=unknown"
msgid "  The second was the lights of the mansion on the top of the hill."
msgstr "　一つは、丘の上の洋館の明かりである。"

#. Occurrence A_2:108:14671: scene=A_2
#: A_2:108
msgctxt "text_id=14671 | speaker=unknown"
msgid "  Aoko and Alice were nowhere to be seen inside."
msgstr "　洋館に青子と有珠の姿はない。"

#. Occurrence A_2:113:14672: scene=A_2
#: A_2:113
msgctxt "text_id=14672 | speaker=unknown"
msgid "  Only Soujyuro remained."
msgstr "　残っているのは草十郎だけだ。"

#. Occurrence A_2:119:14673: scene=A_2
#: A_2:119
msgctxt "text_id=14673 | speaker=unknown"
msgid "  It was the night of Christmas Eve."
msgstr "　クリスマスイヴの夜。"

#. Occurrence A_2:124:14674: scene=A_2
#: A_2:124
msgctxt "text_id=14674 | speaker=unknown"
msgid "  Though Aoko and Alice had yet to find Touko, they knew everything would be concluded over the course of this day and the next."
msgstr "　いまだ橙子の隠れ家を見つけてはいないものの、彼女たちには今日と明日が決着の日だと判っていた。"

#. Occurrence A_2:170:14675: scene=A_2
#: A_2:170
msgctxt "text_id=14675 | speaker=unknown"
msgid "  Christmas comes but once a year."
msgstr "　祭りとは日常の中の非日常だ。"

#. Occurrence A_2:175:14676: scene=A_2
#: A_2:175
msgctxt "text_id=14676 | speaker=unknown"
msgid "  It was a singular time for endings and new beginnings."
msgstr "　終わり、蘇り、やり直しを象徴する特異点である。"

#. Occurrence A_2:180:14677: scene=A_2
#: A_2:180
msgctxt "text_id=14677 | speaker=unknown"
msgid "  In Japan, the modern holiday dated back only about a hundred years, and celebrated Christ's birth only in name-with all its latter-day trappings, it was neither a pure homage nor corruption of the festival that inspired it."
msgstr "　<聖誕祭|クリスマス>など百年程度の歴史しかなく、形骸的な記念日にすぎないとしても、営みの<環|わ>に組みこまれているのなら偽物も本物もない。"

#. Occurrence A_2:185:14678: scene=A_2
#: A_2:185
msgctxt "text_id=14678 | speaker=unknown"
msgid "  Regardless, there was a significant increase in the land's mana during festivals."
msgstr "　祭りにおいて、土地の<魔|マ><力|ナ>の増大は<著|いちじる>しい。"

#. Occurrence A_2:190:14679: scene=A_2
#: A_2:190
msgctxt "text_id=14679 | speaker=unknown"
msgid "  Such charged distortions were a boon to a mage's craft, be it creative or destructive."
msgstr "　造るにしろ壊すにしろ、蓄えられてきた歪みは術者の魔術行使を助けるだろう。"

#. Occurrence A_2:237:14680: scene=A_2
#: A_2:237
msgctxt "text_id=14680 | speaker=unknown"
msgid "  Touko Aozaki sought to destroy the local sigils, which gathered and properly cycled the magical energy of the land and its people."
msgstr "　蒼崎橙子はこの土地に造られた支点……土地、人々からの魔力を集め、正しく循環させている……を壊そうとしている。"

#. Occurrence A_2:243:14681: scene=A_2
#: A_2:243
msgctxt "text_id=14681 | speaker=unknown"
msgid "  Soujyuro was able to gather that much from Aoko and Alice's conversation."
msgstr "　草十郎もそれぐらいは青子たちの会話から聞き取っていた。"

#. Occurrence A_2:248:14682: scene=A_2
#: A_2:248
msgctxt "text_id=14682 | speaker=unknown"
msgid "  Touko had already claimed three sigils."
msgstr "　五ヶ所にある支点のうち三つは既に破壊され、橙子の手に渡っている。"

#. Occurrence A_2:294:14683: scene=A_2
#: A_2:294
msgctxt "text_id=14683 | speaker=unknown"
msgid "  Only two remained."
msgstr "　残るは二ヶ所。"

#. Occurrence A_2:299:14684: scene=A_2
#: A_2:299
msgctxt "text_id=14684 | speaker=unknown"
msgid "  Any further loss would signal Aoko and Alice's defeat."
msgstr "　これ以上の破壊は青子たちの敗北を意味する。"

#. Occurrence A_2:304:14685: scene=A_2
#: A_2:304
msgctxt "text_id=14685 | speaker=unknown"
msgid "  In order to protect the remaining ones, they had to split up."
msgstr "　青子と有珠は残った支点を守るため、別行動を取らざるをえない。"

#. Occurrence A_2:309:14686: scene=A_2
#: A_2:309
msgctxt "text_id=14686 | speaker=unknown"
msgid "  Aoko lacked power, so she would need to borrow a Ploy from Alice and head to the Toukawa sigil, which boasted the greatest local energy supply."
msgstr "　力量的に劣る青子は、有珠の<使い魔|プロイ>を一体借り受け、最高の<魔力提供|バックアップ>を誇る陶川の支点に。"

#. Occurrence A_2:314:14687: scene=A_2
#: A_2:314
msgctxt "text_id=14687 | speaker=unknown"
msgid "  Alice would go fully equipped to the sigil in Yashirogi."
msgstr "　有珠は万全の装備で<社木|やしろぎ>の支点へ。"

#. Occurrence A_2:360:14688: scene=A_2
#: A_2:360
msgctxt "text_id=14688 | speaker=unknown"
msgid "  Free from the constraints of civilized society,"
msgstr "　文明社会のくびきから逃れ、"

#. Occurrence A_2:365:14689: scene=A_2
#: A_2:365
msgctxt "text_id=14689 | speaker=unknown"
msgid "  magecraft is most powerful at midnight."
msgstr "　魔術が最大限の威力を発揮する深夜。"

#. Occurrence A_2:371:14690: scene=A_2
#: A_2:371
msgctxt "text_id=14690 | speaker=unknown"
msgid "  The young witch and the apprentice mage wished each other luck, before leaving the mansion."
msgstr "　幼い魔女と魔法使い見習いは、互いの健闘を祈って洋館を後にした。"

#. Occurrence A_2:405:14691: scene=A_2
#: A_2:405
msgctxt "text_id=14691 | speaker=unknown"
msgid "  It was almost ten at night."
msgstr "　時刻はじき午後十時になろうとしている。"

#. Occurrence A_2:410:14692: scene=A_2
#: A_2:410
msgctxt "text_id=14692 | speaker=unknown"
msgid "  After the girls set out, the first two hours passed quickly."
msgstr "　彼女たちが出立してから、早い事に二時間は経っていた。"

#. Occurrence A_2:461:14693: scene=A_2
#: A_2:461
msgctxt "text_id=14693 | speaker=unknown"
msgid "  When Aoko was ready to head off, Soujyuro walked with her to the foyer."
msgstr "　青子が陶川の支点に向かう時、草十郎はロビーまで見送った。"

#. Occurrence A_2:466:14694: scene=A_2
#: A_2:466
msgctxt "text_id=14694 | speaker=unknown"
msgid "  Neither had spoken a word to each other."
msgstr "　草十郎に話はなかったし、青子にだって話はなかった。"

#. Occurrence A_2:471:14695: scene=A_2
#: A_2:471
msgctxt "text_id=14695 | speaker=unknown"
msgid "  She had departed without showing any sign of fear."
msgstr "　<悲壮|ひそう>な空気もなく、青子は<颯爽|さっそう>と出ていった。"

#. Occurrence A_2:476:14696: scene=A_2
#: A_2:476
msgctxt "text_id=14696 | speaker=unknown"
msgid "  It was difficult to tell whether she did not want to get him involved, or whether she did not see him a worthy ally in combat."
msgstr "　宣言した通り、青子は草十郎を関わらせる気はないのか、それとも戦力と見ていないのか。"

#. Occurrence A_2:489:14697: scene=A_2
#: A_2:489
msgctxt "text_id=14697 | speaker=unknown"
msgid "  The thought stuck with him."
msgstr "　どうしてか、それが少しだけ胸に残った。"

#. Occurrence A_2:535:14698: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_2_0000; voice_prefix=A30; voice_category=3; scene=A_2
#: A_2:535
msgctxt "text_id=14698 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence A_2:541:14699: scene=A_2
#: A_2:541
msgctxt "text_id=14699 | speaker=unknown"
msgid "  He let out a long sigh."
msgstr "　大きく息を吐く。"

#. Occurrence A_2:546:14700: scene=A_2
#: A_2:546
msgctxt "text_id=14700 | speaker=unknown"
msgid "  Not out of dejection or frustration."
msgstr "　<落胆|らくたん>でも<焦燥|しょうそう>でもない。"

#. Occurrence A_2:551:14701: scene=A_2
#: A_2:551
msgctxt "text_id=14701 | speaker=unknown"
msgid "  It was a mechanical, emotionless breath."
msgstr "　機械的な、これといった<感|い><情|み>のない息継ぎだ。"

#. Occurrence A_2:583:14702: scene=A_2
#: A_2:583
msgctxt "text_id=14702 | speaker=unknown"
msgid "  He sat on the near-frozen floor, staring vacantly up at the skylight."
msgstr "　張りつくような冷たさの床に座りこんで、草十郎はぼんやりと天窓を見上げる。"

#. Occurrence A_2:603:14703: scene=A_2
#: A_2:603
msgctxt "text_id=14703 | speaker=unknown"
msgid "  Moonlight peaked through the clouds."
msgstr "　切り取られた空からは、雲間から覗く月の光。"

#. Occurrence A_2:608:14704: scene=A_2
#: A_2:608
msgctxt "text_id=14704 | speaker=unknown"
msgid "  He imagined the moonlight bouncing off the town's powdery blanket and illuminating the night."
msgstr "　町に降り積もった雪は月光を照り返して、夜を真白に照らしているのだろう。"

#. Occurrence A_2:613:14705: scene=A_2
#: A_2:613
msgctxt "text_id=14705 | speaker=unknown"
msgid "  But he would not find himself downtown."
msgstr "　その町中に、彼が立つ事はない。"

#. Occurrence A_2:618:14706: scene=A_2
#: A_2:618
msgctxt "text_id=14706 | speaker=unknown"
msgid "  Watching from the sidelines was his role to begin with."
msgstr "　当然のように、初めから関わる事はない。"

#. Occurrence A_2:638:14707: scene=A_2
#: A_2:638
msgctxt "text_id=14707 | speaker=unknown"
msgid "  His roommates and he lived worlds apart."
msgstr "　彼女たちの世界と彼の世界は違っている。"

#. Occurrence A_2:643:14708: scene=A_2
#: A_2:643
msgctxt "text_id=14708 | speaker=unknown"
msgid "  He could not keep up with them, and if he did not show the same kind of will, he would remain on the sidelines."
msgstr "　ついていく事はできないし、彼にその意志も意義も思いつかないのなら、あとは<傍観|ぼうかん>するだけだ。"

#. Occurrence A_2:648:14709: scene=A_2
#: A_2:648
msgctxt "text_id=14709 | speaker=unknown"
msgid "  However..."
msgstr "　ただ、"

#. Occurrence A_2:666:14710: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_2_0001; voice_prefix=A30; voice_category=3; scene=A_2
#: A_2:666
msgctxt "text_id=14710 | speaker=soujuurou"
msgid "\"I get it."
msgstr "「―――そうか。"

#. Occurrence A_2:673:14711: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_2_0002; voice_prefix=A30; voice_category=3; scene=A_2
#: A_2:673
msgctxt "text_id=14711 | speaker=soujuurou"
msgid "I'm not needed anymore.\""
msgstr "この手が必要な時は、もうないのか」"

#. Occurrence A_2:678:14712: scene=A_2
#: A_2:678
msgctxt "text_id=14712 | speaker=unknown"
msgid "  Soujyuro looked up at the moon."
msgstr "　独白して月を見上げる。"

#. Occurrence A_2:731:14713: scene=A_2
#: A_2:731
msgctxt "text_id=14713 | speaker=unknown"
msgid "  Somewhere deep inside, he felt a trickle of sadness."
msgstr "　だから、それが少しだけ、悲しかった。"

#. Occurrence A_3:72:14714: scene=A_3
#: A_3:72
msgctxt "text_id=14714 | speaker=unknown"
msgid "  Veiled in white and cloaked in darkness, the park seemed like a forgotten memory."
msgstr "　その公園は、人々の記憶から忘却されたかのように、白い闇に沈んでいた。"

#. Occurrence A_3:77:14715: scene=A_3
#: A_3:77
msgctxt "text_id=14715 | speaker=unknown"
msgid "  Not a soul was in sight."
msgstr "　人の気配は完全に絶えている。"

#. Occurrence A_3:82:14716: scene=A_3
#: A_3:82
msgctxt "text_id=14716 | speaker=unknown"
msgid "  The night felt far more enigmatic than usual, yet the air was clean enough to drink."
msgstr "　夜は普段より何倍も深く得体が知れないが、同時に、息を呑むほど清潔だ。"

#. Occurrence A_3:88:14717: scene=A_3
#: A_3:88
msgctxt "text_id=14717 | speaker=unknown"
msgid "  Though only a sliver of moonlight peered through the clouds, it lit up the entire world."
msgstr "　雲間から届くかすかな月光だけで、世界のすべてを見渡せるほどに。"

#. Occurrence A_3:121:14718: scene=A_3
#: A_3:121
msgctxt "text_id=14718 | speaker=unknown"
msgid "  In those moments, a young girl's footsteps echoed,"
msgstr "　そんな束の間の永遠に、少女の足音が響いていく。"

#. Occurrence A_3:134:14719: scene=A_3
#: A_3:134
msgctxt "text_id=14719 | speaker=unknown"
msgid "  trampling the still white silence under a midnight sun."
msgstr "　<無|む><垢|く>の<白野|ビャクヤ>に、<静寂|シジマ>を踏む靴がひとつ。"

#. Occurrence A_3:139:14720: scene=A_3
#: A_3:139
msgctxt "text_id=14720 | speaker=unknown"
msgid "  The pale moon illuminated the inky blue sky."
msgstr "　夜空には蒼い闇夜と<薄墨|うすずみ>の月。"

#. Occurrence A_3:144:14721: scene=A_3
#: A_3:144
msgctxt "text_id=14721 | speaker=unknown"
msgid "  Only a few streetlights and an incongruous phone booth betrayed signs of civilization."
msgstr "　少しばかりの街灯と、場違いな電話ボックスだけが、いまは文明の名残だった。"

#. Occurrence A_3:187:14722: scene=A_3
#: A_3:187
msgctxt "text_id=14722 | speaker=unknown"
msgid "  A girl appeared, dressed in black."
msgstr "　現れたのは黒衣の少女。"

#. Occurrence A_3:198:14723: scene=A_3
#: A_3:198
msgctxt "text_id=14723 | speaker=unknown"
msgid "  Against the snowy landscape, the figure of Alice Kuonji was unmistakable."
msgstr "　雪原で浮き彫りになる姿は、紛れもなく久遠寺有珠だ。"

#. Occurrence A_3:203:14724: scene=A_3
#: A_3:203
msgctxt "text_id=14724 | speaker=unknown"
msgid "  Pure black, deeper than even the night,"
msgstr "　<外套|がいとう>、帽子、手袋。"

#. Occurrence A_3:208:14725: scene=A_3
#: A_3:208
msgctxt "text_id=14725 | speaker=unknown"
msgid "  were her overcoat, gloves, and hat-even her hair and eyes."
msgstr "　その全てが黒く、瞳と髪すら、闇より深い<藍色|やみいろ>に染められている。"

#. Occurrence A_3:228:14726: scene=A_3
#: A_3:228
msgctxt "text_id=14726 | speaker=unknown"
msgid "  Nothing stirred, for a time..."
msgstr "　変化は長く訪れなかった。"

#. Occurrence A_3:233:14727: scene=A_3
#: A_3:233
msgctxt "text_id=14727 | speaker=unknown"
msgid "  Not Alice, nor the white scenery."
msgstr "　有珠にも、その白い風景にも。"

#. Occurrence A_3:238:14728: scene=A_3
#: A_3:238
msgctxt "text_id=14728 | speaker=unknown"
msgid "  The world was a still painting of a snowy field."
msgstr "　雪原にたたずむ姿は一枚の絵画のように。"

#. Occurrence A_3:243:14729: scene=A_3
#: A_3:243
msgctxt "text_id=14729 | speaker=unknown"
msgid "  Only time moved, gradually darkening the lights in the park, and eventually the nearby homes as well."
msgstr "　時間だけが過ぎ、公園の周囲から、かろうじてあった家々の明かりが消えていく。"

#. Occurrence A_3:289:14730: scene=A_3
#: A_3:289
msgctxt "text_id=14730 | speaker=unknown"
msgid "  Yashirogi was a more modern and developed town than Misaki."
msgstr "　ここ<社木|やしろぎ>は三咲町より近代化の進んだ街だ。"

#. Occurrence A_3:296:14731: scene=A_3
#: A_3:296
msgctxt "text_id=14731 | speaker=unknown"
msgid "  Though the park was located in the center of town, it had become a blind spot."
msgstr "　公園はそんな街のただ中にありながら、街の死角になっていた。"

#. Occurrence A_3:303:14732: scene=A_3
#: A_3:303
msgctxt "text_id=14732 | speaker=unknown"
msgid "  It had been overlooked by developers, and carried no commercial value."
msgstr "　開発につまはじきにされた、利用価値のない土地。"

#. Occurrence A_3:310:14733: scene=A_3
#: A_3:310
msgctxt "text_id=14733 | speaker=unknown"
msgid "  A few houses encircled the park. The street lights turned off at midnight."
msgstr "　周囲に住宅は少なく、道を照らす街灯も、深夜になれば明かりを落とす。"

#. Occurrence A_3:330:14734: scene=A_3
#: A_3:330
msgctxt "text_id=14734 | speaker=unknown"
msgid "  It was a white night. People-even machines-were fast asleep."
msgstr "　そんな、人々だけでなく機械すら眠りについた白い夜。"

#. Occurrence A_3:356:14735: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_3_0000; voice_prefix=A40; voice_category=2; scene=A_3
#: A_3:356
msgctxt "text_id=14735 | speaker=alice"
msgid "\"It looks like I got here early.\""
msgstr "『……わたしが、先なのね』"

#. Occurrence A_3:367:14736: scene=A_3
#: A_3:367
msgctxt "text_id=14736 | speaker=unknown"
msgid "  Alice whispered, watching the streetlights slowly fade."
msgstr "　消えていく灯を見つめながら、有珠は静かに呟いた。"

#. Occurrence A_3:388:14737: scene=A_3
#: A_3:388
msgctxt "text_id=14737 | speaker=unknown"
msgid "  She thought she heard a dog howling in the distance."
msgstr "　どこか遠くで、犬の遠吠えが聞こえた気がする。"

#. Occurrence A_3:417:14738: scene=A_3
#: A_3:417
msgctxt "text_id=14738 | speaker=unknown"
msgid "  Perhaps it was howling at the moon."
msgstr "　月にでも吠えたのだろうか。"

#. Occurrence A_3:422:14739: scene=A_3
#: A_3:422
msgctxt "text_id=14739 | speaker=unknown"
msgid "  The howl reached deeper into the night than expected. A wolf, maybe?"
msgstr "　それは犬というより狼めいた強さで、長く長く、夜空に立ち上っていった。"

#. Occurrence A_3:464:14740: scene=A_3
#: A_3:464
msgctxt "text_id=14740 | speaker=unknown"
msgid "  The phone rang."
msgstr "　電話が鳴った。"

#. Occurrence A_3:469:14741: scene=A_3
#: A_3:469
msgctxt "text_id=14741 | speaker=unknown"
msgid "  It was perhaps the first time it had hung since Soujyuro moved into the mansion."
msgstr "　草十郎が洋館に住みだして、おそらく初めてになる電話の音は、深夜のホールに寒々しく響き渡った。"

#. Occurrence A_3:501:14742: scene=A_3
#: A_3:501
msgctxt "text_id=14742 | speaker=unknown"
msgid "  Hesitantly, he picked up the receiver and brought it to his ear."
msgstr "　草十郎はためらいがちに受話器をとる。"

#. Occurrence A_3:506:14743: scene=A_3
#: A_3:506
msgctxt "text_id=14743 | speaker=unknown"
msgid "  He heard nothing."
msgstr "　受話器からの<音|こえ>はない。"

#. Occurrence A_3:511:14744: scene=A_3
#: A_3:511
msgctxt "text_id=14744 | speaker=unknown"
msgid "  He felt he had to say something, but could not think what."
msgstr "　仕方なく何か言おうとして、ハタ、と草十郎は考えこんだ。"

#. Occurrence A_3:516:14745: scene=A_3
#: A_3:516
msgctxt "text_id=14745 | speaker=unknown"
msgid "  Maybe something like, \"Hello? Kuonji residence!\""
msgstr "『もしもし、久遠寺ですが』と言えばいいのか、"

#. Occurrence A_3:521:14746: scene=A_3
#: A_3:521
msgctxt "text_id=14746 | speaker=unknown"
msgid "  Or maybe, \"You've reached the Aozaki residence\"?"
msgstr "　それとも『はい、蒼崎ですが』と言えばいいのか。"

#. Occurrence A_3:526:14747: scene=A_3
#: A_3:526
msgctxt "text_id=14747 | speaker=unknown"
msgid "  While he was deep in thought, a voice as light as air came through the receiver."
msgstr "　そんな事を真剣に悩んでいると、受話器ごしに、消えそうなほど細い声が届けられた。"

#. Occurrence A_3:559:14748: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_3_0001; voice_prefix=A40; voice_category=2; scene=A_3
#: A_3:559
msgctxt "text_id=14748 | speaker=alice"
msgid "\"Sizuki...?\""
msgstr "「……静希……君？」"

#. Occurrence A_3:565:14749: scene=A_3
#: A_3:565
msgctxt "text_id=14749 | speaker=unknown"
msgid "  Soujyuro could barely hear the voice, but it was definitely Alice's."
msgstr "　かすれてはいるが、間違いなく久遠寺有珠の声だ。"

#. Occurrence A_3:597:14750: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_3_0000; voice_prefix=A30; voice_category=3; scene=A_3
#: A_3:597
msgctxt "text_id=14750 | speaker=soujuurou"
msgid "\"Yes. Is that you, Alice?\""
msgstr "「そうだけど、有珠？」"

#. Occurrence A_3:603:14751: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_3_0002; voice_prefix=A40; voice_category=2; scene=A_3
#: A_3:603
msgctxt "text_id=14751 | speaker=alice"
msgid "\"...\""
msgstr "「………………………………………………」"

#. Occurrence A_3:608:14752: scene=A_3
#: A_3:608
msgctxt "text_id=14752 | speaker=unknown"
msgid "  No response."
msgstr "　草十郎の声に、有珠は<応|こた>えない。"

#. Occurrence A_3:613:14753: scene=A_3
#: A_3:613
msgctxt "text_id=14753 | speaker=unknown"
msgid "  The silence was as profound as the night,"
msgstr "　……深い闇のような沈黙。"

#. Occurrence A_3:618:14754: scene=A_3
#: A_3:618
msgctxt "text_id=14754 | speaker=unknown"
msgid "  but for the sound of static from the receiver."
msgstr "　ただ、受話器の向こうは騒がしく、雑踏めいたノイズに満ちている。"

#. Occurrence A_3:624:14755: scene=A_3
#: A_3:624
msgctxt "text_id=14755 | speaker=unknown"
msgid "  After a long pause, Alice finally spoke."
msgstr "　長い沈黙の後、ようやく有珠は声を出した。"

#. Occurrence A_3:645:14756: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_3_0003; voice_prefix=A40; voice_category=2; scene=A_3
#: A_3:645
msgctxt "text_id=14756 | speaker=alice"
msgid "\"Is Aoko there...?\""
msgstr "「青子は、いる……？」"

#. Occurrence A_3:662:14757: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_3_0001; voice_prefix=A30; voice_category=3; scene=A_3
#: A_3:662
msgctxt "text_id=14757 | speaker=soujuurou"
msgid "\"No, she hasn't come back yet.\""
msgstr "「いや、まだ帰ってないけど」"

#. Occurrence A_3:668:14758: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_3_0004; voice_prefix=A40; voice_category=2; scene=A_3
#: A_3:668
msgctxt "text_id=14758 | speaker=alice"
msgid "\"I see.\""
msgstr "「―――そう」"

#. Occurrence A_3:675:14759: scene=A_3
#: A_3:675
msgctxt "text_id=14759 | speaker=unknown"
msgid "  With a click, the call ended."
msgstr "　がしゃり、と電話は切れてしまった。"

#. Occurrence A_3:680:14760: scene=A_3
#: A_3:680
msgctxt "text_id=14760 | speaker=unknown"
msgid "  Soujyuro wondered if she had had something to say, but could not respond in time."
msgstr "　何が言いたかったんだろう、と草十郎はひとり考えこんだが、答えはついにでなかった。"

#. Occurrence A_4:75:14761: scene=A_4
#: A_4:75
msgctxt "text_id=14761 | speaker=unknown"
msgid "  Slowly they advanced,"
msgstr "　降り積もった雪を汚すように、"

msgctxt "text_id=14762 | speaker=unknown"
msgid "  carving through the fresh snow."
msgstr "　<彼|・><ら|・>はゆっくりと、その包囲の輪を狭めていく。"

#. Occurrence A_4:98:14763: scene=A_4
#: A_4:98
msgctxt "text_id=14763 | speaker=unknown"
msgid "  There were so many. Where had they all come from?"
msgstr "　いつの間にこれほどの数が集まったのか。"

#. Occurrence A_4:103:14764: scene=A_4
#: A_4:103
msgctxt "text_id=14764 | speaker=unknown"
msgid "  Dozens of feral dogs snarled at Alice, their eyes trained on her."
msgstr "　公園には何十匹もの野犬が<群|むら>がり、<荒|あら>い呼吸で有珠を凝視していた。"

#. Occurrence A_4:124:14765: scene=A_4
#: A_4:124
msgctxt "text_id=14765 | speaker=unknown"
msgid "  The snow clung to the beasts' mangy fur."
msgstr "　野犬たちの体は寒さに凍えて、どれもみすぼらしい。"

#. Occurrence A_4:129:14766: scene=A_4
#: A_4:129
msgctxt "text_id=14766 | speaker=unknown"
msgid "  Their clenched fangs and bloodshot eyes hid a barely-reined hunger that might burst forth like lightning at any moment."
msgstr "　反して、かちかちと鳴る牙と血走った眼は、今にも稲妻のように走りだしそうだ。"

#. Occurrence A_4:134:14767: scene=A_4
#: A_4:134
msgctxt "text_id=14767 | speaker=unknown"
msgid "  They yearned to taste her warm flesh, and satiate their empty bellies."
msgstr "　その飢えた腹を満たすために、目前のか弱い少女の、あまりにも食欲をそそる温かな腹の肉へ。"

#. Occurrence A_4:139:14768: scene=A_4
#: A_4:139
msgctxt "text_id=14768 | speaker=unknown"
msgid "  To them, the girl in black stood like a lighthouse in a stormy sea."
msgstr "　彼らにとって、黒衣の少女は暗い海に立つ<灯台|きぼう>にさえ見えている。"

#. Occurrence A_4:206:14769: scene=A_4
#: A_4:206
msgctxt "text_id=14769 | speaker=unknown"
msgid "  She watched them, disinterested."
msgstr "　そんな光景を、有珠は遠い目で眺めていた。"

#. Occurrence A_4:211:14770: scene=A_4
#: A_4:211
msgctxt "text_id=14770 | speaker=unknown"
msgid "  It appeared that the Yashirogi sigil was the key target tonight, not Toukawa where Aoko had gone."
msgstr "　青子が行った陶川ではなく、ここ社木が今夜の本命であるらしい。"

#. Occurrence A_4:216:14771: scene=A_4
#: A_4:216
msgctxt "text_id=14771 | speaker=unknown"
msgid "  Alice had always been unflappable, and the child's play before her was hardly about to change that."
msgstr "　それに動じるような心構えは初めからしていないし、この程度の脅しでは予想外どころか子供<騙|だま>しにもならない。"

#. Occurrence A_4:221:14772: scene=A_4
#: A_4:221
msgctxt "text_id=14772 | speaker=unknown"
msgid "  Her main enemy was not the dogs surrounding her, but the lone mage behind them: Touko Aozaki."
msgstr "　有珠が見すえるべき敵は包囲する野犬ではなく、その後方の闇に<控|ひか>える魔術師―――蒼崎橙子に他ならないのだから。"

#. Occurrence A_4:265:14773: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0000; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:265
msgctxt "text_id=14773 | speaker=alice"
msgid "\"What hideous taste. Is this what you've fallen to, after these last several years?"
msgstr "「酷い趣味。ここ数年で品が落ちたの？"

#. Occurrence A_4:272:14774: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0001; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:272
msgctxt "text_id=14774 | speaker=alice"
msgid "  Not that I'm complaining. If this is who you really are, then Aozaki and I have nothing to worry about.\""
msgstr "　……まあ、それならそれで嬉しいけど。コレが<地金|じがね>なら、蒼崎との付き合いもいよいよ白紙に戻せるわ」"

#. Occurrence A_4:277:14775: scene=A_4
#: A_4:277
msgctxt "text_id=14775 | speaker=unknown"
msgid "  Touko laughed at the acerbic taunt."
msgstr "　<辛辣|しんらつ>な言葉に、くぐもった笑いが応える。"

#. Occurrence A_4:283:14776: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0000; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:283
msgctxt "text_id=14776 | speaker=touko"
msgid "\"My, my. Such immovable spirit."
msgstr "「いやいや、コレは不可抗力でね。"

#. Occurrence A_4:290:14777: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0001; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:290
msgctxt "text_id=14777 | speaker=touko"
msgid "  Rest assured, Alice. I'm not doing this for fun.\""
msgstr "　安心しろ有珠、間違っても私の趣味じゃあない」"

#. Occurrence A_4:322:14778: scene=A_4
#: A_4:322
msgctxt "text_id=14778 | speaker=unknown"
msgid "  Crunching through the fallen snow, Touko slowly came into view."
msgstr "　ざくり、と積もった雪を踏みしめて、彼女はゆっくりと現れた。"

#. Occurrence A_4:341:14779: scene=A_4
#: A_4:341
msgctxt "text_id=14779 | speaker=unknown"
msgid "  She wore a moss-green coat that contrasted sharply with Alice's garb."
msgstr "　有珠とは対照的なモスグリーンのコート。"

#. Occurrence A_4:346:14780: scene=A_4
#: A_4:346
msgctxt "text_id=14780 | speaker=unknown"
msgid "  A silk scarf warmed her neck."
msgstr "　首もとを結ぶ<絹|シルク>のスカーフ。"

#. Occurrence A_4:351:14781: scene=A_4
#: A_4:351
msgctxt "text_id=14781 | speaker=unknown"
msgid "  She stood tall, her hair short, striking a more valiant posture than any young man."
msgstr "　長身と短い髪、そして<凛|りん>とした背筋が、男性より遥かに彼女を<雄|おす>らしく見せている。"

#. Occurrence A_4:371:14782: scene=A_4
#: A_4:371
msgctxt "text_id=14782 | speaker=unknown"
msgid "  After all..."
msgstr "　―――そう。"

#. Occurrence A_4:413:14783: scene=A_4
#: A_4:413
msgctxt "text_id=14783 | speaker=unknown"
msgid "  The two standing here needed to be less like the shining moon,"
msgstr "　この雪原に立つ者は、白い夜気より深い闇を纏っていなくてはならない。"

#. Occurrence A_4:449:14784: scene=A_4
#: A_4:449
msgctxt "text_id=14784 | speaker=unknown"
msgid "  and more like the darkness surrounding it."
msgstr "　有珠がそうであるように、その敵である橙子もまた。"

#. Occurrence A_4:470:14785: scene=A_4
#: A_4:470
msgctxt "text_id=14785 | speaker=unknown"
msgid "  The barking abated."
msgstr "　野犬たちの呼吸が弱まる。"

#. Occurrence A_4:475:14786: scene=A_4
#: A_4:475
msgctxt "text_id=14786 | speaker=unknown"
msgid "  Like servants in a royal court, they averted their eyes from their ruler,"
msgstr "　<端役|はやく>にすぎない彼らは、登場した主役の威光から目を逸らす。"

#. Occurrence A_4:482:14787: scene=A_4
#: A_4:482
msgctxt "text_id=14787 | speaker=unknown"
msgid "  lest their eyes and hearts be plucked out."
msgstr "　そうしなければ、眼球ばかりか心臓まで<潰|つぶ>されるからだ。"

#. Occurrence A_4:521:14788: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0002; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:521
msgctxt "text_id=14788 | speaker=touko"
msgid "\"It's been too long, Alice.\""
msgstr "「久しぶりだね、有珠」"

#. Occurrence A_4:527:14789: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0002; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:527
msgctxt "text_id=14789 | speaker=alice"
msgid "\"It has. You look well, Touko.\""
msgstr "「橙子さんも、お元気そうで」"

#. Occurrence A_4:546:14790: scene=A_4
#: A_4:546
msgctxt "text_id=14790 | speaker=unknown"
msgid "  They stood about twelve feet apart."
msgstr "　六メートルほどの距離を隔てた挨拶。"

#. Occurrence A_4:551:14791: scene=A_4
#: A_4:551
msgctxt "text_id=14791 | speaker=unknown"
msgid "  No love had been lost between them."
msgstr "　親愛の情はない。"

#. Occurrence A_4:556:14792: scene=A_4
#: A_4:556
msgctxt "text_id=14792 | speaker=unknown"
msgid "  Just two enemies―one who was to be victorious, and one who was to fall."
msgstr "　あるのは倒す者と倒される者、その区分だけである。"

#. Occurrence A_4:577:14793: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0003; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:577
msgctxt "text_id=14793 | speaker=touko"
msgid "\"So, how shall we do this, Alice?"
msgstr "「さて。どうしようか有珠？"

#. Occurrence A_4:603:14794: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0004; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:603
msgctxt "text_id=14794 | speaker=touko"
msgid "  We have so much to catch up on. How have you been? There's so much I've been dying to tell you."
msgstr "　積もる話もある。君の近況にも興味がある。そもそも今回の件について、色々と説明したくてたまらない。"

#. Occurrence A_4:617:14795: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0005; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:617
msgctxt "text_id=14795 | speaker=touko"
msgid "  You can spare five minutes to chat, can't you?\""
msgstr "　五分ほど時間を割いても構わないか？」"

#. Occurrence A_4:630:14796: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0003; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:630
msgctxt "text_id=14796 | speaker=alice"
msgid "\"I'm afraid not. If I give you even the slightest quarter, you will steal it all.\""
msgstr "「お断りよ。貴女と五分も話をしていたら、その隙に内臓まで売却されそう」"

#. Occurrence A_4:678:14797: scene=A_4
#: A_4:678
msgctxt "text_id=14797 | speaker=unknown"
msgid "  The following events unfolded quickly."
msgstr "　それは一瞬の出来事。"

#. Occurrence A_4:693:14798: scene=A_4
#: A_4:693
msgctxt "text_id=14798 | speaker=unknown"
msgid "  Boldly and without a second's thought,"
msgstr "　あまりにも自然に、目を奪うほど大胆に、"

#. Occurrence A_4:698:14799: scene=A_4
#: A_4:698
msgctxt "text_id=14799 | speaker=unknown"
msgid "  Alice pulled out a cat's bell from the seam of her mantle and dropped it."
msgstr "　有珠は猫の鈴をケープの裾から取り出した。"

#. Occurrence A_4:729:14800: scene=A_4
#: A_4:729
msgctxt "text_id=14800 | speaker=unknown"
msgid "  Diddle Diddle."
msgstr "　落下する鐘をディドルディドル。"

#. Occurrence A_4:734:14801: scene=A_4
#: A_4:734
msgctxt "text_id=14801 | speaker=unknown"
msgid "  The beginning of Alice Kuonji's magecraft. The start to a night of fairy tales."
msgstr "　童話の夜を助長する、久遠寺有珠の魔術の始まりである。"

#. Occurrence A_4:754:14802: scene=A_4
#: A_4:754
msgctxt "text_id=14802 | speaker=unknown"
msgid "  Aoko favored a quick-draw approach, like something from a western."
msgstr "　青子の魔術行使が西部劇の<早撃ち|クイックドロウ>なら、"

#. Occurrence A_4:759:14803: scene=A_4
#: A_4:759
msgctxt "text_id=14803 | speaker=unknown"
msgid "  However, Alice preferred sleight of hand."
msgstr "　有珠の魔術行使は手品師の<指芸|カット>のようだ。"

#. Occurrence A_4:764:14804: scene=A_4
#: A_4:764
msgctxt "text_id=14804 | speaker=unknown"
msgid "  She used her target's blind spots against them, ending the game before they knew it had begun."
msgstr "　見る者の意識の隙をついて、鮮やかに大胆に、何より気づかれる事なく、目的を終えている。"

#. Occurrence A_4:769:14805: scene=A_4
#: A_4:769
msgctxt "text_id=14805 | speaker=unknown"
msgid "  The bell fell, like a coin into a fountain."
msgstr "　鈴は泉に没する<金貨|コイン>のように落下し、そして―――"

#. Occurrence A_4:817:14806: scene=A_4
#: A_4:817
msgctxt "text_id=14806 | speaker=unknown"
msgid "  Then, as it was about to strike the ground, it shattered, disappearing without a trace."
msgstr "　跡形もなく、地中に沈む前に砕け散った。"

#. Occurrence A_4:858:14807: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0004; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:858
msgctxt "text_id=14807 | speaker=alice"
msgid "\"Runes...\""
msgstr "「ルーン―――」"

#. Occurrence A_4:867:14808: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0006; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:867
msgctxt "text_id=14808 | speaker=touko"
msgid "\"Correct. I spent the day carving characters into the park."
msgstr "「ああ。一日かけて公園中に<刻|きざ>ませてもらった。"

#. Occurrence A_4:873:14809: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0007; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:873
msgctxt "text_id=14809 | speaker=touko"
msgid "  The brick path meant it was easy work, if a little time consuming."
msgstr "　この公園の道はレンガだからね。手間こそかかったが簡単な仕事だった。"

#. Occurrence A_4:889:14810: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0008; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:889
msgctxt "text_id=14810 | speaker=touko"
msgid "  Look at the woods around here. Roughly a twelve hundred square foot blank canvas."
msgstr "　まわりの森まで見て、ざっと四百<平米|ヘーベー>のキャンバスだ。"

#. Occurrence A_4:895:14811: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0009; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:895
msgctxt "text_id=14811 | speaker=touko"
msgid "  Impressive, isn't it?"
msgstr "　面白いだろう？"

#. Occurrence A_4:901:14812: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0010; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:901
msgctxt "text_id=14812 | speaker=touko"
msgid "  Right now, you and I are right on top of three-hundred thousand characters' worth of runes.\""
msgstr "　いま私たちは、三十万字以上の<太陽|ルーン>の上にいる」"

#. Occurrence A_4:998:14813: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0005; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:998
msgctxt "text_id=14813 | speaker=alice"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence A_4:1003:14814: scene=A_4
#: A_4:1003
msgctxt "text_id=14814 | speaker=unknown"
msgid "  Swallowing hard, Alice took a step back."
msgstr "　息を呑みながら一歩だけ後じさる有珠。"

#. Occurrence A_4:1008:14815: scene=A_4
#: A_4:1008
msgctxt "text_id=14815 | speaker=unknown"
msgid "  Touko had carved runes all over the ground."
msgstr "　地表すべてにルーンを刻んでいる？"

#. Occurrence A_4:1013:14816: scene=A_4
#: A_4:1013
msgctxt "text_id=14816 | speaker=unknown"
msgid "  Even in the area Diddle reacted to alone, there was a depressing amount of them. Had she truly carved them into the whole park?"
msgstr "　いま一瞬だけディドルに反応した箇所だけでも気が滅入る数のルーンを、公園すべてに？"

#. Occurrence A_4:1018:14817: scene=A_4
#: A_4:1018
msgctxt "text_id=14817 | speaker=unknown"
msgid "  Alice did not react with surprise; she simply narrowed her eyes."
msgstr "　驚きより、強い疑問に有珠は目を細めた。"

#. Occurrence A_4:1064:14818: scene=A_4
#: A_4:1064
msgctxt "text_id=14818 | speaker=unknown"
msgid "  She could see how it would have taken the whole day."
msgstr "　たしかに、それは完全な“日中”だ。"

#. Occurrence A_4:1069:14819: scene=A_4
#: A_4:1069
msgctxt "text_id=14819 | speaker=unknown"
msgid "  It was no wonder Diddle Diddle, Banquet of the Night, was destroyed by the skin of sun."
msgstr "　夜を呼ぶディドルディドルは、この太陽の膜に破壊されて当然だろう。"

#. Occurrence A_4:1074:14820: scene=A_4
#: A_4:1074
msgctxt "text_id=14820 | speaker=unknown"
msgid "  Still, something bothered Alice."
msgstr "　だが―――"

#. Occurrence A_4:1095:14821: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0006; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:1095
msgctxt "text_id=14821 | speaker=alice"
msgid "\"How in the world did you hide them all?\""
msgstr "「……一体、どうやって隠していたの？」"

#. Occurrence A_4:1101:14822: scene=A_4
#: A_4:1101
msgctxt "text_id=14822 | speaker=unknown"
msgid "  There were just so many."
msgstr "　それだけのルーン文字。"

#. Occurrence A_4:1106:14823: scene=A_4
#: A_4:1106
msgctxt "text_id=14823 | speaker=unknown"
msgid "  What kind of magecraft could do that?"
msgstr "　それだけの魔術行使の痕跡を、どうやって隠し通したのか。"

#. Occurrence A_4:1146:14824: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0011; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:1146
msgctxt "text_id=14824 | speaker=touko"
msgid "\"Oh, these are special."
msgstr "「ああ、ちょっと特別製。"

#. Occurrence A_4:1153:14825: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0012; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:1153
msgctxt "text_id=14825 | speaker=touko"
msgid "These runes shift location-they're doing it even now. They look like simple scratches, but they return to their original form when they touch strong magical energy. You could call them 'memory runes.'"
msgstr "このルーンね、普段は確定していないんだ。こうしている今も変形している。パッと見はただの<疵痕|きずあと>。それが強い魔力に触れると、もとのカタチに立ち戻る。形状記憶ルーンとでも言おうかな。"

#. Occurrence A_4:1164:14826: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0013; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:1164
msgctxt "text_id=14826 | speaker=touko"
msgid "  No matter how deep the night, these little suns won't set. And the snow hid them beautifully.\""
msgstr "　そんな訳で、いかなる夜の深さをもってしても、この太陽は没しない。この通り、雪が降ってくれたおかげで視覚的な誤魔化しも万全だったしね」"

#. Occurrence A_4:1186:14827: scene=A_4
#: A_4:1186
msgctxt "text_id=14827 | speaker=unknown"
msgid "  She spoke modestly, but Alice could not imagine the amount of persistence, technique, and skill it must have taken."
msgstr "　さらりと言ってのけるが、それがどれほどの執念、技術、才能を必要とするものか、有珠ですら正確に判断できない。"

#. Occurrence A_4:1208:14828: scene=A_4
#: A_4:1208
msgctxt "text_id=14828 | speaker=unknown"
msgid "  And it only took a day. Even ten mages would have trouble producing so many sophisticated runes in that time."
msgstr "　一日作業だと言うなら、熟練したルーン使いが十人がかりでも可能かどうか。"

#. Occurrence A_4:1213:14829: scene=A_4
#: A_4:1213
msgctxt "text_id=14829 | speaker=unknown"
msgid "  Moreover, these runes were made using unknown techniques the Association had not approved."
msgstr "　加えて、使われているルーンは協会に特許も出されていない未知の技術だ。"

#. Occurrence A_4:1239:14830: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0007; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:1239
msgctxt "text_id=14830 | speaker=alice"
msgid "\"It pains me to admit it, Touko..."
msgstr "「……負け惜しみだけど。"

#. Occurrence A_4:1245:14831: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0008; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:1245
msgctxt "text_id=14831 | speaker=alice"
msgid "  but that's a lot of power to use on one poor, little girl.\""
msgstr "　わたしみたいな小娘ひとりに大人げないわね、橙子さん」"

#. Occurrence A_4:1251:14832: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0014; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:1251
msgctxt "text_id=14832 | speaker=touko"
msgid "\"Oh, please. I've never thought that about you."
msgstr "「馬鹿を言うな。君を小娘だなんて、一度も思った事はないよ。"

#. Occurrence A_4:1277:14833: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0015; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:1277
msgctxt "text_id=14833 | speaker=touko"
msgid "  Though, there were times when I admired that body of yours. To have one like that...\""
msgstr "　まあ―――私<好|ごの>みの体だと、<睨|ね>め付ける事はあったがね」"

#. Occurrence A_4:1441:14834: scene=A_4
#: A_4:1441
msgctxt "text_id=14834 | speaker=unknown"
msgid "  It happened in the blink of an eye."
msgstr "　変化は一瞬だった。"

#. Occurrence A_4:1446:14835: scene=A_4
#: A_4:1446
msgctxt "text_id=14835 | speaker=unknown"
msgid "  Alice cut off Touko's snide remark with a deadly stare."
msgstr "　橙子の<戯言|たわごと>を、有珠は視線だけで斬って捨てた。"

#. Occurrence A_4:1466:14836: scene=A_4
#: A_4:1466
msgctxt "text_id=14836 | speaker=unknown"
msgid "  The left eye of the darkly clad girl changed in color to an ominous ruby."
msgstr "　深い闇色をした少女の左目は、禍々しい<紅玉|ルビー>の色に変わっている。"

#. Occurrence A_4:1486:14837: scene=A_4
#: A_4:1486
msgctxt "text_id=14837 | speaker=unknown"
msgid "  The speed of the incantation was phenomenal."
msgstr "　最速の<一工程|シングルアクション>、視線による術式投射。"

#. Occurrence A_4:1491:14838: scene=A_4
#: A_4:1491
msgctxt "text_id=14838 | speaker=unknown"
msgid "  Alice's Mystic Eyes of Enthralling snared Touko."
msgstr "　魔眼と呼ばれる“魅了の視線”が、蒼崎橙子の姿を眼球に捕らえている。"

#. Occurrence A_4:1496:14839: scene=A_4
#: A_4:1496
msgctxt "text_id=14839 | speaker=unknown"
msgid "  She had been the one to, quite literally, be taken captive by the girl's stare."
msgstr "　睨め付けていた、と語った女は、今や文字通り、少女の目によって<縫|・><い|・><付|・><け|・>られていた。"

#. Occurrence A_4:1535:14840: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0016; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:1535
msgctxt "text_id=14840 | speaker=touko"
msgid "\"...\""
msgstr "「―――――――――」"

#. Occurrence A_4:1540:14841: scene=A_4
#: A_4:1540
msgctxt "text_id=14841 | speaker=unknown"
msgid "  Touko tried to raise her arm, but could not even move a finger."
msgstr "　橙子は腕をあげようとしたが、体は指一本動かない。"

#. Occurrence A_4:1545:14842: scene=A_4
#: A_4:1545
msgctxt "text_id=14842 | speaker=unknown"
msgid "  Alice's Mystic Eyes commanded absolute control, with no room for resistance."
msgstr "　<抵抗|レジスト>する間もない、問答無用の有珠の魔眼だった。"

#. Occurrence A_4:1550:14843: scene=A_4
#: A_4:1550
msgctxt "text_id=14843 | speaker=unknown"
msgid "  Only a person's internal organs were allowed the freedom to move."
msgstr "　自由が許されているのは<内臓|なかみ>ぐらい。"

#. Occurrence A_4:1555:14844: scene=A_4
#: A_4:1555
msgctxt "text_id=14844 | speaker=unknown"
msgid "  Since their organs still functioned, it was more precise to say that her eyes forbid the target from acting."
msgstr "　<内臓|なかみ>は問題なく機能している以上、<運|・><動|・>ではなく<行|・><動|・>を禁じる<魅了|まがん>であるらしい。"

#. Occurrence A_4:1600:14845: scene=A_4
#: A_4:1600
msgctxt "text_id=14845 | speaker=unknown"
msgid "  Alice had played her hand with exquisite timing."
msgstr "　……に、しても惚れ惚れするタイミングだった。"

#. Occurrence A_4:1605:14846: scene=A_4
#: A_4:1605
msgctxt "text_id=14846 | speaker=unknown"
msgid "  It wasn't the speed of her eyes that had given her an edge."
msgstr "　魔眼の速度ではない。"

#. Occurrence A_4:1610:14847: scene=A_4
#: A_4:1610
msgctxt "text_id=14847 | speaker=unknown"
msgid "  The deftness with which she wove her spells to exploit the briefest vulnerability is what made Alice a different caliber to other mages like Aoko."
msgstr "　こちらの呼吸、次の手に入る前の<間隙|かんげき>をつく術の<巧|うま>さは、青子などとは地金が違う。"

#. Occurrence A_4:1636:14848: scene=A_4
#: A_4:1636
msgctxt "text_id=14848 | speaker=unknown"
msgid "  This witch, who lived hidden in the modern era, was more seasoned in magical battles than Touko Aozaki."
msgstr "　現代に隠れ住む魔女は、蒼崎橙子以上に、魔術戦のなんたるかを熟知していた。"

#. Occurrence A_4:1672:14849: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0017; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:1672
msgctxt "text_id=14849 | speaker=touko"
msgid "\"Such a shame... Without Diddle Diddle, your eyes can't be made acrostic."
msgstr "「―――だが残念。ディドルディドルが響かないのでは、魔眼のアクロスティック化はできないようだな。"

#. Occurrence A_4:1691:14850: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0018; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:1691
msgctxt "text_id=14850 | speaker=touko"
msgid "  You were close. With your moon Ploy Kickshaw, I might have been begging for mercy.\""
msgstr "　惜しいね。あの月目のプロイキッシャーなら、これで<私|・>の方はお手上げだったろうが―――」"

#. Occurrence A_4:1729:14851: scene=A_4
#: A_4:1729
msgctxt "text_id=14851 | speaker=unknown"
msgid "  The formation holding Touko began to distort."
msgstr "　橙子を拘束する陣形が歪んでいく。"

#. Occurrence A_4:1734:14852: scene=A_4
#: A_4:1734
msgctxt "text_id=14852 | speaker=unknown"
msgid "  In the blink of an eye, the mage"
msgstr "　手足はおろか指一本動かせない筈の魔術師は、"

#. Occurrence A_4:1775:14853: scene=A_4
#: A_4:1775
msgctxt "text_id=14853 | speaker=unknown"
msgid "  had bested Alice's Mystic Eyes."
msgstr "　瞬きだけで、有珠の魔眼を克服した。"

#. Occurrence A_4:1857:14854: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0009; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:1857
msgctxt "text_id=14854 | speaker=alice"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence A_4:1862:14855: scene=A_4
#: A_4:1862
msgctxt "text_id=14855 | speaker=unknown"
msgid "  Alice's black outfit fluttered in the wind."
msgstr "　黒衣が流れる。"

#. Occurrence A_4:1867:14856: scene=A_4
#: A_4:1867
msgctxt "text_id=14856 | speaker=unknown"
msgid "  She turned so she was not facing Touko head on-the mage had recovered through her own Mystic Eyes. "
msgstr "　今の<克服|リカバー>が橙子の<魔|・><眼|・>によるものと看破し、有珠は相手の視界―――その正面に立たないように身を<翻|ひるがえ>す。"

#. Occurrence A_4:1904:14857: scene=A_4
#: A_4:1904
msgctxt "text_id=14857 | speaker=unknown"
msgid "  At the root of Touko's Mystic Eyes was a spell of Mesmerize."
msgstr "　魔眼と言えど、その根底にあるのは暗示だ。"

#. Occurrence A_4:1909:14858: scene=A_4
#: A_4:1909
msgctxt "text_id=14858 | speaker=unknown"
msgid "  Most effective when facing their prey, such eyes could mind-jack a target's awareness. It was difficult to resist head-on."
msgstr "　正面からの、相手の不意をつく<意識|マインド><制圧|ジャック>がもっとも効果的であり、<抵抗|レジスト>されにくい。"

#. Occurrence A_4:1914:14859: scene=A_4
#: A_4:1914
msgctxt "text_id=14859 | speaker=unknown"
msgid "  However, its effect was greatly diminished if the target was not facing the eyes directly, even if it was within range."
msgstr "　逆に言えば、たとえ魔眼の範囲に入っていようと、正面にさえいなければ効果は半減する。"

#. Occurrence A_4:1919:14860: scene=A_4
#: A_4:1919
msgctxt "text_id=14860 | speaker=unknown"
msgid "  Moreover, the girl was the last witch of her lineage, who commanded a great number of fairy tales."
msgstr "　ましてや、少女は数多の童話を従える最後の魔女。"

#. Occurrence A_4:1924:14861: scene=A_4
#: A_4:1924
msgctxt "text_id=14861 | speaker=unknown"
msgid "  Against Mystic Eyes that projected their effects, simply turning one's body was enough to repel half of the magical energy!"
msgstr "　投写型の魔眼が相手なら、半身<逸|そ>らすだけであらゆる魔力をはじき返せる……！"

#. Occurrence A_4:2006:14862: scene=A_4
#: A_4:2006
msgctxt "text_id=14862 | speaker=unknown"
msgid "  Like Alice's eyes, Touko's could also disable actions."
msgstr "　橙子の魔眼も有珠と同様、行動を封じる魅了だった。"

#. Occurrence A_4:2011:14863: scene=A_4
#: A_4:2011
msgctxt "text_id=14863 | speaker=unknown"
msgid "  Alice had escaped by the skin of her teeth."
msgstr "　有珠は間一髪、正面からの視線を逸らした。"

#. Occurrence A_4:2016:14864: scene=A_4
#: A_4:2016
msgctxt "text_id=14864 | speaker=unknown"
msgid "  The damage she'd suffered was the weight of a twig to a forest."
msgstr "　この程度の<戒|いまし>め、少女にとっては森の小枝ほどの重みもない。"

#. Occurrence A_4:2021:14865: scene=A_4
#: A_4:2021
msgctxt "text_id=14865 | speaker=unknown"
msgid "  She just had to let the energy pass throu-"
msgstr "　指で払いのけるまでもなく、ただ通過するのみ―――"

#. Occurrence A_4:2136:14866: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0010; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:2136
msgctxt "text_id=14866 | speaker=alice"
msgid "\"Ngh...?!\""
msgstr "「っ―――!?」"

#. Occurrence A_4:2141:14867: scene=A_4
#: A_4:2141
msgctxt "text_id=14867 | speaker=unknown"
msgid "  In an instant, a startling chill ran through Alice's body."
msgstr "　瞬間、有珠は信じがたい寒気に襲われた。"

#. Occurrence A_4:2209:14868: scene=A_4
#: A_4:2209
msgctxt "text_id=14868 | speaker=unknown"
msgid "  This was a problem."
msgstr "　これは、<詰|・><ん|・><だ|・>。"

#. Occurrence A_4:2237:14869: scene=A_4
#: A_4:2237
msgctxt "text_id=14869 | speaker=unknown"
msgid "  The touch of death ran up her spine."
msgstr "　死の感触が背中を走る。"

#. Occurrence A_4:2245:14870: scene=A_4
#: A_4:2245
msgctxt "text_id=14870 | speaker=unknown"
msgid "  She glared at the mage before her, as blue rubber balls flowed out from beneath her overcoat."
msgstr "　外套の下から青いゴムマリを逃がしながら、有珠は敵魔術師を凝視する。"

#. Occurrence A_4:2289:14871: scene=A_4
#: A_4:2289
msgctxt "text_id=14871 | speaker=unknown"
msgid "  The stare-off grew more intense."
msgstr "　衝突する視線。"

#. Occurrence A_4:2294:14872: scene=A_4
#: A_4:2294
msgctxt "text_id=14872 | speaker=unknown"
msgid "  Alice glared harder, resisting Touko's Mystic Eyes with her own."
msgstr "　魔眼を魔眼で押し返そうと、有珠は橙子を睨む。"

#. Occurrence A_4:2314:14873: scene=A_4
#: A_4:2314
msgctxt "text_id=14873 | speaker=unknown"
msgid "  Losing was not an option."
msgstr "　―――負ける筈がない。"

#. Occurrence A_4:2332:14874: scene=A_4
#: A_4:2332
msgctxt "text_id=14874 | speaker=unknown"
msgid "  In terms of raw magical energy, Alice Kuonji's Mystic Eyes were more powerful and advanced than Touko's."
msgstr "　純粋な魔力量でも、魔眼の質でも、久遠寺有珠は蒼崎橙子の上にいる。"

#. Occurrence A_4:2486:14875: scene=A_4
#: A_4:2486
msgctxt "text_id=14875 | speaker=unknown"
msgid "  Surely nobody could beat her."
msgstr "　当然の帰結として、敵の<戒|いまし>めは有珠の前で霧散した。"

#. Occurrence A_4:2504:14876: scene=A_4
#: A_4:2504
msgctxt "text_id=14876 | speaker=unknown"
msgid "  And yet..."
msgstr "　だが。"

#. Occurrence A_4:2509:14877: scene=A_4
#: A_4:2509
msgctxt "text_id=14877 | speaker=unknown"
msgid "  Her unfiltered stock of magical energy, stifled by old-fashioned values, was no match for Touko's madness."
msgstr "　血統だの魔力量だの、そんな時代遅れの価値観は、橙子の狂気の前に砕け散った。"

#. Occurrence A_4:2562:14878: scene=A_4
#: A_4:2562
msgctxt "text_id=14878 | speaker=unknown"
msgid "  Deeper within her eyes..."
msgstr "　目蓋ではなくその中身―――"

msgctxt "text_id=14879 | speaker=unknown"
msgid "  Somehow, the eyes revealed a sealed power."
msgstr "　開く<機|コ><能|ト>のない<眼球|まがん>が開く。"

#. Occurrence A_4:2742:14880: scene=A_4
#: A_4:2742
msgctxt "text_id=14880 | speaker=unknown"
msgid "  Inside the crystalline lens of the mage's left iris was a bottomless pit, a Klein cube."
msgstr "　魔術師の左眼―――その水晶体の中に、<底なしの穴|クラインキューブ>がうがたれていく。"

#. Occurrence A_4:2813:14881: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0011; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:2813
msgctxt "text_id=14881 | speaker=alice"
msgid "\"Hng...!\""
msgstr "「、っ…………！」"

#. Occurrence A_4:2818:14882: scene=A_4
#: A_4:2818
msgctxt "text_id=14882 | speaker=unknown"
msgid "  Alice winced in pain."
msgstr "　苦痛に歪む吐息。"

#. Occurrence A_4:2823:14883: scene=A_4
#: A_4:2823
msgctxt "text_id=14883 | speaker=unknown"
msgid "  The bindings grew in number."
msgstr "　もはや拘束は一つではない。"

#. Occurrence A_4:2870:14884: scene=A_4
#: A_4:2870
msgctxt "text_id=14884 | speaker=unknown"
msgid "  So many Mystic Eyes... Thousands perhaps, and all fixed on Alice."
msgstr "　<夥|おびただ>しいまでの魔眼―――千を超える橙子の魔眼、その視線がすべて有珠に向けられている……！"

#. Occurrence A_4:2922:14885: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0012; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:2922
msgctxt "text_id=14885 | speaker=alice"
msgid "\"Ngh... Hnh...!\""
msgstr "「っ、っ……！」"

#. Occurrence A_4:2927:14886: scene=A_4
#: A_4:2927
msgctxt "text_id=14886 | speaker=unknown"
msgid "  Pressure. So much pressure."
msgstr "　視線の重圧はいまも増え続けている。"

#. Occurrence A_4:2932:14887: scene=A_4
#: A_4:2932
msgctxt "text_id=14887 | speaker=unknown"
msgid "  Endless. And Alice knew it."
msgstr "　そこに果てがない事を、有珠は認めた。"

#. Occurrence A_4:2938:14888: scene=A_4
#: A_4:2938
msgctxt "text_id=14888 | speaker=unknown"
msgid "  She saw..."
msgstr "　アレは―――"

msgctxt "text_id=14889 | speaker=unknown"
msgid "  Incredulously, she saw eyes growing within eyes..."
msgstr "　信じがたい事に、魔眼の中に魔眼を造っている。"

#. Occurrence A_4:2945:14890: scene=A_4
#: A_4:2945
msgctxt "text_id=14890 | speaker=unknown"
msgid "  Touko had placed opposing mirrors inside her eyes, resulting in an infinite glare."
msgstr "　橙子は自らの魔眼の内部を合わせ鏡にする事で、その<視線|こうか>を無限にしたのだ。"

#. Occurrence A_4:2997:14891: scene=A_4
#: A_4:2997
msgctxt "text_id=14891 | speaker=unknown"
msgid "  It was the act of a madwoman. Creating Mystic Eyes within Mystic Eyes..."
msgstr "　魔眼の中に魔眼を造るだけでも狂気の沙汰。"

#. Occurrence A_4:3002:14892: scene=A_4
#: A_4:3002
msgctxt "text_id=14892 | speaker=unknown"
msgid "  She could even control the resulting chaos caused by all the copies."
msgstr "　それを反射させ、次々とコピーされていく魔力を制御し、カオス化した魔力を暴走させる事なく機能させる―――"

#. Occurrence A_4:3008:14893: scene=A_4
#: A_4:3008
msgctxt "text_id=14893 | speaker=unknown"
msgid "Her insanity knew no bounds."
msgstr "狂気なんて罵倒では飽き足らない。"

#. Occurrence A_4:3045:14894: scene=A_4
#: A_4:3045
msgctxt "text_id=14894 | speaker=unknown"
msgid "  No mage in their right mind would mass-produce so many Mystics-the last escape of humankind-so indiscriminately!"
msgstr "　魔術を―――人間に残された最後の逃げ道である神秘を、あんな、分別なく<大量生産|マスプロダクション>してしまうのなら、あの女は魔術師と名乗るのもおこがましい―――！"

#. Occurrence A_4:3093:14895: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0019; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:3093
msgctxt "text_id=14895 | speaker=touko"
msgid "\"Oh dear... am I making you uncomfortable? Tell me, am I doing a good job of imitating a Meinster?"
msgstr "「……やれやれ、これもお気に召さないか。私なりにマインスターの真似事をしてみたつもりなんだが。"

#. Occurrence A_4:3114:14896: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0020; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:3114
msgctxt "text_id=14896 | speaker=touko"
msgid "  Aren't you impressed?"
msgstr "　<巧|うま>く出来ているだろう？"

#. Occurrence A_4:3120:14897: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0021; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:3120
msgctxt "text_id=14897 | speaker=touko"
msgid "  Instead of bending reality using a rare Mystic like you would, I mass produce a Mystic to bend reality to my will."
msgstr "　君のアクロのように稀少な神秘で現実をねじ曲げるのではなく、量産した神秘で現実をねじ伏せる。"

#. Occurrence A_4:3135:14898: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0022; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:3135
msgctxt "text_id=14898 | speaker=touko"
msgid "  On the surface they're regular Mystic Eyes, only their volume is infinite."
msgstr "　もの自体はただの魔眼。だがその弾数には果てがない。"

#. Occurrence A_4:3142:14899: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0023; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:3142
msgctxt "text_id=14899 | speaker=touko"
msgid "No matter how much magical energy an opponent uses to resist them, they will simply multiply the energy needed to bind them.\""
msgstr "相手がどれほどの魔力抵抗を持っていようと、それ以上の魔力で拘束する<だ|・><け|・>のモノだ」"

#. Occurrence A_4:3180:14900: scene=A_4
#: A_4:3180
msgctxt "text_id=14900 | speaker=unknown"
msgid "  She wielded power without limit to disable an opponent."
msgstr "　果てのない魔力で相手の動きを封じこめる。"

#. Occurrence A_4:3185:14901: scene=A_4
#: A_4:3185
msgctxt "text_id=14901 | speaker=unknown"
msgid "  Once one was caught in them, one was chained to the concept of infinity."
msgstr "　つまり、あの魔眼に囚われたが最後、無限という概念に縛られてしまうのだ。"

#. Occurrence A_4:3255:14902: scene=A_4
#: A_4:3255
msgctxt "text_id=14902 | speaker=unknown"
msgid "  Projection-type eyes had a fatal flaw: their firepower and formulae were insignificant compared to the great artillery of incanted spells. But Touko had torn down that conventional wisdom with brute strength."
msgstr "　投写型の魔眼の欠点―――所詮は短銃であり、大砲である詠唱術式には火力・術式で敵わないという定説を、橙子は力ずくで破壊した。"

#. Occurrence A_4:3283:14903: scene=A_4
#: A_4:3283
msgctxt "text_id=14903 | speaker=unknown"
msgid "  If the gun was a pea-shooter, she simply needed to bring more guns."
msgstr "　小銃が弱いのなら、数を用意する。"

#. Occurrence A_4:3329:14904: scene=A_4
#: A_4:3329
msgctxt "text_id=14904 | speaker=unknown"
msgid "  A 9-millimeter bullet could never destroy a fortress... unless one threw a fortress' mass of bullets at it."
msgstr "　９ミリの弾丸では要塞を壊せないのなら、壊せるだけの数を叩きつけてご覧にいれよう―――"

#. Occurrence A_4:3334:14905: scene=A_4
#: A_4:3334
msgctxt "text_id=14905 | speaker=unknown"
msgid "  The principle was brutishly simple, but in the world of magecraft where concepts decided supremacy, Touko's Iterative Mystic Eyes were the perfect weapon."
msgstr "　あの<積重|せきじゅう>魔眼はそれだけの原理だが、概念が力を持つ魔術世界においては完璧な兵器だった。"

#. Occurrence A_4:3354:14906: scene=A_4
#: A_4:3354
msgctxt "text_id=14906 | speaker=unknown"
msgid "  The target would be bound until she closed her eyes."
msgstr "　アレに囚われた者は、橙子が眼を閉じるまで動けない。"

#. Occurrence A_4:3359:14907: scene=A_4
#: A_4:3359
msgctxt "text_id=14907 | speaker=unknown"
msgid "  In theory at least, the effects were infinite."
msgstr "　机上の空論とはいえ、理屈の上では「無限」である。"

#. Occurrence A_4:3364:14908: scene=A_4
#: A_4:3364
msgctxt "text_id=14908 | speaker=unknown"
msgid "  No amount of magical energy could ever overcome it, so it was utterly futile to resist using magical energy."
msgstr "　魔力量では決して上回れない以上、魔力で抵抗する事は無意味なのだ。"

#. Occurrence A_4:3416:14909: scene=A_4
#: A_4:3416
msgctxt "text_id=14909 | speaker=unknown"
msgid "  Of course, one way to counter it would be to stay out of Touko's line of sight to begin with."
msgstr "　破る手段があるとしたら、まずは一つ、はじめから橙子の視界に入らないこと。"

#. Occurrence A_4:3422:14910: scene=A_4
#: A_4:3422
msgctxt "text_id=14910 | speaker=unknown"
msgid "The standard tactic against Mystic Eyes was to defeat the user before they were aware of you."
msgstr "相手に気付かれる前に倒す、という対魔眼戦の基本にして最善手。"

#. Occurrence A_4:3439:14911: scene=A_4
#: A_4:3439
msgctxt "text_id=14911 | speaker=unknown"
msgid "  There was, however, another way."
msgstr "　そしてもう一つ。"

#. Occurrence A_4:3444:14912: scene=A_4
#: A_4:3444
msgctxt "text_id=14912 | speaker=unknown"
msgid "  It was simpler than one might think."
msgstr "　実に、単純かつ粗暴な話ではあるが―――"

#. Occurrence A_4:3477:14913: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0024; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:3477
msgctxt "text_id=14913 | speaker=touko"
msgid "\"I'm afraid this is checkmate. Any last words?\""
msgstr "「ともあれこれで詰みだ。何か言い残す事は？」"

#. Occurrence A_4:3509:14914: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0013; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:3509
msgctxt "text_id=14914 | speaker=alice"
msgid "\"...\""
msgstr "「……………………」"

#. Occurrence A_4:3514:14915: scene=A_4
#: A_4:3514
msgctxt "text_id=14915 | speaker=unknown"
msgid "  Alice could no longer see her enemy."
msgstr "　もう有珠には敵の姿も見えない。"

#. Occurrence A_4:3519:14916: scene=A_4
#: A_4:3519
msgctxt "text_id=14916 | speaker=unknown"
msgid "  Touko's infinite eyes had bound her."
msgstr "　魔眼の呪縛が視界を<覆|おお>い尽くしている。"

#. Occurrence A_4:3577:14917: scene=A_4
#: A_4:3577
msgctxt "text_id=14917 | speaker=unknown"
msgid "  All she could make out was a sliver of moonlight,"
msgstr "　かろうじて見えるのは空の月だけ。"

#. Occurrence A_4:3582:14918: scene=A_4
#: A_4:3582
msgctxt "text_id=14918 | speaker=unknown"
msgid "  and a blue streak, tracing its way towards her."
msgstr "　それと、<階|きざはし>のような青い軌跡。"

#. Occurrence A_4:3636:14919: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0025; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:3636
msgctxt "text_id=14919 | speaker=touko"
msgid "\"Fine. I wish I could say I had no regrets like you.\""
msgstr "「結構。悔いのない人生で羨ましい」"

#. Occurrence A_4:3683:14920: scene=A_4
#: A_4:3683
msgctxt "text_id=14920 | speaker=unknown"
msgid "  She drew a rune in the air, unleashing a shockwave to tear flesh asunder."
msgstr "　大気中に描かれた<呪刻|ルーン>から、肌を裂く衝撃が<弾|はじ>かれる。"

#. Occurrence A_4:3688:14921: scene=A_4
#: A_4:3688
msgctxt "text_id=14921 | speaker=unknown"
msgid "  The gusts became blades of air that shredded Alice's overcoat, and minced- "
msgstr "　風は鋭利な刃物と化して、少女の外套と、その体を八つ裂きにし―――"

#. Occurrence A_4:3819:14922: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0026; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:3819
msgctxt "text_id=14922 | speaker=touko"
msgid "\"...!\""
msgstr "「―――！」"

#. Occurrence A_4:3874:14923: scene=A_4
#: A_4:3874
msgctxt "text_id=14923 | speaker=unknown"
msgid "  Blue feathers flitted all around."
msgstr "　<千|ち><々|ぢ>に散る青い羽根。"

#. Occurrence A_4:3879:14924: scene=A_4
#: A_4:3879
msgctxt "text_id=14924 | speaker=unknown"
msgid "  Touko felt something behind her, and turned."
msgstr "　背後に気配を感じて振りかえる橙子。"

#. Occurrence A_4:3884:14925: scene=A_4
#: A_4:3884
msgctxt "text_id=14925 | speaker=unknown"
msgid "  Five cat-shaped bells were thrown at her feet."
msgstr "　その足下に、五体の猫鈴が投げつけられる。"

#. Occurrence A_4:3970:14926: scene=A_4
#: A_4:3970
msgctxt "text_id=14926 | speaker=unknown"
msgid "  And just as quickly they shattered to pieces."
msgstr "　無惨に砕け散る猫鈴。"

#. Occurrence A_4:3975:14927: scene=A_4
#: A_4:3975
msgctxt "text_id=14927 | speaker=unknown"
msgid "  Standing before her was a completely unharmed Alice Kuonji."
msgstr "　橙子が振り向いた先には、変わらぬ久遠寺有珠の姿があった。"

#. Occurrence A_4:3996:14928: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0014; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:3996
msgctxt "text_id=14928 | speaker=alice"
msgid "\"...That rune was but a light breeze."
msgstr "「…………そよ風みたいなルーンね。"

#. Occurrence A_4:3996:14929: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0014; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:3996
msgctxt "text_id=14929 | speaker=alice"
msgid "  Have you really lost your touch, Touko?\""
msgstr "　橙子さん、本当に<鈍|にぶ>った？」"

#. Occurrence A_4:4042:14930: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0027; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:4042
msgctxt "text_id=14930 | speaker=touko"
msgid "\"You used a double? I've never heard of a Ploy that can take the form of a mage.\""
msgstr "「……<空蝉|うつせみ>か。術者の身代わりになるプロイの話は、聞いてなかったな」"

#. Occurrence A_4:4076:14931: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0015; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:4076
msgctxt "text_id=14931 | speaker=alice"
msgid "\"Well, you have now. He's useless every other day of the year, but comes in handy when someone's trying to kill you.\""
msgstr "「ええ。一年のうち３６５日は役立たずで、どうしてあんなのが古参なのかわたしも疑問だけど―――殺される事だけは得意なのよ、彼」"

#. Occurrence A_4:4109:14932: scene=A_4
#: A_4:4109
msgctxt "text_id=14932 | speaker=unknown"
msgid "  As if responding to Alice's words, a bird began chirping frantically."
msgstr "　少女の言葉に応えるように、チチチ、とどこからか鳥の鳴き声がする。"

#. Occurrence A_4:4114:14933: scene=A_4
#: A_4:4114
msgctxt "text_id=14933 | speaker=unknown"
msgid "  An anonymous sacrifice."
msgstr "　犯人不明の<犠牲者|ブルーバード>。"

#. Occurrence A_4:4130:14934: scene=A_4
#: A_4:4130
msgctxt "text_id=14934 | speaker=unknown"
msgid "\"Who Killed Cock Robin?\" echoed into the night, sung out of tune."
msgstr "『誰<が駒鳥を殺した|Who killed COCK ROBIN.>か？』を、音程はずれで唄っている。"

#. Occurrence A_4:4182:14935: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0028; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:4182
msgctxt "text_id=14935 | speaker=touko"
msgid "\"Ah... that old rhyme."
msgstr "「……ああ、そんな歌もあったな。"

#. Occurrence A_4:4188:14936: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0029; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:4188
msgctxt "text_id=14936 | speaker=touko"
msgid "  But you can only kill it once."
msgstr "　だがアレは一度に一回しか殺されない。"

#. Occurrence A_4:4194:14937: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0030; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:4194
msgctxt "text_id=14937 | speaker=touko"
msgid "  Not that it would matter if it was more than that.\""
msgstr "　二度目はないし、あったとしても―――」"

#. Occurrence A_4:4220:14938: scene=A_4
#: A_4:4220
msgctxt "text_id=14938 | speaker=unknown"
msgid "  The bird squawked a very un-birdlike death throe."
msgstr "　ぷぎゃ、と鳥である事を疑う断末魔が響く。"

#. Occurrence A_4:4225:14939: scene=A_4
#: A_4:4225
msgctxt "text_id=14939 | speaker=unknown"
msgid "  From behind Alice, the blue robin fell from its tree, a victim of Touko's Mystic Eyes."
msgstr "　有珠の背後の木に留まっていた駒鳥は、橙子の魔眼を受けただけで悶絶してしまった。"

#. Occurrence A_4:4256:14940: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0016; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:4256
msgctxt "text_id=14940 | speaker=alice"
msgid "\"...So useless.\""
msgstr "「…………本当に、使えない」"

#. Occurrence A_4:4280:14941: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0031; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:4280
msgctxt "text_id=14941 | speaker=touko"
msgid "\"How about you and I start over?"
msgstr "「さて、ではやり直しだ。"

#. Occurrence A_4:4286:14942: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0032; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:4286
msgctxt "text_id=14942 | speaker=touko"
msgid "  Or rather, let's end this now. You're out of options in this park.\""
msgstr "　<後|あと>もつかえている、これで終わりにしよう有珠。どの道、この公園では手がないだろう？」"

#. Occurrence A_4:4346:14943: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0017; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:4346
msgctxt "text_id=14943 | speaker=alice"
msgid "\"I don't think so."
msgstr "「―――そうでもないわ。"

#. Occurrence A_4:4352:14944: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0018; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:4352
msgctxt "text_id=14944 | speaker=alice"
msgid "  Granted, I may not be able to break free of your eyes."
msgstr "　たしかに、今のわたしに貴女の魔眼は<破|やぶ>れない。"

#. Occurrence A_4:4363:14945: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0019; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:4363
msgctxt "text_id=14945 | speaker=alice"
msgid "  But...\""
msgstr "　けれど―――」"

#. Occurrence A_4:4403:14946: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0020; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:4403
msgctxt "text_id=14946 | speaker=alice"
msgid "              \"Build it up with wood and clay,"
msgstr "　　　　　　『Build it up with wood and clay,"

#. Occurrence A_4:4403:14947: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0020; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:4403
msgctxt "text_id=14947 | speaker=alice"
msgid "              wood and clay, wood and clay."
msgstr "　　　　　　　Wood and clay,Wood and clay,"

#. Occurrence A_4:4403:14948: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0020; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:4403
msgctxt "text_id=14948 | speaker=alice"
msgid "              Build it up with wood and clay,"
msgstr "　　　　　　　Build it up with wood and clay,"

#. Occurrence A_4:4403:14949: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0020; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:4403
msgctxt "text_id=14949 | speaker=alice"
msgid "              My fair lady.\""
msgstr "　　　　　　　My fair lady.』"

#. Occurrence A_4:4466:14950: scene=A_4
#: A_4:4466
msgctxt "text_id=14950 | speaker=unknown"
msgid "  The song came from the depths of the earth,"
msgstr "　その歌は地の底から。"

#. Occurrence A_4:4472:14951: scene=A_4
#: A_4:4472
msgctxt "text_id=14951 | speaker=unknown"
msgid "  stirring a mighty quake to mark"
msgstr "　地面を<震|ふる>わせて、"

msgctxt "text_id=14952 | speaker=unknown"
msgid "  the birth of something gargantuan."
msgstr "　何か、巨大なものが生まれつつある―――"

#. Occurrence A_4:4550:14953: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0033; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:4550
msgctxt "text_id=14953 | speaker=touko"
msgid "\"...!\""
msgstr "「―――！」"

#. Occurrence A_4:4636:14954: scene=A_4
#: A_4:4636
msgctxt "text_id=14954 | speaker=unknown"
msgid "  Touko needed to throw Alice into an infinite hell before whatever that was could be completed."
msgstr "　土くれの変化が完成する前に、橙子は黒衣を無限地獄に落としこむ。"

#. Occurrence A_4:4641:14955: scene=A_4
#: A_4:4641
msgctxt "text_id=14955 | speaker=unknown"
msgid "  But, she was far too late."
msgstr "　だがもう、何もかもが遅い。"

#. Occurrence A_4:4714:14956: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0021; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:4714
msgctxt "text_id=14956 | speaker=alice"
msgid "            \"Wood and clay will wash away,"
msgstr "　　　　　『Wood and clay will wash away,』"

msgctxt "text_id=14957 | speaker=unknown"
msgid "            falling down, falling down."
msgstr "　　　　　　Falling down,Falling down,"

msgctxt "text_id=14958 | speaker=unknown"
msgid "            Build it up with bricks and mortar,"
msgstr "　　　　　　Build it up with bricks and mortar,"

msgctxt "text_id=14959 | speaker=unknown"
msgid "            My fair lady.\""
msgstr "　　　　　　My fair lady.』"

#. Occurrence A_4:4821:14960: scene=A_4
#: A_4:4821
msgctxt "text_id=14960 | speaker=unknown"
msgid "  The ground burst to life."
msgstr "　波打つ大地。"

#. Occurrence A_4:4826:14961: scene=A_4
#: A_4:4826
msgctxt "text_id=14961 | speaker=unknown"
msgid "  A finger. Then another. And another... All rising up like towers."
msgstr "　盛り上がる塔のような指。指。指。指。"

#. Occurrence A_4:4832:14962: scene=A_4
#: A_4:4832
msgctxt "text_id=14962 | speaker=unknown"
msgid "  Earth, snow, and brick knitted together, manifesting a giant stone golem!"
msgstr "　数多のレンガを呑みながら、石の巨人が<顕現|けんげん>する―――！"

#. Occurrence A_4:4853:14963: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0034; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:4853
msgctxt "text_id=14963 | speaker=touko"
msgid "\"What the hell is this?!"
msgstr "「そんなバカな話があるか……！"

#. Occurrence A_4:4889:14964: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0035; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:4889
msgctxt "text_id=14964 | speaker=touko"
msgid "  What's this freak doing here?!\""
msgstr "　なぜコイツが出てきやがる！？」"

#. Occurrence A_4:4895:14965: scene=A_4
#: A_4:4895
msgctxt "text_id=14965 | speaker=unknown"
msgid "  Touko was so angry and confused she could barely gather her thoughts."
msgstr "　困惑と怒りが、魔術師を口汚く<罵|ののし>らせる。"

#. Occurrence A_4:4900:14966: scene=A_4
#: A_4:4900
msgctxt "text_id=14966 | speaker=unknown"
msgid "  The Bridge Giant."
msgstr "　橋の巨人。"

#. Occurrence A_4:4905:14967: scene=A_4
#: A_4:4905
msgctxt "text_id=14967 | speaker=unknown"
msgid "  The monster from the Meinster's fairy tales rose from the ground, ruining Touko's plan."
msgstr "　蒼崎橙子をして正面からの攻略を断念させた、マインスターの童話の怪物。"

#. Occurrence A_4:4973:14968: scene=A_4
#: A_4:4973
msgctxt "text_id=14968 | speaker=unknown"
msgid "  The giant was extremely powerful, but could only be summoned under one condition:"
msgstr "　その巨人は、強力であるが故に生成に条件が付く。"

#. Occurrence A_4:4978:14969: scene=A_4
#: A_4:4978
msgctxt "text_id=14969 | speaker=unknown"
msgid "  It must be in proximity to a natural river."
msgstr "　どのような規模であれ、周囲に自然の川があること―――"

#. Occurrence A_4:4983:14970: scene=A_4
#: A_4:4983
msgctxt "text_id=14970 | speaker=unknown"
msgid "  That was the monster's one and only condition."
msgstr "　それが、この巨人を呼ぶ絶対条件だ。"

#. Occurrence A_4:5026:14971: scene=A_4
#: A_4:5026
msgctxt "text_id=14971 | speaker=unknown"
msgid "  But this park was nowhere near one."
msgstr "　そして、この公園の周囲に天然の川はない。"

#. Occurrence A_4:5044:14972: scene=A_4
#: A_4:5044
msgctxt "text_id=14972 | speaker=unknown"
msgid "  And on top of that, it was rising up directly between Touko and Alice, mid-battle."
msgstr "　それを踏まえた上で、橙子は有珠との直接対決に乗り出したというのに……！"

#. Occurrence A_4:5078:14973: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0022; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:5078
msgctxt "text_id=14973 | speaker=alice"
msgid "\"Oh,"
msgstr "「―――あら。"

#. Occurrence A_4:5096:14974: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0023; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:5096
msgctxt "text_id=14974 | speaker=alice"
msgid "  there's a river all right."
msgstr "　あるでしょう、すぐ<そ|・><こ|・>に。"

#. Occurrence A_4:5102:14975: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0024; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:5102
msgctxt "text_id=14975 | speaker=alice"
msgid "  Well, I suppose 'river' is a bit of an exaggeration. And it'll be gone soon.\""
msgstr "　川と呼ぶには小さな、すぐに消えてしまうものだけど」"

#. Occurrence A_4:5183:14976: scene=A_4
#: A_4:5183
msgctxt "text_id=14976 | speaker=unknown"
msgid "  Touko lowered her gaze."
msgstr "　少女の宣言に、魔術師は足下に視線を落とした。"

#. Occurrence A_4:5188:14977: scene=A_4
#: A_4:5188
msgctxt "text_id=14977 | speaker=unknown"
msgid "  She was standing in a puddle of water."
msgstr "　ぱしゃり、と革靴が水を弾く。"

#. Occurrence A_4:5209:14978: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0036; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:5209
msgctxt "text_id=14978 | speaker=touko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence A_4:5214:14979: scene=A_4
#: A_4:5214
msgctxt "text_id=14979 | speaker=unknown"
msgid "  The Scarred Red mage was dumbfounded."
msgstr "　愕然とするオレンジ色の魔術師。"

#. Occurrence A_4:5219:14980: scene=A_4
#: A_4:5219
msgctxt "text_id=14980 | speaker=unknown"
msgid "  That was why Alice had used Diddle Diddle before."
msgstr "　先ほどの、無意味と知った上でのディドルディドルの消費はこの為か。"

#. Occurrence A_4:5272:14981: scene=A_4
#: A_4:5272
msgctxt "text_id=14981 | speaker=unknown"
msgid "  While the bells could be replenished, they were valuable to Alice."
msgstr "　<猫鈴|ディドル>は量産できるとはいえ、少女にとっては貴重品だ。"

#. Occurrence A_4:5279:14982: scene=A_4
#: A_4:5279
msgctxt "text_id=14982 | speaker=unknown"
msgid "  And she had spent five,"
msgstr "　それを意味もなく五回。"

#. Occurrence A_4:5287:14983: scene=A_4
#: A_4:5287
msgctxt "text_id=14983 | speaker=unknown"
msgid "  throwing them in an intentional line for the sun runes to destroy."
msgstr "　直線上に、道を描くよう放たれたディドルディドルは、太陽のルーンによって消滅した。"

#. Occurrence A_4:5401:14984: scene=A_4
#: A_4:5401
msgctxt "text_id=14984 | speaker=unknown"
msgid "  From their "
msgstr "　その爪痕こそ―――"

#. Occurrence A_4:5446:14985: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0037; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:5446
msgctxt "text_id=14985 | speaker=touko"
msgid "\"A stream of melting snow!\""
msgstr "「雪解けの流水か―――！」"

#. Occurrence A_4:5811:14986: scene=A_4
#: A_4:5811
msgctxt "text_id=14986 | speaker=unknown"
msgid "  The arms of the Thames Troll rose up from the stone paving."
msgstr "　石畳を食らいながら、<橋の巨人|テムズトロル>の巨腕が上がる。"

#. Occurrence A_4:5816:14987: scene=A_4
#: A_4:5816
msgctxt "text_id=14987 | speaker=unknown"
msgid "  The monster's torso alone surpassed eighty feet."
msgstr "　上半身だけで八メートルを超える怪物。"

#. Occurrence A_4:5821:14988: scene=A_4
#: A_4:5821
msgctxt "text_id=14988 | speaker=unknown"
msgid "  Its form was made entirely of stone."
msgstr "　その構成はすべて石。"

#. Occurrence A_4:5826:14989: scene=A_4
#: A_4:5826
msgctxt "text_id=14989 | speaker=unknown"
msgid "  Previously, she had created one using the trees of a forest."
msgstr "　以前、少女が森で使役した木々の巨人も怪物だった。"

#. Occurrence A_4:5831:14990: scene=A_4
#: A_4:5831
msgctxt "text_id=14990 | speaker=unknown"
msgid "  However, Touko knew instantly the monster before her was at least twice as powerful."
msgstr "　だが―――目前のモノはそれを二回り上回る怪物だと、魔術師は瞬時に理解する。"

#. Occurrence A_4:5895:14991: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0038; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:5895
msgctxt "text_id=14991 | speaker=touko"
msgid "\"\"\"\"\"HALT!!!\"\"\"\"\""
msgstr "「「「「「止まれ―――！！！！」」」」」"

#. Occurrence A_4:6027:14992: scene=A_4
#: A_4:6027
msgctxt "text_id=14992 | speaker=unknown"
msgid "  She unleashed her stacked Mystic Eyes."
msgstr "　たまらず解放される積重魔眼。"

#. Occurrence A_4:6032:14993: scene=A_4
#: A_4:6032
msgctxt "text_id=14993 | speaker=unknown"
msgid "  They were meaningless at this stage; they had no effect on the giant."
msgstr "　だが―――そんなものが、この巨大な一つの生命に、どれほどの意味があるのか。"

#. Occurrence A_4:6127:14994: scene=A_4
#: A_4:6127
msgctxt "text_id=14994 | speaker=unknown"
msgid "  As said, Mystic Eyes can be countered in two ways."
msgstr "　前述したが、魔眼への対応策は二つある。"

#. Occurrence A_4:6132:14995: scene=A_4
#: A_4:6132
msgctxt "text_id=14995 | speaker=unknown"
msgid "  The first is to hide oneself from view of the mage."
msgstr "　一つは身を隠し、術者の視界に入らない事。"

#. Occurrence A_4:6137:14996: scene=A_4
#: A_4:6137
msgctxt "text_id=14996 | speaker=unknown"
msgid "  That was the standard response. The other way, however, was devilishly simple yet one-hundred percent effective."
msgstr "　それが定石ではあるが、もう一つ、単純かつ絶対の対応策がある。"

#. Occurrence A_4:6142:14997: scene=A_4
#: A_4:6142
msgctxt "text_id=14997 | speaker=unknown"
msgid "  In fact, it's less of a way and more of a fact."
msgstr "　いや、策というよりどうしようもない現実だ。"

#. Occurrence A_4:6147:14998: scene=A_4
#: A_4:6147
msgctxt "text_id=14998 | speaker=unknown"
msgid "  Mystic Eyes curse a target by focusing on them."
msgstr "　魔眼とは視界、焦点に収めた対象に呪いを行う魔術。"

#. Occurrence A_4:6152:14999: scene=A_4
#: A_4:6152
msgctxt "text_id=14999 | speaker=unknown"
msgid "  However, what if the target was too large to focus on entirely?"
msgstr "　しかし。その対象が、<視|・><界|・><に|・><収|・><ま|・><り|・><き|・><ら|・><な|・><い|・><規格|サイズ>であったらどうなるのか？"

#. Occurrence A_4:6282:15000: scene=A_4
#: A_4:6282
msgctxt "text_id=15000 | speaker=unknown"
msgid "  The answer was..."
msgstr "　その答えが、これである。"

#. Occurrence A_4:6287:15001: scene=A_4
#: A_4:6287
msgctxt "text_id=15001 | speaker=unknown"
msgid "  One could barely stop a single arm."
msgstr "　片腕を止めたところで些末なこと。"

#. Occurrence A_4:6292:15002: scene=A_4
#: A_4:6292
msgctxt "text_id=15002 | speaker=unknown"
msgid "  The giant, unfazed, raised its right arm and swung it down onto the ground, destroying thousands of runes."
msgstr "　巨人は自由気ままな右腕を持ち上げ、三十万の<太陽|ルーン>に叩き付ける。"

#. Occurrence A_4:6543:15003: scene=A_4
#: A_4:6543
msgctxt "text_id=15003 | speaker=unknown"
msgid "  The demolished stones were then absorbed into its arm, adding to its mass."
msgstr "　粉砕され、巨人の体として巻き込まれる石の欠片。"

#. Occurrence A_4:6548:15004: scene=A_4
#: A_4:6548
msgctxt "text_id=15004 | speaker=unknown"
msgid "  As the mage had said before."
msgstr "　魔術師はこう語った。"

#. Occurrence A_4:6554:15005: scene=A_4
#: A_4:6554
msgctxt "text_id=15005 | speaker=unknown"
msgid "\"No matter how deep the night, these little suns won't set.\""
msgstr "“いかなる夜をもってしても、この太陽は没しない”"

#. Occurrence A_4:6561:15006: scene=A_4
#: A_4:6561
msgctxt "text_id=15006 | speaker=unknown"
msgid "  While the suns might not set,"
msgstr "　さもありなん。"

#. Occurrence A_4:6566:15007: scene=A_4
#: A_4:6566
msgctxt "text_id=15007 | speaker=unknown"
msgid "  ...they could be crushed under the bulk of a giant's hand."
msgstr "　その言葉ごと、巨人は沈まぬ太陽を完膚無きまで<粉|・><砕|・><し|・><た|・>。"

#. Occurrence A_4:6656:15008: scene=A_4
#: A_4:6656
msgctxt "text_id=15008 | speaker=unknown"
msgid "  The victor of the battle was decided."
msgstr "　……勝敗は決した。"

#. Occurrence A_4:6662:15009: scene=A_4
#: A_4:6662
msgctxt "text_id=15009 | speaker=unknown"
msgid "  Touko Aozaki closed her eyes, and prepared to escape."
msgstr "　蒼崎橙子は魔眼を閉じ、逃げ道を確保するように後退する。"

#. Occurrence A_4:6668:15010: scene=A_4
#: A_4:6668
msgctxt "text_id=15010 | speaker=unknown"
msgid "  The stray dogs began to whine,"
msgstr "　周囲からはくぐもった野犬の<呻|うめ>き。"

#. Occurrence A_4:6673:15011: scene=A_4
#: A_4:6673
msgctxt "text_id=15011 | speaker=unknown"
msgid "  fearful of the hulking figure before them."
msgstr "　集まった彼らも、そびえ立つ異形に怯えきっている。"

#. Occurrence A_4:6729:15012: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0040; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:6729
msgctxt "text_id=15012 | speaker=touko"
msgid "\"You win this one, Alice. Looks like I'm no match for a Meinster after all."
msgstr "「まいったな。私ではマインスターには勝てなかったか。"

#. Occurrence A_4:6735:15013: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0041; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:6735
msgctxt "text_id=15013 | speaker=touko"
msgid "  Let's pick this up another time, shall we?\""
msgstr "　まあ、そのあたりは今後の課題としよう」"

#. Occurrence A_4:6764:15014: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0025; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:6764
msgctxt "text_id=15014 | speaker=alice"
msgid "\"Do you really think you can escape, Touko?\""
msgstr "「……呆れた。逃げられると思っているの、橙子さん？」"

#. Occurrence A_4:6770:15015: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0042; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:6770
msgctxt "text_id=15015 | speaker=touko"
msgid "\"Oh, please, Alice. Give me *some* credit."
msgstr "「まさか。そこまで鈍ってはいないよ有珠。"

#. Occurrence A_4:6776:15016: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0043; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:6776
msgctxt "text_id=15016 | speaker=touko"
msgid "  I should mention- I don't think I'm the one who needs to escape.\""
msgstr "　だいいち―――逃げるとしたら、それは私の方じゃないからね」"

#. Occurrence A_4:6805:15017: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0026; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:6805
msgctxt "text_id=15017 | speaker=alice"
msgid "\"...?\""
msgstr "「……？」"

#. Occurrence A_4:6844:15018: scene=A_4
#: A_4:6844
msgctxt "text_id=15018 | speaker=unknown"
msgid "  There was no hint of bravado in Touko's tone."
msgstr "　魔術師の声に虚勢はない。"

#. Occurrence A_4:6861:15019: scene=A_4
#: A_4:6861
msgctxt "text_id=15019 | speaker=unknown"
msgid "  Even in the face of a titan she had no means of harming, her confidence was unshakable."
msgstr "　自分では傷一つ付けられない巨人を前にして、蒼崎橙子の余裕は崩れない。"

#. Occurrence A_4:6866:15020: scene=A_4
#: A_4:6866
msgctxt "text_id=15020 | speaker=unknown"
msgid "  The reason being..."
msgstr "　なぜなら、"

#. Occurrence A_4:6918:15021: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_4_0044; voice_prefix=A20; voice_category=11; scene=A_4
#: A_4:6918
msgctxt "text_id=15021 | speaker=touko"
msgid "\"The opening act's over. Come out, Beo.\""
msgstr "「ま、前座は終わりだ。―――来い、ベオ」"

#. Occurrence A_4:6923:15022: scene=A_4
#: A_4:6923
msgctxt "text_id=15022 | speaker=unknown"
msgid "  ...This was no longer a battle of skill."
msgstr "　技を競い合う戦いではなく、"

#. Occurrence A_4:6928:15023: scene=A_4
#: A_4:6928
msgctxt "text_id=15023 | speaker=unknown"
msgid "  A fight for survival had begun."
msgstr "　命を奪い合う戦いは、ここから始まるのだから。"

#. Occurrence A_4:6977:15024: scene=A_4
#: A_4:6977
msgctxt "text_id=15024 | speaker=unknown"
msgid "  Snap went Touko's fingers."
msgstr "　ぱちん、と指を鳴らす橙子。"

#. Occurrence A_4:6983:15025: scene=A_4
#: A_4:6983
msgctxt "text_id=15025 | speaker=unknown"
msgid "  In response, a beautiful, high-pitched melody floated up toward the moon."
msgstr "　その呼びかけに応じて、一際高く、美しい旋律が月に伸びた。"

#. Occurrence A_4:6988:15026: scene=A_4
#: A_4:6988
msgctxt "text_id=15026 | speaker=unknown"
msgid "  It echoed all around them."
msgstr "　……どこまでも響く弦楽器。"

#. Occurrence A_4:6993:15027: scene=A_4
#: A_4:6993
msgctxt "text_id=15027 | speaker=unknown"
msgid "  The spiral howl dredged up ancient, primal memories."
msgstr "　太古の記憶を呼び覚ます<螺旋|らせん>の<咆哮|ほうこう>。"

#. Occurrence A_4:7000:15028: scene=A_4
#: A_4:7000
msgctxt "text_id=15028 | speaker=unknown"
msgid "  Its source emerged from the shadows and landed next to the mage."
msgstr "　その音の主は、闇の中から魔術師の真横に舞い降りた。"

#. Occurrence A_4:7026:15029: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0027; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:7026
msgctxt "text_id=15029 | speaker=alice"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence A_4:7031:15030: scene=A_4
#: A_4:7031
msgctxt "text_id=15030 | speaker=unknown"
msgid "  Alice's lip trembled faintly."
msgstr "　<少女|アリス>の口が、かすかにわななく。"

#. Occurrence A_4:7036:15031: scene=A_4
#: A_4:7036
msgctxt "text_id=15031 | speaker=unknown"
msgid "  Not from fear,"
msgstr "　恐怖によるものではない。"

#. Occurrence A_4:7069:15032: scene=A_4
#: A_4:7069
msgctxt "text_id=15032 | speaker=unknown"
msgid "  but with admiration, once she recognized the creature before her."
msgstr "　あれがどのような生き物なのか一目で受け入れ、感動で唇を震わせたのだ。"

#. Occurrence A_4:7102:15033: scene=A_4
#: A_4:7102
msgctxt "text_id=15033 | speaker=unknown"
msgid "  It was a majestic golden beast,"
msgstr "　あまりにも美しい<黄金|おうごん>の獣。"

#. Occurrence A_4:7108:15034: scene=A_4
#: A_4:7108
msgctxt "text_id=15034 | speaker=unknown"
msgid "  beyond the domain of both magical and phantasmal-simply divine."
msgstr "　魔でもなく幻でもなく、聖なるものにも留まらない。"

#. Occurrence A_4:7113:15035: scene=A_4
#: A_4:7113
msgctxt "text_id=15035 | speaker=unknown"
msgid "  It was a life that should have passed from the world with the Age of Gods..."
msgstr "　それは絶滅した<神代|しんだい>の<生命|いのち>。"

#. Occurrence A_4:7118:15036: scene=A_4
#: A_4:7118
msgctxt "text_id=15036 | speaker=unknown"
msgid "  A Mystic derived from human wisdom, preserved by thousands of generations of hidden tradition."
msgstr "　人智による神秘。積み重ねられた秘儀伝承。"

#. Occurrence A_4:7124:15037: scene=A_4
#: A_4:7124
msgctxt "text_id=15037 | speaker=unknown"
msgid "  A recreation of a miracle that once freely walked the earth-"
msgstr "　地に<遍|あまね>く在る奇跡の再現―――"

msgctxt "text_id=15038 | speaker=unknown"
msgid "  The *natural enemy* of magecraft, able to crush it with ease."
msgstr "　その一切をかみ砕く、<本|・><当|・><の|・><魔|・><術|・><の|・><天|・><敵|・>。"

#. Occurrence A_4:7166:15039: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_4_0028; voice_prefix=A40; voice_category=2; scene=A_4
#: A_4:7166
msgctxt "text_id=15039 | speaker=alice"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence A_4:7171:15040: scene=A_4
#: A_4:7171
msgctxt "text_id=15040 | speaker=unknown"
msgid "  Quiet resignation settled over Alice's face."
msgstr "　少女の眼が、静かな<諦|あきら>めに<翳|かげ>る。"

#. Occurrence A_4:7177:15041: scene=A_4
#: A_4:7177
msgctxt "text_id=15041 | speaker=unknown"
msgid "  The golden beast charged."
msgstr "　黄金の獣が駆ける。"

#. Occurrence A_4:7185:15042: scene=A_4
#: A_4:7185
msgctxt "text_id=15042 | speaker=unknown"
msgid "  This time, she didn't even have a chance to admit defeat."
msgstr "　―――今度は詰んだとすら、思えなかった。"

#. Occurrence A_5:51:15043: scene=A_5
#: A_5:51
msgctxt "text_id=15043 | speaker=unknown"
msgid "  She could hear the beast's breathing in her ear."
msgstr "　―――すぐ<傍|そば>で、獣の息遣いが聞こえる。"

#. Occurrence A_5:81:15044: scene=A_5
#: A_5:81
msgctxt "text_id=15044 | speaker=unknown"
msgid "  It seemed she had been unconscious for a short time."
msgstr "　どうやら、意識が数秒ほど途切れていたようだ。"

#. Occurrence A_5:110:15045: scene=A_5
#: A_5:110
msgctxt "text_id=15045 | speaker=unknown"
msgid "  Alice opened her eyes, and took a deep breath."
msgstr "　有珠は目を開けて、息を吸う。"

#. Occurrence A_5:181:15046: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_5_0000; voice_prefix=A40; voice_category=2; scene=A_5
#: A_5:181
msgctxt "text_id=15046 | speaker=alice"
msgid "\"...\""
msgstr "「―――、―――」"

#. Occurrence A_5:186:15047: scene=A_5
#: A_5:186
msgctxt "text_id=15047 | speaker=unknown"
msgid "  Each cough sent pain shooting through her body."
msgstr "　咳きこむように苦痛を漏らす。"

#. Occurrence A_5:195:15048: scene=A_5
#: A_5:195
msgctxt "text_id=15048 | speaker=unknown"
msgid "  Blood rose from the pit of her stomach, and she spat it onto the cold ground."
msgstr "　喉もとから逆流した血が、冷たい地面を濡らす。"

#. Occurrence A_5:200:15049: scene=A_5
#: A_5:200
msgctxt "text_id=15049 | speaker=unknown"
msgid "  When her vision returned, she was able to make out the distant sky, falling snow, and the golden wolf."
msgstr "　焦点を取り戻した視覚が、高い空と、また降りだした雪と、黄金の狼を認めていた。"

#. Occurrence A_5:235:15050: scene=A_5
#: A_5:235
msgctxt "text_id=15050 | speaker=unknown"
msgid "  The wolf panted."
msgstr "　狼の息遣いは荒々しい。"

#. Occurrence A_5:240:15051: scene=A_5
#: A_5:240
msgctxt "text_id=15051 | speaker=unknown"
msgid "  It stared at Alice, saliva dripping from its mouth onto her cheek."
msgstr "　<涎|よだれ>を舌からこぼしながら、有珠の顔を覗きこんでいる。"

#. Occurrence A_5:262:15052: scene=A_5
#: A_5:262
msgctxt "text_id=15052 | speaker=unknown"
msgid "  Razor-sharp fangs lined its jaws."
msgstr "　ノコギリのような牙と口。"

#. Occurrence A_5:267:15053: scene=A_5
#: A_5:267
msgctxt "text_id=15053 | speaker=unknown"
msgid "  Its fur was glossier than that of any animal she had ever seen."
msgstr "　この世のどんな動物より柔らかく、艶やかな毛並み。"

#. Occurrence A_5:272:15054: scene=A_5
#: A_5:272
msgctxt "text_id=15054 | speaker=unknown"
msgid "  Brutal, knife-like claws protruded from its massive blood-stained paws."
msgstr "　血に染まった<前脚|あし>の爪は、まるで包丁を三本揃えたような凶悪さだ。"

#. Occurrence A_5:277:15055: scene=A_5
#: A_5:277
msgctxt "text_id=15055 | speaker=unknown"
msgid "  And yet, it did not smell like a beast."
msgstr "　それでも、粗野な臭いは微塵もない。"

#. Occurrence A_5:282:15056: scene=A_5
#: A_5:282
msgctxt "text_id=15056 | speaker=unknown"
msgid "  Surely, the presence of such a noble creature, a human would feel like the lesser animal."
msgstr "　この金狼の前では、人間の方が己が<獣性|じゅうせい>に恥じ入るだろう。"

#. Occurrence A_5:302:15057: scene=A_5
#: A_5:302
msgctxt "text_id=15057 | speaker=unknown"
msgid "  The battle between Alice and the wolf was over before it had begun."
msgstr "　……有珠と狼の戦いはあっけなく終わった。"

#. Occurrence A_5:309:15058: scene=A_5
#: A_5:309
msgctxt "text_id=15058 | speaker=unknown"
msgid "  After destroying the troll, it baptized Alice with its wicked claws, giving her no chance to escape."
msgstr "　橋の巨人は金狼の前に破れ、有珠は逃げる事もできず、その凶悪な前脚の洗礼を受けた。"

#. Occurrence A_5:314:15059: scene=A_5
#: A_5:314
msgctxt "text_id=15059 | speaker=unknown"
msgid "  Its side-swipe had torn into her abdomen like a sword,"
msgstr "　剣のような横殴りの衝撃が、有珠の腹を一閃したのだ。"

#. Occurrence A_5:319:15060: scene=A_5
#: A_5:319
msgctxt "text_id=15060 | speaker=unknown"
msgid "  carving through her clothes and flesh, all the way to her heart."
msgstr "　服はもちろん、内臓まで吹き飛んだ。"

#. Occurrence A_5:324:15061: scene=A_5
#: A_5:324
msgctxt "text_id=15061 | speaker=unknown"
msgid "  Even so, not once did Alice make a sound."
msgstr "　その決定的な瞬間でさえ、有珠は声をあげなかった。"

#. Occurrence A_5:358:15062: scene=A_5
#: A_5:358
msgctxt "text_id=15062 | speaker=unknown"
msgid "  The wolf had her pinned, and stared at her face."
msgstr "　狼は有珠を押し倒し、その顔を覗きこむ。"

#. Occurrence A_5:363:15063: scene=A_5
#: A_5:363
msgctxt "text_id=15063 | speaker=unknown"
msgid "  Her limbs felt ready to break at any moment."
msgstr "　触れれば折れかねない少女の四肢にのしかかる。"

#. Occurrence A_5:368:15064: scene=A_5
#: A_5:368
msgctxt "text_id=15064 | speaker=unknown"
msgid "  That was the situation she found herself in."
msgstr "　それが<現在|いま>の状態だ。"

#. Occurrence A_5:373:15065: scene=A_5
#: A_5:373
msgctxt "text_id=15065 | speaker=unknown"
msgid "  Now fully conscious, Alice stared at her enemy through pained eyes."
msgstr "　意識を取り戻した有珠は苦しげな瞳で敵を見据える。"

#. Occurrence A_5:378:15066: scene=A_5
#: A_5:378
msgctxt "text_id=15066 | speaker=unknown"
msgid "  She felt no fear,"
msgstr "　そこに恐怖はない。"

#. Occurrence A_5:383:15067: scene=A_5
#: A_5:383
msgctxt "text_id=15067 | speaker=unknown"
msgid "  only cold reality sinking in."
msgstr "　あるのは、現実を受け入れる冷めた色だけだった。"

#. Occurrence A_5:409:15068: scene=A_5
#: A_5:409
msgctxt "text_id=15068 | speaker=unknown"
msgid "  Sensing Alice's demeanor, the wolf suddenly paused, its paw still raised."
msgstr "　有珠の覚悟に感じ入ったのか、狼は振り上げた前脚を停止させる。"

#. Occurrence A_5:414:15069: scene=A_5
#: A_5:414
msgctxt "text_id=15069 | speaker=unknown"
msgid "  They looked into each other's eyes."
msgstr "　少女の黒い瞳と、狼の眼が交差した後―――"

#. Occurrence A_5:422:15070: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_A_5_0000; voice_prefix=A50; voice_category=12; scene=A_5
#: A_5:422
msgctxt "text_id=15070 | speaker=beo"
msgid "\"You're bleeding. Doesn't it hurt?\""
msgstr "「“そんなに血が出てるのに、痛くないんだ”」"

#. Occurrence A_5:428:15071: scene=A_5
#: A_5:428
msgctxt "text_id=15071 | speaker=unknown"
msgid "  The wolf's voice came as a surprise."
msgstr "　思いがけない声があった。"

#. Occurrence A_5:433:15072: scene=A_5
#: A_5:433
msgctxt "text_id=15072 | speaker=unknown"
msgid "  But there was no doubt it had spoken."
msgstr "　それは間違いなく、目前の狼が発した<言|も><葉|の>だ。"

#. Occurrence A_5:454:15073: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_A_5_0001; voice_prefix=A50; voice_category=12; scene=A_5
#: A_5:454
msgctxt "text_id=15073 | speaker=beo"
msgid "\"Or are you just fine with pain?\""
msgstr "「“それとも、痛いのは平気なのかな”」"

#. Occurrence A_5:459:15074: scene=A_5
#: A_5:459
msgctxt "text_id=15074 | speaker=unknown"
msgid "  The wolf's voice sounded innocent, almost childlike."
msgstr "　邪気のない、子供のようなイントネーション。"

#. Occurrence A_5:464:15075: scene=A_5
#: A_5:464
msgctxt "text_id=15075 | speaker=unknown"
msgid "  In complete contrast to what had happened up to that point, the wolf smiled."
msgstr "　狼は不釣り合いな、これまでの風格を台無しにする笑みを両眼に浮かべ、"

#. Occurrence A_5:486:15076: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_A_5_0002; voice_prefix=A50; voice_category=12; scene=A_5
#: A_5:486
msgctxt "text_id=15076 | speaker=beo"
msgid "\"Either way, you've got guts, lady!\""
msgstr "「“どっちにしろ我慢強いんだね、お姉ちゃんは……！”」"

#. Occurrence A_5:494:15077: scene=A_5
#: A_5:494
msgctxt "text_id=15077 | speaker=unknown"
msgid "  The wolf opened its mouth wide and clamped its jaws around Alice's neck."
msgstr "　大口を開けて、少女の首にかぶりついた。"

#. Occurrence A_5:545:15078: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0000; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:545
msgctxt "text_id=15078 | speaker=touko"
msgid "\"Beo!\""
msgstr "「ベオ―――！」"

#. Occurrence A_5:550:15079: scene=A_5
#: A_5:550
msgctxt "text_id=15079 | speaker=unknown"
msgid "  Touko's tone was sharper than the wolf's fangs."
msgstr "　閉じられる狼の牙より、なお鋭い橙子の<叱責|しっせき>。"

#. Occurrence A_5:555:15080: scene=A_5
#: A_5:555
msgctxt "text_id=15080 | speaker=unknown"
msgid "  The wolf froze."
msgstr "　それに驚くような動作で、狼はびくりと停止した。"

#. Occurrence A_5:600:15081: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_A_5_0003; voice_prefix=A50; voice_category=12; scene=A_5
#: A_5:600
msgctxt "text_id=15081 | speaker=beo"
msgid "\"Miss Touko...\""
msgstr "「“……トーコさん”」"

#. Occurrence A_5:605:15082: scene=A_5
#: A_5:605
msgctxt "text_id=15082 | speaker=unknown"
msgid "  He let go and slowly turned his head towards the voice."
msgstr "　狼はゆっくりと背後を振り返る。"

#. Occurrence A_5:621:15083: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0001; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:621
msgctxt "text_id=15083 | speaker=touko"
msgid "\"Didn't I tell you not to finish her off? Are you trying to make extra work for me, you mutt?\""
msgstr "「トドメは刺すなと言ったろう。余計な仕事を増やす気か、バカモン」"

#. Occurrence A_5:627:15084: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_A_5_0004; voice_prefix=A50; voice_category=12; scene=A_5
#: A_5:627
msgctxt "text_id=15084 | speaker=beo"
msgid "\"Tch... But that's the best part."
msgstr "「“ちぇっ。それはそれで楽しいのに。"

#. Occurrence A_5:653:15085: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_A_5_0005; voice_prefix=A50; voice_category=12; scene=A_5
#: A_5:653
msgctxt "text_id=15085 | speaker=beo"
msgid "  Well this was a washout. And that troll went down like everything else. Talk about a disappointment.\""
msgstr "　あーあ、たいくつー。話に聞いた橋の巨人も、結局は他の生き物と一緒だったしー”」"

#. Occurrence A_5:685:15086: scene=A_5
#: A_5:685
msgctxt "text_id=15086 | speaker=unknown"
msgid "  The wolf backed away from Alice,"
msgstr "　橙子の叱責を受け、狼は有珠からトボトボと離れていった。"

#. Occurrence A_5:690:15087: scene=A_5
#: A_5:690
msgctxt "text_id=15087 | speaker=unknown"
msgid "  as if no longer interested in his prey."
msgstr "　もう何の興味もないように。"

#. Occurrence A_5:695:15088: scene=A_5
#: A_5:695
msgctxt "text_id=15088 | speaker=unknown"
msgid "  To the golden beast, she was little more than an old chew toy."
msgstr "　あの黄金の獣にとって、有珠は道ばたの草ほどの価値もないらしい。"

#. Occurrence A_5:732:15089: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_5_0001; voice_prefix=A40; voice_category=2; scene=A_5
#: A_5:732
msgctxt "text_id=15089 | speaker=alice"
msgid "\"...Ngh...\""
msgstr "「―――、っ―――」"

#. Occurrence A_5:755:15090: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0002; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:755
msgctxt "text_id=15090 | speaker=touko"
msgid "\"Conscious again, even with all that blood loss and broken bones? You're tough. Do I have the Meinster training to thank?\""
msgstr "「なんだ、もう意識が戻ったのか。心もタフなら体もたいがいだな。骨まで砕いて、その程度の出血とは。マインスターの教育のたまものかい？」"

#. Occurrence A_5:812:15091: scene=A_5
#: A_5:812
msgctxt "text_id=15091 | speaker=unknown"
msgid "  Barely clinging to life, Alice stared at Touko."
msgstr "　有珠は死に<瀕|ひん>した体で、蒼崎橙子を凝視する。"

#. Occurrence A_5:817:15092: scene=A_5
#: A_5:817
msgctxt "text_id=15092 | speaker=unknown"
msgid "  But not a stare of hatred in defeat, but one of disbelief. Alice simply wondered why Touko had brought such a beast."
msgstr "　<敗|やぶ>れた憎しみからではなく、なぜあんなものを連れているのか、という糾弾から。"

#. Occurrence A_5:845:15093: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0003; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:845
msgctxt "text_id=15093 | speaker=touko"
msgid "\"Ah, pardon me. I should have introduced you."
msgstr "「ああ、紹介が遅れたな。"

#. Occurrence A_5:851:15094: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0004; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:851
msgctxt "text_id=15094 | speaker=touko"
msgid "  This is the last known werewolf on Earth."
msgstr "　彼はおそらく地上で現存している最後の<人狼|じんろう>だ。"

#. Occurrence A_5:858:15095: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0005; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:858
msgctxt "text_id=15095 | speaker=touko"
msgid "A pureblood, born to an indigenous tribe in the northern European tundra."
msgstr "北欧の奥地に生きる彼らの一族の中に現れた、生粋の原種だよ。"

#. Occurrence A_5:864:15096: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0006; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:864
msgctxt "text_id=15096 | speaker=touko"
msgid "  As you can see, he's a golden Mystic, and it doesn't do him justice to say he merely resembles his ancestors. He didn't have a name, so I called him Beowulf. Pretty apt, right?\""
msgstr "　見ての通り、先祖返りなんて言葉じゃ表せない黄金の神秘でね。名前がなかったんで、分かりやすくベオウルフと呼んでいる」"

#. Occurrence A_5:905:15097: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_5_0002; voice_prefix=A40; voice_category=2; scene=A_5
#: A_5:905
msgctxt "text_id=15097 | speaker=alice"
msgid "\"Beo...wulf?\""
msgstr "「ベオ……ウルフ？」"

#. Occurrence A_5:911:15098: scene=A_5
#: A_5:911
msgctxt "text_id=15098 | speaker=unknown"
msgid "  Alice's face was perplexed, even though she hadn't wavered when she was disemboweled."
msgstr "　腹部を裂く爪にさえ乱れなかった有珠の<表|か><情|お>が、<怪訝|けげん>に<曇|くも>る。"

#. Occurrence A_5:916:15099: scene=A_5
#: A_5:916
msgctxt "text_id=15099 | speaker=unknown"
msgid "  Beowulf."
msgstr "　ベオウルフ。"

#. Occurrence A_5:921:15100: scene=A_5
#: A_5:921
msgctxt "text_id=15100 | speaker=unknown"
msgid "  The name of the heroic giant slayer from Danish legend."
msgstr "　デンマークに伝わる、巨人殺しの英雄の名前。"

#. Occurrence A_5:926:15101: scene=A_5
#: A_5:926
msgctxt "text_id=15101 | speaker=unknown"
msgid "  It came from old English; a combination of 'honeybee' and 'wild beast'-a 'bear,' in other words."
msgstr "　その名は古英語でいうところのミツバチと野生の獣の組み合わせで、つまるところは熊を意味する。"

#. Occurrence A_5:965:15102: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_5_0003; voice_prefix=A40; voice_category=2; scene=A_5
#: A_5:965
msgctxt "text_id=15102 | speaker=alice"
msgid "\"...Kind of an... Incongruous... name...\""
msgstr "「―――なんで、そんな、ちぐはぐな名前、を」"

#. Occurrence A_5:971:15103: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0007; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:971
msgctxt "text_id=15103 | speaker=touko"
msgid "\"What do you mean? It's cute!\""
msgstr "「うん？　いや、可愛いからに決まってるだろ」"

#. Occurrence A_5:1002:15104: scene=A_5
#: A_5:1002
msgctxt "text_id=15104 | speaker=unknown"
msgid "  Perhaps because of the name, or because of the golden beast itself,"
msgstr "　それはベオウルフという名前にかかったものか、金狼自体にかかったものか。"

#. Occurrence A_5:1007:15105: scene=A_5
#: A_5:1007
msgctxt "text_id=15105 | speaker=unknown"
msgid "  Fighting the pain, Alice struggled to read Touko. In this respect, she was worse than Aoko."
msgstr "　この女の感性は青子より分かりづらい、と有珠は痛みをかみ殺した。"

#. Occurrence A_5:1062:15106: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0008; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1062
msgctxt "text_id=15106 | speaker=touko"
msgid "\"Incidentally, Beo called these other mutts in. Naturally, I didn't think they'd have any effect on a Meinster's daughter."
msgstr "「ついでに説明しておくと、周りの犬どもはベオが勝手に呼び寄せたものだ。私自身、マインスターの娘がただの畜生に傷つけられるとは思ってはいないよ。"

#. Occurrence A_5:1068:15107: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0009; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1068
msgctxt "text_id=15107 | speaker=touko"
msgid "  For now, at least.\""
msgstr "　―――今のところは、ね」"

#. Occurrence A_5:1115:15108: scene=A_5
#: A_5:1115
msgctxt "text_id=15108 | speaker=unknown"
msgid "  Touko's mouth twisted into a grin."
msgstr "　それだけ言うと、橙子は小さく微笑んだ。"

#. Occurrence A_5:1120:15109: scene=A_5
#: A_5:1120
msgctxt "text_id=15109 | speaker=unknown"
msgid "  Not the warm one Soujyuro saw, but the merciless smile a victor displays to a loser."
msgstr "　草十郎に見せた温かなものではなく、勝者が敗者に見せる無慈悲な笑みを。"

#. Occurrence A_5:1125:15110: scene=A_5
#: A_5:1125
msgctxt "text_id=15110 | speaker=unknown"
msgid "  The disdain in Alice's eyes turned to anger."
msgstr "　有珠の瞳にこもった批難は、今や怒りに変わっている。"

#. Occurrence A_5:1164:15111: scene=A_5
#: A_5:1164
msgctxt "text_id=15111 | speaker=unknown"
msgid "  The golden Mystic."
msgstr "　黄金の神秘。"

#. Occurrence A_5:1169:15112: scene=A_5
#: A_5:1169
msgctxt "text_id=15112 | speaker=unknown"
msgid "  How could Touko have brought such a creature into the human world?"
msgstr "　そう口にするのなら、なぜこんな人の世界に連れてきてしまったのかと。"

#. Occurrence A_5:1190:15113: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0010; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1190
msgctxt "text_id=15113 | speaker=touko"
msgid "\"Come now, it's just supply and demand."
msgstr "「なに、需要と供給だよ。"

#. Occurrence A_5:1196:15114: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0011; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1196
msgctxt "text_id=15114 | speaker=touko"
msgid "  Depopulation is not just a human problem. Their old ways were unsustainable, and so I bought him for a high price."
msgstr "　過疎化は人間だけの問題じゃあない。彼らもいい加減、昔ながらの生活には限界がきたらしくてね。話し合いの末、高額で私が買い取った。"

#. Occurrence A_5:1202:15115: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0012; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1202
msgctxt "text_id=15115 | speaker=touko"
msgid "  Well, more like I had to pay for the right to bring him out of his cave."
msgstr "　といっても、あくまで<洞|さと>から出すだけの権利だがね。"

#. Occurrence A_5:1227:15116: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0013_0; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1227
msgctxt "text_id=15116 | speaker=touko"
msgid "  As you might've guessed, I used my hair for the contract with Beo. I like to think of it as creating an alliance with a beast instead of creating a famili-"
msgstr "　お察しの通り、私の髪はベオとの契約に使いきった。自分の髪を使って<使い魔|ぶんしん>を造るより、強大な怪物を縛り付けた方がよっぽど健全―――"

#. Occurrence A_5:1239:15117: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0013_1; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1239
msgctxt "text_id=15117 | speaker=touko"
msgid " Hmm?\""
msgstr "む？」"

#. Occurrence A_5:1260:15118: scene=A_5
#: A_5:1260
msgctxt "text_id=15118 | speaker=unknown"
msgid "  While she was talking, Touko noticed something strange."
msgstr "　喋りながら、橙子は眼下の異常を感知した。"

#. Occurrence A_5:1315:15119: scene=A_5
#: A_5:1315
msgctxt "text_id=15119 | speaker=unknown"
msgid "  An unusual sound."
msgstr "　……形容しがたい怪音。"

#. Occurrence A_5:1320:15120: scene=A_5
#: A_5:1320
msgctxt "text_id=15120 | speaker=unknown"
msgid "  A preternatural sound that tore at the mind."
msgstr "　……聞く者の正気を削るような、この世には存在しない音。"

#. Occurrence A_5:1325:15121: scene=A_5
#: A_5:1325
msgctxt "text_id=15121 | speaker=unknown"
msgid "  A sound that should not have existed."
msgstr "　いや、してはならない音。"

#. Occurrence A_5:1359:15122: scene=A_5
#: A_5:1359
msgctxt "text_id=15122 | speaker=unknown"
msgid "  And it was coming from the girl's open abdomen."
msgstr "　それが、少女の裂かれた腹部から<零|こぼ>れている―――"

#. Occurrence A_5:1380:15123: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0014; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1380
msgctxt "text_id=15123 | speaker=touko"
msgid "\"Regenerating already? No...wait...\""
msgstr "「もう復元が始まったか。いや、というより、これは―――」"

#. Occurrence A_5:1405:15124: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_A_5_0006; voice_prefix=A50; voice_category=12; scene=A_5
#: A_5:1405
msgctxt "text_id=15124 | speaker=beo"
msgid "\"Hmmm? Hmm hmm hmm? What's that smell? Smells like something amazing is going to happen!\""
msgstr "「“ん？　ふんふんふんふん？　なにこの匂い。トーコさん、なんかワクワクするコト起きてない？”」"

#. Occurrence A_5:1410:15125: scene=A_5
#: A_5:1410
msgctxt "text_id=15125 | speaker=unknown"
msgid "  Curious, Beowulf moved closer,"
msgstr "　なーにー？　と近寄ってくるベオウルフ。"

#. Occurrence A_5:1415:15126: scene=A_5
#: A_5:1415
msgctxt "text_id=15126 | speaker=unknown"
msgid "  like a puppy examining a new toy."
msgstr "　<玩具|オモチャ>に興味を持った子犬さながらである。"

#. Occurrence A_5:1459:15127: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0015; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1459
msgctxt "text_id=15127 | speaker=touko"
msgid "\"Don't look at it! Stay over there, Beo. Pull yourself together.\""
msgstr "「見るな、あっちに行っていろベオ。正気を失ってもしらんぞ」"

#. Occurrence A_5:1464:15128: scene=A_5
#: A_5:1464
msgctxt "text_id=15128 | speaker=unknown"
msgid "  Touko shooed the mutt away with her hand."
msgstr "　しっし、と橙子は駄犬を手で追い払う。"

#. Occurrence A_5:1474:15129: scene=A_5
#: A_5:1474
msgctxt "text_id=15129 | speaker=unknown"
msgid "  Beowulf lowered his head meekly and withdrew."
msgstr "　ベオウルフは残念そうに、大人しく引き下がった。"

#. Occurrence A_5:1513:15130: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0016; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1513
msgctxt "text_id=15130 | speaker=touko"
msgid "\"I must have trained you wrong, going for a girl's belly like that. Shame on you.\""
msgstr "「……教育方針を間違ったかな。まったく、乙女の<胎|はら>を見ようなんて恥を知れ、恥を」"

#. Occurrence A_5:1538:15131: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_A_5_0007; voice_prefix=A50; voice_category=12; scene=A_5
#: A_5:1538
msgctxt "text_id=15131 | speaker=beo"
msgid "\"So? But how come you're allowed to look?!\""
msgstr "「“えー。トーコさんだって見てるじゃない”」"

#. Occurrence A_5:1574:15132: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0017; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1574
msgctxt "text_id=15132 | speaker=touko"
msgid "\"Idiot! I'm a girl, so it's fine!\""
msgstr "「ばっか、私は乙女だからいいんだ！」"

#. Occurrence A_5:1602:15133: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_5_0004; voice_prefix=A40; voice_category=2; scene=A_5
#: A_5:1602
msgctxt "text_id=15133 | speaker=alice"
msgid "\"...\""
msgstr "「……………………」"

#. Occurrence A_5:1608:15134: scene=A_5
#: A_5:1608
msgctxt "text_id=15134 | speaker=unknown"
msgid "  If Aoko had been here, she would have blasted them away for their impudence, just as she did against Flat Snark."
msgstr "　青子がいたらフラットスナーク戦もかくや、という一撃を放ちかねない暴言だった。"

#. Occurrence A_5:1655:15135: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0018; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1655
msgctxt "text_id=15135 | speaker=touko"
msgid "\"Y'know, I feel sorry for you."
msgstr "「……まあ、しかし惨いな。"

#. Occurrence A_5:1661:15136: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0019; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1661
msgctxt "text_id=15136 | speaker=touko"
msgid "  How could your Meinster mother call herself a parent when she's neglected you so much?\""
msgstr "　<こ|・><ん|・><な|・><に|・><な|・><る|・><ま|・><で|・>放っておくとは、マインスターは人の親とはいえまいよ」"

#. Occurrence A_5:1670:15137: scene=A_5
#: A_5:1670
msgctxt "text_id=15137 | speaker=unknown"
msgid "  With her gloved hand, Touko ran her fingers along the wound on Alice's abdomen."
msgstr "　橙子は手袋をつけたまま、鮮血に染まる有珠の腹部に手を滑らせる。"

#. Occurrence A_5:1691:15138: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_5_0005; voice_prefix=A40; voice_category=2; scene=A_5
#: A_5:1691
msgctxt "text_id=15138 | speaker=alice"
msgid "\"Nng...\""
msgstr "「っ………」"

#. Occurrence A_5:1730:15139: scene=A_5
#: A_5:1730
msgctxt "text_id=15139 | speaker=unknown"
msgid "  A flash of pain ran through Alice's body."
msgstr "　小さく<零|こぼ>れる苦悶。"

#. Occurrence A_5:1735:15140: scene=A_5
#: A_5:1735
msgctxt "text_id=15140 | speaker=unknown"
msgid "  Alice had held in her screams, but she finally let out a long breath."
msgstr "　悲鳴ひとつあげなかった有珠から吐息が漏れる。"

#. Occurrence A_5:1740:15141: scene=A_5
#: A_5:1740
msgctxt "text_id=15141 | speaker=unknown"
msgid "  She turned her face away, in pain or shame."
msgstr "　顔を<背|そむ>けたのは、恥じらいからか、痛みからか。"

#. Occurrence A_5:1763:15142: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0020; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1763
msgctxt "text_id=15142 | speaker=touko"
msgid "\"The skin here's regenerating already. So many crests on the bones, veins, even the internal organs."
msgstr "「ほら、もう肌も復元している。骨格、血管はおろか、内臓にまで施された、<夥|おびただ>しいまでの刻印だ。"

#. Occurrence A_5:1769:15143: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0021; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1769
msgctxt "text_id=15143 | speaker=touko"
msgid "  Having Magic Circuits like that from birth is a double-edged sword."
msgstr "　生後、肉体に魔術回路を付加する事は両刃の剣だ。"

#. Occurrence A_5:1775:15144: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0022; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1775
msgctxt "text_id=15144 | speaker=touko"
msgid "  They cut incantation time, which is a great boon for a mage."
msgstr "　呪文を自分と一体化させる事により、詠唱の手間を省き、術者に多大な利点をもたらす魔術刻印。"

#. Occurrence A_5:1781:15145: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0023; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1781
msgctxt "text_id=15145 | speaker=touko"
msgid "  But the more there are, the more pain they bring. Aozakis have crests in one arm. We've got nothing on you, do we?\""
msgstr "　しかし、それは多ければ多いほど苦痛をともなう。蒼崎の刻印は腕一本分。まあ、君に比べれば少ない方だな」"

#. Occurrence A_5:1831:15146: scene=A_5
#: A_5:1831
msgctxt "text_id=15146 | speaker=unknown"
msgid "  The Magic Crests Touko referred to were the inheritance of the Aozaki family, passed down by their ancestors."
msgstr "　橙子の語る魔術刻印とは、その家系の歴史を形にした遺産の事だ。"

#. Occurrence A_5:1836:15147: scene=A_5
#: A_5:1836
msgctxt "text_id=15147 | speaker=unknown"
msgid "  They can only be inherited."
msgstr "　後継者にしか刻まれない一品もの。"

#. Occurrence A_5:1841:15148: scene=A_5
#: A_5:1841
msgctxt "text_id=15148 | speaker=unknown"
msgid "  Aoko had received the ones that were meant for Touko."
msgstr "　蒼崎橙子が継承するはずだった刻印は、妹である青子の手に渡っている。"

#. Occurrence A_5:1890:15149: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0024; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1890
msgctxt "text_id=15149 | speaker=touko"
msgid "\"However, ours has its own set of drawbacks."
msgstr "「しかし、それも良し悪しだな。"

#. Occurrence A_5:1896:15150: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0025; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1896
msgctxt "text_id=15150 | speaker=touko"
msgid "  The pain Aoko feels in her right arm is the remainder of her human body reacting to being changed into a Mystic."
msgstr "　右腕に刻印をした青子の痛みは、残る人間の体と神秘となった右腕とが反発する程度だ。"

#. Occurrence A_5:1902:15151: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0026; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1902
msgctxt "text_id=15151 | speaker=touko"
msgid "  Her mundane body rejects her right arm, and that pain is the cost of its deletion."
msgstr "　通常の肉体が右腕を否定し、抹消にかかる痛み。"

#. Occurrence A_5:1908:15152: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0027; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1908
msgctxt "text_id=15152 | speaker=touko"
msgid "  It causes both physical and mental phantom pain, like some original sin that can never be wiped away.\""
msgstr "　精神的にも肉体的にも生じる幻痛は、原罪にも似て<拭|ぬぐ>い去る事はできない」"

#. Occurrence A_5:1963:15153: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0028; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1963
msgctxt "text_id=15153 | speaker=touko"
msgid "\"Still, when you've come this far, pain becomes trivial."
msgstr "「……だが、ここまでくると痛みも何もあるまい。"

#. Occurrence A_5:1969:15154: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0029; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1969
msgctxt "text_id=15154 | speaker=touko"
msgid "  It makes it difficult to know if you're really alive."
msgstr "　そもそも生きている実感はあるのか？"

#. Occurrence A_5:1975:15155: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0030; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1975
msgctxt "text_id=15155 | speaker=touko"
msgid "  Do you still believe you're human?"
msgstr "　自分が人間だとまだ信じている？"

#. Occurrence A_5:1999:15156: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0031_0; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:1999
msgctxt "text_id=15156 | speaker=touko"
msgid "  Honestly, I sympathize."
msgstr "　ああ、本当に―――"

#. Occurrence A_5:2007:15157: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0031_1; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:2007
msgctxt "text_id=15157 | speaker=touko"
msgid "We've both had a hard time with such extraordinary teachers, haven't we, Alice?\""
msgstr "お互い、非凡な師を持つと苦労するね、有珠」"

#. Occurrence A_5:2055:15158: scene=A_5
#: A_5:2055
msgctxt "text_id=15158 | speaker=unknown"
msgid "  Touko took Alice's body in her arms."
msgstr "　そうして、橙子は有珠の体を抱き起こした。"

#. Occurrence A_5:2060:15159: scene=A_5
#: A_5:2060
msgctxt "text_id=15159 | speaker=unknown"
msgid "  The wounds from Beowulf had mostly healed."
msgstr "　ベオウルフに裂かれた腹部はもう大部分が<塞|ふさ>がっている。"

#. Occurrence A_5:2077:15160: scene=A_5
#: A_5:2077
msgctxt "text_id=15160 | speaker=unknown"
msgid "  Even so, her breathing was shallow, likely due to the pain."
msgstr "　それでも痛みは残っているのか、有珠の呼吸はあまりにもか細く、弱い。"

#. Occurrence A_5:2082:15161: scene=A_5
#: A_5:2082
msgctxt "text_id=15161 | speaker=unknown"
msgid "  Touko gently held the girl's face in her hand."
msgstr "　そんな少女の顔を、橙子は優しく持ち上げる。"

#. Occurrence A_5:2136:15162: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0032; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:2136
msgctxt "text_id=15162 | speaker=touko"
msgid "\"I'm indebted to your Meinster mother. And my true opponent has only ever been Aoko.\""
msgstr "「マインスターには恩がある。それに、私の相手はあくまで青子ひとりだ」"

#. Occurrence A_5:2171:15163: scene=A_5
#: A_5:2171
msgctxt "text_id=15163 | speaker=unknown"
msgid "  Alice's lungs pined for oxygen; Touko pressed her lips to hers."
msgstr "　無惨に酸素を求める有珠の唇が、橙子の唇に塞がれる。"

#. Occurrence A_5:2176:15164: scene=A_5
#: A_5:2176
msgctxt "text_id=15164 | speaker=unknown"
msgid "  The young girl wriggled, trying to escape, but Touko held her firmly."
msgstr "　身をよじって逃れる少女の肩を、魔術師の腕が掴み縛る。"

#. Occurrence A_5:2196:15165: scene=A_5
#: A_5:2196
msgctxt "text_id=15165 | speaker=unknown"
msgid "  Beneath the blue moon, the two remained frozen."
msgstr "　蒼い月の下、両者は凍り付いたように動かない。"

#. Occurrence A_5:2202:15166: scene=A_5
#: A_5:2202
msgctxt "text_id=15166 | speaker=unknown"
msgid "  Then, the sound of swallowing."
msgstr "　こくり、と嚥下する音。"

#. Occurrence A_5:2231:15167: scene=A_5
#: A_5:2231
msgctxt "text_id=15167 | speaker=unknown"
msgid "  Something solid slid down Alice's throat. With that, she went limp and her arm fell."
msgstr "　有珠の喉に滑り落ちる固形物。それきり、少女は力を失って崩れ落ちた。"

#. Occurrence A_5:2282:15168: scene=A_5
#: A_5:2282
msgctxt "text_id=15168 | speaker=unknown"
msgid "  After setting Alice down on her side, Touko stood up."
msgstr "　弱々しく横になった有珠を見届け、橙子は立ち上がる。"

#. Occurrence A_5:2293:15169: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0033; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:2293
msgctxt "text_id=15169 | speaker=touko"
msgid "\"I've given you a dose of my own blend of rowan, not easily counteracted. If you use magical energy, it'll explode, so do be careful."
msgstr "「今のはナナカマドに手を加えた私の特製品だ。そう簡単に解毒はできない。魔力を流せば体の中で暴発する仕組みになっているから気をつけなさい。"

#. Occurrence A_5:2306:15170: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0034; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:2306
msgctxt "text_id=15170 | speaker=touko"
msgid "  Oh, and... don't read too much into it. Passing things with y mouth is just something I like to do.\""
msgstr "　―――ああ、口移しは私の趣味だから、特に気にする事はないよ」"

#. Occurrence A_5:2329:15171: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_5_0006; voice_prefix=A40; voice_category=2; scene=A_5
#: A_5:2329
msgctxt "text_id=15171 | speaker=alice"
msgid "\"...\""
msgstr "「…………………………」"

#. Occurrence A_5:2349:15172: scene=A_5
#: A_5:2349
msgctxt "text_id=15172 | speaker=unknown"
msgid "  As she desperately clung to consciousness, Alice looked up at Touko from the ground."
msgstr "　有珠は地面に倒れたまま、必死に意識をたもって橙子を見上げる。"

#. Occurrence A_5:2355:15173: scene=A_5
#: A_5:2355
msgctxt "text_id=15173 | speaker=unknown"
msgid "The disgrace from the kiss was greater than the pain she felt in her body."
msgstr "体の痛みより、今の口づけの方がよっぽどダメージが大きかったと睨むように。"

#. Occurrence A_5:2360:15174: scene=A_5
#: A_5:2360
msgctxt "text_id=15174 | speaker=unknown"
msgid "  Touko began walking away, her golden wolf in tow. Neither looked back to see Alice's hateful glare."
msgstr "　恨みがましい視線に振りかえる事もなく、橙子は黄金の狼を従えて歩きだす。"

#. Occurrence A_5:2403:15175: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0035; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:2403
msgctxt "text_id=15175 | speaker=touko"
msgid "\"Ah! I almost forgot."
msgstr "「と。そうそう、ひとつ言い忘れていた。"

#. Occurrence A_5:2409:15176: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0036; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:2409
msgctxt "text_id=15176 | speaker=touko"
msgid "  Remember those mutts Beo called? There's a ton of them around the park, and unfortunately they're still hungry."
msgstr "　ベオが呼び寄せた野犬たちだけどね、公園の外にまだ山ほどいるんだが―――困ったコトに、彼らは本来<何|・><を|・><口|・><に|・><す|・><る|・><べ|・><き|・><か|・>を思い出している。"

#. Occurrence A_5:2415:15177: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0037; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:2415
msgctxt "text_id=15177 | speaker=touko"
msgid "  Beo's an alpha male. Seeing what Beo did to you must've really fired them up.\""
msgstr "　ベオの野性に刺激されたんだろう。獣は、より強い獣に従うものだからな」"

#. Occurrence A_5:2452:15178: scene=A_5
#: A_5:2452
msgctxt "text_id=15178 | speaker=unknown"
msgid "  In a roundabout way, Touko had read Alice her last rites."
msgstr "　遠回しな死刑宣告。"

#. Occurrence A_5:2457:15179: scene=A_5
#: A_5:2457
msgctxt "text_id=15179 | speaker=unknown"
msgid "  In nature, it was common for the weak that could no longer move to offer their bodies up to feed the strong."
msgstr "　自然界において、動かなくなった動物は、まだ動く動物に<肉|からだ>を捧げるのが習わしだ。"

#. Occurrence A_5:2478:15180: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_5_0038; voice_prefix=A20; voice_category=11; scene=A_5
#: A_5:2478
msgctxt "text_id=15180 | speaker=touko"
msgid "\"Well, Alice, I think that's everything. It's a long walk back, but hopefully you make it safely.\""
msgstr "「じゃあ私は行くよ。歩く事も満足にできないだろうが、無事に帰れるといいね、有珠」"

#. Occurrence A_5:2513:15181: scene=A_5
#: A_5:2513
msgctxt "text_id=15181 | speaker=unknown"
msgid "  With a twisted grin, the mage headed into the darkness."
msgstr "　口元をいびつに歪ませて、魔術師は退場した。"

#. Occurrence A_5:2547:15182: scene=A_5
#: A_5:2547
msgctxt "text_id=15182 | speaker=unknown"
msgid "  As her footsteps faded, the sound of growls grew louder."
msgstr "　それと入れ替わるように、飢えた<彼|・><ら|・>の声が集まってくる。"

#. Occurrence A_5:2568:15183: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_5_0007; voice_prefix=A40; voice_category=2; scene=A_5
#: A_5:2568
msgctxt "text_id=15183 | speaker=alice"
msgid "\"...\""
msgstr "「…………、――――――」"

#. Occurrence A_5:2574:15184: scene=A_5
#: A_5:2574
msgctxt "text_id=15184 | speaker=unknown"
msgid "  Alice could still barely focus her eyes."
msgstr "　……有珠の視界はいまだ定まらない。"

#. Occurrence A_5:2579:15185: scene=A_5
#: A_5:2579
msgctxt "text_id=15185 | speaker=unknown"
msgid "  The hounds looked like monsters out of a picture book."
msgstr "　集まりだした野犬は、絵本に出てくるお化けのようだ。"

#. Occurrence A_5:2612:15186: scene=A_5
#: A_5:2612
msgctxt "text_id=15186 | speaker=unknown"
msgid "  Alice took a deep breath, her consciousness slipping away."
msgstr "　薄れゆく意識の中で、有珠は大きく息を吐いた。"

#. Occurrence A_5:2617:15187: scene=A_5
#: A_5:2617
msgctxt "text_id=15187 | speaker=unknown"
msgid "  The sky was blue... The trees were tall... The park was a graveyard..."
msgstr "　空は青く、森は高く、広場に救いはない。"

#. Occurrence A_5:2652:15188: scene=A_5
#: A_5:2652
msgctxt "text_id=15188 | speaker=unknown"
msgid "  In the corner of her eye, though, Alice could just about make out a solitary phone booth."
msgstr "　うつろな視界の隅には、場違いな電話ボックスがひとつ。"

#. Occurrence A_6:39:15189: scene=A_6
#: A_6:39
msgctxt "text_id=15189 | speaker=unknown"
msgid "  The phone rang."
msgstr "　電話が鳴った。"

#. Occurrence A_6:55:15190: scene=A_6
#: A_6:55
msgctxt "text_id=15190 | speaker=unknown"
msgid "  It was the second time Soujyuro had heard its voice echo through the cold foyer."
msgstr "　草十郎にとって二回目にあたる電話の音は、深夜のロビーに寒々しく響き渡った。"

#. Occurrence A_6:60:15191: scene=A_6
#: A_6:60
msgctxt "text_id=15191 | speaker=unknown"
msgid "  Only a few minutes had passed since Alice called."
msgstr "　有珠の電話から、まだ数分と経っていない。"

#. Occurrence A_6:65:15192: scene=A_6
#: A_6:65
msgctxt "text_id=15192 | speaker=unknown"
msgid "  He wondered what she could want this time."
msgstr "　彼女の用件はなんだったのか。"

#. Occurrence A_6:81:15193: scene=A_6
#: A_6:81
msgctxt "text_id=15193 | speaker=unknown"
msgid "  The call persisted, determined not to leave him to his thoughts."
msgstr "　ひとり考えこむ草十郎の目を覚ますように、コール音は鳴り響く。"

#. Occurrence A_6:107:15194: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_6_0000; voice_prefix=A30; voice_category=3; scene=A_6
#: A_6:107
msgctxt "text_id=15194 | speaker=soujuurou"
msgid "\"Hello, Kuonji residence.\""
msgstr "「はい、久遠寺ですが」"

#. Occurrence A_6:113:15195: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0000; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:113
msgctxt "text_id=15195 | speaker=touko"
msgid "\"Oh, is that Soujyuro I hear?\""
msgstr "「あら、その声は草十郎くん？」"

#. Occurrence A_6:119:15196: scene=A_6
#: A_6:119
msgctxt "text_id=15196 | speaker=unknown"
msgid "  A cheery voice? Soujyuro had been expecting Alice."
msgstr "　また有珠からの電話では、という草十郎の予想を裏切る明るい声。"

#. Occurrence A_6:124:15197: scene=A_6
#: A_6:124
msgctxt "text_id=15197 | speaker=unknown"
msgid "  It was Touko Aozaki. Somehow, Soujyuro was not surprised."
msgstr "　声の主は蒼崎橙子で、予想外の相手に草十郎はかすかに当惑……はしなかった。"

#. Occurrence A_6:150:15198: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_6_0001; voice_prefix=A30; voice_category=3; scene=A_6
#: A_6:150
msgctxt "text_id=15198 | speaker=soujuurou"
msgid "\"Yes, it's me. How are you, Touko?\""
msgstr "「そうですけど。橙子さん、暇なんですか？」"

#. Occurrence A_6:156:15199: scene=A_6
#: A_6:156
msgctxt "text_id=15199 | speaker=unknown"
msgid "  He checked the time; he thought it was about midnight by now."
msgstr "　たしかもうじき午前零時になるな、と草十郎は時計を確認する。"

#. Occurrence A_6:161:15200: scene=A_6
#: A_6:161
msgctxt "text_id=15200 | speaker=unknown"
msgid "  No matter what the situation, Soujyuro always kept his cool."
msgstr "　ここ一番でも緊張感のない男である。"

#. Occurrence A_6:182:15201: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0001; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:182
msgctxt "text_id=15201 | speaker=touko"
msgid "\"Pff...\""
msgstr "「っ―――」"

#. Occurrence A_6:187:15202: scene=A_6
#: A_6:187
msgctxt "text_id=15202 | speaker=unknown"
msgid "  He could hear Touko trying to suppress a laugh."
msgstr "　受話器の向こうでは、笑いをこらえる息遣い。"

#. Occurrence A_6:192:15203: scene=A_6
#: A_6:192
msgctxt "text_id=15203 | speaker=unknown"
msgid "  After taking a while to compose herself, she started talking again."
msgstr "　しばらくの呼吸困難の後、橙子はようやく落ち着いて会話を再開した。"

#. Occurrence A_6:213:15204: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0002; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:213
msgctxt "text_id=15204 | speaker=touko"
msgid "\"My apologies. It seems you have a penchant for catching people off guard."
msgstr "「ごめんなさい、ちょっとツボはいっちゃったみたい。"

#. Occurrence A_6:219:15205: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0003; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:219
msgctxt "text_id=15205 | speaker=touko"
msgid "  Anyway, to answer your question. I've been very busy today, trying to finish off every...thing.\""
msgstr "　で、質問の返しね。これがあんまり暇じゃないな。私も今日で終わらせる予定だから忙しいんだ」"

#. Occurrence A_6:225:15206: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_6_0002; voice_prefix=A30; voice_category=3; scene=A_6
#: A_6:225
msgctxt "text_id=15206 | speaker=soujuurou"
msgid "\"Huh. That's a coincidence. Aozaki was just talking about you.\""
msgstr "「偶然ですね。蒼崎もそんな事を言ってました」"

#. Occurrence A_6:252:15207: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0004; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:252
msgctxt "text_id=15207 | speaker=touko"
msgid "\"I thought she might. At times like this, you can tell we're sisters. In fact, that's the only thing we ever had in common―timing."
msgstr "「やっぱり？　そうね、こういう時は本当に姉妹だなって思うわ。昔からエンジンかけるタイミングだけは一緒だったから、あの子とは。"

#. Occurrence A_6:258:15208: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0005; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:258
msgctxt "text_id=15208 | speaker=touko"
msgid "  Oh, I bet you tried to get her to stop as well. As an Aozaki, I know she didn't take to that too kindly, I wouldn't.\""
msgstr "　……ところで、蒼崎はやめてって言ったでしょ。私も蒼崎だから、<擽|くすぐ>ったいのよね、そう言われるの」"

#. Occurrence A_6:278:15209: scene=A_6
#: A_6:278
msgctxt "text_id=15209 | speaker=unknown"
msgid "  Soujyuro realized she was probably right."
msgstr "　言われて、ああ、と草十郎は納得した。"

#. Occurrence A_6:283:15210: scene=A_6
#: A_6:283
msgctxt "text_id=15210 | speaker=unknown"
msgid "  Aozaki's words made more sense now."
msgstr "　あの時の言葉はそういう意味だったのか、と。"

#. Occurrence A_6:304:15211: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0006; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:304
msgctxt "text_id=15211 | speaker=touko"
msgid "\"Cutting to the chase, I don't have time to gossip."
msgstr "「まあそんな訳だから、長話をする気はないんだ。"

#. Occurrence A_6:310:15212: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0007; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:310
msgctxt "text_id=15212 | speaker=touko"
msgid "  Is Aoko there?\""
msgstr "　単刀直入に聞くけど、そっちに青子はいる？」"

#. Occurrence A_6:316:15213: scene=A_6
#: A_6:316
msgctxt "text_id=15213 | speaker=unknown"
msgid "  It almost sounded like she was worried about her sister's whereabouts."
msgstr "　それは本当に、妹の行方を心配するような質問だった。"

#. Occurrence A_6:321:15214: scene=A_6
#: A_6:321
msgctxt "text_id=15214 | speaker=unknown"
msgid "  But the cool-headed Soujyuro had not forgotten Touko was their enemy."
msgstr "　しかし、どんなに緊張感のない草十郎でも、橙子が青子たちの敵であるコトは実感している。"

#. Occurrence A_6:326:15215: scene=A_6
#: A_6:326
msgctxt "text_id=15215 | speaker=unknown"
msgid "  Keeping Aoko and Alice in mind, he decided to be evasive."
msgstr "　青子と有珠を思うのなら、この質問には答えられない。"

#. Occurrence A_6:347:15216: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_6_0003; voice_prefix=A30; voice_category=3; scene=A_6
#: A_6:347
msgctxt "text_id=15216 | speaker=soujuurou"
msgid "\"Who can say. I'm not sure what answer you expect, Miss Touko.\""
msgstr "「……さあ。なんて答えてほしいんですか、橙子さんとしては」"

#. Occurrence A_6:352:15217: scene=A_6
#: A_6:352
msgctxt "text_id=15217 | speaker=unknown"
msgid "  The question shifted the tone of the conversation drastically."
msgstr "　今までの気軽な口調とは一変した質問。"

#. Occurrence A_6:357:15218: scene=A_6
#: A_6:357
msgctxt "text_id=15218 | speaker=unknown"
msgid "  Soujyuro could hear Touko muttering to herself in annoyance."
msgstr "　草十郎の言葉に、受話器の向こうにいる橙子は、まいったなあ、と呟いた。"

#. Occurrence A_6:362:15219: scene=A_6
#: A_6:362
msgctxt "text_id=15219 | speaker=unknown"
msgid "  Soujyuro was proving more quick-witted than she had anticipated. A change of tack was required."
msgstr "　彼女が思っていた以上に、この少年は察しがいい。今は、その賢さがマイナスに働くというのにだ。"

#. Occurrence A_6:383:15220: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0008; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:383
msgctxt "text_id=15220 | speaker=touko"
msgid "\"I suppose not giving me an answer is probably the best course of action."
msgstr "「そうね、君には何も答えてほしくないっていうのが正解かな。"

#. Occurrence A_6:389:15221: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0009; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:389
msgctxt "text_id=15221 | speaker=touko"
msgid "  On first impressions, I thought I'd be wise not to ignore you, but now I don't think I want to get you involved."
msgstr "　第一印象で君を無視するのはよくない気がしてたけど、やっぱり私は、草十郎くんを手にかけたくはないみたい。"

#. Occurrence A_6:395:15222: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0010; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:395
msgctxt "text_id=15222 | speaker=touko"
msgid "  So for your sake, stay out of this, okay, Soujyuro?\""
msgstr "　君は、このまま無関係でいてちょうだいね」"

#. Occurrence A_6:415:15223: scene=A_6
#: A_6:415
msgctxt "text_id=15223 | speaker=unknown"
msgid "  Her warning came from the heart."
msgstr "　嘘のない、親しみのこもった忠告。"

#. Occurrence A_6:420:15224: scene=A_6
#: A_6:420
msgctxt "text_id=15224 | speaker=unknown"
msgid "  Soujyuro responded flatly, once again not giving any sign either way."
msgstr "　草十郎はそうですか、とだけ答えた。"

#. Occurrence A_6:431:15225: scene=A_6
#: A_6:431
msgctxt "text_id=15225 | speaker=unknown"
msgid "  It seems she wanted him to stay out of this, too."
msgstr "　やっぱり彼女も無関係である事を望んでいる。"

#. Occurrence A_6:436:15226: scene=A_6
#: A_6:436
msgctxt "text_id=15226 | speaker=unknown"
msgid "  Even Soujyuro could tell the girls were being kind in their own way."
msgstr "　それが彼女たちなりの誠意である事は、草十郎にも理解できる。"

#. Occurrence A_6:442:15227: scene=A_6
#: A_6:442
msgctxt "text_id=15227 | speaker=unknown"
msgid "  But who asked for their kindness?"
msgstr "　だが。その誠意は、誰が望んだものなのか。"

#. Occurrence A_6:463:15228: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0011; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:463
msgctxt "text_id=15228 | speaker=touko"
msgid "\"I'll say goodbye then. I'm much busier than you think."
msgstr "「じゃ、さよならね。私は君が思ってるほど暇じゃないから。"

#. Occurrence A_6:469:15229: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0012; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:469
msgctxt "text_id=15229 | speaker=touko"
msgid "  Although, there is just one tiny thing. I know this is hardly fair, but I'd never forgive myself if I didn't tell you."
msgstr "　……でも、最後にひとつだけ。君を試すようで悪いんだけど、伝えておかないと一生恨まれそうだし。"

#. Occurrence A_6:475:15230: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0013; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:475
msgctxt "text_id=15230 | speaker=touko"
msgid "  So, I'll just have to put half of the responsibility on your shoulders.\""
msgstr "　なんで、そうならないように責任の半分を君に押しつけちゃおっかな」"

#. Occurrence A_6:495:15231: scene=A_6
#: A_6:495
msgctxt "text_id=15231 | speaker=unknown"
msgid "  Touko giggled-"
msgstr "　くす、と橙子は笑う。"

#. Occurrence A_6:500:15232: scene=A_6
#: A_6:500
msgctxt "text_id=15232 | speaker=unknown"
msgid "  a laugh to show she had him in the palm of her hand from the beginning."
msgstr "　それは、はじめから<そ|・><れ|・>を伝える事だけが目的だと示す笑みだった。"

#. Occurrence A_6:521:15233: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0014; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:521
msgctxt "text_id=15233 | speaker=touko"
msgid "\"I met Miss Kuonji a short while ago."
msgstr "「さっき久遠寺さんに会ってきたの。"

#. Occurrence A_6:527:15234: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0015; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:527
msgctxt "text_id=15234 | speaker=touko"
msgid "  She called you earlier, didn't she?\""
msgstr "　彼女から電話があったでしょう？」"

#. Occurrence A_6:533:15235: scene=A_6
#: A_6:533
msgctxt "text_id=15235 | speaker=unknown"
msgid "  Her tone had not changed."
msgstr "　橙子の口調は変わらない。"

#. Occurrence A_6:538:15236: scene=A_6
#: A_6:538
msgctxt "text_id=15236 | speaker=unknown"
msgid "  She sounded as cordial as before."
msgstr "　今の台詞にはどこにも嫌な気配はない。"

#. Occurrence A_6:543:15237: scene=A_6
#: A_6:543
msgctxt "text_id=15237 | speaker=unknown"
msgid "  Even so, as soon as Soujyuro heard Alice's name, a chill ran up his spine."
msgstr "　なのに有珠の名前を聞いた瞬間、草十郎の背筋に冷たい物が走り抜けた。"

#. Occurrence A_6:564:15238: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0016; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:564
msgctxt "text_id=15238 | speaker=touko"
msgid "\"Well, right now, she's in bad shape. She can barely walk, in fact. And if she uses any crests, they'll tear her to pieces. Oh, and those broken bones... ouch."
msgstr "「彼女、今ひどい状態なんだ。満足に歩けないどころか、体中の刻印が活性化して破裂寸前。草十郎くんが骨折の痛みを知ってるなら、うまい喩えようがあるんだけどね。"

#. Occurrence A_6:570:15239: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0017; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:570
msgctxt "text_id=15239 | speaker=touko"
msgid "  At any rate, she could lose consciousness any time. Not great news with all those scary stray dogs around her."
msgstr "　ま、ともかくだ。いつ気を失ってもおかしくない状態なんだけど―――災難なことに、怖い野犬に囲まれてるみたいなの。"

#. Occurrence A_6:576:15240: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0018; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:576
msgctxt "text_id=15240 | speaker=touko"
msgid "  If you ask me, she has about ten minutes before she's nothing but a pile of bones.\""
msgstr "　個人的な意見だけど、んー、十分もあれば骨しか残らない結末になるでしょうね」"

#. Occurrence A_6:596:15241: scene=A_6
#: A_6:596
msgctxt "text_id=15241 | speaker=unknown"
msgid "  She spoke as if she was telling a joke."
msgstr "　これっぽっちも信憑性のない、冗談のような話。"

#. Occurrence A_6:601:15242: scene=A_6
#: A_6:601
msgctxt "text_id=15242 | speaker=unknown"
msgid "  If it was a joke, it was in bad taste."
msgstr "　それもとびきり出来の悪い。"

#. Occurrence A_6:606:15243: scene=A_6
#: A_6:606
msgctxt "text_id=15243 | speaker=unknown"
msgid "  However, Soujyuro knew this was anything but."
msgstr "　だが、草十郎はすべて現実だと受け入れた。"

#. Occurrence A_6:611:15244: scene=A_6
#: A_6:611
msgctxt "text_id=15244 | speaker=unknown"
msgid "  She was telling the truth."
msgstr "　橙子の言葉に嘘はない。"

#. Occurrence A_6:616:15245: scene=A_6
#: A_6:616
msgctxt "text_id=15245 | speaker=unknown"
msgid "  He had not heard of dogs attacking anyone in town...but the noise he heard while on the phone with Alice suddenly made sense."
msgstr "　都会の犬が人を襲うなんて話は聞かないけれど、先ほどの有珠の電話にあった違和感―――騒がしかった雑音の正体に、草十郎はようやく思い至った。"

#. Occurrence A_6:627:15246: scene=A_6
#: A_6:627
msgctxt "text_id=15246 | speaker=unknown"
msgid "  Dogs. A pack of them. No doubt about it, they were surrounding their prey."
msgstr "　あれは間違いなく、群れをなして獲物を囲む、犬たちの唸り声だったのだ。"

#. Occurrence A_6:648:15247: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_6_0004; voice_prefix=A30; voice_category=3; scene=A_6
#: A_6:648
msgctxt "text_id=15247 | speaker=soujuurou"
msgid "\"...!\""
msgstr "「っ………！」"

#. Occurrence A_6:653:15248: scene=A_6
#: A_6:653
msgctxt "text_id=15248 | speaker=unknown"
msgid "  Why had he not cottoned on sooner?"
msgstr "　なぜあの時に気付かなかったのか。"

#. Occurrence A_6:658:15249: scene=A_6
#: A_6:658
msgctxt "text_id=15249 | speaker=unknown"
msgid "  Squeezing the receiver in his hand, Soujyuro cursed himself."
msgstr "　受話器を強く握り締めて、草十郎は自分を呪う。"

#. Occurrence A_6:663:15250: scene=A_6
#: A_6:663
msgctxt "text_id=15250 | speaker=unknown"
msgid "  Alice had been calling for help."
msgstr "　つい数分前の有珠の言葉は、彼女にとって精一杯の、助けを呼ぶ声だった。"

#. Occurrence A_6:683:15251: scene=A_6
#: A_6:683
msgctxt "text_id=15251 | speaker=unknown"
msgid "  Even when backed into a corner, she had not wanted to involve Soujyuro."
msgstr "　青子以上に草十郎を関わらせまいとする有珠は、絶望的な状況でも、彼に助けを求める事はしなかった。"

#. Occurrence A_6:688:15252: scene=A_6
#: A_6:688
msgctxt "text_id=15252 | speaker=unknown"
msgid "  Still...she needed help."
msgstr "　……けれど、それでも、最後の最後で助けを求めた。"

#. Occurrence A_6:694:15253: scene=A_6
#: A_6:694
msgctxt "text_id=15253 | speaker=unknown"
msgid "  The way she said his name so lightly..."
msgstr "　か細い声で、彼女が彼の名前を呼んだあの時に。"

#. Occurrence A_6:715:15254: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_6_0005; voice_prefix=A30; voice_category=3; scene=A_6
#: A_6:715
msgctxt "text_id=15254 | speaker=soujuurou"
msgid "\"Where is she?\""
msgstr "「場所は」"

#. Occurrence A_6:721:15255: scene=A_6
#: A_6:721
msgctxt "text_id=15255 | speaker=unknown"
msgid "  He spoke abruptly."
msgstr "　簡潔に問いただす。"

#. Occurrence A_6:726:15256: scene=A_6
#: A_6:726
msgctxt "text_id=15256 | speaker=unknown"
msgid "  Even though he knew Touko was the enemy, he was confident she would answer him."
msgstr "　橙子が敵である事を思い知った草十郎だが、彼女なら場所を教えてくれるという確信がある。"

#. Occurrence A_6:731:15257: scene=A_6
#: A_6:731
msgctxt "text_id=15257 | speaker=unknown"
msgid "  That was the reason she called."
msgstr "　そのために、橙子はここに電話をしたのだから。"

#. Occurrence A_6:752:15258: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0019; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:752
msgctxt "text_id=15258 | speaker=touko"
msgid "\"I can tell you, but just know that the moment I do, you become my enemy. Do we have a deal?\""
msgstr "「教えてあげてもいいけど、そうした瞬間に君は私の敵になるのよ。その覚悟はある？」"

#. Occurrence A_6:758:15259: scene=A_6
#: A_6:758
msgctxt "text_id=15259 | speaker=unknown"
msgid "  Soujyuro realized what was happening."
msgstr "　そういう事か、と草十郎は納得した。"

#. Occurrence A_6:763:15260: scene=A_6
#: A_6:763
msgctxt "text_id=15260 | speaker=unknown"
msgid "  He was being tested."
msgstr "　たしかに、これは試されている。"

#. Occurrence A_6:768:15261: scene=A_6
#: A_6:768
msgctxt "text_id=15261 | speaker=unknown"
msgid "  By ignoring Alice, he would be confirming that he did not want to get involved."
msgstr "　ここで有珠を無視すれば、自分は彼女たちと無関係だと証明できる。"

#. Occurrence A_6:773:15262: scene=A_6
#: A_6:773
msgctxt "text_id=15262 | speaker=unknown"
msgid "  But if he decided to save her..."
msgstr "　けれど助けに行くのなら―――"

#. Occurrence A_6:794:15263: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_6_0006; voice_prefix=A30; voice_category=3; scene=A_6
#: A_6:794
msgctxt "text_id=15263 | speaker=soujuurou"
msgid "\"Tell me, where is she?\""
msgstr "「それで、場所は？」"

#. Occurrence A_6:806:15264: scene=A_6
#: A_6:806
msgctxt "text_id=15264 | speaker=unknown"
msgid "  Soujyuro ignored Touko's question."
msgstr "　橙子の問いには答えず、草十郎はそれだけを聞き返した。"

#. Occurrence A_6:811:15265: scene=A_6
#: A_6:811
msgctxt "text_id=15265 | speaker=unknown"
msgid "  Of course he was not prepared to become her enemy, but he was even less prepared to let Alice die."
msgstr "　覚悟なんて一生できないし、後悔だって尽きる事はない。"

#. Occurrence A_6:816:15266: scene=A_6
#: A_6:816
msgctxt "text_id=15266 | speaker=unknown"
msgid "  He had lost his ability to think sensibly, not that he was particularly good about that to begin with."
msgstr "　だいたいはじめから、彼には明確な判断基準が失われている。"

#. Occurrence A_6:821:15267: scene=A_6
#: A_6:821
msgctxt "text_id=15267 | speaker=unknown"
msgid "  Still, he would not waste any time in deliberation. He would simply go with his instincts."
msgstr "　だから、何であれ一番初めに感じた事を大事にしようと思ったのだ。"

#. Occurrence A_6:826:15268: scene=A_6
#: A_6:826
msgctxt "text_id=15268 | speaker=unknown"
msgid "  It was one of the few times he had felt pride since coming down from the mountains."
msgstr "　それが山から下りてきてからの、彼の数少ない<矜持|きょうじ>だった。"

#. Occurrence A_6:847:15269: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0020; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:847
msgctxt "text_id=15269 | speaker=touko"
msgid "\"...Okay. I'm a little disappointed. I didn't want to have to kill you. Then again, I thought it might end up this way."
msgstr "「……そ。ちょっと残念だな、私はホントに君が気に入ってたのに。ま、こうなる事は分かってたけどね。"

#. Occurrence A_6:853:15270: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0021; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:853
msgctxt "text_id=15270 | speaker=touko"
msgid "  She's at Yashirogi Nature Park. Check the map under the phone. I bookmarked the page last time I was there."
msgstr "　場所は社木の森林公園。受話器の下に地図があるでしょ？この前、帰りがけに栞をはさんでおいたからそれを参考にすること。"

#. Occurrence A_6:859:15271: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0022; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:859
msgctxt "text_id=15271 | speaker=touko"
msgid "  I'll say it again: you'll be lucky if you have ten minutes. It'll be a miracle if she lasts a minute longer.\""
msgstr "　繰り返すようだけど、十分持てば幸運。その後は一分ごとに奇跡の価値があがるような状況よ、今の彼女は」"

#. Occurrence A_6:879:15272: scene=A_6
#: A_6:879
msgctxt "text_id=15272 | speaker=unknown"
msgid "  As he listened, Soujyuro's expression turned to one of irritation."
msgstr "　橙子の説明を聞きながら、ぎり、と草十郎は苛立ちで顔を歪めた。"

#. Occurrence A_6:884:15273: scene=A_6
#: A_6:884
msgctxt "text_id=15273 | speaker=unknown"
msgid "  Misaki and Yashirogi were one station apart."
msgstr "　ここ三咲町から社木は一駅離れている。"

#. Occurrence A_6:889:15274: scene=A_6
#: A_6:889
msgctxt "text_id=15274 | speaker=unknown"
msgid "  How long would it take to get to the station from the mansion?"
msgstr "　今から洋館を出て駅に着くまで何分かかるだろう？"

#. Occurrence A_6:894:15275: scene=A_6
#: A_6:894
msgctxt "text_id=15275 | speaker=unknown"
msgid "  Usually just under twelve minutes."
msgstr "　いつもは二十分弱。"

#. Occurrence A_6:899:15276: scene=A_6
#: A_6:899
msgctxt "text_id=15276 | speaker=unknown"
msgid "  By the time he got off the train at Yashirogi, nearly thirty minutes would have passed."
msgstr "　そこから電車に乗って社木に着いた頃には、もう三十分は経っている―――"

#. Occurrence A_6:920:15277: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0023; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:920
msgctxt "text_id=15277 | speaker=touko"
msgid "\"It looks close on the map, but transport links around here are terrible. You might be able to catch the last train, but you should cut your losses. Either way, you're my enemy now."
msgstr "「地図の上じゃ近いのに、区画整理された交通手段は不便よね。けど、急げば最終の電車には間に合うわ。ここで諦めた方が賢明だけど、君はもう私の敵だから。"

#. Occurrence A_6:926:15278: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_A_6_0024; voice_prefix=A20; voice_category=11; scene=A_6
#: A_6:926
msgctxt "text_id=15278 | speaker=touko"
msgid "  Just don't regret your choice.\""
msgstr "　―――どっちにしたって、後悔のないようにね」"

#. Occurrence A_6:947:15279: scene=A_6
#: A_6:947
msgctxt "text_id=15279 | speaker=unknown"
msgid "  The line went dead."
msgstr "　電話はそこで切れた。"

#. Occurrence A_6:952:15280: scene=A_6
#: A_6:952
msgctxt "text_id=15280 | speaker=unknown"
msgid "  Soujyuro, not Touko, had hung up the phone."
msgstr "　橙子が切ったのではなく、草十郎が切ったのだ。"

#. Occurrence A_6:959:15281: scene=A_6
#: A_6:959
msgctxt "text_id=15281 | speaker=unknown"
msgid "  He memorized the map and then made for the door."
msgstr "　地図を頭にいれて走りだす。"

#. Occurrence A_6:965:15282: scene=A_6
#: A_6:965
msgctxt "text_id=15282 | speaker=unknown"
msgid "  With no time to grab his coat, he ran out into the snowy winter night with the clothes he had on."
msgstr "　上着を取りにいく時間も惜しい。草十郎は着の身着のままで、まだ雪の残る冬の夜へと駆け出していく。"

#. Occurrence A_6:985:15283: scene=A_6
#: A_6:985
msgctxt "text_id=15283 | speaker=unknown"
msgid "  All that remained in the hall was the discarded map."
msgstr "　ホールには放り出されたままの地図だけが残っていた。"

#. Occurrence A_6:990:15284: scene=A_6
#: A_6:990
msgctxt "text_id=15284 | speaker=unknown"
msgid "  It showed Misaki City."
msgstr "　開かれたページには三咲市の地図がある。"

#. Occurrence A_6:995:15285: scene=A_6
#: A_6:995
msgctxt "text_id=15285 | speaker=unknown"
msgid "  It was about ten miles from the mansion to the nature park;"
msgstr "　この洋館から森林公園まで、距離にして約１５キロ。"

#. Occurrence A_6:1007:15286: scene=A_6
#: A_6:1007
msgctxt "text_id=15286 | speaker=unknown"
msgid "  five if you went in a straight line, but the streets were not that forgiving."
msgstr "　直線で結べばその三分の一もないというのに、都会の道は本当に不便だ。"

#. Occurrence A_6:1012:15287: scene=A_6
#: A_6:1012
msgctxt "text_id=15287 | speaker=unknown"
msgid "  Four inches on the map, but so much farther in reality. For the first time, Soujyuro cursed the town."
msgstr "　<都市|ここ>では十センチもない紙上の距離が何倍にもなってしまう事を、草十郎ははじめて呪いたくなった。"

#. Occurrence A_7:79:15288: scene=A_7
#: A_7:79
msgctxt "text_id=15288 | speaker=unknown"
msgid "  Alice's injuries were not limited to her abdomen."
msgstr "　有珠が裂かれたのは腹部だけではなかった。"

#. Occurrence A_7:84:15289: scene=A_7
#: A_7:84
msgctxt "text_id=15289 | speaker=unknown"
msgid "  The wolf had punched a hole straight through to her back,"
msgstr "　正確には腹を貫通して背中まで。"

#. Occurrence A_7:90:15290: scene=A_7
#: A_7:90
msgctxt "text_id=15290 | speaker=unknown"
msgid " crushing her lower vertebrae and leaving both of her legs paralyzed."
msgstr "腰のやや上にある<脊椎|せきつい>まで砕かれた有珠の両足は、ぴくりとも動かなかった。"

#. Occurrence A_7:95:15291: scene=A_7
#: A_7:95
msgctxt "text_id=15291 | speaker=unknown"
msgid "  Though her Magic Crests were repairing the damage, it would likely take another hour before recovery."
msgstr "　いずれ魔術刻印によって復元するにしろ、最短であと一時間。"

#. Occurrence A_7:100:15292: scene=A_7
#: A_7:100
msgctxt "text_id=15292 | speaker=unknown"
msgid "  At the very least, her heart and slender arms still worked."
msgstr "　かろうじて動くのは心臓と、細い両手だけ。"

#. Occurrence A_7:141:15293: scene=A_7
#: A_7:141
msgctxt "text_id=15293 | speaker=unknown"
msgid "  Although, after crawling along the ground to the phone booth, those too were failing her."
msgstr "　その希望も、地を這って電話ボックスに入った時点で、もう満足に動かなかった。"

#. Occurrence A_7:146:15294: scene=A_7
#: A_7:146
msgctxt "text_id=15294 | speaker=unknown"
msgid "  As the crests healed her wounds, a searing heat ran through her body that threatened to overwhelm her."
msgstr "　腹部の傷を癒すために起動した刻印は、凶悪な炉熱を放って、有珠の小さな体を押し潰そうとする。"

#. Occurrence A_7:152:15295: scene=A_7
#: A_7:152
msgctxt "text_id=15295 | speaker=unknown"
msgid "  It was as if her body was no longer her own, like she was transforming into another creature."
msgstr "　―――自分の体が自分の物でなく、何か得体の知れない、別の生き物に変わっていく感覚。"

#. Occurrence A_7:172:15296: scene=A_7
#: A_7:172
msgctxt "text_id=15296 | speaker=unknown"
msgid "  The poison throbbing through her open wounds hurt emotionally more than physically."
msgstr "　裂かれた腹部に渦巻く猛毒は、痛いというより辛い。"

#. Occurrence A_7:177:15297: scene=A_7
#: A_7:177
msgctxt "text_id=15297 | speaker=unknown"
msgid "  She was used to pain, but she could not accept this disquieting feeling."
msgstr "　痛みには慣れているが、この不快感だけは慣れようがない。"

#. Occurrence A_7:182:15298: scene=A_7
#: A_7:182
msgctxt "text_id=15298 | speaker=unknown"
msgid "  Not that she had any intention to. The moment she did it would be her last."
msgstr "　慣れた時には、彼女はもう彼女ではなくなっているのだから。"

#. Occurrence A_7:207:15299: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0000; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:207
msgctxt "text_id=15299 | speaker=alice"
msgid "\"...\""
msgstr "「……、―――」"

#. Occurrence A_7:213:15300: scene=A_7
#: A_7:213
msgctxt "text_id=15300 | speaker=unknown"
msgid "  Alice wrestled with the discomfort from her abdomen and her Magic Crests,"
msgstr "　腹部の痛みと、魔術刻印による不快感。"

#. Occurrence A_7:218:15301: scene=A_7
#: A_7:218
msgctxt "text_id=15301 | speaker=unknown"
msgid "  and with her consciousness holding on by a thread, she took the phone in her hand."
msgstr "　いつ消えてもおかしくない意識の中、有珠は受話器を手に取った。"

#. Occurrence A_7:269:15302: scene=A_7
#: A_7:269
msgctxt "text_id=15302 | speaker=unknown"
msgid "  It was unlikely Aoko would be there to pick up."
msgstr "　青子が帰還している可能性は低い。"

#. Occurrence A_7:274:15303: scene=A_7
#: A_7:274
msgctxt "text_id=15303 | speaker=unknown"
msgid "  Even so, with the stray dogs gathering around the booth, she had to try."
msgstr "　それを知りながら洋館に電話をしたのは、電話ボックスに集まりだした野犬達の目つきに<圧|お>されての事かもしれない。"

#. Occurrence A_7:279:15304: scene=A_7
#: A_7:279
msgctxt "text_id=15304 | speaker=unknown"
msgid "  It was Soujyuro who picked up."
msgstr "　けれど、電話に出たのは草十郎だった。"

#. Occurrence A_7:286:15305: scene=A_7
#: A_7:286
msgctxt "text_id=15305 | speaker=unknown"
msgid "  Alice knew she was better off just hanging up, but his name slipped out of her mouth."
msgstr "　関係のない彼なら無言で切るべきだったのに、有珠は名前を呼んでしまった。"

#. Occurrence A_7:306:15306: scene=A_7
#: A_7:306
msgctxt "text_id=15306 | speaker=unknown"
msgid "  After pausing and fighting with herself for some time, an image of the innocent boy came to mind, and she hung up."
msgstr "　……長い沈黙と葛藤の末、受話器ごしに凡庸な草十郎の顔が思い出されて、有珠はなんとか電話を切った。"

#. Occurrence A_7:311:15307: scene=A_7
#: A_7:311
msgctxt "text_id=15307 | speaker=unknown"
msgid "  Her instincts had won out. She could not let him get involved."
msgstr "　どうあっても彼を関わらせるのはいけない、そう本能が律したのだ。"

#. Occurrence A_7:389:15308: scene=A_7
#: A_7:389
msgctxt "text_id=15308 | speaker=unknown"
msgid "  And not just because he was an innocent bystander. It was more than that."
msgstr "　……それは、一般人だからとか、そんな事とは関係なく。"

#. Occurrence A_7:395:15309: scene=A_7
#: A_7:395
msgctxt "text_id=15309 | speaker=unknown"
msgid "  To Alice, Soujyuro appeared that day because he was merely in the wrong place at the wrong time."
msgstr "　あの日ささやかな秘密を共有した時から、少女にとって、静希草十郎はそういう風に映っていた。"

#. Occurrence A_7:416:15310: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0001; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:416
msgctxt "text_id=15310 | speaker=alice"
msgid "\"...\""
msgstr "「…………、―――――――――」"

#. Occurrence A_7:422:15311: scene=A_7
#: A_7:422
msgctxt "text_id=15311 | speaker=unknown"
msgid "  Only the lightest of breaths passed her lips."
msgstr "　喉からこぼれる息が、細い。"

#. Occurrence A_7:461:15312: scene=A_7
#: A_7:461
msgctxt "text_id=15312 | speaker=unknown"
msgid "  Above her, the moon began to blur."
msgstr "　頭上の月が薄らいでいく。"

#. Occurrence A_7:467:15313: scene=A_7
#: A_7:467
msgctxt "text_id=15313 | speaker=unknown"
msgid "  Snow was falling again, so close yet so far."
msgstr "　降り始めた雪が遠くなっていく。"

#. Occurrence A_7:472:15314: scene=A_7
#: A_7:472
msgctxt "text_id=15314 | speaker=unknown"
msgid "  The dogs began hurling themselves at the phone booth to the chorus of hungry snarls. Thunk. Thunk."
msgstr "　周囲からは野犬たちの騒ぎ声。どん、と電話ボックスに体当たりをする音も聞こえだした。"

#. Occurrence A_7:478:15315: scene=A_7
#: A_7:478
msgctxt "text_id=15315 | speaker=unknown"
msgid "  She took one last deep breath and closed her eyes."
msgstr "　……少女は最後に大きく息をついて、目蓋を閉じる。"

#. Occurrence A_7:505:15316: scene=A_7
#: A_7:505
msgctxt "text_id=15316 | speaker=unknown"
msgid "  Glass. An unusual material for a coffin."
msgstr "　硝子の<棺|ひつぎ>の中で意識を手放す。"

#. Occurrence A_7:511:15317: scene=A_7
#: A_7:511
msgctxt "text_id=15317 | speaker=unknown"
msgid "  But the girl knew, in some corner of her mind, that she had made the right choice not to ask the boy for help."
msgstr "　少年に助けを乞わなかった事を最後まで正しく、そして不思議に思いながら。"

#. Occurrence A_7:536:15318: scene=A_7
#: A_7:536
msgctxt "text_id=15318 | speaker=unknown"
msgid "          Some time passed."
msgstr "　　　　　―――合間。"

msgctxt "text_id=15319 | speaker=unknown"
msgid " A peculiar sight came into view."
msgstr "おかしな風景を見た。"

#. Occurrence A_7:582:15320: scene=A_7
#: A_7:582
msgctxt "text_id=15320 | speaker=unknown"
msgid "  A field of wild flowers."
msgstr "　一面に花が咲き乱れた野原。"

#. Occurrence A_7:588:15321: scene=A_7
#: A_7:588
msgctxt "text_id=15321 | speaker=unknown"
msgid "  The clear sky was too blue;"
msgstr "　雲ひとつない空は青すぎて、"

#. Occurrence A_7:594:15322: scene=A_7
#: A_7:594
msgctxt "text_id=15322 | speaker=unknown"
msgid "  the flowers, so numerous they made the field look barren."
msgstr "　野原いっぱいの花は白すぎて、"

#. Occurrence A_7:600:15323: scene=A_7
#: A_7:600
msgctxt "text_id=15323 | speaker=unknown"
msgid "  The sight was so dazzlingly beautiful, she wished she could look away."
msgstr "　こんなにも美しいのに、目を<背|そむ>けたくて仕方がない。"

#. Occurrence A_7:620:15324: scene=A_7
#: A_7:620
msgctxt "text_id=15324 | speaker=unknown"
msgid "  ...This was probably all thanks to Father Winter."
msgstr "　……それはたぶん、冬の出来事だった。"

#. Occurrence A_7:626:15325: scene=A_7
#: A_7:626
msgctxt "text_id=15325 | speaker=unknown"
msgid "  The cold wind carried a scent of a paradise far removed, untainted by man or beast."
msgstr "　冷たい風は人里離れた<桃源|とうげん>の匂いがして、太陽すら人の<手|て><垢|あか>に汚れていない。"

#. Occurrence A_7:632:15326: scene=A_7
#: A_7:632
msgctxt "text_id=15326 | speaker=unknown"
msgid "  It was a glimpse of the fields beyond winter. One could be forgiven for thinking they were the afterlife."
msgstr "　楽土と錯覚する<彼岸|ひがん>の原。"

#. Occurrence A_7:637:15327: scene=A_7
#: A_7:637
msgctxt "text_id=15327 | speaker=unknown"
msgid "  Come to think of it, she remembered how funerals were sad, yet always beautiful."
msgstr "　そう言えば、<弔|とむら>いは悲しいものなのに、いつも<華|はな>やかな事を思い出す。"

#. Occurrence A_7:658:15328: scene=A_7
#: A_7:658
msgctxt "text_id=15328 | speaker=unknown"
msgid "  She cried."
msgstr "　……<嗚|あ><呼|あ>。"

#. Occurrence A_7:663:15329: scene=A_7
#: A_7:663
msgctxt "text_id=15329 | speaker=unknown"
msgid "  She made an incongruous whine, a sound of life."
msgstr "　なのに不釣り合いな呻き声と、<生命|いのち>の音がする。"

#. Occurrence A_7:668:15330: scene=A_7
#: A_7:668
msgctxt "text_id=15330 | speaker=unknown"
msgid "  Her breathing was strained and erratic."
msgstr "　断片的にこぼれる<吐|い><息|き>は<絞|しぼ>るように。"

#. Occurrence A_7:673:15331: scene=A_7
#: A_7:673
msgctxt "text_id=15331 | speaker=unknown"
msgid "  Hollow and useless was the heart that she once used to fend off pain."
msgstr "　痛みを訴えるはずの<感情|しんぞう>は、<虚|うつ>ろになって機能不全。"

#. Occurrence A_7:678:15332: scene=A_7
#: A_7:678
msgctxt "text_id=15332 | speaker=unknown"
msgid "  It was as though she was in the space between disconnected body and mind."
msgstr "　切断するかのような締め付けは胴と頭の中間に。"

#. Occurrence A_7:683:15333: scene=A_7
#: A_7:683
msgctxt "text_id=15333 | speaker=unknown"
msgid "  A crying woman and a silent child..."
msgstr "　女は泣きながら、鳴き声ひとつあげぬ幼子の―――"

#. Occurrence A_7:704:15334: scene=A_7
#: A_7:704
msgctxt "text_id=15334 | speaker=unknown"
msgid "  High was the sky, deep was the forest, unmoving were the people."
msgstr "　空は高く、森は深く、人は途絶え。"

#. Occurrence A_7:710:15335: scene=A_7
#: A_7:710
msgctxt "text_id=15335 | speaker=unknown"
msgid "  No footsteps or voices of salvation came."
msgstr "　駆けつける足音も、助けを求める<意|こ><思|え>もない。"

#. Occurrence A_7:716:15336: scene=A_7
#: A_7:716
msgctxt "text_id=15336 | speaker=unknown"
msgid "  Who was that looking innocently up at the sky in the stillness?"
msgstr "　そんな静けさの中で、無心で空を見上げていたのは、一体、誰だったのだろう―――"

#. Occurrence A_7:782:15337: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0002; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:782
msgctxt "text_id=15337 | speaker=alice"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence A_7:819:15338: scene=A_7
#: A_7:819
msgctxt "text_id=15338 | speaker=unknown"
msgid "  When she came to, Alice was going up a familiar hill."
msgstr "　気が付くと、有珠は見慣れた坂を上っていた。"

#. Occurrence A_7:824:15339: scene=A_7
#: A_7:824
msgctxt "text_id=15339 | speaker=unknown"
msgid "  The cold, night air had all but frozen her hands or feet."
msgstr "　夜気は冷たく、手足は凍てついたように動かない。"

#. Occurrence A_7:829:15340: scene=A_7
#: A_7:829
msgctxt "text_id=15340 | speaker=unknown"
msgid "  She shook, as you would expect from someone whose abdomen had been torn apart."
msgstr "　当然と言えば当然だが、金狼によって裂かれた腹部は剥きだしで、体はしきりに震えていた。"

#. Occurrence A_7:867:15341: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0003; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:867
msgctxt "text_id=15341 | speaker=alice"
msgid "\"Sizuki...?\""
msgstr "「……静希……君？」"

#. Occurrence A_7:873:15342: scene=A_7
#: A_7:873
msgctxt "text_id=15342 | speaker=unknown"
msgid "  She could barely comprehend that she was being carried slowly up Shiroinuzuka."
msgstr "　自分がその人物におぶられて白犬塚の坂を登っている事を、有珠はうつろな意識で認めた。"

#. Occurrence A_7:905:15343: scene=A_7
#: A_7:905
msgctxt "text_id=15343 | speaker=unknown"
msgid "  Soujyuro had Alice on his back, and was silently ascending the slope."
msgstr "　草十郎は有珠を背中におぶったまま、無言で坂を上っていた。"

#. Occurrence A_7:910:15344: scene=A_7
#: A_7:910
msgctxt "text_id=15344 | speaker=unknown"
msgid "  His calm eyes seemed to be suffering from the bitter cold."
msgstr "　落ち着いた瞳は、寒さのせいか辛そうな色をしている。"

#. Occurrence A_7:915:15345: scene=A_7
#: A_7:915
msgctxt "text_id=15345 | speaker=unknown"
msgid "  He did not seem to be dressed for the time of year."
msgstr "　見れば、この寒さの中で歩き回る服装ではなかった。"

#. Occurrence A_7:920:15346: scene=A_7
#: A_7:920
msgctxt "text_id=15346 | speaker=unknown"
msgid "  Not even a coat. His exposed neck and hands were ice-cold."
msgstr "　草十郎は上着も着ておらず、首もとや手の平が哀れなほど冷えきっている。"

#. Occurrence A_7:941:15347: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0004; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:941
msgctxt "text_id=15347 | speaker=alice"
msgid "\"Wh-What...are you...doing here?\""
msgstr "「……どうして、ここにいるの……？」"

#. Occurrence A_7:949:15348: scene=A_7
#: A_7:949
msgctxt "text_id=15348 | speaker=unknown"
msgid "  Alice asked, still slumped over his frame."
msgstr "　おぶられたまま有珠は問うた。"

#. Occurrence A_7:954:15349: scene=A_7
#: A_7:954
msgctxt "text_id=15349 | speaker=unknown"
msgid "  She tried to move, but to no avail."
msgstr "　体を起こしたくても力が入らない。"

#. Occurrence A_7:959:15350: scene=A_7
#: A_7:959
msgctxt "text_id=15350 | speaker=unknown"
msgid "  The last thing she wanted was to rest her entire weight on someone else."
msgstr "　自分の重さがすべて他人に預けられている事が、今はひどく気にかかる。"

#. Occurrence A_7:993:15351: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0000; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:993
msgctxt "text_id=15351 | speaker=soujuurou"
msgid "\"Touko called me. She said you were in trouble."
msgstr "「橙子さんから電話があった。有珠が危ないって。"

#. Occurrence A_7:999:15352: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0001; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:999
msgctxt "text_id=15352 | speaker=soujuurou"
msgid "  You're more stubborn than Aozaki, you know. Why didn't you ask me for help? Not that I could be much help, but still.\""
msgstr "　……蒼崎はともかく、有珠は意地を張りすぎだ。あの状況で助けを呼ばないのはどうかしてる。そりゃあ、自分が行っても何もできなかっただろうけど」"

#. Occurrence A_7:1019:15353: scene=A_7
#: A_7:1019
msgctxt "text_id=15353 | speaker=unknown"
msgid "  Soujyuro spoke with a scolding tone, his eyes kept firmly ahead."
msgstr "　草十郎は前だけを見つめて、叱るように返答した。"

#. Occurrence A_7:1024:15354: scene=A_7
#: A_7:1024
msgctxt "text_id=15354 | speaker=unknown"
msgid "  His words were directed at himself rather than the girl on his back."
msgstr "　その叱責は背中の少女に向けたものではなく、力になれなかった自分に対してのものだ。"

#. Occurrence A_7:1071:15355: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0005; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:1071
msgctxt "text_id=15355 | speaker=alice"
msgid "\"This... doesn't concern you...\""
msgstr "「…………静希君は、関係ないもの」"

#. Occurrence A_7:1077:15356: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0002; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:1077
msgctxt "text_id=15356 | speaker=soujuurou"
msgid "\"Maybe you're right. But now it does. We'll talk more back at the house.\""
msgstr "「だろうね。けど、これで関係はできた。館についたら話してもらうぞ」"

#. Occurrence A_7:1097:15357: scene=A_7
#: A_7:1097
msgctxt "text_id=15357 | speaker=unknown"
msgid "  Soujyuro focused on climbing the hill."
msgstr "　草十郎はとにかく坂を登っていく。"

#. Occurrence A_7:1102:15358: scene=A_7
#: A_7:1102
msgctxt "text_id=15358 | speaker=unknown"
msgid "  The slope would get steeper from here to the mansion."
msgstr "　……考えてみれば、洋館までの坂は段々ときつくなっていく。"

#. Occurrence A_7:1107:15359: scene=A_7
#: A_7:1107
msgctxt "text_id=15359 | speaker=unknown"
msgid "  The thought of Soujyuro climbing this steep hill with her on his back surprised Alice."
msgstr "　その坂を、自分を背負ったまま登っていく草十郎に、有珠は意外なものを見た気がした。"

#. Occurrence A_7:1141:15360: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0006; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:1141
msgctxt "text_id=15360 | speaker=alice"
msgid "\"Let me down. I'm fine.\""
msgstr "「降りるわ、もう大丈夫だから」"

#. Occurrence A_7:1147:15361: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0003; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:1147
msgctxt "text_id=15361 | speaker=soujuurou"
msgid "\"Your whole stomach is exposed. My back will keep you warm."
msgstr "「お腹をむきだしでかい。このほうが少しは暖かいよ。"

#. Occurrence A_7:1153:15362: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0004; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:1153
msgctxt "text_id=15362 | speaker=soujuurou"
msgid "  Don't worry. You're lighter than firewood, so this is a cinch. I'm only out of breath from rushing to the park."
msgstr "　それに、有珠は薪より軽い。山じゃこの程度は朝飯前だから気にしないでくれ。息があがっているのは公園まで急いだからだし。"

#. Occurrence A_7:1160:15363: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0005; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:1160
msgctxt "text_id=15363 | speaker=soujuurou"
msgid "Not that I needed to hurry in the end.\""
msgstr "……まあ、その意味はなかったんだが」"

#. Occurrence A_7:1177:15364: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0007; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:1177
msgctxt "text_id=15364 | speaker=alice"
msgid "\"Why not...?\""
msgstr "「……なぜ？」"

#. Occurrence A_7:1198:15365: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0006; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:1198
msgctxt "text_id=15365 | speaker=soujuurou"
msgid "\"As soon as I got there, the dogs ran for the hills. I'm sure Touko knew that would happen all along."
msgstr "「俺が着いたら、犬はさっさと散っていった。はじめから、橙子さんはそういうつもりだったんだ。"

#. Occurrence A_7:1214:15366: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0007; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:1214
msgctxt "text_id=15366 | speaker=soujuurou"
msgid "  She must not have meant to finish you off, which means I wasn't on a time limit. I suppose I should be thankful for small mercies.\""
msgstr "　有珠をどうにかするつもりもなければ、時間制限もなかった。喜ぶべき事なんだろうけど」"

#. Occurrence A_7:1234:15367: scene=A_7
#: A_7:1234
msgctxt "text_id=15367 | speaker=unknown"
msgid "  Soujyuro said dejectedly."
msgstr "　憮然と言う草十郎。"

#. Occurrence A_7:1239:15368: scene=A_7
#: A_7:1239
msgctxt "text_id=15368 | speaker=unknown"
msgid "  But he was wrong."
msgstr "　けれど、それは彼だけの勘違いだ。"

#. Occurrence A_7:1244:15369: scene=A_7
#: A_7:1244
msgctxt "text_id=15369 | speaker=unknown"
msgid "  While Touko did not want to kill Alice per se, she would not have cared if she had died."
msgstr "　橙子に殺意はなかったが、結果として有珠が死んでしまう事には何の罪悪感もなかっただろう。"

#. Occurrence A_7:1277:15370: scene=A_7
#: A_7:1277
msgctxt "text_id=15370 | speaker=unknown"
msgid "  At least that was the way Alice saw it."
msgstr "　……有珠は思う。"

#. Occurrence A_7:1282:15371: scene=A_7
#: A_7:1282
msgctxt "text_id=15371 | speaker=unknown"
msgid "  She did not know how long it took Soujyuro to get to the park, but if he had not come, the phone booth would have collapsed and she would be dead."
msgstr "　この少年がどれほどの速さで公園に着いたかは知らないけれど、彼が来なければ間違いなく電話ボックスは破られて、自分は生きてはいなかったと。"

#. Occurrence A_7:1322:15372: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0008; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:1322
msgctxt "text_id=15372 | speaker=alice"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence A_7:1328:15373: scene=A_7
#: A_7:1328
msgctxt "text_id=15373 | speaker=unknown"
msgid "  Alice did her best to suppress her thoughts and feelings."
msgstr "　有珠は様々な所感、感情をのど元で押し止める。"

#. Occurrence A_7:1333:15374: scene=A_7
#: A_7:1333
msgctxt "text_id=15374 | speaker=unknown"
msgid "  She felt silly at the thought of correcting him, and it would matter little anyway."
msgstr "　言っても仕方のない事だし、草十郎の甘い勘違いを正すのも気が引けたからだ。"

#. Occurrence A_7:1338:15375: scene=A_7
#: A_7:1338
msgctxt "text_id=15375 | speaker=unknown"
msgid "  The thought of her trying to thank him was more painful than her open wounds."
msgstr "　……ただ。言いかけた<感謝|ことば>を飲み込むのは、傷を堪える事より辛かっただけ。"

#. Occurrence A_7:1386:15376: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0009; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:1386
msgctxt "text_id=15376 | speaker=alice"
msgid "\"...So you carried me all the way from the park?\""
msgstr "「……もしかして、公園からずっと？」"

#. Occurrence A_7:1416:15377: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0008; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:1416
msgctxt "text_id=15377 | speaker=soujuurou"
msgid "\"Had to. The trains stopped running. I should've gotten a taxi, but didn't bring my wallet."
msgstr "「仕方ないだろ。電車、終わってたんだから。タクシーを使えば良かったんだけど、あいにく持ち合わせがなくて。"

#. Occurrence A_7:1422:15378: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0009; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:1422
msgctxt "text_id=15378 | speaker=soujuurou"
msgid "  ...Honestly, I've never felt how limiting money was until today.\""
msgstr "　……ほんと。今日ほどお金の不便さを思い知った日はない」"

#. Occurrence A_7:1442:15379: scene=A_7
#: A_7:1442
msgctxt "text_id=15379 | speaker=unknown"
msgid "  For the first time today, Soujyuro let out a sigh."
msgstr "　少年はようやくため息らしきものをついた。"

#. Occurrence A_7:1447:15380: scene=A_7
#: A_7:1447
msgctxt "text_id=15380 | speaker=unknown"
msgid "  There was no point taking a break; he had already traveled close to six miles like this."
msgstr "　休み休みとは言え、彼は実に十キロ近い距離をこうして踏破してきた。"

#. Occurrence A_7:1452:15381: scene=A_7
#: A_7:1452
msgctxt "text_id=15381 | speaker=unknown"
msgid "  Perhaps the fatigue was getting to him. Soujyuro was more upset with his own weakness than the difficulty of the trek."
msgstr "　疲れきっているだろうに、草十郎はその困難さより、自分の頼りなさに呆れたらしい。"

#. Occurrence A_7:1490:15382: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0010; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:1490
msgctxt "text_id=15382 | speaker=alice"
msgid "\"...Don't you mean how important money is?\""
msgstr "「……でも。それを言うなら、お金の大切さ、じゃない？」"

#. Occurrence A_7:1496:15383: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0010; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:1496
msgctxt "text_id=15383 | speaker=soujuurou"
msgid "\"What I mean is, if there's something you can use only if you have money, isn't that incredibly limiting?\""
msgstr "「使えるものがあるのにお金がないだけで使えないんだから、それって不便って言わないか？」"

#. Occurrence A_7:1503:15384: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0011; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:1503
msgctxt "text_id=15384 | speaker=alice"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence A_7:1508:15385: scene=A_7
#: A_7:1508
msgctxt "text_id=15385 | speaker=unknown"
msgid "  The innocence of his question made Alice briefly forget her pain."
msgstr "　純粋な疑問に、有珠は一時、傷の痛みを忘れてしまった。"

#. Occurrence A_7:1513:15386: scene=A_7
#: A_7:1513
msgctxt "text_id=15386 | speaker=unknown"
msgid "  She, too, felt distant from the real world,"
msgstr "　自分も、それなりに文明社会とは縁がないつもりだったけれど。"

#. Occurrence A_7:1518:15387: scene=A_7
#: A_7:1518
msgctxt "text_id=15387 | speaker=unknown"
msgid "  but compared to the boy carrying her, she felt like a regular citizen."
msgstr "　この少年の素朴さに比べれば、ちゃんと文明人らしいのだ。"

#. Occurrence A_7:1554:15388: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_7_0012; voice_prefix=A40; voice_category=2; scene=A_7
#: A_7:1554
msgctxt "text_id=15388 | speaker=alice"
msgid "\"That's just like you to say.\""
msgstr "「なにか、貴方らしいわ」"

#. Occurrence A_7:1560:15389: scene=A_7
#: A_7:1560
msgctxt "text_id=15389 | speaker=unknown"
msgid "  Alice smiled to herself."
msgstr "　気付かれない様に小さく笑う。"

#. Occurrence A_7:1565:15390: scene=A_7
#: A_7:1565
msgctxt "text_id=15390 | speaker=unknown"
msgid "  As Alice rested her head, something soft touched her cheek."
msgstr "　有珠が顔をあずけると、こつん、と柔らかいものが頬に当たった。"

#. Occurrence A_7:1570:15391: scene=A_7
#: A_7:1570
msgctxt "text_id=15391 | speaker=unknown"
msgid "  The collar Aoko had given him."
msgstr "　少年の首に巻かれた、青子からの首輪だった。"

#. Occurrence A_7:1603:15392: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0011; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:1603
msgctxt "text_id=15392 | speaker=soujuurou"
msgid "\"Once we get back, you should change and clean up. When you're ready, we can talk in the drawing room."
msgstr "「館についたら着替えるんだ。お腹の血も拭って、落ち着いたら居間で話そう。"

#. Occurrence A_7:1609:15393: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_7_0012; voice_prefix=A30; voice_category=3; scene=A_7
#: A_7:1609
msgctxt "text_id=15393 | speaker=soujuurou"
msgid "  Touko sees me as her enemy now, too.\""
msgstr "　橙子さんに言わせれば、俺もこれで敵らしいから」"

#. Occurrence A_7:1657:15394: scene=A_7
#: A_7:1657
msgctxt "text_id=15394 | speaker=unknown"
msgid "  With those words hanging in the air, they reached the top of the hill."
msgstr "　その言葉を有珠が聞いた時、彼はもう坂を登りきっていた。"

#. Occurrence A_7:1662:15395: scene=A_7
#: A_7:1662
msgctxt "text_id=15395 | speaker=unknown"
msgid "  The gate in the woods stood before them. Beyond it, illuminated by the pale moonlight, stood the mansion."
msgstr "　森の入り口にあたる正門。その奥には、月明かりの下に佇む彼女の洋館がある。"

#. Occurrence A_7:1667:15396: scene=A_7
#: A_7:1667
msgctxt "text_id=15396 | speaker=unknown"
msgid "  Looking up at it, the girl felt a little disappointed."
msgstr "　それを見上げて、少女は少しだけ残念に思った。"

#. Occurrence A_7:1719:15397: scene=A_7
#: A_7:1719
msgctxt "text_id=15397 | speaker=unknown"
msgid "  A natural reaction, yet..."
msgstr "　……もちろん。"

#. Occurrence A_7:1724:15398: scene=A_7
#: A_7:1724
msgctxt "text_id=15398 | speaker=unknown"
msgid "  She could not place where her sadness was coming from."
msgstr "　何を残念に思ったのかは、気が付く事はなかったけれど。"

#. Occurrence A_8:51:15399: scene=A_8
#: A_8:51
msgctxt "text_id=15399 | speaker=unknown"
msgid "  Once they entered the mansion, Alice slid off Soujyuro's back and walked toward the west wing."
msgstr "　ロビーに着くと、有珠は草十郎の背中から降り、西館に向かって歩きだした。"

#. Occurrence A_8:56:15400: scene=A_8
#: A_8:56
msgctxt "text_id=15400 | speaker=unknown"
msgid "  The west wing was her domain."
msgstr "　洋館の左翼、ロビーから西は彼女の管轄である。"

#. Occurrence A_8:65:15401: scene=A_8
#: A_8:65
msgctxt "text_id=15401 | speaker=unknown"
msgid "  However, after only a few steps, she collapsed to the floor."
msgstr "　が。有珠は数歩もしないうち、床に崩れ落ちてしまった。"

#. Occurrence A_8:88:15402: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_8_0000; voice_prefix=A30; voice_category=3; scene=A_8
#: A_8:88
msgctxt "text_id=15402 | speaker=soujuurou"
msgid "\"Alice!\""
msgstr "「有珠……！」"

#. Occurrence A_8:130:15403: scene=A_8
#: A_8:130
msgctxt "text_id=15403 | speaker=unknown"
msgid "  Soujyuro rushed over to her, but she raised her hand."
msgstr "　草十郎が駆け寄ると、有珠は座りこんだまま片手を上げた。"

#. Occurrence A_8:135:15404: scene=A_8
#: A_8:135
msgctxt "text_id=15404 | speaker=unknown"
msgid "  Her gesture told him he was not to come closer."
msgstr "　それ以上は近付かないで、と告げるように。"

#. Occurrence A_8:140:15405: scene=A_8
#: A_8:140
msgctxt "text_id=15405 | speaker=unknown"
msgid "  He stopped in his tracks, a concerned look on his face."
msgstr "　草十郎は苦い顔付きで足を止める。"

#. Occurrence A_8:145:15406: scene=A_8
#: A_8:145
msgctxt "text_id=15406 | speaker=unknown"
msgid "  Her pale skin gleamed with sweat;"
msgstr "　……少女の白い肌には汗がにじんでいる。"

#. Occurrence A_8:150:15407: scene=A_8
#: A_8:150
msgctxt "text_id=15407 | speaker=unknown"
msgid "  her expression uncharacteristically strained."
msgstr "　いつも無表情の顔は、苦しそうに痛みに耐えていた。"

#. Occurrence A_8:190:15408: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0000; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:190
msgctxt "text_id=15408 | speaker=alice"
msgid "\"...I'm fine. I can make it to my room on my own. Stay here. I'm going to mend my clothes."
msgstr "「……平気。部屋に戻るぐらいの力は戻ったわ。服を<繕|つくろ>ってくるから、貴方はここにいて。"

#. Occurrence A_8:196:15409: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0001; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:196
msgctxt "text_id=15409 | speaker=alice"
msgid "  I'll be back shortly, and then...\""
msgstr "　すぐに戻ってくるから、そうしたら―――」"

#. Occurrence A_8:202:15410: scene=A_8
#: A_8:202
msgctxt "text_id=15410 | speaker=unknown"
msgid "  The pained look in Alice's eyes told Soujyuro they would talk later."
msgstr "　きちんと話をする、と苦しげな目が伝えてくる。"

#. Occurrence A_8:235:15411: scene=A_8
#: A_8:235
msgctxt "text_id=15411 | speaker=unknown"
msgid "  He knew he could not stop her."
msgstr "　そう言われては止める事もできない。"

#. Occurrence A_8:240:15412: scene=A_8
#: A_8:240
msgctxt "text_id=15412 | speaker=unknown"
msgid "  Soujyuro reminded himself that she was the one in pain, not him."
msgstr "　辛いのは有珠の方で、断じて自分ではない、と草十郎は自分に言い聞かせる。"

#. Occurrence A_8:260:15413: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_8_0001; voice_prefix=A30; voice_category=3; scene=A_8
#: A_8:260
msgctxt "text_id=15413 | speaker=soujuurou"
msgid "\"...All right then. Tell me everything when you come back.\""
msgstr "「……それじゃあ、戻ってきたら話を聞かせてくれ」"

#. Occurrence A_8:284:15414: scene=A_8
#: A_8:284
msgctxt "text_id=15414 | speaker=unknown"
msgid "  Alice took a deep breath, before slowly disappearing down the corridor."
msgstr "　有珠は深呼吸をしてから、確かな足取りで洋館の西館へ消えていった。"

#. Occurrence A_8:341:15415: scene=A_8
#: A_8:341
msgctxt "text_id=15415 | speaker=unknown"
msgid "  An uneventful five minutes passed."
msgstr "　……時間にすれば五分もない空白。"

#. Occurrence A_8:352:15416: scene=A_8
#: A_8:352
msgctxt "text_id=15416 | speaker=unknown"
msgid "  Alice returned wearing a fresh set of black clothes,"
msgstr "　有珠は代えの黒衣に着替えて戻ってきた。"

#. Occurrence A_8:357:15417: scene=A_8
#: A_8:357
msgctxt "text_id=15417 | speaker=unknown"
msgid "  but her complexion remained pallid."
msgstr "　顔色は一向に良くはならない。"

#. Occurrence A_8:367:15418: scene=A_8
#: A_8:367
msgctxt "text_id=15418 | speaker=unknown"
msgid "  With a small sigh, she carefully leaned against a pillar in the foyer, and slid down it until she was sitting."
msgstr "　小さく息をついて、いつかのように、ロビーの柱に背中を預けて座りこむ。"

#. Occurrence A_8:400:15419: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_8_0002; voice_prefix=A30; voice_category=3; scene=A_8
#: A_8:400
msgctxt "text_id=15419 | speaker=soujuurou"
msgid "\"Alice. If you're in pain, you should lie down.\""
msgstr "「有珠。傷が痛むなら、無理せず横になったほうがいい」"

#. Occurrence A_8:405:15420: scene=A_8
#: A_8:405
msgctxt "text_id=15420 | speaker=unknown"
msgid "  Soujyuro sat across from her on the cold floor."
msgstr "　草十郎は有珠に合わせて、冷たい床に座りこむ。"

#. Occurrence A_8:423:15421: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0002; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:423
msgctxt "text_id=15421 | speaker=alice"
msgid "\"I'm not in pain anymore, so I don't need to lie down."
msgstr "「……傷はもう痛まないわ。横になる必要もない。"

#. Occurrence A_8:429:15422: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0003; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:429
msgctxt "text_id=15422 | speaker=alice"
msgid "  I was forced to swallow a rowan, so my body can't heal completely.\""
msgstr "　この体の異常はナナカマドを飲まされたせいだから、どうあっても治らないもの」"

#. Occurrence A_8:450:15423: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_8_0003; voice_prefix=A30; voice_category=3; scene=A_8
#: A_8:450
msgctxt "text_id=15423 | speaker=soujuurou"
msgid "\"At least let me get a blanket for you.\""
msgstr "「じゃあ、せめて毛布とか」"

#. Occurrence A_8:456:15424: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0004; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:456
msgctxt "text_id=15424 | speaker=alice"
msgid "\"No. If I stay here, the cold won't bother me.\""
msgstr "「…………いいから、気遣いはしないで。ここなら寒さも関係ないから」"

#. Occurrence A_8:462:15425: scene=A_8
#: A_8:462
msgctxt "text_id=15425 | speaker=unknown"
msgid "  She seemed to be telling the truth."
msgstr "　寒さに関しては強がりではないらしい。"

#. Occurrence A_8:467:15426: scene=A_8
#: A_8:467
msgctxt "text_id=15426 | speaker=unknown"
msgid "  Soujyuro remembered Aoko telling him that as long as Alice is inside the mansion, she would be comfortable."
msgstr "　いつかの青子の『有珠は洋館の中にいれば適温』説を思い出して、草十郎はあっさり引き下がった。"

#. Occurrence A_8:500:15427: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_8_0004; voice_prefix=A30; voice_category=3; scene=A_8
#: A_8:500
msgctxt "text_id=15427 | speaker=soujuurou"
msgid "\"Okay. As long as you're warm."
msgstr "「……うん、あったかいのならいい。"

#. Occurrence A_8:506:15428: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_8_0005; voice_prefix=A30; voice_category=3; scene=A_8
#: A_8:506
msgctxt "text_id=15428 | speaker=soujuurou"
msgid "  So, what's this 'rowan' thing?\""
msgstr "　それで、ナナカマドっていうのは？」"

#. Occurrence A_8:512:15429: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0005; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:512
msgctxt "text_id=15429 | speaker=alice"
msgid "\"It's a kind of medicinal herb. It gets its name from what's left in the cinders after it's burned seven times in a stove, and it's used as a ward against spirits."
msgstr "「薬草の一種よ。七回<竃|かまど>で焼いても燃え残る事から付けられた名前で、効用は魔除け。"

#. Occurrence A_8:531:15430: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0006; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:531
msgctxt "text_id=15430 | speaker=alice"
msgid "  It's not good for regular people, but for me and Aoko it's worse. Once it's in our bodies, it reacts badly to the production of magical energy, and there's nothing we can do but wait it out.\""
msgstr "　……普通の人にはよくない程度だけど、わたしや青子には少し厄介ね。体内での魔力生成そのものに抵抗されてしまうから、手の打ちようがない」"

#. Occurrence A_8:552:15431: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_8_0006; voice_prefix=A30; voice_category=3; scene=A_8
#: A_8:552
msgctxt "text_id=15431 | speaker=soujuurou"
msgid "\"So... it's a poison?\""
msgstr "「……毒、と思っていいのか？」"

#. Occurrence A_8:589:15432: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0007; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:589
msgctxt "text_id=15432 | speaker=alice"
msgid "\"No, like I said, it was originally used in medicine."
msgstr "「いえ、本来は薬草よ。"

#. Occurrence A_8:595:15433: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0008; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:595
msgctxt "text_id=15433 | speaker=alice"
msgid "  I'm using magical energy to heal right now, so I'm having to fight it. But once I'm fully healed, I'll be fine, as long as I don't use magecraft."
msgstr "　今は傷を治すために魔力を使っているから苦しいけど、傷が完治すれば大人しくなるわ。魔術さえ使わなければナナカマドも反応しないから。"

#. Occurrence A_8:601:15434: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0009; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:601
msgctxt "text_id=15434 | speaker=alice"
msgid "  Basically, I won't be of any use until I fully digest it.\""
msgstr "　単純な話、ナナカマドを消化するまでわたしは役には立たないだけ」"

#. Occurrence A_8:634:15435: scene=A_8
#: A_8:634
msgctxt "text_id=15435 | speaker=unknown"
msgid "  Alice paused."
msgstr "　ただ。"

#. Occurrence A_8:639:15436: scene=A_8
#: A_8:639
msgctxt "text_id=15436 | speaker=unknown"
msgid "  She decided not to say how many days that would take."
msgstr "　それが何日かかるかを、有珠は口にはしなかった。"

#. Occurrence A_8:672:15437: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0010; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:672
msgctxt "text_id=15437 | speaker=alice"
msgid "\"Anyway, it's nothing you need worry about."
msgstr "「……別に、静希君が心配することじゃないわ。"

#. Occurrence A_8:678:15438: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0011; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:678
msgctxt "text_id=15438 | speaker=alice"
msgid "  I can manage the pain. It's just a result of my circulation.\""
msgstr "　こんなの、血が流れる程度の痛みだから」"

#. Occurrence A_8:710:15439: scene=A_8
#: A_8:710
msgctxt "text_id=15439 | speaker=unknown"
msgid "  She worked hard to keep her tone calm."
msgstr "　有珠の声は努めて静かだった。"

#. Occurrence A_8:715:15440: scene=A_8
#: A_8:715
msgctxt "text_id=15440 | speaker=unknown"
msgid "  Aoko had barely blinked when she was struck in the back, so mages must have an unusually high pain-threshold."
msgstr "　青子も背中を強打されても平気な顔で走っていたし、魔術師という人種は痛みへの耐性が強いのかもしれない。"

#. Occurrence A_8:715:15441: scene=A_8
#: A_8:715
msgctxt "text_id=15441 | speaker=unknown"
msgid "  Soujyuro was surprised and bewildered by what she said."
msgstr "　それに驚きつつ、草十郎は呆れたのだ。"

#. Occurrence A_8:720:15442: scene=A_8
#: A_8:720
msgctxt "text_id=15442 | speaker=unknown"
msgid "  If wounds didn't count as long as the pain wasn't too bad, then nothing would hurt except an injury that killed you."
msgstr "　耐えられる程度の痛みは傷じゃない、なんて考えでは、死に至る傷以外は痛みではなくなってしまう。"

#. Occurrence A_8:753:15443: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_8_0007; voice_prefix=A30; voice_category=3; scene=A_8
#: A_8:753
msgctxt "text_id=15443 | speaker=soujuurou"
msgid "\"Fine. Let's talk tomorrow. For now, I want you to rest.\""
msgstr "「……分かった。話をするのは明日にしよう。今日はとにかく体を休めてほしい」"

#. Occurrence A_8:759:15444: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0012; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:759
msgctxt "text_id=15444 | speaker=alice"
msgid "\"I won't be any better then.\""
msgstr "「明日になっても、わたしの容態は変わらないけど……？」"

#. Occurrence A_8:765:15445: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_8_0008; voice_prefix=A30; voice_category=3; scene=A_8
#: A_8:765
msgctxt "text_id=15445 | speaker=soujuurou"
msgid "\"It doesn't matter. You need to take better care of yourself.\""
msgstr "「いいんだ、それでも。有珠はもっと体を大事にしてくれ」"

#. Occurrence A_8:800:15446: scene=A_8
#: A_8:800
msgctxt "text_id=15446 | speaker=unknown"
msgid "  He stood up."
msgstr "　言って、草十郎は立ち上がった。"

#. Occurrence A_8:836:15447: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_8_0009; voice_prefix=A30; voice_category=3; scene=A_8
#: A_8:836
msgctxt "text_id=15447 | speaker=soujuurou"
msgid "\"I'll take you to your room. Or how about the drawing room? I've never been to the west wing, so I don't know where your room is.\""
msgstr "「部屋まで送るよ。それとも居間で休むか？　西館には入った事はないから、有珠の部屋も分からないし」"

#. Occurrence A_8:842:15448: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0013; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:842
msgctxt "text_id=15448 | speaker=alice"
msgid "\"I'm fine here. I need to be here when Aoko comes back.\""
msgstr "「……ここでいいわ。青子を待たなくちゃいけないから」"

#. Occurrence A_8:880:15449: scene=A_8
#: A_8:880
msgctxt "text_id=15449 | speaker=unknown"
msgid "  Alice looked up at the skylight."
msgstr "　有珠は座りこんだまま、天窓を見上げている。"

#. Occurrence A_8:885:15450: scene=A_8
#: A_8:885
msgctxt "text_id=15450 | speaker=unknown"
msgid "  The moonlight illuminated her pained face."
msgstr "　痛みに耐える顔が月光に照らされている。"

#. Occurrence A_8:916:15451: scene=A_8
#: A_8:916
msgctxt "text_id=15451 | speaker=unknown"
msgid "  The foyer looked like it belonged to a rundown castle. Only the moon and Alice seemed more vivid than reality."
msgstr "　廃墟の古城を思わせるこのロビーで、月と有珠だけが現実より鮮明に映っている。"

#. Occurrence A_8:936:15452: scene=A_8
#: A_8:936
msgctxt "text_id=15452 | speaker=unknown"
msgid "  Where did her strength come from?"
msgstr "　その張りつめた強さは、何処からくるものなのか。"

#. Occurrence A_8:964:15453: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_A_8_0010; voice_prefix=A30; voice_category=3; scene=A_8
#: A_8:964
msgctxt "text_id=15453 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence A_8:969:15454: scene=A_8
#: A_8:969
msgctxt "text_id=15454 | speaker=unknown"
msgid "  Soujyuro stared at her."
msgstr "　草十郎は立ったまま、少女の在り方を眺めている。"

#. Occurrence A_8:974:15455: scene=A_8
#: A_8:974
msgctxt "text_id=15455 | speaker=unknown"
msgid "  Without understanding the significance of Alice's gaze, he turned his gaze to the night sky, powerless as it was."
msgstr "　無力に夜空を見上げるしかない、有珠の視線の意味にも気付かないままで。"

#. Occurrence A_8:1063:15456: scene=A_8
#: A_8:1063
msgctxt "text_id=15456 | speaker=unknown"
msgid "  For the third time that night, the silence was broken by the sound of the phone ringing."
msgstr "　……そうして、ロビーの静寂を破るように三度目の<電話|コール>が鳴り響いた。"

#. Occurrence A_8:1068:15457: scene=A_8
#: A_8:1068
msgctxt "text_id=15457 | speaker=unknown"
msgid "  Before Soujyuro could move, a thin shadow bolted across the foyer."
msgstr "　草十郎が動くより早く、細い影がロビーを横切る。"

#. Occurrence A_8:1085:15458: scene=A_8
#: A_8:1085
msgctxt "text_id=15458 | speaker=unknown"
msgid "  By the time he realized it was the weakened Alice, she had already taken the receiver in her hand."
msgstr "　それが衰弱した有珠だと草十郎が気付いた時、彼女はすでに受話器を手に取っていた。"

#. Occurrence A_8:1106:15459: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_A_8_0014; voice_prefix=A40; voice_category=2; scene=A_8
#: A_8:1106
msgctxt "text_id=15459 | speaker=alice"
msgid "\"Aoko...?\""
msgstr "「青子……？」"

#. Occurrence A_8:1112:15460: scene=A_8
#: A_8:1112
msgctxt "text_id=15460 | speaker=unknown"
msgid "  It was the first time Soujyuro had heard Alice sound concerned."
msgstr "　……不安を含んだ有珠の声を、草十郎は初めて聞いた。"

#. Occurrence A_8:1117:15461: scene=A_8
#: A_8:1117
msgctxt "text_id=15461 | speaker=unknown"
msgid "  Her tone was infinitely graver than when she was enduring her own pain."
msgstr "　痛みに耐える声より、何倍も<悲愴|ひそう>な響き。"

#. Occurrence A_8:1122:15462: scene=A_8
#: A_8:1122
msgctxt "text_id=15462 | speaker=unknown"
msgid "  Alice's question received only a short response from the voice on the other end."
msgstr "　有珠の問いに、受話器はただ一言だけを返す。"

#. Occurrence A_8:1127:15463: scene=A_8
#: A_8:1127
msgctxt "text_id=15463 | speaker=unknown"
msgid "  It was a voice more frail than Alice's, like a flickering flame about to turn to smoke."
msgstr "　有珠以上に弱々しい、消え去る前の炎みたいな一言を。"

#. Occurrence A_8:1175:15464: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_A_8_0000; voice_prefix=A10; voice_category=1; scene=A_8
#: A_8:1175
msgctxt "text_id=15464 | speaker=aoko"
msgid "\"...Sorry. They got me.\""
msgstr "「……ごめん、やられた」"

#. Occurrence A_8:1212:15465: scene=A_8
#: A_8:1212
msgctxt "text_id=15465 | speaker=unknown"
msgid "  The phone was far from Soujyuro's ears, but the words he picked up were very unlike her."
msgstr "　受話器から遠く離れた位置で、青子らしくない言葉が、草十郎の耳に響く。"

#. Occurrence A_8:1217:15466: scene=A_8
#: A_8:1217
msgctxt "text_id=15466 | speaker=unknown"
msgid "  Despite saying so little-no, because she had said so little,"
msgstr "　……それだけの言葉なのに、いや、それだけの言葉だからこそ。"

#. Occurrence A_8:1222:15467: scene=A_8
#: A_8:1222
msgctxt "text_id=15467 | speaker=unknown"
msgid "  the weight of Aoko's defeat struck Soujyuro hard."
msgstr "　草十郎には青子の<敗北|けつまつ>が、堪え難いほど実感できた。"

#. Occurrence A_8:1264:15468: scene=A_8
#: A_8:1264
msgctxt "text_id=15468 | speaker=unknown"
msgid "  Alice silently set the receiver down."
msgstr "　有珠は静かに受話器を置く。"

#. Occurrence A_8:1269:15469: scene=A_8
#: A_8:1269
msgctxt "text_id=15469 | speaker=unknown"
msgid "  Only moments before, her body had been fighting the pain; now it felt stronger than ever."
msgstr "　今まで苦痛に耐えていた彼女の体は、一転してしなやかな強さを取り戻した。"

#. Occurrence A_8:1274:15470: scene=A_8
#: A_8:1274
msgctxt "text_id=15470 | speaker=unknown"
msgid "  It was like a scarecrow transforming into a beautiful stone statue."
msgstr "　針金の人形が、美しい彫像に変わるように。"

#. Occurrence A_8:1279:15471: scene=A_8
#: A_8:1279
msgctxt "text_id=15471 | speaker=unknown"
msgid "  Seeing this, Soujyuro finally understood."
msgstr "　それを見て、草十郎はようやく気が付いた。"

#. Occurrence A_8:1309:15472: scene=A_8
#: A_8:1309
msgctxt "text_id=15472 | speaker=unknown"
msgid "  Alice's expression when she looked at the moon had come from her trying to accept an immutable reality."
msgstr "　有珠の痛々しく月を見上げる瞳は、自分ではもう変えようのないこの結末を、静かに受け入れる為のものだったと。"

#. Occurrence B_1:49:15473: scene=B_1
#: B_1:49
msgctxt "text_id=15473 | speaker=unknown"
msgid "  Aoko had not hung up, but the line remained silent."
msgstr "　青子からの電話はつながったまま、もう語りかけてくる事はなかった。"

#. Occurrence B_1:58:15474: scene=B_1
#: B_1:58
msgctxt "text_id=15474 | speaker=unknown"
msgid "  Alice set down the receiver, quickly put on her mantle, and made for the entrance, moving her injured body by sheer willpower alone."
msgstr "　有珠は電話を切ると、手早くケープを着て玄関へと歩きだす。重症の体を、気力だけで動かすようにぎこちなく。"

#. Occurrence B_1:80:15475: scene=B_1
#: B_1:80
msgctxt "text_id=15475 | speaker=unknown"
msgid "  Along the way, she paused, turned to Soujyuro, and looked directly at him."
msgstr "　その途中、ぴたりと足を止め、何やら思案げに草十郎を凝視した。"

#. Occurrence B_1:135:15476: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0000; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:135
msgctxt "text_id=15476 | speaker=soujuurou"
msgid "\"Aoko's in trouble, isn't she?\""
msgstr "「……青子に何かあったんだな？」"

#. Occurrence B_1:160:15477: scene=B_1
#: B_1:160
msgctxt "text_id=15477 | speaker=unknown"
msgid "  Alice hesitated for a moment..."
msgstr "　有珠は一瞬だけ思案し―――"

#. Occurrence B_1:194:15478: scene=B_1
#: B_1:194
msgctxt "text_id=15478 | speaker=unknown"
msgid "  ...before pushing aside her anxiety and grabbing his hand."
msgstr "　緊張をとくような思いきりの良さで、自分から少年の手をとった。"

#. Occurrence B_1:201:15479: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0000; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:201
msgctxt "text_id=15479 | speaker=alice"
msgid "\"Sizuki, come with me.\""
msgstr "「静希君、一緒に来て」"

#. Occurrence B_1:250:15480: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0001; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:250
msgctxt "text_id=15480 | speaker=soujuurou"
msgid "\"Wait, where are we going?\""
msgstr "「待ってくれ。一緒にって、どこに？」"

#. Occurrence B_1:264:15481: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0001; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:264
msgctxt "text_id=15481 | speaker=alice"
msgid "\"To Aida Church. We need to ask Father Eiri for help.\""
msgstr "「<合田|あいだ>教会まで。青子の方は、<詠梨|えいり>神父にお願いするしかないから」"

#. Occurrence B_1:277:15482: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0002; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:277
msgctxt "text_id=15482 | speaker=soujuurou"
msgid "\"Aida Church... That's next to the hospital, isn't it?\""
msgstr "「合田教会って、病院の横にある？」"

#. Occurrence B_1:298:15483: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0002; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:298
msgctxt "text_id=15483 | speaker=alice"
msgid "\"Good. You know it. That'll save me time explaining.\""
msgstr "「……そう。知っているのなら問題ないわね。説明する手間も省けたわ」"

#. Occurrence B_1:353:15484: scene=B_1
#: B_1:353
msgctxt "text_id=15484 | speaker=unknown"
msgid "  Alice left the mansion and made her way down the tree-lined path."
msgstr "　有珠は玄関を出て、正面の並木道に向かっていく。"

#. Occurrence B_1:358:15485: scene=B_1
#: B_1:358
msgctxt "text_id=15485 | speaker=unknown"
msgid "  She was clearly determined, but the look in her eyes betrayed her pain."
msgstr "　……気丈に振る舞ってはいるが、その瞳には苦痛の色が見え隠れしている。"

#. Occurrence B_1:379:15486: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0003; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:379
msgctxt "text_id=15486 | speaker=soujuurou"
msgid "\"A-Alice, wait! Shouldn't we call ahead?\""
msgstr "「ちょ、有珠！　連絡をするなら、電話は？」"

#. Occurrence B_1:408:15487: scene=B_1
#: B_1:408
msgctxt "text_id=15487 | speaker=unknown"
msgid "  Soujyuro asked Alice, whose grip on his hand was light but unyielding."
msgstr "　弱い、けれど逆らえない有珠の手に引かれながら、草十郎は館を振り返った。"

#. Occurrence B_1:459:15488: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0003; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:459
msgctxt "text_id=15488 | speaker=alice"
msgid "\"The church already knows."
msgstr "「教会の人になら、もう報せた。"

#. Occurrence B_1:465:15489: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0004; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:465
msgctxt "text_id=15489 | speaker=alice"
msgid "  And if you're talking about the hospital, no need. It's quicker for us to go and help than call for a car. They can't fly.\""
msgstr "　……もしかして病院のことを言っているなら、それこそ無駄よ。ハイヤーなんて言うけど空を飛ぶわけでもないし。今は助けを呼ぶより、助けに行かないと間に合わない」"

#. Occurrence B_1:522:15490: scene=B_1
#: B_1:522
msgctxt "text_id=15490 | speaker=unknown"
msgid "  Alice had thought of everything."
msgstr "　……と。"

#. Occurrence B_1:528:15491: scene=B_1
#: B_1:528
msgctxt "text_id=15491 | speaker=unknown"
msgid "  She turned to the mansion and lightly snapped her fingers."
msgstr "　有珠は洋館に視線を切り返し、小さく指を鳴らした。"

#. Occurrence B_1:551:15492: scene=B_1
#: B_1:551
msgctxt "text_id=15492 | speaker=unknown"
msgid "  In response, a window opened and countless starlings took flight."
msgstr "　有珠の合図に呼応するかのように、いずこかの窓が開き、無数の<椋鳥|ムクドリ>が飛び立っていく。"

#. Occurrence B_1:572:15493: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0005; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:572
msgctxt "text_id=15493 | speaker=alice"
msgid "\"Group One, search for the enemy. Groups Two and Three, proceed to the scene and administer first aid. Haste is paramount."
msgstr "「一番隊は索敵。二番隊と三番隊は現場に向かって応急処置を。在庫切れになってもいいわ。"

#. Occurrence B_1:579:15494: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0006; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:579
msgctxt "text_id=15494 | speaker=alice"
msgid "If Aoko is still alive, do not let her heart stop.\""
msgstr "まだ生きているなら、青子の心臓を止めないで」"

#. Occurrence B_1:584:15495: scene=B_1
#: B_1:584
msgctxt "text_id=15495 | speaker=unknown"
msgid "  Alice commanded the birds firmly."
msgstr "　有珠の声は、飛び立っていく椋鳥たちにかけられたものだ。"

#. Occurrence B_1:605:15496: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0007; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:605
msgctxt "text_id=15496 | speaker=alice"
msgid "\"Sizuki, fetch Aoko's bicycle from the rear courtyard.\""
msgstr "「静希君は、裏庭から青子の自転車を持ってきて」"

#. Occurrence B_1:643:15497: scene=B_1
#: B_1:643
msgctxt "text_id=15497 | speaker=unknown"
msgid "  Soujyuro let slip his discomfort at the thought of that thing."
msgstr "　言われて、げっと草十郎は漏らした。"

#. Occurrence B_1:648:15498: scene=B_1
#: B_1:648
msgctxt "text_id=15498 | speaker=unknown"
msgid "  The custom-made red bicycle..."
msgstr "　裏庭にある赤い自転車はオーダーメイドの特注品だ。"

#. Occurrence B_1:653:15499: scene=B_1
#: B_1:653
msgctxt "text_id=15499 | speaker=unknown"
msgid "  When he was cleaning the incinerator, Aoko had verbally assaulted him for nearly scratching it."
msgstr "　いつぞやの焼却炉の掃除の際、うっかり傷つけそうになった草十郎に、青子は怒濤の<罵詈雑言|ばりぞうごん>をみまったのである。"

#. Occurrence B_1:681:15500: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0004; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:681
msgctxt "text_id=15500 | speaker=soujuurou"
msgid "\"Okay... But what's the plan?\""
msgstr "「……いいけど。どうするつもりなんだ、有珠は？」"

#. Occurrence B_1:709:15501: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0008_0; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:709
msgctxt "text_id=15501 | speaker=alice"
msgid "\"You're much safer at the church than here. And I need to hurry."
msgstr "「ここにいるより、教会にいたほうが静希君は安全よ。それに、わたしも急がないといけない。"

#. Occurrence B_1:722:15502: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0008_1; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:722
msgctxt "text_id=15502 | speaker=alice"
msgid " Can you can take us both, Sizuki?\""
msgstr "……静希君、ふたり乗りできる？」"

#. Occurrence B_1:762:15503: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0005; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:762
msgctxt "text_id=15503 | speaker=soujuurou"
msgid "\"...Hm.\""
msgstr "「――――――む」"

#. Occurrence B_1:768:15504: scene=B_1
#: B_1:768
msgctxt "text_id=15504 | speaker=unknown"
msgid "  While Soujyuro had seen people riding tandem and was confident he could imitate them, he still wasn't quite certain he could trust a bicycle with his life."
msgstr "　<見様見真似|み よ う み ま ね >でやれる自信はあるものの、いまいち自転車というものを信用できない草十郎だった。"

#. Occurrence B_1:773:15505: scene=B_1
#: B_1:773
msgctxt "text_id=15505 | speaker=unknown"
msgid "  Moreover, its frame was so light, he was unsure it could support both their weights."
msgstr "　あの細い<骨格|フレーム>の乗り物に、はたして二人分の体重を支えるだけの性能があるかどうか―――"

#. Occurrence B_1:800:15506: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0006; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:800
msgctxt "text_id=15506 | speaker=soujuurou"
msgid "\"Wait, you mean you want to ride on the back!?\""
msgstr "「ん？　ふたり乗りってコトは有珠が後ろに乗るのか!?」"

#. Occurrence B_1:825:15507: scene=B_1
#: B_1:825
msgctxt "text_id=15507 | speaker=unknown"
msgid "\"..."
msgstr "「…………"

#. Occurrence B_1:837:15508: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0009; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:837
msgctxt "text_id=15508 | speaker=alice"
msgid "If it's too much, then I don't need your help.\""
msgstr "出来ないなら、いいわ」"

#. Occurrence B_1:848:15509: scene=B_1
#: B_1:848
msgctxt "text_id=15509 | speaker=unknown"
msgid "  Alice turned away as if to snub him, then began walking."
msgstr "　ぷい、と顔を背けて歩きだす有珠。"

#. Occurrence B_1:853:15510: scene=B_1
#: B_1:853
msgctxt "text_id=15510 | speaker=unknown"
msgid "  Unfortunately for Soujyuro, he was now on her bad side."
msgstr "　間の悪いコトに、草十郎の言葉をストレートに誤解したらしい。"

#. Occurrence B_1:891:15511: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0007; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:891
msgctxt "text_id=15511 | speaker=soujuurou"
msgid "\"Hey, don't get me wrong. It's just I never expected you to ask me to do something like that.\""
msgstr "「いや、そういう意味じゃないんだ。有珠とはイメージが合わなかったから」"

#. Occurrence B_1:897:15512: scene=B_1
#: B_1:897
msgctxt "text_id=15512 | speaker=unknown"
msgid "  Ignoring his pleas, she continued briskly toward the woods."
msgstr "　草十郎の弁解にも耳を貸さず、有珠は一人でスタスタと森に向かう。"

#. Occurrence B_1:902:15513: scene=B_1
#: B_1:902
msgctxt "text_id=15513 | speaker=unknown"
msgid "  There was no way she was going to ride the bike now."
msgstr "　どうも、有珠は自転車に乗れないらしい。"

#. Occurrence B_1:907:15514: scene=B_1
#: B_1:907
msgctxt "text_id=15514 | speaker=unknown"
msgid "  Sensing her stubborn streak, he desperately called out to her."
msgstr "　目に見えて意地を張っている有珠を、草十郎は必死に呼び止めた。"

#. Occurrence B_1:949:15515: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0008; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:949
msgctxt "text_id=15515 | speaker=soujuurou"
msgid "\"I take it back, I'm sorry, I'll go get it right now, you can take your anger out on me later!\""
msgstr "「待った、今のはこっちが悪かった。すぐに持ってくるから、怒るのはツケにしておいてくれ」"

#. Occurrence B_1:967:15516: scene=B_1
#: B_1:967
msgctxt "text_id=15516 | speaker=unknown"
msgid "  Alice stopped."
msgstr "　聞いて、ぴたりと有珠の足が止まる。"

#. Occurrence B_1:1023:15517: scene=B_1
#: B_1:1023
msgctxt "text_id=15517 | speaker=unknown"
msgid "  As soon as he saw her stop, he hurried to the rear courtyard,"
msgstr "　有珠の停止を確認して、草十郎は急いで裏庭に向かった。"

#. Occurrence B_1:1029:15518: scene=B_1
#: B_1:1029
msgctxt "text_id=15518 | speaker=unknown"
msgid "  grabbed the key from where it was hanging,"
msgstr "　納屋の鍵置き場から自転車の鍵を取って、"

msgctxt "text_id=15519 | speaker=unknown"
msgid " and used it to unlock Aoko's bicycle."
msgstr "青子愛用の自転車のロックを外す。"

#. Occurrence B_1:1053:15520: scene=B_1
#: B_1:1053
msgctxt "text_id=15520 | speaker=unknown"
msgid "  By the time Soujyuro brought it back to the front of the mansion, Alice was continuing toward the forest."
msgstr "　自転車を引いて洋館の正面に戻ると、有珠はもう森に向かっていた。"

#. Occurrence B_1:1074:15521: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0009; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:1074
msgctxt "text_id=15521 | speaker=soujuurou"
msgid "\"...I think I finally have you figured out, Alice.\""
msgstr "「……有珠の性格、なんとなく掴めてきたな……」"

#. Occurrence B_1:1081:15522: scene=B_1
#: B_1:1081
msgctxt "text_id=15522 | speaker=unknown"
msgid "  Muttering to himself, he straddled the bike."
msgstr "　呟いて、草十郎は自転車にまたがった。"

#. Occurrence B_1:1086:15523: scene=B_1
#: B_1:1086
msgctxt "text_id=15523 | speaker=unknown"
msgid "  He rested his foot on a pedal. It felt light, but sturdy."
msgstr "　ペダルに足を置く。軽いが確かな感触。"

#. Occurrence B_1:1093:15524: scene=B_1
#: B_1:1093
msgctxt "text_id=15524 | speaker=unknown"
msgid "  Confident the bike could support his weight and Alice's, he began pedaling."
msgstr "　これなら二人分の体重が乗っても問題ない、と自転車を走らせた。"

#. Occurrence B_1:1127:15525: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0010; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:1127
msgctxt "text_id=15525 | speaker=soujuurou"
msgid "\"Alice!\""
msgstr "「有珠！」"

#. Occurrence B_1:1175:15526: scene=B_1
#: B_1:1175
msgctxt "text_id=15526 | speaker=unknown"
msgid "  She turned as he called out to her,"
msgstr "　呼びかけに振りむく有珠。"

#. Occurrence B_1:1180:15527: scene=B_1
#: B_1:1180
msgctxt "text_id=15527 | speaker=unknown"
msgid "  before shooting him a piercing glare."
msgstr "　あきらかに草十郎を非難している眼差しである。"

#. Occurrence B_1:1243:15528: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0011; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:1243
msgctxt "text_id=15528 | speaker=soujuurou"
msgid "\"Come on. Hop on the back. No cushion though, so it won't be a comfy ride. Let me know if it's too uncomfortable.\""
msgstr "「行こう、後ろの荷台に乗ってくれ。でもクッションがないから痛いと思う。辛かったら言ってくれ、止めるから」"

#. Occurrence B_1:1249:15529: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0010; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:1249
msgctxt "text_id=15529 | speaker=alice"
msgid "\"...I'll be fine. Worry about yourself.\""
msgstr "「……わたしは大丈夫よ。静希君が、イヤじゃなければの話だけど」"

#. Occurrence B_1:1260:15530: scene=B_1
#: B_1:1260
msgctxt "text_id=15530 | speaker=unknown"
msgid "  He had hit the nail on the head. Alice definitely held a grudge over the smallest things."
msgstr "　……やはり、些細な事でも怒らせると根に持つ性格なんだな、と学習する草十郎なのだった。"

#. Occurrence B_1:1322:15531: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0012; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:1322
msgctxt "text_id=15531 | speaker=soujuurou"
msgid "\"If that's the issue then there is no issue. I'm happy to give you a ride. We're going to Aida Church, right?\""
msgstr "「そういうコトなら問題ないよ。有珠が後ろにいてくれるのは嬉しい。それで、行き先は合田教会でいいんだな？」"

#. Occurrence B_1:1356:15532: scene=B_1
#: B_1:1356
msgctxt "text_id=15532 | speaker=unknown"
msgid "  Unabashed and undaunted, he plowed on."
msgstr "　臆面もない草十郎の返答。"

#. Occurrence B_1:1361:15533: scene=B_1
#: B_1:1361
msgctxt "text_id=15533 | speaker=unknown"
msgid "  His tone seemed to ease Alice's mood. She nodded calmly, and took a seat on the luggage rack above the rear tire."
msgstr "　それに毒気が抜かれたのか、有珠はこくんとうなずいて、自転車の後部座席に腰を下ろした。"

#. Occurrence B_1:1442:15534: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0011; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:1442
msgctxt "text_id=15534 | speaker=alice"
msgid "\"...I'm going to hold on to you, okay? You don't mind me touching you, do you?\""
msgstr "「…………手を回すけど。わたしが触れても、平気？」"

#. Occurrence B_1:1474:15535: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0013; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:1474
msgctxt "text_id=15535 | speaker=soujuurou"
msgid "\"Why wouldn't I? I'm tougher than I look.\""
msgstr "「？　大丈夫だよ、体力があるのはさっき証明しただろ」"

#. Occurrence B_1:1507:15536: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0012; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:1507
msgctxt "text_id=15536 | speaker=alice"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence B_1:1513:15537: scene=B_1
#: B_1:1513
msgctxt "text_id=15537 | speaker=unknown"
msgid "  Alice silently wrapped her arms around Soujyuro."
msgstr "　有珠は無言で草十郎の体に手を回す。"

#. Occurrence B_1:1519:15538: scene=B_1
#: B_1:1519
msgctxt "text_id=15538 | speaker=unknown"
msgid "  Once she had held on tightly enough,"
msgstr "　有珠の手がしっかりと自分を掴んだのを確認して、よし、"

msgctxt "text_id=15539 | speaker=unknown"
msgid " he gripped the handle bars."
msgstr "と草十郎はハンドルを握った。"

#. Occurrence B_1:1565:15540: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0014; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:1565
msgctxt "text_id=15540 | speaker=soujuurou"
msgid "\"Good,\""
msgstr "「良かった」"

#. Occurrence B_1:1570:15541: scene=B_1
#: B_1:1570
msgctxt "text_id=15541 | speaker=unknown"
msgid "  he said quietly."
msgstr "　なんて、小さな呟きと共に。"

#. Occurrence B_1:1625:15542: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0013; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:1625
msgctxt "text_id=15542 | speaker=alice"
msgid "\"What's 'good'...?\""
msgstr "「何が良かったの……？」"

#. Occurrence B_1:1636:15543: scene=B_1
#: B_1:1636
msgctxt "text_id=15543 | speaker=unknown"
msgid "  Soujyuro turned to her, an ambiguous expression on his face, and then began pedaling vigorously."
msgstr "　有珠のささやきに、草十郎は曖昧な視線を返し、勢いよくペダルを踏み込んだ。"

#. Occurrence B_1:1648:15544: scene=B_1
#: B_1:1648
msgctxt "text_id=15544 | speaker=unknown"
msgid "  He let go of the brakes, and the bicycle hurtled down Shiroinuzuka's steep incline."
msgstr "　自転車は白犬塚の急な坂道を、ノーブレーキで駆け下りていく。"

#. Occurrence B_1:1715:15545: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0014; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:1715
msgctxt "text_id=15545 | speaker=alice"
msgid "\"...!\""
msgstr "「っ……！」"

#. Occurrence B_1:1720:15546: scene=B_1
#: B_1:1720
msgctxt "text_id=15546 | speaker=unknown"
msgid "  Surprised by the sudden speed, Alice gasped,"
msgstr "　自分で言いだした事とはいえ、予想以上のスピードに有珠は息を呑んだ。"

#. Occurrence B_1:1725:15547: scene=B_1
#: B_1:1725
msgctxt "text_id=15547 | speaker=unknown"
msgid "  and clutched Soujyuro tighter."
msgstr "　あまりの急加速に、草十郎の両肩をぐっと掴んでしまったぐらいだ。"

#. Occurrence B_1:1773:15548: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_1_0015; voice_prefix=A40; voice_category=2; scene=B_1
#: B_1:1773
msgctxt "text_id=15548 | speaker=alice"
msgid "\"Si―\""
msgstr "「し―――」"

#. Occurrence B_1:1778:15549: scene=B_1
#: B_1:1778
msgctxt "text_id=15549 | speaker=unknown"
msgid "  She almost protested, but stopped when she saw the serious expression on Soujyuro's face."
msgstr "　抗議の声をあげようと草十郎を見上げるが、草十郎は有珠以上に真剣な顔でハンドルを握っていた。"

#. Occurrence B_1:1783:15550: scene=B_1
#: B_1:1783
msgctxt "text_id=15550 | speaker=unknown"
msgid "  Instead, she decided to tighten her grip."
msgstr "　有珠はのど元まで出かかった声をおさえて、回した手を強く握る。"

#. Occurrence B_1:1788:15551: scene=B_1
#: B_1:1788
msgctxt "text_id=15551 | speaker=unknown"
msgid "  Under the night sky, a young girl had put her faith in a young boy."
msgstr "　夜の坂道を下る、生真面目な操縦者を信頼するように。"

#. Occurrence B_1:1931:15552: scene=B_1
#: B_1:1931
msgctxt "text_id=15552 | speaker=unknown"
msgid "  Faster than a rollercoaster, the bicycle hurtled toward Misaki Station."
msgstr "　自転車は最後までブレーキもかけず、ジェットコースター顔負けの速さで三咲町の駅前まで走っていく。"

#. Occurrence B_1:1936:15553: scene=B_1
#: B_1:1936
msgctxt "text_id=15553 | speaker=unknown"
msgid "  Around the station, there was no sight of cars or people."
msgstr "　午前零時を過ぎた駅前には人の気配も車のヘッドライトもない。"

#. Occurrence B_1:1956:15554: scene=B_1
#: B_1:1956
msgctxt "text_id=15554 | speaker=unknown"
msgid "  While the town slept under its snowy blanket, two people were racing like the wind."
msgstr "　完全に眠りについた町中、いまだ雪に埋もれた道の上を、風のように駆けていく。"

#. Occurrence B_1:1961:15555: scene=B_1
#: B_1:1961
msgctxt "text_id=15555 | speaker=unknown"
msgid "  While he pedaled, the boy said,"
msgstr "　そんな中、"

#. Occurrence B_1:2001:15556: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_1_0015; voice_prefix=A30; voice_category=3; scene=B_1
#: B_1:2001
msgctxt "text_id=15556 | speaker=soujuurou"
msgid "\"Whew. Riding tandem is way easier than I thought.\""
msgstr "「……ほんとに良かった。ふたり乗りが思ったより簡単で」"

#. Occurrence B_1:2006:15557: scene=B_1
#: B_1:2006
msgctxt "text_id=15557 | speaker=unknown"
msgid "  But he was alone in his relief."
msgstr "　ホッと安堵する乗り手がひとり。"

#. Occurrence B_1:2011:15558: scene=B_1
#: B_1:2011
msgctxt "text_id=15558 | speaker=unknown"
msgid "  It was their first bicycle ride together, and they spent it speeding down an empty highway."
msgstr "　初めて自転車に乗る少年少女は、無人の国道を激走していく。"

#. Occurrence B_1:2016:15559: scene=B_1
#: B_1:2016
msgctxt "text_id=15559 | speaker=unknown"
msgid "  The boy's words were lost to the howling wind, fortunately."
msgstr "　ゾッとする彼の呟きは、幸いにも風切り音にまぎれて、誰に届く事なく消えていった。"

#. Occurrence B_2:55:15560: scene=B_2
#: B_2:55
msgctxt "text_id=15560 | speaker=unknown"
msgid "  In spite of the late hour, there were still lights on in the church."
msgstr "　深夜にも拘わらず、教会には明かりが灯っていた。"

#. Occurrence B_2:60:15561: scene=B_2
#: B_2:60
msgctxt "text_id=15561 | speaker=unknown"
msgid "  Originally, the only light at this time of night came from the entrance to the sleepless hospital, ever vigilant and ready to receive patients."
msgstr "　本来、不慮の事故にそなえて眠らずの番である病院には、<仄暗|ほのぐら>い明かりが正面玄関に灯るのみ。"

#. Occurrence B_2:65:15562: scene=B_2
#: B_2:65
msgctxt "text_id=15562 | speaker=unknown"
msgid "  However, this was a quiet town with little night life."
msgstr "　娯楽の少ない田舎の町である。"

#. Occurrence B_2:70:15563: scene=B_2
#: B_2:70
msgctxt "text_id=15563 | speaker=unknown"
msgid "  The hospital saw perhaps one emergency patient per night, however,"
msgstr "　深夜の急患はそれこそ一日に一人いるかいないかで、"

#. Occurrence B_2:75:15564: scene=B_2
#: B_2:75
msgctxt "text_id=15564 | speaker=unknown"
msgid "  and it was not equipped to handle tonight's sole patient."
msgstr "　今夜はただ、その一人が病院の手には負えない重傷者であっただけの話だ。"

#. Occurrence B_2:122:15565: scene=B_2
#: B_2:122
msgctxt "text_id=15565 | speaker=unknown"
msgid "  It was a little before one o'clock in the morning."
msgstr "　時刻は午前一時前。"

#. Occurrence B_2:127:15566: scene=B_2
#: B_2:127
msgctxt "text_id=15566 | speaker=unknown"
msgid "  Leaving the bicycle outside, the two headed into the church."
msgstr "　自転車を外に止めて、ふたりは教会に向かう。"

#. Occurrence B_2:132:15567: scene=B_2
#: B_2:132
msgctxt "text_id=15567 | speaker=unknown"
msgid "  With its snow-covered roof, the church looked like it was wearing a white hat that lit up the darkness."
msgstr "　雪をかぶり、闇夜の中でもはっきりと浮かび上がる三角屋根の建物。"

#. Occurrence B_2:137:15568: scene=B_2
#: B_2:137
msgctxt "text_id=15568 | speaker=unknown"
msgid "  In the entrance stood a tall shadow."
msgstr "　その入り口に、背の高い影が立っていた。"

#. Occurrence B_2:173:15569: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_2_0000; voice_prefix=B40; voice_category=8; scene=B_2
#: B_2:173
msgctxt "text_id=15569 | speaker=eiri"
msgid "\"Miss Kuonji.\""
msgstr "「久遠寺さん」"

#. Occurrence B_2:190:15570: scene=B_2
#: B_2:190
msgctxt "text_id=15570 | speaker=unknown"
msgid "  The man's voice was placid."
msgstr "　落ち着いた男性の声。"

#. Occurrence B_2:195:15571: scene=B_2
#: B_2:195
msgctxt "text_id=15571 | speaker=unknown"
msgid "  Dressed in a long coat, he had been waiting for Alice."
msgstr "　マントのような<外套|がいとう>を羽織った男は、入り口で有珠を待っていた。"

#. Occurrence B_2:227:15572: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_2_0000; voice_prefix=A40; voice_category=2; scene=B_2
#: B_2:227
msgctxt "text_id=15572 | speaker=alice"
msgid "\"Father Eiri. Is Aoko-\""
msgstr "「<詠梨|えいり>神父。青子は―――」"

#. Occurrence B_2:251:15573: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_2_0001; voice_prefix=B40; voice_category=8; scene=B_2
#: B_2:251
msgctxt "text_id=15573 | speaker=eiri"
msgid "\"Yuika is tending to her now. By the time I got to the scene, there were others already."
msgstr "「<唯架|ゆいか>が診ています。私が駆け付けた時には手遅れでした。"

#. Occurrence B_2:257:15574: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_2_0002; voice_prefix=B40; voice_category=8; scene=B_2
#: B_2:257
msgctxt "text_id=15574 | speaker=eiri"
msgid "  I'd like to notify her family.\""
msgstr "　蒼崎の家に伝令を願いたいのですが」"

#. Occurrence B_2:278:15575: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_2_0001; voice_prefix=A40; voice_category=2; scene=B_2
#: B_2:278
msgctxt "text_id=15575 | speaker=alice"
msgid "\"...Aoko wouldn't want that. Besides, I believe they're trapped in the castle. Touko seems to have tied down their grandfather, too.\""
msgstr "「……青子はそれを望まないわ。それに、あちらも今は城に捕らわれているそうです。今夜の相手は、真っ先に青子の祖父の動きを封じたようですから」"

#. Occurrence B_2:298:15576: scene=B_2
#: B_2:298
msgctxt "text_id=15576 | speaker=unknown"
msgid "  The two exchanged pleasantries."
msgstr "　断片的な言葉が交わされる。"

#. Occurrence B_2:303:15577: scene=B_2
#: B_2:303
msgctxt "text_id=15577 | speaker=unknown"
msgid "  Soujyuro did not move from the foot of the stairs."
msgstr "　草十郎は階段の手前から動かない。"

#. Occurrence B_2:322:15578: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_2_0003; voice_prefix=B40; voice_category=8; scene=B_2
#: B_2:322
msgctxt "text_id=15578 | speaker=eiri"
msgid "\"Oh? And who is this?\""
msgstr "「おや……そちらは？」"

#. Occurrence B_2:327:15579: scene=B_2
#: B_2:327
msgctxt "text_id=15579 | speaker=unknown"
msgid "  Though the father seemed calm, his words had an edge to them."
msgstr "　落ち着いていた男の声が、かすかに<険|けん>を含む。"

#. Occurrence B_2:353:15580: scene=B_2
#: B_2:353
msgctxt "text_id=15580 | speaker=unknown"
msgid "  As if to protect Soujyuro from his gaze, Alice stepped between them."
msgstr "　その視線から草十郎を庇うように、有珠は男の前に歩みでた。"

#. Occurrence B_2:401:15581: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_2_0002; voice_prefix=A40; voice_category=2; scene=B_2
#: B_2:401
msgctxt "text_id=15581 | speaker=alice"
msgid "\"...This is Aoko's familiar-though their contract hasn't been fulfilled yet.\""
msgstr "「……彼は青子の使い魔。契約はまだ成されていないけれど」"

#. Occurrence B_2:412:15582: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_2_0000; voice_prefix=A30; voice_category=3; scene=B_2
#: B_2:412
msgctxt "text_id=15582 | speaker=soujuurou"
msgid "\"'Familiar?' Ali-\""
msgstr "「使い魔って、有珠」"

#. Occurrence B_2:417:15583: scene=B_2
#: B_2:417
msgctxt "text_id=15583 | speaker=unknown"
msgid "  Soujyuro was about to complain, but Alice shot him a fiery glare"
msgstr "　文句を言いかける草十郎に、有珠は火のような視線を向ける。"

#. Occurrence B_2:444:15584: scene=B_2
#: B_2:444
msgctxt "text_id=15584 | speaker=unknown"
msgid "that all but said, \"Just shut up and play along.\""
msgstr "“いいから黙っていて”と。"

#. Occurrence B_2:465:15585: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_2_0004; voice_prefix=B40; voice_category=8; scene=B_2
#: B_2:465
msgctxt "text_id=15585 | speaker=eiri"
msgid "\"I see. This is the first I've heard of it, but I'll let it slide."
msgstr "「そうですか。そのような申告はありませんでしたが、届けが遅れたのは不問としましょう。"

#. Occurrence B_2:491:15586: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_2_0005; voice_prefix=B40; voice_category=8; scene=B_2
#: B_2:491
msgctxt "text_id=15586 | speaker=eiri"
msgid "  I mean, you are both in conflict with an outside mage, after all. That should take priority.\""
msgstr "　外部の魔術師と交戦中でしたからね。貴女たちはその撃退を最優先にした、という事で」"

#. Occurrence B_2:496:15587: scene=B_2
#: B_2:496
msgctxt "text_id=15587 | speaker=unknown"
msgid "  Alice nodded in thanks."
msgstr "　神父の返答に、有珠は少しだけ頭を下げた。"

#. Occurrence B_2:532:15588: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_2_0003; voice_prefix=A40; voice_category=2; scene=B_2
#: B_2:532
msgctxt "text_id=15588 | speaker=alice"
msgid "\"I'll be going in now. ...Let him enter, too.\""
msgstr "「では通ります。……彼の同行を許可しなさい」"

#. Occurrence B_2:551:15589: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_2_0006; voice_prefix=B40; voice_category=8; scene=B_2
#: B_2:551
msgctxt "text_id=15589 | speaker=eiri"
msgid "\"He is most welcome. I will begin preparations for mediation. If a change of administrators is imminent, I have to prepare documents for both parties."
msgstr "「ご自由に。私はこれより調停に向かいます。管理者が替わるのなら、両<組織|きょうかい>への資料を用意しなければいけませんので。"

#. Occurrence B_2:563:15590: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_2_0007; voice_prefix=B40; voice_category=8; scene=B_2
#: B_2:563
msgctxt "text_id=15590 | speaker=eiri"
msgid "  I'm leaving things to Ritsuka in my absence, so send any questions her way.\""
msgstr "　ああ、留守中は<律架|りつか>に任せてありますから、必要なものがあれば彼女に」"

#. Occurrence B_2:589:15591: scene=B_2
#: B_2:589
msgctxt "text_id=15591 | speaker=unknown"
msgid "  As if passing the baton, Father Eiri exited the church."
msgstr "　詠梨神父と呼ばれた人物は、ふたりと入れ替わるように教会の敷地から外に出た。"

#. Occurrence B_2:596:15592: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_2_0001; voice_prefix=A30; voice_category=3; scene=B_2
#: B_2:596
msgctxt "text_id=15592 | speaker=soujuurou"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence B_2:601:15593: scene=B_2
#: B_2:601
msgctxt "text_id=15593 | speaker=unknown"
msgid "  Soujyuro took two full steps back to give him a wide berth."
msgstr "　つられて、草十郎はきっかり<二間|にけん>ばかりの距離、おおげさに後退した。"

#. Occurrence B_2:682:15594: scene=B_2
#: B_2:682
msgctxt "text_id=15594 | speaker=unknown"
msgid "  The priest had a dignified air about him."
msgstr "　通り過ぎていく間、神父の風貌が明確になる。"

#. Occurrence B_2:687:15595: scene=B_2
#: B_2:687
msgctxt "text_id=15595 | speaker=unknown"
msgid "  To put it bluntly, he was strikingly beautiful."
msgstr "　一言、美しい男だった。"

#. Occurrence B_2:692:15596: scene=B_2
#: B_2:692
msgctxt "text_id=15596 | speaker=unknown"
msgid "  Straight nose, glistening lips..."
msgstr "　すっと通った<鼻梁|びりょう>と、<艶|つや>を持った唇。"

#. Occurrence B_2:697:15597: scene=B_2
#: B_2:697
msgctxt "text_id=15597 | speaker=unknown"
msgid "  ...not a single imperfection on his mildly effeminate face."
msgstr "　一点の歪みもない<面|おもて>は中性的ですらある。"

#. Occurrence B_2:702:15598: scene=B_2
#: B_2:702
msgctxt "text_id=15598 | speaker=unknown"
msgid "  But that only went as far as his appearance. His manner lacked any hint of softness or grace."
msgstr "　もっとも、それは外見だけの話で、神父の立ち振る舞いには女性らしい柔らかさは微塵もない。"

#. Occurrence B_2:707:15599: scene=B_2
#: B_2:707
msgctxt "text_id=15599 | speaker=unknown"
msgid "  Just by looking at him, you could tell he was dependable, like tempered steel, despite being somewhat unapproachable."
msgstr "　鍛えられた<鋼|はがね>を思わせる、頼りになるが近寄りがたい、そんな雰囲気を持っていた。"

#. Occurrence B_2:739:15600: scene=B_2
#: B_2:739
msgctxt "text_id=15600 | speaker=unknown"
msgid "  The priest disappeared silently into the night, the darkness of his coat overpowering the moonlight."
msgstr "　神父は足音もたてず、黒い外套で月光をはじくように闇夜に消えていく。"

#. Occurrence B_2:744:15601: scene=B_2
#: B_2:744
msgctxt "text_id=15601 | speaker=unknown"
msgid "  In awe, Soujyuro watched him leave."
msgstr "　その後ろ姿を呆然と草十郎は見送った。"

#. Occurrence B_2:783:15602: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_2_0002; voice_prefix=A30; voice_category=3; scene=B_2
#: B_2:783
msgctxt "text_id=15602 | speaker=soujuurou"
msgid "\"He's like some kind of sage, from the folktales.\""
msgstr "「……なんか、仙人みたいな人だな」"

#. Occurrence B_2:789:15603: scene=B_2
#: B_2:789
msgctxt "text_id=15603 | speaker=unknown"
msgid "  In his own way, Soujyuro was expressing affection."
msgstr "　呟きには草十郎なりの親しみがあった。"

#. Occurrence B_2:794:15604: scene=B_2
#: B_2:794
msgctxt "text_id=15604 | speaker=unknown"
msgid "  For some reason, Father Eiri's distant tone made him feel nostalgic."
msgstr "　他人を寄せ付けない雰囲気の詠梨神父に、どことなく懐かしいものを感じたらしい。"

#. Occurrence B_2:818:15605: scene=B_2
#: B_2:818
msgctxt "text_id=15605 | speaker=unknown"
msgid "  Alice gave Soujyuro a deathly stare."
msgstr "　一方。そんな草十郎に、有珠は厳しい視線を向ける。"

#. Occurrence B_2:854:15606: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_2_0004; voice_prefix=A40; voice_category=2; scene=B_2
#: B_2:854
msgctxt "text_id=15606 | speaker=alice"
msgid "\"Don't let your guard down. He's with the Church."
msgstr "「気を許さないで。彼は教会の人間よ。"

#. Occurrence B_2:860:15607: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_2_0005; voice_prefix=A40; voice_category=2; scene=B_2
#: B_2:860
msgctxt "text_id=15607 | speaker=alice"
msgid "  His job is to monitor us, but this time we had to ask for his help."
msgstr "　わたしたちを監視する側だけど、今回は彼の手を借りるしかなかっただけ。"

#. Occurrence B_2:866:15608: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_2_0006; voice_prefix=A40; voice_category=2; scene=B_2
#: B_2:866
msgctxt "text_id=15608 | speaker=alice"
msgid "  If it were allowed, I'd make him disappear off the face of the Earth.\""
msgstr "　……許されるなら、真っ先に消えてほしい人間だから」"

#. Occurrence B_2:907:15609: scene=B_2
#: B_2:907
msgctxt "text_id=15609 | speaker=unknown"
msgid "  Her curse ringing in the air, Alice placed her hand on the doors to the chapel."
msgstr "　<呪詛|じゅそ>とも取れる呟きを残して、有珠は礼拝堂の扉に手をかけた。"

#. Occurrence B_2:912:15610: scene=B_2
#: B_2:912
msgctxt "text_id=15610 | speaker=unknown"
msgid "  They were twice her height and who knows how heavy."
msgstr "　扉は有珠より二倍ほど高く、重そうな両開きだ。"

#. Occurrence B_2:917:15611: scene=B_2
#: B_2:917
msgctxt "text_id=15611 | speaker=unknown"
msgid "  It did not look like she could open them any time soon."
msgstr "　有珠ひとりでは開けられそうにない。"

#. Occurrence B_2:923:15612: scene=B_2
#: B_2:923
msgctxt "text_id=15612 | speaker=unknown"
msgid "  Soujyuro climbed the stairs three at a time, and helped Alice push the towering doors inward."
msgstr "　草十郎は階段を三段飛ばしで通過して、有珠と共に扉を押した。"

#. Occurrence B_3:56:15613: scene=B_3
#: B_3:56
msgctxt "text_id=15613 | speaker=unknown"
msgid "  The dim light of the chapel brought with it the familiar scent of burning oil."
msgstr "　礼拝堂の明かりは、懐かしい油の匂いがした。"

#. Occurrence B_3:61:15614: scene=B_3
#: B_3:61
msgctxt "text_id=15614 | speaker=unknown"
msgid "  The ecclesiastical interior was breathtaking."
msgstr "　高い天井。"

#. Occurrence B_3:66:15615: scene=B_3
#: B_3:66
msgctxt "text_id=15615 | speaker=unknown"
msgid "  The tall ceiling... The stained-glass windows on every wall..."
msgstr "　壁一面の装飾硝子。"

#. Occurrence B_3:71:15616: scene=B_3
#: B_3:71
msgctxt "text_id=15616 | speaker=unknown"
msgid "  It all felt intended to illustrate the presence of the Holy Spirit within those chambers."
msgstr "　あまりにも<白々|しらじら>しく神々しい、聖霊の実在を証明する為の舞台装置。"

#. Occurrence B_3:76:15617: scene=B_3
#: B_3:76
msgctxt "text_id=15617 | speaker=unknown"
msgid "  Like the foyer in the Kuonji Estate, there was not a single heater; the bitter cold made the chapel feel more severe."
msgstr "　久遠寺邸のホールと同じく、礼拝堂にも暖房器具のたぐいは一切ない。<軋|きし>むような寒さが、礼拝堂をより厳格な空間へと変えている。"

#. Occurrence B_3:114:15618: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0000; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:114
msgctxt "text_id=15618 | speaker=ritsuka"
msgid "\"Allie, over here.\""
msgstr "「アッちゃん、こっちよ」"

#. Occurrence B_3:132:15619: scene=B_3
#: B_3:132
msgctxt "text_id=15619 | speaker=unknown"
msgid "  The gentle voice echoed through the chapel, incongruous to its surroundings."
msgstr "　そんな礼拝堂で、やや場違いな声が響いた。"

#. Occurrence B_3:137:15620: scene=B_3
#: B_3:137
msgctxt "text_id=15620 | speaker=unknown"
msgid "  It was the voice of a woman."
msgstr "　柔らかな女性の声だ。"

#. Occurrence B_3:172:15621: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_3_0000; voice_prefix=A40; voice_category=2; scene=B_3
#: B_3:172
msgctxt "text_id=15621 | speaker=alice"
msgid "\"Ritsuka? Is that you?\""
msgstr "「<律架|りつか>さん？　奥？」"

#. Occurrence B_3:178:15622: scene=B_3
#: B_3:178
msgctxt "text_id=15622 | speaker=unknown"
msgid "  Alice made her way past the rows of pews toward the front altar."
msgstr "　有珠は奥の祭壇に向かって、長椅子の葬列を横断する。"

#. Occurrence B_3:185:15623: scene=B_3
#: B_3:185
msgctxt "text_id=15623 | speaker=unknown"
msgid "  Soujyuro closed the large doors and hurried after her."
msgstr "　草十郎も扉を閉めて、その背中を追いかけた。"

#. Occurrence B_3:258:15624: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0001; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:258
msgctxt "text_id=15624 | speaker=ritsuka"
msgid "\"You got here fast. I was just thinking of coming to see you.\""
msgstr "「早かったわね。これから迎えに行こうと思ったのに」"

#. Occurrence B_3:283:15625: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_3_0001; voice_prefix=A40; voice_category=2; scene=B_3
#: B_3:283
msgctxt "text_id=15625 | speaker=alice"
msgid "\"...I had another pair of legs.\""
msgstr "「……使える足があったから。後ろの彼」"

#. Occurrence B_3:316:15626: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0002; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:316
msgctxt "text_id=15626 | speaker=ritsuka"
msgid "\"Legs...? Oh, you mean him?\""
msgstr "「足って……あれ、貴方？」"

#. Occurrence B_3:345:15627: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_3_0000; voice_prefix=A30; voice_category=3; scene=B_3
#: B_3:345
msgctxt "text_id=15627 | speaker=soujuurou"
msgid "\"Ah!\""
msgstr "「あ」"

#. Occurrence B_3:365:15628: scene=B_3
#: B_3:365
msgctxt "text_id=15628 | speaker=unknown"
msgid "  Soujyuro showed himself, surprising the woman."
msgstr "　有珠の紹介を受けて顔をだす草十郎と、女性の驚きが重なる。"

#. Occurrence B_3:370:15629: scene=B_3
#: B_3:370
msgctxt "text_id=15629 | speaker=unknown"
msgid "  They stared intently at each other, wondering what the other was doing here."
msgstr "　ふたりはまじまじと、ここに居るはずのない顔を眺めるのだった。"

#. Occurrence B_3:421:15630: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_3_0002; voice_prefix=A40; voice_category=2; scene=B_3
#: B_3:421
msgctxt "text_id=15630 | speaker=alice"
msgid "\"...You two know each other?\""
msgstr "「……知り合い？」"

#. Occurrence B_3:447:15631: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0003; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:447
msgctxt "text_id=15631 | speaker=ritsuka"
msgid "\"Yes, although I didn't expect to see him here."
msgstr "「あ、うん、まずい事に知り合い。"

#. Occurrence B_3:458:15632: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0004; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:458
msgctxt "text_id=15632 | speaker=ritsuka"
msgid "  Soujyuro, when you said you'd moved... you meant you were staying at Allie's?\""
msgstr "　草十郎さん、引っ越したって話だけど……もしかしてアッちゃんのところに下宿してるの？」"

#. Occurrence B_3:463:15633: scene=B_3
#: B_3:463
msgctxt "text_id=15633 | speaker=unknown"
msgid "  Soujyuro nodded."
msgstr "　はい、とうなずく草十郎。"

#. Occurrence B_3:468:15634: scene=B_3
#: B_3:468
msgctxt "text_id=15634 | speaker=unknown"
msgid "  Alice turned visibly sour at this unexpected development."
msgstr "　予想外の展開に、有珠の機嫌は目に見えて悪くなる。"

#. Occurrence B_3:501:15635: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_3_0003; voice_prefix=A40; voice_category=2; scene=B_3
#: B_3:501
msgctxt "text_id=15635 | speaker=alice"
msgid "\"...What're you talking about, Ritsuka? How do you know each other?\""
msgstr "「……どういう事？　静希君、律架さんとはどういう関係？」"

#. Occurrence B_3:513:15636: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0005; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:513
msgctxt "text_id=15636 | speaker=ritsuka"
msgid "\"Well..."
msgstr "「関係って、そうね……。"

#. Occurrence B_3:525:15637: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0006; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:525
msgctxt "text_id=15637 | speaker=ritsuka"
msgid "  He always gave me a discount at the fish market,"
msgstr "　お魚屋さんでしょっちゅう割引してもらったり、"

#. Occurrence B_3:531:15638: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0007; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:531
msgctxt "text_id=15638 | speaker=ritsuka"
msgid "  helped me with my bags, drank tea with me..."
msgstr "　荷物持ちを頼んでみたり、"

#. Occurrence B_3:543:15639: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0008; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:543
msgctxt "text_id=15639 | speaker=ritsuka"
msgid "  He's like every housewife's best friend.\""
msgstr "　たまにお茶飲んだりする……主婦の友、みたいな？」"

#. Occurrence B_3:555:15640: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_3_0004; voice_prefix=A40; voice_category=2; scene=B_3
#: B_3:555
msgctxt "text_id=15640 | speaker=alice"
msgid "\"That doesn't make any sense. You're not married, Ritsuka.\""
msgstr "「意味が分かりません。律架さん、結婚していないでしょう」"

#. Occurrence B_3:581:15641: scene=B_3
#: B_3:581
msgctxt "text_id=15641 | speaker=unknown"
msgid "  Needless to say, Soujyuro was also not \"a housewife's best friend\" and all that suggested, but there were more urgent matters at hand."
msgstr "　無論、草十郎も主婦ではないのだが、今は自分のコトより彼女の既婚問題の方が重要らしかった。"

#. Occurrence B_3:618:15642: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0009; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:618
msgctxt "text_id=15642 | speaker=ritsuka"
msgid "\"Ouch. You had to go there, huh? I can't slip anything by you, can I, Allie.\""
msgstr "「うわあ、そこをつっこむのかあ……アッちゃん、わたしにだけは一切妥協がないのはどうかと思うの」"

#. Occurrence B_3:624:15643: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_3_0005; voice_prefix=A40; voice_category=2; scene=B_3
#: B_3:624
msgctxt "text_id=15643 | speaker=alice"
msgid "\"Well, what do you expect? I never know when you're being serious, so I have to question every weird thing you say.\""
msgstr "「律架さんの場合、どこまで本気か分からないから。おかしなところは、ぜんぶ追及しておかないといけないだけよ」"

#. Occurrence B_3:651:15644: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0010; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:651
msgctxt "text_id=15644 | speaker=ritsuka"
msgid "\"Just look at us! We must have been separated at birth."
msgstr "「あら素敵。仲の良い姉妹みたいね、わたしたち。"

#. Occurrence B_3:662:15645: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0011; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:662
msgctxt "text_id=15645 | speaker=ritsuka"
msgid "  Okay, I'll tell you the truth. I know him from the neighborhood association. He's not a spy or anything-not that he could be. I mean, you know, just look at him.\""
msgstr "　じゃ、その信頼に応えてホントのコト言うと、彼とは町内会の顔見知りよ。スパイ行為とかそういうんじゃないし、そもそもそんな器用な人じゃないでしょ、草十郎さんは」"

#. Occurrence B_3:699:15646: scene=B_3
#: B_3:699
msgctxt "text_id=15646 | speaker=unknown"
msgid "\"..."
msgstr "「…………"

#. Occurrence B_3:706:15647: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_3_0006; voice_prefix=A40; voice_category=2; scene=B_3
#: B_3:706
msgctxt "text_id=15647 | speaker=alice"
msgid "Is this true?\""
msgstr "本当？」"

#. Occurrence B_3:711:15648: scene=B_3
#: B_3:711
msgctxt "text_id=15648 | speaker=unknown"
msgid "  Alice stared straight at Soujyuro"
msgstr "　ジトっとした目で草十郎を見据える有珠。"

#. Occurrence B_3:717:15649: scene=B_3
#: B_3:717
msgctxt "text_id=15649 | speaker=unknown"
msgid " to let him know she was mad at him for hiding this from her."
msgstr "批難の目というより、隠し事をされて怒っているような目だ。"

#. Occurrence B_3:762:15650: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_3_0001; voice_prefix=A30; voice_category=3; scene=B_3
#: B_3:762
msgctxt "text_id=15650 | speaker=soujuurou"
msgid "\"Yes? I know her from my part-time job at the fish market."
msgstr "「本当だ。魚屋でバイトしてる時に知り合った人だ。"

#. Occurrence B_3:768:15651: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_3_0002; voice_prefix=A30; voice_category=3; scene=B_3
#: B_3:768
msgctxt "text_id=15651 | speaker=soujuurou"
msgid "  She was nice to me, so I gave her a free sardine to persuade her to come back.\""
msgstr "　前に親切にしてもらったんで、お礼に鰯を一匹サービスしたら、それ以来ごひいきに」"

#. Occurrence B_3:794:15652: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_3_0007; voice_prefix=A40; voice_category=2; scene=B_3
#: B_3:794
msgctxt "text_id=15652 | speaker=alice"
msgid "\"...\""
msgstr "「―――」"

#. Occurrence B_3:806:15653: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0012; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:806
msgctxt "text_id=15653 | speaker=ritsuka"
msgid "\"Exactly. Everybody who shops downtown knows Soujyuro."
msgstr "「そうそう。商店街で買い物してればイヤでも草十郎さんとは顔見知りになるわ。"

#. Occurrence B_3:818:15654: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0013; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:818
msgctxt "text_id=15654 | speaker=ritsuka"
msgid "  If it bothers you so much, Allie, go see for yourself. He's the secret stud of the shopping district.\""
msgstr "　アッちゃんも怒るぐらいなら買い物に来ればいいのに。ひそかな商店街のアイドルです、彼」"

#. Occurrence B_3:861:15655: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_3_0003; voice_prefix=A30; voice_category=3; scene=B_3
#: B_3:861
msgctxt "text_id=15655 | speaker=soujuurou"
msgid "\"She means I'm popular, not that my prices are easy to hammer down like some nail on the wall.\""
msgstr "「……アイドルとは人気者という意味で、値切りやすいカモって意味じゃない、ような」"

#. Occurrence B_3:866:15656: scene=B_3
#: B_3:866
msgctxt "text_id=15656 | speaker=unknown"
msgid "  His apparent popularity would have to be questioned another time."
msgstr "　ある意味人気者なのだが、それは置いておいて。"

#. Occurrence B_3:902:15657: scene=B_3
#: B_3:902
msgctxt "text_id=15657 | speaker=unknown"
msgid "  Collecting herself, Alice focused on the door in the recesses of the church."
msgstr "　気を取り直し、有珠は奥のドアに視線を向けた。"

#. Occurrence B_3:923:15658: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_3_0008; voice_prefix=A40; voice_category=2; scene=B_3
#: B_3:923
msgctxt "text_id=15658 | speaker=alice"
msgid "\"I don't know what's going on with you, Ritsuka, but he's with Aoko now."
msgstr "「律架さんの事情は知りませんが、彼は青子の連れです。"

#. Occurrence B_3:929:15659: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_3_0009; voice_prefix=A40; voice_category=2; scene=B_3
#: B_3:929
msgctxt "text_id=15659 | speaker=alice"
msgid "  That explanation will have to wait.\""
msgstr "　その他に説明は要りますか」"

#. Occurrence B_3:953:15660: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0014; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:953
msgctxt "text_id=15660 | speaker=ritsuka"
msgid "\"It all makes sense now. So much to say and so little time, but we can get to that later."
msgstr "「あー、やっぱりそういうコトなのね……。ま、言いたい事は色々あるけど、今はそれどころじゃないし。"

#. Occurrence B_3:965:15661: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0015; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:965
msgctxt "text_id=15661 | speaker=ritsuka"
msgid "  Fine. For you, Allie, I'll make an exception, and offer him our protection!\""
msgstr "　ええ、了解したわ。他ならぬアッちゃんの頼みだし、特殊な例だけど、彼はこちらで保護しましょう！」"

#. Occurrence B_3:971:15662: scene=B_3
#: B_3:971
msgctxt "text_id=15662 | speaker=unknown"
msgid "  Alice nodded, and began walking to the door."
msgstr "　律架の答えにうなずいて、有珠は奥のドアへと歩きだした。"

#. Occurrence B_3:1046:15663: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_3_0004; voice_prefix=A30; voice_category=3; scene=B_3
#: B_3:1046
msgctxt "text_id=15663 | speaker=soujuurou"
msgid "\"Alice...\""
msgstr "「有珠」"

#. Occurrence B_3:1052:15664: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0016; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:1052
msgctxt "text_id=15664 | speaker=ritsuka"
msgid "\"Stay, Soujyuro.\""
msgstr "「だめよ、草十郎さん」"

#. Occurrence B_3:1063:15665: scene=B_3
#: B_3:1063
msgctxt "text_id=15665 | speaker=unknown"
msgid "  As Soujyuro was about to follow Alice, Ritsuka stepped in his way."
msgstr "　有珠の後を追う草十郎を、割り入って止める律架。"

#. Occurrence B_3:1084:15666: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0017; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:1084
msgctxt "text_id=15666 | speaker=ritsuka"
msgid "\"You need to stay here. Leave this to the girls.\""
msgstr "「貴方は行ってはいけません。彼女たちに任せなさい」"

#. Occurrence B_3:1113:15667: scene=B_3
#: B_3:1113
msgctxt "text_id=15667 | speaker=unknown"
msgid "  she asserted bluntly."
msgstr "　ぴしゃりと律架は言い放つ。"

#. Occurrence B_3:1120:15668: scene=B_3
#: B_3:1120
msgctxt "text_id=15668 | speaker=unknown"
msgid "  Meanwhile, Alice had reached the door and entered further into the chapel."
msgstr "　立ち止まっている草十郎をよそに、有珠はドアを開け、礼拝堂の奥に行ってしまった。"

#. Occurrence B_3:1149:15669: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_3_0005; voice_prefix=A30; voice_category=3; scene=B_3
#: B_3:1149
msgctxt "text_id=15669 | speaker=soujuurou"
msgid "\"But why?\""
msgstr "「行ってはいけないって、どうして」"

#. Occurrence B_3:1155:15670: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0018; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:1155
msgctxt "text_id=15670 | speaker=ritsuka"
msgid "\"It's for your own good. No normal person should see Aoko in the state she's in. It'll be too much for you."
msgstr "「貴方のためよ。青子の容態は普通の人が見ていいものじゃない。気分を悪くするだけ。"

#. Occurrence B_3:1168:15671: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0019; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:1168
msgctxt "text_id=15671 | speaker=ritsuka"
msgid "  ...Unless, of course, you're so worried about her you don't care about that?\""
msgstr "　それとも……イヤな思いをしてもいいくらい、青子が心配なのかしら？」"

#. Occurrence B_3:1203:15672: scene=B_3
#: B_3:1203
msgctxt "text_id=15672 | speaker=unknown"
msgid "  Soujyuro was not able to give an immediate answer;"
msgstr "　律架の問いかけに、草十郎はすぐには答えられなかった。"

#. Occurrence B_3:1208:15673: scene=B_3
#: B_3:1208
msgctxt "text_id=15673 | speaker=unknown"
msgid "  it had finally hit him just how bad a state Aoko must be in."
msgstr "　……青子が良くない状況である事は分かっている。"

#. Occurrence B_3:1213:15674: scene=B_3
#: B_3:1213
msgctxt "text_id=15674 | speaker=unknown"
msgid "  Based on Alice's condition when he found her, he intuited that Aoko's injuries might be even worse."
msgstr "　有珠の様子から察して、有珠以上の傷を負っているのかもしれない。"

#. Occurrence B_3:1233:15675: scene=B_3
#: B_3:1233
msgctxt "text_id=15675 | speaker=unknown"
msgid "  He tried to imagine her expression in that state, but could not."
msgstr "　そこまで承知していて、草十郎には青子のまいっている顔を想像できなかった。"

#. Occurrence B_3:1266:15676: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_3_0006; voice_prefix=A30; voice_category=3; scene=B_3
#: B_3:1266
msgctxt "text_id=15676 | speaker=soujuurou"
msgid "\"...I never worry about Aozaki.\""
msgstr "「―――蒼崎相手に心配なんかしません」"

#. Occurrence B_3:1272:15677: scene=B_3
#: B_3:1272
msgctxt "text_id=15677 | speaker=unknown"
msgid "  Literally, he had never been worried about her before, not truly."
msgstr "　だから、本当の意味での心配を、彼はしていなかったのだ。"

#. Occurrence B_3:1293:15678: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0020; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:1293
msgctxt "text_id=15678 | speaker=ritsuka"
msgid "\"I can't stop you, can I?\""
msgstr "「でも、会いにいくのね」"

#. Occurrence B_3:1299:15679: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_3_0007; voice_prefix=A30; voice_category=3; scene=B_3
#: B_3:1299
msgctxt "text_id=15679 | speaker=soujuurou"
msgid "\"No.\""
msgstr "「はい」"

#. Occurrence B_3:1315:15680: scene=B_3
#: B_3:1315
msgctxt "text_id=15680 | speaker=unknown"
msgid "  He answered her reflexively."
msgstr "　律架の言葉に、草十郎は反射的に答えた。"

#. Occurrence B_3:1321:15681: scene=B_3
#: B_3:1321
msgctxt "text_id=15681 | speaker=unknown"
msgid "  Ritsuka sighed at the boy's naivete,"
msgstr "　少年の未熟な勘違いにため息をつきながら、"

msgctxt "text_id=15682 | speaker=unknown"
msgid " but nonetheless stepped aside."
msgstr "仕方なく律架は道を譲る。"

#. Occurrence B_3:1364:15683: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0021; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:1364
msgctxt "text_id=15683 | speaker=ritsuka"
msgid "\"Go on, then."
msgstr "「どうぞ、いってらっしゃい。"

#. Occurrence B_3:1370:15684: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0022; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:1370
msgctxt "text_id=15684 | speaker=ritsuka"
msgid "  Through the door Alice used. Fourth room in."
msgstr "　有珠さんが使ったドアから入って、四番目の部屋よ。"

#. Occurrence B_3:1376:15685: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0023; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:1376
msgctxt "text_id=15685 | speaker=ritsuka"
msgid "  Things are critical right now, so stay out of Yui's way.\""
msgstr "　いま一番とりこんでる頃だから、ユイちゃんの邪魔だけはしないように」"

#. Occurrence B_3:1409:15686: scene=B_3
#: B_3:1409
msgctxt "text_id=15686 | speaker=unknown"
msgid "  Soujyuro thanked her and went after Alice."
msgstr "　律架に礼を言って、草十郎は有珠の後を追った。"

#. Occurrence B_3:1414:15687: scene=B_3
#: B_3:1414
msgctxt "text_id=15687 | speaker=unknown"
msgid "  Leaving Ritsuka Suse, the self-proclaimed 'everybody's friendly neighbor,' alone."
msgstr "　礼拝堂には自称・近所のお姉さんである<周|す><瀬|せ>律架だけが残される。"

#. Occurrence B_3:1459:15688: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0024; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:1459
msgctxt "text_id=15688 | speaker=ritsuka"
msgid "\"Yuika'll probably stop him, but someone's got to be in Soujyuro's corner. I have a soft spot for broken boys."
msgstr "「……さて。唯架あたりなら止めるんでしょうけど、ま、わたしは草十郎さんの味方だし、傷つく男の子とか大好物だし。"

#. Occurrence B_3:1470:15689: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_3_0025; voice_prefix=B30; voice_category=9; scene=B_3
#: B_3:1470
msgctxt "text_id=15689 | speaker=ritsuka"
msgid "  I know I'm playing rough with him, but it's for his own good. I say let him learn to regret!\""
msgstr "　少々スパルタと自覚しておりますが、これも親切な姉心と思って、草十郎さんには後悔していただきましょう！」"

#. Occurrence B_3:1501:15690: scene=B_3
#: B_3:1501
msgctxt "text_id=15690 | speaker=unknown"
msgid "  She spoke with force, but her words echoed aimlessly around the chapel."
msgstr "　力強く断言するも、もちろん、礼拝堂には律架しかいない。"

#. Occurrence B_3:1515:15691: scene=B_3
#: B_3:1515
msgctxt "text_id=15691 | speaker=unknown"
msgid "  With a sigh, she shrugged her shoulders and made the sign of the cross in a rather unpious manner."
msgstr "　やれやれと肩をすくめながら、律架は不信心に十字を切る。"

#. Occurrence B_3:1535:15692: scene=B_3
#: B_3:1535
msgctxt "text_id=15692 | speaker=unknown"
msgid "  The sound of Soujyuro's footsteps grew fainter."
msgstr "　……遠くなっていく足音。"

#. Occurrence B_3:1562:15693: scene=B_3
#: B_3:1562
msgctxt "text_id=15693 | speaker=unknown"
msgid "  His lack of hesitation had left a pain in her heart."
msgstr "　その<躊躇|ためらい>のなさが、律架には痛ましい。"

#. Occurrence B_3:1567:15694: scene=B_3
#: B_3:1567
msgctxt "text_id=15694 | speaker=unknown"
msgid "  And not because he did not look back at her,"
msgstr "　なぜなら、少年が振り向かないのは迷いがないからではなく。"

#. Occurrence B_3:1572:15695: scene=B_3
#: B_3:1572
msgctxt "text_id=15695 | speaker=unknown"
msgid "  but because he was choosing to ignore the primal fear inside him."
msgstr "　彼本人が意識していない根本的な恐れから、ただ目を逸らしているだけなのだから。"

#. Occurrence B_3:1621:15696: scene=B_3
#: B_3:1621
msgctxt "text_id=15696 | speaker=unknown"
msgid "                                      An elderly man once said..."
msgstr "　　　　　　　　　　　　　　　　　　　老人は語った。"

#. Occurrence B_3:1643:15697: scene=B_3
#: B_3:1643
msgctxt "text_id=15697 | speaker=unknown"
msgid "  \"An animal's death and a human's are two different things."
msgstr "　生き物の死と、人間の死は違うもんだ。"

#. Occurrence B_3:1648:15698: scene=B_3
#: B_3:1648
msgctxt "text_id=15698 | speaker=unknown"
msgid "  You may think they are the same, but they differ to their core."
msgstr "　同じように思えるかもしれないが、もう根本からぜんぜん違う。"

#. Occurrence B_3:1653:15699: scene=B_3
#: B_3:1653
msgctxt "text_id=15699 | speaker=unknown"
msgid "  Our heads have known the difference since the dawn of man."
msgstr "　オレたちの<頭|ココ>は、はじめからそういう<区|・><別|・>をするように出来ている。"

#. Occurrence B_3:1675:15700: scene=B_3
#: B_3:1675
msgctxt "text_id=15700 | speaker=unknown"
msgid "  An animal's corpse-be it a pig's or a deer's-is different."
msgstr "　鹿だの豚だのの<死骸|しがい>と、<同|・><じ|・><生|・><き|・><物|・>の死骸は違う。"

#. Occurrence B_3:1681:15701: scene=B_3
#: B_3:1681
msgctxt "text_id=15701 | speaker=unknown"
msgid "  If the swing of an axe or a machete is violent,"
msgstr "　鉈だの斧だのを振るうのが暴力なら、"

msgctxt "text_id=15702 | speaker=unknown"
msgid "  then so must a human corpse be."
msgstr "　人間の死骸ってのも否応なしの暴力だ。"

#. Occurrence B_3:1688:15703: scene=B_3
#: B_3:1688
msgctxt "text_id=15703 | speaker=unknown"
msgid "  Therefore, before you see one with your own eyes, you should at least understand it with your ears."
msgstr "　なんで、そういうモンに出遭う前に、言葉でだけでも知っておけばいい。"

#. Occurrence B_3:1712:15704: scene=B_3
#: B_3:1712
msgctxt "text_id=15704 | speaker=unknown"
msgid "  Listen closely, Soujyuro."
msgstr "　いいかい草<十|ぼうず>郎。"

#. Occurrence B_3:1717:15705: scene=B_3
#: B_3:1717
msgctxt "text_id=15705 | speaker=unknown"
msgid "  When a person dies, blood flows like a crimson river... It's too much to bear.\""
msgstr "　人が死ぬ時はな、目を背けたくなるぐらい、赤い血が流れていくもんなんだ――――――"

#. Occurrence B_3:1745:15706: scene=B_3
#: B_3:1745
msgctxt "text_id=15706 | speaker=unknown"
msgid "  Perhaps because he was not used to the stone path beneath his feet,"
msgstr "　……慣れない、石造りの通路を歩いたせいか。"

#. Occurrence B_3:1750:15707: scene=B_3
#: B_3:1750
msgctxt "text_id=15707 | speaker=unknown"
msgid "  Soujyuro's mind wandered back to the words he'd heard as a child."
msgstr "　彼は幼い頃に聞いた、他愛のない話を思い出した。"

#. Occurrence B_3:1815:15708: scene=B_3
#: B_3:1815
msgctxt "text_id=15708 | speaker=unknown"
msgid "  The instant he opened the door, there was a palpable change in the air."
msgstr "　ドアを開けた瞬間、異様な、違う空気が流れている事を思い知った。"

#. Occurrence B_3:1820:15709: scene=B_3
#: B_3:1820
msgctxt "text_id=15709 | speaker=unknown"
msgid "  The room was small, with only a simple bed and a small wooden dresser."
msgstr "　部屋は小さな個室で、簡素なベッドと、小さな桐のタンスがあるだけだ。"

#. Occurrence B_3:1825:15710: scene=B_3
#: B_3:1825
msgctxt "text_id=15710 | speaker=unknown"
msgid "  And there on the bed, ____ was lying on her side."
msgstr "　ベッドには　　が横臥している。"

#. Occurrence B_3:1830:15711: scene=B_3
#: B_3:1830
msgctxt "text_id=15711 | speaker=unknown"
msgid "      Tending to her was the woman he'd just seen in the chapel, Ritsuka."
msgstr "　　　を看病しているのは、さっき礼拝堂にいた律架という女性だった。"

#. Occurrence B_3:1891:15712: scene=B_3
#: B_3:1891
msgctxt "text_id=15712 | speaker=unknown"
msgid "  ...No, she only looked a lot like her."
msgstr "　……いや、それは律架によく似た女性にすぎない。"

#. Occurrence B_3:1896:15713: scene=B_3
#: B_3:1896
msgctxt "text_id=15713 | speaker=unknown"
msgid "  Her eyes were closed, and her garments covered in blood."
msgstr "　閉じられた目蓋と、血に濡れている修道服。"

#. Occurrence B_3:1901:15714: scene=B_3
#: B_3:1901
msgctxt "text_id=15714 | speaker=unknown"
msgid "  He had met her maybe once before."
msgstr "　一度なり面識はある。"

#. Occurrence B_3:1906:15715: scene=B_3
#: B_3:1906
msgctxt "text_id=15715 | speaker=unknown"
msgid "  Yuika Suse, a nun at the church."
msgstr "　彼女はこの教会のシスター、<周|す><瀬|せ><唯架|ゆいか>だ。"

#. Occurrence B_3:1928:15716: scene=B_3
#: B_3:1928
msgctxt "text_id=15716 | speaker=unknown"
msgid "  She was doing something to ____."
msgstr "　唯架は横臥している　　に触れている。"

#. Occurrence B_3:1933:15717: scene=B_3
#: B_3:1933
msgctxt "text_id=15717 | speaker=unknown"
msgid "  Yuika held a pair of scissors and some thread."
msgstr "　その手にはハサミと糸。"

#. Occurrence B_3:1938:15718: scene=B_3
#: B_3:1938
msgctxt "text_id=15718 | speaker=unknown"
msgid "  Her hands moved delicately yet quickly, as though playing an organ."
msgstr "　シスターはオルガンを<弾|ひ>く静かさで、たおやかに、しかし<迅速|じんそく>に指を動かす。"

#. Occurrence B_3:1943:15719: scene=B_3
#: B_3:1943
msgctxt "text_id=15719 | speaker=unknown"
msgid "  Her movements were precise, as if flawlessly reading sheet music."
msgstr "　<淀|よど>みのない手順は、そういう楽譜があるかのようだ。"

#. Occurrence B_3:1948:15720: scene=B_3
#: B_3:1948
msgctxt "text_id=15720 | speaker=unknown"
msgid "  One by one, the supply of bandages diminished."
msgstr "　包帯は次から次へと消費される。"

#. Occurrence B_3:1953:15721: scene=B_3
#: B_3:1953
msgctxt "text_id=15721 | speaker=unknown"
msgid "  Bandages recently applied to the wounds were quickly replaced with fresh ones."
msgstr "　さきほどまで使われていた包帯がはがされ、新しい包帯が、<潰|つぶ>れた人体部分を隠していく。"

#. Occurrence B_3:1973:15722: scene=B_3
#: B_3:1973
msgctxt "text_id=15722 | speaker=unknown"
msgid "  Gauze was placed everywhere to try and cope with the amount of blood."
msgstr "　血を拭うガーゼも、いいかげん使いすぎだ。"

#. Occurrence B_3:1980:15723: scene=B_3
#: B_3:1980
msgctxt "text_id=15723 | speaker=unknown"
msgid "  Once white cloth was now dyed red and discarded."
msgstr "　投げ捨てた布の色は白ではなく赤。"

#. Occurrence B_3:1985:15724: scene=B_3
#: B_3:1985
msgctxt "text_id=15724 | speaker=unknown"
msgid "  The dressings scattered around the floor resembled roses."
msgstr "　床に積もった布切れは、汚れた薔薇を思わせる。"

#. Occurrence B_3:1991:15725: scene=B_3
#: B_3:1991
msgctxt "text_id=15725 | speaker=unknown"
msgid "  In a wilted rose garden, the nun played her organ."
msgstr "　腐った薔薇園でオルガンを演奏するシスター。"

#. Occurrence B_3:1997:15726: scene=B_3
#: B_3:1997
msgctxt "text_id=15726 | speaker=unknown"
msgid "  The scene looked unlike any reality Soujyuro knew."
msgstr "　ますます、現実味というものがない。"

#. Occurrence B_3:2017:15727: scene=B_3
#: B_3:2017
msgctxt "text_id=15727 | speaker=unknown"
msgid "  It was clear why the air had changed."
msgstr "　空気が違う理由は明らかだ。"

#. Occurrence B_3:2050:15728: scene=B_3
#: B_3:2050
msgctxt "text_id=15728 | speaker=unknown"
msgid "  There was a savage odor in the room."
msgstr "　この部屋の空気には匂いがついている。"

#. Occurrence B_3:2055:15729: scene=B_3
#: B_3:2055
msgctxt "text_id=15729 | speaker=unknown"
msgid "  Even though he was experiencing it for the first time, he knew what it was. The smell burned his lungs."
msgstr "　初めて体験してもそれだと判ってしまう、胸の焼け付く、重い匂い。"

#. Occurrence B_3:2091:15730: scene=B_3
#: B_3:2091
msgctxt "text_id=15730 | speaker=unknown"
msgid "  He could not bring himself to look at the bed."
msgstr "　彼の視線は、どうにもベッドに定まらない。"

#. Occurrence B_3:2096:15731: scene=B_3
#: B_3:2096
msgctxt "text_id=15731 | speaker=unknown"
msgid "  Fighting his feelings, his eyes refused to move there."
msgstr "　気持ちとは裏腹に、関係のない箇所ばかり見ようとする。"

#. Occurrence B_3:2116:15732: scene=B_3
#: B_3:2116
msgctxt "text_id=15732 | speaker=unknown"
msgid "  He noticed Alice next to the bed."
msgstr "　見れば、有珠はベッドの横に立っていた。"

#. Occurrence B_3:2159:15733: scene=B_3
#: B_3:2159
msgctxt "text_id=15733 | speaker=unknown"
msgid "  Ever expressionless, she looked like a statue next to a grave,"
msgstr "　いつもの無表情な立ち姿が、今は<卒塔婆|そとば>のように見える。"

#. Occurrence B_3:2164:15734: scene=B_3
#: B_3:2164
msgctxt "text_id=15734 | speaker=unknown"
msgid "  except she was trembling ever so slightly."
msgstr "　彼女は<微|かす>かに震えていた。"

#. Occurrence B_3:2169:15735: scene=B_3
#: B_3:2169
msgctxt "text_id=15735 | speaker=unknown"
msgid "  It could have been from fear, anxiety, rage, or a combination of the three."
msgstr "　<怯|おび>えか不安、それとも憎しみによる憤怒かは、どうにも。"

#. Occurrence B_3:2209:15736: scene=B_3
#: B_3:2209
msgctxt "text_id=15736 | speaker=unknown"
msgid "  Before her lay a life on the verge of death."
msgstr "　その視線の先に、死に<瀕|ひん>する生き物が一つ。"

#. Occurrence B_3:2257:15737: scene=B_3
#: B_3:2257
msgctxt "text_id=15737 | speaker=unknown"
msgid "  But whose life? It was difficult to tell with only a glance."
msgstr "　ベッドに横たわるソレが何であるか、一見では頭に入らない。"

#. Occurrence B_3:2262:15738: scene=B_3
#: B_3:2262
msgctxt "text_id=15738 | speaker=unknown"
msgid "  Some sort of puppet covered in bandages, perhaps."
msgstr "　ところどころ包帯に巻かれた人形。"

#. Occurrence B_3:2282:15739: scene=B_3
#: B_3:2282
msgctxt "text_id=15739 | speaker=unknown"
msgid "  Her hair should be beautiful, but it fell flat, disheveled; despite her short breaths, her chest convulsed. Up. Down. Up. Down."
msgstr "　美しかった髪は乱れて、呼吸は短く小さいクセに、胸はせわしなく上下している。"

#. Occurrence B_3:2287:15740: scene=B_3
#: B_3:2287
msgctxt "text_id=15740 | speaker=unknown"
msgid "  Facetious though the thought was, Soujyuro recalled the rodeo machine on the roof of the department store."
msgstr "　どことなく滑稽で、デパートの屋上で見た、ロデオマシーンを彷彿とさせる。"

#. Occurrence B_3:2293:15741: scene=B_3
#: B_3:2293
msgctxt "text_id=15741 | speaker=unknown"
msgid "  Ah."
msgstr "　―――ああ。"

#. Occurrence B_3:2298:15742: scene=B_3
#: B_3:2298
msgctxt "text_id=15742 | speaker=unknown"
msgid "  The painkillers and anesthesia could not have been working."
msgstr "　では、麻酔とか鎮痛剤とか、そういうものは効いていないのか。"

#. Occurrence B_3:2320:15743: scene=B_3
#: B_3:2320
msgctxt "text_id=15743 | speaker=unknown"
msgid "  New bandages were soaked crimson in seconds."
msgstr "　真新しい包帯は秒刻みで朱色に<滲|にじ>んでいく。"

#. Occurrence B_3:2325:15744: scene=B_3
#: B_3:2325
msgctxt "text_id=15744 | speaker=unknown"
msgid "  Her fingernails bit into the sheets."
msgstr "　シーツに食いこむ五指の爪。"

#. Occurrence B_3:2330:15745: scene=B_3
#: B_3:2330
msgctxt "text_id=15745 | speaker=unknown"
msgid "  Her face twisted in agony."
msgstr "　苦しみに歪む顔。"

#. Occurrence B_3:2335:15746: scene=B_3
#: B_3:2335
msgctxt "text_id=15746 | speaker=unknown"
msgid "  Anesthesia would not be enough, so if she was still alive, she must be conscious too."
msgstr "　麻酔は効かず、生きているのなら、意識だってあるだろう。"

#. Occurrence B_3:2340:15747: scene=B_3
#: B_3:2340
msgctxt "text_id=15747 | speaker=unknown"
msgid "  It worried him that no one seemed concerned about this."
msgstr "　誰も不安に思わないのか、と不安になる。"

#. Occurrence B_3:2345:15748: scene=B_3
#: B_3:2345
msgctxt "text_id=15748 | speaker=unknown"
msgid "  In this state, she would surely lose her mind before her life."
msgstr "　あれでは体の傷より、痛みで心が先に死ぬ。"

#. Occurrence B_3:2418:15749: scene=B_3
#: B_3:2418
msgctxt "text_id=15749 | speaker=unknown"
msgid "  In short..."
msgstr "　端的に言って。"

#. Occurrence B_3:2423:15750: scene=B_3
#: B_3:2423
msgctxt "text_id=15750 | speaker=unknown"
msgid "  The boy never wanted to see anything like this ever again."
msgstr "　それは少年にとって、二度と見たくない光景だった。"

#. Occurrence B_3:2492:15751: scene=B_3
#: B_3:2492
msgctxt "text_id=15751 | speaker=unknown"
msgid "  Bedsheets should be white, not red. With every blink, the color deepened."
msgstr "　本来清潔であるべき白いベッドが、またたくまに赤く染まっていく。"

#. Occurrence B_3:2497:15752: scene=B_3
#: B_3:2497
msgctxt "text_id=15752 | speaker=unknown"
msgid "  Soujyuro was finally forced to accept that the bleeding mess in the center of it was... her."
msgstr "　その中心で流血する人形が彼女なのだと認めて、"

#. Occurrence B_3:2502:15753: scene=B_3
#: B_3:2502
msgctxt "text_id=15753 | speaker=unknown"
msgid "  He felt the blood surge in his veins."
msgstr "　体中の血管が膨張する。"

#. Occurrence B_3:2507:15754: scene=B_3
#: B_3:2507
msgctxt "text_id=15754 | speaker=unknown"
msgid "  The squeaking of the bed; the snip of the scissors; the gasps of agony... it all faded."
msgstr "　ベッドの<軋|きし>む音も、ハサミの刃がこすれる音も、彼女の苦悶も<彼岸|ひがん>の話。"

#. Occurrence B_3:2528:15755: scene=B_3
#: B_3:2528
msgctxt "text_id=15755 | speaker=unknown"
msgid "  All he could hear was his own pounding heartbeat."
msgstr "　自分の鼓動だけが<耳朶|じだ>に響く。"

#. Occurrence B_3:2564:15756: scene=B_3
#: B_3:2564
msgctxt "text_id=15756 | speaker=unknown"
msgid "  The smell of the blood she choked up sent a wave of nausea through him."
msgstr "　むせ返る血の匂いに、吐き気がする。"

#. Occurrence B_3:2569:15757: scene=B_3
#: B_3:2569
msgctxt "text_id=15757 | speaker=unknown"
msgid "  His knees abandoned him."
msgstr "　膝から力が失われる感覚。"

#. Occurrence B_3:2618:15758: scene=B_3
#: B_3:2618
msgctxt "text_id=15758 | speaker=unknown"
msgid "  And it was perfectly understandable."
msgstr "　でも、それは仕方のない事だ。"

#. Occurrence B_3:2641:15759: scene=B_3
#: B_3:2641
msgctxt "text_id=15759 | speaker=unknown"
msgid "  His brain had to shut his consciousness off to protect itself."
msgstr "　精神の安全装置が、断りもなく意識を遮断する。"

#. Occurrence B_3:2647:15760: scene=B_3
#: B_3:2647
msgctxt "text_id=15760 | speaker=unknown"
msgid "  The mind could only take so much reality."
msgstr "　自明の理にも程がある。"

#. Occurrence B_3:2653:15761: scene=B_3
#: B_3:2653
msgctxt "text_id=15761 | speaker=unknown"
msgid "  He would give anything to never see something like that again."
msgstr "　―――だってこんなモノ、何を引き替えにしても、彼は二度と見たくはなかったのだ。"

#. Occurrence B_4:58:15762: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_4_0000; voice_prefix=B30; voice_category=9; scene=B_4
#: B_4:58
msgctxt "text_id=15762 | speaker=ritsuka"
msgid "\"...Silly me. You know everything, don't you, Aoko?"
msgstr "“―――そうか。青子ちゃんは全部分かっているんだね。"

#. Occurrence B_4:64:15763: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_4_0001; voice_prefix=B30; voice_category=9; scene=B_4
#: B_4:64
msgctxt "text_id=15763 | speaker=ritsuka"
msgid "  Not just about you,"
msgstr "　自分だけのコトじゃなくて、"

#. Occurrence B_4:70:15764: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_4_0002; voice_prefix=B30; voice_category=9; scene=B_4
#: B_4:70
msgctxt "text_id=15764 | speaker=ritsuka"
msgid "  but what happens after this too; what survives, what won't. You can see it all."
msgstr "　このあとに起きるコトも、なにが残ってなにが残らないのかも、全部まっすぐに受けとめている。"

#. Occurrence B_4:76:15765: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_B_4_0003; voice_prefix=B30; voice_category=9; scene=B_4
#: B_4:76
msgctxt "text_id=15765 | speaker=ritsuka"
msgid "  And through it all, you never lose sight of who you are."
msgstr "　それでも自分であり続けられるという事は、"

msgctxt "text_id=15766 | speaker=unknown"
msgid "  You're so strong.\""
msgstr "　とても強いことなんだよ―――”"

#. Occurrence B_4:118:15767: scene=B_4
#: B_4:118
msgctxt "text_id=15767 | speaker=unknown"
msgid "  And on she went."
msgstr "　などと。"

#. Occurrence B_4:123:15768: scene=B_4
#: B_4:123
msgctxt "text_id=15768 | speaker=unknown"
msgid "  I kind of liked her smile, but she just had to go and say the one thing I wished she hadn't."
msgstr "　その人は、私がわりと好きだった笑顔で、いちばん言ってほしくない事を、誇らしげに口にした。"

#. Occurrence B_4:128:15769: scene=B_4
#: B_4:128
msgctxt "text_id=15769 | speaker=unknown"
msgid "  The last day of middle school seems so long ago."
msgstr "　今では遠い昔のように思える中学の卒業式。"

#. Occurrence B_4:133:15770: scene=B_4
#: B_4:133
msgctxt "text_id=15770 | speaker=unknown"
msgid "  As the ephemeral cherry blossom petals danced around, my little dream was crushed."
msgstr "　早咲きの桜が舞い散る中、私のささやかな夢は、木っ端微塵に砕け散ったのだ。"

#. Occurrence B_4:185:15771: scene=B_4
#: B_4:185
msgctxt "text_id=15771 | speaker=unknown"
msgid "  I'd never really considered myself strong."
msgstr "　だいたい、私は自分が強いなんて思った事はなかった。"

#. Occurrence B_4:190:15772: scene=B_4
#: B_4:190
msgctxt "text_id=15772 | speaker=unknown"
msgid "  At least, until I began remembering those words from time to time."
msgstr "　少なくとも、この言葉を時折思い出すようになるまでは。"

#. Occurrence B_4:197:15773: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_4_0000; voice_prefix=A30; voice_category=3; scene=B_4
#: B_4:197
msgctxt "text_id=15773 | speaker=soujuurou"
msgid "\"I thought you of all people would understand, Aozaki."
msgstr "“蒼崎は分かってると思ってた。"

#. Occurrence B_4:203:15774: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_4_0001; voice_prefix=A30; voice_category=3; scene=B_4
#: B_4:203
msgctxt "text_id=15774 | speaker=soujuurou"
msgid "  I mean, of course you do. That's what makes you strong.\""
msgstr "　いや、きっと分かってるんだな。だから、そこが強いんだろうね”"

#. Occurrence B_4:223:15775: scene=B_4
#: B_4:223
msgctxt "text_id=15775 | speaker=unknown"
msgid "  ...And lately, an idiot who said things like that had appeared in my life."
msgstr "　……なのに最近、そんな<戯|たわ>けたコトを言った奴がいる。"

#. Occurrence B_4:228:15776: scene=B_4
#: B_4:228
msgctxt "text_id=15776 | speaker=unknown"
msgid "  I knew I always judged people more harshly than those around me, but to have someone I'd only known for a few days point that out was like a stab in the chest."
msgstr "　自分の判断基準がまわりとズレている事は知っていたけど、知り合って何日も経たない相手に指摘されたのは、ちょっとしたショックだった。"

#. Occurrence B_4:233:15777: scene=B_4
#: B_4:233
msgctxt "text_id=15777 | speaker=unknown"
msgid "  Not only that, the words sounded so similar, they made me so angry I couldn't see straight."
msgstr "　おまけに台詞までそっくりで、あの時は怒りのあまり我を忘れたほどである。"

#. Occurrence B_4:253:15778: scene=B_4
#: B_4:253
msgctxt "text_id=15778 | speaker=unknown"
msgid "  Only him and one other person have ever said anything like that to me."
msgstr "　……今まで、私に対してそんなことを言ってきたのは彼を含めて二人だけ。"

#. Occurrence B_4:258:15779: scene=B_4
#: B_4:258
msgctxt "text_id=15779 | speaker=unknown"
msgid "  Then again, I suppose my sister said the same without actually saying it."
msgstr "　けど、おそらくは姉貴も無言で言っていたのだ。"

#. Occurrence B_4:264:15780: scene=B_4
#: B_4:264
msgctxt "text_id=15780 | speaker=unknown"
msgid "  \"You're different from us.\""
msgstr "　おまえは、<自分|わたし>たちとは違う。"

#. Occurrence B_4:270:15781: scene=B_4
#: B_4:270
msgctxt "text_id=15781 | speaker=unknown"
msgid "  But me being me, I took it as a curse rather than a compliment."
msgstr "　私にとって、それは賛美の声ではなく、呪いにしか聞こえなかった。"

#. Occurrence B_4:292:15782: scene=B_4
#: B_4:292
msgctxt "text_id=15782 | speaker=unknown"
msgid "  My actions, my choices, my morals... all the good and bad I've done..."
msgstr "　自分の一挙一動、意志選択、善悪基準から<迫害|はくがい><博愛|はくあい>。"

#. Occurrence B_4:297:15783: scene=B_4
#: B_4:297
msgctxt "text_id=15783 | speaker=unknown"
msgid "  When all's said and done, am I really any better than everyone else?"
msgstr "　そのすべてを承知した上で、まだ自分が<大事|いちばん>なのか。"

#. Occurrence B_4:302:15784: scene=B_4
#: B_4:302
msgctxt "text_id=15784 | speaker=unknown"
msgid "  Of course I am. I'll never sacrifice myself for those around me."
msgstr "　もちろんだ。周りの為に自分を犠牲にするのなんて、どうあっても選べない。"

#. Occurrence B_4:307:15785: scene=B_4
#: B_4:307
msgctxt "text_id=15785 | speaker=unknown"
msgid "  They just had to call me strong-true to myself, in spite of how alone, stubborn, and ridiculous I know I can be."
msgstr "　その<孤|こだわ>り、その道化ぶりを分かっていながら、自分であり続けられる事を、彼らは強いといった。"

#. Occurrence B_4:327:15786: scene=B_4
#: B_4:327
msgctxt "text_id=15786 | speaker=unknown"
msgid "  When I was younger, it only confused me."
msgstr "　幼い私は首をかしげるしかない。"

#. Occurrence B_4:332:15787: scene=B_4
#: B_4:332
msgctxt "text_id=15787 | speaker=unknown"
msgid "  I mean, I don't know any other way; I am who I am."
msgstr "　だって、私は違うやり方を見いだせないだけだ。"

#. Occurrence B_4:337:15788: scene=B_4
#: B_4:337
msgctxt "text_id=15788 | speaker=unknown"
msgid "  The frustrating fact is, I simply don't have the courage to give up."
msgstr "　悔しいぐらい、『ただ諦める』勇気を持てないだけ。"

#. Occurrence B_4:343:15789: scene=B_4
#: B_4:343
msgctxt "text_id=15789 | speaker=unknown"
msgid "  So why...?"
msgstr "　なのにどうして―――"

#. Occurrence B_4:348:15790: scene=B_4
#: B_4:348
msgctxt "text_id=15790 | speaker=unknown"
msgid "  Why do I get treated special for doing what comes naturally?"
msgstr "　そんな当たり前の事が、特別扱いされるんだろう―――？"

#. Occurrence B_4:393:15791: scene=B_4
#: B_4:393
msgctxt "text_id=15791 | speaker=unknown"
msgid "  ...The sunlight stirred her."
msgstr "　……朝の光で目を覚ます。"

#. Occurrence B_4:398:15792: scene=B_4
#: B_4:398
msgctxt "text_id=15792 | speaker=unknown"
msgid "  Maybe it was the pain from having her whole body held together by arcane threads,"
msgstr "　全身を霊糸で<縫|ぬ>った痛みのせいか。"

#. Occurrence B_4:403:15793: scene=B_4
#: B_4:403
msgctxt "text_id=15793 | speaker=unknown"
msgid "  but Aoko felt like she'd had a silly dream."
msgstr "　他愛のない夢を、見たようだ。"

#. Occurrence B_4:434:15794: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_4_0000; voice_prefix=A10; voice_category=1; scene=B_4
#: B_4:434
msgctxt "text_id=15794 | speaker=aoko"
msgid "\"...Ah...\""
msgstr "「―――、ぁ―――」"

#. Occurrence B_4:440:15795: scene=B_4
#: B_4:440
msgctxt "text_id=15795 | speaker=unknown"
msgid "  She gulped air through her painful, parched throat."
msgstr "　ガラガラに渇いて傷ついた喉が、大きく深呼吸をする。"

#. Occurrence B_4:445:15796: scene=B_4
#: B_4:445
msgctxt "text_id=15796 | speaker=unknown"
msgid "  Gray rays of light shone through a small window, bringing her back to reality."
msgstr "　小さな窓から差しこむ灰色の日射しは、彼女の意識をゆっくりと覚醒させた。"

#. Occurrence B_4:466:15797: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_4_0001; voice_prefix=A10; voice_category=1; scene=B_4
#: B_4:466
msgctxt "text_id=15797 | speaker=aoko"
msgid "\"Ugh... I feel... itchy.\""
msgstr "「うわ、体中、かゆ……」"

#. Occurrence B_4:473:15798: scene=B_4
#: B_4:473
msgctxt "text_id=15798 | speaker=unknown"
msgid "  Unable to bear it, Aoko attempted to roll over."
msgstr "　耐えきれず寝返りをうってみる。"

#. Occurrence B_4:478:15799: scene=B_4
#: B_4:478
msgctxt "text_id=15799 | speaker=unknown"
msgid "  Except, she could only move her right arm."
msgstr "　が、動かせたのは右腕だけ。"

#. Occurrence B_4:483:15800: scene=B_4
#: B_4:483
msgctxt "text_id=15800 | speaker=unknown"
msgid "  She tried lifting her arm, but couldn't feel anything past her elbow."
msgstr "　肘から先を持ち上げてみても、嘘のように感覚がない。"

#. Occurrence B_4:489:15801: scene=B_4
#: B_4:489
msgctxt "text_id=15801 | speaker=unknown"
msgid "  Once she stopped concentrating on her bandaged arm,"
msgstr "　腕に向けた集中をそらすと、"

msgctxt "text_id=15802 | speaker=unknown"
msgid " it fell to the bed like a stone."
msgstr "包帯だらけの腕はぱたん、と力なくベッドに落ちた。"

#. Occurrence B_4:512:15803: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_4_0002; voice_prefix=A10; voice_category=1; scene=B_4
#: B_4:512
msgctxt "text_id=15803 | speaker=aoko"
msgid "\"...Okay.\""
msgstr "「――――――さて」"

#. Occurrence B_4:532:15804: scene=B_4
#: B_4:532
msgctxt "text_id=15804 | speaker=unknown"
msgid "  Aoko took in her surroundings, moving only her eyes."
msgstr "　青子は視線だけで状況を確認する。"

#. Occurrence B_4:552:15805: scene=B_4
#: B_4:552
msgctxt "text_id=15805 | speaker=unknown"
msgid "  Evidently, she had been asleep in this bed."
msgstr "　……自分はベッドに眠っていたらしい。"

#. Occurrence B_4:557:15806: scene=B_4
#: B_4:557
msgctxt "text_id=15806 | speaker=unknown"
msgid "  Unable to feel certain parts of her body, she felt like a robot."
msgstr "　体のあちこちの感覚がなくて、ロボットか何かになった気がする。"

#. Occurrence B_4:562:15807: scene=B_4
#: B_4:562
msgctxt "text_id=15807 | speaker=unknown"
msgid "  The room was tiny and undecorated."
msgstr "　部屋は狭くて何の飾り気もない。"

#. Occurrence B_4:584:15808: scene=B_4
#: B_4:584
msgctxt "text_id=15808 | speaker=unknown"
msgid "  It was like an apartment without a tenant. Judging by the good repair, she guessed that she was in Aida Church."
msgstr "　まるで入居前のマンションだ。手入れは行き届いているところを見て、合田教会の一室だろう、とアタリをつける。"

#. Occurrence B_4:604:15809: scene=B_4
#: B_4:604
msgctxt "text_id=15809 | speaker=unknown"
msgid "  Outside, it seemed closer to noon than morning."
msgstr "　外は朝というより昼に近い。"

#. Occurrence B_4:609:15810: scene=B_4
#: B_4:609
msgctxt "text_id=15810 | speaker=unknown"
msgid "  Clouds filled the sky as usual, dulling the sun's rays."
msgstr "　空は相変わらず曇っていて、日射しは弱々しい。"

#. Occurrence B_4:614:15811: scene=B_4
#: B_4:614
msgctxt "text_id=15811 | speaker=unknown"
msgid "  Idly, she thought that it could be enough to melt the snow outside."
msgstr "　この分では雪解けはもっと先になってしまうだろうな、と取りとめのない事が頭によぎる。"

#. Occurrence B_4:623:15812: scene=B_4
#: B_4:623
msgctxt "text_id=15812 | speaker=unknown"
msgid "  And then finally, she noticed the figure of a girl."
msgstr "　そうして最後に、青子は彼女の姿を認めた。"

#. Occurrence B_4:628:15813: scene=B_4
#: B_4:628
msgctxt "text_id=15813 | speaker=unknown"
msgid "  Next to her bed, Alice Kuonji was sitting in a chair, unmoving."
msgstr "　自分の眠るベッドの横で、椅子に座ったまま動かない久遠寺有珠の姿を。"

#. Occurrence B_4:649:15814: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_4_0003; voice_prefix=A10; voice_category=1; scene=B_4
#: B_4:649
msgctxt "text_id=15814 | speaker=aoko"
msgid "\"...Good morning, Alice.\""
msgstr "「……おはよ、有珠」"

#. Occurrence B_4:655:15815: scene=B_4
#: B_4:655
msgctxt "text_id=15815 | speaker=unknown"
msgid "  She called out to her, all too casually."
msgstr "　やあ、とばかりに青子は有珠に呼びかけた。"

#. Occurrence B_4:660:15816: scene=B_4
#: B_4:660
msgctxt "text_id=15816 | speaker=unknown"
msgid "  It was more difficult to talk than she thought."
msgstr "　口の中がやたら<鈍|にぶ>い。"

#. Occurrence B_4:684:15817: scene=B_4
#: B_4:684
msgctxt "text_id=15817 | speaker=unknown"
msgid "  Alice was her typical stoic self."
msgstr "　有珠はあいかわらずの無表情。"

#. Occurrence B_4:689:15818: scene=B_4
#: B_4:689
msgctxt "text_id=15818 | speaker=unknown"
msgid "  Although Aoko did notice a glimpse of concern in her eyes."
msgstr "　ただ、その瞳に同居人をいたわる<翳|かげ>りがあったのを、青子は見逃さなかった。"

#. Occurrence B_4:725:15819: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_4_0004; voice_prefix=A10; voice_category=1; scene=B_4
#: B_4:725
msgctxt "text_id=15819 | speaker=aoko"
msgid "\"You haven't slept, Alice. I can tell from your poor complexion.\""
msgstr "「寝てないんでしょ。肌が荒れてる」"

#. Occurrence B_4:751:15820: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_4_0000; voice_prefix=A40; voice_category=2; scene=B_4
#: B_4:751
msgctxt "text_id=15820 | speaker=alice"
msgid "\"I tried. But I can't until the substance Touko made me swallow leaves my system."
msgstr "「……努力はしたわ。けど、橙子さんに飲まされた物が解毒されるまで眠れそうにないの。"

#. Occurrence B_4:757:15821: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_4_0001; voice_prefix=A40; voice_category=2; scene=B_4
#: B_4:757
msgctxt "text_id=15821 | speaker=alice"
msgid "  I suppose my lukewarm discomfort is a fart in a windstorm compared to what you're going through.\""
msgstr "　半端な痛みは、こういう時に<生温|なまぬる>いわね」"

#. Occurrence B_4:799:15822: scene=B_4
#: B_4:799
msgctxt "text_id=15822 | speaker=unknown"
msgid "  Alice's uncharacteristically vulgar comment helped Aoko feel a little more like her usual self."
msgstr "　少女らしからぬ相方の台詞を聞いて、青子はますます気持ちを生き返らせた。"

#. Occurrence B_4:804:15823: scene=B_4
#: B_4:804
msgctxt "text_id=15823 | speaker=unknown"
msgid "  She felt reassured having a comrade-in-arms by her side instead of a concerned neighbor."
msgstr "　今は心配してくれる隣人より、ともに戦ってくれる友人の方が心強い。"

#. Occurrence B_4:852:15824: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_4_0005; voice_prefix=A10; voice_category=1; scene=B_4
#: B_4:852
msgctxt "text_id=15824 | speaker=aoko"
msgid "\"So, she got you too."
msgstr "「そ、有珠もやられたの。"

#. Occurrence B_4:858:15825: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_4_0006; voice_prefix=A10; voice_category=1; scene=B_4
#: B_4:858
msgctxt "text_id=15825 | speaker=aoko"
msgid "  ...I can guess how it went, but fill me in on the details.\""
msgstr "　……状況はだいたい予想してるけど、一応、細部を聞かせてくれない？」"

#. Occurrence B_4:863:15826: scene=B_4
#: B_4:863
msgctxt "text_id=15826 | speaker=unknown"
msgid "  Aoko remained horizontal as she spoke with a cool tone."
msgstr "　ベッドに横になったまま、青子は凛とした口調で言う。"

#. Occurrence B_4:903:15827: scene=B_4
#: B_4:903
msgctxt "text_id=15827 | speaker=unknown"
msgid "  Despite Aoko's condition, Alice granted her request."
msgstr "　青子の無茶を、有珠は止めもせず聞き入れた。"

#. Occurrence B_4:908:15828: scene=B_4
#: B_4:908
msgctxt "text_id=15828 | speaker=unknown"
msgid "  After all, they had known each other for two years."
msgstr "　もう二年近い付き合いだ。"

#. Occurrence B_4:913:15829: scene=B_4
#: B_4:913
msgctxt "text_id=15829 | speaker=unknown"
msgid "  Alice knew exactly the kind of anesthesia Aoko Aozaki needed right now."
msgstr "　こういう時、蒼崎青子という少女にとって何が一番の麻酔になるのか、有珠はよく理解していた。"

#. Occurrence B_5:51:15830: scene=B_5
#: B_5:51
msgctxt "text_id=15830 | speaker=unknown"
msgid "  Alice Kuonji's battle with Touko Aozaki ended in the former's victory."
msgstr "　久遠寺有珠と蒼崎橙子の戦いは、有珠の勝利で終わった。"

#. Occurrence B_5:103:15831: scene=B_5
#: B_5:103
msgctxt "text_id=15831 | speaker=unknown"
msgid "  The Thames Troll was a special familiar even among fairy-tale monsters."
msgstr "　橋の巨人は“童話の怪物”の中でも特別な使い魔だ。"

#. Occurrence B_5:108:15832: scene=B_5
#: B_5:108
msgctxt "text_id=15832 | speaker=unknown"
msgid "  While lacking the incredible reality-warping abilities of Flat Snark, its sheer mass, durability, and strength were second to none."
msgstr "　フラットスナークのような大異能はないが、その巨体、強度、出力、どれをとってもトップランクの性能を誇る。"

#. Occurrence B_5:113:15833: scene=B_5
#: B_5:113
msgctxt "text_id=15833 | speaker=unknown"
msgid "  Touko's rune magecraft was rendered completely ineffective by its stone armor."
msgstr "　橙子のルーン魔術では表面の<石膚|せきふ>さえ破壊できまい。"

#. Occurrence B_5:119:15834: scene=B_5
#: B_5:119
msgctxt "text_id=15834 | speaker=unknown"
msgid "  In all fairness to Touko, most mages would not stand a chance against the Bridge Giant."
msgstr "　それは橙子に限った話ではない。現代の魔術師、その大部分は橋の巨人の前に敗れ去るだろう。"

#. Occurrence B_5:139:15835: scene=B_5
#: B_5:139
msgctxt "text_id=15835 | speaker=unknown"
msgid "  The reason lay in the Mystic's body."
msgstr "　身にまとった神秘の違いだ。"

#. Occurrence B_5:144:15836: scene=B_5
#: B_5:144
msgctxt "text_id=15836 | speaker=unknown"
msgid "  As a general law of magecraft, a Mystic will lose to a stronger, older Mystic."
msgstr "　魔術の原則として、神秘はより強い神秘の前に敗北する。"

#. Occurrence B_5:189:15837: scene=B_5
#: B_5:189
msgctxt "text_id=15837 | speaker=unknown"
msgid "  The history of the Bridge Giant dated back well over a thousand years."
msgstr "　橋の巨人が持つ歴史は単体で千年<級|クラス>。"

#. Occurrence B_5:194:15838: scene=B_5
#: B_5:194
msgctxt "text_id=15838 | speaker=unknown"
msgid "  Its origins could be traced to the 1st century when Britannia was conquered by the Romans."
msgstr "　その起源はイギリスがローマの支配下にあった一世紀にまで<遡|さかのぼ>る。"

#. Occurrence B_5:199:15839: scene=B_5
#: B_5:199
msgctxt "text_id=15839 | speaker=unknown"
msgid "  Conversely, despite having roots dating back to the Age of Gods, runes had unfortunately been lost to time."
msgstr "　いかにルーンが神代の技術であったとしても、悲しいかな、歴史の影に埋もれた魔術。"

#. Occurrence B_5:205:15840: scene=B_5
#: B_5:205
msgctxt "text_id=15840 | speaker=unknown"
msgid "Rune magecraft was little more than an attempt to revive and use a dead art."
msgstr "一度死んだモノを、その都度、起こして利用しているにすぎない。"

#. Occurrence B_5:264:15841: scene=B_5
#: B_5:264
msgctxt "text_id=15841 | speaker=unknown"
msgid "  However, monsters from fairy tales, like the troll, were different;"
msgstr "　だが、橋の巨人、童話の怪物たちは違う。"

#. Occurrence B_5:269:15842: scene=B_5
#: B_5:269
msgctxt "text_id=15842 | speaker=unknown"
msgid "  they lived on in the hands of Alice Kuonji."
msgstr "　彼等は今も、久遠寺有珠の手の中で生きている。"

#. Occurrence B_5:274:15843: scene=B_5
#: B_5:274
msgctxt "text_id=15843 | speaker=unknown"
msgid "  The magical world was vast, but one could probably count on one hand the number of magecraft that still functioned after being chanted into existence a millennia ago, as Alice's Ploys did."
msgstr "　千年以上も前に詠唱され、今も機能し続ける魔術は、世界広しと言えど有珠のプロイと他に二つあるかないか。"

#. Occurrence B_5:294:15844: scene=B_5
#: B_5:294
msgctxt "text_id=15844 | speaker=unknown"
msgid "  In contrast, Touko the rune-user was only about two decades old."
msgstr "　一方、ルーン魔術を扱う橙子の年齢は二十年程度。"

#. Occurrence B_5:299:15845: scene=B_5
#: B_5:299
msgctxt "text_id=15845 | speaker=unknown"
msgid "  Carving a rune took only a moment."
msgstr "　ルーンを<刻|きざ>む時間にいたっては一瞬だ。"

#. Occurrence B_5:304:15846: scene=B_5
#: B_5:304
msgctxt "text_id=15846 | speaker=unknown"
msgid "  There was no way a quick spell could defeat the personification of London Bridge in Alice's homeland."
msgstr "　有珠の故郷、その象徴の一つであるロンドン橋の擬人化を敗れる道理がない。"

#. Occurrence B_5:339:15847: scene=B_5
#: B_5:339
msgctxt "text_id=15847 | speaker=unknown"
msgid "  That being said..."
msgstr "　だが。"

#. Occurrence B_5:356:15848: scene=B_5
#: B_5:356
msgctxt "text_id=15848 | speaker=unknown"
msgid "  A beast had appeared that surpassed even those from fairy tales:"
msgstr "　そこに、“童話の怪物”を上回る怪物が現れた。"

#. Occurrence B_5:361:15849: scene=B_5
#: B_5:361
msgctxt "text_id=15849 | speaker=unknown"
msgid "  Beowulf, the Golden Beast."
msgstr "　黄金の獣、ベオウルフ。"

#. Occurrence B_5:366:15850: scene=B_5
#: B_5:366
msgctxt "text_id=15850 | speaker=unknown"
msgid "  It seemed absurd to compare a small and relatively powerless wolf to a towering stone giant."
msgstr "　橋の巨人とは比べるべくもない、小さく非力な狼は、<果敢|かかん>にも天を<覆|おお>う石くれに立ち向かった。"

#. Occurrence B_5:399:15851: scene=B_5
#: B_5:399
msgctxt "text_id=15851 | speaker=unknown"
msgid "  The Thames Troll's attacks were earth-quaking."
msgstr "　大地を揺るがす巨人の一撃。"

#. Occurrence B_5:404:15852: scene=B_5
#: B_5:404
msgctxt "text_id=15852 | speaker=unknown"
msgid "  A direct hit from its 50-ton strikes would smash anything to paste,"
msgstr "　直撃すれば<ぺしゃんこ|ペースト>に、"

#. Occurrence B_5:409:15853: scene=B_5
#: B_5:409
msgctxt "text_id=15853 | speaker=unknown"
msgid "  while a glancing blow would still create mincemeat."
msgstr "　かするだけでも<挽肉|ミンチ>になる50トンの衝撃。"

#. Occurrence B_5:414:15854: scene=B_5
#: B_5:414
msgctxt "text_id=15854 | speaker=unknown"
msgid "  And yet, the beast had attacked head-on and torn right through it."
msgstr "　それを狼は、真っ正面から<食|・><い|・><破|・><っ|・><た|・>。"

#. Occurrence B_5:513:15855: scene=B_5
#: B_5:513
msgctxt "text_id=15855 | speaker=unknown"
msgid "  The wolf's fur bristled,"
msgstr "　毛並みが逆立つ。"

#. Occurrence B_5:518:15856: scene=B_5
#: B_5:518
msgctxt "text_id=15856 | speaker=unknown"
msgid "  and the creature metamorphosed like liquid."
msgstr "　その容姿が、流体のように変貌する。"

#. Occurrence B_5:523:15857: scene=B_5
#: B_5:523
msgctxt "text_id=15857 | speaker=unknown"
msgid "  It was a breathtaking display."
msgstr "　あまりにも<荘厳|そうごん>な立ち振る舞い。"

#. Occurrence B_5:528:15858: scene=B_5
#: B_5:528
msgctxt "text_id=15858 | speaker=unknown"
msgid "  The wolf howled at the moon, as if in joy, and streaked forth like a bolt of golden light."
msgstr "　金狼は歓びを示すように月に吠え、文字通り、金色の光となって<爆|は>ぜ<走|ばし>る。"

#. Occurrence B_5:571:15859: scene=B_5
#: B_5:571
msgctxt "text_id=15859 | speaker=unknown"
msgid "  In an instant, the duel was decided."
msgstr "　はたして、勝負は一撃で終わった。"

#. Occurrence B_5:595:15860: scene=B_5
#: B_5:595
msgctxt "text_id=15860 | speaker=unknown"
msgid "  The radiant spear of a wolf flew straight through the giant's chest and sank its teeth into its heart. The troll exploded."
msgstr "　光の槍と化した獣は巨人の胸板まで飛びかかり、その心臓に牙をたてながら<爆|・><発|・>したのだ。"

#. Occurrence B_5:643:15861: scene=B_5
#: B_5:643
msgctxt "text_id=15861 | speaker=unknown"
msgid "  Chunks of stony muscle rained down."
msgstr "　はじけ飛ぶ石の筋肉。"

#. Occurrence B_5:671:15862: scene=B_5
#: B_5:671
msgctxt "text_id=15862 | speaker=unknown"
msgid "  Luminous fur scattered in the wind."
msgstr "　拡散する光の毛並み。"

#. Occurrence B_5:719:15863: scene=B_5
#: B_5:719
msgctxt "text_id=15863 | speaker=unknown"
msgid "  Two Mystics dispersed without a trace, and returned from whence they came."
msgstr "　二つの神秘は<痕跡|こんせき>なく爆散し、収束した。"

#. Occurrence B_5:725:15864: scene=B_5
#: B_5:725
msgctxt "text_id=15864 | speaker=unknown"
msgid "  The curtain fell on a battle straight out of mythology."
msgstr "　……その、神話の再現のような<終|つい>に。"

#. Occurrence B_5:730:15865: scene=B_5
#: B_5:730
msgctxt "text_id=15865 | speaker=unknown"
msgid "  There among the rubble of the fairy-tale monster..."
msgstr "　土塊となって崩れ落ちた“童話の怪物”の中心に、"

#. Occurrence B_5:806:15866: scene=B_5
#: B_5:806
msgctxt "text_id=15866 | speaker=unknown"
msgid "  was the Golden Wolf, standing like a flame."
msgstr "　燃え上がる炎のような、金狼の姿があった。"

#. Occurrence B_5:866:15867: scene=B_5
#: B_5:866
msgctxt "text_id=15867 | speaker=unknown"
msgid "  What came after could barely be described as a battle;"
msgstr "　その後の出来事は、もはや戦いですらない。"

#. Occurrence B_5:871:15868: scene=B_5
#: B_5:871
msgctxt "text_id=15868 | speaker=unknown"
msgid "  it was more like the slaughter of defeated pawns."
msgstr "　単なる敗残兵の処理だ。"

#. Occurrence B_5:876:15869: scene=B_5
#: B_5:876
msgctxt "text_id=15869 | speaker=unknown"
msgid "  The wolf leapt on Alice, disemboweling her with ease."
msgstr "　金狼は有珠に飛びかかり、たやすく腹を引き裂いた。"

#. Occurrence B_5:881:15870: scene=B_5
#: B_5:881
msgctxt "text_id=15870 | speaker=unknown"
msgid "  Its claws cut through the protective wards on Alice's coat like a hot knife through butter."
msgstr "　有珠のコートに<編|あ>まれた守りの呪文なぞ、金狼にとって蜘蛛の巣と変わらない。"

#. Occurrence B_5:915:15871: scene=B_5
#: B_5:915
msgctxt "text_id=15871 | speaker=unknown"
msgid "  The Golden Wolf-"
msgstr "　金の狼。"

#. Occurrence B_5:920:15872: scene=B_5
#: B_5:920
msgctxt "text_id=15872 | speaker=unknown"
msgid "  this wolf which understood human speech could only be the magical creature known as the werewolf."
msgstr "　人語を解するアレは、<人狼|ウェアウルフ>と呼ばれる魔獣に違いない。"

#. Occurrence B_5:925:15873: scene=B_5
#: B_5:925
msgctxt "text_id=15873 | speaker=unknown"
msgid "  Werewolves were the forest people of western Europe, with origins far more ancient than the fabricated vampire legends of the continent."
msgstr "　捏造され流布された怪物の王、“吸血鬼”より遥かに古い起源を持つ、西欧の“森の人”。"

#. Occurrence B_5:931:15874: scene=B_5
#: B_5:931
msgctxt "text_id=15874 | speaker=unknown"
msgid "  However, none were known to have golden coats."
msgstr "　しかし―――彼らの基準に、黄金の毛並みは存在しない。"

#. Occurrence B_5:961:15875: scene=B_5
#: B_5:961
msgctxt "text_id=15875 | speaker=unknown"
msgid "  It was said that the most elite werewolf bloodlines boasted silver fur."
msgstr "　人狼の社会において、最高位の血統は銀色と言われている。"

#. Occurrence B_5:966:15876: scene=B_5
#: B_5:966
msgctxt "text_id=15876 | speaker=unknown"
msgid "  Silver werewolves were pack leaders, and werewolves of that caliber were considered Phantasmal, rather than merely magical creatures."
msgstr "　銀の人狼は一族の長であり、その階位は魔獣より上、幻獣の域とされる。"

#. Occurrence B_5:971:15877: scene=B_5
#: B_5:971
msgctxt "text_id=15877 | speaker=unknown"
msgid "  But a golden werewolf was superior even to that, and so transcended human knowledge."
msgstr "　それを上回る金色となると、もはや人智の及ぶものではない。"

#. Occurrence B_5:1003:15878: scene=B_5
#: B_5:1003
msgctxt "text_id=15878 | speaker=unknown"
msgid "  Alice Kuonji's Ploys were among the ultimate Mystics to have been created by humankind."
msgstr "　久遠寺有珠の“童話の怪物”は、人の手によって作られた究極の神秘だ。"

#. Occurrence B_5:1008:15879: scene=B_5
#: B_5:1008
msgctxt "text_id=15879 | speaker=unknown"
msgid "  Therefore, the Golden Wolf could only have been a Mystic born of the planet."
msgstr "　だがあの金狼は、星の手によって産み落とされた神秘。"

#. Occurrence B_5:1013:15880: scene=B_5
#: B_5:1013
msgctxt "text_id=15880 | speaker=unknown"
msgid "  When a celestial body has been active for millions, even billions of years, occasionally a miraculous droplet of Creation spills over into our current world."
msgstr "　<生命|ほし>が何千年何万年と活動した末、<希|まれ>にこぼれ落ちる奇跡のような<一滴|ひとしずく>。"

#. Occurrence B_5:1062:15881: scene=B_5
#: B_5:1062
msgctxt "text_id=15881 | speaker=unknown"
msgid "  This Mystic had to be over three thousand years old."
msgstr "　おそらく、身にまとった神秘は三千年以上。"

#. Occurrence B_5:1067:15882: scene=B_5
#: B_5:1067
msgctxt "text_id=15882 | speaker=unknown"
msgid "  A human mage-"
msgstr "　人間の魔術師―――"

#. Occurrence B_5:1072:15883: scene=B_5
#: B_5:1072
msgctxt "text_id=15883 | speaker=unknown"
msgid "  no, any mage living in the current magical paradigm would be helpless against the Golden Wolf. Not even in theory would they stand a chance of defeating it."
msgstr "　いや、現在の魔術基盤に生きる魔術師であるかぎり、あの金狼を倒す魔術は、理論上<編|あ>みだせない。"

#. Occurrence B_5:1078:15884: scene=B_5
#: B_5:1078
msgctxt "text_id=15884 | speaker=unknown"
msgid "  ...Which meant that this werewolf was Aoko and Alice's worst nightmare."
msgstr "　……それは即ち、蒼崎青子と久遠寺有珠にとって、カレが最悪の敵である事を示していた。"

#. Occurrence B_6:53:15885: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0000; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:53
msgctxt "text_id=15885 | speaker=aoko"
msgid "\"...I see."
msgstr "「―――そう。"

#. Occurrence B_6:60:15886: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0001; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:60
msgctxt "text_id=15886 | speaker=aoko"
msgid "If it was too much even for you, Alice, I never would've stood a chance."
msgstr "有珠がお手上げの相手だものね、私がどうにかできる筈もなかったワケだ。"

#. Occurrence B_6:77:15887: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0002; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:77
msgctxt "text_id=15887 | speaker=aoko"
msgid "  ...But that means non-magical attacks should work on it, right?"
msgstr "　……でも、要は魔術でなければいいのよね？"

#. Occurrence B_6:83:15888: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0003; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:83
msgctxt "text_id=15888 | speaker=aoko"
msgid "  Thames is powered by magical energy, but isn't its punch just raw force? One hit and it's game over.\""
msgstr "　テムズの動力は魔力だけど、テムズの<攻撃|パンチ>は純粋な衝撃でしょ？　当たりさえすればペシャンコじゃないの？」"

#. Occurrence B_6:118:15889: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0000; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:118
msgctxt "text_id=15889 | speaker=alice"
msgid "\"It's not that simple, unfortunately."
msgstr "「……残念だけど。"

#. Occurrence B_6:125:15890: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0001; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:125
msgctxt "text_id=15890 | speaker=alice"
msgid "His base form was a wolf, but he can transform to adapt to the situation. He took Thames' punch by turning into a giant ape-like thing."
msgstr "アレ、基本は狼の姿なだけで、状況によってカタチを変えるわ。テムズの腕を受け止めた時は<大猿|おおざる>みたいになっていたし。"

#. Occurrence B_6:136:15891: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0002; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:136
msgctxt "text_id=15891 | speaker=alice"
msgid "  Even if we used a machine gun or a rocket launcher, he could probably transform into something to defend himself.\""
msgstr "　機関銃やロケットで狙っても<躱|かわ>されるか、体の硬い生き物に変化して防ぐんじゃないかしら」"

#. Occurrence B_6:171:15892: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0004; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:171
msgctxt "text_id=15892 | speaker=aoko"
msgid "\"...So he can turn into any living creature."
msgstr "「……地球上の生き物なら、何にでも変われるってコトか。"

#. Occurrence B_6:188:15893: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0005; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:188
msgctxt "text_id=15893 | speaker=aoko"
msgid "  What about his mass? He can't change that, can he?"
msgstr "　でもまあ、質量までは無理かな？"

#. Occurrence B_6:194:15894: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0006; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:194
msgctxt "text_id=15894 | speaker=aoko"
msgid "  Ugh. Why'd he have to be well over six feet tall on top of all his other strengths?"
msgstr "　基本は二メートル大の生物の、いいトコどりってあたりで勘弁してほしいわね。"

#. Occurrence B_6:228:15895: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0007; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:228
msgctxt "text_id=15895 | speaker=aoko"
msgid "  Random question, but what if he could turn into a sea creature? That'd be just awful.\""
msgstr "　ね。すごく関係ないけど、深海の生き物に変わられたら、ちょっと怖いと思わない？」"

#. Occurrence B_6:248:15896: scene=B_6
#: B_6:248
msgctxt "text_id=15896 | speaker=unknown"
msgid "  Aoko narrowed her eyes as she bemoaned this creature's existence."
msgstr "　なんというか視覚的に、とぼやく青子。"

#. Occurrence B_6:266:15897: scene=B_6
#: B_6:266
msgctxt "text_id=15897 | speaker=unknown"
msgid "  The conversation appeared to have revived her fighting spirit. Once again, her eyes were focused and her thoughts clear; Aoko was back to her usual self."
msgstr "　話しているうちに闘志が湧いたのか、<虚|うつ>ろだった思考も、焦点の定まっていなかった瞳も、完全に元の彼女に戻っている。"

#. Occurrence B_6:287:15898: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0008; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:287
msgctxt "text_id=15898 | speaker=aoko"
msgid "\"So what happened next? Were you able to escape?\""
msgstr "「で、その後は？　有珠、うまく逃げられたの？」"

#. Occurrence B_6:313:15899: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0003; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:313
msgctxt "text_id=15899 | speaker=alice"
msgid "\"No. The wolf had its way with me next.\""
msgstr "「……いいえ。わたしもあの狼にやられたわ」"

#. Occurrence B_6:319:15900: scene=B_6
#: B_6:319
msgctxt "text_id=15900 | speaker=unknown"
msgid "  Alice explained how the wolf had pinned her to the ground."
msgstr "　有珠は金狼に押し倒されてからの事を報告した。"

#. Occurrence B_6:324:15901: scene=B_6
#: B_6:324
msgctxt "text_id=15901 | speaker=unknown"
msgid "  Incidentally, she kept the part about Soujyuro rather short."
msgstr "　余談ではあるが、草十郎に関するコトは大幅に短縮されていた。"

#. Occurrence B_6:330:15902: scene=B_6
#: B_6:330
msgctxt "text_id=15902 | speaker=unknown"
msgid "Alice herself was not entirely sure why she felt it necessary to leave most of that information out."
msgstr "彼との出来事を青子に語らなかった理由は、有珠自身、不思議に思うほど不明だった。"

#. Occurrence B_6:362:15903: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0009; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:362
msgctxt "text_id=15903 | speaker=aoko"
msgid "\"Hmm. So Touko came straight to me after fighting you."
msgstr "「ふーん……有珠の相手をした後、休む間もなく私の所に来たワケか。"

#. Occurrence B_6:376:15904: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0010; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:376
msgctxt "text_id=15904 | speaker=aoko"
msgid "  That was your plan, sis-you wanted to end this all yesterday."
msgstr "　初めから昨日で決着をつけるつもりだったんだ、姉貴。"

#. Occurrence B_6:382:15905: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0011; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:382
msgctxt "text_id=15905 | speaker=aoko"
msgid "  It was my mistake for forgetting... We always did have a habit of having the same thought at the same time.\""
msgstr "　……姉妹かな、ここぞって時のタイミングは一緒だったの、忘れてた……」"

#. Occurrence B_6:408:15906: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0012; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:408
msgctxt "text_id=15906 | speaker=aoko"
msgid "\"Once you reveal your hand to the enemy, you have to take them out."
msgstr "「切札は、見せたからには敵を殲滅しなくちゃいけない。"

#. Occurrence B_6:414:15907: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0013; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:414
msgctxt "text_id=15907 | speaker=aoko"
msgid "  She waited until she was down to the last two sigils to reveal herself and divide our strength."
msgstr "　姉貴は支点を残り二つにしておいて、自分の正体を告げて、こっちの戦力を分けさせた。"

#. Occurrence B_6:420:15908: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0014; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:420
msgctxt "text_id=15908 | speaker=aoko"
msgid "  I knew she'd do something like that, but I never imagined she'd have a freakin' werewolf with her.\""
msgstr "　……その時点で奥の手を投入してくるコトは覚悟してたけど、まさか人狼なんてキワモノとはね」"

#. Occurrence B_6:460:15909: scene=B_6
#: B_6:460
msgctxt "text_id=15909 | speaker=unknown"
msgid "  Aoko let out a heavy sigh."
msgstr "　はあ、と重いため息をつく。"

#. Occurrence B_6:465:15910: scene=B_6
#: B_6:465
msgctxt "text_id=15910 | speaker=unknown"
msgid "  Alice nodded slightly in agreement."
msgstr "　そこは有珠も同感らしく、小さく頷いていた。"

#. Occurrence B_6:494:15911: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0015; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:494
msgctxt "text_id=15911 | speaker=aoko"
msgid "\"...Anyway, I can't believe Soujyuro came to your rescue. I know I should be grateful, but he's such an idiot."
msgstr "「……それはそれとして、草十郎が有珠を助けに行くなんてね。感謝しなくちゃいけないんだろうけど、莫迦な真似してくれたわ。"

#. Occurrence B_6:511:15912: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0016; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:511
msgctxt "text_id=15912 | speaker=aoko"
msgid "  If I was in Touko's shoes, I'd be tying up any loose ends."
msgstr "　私が橙子の立場なら、報復の可能性はひとつ残らず排除する。"

#. Occurrence B_6:518:15913: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0017; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:518
msgctxt "text_id=15913 | speaker=aoko"
msgid "After dealing with us, wiping him out should have been a piece of cake.\""
msgstr "私たちがどうにかなった後、猫の手首ひねるみたいに片付けられるわよ、あいつ」"

#. Occurrence B_6:550:15914: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0004; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:550
msgctxt "text_id=15914 | speaker=alice"
msgid "\"Sizuki is under this church's protection now.\""
msgstr "「静希君なら、こちらで保護してもらってるけど」"

#. Occurrence B_6:568:15915: scene=B_6
#: B_6:568
msgctxt "text_id=15915 | speaker=unknown"
msgid "  Aoko's eyes widened."
msgstr "　有珠の言葉に、青子はえっと目を驚かせた。"

#. Occurrence B_6:589:15916: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0018; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:589
msgctxt "text_id=15916 | speaker=aoko"
msgid "\"What? Am I hearing things?"
msgstr "「うわ、どういう風の吹き回し？"

#. Occurrence B_6:606:15917: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0019; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:606
msgctxt "text_id=15917 | speaker=aoko"
msgid "  You actually went out of your way to protect him?\""
msgstr "　有珠があいつの世話を焼くなんて」"

#. Occurrence B_6:612:15918: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0005; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:612
msgctxt "text_id=15918 | speaker=alice"
msgid "\"I was thinking of you. We wouldn't want you getting angry, now, would we?\""
msgstr "「……だって。放っておいたら、青子が怒ると思って」"

#. Occurrence B_6:647:15919: scene=B_6
#: B_6:647
msgctxt "text_id=15919 | speaker=unknown"
msgid "  Alice responded with her eyes closed."
msgstr "　瞳を閉じたまま有珠は答える。"

#. Occurrence B_6:652:15920: scene=B_6
#: B_6:652
msgctxt "text_id=15920 | speaker=unknown"
msgid "  Aoko frowned in silent indignation,"
msgstr "　それに嫌そうな顔をして、青子は口を閉ざした。"

#. Occurrence B_6:657:15921: scene=B_6
#: B_6:657
msgctxt "text_id=15921 | speaker=unknown"
msgid "  as if she wanted to protest where Alice got *that* idea from."
msgstr "　なんでそうなるのよ、と声にならない抗議をするように。"

#. Occurrence B_6:707:15922: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0020; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:707
msgctxt "text_id=15922 | speaker=aoko"
msgid "\"...Well, whatever. He's here now, I assume. But where?\""
msgstr "「……ま、いいけど。それじゃ今ここにいるんだ、草十郎。姿が見えないけど、どうしたの？」"

#. Occurrence B_6:713:15923: scene=B_6
#: B_6:713
msgctxt "text_id=15923 | speaker=unknown"
msgid "  Still unable to move her neck, she looked around as best she could."
msgstr "　まだ首は動かせないのか、青子は視線だけで部屋を見回した。"

#. Occurrence B_6:748:15924: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0006; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:748
msgctxt "text_id=15924 | speaker=alice"
msgid "\"He collapsed, so he's resting in Father Eiri's bedroom.\""
msgstr "「彼なら気分を悪くして倒れたわ。今は詠梨神父の寝室を借りているけど」"

#. Occurrence B_6:787:15925: scene=B_6
#: B_6:787
msgctxt "text_id=15925 | speaker=unknown"
msgid "  Aoko furrowed her brow at \"collapsed.\""
msgstr "　倒れた、という言葉に青子は目を光らせる。"

#. Occurrence B_6:792:15926: scene=B_6
#: B_6:792
msgctxt "text_id=15926 | speaker=unknown"
msgid "  Sure, he was under the church's protection, but had Touko set the wheels in motion for his death?"
msgstr "　では、ここに保護されたのはいいが、それでも橙子の行動が一歩早く、草十郎が始末されたのか―――？"

#. Occurrence B_6:799:15927: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0021; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:799
msgctxt "text_id=15927 | speaker=aoko"
msgid "\"What exactly happened to him?\""
msgstr "「……何があったの、一体……？」"

#. Occurrence B_6:832:15928: scene=B_6
#: B_6:832
msgctxt "text_id=15928 | speaker=unknown"
msgid "  Alice paused for a moment before carefully answering the question."
msgstr "　真剣に問う青子に、有珠はしばし黙ってから、やや気を遣って、"

#. Occurrence B_6:845:15929: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0007; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:845
msgctxt "text_id=15929 | speaker=alice"
msgid "\"Well,"
msgstr "「それが。"

#. Occurrence B_6:852:15930: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0008; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:852
msgctxt "text_id=15930 | speaker=alice"
msgid " when he saw you, he vomited.\""
msgstr "彼、あなたを見て<嘔吐|おうと>したの」"

#. Occurrence B_6:892:15931: scene=B_6
#: B_6:892
msgctxt "text_id=15931 | speaker=unknown"
msgid "  She had decided to be blunt."
msgstr "　きっぱりと、身も<蓋|ふた>もない真実を口にした。"

#. Occurrence B_6:928:15932: scene=B_6
#: B_6:928
msgctxt "text_id=15932 | speaker=unknown"
msgid "  Aoko was taken aback."
msgstr "　青子はちょっと、声もない。"

#. Occurrence B_6:933:15933: scene=B_6
#: B_6:933
msgctxt "text_id=15933 | speaker=unknown"
msgid "  For several seconds, dim sunlight leaked through the window."
msgstr "　窓から差しこむ日射しに照らされること数秒。"

#. Occurrence B_6:938:15934: scene=B_6
#: B_6:938
msgctxt "text_id=15934 | speaker=unknown"
msgid "  Once she had found her voice again, she muttered,"
msgstr "　青子はようやく言語中枢を回復させて呟いた。"

#. Occurrence B_6:969:15935: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0022; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:969
msgctxt "text_id=15935 | speaker=aoko"
msgid "\"...Whatever. That's kind of rude, though.\""
msgstr "「……いいけど。ひどい侮辱よね、それって」"

#. Occurrence B_6:975:15936: scene=B_6
#: B_6:975
msgctxt "text_id=15936 | speaker=unknown"
msgid "  Perhaps amused, or perhaps exhausted from staying up all night, Alice cracked a tiny giggle."
msgstr "　そんな青子の仕草がおかしかったのか、一晩かけての看病の緊張がほぐれたのか、有珠はクスリと小さく笑った。"

#. Occurrence B_6:1001:15937: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0023; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1001
msgctxt "text_id=15937 | speaker=aoko"
msgid "\"Alice! What's so funny?!\""
msgstr "「なによ。そんなにおかしい、有珠？」"

#. Occurrence B_6:1034:15938: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0009; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1034
msgctxt "text_id=15938 | speaker=alice"
msgid "\"Oh, nothing. Sizuki had his reasons, I'm sure. You were in a bad state, Aoko.\""
msgstr "「さあ、どうかしらね。けど、静希君にも言い分はあるでしょう。今の貴女、とても見られたものじゃないわ」"

#. Occurrence B_6:1071:15939: scene=B_6
#: B_6:1071
msgctxt "text_id=15939 | speaker=unknown"
msgid "  Aoko appraised her physical state."
msgstr "　言われて、青子は自分の体を観察した。"

#. Occurrence B_6:1076:15940: scene=B_6
#: B_6:1076
msgctxt "text_id=15940 | speaker=unknown"
msgid "  She was dressed in a hospital gown."
msgstr "　一枚布の患者衣。"

#. Occurrence B_6:1081:15941: scene=B_6
#: B_6:1081
msgctxt "text_id=15941 | speaker=unknown"
msgid "  Bandages covered the majority of her body; her right leg was in a plaster cast."
msgstr "　肌の露出より包帯の方が多いし、右足はギプスがあてられている。"

#. Occurrence B_6:1087:15942: scene=B_6
#: B_6:1087
msgctxt "text_id=15942 | speaker=unknown"
msgid "  Since she could move her right arm, she brought her bandaged fingers up to her throat."
msgstr "　右手は動くので、包帯に巻かれた指で青子は自分の喉元に触れてみた。"

#. Occurrence B_6:1110:15943: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0024; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1110
msgctxt "text_id=15943 | speaker=aoko"
msgid "\"Oh yeah... I remember now. That little shit bit my neck."
msgstr "「そっか……思い出した。あのガキ、まず私の首元に噛み付いたんだっけ。"

#. Occurrence B_6:1116:15944: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0025; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1116
msgctxt "text_id=15944 | speaker=aoko"
msgid "  It was crazy, being torn to pieces like that. I even heard my neck snapping. 'Gross' doesn't do the feeling justice."
msgstr "　すごかったわよ、首が噛み砕かれるのって。ゴキンって音が頭の中に響いて、気持ち悪いったらなかったわ。"

#. Occurrence B_6:1122:15945: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0026; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1122
msgctxt "text_id=15945 | speaker=aoko"
msgid "  ...Dammit. He played with me like some kind of chew toy. I almost wish I could forget.\""
msgstr "　……ちっ。あそこから好き勝手やられたもんだから、つい忘れてた」"

#. Occurrence B_6:1144:15946: scene=B_6
#: B_6:1144
msgctxt "text_id=15946 | speaker=unknown"
msgid "  Aoko sounded upbeat, but the look in her eyes was anything but."
msgstr "　口調は明るいものの、青子の目は明るくはない。"

#. Occurrence B_6:1149:15947: scene=B_6
#: B_6:1149
msgctxt "text_id=15947 | speaker=unknown"
msgid "  She had been torn to pieces, but her life had been \"mercifully\" spared."
msgstr "　……彼女の全身は、ご丁寧に“死なない”程度に壊されていた。"

#. Occurrence B_6:1154:15948: scene=B_6
#: B_6:1154
msgctxt "text_id=15948 | speaker=unknown"
msgid "  At least she hadn't been dismembered."
msgstr "　切断面は一切ない。"

#. Occurrence B_6:1159:15949: scene=B_6
#: B_6:1159
msgctxt "text_id=15949 | speaker=unknown"
msgid "  She had been bitten, beaten, and her bones broken."
msgstr "　基本的には噛みつかれてからの打撲、骨折だ。"

#. Occurrence B_6:1179:15950: scene=B_6
#: B_6:1179
msgctxt "text_id=15950 | speaker=unknown"
msgid "  Magic Crests containing the Aozakis' secret arts decorated her body."
msgstr "　青子の体には蒼崎の秘術がつまった魔術刻印がある。"

#. Occurrence B_6:1184:15951: scene=B_6
#: B_6:1184
msgctxt "text_id=15951 | speaker=unknown"
msgid "  Even if her spine was broken, as long as her body was alive, the crests would piece it back together."
msgstr "　仮に<脊椎|せきつい>を折られようが、青子自身がまだ生きているのなら、刻印が無理矢理にでも青子を生かす。"

#. Occurrence B_6:1189:15952: scene=B_6
#: B_6:1189
msgctxt "text_id=15952 | speaker=unknown"
msgid "  Despite the crests easing the pain a little, she still hurt enough to want to kill that wolf a hundred times over."
msgstr "　……少しは刻印からの麻酔が働いたにせよ、この痛みの恨みは金狼を百回殺しても余りある。"

#. Occurrence B_6:1236:15953: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0027; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1236
msgctxt "text_id=15953 | speaker=aoko"
msgid "\"...If all sigils have been broken,"
msgstr "「……支点は全部壊された。"

#. Occurrence B_6:1242:15954: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0028; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1242
msgctxt "text_id=15954 | speaker=aoko"
msgid "  Misaki City's leylines are wide open."
msgstr "　これで三咲市の霊脈はフリーってワケね。"

#. Occurrence B_6:1248:15955: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0029; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1248
msgctxt "text_id=15955 | speaker=aoko"
msgid "  We thought we had the edge of having the big picture of the area, but if Touko's known for awhile, then she's a step ahead of us."
msgstr "　全容を把握してるのはうちらだけの特権だったけど、橙子は昔から知ってる以上、解析の手間もいらない、と。"

#. Occurrence B_6:1281:15956: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0030; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1281
msgctxt "text_id=15956 | speaker=aoko"
msgid "  Let's be real. How long do you think it'll take her to transfer dominion rights?\""
msgstr "　―――真剣な話、所有権の書き換えまで何時間かかると思う？」"

#. Occurrence B_6:1316:15957: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0010; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1316
msgctxt "text_id=15957 | speaker=alice"
msgid "\"For Touko, it won't even take her two days."
msgstr "「橙子さんなら二日かからないでしょうね。"

#. Occurrence B_6:1322:15958: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0011; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1322
msgctxt "text_id=15958 | speaker=alice"
msgid "  She has no choice but to wait for the land itself to restore the sigils."
msgstr "　支点の修復は土地そのものに任せるしかない。"

#. Occurrence B_6:1333:15959: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0012; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1333
msgctxt "text_id=15959 | speaker=alice"
msgid "  By the time the defenses are in working order again, this town will be as good as hers.\""
msgstr "　支点の<防護陣|プロテクト>が治る頃には、この町はもう彼女の物よ」"

#. Occurrence B_6:1366:15960: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0031; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1366
msgctxt "text_id=15960 | speaker=aoko"
msgid "\"So come tomorrow morning, I lose everything."
msgstr "「明日の夜明けと共に破産する我が身とはねぇ。"

#. Occurrence B_6:1377:15961: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0032; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1377
msgctxt "text_id=15961 | speaker=aoko"
msgid "  What about you, Alice? Any fight left in you?\""
msgstr "　それで有珠の方はどうなの？　まだいける？」"

#. Occurrence B_6:1396:15962: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0013; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1396
msgctxt "text_id=15962 | speaker=alice"
msgid "\"I can manage a little bit of mental magecraft."
msgstr "「思考魔術だけなら、少しは。"

#. Occurrence B_6:1402:15963: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0014; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1402
msgctxt "text_id=15963 | speaker=alice"
msgid "  After that, I'd be relying on trinkets.\""
msgstr "　あとは小道具に頼る事になるでしょうね」"

#. Occurrence B_6:1438:15964: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0033; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1438
msgctxt "text_id=15964 | speaker=aoko"
msgid "\"...Hah. That won't cut it.\""
msgstr "「……はあ。お話にならない、か」"

#. Occurrence B_6:1481:15965: scene=B_6
#: B_6:1481
msgctxt "text_id=15965 | speaker=unknown"
msgid "  Aoko went silent again,"
msgstr "　言って、青子は口を閉ざした。"

#. Occurrence B_6:1486:15966: scene=B_6
#: B_6:1486
msgctxt "text_id=15966 | speaker=unknown"
msgid "  staring straight at the ceiling."
msgstr "　瞳はまっすぐに天井を睨んでいる。"

#. Occurrence B_6:1491:15967: scene=B_6
#: B_6:1491
msgctxt "text_id=15967 | speaker=unknown"
msgid "  Alice knew all too well what that look meant."
msgstr "　そこにどんな決意がこめられているのか、有珠はよく分かっていた。"

#. Occurrence B_6:1512:15968: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0015; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1512
msgctxt "text_id=15968 | speaker=alice"
msgid "\"You're still planning on fighting, aren't you, Aoko?\""
msgstr "「それでもやるんでしょう、青子は」"

#. Occurrence B_6:1518:15969: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0034; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1518
msgctxt "text_id=15969 | speaker=aoko"
msgid "\"Can you blame me? It's not like I can give up."
msgstr "「まあね。私、<諦|あきら>めるのってできないから。"

#. Occurrence B_6:1524:15970: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0035; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1524
msgctxt "text_id=15970 | speaker=aoko"
msgid "  ...What about you?\""
msgstr "　……で、そういう有珠はどうなのよ」"

#. Occurrence B_6:1530:15971: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0016; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1530
msgctxt "text_id=15971 | speaker=alice"
msgid "\"Once something is mine, it stays mine.\""
msgstr "「わたしは、一度自分の物になった物は、決して人には渡さない」"

#. Occurrence B_6:1563:15972: scene=B_6
#: B_6:1563
msgctxt "text_id=15972 | speaker=unknown"
msgid "  Aoko muttered in agreement to Alice's terse response."
msgstr "　短い返答に、青子はそうだった、と呟く。"

#. Occurrence B_6:1568:15973: scene=B_6
#: B_6:1568
msgctxt "text_id=15973 | speaker=unknown"
msgid "  Alice's intense attachment to her possessions was enough to make even Aoko shiver."
msgstr "　有珠の、自分の物に対する執着心は青子でさえ薄ら寒くなるほどなのだ。"

#. Occurrence B_6:1588:15974: scene=B_6
#: B_6:1588
msgctxt "text_id=15974 | speaker=unknown"
msgid "  \"Once something is mine, it stays mine.\" To take it step further, betrayal was an unforgivable sin. This personal motto was further proof of her uncompromising nature."
msgstr "　自分の物になったモノは手放さない―――それは転じて、裏切りは決して許さない、少女の潔癖さの証でもある。"

#. Occurrence B_6:1609:15975: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0036; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1609
msgctxt "text_id=15975 | speaker=aoko"
msgid "\"Okay. That settles it then."
msgstr "「オッケー、決まりね。"

#. Occurrence B_6:1628:15976: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0037; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1628
msgctxt "text_id=15976 | speaker=aoko"
msgid "  I'm going to get some rest. Come hell or high water, I'll be ready by tonight.\""
msgstr "　じゃ、悪いけどもう少し休ませて。今晩までにはなんとか動けるようにするから」"

#. Occurrence B_6:1648:15977: scene=B_6
#: B_6:1648
msgctxt "text_id=15977 | speaker=unknown"
msgid "  If the nun who stitched her back together had heard that, she would have fainted."
msgstr "　手術を担当したシスターが聞けば、その無謀さに卒倒するだろう。"

#. Occurrence B_6:1653:15978: scene=B_6
#: B_6:1653
msgctxt "text_id=15978 | speaker=unknown"
msgid "  Aoko could barely even eat in her current condition."
msgstr "　今の青子は食事すら満足にできない。"

#. Occurrence B_6:1660:15979: scene=B_6
#: B_6:1660
msgctxt "text_id=15979 | speaker=unknown"
msgid "Even so,"
msgstr "それを承知していながら、"

msgctxt "text_id=15980 | speaker=unknown"
msgid " Alice nodded and stood up."
msgstr "有珠は頷いて立ち上がった。"

#. Occurrence B_6:1676:15981: scene=B_6
#: B_6:1676
msgctxt "text_id=15981 | speaker=unknown"
msgid "  As Aoko's partner, she knew that once her mind was made up, she had to trust her."
msgstr "　青子がそう言うのなら、相棒として、有珠は彼女を信じるだけである。"

#. Occurrence B_6:1696:15982: scene=B_6
#: B_6:1696
msgctxt "text_id=15982 | speaker=unknown"
msgid "  Silently, the girl in black began to take her leave."
msgstr "　黒衣の少女は無言で病室を後にする。"

#. Occurrence B_6:1703:15983: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0017; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1703
msgctxt "text_id=15983 | speaker=alice"
msgid "\"Oh.\""
msgstr "「あ」"

#. Occurrence B_6:1709:15984: scene=B_6
#: B_6:1709
msgctxt "text_id=15984 | speaker=unknown"
msgid "  She stopped in front of the door, her hand to her mouth."
msgstr "　と。ドアの前で、片手を自分の口元に当てて、唐突に立ち止まった。"

#. Occurrence B_6:1740:15985: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0038; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1740
msgctxt "text_id=15985 | speaker=aoko"
msgid "\"Alice?\""
msgstr "「有珠？」"

#. Occurrence B_6:1745:15986: scene=B_6
#: B_6:1745
msgctxt "text_id=15986 | speaker=unknown"
msgid "  Aoko was curious, suspecting that Alice had something silly to say again."
msgstr "　また何かどうでもいいコトを思いついたな、と青子は面白がって呼びかける。"

#. Occurrence B_6:1750:15987: scene=B_6
#: B_6:1750
msgctxt "text_id=15987 | speaker=unknown"
msgid "  Quite the contrary."
msgstr "　けれど。"

#. Occurrence B_6:1755:15988: scene=B_6
#: B_6:1755
msgctxt "text_id=15988 | speaker=unknown"
msgid "  Instead of blushing, Alice furrowed her brow, like she was thinking over a difficult riddle."
msgstr "　恥ずかしげに頬を染めるはずの有珠は、深い謎に突き当たったように眉をひそめていた。"

#. Occurrence B_6:1793:15989: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0039; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1793
msgctxt "text_id=15989 | speaker=aoko"
msgid "\"Alice...? Hello...?\" "
msgstr "「有珠ー？」"

#. Occurrence B_6:1798:15990: scene=B_6
#: B_6:1798
msgctxt "text_id=15990 | speaker=unknown"
msgid "  Aoko called out,"
msgstr "　もしもーし、と青子は呼びかける。"

#. Occurrence B_6:1803:15991: scene=B_6
#: B_6:1803
msgctxt "text_id=15991 | speaker=unknown"
msgid "  but Alice remained with her back to her roommate."
msgstr "　有珠は振り向かず、扉に向いたまま、"

#. Occurrence B_6:1816:15992: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0018; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1816
msgctxt "text_id=15992 | speaker=alice"
msgid "\"How did he make it to me in time...?\""
msgstr "「―――なんで、間に合ったのかしら」"

#. Occurrence B_6:1821:15993: scene=B_6
#: B_6:1821
msgctxt "text_id=15993 | speaker=unknown"
msgid "  She spoke as if the words had accidentally burst out from her thoughts."
msgstr "　そんな、自問めいた声を漏らしていた。"

#. Occurrence B_6:1845:15994: scene=B_6
#: B_6:1845
msgctxt "text_id=15994 | speaker=unknown"
msgid "  Alice's question was about something Aoko could not possibly have guessed."
msgstr "　有珠の疑問は青子の知らないところでの出来事なので、当然、青子に分かるはずもない。"

#. Occurrence B_6:1873:15995: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0019; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1873
msgctxt "text_id=15995 | speaker=alice"
msgid "\"...It happened before, too."
msgstr "「……あの時もそう。"

#. Occurrence B_6:1879:15996: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0020; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1879
msgctxt "text_id=15996 | speaker=alice"
msgid "  Even though we took the first train back...\""
msgstr "　わたしたち、始発で帰ってきたのに」"

#. Occurrence B_6:1885:15997: scene=B_6
#: B_6:1885
msgctxt "text_id=15997 | speaker=unknown"
msgid "  She carried on mumbling at the door."
msgstr "　ぶつぶつとドアに向かって語りかける。"

#. Occurrence B_6:1902:15998: scene=B_6
#: B_6:1902
msgctxt "text_id=15998 | speaker=unknown"
msgid "  Unable to find an answer, Alice gloomily put her hand on the doorknob."
msgstr "　……結局答えは出なかったのか、有珠は物憂げに、ドアノブに手をかけた。"

#. Occurrence B_6:1936:15999: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0040; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1936
msgctxt "text_id=15999 | speaker=aoko"
msgid "\"If you don't want to say, it's fine,"
msgstr "「……言いたくないなら別にいいけど。"

#. Occurrence B_6:1942:16000: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0041; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:1942
msgctxt "text_id=16000 | speaker=aoko"
msgid "  but if you do, then spit it out already.\""
msgstr "　何がどうしたって言うのよ、有珠」"

#. Occurrence B_6:1948:16001: scene=B_6
#: B_6:1948
msgctxt "text_id=16001 | speaker=unknown"
msgid "  Alice did not respond."
msgstr "　背中越しの問いに、有珠は答えない。"

#. Occurrence B_6:1954:16002: scene=B_6
#: B_6:1954
msgctxt "text_id=16002 | speaker=unknown"
msgid "  She opened the door to leave the room, and left a few words hanging in the air:"
msgstr "　有珠はドアを開けて部屋から出ると、去り際に一言だけ青子に告げた。"

#. Occurrence B_6:1989:16003: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0021; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1989
msgctxt "text_id=16003 | speaker=alice"
msgid "\"...It might be nothing."
msgstr "「……どうでもいいコトだけど。"

#. Occurrence B_6:1996:16004: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_B_6_0022; voice_prefix=A40; voice_category=2; scene=B_6
#: B_6:1996
msgctxt "text_id=16004 | speaker=alice"
msgid "By the way, Yuika said she couldn't see Sizuki.\""
msgstr "唯架さんには静希君は見えなかったそうよ、青子」"

#. Occurrence B_6:2017:16005: scene=B_6
#: B_6:2017
msgctxt "text_id=16005 | speaker=unknown"
msgid "  The door closed with a thud."
msgstr "　ばたん、とドアは閉められた。"

#. Occurrence B_6:2057:16006: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_6_0042; voice_prefix=A10; voice_category=1; scene=B_6
#: B_6:2057
msgctxt "text_id=16006 | speaker=aoko"
msgid "\"Huh. That doesn't happen every day.\""
msgstr "「ふーん。そりゃまた珍しい」"

#. Occurrence B_6:2063:16007: scene=B_6
#: B_6:2063
msgctxt "text_id=16007 | speaker=unknown"
msgid "  Aoko mumbled to herself from her bed, seeming slightly happier."
msgstr "　青子は横になったまま、やや嬉しげに呟いた。"

#. Occurrence B_6:2092:16008: scene=B_6
#: B_6:2092
msgctxt "text_id=16008 | speaker=unknown"
msgid "  Blind since birth, Yuika Suse saw the world through her other senses."
msgstr "　先天的に盲目だった<周|す><瀬|せ><唯架|ゆいか>は、感覚で物事をとらえる。"

#. Occurrence B_6:2097:16009: scene=B_6
#: B_6:2097
msgctxt "text_id=16009 | speaker=unknown"
msgid "  She was especially sensitive to enemies, or those who bore ill will,"
msgstr "　特に外敵、悪意のある者には敏感だ。"

#. Occurrence B_6:2102:16010: scene=B_6
#: B_6:2102
msgctxt "text_id=16010 | speaker=unknown"
msgid "  and typically viewed almost everyone as a threat-"
msgstr "　基本、彼女はあらゆる人間を“脅威”として知覚する。"

#. Occurrence B_6:2107:16011: scene=B_6
#: B_6:2107
msgctxt "text_id=16011 | speaker=unknown"
msgid "  presumably because that was the easiest thing to pick up on."
msgstr "　それがもっとも感じやすい気配なのだそうだ。"

#. Occurrence B_6:2112:16012: scene=B_6
#: B_6:2112
msgctxt "text_id=16012 | speaker=unknown"
msgid "  So when she said she \"couldn't see Soujyuro,\" that meant he was completely harmless."
msgstr "　そんな彼女に見えなかったという事は、草十郎は底抜けに害のない人間だと、太鼓判を<捺|お>されたようなものだった。"

#. Occurrence B_7:53:16013: scene=B_7
#: B_7:53
msgctxt "text_id=16013 | speaker=unknown"
msgid "  And then..."
msgstr "　で。"

#. Occurrence B_7:67:16014: scene=B_7
#: B_7:67
msgctxt "text_id=16014 | speaker=unknown"
msgid "  That harmless individual decided to pay the small sickroom a visit."
msgstr "　その害のない<某|なにがし>は、しばらくしてから病室にやってきた。"

#. Occurrence B_7:73:16015: scene=B_7
#: B_7:73
msgctxt "text_id=16015 | speaker=unknown"
msgid "  Soujyuro looked like a stiff breeze could knock him over. It made Aoko wonder who the real patient was."
msgstr "　貧血一歩手前の、まったく元気のない草十郎の顔にどっちが病人なんだか、と青子は内心呟いてみる。"

#. Occurrence B_7:94:16016: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0000; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:94
msgctxt "text_id=16016 | speaker=aoko"
msgid "\"What do you want?\""
msgstr "「何しにきたの、アンタ」"

#. Occurrence B_7:125:16017: scene=B_7
#: B_7:125
msgctxt "text_id=16017 | speaker=unknown"
msgid "  Though Aoko could barely move, she was still able to give him the cold shoulder."
msgstr "　青子はベッドに横になったまま、来訪者を突き放した。"

#. Occurrence B_7:130:16018: scene=B_7
#: B_7:130
msgctxt "text_id=16018 | speaker=unknown"
msgid "  His expression gaunt, Soujyuro grunted something or other, before beginning to speak more coherently."
msgstr "　草十郎は弱り切った顔のまま、うん、などと意味不明の返答をする。"

#. Occurrence B_7:161:16019: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0000; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:161
msgctxt "text_id=16019 | speaker=soujuurou"
msgid "\"Alice was sleeping in the guest room, and I was in the chapel. People started coming in, so I came here.\""
msgstr "「有珠が客間で眠ったから礼拝堂にいたんだけど。人が集まりだしたんで、こっちに逃げてきた」"

#. Occurrence B_7:167:16020: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0001; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:167
msgctxt "text_id=16020 | speaker=aoko"
msgid "\"Ah, must be time to worship. It is Christmas.\""
msgstr "「あ、礼拝の時間か……クリスマスだってのによくやるわ」"

#. Occurrence B_7:199:16021: scene=B_7
#: B_7:199
msgctxt "text_id=16021 | speaker=unknown"
msgid "  It was indeed Christmas, but regular mass was on Christmas Eve."
msgstr "　今日はクリスマスだが、ミサのピークは２４日までだ。"

#. Occurrence B_7:204:16022: scene=B_7
#: B_7:204
msgctxt "text_id=16022 | speaker=unknown"
msgid "  The ones gathering in the chapel must have been truly devout followers."
msgstr "　礼拝堂に集まっている人々はよほど信心深いのだろう。"

#. Occurrence B_7:209:16023: scene=B_7
#: B_7:209
msgctxt "text_id=16023 | speaker=unknown"
msgid "  Tourists were rare in Misaki, after all."
msgstr "　三咲町に住む外国人は少ない。"

#. Occurrence B_7:214:16024: scene=B_7
#: B_7:214
msgctxt "text_id=16024 | speaker=unknown"
msgid "  So much so that almost no one visited the area this time of year. The worshippers must have been locals."
msgstr "　いや、いないとさえ言っていい。礼拝堂に集まった人々は、ここ周辺の住人だ。"

#. Occurrence B_7:246:16025: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0002; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:246
msgctxt "text_id=16025 | speaker=aoko"
msgid "\"So? Why do you care? There might be someone there you know.\""
msgstr "「それで？　別にどうってコトないでしょ。探せば顔見知りもいるんじゃない？」"

#. Occurrence B_7:254:16026: scene=B_7
#: B_7:254
msgctxt "text_id=16026 | speaker=unknown"
msgid "  Aoko was as distant as ever."
msgstr "　それでも、なお冷たく青子は突っぱねる。"

#. Occurrence B_7:259:16027: scene=B_7
#: B_7:259
msgctxt "text_id=16027 | speaker=unknown"
msgid "  She clearly had not forgotten the fact he had vomited when he saw her, and a hint of spite leaked into her voice."
msgstr "　先ほど有珠から聞いた『自分を見て吐いた』という事実は、いろんな意味で青子を意地悪にさせているようだ。"

#. Occurrence B_7:279:16028: scene=B_7
#: B_7:279
msgctxt "text_id=16028 | speaker=unknown"
msgid "  Then again..."
msgstr "　もっとも、"

#. Occurrence B_7:304:16029: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0001; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:304
msgctxt "text_id=16029 | speaker=soujuurou"
msgid "\"It's not that. I just thought it might be a good chance to ask you some things."
msgstr "「いや、ちょうどいい機会だから色々と聞きたくなって。"

#. Occurrence B_7:311:16030: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0002; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:311
msgctxt "text_id=16030 | speaker=soujuurou"
msgid "Can we talk for a bit?\""
msgstr "少し、話をしていいかな」"

#. Occurrence B_7:317:16031: scene=B_7
#: B_7:317
msgctxt "text_id=16031 | speaker=unknown"
msgid "  Since Aoko was always in a bad mood, Soujyuro did not pick up on anything out of the ordinary. "
msgstr "　青子はいつだって不機嫌なので、草十郎は彼女の微妙な変化に気付かなかった。"

#. Occurrence B_7:354:16032: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0003; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:354
msgctxt "text_id=16032 | speaker=aoko"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence B_7:360:16033: scene=B_7
#: B_7:360
msgctxt "text_id=16033 | speaker=unknown"
msgid "  She wanted to tell him to go drink some water because he looked ready to collapse, but he didn't seem aware of his own condition."
msgstr "　青子としては、その前に水でも飲んで自分の顔色の悪さをどうにかしろ、と言いたいのだが、草十郎に自覚はないようだ。"

#. Occurrence B_7:365:16034: scene=B_7
#: B_7:365
msgctxt "text_id=16034 | speaker=unknown"
msgid "  And to be fair to him, Alice did say Aoko was in bad shape. Given how unaccustomed to blood Soujyuro was, it was no wonder he had fainted."
msgstr "　有珠曰く、本当にひどい状態だったから、血を見慣れていない男の子ならクラっときてもおかしくない、とのコトだが……。"

#. Occurrence B_7:406:16035: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0003; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:406
msgctxt "text_id=16035 | speaker=soujuurou"
msgid "\"Oh... of course."
msgstr "「ああ、そうか。"

#. Occurrence B_7:412:16036: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0004; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:412
msgctxt "text_id=16036 | speaker=soujuurou"
msgid "  You're probably still too injured to talk. Sorry, I'll come back later.\""
msgstr "　話なんてまだ無理だな。すまない、出直してくる」"

#. Occurrence B_7:430:16037: scene=B_7
#: B_7:430
msgctxt "text_id=16037 | speaker=unknown"
msgid "  Soujyuro seemed to have misunderstood Aoko being deep in thought as not having enough stamina to speak."
msgstr "　思案していた青子の様子から、“まだ話す体力もない”と誤解したらしい。"

#. Occurrence B_7:435:16038: scene=B_7
#: B_7:435
msgctxt "text_id=16038 | speaker=unknown"
msgid "  Naturally this did not sit well with Aoko."
msgstr "　それはそれで、なんだか癪に障る青子だった。"

#. Occurrence B_7:459:16039: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0004; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:459
msgctxt "text_id=16039 | speaker=aoko"
msgid "\"Hold it right there. If you came to talk, I can talk just fine. I've been cooped up in here, so I could use the distraction."
msgstr "「待ちなさいよ。話だけなら別にかまわないわ。やる気もて余してるし、暇つぶしがてらに相手してあげるわよ。"

#. Occurrence B_7:465:16040: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0005; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:465
msgctxt "text_id=16040 | speaker=aoko"
msgid "  ...Okay, so you're not the best distraction, but beggars can't be choosers.\""
msgstr "　……まあ退屈しのぎにしてはちょっとグレード下がるけど、この際ぜいたく言ってられないし」"

#. Occurrence B_7:474:16041: scene=B_7
#: B_7:474
msgctxt "text_id=16041 | speaker=unknown"
msgid "  Soujyuro sensed this was going to be rough,"
msgstr "　なんか散々な言われようだが、それなら、"

msgctxt "text_id=16042 | speaker=unknown"
msgid " but took a seat on the chair next to the bed."
msgstr "と草十郎はベッド横の椅子に腰を下ろした。"

#. Occurrence B_7:497:16043: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0006; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:497
msgctxt "text_id=16043 | speaker=aoko"
msgid "\"So, what do you want to ask me?\""
msgstr "「で。何が聞きたいの？」"

#. Occurrence B_7:503:16044: scene=B_7
#: B_7:503
msgctxt "text_id=16044 | speaker=unknown"
msgid "  Aoko spoke energetically in an attempt to distract from her weakened appearance."
msgstr "　青子は患者衣の弱々しさを払拭するように、きびきびと声をあげる。"

#. Occurrence B_7:508:16045: scene=B_7
#: B_7:508
msgctxt "text_id=16045 | speaker=unknown"
msgid "  Naturally, she knew she was fooling no one."
msgstr "　どう見ても強がりなのに、そんな弱さは微塵も見せない。"

#. Occurrence B_7:529:16046: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0005; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:529
msgctxt "text_id=16046 | speaker=soujuurou"
msgid "\"You really are strong, Aozaki. I'm relieved to see that you're okay.\""
msgstr "「―――うん。やっぱり蒼崎は強いな。安心した」"

#. Occurrence B_7:568:16047: scene=B_7
#: B_7:568
msgctxt "text_id=16047 | speaker=unknown"
msgid "  Soujyuro said, nodding in admiration."
msgstr "　感服してうなずく草十郎。"

#. Occurrence B_7:573:16048: scene=B_7
#: B_7:573
msgctxt "text_id=16048 | speaker=unknown"
msgid "  Aoko shot him an unimpressed look in response to the unwanted praise."
msgstr "　そんな賞賛の言葉に、青子は呆れた視線を向けた。"

#. Occurrence B_7:594:16049: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0007; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:594
msgctxt "text_id=16049 | speaker=aoko"
msgid "\"..."
msgstr "「……。"

#. Occurrence B_7:601:16050: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0008; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:601
msgctxt "text_id=16050 | speaker=aoko"
msgid "Honestly, you have the worst timing.\""
msgstr "アンタって、ほんと、間が悪いわ」"

#. Occurrence B_7:613:16051: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0006; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:613
msgctxt "text_id=16051 | speaker=soujuurou"
msgid "\"?\""
msgstr "「？」"

#. Occurrence B_7:619:16052: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0009; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:619
msgctxt "text_id=16052 | speaker=aoko"
msgid "\"Nothing. Forget it."
msgstr "「いいわよ、別に。"

#. Occurrence B_7:625:16053: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0010; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:625
msgctxt "text_id=16053 | speaker=aoko"
msgid "  Just something from a dream. It's nothing to do with you.\""
msgstr "　私の夢の話だから、そっちが気に病むことは―――」"

#. Occurrence B_7:660:16054: scene=B_7
#: B_7:660
msgctxt "text_id=16054 | speaker=unknown"
msgid "  She glowered, remembering."
msgstr "　先ほどの夢を思いだして、つい苦い顔をする。"

#. Occurrence B_7:665:16055: scene=B_7
#: B_7:665
msgctxt "text_id=16055 | speaker=unknown"
msgid "  Come to think of it, almost everyone in her dream was here in the church, turning her dour expression into a irritated one."
msgstr "　そういえば、<教会|ここ>には夢の登場人物がほぼ揃っているコトに気付き、苦い顔は本当に不機嫌な顔になってしまった。"

#. Occurrence B_7:696:16056: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0011; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:696
msgctxt "text_id=16056 | speaker=aoko"
msgid "\"Enough about that. You said you had questions, so out with them.\""
msgstr "「やめやめ、こんなつまんない話。聞きたい事があるならてっとり早く済ませちゃってよ、草十郎」"

#. Occurrence B_7:702:16057: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0007; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:702
msgctxt "text_id=16057 | speaker=soujuurou"
msgid "\"All right. Can you tell me what's going on?"
msgstr "「よかった。じゃあ、まず今の状況を聞かせてくれないか。"

#. Occurrence B_7:708:16058: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0008; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:708
msgctxt "text_id=16058 | speaker=soujuurou"
msgid "  I mean with Touko. Now that I'm involved and all.\""
msgstr "　橙子さんの話じゃ、俺も無関係じゃないそうだし」"

#. Occurrence B_7:742:16059: scene=B_7
#: B_7:742
msgctxt "text_id=16059 | speaker=unknown"
msgid "  Soujyuro spoke calmly, making Aoko wonder if he really understood the gravity of his situation."
msgstr "　落ち着いて問いただす草十郎だが、その意味が本当に分かっているかどうか、青子には疑問である。"

#. Occurrence B_7:747:16060: scene=B_7
#: B_7:747
msgctxt "text_id=16060 | speaker=unknown"
msgid "  He was Touko's enemy now; he was defenseless and needed protection."
msgstr "　橙子に狙われている以上、自衛手段のない草十郎を誰かが守らなければいけない。"

#. Occurrence B_7:752:16061: scene=B_7
#: B_7:752
msgctxt "text_id=16061 | speaker=unknown"
msgid "  Neither Aoko nor Alice could help him, and the Church could withdraw their sanctuary at any moment."
msgstr "　けれど青子にも有珠にもそんな余裕はないし、この教会だって、いつまで彼を保護してくれるか知れたものではない。"

#. Occurrence B_7:772:16062: scene=B_7
#: B_7:772
msgctxt "text_id=16062 | speaker=unknown"
msgid "  He had picked a side, and that had turned him from innocent bystander into target."
msgstr "　<青子|じぶん>たちに味方した以上、橙子にとって草十郎は無関係どころか排斥対象である。"

#. Occurrence B_7:777:16063: scene=B_7
#: B_7:777
msgctxt "text_id=16063 | speaker=unknown"
msgid "  The answer he sought was as simple as that."
msgstr "　質問の答えはそれだけだ。"

#. Occurrence B_7:782:16064: scene=B_7
#: B_7:782
msgctxt "text_id=16064 | speaker=unknown"
msgid "  He knew the facts: he was not a mage and was therefore powerless."
msgstr "　現状を知ったところで、魔術師ではない草十郎には何も出来ない。"

#. Occurrence B_7:803:16065: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0012; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:803
msgctxt "text_id=16065 | speaker=aoko"
msgid "\"...I guess you did help Alice.\""
msgstr "「……まあ、それでも有珠は助けられたワケだし」"

#. Occurrence B_7:821:16066: scene=B_7
#: B_7:821
msgctxt "text_id=16066 | speaker=unknown"
msgid "  Aoko did owe him for that."
msgstr "　借りはできてしまった。"

#. Occurrence B_7:826:16067: scene=B_7
#: B_7:826
msgctxt "text_id=16067 | speaker=unknown"
msgid "  To say thanks, she decided to at least give him the whole story up until now."
msgstr "　その礼として、今までの経緯をまともに話すぐらいは筋ではないか、と青子は自分なりに納得する。"

#. Occurrence B_7:858:16068: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0013; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:858
msgctxt "text_id=16068 | speaker=aoko"
msgid "\"Okay, I'll quickly walk you through everything."
msgstr "「よし、今までの経緯もふくめて軽く説明してみましょうか。"

#. Occurrence B_7:864:16069: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0014; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:864
msgctxt "text_id=16069 | speaker=aoko"
msgid "  Y'know, maybe even I'll get something out of it.\""
msgstr "　私も、なにか得る物があるかもしれないし」"

#. Occurrence B_7:879:16070: scene=B_7
#: B_7:879
msgctxt "text_id=16070 | speaker=unknown"
msgid "  Aoko composed herself before beginning her explanation."
msgstr "　気を取り直して青子は語り始める。"

#. Occurrence B_7:884:16071: scene=B_7
#: B_7:884
msgctxt "text_id=16071 | speaker=unknown"
msgid "  The battle began at the end of November."
msgstr "　十一月の終わりから始まった戦い。"

#. Occurrence B_7:889:16072: scene=B_7
#: B_7:889
msgctxt "text_id=16072 | speaker=unknown"
msgid "  A lot had happened since then, including meeting Soujyuro."
msgstr "　静希草十郎との出会いもふくめた、長かったけれど新鮮でもあった、一連の出来事を。"

#. Occurrence B_7:935:16073: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0015; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:935
msgctxt "text_id=16073 | speaker=aoko"
msgid "\"It all started a month ago,"
msgstr "「事の起こりは一ヶ月前。"

#. Occurrence B_7:941:16074: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0016; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:941
msgctxt "text_id=16074 | speaker=aoko"
msgid "  when the edge of the Bounded Field around Misaki City was taken down-"
msgstr "　三咲市に張られた結界のはじっこが、何者かに消されたのが発端だった。"

#. Occurrence B_7:947:16075: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0017; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:947
msgctxt "text_id=16075 | speaker=aoko"
msgid "  the fifth time since I became successor. Misaki City was officially under attack.\""
msgstr "　私が後継ぎになってから五度目の、三咲市を狙う敵の登場ってワケ」"

#. Occurrence B_7:978:16076: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0018; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:978
msgctxt "text_id=16076 | speaker=aoko"
msgid "\"This time, instead of attacking us directly, the enemy started by taking the land."
msgstr "「今回の敵は私たちとは直接戦わず、まず土地を奪うところから始めたわ。"

#. Occurrence B_7:984:16077: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0019; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:984
msgctxt "text_id=16077 | speaker=aoko"
msgid "  Everyone that had come before her had been a bunch of amateurs all full of themselves, attacking us head-on. They all ended up as kibble for Alice's watchdog.\""
msgstr "　今までのヤツは私たちを半人前と舐めていたから、たいていは真っ正面から仕掛けてきて、かってに有珠の猟犬の餌食になったんだけど、まあ、それはどうでもいいとして」"

#. Occurrence B_7:1005:16078: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0020; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1005
msgctxt "text_id=16078 | speaker=aoko"
msgid "\"Anyway, two types of Bounded Fields surround this area: one detects intruders; one siphons energy from the land."
msgstr "「町の結界には二種類あって、侵入者を見つけるものと、土地の力を有効利用するものがあるの。"

#. Occurrence B_7:1011:16079: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0021; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1011
msgctxt "text_id=16079 | speaker=aoko"
msgid "  The enemy attacked the latter. If the entire field is destroyed, then Alice and I effectively lose our ownership of this land."
msgstr "　敵が壊したのは土地の結界の方で、これが全部壊されると私や有珠は土地の所有権を失ってしまう。"

#. Occurrence B_7:1017:16080: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0022; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1017
msgctxt "text_id=16080 | speaker=aoko"
msgid "  Without land, we become no different than rogue mages.\""
msgstr "　土地のないはぐれ魔術師と同じになっちゃうのよ」"

#. Occurrence B_7:1038:16081: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0023; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1038
msgctxt "text_id=16081 | speaker=aoko"
msgid "\"Of course, we had another field set up to detect intruders, but it didn't do what it was supposed to."
msgstr "「勿論、そうならないように侵入者をあぶりだすための結界があるんだけど、こっちには何の反応もなかった。"

#. Occurrence B_7:1044:16082: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0024; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1044
msgctxt "text_id=16082 | speaker=aoko"
msgid "  And now we know why."
msgstr "　ま、当然よね。"

#. Occurrence B_7:1050:16083: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0025; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1050
msgctxt "text_id=16083 | speaker=aoko"
msgid "  The enemy was my sister, Touko Aozaki.\""
msgstr "　今回の敵は私の姉貴、蒼崎橙子その人だったんだから」"

#. Occurrence B_7:1071:16084: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0026; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1071
msgctxt "text_id=16084 | speaker=aoko"
msgid "\"Aozaki Bounded Fields aren't going to recognize a fellow Aozaki as a threat."
msgstr "「蒼崎の結界は同族である姉貴を敵と見なさなかった。"

#. Occurrence B_7:1077:16085: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0027; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1077
msgctxt "text_id=16085 | speaker=aoko"
msgid "  Alternatively, she may have just known about a blind spot and slipped in that way."
msgstr "　……あるいは、姉貴は結界の抜け道、構造の死角をついたのかもしれない。"

#. Occurrence B_7:1083:16086: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0028; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1083
msgctxt "text_id=16086 | speaker=aoko"
msgid "  As the original successor, it's only natural she'd have that knowledge to begin with.\""
msgstr "　もともとうちの後継者はあの人だし、それぐらいの知識はあったでしょう」"

#. Occurrence B_7:1104:16087: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0029; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1104
msgctxt "text_id=16087 | speaker=aoko"
msgid "\"So, since she was invisible to us, she had free rein to break Bounded Field sigils."
msgstr "「そうして、姉貴は私たちに見つかる事なく好き勝手に結界の支点を壊しはじめた。"

#. Occurrence B_7:1110:16088: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0030; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1110
msgctxt "text_id=16088 | speaker=aoko"
msgid "  She deliberately attacked them slowly, one by one, to make us think it was an outsider."
msgstr "　時間をかけてゆっくり壊していったのは、“外からやってきた部外者”を演じていたからでしょうね。"

#. Occurrence B_7:1116:16089: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0031; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1116
msgctxt "text_id=16089 | speaker=aoko"
msgid "  If she'd broken them all at once, I'd suspect it was one of my relatives, such as someone from the Asagi family.\""
msgstr "　さすがに連続して壊されれば、こっちも身内の犯行だと疑うし。うち、親戚である<浅葱|あさぎ>家とは仲悪いままだしさ」"

#. Occurrence B_7:1147:16090: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0032; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1147
msgctxt "text_id=16090 | speaker=aoko"
msgid "\"While we were stupid to fall for her little game, it's also possible it took her a long time to destroy the field."
msgstr "「……まあ、姉貴の芝居に騙された私たちが間抜けなんだけど、セオリーとして、結界崩しは長丁場になるものなの。"

#. Occurrence B_7:1153:16091: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0033; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1153
msgctxt "text_id=16091 | speaker=aoko"
msgid "  Our fields are made of strong stuff. They typically last for six months.\""
msgstr "　管理地の結界は強固に作られているからね。普通は半年単位での攻防になる」"

#. Occurrence B_7:1174:16092: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0034; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1174
msgctxt "text_id=16092 | speaker=aoko"
msgid "\"An enemy would need to figure out how many sigils supported the field, what elements comprise them, and the correct order to take them down."
msgstr "「攻める側は、まず結界を<象|かたちど>る支点が何個あるか、それがどの五大要素でくくられているか、退去の正しい順序はどれか、それらを地道に解き明かしていく。"

#. Occurrence B_7:1180:16093: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0035; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1180
msgctxt "text_id=16093 | speaker=aoko"
msgid "  All the while making sure the mage they belong to doesn't notice.\""
msgstr "　もちろん、管理地の魔術師たちの目を盗みながら」"

#. Occurrence B_7:1201:16094: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0036; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1201
msgctxt "text_id=16094 | speaker=aoko"
msgid "\"If we did notice, we'd locate the intruder's base and eliminate them before any damage could be done."
msgstr "「対して、守る側は侵入者がいるコトに気づくから、悪さをされる前に敵の拠点を見つけだして、外敵を排除する。"

#. Occurrence B_7:1207:16095: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0037; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1207
msgctxt "text_id=16095 | speaker=aoko"
msgid "  So, Bounded Fields are either broken during a drawn-out battle or preemptively before it even starts."
msgstr "　こんな感じで、結界崩しは長期戦、あるいは前哨戦になるものなの。"

#. Occurrence B_7:1213:16096: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0038; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1213
msgctxt "text_id=16096 | speaker=aoko"
msgid "  Usually, the enemy threatens to break the sigils to lure the landowner out. Then things are settled there and then with a duel between mages.\""
msgstr "　たいていは攻める側が支点を壊すぞとアピールして、土地の持ち主を<翻弄|ほんろう>、<疲弊|ひへい>させてから、魔術師同士の直接対決で決着がつくわ」"

#. Occurrence B_7:1234:16097: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0039; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1234
msgctxt "text_id=16097 | speaker=aoko"
msgid "\"Doing that eliminates the need to completely destroy a field."
msgstr "「なんで、結界を<全部|ぜんぶ>壊す必要はないのよ。"

#. Occurrence B_7:1240:16098: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0040; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1240
msgctxt "text_id=16098 | speaker=aoko"
msgid "  It's much faster to take out the landowner and-as long as they can decipher the formula-seize the fields and land afterward."
msgstr "　管理地の持ち主を始末した方が早いし、その後は術式さえ解読しちゃえば、土地を結界ごと横取りできる。"

#. Occurrence B_7:1246:16099: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0041; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1246
msgctxt "text_id=16099 | speaker=aoko"
msgid "  If you don't destroy the fields, you don't have to remake them. Besides, ones that have been in the land for years are stronger.\""
msgstr "　わざわざ壊して作り直すより、昔からある結界の方が土地に馴染んでいて強力だしで一石二鳥でしょ」"

#. Occurrence B_7:1266:16100: scene=B_7
#: B_7:1266
msgctxt "text_id=16100 | speaker=unknown"
msgid "  That was how Aoko and Alice were duped."
msgstr "　……そういった<定石|セオリー>から、青子たちは相手の思惑を読み違えてしまった。"

#. Occurrence B_7:1271:16101: scene=B_7
#: B_7:1271
msgctxt "text_id=16101 | speaker=unknown"
msgid "  They never thought the enemy would waste the time and effort needed to break all sigils."
msgstr "　まさか相手が結界の支点をすべて壊すなど、そんな無駄な労力は割くまいとタカをくくっていたのだ。"

#. Occurrence B_7:1321:16102: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0042; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1321
msgctxt "text_id=16102 | speaker=aoko"
msgid "\"That's why Alice and I went on the defensive."
msgstr "「だから、私と有珠はとりあえず受けに回った。"

#. Occurrence B_7:1327:16103: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0043; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1327
msgctxt "text_id=16103 | speaker=aoko"
msgid "  We figured we could surprise the enemy while they searched for the sigils; take them out one by one."
msgstr "　支点を探すために街を調査している敵を待ち伏せて、これを片っ端から倒そうって。"

#. Occurrence B_7:1333:16104: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0044; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1333
msgctxt "text_id=16104 | speaker=aoko"
msgid "  But that's when things started to go south."
msgstr "　でも、そのうちの一つがケチのつき始めだった。"

#. Occurrence B_7:1339:16105: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0045; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1339
msgctxt "text_id=16105 | speaker=aoko"
msgid "  When a certain busybody saw something he shouldn't have at the local park.\""
msgstr "　三咲町の公園でヤマはって待ち受けていた時、どうでもいい第三者が覗き見してやがったのよ」"

#. Occurrence B_7:1366:16106: scene=B_7
#: B_7:1366
msgctxt "text_id=16106 | speaker=unknown"
msgid "  Indeed."
msgstr "　―――そう。"

#. Occurrence B_7:1371:16107: scene=B_7
#: B_7:1371
msgctxt "text_id=16107 | speaker=unknown"
msgid "  It was the ultimate taboo in the world of magecraft:"
msgstr "　魔術世界におけるトップクラスの<禁忌|タブー>。"

#. Occurrence B_7:1376:16108: scene=B_7
#: B_7:1376
msgctxt "text_id=16108 | speaker=unknown"
msgid "  The existence of mages must never be revealed to outsiders."
msgstr "　関わりのない第三者に、魔術師であるコトを知られてしまったのである。"

#. Occurrence B_7:1397:16109: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0046; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1397
msgctxt "text_id=16109 | speaker=aoko"
msgid "\"And you know the rest, right?"
msgstr "「その後の事は分かるでしょう？"

#. Occurrence B_7:1429:16110: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0047; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1429
msgctxt "text_id=16110 | speaker=aoko"
msgid "  I had no choice but to leave our battle with the enemy to Alice, and devote my time to searching for the eye-witness."
msgstr "　私は敵との小競り合いを有珠に任せて、それより重要な目撃者狩りに専念せざるを得なくなった。"

#. Occurrence B_7:1446:16111: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0048; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1446
msgctxt "text_id=16111 | speaker=aoko"
msgid "  ...And in case you haven't realized, I'm talking about you, so don't give me a soppy look like you're surprised.\""
msgstr "　……言っとくけど、これはアンタの事だからね。そこでワレ<関|カン>セズ、みたいな顔しないこと」"

#. Occurrence B_7:1482:16112: scene=B_7
#: B_7:1482
msgctxt "text_id=16112 | speaker=unknown"
msgid "  No sooner had Aoko said that, Soujyuro gave her that exact look."
msgstr "　青子にじろりと睨まれて、草十郎はそうなのか？　と目を見開いた。"

#. Occurrence B_7:1487:16113: scene=B_7
#: B_7:1487
msgctxt "text_id=16113 | speaker=unknown"
msgid "  Clearly, he had been listening, but not necessarily understanding."
msgstr "　おとなしく話を聞いているものの、やはり、あまり理解していないようだ。"

#. Occurrence B_7:1519:16114: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0049; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1519
msgctxt "text_id=16114 | speaker=aoko"
msgid "\"Whatever. It's water under the bridge. Actually, thanks to your cluelessness, our secret is still safe."
msgstr "「……ま、いいけどね。草十郎がそんなだから秘密は漏れなかったんだし。"

#. Occurrence B_7:1525:16115: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0050; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1525
msgctxt "text_id=16115 | speaker=aoko"
msgid "  Anyway, the fact I went looking for you worked in the enemy's favor.\""
msgstr "　で、アンタっていう目撃者を消そうとした私の単独行動は、敵にしても都合のいいものだった」"

#. Occurrence B_7:1571:16116: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0051; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1571
msgctxt "text_id=16116 | speaker=aoko"
msgid "\"Alice was their biggest threat. With us separated, she could take me out. That's when she sent her special puppet."
msgstr "「強敵である有珠がいないんだから、敵はこれを機会に私を始末しようと、特注品の人形を差し向けた……"

#. Occurrence B_7:1577:16117: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0052; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1577
msgctxt "text_id=16117 | speaker=aoko"
msgid "  Or so I thought at the time. It turns out she only sent it to mess with me."
msgstr "　と思っていたけど、アレはただの嫌がらせね、間違いなく。"

#. Occurrence B_7:1584:16118: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0053; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1584
msgctxt "text_id=16118 | speaker=aoko"
msgid "Otherwise why use a puppet that looked just like me?\""
msgstr "そうでなきゃ私そっくりの人形なんて派遣するかっての」"

#. Occurrence B_7:1603:16119: scene=B_7
#: B_7:1603
msgctxt "text_id=16119 | speaker=unknown"
msgid "  Soujyuro nodded, thinking back to the Aoko replica."
msgstr "　ああ、あの青子人形、と相づちを打つ草十郎。"

#. Occurrence B_7:1629:16120: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0054; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1629
msgctxt "text_id=16120 | speaker=aoko"
msgid "\"Remember, I'd prefer it if you forgot about that incident altogether."
msgstr "「アレの事は忘れてちょうだい。"

#. Occurrence B_7:1641:16121: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0055; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1641
msgctxt "text_id=16121 | speaker=aoko"
msgid "  After that, you can fill in the blanks."
msgstr "　……まあ、そこから先はアンタも薄々知ってるでしょ。"

#. Occurrence B_7:1647:16122: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0056; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1647
msgctxt "text_id=16122 | speaker=aoko"
msgid "  Alice and I turned our attention to fighting the enemy, spending most nights tracking her fruitlessly, until the fight last night."
msgstr "　私と有珠は敵との戦いに専念する事になって、毎日のように捜査の手を空振って、決戦の夜を迎えて、今はこうしてる。"

#. Occurrence B_7:1653:16123: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0057; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1653
msgctxt "text_id=16123 | speaker=aoko"
msgid "  That's the long and short of it.\""
msgstr "　だいたいの経緯はこんなところよ」"

#. Occurrence B_7:1689:16124: scene=B_7
#: B_7:1689
msgctxt "text_id=16124 | speaker=unknown"
msgid "  She stared down at her body, as if recalling what had happened would help her accept her current state."
msgstr "　振り返ってみて納得したのか、ふむ、と青子はぞんざいに自分の体を見つめていた。"

#. Occurrence B_7:1694:16125: scene=B_7
#: B_7:1694
msgctxt "text_id=16125 | speaker=unknown"
msgid "  Under the sheet, magical energy steadily flowed through her partially bandaged body."
msgstr "　シーツの下の体は、まだところどころ包帯が巻かれているものの、少しずつ<魔力|けつえき>が<通|かよ>いだしている。"

#. Occurrence B_7:1715:16126: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0009; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:1715
msgctxt "text_id=16126 | speaker=soujuurou"
msgid "\"Okay, Aozaki. I think I'm all caught up."
msgstr "「……蒼崎。これまでの君たちの話は分かった。"

#. Occurrence B_7:1721:16127: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0010; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:1721
msgctxt "text_id=16127 | speaker=soujuurou"
msgid "  But what about you? Why are you in this state?\""
msgstr "　けど、肝心の今の状況はどうなっているんだ？」"

#. Occurrence B_7:1761:16128: scene=B_7
#: B_7:1761
msgctxt "text_id=16128 | speaker=unknown"
msgid "  Soujyuro's specific concern was the reason Aoko was lying there."
msgstr "　青子がここに<臥|ふ>している理由。"

#. Occurrence B_7:1766:16129: scene=B_7
#: B_7:1766
msgctxt "text_id=16129 | speaker=unknown"
msgid "  More than anything, he wanted to know what had happened to her the night before."
msgstr "　草十郎にとって最大の関心は、昨日の夜、何があったかという事だ。"

#. Occurrence B_7:1800:16130: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0058; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1800
msgctxt "text_id=16130 | speaker=aoko"
msgid "\"Simple. We lost. What more is there to say?\""
msgstr "「バカね。状況も何も、完全に私たちの負けじゃない」"

#. Occurrence B_7:1806:16131: scene=B_7
#: B_7:1806
msgctxt "text_id=16131 | speaker=unknown"
msgid "  Judging by her tone, she would have raised both hands sarcastically in celebration if she could."
msgstr "　両手が満足に動けたのならバンザイでもしそうな口調で、青子はあっさり敗北宣言をした。"

#. Occurrence B_7:1843:16132: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0011; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:1843
msgctxt "text_id=16132 | speaker=soujuurou"
msgid "\"You lost...?\""
msgstr "「負けた……？」"

#. Occurrence B_7:1849:16133: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0059; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1849
msgctxt "text_id=16133 | speaker=aoko"
msgid "\"Yep. It sucks, but there's no getting around it."
msgstr "「そ。事実は正しく受け止めなくっちゃね。"

#. Occurrence B_7:1855:16134: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0060; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1855
msgctxt "text_id=16134 | speaker=aoko"
msgid "  The moment all five sigils were broken, it was over."
msgstr "　五つの支点がぜんぶ壊された時点で、勝負はついたの。"

#. Occurrence B_7:1861:16135: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0061; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1861
msgctxt "text_id=16135 | speaker=aoko"
msgid "  The land rights are up in the air, until tomorrow when Touko claims them."
msgstr "　管理地の所有権は宙ぶらりで、明日には橙子の手に渡るでしょう。"

#. Occurrence B_7:1880:16136: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0062; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1880
msgctxt "text_id=16136 | speaker=aoko"
msgid "  In trying to prevent that, Alice and I ended up like this."
msgstr "　で、それを阻止したいこっちは、私も有珠もこの有様。"

#. Occurrence B_7:1886:16137: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0063; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1886
msgctxt "text_id=16137 | speaker=aoko"
msgid "  The tables have turned. So from here on, we'll be the challengers. We are the rogue mages.\""
msgstr "　もう立場は逆転したから、これから私たちは挑戦者……つまり、はぐれ魔術師ってコトよ」"

#. Occurrence B_7:1906:16138: scene=B_7
#: B_7:1906
msgctxt "text_id=16138 | speaker=unknown"
msgid "  Which meant that Aoko, Alice, and Soujyuro only had a few more days with which to utilize the Church's services."
msgstr "　なので、青子たちがこの教会に厄介になれるのも、あと数日だけだった。"

#. Occurrence B_7:1922:16139: scene=B_7
#: B_7:1922
msgctxt "text_id=16139 | speaker=unknown"
msgid "  Aida Church was not only an arm of the Mage's Association, but also a branch of the Holy Church that monitored heresy."
msgstr "　この合田教会は魔術協会の支部でもあり、異端を監視する聖堂教会とやらの支部でもある。"

#. Occurrence B_7:1927:16140: scene=B_7
#: B_7:1927
msgctxt "text_id=16140 | speaker=unknown"
msgid "  Aoko and Alice were owners of Misaki City's spiritual lands, but they belonged to neither of these organizations."
msgstr "　青子たちはそのどちらにも所属していない、三咲市だけの有権者だ。"

#. Occurrence B_7:1947:16141: scene=B_7
#: B_7:1947
msgctxt "text_id=16141 | speaker=unknown"
msgid "  The only reason the Church helped them at all was because they were the land's administrators."
msgstr "　教会が青子たちに力を貸しているのは、彼女たちが土地の管理者であったから。"

#. Occurrence B_7:1952:16142: scene=B_7
#: B_7:1952
msgctxt "text_id=16142 | speaker=unknown"
msgid "  Once those rights were lost, the Church would have no reason to provide any further aid."
msgstr "　その権利を失うのなら、教会として肩入れする理由は皆無である。"

#. Occurrence B_7:1975:16143: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0064; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1975
msgctxt "text_id=16143 | speaker=aoko"
msgid "\"Father Eiri is helping us because he's neutral in all this, but Yuika is a Church Executor. Once I'm healed, she'll kick me out."
msgstr "「詠梨神父は<中立者|こうもり>だから私を助けてくれたけど、唯架さんは教会の代行者だから、傷が塞がったなら明日にでも出ていけって言ってくる。"

#. Occurrence B_7:1982:16144: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0065; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1982
msgctxt "text_id=16144 | speaker=aoko"
msgid "The Church sees mages as their professional competition."
msgstr "教会にとっちゃ、魔術師なんてもともと排除すべき商売敵だからね。"

#. Occurrence B_7:1990:16145: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0066; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:1990
msgctxt "text_id=16145 | speaker=aoko"
msgid "  And that stupid Ritsuka... Well, she might help out if I cried.\""
msgstr "　バカ律架は―――まあ、泣きつけば力にはなってくれるでしょうけど」"

#. Occurrence B_7:2024:16146: scene=B_7
#: B_7:2024
msgctxt "text_id=16146 | speaker=unknown"
msgid "  Soujyuro understood little of what Aoko was talking about."
msgstr "　ぶつぶつと草十郎には分からない話をする青子。"

#. Occurrence B_7:2031:16147: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0012; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2031
msgctxt "text_id=16147 | speaker=soujuurou"
msgid "\"I didn't mean that, Aozaki."
msgstr "「そうじゃなくて、蒼崎。"

#. Occurrence B_7:2038:16148: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0013; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2038
msgctxt "text_id=16148 | speaker=soujuurou"
msgid "I meant, what actually happened last night?\""
msgstr "昨日の夜、何があったんだ」"

#. Occurrence B_7:2075:16149: scene=B_7
#: B_7:2075
msgctxt "text_id=16149 | speaker=unknown"
msgid "  Soujyuro pressed her, and Aoko really wished he had not."
msgstr "　一番聞きたい事を話したがらない青子に、草十郎は自分から切りだした。"

#. Occurrence B_7:2109:16150: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0067; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2109
msgctxt "text_id=16150 | speaker=aoko"
msgid "\"...You can't tell by looking? They wiped the floor with me."
msgstr "「……見て分からない？　惨敗なんてものじゃないわ。"

#. Occurrence B_7:2115:16151: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0068; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2115
msgctxt "text_id=16151 | speaker=aoko"
msgid "  My throat was torn to pieces along with the rest of me; my right thigh was basically gone."
msgstr "　喉に食い付かれる、体中好き放題噛まれまくる、あげくに右の<腿|もも>なんてなくなってたそうよ。"

#. Occurrence B_7:2121:16152: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0069; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2121
msgctxt "text_id=16152 | speaker=aoko"
msgid "  If it wasn't for Alice's chocolate, I'd have bled to death.\""
msgstr "　ま、有珠のチョコレイトのおかげで出血死は免れたけど」"

#. Occurrence B_7:2143:16153: scene=B_7
#: B_7:2143
msgctxt "text_id=16153 | speaker=unknown"
msgid "  She knocked on the cast around her leg."
msgstr "　青子はぽん、とギプスに包まれた片足を叩いた。"

#. Occurrence B_7:2148:16154: scene=B_7
#: B_7:2148
msgctxt "text_id=16154 | speaker=unknown"
msgid "  Aoko spoke casually, but was trying to hide how much she wanted revenge for being humiliated."
msgstr "　気楽に言いながらも、その奥には雪辱への闘志が見え隠れしている。"

#. Occurrence B_7:2176:16155: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0014; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2176
msgctxt "text_id=16155 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence B_7:2182:16156: scene=B_7
#: B_7:2182
msgctxt "text_id=16156 | speaker=unknown"
msgid "  In contrast, Soujyuro felt empty."
msgstr "　そんな青子とは反対に、彼に起きた感情は『空白』だった。"

#. Occurrence B_7:2187:16157: scene=B_7
#: B_7:2187
msgctxt "text_id=16157 | speaker=unknown"
msgid "  The little color he had in his face began to fade."
msgstr "　青ざめた顔色がいっそう白く、色を削ぎ落とす。"

#. Occurrence B_7:2192:16158: scene=B_7
#: B_7:2192
msgctxt "text_id=16158 | speaker=unknown"
msgid "  Was he repulsed by the terrible situation, or were his instincts telling him to flee?"
msgstr "　凄惨な行為からの逃避か、あるいは反感か。"

#. Occurrence B_7:2197:16159: scene=B_7
#: B_7:2197
msgctxt "text_id=16159 | speaker=unknown"
msgid "  Regardless, he appeared very human."
msgstr "　どちらにせよ、人間らしい感情の発露だった。"

#. Occurrence B_7:2243:16160: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0070; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2243
msgctxt "text_id=16160 | speaker=aoko"
msgid "\"What the hell's wrong with you? ...Oh, wait. I know."
msgstr "「なんでそこで固まる……あ、そっか。"

#. Occurrence B_7:2262:16161: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0071; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2262
msgctxt "text_id=16161 | speaker=aoko"
msgid "  You were stupid enough to look at me and throw up, am I right? Well you can stop worrying. I'm in one piece now."
msgstr "　私を見て吐き出しちゃうぐらいナイーヴなんだっけ、草十郎ってば。大丈夫よ、今はくっついてるから。"

#. Occurrence B_7:2268:16162: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0072; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2268
msgctxt "text_id=16162 | speaker=aoko"
msgid "  Yuika's a pro, and I'm still alive. Regeneration is a specialty of the Aozaki mages, so I'll be fine.\""
msgstr "　唯架さんは治療専門だし、私だってただやられてたワケじゃないし。復元は蒼崎の得意分野だから、あれくらい問題ないわ」"

#. Occurrence B_7:2288:16163: scene=B_7
#: B_7:2288
msgctxt "text_id=16163 | speaker=unknown"
msgid "  She gave him a reassuring look, but his expression was unchanged."
msgstr "　だから心配はいらない、と視線で語る青子だが、草十郎の様子は一向に変わらない。"

#. Occurrence B_7:2306:16164: scene=B_7
#: B_7:2306
msgctxt "text_id=16164 | speaker=unknown"
msgid "  Aoko had expected him to worry, but this level of concern made it hard for even her to berate him."
msgstr "　……見当違いとはいえ、ここまで心配されると青子も文句は言い辛い。"

#. Occurrence B_7:2311:16165: scene=B_7
#: B_7:2311
msgctxt "text_id=16165 | speaker=unknown"
msgid "  Feeling embarrassed, she started talking again."
msgstr "　なんだか照れ臭くなって、青子は会話を再開した。"

#. Occurrence B_7:2345:16166: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0073; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2345
msgctxt "text_id=16166 | speaker=aoko"
msgid "\"The question is how on earth did my sister manage to tame a golden wolf? I didn't even think they existed."
msgstr "「けど姉貴ったら、どうやってあんなのを<手懐|てなず>けたんだろう。金の<狼|おおかみ>なんて、伝説の中にしかいないと思ってた。"

#. Occurrence B_7:2351:16167: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0074; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2351
msgctxt "text_id=16167 | speaker=aoko"
msgid "  He's a relic from the Age of Gods; you'd need magecraft a millennium in the making just to stand a chance against him. Never mind trying to take him in a fistfight...\""
msgstr "　……神代の神秘であるあいつには千年クラスの魔術じゃないと太刀打ちできない。かといって殴り合いでどうにかできる相手じゃないし……」"

#. Occurrence B_7:2382:16168: scene=B_7
#: B_7:2382
msgctxt "text_id=16168 | speaker=unknown"
msgid "  As images of the night before entered Aoko's mind, she bit her lip in anguish."
msgstr "　昨夜の惨状を思い出し、青子は悔しげに唇を噛む。"

#. Occurrence B_7:2388:16169: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0015; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2388
msgctxt "text_id=16169 | speaker=soujuurou"
msgid "\"A golden... wolf...?\""
msgstr "「金の……狼……？」"

#. Occurrence B_7:2406:16170: scene=B_7
#: B_7:2406
msgctxt "text_id=16170 | speaker=unknown"
msgid "  Conversely, the bizarre phrase snapped Soujyuro out of his state of shock."
msgstr "　一方、聞きなれない言葉を聞いて、草十郎はショック状態から回復したようだ。"

#. Occurrence B_7:2440:16171: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0075; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2440
msgctxt "text_id=16171 | speaker=aoko"
msgid "\"Yeah. A golden wolf. A golden werewolf, to be exact."
msgstr "「そ、<黄金|おうごん>の<人狼|じんろう>。<金狼|きんろう>って言った方がいいのかな。"

#. Occurrence B_7:2446:16172: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0076; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2446
msgctxt "text_id=16172 | speaker=aoko"
msgid "  Then again, you've probably never heard of a werewolf. Think part human, part wolf, but only the best parts."
msgstr "　狼男……って言っても分からないわよね。人間と狼のいいとこどりみたいなヤツと思えばいいわ。"

#. Occurrence B_7:2468:16173: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0077; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2468
msgctxt "text_id=16173 | speaker=aoko"
msgid "  It's a magical beast, as opposed to a wild one."
msgstr "　野獣というより魔獣のたぐいよ。"

#. Occurrence B_7:2474:16174: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0078; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2474
msgctxt "text_id=16174 | speaker=aoko"
msgid "  There are ways to deal with regular werewolves, but the one with Touko has a golden coat.\""
msgstr "　普通の人狼なら対抗手段はあるんだけど、橙子が連れてるのは黄金の毛並みをした怪物でさ」"

#. Occurrence B_7:2495:16175: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0079; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2495
msgctxt "text_id=16175 | speaker=aoko"
msgid "\"He's a descendant of the first werewolves; a transcended magical beast, Phantasmal Beast."
msgstr "「あれは原初の人狼の血統で、魔獣を通り越して幻獣の域に達している。"

#. Occurrence B_7:2514:16176: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0080; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2514
msgctxt "text_id=16176 | speaker=aoko"
msgid "  To take on such a pure monster, you'd need a Mystic with a longer history or some really secret magecraft. Nothing else will even scratch him."
msgstr "　聖域の相手には、そいつらを上回る神秘……積み重ねた時間とか、魔術の奥義……じゃないと無効化されるのよ。"

#. Occurrence B_7:2520:16177: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0081; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2520
msgctxt "text_id=16177 | speaker=aoko"
msgid "  Magecraft can do almost anything, but it just can't compete with something so ancient."
msgstr "　魔術は万能だけど、この“年月の差”だけは<覆|くつがえ>せない。"

#. Occurrence B_7:2537:16178: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0082; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2537
msgctxt "text_id=16178 | speaker=aoko"
msgid "  He's the kind of natural disaster than any human mage dreads fighting.\""
msgstr "　ま、人間の魔術師にとっては天敵みたいな自然災害ね」"

#. Occurrence B_7:2557:16179: scene=B_7
#: B_7:2557
msgctxt "text_id=16179 | speaker=unknown"
msgid "  Her words indicated more admiration than hatred."
msgstr "　憎しみはなく、感心するように青子は語る。"

#. Occurrence B_7:2562:16180: scene=B_7
#: B_7:2562
msgctxt "text_id=16180 | speaker=unknown"
msgid "  The way she'd whispered about the wolf..."
msgstr "　そんな呟きに、"

#. Occurrence B_7:2582:16181: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0016; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2582
msgctxt "text_id=16181 | speaker=soujuurou"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence B_7:2587:16182: scene=B_7
#: B_7:2587
msgctxt "text_id=16182 | speaker=unknown"
msgid "  ...strangely, made sense to Soujyuro."
msgstr "　なにやら意味不明な納得をする草十郎だった。"

#. Occurrence B_7:2626:16183: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0083; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2626
msgctxt "text_id=16183 | speaker=aoko"
msgid "\"Wh-What? Out with it already.\""
msgstr "「？　な、なに？」"

#. Occurrence B_7:2637:16184: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0017; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2637
msgctxt "text_id=16184 | speaker=soujuurou"
msgid "\"Oh, I was just thinking how there's something out there that even you and Alice can't defeat."
msgstr "「いや、要するに蒼崎たちじゃ敵わない相手なんだな。"

#. Occurrence B_7:2648:16185: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0018; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2648
msgctxt "text_id=16185 | speaker=soujuurou"
msgid "  ...It must be truly awful."
msgstr "　……なんて酷いヤツだ。"

#. Occurrence B_7:2655:16186: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0019; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2655
msgctxt "text_id=16186 | speaker=soujuurou"
msgid "It tore apart Alice's stomach; and you... well, you don't have anywhere that wasn't torn apart."
msgstr "有珠はお<腹|なか>が裂かれてた。蒼崎は傷ついてない<箇所|ところ>はないぐらいだ。"

#. Occurrence B_7:2661:16187: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0020; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2661
msgctxt "text_id=16187 | speaker=soujuurou"
msgid "  How could a kid-actually, I guess it's because he's a kid that he doesn't know how to hold back.\""
msgstr "　子供なのに……いや、子供だから加減がないのか」"

#. Occurrence B_7:2695:16188: scene=B_7
#: B_7:2695
msgctxt "text_id=16188 | speaker=unknown"
msgid "  Soujyuro's face was a ghostly pale as he muttered nervously."
msgstr "　青ざめた顔で、<訥々|とつとつ>と呟く草十郎。"

#. Occurrence B_7:2711:16189: scene=B_7
#: B_7:2711
msgctxt "text_id=16189 | speaker=unknown"
msgid "  Aoko merely nodded in agreement."
msgstr "　青子は同感だ、とばかりにうなずいた。"

#. Occurrence B_7:2730:16190: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0084; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2730
msgctxt "text_id=16190 | speaker=aoko"
msgid "\"Now you get it."
msgstr "「ほーんと。"

#. Occurrence B_7:2737:16191: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0085; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2737
msgctxt "text_id=16191 | speaker=aoko"
msgid "What kid has the nerve to do *that* to someone's-wait, what did you just say?!\""
msgstr "人の体を何だと思っているのかしらね、あのお子さ―――なぬ？」"

#. Occurrence B_7:2781:16192: scene=B_7
#: B_7:2781
msgctxt "text_id=16192 | speaker=unknown"
msgid "  Aoko raised her head."
msgstr "　そこまで言いかけて、青子はバッと顔をあげた。"

#. Occurrence B_7:2786:16193: scene=B_7
#: B_7:2786
msgctxt "text_id=16193 | speaker=unknown"
msgid "  She looked as if she had seen a ghost."
msgstr "　いつかのように、意外なお化けを見たように。"

#. Occurrence B_7:2807:16194: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0086; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2807
msgctxt "text_id=16194 | speaker=aoko"
msgid "\"Did you just say 'kid?'"
msgstr "「いま子供って言った？"

#. Occurrence B_7:2813:16195: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0087; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2813
msgctxt "text_id=16195 | speaker=aoko"
msgid "  How the heck do you know that?\""
msgstr "　アンタ、なんでそんなコトまで知ってるの？」"

#. Occurrence B_7:2819:16196: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0021; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2819
msgctxt "text_id=16196 | speaker=soujuurou"
msgid "\"...I realized it was him that day. I'd never seen someone with such golden hair in my life. It has to have been him."
msgstr "「やっぱりそうなのか。金色の髪なんて二人もいないと思ったんだ。そいつなら一度見かけた事がある。"

#. Occurrence B_7:2841:16197: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0022; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2841
msgctxt "text_id=16197 | speaker=soujuurou"
msgid "  We were deep in the woods. It didn't look anything like the monster you described, though."
msgstr "　蒼崎が口にしたような怪物じゃなかったけど、森の奥で。"

#. Occurrence B_7:2847:16198: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0023; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2847
msgctxt "text_id=16198 | speaker=soujuurou"
msgid "  Kinomi wanted me to run after him. I told him no way, of course, the kid freaked me out. I knew there was no catching him.\""
msgstr "　木乃美が二人がかりでとっちめよう、なんて怖いコト言いだしてさ。<敵|かな>いっこないから止めたんだよ」"

#. Occurrence B_7:2891:16199: scene=B_7
#: B_7:2891
msgctxt "text_id=16199 | speaker=unknown"
msgid "  His tone was as curious as the things he was trying to articulate."
msgstr "　不思議な事を、不思議な口調で草十郎は言う。"

#. Occurrence B_7:2896:16200: scene=B_7
#: B_7:2896
msgctxt "text_id=16200 | speaker=unknown"
msgid "  Aoko, however, had more pressing matters."
msgstr "　青子にはそれを追及する余裕もない。"

#. Occurrence B_7:2901:16201: scene=B_7
#: B_7:2901
msgctxt "text_id=16201 | speaker=unknown"
msgid "  Much more pressing."
msgstr "　彼女的に、他にもっと重要な事がある―――"

#. Occurrence B_7:2923:16202: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0088; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2923
msgctxt "text_id=16202 | speaker=aoko"
msgid "\"You saw him?! Where?!\""
msgstr "「見たって、どこで！？」"

#. Occurrence B_7:2937:16203: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0024_0; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2937
msgctxt "text_id=16203 | speaker=soujuurou"
msgid "\"At the old school campus."
msgstr "「学校の旧校舎。"

#. Occurrence B_7:2952:16204: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0024_1; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:2952
msgctxt "text_id=16204 | speaker=soujuurou"
msgid "Come to think of it, I might have even met him. Just once, when I was working. I delivered fifty kilos of raw beef, and-\""
msgstr "あ、そういえば挨拶ていどなら話もしたっけ。一度だけ、アルバイトの時に牛肉五十キロを生で届けた事があって……」"

#. Occurrence B_7:2985:16205: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0089; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:2985
msgctxt "text_id=16205 | speaker=aoko"
msgid "\"Oh my god, y-you absolute idiot!\""
msgstr "「こ、この大馬鹿ものーーーーお！」"

#. Occurrence B_7:3026:16206: scene=B_7
#: B_7:3026
msgctxt "text_id=16206 | speaker=unknown"
msgid "  A strangely satisfying slapping sound rang out."
msgstr "　すぱかーん、と心地よい音がした。"

#. Occurrence B_7:3031:16207: scene=B_7
#: B_7:3031
msgctxt "text_id=16207 | speaker=unknown"
msgid "  Ignoring her wounds completely, Aoko had grabbed a slipper and thrown it at Soujyuro's unassuming face as hard as she could."
msgstr "　体の傷もなんのその、青子は神速で床のスリッパを取ると、草十郎の平和そうな顔に思いっきり投げ付けた。"

#. Occurrence B_7:3051:16208: scene=B_7
#: B_7:3051
msgctxt "text_id=16208 | speaker=unknown"
msgid "  She panted, as Soujyuro was knocked completely out of his chair."
msgstr "　はあはあと肩で息をする青子と、顔面を強襲したスリッパの衝撃で、座ったまま倒れこむ草十郎。"

#. Occurrence B_7:3074:16209: scene=B_7
#: B_7:3074
msgctxt "text_id=16209 | speaker=unknown"
msgid "  For a while, neither moved."
msgstr "　しばし、ふたりはそのままで動かなかった。"

#. Occurrence B_7:3109:16210: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0025; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:3109
msgctxt "text_id=16210 | speaker=soujuurou"
msgid "\"...What was that for, Aozaki?\""
msgstr "「―――なんで怒るんだ、蒼崎」"

#. Occurrence B_7:3115:16211: scene=B_7
#: B_7:3115
msgctxt "text_id=16211 | speaker=unknown"
msgid "  The boy asked, unfazed, as he slowly picked himself up."
msgstr "　むくりと起き上がる不屈の男。"

#. Occurrence B_7:3120:16212: scene=B_7
#: B_7:3120
msgctxt "text_id=16212 | speaker=unknown"
msgid "  He sat cross legged, as Aoko scowled at him like an enemy."
msgstr "　<小法師|こぼし>の如く<胡坐|あぐら>をかく彼を、青子は敵を見る目で睨みつける。"

#. Occurrence B_7:3156:16213: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0090; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3156
msgctxt "text_id=16213 | speaker=aoko"
msgid "\"What do you think?!"
msgstr "「あったりまえじゃない！"

#. Occurrence B_7:3162:16214: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0091; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3162
msgctxt "text_id=16214 | speaker=aoko"
msgid "  Who keeps something like that to themselves!\""
msgstr "　なんでそんな怪しいコト黙ってんのよ、アンタはっ！」"

#. Occurrence B_7:3175:16215: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0026; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:3175
msgctxt "text_id=16215 | speaker=soujuurou"
msgid "\"...I didn't think it was worth mentioning. Even if I had, the two of you would've just gotten mad at me.\""
msgstr "「……言うほどの事でもない。第一、君たちにこんな話をしても怒られるだけじゃないか」"

#. Occurrence B_7:3208:16216: scene=B_7
#: B_7:3208
msgctxt "text_id=16216 | speaker=unknown"
msgid "  Aoko knew he was right, and so she swallowed her words."
msgstr "　草十郎のもっともな意見に、青子はうっと言葉を飲んだ。"

#. Occurrence B_7:3228:16217: scene=B_7
#: B_7:3228
msgctxt "text_id=16217 | speaker=unknown"
msgid "  She imagined themselves at dinner."
msgstr "　夕食中、"

#. Occurrence B_7:3248:16218: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0027; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:3248
msgctxt "text_id=16218 | speaker=soujuurou"
msgid "\"You'll never guess what I did today―I delivered a mountain of beef to an animal. One animal. Rich people live in a different world, am I right?\""
msgstr "『ところで今日、牛肉の山をかついで届けたんだ。一匹丸ごと。いや、あるところにはあるものだね、お金と食欲』"

#. Occurrence B_7:3271:16219: scene=B_7
#: B_7:3271
msgctxt "text_id=16219 | speaker=unknown"
msgid "  If he had actually said it, Aoko and Alice's response would have been less than cordial."
msgstr "　なんて話をされたら、<青子|じぶん>と有珠がどんな反応するか、考えるまでもない。"

#. Occurrence B_7:3298:16220: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0092; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3298
msgctxt "text_id=16220 | speaker=aoko"
msgid "\"...Okay, you're probably right."
msgstr "「っ……それは、そうだけど。"

#. Occurrence B_7:3319:16221: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0093; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3319
msgctxt "text_id=16221 | speaker=aoko"
msgid "  Anyway, was there really a golden-haired child at the old school building?\""
msgstr "　……ほんとに、金髪の子供が旧校舎にいたの？」"

#. Occurrence B_7:3339:16222: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0028; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:3339
msgctxt "text_id=16222 | speaker=soujuurou"
msgid "\"I don't know whether he was your werewolf."
msgstr "「それが蒼崎の言うジンロウかどうか、自信はないけど。"

#. Occurrence B_7:3345:16223: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0029; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:3345
msgctxt "text_id=16223 | speaker=soujuurou"
msgid "  And we've had some strange orders from restaurants in town. Especially that Imperial Metropolis near the station.\""
msgstr "　少なくとも街中の料理店が入れ代わりでおかしな注文を届けてるのは事実だ。駅前の大帝都なんてお得意様だって」"

#. Occurrence B_7:3379:16224: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0094; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3379
msgctxt "text_id=16224 | speaker=aoko"
msgid "\"That makes sense. There was no way he could eat out without drawing lots of attention to himself.\""
msgstr "「……たしかに、食事のたびにあいつを外に出してちゃ目立つだろうけど……」"

#. Occurrence B_7:3385:16225: scene=B_7
#: B_7:3385
msgctxt "text_id=16225 | speaker=unknown"
msgid "  She did not want to believe it, but the child had to be the werewolf."
msgstr "　……あんまり信じたくはないが、そこが人狼の住み家である可能性は高すぎる。"

#. Occurrence B_7:3390:16226: scene=B_7
#: B_7:3390
msgctxt "text_id=16226 | speaker=unknown"
msgid "  Could Touko really have been so careless as to hide him in plain sight?"
msgstr "　橙子なりに人狼の存在を隠したのだろうが、その方法はどこか間が抜けていた。"

#. Occurrence B_7:3421:16227: scene=B_7
#: B_7:3421
msgctxt "text_id=16227 | speaker=unknown"
msgid "  It didn't matter at this point."
msgstr "　……しかし、ともかくだ。"

#. Occurrence B_7:3426:16228: scene=B_7
#: B_7:3426
msgctxt "text_id=16228 | speaker=unknown"
msgid "  With the werewolf's habitat revealed, Touko's base had been revealed, too."
msgstr "　人狼の住み家が判明した以上、探していた橙子の本拠地も判明した事になる。"

#. Occurrence B_7:3431:16229: scene=B_7
#: B_7:3431
msgctxt "text_id=16229 | speaker=unknown"
msgid "  To take over the Bounded Field, she needed an inconspicuous place to store materials."
msgstr "　そもそも結界の張り替えには資材が保管できて、人目につかない拠点が必要なのだ。"

#. Occurrence B_7:3436:16230: scene=B_7
#: B_7:3436
msgctxt "text_id=16230 | speaker=unknown"
msgid "  Misaki High School's old school building was the perfect place."
msgstr "　三咲高校の旧校舎は、その条件を備えている。"

#. Occurrence B_7:3468:16231: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0095; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3468
msgctxt "text_id=16231 | speaker=aoko"
msgid "\"Huh, you were hiding the key to the puzzle this whole time.\""
msgstr "「……つまり、全ての鍵はアンタが隠し持ってたってワケね」"

#. Occurrence B_7:3488:16232: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0030; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:3488
msgctxt "text_id=16232 | speaker=soujuurou"
msgid "\"I wasn't hiding anything."
msgstr "「隠していたんじゃない。"

#. Occurrence B_7:3495:16233: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0031; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:3495
msgctxt "text_id=16233 | speaker=soujuurou"
msgid "If you'd actually helped with cleaning the backhills, you'd have found out for yourself."
msgstr "だいたい、蒼崎が裏山の掃除に参加していたら、その時に分かったんじゃないか？"

#. Occurrence B_7:3501:16234: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0032; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:3501
msgctxt "text_id=16234 | speaker=soujuurou"
msgid "  You shouldn't have left it to Tobimaru.\""
msgstr "　鳶丸ひとりに任せず、蒼崎も掃除にでれば良かったんだ」"

#. Occurrence B_7:3539:16235: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0096; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3539
msgctxt "text_id=16235 | speaker=aoko"
msgid "\"...\""
msgstr "「…………………………」"

#. Occurrence B_7:3560:16236: scene=B_7
#: B_7:3560
msgctxt "text_id=16236 | speaker=unknown"
msgid "  In response to Soujyuro's infallible logic, Aoko snapped her fingers."
msgstr "　……ごもっともな意見に、青子はぱちりと指を鳴らす。"

#. Occurrence B_7:3594:16237: scene=B_7
#: B_7:3594
msgctxt "text_id=16237 | speaker=unknown"
msgid "  Instead of another slipper missile, she let the faithful white collar express how she felt."
msgstr "　スリッパ爆弾の代わりに、白い首輪は忠実に、彼女の気持ちを代弁したのだった。"

#. Occurrence B_7:3638:16238: scene=B_7
#: B_7:3638
msgctxt "text_id=16238 | speaker=unknown"
msgid "  And with the tightening of the collar..."
msgstr "　そうして。"

#. Occurrence B_7:3643:16239: scene=B_7
#: B_7:3643
msgctxt "text_id=16239 | speaker=unknown"
msgid "  Soujyuro realized something."
msgstr "　草十郎がひとしきり首輪の圧迫に苦しんだあと、"

#. Occurrence B_7:3648:16240: scene=B_7
#: B_7:3648
msgctxt "text_id=16240 | speaker=unknown"
msgid "  Aoko had changed."
msgstr "　彼ははっきりと、青子の変化に気が付いた。"

#. Occurrence B_7:3672:16241: scene=B_7
#: B_7:3672
msgctxt "text_id=16241 | speaker=unknown"
msgid "  From the bed, she looked down on him with a commanding glare."
msgstr "　ベッドの上の少女は、<凛|リン>と遠くを見据えている"

#. Occurrence B_7:3677:16242: scene=B_7
#: B_7:3677
msgctxt "text_id=16242 | speaker=unknown"
msgid "  Though weak from her injuries, she was as sharp as ever; you would be forgiven for forgetting she was ever a patient."
msgstr "　傷ついて力がなかった<面|おも>もちも、患者衣の悲愴なイメージを打ち消すぐらいシャンとしていた。"

#. Occurrence B_7:3683:16243: scene=B_7
#: B_7:3683
msgctxt "text_id=16243 | speaker=unknown"
msgid "  She was raring to fight."
msgstr "　ようするにやる気に満ちあふれているのだ、青子は。"

#. Occurrence B_7:3688:16244: scene=B_7
#: B_7:3688
msgctxt "text_id=16244 | speaker=unknown"
msgid "  It went without saying who her rage was directed at."
msgstr "　それが誰に対して、何に対してかは言うまでもない。"

#. Occurrence B_7:3726:16245: scene=B_7
#: B_7:3726
msgctxt "text_id=16245 | speaker=unknown"
msgid "\"..."
msgstr "「…………"

#. Occurrence B_7:3734:16246: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0033; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:3734
msgctxt "text_id=16246 | speaker=soujuurou"
msgid "Aozaki?\""
msgstr "蒼崎？」"

#. Occurrence B_7:3754:16247: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0097; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3754
msgctxt "text_id=16247 | speaker=aoko"
msgid "\"Hm?\""
msgstr "「ん？」"

#. Occurrence B_7:3760:16248: scene=B_7
#: B_7:3760
msgctxt "text_id=16248 | speaker=unknown"
msgid "  Aoko responded in a vulnerable tone."
msgstr "　草十郎の呼びかけに、青子は無防備な声をあげた。"

#. Occurrence B_7:3765:16249: scene=B_7
#: B_7:3765
msgctxt "text_id=16249 | speaker=unknown"
msgid "  Perhaps she had been taken by surprise."
msgstr "　事実、不意を突いたのだろう。"

#. Occurrence B_7:3770:16250: scene=B_7
#: B_7:3770
msgctxt "text_id=16250 | speaker=unknown"
msgid "  Now she had an objective, she had been lost in her own little world."
msgstr "　目標を定めた彼女は、完全にひとりの世界に入っていたのだから。"

#. Occurrence B_7:3803:16251: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0098; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3803
msgctxt "text_id=16251 | speaker=aoko"
msgid "\"Thanks, Soujyuro.\""
msgstr "「ありがと、草十郎」"

#. Occurrence B_7:3826:16252: scene=B_7
#: B_7:3826
msgctxt "text_id=16252 | speaker=unknown"
msgid "  He expected her to be sarcastic, but this was different."
msgstr "　先ほどの不意打ちの仕返し……なんて<悪戯|いたずら>心からではない。"

#. Occurrence B_7:3831:16253: scene=B_7
#: B_7:3831
msgctxt "text_id=16253 | speaker=unknown"
msgid "  She was genuinely thanking him."
msgstr "　青子はごく自然に感謝を口にした。"

#. Occurrence B_7:3836:16254: scene=B_7
#: B_7:3836
msgctxt "text_id=16254 | speaker=unknown"
msgid "  He had never known her to be like this and was taken aback."
msgstr "　聞きなれない言葉に、草十郎はハト<豆鉄砲|まめでっぽう>状態だ。"

#. Occurrence B_7:3872:16255: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0099; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3872
msgctxt "text_id=16255 | speaker=aoko"
msgid "\"I, um, I'm just showing my appreciation because you helped me figure out where Touko's hideout is."
msgstr "「……あのね。とにかく、橙子の居場所が判ったのはアンタのおかげだから、礼ぐらい言っておこうと思ったの。"

#. Occurrence B_7:3878:16256: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0100; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3878
msgctxt "text_id=16256 | speaker=aoko"
msgid "  Satisfied?\""
msgstr "　それがお気に召さなかった？」"

#. Occurrence B_7:3900:16257: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0034; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:3900
msgctxt "text_id=16257 | speaker=soujuurou"
msgid "\"Sure. It's nice to be thanked, but..."
msgstr "「いや、お礼を言ってもらえるのはいい事だけど。"

#. Occurrence B_7:3906:16258: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0035; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:3906
msgctxt "text_id=16258 | speaker=soujuurou"
msgid "  Are you seriously going after Touko, in that condition?\""
msgstr "　……まさか、その体で橙子さんの所に行くつもりか？」"

#. Occurrence B_7:3912:16259: scene=B_7
#: B_7:3912
msgctxt "text_id=16259 | speaker=unknown"
msgid "  His tone was closer to scolding than sympathetic."
msgstr "　<労|いたわ>りより叱責の色が濃い。"

#. Occurrence B_7:3917:16260: scene=B_7
#: B_7:3917
msgctxt "text_id=16260 | speaker=unknown"
msgid "  Aoko simply nodded resolutely."
msgstr "　そんな問いに、青子は当然とばかりに頷いた。"

#. Occurrence B_7:3965:16261: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0101; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3965
msgctxt "text_id=16261 | speaker=aoko"
msgid "\"I'm just going to take back what's mine, while I still can."
msgstr "「取られた物は取り返すものよ、草十郎。"

#. Occurrence B_7:3971:16262: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0102; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:3971
msgctxt "text_id=16262 | speaker=aoko"
msgid "  My sister won't waste a moment, and neither will I.\""
msgstr "　それもすぐに、相手の物になってしまう前にね。ぐずぐずしている暇はないわ」"

#. Occurrence B_7:3977:16263: scene=B_7
#: B_7:3977
msgctxt "text_id=16263 | speaker=unknown"
msgid "  She sounded unshakeable."
msgstr "　こうして我を言いきる時の青子の気迫には逆らえないものがある。"

#. Occurrence B_7:3982:16264: scene=B_7
#: B_7:3982
msgctxt "text_id=16264 | speaker=unknown"
msgid "  Even so, Soujyuro would not back down."
msgstr "　それでも、草十郎は<頑|がん>として引かなかった。"

#. Occurrence B_7:4003:16265: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0036; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4003
msgctxt "text_id=16265 | speaker=soujuurou"
msgid "\"Even if you've got almost no chance of winning? What you need right now is rest."
msgstr "「勝ち目がなくてもか。暇はないと言うけど、今はそれ以上に休息が必要だろう。"

#. Occurrence B_7:4010:16266: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0037; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4010
msgctxt "text_id=16266 | speaker=soujuurou"
msgid "Yesterday you were really messed up; you still are now. You're lucky to be alive.\""
msgstr "その傷だって、今は見れるけど昨日は酷かったじゃないか。生きていたのが幸運なぐらいだ」"

#. Occurrence B_7:4018:16267: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0103; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4018
msgctxt "text_id=16267 | speaker=aoko"
msgid "\"It's not luck. It's Touko.\""
msgstr "「違うわ。あれは幸運なんかじゃない。そんなタマかっていうのよ、橙子が」"

#. Occurrence B_7:4030:16268: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0038; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4030
msgctxt "text_id=16268 | speaker=soujuurou"
msgid "\"I don't understand.\""
msgstr "「幸運じゃない……？」"

#. Occurrence B_7:4056:16269: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0104; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4056
msgctxt "text_id=16269 | speaker=aoko"
msgid "\"Touko. She purposely kept me alive to taunt me. To make me try again."
msgstr "「そ。橙子はね、私が生き残れる程度の傷にとどめたのよ。今回は見逃してやるから、もう一度やってこいって意味でね。"

#. Occurrence B_7:4062:16270: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0105; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4062
msgctxt "text_id=16270 | speaker=aoko"
msgid "  She's waiting for me so we can settle the score. If she wasn't waiting, she'd have made her move already."
msgstr "　だから私は生きてるんだし、橙子は私が行くのを待ってる。お互いが、お互いの舞台の幕を下ろすために。そうでなければここまで待った意味がないでしょう。"

#. Occurrence B_7:4068:16271: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0106; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4068
msgctxt "text_id=16271 | speaker=aoko"
msgid "  As much as it pains me to, I'm taking your words to heart.\""
msgstr "　……イヤだけど、アンタの言葉を借りるなら、ね」"

#. Occurrence B_7:4111:16272: scene=B_7
#: B_7:4111
msgctxt "text_id=16272 | speaker=unknown"
msgid "  Irritation tainted Aoko's words; from the side she looked terrifyingly serious."
msgstr "　忌ま忌ましげに語る青子の横顔は、鬼気迫るものがあった。"

#. Occurrence B_7:4116:16273: scene=B_7
#: B_7:4116
msgctxt "text_id=16273 | speaker=unknown"
msgid "  She was ready to fight to the death; Touko had given her little choice. Soujyuro could understand neither sister."
msgstr "　草十郎から見れば、殺し合いを良しとする青子も、そうなるように仕向けている橙子も、遠い世界の住人のようだ。"

#. Occurrence B_7:4144:16274: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0039; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4144
msgctxt "text_id=16274 | speaker=soujuurou"
msgid "\"Touko left you alive so she could kill you later?"
msgstr "「……殺すために生かしたっていうのか、橙子さんは。"

#. Occurrence B_7:4150:16275: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0040; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4150
msgctxt "text_id=16275 | speaker=soujuurou"
msgid "  And yet you're still going after her.\""
msgstr "　蒼崎はそれが分かっているのに行こうとしている」"

#. Occurrence B_7:4176:16276: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0107; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4176
msgctxt "text_id=16276 | speaker=aoko"
msgid "\"Exactly. She might have won the battle, but she hasn't won the war."
msgstr "「そうよ。勝負はついたけど、まだ私たちの話は終わっていないもの。"

#. Occurrence B_7:4182:16277: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0108; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4182
msgctxt "text_id=16277 | speaker=aoko"
msgid "  I know I'd have a better chance fully healed, but while I'm recovering, Touko has gotten her claws into Misaki. That means I need to play my trump card."
msgstr "　たしかに全快してから行ったほうがいいに決まってる。けど、そうしている間に橙子は三咲の深部にたどり着く。そうなったら、私の最後の切札さえ使えなくなる。"

#. Occurrence B_7:4203:16278: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0109; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4203
msgctxt "text_id=16278 | speaker=aoko"
msgid "  I have to do what I can while I can.\""
msgstr "　自分にできる事を、自分から無くしてしまうのは―――」"

#. Occurrence B_7:4224:16279: scene=B_7
#: B_7:4224
msgctxt "text_id=16279 | speaker=unknown"
msgid "  Though the pain in her azure eyes was not as deep as the pain of death,"
msgstr "　それは死より深い痛みではないけれど―――"

#. Occurrence B_7:4230:16280: scene=B_7
#: B_7:4230
msgctxt "text_id=16280 | speaker=unknown"
msgid "  it spoke of the regret she would feel if she did not do everything possible while blood still flowed through her veins."
msgstr "　命あるかぎり逃げられない後悔だと、青い瞳が語っていた。"

#. Occurrence B_7:4263:16281: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0041; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4263
msgctxt "text_id=16281 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence B_7:4281:16282: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0110; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4281
msgctxt "text_id=16282 | speaker=aoko"
msgid "\"Understand now? Good. Then don't try and stop me."
msgstr "「納得いったのなら黙ってて。"

#. Occurrence B_7:4287:16283: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0111; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4287
msgctxt "text_id=16283 | speaker=aoko"
msgid "  Listen to me, Soujyuro. You're not responsible for anything. Not my life, and not this fight."
msgstr "　いい、これは私の戦い。アンタには何の責任も関わりもない、私の人生なの。"

#. Occurrence B_7:4293:16284: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0112; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4293
msgctxt "text_id=16284 | speaker=aoko"
msgid "  And I refuse to sit in bed waiting to die. Who'd do that if they felt they could win?\""
msgstr "　座して死を待つなんてまっぴらゴメンよ。勝つ気があるなら、いつまでもベッドで寝てるワケにはいかないでしょう」"

#. Occurrence B_7:4313:16285: scene=B_7
#: B_7:4313
msgctxt "text_id=16285 | speaker=unknown"
msgid "  Soujyuro was dumbstruck."
msgstr "　青子の返答は、草十郎への完全な拒絶だ。"

#. Occurrence B_7:4318:16286: scene=B_7
#: B_7:4318
msgctxt "text_id=16286 | speaker=unknown"
msgid "  Aoko could never let anyone else get involved."
msgstr "　他人の関わる余地はない。"

#. Occurrence B_7:4323:16287: scene=B_7
#: B_7:4323
msgctxt "text_id=16287 | speaker=unknown"
msgid "  Whether that was because she cared or cared less, he could not tell."
msgstr "　それが優しさからくるものなのか、<嘲|あざけ>りからくるものなのか、草十郎には読み取れない。"

#. Occurrence B_7:4342:16288: scene=B_7
#: B_7:4342
msgctxt "text_id=16288 | speaker=unknown"
msgid "  What he did understand, though, was if he wanted to stop her he would have to do so with his bare hands."
msgstr "　分かるのは、彼女を止めたければ、彼女を手にかけるだけの覚悟が必要ということ。"

#. Occurrence B_7:4348:16289: scene=B_7
#: B_7:4348
msgctxt "text_id=16289 | speaker=unknown"
msgid "And he knew better than to try that."
msgstr "その覚悟がないものに、蒼崎青子を批難する事は許されない。"

#. Occurrence B_7:4374:16290: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0042; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4374
msgctxt "text_id=16290 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence B_7:4380:16291: scene=B_7
#: B_7:4380
msgctxt "text_id=16291 | speaker=unknown"
msgid "  Even so, he had to ask one last question."
msgstr "　それでも、もう説得するのは無理だと悟ってしまっても、草十郎は最後の疑問を口にする。"

#. Occurrence B_7:4385:16292: scene=B_7
#: B_7:4385
msgctxt "text_id=16292 | speaker=unknown"
msgid "  If he did not, he would not be able to live with himself after leaving this room."
msgstr "　それを聞かないかぎり、自分は、この部屋を出る事さえできない気がして。"

#. Occurrence B_7:4411:16293: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0043; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4411
msgctxt "text_id=16293 | speaker=soujuurou"
msgid "\"I don't get why you need to go to these lengths."
msgstr "「……分からないな。蒼崎はなんでそこまでするのか、俺には想像もできない。"

#. Occurrence B_7:4418:16294: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0044; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4418
msgctxt "text_id=16294 | speaker=soujuurou"
msgid "Is it out of obligation, or are you just forcing yourself?\""
msgstr "君を縛っているのは義務と強制、どっちなんだろうね」"

#. Occurrence B_7:4424:16295: scene=B_7
#: B_7:4424
msgctxt "text_id=16295 | speaker=unknown"
msgid "  There was a sadness in his eyes."
msgstr "　草十郎の瞳は、どこか悲しい。"

#. Occurrence B_7:4429:16296: scene=B_7
#: B_7:4429
msgctxt "text_id=16296 | speaker=unknown"
msgid "  However, Aoko was unmoved by them."
msgstr "　それを前にしても、青子は表情を崩さなかった。"

#. Occurrence B_7:4467:16297: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0113; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4467
msgctxt "text_id=16297 | speaker=aoko"
msgid "\"It's not like you to ask something so deep."
msgstr "「らしくなく、難しいこと訊いてくるのね。"

#. Occurrence B_7:4473:16298: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0114; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4473
msgctxt "text_id=16298 | speaker=aoko"
msgid "  All right, I'll answer-even though it won't change anything.\""
msgstr "　いいわ、口にしても仕方のない事だけど答えてあげる」"

#. Occurrence B_7:4506:16299: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0115; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4506
msgctxt "text_id=16299 | speaker=aoko"
msgid "\"To be honest, I'm caught between the two."
msgstr "「その二つはね、常に私を圧迫してるものだと思う。"

#. Occurrence B_7:4512:16300: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0116; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4512
msgctxt "text_id=16300 | speaker=aoko"
msgid "  Don't get me wrong, though. Any sense of obligation, compulsion, pride, or fear comes from me and me alone."
msgstr "　けど、勘違いはしないで。義務も強制も、誇りも<畏|おそ>れも、<他人|まわり>から与えられた物じゃない。"

#. Occurrence B_7:4518:16301: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0117; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4518
msgctxt "text_id=16301 | speaker=aoko"
msgid "  My grandfather wouldn't be mad if I stopped fighting Touko; I doubt Alice would complain, either."
msgstr "　橙子と戦うのを止めたところで祖父は私を<叱|しか>らないだろうし、有珠も文句は言わないでしょう。"

#. Occurrence B_7:4524:16302: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0118; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4524
msgctxt "text_id=16302 | speaker=aoko"
msgid "  If I chose to run, nobody would give it a second thought. That's why this is all on me."
msgstr "　ここで逃げても、それはそれで誰にとってもどうでもいい話になって終わるだけ。だから他人は関係ない。"

#. Occurrence B_7:4530:16303: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0119; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4530
msgctxt "text_id=16303 | speaker=aoko"
msgid "  I know it doesn't make a lot of sense.\""
msgstr "　ホントに意味なんてないのよ、何にだって」"

#. Occurrence B_7:4551:16304: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0120; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4551
msgctxt "text_id=16304 | speaker=aoko"
msgid "\"But I won't run away from Touko."
msgstr "「でも私は橙子から逃げたりしない。"

#. Occurrence B_7:4557:16305: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0121; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4557
msgctxt "text_id=16305 | speaker=aoko"
msgid "  All that matters is proving to myself that I'm alive."
msgstr "　これはただの、ここにいるっていう存在証明なの。"

#. Occurrence B_7:4563:16306: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0122; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4563
msgctxt "text_id=16306 | speaker=aoko"
msgid "  I know that my life has no meaning, and that's why I can do anything.\""
msgstr "　私は単に、意味がないからこそ、できる事はぜんぶやるって決めただけなんだから」"

#. Occurrence B_7:4601:16307: scene=B_7
#: B_7:4601
msgctxt "text_id=16307 | speaker=unknown"
msgid "  With fiery passion, Aoko Aozaki had said her piece."
msgstr "　火のような激しさで、蒼崎青子はそう言い切った。"

#. Occurrence B_7:4622:16308: scene=B_7
#: B_7:4622
msgctxt "text_id=16308 | speaker=unknown"
msgid "  Soujyuro was left with a pang in his chest."
msgstr "　―――胸にあるのは、<棘|とげ>のような反発だけ。"

#. Occurrence B_7:4627:16309: scene=B_7
#: B_7:4627
msgctxt "text_id=16309 | speaker=unknown"
msgid "  He did not know why, but her words angered him."
msgstr "　なぜ青子の言葉が苛立たしいのか、草十郎には分からない。"

#. Occurrence B_7:4663:16310: scene=B_7
#: B_7:4663
msgctxt "text_id=16310 | speaker=unknown"
msgid "  Then again, at the same time..."
msgstr "　……ただ、同時に。"

#. Occurrence B_7:4668:16311: scene=B_7
#: B_7:4668
msgctxt "text_id=16311 | speaker=unknown"
msgid "  Her self-confidence had him in wonder."
msgstr "　そこまで自分を律する彼女だからこそ、自分は目を奪われたのだと思い知った。"

#. Occurrence B_7:4674:16312: scene=B_7
#: B_7:4674
msgctxt "text_id=16312 | speaker=unknown"
msgid "  Even though she had said that her life had no meaning."
msgstr "　意味がないと言いながらも。"

#. Occurrence B_7:4679:16313: scene=B_7
#: B_7:4679
msgctxt "text_id=16313 | speaker=unknown"
msgid "  Her stubbornness gave meaning to everything."
msgstr "　その何もかもをに、意味を持たせようとする<頑|かたく>なさに。"

#. Occurrence B_7:4700:16314: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0045; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4700
msgctxt "text_id=16314 | speaker=soujuurou"
msgid "\"So... would that still apply if...\""
msgstr "「……じゃあ、それが、たとえ」"

#. Occurrence B_7:4715:16315: scene=B_7
#: B_7:4715
msgctxt "text_id=16315 | speaker=unknown"
msgid "  Without thinking, he started to ask another question."
msgstr "　知らず、草十郎は問いかけていた。"

#. Occurrence B_7:4720:16316: scene=B_7
#: B_7:4720
msgctxt "text_id=16316 | speaker=unknown"
msgid "  Maybe he wanted to change her mind. Maybe he just wanted to hear her answer."
msgstr "　青子の考えを改めさせる為か、それとも、彼自身がその答えを聞きたかったからか。"

#. Occurrence B_7:4727:16317: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0046; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4727
msgctxt "text_id=16317 | speaker=soujuurou"
msgid "\"...if, say, no one was watching?\""
msgstr "「たとえ、他の誰も、見ていなかったとしても？」"

#. Occurrence B_7:4747:16318: scene=B_7
#: B_7:4747
msgctxt "text_id=16318 | speaker=unknown"
msgid "  It came out as a murmur."
msgstr "　呟くような一言。"

#. Occurrence B_7:4752:16319: scene=B_7
#: B_7:4752
msgctxt "text_id=16319 | speaker=unknown"
msgid "  Indeed, if no one was watching, no one could know that she had fled."
msgstr "　……そう。誰も見ていないのなら、逃げた事は分からない。"

#. Occurrence B_7:4757:16320: scene=B_7
#: B_7:4757
msgctxt "text_id=16320 | speaker=unknown"
msgid "  This was the situation Aoko was in. Even so, she shot him down instantly."
msgstr "　今の青子はそういう状況だ。それでも、彼女はあっさりと否定した。"

#. Occurrence B_7:4791:16321: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0123; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4791
msgctxt "text_id=16321 | speaker=aoko"
msgid "\"Someone's always watching you. Even if it's only yourself.\""
msgstr "「あら、見てるわよ。少なくとも私自身がね」"

#. Occurrence B_7:4810:16322: scene=B_7
#: B_7:4810
msgctxt "text_id=16322 | speaker=unknown"
msgid "  Her expression brightened, possibly because she had been surprised at having to state the obvious."
msgstr "　あんまりに当たり前の事を言わせたからか、青子の表情は不意をつかれたような、どこか明るいものになっていた。"

#. Occurrence B_7:4815:16323: scene=B_7
#: B_7:4815
msgctxt "text_id=16323 | speaker=unknown"
msgid "  Soujyuro was wide-eyed in shock, but Aoko remained nonchalant."
msgstr "　目を見張る草十郎と真逆に、青子はつまらなそうに返答する。"

#. Occurrence B_7:4850:16324: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0124; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4850
msgctxt "text_id=16324 | speaker=aoko"
msgid "\"Haven't you figured it out yet, Soujyuro?"
msgstr "「知らないの草十郎？"

#. Occurrence B_7:4856:16325: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0125; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4856
msgctxt "text_id=16325 | speaker=aoko"
msgid "  Nobody watches you more than you. That's why you have to stay on your toes.\""
msgstr "　生きてく上で一番の観客っていうのはね、他ならぬ自分自身なのよ。だから人生っていうのは油断ならないんじゃない」"

#. Occurrence B_7:4888:16326: scene=B_7
#: B_7:4888
msgctxt "text_id=16326 | speaker=unknown"
msgid "  Soujyuro did not respond to her somewhat exasperated tone, but simply rose to his feet."
msgstr "　呆れて語る青子に、草十郎は何も返さずに立ち上がった。"

#. Occurrence B_7:4893:16327: scene=B_7
#: B_7:4893
msgctxt "text_id=16327 | speaker=unknown"
msgid "  He looked defeated, which was not like him at all."
msgstr "　その姿は敗北者じみた<翳|かげ>があって、実に彼らしくない。"

#. Occurrence B_7:4914:16328: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_7_0126; voice_prefix=A10; voice_category=1; scene=B_7
#: B_7:4914
msgctxt "text_id=16328 | speaker=aoko"
msgid "\"Soujyuro?\""
msgstr "「草十郎？」"

#. Occurrence B_7:4933:16329: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0047; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4933
msgctxt "text_id=16329 | speaker=soujuurou"
msgid "\"...I'm sorry. I know you're saying something really incredible."
msgstr "「……すまない。君が素晴らしいことを言っているのは解るんだ。"

#. Occurrence B_7:4940:16330: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0048; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:4940
msgctxt "text_id=16330 | speaker=soujuurou"
msgid "It's just, I don't understand it.\""
msgstr "けど、俺には分からない」"

#. Occurrence B_7:4973:16331: scene=B_7
#: B_7:4973
msgctxt "text_id=16331 | speaker=unknown"
msgid "  He meekly walked toward the door."
msgstr "　足音も弱く歩いていく。"

#. Occurrence B_7:4978:16332: scene=B_7
#: B_7:4978
msgctxt "text_id=16332 | speaker=unknown"
msgid "  As he placed his hand on the doorknob, he paused."
msgstr "　草十郎は廊下に通じるドアに手を置いて立ち止まった。"

#. Occurrence B_7:4983:16333: scene=B_7
#: B_7:4983
msgctxt "text_id=16333 | speaker=unknown"
msgid "  For a few seconds, he fought with himself, desperately trying to think of something to say."
msgstr "　ほんの数秒の、何度も発言を<躊躇|ためら>わせた、短い葛藤。"

#. Occurrence B_7:5004:16334: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_7_0049; voice_prefix=A30; voice_category=3; scene=B_7
#: B_7:5004
msgctxt "text_id=16334 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence B_7:5012:16335: scene=B_7
#: B_7:5012
msgctxt "text_id=16335 | speaker=unknown"
msgid "  No words came forth. And so he opened the door,"
msgstr "　結局、青子にかける言葉を口にできず、草十郎はドアを開けた。"

#. Occurrence B_7:5037:16336: scene=B_7
#: B_7:5037
msgctxt "text_id=16336 | speaker=unknown"
msgid "  which swung with a strange creak, and he left the room."
msgstr "　ドアは無機質な音をたてて開き、来訪者は部屋を後にする。"

#. Occurrence B_7:5048:16337: scene=B_7
#: B_7:5048
msgctxt "text_id=16337 | speaker=unknown"
msgid "  After watching him go, Aoko turned her gaze toward the window."
msgstr "　彼の背中を無言で見送った後、青子はちらりと窓に視線を投げた。"

#. Occurrence B_7:5053:16338: scene=B_7
#: B_7:5053
msgctxt "text_id=16338 | speaker=unknown"
msgid "  It was nearly evening."
msgstr "　じき夕暮れ。"

#. Occurrence B_7:5058:16339: scene=B_7
#: B_7:5058
msgctxt "text_id=16339 | speaker=unknown"
msgid "  A thin veil of darkness was threatening to descend on the town outside."
msgstr "　外の町並みには、もう薄い闇がかかろうとしていた。"

#. Occurrence B_8:50:16340: scene=B_8
#: B_8:50
msgctxt "text_id=16340 | speaker=unknown"
msgid "  By evening, only Soujyuro remained in the chapel."
msgstr "　夜になって、礼拝堂には草十郎だけが残された。"

#. Occurrence B_8:56:16341: scene=B_8
#: B_8:56
msgctxt "text_id=16341 | speaker=unknown"
msgid "  He sat alone at the end of a pew..."
msgstr "　少年はひとり、長椅子の端に座っている。"

#. Occurrence B_8:61:16342: scene=B_8
#: B_8:61
msgctxt "text_id=16342 | speaker=unknown"
msgid "  ...slouching helplessly like a guilty believer ready to confess."
msgstr "　懺悔する者のように、かたちのない無力感を持て余している。"

#. Occurrence B_8:83:16343: scene=B_8
#: B_8:83
msgctxt "text_id=16343 | speaker=unknown"
msgid "  The chilly air seeped through the walls,"
msgstr "　寒気の<蔦|つた>が壁を伝う。"

#. Occurrence B_8:88:16344: scene=B_8
#: B_8:88
msgctxt "text_id=16344 | speaker=unknown"
msgid "  turning breath to mist."
msgstr "　暖の無い礼拝堂では、はき出される呼吸は魂のように白い。"

#. Occurrence B_8:93:16345: scene=B_8
#: B_8:93
msgctxt "text_id=16345 | speaker=unknown"
msgid "  The frigid air stole the heat from the body without mercy."
msgstr "　冷気は容赦なく体から熱を奪っていく。"

#. Occurrence B_8:98:16346: scene=B_8
#: B_8:98
msgctxt "text_id=16346 | speaker=unknown"
msgid "  Soujyuro looked around at the chapel's tall ceiling and spacious hall; the room made the air feel colder somehow."
msgstr "　礼拝堂の高い天井が、広い講堂が、冬の寒さを一層増しているようにしか、草十郎には思えなかった。"

#. Occurrence B_8:131:16347: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0000; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:131
msgctxt "text_id=16347 | speaker=soujuurou"
msgid "\"...\""
msgstr "「………………………………」"

#. Occurrence B_8:137:16348: scene=B_8
#: B_8:137
msgctxt "text_id=16348 | speaker=unknown"
msgid "  Unsure of what to do with himself, he stared into space."
msgstr "　やり場のない感情を持て余して、彼は力なく天井を見つめている。"

#. Occurrence B_8:142:16349: scene=B_8
#: B_8:142
msgctxt "text_id=16349 | speaker=unknown"
msgid "  His thoughts were entirely unfocused."
msgstr "　思考はまったく定まらない。"

#. Occurrence B_8:147:16350: scene=B_8
#: B_8:147
msgctxt "text_id=16350 | speaker=unknown"
msgid "  First and foremost, he could not understand what the buzzing sensation was in his chest."
msgstr "　胸のざわつきが何であるのか、まずそれが分からない。"

#. Occurrence B_8:171:16351: scene=B_8
#: B_8:171
msgctxt "text_id=16351 | speaker=unknown"
msgid "  Time passed by; no answers came."
msgstr "　答えのないまま時間だけが過ぎていく。"

#. Occurrence B_8:176:16352: scene=B_8
#: B_8:176
msgctxt "text_id=16352 | speaker=unknown"
msgid "  To onlookers, he must have seemed deep in thought, or in a deep sleep, like he would turn to stone if left be. Either way, he clearly looked down."
msgstr "　その様は何かを思案しているようにも取れるし、眠っているようにも取れる。放っておけば石にでも成りかねない、見るも無惨な意気消沈。"

#. Occurrence B_8:181:16353: scene=B_8
#: B_8:181
msgctxt "text_id=16353 | speaker=unknown"
msgid "  The problem was his lack of awareness-not that he was aware of it, of course."
msgstr "　問題は、それを彼自身、まったく自覚していない事だ。"

#. Occurrence B_8:202:16354: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0000; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:202
msgctxt "text_id=16354 | speaker=eiri"
msgid "\"Worshipping at this hour? You're quite the devotee.\""
msgstr "「おや。夜間の礼拝とは感心です」"

#. Occurrence B_8:242:16355: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0001; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:242
msgctxt "text_id=16355 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence B_8:247:16356: scene=B_8
#: B_8:247
msgctxt "text_id=16356 | speaker=unknown"
msgid "  Soujyuro raised his head, and turned to where the voice had come from."
msgstr "　突然の声に顔をあげる。"

#. Occurrence B_8:252:16357: scene=B_8
#: B_8:252
msgctxt "text_id=16357 | speaker=unknown"
msgid "  Stood before the altar was the man from last night, dressed in priestly garbs. How long had he been standing there?"
msgstr "　……いつからそこにいたのか、祭壇の前には昨夜見た神父服の男が立っていた。"

#. Occurrence B_8:277:16358: scene=B_8
#: B_8:277
msgctxt "text_id=16358 | speaker=unknown"
msgid "  Sound reverberated dryly throughout the chapel hall."
msgstr "　乾いた音が礼拝堂に<木霊|こだま>する。"

#. Occurrence B_8:282:16359: scene=B_8
#: B_8:282
msgctxt "text_id=16359 | speaker=unknown"
msgid "  Soujyuro did not have the strength to stand, let alone leave. He just stared at the approaching shadow."
msgstr "　いまさら立ち去るのも、そもそも立ち上がる気力もない草十郎は、歩み寄る影を見届けるしかない。"

#. Occurrence B_8:303:16360: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0001; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:303
msgctxt "text_id=16360 | speaker=eiri"
msgid "\"Though, you'll not find the Holy Spirit in this church."
msgstr "「もっとも、この教会に聖霊なんていませんけどね。"

#. Occurrence B_8:309:16361: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0002; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:309
msgctxt "text_id=16361 | speaker=eiri"
msgid "  Do you mind if I sit?\""
msgstr "　ここ、座りますがよろしいですか？」"

#. Occurrence B_8:327:16362: scene=B_8
#: B_8:327
msgctxt "text_id=16362 | speaker=unknown"
msgid "  The priest pointed at Soujyuro's pew."
msgstr "　神父は草十郎と同じ長椅子を指さした。"

#. Occurrence B_8:332:16363: scene=B_8
#: B_8:332
msgctxt "text_id=16363 | speaker=unknown"
msgid "  Without waiting for an answer, he took a seat at the opposite end."
msgstr "　草十郎とは逆位置の<端|はじ>っこに、返事を待たず腰をかける。"

#. Occurrence B_8:371:16364: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0003; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:371
msgctxt "text_id=16364 | speaker=eiri"
msgid "\"I never formally introduced myself. I'm Eiri Fumidsuka, this church's... hmmm... 'owner' you could say-on paper, at least. Call me Father Eiri."
msgstr "「改めて挨拶を。私は<文柄|ふみづか><詠梨|えいり>、この教会の……なんなんでしょうかね、書類の上では持ち主になるんでしょうか。詠梨神父と呼んでください。"

#. Occurrence B_8:382:16365: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0004; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:382
msgctxt "text_id=16365 | speaker=eiri"
msgid "  You must be Soujyuro Sizuki, yes? I can see why Yuika didn't notice you.\""
msgstr "　貴方は静希草十郎君ですか。なるほど、たしかに唯架には見えない」"

#. Occurrence B_8:402:16366: scene=B_8
#: B_8:402
msgctxt "text_id=16366 | speaker=unknown"
msgid "  Father Eiri spoke in a gentle, but uninvested tone."
msgstr "　穏やかな口調だが、神父の声には白々しいほど感情がこもっていない。"

#. Occurrence B_8:407:16367: scene=B_8
#: B_8:407
msgctxt "text_id=16367 | speaker=unknown"
msgid "  He was a thorough egoist."
msgstr "　徹底した利<己主義|エゴイスト>者。"

#. Occurrence B_8:434:16368: scene=B_8
#: B_8:434
msgctxt "text_id=16368 | speaker=unknown"
msgid "  Soujyuro knew all too well about people who spoke this way."
msgstr "　こういう声をする人間を、草十郎はよく知っている。"

#. Occurrence B_8:439:16369: scene=B_8
#: B_8:439
msgctxt "text_id=16369 | speaker=unknown"
msgid "  The individual who cared for him when he first came down from the mountain was one of them."
msgstr "　山から下りる際、彼の世話をしてくれた恩人がこういった<感|こ><情|え>をだす人物だった。"

#. Occurrence B_8:460:16370: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0002; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:460
msgctxt "text_id=16370 | speaker=soujuurou"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence B_8:465:16371: scene=B_8
#: B_8:465
msgctxt "text_id=16371 | speaker=unknown"
msgid "  Soujyuro glanced across at him apathetically."
msgstr "　座ったまま、草十郎は無関心に神父を一瞥する。"

#. Occurrence B_8:470:16372: scene=B_8
#: B_8:470
msgctxt "text_id=16372 | speaker=unknown"
msgid "  Father Eiri seemed unfazed by the lack of direction to the conversation."
msgstr "　心ここにあらず、といった状態だが、詠梨は気にしていないようだ。"

#. Occurrence B_8:514:16373: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0005; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:514
msgctxt "text_id=16373 | speaker=eiri"
msgid "\"I was wondering if I could speak with you for a moment.\""
msgstr "「少し君と話がしたいのですが、よろしいでしょうか？」"

#. Occurrence B_8:519:16374: scene=B_8
#: B_8:519
msgctxt "text_id=16374 | speaker=unknown"
msgid "  Soujyuro responded with a nod."
msgstr "　草十郎はうなずきで答えた。"

#. Occurrence B_8:524:16375: scene=B_8
#: B_8:524
msgctxt "text_id=16375 | speaker=unknown"
msgid "  Father Eiri replied with an artificial smile."
msgstr "　それは良かった、と作り物めいた笑みの神父。"

#. Occurrence B_8:545:16376: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0006; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:545
msgctxt "text_id=16376 | speaker=eiri"
msgid "\"You seem terribly worried about Aoko.\""
msgstr "「青子が心配のようですね」"

#. Occurrence B_8:551:16377: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0003; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:551
msgctxt "text_id=16377 | speaker=soujuurou"
msgid "\"Not really. Ritsuka said the same thing to me, but that's not it.\""
msgstr "「別に。律架さんにもそう聞かれましたけど、蒼崎の心配はしていないんです」"

#. Occurrence B_8:557:16378: scene=B_8
#: B_8:557
msgctxt "text_id=16378 | speaker=unknown"
msgid "  Soujyuro stared straight ahead as he answered,"
msgstr "　神父を見ずに、前を向いたまま草十郎は返す。"

#. Occurrence B_8:562:16379: scene=B_8
#: B_8:562
msgctxt "text_id=16379 | speaker=unknown"
msgid "  his voice sounding uncharacteristically weak and unsure."
msgstr "　迷いに満ちた、彼らしからぬ弱々しい声で。"

#. Occurrence B_8:608:16380: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0004; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:608
msgctxt "text_id=16380 | speaker=soujuurou"
msgid "\"She's been on my mind a lot, and I don't know why. I'm trying to figure that out.\""
msgstr "「けど、今はずっと彼女の事が気にかかっている。それが何だか分からなくて、さっきから考えてる最中です」"

#. Occurrence B_8:630:16381: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0007; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:630
msgctxt "text_id=16381 | speaker=eiri"
msgid "\"The answer's simple: you envy her.\""
msgstr "「簡単ですよ。君は単に、青子に嫉妬しているのです」"

#. Occurrence B_8:656:16382: scene=B_8
#: B_8:656
msgctxt "text_id=16382 | speaker=unknown"
msgid "  With those few words, Soujyuro snapped out of his funk."
msgstr "　あれだけ元気のなかった少年の顔が、その一言で蘇った。"

#. Occurrence B_8:661:16383: scene=B_8
#: B_8:661
msgctxt "text_id=16383 | speaker=unknown"
msgid "  He clapped his hands, and turned toward the priest."
msgstr "　草十郎は水を得た魚のように、ぽん、と両手を打って神父に顔を向ける。"

#. Occurrence B_8:689:16384: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0005; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:689
msgctxt "text_id=16384 | speaker=soujuurou"
msgid "\"I see. So I just envy her."
msgstr "「そっか。俺はたんに、蒼崎が<羨|うらや>ましかっただけなんだ。"

#. Occurrence B_8:702:16385: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0006; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:702
msgctxt "text_id=16385 | speaker=soujuurou"
msgid "  ...Wait a second. That can't be good."
msgstr "　―――いや、でも、それは困るな。"

#. Occurrence B_8:709:16386: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0007; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:709
msgctxt "text_id=16386 | speaker=soujuurou"
msgid "I didn't know I could feel that way.\""
msgstr "自分の中に、そういうところがあるなんて、気づきもしなかった」"

#. Occurrence B_8:715:16387: scene=B_8
#: B_8:715
msgctxt "text_id=16387 | speaker=unknown"
msgid "  Father Eiri did not respond to his confession-like ramblings."
msgstr "　懺悔のような呟きに、神父は何も返さない。"

#. Occurrence B_8:743:16388: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0008; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:743
msgctxt "text_id=16388 | speaker=soujuurou"
msgid "\"So, what did you want to talk to me about?\""
msgstr "「それで、話っていうのはなんですか？」"

#. Occurrence B_8:773:16389: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0008; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:773
msgctxt "text_id=16389 | speaker=eiri"
msgid "\"Well, it's more of a question I'd like to ask, really."
msgstr "「いえ、話というより質問です。"

#. Occurrence B_8:779:16390: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0009; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:779
msgctxt "text_id=16390 | speaker=eiri"
msgid "  I heard you lived deep in the mountains until recently. Something strikes me as curious.\""
msgstr "　君は今まで山奥に住んでいたと聞きました。そこで一つ、どうしても気になる事があって」"

#. Occurrence B_8:785:16391: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0009; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:785
msgctxt "text_id=16391 | speaker=soujuurou"
msgid "\"Really? What?\""
msgstr "「気になる事、ですか？」"

#. Occurrence B_8:806:16392: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0010; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:806
msgctxt "text_id=16392 | speaker=eiri"
msgid "\"Well, I doubt anyone has asked you this before."
msgstr "「はい。おそらく、今まで誰も貴方にこの手の質問をしなかったのでしょう。"

#. Occurrence B_8:813:16393: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0011; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:813
msgctxt "text_id=16393 | speaker=eiri"
msgid "No doubt, because you don't unnerve the people around you. I admit, I feel the same way, talking to you."
msgstr "それは貴方が、他人にその手の不安を感じさせないからです。実際私もそう思いますし。"

#. Occurrence B_8:825:16394: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0012; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:825
msgctxt "text_id=16394 | speaker=eiri"
msgid "  Maybe it's opportunity presenting itself, or my sense of obligation as a man of the cloth, but when I see a lost lamb, I feel a need to guide it.\""
msgstr "　ですから、まあ。これも縁ですし、私も肩書きが<神父|コレ>ですしねぇ。迷える子羊がいるんですから、それなりの<勤|つと>めをはたさないと後ろめたいというか」"

#. Occurrence B_8:864:16395: scene=B_8
#: B_8:864
msgctxt "text_id=16395 | speaker=unknown"
msgid "  Father Eiri looked at Soujyuro placidly;"
msgstr "　そうして、神父は穏やかな瞳を草十郎へ向けた。"

#. Occurrence B_8:869:16396: scene=B_8
#: B_8:869
msgctxt "text_id=16396 | speaker=unknown"
msgid "  his pupils were like black holes that could suck the soul out of your body."
msgstr "　容赦なく暗い、罪を<暴|あば>くような瞳を。"

#. Occurrence B_8:907:16397: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0010; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:907
msgctxt "text_id=16397 | speaker=soujuurou"
msgid "\"I'm not sure what you're talking about."
msgstr "「おかしなコトが気になるんですね。"

#. Occurrence B_8:913:16398: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0011; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:913
msgctxt "text_id=16398 | speaker=soujuurou"
msgid "  ...What's your question exactly?\""
msgstr "　……その、質問というのは？」"

#. Occurrence B_8:934:16399: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0013; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:934
msgctxt "text_id=16399 | speaker=eiri"
msgid "\"Oh, don't worry. It's nothing unusual."
msgstr "「いえ、ごく自然の疑問ですよ。"

#. Occurrence B_8:940:16400: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0014; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:940
msgctxt "text_id=16400 | speaker=eiri"
msgid "  Simply, why did you come down here? You seem like you'd be happier back home.\""
msgstr "　貴方はなぜ山から下りてきたのか。そこでなら君は幸福だったでしょうに」"

#. Occurrence B_8:967:16401: scene=B_8
#: B_8:967
msgctxt "text_id=16401 | speaker=unknown"
msgid "  Soujyuro was not sure what he had done, but it sounded as though the priest was accusing him of something."
msgstr "　罪状こそ確かではないが、それは確かに告発だった。"

#. Occurrence B_8:972:16402: scene=B_8
#: B_8:972
msgctxt "text_id=16402 | speaker=unknown"
msgid "  Then again, it was a reasonable question, if a little pointless."
msgstr "　遅すぎたといえば遅すぎ、当然と言えば当然の質問。"

#. Occurrence B_8:993:16403: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0012; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:993
msgctxt "text_id=16403 | speaker=soujuurou"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence B_8:998:16404: scene=B_8
#: B_8:998
msgctxt "text_id=16404 | speaker=unknown"
msgid "  Soujyuro had no answer."
msgstr "　草十郎に返答はない。"

#. Occurrence B_8:1003:16405: scene=B_8
#: B_8:1003
msgctxt "text_id=16405 | speaker=unknown"
msgid "  Father Eiri ignored the sullen boy and continued."
msgstr "　苦虫をかみつぶす少年を無視して神父は続ける。"

#. Occurrence B_8:1025:16406: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0015; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1025
msgctxt "text_id=16406 | speaker=eiri"
msgid "\"I'm somewhat aware of the challenges a life in the mountains might bring. I experienced it firsthand when I made a small mistake in my youth."
msgstr "「山での生活がいかに厳しいものかは、私も人並みには知っています。若い頃、ちょっとした手違いで遭難した事もありますしね。"

#. Occurrence B_8:1031:16407: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0016; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1031
msgctxt "text_id=16407 | speaker=eiri"
msgid "  Life in the mountains is incredibly simple: your time is dedicated to survival. You don't live for joy, but rather to stay alive. It makes a minimalist lifestyle seem full of excess.\""
msgstr "　山での生活はこの上なく簡素です。なにしろ生きること以外に時間をさく余裕がない。愉しむ為に生きるのではなく、生きる為にただ生きる。生活は必要最小限を、さらに切り詰めたものとなっていく」"

#. Occurrence B_8:1069:16408: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0017; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1069
msgctxt "text_id=16408 | speaker=eiri"
msgid "\"Compared to that, city life should be nothing short of paradise."
msgstr "「山での生活に比べれば、都市の在り方は楽園以外の何物でもないでしょう。"

#. Occurrence B_8:1075:16409: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0018; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1075
msgctxt "text_id=16409 | speaker=eiri"
msgid "  However, paradise means something different to everyone.\""
msgstr "　ですが。楽園の定義は、人それぞれです」"

#. Occurrence B_8:1081:16410: scene=B_8
#: B_8:1081
msgctxt "text_id=16410 | speaker=unknown"
msgid "  Soujyuro still did not answer; his expression remained blank."
msgstr "　草十郎は答えない。表情も何も語らない。"

#. Occurrence B_8:1086:16411: scene=B_8
#: B_8:1086
msgctxt "text_id=16411 | speaker=unknown"
msgid "  The only sound was the priest's voice echoing around the chapel."
msgstr "　ただ、神父の声だけが礼拝堂に<木霊|こだま>する。"

#. Occurrence B_8:1119:16412: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0019; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1119
msgctxt "text_id=16412 | speaker=eiri"
msgid "\"A life where even a single seed could bring joy..."
msgstr "「一粒の種の誕生すら喜びになる生活。"

#. Occurrence B_8:1125:16413: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0020; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1125
msgctxt "text_id=16413 | speaker=eiri"
msgid "  No matter the warmth the light of electricity brings, I expect you respect the bitter cold of nature more."
msgstr "　電気の明かりがどれだけ暖かでも、自然のままの厳しい寒さを君は<尊|とうと>んでいた筈です。"

#. Occurrence B_8:1146:16414: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0021; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1146
msgctxt "text_id=16414 | speaker=eiri"
msgid "  So tell me, why come here when you'd be happier in the mountains?\""
msgstr "　なのになぜ、下りてきたのですか。山にいれば、君は<倖|しあわ>せだったでしょうに」"

#. Occurrence B_8:1166:16415: scene=B_8
#: B_8:1166
msgctxt "text_id=16415 | speaker=unknown"
msgid "  Father Eiri repeated his question."
msgstr "　神父の問いが、もう一度繰り返される。"

#. Occurrence B_8:1171:16416: scene=B_8
#: B_8:1171
msgctxt "text_id=16416 | speaker=unknown"
msgid "  Soujyuro's mouth remained firmly shut."
msgstr "　草十郎は堅く口を閉ざしている。"

#. Occurrence B_8:1181:16417: scene=B_8
#: B_8:1181
msgctxt "text_id=16417 | speaker=unknown"
msgid "  Not because he did not want to answer, but because he simply did not know how to."
msgstr "　それは答えたくないのではなく、彼自身、どうしてそうなったのか未だ分からないからだ。"

#. Occurrence B_8:1204:16418: scene=B_8
#: B_8:1204
msgctxt "text_id=16418 | speaker=unknown"
msgid "  All he knew was even if he wanted to go back, he could not."
msgstr "　……確かな事は、帰りたくとも、もう帰ってはいけないという事実だけ。"

#. Occurrence B_8:1225:16419: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0022; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1225
msgctxt "text_id=16419 | speaker=eiri"
msgid "\"My son. Salvation will not be forthcoming to those who choose to ignore its calling."
msgstr "「困ったものです。そこをはっきりさせない事には、いつまでも救いがない。"

#. Occurrence B_8:1243:16420: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0023; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1243
msgctxt "text_id=16420 | speaker=eiri"
msgid "  If you don't know why you left, you won't be able to love where you arrived."
msgstr "　故郷を捨てた理由も分からないのに、旅先の土地を愛するコトなんて、まっとうな人間にはできませんよ。"

#. Occurrence B_8:1249:16421: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0024; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1249
msgctxt "text_id=16421 | speaker=eiri"
msgid "  A word of advice: happiness doesn't come from the unquestionable acceptance of everything."
msgstr "　これは忠告ですが。すべてを無条件に肯定したところで、幸福になれるとはかぎりません。"

#. Occurrence B_8:1255:16422: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0025; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1255
msgctxt "text_id=16422 | speaker=eiri"
msgid "  Be fairer to yourself.\""
msgstr "　貴方はもう少し、自分の心を許してあげないと」"

#. Occurrence B_8:1296:16423: scene=B_8
#: B_8:1296
msgctxt "text_id=16423 | speaker=unknown"
msgid "  Soujyuro could not make sense of what he was being told."
msgstr "　草十郎には、神父の言葉はまったく理解できない。"

#. Occurrence B_8:1301:16424: scene=B_8
#: B_8:1301
msgctxt "text_id=16424 | speaker=unknown"
msgid "  Only the father's last words made any impression on him."
msgstr "　ただ、最後の言葉だけは印象的だった。"

#. Occurrence B_8:1333:16425: scene=B_8
#: B_8:1333
msgctxt "text_id=16425 | speaker=unknown"
msgid "  Being fairer to yourself is easier said than done, of course."
msgstr "　自分の心を許せ、と言うけど。"

#. Occurrence B_8:1339:16426: scene=B_8
#: B_8:1339
msgctxt "text_id=16426 | speaker=unknown"
msgid "  And what that entailed, Soujyuro was uncertain of."
msgstr "　彼には、その心のカタチがよく分からない。"

#. Occurrence B_8:1368:16427: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0013; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:1368
msgctxt "text_id=16427 | speaker=soujuurou"
msgid "\"Actually, that makes sense...\""
msgstr "「ああ、そう言えば―――」"

#. Occurrence B_8:1374:16428: scene=B_8
#: B_8:1374
msgctxt "text_id=16428 | speaker=unknown"
msgid "  Touko had mentioned something similar before, and it had impressed him."
msgstr "　同じような事を、蒼崎橙子も口にしていた。"

#. Occurrence B_8:1379:16429: scene=B_8
#: B_8:1379
msgctxt "text_id=16429 | speaker=unknown"
msgid "  First her, now this priest. How could people know things he hadn't even told them?"
msgstr "　橙子といい、この神父といい、口にしてもいない事をよく言い当てられるものだな、と草十郎は感心する。"

#. Occurrence B_8:1425:16430: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0014; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:1425
msgctxt "text_id=16430 | speaker=soujuurou"
msgid "\"...Wow. Are all priests like you?\""
msgstr "「……すごいですね。神父さんっていうのは、みんなそうなんですか」"

#. Occurrence B_8:1431:16431: scene=B_8
#: B_8:1431
msgctxt "text_id=16431 | speaker=unknown"
msgid "  Soujyuro said, curious as to where the weight on his shoulders had gone to."
msgstr "　さっきまでの暗さはどこへいったのか、不思議そうに草十郎は言った。"

#. Occurrence B_8:1436:16432: scene=B_8
#: B_8:1436
msgctxt "text_id=16432 | speaker=unknown"
msgid "  In a way, one of his strong points is the fact that his emotional scars do not show on the surface."
msgstr "　心の傷が表に<顕|あらわ>れない、ある意味、鉄の心臓がこの少年の特徴である。"

#. Occurrence B_8:1473:16433: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0026; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1473
msgctxt "text_id=16433 | speaker=eiri"
msgid "\"Indeed. A priest is obliged to shine a light on troubled hearts."
msgstr "「ええ。神父は悩みを<暴|あば>くのが仕事ですから。"

#. Occurrence B_8:1480:16434: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0027; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1480
msgctxt "text_id=16434 | speaker=eiri"
msgid "Though, of course, that's not always enough.\""
msgstr "ま、たいていは暴くだけで埋めるのに失敗するんですけどね」"

#. Occurrence B_8:1501:16435: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0015; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:1501
msgctxt "text_id=16435 | speaker=soujuurou"
msgid "\"By 'shine a light,' do you mean 'talk things over'?\""
msgstr "「……。悩みを暴くって、つまり相談事ですか？」"

#. Occurrence B_8:1520:16436: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0028; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1520
msgctxt "text_id=16436 | speaker=eiri"
msgid "\"Yes. To a certain extent at least. The only problems I can solve are mostly small.\""
msgstr "「そういうソフトなのも<承|うけたまわ>っています。私が解決できる悩みなど、タカが知れているようですけど」"

#. Occurrence B_8:1546:16437: scene=B_8
#: B_8:1546
msgctxt "text_id=16437 | speaker=unknown"
msgid "  The priest shrugged, looking a little disconcerted."
msgstr "　神父は困ったように肩をすくめる。"

#. Occurrence B_8:1551:16438: scene=B_8
#: B_8:1551
msgctxt "text_id=16438 | speaker=unknown"
msgid "  Granted Soujyuro still did not trust Father Eiri at all, but at that moment anyone was ray of light in his eyes."
msgstr "　信用できないコトこの上ないが、今の草十郎には誰であろうと後光が差して見えるのだった。"

#. Occurrence B_8:1586:16439: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0016; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:1586
msgctxt "text_id=16439 | speaker=soujuurou"
msgid "\"Um, do you mind helping me with another small problem?\""
msgstr "「あの。じゃあ、タカが知れた程度の悩みを聞いてもらえますか」"

#. Occurrence B_8:1605:16440: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0029; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1605
msgctxt "text_id=16440 | speaker=eiri"
msgid "\"You want to know why you're envious of Aoko, correct?\""
msgstr "「君が青子をなぜ<羨|うらや>むか、ですね」"

#. Occurrence B_8:1611:16441: scene=B_8
#: B_8:1611
msgctxt "text_id=16441 | speaker=unknown"
msgid "  It was as though the priest could see into the boy's soul with his serene eyes."
msgstr "　人の心でも読めるのか、神父は穏やかな眼差しのまま草十郎の台詞を先読みする。"

#. Occurrence B_8:1652:16442: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0017; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:1652
msgctxt "text_id=16442 | speaker=soujuurou"
msgid "\"Well... yeah."
msgstr "「えっと……まあ、そういう事です。"

#. Occurrence B_8:1659:16443: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0018_0; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:1659
msgctxt "text_id=16443 | speaker=soujuurou"
msgid "  I don't even know why I feel this way myself."
msgstr "　自分でも、どうしてそう思うのかが分からない。"

#. Occurrence B_8:1672:16444: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0018_1; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:1672
msgctxt "text_id=16444 | speaker=soujuurou"
msgid " But you seem to.\""
msgstr "でも貴方なら、それを知ってそうだ」"

#. Occurrence B_8:1709:16445: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0030; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1709
msgctxt "text_id=16445 | speaker=eiri"
msgid "\"I don't. I can simply guess, not being the one to shoulder the burden."
msgstr "「知りませんけど、まあ、無責任に答えましょうか。"

#. Occurrence B_8:1715:16446: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0031; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1715
msgctxt "text_id=16446 | speaker=eiri"
msgid "  Your envy may come from your lack of a foundation."
msgstr "　それはおそらく、貴方には根拠がないからですよ。"

#. Occurrence B_8:1722:16447: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0032; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1722
msgctxt "text_id=16447 | speaker=eiri"
msgid "Or, more accurately, your lack of a color of your own.\""
msgstr "自分の色がない、と喩えた方が正確ですが」"

#. Occurrence B_8:1742:16448: scene=B_8
#: B_8:1742
msgctxt "text_id=16448 | speaker=unknown"
msgid "  Soujyuro squinted, trying to understand the priest's complicated yet concise answer."
msgstr "　すっぱりと答える詠梨神父に、草十郎は難解そうに目を細めた。色がない、とはどういう意味なのだろう、と。"

#. Occurrence B_8:1768:16449: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0033; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1768
msgctxt "text_id=16449 | speaker=eiri"
msgid "\"This is what I'm talking about. You are extraordinarily flexible."
msgstr "「ほら、そこです。君に<勝|すぐ>れた部分があるとしたら、その順応性です。"

#. Occurrence B_8:1774:16450: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0034; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1774
msgctxt "text_id=16450 | speaker=eiri"
msgid "  You learned to live alone in a city after coming down from the mountains."
msgstr "　山という異界から町に下りて、一人で暮らしていけた事。"

#. Occurrence B_8:1780:16451: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0035; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1780
msgctxt "text_id=16451 | speaker=eiri"
msgid "  And then, once you'd gotten used to that, you started living with Aoko and Alice in a very different world."
msgstr "　ようやく慣れた常識の中で、青子たちという非常識と関わっても暮らしていけた事。"

#. Occurrence B_8:1787:16452: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0036; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1787
msgctxt "text_id=16452 | speaker=eiri"
msgid "I don't know if you consciously try to adapt, but regardless, your ability to do so is astonishing."
msgstr "……そうであれと努めているにしても、貴方の順応性は<際|きわ>だっている。"

#. Occurrence B_8:1793:16453: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0037; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1793
msgctxt "text_id=16453 | speaker=eiri"
msgid "  Also, I don't know why, but you do not appear to exhibit signs of a regular ego.\""
msgstr "　原因は知りませんが、君には初めから、自我というものが第一に表れてはいないのです」"

#. Occurrence B_8:1819:16454: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0038; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1819
msgctxt "text_id=16454 | speaker=eiri"
msgid "\"You can respond to anything, but aren't influenced by it."
msgstr "「何事にも対応できるものの、<朱|しゅ>に<交|まじ>わるほど器用でもない。"

#. Occurrence B_8:1825:16455: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0039; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1825
msgctxt "text_id=16455 | speaker=eiri"
msgid "  To be frank, you're a blank canvas that stays blank."
msgstr "　しいて言うのなら、色の乗っていない空白ですかね。"

#. Occurrence B_8:1831:16456: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0040; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1831
msgctxt "text_id=16456 | speaker=eiri"
msgid "  While blending in to your surroundings is a wonderful thing, no sense of self means having no place to call home."
msgstr "　風景に溶けこむ自然さは素晴らしい人徳ですが、自我がないという事は、居場所がないという事ですから。"

#. Occurrence B_8:1837:16457: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0041; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1837
msgctxt "text_id=16457 | speaker=eiri"
msgid "  Your talent is a double-edged sword.\""
msgstr "　いいコトばかりじゃありません」"

#. Occurrence B_8:1879:16458: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0042; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1879
msgctxt "text_id=16458 | speaker=eiri"
msgid "\"The fact Yuika didn't see you was unexpected."
msgstr "「唯架にまで見えない、というのは予想以上でしたが。"

#. Occurrence B_8:1885:16459: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0043; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1885
msgctxt "text_id=16459 | speaker=eiri"
msgid "  She can perceive even incorporeal elemental spirits, and yet not you. That says a lot about your lack of greed.\""
msgstr "　姿なき精霊すら捉えるアレが見えなかったのですから、君の無欲ぶりも筋金入りだ」"

#. Occurrence B_8:1932:16460: scene=B_8
#: B_8:1932
msgctxt "text_id=16460 | speaker=unknown"
msgid "  As if amused by something, Father Eiri grinned."
msgstr "　なにが嬉しいのか、微笑みながら神父はそう告げた。"

#. Occurrence B_8:1937:16461: scene=B_8
#: B_8:1937
msgctxt "text_id=16461 | speaker=unknown"
msgid "  However, Soujyuro understood neither the meaning of his smile nor his words."
msgstr "　草十郎には彼の言いたい事も、その笑顔の意味もさっぱり分からない。"

#. Occurrence B_8:1986:16462: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0044; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1986
msgctxt "text_id=16462 | speaker=eiri"
msgid "\"This is mere speculation, but I believe Aoko feels resentment when she looks at you."
msgstr "「憶測にすぎませんが、青子は貴方を見て反感を覚えたと思いますよ。"

#. Occurrence B_8:1992:16463: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0045; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1992
msgctxt "text_id=16463 | speaker=eiri"
msgid "  To a brazen soul like her, your lack of self is something she simply cannot accept."
msgstr "　自分のない貴方は、自己を押し通してきた彼女にとって認めがたいものだったでしょうから。"

#. Occurrence B_8:1998:16464: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0046; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:1998
msgctxt "text_id=16464 | speaker=eiri"
msgid "  And yet, you see something in Aoko you could never attain.\""
msgstr "　そして同時に、貴方は青子に、自分ではどうしても手に入れられないものを見てしまった」"

#. Occurrence B_8:2037:16465: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0047; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2037
msgctxt "text_id=16465 | speaker=eiri"
msgid "\"It feels crude to put such things into words, but it is what it is."
msgstr "「言葉にすると下らない表現になりますが、そういう事です。"

#. Occurrence B_8:2043:16466: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0048; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2043
msgctxt "text_id=16466 | speaker=eiri"
msgid "  A moment ago, I said you envied Aoko, but that's not quite true."
msgstr "　先程は嫉妬と言いましたが、それは訂正しましょう。"

#. Occurrence B_8:2049:16467: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0049; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2049
msgctxt "text_id=16467 | speaker=eiri"
msgid "  In fact, you... No. Never mind."
msgstr "　君は青子に―――いや、いいです。"

#. Occurrence B_8:2056:16468: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0050; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2056
msgctxt "text_id=16468 | speaker=eiri"
msgid "Some things are best left unsaid.\""
msgstr "言葉にするのは、それこそ<野|や><暮|ぼ>だ」"

#. Occurrence B_8:2088:16469: scene=B_8
#: B_8:2088
msgctxt "text_id=16469 | speaker=unknown"
msgid "  Father Eiri smiled gently."
msgstr "　柔らかに神父は笑った。"

#. Occurrence B_8:2093:16470: scene=B_8
#: B_8:2093
msgctxt "text_id=16470 | speaker=unknown"
msgid "  It was a fresh-faced grin that belied his age."
msgstr "　それは詠梨本来の年齢を思わせる、若々しい笑みだった。"

#. Occurrence B_8:2111:16471: scene=B_8
#: B_8:2111
msgctxt "text_id=16471 | speaker=unknown"
msgid "  Whenever it came to Aoko, he seemed to forget his role as a priest."
msgstr "　この人物は青子の事になると<神父然|しんぷぜん>とした姿勢が崩れるようだ。"

#. Occurrence B_8:2116:16472: scene=B_8
#: B_8:2116
msgctxt "text_id=16472 | speaker=unknown"
msgid "  But that was irrelevant to Soujyuro."
msgstr "　と、それはともかく。"

#. Occurrence B_8:2143:16473: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0019; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:2143
msgctxt "text_id=16473 | speaker=soujuurou"
msgid "\"So, um, Father, what exactly do I admire about Aoko, then?\""
msgstr "「えっと、神父さん。それで結局、自分は青子のどこらへんに憧れてるんですか？」"

#. Occurrence B_8:2169:16474: scene=B_8
#: B_8:2169
msgctxt "text_id=16474 | speaker=unknown"
msgid "  Soujyuro responded to Father Eiri's rambling by being direct."
msgstr "　要領を得ない詠梨の言葉に、草十郎は真っ正面から聞き返す。"

#. Occurrence B_8:2174:16475: scene=B_8
#: B_8:2174
msgctxt "text_id=16475 | speaker=unknown"
msgid "  Some would say the priest had been direct himself, but this was Soujyuro, and he needed things spelled out."
msgstr "　順を追って話していた詠梨だが、この相手には冗長すぎたようだ。"

#. Occurrence B_8:2212:16476: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0051; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2212
msgctxt "text_id=16476 | speaker=eiri"
msgid "\"...You still don't get it?"
msgstr "「……今のでも分からない、と。"

#. Occurrence B_8:2218:16477: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0052; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2218
msgctxt "text_id=16477 | speaker=eiri"
msgid "  Then you have me beat, Soujyuro. Some things really are difficult to put into words. Then again, I am simply a man of the cloth. How about a change of tack?"
msgstr "　まいりましたね。こういう事は言葉を尽くすほど実感が湧かないものですが……ま、私も神父と呼ばれる身です。少し切り口を変えて代弁してみましょう。"

#. Occurrence B_8:2251:16478: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0053; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2251
msgctxt "text_id=16478 | speaker=eiri"
msgid "  Do you know about Aoko's past?\""
msgstr "　貴方は青子の過去を知っていますか？」"

#. Occurrence B_8:2308:16479: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0020; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:2308
msgctxt "text_id=16479 | speaker=soujuurou"
msgid "\"Not much. She told me some weird stuff I didn't understand about her start to high school and things.\""
msgstr "「詳しくは知りません。高校デビューとか、おかしな言葉を口にしてましたけど」"

#. Occurrence B_8:2360:16480: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0054; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2360
msgctxt "text_id=16480 | speaker=eiri"
msgid "\"So by 'not much,' you mean 'nothing.'"
msgstr "「まったく知らないというコトですね。"

#. Occurrence B_8:2366:16481: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0055; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2366
msgctxt "text_id=16481 | speaker=eiri"
msgid "  Very well, Sizuki. Allow me to try something more abstract."
msgstr "　いいでしょう。では静希君、益体のないたとえ話ですが。"

#. Occurrence B_8:2377:16482: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0056; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2377
msgctxt "text_id=16482 | speaker=eiri"
msgid "  If you were suddenly told to kill yourself, could you?\""
msgstr "　君は、突然自殺しろと言われて従えますか？」"

#. Occurrence B_8:2383:16483: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0021; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:2383
msgctxt "text_id=16483 | speaker=soujuurou"
msgid "\"K-Kill myself...?\""
msgstr "「自殺……ですか？」"

#. Occurrence B_8:2409:16484: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0057; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2409
msgctxt "text_id=16484 | speaker=eiri"
msgid "\"Yes, kill yourself. Of course, a priest shouldn't talk about such things, but my appearance is only skin deep."
msgstr "「そう、自殺です。神父である私が口にしていい事ではありませんが、ま、私は格好だけなのでいいでしょう。"

#. Occurrence B_8:2436:16485: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0058; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2436
msgctxt "text_id=16485 | speaker=eiri"
msgid "  Anyway, Aoko was asked to do something along those lines when she was fifteen."
msgstr "　青子はね、近いことを求められたのです、十五歳の時に。"

#. Occurrence B_8:2442:16486: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0059; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2442
msgctxt "text_id=16486 | speaker=eiri"
msgid "  Throw away her hopes and dreams, her past and future, everything she was up to that point. Become a different being entirely."
msgstr "　彼女がそれまで積み重ねてきた努力も希望も、過去も未来もすべて捨てること。今日からおまえは違う生き物として生きろ、とね。"

#. Occurrence B_8:2448:16487: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0060; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2448
msgctxt "text_id=16487 | speaker=eiri"
msgid "  Well? The end of your self is the end of your future, wouldn't you agree?\""
msgstr "　どうです？　それは自己の抹消、未来の死と同じだと思いませんか？」"

#. Occurrence B_8:2484:16488: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0022; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:2484
msgctxt "text_id=16488 | speaker=soujuurou"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence B_8:2490:16489: scene=B_8
#: B_8:2490
msgctxt "text_id=16489 | speaker=unknown"
msgid "  His words fit what Aoko had said about her past."
msgstr "　神父の言葉は、たしかに青子が口にした過去と一致する。"

#. Occurrence B_8:2495:16490: scene=B_8
#: B_8:2495
msgctxt "text_id=16490 | speaker=unknown"
msgid "  Until middle school, she led a normal life."
msgstr "　蒼崎青子は中学まで、普通の学生として暮らしてきた。"

#. Occurrence B_8:2500:16491: scene=B_8
#: B_8:2500
msgctxt "text_id=16491 | speaker=unknown"
msgid "  Then out of the blue, she became the family heiress in place of her sister."
msgstr "　それが突然、姉に代わって家を継ぐ事になってしまった。"

#. Occurrence B_8:2543:16492: scene=B_8
#: B_8:2543
msgctxt "text_id=16492 | speaker=unknown"
msgid "  Becoming a Magician meant casting aside the life she had known."
msgstr "　魔法使いになる、という事は、今までの生活を捨てる、という事らしい。"

#. Occurrence B_8:2548:16493: scene=B_8
#: B_8:2548
msgctxt "text_id=16493 | speaker=unknown"
msgid "  She had to leave behind her ambitions and prospects, and live the life of a mage-something she barely knew anything about."
msgstr "　青子は知識としてしか受けとめていなかった魔術師の観念を常識にして、今までの努力も展望も捨てて、違う生き方を余儀なくされた。"

#. Occurrence B_8:2569:16494: scene=B_8
#: B_8:2569
msgctxt "text_id=16494 | speaker=unknown"
msgid "  Her life up to that point had taught her that everything from then on would bring her misery."
msgstr "　そして、その生き方は、それまでの青子の常識からすれば、苦痛しかともなわない道だった。"

#. Occurrence B_8:2596:16495: scene=B_8
#: B_8:2596
msgctxt "text_id=16495 | speaker=unknown"
msgid "  Aoko's grandfather was not the forceful type."
msgstr "　……青子の祖父は、彼女に強制はしなかった。"

#. Occurrence B_8:2601:16496: scene=B_8
#: B_8:2601
msgctxt "text_id=16496 | speaker=unknown"
msgid "  Your sister has failed. Now, it's your turn, he had said."
msgstr "“姉が駄目になったので、次はおまえだ”としか言わなかったらしい。"

#. Occurrence B_8:2606:16497: scene=B_8
#: B_8:2606
msgctxt "text_id=16497 | speaker=unknown"
msgid "  Did Aoko resist?"
msgstr "　青子はそれを拒んだろうか……？"

#. Occurrence B_8:2611:16498: scene=B_8
#: B_8:2611
msgctxt "text_id=16498 | speaker=unknown"
msgid "  Soujyuro could not begin to imagine."
msgstr "　草十郎には考えもつかない。"

#. Occurrence B_8:2648:16499: scene=B_8
#: B_8:2648
msgctxt "text_id=16499 | speaker=unknown"
msgid "  All he knew is that she could not be happy with the hand she was dealt."
msgstr "　……けれど。彼女がそのカードを、喜んで選んでいない事だけは断言できる。"

#. Occurrence B_8:2654:16500: scene=B_8
#: B_8:2654
msgctxt "text_id=16500 | speaker=unknown"
msgid "  Even if the life of a Magician was attractive, to believe the possibility that Aoko could give up her lifestyle up to that point was to not know her at all."
msgstr "　魔法使いとしての生き方が魅力的だったとしても、今までの生活をあっさりと切り捨てる事なんて、あの少女にはあり得ない。"

#. Occurrence B_8:2674:16501: scene=B_8
#: B_8:2674
msgctxt "text_id=16501 | speaker=unknown"
msgid "  Aoko Aozaki put her all into everything."
msgstr "　だって、蒼崎青子はいつだって本気で走っていた。"

#. Occurrence B_8:2680:16502: scene=B_8
#: B_8:2680
msgctxt "text_id=16502 | speaker=unknown"
msgid "  She had probably achieved a lot in those fifteen years."
msgstr "　必然、彼女の十五年間はその努力の分だけ、十分に報われていた筈だ。"

#. Occurrence B_8:2685:16503: scene=B_8
#: B_8:2685
msgctxt "text_id=16503 | speaker=unknown"
msgid "  Her achievements and prospects were no doubt enough to make anyone jealous."
msgstr "　それまでの成果も、将来の展望も、誰もが羨むだけの輝きを持っていた筈なのだ。"

#. Occurrence B_8:2691:16504: scene=B_8
#: B_8:2691
msgctxt "text_id=16504 | speaker=unknown"
msgid "But did she have the conviction to those away and go back to square one?"
msgstr "それを白紙に戻して、一からやり直す決意を持てるものなのか。"

#. Occurrence B_8:2718:16505: scene=B_8
#: B_8:2718
msgctxt "text_id=16505 | speaker=unknown"
msgid "  And \"square one\" did not come close to the reality of it."
msgstr "　……単純に、やり直すだけではなく。"

#. Occurrence B_8:2724:16506: scene=B_8
#: B_8:2724
msgctxt "text_id=16506 | speaker=unknown"
msgid "  The future she had envisioned for so long would have been obliterated."
msgstr "　ずっと描いていた<未来|ゆめ>を、完膚無きまでに、殺す事になったとしても。"

#. Occurrence B_8:2780:16507: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0023; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:2780
msgctxt "text_id=16507 | speaker=soujuurou"
msgid "\"...So, what did Aoko do?\""
msgstr "「……青子は、どうしたんですか？」"

#. Occurrence B_8:2817:16508: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0061; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2817
msgctxt "text_id=16508 | speaker=eiri"
msgid "\"Well, we're talking about one exceptionally stubborn girl."
msgstr "「いや、これがもう、まったくの頑固者でして。"

#. Occurrence B_8:2823:16509: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0062; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2823
msgctxt "text_id=16509 | speaker=eiri"
msgid "  Had I not witnessed it myself I wouldn't have believed it, but... she nodded."
msgstr "　立ち会った私でさえどうかと思うぐらい、簡単に<頷|うなず>きました。"

#. Occurrence B_8:2830:16510: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0063; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2830
msgctxt "text_id=16510 | speaker=eiri"
msgid "She stood there defiantly, curling her shaking fingers into balled fists."
msgstr "震える指を懸命に握りこんで、やってやろうじゃない、と見得を切ってね。"

#. Occurrence B_8:2836:16511: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0064; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2836
msgctxt "text_id=16511 | speaker=eiri"
msgid "  Not to appease her grandfather. Not out of obligation to the Aozaki family. But because she hates to run away from anything.\""
msgstr "　彼女は祖父の期待や蒼崎の責任感からではなく、逃げる事を嫌って、魔術師の道を取ったんですよ」"

#. Occurrence B_8:2885:16512: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0065; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2885
msgctxt "text_id=16512 | speaker=eiri"
msgid "\"Now, refusing something is not the same as running away from it, but try telling that to Aoko. To her, running away would be rejecting the life she'd forged."
msgstr "「拒む事は逃げではないのでしょうが、青子にはそう思えたんでしょう。……逃避という行為は、これまでの自分の<人生|じかん>を否定する事になると。"

#. Occurrence B_8:2891:16513: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0066; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2891
msgctxt "text_id=16513 | speaker=eiri"
msgid "  If that was all to go, she would say farewell on her own terms. So that was what she did."
msgstr "　今までの自分を嘘にしてしまうのなら―――今までの生活に別れを告げる事を、青子は選んだのです。"

#. Occurrence B_8:2897:16514: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0067; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:2897
msgctxt "text_id=16514 | speaker=eiri"
msgid "  Extreme, but she's the kind of person who would sacrifice everything in the name of progress.\""
msgstr "　ま、極端ではありますが。アレは前に進む為なら、全てを捨てられる人間なんです」"

#. Occurrence B_8:2977:16515: scene=B_8
#: B_8:2977
msgctxt "text_id=16515 | speaker=unknown"
msgid "  An affectionate smile crossed Father Eiri's face."
msgstr "　詠梨神父は懐かしむように微笑んだ。"

#. Occurrence B_8:2982:16516: scene=B_8
#: B_8:2982
msgctxt "text_id=16516 | speaker=unknown"
msgid "  Rather than signaling his closeness to Aoko, it conveyed the pride of a guardian."
msgstr "　そこには青子に対する親近感というよりは、保護者としての誇らしさがうかがえた。"

#. Occurrence B_8:3034:16517: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0068; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:3034
msgctxt "text_id=16517 | speaker=eiri"
msgid "\"However, I was also mistaken. As it turns out, Aoko had been raised to become a mage all along."
msgstr "「……ですが、私も思い違いをしていました。結局はそうなるように、青子は育てられていたのです。"

#. Occurrence B_8:3040:16518: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0069; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:3040
msgctxt "text_id=16518 | speaker=eiri"
msgid "  Her grandfather predicted Touko would leave, and that Aoko would become his heiress. So he raised them both accordingly.\""
msgstr "　彼女の祖父は、橙子が家を出る事も、青子が後継ぎを了解する事も読んだ上で、あの二人を育ててきた」"

#. Occurrence B_8:3079:16519: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0070; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:3079
msgctxt "text_id=16519 | speaker=eiri"
msgid "\"As a priest-if only by name-I felt uncomfortable about that; I knew she had no interest in her new role."
msgstr "「カタチだけですが、私も神父としてさすがにそれはどうかと思いましてね。<柄|がら>にもなく青子を説得したものです。"

#. Occurrence B_8:3085:16520: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0071; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:3085
msgctxt "text_id=16520 | speaker=eiri"
msgid "  Things could hardly go exactly how her grandfather had planned, so I asked her to flee with me to Mexico."
msgstr "　祖父の思い通りになる事はありません、なんなら私とメキシコあたりに逃げませんかと。"

#. Occurrence B_8:3091:16521: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0072; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:3091
msgctxt "text_id=16521 | speaker=eiri"
msgid "  Alas, she turned me down without a moment's thought."
msgstr "　―――しかしまぁ、躊躇なくフられました。"

#. Occurrence B_8:3097:16522: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0073; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:3097
msgctxt "text_id=16522 | speaker=eiri"
msgid "  I still remember every word of her answer...\""
msgstr "　その時の彼女の返答は、今でも一言一句覚えています」"

#. Occurrence B_8:3139:16523: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_8_0000; voice_prefix=A10; voice_category=1; scene=B_8
#: B_8:3139
msgctxt "text_id=16523 | speaker=aoko"
msgid "\"...Well, me crying isn't going to change anything, is it?"
msgstr "『……だって、私ひとりがどんなに泣き叫んでも今の状況は変わらないんでしょ？"

#. Occurrence B_8:3145:16524: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_8_0001; voice_prefix=A10; voice_category=1; scene=B_8
#: B_8:3145
msgctxt "text_id=16524 | speaker=aoko"
msgid "  If I'm the only one who can do it, I'll do it."
msgstr "　私にしかできないなら、正面から受けて立つ。"

#. Occurrence B_8:3151:16525: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_8_0002; voice_prefix=A10; voice_category=1; scene=B_8
#: B_8:3151
msgctxt "text_id=16525 | speaker=aoko"
msgid "  Even if I get thrown to the wolves, I'll just have to find a way to survive."
msgstr "　たとえ不本意で、とつぜん投げこまれた川の中でだって、出来ることはあるはずだもの。"

#. Occurrence B_8:3157:16526: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_8_0003; voice_prefix=A10; voice_category=1; scene=B_8
#: B_8:3157
msgctxt "text_id=16526 | speaker=aoko"
msgid "  Running away is only a last resort."
msgstr "　逃げるなんてのは最後の最後。"

#. Occurrence B_8:3163:16527: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_B_8_0004; voice_prefix=A10; voice_category=1; scene=B_8
#: B_8:3163
msgctxt "text_id=16527 | speaker=aoko"
msgid "  Until then, hear me roar.\""
msgstr "　それまでは、せいぜい華麗に踊ってやるわ』"

#. Occurrence B_8:3216:16528: scene=B_8
#: B_8:3216
msgctxt "text_id=16528 | speaker=unknown"
msgid "  The priest recited her words as if recalling lines from a favorite play."
msgstr "　過去を懐かしむように、神父は少女の台詞を暗唱した。"

#. Occurrence B_8:3221:16529: scene=B_8
#: B_8:3221
msgctxt "text_id=16529 | speaker=unknown"
msgid "  It certainly seemed like something she would say."
msgstr "　それは、たしかに彼女らしい台詞だった。"

#. Occurrence B_8:3226:16530: scene=B_8
#: B_8:3226
msgctxt "text_id=16530 | speaker=unknown"
msgid "  The last thing Aoko said in the room she was recovering in probably meant the same."
msgstr "　病室で青子と交わした最後の台詞は、たぶんそういう意味なのだ。"

#. Occurrence B_8:3259:16531: scene=B_8
#: B_8:3259
msgctxt "text_id=16531 | speaker=unknown"
msgid "  Of course, when an audience is watching, you want their approval."
msgstr "　観客はもちろんいるし、喝采も当然のように求めるべきものだ。"

#. Occurrence B_8:3264:16532: scene=B_8
#: B_8:3264
msgctxt "text_id=16532 | speaker=unknown"
msgid "  However, approval must come from within first."
msgstr "　けれど、それを一番初めに贈るのは自分であって、決して他人ではない。"

#. Occurrence B_8:3269:16533: scene=B_8
#: B_8:3269
msgctxt "text_id=16533 | speaker=unknown"
msgid "  Aoko worked to feel proud of herself before worrying about how others viewed her."
msgstr "　周りに認められるより先に、あの少女はまず、自分自身に胸を張れるよう走ってきた。"

#. Occurrence B_8:3290:16534: scene=B_8
#: B_8:3290
msgctxt "text_id=16534 | speaker=unknown"
msgid "  She at least wanted to do her job with grace."
msgstr "　せめて美しく。"

#. Occurrence B_8:3295:16535: scene=B_8
#: B_8:3295
msgctxt "text_id=16535 | speaker=unknown"
msgid "  In response to everything she had lost, she would hang in there, even if it meant going it alone."
msgstr "　無くしてきた多くのものに応えられるように、たとえ地上に一人きりになっても、ああやってやせ我慢を続けるのだ。"

#. Occurrence B_8:3364:16536: scene=B_8
#: B_8:3364
msgctxt "text_id=16536 | speaker=unknown"
msgid "  As for why Soujyuro envied her... well, that was obvious."
msgstr "　なぜ羨んでいるのかなんて、言葉にするまでもない。"

#. Occurrence B_8:3369:16537: scene=B_8
#: B_8:3369
msgctxt "text_id=16537 | speaker=unknown"
msgid "  To Soujyuro, she lived her life with her head held high."
msgstr "　彼には、彼女の在り方があまりにも誇らしかった。"

#. Occurrence B_8:3408:16538: scene=B_8
#: B_8:3408
msgctxt "text_id=16538 | speaker=unknown"
msgid "  He was a boy who accepted everything, but had nothing."
msgstr "　全てを受け入れていながら、その実、何も手に入れていない人間がいて、"

#. Occurrence B_8:3414:16539: scene=B_8
#: B_8:3414
msgctxt "text_id=16539 | speaker=unknown"
msgid "  She was a girl who threw it all away, but never lost a thing."
msgstr "　全てを捨ててきたようで、その実、何一つ失ってはいない少女がいた。"

#. Occurrence B_8:3442:16540: scene=B_8
#: B_8:3442
msgctxt "text_id=16540 | speaker=unknown"
msgid "  He stood in the meeting room alone,"
msgstr "　……まだ誰とも出会っていなかった雨の会議室。"

#. Occurrence B_8:3447:16541: scene=B_8
#: B_8:3447
msgctxt "text_id=16541 | speaker=unknown"
msgid "  seeing the ugliness within,"
msgstr "　自らの醜さと、"

#. Occurrence B_8:3452:16542: scene=B_8
#: B_8:3452
msgctxt "text_id=16542 | speaker=unknown"
msgid "  and the sublime outside."
msgstr "　正反対の気高さを見た。"

#. Occurrence B_8:3458:16543: scene=B_8
#: B_8:3458
msgctxt "text_id=16543 | speaker=unknown"
msgid "  Looking back,"
msgstr "　思えばあの時。"

#. Occurrence B_8:3463:16544: scene=B_8
#: B_8:3463
msgctxt "text_id=16544 | speaker=unknown"
msgid "  he finally realized what was eating at him."
msgstr "　彼はようやく、自分の棘に気が付いたのだ。"

#. Occurrence B_8:3528:16545: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0074; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:3528
msgctxt "text_id=16545 | speaker=eiri"
msgid "\"I think you see it now. It's not her appearance that strikes you as beautiful, but her spirit."
msgstr "「もういいでしょう。君は青子の容姿に感じ入ったのではなく、蒼崎青子という生き方に感じ入ったのです。"

#. Occurrence B_8:3534:16546: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0075; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:3534
msgctxt "text_id=16546 | speaker=eiri"
msgid "  Not that she isn't physically beautiful, of course.\""
msgstr "　ま、青子は青子でれっきとした美人ですが」"

#. Occurrence B_8:3577:16547: scene=B_8
#: B_8:3577
msgctxt "text_id=16547 | speaker=unknown"
msgid "  Soujyuro nodded."
msgstr "　少年はうなずく。"

#. Occurrence B_8:3582:16548: scene=B_8
#: B_8:3582
msgctxt "text_id=16548 | speaker=unknown"
msgid "  From the day he first met her,"
msgstr "　初めて少女に出会ったあの日。"

#. Occurrence B_8:3587:16549: scene=B_8
#: B_8:3587
msgctxt "text_id=16549 | speaker=unknown"
msgid "  that was indeed how he had felt; it just took him till now to realize it."
msgstr "　無意識に感じた印象は、それ以外の何物でもないと。"

#. Occurrence B_8:3593:16550: scene=B_8
#: B_8:3593
msgctxt "text_id=16550 | speaker=unknown"
msgid "  The strength in her eyes and her unwavering will had captured his heart."
msgstr "　強い眼差しと、ただ自分であろうとする彼女の意志に、彼はあんなにも見惚れたのだ。"

#. Occurrence B_8:3622:16551: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_8_0024; voice_prefix=A30; voice_category=3; scene=B_8
#: B_8:3622
msgctxt "text_id=16551 | speaker=soujuurou"
msgid "\"She... puts up with a lot.\" "
msgstr "「……なんか、すごいやせ我慢だ」"

#. Occurrence B_8:3648:16552: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_8_0076; voice_prefix=B40; voice_category=8; scene=B_8
#: B_8:3648
msgctxt "text_id=16552 | speaker=eiri"
msgid "\"She really does. There's a lot of fight packed into that small frame.\""
msgstr "「本当に。小娘のクセに、ギネス級の頑固さです」"

#. Occurrence B_8:3654:16553: scene=B_8
#: B_8:3654
msgctxt "text_id=16553 | speaker=unknown"
msgid "  Father Eiri spoke from the heart."
msgstr "　神父の同意は心からのものだ。"

#. Occurrence B_8:3659:16554: scene=B_8
#: B_8:3659
msgctxt "text_id=16554 | speaker=unknown"
msgid "  Soujyuro raised his head, gave a small grin, and scratched his cheek; so many hours wasted brooding like an idiot."
msgstr "　草十郎は小さく、この数時間の自分の馬鹿さかげんを笑うように頬をかいて、顔を上げた。"

#. Occurrence B_8:3710:16555: scene=B_8
#: B_8:3710
msgctxt "text_id=16555 | speaker=unknown"
msgid "  A part of him still felt strange, but it didn't bother him to leave the question unsolved for now."
msgstr "　正体不明の気持ちはまだ持て余しているが、どうもそれは解決しなくてもいいものらしい。"

#. Occurrence B_8:3715:16556: scene=B_8
#: B_8:3715
msgctxt "text_id=16556 | speaker=unknown"
msgid "  Unable to stay still, he stood up."
msgstr "　いてもたってもいられず立ち上がる。"

#. Occurrence B_8:3720:16557: scene=B_8
#: B_8:3720
msgctxt "text_id=16557 | speaker=unknown"
msgid "  He couldn't care less about the Aozaki family, mage battles, or Aoko rushing off to her death."
msgstr "　蒼崎の家のことも、魔術師同士の争いも、死にに行こうとする青子のことも、どうでもいい。"

#. Occurrence B_8:3726:16558: scene=B_8
#: B_8:3726
msgctxt "text_id=16558 | speaker=unknown"
msgid "  Right now, he just wanted to see her face."
msgstr "　今はただ、彼女の顔が見たかった。"

#. Occurrence B_9:52:16559: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0000; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:52
msgctxt "text_id=16559 | speaker=yuika"
msgid "\"Stop. The recovery room is off-limits.\""
msgstr "「お待ちなさい。病室は立ち入り禁止です」"

#. Occurrence B_9:58:16560: scene=B_9
#: B_9:58
msgctxt "text_id=16560 | speaker=unknown"
msgid "  The cold words echoed around the chapel."
msgstr "　……と。"

#. Occurrence B_9:63:16561: scene=B_9
#: B_9:63
msgctxt "text_id=16561 | speaker=unknown"
msgid "  They reached Soujyuro as he was about to head back to Aoko."
msgstr "　礼拝堂の奥、病室に向かう草十郎に、冷たい声が浴びせられた。"

#. Occurrence B_9:79:16562: scene=B_9
#: B_9:79
msgctxt "text_id=16562 | speaker=unknown"
msgid "  The sightless sister must have been waiting by the altar. She moved quickly to block his path."
msgstr "　祭壇の横に控えていたのか、盲目のシスターは草十郎を律するように、ドアの前に移動した。"

#. Occurrence B_9:105:16563: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_9_0000; voice_prefix=A30; voice_category=3; scene=B_9
#: B_9:105
msgctxt "text_id=16563 | speaker=soujuurou"
msgid "\"Miss Yuika. I'm not allowed in?\""
msgstr "「唯架さん。いま、病室には入れないんですか？」"

#. Occurrence B_9:116:16564: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0001; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:116
msgctxt "text_id=16564 | speaker=yuika"
msgid "\"Correct. Miss Kuonji told me to make sure nobody enters.\""
msgstr "「はい。しばらく<人除|ひとよ>けをしてほしいと、久遠寺様から言付かっています」"

#. Occurrence B_9:122:16565: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_9_0001; voice_prefix=A30; voice_category=3; scene=B_9
#: B_9:122
msgctxt "text_id=16565 | speaker=soujuurou"
msgid "\"Alice said that?\""
msgstr "「有珠が……？」"

#. Occurrence B_9:161:16566: scene=B_9
#: B_9:161
msgctxt "text_id=16566 | speaker=unknown"
msgid "  Soujyuro was suspicious of why Alice would have said that."
msgstr "　人除けとはどういう事か。"

#. Occurrence B_9:166:16567: scene=B_9
#: B_9:166
msgctxt "text_id=16567 | speaker=unknown"
msgid "  He could understand being kept out if Aoko was being treated, or her condition had worsened. But this seemed different."
msgstr "　傷の手当て、容態の悪化といった理由で面会謝絶になるのなら分かるが、シスターの言葉から、そういった事情は感じとれない。"

#. Occurrence B_9:172:16568: scene=B_9
#: B_9:172
msgctxt "text_id=16568 | speaker=unknown"
msgid "  Besides, Aoko herself said her treatment had finished."
msgstr "　そもそも、治療はもう終わっていると青子自身が―――"

#. Occurrence B_9:206:16569: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0000; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:206
msgctxt "text_id=16569 | speaker=eiri"
msgid "\"Now now, Sister Yuika. There's no need to be so curt."
msgstr "「人がいいのですね、シスター唯架は。そんな方便をしなくてもいいんですよ。"

#. Occurrence B_9:212:16570: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0001; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:212
msgctxt "text_id=16570 | speaker=eiri"
msgid "  Why not just tell him the truth? That the room is actually empty."
msgstr "　はっきり言ってあげればいい。今から病室に行っても無駄です、と。"

#. Occurrence B_9:219:16571: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0002; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:219
msgctxt "text_id=16571 | speaker=eiri"
msgid "Aoko left some time ago.\""
msgstr "青子はとっくに出発しているんですから」"

#. Occurrence B_9:245:16572: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0002; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:245
msgctxt "text_id=16572 | speaker=yuika"
msgid "\"But Father Eiri!\""
msgstr "「エイリ神父」"

#. Occurrence B_9:302:16573: scene=B_9
#: B_9:302
msgctxt "text_id=16573 | speaker=unknown"
msgid "  The priest began to explain everything from the pew he still sat in."
msgstr "　長椅子に座ったまま、神父はにこやかに説明した。"

#. Occurrence B_9:307:16574: scene=B_9
#: B_9:307
msgctxt "text_id=16574 | speaker=unknown"
msgid "  About the things he and Soujyuro had spoken about."
msgstr "　先ほどまでの一連のやりとり。"

#. Occurrence B_9:312:16575: scene=B_9
#: B_9:312
msgctxt "text_id=16575 | speaker=unknown"
msgid "  And why he, a stranger, would be so concerned about a person he knew nothing about."
msgstr "　彼はなぜ、頼まれもせず他人の悩みを解いていたのか。"

#. Occurrence B_9:317:16576: scene=B_9
#: B_9:317
msgctxt "text_id=16576 | speaker=unknown"
msgid "  It all became clear to Soujyuro."
msgstr "　……その真意は、もう語るまでもない。"

#. Occurrence B_9:362:16577: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_9_0002; voice_prefix=A30; voice_category=3; scene=B_9
#: B_9:362
msgctxt "text_id=16577 | speaker=soujuurou"
msgid "\"This was your plan all along.\""
msgstr "「初めから、そのつもりだったんですね」"

#. Occurrence B_9:367:16578: scene=B_9
#: B_9:367
msgctxt "text_id=16578 | speaker=unknown"
msgid "  Soujyuro's voice was full of anger, but Father Eiri did not flinch."
msgstr "　怒気を含んだ声を、神父は眉ひとつ動かさず受けとめる。"

#. Occurrence B_9:402:16579: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0003; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:402
msgctxt "text_id=16579 | speaker=eiri"
msgid "\"My apologies. Aoko requested I look after you."
msgstr "「申し訳ありません。青子に貴方の保護を頼まれたもので。"

#. Occurrence B_9:408:16580: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0004; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:408
msgctxt "text_id=16580 | speaker=eiri"
msgid "  While I did need to buy her time to prepare, I honestly did want to talk to you.\""
msgstr "　彼女の準備が整うまでの時間稼ぎでしたが、私が貴方と話をしたかったのは事実ですよ」"

#. Occurrence B_9:413:16581: scene=B_9
#: B_9:413
msgctxt "text_id=16581 | speaker=unknown"
msgid "  The priest's attempt to smooth things over was far from sincere."
msgstr "　そこは誤解なきよう、と神父は誠意のかけらもない弁明をした。"

#. Occurrence B_9:456:16582: scene=B_9
#: B_9:456
msgctxt "text_id=16582 | speaker=unknown"
msgid "  Soujyuro grit his teeth to control his rage."
msgstr "　強く、激情から歯を噛み締める。"

#. Occurrence B_9:462:16583: scene=B_9
#: B_9:462
msgctxt "text_id=16583 | speaker=unknown"
msgid "  Why had they not stopped Aoko and Alice from heading towards certain death?"
msgstr "　……なぜ青子たちの自殺行為を止めなかったのか、なんて罵倒はない。"

#. Occurrence B_9:482:16584: scene=B_9
#: B_9:482
msgctxt "text_id=16584 | speaker=unknown"
msgid "  Because both the nun and priest were of the same ilk as the mages."
msgstr "　神父もシスターも魔術師と同類だ。"

#. Occurrence B_9:487:16585: scene=B_9
#: B_9:487
msgctxt "text_id=16585 | speaker=unknown"
msgid "  As such, they understood Aoko's decision, and the priest understood Aoko, too."
msgstr "　彼らにとって見れば青子の選択は当然であり、そもそも、この神父は青子を知っている。"

#. Occurrence B_9:492:16586: scene=B_9
#: B_9:492
msgctxt "text_id=16586 | speaker=unknown"
msgid "  Even if he did have the power to stop her, he would not have."
msgstr "　たとえ彼に青子を止める力があったとしても、彼はすっぱり見送っただろう。"

#. Occurrence B_9:497:16587: scene=B_9
#: B_9:497
msgctxt "text_id=16587 | speaker=unknown"
msgid "  The Aoko Aozaki he knew was not about to hide away in a church and lick her wounds."
msgstr "　このまま教会でくすぶっている青子なんて、彼の知る蒼崎青子ではないのだから。"

#. Occurrence B_9:523:16588: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_9_0003; voice_prefix=A30; voice_category=3; scene=B_9
#: B_9:523
msgctxt "text_id=16588 | speaker=soujuurou"
msgid "\"Where's Alice?\""
msgstr "「有珠は？」"

#. Occurrence B_9:558:16589: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0005; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:558
msgctxt "text_id=16589 | speaker=eiri"
msgid "\"With Aoko. They left about thirty minutes ago.\""
msgstr "「青子と行きましたよ。あれから三十分は過ぎていますね」"

#. Occurrence B_9:564:16590: scene=B_9
#: B_9:564
msgctxt "text_id=16590 | speaker=unknown"
msgid "  Father Eiri even went so far as to divulge the time."
msgstr "　神父はご丁寧にも、時間まで口にした。"

#. Occurrence B_9:585:16591: scene=B_9
#: B_9:585
msgctxt "text_id=16591 | speaker=unknown"
msgid "  Thirty minutes ago: the same time the priest reared his head."
msgstr "　三十分。ちょうど神父が現れた時間と一致する。"

#. Occurrence B_9:590:16592: scene=B_9
#: B_9:590
msgctxt "text_id=16592 | speaker=unknown"
msgid "  It would not take even half that long to get to the school from here."
msgstr "　この教会から学校までは二十分かからない。"

#. Occurrence B_9:595:16593: scene=B_9
#: B_9:595
msgctxt "text_id=16593 | speaker=unknown"
msgid "  And then another ten minutes or less to get to Misaki High's old school building from there."
msgstr "　そこから三咲高校の旧校舎までなら、走れば十分たらずで到着してしまう―――"

#. Occurrence B_9:616:16594: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_9_0004; voice_prefix=A30; voice_category=3; scene=B_9
#: B_9:616
msgctxt "text_id=16594 | speaker=soujuurou"
msgid "\"...!\""
msgstr "「っ…………！」"

#. Occurrence B_9:621:16595: scene=B_9
#: B_9:621
msgctxt "text_id=16595 | speaker=unknown"
msgid "  Soujyuro turned to the entrance of the chapel."
msgstr "　草十郎は礼拝堂の玄関へと踵を返す。"

#. Occurrence B_9:628:16596: scene=B_9
#: B_9:628
msgctxt "text_id=16596 | speaker=unknown"
msgid "  However..."
msgstr "　それを、"

#. Occurrence B_9:661:16597: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0003; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:661
msgctxt "text_id=16597 | speaker=yuika"
msgid "\"Stop. Where do you think you're going?\""
msgstr "「待ちなさい。何処へ行くつもりですか」"

#. Occurrence B_9:666:16598: scene=B_9
#: B_9:666
msgctxt "text_id=16598 | speaker=unknown"
msgid "  The sound of her voice stopped him in his tracks."
msgstr "　盲目のシスターが、声だけで押し止めた。"

#. Occurrence B_9:701:16599: scene=B_9
#: B_9:701
msgctxt "text_id=16599 | speaker=unknown"
msgid "  An unseen pressure had locked him in place."
msgstr "　―――見えない重圧が草十郎の足を止めている。"

#. Occurrence B_9:706:16600: scene=B_9
#: B_9:706
msgctxt "text_id=16600 | speaker=unknown"
msgid "  Her admonition seemed to carry a spellbinding power, stopping the foolhardy boy where he stood."
msgstr "　シスターの声は呪縛となって、向こう見ずな少年を<諫|いさ>めていた。"

#. Occurrence B_9:733:16601: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0004; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:733
msgctxt "text_id=16601 | speaker=yuika"
msgid "\"You know nothing of mage battles."
msgstr "「貴方は魔術師同士の争いを知りません。"

#. Occurrence B_9:739:16602: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0005; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:739
msgctxt "text_id=16602 | speaker=yuika"
msgid "  You're too weak to help; you'd be a liability."
msgstr "　何の助力にもならないばかりか、彼女たちの<足枷|あしかせ>になるだけです。"

#. Occurrence B_9:745:16603: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0006; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:745
msgctxt "text_id=16603 | speaker=yuika"
msgid "  If they fall, that's their prerogative. Let them tear each other apart as they wish."
msgstr "　彼女たちが命を落とすのは彼女たちの業によるもの。望むままに傷つけ合えばいいでしょう。"

#. Occurrence B_9:752:16604: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0007; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:752
msgctxt "text_id=16604 | speaker=yuika"
msgid "A young, innocent bystander like you has no business taking part in such a calamity.\""
msgstr "貴方のような何の<咎|とが>もない若者が、凶事に立ち会う事はありません」"

#. Occurrence B_9:772:16605: scene=B_9
#: B_9:772
msgctxt "text_id=16605 | speaker=unknown"
msgid "  She spoke with quiet anger."
msgstr "　シスターの声には静かな怒りがある。"

#. Occurrence B_9:777:16606: scene=B_9
#: B_9:777
msgctxt "text_id=16606 | speaker=unknown"
msgid "  Her contempt was not directed at Aoko or Alice, though, but Soujyuro for being so eager to waste his life."
msgstr "　青子たちへの嫌悪ではなく、それを承知の上で命を粗末にする草十郎を<諫|いさ>めている。"

#. Occurrence B_9:826:16607: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0008; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:826
msgctxt "text_id=16607 | speaker=yuika"
msgid "\"If there was a shred of hope, I wouldn't stop you."
msgstr "「なにかしら希望があるのなら私も止めはしません。"

#. Occurrence B_9:832:16608: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0009; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:832
msgctxt "text_id=16608 | speaker=yuika"
msgid "  But there isn't. There's nothing you can do for them, either.\""
msgstr "　ですがこの件は別です。貴方が行っても、彼女たちが助かる事はありません」"

#. Occurrence B_9:879:16609: scene=B_9
#: B_9:879
msgctxt "text_id=16609 | speaker=unknown"
msgid "  She was right. It would be pointless of him to go."
msgstr "　……たしかに、草十郎が追いついたところで、何がどうなる訳でもない。"

#. Occurrence B_9:884:16610: scene=B_9
#: B_9:884
msgctxt "text_id=16610 | speaker=unknown"
msgid "  At the amusement park, he had been useless in the end."
msgstr "　遊園地の時だって、結局は役に立たなかったのだ。"

#. Occurrence B_9:889:16611: scene=B_9
#: B_9:889
msgctxt "text_id=16611 | speaker=unknown"
msgid "  Now, they faced something even worse. He couldn't even imagine how he might contribute this time."
msgstr "　相手はあの夜以上の怪物だと言うなら、何が出来るかすら思いつかない。"

#. Occurrence B_9:931:16612: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0010; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:931
msgctxt "text_id=16612 | speaker=yuika"
msgid "\"Listen carefully. Aoko Aozaki's grandfather trained her to protect herself. Magecraft aside, she's still tougher than you."
msgstr "「言っておきますが、蒼崎青子は祖父に護身術を教えこまれています。魔術以外でも貴方より腕は立つ。"

#. Occurrence B_9:937:16613: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0011; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:937
msgctxt "text_id=16613 | speaker=yuika"
msgid "  Even so, she still doesn't stand a chance against that beast of a familiar.\""
msgstr "　その彼女も、あの使い魔が相手では勝負にならない」"

#. Occurrence B_9:976:16614: scene=B_9
#: B_9:976
msgctxt "text_id=16614 | speaker=unknown"
msgid "  Soujyuro's physical strength-his only edge-meant nothing."
msgstr "　唯一の利点である男の腕力も無駄らしい。"

#. Occurrence B_9:982:16615: scene=B_9
#: B_9:982
msgctxt "text_id=16615 | speaker=unknown"
msgid "If he went now, he would only get in their way."
msgstr "このまま行ったところで足手まといになるのは目に見えている。"

#. Occurrence B_9:987:16616: scene=B_9
#: B_9:987
msgctxt "text_id=16616 | speaker=unknown"
msgid "  Yuika was correct."
msgstr "　シスターの言はすべて正しい。"

#. Occurrence B_9:992:16617: scene=B_9
#: B_9:992
msgctxt "text_id=16617 | speaker=unknown"
msgid "  And yet..."
msgstr "　それでも―――"

#. Occurrence B_9:1038:16618: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_9_0005; voice_prefix=A30; voice_category=3; scene=B_9
#: B_9:1038
msgctxt "text_id=16618 | speaker=soujuurou"
msgid "\"I have to go. I owe Aoko a debt I must repay.\""
msgstr "「でも、行かないと。青子には、返さなくちゃいけない借りがあります」"

#. Occurrence B_9:1062:16619: scene=B_9
#: B_9:1062
msgctxt "text_id=16619 | speaker=unknown"
msgid "  He spoke calmly, but firmly."
msgstr "　あまりに落ち着いた、厳格な響き。"

#. Occurrence B_9:1067:16620: scene=B_9
#: B_9:1067
msgctxt "text_id=16620 | speaker=unknown"
msgid "  Though almost moved, the sister frowned slightly."
msgstr "　それについ<絆|ほだ>されかけ、シスターは眉をひそめた。"

#. Occurrence B_9:1077:16621: scene=B_9
#: B_9:1077
msgctxt "text_id=16621 | speaker=unknown"
msgid "  She felt bad for him, but her warning was for his own good."
msgstr "　……気は乗らないがこれも少年のためだ。"

#. Occurrence B_9:1082:16622: scene=B_9
#: B_9:1082
msgctxt "text_id=16622 | speaker=unknown"
msgid "  If he would not listen to reason, then she would have to make him sleep. She raised a finger of binding at Soujyuro."
msgstr "　言葉で分からないのなら無理矢理にでも眠らせるしかないと、呪縛の指を草十郎に向け―――"

#. Occurrence B_9:1103:16623: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0006; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1103
msgctxt "text_id=16623 | speaker=eiri"
msgid "\"You mean you *want* to repay your debt, Soujyuro."
msgstr "「それを言うなら返したい借りがある、ですよ草十郎君。"

#. Occurrence B_9:1165:16624: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0007; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1165
msgctxt "text_id=16624 | speaker=eiri"
msgid "  Incidentally, Sister Yuika, please refrain from using magecraft within the church."
msgstr "　それとシスター唯架、教会内での魔術は控えてくださいね。"

#. Occurrence B_9:1171:16625: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0008; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1171
msgctxt "text_id=16625 | speaker=eiri"
msgid "  At least save it for religious ceremonies, or it'll affect my investigation."
msgstr "　使うのなら秘蹟にとどめてもらわないと、私の査定に響きます。"

#. Occurrence B_9:1178:16626: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0009; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1178
msgctxt "text_id=16626 | speaker=eiri"
msgid "...Dear Lord, give me strength. You seem so quiet, Soujyuro, but you're more short-tempered than Ritsuka.\""
msgstr "……まったく。大人しそうに見えて律架クンより短気なんですから、貴女は」"

#. Occurrence B_9:1224:16627: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0012; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:1224
msgctxt "text_id=16627 | speaker=yuika"
msgid "\"If I may, Father Eiri...\""
msgstr "「エイリ神父、しかし」"

#. Occurrence B_9:1230:16628: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0010; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1230
msgctxt "text_id=16628 | speaker=eiri"
msgid "\"I see no harm in letting him go. Or would you rather see Touko destroy Aoko and Alice?\""
msgstr "「行かせてあげればいいじゃないですか。それとも貴女は、やはり青子たちに退場してほしいと？」"

#. Occurrence B_9:1256:16629: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0013; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:1256
msgctxt "text_id=16629 | speaker=yuika"
msgid "\"That issue is separate from this suicidal devotion."
msgstr "「……その問題と、彼の献身は別の話です。"

#. Occurrence B_9:1262:16630: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0014; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:1262
msgctxt "text_id=16630 | speaker=yuika"
msgid "  Reconsider, Mr. Sizuki. Even if you go, there's nothing you can do for them.\""
msgstr "　<改|あらた>めなさい静希さん。貴方が行っても、何も出来はしないのですから」"

#. Occurrence B_9:1285:16631: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_9_0006; voice_prefix=A30; voice_category=3; scene=B_9
#: B_9:1285
msgctxt "text_id=16631 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence B_9:1305:16632: scene=B_9
#: B_9:1305
msgctxt "text_id=16632 | speaker=unknown"
msgid "    The truth of the statement cut Soujyuro deep."
msgstr "　　……それは、何より彼自身が痛感している真実だった。"

#. Occurrence B_9:1310:16633: scene=B_9
#: B_9:1310
msgctxt "text_id=16633 | speaker=unknown"
msgid "  But despite everything that was being said, his mind was made up."
msgstr "　それでも答えは決まっている。"

#. Occurrence B_9:1315:16634: scene=B_9
#: B_9:1315
msgctxt "text_id=16634 | speaker=unknown"
msgid "  It always had been. Even if he was not certain, he at least would not hesitate."
msgstr "　初めからそうだった。どうせ自分すら確かではないのなら、せめて、迷わないように。"

#. Occurrence B_9:1320:16635: scene=B_9
#: B_9:1320
msgctxt "text_id=16635 | speaker=unknown"
msgid "  He had always followed his instincts to the end, no matter where they took him."
msgstr "　自然にうかんだ気持ちだけは貫こうと思ったのは、もうずっと以前からの事だ。"

#. Occurrence B_9:1346:16636: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_9_0007; voice_prefix=A30; voice_category=3; scene=B_9
#: B_9:1346
msgctxt "text_id=16636 | speaker=soujuurou"
msgid "\"I know."
msgstr "「分かっています。"

#. Occurrence B_9:1353:16637: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_9_0008; voice_prefix=A30; voice_category=3; scene=B_9
#: B_9:1353
msgctxt "text_id=16637 | speaker=soujuurou"
msgid "But I'm still going."
msgstr "……でも、行かないと。"

#. Occurrence B_9:1359:16638: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_9_0009; voice_prefix=A30; voice_category=3; scene=B_9
#: B_9:1359
msgctxt "text_id=16638 | speaker=soujuurou"
msgid "  If I stay here, I really am powerless.\""
msgstr "　ここにいたら、本当に何もできない」"

#. Occurrence B_9:1379:16639: scene=B_9
#: B_9:1379
msgctxt "text_id=16639 | speaker=unknown"
msgid "  His heart burned in his chest."
msgstr "　胸にあるのは未熟な<衝動|こころ>だけ。"

#. Occurrence B_9:1384:16640: scene=B_9
#: B_9:1384
msgctxt "text_id=16640 | speaker=unknown"
msgid "  While he listened to the priest talk, he could only think of seeing Aoko."
msgstr "　神父の話を聞いた時、彼はただ、彼女に会いたいと思った。"

#. Occurrence B_9:1389:16641: scene=B_9
#: B_9:1389
msgctxt "text_id=16641 | speaker=unknown"
msgid "  He was not worried; he did not want to help."
msgstr "　心配や助けなんて浮かばず、それだけしか思えなかった。"

#. Occurrence B_9:1394:16642: scene=B_9
#: B_9:1394
msgctxt "text_id=16642 | speaker=unknown"
msgid "  He just wanted to see her."
msgstr "　だから―――"

#. Occurrence B_9:1400:16643: scene=B_9
#: B_9:1400
msgctxt "text_id=16643 | speaker=unknown"
msgid "He would figure out what came next once he got there."
msgstr "その後の事は、その時にしか考えられない。"

#. Occurrence B_9:1453:16644: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0011; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1453
msgctxt "text_id=16644 | speaker=eiri"
msgid "\"See? He isn't suicidal."
msgstr "「ほら。献身なんて考え自体が間違ってるんです。"

#. Occurrence B_9:1459:16645: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0012; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1459
msgctxt "text_id=16645 | speaker=eiri"
msgid "  You say he'll get in the way, but Aoko and Alice stand no chance of winning anyway, correct?"
msgstr "　足を引っ張るといいますが、どのみち青子たちに勝ち目はないんでしょう？"

#. Occurrence B_9:1467:16646: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0013; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1467
msgctxt "text_id=16646 | speaker=eiri"
msgid "  "
msgstr "　"

msgctxt "text_id=16647 | speaker=unknown"
msgid "So what's the problem? Better to burn out in a blaze of glory.\""
msgstr "なら、彼がマイナスになってもいいじゃないですか。どうせ破産するなら、豪快に破産すれば」"

#. Occurrence B_9:1505:16648: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0015; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:1505
msgctxt "text_id=16648 | speaker=yuika"
msgid "\"Father...\""
msgstr "「神父」"

#. Occurrence B_9:1558:16649: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0014; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1558
msgctxt "text_id=16649 | speaker=eiri"
msgid "\"What are you waiting for, Soujyuro? Get going."
msgstr "「ほら草十郎くん、行って行って。"

#. Occurrence B_9:1564:16650: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0015; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1564
msgctxt "text_id=16650 | speaker=eiri"
msgid "  Your response has moved Sister Yuika."
msgstr "　シスター、今の貴方の返事で心が折れましたから。"

#. Occurrence B_9:1570:16651: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0016; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1570
msgctxt "text_id=16651 | speaker=eiri"
msgid "  And now you can move your legs, right?\""
msgstr "　足、動くでしょう？」"

#. Occurrence B_9:1630:16652: scene=B_9
#: B_9:1630
msgctxt "text_id=16652 | speaker=unknown"
msgid "  As soon as the priest pointed at Soujyuro, he could move again."
msgstr "　神父に指摘され、草十郎は体を確かめる。"

#. Occurrence B_9:1635:16653: scene=B_9
#: B_9:1635
msgctxt "text_id=16653 | speaker=unknown"
msgid "  The pressure weighing on his shoulders lifted, along with the fear in his heart."
msgstr "　肩にのしかかっていた重圧は薄れ、彼自身が抱いていたかすかな恐れ―――"

#. Occurrence B_9:1641:16654: scene=B_9
#: B_9:1641
msgctxt "text_id=16654 | speaker=unknown"
msgid "Could he help? Would he expose Aoko and Alice to more danger? All such doubts had vanished."
msgstr "自分は役に立たないどころか、青子たちを危険に<晒|さら>すだけかもしれない―――も、完全に吹き飛んでいた。"

#. Occurrence B_9:1667:16655: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_B_9_0010; voice_prefix=A30; voice_category=3; scene=B_9
#: B_9:1667
msgctxt "text_id=16655 | speaker=soujuurou"
msgid "\"I'm heading out, then. With any luck, we'll meet again.\""
msgstr "「―――行きます。<縁|えん>が残っていれば、また」"

#. Occurrence B_9:1683:16656: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_9000; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1683
msgctxt "text_id=16656 | speaker=eiri"
msgid "\"Good. Whatever happens, no regrets.\""
msgstr "「はい。何であれ、後悔のない一日を」"

#. Occurrence B_9:1728:16657: scene=B_9
#: B_9:1728
msgctxt "text_id=16657 | speaker=unknown"
msgid "  And with that, Soujyuro began to run, as Father Eiri watched with a look of satisfaction."
msgstr "　走りだす草十郎を、神父は満足げに見送った。"

#. Occurrence B_9:1733:16658: scene=B_9
#: B_9:1733
msgctxt "text_id=16658 | speaker=unknown"
msgid "  The priest knew if he could not persuade Aoko, he could not convince Soujyuro either."
msgstr "　どのみち青子を説得する事も無理なら、彼を納得させる事も無理だと分かっていたように。"

#. Occurrence B_9:1771:16659: scene=B_9
#: B_9:1771
msgctxt "text_id=16659 | speaker=unknown"
msgid "  He watched the impetuous boy run away,"
msgstr "　走り去っていく、がむしゃらな少年の後ろ姿。"

#. Occurrence B_9:1776:16660: scene=B_9
#: B_9:1776
msgctxt "text_id=16660 | speaker=unknown"
msgid "  as the blind nun listened to his footsteps fade into the distance."
msgstr "　盲目のシスターは、その音を聞き届ける事しかできない。"

#. Occurrence B_9:1781:16661: scene=B_9
#: B_9:1781
msgctxt "text_id=16661 | speaker=unknown"
msgid "  Yuika was different from Soujyuro and the priest."
msgstr "　……彼女は神父とも草十郎とも違う。"

#. Occurrence B_9:1786:16662: scene=B_9
#: B_9:1786
msgctxt "text_id=16662 | speaker=unknown"
msgid "  While she showed no mercy to corruption or self-righteousness, she embraced benevolence to the innocent."
msgstr "　悪徳にも独善にも慈悲は見せないが、無垢な<中庸|ちゅうよう>さには<慈|じ><愛|あい>を抱くのだ。"

#. Occurrence B_9:1791:16663: scene=B_9
#: B_9:1791
msgctxt "text_id=16663 | speaker=unknown"
msgid "  Such an ordinary boy with his life ahead of him... and yet he chose to follow heretics into Hell."
msgstr "　あの平凡な少年が天寿を全うするのは素晴らしいが、むざむざ異端たちの地獄に堕ちるのは心苦しい。"

#. Occurrence B_9:1825:16664: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0016; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:1825
msgctxt "text_id=16664 | speaker=yuika"
msgid "\"How can you live with yourself, Father Eiri?"
msgstr "「……最悪ですね、エイリ神父。"

#. Occurrence B_9:1831:16665: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_B_9_0017; voice_prefix=B20; voice_category=10; scene=B_9
#: B_9:1831
msgctxt "text_id=16665 | speaker=yuika"
msgid "  I thought responsible adults guided wayward children.\""
msgstr "　分別の付かない子供を導くのが、責任のある大人だと思いましたが」"

#. Occurrence B_9:1837:16666: scene=B_9
#: B_9:1837
msgctxt "text_id=16666 | speaker=unknown"
msgid "  She made no effort to hide her biting disapproval."
msgstr "　刺々しい抗議の声。"

#. Occurrence B_9:1842:16667: scene=B_9
#: B_9:1842
msgctxt "text_id=16667 | speaker=unknown"
msgid "  It was simply her way of showing concern for the boy."
msgstr "　彼女は彼女なりに、あの少年の身を案じていたのだ。"

#. Occurrence B_9:1847:16668: scene=B_9
#: B_9:1847
msgctxt "text_id=16668 | speaker=unknown"
msgid "  Father Eiri shrugged."
msgstr "　そんなシスターの気遣いに、神父はやれやれと肩をすくめて、"

#. Occurrence B_9:1888:16669: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0017; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1888
msgctxt "text_id=16669 | speaker=eiri"
msgid "\"You're mistaken about a few things, Sister Yuika."
msgstr "「だから、色々と間違えていますよシスター唯架。"

#. Occurrence B_9:1894:16670: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0018; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1894
msgctxt "text_id=16670 | speaker=eiri"
msgid "  Your use of the term 'responsible adult' for a start."
msgstr "　責任のある大人、なんて言葉自体がおかしい。"

#. Occurrence B_9:1900:16671: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_B_9_0019; voice_prefix=B40; voice_category=8; scene=B_9
#: B_9:1900
msgctxt "text_id=16671 | speaker=eiri"
msgid "  An adult is someone who takes responsibility no matter what.\""
msgstr "　<何|・><が|・><起|・><き|・><て|・><も|・><責|・><任|・><を|・><と|・><る|・>。それが、正しい大人というものです」"

#. Occurrence B_9:1942:16672: scene=B_9
#: B_9:1942
msgctxt "text_id=16672 | speaker=unknown"
msgid "  The rest went unspoken: it didn't matter to him which of them died."
msgstr "　誰が死んでも構わない、と。"

#. Occurrence B_9:1947:16673: scene=B_9
#: B_9:1947
msgctxt "text_id=16673 | speaker=unknown"
msgid "  With a warm, goodly smile, the priest corrected the nun's misunderstanding."
msgstr "　神父らしい温かな笑顔のまま、彼女の間違いを訂正した。"

#. Occurrence C_0:63:16674: scene=C_0
#: C_0:63
msgctxt "text_id=16674 | speaker=unknown"
msgid "  The Golden Wolf's ears stood pointed, twitching in response to the sounds around it."
msgstr "　<下界|まち>の<喧噪|におい>に、ピンと耳を立てる。"

#. Occurrence C_0:69:16675: scene=C_0
#: C_0:69
msgctxt "text_id=16675 | speaker=unknown"
msgid "  Its meal finished, it curled up into a ball in anticipation of nap time, and yawned, half from boredom."
msgstr "　食事を済ませ<午睡|ごすい>に身を任せていた金色の狼は、クワア、と大きなあくびをして、退屈そうに身を丸めた。"

#. Occurrence C_0:115:16676: scene=C_0
#: C_0:115
msgctxt "text_id=16676 | speaker=unknown"
msgid "  The old, abandoned classroom had fulfilled its purpose many moons ago."
msgstr "　その役割を終え、久しく使われていなかった教室。"

#. Occurrence C_0:120:16677: scene=C_0
#: C_0:120
msgctxt "text_id=16677 | speaker=unknown"
msgid "  For a month, the wolf had spent his time resting on top a heap of disheveled desks."
msgstr "　積み重ねた<瓦礫|つくえ>の上で身を休めるのが、ここ一ヶ月の彼の日常だ。"

#. Occurrence C_0:126:16678: scene=C_0
#: C_0:126
msgctxt "text_id=16678 | speaker=unknown"
msgid "  His name was Lugh Beowulf."
msgstr "　彼の名はルゥ・ベオウルフ。"

#. Occurrence C_0:131:16679: scene=C_0
#: C_0:131
msgctxt "text_id=16679 | speaker=unknown"
msgid "  He was a purebred werewolf, named after the sun at his birthplace and a hero of legend upon leaving there."
msgstr "　故郷では太陽の名で呼ばれ、故郷を後にしてからは勇者の名を<戴|いただ>いた、純血の人狼である。"

#. Occurrence C_0:198:16680: scene=C_0
#: C_0:198
msgctxt "text_id=16680 | speaker=unknown"
msgid "  It goes without saying he was not from this country."
msgstr "　言うまでもなく、彼の故郷はこの国ではない。"

#. Occurrence C_0:203:16681: scene=C_0
#: C_0:203
msgctxt "text_id=16681 | speaker=unknown"
msgid "  He came from a land deep within the European wilderness, surrounded by mountains and forests."
msgstr "　ヨーロッパ深部、山と森に守られた荒野が彼の<世界|ふるさと>だ。"

#. Occurrence C_0:208:16682: scene=C_0
#: C_0:208
msgctxt "text_id=16682 | speaker=unknown"
msgid "  His homeland was a realm no human had ever set foot in."
msgstr "　いまだ人智の及ばぬ秘境。"

#. Occurrence C_0:213:16683: scene=C_0
#: C_0:213
msgctxt "text_id=16683 | speaker=unknown"
msgid "  In their isolated world forgotten by time, a diminishing race of werewolves lived in peace."
msgstr "　誰一人として訪れる事のない停止した世界で、ゆるやかに絶えるだけの日々を送っていた人狼たち。"

#. Occurrence C_0:233:16684: scene=C_0
#: C_0:233
msgctxt "text_id=16684 | speaker=unknown"
msgid "  This was where Beo first appeared."
msgstr "　その中に、<彼|ベオ>は忽然と現れた。"

#. Occurrence C_0:238:16685: scene=C_0
#: C_0:238
msgctxt "text_id=16685 | speaker=unknown"
msgid "  In a cave on the outskirts of their village, the werewolves found a child bearing the same golden coat as their ancestors."
msgstr "　<人狼|かれ>らの祖と同じ金の毛並みを持った子供は、村はずれの洞穴で発見された。"

#. Occurrence C_0:243:16686: scene=C_0
#: C_0:243
msgctxt "text_id=16686 | speaker=unknown"
msgid "  The child was sleeping soundly, as if in his natural habitat."
msgstr "　安らかな寝息をたてて、まるで、そこに<存|い>るのが当然といった様子で。"

#. Occurrence C_0:263:16687: scene=C_0
#: C_0:263
msgctxt "text_id=16687 | speaker=unknown"
msgid "  The village welcomed their new member with open arms."
msgstr "　村は新しい仲間の誕生と、その貴重性に沸き立った。"

#. Occurrence C_0:268:16688: scene=C_0
#: C_0:268
msgctxt "text_id=16688 | speaker=unknown"
msgid "  Two thousand years of advancing civilization had been cruel to them."
msgstr "　文明が消費を良しとしてからはや二千年。"

#. Occurrence C_0:273:16689: scene=C_0
#: C_0:273
msgctxt "text_id=16689 | speaker=unknown"
msgid "  As the forests were destroyed, valleys unearthed, and waters polluted, the werewolf birthrate dwindled."
msgstr "　森が<暴|あば>かれ、谷が埋められ、海の<混濁|よごれ>が進むにつれ、<人狼|かれ>らの生殖機能は落ちていた。"

#. Occurrence C_0:278:16690: scene=C_0
#: C_0:278
msgctxt "text_id=16690 | speaker=unknown"
msgid "  They were now facing one birth a decade."
msgstr "　一族の者が子を<孕|はら>むだけでも十年に一度の祝い事だ。"

#. Occurrence C_0:298:16691: scene=C_0
#: C_0:298
msgctxt "text_id=16691 | speaker=unknown"
msgid "  The child's golden coat-deviating from the typical gray or white and shared only by their ancestors who were treated as gods-felt like a sign their prayers had been answered."
msgstr "　それが灰や白を飛び越え、<人狼|かれ>らが森の神とされていた頃の金の獣性を持っていたのだから、村に降りた希望がどれほどのものだったか、想像に難くない。"

#. Occurrence C_0:335:16692: scene=C_0
#: C_0:335
msgctxt "text_id=16692 | speaker=unknown"
msgid "  A bloodline in atrophy,"
msgstr "　衰退していく一族。"

#. Occurrence C_0:340:16693: scene=C_0
#: C_0:340
msgctxt "text_id=16693 | speaker=unknown"
msgid "  the werewolves were forced to embrace change."
msgstr "　転換を受け入れざるをえない時代。"

#. Occurrence C_0:345:16694: scene=C_0
#: C_0:345
msgctxt "text_id=16694 | speaker=unknown"
msgid "  This radiant child at least temporarily made them forget about their troubles."
msgstr "　それら根本的な問題を一時でも忘れてしまうほど、その赤子は輝かしかったのだ。"

#. Occurrence C_0:383:16695: scene=C_0
#: C_0:383
msgctxt "text_id=16695 | speaker=unknown"
msgid "  Alas..."
msgstr "　……だが。"

#. Occurrence C_0:388:16696: scene=C_0
#: C_0:388
msgctxt "text_id=16696 | speaker=unknown"
msgid "  As time passed, their hopes turned to disappointment."
msgstr "　時が経つに連れ、喜びは失望へと変わっていった。"

#. Occurrence C_0:393:16697: scene=C_0
#: C_0:393
msgctxt "text_id=16697 | speaker=unknown"
msgid "  The golden wolf was not their salvation."
msgstr "　金狼は何も救わない。"

#. Occurrence C_0:398:16698: scene=C_0
#: C_0:398
msgctxt "text_id=16698 | speaker=unknown"
msgid "  For some reason, Lugh―that ray of golden sun―remained a child."
msgstr "　ルゥ―――太陽と愛された子供は、不思議な事に発見された時から今の<カ|・><タ|・><チ|・>をしていた。"

#. Occurrence C_0:434:16699: scene=C_0
#: C_0:434
msgctxt "text_id=16699 | speaker=unknown"
msgid "  Decades passed and still he did not grow."
msgstr "　そればかりか、何十年経とうと一向に成長しない。"

#. Occurrence C_0:439:16700: scene=C_0
#: C_0:439
msgctxt "text_id=16700 | speaker=unknown"
msgid "  Forever young; immortal; cursed."
msgstr "　彼は不老であり、不滅であり、それ故に不遇だった。"

#. Occurrence C_0:445:16701: scene=C_0
#: C_0:445
msgctxt "text_id=16701 | speaker=unknown"
msgid "  He searched the village for his birth mother, but to no avail."
msgstr "　村中を探しても、彼を生んだ母親はいなかった。"

#. Occurrence C_0:450:16702: scene=C_0
#: C_0:450
msgctxt "text_id=16702 | speaker=unknown"
msgid "  He searched the village for someone who understood his plight, but to no avail."
msgstr "　村中を探しても、彼を理解できる人狼はいなかった。"

#. Occurrence C_0:470:16703: scene=C_0
#: C_0:470
msgctxt "text_id=16703 | speaker=unknown"
msgid "  Over hundreds of years, he came to realize something."
msgstr "　そして彼本人も、その事実を百年かけて実感した。"

#. Occurrence C_0:475:16704: scene=C_0
#: C_0:475
msgctxt "text_id=16704 | speaker=unknown"
msgid "  He was different. Very different."
msgstr "　自分は何もかもが他の連中と違う。"

#. Occurrence C_0:480:16705: scene=C_0
#: C_0:480
msgctxt "text_id=16705 | speaker=unknown"
msgid "  Neither male nor female."
msgstr "　雄も雌もない。"

#. Occurrence C_0:485:16706: scene=C_0
#: C_0:485
msgctxt "text_id=16706 | speaker=unknown"
msgid "  Neither strong nor weak."
msgstr "　<強|つよ>きも<弱|よわ>きもない。"

#. Occurrence C_0:490:16707: scene=C_0
#: C_0:490
msgctxt "text_id=16707 | speaker=unknown"
msgid "  Ignorant of life and death, joy and fear."
msgstr "　生も死も、<悦|えつ>も恐れもまだ知らない。"

#. Occurrence C_0:539:16708: scene=C_0
#: C_0:539
msgctxt "text_id=16708 | speaker=unknown"
msgid "(That thing's a spirit, born of nature. Might look like us werewolves, but don't let that fool you.)"
msgstr "『アレは自然発生した精霊だ。人狼の姿をしているが、我々とはまったく違う生きものだろう―――』"

#. Occurrence C_0:581:16709: scene=C_0
#: C_0:581
msgctxt "text_id=16709 | speaker=unknown"
msgid "  But the child himself needed not conjecture to know his own true nature."
msgstr "　陰口を言われるまでもなく、彼もそれを実感していた。"

#. Occurrence C_0:586:16710: scene=C_0
#: C_0:586
msgctxt "text_id=16710 | speaker=unknown"
msgid "  He was perfect, and therefore he was alone."
msgstr "　完成しているからこその<閉塞感|へいそくかん>。"

#. Occurrence C_0:591:16711: scene=C_0
#: C_0:591
msgctxt "text_id=16711 | speaker=unknown"
msgid "  To the Golden Wolf, the world was too small."
msgstr "　金の獣にとって、肌に感じる世界はあまりにも狭すぎる。"

#. Occurrence C_0:596:16712: scene=C_0
#: C_0:596
msgctxt "text_id=16712 | speaker=unknown"
msgid "  That was why..."
msgstr "　だからこそ―――"

#. Occurrence C_0:616:16713: scene=C_0
#: C_0:616
msgctxt "text_id=16713 | speaker=unknown"
msgid "  Indeed, that was the very reason..."
msgstr "　そう、だからこそ。"

#. Occurrence C_0:632:16714: scene=C_0
#: C_0:632
msgctxt "text_id=16714 | speaker=unknown"
msgid "  He wanted to know what life was."
msgstr "　生命とは何かを知りたい。"

#. Occurrence C_0:637:16715: scene=C_0
#: C_0:637
msgctxt "text_id=16715 | speaker=unknown"
msgid "  He wanted to know loss."
msgstr "　欠落とは何かを知りたい。"

#. Occurrence C_0:642:16716: scene=C_0
#: C_0:642
msgctxt "text_id=16716 | speaker=unknown"
msgid "  If he was all-powerful, he wanted to know the mystery behind his all-powerfulness."
msgstr "　万能であるのなら、万能であるが故の未知を知りたい。"

#. Occurrence C_0:649:16717: scene=C_0
#: C_0:649
msgctxt "text_id=16717 | speaker=unknown"
msgid "  Because as it was,"
msgstr "　だってこのままでは、"

msgctxt "text_id=16718 | speaker=unknown"
msgid "  his existence was meaningless."
msgstr "　生きている意味がまるで無い―――"

#. Occurrence C_0:683:16719: scene=C_0
#: C_0:683
msgctxt "text_id=16719 | speaker=unknown"
msgid "  The Golden Wolf was at a loss,"
msgstr "　金の狼は自分自身を持て余す。"

#. Occurrence C_0:688:16720: scene=C_0
#: C_0:688
msgctxt "text_id=16720 | speaker=unknown"
msgid "  as were the werewolves around him."
msgstr "　そうして<人狼|かれ>らも、この太陽を持て余した。"

#. Occurrence C_0:693:16721: scene=C_0
#: C_0:693
msgctxt "text_id=16721 | speaker=unknown"
msgid "  They revered him, but at the same time wanted nothing to do with him."
msgstr "　敬いはするが、同時に関わりたくもない。"

#. Occurrence C_0:726:16722: scene=C_0
#: C_0:726
msgctxt "text_id=16722 | speaker=unknown"
msgid "  Lugh moved back to the cave he was discovered in, and resigned himself to a life of seclusion."
msgstr "　ルゥは自分が発見された洞穴に居を構え、神子として、一生を<独|ひと>りのまま過ごすと宿命付けられた。"

#. Occurrence C_0:752:16723: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_0_0000; voice_prefix=A20; voice_category=11; scene=C_0
#: C_0:752
msgctxt "text_id=16723 | speaker=touko"
msgid "\"Lugh? Like the sun god Lugh? I thought it was short for 'loup-garou'!"
msgstr "『太陽のルゥ？　<ルー・ガルー|loup-garou>じゃなくて？"

#. Occurrence C_0:758:16724: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_0_0001; voice_prefix=A20; voice_category=11; scene=C_0
#: C_0:758
msgctxt "text_id=16724 | speaker=touko"
msgid "  Ha! That's one heck of a coincidence!\""
msgstr "　ハ、そりゃ面白い！　偶然にしちゃあ出来すぎだ！』"

#. Occurrence C_0:764:16725: scene=C_0
#: C_0:764
msgctxt "text_id=16725 | speaker=unknown"
msgid "  And then one day, a quirky mage visited the village."
msgstr "　その村に、風変わりな魔術師が訪れるまでは。"

#. Occurrence C_0:819:16726: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_0_0000; voice_prefix=A50; voice_category=12; scene=C_0
#: C_0:819
msgctxt "text_id=16726 | speaker=beo"
msgid "\"...You're too loud, Miss Touko. Why do you have to be so dramatic all the time?\""
msgstr "「“……またガタガタとうるさい……トーコさんはアレだよね、派手好きなクセにマメだよね……”」"

#. Occurrence C_0:826:16727: scene=C_0
#: C_0:826
msgctxt "text_id=16727 | speaker=unknown"
msgid "  From his place on top of the rubble, Beo peered into the hallway."
msgstr "　瓦礫の上で身を丸めながら、ベオは廊下の様子を盗み聴く。"

#. Occurrence C_0:831:16728: scene=C_0
#: C_0:831
msgctxt "text_id=16728 | speaker=unknown"
msgid "  He thought his fussy master was busy dealing with Misaki City's leylines, but she was engrossed in making traps."
msgstr "　小うるさい主人は三咲市全体の霊脈の掌握とやらに忙しい……と思いきや、飽きもせず趣味の仕掛けをこしらえているようだ。"

#. Occurrence C_0:865:16729: scene=C_0
#: C_0:865
msgctxt "text_id=16729 | speaker=unknown"
msgid "  One month passed since they made the dilapidated building their makeshift workshop."
msgstr "　この廃屋を仮の工房に使い始めて一ヶ月。"

#. Occurrence C_0:870:16730: scene=C_0
#: C_0:870
msgctxt "text_id=16730 | speaker=unknown"
msgid "  Creating a new trap for intruders became a daily pursuit of Touko's."
msgstr "　一日に一つ、新しい侵入者用のトラップを作るのが彼女のひそかな趣味らしい。"

#. Occurrence C_0:891:16731: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_0_0001; voice_prefix=A50; voice_category=12; scene=C_0
#: C_0:891
msgctxt "text_id=16731 | speaker=beo"
msgid "\"You worry about your safety, but what about the other creatures?\""
msgstr "「“……安全を用意しておくなんて、他の生き物はタイヘンだ”」"

#. Occurrence C_0:897:16732: scene=C_0
#: C_0:897
msgctxt "text_id=16732 | speaker=unknown"
msgid "  Having been like this since birth, knowing neither infancy nor dotage, he thought differently than others."
msgstr "　生まれながらこのカタチ―――赤子という未成熟な立場も、老衰という劣化も知らない<彼|ベオ>は、通常の生き物とは在り方も思想も違う。"

#. Occurrence C_0:932:16733: scene=C_0
#: C_0:932
msgctxt "text_id=16733 | speaker=unknown"
msgid "  For he was perfect from the day he was born."
msgstr "　彼はその発生からして“完全”だった。"

#. Occurrence C_0:937:16734: scene=C_0
#: C_0:937
msgctxt "text_id=16734 | speaker=unknown"
msgid "  Never declining; never improving."
msgstr "　何も引くものがなく、何も付け足すところがない。"

#. Occurrence C_0:942:16735: scene=C_0
#: C_0:942
msgctxt "text_id=16735 | speaker=unknown"
msgid "  As such, he had no comprehension of weakness."
msgstr "　故に、あらゆる弱さを実感できない。"

#. Occurrence C_0:947:16736: scene=C_0
#: C_0:947
msgctxt "text_id=16736 | speaker=unknown"
msgid "  Child-like, fickle, and without morals, he had no concept of good and bad as either a human or a wolf."
msgstr "　無邪気かつ天衣無縫の気分屋で、人間としての善悪も、狼としての良し悪しも計らない。"

#. Occurrence C_0:952:16737: scene=C_0
#: C_0:952
msgctxt "text_id=16737 | speaker=unknown"
msgid "  A beautiful creature disconnected from the world around him, he was on top of all other creatures."
msgstr "　この美しい獣は、周囲と没交渉でありながら、自分以外の生き物を見下している。"

#. Occurrence C_0:991:16738: scene=C_0
#: C_0:991
msgctxt "text_id=16738 | speaker=unknown"
msgid "  With one exception: his master, Touko Aozaki."
msgstr "　その例外が彼の主人、蒼崎橙子である。"

#. Occurrence C_0:996:16739: scene=C_0
#: C_0:996
msgctxt "text_id=16739 | speaker=unknown"
msgid "  She showed him a sparkling, delicious world, and above all he found her scent refreshing."
msgstr "　キラキラするモノ、美味しいモノを教えてくれたし、なにより匂いがすっきりしている。"

#. Occurrence C_0:1016:16740: scene=C_0
#: C_0:1016
msgctxt "text_id=16740 | speaker=unknown"
msgid "  To him, the world was divided into what was cool and what was not."
msgstr "　彼にとっての良し悪しの基準は、単純に「格好いい」か「格好悪い」か。"

#. Occurrence C_0:1021:16741: scene=C_0
#: C_0:1021
msgctxt "text_id=16741 | speaker=unknown"
msgid "  Your preference in leisure pursuits were of no consequence to him, and he never took gender into account."
msgstr "　趣味嗜好、外見性別は問わない。"

#. Occurrence C_0:1026:16742: scene=C_0
#: C_0:1026
msgctxt "text_id=16742 | speaker=unknown"
msgid "  The only thing that mattered to him was whether a person's life was logical, and therefore \"cool.\""
msgstr "　何であろうと、その生き方に筋が通っているのなら「格好のいい」匂いがする。"

#. Occurrence C_0:1036:16743: scene=C_0
#: C_0:1036
msgctxt "text_id=16743 | speaker=unknown"
msgid "  Touko Aozaki had her faults, but she smelled good."
msgstr "　蒼崎橙子は、色々とねじまがっているが、彼にしてみるといい匂いの人間なのだった。"

#. Occurrence C_0:1081:16744: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_0_0002; voice_prefix=A20; voice_category=11; scene=C_0
#: C_0:1081
msgctxt "text_id=16744 | speaker=touko"
msgid "\"Finished your lunch, Beo?\""
msgstr "「ベオ、昼食は済ませたか？」"

#. Occurrence C_0:1101:16745: scene=C_0
#: C_0:1101
msgctxt "text_id=16745 | speaker=unknown"
msgid "  Beo's master entered the classroom, presumably done with her traps for the day."
msgstr "　廊下の仕掛けが済んだのか、教室に<件|くだん>の主人が入ってくる。"

#. Occurrence C_0:1118:16746: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_0_0003; voice_prefix=A20; voice_category=11; scene=C_0
#: C_0:1118
msgctxt "text_id=16746 | speaker=touko"
msgid "\"It's showtime tonight. Just keep it together until then.\""
msgstr "「夜が本番だ。それまで、あまりハメを外すなよ」"

#. Occurrence C_0:1124:16747: scene=C_0
#: C_0:1124
msgctxt "text_id=16747 | speaker=unknown"
msgid "  Sometimes-like now-she would nag him, but on the whole his master pleased him."
msgstr "　この通り少々口やかましいところがあるが、彼はこの主人を基本的に気に入っている。"

#. Occurrence C_0:1144:16748: scene=C_0
#: C_0:1144
msgctxt "text_id=16748 | speaker=unknown"
msgid "  In reality, the contract binding her to him was not particularly powerful;"
msgstr "　実際のところ、<彼|ベオ>を縛っている彼女の契約はさして強力なものでもない。"

#. Occurrence C_0:1149:16749: scene=C_0
#: C_0:1149
msgctxt "text_id=16749 | speaker=unknown"
msgid "  if he wanted to, he could tear her to pieces at any time."
msgstr "　<彼|・>が本気になれば<噛|か>み<千|ち><切|ぎ>れる程度のものだ。"

#. Occurrence C_0:1159:16750: scene=C_0
#: C_0:1159
msgctxt "text_id=16750 | speaker=unknown"
msgid "  No human could restrain him."
msgstr "　彼を縛り付けられる人間などいる筈がない。"

#. Occurrence C_0:1221:16751: scene=C_0
#: C_0:1221
msgctxt "text_id=16751 | speaker=unknown"
msgid "  However, he had no intention of killing Touko in exchange for his freedom."
msgstr "　が、そうは言っても、橙子を殺して自由になる気もない。"

#. Occurrence C_0:1226:16752: scene=C_0
#: C_0:1226
msgctxt "text_id=16752 | speaker=unknown"
msgid "  And there was a reason for this."
msgstr "　その理由が見あたらない。"

#. Occurrence C_0:1231:16753: scene=C_0
#: C_0:1231
msgctxt "text_id=16753 | speaker=unknown"
msgid "  In order to move about freely in human society, he needed someone like her."
msgstr "　彼が人間社会で気ままにやっていくのには、便利な人間が必要なのだ。"

#. Occurrence C_0:1236:16754: scene=C_0
#: C_0:1236
msgctxt "text_id=16754 | speaker=unknown"
msgid "  As long as she did not offend him, he had no reason to rock the boat."
msgstr "　よほど彼の気分を害さないかぎり、この主人をどうこうするつもりはない。"

#. Occurrence C_0:1260:16755: scene=C_0
#: C_0:1260
msgctxt "text_id=16755 | speaker=unknown"
msgid "  However..."
msgstr "　もっとも―――"

#. Occurrence C_0:1298:16756: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_0_0002; voice_prefix=A50; voice_category=12; scene=C_0
#: C_0:1298
msgctxt "text_id=16756 | speaker=beo"
msgid "\"Finally, the main event! I was getting tired of waiting, Miss Touko.\""
msgstr "「“やっと本番か。<待|・><た|・><せ|・><す|・><ぎ|・>だよ、トーコさん”」"

#. Occurrence C_0:1303:16757: scene=C_0
#: C_0:1303
msgctxt "text_id=16757 | speaker=unknown"
msgid "  ...the promise she had made him in his cave and the reality of their situation had begun to come apart at the seams."
msgstr "　彼を連れ出した時の約束と、現実が少しズレはじめている。"

#. Occurrence C_0:1310:16758: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_0_0004; voice_prefix=A20; voice_category=11; scene=C_0
#: C_0:1310
msgctxt "text_id=16758 | speaker=touko"
msgid "\"Come here. I'll let you fight the most powerful Mystic there is.\""
msgstr "“来い。最高の神秘と戦わせてやる”"

#. Occurrence C_0:1316:16759: scene=C_0
#: C_0:1316
msgctxt "text_id=16759 | speaker=unknown"
msgid "  He was compliant up to now, but his patience was wearing thin-the fight with the newest Magician last night was an enormous letdown."
msgstr "　その口車に乗って今まで従ってきたが、そろそろ我慢の限界だ。待ちに待った昨夜の戦いは特に酷い。“最新の魔法使い”なんて、名前負けもいいところだった。"

#. Occurrence C_0:1337:16760: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_0_0005; voice_prefix=A20; voice_category=11; scene=C_0
#: C_0:1337
msgctxt "text_id=16760 | speaker=touko"
msgid "\"Oh hush. I was just as disappointed as you were.\""
msgstr "「そう言うな。私も昨日は拍子抜けだったんだから」"

#. Occurrence C_0:1343:16761: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_0_0003; voice_prefix=A50; voice_category=12; scene=C_0
#: C_0:1343
msgctxt "text_id=16761 | speaker=beo"
msgid "\"...I'm not that bummed. But why won't the girl use it? Because she can't?\""
msgstr "「“……いいけどね。実はあの娘、使わないんじゃなくて、使えないだけじゃないの？”」"

#. Occurrence C_0:1368:16762: scene=C_0
#: C_0:1368
msgctxt "text_id=16762 | speaker=unknown"
msgid "  His master's expression turned serious."
msgstr "　む、と主人の顔が険しくなる。"

#. Occurrence C_0:1373:16763: scene=C_0
#: C_0:1373
msgctxt "text_id=16763 | speaker=unknown"
msgid "  Not in agreement at the wolf's question, though."
msgstr "　彼の疑問に賛同しての事ではない。"

#. Occurrence C_0:1378:16764: scene=C_0
#: C_0:1378
msgctxt "text_id=16764 | speaker=unknown"
msgid "  For she had already asked herself the same and many other similar questions."
msgstr "　ソレが<あ|・><る|・>か<な|・><い|・>かの問答など、彼女はとっくに通り越している。"

#. Occurrence C_0:1424:16765: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_0_0006; voice_prefix=A20; voice_category=11; scene=C_0
#: C_0:1424
msgctxt "text_id=16765 | speaker=touko"
msgid "\"...No. Because she'd be better off dying than to use it, I suppose.\""
msgstr "「……いや。使うぐらいなら死んだ方がまし……なのかもな」"

#. Occurrence C_0:1430:16766: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_0_0004; voice_prefix=A50; voice_category=12; scene=C_0
#: C_0:1430
msgctxt "text_id=16766 | speaker=beo"
msgid "\"That doesn't make any sense! She almost died because she didn't use it.\""
msgstr "「“？？　そんなバカな事があるの？　使わないと死んじゃう状態だったんだよ？”」"

#. Occurrence C_0:1441:16767: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_0_0007; voice_prefix=A20; voice_category=11; scene=C_0
#: C_0:1441
msgctxt "text_id=16767 | speaker=touko"
msgid "\"Which proves my point...\""
msgstr "「だから、そんなバカな考えが成立するぐらい―――」"

#. Occurrence C_0:1464:16768: scene=C_0
#: C_0:1464
msgctxt "text_id=16768 | speaker=unknown"
msgid "  \"That it must be too terrifying to use,\" Touko finished in her head."
msgstr "　おぞましいモノなんだろう、と。"

#. Occurrence C_0:1469:16769: scene=C_0
#: C_0:1469
msgctxt "text_id=16769 | speaker=unknown"
msgid "  She stopped short of voicing it, and chuckled at her emotional outburst."
msgstr "　そう口にしかけて、彼女は感傷的な自分を<嘲|わ><笑|ら>うように首を振った。"

#. Occurrence C_0:1527:16770: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_0_0008; voice_prefix=A20; voice_category=11; scene=C_0
#: C_0:1527
msgctxt "text_id=16770 | speaker=touko"
msgid "\"Sure, I can't even imagine what it must be."
msgstr "「どれほどのものか想像がつかないのは確かだ。"

#. Occurrence C_0:1533:16771: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_0_0009; voice_prefix=A20; voice_category=11; scene=C_0
#: C_0:1533
msgctxt "text_id=16771 | speaker=touko"
msgid "  Still, this changes nothing. Whatever sort of miraculous Mystic her Magic is, as long as she remains a mage, she can't win.\""
msgstr "　だがまあ、根本は変わらないさ。魔法がどのような奇跡神秘の類であれ、魔術師である以上、青子に勝ち目はない」"

#. Occurrence C_0:1571:16772: scene=C_0
#: C_0:1571
msgctxt "text_id=16772 | speaker=unknown"
msgid "  With those words, Beo's master walked out of the room,"
msgstr "　そう残して、彼の主人は教室を後にした。"

#. Occurrence C_0:1576:16773: scene=C_0
#: C_0:1576
msgctxt "text_id=16773 | speaker=unknown"
msgid "  emphasizing that his role in all this was to face Aoko *only* at that very moment."
msgstr "　おまえの相手、おまえの出番は“その一点だけ”と念を押して。"

#. Occurrence C_0:1654:16774: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_0_0005; voice_prefix=A50; voice_category=12; scene=C_0
#: C_0:1654
msgctxt "text_id=16774 | speaker=beo"
msgid "\"True Magic, huh...?\""
msgstr "「“―――魔法、ねぇ―――”」"

#. Occurrence C_0:1662:16775: scene=C_0
#: C_0:1662
msgctxt "text_id=16775 | speaker=unknown"
msgid "  The bored look in his eyes shifted."
msgstr "　退屈に沈んでいた彼の目が、ぐにゃりと<歪|ゆが>む。"

#. Occurrence C_0:1667:16776: scene=C_0
#: C_0:1667
msgctxt "text_id=16776 | speaker=unknown"
msgid "  He recalled the taste of that girl, his long tongue sliding over his chainsaw-like fangs."
msgstr "　昨夜の少女の<腿|あじ>を思い出して、長い舌が、べろりとノコギリのような口を舐める。"

#. Occurrence C_0:1706:16777: scene=C_0
#: C_0:1706
msgctxt "text_id=16777 | speaker=unknown"
msgid "  Make no mistake, he would finish his meal."
msgstr "　もちろん、言われるまでもなく<蹂躙|じゅうりん>しよう。"

#. Occurrence C_0:1711:16778: scene=C_0
#: C_0:1711
msgctxt "text_id=16778 | speaker=unknown"
msgid "  He was the oldest werewolf; the golden god of the forest."
msgstr "　彼は最古の人狼、黄金の森の神。"

#. Occurrence C_0:1716:16779: scene=C_0
#: C_0:1716
msgctxt "text_id=16779 | speaker=unknown"
msgid "  For as long as he could remember-no, from the moment he appeared, he had been the most powerful creature of all."
msgstr "　物心ついた時―――いや、この地上に発生した時から、自身が“最も強い生き物の一つ”だと認識している。"

#. Occurrence C_0:1747:16780: scene=C_0
#: C_0:1747
msgctxt "text_id=16780 | speaker=unknown"
msgid "  All manmade Mystics were trash before him."
msgstr "　彼からすれば人間の手による神秘など<塵芥|ちりあくた>も同然。"

#. Occurrence C_0:1752:16781: scene=C_0
#: C_0:1752
msgctxt "text_id=16781 | speaker=unknown"
msgid "  Magecraft was laughable, and even Mystics―artificial miracles―were futile. Their very existence was an insult to him."
msgstr "　魔術など無駄であり、その上にある神秘―――人造の奇跡など無用だ。存在すら気にくわない。"

#. Occurrence C_0:1801:16782: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_0_0006; voice_prefix=A50; voice_category=12; scene=C_0
#: C_0:1801
msgctxt "text_id=16782 | speaker=beo"
msgid "\"After all, that was the deal. When the time comes, I dig right in.\""
msgstr "「“……もちろん。そういう契約だし、ちゃんと<平|たい>らげはするけれど”」"

#. Occurrence C_0:1810:16783: scene=C_0
#: C_0:1810
msgctxt "text_id=16783 | speaker=unknown"
msgid "  That was the extent of their pact."
msgstr "　契約はそこまで。"

#. Occurrence C_0:1815:16784: scene=C_0
#: C_0:1815
msgctxt "text_id=16784 | speaker=unknown"
msgid "  Once he had dealt with this so-called True Magic, he was free."
msgstr "　魔法とやらを食い破った後、どうするかは彼の自由だ。"

#. Occurrence C_0:1844:16785: scene=C_0
#: C_0:1844
msgctxt "text_id=16785 | speaker=unknown"
msgid "  His eyes burned with the wolf inside of him,"
msgstr "　……いびつな瞳に、狼の<彩|いろ>が宿る。"

#. Occurrence C_0:1849:16786: scene=C_0
#: C_0:1849
msgctxt "text_id=16786 | speaker=unknown"
msgid "  his fanged maw twisting into a sadistic, beastly grin."
msgstr "　それは<淫蕩|いんとう>に<耽|ふけ>る、<嗜虐|しぎゃく>に満ちた、<卑|いや>しい獣の笑みだった。"

#. Occurrence C_1:63:16787: scene=C_1
#: C_1:63
msgctxt "text_id=16787 | speaker=unknown"
msgid "  It was just past 7:00 p.m."
msgstr "　午後七時過ぎ。"

#. Occurrence C_1:68:16788: scene=C_1
#: C_1:68
msgctxt "text_id=16788 | speaker=unknown"
msgid "  Misaki High School's old building stood silently."
msgstr "　三咲高校の校舎は、完全に<睡没|すいぼつ>していた。"

#. Occurrence C_1:73:16789: scene=C_1
#: C_1:73
msgctxt "text_id=16789 | speaker=unknown"
msgid "  While light from the city reached the area, the forest and mountains kept the area hushed."
msgstr "　街から夜の明かりは届いているものの、校舎周辺の山林は静まりかえっている。"

#. Occurrence C_1:116:16790: scene=C_1
#: C_1:116
msgctxt "text_id=16790 | speaker=unknown"
msgid "  Nothing unusual."
msgstr "　それも無理からぬ事だ。"

#. Occurrence C_1:121:16791: scene=C_1
#: C_1:121
msgctxt "text_id=16791 | speaker=unknown"
msgid "  During winter vacation, the old building-now still covered in yesterday's snow-was rarely used."
msgstr "　冬休み中、校舎は数えるほどしか使われておらず、校庭は昨夜からの雪に包まれている。"

#. Occurrence C_1:126:16792: scene=C_1
#: C_1:126
msgctxt "text_id=16792 | speaker=unknown"
msgid "  Without signs of life, such unused structures were mere monuments of what once was, nothing more."
msgstr "　……使う者のいない建造物は、その時点で<慰霊碑|モニュメント>と変わらなくなる。"

#. Occurrence C_1:131:16793: scene=C_1
#: C_1:131
msgctxt "text_id=16793 | speaker=unknown"
msgid "  The old school building would remain that way until the start of the new semester."
msgstr "　いま死者に近いこの建物は、新学期まで息を吹き返す事はない。"

#. Occurrence C_1:177:16794: scene=C_1
#: C_1:177
msgctxt "text_id=16794 | speaker=unknown"
msgid "  Behind it, the vast forest grew darker by the minute."
msgstr "　その背後に広がる森は、更に闇を増している。"

#. Occurrence C_1:182:16795: scene=C_1
#: C_1:182
msgctxt "text_id=16795 | speaker=unknown"
msgid "  If the building had died in just under two weeks of vacation, what had become of forest over the years?"
msgstr "　二週間たらずの休みで校舎が死に絶えるのなら、数年にわたり忘れ去られてきた森は如何なるものか。"

#. Occurrence C_1:203:16796: scene=C_1
#: C_1:203
msgctxt "text_id=16796 | speaker=unknown"
msgid "  The wall of overgrown trees filtered out the noise of the city, and most of the moonlight."
msgstr "　木々の壁の向こうは、街の喧噪はおろか、月明かりでさえ入れずにいる。"

#. Occurrence C_1:208:16797: scene=C_1
#: C_1:208
msgctxt "text_id=16797 | speaker=unknown"
msgid "  An otherworldly realm had taken root, not even two miles away from town."
msgstr "　人々の住まう町から、三キロも離れていない魔境。"

#. Occurrence C_1:213:16798: scene=C_1
#: C_1:213
msgctxt "text_id=16798 | speaker=unknown"
msgid "  Piercing the cold night air, footsteps crunched through the powdery snow."
msgstr "　そんな、しんしんと凍てつく夜気の中、新雪を踏みしだく足音が二つ。"

#. Occurrence C_1:251:16799: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_1_0000; voice_prefix=A40; voice_category=2; scene=C_1
#: C_1:251
msgctxt "text_id=16799 | speaker=alice"
msgid "\"No traps this way."
msgstr "「このあたりに仕掛けはなさそうね。"

#. Occurrence C_1:260:16800: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_1_0001; voice_prefix=A40; voice_category=2; scene=C_1
#: C_1:260
msgctxt "text_id=16800 | speaker=alice"
msgid "  So... what's the plan? Sneak into the old school building?\""
msgstr "　……それで、どうするの？　このまま旧校舎に忍びこむ？」"

#. Occurrence C_1:297:16801: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0000; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:297
msgctxt "text_id=16801 | speaker=aoko"
msgid "\"Yeah, right. She already knows we're here."
msgstr "「まさか。私らがやってきたコトなんて、とっくにバレてるわ。"

#. Occurrence C_1:304:16802: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0001; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:304
msgctxt "text_id=16802 | speaker=aoko"
msgid "Why hide? And what would we do once we were in her hideout? We're not here to steal anything.\""
msgstr "隠れても意味はないし、なにより、敵の<工房|アジト>に入ってどうするのよ。盗みが目的じゃないでしょ、今回は」"

#. Occurrence C_1:338:16803: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_1_0002; voice_prefix=A40; voice_category=2; scene=C_1
#: C_1:338
msgctxt "text_id=16803 | speaker=alice"
msgid "\"What about the element of surprise?\""
msgstr "「……後ろから斬りつけるのは、強盗と言うのじゃなくて？」"

#. Occurrence C_1:384:16804: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0002; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:384
msgctxt "text_id=16804 | speaker=aoko"
msgid "\"If we could do that, it'd make our job easier, but playing ninja isn't really my thing... nor yours, for that matter."
msgstr "「……それができれば苦労はないんだけどね。まあ、忍者の真似事は私……というか、有珠の芸風じゃないでしょ。"

#. Occurrence C_1:390:16805: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0003; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:390
msgctxt "text_id=16805 | speaker=aoko"
msgid "  And anyway...\""
msgstr "　そもそも―――」"

#. Occurrence C_1:427:16806: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0004; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:427
msgctxt "text_id=16806 | speaker=aoko"
msgid "\"...Anyway,"
msgstr "「―――そもそも。"

#. Occurrence C_1:433:16807: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0005; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:433
msgctxt "text_id=16807 | speaker=aoko"
msgid "  ...we're not the only ones out for blood tonight.\""
msgstr "　やる気満々なのは、こっちもあっちも同じってコト」"

#. Occurrence C_1:439:16808: scene=C_1
#: C_1:439
msgctxt "text_id=16808 | speaker=unknown"
msgid "  The sound of their footsteps stopped in unison."
msgstr "　雪を踏むふたりの足音が、言い合わせたように停止する。"

#. Occurrence C_1:479:16809: scene=C_1
#: C_1:479
msgctxt "text_id=16809 | speaker=unknown"
msgid "  The old forgotten Misaki High School building stood before them."
msgstr "　三咲高校の裏山に残る旧校舎。"

#. Occurrence C_1:484:16810: scene=C_1
#: C_1:484
msgctxt "text_id=16810 | speaker=unknown"
msgid "  What used to be the school yard was now a barren snowscape."
msgstr "　かつての<校庭|グラウンド>は一面の雪原となっていた。"

#. Occurrence C_1:489:16811: scene=C_1
#: C_1:489
msgctxt "text_id=16811 | speaker=unknown"
msgid "  Reclaimed by the forest, the building looked a shell of its former self."
msgstr "　森に取り残された建物は、もの言わぬ死者のようだ。"

#. Occurrence C_1:494:16812: scene=C_1
#: C_1:494
msgctxt "text_id=16812 | speaker=unknown"
msgid "  The surrounding trees resembled standing mourners at a funeral."
msgstr "　そんな時代の残骸を<祀|まつ>るように、木々は壁となって周囲を<覆|おお>っている。"

#. Occurrence C_1:532:16813: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0000; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:532
msgctxt "text_id=16813 | speaker=touko"
msgid "\"Talk about impatient. There's still four hours until the time limit.\""
msgstr "「せっかちなお嬢さん<方|がた>だ。タイムリミットまで、あと四時間はあるというのに」"

#. Occurrence C_1:568:16814: scene=C_1
#: C_1:568
msgctxt "text_id=16814 | speaker=unknown"
msgid "  Alone in the middle of the white altar was the lone, Scarred Red mage."
msgstr "　その白い祭壇の中心に、橙色の魔術師が一人。"

#. Occurrence C_1:573:16815: scene=C_1
#: C_1:573
msgctxt "text_id=16815 | speaker=unknown"
msgid "  As she came out from the forest, Aoko lowered herself slightly, scowling at her distant target."
msgstr "　森を抜けてきた少女―――蒼崎青子はわずかに腰を落として、遠方の標的を睨む。"

#. Occurrence C_1:578:16816: scene=C_1
#: C_1:578
msgctxt "text_id=16816 | speaker=unknown"
msgid "  Next to her, Alice stood motionless."
msgstr "　青子の<傍|かたわ>らに立つ久遠寺有珠は指一本動かさない。"

#. Occurrence C_1:603:16817: scene=C_1
#: C_1:603
msgctxt "text_id=16817 | speaker=unknown"
msgid "  The bare branches of the trees cast long, thorny shadows."
msgstr "　枝葉を落とした木々の影は<茨|いばら>を思わせる。"

#. Occurrence C_1:608:16818: scene=C_1
#: C_1:608
msgctxt "text_id=16818 | speaker=unknown"
msgid "  Aoko was reminded of Sleeping Beauty, except this mage wasn't nearly as pleasant as the princess in that."
msgstr "　眠り続ける姫の童話を連想した青子だが、あの魔術師はお姫さまほど<幸福|しあわせ>な性格はしていなかったらしい。"

#. Occurrence C_1:613:16819: scene=C_1
#: C_1:613
msgctxt "text_id=16819 | speaker=unknown"
msgid "  Not to mention she wasn't sleeping... and there was no prince."
msgstr "　王子を待つのも、眠っているのも性に合わない、と。"

#. Occurrence C_1:618:16820: scene=C_1
#: C_1:618
msgctxt "text_id=16820 | speaker=unknown"
msgid "  Regardless, this princess came out of her schoolhouse castle to greet her challengers."
msgstr "　旧校舎という城に棲んでいた姫は、現れた挑戦者を堂々と出迎えたのだから。"

#. Occurrence C_1:669:16821: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0001; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:669
msgctxt "text_id=16821 | speaker=touko"
msgid "\"Pushing yourself in that condition?"
msgstr "「その体で無理をして。"

#. Occurrence C_1:675:16822: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0002; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:675
msgctxt "text_id=16822 | speaker=touko"
msgid "  You do make your big sister worry, Aoko.\""
msgstr "　貴女のそういうところ、姉としてどうかと思うわ青子」"

#. Occurrence C_1:694:16823: scene=C_1
#: C_1:694
msgctxt "text_id=16823 | speaker=unknown"
msgid "  Touko grinned faintly."
msgstr "　橙子は微笑みを浮かべている。"

#. Occurrence C_1:699:16824: scene=C_1
#: C_1:699
msgctxt "text_id=16824 | speaker=unknown"
msgid "  Aoko fought back the urge to respond."
msgstr "　文句のひとつでも返したい青子だが、ここは我慢と口を<噤|つぐ>んだ。"

#. Occurrence C_1:704:16825: scene=C_1
#: C_1:704
msgctxt "text_id=16825 | speaker=unknown"
msgid "  Meanwhile, Alice stood in silence, uninterested in sibling rivalry."
msgstr "　有珠は一律で無言。両者の因縁に関心はないと、その態度で示している。"

#. Occurrence C_1:751:16826: scene=C_1
#: C_1:751
msgctxt "text_id=16826 | speaker=unknown"
msgid "  Touko stood about a hundred feet away."
msgstr "　両陣営の距離は三十メートルほど。"

#. Occurrence C_1:756:16827: scene=C_1
#: C_1:756
msgctxt "text_id=16827 | speaker=unknown"
msgid "  With their senses sharpened through magecraft and the silence of the forest, they could hear each other perfectly."
msgstr "　互いの声が届くのは森の静けさと、魔術によって強化された五感の<賜|たまもの>だ。"

#. Occurrence C_1:762:16828: scene=C_1
#: C_1:762
msgctxt "text_id=16828 | speaker=unknown"
msgid "  The golden wolf was nowhere to be seen."
msgstr "　蒼崎橙子の<傍|かたわ>らに金狼の姿はない。"

#. Occurrence C_1:767:16829: scene=C_1
#: C_1:767
msgctxt "text_id=16829 | speaker=unknown"
msgid "  Touko faced the two girls alone."
msgstr "　彼女は体ひとつで青子たちと対峙している。"

#. Occurrence C_1:825:16830: scene=C_1
#: C_1:825
msgctxt "text_id=16830 | speaker=unknown"
msgid "  Alice's black overcoat and winter hat were typical items of clothing for a mage battle."
msgstr "　有珠は黒い<外套|コート>に帽子をかぶった、典型的な魔術戦の出で立ち。"

#. Occurrence C_1:830:16831: scene=C_1
#: C_1:830
msgctxt "text_id=16831 | speaker=unknown"
msgid "  A few paces in front of her was Aoko, whose combat garb was comparatively out of place: a Misaki High School uniform."
msgstr "　その有珠より半歩前に出ている青子の服装は、場にそぐわない事この上ない、三咲高校の学生服だ。"

#. Occurrence C_1:875:16832: scene=C_1
#: C_1:875
msgctxt "text_id=16832 | speaker=unknown"
msgid "  She had asked Alice to bring a change of clothes for her, but there must have been some misunderstanding..."
msgstr "　有珠に着替えを持ってくるよう頼んだところ、何を勘違いしたのか、私服ではなく制服を持ってきた為である。"

#. Occurrence C_1:881:16833: scene=C_1
#: C_1:881
msgctxt "text_id=16833 | speaker=unknown"
msgid "  Though it was a trivial miscommunication, Touko seemed to think it had some special meaning."
msgstr "　そんな些細な事情なのだが、橙子は特別な意味があると見たらしい。"

#. Occurrence C_1:927:16834: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0003; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:927
msgctxt "text_id=16834 | speaker=touko"
msgid "\"Before we start, mind if I ask something?"
msgstr "「ところで、始める前にひとついいかな。"

#. Occurrence C_1:943:16835: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0004; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:943
msgctxt "text_id=16835 | speaker=touko"
msgid "  I can't help but be curious-and this is probably my last chance to ask-but is that seriously what you're going to fight in, Aoko?\""
msgstr "　気になって仕方がないし、この先、機会もないだろうから訊くんだけど……貴女の戦闘服ってそれなの、青子？」"

#. Occurrence C_1:970:16836: scene=C_1
#: C_1:970
msgctxt "text_id=16836 | speaker=unknown"
msgid "  Touko spoke clearly, and despite the distance"
msgstr "　離れた距離も関係なく、橙子の声はよく響いた。"

#. Occurrence C_1:975:16837: scene=C_1
#: C_1:975
msgctxt "text_id=16837 | speaker=unknown"
msgid "  was able to communicate her deep-seated scorn without trouble."
msgstr "　心底から不快そうな、侮辱というより軽蔑すらこもった<韻|いん>も、のこさず聞き取れる。"

#. Occurrence C_1:1005:16838: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0006; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:1005
msgctxt "text_id=16838 | speaker=aoko"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence C_1:1010:16839: scene=C_1
#: C_1:1010
msgctxt "text_id=16839 | speaker=unknown"
msgid "  Aoko would rather attack than engage in small talk, but she decided to take the bait."
msgstr "　無駄話はせず、ほぼ奇襲のカタチで橙子を仕留めるつもりだった青子だが、さすがに今のは無視できない。"

#. Occurrence C_1:1038:16840: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0007; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:1038
msgctxt "text_id=16840 | speaker=aoko"
msgid "\"Don't lie. You've had plenty of chances to ask me. Four times, including today."
msgstr "「そんなワケないでしょ。今までこういう機会が多かっただけよ。数えるなら今日を含めて四回しかないわ。"

#. Occurrence C_1:1051:16841: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0008; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:1051
msgctxt "text_id=16841 | speaker=aoko"
msgid "  ...Well, this is my 'job' right now, so I think it's fitting. Besides, my fashion's ahead of the times.\""
msgstr "　……ま、私はまだ<現|・><役|・>だからそれも悪くはないかもしれないけど？　いつか流行るでしょ、こういうのも」"

#. Occurrence C_1:1064:16842: scene=C_1
#: C_1:1064
msgctxt "text_id=16842 | speaker=unknown"
msgid "  Aoko was sure to emphasize her words."
msgstr "　現役、という単語を強調する青子。"

#. Occurrence C_1:1069:16843: scene=C_1
#: C_1:1069
msgctxt "text_id=16843 | speaker=unknown"
msgid "  For a split second, Touko's eyes narrowed."
msgstr "　一瞬、橙子の瞳が青子もかくやといった鋭さを帯びた。"

#. Occurrence C_1:1107:16844: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0005; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:1107
msgctxt "text_id=16844 | speaker=touko"
msgid "\"...Figures. Same bad taste, as always.\""
msgstr "「……呆れたな。あいかわらずのローセンスだ」"

#. Occurrence C_1:1130:16845: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0009; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:1130
msgctxt "text_id=16845 | speaker=aoko"
msgid "\"Thanks. It's actually a relief hearing that from a creepy puppet-maker.\""
msgstr "「それはどうも、人形を実の妹に見立てる異常者にそう言われるなら、一周まわって安心よ」"

#. Occurrence C_1:1143:16846: scene=C_1
#: C_1:1143
msgctxt "text_id=16846 | speaker=unknown"
msgid "  With that, the two fell silent and glared at each other."
msgstr "　それきり、ふたりは無言で見つめ合った。"

#. Occurrence C_1:1148:16847: scene=C_1
#: C_1:1148
msgctxt "text_id=16847 | speaker=unknown"
msgid "  Their bloodlust cut through the thick, cold air like a knife."
msgstr "　凍える大気に、<姉妹|しまい>間<独特|どくとく>の殺意が火花を散らす。"

#. Occurrence C_1:1226:16848: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_1_0003; voice_prefix=A40; voice_category=2; scene=C_1
#: C_1:1226
msgctxt "text_id=16848 | speaker=alice"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence C_1:1232:16849: scene=C_1
#: C_1:1232
msgctxt "text_id=16849 | speaker=unknown"
msgid "  While the two of them sized each other up, Alice surveyed the area around Touko."
msgstr "　ふたりが<牽制|けんせい>し合う中、有珠は<橙|て><子|き>の周囲を解析する。"

#. Occurrence C_1:1252:16850: scene=C_1
#: C_1:1252
msgctxt "text_id=16850 | speaker=unknown"
msgid "  There was no indication anyone or anything was lying in wait near her."
msgstr "　……橙子の周りに何者かが<潜|ひそ>んでいる気配はない。"

#. Occurrence C_1:1257:16851: scene=C_1
#: C_1:1257
msgctxt "text_id=16851 | speaker=unknown"
msgid "  Perhaps she should see if the werewolf was still in the old school building."
msgstr "　人狼はいまだ旧校舎に残っていると見るべきか。"

#. Occurrence C_1:1263:16852: scene=C_1
#: C_1:1263
msgctxt "text_id=16852 | speaker=unknown"
msgid "  Maybe Touko didn't feel like Aoko and Alice were much of a threat in their injured state."
msgstr "　傷ついた青子と有珠、二人でようやく一人分の戦力と見ているのか―――"

#. Occurrence C_1:1269:16853: scene=C_1
#: C_1:1269
msgctxt "text_id=16853 | speaker=unknown"
msgid "Or was she really not expecting a counterattack so early, so the werewolf wasn't ready?"
msgstr "それとも本当に、この時間での反撃を予測しておらず、人狼の準備が整っていないのか。"

#. Occurrence C_1:1301:16854: scene=C_1
#: C_1:1301
msgctxt "text_id=16854 | speaker=unknown"
msgid "  After some contemplation, Alice surmised it was the former."
msgstr "　静かな心持ちで、有珠は前者だと判断した。"

#. Occurrence C_1:1306:16855: scene=C_1
#: C_1:1306
msgctxt "text_id=16855 | speaker=unknown"
msgid "  She really was going to fight alone."
msgstr "　敵は<単身|ひとり>で戦うつもりだ。"

#. Occurrence C_1:1311:16856: scene=C_1
#: C_1:1311
msgctxt "text_id=16856 | speaker=unknown"
msgid "  Her arsenal comprised her Mystic Eyes and rune magecraft."
msgstr "　<橙|て><子|き>の武装は、魔眼と修得しているルーン。"

#. Occurrence C_1:1316:16857: scene=C_1
#: C_1:1316
msgctxt "text_id=16857 | speaker=unknown"
msgid "  That was more than enough to deal with Aoko and Alice in their current state."
msgstr "　それだけで現状の青子と有珠を処理して余りあるのだから。"

#. Occurrence C_1:1336:16858: scene=C_1
#: C_1:1336
msgctxt "text_id=16858 | speaker=unknown"
msgid "(...Alice, all I need is one shot.)"
msgstr "“―――有珠。初撃で決めるから”"

#. Occurrence C_1:1362:16859: scene=C_1
#: C_1:1362
msgctxt "text_id=16859 | speaker=unknown"
msgid "  Aoko signaled to Alice behind her with the movement of her finger."
msgstr "　青子は背後の有珠へ、指先の動きだけでそう伝えた。"

#. Occurrence C_1:1367:16860: scene=C_1
#: C_1:1367
msgctxt "text_id=16860 | speaker=unknown"
msgid "  Alice had no objections."
msgstr "　有珠に異論はない。"

#. Occurrence C_1:1372:16861: scene=C_1
#: C_1:1372
msgctxt "text_id=16861 | speaker=unknown"
msgid "  The original plan was for her to keep the werewolf busy."
msgstr "　……当初の予定では人狼は有珠が引き付け、"

#. Occurrence C_1:1377:16862: scene=C_1
#: C_1:1377
msgctxt "text_id=16862 | speaker=unknown"
msgid "  With the mirror as a backup, Aoko was hoping to catch Touko off-guard."
msgstr "　青子は『鏡』のバックアップを受けつつ、橙子を奇襲する算段だった。"

#. Occurrence C_1:1397:16863: scene=C_1
#: C_1:1397
msgctxt "text_id=16863 | speaker=unknown"
msgid "  They had a few other cards up their sleeves, but the fact remained that as mages their attacks wouldn't affect the werewolf."
msgstr "　他にも幾つか奥の手はあったが、青子たちが魔術師である以上、何であれ人狼には通じない。"

#. Occurrence C_1:1402:16864: scene=C_1
#: C_1:1402
msgctxt "text_id=16864 | speaker=unknown"
msgid "  So they decided to ignore it, and focus on taking out Touko."
msgstr "　なので人狼は無視し、橙子のみを標的にする。"

#. Occurrence C_1:1407:16865: scene=C_1
#: C_1:1407
msgctxt "text_id=16865 | speaker=unknown"
msgid "  Not the best strategy, but it was all the two of them could come up with."
msgstr "　都合のいい作戦ではあるが、ふたりにはそれしか選択の余地はなかったのだ。"

#. Occurrence C_1:1456:16866: scene=C_1
#: C_1:1456
msgctxt "text_id=16866 | speaker=unknown"
msgid "  ...But they had been thrown a curveball."
msgstr "　……が、事態は想定していたものと違っていた。"

#. Occurrence C_1:1461:16867: scene=C_1
#: C_1:1461
msgctxt "text_id=16867 | speaker=unknown"
msgid "  Touko had the upper hand, so she was reluctant to use the beast."
msgstr "　橙子は自軍の有利性から、人狼の出陣を<渋|しぶ>っている。"

#. Occurrence C_1:1467:16868: scene=C_1
#: C_1:1467
msgctxt "text_id=16868 | speaker=unknown"
msgid "  Aoko wasn't about to let this opportunity go to waste."
msgstr "　ならば、と青子は即断した。"

#. Occurrence C_1:1472:16869: scene=C_1
#: C_1:1472
msgctxt "text_id=16869 | speaker=unknown"
msgid "  By distracting her with sibling banter, she would settle things before the werewolf even showed up."
msgstr "　<和気藹々|わきあいあい>とした姉妹の談話の隙をついて、人狼が出てくる前に決着をつけるのみ、と。"

#. Occurrence C_1:1516:16870: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0011; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:1516
msgctxt "text_id=16870 | speaker=aoko"
msgid "\"My turn to ask a question."
msgstr "「じゃあ今度はこっちの番ね。"

#. Occurrence C_1:1560:16871: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0012; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:1560
msgctxt "text_id=16871 | speaker=aoko"
msgid "  How're the fields working out?\""
msgstr "　どう、結界の張り直しは進んでる？」"

#. Occurrence C_1:1599:16872: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0006; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:1599
msgctxt "text_id=16872 | speaker=touko"
msgid "\"Oh please. It's barely been a day. I haven't touched them yet. Can't rush these things."
msgstr "「まさか、昨日の今日よ。まだ手を付けてもいない。<急|せ>いては事をし損じる。"

#. Occurrence C_1:1606:16873: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0007; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:1606
msgctxt "text_id=16873 | speaker=touko"
msgid "Besides, I want what's inside the leylines, not the Bounded Fields. I have no plans to reset them."
msgstr "だいたい、私の目的は霊脈の奥にあるもので結界そのものじゃない。張り直しは予定にないさ。"

#. Occurrence C_1:1617:16874: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0008; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:1617
msgctxt "text_id=16874 | speaker=touko"
msgid "  Tearing into you is probably way faster than tearing into the land anyway.\""
msgstr "　まあ―――土地を<暴|あば>くなんて面倒な真似をするより、<貴女|おまえ>を暴いた方が早いのかもしれないが」"

#. Occurrence C_1:1668:16875: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0013; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:1668
msgctxt "text_id=16875 | speaker=aoko"
msgid "\"Hmph. I knew it."
msgstr "「ふん、やっぱりそれが目的だったのね。"

#. Occurrence C_1:1674:16876: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0014; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:1674
msgctxt "text_id=16876 | speaker=aoko"
msgid "  All the more reason I can't let you become a Magician.\""
msgstr "　……なら尚のこと、アンタを魔法使いにするワケにはいかないわ」"

#. Occurrence C_1:1718:16877: scene=C_1
#: C_1:1718
msgctxt "text_id=16877 | speaker=unknown"
msgid "  Aoko's blue eyes burned brightly with a fiery fighting spirit."
msgstr "　青い瞳に明確な戦意が<宿|やど>る。"

#. Occurrence C_1:1723:16878: scene=C_1
#: C_1:1723
msgctxt "text_id=16878 | speaker=unknown"
msgid "  Even though her sister was ready to pounce, Touko remained motionless but for her mouth, which twisted into a smirk."
msgstr "　今まさに仕掛けてきそうな妹の様子を見ても、橙子に動きはない。その唇が皮肉げに動くだけだ。"

#. Occurrence C_1:1744:16879: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0009; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:1744
msgctxt "text_id=16879 | speaker=touko"
msgid "\"A Magician, huh? Got to admit, I like the sound of that."
msgstr "「魔法使い、か。たしかにまだ執着はあるね。"

#. Occurrence C_1:1750:16880: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0010; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:1750
msgctxt "text_id=16880 | speaker=touko"
msgid "  The Magic Crests that weren't implanted in me, and the True Magic of the Aozaki family..."
msgstr "　私には移植されなかった魔術刻印と、蒼崎の伝える魔法の正体。"

#. Occurrence C_1:1757:16881: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0011; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:1757
msgctxt "text_id=16881 | speaker=touko"
msgid "But it's fine. I do want them, but I can get them on my own."
msgstr "だがもういいよ。欲しくはあるが、<到|・><達|・><す|・><れ|・><ば|・>どちらも自分で用意できる。"

#. Occurrence C_1:1784:16882: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0012; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:1784
msgctxt "text_id=16882 | speaker=touko"
msgid "  Oh, wait... Did you come here to show me your Magic, Aoko?\""
msgstr "　それとも……今ここで、私の為に魔法の正体を見せてくれるのかい、青子？」"

#. Occurrence C_1:1804:16883: scene=C_1
#: C_1:1804
msgctxt "text_id=16883 | speaker=unknown"
msgid "  Touko's words came out flatly, but her eyes mocked her sister."
msgstr "　橙子の瞳は、言葉とは裏腹に青子を<嘲|あざけ>っていた。"

#. Occurrence C_1:1814:16884: scene=C_1
#: C_1:1814
msgctxt "text_id=16884 | speaker=unknown"
msgid "  It was true, however, that if Aoko wanted to defeat Touko, her best chance would be to use this mysterious True Magic."
msgstr "　……青子が<橙|て><子|き>を排除したいのなら、正体の分からない『魔法』を使うのが最良であり、確実だ。"

#. Occurrence C_1:1819:16885: scene=C_1
#: C_1:1819
msgctxt "text_id=16885 | speaker=unknown"
msgid "  The only problem was that she couldn't."
msgstr "　だが青子にはそれが出来ない。"

#. Occurrence C_1:1824:16886: scene=C_1
#: C_1:1824
msgctxt "text_id=16886 | speaker=unknown"
msgid "  If she could, she would have used it to avoid being mauled last night."
msgstr "　出来るのなら昨夜の窮地で使用している。"

#. Occurrence C_1:1872:16887: scene=C_1
#: C_1:1872
msgctxt "text_id=16887 | speaker=unknown"
msgid "  Aoko Aozaki couldn't use True Magic."
msgstr "　蒼崎青子は魔法を使用できない。"

#. Occurrence C_1:1877:16888: scene=C_1
#: C_1:1877
msgctxt "text_id=16888 | speaker=unknown"
msgid "  Touko believed she needed to fulfill some kind of condition."
msgstr "　橙子はそれを何らかの条件付けと考えた。"

#. Occurrence C_1:1882:16889: scene=C_1
#: C_1:1882
msgctxt "text_id=16889 | speaker=unknown"
msgid "  The protection their grandfather placed on the formulae was to prohibit miracles from being easily realized."
msgstr "　祖父の<術式防護|プロテクト>が、安易な奇跡の発現を禁じているのだと。"

#. Occurrence C_1:1889:16890: scene=C_1
#: C_1:1889
msgctxt "text_id=16890 | speaker=unknown"
msgid "  However, that wasn't because he was concerned about the human world."
msgstr "　だが―――あの<祖父|おとこ>は、人の世を<顧|かえり>みる人格者ではない。"

#. Occurrence C_1:1895:16891: scene=C_1
#: C_1:1895
msgctxt "text_id=16891 | speaker=unknown"
msgid "  It was no exaggeration to say he'd feel nothing if Magic leveled the entire city."
msgstr "　大げさな話でなく、魔法の発現でこの街が消え去っても何の感慨も浮かべまい。"

#. Occurrence C_1:1915:16892: scene=C_1
#: C_1:1915
msgctxt "text_id=16892 | speaker=unknown"
msgid "  The truth was, *True Magic never had any conditions.*"
msgstr "　初めから、<魔|・><法|・><に|・><条|・><件|・><付|・><け|・><な|・><ど|・><な|・><い|・>。"

#. Occurrence C_1:1963:16893: scene=C_1
#: C_1:1963
msgctxt "text_id=16893 | speaker=unknown"
msgid "  Aoko was being held back by trauma."
msgstr "　青子を縛っているものはトラウマにすぎない。"

#. Occurrence C_1:1968:16894: scene=C_1
#: C_1:1968
msgctxt "text_id=16894 | speaker=unknown"
msgid "  These five privileges, the only powers of their kind, were bound by cognitive seals."
msgstr "　地上でただ五つの特権を、精神的な<枷|かせ>で縛っている。"

#. Occurrence C_1:1973:16895: scene=C_1
#: C_1:1973
msgctxt "text_id=16895 | speaker=unknown"
msgid "  That's why Touko looked down on her naive little sister."
msgstr "　故に、橙子の瞳は未熟な妹を<嘲|あざけ>るのだ。"

#. Occurrence C_1:1978:16896: scene=C_1
#: C_1:1978
msgctxt "text_id=16896 | speaker=unknown"
msgid "  So weak. A body incapable of handling Magic could be cut down with a mere sword."
msgstr "　その弱さ。人の身に背負いきれない『魔法』なぞ、一振りの剣にも劣ると。"

#. Occurrence C_1:2049:16897: scene=C_1
#: C_1:2049
msgctxt "text_id=16897 | speaker=unknown"
msgid "  Aoko knew that better than anyone else, which is why she couldn't forgive her sister's ridicule."
msgstr "　それを何よりも自覚しているからこそ、青子にはその嘲笑は許せない。"

#. Occurrence C_1:2054:16898: scene=C_1
#: C_1:2054
msgctxt "text_id=16898 | speaker=unknown"
msgid "  Just try using True Magic, huh?"
msgstr "　魔法を使ってみせろ？"

#. Occurrence C_1:2091:16899: scene=C_1
#: C_1:2091
msgctxt "text_id=16899 | speaker=unknown"
msgid "  A pathetic taunt."
msgstr "　なんて安い挑発。"

#. Occurrence C_1:2096:16900: scene=C_1
#: C_1:2096
msgctxt "text_id=16900 | speaker=unknown"
msgid "  If that was how she wanted to play, then so be it..."
msgstr "　そんなもの、言われるまでもなく―――"

#. Occurrence C_1:2119:16901: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0015; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:2119
msgctxt "text_id=16901 | speaker=aoko"
msgid "\"Have it your way!\""
msgstr "「ええ、お望みとあらばね――――――！」"

#. Occurrence C_1:2182:16902: scene=C_1
#: C_1:2182
msgctxt "text_id=16902 | speaker=unknown"
msgid "  With a burst of pure rage, Aoko made her move."
msgstr "　切りつけんばかりの殺気と共に、青子はスタートをきった。"

#. Occurrence C_1:2199:16903: scene=C_1
#: C_1:2199
msgctxt "text_id=16903 | speaker=unknown"
msgid "  Her colorless shoes sped across the untainted snowfield..."
msgstr "　―――<未到|みとう>の雪原に、無色の靴が駆け抜ける。"

#. Occurrence C_1:2250:16904: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0013; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:2250
msgctxt "text_id=16904 | speaker=touko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence C_1:2255:16905: scene=C_1
#: C_1:2255
msgctxt "text_id=16905 | speaker=unknown"
msgid "  ...like a stone skipping across the water."
msgstr "　まるで<水面|みなも>の飛び石だ。"

#. Occurrence C_1:2260:16906: scene=C_1
#: C_1:2260
msgctxt "text_id=16906 | speaker=unknown"
msgid "  As Aoko charged forward, she disappeared."
msgstr "　高速で橙子に向かう青子の体は、完全に“消失”していた。"

#. Occurrence C_1:2280:16907: scene=C_1
#: C_1:2280
msgctxt "text_id=16907 | speaker=unknown"
msgid "  Only her footprints advanced, like bullet holes in the snow."
msgstr "　足跡だけが<弾痕|だんこん>のように迫ってくる。"

#. Occurrence C_1:2285:16908: scene=C_1
#: C_1:2285
msgctxt "text_id=16908 | speaker=unknown"
msgid "  Touko held her ground."
msgstr "　それを橙子は不動のまま待ち受けた。"

#. Occurrence C_1:2316:16909: scene=C_1
#: C_1:2316
msgctxt "text_id=16909 | speaker=unknown"
msgid "  Concealment was elementary magecraft."
msgstr "　姿隠しは簡単な魔術だ。"

#. Occurrence C_1:2321:16910: scene=C_1
#: C_1:2321
msgctxt "text_id=16910 | speaker=unknown"
msgid "  More than likely, the power came from one of Alice's trinkets."
msgstr "　おそらくは有珠が用意した小道具の力だろう。"

#. Occurrence C_1:2326:16911: scene=C_1
#: C_1:2326
msgctxt "text_id=16911 | speaker=unknown"
msgid "  It was a simple yet effective countermeasure to Mystic Eyes."
msgstr "　単純だが、効果的な魔眼対策である。"

#. Occurrence C_1:2331:16912: scene=C_1
#: C_1:2331
msgctxt "text_id=16912 | speaker=unknown"
msgid "  Touko's Mystic Eyes used the Lock property to bind an opponent; it did not have the Logos property to discern truth through an illusion."
msgstr "　<捕縛|ロック>の呪いに特化した橙子の魔眼は、不正を<見|み><抜|ぬ>き<明|あき>らかにする“<真理|ロゴス>”の特性を持っていない。"

#. Occurrence C_1:2336:16913: scene=C_1
#: C_1:2336
msgctxt "text_id=16913 | speaker=unknown"
msgid "  Once a magecraft's workings were revealed, its weakness was exposed."
msgstr "　仕組みを知られた魔術は、このようにたやすく打破される。"

#. Occurrence C_1:2388:16914: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0014; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:2388
msgctxt "text_id=16914 | speaker=touko"
msgid "(Still the same sloppy footwork.)"
msgstr "“足癖が悪いのも変わらず、か”"

#. Occurrence C_1:2394:16915: scene=C_1
#: C_1:2394
msgctxt "text_id=16915 | speaker=unknown"
msgid "  In a mere four seconds, her opponent had closed ten yards and was still speeding up."
msgstr "　既に四秒。十メートルもの距離を<詰|つ>め、さらに加速する姿なき襲撃者。"

#. Occurrence C_1:2399:16916: scene=C_1
#: C_1:2399
msgctxt "text_id=16916 | speaker=unknown"
msgid "  It appeared that she had given up on a mage battle, and was going to move in for melee."
msgstr "　魔術戦では敵わぬと見て、殴り合いならぬ蹴り合いを挑むつもりらしい。"

#. Occurrence C_1:2404:16917: scene=C_1
#: C_1:2404
msgctxt "text_id=16917 | speaker=unknown"
msgid "  The other girl, Alice Kuonji, didn't take a single step."
msgstr "　もう一人の少女、久遠寺有珠は一歩も動かず。"

#. Occurrence C_1:2438:16918: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0015; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:2438
msgctxt "text_id=16918 | speaker=touko"
msgid "(A suicide charge, open to friendly fire from the rear... Even with Alice's protection, this is dumb. You'll regret this, Aoko."
msgstr "“<被弾|ひだん>覚悟の特攻―――有珠から護符でも貰っているのでしょうけど、反省なさい青子。"

#. Occurrence C_1:2445:16919: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0016; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:2445
msgctxt "text_id=16919 | speaker=touko"
msgid "Your trump card has to come from your own deck.)"
msgstr "切札というものは、あくまで自己の力によるものを言うのよ”"

#. Occurrence C_1:2451:16920: scene=C_1
#: C_1:2451
msgctxt "text_id=16920 | speaker=unknown"
msgid "  Sneering, Touko raised her left arm,"
msgstr "　くっ、と口端をつり上げて橙子は左腕を構えた。"

#. Occurrence C_1:2456:16921: scene=C_1
#: C_1:2456
msgctxt "text_id=16921 | speaker=unknown"
msgid "  holding it out in front of her threateningly."
msgstr "　なぎ払うように、胸の前で水平に。"

#. Occurrence C_1:2491:16922: scene=C_1
#: C_1:2491
msgctxt "text_id=16922 | speaker=unknown"
msgid "  Ten more yards."
msgstr "　残り十メートル。"

#. Occurrence C_1:2496:16923: scene=C_1
#: C_1:2496
msgctxt "text_id=16923 | speaker=unknown"
msgid "  Unfortunately, her footprints gave away her position."
msgstr "　本来なら不可視の青子の<位置|すがた>は、不運にも足跡が十分に示していた。"

#. Occurrence C_1:2530:16924: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0017; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:2530
msgctxt "text_id=16924 | speaker=touko"
msgid "\"Sow-\""
msgstr "「<[swel]|ソウ>―――」"

#. Occurrence C_1:2564:16925: scene=C_1
#: C_1:2564
msgctxt "text_id=16925 | speaker=unknown"
msgid "  Touko began engraving a rune into the air."
msgstr "　ルーンの呪詛を<刻|きざ>む橙子。"

#. Occurrence C_1:2569:16926: scene=C_1
#: C_1:2569
msgctxt "text_id=16926 | speaker=unknown"
msgid "  But before she could finish, Aoko's footprints stopped."
msgstr "　それより早く、青子の足跡はぴたりと止まった。"

#. Occurrence C_1:2580:16927: scene=C_1
#: C_1:2580
msgctxt "text_id=16927 | speaker=unknown"
msgid "  She was still too far away for close combat."
msgstr "　格闘戦を行うにはまだ遠すぎる。"

#. Occurrence C_1:2585:16928: scene=C_1
#: C_1:2585
msgctxt "text_id=16928 | speaker=unknown"
msgid "  What a strange place to end her attack..."
msgstr "　あの位置で止まるのはあまりに不可解。"

#. Occurrence C_1:2590:16929: scene=C_1
#: C_1:2590
msgctxt "text_id=16929 | speaker=unknown"
msgid "  No, wait. Could she really stop so suddenly at that speed...?"
msgstr "　いや。それ以前に、あのスピードで急停止などできるものだろうか……？"

#. Occurrence C_1:2615:16930: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0018; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:2615
msgctxt "text_id=16930 | speaker=touko"
msgid "(She jumped...!)"
msgstr "“跳んだか―――！”"

#. Occurrence C_1:2663:16931: scene=C_1
#: C_1:2663
msgctxt "text_id=16931 | speaker=unknown"
msgid "  Touko made a snap decision."
msgstr "　一瞬の判断。"

#. Occurrence C_1:2668:16932: scene=C_1
#: C_1:2668
msgctxt "text_id=16932 | speaker=unknown"
msgid "  She quickly raised her outstretched arm toward the sky as if saluting the moon."
msgstr "　水平に構えられた橙子の腕が、月を<仰|あお>ぐよう上空に向けられる。"

#. Occurrence C_1:2715:16933: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0019; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:2715
msgctxt "text_id=16933 | speaker=touko"
msgid "\"Sowilo!\""
msgstr "「<[swel]|ソウェル>―――！」"

#. Occurrence C_1:2818:16934: scene=C_1
#: C_1:2818
msgctxt "text_id=16934 | speaker=unknown"
msgid "  Flames tore through the air."
msgstr "　大気を<滑|はし>る、<劫火|ごうか>の導線。"

#. Occurrence C_1:2823:16935: scene=C_1
#: C_1:2823
msgctxt "text_id=16935 | speaker=unknown"
msgid "  The rune carved into the body above her, bathing it in a pillar of flames."
msgstr "　<刻印|ルーン>は空中の見えざる人体に<刻|きざ>まれ、わずか一秒で炎を巻き起こした。"

#. Occurrence C_1:2828:16936: scene=C_1
#: C_1:2828
msgctxt "text_id=16936 | speaker=unknown"
msgid "  No internal resistance spell could help."
msgstr "　内部からの魔術抵抗は意味をなさない。"

#. Occurrence C_1:2833:16937: scene=C_1
#: C_1:2833
msgctxt "text_id=16937 | speaker=unknown"
msgid "  Rather than simply burning their target, the runes wrapped them in a wreath of flame."
msgstr "　ルーンは対象を燃やしたのではなく、対象を炎で包み込んだのだから。"

#. Occurrence C_1:2946:16938: scene=C_1
#: C_1:2946
msgctxt "text_id=16938 | speaker=unknown"
msgid "  The assailant screamed, falling onto the snow-covered ground."
msgstr "　悲鳴をあげて雪原に落ちる襲撃者。"

#. Occurrence C_1:2951:16939: scene=C_1
#: C_1:2951
msgctxt "text_id=16939 | speaker=unknown"
msgid "  In agony, she extended a burning hand out from the hellish fire, as if begging for mercy. It was the stuff of nightmares."
msgstr "　<苦悶|くもん>に荒れ狂う体、助けを<乞|こ>うように<掲|かか>げられる手は、夢に出てきそうなほど見苦しい。"

#. Occurrence C_1:2956:16940: scene=C_1
#: C_1:2956
msgctxt "text_id=16940 | speaker=unknown"
msgid "  The snow melted as the fire burned the attacker alive."
msgstr "　炎は消えず、積もった雪を溶かしながら、襲撃者は息絶えるまであぶられ続ける。"

#. Occurrence C_1:2963:16941: scene=C_1
#: C_1:2963
msgctxt "text_id=16941 | speaker=unknown"
msgid "  Chirp chirp."
msgstr "　チチチ、チチチと。"

#. Occurrence C_1:2968:16942: scene=C_1
#: C_1:2968
msgctxt "text_id=16942 | speaker=unknown"
msgid "  The movement was far too theatrical to be Aoko."
msgstr "　青子らしからぬ、あまりにも大げさな<三流芝居|だんまつま>をあげながら。"

#. Occurrence C_1:3006:16943: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0020; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:3006
msgctxt "text_id=16943 | speaker=touko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence C_1:3011:16944: scene=C_1
#: C_1:3011
msgctxt "text_id=16944 | speaker=unknown"
msgid "  Touko had already turned her gaze to Alice."
msgstr "　橙子の視線は、既に有珠に向けられている。"

#. Occurrence C_1:3050:16945: scene=C_1
#: C_1:3050
msgctxt "text_id=16945 | speaker=unknown"
msgid "  She hadn't been watching the burning corpse at all."
msgstr "　燃えカスなどはじめから見てはいない。"

#. Occurrence C_1:3055:16946: scene=C_1
#: C_1:3055
msgctxt "text_id=16946 | speaker=unknown"
msgid "  Touko knew it wasn't Aoko from the moment the body fell to the ground."
msgstr "　橙子は<ソ|・><レ|・>が無抵抗に落下した時から、青子ではないと判断していた。"

#. Occurrence C_1:3093:16947: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0021; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:3093
msgctxt "text_id=16947 | speaker=touko"
msgid "(Tch... Another dumb Meinster familiar!)"
msgstr "“チッ、マインスターの使い魔は何匹いる…………！”"

#. Occurrence C_1:3099:16948: scene=C_1
#: C_1:3099
msgctxt "text_id=16948 | speaker=unknown"
msgid "  Irritated, Touko glared at Alice."
msgstr "　<苛|いら>だたしげに舌打ちしつつ、橙子は有珠を凝視する。"

#. Occurrence C_1:3104:16949: scene=C_1
#: C_1:3104
msgctxt "text_id=16949 | speaker=unknown"
msgid "  While Aoko had vanished into thin air,"
msgstr "　たしかに青子の姿は透明化していた。"

#. Occurrence C_1:3109:16950: scene=C_1
#: C_1:3109
msgctxt "text_id=16950 | speaker=unknown"
msgid "  she hadn't moved at all."
msgstr "　ただし、本人は一歩たりとも動いてはいない。"

#. Occurrence C_1:3154:16951: scene=C_1
#: C_1:3154
msgctxt "text_id=16951 | speaker=unknown"
msgid "  Blue energy traced a circle around where she stood."
msgstr "　青子が立っていた地面には、青い円陣が回りだしている。"

#. Occurrence C_1:3221:16952: scene=C_1
#: C_1:3221
msgctxt "text_id=16952 | speaker=unknown"
msgid "  It was Force to Fourth, a four-bar grand magecraft, mobilizing her Magic Crest."
msgstr "　それは魔術刻印を動員した、<四小節の大魔術|フォース・トゥ・フォース>。"

#. Occurrence C_1:3226:16953: scene=C_1
#: C_1:3226
msgctxt "text_id=16953 | speaker=unknown"
msgid "  Touko only had single-action runes-"
msgstr "　<一工程|シングルアクション>のルーンしか―――"

#. Occurrence C_1:3231:16954: scene=C_1
#: C_1:3231
msgctxt "text_id=16954 | speaker=unknown"
msgid "  no, she hadn't mastered anything above two bars to begin with. This torrent of energy was too much to handle!"
msgstr "　いや、そもそも二小節以上の魔術を修得できない橙子にとっては、太刀打ちできない魔力の奔流―――！"

#. Occurrence C_1:3318:16955: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0022; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:3318
msgctxt "text_id=16955 | speaker=touko"
msgid "\"Eihwaz!\""
msgstr "「―――<[eywz]|エイワズ>！」"

#. Occurrence C_1:3436:16956: scene=C_1
#: C_1:3436
msgctxt "text_id=16956 | speaker=unknown"
msgid "  The rune formed in the magic circle."
msgstr "　円陣の上に、ルーンの軌跡が刻まれる。"

#. Occurrence C_1:3567:16957: scene=C_1
#: C_1:3567
msgctxt "text_id=16957 | speaker=unknown"
msgid "  Eihwaz, the rune of withdrawal, was evoked and Aoko's concealment was undone, allowing Touko to utilize her Mystic Eyes."
msgstr "　<退去|エイワズ>のルーンで青子にかかった姿隠しを解呪し、橙子は<角|ひ><膜|とみ>を切り替える。"

#. Occurrence C_1:3572:16958: scene=C_1
#: C_1:3572
msgctxt "text_id=16958 | speaker=unknown"
msgid "  Within her opened pupil, the infinitely mirrored eyes captured their target in an endless hell!"
msgstr "　新たに開かれる<瞳|もの>は、見たものを眼球内の無限地獄に捕らえる、合わせ鏡の積重魔眼―――！"

#. Occurrence C_1:3712:16959: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0023; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:3712
msgctxt "text_id=16959 | speaker=touko"
msgid "\"Ngh...?!\""
msgstr "「っ……！？」"

#. Occurrence C_1:3742:16960: scene=C_1
#: C_1:3742
msgctxt "text_id=16960 | speaker=unknown"
msgid "  But the mage's sight was literally split in two."
msgstr "　だが、魔術師の視線は文字通り<両|・><断|・>された。"

#. Occurrence C_1:3747:16961: scene=C_1
#: C_1:3747
msgctxt "text_id=16961 | speaker=unknown"
msgid "  The space in front of Aoko distorted,"
msgstr "　青子の前の空間が歪んでいる。"

#. Occurrence C_1:3752:16962: scene=C_1
#: C_1:3752
msgctxt "text_id=16962 | speaker=unknown"
msgid "  obscuring her form like an icy mist."
msgstr "　夜気は霧のように重なり、青子の姿を<被|だぶ>らせている。"

#. Occurrence C_1:3757:16963: scene=C_1
#: C_1:3757
msgctxt "text_id=16963 | speaker=unknown"
msgid "  If Touko's eye was like opposing mirrors, then this was like sticking a one-way mirror at the triangulation point."
msgstr "　橙子の魔眼が合わせ鏡なら、あれは三角点に置かれたマジックミラーだ。"

#. Occurrence C_1:3762:16964: scene=C_1
#: C_1:3762
msgctxt "text_id=16964 | speaker=unknown"
msgid "  With her vision split in two, she couldn't lock on to Aoko!"
msgstr "　橙子の位置からでは視界が二つに別けられ、正面の<像|あおこ>を視認できない……！"

#. Occurrence C_1:3895:16965: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_1_0004; voice_prefix=A40; voice_category=2; scene=C_1
#: C_1:3895
msgctxt "text_id=16965 | speaker=alice"
msgid "\"The Mirror of Slumber, Touko."
msgstr "「午睡の鏡の効果よ、橙子さん。"

#. Occurrence C_1:3902:16966: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_1_0005; voice_prefix=A40; voice_category=2; scene=C_1
#: C_1:3902
msgctxt "text_id=16966 | speaker=alice"
msgid "Aoko's deep in the fork in the road the mirror creates. From where you are, you'll never be able to see her.\""
msgstr "青子は鏡のＹ字路の奥にいる。一本道から見ている貴女に、中心は見渡せない」"

#. Occurrence C_1:3949:16967: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0024; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:3949
msgctxt "text_id=16967 | speaker=touko"
msgid "\"...!\""
msgstr "「……！」"

#. Occurrence C_1:4044:16968: scene=C_1
#: C_1:4044
msgctxt "text_id=16968 | speaker=unknown"
msgid "  Alice explained without concern."
msgstr "　いつかの逆転とばかりに有珠は言い捨てた。"

#. Occurrence C_1:4049:16969: scene=C_1
#: C_1:4049
msgctxt "text_id=16969 | speaker=unknown"
msgid "  Due to the herb Touko made Alice swallow, she was still unable to use her own magecraft."
msgstr "　有珠自身、橙子に飲まされた薬草によって魔術は使えない。"

#. Occurrence C_1:4054:16970: scene=C_1
#: C_1:4054
msgctxt "text_id=16970 | speaker=unknown"
msgid "  However, she could use Ploys already in motion without using magical energy...such as the mansion's mirror and the aimless little blue bird."
msgstr "　だが、既に起動しているプロイたち……洋館の『鏡』と、無駄に動き回る青い鳥は、彼女の魔力がなくとも最低限の機能は果たせるのだ。"

#. Occurrence C_1:4098:16971: scene=C_1
#: C_1:4098
msgctxt "text_id=16971 | speaker=unknown"
msgid "  Finally, the magic bullet was loaded."
msgstr "　そして、暴風の<魔弾|まだん>が<装填|そうてん>される。"

#. Occurrence C_1:4176:16972: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0016; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:4176
msgctxt "text_id=16972 | speaker=aoko"
msgid "\"Set route. Direct current.\""
msgstr "「<接続|セット>―――<刻印|ルート>、<交流数紋|ディレクト・カーラント>」"

#. Occurrence C_1:4294:16973: scene=C_1
#: C_1:4294
msgctxt "text_id=16973 | speaker=unknown"
msgid "  Raising her right arm to reveal her luminescent crests, Aoko took aim at her target a hundred feet ahead."
msgstr "　右腕を<掲|かか>げ、<光|ひ><芒|か>る刻印をあらわにし、青子は三十メートル先の標的を見据える。"

#. Occurrence C_1:4299:16974: scene=C_1
#: C_1:4299
msgctxt "text_id=16974 | speaker=unknown"
msgid "  Magical energy coursed through her gun barrel arm."
msgstr "　<砲|う><身|で>は十分な魔力に満ちている。"

#. Occurrence C_1:4337:16975: scene=C_1
#: C_1:4337
msgctxt "text_id=16975 | speaker=unknown"
msgid "  From the moment she had received Alice's invisibility, Aoko had begun chanting her magecraft."
msgstr "　有珠の姿隠しを受けた瞬間から、青子は魔術の詠唱を始めていた。"

#. Occurrence C_1:4381:16976: scene=C_1
#: C_1:4381
msgctxt "text_id=16976 | speaker=unknown"
msgid "  It took Touko a few seconds to notice."
msgstr "　橙子が気付くまでの数秒間。"

#. Occurrence C_1:4386:16977: scene=C_1
#: C_1:4386
msgctxt "text_id=16977 | speaker=unknown"
msgid "  Aoko produced more spins in the awakened Magic Circuits than she had ever done before."
msgstr "　最速の手順で形成し、起動させた魔術回路の回転数は自己ベストを超えている。"

#. Occurrence C_1:4426:16978: scene=C_1
#: C_1:4426
msgctxt "text_id=16978 | speaker=unknown"
msgid "  She readied not Snap, nor Draw. Instead, she advanced past her third process, a compression of magical energy: Magic Blow."
msgstr "　<一工程|スナップ>でも<二|ド><工|ロ><程|ウ>でもない、三工程以上の<魔力圧縮|マジック・ブロウ>。"

#. Occurrence C_1:4432:16979: scene=C_1
#: C_1:4432
msgctxt "text_id=16979 | speaker=unknown"
msgid "  If she fired the blue Ether that gathered before her, it would fly with the force of ten tons."
msgstr "　生成され、目前に集められて渦巻く青いエーテルは、単純に撃ち出すだけで１０トン相当の質量。"

#. Occurrence C_1:4437:16980: scene=C_1
#: C_1:4437
msgctxt "text_id=16980 | speaker=unknown"
msgid "  Using her Magic Crests to multiply the energy and machine-gun her target, it was enough power to demolish even the old building behind her!"
msgstr "　これを魔術刻印によって加工し、相乗に相乗を重ねて掃射すれば、背後の旧校舎さえ粉砕できる―――！"

#. Occurrence C_1:4502:16981: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0017; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:4502
msgctxt "text_id=16981 | speaker=aoko"
msgid "\"Toukooo!!!\""
msgstr "「橙子――――――！」"

#. Occurrence C_1:4542:16982: scene=C_1
#: C_1:4542
msgctxt "text_id=16982 | speaker=unknown"
msgid "  Aoko stared intensely at her sister, ready to fire."
msgstr "　覚悟、とばかりに青子は姉を見据えた。"

#. Occurrence C_1:4568:16983: scene=C_1
#: C_1:4568
msgctxt "text_id=16983 | speaker=unknown"
msgid "  Touko had no time to counterattack, or even the speed to evade."
msgstr "　橙子には対抗する時間も、回避するだけの<移動力|あし>もない。"

#. Occurrence C_1:4573:16984: scene=C_1
#: C_1:4573
msgctxt "text_id=16984 | speaker=unknown"
msgid "  The fact she didn't move implied she knew that better than anyone."
msgstr "　それを誰より理解しているのか、彼女は驚愕のまま動かなかった。"

#. Occurrence C_1:4578:16985: scene=C_1
#: C_1:4578
msgctxt "text_id=16985 | speaker=unknown"
msgid "  Acceptance filled her eyes, not fear."
msgstr "　<怯|おび>えはなく、敗北を悟った自責の瞳。"

#. Occurrence C_1:4583:16986: scene=C_1
#: C_1:4583
msgctxt "text_id=16986 | speaker=unknown"
msgid "  Aoko didn't hesitate. She squeezed the trigger on her right hand."
msgstr "　それに青子は躊躇する事なく、右手の引き金に力をいれた。"

#. Occurrence C_1:4676:16987: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0018; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:4676
msgctxt "text_id=16987 | speaker=aoko"
msgid "\"<Magic bullet configuration, convergent launch|Tour Plan, Starmine>... Circuit, FIRE!!!\""
msgstr "「<魔弾|ツアー><形式|プラン>、<収束|スター><投射|マイン>―――回路、放て………！！！！」"

#. Occurrence C_1:4829:16988: scene=C_1
#: C_1:4829
msgctxt "text_id=16988 | speaker=unknown"
msgid "  The last word came out like a scream."
msgstr "　叫び声にも似た最後の一節。"

#. Occurrence C_1:4834:16989: scene=C_1
#: C_1:4834
msgctxt "text_id=16989 | speaker=unknown"
msgid "  Under the impact of the Ether, the surrounding snow melted and flew around."
msgstr "　撃ち出された架<空要|エーテル>素は仮初めの熱量となって、降り積もった雪を波と散らす。"

#. Occurrence C_1:5240:16990: scene=C_1
#: C_1:5240
msgctxt "text_id=16990 | speaker=unknown"
msgid "  Touko was engulfed in dirt."
msgstr "　―――橙子を飲みこむ、圧倒的なまでの土砂。"

#. Occurrence C_1:5294:16991: scene=C_1
#: C_1:5294
msgctxt "text_id=16991 | speaker=unknown"
msgid "  No way she could survive Aoko's magic bullet; it contained every bit of Aoko's magical energy she could muster."
msgstr "　できうるかぎりの魔力を用いた青子の魔弾は、逃れようのない死の一撃となった。"

#. Occurrence C_1:5299:16992: scene=C_1
#: C_1:5299
msgctxt "text_id=16992 | speaker=unknown"
msgid "  Viewing the chaos, Aoko confirmed her victory."
msgstr "　その衝突を目の当たりにして、青子は自分の勝利を受け入れた。"

#. Occurrence C_1:5304:16993: scene=C_1
#: C_1:5304
msgctxt "text_id=16993 | speaker=unknown"
msgid "  ...And yet, somehow she felt bitter."
msgstr "　……どこか、苦い感情と共に。"

#. Occurrence C_1:5345:16994: scene=C_1
#: C_1:5345
msgctxt "text_id=16994 | speaker=unknown"
msgid "  But then..."
msgstr "　―――そして。"

#. Occurrence C_1:5362:16995: scene=C_1
#: C_1:5362
msgctxt "text_id=16995 | speaker=unknown"
msgid "  Choosing to deal with the torrent of magical energy she swallowed up later, Touko tutted at Aoko's childishness."
msgstr "　自らを飲みこんだ魔力の<奔|な><流|み>を後にして、橙子は青子の甘さに舌打ちした。"

#. Occurrence C_1:5367:16996: scene=C_1
#: C_1:5367
msgctxt "text_id=16996 | speaker=unknown"
msgid "  Her disappointment was so deep it bordered on despair."
msgstr "　青子とは真逆の、失望に満ちた苦さと共に。"

#. Occurrence C_1:5427:16997: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0025; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:5427
msgctxt "text_id=16997 | speaker=touko"
msgid "\"It's a little too late now, but listen up anyway, Aoko."
msgstr "「学ぶにしては遅すぎたが、まあ聞いておけ青子。"

#. Occurrence C_1:5433:16998: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_1_0026; voice_prefix=A20; voice_category=11; scene=C_1
#: C_1:5433
msgctxt "text_id=16998 | speaker=touko"
msgid "  Never play your trump card first. You'll lose.\""
msgstr "　切札というものは、先に出した方の負けなんだよ」"

#. Occurrence C_1:5439:16999: scene=C_1
#: C_1:5439
msgctxt "text_id=16999 | speaker=unknown"
msgid "  Her voice cold and aloof, she was completely unscathed."
msgstr "　超然とした声には、何のダメージも見られない。"

#. Occurrence C_1:5444:17000: scene=C_1
#: C_1:5444
msgctxt "text_id=17000 | speaker=unknown"
msgid "  The mage stood in the snow field, not a single speck of dirt on her overcoat."
msgstr "　雪原に立つ魔術師の<外套|コート>には<煤|すす>一つない。"

#. Occurrence C_1:5449:17001: scene=C_1
#: C_1:5449
msgctxt "text_id=17001 | speaker=unknown"
msgid "  Just before the bullet reached Touko, she deflected it with magical energy of the same level."
msgstr "　―――<渾身|こんしん>の魔弾は、橙子の体に触れる寸前で、同位の魔力によって周囲へと<弾|はじ>き飛ばされたのだ。"

#. Occurrence C_1:5493:17002: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_1_0019; voice_prefix=A10; voice_category=1; scene=C_1
#: C_1:5493
msgctxt "text_id=17002 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence C_1:5499:17003: scene=C_1
#: C_1:5499
msgctxt "text_id=17003 | speaker=unknown"
msgid "  Aoko could only stare at the scene before her."
msgstr "　その光景を、青子はただ見つめていた。"

#. Occurrence C_1:5504:17004: scene=C_1
#: C_1:5504
msgctxt "text_id=17004 | speaker=unknown"
msgid "  The negation of her magecraft hadn't shocked her, though."
msgstr "　自身の魔術の消滅を、ではない。"

#. Occurrence C_1:5509:17005: scene=C_1
#: C_1:5509
msgctxt "text_id=17005 | speaker=unknown"
msgid "  Leaf-like objects floated behind her sister; Aoko stared like she was living a nightmare."
msgstr "　悪夢でも見るように、姉の背後に浮遊するモノを凝視する。"

#. Occurrence C_1:5515:17006: scene=C_1
#: C_1:5515
msgctxt "text_id=17006 | speaker=unknown"
msgid "  Countless Magic Crests poured out from Touko's back."
msgstr "　橙子の背後に現れた、<夥|おびただ>しいまでの魔術刻印を。"

#. Occurrence C_1:5551:17007: scene=C_1
#: C_1:5551
msgctxt "text_id=17007 | speaker=unknown"
msgid "  ...It all happened in an instant."
msgstr "　……それは一瞬の出来事だった。"

#. Occurrence C_1:5556:17008: scene=C_1
#: C_1:5556
msgctxt "text_id=17008 | speaker=unknown"
msgid "  The magic bullet approaching like a tsunami. Touko lightly snapped her fingers,"
msgstr "　大波となって押し寄せる魔弾を前に、橙子は軽やかに右指を鳴らした。"

#. Occurrence C_1:5576:17009: scene=C_1
#: C_1:5576
msgctxt "text_id=17009 | speaker=unknown"
msgid "  causing a stream of letters to rush out from behind her."
msgstr "　途端、背後からざあ、と音をたてて幾多もの文字が羅列されていったのだ。"

#. Occurrence C_1:5582:17010: scene=C_1
#: C_1:5582
msgctxt "text_id=17010 | speaker=unknown"
msgid "  Text became art; golden flowers bloomed."
msgstr "　<言葉|テキスト>は<美術|アート>となり、金色の花に成った。"

#. Occurrence C_1:5587:17011: scene=C_1
#: C_1:5587
msgctxt "text_id=17011 | speaker=unknown"
msgid "  There must have been hundreds..."
msgstr "　おそらくは数百の。"

#. Occurrence C_1:5592:17012: scene=C_1
#: C_1:5592
msgctxt "text_id=17012 | speaker=unknown"
msgid "  All sorts of magecraft from even beyond Western Europe."
msgstr "　西欧だけに留まらない、多種多様な魔術の<群像|カタチ>。"

#. Occurrence C_1:5613:17013: scene=C_1
#: C_1:5613
msgctxt "text_id=17013 | speaker=unknown"
msgid "  The kind normally carved into the flesh of a mage;"
msgstr "　本来、魔術師の肌に刻む筈の、"

#. Occurrence C_1:5619:17014: scene=C_1
#: C_1:5619
msgctxt "text_id=17014 | speaker=unknown"
msgid "  the kind Touko Aozaki shouldn't possess;"
msgstr "　本来、蒼崎橙子には無い筈の、"

#. Occurrence C_1:5624:17015: scene=C_1
#: C_1:5624
msgctxt "text_id=17015 | speaker=unknown"
msgid "  the kind only followers of those schools should know..."
msgstr "　本来、その門派の後継者しか知らない筈の、"

#. Occurrence C_1:5633:17016: scene=C_1
#: C_1:5633
msgctxt "text_id=17016 | speaker=unknown"
msgid "  Blossoming Magic Crests, brighter than the moon."
msgstr "　月光より鮮やかに咲く魔術刻印。"

#. Occurrence C_1:5665:17017: scene=C_1
#: C_1:5665
msgctxt "text_id=17017 | speaker=unknown"
msgid "  Inscribed in the air, they formed a totem pole, a guardian beast, to protect Touko."
msgstr "　それは橙子を守る<守護の獣|トーテムポール>となって、彼女の背後の空間に刻まれていた。"

#. Occurrence C_10:63:17018: scene=C_10
#: C_10:63
msgctxt "text_id=17018 | speaker=unknown"
msgid "  To put it simply..."
msgstr "　―――詰まるところ。"

#. Occurrence C_10:68:17019: scene=C_10
#: C_10:68
msgctxt "text_id=17019 | speaker=unknown"
msgid "  Magecraft is human wisdom; it is the world as we know it."
msgstr "　魔術とは人智であり世界であり、"

#. Occurrence C_10:73:17020: scene=C_10
#: C_10:73
msgctxt "text_id=17020 | speaker=unknown"
msgid "  Magic is the singularity that exists beyond either of those."
msgstr "　魔法とはそれらに含まれない、<埒|らち><天外|てんがい>の孤独である。"

#. Occurrence C_10:96:17021: scene=C_10
#: C_10:96
msgctxt "text_id=17021 | speaker=unknown"
msgid "  ...At the beginning, the First changed all."
msgstr "　……はじめの一つは全てを変えた。"

#. Occurrence C_10:102:17022: scene=C_10
#: C_10:102
msgctxt "text_id=17022 | speaker=unknown"
msgid "  ...Next, the Second recognized many."
msgstr "　……つぎの二つは多くを認めた。"

#. Occurrence C_10:108:17023: scene=C_10
#: C_10:108
msgctxt "text_id=17023 | speaker=unknown"
msgid "  ...In answer, the Third showed the future."
msgstr "　……受けて三つは未来を示した。"

#. Occurrence C_10:114:17024: scene=C_10
#: C_10:114
msgctxt "text_id=17024 | speaker=unknown"
msgid "  ...Tethered, The Fourth concealed itself."
msgstr "　……繋ぐ四つは姿を隠した。"

#. Occurrence C_10:121:17025: scene=C_10
#: C_10:121
msgctxt "text_id=17025 | speaker=unknown"
msgid "  And the final Fifth had long since lost its significance."
msgstr "　そして終わりの五つ目は、とっくに<意義|せき>を失っていた。"

#. Occurrence C_10:142:17026: scene=C_10
#: C_10:142
msgctxt "text_id=17026 | speaker=unknown"
msgid "  Someone once said, \"Had it only ended at the Third...\""
msgstr "　三つ目で終わっていれば良かったのに、と誰かが言った。"

#. Occurrence C_10:179:17027: scene=C_10
#: C_10:179
msgctxt "text_id=17027 | speaker=unknown"
msgid "  Magecraft is the study of history;"
msgstr "　魔術とは歴史の研鑽。"

#. Occurrence C_10:184:17028: scene=C_10
#: C_10:184
msgctxt "text_id=17028 | speaker=unknown"
msgid "  feats of our making, and life orbiting the planet."
msgstr "　人の手による<業|わざ>と、星の元に<巡|めぐ>る命だ。"

#. Occurrence C_10:189:17029: scene=C_10
#: C_10:189
msgctxt "text_id=17029 | speaker=unknown"
msgid "  But True Magic is the providence of a god beyond the heavens."
msgstr "　けれど魔法は<天|てん>の<外|そと>の神の摂理。"

#. Occurrence C_10:194:17030: scene=C_10
#: C_10:194
msgctxt "text_id=17030 | speaker=unknown"
msgid "  Why do those who stand on the earth extol the virtues of miracles beyond humankind and the planet?"
msgstr "　人にも星にも含まれない<業|わざ>を、一体地上の誰が、どうして、奇跡と<讃|たた>え<尊|とうと>ぶものか。"

#. Occurrence C_10:218:17031: scene=C_10
#: C_10:218
msgctxt "text_id=17031 | speaker=unknown"
msgid "  This was an undeniable sin."
msgstr "　明白な罪科。"

#. Occurrence C_10:223:17032: scene=C_10
#: C_10:223
msgctxt "text_id=17032 | speaker=unknown"
msgid "  Magic was the enemy of humanity."
msgstr "　魔法とは、人類の敵そのもの。"

#. Occurrence C_10:228:17033: scene=C_10
#: C_10:228
msgctxt "text_id=17033 | speaker=unknown"
msgid "  That is why..."
msgstr "　故に―――"

#. Occurrence C_10:238:17034: scene=C_10
#: C_10:238
msgctxt "text_id=17034 | speaker=unknown"
msgid "  Those who obtain a new Magic are killed by the red shadow."
msgstr "　<新|あら>たに魔法を<宿|やど>したものは、その赤い影に殺される。"

#. Occurrence C_10:331:17035: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_10_0000; voice_prefix=A10; voice_category=1; scene=C_10
#: C_10:331
msgctxt "text_id=17035 | speaker=aoko"
msgid "\"Hear me, prime species of all Creation.\""
msgstr "「―――<聴|き>け、万物の霊長」"

#. Occurrence C_10:443:17036: scene=C_10
#: C_10:443
msgctxt "text_id=17036 | speaker=unknown"
msgid "  Aoko's voice resonated through and high above the winter skies."
msgstr "　声は高らかに、冬の空に響き渡る。"

#. Occurrence C_10:448:17037: scene=C_10
#: C_10:448
msgctxt "text_id=17037 | speaker=unknown"
msgid "  The air began to fracture,"
msgstr "　空間そのものに走る断裂。"

#. Occurrence C_10:453:17038: scene=C_10
#: C_10:453
msgctxt "text_id=17038 | speaker=unknown"
msgid "  turning the scenery to broken glass."
msgstr "　周囲の<風景|カタチ>が軋んでいく様は、<伽藍|がらん>の崩壊を思わせる。"

#. Occurrence C_10:562:17039: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_10_0000; voice_prefix=A20; voice_category=11; scene=C_10
#: C_10:562
msgctxt "text_id=17039 | speaker=touko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence C_10:568:17040: scene=C_10
#: C_10:568
msgctxt "text_id=17040 | speaker=unknown"
msgid "  Touko wondered whether she should fight or flee."
msgstr "　撤退すべきか、それとも戦うべきか。"

#. Occurrence C_10:573:17041: scene=C_10
#: C_10:573
msgctxt "text_id=17041 | speaker=unknown"
msgid "  She decided to try and keep her feelings in check and see this through."
msgstr "　橙子は<逸|はや>る気持ちを抑えながら、無様にも事の<顛末|てんまつ>を見届けてしまう。"

#. Occurrence C_10:578:17042: scene=C_10
#: C_10:578
msgctxt "text_id=17042 | speaker=unknown"
msgid "  But the object of her obsession for so many years was right in front of her. Rationality was slipping from her grasp."
msgstr "　長年の苦悩―――これまで追い続けてきたモノを前にして、合理的な判断などできよう筈がない。"

#. Occurrence C_10:604:17043: scene=C_10
#: C_10:604
msgctxt "text_id=17043 | speaker=unknown"
msgid "  Both of their fates were now uncertain."
msgstr "　互いの命運は、今や不確定にたゆたっている。"

#. Occurrence C_10:609:17044: scene=C_10
#: C_10:609
msgctxt "text_id=17044 | speaker=unknown"
msgid "  Touko had an overwhelming advantage when it came to her crests and the terrain."
msgstr "　背後の魔術刻印と地形の有利性から、橙子の戦力は青子の十倍強。負ける道理はない。"

#. Occurrence C_10:629:17045: scene=C_10
#: C_10:629
msgctxt "text_id=17045 | speaker=unknown"
msgid "  When it came to True Magic, however..."
msgstr "　だが魔法は別だ。"

#. Occurrence C_10:634:17046: scene=C_10
#: C_10:634
msgctxt "text_id=17046 | speaker=unknown"
msgid "  If the Aozaki Magic was anything like Alice Kuonji's fairy-tale monsters, then mage strength was not a part of the equation."
msgstr "　仮に、蒼崎の魔法が久遠寺有珠の“童話の怪物”と同系統のモノなら、術者の力量差は関係ない。"

#. Occurrence C_10:639:17047: scene=C_10
#: C_10:639
msgctxt "text_id=17047 | speaker=unknown"
msgid "  At this point, it was Touko against Magic itself."
msgstr "　その時は“魔法”と“蒼崎橙子”の戦いになる。"

#. Occurrence C_10:644:17048: scene=C_10
#: C_10:644
msgctxt "text_id=17048 | speaker=unknown"
msgid "  And there was no winning against Truth."
msgstr "　……勝ち目はない。"

#. Occurrence C_10:649:17049: scene=C_10
#: C_10:649
msgctxt "text_id=17049 | speaker=unknown"
msgid "  The transcendence and idiosyncrasy of True Magic rendered things like magecraft irrelevant."
msgstr "　魔法の特異性、超越性は、魔術の技量差など吹き飛ばしてしまうだろう。"

#. Occurrence C_10:705:17050: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_10_0001; voice_prefix=A20; voice_category=11; scene=C_10
#: C_10:705
msgctxt "text_id=17050 | speaker=touko"
msgid "\"...But can you...?\""
msgstr "「―――だが」"

#. Occurrence C_10:774:17051: scene=C_10
#: C_10:774
msgctxt "text_id=17051 | speaker=unknown"
msgid "  Touko stared at her sister, wondering if she could actually use it."
msgstr "　本当に使えるのか、と橙子は妹を凝視する。"

#. Occurrence C_10:779:17052: scene=C_10
#: C_10:779
msgctxt "text_id=17052 | speaker=unknown"
msgid "  Her proclamation lacked conviction."
msgstr "　今の宣言には力がなかった。"

#. Occurrence C_10:784:17053: scene=C_10
#: C_10:784
msgctxt "text_id=17053 | speaker=unknown"
msgid "  She had raised her voice, but that was out of discipline; it had not been the arrogant conviction to sacrifice someone else for her own gain."
msgstr "　高らかに声をあげながら、あるのは自制心だけで、何者をも代償にする<傲慢|つよさ>が存在しなかった。"

#. Occurrence C_10:804:17054: scene=C_10
#: C_10:804
msgctxt "text_id=17054 | speaker=unknown"
msgid "  Having not been chosen to inherit it, Touko could not imagine what the Magic in her sister was..."
msgstr "　魔法を身に宿すとはどのような事なのか、選ばれなかった橙子には分からない。"

#. Occurrence C_10:809:17055: scene=C_10
#: C_10:809
msgctxt "text_id=17055 | speaker=unknown"
msgid "  ...only that it was a force violent enough to change the world."
msgstr "　だが世界を変えるという暴挙。"

#. Occurrence C_10:814:17056: scene=C_10
#: C_10:814
msgctxt "text_id=17056 | speaker=unknown"
msgid "  No human mind could withstand the audacity required to make an enemy of the world itself."
msgstr "　星を敵に回す<不遜|ふそん>に、人の精神が耐えられる筈がない。"

#. Occurrence C_10:885:17057: scene=C_10
#: C_10:885
msgctxt "text_id=17057 | speaker=unknown"
msgid "  Especially not someone as indecisive as her sister. The power of Magic would surely cripple her!"
msgstr "　迷いがあるのなら尚のこと、あの少女には魔法の力は重すぎる―――！"

#. Occurrence C_10:979:17058: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_10_0001; voice_prefix=A10; voice_category=1; scene=C_10
#: C_10:979
msgctxt "text_id=17058 | speaker=aoko"
msgid "\"...Well...\""
msgstr "「―――そりゃあ、ね」"

#. Occurrence C_10:985:17059: scene=C_10
#: C_10:985
msgctxt "text_id=17059 | speaker=unknown"
msgid "  Feeling Touko's eyes on her, Aoko doubted herself."
msgstr "　橙子の視線を受けて、青子はひとり自嘲した。"

#. Occurrence C_10:990:17060: scene=C_10
#: C_10:990
msgctxt "text_id=17060 | speaker=unknown"
msgid "  She could not help but hesitate."
msgstr "　迷いは晴れない。"

#. Occurrence C_10:995:17061: scene=C_10
#: C_10:995
msgctxt "text_id=17061 | speaker=unknown"
msgid "  Terror gripped her heart tighter."
msgstr "　胸の恐れが消える事なんてきっとない。"

#. Occurrence C_10:1028:17062: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_10_0002; voice_prefix=A10; voice_category=1; scene=C_10
#: C_10:1028
msgctxt "text_id=17062 | speaker=aoko"
msgid "\"I have to.\""
msgstr "「―――でも、だからって」"

#. Occurrence C_10:1034:17063: scene=C_10
#: C_10:1034
msgctxt "text_id=17063 | speaker=unknown"
msgid "  She could not run away forever."
msgstr "　いつまでも逃げる訳にはいかない。"

#. Occurrence C_10:1039:17064: scene=C_10
#: C_10:1039
msgctxt "text_id=17064 | speaker=unknown"
msgid "  Her hesitation and terror meant she would never forgive herself for stopping now."
msgstr "　迷いも恐れも消えないからこそ、そんなもので立ち止まる自分が許せないと。"

#. Occurrence C_10:1044:17065: scene=C_10
#: C_10:1044
msgctxt "text_id=17065 | speaker=unknown"
msgid "  Closing her eyes, she pushed herself into the final stage."
msgstr "　瞳を閉じて、彼女は最後の工程に身を投げた。"

#. Occurrence C_10:1136:17066: scene=C_10
#: C_10:1136
msgctxt "text_id=17066 | speaker=unknown"
msgid "  Time stopped, like a light being switched off."
msgstr "　光を閉ざすように、時を止める。"

#. Occurrence C_10:1142:17067: scene=C_10
#: C_10:1142
msgctxt "text_id=17067 | speaker=unknown"
msgid "  She submerged herself in her own darkness."
msgstr "　そして、彼女は自己の闇へと埋没した。"

#. Occurrence C_10:1148:17068: scene=C_10
#: C_10:1148
msgctxt "text_id=17068 | speaker=unknown"
msgid "  Everything froze; only she moved."
msgstr "　何もかもが止まったまま過ぎていく。"

#. Occurrence C_10:1154:17069: scene=C_10
#: C_10:1154
msgctxt "text_id=17069 | speaker=unknown"
msgid "  Everything around her disappeared, as she passed a limitless stream of stars."
msgstr "　彼女以外のすべてが途絶えた、果てのない星の運河に。"

#. Occurrence C_10:1183:17070: scene=C_10
#: C_10:1183
msgctxt "text_id=17070 | speaker=unknown"
msgid "  And as soon as she did..."
msgstr "　途端。"

#. Occurrence C_10:1188:17071: scene=C_10
#: C_10:1188
msgctxt "text_id=17071 | speaker=unknown"
msgid "  She wanted to disappear into the empty, thoughtlessness place she arrived in without any answers."
msgstr "　何の答えもなく<彼|コ><方|コ>に訪れた浅はかさに、消えたくなる。"

#. Occurrence C_10:1220:17072: scene=C_10
#: C_10:1220
msgctxt "text_id=17072 | speaker=unknown"
msgid "                              ...Not again."
msgstr "　　　　　　　　　　　　　　　―――ああ、また。"

#. Occurrence C_10:1227:17073: scene=C_10
#: C_10:1227
msgctxt "text_id=17073 | speaker=unknown"
msgid "  The red shadow will surely come this time."
msgstr "　今度こそ、あの赤い影がやってくる。"

#. Occurrence C_10:1294:17074: scene=C_10
#: C_10:1294
msgctxt "text_id=17074 | speaker=unknown"
msgid "  Suddenly,"
msgstr "　不意に、"

#. Occurrence C_10:1299:17075: scene=C_10
#: C_10:1299
msgctxt "text_id=17075 | speaker=unknown"
msgid "          I saw a new memory."
msgstr "　　　　　新しい記憶を見た。"

#. Occurrence C_10:1305:17076: scene=C_10
#: C_10:1305
msgctxt "text_id=17076 | speaker=unknown"
msgid "  Possibly because I used another to make the trade for _____."
msgstr "　他者を媒介にして　　を交換しようとした結果だろう。"

#. Occurrence C_10:1310:17077: scene=C_10
#: C_10:1310
msgctxt "text_id=17077 | speaker=unknown"
msgid "  I heard a familiar yet new sound..."
msgstr "　ワタシは、聞いた事もないクセに、慣れ親しんだその音を聴く。"

#. Occurrence C_10:1388:17078: scene=C_10
#: C_10:1388
msgctxt "text_id=17078 | speaker=unknown"
msgid "                                    "
msgstr "　　　　　　　　"

msgctxt "text_id=17079 | speaker=unknown"
msgid "I wish for nothing."
msgstr "何も望まないように。"

msgctxt "text_id=17080 | speaker=unknown"
msgid "                                      I seek nothing."
msgstr "　　　　　　　　何も求めないように。"

#. Occurrence C_10:1481:17081: scene=C_10
#: C_10:1481
msgctxt "text_id=17081 | speaker=unknown"
msgid "  Only to fuse with the consciousness"
msgstr "　今はゼロに向けて逆行する意識を、"

#. Occurrence C_10:1486:17082: scene=C_10
#: C_10:1486
msgctxt "text_id=17082 | speaker=unknown"
msgid "                          that hurtles backward in time to zero."
msgstr "　　　　　　　　　　　　　一つに統合しなくてはならない。"

#. Occurrence C_10:1491:17083: scene=C_10
#: C_10:1491
msgctxt "text_id=17083 | speaker=unknown"
msgid "  This sound..."
msgstr "　こんな音。"

#. Occurrence C_10:1496:17084: scene=C_10
#: C_10:1496
msgctxt "text_id=17084 | speaker=unknown"
msgid "  The bitter, sad meaninglessness pulls me by my hair,"
msgstr "　こんな、悔しくて涙がでそうな戯言に、"

#. Occurrence C_10:1501:17085: scene=C_10
#: C_10:1501
msgctxt "text_id=17085 | speaker=unknown"
msgid "                      but I have to resist."
msgstr "　　　　　　　　　　　後ろ髪を引かれている場合じゃない。"

#. Occurrence C_10:1507:17086: scene=C_10
#: C_10:1507
msgctxt "text_id=17086 | speaker=unknown"
msgid "  The red ghost was always going to be my biggest hurdle."
msgstr "　そもそもワタシの最大の問題は、あの赤い幽霊で―――"

#. Occurrence C_10:1583:17087: scene=C_10
#: C_10:1583
msgctxt "text_id=17087 | speaker=unknown"
msgid "                                "
msgstr "　　　　　　　"

msgctxt "text_id=17088 | speaker=unknown"
msgid "I must forget the value of life."
msgstr "生の価値も覚えてはいけません。"

msgctxt "text_id=17089 | speaker=unknown"
msgid "                            I must forget the dignity of death."
msgstr "　　　　　　　死の<尊|とうと>さも、考えてはいけません。"

#. Occurrence C_10:1676:17090: scene=C_10
#: C_10:1676
msgctxt "text_id=17090 | speaker=unknown"
msgid "  The sound persists."
msgstr "　音は続いていく。"

#. Occurrence C_10:1681:17091: scene=C_10
#: C_10:1681
msgctxt "text_id=17091 | speaker=unknown"
msgid "  It's got nothing to do with this journey."
msgstr "　それはこの旅路に組みこまれている物ではなく、"

#. Occurrence C_10:1686:17092: scene=C_10
#: C_10:1686
msgctxt "text_id=17092 | speaker=unknown"
msgid "                            It's just an external distraction."
msgstr "　　　　　　　　　　　　　　外部からの妨害に他ならない。"

#. Occurrence C_10:1692:17093: scene=C_10
#: C_10:1692
msgctxt "text_id=17093 | speaker=unknown"
msgid "  And yet, I think I finally understand."
msgstr "　なのに、ここまで自分の心を乱す音の正体を、"

#. Occurrence C_10:1697:17094: scene=C_10
#: C_10:1697
msgctxt "text_id=17094 | speaker=unknown"
msgid "                                I know what noise has been making me so uneasy."
msgstr "　　　　　　　　　　　　　　　　ワタシはようやく悟った。"

#. Occurrence C_10:1732:17095: scene=C_10
#: C_10:1732
msgctxt "text_id=17095 | speaker=unknown"
msgid "\"What... the...\""
msgstr "“……なに、それ”"

#. Occurrence C_10:1738:17096: scene=C_10
#: C_10:1738
msgctxt "text_id=17096 | speaker=unknown"
msgid "  The unsettling whispers were directed at me."
msgstr "　不快げな呟きは、音の主に向けられたものだった。"

#. Occurrence C_10:1744:17097: scene=C_10
#: C_10:1744
msgctxt "text_id=17097 | speaker=unknown"
msgid "  Or perhaps, the red shadow was perplexed"
msgstr "　もしくは、その声をおとなしく聞いている誰かに対して。"

#. Occurrence C_10:1780:17098: scene=C_10
#: C_10:1780
msgctxt "text_id=17098 | speaker=unknown"
msgid "  by the quiet soul listening to it."
msgstr "　赤い影は戸惑っている。"

#. Occurrence C_10:1785:17099: scene=C_10
#: C_10:1785
msgctxt "text_id=17099 | speaker=unknown"
msgid "  It glares at me, its eyes full of hatred. How could I be so unprepared?"
msgstr "　答えも覚悟も持ってこなかったワタシを、憎悪に満ちた目で睨んでいる。"

#. Occurrence C_10:1823:17100: scene=C_10
#: C_10:1823
msgctxt "text_id=17100 | speaker=unknown"
msgid "  Don't tell me."
msgstr "　オマエは、まさか。"

#. Occurrence C_10:1828:17101: scene=C_10
#: C_10:1828
msgctxt "text_id=17101 | speaker=unknown"
msgid "  You can't be serious."
msgstr "　まさか、<そ|・><ん|・><な|・><理|・><由|・><で|・>。"

#. Occurrence C_10:1864:17102: scene=C_10
#: C_10:1864
msgctxt "text_id=17102 | speaker=unknown"
msgid "  You're going to turn me into your prey for *that*?!"
msgstr "　そんな思いつきで、ワタシの獲物になるつもりか―――！"

#. Occurrence C_10:1921:17103: scene=C_10
#: C_10:1921
msgctxt "text_id=17103 | speaker=unknown"
msgid "                                "
msgstr "　　　　　　　　"

msgctxt "text_id=17104 | speaker=unknown"
msgid "That is your everything."
msgstr "それが貴方の全てです。"

msgctxt "text_id=17105 | speaker=unknown"
msgid "                                You have nothing else."
msgstr "　　　　　それ以外、貴方には何も無いのです。"

#. Occurrence C_10:1992:17106: scene=C_10
#: C_10:1992
msgctxt "text_id=17106 | speaker=unknown"
msgid "  The effect of rewinding... The decision to never say never..."
msgstr "　巻き戻しの影響―――否を許さない断定。"

#. Occurrence C_10:1997:17107: scene=C_10
#: C_10:1997
msgctxt "text_id=17107 | speaker=unknown"
msgid "  His prime... His meaningless life..."
msgstr "　彼の一番だった頃―――あまりにも意味のない人生。"

#. Occurrence C_10:2003:17108: scene=C_10
#: C_10:2003
msgctxt "text_id=17108 | speaker=unknown"
msgid "  She negated it."
msgstr "　それを彼女は打ち消した。"

#. Occurrence C_10:2008:17109: scene=C_10
#: C_10:2008
msgctxt "text_id=17109 | speaker=unknown"
msgid "  She used her superior power to negate that sound which was an absolute rule to him."
msgstr "　彼にとって絶対の<原則|もの>であるその音を、さらに上回る力強さで。"

#. Occurrence C_10:2014:17110: scene=C_10
#: C_10:2014
msgctxt "text_id=17110 | speaker=unknown"
msgid "  Just brushed it aside, like it was a cobweb."
msgstr "　邪魔だ、と目の前の蜘蛛の巣を払い除けるように。"

#. Occurrence C_10:2057:17111: scene=C_10
#: C_10:2057
msgctxt "text_id=17111 | speaker=unknown"
msgid "  The sound disappeared; a new one replaced it."
msgstr "　音は千切れ、また違う音が耳に響く。"

#. Occurrence C_10:2064:17112: scene=C_10
#: C_10:2064
msgctxt "text_id=17112 | speaker=unknown"
msgid "                  /I wish for nothing."
msgstr "　　　　　　　　　／何も望まない。"

msgctxt "text_id=17113 | speaker=unknown"
msgid " I want nothing."
msgstr "何も欲しくない。"

#. Occurrence C_10:2072:17114: scene=C_10
#: C_10:2072
msgctxt "text_id=17114 | speaker=unknown"
msgid "  A pure, obedient heart."
msgstr "　断定に従う、無垢な心。"

#. Occurrence C_10:2079:17115: scene=C_10
#: C_10:2079
msgctxt "text_id=17115 | speaker=unknown"
msgid "                /That's why..."
msgstr "　　　　　　　　／だから、"

msgctxt "text_id=17116 | speaker=unknown"
msgid " you get nothing."
msgstr "何を与えられる事はない。"

#. Occurrence C_10:2087:17117: scene=C_10
#: C_10:2087
msgctxt "text_id=17117 | speaker=unknown"
msgid "  A life of falsehood, led by affirmation."
msgstr "　肯定が導く、不実の命。"

#. Occurrence C_10:2130:17118: scene=C_10
#: C_10:2130
msgctxt "text_id=17118 | speaker=unknown"
msgid "\"...This is ridiculous.\""
msgstr "“……あんまりにも、バカげてる”"

#. Occurrence C_10:2136:17119: scene=C_10
#: C_10:2136
msgctxt "text_id=17119 | speaker=unknown"
msgid "  My legs move toward the future. But they stop."
msgstr "　<未|ま><来|え>を目指す足が止まる。"

#. Occurrence C_10:2142:17120: scene=C_10
#: C_10:2142
msgctxt "text_id=17120 | speaker=unknown"
msgid "  Change of plans: I'm taking a different path."
msgstr "　ワタシは思いつきで<航|み><路|ち>を変える。"

#. Occurrence C_10:2148:17121: scene=C_10
#: C_10:2148
msgctxt "text_id=17121 | speaker=unknown"
msgid "  Nothing's changed. It's just something has made me real mad. How can I put it...?"
msgstr "　大事なものが変わったというより、ひどく頭にくるコトができてしまって、なんて言うか―――"

#. Occurrence C_10:2337:17122: scene=C_10
#: C_10:2337
msgctxt "text_id=17122 | speaker=unknown"
msgid "\"You call this the past, you idiot?!\""
msgstr "“こんな物が過去だって言うの、アンタは……！”"

#. Occurrence C_10:2343:17123: scene=C_10
#: C_10:2343
msgctxt "text_id=17123 | speaker=unknown"
msgid "  If I don't complain about something to someone, I'll explode!"
msgstr "　誰かに、文句の一つでも言わないと気が済まない……！！"

#. Occurrence C_10:2363:17124: scene=C_10
#: C_10:2363
msgctxt "text_id=17124 | speaker=unknown"
msgid "  Even if it's just to the voice, or to he who hears it,"
msgstr "　声の主か、それを聞き届ける彼か、"

#. Occurrence C_10:2368:17125: scene=C_10
#: C_10:2368
msgctxt "text_id=17125 | speaker=unknown"
msgid "  or to the part of me who just stays quiet and watches,"
msgstr "　それを黙って見ているだけの自分か、"

#. Occurrence C_10:2373:17126: scene=C_10
#: C_10:2373
msgctxt "text_id=17126 | speaker=unknown"
msgid "  or to the one who did that to him."
msgstr "　それとも、彼をそうしてしまった何者へか。"

#. Occurrence C_10:2379:17127: scene=C_10
#: C_10:2379
msgctxt "text_id=17127 | speaker=unknown"
msgid "  With no answer, I open my eyes."
msgstr "　答えは出ないまま、ワタシは閉じた<目蓋|まぶた>を開いて―――"

#. Occurrence C_10:2444:17128: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_10_0006; voice_prefix=A10; voice_category=1; scene=C_10
#: C_10:2444
msgctxt "text_id=17128 | speaker=aoko"
msgid "\"I declare.\""
msgstr "「―――告げる」"

#. Occurrence C_10:2450:17129: scene=C_10
#: C_10:2450
msgctxt "text_id=17129 | speaker=unknown"
msgid "  Aoko released everything she had dragged up."
msgstr "　引き上げてきたものを解放する。"

#. Occurrence C_10:2455:17130: scene=C_10
#: C_10:2455
msgctxt "text_id=17130 | speaker=unknown"
msgid "  As for what was there, or what she saw, she could not remember."
msgstr "　何を見てきたのか、何があったのかなど、青子の記憶には残っていない。"

#. Occurrence C_10:2460:17131: scene=C_10
#: C_10:2460
msgctxt "text_id=17131 | speaker=unknown"
msgid "  All she held on to was the fury that burned in her heart."
msgstr "　あるのは心臓を<昂|たか>ぶらせる激情だけ。"

#. Occurrence C_10:2465:17132: scene=C_10
#: C_10:2465
msgctxt "text_id=17132 | speaker=unknown"
msgid "  Pushed on by something-she did not know what-she opened the door to Magic."
msgstr "　自分でも正体の分からないものに押されて、彼女は魔法のフタを開く。"

#. Occurrence C_10:2548:17133: scene=C_10
#: C_10:2548
msgctxt "text_id=17133 | speaker=unknown"
msgid "  The change was extraordinary."
msgstr "　変化は劇的だった。"

#. Occurrence C_10:2553:17134: scene=C_10
#: C_10:2553
msgctxt "text_id=17134 | speaker=unknown"
msgid "  Beneath her, the snow vanished, replaced by a small patch of lush, green grass."
msgstr "　少女の足下の雪が消え、緑の地面が<覗|のぞ>いていく。"

#. Occurrence C_10:2558:17135: scene=C_10
#: C_10:2558
msgctxt "text_id=17135 | speaker=unknown"
msgid "  This ground had never existed under the frozen blanket; it had been rewritten into a new landscape."
msgstr "　それは雪解けによるものではなく、まったく別の風景に書き換わったものであり、"

#. Occurrence C_10:2568:17136: scene=C_10
#: C_10:2568
msgctxt "text_id=17136 | speaker=unknown"
msgid "  The very elements rejected her, as if the world itself was fighting back."
msgstr "　それを批難するように、あらゆる要素が、彼女の行為を消しにかかる。"

#. Occurrence C_10:2631:17137: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_10_0007; voice_prefix=A10; voice_category=1; scene=C_10
#: C_10:2631
msgctxt "text_id=17137 | speaker=aoko"
msgid "\"Ngh...\""
msgstr "「っ、―――」"

#. Occurrence C_10:2637:17138: scene=C_10
#: C_10:2637
msgctxt "text_id=17138 | speaker=unknown"
msgid "  The electrical discharge lashed at her body."
msgstr "　放電は彼女自身をも許さない。"

#. Occurrence C_10:2642:17139: scene=C_10
#: C_10:2642
msgctxt "text_id=17139 | speaker=unknown"
msgid "  This miracle threatened to destroy the world;"
msgstr "　その奇跡は世界を壊すと。"

#. Occurrence C_10:2647:17140: scene=C_10
#: C_10:2647
msgctxt "text_id=17140 | speaker=unknown"
msgid "  the world had to protect itself. It moved to expunge her."
msgstr "　自らの保身の為、世界自身が彼女の抹殺に動き出す。"

#. Occurrence C_10:2813:17141: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_10_0008; voice_prefix=A10; voice_category=1; scene=C_10
#: C_10:2813
msgctxt "text_id=17141 | speaker=aoko"
msgid "\"...!\""
msgstr "「っ、―――！」"

#. Occurrence C_10:2819:17142: scene=C_10
#: C_10:2819
msgctxt "text_id=17142 | speaker=unknown"
msgid "  Pain scorched her every cell, trying to tear away her consciousness."
msgstr "　全身の細胞を焼く痛みに、意識が現世から消失する。"

#. Occurrence C_10:2887:17143: scene=C_10
#: C_10:2887
msgctxt "text_id=17143 | speaker=unknown"
msgid "  But she did not falter."
msgstr "　だが怯まない。"

#. Occurrence C_10:2892:17144: scene=C_10
#: C_10:2892
msgctxt "text_id=17144 | speaker=unknown"
msgid "  All this pain and this loneliness was to take her to the Root."
msgstr "　この痛みもこの孤立も、全ては生身のまま根源に至る為。"

#. Occurrence C_10:2897:17145: scene=C_10
#: C_10:2897
msgctxt "text_id=17145 | speaker=unknown"
msgid "  Ever since inheriting True Magic, she had suffered this torture time and time again."
msgstr "　魔法を継いだ時から、この程度の責め苦、彼女は何度も超えてきた。"

#. Occurrence C_10:2974:17146: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_10_0009; voice_prefix=A10; voice_category=1; scene=C_10
#: C_10:2974
msgctxt "text_id=17146 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence C_10:2980:17147: scene=C_10
#: C_10:2980
msgctxt "text_id=17147 | speaker=unknown"
msgid "  She contended against the voiceless protest of the cosmos."
msgstr "　声なき声をあげて、<宇|ソ><宙|ラ>の在り方と拮抗する。"

#. Occurrence C_10:3054:17148: scene=C_10
#: C_10:3054
msgctxt "text_id=17148 | speaker=unknown"
msgid "  The burden engulfed her retinas and nerves in flames."
msgstr "　負荷は彼女の<網膜|もうまく>も神経も焼き捨てる。"

#. Occurrence C_10:3059:17149: scene=C_10
#: C_10:3059
msgctxt "text_id=17149 | speaker=unknown"
msgid "  And then..."
msgstr "　その果てに、"

#. Occurrence C_10:3110:17150: scene=C_10
#: C_10:3110
msgctxt "text_id=17150 | speaker=unknown"
msgid "  ...light."
msgstr "　光を見た。"

#. Occurrence C_10:3124:17151: scene=C_10
#: C_10:3124
msgctxt "text_id=17151 | speaker=unknown"
msgid "  She finally understood."
msgstr "　何の為に戻ってきたのか。"

#. Occurrence C_10:3129:17152: scene=C_10
#: C_10:3129
msgctxt "text_id=17152 | speaker=unknown"
msgid "  She remembers why she came back, and what she wanted to scream―"
msgstr "　何を叫びたいのか、彼女はようやく思い出し―――"

#. Occurrence C_10:3181:17153: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_10_0010; voice_prefix=A10; voice_category=1; scene=C_10
#: C_10:3181
msgctxt "text_id=17153 | speaker=aoko"
msgid "\"By the name Blue, I speak for order. Hear me.\""
msgstr "「<秩序|あお>を示す我が<銘|な>において告げる」"

#. Occurrence C_10:3193:17154: scene=C_10
#: C_10:3193
msgctxt "text_id=17154 | speaker=unknown"
msgid "  A censuring voice told her to stop."
msgstr "　止めろ、と<正|ただ>す声がする。"

#. Occurrence C_10:3198:17155: scene=C_10
#: C_10:3198
msgctxt "text_id=17155 | speaker=unknown"
msgid "  At the edges of oblivion, her hand touched the true form of Magic."
msgstr "　忘我の果てに魔法の正体に手が届く。"

#. Occurrence C_10:3203:17156: scene=C_10
#: C_10:3203
msgctxt "text_id=17156 | speaker=unknown"
msgid "  The snarling red shadow was there, telling her it was no use."
msgstr "　それでは意味がない、と牙を伸ばす赤色の影がいる。"

#. Occurrence C_10:3208:17157: scene=C_10
#: C_10:3208
msgctxt "text_id=17157 | speaker=unknown"
msgid "  So much doubt, so much fear."
msgstr "　多くの迷い、多くの怒り。"

#. Occurrence C_10:3214:17158: scene=C_10
#: C_10:3214
msgctxt "text_id=17158 | speaker=unknown"
msgid "  But such things mean nothing to her... to me."
msgstr "　けれどそんなもの、彼女には／ワタシには関係ない。"

#. Occurrence C_10:3235:17159: scene=C_10
#: C_10:3235
msgctxt "text_id=17159 | speaker=unknown"
msgid "  I don't care about a Magician's obligations or the destruction of mankind."
msgstr "　魔法使いの責務とか、これで人類滅亡とか勝手にしろ。"

#. Occurrence C_10:3240:17160: scene=C_10
#: C_10:3240
msgctxt "text_id=17160 | speaker=unknown"
msgid "  I'm sick and tired of hearing about it."
msgstr "　いいかげんもう聞き飽きた。"

#. Occurrence C_10:3245:17161: scene=C_10
#: C_10:3245
msgctxt "text_id=17161 | speaker=unknown"
msgid "  I only have one reason for doing *anything* right now."
msgstr "　いま、私が指を動かす理由はたった一つ。"

#. Occurrence C_10:3251:17162: scene=C_10
#: C_10:3251
msgctxt "text_id=17162 | speaker=unknown"
msgid "I just... God, I can't believe I'm saying this out loud..."
msgstr "つまり、なんていうか、口にするのもどうかと思うけど―――"

#. Occurrence C_10:3261:17163: scene=C_10
#: C_10:3261
msgctxt "text_id=17163 | speaker=unknown"
msgid "  I just want to save him!!!"
msgstr "　私はこんなにも、コイツを助けたがってる……！！！！"

#. Occurrence C_10:3392:17164: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_10_0011; voice_prefix=A10; voice_category=1; scene=C_10
#. Occurrence C_10:4183:17164: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_10_0011; voice_prefix=A10; voice_category=1; scene=C_10
#: C_10:3392 C_10:4183
msgctxt "text_id=17164 | speaker=aoko"
msgid "\"All is not sane, yet all shall be right.\""
msgstr "「―――<全て|not,>は<正し|SANE>く」"

#. Occurrence C_10:3398:17165: scene=C_10
#. Occurrence C_10:4189:17165: scene=C_10
#: C_10:3398 C_10:4189
msgctxt "text_id=17165 | speaker=unknown"
msgid "  A blue whirlwind whisked up around her."
msgstr "　沸き上がる青い旋風。"

#. Occurrence C_10:3403:17166: scene=C_10
#. Occurrence C_10:4194:17166: scene=C_10
#: C_10:3403 C_10:4194
msgctxt "text_id=17166 | speaker=unknown"
msgid "  Casting aside her doubt and sorrow, the Magician played her trick upon the world."
msgstr "　迷いも<憂|うれ>いも捨てさった瞳で、魔法使いは世界を相手にペテンを始める。"

#. Occurrence C_10:3509:17167: scene=C_10
#. Occurrence C_10:4291:17167: scene=C_10
#: C_10:3509 C_10:4291
msgctxt "text_id=17167 | speaker=unknown"
msgid "  Time flowed backward."
msgstr "　逆行する時間。"

#. Occurrence C_10:3750:17168: scene=C_10
#. Occurrence C_10:4512:17168: scene=C_10
#: C_10:3750 C_10:4512
msgctxt "text_id=17168 | speaker=unknown"
msgid "  Childhood memories were overwritten."
msgstr "　書き換えられる原風景。"

#. Occurrence C_10:4049:17169: scene=C_10
#. Occurrence C_10:4760:17169: scene=C_10
#: C_10:4049 C_10:4760
msgctxt "text_id=17169 | speaker=unknown"
msgid "  White flowers appeared, as far as the eye could see."
msgstr "　見れば、それは白い花だった。"

#. Occurrence C_10:4054:17170: scene=C_10
#. Occurrence C_10:4765:17170: scene=C_10
#: C_10:4054 C_10:4765
msgctxt "text_id=17170 | speaker=unknown"
msgid "  Brighter than snow, they rippled like a wave across the world, devouring it."
msgstr "　雪よりも真白い野花の<群|むれ>は、さざ波のように世界を侵食していき、そして―――"

#. Occurrence C_10:4866:17171: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_10_0012; voice_prefix=A10; voice_category=1; scene=C_10
#: C_10:4866
msgctxt "text_id=17171 | speaker=aoko"
msgid "\"Five timeless words: Order has fallen to ruin.\""
msgstr "「―――秩<序|five>は、こ<こに崩れ落ち|　timeless words>た」"

#. Occurrence C_10:4872:17172: scene=C_10
#: C_10:4872
msgctxt "text_id=17172 | speaker=unknown"
msgid "  What was declared had come to be."
msgstr "　宣言通り。"

#. Occurrence C_10:4877:17173: scene=C_10
#: C_10:4877
msgctxt "text_id=17173 | speaker=unknown"
msgid "  In this time and place alone, the Fifth Magic made itself known."
msgstr "　五番目の魔法が、この時間、この領域にだけ、その姿を現した。"

#. Occurrence C_11:157:17174: scene=C_11
#: C_11:157
msgctxt "text_id=17174 | speaker=unknown"
msgid "  In the blink of an eye, the snowy clearing had transformed."
msgstr "　人里離れた雪の広場は、<瞬|またた>きの間に変貌した。"

#. Occurrence C_11:162:17175: scene=C_11
#: C_11:162
msgctxt "text_id=17175 | speaker=unknown"
msgid "  A sea of fully-bloomed white flowers blanketed the grounds."
msgstr "　一面に咲き誇る白花の海。"

#. Occurrence C_11:167:17176: scene=C_11
#: C_11:167
msgctxt "text_id=17176 | speaker=unknown"
msgid "  Only the dilapidated school building and the bare winter trees signified this was the original world."
msgstr "　周囲にある裸の木々と朽ちた旧校舎だけが、ここが元の世界である事を告げている。"

#. Occurrence C_11:172:17177: scene=C_11
#: C_11:172
msgctxt "text_id=17177 | speaker=unknown"
msgid "  The once-cold wind now blew with a pleasant warmth across the landscape."
msgstr "　冷たい風もこの野原では暖かだ。"

#. Occurrence C_11:177:17178: scene=C_11
#: C_11:177
msgctxt "text_id=17178 | speaker=unknown"
msgid "  Even the night sky was once again teeming with stars."
msgstr "　見上げる夜空すら、満天の星の夜に戻っている。"

#. Occurrence C_11:212:17179: scene=C_11
#: C_11:212
msgctxt "text_id=17179 | speaker=unknown"
msgid "  If one reached out, one could almost touch them."
msgstr "　手を伸ばせば届きそうなほど近い星の明かり。"

#. Occurrence C_11:217:17180: scene=C_11
#: C_11:217
msgctxt "text_id=17180 | speaker=unknown"
msgid "  It was a mix of comfort and solitude, quiet enough to carry the sound of insects flying through the air."
msgstr "　淋しさも心地よさも混ざり合った、虫の羽音と夜の<囁|ささや>きだけの孤影。"

#. Occurrence C_11:222:17181: scene=C_11
#: C_11:222
msgctxt "text_id=17181 | speaker=unknown"
msgid "  A scene far removed from the impurity and grief of humans."
msgstr "　人の営みを<排|はい>した、<穢|けが>れも<悼|いた>みもない風景。"

#. Occurrence C_11:227:17182: scene=C_11
#: C_11:227
msgctxt "text_id=17182 | speaker=unknown"
msgid "  A world with nothing, yet one that needed nothing."
msgstr "　何もないけれど、同時に何も必要としない世界。"

#. Occurrence C_11:233:17183: scene=C_11
#: C_11:233
msgctxt "text_id=17183 | speaker=unknown"
msgid "  It was... his most precious memory."
msgstr "　……そしてそれが、彼の一番だった頃。"

#. Occurrence C_11:303:17184: scene=C_11
#: C_11:303
msgctxt "text_id=17184 | speaker=unknown"
msgid "  The winter tundra had changed into a spring meadow."
msgstr "　冬の荒地を、春の草原に変えてしまう。"

#. Occurrence C_11:308:17185: scene=C_11
#: C_11:308
msgctxt "text_id=17185 | speaker=unknown"
msgid "  Aoko's so-called True Magic confused Touko."
msgstr "　それが青子の言う『魔法』だという事に、橙子は呆然としていた。"

#. Occurrence C_11:313:17186: scene=C_11
#: C_11:313
msgctxt "text_id=17186 | speaker=unknown"
msgid "  Sure it was pleasing to the eye, but she wanted to see something less idyllic."
msgstr "　これはこれで悪くはないが、彼女の見たかった『魔法』は断じて、こんなロマンチックなだけのものではない。"

#. Occurrence C_11:333:17187: scene=C_11
#: C_11:333
msgctxt "text_id=17187 | speaker=unknown"
msgid "  Aoko's spell was clearly no small feat, but the surrounding mana had not changed."
msgstr "　何か大がかりな術式を展開したようだが、周囲の<魔力|マナ>に変化もない。"

#. Occurrence C_11:338:17188: scene=C_11
#: C_11:338
msgctxt "text_id=17188 | speaker=unknown"
msgid "  Better to be confused, though, than deal with something like Alice Kuonji's Flat Snark."
msgstr "　拍子抜けもいいところだ。久遠寺有珠のフラットスナークに比べれば<児|じ><戯|ぎ>に等しい。"

#. Occurrence C_11:380:17189: scene=C_11
#: C_11:380
msgctxt "text_id=17189 | speaker=unknown"
msgid "  The only changes seemed to be the flower field, and..."
msgstr "　変わったのはこの花園と、あの―――"

#. Occurrence C_11:433:17190: scene=C_11
#: C_11:433
msgctxt "text_id=17190 | speaker=unknown"
msgid "  Aoko's appearance."
msgstr "　出で立ちの変わった青子だけ。"

#. Occurrence C_11:438:17191: scene=C_11
#: C_11:438
msgctxt "text_id=17191 | speaker=unknown"
msgid "  She seemed to have received some enhancement to her physical form, but it would never be enough to match Touko."
msgstr "　自身の肉体に何らかの<強化|ブースト>をかけたと見るべきだが、今の青子では何をしようと橙子には及ばない。"

#. Occurrence C_11:444:17192: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_11_0000; voice_prefix=A20; voice_category=11; scene=C_11
#: C_11:444
msgctxt "text_id=17192 | speaker=touko"
msgid "\"...Okay, so I know this is Magic,\""
msgstr "「……たしかに、魔法といえば魔法だが」"

#. Occurrence C_11:449:17193: scene=C_11
#: C_11:449
msgctxt "text_id=17193 | speaker=unknown"
msgid "  Touko said with a hint of annoyance,"
msgstr "　呟きには微かな苛立ちがある。"

#. Occurrence C_11:470:17194: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_11_0001; voice_prefix=A20; voice_category=11; scene=C_11
#: C_11:470
msgctxt "text_id=17194 | speaker=touko"
msgid "\"but I'll be honest, this is a letdown."
msgstr "「あいにくと、お互い夢見る年頃ではないんだ。"

#. Occurrence C_11:515:17195: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_11_0002; voice_prefix=A20; voice_category=11; scene=C_11
#: C_11:515
msgctxt "text_id=17195 | speaker=touko"
msgid "  There has to be more, surely. This can't be it.\""
msgstr "　まさか、それで終わりではないだろう？」"

#. Occurrence C_11:537:17196: scene=C_11
#: C_11:537
msgctxt "text_id=17196 | speaker=unknown"
msgid "  Aoko began walking through the sea of flowers."
msgstr "　青子は花の海を歩き始める。"

#. Occurrence C_11:554:17197: scene=C_11
#: C_11:554
msgctxt "text_id=17197 | speaker=unknown"
msgid "  But she was not heading toward Touko."
msgstr "　向かう先は、遠方にいる橙子に他ならない。"

#. Occurrence C_11:569:17198: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_11_0000; voice_prefix=A10; voice_category=1; scene=C_11
#: C_11:569
msgctxt "text_id=17198 | speaker=aoko"
msgid "\"This is it. For me, and for you.\""
msgstr "「いえ、これでおしまいよ。私も、貴女も」"

#. Occurrence C_11:618:17199: scene=C_11
#: C_11:618
msgctxt "text_id=17199 | speaker=unknown"
msgid "  Aoko's words sent a wave of unease through Touko."
msgstr "　短く返された言葉に、橙子は微妙な違和感をおぼえた。"

#. Occurrence C_11:629:17200: scene=C_11
#: C_11:629
msgctxt "text_id=17200 | speaker=unknown"
msgid "  Her sister's voice seemed different, somehow."
msgstr "　今の声は、青子とは違う気がする。"

#. Occurrence C_11:634:17201: scene=C_11
#: C_11:634
msgctxt "text_id=17201 | speaker=unknown"
msgid "  It was mostly the same in pitch, so it had to be the tone."
msgstr "　声質はほぼ同じだから、口調が違うのだろうか？"

#. Occurrence C_11:639:17202: scene=C_11
#: C_11:639
msgctxt "text_id=17202 | speaker=unknown"
msgid "  No, that was the same, too."
msgstr "　いや、それも同じだ。"

#. Occurrence C_11:644:17203: scene=C_11
#: C_11:644
msgctxt "text_id=17203 | speaker=unknown"
msgid "  Something was off. Could it be...?"
msgstr "　どこか違うとしたら、それは………。"

#. Occurrence C_11:704:17204: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_11_0003; voice_prefix=A20; voice_category=11; scene=C_11
#: C_11:704
msgctxt "text_id=17204 | speaker=touko"
msgid "\"...!\""
msgstr "「――――――！」"

#. Occurrence C_11:710:17205: scene=C_11
#: C_11:710
msgctxt "text_id=17205 | speaker=unknown"
msgid "  It was then Touko noticed something else that had changed-"
msgstr "　そこで、橙子はもう一つの変化に気が付いた。"

#. Occurrence C_11:715:17206: scene=C_11
#: C_11:715
msgctxt "text_id=17206 | speaker=unknown"
msgid "  not just Aoko and the clearing."
msgstr "　変わったのは広場と青子だけではない。"

#. Occurrence C_11:720:17207: scene=C_11
#: C_11:720
msgctxt "text_id=17207 | speaker=unknown"
msgid "  The severed body lying at Aoko's feet: it was now whole."
msgstr "　青子の足下、二つになっていた死体が復元している。"

#. Occurrence C_11:803:17208: scene=C_11
#: C_11:803
msgctxt "text_id=17208 | speaker=unknown"
msgid "  Corpse reanimation? Wound healing?"
msgstr "　死者の蘇生？　傷の治療？"

#. Occurrence C_11:808:17209: scene=C_11
#: C_11:808
msgctxt "text_id=17209 | speaker=unknown"
msgid "  It did not look like Aoko had used a significant formula; and besides, regenerating a body did not bring it back to life."
msgstr "　そんな大がかりな術式を施した様子はないし、何より、体を復元したところで“死”は<覆|くつがえ>らない。"

#. Occurrence C_11:813:17210: scene=C_11
#: C_11:813
msgctxt "text_id=17210 | speaker=unknown"
msgid "  Since the dawn of time, even True Magic has never been able to bring back the dead."
msgstr "　古来、死者の<完|・><全|・><な|・>蘇生は魔法ですら叶えていない。"

#. Occurrence C_11:818:17211: scene=C_11
#: C_11:818
msgctxt "text_id=17211 | speaker=unknown"
msgid "  But the body of the boy behind Aoko was moving! It was breathing, like it was taking a nap!"
msgstr "　だが―――青子の背後で倒れている青年が、意識がないまま呼吸をしているのはどう説明する―――！？"

#. Occurrence C_11:889:17212: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_11_0004; voice_prefix=A20; voice_category=11; scene=C_11
#: C_11:889
msgctxt "text_id=17212 | speaker=touko"
msgid "(Can the Aozaki Magic resurrect the dead...?"
msgstr "“死者の蘇生が蒼崎の魔法……？"

#. Occurrence C_11:895:17213: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_11_0005; voice_prefix=A20; voice_category=11; scene=C_11
#: C_11:895
msgctxt "text_id=17213 | speaker=touko"
msgid "  No way. This isn't resurrection, it's...)"
msgstr "　いや違う。あれは蘇生というより……”"

#. Occurrence C_11:970:17214: scene=C_11
#: C_11:970
msgctxt "text_id=17214 | speaker=unknown"
msgid "  Before she could think of an answer, Touko realized what had seemed out of place to her before."
msgstr "　その答えが出るより早く、橙子は違和感の正体に気が付いた。"

#. Occurrence C_11:975:17215: scene=C_11
#: C_11:975
msgctxt "text_id=17215 | speaker=unknown"
msgid "  Aoko's mannerisms appeared beyond her years."
msgstr "　先ほどの青子の仕草は年相応のものではなかった。"

#. Occurrence C_11:980:17216: scene=C_11
#: C_11:980
msgctxt "text_id=17216 | speaker=unknown"
msgid "  Her appearance had changed ever-so slightly, but beyond there had been a change from within."
msgstr "　わずかな外見の変化より、留意すべきは中身の変化だ。"

#. Occurrence C_11:985:17217: scene=C_11
#: C_11:985
msgctxt "text_id=17217 | speaker=unknown"
msgid "  By the time Touko arrived at that seemingly impossible conclusion, Aoko had closed the distance between them."
msgstr "　まさかの結論に達した時、青子は橙子との距離を残り十メートルまで詰めていた。"

#. Occurrence C_11:1008:17218: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_11_0001; voice_prefix=A10; voice_category=1; scene=C_11
#: C_11:1008
msgctxt "text_id=17218 | speaker=aoko"
msgid "\"...<Circuit, connected.|Turbine, set.>\""
msgstr "「―――<回路|タービン>、<接続|セット>」"

#. Occurrence C_11:1014:17219: scene=C_11
#: C_11:1014
msgctxt "text_id=17219 | speaker=unknown"
msgid "  Aoko raised her left hand to eye level."
msgstr "　その左手が、目の高さまで上げられる。"

#. Occurrence C_11:1109:17220: scene=C_11
#: C_11:1109
msgctxt "text_id=17220 | speaker=unknown"
msgid "  Touko could see-no, hear the magical energy generating inside Aoko."
msgstr "　青子の体内で生成される魔力量が目に見えて……いや、耳に聞こえるほど違う。"

#. Occurrence C_11:1114:17221: scene=C_11
#: C_11:1114
msgctxt "text_id=17221 | speaker=unknown"
msgid "  It was sound Touko had never heard before."
msgstr "　橙子ですら聞いた事のない快音。"

#. Occurrence C_11:1119:17222: scene=C_11
#: C_11:1119
msgctxt "text_id=17222 | speaker=unknown"
msgid "  Aoko only possessed single function, low-grade circuits no better than any other third-rate mage, so she generated magical energy at a much lower rate than Touko."
msgstr "　青子のソレは、<凡夫|ぼんぷ>の魔術師に見られる、単一機能しか持たない低級魔術回路だ。魔力の生成量は橙子を遥かに下回る。"

#. Occurrence C_11:1139:17223: scene=C_11
#: C_11:1139
msgctxt "text_id=17223 | speaker=unknown"
msgid "  However, this speed was absurdly quick."
msgstr "　だがあの速度は異常にすぎる。"

#. Occurrence C_11:1144:17224: scene=C_11
#: C_11:1144
msgctxt "text_id=17224 | speaker=unknown"
msgid "  Moving even faster than the blood pumping through her body."
msgstr "　あきらかに血流の速度を上回っているし、なにより―――"

#. Occurrence C_11:1212:17225: scene=C_11
#: C_11:1212
msgctxt "text_id=17225 | speaker=unknown"
msgid "  Magecraft could vibrate, but how in the hell were the activated Magic Circuits audible? Even the Association had never heard of such a thing!"
msgstr "　魔術による<振動|おと>ならともかく、<た|・><だ|・><魔|・><術|・><回|・><路|・><が|・><起|・><動|・><す|・><る|・><だ|・><け|・><で|・><波|おと>をあげるなど、協会でも聞いた事がない―――！"

#. Occurrence C_11:1256:17226: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_11_0006; voice_prefix=A20; voice_category=11; scene=C_11
#: C_11:1256
msgctxt "text_id=17226 | speaker=touko"
msgid "\"Onward, to victory.\""
msgstr "「我が目前に勝利ありき―――」"

#. Occurrence C_11:1358:17227: scene=C_11
#: C_11:1358
msgctxt "text_id=17227 | speaker=unknown"
msgid "  Spurred to action by the sudden dread she felt, Touko hurriedly carved runes into the air."
msgstr "　<悪寒|おかん>に<急|せ>かされるよう、橙子は中空にルーンを刻む。"

#. Occurrence C_11:1363:17228: scene=C_11
#: C_11:1363
msgctxt "text_id=17228 | speaker=unknown"
msgid "  Touko summoned the divine protection of victory, Tyr, to surround herself with a barrier, which was further enhanced by her crests."
msgstr "　青子が仕掛けてくるであろう魔術を防ぐため<勝利|トゥール>の加護を張り、さらに刻印の力で強化し、障壁としたのだ。"

#. Occurrence C_11:1450:17229: scene=C_11
#: C_11:1450
msgctxt "text_id=17229 | speaker=unknown"
msgid "  Paying it no mind, Aoko held her arm steady, not moving it up to strike her target directly."
msgstr "　対して、青子は意にも介さず、照準を合わせる為に腕をあげる事もなく、"

#. Occurrence C_11:1457:17230: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_11_0002; voice_prefix=A10; voice_category=1; scene=C_11
#: C_11:1457
msgctxt "text_id=17230 | speaker=aoko"
msgid "\"...Bullets, deploy.\""
msgstr "「―――魔弾、展開」"

#. Occurrence C_11:1463:17231: scene=C_11
#: C_11:1463
msgctxt "text_id=17231 | speaker=unknown"
msgid "  Aoko commanded herself succinctly."
msgstr "　短く、自分自身に命令した。"

#. Occurrence C_11:1768:17232: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_11_0007; voice_prefix=A20; voice_category=11; scene=C_11
#: C_11:1768
msgctxt "text_id=17232 | speaker=touko"
msgid "\"???!!!\""
msgstr "「！！！？」"

#. Occurrence C_11:1774:17233: scene=C_11
#: C_11:1774
msgctxt "text_id=17233 | speaker=unknown"
msgid "  This was beyond magecraft."
msgstr "　魔術の起こりさえ見えない。"

#. Occurrence C_11:1779:17234: scene=C_11
#: C_11:1779
msgctxt "text_id=17234 | speaker=unknown"
msgid "  In just a few words, she had fired twenty magic bullets."
msgstr "　一言で放たれた魔弾は実に二十発。"

#. Occurrence C_11:1784:17235: scene=C_11
#: C_11:1784
msgctxt "text_id=17235 | speaker=unknown"
msgid "  Like a meteor shower, the bullets smashed through the rocket-proof rune barrier, as well as Touko's spell-woven coat."
msgstr "　それは流星のように、ロケット弾すら弾くルーンの壁を溶解し、蒼崎橙子の<礼装|コート>を撃ち抜いた。"

#. Occurrence C_11:1944:17236: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_11_0008; voice_prefix=A20; voice_category=11; scene=C_11
#: C_11:1944
msgctxt "text_id=17236 | speaker=touko"
msgid "\"You shot them without loading?!\""
msgstr "「っ、装填ではなく展開だと―――！？」"

#. Occurrence C_11:1950:17237: scene=C_11
#: C_11:1950
msgctxt "text_id=17237 | speaker=unknown"
msgid "  The protective runes lining her coat screamed."
msgstr "　<礼装|コート>にかけてある防護のルーンが悲鳴をあげる。"

#. Occurrence C_11:1955:17238: scene=C_11
#: C_11:1955
msgctxt "text_id=17238 | speaker=unknown"
msgid "  They would not be able to take another barrage like that."
msgstr "　あの掃射をもう一度受ければ<保|も>たない。"

#. Occurrence C_11:1960:17239: scene=C_11
#: C_11:1960
msgctxt "text_id=17239 | speaker=unknown"
msgid "  And she had already taken internal injuries."
msgstr "　それ以前に、今の直撃で間違いなく<内臓|かいろ>に傷が入った。"

#. Occurrence C_11:1980:17240: scene=C_11
#: C_11:1980
msgctxt "text_id=17240 | speaker=unknown"
msgid "  She loathed to admit it, but Aoko vastly outclassed Touko in terms of raw power."
msgstr "　認めたくはないが、直接的な火力において蒼崎青子は蒼崎橙子を上回っている。"

#. Occurrence C_11:2035:17241: scene=C_11
#: C_11:2035
msgctxt "text_id=17241 | speaker=unknown"
msgid "  Even harder to admit was that her sister probably had not even brought out the big guns yet."
msgstr "　さらに認めがたいのは―――おそらく、あの女はまだ<本|・><気|・><に|・><す|・><ら|・><な|・><っ|・><て|・><い|・><な|・><い|・>……！"

#. Occurrence C_11:2072:17242: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_11_0009; voice_prefix=A20; voice_category=11; scene=C_11
#: C_11:2072
msgctxt "text_id=17242 | speaker=touko"
msgid "\"Ansuz, Sowilo, Ingwaz!\""
msgstr "「<[ansz]|アンサズ>、<[swel]|ソウェル>、<[ingz]|イングズ>ッ！」"

#. Occurrence C_11:2109:17243: scene=C_11
#: C_11:2109
msgctxt "text_id=17243 | speaker=unknown"
msgid "  Jumping backward, Touko drew more runic symbols in the air."
msgstr "　橙子は跳びのきながら中空にルーンを描く。"

#. Occurrence C_11:2114:17244: scene=C_11
#: C_11:2114
msgctxt "text_id=17244 | speaker=unknown"
msgid "  In response, her crests burned brightly."
msgstr "　一喝に応じて刻印は炎へと転じていく。"

#. Occurrence C_11:2119:17245: scene=C_11
#: C_11:2119
msgctxt "text_id=17245 | speaker=unknown"
msgid "  But..."
msgstr "　だが。"

#. Occurrence C_11:2128:17246: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_11_0003; voice_prefix=A10; voice_category=1; scene=C_11
#: C_11:2128
msgctxt "text_id=17246 | speaker=aoko"
msgid "\"...Too slow!\""
msgstr "「―――<古|おそ>いっ！」"

#. Occurrence C_11:2210:17247: scene=C_11
#: C_11:2210
msgctxt "text_id=17247 | speaker=unknown"
msgid "  With a single word, Aoko nullified the runes,"
msgstr "　それを、青子はただ一言で打ち消した。"

#. Occurrence C_11:2215:17248: scene=C_11
#: C_11:2215
msgctxt "text_id=17248 | speaker=unknown"
msgid "  dissolving them before they could be given meaning."
msgstr "　ルーンは意味を持つ前に砕け散る。"

#. Occurrence C_11:2220:17249: scene=C_11
#: C_11:2220
msgctxt "text_id=17249 | speaker=unknown"
msgid "  The power of Aoko's words had surpassed the magical energy of Touko's rune magecraft."
msgstr "　単純に、ルーンをカタチにする橙子の魔力より、彼女の言葉の力が上回ったのだ。"

#. Occurrence C_11:2280:17250: scene=C_11
#: C_11:2280
msgctxt "text_id=17250 | speaker=unknown"
msgid "  With the runes nullified, Aoko continued advancing through the white flowers."
msgstr "　ルーンを無効化し、青子は白い花園を突き進む。"

#. Occurrence C_11:2285:17251: scene=C_11
#: C_11:2285
msgctxt "text_id=17251 | speaker=unknown"
msgid "  From her calmness to the robust spinning of her Magic Circuits and her breathing, she was different."
msgstr "　その<表情|かお>も、安定した魔術回路の働きも、息遣いさえ今までの彼女とは違う。"

#. Occurrence C_11:2290:17252: scene=C_11
#: C_11:2290
msgctxt "text_id=17252 | speaker=unknown"
msgid "  A woman with sublime self-control, a trait only found in mages with a lifetime of combat experience."
msgstr "　それは多くの戦闘経験を得た者にしか出来えない、最適化された自己管理だ。"

#. Occurrence C_11:2311:17253: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_11_0010; voice_prefix=A20; voice_category=11; scene=C_11
#: C_11:2311
msgctxt "text_id=17253 | speaker=touko"
msgid "\"Y-You traveled in time!\""
msgstr "「―――あれは、<経験|じかん>か―――？」"

#. Occurrence C_11:2316:17254: scene=C_11
#: C_11:2316
msgctxt "text_id=17254 | speaker=unknown"
msgid "  Given the evidence, that was the only explanation for the Aozaki Magic."
msgstr "　それが蒼崎の魔法の正体だとしたら、たしかにすべてが<符|ふ><合|ごう>する。"

#. Occurrence C_11:2336:17255: scene=C_11
#: C_11:2336
msgctxt "text_id=17255 | speaker=unknown"
msgid "  Aoko's Magic Circuits had not been amplified."
msgstr "　青子の魔術回路が増幅されたのではない。"

#. Occurrence C_11:2341:17256: scene=C_11
#: C_11:2341
msgctxt "text_id=17256 | speaker=unknown"
msgid "  That would have been impossible anyway. Like Touko, she would have to externalize them, which would just increase the scope of her magical energy and techniques."
msgstr "　そもそもそんな事は出来ないし、橙子のように外付けにしたところで、増えるのは魔力の総量と使用可能な術式だけ。"

#. Occurrence C_11:2347:17257: scene=C_11
#: C_11:2347
msgctxt "text_id=17257 | speaker=unknown"
msgid "By nature, the quality of a mage's Magic Circuits did not change."
msgstr "魔術師自体の資質、魔術回路の純度は変わらない。"

#. Occurrence C_11:2352:17258: scene=C_11
#: C_11:2352
msgctxt "text_id=17258 | speaker=unknown"
msgid "  But Aoko was now clearly a superior mage to Touko."
msgstr "　だが、今の青子は明らかに<魔|・><術|・><師|・><と|・><し|・><て|・>蒼崎橙子を凌駕している。"

#. Occurrence C_11:2373:17259: scene=C_11
#: C_11:2373
msgctxt "text_id=17259 | speaker=unknown"
msgid "  So there was only one logical conclusion."
msgstr "　ならば答えは一つ。"

#. Occurrence C_11:2396:17260: scene=C_11
#: C_11:2396
msgctxt "text_id=17260 | speaker=unknown"
msgid "  In an instant, she had grown from an amateur to a veteran."
msgstr "　あの見習い魔術師は一瞬で一人前の魔術師に成長―――"

#. Occurrence C_11:2396:17261: scene=C_11
#: C_11:2396
msgctxt "text_id=17261 | speaker=unknown"
msgid "  She fast-forwarded her own time."
msgstr "　いや、自身の<時|・><間|・><を|・><早|・><送|・><り|・>したのだ。"

#. Occurrence C_11:2463:17262: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_11_0011; voice_prefix=A20; voice_category=11; scene=C_11
#: C_11:2463
msgctxt "text_id=17262 | speaker=touko"
msgid "\"...!\""
msgstr "「っ―――！」"

#. Occurrence C_11:2497:17263: scene=C_11
#: C_11:2497
msgctxt "text_id=17263 | speaker=unknown"
msgid "  The Scarred Red mage turned her back on her sister and ran."
msgstr "　青子に背を向けて、オレンジ色の魔術師は走りだした。"

#. Occurrence C_11:2502:17264: scene=C_11
#: C_11:2502
msgctxt "text_id=17264 | speaker=unknown"
msgid "  She knew she could not win, so she fled toward the old school building."
msgstr "　<こ|・><こ|・>では勝ち目がないと直感し、旧校舎に逃げこんでいく。"

#. Occurrence C_11:2507:17265: scene=C_11
#: C_11:2507
msgctxt "text_id=17265 | speaker=unknown"
msgid "  Aoko did not fire."
msgstr "　その背中を青子は狙わなかった。"

#. Occurrence C_11:2512:17266: scene=C_11
#: C_11:2512
msgctxt "text_id=17266 | speaker=unknown"
msgid "  Not out of pity, but because she deduced that an attack at this range was risky."
msgstr "　情けからではなく、冷静に、この距離からでは仕損じると判断して。"

#. Occurrence C_11:2533:17267: scene=C_11
#: C_11:2533
msgctxt "text_id=17267 | speaker=unknown"
msgid "  She went to chase after her sister, but stopped suddenly."
msgstr "　逃すまいと青子は身を乗り出し、はた、と思い立ったように足を止めた。"

#. Occurrence C_11:2579:17268: scene=C_11
#: C_11:2579
msgctxt "text_id=17268 | speaker=unknown"
msgid "  ...A few words caught in her throat."
msgstr "　……言葉にするのは少し迷う。"

#. Occurrence C_11:2584:17269: scene=C_11
#: C_11:2584
msgctxt "text_id=17269 | speaker=unknown"
msgid "  She took a small breath."
msgstr "　彼女は小さく息を呑んで、"

#. Occurrence C_11:2601:17270: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_11_0004; voice_prefix=A10; voice_category=1; scene=C_11
#: C_11:2601
msgctxt "text_id=17270 | speaker=aoko"
msgid "\"Watch him, Alice.\""
msgstr "「アリス。そいつ、お願い」"

#. Occurrence C_11:2674:17271: scene=C_11
#: C_11:2674
msgctxt "text_id=17271 | speaker=unknown"
msgid "  She said, slightly embarrassed by the maturity of her voice."
msgstr "　大人びた声を恥じるように、そんな言葉を口にした。"

#. Occurrence C_11:2757:17272: scene=C_11
#: C_11:2757
msgctxt "text_id=17272 | speaker=unknown"
msgid "  White petals flitted through the air."
msgstr "　白い花が散っていく。"

#. Occurrence C_11:2762:17273: scene=C_11
#: C_11:2762
msgctxt "text_id=17273 | speaker=unknown"
msgid "  Without looking back, she made after Touko, her long hair flowing behind her."
msgstr "　青子は振り返らず、長い髪をなびかせて橙子の後を追っていった。"

#. Occurrence C_12:70:17274: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0000; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:70
msgctxt "text_id=17274 | speaker=soujuurou"
msgid "\"...Huh?\""
msgstr "「―――あれ？」"

#. Occurrence C_12:76:17275: scene=C_12
#: C_12:76
msgctxt "text_id=17275 | speaker=unknown"
msgid "  His eyelids snapped open."
msgstr "　ぱちり、と軽快に<目蓋|まぶた>が開く。"

#. Occurrence C_12:81:17276: scene=C_12
#: C_12:81
msgctxt "text_id=17276 | speaker=unknown"
msgid "  At last, Soujyuro awoke from his long slumber."
msgstr "　<永|なが>い休眠から草十郎は目を覚ました。"

#. Occurrence C_12:101:17277: scene=C_12
#: C_12:101
msgctxt "text_id=17277 | speaker=unknown"
msgid "  Lying on his back, he gazed up at the stars."
msgstr "　仰向けに寝っころがっているらしく、視界にはいっぱいの星空が広がっている。"

#. Occurrence C_12:106:17278: scene=C_12
#: C_12:106
msgctxt "text_id=17278 | speaker=unknown"
msgid "  The trees around him created a porthole into space."
msgstr "　木々によって形作られた円形の空。"

#. Occurrence C_12:111:17279: scene=C_12
#: C_12:111
msgctxt "text_id=17279 | speaker=unknown"
msgid "  Despite seeing all this for the first time,"
msgstr "　それは初めて見たものなのに、"

#. Occurrence C_12:116:17280: scene=C_12
#: C_12:116
msgctxt "text_id=17280 | speaker=unknown"
msgid "  he felt an uncomfortable sense of déjà vu."
msgstr "　久しく忘れていた景色に見えて、居心地が悪かった。"

#. Occurrence C_12:187:17281: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0001; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:187
msgctxt "text_id=17281 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence C_12:193:17282: scene=C_12
#: C_12:193
msgctxt "text_id=17282 | speaker=unknown"
msgid "  So many questions."
msgstr "　どうにも自分が確かではない。"

#. Occurrence C_12:198:17283: scene=C_12
#: C_12:198
msgctxt "text_id=17283 | speaker=unknown"
msgid "  What happened before he fell asleep?"
msgstr "　眠る前に何をしていたのか、"

#. Occurrence C_12:203:17284: scene=C_12
#: C_12:203
msgctxt "text_id=17284 | speaker=unknown"
msgid "  Why had he been sleeping?"
msgstr "　どうして眠っていたのか、"

#. Occurrence C_12:208:17285: scene=C_12
#: C_12:208
msgctxt "text_id=17285 | speaker=unknown"
msgid "  Everything was just so hazy."
msgstr "　キレイさっぱり記憶にない。"

#. Occurrence C_12:213:17286: scene=C_12
#: C_12:213
msgctxt "text_id=17286 | speaker=unknown"
msgid "  It was like he had walked out the door one minute, and woken up in bed the next."
msgstr "　これから出かけようと玄関をすぎた直後、目を開けたらベッドにいたような気分だ。"

#. Occurrence C_12:234:17287: scene=C_12
#: C_12:234
msgctxt "text_id=17287 | speaker=unknown"
msgid "  With so many thoughts clouding his mind, he could barely recall his own name."
msgstr "　前後の出来事が無さすぎて、自分が何者であるのかさえ、すぐには思い至らない。"

#. Occurrence C_12:285:17288: scene=C_12
#: C_12:285
msgctxt "text_id=17288 | speaker=unknown"
msgid "  All he could remember..."
msgstr "　思い出せるのはただ、"

#. Occurrence C_12:345:17289: scene=C_12
#: C_12:345
msgctxt "text_id=17289 | speaker=unknown"
msgid "  ...was a girl he'd never seen before,"
msgstr "　見たこともない女の人と、"

#. Occurrence C_12:407:17290: scene=C_12
#: C_12:407
msgctxt "text_id=17290 | speaker=unknown"
msgid "  and something thin around his neck."
msgstr "　首にかかった細い"

#. Occurrence C_12:443:17291: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0000; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:443
msgctxt "text_id=17291 | speaker=alice"
msgid "\"Sizuki.\""
msgstr "「静希君」"

#. Occurrence C_12:502:17292: scene=C_12
#: C_12:502
msgctxt "text_id=17292 | speaker=unknown"
msgid "  The voice-quiet but clear-belonged to the girl named Alice Kuonji, who was at his side."
msgstr "　真横から誰かの声……低いのによく通る声は、たしか、久遠寺有珠という少女の物だ。"

#. Occurrence C_12:523:17293: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0002; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:523
msgctxt "text_id=17293 | speaker=soujuurou"
msgid "\"Oh yeah...\""
msgstr "「そういえば、そうだった」"

#. Occurrence C_12:582:17294: scene=C_12
#: C_12:582
msgctxt "text_id=17294 | speaker=unknown"
msgid "  He sat up, mumbling incoherently."
msgstr "　脈絡のない呟きと共に、草十郎は体を起こす。"

#. Occurrence C_12:656:17295: scene=C_12
#: C_12:656
msgctxt "text_id=17295 | speaker=unknown"
msgid "  The black-clad girl knelt next to him."
msgstr "　目を覚ました彼の横には、黒衣の少女が正座していた。"

#. Occurrence C_12:681:17296: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0003; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:681
msgctxt "text_id=17296 | speaker=soujuurou"
msgid "\"...Flowers,\""
msgstr "「……花だ」"

#. Occurrence C_12:720:17297: scene=C_12
#: C_12:720
msgctxt "text_id=17297 | speaker=unknown"
msgid "  he said, paying no mind to Alice."
msgstr "　<傍|かたわ>らの有珠を見ず、ぼんやりと口にする。"

#. Occurrence C_12:725:17298: scene=C_12
#: C_12:725
msgctxt "text_id=17298 | speaker=unknown"
msgid "  Under the blue moonlight, spring flowers swayed, surrounded by dead trees and snow."
msgstr "　……<蒼|あお>い月明かりの下、枯れた木々と雪原に囲まれて、春の花園が<揺|ゆ>らめいていた。"

#. Occurrence C_12:780:17299: scene=C_12
#: C_12:780
msgctxt "text_id=17299 | speaker=unknown"
msgid "  Against the curtain of night, white petals danced in the breeze like butterflies."
msgstr "　夜風に散る花びらは蝶のように、白い身を闇夜にくっきりと浮かびあがらせる。"

#. Occurrence C_12:785:17300: scene=C_12
#: C_12:785
msgctxt "text_id=17300 | speaker=unknown"
msgid "  Staring long and hard at the spectacle, Soujyuro suddenly raised his fingers to his neck."
msgstr "　長く、その光景を見つめて、草十郎はそっと首に指を置いた。"

#. Occurrence C_12:796:17301: scene=C_12
#: C_12:796
msgctxt "text_id=17301 | speaker=unknown"
msgid "  He moved carefully, like he was touching a wound."
msgstr "　はじめは、傷口に触れるように恐る恐る。"

#. Occurrence C_12:802:17302: scene=C_12
#: C_12:802
msgctxt "text_id=17302 | speaker=unknown"
msgid "  Then, gradually, he began squeezing. Harder. Harder."
msgstr "　あとは、握りこむように、強く強く。"

#. Occurrence C_12:823:17303: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0001; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:823
msgctxt "text_id=17303 | speaker=alice"
msgid "\"...Sizuki.\""
msgstr "「―――静希君」"

#. Occurrence C_12:829:17304: scene=C_12
#: C_12:829
msgctxt "text_id=17304 | speaker=unknown"
msgid "  The voice of the girl beside him brought him back to reality."
msgstr "　その暗転を止めたのは、傍らの少女の声だった。"

#. Occurrence C_12:850:17305: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0002; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:850
msgctxt "text_id=17305 | speaker=alice"
msgid "\"Leaving so soon? You just came back.\""
msgstr "「せっかく戻れたのに、またいくの……？」"

#. Occurrence C_12:936:17306: scene=C_12
#: C_12:936
msgctxt "text_id=17306 | speaker=unknown"
msgid "  She sounded both sad and reproachful,"
msgstr "　問いかけの意味を、草十郎は掴めなかった。"

#. Occurrence C_12:941:17307: scene=C_12
#: C_12:941
msgctxt "text_id=17307 | speaker=unknown"
msgid "  but Soujyuro did not understand why."
msgstr "　批難と哀しみの混じった声。"

#. Occurrence C_12:946:17308: scene=C_12
#: C_12:946
msgctxt "text_id=17308 | speaker=unknown"
msgid "  Seeing the uncharacteristic concern in her eyes snapped him to his senses."
msgstr "　その、有珠らしからぬ眼差しに責められて、彼は無意識から解放された。"

#. Occurrence C_12:1004:17309: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0004; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:1004
msgctxt "text_id=17309 | speaker=soujuurou"
msgid "\"Leaving? Where would I go?\""
msgstr "「いくって、どこに」"

#. Occurrence C_12:1010:17310: scene=C_12
#: C_12:1010
msgctxt "text_id=17310 | speaker=unknown"
msgid "  His fingers fell away from his neck."
msgstr "　首から落ちる指。"

#. Occurrence C_12:1015:17311: scene=C_12
#: C_12:1015
msgctxt "text_id=17311 | speaker=unknown"
msgid "  Without answering, she blankly looked to the sky."
msgstr "　有珠は答えず、無表情に空を見上げた。"

#. Occurrence C_12:1021:17312: scene=C_12
#: C_12:1021
msgctxt "text_id=17312 | speaker=unknown"
msgid "  Though there was only the infinite darkness of space."
msgstr "　そこにあるのは、ただ暗いばかりの――――――。"

#. Occurrence C_12:1042:17313: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0005; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:1042
msgctxt "text_id=17313 | speaker=soujuurou"
msgid "\"...Well, whatever. What was I doing again?"
msgstr "「……ま、いいや。それより俺は何をしてたんだろう。"

#. Occurrence C_12:1048:17314: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0006; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:1048
msgctxt "text_id=17314 | speaker=soujuurou"
msgid "  My head feels strange, like it's full of cobwebs.\""
msgstr "　なんかヘンだ。ごちゃごちゃしてる」"

#. Occurrence C_12:1102:17315: scene=C_12
#: C_12:1102
msgctxt "text_id=17315 | speaker=unknown"
msgid "  Soujyuro tilted his head in confusion. Alice observed him motionlessly."
msgstr "　はて、と首を傾げる草十郎を、有珠はじいっと観察する。"

#. Occurrence C_12:1107:17316: scene=C_12
#: C_12:1107
msgctxt "text_id=17316 | speaker=unknown"
msgid "  This bewildered boy was a far cry from the one that made short work of a werewolf. Then again, this was Soujyuro."
msgstr "　さっきの人狼を一蹴した少年と、こうやって呆けている少年はまるっきり別人で、そのくせ、まるで違和感がない。"

#. Occurrence C_12:1127:17317: scene=C_12
#: C_12:1127
msgctxt "text_id=17317 | speaker=unknown"
msgid "  As she stared at him, she realized she did not have an answer he could understand."
msgstr "　その不思議を見抜こうと少年を見つめるのだが、納得いく答えは出ないだろう事も、なんとなく有珠は認めていた。"

#. Occurrence C_12:1150:17318: scene=C_12
#: C_12:1150
msgctxt "text_id=17318 | speaker=unknown"
msgid "  So she tried asking a question."
msgstr "　そうして問いかける。"

#. Occurrence C_12:1155:17319: scene=C_12
#: C_12:1155
msgctxt "text_id=17319 | speaker=unknown"
msgid "  The same question she had asked him repeatedly as he slept but eventually gave up expecting a response to."
msgstr "　彼が眠っていた間、遠く離れた彼女が何度も繰り返して、しまいには怒って止めてしまった、その問いを。"

#. Occurrence C_12:1283:17320: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0003; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:1283
msgctxt "text_id=17320 | speaker=alice"
msgid "\"...Tell me. Do you remember what you were doing, Sizuki?\""
msgstr "「……今まで、静希君は何をしていたの？」"

#. Occurrence C_12:1289:17321: scene=C_12
#: C_12:1289
msgctxt "text_id=17321 | speaker=unknown"
msgid "  Her quiet question was spoken like an enthralling spell of magecraft."
msgstr "　静かな問いかけは、旅人を魅了する魔術に等しい。"

#. Occurrence C_12:1294:17322: scene=C_12
#: C_12:1294
msgctxt "text_id=17322 | speaker=unknown"
msgid "  Said spell seemed to work, and Soujyuro sank into a sea of memories."
msgstr "　それに魅了されてか、草十郎は記憶の海に沈みこむ。"

#. Occurrence C_12:1335:17323: scene=C_12
#: C_12:1335
msgctxt "text_id=17323 | speaker=unknown"
msgid "  Atop the bright, white hill, they quietly sat for a while, like siblings."
msgstr "　沈黙の間、ふたりは兄妹のように、白い丘に<佇|たたず>んでいた。"

#. Occurrence C_12:1356:17324: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0007; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:1356
msgctxt "text_id=17324 | speaker=soujuurou"
msgid "\"...I remember hearing someone's voice."
msgstr "「……誰かの声が聞こえた気がする。"

#. Occurrence C_12:1363:17325: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0008; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:1363
msgctxt "text_id=17325 | speaker=soujuurou"
msgid "I think they were asking me something. But I couldn't respond at all.\""
msgstr "何かを訊いているようだった。けど、自分は最後まで、一言も返せなかった」"

#. Occurrence C_12:1369:17326: scene=C_12
#: C_12:1369
msgctxt "text_id=17326 | speaker=unknown"
msgid "  Though consumed by the darkness of death, he could still vaguely recall the girl's question."
msgstr "　死中の闇において繰り返された問いを、彼はおぼろげに思い出した。"

#. Occurrence C_12:1374:17327: scene=C_12
#: C_12:1374
msgctxt "text_id=17327 | speaker=unknown"
msgid "  He was not aware that he had died, but it seemed a fragment of time remained from when he had been with her."
msgstr "　死んでいた事すら分かっていないが、彼女の時間と交差した断片は残っているようだ。"

#. Occurrence C_12:1431:17328: scene=C_12
#: C_12:1431
msgctxt "text_id=17328 | speaker=unknown"
msgid "  Soujyuro's expression darkened, filled with regret."
msgstr "　草十郎は悔いるように顔を<曇|くも>らせる。"

#. Occurrence C_12:1436:17329: scene=C_12
#: C_12:1436
msgctxt "text_id=17329 | speaker=unknown"
msgid "  Looking at his profile, Alice pressed him further."
msgstr "　その横顔に有珠は静かに問いかける。"

#. Occurrence C_12:1445:17330: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0004; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:1445
msgctxt "text_id=17330 | speaker=alice"
msgid "\"And did you find what you were looking for?\""
msgstr "「……それで、欲しい物は見つかった？」"

#. Occurrence C_12:1544:17331: scene=C_12
#: C_12:1544
msgctxt "text_id=17331 | speaker=unknown"
msgid "  Remembering that someone had asked him questions, he gave a slight nod."
msgstr "　それが『誰か』に訊ねられていた事だと思い出して、彼はかすかにうなずいた。"

#. Occurrence C_12:1678:17332: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0009; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:1678
msgctxt "text_id=17332 | speaker=soujuurou"
msgid "\"...Yeah. I did."
msgstr "「……ああ、そうだった。"

#. Occurrence C_12:1685:17333: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0010; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:1685
msgctxt "text_id=17333 | speaker=soujuurou"
msgid "But, I honestly didn't think I would, Alice."
msgstr "けれどね、有珠。そんな物は、見つからないって思っていたんだ。"

#. Occurrence C_12:1691:17334: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0011; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:1691
msgctxt "text_id=17334 | speaker=soujuurou"
msgid "  This whole time. I didn't think I would.\""
msgstr "　……うん。ずっと、そう思っていた」"

#. Occurrence C_12:1704:17335: scene=C_12
#: C_12:1704
msgctxt "text_id=17335 | speaker=unknown"
msgid "  The regret in his voice was accompanied by a hint of strength."
msgstr "　悔いる声には、かすかな強さが混じっている。"

#. Occurrence C_12:1709:17336: scene=C_12
#: C_12:1709
msgctxt "text_id=17336 | speaker=unknown"
msgid "  Lowering his gaze, Soujyuro saw a white flower garden that looked like something from the afterlife."
msgstr "　見下ろす白い花園は、死者を迎える<彼岸|ひがん>のようだ。"

#. Occurrence C_12:1714:17337: scene=C_12
#: C_12:1714
msgctxt "text_id=17337 | speaker=unknown"
msgid "  It shone brightly, captivating him."
msgstr "　それが、少しだけ草十郎には<眩|まぶ>しかった。"

#. Occurrence C_12:1765:17338: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0012; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:1765
msgctxt "text_id=17338 | speaker=soujuurou"
msgid "\"I remember now. I think I... got cut in half... in front of Aoko."
msgstr "「思い出した。青子の前でざっくりいったんだっけ。"

#. Occurrence C_12:1771:17339: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0013; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:1771
msgctxt "text_id=17339 | speaker=soujuurou"
msgid "  But then why am I alive?\""
msgstr "　なのに生きているのは、どういう事なんだろう」"

#. Occurrence C_12:1798:17340: scene=C_12
#: C_12:1798
msgctxt "text_id=17340 | speaker=unknown"
msgid "  Soujyuro said, prodding his body curiously."
msgstr "　不思議そうに体を触る草十郎。"

#. Occurrence C_12:1803:17341: scene=C_12
#: C_12:1803
msgctxt "text_id=17341 | speaker=unknown"
msgid "  His arms were their old selves again, but what of Aoko?"
msgstr "　両腕も完全に元のままで、肝心の青子の姿はない。"

#. Occurrence C_12:1882:17342: scene=C_12
#: C_12:1882
msgctxt "text_id=17342 | speaker=unknown"
msgid "  He turning toward Alice for an answer, who was sat among the flowers looking sullen."
msgstr "　答えを求めて有珠に視線を向けると、彼女は座ったままで、どこか拗ねるように、"

#. Occurrence C_12:1954:17343: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0005; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:1954
msgctxt "text_id=17343 | speaker=alice"
msgid "\"You were rewound, Sizuki."
msgstr "「巻き戻されたのよ、静希君は。"

#. Occurrence C_12:1960:17344: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0006; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:1960
msgctxt "text_id=17344 | speaker=alice"
msgid "  This place is from your memories. Don't you remember?\""
msgstr "　この風景も本来は貴方の記憶だけど、わからない……？」"

#. Occurrence C_12:1966:17345: scene=C_12
#: C_12:1966
msgctxt "text_id=17345 | speaker=unknown"
msgid "  Alice seemed to be speaking in riddles."
msgstr "　などと、おかしな言葉を口にした。"

#. Occurrence C_12:2007:17346: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0014; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:2007
msgctxt "text_id=17346 | speaker=soujuurou"
msgid "\"My memories? That's weird. I... I'm drawing a blank.\""
msgstr "「俺の、記憶って……そのわりには、知らないところなんだけど」"

#. Occurrence C_12:2013:17347: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0007; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2013
msgctxt "text_id=17347 | speaker=alice"
msgid "\"Right now, your time is being used by Aoko. Until that time is returned, you won't be able to remember.\""
msgstr "「いま静希君の時間は青子に使われているから。それが戻されるまで思い出す事はないわ」"

#. Occurrence C_12:2019:17348: scene=C_12
#: C_12:2019
msgctxt "text_id=17348 | speaker=unknown"
msgid "  She answered ominously, as she cast her gaze over the flower garden."
msgstr "　物騒な返答をして、有珠は花園を見渡した。"

#. Occurrence C_12:2082:17349: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0008; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2082
msgctxt "text_id=17349 | speaker=alice"
msgid "\"A shame all this won't stay."
msgstr "「……でも、これが消えてしまうのは残念ね。"

#. Occurrence C_12:2088:17350: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0009; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2088
msgctxt "text_id=17350 | speaker=alice"
msgid "  Once your time's returned, I'll be the only one who remembers.\""
msgstr "　元に戻れば、思い返せるのはわたしだけなのに」"

#. Occurrence C_12:2094:17351: scene=C_12
#: C_12:2094
msgctxt "text_id=17351 | speaker=unknown"
msgid "  Looking at the white blossoms, she smiled momentarily."
msgstr "　一瞬だけ瞳を細めて、有珠は白い花々を見る。"

#. Occurrence C_12:2155:17352: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0015; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:2155
msgctxt "text_id=17352 | speaker=soujuurou"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence C_12:2160:17353: scene=C_12
#: C_12:2160
msgctxt "text_id=17353 | speaker=unknown"
msgid "  Her words only confused him further."
msgstr "　彼女の言葉は、草十郎にはやっぱりさっぱり。"

#. Occurrence C_12:2231:17354: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0016; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:2231
msgctxt "text_id=17354 | speaker=soujuurou"
msgid "\"You're not going to tell me, are you, Alice?\""
msgstr "「有珠。君、答える気がないんだろう」"

#. Occurrence C_12:2236:17355: scene=C_12
#: C_12:2236
msgctxt "text_id=17355 | speaker=unknown"
msgid "  He said dejectedly, prompting Alice to face him."
msgstr "　草十郎の声に、有珠はつい、と振り向いた。"

#. Occurrence C_12:2294:17356: scene=C_12
#: C_12:2294
msgctxt "text_id=17356 | speaker=unknown"
msgid "  What emotions lay inside those deep eyes?"
msgstr "　深い瞳は、どんな感情を秘めているかも分からない。"

#. Occurrence C_12:2370:17357: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0010; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2370
msgctxt "text_id=17357 | speaker=alice"
msgid "\"It's pointless having me tell you, but do you want to hear anyway?\""
msgstr "「意味のない話だけど、聞きたい？」"

#. Occurrence C_12:2376:17358: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0017; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:2376
msgctxt "text_id=17358 | speaker=soujuurou"
msgid "\"Yeah. If it's not too bothersome, Alice.\""
msgstr "「聞きたい。有珠が教えてくれるなら尚更だ」"

#. Occurrence C_12:2437:17359: scene=C_12
#: C_12:2437
msgctxt "text_id=17359 | speaker=unknown"
msgid "  Soujyuro nodded enthusiastically, while Alice took a deep breath and closed her eyes."
msgstr "　力強くうなずく草十郎に、有珠はそう、とため息まじりに目を閉じた。"

#. Occurrence C_12:2442:17360: scene=C_12
#: C_12:2442
msgctxt "text_id=17360 | speaker=unknown"
msgid "  When she spoke, she spoke in as caring a tone as she was capable of."
msgstr "　それでも口を開いたのは、草十郎を嫌っての事ではなく、彼女なりに気を遣っているからだろう。"

#. Occurrence C_12:2590:17361: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0011; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2590
msgctxt "text_id=17361 | speaker=alice"
msgid "\"...The long and short of it is, you died. Then you came back to life."
msgstr "「……結論だけ言うと、貴方は一度死んで、生き返ったの。"

#. Occurrence C_12:2596:17362: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0012; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2596
msgctxt "text_id=17362 | speaker=alice"
msgid "  After you were killed by Touko, Aoko rewound the five minutes before you opened your eyes."
msgstr "　静希君が橙子さんに殺されてから、青子が目を覚ますまでの五分間分の時間を巻き戻して。"

#. Occurrence C_12:2602:17363: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0013; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2602
msgctxt "text_id=17363 | speaker=alice"
msgid "  Meanwhile, she used roughly ten years of your time."
msgstr "　その時、貴方は十年近い年月を青子に使われた。"

#. Occurrence C_12:2608:17364: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0014; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2608
msgctxt "text_id=17364 | speaker=alice"
msgid "  Neither of you changed physically, so she must've borrowed time from you mentally."
msgstr "　二人とも肉体年齢は変わってないから、<精神|なか>の時間だけ持っていったんでしょうね。"

#. Occurrence C_12:2614:17365: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0015; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2614
msgctxt "text_id=17365 | speaker=alice"
msgid "  That's why right now, this beautiful scenery would only bring back memories for Aoko, in possession of your time."
msgstr "　だから今、この景色を懐かしく思えるのは青子だけ。"

#. Occurrence C_12:2621:17366: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0016; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2621
msgctxt "text_id=17366 | speaker=alice"
msgid "  And...\""
msgstr "　そして…………」"

#. Occurrence C_12:2641:17367: scene=C_12
#: C_12:2641
msgctxt "text_id=17367 | speaker=unknown"
msgid "  And once the time exchange was over, neither Aoko nor Soujyuro would remember what happened during these moments."
msgstr "　そして、時間の交換が終われば、この数分たらずの出来事は、青子と草十郎の記憶から失われる。"

#. Occurrence C_12:2647:17368: scene=C_12
#: C_12:2647
msgctxt "text_id=17368 | speaker=unknown"
msgid "  When Aoko used someone else to channel her True Magic, it did not affect her alone."
msgstr "　青子ひとりだけの変化ではなく、他人を媒介にした魔法の結果だ。"

#. Occurrence C_12:2652:17369: scene=C_12
#: C_12:2652
msgctxt "text_id=17369 | speaker=unknown"
msgid "  If she had rewound time for only herself, the temporal inconsistencies would form part of her own experience; however, this was proper time travel."
msgstr "　青子ひとりでの逆行であれば、時間軸の矛盾もふくめて彼女の経験になるが、今回は<ま|・><っ|・><と|・><う|・>な時間旅行である。"

#. Occurrence C_12:2657:17370: scene=C_12
#: C_12:2657
msgctxt "text_id=17370 | speaker=unknown"
msgid "  The inconsistencies would be corrected."
msgstr "　矛盾はきちんと修正される。"

#. Occurrence C_12:2683:17371: scene=C_12
#: C_12:2683
msgctxt "text_id=17371 | speaker=unknown"
msgid "  When the Magic ended,"
msgstr "　いずれ魔法が解ければ、"

#. Occurrence C_12:2688:17372: scene=C_12
#: C_12:2688
msgctxt "text_id=17372 | speaker=unknown"
msgid "  both Aoko's memories of this place"
msgstr "　此処を懐かしく思った青子も、"

#. Occurrence C_12:2693:17373: scene=C_12
#: C_12:2693
msgctxt "text_id=17373 | speaker=unknown"
msgid "  and Soujyuro's unfamiliarity with it"
msgstr "　此処を初めてと感じた草十郎も、"

#. Occurrence C_12:2698:17374: scene=C_12
#: C_12:2698
msgctxt "text_id=17374 | speaker=unknown"
msgid "  would be corrected."
msgstr "　なかった事として修正される。"

#. Occurrence C_12:2704:17375: scene=C_12
#: C_12:2704
msgctxt "text_id=17375 | speaker=unknown"
msgid "  This miracle would become unrealized."
msgstr "　この奇跡。"

#. Occurrence C_12:2709:17376: scene=C_12
#: C_12:2709
msgctxt "text_id=17376 | speaker=unknown"
msgid "  Only the observers would remember this brilliant white sea of flowers: Alice and Touko."
msgstr "　白い花の海を覚えていられるのは、第三者である有珠と橙子だけになる。"

#. Occurrence C_12:2730:17377: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0018; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:2730
msgctxt "text_id=17377 | speaker=soujuurou"
msgid "\"She borrowed... my time...?\""
msgstr "「……時間を、持っていく……？」"

#. Occurrence C_12:2736:17378: scene=C_12
#: C_12:2736
msgctxt "text_id=17378 | speaker=unknown"
msgid "  Soujyuro asked, his head tilting even farther at Alice's general explanation."
msgstr "　ますます首を傾げる草十郎に、有珠はとりあえず形だけ説明する事にした。"

#. Occurrence C_12:2741:17379: scene=C_12
#: C_12:2741
msgctxt "text_id=17379 | speaker=unknown"
msgid "  She recalled how Aoko said that if you gave Soujyuro a roundabout answer he would stop asking questions, even if he did not comprehend it."
msgstr "　理解してもらえなくても、概要を説明してあげれば草十郎は聞き返してこない、と青子が言っていたのを思いだして。"

#. Occurrence C_12:2762:17380: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0017; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2762
msgctxt "text_id=17380 | speaker=alice"
msgid "\"There was no way to resurrect you, so instead Aoko attempted to circumvent your death completely."
msgstr "「静希君を生き返らせる方法はなかったから、生命の復元より、死そのものの回避を青子は<試|こころ>みたのよ。"

#. Occurrence C_12:2768:17381: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0018; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2768
msgctxt "text_id=17381 | speaker=alice"
msgid "  Perhaps because she was unable, or because she was hesitant,"
msgstr "　まだ青子には無理なのか、それとも、今回も<日|ひ><和|よ>ったのか。"

#. Occurrence C_12:2774:17382: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0019; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2774
msgctxt "text_id=17382 | speaker=alice"
msgid "  she avoided any large-scale manipulation, and settled for a smaller exchange between the two of you.\""
msgstr "　大きな操作は避けて、小さな操作―――自分と貴方だけの交換に<留|とど>めたようね」"

#. Occurrence C_12:2882:17383: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0020; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2882
msgctxt "text_id=17383 | speaker=alice"
msgid "\"That means you've effectively jumped through time by five minutes."
msgstr "「貴方はいま、五分間だけ時間を跳んだ事になるわ。"

#. Occurrence C_12:2888:17384: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0021; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2888
msgctxt "text_id=17384 | speaker=alice"
msgid "  Even if someone from the distant future was able to look through time, they couldn't find you in those five minutes, because you don't exist in regular time anymore.\""
msgstr "　仮に、遠い未来、この時間を検索できる人がいたとしても、貴方だけは誰にも見つけられない。だって、時間軸の上にいなかったんですもの」"

#. Occurrence C_12:2962:17385: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0022; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2962
msgctxt "text_id=17385 | speaker=alice"
msgid "\"Simultaneously, Aoko borrowed your time to advance her own."
msgstr "「そして同時に、青子は自分の時間を上乗せするために、貴方から時間を借り受けた。"

#. Occurrence C_12:2968:17386: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0023; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:2968
msgctxt "text_id=17386 | speaker=alice"
msgid "  More than likely, time from your childhood. From what I understand, individual time manipulation is easier when using forgotten memories... Sizuki?\""
msgstr "　たぶん幼年期の時間でしょうね。個人の時間操作は、忘却している部分の方が楽だと聞くし……静希君？」"

#. Occurrence C_12:3029:17387: scene=C_12
#: C_12:3029
msgctxt "text_id=17387 | speaker=unknown"
msgid "  \"Should I slow down?\" Alice asked with her eyes."
msgstr "　もうこの辺で止めておく？"

#. Occurrence C_12:3034:17388: scene=C_12
#: C_12:3034
msgctxt "text_id=17388 | speaker=unknown"
msgid "  All Soujyuro could do was nod."
msgstr "　という有珠の視線に、頷く事しかできない草十郎だった。"

#. Occurrence C_12:3073:17389: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0024; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:3073
msgctxt "text_id=17389 | speaker=alice"
msgid "\"...So, Aoko used two miracles."
msgstr "「……つまり、二つの奇跡を青子は行使したの。"

#. Occurrence C_12:3079:17390: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0025; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:3079
msgctxt "text_id=17390 | speaker=alice"
msgid "  She rewound your body, and fast-forwarded her own."
msgstr "　貴方の体の巻き戻しと、自分の体の早送りね。"

#. Occurrence C_12:3085:17391: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0026; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:3085
msgctxt "text_id=17391 | speaker=alice"
msgid "  When going into your time, she borrowed ten years of yours to bring her future self closer.\""
msgstr "　静希君の時間に介入する際、ついでに十年分の時間を借り受けて、未来の自分を持ってきた」"

#. Occurrence C_12:3106:17392: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0027; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:3106
msgctxt "text_id=17392 | speaker=alice"
msgid "\"Therefore, the one trying to kill Touko right now is actually an Aoko Aozaki with twenty seven years of experience.\""
msgstr "「だから、いま橙子さんを殺そうとしているのは<二|・><十|・><七|・><歳|・>分の<経験|じかん>をもった蒼崎青子という事になるわ」"

#. Occurrence C_12:3112:17393: scene=C_12
#: C_12:3112
msgctxt "text_id=17393 | speaker=unknown"
msgid "  What on earth was Alice talking about?"
msgstr "　……だから、まったくちんぷんかんぷんなんだ、有珠。"

#. Occurrence C_12:3117:17394: scene=C_12
#: C_12:3117
msgctxt "text_id=17394 | speaker=unknown"
msgid "  Soujyuro's expression gave away his thoughts. Though the part about Touko made him furrow his brow."
msgstr "　そんな感想を表情で示しながらも、橙子に関する説明に草十郎は眉をひそめた。"

#. Occurrence C_12:3138:17395: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_12_0019; voice_prefix=A30; voice_category=3; scene=C_12
#: C_12:3138
msgctxt "text_id=17395 | speaker=soujuurou"
msgid "\"Aoko's going to... kill Touko?\""
msgstr "「……橙子さんを殺すって、青子が？」"

#. Occurrence C_12:3190:17396: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0028; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:3190
msgctxt "text_id=17396 | speaker=alice"
msgid "\"If she hasn't already, yes.\""
msgstr "「もう、終わってるでしょうけど」"

#. Occurrence C_12:3283:17397: scene=C_12
#: C_12:3283
msgctxt "text_id=17397 | speaker=unknown"
msgid "  As soon as Alice answered, Soujyuro sped off."
msgstr "　有珠の返答に、草十郎は即座に走りだした。"

#. Occurrence C_12:3288:17398: scene=C_12
#: C_12:3288
msgctxt "text_id=17398 | speaker=unknown"
msgid "  Kicking up white petals behind him as he ran, the brave boy who defeated a werewolf was back."
msgstr "　白い花びらを散らしながら駆けていく姿は、人狼と対した時の勇ましさを思わせる。"

#. Occurrence C_12:3360:17399: scene=C_12
#: C_12:3360
msgctxt "text_id=17399 | speaker=unknown"
msgid "  Alice watched him go."
msgstr "　有珠は引き止める事もせず、ただその姿を見続けた。"

#. Occurrence C_12:3448:17400: scene=C_12
#: C_12:3448
msgctxt "text_id=17400 | speaker=unknown"
msgid "  On a snowy night..."
msgstr "　……ある雪の日の夜。"

#. Occurrence C_12:3453:17401: scene=C_12
#: C_12:3453
msgctxt "text_id=17401 | speaker=unknown"
msgid "  ...the same boy ran down Shiroinuzuka hill for her, too."
msgstr "　誰かのために白犬塚の坂を駆け下りていったであろう、少年の姿と重ねながら。"

#. Occurrence C_12:3496:17402: scene=C_12
#: C_12:3496
msgctxt "text_id=17402 | speaker=unknown"
msgid "  Soujyuro entered the old school building."
msgstr "　草十郎は旧校舎に入っていく。"

#. Occurrence C_12:3501:17403: scene=C_12
#: C_12:3501
msgctxt "text_id=17403 | speaker=unknown"
msgid "  Lights flashed and the sounds of destruction exploded around him, threatening to turn the area into a burial ground. Still, he remained focused."
msgstr "　先ほどから破滅的な音と光が<乱舞|らんぶ>し、<瓦解|がかい>寸前の<墓標|ぼひょう>となった場所に、戸惑う事もなく。"

#. Occurrence C_12:3524:17404: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0029; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:3524
msgctxt "text_id=17404 | speaker=alice"
msgid "\"See, Aoko?"
msgstr "「―――ほら。"

#. Occurrence C_12:3563:17405: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_12_0030; voice_prefix=A40; voice_category=2; scene=C_12
#: C_12:3563
msgctxt "text_id=17405 | speaker=alice"
msgid "  Sorry, but I knew this would happen.\""
msgstr "　悪いけれど、やっぱり無駄だったわ、青子」"

#. Occurrence C_12:3569:17406: scene=C_12
#: C_12:3569
msgctxt "text_id=17406 | speaker=unknown"
msgid "  Her words only reached the white flowers around her."
msgstr "　白い花の中でひとり呟く。"

#. Occurrence C_12:3574:17407: scene=C_12
#: C_12:3574
msgctxt "text_id=17407 | speaker=unknown"
msgid "  Aoko knew Soujyuro too well, so she wanted Alice to stop him."
msgstr "　青子はこうなる事を予期して、草十郎の足止めを有珠に託したのだ。"

#. Occurrence C_12:3579:17408: scene=C_12
#: C_12:3579
msgctxt "text_id=17408 | speaker=unknown"
msgid "  If he tried to interfere in the battle against Touko, she could not protect him this time."
msgstr "　橙子との交戦中に割って入られたら、今度こそかばいようがないと。"

#. Occurrence C_12:3629:17409: scene=C_12
#: C_12:3629
msgctxt "text_id=17409 | speaker=unknown"
msgid "  But it was too late to celebrate Aoko's judgment now."
msgstr "　が、青子の見事なまでの草十郎の把握ぶりもこうなっては後の祭りだ。"

#. Occurrence C_12:3634:17410: scene=C_12
#: C_12:3634
msgctxt "text_id=17410 | speaker=unknown"
msgid "  The girl in black had no intention of going after him."
msgstr "　追いかける気にもならず、"

#. Occurrence C_12:3639:17411: scene=C_12
#: C_12:3639
msgctxt "text_id=17411 | speaker=unknown"
msgid "  She simply sat for a while, gazing forlornly at the transient flower garden."
msgstr "　黒衣の少女は細い眉をかすかに曇らせて、消えていく花園の中で<佇|たたず>むのだった。"

#. Occurrence C_13:461:17412: scene=C_13
#: C_13:461
msgctxt "text_id=17412 | speaker=unknown"
msgid "  A storm of magic bullets struck down a hail of lightning blades."
msgstr "　飛び交う<電刃|でんじん>を、暴風の如き<魔弾|まだん>が叩き伏せる。"

#. Occurrence C_13:546:17413: scene=C_13
#: C_13:546
msgctxt "text_id=17413 | speaker=unknown"
msgid "  A mage's workshop was their home base, and last line of defense."
msgstr "　魔術師にとって、拠点とする<工房|アジト>は始まりにして最後の切札である。"

#. Occurrence C_13:551:17414: scene=C_13
#: C_13:551
msgctxt "text_id=17414 | speaker=unknown"
msgid "  It featured an abundance of defensive spells designed to cut down brazen challengers and thieves."
msgstr "　<不遜|ふそん>な挑戦者、<不埒|ふらち>な盗人を切りきざむ為、<幾重|いくえ><数多|あまた>の防衛術式が張られている。"

#. Occurrence C_13:556:17415: scene=C_13
#: C_13:556
msgctxt "text_id=17415 | speaker=unknown"
msgid "  The old school building was no exception, painstakingly rigged by the puppet master and rune mage, Touko Aozaki."
msgstr "　この旧校舎もその例に漏れず、希代の人形師にしてルーン使いである蒼崎橙子の手が入っていた。"

#. Occurrence C_13:561:17416: scene=C_13
#: C_13:561
msgctxt "text_id=17416 | speaker=unknown"
msgid "  A reflection of her bizarre obsessions, the workshop was set to indiscriminately destroy any intruders."
msgstr "　彼女の<偏執|へんしつ>的なこだわりを反映させた<工房|ソレ>は、訪れるものを人魔区別なく<鏖殺|おうさつ>する。"

#. Occurrence C_13:667:17417: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0000; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:667
msgctxt "text_id=17417 | speaker=touko"
msgid "\"Grrr! Stay still for one damn second, you freak!\""
msgstr "「っ、足止めぐらいは果たせバカモン―――！」"

#. Occurrence C_13:673:17418: scene=C_13
#: C_13:673
msgctxt "text_id=17418 | speaker=unknown"
msgid "  Touko complained, as she ran down the hallway, activating her traps along the way."
msgstr "　廊下を走りながら、橙子は廊下に組み込んだトラップを起動させていく。"

#. Occurrence C_13:678:17419: scene=C_13
#: C_13:678
msgctxt "text_id=17419 | speaker=unknown"
msgid "  But nothing seemed to work."
msgstr "　だが、その一切は通用しない。"

#. Occurrence C_13:843:17420: scene=C_13
#: C_13:843
msgctxt "text_id=17420 | speaker=unknown"
msgid "  None of the runes-regardless of their quality or quantity-could slow her sister down."
msgstr "　質、<量|りょう>問わず、十や二十のルーンでは、あの小娘を止める事さえ出来ない。"

#. Occurrence C_13:848:17421: scene=C_13
#: C_13:848
msgctxt "text_id=17421 | speaker=unknown"
msgid "  Her reaction speed and ability to predict attacks could only be described as transcendent."
msgstr "　卓越した運動神経と攻撃予測、"

#. Occurrence C_13:853:17422: scene=C_13
#: C_13:853
msgctxt "text_id=17422 | speaker=unknown"
msgid "  Even magic bullets she fired from both her arms were too much, destroying the runes and the very walls that housed them...!"
msgstr "　両手にまとった魔弾の威力は、橙子の用意したルーンを壁ごとぶち抜いて余りある―――！"

#. Occurrence C_13:1142:17423: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0001_0; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:1142
msgctxt "text_id=17423 | speaker=touko"
msgid "\"Is this all your newfound maturity has got you?!"
msgstr "「それで一人前のつもりか単細胞め―――"

#. Occurrence C_13:1149:17424: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0001_1; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:1149
msgctxt "text_id=17424 | speaker=touko"
msgid "  The ability to smash things like a child?!\""
msgstr "　熟成したところで壊すコトしか出来ないとは、呆れたな！」"

#. Occurrence C_13:1348:17425: scene=C_13
#: C_13:1348
msgctxt "text_id=17425 | speaker=unknown"
msgid "  As she spat out her words, the ceiling opened, increasing the pressure from the runes."
msgstr "　<罵倒|ばとう>と共に天井が開き、ルーンによる重圧がかけられる。"

#. Occurrence C_13:1353:17426: scene=C_13
#: C_13:1353
msgctxt "text_id=17426 | speaker=unknown"
msgid "  Invisible walls popped up in the hallway."
msgstr "　廊下は不可視の壁に、"

#. Occurrence C_13:1358:17427: scene=C_13
#: C_13:1358
msgctxt "text_id=17427 | speaker=unknown"
msgid "  Aoko stopped and swung her right leg upward."
msgstr "　ゼラチンと化した大気を前に、青子は走る足を止め、右足を跳ね上げた。"

#. Occurrence C_13:1589:17428: scene=C_13
#: C_13:1589
msgctxt "text_id=17428 | speaker=unknown"
msgid "  Straight toward the celling."
msgstr "　まさに<天墜|てんつい>。"

#. Occurrence C_13:1595:17429: scene=C_13
#: C_13:1595
msgctxt "text_id=17429 | speaker=unknown"
msgid "Her foot cut through the thick air like a knife through butter, shattering the ceiling and the runes along with it."
msgstr "真一文字に蹴り上げられた足は大気を裂き、そのままルーンごと天井を粉砕する。"

#. Occurrence C_13:1699:17430: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0000; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:1699
msgctxt "text_id=17430 | speaker=aoko"
msgid "\"You're one to talk! Always going overboard!"
msgstr "「アンタの方こそ、いつまでたってもこの凝り性……！"

#. Occurrence C_13:1705:17431: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0001; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:1705
msgctxt "text_id=17431 | speaker=aoko"
msgid "  Don't you ever get fed up of creating runes?! You're not trying to build a space fortress!"
msgstr "　どこもかしこもルーンだらけ、少しは遠慮ってもんがないの！？　宇宙要塞ばりに改造してんじゃないってぇの！"

#. Occurrence C_13:1798:17432: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0002; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:1798
msgctxt "text_id=17432 | speaker=aoko"
msgid "  This building holds precious memories for people! So show some damn respect!\""
msgstr "　みんなの思い出の校舎なんだから、もっと大切に扱いなさいよね！」"

#. Occurrence C_13:1939:17433: scene=C_13
#: C_13:1939
msgctxt "text_id=17433 | speaker=unknown"
msgid "  The wooden boards along the hallway"
msgstr "　くたびれた板張りの廊下を、"

#. Occurrence C_13:1944:17434: scene=C_13
#: C_13:1944
msgctxt "text_id=17434 | speaker=unknown"
msgid "  that had withstood decades of wind and snow were now destroyed. Aoko charged forward."
msgstr "　何十年と風雪に耐えてきた壁を、<木|こ>っ<端|ぱ>と散らしながら青子は走る。"

#. Occurrence C_13:1949:17435: scene=C_13
#: C_13:1949
msgctxt "text_id=17435 | speaker=unknown"
msgid "  The chaos was inevitable."
msgstr "　ごく当然の惨劇である。"

#. Occurrence C_13:1954:17436: scene=C_13
#: C_13:1954
msgctxt "text_id=17436 | speaker=unknown"
msgid "  While Touko's runes cursed living creatures, Aoko's magic bullets destroyed all without prejudice."
msgstr "　橙子のルーンはあくまで対人に効果を発揮する“呪い”だが、青子の魔弾は何であろうと分け<隔|へだ>てなく<猛威|もうい>を振るう。"

#. Occurrence C_13:2035:17437: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0002; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:2035
msgctxt "text_id=17437 | speaker=touko"
msgid "\"Hah! You don't have an elegant bone in your body!"
msgstr "「っ、<優雅|ゆうが>さの欠片もない！"

#. Occurrence C_13:2041:17438: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0003; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:2041
msgctxt "text_id=17438 | speaker=touko"
msgid "  To think YOU'RE my sister!\""
msgstr "　あんなのが自分の妹だと思うと―――」"

#. Occurrence C_13:2047:17439: scene=C_13
#: C_13:2047
msgctxt "text_id=17439 | speaker=unknown"
msgid "  Touko would do anything to change her blood, but there were more pressing matters at hand."
msgstr "　吐き気はしないまでも全身の血を交換したくなる橙子だが、今はそれどころではない。"

#. Occurrence C_13:2055:17440: scene=C_13
#: C_13:2055
msgctxt "text_id=17440 | speaker=unknown"
msgid "  The girl rushing her now was not the sister she remembered, but rather a more complete version of her."
msgstr "　追ってくる少女は先ほどまでの蒼崎青子ではなく、“完成した”蒼崎青子なのだ。"

#. Occurrence C_13:2060:17441: scene=C_13
#: C_13:2060
msgctxt "text_id=17441 | speaker=unknown"
msgid "  Touko couldn't afford to let her guard down for a second."
msgstr "　髪の毛一本ほどの油断も許されまい。"

#. Occurrence C_13:2081:17442: scene=C_13
#: C_13:2081
msgctxt "text_id=17442 | speaker=unknown"
msgid "  But..."
msgstr "　だが―――"

#. Occurrence C_13:2144:17443: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0004; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:2144
msgctxt "text_id=17443 | speaker=touko"
msgid "\"This is supposed to be Magic?! Don't make me laugh!\""
msgstr "「笑わせる。そんなものが魔法であるものか！」"

#. Occurrence C_13:2150:17444: scene=C_13
#: C_13:2150
msgctxt "text_id=17444 | speaker=unknown"
msgid "  Localized time travel... Touko didn't believe that was the true nature of the Aozaki's Magic."
msgstr "　個人限定の時間旅行―――それが蒼崎の魔法の正体などとは、橙子は思っていない。"

#. Occurrence C_13:2155:17445: scene=C_13
#: C_13:2155
msgctxt "text_id=17445 | speaker=unknown"
msgid "  Aoko's transformation had to be a mere byproduct of True Magic."
msgstr "　青子の変化はあくまで魔法の副産物だ。"

#. Occurrence C_13:2160:17446: scene=C_13
#: C_13:2160
msgctxt "text_id=17446 | speaker=unknown"
msgid "  She couldn't make heads or tails out of its depths even with Aoko having achieved it; at the very least, it was not so simple a miracle."
msgstr "　魔法の正体、その深淵に<青子|アレ>が届いたかまでは測れないが、決して、そんな単純な奇跡ではない。"

#. Occurrence C_13:2243:17447: scene=C_13
#: C_13:2243
msgctxt "text_id=17447 | speaker=unknown"
msgid "  After all, the concept of time travel was already made possible through the Second Magic."
msgstr "　なぜなら―――時間旅行の概念は、既に第二魔法に含まれている。"

#. Occurrence C_13:2248:17448: scene=C_13
#: C_13:2248
msgctxt "text_id=17448 | speaker=unknown"
msgid "  Record manipulation, revision of possibilities, and so forth involved the operation of parallel worlds."
msgstr "　記録の<改竄|かいざん>、<事象|じしょう>の書き換え等は、すなわち並行世界の運営にあたる。"

#. Occurrence C_13:2253:17449: scene=C_13
#: C_13:2253
msgctxt "text_id=17449 | speaker=unknown"
msgid "  So, there was no way that could be the Fifth Magic."
msgstr "　いまさらそんなものが第五魔法と呼ばれる筈もない。"

#. Occurrence C_13:2295:17450: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0005; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:2295
msgctxt "text_id=17450 | speaker=touko"
msgid "\"...Which brings me to my next question, Aoko!"
msgstr "「―――となると、次に出てくる疑問はこれか。"

#. Occurrence C_13:2330:17451: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0006; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:2330
msgctxt "text_id=17451 | speaker=touko"
msgid "  Where the hell did you get those ten years from?!\""
msgstr "　青子！　貴様、その十年分の時間をどこから持ってきた！」"

#. Occurrence C_13:2560:17452: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0003; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:2560
msgctxt "text_id=17452 | speaker=aoko"
msgid "\"From that moron outside! Gotta problem?!"
msgstr "「あのボンクラからよ、悪い!?"

#. Occurrence C_13:2567:17453: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0004; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:2567
msgctxt "text_id=17453 | speaker=aoko"
msgid "  I'm going to give his time back after, so don't you dare judge me!\""
msgstr "　後で返すんだから、アンタに批難される覚えはありませんけど！」"

#. Occurrence C_13:2607:17454: scene=C_13
#: C_13:2607
msgctxt "text_id=17454 | speaker=unknown"
msgid "  That made sense."
msgstr "　そう、それはいい。"

#. Occurrence C_13:2612:17455: scene=C_13
#: C_13:2612
msgctxt "text_id=17455 | speaker=unknown"
msgid "  There was a bias, but the amount of time on this axis had not been changed."
msgstr "　一方的ではあるが、この時間軸での時間の総量は変わっていない。"

#. Occurrence C_13:2617:17456: scene=C_13
#: C_13:2617
msgctxt "text_id=17456 | speaker=unknown"
msgid "  But..."
msgstr "　だが―――"

#. Occurrence C_13:2706:17457: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0007; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:2706
msgctxt "text_id=17457 | speaker=touko"
msgid "\"So what're you going to do with those five minutes?!"
msgstr "「では、あの五分間はどうする!?"

#. Occurrence C_13:2712:17458: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0008; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:2712
msgctxt "text_id=17458 | speaker=touko"
msgid "  Finish me then return him to his former state: is that your plan?!\""
msgstr "　まさか私を始末した後、彼を元の状態に戻すのか!?」"

#. Occurrence C_13:2775:17459: scene=C_13
#: C_13:2775
msgctxt "text_id=17459 | speaker=unknown"
msgid "  Aoko stopped in her tracks."
msgstr "　青子の足が止まる。"

#. Occurrence C_13:2841:17460: scene=C_13
#: C_13:2841
msgctxt "text_id=17460 | speaker=unknown"
msgid "  Touko had took aim at Aoko's glaring oversight:"
msgstr "　蒼崎の魔法の矛盾と、青子の人間性の矛盾。"

#. Occurrence C_13:2891:17461: scene=C_13
#: C_13:2891
msgctxt "text_id=17461 | speaker=unknown"
msgid "  Aozaki Magic and Aoko's humanity were inconsistent."
msgstr "　二つの隙が、橙子に反撃の<狼煙|のろし>をあげさせる。"

#. Occurrence C_13:2996:17462: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0009; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:2996
msgctxt "text_id=17462 | speaker=touko"
msgid "\"Yeah. You can't revive someone by manipulating time."
msgstr "「そうだ。時間操作では死者の蘇生は許されない。"

#. Occurrence C_13:3021:17463: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0010; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:3021
msgctxt "text_id=17463 | speaker=touko"
msgid "  All you've done is console yourself for a moment!\""
msgstr "　おまえがしたコトは一時だけの気休めか―――」"

#. Occurrence C_13:3027:17464: scene=C_13
#: C_13:3027
msgctxt "text_id=17464 | speaker=unknown"
msgid "  The Magic Crests on Touko's back began to demonstrate their true worth."
msgstr "　橙子の背中の魔術刻印が、その真価を発揮する。"

#. Occurrence C_13:3032:17465: scene=C_13
#: C_13:3032
msgctxt "text_id=17465 | speaker=unknown"
msgid "  Drawing upon the magical energy stored in the crests, she materialized her largest trap yet in the hallway."
msgstr "　刻印からの魔力提供を受け、廊下に仕込まれた最大の仕掛けが物質化する。"

#. Occurrence C_13:3278:17466: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0011; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:3278
msgctxt "text_id=17466 | speaker=touko"
msgid "\"Or maybe you committed an even greater sin!\""
msgstr "「―――あるいは、より<罪|つみ>深い<暴虐|ぼうぎゃく>というコトだ！」"

#. Occurrence C_13:3340:17467: scene=C_13
#: C_13:3340
msgctxt "text_id=17467 | speaker=unknown"
msgid "  Three rune stones appeared."
msgstr "　現れる三枚のルーン石。"

#. Occurrence C_13:3345:17468: scene=C_13
#: C_13:3345
msgctxt "text_id=17468 | speaker=unknown"
msgid "  Their scale and level of magical energy were wildly different from the other runes."
msgstr "　その規模も込められた魔力も、これまでのモノとはケタが違う。"

#. Occurrence C_13:3350:17469: scene=C_13
#: C_13:3350
msgctxt "text_id=17469 | speaker=unknown"
msgid "  Created by Touko herself at the Mage's Association,"
msgstr "　これこそ北欧の巨人の<御業|みわざ>、"

#. Occurrence C_13:3355:17470: scene=C_13
#: C_13:3355
msgctxt "text_id=17470 | speaker=unknown"
msgid "  they were replicas of one of the lost Primordial Runes created by a Nordic giant."
msgstr "　蒼崎橙子が魔術協会で復元・分生させた、失われた“原初のルーン”のレプリカである。"

#. Occurrence C_13:3381:17471: scene=C_13
#: C_13:3381
msgctxt "text_id=17471 | speaker=unknown"
msgid "  The three thin, crystalline lenses amplified her carved runes tens of millions of times;"
msgstr "　三枚の水晶膜は刻まれたルーンを一千万規模に膨張させる。"

#. Occurrence C_13:3386:17472: scene=C_13
#: C_13:3386
msgctxt "text_id=17472 | speaker=unknown"
msgid "  they rendered projectiles like magic bullets ineffective."
msgstr "　魔弾による相殺など許さない。"

#. Occurrence C_13:3391:17473: scene=C_13
#: C_13:3391
msgctxt "text_id=17473 | speaker=unknown"
msgid "  Even if Aoko's magical output far exceeded Touko's, these giant slabs were several times more powerful still."
msgstr "　青子の出力が橙子を遥かに上回るものだとしても、この巨石はさらに数倍。"

#. Occurrence C_13:3396:17474: scene=C_13
#: C_13:3396
msgctxt "text_id=17474 | speaker=unknown"
msgid "  Aoko's signature magecraft could only release magical energy, so she had no way to defend or evade the attack!"
msgstr "『魔力を放出する』だけの青子の魔術特性では、この呪いを防ぐ事も躱す事も出来はしない……！"

#. Occurrence C_13:3638:17475: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0005; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:3638
msgctxt "text_id=17475 | speaker=aoko"
msgid "\"...<Affix subjective axis.|Main, set.>\""
msgstr "「―――<主|メ><観|イ><軸|ン>、<固定|セット>」"

#. Occurrence C_13:3644:17476: scene=C_13
#: C_13:3644
msgctxt "text_id=17476 | speaker=unknown"
msgid "  Pushing herself on, Aoko took a deep breath of resolve."
msgstr "　短い自己暗示と、意を決する深呼吸。"

#. Occurrence C_13:3649:17477: scene=C_13
#: C_13:3649
msgctxt "text_id=17477 | speaker=unknown"
msgid "  Instead of defending or dodging, she went low and charged into the rune storm."
msgstr "　青子は防ぎもせず避けもせず、ルーンの嵐へと突進する。"

#. Occurrence C_13:3922:17478: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0012; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:3922
msgctxt "text_id=17478 | speaker=touko"
msgid "\"Y-You don't even exist within this time axis, do you?!\""
msgstr "「貴様―――この時間軸に存在していないな!?」"

#. Occurrence C_13:3928:17479: scene=C_13
#: C_13:3928
msgctxt "text_id=17479 | speaker=unknown"
msgid "  Infuriated by the realization, Touko set her Magic Crests to full-power."
msgstr "　やはり、と得心しながら、橙子は魔術刻印をフル稼働させる。"

#. Occurrence C_13:3935:17480: scene=C_13
#: C_13:3935
msgctxt "text_id=17480 | speaker=unknown"
msgid "  Through repeated, second-long bursts of time travel, Aoko was able to avoid the runes completely."
msgstr "　青子にルーンが作用しないのは、アレが今も秒単位で時間旅行を繰り返しているからだ。"

#. Occurrence C_13:3940:17481: scene=C_13
#: C_13:3940
msgctxt "text_id=17481 | speaker=unknown"
msgid "  She was either sending the attack's impact to a different time,"
msgstr "　着弾したルーンをいずこかの時間に跳ばしているのか、"

#. Occurrence C_13:3945:17482: scene=C_13
#: C_13:3945
msgctxt "text_id=17482 | speaker=unknown"
msgid "  or layering several thousands of herself atop one another."
msgstr "　それとも、何千という“<自分|たて>”を重ね着しているのか。"

#. Occurrence C_13:3950:17483: scene=C_13
#: C_13:3950
msgctxt "text_id=17483 | speaker=unknown"
msgid "  Whatever. No way she could keep up that kind of magical energy output...!"
msgstr "　どちらにせよそんなデタラメ、魔力が続くはずがない……！"

#. Occurrence C_13:4060:17484: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0006; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:4060
msgctxt "text_id=17484 | speaker=aoko"
msgid "\"One down!\""
msgstr "「一枚目！」"

#. Occurrence C_13:4066:17485: scene=C_13
#: C_13:4066
msgctxt "text_id=17485 | speaker=unknown"
msgid "  Aoko kicked the crystal slab to pieces."
msgstr "　巨石が文字通り一蹴される。"

#. Occurrence C_13:4071:17486: scene=C_13
#: C_13:4071
msgctxt "text_id=17486 | speaker=unknown"
msgid "  Two remained. Distance, thirty feet."
msgstr "　残りは二枚。距離にして十メートル。"

#. Occurrence C_13:4127:17487: scene=C_13
#: C_13:4127
msgctxt "text_id=17487 | speaker=unknown"
msgid "  Touko had ten seconds of magical energy left, but that was all she needed."
msgstr "　橙子の魔力残量は十分だ。刻印を使い果たすが、十秒は掃射を続けられる。"

#. Occurrence C_13:4203:17488: scene=C_13
#: C_13:4203
msgctxt "text_id=17488 | speaker=unknown"
msgid "  Aoko, on the other hand, would stop now if she had any common sense as a mage."
msgstr "　対する青子は、魔術師としての常識で考えるのならここで打ち止め。"

#. Occurrence C_13:4208:17489: scene=C_13
#: C_13:4208
msgctxt "text_id=17489 | speaker=unknown"
msgid "  She couldn't continue breaking the rules for much longer."
msgstr "　これ以上の反則は行えまい。"

#. Occurrence C_13:4214:17490: scene=C_13
#: C_13:4214
msgctxt "text_id=17490 | speaker=unknown"
msgid "  Then again, time travel itself was breaking the rules."
msgstr "　だが―――反則と言うのなら、それは時間旅行の段階で反則である。"

#. Occurrence C_13:4298:17491: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0013; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:4298
msgctxt "text_id=17491 | speaker=touko"
msgid "\"Aoko...!\""
msgstr "「青子―――！」"

#. Occurrence C_13:4634:17492: scene=C_13
#: C_13:4634
msgctxt "text_id=17492 | speaker=unknown"
msgid "  Once again, Aoko used the same technique."
msgstr "　同じ展開が繰り返される。"

#. Occurrence C_13:4639:17493: scene=C_13
#: C_13:4639
msgctxt "text_id=17493 | speaker=unknown"
msgid "  Touko's suspicion turned into white-hot hatred."
msgstr "　橙子の疑念は、ここに至って憎悪に変貌した。"

#. Occurrence C_13:4644:17494: scene=C_13
#: C_13:4644
msgctxt "text_id=17494 | speaker=unknown"
msgid "  She couldn't care less about her time travel formula;"
msgstr "　時間旅行の術式などどうでもいい。"

#. Occurrence C_13:4649:17495: scene=C_13
#: C_13:4649
msgctxt "text_id=17495 | speaker=unknown"
msgid "  it was the amount of magical energy she had."
msgstr "　問題はあの魔力量。"

#. Occurrence C_13:4655:17496: scene=C_13
#: C_13:4655
msgctxt "text_id=17496 | speaker=unknown"
msgid "Where was she pulling the energy necessary to jump through time for so long...?"
msgstr "時間旅行に必要なだけのエネルギーを、あの女はどこから捻出しているのか……？"

#. Occurrence C_13:4730:17497: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0014; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:4730
msgctxt "text_id=17497 | speaker=touko"
msgid "\"Wait! I knew it...!\""
msgstr "「やはりそうか。おまえは―――！」"

#. Occurrence C_13:4815:17498: scene=C_13
#: C_13:4815
msgctxt "text_id=17498 | speaker=unknown"
msgid "  It was the death of Soujyuro Sizuki."
msgstr "　静希草十郎の死。"

#. Occurrence C_13:4820:17499: scene=C_13
#: C_13:4820
msgctxt "text_id=17499 | speaker=unknown"
msgid "  If she had brought him back five minutes to when he was still alive, where would those five minutes go?"
msgstr "　彼を、まだ生きていた頃の五分前に戻したというが、では、その五分間はどこに行くのか。"

#. Occurrence C_13:4917:17500: scene=C_13
#: C_13:4917
msgctxt "text_id=17500 | speaker=unknown"
msgid "  Aoko's Magic wasn't using parallel worlds to change this one."
msgstr "　青子の魔法は、世界そのものを書き換える“並行世界の運営”ではない。"

#. Occurrence C_13:4922:17501: scene=C_13
#: C_13:4922
msgctxt "text_id=17501 | speaker=unknown"
msgid "  She had only rewound Soujyuro's five minutes."
msgstr "　青子は『草十郎の五分間』だけを巻き戻した。"

#. Occurrence C_13:4927:17502: scene=C_13
#: C_13:4927
msgctxt "text_id=17502 | speaker=unknown"
msgid "  Then, logically, he'd return to being a corpse as soon as the Magic ended."
msgstr "　が、それでは魔法が切れた時、彼が死体に戻るのも道理。"

#. Occurrence C_13:4932:17503: scene=C_13
#: C_13:4932
msgctxt "text_id=17503 | speaker=unknown"
msgid "  Time travel that didn't change the world couldn't change the past."
msgstr "　世界を換えずに行う時間旅行では、そもそも過去を変えられない。"

#. Occurrence C_13:4974:17504: scene=C_13
#: C_13:4974
msgctxt "text_id=17504 | speaker=unknown"
msgid "  Therefore..."
msgstr "　……故に。"

#. Occurrence C_13:4979:17505: scene=C_13
#: C_13:4979
msgctxt "text_id=17505 | speaker=unknown"
msgid "  If she wanted to save him, she had to either truly resurrect him,"
msgstr "　彼を救いたいのなら死者を蘇生させるか、"

#. Occurrence C_13:5034:17506: scene=C_13
#: C_13:5034
msgctxt "text_id=17506 | speaker=unknown"
msgid "  or send those five minutes of reality somewhere far away without returning them!"
msgstr "　それとも―――現実にあった<五分間|エネルギー>を、このままどこにも還さず、遠い場所に<棚|たな>上げしておくしかない―――！"

#. Occurrence C_13:5147:17507: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0007; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:5147
msgctxt "text_id=17507 | speaker=aoko"
msgid "\"Two down!\""
msgstr "「二枚目！」"

#. Occurrence C_13:5153:17508: scene=C_13
#: C_13:5153
msgctxt "text_id=17508 | speaker=unknown"
msgid "  Aoko showed no sign of slowing."
msgstr "　青子の進撃は止まらない。"

#. Occurrence C_13:5158:17509: scene=C_13
#: C_13:5158
msgctxt "text_id=17509 | speaker=unknown"
msgid "  From behind her crystal barrier, Touko glared at Aoko with disdain."
msgstr "　橙子は憎しみをもって、最後の<巨石|まもり>の後ろで青子を睨む。"

#. Occurrence C_13:5247:17510: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0015; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:5247
msgctxt "text_id=17510 | speaker=touko"
msgid "\"Answer me, Aoko! What did you do with his time?!"
msgstr "「答えろ青子！　貴様、彼の時間をどこにやった！"

#. Occurrence C_13:5254:17511: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0016; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:5254
msgctxt "text_id=17511 | speaker=touko"
msgid "  How're you going to balance all that heat?!\""
msgstr "　そこにあった熱量の帳尻を、どうやって合わせている！？」"

#. Occurrence C_13:5360:17512: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0008; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:5360
msgctxt "text_id=17512 | speaker=aoko"
msgid "\"How the hell should I know?! I tossed his time somewhere into the distant future!\""
msgstr "「っ、そんなの知るか！　アイツの時間なら、遥かな未来に<措|お>いてきたわよ！」"

#. Occurrence C_13:5392:17513: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0017; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:5392
msgctxt "text_id=17513 | speaker=touko"
msgid "\"What...?!\""
msgstr "「な―――」"

#. Occurrence C_13:5455:17514: scene=C_13
#: C_13:5455
msgctxt "text_id=17514 | speaker=unknown"
msgid "  Fifteen feet to go."
msgstr "　あと五メートル。"

#. Occurrence C_13:5460:17515: scene=C_13
#: C_13:5460
msgctxt "text_id=17515 | speaker=unknown"
msgid "  Faced with such madness, Touko wanted to cover her eyes."
msgstr "　肉薄するデタラメに、橙子は目を<覆|おお>いたくなった。"

#. Occurrence C_13:5465:17516: scene=C_13
#: C_13:5465
msgctxt "text_id=17516 | speaker=unknown"
msgid "  She put the debt of the present in the distant future?"
msgstr "　いま<現在|ここ>で作った負債を、未来に<措|お>いてきただと？"

#. Occurrence C_13:5470:17517: scene=C_13
#: C_13:5470
msgctxt "text_id=17517 | speaker=unknown"
msgid "  A time paradox would've been more humane."
msgstr "　タイムパラドックスの方がまだ人道的だ。"

#. Occurrence C_13:5475:17518: scene=C_13
#: C_13:5475
msgctxt "text_id=17518 | speaker=unknown"
msgid "  Such an enormous, haphazard consumption of heat could not be allowed."
msgstr "　そんな膨大な、無計画な熱量の消費を許してはならない。"

#. Occurrence C_13:5576:17519: scene=C_13
#: C_13:5576
msgctxt "text_id=17519 | speaker=unknown"
msgid "  After all, time travel alone required a massive amount of energy."
msgstr "　そも、時間旅行だけでも膨大なエネルギーを要する。"

#. Occurrence C_13:5581:17520: scene=C_13
#: C_13:5581
msgctxt "text_id=17520 | speaker=unknown"
msgid "  Magical energy was required to bring things from somewhere else;"
msgstr "　ここに無いものを持ってくる事にも魔力は必要だが、"

#. Occurrence C_13:5586:17521: scene=C_13
#: C_13:5586
msgctxt "text_id=17521 | speaker=unknown"
msgid "  at the same time, losing something that exists here consumed an incredible amount of energy."
msgstr "　それと同じに、ここに有るものを“無くす”事にも莫大なエネルギーが<消費|うしな>われる。"

#. Occurrence C_13:5591:17522: scene=C_13
#: C_13:5591
msgctxt "text_id=17522 | speaker=unknown"
msgid "  And what about the magical energy used for cooling?"
msgstr "　その冷却に使われた魔力はどうする？"

#. Occurrence C_13:5596:17523: scene=C_13
#: C_13:5596
msgctxt "text_id=17523 | speaker=unknown"
msgid "  If either fell out of equilibrium, it would mean total chaos."
msgstr "　プラスにしろマイナスにしろ、それは秩序の崩壊だ。"

#. Occurrence C_13:5601:17524: scene=C_13
#: C_13:5601
msgctxt "text_id=17524 | speaker=unknown"
msgid "  The distortion caused by her Magic would come to affect this entire sector of space."
msgstr "　魔法の作る<歪|ゆが>みは、いずれこの<宙域|ちゅういき>すべてに及ぶだろう。"

#. Occurrence C_13:5648:17525: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0018; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:5648
msgctxt "text_id=17525 | speaker=touko"
msgid "\"How... How in the HELL can you be so dumb?!"
msgstr "「ば―――バカここに極まったな！"

#. Occurrence C_13:5688:17526: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0019; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:5688
msgctxt "text_id=17526 | speaker=touko"
msgid "  You're going to pile that debt onto the dead end that humanity will reach? You're going to lay it at the feet of the heat death of the universe?"
msgstr "　何千億年後にくる宇宙の死滅、人類の行く末に待つ<どん詰|デッド><まり|エンド>に、さらなる負債を押しつける気か!?"

#. Occurrence C_13:5695:17527: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0020; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:5695
msgctxt "text_id=17527 | speaker=touko"
msgid "  That's like hanging a world-ending meteor over the head of this planet!"
msgstr "　この星の頭上に隕石を作っているようなものだぞ!?"

#. Occurrence C_13:5781:17528: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0021; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:5781
msgctxt "text_id=17528 | speaker=touko"
msgid "  Or are you planning on crushing the Earth under your own weight?!\""
msgstr "　というか、おまえの重みでこの星を押し潰す気か!?」"

#. Occurrence C_13:5825:17529: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0009; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:5825
msgctxt "text_id=17529 | speaker=aoko"
msgid "\"What...?!\""
msgstr "「な―――」"

#. Occurrence C_13:5831:17530: scene=C_13
#: C_13:5831
msgctxt "text_id=17530 | speaker=unknown"
msgid "  That last comment made Aoko's eyes widen."
msgstr "　その喩えはあんまりだ、と目をむく青子。"

#. Occurrence C_13:5836:17531: scene=C_13
#: C_13:5836
msgctxt "text_id=17531 | speaker=unknown"
msgid "  Her every step exerted such force it broke the floorboards beneath her feet."
msgstr "　突き進む足も、勢いあまって床をブチ抜いていたりする。"

#. Occurrence C_13:5947:17532: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0010; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:5947
msgctxt "text_id=17532 | speaker=aoko"
msgid "\"I'll worry about that later! Next time I'll put the debt in the past! That better?!"
msgstr "「その時はその時で、今度は負債を過去に送ってやるわよ！　それなら文句ないんでしょう！？"

#. Occurrence C_13:5954:17533: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0011; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:5954
msgctxt "text_id=17533 | speaker=aoko"
msgid "  Then only the past will be crushed by the distortion!\""
msgstr "　歪みに潰されるのは過去だけなんだから！」"

#. Occurrence C_13:6025:17534: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0022; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:6025
msgctxt "text_id=17534 | speaker=touko"
msgid "\"That's your master plan?!"
msgstr "「それで解決したつもりか！？"

#. Occurrence C_13:6031:17535: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0023; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:6031
msgctxt "text_id=17535 | speaker=touko"
msgid "  Save the present by destroying the past?!"
msgstr "　現在が確定している以上、過去を消滅させてもいいと！？"

#. Occurrence C_13:6037:17536: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0024; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:6037
msgctxt "text_id=17536 | speaker=touko"
msgid "  That saves us, but what about the heat problem, and the burden on the rest of the universe?!\""
msgstr "　それでいいのは私たちだけだ！　問題の総量、宇宙の負債はどうする！？」"

#. Occurrence C_13:6099:17537: scene=C_13
#: C_13:6099
msgctxt "text_id=17537 | speaker=unknown"
msgid "  Exactly."
msgstr "　―――そう。"

#. Occurrence C_13:6128:17538: scene=C_13
#: C_13:6128
msgctxt "text_id=17538 | speaker=unknown"
msgid "  Even if the universe were closed, or the present were still expanding,"
msgstr "　宇宙が閉じているにせよ、現在も<拡|ひろ>がっているにせよ、"

#. Occurrence C_13:6133:17539: scene=C_13
#: C_13:6133
msgctxt "text_id=17539 | speaker=unknown"
msgid "  the absurd increase in heat consumption would become uncontrollable."
msgstr "　消費熱量の増大は手に負えないものになる。"

#. Occurrence C_13:6153:17540: scene=C_13
#: C_13:6153
msgctxt "text_id=17540 | speaker=unknown"
msgid "  That which waits for the end of infinite expansion,"
msgstr "　際限のない広がり、"

#. Occurrence C_13:6158:17541: scene=C_13
#: C_13:6158
msgctxt "text_id=17541 | speaker=unknown"
msgid "  infinite consumption,"
msgstr "　際限のない消費、"

#. Occurrence C_13:6163:17542: scene=C_13
#: C_13:6163
msgctxt "text_id=17542 | speaker=unknown"
msgid "  and infinite growth is a future without hope."
msgstr "　際限のない成長の末に待つモノは、希望に満ちた未来などではない。"

#. Occurrence C_13:6169:17543: scene=C_13
#: C_13:6169
msgctxt "text_id=17543 | speaker=unknown"
msgid "  The nothingness before creation."
msgstr "　<開闢|かいびゃく>の前の無。"

#. Occurrence C_13:6174:17544: scene=C_13
#: C_13:6174
msgctxt "text_id=17544 | speaker=unknown"
msgid "  Eventually the universe would burn up."
msgstr "　いずれ宇宙は<熱的死|ねつてきし>する。"

#. Occurrence C_13:6195:17545: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0025; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:6195
msgctxt "text_id=17545 | speaker=touko"
msgid "\"Your-I mean, the Aozaki's Magic only makes that conclusion more certain! And that's on you!\""
msgstr "「青子の―――蒼崎の魔法は、その結末をより確かなものにするだけだ！　その責任を、おまえは―――！」"

#. Occurrence C_13:6201:17546: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0012; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:6201
msgctxt "text_id=17546 | speaker=aoko"
msgid "\"Don't you think I know that already?!"
msgstr "「言われなくても分かってる！"

#. Occurrence C_13:6207:17547: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0013; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:6207
msgctxt "text_id=17547 | speaker=aoko"
msgid "  I'll figure it out! As long as I live, I'll figure something out!\""
msgstr "　責任なんて、私が生きてる間になんとかするわよ！」"

#. Occurrence C_13:6298:17548: scene=C_13
#: C_13:6298
msgctxt "text_id=17548 | speaker=unknown"
msgid "  Five feet to go."
msgstr "　残り二メートル。"

#. Occurrence C_13:6303:17549: scene=C_13
#: C_13:6303
msgctxt "text_id=17549 | speaker=unknown"
msgid "  The rune blast, now carrying all of Touko's hatred, focused into a scorching hot laser beam."
msgstr "　ルーンの掃射は、もはや橙子の憎悪を宿した<熱線|ねっせん>となって突き刺さる。"

#. Occurrence C_13:6308:17550: scene=C_13
#: C_13:6308
msgctxt "text_id=17550 | speaker=unknown"
msgid "  Her body being torn into by the intense heat, and her emotions raging, Aoko drove her foot into the ground..."
msgstr "　その熱さに身を裂かれながらも、より強い感情で青子は地面を蹴り―――"

#. Occurrence C_13:6516:17551: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0026; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:6516
msgctxt "text_id=17551 | speaker=touko"
msgid "\"Oh, you'll take responsibility, will you?! How exactly?!\""
msgstr "「責任をとると言ったな……！　では、その具体案は！？」"

#. Occurrence C_13:6602:17552: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_13_0014; voice_prefix=A10; voice_category=1; scene=C_13
#: C_13:6602
msgctxt "text_id=17552 | speaker=aoko"
msgid "\"I said I'd figure it out, didn't I?! Starting now!\""
msgstr "「そんなの―――これから考えるに決まってるでしょう！」"

#. Occurrence C_13:6659:17553: scene=C_13
#: C_13:6659
msgctxt "text_id=17553 | speaker=unknown"
msgid "\"..."
msgstr "「―――"

#. Occurrence C_13:6667:17554: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_13_0027; voice_prefix=A20; voice_category=11; scene=C_13
#: C_13:6667
msgctxt "text_id=17554 | speaker=touko"
msgid " You make me sick!\""
msgstr "おまえは、最悪だ！」"

#. Occurrence C_13:6855:17555: scene=C_13
#: C_13:6855
msgctxt "text_id=17555 | speaker=unknown"
msgid "  Touko's last defense was shattered."
msgstr "　―――砕け散る最後の守り。"

#. Occurrence C_13:6860:17556: scene=C_13
#: C_13:6860
msgctxt "text_id=17556 | speaker=unknown"
msgid "  Close enough to connect, the two mages unleashed their magecraft."
msgstr "　二人の魔術師は拳を打てば届く距離で魔術を組み上げる。"

#. Occurrence C_13:6868:17557: scene=C_13
#: C_13:6868
msgctxt "text_id=17557 | speaker=unknown"
msgid "  Red runes... Blue Ether..."
msgstr "　赤色のルーンと、青色のエーテル流。"

#. Occurrence C_13:6875:17558: scene=C_13
#: C_13:6875
msgctxt "text_id=17558 | speaker=unknown"
msgid "  In a cascade of magic bullets, Touko Aozaki's crests were torn to pieces, and so was Touko herself."
msgstr "　撃ち出された魔弾は<瀑布|ばくふ>となって、背後に浮かんだ刻印ごと、蒼崎橙子を粉砕した。"

#. Occurrence C_14:80:17559: scene=C_14
#: C_14:80
msgctxt "text_id=17559 | speaker=unknown"
msgid "  It was just as Alice said."
msgstr "　有珠の言った通り。"

#. Occurrence C_14:85:17560: scene=C_14
#: C_14:85
msgctxt "text_id=17560 | speaker=unknown"
msgid "  By the time Soujyuro arrived, it was already over."
msgstr "　草十郎が追いつく前に、決着はついていた。"

#. Occurrence C_14:113:17561: scene=C_14
#: C_14:113
msgctxt "text_id=17561 | speaker=unknown"
msgid "  The old school building's wooden boards had survived the elements for decades, but they were not ready for a mage duel."
msgstr "　何十年もの風化に耐えてきた木造の校舎は、実に分かりやすく彼女たちの道行きを示していた。"

#. Occurrence C_14:118:17562: scene=C_14
#: C_14:118
msgctxt "text_id=17562 | speaker=unknown"
msgid "  The entrance door hung off its hinges;"
msgstr "　外れて戸が開かなくなった昇降口、"

#. Occurrence C_14:123:17563: scene=C_14
#: C_14:123
msgctxt "text_id=17563 | speaker=unknown"
msgid "  the floorboards groaned;"
msgstr "　ぎしぎしと音をたてる廊下、"

#. Occurrence C_14:128:17564: scene=C_14
#: C_14:128
msgctxt "text_id=17564 | speaker=unknown"
msgid "  the stairs were ready to collapse underfoot."
msgstr "　体重をのせれば踏み抜けそうな階段。"

#. Occurrence C_14:167:17565: scene=C_14
#: C_14:167
msgctxt "text_id=17565 | speaker=unknown"
msgid "  Touko's escape and Aoko's pursuit had left a trail of destruction leading all the way to the second floor."
msgstr "　それらを徹底的に破壊しながら続く逃走とその追跡は、二階の奥で終わりを告げていた。"

#. Occurrence C_14:239:17566: scene=C_14
#: C_14:239
msgctxt "text_id=17566 | speaker=unknown"
msgid "  The chaos continued to the end of the hallway, by the stairs to the third floor."
msgstr "　廊下の突き当たり、三階に続く小階段の前。"

#. Occurrence C_14:244:17567: scene=C_14
#: C_14:244
msgctxt "text_id=17567 | speaker=unknown"
msgid "  Touko sat in a heap with her back against the wall."
msgstr "　橙子は壁に背を預けるかたちで崩れ落ちていた。"

#. Occurrence C_14:249:17568: scene=C_14
#: C_14:249
msgctxt "text_id=17568 | speaker=unknown"
msgid "  Despite her injuries, she kept her eyes firmly on Aoko."
msgstr "　傷つきながらも青子から視線は逸らさない。"

#. Occurrence C_14:299:17569: scene=C_14
#: C_14:299
msgctxt "text_id=17569 | speaker=unknown"
msgid "  She was bleeding internally and had multiple broken bones;"
msgstr "　内部出血、さらには骨折。"

#. Occurrence C_14:304:17570: scene=C_14
#: C_14:304
msgctxt "text_id=17570 | speaker=unknown"
msgid "  she would not be moving any time soon."
msgstr "　彼女の<骨格|フレーム>はもう満足に動かない。"

#. Occurrence C_14:309:17571: scene=C_14
#: C_14:309
msgctxt "text_id=17571 | speaker=unknown"
msgid "  Possibly damaged by Aoko's flying kick, her Mystic Eyes had ruptured from within, closing them indefinitely."
msgstr "　青子の跳び蹴りでショートしたのか、<魔眼|ひだりめ>は内部から破裂し、開かれる事はない。"

#. Occurrence C_14:314:17572: scene=C_14
#: C_14:314
msgctxt "text_id=17572 | speaker=unknown"
msgid "  Despite her battered and broken body, she was still breathing steadily-a testament to her stubbornness."
msgstr "　それだけの<満身|まんしん><創痍|そうい>ぶりで、呼吸を乱していないのは最後の意地か。"

#. Occurrence C_14:319:17573: scene=C_14
#: C_14:319
msgctxt "text_id=17573 | speaker=unknown"
msgid "  Before her stood Aoko, staring down at her, uninjured."
msgstr "　目前で、無傷のまま見下ろしてくる妹に対しての。"

#. Occurrence C_14:360:17574: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0000; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:360
msgctxt "text_id=17574 | speaker=touko"
msgid "\"Thought I could...make it to the roof.\""
msgstr "「……屋上までは、<保|も>つと思っていたんだが」"

#. Occurrence C_14:383:17575: scene=C_14
#: C_14:383
msgctxt "text_id=17575 | speaker=unknown"
msgid "  Touko was not trying to be facetious; she sounded genuinely disappointed."
msgstr "　自嘲ではなく、純粋な思いを橙子は口にした。"

#. Occurrence C_14:388:17576: scene=C_14
#: C_14:388
msgctxt "text_id=17576 | speaker=unknown"
msgid "  Aoko responded with a cold glare."
msgstr "　青子は冷たい視線だけを返す。"

#. Occurrence C_14:467:17577: scene=C_14
#: C_14:467
msgctxt "text_id=17577 | speaker=unknown"
msgid "  Her azure eyes had not changed one bit."
msgstr "　先ほどからまったく変わらない青色の目。"

#. Occurrence C_14:472:17578: scene=C_14
#: C_14:472
msgctxt "text_id=17578 | speaker=unknown"
msgid "  They were callous as ever, yet undeniably beautiful."
msgstr "　冴え<凍|こご>えるそれは、冷酷なものだとしても、どうしようもなく美しい。"

#. Occurrence C_14:477:17579: scene=C_14
#: C_14:477
msgctxt "text_id=17579 | speaker=unknown"
msgid "  From where she stood, Aoko held her hand out toward Touko,"
msgstr "　青子は橙子には近寄らず、数歩の距離を開けて右手を差しだした。"

#. Occurrence C_14:523:17580: scene=C_14
#: C_14:523
msgctxt "text_id=17580 | speaker=unknown"
msgid "  like a hunter about to put a wounded prey out of its misery."
msgstr "　撃ち落とした獲物に<引導|いんどう>を渡す、<射手|しゃしゅ>のように。"

#. Occurrence C_14:585:17581: scene=C_14
#: C_14:585
msgctxt "text_id=17581 | speaker=unknown"
msgid "  The victor was decided."
msgstr "　勝負はついた。"

#. Occurrence C_14:590:17582: scene=C_14
#: C_14:590
msgctxt "text_id=17582 | speaker=unknown"
msgid "  The mage came to steal land and got a death sentence for her trouble."
msgstr "　管理地を奪いに来た魔術師は、死をもって敗北とする。"

#. Occurrence C_14:647:17583: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0000; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:647
msgctxt "text_id=17583 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence C_14:691:17584: scene=C_14
#: C_14:691
msgctxt "text_id=17584 | speaker=unknown"
msgid "  The silence was disquieting."
msgstr "　不必要な沈黙。"

#. Occurrence C_14:696:17585: scene=C_14
#: C_14:696
msgctxt "text_id=17585 | speaker=unknown"
msgid "  Moonlight peered through the demolished ceiling, illuminating the two sisters with its stare."
msgstr "　半壊した壁から差しこむ月明かりが、二人の影を廊下に映している。"

#. Occurrence C_14:701:17586: scene=C_14
#: C_14:701
msgctxt "text_id=17586 | speaker=unknown"
msgid "  The utterly mad sibling squabble was over."
msgstr "　先ほどまでの<馬|バ><鹿|カ><騒|さわ>ぎも既に無い。"

#. Occurrence C_14:707:17587: scene=C_14
#: C_14:707
msgctxt "text_id=17587 | speaker=unknown"
msgid "  Now the fireworks were finished,"
msgstr "　<火花|ひばな><散|ち>る嵐は過ぎ、"

msgctxt "text_id=17588 | speaker=unknown"
msgid "  and the cold wind had returned to claim the old school building."
msgstr "　張り詰めた寒気だけが、旧校舎を支配している。"

#. Occurrence C_14:730:17589: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0001; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:730
msgctxt "text_id=17589 | speaker=aoko"
msgid "\"Any last words?\""
msgstr "「何か、言い残す事はある？」"

#. Occurrence C_14:780:17590: scene=C_14
#: C_14:780
msgctxt "text_id=17590 | speaker=unknown"
msgid "  Aoko's voice cut through the silence."
msgstr "　唐突に青子は口を開けた。"

#. Occurrence C_14:785:17591: scene=C_14
#: C_14:785
msgctxt "text_id=17591 | speaker=unknown"
msgid "  Touko thought for a moment,"
msgstr "　橙子はそうだな、としばし考えこむ。"

#. Occurrence C_14:790:17592: scene=C_14
#: C_14:790
msgctxt "text_id=17592 | speaker=unknown"
msgid "  before lightly patting her coat pocket. Nothing. She frowned."
msgstr "　途中、コートのポケットを軽く叩き、何も入っていない音に渋い顔をした。"

#. Occurrence C_14:835:17593: scene=C_14
#: C_14:835
msgctxt "text_id=17593 | speaker=unknown"
msgid "\"..."
msgstr "「…………"

#. Occurrence C_14:843:17594: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0001; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:843
msgctxt "text_id=17594 | speaker=touko"
msgid "I thought I'd have one last smoke... but it looks like I burned through them all... while waiting for you."
msgstr "最後に<一服|いっぷく>と思ったが、あいにく、おまえを待っている間に吸い切ってしまってね。"

msgctxt "text_id=17595 | speaker=unknown"
msgid " They're bad for me, anyway. Japanese cigarettes taste too good.\""
msgstr "日本の煙草は<旨|うま>すぎていけない」"

#. Occurrence C_14:850:17596: scene=C_14
#: C_14:850
msgctxt "text_id=17596 | speaker=unknown"
msgid "  Aoko gave a small nod."
msgstr "　橙子の言葉に、青子はそう、と小さくうなずく。"

#. Occurrence C_14:856:17597: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0002; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:856
msgctxt "text_id=17597 | speaker=aoko"
msgid "\"Not exactly the last words I was expecting.\""
msgstr "「なかなか、常人には真似できない<遺言|ゆいごん>だったわ」"

#. Occurrence C_14:863:17598: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0002; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:863
msgctxt "text_id=17598 | speaker=touko"
msgid "\"Wait, wait... Okay. Fine. Tough crowd. I'll give you what you want: the meaningless final cry of a loser.\""
msgstr "「待て待て。いくら私でも、遺言まで謎かけをする気はないよ。お望み通り、敗者は敗者らしく<遠吠|とおぼ>えをあげるから聞くといい」"

#. Occurrence C_14:897:17599: scene=C_14
#: C_14:897
msgctxt "text_id=17599 | speaker=unknown"
msgid "  Touko's voice was laden with sarcasm, but not hostility or hatred."
msgstr "　橙子の声は皮肉げではあるものの、青子への敵意も憎悪もない。"

#. Occurrence C_14:902:17600: scene=C_14
#: C_14:902
msgctxt "text_id=17600 | speaker=unknown"
msgid "  Perhaps..."
msgstr "　―――おそらく。"

#. Occurrence C_14:907:17601: scene=C_14
#: C_14:907
msgctxt "text_id=17601 | speaker=unknown"
msgid "  Perhaps her vendetta was not directed at Aoko herself, but rather a product of two sisters born into a mage family."
msgstr "　彼女が報復しようとしたものは青子個人ではなく、自分と妹を取りこんだ、魔術師の家系そのものだったからだろう。"

#. Occurrence C_14:945:17602: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0003; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:945
msgctxt "text_id=17602 | speaker=touko"
msgid "\"I never thought the Aozaki Magic would be time travel. Some kinks obviously need ironing out... but that's not really for me to say."
msgstr "「……蒼崎の魔法が、時間旅行に端を発するものとは思わなかった。まだ事情がありそうだが、当事者ではない私には何ともね。"

#. Occurrence C_14:952:17603: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0004; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:952
msgctxt "text_id=17603 | speaker=touko"
msgid "What would I know anyway? Just... take it seriously, and you'll be fine."
msgstr "<凡夫|ぼんぷ>には分からない悩みだ、せいぜい大事に付き合っていけばいいさ。"

#. Occurrence C_14:979:17604: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0005; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:979
msgctxt "text_id=17604 | speaker=touko"
msgid "  ...The fact you... took ten years to figure it out doesn't give me confidence, though. I expected more of Alice.\""
msgstr "　……しかし、十年経ってもソレでは先が思いやられる。有珠は何をしていたんだか」"

#. Occurrence C_14:1049:17605: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0003; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:1049
msgctxt "text_id=17605 | speaker=aoko"
msgid "\"Alice helped in her own way. She doesn't think I'll ever make a real mage, though."
msgstr "「アリスにしてはよく付き合ってくれた方よ。魔術師としてはいつまでも半人前っていうのが彼女の結論。"

#. Occurrence C_14:1116:17606: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0004; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:1116
msgctxt "text_id=17606 | speaker=aoko"
msgid "  Can't say I disagree."
msgstr "　―――けどまあ、そうね。"

#. Occurrence C_14:1122:17607: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0005; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:1122
msgctxt "text_id=17607 | speaker=aoko"
msgid "  That wolf would've made for an interesting match.\""
msgstr "　あの狼となら、いい勝負をしたんじゃない？」"

#. Occurrence C_14:1162:17608: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0006; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:1162
msgctxt "text_id=17608 | speaker=touko"
msgid "\"Him...? No. He's useless now he's tasted defeat."
msgstr "「うん？　あれはダメだ、敗北を知ってしまった。もう完全じゃあない。"

#. Occurrence C_14:1169:17609: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0007; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:1169
msgctxt "text_id=17609 | speaker=touko"
msgid "Before you wielded Magic, perhaps, but... he's lost himself now."
msgstr "半人前に<値|あたい>で<勝|まさ>っていようが、魔法の前には特異性を見失うだろう。"

#. Occurrence C_14:1175:17610: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0008; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:1175
msgctxt "text_id=17610 | speaker=touko"
msgid "  Tell me something, Aoko."
msgstr "　ところで青子。"

#. Occurrence C_14:1181:17611: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0009; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:1181
msgctxt "text_id=17611 | speaker=touko"
msgid "  Your Magic...is it cause, or is it effect...?\""
msgstr "　おまえの魔法とやらは、手段か、それとも結果か？」"

#. Occurrence C_14:1212:17612: scene=C_14
#: C_14:1212
msgctxt "text_id=17612 | speaker=unknown"
msgid "  Touko wanted to know if it came before, or came after."
msgstr "　先なのか、後なのか。"

#. Occurrence C_14:1234:17613: scene=C_14
#: C_14:1234
msgctxt "text_id=17613 | speaker=unknown"
msgid "  Did Aoko need Magic to get her where she needed to go?"
msgstr "　ある場所を目指す為に魔法を必要としたのか、"

#. Occurrence C_14:1239:17614: scene=C_14
#: C_14:1239
msgctxt "text_id=17614 | speaker=unknown"
msgid "  Or did she obtain Magic as a result of reaching that place?"
msgstr "　その場所に到達した為に魔法が出来てしまったのか。"

#. Occurrence C_14:1260:17615: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0006; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:1260
msgctxt "text_id=17615 | speaker=aoko"
msgid "\"...Effect. I turned tail when I got to the door, so I never found out what that old man was thinking.\""
msgstr "「―――後よ。私は扉の前で尻尾をまいたから、じじいの思惑なんて知らないけど」"

#. Occurrence C_14:1266:17616: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0010; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:1266
msgctxt "text_id=17616 | speaker=touko"
msgid "\"Then it was the same process as the First Magic. Even more sinful... I heard the Second through the Fourth were created to reach that place."
msgstr "「第一魔法と同じ経緯か。ますます業が深い。第二から第四はその場所へ到達する為に生み出されたものと聞く。"

#. Occurrence C_14:1273:17617: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0011; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:1273
msgctxt "text_id=17617 | speaker=touko"
msgid "If opposites attract... I guess similars repulse. Better hope the First doesn't bite back."
msgstr "同族嫌悪は世の常だ。いずれ第一と食い合わなければいいのだがね。"

#. Occurrence C_14:1279:17618: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0012; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:1279
msgctxt "text_id=17618 | speaker=touko"
msgid "  But you reached the door, then? Which tells me Magic inheritance is similar to path inheritance. So, Ymir's Entrance was here all along.\""
msgstr "　……しかし、扉ときたか。魔法の継承とは<路|パス>の継承のようだな。ではやはり、ここに<泉|ユミル>の入り口があると？」"

#. Occurrence C_14:1316:17619: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0007; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:1316
msgctxt "text_id=17619 | speaker=aoko"
msgid "\"That's the Scandinavian name; I call it the Gate of Akasha."
msgstr "「北欧かぶれの貴女にとってはね。私にとってはアカシャの門と言えるものよ。"

#. Occurrence C_14:1322:17620: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0008; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:1322
msgctxt "text_id=17620 | speaker=aoko"
msgid "  ...And what you were after the whole time, correct?\""
msgstr "　……最初からそれを狙っていたんでしょう、貴女は」"

#. Occurrence C_14:1341:17621: scene=C_14
#: C_14:1341
msgctxt "text_id=17621 | speaker=unknown"
msgid "  Touko used every ounce of strength she could find to nod."
msgstr "　青子の問いに、橙子は残された命をはき出すように、ああ、と力なくうなずいた。"

#. Occurrence C_14:1363:17622: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0013; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:1363
msgctxt "text_id=17622 | speaker=touko"
msgid "\"...And it was going to be mine, but I couldn't wait generations."
msgstr "「……望めば手に入るというのに、何代も待つのは嫌だったんだ。"

msgctxt "text_id=17623 | speaker=unknown"
msgid " That's where Grandfather and I parted ways."
msgstr "祖父とはそれで決別したようなものだったよ。"

#. Occurrence C_14:1373:17624: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0014; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:1373
msgctxt "text_id=17624 | speaker=touko"
msgid "From then on, I had better things to do than chase revenge."
msgstr "蒼崎に対する復讐心は、それには優先されなかった。"

#. Occurrence C_14:1393:17625: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0015; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:1393
msgctxt "text_id=17625 | speaker=touko"
msgid "  Well... It's over now. No use talking about it anymore."
msgstr "　まあ、全ては終わった事だ。もう語る必要はない。"

#. Occurrence C_14:1399:17626: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0016; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:1399
msgctxt "text_id=17626 | speaker=touko"
msgid "  There's just one last thing to ask. What was it like touching the Root?\""
msgstr "　……最後に、<根源|こんげん>に触れた感想が聞きたいな」"

#. Occurrence C_14:1467:17627: scene=C_14
#: C_14:1467
msgctxt "text_id=17627 | speaker=unknown"
msgid "  Touko spoke after taking a deep breath."
msgstr "　深く息を吸いこんで橙子は言った。"

#. Occurrence C_14:1472:17628: scene=C_14
#: C_14:1472
msgctxt "text_id=17628 | speaker=unknown"
msgid "  Her last words showed no trace of hatred."
msgstr "　憎しみのない<遺言|ゆいごん>。"

#. Occurrence C_14:1477:17629: scene=C_14
#: C_14:1477
msgctxt "text_id=17629 | speaker=unknown"
msgid "  Aoko remained silent, as she began raising her right hand up high."
msgstr "　青子は答えず、右手を高々とかかげる。"

#. Occurrence C_14:1514:17630: scene=C_14
#: C_14:1514
msgctxt "text_id=17630 | speaker=unknown"
msgid "  She recalled her grandfather's orders."
msgstr "　数少ない祖父の言いつけ。"

#. Occurrence C_14:1519:17631: scene=C_14
#: C_14:1519
msgctxt "text_id=17631 | speaker=unknown"
msgid "  The source of True Magic."
msgstr "　魔法の源。"

#. Occurrence C_14:1524:17632: scene=C_14
#: C_14:1524
msgctxt "text_id=17632 | speaker=unknown"
msgid "  Revealing one's knowledge or impressions of the Root was strictly forbidden."
msgstr "　<根源|こんげん>に関しての知識、<所感|しょかん>は一切<漏|も>らしてはならない。"

#. Occurrence C_14:1552:17633: scene=C_14
#: C_14:1552
msgctxt "text_id=17633 | speaker=unknown"
msgid "  But this was her sister's dying wish; maybe it would be okay?"
msgstr "　けれど、姉の最後の頼みならば、その感想ぐらいは伝えてあげるべきなのだろうか。"

#. Occurrence C_14:1595:17634: scene=C_14
#: C_14:1595
msgctxt "text_id=17634 | speaker=unknown"
msgid "  The conversation would end the moment she brought her arm down."
msgstr "　……天を指すその腕が振り落とされれば、話は終わりだ。"

#. Occurrence C_14:1614:17635: scene=C_14
#: C_14:1614
msgctxt "text_id=17635 | speaker=unknown"
msgid "  Then, this rotting shell of a building would become her sibling's tomb."
msgstr "　この朽ちた建物が姉だった人の<墓標|ぼひょう>になるだろう。"

#. Occurrence C_14:1638:17636: scene=C_14
#: C_14:1638
msgctxt "text_id=17636 | speaker=unknown"
msgid "  What harm could it do? And it's not like she planned to follow her grandfather's rules anyway."
msgstr "　なら素直になるべきだし、そもそも、青子は祖父の言いつけを守る気などさらさら無い。"

#. Occurrence C_14:1687:17637: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0009; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:1687
msgctxt "text_id=17637 | speaker=aoko"
msgid "\"...I have a confession to make.\""
msgstr "「……白状するとね、姉さん」"

#. Occurrence C_14:1735:17638: scene=C_14
#: C_14:1735
msgctxt "text_id=17638 | speaker=unknown"
msgid "  Aoko's voice carried through the blue hallway."
msgstr "　蒼い廊下に、声は響く。"

#. Occurrence C_14:1788:17639: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0010; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:1788
msgctxt "text_id=17639 | speaker=aoko"
msgid "\"To be honest, I don't remember anything.\""
msgstr "「―――正直、ぜんっぜん分からなかったわ」"

#. Occurrence C_14:1798:17640: scene=C_14
#: C_14:1798
msgctxt "text_id=17640 | speaker=unknown"
msgid "  Aoko gave a blunt reply, and brought her arm down like a bolt of lightning."
msgstr "　なんだかミもフタもない感想を告げて、落雷のように、青子は右腕を振り落とした。"

#. Occurrence C_14:1838:17641: scene=C_14
#: C_14:1838
msgctxt "text_id=17641 | speaker=unknown"
msgid "  ...Or at least, she tried to."
msgstr "　……いや、落とそうとした。"

#. Occurrence C_14:1859:17642: scene=C_14
#: C_14:1859
msgctxt "text_id=17642 | speaker=unknown"
msgid "  Her arm wouldn't listen to her; it wouldn't budge."
msgstr "　けれど腕は青子の意に反して止まり、どんなに力を入れても下げられない。"

#. Occurrence C_14:1884:17643: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0011; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:1884
msgctxt "text_id=17643 | speaker=aoko"
msgid "\"What. Are you doing?\""
msgstr "「―――何の、つもり」"

#. Occurrence C_14:1890:17644: scene=C_14
#: C_14:1890
msgctxt "text_id=17644 | speaker=unknown"
msgid "  Cursing Alice, Aoko spat her question out with venom."
msgstr "　アリスの役たたず、と内心恨みながら青子は不愉快そうに吐き捨てた。"

#. Occurrence C_14:1895:17645: scene=C_14
#: C_14:1895
msgctxt "text_id=17645 | speaker=unknown"
msgid "  Soujyuro materialized from behind, taking hold of her raised arm."
msgstr "　自分の背後に現れて、かかげた右手を掴んでいる静希草十郎に向けて。"

#. Occurrence C_14:1913:17646: scene=C_14
#: C_14:1913
msgctxt "text_id=17646 | speaker=unknown"
msgid "  Though unable to express it, Touko was shocked to see him too."
msgstr "　表情にこそでていないが、橙子も彼の乱入に驚いている。"

#. Occurrence C_14:1955:17647: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0012; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:1955
msgctxt "text_id=17647 | speaker=aoko"
msgid "\"Let. Go.\""
msgstr "「手、離して」"

#. Occurrence C_14:1961:17648: scene=C_14
#: C_14:1961
msgctxt "text_id=17648 | speaker=unknown"
msgid "  Without looking at him, or even at her restrained hand, Aoko spoke sternly, her eyes forward."
msgstr "　草十郎に振り返る事も、掴まれた腕を見る事もせず、前だけを見つめて青子は言う。"

#. Occurrence C_14:1966:17649: scene=C_14
#: C_14:1966
msgctxt "text_id=17649 | speaker=unknown"
msgid "  Come to think of it, at the amusement park he appeared out of nowhere to protect her from that puppet."
msgstr "　……そういえば、懐かしいあの時も、この男は唐突に現れて人形から自分をかばったんだっけ、などと思いつつ。"

#. Occurrence C_14:2003:17650: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0013; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:2003
msgctxt "text_id=17650 | speaker=aoko"
msgid "\"Are you deaf? I won't say it again.\""
msgstr "「聞こえなかった？　二度はないわよ」"

#. Occurrence C_14:2020:17651: scene=C_14
#: C_14:2020
msgctxt "text_id=17651 | speaker=unknown"
msgid "  She was not bluffing."
msgstr "　青子の声に嘘はない。"

#. Occurrence C_14:2025:17652: scene=C_14
#: C_14:2025
msgctxt "text_id=17652 | speaker=unknown"
msgid "  If he interfered, even he would be given no mercy."
msgstr "　邪魔をするのなら、草十郎だろうと容赦はしない。"

#. Occurrence C_14:2030:17653: scene=C_14
#: C_14:2030
msgctxt "text_id=17653 | speaker=unknown"
msgid "\"I've decided to let you live.\""
msgstr "『命だけは助けてあげる』"

#. Occurrence C_14:2035:17654: scene=C_14
#: C_14:2035
msgctxt "text_id=17654 | speaker=unknown"
msgid "  It would go against that promise, but he should know better."
msgstr "　その約束とは矛盾しているけれど、そこまでしないと草十郎には伝わらないと理解している。"

#. Occurrence C_14:2066:17655: scene=C_14
#: C_14:2066
msgctxt "text_id=17655 | speaker=unknown"
msgid "  Even so, he maintained his grip on her arm."
msgstr "　けれど、青子のそんな鉄の意志を聞いても、草十郎は腕を掴んだまま離さない。"

#. Occurrence C_14:2087:17656: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0015; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:2087
msgctxt "text_id=17656 | speaker=aoko"
msgid "\"Do as you're...\""
msgstr "「いい加減に……」"

#. Occurrence C_14:2107:17657: scene=C_14
#: C_14:2107
msgctxt "text_id=17657 | speaker=unknown"
msgid "  As Aoko turned around,"
msgstr "　離せッ……！　と青子は振り向く。"

#. Occurrence C_14:2112:17658: scene=C_14
#: C_14:2112
msgctxt "text_id=17658 | speaker=unknown"
msgid "  the word \"told\" caught in her throat."
msgstr "　とたん、声の続きは<喉|のど>に<詰|つ>まってしまった。"

#. Occurrence C_14:2149:17659: scene=C_14
#: C_14:2149
msgctxt "text_id=17659 | speaker=unknown"
msgid "  She immediately regretted looking at him."
msgstr "　……その<表情|かお>を、見るべきではなかったと後悔する。"

#. Occurrence C_14:2154:17660: scene=C_14
#: C_14:2154
msgctxt "text_id=17660 | speaker=unknown"
msgid "  She saw herself in his expression."
msgstr "　自分の腕を掴んでいる少年の顔を見て、青子は鏡だな、と痛感した。"

#. Occurrence C_14:2191:17661: scene=C_14
#: C_14:2191
msgctxt "text_id=17661 | speaker=unknown"
msgid "  Mournful sadness..."
msgstr "　<悼|いた>むような哀しみ。"

#. Occurrence C_14:2196:17662: scene=C_14
#: C_14:2196
msgctxt "text_id=17662 | speaker=unknown"
msgid "  Judgmental anger..."
msgstr "　<糾|ただ>すような怒り。"

#. Occurrence C_14:2202:17663: scene=C_14
#: C_14:2202
msgctxt "text_id=17663 | speaker=unknown"
msgid "  His conflicting emotions spoke to her of her own internal struggle."
msgstr "　相容れない感情に沈んだ顔は、自分の中にある都合の悪い面を連想させる。"

#. Occurrence C_14:2261:17664: scene=C_14
#: C_14:2261
msgctxt "text_id=17664 | speaker=unknown"
msgid "  Voicelessly, quietly, without volition."
msgstr "　静かに、声もなく、意志もなく。"

#. Occurrence C_14:2266:17665: scene=C_14
#: C_14:2266
msgctxt "text_id=17665 | speaker=unknown"
msgid "  Rustic, gray eyes, questioning a deep sin."
msgstr "　<贖|あがな>いがたい罪を問う、灰色のさびた瞳。"

#. Occurrence C_14:2310:17666: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0016; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:2310
msgctxt "text_id=17666 | speaker=aoko"
msgid "\"If you've got something to say, then spit it out."
msgstr "「……言いたい事があるなら、はっきり口にしなさい。"

#. Occurrence C_14:2316:17667: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0017; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:2316
msgctxt "text_id=17667 | speaker=aoko"
msgid "  Otherwise, get out of my face.\""
msgstr "　それが出来ないなら消えて」"

#. Occurrence C_14:2341:17668: scene=C_14
#: C_14:2341
msgctxt "text_id=17668 | speaker=unknown"
msgid "  Soujyuro gently released Aoko's arm, as she maintained her resolve."
msgstr "　態度を崩さない青子から、草十郎はそっと手をほどいた。"

#. Occurrence C_14:2348:17669: scene=C_14
#: C_14:2348
msgctxt "text_id=17669 | speaker=unknown"
msgid "  They locked eyes, neither friend nor foe."
msgstr "　ふたりは敵と味方のように見つめ合う。"

#. Occurrence C_14:2395:17670: scene=C_14
#: C_14:2395
msgctxt "text_id=17670 | speaker=unknown"
msgid "  Their bitterness clashed without words."
msgstr "　互いに口にする事はなくて、あるのは終わらない沈黙の<苦|にが>さだけ。"

#. Occurrence C_14:2423:17671: scene=C_14
#: C_14:2423
msgctxt "text_id=17671 | speaker=unknown"
msgid "  And then suddenly..."
msgstr "　その中で、不意に、"

#. Occurrence C_14:2434:17672: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_14_0000; voice_prefix=A30; voice_category=3; scene=C_14
#: C_14:2434
msgctxt "text_id=17672 | speaker=soujuurou"
msgid "\"Murder is wrong.\""
msgstr "「人殺しは、いけない事だ」"

#. Occurrence C_14:2463:17673: scene=C_14
#: C_14:2463
msgctxt "text_id=17673 | speaker=unknown"
msgid "  Soujyuro stated in that matter-of-fact way of his with which Aoko had become all-too familiar."
msgstr "　あまりにも聞き慣れた、短い言葉が告げられた。"

#. Occurrence C_14:2495:17674: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0018; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:2495
msgctxt "text_id=17674 | speaker=aoko"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence C_14:2500:17675: scene=C_14
#: C_14:2500
msgctxt "text_id=17675 | speaker=unknown"
msgid "  His words were empty-trite even."
msgstr "　それは気持ちを形にしただけの、つまらない言葉だったけれど。"

#. Occurrence C_14:2505:17676: scene=C_14
#: C_14:2505
msgctxt "text_id=17676 | speaker=unknown"
msgid "  And yet, given her current state, they reached her."
msgstr "　今の青子には、その重さが嫌というほど分かってしまう。"

#. Occurrence C_14:2510:17677: scene=C_14
#: C_14:2510
msgctxt "text_id=17677 | speaker=unknown"
msgid "  Although she would soon forget the fragments of Soujyuro's memories, they made her painfully aware of how he felt."
msgstr "　いずれ忘れてしまうとしても、静希草十郎の過去を断片的に知ってしまった彼女には、本当に痛いほど理解できた。"

#. Occurrence C_14:2549:17678: scene=C_14
#: C_14:2549
msgctxt "text_id=17678 | speaker=unknown"
msgid "  Still, she could not agree with him."
msgstr "　けれどうなずく事はできない。"

#. Occurrence C_14:2554:17679: scene=C_14
#: C_14:2554
msgctxt "text_id=17679 | speaker=unknown"
msgid "  It would come back to bite her. If she let Touko go now, her sister would come for her again."
msgstr "　立場は逆転していくものだ。今を逃したら次は自分が追い詰められる。"

#. Occurrence C_14:2559:17680: scene=C_14
#: C_14:2559
msgctxt "text_id=17680 | speaker=unknown"
msgid "  She had already made two attempts on her life."
msgstr "　だいたい、一度ならず二度までも殺されかけた。"

#. Occurrence C_14:2564:17681: scene=C_14
#: C_14:2564
msgctxt "text_id=17681 | speaker=unknown"
msgid "  Aoko did not have it in her to forgive her sister for what she had done."
msgstr "　この借りを帳消しにするほど彼女は優しくはないし、"

#. Occurrence C_14:2569:17682: scene=C_14
#: C_14:2569
msgctxt "text_id=17682 | speaker=unknown"
msgid "  Above all―just as Touko said―if Aoko did not change she would be a novice forever."
msgstr "　なにより―――このままでは、橙子の言う通り、いつまでも半人前だ。"

#. Occurrence C_14:2623:17683: scene=C_14
#: C_14:2623
msgctxt "text_id=17683 | speaker=unknown"
msgid "  She had not even won her first mage battle yet."
msgstr "　まだ彼女は、魔術師として最初の<咎|とが>を果たしていない。"

#. Occurrence C_14:2628:17684: scene=C_14
#: C_14:2628
msgctxt "text_id=17684 | speaker=unknown"
msgid "  And she knew putting down a blood relative would require even more conviction."
msgstr "　その機会が肉親になるのなら、なにより強い決意になると青子は知っている。"

#. Occurrence C_14:2696:17685: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0019; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:2696
msgctxt "text_id=17685 | speaker=aoko"
msgid "\"...\""
msgstr "「…………っ」"

#. Occurrence C_14:2701:17686: scene=C_14
#: C_14:2701
msgctxt "text_id=17686 | speaker=unknown"
msgid "  Nevertheless, his words echoed over and over in her heart."
msgstr "　なのに、心の中では彼の台詞が繰り返されている。"

#. Occurrence C_14:2706:17687: scene=C_14
#: C_14:2706
msgctxt "text_id=17687 | speaker=unknown"
msgid "  Murder is wrong."
msgstr "　……人殺しは、いけない事だ。"

#. Occurrence C_14:2711:17688: scene=C_14
#: C_14:2711
msgctxt "text_id=17688 | speaker=unknown"
msgid "  Such a childish phrase. But the earnestness with which he said it... It was enough to make her sick."
msgstr "　子供じみた<率直|そっちょく>さ。その願いが彼にとってどれほど<尊|とうと>いものなのか、憎らしいほど感じ取れる。"

#. Occurrence C_14:2716:17689: scene=C_14
#: C_14:2716
msgctxt "text_id=17689 | speaker=unknown"
msgid "  Resisting, Aoko glowered at Soujyuro."
msgstr "　それを振り払うため、青子は草十郎を睨みつけた。"

#. Occurrence C_14:2768:17690: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0020_0; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:2768
msgctxt "text_id=17690 | speaker=aoko"
msgid "\"So what? "
msgstr "「だから？　"

msgctxt "text_id=17691 | speaker=unknown"
msgid "She just *killed* you, and you're going to protect her? "
msgstr "殺されたクセに、その相手まで<庇|かば>うっていうのアンタは？　"

#. Occurrence C_14:2779:17692: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0020_1; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:2779
msgctxt "text_id=17692 | speaker=aoko"
msgid "You're going to let her go, so she can come back and kill you again once she's recovered?\""
msgstr "元気になったら懲りずにやってくる殺人鬼が相手でも見逃してやれっていうの？」"

#. Occurrence C_14:2810:17693: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_14_0001; voice_prefix=A30; voice_category=3; scene=C_14
#: C_14:2810
msgctxt "text_id=17693 | speaker=soujuurou"
msgid "\"No. I don't have it in me to be a saint.\""
msgstr "「……まさか。そこまでいったら聖者だ。自分には、そこまでの事は言えない」"

#. Occurrence C_14:2855:17694: scene=C_14
#: C_14:2855
msgctxt "text_id=17694 | speaker=unknown"
msgid "  But he would probably still let her go."
msgstr "　だが、彼は見逃すだろう。"

#. Occurrence C_14:2860:17695: scene=C_14
#: C_14:2860
msgctxt "text_id=17695 | speaker=unknown"
msgid "  He did not think that Touko would change."
msgstr "　悪人の改心を期待するのではなく、"

#. Occurrence C_14:2865:17696: scene=C_14
#: C_14:2865
msgctxt "text_id=17696 | speaker=unknown"
msgid "  He also did not care to rationalize her actions based on her life."
msgstr "　悪人の人生を考慮してのものでもなく。"

#. Occurrence C_14:2893:17697: scene=C_14
#: C_14:2893
msgctxt "text_id=17697 | speaker=unknown"
msgid "  He was simply thankful. Thankful that this person before him was still alive."
msgstr "　ただ、誰かが生きている事に、感謝したいだけなのだと。"

#. Occurrence C_14:2938:17698: scene=C_14
#: C_14:2938
msgctxt "text_id=17698 | speaker=unknown"
msgid "\"You seem pretty damn saintly to me!\""
msgstr "“……じゅうぶん聖者なのよ、あなたは……！”"

#. Occurrence C_14:2944:17699: scene=C_14
#: C_14:2944
msgctxt "text_id=17699 | speaker=unknown"
msgid "  That was what had made Aoko so angry."
msgstr "　だから、それが頭にくる。"

#. Occurrence C_14:2949:17700: scene=C_14
#: C_14:2949
msgctxt "text_id=17700 | speaker=unknown"
msgid "  His overwhelming innocence and self-righteousness enraged her, like the hall of mirrors was happening all over again."
msgstr "　<無|む><知|ち><善良|ぜんりょう>すぎて頭にくるなんて、これでは本当にミラーハウスの焼き直しだ。"

#. Occurrence C_14:2968:17701: scene=C_14
#: C_14:2968
msgctxt "text_id=17701 | speaker=unknown"
msgid "  The only difference was now she knew why he was acting like this."
msgstr "　違うのは、草十郎がそこまで固執する理由を、今の青子は知っている事。"

#. Occurrence C_14:2973:17702: scene=C_14
#: C_14:2973
msgctxt "text_id=17702 | speaker=unknown"
msgid "  It was because she had taken a part of him."
msgstr "　草十郎はその経緯を、今は彼女に奪われている事。"

#. Occurrence C_14:3011:17703: scene=C_14
#: C_14:3011
msgctxt "text_id=17703 | speaker=unknown"
msgid "  He took a step forward, passing by her,"
msgstr "　彼は、彼女とすれ違うように前に出た。"

#. Occurrence C_14:3016:17704: scene=C_14
#: C_14:3016
msgctxt "text_id=17704 | speaker=unknown"
msgid "  saying words he knew he should not."
msgstr "　自身が、決して口にしてはならない言葉と共に。"

#. Occurrence C_14:3051:17705: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_14_0002; voice_prefix=A30; voice_category=3; scene=C_14
#: C_14:3051
msgctxt "text_id=17705 | speaker=soujuurou"
msgid "\"If it's revenge we're talking about, it seems logical that the guy who was murdered should be the one to do it."
msgstr "「仕返しなら、殺された人間がやるのが筋だろう。"

#. Occurrence C_14:3057:17706: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_14_0003; voice_prefix=A30; voice_category=3; scene=C_14
#: C_14:3057
msgctxt "text_id=17706 | speaker=soujuurou"
msgid "  I know I can't stop you."
msgstr "　君を止められないのは分かってる。"

#. Occurrence C_14:3064:17707: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_14_0004; voice_prefix=A30; voice_category=3; scene=C_14
#: C_14:3064
msgctxt "text_id=17707 | speaker=soujuurou"
msgid "So I may as well do it, Aozaki.\""
msgstr "だから、蒼崎がやるぐらいなら、俺がやる」"

#. Occurrence C_14:3100:17708: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0022; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:3100
msgctxt "text_id=17708 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence C_14:3106:17709: scene=C_14
#: C_14:3106
msgctxt "text_id=17709 | speaker=unknown"
msgid "  It was difficult to discern who was the more pathetic in all of this."
msgstr "　……その言葉に敗北を感じたのは、果たして誰だったのか。"

#. Occurrence C_14:3111:17710: scene=C_14
#: C_14:3111
msgctxt "text_id=17710 | speaker=unknown"
msgid "  Touko, who had been staring at them the whole time, closed her other eye as if drifting off to sleep."
msgstr "　二人を無言で見つめていた橙子は眠るように目蓋を閉じた。"

#. Occurrence C_14:3132:17711: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_14_0005; voice_prefix=A30; voice_category=3; scene=C_14
#: C_14:3132
msgctxt "text_id=17711 | speaker=soujuurou"
msgid "\"I'm sorry, Miss Touko.\""
msgstr "「ごめんなさい、橙子さん」"

#. Occurrence C_14:3138:17712: scene=C_14
#: C_14:3138
msgctxt "text_id=17712 | speaker=unknown"
msgid "  Knowing her fate, Touko dropped her head as best she could as he walked toward her."
msgstr "　歩み出る草十郎に、橙子は仕方なげに、小さくうなずいた。"

#. Occurrence C_14:3191:17713: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0017; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:3191
msgctxt "text_id=17713 | speaker=touko"
msgid "\"You know... It's better if you're the one to do it."
msgstr "「……そうだな。君には、それもいいかもしれない。"

#. Occurrence C_14:3197:17714: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0018; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:3197
msgctxt "text_id=17714 | speaker=touko"
msgid "  Things are... crazy right now; I can't imagine how much regret you'll feel after this all calms down."
msgstr "　今は特殊な状況だから、醒めた後に君がどれほど悔やむ事になるか想像もできない。"

#. Occurrence C_14:3203:17715: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0019; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:3203
msgctxt "text_id=17715 | speaker=touko"
msgid "  But you'll be out of purgatory. You can shake off... shake off your old self and move on."
msgstr "　ただ、それで君の停滞は終わるだろう。晴れて<禊|みそ>ぎ落としというワケだ。純粋に祝福してあげられる。"

#. Occurrence C_14:3209:17716: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0020; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:3209
msgctxt "text_id=17716 | speaker=touko"
msgid "  The only thing I regret is... it wasn't me who made you like this.\""
msgstr "　気に食わないのは、それを決意させたのが私ではなかったという事ぐらいか」"

#. Occurrence C_14:3241:17717: scene=C_14
#: C_14:3241
msgctxt "text_id=17717 | speaker=unknown"
msgid "  She knew that Soujyuro could not understand. Her words hanging in the air, she closed her lips tightly..."
msgstr "　草十郎には分からない言葉を告げて、橙子は唇を堅く閉じた。"

#. Occurrence C_14:3246:17718: scene=C_14
#: C_14:3246
msgctxt "text_id=17718 | speaker=unknown"
msgid "  ...then weakly stuck out her slender neck."
msgstr "　……無防備な、細い首が差し出される。"

#. Occurrence C_14:3251:17719: scene=C_14
#: C_14:3251
msgctxt "text_id=17719 | speaker=unknown"
msgid "  Soujyuro took another step forward."
msgstr "　さらに一歩踏みだす草十郎。"

#. Occurrence C_14:3288:17720: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0023; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:3288
msgctxt "text_id=17720 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence C_14:3393:17721: scene=C_14
#: C_14:3393
msgctxt "text_id=17721 | speaker=unknown"
msgid "  Before he could do anything, Aoko moved."
msgstr "　それより早く青子は動いた。"

#. Occurrence C_14:3398:17722: scene=C_14
#: C_14:3398
msgctxt "text_id=17722 | speaker=unknown"
msgid "  Spinning in front of Soujyuro, she cut off her magical energy, and swung her hand as hard as she could."
msgstr "　草十郎の前に回りこんで、全身に巡る魔力をすべてカットして、力のかぎり右手を振るった。"

#. Occurrence C_14:3403:17723: scene=C_14
#: C_14:3403
msgctxt "text_id=17723 | speaker=unknown"
msgid "  The sound of her slapping his face echoed through the hall, along with his staggering steps."
msgstr "　頬を叩く乾いた音と、廊下を数歩よろめく足音。"

#. Occurrence C_14:3463:17724: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_14_0006; voice_prefix=A30; voice_category=3; scene=C_14
#: C_14:3463
msgctxt "text_id=17724 | speaker=soujuurou"
msgid "\"...A-Ao-zaki...?\""
msgstr "「……あお……崎……？」"

#. Occurrence C_14:3559:17725: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0024; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:3559
msgctxt "text_id=17725 | speaker=aoko"
msgid "\"You coward.\""
msgstr "「この、卑怯者―――」"

#. Occurrence C_14:3617:17726: scene=C_14
#: C_14:3617
msgctxt "text_id=17726 | speaker=unknown"
msgid "  Tears of anger welling in her eyes, Aoko turned her back to Soujyuro,"
msgstr "　泣きそうなほど怒っている青子は、そのままくるりと草十郎に背を向ける。"

#. Occurrence C_14:3622:17727: scene=C_14
#: C_14:3622
msgctxt "text_id=17727 | speaker=unknown"
msgid "  sulking, as though she would kill him as soon as she looked at him again."
msgstr "　これ以上その顔を見ていたら、本気で殺しかねないと拗ねるように。"

#. Occurrence C_14:3643:17728: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0021; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:3643
msgctxt "text_id=17728 | speaker=touko"
msgid "\"That's what you get for taking another person's memories. He must've gotten inside your head, Aoko.\""
msgstr "「他人の記憶を取り込んだ代償か。引きずられたな、青子」"

#. Occurrence C_14:3649:17729: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0025; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:3649
msgctxt "text_id=17729 | speaker=aoko"
msgid "\"Yeah. I had no idea it sucked so much to have your own will influenced by someone else.\""
msgstr "「そうよ。自分の意志を<他|ひ><人|と>に曲げられるのが、こんなに悔しいなんて、知らなかった」"

#. Occurrence C_14:3670:17730: scene=C_14
#: C_14:3670
msgctxt "text_id=17730 | speaker=unknown"
msgid "  That was about all Aoko could mutter in response."
msgstr "　皮肉げな呟きに、青子はついそんな返答をしてしまった。"

#. Occurrence C_14:3675:17731: scene=C_14
#: C_14:3675
msgctxt "text_id=17731 | speaker=unknown"
msgid "  The corners of Touko's lips curled into a grin."
msgstr "　橙子は可笑しそうに唇をつり上げる。"

#. Occurrence C_14:3718:17732: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0026; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:3718
msgctxt "text_id=17732 | speaker=aoko"
msgid "\"What's so funny?\""
msgstr "「……何が可笑しいのよ、貴女」"

#. Occurrence C_14:3756:17733: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0022; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:3756
msgctxt "text_id=17733 | speaker=touko"
msgid "\"Nothing. It's just... I didn't think you were capable of normal human compassion."
msgstr "「いや、おまえにも人並の情けがあるとは思っていなくてね。"

#. Occurrence C_14:3762:17734: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0023; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:3762
msgctxt "text_id=17734 | speaker=touko"
msgid "  Being scared of taking on other people's burdens for ten whole years... You're not stupid, you're adorable.\""
msgstr "　バカ呼ばわりは訂正しておくよ。他人の理想を<背|せ><負|お>うのに<怯|おび>えるなんて、十年経っても可愛いじゃないか」"

#. Occurrence C_14:3815:17735: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0027; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:3815
msgctxt "text_id=17735 | speaker=aoko"
msgid "\"Now listen here―\""
msgstr "「―――アンタね」"

#. Occurrence C_14:3865:17736: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0024; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:3865
msgctxt "text_id=17736 | speaker=touko"
msgid "\"Don't glare at me like that. I meant what I said."
msgstr "「そう睨むな、今のは心からの賛辞だ。"

#. Occurrence C_14:3871:17737: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0025; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:3871
msgctxt "text_id=17737 | speaker=touko"
msgid "  So what's going to happen to me? Are you going to let him kill me, or let me go?\""
msgstr "　で、私をどうする？　彼に殺させるか、それとも見逃すか？」"

#. Occurrence C_14:3877:17738: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0028; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:3877
msgctxt "text_id=17738 | speaker=aoko"
msgid "\"It's not like I have a choice. Like you said, this is my reward,\""
msgstr "「……仕方ないでしょ。貴女の言う通り、これが何よりの代償だったんだから」"

#. Occurrence C_14:3951:17739: scene=C_14
#: C_14:3951
msgctxt "text_id=17739 | speaker=unknown"
msgid "  Aoko said begrudgingly, shooting Soujyuro a sideways glance."
msgstr "　言って、青子はちらりと草十郎の顔を見た。"

#. Occurrence C_14:3956:17740: scene=C_14
#: C_14:3956
msgctxt "text_id=17740 | speaker=unknown"
msgid "  He seemed to have recovered from the slap, and his usual, absentminded look had returned."
msgstr "　<頬|ほほ>を<叩|たた>かれた事で緊張が解けたのか、いつもの<呆|ぼう>とした表情に戻っている。"

#. Occurrence C_14:4002:17741: scene=C_14
#: C_14:4002
msgctxt "text_id=17741 | speaker=unknown"
msgid "  He may have had no memories of his past, but his morals and values were too deep to be erased."
msgstr "　……たとえ今は過去の記憶がなくとも、深層意識に刻まれた<不文律|ふぶんりつ>は消えはしない。"

#. Occurrence C_14:4007:17742: scene=C_14
#: C_14:4007
msgctxt "text_id=17742 | speaker=unknown"
msgid "  Soujyuro was trying to violate those."
msgstr "　それを、草十郎は自ら犯そうとした。"

#. Occurrence C_14:4012:17743: scene=C_14
#: C_14:4012
msgctxt "text_id=17743 | speaker=unknown"
msgid "  It would eat away at him forever."
msgstr "　自己を永遠に壊し続けるであろう事を代償に。"

#. Occurrence C_14:4017:17744: scene=C_14
#: C_14:4017
msgctxt "text_id=17744 | speaker=unknown"
msgid "  And he would be doing it not for himself but for Aoko."
msgstr "　静希草十郎のためでなく、蒼崎青子を守るために。"

#. Occurrence C_14:4052:17745: scene=C_14
#: C_14:4052
msgctxt "text_id=17745 | speaker=unknown"
msgid "  Aoko understood this all too well now."
msgstr "　今の青子にはそれがよく解っている。"

#. Occurrence C_14:4057:17746: scene=C_14
#: C_14:4057
msgctxt "text_id=17746 | speaker=unknown"
msgid "  The moment he said he would do it was the moment he lost."
msgstr "　だから彼が『自分がやる』といった瞬間、敗北を知らされた。"

#. Occurrence C_14:4062:17747: scene=C_14
#: C_14:4062
msgctxt "text_id=17747 | speaker=unknown"
msgid "  Not stopping him would be no different than watching him die."
msgstr "　それは彼を見殺しにする事と同義であり―――"

#. Occurrence C_14:4067:17748: scene=C_14
#: C_14:4067
msgctxt "text_id=17748 | speaker=unknown"
msgid "  And she would lose something important inside her."
msgstr "　なにより、それを許せば自分は、彼にとって命より大事な物になってしまう。"

#. Occurrence C_14:4088:17749: scene=C_14
#: C_14:4088
msgctxt "text_id=17749 | speaker=unknown"
msgid "  Aoko did not want that to happen."
msgstr "　……そんな物に、青子はなりたくはなかったのだ。"

#. Occurrence C_14:4109:17750: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_14_0007; voice_prefix=A30; voice_category=3; scene=C_14
#: C_14:4109
msgctxt "text_id=17750 | speaker=soujuurou"
msgid "\"Aozaki, don't tell me you're one of those people who has to enact revenge on their own terms.\""
msgstr "「……蒼崎、やっぱりその、自分の受けた傷は自分で返さないと気が済まない性格か？」"

#. Occurrence C_14:4132:17751: scene=C_14
#: C_14:4132
msgctxt "text_id=17751 | speaker=unknown"
msgid "  Aoko ignored Soujyuro, who seemed to have gotten the wrong idea."
msgstr "　見当違いの心配をしている草十郎から、ぷい、と青子は顔を背ける。"

#. Occurrence C_14:4137:17752: scene=C_14
#: C_14:4137
msgctxt "text_id=17752 | speaker=unknown"
msgid "  Instead, she directed her scowl at Touko, who still lay collapsed in front of her."
msgstr "　あとは目前に倒れこむ橙子を、いつも通りの不機嫌そうな視線で見下ろした。"

#. Occurrence C_14:4184:17753: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0029; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:4184
msgctxt "text_id=17753 | speaker=aoko"
msgid "\"...Fine. I'll let you live this time, Touko."
msgstr "「……分かったわよ。橙子、今回は見逃してあげる。"

#. Occurrence C_14:4190:17754: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0030; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:4190
msgctxt "text_id=17754 | speaker=aoko"
msgid "  But don't think you can just come and go as you please.\""
msgstr "　けど、ただで帰れるとは思ってないわよね？」"

#. Occurrence C_14:4196:17755: scene=C_14
#: C_14:4196
msgctxt "text_id=17755 | speaker=unknown"
msgid "  Touko scowled at her little sister, standing smugly over her."
msgstr "　声もなく口元に笑みを浮かべる青子を、橙子は眉をひそめて見つめた。"

#. Occurrence C_14:4251:17756: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0026; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:4251
msgctxt "text_id=17756 | speaker=touko"
msgid "\"If you're planning on handing me over to Grandfather, you may as well kill me now.\""
msgstr "「祖父の所に突き出すのなら、ここで引導を渡してくれ」"

#. Occurrence C_14:4258:17757: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0031; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:4258
msgctxt "text_id=17757 | speaker=aoko"
msgid "\"Yeah, right. I don't want to see him, either. You're going to leave this place, though."
msgstr "「まさか。私もあの人には会いたくないもの。貴女にはこのまま出ていってもらうわ。"

msgctxt "text_id=17758 | speaker=unknown"
msgid " I won't get in your way, or send word to the Association."
msgstr "邪魔もしないし、協会に届けも出さない。"

#. Occurrence C_14:4266:17759: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0032; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:4266
msgctxt "text_id=17759 | speaker=aoko"
msgid "  I'll be reporting what happened to Ritsuka myself; this'll be our secret.\""
msgstr "　律架は私が言いふくめておくから、今回の件は私たちだけの秘密よ」"

#. Occurrence C_14:4301:17760: scene=C_14
#: C_14:4301
msgctxt "text_id=17760 | speaker=unknown"
msgid "  Touko's brow creased further."
msgstr "　橙子はますます眉をひそめる。"

#. Occurrence C_14:4306:17761: scene=C_14
#: C_14:4306
msgctxt "text_id=17761 | speaker=unknown"
msgid "  There had to be a catch."
msgstr "　そんな都合のいい話、ある訳がない。"

#. Occurrence C_14:4339:17762: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0027; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:4339
msgctxt "text_id=17762 | speaker=touko"
msgid "\"Aoko. What are you scheming?\""
msgstr "「青子。何を企んでいる」"

#. Occurrence C_14:4404:17763: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0033; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:4404
msgctxt "text_id=17763 | speaker=aoko"
msgid "\"Nothing."
msgstr "「別に。"

msgctxt "text_id=17764 | speaker=unknown"
msgid " Just thinking about which spell to use on you. But I won't use Gandr, no... You've tasted that one enough already."
msgstr "そのかわりに呪いをプレゼントしようと思って。今までさんざんガンドくらってきたし、おあいこでしょ？"

#. Occurrence C_14:4412:17765: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0034; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:4412
msgctxt "text_id=17765 | speaker=aoko"
msgid "  Yes, the curse I have in mind is a little stronger."
msgstr "　まあ、私のはちょっと強力だけど。"

#. Occurrence C_14:4419:17766: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0035; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:4419
msgctxt "text_id=17766 | speaker=aoko"
msgid "If you ever show your face around here again, you'll turn into a frog.\""
msgstr "今後この土地に入ろうものなら、マダガスカルガエルになってもらうわ」"

#. Occurrence C_14:4425:17767: scene=C_14
#: C_14:4425
msgctxt "text_id=17767 | speaker=unknown"
msgid "  Smiling as if they had just arranged to eat Chinese food tomorrow night, Aoko walked toward Touko."
msgstr "　まるで明日の夕飯は中華にしよう、という気軽さで微笑んで、彼女は橙子へと歩み寄った。"

#. Occurrence C_14:4485:17768: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0028; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:4485
msgctxt "text_id=17768 | speaker=touko"
msgid "\"W-Wait...!"
msgstr "「待て……！"

#. Occurrence C_14:4491:17769: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0029; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:4491
msgctxt "text_id=17769 | speaker=touko"
msgid "  Who taught you how to do something like that?!\""
msgstr "　なんでそういうモノだけ修得してるんだ、おまえは！」"

#. Occurrence C_14:4497:17770: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0036; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:4497
msgctxt "text_id=17770 | speaker=aoko"
msgid "\"My mentor was Alice, of course. She always was an odd duck, wouldn't you agree?\""
msgstr "「そりゃ師匠がアリスだもの。<偏|かたよ>るのは当然でしょ？」"

#. Occurrence C_14:4537:17771: scene=C_14
#: C_14:4537
msgctxt "text_id=17771 | speaker=unknown"
msgid "  The elder Aozaki sister's brow knitted so hard it could have produced a sweater."
msgstr "　むう、と納得しつつ眉をひそめる蒼崎・姉。"

#. Occurrence C_14:4542:17772: scene=C_14
#: C_14:4542
msgctxt "text_id=17772 | speaker=unknown"
msgid "  Perhaps this is why her sister would stay a novice forever."
msgstr "　妹がいつまで経っても半人前なのは、そのあたりに原因があったのかと。"

#. Occurrence C_14:4590:17773: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0037; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:4590
msgctxt "text_id=17773 | speaker=aoko"
msgid "\"Soujyuro, get out of here."
msgstr "「草十郎、席<外|はず>して。"

#. Occurrence C_14:4596:17774: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0038; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:4596
msgctxt "text_id=17774 | speaker=aoko"
msgid "  Unless you're a creepy pervert. Then go ahead and watch. I don't care.\""
msgstr "　覗き見が趣味なら、別に見ていってもいいけど」"

#. Occurrence C_14:4627:17775: scene=C_14
#: C_14:4627
msgctxt "text_id=17775 | speaker=unknown"
msgid "  As she spoke, she began removing her sister's overcoat."
msgstr "　言いつつ、青子は姉のコートをはぎ取りにかかる。"

#. Occurrence C_14:4632:17776: scene=C_14
#: C_14:4632
msgctxt "text_id=17776 | speaker=unknown"
msgid "  The uncomfortable look in Touko's eyes compared to the strangely cheerful one in Aoko's caused Soujyuro to hesitate."
msgstr "　橙子のイヤそうな目と、青子のどことなく楽しげな目が対照的で、草十郎は少しだけ悩んでしまった。"

#. Occurrence C_14:4637:17777: scene=C_14
#: C_14:4637
msgctxt "text_id=17777 | speaker=unknown"
msgid "  Was it really okay to leave the two of them alone?"
msgstr "　はたして、このまま青子と橙子をふたりだけにしていいものか、と。"

#. Occurrence C_14:4657:17778: scene=C_14
#: C_14:4657
msgctxt "text_id=17778 | speaker=unknown"
msgid "  Eventually, he nodded: this was just a weird game between sisters."
msgstr "　けれど結局、罰ゲームを思わせる姉妹の様子に草十郎はうん、と頷き、"

#. Occurrence C_14:4670:17779: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_14_0008; voice_prefix=A30; voice_category=3; scene=C_14
#: C_14:4670
msgctxt "text_id=17779 | speaker=soujuurou"
msgid "\"Best not be a pervert.\""
msgstr "「覗き見は、たしかにいい趣味じゃないな」"

#. Occurrence C_14:4682:17780: scene=C_14
#: C_14:4682
msgctxt "text_id=17780 | speaker=unknown"
msgid "  Muttering more to himself than anything, he ducked into an empty classroom."
msgstr "　いつかのように呟いて、適当な空き教室へ退場した。"

#. Occurrence C_14:4729:17781: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_14_0030; voice_prefix=A20; voice_category=11; scene=C_14
#: C_14:4729
msgctxt "text_id=17781 | speaker=touko"
msgid "\"H-Hey...! What kind of dumbass formula is that?! "
msgstr "「ちょっ、なんだその不細工で悪趣味な術式は……！　"

msgctxt "text_id=17782 | speaker=unknown"
msgid "Are we really related?!\""
msgstr "センスがないにも程がある！　おまえ、本当に私の妹か！？」"

#. Occurrence C_14:4739:17783: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_14_0039; voice_prefix=A10; voice_category=1; scene=C_14
#: C_14:4739
msgctxt "text_id=17783 | speaker=aoko"
msgid "\"Afraid so. You took all the artistic genes for yourself, without thinking about your poor little sister. If you want to blame anyone, blame yourself.\""
msgstr "「ええ。この通り、芸術的才能はぜんぶ姉貴に持っていかれた憐れな妹でして。嘆くなら自分の天才性を嘆きなさい、橙子」"

#. Occurrence C_14:4745:17784: scene=C_14
#: C_14:4745
msgctxt "text_id=17784 | speaker=unknown"
msgid "  Down the cold, dilapidated hallway, cries of sadness, joy, and anguish rang out."
msgstr "　廊下には泣き声とも笑い声ともつかない苦悶の声が、遠吠えのように響いていった。"

#. Occurrence C_15:97:17785: scene=C_15
#: C_15:97
msgctxt "text_id=17785 | speaker=unknown"
msgid "  Outside, the fully bloomed, white flower petals floated one by one into the night."
msgstr "　咲き乱れていた白い花々は、ひとつ、またひとつと夜空へ舞い上がっていく。"

#. Occurrence C_15:102:17786: scene=C_15
#: C_15:102
msgctxt "text_id=17786 | speaker=unknown"
msgid "  Standing among the ballet of petals, Alice gazed up at the sky."
msgstr "　<吹|ふ><雪|ぶ>く<花霞|はながすみ>の中、有珠は原初の星空を見つめていた。"

#. Occurrence C_15:107:17787: scene=C_15
#: C_15:107
msgctxt "text_id=17787 | speaker=unknown"
msgid "  The blossoms gathered into a cloud, then slowly vanished, as though falling asleep."
msgstr "　花びらは<群雲|むらくも>になって、静かに、眠るように欠けていく。"

#. Occurrence C_15:112:17788: scene=C_15
#: C_15:112
msgctxt "text_id=17788 | speaker=unknown"
msgid "  Soon, not a single flower would remain, and the clearing would return to a snowy tundra."
msgstr "　いずれは一輪の<華影|かえい>もなく、広場はもとの雪原に<還|かえ>るのだろう。"

#. Occurrence C_15:207:17789: scene=C_15
#: C_15:207
msgctxt "text_id=17789 | speaker=unknown"
msgid "  The Magic had ended."
msgstr "　魔法は終わり。"

#. Occurrence C_15:212:17790: scene=C_15
#: C_15:212
msgctxt "text_id=17790 | speaker=unknown"
msgid "  In a matter of minutes, the past would return to its rightful place,"
msgstr "　過去の光景は、あと数分足らずで退場する。"

#. Occurrence C_15:217:17791: scene=C_15
#: C_15:217
msgctxt "text_id=17791 | speaker=unknown"
msgid "  along with it the time shared between the boy and the girl."
msgstr "　少年と少女の、行き違った時間のように。"

#. Occurrence C_15:290:17792: scene=C_15
#: C_15:290
msgctxt "text_id=17792 | speaker=unknown"
msgid "  The old school building was still."
msgstr "　旧校舎から音が<絶|た>えて<久|ひさ>しい。"

#. Occurrence C_15:295:17793: scene=C_15
#: C_15:295
msgctxt "text_id=17793 | speaker=unknown"
msgid "  Alice embraced the silence and patiently waited."
msgstr "　有珠は無言で待ち続ける。"

#. Occurrence C_15:300:17794: scene=C_15
#: C_15:300
msgctxt "text_id=17794 | speaker=unknown"
msgid "  After a while, Soujyuro emerged from the building, and Alice released a puff of white breath."
msgstr "　しばらくの<後|あと>、旧校舎から現れた草十郎の姿を見て、有珠は白い息をこぼした。"

#. Occurrence C_15:306:17795: scene=C_15
#: C_15:306
msgctxt "text_id=17795 | speaker=unknown"
msgid "  A small sigh of relief; it was over."
msgstr "　かすかな安堵をふくんだ、終わりを認める嘆息を。"

#. Occurrence C_15:355:17796: scene=C_15
#: C_15:355
msgctxt "text_id=17796 | speaker=unknown"
msgid "  Soujyuro approached, carrying Aoko,"
msgstr "　草十郎は青子を抱えてやってきた。"

#. Occurrence C_15:360:17797: scene=C_15
#: C_15:360
msgctxt "text_id=17797 | speaker=unknown"
msgid "  cradling her in his arms."
msgstr "　背中におぶるのではなく、前に寝かせるように両手で。"

#. Occurrence C_15:382:17798: scene=C_15
#: C_15:382
msgctxt "text_id=17798 | speaker=unknown"
msgid "  Was she asleep? Her eyes were closed and she seemed peaceful."
msgstr "　青子は眠っているのか、安らかな顔で目蓋を閉じていた。"

#. Occurrence C_15:387:17799: scene=C_15
#: C_15:387
msgctxt "text_id=17799 | speaker=unknown"
msgid "  Her hair and limp body dangled like a silk drape; she looked just like Sleeping Beauty."
msgstr "　ぐったりとした、けれどしなやかな体と長い髪が、童話の眠り姫を連想させる。"

#. Occurrence C_15:423:17800: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0000; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:423
msgctxt "text_id=17800 | speaker=soujuurou"
msgid "\"So you decided to wait for us, Alice.\""
msgstr "「待っていてくれたんだ、有珠」"

#. Occurrence C_15:429:17801: scene=C_15
#: C_15:429
msgctxt "text_id=17801 | speaker=unknown"
msgid "  He said, holding Aoko with little effort. Alice nodded."
msgstr "　苦もなく青子を抱える草十郎に、有珠は頷きだけで返答した。"

#. Occurrence C_15:450:17802: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0000; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:450
msgctxt "text_id=17802 | speaker=alice"
msgid "\"What happened to Touko?\""
msgstr "「橙子さんはどうなったの？」"

#. Occurrence C_15:456:17803: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0001; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:456
msgctxt "text_id=17803 | speaker=soujuurou"
msgid "\"Uh, to be honest, I don't really know, but she's gone."
msgstr "「……いや。よく分からないけど、橙子さんは帰ったよ。"

#. Occurrence C_15:462:17804: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0002; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:462
msgctxt "text_id=17804 | speaker=soujuurou"
msgid "  Aozaki said she placed a really strong curse on her so she wouldn't come back to Misaki for ten years."
msgstr "　蒼崎が言うにはそう簡単に解呪できない呪いをかけたから、むこう十年は三咲市には入ってこれないって。"

#. Occurrence C_15:468:17805: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0003; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:468
msgctxt "text_id=17805 | speaker=soujuurou"
msgid "  After that she stood and watched Touko run away until she was out of sight. Then she collapsed.\""
msgstr "　その後、橙子さんが尻尾をまくのを仁王立ちで見届けて、見えなくなったらそのまま倒れたんだ」"

#. Occurrence C_15:505:17806: scene=C_15
#: C_15:505
msgctxt "text_id=17806 | speaker=unknown"
msgid "  Alice's response was brief, as if she was wondering if things were really so simple."
msgstr "　その光景は簡単に想像できるのか、有珠はそう、と素っ気なく応えた。"

#. Occurrence C_15:510:17807: scene=C_15
#: C_15:510
msgctxt "text_id=17807 | speaker=unknown"
msgid "  She seemed more concerned about Touko than Aoko,"
msgstr "　橙子の心配はするクセに青子の心配はこれっぽっちもしていないらしい。"

#. Occurrence C_15:515:17808: scene=C_15
#: C_15:515
msgctxt "text_id=17808 | speaker=unknown"
msgid "  which made Soujyuro concerned about Alice and Aoko's relationship more than anything."
msgstr "　青子と有珠の関係そのものを、ちょっと心配してしまう草十郎だった。"

#. Occurrence C_15:551:17809: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0004; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:551
msgctxt "text_id=17809 | speaker=soujuurou"
msgid "\"Okay, well anyway,"
msgstr "「それはともかくとして。"

#. Occurrence C_15:557:17810: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0005; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:557
msgctxt "text_id=17810 | speaker=soujuurou"
msgid "  what's going on with Aoko?\""
msgstr "　青子はどうなっているんだろう？」"

#. Occurrence C_15:563:17811: scene=C_15
#: C_15:563
msgctxt "text_id=17811 | speaker=unknown"
msgid "  He asked nonchalantly as he looked at Aoko breathing deeply in her sleep."
msgstr "　わりとどうでもいいような口ぶりで、草十郎は寝息をたてている少女の顔を覗きこむ。"

#. Occurrence C_15:601:17812: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0001; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:601
msgctxt "text_id=17812 | speaker=alice"
msgid "\"...It looks like the variables are still balancing out."
msgstr "「……<無順|むじゅん>と<正順|せいじゅん>を合わせているのね。"

#. Occurrence C_15:607:17813: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0002; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:607
msgctxt "text_id=17813 | speaker=alice"
msgid "  Since her time diverged from our current time, she likely won't open her eyes until all the gears line up again.\""
msgstr "　彼女の時間は今の時間とは異なってしまったから、歯車を合わせるまで目は覚めないわ」"

#. Occurrence C_15:613:17814: scene=C_15
#: C_15:613
msgctxt "text_id=17814 | speaker=unknown"
msgid "  Soujyuro nodded in understanding, very clearly still not comprehending a word Alice had just said."
msgstr "　有珠の言葉に、なるほど、などと<胡乱|うろん>な相づちをうって、草十郎は旧校舎を振り返った。"

#. Occurrence C_15:665:17815: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0006; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:665
msgctxt "text_id=17815 | speaker=soujuurou"
msgid "\"It's a bit of an anti-climax."
msgstr "「なんか拍子抜けしたよ。"

#. Occurrence C_15:671:17816: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0007; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:671
msgctxt "text_id=17816 | speaker=soujuurou"
msgid "  I can't tell if Aozaki or Miss Touko won.\""
msgstr "　結局、橙子さんと蒼崎、どっちが勝ったのかよく掴めない」"

#. Occurrence C_15:692:17817: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0003; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:692
msgctxt "text_id=17817 | speaker=alice"
msgid "\"...Right. Mage battles aren't always cut and dry. It's not always just about who was more powerful."
msgstr "「……そうね。魔術師の争いには明確な点数はつけられないから。どちらが強いかで勝負はつかないわ。"

#. Occurrence C_15:698:17818: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0004; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:698
msgctxt "text_id=17818 | speaker=alice"
msgid "  If Touko's objective was to discover the Aozakis' True Magic, then Aoko lost the moment she used it."
msgstr "　橙子さんの大目的が蒼崎の魔法の解明なら、魔法を使わされた時点で青子の負けよ。"

#. Occurrence C_15:705:17819: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0005; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:705
msgctxt "text_id=17819 | speaker=alice"
msgid "...Everything that happened after was merely the triumphant winner being accosted by the loser.\""
msgstr "……その後のいざこざは、<凱旋|がいせん>する勝者を夜道で襲ったようなものだし」"

#. Occurrence C_15:725:17820: scene=C_15
#: C_15:725
msgctxt "text_id=17820 | speaker=unknown"
msgid "  Alice said, as she turned her sights to the forest."
msgstr "　言って、有珠は森の方角に視線を投げた。"

#. Occurrence C_15:730:17821: scene=C_15
#: C_15:730
msgctxt "text_id=17821 | speaker=unknown"
msgid "  Even Soujyuro could tell that was Alice's way of saying, \"Let's go home.\""
msgstr "　それが『帰りましょう』という意思表示である事は、草十郎にも読み取れた。"

#. Occurrence C_15:783:17822: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0008; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:783
msgctxt "text_id=17822 | speaker=soujuurou"
msgid "\"Yeah. Let's go. At this rate, you'll both catch a cold."
msgstr "「そうだね。蒼崎も有珠も、このままじゃ風邪をひく。"

#. Occurrence C_15:789:17823: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0009; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:789
msgctxt "text_id=17823 | speaker=soujuurou"
msgid "  Oh, I almost forgot. When Aozaki cursed Miss Touko, she did something else...\""
msgstr "　ああ、それと。蒼崎が橙子さんに呪いをかける時、何かしてたんだけど」"

#. Occurrence C_15:795:17824: scene=C_15
#: C_15:795
msgctxt "text_id=17824 | speaker=unknown"
msgid "  Soujyuro trailed off, hoping Alice would tell him what it was, but a stony―and somewhat affected―gaze was her response."
msgstr "　わかる？　と訊きたがる草十郎に、有珠はやや作り物っぽい、いつもの無感情な視線を向けた。"

#. Occurrence C_15:843:17825: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0006; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:843
msgctxt "text_id=17825 | speaker=alice"
msgid "\"...Did you watch, Sizuki?\""
msgstr "「……見たの、静希君？」"

#. Occurrence C_15:849:17826: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0010; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:849
msgctxt "text_id=17826 | speaker=soujuurou"
msgid "\"No. Aozaki told me to get out.\""
msgstr "「いや、蒼崎が出てけって」"

#. Occurrence C_15:865:17827: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0007; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:865
msgctxt "text_id=17827 | speaker=alice"
msgid "\"...Good. Did she say what curse she placed on her?\""
msgstr "「……そう。それで、青子はどんな呪いをかけたの？」"

#. Occurrence C_15:871:17828: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0011; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:871
msgctxt "text_id=17828 | speaker=soujuurou"
msgid "\"Umm... something about turning her into a frog.\""
msgstr "「えーと、カエルがどうとか」"

#. Occurrence C_15:901:17829: scene=C_15
#: C_15:901
msgctxt "text_id=17829 | speaker=unknown"
msgid "  Soujyuro's explanation made Alice's expression darken."
msgstr "　草十郎の言葉に、有珠はますます顔を<曇|くも>らせる。"

#. Occurrence C_15:906:17830: scene=C_15
#: C_15:906
msgctxt "text_id=17830 | speaker=unknown"
msgid "  Aoko was still a long way from learning any sort of polymorph spells."
msgstr "　……体を変異させる呪いなんて、青子はまだ修得していないはずなのに。"

#. Occurrence C_15:979:17831: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0008; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:979
msgctxt "text_id=17831 | speaker=alice"
msgid "\"That's...\""
msgstr "「そ―――」"

#. Occurrence C_15:985:17832: scene=C_15
#: C_15:985
msgctxt "text_id=17832 | speaker=unknown"
msgid "  Her thoughts prevented her from finishing the sentence."
msgstr "　思い立って、その言葉を飲む。"

#. Occurrence C_15:990:17833: scene=C_15
#: C_15:990
msgctxt "text_id=17833 | speaker=unknown"
msgid "  In actuality, it was perfectly within Aoko's abilities considering where she was in time at that moment."
msgstr "　そう、たしかにさっきまでの彼女なら、それぐらいは知っていたかもしれない。"

#. Occurrence C_15:995:17834: scene=C_15
#: C_15:995
msgctxt "text_id=17834 | speaker=unknown"
msgid "  As Aoko had said: Touko would not be able to dispel the curse for ten years."
msgstr "　そうなると青子の言う通り、むこう十年は呪いの解呪はできないだろう。"

#. Occurrence C_15:1015:17835: scene=C_15
#: C_15:1015
msgctxt "text_id=17835 | speaker=unknown"
msgid "  And the Aoko of this time had not the ability to use such a curse."
msgstr "　なにしろ呪いをかけた本人が、その呪いをまだ修得していないのだ。"

#. Occurrence C_15:1020:17836: scene=C_15
#: C_15:1020
msgctxt "text_id=17836 | speaker=unknown"
msgid "  Which meant Touko did not have anyone to rebound the curse to."
msgstr "　<回|まわ>そうにも、呪い返す相手がいない。"

#. Occurrence C_15:1025:17837: scene=C_15
#: C_15:1025
msgctxt "text_id=17837 | speaker=unknown"
msgid "  No matter how much she researched dispelling powerful curses, she could not do it with the Aoko of this timeline."
msgstr "　いかに橙子が優れた呪いの破壊を開発しても、因にあたる<青子|あいて>がいないのでは成立しない。"

#. Occurrence C_15:1101:17838: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0009; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:1101
msgctxt "text_id=17838 | speaker=alice"
msgid "\"Aoko only cut Touko a little bit. It's nothing for you to worry about."
msgstr "「青子が橙子さんにつけたのは<切傷|きりきず>ぐらいだから、静希君が心配するような事はないわ。"

#. Occurrence C_15:1107:17839: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0010; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:1107
msgctxt "text_id=17839 | speaker=alice"
msgid "  I expected her to do something much worse.\""
msgstr "　……青子にしては、ずいぶんと<生温|なまぬる>い処置だけど」"

#. Occurrence C_15:1153:17840: scene=C_15
#: C_15:1153
msgctxt "text_id=17840 | speaker=unknown"
msgid "  After her slightly unsettling remark, Alice quietly began to walk."
msgstr "　わりと非道な事を言って、有珠は歩きだした。"

#. Occurrence C_15:1158:17841: scene=C_15
#: C_15:1158
msgctxt "text_id=17841 | speaker=unknown"
msgid "  Soujyuro followed her, Aoko in his arms."
msgstr "　草十郎も青子を抱いたまま付いていく。"

#. Occurrence C_15:1171:17842: scene=C_15
#: C_15:1171
msgctxt "text_id=17842 | speaker=unknown"
msgid "  Together, they left the clearing and moved into the forest."
msgstr "　ふたりは広場から出て森の中に入る。"

#. Occurrence C_15:1176:17843: scene=C_15
#: C_15:1176
msgctxt "text_id=17843 | speaker=unknown"
msgid "  As they did, Soujyuro abruptly froze."
msgstr "　その時、不意に草十郎は足を止めた。"

#. Occurrence C_15:1223:17844: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0011; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:1223
msgctxt "text_id=17844 | speaker=alice"
msgid "\"...Sizuki?\" "
msgstr "「…………静希君？」"

#. Occurrence C_15:1229:17845: scene=C_15
#: C_15:1229
msgctxt "text_id=17845 | speaker=unknown"
msgid "  He looked back toward the old school building's field with a strange expression."
msgstr "　草十郎は不思議そうに、旧校舎の広場を振り返る。"

#. Occurrence C_15:1329:17846: scene=C_15
#: C_15:1329
msgctxt "text_id=17846 | speaker=unknown"
msgid "  Was it homesickness he felt?"
msgstr "　眼差しは、望郷の<類|たぐい>だろうか。"

#. Occurrence C_15:1334:17847: scene=C_15
#: C_15:1334
msgctxt "text_id=17847 | speaker=unknown"
msgid "  Though this was only his second time seeing it, he had a nostalgic feeling... like he would never be back."
msgstr "　一夜だけの、二度と見る事のない風景を<懐|なつ>かしみながらも、二度と出会えない事を<悟|さと>っている顔。"

#. Occurrence C_15:1339:17848: scene=C_15
#: C_15:1339
msgctxt "text_id=17848 | speaker=unknown"
msgid "  He looked like a child saying goodbye to an old toy that was to be thrown away."
msgstr "　戻らない船を見送る子供のようだ。"

#. Occurrence C_15:1345:17849: scene=C_15
#: C_15:1345
msgctxt "text_id=17849 | speaker=unknown"
msgid "  Seeing his expression, Alice felt a hint of sympathy, and chided herself."
msgstr "　……その横顔に、わずかな同情を抱いている事に気付いて、有珠は自らを<戒|いまし>めた。"

#. Occurrence C_15:1417:17850: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0012; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:1417
msgctxt "text_id=17850 | speaker=alice"
msgid "\"Something on your mind...?\""
msgstr "「あの<荒地|あれち>がどうかした……？」"

#. Occurrence C_15:1423:17851: scene=C_15
#: C_15:1423
msgctxt "text_id=17851 | speaker=unknown"
msgid "  She asked him, watching the flowery garden fade into a snowy field."
msgstr "　雪原に戻りかける花園を、少女は荒地と言った。"

#. Occurrence C_15:1428:17852: scene=C_15
#: C_15:1428
msgctxt "text_id=17852 | speaker=unknown"
msgid "  Soujyuro shook his head."
msgstr "　有珠の問いかけに、草十郎はいや、と首を振る。"

#. Occurrence C_15:1449:17853: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0012; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:1449
msgctxt "text_id=17853 | speaker=soujuurou"
msgid "\"Not really. It's just... I feel like I know that place."
msgstr "「なんとなく知っている場所に似てる気がして。"

#. Occurrence C_15:1455:17854: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0013; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:1455
msgctxt "text_id=17854 | speaker=soujuurou"
msgid "  It's weird, right? I didn't feel that way when I got here.\""
msgstr "　おかしいな、やってきた時はそんな気はしなかったのに」"

#. Occurrence C_15:1507:17855: scene=C_15
#: C_15:1507
msgctxt "text_id=17855 | speaker=unknown"
msgid "  He stood staring at the tundra for what seemed like an eternity, reluctant to leave."
msgstr "　彼は、いつまでも名残惜しそうに雪原を見つめていた。"

#. Occurrence C_15:1512:17856: scene=C_15
#: C_15:1512
msgctxt "text_id=17856 | speaker=unknown"
msgid "  If she left him there, he would still be gazing at it by morning-probably even longer."
msgstr "　放っておけば朝が来るまで、いや、朝が来ても見つめたままだろう。"

#. Occurrence C_15:1517:17857: scene=C_15
#: C_15:1517
msgctxt "text_id=17857 | speaker=unknown"
msgid "  But there was no point in doing that."
msgstr "　……けれど、それは意味のない行為だ。"

#. Occurrence C_15:1522:17858: scene=C_15
#: C_15:1522
msgctxt "text_id=17858 | speaker=unknown"
msgid "  In the end, Alice was the only one who would remember the beautiful scenery he yearned for."
msgstr "　彼が恋焦がれている風景は、有珠だけが覚えているものなのだから。"

#. Occurrence C_15:1550:17859: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0013; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:1550
msgctxt "text_id=17859 | speaker=alice"
msgid "\"Does it really look that familiar?\""
msgstr "「……ここは、その場所にそんなに似てる？」"

#. Occurrence C_15:1556:17860: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0014; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:1556
msgctxt "text_id=17860 | speaker=soujuurou"
msgid "\"Not at all. Not one bit of it.\""
msgstr "「ぜんぜん似てない。<面影|おもかげ>すら<皆無|かいむ>だ」"

#. Occurrence C_15:1562:17861: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0014; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:1562
msgctxt "text_id=17861 | speaker=alice"
msgid "\"Then it's just your imagination.\""
msgstr "「なら、それは気の迷いよ」"

#. Occurrence C_15:1600:17862: scene=C_15
#: C_15:1600
msgctxt "text_id=17862 | speaker=unknown"
msgid "  Soujyuro nodded at Alice's harsh conclusion."
msgstr "　強く断定する有珠の言葉に、草十郎は静かに頷いた。"

#. Occurrence C_15:1605:17863: scene=C_15
#: C_15:1605
msgctxt "text_id=17863 | speaker=unknown"
msgid "  He smiled slightly, deciding it was pointless to want something that did not exist."
msgstr "　ありえないものに焦がれるのは、もう止めようと微笑むように。"

#. Occurrence C_15:1676:17864: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0015; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:1676
msgctxt "text_id=17864 | speaker=soujuurou"
msgid "\"Yeah. Maybe I saw it in a dream."
msgstr "「そうだね。たぶん、幻を見ていたんだ。"

#. Occurrence C_15:1682:17865: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0016; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:1682
msgctxt "text_id=17865 | speaker=soujuurou"
msgid "  A dream where I was happy...\""
msgstr "　……あれは一度、幸福だった時の夢だった」"

#. Occurrence C_15:1688:17866: scene=C_15
#: C_15:1688
msgctxt "text_id=17866 | speaker=unknown"
msgid "  Severing the ties that bound him, Soujyuro turned his back away from the snowy clearing,"
msgstr "　尽きぬ名残を断ち切って、草十郎は雪原から目を背ける。"

#. Occurrence C_15:1693:17867: scene=C_15
#: C_15:1693
msgctxt "text_id=17867 | speaker=unknown"
msgid "  away from the unfamiliar yet familiar place where he had known happiness."
msgstr "　どこにも共通点のない、彼が一度だけ幸福だった野原から。"

#. Occurrence C_15:1746:17868: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0017; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:1746
msgctxt "text_id=17868 | speaker=soujuurou"
msgid "\"Let's get back. I'm tired, and Aozaki's heavy."
msgstr "「さ、早く帰ろう。蒼崎は重いし、体も疲れてる。"

#. Occurrence C_15:1752:17869: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0018; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:1752
msgctxt "text_id=17869 | speaker=soujuurou"
msgid "  How about we have a warm cup of tea once we're back at the mansion, Alice?\""
msgstr "　洋館についたらあったかいお茶を淹れよう、有珠」"

#. Occurrence C_15:1772:17870: scene=C_15
#: C_15:1772
msgctxt "text_id=17870 | speaker=unknown"
msgid "  Soujyuro spoke her name with a smile."
msgstr "　鮮やかな笑顔をうかべて、草十郎は少女の名を呼びかけた。"

#. Occurrence C_15:1777:17871: scene=C_15
#: C_15:1777
msgctxt "text_id=17871 | speaker=unknown"
msgid "  Her heart skipped a beat."
msgstr "　それに一瞬だけ有珠は息を止めてしまう。"

#. Occurrence C_15:1782:17872: scene=C_15
#: C_15:1782
msgctxt "text_id=17872 | speaker=unknown"
msgid "  Since when did he start saying her name so casually like that?"
msgstr "　こんな風に、あんまりにも自然に名を呼ばれたのはいつ以来だろう。"

#. Occurrence C_15:1787:17873: scene=C_15
#: C_15:1787
msgctxt "text_id=17873 | speaker=unknown"
msgid "  Somehow she managed a nod, before beginning to walk again."
msgstr "　なんとか頷き返す有珠と、歩きだす草十郎。"

#. Occurrence C_15:1792:17874: scene=C_15
#: C_15:1792
msgctxt "text_id=17874 | speaker=unknown"
msgid "  As he moved away from her, she asked a small question to his back."
msgstr "　その背中に、有珠はちょっとした疑問を投げかけてみた。"

#. Occurrence C_15:1813:17875: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0015; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:1813
msgctxt "text_id=17875 | speaker=alice"
msgid "\"Is she heavier than me...?\""
msgstr "「……重いって、わたしより？」"

#. Occurrence C_15:1847:17876: scene=C_15
#: C_15:1847
msgctxt "text_id=17876 | speaker=unknown"
msgid "  Aoko was a bit taller than Alice,"
msgstr "　……青子と有珠では身長差がある。"

#. Occurrence C_15:1852:17877: scene=C_15
#: C_15:1852
msgctxt "text_id=17877 | speaker=unknown"
msgid "  so naturally she would weigh more, but Alice wanted to hear him say it anyway."
msgstr "　有珠の方が軽いのは当たり前のコトだろうけど、その答えを、少女は彼の口から聞いてみたかったのかも知れない。"

#. Occurrence C_15:1857:17878: scene=C_15
#: C_15:1857
msgctxt "text_id=17878 | speaker=unknown"
msgid "  Not one to disappoint, Soujyuro answered without missing a beat."
msgstr "　そんな有珠の期待にそうように、草十郎はきっぱりと口にした。"

#. Occurrence C_15:1884:17879: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0019; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:1884
msgctxt "text_id=17879 | speaker=soujuurou"
msgid "\"Definitely. By about... twenty pounds.\""
msgstr "「ああ。数値的に言うのなら、有珠より十キロ増しぐらい」"

#. Occurrence C_15:1890:17880: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0016; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:1890
msgctxt "text_id=17880 | speaker=alice"
msgid "\"You do realize if Aoko knew you'd said that, she'd kill you.\""
msgstr "「そう。青子が聞いてたら大変ね」"

#. Occurrence C_15:1907:17881: scene=C_15
#: C_15:1907
msgctxt "text_id=17881 | speaker=unknown"
msgid "  Judging by Alice's tone, she was probably going to tell Aoko later."
msgstr "　それは、後で青子に告げ口をしよう、という悪戯心を思わせる口調だった。"

#. Occurrence C_15:1928:17882: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0020; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:1928
msgctxt "text_id=17882 | speaker=soujuurou"
msgid "\"You're kinda mean, Alice."
msgstr "「……意地が悪いな、有珠も。"

#. Occurrence C_15:1935:17883: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0021; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:1935
msgctxt "text_id=17883 | speaker=soujuurou"
msgid "Y'know, I did round down, too, just to be nice.\""
msgstr "それに、さっきのは本人の名誉のために四捨五入してたんだぞ、いちおう」"

#. Occurrence C_15:1965:17884: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_15_0017; voice_prefix=A40; voice_category=2; scene=C_15
#: C_15:1965
msgctxt "text_id=17884 | speaker=alice"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence C_15:1971:17885: scene=C_15
#: C_15:1971
msgctxt "text_id=17885 | speaker=unknown"
msgid "  His attempts at being kind had likely drawn him closer to his deathbed."
msgstr "　弁解どころか、青子が本気で怒りかねない事実だった。"

#. Occurrence C_15:1992:17886: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0022; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:1992
msgctxt "text_id=17886 | speaker=soujuurou"
msgid "\"...No good, huh?\""
msgstr "「…………ダメかな？」"

#. Occurrence C_15:2035:17887: scene=C_15
#: C_15:2035
msgctxt "text_id=17887 | speaker=unknown"
msgid "  He asked nervously."
msgstr "　困った顔で有珠の様子をうかがう草十郎。"

#. Occurrence C_15:2040:17888: scene=C_15
#: C_15:2040
msgctxt "text_id=17888 | speaker=unknown"
msgid "  Alice could not help but crack a smile at his innocence."
msgstr "　その仕草は妙に温かで、有珠はつい、<緩|ゆる>んだ頬をかすかな笑顔に変えてしまった。"

#. Occurrence C_15:2065:17889: scene=C_15
#: C_15:2065
msgctxt "text_id=17889 | speaker=unknown"
msgid "  However, she was not used to smiling in front of others, so she turned away and walked into the woods."
msgstr "　人前で笑う事に慣れていないためか、有珠は顔を背けて森へと歩きだした。"

#. Occurrence C_15:2070:17890: scene=C_15
#: C_15:2070
msgctxt "text_id=17890 | speaker=unknown"
msgid "  From Soujyuro's perspective, she was storming off in a mood."
msgstr "　そんな有珠の後ろ姿を見ながら、草十郎は相変わらず見当違いの感想を口にする。"

#. Occurrence C_15:2111:17891: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0023; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:2111
msgctxt "text_id=17891 | speaker=soujuurou"
msgid "\"...What?"
msgstr "「―――なんだ。"

#. Occurrence C_15:2118:17892: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_15_0024; voice_prefix=A30; voice_category=3; scene=C_15
#: C_15:2118
msgctxt "text_id=17892 | speaker=soujuurou"
msgid "She must really care if she's mad at me for saying that about you, right, Aozaki?\""
msgstr "友達の悪口で怒るなんて、やっぱり仲はいいんじゃないか、蒼崎」"

#. Occurrence C_15:2128:17893: scene=C_15
#: C_15:2128
msgctxt "text_id=17893 | speaker=unknown"
msgid "  Soujyuro rushed to catch up with Alice, gently carrying Aoko along the way."
msgstr "　青子を抱いたまま呟いて、草十郎はしずしずと有珠の後を追っていった。"

#. Occurrence C_15:2179:17894: scene=C_15
#: C_15:2179
msgctxt "text_id=17894 | speaker=unknown"
msgid "  Though the prince lacked the courage to kiss the sleeping princess, he had at least saved her, and was bringing her back to her castle."
msgstr "　森の中、眠り姫に口づけする勇気もなく、助けただけでお城に帰還しようとする若い騎士。"

#. Occurrence C_15:2185:17895: scene=C_15
#: C_15:2185
msgctxt "text_id=17895 | speaker=unknown"
msgid "  Despite what he had been through, he did not look like your typical hero. Still, in this story at least, he most certainly was."
msgstr "　十分な活躍はした筈なのに格好がつかない彼は、そんな物語の主人公を思わせた。"

#. Occurrence C_2:68:17896: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0000; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:68
msgctxt "text_id=17896 | speaker=touko"
msgid "\"Now you see."
msgstr "「と、まあこういう訳だ。"

#. Occurrence C_2:74:17897: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0001; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:74
msgctxt "text_id=17897 | speaker=touko"
msgid "  I don't need to rely on just Beo.\""
msgstr "　ベオだけに頼ってはいない事がよく分かったろう」"

#. Occurrence C_2:80:17898: scene=C_2
#: C_2:80
msgctxt "text_id=17898 | speaker=unknown"
msgid "  Touko's expression was steely. Victory was in her grasp, and there was no room to rest on her laurels."
msgstr "　表情は冷淡なまま。勝利は<揺|ゆ>るぎないものとなったのに、橙子には喜びの笑みもない。"

#. Occurrence C_2:129:17899: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0002; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:129
msgctxt "text_id=17899 | speaker=touko"
msgid "\"So it was the mirror that concealed you?"
msgstr "「姿を隠したのは鏡の応用か。"

#. Occurrence C_2:135:17900: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0003; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:135
msgctxt "text_id=17900 | speaker=touko"
msgid "  ...You used it to detect, capture, and act as backup. Impressive."
msgstr "　……探知や隔離だけでなく、援護まで行えるとはね。"

#. Occurrence C_2:141:17901: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0004; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:141
msgctxt "text_id=17901 | speaker=touko"
msgid "  Not quite one of the Great Three, but a very versatile, and, might I add, exceptional Ploy.\""
msgstr "　三大のプロイには含まれないものの、汎用性の面で言えばアレも破格のプロイだな」"

#. Occurrence C_2:166:17902: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0000; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:166
msgctxt "text_id=17902 | speaker=aoko"
msgid "\"Quit patronizing us. You're just upset you got duped.\""
msgstr "「……持ち上げるじゃない。なに、騙された負けおしみ？」"

#. Occurrence C_2:218:17903: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0005; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:218
msgctxt "text_id=17903 | speaker=touko"
msgid "\"Not at all. I'm just giving credit where credit's due."
msgstr "「いや、ただの自画自賛だよ。"

#. Occurrence C_2:224:17904: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0006; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:224
msgctxt "text_id=17904 | speaker=touko"
msgid "  It was me who worked with Meinster on the thing in the first place. I'm just kind of annoyed that someone got carried away and couldn't help but add functions to it.\""
msgstr "　なにしろ今の<鏡|バージョン>は私とマインスターの合作だ。趣味に興じすぎてあれこれと機能を足してしまったと、今更ながら悔いているところさ」"

#. Occurrence C_2:250:17905: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0007; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:250
msgctxt "text_id=17905 | speaker=touko"
msgid "\"And then the little robin, coming at me disguised as you... You used it to distract me with it while you charged up your huge attack."
msgstr "「その後、青子に見せかけて私に向かってきたのは例の駒鳥。それに気を取られている間の大規模な魔術の発動。"

#. Occurrence C_2:261:17906: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0008; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:261
msgctxt "text_id=17906 | speaker=touko"
msgid "  Alice avoided my Mystic Eyes while you focused on offense. Not a bad plan. Y'know, all in all, you did pretty well.\""
msgstr "　私の魔眼は有珠が防ぎ、青子は攻撃だけに専念する……組み立ては悪くはない。よくやったと言っておくよ」"

#. Occurrence C_2:310:17907: scene=C_2
#: C_2:310
msgctxt "text_id=17907 | speaker=unknown"
msgid "  Touko recounted their strategy, sharing her impressions as she went."
msgstr "　一連の攻防を顧みて、所感を述べる橙子。"

#. Occurrence C_2:315:17908: scene=C_2
#: C_2:315
msgctxt "text_id=17908 | speaker=unknown"
msgid "  Aoko could not take her eyes off Touko's blooming Magic Crests."
msgstr "　青子は橙子の背後に咲いた魔術刻印に気を取られている。"

#. Occurrence C_2:320:17909: scene=C_2
#: C_2:320
msgctxt "text_id=17909 | speaker=unknown"
msgid "  Only Alice was paying close attention to Touko's words."
msgstr "　有珠だけが、橙子の言動を正確に把握していた。"

#. Occurrence C_2:361:17910: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0009; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:361
msgctxt "text_id=17910 | speaker=touko"
msgid "\"Well, I'm afraid this is the end of the line."
msgstr "「しかし、それもここまでだ。"

#. Occurrence C_2:367:17911: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0010; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:367
msgctxt "text_id=17911 | speaker=touko"
msgid "  It's such a shame, Aoko. I can't believe you're still using such magecraft after two years. You could've become a world-class marksman.\""
msgstr "　惜しいな青子。わずか二年であれだけの魔術を使えるのなら、あと数年もすれば一流の<射手|しゃしゅ>になっていただろうに」"

#. Occurrence C_2:377:17912: scene=C_2
#: C_2:377
msgctxt "text_id=17912 | speaker=unknown"
msgid "  Touko snapped her fingers again."
msgstr "　橙子は再度指を鳴らす。"

#. Occurrence C_2:382:17913: scene=C_2
#: C_2:382
msgctxt "text_id=17913 | speaker=unknown"
msgid "  The floating crests began to glow more brightly."
msgstr "　中空に浮かぶ刻印に、さらなる光が灯っていく―――"

#. Occurrence C_2:425:17914: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0001; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:425
msgctxt "text_id=17914 | speaker=aoko"
msgid "\"...Alice. What are those?\""
msgstr "“……有珠。アレは何？”"

#. Occurrence C_2:431:17915: scene=C_2
#: C_2:431
msgctxt "text_id=17915 | speaker=unknown"
msgid "  Aoko whispered to Alice standing next to her as she held her hand."
msgstr "　傍らの有珠の手に触れて、青子は呼びかけた。"

#. Occurrence C_2:436:17916: scene=C_2
#: C_2:436
msgctxt "text_id=17916 | speaker=unknown"
msgid "  She could not risk turning around."
msgstr "　青子は振り返る事さえできない。"

#. Occurrence C_2:441:17917: scene=C_2
#: C_2:441
msgctxt "text_id=17917 | speaker=unknown"
msgid "  The second she took her eye off of Touko, the fight would be over."
msgstr "　橙子から目を離した瞬間、この戦いが終わる事を肌で感じているからだ。"

#. Occurrence C_2:468:17918: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_2_0000; voice_prefix=A40; voice_category=2; scene=C_2
#: C_2:468
msgctxt "text_id=17918 | speaker=alice"
msgid "\"As you can see, they're Magic Crests... as hard as it is to believe.\""
msgstr "「見ての通り、魔術刻印よ。……信じられないけど」"

#. Occurrence C_2:474:17919: scene=C_2
#: C_2:474
msgctxt "text_id=17919 | speaker=unknown"
msgid "  Alice's voice was filled with shock and discomfort."
msgstr "　有珠の声には、驚きと、不快感がこめられていた。"

#. Occurrence C_2:479:17920: scene=C_2
#: C_2:479
msgctxt "text_id=17920 | speaker=unknown"
msgid "  Aoko shared Alice's sentiment."
msgstr "　その気持ちは青子にも理解できる。"

#. Occurrence C_2:484:17921: scene=C_2
#: C_2:484
msgctxt "text_id=17921 | speaker=unknown"
msgid "  Magic Crests were passed down through a family line and took unique forms. At heart, they were merely personalized inscriptions, and technically no different from grimoires. However, the reality was far different."
msgstr "　そもそも、魔術刻印とは各々の家系が独特の形で伝える物だ。文字である事から魔道書と同一に思われるが、その実態は大きく異なる。"

#. Occurrence C_2:530:17922: scene=C_2
#: C_2:530
msgctxt "text_id=17922 | speaker=unknown"
msgid "  Magecraft had no set form."
msgstr "　魔術には形がない。"

#. Occurrence C_2:535:17923: scene=C_2
#: C_2:535
msgctxt "text_id=17923 | speaker=unknown"
msgid "  Without a set shape, the ability to recreate Mystics was itself flawed."
msgstr "　実像がなく、再現性さえ不確かだ。"

#. Occurrence C_2:544:17924: scene=C_2
#: C_2:544
msgctxt "text_id=17924 | speaker=unknown"
msgid "  To craft it into a form required an immeasurable investment of time and devotion."
msgstr "　ソレを明確な形にしようと、莫大な時間、心血を削る技術をかけたもの―――"

#. Occurrence C_2:550:17925: scene=C_2
#: C_2:550
msgctxt "text_id=17925 | speaker=unknown"
msgid "Magic Crests were the crystallization of a family's desires and ambitions, and proof of a successor's lineage."
msgstr "一族の悲願と希望の結晶が、各門派の後継者の証、魔術刻印なのである。"

#. Occurrence C_2:570:17926: scene=C_2
#: C_2:570
msgctxt "text_id=17926 | speaker=unknown"
msgid "  Crests had no effects on their own,"
msgstr "　そして、刻印は単体では効果を発揮しない。"

#. Occurrence C_2:575:17927: scene=C_2
#: C_2:575
msgctxt "text_id=17927 | speaker=unknown"
msgid "  but they were the ultimate symbol of a family."
msgstr "　一族の先端にいるモノ。"

#. Occurrence C_2:580:17928: scene=C_2
#: C_2:580
msgctxt "text_id=17928 | speaker=unknown"
msgid "  If no mage was willing to imbue themselves with a crest, or lacked the resolve to merge with it, then the crest's meaning was lost."
msgstr "　刻印を身に宿し、いずれ自身も刻印の一部になる事を覚悟した魔術師がいなければ、そもそも意味を見失う。"

#. Occurrence C_2:601:17929: scene=C_2
#: C_2:601
msgctxt "text_id=17929 | speaker=unknown"
msgid "  That was the key difference between a crest and a mere spellbook."
msgstr "　魔道書との最大の違いはそこだ。"

#. Occurrence C_2:606:17930: scene=C_2
#: C_2:606
msgctxt "text_id=17930 | speaker=unknown"
msgid "  Crests could not be shared, and imitating them was pointless."
msgstr "　刻印は写本した所で意味はないし、分け与える事もできない。"

#. Occurrence C_2:611:17931: scene=C_2
#: C_2:611
msgctxt "text_id=17931 | speaker=unknown"
msgid "  It only stood to reason, then,"
msgstr "　故に。"

#. Occurrence C_2:616:17932: scene=C_2
#: C_2:616
msgctxt "text_id=17932 | speaker=unknown"
msgid "  that even if the crests manifesting behind Touko belonged to someone else, only the original owner could benefit from them."
msgstr "　橙子の背後に出現している刻印が他人の写しだとしても、本来の持ち主にしか<恩恵|おんけい>はないのだが―――"

#. Occurrence C_2:769:17933: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0002; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:769
msgctxt "text_id=17933 | speaker=aoko"
msgid "\"Those crests have to be what's deflecting my magic bullets. Don't tell me, she's...\""
msgstr "“でも、たしかに私の魔弾はあの刻印からの魔術で<弾|はじ>かれた。……あれは、もしかすると”"

#. Occurrence C_2:775:17934: scene=C_2
#: C_2:775
msgctxt "text_id=17934 | speaker=unknown"
msgid "  Searching for answers, Aoko squinted her eyes as she glared at Touko."
msgstr "　見えない物を必死に見るように、青子は目を細めて橙子を見つめる。"

#. Occurrence C_2:780:17935: scene=C_2
#: C_2:780
msgctxt "text_id=17935 | speaker=unknown"
msgid "  She knew that copying a crest had no purpose."
msgstr "　刻印をコピーしても意味はない。"

#. Occurrence C_2:785:17936: scene=C_2
#: C_2:785
msgctxt "text_id=17936 | speaker=unknown"
msgid "  Only the original inheritor could invoke one."
msgstr "　刻印は受け継いだ後継者でなければ発動できない。"

#. Occurrence C_2:790:17937: scene=C_2
#: C_2:790
msgctxt "text_id=17937 | speaker=unknown"
msgid "  There was only one possible conclusion."
msgstr "　―――なら、それは―――"

#. Occurrence C_2:875:17938: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_9000; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:875
msgctxt "text_id=17938 | speaker=aoko"
msgid "\"...I see."
msgstr "「……そう。"

#. Occurrence C_2:875:17939: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_9000; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:875
msgctxt "text_id=17939 | speaker=aoko"
msgid "  If they aren't inscribed on your skin and just floating in the air...\""
msgstr "　肌に刻まず中空に浮かべてるのは、そういう事……」"

#. Occurrence C_2:881:17940: scene=C_2
#: C_2:881
msgctxt "text_id=17940 | speaker=unknown"
msgid "  Aoko spat a curse at her sister."
msgstr "　不快だ、と吐き捨てる青子。"

#. Occurrence C_2:886:17941: scene=C_2
#: C_2:886
msgctxt "text_id=17941 | speaker=unknown"
msgid "  Touko nodded, pleased at her enemies' quick wit."
msgstr "　橙子は理解の早い敵に、満足してうなずいた。"

#. Occurrence C_2:939:17942: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0011; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:939
msgctxt "text_id=17942 | speaker=touko"
msgid "\"The crests didn't suit my body, so I fixed them to the space behind me."
msgstr "「ああ、この体には合わないのでな、私の背後の空間に固定している。"

#. Occurrence C_2:946:17943: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0012; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:946
msgctxt "text_id=17943 | speaker=touko"
msgid "Of course crests like yours that are engraved into the flesh are much better, because they can be activated in one go."
msgstr "本当はね、おまえたちのように肉に刻んだほうがいいんだ。魔術の起動が一動作で済むんだから。"

#. Occurrence C_2:952:17944: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0013; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:952
msgctxt "text_id=17944 | speaker=touko"
msgid "  For me, though, this was the only way.\""
msgstr "　だが実際に使用するのなら、こうするしかない」"

#. Occurrence C_2:979:17945: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0014; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:979
msgctxt "text_id=17945 | speaker=touko"
msgid "\"And while I do need to perform an extra step to activate them, they're not mine, so I don't feel any pain.\""
msgstr "「起動までの手順は一つ増えるが、なに、マイナスばかりでもない。所詮は他人事なんでね、<痛|・><み|・><は|・><ま|・><っ|・><た|・><く|・><感|・><じ|・><な|・><い|・>」"

#. Occurrence C_2:999:17946: scene=C_2
#: C_2:999
msgctxt "text_id=17946 | speaker=unknown"
msgid "  And it seemed neither physically, nor mentally."
msgstr "　それは肉体的なものであり、精神的なものだろう。"

#. Occurrence C_2:1029:17947: scene=C_2
#: C_2:1029
msgctxt "text_id=17947 | speaker=unknown"
msgid "  Aoko knew her sister was inhuman, but she never thought she would go this far."
msgstr "　青子とて姉の非人間性を知ってはいたが、ここまでのものとは予想していなかった。"

#. Occurrence C_2:1055:17948: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0003; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1055
msgctxt "text_id=17948 | speaker=aoko"
msgid "\"...Hmph. Well, you're right about them not suiting you. You stole them from someone else, so your bloodline can never match up."
msgstr "「……ふん、合うワケないじゃない。他人の魔術刻印を<剥|は>がしてるんだから、血筋の照合からして馴染むはずがないわ。"

#. Occurrence C_2:1066:17949: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0004; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1066
msgctxt "text_id=17949 | speaker=aoko"
msgid "  Which means..."
msgstr "　―――で。"

#. Occurrence C_2:1073:17950: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0005; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1073
msgctxt "text_id=17950 | speaker=aoko"
msgid "The person or persons you stole them from can't die, so you must be have them locked up somewhere. If they died, you couldn't activate their crests.\""
msgstr "奪われた連中は死ぬ事もできず、今もどこかに<幽閉|いかされ>ているワケだ。刻印の持ち主が死んだら起動すらできないものね、それ」"

#. Occurrence C_2:1150:17951: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_2_0002; voice_prefix=A40; voice_category=2; scene=C_2
#: C_2:1150
msgctxt "text_id=17951 | speaker=alice"
msgid "\"Touko, you...\" "
msgstr "「―――橙子さん、貴女―――」"

#. Occurrence C_2:1187:17952: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0015; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:1187
msgctxt "text_id=17952 | speaker=touko"
msgid "\"I don't remember anyone complaining."
msgstr "「非難される覚えはないんだが。"

#. Occurrence C_2:1194:17953: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0016; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:1194
msgctxt "text_id=17953 | speaker=touko"
msgid "They were asking for it. They should've been better prepared if they wanted to face me."
msgstr "私はかかる火の粉を払っただけだよ。向こうから戦いを挑んできたんだから、戦利品ぐらいは用意してもらわないと。"

#. Occurrence C_2:1205:17954: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0017; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:1205
msgctxt "text_id=17954 | speaker=touko"
msgid "  There were some rather rude fools who used questionable language."
msgstr "　まあ、中にはつまらない単語を口にした馬鹿者もいるが、それはそれだ。"

#. Occurrence C_2:1231:17955: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0018; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:1231
msgctxt "text_id=17955 | speaker=touko"
msgid "  But I think I've been quite kind really. They came to kill me, and I let them live.\""
msgstr "　むしろ優しいと思うけどね。私を殺しに来た連中を、わざわざ生かしてあげてるんだから」"

#. Occurrence C_2:1260:17956: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0006; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1260
msgctxt "text_id=17956 | speaker=aoko"
msgid "\"Really? As a fellow mage, I only hope they're okay.\""
msgstr "「は。その魔術師たちがちゃんと<人|・><間|・><の|・><カ|・><タ|・><チ|・>をしてる事を祈るわ、肉親として」"

#. Occurrence C_2:1333:17957: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0019; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:1333
msgctxt "text_id=17957 | speaker=touko"
msgid "\"You're probably wondering what I've done to them."
msgstr "「おまえね、私をなんだと思ってるんだ。"

#. Occurrence C_2:1380:17958: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0020; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:1380
msgctxt "text_id=17958 | speaker=touko"
msgid "  'Has she preserved their brains? Or maybe she's just lumped them all into a ball of flesh?' As if I'd do that!"
msgstr "　脳だけ保存とか、面倒だから百人ひとまとめにした肉塊とか、そんな手抜きなんぞするものか！"

#. Occurrence C_2:1386:17959: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0021; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:1386
msgctxt "text_id=17959 | speaker=touko"
msgid "  I built them a café, and provided plenty of food, entertainment, sleep, and freedom! Some of them even said they wanted to live like that forever!\""
msgstr "　きちんとカフェを用意して、食事も娯楽も睡眠も自由に提供してるんだぞ？　中には“一生ここで暮らしたい！”なんて騒ぎ立てる莫迦もいるぐらいだ！」"

#. Occurrence C_2:1469:17960: scene=C_2
#: C_2:1469
msgctxt "text_id=17960 | speaker=unknown"
msgid "  Touko's words were hardly believable, but it was clear her crests weren't copies."
msgstr "　……どこまで信じていいものか微妙な返答だったが、橙子の刻印がコピーではなく本物である事は真実だ。"

#. Occurrence C_2:1474:17961: scene=C_2
#: C_2:1474
msgctxt "text_id=17961 | speaker=unknown"
msgid "  Alice's scowl deepened."
msgstr "　有珠はますます眉をひそめる。"

#. Occurrence C_2:1479:17962: scene=C_2
#: C_2:1479
msgctxt "text_id=17962 | speaker=unknown"
msgid "  What Touko had described had no discernible benefit in her mind."
msgstr "　なぜなら、その行為自体にあまり意味がない。"

#. Occurrence C_2:1484:17963: scene=C_2
#: C_2:1484
msgctxt "text_id=17963 | speaker=unknown"
msgid "  Why had she gone to the trouble of stealing other mages' crests?"
msgstr "　他者の刻印を奪い、自分用に加工するのはたいへんな手間だったろう。"

#. Occurrence C_2:1530:17964: scene=C_2
#: C_2:1530
msgctxt "text_id=17964 | speaker=unknown"
msgid "  It would have been more efficient to break down the crests into components and make replicas."
msgstr "　そんな事をしている時間があるなら、刻印を材料にして模造品を造った方がはるかに効率がいい。"

#. Occurrence C_2:1535:17965: scene=C_2
#: C_2:1535
msgctxt "text_id=17965 | speaker=unknown"
msgid "  For a skilled puppet master like Touko, she could have made a much more powerful puppet with those crests."
msgstr "　他の魔術師ならいざ知らず、卓越した人形師である橙子なら、刻印を利用してより強力な人形を造れただろう。"

#. Occurrence C_2:1540:17966: scene=C_2
#: C_2:1540
msgctxt "text_id=17966 | speaker=unknown"
msgid "  It would have made a pawn loyal to her every command at that, much more useful than any enslaved mage."
msgstr "　刻印の持ち主である魔術師以上の、自分の命令通りに動く人形を。"

#. Occurrence C_2:1585:17967: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_2_9000; voice_prefix=A40; voice_category=2; scene=C_2
#: C_2:1585
msgctxt "text_id=17967 | speaker=alice"
msgid "\"...Why, Touko?\""
msgstr "「……なんで、そんな事を」"

#. Occurrence C_2:1607:17968: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0007; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1607
msgctxt "text_id=17968 | speaker=aoko"
msgid "\"That's Touko for you. Once she decides to do something, that's it. Everything's a means to an end."
msgstr "「そういう人なのよ、姉貴は。これで行く、と決めたらそれしか目に入らない人なの。過程より結果の人なの。"

#. Occurrence C_2:1622:17969: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0008; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1622
msgctxt "text_id=17969 | speaker=aoko"
msgid "  ...Listen to this: one time, we were watching TV and a pizza commercial came on. We both *really* wanted to eat something greasy."
msgstr "　……ある日の話よ。テレビでピザのＣＭをやっててさ、私たちは唐突にあのデブ<食|しょく>を食べたくなった。"

#. Occurrence C_2:1629:17970: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0009; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1629
msgctxt "text_id=17970 | speaker=aoko"
msgid "Unfortunately, our super-boring family only had the pepperoni.\""
msgstr "でも悲しいかな、一般家庭であるうちにあったのはサラミだけ」"

#. Occurrence C_2:1657:17971: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0010; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1657
msgctxt "text_id=17971 | speaker=aoko"
msgid "\"You know my house was on the top of a big hill, right?"
msgstr "「うちの実家、山奥にあるの知ってるでしょ？"

#. Occurrence C_2:1663:17972: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0011; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1663
msgctxt "text_id=17972 | speaker=aoko"
msgid "  Getting to the city took an hour. But I just had to have that pizza, so I walked it. Could I find a pizza place? Nope! So I walked home empty-handed.\""
msgstr "　町まで行くのに一時間はかかる。中学一年だった私は我慢できなくて町まで行ったけど、ピザ屋なんか一軒もなくてとぼとぼ帰ったの」"

#. Occurrence C_2:1691:17973: scene=C_2
#: C_2:1691
msgctxt "text_id=17973 | speaker=unknown"
msgid "  It was the tragedy of living in the countryside."
msgstr "　田舎町の悲劇だった。"

#. Occurrence C_2:1696:17974: scene=C_2
#: C_2:1696
msgctxt "text_id=17974 | speaker=unknown"
msgid "  Misaki, which had only recently gotten a conveyor belt sushi restaurant, would not see a pizzeria for another two years."
msgstr "　回転寿司がようやくできた三咲町において、ピザ屋の台頭はあと二年待たねばならない。"

#. Occurrence C_2:1782:17975: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0012; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1782
msgctxt "text_id=17975 | speaker=aoko"
msgid "\"Then when I got home, hungry and tired..."
msgstr "「なのに。"

#. Occurrence C_2:1789:17976: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0013; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1789
msgctxt "text_id=17976 | speaker=aoko"
msgid "my damn sister waved at me, all 'Welcome back!' with a big slice of pizza hanging out of her stupid face!"
msgstr "骨折り損で家に帰ったら、姉貴のヤツ、おかえりー、とか手を振ってピザ食べてやがったのよ……！"

#. Occurrence C_2:1795:17977: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0014; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1795
msgctxt "text_id=17977 | speaker=aoko"
msgid "  She was like, 'I tried using rice crackers as a base.'"
msgstr "　お<煎餅|せんべい>を下地にしてみたわー、とか言って。"

#. Occurrence C_2:1801:17978: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0015; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1801
msgctxt "text_id=17978 | speaker=aoko"
msgid "  When I looked outside, three chickens and one cow were gone. That's when I realized she had no concept of the value of money, hard work, or fairness!\""
msgstr "　外みたら鶏三羽と牛一頭まるまる消えてて、ああ、この女には等価交換とか手間とかお金の問題とか、そういうの一切頭にないんだって思い知らされたわ！」"

#. Occurrence C_2:1848:17979: scene=C_2
#: C_2:1848
msgctxt "text_id=17979 | speaker=unknown"
msgid "  Alice agreed that was pretty crazy."
msgstr "　それはそれで凄い事だと思う有珠であった。"

#. Occurrence C_2:1921:17980: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0016; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1921
msgctxt "text_id=17980 | speaker=aoko"
msgid "\"Stupid crap like that means I'm perfectly fine with putting a hole through her chest with a Gandr Shot."
msgstr "「そんな無茶な奴だから、ガンド撃ちで目に見える傷跡を出そうなんて、平気で考えるのよね。"

#. Occurrence C_2:1927:17981: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_2_0017; voice_prefix=A10; voice_category=1; scene=C_2
#: C_2:1927
msgctxt "text_id=17981 | speaker=aoko"
msgid "  I mean she could've just chanted a single verse from the Gematria to get the same effect, but nooo, she was so obsessed with curses she made a puppet that couldn't even fly!\""
msgstr "　あんなの、ゲマトリア一節分の詠唱で同じ効果を出せるのに、あくまで呪術にこだわるから空も飛べない人形になるのよ、バカ姉貴っ！」"

#. Occurrence C_2:1980:17982: scene=C_2
#: C_2:1980
msgctxt "text_id=17982 | speaker=unknown"
msgid "  The thought of the puppet doppelgänger made her blood boil."
msgstr "　自分そっくりに造られた人形を思いだし、ここぞとばかりに怒鳴る青子。"

#. Occurrence C_2:1985:17983: scene=C_2
#: C_2:1985
msgctxt "text_id=17983 | speaker=unknown"
msgid "  It was clear to Aoko now that Touko had done it on purpose to annoy her."
msgstr "　今にして思えば、あれは彼女への痛烈な嫌味だったからだ。"

#. Occurrence C_2:2004:17984: scene=C_2
#: C_2:2004
msgctxt "text_id=17984 | speaker=unknown"
msgid "  Touko furrowed her eyebrows at Aoko's verbal assault."
msgstr "　青子の<罵倒|ばとう>に、橙子の細い眉が微かに動く。"

#. Occurrence C_2:2009:17985: scene=C_2
#: C_2:2009
msgctxt "text_id=17985 | speaker=unknown"
msgid "  She had been stoic up until now, but speaking rudely about her prized puppet was crossing the line."
msgstr "　今まで表情のなかった橙子だが、自慢の人形をけなされて気分をいたく害したらしい。"

#. Occurrence C_2:2044:17986: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0023; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:2044
msgctxt "text_id=17986 | speaker=touko"
msgid "\"If I recall, that puppet had you on the ropes."
msgstr "「……その人形に追い詰められたのはおまえだったね。"

#. Occurrence C_2:2050:17987: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0024; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:2050
msgctxt "text_id=17987 | speaker=touko"
msgid "  And for your information, Gematria numerology is a Kabbalah secret. I'm a rune specialist, so I don't need to learn anything and everything like you do."
msgstr "　それと、数<値変換|ゲマトリア>式はカバラの秘術だ。私はルーン専門だから、おまえのように広く浅く知識を広める気はないよ。"

#. Occurrence C_2:2088:17988: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0025; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:2088
msgctxt "text_id=17988 | speaker=touko"
msgid "  ...Well, I did learn something."
msgstr "　―――まあ、もっとも。"

#. Occurrence C_2:2095:17989: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0026; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:2095
msgctxt "text_id=17989 | speaker=touko"
msgid "One owner of these crests taught me about Celtic Bounded Fields.\""
msgstr "この刻印の所有者の一人から、ケルトの結界を教わりはしたがね」"

#. Occurrence C_2:2115:17990: scene=C_2
#: C_2:2115
msgctxt "text_id=17990 | speaker=unknown"
msgid "  Touko looked to the crest over her left shoulder."
msgstr "　橙子は左後方の刻印に視線を向ける。"

#. Occurrence C_2:2120:17991: scene=C_2
#: C_2:2120
msgctxt "text_id=17991 | speaker=unknown"
msgid "  Its shine was ever-radiant,"
msgstr "　こうしている今も光り輝いている刻印。"

#. Occurrence C_2:2125:17992: scene=C_2
#: C_2:2125
msgctxt "text_id=17992 | speaker=unknown"
msgid "  proving that its magecraft was active."
msgstr "　それは、たえず何らかの魔術を行使している証だ。"

#. Occurrence C_2:2184:17993: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0027; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:2184
msgctxt "text_id=17993 | speaker=touko"
msgid "\"I used this 'castle' to seal away Grandfather."
msgstr "「これは『城』で祖父を封じこめるのに使っていてね。"

#. Occurrence C_2:2190:17994: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0028; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:2190
msgctxt "text_id=17994 | speaker=touko"
msgid "  I trapped that half-yokai druid-monk in a tower. Well, I say 'tower,' but it's closer to a mailbox in size."
msgstr "　半人半妖のドルイド僧を閉じこめた塔……とまではいかないが―――そうだな、私では郵便ポストぐらいの大きさが限界か。"

#. Occurrence C_2:2202:17995: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0029; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:2202
msgctxt "text_id=17995 | speaker=touko"
msgid "  Like that red mailbox you broke, remember? About that big, but it's a cute little birdcage."
msgstr "　ほら、むかし<青子|おまえ>が壊した赤いポスト。ちょうどあれぐらいの可愛い鳥小屋だよ。"

#. Occurrence C_2:2209:17996: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0030; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:2209
msgctxt "text_id=17996 | speaker=touko"
msgid "A bit cramped for one person, but Grandfather's more spirit than body, so I guess it's more appropriate for him anyway.\""
msgstr "人間ひとり分を仕舞うには窮屈だろうが、祖父は肉体というより霊体に近い。見様によっては、そっちの方が相応しいかもしれないね」"

#. Occurrence C_2:2234:17997: scene=C_2
#: C_2:2234
msgctxt "text_id=17997 | speaker=unknown"
msgid "  Touko stifled a sinister laugh, her explanation chilling."
msgstr "　<陰鬱|いんうつ>な笑いをかみ殺しながら、橙子は淡々と説明する。"

#. Occurrence C_2:2239:17998: scene=C_2
#: C_2:2239
msgctxt "text_id=17998 | speaker=unknown"
msgid "  Her cold veneer seemed to slip slightly when it came to her grandfather,"
msgstr "　常に冷静な彼女だが、祖父に対しては感情を<抑|おさ>えきれないらしい。"

#. Occurrence C_2:2273:17999: scene=C_2
#: C_2:2273
msgctxt "text_id=17999 | speaker=unknown"
msgid "  her smile betraying the long festering hatred she still clung to."
msgstr "　それが<鬱積|うっせき>した憎悪である事は、彼女の笑みを見れば明らかだった。"

#. Occurrence C_2:2294:18000: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0031; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:2294
msgctxt "text_id=18000 | speaker=touko"
msgid "\"Anyway, because I blocked your attack, I can't use this crest for a while."
msgstr "「そういった訳でね、先の青子の魔術を防いだので、この刻印もしばらくは使用不能なんだ。"

#. Occurrence C_2:2332:18001: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0032; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:2332
msgctxt "text_id=18001 | speaker=touko"
msgid "  Though, if you'd used True Magic, a three-line crest wouldn't have countered it. You only lost by a slight margin, Aoko. You should be proud."
msgstr "　今のが本当の魔法だったなら、わずか三行の刻印では打ち消せなかっただろうに。青子。おまえは<僅差|きんさ>で負けたんだ。恥じる事はないよ。"

#. Occurrence C_2:2344:18002: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0033; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:2344
msgctxt "text_id=18002 | speaker=touko"
msgid "  Right then, let's wrap this up."
msgstr "　じゃあそろそろ終わりにしよう。"

#. Occurrence C_2:2350:18003: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_2_0034; voice_prefix=A20; voice_category=11; scene=C_2
#: C_2:2350
msgctxt "text_id=18003 | speaker=touko"
msgid "  Feel free to fight back, but remember you're against Beo.\""
msgstr "　抵抗をするのは自由だが、ベオ相手にそれは辛いぞ」"

#. Occurrence C_2:2411:18004: scene=C_2
#: C_2:2411
msgctxt "text_id=18004 | speaker=unknown"
msgid "  Touko snapped her fingers one more time."
msgstr "　ぱちん、と橙子の左手が鳴る。"

#. Occurrence C_2:2416:18005: scene=C_2
#: C_2:2416
msgctxt "text_id=18005 | speaker=unknown"
msgid "  The golden werewolf was hiding in the old school building."
msgstr "　旧校舎に<潜|ひそ>む黄金の人狼。"

#. Occurrence C_2:2421:18006: scene=C_2
#: C_2:2421
msgctxt "text_id=18006 | speaker=unknown"
msgid "  The signal to him echoed eerily through the surrounding woods."
msgstr "　彼を呼び出す合図は、森に<木霊|こだま>するように長く響いた。"

#. Occurrence C_2:2426:18007: scene=C_2
#: C_2:2426
msgctxt "text_id=18007 | speaker=unknown"
msgid "  Before the echo stopped, Aoko shouted back at Alice."
msgstr "　その残響が消えるより早く、青子は背後にいる有珠へ叫ぶ。"

#. Occurrence C_3:39:18008: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0000; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:39
msgctxt "text_id=18008 | speaker=aoko"
msgid "\"Alice, go!\""
msgstr "「行って、有珠！」"

#. Occurrence C_3:84:18009: scene=C_3
#: C_3:84
msgctxt "text_id=18009 | speaker=unknown"
msgid "  The order sounded like a reprimand, but Alice silently obeyed."
msgstr "　<叱咤|しった>に近い指示に、有珠は無言で従った。"

#. Occurrence C_3:89:18010: scene=C_3
#: C_3:89
msgctxt "text_id=18010 | speaker=unknown"
msgid "  Without hesitation, she left Aoko behind to handle Touko, and made for the forest."
msgstr "　橙子と対峙する青子を残し、有珠はためらう事なく森へと<踵|きびす>を返す。"

#. Occurrence C_3:109:18011: scene=C_3
#: C_3:109
msgctxt "text_id=18011 | speaker=unknown"
msgid "  ...If defeat was inevitable, it would be pointless for both of them to die."
msgstr "　……敗北が決定的になった以上、ふたり一緒に殺される愚だけは犯せない。"

#. Occurrence C_3:114:18012: scene=C_3
#: C_3:114
msgctxt "text_id=18012 | speaker=unknown"
msgid "  If one of them could survive, there could be a round three."
msgstr "　どちらかが生き延びれば三度目の正直もある。"

#. Occurrence C_3:119:18013: scene=C_3
#: C_3:119
msgctxt "text_id=18013 | speaker=unknown"
msgid "  That was why Aoko decided to be the sacrificial pawn."
msgstr "　その為に犠牲になるのは自分の役割だと青子は判断したのだ。"

#. Occurrence C_3:180:18014: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0001; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:180
msgctxt "text_id=18014 | speaker=aoko"
msgid "\"Now we know what Touko's trump card is, if Alice can get back to normal, she'll stand a chance...\""
msgstr "『……橙子自身の切札も分かったし、有珠が本調子になれば勝てない相手じゃないものね……』"

#. Occurrence C_3:188:18015: scene=C_3
#: C_3:188
msgctxt "text_id=18015 | speaker=unknown"
msgid "  Aoko muttered bitterly to herself as Alice's feet crunched through the snow."
msgstr "　走り去る有珠の足音を聞きながら、青子は少しだけ残念そうに呟いた。"

#. Occurrence C_3:193:18016: scene=C_3
#: C_3:193
msgctxt "text_id=18016 | speaker=unknown"
msgid "  Instead of cursing her own death, she cursed the fact she would not see Alice defeat Touko."
msgstr "　……惜しいのは自分の死ではなく、有珠が橙子を打ち負かす瞬間が見られない事だけ。"

#. Occurrence C_3:198:18017: scene=C_3
#: C_3:198
msgctxt "text_id=18017 | speaker=unknown"
msgid "  For what else was there to curse except this."
msgstr "　それ以外に何を無念に思う事があるだろうか。"

#. Occurrence C_3:218:18018: scene=C_3
#: C_3:218
msgctxt "text_id=18018 | speaker=unknown"
msgid "  Alice disappeared into the forest."
msgstr "　有珠が森へと消えていく。"

#. Occurrence C_3:223:18019: scene=C_3
#: C_3:223
msgctxt "text_id=18019 | speaker=unknown"
msgid "  Feeling her fellow mage's presence fade, Aoko continued to glare at her sister."
msgstr "　それを背中で感じながら、青子は橙子を睨み続ける。"

#. Occurrence C_3:254:18020: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0002; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:254
msgctxt "text_id=18020 | speaker=aoko"
msgid "\"...How long do you plan to drag this out?"
msgstr "「……いつまで焦らす気？"

#. Occurrence C_3:254:18021: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0002; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:254
msgctxt "text_id=18021 | speaker=aoko"
msgid "  You know I hate it when people make me wait.\""
msgstr "　私、待たされるのは好きじゃないんだけど」"

#. Occurrence C_3:272:18022: scene=C_3
#: C_3:272
msgctxt "text_id=18022 | speaker=unknown"
msgid "  Speaking of waiting, the werewolf Touko had called was nowhere to be seen."
msgstr "　合図はされたものの、人狼の姿はない。"

#. Occurrence C_3:277:18023: scene=C_3
#: C_3:277
msgctxt "text_id=18023 | speaker=unknown"
msgid "  It should not have taken him more than a few seconds to come flying out of the old school building."
msgstr "　あの怪物なら一分とかからず、旧校舎から飛んでくるだろうに、と。"

#. Occurrence C_3:298:18024: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_3_0000; voice_prefix=A20; voice_category=11; scene=C_3
#: C_3:298
msgctxt "text_id=18024 | speaker=touko"
msgid "\"What's the big hurry? He's after Little Red Riding Hood for the time being."
msgstr "「そう急くな。いま赤ずきんを追っているところだ。"

#. Occurrence C_3:304:18025: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_3_0001; voice_prefix=A20; voice_category=11; scene=C_3
#: C_3:304
msgctxt "text_id=18025 | speaker=touko"
msgid "  Or rather, 'Little Black Hat,' to force the metaphor.\""
msgstr "　黒帽子の彼女をそう喩えるのは、やや無理があるがね」"

#. Occurrence C_3:348:18026: scene=C_3
#: C_3:348
msgctxt "text_id=18026 | speaker=unknown"
msgid "  Her tone reeked of irony."
msgstr "　皮肉げに響く橙子の声。"

#. Occurrence C_3:375:18027: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0003; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:375
msgctxt "text_id=18027 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence C_3:380:18028: scene=C_3
#: C_3:380
msgctxt "text_id=18028 | speaker=unknown"
msgid "  The words traveled aimlessly across the school yard like a rambling announcement."
msgstr "　校庭で流れる、関わりのない放送みたいだ。"

#. Occurrence C_3:400:18029: scene=C_3
#: C_3:400
msgctxt "text_id=18029 | speaker=unknown"
msgid "  Aoko stood frozen and dumbfounded."
msgstr "　青子は呆然と立ちつくす。"

#. Occurrence C_3:419:18030: scene=C_3
#: C_3:419
msgctxt "text_id=18030 | speaker=unknown"
msgid "  Everything Touko was saying seemed so far away from reality."
msgstr "　今の橙子の言葉を、青子は<忘我|ぼうが>する事で、現実ではないと聞き流し―――"

#. Occurrence C_3:473:18031: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0004; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:473
msgctxt "text_id=18031 | speaker=aoko"
msgid "\"Alice...!\""
msgstr "「有珠―――！」"

#. Occurrence C_3:479:18032: scene=C_3
#: C_3:479
msgctxt "text_id=18032 | speaker=unknown"
msgid "  Aoko was done with being fooled, so she turned around."
msgstr "　誤魔化しきれるはずもなく、青子は背後を振り返った。"

#. Occurrence C_3:484:18033: scene=C_3
#: C_3:484
msgctxt "text_id=18033 | speaker=unknown"
msgid "  The moonlight shining off of the fallen snow allowed her to see far into the forest."
msgstr "　……夜の森は白雪のおかげで、月明かりだけでも十分に遠くを見通せた。"

#. Occurrence C_3:489:18034: scene=C_3
#: C_3:489
msgctxt "text_id=18034 | speaker=unknown"
msgid "  From the white darkness, a lone boy came into view, walking toward her."
msgstr "　その真白い闇の中から、ひとりの少年が歩いてくるのが見てとれる。"

#. Occurrence C_3:542:18035: scene=C_3
#: C_3:542
msgctxt "text_id=18035 | speaker=unknown"
msgid "  He could not have been any taller than Aoko's chest, but he carried Alice over his shoulder with ease."
msgstr "　青子の胸より背の低い少年は、自分より大きな<有珠|ひとかげ>を肩にかけて歩いていた。"

#. Occurrence C_3:547:18036: scene=C_3
#: C_3:547
msgctxt "text_id=18036 | speaker=unknown"
msgid "  As if she was nothing, he tossed her body upward."
msgstr "　少年は無造作に有珠の体を投げ捨てる。"

#. Occurrence C_3:601:18037: scene=C_3
#: C_3:601
msgctxt "text_id=18037 | speaker=unknown"
msgid "  She arched through the air for several feet before dropping head first before Aoko's eyes."
msgstr "　放られた有珠は、数メートルもの放物線を描いて、青子の目前に落下する。"

#. Occurrence C_3:606:18038: scene=C_3
#: C_3:606
msgctxt "text_id=18038 | speaker=unknown"
msgid "  Her neck would snap on impact."
msgstr "　頭から。ごきりと、首の骨を折るように。"

#. Occurrence C_3:749:18039: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0005; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:749
msgctxt "text_id=18039 | speaker=aoko"
msgid "\"...!\""
msgstr "「―――っ！」"

#. Occurrence C_3:755:18040: scene=C_3
#: C_3:755
msgctxt "text_id=18040 | speaker=unknown"
msgid "  Even though she was wiser not to, Aoko reached out and caught her."
msgstr "　やめたほうがいいのに、と思いつつ青子は有珠を受けとめた。"

#. Occurrence C_3:760:18041: scene=C_3
#: C_3:760
msgctxt "text_id=18041 | speaker=unknown"
msgid "  Alice's light body weighed heavy as she fell into Aoko's arms."
msgstr "　有珠の軽い体が何倍にもなって両腕にのし掛かる。"

#. Occurrence C_3:781:18042: scene=C_3
#: C_3:781
msgctxt "text_id=18042 | speaker=unknown"
msgid "  The stitches on her wounds tore,"
msgstr "　……縫合したばかりの傷が、容赦なく開いていく。"

#. Occurrence C_3:786:18043: scene=C_3
#: C_3:786
msgctxt "text_id=18043 | speaker=unknown"
msgid "  dyeing Aoko's arms crimson."
msgstr "　受けとめた両腕が赤い。"

#. Occurrence C_3:791:18044: scene=C_3
#: C_3:791
msgctxt "text_id=18044 | speaker=unknown"
msgid "  Aoko gritted her teeth, fighting the pain that shot through her body and the sensation of the warm blood."
msgstr "　ぬらりとした血の感触と激痛に、青子は歯を食いしばって耐えた。"

#. Occurrence C_3:847:18045: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0006; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:847
msgctxt "text_id=18045 | speaker=aoko"
msgid "\"Alice, are you still...?\""
msgstr "「有珠、無事……？」"

#. Occurrence C_3:853:18046: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_C_3_0000; voice_prefix=A40; voice_category=2; scene=C_3
#: C_3:853
msgctxt "text_id=18046 | speaker=alice"
msgid "\"...\""
msgstr "「……………………」"

#. Occurrence C_3:859:18047: scene=C_3
#: C_3:859
msgctxt "text_id=18047 | speaker=unknown"
msgid "  Alice did not respond, but Aoko could see she was at least conscious."
msgstr "　返事はないものの、意識はあるようだ。"

#. Occurrence C_3:864:18048: scene=C_3
#: C_3:864
msgctxt "text_id=18048 | speaker=unknown"
msgid "  The werewolf must have ambushed her right after she ran into the woods."
msgstr "　有珠は森に入ったところで人狼の奇襲を受けたのだろう。"

#. Occurrence C_3:869:18049: scene=C_3
#: C_3:869
msgctxt "text_id=18049 | speaker=unknown"
msgid "  Alice bled heavily from where the wolf tore her abdomen open last night, just like he had done to Aoko."
msgstr "　昨夜、狼に切り裂かれた腹部は、青子と同じように血で<滲|にじ>んでいた。"

#. Occurrence C_3:890:18050: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0007; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:890
msgctxt "text_id=18050 | speaker=aoko"
msgid "\"You were hiding in the woods this entire time.\""
msgstr "「……はじめから、森に<潜|ひそ>ませていたとはね」"

#. Occurrence C_3:930:18051: scene=C_3
#: C_3:930
msgctxt "text_id=18051 | speaker=unknown"
msgid "  Cursing her own carelessness, she gently lay Alice's body down."
msgstr "　チ、と自分の浅はかさを呪いながら、有珠の体をそっと下ろす。"

#. Occurrence C_3:935:18052: scene=C_3
#: C_3:935
msgctxt "text_id=18052 | speaker=unknown"
msgid "  She set her sights on the blond-haired boy-her new target,"
msgstr "　青子の視線は目前の敵―――金髪の少年に向けられている。"

#. Occurrence C_3:978:18053: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0008; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:978
msgctxt "text_id=18053 | speaker=aoko"
msgid "\"So that's how it is, huh?"
msgstr "「つまり、あれよね。"

#. Occurrence C_3:984:18054: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0009; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:984
msgctxt "text_id=18054 | speaker=aoko"
msgid "  A wolf in a little boy's clothing.\""
msgstr "　甘く見ていたフリで、初めから、余裕なかったんだ」"

#. Occurrence C_3:1047:18055: scene=C_3
#: C_3:1047
msgctxt "text_id=18055 | speaker=unknown"
msgid "  Even in the face of Aoko's rage, he did not stop smirking."
msgstr "　青子の怒気を受けても、少年はうす笑いを崩さない。"

#. Occurrence C_3:1052:18056: scene=C_3
#: C_3:1052
msgctxt "text_id=18056 | speaker=unknown"
msgid "  He stared back at the girls, eyes gleaming, twinkling with excitement at the brutality to come."
msgstr "　少女たちを見つめる瞳は<爛|らん>と輝き、明らかに、この後の惨劇を待ち焦がれている風だ。"

#. Occurrence C_3:1057:18057: scene=C_3
#: C_3:1057
msgctxt "text_id=18057 | speaker=unknown"
msgid "  The blond hair and green eyes she saw last night"
msgstr "　夜目にも鮮やかな金髪とグリーンの瞳、"

#. Occurrence C_3:1062:18058: scene=C_3
#: C_3:1062
msgctxt "text_id=18058 | speaker=unknown"
msgid "  and his effeminate features now"
msgstr "　少年というよりは少女に見える顔立ちも、"

#. Occurrence C_3:1068:18059: scene=C_3
#: C_3:1068
msgctxt "text_id=18059 | speaker=unknown"
msgid " seemed ethereal, like he had changed into a being from another planet."
msgstr "今はそういうカタチをしただけの、違う星の生き物としか思えない―――"

#. Occurrence C_3:1134:18060: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_3_0002; voice_prefix=A20; voice_category=11; scene=C_3
#: C_3:1134
msgctxt "text_id=18060 | speaker=touko"
msgid "\"You'll feast tonight, Beo.\""
msgstr "「ベオ。今日は喰っていいぞ」"

#. Occurrence C_3:1140:18061: scene=C_3
#: C_3:1140
msgctxt "text_id=18061 | speaker=unknown"
msgid "  Touko's voice echoed from afar."
msgstr "　遠くから響く、橙子の短い声。"

#. Occurrence C_3:1145:18062: scene=C_3
#: C_3:1145
msgctxt "text_id=18062 | speaker=unknown"
msgid "  The boy's grin broadened."
msgstr "　少年は小さく笑ったように見えた。"

#. Occurrence C_3:1150:18063: scene=C_3
#: C_3:1150
msgctxt "text_id=18063 | speaker=unknown"
msgid "  Nobody could have expected what came next."
msgstr "　けれど、まさか。"

#. Occurrence C_3:1253:18064: scene=C_3
#: C_3:1253
msgctxt "text_id=18064 | speaker=unknown"
msgid "  Aoko rushed head first at the boy."
msgstr "　そこで青子が<自|・><分|・>から少年に走り出すなど、誰に予想できただろうか。"

#. Occurrence C_3:1313:18065: scene=C_3
#: C_3:1313
msgctxt "text_id=18065 | speaker=unknown"
msgid "  Faster than the robin decoy, she sped, blood dripping from both arms."
msgstr "　足跡だけの駒鳥より早く、両手から赤い血を地面にこぼしながら、青子は少年へと疾走する。"

#. Occurrence C_3:1318:18066: scene=C_3
#: C_3:1318
msgctxt "text_id=18066 | speaker=unknown"
msgid "  Touko watched wide-eyed at the spectacle."
msgstr "　橙子は予想外の展開に目を見張り、"

#. Occurrence C_3:1323:18067: scene=C_3
#: C_3:1323
msgctxt "text_id=18067 | speaker=unknown"
msgid "  Alice could only look on with vacant eyes, as she lay helplessly on the ground."
msgstr "　地面に寝かされた有珠は<虚|うつ>ろな目で見守る事しかできない。"

#. Occurrence C_3:1328:18068: scene=C_3
#: C_3:1328
msgctxt "text_id=18068 | speaker=unknown"
msgid "  The werewolf boy was caught off guard by the prey becoming predator."
msgstr "　人狼の少年とて、今まで獲物としか思っていなかった<雌鹿|めじか>の反撃に意表を突かれていた。"

#. Occurrence C_3:1448:18069: scene=C_3
#: C_3:1448
msgctxt "text_id=18069 | speaker=unknown"
msgid "  Aoko crossed a twenty-foot gap in a second before planting a foot in the snow."
msgstr "　六メートルもの間合いを一気に詰めて、青子は片足で雪原をダン、と踏み付けた。"

#. Occurrence C_3:1453:18070: scene=C_3
#: C_3:1453
msgctxt "text_id=18070 | speaker=unknown"
msgid "  It arrested her momentum and pivoted her body like a top."
msgstr "　停止と回転軸を兼ねた踏みこみ。"

#. Occurrence C_3:1458:18071: scene=C_3
#: C_3:1458
msgctxt "text_id=18071 | speaker=unknown"
msgid "  Even if he instantly understood what was coming, the boy wouldn't be able to dodge in time."
msgstr "　攻撃意図を瞬時に悟るも、少年の跳び退きは間に合わない。"

#. Occurrence C_3:1536:18072: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0010; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:1536
msgctxt "text_id=18072 | speaker=aoko"
msgid "\"...The neck!\""
msgstr "「―――首！」"

#. Occurrence C_3:1542:18073: scene=C_3
#: C_3:1542
msgctxt "text_id=18073 | speaker=unknown"
msgid "  Using the momentum from her sprint, she pushed her leg into the ground and sprang up."
msgstr "　片足が、走った勢いもそのままに跳ね上がる。"

#. Occurrence C_3:1547:18074: scene=C_3
#: C_3:1547
msgctxt "text_id=18074 | speaker=unknown"
msgid "  With deadly timing, her roundhouse kick swung in a wide ark toward the boy's neck, sending an explosion of force to his brain stem."
msgstr "　少年の首を狙った回し蹴りは弧を描いて、この上ないタイミングで少年の<延髄|えんずい>に<炸裂|さくれつ>した。"

#. Occurrence C_3:1624:18075: scene=C_3
#: C_3:1624
msgctxt "text_id=18075 | speaker=unknown"
msgid "  It was an expert display of martial arts, strengthened by magical energy."
msgstr "　魔力によって強化された白兵術式。"

#. Occurrence C_3:1629:18076: scene=C_3
#: C_3:1629
msgctxt "text_id=18076 | speaker=unknown"
msgid "  She'd gotten the hang of close combat while fighting Touko's puppets. The violent kick was powerful enough to shatter a tree trunk."
msgstr "　人形との戦いでコツを掴んだ青子の、この森の痩せた木なら<粉砕|ふんさい>しかねない、強烈な一撃だった。"

#. Occurrence C_3:1678:18077: scene=C_3
#: C_3:1678
msgctxt "text_id=18077 | speaker=unknown"
msgid "  The boy did not move."
msgstr "　少年は動かない。"

#. Occurrence C_3:1683:18078: scene=C_3
#: C_3:1683
msgctxt "text_id=18078 | speaker=unknown"
msgid "  Aoko's right shin connected firmly, and stopped."
msgstr "　そして青子も、右足を首に直撃させたまま止まっていた。"

#. Occurrence C_3:1724:18079: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0011; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:1724
msgctxt "text_id=18079 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence C_3:1730:18080: scene=C_3
#: C_3:1730
msgctxt "text_id=18080 | speaker=unknown"
msgid "  A shockwave rippled through his neck."
msgstr "　首筋が、<戦慄|せんりつ>で凍りついている。"

#. Occurrence C_3:1735:18081: scene=C_3
#: C_3:1735
msgctxt "text_id=18081 | speaker=unknown"
msgid "  It was the same feedback Aoko had felt when she destroyed the puppet."
msgstr "　あの人形を破壊したのと同等の手応え。"

#. Occurrence C_3:1740:18082: scene=C_3
#: C_3:1740
msgctxt "text_id=18082 | speaker=unknown"
msgid "  Even if he wasn't defeated, she had to have severely damaged his spine."
msgstr "　倒せないまでも、首の骨にダメージを与えた筈だ。"

#. Occurrence C_3:1747:18083: scene=C_3
#: C_3:1747
msgctxt "text_id=18083 | speaker=unknown"
msgid "  As she looked at him to confirm her kill, the boy simply stared back at her, not even bothering to twitch an eyebrow."
msgstr "　そう確信した青子の思い上がりを正すように、少年は眉すら動かさず、目前の青子を見つめていた。"

#. Occurrence C_3:1782:18084: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_3_0000; voice_prefix=A50; voice_category=12; scene=C_3
#: C_3:1782
msgctxt "text_id=18084 | speaker=beo"
msgid "\"Hmph. That must be the leg I bit."
msgstr "「……ふーん。お姉さんの右足は、たしか噛み切った方だ。"

#. Occurrence C_3:1788:18085: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_3_0001; voice_prefix=A50; voice_category=12; scene=C_3
#: C_3:1788
msgctxt "text_id=18085 | speaker=beo"
msgid "  I can't believe you went for my neck like that. I mean, wow. Miss Touko said that girls instinctively try to spare their own bodies."
msgstr "　それで首を狙ったのは、すごいよね。女の人は本能的に自分の体を<庇|かば>うものだって、トーコさんは言ってたのに。"

#. Occurrence C_3:1794:18086: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_3_0002; voice_prefix=A50; voice_category=12; scene=C_3
#: C_3:1794
msgctxt "text_id=18086 | speaker=beo"
msgid "  It was a valiant move, but you wasted it. My hair is as strong as when I'm a wolf. Even my peach fuzz can stop your kick.\""
msgstr "　けど残念、せっかくの勇気も無駄でした。ボクの体毛の質は、<こ|・><の|・><姿|・>でも変わらない。うぶ毛だけでも、お姉さんの蹴りを受けとめる事はできる」"

#. Occurrence C_3:1814:18087: scene=C_3
#: C_3:1814
msgctxt "text_id=18087 | speaker=unknown"
msgid "  The only one hurt between the two was Aoko."
msgstr "　痛みがあるのは青子の方だけ。"

#. Occurrence C_3:1819:18088: scene=C_3
#: C_3:1819
msgctxt "text_id=18088 | speaker=unknown"
msgid "  The leg she had lodged in his neck was totally numb, like it had been chopped clean off with a hatchet."
msgstr "　延髄を蹴った足の<脛|すね>は、まるで斧で切り落とされたように、感覚というものがない―――"

#. Occurrence C_3:1840:18089: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_3_0003; voice_prefix=A50; voice_category=12; scene=C_3
#: C_3:1840
msgctxt "text_id=18089 | speaker=beo"
msgid "\"You held back a bit, too, right? You wanted to protect your leg, I guess."
msgstr "「それに、少しだけ迷いがあったな。くっつけたばっかりの足だから庇ったでしょ？"

#. Occurrence C_3:1847:18090: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_3_0004; voice_prefix=A50; voice_category=12; scene=C_3
#: C_3:1847
msgctxt "text_id=18090 | speaker=beo"
msgid "  Humans need to forget that kinda thing when fighting me."
msgstr "　人間がボクの相手をするなら、そんなこと気にしちゃいけないのに。"

#. Occurrence C_3:1853:18091: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_3_0005; voice_prefix=A50; voice_category=12; scene=C_3
#: C_3:1853
msgctxt "text_id=18091 | speaker=beo"
msgid "  Still...\""
msgstr "　ああ、でも―――」"

#. Occurrence C_3:1859:18092: scene=C_3
#: C_3:1859
msgctxt "text_id=18092 | speaker=unknown"
msgid "  The boy smiled, basking in Aoko's shock and awe."
msgstr "　青子の驚愕を浴びながら少年は笑う。"

#. Occurrence C_3:1864:18093: scene=C_3
#: C_3:1864
msgctxt "text_id=18093 | speaker=unknown"
msgid "  She could not free her leg."
msgstr "　足は戻せない。"

#. Occurrence C_3:1870:18094: scene=C_3
#: C_3:1870
msgctxt "text_id=18094 | speaker=unknown"
msgid "No doubt as soon as she regained her footing, he would tear her stomach open."
msgstr "たぶん地面に下ろした瞬間、自分が腹から裂かれると青子は予測してしまい―――"

#. Occurrence C_3:1913:18095: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_3_0006; voice_prefix=A50; voice_category=12; scene=C_3
#: C_3:1913
msgctxt "text_id=18095 | speaker=beo"
msgid "\"...Well, you're mincemeat anyway, so I guess it doesn't matter.\""
msgstr "「どっちにしろミンチだから、気にしても仕方がないよね？」"

#. Occurrence C_3:1942:18096: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_3_0007; voice_prefix=A50; voice_category=12; scene=C_3
#: C_3:1942
msgctxt "text_id=18096 | speaker=beo"
msgid "\"See? What a waste. And it just healed up, too.\""
msgstr "「ほら、もったいない。せっかく治ったばかりなのに」"

#. Occurrence C_3:1955:18097: scene=C_3
#: C_3:1955
msgctxt "text_id=18097 | speaker=unknown"
msgid "  Aoko was not sure, but it felt like he had sunk his finger into the flesh of her right leg."
msgstr "　少年の指らしきものが、右足に食いこんだ事が、青子にはよく判らなかった。"

#. Occurrence C_3:1975:18098: scene=C_3
#: C_3:1975
msgctxt "text_id=18098 | speaker=unknown"
msgid "  He was right about her leg; she barely had any feeling in it."
msgstr "　もともと少年の言うとおり、右足には感覚なんてほとんどなかったのだ。"

#. Occurrence C_3:1980:18099: scene=C_3
#: C_3:1980
msgctxt "text_id=18099 | speaker=unknown"
msgid "  It had been completely paralyzed after the last attack, and was now back in the same horrid state."
msgstr "　今の一撃で完全に麻痺した足は、またも<凄惨|せいさん>な運命を繰り返したらしい。"

#. Occurrence C_3:2027:18100: scene=C_3
#: C_3:2027
msgctxt "text_id=18100 | speaker=unknown"
msgid "  Except this time, instead of being torn to pieces, it had been crushed to the bone."
msgstr "　……ただ、今回は千切られる事なく、骨まで握られた。"

#. Occurrence C_3:2032:18101: scene=C_3
#: C_3:2032
msgctxt "text_id=18101 | speaker=unknown"
msgid "  Her leg might have been numb, but just the look of it was enough to horrify her. The way it was crumpled... All that blood..."
msgstr "　感覚はないけれど、<夥|おびただ>しい血の量と、<無惨|むざん>にやせこけた自分の足の<醜|みにく>さが、目に痛い。"

#. Occurrence C_3:2037:18102: scene=C_3
#: C_3:2037
msgctxt "text_id=18102 | speaker=unknown"
msgid "  Any normal person would have died from shock."
msgstr "　普通なら出血量だけでショック死。"

#. Occurrence C_3:2084:18103: scene=C_3
#: C_3:2084
msgctxt "text_id=18103 | speaker=unknown"
msgid "  As if thinking about someone else, Aoko considered how cruel Magic Crests could be."
msgstr "　魔術刻印というものは、こういう時に残酷よね、と他人事のように青子は思う。"

#. Occurrence C_3:2138:18104: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_3_0008; voice_prefix=A50; voice_category=12; scene=C_3
#: C_3:2138
msgctxt "text_id=18104 | speaker=beo"
msgid "\"Huh? Still some life in your eyes."
msgstr "「あれ？　まだ目が死んでない。"

#. Occurrence C_3:2157:18105: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_3_0009; voice_prefix=A50; voice_category=12; scene=C_3
#: C_3:2157
msgctxt "text_id=18105 | speaker=beo"
msgid "...I don't really wanna torture you. You should drop the tough act.\""
msgstr "　……あんまり苦しめたくないんだけど。ガンジョウなのも考え物だよ、お姉さん」"

#. Occurrence C_3:2163:18106: scene=C_3
#: C_3:2163
msgctxt "text_id=18106 | speaker=unknown"
msgid "  The boy thrust his hand out at Aoko's chest."
msgstr "　少年の手が、青子の胸に<放|はな>たれる。"

#. Occurrence C_3:2185:18107: scene=C_3
#: C_3:2185
msgctxt "text_id=18107 | speaker=unknown"
msgid "  Her consciousness flickered from the sudden pain of a stake- no, a child's fist piercing her torso."
msgstr "　胸の中心に刺さった<杭|くい>―――いや、少年の拳の痛みに、青子の意識が消えかかる。"

#. Occurrence C_3:2255:18108: scene=C_3
#: C_3:2255
msgctxt "text_id=18108 | speaker=unknown"
msgid "  The scenery flew by."
msgstr "　……飛んでいる。"

#. Occurrence C_3:2260:18109: scene=C_3
#: C_3:2260
msgctxt "text_id=18109 | speaker=unknown"
msgid "  She soared through the air, like a rag doll tossed away by a bored child."
msgstr "　中身のない空気人形のように、自分の体が飛んでいるのが分かる。"

#. Occurrence C_3:2265:18110: scene=C_3
#: C_3:2265
msgctxt "text_id=18110 | speaker=unknown"
msgid "  Just like Alice a moment ago, she tumbled through the air and hit the ground, hard."
msgstr "　先ほどの有珠と同じように大きく空中に放られて、青子は背中から地面に落ちた。"

#. Occurrence C_3:2393:18111: scene=C_3
#: C_3:2393
msgctxt "text_id=18111 | speaker=unknown"
msgid "  Her right leg was crushed; her chest caved in."
msgstr "　潰された右足と、胸に残る拳の衝撃。"

#. Occurrence C_3:2399:18112: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0012; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:2399
msgctxt "text_id=18112 | speaker=aoko"
msgid "\"Hngh...!\""
msgstr "「っ―――、…………！」"

#. Occurrence C_3:2404:18113: scene=C_3
#: C_3:2404
msgctxt "text_id=18113 | speaker=unknown"
msgid "  It was as if her heart had been scooped out of her chest; each gasp of breath left her wanting more."
msgstr "　満足な呼吸はできず、心臓をえぐり取られたとしか思えない痛みに、視界が点滅する。"

#. Occurrence C_3:2409:18114: scene=C_3
#: C_3:2409
msgctxt "text_id=18114 | speaker=unknown"
msgid "  Was this what it was like to see stars?"
msgstr "　目から火が出るとはこういう事か。"

#. Occurrence C_3:2422:18115: scene=C_3
#: C_3:2422
msgctxt "text_id=18115 | speaker=unknown"
msgid "  The terrifying part was the pain; it never let up."
msgstr "　恐ろしいのは痛みがまったく<薄|うす>れないこと。"

#. Occurrence C_3:2427:18116: scene=C_3
#: C_3:2427
msgctxt "text_id=18116 | speaker=unknown"
msgid "  Desperately trying to suck in oxygen, she could still feel his fist."
msgstr "　無惨にあえぐ青子の胸には、いまも拳大の、杭の感覚が残っている―――"

#. Occurrence C_3:2502:18117: scene=C_3
#: C_3:2502
msgctxt "text_id=18117 | speaker=unknown"
msgid "  ...Leisurely the boy strolled across the snow toward Aoko's broken body,"
msgstr "　……少年はゆっくりと、雪原に殴り飛ばされた青子に近寄っていく。"

#. Occurrence C_3:2507:18118: scene=C_3
#: C_3:2507
msgctxt "text_id=18118 | speaker=unknown"
msgid "  his red tongue gliding over his lips."
msgstr "　唇を舐める赤い舌。"

#. Occurrence C_3:2512:18119: scene=C_3
#: C_3:2512
msgctxt "text_id=18119 | speaker=unknown"
msgid "  He stared at his prey, who was desperately trying to breathe. His eyes filled with glee."
msgstr "　喜びに<濁|にご>った目が、呼吸すら精一杯の<獲物|あおこ>を見つめている。"

#. Occurrence C_3:2572:18120: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0013; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:2572
msgctxt "text_id=18120 | speaker=aoko"
msgid "\"-, -...\""
msgstr "“―――、―――…………”"

#. Occurrence C_3:2578:18121: scene=C_3
#: C_3:2578
msgctxt "text_id=18121 | speaker=unknown"
msgid "  Aoko bit down the temptation to drift away."
msgstr "　もう、ここで意識を失ってしまおうか、なんて甘さを青子はかみ砕く。"

#. Occurrence C_3:2583:18122: scene=C_3
#: C_3:2583
msgctxt "text_id=18122 | speaker=unknown"
msgid "  Even though she could find no reason to fight on."
msgstr "　……けれど、頑張ってどうなるのか。"

#. Occurrence C_3:2588:18123: scene=C_3
#: C_3:2588
msgctxt "text_id=18123 | speaker=unknown"
msgid "  The snow had broken her fall slightly, but her death was all but certain-the fist-sized crater in her chest, and her mangled leg made sure of that."
msgstr "　落下した背中は雪に助けられたが、拳を受けた胸の<陥没|かんぼつ>と、潰された右足が、容赦なく生命を奪っていく。"

#. Occurrence C_3:2643:18124: scene=C_3
#: C_3:2643
msgctxt "text_id=18124 | speaker=unknown"
msgid "  Even though she knew she was a broken mess,"
msgstr "　自分がスクラップみたいに壊れてしまったと分かるのに、"

#. Occurrence C_3:2648:18125: scene=C_3
#: C_3:2648
msgctxt "text_id=18125 | speaker=unknown"
msgid "  ...her Magic Crests frantically worked to resuscitate her heart. But why...?"
msgstr "　どうして今も、必死に痺れた心臓を蘇生させようと、魔術刻印を回しているのか。"

#. Occurrence C_3:2762:18126: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0014; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:2762
msgctxt "text_id=18126 | speaker=aoko"
msgid "\"Wh―\""
msgstr "“―――ぁ…………、れは”"

#. Occurrence C_3:2844:18127: scene=C_3
#: C_3:2844
msgctxt "text_id=18127 | speaker=unknown"
msgid "  The sight of Touko in the distance... was the only thing that kept her conscious."
msgstr "　絶望的な状況で青子の意識を繋ぎ止めていたのは、遠くで<佇|たたず>む橙子の姿だった。"

#. Occurrence C_3:2864:18128: scene=C_3
#: C_3:2864
msgctxt "text_id=18128 | speaker=unknown"
msgid "  Her sister looked... surprised, for some reason."
msgstr "　……橙子は、たしかに驚いている。"

#. Occurrence C_3:2869:18129: scene=C_3
#: C_3:2869
msgctxt "text_id=18129 | speaker=unknown"
msgid "  Like she was witnessing some strange phenomenon. That wasn't like her."
msgstr "　何か意外な物を見たような、彼女らしからぬ思考停止。"

#. Occurrence C_3:2874:18130: scene=C_3
#: C_3:2874
msgctxt "text_id=18130 | speaker=unknown"
msgid "  Wondering what it was, Aoko tried to stay conscious."
msgstr "　それが何であるかが気になって、青子はいまだ意識を保っていた。"

#. Occurrence C_3:2910:18131: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_3_0015; voice_prefix=A10; voice_category=1; scene=C_3
#: C_3:2910
msgctxt "text_id=18131 | speaker=aoko"
msgid "\"...Wh-What's... happening...?\""
msgstr "“…………な、に？”"

#. Occurrence C_3:2929:18132: scene=C_3
#: C_3:2929
msgctxt "text_id=18132 | speaker=unknown"
msgid "  Feebly trying to raise her head, she looked to where Touko was staring."
msgstr "　沈みかける顔を起こして、橙子の視線の先を見る。"

#. Occurrence C_3:2934:18133: scene=C_3
#: C_3:2934
msgctxt "text_id=18133 | speaker=unknown"
msgid "  Why did she look like that when she was so close to victory?"
msgstr "　いったい、この絶対的な勝利の状況で、あの女を驚かせる物とは何なのだろう、と。"

#. Occurrence C_4:87:18134: scene=C_4
#: C_4:87
msgctxt "text_id=18134 | speaker=unknown"
msgid "  His heart was beating faster than normal."
msgstr "　胸の<鼓動|おと>が平常時より高い。"

#. Occurrence C_4:93:18135: scene=C_4
#: C_4:93
msgctxt "text_id=18135 | speaker=unknown"
msgid "  The fragmented and disturbing images kept returning, and he desperately pushed them to the back of his mind."
msgstr "　<千々|ちぢ>に乱れていく思考を、彼は慎重に抑えつける。"

#. Occurrence C_4:128:18136: scene=C_4
#: C_4:128
msgctxt "text_id=18136 | speaker=unknown"
msgid "  They were thoughts that shook his resolve."
msgstr "　心を弱める雑念。"

#. Occurrence C_4:133:18137: scene=C_4
#: C_4:133
msgctxt "text_id=18137 | speaker=unknown"
msgid "  He did his best to file them away into an unseen corner of his consciousness."
msgstr "　寄り道でしかない不要な意識を、できるだけ見えない<左脳|ところ>に整理する。"

#. Occurrence C_4:182:18138: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_4_0000; voice_prefix=A30; voice_category=3; scene=C_4
#: C_4:182
msgctxt "text_id=18138 | speaker=soujuurou"
msgid "\"...\""
msgstr "「―――――――――」"

#. Occurrence C_4:188:18139: scene=C_4
#: C_4:188
msgctxt "text_id=18139 | speaker=unknown"
msgid "  Right now, he could only focus on controlling his breathing and his exertion."
msgstr "　呼吸が速いのも、力が入っているのも、<偏|ひとえ>に自分の責任だ。"

#. Occurrence C_4:193:18140: scene=C_4
#: C_4:193
msgctxt "text_id=18140 | speaker=unknown"
msgid "  Just stay calm, he repeated to himself."
msgstr "　彼は努めて、冷静であれと繰り返す。"

#. Occurrence C_4:234:18141: scene=C_4
#: C_4:234
msgctxt "text_id=18141 | speaker=unknown"
msgid "  He had not stopped for a second since leaving the church,"
msgstr "　教会を出てからここまで、一秒も止まらなかった。"

#. Occurrence C_4:239:18142: scene=C_4
#: C_4:239
msgctxt "text_id=18142 | speaker=unknown"
msgid "  even without giving a thought to what he would do next."
msgstr "　ここからはどうだろう。"

#. Occurrence C_4:281:18143: scene=C_4
#: C_4:281
msgctxt "text_id=18143 | speaker=unknown"
msgid "  So many traffic lights..."
msgstr "　信号が多い。"

#. Occurrence C_4:286:18144: scene=C_4
#: C_4:286
msgctxt "text_id=18144 | speaker=unknown"
msgid "  So many people..."
msgstr "　人が多い。"

#. Occurrence C_4:291:18145: scene=C_4
#: C_4:291
msgctxt "text_id=18145 | speaker=unknown"
msgid "  It was Christmas. There was no way he would find a taxi."
msgstr "　タクシーを使うのも手ではあるが、クリスマスの街は混みあっている。"

#. Occurrence C_4:297:18146: scene=C_4
#: C_4:297
msgctxt "text_id=18146 | speaker=unknown"
msgid "Waiting for one was not an option; it was why he had put his trust in his legs."
msgstr "だいたいタクシー待ちが多すぎる。それならこのまま、小回りのきく自分の足を信用した。"

#. Occurrence C_4:302:18147: scene=C_4
#: C_4:302
msgctxt "text_id=18147 | speaker=unknown"
msgid "  He dashed through the city streets. He had to find a shorter route than last night."
msgstr "　昨夜以上に最短距離で行けるよう、夜の街を駆けていく。"

#. Occurrence C_4:370:18148: scene=C_4
#: C_4:370
msgctxt "text_id=18148 | speaker=unknown"
msgid "  His heart was ready to jump out of his chest,"
msgstr "　胸の<鼓|お><動|と>は針のようだ。"

#. Occurrence C_4:376:18149: scene=C_4
#: C_4:376
msgctxt "text_id=18149 | speaker=unknown"
msgid "  pounding like a hammer against a fire bell."
msgstr "　<早鐘|はやがね>は依然として鳴り続けている。"

#. Occurrence C_4:381:18150: scene=C_4
#: C_4:381
msgctxt "text_id=18150 | speaker=unknown"
msgid "  He had no intention of giving up yet, but he could not seem to calm himself down."
msgstr "　この程度の距離で音を上げる事はないのに、まったくもって落ち着かない。"

#. Occurrence C_4:416:18151: scene=C_4
#: C_4:416
msgctxt "text_id=18151 | speaker=unknown"
msgid "  In his precarious condition, even surrender seemed too great of an effort to spare."
msgstr "　ふわふわした<自分|からだ>には、その音はいささか大きすぎるようだった。"

#. Occurrence C_4:421:18152: scene=C_4
#: C_4:421
msgctxt "text_id=18152 | speaker=unknown"
msgid "  Visions of horrible outcomes flashed through his mind."
msgstr "　嫌な予感だけが先走ってしまう。"

#. Occurrence C_4:426:18153: scene=C_4
#: C_4:426
msgctxt "text_id=18153 | speaker=unknown"
msgid "  No. Calm. He needed to stay calm."
msgstr "　でも冷静に、冷静に。"

#. Occurrence C_4:431:18154: scene=C_4
#: C_4:431
msgctxt "text_id=18154 | speaker=unknown"
msgid "  That was his only weapon."
msgstr "　だって、それだけが彼の武器だ。"

#. Occurrence C_4:436:18155: scene=C_4
#: C_4:436
msgctxt "text_id=18155 | speaker=unknown"
msgid "  He was painfully aware he was powerless; the best thing he could do was to keep his head on straight."
msgstr "　無力であるが故に、落ち着く事だけが自分にできる最善だと、彼はよく理解していた。"

#. Occurrence C_4:507:18156: scene=C_4
#: C_4:507
msgctxt "text_id=18156 | speaker=unknown"
msgid "  While he wrangled with his mind..."
msgstr "　―――反面。"

#. Occurrence C_4:512:18157: scene=C_4
#: C_4:512
msgctxt "text_id=18157 | speaker=unknown"
msgid "  His pulse seemed to quicken, with every step."
msgstr "　しゃにむに走るたび、胸の鼓動は速くなる。"

#. Occurrence C_4:601:18158: scene=C_4
#: C_4:601
msgctxt "text_id=18158 | speaker=unknown"
msgid "  The forest was faintly lit by the moon."
msgstr "　月光が森をかすかに照らす。"

#. Occurrence C_4:606:18159: scene=C_4
#: C_4:606
msgctxt "text_id=18159 | speaker=unknown"
msgid "  That was more than enough on such a bare mountain."
msgstr "　はげ山にはそれだけで十分だった。"

#. Occurrence C_4:611:18160: scene=C_4
#: C_4:611
msgctxt "text_id=18160 | speaker=unknown"
msgid "  He followed the two sets of footprints."
msgstr "　ふたり分の足跡を追いかける。"

#. Occurrence C_4:616:18161: scene=C_4
#: C_4:616
msgctxt "text_id=18161 | speaker=unknown"
msgid "  Ahead lay a situation he had nothing to do with-just like at the amusement park."
msgstr "　この先はいつかの遊園地と同じ、彼には関わりのない窮地だ。"

#. Occurrence C_4:685:18162: scene=C_4
#: C_4:685
msgctxt "text_id=18162 | speaker=unknown"
msgid "\"Even if you go, there's nothing you can do for them.\""
msgstr "『―――貴方が行っても何も出来ない』"

#. Occurrence C_4:733:18163: scene=C_4
#: C_4:733
msgctxt "text_id=18163 | speaker=unknown"
msgid "  The only effect her admonishing words had was to hasten his pace."
msgstr "　戒めの言葉に、心音だけが高くなる。"

#. Occurrence C_4:738:18164: scene=C_4
#: C_4:738
msgctxt "text_id=18164 | speaker=unknown"
msgid "  He pushed the ground with his legs even harder, trying to leave his doubt in the kicked up snow behind him."
msgstr "　地を蹴る足は勢いをまして、戸惑う心は後方に千切れて消えていく。"

#. Occurrence C_4:765:18165: scene=C_4
#: C_4:765
msgctxt "text_id=18165 | speaker=unknown"
msgid "  Of course he was powerless."
msgstr "　そんな事、言われるまでもない。"

#. Occurrence C_4:770:18166: scene=C_4
#: C_4:770
msgctxt "text_id=18166 | speaker=unknown"
msgid "  The pain in his chest told him so."
msgstr "　何より彼自身が痛感している。"

#. Occurrence C_4:775:18167: scene=C_4
#: C_4:775
msgctxt "text_id=18167 | speaker=unknown"
msgid "  At best he would be useless, and at the worst he would be a liability."
msgstr "　役に立たないだけならまだマシで、最悪、彼女たちにとってマイナスにしかならないのではと。"

#. Occurrence C_4:780:18168: scene=C_4
#: C_4:780
msgctxt "text_id=18168 | speaker=unknown"
msgid "  He recalled the binding spell placed on him at the church."
msgstr "　それが教会で一瞬だけ足を止めた呪縛だった。"

#. Occurrence C_4:786:18169: scene=C_4
#: C_4:786
msgctxt "text_id=18169 | speaker=unknown"
msgid "  It did not matter."
msgstr "　でも、結局は―――"

#. Occurrence C_4:850:18170: scene=C_4
#: C_4:850
msgctxt "text_id=18170 | speaker=unknown"
msgid "  His body told him he would regret being torn to pieces less than if he did nothing."
msgstr "　体は、何もしない後悔より、砕け散る後悔を選んだ。"

#. Occurrence C_4:856:18171: scene=C_4
#: C_4:856
msgctxt "text_id=18171 | speaker=unknown"
msgid "  Not once did his legs fail him as he ran through the woods;"
msgstr "　森を走る足取りは乱れない。"

#. Occurrence C_4:861:18172: scene=C_4
#: C_4:861
msgctxt "text_id=18172 | speaker=unknown"
msgid "  though it felt as though his heart could at any moment."
msgstr "　乱れそうなのは鼓動だけ。"

#. Occurrence C_4:866:18173: scene=C_4
#: C_4:866
msgctxt "text_id=18173 | speaker=unknown"
msgid "  His weakness screamed at him from within."
msgstr "　自分の弱さだけが叫んでいる。"

#. Occurrence C_4:918:18174: scene=C_4
#: C_4:918
msgctxt "text_id=18174 | speaker=unknown"
msgid "  Just like back at the amusement park."
msgstr "　あの遊園地の空を駆け下りた時とまったく同じ。"

#. Occurrence C_4:944:18175: scene=C_4
#: C_4:944
msgctxt "text_id=18175 | speaker=unknown"
msgid "  He was beyond reason or circumstances now."
msgstr "　どんな理由も<経緯|いきさつ>も関係ない。"

#. Occurrence C_4:966:18176: scene=C_4
#: C_4:966
msgctxt "text_id=18176 | speaker=unknown"
msgid "  Ultimately..."
msgstr "　結局のところ、"

#. Occurrence C_4:991:18177: scene=C_4
#: C_4:991
msgctxt "text_id=18177 | speaker=unknown"
msgid "\"...I just want to help her.\""
msgstr "“―――自分が、<彼女|だれか>を助けたいんだ”"

#. Occurrence C_4:997:18178: scene=C_4
#: C_4:997
msgctxt "text_id=18178 | speaker=unknown"
msgid "  ...that was all he really desired."
msgstr "　ただそれだけの、純粋な欲求だ。"

#. Occurrence C_4:1050:18179: scene=C_4
#: C_4:1050
msgctxt "text_id=18179 | speaker=unknown"
msgid "  His heart pounded with vigor."
msgstr "　心音は調子を崩さない。"

#. Occurrence C_4:1055:18180: scene=C_4
#: C_4:1055
msgctxt "text_id=18180 | speaker=unknown"
msgid "  As he ran through the dark, wintry forest, only one thing gnawed at his mind."
msgstr "　暗い森を走っていく間、彼の脳裏を占めていたものは一つだけ。"

#. Occurrence C_4:1060:18181: scene=C_4
#: C_4:1060
msgctxt "text_id=18181 | speaker=unknown"
msgid "  Not concern for the girls, nor anger toward Touko."
msgstr "　彼女たちへの心配でも、橙子に対する敵意でもない。"

#. Occurrence C_4:1110:18182: scene=C_4
#: C_4:1110
msgctxt "text_id=18182 | speaker=unknown"
msgid "  The red roses bursting forth from her limbs."
msgstr "　赤い花に飾られたような肢体。"

#. Occurrence C_4:1115:18183: scene=C_4
#: C_4:1115
msgctxt "text_id=18183 | speaker=unknown"
msgid "  Screams of agony, like childbirth."
msgstr "　産声にも似た苦痛の声。"

#. Occurrence C_4:1120:18184: scene=C_4
#: C_4:1120
msgctxt "text_id=18184 | speaker=unknown"
msgid "  The harsh reality of something beautiful dying."
msgstr "　美しいと感じたものが、静かに死滅していく現実。"

#. Occurrence C_4:1126:18185: scene=C_4
#: C_4:1126
msgctxt "text_id=18185 | speaker=unknown"
msgid "  The nightmare was tenacious."
msgstr "　なんて<拭|ぬぐ>いがたい悪夢。"

#. Occurrence C_4:1131:18186: scene=C_4
#: C_4:1131
msgctxt "text_id=18186 | speaker=unknown"
msgid "  Never again."
msgstr "　だから、もう二度と。"

#. Occurrence C_4:1136:18187: scene=C_4
#: C_4:1136
msgctxt "text_id=18187 | speaker=unknown"
msgid "  Never ever again did he want to see something like that again, if he could help it."
msgstr "　あんな光景は、見たくなかったのに。"

#. Occurrence C_4:1185:18188: scene=C_4
#: C_4:1185
msgctxt "text_id=18188 | speaker=unknown"
msgid "  Just ahead was the forest clearing."
msgstr "　森はじき終わろうとしている。"

#. Occurrence C_4:1190:18189: scene=C_4
#: C_4:1190
msgctxt "text_id=18189 | speaker=unknown"
msgid "  The moonlight shone on the old school building like a spotlight."
msgstr "　月光はさえざえと旧校舎を示している。"

#. Occurrence C_4:1195:18190: scene=C_4
#: C_4:1195
msgctxt "text_id=18190 | speaker=unknown"
msgid "  Once again, those thoughts crept back."
msgstr "　その、絶望的なタイミングで思い至ってしまった。"

#. Occurrence C_4:1200:18191: scene=C_4
#: C_4:1200
msgctxt "text_id=18191 | speaker=unknown"
msgid "  He could not bear seeing something like that again."
msgstr "　あんな光景は二度と見たくない。"

#. Occurrence C_4:1205:18192: scene=C_4
#: C_4:1205
msgctxt "text_id=18192 | speaker=unknown"
msgid "  That was why he ran."
msgstr "　そのためにこうして自分は走っている。"

#. Occurrence C_4:1227:18193: scene=C_4
#: C_4:1227
msgctxt "text_id=18193 | speaker=unknown"
msgid "  But..."
msgstr "　……けれど。"

#. Occurrence C_4:1233:18194: scene=C_4
#: C_4:1233
msgctxt "text_id=18194 | speaker=unknown"
msgid "If he had to face it a second time, how could he stay calm?"
msgstr "もし二度目と直面した時、どうすれば冷静でいられるのか。"

#. Occurrence C_4:1297:18195: scene=C_4
#: C_4:1297
msgctxt "text_id=18195 | speaker=unknown"
msgid "  With that thought in mind, he arrived at the clearing."
msgstr "　そうして、彼は広場に辿り着いた。"

#. Occurrence C_4:1302:18196: scene=C_4
#: C_4:1302
msgctxt "text_id=18196 | speaker=unknown"
msgid "  Somehow, his frantic breathing, his rising and lowering shoulders stopped."
msgstr "　長く走った事で乱れた呼吸も、<瘧|おこり>のように上下する肩も、嘘のように消え去った。"

#. Occurrence C_4:1307:18197: scene=C_4
#: C_4:1307
msgctxt "text_id=18197 | speaker=unknown"
msgid "  No exhaustion. No inertia. Just blankness. Like his mind was frozen in time."
msgstr "　<排気|はいき>も<慣性|かんせい>もない、時間停止のような思考停止。"

#. Occurrence C_4:1313:18198: scene=C_4
#: C_4:1313
msgctxt "text_id=18198 | speaker=unknown"
msgid "  This was the second time he felt like this."
msgstr "　二度目は、たしかにあった。"

#. Occurrence C_4:1360:18199: scene=C_4
#: C_4:1360
msgctxt "text_id=18199 | speaker=unknown"
msgid "  But the nausea and dizziness from the first time..."
msgstr "　一度目のような目眩と吐き気はあったかどうか。"

#. Occurrence C_4:1365:18200: scene=C_4
#: C_4:1365
msgctxt "text_id=18200 | speaker=unknown"
msgid "  The pathetic whining of the last few weeks..."
msgstr "　ここまで積み重ねてきた弱音。"

#. Occurrence C_4:1370:18201: scene=C_4
#: C_4:1370
msgctxt "text_id=18201 | speaker=unknown"
msgid "  The doubts clouding his mind... they were all gone,"
msgstr "　頭を乱していた迷いは、より強い感情で、跡形もなく消え去った。"

#. Occurrence C_4:1376:18202: scene=C_4
#: C_4:1376
msgctxt "text_id=18202 | speaker=unknown"
msgid " displaced entirely from his mind by an even stronger emotion."
msgstr "完全に、<頭蓋|ずがい>の外にはじき出された。"

#. Occurrence C_4:1467:18203: scene=C_4
#: C_4:1467
msgctxt "text_id=18203 | speaker=unknown"
msgid "  His heart pounded with the force of a sledgehammer."
msgstr "　―――心音は胸を貫く<楔|くさび>のように。"

#. Occurrence C_4:1472:18204: scene=C_4
#: C_4:1472
msgctxt "text_id=18204 | speaker=unknown"
msgid "  It was a primal sound, loud enough to bring him to his senses."
msgstr "　それはひときわ高い、意識を覚ます原初の鼓動。"

#. Occurrence C_5:78:18205: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_5_0000; voice_prefix=A30; voice_category=3; scene=C_5
#: C_5:78
msgctxt "text_id=18205 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence C_5:84:18206: scene=C_5
#: C_5:84
msgctxt "text_id=18206 | speaker=unknown"
msgid "  Soujyuro stepped into the clearing, letting out a deep but steady exhale."
msgstr "　<深|ふか>く<細|ほそ>く息を吐いて、草十郎は広場に足を踏み入れた。"

#. Occurrence C_5:105:18207: scene=C_5
#: C_5:105
msgctxt "text_id=18207 | speaker=unknown"
msgid "  Although his eyes were locked with the blond-haired boy's, his concentration was focused inward."
msgstr "　視線は金髪の少年に合わせてはいるものの、意識は自分に向けられている。"

#. Occurrence C_5:110:18208: scene=C_5
#: C_5:110
msgctxt "text_id=18208 | speaker=unknown"
msgid "  Be calm. Be calm."
msgstr "　冷静であれ、冷静であれ、と。"

#. Occurrence C_5:146:18209: scene=C_5
#: C_5:146
msgctxt "text_id=18209 | speaker=unknown"
msgid "  Every fiber of his being worked to control his breathing."
msgstr "　彼は全身全霊で、<努|つと>めて呼吸を合わせている。"

#. Occurrence C_5:166:18210: scene=C_5
#: C_5:166
msgctxt "text_id=18210 | speaker=unknown"
msgid "  The clearing told the story of Aoko and Alice's crushing defeat."
msgstr "　広場の状況は、青子たちの敗北を物語っていた。"

#. Occurrence C_5:197:18211: scene=C_5
#: C_5:197
msgctxt "text_id=18211 | speaker=unknown"
msgid "  Aoko was lying face up in the snow,"
msgstr "　青子は<仰向|あおむ>けに倒れている。"

#. Occurrence C_5:202:18212: scene=C_5
#: C_5:202
msgctxt "text_id=18212 | speaker=unknown"
msgid "  her right leg bright red and crushed at the thigh."
msgstr "　片足は真っ赤で、<腿|もも>は<醜|みにく>く潰されていた。"

#. Occurrence C_5:222:18213: scene=C_5
#: C_5:222
msgctxt "text_id=18213 | speaker=unknown"
msgid "  Her eyes were glazed over, but Soujyuro could tell she was still bravely fighting."
msgstr "　青子の<瞳|め>は<霞|かす>んでいるものの、やってきた草十郎を見すえる程度には、気丈な意志が残っている。"

#. Occurrence C_5:227:18214: scene=C_5
#: C_5:227
msgctxt "text_id=18214 | speaker=unknown"
msgid "  Judging by her spluttering, she had taken a hard blow to her chest or back."
msgstr "　小さく咳きこんでいるところを見ると、腹部か背中を強く殴打したのだろう。"

#. Occurrence C_5:232:18215: scene=C_5
#: C_5:232
msgctxt "text_id=18215 | speaker=unknown"
msgid "  Soujyuro deduced it was most likely both."
msgstr "　いや、その両方か、と草十郎は判断した。"

#. Occurrence C_5:286:18216: scene=C_5
#: C_5:286
msgctxt "text_id=18216 | speaker=unknown"
msgid "  Alice's injuries seemed less serious than Aoko's, but she lay motionless on the ground nevertheless."
msgstr "　有珠は青子ほど重傷には見えないが、やはり地面に倒れたまま動けない。"

#. Occurrence C_5:291:18217: scene=C_5
#: C_5:291
msgctxt "text_id=18217 | speaker=unknown"
msgid "  She was lying across from Aoko, face down in the snow, arms out in front, as though pushing herself up was too painful."
msgstr "　青子とは反対にうつぶせで、懸命に両肘を地面に立て、起きあがろうとしているのが痛々しかった。"

#. Occurrence C_5:371:18218: scene=C_5
#: C_5:371
msgctxt "text_id=18218 | speaker=unknown"
msgid "  Before the old school building stood the figure of the mage he had seen before."
msgstr "　広場の奥に鎮座する旧校舎の前には、いつか見た魔術師の姿。"

#. Occurrence C_5:376:18219: scene=C_5
#: C_5:376
msgctxt "text_id=18219 | speaker=unknown"
msgid "  Paying her no mind, Soujyuro began to walk forward."
msgstr "　それにはまったくの無意志を<示|しめ>し、草十郎は歩きだした。"

#. Occurrence C_5:428:18220: scene=C_5
#: C_5:428
msgctxt "text_id=18220 | speaker=unknown"
msgid "  Feeling calmer since arriving at the clearing, he advanced toward Aoko."
msgstr "　彼は広場に到着した時より落ち着いた面もちで、青子へと足を進める。"

#. Occurrence C_5:433:18221: scene=C_5
#: C_5:433
msgctxt "text_id=18221 | speaker=unknown"
msgid "  Touko did nothing to stop him."
msgstr "　橙子はそれを止めない。"

#. Occurrence C_5:438:18222: scene=C_5
#: C_5:438
msgctxt "text_id=18222 | speaker=unknown"
msgid "  No one noticed, but the faintest look of worry flickered in her eyes."
msgstr "　ただ、誰に気付かれるコトなく、瞳に苦悩の色を浮かべただけだった。"

#. Occurrence C_5:472:18223: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_5_0000; voice_prefix=A50; voice_category=12; scene=C_5
#: C_5:472
msgctxt "text_id=18223 | speaker=beo"
msgid "\"Are you a friend of theirs, mister?\""
msgstr "「お兄さんも、その人たちの仲間？」"

#. Occurrence C_5:478:18224: scene=C_5
#: C_5:478
msgctxt "text_id=18224 | speaker=unknown"
msgid "  The child werewolf spoke amicably, confident in his victory,"
msgstr "　勝者の余裕か、人狼の少年は親しげに話しかける。"

#. Occurrence C_5:483:18225: scene=C_5
#: C_5:483
msgctxt "text_id=18225 | speaker=unknown"
msgid "  and perhaps also eyeing up a new meal."
msgstr "　新しい獲物が来た、程度の気持ちなのだろう。"

#. Occurrence C_5:493:18226: scene=C_5
#: C_5:493
msgctxt "text_id=18226 | speaker=unknown"
msgid "  Soujyuro ignored him, and kept walking toward Aoko."
msgstr "　草十郎は応えずに青子へと歩いていく。"

#. Occurrence C_5:518:18227: scene=C_5
#: C_5:518
msgctxt "text_id=18227 | speaker=unknown"
msgid "  The complete disregard wiped the smile from the boy's face."
msgstr "　完全な無視に、少年から笑みが消えた。"

#. Occurrence C_5:523:18228: scene=C_5
#: C_5:523
msgctxt "text_id=18228 | speaker=unknown"
msgid "  Still Soujyuro carried on; the beast's feelings were the last thing on his mind."
msgstr "　悪魔の機嫌を損ねた事も気にならないのか、草十郎は歩みを止めない。"

#. Occurrence C_5:553:18229: scene=C_5
#: C_5:553
msgctxt "text_id=18229 | speaker=unknown"
msgid "  Once he reached Aoko, he looked down at her with a pained expression on his face."
msgstr "　そうして青子の元まで到着すると、彼は痛ましげに顔を<曇|くも>らせた。"

#. Occurrence C_5:602:18230: scene=C_5
#: C_5:602
msgctxt "text_id=18230 | speaker=unknown"
msgid "  Strangely, he was at a loss for words."
msgstr "　……らしくなく、自然な言葉が見つからない。"

#. Occurrence C_5:607:18231: scene=C_5
#: C_5:607
msgctxt "text_id=18231 | speaker=unknown"
msgid "  After a slight hesitation, all he could manage to say was,"
msgstr "　短い逡巡の<末|すえ>、かろうじて口に出来たのは、"

#. Occurrence C_5:664:18232: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_5_0001; voice_prefix=A30; voice_category=3; scene=C_5
#: C_5:664
msgctxt "text_id=18232 | speaker=soujuurou"
msgid "\"That wasn't very polite, Ms. President."
msgstr "「なってないぞ生徒会長。"

#. Occurrence C_5:670:18233: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_5_0002; voice_prefix=A30; voice_category=3; scene=C_5
#: C_5:670
msgctxt "text_id=18233 | speaker=soujuurou"
msgid "  You shouldn't have left the church without saying goodbye.\""
msgstr "　行く時ぐらい、声をかけるものだろう」"

#. Occurrence C_5:676:18234: scene=C_5
#: C_5:676
msgctxt "text_id=18234 | speaker=unknown"
msgid "  His awkward remark was half scolding and half affectionate."
msgstr "　叱るような<気遣|きづか>うような、不器用な呼びかけだけだった。"

#. Occurrence C_5:725:18235: scene=C_5
#: C_5:725
msgctxt "text_id=18235 | speaker=unknown"
msgid "\"..."
msgstr "「………………"

#. Occurrence C_5:732:18236: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_5_0000; voice_prefix=A10; voice_category=1; scene=C_5
#: C_5:732
msgctxt "text_id=18236 | speaker=aoko"
msgid "You... numbskull...\""
msgstr "この、ばか」"

#. Occurrence C_5:737:18237: scene=C_5
#: C_5:737
msgctxt "text_id=18237 | speaker=unknown"
msgid "  Despite the pain in her stomach, Aoko was able to throw an insult his way."
msgstr "　腹の痛みもなんのその、青子は自分をかばうように立つ草十郎を罵倒する。"

#. Occurrence C_5:777:18238: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_5_0003; voice_prefix=A30; voice_category=3; scene=C_5
#: C_5:777
msgctxt "text_id=18238 | speaker=soujuurou"
msgid "\"Glad to see you still have some fight in you, Aozaki.\""
msgstr "「安心した。余裕あるじゃないか、蒼崎」"

#. Occurrence C_5:782:18239: scene=C_5
#: C_5:782
msgctxt "text_id=18239 | speaker=unknown"
msgid "  His voice brightened, as if buying her bravado."
msgstr "　そんな青子の強がりを真に受けたのか、草十郎の声は明るい。"

#. Occurrence C_5:802:18240: scene=C_5
#: C_5:802
msgctxt "text_id=18240 | speaker=unknown"
msgid "  The truth was that she barely had the strength to live."
msgstr "　……実際、青子には余裕どころか体力も無い。"

#. Occurrence C_5:807:18241: scene=C_5
#: C_5:807
msgctxt "text_id=18241 | speaker=unknown"
msgid "  Despite that, Soujyuro looked like he wanted to respond in his usual way."
msgstr "　なのに草十郎の返事はいつも通りで、"

#. Occurrence C_5:812:18242: scene=C_5
#: C_5:812
msgctxt "text_id=18242 | speaker=unknown"
msgid "  Something like, \"see, Aozaki? You're too tough to die, even when someone kills you.\""
msgstr "『さすが蒼崎、殺しても死なないな』とでも言いたげな<暢気|のんき>さだ。"

#. Occurrence C_5:860:18243: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_5_0001; voice_prefix=A10; voice_category=1; scene=C_5
#: C_5:860
msgctxt "text_id=18243 | speaker=aoko"
msgid "\"You know...\""
msgstr "「アンタ、ね―――」"

#. Occurrence C_5:874:18244: scene=C_5
#: C_5:874
msgctxt "text_id=18244 | speaker=unknown"
msgid "  As soon as she tried to speak, she ran out of breath."
msgstr "　つい口に出して、青子は息を呑んだ。"

#. Occurrence C_5:879:18245: scene=C_5
#: C_5:879
msgctxt "text_id=18245 | speaker=unknown"
msgid "  Soujyuro heard her loud and clear this time."
msgstr "　……草十郎は何も勘違いしていない。"

#. Occurrence C_5:884:18246: scene=C_5
#: C_5:884
msgctxt "text_id=18246 | speaker=unknown"
msgid "  He might have looked absentminded, but he knew exactly how dangerous the situation was."
msgstr "　いかに間が抜けていても、今の状況がどれほど危険なのか、痛いほど理解している。"

#. Occurrence C_5:913:18247: scene=C_5
#: C_5:913
msgctxt "text_id=18247 | speaker=unknown"
msgid "  Aoko knew because his carefree-sounding words did not match his expressionless face."
msgstr "　その証拠に、暢気な台詞が空々しく聞こえるほど、その表情は凍りついていた。"

#. Occurrence C_5:934:18248: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_5_0002; voice_prefix=A10; voice_category=1; scene=C_5
#: C_5:934
msgctxt "text_id=18248 | speaker=aoko"
msgid "\"...What do you... think... you're...?\""
msgstr "「……いったい、何のつもりで……」"

#. Occurrence C_5:956:18249: scene=C_5
#: C_5:956
msgctxt "text_id=18249 | speaker=unknown"
msgid "  Before she could say \"doing,\" she coughed painfully."
msgstr "　来たのよ、といいかけて青子は咳きこんでしまった。"

#. Occurrence C_5:961:18250: scene=C_5
#: C_5:961
msgctxt "text_id=18250 | speaker=unknown"
msgid "  Soujyuro pressed his finger to his lips and nodded."
msgstr "　草十郎は人差し指を口元に立てて頷く。"

#. Occurrence C_5:966:18251: scene=C_5
#: C_5:966
msgctxt "text_id=18251 | speaker=unknown"
msgid "  Aoko could not quite believe it, but it looked as though Soujyuro had gestured to her to not speak."
msgstr "　青子には理解しがたいが、無理して話しちゃダメだ、というジェスチャーらしい。"

#. Occurrence C_5:987:18252: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_5_0004; voice_prefix=A30; voice_category=3; scene=C_5
#: C_5:987
msgctxt "text_id=18252 | speaker=soujuurou"
msgid "\"Isn't it obvious? It's the same as last time."
msgstr "「だって、ほら。状況はあの時と一緒だ。"

#. Occurrence C_5:1005:18253: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_5_0005; voice_prefix=A30; voice_category=3; scene=C_5
#: C_5:1005
msgctxt "text_id=18253 | speaker=soujuurou"
msgid "  If you go down, I step in, right? So I'm here."
msgstr "　君がやられたら、次はこっちの番なんだろう？　だから協力をしに来たんじゃないか。"

#. Occurrence C_5:1011:18254: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_5_0006; voice_prefix=A30; voice_category=3; scene=C_5
#: C_5:1011
msgctxt "text_id=18254 | speaker=soujuurou"
msgid "  Okay, I still can't do anything, but still...\""
msgstr "　……まあ。何もできないのも、あの時と変わってはいないんだけど」"

#. Occurrence C_5:1058:18255: scene=C_5
#: C_5:1058
msgctxt "text_id=18255 | speaker=unknown"
msgid "  Aoko did not know what to say."
msgstr "　青子には答えもない。"

#. Occurrence C_5:1063:18256: scene=C_5
#: C_5:1063
msgctxt "text_id=18256 | speaker=unknown"
msgid "  She could only look up at him, amazed and awed."
msgstr "　ただ呆然と顔をあげて、本気で呆れるように、草十郎を見つめ返す事しかできなかった。"

#. Occurrence C_5:1111:18257: scene=C_5
#: C_5:1111
msgctxt "text_id=18257 | speaker=unknown"
msgid "  The werewolf stared at them, visibly frustrated."
msgstr "　そんなふたりを、人狼は<苛立|いらだ>たしく見つめている。"

#. Occurrence C_5:1116:18258: scene=C_5
#: C_5:1116
msgctxt "text_id=18258 | speaker=unknown"
msgid "  After all, he believed himself to be the noblest of all creatures."
msgstr "　彼には王者としての自意識がある。"

#. Occurrence C_5:1121:18259: scene=C_5
#: C_5:1121
msgctxt "text_id=18259 | speaker=unknown"
msgid "  Ignoring him was treason, punishable by death. Had Touko not been there, he would have sunk his teeth into Soujyuro's neck by now."
msgstr "　無視されただけでも<轢殺|れきさつ>もので、橙子さえいなければサクッと草十郎の喉を噛みちぎっている。"

#. Occurrence C_5:1158:18260: scene=C_5
#: C_5:1158
msgctxt "text_id=18260 | speaker=unknown"
msgid "  He was sure he had been intimidating enough."
msgstr "　自分の重圧は確かに伝わっている筈だ。"

#. Occurrence C_5:1163:18261: scene=C_5
#: C_5:1163
msgctxt "text_id=18261 | speaker=unknown"
msgid "  However, his prey did not show any signs of fear."
msgstr "　なのに獲物からは、まったく恐れが伝わってこない。"

#. Occurrence C_5:1168:18262: scene=C_5
#: C_5:1168
msgctxt "text_id=18262 | speaker=unknown"
msgid "  It was hard to imagine, but maybe, just maybe..."
msgstr "　……考えづらいが、まさか、ひょっとして。"

#. Occurrence C_5:1185:18263: scene=C_5
#: C_5:1185
msgctxt "text_id=18263 | speaker=unknown"
msgid "  This guy did not view him as a threat."
msgstr "　あの人間の視界には、自分はどうでもいいモノとして映っているのではないだろうか―――？"

#. Occurrence C_5:1228:18264: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_5_0001; voice_prefix=A50; voice_category=12; scene=C_5
#: C_5:1228
msgctxt "text_id=18264 | speaker=beo"
msgid "\"Whatever. As long as the meat is tender, juicy, and filling, I don't care whose it is."
msgstr "「……まあ、誰でもいいんだけど。筋ばった肉は歯ごたえがあっていいし、何より食いでがある。"

#. Occurrence C_5:1234:18265: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_5_0002; voice_prefix=A50; voice_category=12; scene=C_5
#: C_5:1234
msgctxt "text_id=18265 | speaker=beo"
msgid "  Hey, you. You don't mind if I start with you, do you?\""
msgstr "　先に、そのお兄さんからハジメテもかまわないよね？」"

#. Occurrence C_5:1295:18266: scene=C_5
#: C_5:1295
msgctxt "text_id=18266 | speaker=unknown"
msgid "  The boy wolf called out once again."
msgstr "　少年はもう一度呼びかけた。"

#. Occurrence C_5:1300:18267: scene=C_5
#: C_5:1300
msgctxt "text_id=18267 | speaker=unknown"
msgid "  Still not responding, Soujyuro raised a hand to his nose."
msgstr "　それにも応えず、草十郎は片手をゆっくりと鼻にあてた。"

#. Occurrence C_5:1305:18268: scene=C_5
#: C_5:1305
msgctxt "text_id=18268 | speaker=unknown"
msgid "  Cool, calm, and collected."
msgstr "　<極|きわ>めて冷静に。"

#. Occurrence C_5:1310:18269: scene=C_5
#: C_5:1310
msgctxt "text_id=18269 | speaker=unknown"
msgid "  Paying no mind to the boy, yet keeping an eye on him."
msgstr "　少年に意識は向けず、けれど目は逸らさず。"

#. Occurrence C_5:1349:18270: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_5_0007; voice_prefix=A30; voice_category=3; scene=C_5
#: C_5:1349
msgctxt "text_id=18270 | speaker=soujuurou"
msgid "\"...Something reeks.\""
msgstr "「……匂うな」"

#. Occurrence C_5:1368:18271: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_5_0003; voice_prefix=A50; voice_category=12; scene=C_5
#: C_5:1368
msgctxt "text_id=18271 | speaker=beo"
msgid "\"...?\""
msgstr "「…………？」"

#. Occurrence C_5:1421:18272: scene=C_5
#: C_5:1421
msgctxt "text_id=18272 | speaker=unknown"
msgid "  Everyone present was confused."
msgstr "　不快げに呟かれた声に誰もが首をかしげる。"

#. Occurrence C_5:1426:18273: scene=C_5
#: C_5:1426
msgctxt "text_id=18273 | speaker=unknown"
msgid "  No one seemed to be able to smell anything but him."
msgstr "　彼の言う匂いなんて、少しも嗅ぎ取れないからだ。"

#. Occurrence C_5:1468:18274: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_5_0004; voice_prefix=A50; voice_category=12; scene=C_5
#: C_5:1468
msgctxt "text_id=18274 | speaker=beo"
msgid "\"Oh? What do you smell, mister?\""
msgstr "「……へえ。何が匂うって言うのかな、お兄さん」"

#. Occurrence C_5:1485:18275: scene=C_5
#: C_5:1485
msgctxt "text_id=18275 | speaker=unknown"
msgid "  Beo's voice retained his usual arrogance, but was tinged with impatience."
msgstr "　余裕に満ちてはいるが、苛立ちに急かされた声。"

#. Occurrence C_5:1496:18276: scene=C_5
#: C_5:1496
msgctxt "text_id=18276 | speaker=unknown"
msgid "  The boy was unable to hide his irritation at being ignored."
msgstr "　<度重|たびかさ>なる無視に少年は怒気を抑えきれない。"

#. Occurrence C_5:1501:18277: scene=C_5
#: C_5:1501
msgctxt "text_id=18277 | speaker=unknown"
msgid "  Finally, Soujyuro turned to face the boy just a short distance from him."
msgstr "　それでようやく、草十郎は遠くの、けれど真っ正面にいる少年へと体を向けた。"

#. Occurrence C_5:1559:18278: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_5_0008; voice_prefix=A30; voice_category=3; scene=C_5
#: C_5:1559
msgctxt "text_id=18278 | speaker=soujuurou"
msgid "\"It's like rotten meat. This is why I hate dogs.\""
msgstr "「品のない肉の匂いがする。これだから犬は嫌いなんだ」"

#. Occurrence C_5:1565:18279: scene=C_5
#: C_5:1565
msgctxt "text_id=18279 | speaker=unknown"
msgid "  His voice was filled with disgust and contempt."
msgstr "　心底から不快だ、と言わんばかりの声。"

#. Occurrence C_5:1571:18280: scene=C_5
#: C_5:1571
msgctxt "text_id=18280 | speaker=unknown"
msgid "  Soujyuro was mainly speaking to himself,"
msgstr "　草十郎にとってはただの独り言。"

#. Occurrence C_5:1577:18281: scene=C_5
#: C_5:1577
msgctxt "text_id=18281 | speaker=unknown"
msgid "  but the werewolf boy had never felt so insulted."
msgstr "　少年にとって侮辱以外の何物でもない。"

#. Occurrence C_5:1583:18282: scene=C_5
#: C_5:1583
msgctxt "text_id=18282 | speaker=unknown"
msgid "  Even if that was not Soujyuro's intent at all."
msgstr "　草十郎本人に、そんなつもりが全くなかったとしても。"

#. Occurrence C_5:1642:18283: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_5_0005; voice_prefix=A50; voice_category=12; scene=C_5
#: C_5:1642
msgctxt "text_id=18283 | speaker=beo"
msgid "\"...Hmph.\""
msgstr "「―――、は」"

#. Occurrence C_5:1648:18284: scene=C_5
#: C_5:1648
msgctxt "text_id=18284 | speaker=unknown"
msgid "  In a moment, the wind picked up,"
msgstr "　瞬間、たしかに風が吹いた。"

#. Occurrence C_5:1653:18285: scene=C_5
#: C_5:1653
msgctxt "text_id=18285 | speaker=unknown"
msgid "  perhaps signaling a change in the werewolf's mood."
msgstr "　人狼に起きた感情の変化だろう。"

#. Occurrence C_5:1658:18286: scene=C_5
#: C_5:1658
msgctxt "text_id=18286 | speaker=unknown"
msgid "  A fiery gale whipped around, carving patterns in the snow."
msgstr "　獣気は大気を焼く風になって、雪原に<風紋|ふうもん>を走らせた。"

#. Occurrence C_5:1716:18287: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_5_0003; voice_prefix=A10; voice_category=1; scene=C_5
#: C_5:1716
msgctxt "text_id=18287 | speaker=aoko"
msgid "\"Soujyuro...!\""
msgstr "「草十郎…………！」"

#. Occurrence C_5:1722:18288: scene=C_5
#: C_5:1722
msgctxt "text_id=18288 | speaker=unknown"
msgid "  Sensing he was about to be killed, Aoko desperately tried to move."
msgstr "　このままでは草十郎が真っ先に殺される、と青子は体に力をいれた。"

#. Occurrence C_5:1727:18289: scene=C_5
#: C_5:1727
msgctxt "text_id=18289 | speaker=unknown"
msgid "  But her broken body would not respond."
msgstr "　だが、壊れた体は指先ぐらいしか動かない。"

#. Occurrence C_5:1732:18290: scene=C_5
#: C_5:1732
msgctxt "text_id=18290 | speaker=unknown"
msgid "  After hearing Soujyuro's insult, Alice was unsuccessfully struggling to get to her feet, too."
msgstr "　見れば、草十郎の失言だけは聞こえていたのか、有珠もなんとか立ち上がろうとしている。"

#. Occurrence C_5:1771:18291: scene=C_5
#: C_5:1771
msgctxt "text_id=18291 | speaker=unknown"
msgid "  In complete contrast, Soujyuro stood there."
msgstr "　草十郎の姿は、そんなふたりとは対照的だった。"

#. Occurrence C_5:1776:18292: scene=C_5
#: C_5:1776
msgctxt "text_id=18292 | speaker=unknown"
msgid "  Firmly and unfazed."
msgstr "　<泰然|たいぜん>としてさえ見える立ち姿。"

#. Occurrence C_5:1781:18293: scene=C_5
#: C_5:1781
msgctxt "text_id=18293 | speaker=unknown"
msgid "  The little blond boy's well of patience had run dry."
msgstr "　少年の苛立ちは、それで限界を超えてしまった。"

#. Occurrence C_5:1826:18294: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_5_0006_0; voice_prefix=A50; voice_category=12; scene=C_5
#: C_5:1826
msgctxt "text_id=18294 | speaker=beo"
msgid "\"...I get it. You're underestimating me because I look like a kid, huh?"
msgstr "「……そうか。ようするに、ボクが子供だからって舐めてるんだね、"

#. Occurrence C_5:1840:18295: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_5_0006_1; voice_prefix=A50; voice_category=12; scene=C_5
#: C_5:1840
msgctxt "text_id=18295 | speaker=beo"
msgid " BIG mistake!\""
msgstr "お兄さんは…………！」"

#. Occurrence C_5:1946:18296: scene=C_5
#: C_5:1946
msgctxt "text_id=18296 | speaker=unknown"
msgid "  His time playing human was over."
msgstr "　―――人間の時間が終わる。"

#. Occurrence C_5:1954:18297: scene=C_5
#: C_5:1954
msgctxt "text_id=18297 | speaker=unknown"
msgid "  Enraged, the boy transformed."
msgstr "　怒気を含んだ言葉と共に、少年の<躯|からだ>が変化する。"

#. Occurrence C_5:1959:18298: scene=C_5
#: C_5:1959
msgctxt "text_id=18298 | speaker=unknown"
msgid "  He grew larger and larger, golden fur sprouting from his pale flesh."
msgstr "　肉体はさらに大きく、その肌は悪魔の牙めいた、刺々しい毛並みに包まれていく。"

#. Occurrence C_5:2156:18299: scene=C_5
#: C_5:2156
msgctxt "text_id=18299 | speaker=unknown"
msgid "  His mouth grew razor-sharp fangs; his hands grew claws."
msgstr "　人間の物だった顔も手も、いびつなカタチに膨れ上がっていく。"

#. Occurrence C_5:2161:18300: scene=C_5
#: C_5:2161
msgctxt "text_id=18300 | speaker=unknown"
msgid "  Drawing from the magical energy in the air, he transformed into a preternatural beast: a wolf in the shape of a human."
msgstr "　それは大気中の魔力を取りこみ、存在規模を膨張させていく異形の獣―――ヒトのカタチをした、狼の姿だった。"

#. Occurrence C_5:2183:18301: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_5_0000; voice_prefix=A20; voice_category=11; scene=C_5
#: C_5:2183
msgctxt "text_id=18301 | speaker=touko"
msgid "\"Beo! Did I say you could transform?!\""
msgstr "「獣化の許しは出していないぞ、ベオ……！」"

#. Occurrence C_5:2195:18302: scene=C_5
#: C_5:2195
msgctxt "text_id=18302 | speaker=unknown"
msgid "  Touko yelled at him, but the werewolf did not respond."
msgstr "　傍観していた橙子が叫ぶが、人狼と化した少年は応えない。"

#. Occurrence C_5:2200:18303: scene=C_5
#: C_5:2200
msgctxt "text_id=18303 | speaker=unknown"
msgid "  He only huffed deep breaths of hot air."
msgstr "　その荒い息遣いをケモノの口から吐き出すだけだ。"

#. Occurrence C_5:2253:18304: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_5_0009; voice_prefix=A30; voice_category=3; scene=C_5
#: C_5:2253
msgctxt "text_id=18304 | speaker=soujuurou"
msgid "\"Did you really just...?\""
msgstr "「そんな、バカな話、が」"

#. Occurrence C_5:2259:18305: scene=C_5
#: C_5:2259
msgctxt "text_id=18305 | speaker=unknown"
msgid "  That was all Soujyuro could say in response to the boy's metamorphosis."
msgstr "　少年の変身を見届けて、ぽつりと草十郎は漏らす。"

#. Occurrence C_5:2264:18306: scene=C_5
#: C_5:2264
msgctxt "text_id=18306 | speaker=unknown"
msgid "  Such a transformation was the stuff of nightmares."
msgstr "　人から獣に変わっただけでも悪夢なのだ。"

#. Occurrence C_5:2269:18307: scene=C_5
#: C_5:2269
msgctxt "text_id=18307 | speaker=unknown"
msgid "  What was worse, the beast now towered above him. It was enough to make anybody question reality itself."
msgstr "　加えて、自分より小さかった少年が二メートル近い大きさになれば、もう理解の外だろう。正常な理性が残っているかすら怪しい。"

#. Occurrence C_5:2296:18308: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_5_0010; voice_prefix=A30; voice_category=3; scene=C_5
#: C_5:2296
msgctxt "text_id=18308 | speaker=soujuurou"
msgid "\"Amazing.\" "
msgstr "「……驚いた」"

#. Occurrence C_5:2325:18309: scene=C_5
#: C_5:2325
msgctxt "text_id=18309 | speaker=unknown"
msgid "  Seeing his prey's reaction satisfied the werewolf, and his maw twisted into a satisfied grin."
msgstr "　獲物の呟きに、人狼は満足そうに口元を歪ませた。"

#. Occurrence C_5:2330:18310: scene=C_5
#: C_5:2330
msgctxt "text_id=18310 | speaker=unknown"
msgid "  He was a strange one, this guy, but meat was meat."
msgstr "　おかしな人間だったが、結局はいつも通りだと。"

#. Occurrence C_5:2363:18311: scene=C_5
#: C_5:2363
msgctxt "text_id=18311 | speaker=unknown"
msgid "  However..."
msgstr "　……けれど。"

#. Occurrence C_5:2369:18312: scene=C_5
#: C_5:2369
msgctxt "text_id=18312 | speaker=unknown"
msgid "the beast's arrogance was short lived."
msgstr "彼の虚栄心が満たされたのはほんの一瞬。"

#. Occurrence C_5:2374:18313: scene=C_5
#: C_5:2374
msgctxt "text_id=18313 | speaker=unknown"
msgid "  The prey breathed a sigh of exasperation before speaking."
msgstr "　狩られるだけの<獲物|にんげん>は、心底呆れたように息をついて、"

#. Occurrence C_5:2400:18314: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_5_0011; voice_prefix=A30; voice_category=3; scene=C_5
#: C_5:2400
msgctxt "text_id=18314 | speaker=soujuurou"
msgid "\"You really are a dog.\""
msgstr "「それじゃ、ほんとに犬そのものじゃないか」"

#. Occurrence C_5:2476:18315: voice_id=X30_C_5_0000; voice_prefix=X30; voice_category=0; scene=C_5
#: C_5:2476
msgctxt "text_id=18315 | speaker=unknown"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence C_5:2482:18316: scene=C_5
#: C_5:2482
msgctxt "text_id=18316 | speaker=unknown"
msgid "  You could hear a pin drop, even in the snow."
msgstr "　<木|こ>っ<端|ぱ><微塵|みじん>に砕け散るような沈黙。"

#. Occurrence C_5:2487:18317: scene=C_5
#: C_5:2487
msgctxt "text_id=18317 | speaker=unknown"
msgid "  Aoko, Alice, and Touko were all dumbfounded."
msgstr "　青子も有珠も、橙子さえも声がない。"

#. Occurrence C_5:2539:18318: scene=C_5
#: C_5:2539
msgctxt "text_id=18318 | speaker=unknown"
msgid "  Were they really seeing a human not just stare a werewolf down, but insult it to its face?"
msgstr "　自分たちでさえ目を<背|そむ>ける人狼の獣化を目の当たりにして、まさか、そんな言葉を返せる人間がいようとは。"

#. Occurrence C_5:2580:18319: scene=C_5
#: C_5:2580
msgctxt "text_id=18319 | speaker=unknown"
msgid "  They simply could not believe it."
msgstr "　楽観者は子供騙しの映画を見たような不満顔。"

#. Occurrence C_5:2616:18320: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_5_0007; voice_prefix=A50; voice_category=12; scene=C_5
#: C_5:2616
msgctxt "text_id=18320 | speaker=beo"
msgid "\"-, -, -!\""
msgstr "「“―――、―――、―――”」"

#. Occurrence C_5:2625:18321: scene=C_5
#: C_5:2625
msgctxt "text_id=18321 | speaker=unknown"
msgid "  It was too late."
msgstr "　……もはや、何もかも手遅れだった。"

#. Occurrence C_5:2645:18322: scene=C_5
#: C_5:2645
msgctxt "text_id=18322 | speaker=unknown"
msgid "  Any trace of the wolf's pride or dignity"
msgstr "　絶対者としての風格。"

#. Occurrence C_5:2650:18323: scene=C_5
#: C_5:2650
msgctxt "text_id=18323 | speaker=unknown"
msgid "  faded away."
msgstr "　最強を自負していた人狼から、感情の起こりが消えていく。"

#. Occurrence C_5:2656:18324: scene=C_5
#: C_5:2656
msgctxt "text_id=18324 | speaker=unknown"
msgid "  The onlookers finally realized that the wolf was serious."
msgstr "　つまり本気になったのだ、と理解できた者は何人いたか。"

#. Occurrence C_5:2705:18325: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_5_0001; voice_prefix=A20; voice_category=11; scene=C_5
#: C_5:2705
msgctxt "text_id=18325 | speaker=touko"
msgid "\"Beo! Do NOT kill him!\""
msgstr "「ベオ、殺すな―――！」"

#. Occurrence C_5:2711:18326: scene=C_5
#: C_5:2711
msgctxt "text_id=18326 | speaker=unknown"
msgid "  But Touko's command fell on deaf ears."
msgstr "　仮初めの主人の制止など、金の獣には届かない。"

#. Occurrence C_5:2716:18327: scene=C_5
#: C_5:2716
msgctxt "text_id=18327 | speaker=unknown"
msgid "  The wolf prepared to lunge, his emerald eyes fixed on Soujyuro not thirty feet in front of him."
msgstr "　人狼は前傾姿勢になりながら、たった十メートル先の草十郎を凝視する。"

#. Occurrence C_5:2776:18328: scene=C_5
#: C_5:2776
msgctxt "text_id=18328 | speaker=unknown"
msgid "  A mere thirty feet."
msgstr "　そう、たった十メートル。"

#. Occurrence C_5:2781:18329: scene=C_5
#: C_5:2781
msgctxt "text_id=18329 | speaker=unknown"
msgid "  A half-second was all he needed."
msgstr "　<突進|はし>って０．５秒。"

#. Occurrence C_5:2786:18330: scene=C_5
#: C_5:2786
msgctxt "text_id=18330 | speaker=unknown"
msgid "  Another half-second to bring his claw down, and slice his prey from head to toe."
msgstr "　上から下、顔から足首まで、その爪で三枚に下ろすのにさらに０．５秒。"

#. Occurrence C_5:2796:18331: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_5_0008; voice_prefix=A50; voice_category=12; scene=C_5
#: C_5:2796
msgctxt "text_id=18331 | speaker=beo"
msgid "\"You're dead!\""
msgstr "「“死んだよ、おまえ……！”」"

#. Occurrence C_5:2862:18332: scene=C_5
#: C_5:2862
msgctxt "text_id=18332 | speaker=unknown"
msgid "  A roar of joyous, unbridled fury echoed far and wide."
msgstr "　凶悪な<悦|よろこ>びに満ちた呟き。"

#. Occurrence C_5:2867:18333: scene=C_5
#: C_5:2867
msgctxt "text_id=18333 | speaker=unknown"
msgid "  It was the only warning the werewolf gave as he exploded toward Soujyuro."
msgstr "　それだけを合図にして、人狼は草十郎へと弾け跳ぶ。"

#. Occurrence C_5:2873:18334: scene=C_5
#: C_5:2873
msgctxt "text_id=18334 | speaker=unknown"
msgid "  One second."
msgstr "　まさしく一秒。"

#. Occurrence C_5:2878:18335: scene=C_5
#: C_5:2878
msgctxt "text_id=18335 | speaker=unknown"
msgid "  A golden blur swept forth in a furious gust, too fast for eyes to follow."
msgstr "　金の毛並みは残像<遥|はる>かに、それは、暴風にしか見えない程の<速度|たけり>だった。"

#. Occurrence C_5B:36:18336: scene=C_5B
#: C_5B:36
msgctxt "text_id=18336 | speaker=unknown"
msgid "  In the face of unworldly speed, there was only one thing to do."
msgstr "　―――ならば、それは神速か。"

#. Occurrence C_5B:47:18337: scene=C_5B
#: C_5B:47
msgctxt "text_id=18337 | speaker=unknown"
msgid "  Soujyuro stepped forward, a silent shadow opposite the beastly silhouette of the incoming werewolf."
msgstr "　弾け跳んだ人狼が黒影なら、<迎|むか>え撃たんと踏みこむ彼も無音の影。"

#. Occurrence C_5B:52:18338: scene=C_5B
#: C_5B:52
msgctxt "text_id=18338 | speaker=unknown"
msgid "  He needed exactly three paces."
msgstr "　向かうべき位置はきっかり三歩分。"

#. Occurrence C_5B:57:18339: scene=C_5B
#: C_5B:57
msgctxt "text_id=18339 | speaker=unknown"
msgid "  He bet his entire life on around three feet of distance."
msgstr "　その、わずか一メートルの前進に、彼は<人生|おのれ>の全てを<賭|と>した。"

#. Occurrence C_5B:107:18340: scene=C_5B
#: C_5B:107
msgctxt "text_id=18340 | speaker=unknown"
msgid "  In the blink of an eye, death would be upon him."
msgstr "　<瞬|またた>きひとつ分の時間で迫る死。"

#. Occurrence C_5B:112:18341: scene=C_5B
#: C_5B:112
msgctxt "text_id=18341 | speaker=unknown"
msgid "  Yet, he did not show the slightest indication he intended to avoid the lunging behemoth."
msgstr "　疾走する巨大な暴力を前にして、彼は避ける素振りさえ見せなかった。"

#. Occurrence C_5B:185:18342: scene=C_5B
#: C_5B:185
msgctxt "text_id=18342 | speaker=unknown"
msgid "  The wolf's foreleg slammed into the ground with earth-shaking fury."
msgstr "　地面よ割れよとばかりに踏みこまれる前<脚|あし>。"

#. Occurrence C_5B:319:18343: scene=C_5B
#: C_5B:319
msgctxt "text_id=18343 | speaker=unknown"
msgid "  His back muscles tensed up so much they seemed barely contained in his frame, as he swept a raised paw downward."
msgstr "　ありあまる脚力が、はち切れんばかりの<背筋|はいきん>が、人狼の腕を振り下ろさせる。"

#. Occurrence C_5B:383:18344: scene=C_5B
#: C_5B:383
msgctxt "text_id=18344 | speaker=unknown"
msgid "  Soujyuro's small step neatly evaded the claws."
msgstr "　わずかな踏み込みが人狼の爪を<躱|かわ>す。"

#. Occurrence C_5B:388:18345: scene=C_5B
#: C_5B:388
msgctxt "text_id=18345 | speaker=unknown"
msgid "  But he had a different motive."
msgstr "　しかし、彼が飛びこんだのは回避の為ではない。"

#. Occurrence C_5B:393:18346: scene=C_5B
#: C_5B:393
msgctxt "text_id=18346 | speaker=unknown"
msgid "  He was merely positioning himself for the next move."
msgstr "　彼にはただ、この位置が必要だっただけ。"

#. Occurrence C_5B:399:18347: scene=C_5B
#: C_5B:399
msgctxt "text_id=18347 | speaker=unknown"
msgid "  His intention was never to avoid anything."
msgstr "　そも、<躱|かわ>すも<躱|かわ>さないもない。"

#. Occurrence C_5B:404:18348: scene=C_5B
#: C_5B:404
msgctxt "text_id=18348 | speaker=unknown"
msgid "  From the beginning, his mind was focused on but one thing."
msgstr "　彼の思考には初めから、<そ|・><の|・><点|・>しか存在しない。"

#. Occurrence C_5B:445:18349: scene=C_5B
#: C_5B:445
msgctxt "text_id=18349 | speaker=unknown"
msgid "  One point to aim for."
msgstr "　―――狙うは一点。"

#. Occurrence C_5B:475:18350: scene=C_5B
#: C_5B:475
msgctxt "text_id=18350 | speaker=unknown"
msgid "  One mind."
msgstr "　意識の同一、"

#. Occurrence C_5B:519:18351: scene=C_5B
#: C_5B:519
msgctxt "text_id=18351 | speaker=unknown"
msgid "  One breath."
msgstr "　呼吸の合致。"

#. Occurrence C_5B:561:18352: scene=C_5B
#: C_5B:561
msgctxt "text_id=18352 | speaker=unknown"
msgid "  He picked the perfect opening in the wolf's torso, the precise microsecond between contraction and relaxation."
msgstr "　<体幹|たいかん>の見切りと筋肉の<凝固|ぎょうこ><弛緩|しかん>その<隙間|すきま>。"

#. Occurrence C_5B:595:18353: scene=C_5B
#: C_5B:595
msgctxt "text_id=18353 | speaker=unknown"
msgid "  That one point alone was the crack in the dam of life."
msgstr "　その地点こそ、唯一とも言える、<生命|いのち>の壁の亀裂である。"

#. Occurrence C_5B:949:18354: scene=C_5B
#: C_5B:949
msgctxt "text_id=18354 | speaker=unknown"
msgid "  He punched the werewolf in its chest, with his feeble human strength."
msgstr "　人狼の胸に<叩|たた>きつけられる、あまりにも弱い人の力。"

#. Occurrence C_5B:992:18355: scene=C_5B
#: C_5B:992
msgctxt "text_id=18355 | speaker=unknown"
msgid "  There was a dull thud, and a burst of blood."
msgstr "　鈍い打撃音と、飛び散る血飛沫。"

#. Occurrence C_5B:997:18356: scene=C_5B
#: C_5B:997
msgctxt "text_id=18356 | speaker=unknown"
msgid "  The twisted flesh and gore were all Soujyuro's own."
msgstr "　肉片も流血もすべては彼のもの。"

#. Occurrence C_5B:1066:18357: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_5B_0000; voice_prefix=A50; voice_category=12; scene=C_5B
#: C_5B:1066
msgctxt "text_id=18357 | speaker=beo"
msgid "\"...?!\""
msgstr "「“、―――！？”」"

#. Occurrence C_5B:1072:18358: scene=C_5B
#: C_5B:1072
msgctxt "text_id=18358 | speaker=unknown"
msgid "  The werewolf's raised claw convulsed."
msgstr "　振り上げた人狼の爪が<痙攣|けいれん>する。"

#. Occurrence C_5B:1077:18359: scene=C_5B
#: C_5B:1077
msgctxt "text_id=18359 | speaker=unknown"
msgid "  From an insignificant impact, the beast's body was the first to collapse, then his spirit."
msgstr "　人狼の精神より先に、人狼の肉体が、取るに足りない衝撃に虚脱した。"

#. Occurrence C_5B:1098:18360: scene=C_5B
#: C_5B:1098
msgctxt "text_id=18360 | speaker=unknown"
msgid "  There was a moment of utter incomprehension."
msgstr "　正体の分からない一瞬の不明。"

#. Occurrence C_5B:1104:18361: scene=C_5B
#: C_5B:1104
msgctxt "text_id=18361 | speaker=unknown"
msgid "  The wolf opened his jaws to try and pull air into his lungs."
msgstr "　息を吐こうと喉をあげる狼の口。"

#. Occurrence C_5B:1110:18362: scene=C_5B
#: C_5B:1110
msgctxt "text_id=18362 | speaker=unknown"
msgid "  Gasping, he began to topple forward."
msgstr "　狼は知らず、あえぐようにうつぶせに倒れかける。"

#. Occurrence C_5B:1162:18363: scene=C_5B
#: C_5B:1162
msgctxt "text_id=18363 | speaker=unknown"
msgid "  The slender figure slipped around to his flank."
msgstr "　その横を、か細い人影がすり抜ける。"

#. Occurrence C_5B:1327:18364: scene=C_5B
#: C_5B:1327
msgctxt "text_id=18364 | speaker=unknown"
msgid "  The next blow pierced him like a spear."
msgstr "　衝撃は短い槍のように。"

#. Occurrence C_5B:1332:18365: scene=C_5B
#: C_5B:1332
msgctxt "text_id=18365 | speaker=unknown"
msgid "  Ignoring his mangled left arm, the silhouette whirled around and drove his right elbow into the collapsing werewolf's back."
msgstr "　人影は折れた左腕を<庇|かば>いもせず、前のめりに倒れこむ人狼の背中へ、残る右腕を<抉|えぐ>り打つ。"

#. Occurrence C_5B:1393:18366: scene=C_5B
#: C_5B:1393
msgctxt "text_id=18366 | speaker=unknown"
msgid "  There was another muffled impact."
msgstr "　もう一度、鈍い音がした。"

#. Occurrence C_5B:1398:18367: scene=C_5B
#: C_5B:1398
msgctxt "text_id=18367 | speaker=unknown"
msgid "  The second strike penetrated to the exact same spot the first strike had, crushing the beast's heart."
msgstr "　正面から<穿|うが>った位置と寸分違わぬ箇所を<貫|つ>く、心臓を圧する破裂の<楔|くさび>。"

#. Occurrence C_5B:1403:18368: scene=C_5B
#: C_5B:1403
msgctxt "text_id=18368 | speaker=unknown"
msgid "  This time, the blood that flew into the air belonged to the gasping wolf."
msgstr "　一度目と違うのは飛び散る<血潮|ちしお>がない事と、獣のあえぎがした事だけ。"

#. Occurrence C_5B:1492:18369: scene=C_5B
#: C_5B:1492
msgctxt "text_id=18369 | speaker=unknown"
msgid "  The werewolf fell to the ground, choking on his own blood."
msgstr "　ガ、と吐血をして人狼は倒れこんだ。"

#. Occurrence C_5B:1497:18370: scene=C_5B
#: C_5B:1497
msgctxt "text_id=18370 | speaker=unknown"
msgid "  He did not get up."
msgstr "　立ち上がる気配はない。"

#. Occurrence C_5B:1503:18371: scene=C_5B
#: C_5B:1503
msgctxt "text_id=18371 | speaker=unknown"
msgid "He showed no sign of life."
msgstr "なぎ払われた命はない。"

#. Occurrence C_5B:1555:18372: scene=C_5B
#: C_5B:1555
msgctxt "text_id=18372 | speaker=unknown"
msgid "  It was over."
msgstr "　<以|もっ>て事は終わった。"

#. Occurrence C_5B:1560:18373: scene=C_5B
#: C_5B:1560
msgctxt "text_id=18373 | speaker=unknown"
msgid "  There was no remorse, no hesitation in that brief act of violence."
msgstr "　振るわれた暴力に一切の<撓|たわ>みなく、"

#. Occurrence C_5B:1565:18374: scene=C_5B
#: C_5B:1565
msgctxt "text_id=18374 | speaker=unknown"
msgid "  The perfect, furious, golden beast lay still."
msgstr "　猛る金獣の四肢、無欠にして<天賦|てんぷ><盤石|ばんじゃく>。"

#. Occurrence C_5B:1570:18375: scene=C_5B
#: C_5B:1570
msgctxt "text_id=18375 | speaker=unknown"
msgid "  Felled in a mere three seconds."
msgstr "　されど。わずか三秒の<交|まじ>わりで、人狼は敗北した。"

#. Occurrence C_5B:1651:18376: voice_id=X30_C_5B_0000; voice_prefix=X30; voice_category=0; scene=C_5B
#: C_5B:1651
msgctxt "text_id=18376 | speaker=unknown"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence C_5B:1657:18377: scene=C_5B
#: C_5B:1657
msgctxt "text_id=18377 | speaker=unknown"
msgid "  No sane person would have bet on this outcome."
msgstr "　この世のものとは思えない結末に誰もが目を疑う。"

#. Occurrence C_5B:1686:18378: scene=C_5B
#: C_5B:1686
msgctxt "text_id=18378 | speaker=unknown"
msgid "  His breathing calm, the victor stood over the fallen behemoth's body."
msgstr "　当事者は呼吸さえ乱さず、淡々と、倒れ<臥|ふ>した人狼を見下ろしていた。"

msgctxt "text_id=18379 | speaker=unknown"
msgid "  There was only one thing to do."
msgstr "　ならば、それは神速か。"

msgctxt "text_id=18380 | speaker=unknown"
msgid "  Soujyuro stepped forward, a silent shadow opposite the beastly silhouette of the incoming werewolf."
msgstr "　弾け跳んだ人狼が黒影なら、<迎|むか>え撃たんと踏みこむ彼も無音の黒影。"

msgctxt "text_id=18381 | speaker=unknown"
msgid "  He needed exactly three paces."
msgstr "　向かうべき位置はきっかり三歩分。"

msgctxt "text_id=18382 | speaker=unknown"
msgid "  He bet his entire life on around three feet of distance."
msgstr "　その、わずか一メートルの前進に、彼は<人生|おのれ>の全てを<賭|と>した。"

msgctxt "text_id=18383 | speaker=unknown"
msgid "\"...\""
msgstr "「――――――」"

msgctxt "text_id=18384 | speaker=unknown"
msgid "  Something just as otherworldly had occurred. You had to be there to believe it."
msgstr "　この世のものとは思えない結末に、当事者以外の誰もが目を疑う。"

msgctxt "text_id=18385 | speaker=unknown"
msgid "  Taking it all in, standing above the fallen werewolf was none other than an ordinary boy, named Soujyuro Sizuki."
msgstr "　それを一身に受けながら、人狼を見下ろしているのは言うまでもなく、静希草十郎という名前の、ごく当たり前の少年だった。"

#. Occurrence C_6:40:18386: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0000; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:40
msgctxt "text_id=18386 | speaker=beo"
msgid "\"...But... how...?\""
msgstr "“……なんで……ボクが……？”"

#. Occurrence C_6:61:18387: scene=C_6
#: C_6:61
msgctxt "text_id=18387 | speaker=unknown"
msgid "  Even as the beast lay crumpled in the snow, he could not grasp what had happened."
msgstr "　地面に倒れ臥した後でも、<人|カ><狼|レ>は自分に起きた出来事を把握できなかった。"

#. Occurrence C_6:66:18388: scene=C_6
#: C_6:66
msgctxt "text_id=18388 | speaker=unknown"
msgid "  His heart had ruptured, cutting the blood flow to his body and brain, leaving him helpless."
msgstr "　心臓が破裂し、血液の逆流によって脳をふくむ身体機能が停止し、地面に倒れこんだ。"

#. Occurrence C_6:71:18389: scene=C_6
#: C_6:71
msgctxt "text_id=18389 | speaker=unknown"
msgid "  That much he knew."
msgstr "　そこまでは確認できる。"

#. Occurrence C_6:76:18390: scene=C_6
#: C_6:76
msgctxt "text_id=18390 | speaker=unknown"
msgid "  If he were a normal creature, he would be dead."
msgstr "　通常の動物なら、それが死である事も承知している。"

#. Occurrence C_6:108:18391: scene=C_6
#: C_6:108
msgctxt "text_id=18391 | speaker=unknown"
msgid "  As it was, this was a trifling inconvenience."
msgstr "　だが<人|カ><狼|レ>にとってはどうでもいい問題だ。"

#. Occurrence C_6:121:18392: scene=C_6
#: C_6:121
msgctxt "text_id=18392 | speaker=unknown"
msgid "  Once his heart was repaired, his body would heal as well."
msgstr "　なにしろ心臓は復元を終え、身体機能はほぼ回復している。"

#. Occurrence C_6:126:18393: scene=C_6
#: C_6:126
msgctxt "text_id=18393 | speaker=unknown"
msgid "  It was not as if he had been struck by magecraft exceeding his own Mystical nature. This was little different than a grazed knee."
msgstr "　彼の神秘性を上回る魔術を受けた訳でもなし、こんな傷、小石につまずいたのと変わらない。"

#. Occurrence C_6:143:18394: scene=C_6
#: C_6:143
msgctxt "text_id=18394 | speaker=unknown"
msgid "  ..Which is what was so strange-"
msgstr "　……だから、<矛盾|もんだい>は。"

#. Occurrence C_6:148:18395: scene=C_6
#: C_6:148
msgctxt "text_id=18395 | speaker=unknown"
msgid "  Your heart does not stop from a grazed knee."
msgstr "　小石につまずいた程度で、心臓が止まる生き物はいないということ。"

#. Occurrence C_6:169:18396: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0001; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:169
msgctxt "text_id=18396 | speaker=beo"
msgid "\"...What did I... do wrong...?\""
msgstr "“……思い、出さないと……”"

#. Occurrence C_6:187:18397: scene=C_6
#: C_6:187
msgctxt "text_id=18397 | speaker=unknown"
msgid "  The werewolf frantically searched his memory."
msgstr "　<人|カ><狼|レ>は必死に記憶を呼び覚ます。"

#. Occurrence C_6:192:18398: scene=C_6
#: C_6:192
msgctxt "text_id=18398 | speaker=unknown"
msgid "  He managed to remember right up until the moment he raised his claws."
msgstr "　爪を振り上げたところまでは、なんとか思い出せる。"

#. Occurrence C_6:197:18399: scene=C_6
#: C_6:197
msgctxt "text_id=18399 | speaker=unknown"
msgid "  But what had come after that?"
msgstr "　論点はその後だ。"

#. Occurrence C_6:202:18400: scene=C_6
#: C_6:202
msgctxt "text_id=18400 | speaker=unknown"
msgid "  Given the right transformation, he knew he could withstand even a cannon blast. How had a puny human dropped him?"
msgstr "　形状次第では速射砲の直撃すら耐える自分が、なぜ、人間程度の腕力に倒されたのか。"

#. Occurrence C_6:234:18401: scene=C_6
#: C_6:234
msgctxt "text_id=18401 | speaker=unknown"
msgid "  Wait."
msgstr "　いや。"

#. Occurrence C_6:240:18402: scene=C_6
#: C_6:240
msgctxt "text_id=18402 | speaker=unknown"
msgid "Before that he had to figure out exactly what his opponent did to him."
msgstr "なぜ、と言うのなら、そもそも相手が何をしたのかが分からない。"

#. Occurrence C_6:258:18403: scene=C_6
#: C_6:258
msgctxt "text_id=18403 | speaker=unknown"
msgid "  The moment he got in close... Yes. He had felt a small impact."
msgstr "　たしか、<懐|ふところ>に入られた瞬間、小さな衝撃を一点に<搾|しぼ>りこむような接触があった。"

#. Occurrence C_6:263:18404: scene=C_6
#: C_6:263
msgctxt "text_id=18404 | speaker=unknown"
msgid "  The attack was so accurate that it probably only affected his heart."
msgstr "　あの正確な一撃によって、心臓だけがダメージを受けたのかもしれない。"

#. Occurrence C_6:308:18405: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0002; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:308
msgctxt "text_id=18405 | speaker=beo"
msgid "\"Hah...\""
msgstr "“ハ―――”"

#. Occurrence C_6:314:18406: scene=C_6
#: C_6:314
msgctxt "text_id=18406 | speaker=unknown"
msgid "  Ridiculous."
msgstr "　そんな馬鹿な話はない。"

#. Occurrence C_6:319:18407: scene=C_6
#: C_6:319
msgctxt "text_id=18407 | speaker=unknown"
msgid "  Even if that was possible, there was no way that that alone could stop a werewolf's heart."
msgstr "　仮にそうだとしても、それだけで止まる心臓なぞ<人|カ><狼|レ>は待ち合わせていない。"

#. Occurrence C_6:352:18408: scene=C_6
#: C_6:352
msgctxt "text_id=18408 | speaker=unknown"
msgid "  In the end, no matter how much he thought about it, nothing added up."
msgstr "　結局、どれだけ自問しても明確な答えはでなかった。"

#. Occurrence C_6:358:18409: scene=C_6
#: C_6:358
msgctxt "text_id=18409 | speaker=unknown"
msgid "  The answer was out of reach for a werewolf with no knowledge of being backed into a corner, let alone the limits of human skill."
msgstr "　そもそも“窮地に陥る”経験がなく、人間の<研磨|けんま>を知らない<人|カ><狼|レ>に、その答えは遠すぎた。"

#. Occurrence C_6:391:18410: scene=C_6
#: C_6:391
msgctxt "text_id=18410 | speaker=unknown"
msgid "  Only one thing was certain: he had lost."
msgstr "　なので、<人|カ><狼|レ>にとって確かな事は、己が倒れ臥している事実だけ。"

#. Occurrence C_6:396:18411: scene=C_6
#: C_6:396
msgctxt "text_id=18411 | speaker=unknown"
msgid "  He tried to piece together the sequence of events."
msgstr "　手探りで経緯を思い返す。"

#. Occurrence C_6:402:18412: scene=C_6
#: C_6:402
msgctxt "text_id=18412 | speaker=unknown"
msgid "  The explosion in his chest... The flash of white..."
msgstr "　―――胸に<炸裂|さくれつ>した衝撃と、一瞬の空白。"

#. Occurrence C_6:408:18413: scene=C_6
#: C_6:408
msgctxt "text_id=18413 | speaker=unknown"
msgid "  After that, as he was falling over, he took another blow to his back."
msgstr "　その後、相手におおい<被|かぶ>さるように倒れこむ<最中|さなか>、もう一度背中に衝撃が走ったのだ。"

#. Occurrence C_6:413:18414: scene=C_6
#: C_6:413
msgctxt "text_id=18414 | speaker=unknown"
msgid "  That was the one that disrupted his heart."
msgstr "　心臓を破ったのは、その一撃によるものらしい。"

#. Occurrence C_6:446:18415: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0003; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:446
msgctxt "text_id=18415 | speaker=beo"
msgid "(...This can't be. There's no way I...)"
msgstr "“……ふざけてる。そんな事で、ボクが―――”"

#. Occurrence C_6:467:18416: scene=C_6
#: C_6:467
msgctxt "text_id=18416 | speaker=unknown"
msgid "  Could lose? Indeed."
msgstr "　倒される筈はない。"

#. Occurrence C_6:472:18417: scene=C_6
#: C_6:472
msgctxt "text_id=18417 | speaker=unknown"
msgid "  It was physically impossible."
msgstr "　物理的に間違っている。"

#. Occurrence C_6:477:18418: scene=C_6
#: C_6:477
msgctxt "text_id=18418 | speaker=unknown"
msgid "  The boy gnashed his teeth and tensed his body in indignation at this unfair conclusion."
msgstr "　反則じみた結末に、少年は歯ぎしりをして全身に力をこめた。"

#. Occurrence C_6:498:18419: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0004; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:498
msgctxt "text_id=18419 | speaker=beo"
msgid "(Oh, I know... none of this is real. No other werewolf ever managed to lay a claw on me."
msgstr "“―――そうだ。こんなのはウソだ。同族でだってボクを負かせる奴はいなかった。"

#. Occurrence C_6:505:18420: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0005; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:505
msgctxt "text_id=18420 | speaker=beo"
msgid "This pain-this whole situation isn't really happening."
msgstr "こんな痛みも、こんな事態も、全部ウソだ。"

#. Occurrence C_6:512:18421: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0006; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:512
msgctxt "text_id=18421 | speaker=beo"
msgid "It makes no sense."
msgstr "不合理に狂っている。"

#. Occurrence C_6:519:18422: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0007; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:519
msgctxt "text_id=18422 | speaker=beo"
msgid "Who on this planet could beat ME?!)"
msgstr "だって、この<器|ボク>が、他の生き物に負けるハズが……！”"

#. Occurrence C_6:543:18423: scene=C_6
#: C_6:543
msgctxt "text_id=18423 | speaker=unknown"
msgid "  Enough thinking."
msgstr "　考察の時間は終わりだ。"

#. Occurrence C_6:548:18424: scene=C_6
#: C_6:548
msgctxt "text_id=18424 | speaker=unknown"
msgid "  He was ready."
msgstr "　とうに傷は癒えている。"

#. Occurrence C_6:553:18425: scene=C_6
#: C_6:553
msgctxt "text_id=18425 | speaker=unknown"
msgid "  From the ground, he glared at his enemy to his side."
msgstr "　再戦のため、<人|カ><狼|レ>は倒れたまま、傍らに立つ敵を睨みつけ、"

#. Occurrence C_6:584:18426: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0008; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:584
msgctxt "text_id=18426 | speaker=beo"
msgid "\"I. Don't. Lose.\""
msgstr "“負ける――ハズ、が―――”"

#. Occurrence C_6:609:18427: scene=C_6
#: C_6:609
msgctxt "text_id=18427 | speaker=unknown"
msgid "  The very next moment..."
msgstr "　瞬間。"

#. Occurrence C_6:614:18428: scene=C_6
#: C_6:614
msgctxt "text_id=18428 | speaker=unknown"
msgid "  An unknown type of pain coursed down his spine."
msgstr "　よく分からない新種の痛みが、人狼の背中を走り抜けた。"

#. Occurrence C_6:680:18429: scene=C_6
#: C_6:680
msgctxt "text_id=18429 | speaker=unknown"
msgid "  It had eyes. Cold eyes. Staring. Piercing."
msgstr "　頭上には無機質な<視|め>。<眼|め>。<目|め>。"

#. Occurrence C_6:685:18430: scene=C_6
#: C_6:685
msgctxt "text_id=18430 | speaker=unknown"
msgid "  Colorless."
msgstr "　あまりにも<活|いろ>がない。"

#. Occurrence C_6:690:18431: scene=C_6
#: C_6:690
msgctxt "text_id=18431 | speaker=unknown"
msgid "  The moon looked more alive."
msgstr "　まだ虚空にある月の方が<活|い>きている。"

#. Occurrence C_6:695:18432: scene=C_6
#: C_6:695
msgctxt "text_id=18432 | speaker=unknown"
msgid "  Its arms were broken."
msgstr "　ソレの両腕は折れている。"

#. Occurrence C_6:700:18433: scene=C_6
#: C_6:700
msgctxt "text_id=18433 | speaker=unknown"
msgid "  Its inhumanly powerful attack had mangled them beyond recognition."
msgstr "　人智に収まらぬ強打によって跡形もない。"

#. Occurrence C_6:705:18434: scene=C_6
#: C_6:705
msgctxt "text_id=18434 | speaker=unknown"
msgid "  If it was in pain, it would have cried out."
msgstr "　痛覚があるのなら<叫|こえ>が漏れる。"

#. Occurrence C_6:710:18435: scene=C_6
#: C_6:710
msgctxt "text_id=18435 | speaker=unknown"
msgid "  But it was silent."
msgstr "　なのに無音という事は。"

#. Occurrence C_6:715:18436: scene=C_6
#: C_6:715
msgctxt "text_id=18436 | speaker=unknown"
msgid "  Was..."
msgstr "　故に／"

#. Occurrence C_6:715:18437: scene=C_6
#: C_6:715
msgctxt "text_id=18437 | speaker=unknown"
msgid "...it..."
msgstr "あるいは元より"

#. Occurrence C_6:715:18438: scene=C_6
#: C_6:715
msgctxt "text_id=18438 | speaker=unknown"
msgid "...ever..."
msgstr "／生きていない。／"

#. Occurrence C_6:715:18439: scene=C_6
#: C_6:715
msgctxt "text_id=18439 | speaker=unknown"
msgid "...alive...?"
msgstr "のか。"

#. Occurrence C_6:735:18440: scene=C_6
#: C_6:735
msgctxt "text_id=18440 | speaker=unknown"
msgid "  Those dead eyes..."
msgstr "　ソレは死人のような<貌|め>で<人|カ><狼|レ>を凝視している。"

#. Occurrence C_6:740:18441: scene=C_6
#: C_6:740
msgctxt "text_id=18441 | speaker=unknown"
msgid "                              "
msgstr "　　　　　　　　　　　　　　　"

#. Occurrence C_6:740:18442: scene=C_6
#: C_6:740
msgctxt "text_id=18442 | speaker=unknown"
msgid "He'd seen eyes like those before."
msgstr "近いモノなら知っている。"

#. Occurrence C_6:745:18443: scene=C_6
#: C_6:745
msgctxt "text_id=18443 | speaker=unknown"
msgid "  Those eyes without hatred. Without joy."
msgstr "　憎悪もなし歓喜もなし。"

#. Occurrence C_6:750:18444: scene=C_6
#: C_6:750
msgctxt "text_id=18444 | speaker=unknown"
msgid "  Without any feeling behind them at all."
msgstr "　いかなる意思の発露もなし。"

#. Occurrence C_6:755:18445: scene=C_6
#: C_6:755
msgctxt "text_id=18445 | speaker=unknown"
msgid "                              "
msgstr "　　　　　　　　　　　　　　　"

#. Occurrence C_6:755:18446: scene=C_6
#: C_6:755
msgctxt "text_id=18446 | speaker=unknown"
msgid "It was a mindless insect."
msgstr "<脳|ちせい>のない昆虫だ。"

#. Occurrence C_6:775:18447: scene=C_6
#: C_6:775
msgctxt "text_id=18447 | speaker=unknown"
msgid "  The werewolf's hair stood on end."
msgstr "　ぞわりと体毛がささくれ立つ。"

#. Occurrence C_6:780:18448: scene=C_6
#: C_6:780
msgctxt "text_id=18448 | speaker=unknown"
msgid "  What was this creeping chill, crawling up his spine?"
msgstr "　己が背に走る感情の名を、人狼は知らない。"

#. Occurrence C_6:785:18449: scene=C_6
#: C_6:785
msgctxt "text_id=18449 | speaker=unknown"
msgid "  Having never experienced fear, the werewolf did not know what had become of him."
msgstr "　その不可解さに<怖|おじ>けてしまったことを、そもそも恐怖を知らなかった<人|カ><狼|レ>には、微塵たりとも自覚できない。"

#. Occurrence C_6:839:18450: scene=C_6
#: C_6:839
msgctxt "text_id=18450 | speaker=unknown"
msgid "  Despite countless clashes against other Mystics, it had been a human that broke him."
msgstr "　……金狼は今まで、多くの神秘と戦い、これを打ち破ってきた。"

#. Occurrence C_6:845:18451: scene=C_6
#: C_6:845
msgctxt "text_id=18451 | speaker=unknown"
msgid "  He knew beasts even larger than himself."
msgstr "　カレは自分以上の巨体を誇る獣を知っている。"

#. Occurrence C_6:850:18452: scene=C_6
#: C_6:850
msgctxt "text_id=18452 | speaker=unknown"
msgid "  He knew legendary creatures like himself."
msgstr "　自分と同じ、伝承から生まれた獣も知っている。"

#. Occurrence C_6:856:18453: scene=C_6
#: C_6:856
msgctxt "text_id=18453 | speaker=unknown"
msgid "  He did not know this."
msgstr "　だが、コレは知らない。"

#. Occurrence C_6:861:18454: scene=C_6
#: C_6:861
msgctxt "text_id=18454 | speaker=unknown"
msgid "  He'd never met, much less imagined, a human-sized bug."
msgstr "　人間ほどの大きさをした昆虫など、彼は出会ってもいないし、想像した事さえなかった。"

#. Occurrence C_6:911:18455: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0009; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:911
msgctxt "text_id=18455 | speaker=beo"
msgid "\"...\""
msgstr "“―――、―――”"

#. Occurrence C_6:919:18456: scene=C_6
#: C_6:919
msgctxt "text_id=18456 | speaker=unknown"
msgid "  The chill down the werewolf's spine was so vicious it threatened to split him in two."
msgstr "　背筋が二つに割れそうな<悪寒|おかん>。"

#. Occurrence C_6:924:18457: scene=C_6
#: C_6:924
msgctxt "text_id=18457 | speaker=unknown"
msgid "  If he moved even an inch, it would crush his skull underfoot."
msgstr "　今ここで少しでも動けば、何の理由も初動もなく、首めがけてあの足が落ちてくる。"

#. Occurrence C_6:929:18458: scene=C_6
#: C_6:929
msgctxt "text_id=18458 | speaker=unknown"
msgid "  In spite of the despair gripping him, the boy paradoxically sensed that his opponent would not move at all."
msgstr "　そんな絶望的な予感とは裏腹に、この相手は決して動かない事も、少年は感じ取っていた。"

#. Occurrence C_6:966:18459: scene=C_6
#: C_6:966
msgctxt "text_id=18459 | speaker=unknown"
msgid "  This human would exhibit no further violence."
msgstr "　この人間は、これ以上の暴力は振るわない。"

#. Occurrence C_6:971:18460: scene=C_6
#: C_6:971
msgctxt "text_id=18460 | speaker=unknown"
msgid "  It was a creature-no, a stone-that held no animal instincts. It masqueraded as a human."
msgstr "　生き物らしい……いや、動物らしい本能がない石くれのクセに、<人|・><間|・><ら|・><し|・><い|・><分|・><別|・><で|・><動|・><い|・><て|・><い|・><る|・>。"

#. Occurrence C_6:1020:18461: scene=C_6
#: C_6:1020
msgctxt "text_id=18461 | speaker=unknown"
msgid "  The contradiction grated against his heart, his values."
msgstr "　その矛盾が、<人|カ><狼|レ>の<価値観|こころ>に粘りつく。"

#. Occurrence C_6:1025:18462: scene=C_6
#: C_6:1025
msgctxt "text_id=18462 | speaker=unknown"
msgid "  A phantom pain borne of an unknown emotion: fear."
msgstr "　未知の<感情|きょうふ>からくる<幻肢痛|げんしつう>。"

#. Occurrence C_6:1030:18463: scene=C_6
#: C_6:1030
msgctxt "text_id=18463 | speaker=unknown"
msgid "  It wasn't just grating; it was like many needles, slowly digging into his heart."
msgstr "　ぷつぷつと音をたてて、小さな<画鋲|がびょう>が心臓に迫るようだ。"

#. Occurrence C_6:1036:18464: scene=C_6
#: C_6:1036
msgctxt "text_id=18464 | speaker=unknown"
msgid "  This had been his first taste of doubt-of reality."
msgstr "　それは<人|カ><狼|レ>がはじめて出会った疑問であり、現実だった。"

#. Occurrence C_6:1042:18465: scene=C_6
#: C_6:1042
msgctxt "text_id=18465 | speaker=unknown"
msgid "  Such contradictions existed in the world, after all."
msgstr "　この世にはどうしようもない矛盾があり、そして―――"

#. Occurrence C_6:1047:18466: scene=C_6
#: C_6:1047
msgctxt "text_id=18466 | speaker=unknown"
msgid "  They were irrationalities and questions you did not want to hear the answers to."
msgstr "　答えなど知りたくもない“不合理”があるのだと。"

#. Occurrence C_6:1100:18467: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0010; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:1100
msgctxt "text_id=18467 | speaker=beo"
msgid "(It... hurts...)"
msgstr "“っ―――い、た―――ぃ”"

#. Occurrence C_6:1106:18468: scene=C_6
#: C_6:1106
msgctxt "text_id=18468 | speaker=unknown"
msgid "  The suppressed pain suddenly flowed through his body like a raging river."
msgstr "　それまで遮断していた痛覚が、全身にあふれ出す。"

#. Occurrence C_6:1111:18469: scene=C_6
#: C_6:1111
msgctxt "text_id=18469 | speaker=unknown"
msgid "  This was also a first."
msgstr "　こんな事も初めてだった。"

#. Occurrence C_6:1116:18470: scene=C_6
#: C_6:1116
msgctxt "text_id=18470 | speaker=unknown"
msgid "  Until now, he had always been able to control pain."
msgstr "　今まで<人|カ><狼|レ>の体は痛覚すら制御してきた。"

#. Occurrence C_6:1121:18471: scene=C_6
#: C_6:1121
msgctxt "text_id=18471 | speaker=unknown"
msgid "  He had never known what it was like to tremble."
msgstr "　そもそも悪寒など感じた事もなかった。"

#. Occurrence C_6:1126:18472: scene=C_6
#: C_6:1126
msgctxt "text_id=18472 | speaker=unknown"
msgid "  An elemental might have even felt sorry for him, if it were here to watch."
msgstr "　精霊がいたのなら嘆いただろう。"

#. Occurrence C_6:1131:18473: scene=C_6
#: C_6:1131
msgctxt "text_id=18473 | speaker=unknown"
msgid "  How sad... Born complete, yet lost in the lunacy of the human world."
msgstr "　……ああ。生まれながら完成していたモノが、人の世の不条理に混乱している。"

#. Occurrence C_6:1195:18474: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0011; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:1195
msgctxt "text_id=18474 | speaker=beo"
msgid "(It... it hurts! It hurts! It hurts so much!)"
msgstr "“いた―――いたい、いたい、いたい―――！”"

#. Occurrence C_6:1201:18475: scene=C_6
#: C_6:1201
msgctxt "text_id=18475 | speaker=unknown"
msgid "  His heart had fully regenerated."
msgstr "　心臓は完治している。"

#. Occurrence C_6:1207:18476: scene=C_6
#: C_6:1207
msgctxt "text_id=18476 | speaker=unknown"
msgid "Howling in mental agony, the beast clutched his own trembling body."
msgstr "恐れからくる幻肢痛にあえぎながら、<人|カ><狼|レ>は震える体を抱きしめる。"

#. Occurrence C_6:1213:18477: scene=C_6
#: C_6:1213
msgctxt "text_id=18477 | speaker=unknown"
msgid "  Those eyes! Those human eyes looking straight through him!"
msgstr "　頭上にはレンズのような人間の目。"

#. Occurrence C_6:1218:18478: scene=C_6
#: C_6:1218
msgctxt "text_id=18478 | speaker=unknown"
msgid "  And then, the boy realized the only reason he was still alive."
msgstr "　それで、少年は自分が生きている理由をようやく悟った。"

#. Occurrence C_6:1238:18479: scene=C_6
#: C_6:1238
msgctxt "text_id=18479 | speaker=unknown"
msgid "  Even with both arms broken, the human could have finished him off with its legs."
msgstr "　たとえ両腕がなくても、残った足だけでこの相手は自分を殺せただろう。"

#. Occurrence C_6:1243:18480: scene=C_6
#: C_6:1243
msgctxt "text_id=18480 | speaker=unknown"
msgid "  But it mattered not."
msgstr "　けれどそれはありえない。"

#. Occurrence C_6:1248:18481: scene=C_6
#: C_6:1248
msgctxt "text_id=18481 | speaker=unknown"
msgid "  Because his opponent was giving him a taste of his own medicine."
msgstr "　なぜなら、この相手は<た|・><だ|・><や|・><り|・><返|・><し|・><た|・><だ|・><け|・>なのだから。"

#. Occurrence C_6:1254:18482: scene=C_6
#: C_6:1254
msgctxt "text_id=18482 | speaker=unknown"
msgid "  This was not revenge for trying to kill him."
msgstr "　彼を殺そうとした狼に対しての反撃、ではない。"

#. Occurrence C_6:1259:18483: scene=C_6
#: C_6:1259
msgctxt "text_id=18483 | speaker=unknown"
msgid "  This was revenge for the wounds he inflicted on the girls."
msgstr "　これは彼女たちを傷つけた行為に対する、当然の報復だった。"

#. Occurrence C_6:1301:18484: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0012; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:1301
msgctxt "text_id=18484 | speaker=beo"
msgid "\"...\""
msgstr "“―――、……、―――”"

#. Occurrence C_6:1307:18485: scene=C_6
#: C_6:1307
msgctxt "text_id=18485 | speaker=unknown"
msgid "  The absurdity of it all made his throat tighten."
msgstr "　おかしさから<喉|のど>がひきつる。"

#. Occurrence C_6:1312:18486: scene=C_6
#: C_6:1312
msgctxt "text_id=18486 | speaker=unknown"
msgid "  His breathing was frantic."
msgstr "　呼吸はさっきから乱れっぱなし。"

#. Occurrence C_6:1317:18487: scene=C_6
#: C_6:1317
msgctxt "text_id=18487 | speaker=unknown"
msgid "  This human had no sense of self."
msgstr "　この人間には自己がない。"

#. Occurrence C_6:1323:18488: scene=C_6
#: C_6:1323
msgctxt "text_id=18488 | speaker=unknown"
msgid "It had no concern for its own safety when it stood between him and the girls."
msgstr "立ち塞がった金狼を、己に向けられた脅威だと計りもしない。"

#. Occurrence C_6:1328:18489: scene=C_6
#: C_6:1328
msgctxt "text_id=18489 | speaker=unknown"
msgid "  That must be why it had no hate or fear... or perhaps even intent to kill him."
msgstr "　憎悪も恐怖も、おそらくは殺意すらなかったのはそういう事だ。"

#. Occurrence C_6:1375:18490: scene=C_6
#: C_6:1375
msgctxt "text_id=18490 | speaker=unknown"
msgid "  Indeed. The fact that he was alive had nothing to do with the human's will."
msgstr "　―――そう。人狼が生かされているのは、この人間の意志によるものではない。"

#. Occurrence C_6:1380:18491: scene=C_6
#: C_6:1380
msgctxt "text_id=18491 | speaker=unknown"
msgid "  The fight was machine-like; so was its judgment."
msgstr "　戦いも機械的なら、その判断も機械的。"

#. Occurrence C_6:1385:18492: scene=C_6
#: C_6:1385
msgctxt "text_id=18492 | speaker=unknown"
msgid "  An eye for an eye, and nothing more."
msgstr "　この生き物はただ、<等|・><価|・><な|・><交|・><換|・><を|・><行|・><っ|・><た|・>だけなのだ。"

#. Occurrence C_6:1390:18493: scene=C_6
#: C_6:1390
msgctxt "text_id=18493 | speaker=unknown"
msgid "  If the werewolf had killed one of the girls, this exchange would have ended differently."
msgstr "　人狼が彼女たちを一人でも手に掛けていれば、この差し引きは違っただろう。"

#. Occurrence C_6:1437:18494: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0013; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:1437
msgctxt "text_id=18494 | speaker=beo"
msgid "(...If I'd killed them, would I have been killed?)"
msgstr "“……殺していたら、殺されていた……？”"

#. Occurrence C_6:1443:18495: scene=C_6
#: C_6:1443
msgctxt "text_id=18495 | speaker=unknown"
msgid "  He shuddered at the thought."
msgstr "　その問いかけに、ぞくりとした。"

#. Occurrence C_6:1448:18496: scene=C_6
#: C_6:1448
msgctxt "text_id=18496 | speaker=unknown"
msgid "  He had never entertained such a possibility."
msgstr "　今まで考える事すらなかった恐れ。"

#. Occurrence C_6:1453:18497: scene=C_6
#: C_6:1453
msgctxt "text_id=18497 | speaker=unknown"
msgid "  He had never had to, because he was supposed to be the one exception to that rule!"
msgstr "　自分はその<規律|ルール>の外にいるのだと、当然のように思っていたのに―――！"

#. Occurrence C_6:1516:18498: scene=C_6
#: C_6:1516
msgctxt "text_id=18498 | speaker=unknown"
msgid "  Agony kicked him hard in the gut."
msgstr "　体中に痛みが走る。"

#. Occurrence C_6:1521:18499: scene=C_6
#: C_6:1521
msgctxt "text_id=18499 | speaker=unknown"
msgid "  No matter the Mystic, nothing was immune from injury, from decay."
msgstr "　いかな神秘であろうと、傷つき、朽ちる事に例外はない。"

#. Occurrence C_6:1526:18500: scene=C_6
#: C_6:1526
msgctxt "text_id=18500 | speaker=unknown"
msgid "  The boy finally understood an obvious law of the world..."
msgstr "　そんな当たり前の摂理を、少年はようやく思い知った。"

#. Occurrence C_6:1531:18501: scene=C_6
#: C_6:1531
msgctxt "text_id=18501 | speaker=unknown"
msgid "  ...or rather, he had been taught."
msgstr "　いや、思い知らされてしまった。"

#. Occurrence C_6:1587:18502: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0014; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:1587
msgctxt "text_id=18502 | speaker=beo"
msgid "(He would've killed me... I know it...)"
msgstr "“……殺されてた……間違いなく……”"

#. Occurrence C_6:1593:18503: scene=C_6
#: C_6:1593
msgctxt "text_id=18503 | speaker=unknown"
msgid "  Those eyes. They would not stop staring down at him."
msgstr "　無機質な目は、感慨もなく見下ろしている。"

#. Occurrence C_6:1598:18504: scene=C_6
#: C_6:1598
msgctxt "text_id=18504 | speaker=unknown"
msgid "  Retribution was a universal law."
msgstr "　報復は万物に共通する摂理だ。"

#. Occurrence C_6:1603:18505: scene=C_6
#: C_6:1603
msgctxt "text_id=18505 | speaker=unknown"
msgid "  He was now painfully aware of that fact."
msgstr "　それはもう痛いほどよく分かった。"

#. Occurrence C_6:1609:18506: scene=C_6
#: C_6:1609
msgctxt "text_id=18506 | speaker=unknown"
msgid "  And yet."
msgstr "　―――なのに。"

msgctxt "text_id=18507 | speaker=unknown"
msgid " And yet."
msgstr "なのに。"

msgctxt "text_id=18508 | speaker=unknown"
msgid " And yet."
msgstr "なのに。"

#. Occurrence C_6:1619:18509: scene=C_6
#: C_6:1619
msgctxt "text_id=18509 | speaker=unknown"
msgid "  The one who brought form to this idea was this human!"
msgstr "　それを体現した生き物が、なにより、その決まりから外れているおぞましさ……！"

#. Occurrence C_6:1695:18510: scene=C_6
#: C_6:1695
msgctxt "text_id=18510 | speaker=unknown"
msgid "  The pain of defeat! The pain in his heart! The pain of comprehending the incomprehensible!"
msgstr "　敗北の痛み、心臓の痛み、なにより、不可解を知った痛み。"

#. Occurrence C_6:1700:18511: scene=C_6
#: C_6:1700
msgctxt "text_id=18511 | speaker=unknown"
msgid "  Pain, pain, pain..."
msgstr "　痛み、痛み、痛み。"

#. Occurrence C_6:1719:18512: scene=C_6
#: C_6:1719
msgctxt "text_id=18512 | speaker=unknown"
msgid "  The impossibility of it all had shattered his perfect world."
msgstr "　あり得ない出来事によって、完璧だった世界が崩れていく。"

#. Occurrence C_6:1724:18513: scene=C_6
#: C_6:1724
msgctxt "text_id=18513 | speaker=unknown"
msgid "  It ate at him, consumed every fiber of his being."
msgstr "　それは全身を食い尽くす<茨|いばら>となって、少年の心柱を切断していった。"

#. Occurrence C_6:1771:18514: scene=C_6
#: C_6:1771
msgctxt "text_id=18514 | speaker=unknown"
msgid "              The doubt made his head spin."
msgstr "　　　　　　　目眩を起こすほどの疑問。"

#. Occurrence C_6:1776:18515: scene=C_6
#: C_6:1776
msgctxt "text_id=18515 | speaker=unknown"
msgid "      It was too much."
msgstr "　　　ああ―――"

#. Occurrence C_6:1782:18516: scene=C_6
#: C_6:1782
msgctxt "text_id=18516 | speaker=unknown"
msgid "Humans were impossible to understand."
msgstr "人間は、<あ|・><ま|・><り|・><に|・><も|・><不|・><可|・><解|・><す|・><ぎ|・><る|・>。"

#. Occurrence C_6:1822:18517: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_C_6_0015; voice_prefix=A50; voice_category=12; scene=C_6
#: C_6:1822
msgctxt "text_id=18517 | speaker=beo"
msgid "\"...I'd have been killed. I'd have been killed. I'd have been killed...\""
msgstr "“……殺されてた。殺されてた、殺されてた……”"

#. Occurrence C_6:1829:18518: scene=C_6
#: C_6:1829
msgctxt "text_id=18518 | speaker=unknown"
msgid "  He had not been made to face the death of another, but his own."
msgstr "　他人の死に向けられたものではなく、己が生に対する<畏|おそ>れ。"

#. Occurrence C_6:1834:18519: scene=C_6
#: C_6:1834
msgctxt "text_id=18519 | speaker=unknown"
msgid "  Unable to cope, he reverted to his human form."
msgstr "　それに耐えられなくなって、<人|カ><狼|レ>は獣から人間に戻ってしまった。"

#. Occurrence C_6:1839:18520: scene=C_6
#: C_6:1839
msgctxt "text_id=18520 | speaker=unknown"
msgid "  Quietly..."
msgstr "　……静かに。"

#. Occurrence C_6:1844:18521: scene=C_6
#: C_6:1844
msgctxt "text_id=18521 | speaker=unknown"
msgid "  He shivered like a frightened child in a mother's lap."
msgstr "　母親の膝で<怯|おび>える子供のように、体を震わせながら。"

#. Occurrence C_7:80:18522: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_7_0000; voice_prefix=A10; voice_category=1; scene=C_7
#: C_7:80
msgctxt "text_id=18522 | speaker=aoko"
msgid "\"Y...\""
msgstr "「な…………」"

#. Occurrence C_7:86:18523: scene=C_7
#: C_7:86
msgctxt "text_id=18523 | speaker=unknown"
msgid "  Still lying in the snow, Aoko choked on her words,"
msgstr "　倒れたまま、青子はつい声を飲んでしまった。"

#. Occurrence C_7:91:18524: scene=C_7
#: C_7:91
msgctxt "text_id=18524 | speaker=unknown"
msgid "  unable to entirely comprehend what had unfolded."
msgstr "　正直、目の前で起こった事が把握できない。"

#. Occurrence C_7:136:18525: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_7_0001; voice_prefix=A10; voice_category=1; scene=C_7
#: C_7:136
msgctxt "text_id=18525 | speaker=aoko"
msgid "\"...Soujyuro, you...\""
msgstr "「……草十郎、アンタ……」"

#. Occurrence C_7:141:18526: scene=C_7
#: C_7:141
msgctxt "text_id=18526 | speaker=unknown"
msgid "  She could not hide the trembling in her voice."
msgstr "　つい呼びかける声が震えてしまう。"

#. Occurrence C_7:147:18527: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_7_0000; voice_prefix=A30; voice_category=3; scene=C_7
#: C_7:147
msgctxt "text_id=18527 | speaker=soujuurou"
msgid "\"What?\""
msgstr "「なに？」"

#. Occurrence C_7:168:18528: scene=C_7
#: C_7:168
msgctxt "text_id=18528 | speaker=unknown"
msgid "  Speaking in his usual way, Soujyuro nonchalantly turned toward her."
msgstr "　草十郎はいつもの口調で、ごく自然に振り向いた。"

#. Occurrence C_7:189:18529: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_7_0002; voice_prefix=A10; voice_category=1; scene=C_7
#: C_7:189
msgctxt "text_id=18529 | speaker=aoko"
msgid "\"What do you mean 'What'?! Do you even know what you just did?!\""
msgstr "「なにって……いま自分が何をしたか分かってんの！？」"

#. Occurrence C_7:250:18530: scene=C_7
#: C_7:250
msgctxt "text_id=18530 | speaker=unknown"
msgid "  She shouted angrily, as though he had done something wrong."
msgstr "　悪いのはアンタの方、と言わんばかりの怒鳴り声だった。"

#. Occurrence C_7:260:18531: scene=C_7
#: C_7:260
msgctxt "text_id=18531 | speaker=unknown"
msgid "  Soujyuro looked surprised, wondering what on earth he had done to upset her."
msgstr "　草十郎は目を点にして、青子が怒るような事をしたかな、と考えこむ。"

#. Occurrence C_7:298:18532: scene=C_7
#: C_7:298
msgctxt "text_id=18532 | speaker=unknown"
msgid "  He lowered his gaze back to the wolf boy."
msgstr "　視線を下に向けると、人狼は少年の姿に戻っていた。"

#. Occurrence C_7:303:18533: scene=C_7
#: C_7:303
msgctxt "text_id=18533 | speaker=unknown"
msgid "  Knitting his brow in dismay, Soujyuro finally realized what Aoko was referring to."
msgstr "　……青子はこの事を言っているんだろうか、とようやく気付いて、草十郎は不機嫌そうに眉をひそめた。"

#. Occurrence C_7:339:18534: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_7_0001; voice_prefix=A30; voice_category=3; scene=C_7
#: C_7:339
msgctxt "text_id=18534 | speaker=soujuurou"
msgid "\"That's weird, Aozaki. I thought you knew.\""
msgstr "「心外だな。蒼崎は分かってると思ってた」"

#. Occurrence C_7:344:18535: scene=C_7
#: C_7:344
msgctxt "text_id=18535 | speaker=unknown"
msgid "  He looked at her in disappointment."
msgstr "　向けられる批難の目。"

#. Occurrence C_7:350:18536: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_7_0003; voice_prefix=A10; voice_category=1; scene=C_7
#: C_7:350
msgctxt "text_id=18536 | speaker=aoko"
msgid "\"'Knew'...? Knew what? What're you talking about?\""
msgstr "「え……わ、分かってるって、何をよ」"

#. Occurrence C_7:355:18537: scene=C_7
#: C_7:355
msgctxt "text_id=18537 | speaker=unknown"
msgid "  Feeling slightly affronted, Aoko responded curtly."
msgstr "　非難される覚えはないので、青子もややつっけんどんに聞き返す。"

#. Occurrence C_7:365:18538: scene=C_7
#: C_7:365
msgctxt "text_id=18538 | speaker=unknown"
msgid "  Soujyuro sighed."
msgstr "　それに、草十郎は重いため息を洩らした。"

#. Occurrence C_7:399:18539: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_7_0002; voice_prefix=A30; voice_category=3; scene=C_7
#: C_7:399
msgctxt "text_id=18539 | speaker=soujuurou"
msgid "\"Bears are actually pretty common in the mountains."
msgstr "「山じゃ、熊はそう珍しいものじゃない。"

#. Occurrence C_7:405:18540: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_7_0003; voice_prefix=A30; voice_category=3; scene=C_7
#: C_7:405
msgctxt "text_id=18540 | speaker=soujuurou"
msgid "  Remember me telling you that?\""
msgstr "　以前、確かに言ったじゃないか」"

#. Occurrence C_7:443:18541: scene=C_7
#: C_7:443
msgctxt "text_id=18541 | speaker=unknown"
msgid "\"..."
msgstr "「――――――"

#. Occurrence C_7:452:18542: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_7_0004; voice_prefix=A10; voice_category=1; scene=C_7
#: C_7:452
msgctxt "text_id=18542 | speaker=aoko"
msgid "Huh?\""
msgstr "は？」"

#. Occurrence C_7:472:18543: scene=C_7
#: C_7:472
msgctxt "text_id=18543 | speaker=unknown"
msgid "  Aoko's jaw dropped."
msgstr "　……開いた口が<塞|ふさ>がらない。"

#. Occurrence C_7:477:18544: scene=C_7
#: C_7:477
msgctxt "text_id=18544 | speaker=unknown"
msgid "  It took her a moment to process what he had just said."
msgstr "　今の言葉をそのままの意味として受け入れるのには、幾分かの時間を要した。"

#. Occurrence C_7:497:18545: scene=C_7
#: C_7:497
msgctxt "text_id=18545 | speaker=unknown"
msgid "  She recalled some meaningless conversation or other from who knows when."
msgstr "　青子はいつかの、他愛のないやりとりを思い出す。"

#. Occurrence C_7:548:18546: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_7_0004; voice_prefix=A30; voice_category=3; scene=C_7
#: C_7:548
msgctxt "text_id=18546 | speaker=soujuurou"
msgid "\"...Are you making fun of me?"
msgstr "『……君、もしかして俺を罵迦にしているのか？"

#. Occurrence C_7:554:18547: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_7_0005; voice_prefix=A30; voice_category=3; scene=C_7
#: C_7:554
msgctxt "text_id=18547 | speaker=soujuurou"
msgid "  Good grief. Why did they train me to fight bears, of all things?\""
msgstr "　まったく、なんで熊を倒すためなんかに修業しなくちゃいけないんだ』"

#. Occurrence C_7:614:18548: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_7_0005; voice_prefix=A10; voice_category=1; scene=C_7
#: C_7:614
msgctxt "text_id=18548 | speaker=aoko"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence C_7:619:18549: scene=C_7
#: C_7:619
msgctxt "text_id=18549 | speaker=unknown"
msgid "  Yes. Now she thought about it, they had spoken about that."
msgstr "　そう。よくよく思い返してみると、アレはおかしな言い回しだったのだ。"

#. Occurrence C_7:624:18550: scene=C_7
#: C_7:624
msgctxt "text_id=18550 | speaker=unknown"
msgid "  He'd mentioned being familiar with large beasts,"
msgstr "　熊という巨獣に慣れていないと言えない台詞だし、"

#. Occurrence C_7:629:18551: scene=C_7
#: C_7:629
msgctxt "text_id=18551 | speaker=unknown"
msgid "  and she couldn't deny that she'd heard him utter some anachronistic nonsense about training against them."
msgstr "　そもそも何より、彼本人が“修業をしていた”なんて時代錯誤な言葉を否定していない。"

#. Occurrence C_7:678:18552: scene=C_7
#: C_7:678
msgctxt "text_id=18552 | speaker=unknown"
msgid "  Which meant..."
msgstr "　……と、なると。"

#. Occurrence C_7:713:18553: scene=C_7
#: C_7:713
msgctxt "text_id=18553 | speaker=unknown"
msgid "  He was used to dealing with animals larger than himself."
msgstr "　彼にとって、自分より大きな動物は珍しいものではなく。"

#. Occurrence C_7:719:18554: scene=C_7
#: C_7:719
msgctxt "text_id=18554 | speaker=unknown"
msgid "  If he'd lived the sort of life that involved run-ins with wild bears, then a man-wolf might only have been surprising, but not particularly frightening."
msgstr "　野生の熊と遭遇するような生活をしていたのなら、人間が狼になる程度、驚くことはあれ、恐れることはないのかもしれない。"

#. Occurrence C_7:769:18555: scene=C_7
#: C_7:769
msgctxt "text_id=18555 | speaker=unknown"
msgid "  Aoko hung her head."
msgstr "　そこまで思い至って、青子は大きくうなだれた。"

#. Occurrence C_7:774:18556: scene=C_7
#: C_7:774
msgctxt "text_id=18556 | speaker=unknown"
msgid "  After all this time, who was it that really made no sense?"
msgstr "　初めから、いちばん常識から外れていたのは、一体誰だったのか―――"

#. Occurrence C_7:795:18557: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_7_0006; voice_prefix=A10; voice_category=1; scene=C_7
#: C_7:795
msgctxt "text_id=18557 | speaker=aoko"
msgid "\"...Okay. You win this one, Soujyuro.\""
msgstr "「……まいったわ。貴方の勝ちよ、草十郎」"

#. Occurrence C_7:819:18558: scene=C_7
#: C_7:819
msgctxt "text_id=18558 | speaker=unknown"
msgid "  It was hard to tell whether she spoke in admiration or exasperation."
msgstr "　感服したのか、それとも心底呆れたのか。"

#. Occurrence C_7:824:18559: scene=C_7
#: C_7:824
msgctxt "text_id=18559 | speaker=unknown"
msgid "  Either way, as she slouched in the snow, Aoko spoke quietly enough so only she could hear her words."
msgstr "　とにかく肩の力をがっくりと落として、青子は自分にだけ聞こえるよう、そんな台詞を呟いた。"

#. Occurrence C_8:74:18560: scene=C_8
#: C_8:74
msgctxt "text_id=18560 | speaker=unknown"
msgid "  Touko, on the other hand, understood exactly what had transpired."
msgstr "　一方、橙子は一連の出来事を正確に把握していた。"

#. Occurrence C_8:79:18561: scene=C_8
#: C_8:79
msgctxt "text_id=18561 | speaker=unknown"
msgid "  Beo lay fallen, now just a sobbing boy;"
msgstr "　倒れ<臥|ふ>し、人型になってしまったベオと、"

#. Occurrence C_8:84:18562: scene=C_8
#: C_8:84
msgctxt "text_id=18562 | speaker=unknown"
msgid "  and another boy stood over him with two shattered arms."
msgstr "　その傍らに立っている、両腕を粉砕した少年。"

#. Occurrence C_8:104:18563: scene=C_8
#: C_8:104
msgctxt "text_id=18563 | speaker=unknown"
msgid "  Near-fatally wounded, Aoko and Alice still could not stand, but had recovered enough to breathe."
msgstr "　人狼の一撃を受けて青子と有珠はまだ立ち上がれそうにないが、呼吸ができる程度には回復している。"

#. Occurrence C_8:109:18564: scene=C_8
#: C_8:109
msgctxt "text_id=18564 | speaker=unknown"
msgid "  As for Touko, she had only a few tricks up her sleeve. Maybe three or four more runes at best."
msgstr "　対して、自分に残された物はあと数刻……三、四回分のルーン文字だけである。"

#. Occurrence C_8:129:18565: scene=C_8
#: C_8:129
msgctxt "text_id=18565 | speaker=unknown"
msgid "  The Magic Crests on her back were unusable."
msgstr "　背後の魔術刻印は使えない。"

#. Occurrence C_8:134:18566: scene=C_8
#: C_8:134
msgctxt "text_id=18566 | speaker=unknown"
msgid "  She could use the remaining magical energy from the field imprisoning her grandfather, but that would be stupid;"
msgstr "　刻印の残魔力量―――祖父を密閉している結界を解除すれば攻撃に回せるが、それは下策にすぎる。"

#. Occurrence C_8:196:18567: scene=C_8
#: C_8:196
msgctxt "text_id=18567 | speaker=unknown"
msgid "  if she released her grandfather, she would lose ownership of the sacred ground."
msgstr "　そもそも、いま祖父を解放すれば霊地の所有権は根こそぎ奪われる。"

#. Occurrence C_8:201:18568: scene=C_8
#: C_8:201
msgctxt "text_id=18568 | speaker=unknown"
msgid "  Failing to defeat Aoko and Alice now would mean starting over from square one, and she could not afford that. This sibling rivalry had to end."
msgstr "　ここで青子たちに勝利しても始めからやり直し―――なんて徒労は容認できないし、なにより、この姉妹喧嘩に二度目はない。"

#. Occurrence C_8:206:18569: scene=C_8
#: C_8:206
msgctxt "text_id=18569 | speaker=unknown"
msgid "  Touko had gambled everything on her surprise attack,"
msgstr "　一度きりの奇襲だからこそ、彼女は全ての資金を<費|つい>やしたのだ。"

#. Occurrence C_8:262:18570: scene=C_8
#: C_8:262
msgctxt "text_id=18570 | speaker=unknown"
msgid "  using the fact she was still an Aozaki to infiltrate Misaki's defenses."
msgstr "　自分がまだ蒼崎の身内である事を利用した侵攻。"

#. Occurrence C_8:267:18571: scene=C_8
#: C_8:267
msgctxt "text_id=18571 | speaker=unknown"
msgid "  For three years she had labored, selling her work to the Association."
msgstr "　身を粉にして得た三年間の成果を協会に売り渡し、"

#. Occurrence C_8:272:18572: scene=C_8
#: C_8:272
msgctxt "text_id=18572 | speaker=unknown"
msgid "  And she had used twenty years' worth of hair to mobilize an army of familiars."
msgstr "　二十年分の髪を代償にし、新たな使い魔を動員した。"

#. Occurrence C_8:278:18573: scene=C_8
#: C_8:278
msgctxt "text_id=18573 | speaker=unknown"
msgid "  It was now or never."
msgstr "　この条件で戦える事など、おそらく二度とはありえまい。"

#. Occurrence C_8:318:18574: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0000; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:318
msgctxt "text_id=18574 | speaker=touko"
msgid "\"...But I failed.\""
msgstr "“―――だが、私は失敗した”"

#. Occurrence C_8:324:18575: scene=C_8
#: C_8:324
msgctxt "text_id=18575 | speaker=unknown"
msgid "  She had overestimated the werewolf's power."
msgstr "　敗因は一点、人狼の力を絶対視しすぎていた事だ。"

#. Occurrence C_8:329:18576: scene=C_8
#: C_8:329
msgctxt "text_id=18576 | speaker=unknown"
msgid "  It should have been enough."
msgstr "　本来、そこに間違いはない。"

#. Occurrence C_8:334:18577: scene=C_8
#: C_8:334
msgctxt "text_id=18577 | speaker=unknown"
msgid "  Against mages alone, Beowulf by himself would have been enough to ensure complete victory."
msgstr "　相手が魔術師であるのなら黄金のベオウルフだけで完璧なまでに勝利できる。"

#. Occurrence C_8:383:18578: scene=C_8
#: C_8:383
msgctxt "text_id=18578 | speaker=unknown"
msgid "  But things did not always go according to plan."
msgstr "　……ただ、そこに神風みたいなトラブルが紛れこんだ。"

#. Occurrence C_8:389:18579: scene=C_8
#: C_8:389
msgctxt "text_id=18579 | speaker=unknown"
msgid "  Beo's incredible strength was conditional."
msgstr "　ベオの強さは相性の強さだ。"

#. Occurrence C_8:394:18580: scene=C_8
#: C_8:394
msgctxt "text_id=18580 | speaker=unknown"
msgid "  She knew he was not infallible, so why hadn't she prepared a contingency plan?"
msgstr "　それを熟知しておきながら、なぜ、アレを食い物にできる例外もあると<留意|りゅうい>しなかったのか。"

#. Occurrence C_8:414:18581: scene=C_8
#: C_8:414
msgctxt "text_id=18581 | speaker=unknown"
msgid "  Her heart as cold as ice, Touko stared at Soujyuro, who stood tall."
msgstr "　橙子は冷えきった心で、立ち尽くす少年を凝視する。"

#. Occurrence C_8:474:18582: scene=C_8
#: C_8:474
msgctxt "text_id=18582 | speaker=unknown"
msgid "  His arms were a hideous mess."
msgstr "　……草十郎の両腕は、ひどい事になっていた。"

#. Occurrence C_8:480:18583: scene=C_8
#: C_8:480
msgctxt "text_id=18583 | speaker=unknown"
msgid "  The arm he used to strike Beo head-on barely even resembled an arm."
msgstr "　正面からベオを打った左手は、腕のカタチをしていない。"

#. Occurrence C_8:485:18584: scene=C_8
#: C_8:485
msgctxt "text_id=18584 | speaker=unknown"
msgid "  His bones were bent out of shape; his muscles were torn to shreds. To say his arm was simply broken would be a gross understatement."
msgstr "　知恵の輪のように折れ曲がった骨と、はじけ散った筋肉繊維。<粉砕|ふんさい><骨折|こっせつ>と呼ぶのも馬鹿らしい。"

#. Occurrence C_8:505:18585: scene=C_8
#: C_8:505
msgctxt "text_id=18585 | speaker=unknown"
msgid "  Streams of crimson ran down his other arm onto the white snow."
msgstr "　残った右腕も、肘に赤い血がにじみ出ている。"

#. Occurrence C_8:510:18586: scene=C_8
#: C_8:510
msgctxt "text_id=18586 | speaker=unknown"
msgid "  The elbow he drove into Beo's back was likely shattered, and his muscle and tendons torn up to his shoulder."
msgstr "　ベオの背中を強打した肘は、その肩の筋組織まで破裂させたのだろう。"

#. Occurrence C_8:545:18587: scene=C_8
#: C_8:545
msgctxt "text_id=18587 | speaker=unknown"
msgid "  Judging from the state of his arms, it was doubtful he would be able to use them again."
msgstr "　……だらりと下がっている両腕を見ると、どちらも二度とは振るえまい。"

#. Occurrence C_8:565:18588: scene=C_8
#: C_8:565
msgctxt "text_id=18588 | speaker=unknown"
msgid "  Worse than his arms were his left leg, and no doubt his internal organs, too."
msgstr "　だが、より深い損傷を負っているのは彼の腕ではなく、内臓と左足だ。"

#. Occurrence C_8:570:18589: scene=C_8
#: C_8:570
msgctxt "text_id=18589 | speaker=unknown"
msgid "  He had used the leg to take the full brunt of Beo's charge."
msgstr "　軸足となった草十郎の左足は、ベオの突進を支えたに等しい。"

#. Occurrence C_8:576:18590: scene=C_8
#: C_8:576
msgctxt "text_id=18590 | speaker=unknown"
msgid "At a glance, it looked fine, but it was now just a useless hunk of meat attached to his torso."
msgstr "無事のように見えるが、あれはもう、ただ胴体に付いているだけの肉片だ。"

#. Occurrence C_8:581:18591: scene=C_8
#: C_8:581
msgctxt "text_id=18591 | speaker=unknown"
msgid "  His insides were worse. Supporting the weight of Beo had ruptured his spine, causing widespread internal bleeding."
msgstr "　<内臓|なかみ>はもっと酷い。ベオの体重を受け止めた事で背骨は<軋|きし>み、所々が内出血をしている。"

#. Occurrence C_8:631:18592: scene=C_8
#: C_8:631
msgctxt "text_id=18592 | speaker=unknown"
msgid "  Basically, he was a dead man standing."
msgstr "　つまり死に<体|たい>。"

#. Occurrence C_8:636:18593: scene=C_8
#: C_8:636
msgctxt "text_id=18593 | speaker=unknown"
msgid "  A bird with clipped wings."
msgstr "　あれは翼を失った鳥と同じ。"

#. Occurrence C_8:641:18594: scene=C_8
#: C_8:641
msgctxt "text_id=18594 | speaker=unknown"
msgid "  Living like that would not be living at all."
msgstr "　生きる為のカタチを捨てた、終わった命。"

#. Occurrence C_8:646:18595: scene=C_8
#: C_8:646
msgctxt "text_id=18595 | speaker=unknown"
msgid "  He could barely stand, let alone fight again."
msgstr "　もう一度戦えば、彼に戦う<術|すべ>はない。"

#. Occurrence C_8:692:18596: scene=C_8
#: C_8:692
msgctxt "text_id=18596 | speaker=unknown"
msgid "  In contrast, the collapsed werewolf was unscathed."
msgstr "　対して、倒れている人狼に傷はない。"

#. Occurrence C_8:697:18597: scene=C_8
#: C_8:697
msgctxt "text_id=18597 | speaker=unknown"
msgid "  Only once had he coughed up blood."
msgstr "　口から吐いた<血咳|けっせき>は一度だけだ。"

#. Occurrence C_8:702:18598: scene=C_8
#: C_8:702
msgctxt "text_id=18598 | speaker=unknown"
msgid "  The majority of the pool of red on the snow was Soujyuro's,"
msgstr "　雪原を染める赤い血は、草十郎だけが流している。"

#. Occurrence C_8:707:18599: scene=C_8
#: C_8:707
msgctxt "text_id=18599 | speaker=unknown"
msgid "  a crimson tapestry telling the story of the boy who stood strong and defeated a werewolf."
msgstr "　あの鋼より硬い人狼の体毛を、躊躇する事なく殴り付けた証拠である。"

#. Occurrence C_8:741:18600: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0001; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:741
msgctxt "text_id=18600 | speaker=touko"
msgid "(...Every action has an equal and opposite reaction."
msgstr "“……当然だ。衝撃には反動が伴う。"

#. Occurrence C_8:747:18601: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0002; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:747
msgctxt "text_id=18601 | speaker=touko"
msgid "  You strike, and you face the consequences-especially if you hit a werewolf."
msgstr "　拳を振るうのなら相応の負担がある。まして相手は人狼。"

#. Occurrence C_8:753:18602: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0003; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:753
msgctxt "text_id=18602 | speaker=touko"
msgid "  It would be like punching a moving freight train."
msgstr "　走ってくる鉄の壁を真っ向から殴るようなものだ。"

#. Occurrence C_8:771:18603: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0004; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:771
msgctxt "text_id=18603 | speaker=touko"
msgid "  Did he-)"
msgstr "　それを―――”"

#. Occurrence C_8:801:18604: scene=C_8
#: C_8:801
msgctxt "text_id=18604 | speaker=unknown"
msgid "  Perhaps he had known what would happen."
msgstr "　承知の上で、平然と<行|おこな>ったのか。"

#. Occurrence C_8:806:18605: scene=C_8
#: C_8:806
msgctxt "text_id=18605 | speaker=unknown"
msgid "  Animals instinctively limit their strength in order to protect their body."
msgstr "　動物は自分の体を庇って、本能的に力を加減してしまう。"

#. Occurrence C_8:811:18606: scene=C_8
#: C_8:811
msgctxt "text_id=18606 | speaker=unknown"
msgid "  Compensating for physical weakness with intellect and technique was humanity's forte, and that clash had shown humans at their very best. And yet, it had also been beyond human."
msgstr "　それを理性の力、技術の<巧|たく>みで<補|おぎな>うのが人間の利点だとしたら、今のは人間の長所の結晶であり、同時に、あまりにも人間性からかけ離れている。"

#. Occurrence C_8:843:18607: scene=C_8
#: C_8:843
msgctxt "text_id=18607 | speaker=unknown"
msgid "  He had attacked without concern for his own safety."
msgstr "　自身の保存を顧みない、無償の一撃。"

#. Occurrence C_8:848:18608: scene=C_8
#: C_8:848
msgctxt "text_id=18608 | speaker=unknown"
msgid "  Without self-preservation in mind, he could go beyond human capability."
msgstr "　自己保存の<楔|くさび>を外せば、その一撃は驚異的なものになるだろう。"

#. Occurrence C_8:853:18609: scene=C_8
#: C_8:853
msgctxt "text_id=18609 | speaker=unknown"
msgid "  Enough to strike through the steel-like fur of a legendary werewolf."
msgstr "　鋼の如き人狼の体毛を貫通したのはその結果だ。"

#. Occurrence C_8:871:18610: scene=C_8
#: C_8:871
msgctxt "text_id=18610 | speaker=unknown"
msgid "  But who would have thought that a beast, able to withstand a shot from a tank, would be felled by a mere human?"
msgstr "　……けれど、人間程度の腕力で、戦車の砲撃にも耐えるあの怪物を倒せるなどとは誰が思おうか。"

#. Occurrence C_8:915:18611: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0005; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:915
msgctxt "text_id=18611 | speaker=touko"
msgid "\"...No, that's not right."
msgstr "“……いや、違う。"

#. Occurrence C_8:922:18612: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0006; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:922
msgctxt "text_id=18612 | speaker=touko"
msgid "The boy didn't break because he struck without hesitation."
msgstr "ためらう事なく殴り付けたから壊れた、のではない。"

#. Occurrence C_8:929:18613: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0007; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:929
msgctxt "text_id=18613 | speaker=touko"
msgid "He struck knowing he was going to break.\""
msgstr "初めから、アレは<壊|・><す|・><事|・><を|・><前|・><提|・><に|・><し|・><て|・>いたな……”"

#. Occurrence C_8:962:18614: scene=C_8
#: C_8:962
msgctxt "text_id=18614 | speaker=unknown"
msgid "  He sacrificed his entire body to destroy Beo's heart."
msgstr "　身体を引き替えにした心臓撃ち。"

#. Occurrence C_8:999:18615: scene=C_8
#: C_8:999
msgctxt "text_id=18615 | speaker=unknown"
msgid "  Touko felt a chill come over her as she went over in her head what had transpired."
msgstr "　草十郎の狼退治を脳裏に再生した途端、橙子はぞくりとした感覚を味わった。"

#. Occurrence C_8:1019:18616: scene=C_8
#: C_8:1019
msgctxt "text_id=18616 | speaker=unknown"
msgid "  It should have been a nightmarish scene, but she was captivated by that supreme display of physical rationality."
msgstr "　彼女にとっては悪夢でしかない筈なのに、目を奪った人体合理の極北。"

#. Occurrence C_8:1041:18617: scene=C_8
#: C_8:1041
msgctxt "text_id=18617 | speaker=unknown"
msgid "  From the outside looking in, she had witnessed not an accident, but a rational consequence."
msgstr "　門外漢である橙子に見えたものは、アレはわずかな偶然もふくまない、当然の帰結であるという事だけ。"

#. Occurrence C_8:1046:18618: scene=C_8
#: C_8:1046
msgctxt "text_id=18618 | speaker=unknown"
msgid "  In that instant, the boy had put his entire being into piercing Beo's chest."
msgstr "　少年はあの瞬間―――ベオの胸板を貫く事だけに<専心|せんしん>していた。"

#. Occurrence C_8:1090:18619: scene=C_8
#: C_8:1090
msgctxt "text_id=18619 | speaker=unknown"
msgid "  As soon as he laid eyes on Aoko and Alice, he had committed himself fully to the task."
msgstr "　この広場に現れ、青子たちを視界に収めた時から。"

#. Occurrence C_8:1095:18620: scene=C_8
#: C_8:1095
msgctxt "text_id=18620 | speaker=unknown"
msgid "  He sized Beo up, synchronized his breathing,"
msgstr "　ベオを観察し、ベオと呼吸を合わせ、"

#. Occurrence C_8:1100:18621: scene=C_8
#: C_8:1100
msgctxt "text_id=18621 | speaker=unknown"
msgid "  found his weak point, and calculated the exact position, timing, and distance he would need to hold his ground."
msgstr "　ベオの欠点、交差するのならどの位置が適切か、どのタイミングなら決して<覆|くつがえ>らない天秤が覆るのかを算出し。"

#. Occurrence C_8:1122:18622: scene=C_8
#: C_8:1122
msgctxt "text_id=18622 | speaker=unknown"
msgid "  He knew what he had to do to win, and did it with everything he had."
msgstr "　<こ|・><の|・><条|・><件|・>なら勝機があると読み、そうなるように、自身の全てを費やした。"

#. Occurrence C_8:1142:18623: scene=C_8
#: C_8:1142
msgctxt "text_id=18623 | speaker=unknown"
msgid "  It had nothing to do with instinct."
msgstr "　……それは、野生の感性などでは決してない。"

#. Occurrence C_8:1148:18624: scene=C_8
#: C_8:1148
msgctxt "text_id=18624 | speaker=unknown"
msgid "  A wild creature would not have tried to beat something it could not."
msgstr "　野生の獣なら、勝てない相手には挑まない。"

#. Occurrence C_8:1168:18625: scene=C_8
#: C_8:1168
msgctxt "text_id=18625 | speaker=unknown"
msgid "  Only a human would risk his life when faced with the impossible."
msgstr "　勝ち目のない戦いに命を賭すのは、人間だけの矛盾である。"

#. Occurrence C_8:1226:18626: scene=C_8
#: C_8:1226
msgctxt "text_id=18626 | speaker=unknown"
msgid "  That contradiction fed his attack."
msgstr "　その矛盾が、あの一撃を練りあげた。"

#. Occurrence C_8:1231:18627: scene=C_8
#: C_8:1231
msgctxt "text_id=18627 | speaker=unknown"
msgid "  He twisted his body from his heel to his neck to focus his energy."
msgstr "　全身の円運動、<踝|かかと>から首までの捻りだしを、<錐|きり>状にして集結させた。"

#. Occurrence C_8:1236:18628: scene=C_8
#: C_8:1236
msgctxt "text_id=18628 | speaker=unknown"
msgid "  If Beo had simply tried to run Soujyuro down, the werewolf would probably have won."
msgstr "　……あるいは、ベオが突進による<轢殺|れきさつ>を目的としたのなら、草十郎は為す術なくひき殺されていただろう。"

#. Occurrence C_8:1241:18629: scene=C_8
#: C_8:1241
msgctxt "text_id=18629 | speaker=unknown"
msgid "  But the beast wanted to rip him to shreds."
msgstr "　だがベオは相手を引き裂く事を選んだ。"

#. Occurrence C_8:1247:18630: scene=C_8
#: C_8:1247
msgctxt "text_id=18630 | speaker=unknown"
msgid "Or rather, he was baited into doing so."
msgstr "いや、安い挑発で選ばされた。"

#. Occurrence C_8:1311:18631: scene=C_8
#: C_8:1311
msgctxt "text_id=18631 | speaker=unknown"
msgid "  After Beo charged, when he planted his feet..."
msgstr "　金狼が突進し、踏みこむ瞬間。"

#. Occurrence C_8:1333:18632: scene=C_8
#: C_8:1333
msgctxt "text_id=18632 | speaker=unknown"
msgid "  ...he raised his claw, then swung it downward, putting himself off-balance."
msgstr "　爪を振り上げ、下ろす時の<気勢|いしき>の淀み。"

#. Occurrence C_8:1364:18633: scene=C_8
#: C_8:1364
msgctxt "text_id=18633 | speaker=unknown"
msgid "  His pulse was erratic, his movement wild; in that moment, he was vulnerable."
msgstr "　運動の基点、脈拍の乱れ、一瞬の無防備さ。"

#. Occurrence C_8:1385:18634: scene=C_8
#: C_8:1385
msgctxt "text_id=18634 | speaker=unknown"
msgid "  That was when Soujyuro made his move."
msgstr "　彼が突いたのはその一点だ。"

#. Occurrence C_8:1391:18635: scene=C_8
#: C_8:1391
msgctxt "text_id=18635 | speaker=unknown"
msgid "  The beast had overwhelming power, but it was sloppy."
msgstr "　力を持て余し、ただ周囲にまき散らすだけの怪物と。"

#. Occurrence C_8:1396:18636: scene=C_8
#: C_8:1396
msgctxt "text_id=18636 | speaker=unknown"
msgid "  whereas the human concentrated all of his meager power into a single point."
msgstr "　数少ない力を<束|たば>ね、極小の一点に注ぎこむ人間の執念。"

#. Occurrence C_8:1401:18637: scene=C_8
#: C_8:1401
msgctxt "text_id=18637 | speaker=unknown"
msgid "  That was how the human shifted the balance in his favor."
msgstr "　その差が、天秤を人間に<傾|かたむ>けた。"

#. Occurrence C_8:1446:18638: scene=C_8
#: C_8:1446
msgctxt "text_id=18638 | speaker=unknown"
msgid "  The follow-up elbow attack would rupture Beo's heart."
msgstr "　その後、あの<無様|ぶざま>な肘撃ちでベオの心臓は破裂した。"

#. Occurrence C_8:1451:18639: scene=C_8
#: C_8:1451
msgctxt "text_id=18639 | speaker=unknown"
msgid "  It was a graceless second strike,"
msgstr "　二撃目の肘撃ちには何の美しさもない。"

#. Occurrence C_8:1456:18640: scene=C_8
#: C_8:1456
msgctxt "text_id=18640 | speaker=unknown"
msgid "  a sloppy blow no different from Beo's."
msgstr "　力まかせの、ベオと大差ない未熟な攻撃だった。"

#. Occurrence C_8:1461:18641: scene=C_8
#: C_8:1461
msgctxt "text_id=18641 | speaker=unknown"
msgid "  The elbow was only able to penetrate the beast's golden fur because of the first attack to his chest."
msgstr "　本来ならベオの体毛に弾かれるだけの肘撃ちを致命傷たらしめたのは、最初の一撃があってこそ。"

#. Occurrence C_8:1495:18642: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0008; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:1495
msgctxt "text_id=18642 | speaker=touko"
msgid "(...It left Beo wide open."
msgstr "“……あの時点でベオは丸裸にされていた。"

#. Occurrence C_8:1501:18643: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0009; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:1501
msgctxt "text_id=18643 | speaker=touko"
msgid "  Took away his invincibility for a split second."
msgstr "　無敵の人狼が、その機能の一切を休止させられた。"

#. Occurrence C_8:1507:18644: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0010; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:1507
msgctxt "text_id=18644 | speaker=touko"
msgid "  Basically...)"
msgstr "　つまり―――”"

#. Occurrence C_8:1570:18645: scene=C_8
#: C_8:1570
msgctxt "text_id=18645 | speaker=unknown"
msgid "  The strike was not meant to break, but to disable."
msgstr "　アレは『壊す』のではなく、『止める』ための芸術だ。"

#. Occurrence C_8:1611:18646: scene=C_8
#: C_8:1611
msgctxt "text_id=18646 | speaker=unknown"
msgid "  All living creatures had weaknesses."
msgstr "　生物には欠点がある。"

#. Occurrence C_8:1640:18647: scene=C_8
#: C_8:1640
msgctxt "text_id=18647 | speaker=unknown"
msgid "  No matter how strong the creature, it had weak points and weak moments."
msgstr "　どのような強者であれ、弱い部分、弱い瞬間、弱い時間は存在する。"

#. Occurrence C_8:1645:18648: scene=C_8
#: C_8:1645
msgctxt "text_id=18648 | speaker=unknown"
msgid "  Not just physically, but mentally, too."
msgstr "　それは<生態機能|フィジカル>だけに及ばず、<精神|メンタル>にもある落とし穴だ。"

#. Occurrence C_8:1665:18649: scene=C_8
#: C_8:1665
msgctxt "text_id=18649 | speaker=unknown"
msgid "  A time when they aren't in their best shape,"
msgstr "　曰く、調子が悪い。"

#. Occurrence C_8:1670:18650: scene=C_8
#: C_8:1670
msgctxt "text_id=18650 | speaker=unknown"
msgid "  unable to focus, or find motivation."
msgstr "　思考が冴えない、気分が乗らない。"

#. Occurrence C_8:1675:18651: scene=C_8
#: C_8:1675
msgctxt "text_id=18651 | speaker=unknown"
msgid "  Sickness, or a lack of sleep or food, for example, can cause the body's rhythm to go out of sync."
msgstr "　<病|やまい>、睡眠、食事、最小単位で言うのなら呼吸の隙間。"

#. Occurrence C_8:1681:18652: scene=C_8
#: C_8:1681
msgctxt "text_id=18652 | speaker=unknown"
msgid "  For a variety of reasons, intelligent beings risked losing their ability to function properly."
msgstr "　多くの理由から、理性あるものはその力を十全に発揮できない危険がある。"

#. Occurrence C_8:1686:18653: scene=C_8
#: C_8:1686
msgctxt "text_id=18653 | speaker=unknown"
msgid "  Legendary beasts were no exception."
msgstr "　いかな神話の獣と言えど、ヒトであるかぎりその縛りからは逃れられない。"

#. Occurrence C_8:1746:18654: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0011; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:1746
msgctxt "text_id=18654 | speaker=touko"
msgid "(...Weaknesses. I know some magecraft that targets weaknesses, but I've never heard of a technique that risks everything to create a weakness.)"
msgstr "“……弱点、欠点を突く魔術なら知っているが―――全てを投げうって<弱|・><点|・><を|・><生|・><む|・>とはな”"

#. Occurrence C_8:1786:18655: scene=C_8
#: C_8:1786
msgctxt "text_id=18655 | speaker=unknown"
msgid "  The boy's strike to the heart was not an attempt to kill Beo;"
msgstr "　あの少年の心臓撃ちは、ベオを殺す目的で撃たれたものではない。"

#. Occurrence C_8:1791:18656: scene=C_8
#: C_8:1791
msgctxt "text_id=18656 | speaker=unknown"
msgid "  it was designed to create a weakness in something that had none."
msgstr "　アレは弱点がないものに、弱点を作っただけ。"

#. Occurrence C_8:1796:18657: scene=C_8
#: C_8:1796
msgctxt "text_id=18657 | speaker=unknown"
msgid "  The elbow attack took advantage of that break in Beo's invulnerability."
msgstr "　その後の肘撃ちが力任せでありながらベオを粉砕したのは、既にベオが己の完全性を見失っていたからだ。"

#. Occurrence C_8:1858:18658: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0012; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:1858
msgctxt "text_id=18658 | speaker=touko"
msgid "(Laughably, it wasn't even a surprise attack."
msgstr "“……加えて、笑える事に不意打ちですらない。"

#. Occurrence C_8:1864:18659: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0013; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:1864
msgctxt "text_id=18659 | speaker=touko"
msgid "  With Beo's reflexes, he should've been able to react."
msgstr "　ベオの神経の伝達速度なら、毒が当たった瞬間に感知し、対応できる。"

#. Occurrence C_8:1875:18660: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0014; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:1875
msgctxt "text_id=18660 | speaker=touko"
msgid "  But he didn't even realize he was being attacked."
msgstr "　だが―――そもそも、それを毒と認識できなければ変形のしようもない。"

#. Occurrence C_8:1882:18661: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0015; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:1882
msgctxt "text_id=18661 | speaker=touko"
msgid "How do you teach that even something non-threatening can be a threat?)"
msgstr "<毒|・><で|・><は|・><な|・><い|・><も|・><の|・><が|・><毒|・><に|・><な|・><る|・>なんて落とし穴を、誰が教えてやれるものか―――”"

#. Occurrence C_8:1930:18662: scene=C_8
#: C_8:1930
msgctxt "text_id=18662 | speaker=unknown"
msgid "  She was frustrated, to say the least."
msgstr "　舌打ちの一つもしたくなる。"

#. Occurrence C_8:1935:18663: scene=C_8
#: C_8:1935
msgctxt "text_id=18663 | speaker=unknown"
msgid "  The boy was totally committed, utterly selfless."
msgstr "　アレは究極の<献身|けんしん>。もしくは<捨身|しゃしん>。"

#. Occurrence C_8:1940:18664: scene=C_8
#: C_8:1940
msgctxt "text_id=18664 | speaker=unknown"
msgid "  He bet his life on that single moment without expecting a single thing in return."
msgstr "　見返りを一切考えず、たった一秒の空白を作り上げる為だけに己の全てを賭した。"

#. Occurrence C_8:1945:18665: scene=C_8
#: C_8:1945
msgctxt "text_id=18665 | speaker=unknown"
msgid "  That boy had acquired the experience and skill to do such a thing."
msgstr "　それが出来る技量と経験を、あの少年は持っていたのだ。"

#. Occurrence C_8:1965:18666: scene=C_8
#: C_8:1965
msgctxt "text_id=18666 | speaker=unknown"
msgid "  It was not a miracle of luck,"
msgstr "　奇跡を呼ぶ幸運も、"

#. Occurrence C_8:1970:18667: scene=C_8
#: C_8:1970
msgctxt "text_id=18667 | speaker=unknown"
msgid "  nor a miracle of passion."
msgstr "　奇跡を掴む情熱も、あの行為には関わりがない。"

#. Occurrence C_8:1998:18668: scene=C_8
#: C_8:1998
msgctxt "text_id=18668 | speaker=unknown"
msgid "  It was not talent, tenacity, or hatred."
msgstr "　アレは才能によるものではなく、執念、怨念の<類|たぐい>。"

#. Occurrence C_8:2004:18669: scene=C_8
#: C_8:2004
msgctxt "text_id=18669 | speaker=unknown"
msgid "  Without constant, intense training, no one could destroy their own body on a whim like that."
msgstr "　過度の、極限状態での<鍛練|くりかえし>でなければ、あんな、一瞬で自身を焼却するような真似はできない。"

#. Occurrence C_8:2025:18670: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0016; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:2025
msgctxt "text_id=18670 | speaker=touko"
msgid "(He made a poor opponent for a child.)"
msgstr "“……子供には、相手が悪かったようね”"

#. Occurrence C_8:2048:18671: scene=C_8
#: C_8:2048
msgctxt "text_id=18671 | speaker=unknown"
msgid "  Seeing Beo cowering in the snow, Touko was disappointed in her own lack of foresight."
msgstr "　うずくまるベオを見て、橙子は自身の甘さに失望した。"

#. Occurrence C_8:2053:18672: scene=C_8
#: C_8:2053
msgctxt "text_id=18672 | speaker=unknown"
msgid "  She had used him for his talent alone, ignoring his inexperience."
msgstr "　性能のみを評価して連れてきたが、経験の少なさがこの結果を生んだのだ。"

#. Occurrence C_8:2058:18673: scene=C_8
#: C_8:2058
msgctxt "text_id=18673 | speaker=unknown"
msgid "  If Beo was not a child, his life experience might have given him the strength to bounce back and devour Soujyuro after regenerating."
msgstr "　ベオが子供でなければ、せめて一度でも自分と対等の相手と命を削りあう経験があったのなら、すぐさま立ち上がって草十郎を食い殺していただろうに。"

#. Occurrence C_8:2090:18674: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0017; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:2090
msgctxt "text_id=18674 | speaker=touko"
msgid "(Should I scold you, Beo? Or praise you?)"
msgstr "“ベオを責めるべきか、それとも……君を評価すべきなのか”"

#. Occurrence C_8:2098:18675: scene=C_8
#: C_8:2098
msgctxt "text_id=18675 | speaker=unknown"
msgid "  Touko quietly lifted her left hand."
msgstr "　そして、彼女は静かに左手を持ち上げる。"

#. Occurrence C_8:2118:18676: scene=C_8
#: C_8:2118
msgctxt "text_id=18676 | speaker=unknown"
msgid "  Nobody noticed."
msgstr "　気が付く者は一人もいなかった。"

#. Occurrence C_8:2138:18677: scene=C_8
#: C_8:2138
msgctxt "text_id=18677 | speaker=unknown"
msgid "  Standing far away, the boy standing there looked like a hunter from a picture book."
msgstr "　遠くで立つ少年の姿は、絵本の狩人に見えた。"

#. Occurrence C_8:2143:18678: scene=C_8
#: C_8:2143
msgctxt "text_id=18678 | speaker=unknown"
msgid "  He had a slender build, but that was likely because he intentionally shed any excess."
msgstr "　細い肉付きだが、アレは意図的に無駄を削ぎ落とされた結果だろう。"

#. Occurrence C_8:2148:18679: scene=C_8
#: C_8:2148
msgctxt "text_id=18679 | speaker=unknown"
msgid "  Given what she just witnessed, his cluelessness had to be part of an act-the act of a hunter."
msgstr "　今の光景の後だと、その<飄然|ひょうぜん>とした仕草も、獲物を狙う獣のしなやかさを思わせる。"

#. Occurrence C_8:2153:18680: scene=C_8
#: C_8:2153
msgctxt "text_id=18680 | speaker=unknown"
msgid "  As she thought to herself, she suddenly remembered."
msgstr "　それを感じながら、橙子は不意に思い出した。"

#. Occurrence C_8:2158:18681: scene=C_8
#: C_8:2158
msgctxt "text_id=18681 | speaker=unknown"
msgid "  The first thing that crossed her mind the first time they spoke..."
msgstr "　自分が彼と初めて話をした時、まっさきに脳裏によぎった事柄を。"

#. Occurrence C_8:2179:18682: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0018; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:2179
msgctxt "text_id=18682 | speaker=touko"
msgid "(...I remember now."
msgstr "“……そうだったな。"

#. Occurrence C_8:2185:18683: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_8_0019; voice_prefix=A20; voice_category=11; scene=C_8
#: C_8:2185
msgctxt "text_id=18683 | speaker=touko"
msgid "  And how I so wanted to forget, dear Soujyuro.)"
msgstr "　だが、それは忘れていたかったよ、草十郎君”"

#. Occurrence C_8:2227:18684: scene=C_8
#: C_8:2227
msgctxt "text_id=18684 | speaker=unknown"
msgid "  No sooner had she felt a slither of sentiment, she returned to her unshakeable resolve."
msgstr "　自分らしからぬ感傷を、鉄の理性が飲み下す。"

#. Occurrence C_8:2232:18685: scene=C_8
#: C_8:2232
msgctxt "text_id=18685 | speaker=unknown"
msgid "  She was raised as the heir to the Aozaki household, taught never to question the morality of her actions."
msgstr "　手段の善悪など、蒼崎の後継ぎとして育てられた時に消失している。"

#. Occurrence C_8:2237:18686: scene=C_8
#: C_8:2237
msgctxt "text_id=18686 | speaker=unknown"
msgid "  That was why, even now..."
msgstr "　だから、今からでも。"

#. Occurrence C_8:2242:18687: scene=C_8
#: C_8:2242
msgctxt "text_id=18687 | speaker=unknown"
msgid "  She knew exactly what she had to do."
msgstr "　彼女のやるべき行為は、たった一つに決まっていた。"

#. Occurrence C_9:56:18688: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0000; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:56
msgctxt "text_id=18688 | speaker=soujuurou"
msgid "\"I'm glad that went well.\""
msgstr "「でも、よかった」"

#. Occurrence C_9:62:18689: scene=C_9
#: C_9:62
msgctxt "text_id=18689 | speaker=unknown"
msgid "  Soujyuro muttered, unmoving perhaps because of the pain in his broken arms."
msgstr "　折れた両腕が痛むのか、草十郎は一歩も動かずに、そんな事を呟いた。"

#. Occurrence C_9:125:18690: scene=C_9
#: C_9:125
msgctxt "text_id=18690 | speaker=unknown"
msgid "  He did not look at Aoko."
msgstr "　彼は青子を見ていない。"

#. Occurrence C_9:130:18691: scene=C_9
#: C_9:130
msgctxt "text_id=18691 | speaker=unknown"
msgid "  Instead his gaze was focused on Alice, who was lying prone some way away."
msgstr "　労りのこもった視線は、遠くの有珠に向けられている。"

#. Occurrence C_9:135:18692: scene=C_9
#: C_9:135
msgctxt "text_id=18692 | speaker=unknown"
msgid "  Aoko thought he looked lonely."
msgstr "　どうしてか、その姿が孤独に見えて、"

#. Occurrence C_9:142:18693: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0000; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:142
msgctxt "text_id=18693 | speaker=aoko"
msgid "\"'That went well'? What did?\""
msgstr "「よかったって、なにがよ」"

#. Occurrence C_9:148:18694: scene=C_9
#: C_9:148
msgctxt "text_id=18694 | speaker=unknown"
msgid "  She asked, spurring him on."
msgstr "　焚きつけるように、青子はそう問いかけた。"

#. Occurrence C_9:168:18695: scene=C_9
#: C_9:168
msgctxt "text_id=18695 | speaker=unknown"
msgid "  They were mere steps from each other, close enough to touch hands."
msgstr "　ふたりの距離は離れてはいるが、互いが二歩も踏みだせば手が届く距離でもあった。"

#. Occurrence C_9:173:18696: scene=C_9
#: C_9:173
msgctxt "text_id=18696 | speaker=unknown"
msgid "  Their quiet voices carried in the stillness."
msgstr "　小さな声も、この静けさではよく届く。"

#. Occurrence C_9:197:18697: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0001; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:197
msgctxt "text_id=18697 | speaker=aoko"
msgid "\"Don't you dare say you're happy we're alive or I'll be so pissed.\""
msgstr "「私たちが無事だったから、なんて言ったら怒るわよ」"

#. Occurrence C_9:236:18698: scene=C_9
#: C_9:236
msgctxt "text_id=18698 | speaker=unknown"
msgid "  She was not joking."
msgstr "　本心から青子は言う。"

#. Occurrence C_9:241:18699: scene=C_9
#: C_9:241
msgctxt "text_id=18699 | speaker=unknown"
msgid "  Soujyuro turned away from her slightly, shaking his head."
msgstr "　草十郎は青子から少しだけ顔を背けて、いや、と首を振った。"

#. Occurrence C_9:279:18700: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0001; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:279
msgctxt "text_id=18700 | speaker=soujuurou"
msgid "\"I'll say it a third time, but I'm not worried about your safety, Aozaki."
msgstr "「口にするのは三度目だけど、蒼崎の心配はしていないんだ。"

#. Occurrence C_9:285:18701: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0002; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:285
msgctxt "text_id=18701 | speaker=soujuurou"
msgid "  ...Y'know, I could swear I blacked out back there just for a moment.\""
msgstr "　……いや、さっきはちょっと、意識が飛んだようなんだけど」"

#. Occurrence C_9:310:18702: scene=C_9
#: C_9:310
msgctxt "text_id=18702 | speaker=unknown"
msgid "  He said, as an embarrassed smile crossed his face."
msgstr "　照れくさそうに苦笑する。"

#. Occurrence C_9:315:18703: scene=C_9
#: C_9:315
msgctxt "text_id=18703 | speaker=unknown"
msgid "  The first time, he outright fainted. But the second time, his passion pushed the dizziness and nausea aside."
msgstr "　一度目は目眩で意識を失った。けれど、二度目は目眩も吐き気も、強い激情でかき消された。"

#. Occurrence C_9:320:18704: scene=C_9
#: C_9:320
msgctxt "text_id=18704 | speaker=unknown"
msgid "  He just calmly did what he could as best he could."
msgstr "　彼は彼なりに冷静に、やれる事に<努|つと>めただけ。"

#. Occurrence C_9:325:18705: scene=C_9
#: C_9:325
msgctxt "text_id=18705 | speaker=unknown"
msgid "  Nevertheless, no matter how calm he tried to be, deep within festered a very real rage."
msgstr "　ただ、どんなに冷静になろうとしたところで、その根底にあったものは、自分本意な怒りだったのだ。"

#. Occurrence C_9:365:18706: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0002; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:365
msgctxt "text_id=18706 | speaker=aoko"
msgid "\"Hmph... Okay, Soujyuro, what is it you think went so well?\""
msgstr "「ふーん……じゃ、何がよかったのよ、草十郎」"

#. Occurrence C_9:370:18707: scene=C_9
#: C_9:370
msgctxt "text_id=18707 | speaker=unknown"
msgid "  Aoko's voice had a slight tinge of annoyance."
msgstr "　やや不満そうな青子の声。"

#. Occurrence C_9:375:18708: scene=C_9
#: C_9:375
msgctxt "text_id=18708 | speaker=unknown"
msgid "  Soujyuro responded,"
msgstr "　それに、"

#. Occurrence C_9:396:18709: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0003; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:396
msgctxt "text_id=18709 | speaker=soujuurou"
msgid "\"Because I was finally able to keep my promise. You held up your end of the deal, but I hadn't delivered yet."
msgstr "「だって、ようやく約束が守れた。そっちだけが約束を守っているのに、こっちは果たせなかっただろ。"

#. Occurrence C_9:402:18710: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0004; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:402
msgctxt "text_id=18710 | speaker=soujuurou"
msgid "  That always bothered me. I'm so glad I got the chance to set things straight.\""
msgstr "　それがずっと気になっていたんだ。その機会があって、本当によかった」"

#. Occurrence C_9:424:18711: scene=C_9
#: C_9:424
msgctxt "text_id=18711 | speaker=unknown"
msgid "  His relief expressed itself as a small but heartfelt smile."
msgstr "　彼は本当に嬉しそうに、ささやかな笑顔を浮かべた。"

#. Occurrence C_9:506:18712: scene=C_9
#: C_9:506
msgctxt "text_id=18712 | speaker=unknown"
msgid "  Aoko listened, astonished."
msgstr "　青子は呆然とその言葉を聞いている。"

#. Occurrence C_9:523:18713: scene=C_9
#: C_9:523
msgctxt "text_id=18713 | speaker=unknown"
msgid "  For a moment she could not recall what promise Soujyuro was talking about."
msgstr "　一瞬、草十郎の言う約束とは何なのか、彼女には思い当たらなかった。"

#. Occurrence C_9:528:18714: scene=C_9
#: C_9:528
msgctxt "text_id=18714 | speaker=unknown"
msgid "  When she remembered what he was talking about-what she had told him all that time ago in the amusement park-her mind went blank."
msgstr "　それがもう遥か昔の出来事のような、遊園地でのものと気付いた時、思考が真っ白になってしまった。"

#. Occurrence C_9:571:18715: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0005; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:571
msgctxt "text_id=18715 | speaker=soujuurou"
msgid "\"If I agree to help you kill that thing, will you let me go?\""
msgstr "『アイツをやっつけるのに協力したら、俺の事は見逃してくれる？』"

#. Occurrence C_9:577:18716: scene=C_9
#: C_9:577
msgctxt "text_id=18716 | speaker=unknown"
msgid "  He proposed the deal, but in the end he hadn't been of any use."
msgstr "　自分から提案を持ちだしたものの、結局、あまり役には立てなかった。"

#. Occurrence C_9:582:18717: scene=C_9
#: C_9:582
msgctxt "text_id=18717 | speaker=unknown"
msgid "  It must have been eating away at him this entire time."
msgstr "　それを彼はずっと気に病んでいたのだろう。"

#. Occurrence C_9:613:18718: scene=C_9
#: C_9:613
msgctxt "text_id=18718 | speaker=unknown"
msgid "  Aoko had considered the agreement binding, but only for herself."
msgstr "　……青子にとってあの約束は、自分だけの<約|も><束|の>だと思っていたのに。"

#. Occurrence C_9:664:18719: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0003; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:664
msgctxt "text_id=18719 | speaker=aoko"
msgid "\"You were worried about *that*?\""
msgstr "「……あんな、どうでもいい事を……？」"

#. Occurrence C_9:670:18720: scene=C_9
#: C_9:670
msgctxt "text_id=18720 | speaker=unknown"
msgid "  She muttered in disbelief."
msgstr "　信じられない、と呟く青子。"

#. Occurrence C_9:675:18721: scene=C_9
#: C_9:675
msgctxt "text_id=18721 | speaker=unknown"
msgid "  Soujyuro gave a nod, and affirmed with a tiny voice."
msgstr "　か細いその声に、草十郎はああ、とうなずいた。"

#. Occurrence C_9:696:18722: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0006; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:696
msgctxt "text_id=18722 | speaker=soujuurou"
msgid "\"You're the one who taught me that promises are things you make to yourself, Aozaki."
msgstr "「約束は、自分のために果たすものだって、教えてくれたのは蒼崎だ。"

#. Occurrence C_9:724:18723: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0007; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:724
msgctxt "text_id=18723 | speaker=soujuurou"
msgid "  So as long as you keep your word, I need to keep mine."
msgstr "　だから、君が守っているかぎり俺も守らないといけない。"

#. Occurrence C_9:735:18724: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0008; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:735
msgctxt "text_id=18724 | speaker=soujuurou"
msgid "  Whew... What a weight off my shoulders.\""
msgstr "　……ああ。ずっと、俺はそうしたかったんだ」"

#. Occurrence C_9:777:18725: scene=C_9
#: C_9:777
msgctxt "text_id=18725 | speaker=unknown"
msgid "  As if listening to a confessional, Aoko stayed silent."
msgstr "　告解のような独白に、青子は答えない。"

#. Occurrence C_9:782:18726: scene=C_9
#: C_9:782
msgctxt "text_id=18726 | speaker=unknown"
msgid "  She could not find the words to say, anyway."
msgstr "　返答する言葉が見当たらない。"

#. Occurrence C_9:787:18727: scene=C_9
#: C_9:787
msgctxt "text_id=18727 | speaker=unknown"
msgid "  Soujyuro proved ever the enigma."
msgstr "　……何なんだろう、この男は。"

#. Occurrence C_9:792:18728: scene=C_9
#: C_9:792
msgctxt "text_id=18728 | speaker=unknown"
msgid "  Taking such a trivial promise so seriously, and speaking so sincerely about something so basic..."
msgstr "　あんな些細な約束を大事に思って、こんな簡単な言葉を大切そうに口にして。"

#. Occurrence C_9:812:18729: scene=C_9
#: C_9:812
msgctxt "text_id=18729 | speaker=unknown"
msgid "  She could not wrap her head around how he had beaten a werewolf, but his personality? That was the true mystery."
msgstr "　人狼を倒してしまった事も謎なら、その性格も謎だらけだ。"

#. Occurrence C_9:817:18730: scene=C_9
#: C_9:817
msgctxt "text_id=18730 | speaker=unknown"
msgid "  It was no use trying to figure that out now."
msgstr "　―――いまさら思い返すまでもなく。"

#. Occurrence C_9:822:18731: scene=C_9
#: C_9:822
msgctxt "text_id=18731 | speaker=unknown"
msgid "  To Aoko Aozaki, he was a riddle wrapped in an enigma wrapped in a conundrum."
msgstr "　少なくとも蒼崎青子にとって、この相手は<徹頭|てっとう><徹尾|てつび>、正体不明の存在なのだった。"

#. Occurrence C_9:854:18732: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0009; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:854
msgctxt "text_id=18732 | speaker=soujuurou"
msgid "\"So, I've paid my dues."
msgstr "「それじゃ、借りは返したから帳尻はゼロだ。"

#. Occurrence C_9:860:18733: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0010; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:860
msgctxt "text_id=18733 | speaker=soujuurou"
msgid "  We're even, Aozaki.\""
msgstr "　これで貸し借りはなしだぞ、蒼崎」"

#. Occurrence C_9:866:18734: scene=C_9
#: C_9:866
msgctxt "text_id=18734 | speaker=unknown"
msgid "  Soujyuro said lightly,"
msgstr "　草十郎は冗談っぽく口にする。"

#. Occurrence C_9:871:18735: scene=C_9
#: C_9:871
msgctxt "text_id=18735 | speaker=unknown"
msgid "  perhaps attempting to break the silence."
msgstr "　無言で沈みこむ青子に気を利かせたのだろう。"

#. Occurrence C_9:876:18736: scene=C_9
#: C_9:876
msgctxt "text_id=18736 | speaker=unknown"
msgid "  Normally this would have passed her by, but she saw his kindness for what it was."
msgstr "　いつもは気が付かないけれど、今回ばかりは、彼のそんな穏やかな優しさは伝わったようだ。"

#. Occurrence C_9:922:18737: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0004; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:922
msgctxt "text_id=18737 | speaker=aoko"
msgid "\"It's me who owes you one now."
msgstr "「貸しがついたのはこっちの方よ。"

#. Occurrence C_9:929:18738: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0005; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:929
msgctxt "text_id=18738 | speaker=aoko"
msgid "I don't even know how to begin to pay you back.\" Aoko grumbled."
msgstr "……これじゃ、どうやって返していいか分からないじゃない」"

#. Occurrence C_9:935:18739: scene=C_9
#: C_9:935
msgctxt "text_id=18739 | speaker=unknown"
msgid "  Soujyuro nodded in happy agreement."
msgstr "　青子のぼやきに、草十郎はもう一度、ああ、と嬉しげに頷いた。"

#. Occurrence C_9:971:18740: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0011; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:971
msgctxt "text_id=18740 | speaker=soujuurou"
msgid "\"Anyway, your leg looks a lot better."
msgstr "「それより蒼崎の足、なんか<塞|ふさ>がってるな。"

#. Occurrence C_9:988:18741: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_C_9_0012; voice_prefix=A30; voice_category=3; scene=C_9
#: C_9:988
msgctxt "text_id=18741 | speaker=soujuurou"
msgid "  Can you stand?\""
msgstr "　もしかして、もう立てるのか？」"

#. Occurrence C_9:994:18742: scene=C_9
#: C_9:994
msgctxt "text_id=18742 | speaker=unknown"
msgid "  She shot him a stubborn look as if to say, \"well, duh, obviously.\""
msgstr "　あったりまえよ、と青子は目で意地を張る。"

#. Occurrence C_9:1008:18743: scene=C_9
#: C_9:1008
msgctxt "text_id=18743 | speaker=unknown"
msgid "  Ever amazed by her grit, he offered her his right hand."
msgstr "　その気丈さに呆れながら、草十郎は右手を差し伸べた。"

#. Occurrence C_9:1030:18744: scene=C_9
#: C_9:1030
msgctxt "text_id=18744 | speaker=unknown"
msgid "  Despite being broken at the elbow, to Aoko it looked as sturdy as ever."
msgstr "　肘が砕けているのに、青子にはその右手は何より頑丈そうに見えた。"

#. Occurrence C_9:1035:18745: scene=C_9
#: C_9:1035
msgctxt "text_id=18745 | speaker=unknown"
msgid "  By all appearances, it was beyond recovery, and would be for the rest of his life."
msgstr "　どう見ても再起不能。おそらくは<一生涯|いっしょうがい><完治|かんち>しまい。"

#. Occurrence C_9:1040:18746: scene=C_9
#: C_9:1040
msgctxt "text_id=18746 | speaker=unknown"
msgid "  Even so, he seemed able to ignore the pain for Aoko's sake."
msgstr "　それでも青子を立たせる為なら、その時だけは痛まないのだろう。"

#. Occurrence C_9:1061:18747: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0006; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:1061
msgctxt "text_id=18747 | speaker=aoko"
msgid "\"You really are hopeless.\""
msgstr "「……ほんと、アンタってばか」"

#. Occurrence C_9:1070:18748: scene=C_9
#: C_9:1070
msgctxt "text_id=18748 | speaker=unknown"
msgid "  She uttered under her breath, looking up at him."
msgstr "　見上げながら青子は小さく呟いた。"

#. Occurrence C_9:1075:18749: scene=C_9
#: C_9:1075
msgctxt "text_id=18749 | speaker=unknown"
msgid "  As much as she hated to admit, she could not refuse his hand."
msgstr "　悔しいけれど、今はその手を拒めそうにない。"

#. Occurrence C_9:1080:18750: scene=C_9
#: C_9:1080
msgctxt "text_id=18750 | speaker=unknown"
msgid "  Resigning herself, she reached out to Soujyuro."
msgstr "　青子は仕方なげに、草十郎の手を取ろうと手を伸ばす。"

#. Occurrence C_9:1117:18751: scene=C_9
#: C_9:1117
msgctxt "text_id=18751 | speaker=unknown"
msgid "  But her hand never reached his."
msgstr "　けれど、その手が触れ合う事はなかった。"

#. Occurrence C_9:1127:18752: scene=C_9
#: C_9:1127
msgctxt "text_id=18752 | speaker=unknown"
msgid "  A small bell chimed."
msgstr "　しゃん、と鈴を鳴らす音。"

#. Occurrence C_9:1144:18753: scene=C_9
#: C_9:1144
msgctxt "text_id=18753 | speaker=unknown"
msgid "  A line of wind whipped through the air."
msgstr "　風は線を引いて走った。"

#. Occurrence C_9:1149:18754: scene=C_9
#: C_9:1149
msgctxt "text_id=18754 | speaker=unknown"
msgid "  It cut through his waist, like a guillotine."
msgstr "　断頭台の刃は、胴体を裂くように横なぐりに。"

#. Occurrence C_9:1189:18755: scene=C_9
#: C_9:1189
msgctxt "text_id=18755 | speaker=unknown"
msgid "  Pieces began to fall."
msgstr "　あっけなく崩れ落ちる。"

#. Occurrence C_9:1196:18756: scene=C_9
#: C_9:1196
msgctxt "text_id=18756 | speaker=unknown"
msgid "  What were those things dropping before her eyes? Aoko could not remember who they belonged to."
msgstr "　目の前に落ちた<物|モ><体|ノ>が一秒前まで誰だったか、彼女はすぐに、思い出せなかった。"

#. Occurrence C_9:1234:18757: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0007; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:1234
msgctxt "text_id=18757 | speaker=aoko"
msgid "\"Sou...jyuro...?\""
msgstr "「そう……じゅうろう……？」"

#. Occurrence C_9:1254:18758: scene=C_9
#: C_9:1254
msgctxt "text_id=18758 | speaker=unknown"
msgid "  That used to be his name, right? The name of whoever lay in the red snow in front of her."
msgstr "　自分と同じく地に臥した、そう呼ばれていた物に青子は語りかけた。"

#. Occurrence C_9:1259:18759: scene=C_9
#: C_9:1259
msgctxt "text_id=18759 | speaker=unknown"
msgid "  His face now rested on the ground beneath her chin."
msgstr "　彼の顔はもう、自分より低いところに倒れている。"

#. Occurrence C_9:1264:18760: scene=C_9
#: C_9:1264
msgctxt "text_id=18760 | speaker=unknown"
msgid "  The smell of viscera assaulted her nostrils."
msgstr "　鼻腔をつく<臓|ハ><物|ラ>の異臭。"

#. Occurrence C_9:1269:18761: scene=C_9
#: C_9:1269
msgctxt "text_id=18761 | speaker=unknown"
msgid "  A river of blood flowed from what used to be a stomach."
msgstr "　かつて胃のあった箇所から、赤い血液が飛散している。"

#. Occurrence C_9:1302:18762: scene=C_9
#: C_9:1302
msgctxt "text_id=18762 | speaker=unknown"
msgid "  It happened so fast."
msgstr "　一瞬の出来事だった。"

#. Occurrence C_9:1307:18763: scene=C_9
#: C_9:1307
msgctxt "text_id=18763 | speaker=unknown"
msgid "  Too fast for her mind to process in fact."
msgstr "　水のつまったバケツを倒した時みたいに、何もかも一瞬で終わってしまって、現実感がまるで無い。"

#. Occurrence C_9:1326:18764: scene=C_9
#: C_9:1326
msgctxt "text_id=18764 | speaker=unknown"
msgid "  Her only solace was he probably did not suffer."
msgstr "　唯一の救いは、たぶん、痛みさえ一瞬だった事ぐらい。"

#. Occurrence C_9:1331:18765: scene=C_9
#: C_9:1331
msgctxt "text_id=18765 | speaker=unknown"
msgid "  How could she think that so calmly, especially after what she had witnessed? Her blood boiled at her own stupidity."
msgstr "　青子は一変した状況を目前にしながら、冷静に、即死だな、と判断する自分に腹を立てた。"

#. Occurrence C_9:1347:18766: scene=C_9
#: C_9:1347
msgctxt "text_id=18766 | speaker=unknown"
msgid "  Which begged the question..."
msgstr "　……しかし。"

#. Occurrence C_9:1353:18767: scene=C_9
#: C_9:1353
msgctxt "text_id=18767 | speaker=unknown"
msgid "How should she treat the one who did this?"
msgstr "そうなると、これを行った相手にはどんな感情をぶつければいいのだろう。"

#. Occurrence C_9:1396:18768: scene=C_9
#: C_9:1396
msgctxt "text_id=18768 | speaker=unknown"
msgid "  She had used all her anger on herself."
msgstr "　怒りは自分相手に使ってしまった。"

#. Occurrence C_9:1401:18769: scene=C_9
#: C_9:1401
msgctxt "text_id=18769 | speaker=unknown"
msgid "  She had none left to give anyone else."
msgstr "　他人に回す余裕なんて許さない。"

#. Occurrence C_9:1406:18770: scene=C_9
#: C_9:1406
msgctxt "text_id=18770 | speaker=unknown"
msgid "  But this hatred was hers and hers alone."
msgstr "　この憎悪は自分を焼く為に使うと決めた。"

#. Occurrence C_9:1411:18771: scene=C_9
#: C_9:1411
msgctxt "text_id=18771 | speaker=unknown"
msgid "  Her problem was this: could she muster the emotions from this drought of anger?"
msgstr "　次の問題は、コレを上回る激情が、はたして自分の中にあるかどうか。"

#. Occurrence C_9:1416:18772: scene=C_9
#: C_9:1416
msgctxt "text_id=18772 | speaker=unknown"
msgid "  She was not sure, but the thought of hunting them down made her smile unconsciously in anticipation."
msgstr "　疑問に思いつつ、それを探すのはわりと楽しそうな気がして、彼女はくすりと<微笑|わら>ってしまった。"

#. Occurrence C_9:1463:18773: scene=C_9
#: C_9:1463
msgctxt "text_id=18773 | speaker=unknown"
msgid "  Aoko turned to the old school building, to where Touko was standing with her arm out in front of her."
msgstr "　旧校舎に視線を向けると、片腕を胸の位置に構えた蒼崎橙子の姿がある。"

#. Occurrence C_9:1468:18774: scene=C_9
#: C_9:1468
msgctxt "text_id=18774 | speaker=unknown"
msgid "  She had used the same rune magecraft she used against Aoko and Alice. Except Soujyuro had no Magic Crests."
msgstr "　彼女は青子や有珠には魔力で<弾|はじ>かれる簡素なルーン魔術を、刻印を持たない<草|あ><十|い><郎|て>に放ったのだ。"

#. Occurrence C_9:1502:18775: scene=C_9
#: C_9:1502
msgctxt "text_id=18775 | speaker=unknown"
msgid "  Touko's amber eyes were narrowed, staring intensely at the fallen corpse."
msgstr "　橙子は琥珀色の瞳をやや細めて、崩れ落ちた死体を見つめている。"

#. Occurrence C_9:1507:18776: scene=C_9
#: C_9:1507
msgctxt "text_id=18776 | speaker=unknown"
msgid "  As to what she might have been feeling, Aoko could not care less."
msgstr "　そこにどんな感情があるかなんて、青子はいちいち考えてみる気にもならなかった。"

#. Occurrence C_9:1512:18777: scene=C_9
#: C_9:1512
msgctxt "text_id=18777 | speaker=unknown"
msgid "  Even if Touko felt regret, Aoko would never forgive her for as long as she drew breath."
msgstr "　もし仮に後悔の色なんてあったりしたら、それこそ一生許せないだろうし。"

#. Occurrence C_9:1578:18778: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_9_0000; voice_prefix=A20; voice_category=11; scene=C_9
#: C_9:1578
msgctxt "text_id=18778 | speaker=touko"
msgid "\"I should have killed you when I had the chance.\""
msgstr "「やはり、君からこうしておくべきだったな」"

#. Occurrence C_9:1584:18779: scene=C_9
#: C_9:1584
msgctxt "text_id=18779 | speaker=unknown"
msgid "  Touko was not speaking to Aoko, but to the dead body."
msgstr "　橙子は青子にではなく、もう応えない死体に語りかけた。"

#. Occurrence C_9:1589:18780: scene=C_9
#: C_9:1589
msgctxt "text_id=18780 | speaker=unknown"
msgid "  There was no response."
msgstr "　反応もない。"

#. Occurrence C_9:1595:18781: scene=C_9
#: C_9:1595
msgctxt "text_id=18781 | speaker=unknown"
msgid "No clouds of breath."
msgstr "呼吸もない。"

#. Occurrence C_9:1600:18782: scene=C_9
#: C_9:1600
msgctxt "text_id=18782 | speaker=unknown"
msgid "  Coming to terms that he was truly dead, Aoko pushed herself up to her feet."
msgstr "　それが完全に死んでいる事を確認して、青子は腕に力をこめて立ち上がった。"

#. Occurrence C_9:1660:18783: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0008; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:1660
msgctxt "text_id=18783 | speaker=aoko"
msgid "\"That was surprisingly gruesome for you.\""
msgstr "「案外、無様ね」"

#. Occurrence C_9:1666:18784: scene=C_9
#: C_9:1666
msgctxt "text_id=18784 | speaker=unknown"
msgid "  Facing her sister in the distance, Aoko spoke hoarsely."
msgstr "　遠く離れた姉に向けて、青子は乾いた声で語りかける。"

#. Occurrence C_9:1673:18785: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0009; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:1673
msgctxt "text_id=18785 | speaker=aoko"
msgid "\"But you made the right choice. Now we can finish this.\""
msgstr "「でも正しい選択だわ。これで勝負はやり直しだもの」"

#. Occurrence C_9:1749:18786: scene=C_9
#: C_9:1749
msgctxt "text_id=18786 | speaker=unknown"
msgid "  She turned away from Soujyuro and stared at Aoko."
msgstr "　彼の死体に背を向けて、青子は橙子へと向き直った。"

#. Occurrence C_9:1754:18787: scene=C_9
#: C_9:1754
msgctxt "text_id=18787 | speaker=unknown"
msgid "  They stood far apart."
msgstr "　両者の距離は遠い。"

#. Occurrence C_9:1759:18788: scene=C_9
#: C_9:1759
msgctxt "text_id=18788 | speaker=unknown"
msgid "  Farther apart than their positions made them seem."
msgstr "　それは実際の広がりより、遥かに遠い<断絶|だんぜつ>。"

#. Occurrence C_9:1764:18789: scene=C_9
#: C_9:1764
msgctxt "text_id=18789 | speaker=unknown"
msgid "  Though there was nothing left to say, the two of them exchanged words in respect of the fact they were once sisters."
msgstr "　本当は交わす言葉なんて無いのだけど、今までの姉妹としての人生に敬意を表して、ふたりは益体のない会話を交わす。"

#. Occurrence C_9:1785:18790: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_9_0001; voice_prefix=A20; voice_category=11; scene=C_9
#: C_9:1785
msgctxt "text_id=18790 | speaker=touko"
msgid "\"...Right. You've seen the aces up my sleeve: my Magic Crests, and the werewolf you've trumped."
msgstr "「―――ああ。魔術刻印という私の切札はこの通りで、人狼というカードもおまえの切札の前に破れ去った。"

#. Occurrence C_9:1791:18791: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_9_0002; voice_prefix=A20; voice_category=11; scene=C_9
#: C_9:1791
msgctxt "text_id=18791 | speaker=touko"
msgid "  I've used all my crests up. And your trump card's been torn to pieces."
msgstr "　だが、そちらも刻印を使いきり、彼もいま息絶えた。"

#. Occurrence C_9:1797:18792: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_9_0003; voice_prefix=A20; voice_category=11; scene=C_9
#: C_9:1797
msgctxt "text_id=18792 | speaker=touko"
msgid "  Stalemate.\""
msgstr "　互いに決定打はなくなった訳だ」"

#. Occurrence C_9:1818:18793: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0010; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:1818
msgctxt "text_id=18793 | speaker=aoko"
msgid "\"Looks that way. I suppose I was naive, too. I should've known you wouldn't accept defeat after your werewolf failed."
msgstr "「そうね。私も甘かった。人狼が再起不能になった時点で、貴女が敗北を認めたなんて勝手に思い上がるんだから。"

#. Occurrence C_9:1824:18794: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0011; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:1824
msgctxt "text_id=18794 | speaker=aoko"
msgid "  If you weren't so stubborn, you'd never have come back to Misaki."
msgstr "　……本来ならそうなるんだけど、貴女がそんなに<諦|あきら>めがいいのなら、この町に戻ってきはしないものね。"

#. Occurrence C_9:1858:18795: scene=C_9
#: C_9:1858
msgctxt "text_id=18795 | speaker=unknown"
msgid "  ..."
msgstr "　――――――"

#. Occurrence C_9:1867:18796: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0012; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:1867
msgctxt "text_id=18796 | speaker=aoko"
msgid "I... really was naïve.\""
msgstr "本当に、甘かった」"

#. Occurrence C_9:1917:18797: scene=C_9
#: C_9:1917
msgctxt "text_id=18797 | speaker=unknown"
msgid "  It was clear to Touko that Aoko was trying to suppress her emotions."
msgstr "　青子の声が、自分の<言霊|ことだま>を圧倒している事を橙子は認めた。"

#. Occurrence C_9:1922:18798: scene=C_9
#: C_9:1922
msgctxt "text_id=18798 | speaker=unknown"
msgid "  Aoko was right, though. Her sister had counted on Beowulf to succeed."
msgstr "　青子の見解は正しい。それほど橙子は<使い魔|ベオウルフ>に依存していた。"

#. Occurrence C_9:1927:18799: scene=C_9
#: C_9:1927
msgctxt "text_id=18799 | speaker=unknown"
msgid "  As mages, no matter what cards Aoko or Alice had in their hands, they were helpless against the werewolf."
msgstr "　有珠と青子にどんな切札があろうと、彼女たちが魔術師である以上、倒しようのなかった最強の人狼。"

#. Occurrence C_9:1932:18800: scene=C_9
#: C_9:1932
msgctxt "text_id=18800 | speaker=unknown"
msgid "  But then, Soujyuro had shown up, and Touko couldn't win as long as he was around."
msgstr "　それを破った草十郎がいるかぎりは、橙子に勝利はない。"

#. Occurrence C_9:1937:18801: scene=C_9
#: C_9:1937
msgctxt "text_id=18801 | speaker=unknown"
msgid "  Unfortunately, though he had stopped the werewolf, he had been defenseless against a mage."
msgstr "　けれど草十郎は人狼を討つ事はできても、魔術師に対しては、そのかぎりではなかったのだ。"

#. Occurrence C_9:1979:18802: scene=C_9
#: C_9:1979
msgctxt "text_id=18802 | speaker=unknown"
msgid "  So she had to kill him."
msgstr "　だから殺した。"

#. Occurrence C_9:1984:18803: scene=C_9
#: C_9:1984
msgctxt "text_id=18803 | speaker=unknown"
msgid "  With Soujyuro out of the way, no one could hold Beo back."
msgstr "　草十郎さえ退場すれば人狼を阻む者はいなくなる。"

#. Occurrence C_9:1989:18804: scene=C_9
#: C_9:1989
msgctxt "text_id=18804 | speaker=unknown"
msgid "  It would take time for him to recover, but as long as his wounds were only mental, that could be overcome."
msgstr "　人狼の再起に時間はかかるだろうが、精神的なものであるなら治療可能だ。"

#. Occurrence C_9:1994:18805: scene=C_9
#: C_9:1994
msgctxt "text_id=18805 | speaker=unknown"
msgid "  Alice and Aoko could try to attack again before he recovered, but Alice was being kept in check by the poison, so Touko still had the advantage."
msgstr "　その前に青子たちは挑んでくるだろうが、有珠の体内の毒草を解呪しないかぎり橙子の優位は動かない。"

#. Occurrence C_9:2068:18806: scene=C_9
#: C_9:2068
msgctxt "text_id=18806 | speaker=unknown"
msgid "  Stalemate, still."
msgstr "　この通り、今はお互い決定打が無い。"

#. Occurrence C_9:2073:18807: scene=C_9
#: C_9:2073
msgctxt "text_id=18807 | speaker=unknown"
msgid "  The battle would drag on."
msgstr "　戦いはどう見ても後日に引き伸ばされる事になる。"

#. Occurrence C_9:2091:18808: scene=C_9
#: C_9:2091
msgctxt "text_id=18808 | speaker=unknown"
msgid "  Unless Aoko were to use *it*."
msgstr "　―――青子が、それを使わなければ。"

#. Occurrence C_9:2167:18809: scene=C_9
#: C_9:2167
msgctxt "text_id=18809 | speaker=unknown"
msgid "  Powdery snow began to whirl around."
msgstr "　粉雪が舞う。"

#. Occurrence C_9:2172:18810: scene=C_9
#: C_9:2172
msgctxt "text_id=18810 | speaker=unknown"
msgid "  The air around her wailed."
msgstr "　彼女を中心に、大気そのものが<軋|きし>みをあげる。"

#. Occurrence C_9:2178:18811: scene=C_9
#: C_9:2178
msgctxt "text_id=18811 | speaker=unknown"
msgid "  It was magecraft that transcended all that was mystical-"
msgstr "　―――神秘を<超越|ちょうえつ>した魔術。"

#. Occurrence C_9:2184:18812: scene=C_9
#: C_9:2184
msgctxt "text_id=18812 | speaker=unknown"
msgid "  the gate to miracles beyond human comprehension, ready to show itself."
msgstr "　人智を<拒|こば>む奇跡の扉が、この雪原に下りようとしている。"

#. Occurrence C_9:2259:18813: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_C_9_0004; voice_prefix=A20; voice_category=11; scene=C_9
#: C_9:2259
msgctxt "text_id=18813 | speaker=touko"
msgid "\"You always did love to fight, Aoko.\""
msgstr "「やる気のようね、青子」"

#. Occurrence C_9:2351:18814: scene=C_9
#: C_9:2351
msgctxt "text_id=18814 | speaker=unknown"
msgid "  Touko released the crests maintaining the fields."
msgstr "　橙子は結界の維持を解除した。"

#. Occurrence C_9:2356:18815: scene=C_9
#: C_9:2356
msgctxt "text_id=18815 | speaker=unknown"
msgid "  With that, her grandfather would be freed, and the barriers around Misaki would be restored."
msgstr "　これで祖父は自由になり、ここまで破壊した三咲の結界は修復されてしまうだろう。"

#. Occurrence C_9:2361:18816: scene=C_9
#: C_9:2361
msgctxt "text_id=18816 | speaker=unknown"
msgid "  Which was not what Touko wanted, but it was that or forfeit her life."
msgstr "　だが、今ここで刻印を使わなければ自分の命が無いと彼女は即断した。"

#. Occurrence C_9:2381:18817: scene=C_9
#: C_9:2381
msgctxt "text_id=18817 | speaker=unknown"
msgid "  The crests at her disposal were now twice as powerful as her sister's."
msgstr "　使用可能になった橙子の刻印は、青子の<刻印|それ>の二倍強。"

#. Occurrence C_9:2407:18818: scene=C_9
#: C_9:2407
msgctxt "text_id=18818 | speaker=unknown"
msgid "  Aoko gazed at this new threat with her eyes half-closed."
msgstr "　その脅威を青子は半眼で眺めている。"

#. Occurrence C_9:2423:18819: scene=C_9
#: C_9:2423
msgctxt "text_id=18819 | speaker=unknown"
msgid "  None of this was her concern."
msgstr "　まるっきり興味の外。"

#. Occurrence C_9:2428:18820: scene=C_9
#: C_9:2428
msgctxt "text_id=18820 | speaker=unknown"
msgid "  Far removed from the situation, she was searching for something hidden deeper inside herself, desperate to reach it."
msgstr "　彼女はそんな<外部|モノ>より、心中に<潜|ひそ>むモノを探りあて、慎重に捕まえていた。"

#. Occurrence C_9:2476:18821: scene=C_9
#: C_9:2476
msgctxt "text_id=18821 | speaker=unknown"
msgid "  There it was, an odd feeling, like picking up algae."
msgstr "　……それは、<藻|も>のような手応えだった。"

#. Occurrence C_9:2481:18822: scene=C_9
#: C_9:2481
msgctxt "text_id=18822 | speaker=unknown"
msgid "  It was not the fire of emotion. It was not solid, nor great."
msgstr "　激情の<類|たぐい>ではないし、堅くも、大きくもない。"

#. Occurrence C_9:2493:18823: scene=C_9
#: C_9:2493
msgctxt "text_id=18823 | speaker=unknown"
msgid "  It must have been people meant by \"rising to the occasion.\""
msgstr "　きっと、こんなのはその場の<勢|いきお>い。"

#. Occurrence C_9:2498:18824: scene=C_9
#: C_9:2498
msgctxt "text_id=18824 | speaker=unknown"
msgid "  Abandoning thought itself, Aoko held on to that feeling as she stared at her enemy."
msgstr "　彼女は思考そのものを放棄して、心中のわだかまりを掌中に収め、強く敵を凝視する。"

#. Occurrence C_9:2522:18825: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0013; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:2522
msgctxt "text_id=18825 | speaker=aoko"
msgid "\"All right, Touko.\""
msgstr "「いいわよ、橙子」"

#. Occurrence C_9:2527:18826: scene=C_9
#: C_9:2527
msgctxt "text_id=18826 | speaker=unknown"
msgid "  She spoke softly, yet more loudly than a scream."
msgstr "　小さな、けれど叫びより確かな呟き。"

#. Occurrence C_9:2534:18827: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_C_9_0014; voice_prefix=A10; voice_category=1; scene=C_9
#: C_9:2534
msgctxt "text_id=18827 | speaker=aoko"
msgid "\"You want True Magic? You've got it.\""
msgstr "「―――お望みどおり、本当の『魔法』を見せてあげる」"

#. Occurrence C_9:2540:18828: scene=C_9
#: C_9:2540
msgctxt "text_id=18828 | speaker=unknown"
msgid "  Focusing her power into the dim crests on her right arm, she weaved the words together."
msgstr "　輝きを失った右腕の刻印に<意識|ちから>を込めて、彼女はその続きをはっきりと紡いだ。"

#. Occurrence C_9:2616:18829: scene=C_9
#: C_9:2616
msgctxt "text_id=18829 | speaker=unknown"
msgid "  A single incantation."
msgstr "　ひとつの呪文。"

#. Occurrence C_9:2623:18830: scene=C_9
#: C_9:2623
msgctxt "text_id=18830 | speaker=unknown"
msgid "  A final, heartfelt farewell."
msgstr "　深い想いが<籠|こ>められた彼女の訣別。"

#. Occurrence C_9:2629:18831: scene=C_9
#: C_9:2629
msgctxt "text_id=18831 | speaker=unknown"
msgid "  A brilliant, blue-colored Magic, taking time back to when a certain someone had been blessed."
msgstr "　それは、ある誰かの幸福だった時間を巻き戻す、青い色をした魔法のことば。"

#. Occurrence D_1:52:18832: scene=D_1
#: D_1:52
msgctxt "text_id=18832 | speaker=unknown"
msgid "  Six days passed, the weather in that time sunny and clear."
msgstr "　それから六日が経って、天気は晴れて。"

#. Occurrence D_1:109:18833: scene=D_1
#: D_1:109
msgctxt "text_id=18833 | speaker=unknown"
msgid "  It first came to Soujyuro's attention when he was resting with Alice after spending all day cleaning."
msgstr "　彼がその話を聞いたのは、一日かけての大掃除が終わって、有珠と一服している時。"

#. Occurrence D_1:133:18834: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_1_0000; voice_prefix=A10; voice_category=1; scene=D_1
#: D_1:133
msgctxt "text_id=18834 | speaker=aoko"
msgid "\"You're off work today, right, Soujyuro?\""
msgstr "「草十郎、今日ぐらいはバイト休みでしょ？」"

#. Occurrence D_1:139:18835: scene=D_1
#: D_1:139
msgctxt "text_id=18835 | speaker=unknown"
msgid "  Aoko asked him in her usual manner immediately upon entering the drawing room."
msgstr "　居間に入ってくるなり、青子はいつもの調子でそう言った。"

#. Occurrence D_1:170:18836: scene=D_1
#: D_1:170
msgctxt "text_id=18836 | speaker=unknown"
msgid "  It was already nighttime, approaching nine o'clock."
msgstr "　夜もふけて、時刻は九時になろうとしている。"

#. Occurrence D_1:175:18837: scene=D_1
#: D_1:175
msgctxt "text_id=18837 | speaker=unknown"
msgid "  The afternoon's sunny weather had changed abruptly, and thick clouds were visible out the window."
msgstr "　昼間の晴天から一変して、窓の外は厚い雲。"

#. Occurrence D_1:180:18838: scene=D_1
#: D_1:180
msgctxt "text_id=18838 | speaker=unknown"
msgid "  Awoken from his nonchalant daydreaming, Soujyuro tilted his head to the side and replied calmly."
msgstr "　それをのんびり眺めていた草十郎は、うん？と平和そうに首をかしげた。"

#. Occurrence D_1:201:18839: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_1_0000; voice_prefix=A30; voice_category=3; scene=D_1
#: D_1:201
msgctxt "text_id=18839 | speaker=soujuurou"
msgid "\"I'm off today, but why do you ask?\""
msgstr "「休みだけど、どうして？」"

#. Occurrence D_1:207:18840: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_1_0001; voice_prefix=A10; voice_category=1; scene=D_1
#: D_1:207
msgctxt "text_id=18840 | speaker=aoko"
msgid "\"I'm making a trip home in a bit, so get your things ready.\""
msgstr "「これから実家に戻るから、用意しておいて」"

#. Occurrence D_1:213:18841: scene=D_1
#: D_1:213
msgctxt "text_id=18841 | speaker=unknown"
msgid "  Soujyuro's peaceful expression had grown tense the moment she appeared."
msgstr "　緩みきった草十郎の表情は、青子の登場でとたんに曇ってしまう。"

#. Occurrence D_1:218:18842: scene=D_1
#: D_1:218
msgctxt "text_id=18842 | speaker=unknown"
msgid "  Unsure of what any of this had to do with him, he stole a glance at Alice, who was seated across from him."
msgstr "　今の台詞が自分にどう関係するのか掴めず、草十郎は正面に座っている有珠をちらりと盗み見た。"

#. Occurrence D_1:255:18843: scene=D_1
#: D_1:255
msgctxt "text_id=18843 | speaker=unknown"
msgid "  However, she looked surprised as well, her eyes widening ever so slightly as she studied the other two."
msgstr "　有珠にとっても今の台詞は意外だったらしく、わずかに目を開かせて、青子と草十郎を<見比|みくら>べている。"

#. Occurrence D_1:303:18844: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_1_0001; voice_prefix=A30; voice_category=3; scene=D_1
#: D_1:303
msgctxt "text_id=18844 | speaker=soujuurou"
msgid "\"Huh? What things?\""
msgstr "「用意って、何の？」"

#. Occurrence D_1:308:18845: scene=D_1
#: D_1:308
msgctxt "text_id=18845 | speaker=unknown"
msgid "  He replied timidly, struggling to hide his bitterness at Aoko for waiting until the cleaning was finished before deciding to show up."
msgstr "　大掃除が終わるまで行方を<暗|くら>ましていた青子への批難をぐっと<堪|こら>えて、草十郎は恐る恐る聞き返す。"

#. Occurrence D_1:333:18846: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_1_0002; voice_prefix=A10; voice_category=1; scene=D_1
#: D_1:333
msgctxt "text_id=18846 | speaker=aoko"
msgid "\"Your things. Get them ready. It takes an hour to walk up the mountain, so make sure you dress accordingly.\""
msgstr "「用意は用意よ。一時間ぐらい歩く山の上だから、寒くない格好しろって言ってるの」"

#. Occurrence D_1:369:18847: scene=D_1
#: D_1:369
msgctxt "text_id=18847 | speaker=unknown"
msgid "  Soujyuro's expression only grew darker."
msgstr "　草十郎はますます顔を曇らせる。"

#. Occurrence D_1:374:18848: scene=D_1
#: D_1:374
msgctxt "text_id=18848 | speaker=unknown"
msgid "  The way she spoke made it sound like..."
msgstr "　今の言い回しだと、まるで―――"

#. Occurrence D_1:381:18849: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_D_1_0000; voice_prefix=A40; voice_category=2; scene=D_1
#: D_1:381
msgctxt "text_id=18849 | speaker=alice"
msgid "\"You're taking Sizuki with you?\""
msgstr "「……静希君を連れていくの？」"

#. Occurrence D_1:407:18850: scene=D_1
#: D_1:407
msgctxt "text_id=18850 | speaker=unknown"
msgid "  Alice spoke up before Soujyuro himself could manage to say anything."
msgstr "　草十郎が口にするより早く、有珠が青子に問いかけた。"

#. Occurrence D_1:412:18851: scene=D_1
#: D_1:412
msgctxt "text_id=18851 | speaker=unknown"
msgid "  Aoko brusquely asked if there was a problem."
msgstr "　それにいけない？　と青子は言い返す。"

#. Occurrence D_1:447:18852: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_1_0003; voice_prefix=A10; voice_category=1; scene=D_1
#: D_1:447
msgctxt "text_id=18852 | speaker=aoko"
msgid "\"I don't even want to go."
msgstr "「私だってあんなとこに行きたくないわよ。"

#. Occurrence D_1:453:18853: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_1_0004; voice_prefix=A10; voice_category=1; scene=D_1
#: D_1:453
msgctxt "text_id=18853 | speaker=aoko"
msgid "  But they keep asking me to stop by, so I'm gonna make a brief visit."
msgstr "　けど今日ぐらいは顔を出せってうるさいから、ホントに顔だけ見せにいくの。"

#. Occurrence D_1:460:18854: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_1_0005; voice_prefix=A10; voice_category=1; scene=D_1
#: D_1:460
msgctxt "text_id=18854 | speaker=aoko"
msgid "I just thought I'd bring Soujyuro along since he's free. That's all.\""
msgstr "草十郎を連れていくのは、たんに暇だからだけど」"

#. Occurrence D_1:491:18855: scene=D_1
#: D_1:491
msgctxt "text_id=18855 | speaker=unknown"
msgid "  She stood tall as if challenging her roommate to oppose her decision."
msgstr "　文句ないでしょ？　と胸を張って主張する。"

#. Occurrence D_1:516:18856: scene=D_1
#: D_1:516
msgctxt "text_id=18856 | speaker=unknown"
msgid "  Alice's face was dour as she gazed back."
msgstr "　有珠はどこかうかない顔をして青子を見る。"

#. Occurrence D_1:528:18857: scene=D_1
#: D_1:528
msgctxt "text_id=18857 | speaker=unknown"
msgid "  Soujyuro's irritation was obvious as well as he glared at Aoko."
msgstr "　草十郎も露骨にイヤそうな顔をして青子を見る。"

#. Occurrence D_1:557:18858: scene=D_1
#: D_1:557
msgctxt "text_id=18858 | speaker=unknown"
msgid "  Of course, their unspoken objection had no effect on Aoko in the slightest."
msgstr "　そんなふたりの無言の抗議は、もちろん、青子にはまったく通じなかった。"

#. Occurrence D_1:584:18859: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_1_0006; voice_prefix=A10; voice_category=1; scene=D_1
#: D_1:584
msgctxt "text_id=18859 | speaker=aoko"
msgid "\"We're leaving at nine-thirty.\""
msgstr "「それじゃ、<半|はん>になったら出かけるからね」"

#. Occurrence D_1:596:18860: scene=D_1
#: D_1:596
msgctxt "text_id=18860 | speaker=unknown"
msgid "  Having said all she wanted, Aoko disappeared from the room once again."
msgstr "　言いたい事だけ言って、青子は居間から姿を消した。"

#. Occurrence D_1:625:18861: scene=D_1
#: D_1:625
msgctxt "text_id=18861 | speaker=unknown"
msgid "  Alice and Soujyuro could only sit in dumbfounded silence."
msgstr "　残ったふたりは呆然とするばかりだ。"

#. Occurrence D_1:676:18862: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_1_0002; voice_prefix=A30; voice_category=3; scene=D_1
#: D_1:676
msgctxt "text_id=18862 | speaker=soujuurou"
msgid "\"Alice? Is Aozaki's house very far from here?\""
msgstr "「有珠。蒼崎の家って、遠いのか？」"

#. Occurrence D_1:682:18863: scene=D_1
#: D_1:682
msgctxt "text_id=18863 | speaker=unknown"
msgid "  He stared at the clock as he spoke. There were only ten minutes to go until half past the hour."
msgstr "　九時半まであと十分ほどの時計を見つめながら、草十郎は問いかけた。"

#. Occurrence D_1:703:18864: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_D_1_0001; voice_prefix=A40; voice_category=2; scene=D_1
#: D_1:703
msgctxt "text_id=18864 | speaker=alice"
msgid "\"It's at the edges of Misaki City. Four stops away by train, up on a small mountain."
msgstr "「場所的には三咲市の端よ。ここから電車で四駅分<下|くだ>った、小さな山の中にあるわ。"

#. Occurrence D_1:709:18865: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_D_1_0002; voice_prefix=A40; voice_category=2; scene=D_1
#: D_1:709
msgctxt "text_id=18865 | speaker=alice"
msgid "  Though it's more like a hill by your standards, I'd imagine.\""
msgstr "　……貴方の住んでいたところに比べれば丘でしょうけど」"

#. Occurrence D_1:723:18866: scene=D_1
#: D_1:723
msgctxt "text_id=18866 | speaker=unknown"
msgid "  Her expression had not changed, but her voice made it obvious she was in a poor mood. His complete obliviousness to this fact only showed how clueless he truly was."
msgstr "　表情こそ変わらないものの、有珠の声は思いっきり不機嫌そうだった。……本人がそうと気付いていないところが、いっそうのご機嫌斜めぶりを<示|しめ>している。"

#. Occurrence D_1:744:18867: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_1_0003; voice_prefix=A30; voice_category=3; scene=D_1
#: D_1:744
msgctxt "text_id=18867 | speaker=soujuurou"
msgid "\"Gotcha. So if we leave now, we won't be able to make it back till tomorrow.\""
msgstr "「そっか。今から行ったら、帰ってくるのは明日になるね」"

#. Occurrence D_1:750:18868: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_D_1_0003; voice_prefix=A40; voice_category=2; scene=D_1
#: D_1:750
msgctxt "text_id=18868 | speaker=alice"
msgid "\"Yes... If you even make it back.\""
msgstr "「……帰ってこられたらの話だけど」"

#. Occurrence D_1:770:18869: scene=D_1
#: D_1:770
msgctxt "text_id=18869 | speaker=unknown"
msgid "  Each spoke to themselves as if there were no one else in the room."
msgstr "　草十郎の独り言に、有珠も独り言で反応した。"

#. Occurrence D_1:775:18870: scene=D_1
#: D_1:775
msgctxt "text_id=18870 | speaker=unknown"
msgid "  Those about to embark on a journey always feel a sense of dread, and he was no exception."
msgstr "　これから旅立つ人間に、思いっきり不吉な予言をするように。"

#. Occurrence D_1:796:18871: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_1_0004; voice_prefix=A30; voice_category=3; scene=D_1
#: D_1:796
msgctxt "text_id=18871 | speaker=soujuurou"
msgid "\"Is Aozaki's place, like, haunted? With ghosts?\""
msgstr "「……蒼崎の家ってお化けでも出るのか？」"

#. Occurrence D_1:807:18872: scene=D_1
#: D_1:807
msgctxt "text_id=18872 | speaker=unknown"
msgid "  Alice did not say anything in response."
msgstr "　草十郎の問いに有珠は答えない。"

#. Occurrence D_1:812:18873: scene=D_1
#: D_1:812
msgctxt "text_id=18873 | speaker=unknown"
msgid "  All she did was raise her eyes from her teacup to stare wordlessly at him."
msgstr "　ティーカップから視線を上げ、無言で草十郎を眺めるだけだった。"

#. Occurrence D_1:833:18874: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_1_0005; voice_prefix=A30; voice_category=3; scene=D_1
#: D_1:833
msgctxt "text_id=18874 | speaker=soujuurou"
msgid "\"What is it, Alice?\""
msgstr "「……有珠？」"

#. Occurrence D_1:859:18875: scene=D_1
#: D_1:859
msgctxt "text_id=18875 | speaker=unknown"
msgid "  His question caused her to suddenly avert her eyes. Something seemed off about her today."
msgstr "　どこか様子のおかしい彼女に呼びかけると、有珠はふい、と顔を背けてしまった。"

#. Occurrence D_1:864:18876: scene=D_1
#: D_1:864
msgctxt "text_id=18876 | speaker=unknown"
msgid "  The minute hand on the clock was about to reach thirty."
msgstr "　……時計は、もうじき半になろうとしている。"

#. Occurrence D_1:869:18877: scene=D_1
#: D_1:869
msgctxt "text_id=18877 | speaker=unknown"
msgid "  Bothered as he was by Alice's odd behavior, Soujyuro had no choice but to stand up from the sofa and take his leave."
msgstr "　有珠の様子は気がかりだが、草十郎は仕方なくソファーから立ち上がった。"

#. Occurrence D_1:892:18878: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_1_0006; voice_prefix=A30; voice_category=3; scene=D_1
#: D_1:892
msgctxt "text_id=18878 | speaker=soujuurou"
msgid "\"Well, see you later.\""
msgstr "「それじゃ、行ってくるよ」"

#. Occurrence D_1:952:18879: scene=D_1
#: D_1:952
msgctxt "text_id=18879 | speaker=unknown"
msgid "  Soujyuro hurried through the drawing room."
msgstr "　トコトコと居間を横切る草十郎。"

#. Occurrence D_1:957:18880: scene=D_1
#: D_1:957
msgctxt "text_id=18880 | speaker=unknown"
msgid "  Alice kept staring at his back until he was gone."
msgstr "　その背中を、有珠はいつまでも見つめ続けた。"

#. Occurrence D_1:1002:18881: scene=D_1
#: D_1:1002
msgctxt "text_id=18881 | speaker=unknown"
msgid "  By the time he had changed in his room and returned to the foyer, Aoko was already waiting and ready to go."
msgstr "　草十郎が部屋に戻って外行きに着替え、ロビーまで下りた時、青子はとっくに準備を済ませて待っていた。"

#. Occurrence D_1:1008:18882: scene=D_1
#: D_1:1008
msgctxt "text_id=18882 | speaker=unknown"
msgid "  Furthermore, Alice was at her side and they were deep in conversation."
msgstr "　青子の横には有珠がいて、何やら話しこんでいる。"

#. Occurrence D_1:1013:18883: scene=D_1
#: D_1:1013
msgctxt "text_id=18883 | speaker=unknown"
msgid "  She abruptly ended their chat as soon as he descended the stairs."
msgstr "　草十郎が階段を下りきると、青子はよし、と調子をとるように会話を切った。"

#. Occurrence D_1:1046:18884: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_1_0007; voice_prefix=A10; voice_category=1; scene=D_1
#: D_1:1046
msgctxt "text_id=18884 | speaker=aoko"
msgid "\"All right, let's head out. Keep an eye on things while we're gone, okay, Alice?\""
msgstr "「それじゃ行きましょうか。有珠、留守番よろしくね」"

#. Occurrence D_1:1068:18885: scene=D_1
#: D_1:1068
msgctxt "text_id=18885 | speaker=unknown"
msgid "  She responded with a simple nod."
msgstr "　有珠は頷きだけで応えた。"

#. Occurrence D_1:1075:18886: scene=D_1
#: D_1:1075
msgctxt "text_id=18886 | speaker=unknown"
msgid "  There was determination in Aoko's step as she strode to the door."
msgstr "　青子はつかつかと玄関へ歩いていく。"

#. Occurrence D_1:1080:18887: scene=D_1
#: D_1:1080
msgctxt "text_id=18887 | speaker=unknown"
msgid "  Soujyuro made to follow her as he donned his coat in the foyer."
msgstr "　草十郎はロビーでコートを羽織りつつ、青子の後を追うように歩きだした。"

#. Occurrence D_1:1116:18888: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_1_0008; voice_prefix=A10; voice_category=1; scene=D_1
#: D_1:1116
msgctxt "text_id=18888 | speaker=aoko"
msgid "\"Hurry it up!\""
msgstr "「ほら、ぐずぐずしないっ！」"

#. Occurrence D_1:1127:18889: scene=D_1
#: D_1:1127
msgctxt "text_id=18889 | speaker=unknown"
msgid "  Her words made him pick up his pace, but he stopped suddenly, as if he had remembered something."
msgstr "　青子の呼びかけに足を速める草十郎だったが、何を思ったか唐突に立ち止まった。"

#. Occurrence D_1:1132:18890: scene=D_1
#: D_1:1132
msgctxt "text_id=18890 | speaker=unknown"
msgid "  He looked back at Alice as if to say that he had left the heater on in his room, or some other important matter."
msgstr "　そういえば部屋のストーブがつけっぱなしだったな、なんて素振りで、ひとり<佇|たたず>む有珠へと振り返る。"

#. Occurrence D_1:1169:18891: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_1_9000; voice_prefix=A30; voice_category=3; scene=D_1
#: D_1:1169
msgctxt "text_id=18891 | speaker=soujuurou"
msgid "\"Bye. I'll be back as soon as I can, but try to stay awake this time while waiting for me, okay?\""
msgstr "「それじゃ行ってくる。できるだけ早めに帰ってくるから、寝ないで待ってるんだぞ有珠」"

#. Occurrence D_1:1219:18892: scene=D_1
#: D_1:1219
msgctxt "text_id=18892 | speaker=unknown"
msgid "  Alice blinked in shock at his unexpected request."
msgstr "　突然の言いつけに、有珠は不意をつかれたように<瞬|またた>きをした。"

#. Occurrence D_1:1224:18893: scene=D_1
#: D_1:1224
msgctxt "text_id=18893 | speaker=unknown"
msgid "  Aoko looked on with arms folded as"
msgstr "　草十郎は返事を待っていて、"

#. Occurrence D_1:1229:18894: scene=D_1
#: D_1:1229
msgctxt "text_id=18894 | speaker=unknown"
msgid "  Soujyuro stood waiting for a response."
msgstr "　青子は腕を組んでふたりのやりとりを眺めている。"

#. Occurrence D_1:1250:18895: scene=D_1
#: D_1:1250
msgctxt "text_id=18895 | speaker=unknown"
msgid "  Bewildered, Alice finally returned to the drawing room without uttering a single word."
msgstr "　……それに少し戸惑ってから、有珠は無言で居間へと行ってしまった。"

#. Occurrence D_1:1270:18896: scene=D_1
#: D_1:1270
msgctxt "text_id=18896 | speaker=unknown"
msgid "  Her only response had been the very smallest of nods."
msgstr "　どうでもいい草十郎の言葉に、こくんと<控|ひか>え目にうなずいてから。"

#. Occurrence D_2:57:18897: scene=D_2
#: D_2:57
msgctxt "text_id=18897 | speaker=unknown"
msgid "  They were headed for Akikoshiro train station."
msgstr "　<秋古城|あきこしろ>というのが、その駅の名前だった。"

#. Occurrence D_2:81:18898: scene=D_2
#: D_2:81
msgctxt "text_id=18898 | speaker=unknown"
msgid "  The night had grown late; it was nearly eleven o'clock."
msgstr "　夜はふけて十一時より少し前。"

#. Occurrence D_2:86:18899: scene=D_2
#: D_2:86
msgctxt "text_id=18899 | speaker=unknown"
msgid "  A train full of tourists went by in the opposite direction before the two finally arrived at the tiny station."
msgstr "　参拝客の一団を乗せた<上|のぼ>りの列車とは逆行して、ふたりはその小さな駅に着いた。"

#. Occurrence D_2:106:18900: scene=D_2
#: D_2:106
msgctxt "text_id=18900 | speaker=unknown"
msgid "  The surrounding area was incredibly dark and quiet."
msgstr "　周囲はあまりにも暗く、静かだ。"

#. Occurrence D_2:111:18901: scene=D_2
#: D_2:111
msgctxt "text_id=18901 | speaker=unknown"
msgid "  In fact, it felt less like a station and more like a small boat dock."
msgstr "　駅というより深夜の波止場を思わせる。"

#. Occurrence D_2:131:18902: scene=D_2
#: D_2:131
msgctxt "text_id=18902 | speaker=unknown"
msgid "  Soujyuro had a hard time imagining that many people came here, even during the day."
msgstr "　平時でさえ、この駅で降りる人は少ないのだろう。"

#. Occurrence D_2:136:18903: scene=D_2
#: D_2:136
msgctxt "text_id=18903 | speaker=unknown"
msgid "  It had only the absolute bare minimum necessary to greet the odd visitor."
msgstr "　時折やってくる列車を見送るだけの停留所。"

#. Occurrence D_2:141:18904: scene=D_2
#: D_2:141
msgctxt "text_id=18904 | speaker=unknown"
msgid "  There were no convenience stores in sight, only fields and the streetlights that dotted the road."
msgstr "　駅のまわりにはコンビニエンスストアの一軒もなく、あるのは一面の畑と、道に立てられた街灯だけ。"

#. Occurrence D_2:161:18905: scene=D_2
#: D_2:161
msgctxt "text_id=18905 | speaker=unknown"
msgid "  Aoko placed her ticket in front of the attendant who sat sleeping in his chair, and skimmed the train schedule."
msgstr "　駅員室で座ったまま眠る駅員の前にキップを置いて、青子は時刻表を確認する。"

#. Occurrence D_2:166:18906: scene=D_2
#: D_2:166
msgctxt "text_id=18906 | speaker=unknown"
msgid "  The last and only train back departed just after half-past midnight."
msgstr "　零時半過ぎに、もう一本だけ帰りの電車がある。"

#. Occurrence D_2:172:18907: scene=D_2
#: D_2:172
msgctxt "text_id=18907 | speaker=unknown"
msgid "  Having confirmed her options, she headed hastily out of the station."
msgstr "　最終電車を確認して、青子は急ぎ足で駅を後にした。"

#. Occurrence D_2:220:18908: scene=D_2
#: D_2:220
msgctxt "text_id=18908 | speaker=unknown"
msgid "  The elderly station attendant was all alone..."
msgstr "　……年老いた駅員はひとりきりだった。"

#. Occurrence D_2:225:18909: scene=D_2
#: D_2:225
msgctxt "text_id=18909 | speaker=unknown"
msgid "  He had dozed off with both the heater and television still turned on."
msgstr "　彼はストーブとテレビをつけたまま、こくこくと船を<漕|こ>いでいる。"

#. Occurrence D_2:245:18910: scene=D_2
#: D_2:245
msgctxt "text_id=18910 | speaker=unknown"
msgid "  As he slept, his face looked completely content."
msgstr "　その寝顔は満ち足りている。"

#. Occurrence D_2:250:18911: scene=D_2
#: D_2:250
msgctxt "text_id=18911 | speaker=unknown"
msgid "  The night felt vast in its darkness."
msgstr "　あまりにも広大な夜の闇。"

#. Occurrence D_2:255:18912: scene=D_2
#: D_2:255
msgctxt "text_id=18912 | speaker=unknown"
msgid "  The small train station had been rendered obsolete now that cars were commonplace."
msgstr "　自動車の供給と共に<廃|すた>れてしまった小さな駅。"

#. Occurrence D_2:283:18913: scene=D_2
#: D_2:283
msgctxt "text_id=18913 | speaker=unknown"
msgid "  It was like a lone star shining in the night sky."
msgstr "　暗い宇宙の中でただひとつ光を放つ、孤独な星のようだ。"

#. Occurrence D_2:289:18914: scene=D_2
#: D_2:289
msgctxt "text_id=18914 | speaker=unknown"
msgid "  Soujyuro thanked the attendant for his service before stepping out into the darkness. The man must have looked after the station for decades at this point, and would likely continue until the day he died."
msgstr "　それを何十年と守り、これからも人生の終わりまで付きそう事を良しとした老人に一礼して、草十郎も暗い夜に足を向けた。"

#. Occurrence D_2:347:18915: scene=D_2
#: D_2:347
msgctxt "text_id=18915 | speaker=unknown"
msgid "  Outside the station, there was little in the way of human development. It could scarcely be called a village."
msgstr "　駅から出ると、そこは村というよりは里だった。"

#. Occurrence D_2:352:18916: scene=D_2
#: D_2:352
msgctxt "text_id=18916 | speaker=unknown"
msgid "  There was not even an area out front for cars and buses to drop people off."
msgstr "　駅前には<広場|ロータリー>すらない。"

#. Occurrence D_2:357:18917: scene=D_2
#: D_2:357
msgctxt "text_id=18917 | speaker=unknown"
msgid "  Their eyes were met only with a panorama of flat fields interlaced with a lattice of footpaths."
msgstr "　パノラマに広がる平地は一面の畑で、網の目のように<畦道|あぜみち>がある。"

#. Occurrence D_2:362:18918: scene=D_2
#: D_2:362
msgctxt "text_id=18918 | speaker=unknown"
msgid "  Though surely a sea of beautiful green in the summertime, during winter it was more like a wasteland."
msgstr "　夏であれば風紋を走らせる小麦畑も、冬の夜では荒地にしか見えない。"

#. Occurrence D_2:367:18919: scene=D_2
#: D_2:367
msgctxt "text_id=18919 | speaker=unknown"
msgid "  However, electric lights that felt strangely out of place illuminated one side of the dark vista."
msgstr "　ただ一面の闇の中、電灯だけが場違いに<灯|とも>っている。"

#. Occurrence D_2:395:18920: scene=D_2
#: D_2:395
msgctxt "text_id=18920 | speaker=unknown"
msgid "  The cold only grew harsher as the night wore on."
msgstr "　寒さは夜になってより厳しさを増していた。"

#. Occurrence D_2:400:18921: scene=D_2
#: D_2:400
msgctxt "text_id=18921 | speaker=unknown"
msgid "  It relentlessly snatched all sensation from the fingertips."
msgstr "　冷気は容赦なく、指先から<感覚|ねつ>を奪っていく。"

#. Occurrence D_2:422:18922: scene=D_2
#: D_2:422
msgctxt "text_id=18922 | speaker=unknown"
msgid "  Aoko thus kept her hands in her pockets as she strode through the paths among the fields."
msgstr "　両手をポケットにいれて、青子は畦道を歩きだした。"

#. Occurrence D_2:427:18923: scene=D_2
#: D_2:427
msgctxt "text_id=18923 | speaker=unknown"
msgid "  She could feel the ground below through her shoes."
msgstr "　<靴|ブーツ>には土の感触。"

#. Occurrence D_2:432:18924: scene=D_2
#: D_2:432
msgctxt "text_id=18924 | speaker=unknown"
msgid "  Its softness was unlike that of the city, and for her it brought back countless memories."
msgstr "　町とは違う柔らかさに、青子は懐かしさを感じている。"

#. Occurrence D_2:437:18925: scene=D_2
#: D_2:437
msgctxt "text_id=18925 | speaker=unknown"
msgid "  She had walked this path every day in middle school, after all."
msgstr "　彼女にとっては、中学生時代まで毎日のように通った道だ。"

#. Occurrence D_2:472:18926: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_2_0000; voice_prefix=A10; voice_category=1; scene=D_2
#: D_2:472
msgctxt "text_id=18926 | speaker=aoko"
msgid "\"See the lights of that house in the middle of that mountain?"
msgstr "「あの山の真ん中あたり、家の明かりが見えるでしょ？"

#. Occurrence D_2:472:18927: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_2_0000; voice_prefix=A10; voice_category=1; scene=D_2
#: D_2:472
msgctxt "text_id=18927 | speaker=aoko"
msgid "  That's my place.\""
msgstr "　アレがうち」"

#. Occurrence D_2:478:18928: scene=D_2
#: D_2:478
msgctxt "text_id=18928 | speaker=unknown"
msgid "  She pointed out a mountain that rose up before them with her finger."
msgstr "　もりあがった<山|やみ>を指さす青子。"

#. Occurrence D_2:483:18929: scene=D_2
#: D_2:483
msgctxt "text_id=18929 | speaker=unknown"
msgid "  The journey looked like it would take about forty minutes on foot."
msgstr "　ここからだと四十分も歩けば辿り着けるだろう。"

#. Occurrence D_2:503:18930: scene=D_2
#: D_2:503
msgctxt "text_id=18930 | speaker=unknown"
msgid "  For now, they remained among the rice fields, though their journey would continue beyond them."
msgstr "　道は長く、しばらくは畦道が続いている。"

#. Occurrence D_2:508:18931: scene=D_2
#: D_2:508
msgctxt "text_id=18931 | speaker=unknown"
msgid "  Aoko followed the path bathed in light without looking back."
msgstr "　青子は振り返らず、明かりに照らされた道を歩いていく。"

#. Occurrence D_2:514:18932: scene=D_2
#: D_2:514
msgctxt "text_id=18932 | speaker=unknown"
msgid "  The path seemed to hang before them like a pier leading out into the darkness of the ocean."
msgstr "　浮かび上がった道は、暗い海にかけられた<桟橋|さんばし>のように見えた。"

#. Occurrence D_2:569:18933: scene=D_2
#: D_2:569
msgctxt "text_id=18933 | speaker=unknown"
msgid "  The closer they got to the mountain, the darker it became."
msgstr "　山に近づくにつれ、暗闇は深くなる。"

#. Occurrence D_2:574:18934: scene=D_2
#: D_2:574
msgctxt "text_id=18934 | speaker=unknown"
msgid "  All signs of the hustle and bustle of human life were absent."
msgstr "　ここでは人の<喧|お><噪|と>は忘れ去られている。"

#. Occurrence D_2:579:18935: scene=D_2
#: D_2:579
msgctxt "text_id=18935 | speaker=unknown"
msgid "  The dark stillness made the moon overhead seem dazzling."
msgstr "　頭上の月の光は眩しいほど。"

#. Occurrence D_2:584:18936: scene=D_2
#: D_2:584
msgctxt "text_id=18936 | speaker=unknown"
msgid "  Its light transformed the mountain path from blackness into mere shadow."
msgstr "　真っ黒い山道は、その光に照らされて<闇色|やみいろ>から<影色|かげいろ>になっている。"

#. Occurrence D_2:589:18937: scene=D_2
#: D_2:589
msgctxt "text_id=18937 | speaker=unknown"
msgid "  Though dark, their surroundings were not totally indiscernible."
msgstr "　周りは暗いけれど、世界はたしかに見渡せた。"

#. Occurrence D_2:636:18938: scene=D_2
#: D_2:636
msgctxt "text_id=18938 | speaker=unknown"
msgid "  The seemingly unending path stretched on and on."
msgstr "　ゴールの見えない道は<延々|えんえん>と続いている。"

#. Occurrence D_2:641:18939: scene=D_2
#: D_2:641
msgctxt "text_id=18939 | speaker=unknown"
msgid "  Soujyuro, doing his best to match Aoko's pace, stole a momentary glance at the profile of her face."
msgstr "　青子のペースに合わせて歩きながら、ふと草十郎は彼女の横顔を盗み見た。"

#. Occurrence D_2:661:18940: scene=D_2
#: D_2:661
msgctxt "text_id=18940 | speaker=unknown"
msgid "  Did she not feel frightened in this quiet darkness, even with the moon to light the way?"
msgstr "　月明かりが鮮やかとは言え、ここまで静かな夜道に青子は不安を感じないのだろうか。"

#. Occurrence D_2:666:18941: scene=D_2
#: D_2:666
msgctxt "text_id=18941 | speaker=unknown"
msgid "  Her expression showed no outward signs of discomfort as she strode on in silence."
msgstr "　青子は無言のまま、いたって普通の顔つきで歩いている。"

#. Occurrence D_2:696:18942: scene=D_2
#: D_2:696
msgctxt "text_id=18942 | speaker=unknown"
msgid "  In fact, this was how she always looked when she was trying to act tough."
msgstr "　こんな顔の時は、決まって強がっている時だ。"

#. Occurrence D_2:701:18943: scene=D_2
#: D_2:701
msgctxt "text_id=18943 | speaker=unknown"
msgid "  He had only had a month's experience with her, but that much he knew."
msgstr "　一ヶ月程度の未熟な経験からではあるが、草十郎は確かにそう感じ取った。"

#. Occurrence D_2:706:18944: scene=D_2
#: D_2:706
msgctxt "text_id=18944 | speaker=unknown"
msgid "  There was obviously something on her mind she couldn't ignore, no matter how small it might be."
msgstr "　何か、些細だけれど無視できない問題を、彼女は飲みこもうとしているらしい。"

#. Occurrence D_2:747:18945: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_2_0000; voice_prefix=A30; voice_category=3; scene=D_2
#: D_2:747
msgctxt "text_id=18945 | speaker=soujuurou"
msgid "\"Are you scared to be out here in the dark?\""
msgstr "「蒼崎でもこういうところは恐いのかい？」"

#. Occurrence D_2:753:18946: scene=D_2
#: D_2:753
msgctxt "text_id=18946 | speaker=unknown"
msgid "  She responded to his tentative question with a surprising nod."
msgstr "　試しに訊いてみると、青子は意外にも頷いた。"

#. Occurrence D_2:800:18947: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_2_0001; voice_prefix=A10; voice_category=1; scene=D_2
#: D_2:800
msgctxt "text_id=18947 | speaker=aoko"
msgid "\"Who wouldn't be scared walking on these paths at night?"
msgstr "「こんな夜道を恐がらない人なんて、普通いないでしょう。"

#. Occurrence D_2:806:18948: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_2_0002; voice_prefix=A10; voice_category=1; scene=D_2
#: D_2:806
msgctxt "text_id=18948 | speaker=aoko"
msgid "  All you can do is endure and ignore it. If you can't do either, then you really shouldn't be strolling around in the middle of the night.\""
msgstr "　我慢できるか無視できるかの二つだけよ。そのどちらも出来ない人は、夜に出歩かないわ」"

#. Occurrence D_2:812:18949: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_2_0001; voice_prefix=A30; voice_category=3; scene=D_2
#: D_2:812
msgctxt "text_id=18949 | speaker=soujuurou"
msgid "\"I see. So why'd you bring me?\""
msgstr "「なるほど。それじゃ、どうして自分を連れてきたんだ」"

#. Occurrence D_2:858:18950: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_2_0003; voice_prefix=A10; voice_category=1; scene=D_2
#: D_2:858
msgctxt "text_id=18950 | speaker=aoko"
msgid "\"Didn't you hear what I said earlier? All this walking in the middle of nowhere is a waste of time. I wanted someone to talk to so it'd go by faster.\""
msgstr "「言わなかった？　こんな何もない道をひとりで歩くのは時間の無駄でしょ。退屈しのぎに話し相手がほしかったの」"

#. Occurrence D_2:864:18951: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_2_0002; voice_prefix=A30; voice_category=3; scene=D_2
#: D_2:864
msgctxt "text_id=18951 | speaker=soujuurou"
msgid "\"Yeah, I guess you did say something like that.\""
msgstr "「……そういえば、そんな事を言ってたな」"

#. Occurrence D_2:933:18952: scene=D_2
#: D_2:933
msgctxt "text_id=18952 | speaker=unknown"
msgid "  Soujyuro fell into silence."
msgstr "　それきり草十郎は黙りこむ。"

#. Occurrence D_2:938:18953: scene=D_2
#: D_2:938
msgctxt "text_id=18953 | speaker=unknown"
msgid "  He was not bothered by what she said; rather, he was desperately searching for something to say in response."
msgstr "　別に青子の言葉に落ちこんだ訳でもなく、必死に何かを探しているような素振りだ。"

#. Occurrence D_2:1017:18954: scene=D_2
#: D_2:1017
msgctxt "text_id=18954 | speaker=unknown"
msgid "  Their path through the night continued onward."
msgstr "　夜の道は続いていく。"

#. Occurrence D_2:1023:18955: scene=D_2
#: D_2:1023
msgctxt "text_id=18955 | speaker=unknown"
msgid "  Only the sound of their footsteps could be heard. Eventually, Aoko was unable to endure the silence any longer despite her best efforts."
msgstr "　ふたりの足音だけが響く中、青子は彼女なりに耐えてみたけれど、それも限界とばかりに口を開けた。"

#. Occurrence D_2:1047:18956: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_2_0004; voice_prefix=A10; voice_category=1; scene=D_2
#: D_2:1047
msgctxt "text_id=18956 | speaker=aoko"
msgid "\"Talk about something, Soujyuro.\""
msgstr "「草十郎、退屈しのぎに何か話してよ」"

#. Occurrence D_2:1053:18957: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_2_0003; voice_prefix=A30; voice_category=3; scene=D_2
#: D_2:1053
msgctxt "text_id=18957 | speaker=soujuurou"
msgid "\"But I don't have anything to talk about.\""
msgstr "「……まいったな。話すような事はないんだけど」"

#. Occurrence D_2:1059:18958: scene=D_2
#: D_2:1059
msgctxt "text_id=18958 | speaker=unknown"
msgid "  He felt clueless and ashamed."
msgstr "　面目ない、と頭を抱える。"

#. Occurrence D_2:1064:18959: scene=D_2
#: D_2:1064
msgctxt "text_id=18959 | speaker=unknown"
msgid "  He had been searching unsuccessfully for a topic throughout their awkward silence."
msgstr "　どうも、さっき黙りこんだのは<話|そ><題|れ>を探しての事らしい。"

#. Occurrence D_2:1069:18960: scene=D_2
#: D_2:1069
msgctxt "text_id=18960 | speaker=unknown"
msgid "  Shocked though she was, Aoko let out a gentle sigh."
msgstr "　青子は呆れながらも温かなため息をひとつ。"

#. Occurrence D_2:1074:18961: scene=D_2
#: D_2:1074
msgctxt "text_id=18961 | speaker=unknown"
msgid "  At least for a moment, his simple earnestness was enough to make her forget all about her troubles."
msgstr "　とことん律儀な草十郎の人柄が、彼女を悩ませていたモノを少しだけ<剥|は>がしていった。"

#. Occurrence D_2:1103:18962: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_2_0005; voice_prefix=A10; voice_category=1; scene=D_2
#: D_2:1103
msgctxt "text_id=18962 | speaker=aoko"
msgid "\"Don't be stupid. Make something up if you have to. It doesn't even have to be interesting. Anything will do.\""
msgstr "「莫迦ね、嘘でもなんでもいいから、とにかく話をすればいいの。別に面白い話なんて期待してないから」"

#. Occurrence D_2:1117:18963: scene=D_2
#: D_2:1117
msgctxt "text_id=18963 | speaker=unknown"
msgid "  Her blunt retort was not entirely honest."
msgstr "　青子は素っ気ない態度で、あんまりな事を言う。"

#. Occurrence D_2:1122:18964: scene=D_2
#: D_2:1122
msgctxt "text_id=18964 | speaker=unknown"
msgid "  She would surely scold him if he dared lie to her."
msgstr "　そもそも嘘なんて言ったら、それこそお仕置きタイムだ。"

#. Occurrence D_2:1127:18965: scene=D_2
#: D_2:1127
msgctxt "text_id=18965 | speaker=unknown"
msgid "  Soujyuro said as much, reminding her of how she had claimed to hate lies."
msgstr "　前に嘘は嫌い、といったのは蒼崎本人じゃないか、と草十郎は内心でごちてみた。"

#. Occurrence D_2:1132:18966: scene=D_2
#: D_2:1132
msgctxt "text_id=18966 | speaker=unknown"
msgid "  Naturally, she did not bother responding."
msgstr "　当然、青子からの返事はない。"

#. Occurrence D_2:1186:18967: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_2_0004; voice_prefix=A30; voice_category=3; scene=D_2
#: D_2:1186
msgctxt "text_id=18967 | speaker=soujuurou"
msgid "\"Damned either way, I guess. I don't have anything else to talk about, but there is something I wanted to ask."
msgstr "「……仕方ない。話はないけど、聞きたい事ならあった。"

#. Occurrence D_2:1192:18968: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_2_0005; voice_prefix=A30; voice_category=3; scene=D_2
#: D_2:1192
msgctxt "text_id=18968 | speaker=soujuurou"
msgid "  You said anything goes, right?\""
msgstr "　何でもいいならそれもいいだろう？」"

#. Occurrence D_2:1252:18969: scene=D_2
#: D_2:1252
msgctxt "text_id=18969 | speaker=unknown"
msgid "  A slight scowl crossed her face at his suggestion."
msgstr "　草十郎の提案に、青子はかすかに眉を寄せた。"

#. Occurrence D_2:1257:18970: scene=D_2
#: D_2:1257
msgctxt "text_id=18970 | speaker=unknown"
msgid "  But it lasted only a moment before she returned to her previous calm state."
msgstr "　けれどそれも一瞬で、彼女はすぐに元の、落ち着いた<表情|かお>に戻る。"

#. Occurrence D_2:1317:18971: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_2_0006; voice_prefix=A10; voice_category=1; scene=D_2
#: D_2:1317
msgctxt "text_id=18971 | speaker=aoko"
msgid "\"All right, go ahead. I'll probably forget as soon as we're done, anyway.\""
msgstr "「……ま、それもいいか。どうせ、もうすぐ忘れるんだから」"

#. Occurrence D_2:1323:18972: scene=D_2
#: D_2:1323
msgctxt "text_id=18972 | speaker=unknown"
msgid "  She muttered her reply without making eye contact."
msgstr "　草十郎から目を逸らして、呟くように青子は答えた。"

#. Occurrence D_2:1328:18973: scene=D_2
#: D_2:1328
msgctxt "text_id=18973 | speaker=unknown"
msgid "  Their destination in the mountains remained hidden from them, revealing not even a hint of its form."
msgstr "　山中の目的地は、まだ影も形も見えてこない。"

#. Occurrence D_3:55:18974: scene=D_3
#: D_3:55
msgctxt "text_id=18974 | speaker=unknown"
msgid "  It had bothered him ever since that night."
msgstr "　あれからずっと<抱|かか>えていた疑問。"

#. Occurrence D_3:60:18975: scene=D_3
#: D_3:60
msgctxt "text_id=18975 | speaker=unknown"
msgid "  What was the truth behind it all, and how would the two sisters' drama unfold?"
msgstr "　今回の事件の<顛末|てんまつ>と、姉妹間の決着。"

#. Occurrence D_3:65:18976: scene=D_3
#: D_3:65
msgctxt "text_id=18976 | speaker=unknown"
msgid "  Soujyuro decided to press Aoko for details."
msgstr "　そういった余分な話を、草十郎は口にする。"

#. Occurrence D_3:86:18977: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_3_0000; voice_prefix=A30; voice_category=3; scene=D_3
#: D_3:86
msgctxt "text_id=18977 | speaker=soujuurou"
msgid "\"So what was it that Miss Touko wanted to accomplish?\""
msgstr "「それで、橙子さんは何がしたかったんだ？」"

#. Occurrence D_3:92:18978: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0000; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:92
msgctxt "text_id=18978 | speaker=aoko"
msgid "\"I thought I told you. She wanted to get revenge against me, and then there's the whole coming in contact with the Root thing."
msgstr "「あれ、言わなかった？　<蒼崎|わたし>への復讐と、根源に接触する事だって。"

#. Occurrence D_3:99:18979: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0001; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:99
msgctxt "text_id=18979 | speaker=aoko"
msgid "We already talked about the Swirl of the Root, remember?\""
msgstr "根源の渦については前に少しだけ話したでしょ」"

#. Occurrence D_3:105:18980: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_3_0001; voice_prefix=A30; voice_category=3; scene=D_3
#: D_3:105
msgctxt "text_id=18980 | speaker=soujuurou"
msgid "\"It's like... the source of magecraft, right?\""
msgstr "「……たしか、魔術の源だっけ」"

#. Occurrence D_3:152:18981: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0002; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:152
msgctxt "text_id=18981 | speaker=aoko"
msgid "\"Right. And also its end goal."
msgstr "「そう。そして最終目的でもあるわ。"

#. Occurrence D_3:163:18982: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0003; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:163
msgctxt "text_id=18982 | speaker=aoko"
msgid "  The place where all knowledge is recorded, where all matters are settled."
msgstr "　根源の渦っていうのは、全ての<叡知|えいち>が記録された位置、全ての事柄が決定された場所。"

#. Occurrence D_3:169:18983: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0004; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:169
msgctxt "text_id=18983 | speaker=aoko"
msgid "  To see, touch, and understand it makes even the impossible possible. It has gone by many names over the years, but you could say it's where God lives.\""
msgstr "　そこを見て、触れて、理解できれば不可能なんて言葉すら作り替えられる。伝承によって呼び名は様々だけど、ようするに神さまのいる位置なんでしょうね」"

#. Occurrence D_3:216:18984: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_3_0002; voice_prefix=A30; voice_category=3; scene=D_3
#: D_3:216
msgctxt "text_id=18984 | speaker=soujuurou"
msgid "\"God? So there's just one, then? Not a bunch, like in Shinto?\""
msgstr "「神さまっていうのは、<八百万|やおよろず>的なものじゃなく？」"

#. Occurrence D_3:256:18985: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0005; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:256
msgctxt "text_id=18985 | speaker=aoko"
msgid "\"There you go again with your annoying questions."
msgstr "「……たまにそういうコト言いだすから厄介よねアンタは。"

#. Occurrence D_3:262:18986: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0006; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:262
msgctxt "text_id=18986 | speaker=aoko"
msgid "  There are gods in everything around us, but there's also one big underlying force that existed way before all that.\""
msgstr "　そりゃ万象に宿る神さまもいるでしょうけど、これはその前、そういうのを決めた大前提みたいなものよ」"

#. Occurrence D_3:288:18987: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0007; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:288
msgctxt "text_id=18987 | speaker=aoko"
msgid "\"Who knows why an entrance to the Root is located in Misaki, but my grandfather discovered it and was able to create a new kind of Magic."
msgstr "「そんなものの入り口がどうして三咲にあったのかは知らないけど、祖父はそれを発見して、新しい魔法を作り出した。"

#. Occurrence D_3:294:18988: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0008; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:294
msgctxt "text_id=18988 | speaker=aoko"
msgid "  But then he closed the way to the Root."
msgstr "　でも、その後に根源への<路|みち>を閉ざしちゃったのよ。"

#. Occurrence D_3:301:18989: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0009; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:301
msgctxt "text_id=18989 | speaker=aoko"
msgid "He said that if this path to God enabled us to create Magic, then no one should be allowed to go there.\""
msgstr "魔法さえ成立したのなら、神さまへの<路|みち>は消えるべきだって」"

#. Occurrence D_3:349:18990: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0010; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:349
msgctxt "text_id=18990 | speaker=aoko"
msgid "\"He has no intention of opening it again as long as we're alive, which made Touko crazy mad."
msgstr "「……たぶん、私たちが生きているかぎり開放する気はなくて、橙子はそれが腹立たしかったんだと思う。"

#. Occurrence D_3:355:18991: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0011; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:355
msgctxt "text_id=18991 | speaker=aoko"
msgid "  She said that the path is meant to be explored, even if we aren't strong enough to handle what we find. And that you shouldn't be studying magecraft in the first place if you're afraid of getting killed.\""
msgstr "　たとえ力不足で取り込まれても、道があるのなら試すべきだ。自己の消滅を恐れるぐらいなら、そもそも魔術なんて学ばなかった―――ってね」"

#. Occurrence D_3:381:18992: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0012; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:381
msgctxt "text_id=18992 | speaker=aoko"
msgid "\"But my grandfather didn't appreciate her ambition."
msgstr "「でも祖父は<礎|いしずえ>になろうとする意志さえ認めなかった。"

#. Occurrence D_3:387:18993: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0013; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:387
msgctxt "text_id=18993 | speaker=aoko"
msgid "  He refused to allow anyone to investigate the Root until a stronger heir was born. He's willing to pass on True Magic, just not the way to reach the Root."
msgstr "　もっと強力な後継ぎが生まれるまで、根源の解析は許可しない。後継ぎに魔法は<譲|ゆず>るけれど、根源への路だけは閉ざしていたのよ。"

#. Occurrence D_3:393:18994: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0014; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:393
msgctxt "text_id=18994 | speaker=aoko"
msgid "  I understand where Touko's coming from, but I agree with my grandfather."
msgstr "　……橙子の気持ちも分かるけど、私は祖父に賛成だわ。"

#. Occurrence D_3:399:18995: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0015; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:399
msgctxt "text_id=18995 | speaker=aoko"
msgid "  I don't care about the Root, and anyway, to this day there haven't been any survivors. There's not even proof that it's really the seat of the gods.\""
msgstr "　根源なんてものに興味はないし、第一、今まで一人も生還者がいないんだもの。それが本当に神々の座なのか保証もないし」"

#. Occurrence D_3:448:18996: scene=D_3
#: D_3:448
msgctxt "text_id=18996 | speaker=unknown"
msgid "  Her mood gradually soured as she spoke, and towards the end, it sounded more like a list of complaints."
msgstr "　話しているうちに機嫌を損ねたのか、後半はなかば文句になっていた。"

#. Occurrence D_3:453:18997: scene=D_3
#: D_3:453
msgctxt "text_id=18997 | speaker=unknown"
msgid "  Despite her words, however, part of Aoko was unable to agree completely with her grandfather's decision."
msgstr "　なんだかんだ言って、青子本人も祖父には賛同しきれない部分があるらしい。"

#. Occurrence D_3:458:18998: scene=D_3
#: D_3:458
msgctxt "text_id=18998 | speaker=unknown"
msgid "  Soujyuro took note and followed up with a question about something he found strange."
msgstr "　それを気にしながら、草十郎は今の話のおかしな部分について訊き返す。"

#. Occurrence D_3:503:18999: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_3_0003; voice_prefix=A30; voice_category=3; scene=D_3
#: D_3:503
msgctxt "text_id=18999 | speaker=soujuurou"
msgid "\"What did you mean about how there haven't been any survivors?\""
msgstr "「蒼崎。一人も生還者がいないって、どういう事だ？」"

#. Occurrence D_3:509:19000: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0016; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:509
msgctxt "text_id=19000 | speaker=aoko"
msgid "\"I meant that no one's ever come in contact with the Root and returned to talk about it. Not a single person in the entire world."
msgstr "「根源に触れて、帰ってきた者は一人もいないの。世界規模でね。"

#. Occurrence D_3:515:19001: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0017; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:515
msgctxt "text_id=19001 | speaker=aoko"
msgid "  Coming in contact with it means instant death. The soul of a mere human simply 'returns to the source,' so to speak. In other words, it gets sucked into the Root.\""
msgstr "　触れれば即消滅。人間程度の魂だと触れた瞬間に<元|・><に|・><戻|・><る|・>とか、根源に取りこまれるとか」"

#. Occurrence D_3:536:19002: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0018; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:536
msgctxt "text_id=19002 | speaker=aoko"
msgid "\"That's why not even the greatest mages in history dared to touch it. Just coming close is enough to send them frantically trying to stabilize their magecraft.\""
msgstr "「なんで、どんなに歴史に名を残した魔術師でも、あれにだけは触れていないわ。せいぜい間近にして、大急ぎで自分の魔術を安定させた程度だもの」"

#. Occurrence D_3:542:19003: scene=D_3
#: D_3:542
msgctxt "text_id=19003 | speaker=unknown"
msgid "  Soujyuro furrowed his brow at the oddness of it all."
msgstr "　そこがおかしい、と草十郎は眉をひそめる。"

#. Occurrence D_3:563:19004: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_3_0004; voice_prefix=A30; voice_category=3; scene=D_3
#: D_3:563
msgctxt "text_id=19004 | speaker=soujuurou"
msgid "\"Then how does anyone know so much about this place?\""
msgstr "「それじゃあ、どうしてそこがそういう場所だって分かるんだ」"

#. Occurrence D_3:569:19005: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0019; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:569
msgctxt "text_id=19005 | speaker=aoko"
msgid "\"Because there is one person who went and made it back.\""
msgstr "「そりゃあ、中に入って伝えた人がいたからでしょう」"

#. Occurrence D_3:604:19006: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_3_0005; voice_prefix=A30; voice_category=3; scene=D_3
#: D_3:604
msgctxt "text_id=19006 | speaker=soujuurou"
msgid "\"But you said there were no survivors...\""
msgstr "「でも生還者はいないって」"

#. Occurrence D_3:644:19007: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0020; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:644
msgctxt "text_id=19007 | speaker=aoko"
msgid "\"Yeah, because everyone who's gone in turns into God, too.\""
msgstr "「だから。そういう人たちは、中で神さまにでもなっちゃったんじゃない？」"

#. Occurrence D_3:649:19008: scene=D_3
#: D_3:649
msgctxt "text_id=19008 | speaker=unknown"
msgid "  She spoke very matter-of-factly."
msgstr "　実にきっぱりと彼女は言った。"

#. Occurrence D_3:654:19009: scene=D_3
#: D_3:654
msgctxt "text_id=19009 | speaker=unknown"
msgid "  As if it was only a minor detail about something that had happened the other day."
msgstr "　何でもない話のように、昨日の話をするように。"

#. Occurrence D_3:680:19010: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0021; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:680
msgctxt "text_id=19010 | speaker=aoko"
msgid "\"So why would they even bother coming back to our world? Or maybe they can't, who knows."
msgstr "「そうなればこっちに帰ってくる必要はないでしょうし、もしかすると、単に帰って来られないだけかもね。"

#. Occurrence D_3:691:19011: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0022; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:691
msgctxt "text_id=19011 | speaker=aoko"
msgid "  Being God is probably totally different than what we imagine. I doubt it's very fun.\""
msgstr "　……ま、神さまって位置づけが私たちが思っているようなものとは思えないから、あまり幸福そうには思えないけど」"

#. Occurrence D_3:724:19012: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_3_0006; voice_prefix=A30; voice_category=3; scene=D_3
#: D_3:724
msgctxt "text_id=19012 | speaker=soujuurou"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence D_3:744:19013: scene=D_3
#: D_3:744
msgctxt "text_id=19013 | speaker=unknown"
msgid "  Whether they succeed or fail in their endeavor, those who reach the Root become unable to return to the normal world."
msgstr "　成功者も失敗者も、それに触れては、こちらの世界に帰っては来られない。"

#. Occurrence D_3:749:19014: scene=D_3
#: D_3:749
msgctxt "text_id=19014 | speaker=unknown"
msgid "  Maybe the first person to become God felt lonely"
msgstr "　根源の渦とやらを人々に伝えたのは、"

#. Occurrence D_3:749:19015: scene=D_3
#: D_3:749
msgctxt "text_id=19015 | speaker=unknown"
msgid "  and spread the word about the Swirl of the Root in order to have others join them there."
msgstr "　一番初めに神さまになった誰かが、淋しさから仲間を欲しがった結果なのかもしれない。"

#. Occurrence D_3:754:19016: scene=D_3
#: D_3:754
msgctxt "text_id=19016 | speaker=unknown"
msgid "  Or maybe they had so much work to do as God they just needed some help."
msgstr "　……あるいは、あちらの仕事はあまりにも膨大で、他にも仲間を欲しがったのか。"

#. Occurrence D_3:759:19017: scene=D_3
#: D_3:759
msgctxt "text_id=19017 | speaker=unknown"
msgid "  None of it made any sense no matter how long Soujyuro thought about it."
msgstr "　草十郎には、いくら考えても掴めない事ではあるが。"

#. Occurrence D_3:785:19018: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_3_0007; voice_prefix=A30; voice_category=3; scene=D_3
#: D_3:785
msgctxt "text_id=19018 | speaker=soujuurou"
msgid "\"You think Miss Touko wanted to become a god?\""
msgstr "「……橙子さんは、そうなりたかったのかな」"

#. Occurrence D_3:819:19019: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0023; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:819
msgctxt "text_id=19019 | speaker=aoko"
msgid "\"Oh, please. She just wanted to know the truth."
msgstr "「まさか。あの人は単に知りたかっただけよ。"

#. Occurrence D_3:825:19020: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0024; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:825
msgctxt "text_id=19020 | speaker=aoko"
msgid "  She doesn't care what happens to the next person. That's how she's always been. She just focuses completely on her goal and doesn't worry about what comes next.\""
msgstr "　その後に残された人たちの事なんて興味はないの。昔から、目標に没頭しても成果を愛する人じゃなかったから」"

#. Occurrence D_3:883:19021: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0025; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:883
msgctxt "text_id=19021 | speaker=aoko"
msgid "\"She's a bit on the extreme side, to be honest."
msgstr "「正直なところ、そのあたり姉貴は突き抜けてるわ。"

#. Occurrence D_3:890:19022: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0026; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:890
msgctxt "text_id=19022 | speaker=aoko"
msgid "But geniuses always have an inhumane side to them like that. They work and work on their masterpiece without so much as considering what will happen once it's complete.\""
msgstr "ホントの天才ってのはああいう非人間のコト言うのよ。苦労して作り上げたモノの、その後をまったく考えないんだから」"

#. Occurrence D_3:896:19023: scene=D_3
#: D_3:896
msgctxt "text_id=19023 | speaker=unknown"
msgid "  Soujyuro wasn't sure whether she spoke out of disgust or respect."
msgstr "　呆れているようにも認めているようにも取れる口ぶり。"

#. Occurrence D_3:924:19024: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0027; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:924
msgctxt "text_id=19024 | speaker=aoko"
msgid "\"But she's still pretty considerate to others in the moment."
msgstr "「でも、そのくせ面倒見はいいって言うか。"

#. Occurrence D_3:930:19025: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_3_0028; voice_prefix=A10; voice_category=1; scene=D_3
#: D_3:930
msgctxt "text_id=19025 | speaker=aoko"
msgid "  Since she doesn't worry about the future, she focuses all her energy on the here and now.\""
msgstr "　未来の事は考えないのに、今あるものには何にでも興味を持つんだから」"

#. Occurrence D_3:943:19026: scene=D_3
#: D_3:943
msgctxt "text_id=19026 | speaker=unknown"
msgid "  Aoko praised her sister's genius even while cursing her every being."
msgstr "　これだから天才肌の女は、と悪態をつく青子。"

#. Occurrence D_3:948:19027: scene=D_3
#: D_3:948
msgctxt "text_id=19027 | speaker=unknown"
msgid "  Though her tone of voice was perfectly pleasant and lacked any audible animosity."
msgstr "　<敵意|てきい>の<欠片|かけら>もない声は、聞くものとしては微笑ましい。"

#. Occurrence D_3:1002:19028: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_3_0008; voice_prefix=A30; voice_category=3; scene=D_3
#: D_3:1002
msgctxt "text_id=19028 | speaker=soujuurou"
msgid "\"Right. She does seem like she'd rather stay here.\""
msgstr "「そうだね。それに、橙子さんはこっちの方が好きみたいだったから」"

#. Occurrence D_3:1008:19029: scene=D_3
#: D_3:1008
msgctxt "text_id=19029 | speaker=unknown"
msgid "  As soon as he spoke, he was struck by the meaning of Aoko's earlier words."
msgstr "　そんな事を口にしたら、草十郎は先ほどの言葉の意味も分かってしまった。"

#. Occurrence D_3:1027:19030: scene=D_3
#: D_3:1027
msgctxt "text_id=19030 | speaker=unknown"
msgid "\"I don't care about the Root.\""
msgstr "“根源になんて興味はない”"

#. Occurrence D_3:1060:19031: scene=D_3
#: D_3:1060
msgctxt "text_id=19031 | speaker=unknown"
msgid "  He realized that she must feel the same way as Touko."
msgstr "　つまり青子も、橙子と同じ気持ちなのだろう、と。"

#. Occurrence D_4:40:19032: scene=D_4
#: D_4:40
msgctxt "text_id=19032 | speaker=unknown"
msgid "  Still..."
msgstr "　―――と。"

#. Occurrence D_4:45:19033: scene=D_4
#: D_4:45
msgctxt "text_id=19033 | speaker=unknown"
msgid "  There was one thing that had been bothering Soujyuro regarding Touko."
msgstr "　橙子と言えば、草十郎にはちょっとした疑問があった。"

#. Occurrence D_4:93:19034: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_4_0000; voice_prefix=A30; voice_category=3; scene=D_4
#: D_4:93
msgctxt "text_id=19034 | speaker=soujuurou"
msgid "\"What did you mean about turning her into a frog?\""
msgstr "「そういえば。カエルにするって、いったい……」"

#. Occurrence D_4:99:19035: scene=D_4
#: D_4:99
msgctxt "text_id=19035 | speaker=unknown"
msgid "  He ventured to bring up the topic no one had been talking about since it occurred."
msgstr "　あれ以来まったく口にしなかった話題を、草十郎は口にしてみた。"

#. Occurrence D_4:104:19036: scene=D_4
#: D_4:104
msgctxt "text_id=19036 | speaker=unknown"
msgid "  It had always seemed taboo to bring up, so the sense of transgression made him hesitate as he finally sought the truth."
msgstr "　それを訊くのは<禁忌|タブー>のように思えていたし、なにより、その<突飛|とっぴ>さ故、真実を聞くのが<躊躇|ためら>われたというか。"

#. Occurrence D_4:153:19037: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0000; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:153
msgctxt "text_id=19037 | speaker=aoko"
msgid "\"Exactly what it sounds like."
msgstr "「いったいも何も、言葉通りの意味だけど。"

#. Occurrence D_4:159:19038: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0001; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:159
msgctxt "text_id=19038 | speaker=aoko"
msgid "  Rune mages can shapeshift, so apparently that made her especially susceptible to the curse.\""
msgstr "　もともとルーン使いには変身術があるぶん、橙子にはかかりやすかったみたいよ？」"

#. Occurrence D_4:198:19039: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_4_0001; voice_prefix=A30; voice_category=3; scene=D_4
#: D_4:198
msgctxt "text_id=19039 | speaker=soujuurou"
msgid "\"That sounds like a bigger deal than you're making it out to be...\""
msgstr "「いや、そんな当然のように言われても……」"

#. Occurrence D_4:204:19040: scene=D_4
#: D_4:204
msgctxt "text_id=19040 | speaker=unknown"
msgid "  His stomach hurt from the stress of not knowing how to respond to her cavalier attitude."
msgstr "　本気でどう切り返していいか、ちくりと胃が痛む草十郎だった。"

#. Occurrence D_4:264:19041: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_4_0002; voice_prefix=A30; voice_category=3; scene=D_4
#: D_4:264
msgctxt "text_id=19041 | speaker=soujuurou"
msgid "\"I mean... how is it even possible to turn someone into a frog?\""
msgstr "「…………まあ。それで、どうやって？」"

#. Occurrence D_4:270:19042: scene=D_4
#: D_4:270
msgctxt "text_id=19042 | speaker=unknown"
msgid "  He did not particularly want to ask, but it was the natural extension of his current line of inquiry."
msgstr "　聞きたくはないけれど、話の流れから問いたださずにはいられない。"

#. Occurrence D_4:275:19043: scene=D_4
#: D_4:275
msgctxt "text_id=19043 | speaker=unknown"
msgid "  Aoko stared straight ahead as she lectured him, completely ignoring the pained expression on his face."
msgstr "　草十郎の嫌そうな顔には気が付かず、青子は前を見たまま、教師よろしく説明をする。"

#. Occurrence D_4:321:19044: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0002; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:321
msgctxt "text_id=19044 | speaker=aoko"
msgid "\"So, there are two ways to go about it: a mind swap, or a reconfiguration of the person's physical form."
msgstr "「二種類あって、精神を入れ替えるのか、肉体を再編成するかね。"

#. Occurrence D_4:327:19045: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0003; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:327
msgctxt "text_id=19045 | speaker=aoko"
msgid "  Swapping minds is easy, but the effects don't last long."
msgstr "　精神だけを入れ替えるのは簡単な分、すぐ元に戻れるわ。"

#. Occurrence D_4:333:19046: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0004; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:333
msgctxt "text_id=19046 | speaker=aoko"
msgid "  It feels like you're dreaming, and then there's a little jolt when you return to your body.\""
msgstr "　夢を見ているようなものだし、ちょっとしたショックで元の体に意識が戻ってくれるから」"

#. Occurrence D_4:360:19047: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0005; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:360
msgctxt "text_id=19047 | speaker=aoko"
msgid "\"Changing someone's physical form is more tricky, and it's hard to revert back before the spell ends."
msgstr "「厄介なのは肉体そのものを変えてしまう方で、この場合、術が切れるまで元に戻るのは難しいでしょうね。"

#. Occurrence D_4:366:19048: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0006; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:366
msgctxt "text_id=19048 | speaker=aoko"
msgid "  I used the physical reconfiguration approach, I guess."
msgstr "　私がやったのは、その再編成の方みたい。"

#. Occurrence D_4:378:19049: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0007; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:378
msgctxt "text_id=19049 | speaker=aoko"
msgid "  Something about reconstructing the base DNA sequence... I don't know, it's all gibberish to me! You can't explain magecraft with scientific jargon, anyway, right?\""
msgstr "　たぶん塩基配列を組み換えるんだろうけど、もうちんぷんかんぷん。ま、魔術が科学的な説明するのもナンセンスだし？」"

#. Occurrence D_4:398:19050: scene=D_4
#: D_4:398
msgctxt "text_id=19050 | speaker=unknown"
msgid "  Aoko spoke as if it were not her own actions she were discussing."
msgstr "　しれっと、まさに他人事のように青子は言った。"

#. Occurrence D_4:403:19051: scene=D_4
#: D_4:403
msgctxt "text_id=19051 | speaker=unknown"
msgid "  Apparently, she had been borrowing magecraft from her future self and could not use any of it in the present."
msgstr "　あの時の青子が扱った魔術は前借りしたようなもので、今の青子にはまったく使えないものらしい。"

#. Occurrence D_4:441:19052: scene=D_4
#: D_4:441
msgctxt "text_id=19052 | speaker=unknown"
msgid "  Her actions had also created a looming threat that would come back to haunt them in ten years' time."
msgstr "　不幸中の幸いではあるが、同時に、十年後にくる逃れられない脅威でもある。"

#. Occurrence D_4:446:19053: scene=D_4
#: D_4:446
msgctxt "text_id=19053 | speaker=unknown"
msgid "  Trying to comprehend even a fraction of all the intricacies involved made Soujyuro's head hurt."
msgstr "　とばっちりを受ける候補その一としては、たいへん頭の痛い問題だった。"

#. Occurrence D_4:473:19054: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_4_0003; voice_prefix=A30; voice_category=3; scene=D_4
#: D_4:473
msgctxt "text_id=19054 | speaker=soujuurou"
msgid "\"But several years from now, you'll know how to do stuff like that?"
msgstr "「あと数年後には蒼崎はそんな事もできるのか。"

#. Occurrence D_4:479:19055: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_4_0004; voice_prefix=A30; voice_category=3; scene=D_4
#: D_4:479
msgctxt "text_id=19055 | speaker=soujuurou"
msgid "  Pretty scary if you ask me.\""
msgstr "　…………<末|すえ>恐ろしいな」"

#. Occurrence D_4:491:19056: scene=D_4
#: D_4:491
msgctxt "text_id=19056 | speaker=unknown"
msgid "  Soujyuro was being completely honest with her."
msgstr "　心底からの気持ちを呟く草十郎。"

#. Occurrence D_4:496:19057: scene=D_4
#: D_4:496
msgctxt "text_id=19057 | speaker=unknown"
msgid "  In response, Aoko only stared ahead blankly, eyes open wide."
msgstr "　それに青子はきょとんと目を見開く。"

#. Occurrence D_4:501:19058: scene=D_4
#: D_4:501
msgctxt "text_id=19058 | speaker=unknown"
msgid "  She looked like she wanted to scold him."
msgstr "　何をいまさら、と言いたげな顔だった。"

#. Occurrence D_4:552:19059: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0008; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:552
msgctxt "text_id=19059 | speaker=aoko"
msgid "\"Physical reconfiguration would be no problem for Alice even now, you know.\""
msgstr "「えっとね。有珠ならそれぐらい、今でもできるわよ」"

#. Occurrence D_4:635:19060: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_4_0005; voice_prefix=A30; voice_category=3; scene=D_4
#: D_4:635
msgctxt "text_id=19060 | speaker=soujuurou"
msgid "\"Wait, what?\""
msgstr "「――――――なん、だと？」"

#. Occurrence D_4:696:19061: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0009; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:696
msgctxt "text_id=19061 | speaker=aoko"
msgid "\"I said you should take her more seriously, remember?"
msgstr "「……やっぱりね、そんな事だと思ってたわ。"

#. Occurrence D_4:702:19062: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0010; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:702
msgctxt "text_id=19062 | speaker=aoko"
msgid "  You really never listen."
msgstr "　前にも言ったでしょ、アンタはあの娘を甘く見てるって。"

#. Occurrence D_4:708:19063: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0011; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:708
msgctxt "text_id=19063 | speaker=aoko"
msgid "  Know those dolls in her room? They're all that's left of people who opposed her.\""
msgstr "　有珠の部屋のもろもろの人形は、あの娘に逆らった執事たちのなれの果てなんだから」"

#. Occurrence D_4:736:19064: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_4_0006; voice_prefix=A30; voice_category=3; scene=D_4
#: D_4:736
msgctxt "text_id=19064 | speaker=soujuurou"
msgid "\"...Surely, Alice would never do something like that.\""
msgstr "「……まさか。有珠はそんなコトしないぞ」"

#. Occurrence D_4:799:19065: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0012; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:799
msgctxt "text_id=19065 | speaker=aoko"
msgid "\"That's exactly what I thought for the first six months or so.\""
msgstr "「いやいや、これがこれが。私もねー、付き合い初めて半年はそう思ってたんだけどねー」"

#. Occurrence D_4:804:19066: scene=D_4
#: D_4:804
msgctxt "text_id=19066 | speaker=unknown"
msgid "  The light, cheerful laughter that followed only made her statement all the more chilling."
msgstr "　軽快に笑いとばす青子だが、その陽気さが逆に怖い。"

#. Occurrence D_4:854:19067: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_4_0007; voice_prefix=A30; voice_category=3; scene=D_4
#: D_4:854
msgctxt "text_id=19067 | speaker=soujuurou"
msgid "\"It's not funny to joke like that, Aozaki.\""
msgstr "「……蒼崎。その冗談、笑えないぞ」"

#. Occurrence D_4:886:19068: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0013; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:886
msgctxt "text_id=19068 | speaker=aoko"
msgid "\"Do I look like I'm trying to make you laugh?\""
msgstr "「あら、私は笑わせる気なんて、これっぽっちもないんだけど？」"

#. Occurrence D_4:936:19069: scene=D_4
#: D_4:936
msgctxt "text_id=19069 | speaker=unknown"
msgid "  She was clearly making fun of him at this point."
msgstr "　青子は明らかに草十郎をからかっている。"

#. Occurrence D_4:941:19070: scene=D_4
#: D_4:941
msgctxt "text_id=19070 | speaker=unknown"
msgid "  Unable to determine how serious to take what she had said, Soujyuro's mood and expression only grew darker."
msgstr "　どこまで信じていいのか判別がつかず、ますます顔をしかめる草十郎。"

#. Occurrence D_4:947:19071: scene=D_4
#: D_4:947
msgctxt "text_id=19071 | speaker=unknown"
msgid "His obvious dejection made Aoko smile with satisfaction."
msgstr "そんな消沈ぶりが楽しくて、青子はにまにまと微笑んでいる。"

#. Occurrence D_4:1006:19072: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_4_0014; voice_prefix=A10; voice_category=1; scene=D_4
#: D_4:1006
msgctxt "text_id=19072 | speaker=aoko"
msgid "\"She shouldn't be able to be a witch in the first place if she agrees with what you're saying...\""
msgstr "“……ま、あそこでアンタの言葉にうなずいちゃうあの娘が、そこまで魔女になれる筈もないんだけど―――”"

#. Occurrence D_4:1012:19073: scene=D_4
#: D_4:1012
msgctxt "text_id=19073 | speaker=unknown"
msgid "  She gazed at him as they walked, her chest warm with emotion."
msgstr "　温かな感想を胸に留めた少女は、彼の横顔を見ながら歩いていく。"

#. Occurrence D_5:72:19074: scene=D_5
#: D_5:72
msgctxt "text_id=19074 | speaker=unknown"
msgid "  The path they strode had shifted from footpaths through rice fields to a road climbing the mountain."
msgstr "　道はいつしか、<畦道|あぜみち>から山道になっていた。"

#. Occurrence D_5:78:19075: scene=D_5
#: D_5:78
msgctxt "text_id=19075 | speaker=unknown"
msgid "  It was surprisingly wide given the mountain's small size, though with no shortage of trees on either side."
msgstr "　小振りな山は思いのほか<拓|ひら>けていて、木々はあるものの、山道は横に広い。"

#. Occurrence D_5:83:19076: scene=D_5
#: D_5:83
msgctxt "text_id=19076 | speaker=unknown"
msgid "  The forest road led them up to the top of the mountain."
msgstr "　自然の並木道は<延々|えんえん>と山頂に向かっている。"

#. Occurrence D_5:109:19077: scene=D_5
#: D_5:109
msgctxt "text_id=19077 | speaker=unknown"
msgid "  Wheel marks were etched into the dirt underfoot."
msgstr "　土の道には<轍|わだち>がある。"

#. Occurrence D_5:114:19078: scene=D_5
#: D_5:114
msgctxt "text_id=19078 | speaker=unknown"
msgid "  No doubt the Aozaki family came through here by car."
msgstr "　おそらく蒼崎の家から車が通っているのだろう。"

#. Occurrence D_5:119:19079: scene=D_5
#: D_5:119
msgctxt "text_id=19079 | speaker=unknown"
msgid "  The only light at the summit was that of the moon and stars overhead; the bald mountaintop lacked streetlights and houses as well as vegetation."
msgstr "　はげ山には街灯も民家もなく、明かりは星と月の光だけだった。"

#. Occurrence D_5:168:19080: scene=D_5
#: D_5:168
msgctxt "text_id=19080 | speaker=unknown"
msgid "  Near the top, the incline of their path began to even out."
msgstr "　山道の傾斜は、段々と平坦になっていく。"

#. Occurrence D_5:173:19081: scene=D_5
#: D_5:173
msgctxt "text_id=19081 | speaker=unknown"
msgid "  The road ended abruptly at a house, still a good way away before them."
msgstr "　道はずっと先にある民家の前で途切れようとしていた。"

#. Occurrence D_5:179:19082: scene=D_5
#: D_5:179
msgctxt "text_id=19082 | speaker=unknown"
msgid "  It was too far to make out the shape of the building, but Soujyuro assumed it was Aozaki's house based on the warm light coming from the windows."
msgstr "　まだ遠くで建物の<輪郭|りんかく>も掴めないけれど、暖かそうな窓明かりから、あれが蒼崎の家だろうと草十郎は読み取った。"

#. Occurrence D_5:201:19083: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_5_0000; voice_prefix=A30; voice_category=3; scene=D_5
#: D_5:201
msgctxt "text_id=19083 | speaker=soujuurou"
msgid "\"So, what should I do while you're busy with your family bonding time?\""
msgstr "「ところで、君が家で団らんしている間、自分は何をしていればいいんだろう」"

#. Occurrence D_5:207:19084: scene=D_5
#: D_5:207
msgctxt "text_id=19084 | speaker=unknown"
msgid "  Soujyuro had a hard time imagining Aoko engaging in any sort of \"family bonding time,\" but with effort, he could imagine that it must be a joyful time for her."
msgstr "　一家<団欒|だんらん>する青子の姿は想像しにくかったが、無理やりしてみると、それはそれでたいへん幸福そうな場面が想像できた。"

#. Occurrence D_5:212:19085: scene=D_5
#: D_5:212
msgctxt "text_id=19085 | speaker=unknown"
msgid "  He did not want to ruin that by intruding, which is why he brought up the subject now."
msgstr "　自分が入る事でそれを壊すのは<忍|しの>びなく、草十郎は青子にそう訊ねたのだ。"

#. Occurrence D_5:302:19086: scene=D_5
#: D_5:302
msgctxt "text_id=19086 | speaker=unknown"
msgid "  If he had to, he would not have minded spending the night camping outside."
msgstr "　草十郎としては今から帰っても、ここで一晩<野営|やえい>しても文句はない。"

#. Occurrence D_5:307:19087: scene=D_5
#: D_5:307
msgctxt "text_id=19087 | speaker=unknown"
msgid "  Her reply was not what he had expected."
msgstr "　けれど、青子の返答は予想外のものだった。"

#. Occurrence D_5:329:19088: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0000; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:329
msgctxt "text_id=19088 | speaker=aoko"
msgid "\"You're going to go meet my grandfather."
msgstr "「君は、うちの離れにいって祖父に会うの。"

#. Occurrence D_5:335:19089: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0001; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:335
msgctxt "text_id=19089 | speaker=aoko"
msgid "  He might be able to erase your memories of everything that's happened.\""
msgstr "　たぶん、そこで今日までの記憶を消されるわ」"

#. Occurrence D_5:342:19090: scene=D_5
#: D_5:342
msgctxt "text_id=19090 | speaker=unknown"
msgid "  She stopped dead in her tracks as she spoke."
msgstr "　ぴたりと足を止めて青子はそう言った。"

#. Occurrence D_5:347:19091: scene=D_5
#: D_5:347
msgctxt "text_id=19091 | speaker=unknown"
msgid "  The frank and open attitude she had shown all night was now gone."
msgstr "　今までの打ち解けた雰囲気もなく、他人と話すように。"

#. Occurrence D_5:402:19092: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_5_0001; voice_prefix=A30; voice_category=3; scene=D_5
#: D_5:402
msgctxt "text_id=19092 | speaker=soujuurou"
msgid "\"...Huh?\""
msgstr "「え………………？」"

#. Occurrence D_5:407:19093: scene=D_5
#: D_5:407
msgctxt "text_id=19093 | speaker=unknown"
msgid "  Soujyuro was too shocked to take another step forward."
msgstr "　驚いて、草十郎も足を止める。"

#. Occurrence D_5:430:19094: scene=D_5
#: D_5:430
msgctxt "text_id=19094 | speaker=unknown"
msgid "  He turned back to look at her, having been walking a little ways ahead, and realized she was not joking."
msgstr "　追い抜いてしまった青子を振り返ると、それが真実である事がはっきりと分かった。"

#. Occurrence D_5:451:19095: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0002; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:451
msgctxt "text_id=19095 | speaker=aoko"
msgid "\"...\""
msgstr "「…………………………」"

#. Occurrence D_5:456:19096: scene=D_5
#: D_5:456
msgctxt "text_id=19096 | speaker=unknown"
msgid "  He stood still, taking in the glaring silence."
msgstr "　睨むような沈黙と、それを自然に受けとめる草十郎。"

#. Occurrence D_5:461:19097: scene=D_5
#: D_5:461
msgctxt "text_id=19097 | speaker=unknown"
msgid "  Naturally, Aoko was the first to resume speaking."
msgstr "　先に口を開けたのは、やっぱり青子だった。"

#. Occurrence D_5:492:19098: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0003; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:492
msgctxt "text_id=19098 | speaker=aoko"
msgid "\"Nothing surprises you, does it?\""
msgstr "「驚かないのね、貴方」"

#. Occurrence D_5:528:19099: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_5_0002; voice_prefix=A30; voice_category=3; scene=D_5
#: D_5:528
msgctxt "text_id=19099 | speaker=soujuurou"
msgid "\"No, I'm surprised. Of course I am. And now I understand why you wanted to bring me along.\""
msgstr "「……いや、驚いたけど。でも、それは初めから決まっていた事だ。そうか、それで蒼崎は俺を連れて来たのか」"

#. Occurrence D_5:540:19100: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0004; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:540
msgctxt "text_id=19100 | speaker=aoko"
msgid "\"I wasn't lying about wanting someone to talk to, though. It just so happens that my grandfather also told me to bring you to see him.\""
msgstr "「退屈しのぎは本当よ。それとは別に、祖父が貴方を連れて来いって言ったの」"

#. Occurrence D_5:656:19101: scene=D_5
#: D_5:656
msgctxt "text_id=19101 | speaker=unknown"
msgid "  Soujyuro nodded in acceptance."
msgstr "　なるほど、と少年はうなずく。"

#. Occurrence D_5:661:19102: scene=D_5
#: D_5:661
msgctxt "text_id=19102 | speaker=unknown"
msgid "  He was as quiet and unchanging as the night around him."
msgstr "　夜は<密|ひそ>やかに変わりなく、少年も、なにひとつ変わりはなかった。"

#. Occurrence D_5:666:19103: scene=D_5
#: D_5:666
msgctxt "text_id=19103 | speaker=unknown"
msgid "  Aoko found it thoroughly irritating."
msgstr "　……目前の少女が、その在り方を憎らしいと思うほどに。"

#. Occurrence D_5:694:19104: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_5_0003; voice_prefix=A30; voice_category=3; scene=D_5
#: D_5:694
msgctxt "text_id=19104 | speaker=soujuurou"
msgid "\"Well, we should get going then. It gets cold when you stop moving.\""
msgstr "「それじゃ行こうか。立っていると寒い」"

#. Occurrence D_5:700:19105: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0005; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:700
msgctxt "text_id=19105 | speaker=aoko"
msgid "\"Soujyuro.\""
msgstr "「草十郎」"

#. Occurrence D_5:705:19106: scene=D_5
#: D_5:705
msgctxt "text_id=19106 | speaker=unknown"
msgid "  Aoko's voice stopped him in his tracks just as he was about to resume walking toward her house."
msgstr "　歩きだそうとする草十郎を、青子は声で引き止める。"

#. Occurrence D_5:711:19107: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0006; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:711
msgctxt "text_id=19107 | speaker=aoko"
msgid "\"Are you sure you're okay with this?"
msgstr "「貴方はそれでいいの？"

#. Occurrence D_5:717:19108: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0007; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:717
msgctxt "text_id=19108 | speaker=aoko"
msgid "  If he erases your memory, it'll be like this whole month never happened.\""
msgstr "　記憶を消されるって事は、今までの一ヶ月がなくなるのと同じなのよ」"

#. Occurrence D_5:786:19109: scene=D_5
#: D_5:786
msgctxt "text_id=19109 | speaker=unknown"
msgid "  Soujyuro murmured in understanding."
msgstr "　青子の問いに、草十郎はそうか、と呟いた。"

#. Occurrence D_5:791:19110: scene=D_5
#: D_5:791
msgctxt "text_id=19110 | speaker=unknown"
msgid "  The thought of returning to his old self and forgetting about Aoko, Alice, and the mansion altogether felt like giving up a treasure that he had discovered."
msgstr "　青子の事はもちろん、有珠の事や、あの洋館での暮らしを忘れて一ヶ月前の自分に戻るのは、手に入れかけた宝物を無くしてしまうような気がする。"

#. Occurrence D_5:796:19111: scene=D_5
#: D_5:796
msgctxt "text_id=19111 | speaker=unknown"
msgid "  But he didn't feel that he was unable to let them go, either."
msgstr "　けれど、それを惜しいと、彼は思わなかった。"

#. Occurrence D_5:847:19112: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_5_0004; voice_prefix=A30; voice_category=3; scene=D_5
#: D_5:847
msgctxt "text_id=19112 | speaker=soujuurou"
msgid "\"It would definitely be bad. It's been a fun month since I met you, and I just made that promise to Alice, too."
msgstr "「たしかにそれは嫌だな。蒼崎と知り合ってからの一ヶ月は楽しかったし、有珠とも約束したばっかりだし。"

#. Occurrence D_5:853:19113: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_5_0005; voice_prefix=A30; voice_category=3; scene=D_5
#: D_5:853
msgctxt "text_id=19113 | speaker=soujuurou"
msgid "  But it's not like you'll disappear. We'll still see each other at school once winter break's over, right?\""
msgstr "　でも蒼崎が消えるわけじゃないんだろう？　冬休みが終われば、また学校で会えるじゃないか」"

#. Occurrence D_5:900:19114: scene=D_5
#: D_5:900
msgctxt "text_id=19114 | speaker=unknown"
msgid "  There was no answer from Aoko."
msgstr "　それに青子は返答しなかった。"

#. Occurrence D_5:905:19115: scene=D_5
#: D_5:905
msgctxt "text_id=19115 | speaker=unknown"
msgid "  She did not tell him that he was not the only one who would be losing their memory."
msgstr "　青子はあえて口にはしなかったが、記憶を消されるのは草十郎だけではない。"

#. Occurrence D_5:910:19116: scene=D_5
#: D_5:910
msgctxt "text_id=19116 | speaker=unknown"
msgid "  Intervention by her grandfather would erase her own memories of Soujyuro, too."
msgstr "　彼女の祖父が介入する以上、青子も草十郎に関する記憶を消されるのだ。"

#. Occurrence D_5:978:19117: scene=D_5
#: D_5:978
msgctxt "text_id=19117 | speaker=unknown"
msgid "  Once it was done, they would most likely never even speak with one another again."
msgstr "　その後には、お互いの接点はないように思われた。"

#. Occurrence D_5:983:19118: scene=D_5
#: D_5:983
msgctxt "text_id=19118 | speaker=unknown"
msgid "  Each would become just another random student at school."
msgstr "　こんな関係になる事もなく、ただ気に食わない生徒にしか見えない。"

#. Occurrence D_5:988:19119: scene=D_5
#: D_5:988
msgctxt "text_id=19119 | speaker=unknown"
msgid "  Even if they did happen to meet by some lucky circumstance, things would not be the same as they were now."
msgstr "　どんなに優れた偶然が働いても、もう、今の状況には戻れない。"

#. Occurrence D_5:993:19120: scene=D_5
#: D_5:993
msgctxt "text_id=19120 | speaker=unknown"
msgid "  She could not deny that a small part of her was going to miss him."
msgstr "　……それを少し残念だと思うのは、たしかに、未練だと認めるしかない。"

#. Occurrence D_5:1014:19121: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0008; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:1014
msgctxt "text_id=19121 | speaker=aoko"
msgid "\"Right. Let's get going.\""
msgstr "「そう。なら行きましょ」"

#. Occurrence D_5:1060:19122: scene=D_5
#: D_5:1060
msgctxt "text_id=19122 | speaker=unknown"
msgid "  She rationalized her feelings away instead of processing them and set off once more toward the house."
msgstr "　整理のつかないまま、理屈だけで感情を切り捨てて、青子は歩きだした。"

#. Occurrence D_5:1066:19123: scene=D_5
#: D_5:1066
msgctxt "text_id=19123 | speaker=unknown"
msgid "  Soujyuro followed along at her side."
msgstr "　そのとなりに草十郎は付き添っていく。"

#. Occurrence D_5:1087:19124: scene=D_5
#: D_5:1087
msgctxt "text_id=19124 | speaker=unknown"
msgid "  It was a matter of several minutes before they reached their destination."
msgstr "　目的地まであと数分。"

#. Occurrence D_5:1092:19125: scene=D_5
#: D_5:1092
msgctxt "text_id=19125 | speaker=unknown"
msgid "  She was irritated to see that the expression on his face looked exactly the same as it always did."
msgstr "　草十郎はいつも通りの顔で歩いていて、青子にはそれが腹立たしい。"

#. Occurrence D_5:1105:19126: scene=D_5
#: D_5:1105
msgctxt "text_id=19126 | speaker=unknown"
msgid "  Forgetting their time together was sad for her, if only slightly so, but it did not seem to bother him in the least."
msgstr "　こっちはホンの少しだけど未練と思っているのに、この男は<微塵|みじん>もそう思っていないのだ。"

#. Occurrence D_5:1133:19127: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0009; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:1133
msgctxt "text_id=19127 | speaker=aoko"
msgid "\"Guess you can't expect much sensitivity from someone who has no problem putting themselves in harm's way by breaking both his...\""
msgstr "「……そりゃあね、平気で自分の腕を叩き折れるヤツに、そんな<繊細|せんさい>なコト期待していないけ、ど……」"

#. Occurrence D_5:1167:19128: scene=D_5
#: D_5:1167
msgctxt "text_id=19128 | speaker=unknown"
msgid "  Halfway through muttering her complaint, Aoko suddenly remembered."
msgstr "　つい憎まれ口を叩いて、青子は唐突に思い出した。"

#. Occurrence D_5:1172:19129: scene=D_5
#: D_5:1172
msgctxt "text_id=19129 | speaker=unknown"
msgid "  Or rather, she realized something."
msgstr "　いや、思い至ってしまった。"

#. Occurrence D_5:1219:19130: scene=D_5
#: D_5:1219
msgctxt "text_id=19130 | speaker=unknown"
msgid "  Something about the one-time werewolf killer before her."
msgstr "　一度きりの狼退治。"

#. Occurrence D_5:1224:19131: scene=D_5
#: D_5:1224
msgctxt "text_id=19131 | speaker=unknown"
msgid "  And the mystery of who Soujyuro Sizuki really was."
msgstr "　静希草十郎とは何者なのか、という不明点を。"

#. Occurrence D_5:1229:19132: scene=D_5
#: D_5:1229
msgctxt "text_id=19132 | speaker=unknown"
msgid "  The older version of herself that night had had memories and knowledge of Soujyuro beyond what she knew now."
msgstr "　あの夜の青子は草十郎の<時間|きおく>を知ってはいたが、今の青子は知る<由|よし>もない。"

#. Occurrence D_5:1239:19133: scene=D_5
#: D_5:1239
msgctxt "text_id=19133 | speaker=unknown"
msgid "  She knew something about this seemingly average boy's mistakes―"
msgstr "　この凡庸な少年の間違い。"

#. Occurrence D_5:1245:19134: scene=D_5
#: D_5:1245
msgctxt "text_id=19134 | speaker=unknown"
msgid "why he was able to do what he did, and why he was raised in the mountains in the first place."
msgstr "なぜあんな事が出来たのか、そもそも、彼は山でどんな生活をしていたのか。"

#. Occurrence D_5:1270:19135: scene=D_5
#: D_5:1270
msgctxt "text_id=19135 | speaker=unknown"
msgid "  She had always wondered but never had a chance to ask him about it... until now."
msgstr "　今まで気になってはいたものの、ついに聞き出す機会には恵まれなかった。"

#. Occurrence D_5:1275:19136: scene=D_5
#: D_5:1275
msgctxt "text_id=19136 | speaker=unknown"
msgid "  Once her grandfather was through with them, all those questions she had about Soujyuro would be gone, too."
msgstr "　その疑問も、祖父に会えば疑問と思う事さえなくなってしまうだろう。"

#. Occurrence D_5:1304:19137: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0010; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:1304
msgctxt "text_id=19137 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence D_5:1310:19138: scene=D_5
#: D_5:1310
msgctxt "text_id=19138 | speaker=unknown"
msgid "  There was no point in asking right before they had their memories erased. But then again, she might as well if she was going to forget everything anyway."
msgstr "　たとえすぐに忘れてしまうにしても―――いや、数分後には何もかも無かった事になるのなら。"

#. Occurrence D_5:1315:19139: scene=D_5
#: D_5:1315
msgctxt "text_id=19139 | speaker=unknown"
msgid "  This was her only chance to demand an explanation for his contradictory behavior."
msgstr "　彼に、その矛盾を吐き出させる機会は今しかない。"

#. Occurrence D_5:1364:19140: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0011; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:1364
msgctxt "text_id=19140 | speaker=aoko"
msgid "\"Wait. There's one thing I wanted to ask you before this is all over."
msgstr "「待って。私も最後にひとつ、訊きたい事がある。"

#. Occurrence D_5:1370:19141: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0012; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:1370
msgctxt "text_id=19141 | speaker=aoko"
msgid "  What was your life like when you lived in the mountains? What were you doing there?\""
msgstr "　―――アンタ、山でどんな生活を送ってたの？」"

#. Occurrence D_5:1378:19142: scene=D_5
#: D_5:1378
msgctxt "text_id=19142 | speaker=unknown"
msgid "  Her questions stopped him on the spot."
msgstr "　青子の問いに、草十郎はぴたりと足を止めた。"

#. Occurrence D_5:1383:19143: scene=D_5
#: D_5:1383
msgctxt "text_id=19143 | speaker=unknown"
msgid "  She had never seen him make such a pained expression."
msgstr "　その顔は今までのどんなものより<辛|つら>そうに見える。"

#. Occurrence D_5:1425:19144: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_5_0006; voice_prefix=A30; voice_category=3; scene=D_5
#: D_5:1425
msgctxt "text_id=19144 | speaker=soujuurou"
msgid "\"Why do you want to talk about something so boring?\""
msgstr "「つまらないよ、そんな話は」"

#. Occurrence D_5:1431:19145: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0013; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:1431
msgctxt "text_id=19145 | speaker=aoko"
msgid "\"I already told you I don't expect you to say anything interesting."
msgstr "「面白い話は期待してないって言ったでしょ。"

#. Occurrence D_5:1437:19146: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0014; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:1437
msgctxt "text_id=19146 | speaker=aoko"
msgid "  I'm about to forget everything you say, so just humor me on this one, okay?\""
msgstr "　どうせ私も草十郎の事は忘れるんだから、それぐらい話してくれてもいいんじゃない？」"

#. Occurrence D_5:1443:19147: scene=D_5
#: D_5:1443
msgctxt "text_id=19147 | speaker=unknown"
msgid "  Her words and demanding gaze caused him to lift his head in surprise."
msgstr "　けち、とばかりに見据える青子の発言に、草十郎は驚いて顔をあげた。"

#. Occurrence D_5:1469:19148: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_5_0007; voice_prefix=A30; voice_category=3; scene=D_5
#: D_5:1469
msgctxt "text_id=19148 | speaker=soujuurou"
msgid "\"...You mean you'll forget, too?\""
msgstr "「……忘れるって、蒼崎が？」"

#. Occurrence D_5:1498:19149: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0015; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:1498
msgctxt "text_id=19149 | speaker=aoko"
msgid "\"Of course. It would be pointless if I remember everything. We won't be able to make a clean break unless we both forget."
msgstr "「当然よ。アンタが忘れても、私が覚えているんじゃ意味がないでしょう。お互いが忘れなくちゃ人と人の関係は断てないわ。"

#. Occurrence D_5:1510:19150: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0016; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:1510
msgctxt "text_id=19150 | speaker=aoko"
msgid "  It makes sense when you think about it."
msgstr "　……行って来いで公平じゃない。"

#. Occurrence D_5:1517:19151: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0017; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:1517
msgctxt "text_id=19151 | speaker=aoko"
msgid "So, quit looking at me like that.\""
msgstr "なんで、そんな顔するの」"

#. Occurrence D_5:1537:19152: scene=D_5
#: D_5:1537
msgctxt "text_id=19152 | speaker=unknown"
msgid "  Soujyuro's hand shot up to cover his mouth in response."
msgstr "　言われて、草十郎は口元を手で隠した。"

#. Occurrence D_5:1542:19153: scene=D_5
#: D_5:1542
msgctxt "text_id=19153 | speaker=unknown"
msgid "  He had no idea what kind of look he had been giving her, but he had a feeling it had been pretty pathetic."
msgstr "　自分がどんな顔をしていたか判らないが、情けない顔をしている気がして。"

#. Occurrence D_5:1637:19154: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_5_0008; voice_prefix=A30; voice_category=3; scene=D_5
#: D_5:1637
msgctxt "text_id=19154 | speaker=soujuurou"
msgid "\"So we'll both forget..."
msgstr "「そうか、蒼崎も忘れるのか。"

#. Occurrence D_5:1642:19155: scene=D_5
#: D_5:1642
msgctxt "text_id=19155 | speaker=unknown"
msgid "  ..."
msgstr "　…………"

#. Occurrence D_5:1649:19156: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_5_0009; voice_prefix=A30; voice_category=3; scene=D_5
#: D_5:1649
msgctxt "text_id=19156 | speaker=soujuurou"
msgid "I wasn't expecting that.\""
msgstr "そこまでは、考えていなかった」"

#. Occurrence D_5:1655:19157: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0018; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:1655
msgctxt "text_id=19157 | speaker=aoko"
msgid "\"Yeah, so we won't see each other anymore. You never know, but most likely not.\""
msgstr "「ええ。そして、私は貴方とは会わなくなる。断定はできないけど、まず間違いなくね」"

#. Occurrence D_5:1675:19158: scene=D_5
#: D_5:1675
msgctxt "text_id=19158 | speaker=unknown"
msgid "  Thus, this would be their last conversation."
msgstr "　だから、これは最後の会話。"

#. Occurrence D_5:1680:19159: scene=D_5
#: D_5:1680
msgctxt "text_id=19159 | speaker=unknown"
msgid "  The way she spoke made it obvious, even if he had been unaware of what awaited him."
msgstr "　青子の台詞からも、お互いが忘れるという事からも、それは感じ取れた。"

#. Occurrence D_5:1700:19160: scene=D_5
#: D_5:1700
msgctxt "text_id=19160 | speaker=unknown"
msgid "  Soujyuro might see her walk by at school and feel a desire to talk,"
msgstr "　蒼崎青子は変わらず学校にいて、その後ろ姿に草十郎は<憧|あこが>れる。"

#. Occurrence D_5:1705:19161: scene=D_5
#: D_5:1705
msgctxt "text_id=19161 | speaker=unknown"
msgid "  but they would have no reason to interact."
msgstr "　けれど、その先に接点はない。"

#. Occurrence D_5:1711:19162: scene=D_5
#: D_5:1711
msgctxt "text_id=19162 | speaker=unknown"
msgid "Even if he tried to strike up a conversation, he knew she was not the type to bother much with other people."
msgstr "どんなに草十郎が話しかけても、青子は他人を必要としていないのだから。"

#. Occurrence D_5:1716:19163: scene=D_5
#: D_5:1716
msgctxt "text_id=19163 | speaker=unknown"
msgid "  More importantly, he was not the type to strike up conversations in the first place. Not the way he had been a month ago, at least."
msgstr "　……いや、そもそも自分から話しかける事が彼にはできない。少なくとも、一ヶ月前の草十郎には。"

#. Occurrence D_5:1845:19164: scene=D_5
#: D_5:1845
msgctxt "text_id=19164 | speaker=unknown"
msgid "  That was when he finally realized how cruel it could be to forget something."
msgstr "　そこでようやく、彼は忘却の<無|む><慈|じ><悲|ひ>さを知った。"

#. Occurrence D_5:1850:19165: scene=D_5
#: D_5:1850
msgctxt "text_id=19165 | speaker=unknown"
msgid "  Not only would he forget what they had done together, he would not so much as know her name or even be aware that she existed."
msgstr "　青子の事を忘れる、とは彼女との出来事を忘れるのではなく、蒼崎青子という名前、存在からして忘れる、という事だ。"

#. Occurrence D_5:1855:19166: scene=D_5
#: D_5:1855
msgctxt "text_id=19166 | speaker=unknown"
msgid "  Even if he felt strangely drawn to her, he would never understand why."
msgstr "　彼女に憧れる自分はいても、その正体を掴む事はない。"

#. Occurrence D_5:1860:19167: scene=D_5
#: D_5:1860
msgctxt "text_id=19167 | speaker=unknown"
msgid "  Even if some lucky twist of fate brought them together, things would never be the same."
msgstr "　どんなに優れた偶然が働いても、今の状況には戻れない。"

#. Occurrence D_5:1880:19168: scene=D_5
#: D_5:1880
msgctxt "text_id=19168 | speaker=unknown"
msgid "  Their walk that night was no less than a funeral for them both."
msgstr "　この夜の歩みは、互いの死を見取る<葬式|そうしき>と変わらない。"

#. Occurrence D_5:1888:19169: scene=D_5
#: D_5:1888
msgctxt "text_id=19169 | speaker=unknown"
msgid "  He would essentially kill the person he knew as Aoko Aozaki,"
msgstr "　草十郎は蒼崎青子という人物を殺して、"

#. Occurrence D_5:1893:19170: scene=D_5
#: D_5:1893
msgctxt "text_id=19170 | speaker=unknown"
msgid "  and she would kill the person she knew as Soujyuro Sizuki."
msgstr "　青子は静希草十郎という人物を殺す。"

#. Occurrence D_5:1899:19171: scene=D_5
#: D_5:1899
msgctxt "text_id=19171 | speaker=unknown"
msgid "  Afterward, nothing would remain."
msgstr "　その後に残るものは、何もない。"

#. Occurrence D_5:1968:19172: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_5_0019; voice_prefix=A10; voice_category=1; scene=D_5
#: D_5:1968
msgctxt "text_id=19172 | speaker=aoko"
msgid "\"That's why I wanted to ask. But if you don't want to talk about it, we can just go straight inside instead.\""
msgstr "「だから、その前に聞いておきたいの。嫌だっていうなら、あとはこのまま家まで直行するだけだけど」"

#. Occurrence D_5:2000:19173: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_5_0010; voice_prefix=A30; voice_category=3; scene=D_5
#: D_5:2000
msgctxt "text_id=19173 | speaker=soujuurou"
msgid "\"That would be sad."
msgstr "「それはさみしいな。"

#. Occurrence D_5:2007:19174: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_5_0011; voice_prefix=A30; voice_category=3; scene=D_5
#: D_5:2007
msgctxt "text_id=19174 | speaker=soujuurou"
msgid "Okay, I guess it's better than not talking at all. But don't blame me if it's boring.\""
msgstr "……うん、くだらない話だけど、会話がないよりはましだろう」"

#. Occurrence D_5:2100:19175: scene=D_5
#: D_5:2100
msgctxt "text_id=19175 | speaker=unknown"
msgid "  Muttering under his breath, Soujyuro set off towards the house once again."
msgstr "　呟いて、草十郎は歩きだした。"

#. Occurrence D_5:2106:19176: scene=D_5
#: D_5:2106
msgctxt "text_id=19176 | speaker=unknown"
msgid "  This time it was Aoko who matched his pace."
msgstr "　今度は青子が付き添うよう、となりに並ぶ。"

#. Occurrence D_5:2112:19177: scene=D_5
#: D_5:2112
msgctxt "text_id=19177 | speaker=unknown"
msgid "  There were only minutes left before their path came to its end."
msgstr "　道はあと数分足らずで終わろうとしている。"

#. Occurrence D_5:2118:19178: scene=D_5
#: D_5:2118
msgctxt "text_id=19178 | speaker=unknown"
msgid "  The cold air turned their breath into white puffs that hung frozen in the dark night."
msgstr "　寒さのせいでふたりの吐息は白く、暗い夜道によく残った。"

#. Occurrence D_6:42:19179: scene=D_6
#: D_6:42
msgctxt "text_id=19179 | speaker=unknown"
msgid "  Looking back on their conversation later,"
msgstr "　後になって青子は振り返る。"

#. Occurrence D_6:47:19180: scene=D_6
#: D_6:47
msgctxt "text_id=19180 | speaker=unknown"
msgid "  Aoko would think it seemed more of a confession than anything else."
msgstr "　あれは会話ではなく告解に近いもので―――"

#. Occurrence D_6:52:19181: scene=D_6
#: D_6:52
msgctxt "text_id=19181 | speaker=unknown"
msgid "  For Soujyuro, however, it was like one long, poorly told fairy tale."
msgstr "　彼にしては長く続けられた、不出来な昔話のようだったと。"

#. Occurrence D_6:87:19182: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0000; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:87
msgctxt "text_id=19182 | speaker=soujuurou"
msgid "\"Life in the mountains was nothing special."
msgstr "「山での暮らしは、別に、どうという事はない。"

msgctxt "text_id=19183 | speaker=unknown"
msgid " We were taught and did the exact same things every day."
msgstr "毎日同じ事を繰り返して、毎日同じ事を教えられた。"

#. Occurrence D_6:95:19184: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0001; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:95
msgctxt "text_id=19184 | speaker=soujuurou"
msgid "  There never was such a thing as tomorrow."
msgstr "　そこでは明日はないんだ。"

#. Occurrence D_6:103:19185: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0002; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:103
msgctxt "text_id=19185 | speaker=soujuurou"
msgid "Things started in the morning and ended when night came; the days weren't linked in any way."
msgstr "始まりが朝で、夜になれば終わる。一日は次の日には繋がらない。"

msgctxt "text_id=19186 | speaker=unknown"
msgid " So I never had any hopes or dreams about the future.\""
msgstr "だから、明日を夢見る事もない」"

#. Occurrence D_6:128:19187: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0003; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:128
msgctxt "text_id=19187 | speaker=soujuurou"
msgid "\"Looking forward to the next day was a totally foreign concept until I moved here."
msgstr "「次の日を楽しみにする、なんて言葉は、こっちに来てから知った感覚だったな。"

#. Occurrence D_6:134:19188: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0004; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:134
msgctxt "text_id=19188 | speaker=soujuurou"
msgid "  It was hard to get used to at first, and I didn't particularly even want to."
msgstr "　初めは馴染めなかったし、馴染む気もなかった。"

#. Occurrence D_6:140:19189: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0005; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:140
msgctxt "text_id=19189 | speaker=soujuurou"
msgid "  But everybody kept saying 'See you tomorrow!' with such confidence. Before I knew it, I started dreaming about tomorrow, too.\""
msgstr "　けど、みんながまた明日、と満足そうに口にする。いつのまにか、そういうものを夢見るようになっている自分がいた」"

#. Occurrence D_6:219:19190: scene=D_6
#: D_6:219
msgctxt "text_id=19190 | speaker=unknown"
msgid "  Soujyuro kept walking as he spoke."
msgstr "　歩きながら草十郎は語っていく。"

#. Occurrence D_6:224:19191: scene=D_6
#: D_6:224
msgctxt "text_id=19191 | speaker=unknown"
msgid "  He stared straight ahead as if telling his story to the night itself, not once turning to face Aoko."
msgstr "　青子には視線を向けず、前を見つめながら、夜に語りかけるように。"

#. Occurrence D_6:229:19192: scene=D_6
#: D_6:229
msgctxt "text_id=19192 | speaker=unknown"
msgid "  For her part, Aoko was utterly silent."
msgstr "　青子は沈黙に徹している。"

#. Occurrence D_6:234:19193: scene=D_6
#: D_6:234
msgctxt "text_id=19193 | speaker=unknown"
msgid "  She knew it was pointless to so much as nod or ask a question."
msgstr "　うなずきも問いかけも、今は無意味な行いだ。"

#. Occurrence D_6:255:19194: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0006; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:255
msgctxt "text_id=19194 | speaker=soujuurou"
msgid "\"One day, I woke up and got started like any other day, but then I realized someone whom I'd seen every day was suddenly gone."
msgstr "「目が覚めていつもの一日に戻って、ふと気が付くと昨日までいた誰かがいない。"

#. Occurrence D_6:261:19195: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0007; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:261
msgctxt "text_id=19195 | speaker=soujuurou"
msgid "  I asked around, and apparently they'd started feeling unwell during the night. Sometimes, people who can't sleep go out on a walk by themselves, you know?"
msgstr "　訊ねてみると、夜に体調を崩したらしい。たまにね、眠れなくなって家から出ていって、それっきりな人もいたんだ。"

#. Occurrence D_6:267:19196: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0008; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:267
msgctxt "text_id=19196 | speaker=soujuurou"
msgid "  A while later, people discovered a familiar-looking corpse at the bottom of the cliff.\""
msgstr "　見なくなってしばらくした後、崖の下で見覚えのある遺体を見付けた事もあった」"

#. Occurrence D_6:288:19197: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0009; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:288
msgctxt "text_id=19197 | speaker=soujuurou"
msgid "\"Now that I think about it, that was pretty strange..."
msgstr "「……今にして思うと、それは異常な事だ。"

#. Occurrence D_6:294:19198: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0010; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:294
msgctxt "text_id=19198 | speaker=soujuurou"
msgid "  It never would've happened if we'd all been living together, but no one was bothered by it. Maybe people didn't value each other since everyone lived on a day-to-day basis.\""
msgstr "　集まって暮らしていればそんな事にはならなかったのに、自分たちは関わらなかった。一日で完結する世界だったから、他人は必要じゃなかったのかも知れない」"

#. Occurrence D_6:383:19199: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0011; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:383
msgctxt "text_id=19199 | speaker=soujuurou"
msgid "\"There wasn't much to eat in the mountains. To avoid starvation, we often went to places most people wouldn't go. Lots of people died on the way, too.\""
msgstr "「山では食べる物も少なかった。飢えないためには、他の人がよりつけない場所に行くことが多くなる。その途中の道で、いなくなってしまう人も多かった」"

#. Occurrence D_6:404:19200: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0012; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:404
msgctxt "text_id=19200 | speaker=soujuurou"
msgid "\"No one would even dream of stealing from others in the mountains. "
msgstr "「山では、誰も他人から奪うことを考えなかった。"

#. Occurrence D_6:411:19201: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0013; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:411
msgctxt "text_id=19201 | speaker=soujuurou"
msgid "  When you're out searching for food, the only things you need to watch out for are dogs and bears, not other people."
msgstr "　口にできるものを探す時、気をくばる相手は犬だの熊だのだけで、人を気にする事はなかったんだよ。"

msgctxt "text_id=19202 | speaker=unknown"
msgid " Here things are the other way around, though."
msgstr "今は、その逆になりつつあるけど。"

#. Occurrence D_6:419:19203: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0014; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:419
msgctxt "text_id=19203 | speaker=soujuurou"
msgid "  Anyway, half our time was taken up just with that.\""
msgstr "　ともかく、生活の半分はそれだけで済んでいた」"

#. Occurrence D_6:439:19204: scene=D_6
#: D_6:439
msgctxt "text_id=19204 | speaker=unknown"
msgid "  Soujyuro continued to stare straight ahead."
msgstr "　草十郎は変わらず前を見つめている。"

#. Occurrence D_6:444:19205: scene=D_6
#: D_6:444
msgctxt "text_id=19205 | speaker=unknown"
msgid "  He did not seem troubled by his memories."
msgstr "　思い出に苦しんでいる様子はない。"

#. Occurrence D_6:449:19206: scene=D_6
#: D_6:449
msgctxt "text_id=19206 | speaker=unknown"
msgid "  To Aoko's ears, it sounded like he was describing a place no one in their right mind would want to live as if it were perfectly normal. It was almost as if he missed it."
msgstr "　青子から見ればとても人の住む環境ではないソレを、彼は当然と思っている。むしろ懐かしがってさえいるようだ。"

#. Occurrence D_6:455:19207: scene=D_6
#: D_6:455
msgctxt "text_id=19207 | speaker=unknown"
msgid "  But from that point onward, he slowly began to show more signs of distress as he spoke."
msgstr "　けれど、そこからの告白は、ゆっくりと苦悩を刻んでいった。"

#. Occurrence D_6:496:19208: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0015; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:496
msgctxt "text_id=19208 | speaker=soujuurou"
msgid "\"The other half of our time was spent learning how to defend ourselves."
msgstr "「もう半分は、まあ、身を守る手段を教わっていた。"

#. Occurrence D_6:502:19209: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0016; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:502
msgctxt "text_id=19209 | speaker=soujuurou"
msgid "  It wasn't much compared to classes at school now. They just told us to notice how our bodies move and how other animals' bodies move, and had us think about it."
msgstr "　学校の授業に比べたら些細な事だ。単に、自分の体はどう動くものなのか、生き物はどう動くものなのかを、よく見て、よく考えろと言われた。"

#. Occurrence D_6:508:19210: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0017; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:508
msgctxt "text_id=19210 | speaker=soujuurou"
msgid "  We repeated some simple drills. Kicking stones, surviving in the forest, stuff like that.\""
msgstr "　単純な反復運動だ。小石を蹴ったり森の中にこもったり、まあ、そんな意味合いのコトをやっていたんだ」"

#. Occurrence D_6:585:19211: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0018; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:585
msgctxt "text_id=19211 | speaker=soujuurou"
msgid "\"Once we got into one of those sessions, night and day no longer mattered."
msgstr "「あの決まり事がはじまると朝も夜もなかった。"

#. Occurrence D_6:591:19212: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0019; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:591
msgctxt "text_id=19212 | speaker=soujuurou"
msgid "  We didn't have the energy to notice the time of day. Sometimes you'd go a long time and realize you hadn't eaten anything for ages."
msgstr "　外の変化に気持ちを向ける余裕はなくて、ふと気が付くとずいぶん長く食事をしていない、なんてのもざらだった。"

#. Occurrence D_6:597:19213: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0020; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:597
msgctxt "text_id=19213 | speaker=soujuurou"
msgid "  I mean, we did get food eventually, so don't feel bad for us or anything.\""
msgstr "　あ、ちゃんとご<飯|はん>はもらえたよ、そういうのの後は」"

#. Occurrence D_6:618:19214: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0021; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:618
msgctxt "text_id=19214 | speaker=soujuurou"
msgid "\"I still have no idea why we did that stuff, though."
msgstr "「あれが何のためだったのかは、今でも分からない。"

#. Occurrence D_6:624:19215: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0022; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:624
msgctxt "text_id=19215 | speaker=soujuurou"
msgid "  But it definitely made living in the mountains easier, so I just accepted it as what we had to do."
msgstr "　ただ山で暮らしていくには役に立ったし、そもそもあれだって生活の一部だった。"

#. Occurrence D_6:630:19216: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0023; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:630
msgctxt "text_id=19216 | speaker=soujuurou"
msgid "  I thought that was how life was for everyone. It felt natural and even necessary to do all that training.\""
msgstr "　生きるって事はそうする事だって思ってた。こうやって息をして歩くためには、あの繰り返しは当然のものだったんだ」"

#. Occurrence D_6:674:19217: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0000; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:674
msgctxt "text_id=19217 | speaker=aoko"
msgid "\"Uh, Soujyuro?\""
msgstr "「草十郎、それは」"

#. Occurrence D_6:694:19218: scene=D_6
#: D_6:694
msgctxt "text_id=19218 | speaker=unknown"
msgid "  His tone was totally indifferent, but the strangeness of it all forced Aoko to interject."
msgstr "　草十郎は淡々と語るけれど、その異常さに青子は口を挟んでしまった。"

#. Occurrence D_6:699:19219: scene=D_6
#: D_6:699
msgctxt "text_id=19219 | speaker=unknown"
msgid "  He glanced at Aoko and nodded as if to show he knew what she was thinking."
msgstr "　彼は歩きながら、うん、とうなずいて青子にちらりと視線を移す。"

#. Occurrence D_6:746:19220: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0024; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:746
msgctxt "text_id=19220 | speaker=soujuurou"
msgid "\"I know it sounds strange. The training definitely seemed like it was for something more than just self-defense."
msgstr "「何かがおかしかったんだろう。あれは身を守る知恵じゃなくて、もっと違う用途のものだった。"

#. Occurrence D_6:752:19221: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0025; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:752
msgctxt "text_id=19221 | speaker=soujuurou"
msgid "  I have a feeling the people who sometimes disappeared actually left the mountain for some other reason.\""
msgstr "　たまにいなくなる知り合いは、山の土になったんじゃなくて、他の場所で、他の理由で消えた場合もあったんだろう」"

#. Occurrence D_6:851:19222: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0026; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:851
msgctxt "text_id=19222 | speaker=soujuurou"
msgid "\"But I never thought about any of that then."
msgstr "「でも、考える事さえなかった。"

#. Occurrence D_6:857:19223: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0027; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:857
msgctxt "text_id=19223 | speaker=soujuurou"
msgid "  I accepted it all without really knowing what was going on or having any qualms about it, without knowing whether people were even still alive."
msgstr "　精神の<隙間|すきま>を知れだの、命の勝ち負けを知れだの、意味をくみ取らないまま<鵜|う><呑|の>みにして、当然のように繰り返した。"

#. Occurrence D_6:863:19224: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0028; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:863
msgctxt "text_id=19224 | speaker=soujuurou"
msgid "  Maybe some people would judge me for what I did. I don't know."
msgstr "　それがどう評価されるものなのか、俺には分からない。"

#. Occurrence D_6:869:19225: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0029; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:869
msgctxt "text_id=19225 | speaker=soujuurou"
msgid "  But I do know one thing."
msgstr "　ただ、知らなければ。"

#. Occurrence D_6:875:19226: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0030; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:875
msgctxt "text_id=19226 | speaker=soujuurou"
msgid "  If I hadn't learned about the outside world, I probably would've stayed there without a care in the world forever.\""
msgstr "　外の事なんて知らなければ、悩むことなく、自分はそこに居続けられたと思う」"

#. Occurrence D_6:881:19227: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0001; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:881
msgctxt "text_id=19227 | speaker=aoko"
msgid "\"You would've kept living on the verge of death like that? Even though you didn't like it?\""
msgstr "「……貴方の嫌いな、生き死にの真似を続けて？」"

#. Occurrence D_6:928:19228: scene=D_6
#: D_6:928
msgctxt "text_id=19228 | speaker=unknown"
msgid "  He did not respond to her question."
msgstr "　その問いに、彼は答えなかった。"

#. Occurrence D_6:933:19229: scene=D_6
#: D_6:933
msgctxt "text_id=19229 | speaker=unknown"
msgid "  From then on, they continued walking in silence."
msgstr "　無言のまま足は進む。"

#. Occurrence D_6:938:19230: scene=D_6
#: D_6:938
msgctxt "text_id=19230 | speaker=unknown"
msgid "  Aoko could not stop thinking about all the contradictions and absurdities in what he had said."
msgstr "　……数々の矛盾、点在していた不合理を、今更ながら青子は噛みしめる。"

#. Occurrence D_6:1002:19231: scene=D_6
#: D_6:1002
msgctxt "text_id=19231 | speaker=unknown"
msgid "  The imbalance in his education, for one."
msgstr "　たとえば、この少年の教養のバランスだ。"

#. Occurrence D_6:1007:19232: scene=D_6
#: D_6:1007
msgctxt "text_id=19232 | speaker=unknown"
msgid "  His knowledge of the basics of human life was thorough, yet he knew next to nothing about modern technology."
msgstr "　文明の機器をまったく知らないくせに、基礎知識だけは持ち合わせていた。"

#. Occurrence D_6:1012:19233: scene=D_6
#: D_6:1012
msgctxt "text_id=19233 | speaker=unknown"
msgid "  He always said he was not good at socializing, but he seemed accustomed to talking and discussion."
msgstr "　今の話では人付き合いは皆無だというのに、意思の<疎通|そつう>、言葉による対話に慣れていた。"

#. Occurrence D_6:1017:19234: scene=D_6
#: D_6:1017
msgctxt "text_id=19234 | speaker=unknown"
msgid "  His upbringing could not have happened that way by chance; it was most certainly an environment purposefully constructed by some third party."
msgstr "　それは偶発的には生まれるはずのない環境、第三者の意図によって作られた<異常性|おかしさ>だ。"

#. Occurrence D_6:1037:19235: scene=D_6
#: D_6:1037
msgctxt "text_id=19235 | speaker=unknown"
msgid "  Aoko had no idea what that purpose could be, or who the third party was, though."
msgstr "　……その、第三者の意図など青子には分からない。"

#. Occurrence D_6:1042:19236: scene=D_6
#: D_6:1042
msgctxt "text_id=19236 | speaker=unknown"
msgid "  Why would anyone want to create someone with a background like Soujyuro's?"
msgstr "　彼のような人間を育てる事に何の意味があったのか。"

#. Occurrence D_6:1047:19237: scene=D_6
#: D_6:1047
msgctxt "text_id=19237 | speaker=unknown"
msgid "  Was it all part of a grander plan? Or, was there really a place deep in the mountains where it was normal to live like that?"
msgstr "　利害目的か、それとも、その山奥ではいまだに当然の<生活|ありかた>だったのか。"

#. Occurrence D_6:1069:19238: scene=D_6
#: D_6:1069
msgctxt "text_id=19238 | speaker=unknown"
msgid "  He had asked about this once in his home in the mountains, apparently."
msgstr "　彼は一度だけ、どうして、と訊ねたコトがあるらしい。"

#. Occurrence D_6:1074:19239: scene=D_6
#: D_6:1074
msgctxt "text_id=19239 | speaker=unknown"
msgid "  When he expressed his confusion, an elder had taken him aside, saying,"
msgstr "　疑問を覚えた彼に、彼を引き取った老人は、"

#. Occurrence D_6:1080:19240: scene=D_6
#: D_6:1080
msgctxt "text_id=19240 | speaker=unknown"
msgid "\"This is just how things have always been around here, boy."
msgstr "“んなもんオメエ、昔から続いているだけだろうよ。"

#. Occurrence D_6:1085:19241: scene=D_6
#: D_6:1085
msgctxt "text_id=19241 | speaker=unknown"
msgid "  There's no reason to keep doing it, but there's also no reason to stop.\""
msgstr "　続ける理由もなかったが、止める理由もなかったのさ”"

#. Occurrence D_6:1091:19242: scene=D_6
#: D_6:1091
msgctxt "text_id=19242 | speaker=unknown"
msgid "  With a laugh, the elder chose a new identity and life outside the mountains for young Soujyuro and sent him off to live on his own."
msgstr "　そう笑って、彼に<戸籍|こせき>と新生活を<見繕|みつくろ>って、山以外で<野|の><垂|た>れ死ねと見送った。"

#. Occurrence D_6:1152:19243: scene=D_6
#: D_6:1152
msgctxt "text_id=19243 | speaker=unknown"
msgid "  Aoko's home loomed at the end of their path."
msgstr "　道の終わりには、彼女の帰る場所があった。"

#. Occurrence D_6:1157:19244: scene=D_6
#: D_6:1157
msgctxt "text_id=19244 | speaker=unknown"
msgid "  It was a generic home without any real distinguishing features."
msgstr "　これといって特色のない一般家屋。"

#. Occurrence D_6:1162:19245: scene=D_6
#: D_6:1162
msgctxt "text_id=19245 | speaker=unknown"
msgid "  It seemed as if a house from town had been picked up and dropped here. One could imagine the residents were peaceful people who engaged in farming and raising animals in their spare time."
msgstr "　街にある一戸建てをそのまま持ってきて、日々の趣味として畑や家畜を育てている、あまりにも平和な家。"

#. Occurrence D_6:1168:19246: scene=D_6
#: D_6:1168
msgctxt "text_id=19246 | speaker=unknown"
msgid "  Gazing at what lay before him, Soujyuro finally opened his mouth to answer Aoko's earlier question."
msgstr "　それを視界に収めて、先ほどの少女の問いに答えようと、彼は口を開けた。"

#. Occurrence D_6:1215:19247: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0031; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1215
msgctxt "text_id=19247 | speaker=soujuurou"
msgid "\"I would have. If I'd never learned about the outside world, I would've stayed there forever. But now I know, and I can never go back."
msgstr "「自分には、できなかった。知らなければ良かったのに、知ってしまったから。"

#. Occurrence D_6:1222:19248: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0032; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1222
msgctxt "text_id=19248 | speaker=soujuurou"
msgid "Coming here made everything simple."
msgstr "その後は簡単だ。"

#. Occurrence D_6:1228:19249: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0033; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1228
msgctxt "text_id=19249 | speaker=soujuurou"
msgid "  Someone once told me that no one wants a bird that can't sing."
msgstr "　鳴けない鳥はいらないと言われた。"

#. Occurrence D_6:1234:19250: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0034; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1234
msgctxt "text_id=19250 | speaker=soujuurou"
msgid "  It's the same when you learn the truth about something you'd never questioned before. Once you know the truth, you just don't want it in your life anymore.\""
msgstr "　今まで疑いもなく出来た事を、意味を知っただけで出来なくなったものはいらないと」"

#. Occurrence D_6:1318:19251: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0035; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1318
msgctxt "text_id=19251 | speaker=soujuurou"
msgid "\"No matter how badly I want to be back in the mountains, I can't live like that anymore. There's no point even trying."
msgstr "「どんなに山にいたくても、できないのなら意味がない。"

#. Occurrence D_6:1324:19252: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0036; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1324
msgctxt "text_id=19252 | speaker=soujuurou"
msgid "  Once I learned that things meant something, I couldn't just blindly believe things anymore. That's why I left the mountains."
msgstr "　俺は意味を知った瞬間に、意味を信じるコトができなくなった。だから山を下りたんだ。"

#. Occurrence D_6:1330:19253: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0037; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1330
msgctxt "text_id=19253 | speaker=soujuurou"
msgid "  But who knows..."
msgstr "　……けれど、どうなんだろう。"

#. Occurrence D_6:1336:19254: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0038; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1336
msgctxt "text_id=19254 | speaker=soujuurou"
msgid "  That was all I'd ever known."
msgstr "　そこでは、そうする事だけが全てだった。"

#. Occurrence D_6:1342:19255: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0039; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1342
msgctxt "text_id=19255 | speaker=soujuurou"
msgid "  It was all I'd ever been taught to do."
msgstr "　そうする事だけしか教えられなかった。"

#. Occurrence D_6:1349:19256: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0040; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1349
msgctxt "text_id=19256 | speaker=soujuurou"
msgid "That's why...\""
msgstr "だから―――」"

#. Occurrence D_6:1369:19257: scene=D_6
#: D_6:1369
msgctxt "text_id=19257 | speaker=unknown"
msgid "  There had been only one problem with his life in the mountains: himself, for having questioned it."
msgstr "　間違えていたのは。"

#. Occurrence D_6:1374:19258: scene=D_6
#: D_6:1374
msgctxt "text_id=19258 | speaker=unknown"
msgid "  It was all his mistake."
msgstr "　おかしかったのは、疑いを持ってしまった自分だったのか、と。"

#. Occurrence D_6:1379:19259: scene=D_6
#: D_6:1379
msgctxt "text_id=19259 | speaker=unknown"
msgid "  He muttered as much to himself, his voice dripping with criticism."
msgstr "　自戒のように、彼の呟きは途切れていった。"

#. Occurrence D_6:1420:19260: scene=D_6
#: D_6:1420
msgctxt "text_id=19260 | speaker=unknown"
msgid "  In Aoko's opinion,"
msgstr "　……青子は思う。"

#. Occurrence D_6:1425:19261: scene=D_6
#: D_6:1425
msgctxt "text_id=19261 | speaker=unknown"
msgid "  the world he described was, in a sense, perfect."
msgstr "　彼の<棲|す>んでいた世界は、ある意味で完成していた。"

#. Occurrence D_6:1506:19262: scene=D_6
#: D_6:1506
msgctxt "text_id=19262 | speaker=unknown"
msgid "  The best environment to achieve a goal was one in which all elements extraneous to that goal had been removed."
msgstr "　一つの事柄を成立させたければ、それ以外は何もない世界を作ればいい。"

#. Occurrence D_6:1511:19263: scene=D_6
#: D_6:1511
msgctxt "text_id=19263 | speaker=unknown"
msgid "  As long as the people involved had no concept of morality, they would consider the immoral to be correct."
msgstr "　それがどんな不道徳な事でも、不道徳という概念を知らなければ、それは正義だ。"

#. Occurrence D_6:1516:19264: scene=D_6
#: D_6:1516
msgctxt "text_id=19264 | speaker=unknown"
msgid "  No; even \"correctness\" would be a foreign concept."
msgstr "　いや、そもそも正しさの観念すらない。"

#. Occurrence D_6:1522:19265: scene=D_6
#: D_6:1522
msgctxt "text_id=19265 | speaker=unknown"
msgid "  Only one thing was for sure:"
msgstr "　あるのはただ一つ。"

#. Occurrence D_6:1528:19266: scene=D_6
#: D_6:1528
msgctxt "text_id=19266 | speaker=unknown"
msgid " the world Soujyuro had come from was frozen in time."
msgstr "その世界が、あまりにも行き止まっている、という事だけ。"

#. Occurrence D_6:1548:19267: scene=D_6
#: D_6:1548
msgctxt "text_id=19267 | speaker=unknown"
msgid "  That was what made his tragedy possible."
msgstr "　……悲劇は、そこで満ち足りてしまった事だ。"

#. Occurrence D_6:1554:19268: scene=D_6
#: D_6:1554
msgctxt "text_id=19268 | speaker=unknown"
msgid "  A world of wrongdoing and mistakes"
msgstr "　その間違いだらけの世界で、"

#. Occurrence D_6:1559:19269: scene=D_6
#: D_6:1559
msgctxt "text_id=19269 | speaker=unknown"
msgid "      had created a human riddled with"
msgstr "　　　間違いだらけの人間として、"

#. Occurrence D_6:1564:19270: scene=D_6
#: D_6:1564
msgctxt "text_id=19270 | speaker=unknown"
msgid "        mistakes as well."
msgstr "　　　　こうやって残ってしまった。"

#. Occurrence D_6:1584:19271: scene=D_6
#: D_6:1584
msgctxt "text_id=19271 | speaker=unknown"
msgid "  Soujyuro understood that it was wrong, and yet he still thought it beautiful even now."
msgstr "　彼はそれを悪と知りながら、今でも美しいと感じている。"

#. Occurrence D_6:1590:19272: scene=D_6
#: D_6:1590
msgctxt "text_id=19272 | speaker=unknown"
msgid "  Regardless of what the truth behind it might have been, he considered that world perfect."
msgstr "　真相はどうあれ、彼にとって、その世界は完成していた。"

#. Occurrence D_6:1595:19273: scene=D_6
#: D_6:1595
msgctxt "text_id=19273 | speaker=unknown"
msgid "  He only blamed himself for having learned what existed outside that world."
msgstr "　悪いのは外の世界を知ってしまった自分。"

#. Occurrence D_6:1600:19274: scene=D_6
#: D_6:1600
msgctxt "text_id=19274 | speaker=unknown"
msgid "  Just earlier, he'd said that he would have been happier."
msgstr "　だって、それを知らなければ、彼は今でも幸福だったのだから。"

#. Occurrence D_6:1700:19275: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0041; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1700
msgctxt "text_id=19275 | speaker=soujuurou"
msgid "\"If I'd never learned about the outside world, I would've stayed there forever.\""
msgstr "“知らなければ、良かったのに。”"

#. Occurrence D_6:1706:19276: scene=D_6
#: D_6:1706
msgctxt "text_id=19276 | speaker=unknown"
msgid "  He surely felt the weight of the sinful words he spoke more deeply than anyone else."
msgstr "　その言葉の罪深さは、呟く本人が誰よりも。"

#. Occurrence D_6:1726:19277: scene=D_6
#: D_6:1726
msgctxt "text_id=19277 | speaker=unknown"
msgid "  That's why he still wondered:"
msgstr "　だから彼は問うたのだ。"

#. Occurrence D_6:1731:19278: scene=D_6
#: D_6:1731
msgctxt "text_id=19278 | speaker=unknown"
msgid "  What had gone awry?"
msgstr "　おかしいのは一体なんなのか。"

#. Occurrence D_6:1736:19279: scene=D_6
#: D_6:1736
msgctxt "text_id=19279 | speaker=unknown"
msgid "  Whose fault was it, really?"
msgstr "　間違っていたのは誰なのかを。"

#. Occurrence D_6:1741:19280: scene=D_6
#: D_6:1741
msgctxt "text_id=19280 | speaker=unknown"
msgid "  He did not want to answer these questions alone. He wanted her to state it clearly for him."
msgstr "　自分の言葉ではなく、少女の言葉で、明確に告発してほしかった。"

#. Occurrence D_6:1747:19281: scene=D_6
#: D_6:1747
msgctxt "text_id=19281 | speaker=unknown"
msgid "  There was a moment of silence that felt like an eternity before she spoke."
msgstr "　一瞬の、けれど<永劫|えいごう>のような思考の末、"

#. Occurrence D_6:1790:19282: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0002; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:1790
msgctxt "text_id=19282 | speaker=aoko"
msgid "\"...I can't answer those questions for you.\""
msgstr "「―――私には、答えられないわ」"

#. Occurrence D_6:1870:19283: scene=D_6
#: D_6:1870
msgctxt "text_id=19283 | speaker=unknown"
msgid "  Her reply came quietly."
msgstr "　少女は静かに、そう返答した。"

#. Occurrence D_6:1875:19284: scene=D_6
#: D_6:1875
msgctxt "text_id=19284 | speaker=unknown"
msgid "  She had an answer, but she couldn't tell him―"
msgstr "　分からない、ではなく、答えられない。"

#. Occurrence D_6:1880:19285: scene=D_6
#: D_6:1880
msgctxt "text_id=19285 | speaker=unknown"
msgid "  it was a struggle for her to tell such a bold-faced lie."
msgstr "　それは嘘を言わない彼女にとって、精一杯の回答だった。"

#. Occurrence D_6:1885:19286: scene=D_6
#: D_6:1885
msgctxt "text_id=19286 | speaker=unknown"
msgid "  The boy reflected deeply on what she said."
msgstr "　少年は深くかみしめる。"

#. Occurrence D_6:1890:19287: scene=D_6
#: D_6:1890
msgctxt "text_id=19287 | speaker=unknown"
msgid "  He knew right away that her words were coming from a place of kindness."
msgstr "　今のがどれほど優しい言葉なのか、考えるまでもないのだから。"

#. Occurrence D_6:1912:19288: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0042_0; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1912
msgctxt "text_id=19288 | speaker=soujuurou"
msgid "\"Yeah, I understand."
msgstr "「うん、そうだな。"

#. Occurrence D_6:1919:19289: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0042_1; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1919
msgctxt "text_id=19289 | speaker=soujuurou"
msgid " Now I can appreciate your kindness during those early days.\""
msgstr "君の最初の優しさが、今でよかった」"

#. Occurrence D_6:1925:19290: scene=D_6
#: D_6:1925
msgctxt "text_id=19290 | speaker=unknown"
msgid "  A pleasant look floated across his face, at which Aoko could only scowl."
msgstr "　などと、<倖|しあわ>せそうに言う草十郎を、青子はじとりと睨みつけた。"

#. Occurrence D_6:1946:19291: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0003; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:1946
msgctxt "text_id=19291 | speaker=aoko"
msgid "\"What do you mean?"
msgstr "「なによそれ。"

#. Occurrence D_6:1952:19292: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0004; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:1952
msgctxt "text_id=19292 | speaker=aoko"
msgid "  I haven't been any nicer to you than I normally am.\""
msgstr "　まるで、普段から優しくないみたいじゃない」"

#. Occurrence D_6:1958:19293: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0043; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:1958
msgctxt "text_id=19293 | speaker=soujuurou"
msgid "\"Well, you're not very nice normally, are you?\""
msgstr "「蒼崎は優しくないじゃないか」"

#. Occurrence D_6:1964:19294: scene=D_6
#: D_6:1964
msgctxt "text_id=19294 | speaker=unknown"
msgid "  She found herself unable to offer any protest against such a blunt statement."
msgstr "　きっぱりと言われて、青子は反論できなかった。"

#. Occurrence D_6:1969:19295: scene=D_6
#: D_6:1969
msgctxt "text_id=19295 | speaker=unknown"
msgid "  It was because she knew he was correct."
msgstr "　……それは、たしかに彼の言う通りで。"

#. Occurrence D_6:2041:19296: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0005; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:2041
msgctxt "text_id=19296 | speaker=aoko"
msgid "\"I... guess you're right. I'm not very nice.\""
msgstr "「……そうね。優しくなんかないわね、私」"

#. Occurrence D_6:2047:19297: scene=D_6
#: D_6:2047
msgctxt "text_id=19297 | speaker=unknown"
msgid "  Soujyuro smiled in response to her vaguely sad consent as if to say, \"Told you so.\""
msgstr "　どこか<寂|さみ>しげな青子の同意に、ほら、と草十郎は笑った。"

#. Occurrence D_6:2052:19298: scene=D_6
#: D_6:2052
msgctxt "text_id=19298 | speaker=unknown"
msgid "  His indulgent smirk arose from his sense of personal pride in the situation."
msgstr "　見守るような微笑みは、彼が誰よりも、それを誇りに思っているからだろう。"

#. Occurrence D_6:2072:19299: scene=D_6
#: D_6:2072
msgctxt "text_id=19299 | speaker=unknown"
msgid "  It was both warm-hearted and uncomfortable, causing Aoko to instantly regret her question."
msgstr "　それが気まずくて温かくて、青子はあんな質問をした事を後悔した。"

#. Occurrence D_6:2077:19300: scene=D_6
#: D_6:2077
msgctxt "text_id=19300 | speaker=unknown"
msgid "  If only she had asked about something else, something random that did not matter, then she never would have ended up in a mood like this."
msgstr "　もっと違う、なんでもない話をすれば、こんな<陰欝|いんうつ>とした気分にはならなかったのにと。"

#. Occurrence D_6:2121:19301: scene=D_6
#: D_6:2121
msgctxt "text_id=19301 | speaker=unknown"
msgid "  Only a few minutes remained until their path came to an end."
msgstr "　道は、あと数歩分もない。"

#. Occurrence D_6:2126:19302: scene=D_6
#: D_6:2126
msgctxt "text_id=19302 | speaker=unknown"
msgid "  Surrounded by a wooden fence, the house resembled an inn for passing travelers in winter."
msgstr "　木の柵に囲まれた建物は、冬の中にある<憩|いこ>いの宿に見えた。"

#. Occurrence D_6:2131:19303: scene=D_6
#: D_6:2131
msgctxt "text_id=19303 | speaker=unknown"
msgid "  The light spilling out from the window brought to mind images of a lively dinner table, quite the opposite of the current mood between the two."
msgstr "　窓からこぼれる明かりが、今の気分に逆らって食卓の<賑|にぎ>わいを想像させる。"

#. Occurrence D_6:2152:19304: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0006; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:2152
msgctxt "text_id=19304 | speaker=aoko"
msgid "\"Sorry. I shouldn't have pried.\""
msgstr "「ごめん。悪いこと聞いちゃって」"

#. Occurrence D_6:2159:19305: scene=D_6
#: D_6:2159
msgctxt "text_id=19305 | speaker=unknown"
msgid "  Aoko stopped at the entrance to the yard."
msgstr "　青子は庭の入り口で立ち止まる。"

#. Occurrence D_6:2164:19306: scene=D_6
#: D_6:2164
msgctxt "text_id=19306 | speaker=unknown"
msgid "  Did she feel compelled to apologize despite―no, because it was their last conversation?"
msgstr "　最後なのに、それとも最後だから、一度くらいは謝っておこうと思ったのか。"

#. Occurrence D_6:2169:19307: scene=D_6
#: D_6:2169
msgctxt "text_id=19307 | speaker=unknown"
msgid "  Soujyuro's only response was to shrug it off."
msgstr "　それに草十郎はいや、と答えるだけだった。"

#. Occurrence D_6:2214:19308: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0007; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:2214
msgctxt "text_id=19308 | speaker=aoko"
msgid "\"There's still a lot to talk about.\""
msgstr "「話、途中なのにね」"

#. Occurrence D_6:2220:19309: scene=D_6
#: D_6:2220
msgctxt "text_id=19309 | speaker=unknown"
msgid "  He looked up at the house they had hiked so far to reach, his breath hanging white in the air."
msgstr "　辿り着いてしまった家を見上げて、白い息をこぼす。"

#. Occurrence D_6:2225:19310: scene=D_6
#: D_6:2225
msgctxt "text_id=19310 | speaker=unknown"
msgid "  All signs of gloom were gone from Soujyuro's face as he nodded."
msgstr "　うなずく草十郎の顔に、もう<昏|くら>い<翳|かげ>りは微塵もない。"

#. Occurrence D_6:2246:19311: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0044; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:2246
msgctxt "text_id=19311 | speaker=soujuurou"
msgid "\"I think talking about it helped me reflect on the past. So I appreciate it."
msgstr "「自分も、話してみてようやく振り向けたと思う。だから蒼崎には感謝してるよ。"

#. Occurrence D_6:2252:19312: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0045; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:2252
msgctxt "text_id=19312 | speaker=soujuurou"
msgid "  Besides, it's all in the past now."
msgstr "　―――それに、これはもう終わった事だ。"

#. Occurrence D_6:2258:19313: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0046; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:2258
msgctxt "text_id=19313 | speaker=soujuurou"
msgid "  Maybe I can continue the story the next time we have a chance to talk.\""
msgstr "　続きを話すのは、また機会があった時にしよう」"

#. Occurrence D_6:2359:19314: scene=D_6
#: D_6:2359
msgctxt "text_id=19314 | speaker=unknown"
msgid "  He turned his head to face Aoko with an ephemeral smile."
msgstr "　消え入るような笑顔で、草十郎は青子と顔を向き合わせる。"

#. Occurrence D_6:2364:19315: scene=D_6
#: D_6:2364
msgctxt "text_id=19315 | speaker=unknown"
msgid "  He was his usual, nonchalant self, the same as every other day."
msgstr "　今まで通りの、何でもない静希草十郎として。"

#. Occurrence D_6:2369:19316: scene=D_6
#: D_6:2369
msgctxt "text_id=19316 | speaker=unknown"
msgid "  Aoko prayed that day would never come."
msgstr "　それが痛ましくて、そんな日がこない事を青子は祈った。"

#. Occurrence D_6:2374:19317: scene=D_6
#: D_6:2374
msgctxt "text_id=19317 | speaker=unknown"
msgid "  For her own peace of mind, but also for the wellbeing of this very unique boy."
msgstr "　自分のためと、この特異な少年のために。"

#. Occurrence D_6:2424:19318: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0008; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:2424
msgctxt "text_id=19318 | speaker=aoko"
msgid "(There probably won't be a next time.)"
msgstr "“……もっとも、そんな機会はもうこないか”"

#. Occurrence D_6:2430:19319: scene=D_6
#: D_6:2430
msgctxt "text_id=19319 | speaker=unknown"
msgid "  Then she pointed in the direction of a cave hidden by a small forest on the other side of the house."
msgstr "　そして、彼女は一軒家の更に向こう、小さな森に隠れた<洞|どう><穴|けつ>を指さした。"

#. Occurrence D_6:2477:19320: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0009; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:2477
msgctxt "text_id=19320 | speaker=aoko"
msgid "\"My grandfather's in the cave over there, so you should go see him."
msgstr "「あそこ、ちょっとした洞穴があるの。そこに祖父がいるから、行って。"

#. Occurrence D_6:2483:19321: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0010; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:2483
msgctxt "text_id=19321 | speaker=aoko"
msgid "  I actually wanted to ask about something else, but whatever. The spell will wear off at midnight anyway, right?\""
msgstr "　……ほんとはもっと違った話が聞きたかったけど。仕方ないか、魔法は十二時になるときれちゃうものだしね」"

#. Occurrence D_6:2528:19322: scene=D_6
#: D_6:2528
msgctxt "text_id=19322 | speaker=unknown"
msgid "  A sarcastic grin spread across her face as she spoke."
msgstr "　皮肉げな微笑みを浮かべて、青子はそう言った。"

#. Occurrence D_6:2534:19323: scene=D_6
#: D_6:2534
msgctxt "text_id=19323 | speaker=unknown"
msgid "  And so Soujyuro walked off, totally clueless as to what fairy tale she was referencing."
msgstr "　それがどんな童話の引用かも知らず、草十郎は歩きだす。"

#. Occurrence D_6:2540:19324: scene=D_6
#: D_6:2540
msgctxt "text_id=19324 | speaker=unknown"
msgid "  The forest felt so far from the house to Aoko that it was like a different place on earth altogether."
msgstr "　家から離れた森は遠すぎて、青子には<地上|ここ>とは別の場所のように思えた。"

#. Occurrence D_6:2545:19325: scene=D_6
#: D_6:2545
msgctxt "text_id=19325 | speaker=unknown"
msgid "  In reality it wasn't far at all, only five minutes away."
msgstr "　実際は五分もかからない、短く、手の届く距離なのに。"

#. Occurrence D_6:2566:19326: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0011; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:2566
msgctxt "text_id=19326 | speaker=aoko"
msgid "\"Farewell, Sizuki.\""
msgstr "「さよなら、静希くん」"

#. Occurrence D_6:2572:19327: scene=D_6
#: D_6:2572
msgctxt "text_id=19327 | speaker=unknown"
msgid "  She said it to herself as she watched him simply walk away without turning back."
msgstr "　振り向かずに歩いていく背中に、青子は呟きかける。"

#. Occurrence D_6:2577:19328: scene=D_6
#: D_6:2577
msgctxt "text_id=19328 | speaker=unknown"
msgid "  Though he wasn't meant to hear her words of parting, they apparently reached his ears anyway."
msgstr "　聞こえる筈のないそれを、やっぱり草十郎は聞き届けたようだ。"

#. Occurrence D_6:2584:19329: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_6_0047; voice_prefix=A30; voice_category=3; scene=D_6
#: D_6:2584
msgctxt "text_id=19329 | speaker=soujuurou"
msgid "\"Right. See you around town tomorrow.\""
msgstr "「ああ。じゃあまた明日、町の何処かで」"

#. Occurrence D_6:2590:19330: scene=D_6
#: D_6:2590
msgctxt "text_id=19330 | speaker=unknown"
msgid "  He raised his hand in farewell and then disappeared into the forest."
msgstr "　少年は片手を上げて答えると、彼方の森へと消えていった。"

#. Occurrence D_6:2716:19331: scene=D_6
#: D_6:2716
msgctxt "text_id=19331 | speaker=unknown"
msgid "  As soon as she was sure he was gone, she turned her gaze to the sky."
msgstr "　それを見届けて、青子はひとり<天|そら>を<仰|あお>ぐ。"

#. Occurrence D_6:2721:19332: scene=D_6
#: D_6:2721
msgctxt "text_id=19332 | speaker=unknown"
msgid "  That night the stars were even more beautiful than the moon."
msgstr "　今夜は月よりも星が綺麗だ。"

#. Occurrence D_6:2726:19333: scene=D_6
#: D_6:2726
msgctxt "text_id=19333 | speaker=unknown"
msgid "  He had been looking at her fondly only moments before, and now he was gone into the forest with only a brief word of parting. It did not feel real."
msgstr "　それをさっきまで懐かしそうに眺めていた人物は、嘘みたいにあっさり、別れの言葉を告げて消えていった。"

#. Occurrence D_6:2732:19334: scene=D_6
#: D_6:2732
msgctxt "text_id=19334 | speaker=unknown"
msgid "  And with that she finally understood, if a little too late to matter."
msgstr "　まったく、と青子は今更ながら納得する。"

#. Occurrence D_6:2737:19335: scene=D_6
#: D_6:2737
msgctxt "text_id=19335 | speaker=unknown"
msgid "  She understood who had truly been the strange and unusual one."
msgstr "　結局、いちばん普通じゃなかったのは誰だったのか。"

#. Occurrence D_6:2757:19336: scene=D_6
#: D_6:2757
msgctxt "text_id=19336 | speaker=unknown"
msgid "  Anyone could have ended up behaving like Soujyuro."
msgstr "　草十郎の行いは、言ってしまえば誰にだってできる事だ。"

#. Occurrence D_6:2762:19337: scene=D_6
#: D_6:2762
msgctxt "text_id=19337 | speaker=unknown"
msgid "  But not many could keep talking on and on the way he did."
msgstr "　けれど、彼の言う繰り返しを続けられる人間はそうはいない。"

#. Occurrence D_6:2767:19338: scene=D_6
#: D_6:2767
msgctxt "text_id=19338 | speaker=unknown"
msgid "  Everything he had done was now perfectly sensible in light of his former life in the mountains."
msgstr "　あんな山での生活をしていれば、たしかに、今までの出来事なんてどうという事もなかったのだろう。"

#. Occurrence D_6:2773:19339: scene=D_6
#: D_6:2773
msgctxt "text_id=19339 | speaker=unknown"
msgid "  As a Magician she was supposed to make miracles happen,"
msgstr "　自分は魔法使いだから奇跡を起こすけれど、"

#. Occurrence D_6:2778:19340: scene=D_6
#: D_6:2778
msgctxt "text_id=19340 | speaker=unknown"
msgid "  but he had arrived at a miracle of his own through the trials and tribulations of following what he considered to be common sense."
msgstr "　彼は常識を繰り返した<末|すえ>にひとつの奇跡に辿り着いて、最後に、あんな魔法を見せたのだ。"

#. Occurrence D_6:2799:19341: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_6_0012; voice_prefix=A10; voice_category=1; scene=D_6
#: D_6:2799
msgctxt "text_id=19341 | speaker=aoko"
msgid "\"I could never take down a bear with my own hands, after all.\""
msgstr "「素手で熊を倒すなんて、私にはどう転んでもできないし」"

#. Occurrence D_6:2805:19342: scene=D_6
#: D_6:2805
msgctxt "text_id=19342 | speaker=unknown"
msgid "  It was pretty impressive."
msgstr "　だから、それはすごいコトだ。"

#. Occurrence D_6:2810:19343: scene=D_6
#: D_6:2810
msgctxt "text_id=19343 | speaker=unknown"
msgid "  Soujyuro's own magic was so mundane to him that it made him depressed to talk about it, but even so..."
msgstr "　……その魔法は、彼にとって哀しいぐらい、無意味な物だったとしても。"

#. Occurrence D_6:2815:19344: scene=D_6
#: D_6:2815
msgctxt "text_id=19344 | speaker=unknown"
msgid "  It was the kind of brilliance only possessed by humans."
msgstr "　あれは確かに、人間だけが持つ輝きだった。"

#. Occurrence D_6:2875:19345: scene=D_6
#: D_6:2875
msgctxt "text_id=19345 | speaker=unknown"
msgid "  She pulled her eyes back down from the starry sky and began to walk."
msgstr "　彼女は星空から目を離して歩きだした。"

#. Occurrence D_6:2880:19346: scene=D_6
#: D_6:2880
msgctxt "text_id=19346 | speaker=unknown"
msgid "  The lights were on inside the entrance and the door was unlocked."
msgstr "　玄関の明かりはついていて、鍵はかかっていない。"

#. Occurrence D_6:2885:19347: scene=D_6
#: D_6:2885
msgctxt "text_id=19347 | speaker=unknown"
msgid "  Aoko rolled up her sleeves and checked the time―one hour left until midnight."
msgstr "　くっと服の袖をあげて時計を見ると、時刻はあと半刻で零時になろうとしていた。"

#. Occurrence D_6:2890:19348: scene=D_6
#: D_6:2890
msgctxt "text_id=19348 | speaker=unknown"
msgid "  She had just barely managed to satisfy her parents' request to visit before the end of the year."
msgstr "　……どうやら、年内に来いという両親の言いつけは守れたようだ。"

#. Occurrence D_6:2910:19349: scene=D_6
#: D_6:2910
msgctxt "text_id=19349 | speaker=unknown"
msgid "  Placing her hand on the door, she took a deep breath."
msgstr "　扉に手を掛けて、深呼吸を一度する。"

#. Occurrence D_6:2915:19350: scene=D_6
#: D_6:2915
msgctxt "text_id=19350 | speaker=unknown"
msgid "  She promptly stifled the faint affection and sadness she had been feeling."
msgstr "　それで、さっきまでの淡い未練を、彼女は綺麗に断ち切った。"

#. Occurrence D_6:2958:19351: scene=D_6
#: D_6:2958
msgctxt "text_id=19351 | speaker=unknown"
msgid "  It was her first time back in two years."
msgstr "　実家に帰ってくるのは二年ぶりだ。"

#. Occurrence D_6:2963:19352: scene=D_6
#: D_6:2963
msgctxt "text_id=19352 | speaker=unknown"
msgid "  Upon entering high school two years ago, she had begun living on her own."
msgstr "　高校に入学してから下宿を始めて、今日までの二年間。"

#. Occurrence D_6:2968:19353: scene=D_6
#: D_6:2968
msgctxt "text_id=19353 | speaker=unknown"
msgid "  How time flew by. For some reason, the memories began to race through her mind."
msgstr "　早かったといえば早くすぎたその月日は、なぜか今になって思い出のように、自分の中を走り抜けていった。"

#. Occurrence D_6:2974:19354: scene=D_6
#: D_6:2974
msgctxt "text_id=19354 | speaker=unknown"
msgid "  There she stood, one hand on the door, reflecting on the past."
msgstr "　扉に手をかけて、今までの事を思い出すのなら。"

#. Occurrence D_6:2979:19355: scene=D_6
#: D_6:2979
msgctxt "text_id=19355 | speaker=unknown"
msgid "  Once the door was open, she would be staring at her future instead."
msgstr "　扉を開ければ、これからの事を見つめる事になるのだろう。"

#. Occurrence D_6:2999:19356: scene=D_6
#: D_6:2999
msgctxt "text_id=19356 | speaker=unknown"
msgid "  Her hand holding the doorknob began to move."
msgstr "　ノブを持つ手に力をいれる。"

#. Occurrence D_6:3004:19357: scene=D_6
#: D_6:3004
msgctxt "text_id=19357 | speaker=unknown"
msgid "  She was met with the warm scene she expected, though strangely different than that of her memories."
msgstr "　……中の風景はどこか微妙に違うけれど、記憶の中で見なれた温かい風景だった。"

#. Occurrence D_6:3026:19358: scene=D_6
#: D_6:3026
msgctxt "text_id=19358 | speaker=unknown"
msgid "  It was comforting to encounter something familiar after being away for so long."
msgstr "　自分が去って、月日が経っても変わらず出迎えてくれるものがある事は、なんて幸福なんだろう。"

#. Occurrence D_6:3031:19359: scene=D_6
#: D_6:3031
msgctxt "text_id=19359 | speaker=unknown"
msgid "  And so it was with small, unspoken gratitude that Aoko returned to her home."
msgstr "　それにほんの些細な、言葉にしない小さな感謝をして、彼女は自分の家に帰ってきた。"

#. Occurrence D_6:3038:19360: scene=D_6
#: D_6:3038
msgctxt "text_id=19360 | speaker=unknown"
msgid "  Without stopping to ring the doorbell, she called out with a smile, \"I'm home!\""
msgstr "　呼び鈴も押さずに、ただいまと微笑んで。"

#. Occurrence D_7:63:19361: scene=D_7
#: D_7:63
msgctxt "text_id=19361 | speaker=unknown"
msgid "  The moment Soujyuro stepped inside, he was struck with a strange feeling of familiarity."
msgstr "　その洞穴に入った瞬間、奇妙な懐かしさに襲われた。"

#. Occurrence D_7:70:19362: scene=D_7
#: D_7:70
msgctxt "text_id=19362 | speaker=unknown"
msgid "  It was not mere nostalgia either. No, it reached further back into the past."
msgstr "　<郷愁|きょうしゅう>ではなく、もっと<前期|いぜん>の。"

#. Occurrence D_7:77:19363: scene=D_7
#: D_7:77
msgctxt "text_id=19363 | speaker=unknown"
msgid "  It was a feeling from far beyond what he could even imagine."
msgstr "　今の自分すら遠く想うほどの、<彼方|かなた>に至る懐かしさだ。"

#. Occurrence D_7:151:19364: scene=D_7
#: D_7:151
msgctxt "text_id=19364 | speaker=unknown"
msgid "  He was reminded of someone, but he could not remember whom."
msgstr "　その人物が何者であったかは、よく覚えていない。"

#. Occurrence D_7:156:19365: scene=D_7
#: D_7:156
msgctxt "text_id=19365 | speaker=unknown"
msgid "  Perhaps he was only reminded of himself, or perhaps of the old man before him now in the cavern."
msgstr "　自分と同じだったかも知れないし、老人だった気もする。"

#. Occurrence D_7:161:19366: scene=D_7
#: D_7:161
msgctxt "text_id=19366 | speaker=unknown"
msgid "  It appeared to be an old man, anyway. Soujyuro could not make out any details beyond a vague outline."
msgstr "　人らしき<輪郭|りんかく>だけがあり、その中身を判別する事はできなかった。"

#. Occurrence D_7:166:19367: scene=D_7
#: D_7:166
msgctxt "text_id=19367 | speaker=unknown"
msgid "  As far as he could tell, the figure did not seem to have anything in the way of a face capable of making expressions."
msgstr "　叶ったとしても、表現するための適切なパーツが思いつかない。"

#. Occurrence D_7:171:19368: scene=D_7
#: D_7:171
msgctxt "text_id=19368 | speaker=unknown"
msgid "  All he knew was that the smoke-like figure before him was the one Aoko called \"Grandfather.\""
msgstr "　はっきりしていたのは、その煙のような人物が、青子の言う『祖父』という事だけだった。"

#. Occurrence D_7:192:19369: voice_id=F60_D_7_0000; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:192
msgctxt "text_id=19369 | speaker=unknown"
msgid "\"I want to thank you for everything you did for my girls.\""
msgstr "「娘たちが世話になった」"

#. Occurrence D_7:199:19370: scene=D_7
#: D_7:199
msgctxt "text_id=19370 | speaker=unknown"
msgid "  Though hoarse, the old man's voice was powerful and rang throughout the cavern."
msgstr "　老人の声はしわがれていたが、張りがあり、洞穴によく響いた。"

#. Occurrence D_7:222:19371: voice_id=F60_D_7_0001; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:222
msgctxt "text_id=19371 | speaker=unknown"
msgid "\"It was fate that we would meet. Tell me, what is it you wish for?\""
msgstr "「これも縁だ。望みがあるのなら聞こう」"

#. Occurrence D_7:228:19372: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_7_0000; voice_prefix=A30; voice_category=3; scene=D_7
#: D_7:228
msgctxt "text_id=19372 | speaker=soujuurou"
msgid "\"I don't wish for anything. But there is something I'd like to ask you."
msgstr "「望みはないです。でも、訊きたい事は一つあります。"

#. Occurrence D_7:234:19373: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_7_0001; voice_prefix=A30; voice_category=3; scene=D_7
#: D_7:234
msgctxt "text_id=19373 | speaker=soujuurou"
msgid "  Why are you making those two fight each other?\""
msgstr "　……どうして、二人を争わせたんですか？」"

#. Occurrence D_7:240:19374: voice_id=F60_D_7_0002; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:240
msgctxt "text_id=19374 | speaker=unknown"
msgid "\"I cannot provide an answer to that. Theirs is a story outside my control.\""
msgstr "「それは私の外で起きた物語だ。答える事はできない」"

#. Occurrence D_7:246:19375: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_7_0002; voice_prefix=A30; voice_category=3; scene=D_7
#: D_7:246
msgctxt "text_id=19375 | speaker=soujuurou"
msgid "\"I heard you were the one responsible for it.\""
msgstr "「そうしむけたのは貴方だと聞きました」"

#. Occurrence D_7:267:19376: voice_id=F60_D_7_0003; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:267
msgctxt "text_id=19376 | speaker=unknown"
msgid "\"The stars are to blame; the two were given incompatible talents. This is simply how they respond to one another. Whenever they're together, they find a way to fight, not through any design of mine."
msgstr "「星の<巡|めぐ>りだ。あれらは相容れない才能を与えられ、あのような形でしか<交|か>み合えない人間だ。私の意図に関係なく、共に居ればどちらかが<軋|きし>みをあげた。"

#. Occurrence D_7:273:19377: voice_id=F60_D_7_0004; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:273
msgctxt "text_id=19377 | speaker=unknown"
msgid "  They used to keep enough distance to avoid conflict, though. Perhaps the things they fought over were more innocuous. Or perhaps they were very serious, in which case they must have suffered immensely."
msgstr "　だが、確かに衝突を避ける余地はあった。あれらの意志が凡庸であったか、あるいは破格のものであったのなら、多くの<不純|ふじゅん>に耐えただろう。"

#. Occurrence D_7:279:19378: voice_id=F60_D_7_0005; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:279
msgctxt "text_id=19378 | speaker=unknown"
msgid "  You value a spirit of coexistence even when you can see that it would harm you. But the girls chose not to follow that path.\""
msgstr "　君のように、自己の崩壊が見えていても、共存を尊ぶように。しかし娘たちはそれを選ばなかった」"

#. Occurrence D_7:300:19379: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_7_0003; voice_prefix=A30; voice_category=3; scene=D_7
#: D_7:300
msgctxt "text_id=19379 | speaker=soujuurou"
msgid "\"So you're putting the blame on them. Even though the reasons for their fighting all lead back to you.\""
msgstr "「彼女たちが争うのは彼女たちのせいだって言うんですね。その原因は、貴方にあるのに」"

#. Occurrence D_7:306:19380: voice_id=F60_D_7_0006; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:306
msgctxt "text_id=19380 | speaker=unknown"
msgid "\"Indeed. The girls' fighting is a reflection of their lives. I take zero responsibility for the reasons for which they do it.\""
msgstr "「そうだ。あれらの争いは、あれらの生をあらわすもの。原因と言うのなら、私などゼロに等しい」"

#. Occurrence D_7:312:19381: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_7_0004; voice_prefix=A30; voice_category=3; scene=D_7
#: D_7:312
msgctxt "text_id=19381 | speaker=soujuurou"
msgid "\"You mean there's zero physical proof of your involvement?\""
msgstr "「ゼロ……？　形が無いという事ですか」"

#. Occurrence D_7:333:19382: voice_id=F60_D_7_0007; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:333
msgctxt "text_id=19382 | speaker=unknown"
msgid "\"No. The claim is simply meaningless."
msgstr "「形ではなく、意味が無い。"

#. Occurrence D_7:339:19383: voice_id=F60_D_7_0008; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:339
msgctxt "text_id=19383 | speaker=unknown"
msgid "  When the girls were born―the only real line of causality you can draw between us―I had already left this era. They have given rise to all events since. I played no intervening role.\""
msgstr "　私という起因から起こり、娘たちが一つの<題目|いのち>を得た時点で、私は<現代|ぶたい>から消え失せた。その後の因は、常に娘たちから生じたものだ。私の介入はない」"

#. Occurrence D_7:360:19384: voice_id=F60_D_7_0009; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:360
msgctxt "text_id=19384 | speaker=unknown"
msgid "\"If either of them reaches the end of their time in this realm, or even if they both do, it matters not to me."
msgstr "「今回、どちらが時間を終わらせても、あるいは両者が終わらせても、私には無価値だった。"

#. Occurrence D_7:366:19385: voice_id=F60_D_7_0010; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:366
msgctxt "text_id=19385 | speaker=unknown"
msgid "  In fact, I have never considered that to be of importance."
msgstr "　いや、もとより無価値だ。"

#. Occurrence D_7:372:19386: voice_id=F60_D_7_0011; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:372
msgctxt "text_id=19386 | speaker=unknown"
msgid "  A life―a title deserving the value I can offer has not yet come to be."
msgstr "　私に価値を与える<題目|いのち>は、まだ生まれていない。"

#. Occurrence D_7:378:19387: voice_id=F60_D_7_0012; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:378
msgctxt "text_id=19387 | speaker=unknown"
msgid "  Whatever may happen between the two of them, it doesn't change what I have to do.\""
msgstr "　あれらがどうなろうと、やるべき事は変わらない」"

#. Occurrence D_7:399:19388: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_7_9000; voice_prefix=A30; voice_category=3; scene=D_7
#: D_7:399
msgctxt "text_id=19388 | speaker=soujuurou"
msgid "\"You mean all you care about is getting your heir, no matter whether Aoko lives or dies?\""
msgstr "「……青子が生きていても死んでいても、後継ぎを作るという事ですか」"

#. Occurrence D_7:405:19389: voice_id=F60_D_7_0013; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:405
msgctxt "text_id=19389 | speaker=unknown"
msgid "\"In a manner of speaking, yes. That's why my body has yet to disappear.\""
msgstr "「おそらく。この体が消えないのは、そういう事だ」"

#. Occurrence D_7:432:19390: scene=D_7
#: D_7:432
msgctxt "text_id=19390 | speaker=unknown"
msgid "  The steamy energy that filled the cavern made Soujyuro's head reel."
msgstr "　洞穴に充満した、蒸気のような<精気|オド>に目眩がした。"

#. Occurrence D_7:437:19391: scene=D_7
#: D_7:437
msgctxt "text_id=19391 | speaker=unknown"
msgid "  The moment Aoko and Touko were born, their grandfather seemed to have completely forgotten that they were his granddaughters."
msgstr "　この老人は、青子と橙子が生まれた瞬間に、彼女たちが孫である事を忘れたのだ。"

#. Occurrence D_7:442:19392: scene=D_7
#: D_7:442
msgctxt "text_id=19392 | speaker=unknown"
msgid "  It was hard to imagine a satisfactory Aozaki heir ever being born."
msgstr "　……正統な蒼崎の後継者は、たぶん、永遠に誕生しないだろう。"

#. Occurrence D_7:447:19393: scene=D_7
#: D_7:447
msgctxt "text_id=19393 | speaker=unknown"
msgid "  No amount of power would satisfy the old man."
msgstr "　この老人がいるかぎり、<際限|さいげん>なく新しい力は求められる。"

#. Occurrence D_7:452:19394: scene=D_7
#: D_7:452
msgctxt "text_id=19394 | speaker=unknown"
msgid "  He showed no signs of compromise or restraint."
msgstr "　そこには<妥協|だきょう>も<限界|げんかい>もない。"

#. Occurrence D_7:473:19395: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_7_0005; voice_prefix=A30; voice_category=3; scene=D_7
#: D_7:473
msgctxt "text_id=19395 | speaker=soujuurou"
msgid "\"I assume you know Aoko threw everything away for this.\""
msgstr "「青子は、そのために過去を捨てたのに？」"

#. Occurrence D_7:496:19396: scene=D_7
#: D_7:496
msgctxt "text_id=19396 | speaker=unknown"
msgid "  There was nothing but silence."
msgstr "　沈黙があった。"

#. Occurrence D_7:502:19397: scene=D_7
#: D_7:502
msgctxt "text_id=19397 | speaker=unknown"
msgid "However, this short moment of quiet would occur only once."
msgstr "ただ一度だけの、短い沈黙。"

#. Occurrence D_7:507:19398: scene=D_7
#: D_7:507
msgctxt "text_id=19398 | speaker=unknown"
msgid "  The unreadable outline of the old man grew blurrier still."
msgstr "　不確かな人物像は、その輪郭さえぼやけていく。"

#. Occurrence D_7:528:19399: scene=D_7
#: D_7:528
msgctxt "text_id=19399 | speaker=unknown"
msgid "  Long ago..."
msgstr "　―――昔。"

#. Occurrence D_7:534:19400: scene=D_7
#: D_7:534
msgctxt "text_id=19400 | speaker=unknown"
msgid "  a child wandered into the cave, her karma empty."
msgstr "　因の切れた幼子が、この洞穴に入ってきた事がある。"

#. Occurrence D_7:539:19401: scene=D_7
#: D_7:539
msgctxt "text_id=19401 | speaker=unknown"
msgid "  The old man automatically granted her request born from innocence and ignorance."
msgstr "　<無|む><知|ち>、<無|む><垢|く>から生まれた願いを、老人は自動的に叶えてやった。"

#. Occurrence D_7:544:19402: scene=D_7
#: D_7:544
msgctxt "text_id=19402 | speaker=unknown"
msgid "  He was a Magician who had given up his ego in order to extend his own lifespan, and he did whatever he could to help the child."
msgstr "　老人は長く残るために自我を失った魔法使いで、そのとき自分にできる事なら、なんでも叶えてしまうのだ。"

#. Occurrence D_7:558:19403: scene=D_7
#: D_7:558
msgctxt "text_id=19403 | speaker=unknown"
msgid "  It had been an incredible coincidence to happen that day."
msgstr "　そしてあの日は、何もかもが符合しすぎていた。"

#. Occurrence D_7:600:19404: scene=D_7
#: D_7:600
msgctxt "text_id=19404 | speaker=unknown"
msgid "  Faced with the sin that she had invited, the child had glared at the old man with tear-filled eyes."
msgstr "　<自|みずか>らが<招|まね>いた罪を見て、<幼子|おさなご>は瞳にいっぱいの涙をためて、老人を睨みつけた。"

#. Occurrence D_7:605:19405: scene=D_7
#: D_7:605
msgctxt "text_id=19405 | speaker=unknown"
msgid "  \"Everything will be lost. It will happen, completely and without warning, thanks to the failure of a nobody―thanks to you,\" he had declared."
msgstr "　全ては失われる。誰でもいい貴方の失敗一つで、前置きもなく、あっさりと。"

#. Occurrence D_7:610:19406: scene=D_7
#: D_7:610
msgctxt "text_id=19406 | speaker=unknown"
msgid "  The child threw a tantrum at how unfair it all was."
msgstr "　幼子はその不条理に<癇癪|かんしゃく>を起こした。"

#. Occurrence D_7:615:19407: scene=D_7
#: D_7:615
msgctxt "text_id=19407 | speaker=unknown"
msgid "  The Magician claimed that was merely the way of the world. "
msgstr "　世界なんてそんなもんじゃぞ、と嘆息する魔法使いに、"

#. Occurrence D_7:615:19408: scene=D_7
#: D_7:615
msgctxt "text_id=19408 | speaker=unknown"
msgid "  The child stood up to him. \"Shut up, old man.\""
msgstr "“ジジイ、うるさい”と真っ向から立ち向かった。"

#. Occurrence D_7:632:19409: scene=D_7
#: D_7:632
msgctxt "text_id=19409 | speaker=unknown"
msgid "  And then..."
msgstr "　そして―――"

#. Occurrence D_7:667:19410: scene=D_7
#: D_7:667
msgctxt "text_id=19410 | speaker=unknown"
msgid "  Yes, and then,"
msgstr "　―――そう、そして。"

#. Occurrence D_7:672:19411: scene=D_7
#: D_7:672
msgctxt "text_id=19411 | speaker=unknown"
msgid "  the child ran around in tears trying to make the old man pay for the cost of a life, at the cost of all lives."
msgstr "　一つの命と全ての命を、同じものとして<償|つぐな>ってみせると、泣きながら走り出した。"

#. Occurrence D_7:733:19412: voice_id=F60_D_7_0014; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:733
msgctxt "text_id=19412 | speaker=unknown"
msgid "\"You're mistaken, boy.\""
msgstr "「それは間違いだ、少年」"

#. Occurrence D_7:741:19413: scene=D_7
#: D_7:741
msgctxt "text_id=19413 | speaker=unknown"
msgid "  Perhaps that's how it happened."
msgstr "　……あの時、あるいは。"

#. Occurrence D_7:751:19414: voice_id=F60_D_7_0015; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:751
msgctxt "text_id=19414 | speaker=unknown"
msgid "\"She didn't throw anything away."
msgstr "「捨てたのではない。"

#. Occurrence D_7:758:19415: voice_id=F60_D_7_0016; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:758
msgctxt "text_id=19415 | speaker=unknown"
msgid "She lives to make her past more beautiful.\""
msgstr "<過|そ><去|れ>を美しくする為に、アレは生きているのだ」"

#. Occurrence D_7:767:19416: scene=D_7
#: D_7:767
msgctxt "text_id=19416 | speaker=unknown"
msgid "  That role had likely come to an end long ago, however."
msgstr "　<己|そ>の役割は、とうに終わっていたのかも知れないが。"

#. Occurrence D_7:787:19417: scene=D_7
#: D_7:787
msgctxt "text_id=19417 | speaker=unknown"
msgid "  The old man's appearance seemed to change before Soujyuro's eyes."
msgstr "　老人の姿は青年に変わって見えた。"

#. Occurrence D_7:792:19418: scene=D_7
#: D_7:792
msgctxt "text_id=19418 | speaker=unknown"
msgid "  For just a brief moment, he wavered in the air as if in a haze."
msgstr "　ほんの一瞬だけの、陽炎のような揺らぎだった。"

#. Occurrence D_7:848:19419: voice_id=F60_D_7_0017; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:848
msgctxt "text_id=19419 | speaker=unknown"
msgid "\"Let me correct your error. The girls understand me very well. In fact, I think they understand me better than I do myself."
msgstr "「君の過ちを正そう。娘たちは、私という物をよく解っている。ともすれば、私本人より理解しているとも言える。"

#. Occurrence D_7:854:19420: voice_id=F60_D_7_0018; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:854
msgctxt "text_id=19420 | speaker=unknown"
msgid "  I am not concerned with who they are, and likewise, they don't appreciate who I am."
msgstr "　私が娘たちの人格を考慮せぬように、娘たちもまた、私という物の人格を認めていない。"

#. Occurrence D_7:860:19421: voice_id=F60_D_7_0019; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:860
msgctxt "text_id=19421 | speaker=unknown"
msgid "  I doubt thoughts of my absence have ever crossed their minds.\""
msgstr "　祖父さえいなかったのなら、という考えさえないだろう」"

#. Occurrence D_7:881:19422: voice_id=F60_D_7_0020; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:881
msgctxt "text_id=19422 | speaker=unknown"
msgid "\"They've always been so proud in all their fighting, unwilling to debase themselves."
msgstr "「あれらはそもそも、争いあう自分たちを一度も<卑|ひ><下|げ>はしない筈だ。"

#. Occurrence D_7:888:19423: voice_id=F60_D_7_0021; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:888
msgctxt "text_id=19423 | speaker=unknown"
msgid "It's cruel to expect you to deal with all that, though."
msgstr "君に、その関係を解れというのは酷だろうが。"

#. Occurrence D_7:894:19424: voice_id=F60_D_7_0022; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:894
msgctxt "text_id=19424 | speaker=unknown"
msgid "  You seem to be through asking questions now."
msgstr "　訊ね事は終わったようだ。"

#. Occurrence D_7:900:19425: voice_id=F60_D_7_0023; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:900
msgctxt "text_id=19425 | speaker=unknown"
msgid "  It's my turn."
msgstr "　次は私の番だ。"

#. Occurrence D_7:906:19426: voice_id=F60_D_7_0024; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:906
msgctxt "text_id=19426 | speaker=unknown"
msgid "  What is your name?\""
msgstr "　君の名前を知りたい」"

#. Occurrence D_7:942:19427: scene=D_7
#: D_7:942
msgctxt "text_id=19427 | speaker=unknown"
msgid "  Soujyuro answered the old man's question."
msgstr "　老人の問いに答える。"

#. Occurrence D_7:952:19428: scene=D_7
#: D_7:952
msgctxt "text_id=19428 | speaker=unknown"
msgid "  The smoky face seemed to frown, quivering ever so slightly."
msgstr "　煙は顔をしかめるように、かすかに揺らいでいた。"

#. Occurrence D_7:973:19429: voice_id=F60_D_7_0025; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:973
msgctxt "text_id=19429 | speaker=unknown"
msgid "\"How unexpected. You say you're all alone, and yet the meaning of your name implies the existence of multiple, bearing the character for 'ten.'"
msgstr "「……意外だ。君は孤立しているというのに、複数を示す名が付いているとは思わなかった。"

#. Occurrence D_7:979:19430: voice_id=F60_D_7_0026; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:979
msgctxt "text_id=19430 | speaker=unknown"
msgid "  It doesn't suit you. No, not at all."
msgstr "　似合わん。まったく、似合わん。"

#. Occurrence D_7:985:19431: voice_id=F60_D_7_0027; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:985
msgctxt "text_id=19431 | speaker=unknown"
msgid "  But I think it is correct. When in a place of imbalance, one needs an imbalanced name to match."
msgstr "　だが、そちらでは正しい事だ。不釣り合いな場所にいるのなら、不釣り合いな名が必要だろう。"

#. Occurrence D_7:991:19432: voice_id=F60_D_7_0028; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:991
msgctxt "text_id=19432 | speaker=unknown"
msgid "  Rare, yes, but also worthless."
msgstr "　稀少ではあるが、やはり無価値だ。"

#. Occurrence D_7:997:19433: voice_id=F60_D_7_0029; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:997
msgctxt "text_id=19433 | speaker=unknown"
msgid "  Resigning oneself to affirmation stems from a will to die. A one-time talent in a single generation means nothing if there is no one to continue the family line.\""
msgstr "　全てを肯定する<諦|あきら>めは死に<由来|ゆらい>するものだろう。続くものがない以上、一代かぎりの才能は無価値だ」"

#. Occurrence D_7:1052:19434: voice_id=F60_D_7_0030; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:1052
msgctxt "text_id=19434 | speaker=unknown"
msgid "\"I was interested in the way you were able to influence Aoko... but ultimately, you did not meet expectations."
msgstr "「―――<青子|アレ>の行く末に影響を与えた君に興味を持ったが、失望した。"

#. Occurrence D_7:1058:19435: voice_id=F60_D_7_0031; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:1058
msgctxt "text_id=19435 | speaker=unknown"
msgid "  It seems the time was spent for nothing."
msgstr "　無駄な時間を過ごしたようだ。"

#. Occurrence D_7:1064:19436: voice_id=F60_D_7_0032; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:1064
msgctxt "text_id=19436 | speaker=unknown"
msgid "  You are bound together for the time being, but it is inevitable that you will go your separate ways."
msgstr "　今は結ばれているが、いずれ離れていくのは変えようのない結末だ。"

#. Occurrence D_7:1070:19437: voice_id=F60_D_7_0033; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:1070
msgctxt "text_id=19437 | speaker=unknown"
msgid "  Now, begone."
msgstr "　では立ち去りたまえ。"

#. Occurrence D_7:1076:19438: voice_id=F60_D_7_0034; voice_prefix=F60; voice_category=0; scene=D_7
#: D_7:1076
msgctxt "text_id=19438 | speaker=unknown"
msgid "  I have no use for the dead. We will not meet again.\""
msgstr "　私は死者に用はない。二度と会う事はないだろう」"

#. Occurrence D_7:1109:19439: scene=D_7
#: D_7:1109
msgctxt "text_id=19439 | speaker=unknown"
msgid "  Everything grew blurry."
msgstr "　風景が霞んでいく。"

#. Occurrence D_7:1115:19440: scene=D_7
#: D_7:1115
msgctxt "text_id=19440 | speaker=unknown"
msgid "  Soujyuro's memories began to fade."
msgstr "　記憶が薄れていく。"

#. Occurrence D_7:1122:19441: scene=D_7
#: D_7:1122
msgctxt "text_id=19441 | speaker=unknown"
msgid "  It had been a conversation without any answers..."
msgstr "　答えのなかった会話。"

#. Occurrence D_7:1128:19442: scene=D_7
#: D_7:1128
msgctxt "text_id=19442 | speaker=unknown"
msgid "  an encounter without any significance, now vanished completely like a dream."
msgstr "　意義のなかった時間のあと、全ては夢のように霧散した。"

#. Occurrence D_8:59:19443: scene=D_8
#: D_8:59
msgctxt "text_id=19443 | speaker=unknown"
msgid "  The air was cold, the sky beautiful."
msgstr "　夜気は寒くて、空は綺麗だった。"

#. Occurrence D_8:64:19444: scene=D_8
#: D_8:64
msgctxt "text_id=19444 | speaker=unknown"
msgid "  The evening sky at the end of each day looked different from the last."
msgstr "　一日の終わりに<映|うつ>る光景は、けれど、一日だって同じ事はない。"

#. Occurrence D_8:69:19445: scene=D_8
#: D_8:69
msgctxt "text_id=19445 | speaker=unknown"
msgid "  Each sunset could be seen for one day, and one day only."
msgstr "　今日の景色は今日だけの物だ。"

#. Occurrence D_8:74:19446: scene=D_8
#: D_8:74
msgctxt "text_id=19446 | speaker=unknown"
msgid "  Though the sky may not look dramatically different to the human eye from one day to the next,"
msgstr "　人の知覚では大差のない風景にしか映らなくても、"

#. Occurrence D_8:79:19447: scene=D_8
#: D_8:79
msgctxt "text_id=19447 | speaker=unknown"
msgid "  every day we wake up a new person and forget the beautiful sights, the moments of heartbreak, and all the other fleeting feelings that seemed so real the day before."
msgstr "　その時の風景の美しさも、ありのままに感じる傷心も、すべてが<儚|はかな>くて、明日は違った自分で目が覚める。"

#. Occurrence D_8:99:19448: scene=D_8
#: D_8:99
msgctxt "text_id=19448 | speaker=unknown"
msgid "  Simple statements such as these felt all the more profound in the still air of the mountains, more bone-piercing than the winter cold itself."
msgstr "　山の閑散とした空気の中では、そんなあたり前の事が冬の寒さよりずっと、体に沁みこんでくるようだった。"

#. Occurrence D_8:105:19449: scene=D_8
#: D_8:105
msgctxt "text_id=19449 | speaker=unknown"
msgid "  Soujyuro stared up at the sky as if he'd forgotten when and where he was."
msgstr "　彼は時を忘れたように空を見上げている。"

#. Occurrence D_8:110:19450: scene=D_8
#: D_8:110
msgctxt "text_id=19450 | speaker=unknown"
msgid "  Aoko's look of stunned surprise brought him back to the present."
msgstr "　それを止めたのは、呆然と立ち尽くす青子の視線だった。"

#. Occurrence D_8:131:19451: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0000; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:131
msgctxt "text_id=19451 | speaker=soujuurou"
msgid "\"Aozaki. That was fast.\""
msgstr "「なんだ。早かったな、蒼崎」"

#. Occurrence D_8:179:19452: scene=D_8
#: D_8:179
msgctxt "text_id=19452 | speaker=unknown"
msgid "  Soujyuro turned to face Aoko, who had only just stepped outside her family's yard."
msgstr "　庭から出てきたばかりの青子に向けて、草十郎は話しかけた。"

#. Occurrence D_8:212:19453: scene=D_8
#: D_8:212
msgctxt "text_id=19453 | speaker=unknown"
msgid "  At first she had been too shocked to move or speak, but she quickly regained her composure and marched forward."
msgstr "　青子は言葉もなく立ち尽くしていたけれど、すぐに気を取り直してつかつかと歩きだした。"

#. Occurrence D_8:224:19454: scene=D_8
#: D_8:224
msgctxt "text_id=19454 | speaker=unknown"
msgid "  She continued until she was standing right before him, with an intense scowl on her face."
msgstr "　そのまま草十郎の前まで行くと、じろりとした目で睨む。"

#. Occurrence D_8:229:19455: scene=D_8
#: D_8:229
msgctxt "text_id=19455 | speaker=unknown"
msgid "  Soujyuro slouched instinctively, bracing for impact."
msgstr "　こんなヤツ認めない、と言わんばかりの視線の激しさに、草十郎は肩をすくめた。"

#. Occurrence D_8:234:19456: scene=D_8
#: D_8:234
msgctxt "text_id=19456 | speaker=unknown"
msgid "  He had not the slightest idea what could have made her so angry."
msgstr "　青子がどうしてこんなに怒っているか、草十郎にはまったく見当がつかない。"

#. Occurrence D_8:281:19457: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0000; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:281
msgctxt "text_id=19457 | speaker=aoko"
msgid "\"What are you still doing here?\""
msgstr "「……なんで、まだここにいるのよ」"

#. Occurrence D_8:287:19458: scene=D_8
#: D_8:287
msgctxt "text_id=19458 | speaker=unknown"
msgid "(After I finally managed to convince myself that things were over.)"
msgstr "“……自分は、なんとか割り切ったのに”"

#. Occurrence D_8:293:19459: scene=D_8
#: D_8:293
msgctxt "text_id=19459 | speaker=unknown"
msgid "  She was obviously irritated with him, in any case. The anger would have to subside before she could decide whether she was happy or sad to see him."
msgstr "　それなのに、この男が目の前にいるコトが青子には憎らしかったらしい。喜ぶべき事なのか悲しむべき事なのかを考えるのは、たぶん、その怒りが治まってからだろう。"

#. Occurrence D_8:298:19460: scene=D_8
#: D_8:298
msgctxt "text_id=19460 | speaker=unknown"
msgid "  Humans get angry when things do not go the way they had hoped."
msgstr "　人間、思い通りにいかないと無性に腹が立つものなのだ。"

#. Occurrence D_8:319:19461: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0001; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:319
msgctxt "text_id=19461 | speaker=aoko"
msgid "\"It's hardly been more than ten minutes."
msgstr "「さっきから十分と二十秒も経ってない。"

#. Occurrence D_8:325:19462: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0002; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:325
msgctxt "text_id=19462 | speaker=aoko"
msgid "  How can you be standing here?\""
msgstr "　なんでこんなところで突っ立ってるのよ、アンタ」"

#. Occurrence D_8:331:19463: scene=D_8
#: D_8:331
msgctxt "text_id=19463 | speaker=unknown"
msgid "  It was supposed to have taken an entire day for her grandfather to erase his memories from the past month."
msgstr "　いかに祖父といえど、記憶を消去して空白の一ヶ月をつなげるのには一日を要する筈だ。"

#. Occurrence D_8:336:19464: scene=D_8
#: D_8:336
msgctxt "text_id=19464 | speaker=unknown"
msgid "  She had been planning to let her grandfather handle all the details, and yet here Soujyuro was, staring dumbly at the sky."
msgstr "　だからあとの処置はぜんぶ祖父に任せようと思ったのに、草十郎はここでぼんやりと空を見上げていた。"

#. Occurrence D_8:356:19465: scene=D_8
#: D_8:356
msgctxt "text_id=19465 | speaker=unknown"
msgid "(He's no astrologer. He just likes looking at the night sky.)"
msgstr "“……<祈祷師|きとうし>じゃあるまいし、ほんと、夜空を見上げるのが好きな奴”"

#. Occurrence D_8:362:19466: scene=D_8
#: D_8:362
msgctxt "text_id=19466 | speaker=unknown"
msgid "  Bombarded with Aoko's unspoken emotion, he proceeded to explain himself."
msgstr "　そんな青子の、口にはしない一方的な感情をぶつけられながら、草十郎は事情を説明する。"

#. Occurrence D_8:413:19467: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0001; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:413
msgctxt "text_id=19467 | speaker=soujuurou"
msgid "\"He gave me a message for you."
msgstr "「……あの老人からの伝言だけど。"

#. Occurrence D_8:419:19468: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0002; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:419
msgctxt "text_id=19468 | speaker=soujuurou"
msgid "  He said you shouldn't go around asking other people to erase my memories. You should do it yourself. Apparently he wanted me to come just to have someone to complain to.\""
msgstr "　記憶の消去は君の役目で、人に頼るな、だそうだ。今日呼ばれたのは、たんに悪口を聞かせたかっただけらしいよ」"

#. Occurrence D_8:431:19469: scene=D_8
#: D_8:431
msgctxt "text_id=19469 | speaker=unknown"
msgid "  Hearing this, Aoko finally began to feel like herself again."
msgstr "　その言葉で青子の憑き物は落ちた。"

#. Occurrence D_8:436:19470: scene=D_8
#: D_8:436
msgctxt "text_id=19470 | speaker=unknown"
msgid "  Despite having been ready to dish out the punishment only a few moments earlier, she now felt quite calm."
msgstr "　今にも平手打ちが飛んできそうな態度が、すう、と落ち着いたものになる。"

#. Occurrence D_8:463:19471: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0003; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:463
msgctxt "text_id=19471 | speaker=aoko"
msgid "\"Huh."
msgstr "「……そっか。"

#. Occurrence D_8:463:19472: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0003; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:463
msgctxt "text_id=19472 | speaker=aoko"
msgid "  Well, he's right that it's not like me to expect someone else to clean up my messes.\""
msgstr "　人に任せるなんて、たしかに私らしくなかった」"

#. Occurrence D_8:469:19473: scene=D_8
#: D_8:469
msgctxt "text_id=19473 | speaker=unknown"
msgid "  The intense look in her eyes slowly faded to her usual mildly irritated expression."
msgstr "　きびしかった瞳が、段々といつもの、不機嫌そうな顔になっていく。"

#. Occurrence D_8:494:19474: scene=D_8
#: D_8:494
msgctxt "text_id=19474 | speaker=unknown"
msgid "  It relieved Soujyuro to see her like this."
msgstr "　ホッと安堵する草十郎。"

#. Occurrence D_8:499:19475: scene=D_8
#: D_8:499
msgctxt "text_id=19475 | speaker=unknown"
msgid "  She was finally back to her normal self."
msgstr "　ご機嫌は、なんとか戻ってくれたようだ。"

#. Occurrence D_8:537:19476: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0003; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:537
msgctxt "text_id=19476 | speaker=soujuurou"
msgid "\"If that's enough for you, then let's get going."
msgstr "「納得いったなら、行こう。"

#. Occurrence D_8:543:19477: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0004; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:543
msgctxt "text_id=19477 | speaker=soujuurou"
msgid "  We'll miss the last train if we don't hurry.\""
msgstr "　急がないと最終電車に間に合わない」"

#. Occurrence D_8:564:19478: scene=D_8
#: D_8:564
msgctxt "text_id=19478 | speaker=unknown"
msgid "  With that he walked off without waiting for an answer."
msgstr "　返事を待たず草十郎は歩きだした。"

#. Occurrence D_8:569:19479: scene=D_8
#: D_8:569
msgctxt "text_id=19479 | speaker=unknown"
msgid "  Aoko stared at his retreating figure for a brief moment before quietly cursing him under her breath and following after him."
msgstr "　青子はその背中を少しの間だけ見つめてから、小言を言いつつ付いていく。"

#. Occurrence D_8:645:19480: scene=D_8
#: D_8:645
msgctxt "text_id=19480 | speaker=unknown"
msgid "  Their descent back to the station was much easier than the way there."
msgstr "　帰り道は、来る時より楽だった。"

#. Occurrence D_8:650:19481: scene=D_8
#: D_8:650
msgctxt "text_id=19481 | speaker=unknown"
msgid "  A sheet of darkness spread out below them."
msgstr "　眼下の景色は一面の闇。"

#. Occurrence D_8:655:19482: scene=D_8
#: D_8:655
msgctxt "text_id=19482 | speaker=unknown"
msgid "  There in the middle of that ocean of black was a single light: the tiny, glowing station."
msgstr "　その黒い海の中、灯台のように、小さな駅が輝いている。"

#. Occurrence D_8:675:19483: scene=D_8
#: D_8:675
msgctxt "text_id=19483 | speaker=unknown"
msgid "  They walked for some time in silence."
msgstr "　ふたりはしばらく、言葉もなく歩いていた。"

#. Occurrence D_8:680:19484: scene=D_8
#: D_8:680
msgctxt "text_id=19484 | speaker=unknown"
msgid "  Aoko recalled their earlier conversation and felt she had been too naive."
msgstr "　青子は来る時の会話を思い出して、若かったなぁ、と反省中。"

#. Occurrence D_8:685:19485: scene=D_8
#: D_8:685
msgctxt "text_id=19485 | speaker=unknown"
msgid "  She should have avoided all the serious stuff if this was how things were going to end up."
msgstr "　こんな事なら、あんなしんみりとした話をするんじゃなかった、と照れている。"

#. Occurrence D_8:705:19486: scene=D_8
#: D_8:705
msgctxt "text_id=19486 | speaker=unknown"
msgid "  Soujyuro, meanwhile, was thinking of nothing at all, just like usual."
msgstr "　一方の草十郎は、いつも通り、何も考えてはいなかった。"

#. Occurrence D_8:710:19487: scene=D_8
#: D_8:710
msgctxt "text_id=19487 | speaker=unknown"
msgid "  For him the silence felt quite natural, while for her it was awkwardly uncomfortable."
msgstr "　草十郎にとっては普通の、青子にとっては気まずい沈黙。"

#. Occurrence D_8:715:19488: scene=D_8
#: D_8:715
msgctxt "text_id=19488 | speaker=unknown"
msgid "  Suddenly Soujyuro blurted out the strangest thing without thinking."
msgstr "　そんな中、不意に草十郎はおかしな事を言いだした。"

#. Occurrence D_8:789:19489: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0005; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:789
msgctxt "text_id=19489 | speaker=soujuurou"
msgid "\"We should pick up some mochi for Alice on the way back.\""
msgstr "「有珠には、お<餅|もち>を買っていってあげよう」"

#. Occurrence D_8:854:19490: scene=D_8
#: D_8:854
msgctxt "text_id=19490 | speaker=unknown"
msgid "  Aoko's eyes grew wide, her pupils reduced to mere points."
msgstr "　目を点にする青子。"

#. Occurrence D_8:902:19491: scene=D_8
#: D_8:902
msgctxt "text_id=19491 | speaker=unknown"
msgid "  Aoko had so many questions going around in her head she wanted to rail at the paradox that was Soujyuro."
msgstr "　この男はいったいなんなんだろう、という不満とか疑問がありありと浮かんでいる。"

#. Occurrence D_8:964:19492: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0004; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:964
msgctxt "text_id=19492 | speaker=aoko"
msgid "\"Mochi? Why?\""
msgstr "「お餅が、なに……？」"

#. Occurrence D_8:1011:19493: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0006; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:1011
msgctxt "text_id=19493 | speaker=soujuurou"
msgid "\"As a gift. We left her all alone at the mansion, we should do something nice for her. It'll make her happy.\""
msgstr "「お土産。有珠、ひとりで待っているんだから、喜ぶと思う」"

#. Occurrence D_8:1048:19494: scene=D_8
#: D_8:1048
msgctxt "text_id=19494 | speaker=unknown"
msgid "  Aoko raised her hand to her head in concern."
msgstr "　うーん、と青子は難しそうに口に手をあてた。"

#. Occurrence D_8:1053:19495: scene=D_8
#: D_8:1053
msgctxt "text_id=19495 | speaker=unknown"
msgid "  Unprotected by the warmth of a pair of gloves, her slender fingers were white from the cold."
msgstr "　手袋をしていない細い指が、寒さで白く染まっている。"

#. Occurrence D_8:1074:19496: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0005; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:1074
msgctxt "text_id=19496 | speaker=aoko"
msgid "(I don't think she'll be happy, but maybe coming from Soujyuro it'll be okay...?)"
msgstr "“……あの娘にはそういうの逆効果だけど、草十郎がやるぶんには大丈夫か……”"

#. Occurrence D_8:1079:19497: scene=D_8
#: D_8:1079
msgctxt "text_id=19497 | speaker=unknown"
msgid "  His seemingly selfless attitude came in handy sometimes."
msgstr "　見るからに無欲という彼の雰囲気は、こういう<時|とき>便利だ。"

#. Occurrence D_8:1084:19498: scene=D_8
#: D_8:1084
msgctxt "text_id=19498 | speaker=unknown"
msgid "  Alice would most likely accept his gift without making a scene."
msgstr "　有珠も素直に厚意を受け取る公算<大|だい>である。"

#. Occurrence D_8:1105:19499: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0006; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:1105
msgctxt "text_id=19499 | speaker=aoko"
msgid "\"Gotcha. She's the type to resent something like that and hold a silent grudge over it, though."
msgstr "「そうね。たしかに有珠はこういうの根にもって、口に出さずに恨んでる<性質|たち>だけど。"

#. Occurrence D_8:1111:19500: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0007; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:1111
msgctxt "text_id=19500 | speaker=aoko"
msgid "  Why does the gift have to be mochi, anyway?\""
msgstr "　また、なんだってお土産がお餅なの？」"

#. Occurrence D_8:1117:19501: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0007; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:1117
msgctxt "text_id=19501 | speaker=soujuurou"
msgid "\"Well, I get the feeling she's never eaten one before.\""
msgstr "「だって、食べた事なさそうだろ、彼女」"

#. Occurrence D_8:1155:19502: scene=D_8
#: D_8:1155
msgctxt "text_id=19502 | speaker=unknown"
msgid "  All Aoko could do in response to such a simpleminded observation was nod in agreement."
msgstr "　あっさりと返答されて、青子はたしかに、と同意してしまった。"

#. Occurrence D_8:1160:19503: scene=D_8
#: D_8:1160
msgctxt "text_id=19503 | speaker=unknown"
msgid "  The image of Alice eating mochi popped into her head and suddenly the prospect of getting back to the mansion felt a little more exciting."
msgstr "　有珠がお餅を食べている姿をつい想像し、とたんに帰るのが楽しみになってくる。"

#. Occurrence D_8:1190:19504: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0008; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:1190
msgctxt "text_id=19504 | speaker=aoko"
msgid "\"You really are a regular space cadet, you know that?"
msgstr "「アンタって本当に無心よね。"

#. Occurrence D_8:1205:19505: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0009; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:1205
msgctxt "text_id=19505 | speaker=aoko"
msgid "  Speaking of which, since when have you and Alice been on such good terms? Did something happen?\""
msgstr "　……そういえば前から不思議に思ってたんだけど、いつから有珠と仲良くなったの？　そのきっかけが、私には分からないんだけど」"

#. Occurrence D_8:1255:19506: scene=D_8
#: D_8:1255
msgctxt "text_id=19506 | speaker=unknown"
msgid "  Aoko peered at him the way she would at a strange specimen as he took a deep breath and launched into an earnest explanation."
msgstr "　隣りから覗きこむように見つめられて、草十郎はさて、と考えを巡らせた。"

#. Occurrence D_8:1281:19507: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0008; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:1281
msgctxt "text_id=19507 | speaker=soujuurou"
msgid "\"I don't think there's any particular time I can point to when it happened."
msgstr "「大きなきっかけとか、そういうのはないと思うけど。"

#. Occurrence D_8:1287:19508: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0009; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:1287
msgctxt "text_id=19508 | speaker=soujuurou"
msgid "  But if I had to I'd say, it started the first time we spoke. And we got a lot closer after talking that time in the foyer, too.\""
msgstr "　しいていうなら初めて話した時かな。もっと確かになったのはロビーで話した時だろうね」"

#. Occurrence D_8:1293:19509: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0010; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:1293
msgctxt "text_id=19509 | speaker=aoko"
msgid "\"...That's it?\""
msgstr "「たったそれだけ？」"

#. Occurrence D_8:1304:19510: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0010; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:1304
msgctxt "text_id=19510 | speaker=soujuurou"
msgid "\"Yeah. Getting to know someone is all about little moments like that, wouldn't you agree?\""
msgstr "「ああ。親しくなるっていうのは、そういう事だろ？」"

#. Occurrence D_8:1329:19511: scene=D_8
#: D_8:1329
msgctxt "text_id=19511 | speaker=unknown"
msgid "  Soujyuro seemed to find her question odd."
msgstr "　変なこと訊くんだな、と草十郎は言葉をきった。"

#. Occurrence D_8:1334:19512: scene=D_8
#: D_8:1334
msgctxt "text_id=19512 | speaker=unknown"
msgid "  The way he and Alice communicated went beyond words."
msgstr "　言葉ではなく感性で通じ合う。"

#. Occurrence D_8:1339:19513: scene=D_8
#: D_8:1339
msgctxt "text_id=19513 | speaker=unknown"
msgid "  Aoko could only assume that was how he did it."
msgstr "　たしかに、この少年と有珠はそんな関係なのかも知れない。"

#. Occurrence D_8:1398:19514: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0011; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:1398
msgctxt "text_id=19514 | speaker=aoko"
msgid "\"Come to think of it, you've always just called her 'Alice' and not by her surname.\""
msgstr "「……そういえば、初めから『有珠』って呼び捨てだったものね、アンタは」"

#. Occurrence D_8:1417:19515: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0011; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:1417
msgctxt "text_id=19515 | speaker=soujuurou"
msgid "\"Have I? I don't even remember now. More importantly, though, why are you so mad?\""
msgstr "「そうだっけ？　よく覚えていないけど。……それより、なにを怒ってるんだ蒼崎？」"

#. Occurrence D_8:1457:19516: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0012; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:1457
msgctxt "text_id=19516 | speaker=aoko"
msgid "\"I'm not mad.\""
msgstr "「別に怒ってないわよ、私」"

#. Occurrence D_8:1463:19517: scene=D_8
#: D_8:1463
msgctxt "text_id=19517 | speaker=unknown"
msgid "  Her response was slightly cold, but also somehow gentle."
msgstr "　その返答は、やや冷たくて、どことなく愛らしかった。"

#. Occurrence D_8:1483:19518: scene=D_8
#: D_8:1483
msgctxt "text_id=19518 | speaker=unknown"
msgid "  They approached the halfway point of the mountain path."
msgstr "　山道は半分にさしかかる。"

#. Occurrence D_8:1488:19519: scene=D_8
#: D_8:1488
msgctxt "text_id=19519 | speaker=unknown"
msgid "  The night sky appeared more distant as they neared the bottom, and Soujyuro continued to stare absentmindedly at the stars."
msgstr "　平地に近づくにつれ星空は遠のいていくようで、草十郎はぼんやりと空を見上げ続ける。"

#. Occurrence D_8:1493:19520: scene=D_8
#: D_8:1493
msgctxt "text_id=19520 | speaker=unknown"
msgid "  Then it finally hit her why his behavior had been bothering her since their ascent."
msgstr "　来る時からその素振りが気になっていた青子だが、ここにきてようやく、その理由に思い至った。"

#. Occurrence D_8:1498:19521: scene=D_8
#: D_8:1498
msgctxt "text_id=19521 | speaker=unknown"
msgid "  She realized he must be feeling nostalgia."
msgstr "　ようするに、彼は懐かしがっているのだ。"

#. Occurrence D_8:1503:19522: scene=D_8
#: D_8:1503
msgctxt "text_id=19522 | speaker=unknown"
msgid "  He missed the way the stars looked from up in the mountains."
msgstr "　山から見る星空というヤツを。"

#. Occurrence D_8:1523:19523: scene=D_8
#: D_8:1523
msgctxt "text_id=19523 | speaker=unknown"
msgid "\"..."
msgstr "「――――――"

#. Occurrence D_8:1530:19524: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0012; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:1530
msgctxt "text_id=19524 | speaker=soujuurou"
msgid "Aozaki?\""
msgstr "蒼崎」"

#. Occurrence D_8:1550:19525: scene=D_8
#: D_8:1550
msgctxt "text_id=19525 | speaker=unknown"
msgid "  He spoke without looking down from the heavens."
msgstr "　不意に、草十郎は見上げたまま問いかけてきた。"

#. Occurrence D_8:1557:19526: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0013; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:1557
msgctxt "text_id=19526 | speaker=soujuurou"
msgid "\"I've been meaning to ask, do you have anything you regret?\""
msgstr "「ひとつ聞きたいんだけど、君に後悔はあるのかな」"

#. Occurrence D_8:1563:19527: scene=D_8
#: D_8:1563
msgctxt "text_id=19527 | speaker=unknown"
msgid "  Soujyuro's breath was white in the night air, his hands jammed in his pockets."
msgstr "　両手を上着のポケットにいれたまま、白い息をする草十郎。"

#. Occurrence D_8:1568:19528: scene=D_8
#: D_8:1568
msgctxt "text_id=19528 | speaker=unknown"
msgid "  Aoko had the vague feeling somewhere deep inside that he was only a figment of her imagination."
msgstr "　青子にはその姿が、幻のように遠く感じられた。"

#. Occurrence D_8:1603:19529: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0013; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:1603
msgctxt "text_id=19529 | speaker=aoko"
msgid "\"Where did that question come from?\""
msgstr "「……どうしたの、突然そんなこと聞いて」"

#. Occurrence D_8:1609:19530: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0014; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:1609
msgctxt "text_id=19530 | speaker=soujuurou"
msgid "\"Just answer it. I want to know."
msgstr "「いいから、答えて。聞きたいんだ。"

#. Occurrence D_8:1616:19531: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0015; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:1616
msgctxt "text_id=19531 | speaker=soujuurou"
msgid "Do you have any regrets or not?\""
msgstr "君に、悔いはあるのかないのかを」"

#. Occurrence D_8:1629:19532: scene=D_8
#: D_8:1629
msgctxt "text_id=19532 | speaker=unknown"
msgid "  It was a sad thing to be asked."
msgstr "　……それは、哀しい問いだった。"

#. Occurrence D_8:1634:19533: scene=D_8
#: D_8:1634
msgctxt "text_id=19533 | speaker=unknown"
msgid "  He would be hurt one way or another no matter how she answered."
msgstr "　なんと答えても彼は多くの物を失うのだろう。"

#. Occurrence D_8:1639:19534: scene=D_8
#: D_8:1639
msgctxt "text_id=19534 | speaker=unknown"
msgid "  But he wanted an answer, and so she gave him one."
msgstr "　それでも答えを求めている以上、青子はさっぱりと返答する。"

#. Occurrence D_8:1678:19535: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0014; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:1678
msgctxt "text_id=19535 | speaker=aoko"
msgid "\"Regrets? Of course not. I make a point to live my life with no regrets."
msgstr "「ないわよ、そんなの。だってそれをしない為に、今を頑張ってるんだもの。"

#. Occurrence D_8:1684:19536: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0015; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:1684
msgctxt "text_id=19536 | speaker=aoko"
msgid "  Regrets aren't something you have, Soujyuro. They're something you get rid of.\""
msgstr "　後悔なんてのはね、草十郎。するものじゃなくて、無くしていく為にあるものなのよ」"

#. Occurrence D_8:1704:19537: scene=D_8
#: D_8:1704
msgctxt "text_id=19537 | speaker=unknown"
msgid "\"...\""
msgstr "「―――――――――」"

#. Occurrence D_8:1752:19538: scene=D_8
#: D_8:1752
msgctxt "text_id=19538 | speaker=unknown"
msgid "  Soujyuro grunted in response."
msgstr "　……ああ、と。"

#. Occurrence D_8:1757:19539: scene=D_8
#: D_8:1757
msgctxt "text_id=19539 | speaker=unknown"
msgid "  He bit his lip and pushed down the flood of emotions that rose up inside him."
msgstr "　噛みしめるように、彼は万感の想いを<葬|みおく>った。"

#. Occurrence D_8:1763:19540: scene=D_8
#: D_8:1763
msgctxt "text_id=19540 | speaker=unknown"
msgid "  He waved his hand slightly without actually raising it, as if to shoo away something formless and odorless."
msgstr "　もう形も匂いも薄れている全てに、手を伸ばさず、手を振った。"

#. Occurrence D_8:1784:19541: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0017; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:1784
msgctxt "text_id=19541 | speaker=soujuurou"
msgid "\"So regrets are just something to get rid of, huh?\""
msgstr "「―――そうか。後悔も、無くなるものなのか」"

#. Occurrence D_8:1790:19542: scene=D_8
#: D_8:1790
msgctxt "text_id=19542 | speaker=unknown"
msgid "  Pain was subtly visible on his face as he spoke."
msgstr "　呟く顔にはかすかな痛み。"

#. Occurrence D_8:1795:19543: scene=D_8
#: D_8:1795
msgctxt "text_id=19543 | speaker=unknown"
msgid "  And yet it was so vivid."
msgstr "　ただ、<鮮|あざ>やかで。"

#. Occurrence D_8:1800:19544: scene=D_8
#: D_8:1800
msgctxt "text_id=19544 | speaker=unknown"
msgid "  As much as he wanted to he did not have the strength to say it aloud. He was not like her, able to speak her mind so readily."
msgstr "　そう言い切れるほど自分は強くはないけれど、それに焦がれている。そう言い切れる彼女に、強く焦がれている。"

#. Occurrence D_8:1805:19545: scene=D_8
#: D_8:1805
msgctxt "text_id=19545 | speaker=unknown"
msgid "  Maybe someday..."
msgstr "　なら、いつか―――"

#. Occurrence D_8:1882:19546: scene=D_8
#: D_8:1882
msgctxt "text_id=19546 | speaker=unknown"
msgid "  The sky and the darkness were both far away now."
msgstr "　いまは、空も闇も遠く。"

#. Occurrence D_8:1888:19547: scene=D_8
#: D_8:1888
msgctxt "text_id=19547 | speaker=unknown"
msgid "  Tonight's grand view, only to be seen this once. He hoped its beauty would remain in his mind forever."
msgstr "　今日だけの景色が、いつまでも美しく思えるのなら。"

#. Occurrence D_8:1893:19548: scene=D_8
#: D_8:1893
msgctxt "text_id=19548 | speaker=unknown"
msgid "  But what then of the regrets he had come to hold inside, of the days he had spent that now shone like stars in the sky? Would they too be with him forever?"
msgstr "　残してきた<幾|いく>つかの悔いが、星のように思える日が、いつかはあるのだろうか？"

#. Occurrence D_8:1958:19549: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0016; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:1958
msgctxt "text_id=19549 | speaker=aoko"
msgid "\"Nice sky tonight. It's a much better view than the one from town.\""
msgstr "「いい空ね。町じゃ、ちょっと見れないな」"

#. Occurrence D_8:1964:19550: scene=D_8
#: D_8:1964
msgctxt "text_id=19550 | speaker=unknown"
msgid "  Aoko mimicked Soujyuro, looking up at the darkness overhead."
msgstr "　見上げる草十郎にならって、青子は暗い空を眺めた。"

#. Occurrence D_8:1969:19551: scene=D_8
#: D_8:1969
msgctxt "text_id=19551 | speaker=unknown"
msgid "  The stars shone brighter here than in town."
msgstr "　星は町でのそれより強く輝いている。"

#. Occurrence D_8:1974:19552: scene=D_8
#: D_8:1974
msgctxt "text_id=19552 | speaker=unknown"
msgid "  This clarity was thanks to the absence of any other lights amidst the darkness."
msgstr "　澄んだ空気と、明かりのない闇のおかげだ。"

#. Occurrence D_8:1979:19553: scene=D_8
#: D_8:1979
msgctxt "text_id=19553 | speaker=unknown"
msgid "  Soujyuro stared at her with almost a sense of loathing."
msgstr "　それを憎むような眼差しで草十郎は見つめていた。"

#. Occurrence D_8:1984:19554: scene=D_8
#: D_8:1984
msgctxt "text_id=19554 | speaker=unknown"
msgid "  As beautiful as the stars were, they were not the real thing, not here."
msgstr "　……こんなにも綺麗な星なのに、それを偽物と決め付けるように。"

#. Occurrence D_8:2005:19555: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0018; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:2005
msgctxt "text_id=19555 | speaker=soujuurou"
msgid "\"Yeah. But they're still too far to ever reach.\""
msgstr "「……そうだね。でも、ここでも手は届きそうにない」"

#. Occurrence D_8:2011:19556: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0017; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:2011
msgctxt "text_id=19556 | speaker=aoko"
msgid "\"Huh?\""
msgstr "「え……？」"

#. Occurrence D_8:2017:19557: scene=D_8
#: D_8:2017
msgctxt "text_id=19557 | speaker=unknown"
msgid "  Soujyuro's sudden negativity caused her to turn to him in shock."
msgstr "　突然の否定に驚いて、青子は草十郎の顔を覗き見る。"

#. Occurrence D_8:2022:19558: scene=D_8
#: D_8:2022
msgctxt "text_id=19558 | speaker=unknown"
msgid "  The anger in his eyes had died down now."
msgstr "　……憎むような瞳は、もうくすんだ色に戻っていた。"

#. Occurrence D_8:2027:19559: scene=D_8
#: D_8:2027
msgctxt "text_id=19559 | speaker=unknown"
msgid "  Taking a breath, he began to speak as if talking to himself."
msgstr "　一呼吸して草十郎は呟く。"

#. Occurrence D_8:2032:19560: scene=D_8
#: D_8:2032
msgctxt "text_id=19560 | speaker=unknown"
msgid "  His gaze never left the stars."
msgstr "　視線はいまだ星空に釘付けたまま。"

#. Occurrence D_8:2084:19561: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0019; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:2084
msgctxt "text_id=19561 | speaker=soujuurou"
msgid "\"It's not like this in the mountains. There the stars feel so close. Even if they're technically too far away to touch, it really feels like you could just reach out and grab them."
msgstr "「山ではね、蒼崎。星は本当に手が届きそうなんだ。届かないのは分かっていても、望めば掴めそうなぐらい近いのに。"

#. Occurrence D_8:2091:19562: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0020; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:2091
msgctxt "text_id=19562 | speaker=soujuurou"
msgid "The stars in the city don't give you that feeling.\""
msgstr "都会の星は、そう思う事さえ許してくれない」"

#. Occurrence D_8:2190:19563: scene=D_8
#: D_8:2190
msgctxt "text_id=19563 | speaker=unknown"
msgid "  He was speaking of the sky in its purest state."
msgstr "　それが本当のソラ。"

#. Occurrence D_8:2195:19564: scene=D_8
#: D_8:2195
msgctxt "text_id=19564 | speaker=unknown"
msgid "  The starry skies in the mountains far exceeded those of any urban planetarium."
msgstr "　彼の語る山の星空は、<天象儀|プラネタリウム>より素晴らしい物だった。"

#. Occurrence D_8:2200:19565: scene=D_8
#: D_8:2200
msgctxt "text_id=19565 | speaker=unknown"
msgid "  Their movement was like the pouring of rain."
msgstr "　降り注ぐ雨のような、回る星々。"

#. Occurrence D_8:2205:19566: scene=D_8
#: D_8:2205
msgctxt "text_id=19566 | speaker=unknown"
msgid "  He spoke of the primal sky, unchanged from the past. The same sky humans had traced with their fingers since prehistoric times."
msgstr "　指でなぞるだけで観測できる、原初のままの夜空。"

#. Occurrence D_8:2211:19567: scene=D_8
#: D_8:2211
msgctxt "text_id=19567 | speaker=unknown"
msgid "  For him it was a past to which he could never return, a place to which he did not even know the way back."
msgstr "　……それは、彼にはもう戻る事のできない、帰り道すら知らない故郷。"

#. Occurrence D_8:2232:19568: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0021; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:2232
msgctxt "text_id=19568 | speaker=soujuurou"
msgid "\"I used to compare everything here to the mountains. I really hated it then. And I'm still not used to it now."
msgstr "「……今まで、目に映るすべてを山と比べていた。こんな場所は、本当は嫌いだったんだ。今でも、正直なじめない。"

#. Occurrence D_8:2238:19569: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0022; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:2238
msgctxt "text_id=19569 | speaker=soujuurou"
msgid "  At some point I'll start looking at the mountains from a city-dweller's perspective, I'm sure. The mountains are in my past now.\""
msgstr "　でも、いつか比べるのは街になってしまうんだろう。自分は、こっちに下りてきてしまったんだから」"

#. Occurrence D_8:2303:19570: scene=D_8
#: D_8:2303
msgctxt "text_id=19570 | speaker=unknown"
msgid "  That was his one regret."
msgstr "　それが今までの後悔。"

#. Occurrence D_8:2308:19571: scene=D_8
#: D_8:2308
msgctxt "text_id=19571 | speaker=unknown"
msgid "  He lowered his gaze from the stars and turned to Aoko."
msgstr "　星空から視線を離して、草十郎は青子へと視線を向ける。"

#. Occurrence D_8:2313:19572: scene=D_8
#: D_8:2313
msgctxt "text_id=19572 | speaker=unknown"
msgid "  Her eyes were unusually hesitant, and looked slightly hurt."
msgstr "　いつもとは違う、ためらいがちの彼女の瞳が、少し痛い。"

#. Occurrence D_8:2318:19573: scene=D_8
#: D_8:2318
msgctxt "text_id=19573 | speaker=unknown"
msgid "  Was it empathy they showed, or pity?"
msgstr "　それは自分への同情か、それともただの<憐愍|れんびん>か。"

#. Occurrence D_8:2323:19574: scene=D_8
#: D_8:2323
msgctxt "text_id=19574 | speaker=unknown"
msgid "  Either way, he was the reason for the uncharacteristic look on her face now."
msgstr "　……そのどちらにしたって、彼女らしくない瞳をさせているのは自分だ。"

#. Occurrence D_8:2328:19575: scene=D_8
#: D_8:2328
msgctxt "text_id=19575 | speaker=unknown"
msgid "  He shut his eyes and nodded in response to her unspoken question."
msgstr "　青子の無言の問いかけに、草十郎は目を閉じてうなずいた。"

#. Occurrence D_8:2379:19576: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0023; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:2379
msgctxt "text_id=19576 | speaker=soujuurou"
msgid "\"It's true. I can't help it."
msgstr "「……うん。それは仕方のない事だ。"

#. Occurrence D_8:2385:19577: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0024; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:2385
msgctxt "text_id=19577 | speaker=soujuurou"
msgid "  But if this is the way it's going to be, I've got to make the most of it."
msgstr "　ただ、そうなるのなら、そうなってしまう以上に、すばらしい物を手に入れないといけない。"

#. Occurrence D_8:2391:19578: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0025; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:2391
msgctxt "text_id=19578 | speaker=soujuurou"
msgid "  So that someday I can stop seeing it as a regret.\""
msgstr "　後悔を、いつか、後悔と思わないために」"

#. Occurrence D_8:2422:19579: scene=D_8
#: D_8:2422
msgctxt "text_id=19579 | speaker=unknown"
msgid "  There was gratitude in Soujyuro's voice as he confessed his feelings."
msgstr "　彼は感謝するように、そう告白した。"

#. Occurrence D_8:2427:19580: scene=D_8
#: D_8:2427
msgctxt "text_id=19580 | speaker=unknown"
msgid "  Remnants from the past must one day be released."
msgstr "　古いカラは捨てなければいけない。"

#. Occurrence D_8:2432:19581: scene=D_8
#: D_8:2432
msgctxt "text_id=19581 | speaker=unknown"
msgid "  Loss must be overcome."
msgstr "　喪失は踏み越えなければならない。"

#. Occurrence D_8:2438:19582: scene=D_8
#: D_8:2438
msgctxt "text_id=19582 | speaker=unknown"
msgid "  He had lost it, his everything, the moment she had answered his query."
msgstr "　それが、青子の答えで彼が失った、彼の全てだったモノ。"

#. Occurrence D_8:2483:19583: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0018; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:2483
msgctxt "text_id=19583 | speaker=aoko"
msgid "\"Oh, cut it out. Don't act like I caused some kind of turning point in your life.\""
msgstr "「……やめてよね。私の一言でいちいち<人生観|じんせいかん>変えられちゃ、荷が重いじゃない」"

#. Occurrence D_8:2489:19584: scene=D_8
#: D_8:2489
msgctxt "text_id=19584 | speaker=unknown"
msgid "  She smiled weakly and averted her eyes as she spoke these hurtful words."
msgstr "　向けられた笑顔があんまりに柔らかくて、青子は顔を背けながら憎まれ口を言う。"

#. Occurrence D_8:2494:19585: scene=D_8
#: D_8:2494
msgctxt "text_id=19585 | speaker=unknown"
msgid "  Most likely she was being completely honest, and in that she was being true to herself."
msgstr "　……本音である可能性も大きいが、それはそれで彼女らしい。"

#. Occurrence D_8:2545:19586: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0019; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:2545
msgctxt "text_id=19586 | speaker=aoko"
msgid "\"So what did you and my grandfather talk about?"
msgstr "「それで、祖父と何を話したの？"

#. Occurrence D_8:2551:19587: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0020; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:2551
msgctxt "text_id=19587 | speaker=aoko"
msgid "  It's rare for him to care about anyone besides himself.\""
msgstr "　あの人が他人に興味を持つなんて、すごい事よ」"

#. Occurrence D_8:2557:19588: scene=D_8
#: D_8:2557
msgctxt "text_id=19588 | speaker=unknown"
msgid "  The topic had finally been broached, and yet Soujyuro said nothing."
msgstr "　せっかくの質問だったが、あの老人との会話について、草十郎は答えなかった。"

#. Occurrence D_8:2562:19589: scene=D_8
#: D_8:2562
msgctxt "text_id=19589 | speaker=unknown"
msgid "  An empty reply can be used to buy time."
msgstr "　当たり障りのない返答をしてお茶をにごす。"

#. Occurrence D_8:2643:19590: scene=D_8
#: D_8:2643
msgctxt "text_id=19590 | speaker=unknown"
msgid "  They had nearly reached the flat road at the base of the mountain."
msgstr "　道は、もうじき平坦な路面に戻ろうとしていた。"

#. Occurrence D_8:2648:19591: scene=D_8
#: D_8:2648
msgctxt "text_id=19591 | speaker=unknown"
msgid "  The soft earth here would soon give way to the tightly packed dirt of the paths running between the rice fields."
msgstr "　柔らかな土の地面は、<畦道|あぜみち>の固い土の道になるのだろう。"

#. Occurrence D_8:2654:19592: scene=D_8
#: D_8:2654
msgctxt "text_id=19592 | speaker=unknown"
msgid "  But before they got that far, Soujyuro came to an abrupt halt."
msgstr "　その前に、ぴたりと草十郎は立ち止まった。"

#. Occurrence D_8:2659:19593: scene=D_8
#: D_8:2659
msgctxt "text_id=19593 | speaker=unknown"
msgid "  Closing his eyes he listened carefully."
msgstr "　目を閉じて、耳を澄ます。"

#. Occurrence D_8:2664:19594: scene=D_8
#: D_8:2664
msgctxt "text_id=19594 | speaker=unknown"
msgid "  He then gave a firm nod and turned to face Aoko."
msgstr "　その後にうん、とうなずいて青子に向き直った。"

#. Occurrence D_8:2716:19595: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0026; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:2716
msgctxt "text_id=19595 | speaker=soujuurou"
msgid "\"Congratulations, Aozaki.\""
msgstr "「おめでとう、蒼崎」"

#. Occurrence D_8:2721:19596: scene=D_8
#: D_8:2721
msgctxt "text_id=19596 | speaker=unknown"
msgid "  She blinked, not knowing what to make of it."
msgstr "　青子はわけも分からず目をまたたかせる。"

#. Occurrence D_8:2735:19597: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0021; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:2735
msgctxt "text_id=19597 | speaker=aoko"
msgid "\"What's with you all of a sudden?\""
msgstr "「なによ、突然」"

#. Occurrence D_8:2740:19598: scene=D_8
#: D_8:2740
msgctxt "text_id=19598 | speaker=unknown"
msgid "  It was a perfectly natural response."
msgstr "　当然の反応。"

#. Occurrence D_8:2745:19599: scene=D_8
#: D_8:2745
msgctxt "text_id=19599 | speaker=unknown"
msgid "  The tension melted from his face as he said,"
msgstr "　それに、少年はほころぶように、"

#. Occurrence D_8:2789:19600: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0027; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:2789
msgctxt "text_id=19600 | speaker=soujuurou"
msgid "\"Happy New Year.\""
msgstr "「新しい年だ」"

#. Occurrence D_8:2794:19601: scene=D_8
#: D_8:2794
msgctxt "text_id=19601 | speaker=unknown"
msgid "  He now wore a smile full of joy."
msgstr "　喜びに満ちた笑顔で、そう返答した。"

#. Occurrence D_8:2815:19602: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0022; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:2815
msgctxt "text_id=19602 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence D_8:2904:19603: scene=D_8
#: D_8:2904
msgctxt "text_id=19603 | speaker=unknown"
msgid "  Dumbfounded, all Aoko could do was stare back at his calm visage."
msgstr "　青子は呆然と、ただ彼の顔を見てしまう。"

#. Occurrence D_8:2909:19604: scene=D_8
#: D_8:2909
msgctxt "text_id=19604 | speaker=unknown"
msgid "  His surprise attack hit her so hard she thought she could hear the shrine bell in Yashirogi ringing in the new year."
msgstr "　あまりの不意打ちで、遠く離れた<社木|やしろぎ>から<除夜|じょや>の鐘が聞こえた気がするぐらいだ。"

#. Occurrence D_8:2914:19605: scene=D_8
#: D_8:2914
msgctxt "text_id=19605 | speaker=unknown"
msgid "  She had known it was the last day of the year but had not given it much thought beyond that."
msgstr "　今日が<今年|ことし>最後の日だと知っていたのに、彼女はそれをどうとも思っていなかった。"

#. Occurrence D_8:2967:19606: scene=D_8
#: D_8:2967
msgctxt "text_id=19606 | speaker=unknown"
msgid "  And so his succinct words gave her quite the shock."
msgstr "　なのに、たった少しの言葉だけで。"

#. Occurrence D_8:2972:19607: scene=D_8
#: D_8:2972
msgctxt "text_id=19607 | speaker=unknown"
msgid "  As if the girl who believed in the power of the bell all those years ago had come back."
msgstr "　遠い昔に置いたままの、鐘の音の奇跡を信じていた少女が振り向いた気がしたのだ。"

#. Occurrence D_8:3028:19608: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_8_0023; voice_prefix=A10; voice_category=1; scene=D_8
#: D_8:3028
msgctxt "text_id=19608 | speaker=aoko"
msgid "\"Oh, right... It's midnight now so the new year is here.\""
msgstr "「そっか……午前零時で、もう新しい年なんだ」"

#. Occurrence D_8:3034:19609: scene=D_8
#: D_8:3034
msgctxt "text_id=19609 | speaker=unknown"
msgid "  She spoke in a hushed tone as if this were shocking news."
msgstr "　知らなかった事のように青子は呟く。"

#. Occurrence D_8:3039:19610: scene=D_8
#: D_8:3039
msgctxt "text_id=19610 | speaker=unknown"
msgid "  At the same time, a slight smile crept onto her face."
msgstr "　その口元に、少しだけの微笑みを浮かべて。"

#. Occurrence D_8:3108:19611: scene=D_8
#: D_8:3108
msgctxt "text_id=19611 | speaker=unknown"
msgid "  A new year, indeed..."
msgstr "　……そう。"

#. Occurrence D_8:3113:19612: scene=D_8
#: D_8:3113
msgctxt "text_id=19612 | speaker=unknown"
msgid "  She recalled the first time she had worn a full-length kimono, how she had not been particularly uncomfortable or embarrassed, but not especially pretty, either."
msgstr "　思い出の中で振り向く少女は、初めての<振|ふ>り<袖|そで>なのに緊張の素振りもなくて、あんまり可愛くはなかったけれど。"

#. Occurrence D_8:3118:19613: scene=D_8
#: D_8:3118
msgctxt "text_id=19613 | speaker=unknown"
msgid "  The only pretty thing about her had been the moment she smiled at herself in the mirror."
msgstr "　それでも、鏡越しに微笑んでしまうだけの愛らしさはあったのだ。"

#. Occurrence D_8:3123:19614: scene=D_8
#: D_8:3123
msgctxt "text_id=19614 | speaker=unknown"
msgid "  Seeing the warmth in her eyes, Soujyuro closed his own in satisfaction. It made him happy to see her like that."
msgstr "　温かそうな青子の顔を見て、草十郎は満足そうに目蓋を閉じた。それが何より嬉しい、と言うように。"

#. Occurrence D_8:3187:19615: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0028; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:3187
msgctxt "text_id=19615 | speaker=soujuurou"
msgid "\"Well, a lot happened in the past year."
msgstr "「―――うん、色々あったけど。"

#. Occurrence D_8:3193:19616: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_D_8_0029; voice_prefix=A30; voice_category=3; scene=D_8
#: D_8:3193
msgctxt "text_id=19616 | speaker=soujuurou"
msgid "  But I'm glad to be able to start a new one with you.\""
msgstr "　新しい年を、君と<迎|むか>えられて良かった」"

#. Occurrence D_8:3299:19617: scene=D_8
#: D_8:3299
msgctxt "text_id=19617 | speaker=unknown"
msgid "  With that he went walking off once more."
msgstr "　そう言って草十郎は歩きだした。"

#. Occurrence D_8:3312:19618: scene=D_8
#: D_8:3312
msgctxt "text_id=19618 | speaker=unknown"
msgid "  The thought of Alice waiting alone was probably what spurred him into action."
msgstr "　たぶん、こんな夜なのにひとりで待っている有珠の為に。"

#. Occurrence D_8:3317:19619: scene=D_8
#: D_8:3317
msgctxt "text_id=19619 | speaker=unknown"
msgid "  Aoko recalled his words as she walked alongside him."
msgstr "　その横を歩きながら、青子はさっきの言葉をもう一度だけ思いだす。"

#. Occurrence D_8:3353:19620: scene=D_8
#: D_8:3353
msgctxt "text_id=19620 | speaker=unknown"
msgid "  The moment he had declared the start of a new year..."
msgstr "　新年を告げる言葉。"

#. Occurrence D_8:3358:19621: scene=D_8
#: D_8:3358
msgctxt "text_id=19621 | speaker=unknown"
msgid "  The way he had spoken so naturally... It made her suddenly feel like they had known each other for years."
msgstr "　本当に自然に告げられたあの一言のせいで、もう何年も前から知り合っている友人の気さえした。"

#. Occurrence D_8:3363:19622: scene=D_8
#: D_8:3363
msgctxt "text_id=19622 | speaker=unknown"
msgid "  She could not be blamed for being filled with happiness at the thought."
msgstr "　それをとても幸福な事だと感じるのは、たぶん間違いじゃないはずだ。"

#. Occurrence D_8:3395:19623: scene=D_8
#: D_8:3395
msgctxt "text_id=19623 | speaker=unknown"
msgid "  And yet a day would surely come when they would have to say their goodbyes."
msgstr "　いずれ、この少年ともあっさりと別れる日が来るのだろうけど。"

#. Occurrence D_8:3400:19624: scene=D_8
#: D_8:3400
msgctxt "text_id=19624 | speaker=unknown"
msgid "  Until then, however, it would not do any harm to behave as if they were old friends."
msgstr "　その時まで、こんな風に自然に、古い友人のように付き合えるのなら、それは悪いことじゃない。"

#. Occurrence D_8:3447:19625: scene=D_8
#: D_8:3447
msgctxt "text_id=19625 | speaker=unknown"
msgid "  He was a naïve yet incredibly unique young man."
msgstr "　一見<素朴|そぼく>な、けれど特異な少年。"

#. Occurrence D_8:3452:19626: scene=D_8
#: D_8:3452
msgctxt "text_id=19626 | speaker=unknown"
msgid "  As they walked, she wondered how long this fleeting feeling of friendship would last."
msgstr "　彼との束の間の友情がいったい<何|い><時|つ>まで続くか考えながら、青子は足を進ませる。"

#. Occurrence D_8:3457:19627: scene=D_8
#: D_8:3457
msgctxt "text_id=19627 | speaker=unknown"
msgid "  She looked up wistfully at the sky, just the way Soujyuro had done earlier on their walk."
msgstr "　途中で一度だけ、草十郎のように、名残惜しく夜空を見上げてから。"

#. Occurrence D_8:3510:19628: scene=D_8
#: D_8:3510
msgctxt "text_id=19628 | speaker=unknown"
msgid "  Every star was out, without a cloud in the sky."
msgstr "　空には満天の星の夜。"

#. Occurrence D_8:3515:19629: scene=D_8
#: D_8:3515
msgctxt "text_id=19629 | speaker=unknown"
msgid "  The two strode down the mountain path, beneath stars that lay ever beyond their reach."
msgstr "　ふたりは届かない星空の<下|した>、山道を<下|お>りていく。"

#. Occurrence D_9:78:19630: scene=D_9
#: D_9:78
msgctxt "text_id=19630 | speaker=unknown"
msgid "            It was on a lazy Sunday morning"
msgstr "　　　　　　私がその本を見つけたのは、"

msgctxt "text_id=19631 | speaker=unknown"
msgid "            that I discovered the book."
msgstr "　　　　　　日曜のけだるい午前中の事だった。"

#. Occurrence D_9:130:19632: scene=D_9
#: D_9:130
msgctxt "text_id=19632 | speaker=unknown"
msgid "  Was I an intruder... No, no, *adventurer*. Either way, I'd made my way into the forbidden Kuonji Estate library."
msgstr "　部外者……というか約一名の冒険野郎……立ち入り禁止の、久遠寺邸の図書室。"

#. Occurrence D_9:136:19633: scene=D_9
#: D_9:136
msgctxt "text_id=19633 | speaker=unknown"
msgid "  The book instantly drew my attention as it looked like it had been intentionally hidden there on the bookshelf."
msgstr "　本棚の上に隠すように置かれたそれは、なんとなく秘密めいて私の興味をひいたのだ。"

#. Occurrence D_9:157:19634: scene=D_9
#: D_9:157
msgctxt "text_id=19634 | speaker=unknown"
msgid "  It was large enough to double as a shield and so took great effort for me to remove it from the shelf."
msgstr "　盾にでもなりそうなほど大きな本を、苦労しながら本棚の上から引っ張り出す。"

#. Occurrence D_9:163:19635: scene=D_9
#: D_9:163
msgctxt "text_id=19635 | speaker=unknown"
msgid "  Flipping through I realized it was a grimoire of rune magecraft, and a first edition at that."
msgstr "　パラパラとめくっていくうちに、これがルーン魔術の<魔導|グリ><書|モア>、それも<原書|オリジナル>に関するものである事に気が付いた。"

#. Occurrence D_9:184:19636: scene=D_9
#: D_9:184
msgctxt "text_id=19636 | speaker=unknown"
msgid "  Surprised as I was by my find, my search came to a halt on the page I'd been looking for."
msgstr "　まさかね、と思っているうちに、ここのところ探す<素|そ><振|ぶ>りさえ<止|や>めてしまった、目的の物が発見された。"

#. Occurrence D_9:190:19637: scene=D_9
#: D_9:190
msgctxt "text_id=19637 | speaker=unknown"
msgid "  It was the rune for memory erasure that the Nordic gods had once used on a valkyrie."
msgstr "　北欧の大神が戦乙女に使ったとされる、存在だけは有名な忘却のルーン文字だ。"

#. Occurrence D_9:211:19638: scene=D_9
#: D_9:211
msgctxt "text_id=19638 | speaker=unknown"
msgid "  For minutes I simply stared at the page where the rune methodology was laid out."
msgstr "　その使用法が如実に書かれたページとにらめっこすること数分。"

#. Occurrence D_9:217:19639: scene=D_9
#: D_9:217
msgctxt "text_id=19639 | speaker=unknown"
msgid "And then, finally, I shut the book."
msgstr "……結局、私は本を閉じる事にした。"

#. Occurrence D_9:223:19640: scene=D_9
#: D_9:223
msgctxt "text_id=19640 | speaker=unknown"
msgid "  I returned it to the shelf in an even harder to detect location than where I'd originally found it. That's when it hit me."
msgstr "　そうして元の位置より、もうちょっと見付けにくい場所に戻そうとした時、あれっと思い出す。"

#. Occurrence D_9:228:19641: scene=D_9
#: D_9:228
msgctxt "text_id=19641 | speaker=unknown"
msgid "  I'd seen this book before somewhere."
msgstr "　……この本を、どこかで見た事があるのだ。"

#. Occurrence D_9:249:19642: scene=D_9
#: D_9:249
msgctxt "text_id=19642 | speaker=unknown"
msgid "  When and where exactly had I seen it, though?"
msgstr "　あれはいつだったろう。"

#. Occurrence D_9:254:19643: scene=D_9
#: D_9:254
msgctxt "text_id=19643 | speaker=unknown"
msgid "  Yeah... It was when he first invited me to spend time with him."
msgstr "　たしか……そう、彼が初めて遊びに行こうと誘った時。"

#. Occurrence D_9:259:19644: scene=D_9
#: D_9:259
msgctxt "text_id=19644 | speaker=unknown"
msgid "  The girl sitting before me had it in hand at the time."
msgstr "　自分の目前に座っていた少女が手にしていたのが、この本だったと思うけど……。"

#. Occurrence D_9:280:19645: scene=D_9
#: D_9:280
msgctxt "text_id=19645 | speaker=unknown"
msgid "  That must have been it."
msgstr "　いや、きっとそうだ。"

#. Occurrence D_9:285:19646: scene=D_9
#: D_9:285
msgctxt "text_id=19646 | speaker=unknown"
msgid "  Unable to keep the smile off my face, I decided to put the book back exactly where I'd found it."
msgstr "　小さな笑いをこらえきれず、私は本を寸分違わない元の場所に戻すことにした。"

#. Occurrence D_9:290:19647: scene=D_9
#: D_9:290
msgctxt "text_id=19647 | speaker=unknown"
msgid "  It would be most difficult to find when mixed in with the other books on the shelf; however, out of respect for her gracious efforts I decided to pretend I'd never seen it at all."
msgstr "　ここの蔵書量なら本棚の中に混ぜたほうが見付ける可能性は低いのだけど、ここは彼女の微笑ましい努力をくんで見なかった事にしよう。"

#. Occurrence D_9:295:19648: scene=D_9
#: D_9:295
msgctxt "text_id=19648 | speaker=unknown"
msgid "  I shelved my discovery, so to speak."
msgstr "　……文字通り、自分の事を棚に上げてる、とは思うけど。"

#. Occurrence D_9:316:19649: scene=D_9
#: D_9:316
msgctxt "text_id=19649 | speaker=unknown"
msgid "  That's when I heard the shouting of a familiar voice in the main building."
msgstr "　その時、本館の方から聞きなれた叫び声が聞こえてきた。"

#. Occurrence D_9:322:19650: scene=D_9
#: D_9:322
msgctxt "text_id=19650 | speaker=unknown"
msgid "  Lately, he seemed to have found his calling as a housekeeper and had taken to cleaning every corner of the mansion."
msgstr "　最近、彼は家政婦業に目覚めたのか、洋館のいたるところを掃除しようと頑張っている。"

#. Occurrence D_9:343:19651: scene=D_9
#: D_9:343
msgctxt "text_id=19651 | speaker=unknown"
msgid "  That was all well and good, but there were a few things that were off-limits, which neither Alice nor I dared touch."
msgstr "　……それはいいんだけど、この洋館には私や有珠にだって手を出せない開かずの間が幾つもある。"

#. Occurrence D_9:349:19652: scene=D_9
#: D_9:349
msgctxt "text_id=19652 | speaker=unknown"
msgid "  He was the type to open things without asking, which put us all in hot water."
msgstr "　それを構わず開けてしまうものだから、火の粉はこっちにまで飛んでくる。"

#. Occurrence D_9:370:19653: scene=D_9
#: D_9:370
msgctxt "text_id=19653 | speaker=unknown"
msgid "  There had been an uproar when he released the ghost ship that Alice's mother had kept around."
msgstr "　この前は、有珠のお母さんが保存していた亡霊船を開放して大騒ぎになったんだっけ。"

#. Occurrence D_9:376:19654: scene=D_9
#: D_9:376
msgctxt "text_id=19654 | speaker=unknown"
msgid "  Catching that little speed demon known as the Cutty Sark had been quite the ordeal."
msgstr "　カティサークとかいう<飛ばし屋|スピードスター>を捕まえるのは、本当に苦労した。"

#. Occurrence D_9:382:19655: scene=D_9
#: D_9:382
msgctxt "text_id=19655 | speaker=unknown"
msgid "I still felt bad for having to rely on that creepy golden wolf for help."
msgstr "あのいけすかない金狼の手を借りるのはもうゴメンである。"

#. Occurrence D_9:403:19656: scene=D_9
#: D_9:403
msgctxt "text_id=19656 | speaker=unknown"
msgid "  And before that, he'd lifted the seal on the troupe of spirits in the basement,"
msgstr "　その前は地下室の悪霊さんご一行の封印を解いて、"

#. Occurrence D_9:408:19657: scene=D_9
#: D_9:408
msgctxt "text_id=19657 | speaker=unknown"
msgid "  which had led to the even creepier people from the Church coming to the mansion for an entire week."
msgstr "　さらにいけすかない教会ご一行が洋館に乗りこんでくるだけでなく、一週間も滞在しやがったし。"

#. Occurrence D_9:414:19658: scene=D_9
#: D_9:414
msgctxt "text_id=19658 | speaker=unknown"
msgid "  Going back even further, there was also the time he'd ventured unsolicited into Alice's room. In the ensuing chaos, I fell into the mirror, and we almost ended up in an all-out war with Alice."
msgstr "　もう少しさかのぼれば、有珠の部屋に勝手に入って、そのとばっちりで私も鏡の国に落っこちて、あやうく有珠と全面戦争をする羽目になりかけた。"

#. Occurrence D_9:446:19659: scene=D_9
#: D_9:446
msgctxt "text_id=19659 | speaker=unknown"
msgid "  Come to think of it..."
msgstr "　……考えてみると。"

#. Occurrence D_9:451:19660: scene=D_9
#: D_9:451
msgctxt "text_id=19660 | speaker=unknown"
msgid "  He really and truly lacked any capacity for learning."
msgstr "　あいつ、学習能力がないみたい。"

#. Occurrence D_9:469:19661: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_D_9_0000; voice_prefix=A10; voice_category=1; scene=D_9
#: D_9:469
msgctxt "text_id=19661 | speaker=aoko"
msgid "\"That idiot needs to get a handle on himself!\""
msgstr "「もう、いい加減にしてよね、あのバカ……！」"

#. Occurrence D_9:505:19662: scene=D_9
#: D_9:505
msgctxt "text_id=19662 | speaker=unknown"
msgid "  The good mood I'd been in up until that moment was spoiled, and I went dashing out of the library."
msgstr "　さっきまでの幸福な気分が台無しになって、私は図書室から飛び出した。"

#. Occurrence D_9:510:19663: scene=D_9
#: D_9:510
msgctxt "text_id=19663 | speaker=unknown"
msgid "  I imagined coming upon the architect of my troubles standing there in the hallway and giving him the swift dropkick to the face he deserved."
msgstr "　たぶん、この後は廊下で立ち尽くしている元凶に飛び蹴りでも食らわせる、なんて未来視をうかべながら。"

#. Occurrence D_9:532:19664: scene=D_9
#: D_9:532
msgctxt "text_id=19664 | speaker=unknown"
msgid "  As far as I was concerned, that would be just another fun day in the mansion."
msgstr "　でもまあ、それはそれで楽しい日常には変わりはない。"

#. Occurrence D_9:553:19665: scene=D_9
#: D_9:553
msgctxt "text_id=19665 | speaker=unknown"
msgid "  And so our little secret remained hidden on the bookshelf..."
msgstr "　棚の上に隠された私たちふたりの秘密。"

#. Occurrence D_9:558:19666: scene=D_9
#: D_9:558
msgctxt "text_id=19666 | speaker=unknown"
msgid "  ...likely never to be opened again."
msgstr "　あの本はたぶん、もう開かれる事はないだろう―――"

#. Occurrence NZ1:112:19667: voice_id=BA0_NZ1_0000; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:112
msgctxt "text_id=19667 | speaker=unknown"
msgid "      The Wonderful World of..."
msgstr "　　　　　　 なぜなにー"

#. Occurrence NZ1:144:19668: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0000; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:144
msgctxt "text_id=19668 | speaker=alice"
msgid "                  Ploys."
msgstr "　　　　　　プロイー"

#. Occurrence NZ1:175:19669: voice_id=BA0_NZ1_0001; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:175
msgctxt "text_id=19669 | speaker=unknown"
msgid "    Pathetic humans who know nofink of magic or incantations."
msgstr "魔法の魔の字も知らない全国のシャバ僧ども。"

#. Occurrence NZ1:175:19670: voice_id=BA0_NZ1_0001; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:175
msgctxt "text_id=19670 | speaker=unknown"
msgid "    High school firsties in blue sweaters tryin' to make it big"
msgstr "ヒロインにならんと高校デビューしたものの、"

#. Occurrence NZ1:175:19671: voice_id=BA0_NZ1_0001; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:175
msgctxt "text_id=19671 | speaker=unknown"
msgid "    only to be one-upped by the superior heroine..."
msgstr "真のヒロインにその座を奪われた青セーターども。"

#. Occurrence NZ1:208:19672: voice_id=BA0_NZ1_0002; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:208
msgctxt "text_id=19672 | speaker=unknown"
msgid "      Good evening."
msgstr "　　こんばんはッス。"

#. Occurrence NZ1:208:19673: voice_id=BA0_NZ1_0002; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:208
msgctxt "text_id=19673 | speaker=unknown"
msgid "      It's time for my new series of lectures, where I tell you about the most"
msgstr "　　よく分からない話をよく分からない方向でレクチャーする"

#. Occurrence NZ1:208:19674: voice_id=BA0_NZ1_0002; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:208
msgctxt "text_id=19674 | speaker=unknown"
msgid "      esoteric of topics in the most esoteric of ways."
msgstr "　　真番組『なぜなにプロイ』の時間っスよ。"

#. Occurrence NZ1:258:19675: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0001; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:258
msgctxt "text_id=19675 | speaker=alice"
msgid "                    ..."
msgstr "　　　　　 …………。"

#. Occurrence NZ1:289:19676: voice_id=BA0_NZ1_0003; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:289
msgctxt "text_id=19676 | speaker=unknown"
msgid "        I am your host, the Great Three plus one,"
msgstr "　　　司会はグレートスリー<＋|プラス>１こと、"

#. Occurrence NZ1:289:19677: voice_id=BA0_NZ1_0003; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:289
msgctxt "text_id=19677 | speaker=unknown"
msgid "        Robin the Crook."
msgstr "　　　コマドリ・ザ・くるっくー。"

#. Occurrence NZ1:315:19678: voice_id=BA0_NZ1_0004; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:315
msgctxt "text_id=19678 | speaker=unknown"
msgid "      I've invited my Angel Mum 'ere tonight to"
msgstr "　　ティーチャ役にはマイ天使であるところの"

#. Occurrence NZ1:315:19679: voice_id=BA0_NZ1_0004; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:315
msgctxt "text_id=19679 | speaker=unknown"
msgid "      act as your teacher."
msgstr "　　アリスさんをお招きしたッス。"

#. Occurrence NZ1:346:19680: voice_id=BA0_NZ1_0005; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:346
msgctxt "text_id=19680 | speaker=unknown"
msgid "      I mean, we are 'ere in her room after all!"
msgstr "つーかここアリスさんの部屋ッスね！"

#. Occurrence NZ1:346:19681: voice_id=BA0_NZ1_0005; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:346
msgctxt "text_id=19681 | speaker=unknown"
msgid "      She wouldn't come down to the studio"
msgstr "時間になってもアリスさんがスタジオに来ないんで、"

msgctxt "text_id=19682 | speaker=unknown"
msgid "      so I decided to bring the camera up to her."
msgstr "アリスさんの部屋にカメラ持ち込んだッスよ。"

#. Occurrence NZ1:385:19683: voice_id=BA0_NZ1_0006; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:385
msgctxt "text_id=19683 | speaker=unknown"
msgid "  I'm thinkin' outside the cage, as they say."
msgstr "　　　発想の転換？　なんス？"

#. Occurrence NZ1:385:19684: voice_id=BA0_NZ1_0006; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:385
msgctxt "text_id=19684 | speaker=unknown"
msgid "  If the guest won't turn up of her own volition,"
msgstr "　　　ゲストが来ないなら、"

#. Occurrence NZ1:385:19685: voice_id=BA0_NZ1_0006; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:385
msgctxt "text_id=19685 | speaker=unknown"
msgid "  why not shoot the show in her lovely chambers?"
msgstr "　　　ゲストの部屋でやればいいじゃない？"

#. Occurrence NZ1:434:19686: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0002; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:434
msgctxt "text_id=19686 | speaker=alice"
msgid "  Can we just get started already?"
msgstr "……いいから、はじめてちょうだい。"

#. Occurrence NZ1:434:19687: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0002; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:434
msgctxt "text_id=19687 | speaker=alice"
msgid "  I want to finish this and get out of here as soon as possible."
msgstr "一秒でも早く終わらせて、光より早く出て行って。"

#. Occurrence NZ1:501:19688: voice_id=BA0_NZ1_0007; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:501
msgctxt "text_id=19688 | speaker=unknown"
msgid "    Ah, you're embarrassin' me!"
msgstr "　　うひゃー、照れるッスー！"

#. Occurrence NZ1:501:19689: voice_id=BA0_NZ1_0007; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:501
msgctxt "text_id=19689 | speaker=unknown"
msgid "    You put me in a right two and eight!"
msgstr "　　のたうちまわるっス－！"

#. Occurrence NZ1:565:19690: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0003; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:565
msgctxt "text_id=19690 | speaker=alice"
msgid "                ...Why?"
msgstr "　　　………………………なぜ？"

#. Occurrence NZ1:625:19691: voice_id=BA0_NZ1_0008; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:625
msgctxt "text_id=19691 | speaker=unknown"
msgid "      Ah, well, I took it as"
msgstr "　　や、ジブン的に"

#. Occurrence NZ1:625:19692: voice_id=BA0_NZ1_0008; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:625
msgctxt "text_id=19692 | speaker=unknown"
msgid "      \"I want to finish this nonsense so I can have some quality"
msgstr "　　「ビジネスはすぐに終わらせて、アナタとプライベート"

#. Occurrence NZ1:625:19693: voice_id=BA0_NZ1_0008; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:625
msgctxt "text_id=19693 | speaker=unknown"
msgid "      private time with you instead.\""
msgstr "　　タイムに入りたいの……」と解釈したッス。"

#. Occurrence NZ1:690:19694: voice_id=BA0_NZ1_0009; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:690
msgctxt "text_id=19694 | speaker=unknown"
msgid "Human language sure is a deep blue tit."
msgstr "人語の奥の深さってやべぇッスよね。"

#. Occurrence NZ1:690:19695: voice_id=BA0_NZ1_0009; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:690
msgctxt "text_id=19695 | speaker=unknown"
msgid "Honestly, I barely have any grasp of what anyone is ever tryin' to say."
msgstr "正直、相手やジブンが何を伝えたいのか、九割方は<意味不能|イ　ミ　フ>ッス。"

#. Occurrence NZ1:741:19696: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0004; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:741
msgctxt "text_id=19696 | speaker=alice"
msgid "  Quite."
msgstr "　そうね。"

#. Occurrence NZ1:741:19697: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0004; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:741
msgctxt "text_id=19697 | speaker=alice"
msgid "  I actually agree with you for once."
msgstr "　わたしも、その意見には賛成よ。"

#. Occurrence NZ1:801:19698: voice_id=BA0_NZ1_0010; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:801
msgctxt "text_id=19698 | speaker=unknown"
msgid "      Hah! I never knew you put so much trust in me gab!"
msgstr "　　　うはっ、このほとばしる信頼感……！"

#. Occurrence NZ1:801:19699: voice_id=BA0_NZ1_0010; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:801
msgctxt "text_id=19699 | speaker=unknown"
msgid "      I'm not sure I can bear the pieces 'o eight."
msgstr "　　　頼られるって時に重いッス。"

#. Occurrence NZ1:801:19700: voice_id=BA0_NZ1_0010; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:801
msgctxt "text_id=19700 | speaker=unknown"
msgid "      Won't that heft just make me quake?"
msgstr "　　　というか、物理的に重いッス？"

#. Occurrence NZ1:877:19701: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0005; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:877
msgctxt "text_id=19701 | speaker=alice"
msgid "                  Robin..."
msgstr "　　　　　　ロビン。"

#. Occurrence NZ1:930:19702: voice_id=BA0_NZ1_0011; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:930
msgctxt "text_id=19702 | speaker=unknown"
msgid "                Ah, right."
msgstr "　　　　　チャッス。"

#. Occurrence NZ1:963:19703: voice_id=BA0_NZ1_0012; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:963
msgctxt "text_id=19703 | speaker=unknown"
msgid "So in this lesson, I'll be discussin' the most basic of basics^when it comes to familiars."
msgstr "　　今回は初歩の初歩、使い魔の説明っスよ。"

#. Occurrence NZ1:963:19704: voice_id=BA0_NZ1_0012; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:963
msgctxt "text_id=19704 | speaker=unknown"
msgid "I promise this'll be bright and breezy for ye newbies of magery."
msgstr "　　魔術オンチなイチゲンさんに優しい授業。"

#. Occurrence NZ1:963:19705: voice_id=BA0_NZ1_0012; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:963
msgctxt "text_id=19705 | speaker=unknown"
msgid "That's why it's \"The Wonderful World of Ploys,\" after all!"
msgstr "　　それが「なぜなにプロイ」なワケッスね。"

#. Occurrence NZ1:994:19706: voice_id=BA0_NZ1_0013; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:994
msgctxt "text_id=19706 | speaker=unknown"
msgid "  So tell us, Miss Alice, what exactly are familiars?"
msgstr "　で。この『使い魔』ってなんスかアリスさん。"

#. Occurrence NZ1:994:19707: voice_id=BA0_NZ1_0013; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:994
msgctxt "text_id=19707 | speaker=unknown"
msgid "  Explain it for someone who's never seen"
msgstr "　自分、生まれてこの方、"

#. Occurrence NZ1:994:19708: voice_id=BA0_NZ1_0013; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:994
msgctxt "text_id=19708 | speaker=unknown"
msgid "  or even heard of such a thing."
msgstr "　見たことも聞いたコトもないッスよ？"

#. Occurrence NZ1:1025:19709: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0006; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1025
msgctxt "text_id=19709 | speaker=alice"
msgid "          Okay. So familiars are sort of like"
msgstr "　　使い魔というのは、"

#. Occurrence NZ1:1025:19710: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0006; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1025
msgctxt "text_id=19710 | speaker=alice"
msgid "          robots that a mage controls."
msgstr "　　魔術師が使役するロボットみたいなものよ。"

#. Occurrence NZ1:1051:19711: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0007; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1051
msgctxt "text_id=19711 | speaker=alice"
msgid "Magecraft has always been a practice that requires mages to hole up inside their workshops for extended periods of study. We need an entity we can trust to collect materials, keep watch on the outside world, and eliminate outside threats for us."
msgstr "古来から、魔術師は工房にこもって研鑽を重ねるのが<生業|なりわい>だから。信頼できるモノに素材集めや外界の偵察、外敵の駆除を任せるの。"

#. Occurrence NZ1:1082:19712: voice_id=BA0_NZ1_0014; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1082
msgctxt "text_id=19712 | speaker=unknown"
msgid "  They're basically like a pawn."
msgstr "　　ただのコマ使いっスね。"

#. Occurrence NZ1:1082:19713: voice_id=BA0_NZ1_0014; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1082
msgctxt "text_id=19713 | speaker=unknown"
msgid "  'Ow they different from a disciple?"
msgstr "　　それは弟子とは違うんスか？"

#. Occurrence NZ1:1114:19714: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0008; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1114
msgctxt "text_id=19714 | speaker=alice"
msgid "    They are different in many ways."
msgstr "　　違うわ。"

#. Occurrence NZ1:1114:19715: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0008; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1114
msgctxt "text_id=19715 | speaker=alice"
msgid "    A master passes down wisdom to a disciple in the hopes that^    one day the disciple will succeed them."
msgstr "　　弟子というのは<業|わざ>を引き継いで師を越える後継者でしょう？"

#. Occurrence NZ1:1140:19716: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0009; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1140
msgctxt "text_id=19716 | speaker=alice"
msgid "    It is in fact a disciple's duty to surpass their master,"
msgstr "　　　<弟子|かれら>はいずれ師を超える義務があるし、"

#. Occurrence NZ1:1140:19717: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0009; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1140
msgctxt "text_id=19717 | speaker=alice"
msgid "    and a master would not accept a disciple they did not feel^    was capable of achieving that."
msgstr "　　　師も、そういうものでなければ弟子にはとらないわ。"

#. Occurrence NZ1:1166:19718: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0010; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1166
msgctxt "text_id=19718 | speaker=alice"
msgid "      Conversely, familiars are only capable of the abilities that^      they are imbued with at the time of their creation."
msgstr "　　　　でも使い魔は造られた時の性能がすべてだから。"

#. Occurrence NZ1:1166:19719: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0010; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1166
msgctxt "text_id=19719 | speaker=alice"
msgid "      You can't pass down any skills or wisdom to an entity that^      never grows."
msgstr "　　　　成長しないものを、後継ぎにはできないわ。"

#. Occurrence NZ1:1197:19720: voice_id=BA0_NZ1_0015; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1197
msgctxt "text_id=19720 | speaker=unknown"
msgid "I see. Guess that's why I never seem to learn anythin' new no matter 'ow many donkey's ears pass. Put another way, I've been perfect since birth."
msgstr "そっかー。道理でジブン、何年経っても記憶容量増えないワケッスねー。然るに、生まれた時から<完成|パーフェクト>だった、と。"

#. Occurrence NZ1:1230:19721: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0011; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1230
msgctxt "text_id=19721 | speaker=alice"
msgid "                  Yes, perfectly useless."
msgstr "　　　そうね。パーフェクトに役たたずね。"

#. Occurrence NZ1:1261:19722: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0012; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1261
msgctxt "text_id=19722 | speaker=alice"
msgid "  Many familiars are created by using a small animal as a base."
msgstr "使い魔の多くは小動物をベースに造られるわ。"

#. Occurrence NZ1:1261:19723: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0012; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1261
msgctxt "text_id=19723 | speaker=alice"
msgid "  That's because many familiars require magical energy from their^  mage owner to operate."
msgstr "これは、使い魔は術者からの魔力供給で活動するタイプが多いから。"

#. Occurrence NZ1:1287:19724: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0013; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1287
msgctxt "text_id=19724 | speaker=alice"
msgid "The larger the familiar, the more magical energy is required."
msgstr "使い魔は大きいほど魔力提供を必要とする。"

#. Occurrence NZ1:1287:19725: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0013; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1287
msgctxt "text_id=19725 | speaker=alice"
msgid "Small animals are convenient because they don't require much magical energy to create, and once they're made they can subsist on their own."
msgstr "だから魔力消費も少なく、造ってしまえば<栄養|どうりょく>を自力で補充できる小動物は便利なの。"

#. Occurrence NZ1:1320:19726: voice_id=BA0_NZ1_0016; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1320
msgctxt "text_id=19726 | speaker=unknown"
msgid "  Subsist? I've never 'unted for anyfing in me life!"
msgstr "　？　ジブン、狩りとかしたコトないッスよ？"

#. Occurrence NZ1:1320:19727: voice_id=BA0_NZ1_0016; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1320
msgctxt "text_id=19727 | speaker=unknown"
msgid "  I don't need protein or fiber or nothin' like that!"
msgstr "　蛋白質も食物繊維も要らないッス？"

#. Occurrence NZ1:1353:19728: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0014; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1353
msgctxt "text_id=19728 | speaker=alice"
msgid "  Right. Ploys are different from other living creatures."
msgstr "貴方たちプロイはまた別のくくり。"

#. Occurrence NZ1:1353:19729: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0014; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1353
msgctxt "text_id=19729 | speaker=alice"
msgid "  Anyway my point is, familiars are like servants or pets to mages."
msgstr "とにかく、魔術師たちにとって、使い魔は自分の命令を聞く「従者」「ペット」だと思えばいいわ。"

#. Occurrence NZ1:1394:19730: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0015; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1394
msgctxt "text_id=19730 | speaker=alice"
msgid "It's common to use animals like cats, birds, or mice as familiars."
msgstr "このように、猫や鳥、鼠を使い魔にするのが一般的ね。"

#. Occurrence NZ1:1433:19731: voice_id=BA0_NZ1_0017; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1433
msgctxt "text_id=19731 | speaker=unknown"
msgid "  Miss Alice, what about this dangerous-^  looking character 'ere?"
msgstr "　　アリスさん、この物騒なのは"

#. Occurrence NZ1:1433:19732: voice_id=BA0_NZ1_0017; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1433
msgctxt "text_id=19732 | speaker=unknown"
msgid "  What category would they be in?"
msgstr "　　どういうカテゴリーッスか？"

#. Occurrence NZ1:1464:19733: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0016; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1464
msgctxt "text_id=19733 | speaker=alice"
msgid "  This is an automaton, designed specifically for use in combat."
msgstr "　これは戦闘用に調律された自動人形。"

#. Occurrence NZ1:1464:19734: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0016; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1464
msgctxt "text_id=19734 | speaker=alice"
msgid "  It's really more like a sentinel than a familiar, to be honest."
msgstr "　ここまでくると<使い魔|ファミリア>というより<衛兵|センチネル>だけど。"

#. Occurrence NZ1:1490:19735: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0017; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1490
msgctxt "text_id=19735 | speaker=alice"
msgid "    Automata are a special case, entirely separate from the concept^    of a familiar."
msgstr "　　……これは使い魔のセオリーから外れた特注品よ。"

#. Occurrence NZ1:1490:19736: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0017; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1490
msgctxt "text_id=19736 | speaker=alice"
msgid "    Intelligent familiars who can get along with humans like yourself"
msgstr "　　また、アナタのように人間互換できる知性を持った使い魔も"

#. Occurrence NZ1:1490:19737: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0017; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1490
msgctxt "text_id=19737 | speaker=alice"
msgid "    are also a special case."
msgstr "　　特例にあたるわ。"

#. Occurrence NZ1:1526:19738: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0018; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1526
msgctxt "text_id=19738 | speaker=alice"
msgid "That said, they're a waste of energy-just too expensive to make."
msgstr "　　　でも、そんなのは魔力の無駄ね。コストが高いだけ。"

#. Occurrence NZ1:1526:19739: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0018; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1526
msgctxt "text_id=19739 | speaker=alice"
msgid "It would be faster for the mage to do most of the tasks on her own,"
msgstr "　　　たいていは術者本人が済ませた方が早かったり、"

#. Occurrence NZ1:1526:19740: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0018; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1526
msgctxt "text_id=19740 | speaker=alice"
msgid "and she can make a familiar with cheaper materials."
msgstr "　　　もっと安い材料で代用できるから。"

#. Occurrence NZ1:1557:19741: voice_id=BA0_NZ1_0018; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1557
msgctxt "text_id=19741 | speaker=unknown"
msgid "      It's a case of the ends not really"
msgstr "　　手段と結果を間違える、"

#. Occurrence NZ1:1557:19742: voice_id=BA0_NZ1_0018; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1557
msgctxt "text_id=19742 | speaker=unknown"
msgid "      justifyin' the means, eh?"
msgstr "　　ってやつッスね。"

#. Occurrence NZ1:1588:19743: voice_id=BA0_NZ1_0019_0; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1588
msgctxt "text_id=19743 | speaker=unknown"
msgid "  So from what you're sayin', seems familiars are always less^  powerful than their mage."
msgstr "　ん？　んじゃ、使い魔は術者より弱いんスね。"

#. Occurrence NZ1:1588:19744: voice_id=BA0_NZ1_0019_0; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1588
msgctxt "text_id=19744 | speaker=unknown"
msgid "  Always livin' in the shadow of their wings, eh?"
msgstr "　あくまで前座ってコトっスか？"

#. Occurrence NZ1:1599:19745: voice_id=BA0_NZ1_0019_1; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1599
msgctxt "text_id=19745 | speaker=unknown"
msgid "  What a bunch of useless freeloaders!"
msgstr "　うは、マジ使えないヤツらッスー！"

#. Occurrence NZ1:1631:19746: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0019; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1631
msgctxt "text_id=19746 | speaker=alice"
msgid "    How very short-sighted of you as usual, Robin."
msgstr "　　アナタらしい短絡思考ねロビン。"

#. Occurrence NZ1:1631:19747: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0019; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1631
msgctxt "text_id=19747 | speaker=alice"
msgid "    Sometimes I can't believe you're one of my"
msgstr "　　痺れるわ。これがわたしの使い魔だなんて、"

#. Occurrence NZ1:1631:19748: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0019; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1631
msgctxt "text_id=19748 | speaker=alice"
msgid "    familiars."
msgstr "　　どうにかなってしまいそう。"

#. Occurrence NZ1:1662:19749: voice_id=BA0_NZ1_0020; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1662
msgctxt "text_id=19749 | speaker=unknown"
msgid "        Miss Alice, why must your words excite"
msgstr "　アリスさん、"

#. Occurrence NZ1:1662:19750: voice_id=BA0_NZ1_0020; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1662
msgctxt "text_id=19750 | speaker=unknown"
msgid "        yet your expression be a fright?"
msgstr "　言葉はステキなのにどうして顔が怖いんスか？"

#. Occurrence NZ1:1693:19751: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0020; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1693
msgctxt "text_id=19751 | speaker=alice"
msgid "  Even if they have only one-tenth the power of their mage,"
msgstr "　術者の十分の一ぐらいの性能しかなくても、"

#. Occurrence NZ1:1693:19752: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0020; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1693
msgctxt "text_id=19752 | speaker=alice"
msgid "  it's actually quite easy to create a familiar that is stronger^  than their master."
msgstr "　本人より“強い”使い魔を造る事は簡単よ。"

#. Occurrence NZ1:1724:19753: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0021; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1724
msgctxt "text_id=19753 | speaker=alice"
msgid "      Maybe next time I'll try embedding"
msgstr "　　試しに、こんどアナタのお腹に"

#. Occurrence NZ1:1724:19754: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0021; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1724
msgctxt "text_id=19754 | speaker=alice"
msgid "      a derringer in your stomach or something."
msgstr "　　デリンジャーを埋め込んでみましょうか。"

#. Occurrence NZ1:1755:19755: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0022; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1755
msgctxt "text_id=19755 | speaker=alice"
msgid "  You won't be able to laugh or cry or fly anymore,"
msgstr "　泣いたり笑ったり飛んだりはできなくなるけど、"

#. Occurrence NZ1:1755:19756: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0022; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1755
msgctxt "text_id=19756 | speaker=alice"
msgid "  but you can at least scare the stuffing out of anyone that^  crosses us, that's for sure."
msgstr "　相手を驚かせるぐらいはできるわ、きっと。"

#. Occurrence NZ1:1832:19757: voice_id=BA0_NZ1_0021; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1832
msgctxt "text_id=19757 | speaker=unknown"
msgid "      Ohhhhhh! Robin the Firecracker!"
msgstr "　　コ―――コマドリ・ザ・クラッカー！"

#. Occurrence NZ1:1832:19758: voice_id=BA0_NZ1_0021; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1832
msgctxt "text_id=19758 | speaker=unknown"
msgid "      That's so chicken and rice!"
msgstr "　　かっちょいいッスー！"

#. Occurrence NZ1:1832:19759: voice_id=BA0_NZ1_0021; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1832
msgctxt "text_id=19759 | speaker=unknown"
msgid "      Looks like I'll be a 'uge hit this Christmas!"
msgstr "　　クリスマスに大活躍の予感……！"

#. Occurrence NZ1:1868:19760: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0023; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1868
msgctxt "text_id=19760 | speaker=alice"
msgid "    I'm talking about a cap gun, just so you're aware."
msgstr "　　　まさに豆鉄砲ね。"

#. Occurrence NZ1:1868:19761: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0023; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1868
msgctxt "text_id=19761 | speaker=alice"
msgid "    Maybe that's a better idea, though. One pop and you're^    out of my hair forever."
msgstr "　　　そのまま消費されてくれないかしら。"

#. Occurrence NZ1:1901:19762: voice_id=BA0_NZ1_0022; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1901
msgctxt "text_id=19762 | speaker=unknown"
msgid "  Hey, come on, now yer just bein' mean."
msgstr "　　なんか当たりキツイッス。"

#. Occurrence NZ1:1901:19763: voice_id=BA0_NZ1_0022; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1901
msgctxt "text_id=19763 | speaker=unknown"
msgid "  Anyway, I think you've pretty much covered the basics."
msgstr "　　でも、これで大まかな説明はしたっスね。"

#. Occurrence NZ1:1927:19764: voice_id=BA0_NZ1_0023; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1927
msgctxt "text_id=19764 | speaker=unknown"
msgid "A familiar is like a robot that protects its mage creator,"
msgstr "　使い魔は魔術師を守るロボットで、"

#. Occurrence NZ1:1927:19765: voice_id=BA0_NZ1_0023; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1927
msgctxt "text_id=19765 | speaker=unknown"
msgid "and its abilities are entirely up to the mage that makes it."
msgstr "　その性能は造った魔術師によってマチマチ、と。"

#. Occurrence NZ1:1958:19766: voice_id=BA0_NZ1_0024; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1958
msgctxt "text_id=19766 | speaker=unknown"
msgid "    Hm, so wait. I know you're a top class mage, Alice,"
msgstr "　ん？　万能感あふれるアリスさんはともかく、"

#. Occurrence NZ1:1958:19767: voice_id=BA0_NZ1_0024; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1958
msgctxt "text_id=19767 | speaker=unknown"
msgid "    but what would 'appen if someone like Aoko made a familiar?"
msgstr "　青子さんが使い魔を造ったらどうなるッスか？"

#. Occurrence NZ1:1958:19768: voice_id=BA0_NZ1_0024; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:1958
msgctxt "text_id=19768 | speaker=unknown"
msgid "    Would it just blow itself up immediately or somethin'?"
msgstr "　やっぱり、起動・即・自爆？"

#. Occurrence NZ1:1989:19769: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0024; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1989
msgctxt "text_id=19769 | speaker=alice"
msgid "  What a ridiculous hypothesis."
msgstr "　あり得ない仮定ね。"

#. Occurrence NZ1:1989:19770: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0024; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:1989
msgctxt "text_id=19770 | speaker=alice"
msgid "  Aoko doesn't even have the capabilities to begin creating a familiar yet."
msgstr "　青子には使い魔を造るだけの技量はないもの。"

#. Occurrence NZ1:2020:19771: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0025; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:2020
msgctxt "text_id=19771 | speaker=alice"
msgid "    She can only destroy things, remember?"
msgstr "　そもそも、彼女は壊す事しかできないのよ？"

#. Occurrence NZ1:2020:19772: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0025; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:2020
msgctxt "text_id=19772 | speaker=alice"
msgid "    If she gave up her lone skill to a familiar,"
msgstr "　その唯一の特技を使い魔に任せてしまったら、"

#. Occurrence NZ1:2020:19773: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0025; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:2020
msgctxt "text_id=19773 | speaker=alice"
msgid "    she would lose her entire reason to even exist."
msgstr "　存在意義も跡形もなく壊れてしまうわ。"

#. Occurrence NZ1:2051:19774: voice_id=BA0_NZ1_0025; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:2051
msgctxt "text_id=19774 | speaker=unknown"
msgid "Hahaha!"
msgstr "　　ハハハ。"

#. Occurrence NZ1:2051:19775: voice_id=BA0_NZ1_0025; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:2051
msgctxt "text_id=19775 | speaker=unknown"
msgid "Never one to mince yer words, Angel Mum."
msgstr "　　さりげにひどい発言ッス。"

#. Occurrence NZ1:2082:19776: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0026; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:2082
msgctxt "text_id=19776 | speaker=alice"
msgid "  Aoko has no reason to use a familiar for combat."
msgstr "戦闘において、青子は使い魔に任せる必要がない。"

#. Occurrence NZ1:2082:19777: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0026; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:2082
msgctxt "text_id=19777 | speaker=alice"
msgid "  Conversely, I can't fight at all so..."
msgstr "逆に、私は戦う事はできないから―――"

#. Occurrence NZ1:2113:19778: voice_id=BA0_NZ1_0026; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:2113
msgctxt "text_id=19778 | speaker=unknown"
msgid "      Ah, makes eighteen pence."
msgstr "　　なるほどー。"

#. Occurrence NZ1:2113:19779: voice_id=BA0_NZ1_0026; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:2113
msgctxt "text_id=19779 | speaker=unknown"
msgid "      Aoko is strong all by herself."
msgstr "　　青子さんは青子さん自身が強い。"

#. Occurrence NZ1:2113:19780: voice_id=BA0_NZ1_0026; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:2113
msgctxt "text_id=19780 | speaker=unknown"
msgid "      You surround yourself with strong allies."
msgstr "　　アリスさんはアリスさんの周りが強い。"

#. Occurrence NZ1:2153:19781: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0027; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:2153
msgctxt "text_id=19781 | speaker=alice"
msgid "  Right. If you were to compare it to chess,"
msgstr "　チェス……いえ、将棋で喩えるなら、"

#. Occurrence NZ1:2153:19782: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0027; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:2153
msgctxt "text_id=19782 | speaker=alice"
msgid "  Aoko would be a strong piece that could stand on its own,^  like the queen."
msgstr "　青子は王将（角・飛車の能力アリ）だけの陣営。"

#. Occurrence NZ1:2179:19783: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0028; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:2179
msgctxt "text_id=19783 | speaker=alice"
msgid " I, on the other hand, utilize many pieces but I myself^ only have the strength of a pawn."
msgstr "わたしは陣営こそ強力だけど、王将自体が「歩」の^能力しかない、というイメージね。"

#. Occurrence NZ1:2218:19784: voice_id=BA0_NZ1_0027; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:2218
msgctxt "text_id=19784 | speaker=unknown"
msgid " Ah, yes, I see!"
msgstr "　そーッス、アリスさんは"

#. Occurrence NZ1:2218:19785: voice_id=BA0_NZ1_0027; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:2218
msgctxt "text_id=19785 | speaker=unknown"
msgid " I forgot just how weak and out of shape you are!"
msgstr "　体力も運動神経もない運痴キャラだったッス！"

#. Occurrence NZ1:2249:19786: voice_id=BA0_NZ1_0028; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:2249
msgctxt "text_id=19786 | speaker=unknown"
msgid "    You can only barely dog paddle to swim,"
msgstr "　　泳ぎは犬かきしかできない、"

#. Occurrence NZ1:2249:19787: voice_id=BA0_NZ1_0028; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:2249
msgctxt "text_id=19787 | speaker=unknown"
msgid "    can't do a single push-up, can't ride a bicycle,"
msgstr "　　鉄棒もできなければ自転車にも乗れない、"

#. Occurrence NZ1:2275:19788: voice_id=BA0_NZ1_0029; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:2275
msgctxt "text_id=19788 | speaker=unknown"
msgid "      and spend gym class sitting around doing^      mostly nuffin'."
msgstr "体育の時間は校庭のはじっこで座っているだけのカ^ンタンなお仕事。"

#. Occurrence NZ1:2306:19789: voice_id=BA0_NZ1_0030_0; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:2306
msgctxt "text_id=19789 | speaker=unknown"
msgid "    But that's fine! You're right Robin Hood!"
msgstr "　だがそれがいい！"

#. Occurrence NZ1:2306:19790: voice_id=BA0_NZ1_0030_0; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:2306
msgctxt "text_id=19790 | speaker=unknown"
msgid "    And if we get down to brass tacts, its 'cause I'm always tailin' you!"
msgstr "　ジブン、盗撮してるから知ってるッスよー！"

#. Occurrence NZ1:2319:19791: voice_id=BA0_NZ1_0030_1; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:2319
msgctxt "text_id=19791 | speaker=unknown"
msgid "    My Angel Mum... You are far too beautiful to exert yourself."
msgstr "　マイ天使よ、ただ美しく"

#. Occurrence NZ1:2336:19792: voice_id=BA0_NZ1_0030_2; voice_prefix=BA0; voice_category=0; scene=NZ1
#: NZ1:2336
msgctxt "text_id=19792 | speaker=unknown"
msgid "Hm?!"
msgstr "アレ！？"

#. Occurrence NZ1:2404:19793: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0029; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:2404
msgctxt "text_id=19793 | speaker=alice"
msgid "            ...You are incredibly vile, do you know that?"
msgstr "　　……失礼ね。"

#. Occurrence NZ1:2404:19794: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ1_0029; voice_prefix=A40; voice_category=2; scene=NZ1
#: NZ1:2404
msgctxt "text_id=19794 | speaker=alice"
msgid "            I'll have you know I can jog short distances."
msgstr "　　わたしだって、走るだけなら少しはこなせるわ。"

#. Occurrence NZ2:108:19795: voice_id=BA0_NZ2_0000; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:108
msgctxt "text_id=19795 | speaker=unknown"
msgid "      'Ello there!"
msgstr "　　　コンチハ。"

#. Occurrence NZ2:108:19796: voice_id=BA0_NZ2_0000; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:108
msgctxt "text_id=19796 | speaker=unknown"
msgid "      Relieved of his daily guard duties,"
msgstr "　　　日課のマンウォッチをこなし、"

#. Occurrence NZ2:108:19797: voice_id=BA0_NZ2_0000; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:108
msgctxt "text_id=19797 | speaker=unknown"
msgid "      a blue shadow descends upon the garden."
msgstr "　　　さっそうと園に降り立つ青い影。"

#. Occurrence NZ2:139:19798: voice_id=BA0_NZ2_0001; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:139
msgctxt "text_id=19798 | speaker=unknown"
msgid "    When all's said and done, this bird has landed with aplomb."
msgstr "さしずめ、鳥は舞い降りた、というところッスか。"

#. Occurrence NZ2:139:19799: voice_id=BA0_NZ2_0001; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:139
msgctxt "text_id=19799 | speaker=unknown"
msgid "    I'm 'ere to get started with another lecture in this"
msgstr "今回はここ、アリスさんが指定した"

#. Occurrence NZ2:139:19800: voice_id=BA0_NZ2_0001; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:139
msgctxt "text_id=19800 | speaker=unknown"
msgid "    special location requested by Miss Alice herself."
msgstr "特設会場でレクチャーを始めるんスけど……"

#. Occurrence NZ2:170:19801: voice_id=BA0_NZ2_0002; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:170
msgctxt "text_id=19801 | speaker=unknown"
msgid "    As you can see, it's nothin' special-just an ordinary garden."
msgstr "　　ここ、どう見てもフツーの園ッスよね。"

#. Occurrence NZ2:170:19802: voice_id=BA0_NZ2_0002; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:170
msgctxt "text_id=19802 | speaker=unknown"
msgid "    Now where could that Alice be?"
msgstr "　　アリスさんはどこに……"

#. Occurrence NZ2:197:19803: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0000; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:197
msgctxt "text_id=19803 | speaker=alice"
msgid "      I've been waiting for you, Robin."
msgstr "　　　遅かったわねロビン。"

#. Occurrence NZ2:197:19804: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0000; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:197
msgctxt "text_id=19804 | speaker=alice"
msgid "      You do realize you're a part of this^      lecture series too, right?"
msgstr "　　　出演者としての自覚はあるのかしら。"

#. Occurrence NZ2:223:19805: voice_id=BA0_NZ2_0003; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:223
msgctxt "text_id=19805 | speaker=unknown"
msgid "  Huh?! I can 'ear you but I don't see you anywhere!"
msgstr "　　ハッ！？　声はすれども姿はなしッス！？"

#. Occurrence NZ2:223:19806: voice_id=BA0_NZ2_0003; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:223
msgctxt "text_id=19806 | speaker=unknown"
msgid "  What kind of trick are you tryin' to pull?"
msgstr "　　ここには園児しかいないというのに、"

#. Occurrence NZ2:223:19807: voice_id=BA0_NZ2_0003; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:223
msgctxt "text_id=19807 | speaker=unknown"
msgid "  Where the 'eck are you, Alice?!"
msgstr "　　アリスさんは何処に！？"

#. Occurrence NZ2:260:19808: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0001; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:260
msgctxt "text_id=19808 | speaker=alice"
msgid "            I'm right here."
msgstr "　　　　　　ここよ。"

#. Occurrence NZ2:291:19809: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0002; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:291
msgctxt "text_id=19809 | speaker=alice"
msgid "    The Wonderful World of Ploys."
msgstr "　　　なぜなにー、プロイー。"

#. Occurrence NZ2:344:19810: voice_id=BA0_NZ2_0004; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:344
msgctxt "text_id=19810 | speaker=unknown"
msgid "                    ..."
msgstr "　　　　　　―――。"

#. Occurrence NZ2:397:19811: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0003; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:397
msgctxt "text_id=19811 | speaker=alice"
msgid "      The Wonderful World of Ploys."
msgstr "　　なぜなにー、プロイー。"

msgctxt "text_id=19812 | speaker=unknown"
msgid "      ...Well, aren't you going to speak, Robin?"
msgstr "　　…………なぜ黙っているのかしら、ロビン？"

#. Occurrence NZ2:430:19813: voice_id=BA0_NZ2_0005; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:430
msgctxt "text_id=19813 | speaker=unknown"
msgid "    Erm, yeah. I'm 'ere to bubble and squeak."
msgstr "　いや、別になんでもないッス。"

#. Occurrence NZ2:430:19814: voice_id=BA0_NZ2_0005; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:430
msgctxt "text_id=19814 | speaker=unknown"
msgid "    I was just a little startled is all, seeing as 'ow"
msgstr "　ジブン的には、何の違和感もなかったところが"

#. Occurrence NZ2:430:19815: voice_id=BA0_NZ2_0005; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:430
msgctxt "text_id=19815 | speaker=unknown"
msgid "    I didn't really notice anyfink out the ordinary."
msgstr "　よけい怖かっただけッス。"

#. Occurrence NZ2:461:19816: voice_id=BA0_NZ2_0006; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:461
msgctxt "text_id=19816 | speaker=unknown"
msgid "    That's my Angel Alice, she is."
msgstr "　　さすがマイ天使であるところのアリスさん。"

#. Occurrence NZ2:461:19817: voice_id=BA0_NZ2_0006; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:461
msgctxt "text_id=19817 | speaker=unknown"
msgid "    You always scrub up real nice."
msgstr "　　なにを着てもヤバイぐらい似合うッス。"

#. Occurrence NZ2:461:19818: voice_id=BA0_NZ2_0006; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:461
msgctxt "text_id=19818 | speaker=unknown"
msgid "    Like a right proper lady."
msgstr "　　ほんとバイヤー。"

#. Occurrence NZ2:494:19819: voice_id=BA0_NZ2_0007; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:494
msgctxt "text_id=19819 | speaker=unknown"
msgid "    Anyway..."
msgstr "　　ところで。"

#. Occurrence NZ2:494:19820: voice_id=BA0_NZ2_0007; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:494
msgctxt "text_id=19820 | speaker=unknown"
msgid "    Quick question, what exactly are we doing 'ere?"
msgstr "　　素朴な疑問なんスけど、ここで何を？"

#. Occurrence NZ2:494:19821: voice_id=BA0_NZ2_0007; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:494
msgctxt "text_id=19821 | speaker=unknown"
msgid "    And why?"
msgstr "　　あと何で？"

#. Occurrence NZ2:525:19822: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0004; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:525
msgctxt "text_id=19822 | speaker=alice"
msgid "    I just thought it'd be a good idea to change things up a bit."
msgstr "　マンネリズムはよくないでしょう？"

#. Occurrence NZ2:525:19823: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0004; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:525
msgctxt "text_id=19823 | speaker=alice"
msgid "    It goes against my aesthetics to keep using the same props"
msgstr "　オマケコーナーだからって素材を使い回すのはわたしの美学に"

#. Occurrence NZ2:525:19824: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0004; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:525
msgctxt "text_id=19824 | speaker=alice"
msgid "    and setting every time. This isn't some kind of dojo."
msgstr "　反するわ。なんとか道場じゃあるまいし。"

#. Occurrence NZ2:558:19825: voice_id=BA0_NZ2_0008; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:558
msgctxt "text_id=19825 | speaker=unknown"
msgid "    So that's why you moved the lecture 'ere!"
msgstr "　　だから場所を変えたッスか。"

#. Occurrence NZ2:558:19826: voice_id=BA0_NZ2_0008; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:558
msgctxt "text_id=19826 | speaker=unknown"
msgid "    I see, I see. I gots me an earwig."
msgstr "　　なるほど。それはおおむね理解したッス。"

#. Occurrence NZ2:558:19827: voice_id=BA0_NZ2_0008; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:558
msgctxt "text_id=19827 | speaker=unknown"
msgid "    Aoko's a surprisingly big spender."
msgstr "　　青子さんもビックリの浪費家ぶりっス。"

#. Occurrence NZ2:589:19828: voice_id=BA0_NZ2_0009; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:589
msgctxt "text_id=19828 | speaker=unknown"
msgid "    I prefer a dress rather than a smock, though. I fink it makes you look like a^    goddess! Not saying a smock is bad, but it's all about image. How powerful^    would this butcher's hook be if it were in a painting? That kinda thing."
msgstr "でもジブン、スモックよりワンピの方が好みなんスよね。ドレスみたいなの。女神っぽいの。いや、スモックがダメという話ではなくてッスね、あくまでイメージの問題？　絵画にした時の説得力？"

#. Occurrence NZ2:614:19829: voice_id=BA0_NZ2_0010; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:614
msgctxt "text_id=19829 | speaker=unknown"
msgid "Say you have a painting of a forest and a bird and some children. If the impact of the kids is too strong, you'd lose focus of the bird."
msgstr "『森と鳥と少女』みたいな？ほら、『鳥と園児』じゃ園児のインパクトが強すぎて鳥にフォーカスがあたらないっつーか、"

#. Occurrence NZ2:646:19830: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0005; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:646
msgctxt "text_id=19830 | speaker=alice"
msgid "      Oh no! I forgot I was in the middle of^      making some sweets."
msgstr "　　　いけない。菓子作りの途中だったわ。"

#. Occurrence NZ2:699:19831: voice_id=BA0_NZ2_0011; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:699
msgctxt "text_id=19831 | speaker=unknown"
msgid "Annnnnnd I'm being ignored."
msgstr "ナチュラルに無視。"

#. Occurrence NZ2:699:19832: voice_id=BA0_NZ2_0011; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:699
msgctxt "text_id=19832 | speaker=unknown"
msgid "So, Miss Alice, what is it that you do all day anyway?"
msgstr "ところで、アリスさんは普段なにをやってるッスか？"

#. Occurrence NZ2:725:19833: voice_id=BA0_NZ2_0012; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:725
msgctxt "text_id=19833 | speaker=unknown"
msgid "    Aoko's the student council president."
msgstr "　　青子さんは生徒会。"

#. Occurrence NZ2:725:19834: voice_id=BA0_NZ2_0012; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:725
msgctxt "text_id=19834 | speaker=unknown"
msgid "    Soujyuro's got his work."
msgstr "　　シャバ僧はアルバイト。"

#. Occurrence NZ2:725:19835: voice_id=BA0_NZ2_0012; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:725
msgctxt "text_id=19835 | speaker=unknown"
msgid "    D'you just mind the old rat and mouse?"
msgstr "　　アリスさんは帰宅部ッス？"

#. Occurrence NZ2:781:19836: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0006; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:781
msgctxt "text_id=19836 | speaker=alice"
msgid " I do exactly what you see here."
msgstr "見ての通りよ。"

#. Occurrence NZ2:781:19837: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0006; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:781
msgctxt "text_id=19837 | speaker=alice"
msgid " I spend my free time making Ploys."
msgstr "時間があればプロイを作っているわ。"

#. Occurrence NZ2:812:19838: voice_id=BA0_NZ2_0013; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:812
msgctxt "text_id=19838 | speaker=unknown"
msgid "  Wow!"
msgstr "わー。"

#. Occurrence NZ2:812:19839: voice_id=BA0_NZ2_0013; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:812
msgctxt "text_id=19839 | speaker=unknown"
msgid "  You're just like a witch in those old fairy tales."
msgstr "まんま、童話の魔女のイメージっス。"

#. Occurrence NZ2:812:19840: voice_id=BA0_NZ2_0013; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:812
msgctxt "text_id=19840 | speaker=unknown"
msgid "  I didn't know you made Ploys in a cauldron."
msgstr "プロイって鍋で作ってたッスか。"

#. Occurrence NZ2:843:19841: voice_id=BA0_NZ2_0014; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:843
msgctxt "text_id=19841 | speaker=unknown"
msgid "        And what's that smell? Chocolate?!"
msgstr "　っていうか、この匂いはチョコレイト？"

#. Occurrence NZ2:843:19842: voice_id=BA0_NZ2_0014; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:843
msgctxt "text_id=19842 | speaker=unknown"
msgid "        Wait a tick..."
msgstr "　まさか……"

#. Occurrence NZ2:843:19843: voice_id=BA0_NZ2_0014; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:843
msgctxt "text_id=19843 | speaker=unknown"
msgid "        Are Ploys made of sweets?!"
msgstr "　プロイってお菓子だったんスかーーーー！？"

#. Occurrence NZ2:895:19844: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0007; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:895
msgctxt "text_id=19844 | speaker=alice"
msgid "    Robin... You're a Ploy yourself."
msgstr "　　……アナタね。プロイのくせに、"

#. Occurrence NZ2:895:19845: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0007; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:895
msgctxt "text_id=19845 | speaker=alice"
msgid "    Are you telling me you don't know what Ploys are made of?"
msgstr "　　プロイの仕組みを知らないの？"

#. Occurrence NZ2:895:19846: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0007; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:895
msgctxt "text_id=19846 | speaker=alice"
msgid "    Maybe you're just a regular bird after all."
msgstr "　　気付きたくはなかったけれど、やっぱりただの鳥だった？"

#. Occurrence NZ2:926:19847: voice_id=BA0_NZ2_0015; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:926
msgctxt "text_id=19847 | speaker=unknown"
msgid "  Hey look, I don't know anyfink about that sort!"
msgstr "　そのあたり、ジブンでもよく分からないッス。"

#. Occurrence NZ2:926:19848: voice_id=BA0_NZ2_0015; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:926
msgctxt "text_id=19848 | speaker=unknown"
msgid "  Pretty sure I know how Ploys work, though."
msgstr "　でもプロイの仕組みは分かるッスよ。"

#. Occurrence NZ2:926:19849: voice_id=BA0_NZ2_0015; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:926
msgctxt "text_id=19849 | speaker=unknown"
msgid "  Because..."
msgstr "　なぜなら―――"

#. Occurrence NZ2:973:19850: voice_id=BA0_NZ2_0016; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:973
msgctxt "text_id=19850 | speaker=unknown"
msgid "      Of course, our lovely Alice 'ere will give"
msgstr "　　なぜなら、これからアリスさんが"

#. Occurrence NZ2:973:19851: voice_id=BA0_NZ2_0016; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:973
msgctxt "text_id=19851 | speaker=unknown"
msgid "      a gloss deeper 'n the housemaid's knee"
msgstr "　　海より深く<宙|そら>より広く、"

#. Occurrence NZ2:973:19852: voice_id=BA0_NZ2_0016; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:973
msgctxt "text_id=19852 | speaker=unknown"
msgid "      and broader than the skies above! Right?!"
msgstr "　　かっちょいい説明してくれるからッス！"

#. Occurrence NZ2:1004:19853: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0008; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1004
msgctxt "text_id=19853 | speaker=alice"
msgid "    What more can I add to the ^    explanation in the main story?"
msgstr "　　本編で説明している通りよ。"

#. Occurrence NZ2:1004:19854: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0008; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1004
msgctxt "text_id=19854 | speaker=alice"
msgid "    We're done here. Class dismissed."
msgstr "　　以上、解散。"

#. Occurrence NZ2:1038:19855: voice_id=BA0_NZ2_0017; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1038
msgctxt "text_id=19855 | speaker=unknown"
msgid "  You're really trying to kill this segment, aren't you!"
msgstr "　　　このコーナーの根底を崩す一言ッスね。"

#. Occurrence NZ2:1070:19856: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0009; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1070
msgctxt "text_id=19856 | speaker=alice"
msgid "          Got any better ideas?"
msgstr "　　　　何か意見があって？"

#. Occurrence NZ2:1101:19857: voice_id=BA0_NZ2_0018; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1101
msgctxt "text_id=19857 | speaker=unknown"
msgid "    Nah."
msgstr "　　ないッス。"

#. Occurrence NZ2:1101:19858: voice_id=BA0_NZ2_0018; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1101
msgctxt "text_id=19858 | speaker=unknown"
msgid "    I at least wanted you to give a brief overview or somethin'!"
msgstr "　　でも、せめて概要だけでもレクチャーしてほしいッス。"

#. Occurrence NZ2:1101:19859: voice_id=BA0_NZ2_0018; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1101
msgctxt "text_id=19859 | speaker=unknown"
msgid "    Wouldn't want us to look worse than that dojo!"
msgstr "　　これじゃこのコーナー、なんとか道場以下ッスよ？"

#. Occurrence NZ2:1132:19860: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0010; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1132
msgctxt "text_id=19860 | speaker=alice"
msgid "...I suppose I do want to avoid that."
msgstr "………………それは避けたいわね。"

#. Occurrence NZ2:1132:19861: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0010; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1132
msgctxt "text_id=19861 | speaker=alice"
msgid "All right, fine..."
msgstr "それじゃあ……"

#. Occurrence NZ2:1172:19862: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0011; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1172
msgctxt "text_id=19862 | speaker=alice"
msgid "      I'll talk a little bit about how Ploy Kickshaws are made."
msgstr "　これがプロイキッシャーの綴り。"

#. Occurrence NZ2:1172:19863: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0011; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1172
msgctxt "text_id=19863 | speaker=alice"
msgid "      But that's all I'm going to discuss today, got it?"
msgstr "　これだけで説明になると思うのだけど、どう？"

#. Occurrence NZ2:1204:19864: voice_id=BA0_NZ2_0019; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1204
msgctxt "text_id=19864 | speaker=unknown"
msgid "          Ploy... Kisshaws...?"
msgstr "　　　ぷろい？　きっくしゃー？"

#. Occurrence NZ2:1235:19865: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0012; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1235
msgctxt "text_id=19865 | speaker=alice"
msgid "      That's just how you pronounce it. The \"ck\" sound is almost"
msgstr "キックシャーのクはほとんどサイレントよ。"

#. Occurrence NZ2:1235:19866: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0012; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1235
msgctxt "text_id=19866 | speaker=alice"
msgid "      entirely silent. A kickshaw is what the Europeans call an"
msgstr "西欧圏の、子供のオモチャ、子供だまし、軽蔑的に珍しいもの、"

#. Occurrence NZ2:1235:19867: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0012; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1235
msgctxt "text_id=19867 | speaker=alice"
msgid "      insignificant children's toy or trinket."
msgstr "といった意味ね。"

#. Occurrence NZ2:1266:19868: voice_id=BA0_NZ2_0020; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1266
msgctxt "text_id=19868 | speaker=unknown"
msgid "  Oh, I knew that!"
msgstr "　あ。知ってるッス、"

#. Occurrence NZ2:1266:19869: voice_id=BA0_NZ2_0020; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1266
msgctxt "text_id=19869 | speaker=unknown"
msgid "  I've also 'eard it used in the bed-"
msgstr "　それ変人の意味でも用い―――"

#. Occurrence NZ2:1337:19870: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0013; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1337
msgctxt "text_id=19870 | speaker=alice"
msgid "      Ploys are similar in that here in Japan"
msgstr "　　　プロイも同様に西欧圏のオモチャで、"

#. Occurrence NZ2:1337:19871: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0013; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1337
msgctxt "text_id=19871 | speaker=alice"
msgid "      we use them to play pretend war and simulate combat."
msgstr "　　　こっちは戦争ごっこに使われるもの。"

#. Occurrence NZ2:1337:19872: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0013; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1337
msgctxt "text_id=19872 | speaker=alice"
msgid "      They are a kind of children's educational tool."
msgstr "　　　子供の教育用玩具の総称ね。"

#. Occurrence NZ2:1368:19873: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0014; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1368
msgctxt "text_id=19873 | speaker=alice"
msgid "      Ploy is also another word for strategy or battle plan,"
msgstr "　戦略、戦術の俗語でもあり、"

#. Occurrence NZ2:1368:19874: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0014; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1368
msgctxt "text_id=19874 | speaker=alice"
msgid "      and in Scotland it has...well, another meaning."
msgstr "　スコットランドだと……な意味もあるけれど、"

#. Occurrence NZ2:1368:19875: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0014; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1368
msgctxt "text_id=19875 | speaker=alice"
msgid "      That one's not important."
msgstr "　それは忘れて。"

#. Occurrence NZ2:1402:19876: voice_id=BA0_NZ2_0021; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1402
msgctxt "text_id=19876 | speaker=unknown"
msgid "        Hmm. So basically you just threw a bottle of glue"
msgstr "　ふむ。この二つの単語をむりやり繋げたのが"

#. Occurrence NZ2:1402:19877: voice_id=BA0_NZ2_0021; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1402
msgctxt "text_id=19877 | speaker=unknown"
msgid "        at two words to make \"Ploy Kickshaw\" then?"
msgstr "　プロイキッシャーなんスね。"

#. Occurrence NZ2:1402:19878: voice_id=BA0_NZ2_0021; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1402
msgctxt "text_id=19878 | speaker=unknown"
msgid "        Did you whip up this bit of word salad, Miss Alice?"
msgstr "　もしかしてアリスさんオリジナル？"

#. Occurrence NZ2:1433:19879: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0015; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1433
msgctxt "text_id=19879 | speaker=alice"
msgid "...It's a unique kind of magecraft passed down to me from my mother."
msgstr "……わたしの母に伝わっていた独自の魔術系統よ。"

#. Occurrence NZ2:1433:19880: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0015; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1433
msgctxt "text_id=19880 | speaker=alice"
msgid "We never registered it with the Mage's Association to earn royalties from it or anything cheap like that."
msgstr "魔術協会に公開して権利と利益を得る、なんて低俗^な事はしていないから。"

#. Occurrence NZ2:1466:19881: voice_id=BA0_NZ2_0022; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1466
msgctxt "text_id=19881 | speaker=unknown"
msgid "   Eh, I guess even if you did you'd still be the only"
msgstr "　　まあ、公開したところでアリスさんにしか"

#. Occurrence NZ2:1466:19882: voice_id=BA0_NZ2_0022; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1466
msgctxt "text_id=19882 | speaker=unknown"
msgid "   one who could actually use it!"
msgstr "　　扱えないんですけどね！"

#. Occurrence NZ2:1466:19883: voice_id=BA0_NZ2_0022; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1466
msgctxt "text_id=19883 | speaker=unknown"
msgid "   Bound by that Meinster blood I suppose!"
msgstr "　　マインスターの血に縛られてるッス！"

#. Occurrence NZ2:1497:19884: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0016; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1497
msgctxt "text_id=19884 | speaker=alice"
msgid "    Robin..."
msgstr "　　……アナタ、"

#. Occurrence NZ2:1497:19885: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0016; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1497
msgctxt "text_id=19885 | speaker=alice"
msgid "    Have you understood a thing I've said so far?"
msgstr "　　本当はちゃんと分かっているんじゃないの？"

#. Occurrence NZ2:1528:19886: voice_id=BA0_NZ2_0023; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1528
msgctxt "text_id=19886 | speaker=unknown"
msgid "Hm? Sorry, forgot what I was chirpin' about."
msgstr "？　すまないッス、今なに言ったのか忘れたッス。"

#. Occurrence NZ2:1528:19887: voice_id=BA0_NZ2_0023; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1528
msgctxt "text_id=19887 | speaker=unknown"
msgid "I'm more unsure of the past than I am of the future, is all."
msgstr "ジブン、昔のコトは未来よりあやふやッスから。"

#. Occurrence NZ2:1559:19888: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0017; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1559
msgctxt "text_id=19888 | speaker=alice"
msgid "  ..."
msgstr "　……。"

#. Occurrence NZ2:1559:19889: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0017; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1559
msgctxt "text_id=19889 | speaker=alice"
msgid "  Who exactly were you referring to^  when you said Meinster?"
msgstr "　マインスターというのは、なに？"

#. Occurrence NZ2:1608:19890: voice_id=BA0_NZ2_0024; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1608
msgctxt "text_id=19890 | speaker=unknown"
msgid "        Goddess Mum! Your mother, of course."
msgstr "マイ女神ッス。アリスさんの母君ッスね。"

#. Occurrence NZ2:1608:19891: voice_id=BA0_NZ2_0024; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1608
msgctxt "text_id=19891 | speaker=unknown"
msgid "        People called her a pure-blooded Witch."
msgstr "あと、純血の魔女とか、いかにもなセカンドネームがあったッス。"

#. Occurrence NZ2:1641:19892: voice_id=BA0_NZ2_0025; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1641
msgctxt "text_id=19892 | speaker=unknown"
msgid "    Though she always was a bit of a bandwagoner,"
msgstr "　　でも母君、ミーハーだったんスよね。"

#. Occurrence NZ2:1641:19893: voice_id=BA0_NZ2_0025; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1641
msgctxt "text_id=19893 | speaker=unknown"
msgid "    your mum. Always chasing the latest trends..."
msgstr "　　流行り物に弱いというか。"

#. Occurrence NZ2:1641:19894: voice_id=BA0_NZ2_0025; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1641
msgctxt "text_id=19894 | speaker=unknown"
msgid "    A big fan of ol' Lewis Carroll..."
msgstr "　　ルイスキャロルの大ファンでもあったッス。"

#. Occurrence NZ2:1672:19895: voice_id=BA0_NZ2_0026; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1672
msgctxt "text_id=19895 | speaker=unknown"
msgid "    A Witch traditionally takes the Ploy passed down to them"
msgstr "　魔女は自分の代で、先代から遺されたプロイを"

#. Occurrence NZ2:1672:19896: voice_id=BA0_NZ2_0026; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1672
msgctxt "text_id=19896 | speaker=unknown"
msgid "    and fine-tunes it to her own needs."
msgstr "　自分用にチューンナップするッスよ。"

#. Occurrence NZ2:1672:19897: voice_id=BA0_NZ2_0026; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1672
msgctxt "text_id=19897 | speaker=unknown"
msgid "    Since your mum fancied Carroll so, that's how it came about."
msgstr "　母君、キャロルにはまってたからあの始末ッス。"

#. Occurrence NZ2:1703:19898: voice_id=BA0_NZ2_0027; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1703
msgctxt "text_id=19898 | speaker=unknown"
msgid "      When she broke the rules and had you,"
msgstr "　　 禁を犯した時も、ノータイムで"

#. Occurrence NZ2:1703:19899: voice_id=BA0_NZ2_0027; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1703
msgctxt "text_id=19899 | speaker=unknown"
msgid "      she decided to name you Alice, of all things."
msgstr "　　「名前はアリスにしましょう」なんて"

#. Occurrence NZ2:1703:19900: voice_id=BA0_NZ2_0027; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1703
msgctxt "text_id=19900 | speaker=unknown"
msgid "      I still remember the big ol' grin on her face!"
msgstr "　　 微笑んだぐらいッスから！"

#. Occurrence NZ2:1740:19901: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0018; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1740
msgctxt "text_id=19901 | speaker=alice"
msgid "    ...I think I've heard enough."
msgstr "　　……あきれた。"

#. Occurrence NZ2:1740:19902: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0018; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1740
msgctxt "text_id=19902 | speaker=alice"
msgid "    She was always a child at heart, that woman."
msgstr "　　少女趣味のかたまりだったのね、あの人。"

#. Occurrence NZ2:1777:19903: voice_id=BA0_NZ2_0028_0; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1777
msgctxt "text_id=19903 | speaker=unknown"
msgid "  Hahaha, you're one to talk!"
msgstr "　　ハハハなに言ってるッスか、"

#. Occurrence NZ2:1777:19904: voice_id=BA0_NZ2_0028_0; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1777
msgctxt "text_id=19904 | speaker=unknown"
msgid "  Whenever that boy comes to the gates o' Rome you always perk right up!"
msgstr "　　シャバ僧が帰ってくると必ず目を覚ます"

#. Occurrence NZ2:1777:19905: voice_id=BA0_NZ2_0028_0; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1777
msgctxt "text_id=19905 | speaker=unknown"
msgid "  The apple doesn't fall far from the tree, "
msgstr "　　アリスさんも"

#. Occurrence NZ2:1785:19906: voice_id=BA0_NZ2_0028_1; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1785
msgctxt "text_id=19906 | speaker=unknown"
msgid "as they say. "
msgstr "負けてはいな"

msgctxt "text_id=19907 | speaker=unknown"
msgid "Grargh!"
msgstr "ぐぼぁ!?"

#. Occurrence NZ2:1863:19908: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0019; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1863
msgctxt "text_id=19908 | speaker=alice"
msgid "        Let's make the topic of our next lecture"
msgstr "　 次回のレクチャーは"

#. Occurrence NZ2:1863:19909: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0019; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1863
msgctxt "text_id=19909 | speaker=alice"
msgid "        \"Ploy Kickshaws: A Tutorial.\""
msgstr "　『プロイキッシャー：個別』にしましょう。"

#. Occurrence NZ2:1894:19910: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0020; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1894
msgctxt "text_id=19910 | speaker=alice"
msgid " Robin, make a reservation at the usual place, will you?"
msgstr "　　それじゃロビン、お店の予約をしておいて。"

#. Occurrence NZ2:1894:19911: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0020; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1894
msgctxt "text_id=19911 | speaker=alice"
msgid " Then when you're finished with that, double boil this chocolate."
msgstr "　　それが済んだらチョコレイトの湯煎。"

#. Occurrence NZ2:1894:19912: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0020; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1894
msgctxt "text_id=19912 | speaker=alice"
msgid " After that, polish the mirror."
msgstr "　　それが済んだら鏡の<磨|みが>き。"

#. Occurrence NZ2:1925:19913: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0021; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1925
msgctxt "text_id=19913 | speaker=alice"
msgid "  And then... hmm."
msgstr "　それが済んだら……そうね。"

#. Occurrence NZ2:1925:19914: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0021; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1925
msgctxt "text_id=19914 | speaker=alice"
msgid "  Fly yourself into a telephone pole and die, maybe?"
msgstr "　電柱にでもぶつかって、盛大に死んでちょうだい。"

#. Occurrence NZ2:1959:19915: voice_id=BA0_NZ2_0029; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1959
msgctxt "text_id=19915 | speaker=unknown"
msgid "      So the usual routine, gotcha!"
msgstr "　　いつも通りってコトッスね！"

#. Occurrence NZ2:1959:19916: voice_id=BA0_NZ2_0029; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:1959
msgctxt "text_id=19916 | speaker=unknown"
msgid "      You're so 'ard on me today, Miss Alice!"
msgstr "　　アリスさん、なんか当たりきついッス！"

#. Occurrence NZ2:1990:19917: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0022; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1990
msgctxt "text_id=19917 | speaker=alice"
msgid "This is how I always am."
msgstr "わたし、本来はこういうキャラよ。"

#. Occurrence NZ2:1990:19918: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0022; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:1990
msgctxt "text_id=19918 | speaker=alice"
msgid "I'm just too lazy to deal with it all in the main story, that's all."
msgstr "本編では面倒だから黙っているだけ。"

#. Occurrence NZ2:2024:19919: voice_id=BA0_NZ2_0030; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:2024
msgctxt "text_id=19919 | speaker=unknown"
msgid "    Too lazy to deal with what?"
msgstr "　　面倒って、なにがッスか。"

#. Occurrence NZ2:2057:19920: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0023; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:2057
msgctxt "text_id=19920 | speaker=alice"
msgid "Too lazy to waste my precious "
msgstr "　貴方のような"

msgctxt "text_id=19921 | speaker=unknown"
msgid "calories"
msgstr "××を罵るのに"

msgctxt "text_id=19922 | speaker=unknown"
msgid "belaboring a stupid ■■■ like you, for one thing."
msgstr "　いちいちカロリーを使うとか。"

msgctxt "text_id=19923 | speaker=unknown"
msgid "Do you think you're really worth my time?"
msgstr "　それだけの価値があると思って？"

#. Occurrence NZ2:2091:19924: voice_id=BA0_NZ2_0031_0; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:2091
msgctxt "text_id=19924 | speaker=unknown"
msgid "  Well, pluck me bald!"
msgstr "　たまんないッスー！"

#. Occurrence NZ2:2091:19925: voice_id=BA0_NZ2_0031_0; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:2091
msgctxt "text_id=19925 | speaker=unknown"
msgid "  'Ere I was thinkin' people gave a tomtit about me!"
msgstr "　ジブン、グリコのキャラメル以下だったスね！"

#. Occurrence NZ2:2097:19926: voice_id=BA0_NZ2_0031_1; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:2097
msgctxt "text_id=19926 | speaker=unknown"
msgid "  But, "
msgstr "　でも。"

#. Occurrence NZ2:2104:19927: voice_id=BA0_NZ2_0031_2; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:2104
msgctxt "text_id=19927 | speaker=unknown"
msgid "if that's the case, "
msgstr "それなら。"

#. Occurrence NZ2:2111:19928: voice_id=BA0_NZ2_0031_3; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:2111
msgctxt "text_id=19928 | speaker=unknown"
msgid "I wouldn't mind "
msgstr "舐めて。"

#. Occurrence NZ2:2118:19929: voice_id=BA0_NZ2_0031_4; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:2118
msgctxt "text_id=19929 | speaker=unknown"
msgid "if you gave me a lick "
msgstr "ほしい。"

#. Occurrence NZ2:2125:19930: voice_id=BA0_NZ2_0031_5; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:2125
msgctxt "text_id=19930 | speaker=unknown"
msgid "sometimes."
msgstr "ッス。"

#. Occurrence NZ2:2159:19931: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0024; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:2159
msgctxt "text_id=19931 | speaker=alice"
msgid "  I bet you wouldn't."
msgstr "　そうね。"

#. Occurrence NZ2:2159:19932: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ2_0024; voice_prefix=A40; voice_category=2; scene=NZ2
#: NZ2:2159
msgctxt "text_id=19932 | speaker=alice"
msgid "  If only it'd annoy you so much you'd leave for good."
msgstr "　それでも死なないか、一度試してみましょうか。"

#. Occurrence NZ2:2239:19933: voice_id=BA0_NZ2_0032_0; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:2239
msgctxt "text_id=19933 | speaker=unknown"
msgid "      Oof, the one-two knockout right at the bell."
msgstr "　ノータイムでマルカジリ。"

#. Occurrence NZ2:2245:19934: voice_id=BA0_NZ2_0032_1; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:2245
msgctxt "text_id=19934 | speaker=unknown"
msgid "      So, are Ploys made of sweets or not?"
msgstr "　やっぱりプロイってお菓子なんス？"

#. Occurrence NZ2:2251:19935: voice_id=BA0_NZ2_0032_2; voice_prefix=BA0; voice_category=0; scene=NZ2
#: NZ2:2251
msgctxt "text_id=19935 | speaker=unknown"
msgid "      Mmm, sweets..."
msgstr "　んー、あめえ。"

#. Occurrence NZ3:157:19936: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0000; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:157
msgctxt "text_id=19936 | speaker=alice"
msgid "    Chef."
msgstr "　　シェフ。"

#. Occurrence NZ3:157:19937: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0000; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:157
msgctxt "text_id=19937 | speaker=alice"
msgid "    One three-piece tuna special."
msgstr "　　マグロ三種盛り、一つ。"

#. Occurrence NZ3:263:19938: voice_id=BA0_NZ3_0000; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:263
msgctxt "text_id=19938 | speaker=unknown"
msgid "      What's that, Miss Alice?"
msgstr "　アリスさん、なんスかそれ？"

#. Occurrence NZ3:263:19939: voice_id=BA0_NZ3_0000; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:263
msgctxt "text_id=19939 | speaker=unknown"
msgid "      Never seen a gold plate like that before."
msgstr "　なんか、見たこともない金色のお皿ッスね。"

#. Occurrence NZ3:305:19940: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0001; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:305
msgctxt "text_id=19940 | speaker=alice"
msgid "          It's nothing special."
msgstr "　　　たいしたことはないわ。"

#. Occurrence NZ3:331:19941: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0002; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:331
msgctxt "text_id=19941 | speaker=alice"
msgid "        Just a regular tuna,"
msgstr "　　普通のと、"

#. Occurrence NZ3:331:19942: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0002; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:331
msgctxt "text_id=19942 | speaker=alice"
msgid "        a fatty tuna belly,"
msgstr "　　中トロと、"

#. Occurrence NZ3:331:19943: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0002; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:331
msgctxt "text_id=19943 | speaker=alice"
msgid "        and an extra fatty one."
msgstr "　　大トロのセットなだけよ。"

#. Occurrence NZ3:357:19944: voice_id=BA0_NZ3_0001; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:357
msgctxt "text_id=19944 | speaker=unknown"
msgid "  It looks like a bloody French flag!"
msgstr "鮮血のトリコロール。フランスの国旗みたいッスね。"

#. Occurrence NZ3:357:19945: voice_id=BA0_NZ3_0001; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:357
msgctxt "text_id=19945 | speaker=unknown"
msgid "  I can only ever afford the crappy ones, like egg, squid, or inari."
msgstr "ジブン、経済的な理由で玉子とイカとイナリしか頼めないッス。"

#. Occurrence NZ3:398:19946: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0003; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:398
msgctxt "text_id=19946 | speaker=alice"
msgid "  Chef."
msgstr "　　　シェフ。"

#. Occurrence NZ3:398:19947: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0003; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:398
msgctxt "text_id=19947 | speaker=alice"
msgid "  Another plate of medium-fat tuna."
msgstr "　　　中トロをもう一度。"

#. Occurrence NZ3:509:19948: voice_id=BA0_NZ3_0002; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:509
msgctxt "text_id=19948 | speaker=unknown"
msgid "      You're going for another red one."
msgstr "　　また赤いのッスか。"

#. Occurrence NZ3:509:19949: voice_id=BA0_NZ3_0002; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:509
msgctxt "text_id=19949 | speaker=unknown"
msgid "      What about something white or silver?"
msgstr "　　光りものとか白身とかいかないんスか？"

#. Occurrence NZ3:509:19950: voice_id=BA0_NZ3_0002; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:509
msgctxt "text_id=19950 | speaker=unknown"
msgid "      Sardine and amberjack are pretty tasty."
msgstr "　　イワシとかカンパチとかいけるッスよ。"

#. Occurrence NZ3:540:19951: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0004; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:540
msgctxt "text_id=19951 | speaker=alice"
msgid "        Chef."
msgstr "　　　シェフ。"

#. Occurrence NZ3:540:19952: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0004; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:540
msgctxt "text_id=19952 | speaker=alice"
msgid "        Another full-fat tuna."
msgstr "　　　大トロをもう一度。"

#. Occurrence NZ3:615:19953: voice_id=BA0_NZ3_0003; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:615
msgctxt "text_id=19953 | speaker=unknown"
msgid "      That one plate of sushi"
msgstr "　　その皿ひとつで、"

#. Occurrence NZ3:615:19954: voice_id=BA0_NZ3_0003; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:615
msgctxt "text_id=19954 | speaker=unknown"
msgid "      costs as much as an entire John Skinner."
msgstr "　　いつもの夕食一回分の値段なんスね。"

#. Occurrence NZ3:615:19955: voice_id=BA0_NZ3_0003; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:615
msgctxt "text_id=19955 | speaker=unknown"
msgid "      How about settling for salmon?"
msgstr "　　サーモンで妥協とかしないんスか？"

#. Occurrence NZ3:646:19956: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0005; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:646
msgctxt "text_id=19956 | speaker=alice"
msgid "      Cost is no concern."
msgstr "　　たいしたことはないわ。"

#. Occurrence NZ3:646:19957: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0005; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:646
msgctxt "text_id=19957 | speaker=alice"
msgid "      Chef. Another full-fat tuna."
msgstr "　　シェフ。大トロをリピート。"

#. Occurrence NZ3:698:19958: voice_id=BA0_NZ3_0004; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:698
msgctxt "text_id=19958 | speaker=unknown"
msgid "      It's just tuna, tuna, tuna with you."
msgstr "　　はじめからマグロしか眼中にないとか、"

#. Occurrence NZ3:698:19959: voice_id=BA0_NZ3_0004; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:698
msgctxt "text_id=19959 | speaker=unknown"
msgid "      Should've expected no less of Miss Alice!"
msgstr "　　さすがアリスさんッスーーー！"

#. Occurrence NZ3:698:19960: voice_id=BA0_NZ3_0004; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:698
msgctxt "text_id=19960 | speaker=unknown"
msgid "      Sometimes I forget you're a posh heiress!"
msgstr "　　久遠寺財閥の娘は伊達じゃないッスね！"

#. Occurrence NZ3:730:19961: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0006_0; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:730
msgctxt "text_id=19961 | speaker=alice"
msgid "    How else should I spend my money, Robin?"
msgstr "　　お金はこういう時に使うのよ、ロビン。"

#. Occurrence NZ3:730:19962: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0006_0; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:730
msgctxt "text_id=19962 | speaker=alice"
msgid "    If you have it, spend it."
msgstr "　　チャンスで出し渋るのはよくないわ。"

#. Occurrence NZ3:740:19963: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0006_1; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:740
msgctxt "text_id=19963 | speaker=alice"
msgid "    Well, Aoko's paying today, but still."
msgstr "　　今日は、青子のお財布を借りているのだけど。"

#. Occurrence NZ3:771:19964: voice_id=BA0_NZ3_0005; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:771
msgctxt "text_id=19964 | speaker=unknown"
msgid "    Ah, I see 'ow it works."
msgstr "　　　　　そッスか。"

#. Occurrence NZ3:771:19965: voice_id=BA0_NZ3_0005; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:771
msgctxt "text_id=19965 | speaker=unknown"
msgid "    Aoko's coughin' up for dinner."
msgstr "　　　　　青子さんの。"

#. Occurrence NZ3:846:19966: voice_id=BA0_NZ3_0006; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:846
msgctxt "text_id=19966 | speaker=unknown"
msgid "        Does she have enough bread and honey for this?"
msgstr "　　でもそれ、すぐにカラにならないッスか。"

#. Occurrence NZ3:846:19967: voice_id=BA0_NZ3_0006; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:846
msgctxt "text_id=19967 | speaker=unknown"
msgid "        Think of her poor wallet."
msgstr "　　青子さんの財布の中身、お寒いッスよ。"

#. Occurrence NZ3:846:19968: voice_id=BA0_NZ3_0006; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:846
msgctxt "text_id=19968 | speaker=unknown"
msgid "        She spends money like it's going out of style."
msgstr "　　あの人、すぐに物を買うから。"

#. Occurrence NZ3:878:19969: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0007_0; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:878
msgctxt "text_id=19969 | speaker=alice"
msgid "      It's fine."
msgstr "　　だいじょうぶ。"

#. Occurrence NZ3:878:19970: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0007_0; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:878
msgctxt "text_id=19970 | speaker=alice"
msgid "      I always come prepared."
msgstr "　　備えあれば、よロビン。"

#. Occurrence NZ3:888:19971: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0007_1; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:888
msgctxt "text_id=19971 | speaker=alice"
msgid "      I brought my second purse just in case."
msgstr "　　ここにもう一つ、温かなお財布があるわ。"

#. Occurrence NZ3:920:19972: voice_id=BA0_NZ3_0007; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:920
msgctxt "text_id=19972 | speaker=unknown"
msgid "                  Bwah!"
msgstr "　　　　　　　ぶほっ"

#. Occurrence NZ3:955:19973: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0008; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:955
msgctxt "text_id=19973 | speaker=alice"
msgid "                  What?"
msgstr "　　　　　　　なに？"

#. Occurrence NZ3:986:19974: voice_id=BA0_NZ3_0008; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:986
msgctxt "text_id=19974 | speaker=unknown"
msgid "      Nothing, nothing."
msgstr "　　なンでもないッス。"

#. Occurrence NZ3:986:19975: voice_id=BA0_NZ3_0008; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:986
msgctxt "text_id=19975 | speaker=unknown"
msgid "      You're the queen of the castle, so what you say goes."
msgstr "　　アリスさんは家主。すなわち絶対者。"

#. Occurrence NZ3:986:19976: voice_id=BA0_NZ3_0008; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:986
msgctxt "text_id=19976 | speaker=unknown"
msgid "      I'm just a lowly guest."
msgstr "　　あの洋館に住むもので誰が逆らえようか。"

#. Occurrence NZ3:1017:19977: voice_id=BA0_NZ3_0009; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:1017
msgctxt "text_id=19977 | speaker=unknown"
msgid "   ...That twerp's got more dosh than I thought, eh?"
msgstr "　……にしても、あのシャバ僧、小金持ちッスね。"

#. Occurrence NZ3:1017:19978: voice_id=BA0_NZ3_0009; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:1017
msgctxt "text_id=19978 | speaker=unknown"
msgid "   Get a load of that bangers and mash!"
msgstr "　ずっしり来るッスよ、この財布。"

#. Occurrence NZ3:1049:19979: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0009; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1049
msgctxt "text_id=19979 | speaker=alice"
msgid "        All that cash!"
msgstr "　　　　うなる札束ね。"

#. Occurrence NZ3:1049:19980: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0009; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1049
msgctxt "text_id=19980 | speaker=alice"
msgid "        Someone fan me, quick!"
msgstr "　　　　ドキドキするわ。"

#. Occurrence NZ3:1122:19981: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0010; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1122
msgctxt "text_id=19981 | speaker=alice"
msgid "        Where's my tuna...?"
msgstr "　　……赤身がこないわね。"

#. Occurrence NZ3:1175:19982: voice_id=BA0_NZ3_0010; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:1175
msgctxt "text_id=19982 | speaker=unknown"
msgid "  Looks like someone is 'ogging it all in the VIP seat."
msgstr "　上座の席で独占しているヤツがいるみたいッス。"

#. Occurrence NZ3:1175:19983: voice_id=BA0_NZ3_0010; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:1175
msgctxt "text_id=19983 | speaker=unknown"
msgid "  Check out the green get-up and glasses."
msgstr "　緑色のコートで。メガネで。"

#. Occurrence NZ3:1175:19984: voice_id=BA0_NZ3_0010; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:1175
msgctxt "text_id=19984 | speaker=unknown"
msgid "  'Ogging all the 'ighest quality stuff."
msgstr "　麻雀牌をつもるような優雅さで二貫ぺろりと。"

#. Occurrence NZ3:1201:19985: voice_id=BA0_NZ3_0011; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:1201
msgctxt "text_id=19985 | speaker=unknown"
msgid "  Not my place to say,"
msgstr "　あえて誰かは言わないんスけど、"

#. Occurrence NZ3:1201:19986: voice_id=BA0_NZ3_0011; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:1201
msgctxt "text_id=19986 | speaker=unknown"
msgid "  but that looks like stress-eatin' to me."
msgstr "　あれヤケ食いッスね。"

#. Occurrence NZ3:1201:19987: voice_id=BA0_NZ3_0011; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:1201
msgctxt "text_id=19987 | speaker=unknown"
msgid "  Should I say somefin'?"
msgstr "　声、かけるッスか？"

#. Occurrence NZ3:1227:19988: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0011; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1227
msgctxt "text_id=19988 | speaker=alice"
msgid "        Leave it alone."
msgstr "放っておきましょう。"

#. Occurrence NZ3:1227:19989: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0011; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1227
msgctxt "text_id=19989 | speaker=alice"
msgid "        Everybody deserves a little me time."
msgstr "誰にだって、知り合いに見られたくない時はあるわ。"

#. Occurrence NZ3:1317:19990: voice_id=BA0_NZ3_0012; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:1317
msgctxt "text_id=19990 | speaker=unknown"
msgid "      Not going to take a plate, Miss Alice?"
msgstr "　アリスさん、お皿取らないッスか？"

#. Occurrence NZ3:1349:19991: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0012; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1349
msgctxt "text_id=19991 | speaker=alice"
msgid "        I guess I can fit it in."
msgstr "　　　……仕方ないわね。"

#. Occurrence NZ3:1349:19992: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0012; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1349
msgctxt "text_id=19992 | speaker=alice"
msgid "        This one, then."
msgstr "　　　じゃあ、これ。"

#. Occurrence NZ3:1431:19993: voice_id=C20_NZ3_0000; voice_prefix=C20; voice_category=0; scene=NZ3
#: NZ3:1431
msgctxt "text_id=19993 | speaker=unknown"
msgid "            Congratulations!"
msgstr "　　　おめでとーございまーす！"

#. Occurrence NZ3:1458:19994: voice_id=C30_NZ3_0000; voice_prefix=C30; voice_category=0; scene=NZ3
#: NZ3:1458
msgctxt "text_id=19994 | speaker=unknown"
msgid "                Thank you!"
msgstr "　　　ありがとうございまーす！"

#. Occurrence NZ3:1484:19995: voice_id=BA0_NZ3_0013; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:1484
msgctxt "text_id=19995 | speaker=unknown"
msgid "    Huh? Who's this?"
msgstr "　　　　　誰ッスか？"

#. Occurrence NZ3:1484:19996: voice_id=BA0_NZ3_0013; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:1484
msgctxt "text_id=19996 | speaker=unknown"
msgid "    Are we that short-handed?"
msgstr "　　　　　テコイレ？"

#. Occurrence NZ3:1511:19997: voice_id=C20_NZ3_0001; voice_prefix=C20; voice_category=0; scene=NZ3
#: NZ3:1511
msgctxt "text_id=19997 | speaker=unknown"
msgid "              Let us explain!"
msgstr "　　　　　説明しよう！"

#. Occurrence NZ3:1538:19998: voice_id=C30_NZ3_0001; voice_prefix=C30; voice_category=0; scene=NZ3
#: NZ3:1538
msgctxt "text_id=19998 | speaker=unknown"
msgid "                I'll explain!"
msgstr "　　　　　説明するよ！"

#. Occurrence NZ3:1565:19999: voice_id=C20_NZ3_0002; voice_prefix=C20; voice_category=0; scene=NZ3
#: NZ3:1565
msgctxt "text_id=19999 | speaker=unknown"
msgid "      We're the best-kept secret!"
msgstr "　　　何を隠そう僕らこそ！"

#. Occurrence NZ3:1592:20000: voice_id=C30_NZ3_0002; voice_prefix=C30; voice_category=0; scene=NZ3
#: NZ3:1592
msgctxt "text_id=20000 | speaker=unknown"
msgid "  We're talked about far and wide!"
msgstr "　　　誰が語ろう僕らこそ！"

#. Occurrence NZ3:1619:20001: voice_id=C20_NZ3_0003; voice_prefix=C20; voice_category=0; scene=NZ3
#: NZ3:1619
msgctxt "text_id=20001 | speaker=unknown"
msgid "We're our master's favorite, versatile, and ever-changing Six Force!"
msgstr "ご主人様の<寵愛|ちょうあい><篤|あつ>い、変幻自在のシックスフォース！"

#. Occurrence NZ3:1645:20002: voice_id=C30_NZ3_0003; voice_prefix=C30; voice_category=0; scene=NZ3
#: NZ3:1645
msgctxt "text_id=20002 | speaker=unknown"
msgid "    We're elite Ploys, who can transform^    into mammals, birds... you name it!"
msgstr "　　ほ乳類から鳥類まで完全網羅の高級プロイ！"

#. Occurrence NZ3:1645:20003: voice_id=C30_NZ3_0003; voice_prefix=C30; voice_category=0; scene=NZ3
#: NZ3:1645
msgctxt "text_id=20003 | speaker=unknown"
msgid "    We're twins and we're pretty chatty!"
msgstr "　　おしゃべり双子とは僕らのコト"

#. Occurrence NZ3:1721:20004: voice_id=C20_NZ3_0004; voice_prefix=C20; voice_category=0; scene=NZ3
#: NZ3:1721
msgctxt "text_id=20004 | speaker=unknown"
msgid "    Whoa!"
msgstr "　おおーーー！？"

#. Occurrence NZ3:1721:20005: voice_id=C20_NZ3_0004; voice_prefix=C20; voice_category=0; scene=NZ3
#: NZ3:1721
msgctxt "text_id=20005 | speaker=unknown"
msgid "    How can you play games when it's this dark?!"
msgstr "　まったく真っ暗どっちらけ、これじゃあゲームもできやしない！"

#. Occurrence NZ3:1747:20006: voice_id=C30_NZ3_0004; voice_prefix=C30; voice_category=0; scene=NZ3
#: NZ3:1747
msgctxt "text_id=20006 | speaker=unknown"
msgid "Hey!"
msgstr "　あやーーー！！"

#. Occurrence NZ3:1747:20007: voice_id=C30_NZ3_0004; voice_prefix=C30; voice_category=0; scene=NZ3
#: NZ3:1747
msgctxt "text_id=20007 | speaker=unknown"
msgid "If you can't see, then you can't see the number on the die!"
msgstr "　見る者いなけりゃどんな目だろうと同じこと！"

#. Occurrence NZ3:1747:20008: voice_id=C30_NZ3_0004; voice_prefix=C30; voice_category=0; scene=NZ3
#: NZ3:1747
msgctxt "text_id=20008 | speaker=unknown"
msgid "Looks like we'll have to resume gambling later then!"
msgstr "　賭けの続きは薄墨の、<鶏|とり>の卵が回った後で！"

#. Occurrence NZ3:1792:20009: voice_id=BA0_NZ3_0014; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:1792
msgctxt "text_id=20009 | speaker=unknown"
msgid "        Wait! Are they the pig twins?!"
msgstr "　　あ、いまの、もしかしてブタコンビ!?"

#. Occurrence NZ3:1792:20010: voice_id=BA0_NZ3_0014; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:1792
msgctxt "text_id=20010 | speaker=unknown"
msgid "        They can turn into humans, too?!"
msgstr "　　アイツら、人間にもなれるッスかーーー！？"

#. Occurrence NZ3:1823:20011: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0013; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1823
msgctxt "text_id=20011 | speaker=alice"
msgid "    They're known to turn into humans when they roll a one."
msgstr "　　……一の目をだすと人間になるそうよ。"

#. Occurrence NZ3:1823:20012: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0013; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1823
msgctxt "text_id=20012 | speaker=alice"
msgid "    Let me explain."
msgstr "　　詳しくは、こう。"

#. Occurrence NZ3:1869:20013: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0014; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1869
msgctxt "text_id=20013 | speaker=alice"
msgid "            They're called the Chatty Twins."
msgstr "　　　　名前はおしゃべり双子。"

#. Occurrence NZ3:1869:20014: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0014; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1869
msgctxt "text_id=20014 | speaker=alice"
msgid "            The noisy one's Tweedle Dum."
msgstr "　　　　うるさい方がトゥィードルダム、"

#. Occurrence NZ3:1869:20015: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0014; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1869
msgctxt "text_id=20015 | speaker=alice"
msgid "            The loud one's Tweedle Dee."
msgstr "　　　　さわがしい方がトゥィードルディー。"

#. Occurrence NZ3:1895:20016: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0015; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1895
msgctxt "text_id=20016 | speaker=alice"
msgid "          They're Ploys, but they transform"
msgstr "　　ダイスを振って、"

#. Occurrence NZ3:1895:20017: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0015; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1895
msgctxt "text_id=20017 | speaker=alice"
msgid "          with the roll of a die."
msgstr "　　出た目で変形するカタチが変わるプロイね。"

#. Occurrence NZ3:1926:20018: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0016; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1926
msgctxt "text_id=20018 | speaker=alice"
msgid "      Sadly, human society has poisoned them,"
msgstr "　　　人間社会に毒されているから、"

#. Occurrence NZ3:1926:20019: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0016; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1926
msgctxt "text_id=20019 | speaker=alice"
msgid "      so they're susceptible to weak magecraft."
msgstr "　　　普通の魔術が効きやすいのが欠点よ。"

#. Occurrence NZ3:1958:20020: voice_id=BA0_NZ3_0015; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:1958
msgctxt "text_id=20020 | speaker=unknown"
msgid "      You ever rolled a one?"
msgstr "一の目とか、だしたコトあるッスか？"

#. Occurrence NZ3:1989:20021: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0017; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1989
msgctxt "text_id=20021 | speaker=alice"
msgid "      No, I can't seem to be able to."
msgstr "　　　わたしじゃ無理みたい。"

#. Occurrence NZ3:1989:20022: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0017; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:1989
msgctxt "text_id=20022 | speaker=alice"
msgid "      I've only ever seen them transform into pigs."
msgstr "　　　子ブタの姿以外、見たこともないもの。"

#. Occurrence NZ3:2039:20023: voice_id=C20_NZ3_0005; voice_prefix=C20; voice_category=0; scene=NZ3
#: NZ3:2039
msgctxt "text_id=20023 | speaker=unknown"
msgid "      It's not impossible! You're just too simple!"
msgstr "　　　無理も何も、ご主人様は清純すぎる！"

#. Occurrence NZ3:2039:20024: voice_id=C20_NZ3_0005; voice_prefix=C20; voice_category=0; scene=NZ3
#: NZ3:2039
msgctxt "text_id=20024 | speaker=unknown"
msgid "      There are multiple sides to everything!"
msgstr "　　　どんなものにも裏はある、"

#. Occurrence NZ3:2039:20025: voice_id=C20_NZ3_0005; voice_prefix=C20; voice_category=0; scene=NZ3
#: NZ3:2039
msgctxt "text_id=20025 | speaker=unknown"
msgid "      You need to roll the die right!"
msgstr "　　　僕らは振るにゃあコツがいる！"

#. Occurrence NZ3:2069:20026: voice_id=C30_NZ3_0005; voice_prefix=C30; voice_category=0; scene=NZ3
#: NZ3:2069
msgctxt "text_id=20026 | speaker=unknown"
msgid "      Exactly! You've got to cheat sometimes!"
msgstr "　　そうそう、時にはダーティーに！"

#. Occurrence NZ3:2069:20027: voice_id=C30_NZ3_0005; voice_prefix=C30; voice_category=0; scene=NZ3
#: NZ3:2069
msgctxt "text_id=20027 | speaker=unknown"
msgid "      This world is full of cheaters!"
msgstr "　　とかく、この世はイカサマだらけ、"

#. Occurrence NZ3:2069:20028: voice_id=C30_NZ3_0005; voice_prefix=C30; voice_category=0; scene=NZ3
#: NZ3:2069
msgctxt "text_id=20028 | speaker=unknown"
msgid "      No one rolls a six without cheating!"
msgstr "　　ズルをしないと六の目以外は出ないが定め！"

#. Occurrence NZ3:2135:20029: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0018; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2135
msgctxt "text_id=20029 | speaker=alice"
msgid "      Ah, the evening feast is here."
msgstr "　　夜の饗宴が、お皿に乗ってやってきたわね。"

#. Occurrence NZ3:2166:20030: voice_id=BA0_NZ3_0016; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2166
msgctxt "text_id=20030 | speaker=unknown"
msgid "      I know \"Diddle Diddle.\""
msgstr "　おなじみの『ディドルディドル』ッスね。"

#. Occurrence NZ3:2166:20031: voice_id=BA0_NZ3_0016; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2166
msgctxt "text_id=20031 | speaker=unknown"
msgid "      From Mother Goose, right?"
msgstr "　ジブンも知ってるッスよ。このマザーグース。"

#. Occurrence NZ3:2198:20032: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0019; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2198
msgctxt "text_id=20032 | speaker=alice"
msgid "      Yeah, it's quite famous."
msgstr "　　それだけ有名というコトよ。"

#. Occurrence NZ3:2229:20033: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0020; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2229
msgctxt "text_id=20033 | speaker=alice"
msgid "          \"Hey diddle diddle,"
msgstr "　　　　　『ヘイ、ディドル、ディドル。"

#. Occurrence NZ3:2229:20034: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0020; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2229
msgctxt "text_id=20034 | speaker=alice"
msgid "              The cat and the fiddle,"
msgstr "　　　　　　　猫とヴァイオリン。"

#. Occurrence NZ3:2229:20035: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0020; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2229
msgctxt "text_id=20035 | speaker=alice"
msgid "            The cow jumped over the moon."
msgstr "　　　　　　牛が月を飛び越えた。"

#. Occurrence NZ3:2254:20036: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0021; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2254
msgctxt "text_id=20036 | speaker=alice"
msgid "      The little dog laughed to see such sport,"
msgstr "　　　そのおもしろい光景を見て犬が笑った。"

#. Occurrence NZ3:2254:20037: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0021; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2254
msgctxt "text_id=20037 | speaker=alice"
msgid "        And the dish ran away with the spoon.\""
msgstr "　　　　そしてお皿はスプーンと逃げた。』"

#. Occurrence NZ3:2285:20038: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0022; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2285
msgctxt "text_id=20038 | speaker=alice"
msgid "      It's a typical Mother Goose rhyme."
msgstr "　　　典型的な<韻踏み唄|マザーグース>ね。"

#. Occurrence NZ3:2285:20039: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0022; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2285
msgctxt "text_id=20039 | speaker=alice"
msgid "      In the middle of the night there's a cat playing a fiddle;"
msgstr "　　　真夜中、猫がヴァイオリンをひいて、"

#. Occurrence NZ3:2310:20040: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0023; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2310
msgctxt "text_id=20040 | speaker=alice"
msgid "  a dog laughs at a cow jumping over the moon;"
msgstr "牛が月を飛び越えて、犬が笑って、"

#. Occurrence NZ3:2310:20041: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0023; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2310
msgctxt "text_id=20041 | speaker=alice"
msgid "  and an anthropomorphic plate and spoon run away together."
msgstr "擬人化された皿とスプーンが逃げていくだけの唄。"

#. Occurrence NZ3:2336:20042: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0024; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2336
msgctxt "text_id=20042 | speaker=alice"
msgid "        Some say it's based on a Greek and Egyptian legend,"
msgstr "　　　一説ではギリシャ・エジプトの神話を元にした……"

#. Occurrence NZ3:2336:20043: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0024; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2336
msgctxt "text_id=20043 | speaker=alice"
msgid "        and that it's talking about the movement of the stars."
msgstr "　　　とも言われているわ。星の運営を表しているのなら、"

#. Occurrence NZ3:2336:20044: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0024; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2336
msgctxt "text_id=20044 | speaker=alice"
msgid "        The cow most likely represents Taurus."
msgstr "　　　牛は<牡牛座|タウルス>のもじりでしょう。"

#. Occurrence NZ3:2367:20045: voice_id=BA0_NZ3_0017; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2367
msgctxt "text_id=20045 | speaker=unknown"
msgid "      They're one-time-use Ploys, right?"
msgstr "　　　これは使い切りのプロイッスね。"

#. Occurrence NZ3:2367:20046: voice_id=BA0_NZ3_0017; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2367
msgctxt "text_id=20046 | speaker=unknown"
msgid "      One use and they break."
msgstr "　　　一回使ったら壊れるッス。"

#. Occurrence NZ3:2367:20047: voice_id=BA0_NZ3_0017; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2367
msgctxt "text_id=20047 | speaker=unknown"
msgid "      D'you make new ones each time, Miss Alice?"
msgstr "　　　アリスさん、そのたびに作ってるッスか？"

#. Occurrence NZ3:2399:20048: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0025; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2399
msgctxt "text_id=20048 | speaker=alice"
msgid "  Of course."
msgstr "　当然でしょう。"

#. Occurrence NZ3:2399:20049: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0025; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2399
msgctxt "text_id=20049 | speaker=alice"
msgid "  Diddle Diddle forms the basis of my magecraft."
msgstr "　ディドルディドルはわたしの魔術の基本だもの。"

#. Occurrence NZ3:2431:20050: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0026; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2431
msgctxt "text_id=20050 | speaker=alice"
msgid "If I place them into the ground they'll deepen the night."
msgstr "　　これを地面に沈めると、夜を助長させるの。"

#. Occurrence NZ3:2431:20051: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0026; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2431
msgctxt "text_id=20051 | speaker=alice"
msgid "The deeper the night, the more my magecraft―"
msgstr "　　夜が深まれば、それだけわたしの魔術―――"

#. Occurrence NZ3:2431:20052: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0026; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2431
msgctxt "text_id=20052 | speaker=alice"
msgid "rather, the more the fairy tale means."
msgstr "　　童話詠唱が確かな意味を持つようになるわ。"

#. Occurrence NZ3:2458:20053: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0027; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2458
msgctxt "text_id=20053 | speaker=alice"
msgid "        That's all there is to it."
msgstr "　　　　　詳しくはこう。"

#. Occurrence NZ3:2492:20054: voice_id=BA0_NZ3_0018; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2492
msgctxt "text_id=20054 | speaker=unknown"
msgid "    So Ploys like these only work in certain situations."
msgstr "　　わりと使いどころ限定なプロイッスね。"

#. Occurrence NZ3:2492:20055: voice_id=BA0_NZ3_0018; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2492
msgctxt "text_id=20055 | speaker=unknown"
msgid "    Y'know, you don't function nearly as well in the city."
msgstr "　　アリスさん、都市部じゃ能力半減っつーか、"

#. Occurrence NZ3:2492:20056: voice_id=BA0_NZ3_0018; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2492
msgctxt "text_id=20056 | speaker=unknown"
msgid "    You really are a forest girl at heart."
msgstr "　　森ガールだったッスか。"

#. Occurrence NZ3:2541:20057: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0028; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2541
msgctxt "text_id=20057 | speaker=alice"
msgid "          These are the \"Nameless Woods.\""
msgstr "　　　これは「名無しの森」ね。"

#. Occurrence NZ3:2541:20058: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0028; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2541
msgctxt "text_id=20058 | speaker=alice"
msgid "          By itself it doesn't mean anything."
msgstr "　　　これ単体だと意味がないから、"

#. Occurrence NZ3:2541:20059: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0028; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2541
msgctxt "text_id=20059 | speaker=alice"
msgid "          You need a map."
msgstr "　　　<地図|どだい>になるものが必要なのだけど……"

#. Occurrence NZ3:2582:20060: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0029; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2582
msgctxt "text_id=20060 | speaker=alice"
msgid "  You use it with this Mirror of Slumber."
msgstr "　　この「午睡の鏡」とセットで使うものよ。"

#. Occurrence NZ3:2582:20061: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0029; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2582
msgctxt "text_id=20061 | speaker=alice"
msgid "  This mirror didn't quite become one of the three great Ploys,"
msgstr "　　この鏡は三大プロイにはなれなかったけど、"

#. Occurrence NZ3:2582:20062: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0029; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2582
msgctxt "text_id=20062 | speaker=alice"
msgid "  but it functions just as well."
msgstr "　　機能的には三大に負けていないわ。"

#. Occurrence NZ3:2615:20063: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0030; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2615
msgctxt "text_id=20063 | speaker=alice"
msgid "          More specifically,"
msgstr "　　　　　詳しくは、"

#. Occurrence NZ3:2645:20064: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0031; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2645
msgctxt "text_id=20064 | speaker=alice"
msgid "  it usually scans for enemies across Misaki City and guards the mansion."
msgstr "　基本的には三咲市全体の索敵と洋館内の警備。"

#. Occurrence NZ3:2645:20065: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0031; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2645
msgctxt "text_id=20065 | speaker=alice"
msgid "  Unfortunately, sometimes it goes a little haywire and makes a gate"
msgstr "　たまに暴走して洋館内にゲートを作って、"

#. Occurrence NZ3:2645:20066: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0031; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2645
msgctxt "text_id=20066 | speaker=alice"
msgid "  that beckons people in the mansion inside it."
msgstr "　通る人を鏡の中に招いてしまうのが難点ね。"

#. Occurrence NZ3:2676:20067: voice_id=BA0_NZ3_0019; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2676
msgctxt "text_id=20067 | speaker=unknown"
msgid "  Haha! I bet that dustbin lid almost got killed a few dozen times!"
msgstr "ははは。それであのシャバ僧が何度死にかけたか。"

#. Occurrence NZ3:2676:20068: voice_id=BA0_NZ3_0019; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2676
msgctxt "text_id=20068 | speaker=unknown"
msgid "  From \"Through the Looking-Glass,\" was it?"
msgstr "原点は鏡の国のアリスっスね。"

#. Occurrence NZ3:2708:20069: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0032; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2708
msgctxt "text_id=20069 | speaker=alice"
msgid "  Right. Originally it was just an embryo that held an^  other-realm inside."
msgstr "そうね。元々は内側に異世界を持つだけの<魔術卵|エンブリオ>で、"

#. Occurrence NZ3:2708:20070: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0032; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2708
msgctxt "text_id=20070 | speaker=alice"
msgid "  It looked like it'd been broken for a long time."
msgstr "長いこと壊れていたらしいわ。"

#. Occurrence NZ3:2734:20071: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0033; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2734
msgctxt "text_id=20071 | speaker=alice"
msgid "  Touko and my mother both helped"
msgstr "　　それを母と橙子さんが協力して作り直した、"

#. Occurrence NZ3:2734:20072: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0033; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2734
msgctxt "text_id=20072 | speaker=alice"
msgid "  to repair it."
msgstr "　　という話よ。"

#. Occurrence NZ3:2765:20073: voice_id=BA0_NZ3_0020; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2765
msgctxt "text_id=20073 | speaker=unknown"
msgid "    Oh? Why'd you need the help?"
msgstr "？　なんでそんなコトするッスか？"

#. Occurrence NZ3:2765:20074: voice_id=BA0_NZ3_0020; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2765
msgctxt "text_id=20074 | speaker=unknown"
msgid "    Couldn't you do it yourself?"
msgstr "マイ女神だけで十分じゃないッスか。"

#. Occurrence NZ3:2797:20075: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0034; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2797
msgctxt "text_id=20075 | speaker=alice"
msgid "      A Witch is required to leave behind at least^      one elite Ploy in her lifetime."
msgstr "魔女はその生で一つ、至高のプロイを遺さないとい^けない決まりがあるから。"

#. Occurrence NZ3:2829:20076: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0035; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2829
msgctxt "text_id=20076 | speaker=alice"
msgid "          \"She wanted to repair this mirror;"
msgstr "　　「彼女はこの鏡を作り直して、"

#. Occurrence NZ3:2829:20077: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0035; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2829
msgctxt "text_id=20077 | speaker=alice"
msgid "          make it her masterpiece,\""
msgstr "　　自分の最高傑作にしたかったのよ、きっと」"

#. Occurrence NZ3:2829:20078: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0035; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2829
msgctxt "text_id=20078 | speaker=alice"
msgid "          is what Touko always said."
msgstr "　　そう橙子さんは言っていたけど、どうだか。"

#. Occurrence NZ3:2882:20079: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0036; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2882
msgctxt "text_id=20079 | speaker=alice"
msgid "  If you make the surface of the mirror a map of Misaki"
msgstr "　どうかしら。こんなふうに午睡の鏡の表面を三咲の地図にして、"

#. Occurrence NZ3:2882:20080: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0036; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2882
msgctxt "text_id=20080 | speaker=alice"
msgid "  and place this piece on it, that area becomes the Nameless Woods."
msgstr "　その上にコマを置くとそこが「名無しの森」になるの。"

#. Occurrence NZ3:2932:20081: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0037; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2932
msgctxt "text_id=20081 | speaker=alice"
msgid "          We used it in Aoko's first battle."
msgstr "　　　青子のデビュー戦で使っていたのはこのプロイね。"

#. Occurrence NZ3:2932:20082: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0037; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2932
msgctxt "text_id=20082 | speaker=alice"
msgid "          Anyone who comes within its range feels compelled"
msgstr "　　　このプロイの効果範囲に来ると『この先に用はない』"

#. Occurrence NZ3:2932:20083: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0037; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2932
msgctxt "text_id=20083 | speaker=alice"
msgid "          to leave, so it's good for keeping people away."
msgstr "　　　と暗示がかかって人避けになるのだけど……"

#. Occurrence NZ3:2964:20084: voice_id=BA0_NZ3_0021; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:2964
msgctxt "text_id=20084 | speaker=unknown"
msgid "    But it doesn't work on prats!"
msgstr " 空気読まないヤツには通用しないってコトッスね。"

#. Occurrence NZ3:2996:20085: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0038; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2996
msgctxt "text_id=20085 | speaker=alice"
msgid "  ...Indeed."
msgstr "……そうね。"

#. Occurrence NZ3:2996:20086: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0038; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2996
msgctxt "text_id=20086 | speaker=alice"
msgid "  It's not exactly a mistake; I just didn't even consider that."
msgstr "わたしのミスではないけれど、配慮が足りなかった。"

#. Occurrence NZ3:2996:20087: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0038; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:2996
msgctxt "text_id=20087 | speaker=alice"
msgid "  Next time, I won't make the same oversight."
msgstr "次からは、本当に気をつけるわ。"

#. Occurrence NZ3:3041:20088: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0039; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3041
msgctxt "text_id=20088 | speaker=alice"
msgid "      Anyway, the next Ploy-"
msgstr "　　　気を取り直して、次のプロイは―――"

#. Occurrence NZ3:3080:20089: voice_id=BA0_NZ3_0022; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3080
msgctxt "text_id=20089 | speaker=unknown"
msgid "          Woohoo!"
msgstr "　　　ヤフー！"

#. Occurrence NZ3:3080:20090: voice_id=BA0_NZ3_0022; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3080
msgctxt "text_id=20090 | speaker=unknown"
msgid "          Egg! I can eat egg!"
msgstr "　　　ジブンでも食べられる玉子ッスー！"

#. Occurrence NZ3:3114:20091: voice_id=BA0_NZ3_0023; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3114
msgctxt "text_id=20091 | speaker=unknown"
msgid "        Oh, wow. This egg is pucker!"
msgstr "　　うめぇ。玉子うめぇ。"

#. Occurrence NZ3:3114:20092: voice_id=BA0_NZ3_0023; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3114
msgctxt "text_id=20092 | speaker=unknown"
msgid "        Tho' it sits heavy on the butter 'n jelly."
msgstr "　　でも、なんかハラにたまるッスこの玉子。"

#. Occurrence NZ3:3147:20093: voice_id=BA0_NZ3_0024; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3147
msgctxt "text_id=20093 | speaker=unknown"
msgid "      Like I'm not quite digesting it..."
msgstr "　消化できないっつーか、"

#. Occurrence NZ3:3147:20094: voice_id=BA0_NZ3_0024; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3147
msgctxt "text_id=20094 | speaker=unknown"
msgid "      I dunno, I feel like I can 'ear a pecking noise"
msgstr "　なんか、体の中心からチクタクチクタク音が"

#. Occurrence NZ3:3147:20095: voice_id=BA0_NZ3_0024; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3147
msgctxt "text_id=20095 | speaker=unknown"
msgid "      coming from inside me body."
msgstr "　するってゆーかぁ。"

#. Occurrence NZ3:3178:20096: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0040; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3178
msgctxt "text_id=20096 | speaker=alice"
msgid "                Three."
msgstr "　　　　　　スリー。"

#. Occurrence NZ3:3209:20097: voice_id=BA0_NZ3_0025; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3209
msgctxt "text_id=20097 | speaker=unknown"
msgid "      Miss Alice?"
msgstr "　　　アリスさん？"

#. Occurrence NZ3:3209:20098: voice_id=BA0_NZ3_0025; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3209
msgctxt "text_id=20098 | speaker=unknown"
msgid "      Why're you backing away?"
msgstr "　　　なんで離れるッスか？"

#. Occurrence NZ3:3240:20099: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0041; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3240
msgctxt "text_id=20099 | speaker=alice"
msgid "                  Two."
msgstr "　　　　　　トゥー。"

#. Occurrence NZ3:3271:20100: voice_id=BA0_NZ3_0026; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3271
msgctxt "text_id=20100 | speaker=unknown"
msgid "        Why the"
msgstr "　なんで"

#. Occurrence NZ3:3271:20101: voice_id=BA0_NZ3_0026; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3271
msgctxt "text_id=20101 | speaker=unknown"
msgid "        \"sorry, but you're going to explode\""
msgstr "　“かわいそうだけど、あと一秒で爆発するのよ”"

#. Occurrence NZ3:3271:20102: voice_id=BA0_NZ3_0026; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3271
msgctxt "text_id=20102 | speaker=unknown"
msgid "        expression...?"
msgstr "　みたいな目で見るッスか？"

#. Occurrence NZ3:3302:20103: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0042; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3302
msgctxt "text_id=20103 | speaker=alice"
msgid "                  One."
msgstr "　　　　　　ワン。"

#. Occurrence NZ3:3334:20104: voice_id=BA0_NZ3_0027; voice_prefix=BA0; voice_category=0; scene=NZ3
#: NZ3:3334
msgctxt "text_id=20104 | speaker=unknown"
msgid "                    Help."
msgstr "　　　　　タスケテ。"

#. Occurrence NZ3:3365:20105: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0043; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3365
msgctxt "text_id=20105 | speaker=alice"
msgid "                Zero."
msgstr "　　　　　　ゼロ。"

#. Occurrence NZ3:3416:20106: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0044; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3416
msgctxt "text_id=20106 | speaker=alice"
msgid "        This Ploy is called Scratch Dumpty."
msgstr "これはスクラッチ・ダンプティね。"

#. Occurrence NZ3:3416:20107: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0044; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3416
msgctxt "text_id=20107 | speaker=alice"
msgid "        It's based on the old Humpty Dumpty"
msgstr "マザーグースの唄にあるハンプティ・ダンプティを"

#. Occurrence NZ3:3416:20108: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0044; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3416
msgctxt "text_id=20108 | speaker=alice"
msgid "        nursery rhyme."
msgstr "モデルにしたものよ。"

#. Occurrence NZ3:3442:20109: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0045; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3442
msgctxt "text_id=20109 | speaker=alice"
msgid "      \"An egg sat precariously on a wall,"
msgstr "　　“塀に上った卵はあぶなかしくて、"

#. Occurrence NZ3:3442:20110: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0045; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3442
msgctxt "text_id=20110 | speaker=alice"
msgid "      ignoring the King passing by, who told him to come down."
msgstr "　　通りがかった王様が降りろと言っても無視するばかり。"

#. Occurrence NZ3:3468:20111: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0046; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3468
msgctxt "text_id=20111 | speaker=alice"
msgid "  The angry King ordered his men to bring him down,"
msgstr "　　怒った王様は兵士たちに命じたけれど、"

#. Occurrence NZ3:3468:20112: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0046; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3468
msgctxt "text_id=20112 | speaker=alice"
msgid "  but they couldn't."
msgstr "　　兵士たちでも卵を下ろすコトはできなかった。"

#. Occurrence NZ3:3494:20113: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0047; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3494
msgctxt "text_id=20113 | speaker=alice"
msgid "    The King gave up and left the egg to his own devices."
msgstr "　もう好きにしろ、と疲れた王様は目を離す。"

#. Occurrence NZ3:3494:20114: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0047; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3494
msgctxt "text_id=20114 | speaker=alice"
msgid "    Then, the egg fell,"
msgstr "　そのとたんに卵は落ちて、"

#. Occurrence NZ3:3494:20115: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0047; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3494
msgctxt "text_id=20115 | speaker=alice"
msgid "    and tragically cracked into a million pieces."
msgstr "　見るも無惨、聞くも痛快に、粉々に砕け散った。"

#. Occurrence NZ3:3520:20116: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0048; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3520
msgctxt "text_id=20116 | speaker=alice"
msgid "      No matter how hard they tried-"
msgstr "　　油断も後悔も後のお祭り。"

#. Occurrence NZ3:3520:20117: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0048; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3520
msgctxt "text_id=20117 | speaker=alice"
msgid "      'All the King's horses and all the King's men"
msgstr "　　星のような欠片たちは、"

#. Occurrence NZ3:3520:20118: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0048; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3520
msgctxt "text_id=20118 | speaker=alice"
msgid "      couldn't put Humpty together again.'\""
msgstr "　　王の軍勢をもっても拾いきれない―――”"

#. Occurrence NZ3:3557:20119: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0049; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3557
msgctxt "text_id=20119 | speaker=alice"
msgid "Basically, it's a fable saying you can't fix something that's been broken."
msgstr "　　壊れた物は直らない、という寓話ね。"

#. Occurrence NZ3:3557:20120: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0049; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3557
msgctxt "text_id=20120 | speaker=alice"
msgid "I find it irritating."
msgstr "　　はた迷惑なお話だけど。"

#. Occurrence NZ3:3605:20121: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0050; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3605
msgctxt "text_id=20121 | speaker=alice"
msgid "  By the way,"
msgstr "ちなみに、"

#. Occurrence NZ3:3605:20122: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0050; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3605
msgctxt "text_id=20122 | speaker=alice"
msgid "  Humpty only became an egg in the 19th century."
msgstr "ハンプティが卵型になったのは１９世紀半ばから。"

#. Occurrence NZ3:3631:20123: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0051; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3631
msgctxt "text_id=20123 | speaker=alice"
msgid "    He appeared earlier in a panoramic picture book"
msgstr "　　１８４３年にアリキスというペンネームで、"

#. Occurrence NZ3:3631:20124: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0051; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3631
msgctxt "text_id=20124 | speaker=alice"
msgid "    authored by Samuel Edward Maberly under"
msgstr "　　マベリー牧師という人がハンプティの"

#. Occurrence NZ3:3631:20125: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0051; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3631
msgctxt "text_id=20125 | speaker=alice"
msgid "    the pen name Aliquis."
msgstr "　　パノラマ絵本を書いたのがはしり。"

#. Occurrence NZ3:3662:20126: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0052; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3662
msgctxt "text_id=20126 | speaker=alice"
msgid "  Lewis Carroll's Humpty was most"
msgstr "　ルイスキャロルのハンプティは、"

#. Occurrence NZ3:3662:20127: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0052; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3662
msgctxt "text_id=20127 | speaker=alice"
msgid "  likely based on this version."
msgstr "　それを参考にしたのでしょう。"

#. Occurrence NZ3:3761:20128: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0053_0; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3761
msgctxt "text_id=20128 | speaker=alice"
msgid "    Looks like they're all sold out."
msgstr "　 今夜は品切れのようね。"

#. Occurrence NZ3:3767:20129: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0053_1; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3767
msgctxt "text_id=20129 | speaker=alice"
msgid "    Check, please!"
msgstr " 　シェフ、オカンジョーをお願い。"

#. Occurrence NZ3:3921:20130: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0054; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3921
msgctxt "text_id=20130 | speaker=alice"
msgid "  Next time..."
msgstr "　　次は―――"

#. Occurrence NZ3:3921:20131: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ3_0054; voice_prefix=A40; voice_category=2; scene=NZ3
#: NZ3:3921
msgctxt "text_id=20131 | speaker=alice"
msgid "  ...I'm going to eat all the fatty tuna this place has."
msgstr "　　店中の大トロを、残らずいただくわ。"

#. Occurrence NZ4:126:20132: voice_id=BA0_NZ4_0000; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:126
msgctxt "text_id=20132 | speaker=unknown"
msgid "        Hey, working hard as always, lad?"
msgstr "おーす、今日もワンワン働いているッスかシャバ僧。"

#. Occurrence NZ4:126:20133: voice_id=BA0_NZ4_0000; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:126
msgctxt "text_id=20133 | speaker=unknown"
msgid "        Can I get a dozen bags of birdseed?"
msgstr "これで鳥の餌を一ダースくれ。"

#. Occurrence NZ4:126:20134: voice_id=BA0_NZ4_0000; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:126
msgctxt "text_id=20134 | speaker=unknown"
msgid "        Gimme yer best millet and wheat."
msgstr "ヒエかムギの一番いいところを頼む。"

#. Occurrence NZ4:159:20135: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0000; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:159
msgctxt "text_id=20135 | speaker=alice"
msgid "    Hello. Welcome."
msgstr "　　いらっしゃいませ。"

#. Occurrence NZ4:159:20136: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0000; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:159
msgctxt "text_id=20136 | speaker=alice"
msgid "    I'm surprised to see you out shopping^    during the day, Robin."
msgstr "　　昼間から買い物なんて、いい身分ねロビン。"

#. Occurrence NZ4:196:20137: voice_id=BA0_NZ4_0001; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:196
msgctxt "text_id=20137 | speaker=unknown"
msgid "    Gah! Miss Alice?!"
msgstr "　　げぇ、アリスさん！？"

#. Occurrence NZ4:196:20138: voice_id=BA0_NZ4_0001; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:196
msgctxt "text_id=20138 | speaker=unknown"
msgid "    W-w-w-what are you doing working here?!"
msgstr "　　ななな、なんで店員とかしてるッスー！？"

#. Occurrence NZ4:196:20139: voice_id=BA0_NZ4_0001; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:196
msgctxt "text_id=20139 | speaker=unknown"
msgid "    Where the heck is the kid?!"
msgstr "　　シャバ僧はどこいったッスか！？"

#. Occurrence NZ4:227:20140: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0001; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:227
msgctxt "text_id=20140 | speaker=alice"
msgid "    You sure care a lot about trivial things for a bird brain."
msgstr "　　トリ頭のクセに細かいコトを気にするのね。"

#. Occurrence NZ4:227:20141: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0001; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:227
msgctxt "text_id=20141 | speaker=alice"
msgid "    I'm in charge of the store today."
msgstr "　　今日はわたしが店番をしているの。"

#. Occurrence NZ4:227:20142: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0001; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:227
msgctxt "text_id=20142 | speaker=alice"
msgid "    Do you have a problem with that?"
msgstr "　　何か、意見があって？"

#. Occurrence NZ4:258:20143: voice_id=BA0_NZ4_0002; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:258
msgctxt "text_id=20143 | speaker=unknown"
msgid "  No... Of course not."
msgstr "いや、ないッスけど。"

#. Occurrence NZ4:258:20144: voice_id=BA0_NZ4_0002; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:258
msgctxt "text_id=20144 | speaker=unknown"
msgid "  You fit right in."
msgstr "あ。ピンときたッスよ。さてはアリスさん、"

#. Occurrence NZ4:258:20145: voice_id=BA0_NZ4_0002; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:258
msgctxt "text_id=20145 | speaker=unknown"
msgid "  I assume you're here to satisfy your sweet tooth."
msgstr "シャバ僧と一緒にアルバイトとかスイーツなコ、"

#. Occurrence NZ4:295:20146: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0002; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:295
msgctxt "text_id=20146 | speaker=alice"
msgid "    The Wonderful World of Ploys."
msgstr "　　　なぜなにー、プロイー。"

#. Occurrence NZ4:368:20147: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0003; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:368
msgctxt "text_id=20147 | speaker=alice"
msgid "  Today we're going to talk about a relatively safe Ploy."
msgstr "今回は比較的安全なプロイキッシャーの紹介よ。"

#. Occurrence NZ4:368:20148: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0003; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:368
msgctxt "text_id=20148 | speaker=alice"
msgid "  Okay, Robin..."
msgstr "さあロビン。"

#. Occurrence NZ4:368:20149: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0003; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:368
msgctxt "text_id=20149 | speaker=alice"
msgid "  Pick your favorite."
msgstr "好きなものを選びなさい。"

#. Occurrence NZ4:408:20150: voice_id=BA0_NZ4_0003; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:408
msgctxt "text_id=20150 | speaker=unknown"
msgid "  Would ya Adam and Eve it?"
msgstr "　ケーキショップかと思ったら、"

#. Occurrence NZ4:408:20151: voice_id=BA0_NZ4_0003; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:408
msgctxt "text_id=20151 | speaker=unknown"
msgid "  This \"bakery\" is a Ploy Kickshaw black market!"
msgstr "　プロイキッシャーを売ってる闇市場だった。"

#. Occurrence NZ4:408:20152: voice_id=BA0_NZ4_0003; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:408
msgctxt "text_id=20152 | speaker=unknown"
msgid "  Misaki's positively mental."
msgstr "　三咲町はホント地獄ッスね。"

#. Occurrence NZ4:441:20153: voice_id=BA0_NZ4_0004; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:441
msgctxt "text_id=20153 | speaker=unknown"
msgid "    Let's go in order from the right."
msgstr "　じゃあ右端から順にいくッスか。"

#. Occurrence NZ4:441:20154: voice_id=BA0_NZ4_0004; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:441
msgctxt "text_id=20154 | speaker=unknown"
msgid "    What's this thing 'ere that^    looks like a jewelry box?"
msgstr "　この宝石箱っぽいヤツは何スか？"

#. Occurrence NZ4:518:20155: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0004; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:518
msgctxt "text_id=20155 | speaker=alice"
msgid "      That's Sixpence."
msgstr "　　それは６ペンスの歌。"

#. Occurrence NZ4:518:20156: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0004; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:518
msgctxt "text_id=20156 | speaker=alice"
msgid "      It's a jack-in-the-box"
msgstr "　　ジャック・イン・ザ・ボックス、"

#. Occurrence NZ4:518:20157: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0004; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:518
msgctxt "text_id=20157 | speaker=alice"
msgid "      called Six Sing Chocolates."
msgstr "　　シックス・スィング・チョコレイトよ。"

#. Occurrence NZ4:582:20158: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0005; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:582
msgctxt "text_id=20158 | speaker=alice"
msgid "    It looks pretty plain and boring, but it's actually^    quite useful."
msgstr "　　　地味に見えるけど、役に立つプロイね。"

#. Occurrence NZ4:582:20159: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0005; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:582
msgctxt "text_id=20159 | speaker=alice"
msgid "    Unlike some Ploys around here."
msgstr "　　　どこかの誰かさんとは大違い。"

#. Occurrence NZ4:631:20160: voice_id=BA0_NZ4_0005; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:631
msgctxt "text_id=20160 | speaker=unknown"
msgid "      Well, of course!"
msgstr "あったりまえッス！"

#. Occurrence NZ4:631:20161: voice_id=BA0_NZ4_0005; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:631
msgctxt "text_id=20161 | speaker=unknown"
msgid "      A bird's a capable and elegant familiar."
msgstr "鳥はすべて有能かつエレガントな使い魔ッスから。"

#. Occurrence NZ4:664:20162: voice_id=BA0_NZ4_0006; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:664
msgctxt "text_id=20162 | speaker=unknown"
msgid "      And that's precisely why"
msgstr "　　かくいうジブンも"

#. Occurrence NZ4:664:20163: voice_id=BA0_NZ4_0006; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:664
msgctxt "text_id=20163 | speaker=unknown"
msgid "      I know that ol' Sixpence bit."
msgstr "　　６ペンスの歌なら知ってるッスよ。"

#. Occurrence NZ4:664:20164: voice_id=BA0_NZ4_0006; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:664
msgctxt "text_id=20164 | speaker=unknown"
msgid "      Y'know, because of the bird connection."
msgstr "　　鳥つながりで。"

#. Occurrence NZ4:708:20165: voice_id=BA0_NZ4_0007; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:708
msgctxt "text_id=20165 | speaker=unknown"
msgid "    \"Sing a song of sixpence,"
msgstr "『６ペンスの歌を歌うッス～♪"

#. Occurrence NZ4:708:20166: voice_id=BA0_NZ4_0007; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:708
msgctxt "text_id=20166 | speaker=unknown"
msgid "    a pocket full of rye."
msgstr "ポケットにはいっぱいのライ麦ッス～♪"

#. Occurrence NZ4:708:20167: voice_id=BA0_NZ4_0007; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:708
msgctxt "text_id=20167 | speaker=unknown"
msgid "    Four and twenty blackbirds, baked in a pie.\""
msgstr "24羽の黒ムクドリ～パイの中に焼きこまれた～♪』"

#. Occurrence NZ4:739:20168: voice_id=BA0_NZ4_0008; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:739
msgctxt "text_id=20168 | speaker=unknown"
msgid "    ...Oh, jeepers."
msgstr "……むう。"

#. Occurrence NZ4:739:20169: voice_id=BA0_NZ4_0008; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:739
msgctxt "text_id=20169 | speaker=unknown"
msgid "    Who'd murder innocent birds for no reason?"
msgstr "なぜ意味もなく鳥を虐殺するのか分かんないッス。"

#. Occurrence NZ4:739:20170: voice_id=BA0_NZ4_0008; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:739
msgctxt "text_id=20170 | speaker=unknown"
msgid "    Don't continentals love a Richard the Third?"
msgstr "西欧圏の人間どもは鳥をなんだと思っていたのか。"

#. Occurrence NZ4:765:20171: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0006; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:765
msgctxt "text_id=20171 | speaker=alice"
msgid "  Anyway, \"The king was in his counting house, counting out"
msgstr "　 その後は『お金の勘定をする王さま』"

#. Occurrence NZ4:765:20172: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0006; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:765
msgctxt "text_id=20172 | speaker=alice"
msgid "  his money; The queen was in the parlor, eating bread and"
msgstr " 　『こっそりハチミツかけたパンを食べる王妃』"

#. Occurrence NZ4:765:20173: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0006; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:765
msgctxt "text_id=20173 | speaker=alice"
msgid "  honey.\" That's the second verse."
msgstr " 　といった歌詞が続くわね。"

#. Occurrence NZ4:791:20174: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0007; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:791
msgctxt "text_id=20174 | speaker=alice"
msgid "      From that point onward, the song seems"
msgstr "　　二番目以降は"

#. Occurrence NZ4:791:20175: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0007; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:791
msgctxt "text_id=20175 | speaker=alice"
msgid "      to turn into a bit of a political satire."
msgstr "　　当時の政治を風刺した唄なんじゃないかしら。"

#. Occurrence NZ4:851:20176: voice_id=BA0_NZ4_0009; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:851
msgctxt "text_id=20176 | speaker=unknown"
msgid "   Dunno. Sounds like a day in the Kuonji mansion"
msgstr "いや、端的に久遠寺邸の日々を表しているッス。"

#. Occurrence NZ4:851:20177: voice_id=BA0_NZ4_0009; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:851
msgctxt "text_id=20177 | speaker=unknown"
msgid "   to me. It's not a king that's countin' his money,"
msgstr "金勘定するのが王じゃなくて女王な青セーターで、"

#. Occurrence NZ4:851:20178: voice_id=BA0_NZ4_0009; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:851
msgctxt "text_id=20178 | speaker=unknown"
msgid "   it's a queen, and she's wearin' a blue sweater."
msgstr "こっそり贅沢をするのが王妃じゃなくてアリ"

#. Occurrence NZ4:888:20179: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0008; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:888
msgctxt "text_id=20179 | speaker=alice"
msgid "            Begone, Robin."
msgstr "　　　さよならー、ロビンー。"

#. Occurrence NZ4:975:20180: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0009; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:975
msgctxt "text_id=20180 | speaker=alice"
msgid "            What's next?"
msgstr "　　　　　次はなに？"

#. Occurrence NZ4:1014:20181: voice_id=BA0_NZ4_0010_0; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1014
msgctxt "text_id=20181 | speaker=unknown"
msgid "  Can't you say,"
msgstr "生きてる？　とか　愛してる？"

#. Occurrence NZ4:1014:20182: voice_id=BA0_NZ4_0010_0; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1014
msgctxt "text_id=20182 | speaker=unknown"
msgid "  \"Are you okay?\" or \"I love you\"?"
msgstr "とか、そういうセリフはないッスか。"

#. Occurrence NZ4:1020:20183: voice_id=BA0_NZ4_0010_1; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1020
msgctxt "text_id=20183 | speaker=unknown"
msgid "  ...Guess not."
msgstr "ないッスね。"

#. Occurrence NZ4:1053:20184: voice_id=BA0_NZ4_0011; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1053
msgctxt "text_id=20184 | speaker=unknown"
msgid "        No prob by me."
msgstr "でもジブン的には<無問題|ノープロ>。"

#. Occurrence NZ4:1053:20185: voice_id=BA0_NZ4_0011; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1053
msgctxt "text_id=20185 | speaker=unknown"
msgid "        Tough love is still love."
msgstr "アリスさんの虐待もラブのカタ……"

#. Occurrence NZ4:1091:20186: voice_id=BA0_NZ4_0012; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1091
msgctxt "text_id=20186 | speaker=unknown"
msgid "            Bwahahahahaha!"
msgstr "　　　　ん、ぶはははははは！"

#. Occurrence NZ4:1160:20187: voice_id=BA0_NZ4_0013; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1160
msgctxt "text_id=20187 | speaker=unknown"
msgid "      What the hell's this?"
msgstr "　　　なんスかコレ、超ウケルー！"

#. Occurrence NZ4:1160:20188: voice_id=BA0_NZ4_0013; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1160
msgctxt "text_id=20188 | speaker=unknown"
msgid "      Talk about fugly! A face"
msgstr "　　　このでっぷりしたヤツ、超ブサイクなんですけどー！"

#. Occurrence NZ4:1160:20189: voice_id=BA0_NZ4_0013; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1160
msgctxt "text_id=20189 | speaker=unknown"
msgid "      only a mother could love!"
msgstr "　　　生きてるのが恥ずかしくなるレベルッスー！"

#. Occurrence NZ4:1192:20190: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0010; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1192
msgctxt "text_id=20190 | speaker=alice"
msgid "              That's you."
msgstr "　　　　　アナタよ。"

#. Occurrence NZ4:1226:20191: voice_id=BA0_NZ4_0014; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1226
msgctxt "text_id=20191 | speaker=unknown"
msgid "                    Me?"
msgstr "　　　　　アナタヨ？"

#. Occurrence NZ4:1257:20192: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0011; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1257
msgctxt "text_id=20192 | speaker=alice"
msgid "          Yeah. Your true form."
msgstr "　　だから、それがアナタの本体。"

#. Occurrence NZ4:1257:20193: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0011; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1257
msgctxt "text_id=20193 | speaker=alice"
msgid "          It says Lost Robin Rondo on the tag."
msgstr "　　ロスト・ロビン・ロンド、とタグには書かれているけど、"

#. Occurrence NZ4:1257:20194: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0011; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1257
msgctxt "text_id=20194 | speaker=alice"
msgid "          The name's wasted on you."
msgstr "　　アナタには勿体ない名称ね。"

#. Occurrence NZ4:1288:20195: voice_id=BA0_NZ4_0015; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1288
msgctxt "text_id=20195 | speaker=unknown"
msgid "        Like it was chiseled by Michelangelo 'imself!"
msgstr "　まさにミケランジェロクラスの造形ッス。"

#. Occurrence NZ4:1288:20196: voice_id=BA0_NZ4_0015; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1288
msgctxt "text_id=20196 | speaker=unknown"
msgid "        I knew from the moment I came through the door"
msgstr "　ジブン、店に入った時から、コイツが一番高価で大人気だって"

#. Occurrence NZ4:1288:20197: voice_id=BA0_NZ4_0015; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1288
msgctxt "text_id=20197 | speaker=unknown"
msgid "        that this'd be the treasure of the store! I mean it!"
msgstr "　気付いてたッスよ。ほんとほんと。"

#. Occurrence NZ4:1319:20198: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0012; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1319
msgctxt "text_id=20198 | speaker=alice"
msgid "No detailed info needed for this one."
msgstr "詳細データは必要ないわね。"

#. Occurrence NZ4:1319:20199: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0012; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1319
msgctxt "text_id=20199 | speaker=alice"
msgid "You already got your time in the limelight in the main story."
msgstr "アナタ、本編で十分すぎるほど出しゃばってるから。"

#. Occurrence NZ4:1350:20200: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0013; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1350
msgctxt "text_id=20200 | speaker=alice"
msgid "    It's based on an old funeral song."
msgstr "　　元は葬式の歌よ。"

#. Occurrence NZ4:1350:20201: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0013; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1350
msgctxt "text_id=20201 | speaker=alice"
msgid "    It tells the story of a robin that was killed."
msgstr "　　殺された<駒鳥|ロビン>を巡ってのお話。"

#. Occurrence NZ4:1376:20202: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0014; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1376
msgctxt "text_id=20202 | speaker=alice"
msgid "    The song asks, \"Who killed the robin?\""
msgstr "　　「誰が？」という問いかけに、"

#. Occurrence NZ4:1376:20203: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0014; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1376
msgctxt "text_id=20203 | speaker=alice"
msgid "    The funeralgoers each respond with, \"I did.\""
msgstr "　　「わたしが」と参列者たちが答えていくの。"

#. Occurrence NZ4:1376:20204: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0014; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1376
msgctxt "text_id=20204 | speaker=alice"
msgid "    It's a song about finding the culprit."
msgstr "　　犯人捜しの歌でもあるわ。"

#. Occurrence NZ4:1402:20205: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0015; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1402
msgctxt "text_id=20205 | speaker=alice"
msgid "      It was a hugely popular Mother Goose rhyme,"
msgstr "　大ヒットしたマザーグースで、その後、"

#. Occurrence NZ4:1402:20206: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0015; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1402
msgctxt "text_id=20206 | speaker=alice"
msgid "      along with \"The Marriage of Cock Robin and Jenny Wren,\""
msgstr "　前日譚である「コックロビンとジェニーレンの幸せな求婚」が"

#. Occurrence NZ4:1402:20207: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0015; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1402
msgctxt "text_id=20207 | speaker=alice"
msgid "      which was a prequel."
msgstr "　出版され、これまたヒット。"

#. Occurrence NZ4:1433:20208: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0016; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1433
msgctxt "text_id=20208 | speaker=alice"
msgid "    After that, \"The Trial and Execution of the Sparrow for Killing"
msgstr "　その後、コックロビンの死の後を歌った"

#. Occurrence NZ4:1433:20209: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0016; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1433
msgctxt "text_id=20209 | speaker=alice"
msgid "    Cock Robin\" was published, which follows the trial of the sparrow."
msgstr "　スズメの裁判と処罰も出版。"

#. Occurrence NZ4:1433:20210: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0016; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1433
msgctxt "text_id=20210 | speaker=alice"
msgid "    You ought to be making a killing in royalties, Robin. I envy you."
msgstr "　羨ましいわ。印税だけで大もうけね、ロビン。"

#. Occurrence NZ4:1465:20211: voice_id=BA0_NZ4_0016; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1465
msgctxt "text_id=20211 | speaker=unknown"
msgid "      Birds never get a penny."
msgstr "　　鳥には一円も入ってこないッスけどね。"

#. Occurrence NZ4:1496:20212: voice_id=BA0_NZ4_0017; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1496
msgctxt "text_id=20212 | speaker=unknown"
msgid "      Anyway, Alice, did you know?"
msgstr "　　それよりアリスさん、知ってるッスか。"

#. Occurrence NZ4:1496:20213: voice_id=BA0_NZ4_0017; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1496
msgctxt "text_id=20213 | speaker=unknown"
msgid "      The robin is the national bird of Britain."
msgstr "　　駒鳥はイギリスの国鳥ッスよ。"

#. Occurrence NZ4:1496:20214: voice_id=BA0_NZ4_0017; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1496
msgctxt "text_id=20214 | speaker=unknown"
msgid "      And it symbolizes Christmas."
msgstr "　　クリスマスの象徴でもあるッス。"

#. Occurrence NZ4:1523:20215: voice_id=BA0_NZ4_0018_0; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1523
msgctxt "text_id=20215 | speaker=unknown"
msgid "      In other words...^      I'm the bona fide hero of Mahoyo-"
msgstr "　　つまり―――まほよの主役はジブ"

#. Occurrence NZ4:1564:20216: voice_id=BA0_NZ4_0018_1; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1564
msgctxt "text_id=20216 | speaker=unknown"
msgid "Agh!"
msgstr "きゃ。"

#. Occurrence NZ4:1708:20217: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0017; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1708
msgctxt "text_id=20217 | speaker=alice"
msgid "          We can't let your ego get too big."
msgstr "　　　あんまり調子に乗ってると、たいへんよ"

#. Occurrence NZ4:1735:20218: voice_id=BA0_NZ4_0019; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1735
msgctxt "text_id=20218 | speaker=unknown"
msgid "      Might be too late for that."
msgstr "　 既にこれ以上ないほど大変ッス"

#. Occurrence NZ4:1766:20219: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0018; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1766
msgctxt "text_id=20219 | speaker=alice"
msgid "          Not much left to talk about."
msgstr "　　あとは……ほとんど残り物ね。"

#. Occurrence NZ4:1766:20220: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0018; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1766
msgctxt "text_id=20220 | speaker=alice"
msgid "          Nothing really worth showing off."
msgstr "　　とりたてて紹介するほどの物ではないわ。"

#. Occurrence NZ4:1828:20221: voice_id=BA0_NZ4_0020; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1828
msgctxt "text_id=20221 | speaker=unknown"
msgid "        Alice! Miss Alice!"
msgstr "　　アリスさんアリスさん。"

#. Occurrence NZ4:1828:20222: voice_id=BA0_NZ4_0020; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1828
msgctxt "text_id=20222 | speaker=unknown"
msgid "        What's this third Ploy 'ere?"
msgstr "　　この三つ目のプロイ、なんスか？"

#. Occurrence NZ4:1828:20223: voice_id=BA0_NZ4_0020; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1828
msgctxt "text_id=20223 | speaker=unknown"
msgid "        It's a candy that looks like an eye!"
msgstr "　　目……っぽいカタチをしたキャンディ？"

#. Occurrence NZ4:1860:20224: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0019; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1860
msgctxt "text_id=20224 | speaker=alice"
msgid "            It's an eyeball."
msgstr "　　　　　　目玉よ。"

#. Occurrence NZ4:1894:20225: voice_id=BA0_NZ4_0021; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1894
msgctxt "text_id=20225 | speaker=unknown"
msgid "  You mean, a candy that looks like one, right?"
msgstr "　　目玉っぽいキャンディ？"

#. Occurrence NZ4:1925:20226: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0020; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1925
msgctxt "text_id=20226 | speaker=alice"
msgid "        No, it's an actual eyeball."
msgstr "　　　　本物の目玉よ。"

#. Occurrence NZ4:1925:20227: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0020; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:1925
msgctxt "text_id=20227 | speaker=alice"
msgid "        Wanna see?"
msgstr "　　　　見る？"

#. Occurrence NZ4:1976:20228: voice_id=BA0_NZ4_0022; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1976
msgctxt "text_id=20228 | speaker=unknown"
msgid "    Gwaaarghhhh!"
msgstr "　　ピギャーーーー！？"

#. Occurrence NZ4:1976:20229: voice_id=BA0_NZ4_0022; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:1976
msgctxt "text_id=20229 | speaker=unknown"
msgid "    Your left eye's made of glass?!"
msgstr "　　アリスさんの左目、義眼だったッスか！？"

#. Occurrence NZ4:2007:20230: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0021; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2007
msgctxt "text_id=20230 | speaker=alice"
msgid "      That's not what I meant."
msgstr "　　　……そういう訳ではないのだけど。"

#. Occurrence NZ4:2007:20231: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0021; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2007
msgctxt "text_id=20231 | speaker=alice"
msgid "      It's used like a Ploy."
msgstr "　　　わたしの左目もプロイ扱いなだけよ。"

#. Occurrence NZ4:2072:20232: voice_id=BA0_NZ4_0023; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:2072
msgctxt "text_id=20232 | speaker=unknown"
msgid "      Oi, what's 'acrostic' mean?"
msgstr "　　？　アクロスティック化って、なんスか？"

#. Occurrence NZ4:2103:20233: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0022; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2103
msgctxt "text_id=20233 | speaker=alice"
msgid "  Words have many meanings."
msgstr "　一つの言葉にたくさんの意味を持たせる事よ。"

#. Occurrence NZ4:2103:20234: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0022; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2103
msgctxt "text_id=20234 | speaker=alice"
msgid "  Like the many portmanteaus Lewis Carroll used."
msgstr "　ルイス・キャロルが提示した「鞄語」と同じね。"

#. Occurrence NZ4:2129:20235: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0023; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2129
msgctxt "text_id=20235 | speaker=alice"
msgid "  In Through the Looking Glass, Alice asks Humpty,"
msgstr "　鏡の国でアリスはハンプティにこう質問したの。"

#. Occurrence NZ4:2129:20236: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0023; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2129
msgctxt "text_id=20236 | speaker=alice"
msgid "  \"What does the word 'slithy' mean?\""
msgstr "　「しなぬるストーブってどういう意味？」"

#. Occurrence NZ4:2160:20237: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0024; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2160
msgctxt "text_id=20237 | speaker=alice"
msgid "  To which Humpty replied, \"well,"
msgstr "　　　ハンプティは答えたわ。"

#. Occurrence NZ4:2160:20238: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0024; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2160
msgctxt "text_id=20238 | speaker=alice"
msgid "  'slithy' means 'lithe and slimy.'\""
msgstr "　　　「うむ。それはな、しなやかでぬるやかという意味だ」"

#. Occurrence NZ4:2191:20239: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0025; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2191
msgctxt "text_id=20239 | speaker=alice"
msgid "  ...Got it? "
msgstr "……分かって？"

#. Occurrence NZ4:2191:20240: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0025; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2191
msgctxt "text_id=20240 | speaker=alice"
msgid "  When you acrostify Mystic Eyes, you change the"
msgstr "ようは、異なる二つの意味を新しい「言葉」として"

#. Occurrence NZ4:2191:20241: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0025; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2191
msgctxt "text_id=20241 | speaker=alice"
msgid "  rules by mixing meanings to form a new \"word.\""
msgstr "生み出すルール変更。それが魔眼のアクロ化よ。"

#. Occurrence NZ4:2222:20242: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0026; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2222
msgctxt "text_id=20242 | speaker=alice"
msgid "    I'm not saying the concept is entirely based^    around Humpty Dumpty;"
msgstr "別にハンプティがモデルという訳ではないのだけど、"

#. Occurrence NZ4:2222:20243: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0026; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2222
msgctxt "text_id=20243 | speaker=alice"
msgid "    she just gave it a name referencing his idea."
msgstr "彼女はハンプティにちなんだ名前をつけたのね。"

#. Occurrence NZ4:2284:20244: voice_id=BA0_NZ4_0024; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:2284
msgctxt "text_id=20244 | speaker=unknown"
msgid "      Brilliant. This is just a random question,"
msgstr "　ふーん。ただの思いつきなんスけど、"

#. Occurrence NZ4:2284:20245: voice_id=BA0_NZ4_0024; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:2284
msgctxt "text_id=20245 | speaker=unknown"
msgid "      but what would happen if you combined"
msgstr "　「初回限定版」と「通常版」をくっつけると"

#. Occurrence NZ4:2284:20246: voice_id=BA0_NZ4_0024; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:2284
msgctxt "text_id=20246 | speaker=unknown"
msgid "      'limited first edition' and 'standard edition?'"
msgstr "　どうなるッスか？"

#. Occurrence NZ4:2315:20247: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0027; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2315
msgctxt "text_id=20247 | speaker=alice"
msgid "Hmm, if you did that, you'd have a"
msgstr "そうね。その二つを合わせた場合、"

#. Occurrence NZ4:2315:20248: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0027; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2315
msgctxt "text_id=20248 | speaker=alice"
msgid "product with the first-edition bonuses"
msgstr "初回特典付きのアイテムが永遠に"

#. Occurrence NZ4:2315:20249: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0027; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2315
msgctxt "text_id=20249 | speaker=alice"
msgid "that would stay on the market forever."
msgstr "市場に残り続けるでしょう。"

#. Occurrence NZ4:2346:20250: voice_id=BA0_NZ4_0025; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:2346
msgctxt "text_id=20250 | speaker=unknown"
msgid "      Bwahaha! So the new phrase would be"
msgstr "ぶはは！"

#. Occurrence NZ4:2346:20251: voice_id=BA0_NZ4_0025; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:2346
msgctxt "text_id=20251 | speaker=unknown"
msgid "      \"special first standard edition!\""
msgstr "その場合、新しい言葉は「初回限定普及版」ッスね！"

#. Occurrence NZ4:2379:20252: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0028; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2379
msgctxt "text_id=20252 | speaker=alice"
msgid "      No. You'd get \"bargain bin.\""
msgstr "　　違うわ。「ワゴン行き」よ。"

#. Occurrence NZ4:2411:20253: voice_id=BA0_NZ4_0026; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:2411
msgctxt "text_id=20253 | speaker=unknown"
msgid "                  Ack!"
msgstr "　　　　　　　げ。"

#. Occurrence NZ4:2478:20254: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0029; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2478
msgctxt "text_id=20254 | speaker=alice"
msgid "      Ahem."
msgstr "　　……コホン。"

#. Occurrence NZ4:2478:20255: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0029; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2478
msgctxt "text_id=20255 | speaker=alice"
msgid "      As you can see, it's a tricky Ploy to use."
msgstr "　　このように、使い処が難しいプロイなの。"

#. Occurrence NZ4:2478:20256: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0029; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2478
msgctxt "text_id=20256 | speaker=alice"
msgid "      I'll be more careful in the future."
msgstr "　　今後は気をつけるわ。"

#. Occurrence NZ4:2517:20257: voice_id=BA0_NZ4_0027; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:2517
msgctxt "text_id=20257 | speaker=unknown"
msgid "  Let's see... Next we have... Ah, this one."
msgstr "次は……ああ、これっスか。"

#. Occurrence NZ4:2517:20258: voice_id=BA0_NZ4_0027; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:2517
msgctxt "text_id=20258 | speaker=unknown"
msgid "  Nah, let's save this for another cockney rhyme."
msgstr "コイツについては番外編で語るんで、パスっスね。"

#. Occurrence NZ4:2561:20259: voice_id=BA0_NZ4_0028; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:2561
msgctxt "text_id=20259 | speaker=unknown"
msgid "      What about... this one?"
msgstr "　次は―――なんスか、これ？"

#. Occurrence NZ4:2592:20260: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0030; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2592
msgctxt "text_id=20260 | speaker=alice"
msgid "    ...Just a failed creation."
msgstr "……ただの失敗品よ。"

#. Occurrence NZ4:2592:20261: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0030; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2592
msgctxt "text_id=20261 | speaker=alice"
msgid "    My first Ploy ever. It doesn't have any real use."
msgstr "わたしの最初のプロイ。"

#. Occurrence NZ4:2592:20262: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0030; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2592
msgctxt "text_id=20262 | speaker=alice"
msgid "    I've just held on to it for sentimental value."
msgstr "使い道はないのだけど、記念として飾っているの。"

#. Occurrence NZ4:2653:20263: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0031; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2653
msgctxt "text_id=20263 | speaker=alice"
msgid "  As you can see, it's not useful in mage battles."
msgstr "この通り、魔術戦には使えないわ。"

#. Occurrence NZ4:2653:20264: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0031; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2653
msgctxt "text_id=20264 | speaker=alice"
msgid "  It doesn't look very nice either. Still, sentimental value, right?"
msgstr "カタチもよくないから見せる物でもないのだけど……こういうのは、思い出だから。"

#. Occurrence NZ4:2711:20265: voice_id=BA0_NZ4_0029; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:2711
msgctxt "text_id=20265 | speaker=unknown"
msgid "      This confectionery's shaped like a brooch."
msgstr "　ブローチのカタチをした砂糖細工なんスねー。"

#. Occurrence NZ4:2711:20266: voice_id=BA0_NZ4_0029; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:2711
msgctxt "text_id=20266 | speaker=unknown"
msgid "      Wow, it's so sweet!"
msgstr "　うは、あめぇー！"

#. Occurrence NZ4:2711:20267: voice_id=BA0_NZ4_0029; voice_prefix=BA0; voice_category=0; scene=NZ4
#: NZ4:2711
msgctxt "text_id=20267 | speaker=unknown"
msgid "      You make the best sweets!"
msgstr "　アリスさんの手作りキャンディ、あめぇー！"

#. Occurrence NZ4:2787:20268: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0032; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2787
msgctxt "text_id=20268 | speaker=alice"
msgid "    That wraps up today's lesson."
msgstr "　そろそろ終業時間ね。"

#. Occurrence NZ4:2787:20269: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0032; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2787
msgctxt "text_id=20269 | speaker=alice"
msgid "    I'm heading home."
msgstr "　わたしは先に帰っているから、"

#. Occurrence NZ4:2787:20270: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ4_0032; voice_prefix=A40; voice_category=2; scene=NZ4
#: NZ4:2787
msgctxt "text_id=20270 | speaker=alice"
msgid "    You can clean up."
msgstr "　後片づけをやっておいて。"

#. Occurrence NZ5:97:20271: voice_id=BA0_NZ5_0000; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:97
msgctxt "text_id=20271 | speaker=unknown"
msgid "    Whew. What a way to start,"
msgstr "　ふう。この蒼天に浮かれて、"

#. Occurrence NZ5:97:20272: voice_id=BA0_NZ5_0000; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:97
msgctxt "text_id=20272 | speaker=unknown"
msgid "    under a bright, blue sky."
msgstr "　ついタイトルコールを叫んでしまったッス。"

#. Occurrence NZ5:128:20273: voice_id=BA0_NZ5_0001; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:128
msgctxt "text_id=20273 | speaker=unknown"
msgid "  Though it don't look like Miss Alice's here yet."
msgstr "　　しかし、指定場所に来たもののアリスさんの姿はなし。"

#. Occurrence NZ5:128:20274: voice_id=BA0_NZ5_0001; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:128
msgctxt "text_id=20274 | speaker=unknown"
msgid "  Pretty sure I got the right time and place."
msgstr "　　時間と場所はあってるハズなんスけどー。"

#. Occurrence NZ5:128:20275: voice_id=BA0_NZ5_0001; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:128
msgctxt "text_id=20275 | speaker=unknown"
msgid "  Maybe I should get a start and save some face."
msgstr "　　もう一回タイトルコール、してみるッスか。"

#. Occurrence NZ5:154:20276: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0000; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:154
msgctxt "text_id=20276 | speaker=alice"
msgid "    No, that won't be necessary."
msgstr "　　いいえ。その必要はないわ。"

#. Occurrence NZ5:154:20277: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0000; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:154
msgctxt "text_id=20277 | speaker=alice"
msgid "    I've been camping out here since yesterday."
msgstr "　　わたしは昨日からビバーク中なのだから。"

#. Occurrence NZ5:197:20278: voice_id=BA0_NZ5_0002; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:197
msgctxt "text_id=20278 | speaker=unknown"
msgid "      Miss Alice?!"
msgstr "　アリスさん！？"

#. Occurrence NZ5:197:20279: voice_id=BA0_NZ5_0002; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:197
msgctxt "text_id=20279 | speaker=unknown"
msgid "      Bwahaha! Talk about over-prepared LOL"
msgstr "　ギャハハ、なんスかその完全装備wwwww"

#. Occurrence NZ5:197:20280: voice_id=BA0_NZ5_0002; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:197
msgctxt "text_id=20280 | speaker=unknown"
msgid "      You're taking this way too seriously!"
msgstr "　ファッションから入る、なんちゃって登山家"

#. Occurrence NZ5:264:20281: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0001; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:264
msgctxt "text_id=20281 | speaker=alice"
msgid "      Spoken like a true amateur!"
msgstr "　　　アマチュアバード！"

#. Occurrence NZ5:307:20282: voice_id=BA0_NZ5_0003; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:307
msgctxt "text_id=20282 | speaker=unknown"
msgid "                  Gah!"
msgstr "　　　　　ぴっける！？"

#. Occurrence NZ5:342:20283: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0002; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:342
msgctxt "text_id=20283 | speaker=alice"
msgid "    Never underestimate mountain climbing."
msgstr "山を甘く見ないことよ。"

#. Occurrence NZ5:342:20284: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0002; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:342
msgctxt "text_id=20284 | speaker=alice"
msgid "    Some migrating birds die trying to make it over the mountains,^    did you know?"
msgstr "渡り鳥が山越えをする時、何割かは越えられずに脱落死する話を知らないのかしら。"

#. Occurrence NZ5:368:20285: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0003; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:368
msgctxt "text_id=20285 | speaker=alice"
msgid "        Stay prepared, or die."
msgstr "　油断すれば即デッド。"

#. Occurrence NZ5:368:20286: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0003; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:368
msgctxt "text_id=20286 | speaker=alice"
msgid "        The mountain knows no mercy."
msgstr "　隙あらば是キリング。"

#. Occurrence NZ5:368:20287: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0003; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:368
msgctxt "text_id=20287 | speaker=alice"
msgid "        Disrespect the gods here at your peril."
msgstr "　それが、神々の住まう<頂|いただき>への礼儀と知りなさい。"

#. Occurrence NZ5:395:20288: voice_id=BA0_NZ5_0004; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:395
msgctxt "text_id=20288 | speaker=unknown"
msgid "          Yep, you're chicken jalfrezi as ever."
msgstr "つまり、いつもと何も変わらないってコトッスね。"

#. Occurrence NZ5:430:20289: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0004; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:430
msgctxt "text_id=20289 | speaker=alice"
msgid "    I'll say it again."
msgstr "　　繰り返すわ。"

#. Occurrence NZ5:430:20290: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0004; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:430
msgctxt "text_id=20290 | speaker=alice"
msgid "    Do not underestimate me or the mountain."
msgstr "　　山とわたしを甘く見ないで。"

#. Occurrence NZ5:430:20291: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0004; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:430
msgctxt "text_id=20291 | speaker=alice"
msgid "    I'm twice as prepared today than I am normally."
msgstr "　　今日はいつもの二倍はやる気に満ちている。"

#. Occurrence NZ5:463:20292: voice_id=BA0_NZ5_0005; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:463
msgctxt "text_id=20292 | speaker=unknown"
msgid "        Crikey."
msgstr "　やっべぇー。"

#. Occurrence NZ5:463:20293: voice_id=BA0_NZ5_0005; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:463
msgctxt "text_id=20293 | speaker=unknown"
msgid "        You're really into it, eh?"
msgstr "　なんかスイッチ入ってるッスー。"

#. Occurrence NZ5:498:20294: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0005; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:498
msgctxt "text_id=20294 | speaker=alice"
msgid "  Anyway, Robin, it's time for \"The Wonderful World of Ploys\" again."
msgstr "　　さあ、なぜなにプロイの時間よ、ロビン。"

#. Occurrence NZ5:498:20295: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0005; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:498
msgctxt "text_id=20295 | speaker=alice"
msgid "  And since I'm in such a good mood today,"
msgstr "　　今日は気分がいいから、"

#. Occurrence NZ5:498:20296: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0005; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:498
msgctxt "text_id=20296 | speaker=alice"
msgid "  I'll talk about something very special I've been saving."
msgstr "　　取っておきの話をするとしましょう。"

#. Occurrence NZ5:529:20297: voice_id=BA0_NZ5_0006; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:529
msgctxt "text_id=20297 | speaker=unknown"
msgid "          Yeah! That's what I'm talking about!"
msgstr "　　あー、ついにきたッスね。"

#. Occurrence NZ5:529:20298: voice_id=BA0_NZ5_0006; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:529
msgctxt "text_id=20298 | speaker=unknown"
msgid "          The Great Three Ploys!"
msgstr "　　三大プロイ、グレートスリーについて。"

#. Occurrence NZ5:560:20299: voice_id=BA0_NZ5_0007; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:560
msgctxt "text_id=20299 | speaker=unknown"
msgid "      Your mum's... mum's..."
msgstr "　　アリスさんの母上の、そのまた母上の、"

#. Occurrence NZ5:560:20300: voice_id=BA0_NZ5_0007; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:560
msgctxt "text_id=20300 | speaker=unknown"
msgid "      ...mum's... mum's... Whatever! The first generation!"
msgstr "　　そのまた母上の……とにかく初代ッスね。"

#. Occurrence NZ5:560:20301: voice_id=BA0_NZ5_0007; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:560
msgctxt "text_id=20301 | speaker=unknown"
msgid "      Three miracles passed down from the first generation."
msgstr "　　初代の頃から伝わってきた、三つの奇跡。"

#. Occurrence NZ5:591:20302: voice_id=BA0_NZ5_0008; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:591
msgctxt "text_id=20302 | speaker=unknown"
msgid "    That's what we're talkin' about, right?"
msgstr "　それが三大プロイ。"

#. Occurrence NZ5:591:20303: voice_id=BA0_NZ5_0008; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:591
msgctxt "text_id=20303 | speaker=unknown"
msgid "    Three masterpieces forged by the First Witch."
msgstr "　初めの魔女が造ったとされる、偉大な三品。"

#. Occurrence NZ5:622:20304: voice_id=BA0_NZ5_0009; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:622
msgctxt "text_id=20304 | speaker=unknown"
msgid "          The Thames Troll: the Bridge Giant."
msgstr "　　橋の巨人テムズトロル、"

#. Occurrence NZ5:622:20305: voice_id=BA0_NZ5_0009; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:622
msgctxt "text_id=20305 | speaker=unknown"
msgid "          Flat Snark: Oil of the Moon."
msgstr "　　月の油フラットスナーク、"

#. Occurrence NZ5:622:20306: voice_id=BA0_NZ5_0009; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:622
msgctxt "text_id=20306 | speaker=unknown"
msgid "          And... er, what's the third one...?"
msgstr "　　三つ目は……あれ、何だったっス？"

#. Occurrence NZ5:653:20307: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0006; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:653
msgctxt "text_id=20307 | speaker=alice"
msgid "    That's still a secret."
msgstr "　最後の一体はまだ秘密よ。"

#. Occurrence NZ5:653:20308: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0006; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:653
msgctxt "text_id=20308 | speaker=alice"
msgid "    This time I'll talk about Thames."
msgstr "　今回はテムズの話をしましょう。"

#. Occurrence NZ5:696:20309: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0007; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:696
msgctxt "text_id=20309 | speaker=alice"
msgid "    It's based on the Mother Goose nursery rhyme \"London Bridge.\""
msgstr "　　　もとになったマザーグースはロンドン橋。"

#. Occurrence NZ5:696:20310: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0007; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:696
msgctxt "text_id=20310 | speaker=alice"
msgid "    \"London Bridge is broken down, broken down, broken down,"
msgstr "　　　『ロンドン橋　落ちた　落ちた　落ちた"

#. Occurrence NZ5:696:20311: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0007; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:696
msgctxt "text_id=20311 | speaker=alice"
msgid "    London Bridge is broken down, my fair lady.\""
msgstr "　　　ロンドン橋　落ちた　<わたしのきれいなご婦人よ|マ　イ　フ　ェ　ア　レ　デ　ィ >』"

#. Occurrence NZ5:722:20312: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0008; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:722
msgctxt "text_id=20312 | speaker=alice"
msgid "  Kids often sing this one in school,"
msgstr "　日本語訳されて音楽の教材にもなっているから、"

#. Occurrence NZ5:722:20313: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0008; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:722
msgctxt "text_id=20313 | speaker=alice"
msgid "  so it's pretty well known."
msgstr "　知っている人も多いでしょうね。"

#. Occurrence NZ5:753:20314: voice_id=BA0_NZ5_0010; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:753
msgctxt "text_id=20314 | speaker=unknown"
msgid "  Also known as the \"Great, But Now What? Troll!\""
msgstr "　別名、デオチトロルッスー！"

#. Occurrence NZ5:753:20315: voice_id=BA0_NZ5_0010; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:753
msgctxt "text_id=20315 | speaker=unknown"
msgid "  Only useful against the most trivial of trivial enemies!"
msgstr "　こいつ、ザコ相手にしか活躍してないッスよね！"

#. Occurrence NZ5:784:20316: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0009; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:784
msgctxt "text_id=20316 | speaker=alice"
msgid "      No, it just needs to be used against the right"
msgstr "　　　……相手が悪かったのよ。"

#. Occurrence NZ5:784:20317: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0009; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:784
msgctxt "text_id=20317 | speaker=alice"
msgid "      enemy. And honestly, I'm not so compatible"
msgstr "　　　それに、わたしとの相性も悪いし。"

#. Occurrence NZ5:784:20318: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0009; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:784
msgctxt "text_id=20318 | speaker=alice"
msgid "      with it. I have a hard time using Thames."
msgstr "　　　実はわたし、テムズをうまく使えないの。"

#. Occurrence NZ5:810:20319: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0010; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:810
msgctxt "text_id=20319 | speaker=alice"
msgid "    I can only manifest him up to his second form."
msgstr "　　わたしが顕現させられるのは二段階目まで。"

#. Occurrence NZ5:810:20320: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0010; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:810
msgctxt "text_id=20320 | speaker=alice"
msgid "    I don't know the lyrics to his third and fourth."
msgstr "　　三番目と四番目の歌詞は未知の領域よ。"

#. Occurrence NZ5:842:20321: voice_id=BA0_NZ5_0011; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:842
msgctxt "text_id=20321 | speaker=unknown"
msgid "      What're you talking about?"
msgstr "　三番目と四番目って、なんスか？"

#. Occurrence NZ5:874:20322: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0011; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:874
msgctxt "text_id=20322 | speaker=alice"
msgid "      The lyrics to London Bridge."
msgstr "　　　ロンドン橋の歌詞よ。"

#. Occurrence NZ5:900:20323: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0012; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:900
msgctxt "text_id=20323 | speaker=alice"
msgid "  \"Wood and clay will wash away,"
msgstr "『～木と土は流される"

#. Occurrence NZ5:900:20324: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0012; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:900
msgctxt "text_id=20324 | speaker=alice"
msgid "   bricks and mortar will not stay.\""
msgstr "　～煉瓦とモルタルは崩れてしまう』"

#. Occurrence NZ5:926:20325: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0013; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:926
msgctxt "text_id=20325 | speaker=alice"
msgid "  \"Iron and steel will bend and bow,"
msgstr "　　『～鉄と鋼は折れ曲がる"

#. Occurrence NZ5:926:20326: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0013; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:926
msgctxt "text_id=20326 | speaker=alice"
msgid "   silver and gold will be stolen away.\""
msgstr "　　　～銀と金は盗まれる』"

#. Occurrence NZ5:957:20327: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0014; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:957
msgctxt "text_id=20327 | speaker=alice"
msgid "        Thames is a Ploy based on London Bridge,"
msgstr "　　　　テムズはロンドン橋のプロイだけど、"

#. Occurrence NZ5:957:20328: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0014; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:957
msgctxt "text_id=20328 | speaker=alice"
msgid "        but he's changed throughout the ages."
msgstr "　　　　時代に添ってその在り方を変えてきた。"

#. Occurrence NZ5:957:20329: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0014; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:957
msgctxt "text_id=20329 | speaker=alice"
msgid "        He has four different forms based on the nursery rhyme."
msgstr "　　　　だから、今はマザーグース通り四種類の姿があるの。"

#. Occurrence NZ5:1005:20330: voice_id=BA0_NZ5_0012; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1005
msgctxt "text_id=20330 | speaker=unknown"
msgid "        Wood, stone, and then two others."
msgstr "　ウッド、ストーンの他にまだ先があるんスね。"

#. Occurrence NZ5:1005:20331: voice_id=BA0_NZ5_0012; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1005
msgctxt "text_id=20331 | speaker=unknown"
msgid "        Are you sure you want to be givin'"
msgstr "　でもいいんスか、"

#. Occurrence NZ5:1005:20332: voice_id=BA0_NZ5_0012; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1005
msgctxt "text_id=20332 | speaker=unknown"
msgid "        away secret information like that?"
msgstr "　こんなカンタンに奥の手をさらしちゃって？"

#. Occurrence NZ5:1036:20333: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0015; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1036
msgctxt "text_id=20333 | speaker=alice"
msgid "        It's fine. These days anyone can look up the lyrics"
msgstr "　　ええ。ロンドン橋の歌詞なんて、"

#. Occurrence NZ5:1036:20334: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0015; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1036
msgctxt "text_id=20334 | speaker=alice"
msgid "        to London Bridge and find them out for themselves."
msgstr "　　いまどき調べれば誰だって分かるのだし。"

#. Occurrence NZ5:1062:20335: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0016; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1062
msgctxt "text_id=20335 | speaker=alice"
msgid "     And besides,"
msgstr "　 そもそもわたし、"

#. Occurrence NZ5:1062:20336: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0016; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1062
msgctxt "text_id=20336 | speaker=alice"
msgid "     the best I can do is use his stone form."
msgstr "　 どうあってもストーンまでしか使えないわ。"

#. Occurrence NZ5:1062:20337: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0016; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1062
msgctxt "text_id=20337 | speaker=alice"
msgid "     So it isn't really a problem if people find out."
msgstr "　 ネタをバラしても支障はないでしょう？"

#. Occurrence NZ5:1094:20338: voice_id=BA0_NZ5_0013; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1094
msgctxt "text_id=20338 | speaker=unknown"
msgid "    Why can't you use the others?"
msgstr "　　どうして使えないんスか？"

#. Occurrence NZ5:1125:20339: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0017; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1125
msgctxt "text_id=20339 | speaker=alice"
msgid "      I'm just not interested in human civilization."
msgstr "　わたし、人間の文明社会に興味がないもの。"

#. Occurrence NZ5:1125:20340: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0017; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1125
msgctxt "text_id=20340 | speaker=alice"
msgid "      In my mind, the bridge only goes up to wood and stone."
msgstr "　わたしの心象世界にある橋は『木と石まで』、というコトね。"

#. Occurrence NZ5:1156:20341: voice_id=BA0_NZ5_0014; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1156
msgctxt "text_id=20341 | speaker=unknown"
msgid "      What? You mean to tell me the invincible"
msgstr "　なんと。"

#. Occurrence NZ5:1156:20342: voice_id=BA0_NZ5_0014; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1156
msgctxt "text_id=20342 | speaker=unknown"
msgid "      Alice actually 'as a weakness?"
msgstr "　無敵のアリスさんにも弱点があったんスね……"

#. Occurrence NZ5:1188:20343: voice_id=BA0_NZ5_0015; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1188
msgctxt "text_id=20343 | speaker=unknown"
msgid "Erm. Actually, now that I think about it,"
msgstr " あ。いや、振り返ってみればそんなに"

#. Occurrence NZ5:1188:20344: voice_id=BA0_NZ5_0015; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1188
msgctxt "text_id=20344 | speaker=unknown"
msgid "you've lost a great hopping pot of times! So much for the invincible!"
msgstr " 無敵じゃなかったッスね！　アリスさん、負け星のが多いッス、"

#. Occurrence NZ5:1188:20345: voice_id=BA0_NZ5_0015; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1188
msgctxt "text_id=20345 | speaker=unknown"
msgid "Not that I'm one to talk!"
msgstr " ジブンとおそろッスー！"

#. Occurrence NZ5:1225:20346: voice_id=BA0_NZ5_0016; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1225
msgctxt "text_id=20346 | speaker=unknown"
msgid "      Rumor has it the Thames Troll"
msgstr "でも、風の噂によるとテムズトロルは"

#. Occurrence NZ5:1225:20347: voice_id=BA0_NZ5_0016; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1225
msgctxt "text_id=20347 | speaker=unknown"
msgid "      is the strongest golem in the world."
msgstr "世界屈指のゴーレムと聞いたッスよ。"

#. Occurrence NZ5:1225:20348: voice_id=BA0_NZ5_0016; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1225
msgctxt "text_id=20348 | speaker=unknown"
msgid "      'Ow strong would it be at its max power?"
msgstr "最高級のテムズトロルはどれくらい強いんスか？"

#. Occurrence NZ5:1256:20349: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0018; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1256
msgctxt "text_id=20349 | speaker=alice"
msgid "      Well, if there was a witch alive today"
msgstr "　そうね。テムズを最後まで建築できる魔女が、"

#. Occurrence NZ5:1256:20350: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0018; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1256
msgctxt "text_id=20350 | speaker=alice"
msgid "      who could take Thames to his final form..."
msgstr "　もし現代にいるのなら―――"

#. Occurrence NZ5:1282:20351: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0019; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1282
msgctxt "text_id=20351 | speaker=alice"
msgid "    Then even Aoko wouldn't be able to defeat it"
msgstr " そのテムズは奥の手を出しきった青子でも"

#. Occurrence NZ5:1282:20352: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0019; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1282
msgctxt "text_id=20352 | speaker=alice"
msgid "    using her most powerful abilities."
msgstr " 倒しきれない、踏破不可能の橋になるでしょうね。"

#. Occurrence NZ5:1313:20353: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0020; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1313
msgctxt "text_id=20353 | speaker=alice"
msgid "You know London, the smoggy heart of the Industrial Revolution."
msgstr "　　産業革命時の<煤煙|スモッグ>都市、ロンドン。"

#. Occurrence NZ5:1313:20354: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0020; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1313
msgctxt "text_id=20354 | speaker=alice"
msgid "Thames would overshadow even that."
msgstr "　　その異名を上回る、都市の巨人として顕現するのだから。"

#. Occurrence NZ5:1344:20355: voice_id=BA0_NZ5_0017; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1344
msgctxt "text_id=20355 | speaker=unknown"
msgid "      Hahaha, wowser!"
msgstr "　ハハハ、また大きく出たッスね！"

#. Occurrence NZ5:1344:20356: voice_id=BA0_NZ5_0017; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1344
msgctxt "text_id=20356 | speaker=unknown"
msgid "      A whole city?! Blimey!"
msgstr "　都市！　都市っスか！"

#. Occurrence NZ5:1344:20357: voice_id=BA0_NZ5_0017; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1344
msgctxt "text_id=20357 | speaker=unknown"
msgid "      Is that true, or are you just sayin' that?"
msgstr "　口だけならなんとでも言えるってヤツッス？"

#. Occurrence NZ5:1370:20358: voice_id=BA0_NZ5_0018; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1370
msgctxt "text_id=20358 | speaker=unknown"
msgid "    You really need to cut the showin' off, Alice."
msgstr "アリスさん、その見栄っ張りで負けず嫌いなところ、"

#. Occurrence NZ5:1370:20359: voice_id=BA0_NZ5_0018; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1370
msgctxt "text_id=20359 | speaker=unknown"
msgid "    Take this is as 'eartfelt advice from your"
msgstr "直した方がいいッスよ。"

#. Occurrence NZ5:1370:20360: voice_id=BA0_NZ5_0018; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1370
msgctxt "text_id=20360 | speaker=unknown"
msgid "    most beloved Ploy!"
msgstr "親愛なるプロイからの、涙の忠告ッス！"

#. Occurrence NZ5:1401:20361: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0021; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1401
msgctxt "text_id=20361 | speaker=alice"
msgid "      Most appreciated."
msgstr "　　ありがとう。"

#. Occurrence NZ5:1401:20362: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0021; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1401
msgctxt "text_id=20362 | speaker=alice"
msgid "      Well, if I'm going to improve,"
msgstr "　　それじゃあさっそく、"

#. Occurrence NZ5:1401:20363: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0021; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1401
msgctxt "text_id=20363 | speaker=alice"
msgid "      I should start by backing up my statements."
msgstr "　　性格改善に付き合ってもらおうかしら。"

#. Occurrence NZ5:1432:20364: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0022_0; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1432
msgctxt "text_id=20364 | speaker=alice"
msgid "    You can help me."
msgstr "　　まずは、“口だけなら”というところから。"

#. Occurrence NZ5:1443:20365: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0022_1; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1443
msgctxt "text_id=20365 | speaker=alice"
msgid "    Thames, get out here."
msgstr "　　出番よテムズ。"

#. Occurrence NZ5:1443:20366: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0022_1; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1443
msgctxt "text_id=20366 | speaker=alice"
msgid "    Show this bird what you can do."
msgstr "　　アナタの力を見せてあげなさい。"

#. Occurrence NZ5:1513:20367: voice_id=BA0_NZ5_0019; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1513
msgctxt "text_id=20367 | speaker=unknown"
msgid "    Oh sure, as if this thing could do anything to-"
msgstr "　デオチ出たーーーーーー！"

#. Occurrence NZ5:1513:20368: voice_id=BA0_NZ5_0019; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1513
msgctxt "text_id=20368 | speaker=unknown"
msgid "    Wait a tick... You look stronger than usual."
msgstr "　というか、すでにデオチの体の上だったッス？"

#. Occurrence NZ5:1513:20369: voice_id=BA0_NZ5_0019; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1513
msgctxt "text_id=20369 | speaker=unknown"
msgid "    And I've got nowhere to escape."
msgstr "　初めからジブンに逃げ場はなかったッス？"

#. Occurrence NZ5:1539:20370: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0023; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1539
msgctxt "text_id=20370 | speaker=alice"
msgid "    Remember what I said?"
msgstr "　そうよ。だから言ったでしょう。"

#. Occurrence NZ5:1539:20371: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ5_0023; voice_prefix=A40; voice_category=2; scene=NZ5
#: NZ5:1539
msgctxt "text_id=20371 | speaker=alice"
msgid "    The mountain knows no mercy."
msgstr "　山を舐めるな、と。"

#. Occurrence NZ5:1571:20372: voice_id=BA0_NZ5_0020; voice_prefix=BA0; voice_category=0; scene=NZ5
#: NZ5:1571
msgctxt "text_id=20372 | speaker=unknown"
msgid "      Didn't fink you meant THIS!"
msgstr "　いや、そういう意味じゃなかった気がするッス。"

#. Occurrence NZ6:162:20373: voice_id=BA0_NZ6_0000; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:162
msgctxt "text_id=20373 | speaker=unknown"
msgid "  This movie doesn't have subtitles."
msgstr "　　この映画、字幕が出てないッスね。"

#. Occurrence NZ6:162:20374: voice_id=BA0_NZ6_0000; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:162
msgctxt "text_id=20374 | speaker=unknown"
msgid "  But I actually have lines!"
msgstr "　　ジブン、ちゃんとセリフあるんスけどー。"

#. Occurrence NZ6:196:20375: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0000; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:196
msgctxt "text_id=20375 | speaker=alice"
msgid "          I know."
msgstr "　　　　知ってるわ。"

#. Occurrence NZ6:196:20376: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0000; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:196
msgctxt "text_id=20376 | speaker=alice"
msgid "          I found them annoying, so I spoke with the editor,"
msgstr "　　　　でも耳障りだったから、わたし権限で編集さんに"

#. Occurrence NZ6:196:20377: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0000; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:196
msgctxt "text_id=20377 | speaker=alice"
msgid "          and had them cut."
msgstr "　　　　貴方の台詞だけカットしてもらったの。"

#. Occurrence NZ6:222:20378: voice_id=BA0_NZ6_0001; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:222
msgctxt "text_id=20378 | speaker=unknown"
msgid "        Great! As always, we're gonna telecom tower you^        with praise, Miss Alice!"
msgstr " グレイト。もう何もかもアリスさん中心なんスね。"

#. Occurrence NZ6:222:20379: voice_id=BA0_NZ6_0001; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:222
msgctxt "text_id=20379 | speaker=unknown"
msgid "        So I'm the only one actin' in a silent flick."
msgstr " ジブンだけサイレント映画の気分ッス。"

#. Occurrence NZ6:286:20380: voice_id=BA0_NZ6_0002; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:286
msgctxt "text_id=20380 | speaker=unknown"
msgid "    This is the second one, right?"
msgstr "　　　　二体目ッスね。"

#. Occurrence NZ6:312:20381: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0001; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:312
msgctxt "text_id=20381 | speaker=alice"
msgid "    Yep."
msgstr "　二体目ね。"

#. Occurrence NZ6:312:20382: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0001; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:312
msgctxt "text_id=20382 | speaker=alice"
msgid "    Just so everyone knows, Snark's body is liquid."
msgstr "　誤解されそうだから言っておくと、スナークの本体は液体よ。"

#. Occurrence NZ6:338:20383: voice_id=BA0_NZ6_0003; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:338
msgctxt "text_id=20383 | speaker=unknown"
msgid "    That's why some call 'im the \"Oil of the Moon.\""
msgstr "　スナークの二つ名、月の油ッスね。"

#. Occurrence NZ6:338:20384: voice_id=BA0_NZ6_0003; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:338
msgctxt "text_id=20384 | speaker=unknown"
msgid "    Who gave him the name \"Flat Snark\" anyway?"
msgstr "　フラットスナークの名前は誰が付けたんスか？"

#. Occurrence NZ6:403:20385: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0002; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:403
msgctxt "text_id=20385 | speaker=alice"
msgid "    Someone you know well."
msgstr "　アナタもよく知っている彼女だけど。"

#. Occurrence NZ6:403:20386: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0002; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:403
msgctxt "text_id=20386 | speaker=alice"
msgid "    Before I met her,"
msgstr "　わたし、彼女と仲良くなるまで、プロイに名前を"

#. Occurrence NZ6:403:20387: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0002; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:403
msgctxt "text_id=20387 | speaker=alice"
msgid "    I never gave my Ploys names."
msgstr "　つけていなかったから。"

#. Occurrence NZ6:429:20388: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0003; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:429
msgctxt "text_id=20388 | speaker=alice"
msgid "      I just called them number one, number two, and so on,"
msgstr "　　強い順とか、思い入れがある順に、"

#. Occurrence NZ6:429:20389: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0003; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:429
msgctxt "text_id=20389 | speaker=alice"
msgid "      based on strength, importance, or whatever I felt like."
msgstr "　　一番、二番、と呼んでいただけだったの。"

#. Occurrence NZ6:498:20390: voice_id=BA0_NZ6_0004; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:498
msgctxt "text_id=20390 | speaker=unknown"
msgid "  You actually ordered 'em?"
msgstr "　順番？　番号じゃなくて？"

#. Occurrence NZ6:498:20391: voice_id=BA0_NZ6_0004; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:498
msgctxt "text_id=20391 | speaker=unknown"
msgid "  Kinda lazy not giving 'em a name."
msgstr "　名前をつけないぐうたら……"

#. Occurrence NZ6:498:20392: voice_id=BA0_NZ6_0004; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:498
msgctxt "text_id=20392 | speaker=unknown"
msgid "  Then again, makes sense to keep it simple. But why so orderly?"
msgstr "　いや、シンプルさはアリスさんらしいッスけど、なんで順番？"

#. Occurrence NZ6:524:20393: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0004; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:524
msgctxt "text_id=20393 | speaker=alice"
msgid "    If I gave them random numbers, that'd be confusing."
msgstr "　だって、番号を付けても混乱するだけでしょう？"

#. Occurrence NZ6:524:20394: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0004; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:524
msgctxt "text_id=20394 | speaker=alice"
msgid "    Which one's strongest and which one I like most depends^    on my mood."
msgstr "　どれが強いか、どれが好きかなんて、日によって変わるのだし。"

#. Occurrence NZ6:550:20395: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0005; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:550
msgctxt "text_id=20395 | speaker=alice"
msgid "    I'd change the order based on how I felt."
msgstr "だから気持ち次第で、その日ごとに順番は違ったわ。"

#. Occurrence NZ6:550:20396: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0005; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:550
msgctxt "text_id=20396 | speaker=alice"
msgid "    Diddle Diddle was always number one, though."
msgstr "一番はディドルが鉄板。"

#. Occurrence NZ6:550:20397: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0005; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:550
msgctxt "text_id=20397 | speaker=alice"
msgid "    Thames would usually be three or four."
msgstr "テムズはたいてい三番か四番だったわね。"

#. Occurrence NZ6:614:20398: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0006; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:614
msgctxt "text_id=20398 | speaker=alice"
msgid "    Oh, I just remembered."
msgstr "　　ああ、思いだした。"

#. Occurrence NZ6:614:20399: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0006; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:614
msgctxt "text_id=20399 | speaker=alice"
msgid "    When playing with her and the Ploys,"
msgstr "　　彼女とプロイで遊んでいる時、"

#. Occurrence NZ6:614:20400: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0006; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:614
msgctxt "text_id=20400 | speaker=alice"
msgid "    my numbering system did cause a problem."
msgstr "　　それで困ったコトになって。"

#. Occurrence NZ6:684:20401: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B81_NZ6_0000; voice_prefix=B81; voice_category=13; scene=NZ6
#: NZ6:684
msgctxt "text_id=20401 | speaker=liddell"
msgid "\"Alice, my new daddy's coming tomorrow."
msgstr "「アリス、明日、新しいパパがやってくるの。"

#. Occurrence NZ6:684:20402: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B81_NZ6_0000; voice_prefix=B81; voice_category=13; scene=NZ6
#: NZ6:684
msgctxt "text_id=20402 | speaker=liddell"
msgid " Can I borrow the sixth Ploy?"
msgstr "　だから六番のプロイを貸してちょうだい。"

#. Occurrence NZ6:684:20403: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B81_NZ6_0000; voice_prefix=B81; voice_category=13; scene=NZ6
#: NZ6:684
msgctxt "text_id=20403 | speaker=liddell"
msgid " I really want to impress him!\""
msgstr "　ワタシ、おめかしして出迎えたいの！」"

#. Occurrence NZ6:753:20404: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0007; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:753
msgctxt "text_id=20404 | speaker=alice"
msgid "        So, I let her borrow what I'd decided"
msgstr "　そう言った彼女に、わたし、その日は気分的に"

#. Occurrence NZ6:753:20405: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0007; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:753
msgctxt "text_id=20405 | speaker=alice"
msgid "        was my sixth favorite Ploy that day."
msgstr " 「これは六番目」と決めていたプロイを貸したわ。"

#. Occurrence NZ6:824:20406: voice_id=BA0_NZ6_0005; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:824
msgctxt "text_id=20406 | speaker=unknown"
msgid "      ..."
msgstr "　 ……。"

#. Occurrence NZ6:824:20407: voice_id=BA0_NZ6_0005; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:824
msgctxt "text_id=20407 | speaker=unknown"
msgid "      I fink I know where this is going, but I'll bite."
msgstr "　もうだいたい分かったッスけど、いちおう訊いておくッス。"

#. Occurrence NZ6:824:20408: voice_id=BA0_NZ6_0005; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:824
msgctxt "text_id=20408 | speaker=unknown"
msgid "      What Ploy was it?"
msgstr "　それはなんのプロイだったっスか？"

#. Occurrence NZ6:855:20409: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0008; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:855
msgctxt "text_id=20409 | speaker=alice"
msgid "It was a perfume she later called \"Goblin Fron.\""
msgstr "後に、彼女がゴブリンフロンと名付けるようになった香水よ。"

#. Occurrence NZ6:855:20410: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0008; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:855
msgctxt "text_id=20410 | speaker=alice"
msgid "Once you put it on, you can only speak in curse words and slang for an entire day."
msgstr "その香水をかけると、一日、悪口とスラングしか言えなくなるの。"

#. Occurrence NZ6:887:20411: voice_id=BA0_NZ6_0006; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:887
msgctxt "text_id=20411 | speaker=unknown"
msgid "                    ..."
msgstr "　　　　……………………。"

#. Occurrence NZ6:918:20412: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0009; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:918
msgctxt "text_id=20412 | speaker=alice"
msgid "      That's when she came up with the idea of naming Ploys."
msgstr "　　その後、彼女はプロイに名前を付けるよう提案してきたわ。"

#. Occurrence NZ6:918:20413: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0009; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:918
msgctxt "text_id=20413 | speaker=alice"
msgid "      For some reason she looked like she had been crying."
msgstr "　　なぜか涙で赤くなった目で。"

#. Occurrence NZ6:949:20414: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0010; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:949
msgctxt "text_id=20414 | speaker=alice"
msgid "        \"This one's Sweets Hearts. This is Scripps Humpty.^        This is Diddle Diddle. This is Flat Snark.^        Those are their names from now on, okay?\""
msgstr "『これはスイーツハーツ。これはスクリプス・ハンプティ。これはディドルディドル。これはフラットスナーク。いい。これからはこの名前で統一するのよ』"

#. Occurrence NZ6:980:20415: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0011; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:980
msgctxt "text_id=20415 | speaker=alice"
msgid "    They say that a name defines you, right?"
msgstr "……名は体を表すと言うでしょう？"

#. Occurrence NZ6:980:20416: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0011; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:980
msgctxt "text_id=20416 | speaker=alice"
msgid "    I didn't want to give them the wrong one. So I just categorized^    them based on how I felt."
msgstr "わたし、そんな変換間違えのような名前より、その日の気分で分けた方が楽でいいと思ったのだけど、"

#. Occurrence NZ6:1011:20417: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0012; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1011
msgctxt "text_id=20417 | speaker=alice"
msgid "\"Nobody can tell how you're feeling. You should realize that what you do affects me, too.\""
msgstr "『アンタの気分なんて他人には分かんないし。その度にアタシの運命が狂っていくコトを、もうちょっと気にしてちょうだい』"

#. Occurrence NZ6:1042:20418: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0013; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1042
msgctxt "text_id=20418 | speaker=alice"
msgid "\"Plus, naming Ploys is going to be the next big thing. For certain. People will tire of it eventually, but still.\""
msgstr "『それに近い将来、こういう名前がトレンドになる時代がくるから。絶対。すぐに飽きられるだろうけど』"

#. Occurrence NZ6:1073:20419: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0014; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1073
msgctxt "text_id=20419 | speaker=alice"
msgid "  \"And if we're going to name them, we have to name them^  something trendy. Trendiness is key!\""
msgstr "『なんで、どうせつけるならイカした方がグッドでバッド。せっかくアタシたちだけのオリジナリティなのよ、ポップに流行らせなくちゃ大損だわ！』"

#. Occurrence NZ6:1104:20420: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0015; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1104
msgctxt "text_id=20420 | speaker=alice"
msgid "  I've given my Ploys names ever since. It's kind of a hassle^  remembering them all, but I never mix them up now."
msgstr "それ以来、わたしはプロイを名前で呼ぶようになった。いちいち名前を覚える手間はあったけれど、プロイを間違えるコトはなくなったわ。"

#. Occurrence NZ6:1135:20421: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0016; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1135
msgctxt "text_id=20421 | speaker=alice"
msgid "  Seemed like an obvious thing to do after the fact."
msgstr "　　まさにコロンブスのタマゴね。"

#. Occurrence NZ6:1135:20422: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0016; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1135
msgctxt "text_id=20422 | speaker=alice"
msgid "  But it was such an original idea at the time."
msgstr "　　なんていう発想の柔軟さ、斬新さかしら。"

#. Occurrence NZ6:1135:20423: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0016; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1135
msgctxt "text_id=20423 | speaker=alice"
msgid "  Genius, really."
msgstr "　　時々思うのだけど、あの娘は天才ね。"

#. Occurrence NZ6:1166:20424: voice_id=BA0_NZ6_0007; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1166
msgctxt "text_id=20424 | speaker=unknown"
msgid "            Yeah. Genius..."
msgstr "　そッスね。ジブンも思うんスけど、"

#. Occurrence NZ6:1166:20425: voice_id=BA0_NZ6_0007; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1166
msgctxt "text_id=20425 | speaker=unknown"
msgid "            Unlike you..."
msgstr "　アリスさんって時々すごくヴァカァですよね。"

#. Occurrence NZ6:1329:20426: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0017; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1329
msgctxt "text_id=20426 | speaker=alice"
msgid "                ...Ouch."
msgstr "　　……やられてしまったわね。"

#. Occurrence NZ6:1362:20427: voice_id=BA0_NZ6_0008; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1362
msgctxt "text_id=20427 | speaker=unknown"
msgid " Look at that oil burn."
msgstr "油なだけによく燃えるッスねー。"

#. Occurrence NZ6:1362:20428: voice_id=BA0_NZ6_0008; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1362
msgctxt "text_id=20428 | speaker=unknown"
msgid " What kind of Ploy is Snark exactly?"
msgstr "スナークはどんなプロイなんスか？"

#. Occurrence NZ6:1388:20429: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0018; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1388
msgctxt "text_id=20429 | speaker=alice"
msgid "    We went over this in the main story."
msgstr "　　本編でだいたいのあらましは語っているわ。"

#. Occurrence NZ6:1388:20430: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0018; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1388
msgctxt "text_id=20430 | speaker=alice"
msgid "    If you're looking for more detailed information, well..."
msgstr "　　細かなデータは、"

#. Occurrence NZ6:1456:20431: voice_id=BA0_NZ6_0009; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1456
msgctxt "text_id=20431 | speaker=unknown"
msgid "    Right on."
msgstr "うむ。"

#. Occurrence NZ6:1456:20432: voice_id=BA0_NZ6_0009; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1456
msgctxt "text_id=20432 | speaker=unknown"
msgid "    So, Aoko burned all your precious oil."
msgstr "その貴重な油を、青子さんは燃やしてしまった、と。"

#. Occurrence NZ6:1456:20433: voice_id=BA0_NZ6_0009; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1456
msgctxt "text_id=20433 | speaker=unknown"
msgid "    How's one get more of that Bodie and Doyle?"
msgstr "これ、なんとか戻せないんスか？"

#. Occurrence NZ6:1482:20434: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0019; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1482
msgctxt "text_id=20434 | speaker=alice"
msgid "        Unfortunately, no."
msgstr "残念ながら不可能よ。"

#. Occurrence NZ6:1482:20435: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0019; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1482
msgctxt "text_id=20435 | speaker=alice"
msgid "        Snarks can't be recreated in this era."
msgstr "この時代ではスナークを精製するコトはできない。"

#. Occurrence NZ6:1515:20436: voice_id=BA0_NZ6_0010; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1515
msgctxt "text_id=20436 | speaker=unknown"
msgid "Some people just love destroyin' cultural relics, don't they?"
msgstr "こうして貴重な文化遺産は、フィーリングだけで生きている野蛮人に壊されていくんスねー。"

#. Occurrence NZ6:1515:20437: voice_id=BA0_NZ6_0010; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1515
msgctxt "text_id=20437 | speaker=unknown"
msgid "Whew, gotta love layin' waste to civilization!"
msgstr "うはっ、文明を蹂躙するのっておもしれぇー！"

#. Occurrence NZ6:1586:20438: voice_id=BA0_NZ6_0011; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1586
msgctxt "text_id=20438 | speaker=unknown"
msgid "    Is this all Snark's got, though? I thought that troll was bad enough."
msgstr "しっかし、デオチに続いてスナークもこのザマとか！"

#. Occurrence NZ6:1586:20439: voice_id=BA0_NZ6_0011; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1586
msgctxt "text_id=20439 | speaker=unknown"
msgid "    Bwahahaha! Some Great Ploy!"
msgstr "ギャハハ、何がグレートスリーッスか！"

#. Occurrence NZ6:1586:20440: voice_id=BA0_NZ6_0011; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1586
msgctxt "text_id=20440 | speaker=unknown"
msgid "    I loves me a good tall tale."
msgstr "甘え。グレートスリーは甘え。"

#. Occurrence NZ6:1657:20441: voice_id=BA0_NZ6_0012; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1657
msgctxt "text_id=20441 | speaker=unknown"
msgid "Y'know, I'm a pretty damn good Ploy. I never waste anythin'! Hey, you there! Fry me up a bag of chips with this oil!"
msgstr "しかしジブン、やるプロイッスから。産廃を有効利用するッスよ。おーい、外の店員さーん。この残った油で、とりあえずフライドポテトでも揚げてくれ？"

#. Occurrence NZ6:1688:20442: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0020; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1688
msgctxt "text_id=20442 | speaker=alice"
msgid "Not a bad idea, Robin. For you, at least."
msgstr "あら、アナタにしては名案ねロビン。"

#. Occurrence NZ6:1688:20443: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0020; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1688
msgctxt "text_id=20443 | speaker=alice"
msgid "You know, I could go for some fried chicken."
msgstr "それじゃあ、わたしはフライドチキンにしてもらお^うかしら。"

#. Occurrence NZ6:1720:20444: voice_id=BA0_NZ6_0013; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1720
msgctxt "text_id=20444 | speaker=unknown"
msgid "    ..."
msgstr "………………。"

#. Occurrence NZ6:1720:20445: voice_id=BA0_NZ6_0013; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1720
msgctxt "text_id=20445 | speaker=unknown"
msgid "    The menu says hot dogs, popcorn, crisps...^    but definitely NO BIRD-BASED FOOD."
msgstr "外のメニュー、ホットドッグとポップコーンとポテ^トしかなかったッスよ。"

#. Occurrence NZ6:1751:20446: voice_id=BA0_NZ6_0014; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1751
msgctxt "text_id=20446 | speaker=unknown"
msgid "Whenever I go watch a flick, I always check their menu first. Fried chicken's a no-go, what with its pen and ink."
msgstr "ジブン、映画館はまず飲食店のメニューからチェックする派ッスから。だいたい映画館でフライドチキンとか、匂いが無頼ッス。他のお客さんに迷惑ッス。"

#. Occurrence NZ6:1782:20447: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0021; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1782
msgctxt "text_id=20447 | speaker=alice"
msgid "      I know. Don't worry."
msgstr "　　　知っているわ。でも安心して。"

#. Occurrence NZ6:1782:20448: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0021; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1782
msgctxt "text_id=20448 | speaker=alice"
msgid "      I'm not actually hungry."
msgstr "　　　わたし、お腹はすいていないから。"

#. Occurrence NZ6:1782:20449: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0021; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1782
msgctxt "text_id=20449 | speaker=alice"
msgid "      I just want them to fry a certain bird for me."
msgstr "　　　ただ油で揚げてもらうだけでいいの。"

#. Occurrence NZ6:1815:20450: voice_id=BA0_NZ6_0015; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:1815
msgctxt "text_id=20450 | speaker=unknown"
msgid "      Hahaha... Y-You wouldn't..."
msgstr "　ハハハ。食事として、頼むワケでは、ないと。"

#. Occurrence NZ6:1907:20451: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0022; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1907
msgctxt "text_id=20451 | speaker=alice"
msgid "  Wouldn't I? Don't you want to experience the sensation of your^  entire body being boiled in hot oil?"
msgstr "高温で全身まんべんなく、毛先から毛穴までゆであがるのは初めてなんじゃないかしら。"

#. Occurrence NZ6:1907:20452: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0022; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:1907
msgctxt "text_id=20452 | speaker=alice"
msgid "  Another cause of death to add to your collection."
msgstr "また一つ死因コレクションが増えたわね、ロビン。"

#. Occurrence NZ6:2019:20453: voice_id=BA0_NZ6_0016; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:2019
msgctxt "text_id=20453 | speaker=unknown"
msgid " I need a better hobby."
msgstr "この世でいちばん増やしたくないレパートリー、"

#. Occurrence NZ6:2019:20454: voice_id=BA0_NZ6_0016; voice_prefix=BA0; voice_category=0; scene=NZ6
#: NZ6:2019
msgctxt "text_id=20454 | speaker=unknown"
msgid " Anyway, a sandshoe for your offer,^ but I'm going to 'ave to decline!"
msgstr "あざーっスーーーー！　でも世界にはまだまだ未知の死因が隠れているッスよー！"

#. Occurrence NZ6:2106:20455: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0023; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:2106
msgctxt "text_id=20455 | speaker=alice"
msgid "  ...Looks like the movie's over."
msgstr "　……映画はここまでのようね。"

#. Occurrence NZ6:2106:20456: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0023; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:2106
msgctxt "text_id=20456 | speaker=alice"
msgid "  Few theaters show films and plays at^  the same time these days."
msgstr "　同時上映のある劇場も、最近は減ってきたわね。"

#. Occurrence NZ6:2137:20457: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0024; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:2137
msgctxt "text_id=20457 | speaker=alice"
msgid "  I wanted to end this by introducing my third Ploy,"
msgstr "　　最後に三体目の紹介をしたかったけど、"

#. Occurrence NZ6:2137:20458: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0024; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:2137
msgctxt "text_id=20458 | speaker=alice"
msgid "  but I'll have to save that for next time."
msgstr "　　それはまたの機会に。"

#. Occurrence NZ6:2197:20459: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0025; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:2197
msgctxt "text_id=20459 | speaker=alice"
msgid "          To all of you who stuck with us through"
msgstr "　　長かった本編を楽しんでくれた皆さん。"

#. Occurrence NZ6:2197:20460: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0025; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:2197
msgctxt "text_id=20460 | speaker=alice"
msgid "          the lengthy main story, and the side story that"
msgstr "　　すぐ終わるようで、なかなか終わらなかった"

#. Occurrence NZ6:2197:20461: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0025; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:2197
msgctxt "text_id=20461 | speaker=alice"
msgid "          could either end quickly or take forever..."
msgstr "　　番外編に付き合ってくれた皆さん。"

#. Occurrence NZ6:2223:20462: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0026; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:2223
msgctxt "text_id=20462 | speaker=alice"
msgid "  This marks the end of Witch on the Holy Night."
msgstr "「魔法使いの夜」は、これで一旦の終了となります。"

#. Occurrence NZ6:2223:20463: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0026; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:2223
msgctxt "text_id=20463 | speaker=alice"
msgid "  Let us continue the tale someday, someplace,"
msgstr "続きはまた、いつかどこかで。"

#. Occurrence NZ6:2223:20464: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0026; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:2223
msgctxt "text_id=20464 | speaker=alice"
msgid "  when a bright, roaming star drops from the sky into your lap."
msgstr "旅する星がするりと落ちて、貴方の胸に輝く時に。"

#. Occurrence NZ6:2249:20465: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0027; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:2249
msgctxt "text_id=20465 | speaker=alice"
msgid "          From the bottom of our hearts,"
msgstr "　 ―――それでは。"

#. Occurrence NZ6:2249:20466: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_NZ6_0027; voice_prefix=A40; voice_category=2; scene=NZ6
#: NZ6:2249
msgctxt "text_id=20466 | speaker=alice"
msgid "          thank you for sharing this long journey with us."
msgstr "　 長らくのご視聴、ありがとうございました。"

#. Occurrence SP1:41:20467: scene=SP1
#: SP1:41
msgctxt "text_id=20467 | speaker=unknown"
msgid "  It had been one year since he'd moved into the city from his remote village."
msgstr "　人里<離|はな>れた辺境から都会に来てはや一年。"

#. Occurrence SP1:46:20468: scene=SP1
#: SP1:46
msgctxt "text_id=20468 | speaker=unknown"
msgid "  One thing he realized during that time was that likes and dislikes were the main difference between human and beast."
msgstr "　ヒトとケモノとで一番の大きな違いは、『好き嫌い』という嗜好性なんじゃないだろうか、とカレは思った。"

#. Occurrence SP1:97:20469: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0000; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:97
msgctxt "text_id=20469 | speaker=beo"
msgid "\"So this is the new hideout, huh?"
msgstr "「ふーん、ここが新しいアジトかー。"

#. Occurrence SP1:103:20470: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0001; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:103
msgctxt "text_id=20470 | speaker=beo"
msgid "  Not bad, I guess. It's a bit shabby, but I like how there are no people around.\""
msgstr "　うん、いいんじゃない？　ちょっとみすぼらしいけど、まわりに人間がいないのはキレイでいいよね」"

#. Occurrence SP1:128:20471: scene=SP1
#: SP1:128
msgctxt "text_id=20471 | speaker=unknown"
msgid "  The figure dressed in a white coat danced to and fro down the hallway."
msgstr "　白いコートの人影が、くるくると廊下で<躍|おど>る。"

#. Occurrence SP1:133:20472: scene=SP1
#: SP1:133
msgctxt "text_id=20472 | speaker=unknown"
msgid "  He was like a young woman in an old film, enjoying herself window shopping."
msgstr "　その様はウインドウショッピングを楽しむ少女のようだ。"

#. Occurrence SP1:138:20473: scene=SP1
#: SP1:138
msgctxt "text_id=20473 | speaker=unknown"
msgid "  He was actually enjoying the atrocious sight of the school building in ruins."
msgstr "　事実、ソレは興味津々とばかりに朽ち果てた校舎の無惨を<愉|たの>しんでいる。"

#. Occurrence SP1:170:20474: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0000; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:170
msgctxt "text_id=20474 | speaker=touko"
msgid "\"Settle down. This place is falling apart. It was built over sixty years ago, you know."
msgstr "「そこ、あんまりはしゃがないの。なにしろ<築|ちく>六十年からの廃屋なんだから。"

#. Occurrence SP1:176:20475: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0001; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:176
msgctxt "text_id=20475 | speaker=touko"
msgid "  The floor could fall out from underneath you at any moment...\""
msgstr "　調子に乗ってると、バキッと床を<踏|ふ>み抜いて―――」"

#. Occurrence SP1:182:20476: scene=SP1
#: SP1:182
msgctxt "text_id=20476 | speaker=unknown"
msgid "  His mouth shut before he could even say to let him have his fun."
msgstr "　楽しいわよ、と言いかけた口が閉じる。"

#. Occurrence SP1:213:20477: scene=SP1
#: SP1:213
msgctxt "text_id=20477 | speaker=unknown"
msgid "  Only one set of footsteps echoed through the hallway."
msgstr "　響いている足音は一人分だけ。"

#. Occurrence SP1:218:20478: scene=SP1
#: SP1:218
msgctxt "text_id=20478 | speaker=unknown"
msgid "  Not a single feather's worth of his seventy-pound body was exerting any force on the floor beneath him."
msgstr "　老朽化した廊下を<労|ねぎら>ってか、それとも身も心も浮かれているのか。"

#. Occurrence SP1:223:20479: scene=SP1
#: SP1:223
msgctxt "text_id=20479 | speaker=unknown"
msgid "  It wasn't clear whether he was paying reverence to the hallway or simply excited by it."
msgstr "　コート姿のソレは先ほどから微塵も、自身の三十キロ程度の重さすら、廊下に加えてはいなかった。"

#. Occurrence SP1:259:20480: scene=SP1
#: SP1:259
msgctxt "text_id=20480 | speaker=unknown"
msgid "  It's said that even walking through a grassy field, a beast is careful not to harm a single blade of grass."
msgstr "　曰く、<仁獣|じんじゅう>は野原を歩いても草花を傷つけないと云う。"

#. Occurrence SP1:264:20481: scene=SP1
#: SP1:264
msgctxt "text_id=20481 | speaker=unknown"
msgid "  Apparently, this creature wrapped in a coat was no different."
msgstr "　あのコート姿の人影もその<類|たぐい>の生き物らしい。"

#. Occurrence SP1:269:20482: scene=SP1
#: SP1:269
msgctxt "text_id=20482 | speaker=unknown"
msgid "  He was more a part of the environment itself than a settler of it."
msgstr "　カレは環境側の生き物だ。"

#. Occurrence SP1:274:20483: scene=SP1
#: SP1:274
msgctxt "text_id=20483 | speaker=unknown"
msgid "  He held no regard for beasts greater or lesser than him, but when it came to his comrades, he at least displayed human-like--or rather, wolf-like clemency."
msgstr "　高等、下等、どちらであろうと肉持つ獣には何の温情も持たないが、同胞には人並み……いや、狼並みの温情を持つらしい。"

#. Occurrence SP1:311:20484: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0002; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:311
msgctxt "text_id=20484 | speaker=touko"
msgid "\"Well, I'm glad you at least like the place."
msgstr "「ま、相性は良い、とプラスに考えましょう。"

#. Occurrence SP1:322:20485: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0003; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:322
msgctxt "text_id=20485 | speaker=touko"
msgid "  I'm going into town. Do you need anything? Comics? Books?\""
msgstr "　町に出かけてくるけど、何かほしいものはある？　マンガとか、小説とか」"

#. Occurrence SP1:335:20486: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0002_0; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:335
msgctxt "text_id=20486 | speaker=beo"
msgid "\"Hmm, nothing especially."
msgstr "「んー、特にいりません。"

#. Occurrence SP1:348:20487: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0002_1; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:348
msgctxt "text_id=20487 | speaker=beo"
msgid " Oh! If you could pick me up a hamburger on your way back, that'd be great! The one with the fluffy bun and thick patty!\""
msgstr "あ、帰りにハンバーガー買ってきてくれたら嬉しいな！　あの、パン生地がどっしりしてて、ハンバーグがぎゅっとしたヤツがいい！」"

#. Occurrence SP1:374:20488: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0004; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:374
msgctxt "text_id=20488 | speaker=touko"
msgid "\"Still thinking with your stomach, huh? We'll need to figure out a reliable source of food if we want to survive here."
msgstr "「まだオモチャより食い気ときた。食事の調達方法も確保しないとダメみたいね。"

#. Occurrence SP1:380:20489: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0005; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:380
msgctxt "text_id=20489 | speaker=touko"
msgid "  ...I wonder if this was a mistake? A hotel with room service might actually leave less evidence behind.\""
msgstr "　……失敗したかな？　ルームサービスのあるホテルの方が、<後々|あとあと>証拠は残らなさそう」"

#. Occurrence SP1:400:20490: scene=SP1
#: SP1:400
msgctxt "text_id=20490 | speaker=unknown"
msgid "  Touko let out a defeated sigh."
msgstr "　やれやれとため息をつくのは、言うまでもなく蒼崎橙子である。"

#. Occurrence SP1:405:20491: scene=SP1
#: SP1:405
msgctxt "text_id=20491 | speaker=unknown"
msgid "  With her glasses on, she was restricted to her original way of speaking and gesturing."
msgstr "　眼鏡をかけているので、口調も仕草も彼女本来のものに固定されている。"

#. Occurrence SP1:439:20492: scene=SP1
#: SP1:439
msgctxt "text_id=20492 | speaker=unknown"
msgid "  It was the beginning of December."
msgstr "　十二月初頭。"

#. Occurrence SP1:444:20493: scene=SP1
#: SP1:444
msgctxt "text_id=20493 | speaker=unknown"
msgid "  Exactly one month had passed since they came to Misaki City."
msgstr "　彼女とカレが三咲市にやってきてから、まる一ヶ月が経過しようとしていた。"

#. Occurrence SP1:449:20494: scene=SP1
#: SP1:449
msgctxt "text_id=20494 | speaker=unknown"
msgid "  Until now, Touko had been attacking Misaki from a nearby neighborhood. Deciding it was time to get serious, she had moved her base of operations to this old school building."
msgstr "　今までは隣町から三咲町を攻略していた橙子だが、そろそろ本番という事で、<本営|ほんえい>をここ旧校舎に移転させたのである。"

#. Occurrence SP1:478:20495: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0003; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:478
msgctxt "text_id=20495 | speaker=beo"
msgid "\"Hm? You think a hotel would've been better?\""
msgstr "「？　なに、ホテルの方が良かったの？」"

#. Occurrence SP1:495:20496: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0006; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:495
msgctxt "text_id=20496 | speaker=touko"
msgid "\"That would be easier, for sure. Hotels are nice to live in, especially if they're decent quality.\""
msgstr "「そりゃあ楽だもの。グレードが良ければホテル暮らしは快適です」"

#. Occurrence SP1:501:20497: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0004; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:501
msgctxt "text_id=20497 | speaker=beo"
msgid "\"But I know you, Touko. You're really into these kinds of ruins, aren't you?\""
msgstr "「ふーん。でもトーコさん、こういう廃墟好きだよね」"

#. Occurrence SP1:507:20498: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0007; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:507
msgctxt "text_id=20498 | speaker=touko"
msgid "\"Eh? Really?\""
msgstr "「え、そうかな？」"

#. Occurrence SP1:513:20499: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0005; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:513
msgctxt "text_id=20499 | speaker=beo"
msgid "\"Yeah! Especially ones like this."
msgstr "「そうだよ。今回みたいなのは特にそう。"

#. Occurrence SP1:519:20500: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0006; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:519
msgctxt "text_id=20500 | speaker=beo"
msgid "  Whenever you get interested in something, you don't want anyone to be around you or like the same things you're into. Even though you have so many interests!\""
msgstr "　趣味に走る時、まわりにヒトがいるのイヤがるじゃない。いろんな物に興味を持つクセに、興味を持たれるのはメンドウってゆーか」"

#. Occurrence SP1:556:20501: scene=SP1
#: SP1:556
msgctxt "text_id=20501 | speaker=unknown"
msgid "  Touko couldn't deny that observation."
msgstr "　指摘されて、そっか、と納得する橙子だった。"

#. Occurrence SP1:561:20502: scene=SP1
#: SP1:561
msgctxt "text_id=20502 | speaker=unknown"
msgid "  She had been under contract with him for two years, but it had only been about a year since he became her full-time bodyguard."
msgstr "　カレと契約したのは二年前だが、本格的に護衛として同伴させてからじき一年。"

#. Occurrence SP1:566:20503: scene=SP1
#: SP1:566
msgctxt "text_id=20503 | speaker=unknown"
msgid "  He seemed to be able to see right through to the root of all the problems that plagued Touko."
msgstr "　蒼崎橙子という人間の根っこにある問題を、カレはきちんと把握しているらしい。"

#. Occurrence SP1:601:20504: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0008; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:601
msgctxt "text_id=20504 | speaker=touko"
msgid "\"I don't particularly hate crowds, though. An abandoned building or factory, or even that old amusement park would've been okay too."
msgstr "「人混みは嫌いじゃないんだけどねー。廃ビルでも廃工場でも、いっそあの遊園地でも良かったのよ？"

#. Occurrence SP1:607:20505: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0009; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:607
msgctxt "text_id=20505 | speaker=touko"
msgid "  It's just that, here in the countryside, simply having you around is enough to get the rumor mill churning. My only option was to set up operations out here in the mountains.\""
msgstr "　でも、こんな田舎町じゃ君を連れているだけで噂になるでしょ。結果的に、<山奥|ここ>に工房を構えるしかなかったの」"

#. Occurrence SP1:634:20506: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0007; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:634
msgctxt "text_id=20506 | speaker=beo"
msgid "\"Aww, but I'm in human form!"
msgstr "「えー。ちゃんとヒト形になってるじゃん、ボク。"

#. Occurrence SP1:634:20507: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0007; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:634
msgctxt "text_id=20507 | speaker=beo"
msgid "  I don't think I stick out that much.\""
msgstr "　別に目立たないと思うけどなー」"

#. Occurrence SP1:645:20508: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0010; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:645
msgctxt "text_id=20508 | speaker=touko"
msgid "\"It's a matter of fitting in. Even if you can't look Asian, we could probably get by if your hair was at least black.\""
msgstr "「色合いの問題です。アジア系は無理にしても、せめて<黒髪|ブルネット>に化けてくれれば、いくらでも誤魔化せるんだけど」"

#. Occurrence SP1:678:20509: scene=SP1
#: SP1:678
msgctxt "text_id=20509 | speaker=unknown"
msgid "  Unfortunately, that wouldn't be happening."
msgstr "　しかし、その要望は叶わない。"

#. Occurrence SP1:683:20510: scene=SP1
#: SP1:683
msgctxt "text_id=20510 | speaker=unknown"
msgid "  Simply being in human form at all was stressful for him."
msgstr "　ヒト形になる事自体、カレにとってはストレスなのだ。"

#. Occurrence SP1:688:20511: scene=SP1
#: SP1:688
msgctxt "text_id=20511 | speaker=unknown"
msgid "  When he had to be human, his only condition was that he could look however he wanted."
msgstr "　カレからしてみれば、せめて好みのカタチになる事がギリギリの妥協点なのである。"

#. Occurrence SP1:693:20512: scene=SP1
#: SP1:693
msgctxt "text_id=20512 | speaker=unknown"
msgid "  He was currently only in this form because they had to move from the town to the old school building. Once he found a classroom to sleep in, he'd be back to a wolf."
msgstr "　今は町から旧校舎に移動する為、やむなくヒト形に変身しているが、寝床になる教室が決まればすぐに狼のカタチに戻ってしまう。"

#. Occurrence SP1:732:20513: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0011; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:732
msgctxt "text_id=20513 | speaker=touko"
msgid "\"Why do you hate being in human form so much anyway? It's not particularly difficult to stay like that, is it? Aren't you originally an astral body?\""
msgstr "「なんだってヒト形でいるのを嫌がるのかしらね。別に難しいワケじゃないんでしょう、ソレ？　もともとアストラル体みたいなものなんだから、貴方」"

#. Occurrence SP1:738:20514: scene=SP1
#: SP1:738
msgctxt "text_id=20514 | speaker=unknown"
msgid "  Being an extremely versatile lifeform which required no body to remain stable"
msgstr "　カレの体は状況に応じて変態する。"

#. Occurrence SP1:743:20515: scene=SP1
#: SP1:743
msgctxt "text_id=20515 | speaker=unknown"
msgid "  in the physical world, his body could change according to the situation."
msgstr "　物質界で安定する為の<触媒|にくたい>を必要としない、万能の生命だ。"

#. Occurrence SP1:748:20516: scene=SP1
#: SP1:748
msgctxt "text_id=20516 | speaker=unknown"
msgid "  Magecraft would have defined him as a higher-dimensional lifeform with a materialized soul."
msgstr "　魔術的に言えば、魂が物質化した高次生命である。"

#. Occurrence SP1:783:20517: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0008; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:783
msgctxt "text_id=20517 | speaker=beo"
msgid "\"It's not hard or dangerous. Just annoying."
msgstr "「そりゃあ何の力もリスクもないけど、メンドウなものはメンドウだよ。"

#. Occurrence SP1:789:20518: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0009; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:789
msgctxt "text_id=20518 | speaker=beo"
msgid "  Humans don't like doing things they don't have to, right?"
msgstr "　人間だって無駄なコトはしたくないでしょ？"

#. Occurrence SP1:789:20519: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0009; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:789
msgctxt "text_id=20519 | speaker=beo"
msgid "  Well, it's the same for me. There's no practical reason for me to ever be in human form.\""
msgstr "　ボク、ヒト形になるコトに有利性をまったく感じないしー」"

#. Occurrence SP1:813:20520: scene=SP1
#: SP1:813
msgctxt "text_id=20520 | speaker=unknown"
msgid "  Apparently, he saw no value at all in his human form."
msgstr "　カレにとって「人間の姿」とは何の価値も見いだせないものらしい。"

#. Occurrence SP1:818:20521: scene=SP1
#: SP1:818
msgctxt "text_id=20521 | speaker=unknown"
msgid "  That was exactly why Touko insisted he make his appearance blend in more. But the boy argued that if he had to be in an unnatural state, he'd at least make himself comfortable."
msgstr "　なら外見を地味にしても良かろう、と橙子は指摘したものだが、意味がない変態だからこそ、せめて“気持ちの良い”状態を優先するのだ、とカレは言った。"

#. Occurrence SP1:863:20522: scene=SP1
#: SP1:863
msgctxt "text_id=20522 | speaker=unknown"
msgid "  To him, this was the only fun way to be a human, and he wasn't going to accept it any other way."
msgstr "　カレにとってあのカタチはヒト形において唯一『楽しい』イメージらしく、そこから外れる事を<頑|がん>として受け入れない。"

#. Occurrence SP1:868:20523: scene=SP1
#: SP1:868
msgctxt "text_id=20523 | speaker=unknown"
msgid "  And so, this was why he had taken on the appearance of a foreign aristocrat in a provincial Japanese city."
msgstr "　結果、地方都市には場違いな、外国の貴人そのもののルックスになる。"

#. Occurrence SP1:873:20524: scene=SP1
#: SP1:873
msgctxt "text_id=20524 | speaker=unknown"
msgid "  Even his posh coat had been hand-picked by Touko to satisfy one of his many demands."
msgstr "　着ているコートも、注文の多いカレを納得させる為、橙子が手ずから選んだ逸品だった。"

#. Occurrence SP1:916:20525: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0012; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:916
msgctxt "text_id=20525 | speaker=touko"
msgid "\"Keep an eye on the place while I'm out, Beo."
msgstr "「じゃ、お留守番お願いねベオ君。"

#. Occurrence SP1:922:20526: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0013; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:922
msgctxt "text_id=20526 | speaker=touko"
msgid "  I don't think anyone will stumble upon us, but if they do, be sure to hold them until I get back."
msgstr "　来ないとは思うけど、もし人が来たら捕まえておいて。"

#. Occurrence SP1:922:20527: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0013; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:922
msgctxt "text_id=20527 | speaker=touko"
msgid "  You can rough them up a bit if you need to, but no more than one leg.\""
msgstr "　その際、<脚|あし>の一本ぐらいなら傷つけてもＯＫだから」"

#. Occurrence SP1:934:20528: scene=SP1
#: SP1:934
msgctxt "text_id=20528 | speaker=unknown"
msgid "  And with that statement, Touko headed off into the city."
msgstr "　物騒な言いつけを残して、橙子は町へと出かけていく。"

#. Occurrence SP1:963:20529: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0010; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:963
msgctxt "text_id=20529 | speaker=beo"
msgid "\"Okay, you got it!"
msgstr "「はーい、まかされましたー！"

#. Occurrence SP1:969:20530: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0011; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:969
msgctxt "text_id=20530 | speaker=beo"
msgid "  Don't worry, I don't like how humans taste anyway!"
msgstr "　だいじょうぶ、人間とかそもそも口に合わないし！"

#. Occurrence SP1:975:20531: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0012; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:975
msgctxt "text_id=20531 | speaker=beo"
msgid "  I'll be fine here, just don't forget to bring me back something yummy!\""
msgstr "　こっちのコトは気にせず、あのピリピリするお土産よろしくねー！」"

#. Occurrence SP1:1023:20532: scene=SP1
#: SP1:1023
msgctxt "text_id=20532 | speaker=unknown"
msgid "  Beo plopped down onto a desk after he saw his employer off."
msgstr "　雇い主を見送って、ベオはトスン、と机に着地した。"

#. Occurrence SP1:1028:20533: scene=SP1
#: SP1:1028
msgctxt "text_id=20533 | speaker=unknown"
msgid "  He morphed back into his wolf form."
msgstr "　その姿はヒトから狼の姿に変化している。"

#. Occurrence SP1:1049:20534: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0013; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:1049
msgctxt "text_id=20534 | speaker=beo"
msgid "\"Sooo bored. How did I end up out here in this country town after traveling around the world?\""
msgstr "「“あーあ、タイクツー。世界中をまわって、こんな田舎町が終着とかヒョウシ抜けもいいところー”」"

#. Occurrence SP1:1068:20535: scene=SP1
#: SP1:1068
msgctxt "text_id=20535 | speaker=unknown"
msgid "  It had been two years since Beo met Touko Aozaki."
msgstr "　ベオが蒼崎橙子と出会ったのは二年前。"

#. Occurrence SP1:1073:20536: scene=SP1
#: SP1:1073
msgctxt "text_id=20536 | speaker=unknown"
msgid "  After some deliberation with the werewolves, the mage was left in charge of Beo's education."
msgstr "　人狼の里に現れた魔術師は、里の者たちと交渉の末、ベオの教育係を請け負った。"

#. Occurrence SP1:1093:20537: scene=SP1
#: SP1:1093
msgctxt "text_id=20537 | speaker=unknown"
msgid "  Of course, his village had no real control over him. He didn't have to go with her. He decided to go simply because she seemed interesting."
msgstr "　無論、里はベオに対して何の拘束力も持ち合わせていない。最終的にベオをその気にさせたのは、里への義理ではなく、橙子への興味だった。"

#. Occurrence SP1:1098:20538: scene=SP1
#: SP1:1098
msgctxt "text_id=20538 | speaker=unknown"
msgid "  Touko stood before him in the cave where he slept and asked,"
msgstr "　橙子は洞窟で眠るソレの前に立ち、"

#. Occurrence SP1:1126:20539: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0014; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:1126
msgctxt "text_id=20539 | speaker=touko"
msgid "\"Wait, you want to know the meaning of life?"
msgstr "「え、生きている意味が知りたい？"

#. Occurrence SP1:1132:20540: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0015; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:1132
msgctxt "text_id=20540 | speaker=touko"
msgid "  Is that really why you agreed to this?\""
msgstr "　なんだ。そんな事で取引が成立するとはね」"

#. Occurrence SP1:1138:20541: scene=SP1
#: SP1:1138
msgctxt "text_id=20541 | speaker=unknown"
msgid "  She smiled and cut off her long locks of hair to seal their pact."
msgstr "　涼しげに笑った後、その長い髪を切って拘束の<契約|くさり>にした。"

#. Occurrence SP1:1170:20542: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0016; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:1170
msgctxt "text_id=20542 | speaker=touko"
msgid "\"To know freedom, you must also know restraint."
msgstr "「自由を知るには窮屈さを知っておかないとね。"

#. Occurrence SP1:1176:20543: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0017; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:1176
msgctxt "text_id=20543 | speaker=touko"
msgid "  Similarly, if you want to know the meaning of life, then you must have a reason not to die."
msgstr "　同じように、生きている意味を知りたければ、まずは死ねない<執着|こだわり>を見付けないと。"

#. Occurrence SP1:1182:20544: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0018; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:1182
msgctxt "text_id=20544 | speaker=touko"
msgid "  ...For example, if you harbor a hatred so strong that you yourself can't fathom dying before you kill that person.\""
msgstr "　―――そうだな、例えばの話。そいつを殺すまでは、とてもじゃないが死ねないほどの憎しみとか」"

#. Occurrence SP1:1202:20545: scene=SP1
#: SP1:1202
msgctxt "text_id=20545 | speaker=unknown"
msgid "  That hair was twenty years' worth of Touko's life."
msgstr "　蒼崎橙子の二十年分の蓄積。"

#. Occurrence SP1:1207:20546: scene=SP1
#: SP1:1207
msgctxt "text_id=20546 | speaker=unknown"
msgid "  In a way, her hair was a part of herself, but she parted with it easily."
msgstr "　分身とも言える髪を、彼女はあっさりと手放した。"

#. Occurrence SP1:1212:20547: scene=SP1
#: SP1:1212
msgctxt "text_id=20547 | speaker=unknown"
msgid "  She was sure that Beo was worth the twenty years it had taken her to grow that hair."
msgstr "　それだけの価値が、今まで貯めてきたものをノータイムで切り捨てられるだけの価値が、ベオにあると確信して。"

#. Occurrence SP1:1246:20548: scene=SP1
#: SP1:1246
msgctxt "text_id=20548 | speaker=unknown"
msgid "  Beo, too, sensed that Touko was a creature of rare value."
msgstr "　またベオも同じように、この人間が稀少な価値を持つ生き物だと嗅ぎ取っていた。"

#. Occurrence SP1:1251:20549: scene=SP1
#: SP1:1251
msgctxt "text_id=20549 | speaker=unknown"
msgid "  He was happy to have been selected by someone of her unusual talents and, though she preached learning restraint, he observed that she was a truly free woman."
msgstr "　そんな異才に認められるのはベオとて悪い気はしなかったし、何より、窮屈さを知れと言いながらも、極めて自由な女性の振るまいに関心を覚えてしまったのだ。"

#. Occurrence SP1:1285:20550: scene=SP1
#: SP1:1285
msgctxt "text_id=20550 | speaker=unknown"
msgid "  And then..."
msgstr "　そうして、"

#. Occurrence SP1:1290:20551: scene=SP1
#: SP1:1290
msgctxt "text_id=20551 | speaker=unknown"
msgid "  Beo accepted the terms of her contract, and left his village."
msgstr "　ベオは契約の縛りを甘んじて受け入れ、里の外―――"

#. Occurrence SP1:1295:20552: scene=SP1
#: SP1:1295
msgctxt "text_id=20552 | speaker=unknown"
msgid "  He took his first steps into the outside world."
msgstr "　外の世界に足を向けた。"

#. Occurrence SP1:1345:20553: scene=SP1
#: SP1:1345
msgctxt "text_id=20553 | speaker=unknown"
msgid "  The first year was spent at Touko's workshop in England, learning basic knowledge."
msgstr "　まずは一年、イギリスの工房で基本的な知識を学んだ。"

#. Occurrence SP1:1350:20554: scene=SP1
#: SP1:1350
msgctxt "text_id=20554 | speaker=unknown"
msgid "  Namely, it was at a college of the Mage's Association, called the Clock Tower."
msgstr "『時計塔』と呼ばれる魔術協会の学舎での話である。"

#. Occurrence SP1:1356:20555: scene=SP1
#: SP1:1356
msgctxt "text_id=20555 | speaker=unknown"
msgid "  At the time, Touko had her own dedicated familiar."
msgstr "　その頃、蒼崎橙子には専用の使い魔がいた。"

#. Occurrence SP1:1361:20556: scene=SP1
#: SP1:1361
msgctxt "text_id=20556 | speaker=unknown"
msgid "  Formally speaking, this familiar was Beo's senior,"
msgstr "　立場的にはベオの先輩というヤツである。"

#. Occurrence SP1:1366:20557: scene=SP1
#: SP1:1366
msgctxt "text_id=20557 | speaker=unknown"
msgid "  but in that year's time, Beo proved himself superior and earned the right to travel the world with Touko."
msgstr "　ベオは一年で先輩より優れている事を証明し、橙子と共に世界を巡る旅に出かけた。"

#. Occurrence SP1:1397:20558: scene=SP1
#: SP1:1397
msgctxt "text_id=20558 | speaker=unknown"
msgid "  They rode on a train that collected Mystic Eyes, known as the Rail Zeppelin."
msgstr "　北欧の森を走るという<魔眼収集列車|レール・ツェッペリン>。"

#. Occurrence SP1:1402:20559: scene=SP1
#: SP1:1402
msgctxt "text_id=20559 | speaker=unknown"
msgid "  They saw the Murkrake, an ancient, giant octopus living in the North Sea."
msgstr "　北海にいまなお生き続ける<巨大古代種|ムールクラーケ>。"

#. Occurrence SP1:1407:20560: scene=SP1
#: SP1:1407
msgctxt "text_id=20560 | speaker=unknown"
msgid "  They explored the Bermuda Triangle, a place of no return, connected to other realms."
msgstr "　三角形に開いた、異界に通じる<帰らず|バミューダ>の海。"

#. Occurrence SP1:1412:20561: scene=SP1
#: SP1:1412
msgctxt "text_id=20561 | speaker=unknown"
msgid "  They met the remains of a mage of the Elder Title, a league of ancients, deep in western Europe."
msgstr "　西欧諸国に潜む、<神代連盟|エルダータイトル>を名乗る魔術師のなれの果て。"

#. Occurrence SP1:1432:20562: scene=SP1
#: SP1:1432
msgctxt "text_id=20562 | speaker=unknown"
msgid "  All of their exploits were odd and exciting enough to hold his interest,"
msgstr "　いずれも楽しむには十分な“異常”であり、"

#. Occurrence SP1:1437:20563: scene=SP1
#: SP1:1437
msgctxt "text_id=20563 | speaker=unknown"
msgid "  and throughout them all, Beo felt that he'd been right to join Touko."
msgstr "　カレは蒼崎橙子に付いてきた判断を正しく思った。"

#. Occurrence SP1:1442:20564: scene=SP1
#: SP1:1442
msgctxt "text_id=20564 | speaker=unknown"
msgid "  This was certainly less boring than sleeping in his cave."
msgstr "　だって、里で眠っていた時に比べれば、少しだけ退屈しない。"

#. Occurrence SP1:1484:20565: scene=SP1
#: SP1:1484
msgctxt "text_id=20565 | speaker=unknown"
msgid "  But sweet honey makes one crave even sweeter poison;"
msgstr "　甘い蜜には、より甘い毒を。"

#. Occurrence SP1:1489:20566: scene=SP1
#: SP1:1489
msgctxt "text_id=20566 | speaker=unknown"
msgid "  having developed a taste for adventure, he now demanded even greater thrills."
msgstr "　薬に慣れたのなら、更なる劇薬を。"

#. Occurrence SP1:1494:20567: scene=SP1
#: SP1:1494
msgctxt "text_id=20567 | speaker=unknown"
msgid "  It was only natural that such an innocent creature would start to look forward to its next prey."
msgstr "　この無邪気な生き物が次の獲物を楽しみにするようになったのは、当然の流れと言える。"

#. Occurrence SP1:1499:20568: scene=SP1
#: SP1:1499
msgctxt "text_id=20568 | speaker=unknown"
msgid "  The pinnacle of that desire rested on Touko's final goal:"
msgstr "　その娯楽、その期待の最高峰が、蒼崎橙子の最終目的。"

#. Occurrence SP1:1504:20569: scene=SP1
#: SP1:1504
msgctxt "text_id=20569 | speaker=unknown"
msgid "  For all her liberty and aplomb, there was one prey she would not stop chasing until she caught it once and for all."
msgstr "　自由自在な彼女をして、在るだけで許せないモノ、と言わしめた獲物である。"

#. Occurrence SP1:1539:20570: scene=SP1
#: SP1:1539
msgctxt "text_id=20570 | speaker=unknown"
msgid "  With every new adventure, Beo would ask,"
msgstr "　新しい脅威に向かう度、ベオは橙子に問いただしたものだ。"

#. Occurrence SP1:1549:20571: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0014; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:1549
msgctxt "text_id=20571 | speaker=beo"
msgid "\"So, is this the person you want to kill, Touko?\""
msgstr "「“ねえ、これがトーコさんの殺したい相手？”」"

#. Occurrence SP1:1555:20572: scene=SP1
#: SP1:1555
msgctxt "text_id=20572 | speaker=unknown"
msgid "  However, the mage would always smile wryly and shake her head in response."
msgstr "　しかし、魔術師は口元を皮肉げにゆがめて首を横に振るばかり。"

#. Occurrence SP1:1560:20573: scene=SP1
#: SP1:1560
msgctxt "text_id=20573 | speaker=unknown"
msgid "  Even this puppet master of extraordinary talent claimed that it was no easy task."
msgstr "　こんな<易|やさ>しいものじゃあない、と希代の人形師は語る。"

#. Occurrence SP1:1601:20574: scene=SP1
#: SP1:1601
msgctxt "text_id=20574 | speaker=unknown"
msgid "  Her target was in a realm far beyond anyone they'd dealt with so far--"
msgstr "　それまで橙子とベオが倒してきた相手、"

#. Occurrence SP1:1601:20575: scene=SP1
#: SP1:1601
msgctxt "text_id=20575 | speaker=unknown"
msgid "  beyond human knowledge. Perhaps, beyond even Beo."
msgstr "　交渉してきた相手は、カレに及ばないまでも、いずれ<人智|じんち>及ばぬ魔境たちだった。"

#. Occurrence SP1:1606:20576: scene=SP1
#: SP1:1606
msgctxt "text_id=20576 | speaker=unknown"
msgid "  But who could this mysterious person be? And how could they be so powerful?"
msgstr "　では、それらを向こうに回す敵とは如何ほどのモノか？"

#. Occurrence SP1:1611:20577: scene=SP1
#: SP1:1611
msgctxt "text_id=20577 | speaker=unknown"
msgid "  Beo couldn't help but be curious."
msgstr "　そこまで言われては気になって仕方がない。"

#. Occurrence SP1:1616:20578: scene=SP1
#: SP1:1616
msgctxt "text_id=20578 | speaker=unknown"
msgid "  Discovering that he was hired for \"Magical\" reasons,"
msgstr "　やがて自分が雇われた目的が“魔法”と知り、"

#. Occurrence SP1:1621:20579: scene=SP1
#: SP1:1621
msgctxt "text_id=20579 | speaker=unknown"
msgid "  he mustered a rare bit of fighting spirit, thinking he'd found a worthy foe. But..."
msgstr "　それなら相手にとって不足はない、と珍しく闘志を燃やしたのだが―――"

#. Occurrence SP1:1656:20580: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0015; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:1656
msgctxt "text_id=20580 | speaker=beo"
msgid "\"You know, I think it's kind of childish for the real thing to take on an impostor."
msgstr "「“レーセイになって考えてみると、本物が偽物を相手にするとかオトナげないかも。"

#. Occurrence SP1:1656:20581: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0015; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:1656
msgctxt "text_id=20581 | speaker=beo"
msgid "  At the end of the day, this so-called 'Magic' is just another thing that humans made.\""
msgstr "　魔法なんていっても、結局は人間の手によるものなんだし”」"

#. Occurrence SP1:1700:20582: scene=SP1
#: SP1:1700
msgctxt "text_id=20582 | speaker=unknown"
msgid "  Clearly, it was still only interested in itself."
msgstr "　ソレの関心は、やはり自分に対してのみ。"

#. Occurrence SP1:1706:20583: scene=SP1
#: SP1:1706
msgctxt "text_id=20583 | speaker=unknown"
msgid "  It knew nothing of life or freedom. Its only pleasure was found in food."
msgstr "　命を知らず、自由を知らず、楽しみといったら食事だけ。"

#. Occurrence SP1:1712:20584: scene=SP1
#: SP1:1712
msgctxt "text_id=20584 | speaker=unknown"
msgid "  Beo didn't necessarily feel dissatisfied, but it was becoming harder to stave off his boredom."
msgstr "　そんな自分に不満はないが、退屈である事だけはいかんともしがたい。"

#. Occurrence SP1:1717:20585: scene=SP1
#: SP1:1717
msgctxt "text_id=20585 | speaker=unknown"
msgid "  Also, since accompanying Touko on her adventures, his feelings toward her had become a bit confused."
msgstr "　それと。蒼崎橙子に同行するようになってからは、彼女に対してもよく分からない感情を持ち始めていた。"

#. Occurrence SP1:1754:20586: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0016; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:1754
msgctxt "text_id=20586 | speaker=beo"
msgid "\"Touko, I just think you're obsessed."
msgstr "「“トーコさん、あれでほんと一途だから。"

#. Occurrence SP1:1760:20587: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0017; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:1760
msgctxt "text_id=20587 | speaker=beo"
msgid "  You can literally do anything you want, just like me, and yet that's what you focus your energy on?\""
msgstr "　何でもできるのはボクと同じなのに、何にでも一生懸命になれるのって、ちょっとヘンだよね”」"

#. Occurrence SP1:1779:20588: scene=SP1
#: SP1:1779
msgctxt "text_id=20588 | speaker=unknown"
msgid "  He slumped his shoulders exaggeratedly and closed his eyes."
msgstr "　やれやれ、と大げさに肩をすくめて<瞼|まぶた>を閉じる。"

#. Occurrence SP1:1784:20589: scene=SP1
#: SP1:1784
msgctxt "text_id=20589 | speaker=unknown"
msgid "  The golden wolf drifted off to sleep, not realizing that his feelings were in fact those of jealousy."
msgstr "　それが<妬|ねた>みという感情である事を知らないまま、金色の狼は意識を落とした。"

#. Occurrence SP1:1845:20590: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0019; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:1845
msgctxt "text_id=20590 | speaker=touko"
msgid "\"This place sure has changed in the last four years."
msgstr "「四年ぶりに帰ってきてみれば、住み慣れた町の面影は何処へやら、かあ。"

#. Occurrence SP1:1851:20591: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0020; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:1851
msgctxt "text_id=20591 | speaker=touko"
msgid "  Did they really need to tear down and rebuild the entire front of the station? And... ah, yep. That smoke shop on the corner is gone."
msgstr "　駅前なんてもう別物だし、大手術にも程が……ああ、やっぱり<角|かど>の煙草屋さん、なくなってる。"

#. Occurrence SP1:1857:20592: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0021; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:1857
msgctxt "text_id=20592 | speaker=touko"
msgid "  Oh, well. Guess I'll have to get used to the idea of buying cigarettes from a vending machine.\""
msgstr "　あーあ。自動販売機で煙草を買うのにも、そろそろ慣れなくちゃいけないのかも」"

#. Occurrence SP1:1891:20593: scene=SP1
#: SP1:1891
msgctxt "text_id=20593 | speaker=unknown"
msgid "  Touko walked through her hometown for the first time in four years, grumbling to herself."
msgstr "　なんてグチをこぼしながら、蒼崎橙子は四年ぶりの故郷を歩く。"

#. Occurrence SP1:1896:20594: scene=SP1
#: SP1:1896
msgctxt "text_id=20594 | speaker=unknown"
msgid "  She was on an aimless and careless stroll."
msgstr "　その姿は<緩|ゆる>みに緩みきっていた。"

#. Occurrence SP1:1901:20595: scene=SP1
#: SP1:1901
msgctxt "text_id=20595 | speaker=unknown"
msgid "  No familiar escorted her,"
msgstr "　使い魔も連れておらず、"

#. Occurrence SP1:1906:20596: scene=SP1
#: SP1:1906
msgctxt "text_id=20596 | speaker=unknown"
msgid "  and she'd even left her self-defense 'bag' back at the hideout."
msgstr "　護身用の「鞄」もアジトに置きっぱなし。"

#. Occurrence SP1:1911:20597: scene=SP1
#: SP1:1911
msgctxt "text_id=20597 | speaker=unknown"
msgid "  Today, she was in full tourist mode, not nervous about a thing."
msgstr "　気持ちは完全に観光気分で、緊張のキの字もない。"

#. Occurrence SP1:1944:20598: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0022; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:1944
msgctxt "text_id=20598 | speaker=touko"
msgid "\"This place was no bigger than a footpath before, and now it's an actual street."
msgstr "「ここなんてあぜ道同然だったのに、今じゃ立派なストリートときた。"

#. Occurrence SP1:1953:20599: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0023; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:1953
msgctxt "text_id=20599 | speaker=touko"
msgid "  It's odd. I know I'm home, but it feels like going back to that town overseas.\""
msgstr "　因果なものね。帰ってきたっていうのに、あっちに戻った時と同じ気持ちになってきた」"

#. Occurrence SP1:1988:20600: scene=SP1
#: SP1:1988
msgctxt "text_id=20600 | speaker=unknown"
msgid "  This was Touko's second time going back home."
msgstr "　橙子にとって、帰郷はこれで二度目になる。"

#. Occurrence SP1:1993:20601: scene=SP1
#: SP1:1993
msgctxt "text_id=20601 | speaker=unknown"
msgid "  After leaving the Aozaki home four years ago, she'd secretly returned to Misaki."
msgstr "　四年前に蒼崎家から出奔し、こうして秘密裏に戻って来たのが<二度目|こんかい>。"

#. Occurrence SP1:1998:20602: scene=SP1
#: SP1:1998
msgctxt "text_id=20602 | speaker=unknown"
msgid "  The first time was longer ago."
msgstr "　一度目の帰郷はもっと前。"

#. Occurrence SP1:2003:20603: scene=SP1
#: SP1:2003
msgctxt "text_id=20603 | speaker=unknown"
msgid "  When Touko was fourteen years old, she studied abroad at an academy in England."
msgstr "　十四歳の時、彼女は英国のとある学院に留学していた経歴を持つ。"

#. Occurrence SP1:2049:20604: scene=SP1
#: SP1:2049
msgctxt "text_id=20604 | speaker=unknown"
msgid "  She'd spent two years there before returning to Japan."
msgstr "　橙子は二年間あちらで学生として過ごし、日本に帰国。"

#. Occurrence SP1:2054:20605: scene=SP1
#: SP1:2054
msgctxt "text_id=20605 | speaker=unknown"
msgid "  Then, she'd enrolled in a local high school named Reien Girls' Academy, and headed back to England three years later after graduating."
msgstr "　高校は地元の学校を選び、礼園女学院で三年間過ごした後、再び英国に出奔した。"

#. Occurrence SP1:2059:20606: scene=SP1
#: SP1:2059
msgctxt "text_id=20606 | speaker=unknown"
msgid "  That was four years ago."
msgstr "　それが四年前の出来事だ。"

#. Occurrence SP1:2064:20607: scene=SP1
#: SP1:2064
msgctxt "text_id=20607 | speaker=unknown"
msgid "  Now she felt the same as she did then, when she returned to that English country town where she'd lived for two years."
msgstr "　その時、英国の田舎町に戻った時と同じ感想を、いま橙子は抱いている。"

#. Occurrence SP1:2104:20608: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0024; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:2104
msgctxt "text_id=20608 | speaker=touko"
msgid "\"Lonely? Hmm, not really. Disappointed? Not exactly. Scared doesn't sound quite right, but maybe?\""
msgstr "「寂しい？　んー、ちょっと違う。呆れてる……とも違うし、怖がっている、も近くて遠いような……」"

#. Occurrence SP1:2110:20609: scene=SP1
#: SP1:2110
msgctxt "text_id=20609 | speaker=unknown"
msgid "  She rounded her shoulders and fell deep into thought."
msgstr "　肩を丸めて考えこむ。"

#. Occurrence SP1:2115:20610: scene=SP1
#: SP1:2115
msgctxt "text_id=20610 | speaker=unknown"
msgid "  Touko felt a tingle run up her spine in a way that couldn't really be described in words."
msgstr "　背中にむずむずと湧きたつ、いまいち言語化できないざわめき。"

#. Occurrence SP1:2135:20611: scene=SP1
#: SP1:2135
msgctxt "text_id=20611 | speaker=unknown"
msgid "  Times were changing faster than ever. Everything was relatively inexpensive and could be replaced on a whim."
msgstr "　急激な変化を迎えた時代。あらゆるものが安価で、かつ安易に造り替えられていく風潮。"

#. Occurrence SP1:2140:20612: scene=SP1
#: SP1:2140
msgctxt "text_id=20612 | speaker=unknown"
msgid "  After thinking to herself for a bit, she cracked her knuckles and set forth."
msgstr "　橙子はしばし考えこんでから、そっか、と指を鳴らして足を踏み出した。"

#. Occurrence SP1:2173:20613: scene=SP1
#: SP1:2173
msgctxt "text_id=20613 | speaker=unknown"
msgid "  There was no use overthinking any of this."
msgstr "　難しく考える必要はない。"

#. Occurrence SP1:2178:20614: scene=SP1
#: SP1:2178
msgctxt "text_id=20614 | speaker=unknown"
msgid "  This was just how things were now. That's all there was to it."
msgstr "　これはただ、今がそういう時代であるだけの話。"

#. Occurrence SP1:2183:20615: scene=SP1
#: SP1:2183
msgctxt "text_id=20615 | speaker=unknown"
msgid "  It was only natural for the old to make way for the new."
msgstr "　単に、古いものを新しいものに取り替える時期が、当然のようにやってきたのだ。"

#. Occurrence SP1:2197:20616: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0025; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:2197
msgctxt "text_id=20616 | speaker=touko"
msgid "\"This is it! My time is now!\""
msgstr "「うん。つまり、私の時代ってコトだ！」"

#. Occurrence SP1:2217:20617: scene=SP1
#: SP1:2217
msgctxt "text_id=20617 | speaker=unknown"
msgid "(You can do this, Touko!)"
msgstr "“橙子さん、やっちゃってください”"

#. Occurrence SP1:2223:20618: scene=SP1
#: SP1:2223
msgctxt "text_id=20618 | speaker=unknown"
msgid "  This sudden spark of self-enlightenment gave Touko the encouragement she needed, and she set off with high spirits toward the train station."
msgstr "　そんなノリノリの<自|じ><己|こ><啓発|けいはつ>に背中を押されて、蒼崎橙子は意気揚々と駅に向かって歩きだした。"

#. Occurrence SP1:2265:20619: scene=SP1
#: SP1:2265
msgctxt "text_id=20619 | speaker=unknown"
msgid "  Striding down the boulevard, she exuded the confidence of a supermodel or dictator."
msgstr "　大通りをずんずんと<驀進|ばくしん>する様は、トップモデルか独裁者かという迫力である。"

#. Occurrence SP1:2270:20620: scene=SP1
#: SP1:2270
msgctxt "text_id=20620 | speaker=unknown"
msgid "  Although she was not about to exclaim,"
msgstr "　しかし、"

#. Occurrence SP1:2270:20621: scene=SP1
#: SP1:2270
msgctxt "text_id=20621 | speaker=unknown"
msgid "\"My conquest begins with Main Street! Time to tear it up!\""
msgstr "『手始めに、この大通りをメチャクチャにしてやるぜー！』"

#. Occurrence SP1:2275:20622: scene=SP1
#: SP1:2275
msgctxt "text_id=20622 | speaker=unknown"
msgid "  Her enthusiasm was, of course, still there."
msgstr "　と意気込んでのコトでは、無論、ない。"

#. Occurrence SP1:2295:20623: scene=SP1
#: SP1:2295
msgctxt "text_id=20623 | speaker=unknown"
msgid "  Touko, however, had something she had to accomplish first..."
msgstr "　橙子とて、これからはじまる大掃除、大工事の前にセンスのない町並み……"

#. Occurrence SP1:2300:20624: scene=SP1
#: SP1:2300
msgctxt "text_id=20624 | speaker=unknown"
msgid "  Before she could give thought to putting an end to the town's thoughtless"
msgstr "　何の工夫も見られない、十年後には時代遅れになっているであろう大通り……"

#. Occurrence SP1:2305:20625: scene=SP1
#: SP1:2305
msgctxt "text_id=20625 | speaker=unknown"
msgid "  attempts at modernization that would become outdated in just a few years."
msgstr "　を<更地|さらち>にしたいところではあるが、今の彼女にはその前にやらねばならぬ事があるのである。"

#. Occurrence SP1:2361:20626: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0026; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:2361
msgctxt "text_id=20626 | speaker=touko"
msgid "\"This machine's a winner for sure."
msgstr "「甘い設定だ。"

#. Occurrence SP1:2367:20627: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0027; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:2367
msgctxt "text_id=20627 | speaker=touko"
msgid "  Did they really think they could fool anyone with the pegs set like this?\""
msgstr "　こんな釘のしぼりで、客を<煙|けむ>にまけると思ったか」"

#. Occurrence SP1:2390:20628: scene=SP1
#: SP1:2390
msgctxt "text_id=20628 | speaker=unknown"
msgid "  Touko's first destination was not one Misaki's protective sigils, but rather her old favorite pachinko parlor."
msgstr "　橙子がまず向かった先は結界の支点ではなく、繁華街のパチンコ店だった。"

#. Occurrence SP1:2395:20629: scene=SP1
#: SP1:2395
msgctxt "text_id=20629 | speaker=unknown"
msgid "  Though the area around the train station had undergone a dramatic makeover, the back streets were mostly unchanged."
msgstr "　駅前は様変わりしたといっても、下町はそう変わっていない。"

#. Occurrence SP1:2400:20630: scene=SP1
#: SP1:2400
msgctxt "text_id=20630 | speaker=unknown"
msgid "  Touko had exchanged 5,000 yen for some little silver pachinko balls before going upstairs and sitting at the machine she determined was paying out the most that day."
msgstr "　橙子は昔馴染みのパチンコ店に突入するや、五千円を銀玉に両替。そのまま二階フロアにあがり、今日一番の出玉設定をしている台を見抜き、ハンドルに手を掛けた。"

#. Occurrence SP1:2427:20631: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0028; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:2427
msgctxt "text_id=20631 | speaker=touko"
msgid "\"Hmm, maybe now's a good time to stop. Let's see... I've got twelve boxes so far. Not too shabby after not playing for four years.\""
msgstr "「そろそろ打ち止めかな。ひーふーみー……千両箱が十二箱か。まあ、四年ぶりにしちゃあ上等だろう」"

#. Occurrence SP1:2433:20632: scene=SP1
#: SP1:2433
msgctxt "text_id=20632 | speaker=unknown"
msgid "  She sounded slightly disappointed, but her lips and posture betrayed her good humor."
msgstr "　台詞は冷めたものだが、口元ではちょろい、と上機嫌の<体|てい>である。"

#. Occurrence SP1:2453:20633: scene=SP1
#: SP1:2453
msgctxt "text_id=20633 | speaker=unknown"
msgid "  Pachinko parlors were a staple form of entertainment in Japan, but they were largely absent in other countries."
msgstr "　パチンコホールは定番とも言える娯楽提供場だが、<盛|さか>んなのは日本だけで、外国ではあまり見られない。"

#. Occurrence SP1:2458:20634: scene=SP1
#: SP1:2458
msgctxt "text_id=20634 | speaker=unknown"
msgid "  High-stakes gamers criticized it as inefficient, time-consuming, too luck-dependent, unrewarding, and so forth... basically, a child's game."
msgstr "　効率が悪い、時間がかかる、騙しあいの面白味がない、リスクとリターンがあっていない……等々の理由で、<本|・><場|・>のプレイヤーたちからは子供の遊びと敬遠されている。"

#. Occurrence SP1:2492:20635: scene=SP1
#: SP1:2492
msgctxt "text_id=20635 | speaker=unknown"
msgid "  When Touko was studying abroad, she didn't see anything that even resembled a pachinko parlor."
msgstr "　橙子の留学先でもそれは同じで、パチンコ店なぞ影も形も見あたらなかった。"

#. Occurrence SP1:2497:20636: scene=SP1
#: SP1:2497
msgctxt "text_id=20636 | speaker=unknown"
msgid "  However, she wasn't here playing pachinko because she was feeling nostalgic for it after five years."
msgstr "　帰国した彼女が真っ先にパチンコ店に突貫したのは、五年ぶりの懐かしさから―――"

#. Occurrence SP1:2502:20637: scene=SP1
#: SP1:2502
msgctxt "text_id=20637 | speaker=unknown"
msgid "  She simply needed a war chest."
msgstr "　ではなく、単に、軍資金が底をつきかけた為である。"

#. Occurrence SP1:2523:20638: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0029; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:2523
msgctxt "text_id=20638 | speaker=touko"
msgid "\"I didn't think the helicopter alone would set me over budget. Japan's so absurdly peaceful that all the black market dealers are too damned expensive."
msgstr "「しっかし、ヘリのチャーター代だけで足が出るとは。日本は平和すぎて裏稼業の相場が高すぎるんだ、クソッ。"

#. Occurrence SP1:2529:20639: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0030; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:2529
msgctxt "text_id=20639 | speaker=touko"
msgid "  Now I'm totally broke. I have to at least make a little coin to keep Beo fed.\""
msgstr "　おかげで無一文だ。とりあえず、ベオの<食|く>い<扶|ぶ><持|ち>だけでも<稼|かせ>がにゃならん」"

#. Occurrence SP1:2549:20640: scene=SP1
#: SP1:2549
msgctxt "text_id=20640 | speaker=unknown"
msgid "  Touko had chartered a helicopter to airlift three shipping containers full of materials to remodel the old school building into a workshop."
msgstr "　旧校舎を工房に改造する為、コンテナ三台分の資材をヘリコプターで隣町にまで輸送させた。"

#. Occurrence SP1:2554:20641: scene=SP1
#: SP1:2554
msgctxt "text_id=20641 | speaker=unknown"
msgid "  There weren't any roads a truck could take to get to the old school out deep in the mountains, so she had been forced to burn through the last of her savings."
msgstr "　山奥である旧校舎にはトラックを走らせるだけの道がなく、結果、橙子の貯金はすっからかんになってしまったのだ。"

#. Occurrence SP1:2582:20642: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0031; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:2582
msgctxt "text_id=20642 | speaker=touko"
msgid "\"Oh, three sevens! This game's just about done for."
msgstr "「お、スリーセブン。コイツは本格的におしまいかな。"

#. Occurrence SP1:2594:20643: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0032; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:2594
msgctxt "text_id=20643 | speaker=touko"
msgid "  Really, only these boring games are worth playing for profit these days.\""
msgstr "　まったく。こういう、どうでもいいゲームだけは星の巡りがいいときている」"

#. Occurrence SP1:2600:20644: scene=SP1
#: SP1:2600
msgctxt "text_id=20644 | speaker=unknown"
msgid "  Her smile remained in spite of her complaints."
msgstr "　文句をいいつつ、口元はやはり上機嫌だ。"

#. Occurrence SP1:2605:20645: scene=SP1
#: SP1:2605
msgctxt "text_id=20645 | speaker=unknown"
msgid "  There was nothing more Touko-esque than her sitting cross-legged in this pachinko parlor, one hand on the machine with the other holding a cheap cigarette."
msgstr "　片手はハンドル、片手は安い煙草、気ままに足を組んでパチンコ店を荒らすのも、まんざらでもない橙子だった。"

#. Occurrence SP1:2672:20646: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0033; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:2672
msgctxt "text_id=20646 | speaker=touko"
msgid "\"Hm?\""
msgstr "「？」"

#. Occurrence SP1:2678:20647: scene=SP1
#: SP1:2678
msgctxt "text_id=20647 | speaker=unknown"
msgid "  Touko noticed something out of the corner of her eye and put on her glasses to see better."
msgstr "　視界の<隅|すみ>で何かが固まっている気配を察して、メガネをかける。"

#. Occurrence SP1:2683:20648: scene=SP1
#: SP1:2683
msgctxt "text_id=20648 | speaker=unknown"
msgid "  She glanced over toward the odd sounds she heard and saw a pale-faced parlor employee."
msgstr "　妙な物音に橙子が視線を向けると、そこには顔面蒼白の店員の姿があった。"

#. Occurrence SP1:2688:20649: scene=SP1
#: SP1:2688
msgctxt "text_id=20649 | speaker=unknown"
msgid "  He had a baby face and looked like he was still in high school."
msgstr "　まだ高校生にしか見えない、童顔の店員である。"

#. Occurrence SP1:2743:20650: scene=SP1
#: SP1:2743
msgctxt "text_id=20650 | speaker=unknown"
msgid "  Upon seeing Touko, he froze for a moment, then ran off."
msgstr "　何があったのか、店員は橙子を見るなり硬直し、その後、あたふたと走り去った。"

#. Occurrence SP1:2748:20651: scene=SP1
#: SP1:2748
msgctxt "text_id=20651 | speaker=unknown"
msgid "  Or rather, he fled in a panic."
msgstr "　というか、逃げだしていった。"

#. Occurrence SP1:2777:20652: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0034; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:2777
msgctxt "text_id=20652 | speaker=touko"
msgid "\"Oof... Am I that scary?\""
msgstr "「……む。私、そんなに引く感じ？」"

#. Occurrence SP1:2783:20653: scene=SP1
#: SP1:2783
msgctxt "text_id=20653 | speaker=unknown"
msgid "  Mage though she was, Touko was still in the prime of her youth."
msgstr "　橙子とて年頃の女性である。"

#. Occurrence SP1:2788:20654: scene=SP1
#: SP1:2788
msgctxt "text_id=20654 | speaker=unknown"
msgid "  Though she didn't like it when guys ogled her or tried to strike up a conversation, she thought a boy running full tilt away from her was a bit much."
msgstr "　見つめられたり声をかけられたりするのは正直面倒だが、それにしても、一目散に逃げられる、というのはあんまりではなかろうか、と唇をとがらせる。"

#. Occurrence SP1:2793:20655: scene=SP1
#: SP1:2793
msgctxt "text_id=20655 | speaker=unknown"
msgid "  Touko made a mental note to scare the crap out of that kid the next time she saw him, and returned to her game."
msgstr "　あの高校生……今度見かけたら脅かしてやろう、と心のチェックリストに書き込みつつ、橙子はゲームを再開した。"

#. Occurrence SP1:2839:20656: scene=SP1
#: SP1:2839
msgctxt "text_id=20656 | speaker=unknown"
msgid "  With her winning tickets in hand, Touko left the pachinko parlor."
msgstr "　大量の景品を抱えてパチンコ店を後にする。"

#. Occurrence SP1:2844:20657: scene=SP1
#: SP1:2844
msgctxt "text_id=20657 | speaker=unknown"
msgid "  She had won quite a bit, but it was hard for her to feel good about it after what had happened at the end of her session."
msgstr "　せっかくの大勝ちなのだが、最後の出来事のおかげで素直に喜べない。"

#. Occurrence SP1:2878:20658: scene=SP1
#: SP1:2878
msgctxt "text_id=20658 | speaker=unknown"
msgid "  Wondering what that had been about, she looped around the back of the parlor to redeem her winnings for cash."
msgstr "　橙子はなんだかなー、と頭を掻きつつ、店の裏手にある換金所に足を向け、"

#. Occurrence SP1:2885:20659: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0000; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:2885
msgctxt "text_id=20659 | speaker=eiri"
msgid "\"Well, if it isn't Touko!\""
msgstr "「おや、橙子さんじゃないですか」"

#. Occurrence SP1:2891:20660: scene=SP1
#: SP1:2891
msgctxt "text_id=20660 | speaker=unknown"
msgid "  She stopped in her tracks, frozen by a familiar voice she hadn't heard in four years."
msgstr "　四年ぶりに聞く、思い出深い声に呼び止められた。"

#. Occurrence SP1:2944:20661: scene=SP1
#: SP1:2944
msgctxt "text_id=20661 | speaker=unknown"
msgid "  Beo's ears perked up as he woke from his slumber."
msgstr "　ピン、と眠っていたベオの耳が立つ。"

#. Occurrence SP1:2949:20662: scene=SP1
#: SP1:2949
msgctxt "text_id=20662 | speaker=unknown"
msgid "  It was just before sunset."
msgstr "　時刻は日没前。"

#. Occurrence SP1:2954:20663: scene=SP1
#: SP1:2954
msgctxt "text_id=20663 | speaker=unknown"
msgid "  He opened his eyes with a big yawn, sniffing at a familiar scent in the air getting closer."
msgstr "　嗅ぎ慣れた匂いが近づいてくるのを察して、カレは大きな<欠伸|あくび>と共に目を覚ました。"

#. Occurrence SP1:3002:20664: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0018; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3002
msgctxt "text_id=20664 | speaker=beo"
msgid "\"Mnggh...\""
msgstr "「んー、よっと」"

#. Occurrence SP1:3010:20665: scene=SP1
#: SP1:3010
msgctxt "text_id=20665 | speaker=unknown"
msgid "  Beo jumped down to the floor and transformed back into his human form."
msgstr "　ベオは机から床に飛び降り、ヒト形に変化する。"

#. Occurrence SP1:3015:20666: scene=SP1
#: SP1:3015
msgctxt "text_id=20666 | speaker=unknown"
msgid "  Though he and Touko didn't have a strict master-servant relationship, he felt he should at least go and greet her since he was supposed to be watching over the place in her absence."
msgstr "　<仮初|かりそ>めの主従関係ではあるが、留守番役として、出迎えぐらいはきっちりとこなす気らしい。"

#. Occurrence SP1:3065:20667: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0019; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3065
msgctxt "text_id=20667 | speaker=beo"
msgid "\"Huh?\""
msgstr "「あれ？」"

#. Occurrence SP1:3085:20668: scene=SP1
#: SP1:3085
msgctxt "text_id=20668 | speaker=unknown"
msgid "  Beo's face scrunched into a perplexed frown as they met in the hallway."
msgstr "　廊下で顔を会わすなり、ベオは違和感に顔をしかめた。"

#. Occurrence SP1:3090:20669: scene=SP1
#: SP1:3090
msgctxt "text_id=20669 | speaker=unknown"
msgid "  He sensed something more to the smell he'd been so used to."
msgstr "　嗅ぎ慣れたはずの匂いに、なにか、余分な厚みが混じっている気がしたからだ。"

#. Occurrence SP1:3122:20670: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0035; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3122
msgctxt "text_id=20670 | speaker=touko"
msgid "\"Hey Beo, I'm back."
msgstr "「ただいまベオくん。"

#. Occurrence SP1:3122:20671: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0035; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3122
msgctxt "text_id=20671 | speaker=touko"
msgid "  Here's your reward for watching the place while I was out.\""
msgstr "　はい、真面目にお留守番していたお土産」"

#. Occurrence SP1:3129:20672: scene=SP1
#: SP1:3129
msgctxt "text_id=20672 | speaker=unknown"
msgid "  Touko handed the paper bag she was holding to Beo."
msgstr "　橙子は手にした紙袋をベオに手渡す。"

#. Occurrence SP1:3134:20673: scene=SP1
#: SP1:3134
msgctxt "text_id=20673 | speaker=unknown"
msgid "  Beo was happy to get his hands on the bag stuffed full of hamburgers, but he tilted his head at the odd lingering scent."
msgstr "　ハンバーガーのたっぷり詰まった紙袋を受け取って、カレは喜びながら、やっぱりおかしい、と首を傾げた。"

#. Occurrence SP1:3170:20674: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0036; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3170
msgctxt "text_id=20674 | speaker=touko"
msgid "\"Why the long face? Did something happen while I was gone?\""
msgstr "「どうしたの、浮かない顔して。留守中、何かあった？」"

#. Occurrence SP1:3176:20675: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0020; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3176
msgctxt "text_id=20675 | speaker=beo"
msgid "\"No. I slept, it was so boring, actually. Did something happen with you, though?"
msgstr "「いや、思わず寝ちゃうぐらい何もなかったけど……トーコさんの方こそ何かあった？"

#. Occurrence SP1:3182:20676: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0021; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3182
msgctxt "text_id=20676 | speaker=beo"
msgid "  You seem a little down, weirdly tired, and stranger than anything is the fact that you bought me my favorite hamburgers.\""
msgstr "　なんか元気ないし。妙に疲れてるし。なにより、ちゃんとボクの好きなお店のハンバーガー、買ってきてるし」"

#. Occurrence SP1:3209:20677: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0037; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3209
msgctxt "text_id=20677 | speaker=touko"
msgid "\"Oh, really? Nothing happened, though.\""
msgstr "「え、そう？　別に、何もなかったけど？」"

#. Occurrence SP1:3243:20678: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0022; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3243
msgctxt "text_id=20678 | speaker=beo"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence SP1:3248:20679: scene=SP1
#: SP1:3248
msgctxt "text_id=20679 | speaker=unknown"
msgid "  This was all extremely suspicious."
msgstr "　怪しい。怪しいコトこの上ない。"

#. Occurrence SP1:3253:20680: scene=SP1
#: SP1:3253
msgctxt "text_id=20680 | speaker=unknown"
msgid "  One pain point for Beo was Touko's usual complete lack of interest in food."
msgstr "　ベオの不満点の一つとして、橙子の食事への<拘|こだわ>りの無さがあげられる。"

#. Occurrence SP1:3258:20681: scene=SP1
#: SP1:3258
msgctxt "text_id=20681 | speaker=unknown"
msgid "  Touko thought that a hamburger was the same no matter where you ate one, so she had often just stopped at wherever was closest."
msgstr "　ハンバーガーなんてどこでも一緒だろう、とのたまう橙子は、どうでもいい店で買い物を済ませてしまうのだ。"

#. Occurrence SP1:3263:20682: scene=SP1
#: SP1:3263
msgctxt "text_id=20682 | speaker=unknown"
msgid "  Thus, Touko would only stop at a certain Asian burger chain, still rare in Japan, maybe one percent of the time. Not to mention..."
msgstr "　そんな橙子が、日本ではまだ店舗の少ないロッテリャーでハンバーガーを買ってきてくれるなぞ百回に一回あるかないか。加えて、"

#. Occurrence SP1:3298:20683: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0038; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3298
msgctxt "text_id=20683 | speaker=touko"
msgid "\"W-what's the big deal?"
msgstr "「い、いいじゃない、"

#. Occurrence SP1:3298:20684: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0038; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3298
msgctxt "text_id=20684 | speaker=touko"
msgid "  So I bought you hamburgers from your favorite place, who cares?\""
msgstr "　ちゃんと好きなお店のバーガーを買ってきたんだからっ」"

#. Occurrence SP1:3324:20685: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0039; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3324
msgctxt "text_id=20685 | speaker=touko"
msgid "\"I was just trying to say thank you for everything."
msgstr "「これは私なりの、ベオくんへの感謝の気持ち。"

#. Occurrence SP1:3330:20686: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0040; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3330
msgctxt "text_id=20686 | speaker=touko"
msgid "  I've dragged you around all over the place, and I just hope you'll stick with me.\""
msgstr "　今まで色々連れ回したけど、これからもよろしくね」"

#. Occurrence SP1:3336:20687: scene=SP1
#: SP1:3336
msgctxt "text_id=20687 | speaker=unknown"
msgid "  She had a sickly-sweet smile on her face."
msgstr "　この愛想笑いである。"

#. Occurrence SP1:3341:20688: scene=SP1
#: SP1:3341
msgctxt "text_id=20688 | speaker=unknown"
msgid "  If any of the puppets she had let loose in Misaki heard what she was saying right now, they'd probably fall into a logic error loop and self-destruct. Touko was not one to ever consider the rights of her familiars."
msgstr "　使い魔の人権なんて考えたコトもない蒼崎橙子がこんなコトを言いだしたら、三咲町に放たれた数十体の人形たちはロジックエラーの末、自爆して果てるだろう。"

#. Occurrence SP1:3381:20689: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0023; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3381
msgctxt "text_id=20689 | speaker=beo"
msgid "\"This all smells fake, false, and full of lies to me!"
msgstr "「<胡散|うさん>くさい、<芝居|しばい>くさい、<抹香|まっこう>くさい！"

#. Occurrence SP1:3387:20690: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0024; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3387
msgctxt "text_id=20690 | speaker=beo"
msgid "  You're not supposed to be nice! You're never nice!"
msgstr "　優しいトーコさんなんてトーコさんじゃない！"

#. Occurrence SP1:3400:20691: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0025; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3400
msgctxt "text_id=20691 | speaker=beo"
msgid "  You hate everyone and everything around you, complain constantly, and want to ruin anyone else who's ever having a good time. You only restrain yourself because you don't have a good reason to act... What happened to the Touko that had nothing but a shred of intellect standing between herself and complete moral bankruptcy?\""
msgstr "　いっつも周りを恨んでいて、文句ばっかり言って、幸せそうなヒトたちをメチャクチャにしたいんだけど大義名分がないから我慢してる……そんな、理性のおかげでかろうじて性格破綻者を<免|まぬが>れてるトーコさんはどこいったのさ？」"

#. Occurrence SP1:3434:20692: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0041; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3434
msgctxt "text_id=20692 | speaker=touko"
msgid "\"Well, that's awfully rude. I can be nice sometimes, you know."
msgstr "「失礼しちゃうなあ。私だって、たまには優しくなる時ぐらいあるんだから。"

#. Occurrence SP1:3440:20693: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0042; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3440
msgctxt "text_id=20693 | speaker=touko"
msgid "  It's been four years since I've been back here. Wouldn't you feel a little relaxed if you went back to your village?"
msgstr "　ほら、四年ぶりに故郷に帰ってきたのよ？　ベオくんだって里に帰ったら、ちょっとぐらいホッとするでしょ？"

#. Occurrence SP1:3446:20694: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0043; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3446
msgctxt "text_id=20694 | speaker=touko"
msgid "  That's how it is for me. I'm still young, cute, and innocent enough to feel a little homesick from time to time.\""
msgstr "　それと同じ。私だって、ホームシックになる程度の可愛らしさはあるんです」"

#. Occurrence SP1:3467:20695: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0026; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3467
msgctxt "text_id=20695 | speaker=beo"
msgid "\"Wow, what a load of crap. It must be a cold day in Hell!\""
msgstr "「すっごい嘘。月が涙を流すぐらい嘘！」"

#. Occurrence SP1:3473:20696: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0044; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3473
msgctxt "text_id=20696 | speaker=touko"
msgid "\"I'm serious!"
msgstr "「ホントですぅ～！"

#. Occurrence SP1:3479:20697: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0045; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3479
msgctxt "text_id=20697 | speaker=touko"
msgid "  That's it, you've ruined the moment. Give me back those hamburgers. You don't get to eat tonight!\""
msgstr "　もぅ、ベオくんそれ返して！　罰として夕食抜き！」"

#. Occurrence SP1:3528:20698: scene=SP1
#: SP1:3528
msgctxt "text_id=20698 | speaker=unknown"
msgid "  Touko made a grab for the paper bag, but Beo dodged and jumped out the window."
msgstr "　紙袋を取り返そうとする橙子を<躱|かわ>して、ベオは窓の外に飛び出した。"

#. Occurrence SP1:3533:20699: scene=SP1
#: SP1:3533
msgctxt "text_id=20699 | speaker=unknown"
msgid "  He dexterously kicked off against the wall and scampered up onto the roof of the old school building."
msgstr "　そのまま器用に壁を蹴って、旧校舎の屋根まで退避する。"

#. Occurrence SP1:3554:20700: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0027; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3554
msgctxt "text_id=20700 | speaker=beo"
msgid "\"I can't believe what I'm hearing!"
msgstr "「なんだい。ほーんと、つまんない！"

#. Occurrence SP1:3560:20701: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0028; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3560
msgctxt "text_id=20701 | speaker=beo"
msgid "  I never want to see you making excuses like that, Miss Touko!\""
msgstr "　言い訳するトーコさんとか、ボク、見たくない！」"

#. Occurrence SP1:3587:20702: scene=SP1
#: SP1:3587
msgctxt "text_id=20702 | speaker=unknown"
msgid "  He pulled out a hamburger from the paper bag and took a big bite out of it."
msgstr "　紙袋からハンバーガーを取り出し、ぱくりとかぶりつく。"

#. Occurrence SP1:3607:20703: scene=SP1
#: SP1:3607
msgctxt "text_id=20703 | speaker=unknown"
msgid "  That said..."
msgstr "　……しかし。"

#. Occurrence SP1:3612:20704: scene=SP1
#: SP1:3612
msgctxt "text_id=20704 | speaker=unknown"
msgid "  Though her attitude had seemed like an act to Beo, it was true that Touko was in an unusually good mood."
msgstr "　芝居くさい、とは言ったが、橙子が普段より穏やかだったのは事実だった。"

#. Occurrence SP1:3617:20705: scene=SP1
#: SP1:3617
msgctxt "text_id=20705 | speaker=unknown"
msgid "  It was unclear why that was the case, but Touko seemed to be feeling something special, or at least something she hadn't ever shown Beo before."
msgstr "　なぜそうなのかは分からないが、先ほどの橙子には特別な……というか、今までベオには見せなかった……感情があったようだ。"

#. Occurrence SP1:3638:20706: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0029; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3638
msgctxt "text_id=20706 | speaker=beo"
msgid "\"...What could that smell be?"
msgstr "「……なんだろ、あの匂い。"

#. Occurrence SP1:3644:20707: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0030; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3644
msgctxt "text_id=20707 | speaker=beo"
msgid "  It was so light, but also annoying...\""
msgstr "　妙にふわふわしてて、うっとうしくて―――」"

#. Occurrence SP1:3650:20708: scene=SP1
#: SP1:3650
msgctxt "text_id=20708 | speaker=unknown"
msgid "  Beo couldn't understand what exactly that feeling was."
msgstr "　あれがどんな感情なのか、ベオには分からない。"

#. Occurrence SP1:3655:20709: scene=SP1
#: SP1:3655
msgctxt "text_id=20709 | speaker=unknown"
msgid "  He only knew basic feelings such as like and dislike, delicious or disgusting. He wasn't able to articulate much further than that yet."
msgstr "　好きと嫌い、美味しいと不味いしか知らないカレには、まだそういう<機|き><微|び>が分からない。"

#. Occurrence SP1:3692:20710: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0031; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:3692
msgctxt "text_id=20710 | speaker=beo"
msgid "\"Eh, whatever. It has nothing to do with me anyway. She'll be the same old Touko tomorrow, I'm sure.\""
msgstr "「ま、いいけど。ボクには関係ないし。トーコさんも、明日になればいつものトーコさんだろうし」"

#. Occurrence SP1:3698:20711: scene=SP1
#: SP1:3698
msgctxt "text_id=20711 | speaker=unknown"
msgid "  Beo continued to eat through his hamburgers, still not completely satisfied with the day's course of events."
msgstr "　不満げにぼやきながら、パクパクとハンバーガーを消費していく。"

#. Occurrence SP1:3703:20712: scene=SP1
#: SP1:3703
msgctxt "text_id=20712 | speaker=unknown"
msgid "  The truth was..."
msgstr "　……正直なところ。"

#. Occurrence SP1:3708:20713: scene=SP1
#: SP1:3708
msgctxt "text_id=20713 | speaker=unknown"
msgid "  Even if Beo didn't care enough to understand it, he was still a little upset that there was something he didn't know."
msgstr "　分かりたいとは思わないが、未知があるコトに、ちょっとだけ不満なベオだった。"

#. Occurrence SP1:3769:20714: scene=SP1
#: SP1:3769
msgctxt "text_id=20714 | speaker=unknown"
msgid "  A few days passed."
msgstr "　それから何日か経過した。"

#. Occurrence SP1:3774:20715: scene=SP1
#: SP1:3774
msgctxt "text_id=20715 | speaker=unknown"
msgid "  Unbeknownst to the people of Misaki, progress was being made on the remodeling of the old school building."
msgstr "　旧校舎の改造は人知れず進んでいく。"

#. Occurrence SP1:3779:20716: scene=SP1
#: SP1:3779
msgctxt "text_id=20716 | speaker=unknown"
msgid "  Meanwhile, Beo was bored out of his mind knowing he had to be stuck here for at least another month."
msgstr "　あと一ヶ月近くここで待機、と言いつけられたベオは退屈で仕方がない。"

#. Occurrence SP1:3784:20717: scene=SP1
#: SP1:3784
msgctxt "text_id=20717 | speaker=unknown"
msgid "  He could feel both his body and his mind dulling as he spent his days simply lounging around eating meat."
msgstr "　日々とじこもって肉を食べているだけでは、心も体も<鈍|にぶ>るというもの。"

#. Occurrence SP1:3789:20718: scene=SP1
#: SP1:3789
msgctxt "text_id=20718 | speaker=unknown"
msgid "  On the other hand..."
msgstr "　一方、"

#. Occurrence SP1:3833:20719: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0046; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3833
msgctxt "text_id=20719 | speaker=touko"
msgid "\"I'm going shopping. Take care of the place while I'm gone!\""
msgstr "「買い出しに出てくるから、後はよろしくねー」"

#. Occurrence SP1:3864:20720: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0047; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3864
msgctxt "text_id=20720 | speaker=touko"
msgid "\"Have fun while I was out? Here, I brought you home some roast beef!\""
msgstr "「元気してた？　はい、お土産のローストビーフ！」"

#. Occurrence SP1:3893:20721: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0048; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3893
msgctxt "text_id=20721 | speaker=touko"
msgid "\"I'm going out for a bit! Tidy up those materials on the roof while I'm out, okay?\""
msgstr "「いってきまーす。屋上の機材、片づけておいてね～」"

#. Occurrence SP1:3933:20722: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0049; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3933
msgctxt "text_id=20722 | speaker=touko"
msgid "\"I'm hooome! Thanks for watching over the place again today."
msgstr "「ただいまー。今日もお留守番、ご苦労さま"

#. Occurrence SP1:3933:20723: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0049; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3933
msgctxt "text_id=20723 | speaker=touko"
msgid "\""
msgstr "」"

#. Occurrence SP1:3965:20724: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0050; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3965
msgctxt "text_id=20724 | speaker=touko"
msgid "\"Off I go, my trusty vassal!\""
msgstr "「よし、行ってくるでござる」"

#. Occurrence SP1:3995:20725: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0051; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:3995
msgctxt "text_id=20725 | speaker=touko"
msgid "\"'Eyyy, good work! Huh? I shmell like booze? Oh silly, I'm not drunk at all! Not one... not one bit... I can keep goin'!\""
msgstr "「おつかれー！　え、お酒くさい？　ばっか、酔ってなんかないですぅー。もーぜんぜん酔ってなんかないもーん」"

#. Occurrence SP1:4015:20726: scene=SP1
#: SP1:4015
msgctxt "text_id=20726 | speaker=unknown"
msgid "  This is what Touko had become."
msgstr "　このように。"

#. Occurrence SP1:4020:20727: scene=SP1
#: SP1:4020
msgctxt "text_id=20727 | speaker=unknown"
msgid "  The mage was constantly out and always in a good mood, in stark contrast to Beo, who spent his days doing nothing."
msgstr "　自宅警備中のカレとは対照的に、魔術師は実に行動的、かつ上機嫌だった。"

#. Occurrence SP1:4025:20728: scene=SP1
#: SP1:4025
msgctxt "text_id=20728 | speaker=unknown"
msgid "  Evidently, she was happy with how her workshop was becoming more and more fortified by the day."
msgstr "　着々と要塞化していく<臨時工房|アジト>の出来に、よほど満足しているらしい。"

#. Occurrence SP1:4071:20729: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0032; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4071
msgctxt "text_id=20729 | speaker=beo"
msgid "\"No. That's DEFINITELY not it."
msgstr "「ちがう。もー、ぜぇっっっったいちがう。"

#. Occurrence SP1:4077:20730: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0033; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4077
msgctxt "text_id=20730 | speaker=beo"
msgid "  That isn't enough to put Miss Touko in such a good mood."
msgstr "　そんなんでトーコさんの機嫌はよくなんないし。"

#. Occurrence SP1:4083:20731: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0034; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4083
msgctxt "text_id=20731 | speaker=beo"
msgid "  She's constantly complaining about the state of this place."
msgstr "　<旧校舎|こ　こ>に関しちゃグチグチ不満ばっかりこぼしてるし。"

#. Occurrence SP1:4089:20732: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0035; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4089
msgctxt "text_id=20732 | speaker=beo"
msgid "  Plus, the silly samurai way she's been talking is so not like her.\""
msgstr "　何より、ござるとかバカっぽいコト言わないし」"

#. Occurrence SP1:4116:20733: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0052; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:4116
msgctxt "text_id=20733 | speaker=touko"
msgid "\"Hm? What's wrong, Beo? You look unhappy. I bet you're ready to get out of here and go wild, huh?\""
msgstr "「うん？　どうしたのベオくん。すっごく不細工な顔してるけど。そろそろ暴れたくて仕方がない？」"

#. Occurrence SP1:4151:20734: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0036; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4151
msgctxt "text_id=20734 | speaker=beo"
msgid "\"That's not the problem here."
msgstr "「そういうモンダイじゃありませーん。"

#. Occurrence SP1:4157:20735: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0037; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4157
msgctxt "text_id=20735 | speaker=beo"
msgid "  ...I do want to hurry up and get this fight on, but I know it's not going to be for a while yet. I'm just waiting and doing as you ask."
msgstr "　……まあそりゃ、早く本命とやらと戦ってみたいけど、もうちょっと先なんでしょ。ならガマンする。トーコさんの言葉は今のところハズレないから、おとなしく従います。"

#. Occurrence SP1:4163:20736: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0038; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4163
msgctxt "text_id=20736 | speaker=beo"
msgid "  But...\""
msgstr "　けど―――」"

#. Occurrence SP1:4169:20737: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0053; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:4169
msgctxt "text_id=20737 | speaker=touko"
msgid "\"But?\""
msgstr "「けど？」"

#. Occurrence SP1:4195:20738: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0039; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4195
msgctxt "text_id=20738 | speaker=beo"
msgid "\"Something's... weird. I know there's always nothing to do when we're preparing, but this time it doesn't feel tense the way it should."
msgstr "「なんかヘン。いつも下準備の時はこれぐらいヒマだけど、緊張感がない。"

#. Occurrence SP1:4201:20739: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0040; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4201
msgctxt "text_id=20739 | speaker=beo"
msgid "  I'm just eating and sleeping, eating and sleeping, every day. It's going to make me fat. I don't want to be fat!\""
msgstr "　毎日食べて寝て食べて寝てじゃ<肥|ふと>るー。ぶくぶくに<肥|ふと>るよー。そんなのカッコヨクないよー」"

#. Occurrence SP1:4237:20740: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0054; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:4237
msgctxt "text_id=20740 | speaker=touko"
msgid "\"What are you talking about? You shouldn't be worrying about that. You don't even need to use the bathroom, so don't act like you're any kind of normal creature.\""
msgstr "「なに言ってるんだか。ベオくんにそんな心配は無用でしょう。<排泄|はいせつ>もしないクセに、まともな生き物ぶってるんじゃありません」"

#. Occurrence SP1:4243:20741: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0041; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4243
msgctxt "text_id=20741 | speaker=beo"
msgid "\"Fair point. But *you* will! You're going to get as fat as a pig!\""
msgstr "「うん。だから、おもにトーコさんが。ブクブクに」"

#. Occurrence SP1:4270:20742: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0055; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:4270
msgctxt "text_id=20742 | speaker=touko"
msgid "\"Are you serious?!"
msgstr "「ベオくん、それホント！？"

#. Occurrence SP1:4276:20743: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0056; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:4276
msgctxt "text_id=20743 | speaker=touko"
msgid "  I've been weighing myself and the number hasn't changed at all. Am I astrally getting fatter?! Can you tell?!\""
msgstr "　数値は変わってない筈だけど、なんかこう、アストラル的に増えちゃったりしてる！？」"

#. Occurrence SP1:4319:20744: scene=SP1
#: SP1:4319
msgctxt "text_id=20744 | speaker=unknown"
msgid "  This is what Beo was talking about."
msgstr "　これである。"

#. Occurrence SP1:4324:20745: scene=SP1
#: SP1:4324
msgctxt "text_id=20745 | speaker=unknown"
msgid "  Touko knew the accuracy of Beo's eye, and trusted his discerning vision over even the numbers on her scale."
msgstr "　ベオの目の確かさを知っている魔術師は、体重計よりカレの鑑識眼を信じたらしい。"

#. Occurrence SP1:4329:20746: scene=SP1
#: SP1:4329
msgctxt "text_id=20746 | speaker=unknown"
msgid "  Normally Touko would just remove her glasses and say something like,"
msgstr "　いつもの橙子ならメガネを外し、"

#. Occurrence SP1:4363:20747: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0057; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:4363
msgctxt "text_id=20747 | speaker=touko"
msgid "\"I know this is out of the blue, but I want to test the utility of this suicide attack weapon."
msgstr "「唐突だが、特攻兵器の有用性を確認したくなった。"

#. Occurrence SP1:4374:20748: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0058; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:4374
msgctxt "text_id=20748 | speaker=touko"
msgid "  No, no, I don't want to hear your opinion about it, Beo. Just put this collar on. It'll launch you high into the sky!\""
msgstr "　ああいや、意見は聞いていない。さあベオ、この首輪をつけてみろ。思いっきりハイに飛べるぞ」"

#. Occurrence SP1:4380:20749: scene=SP1
#: SP1:4380
msgctxt "text_id=20749 | speaker=unknown"
msgid "  But she hadn't done anything of the sort, and it was beyond weird for her."
msgstr "　ぐらいは本気で実行してくるだろうに、<肥|にぶ>っているにも程がある。"

#. Occurrence SP1:4431:20750: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0042; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4431
msgctxt "text_id=20750 | speaker=beo"
msgid "\"...No, you haven't gained any weight."
msgstr "「……別に<増|ふ>えてないよ。"

#. Occurrence SP1:4437:20751: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0043; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4437
msgctxt "text_id=20751 | speaker=beo"
msgid "  There's a slight variation from yesterday, but that's normal for a human. It would be really silly for you to worry about that seriously, so please don't.\""
msgstr "　昨日とちょっとの上下差はあるけど、そんなの人間なら当たり前だし。いちいち本気にするとか、見苦しいからやめてほしい」"

#. Occurrence SP1:4471:20752: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0059; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:4471
msgctxt "text_id=20752 | speaker=touko"
msgid "\"Really?"
msgstr "「本当？"

#. Occurrence SP1:4477:20753: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0060; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:4477
msgctxt "text_id=20753 | speaker=touko"
msgid "  You don't think it's just gonna show up later or anything?\""
msgstr "　こう、後でボテっとくるような気配とか、ない？」"

#. Occurrence SP1:4483:20754: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0044; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4483
msgctxt "text_id=20754 | speaker=beo"
msgid "\"No, the nutrients you consumed yesterday have distributed nicely throughout your body. You're the same Touko as always.\""
msgstr "「ないってば。昨日摂った栄養分はきれいに分配されてるし。いつも通りのトーコさんだよ」"

#. Occurrence SP1:4516:20755: scene=SP1
#: SP1:4516
msgctxt "text_id=20755 | speaker=unknown"
msgid "  That last part was a lie."
msgstr "　それは嘘だ。"

#. Occurrence SP1:4521:20756: scene=SP1
#: SP1:4521
msgctxt "text_id=20756 | speaker=unknown"
msgid "  She was not the same Touko that Beo had always known."
msgstr "　厳密に言えば、橙子はベオの知る“いつも通り”ではない。"

#. Occurrence SP1:4526:20757: scene=SP1
#: SP1:4526
msgctxt "text_id=20757 | speaker=unknown"
msgid "  Even though she was physically the same, there was something still odd about her since a few days ago."
msgstr "　肉体面では寸分変わらぬ彼女でも、数日前から妙な違和感が付きまとっている。"

#. Occurrence SP1:4546:20758: scene=SP1
#: SP1:4546
msgctxt "text_id=20758 | speaker=unknown"
msgid "  That strange, floaty, lingering scent was still there."
msgstr "　あの、妙に<浮|う>わ<浮|う>わした匂い。"

#. Occurrence SP1:4551:20759: scene=SP1
#: SP1:4551
msgctxt "text_id=20759 | speaker=unknown"
msgid "  It was a change that only a wild beast like Beo could discern, but it was getting stronger with each passing day."
msgstr "　野生の獣にしか嗅ぎ取れない変化だが、それは日に日に増していっている。"

#. Occurrence SP1:4556:20760: scene=SP1
#: SP1:4556
msgctxt "text_id=20760 | speaker=unknown"
msgid "  Beo was annoyed because he just could not figure out what that scent was."
msgstr "　カレが不機嫌なのは、あの匂いが“どんな味”なのか、まったく見当がつかないからだった。"

#. Occurrence SP1:4587:20761: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0061; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:4587
msgctxt "text_id=20761 | speaker=touko"
msgid "\"What a relief!"
msgstr "「それなら安心安心、と。"

#. Occurrence SP1:4601:20762: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0062; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:4601
msgctxt "text_id=20762 | speaker=touko"
msgid "  I'm headed out. Take care of the place while I'm out!\""
msgstr "　私は出かけてくるから、お留守番よろしくね～！」"

#. Occurrence SP1:4613:20763: scene=SP1
#: SP1:4613
msgctxt "text_id=20763 | speaker=unknown"
msgid "  Touko failed to notice Beo's poor mood and left the old school building in her usual carefree mood."
msgstr "　ベオの不機嫌さに気付かず、橙子は緩みきった足取りで旧校舎を後にした。"

#. Occurrence SP1:4618:20764: scene=SP1
#: SP1:4618
msgctxt "text_id=20764 | speaker=unknown"
msgid "  This was how it'd been for days now."
msgstr "　ここ数日、ずっとこれの繰り返しである。"

#. Occurrence SP1:4660:20765: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0045; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4660
msgctxt "text_id=20765 | speaker=beo"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence SP1:4665:20766: scene=SP1
#: SP1:4665
msgctxt "text_id=20766 | speaker=unknown"
msgid "  Beo stared at his own reflection in the window and contemplated for a while."
msgstr "　窓硝子に映った自分の姿を見て、ベオはしばし思案した。"

#. Occurrence SP1:4670:20767: scene=SP1
#: SP1:4670
msgctxt "text_id=20767 | speaker=unknown"
msgid "  Unfortunately, this wouldn't solve anything."
msgstr "　これでは何の解決にもならない。"

#. Occurrence SP1:4675:20768: scene=SP1
#: SP1:4675
msgctxt "text_id=20768 | speaker=unknown"
msgid "  It wouldn't change the fact that his employer was still acting strangely,"
msgstr "　雇い主の様子がおかしいのはタダさねばならないし、"

#. Occurrence SP1:4680:20769: scene=SP1
#: SP1:4680
msgctxt "text_id=20769 | speaker=unknown"
msgid "  and it wouldn't get rid of the uncertainty he was constantly feeling in his chest."
msgstr "　胸に湧いたこのモヤモヤも晴らさないと楽しくない。"

#. Occurrence SP1:4715:20770: scene=SP1
#: SP1:4715
msgctxt "text_id=20770 | speaker=unknown"
msgid "  He knew he didn't have much other choice."
msgstr "　金色の生き物は仕方あるまい、と鹿爪らしく頷いて、"

#. Occurrence SP1:4722:20771: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0046; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4722
msgctxt "text_id=20771 | speaker=beo"
msgid "\"I guess I'll just tail her.\""
msgstr "「よし。トーコさんを尾行しよう」"

#. Occurrence SP1:4728:20772: scene=SP1
#: SP1:4728
msgctxt "text_id=20772 | speaker=unknown"
msgid "  He decided to let go of his principles for just this one day."
msgstr "　今日一日だけ、自分の信条を<隅|すみ>に追いやるコトにした。"

#. Occurrence SP1:4790:20773: scene=SP1
#: SP1:4790
msgctxt "text_id=20773 | speaker=unknown"
msgid "\"They say winter's going to be colder than usual this year.\""
msgstr "“今年の冬の寒さは、例年より厳しくなるらしい。”"

#. Occurrence SP1:4795:20774: scene=SP1
#: SP1:4795
msgctxt "text_id=20774 | speaker=unknown"
msgid "\"Make sure you've got sufficient food, clothing, and shelter.\""
msgstr "“衣食住の備えは万全に。”"

#. Occurrence SP1:4800:20775: scene=SP1
#: SP1:4800
msgctxt "text_id=20775 | speaker=unknown"
msgid "\"We should be fine on clothing, but make sure to shore up the other two.\""
msgstr "“僕らに衣は関係ないけど、残り二つは大切だよ。”"

#. Occurrence SP1:4806:20776: scene=SP1
#: SP1:4806
msgctxt "text_id=20776 | speaker=unknown"
msgid "  He listened to the talk around town as he passed through Misaki."
msgstr "　そんな世間話を聞きながら、カレは三咲町を横断する。"

#. Occurrence SP1:4835:20777: scene=SP1
#: SP1:4835
msgctxt "text_id=20777 | speaker=unknown"
msgid "  It was just past one in the afternoon on a weekday."
msgstr "　平日の午後一時過ぎ。"

#. Occurrence SP1:4840:20778: scene=SP1
#: SP1:4840
msgctxt "text_id=20778 | speaker=unknown"
msgid "  Workers had returned to the office after their lunch breaks, and the kids were all still in school."
msgstr "　会社員は昼休みを終えてオフィスビルへ、学生たちはまだ学校で授業中だ。"

#. Occurrence SP1:4845:20779: scene=SP1
#: SP1:4845
msgctxt "text_id=20779 | speaker=unknown"
msgid "  The main street was fairly calm and relaxed with mostly housewives out and about."
msgstr "　人混みは主婦が中心で、大通りはどことなくまったりとした雰囲気だった。"

#. Occurrence SP1:4878:20780: scene=SP1
#: SP1:4878
msgctxt "text_id=20780 | speaker=unknown"
msgid "  Yet one person stood out in this calm and gentle sea of people."
msgstr "　そんな穏やかな世界に、不穏な異分子がひとり。"

#. Occurrence SP1:4883:20781: scene=SP1
#: SP1:4883
msgctxt "text_id=20781 | speaker=unknown"
msgid "  Touko endured the stares of the housewives out shopping, salespeople in their shops, and salarymen out on business as she walked through the main street."
msgstr "　買い物中の奥さま方、売店の店員、外回りのサラリーマン等から様々な視線を浴びながら、蒼崎橙子はどこ吹く風で大通りを闊歩する。"

#. Occurrence SP1:4888:20782: scene=SP1
#: SP1:4888
msgctxt "text_id=20782 | speaker=unknown"
msgid "  It wasn't just her sense of style that stood out, but also her generally powerful presence that attracted eyes."
msgstr "　目立つ服装はもとより、彼女本人の“姿勢の強さ”が人目を惹くのだろう。"

#. Occurrence SP1:4893:20783: scene=SP1
#: SP1:4893
msgctxt "text_id=20783 | speaker=unknown"
msgid "  To put it simply, she walked with the confidence of a model on the runway."
msgstr "　俗に言う、モデル歩きというヤツである。"

#. Occurrence SP1:4934:20784: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0047; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:4934
msgctxt "text_id=20784 | speaker=beo"
msgid "(She's always telling me to try not to stand out, but look at her! It won't be only my fault if we're discovered...)"
msgstr "「“……人には目立つなって言うクセに、本人はアレだもんなあ。潜伏期間中、相手に見つかるのはボクだけのせいじゃないと思う……”」"

#. Occurrence SP1:4940:20785: scene=SP1
#: SP1:4940
msgctxt "text_id=20785 | speaker=unknown"
msgid "  Beo kept about ten yards behind Touko, careful not to actually mutter the words he was thinking in his head."
msgstr "　なんて、言いたいコトをぐっと堪えながらカレは雇い主の後方、十メートルの位置をキープする。"

#. Occurrence SP1:4963:20786: scene=SP1
#: SP1:4963
msgctxt "text_id=20786 | speaker=unknown"
msgid "  In Touko's defense, she was fully aware of how much she stood out in a crowd."
msgstr "　橙子本人の名誉の為に注釈しておくと、彼女とて自分がどれほど目立つか理解している。"

#. Occurrence SP1:4968:20787: scene=SP1
#: SP1:4968
msgctxt "text_id=20787 | speaker=unknown"
msgid "  If she was out at a busier time of day, she always wore an accessory inscribed with a rune that diverted people's attention away from her and made her stand out approximately forty percent less."
msgstr "　今は人通りの少ない時間帯なのですっぴんだが、学生や社会人が多くなる時間帯では視線よけのルーンを刻んだ<装飾|アクセ>できらびやかさを四割ほど落としているのだ。"

#. Occurrence SP1:5002:20788: scene=SP1
#: SP1:5002
msgctxt "text_id=20788 | speaker=unknown"
msgid "  Touko finished up her shopping and headed toward the residential part of town."
msgstr "　蒼崎橙子は商店街でいくつか買い物を済ませた後、住宅地に向かった。"

#. Occurrence SP1:5007:20789: scene=SP1
#: SP1:5007
msgctxt "text_id=20789 | speaker=unknown"
msgid "  She walked up to a house that looked completely normal, "
msgstr "　彼女は何の変哲もない一般家屋を訪問した。"

#. Occurrence SP1:5012:20790: scene=SP1
#: SP1:5012
msgctxt "text_id=20790 | speaker=unknown"
msgid "  rang the doorbell and, after stating her name, the door opened quietly."
msgstr "　ベルを押し、「蒼崎橙子です」と告げると、門は静かに開かれた。"

#. Occurrence SP1:5017:20791: scene=SP1
#: SP1:5017
msgctxt "text_id=20791 | speaker=unknown"
msgid "  It looked as though the things she had bought were for the resident of this house."
msgstr "　どうも、商店街の買い物はこの家への土産であるらしい。"

#. Occurrence SP1:5050:20792: scene=SP1
#: SP1:5050
msgctxt "text_id=20792 | speaker=unknown"
msgid "  The nameplate outside read \"Asagi.\""
msgstr "　表札には<浅葱|あさぎ>とある。"

#. Occurrence SP1:5055:20793: scene=SP1
#: SP1:5055
msgctxt "text_id=20793 | speaker=unknown"
msgid "  Misaki was in the mountains. But, for just a moment, Beo got a whiff of sea brine."
msgstr "　ふと、<潮|しお>の匂いがする、とカレは感じ取ったが、三咲町は山間の街だ。"

#. Occurrence SP1:5060:20794: scene=SP1
#: SP1:5060
msgctxt "text_id=20794 | speaker=unknown"
msgid "  Assuming he must have just mistaken it for some other smell, he put it out of his mind."
msgstr "　こんなところに潮の匂いが在るのはおかしい、何か別の匂いだろう、とカレは忘れるコトにした。"

#. Occurrence SP1:5094:20795: scene=SP1
#: SP1:5094
msgctxt "text_id=20795 | speaker=unknown"
msgid "  Touko came out of the house after about thirty minutes."
msgstr "　橙子は三十分ほどで出てきた。"

#. Occurrence SP1:5099:20796: scene=SP1
#: SP1:5099
msgctxt "text_id=20796 | speaker=unknown"
msgid "  She stretched her arms above her head and took a deep breath. Whatever had gone on inside seemed to have been rather serious."
msgstr "　彼女の中ではわりと重い案件だったのか、家から出るなり両腕を空に伸ばして深呼吸をする。"

#. Occurrence SP1:5104:20797: scene=SP1
#: SP1:5104
msgctxt "text_id=20797 | speaker=unknown"
msgid "  It was as if a weight had been lifted from her shoulders."
msgstr "　肩の荷を下ろすような、そんな伸びだった。"

#. Occurrence SP1:5125:20798: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0063; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5125
msgctxt "text_id=20798 | speaker=touko"
msgid "\"That takes care of those negotiations, at least."
msgstr "「これで根回しは終了、っと。"

#. Occurrence SP1:5131:20799: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0064; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5131
msgctxt "text_id=20799 | speaker=touko"
msgid "  Now all that's left is a final reminder...\""
msgstr "　後は―――最後の念押しね。ああ、面倒くさい」"

#. Occurrence SP1:5137:20800: scene=SP1
#: SP1:5137
msgctxt "text_id=20800 | speaker=unknown"
msgid "  Touko murmured, exasperated."
msgstr "　やれやれと呟く橙子。"

#. Occurrence SP1:5142:20801: scene=SP1
#: SP1:5142
msgctxt "text_id=20801 | speaker=unknown"
msgid "  But lurking behind her words, Beo could still detect that lofty scent emanating from her mouth."
msgstr "　が。口調とは裏腹に、口元からはやっぱり例の、浮わ浮わした匂いがするのであった。"

#. Occurrence SP1:5187:20802: scene=SP1
#: SP1:5187
msgctxt "text_id=20802 | speaker=unknown"
msgid "  Her next stop was another plain-looking apartment."
msgstr "　橙子が次に向かったのは、何の変哲もないアパートだった。"

#. Occurrence SP1:5192:20803: scene=SP1
#: SP1:5192
msgctxt "text_id=20803 | speaker=unknown"
msgid "  It looked as though she had just happened to walk by, but Beo's nose was not so easily deceived."
msgstr "　傍目には偶然通りかかったように見えるが、カレの鼻は誤魔化せない。"

#. Occurrence SP1:5197:20804: scene=SP1
#: SP1:5197
msgctxt "text_id=20804 | speaker=unknown"
msgid "  Touko made it look like she was just aimlessly killing time, but she had in fact arranged to arrive at the apartment at exactly 2:30 PM."
msgstr "　橙子は散歩するような素振りで時間を調整し、午後二時三十分、きっちりとこの時間に合わせてアパートにやってきたのだ。"

#. Occurrence SP1:5217:20805: scene=SP1
#: SP1:5217
msgctxt "text_id=20805 | speaker=unknown"
msgid "  In the parking lot of the apartment..."
msgstr "　そうして、アパートの駐車場には、"

#. Occurrence SP1:5234:20806: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0000; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5234
msgctxt "text_id=20806 | speaker=ritsuka"
msgid "\"Huh?\""
msgstr "「へ？」"

#. Occurrence SP1:5239:20807: scene=SP1
#: SP1:5239
msgctxt "text_id=20807 | speaker=unknown"
msgid "  Ritsuka Suse stepped out of a room on the first floor."
msgstr "　たったいま一階の部屋から出てきた、<周瀬|すせ><律架|りつか>の姿があった。"

#. Occurrence SP1:5272:20808: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0065; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5272
msgctxt "text_id=20808 | speaker=touko"
msgid "\"Hey, long time no see!"
msgstr "「はあい、お久しぶり。"

#. Occurrence SP1:5272:20809: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0065; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5272
msgctxt "text_id=20809 | speaker=touko"
msgid "  Fancy seeing you here, Ritsuka!\""
msgstr "　こんなところでバッタリ出会うなんて奇遇ね、律架」"

#. Occurrence SP1:5290:20810: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0001; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5290
msgctxt "text_id=20810 | speaker=ritsuka"
msgid "\"No way! Is that you, Toko?! You're back in town?\""
msgstr "「うそ、トコちゃん！？　貴女、帰ってきてたの！？」"

#. Occurrence SP1:5326:20811: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0066; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5326
msgctxt "text_id=20811 | speaker=touko"
msgid "\"Yeah, since a little bit ago. I've been hiding out and laying low."
msgstr "「ええ。ちょっと前にね、こっそり、人目を忍ぶように、窓から侵入するサンタクロースさながらに。"

#. Occurrence SP1:5338:20812: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0067; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5338
msgctxt "text_id=20812 | speaker=touko"
msgid "  It goes without saying that I'm here to crush this town, of course."
msgstr "　あ、言うまでもなく目的はこの町をぶっ潰すコト。"

#. Occurrence SP1:5338:20813: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0067; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5338
msgctxt "text_id=20813 | speaker=touko"
msgid "  I've come totally prepared to wipe the slate clean of my past this time."
msgstr "　私の過去共々キレイさっぱり清算するため、この度、準備万端でやってまいりました。"

#. Occurrence SP1:5350:20814: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0068; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5350
msgctxt "text_id=20814 | speaker=touko"
msgid "  That's why I'm going to get this done before anyone from the Association or Church can stand in my way!\""
msgstr "　なのでぇー。邪魔になる協会の人間とか教会の人間とか、気付かれる前にやっちゃうぞ☆」"

#. Occurrence SP1:5377:20815: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0002; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5377
msgctxt "text_id=20815 | speaker=ritsuka"
msgid "\"Well, how kind of you... Wait."
msgstr "「あらあら、それはご丁寧にどうも……って、"

#. Occurrence SP1:5389:20816: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0003; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5389
msgctxt "text_id=20816 | speaker=ritsuka"
msgid "  Are you talking about ME?"
msgstr "　トコちゃん、それわたしのことー！"

#. Occurrence SP1:5389:20817: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0003; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5389
msgctxt "text_id=20817 | speaker=ritsuka"
msgid "  I'm the only one in the Association now, you know!\""
msgstr "　協会の人間って、いまわたししかいないんですけどー！」"

#. Occurrence SP1:5400:20818: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0069; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5400
msgctxt "text_id=20818 | speaker=touko"
msgid "\"Oh, how strange! Or maybe that's lucky for me?"
msgstr "「あら不思議。むしろラッキー？"

#. Occurrence SP1:5400:20819: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0069; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5400
msgctxt "text_id=20819 | speaker=touko"
msgid "  To think I'd run into one of my targets while out here on a walk like this. I guess that saves me some trouble, huh?\""
msgstr "　懐かしくて散歩していたら、まさか標的の一人に出遭うなんて。ひとつ手間が省けた感じ？」"

#. Occurrence SP1:5436:20820: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0004; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5436
msgctxt "text_id=20820 | speaker=ritsuka"
msgid "\"I've got nothing to do with the Association, I swear!"
msgstr "「関係ないのー！　わたし、協会と関係ないからー！"

#. Occurrence SP1:5448:20821: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0005; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5448
msgctxt "text_id=20821 | speaker=ritsuka"
msgid "  I haven't done any serious work in a year or more!"
msgstr "　だってここ一年、真面目に仕事してないし！"

#. Occurrence SP1:5459:20822: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0006; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5459
msgctxt "text_id=20822 | speaker=ritsuka"
msgid "  Please don't tell me you're here to kill me! We were like brothers-in-training, right? Please don't!\""
msgstr "　というか、仮にも兄弟子をつかまえて本気で殺すとか言わないでほしいですー！」"

#. Occurrence SP1:5492:20823: scene=SP1
#: SP1:5492
msgctxt "text_id=20823 | speaker=unknown"
msgid "  The woman was tearfully flailing her arms at this point."
msgstr "　アパートから現れた女性は、わたわたと涙目で手を振り回す。"

#. Occurrence SP1:5497:20824: scene=SP1
#: SP1:5497
msgctxt "text_id=20824 | speaker=unknown"
msgid "  She had nothing to worry about, though."
msgstr "　が、それは無用の心配だ。"

#. Occurrence SP1:5502:20825: scene=SP1
#: SP1:5502
msgctxt "text_id=20825 | speaker=unknown"
msgid "  Beo could see even from where he was peering through the fence that Touko had no real intent to kill anyone."
msgstr "　向かいの家の塀の穴から覗いているカレからしてみれば、橙子の殺気は偽物である。"

#. Occurrence SP1:5507:20826: scene=SP1
#: SP1:5507
msgctxt "text_id=20826 | speaker=unknown"
msgid "  She had a terrible habit of messing with people for her own entertainment; this time was no different."
msgstr "　蒼崎橙子は、常からして他人をからかって愉しむ癖のある、たいへん困った女性だ。"

#. Occurrence SP1:5512:20827: scene=SP1
#: SP1:5512
msgctxt "text_id=20827 | speaker=unknown"
msgid "  Unfortunately, the pleasure she took in it only made the target of her jokes feel doubly worse."
msgstr "　その困ったところが、あの相手に対しては二倍増しで表れているだけらしい。"

#. Occurrence SP1:5556:20828: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0070; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5556
msgctxt "text_id=20828 | speaker=touko"
msgid "\"...Hah. At least say we're like sisters.\""
msgstr "「……はあ。それを言うなら姉弟子でしょ」"

#. Occurrence SP1:5568:20829: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0007; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5568
msgctxt "text_id=20829 | speaker=ritsuka"
msgid "\"Whaaat? But Toko, you don't feel like a little sister at all! I'd never dare call myself your big sister!\""
msgstr "「えー。だってトコちゃん、妹って感じしないんだもん。間違っても姉弟子、なんて胸を張って言えませんっ」"

#. Occurrence SP1:5580:20830: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0071; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5580
msgctxt "text_id=20830 | speaker=touko"
msgid "\"True enough. You don't have the skills to claim to be my senior, to begin with. If I had to describe what you're good at, it's even worse than those dumb late-night infomercial products these days. Have you thought about a career change? I can refer you to a good place. There's this old and nearly bankrupt circus in Italy that's hiring.\""
msgstr "「そうよね。技量的にも、とても先輩なんて言えるものじゃなかったし。律架の特技なんて、今じゃ深夜販売の商品以下だし。そろそろ職替え考えたら？　いいとこ紹介するよ。イタリアで見付けた、もう廃業寸前のサーカス一座とかどう？」"

#. Occurrence SP1:5621:20831: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0008; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5621
msgctxt "text_id=20831 | speaker=ritsuka"
msgid "\"I've had enough of per diem work, thank you very much!"
msgstr "「そんな日給バイトはこりごりです！"

#. Occurrence SP1:5621:20832: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0008; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5621
msgctxt "text_id=20832 | speaker=ritsuka"
msgid "  Find me something with at least a weekly salary!\""
msgstr "　せめて週給のところを紹介して！」"

#. Occurrence SP1:5627:20833: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0072; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5627
msgctxt "text_id=20833 | speaker=touko"
msgid "\"...Wow, you aren't even denying that you're worse than a mail-order doodad.\""
msgstr "「……うわあ。通販以下ってところは否定しないんだ」"

#. Occurrence SP1:5639:20834: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0009; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5639
msgctxt "text_id=20834 | speaker=ritsuka"
msgid "\"Why would I? You're totally right."
msgstr "「なぜ？　トコちゃんの指摘は正しいわ。"

#. Occurrence SP1:5651:20835: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0010; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5651
msgctxt "text_id=20835 | speaker=ritsuka"
msgid "  I'm completely useless!"
msgstr "　だってわたし、何もできない役立たずですから。"

#. Occurrence SP1:5651:20836: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0010; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5651
msgctxt "text_id=20836 | speaker=ritsuka"
msgid "  That's me, the Mage's Association's most worthless piece of baggage!\""
msgstr "　魔術協会いちのお荷物、ここに参上～♪」"

#. Occurrence SP1:5691:20837: scene=SP1
#: SP1:5691
msgctxt "text_id=20837 | speaker=unknown"
msgid "  Maybe she was taken aback by Ritsuka's guileless smile, but Touko couldn't help but grin back at her."
msgstr "　ぽやぽやした笑顔に毒気を抜かれたのか、橙子もつられて微笑む。"

#. Occurrence SP1:5696:20838: scene=SP1
#: SP1:5696
msgctxt "text_id=20838 | speaker=unknown"
msgid "  If one didn't know better, they would seem like good friends."
msgstr "　傍目には<和|わ><気|き><藹々|あいあい>とした関係だ。"

#. Occurrence SP1:5739:20839: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0011; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5739
msgctxt "text_id=20839 | speaker=ritsuka"
msgid "\"I guess that clears up any suspicions you might have had about me."
msgstr "「あ、わたしへの疑いは解けたとみたわ。"

#. Occurrence SP1:5751:20840: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0012; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5751
msgctxt "text_id=20840 | speaker=ritsuka"
msgid "  And if that's the case, do you want to come in for a bit? I have some things I need to get done, but I can do them later. It's been such a long time, and I'd like to catch up.\""
msgstr "　それなら寄ってく？　これから用事があったんだけど、別に後回しでいいし。久しぶりだもの、お互いつもる話とか楽しそうじゃない？」"

#. Occurrence SP1:5778:20841: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0073; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5778
msgctxt "text_id=20841 | speaker=touko"
msgid "\"You're as easygoing as ever."
msgstr "「ほんと、相変わらずゆるゆるね律架は。"

#. Occurrence SP1:5784:20842: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0074; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5784
msgctxt "text_id=20842 | speaker=touko"
msgid "  You're right. You've convinced me. You clearly don't have anything going on with the Association, and you're upholding your own principles."
msgstr "　たしかに気が変わったわ。その様子じゃ協会との関係なんて無いようなものだし、貴女は貴女の信条を守っているようだし。"

#. Occurrence SP1:5790:20843: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0075; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5790
msgctxt "text_id=20843 | speaker=touko"
msgid "  ...So you're really on Aoko's side, huh?\""
msgstr "　―――そう、本気で青子の味方なんだ」"

#. Occurrence SP1:5817:20844: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0013; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5817
msgctxt "text_id=20844 | speaker=ritsuka"
msgid "\"Of course! She's still learning the ropes."
msgstr "「もっちろん！　アコちゃんはまだ半人前ですもの。"

#. Occurrence SP1:5829:20845: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0014; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5829
msgctxt "text_id=20845 | speaker=ritsuka"
msgid "  I just watch over her from a distance. Nothing more, nothing less.\""
msgstr "　付かず離れず、あくまで他人行儀に、アコちゃんが死ぬような目にあっても遠くから見守るわ」"

#. Occurrence SP1:5841:20846: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0076; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5841
msgctxt "text_id=20846 | speaker=touko"
msgid "\"That's fine then. She's lucky to have someone like you that understands her.\""
msgstr "「それは結構。青子もホント、いい性格をした理解者に恵まれたもんだ」"

#. Occurrence SP1:5866:20847: scene=SP1
#: SP1:5866
msgctxt "text_id=20847 | speaker=unknown"
msgid "  Touko took a step back, away from Ritsuka."
msgstr "　橙子は一歩、周瀬律架から身を引いた。"

#. Occurrence SP1:5871:20848: scene=SP1
#: SP1:5871
msgctxt "text_id=20848 | speaker=unknown"
msgid "  She looked a bit regretful as she signaled that the conversation was over."
msgstr "　やや名残惜しげな顔が、話はここで終わりである事を示している。"

#. Occurrence SP1:5904:20849: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0015; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5904
msgctxt "text_id=20849 | speaker=ritsuka"
msgid "\"Oh, you're not coming inside?"
msgstr "「あれ、寄っていかないの？"

#. Occurrence SP1:5910:20850: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0016; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5910
msgctxt "text_id=20850 | speaker=ritsuka"
msgid "  I pour a pretty good cup of coffee nowadays.\""
msgstr "　わたし、コーヒー淹れるの上手くなったよ？」"

#. Occurrence SP1:5928:20851: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0077; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5928
msgctxt "text_id=20851 | speaker=touko"
msgid "\"Thanks, but I'll have to pass. I'm still laying low, and I have a lot to do before I take over this town."
msgstr "「ありがとう。けど遠慮しとく。こっちはまだ潜伏中だし、街攻略の準備もあるしね。"

#. Occurrence SP1:5928:20852: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0077; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:5928
msgctxt "text_id=20852 | speaker=touko"
msgid "  I shouldn't relax too much just yet.\""
msgstr "　ここで緊張感をなくすのは<上|う><手|ま>くないでしょ」"

#. Occurrence SP1:5964:20853: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0017; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5964
msgctxt "text_id=20853 | speaker=ritsuka"
msgid "\"Well, aren't we the hard worker?"
msgstr "「あらまあ、真面目さん。"

#. Occurrence SP1:5976:20854: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0018; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5976
msgctxt "text_id=20854 | speaker=ritsuka"
msgid "  But you've always been like that. You always were one to focus on the process more than the goal."
msgstr "　でもそうよね、トコちゃんはそういう人でした。根を詰めすぎて、目的より手段そのものに熱中しちゃうタイプ。"

#. Occurrence SP1:5982:20855: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0019; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:5982
msgctxt "text_id=20855 | speaker=ritsuka"
msgid "  I've no idea what kind of preparations you're up to, but I feel sorry for whoever it is you're going after.\""
msgstr "　ほーんと、どんな準備かは分からないけど、トコちゃんに狙われる人たちはたいへんだ」"

#. Occurrence SP1:6008:20856: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0078; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6008
msgctxt "text_id=20856 | speaker=touko"
msgid "\"Eh, it's just the usual. We'll have a magecraft battle, the victor will take the other's Crest, and that'll be it."
msgstr "「ん？　別に普通でしょ？　基本、魔術戦やって、こっちが勝ったら刻印を貰うだけ。"

#. Occurrence SP1:6014:20857: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0079; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6014
msgctxt "text_id=20857 | speaker=touko"
msgid "  I'm not an old-fashioned witch. I'm not going to put a curse on whoever I defeat in battle, you know?\""
msgstr "　時代遅れの魔女じゃあるまいし、倒した相手に呪いとかかけないわよ、私？」"

#. Occurrence SP1:6049:20858: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0020; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6049
msgctxt "text_id=20858 | speaker=ritsuka"
msgid "\"That's exactly what I'm talking about, though."
msgstr "「だからそこです。"

#. Occurrence SP1:6055:20859: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0021; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6055
msgctxt "text_id=20859 | speaker=ritsuka"
msgid "  You're more interested in collecting their Crest than their life."
msgstr "　相手の命より収集を優先してるじゃない。"

#. Occurrence SP1:6066:20860: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0022; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6066
msgctxt "text_id=20860 | speaker=ritsuka"
msgid "  I'd just feel sorry for them if that became their sole purpose in life."
msgstr "　その人たち、目玉だけになっても生きている、なんてコトにならなければいいけど。"

#. Occurrence SP1:6077:20861: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0023; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6077
msgctxt "text_id=20861 | speaker=ritsuka"
msgid "  You might think you're going easy on them, but that's like living under constant torture.\""
msgstr "　貴女は気を<遣|つか>っているつもりだろうけど、相手にとっては拷問だからね、それ」"

#. Occurrence SP1:6115:20862: scene=SP1
#: SP1:6115
msgctxt "text_id=20862 | speaker=unknown"
msgid "  Touko nodded to show her agreement."
msgstr "　なるほど、と橙子は頷いた。"

#. Occurrence SP1:6120:20863: scene=SP1
#: SP1:6120
msgctxt "text_id=20863 | speaker=unknown"
msgid "  Her collection of Crests would appear that way on the outside."
msgstr "　自分の収集癖は、傍目にはそう映るのかと。"

#. Occurrence SP1:6179:20864: scene=SP1
#: SP1:6179
msgctxt "text_id=20864 | speaker=unknown"
msgid "  Touko sought profit in combat."
msgstr "　蒼崎橙子は戦闘に利益を求める。"

#. Occurrence SP1:6184:20865: scene=SP1
#: SP1:6184
msgctxt "text_id=20865 | speaker=unknown"
msgid "  If a mage she defeated could provide her with profitable materials, she would not take their life."
msgstr "　敵対した魔術師を倒した後、彼らが有益な素材を提供してくれるのなら命までは奪わない。"

#. Occurrence SP1:6189:20866: scene=SP1
#: SP1:6189
msgctxt "text_id=20866 | speaker=unknown"
msgid "  She would even save their life if she knew it would be to her advantage to do so."
msgstr "　むしろ、ギブアンドテイクとばかりに無理やり命を助けさえする。"

#. Occurrence SP1:6194:20867: scene=SP1
#: SP1:6194
msgctxt "text_id=20867 | speaker=unknown"
msgid "  As a result, her workshop in London had a facility specifically built for the \"comfort\" of her magical suppliers."
msgstr "　結果、ロンドンの彼女の工房には『術式提供者用・慰安施設』なるものが出来てしまった。"

#. Occurrence SP1:6199:20868: scene=SP1
#: SP1:6199
msgctxt "text_id=20868 | speaker=unknown"
msgid "  It housed mages who had either lost to her in battle or who had willingly agreed to contribute to her cause."
msgstr "　彼女に敗れた、あるいは自分から協力者になった魔術師たちの棲む魔窟である。"

#. Occurrence SP1:6219:20869: scene=SP1
#: SP1:6219
msgctxt "text_id=20869 | speaker=unknown"
msgid "  Touko held many magecraft patents which earned her up to 10,000 pounds a month in royalties. However, the majority of this money went to the upkeep of that facility."
msgstr "　現在、多くの魔術特許を持ち、月の収入が１万ポンドを超える橙子だが、大半はその施設の維持に充てられている。"

#. Occurrence SP1:6224:20870: scene=SP1
#: SP1:6224
msgctxt "text_id=20870 | speaker=unknown"
msgid "  The demands from the residents of the place for additional facilities and special privileges increased with every passing day. It was reaching a point where Touko needed to decide whether to incorporate or just let everyone go and be done with it."
msgstr "　棲みついた魔術師たちの要望―――追加施設、特別待遇を望む声は日に日に増しており、いいかげん会社を<興|おこ>すか、あるいは全員<釈|ク><放|ビ>にするかと、悩み多い橙子だった。"

#. Occurrence SP1:6271:20871: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0080; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6271
msgctxt "text_id=20871 | speaker=touko"
msgid "\"I promise, it's nothing nefarious or evil like a dungeon."
msgstr "「でも、誓って<拷問室|そういうもの>じゃないわよ？"

#. Occurrence SP1:6277:20872: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0081; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6277
msgctxt "text_id=20872 | speaker=touko"
msgid "  Torture is too much work anyway. It actually costs less to just entertain them."
msgstr "　拷問なんて手間暇かかりすぎるし。娯楽を与える方が管理コストは低いんだってば。"

#. Occurrence SP1:6283:20873: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0082; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6283
msgctxt "text_id=20873 | speaker=touko"
msgid "  There are so many good stories out there these days. I can just steal the plot of something and recreate it to make everyone happy."
msgstr "　<現代|いま>はいい脚本そろってるしね。適当な映画のプロットを拝借して、それを再現するだけで喜んでもらえるし。"

#. Occurrence SP1:6289:20874: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0083; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6289
msgctxt "text_id=20874 | speaker=touko"
msgid "  Real or fake, everyone wants to be the hero of their own story.\""
msgstr "　仮想であれ現実であれ、自分が主役になれる物語なんて最高じゃない」"

#. Occurrence SP1:6326:20875: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0024; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6326
msgctxt "text_id=20875 | speaker=ritsuka"
msgid "\"Hmm, just out of curiosity, what's the ratio of the genres you use?"
msgstr "「ふーん。つかぬ事をお伺いいたしますけど、上演ジャンルはどのようなバランスで？"

#. Occurrence SP1:6332:20876: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0025; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6332
msgctxt "text_id=20876 | speaker=ritsuka"
msgid "  30% romance, 30% action, 30% suspense, 10% cartoons?\""
msgstr "　恋愛３、活劇３、サスペンス３、アニメ１？」"

#. Occurrence SP1:6338:20877: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0084; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6338
msgctxt "text_id=20877 | speaker=touko"
msgid "\"Huh? Basically only horror, actually. Horror films have every element you could ever want!\""
msgstr "「は？　そりゃ、基本ホラーでしょ。エンタメのすべてが詰まってるんだし」"

#. Occurrence SP1:6350:20878: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0026; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6350
msgctxt "text_id=20878 | speaker=ritsuka"
msgid "\"...You know, that was always the part of you that scared me the most."
msgstr "「……。わたし、トコちゃんのそういうところ、素で怖いわ。"

#. Occurrence SP1:6356:20879: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0027; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6356
msgctxt "text_id=20879 | speaker=ritsuka"
msgid "  You're a girl. You should be more into romance instead of that kinda stuff!\""
msgstr "　というか、女の子なんだからもっとロマンを求めてほしいの」"

#. Occurrence SP1:6391:20880: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0085; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6391
msgctxt "text_id=20880 | speaker=touko"
msgid "\"Hmph. I guess it's something I should consider if one of my potential targets says as much."
msgstr "「む。今回<捕|つか>まえる候補にあがっている人間に言われると、さすがに考慮せざるをえない。"

#. Occurrence SP1:6397:20881: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0086; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6397
msgctxt "text_id=20881 | speaker=touko"
msgid "  Let's see, how does 80% horror sound for the balance of the virtual worlds I throw my prisoners into?\""
msgstr "　んー、囚人を放り込む<仮|は><想|こ><現|に><実|わ>の、バランスに気を遣ってみればいいの？　ホラー８ぐらい？」"

#. Occurrence SP1:6415:20882: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0028; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6415
msgctxt "text_id=20882 | speaker=ritsuka"
msgid "\"90% romance! Come on, please! If not romance, do 90% mystery!\""
msgstr "「恋愛９！　恋愛９でお願いします！　それがダメなら推理９で是非！」"

#. Occurrence SP1:6421:20883: scene=SP1
#: SP1:6421
msgctxt "text_id=20883 | speaker=unknown"
msgid "  This was clearly a response from someone who knew she'd lose if she had to go up against Touko."
msgstr "　橙子に狙われた場合、絶対に負けると信じきった上での即答だった。"

#. Occurrence SP1:6455:20884: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0087; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6455
msgctxt "text_id=20884 | speaker=touko"
msgid "\"Very well. If that situation should ever arise, I'll try to accommodate you.\""
msgstr "「了解、そういう事態になったら善処する」"

#. Occurrence SP1:6467:20885: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0029; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6467
msgctxt "text_id=20885 | speaker=ritsuka"
msgid "\"Yes! Wait, what situation?\""
msgstr "「はーい。そういう事態って、どんな事態？」"

#. Occurrence SP1:6478:20886: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0088; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6478
msgctxt "text_id=20886 | speaker=touko"
msgid "\"It's fine if you're friends with you-know-who, but I'm talking about if you ever become my enemy. Also, if you tell anyone about our conversation today, I'll snap you up from below before you can even blink.\""
msgstr "「誰かの味方をするのはいいけど、私の敵に回った時、かな。あと今日の事を口外した瞬間、足下からパクッといくから気をつけて」"

#. Occurrence SP1:6517:20887: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0030; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6517
msgctxt "text_id=20887 | speaker=ritsuka"
msgid "\"Huh? From below? Like, out of my shadow?"
msgstr "「へ？　足下って、影のこと？"

#. Occurrence SP1:6530:20888: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0031; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6530
msgctxt "text_id=20888 | speaker=ritsuka"
msgid "  But more important than that, Touko..."
msgstr "　あ―――あれ。そもそもなんていうか、トコちゃん。"

#. Occurrence SP1:6538:20889: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0032; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6538
msgctxt "text_id=20889 | speaker=ritsuka"
msgid "  I can't move an inch!\""
msgstr "　わたし、一歩も動けないんだけどー！」"

#. Occurrence SP1:6560:20890: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0089; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6560
msgctxt "text_id=20890 | speaker=touko"
msgid "\"Hehehe. Sorry Ritsuka, but I actually spent a week setting a trap in your place."
msgstr "「ふふふ、ごめんなさい律架。実は一週間かけて、貴女の部屋に罠をしかけてたの。"

#. Occurrence SP1:6566:20891: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0090; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6566
msgctxt "text_id=20891 | speaker=touko"
msgid "  I made a familiar out of a shadow and put it in your doorway. It's going to be living in your shadow for a while, so try not say anything to inconvenience me."
msgstr "　ドアの境界に影で作った使い魔を仕込ませた、みたいな？　しばらくは貴女の影に棲みついているから、私に不利な証言したらたいへんだぞ"

#. Occurrence SP1:6566:20892: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0090; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6566
msgctxt "text_id=20892 | speaker=touko"
msgid "\""
msgstr "」"

#. Occurrence SP1:6601:20893: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0033; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6601
msgctxt "text_id=20893 | speaker=ritsuka"
msgid "\"You mean I've been in a pickle all along?!"
msgstr "「わたし、すでにたいへんだったのかー！"

#. Occurrence SP1:6612:20894: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0034; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6612
msgctxt "text_id=20894 | speaker=ritsuka"
msgid "  Toko, you devil! You brute! You devil-brute! You need to learn some common sense! I knew I heard something the other night! I just thought it was a thief trying to pick my lock!\""
msgstr "　悪魔！　人でなし！　天才悪魔！　トコちゃんはもう少し一般常識を学ぶべきです！　もう、どうりで夜な夜な泥棒さんがピッキングしてると思った！」"

#. Occurrence SP1:6647:20895: scene=SP1
#: SP1:6647
msgctxt "text_id=20895 | speaker=unknown"
msgid "  Ritsuka hadn't noticed the shadow familiar, but she had sensed Touko as she was setting her trap late at night."
msgstr "　影の使い魔には気付かなかったものの、深夜、細工をしている橙子の気配には気付いていたらしい。"

#. Occurrence SP1:6652:20896: scene=SP1
#: SP1:6652
msgctxt "text_id=20896 | speaker=unknown"
msgid "  Touko didn't think Ritsuka could speak about common sense, since she had ignored an apparent burglar trying to break into her home for a week."
msgstr "　ただの泥棒と思ってスルーし続けるあたり、律架に一般常識を問われたくない橙子だった。"

#. Occurrence SP1:6678:20897: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0091; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6678
msgctxt "text_id=20897 | speaker=touko"
msgid "\"Don't worry. The familiar will disintegrate at the beginning of the new year."
msgstr "「その使い魔、年明けには溶けるから安心なさい。"

#. Occurrence SP1:6684:20898: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0092; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6684
msgctxt "text_id=20898 | speaker=touko"
msgid "  See you around, Ritsuka. Hopefully we'll meet again. I'll take you up on that coffee of yours then, for sure."
msgstr "　じゃあね律架。縁があったらまた会いましょう。その時は自慢のコーヒーをご馳走してね。"

#. Occurrence SP1:6695:20899: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0093; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:6695
msgctxt "text_id=20899 | speaker=touko"
msgid "  Also, I didn't mean to insult you by comparing you to an infomercial product. You live a simple life. I like that.\""
msgstr "　ああ、あと深夜販売の商品だってバカにできたもんじゃないわ。あのシンプルさ、けっこう好きよ、私」"

#. Occurrence SP1:6747:20900: scene=SP1
#: SP1:6747
msgctxt "text_id=20900 | speaker=unknown"
msgid "  Touko winked at her old friend and left the apartment behind her."
msgstr "　旧知の友人にウインクをして、橙子はアパートを後にする。"

#. Occurrence SP1:6752:20901: scene=SP1
#: SP1:6752
msgctxt "text_id=20901 | speaker=unknown"
msgid "\"Hopefully we'll meet again.\""
msgstr "“また会いましょう”"

#. Occurrence SP1:6757:20902: scene=SP1
#: SP1:6757
msgctxt "text_id=20902 | speaker=unknown"
msgid "  Touko realized those were empty words."
msgstr "　その言葉に、橙子自身、空しいものを感じながら。"

#. Occurrence SP1:6777:20903: scene=SP1
#: SP1:6777
msgctxt "text_id=20903 | speaker=unknown"
msgid "  Her plan would not spare her mortal body. Be it a success, or be it a failure, Touko Aozaki would be erased from this world."
msgstr "　今回の計画は、どうあっても彼女の肉体を無事には済まさない。成功するにしろ失敗するにしろ、蒼崎橙子はこの世から消失する。"

#. Occurrence SP1:6783:20904: scene=SP1
#: SP1:6783
msgctxt "text_id=20904 | speaker=unknown"
msgid "  Still, that was no reason not at least say something about meeting again."
msgstr "　それでも再会の<空言|からごと>を残す程度には―――"

#. Occurrence SP1:6788:20905: scene=SP1
#: SP1:6788
msgctxt "text_id=20905 | speaker=unknown"
msgid "  Perhaps Touko had more affection for Ritsuka than she realized."
msgstr "　蒼崎橙子は、周瀬律架に思い入れがあったのだろう。"

#. Occurrence SP1:6818:20906: scene=SP1
#: SP1:6818
msgctxt "text_id=20906 | speaker=unknown"
msgid "  Even so, she left that friend behind in a state of paralysis."
msgstr "　そんな友人を、律架は金縛り状態で見送った。"

#. Occurrence SP1:6823:20907: scene=SP1
#: SP1:6823
msgctxt "text_id=20907 | speaker=unknown"
msgid "  Touko had indeed returned home."
msgstr "　蒼崎橙子が帰ってきた。"

#. Occurrence SP1:6828:20908: scene=SP1
#: SP1:6828
msgctxt "text_id=20908 | speaker=unknown"
msgid "  That fact alone revealed much to Ritsuka."
msgstr "　律架にとって、それは今回の事件の真相を知るに等しい。"

#. Occurrence SP1:6833:20909: scene=SP1
#: SP1:6833
msgctxt "text_id=20909 | speaker=unknown"
msgid "  Two years older than Touko, Ritsuka had been contracted ten years prior to monitor Touko's grandfather, the mage who discovered the Fifth Magic."
msgstr "　橙子より二歳ほど年上の周瀬律架は、十年前から橙子の祖^父―――五番目の魔法の路を発掘した魔術師―――の監視^役として派遣された魔術師だ。"

#. Occurrence SP1:6838:20910: scene=SP1
#: SP1:6838
msgctxt "text_id=20910 | speaker=unknown"
msgid "  That made her both Touko and Aoko's senior,"
msgstr "　彼女は蒼崎橙子の先輩であり、また、蒼崎青子の先輩でもある。"

#. Occurrence SP1:6843:20911: scene=SP1
#: SP1:6843
msgctxt "text_id=20911 | speaker=unknown"
msgid "  and she knew the sisters rather well."
msgstr "　故に、姉妹の事情をそれなりに把握していた。"

#. Occurrence SP1:6876:20912: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0035; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6876
msgctxt "text_id=20912 | speaker=ritsuka"
msgid "\"Hmm, she's gotta keep a few of us from talking, then."
msgstr "「うーん。そりゃあ、口止めの一つもしないとね。"

#. Occurrence SP1:6882:20913: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0036; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6882
msgctxt "text_id=20913 | speaker=ritsuka"
msgid "  The first people to be on alert upon seeing Toko would be myself and...\""
msgstr "　トコちゃんを見てまっさきに警戒するのはわたしと―――」"

#. Occurrence SP1:6888:20914: scene=SP1
#: SP1:6888
msgctxt "text_id=20914 | speaker=unknown"
msgid "  One other person."
msgstr "　あと一人。"

#. Occurrence SP1:6893:20915: scene=SP1
#: SP1:6893
msgctxt "text_id=20915 | speaker=unknown"
msgid "  Another with more seniority than the Aozaki sisters in the truest sense."
msgstr "　真の意味で蒼崎姉妹の兄弟子と言える人物。"

#. Occurrence SP1:6898:20916: scene=SP1
#: SP1:6898
msgctxt "text_id=20916 | speaker=unknown"
msgid "  There was one other beautiful person, one who had taught Touko."
msgstr "　蒼崎橙子の教育係を務めた、ある麗人が残っている。"

#. Occurrence SP1:6924:20917: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0037; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6924
msgctxt "text_id=20917 | speaker=ritsuka"
msgid "\"I'm sure she's probably got that handled, though."
msgstr "「ま、そっちはそっちで根回ししてるかな。"

#. Occurrence SP1:6930:20918: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0038; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6930
msgctxt "text_id=20918 | speaker=ritsuka"
msgid "  She's not one to overlook something like that.\""
msgstr "　トコちゃんならそのあたり完璧だろうけど―――」"

#. Occurrence SP1:6957:20919: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0039; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6957
msgctxt "text_id=20919 | speaker=ritsuka"
msgid "\"Toko really should learn to be colder toward her enemies, though. She's too soft on them--thinks too much of their human rights."
msgstr "「もうちょっとこう、敵には非情になった方がいいわよね。　トコちゃんは相手の人権を尊重しすぎっていうか、根本が甘いっていうか。"

#. Occurrence SP1:6964:20920: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_SP1_0040; voice_prefix=B30; voice_category=9; scene=SP1
#: SP1:6964
msgctxt "text_id=20920 | speaker=ritsuka"
msgid "I don't know how I feel about her showing her face to a person she's decided to kill.\""
msgstr "殺すと決めた相手に顔を見せるとか、どうかと思うの、わたし」"

#. Occurrence SP1:6994:20921: scene=SP1
#: SP1:6994
msgctxt "text_id=20921 | speaker=unknown"
msgid "  Touko was a researcher more than she was a mage. Generally, she wasn't a fighter."
msgstr "　蒼崎橙子は魔術師というより研究者で、基本、戦いに向いた人間ではない。"

#. Occurrence SP1:6999:20922: scene=SP1
#: SP1:6999
msgctxt "text_id=20922 | speaker=unknown"
msgid "  She was cruel, but not cold."
msgstr "　残酷なクセに冷酷ではない。"

#. Occurrence SP1:7004:20923: scene=SP1
#: SP1:7004
msgctxt "text_id=20923 | speaker=unknown"
msgid "  Despite her capability for vicious, ruthless treatment of people, she also displayed a measure of compassion for others."
msgstr "　合理的な、むごたらしい仕打ちができるクセに、他人への思いやりなどを持ってしまっている。"

#. Occurrence SP1:7009:20924: scene=SP1
#: SP1:7009
msgctxt "text_id=20924 | speaker=unknown"
msgid "  Ritsuka sighed as if the problem were her own, and hoped that inconsistency wouldn't end up hurting Touko."
msgstr "　そのあたりの整合性のなさが彼女自身を苦しめなければいいけど、と、律架はひとり、我が事のように嘆息した。"

#. Occurrence SP1:7055:20925: scene=SP1
#: SP1:7055
msgctxt "text_id=20925 | speaker=unknown"
msgid "  Touko left the neighborhood and began heading toward the largest park in the town."
msgstr "　蒼崎橙子は住宅地を後にすると、街で一番大きな公園に足を向けた。"

#. Occurrence SP1:7060:20926: scene=SP1
#: SP1:7060
msgctxt "text_id=20926 | speaker=unknown"
msgid "  It was three in the afternoon on this early winter day on the boulevard."
msgstr "　冬の初めの、午後三時過ぎの並木道。"

#. Occurrence SP1:7065:20927: scene=SP1
#: SP1:7065
msgctxt "text_id=20927 | speaker=unknown"
msgid "  If it were autumn, the street would be lined with people out for a walk to look at the colorful trees, but now Touko was alone."
msgstr "　秋であれば散歩をする人々で<彩|いろど>られる道だが、今は橙子の姿しかない。"

#. Occurrence SP1:7096:20928: scene=SP1
#: SP1:7096
msgctxt "text_id=20928 | speaker=unknown"
msgid "  ...Though to be accurate, she wasn't quite alone."
msgstr "　……いや、正確にはもう一人分。"

#. Occurrence SP1:7102:20929: scene=SP1
#: SP1:7102
msgctxt "text_id=20929 | speaker=unknown"
msgid "  Beo was walking along the grass more than ten yards behind his employer when he noticed a change in her scent."
msgstr "　十メートル以上の距離をとって芝生を歩くベオは、ここにきて雇い主の変化を嗅ぎ取った。"

#. Occurrence SP1:7109:20930: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0048; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:7109
msgctxt "text_id=20930 | speaker=beo"
msgid "(Are you really not wearing your glasses out here, Touko?)"
msgstr "「“トーコさん、こんな町中でメガネ、外してる？”」"

#. Occurrence SP1:7141:20931: scene=SP1
#: SP1:7141
msgctxt "text_id=20931 | speaker=unknown"
msgid "  Touko's personality changed significantly depending on whether or not she was wearing her glasses."
msgstr "　蒼崎橙子はメガネの有り無しで人格をスイッチする。"

#. Occurrence SP1:7146:20932: scene=SP1
#: SP1:7146
msgctxt "text_id=20932 | speaker=unknown"
msgid "  Beo wasn't sure which side was her true self, but he did know that she was much more serious and cruel without her glasses."
msgstr "　どちらが素なのかはベオには不明だが、メガネを外した彼女は遊びのない、男性的な思考に変化する。"

#. Occurrence SP1:7151:20933: scene=SP1
#: SP1:7151
msgctxt "text_id=20933 | speaker=unknown"
msgid "  It wasn't quite to the level of a split personality... more like a reordering of priorities. She mainly took off her glasses when she was about to fight someone."
msgstr "　俗に言う二重人格……ではなく、物事の優先度を組み替えただけのもので、おもに相手を叩きのめす時、彼女はメガネを外す。"

#. Occurrence SP1:7156:20934: scene=SP1
#: SP1:7156
msgctxt "text_id=20934 | speaker=unknown"
msgid "  Doing so made her less human. It pushed all sense of compromise, concern, and sympathy out of her brain."
msgstr "　妥協、憂慮、同情。そういったものを脳の外に追いやった、非人間に変身するのである。"

#. Occurrence SP1:7191:20935: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0049; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:7191
msgctxt "text_id=20935 | speaker=beo"
msgid "(That must mean the scent getting closer is of her enemy... I think...)"
msgstr "「“ってコトは、さっきから近づいてくる匂いはトーコさんの敵……なんだ、けど……”」"

#. Occurrence SP1:7197:20936: scene=SP1
#: SP1:7197
msgctxt "text_id=20936 | speaker=unknown"
msgid "  Beo furrowed his brow as he hid behind a tree."
msgstr "　木の<陰|かげ>に<潜|ひそ>みながら、ベオはむう、と眉を寄せた。"

#. Occurrence SP1:7202:20937: scene=SP1
#: SP1:7202
msgctxt "text_id=20937 | speaker=unknown"
msgid "  He could certainly smell hostility and anticipation emanating from Touko."
msgstr "　橙子からは確かに敵意とか緊張とか、その手の匂いが<零|こぼ>れている。"

#. Occurrence SP1:7207:20938: scene=SP1
#: SP1:7207
msgctxt "text_id=20938 | speaker=unknown"
msgid "  But at the same time, he couldn't help but scrunch his nose up at the strange scent that kept getting stronger."
msgstr "　けれど同時に、あの妙な匂いが強くなっている事に、ベオは不満げに鼻をひくつかせるのだった。"

#. Occurrence SP1:7249:20939: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0001; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7249
msgctxt "text_id=20939 | speaker=eiri"
msgid "\"Hello. I just happened to be out for a walk. What a coincidence meeting you out here, Touko.\""
msgstr "「こんにちは。なんとなしに散歩していただけなのですが、また出逢えるとは奇遇ですね、橙子さん」"

#. Occurrence SP1:7258:20940: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0095; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7258
msgctxt "text_id=20940 | speaker=touko"
msgid "\"Ah, yes, what a coincidence indeed. We're not the sort to stop and chat, so let's just keep this to formalities, shall we?\""
msgstr "「ああ。たまたま続いた偶然だ。世間話をする仲でもなし、挨拶を交わす程度に済ませよう」"

#. Occurrence SP1:7291:20941: scene=SP1
#: SP1:7291
msgctxt "text_id=20941 | speaker=unknown"
msgid "  Beo had no idea who was talking to Touko."
msgstr "　橙子に声をかけたのは、ベオにとって未知の人間だった。"

#. Occurrence SP1:7296:20942: scene=SP1
#: SP1:7296
msgctxt "text_id=20942 | speaker=unknown"
msgid "  His name was Eiri Fumidsuka."
msgstr "　男の名は<文柄|ふみづか><詠梨|えいり>。"

#. Occurrence SP1:7301:20943: scene=SP1
#: SP1:7301
msgctxt "text_id=20943 | speaker=unknown"
msgid "  He was a priest of Aida Church and an enemy to Beo and Touko."
msgstr "　合田教会の司祭代理であり、ベオや橙子からすれば敵よりの人物である。"

#. Occurrence SP1:7321:20944: scene=SP1
#: SP1:7321
msgctxt "text_id=20944 | speaker=unknown"
msgid "  However, it was impossible for Beo to sense this."
msgstr "　が、事前情報を知らないカレにそれを察しろというのは酷な話だろう。"

#. Occurrence SP1:7326:20945: scene=SP1
#: SP1:7326
msgctxt "text_id=20945 | speaker=unknown"
msgid "  He had no personal hostility toward the clergy anyway."
msgstr "　なにしろ、司祭には敵意が一切ない。"

#. Occurrence SP1:7331:20946: scene=SP1
#: SP1:7331
msgctxt "text_id=20946 | speaker=unknown"
msgid "  As far as Beo could tell, he was just a regular person. There was no chance that Touko could be at a disadvantage here."
msgstr "　ベオから見て、彼はどこからどう見ても一般人であり、蒼崎橙子が遅れを取る可能性など皆無だからだ。"

#. Occurrence SP1:7337:20947: scene=SP1
#: SP1:7337
msgctxt "text_id=20947 | speaker=unknown"
msgid "  ...He would later learn a harsh lesson from someone who seemed similarly harmless, but that was a tale for another time."
msgstr "　―――後に、カレはその手の“毒を毒と思わせない”タイプの人間から手ひどい教訓を学ぶ事になるが、それはまた別の話である。"

#. Occurrence SP1:7384:20948: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0096; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7384
msgctxt "text_id=20948 | speaker=touko"
msgid "\"So how are things going with you? God's house must be full of hard workers. Any greedy trolls show up hungry for concessions?\""
msgstr "「そちらの状況はどうなんだ。神の家は働き者<揃|ぞろ>いだからな。利権をあさりに来る<欲深|よくぶか>は現れそうか？」"

#. Occurrence SP1:7395:20949: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0002; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7395
msgctxt "text_id=20949 | speaker=eiri"
msgid "\"I can agree on the hard workers part, but greed is not a problem in our organization."
msgstr "「いやあ。働き者、というのは全力で肯定しますけど、欲が深いとか、そんな人は少ないですよ、こちらは。"

#. Occurrence SP1:7406:20950: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0003; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7406
msgctxt "text_id=20950 | speaker=eiri"
msgid "  Any who come to us usually do so on the basis of doctrine, nothing more."
msgstr "　彼らがやってくる時はたいていは教義の為ですから。"

#. Occurrence SP1:7406:20951: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0003; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7406
msgctxt "text_id=20951 | speaker=eiri"
msgid "  Don't people driven by duty rather than greed frighten you more?\""
msgstr "　欲望より<責務|せきむ>で動く人たちって怖くないですか？」"

#. Occurrence SP1:7433:20952: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0097; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7433
msgctxt "text_id=20952 | speaker=touko"
msgid "\"I thought I said we weren't going to waste time on small talk."
msgstr "「無駄話はしないと言っただろう。"

#. Occurrence SP1:7439:20953: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0098; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7439
msgctxt "text_id=20953 | speaker=touko"
msgid "  Just cut to the chase. Is your follower going to sound the bell or not?\""
msgstr "　結論を言え。おまえの腰巾着は鐘を鳴らしそうか？」"

#. Occurrence SP1:7465:20954: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0004; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7465
msgctxt "text_id=20954 | speaker=eiri"
msgid "\"My, my, my. You're one to talk."
msgstr "「やれやれ。人のことは言えませんよ。"

#. Occurrence SP1:7465:20955: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0004; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7465
msgctxt "text_id=20955 | speaker=eiri"
msgid "  You're very nearly a workaholic yourself, Touko."
msgstr "　橙子さんだってワーカホリック寸前じゃないですか。"

#. Occurrence SP1:7471:20956: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0005; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7471
msgctxt "text_id=20956 | speaker=eiri"
msgid "  You mean to tell me you don't even have time for a little conversation? After all, this might be the last time we ever see each other again.\""
msgstr "　もっとこう、余裕のあるコミュニケーションをとりませんか？　立場上、いつ最後の<逢瀬|おうせ>になるか分からないワケですし」"

#. Occurrence SP1:7483:20957: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0099; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7483
msgctxt "text_id=20957 | speaker=touko"
msgid "\"Please. This is the last time and you know it.\""
msgstr "「ふざけろ。いつも何も、これが最後だよ詠梨」"

#. Occurrence SP1:7503:20958: scene=SP1
#: SP1:7503
msgctxt "text_id=20958 | speaker=unknown"
msgid "  Touko curtly rejected the smiling priest's request for a chat."
msgstr "　微笑む司祭の提案を、橙子は一言で斬って捨てた。"

#. Occurrence SP1:7508:20959: scene=SP1
#: SP1:7508
msgctxt "text_id=20959 | speaker=unknown"
msgid "  She was being as blunt as she could."
msgstr "　まさにけんもほろろ状態である。"

#. Occurrence SP1:7543:20960: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0100; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7543
msgctxt "text_id=20960 | speaker=touko"
msgid "\"If we were ever to meet again, I'm certain it would only be in a fight to the death."
msgstr "「だいたい次があるとしたら、その時は殺し合いだろ。"

#. Occurrence SP1:7549:20961: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0101; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7549
msgctxt "text_id=20961 | speaker=touko"
msgid "  We both know each other's intentions. One of us would be dead the moment we laid eyes on the other. There's no time for idle chitchat.\""
msgstr "　お互い手の内は知っているしな。顔を会わせた瞬間、どちらかが死んでいる。会話なんぞしている暇があるか」"

#. Occurrence SP1:7555:20962: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0006; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7555
msgctxt "text_id=20962 | speaker=eiri"
msgid "\"That's just what you happen to think, Touko."
msgstr "「それは橙子さんだけの思いこみですけどねぇ。"

#. Occurrence SP1:7561:20963: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0007; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7561
msgctxt "text_id=20963 | speaker=eiri"
msgid "  Why is it that you people can only think of eradicating whoever stands in your way?\""
msgstr "　どうしてこう、邪魔者は始末する、という方向でしか物事を考えられないんでしょうか、貴女たちは」"

#. Occurrence SP1:7581:20964: scene=SP1
#: SP1:7581
msgctxt "text_id=20964 | speaker=unknown"
msgid "  Eiri shrugged his shoulders in frustration."
msgstr "　やれやれと肩をすくめる司祭と、"

#. Occurrence SP1:7586:20965: scene=SP1
#: SP1:7586
msgctxt "text_id=20965 | speaker=unknown"
msgid "  Touko kept her gaze fixed intently on his overcoat."
msgstr "　その<外套|マント>の下を注意深く見据える橙子。"

#. Occurrence SP1:7591:20966: scene=SP1
#: SP1:7591
msgctxt "text_id=20966 | speaker=unknown"
msgid "  No matter how many times he said he wanted to resolve this peacefully, she would bet her pride that he didn't mean it."
msgstr "　司祭が何度「穏便に済ませたい」と口にしても、プライドにかけて信じる気はないようだ。"

#. Occurrence SP1:7627:20967: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0008; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7627
msgctxt "text_id=20967 | speaker=eiri"
msgid "\"See, this is what happens when one goes out, experiences the world, and returns to their home. I would have liked it if you had worked on your personal charm, instead."
msgstr "「まったく。そういうところも成長して帰ってくるんですから。育つのは女性としての魅力だけに留めておいてほしいものです。"

#. Occurrence SP1:7633:20968: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0009; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7633
msgctxt "text_id=20968 | speaker=eiri"
msgid "  Oh come on, don't glare at me like that. I'm getting to the point.\""
msgstr "　ああ、そう睨まない。本題に入りますから」"

#. Occurrence SP1:7662:20969: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0010; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7662
msgctxt "text_id=20969 | speaker=eiri"
msgid "\"I am entrusted with all reports to the Church. My report is now, 'The Second Owner is currently battling a heretic. I am monitoring them under my clerical authority, in accordance with the neutrality pact. The affiliation of the heretic is unknown, and I am investigating their history.'\""
msgstr "「目下、教会への報告は私が一任されています。司祭への報告は『現在、管理者は異端者と交戦中。中立の条約に基づき、司祭代理権限で監督中。なお、異端者の所属は不明、現在、履歴を調査中』といったところです」"

#. Occurrence SP1:7683:20970: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0102; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7683
msgctxt "text_id=20970 | speaker=touko"
msgid "\"So you're telling me that the Church is still unaware of the affiliation of the mage who's appeared in town?\""
msgstr "「この町に現れた魔術師は所属不明……という事になっているんだな？」"

#. Occurrence SP1:7695:20971: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0011; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7695
msgctxt "text_id=20971 | speaker=eiri"
msgid "\"Right. Sister Yuika reports to a different jurisdiction from my own, but she has not even seen the heretic, let alone uncovered their workshop."
msgstr "「ええ。シスター<唯架|ゆいか>は私とは別<所轄|しょかつ>の方ですが、彼女は異端者の工房はおろか、その姿さえ掴めていません。"

#. Occurrence SP1:7701:20972: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0012; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7701
msgctxt "text_id=20972 | speaker=eiri"
msgid "  There will most likely be no interference from the Church until she is able to reveal who our enemy is."
msgstr "　彼女が単独で敵の正体を暴くまで、教会から横槍が入る事はないんじゃないですかねぇ。"

#. Occurrence SP1:7707:20973: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0013; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7707
msgctxt "text_id=20973 | speaker=eiri"
msgid "  Perhaps they are thinking it's a small turf war between mages who've just come into town?\""
msgstr "　今まで通り、土地を狙いにきた魔術師同士の小競り合いだと思っているんじゃないですか？」"

#. Occurrence SP1:7742:20974: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0103; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7742
msgctxt "text_id=20974 | speaker=touko"
msgid "\"I see. So we do have a deal."
msgstr "「そうか。では取引成立だな。"

#. Occurrence SP1:7748:20975: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0104; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7748
msgctxt "text_id=20975 | speaker=touko"
msgid "  As long as you're the only one who knows that I'm back in town, I'll lay low. I also won't get in contact with any of my blood relatives.\""
msgstr "　おまえが私の帰国の件を握り潰している間は、私も多少、回り道をする。蒼崎の親戚筋にも手は出さない」"

#. Occurrence SP1:7769:20976: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0014; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7769
msgctxt "text_id=20976 | speaker=eiri"
msgid "\"Very well. I know you're not the type to sabotage things indiscriminately, and that you prefer to do things as efficiently as possible."
msgstr "「良かった。橙子さんは無差別な破壊工作はしませんが、とにかく最適な<道筋|みちすじ>を好みますから。"

#. Occurrence SP1:7776:20977: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0015; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7776
msgctxt "text_id=20977 | speaker=eiri"
msgid "  You might get carried away and try to make your secret hideout in some factory or office building somewhere, right?"
msgstr "　勢い、どこぞの工場とかオフィスビルとか秘密基地にしそうでしょう？"

#. Occurrence SP1:7782:20978: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0016; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7782
msgctxt "text_id=20978 | speaker=eiri"
msgid "  I won't allow the bloodshed in this parish to continue on my watch--or anything else that might sully my reputation.\""
msgstr "　私がこちらに赴任している間、流血事件が続くと困るというか。私の評価が落ちるような事は、なんとも」"

#. Occurrence SP1:7807:20979: scene=SP1
#: SP1:7807
msgctxt "text_id=20979 | speaker=unknown"
msgid "  Touko had to resist the urge to object and ask just what kind of person he thought she was."
msgstr "　人の事をなんだと思っているんだ、と抗議したくなる気持ちを抑えこむ。"

#. Occurrence SP1:7812:20980: scene=SP1
#: SP1:7812
msgctxt "text_id=20980 | speaker=unknown"
msgid "  She did hate wastefulness, but she wasn't about to entirely abandon society and its norms just for the sake of doing things optimally."
msgstr "　橙子とて無駄は嫌いだが、だからといって最適化の為に社会性を<無|む><下|げ>にするつもりはない。"

#. Occurrence SP1:7817:20981: scene=SP1
#: SP1:7817
msgctxt "text_id=20981 | speaker=unknown"
msgid "  Besides, criminal activities were always a pain to clean up later and thus far more inefficient."
msgstr "　そもそも、犯罪行為は後処理が面倒になる。そちらの方が遥かに無駄というものだ。"

#. Occurrence SP1:7848:20982: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0105; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7848
msgctxt "text_id=20982 | speaker=touko"
msgid "\"...I guess that's fine. We're both coming out ahead here."
msgstr "「……まあいいさ。お互いの利益が一致したんだからな。"

#. Occurrence SP1:7854:20983: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0106; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7854
msgctxt "text_id=20983 | speaker=touko"
msgid "  Just keep watch until things are settled.\""
msgstr "　では、後は事が済むまで<静観|せいかん>を決めこんでおけ」"

#. Occurrence SP1:7860:20984: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0017; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7860
msgctxt "text_id=20984 | speaker=eiri"
msgid "\"Oh, you're leaving? So soon."
msgstr "「もうお帰りですか。名残惜しいですねぇ。"

#. Occurrence SP1:7866:20985: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0018; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7866
msgctxt "text_id=20985 | speaker=eiri"
msgid "  I haven't had the chance to fully appreciate what you look like now.\""
msgstr "　結局一度も、今の貴女の素顔を見られなかった」"

#. Occurrence SP1:7872:20986: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0107; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7872
msgctxt "text_id=20986 | speaker=touko"
msgid "\"I feel the opposite. I hope this is the last time I ever have to lay eyes on you again.\""
msgstr "「私は逆だ。そのカマキリ<面|づら>もこれで<見納|みおさ>めかと思うとせいせいする」"

#. Occurrence SP1:7878:20987: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0019; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7878
msgctxt "text_id=20987 | speaker=eiri"
msgid "\"Ah, wait. Before you go, let me ask you one thing.\""
msgstr "「ああ、待ってください。お別れの前に、一つ質問を」"

#. Occurrence SP1:7912:20988: scene=SP1
#: SP1:7912
msgctxt "text_id=20988 | speaker=unknown"
msgid "  Eiri spoke just as Touko was about to take a step back."
msgstr "　司祭に顔を向けたまま立ち去ろうとする橙子を、司祭はごく自然に制止させた。"

#. Occurrence SP1:7917:20989: scene=SP1
#: SP1:7917
msgctxt "text_id=20989 | speaker=unknown"
msgid "  He had effortlessly stopped her from leaving."
msgstr "　橙子が足を半歩後ろにズラそうと考えた瞬間に、である。"

#. Occurrence SP1:7941:20990: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0020; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7941
msgctxt "text_id=20990 | speaker=eiri"
msgid "\"This is the last thing I'll say."
msgstr "「所感なのですが。"

#. Occurrence SP1:7947:20991: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0021; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7947
msgctxt "text_id=20991 | speaker=eiri"
msgid "  You look quite uneasy, Touko. Are you feeling stifled here?\""
msgstr "　橙子さん、今、たいへん息苦しくはありませんか？」"

#. Occurrence SP1:7959:20992: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0108; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7959
msgctxt "text_id=20992 | speaker=touko"
msgid "\"That couldn't be further from the truth. I'm feeling more fulfilled than ever."
msgstr "「まさか。私はかつてないほど充実しているよ。"

#. Occurrence SP1:7965:20993: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0109; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:7965
msgctxt "text_id=20993 | speaker=touko"
msgid "  Why do you ask, Eiri?\""
msgstr "　なぜそんな事を訊く、詠梨」"

#. Occurrence SP1:7987:20994: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0022; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:7987
msgctxt "text_id=20994 | speaker=eiri"
msgid "\"You look like you're having fun, but also like you're not truly happy. I was just worried because it seems you don't even realize it yourself.\""
msgstr "「いえ。だって楽しそうではありますが、幸せそうではありませんので。貴女自身気付いてはいないようでしたから、<知|ち><己|き>として心配になったのです」"

#. Occurrence SP1:8025:20995: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0110; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:8025
msgctxt "text_id=20995 | speaker=touko"
msgid "\"I remember you used to say that everyone finds happiness in different things."
msgstr "「……幸せの定義か。思い出したよ。おまえの口癖だったな、それは。幸せのカタチは人それぞれだと。"

#. Occurrence SP1:8031:20996: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0111; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:8031
msgctxt "text_id=20996 | speaker=touko"
msgid "  But you don't know me. So don't pretend to know what makes me happy.\""
msgstr "　まったくその通りだ。私の善しとする幸福が、他人であるおまえに分かるものか。つまらん心配はするな」"

#. Occurrence SP1:8052:20997: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0023; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8052
msgctxt "text_id=20997 | speaker=eiri"
msgid "\"Well, of course I don't know down to the fine details. Women in particular have a notoriously bizarre concept of happiness."
msgstr "「いや、そりゃあ細かいところまでは分かりませんけどねぇ。とくに女の人の幸福観なんて、それこそ<奇々怪々|ききかいかい>ですから。"

#. Occurrence SP1:8058:20998: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0024; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8058
msgctxt "text_id=20998 | speaker=eiri"
msgid "  But happiness can easily be categorized into two major types."
msgstr "　ですがほら、幸福のカタチは二つに大別できます。"

#. Occurrence SP1:8064:20999: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0025; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8064
msgctxt "text_id=20999 | speaker=eiri"
msgid "  It seems you haven't even figured that out yet, and it's hard to watch.\""
msgstr "　橙子さんの場合、それすら気付いていないようですから。たいへん見苦しいな、と思いまして」"

#. Occurrence SP1:8100:21000: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0112; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:8100
msgctxt "text_id=21000 | speaker=touko"
msgid "\"...Oh? I'm greatly obliged for the concern. Still insist on playing senior apprentice, eh?"
msgstr "「……ほう、ご忠告痛み入る。腐っても兄弟子という訳か。"

#. Occurrence SP1:8106:21001: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0113; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:8106
msgctxt "text_id=21001 | speaker=touko"
msgid "  Fine, I'll listen. Let's see what you have to say.\""
msgstr "　いいぞ、聞いてやるから言ってみろ」"

#. Occurrence SP1:8112:21002: scene=SP1
#: SP1:8112
msgctxt "text_id=21002 | speaker=unknown"
msgid "  If it happened to be something worthless, she would kill him."
msgstr "　それが下らないものなら、ここで殺す。"

#. Occurrence SP1:8117:21003: scene=SP1
#: SP1:8117
msgctxt "text_id=21003 | speaker=unknown"
msgid "  If it erased all the progress she had made on her plans over the past month, or even the two last years, she would kill him."
msgstr "　この一ヶ月―――いや、この二年間積み重ねてきた計画を白紙に戻す事になっても殺す、と。"

#. Occurrence SP1:8122:21004: scene=SP1
#: SP1:8122
msgctxt "text_id=21004 | speaker=unknown"
msgid "  Touko's hostility had clearly turned to murderous rage."
msgstr "　橙子の敵意は、ここにきて殺意に変貌した。"

#. Occurrence SP1:8155:21005: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0026; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8155
msgctxt "text_id=21005 | speaker=eiri"
msgid "\"It's quite obvious, really."
msgstr "「当たり前のコトですよ。"

#. Occurrence SP1:8161:21006: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0027; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8161
msgctxt "text_id=21006 | speaker=eiri"
msgid "  The two types of happiness are relative and absolute. It depends on whether you compare yourself to others or not."
msgstr "　相対的なものと絶対的なもの。比べる相手が居るか居ないかが幸福の違いです。"

#. Occurrence SP1:8167:21007: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0028; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8167
msgctxt "text_id=21007 | speaker=eiri"
msgid "  You're either happy because you yourself are at peace, or..."
msgstr "　自分が穏やかであれば幸福なのか、それとも―――"

#. Occurrence SP1:8173:21008: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0029; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8173
msgctxt "text_id=21008 | speaker=eiri"
msgid "  You're the type of person who can't stand it if you have less than someone else, even if you're otherwise fulfilled.\""
msgstr "　どんなに満ち足りていても、<他人|ひと>より劣っていては我慢できない人間なのか」"

#. Occurrence SP1:8194:21009: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0030; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8194
msgctxt "text_id=21009 | speaker=eiri"
msgid "\"The definition of happiness basically comes down to that."
msgstr "「幸福の定義なんて、詰まるところはその二つですよ。"

#. Occurrence SP1:8200:21010: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0031; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8200
msgctxt "text_id=21010 | speaker=eiri"
msgid "  I know it goes without me saying, but..."
msgstr "　私が言うまでもありませんが―――"

#. Occurrence SP1:8200:21011: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0031; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8200
msgctxt "text_id=21011 | speaker=eiri"
msgid "  Most people want to be happier than those around them.\""
msgstr "　多くの人間は、ただ、<他人|ひと>より少しだけ幸せでありたいのです」"

#. Occurrence SP1:8232:21012: scene=SP1
#: SP1:8232
msgctxt "text_id=21012 | speaker=unknown"
msgid "  The holy man smiled calmly, wrapped in his shadowy black clothing."
msgstr "　涼やかに<微笑|わら>う黒衣の聖者。"

#. Occurrence SP1:8237:21013: scene=SP1
#: SP1:8237
msgctxt "text_id=21013 | speaker=unknown"
msgid "  Touko remembered clearly now."
msgstr "　ああ、と橙子は思いだした。"

#. Occurrence SP1:8242:21014: scene=SP1
#: SP1:8242
msgctxt "text_id=21014 | speaker=unknown"
msgid "  This was a man who actually didn't believe in the concept of true happiness."
msgstr "　この男は根本からして、<幸福|そういうもの>を信じていない悪魔だったと。"

#. Occurrence SP1:8279:21015: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0032; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8279
msgctxt "text_id=21015 | speaker=eiri"
msgid "\"Come now, calm yourself. If you try anything, Sister Yuika will be here in a flash."
msgstr "「ほら、そんな殺気は収めて。シスター唯架が飛んできます。"

#. Occurrence SP1:8285:21016: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0033; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8285
msgctxt "text_id=21016 | speaker=eiri"
msgid "  I know that your idea of happiness is not relative. You were always the type to be satisfied as long as you stayed true to yourself."
msgstr "　橙子さんの幸福観は絶対的なもの。貴女は自分が確かであれば満ち足りるタイプの人だったんですけどね。"

#. Occurrence SP1:8291:21017: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0034; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8291
msgctxt "text_id=21017 | speaker=eiri"
msgid "  The only Aozaki I know who has a relative definition of happiness is...\""
msgstr "　他人が気になるなんて、そんな相対的な幸福観を持っているのは、」"

#. Occurrence SP1:8317:21018: scene=SP1
#: SP1:8317
msgctxt "text_id=21018 | speaker=unknown"
msgid "  He stopped himself before he could say Aoko."
msgstr "　青子の方、と言いかけて、司祭は自分から身を引いた。"

#. Occurrence SP1:8322:21019: scene=SP1
#: SP1:8322
msgctxt "text_id=21019 | speaker=unknown"
msgid "  The priest seemed to have spoken out of genuine concern for Touko, but his words had the opposite effect on her."
msgstr "　心底から橙子を心配しての忠告だったが、逆の結果に終わったようだ。"

#. Occurrence SP1:8327:21020: scene=SP1
#: SP1:8327
msgctxt "text_id=21020 | speaker=unknown"
msgid "  Although he was reluctant to part on such ill terms, Eiri knew it was best not to anger Touko any further."
msgstr "　司祭としては本当に名残惜しいが、これ以上怒らせて嫌われるのはよろしくない。"

#. Occurrence SP1:8365:21021: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0035; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8365
msgctxt "text_id=21021 | speaker=eiri"
msgid "\"I've said too much. Please forgive me, puppet master."
msgstr "「言葉がすぎました。お許しを<人形師|ハイマスター>。"

#. Occurrence SP1:8371:21022: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0036; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8371
msgctxt "text_id=21022 | speaker=eiri"
msgid "  I will take my leave now. I pray that you will see a good outcome in your endeavors.\""
msgstr "　それでは私はこれで。貴女たちにとっていい結果になる事を祈っています」"

#. Occurrence SP1:8383:21023: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0114; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:8383
msgctxt "text_id=21023 | speaker=touko"
msgid "\"Good. Get lost. Your gloomy act isn't helping my mood."
msgstr "「ふん、さっさと消えろ<穀|ごく>潰し。最後まで陰気くさい真似をしやがって。"

#. Occurrence SP1:8389:21024: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0115; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:8389
msgctxt "text_id=21024 | speaker=touko"
msgid "  ...What's up with your outfit anyway? Doesn't wearing that cloak around town make people avoid you?\""
msgstr "　……だいたいその服装、どうなんだ。町中でマントなんて<羽|は><織|お>って、敬遠されないのか？」"

#. Occurrence SP1:8416:21025: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0037; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8416
msgctxt "text_id=21025 | speaker=eiri"
msgid "\"Everyone is very much used to it by now."
msgstr "「皆さん、もう慣れてくださいましたから。"

#. Occurrence SP1:8428:21026: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0038; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8428
msgctxt "text_id=21026 | speaker=eiri"
msgid "  Besides, how else can I carry a weapon without people noticing?"
msgstr "　それに、ほら。この格好だと<得物|エモノ>を差していてもバレないでしょう？"

#. Occurrence SP1:8434:21027: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_SP1_0039; voice_prefix=B40; voice_category=8; scene=SP1
#: SP1:8434
msgctxt "text_id=21027 | speaker=eiri"
msgid "  I'm sure it was glaringly obvious to you, but I have about three on me right now.\""
msgstr "　ま、橙子さんには見抜かれてしまいましたが。相手が貴女ですからね。恥ずかしながら、長物を三本ほど、こっそり」"

#. Occurrence SP1:8480:21028: scene=SP1
#: SP1:8480
msgctxt "text_id=21028 | speaker=unknown"
msgid "  Eiri turned and walked back in the direction he came from with a smile still on his face."
msgstr "　最後まで笑顔を絶やさず、司祭はもと来た道へ退散していった。"

#. Occurrence SP1:8496:21029: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0116; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:8496
msgctxt "text_id=21029 | speaker=touko"
msgid "\"...What a joke. I only saw one, and it was just a small dagger."
msgstr "「……ふざけやがって。こっちは一本、それも短刀ぐらいにしか見抜けなかった。"

#. Occurrence SP1:8502:21030: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0117; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:8502
msgctxt "text_id=21030 | speaker=touko"
msgid "  How would he hide three anyway? He's not even a mage! Is he some kind of street magician now or something?\""
msgstr "　そもそも三本ってなんだ？　魔術師でもないクセに、どうやったら隠せるんだ？　あのバカ、手品師に<鞍替|くらが>えしたワケじゃあるまいな？」"

#. Occurrence SP1:8535:21031: scene=SP1
#: SP1:8535
msgctxt "text_id=21031 | speaker=unknown"
msgid "  Touko muttered to herself as she thought back over the man who had stood before her just moments ago."
msgstr "　橙子はぼやきつつ、先ほどまで目の前にいた男の姿を思い返した。"

#. Occurrence SP1:8540:21032: scene=SP1
#: SP1:8540
msgctxt "text_id=21032 | speaker=unknown"
msgid "  She truly hated the fact that he had the upper hand on her, but she also felt a bit relieved."
msgstr "　一枚上をいかれたのは心底<憎|にく>らしいが、同時にホッとしているのも事実である。"

#. Occurrence SP1:8560:21033: scene=SP1
#: SP1:8560
msgctxt "text_id=21033 | speaker=unknown"
msgid "  If she had actually noticed how heavily armed he was during that brief conversation, it would have been enough to instantly set off a fight."
msgstr "　あの短い会話の中、橙子がもし司祭の武装を正確に見抜いてしまっていたら、その瞬間こそ、あの司祭はゼロコンマで戦いの火ぶたを切っただろう。"

#. Occurrence SP1:8566:21034: scene=SP1
#: SP1:8566
msgctxt "text_id=21034 | speaker=unknown"
msgid "  Touko wasn't sure which one of them would have come out the victor if that had happened."
msgstr "　その時―――どちらが生き残るかは、今の蒼崎橙子ですら予測できない。"

#. Occurrence SP1:8598:21035: scene=SP1
#: SP1:8598
msgctxt "text_id=21035 | speaker=unknown"
msgid "  Eiri Fumidsuka had been that kind of man for as long as she had known him."
msgstr "　文柄詠梨という男は、昔からそういう人間だった。"

#. Occurrence SP1:8603:21036: scene=SP1
#: SP1:8603
msgctxt "text_id=21036 | speaker=unknown"
msgid "  He didn't need a reason, or even an opponent to fight."
msgstr "　戦う理由も、戦う相手も要らない。"

#. Occurrence SP1:8608:21037: scene=SP1
#: SP1:8608
msgctxt "text_id=21037 | speaker=unknown"
msgid "  Nor did he need any kind of connection or hatred."
msgstr "　因縁も憎悪も要らない。"

#. Occurrence SP1:8613:21038: scene=SP1
#: SP1:8613
msgctxt "text_id=21038 | speaker=unknown"
msgid "  He was just a machine that simply needed an ignition."
msgstr "　ただ、「口火を切る」瞬間だけを待つ<自動機械|オートメーション>。"

#. Occurrence SP1:8618:21039: scene=SP1
#: SP1:8618
msgctxt "text_id=21039 | speaker=unknown"
msgid "  He was murder incarnate, with no qualms about cutting someone down."
msgstr "　人を斬る事について考察さえしない、鍛え上げられた“殺人検証”の化身である。"

#. Occurrence SP1:8652:21040: scene=SP1
#: SP1:8652
msgctxt "text_id=21040 | speaker=unknown"
msgid "  Touko had only seen that side of him once."
msgstr "　彼女がそれを間近で見たのは一度きり。"

#. Occurrence SP1:8658:21041: scene=SP1
#: SP1:8658
msgctxt "text_id=21041 | speaker=unknown"
msgid "  It was back when she was still a relatively happy disciple of magecraft."
msgstr "　……まだ蒼崎橙子が魔法使いの“幸福な”弟子だった頃。"

#. Occurrence SP1:8663:21042: scene=SP1
#: SP1:8663
msgctxt "text_id=21042 | speaker=unknown"
msgid "  Touko had been standing quietly before her grandfather, crying. The instant her first tears fell, without warning, without hesitation, Eiri cut down their master in an instant."
msgstr "　あの男は、橙子が祖父の前で静かに涙した瞬間、何の前触れもなく、何の躊躇いもなく、自らの師を一刀のもと処断したのだ。"

#. Occurrence SP1:8714:21043: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A21_SP1_0000; voice_prefix=A21; voice_category=11; scene=SP1
#: SP1:8714
msgctxt "text_id=21043 | speaker=touko"
msgid "\"What have you done?! Why did you just kill him like that?!\""
msgstr "「なんで！？　どうして、貴方が<祖父|あのひと>を斬りつけたの！？」"

#. Occurrence SP1:8720:21044: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B41_SP1_0000; voice_prefix=B41; voice_category=8; scene=SP1
#: SP1:8720
msgctxt "text_id=21044 | speaker=eiri"
msgid "\"Because I thought I could.\""
msgstr "「いえ。今なら斬れる、と思いましたので」"

#. Occurrence SP1:8740:21045: scene=SP1
#: SP1:8740
msgctxt "text_id=21045 | speaker=unknown"
msgid "  Eiri could not fathom how much this curt response would affect such a young Touko."
msgstr "　あっさりとした返答に、幼い橙子がどれほど感じ入ったのか、当の本人は知るまい。"

#. Occurrence SP1:8746:21046: scene=SP1
#: SP1:8746
msgctxt "text_id=21046 | speaker=unknown"
msgid "  He had not meant to say,"
msgstr "“相手が隙を見せたから、勝てると確信したから斬った”"

#. Occurrence SP1:8746:21047: scene=SP1
#: SP1:8746
msgctxt "text_id=21047 | speaker=unknown"
msgid "  \"My opponent showed a moment of weakness, and I knew I could win, so I took the opportunity.\""
msgstr "　ではない。"

#. Occurrence SP1:8751:21048: scene=SP1
#: SP1:8751
msgctxt "text_id=21048 | speaker=unknown"
msgid "  All he meant was..."
msgstr "“今の自分の気持ちなら斬れると思ったから、斬った”。"

#. Occurrence SP1:8783:21049: scene=SP1
#: SP1:8783
msgctxt "text_id=21049 | speaker=unknown"
msgid "  \"I felt capable of killing him, so I did.\""
msgstr "　ただそれだけ。"

#. Occurrence SP1:8788:21050: scene=SP1
#: SP1:8788
msgctxt "text_id=21050 | speaker=unknown"
msgid "  This man had become her grandfather's disciple, forged an unrivaled friendship with him, and yet had still mercilessly cut him down when the desire arose."
msgstr "　祖父に弟子入りし、交遊を深め、唯一無二の友人関係を得た男は、胸に飛来した感情に寄って祖父を切断した。"

#. Occurrence SP1:8793:21051: scene=SP1
#: SP1:8793
msgctxt "text_id=21051 | speaker=unknown"
msgid "  He possessed some sort of superhuman ability that had allowed him to destroy the mortal vessel of a mage who had been infinitely close to being a Magician."
msgstr "　魔法使いに限りなく近かった魔術師の肉体を破壊したのは、誰あろう、あの司祭の神技である。"

#. Occurrence SP1:8834:21052: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0118; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:8834
msgctxt "text_id=21052 | speaker=touko"
msgid "\"Argh, this is all so fishy! And a pain!"
msgstr "「あーあ、ほんと胡散くさい、面倒くさい！"

#. Occurrence SP1:8840:21053: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0119; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:8840
msgctxt "text_id=21053 | speaker=touko"
msgid "  I'll have to kill him since he annoys me, but that's just one more thing to do after stealing the Magic. Damn it, Eiri!\""
msgstr "　でも<目障|めざわ>りだからぜったい殺すし。魔法を<奪|うば>ってからの仕事がまた一つ増えちゃったじゃない、バカ詠梨」"

#. Occurrence SP1:8865:21054: scene=SP1
#: SP1:8865
msgctxt "text_id=21054 | speaker=unknown"
msgid "  Touko put her glasses back on and turned on her heel."
msgstr "　眼鏡をかけ直して、橙子は<踵|きびす>を返した。"

#. Occurrence SP1:8870:21055: scene=SP1
#: SP1:8870
msgctxt "text_id=21055 | speaker=unknown"
msgid "  She had completed all her major tasks for the day."
msgstr "　今日の目的はすべてクリアした。"

#. Occurrence SP1:8875:21056: scene=SP1
#: SP1:8875
msgctxt "text_id=21056 | speaker=unknown"
msgid "  All that was left was to make some money to buy food for her familiar and head back to the hideout."
msgstr "　あとは使い魔の食料を調達する為、食費を稼いでアジトに帰るだけである。"

#. Occurrence SP1:8909:21057: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0050; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:8909
msgctxt "text_id=21057 | speaker=beo"
msgid "(Wait, what was with that sudden romantic mood?!)"
msgstr "「“ちょっ、なにあの乙女時空ーーーーーー！？”」"

#. Occurrence SP1:8915:21058: scene=SP1
#: SP1:8915
msgctxt "text_id=21058 | speaker=unknown"
msgid "  Setting aside Beo's mental shout of dismay for a moment..."
msgstr "　と、ベオが叫んだかはさておいて。"

#. Occurrence SP1:8920:21059: scene=SP1
#: SP1:8920
msgctxt "text_id=21059 | speaker=unknown"
msgid "  The scent that had been bothering him for the past few days had suddenly disappeared."
msgstr "　例の浮わ浮わした匂いはどこへやら。"

#. Occurrence SP1:8925:21060: scene=SP1
#: SP1:8925
msgctxt "text_id=21060 | speaker=unknown"
msgid "  His employer was back to being the old Touko Aozaki he knew, and she was headed into the entertainment district."
msgstr "　雇い主は完全にもとの蒼崎橙子に戻って、繁華街の方角に消えていった。"

#. Occurrence SP1:8959:21061: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0051; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:8959
msgctxt "text_id=21061 | speaker=beo"
msgid "\"...\""
msgstr "「“………………”」"

#. Occurrence SP1:8965:21062: scene=SP1
#: SP1:8965
msgctxt "text_id=21062 | speaker=unknown"
msgid "  Beo sniffed at the air."
msgstr "　クンクンと鼻を鳴らす。"

#. Occurrence SP1:8970:21063: scene=SP1
#: SP1:8970
msgctxt "text_id=21063 | speaker=unknown"
msgid "  The scent had vanished, and he no longer had a reason to continue tailing Touko."
msgstr "　あの匂いが気になってやってきたベオとしては、もはや橙子は尾行する対象になりえない。"

#. Occurrence SP1:8990:21064: scene=SP1
#: SP1:8990
msgctxt "text_id=21064 | speaker=unknown"
msgid "  But where had it gone?"
msgstr "　なぜ匂いは消えたのか。"

#. Occurrence SP1:8995:21065: scene=SP1
#: SP1:8995
msgctxt "text_id=21065 | speaker=unknown"
msgid "  And where had it come from in the first place?"
msgstr "　そもそも原因は何だったのか。"

#. Occurrence SP1:9000:21066: scene=SP1
#: SP1:9000
msgctxt "text_id=21066 | speaker=unknown"
msgid "  Beo thought about it for a few moments."
msgstr "　カレはカレなりに考えこんだ末、"

#. Occurrence SP1:9007:21067: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0052; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:9007
msgctxt "text_id=21067 | speaker=beo"
msgid "(It must be that shady guy just earlier!)"
msgstr "「“うん、さっきの男が怪しいよね！”」"

#. Occurrence SP1:9013:21068: scene=SP1
#: SP1:9013
msgctxt "text_id=21068 | speaker=unknown"
msgid "  Beo regained his composure and decided to follow the trail of the man's scent."
msgstr "　気を取り直して、先ほどの男の匂いを辿る事にした。"

#. Occurrence SP1:9033:21069: scene=SP1
#: SP1:9033
msgctxt "text_id=21069 | speaker=unknown"
msgid "  He had no idea that where he was going was his employer's worst nightmare."
msgstr "　行き着く先が雇い主にとって鬼門である事なぞ、無論、ベオには与り知らぬコトである。"

#. Occurrence SP1:9090:21070: scene=SP1
#: SP1:9090
msgctxt "text_id=21070 | speaker=unknown"
msgid "  Aida Church was set up to accept visitors any time of day, any day of the year."
msgstr "　唐突だが、<合田|あいだ>教会は年中無休、かつ、来る者拒まずの姿勢を貫いている。"

#. Occurrence SP1:9095:21071: scene=SP1
#: SP1:9095
msgctxt "text_id=21071 | speaker=unknown"
msgid "  The church was the savior of the lost and the poor, and recently had even ventured into the wedding industry for some extra income."
msgstr "　迷うもの、<貧|ひん>するものの味方であり、最近は小金稼ぎに<結|ブ><婚式|ライダル>業にまで手を出した。"

#. Occurrence SP1:9100:21072: scene=SP1
#: SP1:9100
msgctxt "text_id=21072 | speaker=unknown"
msgid "  It was closely involved with the public welfare of Misaki City and was doing fairly well for itself in that regard."
msgstr "　三咲市の福祉事業とも密接な関係にあり、運営はそれなりに順調だ。"

#. Occurrence SP1:9105:21073: scene=SP1
#: SP1:9105
msgctxt "text_id=21073 | speaker=unknown"
msgid "  However, there was one problem."
msgstr "　唯一の問題は、この通り、"

#. Occurrence SP1:9130:21074: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0000; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9130
msgctxt "text_id=21074 | speaker=yuika"
msgid "\"...Father Eiri is still not in?"
msgstr "「……詠梨神父はまた外出ですか。"

#. Occurrence SP1:9136:21075: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0001; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9136
msgctxt "text_id=21075 | speaker=yuika"
msgid "  Ritsuka is boycotting the Church, and we are losing volunteers with each passing day. I'm the only one working here at this point.\""
msgstr "　律架もサボタージュ、奉仕の生徒さんたちも日に日に減っていく一方……結局、労働力は私ひとりだけなのですね」"

#. Occurrence SP1:9142:21076: scene=SP1
#: SP1:9142
msgctxt "text_id=21076 | speaker=unknown"
msgid "  Even if their financial situation was stable, they seemed to be chronically understaffed."
msgstr "　台所事情は安泰でも、慢性的な人手不足だけは解消できないのだった。"

#. Occurrence SP1:9175:21077: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0002; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9175
msgctxt "text_id=21077 | speaker=yuika"
msgid "\"The people of this city lack faith."
msgstr "「だいたい、この街の人々は信心が足りなさすぎます。"

#. Occurrence SP1:9181:21078: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0003; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9181
msgctxt "text_id=21078 | speaker=yuika"
msgid "  What sort of life is spent demanding money in exchange for labor? Days spent chasing after material desires can only lead to a life of hollow wealth and mental poverty.\""
msgstr "　給金がなければ働けないなど、人生をなんだと思っているのでしょう。物欲だけで構成された一日を過ごしていては、<懐|ふところ>は豊かになっても心が貧しくなるだけでしょうに」"

#. Occurrence SP1:9206:21079: scene=SP1
#: SP1:9206
msgctxt "text_id=21079 | speaker=unknown"
msgid "  The nun muttered to herself quietly as she picked up the stepladder with one hand."
msgstr "　ひとり小言を口にしながら、シスターはひょい、と片手で<脚立|きゃたつ>を持ち上げた。"

#. Occurrence SP1:9211:21080: scene=SP1
#: SP1:9211
msgctxt "text_id=21080 | speaker=unknown"
msgid "  Although it was a proper stepladder they used for cleaning the church windows and weighed too much to be carried by even two strong adults, the mass didn't seem to faze her."
msgstr "　教会の窓掃除に使う本格的な脚立で、大の大人がふたりがかりでも手に余る重量なのだが、このシスターにはそのあたり気にならないようだ。"

#. Occurrence SP1:9245:21081: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0004; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9245
msgctxt "text_id=21081 | speaker=yuika"
msgid "\"The desolation of the hearts and minds of our flock is a concern, but we also mustn't forget the increasing costs of living. There are whispers of an impending sales tax, and Father Eiri must be convinced of the great results we can achieve in a single day if we hold more wedding ceremonies."
msgstr "「人々の心の<荒廃|こうはい>も気になりますが、物価の上昇も捨て置けません。消費税なるものの導入も<囁|ささや>かれますし、詠梨神父にはもっと、一日で驚異的な成果をあげる結婚式の素晴らしさを知っていただかないと。"

#. Occurrence SP1:9251:21082: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0005; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9251
msgctxt "text_id=21082 | speaker=yuika"
msgid "  He'll go out of his way to help anyone and everyone but won't think about the work that comes after that. What is he going to do about all those stray cats in the back garden? Ah, right, that and any other physical labor always falls to me, doesn't it?\""
msgstr "　あの人は<誰彼|だれかれ>何彼気分で世話をして、後の事とか考えませんから。裏庭に集まった野良猫たちはどうするんですか。ああ、私ですね、それも私が受け持つのですね。もうなんでもかんでも肉体労働は私なのですね」"

#. Occurrence SP1:9282:21083: scene=SP1
#: SP1:9282
msgctxt "text_id=21083 | speaker=unknown"
msgid "  This nun mumbling to herself at a near-constant pace was Sister Yuika Suse."
msgstr "　もはや完全な小言マシーンと化したシスターの名は、<周瀬|すせ><唯架|ゆいか>。"

#. Occurrence SP1:9287:21084: scene=SP1
#: SP1:9287
msgctxt "text_id=21084 | speaker=unknown"
msgid "  There was a reason for her unusual behavior."
msgstr "　普段の彼女からは考えられない光景だが、これにはちょっとした理由がある。"

#. Occurrence SP1:9307:21085: scene=SP1
#: SP1:9307
msgctxt "text_id=21085 | speaker=unknown"
msgid "  Yuika was completely blind and had honed her other senses to keenly perceive her surroundings."
msgstr "　彼女は盲目であるが故に、周囲の気配を察する<感覚|センス>が研ぎ澄まされている。"

#. Occurrence SP1:9312:21086: scene=SP1
#: SP1:9312
msgctxt "text_id=21086 | speaker=unknown"
msgid "  She was extremely sensitive to the presence of living creatures, particularly humans, and could detect when someone was within a radius of thirty feet."
msgstr "　生き物―――特に人間の気配には敏感で、驚くべき事に半径十メートル単位で人の在る無しを判断できる。"

#. Occurrence SP1:9317:21087: scene=SP1
#: SP1:9317
msgctxt "text_id=21087 | speaker=unknown"
msgid "  She could talk to herself so openly now because she did not sense anyone nearby."
msgstr "　いま、彼女が素の自分をさらけだしているのは、周囲に人がいないと感じ取っているからだ。"

#. Occurrence SP1:9356:21088: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0006; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9356
msgctxt "text_id=21088 | speaker=yuika"
msgid "\"Let's see... What leftover food do we have? Ah, there's that set of assorted jams we received as a gift."
msgstr "「ええっと、今日の余り物はっと……ああ、もらい物でジャムの詰め合わせがありましたね。"

#. Occurrence SP1:9362:21089: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0007; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9362
msgctxt "text_id=21089 | speaker=yuika"
msgid "  What shall we do, my Lord? Can a cat eat two-day-old bread that's rock hard? Ritsuka was clear about not giving them onions, if I remember correctly...\""
msgstr "　……どうなのでしょう、主よ。猫って二日経った岩のように堅いパンでもペーストすればいけるクチなんでしょうか。玉葱だけは出すな、と律架が言っていた気がしますが」"

#. Occurrence SP1:9382:21090: scene=SP1
#: SP1:9382
msgctxt "text_id=21090 | speaker=unknown"
msgid "  Sister Yuika was busy putting away the cleaning tools while simultaneously trying to prepare dinner for the hungry animals mewing in the back garden."
msgstr "　シスターは掃除器具の後片づけをしつつ、先ほどから裏庭でミャーミャーうるさい小動物たちの<夕餉|ゆうげ>の支度をする。"

#. Occurrence SP1:9387:21091: scene=SP1
#: SP1:9387
msgctxt "text_id=21091 | speaker=unknown"
msgid "  When suddenly..."
msgstr "　と。"

#. Occurrence SP1:9399:21092: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0008; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9399
msgctxt "text_id=21092 | speaker=yuika"
msgid "\"Oh? Do we have a new lost child among us?\""
msgstr "「おや？　新しい迷子ですか？」"

#. Occurrence SP1:9404:21093: scene=SP1
#: SP1:9404
msgctxt "text_id=21093 | speaker=unknown"
msgid "  Sister Yuika suddenly sensed the presence of a small dog in the church."
msgstr "　盲目のシスターは、ひょこっと教会に現れた、小型犬の気配を感じ取った。"

#. Occurrence SP1:9437:21094: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0009; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9437
msgctxt "text_id=21094 | speaker=yuika"
msgid "\"I'm sorry, little one, but today is for cats only. If I throw you in with that bunch, they'll be too surprised to eat."
msgstr "「ごめんなさい、今日は猫限定の日なの。キミがまざってしまったら猫どもが驚くわ。"

#. Occurrence SP1:9443:21095: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0010; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9443
msgctxt "text_id=21095 | speaker=yuika"
msgid "  I'll give you some food, but you'll have to wait until next time to come inside. We can't be taking in any more animals tonight.\""
msgstr "　餌ならここで恵んであげますから、中に入るのはまた今度にしてくださいね。それ以上入ったら向かいの家の屋根あたりまでご退場願いますよ」"

#. Occurrence SP1:9463:21096: scene=SP1
#: SP1:9463
msgctxt "text_id=21096 | speaker=unknown"
msgid "  She put her foot in front of the small brown dog to stop him from coming any further inside the church's gate."
msgstr "　教会の門をくぐろうとする茶色の小型犬を、シスターは足で押しとどめる。"

#. Occurrence SP1:9468:21097: scene=SP1
#: SP1:9468
msgctxt "text_id=21097 | speaker=unknown"
msgid "  Yuika was somewhat rougher in her treatment of non-human creatures."
msgstr "　人間でないものには扱いが少々乱暴な唯架だった。"

#. Occurrence SP1:9503:21098: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0053; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:9503
msgctxt "text_id=21098 | speaker=beo"
msgid "(What is this irritating creature?)"
msgstr "「“なにこの<辛気|しんき>くさい生き物？”」"

#. Occurrence SP1:9509:21099: scene=SP1
#: SP1:9509
msgctxt "text_id=21099 | speaker=unknown"
msgid "  Beo, who'd convinced himself to transform into a small dog instead of a wolf like he really wanted, only saw Sister Yuika as an obstacle in his way."
msgstr "　一方、小型犬―――狼の信念はとりあえず隅に追いやった―――に変身したベオは、シスターを障害物としか見ていなかった。"

#. Occurrence SP1:9529:21100: scene=SP1
#: SP1:9529
msgctxt "text_id=21100 | speaker=unknown"
msgid "  He could smell the scent of the man in black ahead, further inside."
msgstr "　黒い男の匂いはこの先に続いている。"

#. Occurrence SP1:9534:21101: scene=SP1
#: SP1:9534
msgctxt "text_id=21101 | speaker=unknown"
msgid "  Beo thought little of humans, and in this moment Sister Yuika was simply an obstacle."
msgstr "　人間なぞどうでもいいカレにとって、立ちふさがるシスターは電柱以下の造形物にすぎない。"

#. Occurrence SP1:9539:21102: scene=SP1
#: SP1:9539
msgctxt "text_id=21102 | speaker=unknown"
msgid "  So naturally, he ignored her warnings and attempted to push through the gate."
msgstr "　なので当然、シスターの言葉なぞ無視して門をすり抜けようとする。"

#. Occurrence SP1:9572:21103: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0011; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9572
msgctxt "text_id=21103 | speaker=yuika"
msgid "\"...Hm? W-what is this color?"
msgstr "「……え。な、なんでしょう、この色。"

#. Occurrence SP1:9578:21104: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0012; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9578
msgctxt "text_id=21104 | speaker=yuika"
msgid "  This dog is a most unusual color... Perhaps it's a rare exotic breed, in which case...\""
msgstr "　この子、すごい色していますけど……もしかして高級な品種なのでしょうか……だとしたら……」"

#. Occurrence SP1:9584:21105: scene=SP1
#: SP1:9584
msgctxt "text_id=21105 | speaker=unknown"
msgid "  He might be some wealthy person's pet."
msgstr "　どこぞのお金持ちのペットかもしれない。"

#. Occurrence SP1:9589:21106: scene=SP1
#: SP1:9589
msgctxt "text_id=21106 | speaker=unknown"
msgid "  Since the dog came to the church, its rich owner might also attend church services..."
msgstr "　教会に来るという事は、礼拝に来る裕福層の飼い犬である可能性もある。"

#. Occurrence SP1:9594:21107: scene=SP1
#: SP1:9594
msgctxt "text_id=21107 | speaker=unknown"
msgid "  Yuika stopped trying to push the dog away from the gate."
msgstr "　これは無下にはできない、と蹴りだそうとした足を止める唯架だった。"

#. Occurrence SP1:9634:21108: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0013; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9634
msgctxt "text_id=21108 | speaker=yuika"
msgid "\"I'm sorry. I'm sure you're here to see Father Eiri, but he's still out at the moment. I'll give you the best food we have today if you just run on along home, okay?\""
msgstr "「ごめんなさいね。詠梨神父が目当てなんでしょうけど、また出かけてしまったの。今日いちばんの餌をあげますから、大人しく帰ってくださいません？」"

#. Occurrence SP1:9640:21109: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0054; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:9640
msgctxt "text_id=21109 | speaker=beo"
msgid "(Ugh, what an annoying, irritating woman!"
msgstr "「“ああもう、邪魔、この辛気くさい人！"

#. Occurrence SP1:9640:21110: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0054; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:9640
msgctxt "text_id=21110 | speaker=beo"
msgid "  Perfect, nobody's around. I'll just go for her throa-)"
msgstr "　よし、まわりに誰もいないし、首を噛み折ろ―――”」"

#. Occurrence SP1:9675:21111: scene=SP1
#: SP1:9675
msgctxt "text_id=21111 | speaker=unknown"
msgid "  Beo's front legs stopped suddenly before he could launch himself at Sister Yuika.  "
msgstr "　飛びかかろうとしたベオの前脚が、急停止する。　"

#. Occurrence SP1:9681:21112: scene=SP1
#: SP1:9681
msgctxt "text_id=21112 | speaker=unknown"
msgid "  Pop."
msgstr "　カパッ。"

#. Occurrence SP1:9687:21113: scene=SP1
#: SP1:9687
msgctxt "text_id=21113 | speaker=unknown"
msgid "  Sister Yuika opened the lid of the bottle she held and poured out a glimmering liquid into a small dish."
msgstr "　シスターは手にした瓶の蓋をあけて、キラキラ光る液体状のものを小皿にそそいで、"

msgctxt "text_id=21114 | speaker=unknown"
msgid " She set it down in front of the dog."
msgstr "小型犬の前に差しだした。"

#. Occurrence SP1:9722:21115: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0055; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:9722
msgctxt "text_id=21115 | speaker=beo"
msgid "(Umm...)"
msgstr "「“えっと―――”」"

#. Occurrence SP1:9728:21116: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0014; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9728
msgctxt "text_id=21116 | speaker=yuika"
msgid "\"Here you go. Eat up!\""
msgstr "「ほら、お食べ」"

#. Occurrence SP1:9752:21117: scene=SP1
#: SP1:9752
msgctxt "text_id=21117 | speaker=unknown"
msgid "  The mysterious, unknown liquid sat in front of Beo."
msgstr "　差し出された正体不明の液体。"

#. Occurrence SP1:9757:21118: scene=SP1
#: SP1:9757
msgctxt "text_id=21118 | speaker=unknown"
msgid "  It smelled like nothing he'd ever smelled before."
msgstr "　それはまたしても、カレにとってはじめて嗅ぐ匂いだった。"

#. Occurrence SP1:9762:21119: scene=SP1
#: SP1:9762
msgctxt "text_id=21119 | speaker=unknown"
msgid "  Beo was known to let curiosity get the best of him."
msgstr "　好奇心にはひたすらに弱いベオである。"

#. Occurrence SP1:9767:21120: scene=SP1
#: SP1:9767
msgctxt "text_id=21120 | speaker=unknown"
msgid "  Even if it was poisoned, no poison of the natural world could harm him."
msgstr "　たとえ毒が入っていようと、自然界の毒ならカレには通じない。"

#. Occurrence SP1:9772:21121: scene=SP1
#: SP1:9772
msgctxt "text_id=21121 | speaker=unknown"
msgid "  He lapped up a mouthful."
msgstr "　ぺろりと一口舐める。"

#. Occurrence SP1:9807:21122: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0056; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:9807
msgctxt "text_id=21122 | speaker=beo"
msgid "(...W-what...)"
msgstr "「“――――――なに”」"

#. Occurrence SP1:9812:21123: scene=SP1
#: SP1:9812
msgctxt "text_id=21123 | speaker=unknown"
msgid "  He lapped up a little more."
msgstr "　すこし舐める。"

#. Occurrence SP1:9818:21124: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0057; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:9818
msgctxt "text_id=21124 | speaker=beo"
msgid "(...is this...)"
msgstr "「“――――――この”」"

#. Occurrence SP1:9823:21125: scene=SP1
#: SP1:9823
msgctxt "text_id=21125 | speaker=unknown"
msgid "  He lapped up even more."
msgstr "　さらに舐める。"

#. Occurrence SP1:9829:21126: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0058; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:9829
msgctxt "text_id=21126 | speaker=beo"
msgid "(...flavor!?)"
msgstr "「“――――――あじ！”」"

#. Occurrence SP1:9834:21127: scene=SP1
#: SP1:9834
msgctxt "text_id=21127 | speaker=unknown"
msgid "  He lapped up more and more."
msgstr "　もっと舐める。"

#. Occurrence SP1:9865:21128: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0015; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9865
msgctxt "text_id=21128 | speaker=yuika"
msgid "\"My, my! You're lapping that up like it was milk!"
msgstr "「おや。牛乳を飲むような舐めっぷり。"

#. Occurrence SP1:9865:21129: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0015; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9865
msgctxt "text_id=21129 | speaker=yuika"
msgid "  I think I might actually like you, even though you are a dog.\""
msgstr "　犬ながら惚れ惚れします」"

#. Occurrence SP1:9871:21130: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0059; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:9871
msgctxt "text_id=21130 | speaker=beo"
msgid "(I want more!)"
msgstr "「“これ、もっとほしい！”」"

#. Occurrence SP1:9877:21131: scene=SP1
#: SP1:9877
msgctxt "text_id=21131 | speaker=unknown"
msgid "  The church became filled with the echoes of Beo's boisterous barking."
msgstr "　夕暮れの教会に、ワン、と元気な吠え声が響きわたる。"

#. Occurrence SP1:9882:21132: scene=SP1
#: SP1:9882
msgctxt "text_id=21132 | speaker=unknown"
msgid "  At this point he'd completely forgotten about the man's scent."
msgstr "　この時点で、ベオにとって男の匂いなぞどうでもいい物になっていた。"

#. Occurrence SP1:9909:21133: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0016; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9909
msgctxt "text_id=21133 | speaker=yuika"
msgid "\"Hehe, it's sweet and delicious, isn't it? I'm impressed."
msgstr "「ふふ、甘いですか？　私も感動しました。"

#. Occurrence SP1:9909:21134: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_SP1_0016; voice_prefix=B20; voice_category=10; scene=SP1
#: SP1:9909
msgctxt "text_id=21134 | speaker=yuika"
msgid "  I didn't know dogs could have such a sweet tooth.\""
msgstr "　犬どもにも甘味をたしなむ心があるのですね」"

#. Occurrence SP1:9928:21135: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0060; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:9928
msgctxt "text_id=21135 | speaker=beo"
msgid "(Sweet? Is this what sweet takes like?)"
msgstr "「“甘い？　これが甘いってコト？”」"

#. Occurrence SP1:9934:21136: scene=SP1
#: SP1:9934
msgctxt "text_id=21136 | speaker=unknown"
msgid "  Beo looked up at Sister Yuika as she whispered to him."
msgstr "　シスターの呟きに、ベオはハッと顔をあげた。"

#. Occurrence SP1:9939:21137: scene=SP1
#: SP1:9939
msgctxt "text_id=21137 | speaker=unknown"
msgid "  He had the feeling that sweet was an important word he should remember."
msgstr "　今の単語はなんだか大切な気がする。"

#. Occurrence SP1:9944:21138: scene=SP1
#: SP1:9944
msgctxt "text_id=21138 | speaker=unknown"
msgid "  This food sent a sensation through him that was like a flash of lightning."
msgstr "　そもそもこの食べ物が閃光のような衝撃だった。"

#. Occurrence SP1:9986:21139: scene=SP1
#: SP1:9986
msgctxt "text_id=21139 | speaker=unknown"
msgid "  Until this point, eating food had been nothing more than a process of refueling."
msgstr "　ベオにとって、食事は燃料補給のパターンの一つにすぎない。"

#. Occurrence SP1:9991:21140: scene=SP1
#: SP1:9991
msgctxt "text_id=21140 | speaker=unknown"
msgid "  He liked hamburgers, but that never amounted to more than a preference for a particular mouthfeel. He only ate because he needed the nutrition."
msgstr "　ハンバーガーのえり好みはあるが、あれはあくまで“噛みごこち”の良し悪しだった。どうせ栄養摂取をしなくちゃいけないのだから、仕方なく食べているにすぎない。"

#. Occurrence SP1:9997:21141: scene=SP1
#: SP1:9997
msgctxt "text_id=21141 | speaker=unknown"
msgid "  But this was different. This food was not necessary to his survival."
msgstr "　が、これは違う。肉食動物の“命”を燃料にするカレにとって、この食べ物はまったく意味がない。"

#. Occurrence SP1:10029:21142: scene=SP1
#: SP1:10029
msgctxt "text_id=21142 | speaker=unknown"
msgid "  And yet he knew he wanted more."
msgstr "　けれど、もっと食べたい。"

#. Occurrence SP1:10034:21143: scene=SP1
#: SP1:10034
msgctxt "text_id=21143 | speaker=unknown"
msgid "  He didn't really need it, but it made him feel good."
msgstr "　必要はないけど、これはなんていうか、すごく気持ちのいいものだ。"

#. Occurrence SP1:10039:21144: scene=SP1
#: SP1:10039
msgctxt "text_id=21144 | speaker=unknown"
msgid "  It was like food for his soul rather than his body."
msgstr "　体ではなく、心の栄養になるような。"

#. Occurrence SP1:10060:21145: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0061; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10060
msgctxt "text_id=21145 | speaker=beo"
msgid "(Wait, isn't this smell...)"
msgstr "「“―――あれ、そもそもこの匂いって―――”」"

#. Occurrence SP1:10066:21146: scene=SP1
#: SP1:10066
msgctxt "text_id=21146 | speaker=unknown"
msgid "  He stopped wagging his tail."
msgstr "　むむ、と振りまくっていた尻尾が止まる。"

#. Occurrence SP1:10071:21147: scene=SP1
#: SP1:10071
msgctxt "text_id=21147 | speaker=unknown"
msgid "  The golden wolf in the form of a small dog sat with the food that was the very origin of his name in front of him. Beowulf was faced with a difficult problem he was unable to solve."
msgstr "　小型犬に<扮|ふん>した黄金の狼は、自分の名前の由来である食べ物を前にして、解けない難問につきあたるのだった。"

#. Occurrence SP1:10155:21148: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0062; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10155
msgctxt "text_id=21148 | speaker=beo"
msgid "\"I'm home!\""
msgstr "「ただいまー」"

#. Occurrence SP1:10174:21149: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0120; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10174
msgctxt "text_id=21149 | speaker=touko"
msgid "\"Welcome back, Beo."
msgstr "「はい、お帰りなさいベオくん。"

#. Occurrence SP1:10180:21150: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0121; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10180
msgctxt "text_id=21150 | speaker=touko"
msgid "  I was worried about you. It's late! As your trainer and master, I have to punish you for staying out so late without checking in with me. Kneel right there.\""
msgstr "　遅いお帰りにお姉さん心配しちゃった。こんな時間まで無断外出とか心配したゾ。教育係<兼|けん>飼い主として、バッボーイしなくちゃいけないからそこに正座」"

#. Occurrence SP1:10201:21151: scene=SP1
#: SP1:10201
msgctxt "text_id=21151 | speaker=unknown"
msgid "  Beo had transformed back into human form and returned to the workshop. Touko was waiting there for him with a big, strained smile on her face."
msgstr "　ベオがヒト形に変身して工房に戻ると、笑顔でこめかみをひくつかせた蒼崎橙子が待っていた。"

#. Occurrence SP1:10225:21152: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0063; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10225
msgctxt "text_id=21152 | speaker=beo"
msgid "\"Ah, right.\""
msgstr "「あ、そうか」"

#. Occurrence SP1:10230:21153: scene=SP1
#: SP1:10230
msgctxt "text_id=21153 | speaker=unknown"
msgid "  Beo knew he had messed up."
msgstr "　失敗しちゃった、とベオは素直に反省する。"

#. Occurrence SP1:10235:21154: scene=SP1
#: SP1:10235
msgctxt "text_id=21154 | speaker=unknown"
msgid "  He had failed to get back home before Touko because of Sister Yuika."
msgstr "　シスターとの一件で、先回りして帰る事を失念していた。"

#. Occurrence SP1:10262:21155: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0064; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10262
msgctxt "text_id=21155 | speaker=beo"
msgid "\"Aw, do I really have to kneel in the corner?"
msgstr "「えー、正座はいやですー。"

#. Occurrence SP1:10268:21156: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0065; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10268
msgctxt "text_id=21156 | speaker=beo"
msgid "  I was out late, but nobody saw me! I wasn't doing anything bad!\""
msgstr "　そりゃあ無断で外に出てたけど、誰にも見つかってないし。別にボク、悪いことしてないし」"

#. Occurrence SP1:10274:21157: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0122; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10274
msgctxt "text_id=21157 | speaker=touko"
msgid "\"Are you sure nobody saw you?"
msgstr "「誰にも見つかっていない？"

#. Occurrence SP1:10280:21158: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0123; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10280
msgctxt "text_id=21158 | speaker=touko"
msgid "  Were you out playing in the mountains?\""
msgstr "　ってコトはベオくん、裏山で遊んでたの？」"

#. Occurrence SP1:10292:21159: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0066; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10292
msgctxt "text_id=21159 | speaker=beo"
msgid "\"No, I was in town. But nobody noticed me, I'm sure of it. I was actually following you!\""
msgstr "「ううん、裏山じゃなくて町。気付かなかったでしょ、実はトーコさんを尾行していただけなのです！」"

#. Occurrence SP1:10325:21160: scene=SP1
#: SP1:10325
msgctxt "text_id=21160 | speaker=unknown"
msgid "  Touko froze at Beo's completely unexpected response."
msgstr "　予想外の返答に固まる橙子。"

#. Occurrence SP1:10335:21161: scene=SP1
#: SP1:10335
msgctxt "text_id=21161 | speaker=unknown"
msgid "  But, she was used to him by now. She just sighed and rubbed her head, now throbbing from a terrible headache."
msgstr "　が、さすがにカレの扱いには慣れたものなのか、そう、とため息で頭痛を押さえこんだ。"

#. Occurrence SP1:10356:21162: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0124; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10356
msgctxt "text_id=21162 | speaker=touko"
msgid "\"...Fine. I suppose I was the one who taught you that nothing's bad, as long as you don't get caught. I also never explicitly told you that you couldn't follow me, so I'll let this one slide."
msgstr "「……いいでしょう。見つからなければ<悪戯|いたずら>じゃない、と教えたのは私だしね。主人の尾行禁止、とは命令していなかったし。今回の尾行については不問に付します。"

#. Occurrence SP1:10367:21163: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0125; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10367
msgctxt "text_id=21163 | speaker=touko"
msgid "  But how did you avoid being noticed? I'm pretty sure you would've drawn attention to yourself in that form.\""
msgstr "　でも、どうやって人目を避けたの？　その格好だったらさすがに気付くと思うんだけど、私」"

#. Occurrence SP1:10402:21164: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0067; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10402
msgctxt "text_id=21164 | speaker=beo"
msgid "\"That's my trade secret. If I told you, then I won't be able to see you like I did today. You looked like you were really having fun with that person.\""
msgstr "「そこはキギョウヒミツです。教えたら今日みたいなトーコさん、もう見れなくなっちゃうし。楽しそうだったよね、あのヒトと」"

#. Occurrence SP1:10421:21165: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0126; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10421
msgctxt "text_id=21165 | speaker=touko"
msgid "\"...!\""
msgstr "「……！」"

#. Occurrence SP1:10437:21166: scene=SP1
#: SP1:10437
msgctxt "text_id=21166 | speaker=unknown"
msgid "  Touko's response was both honest and out of character."
msgstr "　らしくなく、素直に反応する橙子。"

#. Occurrence SP1:10442:21167: scene=SP1
#: SP1:10442
msgctxt "text_id=21167 | speaker=unknown"
msgid "  Even Beo was surprised at how taken aback she was by his statement."
msgstr "　そんな雇い主の動揺に、ベオも意表をつかれてしまった。"

#. Occurrence SP1:10477:21168: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0127; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10477
msgctxt "text_id=21168 | speaker=touko"
msgid "\"That wasn't fun. I don't know what kind of weird idea you got from that, but it was a negotiation. I was simply holding the entire town hostage to keep him from interfering as a priest of the Church, and...\""
msgstr "「それは違う。どんな勘違いをしたのか知らないけど、アレはただの交渉よ。教会の神父相手に、町を人質に見立てて不干渉を念押ししただけで、」"

#. Occurrence SP1:10483:21169: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0068; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10483
msgctxt "text_id=21169 | speaker=beo"
msgid "\"Well, I was actually talking about the girl."
msgstr "「いや、楽しそうに見えたのは女のヒトの方だけど。"

#. Occurrence SP1:10489:21170: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0069; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10489
msgctxt "text_id=21170 | speaker=beo"
msgid "  The one that you left unable to move.\""
msgstr "　あの、全身ぐるぐる巻きに自分を縛ってた方」"

#. Occurrence SP1:10495:21171: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0128; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10495
msgctxt "text_id=21171 | speaker=touko"
msgid "\"Urgh...\""
msgstr "「むっ」"

#. Occurrence SP1:10530:21172: scene=SP1
#: SP1:10530
msgctxt "text_id=21172 | speaker=unknown"
msgid "  Woman and wolf stared at each other for a silent moment."
msgstr "　しばし無言で見つめ合う一人と一匹。"

#. Occurrence SP1:10535:21173: scene=SP1
#: SP1:10535
msgctxt "text_id=21173 | speaker=unknown"
msgid "  Beo looked satisfied with himself and his secret information."
msgstr "　野生のカレは、ふーん、と訳知り顔で納得して、"

#. Occurrence SP1:10547:21174: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0070; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10547
msgctxt "text_id=21174 | speaker=beo"
msgid "\"..."
msgstr "「………………。"

#. Occurrence SP1:10559:21175: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0071; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10559
msgctxt "text_id=21175 | speaker=beo"
msgid "  But I guess that means that guy's your mate, right?\""
msgstr "　つまり、アレってトーコさんのつがい？」"

#. Occurrence SP1:10578:21176: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0129; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10578
msgctxt "text_id=21176 | speaker=touko"
msgid "\"Ngh...!\""
msgstr "「っ……！」"

#. Occurrence SP1:10583:21177: scene=SP1
#: SP1:10583
msgctxt "text_id=21177 | speaker=unknown"
msgid "  Touko nearly choked at the utterly fearless question."
msgstr "　蒼崎橙子をして吹き出させる、神をも恐れぬ疑問を投げかけた。"

#. Occurrence SP1:10609:21178: scene=SP1
#: SP1:10609
msgctxt "text_id=21178 | speaker=unknown"
msgid "  The puppet master wordlessly removed her glasses and tamped down her emotions."
msgstr "　人形師は無言で眼鏡を外して、まなじりを強く押さえた。"

#. Occurrence SP1:10620:21179: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0130; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10620
msgctxt "text_id=21179 | speaker=touko"
msgid "\"Tell me, Beo, why do you even know that word?"
msgstr "「なんでそんな言葉だけ知ってるんだオマエは。"

#. Occurrence SP1:10620:21180: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0130; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10620
msgctxt "text_id=21180 | speaker=touko"
msgid "  There's no reason for you to know about such things.\""
msgstr "　<耳年増|みみどしま>にも程があるぞ」"

#. Occurrence SP1:10652:21181: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0072; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10652
msgctxt "text_id=21181 | speaker=beo"
msgid "\"Why wouldn't I? It's a word all creatures are familiar with."
msgstr "「こんなの、生き物としてフツーの言葉じゃない。"

#. Occurrence SP1:10658:21182: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0073; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10658
msgctxt "text_id=21182 | speaker=beo"
msgid "  ...Granted, I never thought of you as a normal creature, so I'm a little surprised myself."
msgstr "　……まあ、トーコさんがフツーの生き物だとは思っていなかったから、ボクとしても意外だけど。"

#. Occurrence SP1:10669:21183: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0074; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10669
msgctxt "text_id=21183 | speaker=beo"
msgid "  Anyway, who is that plain, potato-looking male anyway?\""
msgstr "　それで、どうなの？　あのパッとしないポテトみたいな<雄|おす>、なに？」"

#. Occurrence SP1:10689:21184: scene=SP1
#: SP1:10689
msgctxt "text_id=21184 | speaker=unknown"
msgid "  Beo was suddenly irritated."
msgstr "　何が気に食わないのか、ベオは唐突に不機嫌になった。"

#. Occurrence SP1:10694:21185: scene=SP1
#: SP1:10694
msgctxt "text_id=21185 | speaker=unknown"
msgid "  He was irritated, but he couldn't figure out why."
msgstr "　ベオ自身、自分が<苛|いら>ついている事は理解できたが、なぜ苛ついているのかまでは理解できていない。"

#. Occurrence SP1:10736:21186: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0131; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10736
msgctxt "text_id=21186 | speaker=touko"
msgid "\"He's literally nothing. To me, anyway. Your assessment is correct. He isn't worth thinking about, and he's not even good enough for you to eat.\""
msgstr "「何もなにも、オマエの言う通りしなびたフライドポテトだよ。少なくとも私にとってはね。気にする価値もないし、食べたくなるような魅力もない」"

#. Occurrence SP1:10747:21187: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0075; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10747
msgctxt "text_id=21187 | speaker=beo"
msgid "\"Really? He's just an enemy? And I'm the only special person in your life?\""
msgstr "「ホント？　ただの敵？　トーコさんにとって特別なのは、ボクだけ？」"

#. Occurrence SP1:10774:21188: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0132; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10774
msgctxt "text_id=21188 | speaker=touko"
msgid "\"For the time being, yes."
msgstr "「ああ、今のところはね。"

#. Occurrence SP1:10780:21189: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0133; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10780
msgctxt "text_id=21189 | speaker=touko"
msgid "  ...I thought it might rekindle something, but there was absolutely nothing there. I don't think I'll ever think about him like that again.\""
msgstr "　……やけぼっくいに火がつくかとも思ったが、完全に<湿気|しけ>っていた。アレを前にしてどうこう思うのは、もう二度とないだろうさ」"

#. Occurrence SP1:10791:21190: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0076; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10791
msgctxt "text_id=21190 | speaker=beo"
msgid "\"All right, then! If that's the case then I'll forget about it! Say, what do you mean by 'rekindle' anyway?\""
msgstr "「そっか！　なんでもないならもう忘れるコトにしまーす！　でも、ヤケボックイってなに？」"

#. Occurrence SP1:10826:21191: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0134; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10826
msgctxt "text_id=21191 | speaker=touko"
msgid "\"It's just when you think you can make a relationship like it was in the past."
msgstr "「思い出を蒸し返して、前後不覚におちいるコト。"

#. Occurrence SP1:10832:21192: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0135; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10832
msgctxt "text_id=21192 | speaker=touko"
msgid "  I mean, I guess there was a slight chance of that happening. He was my first love, after all.\""
msgstr "　ま、その可能性だって少しはあったと思うよ。あんなんでも、私の初恋の相手のようだし」"

#. Occurrence SP1:10838:21193: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0077; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10838
msgctxt "text_id=21193 | speaker=beo"
msgid "\"Huh?\""
msgstr "「へ？」"

#. Occurrence SP1:10843:21194: scene=SP1
#: SP1:10843
msgctxt "text_id=21194 | speaker=unknown"
msgid "  Beo had no firsthand experience with love, but he at least understood the concept of first love."
msgstr "　恋は未経験なれど、初恋の意味ぐらいは知っているベオだった。"

#. Occurrence SP1:10864:21195: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0078; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10864
msgctxt "text_id=21195 | speaker=beo"
msgid "\"YOU had a first love?!\""
msgstr "「ハツコイって、トーコさんに！？」"

#. Occurrence SP1:10870:21196: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0136; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10870
msgctxt "text_id=21196 | speaker=touko"
msgid "\"...I'm not sure why you think a mate is more believable than a first love."
msgstr "「……つがいはアリで初恋はナシとか、どれだけ私を動物的に観ているんだ、オマエは。"

#. Occurrence SP1:10876:21197: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0137; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10876
msgctxt "text_id=21197 | speaker=touko"
msgid "  It was a long time ago. I was still a teenager, and he had just started studying under my grandfather. He wasn't studying magecraft. He was just training under him to hone his mind.\""
msgstr "　昔の話だよ。私が十代になったばかりで、<詠梨|アレ>が祖父の弟子だった頃の話だ。ヤツは魔術ではなく、精神修行の一環として祖父と付き合っていたが」"

#. Occurrence SP1:10905:21198: scene=SP1
#: SP1:10905
msgctxt "text_id=21198 | speaker=unknown"
msgid "  Touko spoke indifferently, and it was clear from the look on her face that there was no longer any attachment there."
msgstr "　淡々と語る橙子の横顔から、未練らしきものは見られない。"

#. Occurrence SP1:10910:21199: scene=SP1
#: SP1:10910
msgctxt "text_id=21199 | speaker=unknown"
msgid "  Yet there was still a tenderness in her words that caused Beo to furrow his brow."
msgstr "　なのにこう、普段より<言霊|ことだま>に温かみがある、とベオは眉を曇らせた。"

#. Occurrence SP1:10946:21200: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0079; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:10946
msgctxt "text_id=21200 | speaker=beo"
msgid "\"Miss Touko... do you still like him?\""
msgstr "「トーコさん、まだスキなわけ？」"

#. Occurrence SP1:10957:21201: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0138; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10957
msgctxt "text_id=21201 | speaker=touko"
msgid "\"No. I was surprised at how little I felt for him."
msgstr "「いや。自分でも呆れるぐらい何もなかった。"

#. Occurrence SP1:10963:21202: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0139; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10963
msgctxt "text_id=21202 | speaker=touko"
msgid "  There's just this remnant of my adolescence there. Just talking to people I know from that time takes me back, you know?"
msgstr "　ただ青春の幻影というのかな。そういう頃の象徴のような知人とは、話すだけで懐かしいものなんだよ。"

#. Occurrence SP1:10969:21203: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0140; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:10969
msgctxt "text_id=21203 | speaker=touko"
msgid "  I'm not attracted to him at all anymore as a person. But when I talk to him, I can remember that past version of myself so clearly it makes me want to laugh.\""
msgstr "　人間的にはまったく魅力を感じなくなったが、ヤツと話しているだけで、こう、昔の自分を思い返して笑いたくなる」"

#. Occurrence SP1:10989:21204: scene=SP1
#: SP1:10989
msgctxt "text_id=21204 | speaker=unknown"
msgid "  Beo grew only more confused as Touko spoke with such passion."
msgstr "　<感慨|かんがい>深く語る橙子に、ベオはますます首を<傾|かし>げる。"

#. Occurrence SP1:10994:21205: scene=SP1
#: SP1:10994
msgctxt "text_id=21205 | speaker=unknown"
msgid "  He couldn't wrap his head around the concept that she hated him yet somehow also still liked him."
msgstr "　すごく嫌いなのにわりと好き、というのは理屈に合わない気がするからだ。"

#. Occurrence SP1:11021:21206: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0080; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11021
msgctxt "text_id=21206 | speaker=beo"
msgid "\"I don't get it.\""
msgstr "「そういうの、ボク分かんないなー」"

#. Occurrence SP1:11033:21207: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0141; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:11033
msgctxt "text_id=21207 | speaker=touko"
msgid "\"That's because you don't have likes or dislikes. Sometimes you can't use logic to understand human relationships.\""
msgstr "「オマエには好き嫌いがないからな。<理屈|ロジック>だけじゃヒトの関係は解けないよ」"

#. Occurrence SP1:11045:21208: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0081; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11045
msgctxt "text_id=21208 | speaker=beo"
msgid "\"I do too have likes and dislikes!"
msgstr "「そんなのありますー！"

#. Occurrence SP1:11045:21209: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0081; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11045
msgctxt "text_id=21209 | speaker=beo"
msgid "  There are certain foods that I like more than others, you know!\""
msgstr "　食べ物だってえり好みするじゃんか、ボク！」"

#. Occurrence SP1:11082:21210: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0142; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:11082
msgctxt "text_id=21210 | speaker=touko"
msgid "\"You only work on the standard of whether something is useful or not."
msgstr "「オマエの基準は有益か無益かだけだろ。"

#. Occurrence SP1:11088:21211: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0143; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:11088
msgctxt "text_id=21211 | speaker=touko"
msgid "  Wild animals only use taste as a sensor to measure how nutritious something is."
msgstr "　野生動物にとって味覚は、十分な栄養値があるかないかを測るセンサーでしかない。"

#. Occurrence SP1:11094:21212: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0144; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:11094
msgctxt "text_id=21212 | speaker=touko"
msgid "  Only humans eat for reasons other than pure nutritional value."
msgstr "　栄養値を度外視して食事をとるのは人間だけだ。"

#. Occurrence SP1:11100:21213: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0145; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:11100
msgctxt "text_id=21213 | speaker=touko"
msgid "  Some of the food we like doesn't help sustain us. We eat what we eat because we enjoy it. That's also why things we like look sweet.\""
msgstr "　……自分の体に合っているからその食材を好む、ではないんだよ。ヒトは \"楽しい\" か \"楽しくない\" かで食事をとる。好きなものが甘く見えるのはその為だ」"

#. Occurrence SP1:11131:21214: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0082; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11131
msgctxt "text_id=21214 | speaker=beo"
msgid "\"Things you like look sweet?\""
msgstr "「甘いもの―――好きなものって、甘く見えるの？」"

#. Occurrence SP1:11137:21215: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0146; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:11137
msgctxt "text_id=21215 | speaker=touko"
msgid "\"I mean, that was just an example. But we don't look at something we like and think it's bitter. Well, maybe some people do, I don't know."
msgstr "「物の喩えだが、苦くは見えないだろ。……まあ、ヒトによってはそれもありだが。"

#. Occurrence SP1:11143:21216: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0147; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:11143
msgctxt "text_id=21216 | speaker=touko"
msgid "  It all depends on what you're into, I guess."
msgstr "　そのあたりはアレだな、性癖の問題だ。"

#. Occurrence SP1:11149:21217: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0148; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:11149
msgctxt "text_id=21217 | speaker=touko"
msgid "  It's like 'what came first, the chicken or the egg?' Is something sweet because we like it, or do we like it because it's sweet?\""
msgstr "　たまごが先か、にわとりが先かの話さ。好きだから甘いのか、甘いから好きなのか、とね」"

#. Occurrence SP1:11176:21218: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0083; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11176
msgctxt "text_id=21218 | speaker=beo"
msgid "\"Yeah, but, I don't think you look sweet.\""
msgstr "「でもボク、トーコさんは甘く見えないけど」"

#. Occurrence SP1:11197:21219: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0149; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:11197
msgctxt "text_id=21219 | speaker=touko"
msgid "\"Of course not! You're not actually 'alive!'"
msgstr "「そりゃそうだろ。そもそもオマエはまだ“生きて”いないからな。"

#. Occurrence SP1:11203:21220: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0150; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:11203
msgctxt "text_id=21220 | speaker=touko"
msgid "  You exist, but you're not really alive. There's a difference."
msgstr "　在るだけのモノと、生きているコトはまた別の話だ。"

#. Occurrence SP1:11209:21221: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0151; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:11209
msgctxt "text_id=21221 | speaker=touko"
msgid "  It's kind of ironic, actually. If you were to ever figure that difference out, you wouldn't be invincible anymore.\""
msgstr "　皮肉な話だがね。その違いを知った時、オマエは無敵ではなくなるよ、ベオ」"

#. Occurrence SP1:11220:21222: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0084; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11220
msgctxt "text_id=21222 | speaker=beo"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence SP1:11245:21223: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_SP1_0152; voice_prefix=A20; voice_category=11; scene=SP1
#: SP1:11245
msgctxt "text_id=21223 | speaker=touko"
msgid "\"Anyway, it's time for dinner. I won a lot today, so I bought some nice marbled beef for you.\""
msgstr "「さ、夕食だ。今日も大勝したからな、<霜降|しもふ>りのいいところを買ってきたぞ」"

#. Occurrence SP1:11263:21224: scene=SP1
#: SP1:11263
msgctxt "text_id=21224 | speaker=unknown"
msgid "  Touko walked into the classroom, back in her usual mood."
msgstr "　雇い主はいつもの調子で教室に入っていった。"

#. Occurrence SP1:11268:21225: scene=SP1
#: SP1:11268
msgctxt "text_id=21225 | speaker=unknown"
msgid "  Beo lingered in the hallway looking dejected."
msgstr "　ベオは浮かない顔で廊下に佇む。"

#. Occurrence SP1:11273:21226: scene=SP1
#: SP1:11273
msgctxt "text_id=21226 | speaker=unknown"
msgid "\"You're not actually alive!\""
msgstr "“オマエはまだ生きていない”"

#. Occurrence SP1:11278:21227: scene=SP1
#: SP1:11278
msgctxt "text_id=21227 | speaker=unknown"
msgid "  Those words pierced right through Beo's heart, but he didn't quite know why yet."
msgstr "　その台詞はベオの心をざわめかせたが、なぜそう思うのか、今のカレには分からない。"

#. Occurrence SP1:11312:21228: scene=SP1
#: SP1:11312
msgctxt "text_id=21228 | speaker=unknown"
msgid "  Three weeks would pass before he got a hint of why that was the case."
msgstr "　その答えの手がかりを得るのは、これから約三週間後。"

#. Occurrence SP1:11317:21229: scene=SP1
#: SP1:11317
msgctxt "text_id=21229 | speaker=unknown"
msgid "  Lugh Beowulf was perfect..."
msgstr "　完全であるルゥ・ベオウルフが、"

#. Occurrence SP1:11322:21230: scene=SP1
#: SP1:11322
msgctxt "text_id=21230 | speaker=unknown"
msgid "  ...and yet he would lose,"
msgstr "　まったく完全でない生き物に、"

#. Occurrence SP1:11322:21231: scene=SP1
#: SP1:11322
msgctxt "text_id=21231 | speaker=unknown"
msgid "  at the hands of a particularly imperfect creature."
msgstr "　あっさり黒星をつけられた後のコトになる。"

#. Occurrence SP1:11377:21232: scene=SP1
#: SP1:11377
msgctxt "text_id=21232 | speaker=unknown"
msgid "  The sound of a phone ringing echoed through the empty hallways of the school."
msgstr "　無人の校舎に場違いな<呼び鈴|コール>が響き渡る。"

#. Occurrence SP1:11399:21233: scene=SP1
#: SP1:11399
msgctxt "text_id=21233 | speaker=unknown"
msgid "  It was January, and both the mage who had remodeled the building,"
msgstr "　建物を改築した主も、"

#. Occurrence SP1:11404:21234: scene=SP1
#: SP1:11404
msgctxt "text_id=21234 | speaker=unknown"
msgid "  and the Magician who had expelled her from it, were long gone."
msgstr "　その主を撃退した魔法使いも退場して<久|ひさ>しい、一月某日。"

#. Occurrence SP1:11409:21235: scene=SP1
#: SP1:11409
msgctxt "text_id=21235 | speaker=unknown"
msgid "  The telephone that Touko had installed on a whim rang and rang without letting up, as if it knew for sure that someone was there to answer it."
msgstr "　蒼崎橙子が気まぐれで取り付けていった電話機は、そこに誰かがいる事を確信しているように、飽きることなく鳴り続けていた。"

#. Occurrence SP1:11438:21236: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0085; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11438
msgctxt "text_id=21236 | speaker=beo"
msgid "\"Argh, shut up!\""
msgstr "「ああもう、うるさいなあ」"

#. Occurrence SP1:11444:21237: scene=SP1
#: SP1:11444
msgctxt "text_id=21237 | speaker=unknown"
msgid "  Something rustled inside."
msgstr "　そんな中、ごそり、と動く気配があった。"

#. Occurrence SP1:11449:21238: scene=SP1
#: SP1:11449
msgctxt "text_id=21238 | speaker=unknown"
msgid "  There were definitely no people inside the school building, but there was one non-human creature sleeping there."
msgstr "　校舎は無人には違いないが、人間ではないモノが一つ、いまだ<寝床|ねどこ>にしていたらしい。"

#. Occurrence SP1:11498:21239: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0086; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11498
msgctxt "text_id=21239 | speaker=beo"
msgid "\"Hi, you've reached the Misaki branch of the Hollow Shrine."
msgstr "「はい、こちらガランノドウ第二出張店ー。"

#. Occurrence SP1:11504:21240: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0087; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11504
msgctxt "text_id=21240 | speaker=beo"
msgid "  The owner has run away with her tail between her legs and is currently unavailable, so please leave a message after the... ah, Miss Touko?"
msgstr "　店主はシッポまいて逃げだしたアトですので、ご用のある方は発信音のアトにメッセージを――あ、トーコさん？"

#. Occurrence SP1:11510:21241: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0088; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11510
msgctxt "text_id=21241 | speaker=beo"
msgid "  Ah, yes, yes. That's fine. Have a good trip. Don't worry about me.\""
msgstr "　うん、はいはい。どーぞ行ってらっしゃい、ボクのコトはお構いなく」"

#. Occurrence SP1:11548:21242: scene=SP1
#: SP1:11548
msgctxt "text_id=21242 | speaker=unknown"
msgid "  The classroom was occupied by a young boy with blond hair."
msgstr "　教室に居たのは金髪の少年だ。"

#. Occurrence SP1:11553:21243: scene=SP1
#: SP1:11553
msgctxt "text_id=21243 | speaker=unknown"
msgid "  Even before the phone rang, he was in human form."
msgstr "　ソレは呼び鈴が鳴る前からヒトの姿をしていた。"

#. Occurrence SP1:11558:21244: scene=SP1
#: SP1:11558
msgctxt "text_id=21244 | speaker=unknown"
msgid "  It used to be that when he was alone, he would always doze off in his wolf form. But not anymore."
msgstr "　かつて、ひとりきりでいる時は狼の姿で微睡みに落ちていたが、今は違う。"

#. Occurrence SP1:11563:21245: scene=SP1
#: SP1:11563
msgctxt "text_id=21245 | speaker=unknown"
msgid "  There was no real need for him to stay in his human form, but he did anyway."
msgstr "　ソレはそうである必要もないのに、ヒトのカタチを維持している。"

#. Occurrence SP1:11568:21246: scene=SP1
#: SP1:11568
msgctxt "text_id=21246 | speaker=unknown"
msgid "  It was now his normal state of being when he was not in combat."
msgstr "　どのような心境の変化か、戦闘時以外はこちらの姿を“平常”に切り替えていた。"

#. Occurrence SP1:11594:21247: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0089; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11594
msgctxt "text_id=21247 | speaker=beo"
msgid "\"Just call me if you need anything. I know my contract is up, but I'm still your familiar."
msgstr "「じゃ、必要になったら呼んでよね。契約は切れたけど、ボクはまだトーコさんの使い魔だし。"

#. Occurrence SP1:11600:21248: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0090; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11600
msgctxt "text_id=21248 | speaker=beo"
msgid "  No, I'm not being sarcastic. I'm proud to be your familiar. Until I find a better employer, I'm leaving my collar with you.\""
msgstr "　うん、そう、嫌味なんかじゃないって。狼はね、誇り高いんだよ。トーコさん以上の雇い主が見つかるまで、首輪はそっちに預けておきます」"

#. Occurrence SP1:11635:21249: scene=SP1
#: SP1:11635
msgctxt "text_id=21249 | speaker=unknown"
msgid "  Beo couldn't help but wonder where Touko was traveling."
msgstr "　ふと、ソレは受話器の向こうの相手が、どこを旅しているのか気になった。"

#. Occurrence SP1:11640:21250: scene=SP1
#: SP1:11640
msgctxt "text_id=21250 | speaker=unknown"
msgid "  She had accepted her loss and ended her contract with her familiar."
msgstr "　彼女は敗北を認め、使い魔との契約を<断|た>った。"

#. Occurrence SP1:11645:21251: scene=SP1
#: SP1:11645
msgctxt "text_id=21251 | speaker=unknown"
msgid "  She said it was because she hadn't fulfilled her promise to let him fight Magic."
msgstr "　魔法の相手をさせてやる、という約束を違えたからだという。"

#. Occurrence SP1:11650:21252: scene=SP1
#: SP1:11650
msgctxt "text_id=21252 | speaker=unknown"
msgid "  However, that was actually the fault of her familiar, and not her responsibility at all. Beo had not fulfilled his duty as her bodyguard yet."
msgstr "　けれどそれは使い魔の落ち度であって彼女の責任ではない。護衛役としては、ソレはまだ仕事を果たしていないのだ。"

#. Occurrence SP1:11686:21253: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0091; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11686
msgctxt "text_id=21253 | speaker=beo"
msgid "\"So, where are you now?\""
msgstr "「で、トーコさんはいまどこ？」"

#. Occurrence SP1:11692:21254: scene=SP1
#: SP1:11692
msgctxt "text_id=21254 | speaker=unknown"
msgid "  It was the name of a country he wasn't familiar with."
msgstr "　受話器からは聞き慣れない国の名前。"

#. Occurrence SP1:11697:21255: scene=SP1
#: SP1:11697
msgctxt "text_id=21255 | speaker=unknown"
msgid "  After the battle, she had promptly left Japan to develop a way to break the curse."
msgstr "　彼女は呪いの解呪手段を開発する為、早々に日本を発ったのだ。"

#. Occurrence SP1:11718:21256: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0092; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11718
msgctxt "text_id=21256 | speaker=beo"
msgid "\"What do you mean, accept your loss?"
msgstr "「なにが敗北を認めた、だよ。"

#. Occurrence SP1:11724:21257: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0093; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11724
msgctxt "text_id=21257 | speaker=beo"
msgid "  Does that mean you haven't given up yet?\""
msgstr "　それって、まだ諦めてないってコトじゃん」"

#. Occurrence SP1:11730:21258: scene=SP1
#: SP1:11730
msgctxt "text_id=21258 | speaker=unknown"
msgid "  Touko laughed on the other end of the line."
msgstr "　まったくだ、と笑い声が返ってくる。"

#. Occurrence SP1:11735:21259: scene=SP1
#: SP1:11735
msgctxt "text_id=21259 | speaker=unknown"
msgid "  Somehow, Beo sensed a tropical scent coming through the phone."
msgstr "　受話器の向こうからは、なんとなく、熱帯の香りがした。"

#. Occurrence SP1:11740:21260: scene=SP1
#: SP1:11740
msgctxt "text_id=21260 | speaker=unknown"
msgid "  Whether that was a Mystical effect of Touko's handcrafted phone,"
msgstr "　それが蒼崎橙子お手製の電話機による神秘か、"

#. Occurrence SP1:11745:21261: scene=SP1
#: SP1:11745
msgctxt "text_id=21261 | speaker=unknown"
msgid "  or the werewolf's super senses, was unclear."
msgstr "　ソレ自身の超感覚によるものかは分からない。"

#. Occurrence SP1:11777:21262: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0094; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11777
msgctxt "text_id=21262 | speaker=beo"
msgid "\"Well, come home soon, okay? I'll be here waiting. Bring me back something delicious, will you?\""
msgstr "「じゃ、さっさと帰ってきてね。ボクはこっちに残ってるから、美味しいお土産、よろしく」"

#. Occurrence SP1:11783:21263: scene=SP1
#: SP1:11783
msgctxt "text_id=21263 | speaker=unknown"
msgid "  Touko asked him why."
msgstr "　なぜ？　と受話器から声がする。"

#. Occurrence SP1:11788:21264: scene=SP1
#: SP1:11788
msgctxt "text_id=21264 | speaker=unknown"
msgid "  If he had really decided to stay on as her familiar, there was no reason for him to stay there."
msgstr "　彼女の使い魔を続けると決めたのなら、この土地に残る道理はないのだから。"

#. Occurrence SP1:11822:21265: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0095; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11822
msgctxt "text_id=21265 | speaker=beo"
msgid "\"Hmm... I don't really know myself, actually.\""
msgstr "「んー……実はボクも、よく分かんない、だけど」"

#. Occurrence SP1:11828:21266: scene=SP1
#: SP1:11828
msgctxt "text_id=21266 | speaker=unknown"
msgid "  As he stumbled over his words, Beo patted his chest a few times and remembered the pain he had felt."
msgstr "　ソレは言葉を詰まらせながら、胸に手をペタペタと当てて、以前味わった痛みを<反芻|はんすう>して、"

#. Occurrence SP1:11859:21267: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0096; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11859
msgctxt "text_id=21267 | speaker=beo"
msgid "\"Ehehe. How do I put this...?"
msgstr "「えへへ。まあ、なんといいましょうか。"

#. Occurrence SP1:11865:21268: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_SP1_0097; voice_prefix=A50; voice_category=12; scene=SP1
#: SP1:11865
msgctxt "text_id=21268 | speaker=beo"
msgid "  It's like... when I'm here, I think I can understand what sweet really means.\""
msgstr "　ここにいれば甘いってどんなものか、分かるような気がするのです」"

#. Occurrence SP1:11871:21269: scene=SP1
#: SP1:11871
msgctxt "text_id=21269 | speaker=unknown"
msgid "  The wolf who had learned to accept being wasteful expressed his future goal, a vague hint of delight in his voice."
msgstr "　無駄を知った狼は、どことなく楽しそうな声で、今後の目的を口にした。"

#. Occurrence SP1:11890:21270: scene=SP1
#: SP1:11890
msgctxt "text_id=21270 | speaker=unknown"
msgid "  Thus concluded an exceptionally rare case of first love, sweet as honey."
msgstr "　これもまた<初恋|はちみつ>に関する、極めて稀少な<事件|ケース>である。"

#. Occurrence WIK_B_1_A:47:21271: scene=WIK_B_1_A
#: WIK_B_1_A:47
msgctxt "text_id=21271 | speaker=unknown"
msgid "  Aozaki was waiting in the east wing."
msgstr "　東館に入ると、すぐに蒼崎が待っていた。"

#. Occurrence WIK_B_1_A:53:21272: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_A_0000; voice_prefix=B10; voice_category=5; scene=WIK_B_1_A
#: WIK_B_1_A:53
msgctxt "text_id=21272 | speaker=kojika"
msgid "\"Sorry. Did I keep you long?\""
msgstr "「ごめん、待たせた？」"

#. Occurrence WIK_B_1_A:62:21273: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_1_A_0000; voice_prefix=A10; voice_category=1; scene=WIK_B_1_A
#: WIK_B_1_A:62
msgctxt "text_id=21273 | speaker=aoko"
msgid "\"No. Not like I have anything else to do anyway."
msgstr "「ん、別に。私も今のところやる事ないし。"

#. Occurrence WIK_B_1_A:74:21274: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_1_A_0001; voice_prefix=A10; voice_category=1; scene=WIK_B_1_A
#: WIK_B_1_A:74
msgctxt "text_id=21274 | speaker=aoko"
msgid "  Let's head inside. I think you know most of the guests, but we should still introduce you.\""
msgstr "　とりあえず中に入って。顔見知りばっかりだけど、一応挨拶はしておかないとね」"

#. Occurrence WIK_B_1_A:79:21275: scene=WIK_B_1_A
#: WIK_B_1_A:79
msgctxt "text_id=21275 | speaker=unknown"
msgid "  That's Aozaki for you. Always likes to do things properly."
msgstr "　親しき仲にも礼儀あり、という事だろう。"

#. Occurrence WIK_B_1_A:84:21276: scene=WIK_B_1_A
#: WIK_B_1_A:84
msgctxt "text_id=21276 | speaker=unknown"
msgid "  With her characteristic sincerity on full display, she turned the doorknob."
msgstr "　彼女らしい律儀な台詞と共に、ドアノブは回された。"

#. Occurrence WIK_B_1_B:110:21277: scene=WIK_B_1_B
#: WIK_B_1_B:110
msgctxt "text_id=21277 | speaker=unknown"
msgid "  The moment I entered, I had to stop myself from jumping out of my skin."
msgstr "　中に入るなり、わたしは飛び上がりそうになる自分の体を押さえつけるハメになった。"

#. Occurrence WIK_B_1_B:115:21278: scene=WIK_B_1_B
#: WIK_B_1_B:115
msgctxt "text_id=21278 | speaker=unknown"
msgid "  The parlor was cozy compared to the lobby, but I didn't have time to appreciate it."
msgstr "　ロビーに比べたら親しみのある居間の様子にホッとする暇もない。"

#. Occurrence WIK_B_1_B:120:21279: scene=WIK_B_1_B
#: WIK_B_1_B:120
msgctxt "text_id=21279 | speaker=unknown"
msgid "  I was too distracted by a familiar face I hadn't expected to run into."
msgstr "　そこには、見知っているけど予想外の顔があったからだ。"

#. Occurrence WIK_B_1_B:167:21280: scene=WIK_B_1_B
#: WIK_B_1_B:167
msgctxt "text_id=21280 | speaker=unknown"
msgid "  First was Alice Kuonji."
msgstr "　まず彼女、久遠寺有珠。"

#. Occurrence WIK_B_1_B:172:21281: scene=WIK_B_1_B
#: WIK_B_1_B:172
msgctxt "text_id=21281 | speaker=unknown"
msgid "  I was nervous because I'd only met her once or twice, but she wasn't the one who surprised me."
msgstr "　顔を合わせたのは一度か二度だけなので緊張はするが、予想外ではない。"

#. Occurrence WIK_B_1_B:228:21282: scene=WIK_B_1_B
#: WIK_B_1_B:228
msgctxt "text_id=21282 | speaker=unknown"
msgid "  Next was Beo."
msgstr "　次にベオ。"

#. Occurrence WIK_B_1_B:233:21283: scene=WIK_B_1_B
#: WIK_B_1_B:233
msgctxt "text_id=21283 | speaker=unknown"
msgid "  He was a child who often hung around the shopping district, almost like a guardian spirit... or perhaps, a greedy little goblin. I'd spoken to him before, so he wasn't a shocker either."
msgstr "　商店街の座敷童、居ついた店はかならず繁盛するというお子さま。と言うか、ていのいいたかり魔。彼とは何度も話しているから、これも予想外ではない。"

#. Occurrence WIK_B_1_B:288:21284: scene=WIK_B_1_B
#: WIK_B_1_B:288
msgctxt "text_id=21284 | speaker=unknown"
msgid "  Last was the student council vice president."
msgstr "　最後に副会長。"

#. Occurrence WIK_B_1_B:293:21285: scene=WIK_B_1_B
#: WIK_B_1_B:293
msgctxt "text_id=21285 | speaker=unknown"
msgid "  Come to think of it, he was acquainted with Aozaki and Sizuki, so it made sense he'd be at this birthday party."
msgstr "　考えてみれば、蒼崎と静希の知人で、町の名士の息子なのだから、この誕生会にいない方がおかしい。"

#. Occurrence WIK_B_1_B:299:21286: scene=WIK_B_1_B
#: WIK_B_1_B:299
msgctxt "text_id=21286 | speaker=unknown"
msgid "  It did make sense... right?"
msgstr "　……おかしい、のだけど。"

#. Occurrence WIK_B_1_B:354:21287: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0000; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:354
msgctxt "text_id=21287 | speaker=kojika"
msgid "\"Hey. What's Tsukiji doing here?\""
msgstr "「ちょっと。なんで<槻司|つきじ>がいるの？」"

#. Occurrence WIK_B_1_B:365:21288: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_1_B_0000; voice_prefix=A10; voice_category=1; scene=WIK_B_1_B
#: WIK_B_1_B:365
msgctxt "text_id=21288 | speaker=aoko"
msgid "\"Oh, didn't I say he was coming?"
msgstr "「あら、<鳶丸|とびまる>も来るって言ってなかったっけ。"

#. Occurrence WIK_B_1_B:371:21289: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_1_B_0001; voice_prefix=A10; voice_category=1; scene=WIK_B_1_B
#: WIK_B_1_B:371
msgctxt "text_id=21289 | speaker=aoko"
msgid "  Should I have let you know if he was going to show up?\""
msgstr "　というか、いちいち言わないとダメだったかしら？」"

#. Occurrence WIK_B_1_B:382:21290: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0001; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:382
msgctxt "text_id=21290 | speaker=kojika"
msgid "\"I... don't exactly have a problem with him.\""
msgstr "「だ……ダメって事は、別にないけど」"

#. Occurrence WIK_B_1_B:408:21291: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_1_B_0002; voice_prefix=A10; voice_category=1; scene=WIK_B_1_B
#: WIK_B_1_B:408
msgctxt "text_id=21291 | speaker=aoko"
msgid "\"So what's the issue? We see each other every day at the student council, don't we?\""
msgstr "「ならいいじゃない。生徒会じゃ毎日顔会わせているんだし、気にならないでしょ」"

#. Occurrence WIK_B_1_B:419:21292: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0002; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:419
msgctxt "text_id=21292 | speaker=kojika"
msgid "\"Well, we're not in school. And, well... I'm in my regular clothes.\""
msgstr "「が、学校の中と外は別よ。だいたいわたし、これ普段着なんだし」"

#. Occurrence WIK_B_1_B:455:21293: scene=WIK_B_1_B
#: WIK_B_1_B:455
msgctxt "text_id=21293 | speaker=unknown"
msgid "  Aozaki gave me a look that said, \"and...?\""
msgstr "　蒼崎は、それが何か問題でも？　といった顔。"

#. Occurrence WIK_B_1_B:460:21294: scene=WIK_B_1_B
#: WIK_B_1_B:460
msgctxt "text_id=21294 | speaker=unknown"
msgid "  Of course there was a problem."
msgstr "　もちろん、問題も問題だ。"

#. Occurrence WIK_B_1_B:465:21295: scene=WIK_B_1_B
#: WIK_B_1_B:465
msgctxt "text_id=21295 | speaker=unknown"
msgid "  Could you blame me for hiding it? To be frank, I had a crush on Tobimaru Tsukiji."
msgstr "　隠していても仕方がないのでハッキリ言うと、わたし、久万梨金鹿は槻司鳶丸に片思い中なのである。"

#. Occurrence WIK_B_1_B:470:21296: scene=WIK_B_1_B
#: WIK_B_1_B:470
msgctxt "text_id=21296 | speaker=unknown"
msgid "  I'd felt this way for three years."
msgstr "　それも歴史にして三年。"

#. Occurrence WIK_B_1_B:475:21297: scene=WIK_B_1_B
#: WIK_B_1_B:475
msgctxt "text_id=21297 | speaker=unknown"
msgid "  Three whole years, and I still hadn't said anything. I knew it was spineless of me."
msgstr "　告白までこぎつけるコトもできず、あれよあれよと三年間。我がコトながら、<唾|だ><棄|き>すべき軟弱っぷり。"

#. Occurrence WIK_B_1_B:507:21298: scene=WIK_B_1_B
#: WIK_B_1_B:507
msgctxt "text_id=21298 | speaker=unknown"
msgid "  This might not mean much coming from me, but I wasn't always a coward."
msgstr "　しかし、多少なりとも弁明すると、はじめからここまで臆病だったワケじゃない。"

#. Occurrence WIK_B_1_B:512:21299: scene=WIK_B_1_B
#: WIK_B_1_B:512
msgctxt "text_id=21299 | speaker=unknown"
msgid "  During my freshman year, I was only vaguely aware of him as Aozaki's coworker."
msgstr "　一年生の頃は漠然と、そもそも槻司のコトは蒼崎の相方としか思っていなかったし。"

#. Occurrence WIK_B_1_B:517:21300: scene=WIK_B_1_B
#: WIK_B_1_B:517
msgctxt "text_id=21300 | speaker=unknown"
msgid "  I only really became aware of my feelings during my second year."
msgstr "　はっきりと自覚したのは二年生の時だ。"

#. Occurrence WIK_B_1_B:522:21301: scene=WIK_B_1_B
#: WIK_B_1_B:522
msgctxt "text_id=21301 | speaker=unknown"
msgid "  He spoke to me often, maybe because he trusted me as Aozaki's friend."
msgstr "　蒼崎の友人という事で信頼されていたのか、槻司はわたしによく話しかけてきた。"

#. Occurrence WIK_B_1_B:527:21302: scene=WIK_B_1_B
#: WIK_B_1_B:527
msgctxt "text_id=21302 | speaker=unknown"
msgid "  And whenever he did, I went home happy; at the time, I didn't know why."
msgstr "　そうした後は、ひとり帰り道で訳もなく嬉しくなって、なぜだろう？　と首をかしげていたものだ。"

#. Occurrence WIK_B_1_B:555:21303: scene=WIK_B_1_B
#: WIK_B_1_B:555
msgctxt "text_id=21303 | speaker=unknown"
msgid "  The realization hit me when we happened to be cleaning up together after a school festival in my second year."
msgstr "　決定打は二年生の文化祭の後片づけの時。"

#. Occurrence WIK_B_1_B:560:21304: scene=WIK_B_1_B
#: WIK_B_1_B:560
msgctxt "text_id=21304 | speaker=unknown"
msgid "  We were just tidying things away, when bam! I realized maybe I'd liked him all along."
msgstr "　たまたまふたりで生徒会の演し物を片づけていた時、“あれ、もしかしてわたし、この人に一目惚れしていたのではないだろうか”と気が付いてしまった。"

#. Occurrence WIK_B_1_B:566:21305: scene=WIK_B_1_B
#: WIK_B_1_B:566
msgctxt "text_id=21305 | speaker=unknown"
msgid "  They say love's a poison,"
msgstr "　恋は<猛毒|もうもく>と言うが、"

#. Occurrence WIK_B_1_B:571:21306: scene=WIK_B_1_B
#: WIK_B_1_B:571
msgctxt "text_id=21306 | speaker=unknown"
msgid "  but yeesh, talk about delayed effects."
msgstr "　まったく、遅効性にも程がある。"

#. Occurrence WIK_B_1_B:604:21307: scene=WIK_B_1_B
#: WIK_B_1_B:604
msgctxt "text_id=21307 | speaker=unknown"
msgid "  Anyway, nothing really changed after that."
msgstr "　そこから先は、しかし、何の変化もない。"

#. Occurrence WIK_B_1_B:609:21308: scene=WIK_B_1_B
#: WIK_B_1_B:609
msgctxt "text_id=21308 | speaker=unknown"
msgid "  In an act of rebellion against my simple-minded family,"
msgstr "　わたしは野蛮な脳筋一族に反抗し、"

#. Occurrence WIK_B_1_B:614:21309: scene=WIK_B_1_B
#: WIK_B_1_B:614
msgctxt "text_id=21309 | speaker=unknown"
msgid "  I decided to never inherit the family business."
msgstr "　このまま家業を継がされる運命に反逆し、"

#. Occurrence WIK_B_1_B:619:21310: scene=WIK_B_1_B
#: WIK_B_1_B:619
msgctxt "text_id=21310 | speaker=unknown"
msgid "  That was why I liked to believe I've been hard-working and disciplined since middle school. It's a personal point of pride."
msgstr "　その為に中学からコツコツと律してきた自分を、少なからず誇りに思っていた。"

#. Occurrence WIK_B_1_B:624:21311: scene=WIK_B_1_B
#: WIK_B_1_B:624
msgctxt "text_id=21311 | speaker=unknown"
msgid "  And, it made it all the more excruciating to accept that I'd been overtaken by teenage infatuation."
msgstr "　なので、そんな、降って湧いた思春期特有の幻想なんぞに膝を屈するのは、どうにも我慢できなかったのである。"

#. Occurrence WIK_B_1_B:629:21312: scene=WIK_B_1_B
#: WIK_B_1_B:629
msgctxt "text_id=21312 | speaker=unknown"
msgid "  You could say that I lacked courage."
msgstr "　勇気がなかったとも言える。"

#. Occurrence WIK_B_1_B:657:21313: scene=WIK_B_1_B
#: WIK_B_1_B:657
msgctxt "text_id=21313 | speaker=unknown"
msgid "  Eventually, the school year passed by even as I did nothing about my feelings..."
msgstr "　そうこうしている内に、時間はついに底を見せ始めた。"

#. Occurrence WIK_B_1_B:662:21314: scene=WIK_B_1_B
#: WIK_B_1_B:662
msgctxt "text_id=21314 | speaker=unknown"
msgid "  ...but I never got over him."
msgstr "　わたしの気持ちはいっこうにふわふわしたまま。"

#. Occurrence WIK_B_1_B:667:21315: scene=WIK_B_1_B
#: WIK_B_1_B:667
msgctxt "text_id=21315 | speaker=unknown"
msgid "  We entered the fall of my third year. Graduation was close, but I still had no idea what to do about my crush."
msgstr "　卒業を間近にした三年の秋になって、本気でわたしは、わたしをどうしたいのか分からなくなっていた。"

#. Occurrence WIK_B_1_B:697:21316: scene=WIK_B_1_B
#: WIK_B_1_B:697
msgctxt "text_id=21316 | speaker=unknown"
msgid "  Then, I learned to my surprise that Tsukiji would be attending a local college. I had this on good authority, since I'd flexed my powers as a student council member to dig into it."
msgstr "　槻司の進学先は、意外な事に地元の大学らしい。生徒会役員としての権限をフルに使って調べたので間違いない。"

#. Occurrence WIK_B_1_B:702:21317: scene=WIK_B_1_B
#: WIK_B_1_B:702
msgctxt "text_id=21317 | speaker=unknown"
msgid "  It wasn't Mizora, but if he was going to a nearby school, that would be... unfortunate."
msgstr "　さすがに渠裸ではなかったけど、槻司が地元に進学するのなら、なんというか、未練がましいコトに可能性が出てきてしまう。"

#. Occurrence WIK_B_1_B:707:21318: scene=WIK_B_1_B
#: WIK_B_1_B:707
msgctxt "text_id=21318 | speaker=unknown"
msgid "  After all, if I also went to college nearby, I wouldn't be able to cut my ties with him."
msgstr "　わたしも、このまま地元の大学に進めば、まだ縁は切れないのだと。"

#. Occurrence WIK_B_1_B:737:21319: scene=WIK_B_1_B
#: WIK_B_1_B:737
msgctxt "text_id=21319 | speaker=unknown"
msgid "  Aozaki told me once."
msgstr "　蒼崎曰く、"

#. Occurrence WIK_B_1_B:746:21320: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_1_B_0003; voice_prefix=A10; voice_category=1; scene=WIK_B_1_B
#: WIK_B_1_B:746
msgctxt "text_id=21320 | speaker=aoko"
msgid "\"Pretty sure Tobimaru's interested in you, Kuma."
msgstr "『鳶丸、クマのこと気に入ってると思うけど。"

#. Occurrence WIK_B_1_B:758:21321: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_1_B_0004; voice_prefix=A10; voice_category=1; scene=WIK_B_1_B
#: WIK_B_1_B:758
msgctxt "text_id=21321 | speaker=aoko"
msgid "  He only makes small talk with people he likes, right?\""
msgstr "　だってあいつ、好きなヤツとしか世間話しないでしょ』"

#. Occurrence WIK_B_1_B:796:21322: scene=WIK_B_1_B
#: WIK_B_1_B:796
msgctxt "text_id=21322 | speaker=unknown"
msgid "  I wanted to believe it was true."
msgstr "　この通り、脈はある、と信じたい。"

#. Occurrence WIK_B_1_B:818:21323: scene=WIK_B_1_B
#: WIK_B_1_B:818
msgctxt "text_id=21323 | speaker=unknown"
msgid "  I mean, he even broke his arm to save me during the craziness this summer."
msgstr "　今年の夏の騒ぎの時だって、なんか、腕折ってまで助けてくれたし。"

#. Occurrence WIK_B_1_B:823:21324: scene=WIK_B_1_B
#: WIK_B_1_B:823
msgctxt "text_id=21324 | speaker=unknown"
msgid "  I didn't know if Tsukiji had a girlfriend, but I was sure I had a chance if I asked him out."
msgstr "　槻司にカノジョがいるかどうかはわたしの知るところじゃないけど、いま告白すれば可能性はなくもない。"

#. Occurrence WIK_B_1_B:850:21325: scene=WIK_B_1_B
#: WIK_B_1_B:850
msgctxt "text_id=21325 | speaker=unknown"
msgid "  But... but..."
msgstr "　しかし。しかしだ。"

#. Occurrence WIK_B_1_B:855:21326: scene=WIK_B_1_B
#: WIK_B_1_B:855
msgctxt "text_id=21326 | speaker=unknown"
msgid "  Giving in felt like throwing away everything I'd fought for so far."
msgstr "　それでは何の為に、物心ついた時から陰に日向に戦ってきたのか、悔しくなる。"

#. Occurrence WIK_B_1_B:872:21327: scene=WIK_B_1_B
#: WIK_B_1_B:872
msgctxt "text_id=21327 | speaker=unknown"
msgid "  Ever since I was a kid, I'd planned ahead. I used to look down on classmates who were obsessed with childish dreams and romance."
msgstr "　子供の頃からきっかり将来設計を持ってきたわたしは、恋だの夢だのにうつつをぬかしている同級生たちを軽蔑さえしていた。"

#. Occurrence WIK_B_1_B:898:21328: scene=WIK_B_1_B
#: WIK_B_1_B:898
msgctxt "text_id=21328 | speaker=unknown"
msgid "  And now, here I was, actually willing to give up six long years of hard work for the dumbest of reasons."
msgstr "　そのわたしがここにきて、そんな綿アメみたいな理由で六年間の努力を無駄にするとか、本気で信じられない。"

#. Occurrence WIK_B_1_B:903:21329: scene=WIK_B_1_B
#: WIK_B_1_B:903
msgctxt "text_id=21329 | speaker=unknown"
msgid "  That wasn't me. That wasn't the Kojika Kumari I was trying to become."
msgstr "　そんなのは、わたしが目指してきた久万梨金鹿ではないと思う。"

#. Occurrence WIK_B_1_B:943:21330: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_1_B_0005; voice_prefix=A10; voice_category=1; scene=WIK_B_1_B
#: WIK_B_1_B:943
msgctxt "text_id=21330 | speaker=aoko"
msgid "\"Earth to Kuma. You okay there?\""
msgstr "「金鹿？　どしたの、考え事？」"

#. Occurrence WIK_B_1_B:956:21331: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0003_0; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:956
msgctxt "text_id=21331 | speaker=kojika"
msgid "\"Yeah, I just needed a moment to clear my head. I'm A-OK now."
msgstr "「うん、ちょっと頭冷やしてた。おかげで落ち着いたから問題なし。"

#. Occurrence WIK_B_1_B:970:21332: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0003_1; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:970
msgctxt "text_id=21332 | speaker=kojika"
msgid "I think I'll go say hi to Miss Kuonji.\""
msgstr "さて、久遠寺さんに挨拶しないとね」"

#. Occurrence WIK_B_1_B:992:21333: scene=WIK_B_1_B
#: WIK_B_1_B:992
msgctxt "text_id=21333 | speaker=unknown"
msgid "  ...so I said, but I couldn't shake a slight tinge of regret."
msgstr "　……などと言いつつ、少しだけ後悔する。"

#. Occurrence WIK_B_1_B:997:21334: scene=WIK_B_1_B
#: WIK_B_1_B:997
msgctxt "text_id=21334 | speaker=unknown"
msgid "  I should've listened to Aozaki, instead of laughing through my nose when she said to wear something nice to the party."
msgstr "　蒼崎から“パーティーを開くからできるだけオシャレな格好で来い”と言われた時、鼻で笑った自分を鍋で<叩|はた>きたい気分。"

#. Occurrence WIK_B_1_B:1022:21335: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0004; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:1022
msgctxt "text_id=21335 | speaker=kojika"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence WIK_B_1_B:1027:21336: scene=WIK_B_1_B
#: WIK_B_1_B:1027
msgctxt "text_id=21336 | speaker=unknown"
msgid "  Well, it's not like I had a nice dress to wear anyway, so there isn't much I could've done to impress him."
msgstr "　まあ、もともとドレスなんて持ってないし、頑張ったところで何もできなかっただろう。"

#. Occurrence WIK_B_1_B:1043:21337: scene=WIK_B_1_B
#: WIK_B_1_B:1043
msgctxt "text_id=21337 | speaker=unknown"
msgid "  I clapped my hands on my cheeks to get my head on straight, and tried to carry myself as I always did."
msgstr "　わたしはピシャと頬を叩いて、努めて、いつもの自分であるよう気を引き締めた。"

#. Occurrence WIK_B_1_B:1128:21338: scene=WIK_B_1_B
#: WIK_B_1_B:1128
msgctxt "text_id=21338 | speaker=unknown"
msgid "  After greeting the mistress of the house, I went into the adjacent sunroom."
msgstr "　館の主人である久遠寺さんに挨拶をして、隣室であるサンルームに移動する。"

#. Occurrence WIK_B_1_B:1152:21339: scene=WIK_B_1_B
#: WIK_B_1_B:1152
msgctxt "text_id=21339 | speaker=unknown"
msgid "  I recognized the other guests here, so there was no need for introductions."
msgstr "　集まっているゲストは誰もが顔見知りなので、改めて自己紹介をする必要はない。"

#. Occurrence WIK_B_1_B:1157:21340: scene=WIK_B_1_B
#: WIK_B_1_B:1157
msgctxt "text_id=21340 | speaker=unknown"
msgid "  The sunroom and drawing room were connected, and you could see each room from the other."
msgstr "　サンルームと居間は一続きなので、サンルームからでも居間の様子は窺えた。"

#. Occurrence WIK_B_1_B:1192:21341: scene=WIK_B_1_B
#: WIK_B_1_B:1192
msgctxt "text_id=21341 | speaker=unknown"
msgid "  Miss Kuonji sat on a sofa in the drawing room, elegantly sipping a cup of tea."
msgstr "　居間のソファーには久遠寺さんが座って、優雅にお茶を飲んでいる。"

#. Occurrence WIK_B_1_B:1204:21342: scene=WIK_B_1_B
#: WIK_B_1_B:1204
msgctxt "text_id=21342 | speaker=unknown"
msgid "  Chatting nearby were "
msgstr "　その周囲で騒いでいるのは"

msgctxt "text_id=21343 | speaker=unknown"
msgid "Housuke and "
msgstr "芳助と、"

msgctxt "text_id=21344 | speaker=unknown"
msgid "Housuke and "
msgstr "芳助と、"

#. Occurrence WIK_B_1_B:1225:21345: scene=WIK_B_1_B
#: WIK_B_1_B:1225
msgctxt "text_id=21345 | speaker=unknown"
msgid "Mr. Yamasiro--didn't expect to see him here."
msgstr "意外なコトに山城先生だった。"

#. Occurrence WIK_B_1_B:1287:21346: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_B_1_B_0000; voice_prefix=B60; voice_category=7; scene=WIK_B_1_B
#: WIK_B_1_B:1287
msgctxt "text_id=21346 | speaker=yamashiro"
msgid "\"Ah, so those were oak trees in the backyard. We have 'nara' trees here in Japan, but hmm... I don't remember them looking like yours."
msgstr "「ほう。裏庭の方にちらりと見えたのはオークの木なのですか。日本で言えば<楢|なら>ですが……うーん、僕の記憶には該当しないなあ。"

#. Occurrence WIK_B_1_B:1299:21347: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_B_1_B_0001; voice_prefix=B60; voice_category=7; scene=WIK_B_1_B
#: WIK_B_1_B:1299
msgctxt "text_id=21347 | speaker=yamashiro"
msgid "  It must be a unique species. Japanese and British oaks look very different, and I understand that there are some four hundred or more species of oak.\""
msgstr "　何か特別な品種なんでしょうね。日本のものとイギリスのものは見た目からして違いますし、オークの品種はそれこそ四百以上ありますから」"

#. Occurrence WIK_B_1_B:1330:21348: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_B_1_B_0000; voice_prefix=B50; voice_category=6; scene=WIK_B_1_B
#: WIK_B_1_B:1330
msgctxt "text_id=21348 | speaker=kinomi"
msgid "\"He's just dronin' on about the stuff he likes, as if anyone else actually cares. Fair warning, Alice--he's the kind of teacher who doesn't give a damn what students think, so you're better off ignoring him."
msgstr "「うお、相変わらず自分の言いたい事しか言わないよねこの人。有珠ちゃん、この先生は人の心にズカズカ踏みこんでくる蛮族だから、無視しちゃっていいぜ。"

#. Occurrence WIK_B_1_B:1342:21349: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_B_1_B_0001; voice_prefix=B50; voice_category=6; scene=WIK_B_1_B
#: WIK_B_1_B:1342
msgctxt "text_id=21349 | speaker=kinomi"
msgid "  Never mind that. Want to do anything over winter break?"
msgstr "　それよりオレと冬休みの予定について話し合わない？"

#. Occurrence WIK_B_1_B:1355:21350: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_B_1_B_0002; voice_prefix=B50; voice_category=6; scene=WIK_B_1_B
#: WIK_B_1_B:1355
msgctxt "text_id=21350 | speaker=kinomi"
msgid "  You don't seem like much of a skier. I could teach you how, if you want.\""
msgstr "　有珠ちゃん、スキーとか苦手そうだナー。そこで、この頼れる木乃美芳助が手取り足取り教えたいナー」"

#. Occurrence WIK_B_1_B:1381:21351: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_B_1_B_0000; voice_prefix=A40; voice_category=2; scene=WIK_B_1_B
#: WIK_B_1_B:1381
msgctxt "text_id=21351 | speaker=alice"
msgid "\"Can't either of you talk about something interesting for once?"
msgstr "「ふたりとも、退屈とはほど遠い人なのね。"

#. Occurrence WIK_B_1_B:1392:21352: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_B_1_B_0001; voice_prefix=A40; voice_category=2; scene=WIK_B_1_B
#: WIK_B_1_B:1392
msgctxt "text_id=21352 | speaker=alice"
msgid "  It's like listening to a pair of woodpeckers.\""
msgstr "　理解したわ。木乃美君と先生は、仕付けられたウッドペッカーのよう」"

#. Occurrence WIK_B_1_B:1444:21353: voice_id=BA0_WIK_B_1_B_0000; voice_prefix=BA0; voice_category=0; scene=WIK_B_1_B
#: WIK_B_1_B:1444
msgctxt "text_id=21353 | speaker=unknown"
msgid "\"Hahaha! You're putting these front doors on the same level as those pecking, blathering, birdbrains?! Better than Sono-G, I guess, but only slightly."
msgstr "『ハハハ、あの木を<突|つつ>くか<喋|しゃべ>ってるだけの<阿呆鳥|あほうどり>と同格っスかこのシャバ僧ども！　アリスさんから鳥認定されない草の字に比べて、ちょっとだけ格上と見たっス。"

#. Occurrence WIK_B_1_B:1475:21354: voice_id=BA0_WIK_B_1_B_0001; voice_prefix=BA0; voice_category=0; scene=WIK_B_1_B
#: WIK_B_1_B:1475
msgctxt "text_id=21354 | speaker=unknown"
msgid "  Still, I'm way better than either of them! And all I do is live or die!\""
msgstr "　ま、死ぬか生きるかだけのジブンに比べたらどっちも小物っスけど！』"

#. Occurrence WIK_B_1_B:1514:21355: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0005; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:1514
msgctxt "text_id=21355 | speaker=kojika"
msgid "\"...What's wrong with that fat bird?\""
msgstr "「……なに、あのまるっとした鳥」"

#. Occurrence WIK_B_1_B:1546:21356: scene=WIK_B_1_B
#: WIK_B_1_B:1546
msgctxt "text_id=21356 | speaker=unknown"
msgid "  There was a blue robin flitting to and fro around Miss Kuonji's head, chirping adorably."
msgstr "　久遠寺さんの肩には青い駒鳥がしきりにまとわりついているが、彼女の肩にとまる度に払い落とされていた。"

#. Occurrence WIK_B_1_B:1551:21357: scene=WIK_B_1_B
#: WIK_B_1_B:1551
msgctxt "text_id=21357 | speaker=unknown"
msgid "  But whenever it tried to land on her shoulder, she batted it away. Is that how she raised her pets?"
msgstr "　チチチ、チチチと愛らしい声で鳴いているが、放し飼いにされているのだろうか？"

#. Occurrence WIK_B_1_B:1587:21358: scene=WIK_B_1_B
#: WIK_B_1_B:1587
msgctxt "text_id=21358 | speaker=unknown"
msgid "  Aozaki was nowhere to be seen. She was probably in the kitchen or bathroom."
msgstr "　蒼崎の姿はない。台所かトイレだろう。"

#. Occurrence WIK_B_1_B:1592:21359: scene=WIK_B_1_B
#: WIK_B_1_B:1592
msgctxt "text_id=21359 | speaker=unknown"
msgid "  With nobody to talk to, I took a seat and let my thoughts wander, until..."
msgstr "　わたしは話し相手もなく、ひとりぼんやりしていると、"

#. Occurrence WIK_B_1_B:1616:21360: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0000; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:1616
msgctxt "text_id=21360 | speaker=tobimaru"
msgid "\"Hey, Kumari. Did they invite you too?"
msgstr "「久万梨も招待されてたんだな。"

#. Occurrence WIK_B_1_B:1622:21361: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0001; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:1622
msgctxt "text_id=21361 | speaker=tobimaru"
msgid "  Work get out late today?\""
msgstr "　ずいぶんと遅かったが、またアルバイトか？」"

#. Occurrence WIK_B_1_B:1640:21362: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0006; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:1640
msgctxt "text_id=21362 | speaker=kojika"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence WIK_B_1_B:1645:21363: scene=WIK_B_1_B
#: WIK_B_1_B:1645
msgctxt "text_id=21363 | speaker=unknown"
msgid "  Tsukiji kicked off a conversation in his usual, casual way."
msgstr "　槻司はいつもの調子で話しかけてきた。"

#. Occurrence WIK_B_1_B:1650:21364: scene=WIK_B_1_B
#: WIK_B_1_B:1650
msgctxt "text_id=21364 | speaker=unknown"
msgid "  His slender arms were picturesque, even while holding a glass of juice."
msgstr "　スラリとした手足とか、ジュースの入ったグラスを持っているだけで絵になっている。"

#. Occurrence WIK_B_1_B:1676:21365: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0007; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:1676
msgctxt "text_id=21365 | speaker=kojika"
msgid "\"I'm off work today. Took three whole days off, actually. I'm on track to hit my budget, anyway.\""
msgstr "「アルバイトは休み。今回の三連休、ぜんぶ休み入れたから。お金も予定額たまったし」"

#. Occurrence WIK_B_1_B:1711:21366: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0002; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:1711
msgctxt "text_id=21366 | speaker=tobimaru"
msgid "\"Nice! So the countdown's ticking until liftoff from Misaki, eh?"
msgstr "「そうか、そりゃよかった。三咲脱出ロケットはもう秒読み段階ってコトだな。"

#. Occurrence WIK_B_1_B:1718:21367: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0003_0; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:1718
msgctxt "text_id=21367 | speaker=tobimaru"
msgid "I guess we won't be saying good morning to each other at the corner store anymore."
msgstr "となると、早朝のコンビニで顔を合わせるのもいよいよおしまいか。"

#. Occurrence WIK_B_1_B:1730:21368: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0003_1; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:1730
msgctxt "text_id=21368 | speaker=tobimaru"
msgid "  Wait. Wasn't it you who dumped water on me for trying to smoke once?\""
msgstr "　ん？　そういえば、俺が煙草を吸おうとしたら水ぶっかけてきたの、おまえさんだったっけか」"

#. Occurrence WIK_B_1_B:1787:21369: scene=WIK_B_1_B
#: WIK_B_1_B:1787
msgctxt "text_id=21369 | speaker=unknown"
msgid "  That took me back."
msgstr "　懐かしい話だ。"

#. Occurrence WIK_B_1_B:1792:21370: scene=WIK_B_1_B
#: WIK_B_1_B:1792
msgctxt "text_id=21370 | speaker=unknown"
msgid "  Back in my freshman year, there was a student cocky enough to smoke in my store's parking lot."
msgstr "　一年生の頃、コンビニの駐車場で堂々と煙草を吸っている生徒がいた。"

#. Occurrence WIK_B_1_B:1797:21371: scene=WIK_B_1_B
#: WIK_B_1_B:1797
msgctxt "text_id=21371 | speaker=unknown"
msgid "  He was from a different school, but that didn't matter. I ran up to him, warned him, then hosed him down with water. Can you believe I did that to a stranger?"
msgstr "　他校の生徒だったけど見てしまったものは仕方がない。駆け寄って注意して、かつホースで水を撒いたら、まったく関係のない男子生徒に水を被せてしまった。"

#. Occurrence WIK_B_1_B:1802:21372: scene=WIK_B_1_B
#: WIK_B_1_B:1802
msgctxt "text_id=21372 | speaker=unknown"
msgid "  I got flustered and tried to apologize, but the boy was already reaching for another cigarette before I even finished."
msgstr "　あわてて謝ろうとしたら、その男子生徒の手には今まさに吸われようとしていた煙草が一本。"

#. Occurrence WIK_B_1_B:1807:21373: scene=WIK_B_1_B
#: WIK_B_1_B:1807
msgctxt "text_id=21373 | speaker=unknown"
msgid "  He'd turned out to be Tobimaru Tsukiji."
msgstr "　それがこの男、槻司鳶丸だったのである。"

#. Occurrence WIK_B_1_B:1841:21374: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0004; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:1841
msgctxt "text_id=21374 | speaker=tobimaru"
msgid "\"Man, I really didn't expect to see you again, much less in the student council room. Maybe that's my destiny? To get sprayed with water by girls I like.\""
msgstr "「いやあ。あの後、まさか生徒会室で再会するとは思わなかった。俺はアレかね、気に入った女どもにはまず水かケンカをふっかけられる運命なのかねぇ」"

#. Occurrence WIK_B_1_B:1852:21375: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0008; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:1852
msgctxt "text_id=21375 | speaker=kojika"
msgid "\"Life's just like that sometimes. When did you get here, Tsukiji?\""
msgstr "「たまたまでしょ。それより槻司、いつから来てたの？」"

#. Occurrence WIK_B_1_B:1878:21376: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0005; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:1878
msgctxt "text_id=21376 | speaker=tobimaru"
msgid "\"We've been here since morning. Kinomi got a bug in his ass, so I didn't have a choice."
msgstr "「俺たちは午前中からだよ。木乃美のヤロウが張りきっててな、仕方なくだ。"

#. Occurrence WIK_B_1_B:1889:21377: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0006; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:1889
msgctxt "text_id=21377 | speaker=tobimaru"
msgid "  The birthday party isn't 'til six, so we've still got plenty of time."
msgstr "　誕生会は夕方六時からだから、まだ時間に余裕はある。"

#. Occurrence WIK_B_1_B:1895:21378: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0007; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:1895
msgctxt "text_id=21378 | speaker=tobimaru"
msgid "  If you're tired, why don't you go take a nap in one of the rooms? You look pretty pale.\""
msgstr "　疲れてるなら部屋で休んできたらどうだ？　ちょいと顔色悪いぜ」"

#. Occurrence WIK_B_1_B:1933:21379: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0009; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:1933
msgctxt "text_id=21379 | speaker=kojika"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence WIK_B_1_B:1938:21380: scene=WIK_B_1_B
#: WIK_B_1_B:1938
msgctxt "text_id=21380 | speaker=unknown"
msgid "  If I had to describe the most unfair aspect of Tsukiji, it was his ability to be sensitive even while coming off as rude."
msgstr "　この男の何が卑怯かって、粗雑で無遠慮のクセに、細かいところに気が利くことだと思う。"

#. Occurrence WIK_B_1_B:1943:21381: scene=WIK_B_1_B
#: WIK_B_1_B:1943
msgctxt "text_id=21381 | speaker=unknown"
msgid "  For my part, I was way too shy."
msgstr "　わたしは人見知りが激しい。"

#. Occurrence WIK_B_1_B:1948:21382: scene=WIK_B_1_B
#: WIK_B_1_B:1948
msgctxt "text_id=21382 | speaker=unknown"
msgid "  It took a serious effort to talk to a lot of people in a new place, even if I already knew them."
msgstr "　いくら顔見知りといっても、慣れない場所で多くの人間と話すのは体力を使う。"

#. Occurrence WIK_B_1_B:1975:21383: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0010; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:1975
msgctxt "text_id=21383 | speaker=kojika"
msgid "\"Yeah. Good idea. I'll go take a break.\""
msgstr "「そうね。ちょっと客室で一息いれてくる」"

#. Occurrence WIK_B_1_B:1995:21384: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0008; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:1995
msgctxt "text_id=21384 | speaker=tobimaru"
msgid "\"That's the spirit. Which one was your room again...?\""
msgstr "「おう、そうしろそうしろ。久万梨の部屋は、たしか」"

#. Occurrence WIK_B_1_B:2007:21385: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_B_1_B_0000; voice_prefix=A50; voice_category=12; scene=WIK_B_1_B
#: WIK_B_1_B:2007
msgctxt "text_id=21385 | speaker=beo"
msgid "\"Hey, Toby! Do you know where Soujyuro went?\""
msgstr "「ねー、トビー。草十郎さん、どこいったか知らない？」"

#. Occurrence WIK_B_1_B:2018:21386: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0009; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:2018
msgctxt "text_id=21386 | speaker=tobimaru"
msgid "\"Shopping, I think."
msgstr "「草十郎なら買い出しじゃないのか？"

#. Occurrence WIK_B_1_B:2024:21387: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0010; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:2024
msgctxt "text_id=21387 | speaker=tobimaru"
msgid "  Said something about needing more drinks.\""
msgstr "　飲み物が足りない、とか言ってたしな」"

#. Occurrence WIK_B_1_B:2050:21388: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_B_1_B_0001; voice_prefix=A50; voice_category=12; scene=WIK_B_1_B
#: WIK_B_1_B:2050
msgctxt "text_id=21388 | speaker=beo"
msgid "\"Well, he coulda said something! I wish he wouldn't try to do everything by himself all the time."
msgstr "「ほんと？　もう、行くならボクに声かけてくれれば良かったのに。あの人の、自分で出来るコトは全部ひとりでやっちゃうところ、ボクどうかと思うなー。"

#. Occurrence WIK_B_1_B:2061:21389: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_B_1_B_0002; voice_prefix=A50; voice_category=12; scene=WIK_B_1_B
#: WIK_B_1_B:2061
msgctxt "text_id=21389 | speaker=beo"
msgid "  Not that I got anything against lone wolves!\""
msgstr "　まあ、そこが動物っぽくていいんだけど！」"

#. Occurrence WIK_B_1_B:2105:21390: scene=WIK_B_1_B
#: WIK_B_1_B:2105
msgctxt "text_id=21390 | speaker=unknown"
msgid "  As I mentioned earlier, the blond boy's name was Beo."
msgstr "　改めて解説すると、この金髪の子供はベオ。"

#. Occurrence WIK_B_1_B:2118:21391: scene=WIK_B_1_B
#: WIK_B_1_B:2118
msgctxt "text_id=21391 | speaker=unknown"
msgid "  I didn't know his full name, nor had he ever formally introduced himself."
msgstr "　フルネームは知らない。名乗られたこともない。"

#. Occurrence WIK_B_1_B:2123:21392: scene=WIK_B_1_B
#: WIK_B_1_B:2123
msgctxt "text_id=21392 | speaker=unknown"
msgid "  Tsukiji, Aozaki, and Sizuki all called him Beo, so I just followed their lead."
msgstr "　槻司や蒼崎、静希がベオと呼んでいるので、わたしもそれに<倣|なら>っているだけだ。"

#. Occurrence WIK_B_1_B:2128:21393: scene=WIK_B_1_B
#: WIK_B_1_B:2128
msgctxt "text_id=21393 | speaker=unknown"
msgid "  He seemed to be fond of Sizuki. Whenever he had a chance, you'd hear him go,"
msgstr "　この子は妙に静希に<懐|なつ>いていて、隙さえあれば、"

#. Occurrence WIK_B_1_B:2166:21394: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_B_1_B_0003; voice_prefix=A50; voice_category=12; scene=WIK_B_1_B
#: WIK_B_1_B:2166
msgctxt "text_id=21394 | speaker=beo"
msgid "\"Soujyuro, I want to go to a theme park the next time you're on break.\""
msgstr "『草十郎さん、今度のお休み、遊園地に行きたいです』"

#. Occurrence WIK_B_1_B:2177:21395: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_B_1_B_0004; voice_prefix=A50; voice_category=12; scene=WIK_B_1_B
#: WIK_B_1_B:2177
msgctxt "text_id=21395 | speaker=beo"
msgid "\"Soujyuro, are you hungry? Let's go out for lunch!\""
msgstr "『草十郎さん、お腹へっちゃってません？　ぜひご一緒しましょう』"

#. Occurrence WIK_B_1_B:2188:21396: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_B_1_B_0005; voice_prefix=A50; voice_category=12; scene=WIK_B_1_B
#: WIK_B_1_B:2188
msgctxt "text_id=21396 | speaker=beo"
msgid "\"Soujyuro, could you pat me on the head? No real reason, I just want you to.\""
msgstr "『草十郎さん、特に理由はありませんけど頭、なでてほしいです』"

#. Occurrence WIK_B_1_B:2225:21397: scene=WIK_B_1_B
#: WIK_B_1_B:2225
msgctxt "text_id=21397 | speaker=unknown"
msgid "  And so on. He clung to him like a cat to a curtain."
msgstr "　などと、猫のように身をすり寄せている。"

#. Occurrence WIK_B_1_B:2230:21398: scene=WIK_B_1_B
#: WIK_B_1_B:2230
msgctxt "text_id=21398 | speaker=unknown"
msgid "  Was Sizuki even the kind of person that was popular with kids? All the \"Soujyuro, Soujyuro\" every day was starting to grate on me."
msgstr "　静希はあれで子供に好かれる性格なのだろうか。草十郎サン草十郎サン、と実にやかましい。"

#. Occurrence WIK_B_1_B:2278:21399: scene=WIK_B_1_B
#: WIK_B_1_B:2278
msgctxt "text_id=21399 | speaker=unknown"
msgid "  Anyway, I went to find my guest room."
msgstr "　ともあれ、今は客室に移動しよう。"

#. Occurrence WIK_B_1_B:2284:21400: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_B_1_B_0011; voice_prefix=B70; voice_category=4; scene=WIK_B_1_B
#: WIK_B_1_B:2284
msgctxt "text_id=21400 | speaker=tobimaru"
msgid "\"Kumari, do you know where your room is?\""
msgstr "「久万梨、部屋は分かってんのか？」"

#. Occurrence WIK_B_1_B:2290:21401: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_1_B_0011; voice_prefix=B10; voice_category=5; scene=WIK_B_1_B
#: WIK_B_1_B:2290
msgctxt "text_id=21401 | speaker=kojika"
msgid "\"I asked Aozaki earlier. She'll be back in about thirty minutes.\""
msgstr "「はじめに蒼崎に聞いた。三十分ぐらいで戻るから」"

#. Occurrence WIK_B_1:33:21402: scene=WIK_B_1
#: WIK_B_1:33
msgctxt "text_id=21402 | speaker=unknown"
msgid "  At the very least, I should greet the mansion's owner and the guests."
msgstr "　何はともあれ、屋敷の主人や、先に来ているゲストたちに挨拶をしなくては。"

#. Occurrence WIK_B_1:38:21403: scene=WIK_B_1
#: WIK_B_1:38
msgctxt "text_id=21403 | speaker=unknown"
msgid "  I decided to head straight to the drawing room."
msgstr "　ここは寄り道せず居間に向かおう。"

#. Occurrence WIK_B_1:48:21404: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_1_0000; voice_prefix=A10; voice_category=1; scene=WIK_B_1
#: WIK_B_1:48
msgctxt "text_id=21404 | speaker=aoko"
msgid "\"Come on. Pretty much everyone's here already.\""
msgstr "「こっちこっち。もうだいたい集まってるから」"

#. Occurrence WIK_B_1:53:21405: scene=WIK_B_1
#: WIK_B_1:53
msgctxt "text_id=21405 | speaker=unknown"
msgid "  The corridor of the east wing's first floor was dimly lit."
msgstr "　一階、東館の廊下はやや薄暗い。"

#. Occurrence WIK_B_1:58:21406: scene=WIK_B_1
#: WIK_B_1:58
msgctxt "text_id=21406 | speaker=unknown"
msgid "  I could hear the sound of friendly chatter from beyond the door ahead."
msgstr "　手前にあるドアから談笑が漏れてきている。"

#. Occurrence WIK_B_2:24:21407: scene=WIK_B_2
#: WIK_B_2:24
msgctxt "text_id=21407 | speaker=unknown"
msgid "  I'll check out the guest room first."
msgstr "　その前に、客室の様子を見に行く事に決めた。"

#. Occurrence WIK_B_2:45:21408: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_2_0000; voice_prefix=B10; voice_category=5; scene=WIK_B_2
#: WIK_B_2:45
msgctxt "text_id=21408 | speaker=kojika"
msgid "\"Housuke, give me back my luggage. I'm going to go look at my room. Where're the guest rooms, Aozaki?\""
msgstr "「芳助、やっぱり荷物返して。先に自分の部屋を見てくるから。蒼崎、その客室ってどこ？」"

#. Occurrence WIK_B_2:51:21409: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_2_0000; voice_prefix=A10; voice_category=1; scene=WIK_B_2
#: WIK_B_2:51
msgctxt "text_id=21409 | speaker=aoko"
msgid "\"Second floor of the east wing. Yours is the second one down."
msgstr "「クマの部屋は二階の東館の、手前から二つ目。"

#. Occurrence WIK_B_2:57:21410: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_2_0001; voice_prefix=A10; voice_category=1; scene=WIK_B_2
#: WIK_B_2:57
msgctxt "text_id=21410 | speaker=aoko"
msgid "  It's unlocked. But there's a key on the desk in there, so go ahead and use it to lock the door on your way out.\""
msgstr "　鍵は開いてるわ。部屋の机の上に鍵があるから、出てくる時はそれで施錠して」"

#. Occurrence WIK_B_2:77:21411: scene=WIK_B_2
#: WIK_B_2:77
msgctxt "text_id=21411 | speaker=unknown"
msgid "  I nodded before making my way to the stairs."
msgstr "　了解、と頷いて移動する。"

#. Occurrence WIK_B_2:104:21412: scene=WIK_B_2
#: WIK_B_2:104
msgctxt "text_id=21412 | speaker=unknown"
msgid "  On the second floor, I found my room"
msgstr "　階段から二階に上がる。"

#. Occurrence WIK_B_2:109:21413: scene=WIK_B_2
#: WIK_B_2:109
msgctxt "text_id=21413 | speaker=unknown"
msgid "  as described."
msgstr "　わたしの部屋は手前から二つ目の部屋だ。"

#. Occurrence WIK_B_2:159:21414: scene=WIK_B_2
#: WIK_B_2:159
msgctxt "text_id=21414 | speaker=unknown"
msgid "  It was unoccupied."
msgstr "　部屋には誰もいない。"

#. Occurrence WIK_B_2:164:21415: scene=WIK_B_2
#: WIK_B_2:164
msgctxt "text_id=21415 | speaker=unknown"
msgid "  I checked to make sure I was alone, then put down my luggage and stowed my wallet in a pocket."
msgstr "　わたしは無人である事を確かめて、荷物を置き、サイフをポケットにいれた。"

#. Occurrence WIK_B_2:169:21416: scene=WIK_B_2
#: WIK_B_2:169
msgctxt "text_id=21416 | speaker=unknown"
msgid "  I considered keeping my favorite bunny-shaped commuter pass--and lucky charm--with me, but all it contained was a yearly school festival photo anyway. I left it on the table."
msgstr "　お<守|まも>り<兼|けん>お気に入りである<×口|バツくち>兎のパスケースを携帯するかは迷ったが、どうせ中には定期と学祭での記念写真しか入っていないので、テーブルに置いておく。"

#. Occurrence WIK_B_2:174:21417: scene=WIK_B_2
#: WIK_B_2:174
msgctxt "text_id=21417 | speaker=unknown"
msgid "  I was going to be spending the night in an unfamiliar building. It was best to travel light."
msgstr "　馴染みのない建物で過ごすのだ。体はできるだけ身軽の方が疲れない。"

#. Occurrence WIK_B_2:195:21418: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_2_0001; voice_prefix=B10; voice_category=5; scene=WIK_B_2
#: WIK_B_2:195
msgctxt "text_id=21418 | speaker=kojika"
msgid "\"Where's that key...? Oh, here it is.\""
msgstr "「鍵は……ああ、これね」"

#. Occurrence WIK_B_2:201:21419: scene=WIK_B_2
#: WIK_B_2:201
msgctxt "text_id=21419 | speaker=unknown"
msgid "  It was a brass key, with an old-fashioned and elaborate design that perfectly complemented the mansion's European theme."
msgstr "　<真鍮|しんちゅう>の鍵。この洋館に相応しい、古めかしくも凝ったデザインだった。"

#. Occurrence WIK_B_2:230:21420: scene=WIK_B_2
#: WIK_B_2:230
msgctxt "text_id=21420 | speaker=unknown"
msgid "  I stepped back into the second-floor corridor."
msgstr "　廊下に出ると、"

#. Occurrence WIK_B_2:265:21421: scene=WIK_B_2
#: WIK_B_2:265
msgctxt "text_id=21421 | speaker=unknown"
msgid "  In the corner of my eye, I spotted an old man in the hall."
msgstr "　ちらりと、二階のホールに老人の姿が見えた。"

#. Occurrence WIK_B_2:270:21422: scene=WIK_B_2
#: WIK_B_2:270
msgctxt "text_id=21422 | speaker=unknown"
msgid "  Must be one of the guests. I set off in his direction to greet him."
msgstr "　ゲストの一人だろう。挨拶をしておこうとホールに向かう。"

#. Occurrence WIK_B_2:319:21423: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_2_0002; voice_prefix=B10; voice_category=5; scene=WIK_B_2
#: WIK_B_2:319
msgctxt "text_id=21423 | speaker=kojika"
msgid "\"Huh?\""
msgstr "「あれ？」"

#. Occurrence WIK_B_2:324:21424: scene=WIK_B_2
#: WIK_B_2:324
msgctxt "text_id=21424 | speaker=unknown"
msgid "  As soon as I did,"
msgstr "　……と。"

#. Occurrence WIK_B_2:329:21425: scene=WIK_B_2
#: WIK_B_2:329
msgctxt "text_id=21425 | speaker=unknown"
msgid "  the old man had vanished. I checked the foyer downstairs, but he wasn't there either."
msgstr "　二階のホールに老人の姿はなく、一階に下りたものと思ってロビーに下りてみたが、そこにも老人の姿はなかった。"

#. Occurrence WIK_B_2:350:21426: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_2_0003; voice_prefix=B10; voice_category=5; scene=WIK_B_2
#: WIK_B_2:350
msgctxt "text_id=21426 | speaker=kojika"
msgid "\"Maybe he went to the west wing.\""
msgstr "「西館の方に行ったとか？」"

#. Occurrence WIK_B_2:355:21427: scene=WIK_B_2
#: WIK_B_2:355
msgctxt "text_id=21427 | speaker=unknown"
msgid "  It was a little concerning, but it would've been rude to wander around the house without greeting the owner first."
msgstr "　少しだけ気になったが、主人に挨拶もしていない状態で館内を歩き回るのも失礼だ。"

#. Occurrence WIK_B_2:360:21428: scene=WIK_B_2
#: WIK_B_2:360
msgctxt "text_id=21428 | speaker=unknown"
msgid "  I headed for the east wing drawing room, where laughter was ringing from within."
msgstr "　わたしは笑い声が聞こえてくる、東館の居間へ足を向けた。"

#. Occurrence WIK_B_3:33:21429: scene=WIK_B_3
#: WIK_B_3:33
msgctxt "text_id=21429 | speaker=unknown"
msgid "  I decided to do something completely meaningless."
msgstr "　意味のない行動をすると決めた。"

#. Occurrence WIK_B_3:39:21430: scene=WIK_B_3
#: WIK_B_3:39
msgctxt "text_id=21430 | speaker=unknown"
msgid "  Honestly, I didn't mean anything by it. It wasn't even a sudden idea―just a whim, a flight of fancy."
msgstr "　いや、ほんとに意図はない。思いつき以下の、１００パー気まぐれ、気の迷い。"

#. Occurrence WIK_B_3:63:21431: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_3_0000; voice_prefix=B10; voice_category=5; scene=WIK_B_3
#: WIK_B_3:63
msgctxt "text_id=21431 | speaker=kojika"
msgid "\"I think I dropped something. I'm going to go look outside, so head on to the drawing room without me.\""
msgstr "「ちょっと落とし物したかも。外を捜してくるから、先に居間に行っていて」"

#. Occurrence WIK_B_3:74:21432: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_3_0000; voice_prefix=A10; voice_category=1; scene=WIK_B_3
#: WIK_B_3:74
msgctxt "text_id=21432 | speaker=aoko"
msgid "\"You're going outside? I'll come with you.\""
msgstr "「外に戻るの？　それなら私も行くわ」"

#. Occurrence WIK_B_3:112:21433: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_B_3_0000_0; voice_prefix=B50; voice_category=6; scene=WIK_B_3
#: WIK_B_3:112
msgctxt "text_id=21433 | speaker=kinomi"
msgid "\"Aw c'mon. Kojika's the klutz, so let her deal with it herself."
msgstr "「えー。なにいってんだよ会長、落とし物したのは金鹿のドジだろ、会長関係ねぇーじゃん。"

#. Occurrence WIK_B_3:123:21434: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_B_3_0000_1; voice_prefix=B50; voice_category=6; scene=WIK_B_3
#: WIK_B_3:123
msgctxt "text_id=21434 | speaker=kinomi"
msgid "  You should come with me, prez. I won't know what to talk with Alice about if you aren't there.\""
msgstr "　それより居間に来てくれよー。会長がいないと有珠ちゃんになに話していいか分かんないよー」"

#. Occurrence WIK_B_3:164:21435: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_3_0001; voice_prefix=A10; voice_category=1; scene=WIK_B_3
#: WIK_B_3:164
msgctxt "text_id=21435 | speaker=aoko"
msgid "\"Huh? But I shouldn't let Kuma go by her―\""
msgstr "「え……でも、クマひとりには、」"

#. Occurrence WIK_B_3:192:21436: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_B_3_0000; voice_prefix=B60; voice_category=7; scene=WIK_B_3
#: WIK_B_3:192
msgctxt "text_id=21436 | speaker=yamashiro"
msgid "\"Would you mind taking us to the drawing room first, Aozaki? It's a little chilly here in the foyer.\""
msgstr "「蒼崎くん、とりあえず居間まで案内してくれません？　このロビー、ちょっと冷えますので」"

#. Occurrence WIK_B_3:218:21437: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_B_3_0002; voice_prefix=A10; voice_category=1; scene=WIK_B_3
#: WIK_B_3:218
msgctxt "text_id=21437 | speaker=aoko"
msgid "\"But I really shouldn't leave a guest alone.\""
msgstr "「いや、でもゲストをひとりっきりにするワケには」"

#. Occurrence WIK_B_3:229:21438: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_3_0001; voice_prefix=B10; voice_category=5; scene=WIK_B_3
#: WIK_B_3:229
msgctxt "text_id=21438 | speaker=kojika"
msgid "\"It's fine, really. I'll be back before you know it."
msgstr "「いいって、気にしないで。すぐに戻るから。"

#. Occurrence WIK_B_3:241:21439: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_3_0002; voice_prefix=B10; voice_category=5; scene=WIK_B_3
#: WIK_B_3:241
msgctxt "text_id=21439 | speaker=kojika"
msgid "  Housuke, give me my luggage. I can handle it from here.\""
msgstr "　芳助、荷物返して。やっぱり自分で持つ」"

#. Occurrence WIK_B_3:316:21440: scene=WIK_B_3
#: WIK_B_3:316
msgctxt "text_id=21440 | speaker=unknown"
msgid "  I left the others behind and headed outside."
msgstr "　蒼崎を振り切るかたちで外に向かう。"

#. Occurrence WIK_B_3:321:21441: scene=WIK_B_3
#: WIK_B_3:321
msgctxt "text_id=21441 | speaker=unknown"
msgid "  Aimlessly, I wandered the woods near the mansion, gawking like a tourist."
msgstr "　外に出て洋館の周りの森を、目的もなく観察する。"

#. Occurrence WIK_B_3:326:21442: scene=WIK_B_3
#: WIK_B_3:326
msgctxt "text_id=21442 | speaker=unknown"
msgid "  No one was around, and the sky was getting increasingly cloudy."
msgstr "　人気はなく、天気はますます曇っていく。"

#. Occurrence WIK_B_3:332:21443: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_B_3_0003; voice_prefix=B10; voice_category=5; scene=WIK_B_3
#: WIK_B_3:332
msgctxt "text_id=21443 | speaker=kojika"
msgid "\"Hm?\""
msgstr "「？」"

#. Occurrence WIK_B_3:337:21444: scene=WIK_B_3
#: WIK_B_3:337
msgctxt "text_id=21444 | speaker=unknown"
msgid "  That was strange. I felt like someone was watching me."
msgstr "　しかし、ふと、視線を感じた。"

#. Occurrence WIK_B_3:342:21445: scene=WIK_B_3
#: WIK_B_3:342
msgctxt "text_id=21445 | speaker=unknown"
msgid "  I..."
msgstr "　わたしは―――"

#. Occurrence WIK_SELECT_C:8:21446: scene=WIK_SELECT_C
#: WIK_SELECT_C:8
msgctxt "text_id=21446 | speaker=unknown"
msgid "-Decision C-"
msgstr "～選択肢Ｃ～"

#. Occurrence WIK_C_1:23:21447: scene=WIK_C_1
#: WIK_C_1:23
msgctxt "text_id=21447 | speaker=unknown"
msgid "  ...Time to find out who that was."
msgstr "　……追いかけよう。"

#. Occurrence WIK_C_1:28:21448: scene=WIK_C_1
#: WIK_C_1:28
msgctxt "text_id=21448 | speaker=unknown"
msgid "  It went against my better judgment, but I decided to track down whoever had been watching me."
msgstr "　不穏なものを感じつつ、わたしは視線の主を追った。"

#. Occurrence WIK_C_1:59:21449: scene=WIK_C_1
#: WIK_C_1:59
msgctxt "text_id=21449 | speaker=unknown"
msgid "  I headed around to the rear of the mansion, where there was a small thicket."
msgstr "　洋館の裏側に回りこむと、そこはちょっとした林だった。"

#. Occurrence WIK_C_1:64:21450: scene=WIK_C_1
#: WIK_C_1:64
msgctxt "text_id=21450 | speaker=unknown"
msgid "  It looked only slightly better kept than the woods surrounding the estate."
msgstr "　洋館を隠す森より、少しだけ手入れがされている。"

#. Occurrence WIK_C_1:70:21451: scene=WIK_C_1
#: WIK_C_1:70
msgctxt "text_id=21451 | speaker=unknown"
msgid "  There,"
msgstr "　そこに、"

#. Occurrence WIK_C_1:78:21452: scene=WIK_C_1
#: WIK_C_1:78
msgctxt "text_id=21452 | speaker=unknown"
msgid "  I saw a woman. She looked terribly out of place."
msgstr "　場違いな女性がひとり。"

#. Occurrence WIK_C_1:115:21453: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_WIK_C_1_0000; voice_prefix=A20; voice_category=11; scene=WIK_C_1
#: WIK_C_1:115
msgctxt "text_id=21453 | speaker=touko"
msgid "\"Hello, there. Are you one of today's guests?\""
msgstr "「おや。君も今日のゲスト？」"

#. Occurrence WIK_C_1:120:21454: scene=WIK_C_1
#: WIK_C_1:120
msgctxt "text_id=21454 | speaker=unknown"
msgid "  Instinctively, I backed away."
msgstr "　わたしは無意識に後退していた。"

#. Occurrence WIK_C_1:125:21455: scene=WIK_C_1
#: WIK_C_1:125
msgctxt "text_id=21455 | speaker=unknown"
msgid "  That was how overwhelming her presence was."
msgstr "　それぐらい、あの女性には凄みがあった。"

#. Occurrence WIK_C_1:162:21456: scene=WIK_C_1
#: WIK_C_1:162
msgctxt "text_id=21456 | speaker=unknown"
msgid "  The leaves crinkled and crunched as my heels trampled them"
msgstr "　ぱち、ぱち。"

#. Occurrence WIK_C_1:167:21457: scene=WIK_C_1
#: WIK_C_1:167
msgctxt "text_id=21457 | speaker=unknown"
msgid "  during my hasty retreat."
msgstr "　逃げ気味のわたしのカカトが落ち葉を踏む音。"

#. Occurrence WIK_C_1:172:21458: scene=WIK_C_1
#: WIK_C_1:172
msgctxt "text_id=21458 | speaker=unknown"
msgid "  The woman watched me with amusement, as if observing a small animal."
msgstr "　そんな小動物めいたわたしを、女性は楽しげに眺めている。"

#. Occurrence WIK_C_1:221:21459: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_WIK_C_1_0001; voice_prefix=A20; voice_category=11; scene=WIK_C_1
#: WIK_C_1:221
msgctxt "text_id=21459 | speaker=touko"
msgid "\"I didn't expect much from their guests, but how mistaken I was! Here you are, a feast for my eyes!"
msgstr "「いやあ、ゲストには何の期待もしていなかったんだが、いるじゃないか、私好みの目の保養が！"

#. Occurrence WIK_C_1:233:21460: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_WIK_C_1_0002; voice_prefix=A20; voice_category=11; scene=WIK_C_1
#: WIK_C_1:233
msgctxt "text_id=21460 | speaker=touko"
msgid "  I have to say, Aoko might actually have some taste after all. This will make things much more interesting.\""
msgstr "　いいね、青子も気が利くようになったもんだ。これなら退屈はしなさそうだよ」"

#. Occurrence WIK_C_1:239:21461: scene=WIK_C_1
#: WIK_C_1:239
msgctxt "text_id=21461 | speaker=unknown"
msgid "  The way she looked at me was a little―no, *incredibly* off-putting."
msgstr "　こちらを見る目が、ちょっと、いや、かなり怪しい。"

#. Occurrence WIK_C_1:244:21462: scene=WIK_C_1
#: WIK_C_1:244
msgctxt "text_id=21462 | speaker=unknown"
msgid "  Where are the police when you need them?"
msgstr "　警察はどこだ。"

#. Occurrence WIK_C_1:272:21463: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_WIK_C_1_0003; voice_prefix=A20; voice_category=11; scene=WIK_C_1
#: WIK_C_1:272
msgctxt "text_id=21463 | speaker=touko"
msgid "\"No need to be alarmed. I'm a guest just like you. Let's be friends."
msgstr "「そう警戒するな。私も君と同じゲストだ、仲良くしよう。"

#. Occurrence WIK_C_1:285:21464: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_WIK_C_1_0004; voice_prefix=A20; voice_category=11; scene=WIK_C_1
#: WIK_C_1:285
msgctxt "text_id=21464 | speaker=touko"
msgid "  To be frank, I didn't expect anyone else to be checking out the lay of the land, before things *go down*."
msgstr "　……しかし。<何|・><事|・><か|・><始|・><ま|・><る|・>前に周囲の地形を確認にくる人間が、私の他にいるとはね。"

#. Occurrence WIK_C_1:297:21465: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_WIK_C_1_0005; voice_prefix=A20; voice_category=11; scene=WIK_C_1
#: WIK_C_1:297
msgctxt "text_id=21465 | speaker=touko"
msgid "  Oh, I like you. I like you, and you're cute... so here's a freebie."
msgstr "　うん、気に入った。気に入ったし可愛いので大サービスしてあげよう。"

#. Occurrence WIK_C_1:309:21466: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_WIK_C_1_0006; voice_prefix=A20; voice_category=11; scene=WIK_C_1
#: WIK_C_1:309
msgctxt "text_id=21466 | speaker=touko"
msgid "  I normally can't see very well. I'm in Aozaki's room. And, I'm not the culprit.\""
msgstr "　私は普段、よく見えない。私は蒼崎の部屋にいる。そして私は犯人ではない」"

#. Occurrence WIK_C_1:315:21467: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_C_1_0000; voice_prefix=B10; voice_category=5; scene=WIK_C_1
#: WIK_C_1:315
msgctxt "text_id=21467 | speaker=kojika"
msgid "\"Huh?\""
msgstr "「え……？」"

#. Occurrence WIK_C_1:342:21468: speaker=touko; speaker_ja=橙子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A20_WIK_C_1_0007; voice_prefix=A20; voice_category=11; scene=WIK_C_1
#: WIK_C_1:342
msgctxt "text_id=21468 | speaker=touko"
msgid "\"Trust me, it'll come in handy. Just keep a lid on it, okay?\""
msgstr "「切り札になるから、あまり口外しないようにね」"

#. Occurrence WIK_C_1:352:21469: scene=WIK_C_1
#: WIK_C_1:352
msgctxt "text_id=21469 | speaker=unknown"
msgid "  And with those strange words, the woman walked off in the direction of the mansion."
msgstr "　女性はおかしな台詞を残して、洋館の方に立ち去っていった。"

#. Occurrence WIK_C_1:358:21470: scene=WIK_C_1
#: WIK_C_1:358
msgctxt "text_id=21470 | speaker=unknown"
msgid "  I didn't feel like following her, so I reentered the house from the front door."
msgstr "　わたしは後を追う気にもなれず、洋館の正面玄関に戻る事にした。"

#. Occurrence WIK_C_1:418:21471: scene=WIK_C_1
#: WIK_C_1:418
msgctxt "text_id=21471 | speaker=unknown"
msgid "  Once in the foyer, I could hear laughter coming from the east wing drawing room, to my right."
msgstr "　ロビーに戻ると、右手の東館―――居間の方から笑い声が聞こえてきた。"

#. Occurrence WIK_C_1:423:21472: scene=WIK_C_1
#: WIK_C_1:423
msgctxt "text_id=21472 | speaker=unknown"
msgid "  I'd kept Aozaki waiting long enough."
msgstr "　蒼崎を待たせている。"

#. Occurrence WIK_C_1:428:21473: scene=WIK_C_1
#: WIK_C_1:428
msgctxt "text_id=21473 | speaker=unknown"
msgid "  Picking up my luggage, I made my way over."
msgstr "　わたしは荷物を抱え直して、居間に足を向けた。"

#. Occurrence WIK_C_2:48:21474: scene=WIK_C_2
#: WIK_C_2:48
msgctxt "text_id=21474 | speaker=unknown"
msgid "  ...Something clearly wasn't right."
msgstr "　……明らかに、不穏なものを感じる。"

#. Occurrence WIK_C_2:53:21475: scene=WIK_C_2
#: WIK_C_2:53
msgctxt "text_id=21475 | speaker=unknown"
msgid "  I recalled this place's reputation as a haunted mansion, but firmly resolved to put that out of my mind. Still, if I was going to explore, it was best not to go alone."
msgstr "　幽霊屋敷の異名を思い出し、わたしは無視する事に決めた。屋敷の周りを探索する時は、誰かと一緒の時がいいだろう。"

#. Occurrence WIK_C_2:85:21476: scene=WIK_C_2
#: WIK_C_2:85
msgctxt "text_id=21476 | speaker=unknown"
msgid "  Returning to the foyer, I could hear laughter coming from the east wing drawing room, to my right."
msgstr "　ロビーに戻ると、右手の東館―――居間の方から笑い声が聞こえてきた。"

#. Occurrence WIK_C_2:90:21477: scene=WIK_C_2
#: WIK_C_2:90
msgctxt "text_id=21477 | speaker=unknown"
msgid "  I picked up my luggage and made my way over."
msgstr "　わたしは荷物を抱え直して、居間に足を向けた。"

#. Occurrence WIK_CHAP2START:57:21478: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_CHAP2START_0000; voice_prefix=B40; voice_category=8; scene=WIK_CHAP2START
#: WIK_CHAP2START:57
msgctxt "text_id=21478 | speaker=eiri"
msgid "\"Oh, dear.\""
msgstr "「これは酷い」"

#. Occurrence WIK_CHAP2START:63:21479: scene=WIK_CHAP2START
#: WIK_CHAP2START:63
msgctxt "text_id=21479 | speaker=unknown"
msgid "  We were on the third floor."
msgstr "　洋館の三階。"

#. Occurrence WIK_CHAP2START:68:21480: scene=WIK_CHAP2START
#: WIK_CHAP2START:68
msgctxt "text_id=21480 | speaker=unknown"
msgid "  A hellish scene greeted us in the attic directly above the hall."
msgstr "　ホールの真上にあたる屋根裏部屋に入ると、そこはこの世のものとは思えぬ地獄だった。"

#. Occurrence WIK_CHAP2START:88:21481: scene=WIK_CHAP2START
#: WIK_CHAP2START:88
msgctxt "text_id=21481 | speaker=unknown"
msgid "  In the center of the room was Yurihiko Tokitsu..."
msgstr "　部屋の中心には土桔由里彦氏……"

#. Occurrence WIK_CHAP2START:106:21482: scene=WIK_CHAP2START
#: WIK_CHAP2START:106
msgctxt "text_id=21482 | speaker=unknown"
msgid "  ...or so we believed."
msgstr "　と思われる遺体がある。"

#. Occurrence WIK_CHAP2START:111:21483: scene=WIK_CHAP2START
#: WIK_CHAP2START:111
msgctxt "text_id=21483 | speaker=unknown"
msgid "  The faceless body had been burned, and most of its limbs mangled."
msgstr "　手足は半分以上千切れ、焼かれ、顔もない。"

#. Occurrence WIK_CHAP2START:116:21484: scene=WIK_CHAP2START
#: WIK_CHAP2START:116
msgctxt "text_id=21484 | speaker=unknown"
msgid "  Only the torso remained in a vaguely recognizable shape."
msgstr "　かろうじて原形を<留|とど>めているのは胴体部分だけ。"

#. Occurrence WIK_CHAP2START:121:21485: scene=WIK_CHAP2START
#: WIK_CHAP2START:121
msgctxt "text_id=21485 | speaker=unknown"
msgid "  A burning stench filled the air inside the soot-covered walls."
msgstr "　部屋には焦げた臭いが充満し、壁は<煤|すす>だらけだった。"

#. Occurrence WIK_CHAP2START:171:21486: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP2START_0000; voice_prefix=B70; voice_category=4; scene=WIK_CHAP2START
#: WIK_CHAP2START:171
msgctxt "text_id=21486 | speaker=tobimaru"
msgid "\"...Can't tell whose face that is anymore, but that's definitely the old man's suitcase.\""
msgstr "「……顔はもう分からないが、こりゃ土桔の爺さんのスーツだ。間違いない」"

#. Occurrence WIK_CHAP2START:183:21487: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_CHAP2START_0000; voice_prefix=B50; voice_category=6; scene=WIK_CHAP2START
#: WIK_CHAP2START:183
msgctxt "text_id=21487 | speaker=kinomi"
msgid "\"Forget it! I ain't looking!\""
msgstr "「オレ見ないからね！　絶対見ないから！」"

#. Occurrence WIK_CHAP2START:193:21488: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_CHAP2START_0000; voice_prefix=A40; voice_category=2; scene=WIK_CHAP2START
#: WIK_CHAP2START:193
msgctxt "text_id=21488 | speaker=alice"
msgid "\"Good old Tokie. Grandiose even in death.\""
msgstr "「トッキィーったら、素敵な人ね。死に様までお祭りのよう」"

#. Occurrence WIK_CHAP2START:203:21489: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_CHAP2START_0000; voice_prefix=A50; voice_category=12; scene=WIK_CHAP2START
#: WIK_CHAP2START:203
msgctxt "text_id=21489 | speaker=beo"
msgid "\"I'm in the mood for barbeque now.\""
msgstr "「焼き肉が食べたい」"

#. Occurrence WIK_CHAP2START:213:21490: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_CHAP2START_0000; voice_prefix=B10; voice_category=5; scene=WIK_CHAP2START
#: WIK_CHAP2START:213
msgctxt "text_id=21490 | speaker=kojika"
msgid "\"Hey, was the room locked?\""
msgstr "「ねえ、部屋に鍵はかけてあったの？」"

#. Occurrence WIK_CHAP2START:223:21491: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP2START_0000; voice_prefix=A10; voice_category=1; scene=WIK_CHAP2START
#: WIK_CHAP2START:223
msgctxt "text_id=21491 | speaker=aoko"
msgid "\"No, Soujyuro's room―I mean, the attic doesn't have a lock. Anyone can come in.\""
msgstr "「草十郎のへ……いえ、屋根裏部屋に鍵は付いていないわ。常時、誰でも入れる状態よ」"

#. Occurrence WIK_CHAP2START:248:21492: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_CHAP2START_0000; voice_prefix=B80; voice_category=13; scene=WIK_CHAP2START
#: WIK_CHAP2START:248
msgctxt "text_id=21492 | speaker=liddell"
msgid "\"Well, shit. Looks like an explosion killed him."
msgstr "「シット。これ、死因は爆発による損傷と火傷ね。"

#. Occurrence WIK_CHAP2START:254:21493: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_CHAP2START_0001; voice_prefix=B80; voice_category=13; scene=WIK_CHAP2START
#: WIK_CHAP2START:254
msgctxt "text_id=21493 | speaker=liddell"
msgid "  I don't see any source of the combustion, though... did Yurihiko like playing with explosives? I wouldn't put it past an artist.\""
msgstr "　爆発もとは見あたらないけど……ユリヒコ、爆弾で遊ぶ性癖があったとか？　まあ、芸術家らしいけど」"

#. Occurrence WIK_CHAP2START:287:21494: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP2START_0000; voice_prefix=B30; voice_category=9; scene=WIK_CHAP2START
#: WIK_CHAP2START:287
msgctxt "text_id=21494 | speaker=ritsuka"
msgid "\"Let's all just calm down. I think this was premeditated. This is a crime scene.\""
msgstr "「みんな冷静になりましょう。これは犯罪よ。犯罪の<匂|にお>いがするわ」"

#. Occurrence WIK_CHAP2START:302:21495: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_CHAP2START_0000; voice_prefix=A30; voice_category=3; scene=WIK_CHAP2START
#: WIK_CHAP2START:302
msgctxt "text_id=21495 | speaker=soujuurou"
msgid "\"Is this flour?\""
msgstr "「どちらかというと、小麦粉ではないだろうか」"

#. Occurrence WIK_CHAP2START:336:21496: scene=WIK_CHAP2START
#: WIK_CHAP2START:336
msgctxt "text_id=21496 | speaker=unknown"
msgid "  Housuke remained on the second floor, trembling."
msgstr "　芳助は怖がって二階で待機している。"

#. Occurrence WIK_CHAP2START:341:21497: scene=WIK_CHAP2START
#: WIK_CHAP2START:341
msgctxt "text_id=21497 | speaker=unknown"
msgid "  The rest of us took turns surveying the scene."
msgstr "　わたしたちは代わる代わる現場を視認していった。"

#. Occurrence WIK_CHAP2START:378:21498: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP2START_0001; voice_prefix=B30; voice_category=9; scene=WIK_CHAP2START
#: WIK_CHAP2START:378
msgctxt "text_id=21498 | speaker=ritsuka"
msgid "\"Nobody touch anything, okay?"
msgstr "「みんな、現場には手を触れないようにね。"

#. Occurrence WIK_CHAP2START:399:21499: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP2START_0002; voice_prefix=B30; voice_category=9; scene=WIK_CHAP2START
#: WIK_CHAP2START:399
msgctxt "text_id=21499 | speaker=ritsuka"
msgid "  Look around in pairs, and make sure the other person doesn't do anything suspicious."
msgstr "　見るときは二人一組で、どちらかが偽装工作をしないか監視しながら調査して。"

#. Occurrence WIK_CHAP2START:420:21500: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP2START_0003; voice_prefix=B30; voice_category=9; scene=WIK_CHAP2START
#: WIK_CHAP2START:420
msgctxt "text_id=21500 | speaker=ritsuka"
msgid "  Allie, do you mind if I call the police? Thanks. I'll go use the phone in the foyer.\""
msgstr "　アッちゃん、警察に連絡をいれてもいい？　ありがと、それじゃあロビーの電話、借りるわね」"

#. Occurrence WIK_CHAP2START:445:21501: scene=WIK_CHAP2START
#: WIK_CHAP2START:445
msgctxt "text_id=21501 | speaker=unknown"
msgid "  Following the orders of a now quite animated Ritsuka, we moved about in pairs."
msgstr "　活き活きしはじめた律架さんの指示に従って、二人一組で行動する。"

#. Occurrence WIK_CHAP2START:450:21502: scene=WIK_CHAP2START
#: WIK_CHAP2START:450
msgctxt "text_id=21502 | speaker=unknown"
msgid "  Since Housuke ran off, I ended up paired with Tsukiji."
msgstr "　芳助が逃げてしまったため、流れ的に、わたしは槻司と組むコトになった。"

#. Occurrence WIK_CHAP2START:485:21503: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP2START_0001; voice_prefix=B70; voice_category=4; scene=WIK_CHAP2START
#: WIK_CHAP2START:485
msgctxt "text_id=21503 | speaker=tobimaru"
msgid "\"Damn. What a way to go out."
msgstr "「―――しっかし、とんでもねえ死因だな。"

#. Occurrence WIK_CHAP2START:491:21504: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP2START_0002; voice_prefix=B70; voice_category=4; scene=WIK_CHAP2START
#: WIK_CHAP2START:491
msgctxt "text_id=21504 | speaker=tobimaru"
msgid "  Who kills someone with an explosion?\""
msgstr "　爆発って、犯人はなに考えてやがる」"

#. Occurrence WIK_CHAP2START:500:21505: scene=WIK_CHAP2START
#: WIK_CHAP2START:500
msgctxt "text_id=21505 | speaker=unknown"
msgid "  I was surprised Tsukiji already saw this as a murder."
msgstr "　意外なのは、槻司がもう「何者かによる殺人事件」と断定している事だ。"

#. Occurrence WIK_CHAP2START:526:21506: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_CHAP2START_0001; voice_prefix=B10; voice_category=5; scene=WIK_CHAP2START
#: WIK_CHAP2START:526
msgctxt "text_id=21506 | speaker=kojika"
msgid "\"...You don't think it was an accident?\""
msgstr "「……これ、事故じゃないの？」"

#. Occurrence WIK_CHAP2START:538:21507: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP2START_0003; voice_prefix=B70; voice_category=4; scene=WIK_CHAP2START
#: WIK_CHAP2START:538
msgctxt "text_id=21507 | speaker=tobimaru"
msgid "\"No, I don't. There's zero chance Tokitsu would handle explosives in the Kuonji house.\""
msgstr "「土桔の爺さんが久遠寺邸で爆発物を取り扱う可能性はゼロだからな」"

#. Occurrence WIK_CHAP2START:565:21508: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP2START_0004; voice_prefix=B70; voice_category=4; scene=WIK_CHAP2START
#: WIK_CHAP2START:565
msgctxt "text_id=21508 | speaker=tobimaru"
msgid "\"Just look at his torso. There are faint scorch marks around his waist. Could be rope burns."
msgstr "「ほら、この胴体、ちょっと見てみろ。腰のあたりに妙な焼け跡がある。これロープじゃねえかな。"

#. Occurrence WIK_CHAP2START:571:21509: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP2START_0005; voice_prefix=B70; voice_category=4; scene=WIK_CHAP2START
#: WIK_CHAP2START:571
msgctxt "text_id=21509 | speaker=tobimaru"
msgid "  It's possible he was tied up and held prisoner.\""
msgstr "　土桔の爺さんは、この部屋でロープで縛られて、軟禁されていたと見るのが妥当だろう」"

#. Occurrence WIK_CHAP2START:582:21510: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_CHAP2START_0002; voice_prefix=B10; voice_category=5; scene=WIK_CHAP2START
#: WIK_CHAP2START:582
msgctxt "text_id=21510 | speaker=kojika"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence WIK_CHAP2START:602:21511: scene=WIK_CHAP2START
#: WIK_CHAP2START:602
msgctxt "text_id=21511 | speaker=unknown"
msgid "  Tied up and killed with a bomb without anyone noticing...?"
msgstr "　では、ロープで縛られて、誰にも気付かれないうちに爆弾で殺された……？"

#. Occurrence WIK_CHAP2START:613:21512: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_CHAP2START_0003; voice_prefix=B10; voice_category=5; scene=WIK_CHAP2START
#: WIK_CHAP2START:613
msgctxt "text_id=21512 | speaker=kojika"
msgid "\"But, why?\""
msgstr "「でも、なんだって」"

#. Occurrence WIK_CHAP2START:625:21513: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP2START_0006; voice_prefix=B70; voice_category=4; scene=WIK_CHAP2START
#: WIK_CHAP2START:625
msgctxt "text_id=21513 | speaker=tobimaru"
msgid "\"Why indeed. Who would go through this much trouble?"
msgstr "「ああ。なんだって、そんな回りくどいコトをしたかって話だ。"

#. Occurrence WIK_CHAP2START:638:21514: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP2START_0007; voice_prefix=B70; voice_category=4; scene=WIK_CHAP2START
#: WIK_CHAP2START:638
msgctxt "text_id=21514 | speaker=tobimaru"
msgid "I suppose the advantage of using explosives is... you can detonate them remotely at a time of your choosing. Helps with creating an alibi.\""
msgstr "爆発物を使う利点は……そうだな、起爆までのタイムラグを利用した時間操作と、遠隔操作があげられる。どちらも<不在証明|アリバイ>作りには有利だな」"

#. Occurrence WIK_CHAP2START:663:21515: scene=WIK_CHAP2START
#: WIK_CHAP2START:663
msgctxt "text_id=21515 | speaker=unknown"
msgid "  Wow."
msgstr "　……驚きだ。"

#. Occurrence WIK_CHAP2START:668:21516: scene=WIK_CHAP2START
#: WIK_CHAP2START:668
msgctxt "text_id=21516 | speaker=unknown"
msgid "  Dead body or not, Tsukiji didn't skip a beat."
msgstr "　槻司は死体を前にしても怯んでいない。"

#. Occurrence WIK_CHAP2START:673:21517: scene=WIK_CHAP2START
#: WIK_CHAP2START:673
msgctxt "text_id=21517 | speaker=unknown"
msgid "  He stayed calm and composed as he analyzed the situation."
msgstr "　いたって冷静に、かつ真剣に、この状況を分析しようとしている。"

#. Occurrence WIK_CHAP2START:678:21518: scene=WIK_CHAP2START
#: WIK_CHAP2START:678
msgctxt "text_id=21518 | speaker=unknown"
msgid "  At times like this, he seemed so perfect."
msgstr "　こういう時の槻司は、たいへん絵になる。"

#. Occurrence WIK_CHAP2START:683:21519: scene=WIK_CHAP2START
#: WIK_CHAP2START:683
msgctxt "text_id=21519 | speaker=unknown"
msgid "  Actually, whenever I saw him get serious about anything, he was so damned cool."
msgstr "　というか、基本的にこの男は、本気になれば文句なしに格好いいのだ。"

#. Occurrence WIK_CHAP2START:710:21520: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP2START_0008; voice_prefix=B70; voice_category=4; scene=WIK_CHAP2START
#: WIK_CHAP2START:710
msgctxt "text_id=21520 | speaker=tobimaru"
msgid "\"But now, I know what the murder weapon was: bread.\""
msgstr "「だがまあ凶器は分かった。パンだ」"

#. Occurrence WIK_CHAP2START:721:21521: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_CHAP2START_0004; voice_prefix=B10; voice_category=5; scene=WIK_CHAP2START
#: WIK_CHAP2START:721
msgctxt "text_id=21521 | speaker=kojika"
msgid "\"Huh?\""
msgstr "「はい？」"

#. Occurrence WIK_CHAP2START:726:21522: scene=WIK_CHAP2START
#: WIK_CHAP2START:726
msgctxt "text_id=21522 | speaker=unknown"
msgid "  A voice called out to us from below."
msgstr "　その時、下からわたしたちを呼ぶ声があった。"

#. Occurrence WIK_CHAP2START:747:21523: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP2START_0004; voice_prefix=B30; voice_category=9; scene=WIK_CHAP2START
#: WIK_CHAP2START:747
msgctxt "text_id=21523 | speaker=ritsuka"
msgid "\"Down here, everyone! We've got a problem!"
msgstr "「みんな、ちょっと来てー！　大変よー！"

#. Occurrence WIK_CHAP2START:753:21524: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP2START_0005; voice_prefix=B30; voice_category=9; scene=WIK_CHAP2START
#: WIK_CHAP2START:753
msgctxt "text_id=21524 | speaker=ritsuka"
msgid "  The phone line is out!\""
msgstr "　電話、繋がってないわー！」"

#. Occurrence WIK_CHAP2START:776:21525: scene=WIK_CHAP2START
#: WIK_CHAP2START:776
msgctxt "text_id=21525 | speaker=unknown"
msgid "  Tsukiji and I looked at each other."
msgstr "　槻司と顔を見合わせる。"

#. Occurrence WIK_CHAP2START:788:21526: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP2START_0009; voice_prefix=B70; voice_category=4; scene=WIK_CHAP2START
#: WIK_CHAP2START:788
msgctxt "text_id=21526 | speaker=tobimaru"
msgid "\"We should check it out, Kumari.\""
msgstr "「久万梨、行くぞ」"

#. Occurrence WIK_CHAP2START:798:21527: scene=WIK_CHAP2START
#: WIK_CHAP2START:798
msgctxt "text_id=21527 | speaker=unknown"
msgid "  I nodded, and we exited the attic together."
msgstr "　頷いて屋根裏を後にする。"

#. Occurrence WIK_CHAP2START:820:21528: scene=WIK_CHAP2START
#: WIK_CHAP2START:820
msgctxt "text_id=21528 | speaker=unknown"
msgid "  Father Eiri closed and locked the door behind us after we returned to the second floor."
msgstr "　二階で待機していた詠梨神父は、わたしたちが出ると扉を閉め、外付けの南京錠で部屋を施錠した。"

#. Occurrence WIK_CHAP2START:868:21529: scene=WIK_CHAP2START
#: WIK_CHAP2START:868
msgctxt "text_id=21529 | speaker=unknown"
msgid "  The sound of the rain was deafening."
msgstr "　雨音が耳に痛い。"

#. Occurrence WIK_CHAP2START:873:21530: scene=WIK_CHAP2START
#: WIK_CHAP2START:873
msgctxt "text_id=21530 | speaker=unknown"
msgid "  We gathered around the telephone."
msgstr "　屋根裏から下りてきたわたしたちは、受話器の前に集まっていた。"

#. Occurrence WIK_CHAP2START:899:21531: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP2START_0006; voice_prefix=B30; voice_category=9; scene=WIK_CHAP2START
#: WIK_CHAP2START:899
msgctxt "text_id=21531 | speaker=ritsuka"
msgid "\"The phone's disconnected. Or rather, the line itself has been cut. We can't call anyone, let alone the police.\""
msgstr "「電話線が切れている……んじゃなくて、電話線そのものが抜かれてるわ。これじゃあ警察に通報するのはおろか、外部への連絡も不可能よ」"

#. Occurrence WIK_CHAP2START:908:21532: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_CHAP2START_0001; voice_prefix=A30; voice_category=3; scene=WIK_CHAP2START
#: WIK_CHAP2START:908
msgctxt "text_id=21532 | speaker=soujuurou"
msgid "\"I'll go tell them in person.\""
msgstr "「じゃあ、直接呼びに行ってきます」"

#. Occurrence WIK_CHAP2START:917:21533: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_CHAP2START_0001; voice_prefix=B40; voice_category=8; scene=WIK_CHAP2START
#: WIK_CHAP2START:917
msgctxt "text_id=21533 | speaker=eiri"
msgid "\"No, wait. We shouldn't go off on our own for the time being. Besides, look outside.\""
msgstr "「いえ、それは待ってください。いま単独行動をされるのはよろしくありません。ほら、外も」"

#. Occurrence WIK_CHAP2START:937:21534: scene=WIK_CHAP2START
#: WIK_CHAP2START:937
msgctxt "text_id=21534 | speaker=unknown"
msgid "  The priest pointed toward the skylight."
msgstr "　神父が天窓を指さす。"

#. Occurrence WIK_CHAP2START:1000:21535: scene=WIK_CHAP2START
#: WIK_CHAP2START:1000
msgctxt "text_id=21535 | speaker=unknown"
msgid "  Raindrops struck the glass hard in a thunderous cadence."
msgstr "　……雨だれがうるさい筈だ。"

#. Occurrence WIK_CHAP2START:1005:21536: scene=WIK_CHAP2START
#: WIK_CHAP2START:1005
msgctxt "text_id=21536 | speaker=unknown"
msgid "  At this point, we were in the midst of a full-blown storm."
msgstr "　外の天気は、もはや嵐と呼んでいい荒れ方だった。"

#. Occurrence WIK_CHAP2START:1010:21537: scene=WIK_CHAP2START
#: WIK_CHAP2START:1010
msgctxt "text_id=21537 | speaker=unknown"
msgid "  We'd all come on foot, so it would be risky to go back down the mountain in this weather."
msgstr "　徒歩でやって来たわたしたちだが、この天気で山を下りるのは少しばかり危険な気がする。"

#. Occurrence WIK_CHAP2START:1030:21538: scene=WIK_CHAP2START
#: WIK_CHAP2START:1030
msgctxt "text_id=21538 | speaker=unknown"
msgid "  However, Father Eiri hadn't stopped Sizuki for his own safety."
msgstr "　それに……詠梨神父が“単独行動はよろしくない”と言った理由は、何も静希の安全を気遣っての事ではない。"

#. Occurrence WIK_CHAP2START:1035:21539: scene=WIK_CHAP2START
#: WIK_CHAP2START:1035
msgctxt "text_id=21539 | speaker=unknown"
msgid "  If someone wandered off by themselves, those left behind would be in a precarious position."
msgstr "　この状況でひとりきりで行動されるのは、残された者たちにとっても不利益なのだ。"

#. Occurrence WIK_CHAP2START:1040:21540: scene=WIK_CHAP2START
#: WIK_CHAP2START:1040
msgctxt "text_id=21540 | speaker=unknown"
msgid "  For instance, it would be easy to destroy evidence without any witnesses around."
msgstr "　たとえば―――ひとりになった事を利用しての、様々な証拠隠滅、とか。"

#. Occurrence WIK_CHAP2START:1066:21541: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_CHAP2START_0002; voice_prefix=B40; voice_category=8; scene=WIK_CHAP2START
#: WIK_CHAP2START:1066
msgctxt "text_id=21541 | speaker=eiri"
msgid "\"For now, let's all head to the drawing room."
msgstr "「とりあえず居間に集まりましょう。"

#. Occurrence WIK_CHAP2START:1072:21542: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_CHAP2START_0003; voice_prefix=B40; voice_category=8; scene=WIK_CHAP2START
#: WIK_CHAP2START:1072
msgctxt "text_id=21542 | speaker=eiri"
msgid "  We should talk over what happened until we can call the police.\""
msgstr "　警察に連絡を入れるのは、話を整理してからでも遅くはありません」"

#. Occurrence WIK_CHAP2START:1130:21543: scene=WIK_CHAP2START
#: WIK_CHAP2START:1130
msgctxt "text_id=21543 | speaker=unknown"
msgid "  Everyone agreed with the priest."
msgstr "　神父の意見にみんな賛成する。"

#. Occurrence WIK_CHAP2START:1170:21544: scene=WIK_CHAP2START
#: WIK_CHAP2START:1170
msgctxt "text_id=21544 | speaker=unknown"
msgid "  Everyone, except Housuke. He seemed to be waiting for someone to reveal that this was all an elaborate prank."
msgstr "　前言撤回。芳助だけは、“なにこれ、ドッキリ？”と現実を見ていなかった。"

#. Occurrence WIK_CHAP2START:1220:21545: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_CHAP2START_0005; voice_prefix=B10; voice_category=5; scene=WIK_CHAP2START
#: WIK_CHAP2START:1220
msgctxt "text_id=21545 | speaker=kojika"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence WIK_CHAP2START:1225:21546: scene=WIK_CHAP2START
#: WIK_CHAP2START:1225
msgctxt "text_id=21546 | speaker=unknown"
msgid "  Feeling a slight chill, I glanced at the front door."
msgstr "　薄ら寒いものを感じて、なんとなく、玄関に視線をやった。"

#. Occurrence WIK_CHAP2START:1230:21547: scene=WIK_CHAP2START
#: WIK_CHAP2START:1230
msgctxt "text_id=21547 | speaker=unknown"
msgid "  ...Just faintly, I had the sense that something was off."
msgstr "　……微かな違和感。"

#. Occurrence WIK_CHAP2START:1235:21548: scene=WIK_CHAP2START
#: WIK_CHAP2START:1235
msgctxt "text_id=21548 | speaker=unknown"
msgid "  Outside, the rain became a torrent."
msgstr "　外の雨は強くなる一方だ。"

#. Occurrence WIK_CHAP2START:1240:21549: scene=WIK_CHAP2START
#: WIK_CHAP2START:1240
msgctxt "text_id=21549 | speaker=unknown"
msgid "  With my mind in a haze, I..."
msgstr "　わたしは、漠然と、"

#. Occurrence WIK_SELECT_F:8:21550: scene=WIK_SELECT_F
#: WIK_SELECT_F:8
msgctxt "text_id=21550 | speaker=unknown"
msgid "-Decision F-"
msgstr "～選択肢Ｆ～"

#. Occurrence WIK_CHAP3START:138:21551: scene=WIK_CHAP3START
#: WIK_CHAP3START:138
msgctxt "text_id=21551 | speaker=unknown"
msgid "  We began a manhunt for Mr. Yamasiro."
msgstr "　満場一致で山城先生の捜索が開始された。"

#. Occurrence WIK_CHAP3START:152:21552: scene=WIK_CHAP3START
#: WIK_CHAP3START:152
msgctxt "text_id=21552 | speaker=unknown"
msgid "  Once we'd separated into groups to scour the mansion, Ritsuka, in charge of the second-floor guest rooms, called us together."
msgstr "　手分けして館内を回っていると、二階の客室を担当していた律架さんがみんなを呼び集めた。"

#. Occurrence WIK_CHAP3START:177:21553: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP3START_0000; voice_prefix=A10; voice_category=1; scene=WIK_CHAP3START
#: WIK_CHAP3START:177
msgctxt "text_id=21553 | speaker=aoko"
msgid "\"This is Mr. Yamasiro's room. Is it locked?\""
msgstr "「ここ、山城先生の客室ね。鍵はかかっているの？」"

#. Occurrence WIK_CHAP3START:187:21554: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0000_0; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:187
msgctxt "text_id=21554 | speaker=ritsuka"
msgid "\"No, it's not. When he wasn't inside, I took a peek inside,"
msgstr "「かかっていなかったわ。留守だと思って中を覗いてみたん、"

#. Occurrence WIK_CHAP3START:201:21555: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0000_1; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:201
msgctxt "text_id=21555 | speaker=ritsuka"
msgid " and, well...\""
msgstr "だけど……っっ」"

#. Occurrence WIK_CHAP3START:207:21556: scene=WIK_CHAP3START
#: WIK_CHAP3START:207
msgctxt "text_id=21556 | speaker=unknown"
msgid "  Ritsuka trailed off."
msgstr "　律架さんはそこで言葉を止めた。"

#. Occurrence WIK_CHAP3START:212:21557: scene=WIK_CHAP3START
#: WIK_CHAP3START:212
msgctxt "text_id=21557 | speaker=unknown"
msgid "  Was it my imagination or is she stifling a laugh?"
msgstr "　最後のあたりはなんとなく笑いを<堪|こら>えているように見えたが、気のせいだと思いたい。"

#. Occurrence WIK_CHAP3START:241:21558: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0001; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:241
msgctxt "text_id=21558 | speaker=ritsuka"
msgid "\"Just take a look for yourselves. Then we can talk.\""
msgstr "「とにかく中を見て。話はその後にしましょう」"

#. Occurrence WIK_CHAP3START:260:21559: scene=WIK_CHAP3START
#: WIK_CHAP3START:260
msgctxt "text_id=21559 | speaker=unknown"
msgid "  Following Ritsuka's direction, we stepped into the room."
msgstr "　律架さんに<促|うなが>されて、わたしたちは部屋の中に足を踏み入れた。"

#. Occurrence WIK_CHAP3START:332:21560: scene=WIK_CHAP3START
#: WIK_CHAP3START:332
msgctxt "text_id=21560 | speaker=unknown"
msgid "  Inside..."
msgstr "　客室に入るとそこは"

#. Occurrence WIK_CHAP3START:338:21561: scene=WIK_CHAP3START
#: WIK_CHAP3START:338
msgctxt "text_id=21561 | speaker=unknown"
msgid "  There was a field of flowers."
msgstr "　一面の花景色。"

#. Occurrence WIK_CHAP3START:408:21562: scene=WIK_CHAP3START
#: WIK_CHAP3START:408
msgctxt "text_id=21562 | speaker=unknown"
msgid "  In its center lay the body of Mr. Yamasiro."
msgstr "　その中心に、山城先生は眠るように息絶えていた。"

#. Occurrence WIK_CHAP3START:461:21563: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP3START_0001; voice_prefix=A10; voice_category=1; scene=WIK_CHAP3START
#: WIK_CHAP3START:461
msgctxt "text_id=21563 | speaker=aoko"
msgid "\"What's with that pose?! Is he supposed to be a pharaoh or something?!\""
msgstr "「ちょっ、ファラオ眠りって……！」"

#. Occurrence WIK_CHAP3START:467:21564: scene=WIK_CHAP3START
#: WIK_CHAP3START:467
msgctxt "text_id=21564 | speaker=unknown"
msgid "  Aozaki desperately tried not to laugh."
msgstr "　蒼崎は必死に笑いを堪えている。"

#. Occurrence WIK_CHAP3START:495:21565: scene=WIK_CHAP3START
#: WIK_CHAP3START:495
msgctxt "text_id=21565 | speaker=unknown"
msgid "  It took a serious effort from me, too."
msgstr "　かくいうわたしも、こみ上げたものを飲みこむので精一杯だった。"

#. Occurrence WIK_CHAP3START:500:21566: scene=WIK_CHAP3START
#: WIK_CHAP3START:500
msgctxt "text_id=21566 | speaker=unknown"
msgid "  Inappropriately, I couldn't help but see the image of Mr. Yamasiro lying serenely on a bed of flowers more as a Kouhaku new year's singing contestant than as a coffin viewing."
msgstr "　不謹慎だけど、花に囲まれた状態で満足そうに永眠している山城先生のビジュアルは、厳かなお葬式というより、紅白歌合戦の大歌手を連想させたからだ。"

#. Occurrence WIK_CHAP3START:529:21567: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_CHAP3START_0000; voice_prefix=B40; voice_category=8; scene=WIK_CHAP3START
#: WIK_CHAP3START:529
msgctxt "text_id=21567 | speaker=eiri"
msgid "\"Oh, dear. Mr. Yamasiro always seemed so normal."
msgstr "「いやはや、いたって健全な方だと思っていたのですが。"

#. Occurrence WIK_CHAP3START:535:21568: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_CHAP3START_0001; voice_prefix=B40; voice_category=8; scene=WIK_CHAP3START
#: WIK_CHAP3START:535
msgctxt "text_id=21568 | speaker=eiri"
msgid "  But this does raise some questions.\""
msgstr "　山城先生は普段、どんな人生を送りたいと思っていたのでしょうね？」"

#. Occurrence WIK_CHAP3START:550:21569: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_CHAP3START_0000; voice_prefix=B80; voice_category=13; scene=WIK_CHAP3START
#: WIK_CHAP3START:550
msgctxt "text_id=21569 | speaker=liddell"
msgid "\"This has to be a sick joke. How can a schoolteacher die in a more flamboyant way than I live?\""
msgstr "「なにこれ。ただの教師がアタシより派手な死に方とか、ふざけてるの？」"

#. Occurrence WIK_CHAP3START:594:21570: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_CHAP3START_0000; voice_prefix=B20; voice_category=10; scene=WIK_CHAP3START
#: WIK_CHAP3START:594
msgctxt "text_id=21570 | speaker=yuika"
msgid "\"Let's leave this here for now. People deserve their dignity, even in death."
msgstr "「皆さん、詮索はそこまでです。<故人|こじん>の人間性をどうこう言うのはデリカシーが欠けています。"

#. Occurrence WIK_CHAP3START:607:21571: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_CHAP3START_0001; voice_prefix=B20; voice_category=10; scene=WIK_CHAP3START
#: WIK_CHAP3START:607
msgctxt "text_id=21571 | speaker=yuika"
msgid "  If another person passes away, I ask you all treat it with more gravity. Is that clear?\""
msgstr "　今後、新たな犠牲者が出た時、その死を笑うような事はないように。いいですね」"

#. Occurrence WIK_CHAP3START:631:21572: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_CHAP3START_0002; voice_prefix=B40; voice_category=8; scene=WIK_CHAP3START
#: WIK_CHAP3START:631
msgctxt "text_id=21572 | speaker=eiri"
msgid "\"Forgive me. I shouldn't have been so facetious."
msgstr "「あ、はい。すみません、確かに不謹慎でした。"

#. Occurrence WIK_CHAP3START:642:21573: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_CHAP3START_0003; voice_prefix=B40; voice_category=8; scene=WIK_CHAP3START
#: WIK_CHAP3START:642
msgctxt "text_id=21573 | speaker=eiri"
msgid "  You're so reliable at times like these, Sister.\""
msgstr "　やはりこういう時は頼りになりますね、唯架くんは」"

#. Occurrence WIK_CHAP3START:655:21574: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_CHAP3START_0002; voice_prefix=B20; voice_category=10; scene=WIK_CHAP3START
#: WIK_CHAP3START:655
msgctxt "text_id=21574 | speaker=yuika"
msgid "\"I'm simply being a responsible adult. You should also conduct yourself in a manner befitting a student supervisor, Father.\""
msgstr "「大人として当然の注意です。学生を監督する立場なのですから、エイリ神父も軽はずみな行為は控えてください」"

#. Occurrence WIK_CHAP3START:690:21575: scene=WIK_CHAP3START
#: WIK_CHAP3START:690
msgctxt "text_id=21575 | speaker=unknown"
msgid "  The room felt colder after Sister Yuika's scolding."
msgstr "　ぴしゃりとした唯架さんのお叱りで、部屋の雰囲気は一気に冷えこんだ。"

#. Occurrence WIK_CHAP3START:695:21576: scene=WIK_CHAP3START
#: WIK_CHAP3START:695
msgctxt "text_id=21576 | speaker=unknown"
msgid "  After we finished examining the room, Miss Kuonji locked it behind us, and we returned to the drawing room."
msgstr "　わたしたちは部屋を調べた後、久遠寺さんのマスターキーで山城先生の客室を施錠して、居間に戻ることになった。"

#. Occurrence WIK_CHAP3START:779:21577: scene=WIK_CHAP3START
#: WIK_CHAP3START:779
msgctxt "text_id=21577 | speaker=unknown"
msgid "  A somber mood settled over the parlor."
msgstr "　居間は重苦しい空気に包まれている。"

#. Occurrence WIK_CHAP3START:784:21578: scene=WIK_CHAP3START
#: WIK_CHAP3START:784
msgctxt "text_id=21578 | speaker=unknown"
msgid "  The gloom wasn't from any sense of grief,"
msgstr "　この重苦しさは死者が増えた事による<悲愴感|ひそうかん>ではない。"

#. Occurrence WIK_CHAP3START:789:21579: scene=WIK_CHAP3START
#: WIK_CHAP3START:789
msgctxt "text_id=21579 | speaker=unknown"
msgid "  but rather a certain feeling that pervaded the group after we split into pairs-"
msgstr "　二人一組になった事で、ある種の空気が<蔓延|まんえん>しだしている事に、わたしは気付いていた。"

#. Occurrence WIK_CHAP3START:795:21580: scene=WIK_CHAP3START
#: WIK_CHAP3START:795
msgctxt "text_id=21580 | speaker=unknown"
msgid "  Suspicion between the teams."
msgstr "　……よくない事に、わたしたちは他のチームを疑い始めてしまっている。"

#. Occurrence WIK_CHAP3START:822:21581: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0000; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:822
msgctxt "text_id=21581 | speaker=tobimaru"
msgid "\"There was no evidence of a struggle in the guest room. Either Mr. Yamasiro invited them in, or they invited themselves in before he arrived."
msgstr "「客室に乱れた様子はなかった。山城を客室に誘い込んだのか、山城が客室にいる時にやってきたのか。"

#. Occurrence WIK_CHAP3START:834:21582: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0001; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:834
msgctxt "text_id=21582 | speaker=tobimaru"
msgid "  Either way, he likely knew them and was taken by surprise."
msgstr "　どちらにせよ、親しい仲での不意打ちだったんだろう。"

#. Occurrence WIK_CHAP3START:834:21583: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0001; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:834
msgctxt "text_id=21583 | speaker=tobimaru"
msgid "  Mr. Yamasiro probably didn't know the rules, so maybe it was easy to make him laugh...\""
msgstr "　山城はルールを知らなかったから、あっさり笑わされたんだろうが……」"

#. Occurrence WIK_CHAP3START:854:21584: scene=WIK_CHAP3START
#: WIK_CHAP3START:854
msgctxt "text_id=21584 | speaker=unknown"
msgid "  Tsukiji spoke to everyone in the room."
msgstr "　槻司は居間に集まった全員に向けて話しかけていた。"

#. Occurrence WIK_CHAP3START:859:21585: scene=WIK_CHAP3START
#: WIK_CHAP3START:859
msgctxt "text_id=21585 | speaker=unknown"
msgid "  Usually, Father Eiri was the one leading the discussion, but now that he was silent, maybe Tsukiji felt he had to step up."
msgstr "　こういう時、みんなの意見を求める立場である詠梨神父がさっきから押し黙っているため、仕方なく代役を買って出た、という顔だ。"

#. Occurrence WIK_CHAP3START:895:21586: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP3START_0002; voice_prefix=A10; voice_category=1; scene=WIK_CHAP3START
#: WIK_CHAP3START:895
msgctxt "text_id=21586 | speaker=aoko"
msgid "\"What's gotten into you, Tobimaru? You're normally more direct than this."
msgstr "「なに、鳶丸。アンタにしちゃ歯切れが悪いじゃない。"

#. Occurrence WIK_CHAP3START:901:21587: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP3START_0003; voice_prefix=A10; voice_category=1; scene=WIK_CHAP3START
#: WIK_CHAP3START:901
msgctxt "text_id=21587 | speaker=aoko"
msgid "  Where are you going with all this?\""
msgstr "　今の憶測に間違いはないと思うけど？」"

#. Occurrence WIK_CHAP3START:913:21588: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0002; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:913
msgctxt "text_id=21588 | speaker=tobimaru"
msgid "\"Oh, it's just that aside from Kuonji and the people from the Church, you, Kumari, and I all knew Mr. Yamasiro well."
msgstr "「いや、教会組や久遠寺はともかく、俺や蒼崎、久万梨は山城先生をよく知ってるだろ。"

#. Occurrence WIK_CHAP3START:925:21589: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0003; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:925
msgctxt "text_id=21589 | speaker=tobimaru"
msgid "  That blockhead wasn't the kind of guy to give you a big belly laugh at your jokes.\""
msgstr "　あの昼行灯が、他人の冗談に心から笑う、っていうのはかなりレアな出来事じゃないか？」"

#. Occurrence WIK_CHAP3START:965:21590: scene=WIK_CHAP3START
#: WIK_CHAP3START:965
msgctxt "text_id=21590 | speaker=unknown"
msgid "  He was right."
msgstr "　そうだ。"

#. Occurrence WIK_CHAP3START:970:21591: scene=WIK_CHAP3START
#: WIK_CHAP3START:970
msgctxt "text_id=21591 | speaker=unknown"
msgid "  Mr. Yamasiro smiled a lot and was easygoing, but he was neutral to a fault. He never responded strongly to people's opinions, almost to the point of utter indifference."
msgstr "　山城先生はいつもニコニコ顔で穏やかだけど、究極の中立者というか、柳に風、のれんに腕押し、<馬耳東風|ばじとうふう>ぐらいにたいていの意見は受け流してしまう。"

#. Occurrence WIK_CHAP3START:975:21592: scene=WIK_CHAP3START
#: WIK_CHAP3START:975
msgctxt "text_id=21592 | speaker=unknown"
msgid "  For him to laugh hard, he must've been taken by surprise, like victims on prank TV shows."
msgstr "　山城先生が本気で笑うとしたら、それは不意打ちの、ドッキリテレビみたいな<脅|おど>かし方ではないだろうか。"

#. Occurrence WIK_CHAP3START:1002:21593: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0004; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:1002
msgctxt "text_id=21593 | speaker=tobimaru"
msgid "\"We can figure out how they made him laugh later."
msgstr "「まあ、『どうやって笑わせたか』は後回しだ。"

#. Occurrence WIK_CHAP3START:1014:21594: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0005; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:1014
msgctxt "text_id=21594 | speaker=tobimaru"
msgid "  Someone's out to get us. Enough of the friendly chit-chat. Let's get to the real issue.\""
msgstr "　どうも敵さん本気で攻めてきてるみたいだからな。仲良し時間は終わりにして、本題に入ろうぜ」"

#. Occurrence WIK_CHAP3START:1023:21595: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_CHAP3START_0004; voice_prefix=B40; voice_category=8; scene=WIK_CHAP3START
#: WIK_CHAP3START:1023
msgctxt "text_id=21595 | speaker=eiri"
msgid "\"Agreed. Who among us is the most likely suspect?"
msgstr "「そうですね。この中の誰がＡなのか。"

#. Occurrence WIK_CHAP3START:1029:21596: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_CHAP3START_0005; voice_prefix=B40; voice_category=8; scene=WIK_CHAP3START
#: WIK_CHAP3START:1029
msgctxt "text_id=21596 | speaker=eiri"
msgid "  We should narrow it down.\""
msgstr "　犯人捜しを始めましょう」"

#. Occurrence WIK_CHAP3START:1065:21597: scene=WIK_CHAP3START
#: WIK_CHAP3START:1065
msgctxt "text_id=21597 | speaker=unknown"
msgid "  I don't think anybody wanted to hear that, but we all knew it needed to happen."
msgstr "　聞きたくはない台詞だったけど、同時に誰もが口にしたくてしょうがなかった台詞。"

#. Occurrence WIK_CHAP3START:1070:21598: scene=WIK_CHAP3START
#: WIK_CHAP3START:1070
msgctxt "text_id=21598 | speaker=unknown"
msgid "  There was no way around it anymore."
msgstr "　そう、これは避けては通れない。"

#. Occurrence WIK_CHAP3START:1075:21599: scene=WIK_CHAP3START
#: WIK_CHAP3START:1075
msgctxt "text_id=21599 | speaker=unknown"
msgid "  Someone here intentionally made both Mr. Tokitsu and Mr. Yamasiro laugh."
msgstr "　この中に土桔由里彦氏と山城先生を『意図的に』笑わせた人物Ａがいるのだ。"

#. Occurrence WIK_CHAP3START:1080:21600: scene=WIK_CHAP3START
#: WIK_CHAP3START:1080
msgctxt "text_id=21600 | speaker=unknown"
msgid "  In Tokitsu's case, they even used explosives... wait."
msgstr "　しかも土桔氏に対しては爆薬まで用いて―――あれ？"

#. Occurrence WIK_CHAP3START:1116:21601: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_CHAP3START_0000; voice_prefix=B10; voice_category=5; scene=WIK_CHAP3START
#: WIK_CHAP3START:1116
msgctxt "text_id=21601 | speaker=kojika"
msgid "\"Um, I know it's a little late to bring this up now, but the way Mr. Tokitsu died...\""
msgstr "「ごめん。今さらだけど、土桔さんの死因ってもしかして」"

#. Occurrence WIK_CHAP3START:1127:21602: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_CHAP3START_0000; voice_prefix=A30; voice_category=3; scene=WIK_CHAP3START
#: WIK_CHAP3START:1127
msgctxt "text_id=21602 | speaker=soujuurou"
msgid "\"Right. Probably death by bread.\""
msgstr "「うん、パンに殺されたんだろうね」"

#. Occurrence WIK_CHAP3START:1138:21603: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_CHAP3START_0000; voice_prefix=A40; voice_category=2; scene=WIK_CHAP3START
#: WIK_CHAP3START:1138
msgctxt "text_id=21603 | speaker=alice"
msgid "\"Makes sense in a way. Tokie did once say that if it wasn't for flour, he'd have saved the world with avant-garde art.\""
msgstr "「トッキィーらしいわ。“この世に小麦粉がなければ、僕は前衛美術で世界をすくっていた”とか、よくこぼしていたもの」"

#. Occurrence WIK_CHAP3START:1186:21604: scene=WIK_CHAP3START
#: WIK_CHAP3START:1186
msgctxt "text_id=21604 | speaker=unknown"
msgid "  Tsukiji scratched his head apologetically."
msgstr "　申し訳なさそうに額をかく槻司。"

#. Occurrence WIK_CHAP3START:1191:21605: scene=WIK_CHAP3START
#: WIK_CHAP3START:1191
msgctxt "text_id=21605 | speaker=unknown"
msgid "  He looked frustrated with himself for thinking so much about the time of death and the identity of the killer."
msgstr "　やれ殺害時間の操作だの、身元の隠蔽だのと考察していた自分に呆れているっぽい。"

#. Occurrence WIK_CHAP3START:1196:21606: scene=WIK_CHAP3START
#: WIK_CHAP3START:1196
msgctxt "text_id=21606 | speaker=unknown"
msgid "  I guess he did have a more sensitive side."
msgstr "　あれで繊細なところもあるのだ、コイツは。"

#. Occurrence WIK_CHAP3START:1233:21607: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_CHAP3START_0003; voice_prefix=B20; voice_category=10; scene=WIK_CHAP3START
#: WIK_CHAP3START:1233
msgctxt "text_id=21607 | speaker=yuika"
msgid "\"I don't believe we need to hunt for the culprit."
msgstr "「犯人捜しなんて、するまでもないと思いますが。"

#. Occurrence WIK_CHAP3START:1245:21608: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_CHAP3START_0004; voice_prefix=B20; voice_category=10; scene=WIK_CHAP3START
#: WIK_CHAP3START:1245
msgctxt "text_id=21608 | speaker=yuika"
msgid "  If this is the work of a Ploy Kickshaw, that makes Alice Kuonji the prime suspect, followed by Aoko Aozaki, and May Riddell Archelot."
msgstr "　これがプロイキッシャーによる犯行なら、第一容疑者は久遠寺有珠、第二容疑者は蒼崎青子、第三容疑者はメイ・リデル・アーシェロット。以上の三名にしぼられます。"

#. Occurrence WIK_CHAP3START:1257:21609: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_CHAP3START_0005; voice_prefix=B20; voice_category=10; scene=WIK_CHAP3START
#: WIK_CHAP3START:1257
msgctxt "text_id=21609 | speaker=yuika"
msgid "  Humans naturally laugh when their sides are prodded or the soles of their feet are tickled. There are ways to get the answers we seek... physically.\""
msgstr "　彼女たちをここで笑わせてしまえば解決です。脇腹を<抉|えぐ>るなり、足の裏を<削|そ>ぐなりすれば人間は笑います。物理的に」"

#. Occurrence WIK_CHAP3START:1306:21610: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0002; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:1306
msgctxt "text_id=21610 | speaker=ritsuka"
msgid "\"Calm down, Yui."
msgstr "「唯ちゃん、ちょっと落ち着いて。"

#. Occurrence WIK_CHAP3START:1318:21611: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0003; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:1318
msgctxt "text_id=21611 | speaker=ritsuka"
msgid "  We should try to keep cool. No fighting. The culprit's probably counting on us to argue."
msgstr "　冷静に、冷静になりましょう、みんな。ケンカはよくないわ、犯人の思うつぼよ、きっと！"

#. Occurrence WIK_CHAP3START:1330:21612: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0004; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:1330
msgctxt "text_id=21612 | speaker=ritsuka"
msgid "  Let's think of this more like a mystery novel and start by checking everyone's alibis, okay? No *physical* interrogations!\""
msgstr "　もっとミステリ的に考えましょう。まずはアリバイ検証とか、ほら、物理的に穏やかな方向で！」"

#. Occurrence WIK_CHAP3START:1339:21613: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_CHAP3START_0006; voice_prefix=B40; voice_category=8; scene=WIK_CHAP3START
#: WIK_CHAP3START:1339
msgctxt "text_id=21613 | speaker=eiri"
msgid "\"I agree with Ritsuka. We can use your method as a last resort, Sister. Remember, we have innocent students here in attendance as well.\""
msgstr "「律架に賛成です。唯架くんも、それは最後の手段としてとっておいてくださいね。槻司くんや久万梨さんが同席しているんですから」"

#. Occurrence WIK_CHAP3START:1388:21614: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0006; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:1388
msgctxt "text_id=21614 | speaker=tobimaru"
msgid "\"Could we wait a bit before we start checking alibis?"
msgstr "「アリバイ検証はちょっと待ってもらえますか？"

#. Occurrence WIK_CHAP3START:1399:21615: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0007; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:1399
msgctxt "text_id=21615 | speaker=tobimaru"
msgid "  Before that... um, Sweets Hearts, was it? I'd like to hear more about that."
msgstr "　その前に、スイーツハーツだっけか？　そいつの特徴を詳しく聞きたいんですけど。"

#. Occurrence WIK_CHAP3START:1405:21616: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0008; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:1405
msgctxt "text_id=21616 | speaker=tobimaru"
msgid "  Kuonji, tell us all you know."
msgstr "　久遠寺、知ってる事を話してくれ。"

#. Occurrence WIK_CHAP3START:1437:21617: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0009; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:1437
msgctxt "text_id=21617 | speaker=tobimaru"
msgid "  We need to understand what it is.\""
msgstr "　ルールがどうたら以前に、そいつがどういうカタチなのか、俺たちは知らねえんだ」"

#. Occurrence WIK_CHAP3START:1477:21618: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_CHAP3START_0001; voice_prefix=A40; voice_category=2; scene=WIK_CHAP3START
#: WIK_CHAP3START:1477
msgctxt "text_id=21618 | speaker=alice"
msgid "\"I suppose you're right. I didn't explain the essentials."
msgstr "「そうね。肝心な事を説明していなかったわ。"

#. Occurrence WIK_CHAP3START:1489:21619: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_CHAP3START_0002; voice_prefix=A40; voice_category=2; scene=WIK_CHAP3START
#: WIK_CHAP3START:1489
msgctxt "text_id=21619 | speaker=alice"
msgid "  Sweets Hearts is an egg-shaped pudding. It kind of looks like a hardboiled egg on top of an upside-down crown.\""
msgstr "　スイーツハーツは卵形のプディングよ。<王冠|おうかん>を逆さにして、ゆで卵を載せたようなカタチ」"

#. Occurrence WIK_CHAP3START:1640:21620: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0005; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:1640
msgctxt "text_id=21620 | speaker=ritsuka"
msgid "\"That's novel. This is the first murder mystery I've heard of where the weapon was a pudding.\""
msgstr "「斬新ね。プリンに殺されるミステリとか、今まで聞いた事もなかったわ」"

#. Occurrence WIK_CHAP3START:1678:21621: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_CHAP3START_0001; voice_prefix=B80; voice_category=13; scene=WIK_CHAP3START
#: WIK_CHAP3START:1678
msgctxt "text_id=21621 | speaker=liddell"
msgid "\"Am I surrounded by idiots?"
msgstr "「バカなの？　バカしかいないの？"

#. Occurrence WIK_CHAP3START:1690:21622: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_CHAP3START_0002; voice_prefix=B80; voice_category=13; scene=WIK_CHAP3START
#: WIK_CHAP3START:1690
msgctxt "text_id=21622 | speaker=liddell"
msgid "  That's merely how it appears before it activates. Sweets Hearts becomes a doppelganger of the person who eats it.\""
msgstr "　それは発動する前のカタチよ。スイーツハーツは自分を食べた相手に、そっくりそのまま<擬態|ぎたい>するの」"

#. Occurrence WIK_CHAP3START:1717:21623: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_CHAP3START_0003; voice_prefix=B80; voice_category=13; scene=WIK_CHAP3START
#: WIK_CHAP3START:1717
msgctxt "text_id=21623 | speaker=liddell"
msgid "\"To be precise, whoever eats Sweets Hearts is imprisoned inside the egg; outside, the doppelganger appears."
msgstr "「というか、スイーツハーツを食べちゃった時点で、食べた人間……これが使用者ね、使用者は卵の中に閉じこめられて、外にはスイーツハーツが擬態した“使用者”が現れる。"

#. Occurrence WIK_CHAP3START:1723:21624: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_CHAP3START_0004; voice_prefix=B80; voice_category=13; scene=WIK_CHAP3START
#: WIK_CHAP3START:1723
msgctxt "text_id=21624 | speaker=liddell"
msgid "  So once Sweets Hearts is activated, it'll be in human form.\""
msgstr "　活動をはじめたスイーツハーツは、人間のカタチをしているってコト」"

#. Occurrence WIK_CHAP3START:1781:21625: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0010; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:1781
msgctxt "text_id=21625 | speaker=tobimaru"
msgid "\"So, basically you're saying a person gets swapped with an imposter, right?\""
msgstr "「―――理屈も道理もあえて訊かないが、要は、本物と偽者が入れ替わるんだな？」"

#. Occurrence WIK_CHAP3START:1790:21626: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_CHAP3START_0005; voice_prefix=B80; voice_category=13; scene=WIK_CHAP3START
#: WIK_CHAP3START:1790
msgctxt "text_id=21626 | speaker=liddell"
msgid "\"Let me correct myself. Only Tobimaru isn't a complete idiot."
msgstr "「前言は撤回してあげる。トビマルだけは猿以上ね。"

#. Occurrence WIK_CHAP3START:1801:21627: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_CHAP3START_0006; voice_prefix=B80; voice_category=13; scene=WIK_CHAP3START
#: WIK_CHAP3START:1801
msgctxt "text_id=21627 | speaker=liddell"
msgid "  That's right. Sweets Hearts is a Ploy that transforms into its user. A perfect replica―so perfect, it doesn't realize what it is.\""
msgstr "　そう、スイーツハーツは使用者に化けるプロイなの。それも完全によ。なにしろ起動してしまったら、スイーツハーツすら自分が“犯人”だとは思っていないんだもの」"

#. Occurrence WIK_CHAP3START:1827:21628: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_CHAP3START_0007; voice_prefix=B80; voice_category=13; scene=WIK_CHAP3START
#: WIK_CHAP3START:1827
msgctxt "text_id=21628 | speaker=liddell"
msgid "\"Too perfect, you could say."
msgstr "「完全に化けるってそういうコトでしょう？"

#. Occurrence WIK_CHAP3START:1838:21629: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_CHAP3START_0008; voice_prefix=B80; voice_category=13; scene=WIK_CHAP3START
#: WIK_CHAP3START:1838
msgctxt "text_id=21629 | speaker=liddell"
msgid "  No matter how much you question or torture the suspect, without objective, absolute proof, they won't be exposed."
msgstr "　犯人と思わしきヤツをどんなに詰問しても、拷問しても、ソレがスイーツハーツだっていう客観的、かつ絶対的な証拠がないと正体は暴けない。"

#. Occurrence WIK_CHAP3START:1850:21630: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_CHAP3START_0009; voice_prefix=B80; voice_category=13; scene=WIK_CHAP3START
#: WIK_CHAP3START:1850
msgctxt "text_id=21630 | speaker=liddell"
msgid "  Once evidence is presented to them, they finally realize that they are the Sweets Hearts in question.\""
msgstr "　“使用者”は証拠をつきつけられて、ようやく自分がスイーツハーツだって気が付くのよ」"

#. Occurrence WIK_CHAP3START:1909:21631: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0006; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:1909
msgctxt "text_id=21631 | speaker=ritsuka"
msgid "\"Oh my god! It's a classic logic puzzle!"
msgstr "「あああーん！　なにそのロジックパズル！"

#. Occurrence WIK_CHAP3START:1916:21632: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0007; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:1916
msgctxt "text_id=21632 | speaker=ritsuka"
msgid "  I can't take it anymore! This is so awesome!\""
msgstr "　たまんないですっ！　正直、もうたまんないです！」"

#. Occurrence WIK_CHAP3START:1927:21633: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_CHAP3START_0006; voice_prefix=B20; voice_category=10; scene=WIK_CHAP3START
#: WIK_CHAP3START:1927
msgctxt "text_id=21633 | speaker=yuika"
msgid "\"It's said the best spies learn to convince themselves they're not spies, but this... is troublesome.\""
msgstr "「……一流のスパイは、まず自分はスパイではないと自己暗示をかけると言いますが……厄介ですね」"

#. Occurrence WIK_CHAP3START:1940:21634: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_CHAP3START_0007; voice_prefix=B40; voice_category=8; scene=WIK_CHAP3START
#: WIK_CHAP3START:1940
msgctxt "text_id=21634 | speaker=eiri"
msgid "\"That doesn't sound quite right. The culprit wants us to laugh, no? If they don't know who they are, what would be the point?\""
msgstr "「いえ、それはおかしい。犯人は明確に笑わせにきているのでしょう？　それで自覚がないというのは、どうも」"

#. Occurrence WIK_CHAP3START:1986:21635: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_CHAP3START_0003; voice_prefix=A40; voice_category=2; scene=WIK_CHAP3START
#: WIK_CHAP3START:1986
msgctxt "text_id=21635 | speaker=alice"
msgid "\"Sweets Hearts and its proxy human can switch on and off."
msgstr "「スイーツハーツと、スイーツハーツが代行している人間はオンオフで切り替わるの。"

#. Occurrence WIK_CHAP3START:2001:21636: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_CHAP3START_0004; voice_prefix=A40; voice_category=2; scene=WIK_CHAP3START
#: WIK_CHAP3START:2001
msgctxt "text_id=21636 | speaker=alice"
msgid "  Though normally a perfect doppelganger, its own personality can emerge when certain conditions are met."
msgstr "　普段は代行している人間そのものだけど、『ルール実行可能』な条件になると、その時だけスイーツハーツの人格に切り替わる。"

#. Occurrence WIK_CHAP3START:2015:21637: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_CHAP3START_0005; voice_prefix=A40; voice_category=2; scene=WIK_CHAP3START
#: WIK_CHAP3START:2015
msgctxt "text_id=21637 | speaker=alice"
msgid "  Of course, when it has the personality of its proxy, it has no memory of being activated.\""
msgstr "　もちろん、『代行している人間』の時の人格には、スイーツハーツを起動した時の記憶は消失しているわ」"

#. Occurrence WIK_CHAP3START:2050:21638: scene=WIK_CHAP3START
#: WIK_CHAP3START:2050
msgctxt "text_id=21638 | speaker=unknown"
msgid "  What kind of setup was this?"
msgstr "　……なんだってのよ、その条件。"

#. Occurrence WIK_CHAP3START:2055:21639: scene=WIK_CHAP3START
#: WIK_CHAP3START:2055
msgctxt "text_id=21639 | speaker=unknown"
msgid "  So, we were dealing with a formless butcher. A murderer with no ill intent."
msgstr "　まるで姿なき殺戮者、殺意なき殺人鬼じゃない。"

#. Occurrence WIK_CHAP3START:2060:21640: scene=WIK_CHAP3START
#: WIK_CHAP3START:2060
msgctxt "text_id=21640 | speaker=unknown"
msgid "  That meant the murderer could be anyone... even me!"
msgstr "　その条件なら誰だって―――わたしですら―――含まれてしまう。"

#. Occurrence WIK_CHAP3START:2065:21641: scene=WIK_CHAP3START
#: WIK_CHAP3START:2065
msgctxt "text_id=21641 | speaker=unknown"
msgid "  Any one of us could be Sweets Hearts!"
msgstr "　現状、誰であれスイーツハーツの可能性があるってコトだもの……！"

#. Occurrence WIK_CHAP3START:2095:21642: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0008; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:2095
msgctxt "text_id=21642 | speaker=ritsuka"
msgid "\"Everyone, relax. Just keep calm."
msgstr "「みんな、落ち着いて。冷静に、冷静になりましょう。"

#. Occurrence WIK_CHAP3START:2110:21643: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0009; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:2110
msgctxt "text_id=21643 | speaker=ritsuka"
msgid "  If we start having too much fun, or start fighting, or get tired of this and try to go home, we're as good as dead.\""
msgstr "　楽しいからって騒いだり、ケンカしたり、もう我慢できないわたしは家に帰るぞー、とか叫んで飛び出していったりしちゃダメよ？　絶対死ぬから」"

#. Occurrence WIK_CHAP3START:2119:21644: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_CHAP3START_0007; voice_prefix=B20; voice_category=10; scene=WIK_CHAP3START
#: WIK_CHAP3START:2119
msgctxt "text_id=21644 | speaker=yuika"
msgid "\"If anyone needs to calm down, it's you.\""
msgstr "「私としては、まず貴女に冷静になってほしいのですが」"

#. Occurrence WIK_CHAP3START:2166:21645: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0010; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:2166
msgctxt "text_id=21645 | speaker=ritsuka"
msgid "\"But how can I be calm in a situation like this?!"
msgstr "「いやーん、ダメ、冷静になんてなれない！"

#. Occurrence WIK_CHAP3START:2190:21646: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0011_0; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:2190
msgctxt "text_id=21646 | speaker=ritsuka"
msgid "@o  If this is a dream, I don't want to wake up! At least half the group needs to ^die to really spice things up! And then, once I'm the last one left alive..."
msgstr "　お願い、夢でも覚めないでっ！　盛り上げる為に、みんなあと半分ぐらい殺されて！　そして当然、最後に生き残るのはわた、"

#. Occurrence WIK_CHAP3START:2251:21647: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP3START_0011_1; voice_prefix=B30; voice_category=9; scene=WIK_CHAP3START
#: WIK_CHAP3START:2251
msgctxt "text_id=21647 | speaker=ritsuka"
msgid "Ack!\""
msgstr "ぐほっ」"

#. Occurrence WIK_CHAP3START:2293:21648: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP3START_0004; voice_prefix=A10; voice_category=1; scene=WIK_CHAP3START
#: WIK_CHAP3START:2293
msgctxt "text_id=21648 | speaker=aoko"
msgid "\"Wow. Talk about a crazy Ploy."
msgstr "「そこまでのトンデモプロイとは思わなかったわ。"

#. Occurrence WIK_CHAP3START:2299:21649: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP3START_0005; voice_prefix=A10; voice_category=1; scene=WIK_CHAP3START
#: WIK_CHAP3START:2299
msgctxt "text_id=21649 | speaker=aoko"
msgid "  I guess all we can do at this point is check everyone's alibis.\""
msgstr "　これは真面目にアリバイ検証をするしかなさそうね」"

#. Occurrence WIK_CHAP3START:2308:21650: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0011; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:2308
msgctxt "text_id=21650 | speaker=tobimaru"
msgid "\"Right. We might not be able to pin Sweets Hearts, but we might be able to figure out who committed the murders.\""
msgstr "「そうだな。誰がスイーツハーツかは判明しないが、誰なら二人を殺せたかは見えてくるかもしれねえ」"

#. Occurrence WIK_CHAP3START:2334:21651: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0012; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:2334
msgctxt "text_id=21651 | speaker=tobimaru"
msgid "\"Let's testify one by one. We should go over everything we did today. If anything seems inconsistent, don't hold back."
msgstr "「それぞれこの一日の行動を証言しよう。もし自分の記憶と違ったところがあったら、容赦なく指摘してくれ。"

#. Occurrence WIK_CHAP3START:2345:21652: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0013; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:2345
msgctxt "text_id=21652 | speaker=tobimaru"
msgid "  I guess I'll start, then.\""
msgstr "　それじゃあ、まずは俺からだな」"

#. Occurrence WIK_CHAP3START:2379:21653: scene=WIK_CHAP3START
#: WIK_CHAP3START:2379
msgctxt "text_id=21653 | speaker=unknown"
msgid "  No one objected to Tsukiji's initiative."
msgstr "　提案者である槻司が先陣をきっては、誰も異論は挟めない。"

#. Occurrence WIK_CHAP3START:2384:21654: scene=WIK_CHAP3START
#: WIK_CHAP3START:2384
msgctxt "text_id=21654 | speaker=unknown"
msgid "  If he didn't want to go first, he'd look suspicious."
msgstr "　ここで待ったをかければ、それこそ自分が怪しいというようなものだし。"

#. Occurrence WIK_CHAP3START:2430:21655: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0014; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:2430
msgctxt "text_id=21655 | speaker=tobimaru"
msgid "\"Beo, Kinomi, Yurihiko, and I all came here at ten this morning."
msgstr "「俺は午前十時に、ベオと木乃美、土桔の爺さんと久遠寺邸に到着した。"

#. Occurrence WIK_CHAP3START:2442:21656: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0015; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:2442
msgctxt "text_id=21656 | speaker=tobimaru"
msgid "  After saying hi to Kuonji, we each went to our rooms to rest, then met again at 11 o'clock in the drawing room and had lunch."
msgstr "　俺たちは久遠寺に挨拶した後、それぞれ与えられた客室で休憩、十一時には居間に再集合し、昼食をとった。"

#. Occurrence WIK_CHAP3START:2454:21657: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0016; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:2454
msgctxt "text_id=21657 | speaker=tobimaru"
msgid "  Oh, yeah. Around that time, Yurihiko went missing.\""
msgstr "　……そうだな、たしかそのあたりで土桔の爺さんはいなくなってたな」"

#. Occurrence WIK_CHAP3START:2481:21658: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0017; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:2481
msgctxt "text_id=21658 | speaker=tobimaru"
msgid "\"Aozaki, Mr. Yamasiro, and Kumari arrived in the afternoon."
msgstr "「午後になって蒼崎、山城、久万梨が到着。"

#. Occurrence WIK_CHAP3START:2493:21659: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0018; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:2493
msgctxt "text_id=21659 | speaker=tobimaru"
msgid "  Then, in the evening, Riddell barged in uninvited."
msgstr "　夕方になってリデルが呼ばれもしないのに乱入。"

#. Occurrence WIK_CHAP3START:2505:21660: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0019; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:2505
msgctxt "text_id=21660 | speaker=tobimaru"
msgid "  I went to the bathroom a few times, but besides that I was here in the drawing room and the sunroom."
msgstr "　何度かトイレで席を立ったが、基本的には居間とサンルームで過ごしていた。"

#. Occurrence WIK_CHAP3START:2517:21661: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP3START_0020; voice_prefix=B70; voice_category=4; scene=WIK_CHAP3START
#: WIK_CHAP3START:2517
msgctxt "text_id=21661 | speaker=tobimaru"
msgid "  During that period, the only person who never left the parlor was Kuonji.\""
msgstr "　俺が居間にいた間、常に姿があったのは久遠寺だけだ」"

#. Occurrence WIK_CHAP3START:2555:21662: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP3START_0006; voice_prefix=A10; voice_category=1; scene=WIK_CHAP3START
#: WIK_CHAP3START:2555
msgctxt "text_id=21662 | speaker=aoko"
msgid "\"This morning, I went shopping in town, then met Kumari straight away in the afternoon. For some reason, Mr. Yamasiro was also there."
msgstr "「私は午前中は街で買い物をして、そのまま昼過ぎに久万梨と合流。なぜか山城先生もいたわ。"

#. Occurrence WIK_CHAP3START:2567:21663: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP3START_0007; voice_prefix=A10; voice_category=1; scene=WIK_CHAP3START
#: WIK_CHAP3START:2567
msgctxt "text_id=21663 | speaker=aoko"
msgid "  The three of us arrived at the mansion sometime after two."
msgstr "　三人で洋館に到着したのが二時過ぎ。"

#. Occurrence WIK_CHAP3START:2579:21664: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP3START_0008; voice_prefix=A10; voice_category=1; scene=WIK_CHAP3START
#: WIK_CHAP3START:2579
msgctxt "text_id=21664 | speaker=aoko"
msgid "  After saying hello to Tobimaru in the drawing room, I spent the rest of the time between there and the sunroom."
msgstr "　居間で鳶丸たちに挨拶して、あとは居間とサンルームをいったりきたり、だったかな。"

#. Occurrence WIK_CHAP3START:2591:21665: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP3START_0009; voice_prefix=A10; voice_category=1; scene=WIK_CHAP3START
#: WIK_CHAP3START:2591
msgctxt "text_id=21665 | speaker=aoko"
msgid "  I left a few times for the restroom, but I didn't see Tokie once.\""
msgstr "　ご不浄で何度か席を立ったけど、一度もトッキィーとは顔を合わせていないわ」"

#. Occurrence WIK_CHAP3START:2629:21666: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_CHAP3START_0000; voice_prefix=A50; voice_category=12; scene=WIK_CHAP3START
#: WIK_CHAP3START:2629
msgctxt "text_id=21666 | speaker=beo"
msgid "\"Huh? Do I have to go too? Whatever, but my story's the same as everyone else's."
msgstr "「ボクもするの？　いいけど、みんなと変わらないよ？"

#. Occurrence WIK_CHAP3START:2641:21667: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_CHAP3START_0001; voice_prefix=A50; voice_category=12; scene=WIK_CHAP3START
#: WIK_CHAP3START:2641
msgctxt "text_id=21667 | speaker=beo"
msgid "  Y'know, it's a long weekend, so I hit Toby up and spent the night at his house yesterday. Housuke was there, too, so it was wild."
msgstr "　えーと、三連休だったので、昨日はトビーの家で寝泊まりしてあげてたよ。ホースケも一緒だったんで、うるさいコトこの上なかったです。"

#. Occurrence WIK_CHAP3START:2653:21668: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_CHAP3START_0002; voice_prefix=A50; voice_category=12; scene=WIK_CHAP3START
#: WIK_CHAP3START:2653
msgctxt "text_id=21668 | speaker=beo"
msgid "  In the morning, we all went to the park together to meet up with the old guy, before coming here in a sweet Rolls-Royce."
msgstr "　で、朝になってから三人で一緒に公園までいって、爺さんと合流して、ロールス・ロイスでここの門に到着。"

#. Occurrence WIK_CHAP3START:2665:21669: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_CHAP3START_0003; voice_prefix=A50; voice_category=12; scene=WIK_CHAP3START
#: WIK_CHAP3START:2665
msgctxt "text_id=21669 | speaker=beo"
msgid "  At ten, I said what's up to Alice. Since then, I've just been here chilling the whole time!\""
msgstr "　十時にはアリスに挨拶して、あとはずっとゴロゴロしてましたー！」"

#. Occurrence WIK_CHAP3START:2698:21670: scene=WIK_CHAP3START
#: WIK_CHAP3START:2698
msgctxt "text_id=21670 | speaker=unknown"
msgid "  I..."
msgstr "　……わたしは、"

#. Occurrence WIK_SELECT_I:8:21671: scene=WIK_SELECT_I
#: WIK_SELECT_I:8
msgctxt "text_id=21671 | speaker=unknown"
msgid "-Decision I-"
msgstr "～選択肢Ｉ～"

#. Occurrence WIK_CHAP4START:95:21672: scene=WIK_CHAP4START
#: WIK_CHAP4START:95
msgctxt "text_id=21672 | speaker=unknown"
msgid "  Unable to go to the drawing room, those of us left behind were stuck standing in the foyer."
msgstr "　残されたわたしたちは、居間に移る事もできずロビーで立ち尽くしていた。"

#. Occurrence WIK_CHAP4START:115:21673: scene=WIK_CHAP4START
#: WIK_CHAP4START:115
msgctxt "text_id=21673 | speaker=unknown"
msgid "  It was surprisingly dark in here."
msgstr "　居間はほぼ明かりが落ちている。"

#. Occurrence WIK_CHAP4START:120:21674: scene=WIK_CHAP4START
#: WIK_CHAP4START:120
msgctxt "text_id=21674 | speaker=unknown"
msgid "  The guest rooms were probably better lit, and I considered going there. Might look weird going by myself, though."
msgstr "　このまま明かりを求めて客室に移動するのがまっとうな考えなんだろうけど、ここで孤立するのはきまりが悪い。"

#. Occurrence WIK_CHAP4START:125:21675: scene=WIK_CHAP4START
#: WIK_CHAP4START:125
msgctxt "text_id=21675 | speaker=unknown"
msgid "  Was Aozaki's older sister, the thirteenth guest, really here?"
msgstr "　十三人目のゲスト、蒼崎のお姉さんが本当にいるのかどうか。"

#. Occurrence WIK_CHAP4START:130:21676: scene=WIK_CHAP4START
#: WIK_CHAP4START:130
msgctxt "text_id=21676 | speaker=unknown"
msgid "  I couldn't go back to my room yet until that mystery was solved, at least."
msgstr "　せめてそれを解明しないと、おちおち部屋に戻れないのだ。"

#. Occurrence WIK_CHAP4START:163:21677: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_CHAP4START_0000; voice_prefix=A30; voice_category=3; scene=WIK_CHAP4START
#: WIK_CHAP4START:163
msgctxt "text_id=21677 | speaker=soujuurou"
msgid "\"For now, let's move Sister Yuika's statue to the corner."
msgstr "「とりあえず、唯架さんの彫像は部屋の隅に移動させよう。"

#. Occurrence WIK_CHAP4START:187:21678: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_CHAP4START_0001; voice_prefix=A30; voice_category=3; scene=WIK_CHAP4START
#: WIK_CHAP4START:187
msgctxt "text_id=21678 | speaker=soujuurou"
msgid "Huh? She's heavy. Very heavy."
msgstr "あれ、重いな。すごく重いぞ唯架さん。"

#. Occurrence WIK_CHAP4START:199:21679: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_CHAP4START_0002; voice_prefix=A30; voice_category=3; scene=WIK_CHAP4START
#: WIK_CHAP4START:199
msgctxt "text_id=21679 | speaker=soujuurou"
msgid "Tobimaru, help me out.\""
msgstr "鳶丸、手伝ってくれ」"

#. Occurrence WIK_CHAP4START:208:21680: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP4START_0000; voice_prefix=B70; voice_category=4; scene=WIK_CHAP4START
#: WIK_CHAP4START:208
msgctxt "text_id=21680 | speaker=tobimaru"
msgid "\"Sure thing, I'll take the back."
msgstr "「あいよ、俺うしろな。"

#. Occurrence WIK_CHAP4START:220:21681: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP4START_0001; voice_prefix=B70; voice_category=4; scene=WIK_CHAP4START
#: WIK_CHAP4START:220
msgctxt "text_id=21681 | speaker=tobimaru"
msgid "...Y'know. She's pretty cute."
msgstr "……む、見た目通りいい曲線してやがんな唯架さん。"

#. Occurrence WIK_CHAP4START:231:21682: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP4START_0002; voice_prefix=B70; voice_category=4; scene=WIK_CHAP4START
#: WIK_CHAP4START:231
msgctxt "text_id=21682 | speaker=tobimaru"
msgid "  No wonder so many lowlifes go to the church.\""
msgstr "　シスター目当てで教会に通い詰める野郎が多いわけだ」"

#. Occurrence WIK_CHAP4START:287:21683: scene=WIK_CHAP4START
#: WIK_CHAP4START:287
msgctxt "text_id=21683 | speaker=unknown"
msgid "  Even in this situation, Sizuki and Tsukiji were friendly."
msgstr "　静希と槻司はこんな状況でも仲がいい。"

#. Occurrence WIK_CHAP4START:294:21684: scene=WIK_CHAP4START
#: WIK_CHAP4START:294
msgctxt "text_id=21684 | speaker=unknown"
msgid "  I couldn't believe how calm they both were."
msgstr "　というより、パニックに<陥|おちい>っていない。"

#. Occurrence WIK_CHAP4START:299:21685: scene=WIK_CHAP4START
#: WIK_CHAP4START:299
msgctxt "text_id=21685 | speaker=unknown"
msgid "  I felt like I was nearing a breaking point. If something jumped out at me, I'd die of shock before I died from laughter."
msgstr "　わたしはもう限界ギリギリで、いま後ろから<脅|おど>かされたら笑い死ぬ前にショック死しそうだ。"

#. Occurrence WIK_CHAP4START:323:21686: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0000; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:323
msgctxt "text_id=21686 | speaker=aoko"
msgid "\"Do you want some tea, Kuma? You look pale.\""
msgstr "「クマ、お茶でも淹れてこようか？　顔色、真っ青よ」"

#. Occurrence WIK_CHAP4START:335:21687: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_CHAP4START_0000; voice_prefix=B10; voice_category=5; scene=WIK_CHAP4START
#: WIK_CHAP4START:335
msgctxt "text_id=21687 | speaker=kojika"
msgid "\"Thanks, but I'm fine.\""
msgstr "「ありがと。けど要らない」"

#. Occurrence WIK_CHAP4START:341:21688: scene=WIK_CHAP4START
#: WIK_CHAP4START:341
msgctxt "text_id=21688 | speaker=unknown"
msgid "  The last thing I wanted was to have to use the toilet, and I was scared of venturing far into the mansion to find one."
msgstr "　トイレ、近くなったらイヤだし。この屋敷のトイレ、奥まったところにあるから怖いのだ。"

#. Occurrence WIK_CHAP4START:367:21689: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0001; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:367
msgctxt "text_id=21689 | speaker=aoko"
msgid "\"Seems like you're doing fine, then. Just keep that spirit up until morning."
msgstr "「お、余裕じゃない。その調子なら朝まで持ちそうね。"

#. Occurrence WIK_CHAP4START:378:21690: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0002; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:378
msgctxt "text_id=21690 | speaker=aoko"
msgid "  It's too bad about Eiri and Yuika, but in a way, I'm actually kind of relieved. At least we're all good friends here, so we can trust each other."
msgstr "　詠梨と唯架さんは残念な事になったけど、ある意味、ちょっと安心した。この面子なら気心知れてるし、疑いあう事もないしね。"

#. Occurrence WIK_CHAP4START:389:21691: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0003; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:389
msgctxt "text_id=21691 | speaker=aoko"
msgid "  We just need to find Touko.\""
msgstr "　あとは橙子を見付ければ、」"

#. Occurrence WIK_CHAP4START:395:21692: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0000; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:395
msgctxt "text_id=21692 | speaker=ritsuka"
msgid "\"No need for that. The game's over."
msgstr "「いえ、それには及ばないわ。ゲームはこれで終わり。"

#. Occurrence WIK_CHAP4START:401:21693: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0001; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:401
msgctxt "text_id=21693 | speaker=ritsuka"
msgid "  I'm impressed, Aoko.\""
msgstr "　今までよくやってくれたものね、アコちゃん？」"

#. Occurrence WIK_CHAP4START:446:21694: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_CHAP4START_0000; voice_prefix=A40; voice_category=2; scene=WIK_CHAP4START
#: WIK_CHAP4START:446
msgctxt "text_id=21694 | speaker=alice"
msgid "\"Ritsuka?\""
msgstr "「律架さん？」"

#. Occurrence WIK_CHAP4START:467:21695: scene=WIK_CHAP4START
#: WIK_CHAP4START:467
msgctxt "text_id=21695 | speaker=unknown"
msgid "  The voice came from the stairs."
msgstr "　声は階段から聞こえてきた。"

#. Occurrence WIK_CHAP4START:473:21696: scene=WIK_CHAP4START
#: WIK_CHAP4START:473
msgctxt "text_id=21696 | speaker=unknown"
msgid "  Ritsuka had returned from her search for Beo."
msgstr "　ベオを探しに行った律架さんが戻ってきたのだ。"

#. Occurrence WIK_CHAP4START:505:21697: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0004; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:505
msgctxt "text_id=21697 | speaker=aoko"
msgid "\"What's that supposed to mean?\""
msgstr "「……なによ。今のどういう意味、律架」"

#. Occurrence WIK_CHAP4START:517:21698: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0002; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:517
msgctxt "text_id=21698 | speaker=ritsuka"
msgid "\"It's about time you dropped the charade."
msgstr "「だから、芝居はもういいって事です。"

#. Occurrence WIK_CHAP4START:529:21699: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0003; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:529
msgctxt "text_id=21699 | speaker=ritsuka"
msgid "  Checkmate, Ako. I haven't got the faintest idea why you went to such lengths, but the physical evidence doesn't lie."
msgstr "　チェックメイトよアコちゃん。どうしてこんな凶行に及んだのかはぜんっぜん分からないけど、物的証拠が真実を示しているの。"

#. Occurrence WIK_CHAP4START:541:21700: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0004; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:541
msgctxt "text_id=21700 | speaker=ritsuka"
msgid "  It's not an open and shut case quite yet, but you're the most likely Sweets Hearts suspect.\""
msgstr "　まだ断定はしないけど、十中八九、貴女がスイーツハーツ最有力候補よ」"

#. Occurrence WIK_CHAP4START:597:21701: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0005; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:597
msgctxt "text_id=21701 | speaker=aoko"
msgid "\"Wha... What the hell're you talking about? There's no way I'm Sweets Hearts."
msgstr "「な、なに言いだすのよバカ律架。私がスイーツハーツだなんて、そんな訳ないじゃないっ。"

#. Occurrence WIK_CHAP4START:608:21702: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0006; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:608
msgctxt "text_id=21702 | speaker=aoko"
msgid "  I mean, um... I'm pretty sure there's no way...\""
msgstr "　……えーと、ないわよね？　ない筈だと思うけど……」"

#. Occurrence WIK_CHAP4START:620:21703: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0005; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:620
msgctxt "text_id=21703 | speaker=ritsuka"
msgid "\"Don't play dumb."
msgstr "「しらばっくれるのもそこまで。"

#. Occurrence WIK_CHAP4START:631:21704: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0006; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:631
msgctxt "text_id=21704 | speaker=ritsuka"
msgid "  While searching for Beo, I went into your room, and found irrefutable evidence!\""
msgstr "　ベオくんを捜している時に、貴女の部屋を見させてもらったわ。動かぬ証拠がそこにあるのよ」"

#. Occurrence WIK_CHAP4START:663:21705: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0007; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:663
msgctxt "text_id=21705 | speaker=aoko"
msgid "\"What?! Y-You... How did you get into my room?! I thought I locked it!\""
msgstr "「うえ!?　ア、アンタ、どうやって私の部屋に入ったのよ!?鍵、かけてあったでしょ!?」"

#. Occurrence WIK_CHAP4START:681:21706: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0007; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:681
msgctxt "text_id=21706 | speaker=ritsuka"
msgid "\"One of my few special skills: lockpicking!\""
msgstr "「わたしの数少ない特技、本格推理ピッキングです！」"

#. Occurrence WIK_CHAP4START:707:21707: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0008; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:707
msgctxt "text_id=21707 | speaker=aoko"
msgid "\"Hey! Lockpicking's illegal!"
msgstr "「ないから！　本格でピッキングはご法度だから！"

#. Occurrence WIK_CHAP4START:718:21708: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0009; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:718
msgctxt "text_id=21708 | speaker=aoko"
msgid "  Finding a dead body that someone desperately tried to hide is totally against the rules!\""
msgstr "　そんなんで、人が必死に隠してた死体を見付けるとか、反則じゃない！」"

#. Occurrence WIK_CHAP4START:779:21709: scene=WIK_CHAP4START
#: WIK_CHAP4START:779
msgctxt "text_id=21709 | speaker=unknown"
msgid "  Aozaki was losing it."
msgstr "　取り乱す蒼崎。"

#. Occurrence WIK_CHAP4START:785:21710: scene=WIK_CHAP4START
#: WIK_CHAP4START:785
msgctxt "text_id=21710 | speaker=unknown"
msgid "  We all stared at her, silently."
msgstr "　そんな彼女を、わたしたちはじーっと無言で観察する。"

#. Occurrence WIK_CHAP4START:812:21711: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0010_0; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:812
msgctxt "text_id=21711 | speaker=aoko"
msgid "\"Uh, no, I mean..."
msgstr "「あ、いや、その……"

#. Occurrence WIK_CHAP4START:825:21712: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0010_1; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:825
msgctxt "text_id=21712 | speaker=aoko"
msgid "Teehee!\""
msgstr "てへ☆」"

#. Occurrence WIK_CHAP4START:836:21713: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP4START_0003; voice_prefix=B70; voice_category=4; scene=WIK_CHAP4START
#: WIK_CHAP4START:836
msgctxt "text_id=21713 | speaker=tobimaru"
msgid "\"Soujyuro, where's Aozaki's room?\""
msgstr "「草十郎、蒼崎の部屋は？」"

#. Occurrence WIK_CHAP4START:847:21714: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_CHAP4START_0003; voice_prefix=A30; voice_category=3; scene=WIK_CHAP4START
#: WIK_CHAP4START:847
msgctxt "text_id=21714 | speaker=soujuurou"
msgid "\"East wing, second floor, end of the hall.\""
msgstr "「東館の二階の突き当たりだ」"

#. Occurrence WIK_CHAP4START:899:21715: scene=WIK_CHAP4START
#: WIK_CHAP4START:899
msgctxt "text_id=21715 | speaker=unknown"
msgid "  We followed Ritsuka to Aozaki's bedroom."
msgstr "　律架さんの先導で、わたしたちは蒼崎の部屋に向かった。"

#. Occurrence WIK_CHAP4START:904:21716: scene=WIK_CHAP4START
#: WIK_CHAP4START:904
msgctxt "text_id=21716 | speaker=unknown"
msgid "  Our suspect tagged along, pouting and sulking."
msgstr "　蒼崎は苦虫をかみつぶしたような顔で付いてくる。"

#. Occurrence WIK_CHAP4START:914:21717: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0008; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:914
msgctxt "text_id=21717 | speaker=ritsuka"
msgid "\"I'm going in.\""
msgstr "「ドアを開けるわ」"

#. Occurrence WIK_CHAP4START:919:21718: scene=WIK_CHAP4START
#: WIK_CHAP4START:919
msgctxt "text_id=21718 | speaker=unknown"
msgid "  Ritsuka opened the door."
msgstr "　律架さんがドアを開ける。"

#. Occurrence WIK_CHAP4START:978:21719: scene=WIK_CHAP4START
#: WIK_CHAP4START:978
msgctxt "text_id=21719 | speaker=unknown"
msgid "  We moved from the dark corridor to the equally dim bedroom."
msgstr "　暗い廊下から、暗い室内へ。"

#. Occurrence WIK_CHAP4START:983:21720: scene=WIK_CHAP4START
#: WIK_CHAP4START:983
msgctxt "text_id=21720 | speaker=unknown"
msgid "  When I entered, I was greeted by the sight of a"
msgstr "　わたしたちが蒼崎の部屋に入ると、そこには"

#. Occurrence WIK_CHAP4START:1088:21721: scene=WIK_CHAP4START
#: WIK_CHAP4START:1088
msgctxt "text_id=21721 | speaker=unknown"
msgid "  a woman beautiful enough to make me question my sexuality,"
msgstr "　同性のわたしでさえ、一目で綺麗だと見惚れる美人が、"

#. Occurrence WIK_CHAP4START:1094:21722: scene=WIK_CHAP4START
#: WIK_CHAP4START:1094
msgctxt "text_id=21722 | speaker=unknown"
msgid "  clutching a microphone in one hand,"
msgstr "　片手にマイク、"

#. Occurrence WIK_CHAP4START:1100:21723: scene=WIK_CHAP4START
#: WIK_CHAP4START:1100
msgctxt "text_id=21723 | speaker=unknown"
msgid "  cradling a huge bottle of liquor in the other,"
msgstr "　かたわらに一升瓶を抱えたまま、"

#. Occurrence WIK_CHAP4START:1106:21724: scene=WIK_CHAP4START
#: WIK_CHAP4START:1106
msgctxt "text_id=21724 | speaker=unknown"
msgid "  taking a satisfied, eternal slumber."
msgstr "　満足そうな顔で永眠していた。"

#. Occurrence WIK_CHAP4START:1126:21725: scene=WIK_CHAP4START
#: WIK_CHAP4START:1126
msgctxt "text_id=21725 | speaker=unknown"
msgid "  And the walls..."
msgstr "　くわえて、"

#. Occurrence WIK_CHAP4START:1168:21726: scene=WIK_CHAP4START
#: WIK_CHAP4START:1168
msgctxt "text_id=21726 | speaker=unknown"
msgid "  ...were plastered with bizarre posters."
msgstr "　部屋には一面、ヘンなポスターが貼られていた。"

#. Occurrence WIK_CHAP4START:1192:21727: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP4START_0004; voice_prefix=B70; voice_category=4; scene=WIK_CHAP4START
#: WIK_CHAP4START:1192
msgctxt "text_id=21727 | speaker=tobimaru"
msgid "\"A-Alcohol poisoning?!\""
msgstr "「きゅ、急性アルコール中毒……！」"

#. Occurrence WIK_CHAP4START:1201:21728: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0009; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:1201
msgctxt "text_id=21728 | speaker=ritsuka"
msgid "\"This is the irrefutable evidence, Ako! I know you and Toko don't get along, but how could you leave her like this?!"
msgstr "「これが動かぬ証拠よ。アコちゃん、いくらトコちゃんが邪魔だからって、こんな、恥ずかしい姿のまま放置しておくなんて……！"

#. Occurrence WIK_CHAP4START:1213:21729: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0010_0; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:1213
msgctxt "text_id=21729 | speaker=ritsuka"
msgid "  Toko, you always said you liked prog rock, but really you just liked enka oldies..."
msgstr "　トコちゃん、“私はプログレ派だー”なんて言ってたけど、ホントは演歌好きだったのね……"

#. Occurrence WIK_CHAP4START:1226:21730: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0010_1; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:1226
msgctxt "text_id=21730 | speaker=ritsuka"
msgid " You even brought your own microphone...\""
msgstr "しかも、マイマイクまで持っちゃって……」"

#. Occurrence WIK_CHAP4START:1253:21731: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0011; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1253
msgctxt "text_id=21731 | speaker=aoko"
msgid "\"Gah! My family's so embarrassing... I didn't want anyone to see this!\""
msgstr "「ああ、身内の恥すぎる……だから見せたくなかったのに！」"

#. Occurrence WIK_CHAP4START:1259:21732: scene=WIK_CHAP4START
#: WIK_CHAP4START:1259
msgctxt "text_id=21732 | speaker=unknown"
msgid "  Aozaki was squirming up a storm."
msgstr "　身もだえする蒼崎。"

#. Occurrence WIK_CHAP4START:1264:21733: scene=WIK_CHAP4START
#: WIK_CHAP4START:1264
msgctxt "text_id=21733 | speaker=unknown"
msgid "  However, this didn't change the fact that she concealed a victim."
msgstr "　しかし。どんな理由であれ、彼女が犠牲者を<隠蔽|いんぺい>していたのは事実である。"

#. Occurrence WIK_CHAP4START:1306:21734: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_CHAP4START_0001; voice_prefix=B10; voice_category=5; scene=WIK_CHAP4START
#: WIK_CHAP4START:1306
msgctxt "text_id=21734 | speaker=kojika"
msgid "\"Now that I think about it, you seemed to be working hard to make sure no one came near your room."
msgstr "「そっか……思い返してみれば、蒼崎は自分の部屋に誰も寄りつかないよう動いていたんだ。"

#. Occurrence WIK_CHAP4START:1318:21735: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_CHAP4START_0002; voice_prefix=B10; voice_category=5; scene=WIK_CHAP4START
#: WIK_CHAP4START:1318
msgctxt "text_id=21735 | speaker=kojika"
msgid "  It wouldn't look good if anyone found the body, right?\""
msgstr "　この人の死体が見つかったら、色々と不便だから」"

#. Occurrence WIK_CHAP4START:1344:21736: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0012; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1344
msgctxt "text_id=21736 | speaker=aoko"
msgid "\"No, that's not how it is! I'm the victim here!"
msgstr "「違う、違うってば！　私も被害者なんだって！"

#. Occurrence WIK_CHAP4START:1350:21737: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0013; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1350
msgctxt "text_id=21737 | speaker=aoko"
msgid "  After lunch, I came here and my sister was dead! Who wouldn't hide that fact?!\""
msgstr "　昼過ぎに部屋に戻ってみたら、姉貴がいきなり死んでるんだもん！　そりゃ隠すでしょ、フツー！」"

#. Occurrence WIK_CHAP4START:1395:21738: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP4START_0005; voice_prefix=B70; voice_category=4; scene=WIK_CHAP4START
#: WIK_CHAP4START:1395
msgctxt "text_id=21738 | speaker=tobimaru"
msgid "\"Sorry, Aozaki, but it's too late for excuses."
msgstr "「……残念だが、蒼崎。おまえさんの弁明はもう遅い。"

#. Occurrence WIK_CHAP4START:1407:21739: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP4START_0006; voice_prefix=B70; voice_category=4; scene=WIK_CHAP4START
#: WIK_CHAP4START:1407
msgctxt "text_id=21739 | speaker=tobimaru"
msgid "  Why didn't you tell everyone about this when we were discussing the thirteenth guest?\""
msgstr "　それならどうして十三人目がいるかいないかを話しあっている時、姉貴の事を話さなかったんだ？」"

#. Occurrence WIK_CHAP4START:1433:21740: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0014; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1433
msgctxt "text_id=21740 | speaker=aoko"
msgid "\"B-B-Because if I'd said something, I would've been grilled about why I hadn't said anything yet! It would've been the perfect opportunity for Eiri and Yuika to accuse me!"
msgstr "「だだ、だって、あの時に切り出しても、どうして黙っていたんだって追及されるじゃない？　詠梨と唯架さんからしてみれば、私を<弾劾|だんがい>する絶好の機会だし。"

#. Occurrence WIK_CHAP4START:1444:21741: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0015; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1444
msgctxt "text_id=21741 | speaker=aoko"
msgid "  I figured if that was the case, then I'd just find the criminal myself...\""
msgstr "　それなら黙っていて、私の手で犯人を捕まえようって……」"

#. Occurrence WIK_CHAP4START:1487:21742: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0011; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:1487
msgctxt "text_id=21742 | speaker=ritsuka"
msgid "\"I don't buy it. You created the thirteenth guest narrative so you could operate behind the scenes."
msgstr "「そうかしら。“十三人目”がいるって状態にしておけば、アコちゃんが自由に暗躍できるからじゃないの？"

#. Occurrence WIK_CHAP4START:1499:21743: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0012; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:1499
msgctxt "text_id=21743 | speaker=ritsuka"
msgid "  The fact of the matter is that Beo, Eiri, and Yui all went down while searching for Toko.\""
msgstr "　事実、トコちゃんを捜そうとしてベオくんも詠梨さんも唯ちゃんもリタイヤしちゃったんだし」"

#. Occurrence WIK_CHAP4START:1509:21744: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0016; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1509
msgctxt "text_id=21744 | speaker=aoko"
msgid "\"That wasn't me! They self-destructed!\""
msgstr "「だから、それは詠梨たちが自滅しただけで、」"

#. Occurrence WIK_CHAP4START:1542:21745: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP4START_0007; voice_prefix=B70; voice_category=4; scene=WIK_CHAP4START
#: WIK_CHAP4START:1542
msgctxt "text_id=21745 | speaker=tobimaru"
msgid "\"Sorry, Aozaki. Kuonji said that Sweets Hearts doesn't know it's the culprit."
msgstr "「悪いな蒼崎。久遠寺の説明からすると、スイーツハーツとやらは“自分でも分からない”犯人だ。"

#. Occurrence WIK_CHAP4START:1554:21746: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP4START_0008; voice_prefix=B70; voice_category=4; scene=WIK_CHAP4START
#: WIK_CHAP4START:1554
msgctxt "text_id=21746 | speaker=tobimaru"
msgid "  Until we expose its true form, we have to prioritize circumstantial evidence over motive.\""
msgstr "　こいつの正体を暴くには、動機より状況証拠を優先しないといけない」"

#. Occurrence WIK_CHAP4START:1581:21747: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP4START_0009; voice_prefix=B70; voice_category=4; scene=WIK_CHAP4START
#: WIK_CHAP4START:1581
msgctxt "text_id=21747 | speaker=tobimaru"
msgid "\"Right now, the one who could easily have killed all the victims is you.\""
msgstr "「現状、もっとも“今までの犠牲者たち”を殺害できる可能性があったのは、おまえだ」"

#. Occurrence WIK_CHAP4START:1593:21748: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0013; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:1593
msgctxt "text_id=21748 | speaker=ritsuka"
msgid "\"Yeah. It pains me to admit it, but that's deduction...\""
msgstr "「ええ。悲しいけど、これ推理なのよね……」"

#. Occurrence WIK_CHAP4START:1613:21749: scene=WIK_CHAP4START
#: WIK_CHAP4START:1613
msgctxt "text_id=21749 | speaker=unknown"
msgid "  Tsukiji and Ritsuka grabbed her arms."
msgstr "　槻司と律架さんが、蒼崎の両手を掴む。"

#. Occurrence WIK_CHAP4START:1621:21750: scene=WIK_CHAP4START
#: WIK_CHAP4START:1621
msgctxt "text_id=21750 | speaker=unknown"
msgid "  Sizuki casually helped."
msgstr "　静希もさりげなく手伝っていた。"

#. Occurrence WIK_CHAP4START:1646:21751: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0017; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1646
msgctxt "text_id=21751 | speaker=aoko"
msgid "\"Hey, what do you think you're doing?!"
msgstr "「ちょっ、どうするつもり！？"

#. Occurrence WIK_CHAP4START:1660:21752: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0018; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1660
msgctxt "text_id=21752 | speaker=aoko"
msgid "  Y-you're just gonna kill me because you suspect me!?\""
msgstr "　まままさか、疑わしきは殺すってワケ！？」"

#. Occurrence WIK_CHAP4START:1687:21753: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0014; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:1687
msgctxt "text_id=21753 | speaker=ritsuka"
msgid "\"Calm down. We're just putting you under quarantine."
msgstr "「落ち着いて、<隔離|かくり>するだけよアコちゃん。"

#. Occurrence WIK_CHAP4START:1699:21754: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0015; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:1699
msgctxt "text_id=21754 | speaker=ritsuka"
msgid "  Lock up the suspect and wait for the police. End the madness. That's how mystery stories go."
msgstr "　犯人と思わしき者は警察が来るまで閉じこめて、凶行をストップさせる……ミステリの常道ね。"

#. Occurrence WIK_CHAP4START:1711:21755: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_CHAP4START_0016; voice_prefix=B30; voice_category=9; scene=WIK_CHAP4START
#: WIK_CHAP4START:1711
msgctxt "text_id=21755 | speaker=ritsuka"
msgid "  So, um, is there a room that locks from the outside somewhere, Allie?\""
msgstr "　えーと、外から鍵をかけられる監獄っぽい部屋はあるかしら、アッちゃん？」"

#. Occurrence WIK_CHAP4START:1753:21756: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_CHAP4START_0001; voice_prefix=A40; voice_category=2; scene=WIK_CHAP4START
#: WIK_CHAP4START:1753
msgctxt "text_id=21756 | speaker=alice"
msgid "\"Just the cellar. It's a pretty tiny room you get to via a narrow staircase."
msgstr "「それなら地下室があるわ。雪山のペンションにありそうな、細い階段から直通の狭い部屋が。"

#. Occurrence WIK_CHAP4START:1765:21757: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_CHAP4START_0002; voice_prefix=A40; voice_category=2; scene=WIK_CHAP4START
#: WIK_CHAP4START:1765
msgctxt "text_id=21757 | speaker=alice"
msgid "  Aoko can spend the night there.\""
msgstr "　青子にはそこで一晩あかしてもらいましょう」"

#. Occurrence WIK_CHAP4START:1789:21758: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0019; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1789
msgctxt "text_id=21758 | speaker=aoko"
msgid "\"What is this, the South Pole?!"
msgstr "「スキー跡！"

msgctxt "text_id=21759 | speaker=unknown"
msgid "  Don't tell me this guest house is an Antarctic research station, Alice!\""
msgstr "　そのペンションの名前、スキー跡とか言わない有珠！？」"

#. Occurrence WIK_CHAP4START:1820:21760: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_CHAP4START_0010; voice_prefix=B70; voice_category=4; scene=WIK_CHAP4START
#: WIK_CHAP4START:1820
msgctxt "text_id=21760 | speaker=tobimaru"
msgid "\"Even if you're not Sweets Hearts, Aozaki, it's safest if we lock you up. It provides us some final insurance. Think of it as taking one for the team.\""
msgstr "「蒼崎。おまえさんがスイーツハーツでないにしろ、そこに閉じこもっていれば安全だろ。これは最後の保険でもあるんだ、観念して生け贄になってくれ」"

#. Occurrence WIK_CHAP4START:1831:21761: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0020; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1831
msgctxt "text_id=21761 | speaker=aoko"
msgid "\"Ugh... Fine. I suppose you're right."
msgstr "「うっ……確かに、そういう理屈になるわね。"

#. Occurrence WIK_CHAP4START:1842:21762: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0021; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1842
msgctxt "text_id=21762 | speaker=aoko"
msgid "  I guess I opened myself up to pesky democracy...\""
msgstr "　民主主義的に、閉じこめられる隙を見せた私の負けってコトか……」"

#. Occurrence WIK_CHAP4START:1877:21763: scene=WIK_CHAP4START
#: WIK_CHAP4START:1877
msgctxt "text_id=21763 | speaker=unknown"
msgid "  Yeah. We should've locked her up from the start."
msgstr "　そう。本当はこの方法を真っ先にしてしまえば良かったんだ。"

#. Occurrence WIK_CHAP4START:1882:21764: scene=WIK_CHAP4START
#: WIK_CHAP4START:1882
msgctxt "text_id=21764 | speaker=unknown"
msgid "  If Aozaki really was Sweets Hearts, no one else would die from any sudden bouts of comedy."
msgstr "　蒼崎がスイーツハーツなら、もうこれ以上、不意をついて笑わせられる犠牲者は出ない。"

#. Occurrence WIK_CHAP4START:1887:21765: scene=WIK_CHAP4START
#: WIK_CHAP4START:1887
msgctxt "text_id=21765 | speaker=unknown"
msgid "  And if she wasn't, then he'd survive until the game was over."
msgstr "　蒼崎がスイーツハーツでないなら、彼女は最後まで生き残るのだから、それでこのゲームはクリアとなる。"

#. Occurrence WIK_CHAP4START:1919:21766: scene=WIK_CHAP4START
#: WIK_CHAP4START:1919
msgctxt "text_id=21766 | speaker=unknown"
msgid "  Who wouldn't protest though, if they were labelled prime suspect?"
msgstr "　けど、誰だって「おまえが犯人だ」と決めつけられて閉じこめられるのはイヤなものだ。"

#. Occurrence WIK_CHAP4START:1924:21767: scene=WIK_CHAP4START
#: WIK_CHAP4START:1924
msgctxt "text_id=21767 | speaker=unknown"
msgid "  It felt awful to be the one handing down a verdict."
msgstr "　手を下す人間も気持ちが悪い。"

#. Occurrence WIK_CHAP4START:1929:21768: scene=WIK_CHAP4START
#: WIK_CHAP4START:1929
msgctxt "text_id=21768 | speaker=unknown"
msgid "  One of us had to unlucky enough to take the fall."
msgstr "　この貧乏クジを引くのは、誰から見ても“有罪”な人間でなくてはならなかった。"

#. Occurrence WIK_CHAP4START:1961:21769: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0022; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1961
msgctxt "text_id=21769 | speaker=aoko"
msgid "\"Just let me say this."
msgstr "「でも、これだけは言っておくわ。"

#. Occurrence WIK_CHAP4START:1967:21770: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_CHAP4START_0023; voice_prefix=A10; voice_category=1; scene=WIK_CHAP4START
#: WIK_CHAP4START:1967
msgctxt "text_id=21770 | speaker=aoko"
msgid "  Your opponent's smart. The thirteenth person may not have a form. Don't let your guard down.\""
msgstr "　相手はとんでもないキレ者よ。もしかしたら本当に姿のない十三人目はいるかもしれない。最後まで気を抜かないで」"

#. Occurrence WIK_CHAP4START:2002:21771: scene=WIK_CHAP4START
#: WIK_CHAP4START:2002
msgctxt "text_id=21771 | speaker=unknown"
msgid "  Those were Aozaki's last words."
msgstr "　それが蒼崎の最後の言葉になった。"

#. Occurrence WIK_CHAP4START:2007:21772: scene=WIK_CHAP4START
#: WIK_CHAP4START:2007
msgctxt "text_id=21772 | speaker=unknown"
msgid "  After shutting her in the cellar and locking it from the outside with a padlock, we finally breathed a sigh of relief."
msgstr "　わたしたちは彼女を地下室に閉じこめ、外から南京錠で鍵をかけ、ようやく安心を手に入れたのである。"

#. Occurrence WIK_CHAP4START:2013:21773: scene=WIK_CHAP4START
#: WIK_CHAP4START:2013
msgctxt "text_id=21773 | speaker=unknown"
msgid "  I..."
msgstr "　そして、わたしは―――"

#. Occurrence WIK_SELECT_R:8:21774: scene=WIK_SELECT_R
#: WIK_SELECT_R:8
msgctxt "text_id=21774 | speaker=unknown"
msgid "-Decision R-"
msgstr "～選択肢Ｒ～"

#. Occurrence WIK_D_1:35:21775: scene=WIK_D_1
#: WIK_D_1:35
msgctxt "text_id=21775 | speaker=unknown"
msgid "  I'm sorry, Ritsuka, but it looks like the rain's only going to get worse."
msgstr "　律架さんには申し訳ないけど、このまま雨脚は強くなる一方だろうな、と思った。"

#. Occurrence WIK_D_2:36:21776: scene=WIK_D_2
#: WIK_D_2:36
msgctxt "text_id=21776 | speaker=unknown"
msgid "  I'm sorry, Ritsuka, but it looks like the rain might turn to hail."
msgstr "　律架さんには申し訳ないけど、このまま雨は雹になるな、と思った。"

#. Occurrence WIK_D_3:36:21777: scene=WIK_D_3
#: WIK_D_3:36
msgctxt "text_id=21777 | speaker=unknown"
msgid "  Maybe I should just go home."
msgstr "　わたしは、このまま帰ってしまおうか、と思った。"

#. Occurrence WIK_D_3:62:21778: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_D_3_0000; voice_prefix=B30; voice_category=9; scene=WIK_D_3
#: WIK_D_3:62
msgctxt "text_id=21778 | speaker=ritsuka"
msgid "\"The weather forecast said it'd be sunny..."
msgstr "「天気予報はずっとお日様マークだったのに。"

#. Occurrence WIK_D_3:73:21779: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_D_3_0001; voice_prefix=B30; voice_category=9; scene=WIK_D_3
#: WIK_D_3:73
msgctxt "text_id=21779 | speaker=ritsuka"
msgid "  Hmm. If this gets any worse, it might be hard to get home. Most taxis are only willing to drive halfway up the mountain.\""
msgstr "　……んー、本降りになったら帰りはタイヘンかも。ほら、山の中程までしかあがってこないでしょ、タクシー」"

#. Occurrence WIK_D_3:106:21780: scene=WIK_D_3
#: WIK_D_3:106
msgctxt "text_id=21780 | speaker=unknown"
msgid "  Ritsuka was right."
msgstr "　律架さんの言う通りだ。"

#. Occurrence WIK_D_3:111:21781: scene=WIK_D_3
#: WIK_D_3:111
msgctxt "text_id=21781 | speaker=unknown"
msgid "  If you really wanted to go home, you'd have to be ready to be soaked to the bone."
msgstr "　本格的に降り出したら、帰りは濡れるのを覚悟しないといけない。"

#. Occurrence WIK_D_3:116:21782: scene=WIK_D_3
#: WIK_D_3:116
msgctxt "text_id=21782 | speaker=unknown"
msgid "  Thinking about it, I couldn't believe Aozaki stuck out the commute to and from school for over two years. I was impressed."
msgstr "　二年以上ここから学校に通っていた蒼崎のタフさに、今更ながら感心するような、呆れるような。"

#. Occurrence WIK_D_3:153:21783: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_D_3_0002; voice_prefix=B30; voice_category=9; scene=WIK_D_3
#: WIK_D_3:153
msgctxt "text_id=21783 | speaker=ritsuka"
msgid "\"Huh? What's up, Kojika?"
msgstr "「あれ？　どうしたの金鹿ちゃん？"

#. Occurrence WIK_D_3:159:21784: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_D_3_0003; voice_prefix=B30; voice_category=9; scene=WIK_D_3
#: WIK_D_3:159
msgctxt "text_id=21784 | speaker=ritsuka"
msgid "  Isn't everyone in the drawing room?\""
msgstr "　みんな居間にいるんじゃないの？」"

#. Occurrence WIK_D_3:170:21785: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_D_3_0000; voice_prefix=B10; voice_category=5; scene=WIK_D_3
#: WIK_D_3:170
msgctxt "text_id=21785 | speaker=kojika"
msgid "\"I just forgot something in my room."
msgstr "「いえ、部屋に忘れ物があるんです。"

#. Occurrence WIK_D_3:181:21786: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_D_3_0001; voice_prefix=B10; voice_category=5; scene=WIK_D_3
#: WIK_D_3:181
msgctxt "text_id=21786 | speaker=kojika"
msgid "  You guys can go on ahead.\""
msgstr "　みなさん、先に行っていてください」"

#. Occurrence WIK_D_3:303:21787: scene=WIK_D_3
#: WIK_D_3:303
msgctxt "text_id=21787 | speaker=unknown"
msgid "  I retrieved my overnight bag from the guest room and returned to the foyer."
msgstr "　客室からボストンバッグを回収して、ロビーに戻る。"

#. Occurrence WIK_D_3:308:21788: scene=WIK_D_3
#: WIK_D_3:308
msgctxt "text_id=21788 | speaker=unknown"
msgid "  I could hear Ritsuka and the others laughing in the drawing room."
msgstr "　居間からは律架さんたちの笑い声が聞こえてくる。"

#. Occurrence WIK_D_3:313:21789: scene=WIK_D_3
#: WIK_D_3:313
msgctxt "text_id=21789 | speaker=unknown"
msgid "  Reluctantly, I left the Kuonji Estate."
msgstr "　わたしは賑わいに後ろ髪を引かれながらも、久遠寺邸を後にした。"

#. Occurrence WIK_D_3:361:21790: scene=WIK_D_3
#: WIK_D_3:361
msgctxt "text_id=21790 | speaker=unknown"
msgid "  I'm not exactly sure why I wanted to go home."
msgstr "　どうして帰る気になったのか、自分でもいまいち不明。"

#. Occurrence WIK_D_3:366:21791: scene=WIK_D_3
#: WIK_D_3:366
msgctxt "text_id=21791 | speaker=unknown"
msgid "  Maybe I felt overwhelmed by the mansion."
msgstr "　洋館の雰囲気に気圧されたとか、"

#. Occurrence WIK_D_3:371:21792: scene=WIK_D_3
#: WIK_D_3:371
msgctxt "text_id=21792 | speaker=unknown"
msgid "  Maybe it just wasn't my scene."
msgstr "　やっぱり柄じゃないとか、"

#. Occurrence WIK_D_3:376:21793: scene=WIK_D_3
#: WIK_D_3:376
msgctxt "text_id=21793 | speaker=unknown"
msgid "  Or maybe... it was because Tsukiji was there. It was probably a combination of all three."
msgstr "　槻司がいたコトとか、たぶん、いろいろ合わさって面倒くさくなったのだ。"

#. Occurrence WIK_D_3:409:21794: scene=WIK_D_3
#: WIK_D_3:409
msgctxt "text_id=21794 | speaker=unknown"
msgid "  The sun was nearly below the horizon."
msgstr "　もうじき日も沈む。"

#. Occurrence WIK_D_3:414:21795: scene=WIK_D_3
#: WIK_D_3:414
msgctxt "text_id=21795 | speaker=unknown"
msgid "  If I could just get home before dark, I could end the day without incident."
msgstr "　夜になる前に帰れば、何事もなく今日は終わるだろう。"

#. Occurrence WIK_D_3:419:21796: scene=WIK_D_3
#: WIK_D_3:419
msgctxt "text_id=21796 | speaker=unknown"
msgid "  I wasn't ready to face Tsukiji, with entrance exams around the corner."
msgstr "　念願の大学受験を前にして、槻司と顔を合わせるのはいろいろブレそうで怖いし。"

#. Occurrence WIK_D_3:424:21797: scene=WIK_D_3
#: WIK_D_3:424
msgctxt "text_id=21797 | speaker=unknown"
msgid "  Walking down Shiroinuzuka, I told myself this was for the best."
msgstr "　これでいいんだ、と自分に言い聞かせて、わたしは白犬塚を下りていく。"

#. Occurrence WIK_D_3:486:21798: scene=WIK_D_3
#: WIK_D_3:486
msgctxt "text_id=21798 | speaker=unknown"
msgid "  But then..."
msgstr "　―――そんな時。"

#. Occurrence WIK_D_3:491:21799: scene=WIK_D_3
#: WIK_D_3:491
msgctxt "text_id=21799 | speaker=unknown"
msgid "  ...I suddenly recalled another urban legend."
msgstr "　わたしはふと、子供たちに伝わっていた伝説を、もう一つだけ思い出した。"

#. Occurrence WIK_D_3:515:21800: scene=WIK_D_3
#: WIK_D_3:515
msgctxt "text_id=21800 | speaker=unknown"
msgid "          \"Descend the mountain alone in the witching hour"
msgstr "　　　　　『<逢魔|おうま>が<時|とき>にひとりで山を下りると、"

#. Occurrence WIK_D_3:520:21801: scene=WIK_D_3
#: WIK_D_3:520
msgctxt "text_id=21801 | speaker=unknown"
msgid "            and a cannibal will be waiting for you at the bottom.\""
msgstr "　　　　　　人食い鬼が待っている』"

#. Occurrence WIK_D_3:540:21802: scene=WIK_D_3
#: WIK_D_3:540
msgctxt "text_id=21802 | speaker=unknown"
msgid "  Long before the Kuonji Estate was built, this mountain was home to a monster who attacked and killed anyone foolish enough to stray too far from their group."
msgstr "　久遠寺邸が建つ前からもっと昔、この山には鬼が隠れ住んでいて、ひとりきりで輪から外れようとする人間を襲って殺す鬼がいた。"

#. Occurrence WIK_D_3:545:21803: scene=WIK_D_3
#: WIK_D_3:545
msgctxt "text_id=21803 | speaker=unknown"
msgid "  The words \"attacked and killed\" make it sound more humane than \"ate.\""
msgstr "　襲って食べる、というのではなく、殺す、というのが人間的で生々しい。"

#. Occurrence WIK_D_3:550:21804: scene=WIK_D_3
#: WIK_D_3:550
msgctxt "text_id=21804 | speaker=unknown"
msgid "  It was probably someone who was cast out of their village."
msgstr "　村社会のしきたりから外れた人間を村ぐるみで闇に葬った、なんて解釈もできる。"

#. Occurrence WIK_D_3:555:21805: scene=WIK_D_3
#: WIK_D_3:555
msgctxt "text_id=21805 | speaker=unknown"
msgid "  Wow, these are some dark thoughts I'm h―"
msgstr "　そんな、暗い妄想に<耽|ふけ>っていると、"

#. Occurrence WIK_D_3:605:21806: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_D_3_0002; voice_prefix=B10; voice_category=5; scene=WIK_D_3
#: WIK_D_3:605
msgctxt "text_id=21806 | speaker=kojika"
msgid "\"Huh?\""
msgstr "「あれ？」"

#. Occurrence WIK_D_3:611:21807: scene=WIK_D_3
#: WIK_D_3:611
msgctxt "text_id=21807 | speaker=unknown"
msgid "  I must have taken a wrong turn."
msgstr "　道を間違えたのだろうか。"

#. Occurrence WIK_D_3:616:21808: scene=WIK_D_3
#: WIK_D_3:616
msgctxt "text_id=21808 | speaker=unknown"
msgid "  I was back behind the Kuonji Estate."
msgstr "　わたしは久遠寺邸の裏側に出てしまった。"

#. Occurrence WIK_D_3:637:21809: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_D_3_0003; voice_prefix=B10; voice_category=5; scene=WIK_D_3
#: WIK_D_3:637
msgctxt "text_id=21809 | speaker=kojika"
msgid "\"That's weird... I'm sure I was heading down the hill.\""
msgstr "「おかしいな……ちゃんと下に向かってたわよね、わたし」"

#. Occurrence WIK_D_3:643:21810: scene=WIK_D_3
#: WIK_D_3:643
msgctxt "text_id=21810 | speaker=unknown"
msgid "  I thought out loud to try and ease my tension. "
msgstr "　不安をごまかすように独り言をもらす。"

#. Occurrence WIK_D_3:665:21811: scene=WIK_D_3
#: WIK_D_3:665
msgctxt "text_id=21811 | speaker=unknown"
msgid "  Wait, what was that?"
msgstr "　……と。"

#. Occurrence WIK_D_3:670:21812: scene=WIK_D_3
#: WIK_D_3:670
msgctxt "text_id=21812 | speaker=unknown"
msgid "  A shadow in the shade of the trees. It looked human."
msgstr "　木の陰に、何か、人間ほどの影があった。"

#. Occurrence WIK_D_3:705:21813: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_D_3_0004; voice_prefix=B10; voice_category=5; scene=WIK_D_3
#: WIK_D_3:705
msgctxt "text_id=21813 | speaker=kojika"
msgid "\"Is someone there?\""
msgstr "「誰……？」"

#. Occurrence WIK_D_3:711:21814: scene=WIK_D_3
#: WIK_D_3:711
msgctxt "text_id=21814 | speaker=unknown"
msgid "  My voice rang out."
msgstr "　声をかける。"

#. Occurrence WIK_D_3:717:21815: scene=WIK_D_3
#: WIK_D_3:717
msgctxt "text_id=21815 | speaker=unknown"
msgid "No response."
msgstr "返事はない。"

#. Occurrence WIK_D_3:723:21816: scene=WIK_D_3
#: WIK_D_3:723
msgctxt "text_id=21816 | speaker=unknown"
msgid "It was getting dark out."
msgstr "空は暗い。"

#. Occurrence WIK_D_3:729:21817: scene=WIK_D_3
#: WIK_D_3:729
msgctxt "text_id=21817 | speaker=unknown"
msgid "There wasn't even a breeze."
msgstr "風は吹かない。"

#. Occurrence WIK_D_3:734:21818: scene=WIK_D_3
#: WIK_D_3:734
msgctxt "text_id=21818 | speaker=unknown"
msgid "  Now I remembered why I wanted to go home."
msgstr "　帰ろうと思った本当の理由が頭をよぎる。"

#. Occurrence WIK_D_3:739:21819: scene=WIK_D_3
#: WIK_D_3:739
msgctxt "text_id=21819 | speaker=unknown"
msgid "  Yeah."
msgstr "　わたしは、そうだ。"

#. Occurrence WIK_D_3:744:21820: scene=WIK_D_3
#: WIK_D_3:744
msgctxt "text_id=21820 | speaker=unknown"
msgid "  I had a feeling that something bad would happening if I stayed―"
msgstr "　このまま洋館にいたら、何か、よくない事が起きそうだと感じたから―――"

#. Occurrence WIK_D_3:796:21821: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_D_3_0005; voice_prefix=B10; voice_category=5; scene=WIK_D_3
#: WIK_D_3:796
msgctxt "text_id=21821 | speaker=kojika"
msgid "\"Ah...\""
msgstr "「あ―――」"

#. Occurrence WIK_D_3:819:21822: scene=WIK_D_3
#: WIK_D_3:819
msgctxt "text_id=21822 | speaker=unknown"
msgid "  Something... impossible unfolded before my eyes."
msgstr "　ありえない光景を直視した。"

#. Occurrence WIK_D_3:824:21823: scene=WIK_D_3
#: WIK_D_3:824
msgctxt "text_id=21823 | speaker=unknown"
msgid "  I felt a sudden shock in my stomach."
msgstr "　お腹がひとりでにへこむような衝撃。"

#. Occurrence WIK_D_3:829:21824: scene=WIK_D_3
#: WIK_D_3:829
msgctxt "text_id=21824 | speaker=unknown"
msgid "  Reflexively, I brought my hand to my mouth. Too late."
msgstr "　反射的に口に手を当てたけれど、間に合わなかった。"

#. Occurrence WIK_D_3:885:21825: scene=WIK_D_3
#: WIK_D_3:885
msgctxt "text_id=21825 | speaker=unknown"
msgid "  I fell to the ground."
msgstr "　……地面に倒れる。"

#. Occurrence WIK_D_3:893:21826: scene=WIK_D_3
#: WIK_D_3:893
msgctxt "text_id=21826 | speaker=unknown"
msgid "  Warm blood flowed out of me, along with my strength."
msgstr "　全身の<血|ねつ>が、力が流れていく。"

#. Occurrence WIK_D_3:898:21827: scene=WIK_D_3
#: WIK_D_3:898
msgctxt "text_id=21827 | speaker=unknown"
msgid "  My hands helplessly reached to the sky for help."
msgstr "　助けを呼ぶ手も、むなしく空を切る。"

#. Occurrence WIK_D_3:903:21828: scene=WIK_D_3
#: WIK_D_3:903
msgctxt "text_id=21828 | speaker=unknown"
msgid "  It took the last of my strength, but I managed to catch sight of the shadow."
msgstr "　わたしは最後の力を振り絞って、目の前の人影を視界に収める。"

#. Occurrence WIK_D_3:934:21829: voice_id=X00_WIK_D_3_0000; voice_prefix=X00; voice_category=0; scene=WIK_D_3
#: WIK_D_3:934
msgctxt "text_id=21829 | speaker=unknown"
msgid "\"NOw, tHat WoN't dO. DoN'T fiNiSh ThIs BEfoRE WE'Ve EVen STARteD.\""
msgstr "『……ダメジャナイカ。始マル前カラ、終ワルナンテ』"

#. Occurrence WIK_D_3:982:21830: scene=WIK_D_3
#: WIK_D_3:982
msgctxt "text_id=21830 | speaker=unknown"
msgid "  Something axe-shaped came swinging down."
msgstr "　振り下ろされる鉈状のナニカ。"

#. Occurrence WIK_D_3:987:21831: scene=WIK_D_3
#: WIK_D_3:987
msgctxt "text_id=21831 | speaker=unknown"
msgid "  The last words I ever heard came from someone with the face of a monster."
msgstr "　鬼の<面|かお>をした誰かが、死にいくわたしにそう言った。"

#. Occurrence WIK_D_A:41:21832: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_D_A_0000; voice_prefix=B30; voice_category=9; scene=WIK_D_A
#: WIK_D_A:41
msgctxt "text_id=21832 | speaker=ritsuka"
msgid "\"Brrr. It feels colder here than it does outside.\""
msgstr "「さむっ。ここ、外より寒くない？」"

#. Occurrence WIK_D_A:52:21833: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_D_A_0000; voice_prefix=B10; voice_category=5; scene=WIK_D_A
#: WIK_D_A:52
msgctxt "text_id=21833 | speaker=kojika"
msgid "\"Yeah. Let's move to the drawing room.\""
msgstr "「ですね。居間に移動しましょう」"

#. Occurrence WIK_D_A:63:21834: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_D_A_0001; voice_prefix=B30; voice_category=9; scene=WIK_D_A
#: WIK_D_A:63
msgctxt "text_id=21834 | speaker=ritsuka"
msgid "\"I agree, but..."
msgstr "「賛成だけど…"

#. Occurrence WIK_D_A:76:21835: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_D_A_0002; voice_prefix=B30; voice_category=9; scene=WIK_D_A
#: WIK_D_A:76
msgctxt "text_id=21835 | speaker=ritsuka"
msgid "Ah well, Soujyuro's business is Soujyuro's business. I was going to wait for him, but there's probably no need.\""
msgstr "…ま、草十郎さんには草十郎さんの仕事があるんでしょうしね。待っててあげようと思ったけど、余計な気遣いかも」"

#. Occurrence WIK_D_A:102:21836: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_D_A_9000; voice_prefix=B10; voice_category=5; scene=WIK_D_A
#: WIK_D_A:102
msgctxt "text_id=21836 | speaker=kojika"
msgid "\"Sizuki was outside?\""
msgstr "「？　静希、外にいたんですか？」"

#. Occurrence WIK_D_A:114:21837: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_D_A_0004; voice_prefix=B30; voice_category=9; scene=WIK_D_A
#: WIK_D_A:114
msgctxt "text_id=21837 | speaker=ritsuka"
msgid "\"Yeah, cutting the grass near the road. He was going at it hard, like he's expecting royalty.\""
msgstr "「ええ。山道の方で草を刈っていたわ。すごい勢いで、ヘリポートでも造るかっていうぐらい」"

#. Occurrence WIK_D_A:140:21838: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_D_A_0001; voice_prefix=B10; voice_category=5; scene=WIK_D_A
#: WIK_D_A:140
msgctxt "text_id=21838 | speaker=kojika"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence WIK_D_A:145:21839: scene=WIK_D_A
#: WIK_D_A:145
msgctxt "text_id=21839 | speaker=unknown"
msgid "  I could never figure out what made that guy tick."
msgstr "　相変わらず、謎の行動力である。"

#. Occurrence WIK_D_A:150:21840: scene=WIK_D_A
#: WIK_D_A:150
msgctxt "text_id=21840 | speaker=unknown"
msgid "  It was too tiring to even try."
msgstr "　静希の奇行を追及しても疲れるだけだ。"

#. Occurrence WIK_D_A:155:21841: scene=WIK_D_A
#: WIK_D_A:155
msgctxt "text_id=21841 | speaker=unknown"
msgid "  We moved to the drawing room in search of warmth."
msgstr "　わたしたちは暖を求めて居間に移動した。"

#. Occurrence WIK_D_A:239:21842: scene=WIK_D_A
#: WIK_D_A:239
msgctxt "text_id=21842 | speaker=unknown"
msgid "  The rain showed no sign of stopping."
msgstr "　降り出した雨は、一向に止む気配を見せない。"

#. Occurrence WIK_D_A:244:21843: scene=WIK_D_A
#: WIK_D_A:244
msgctxt "text_id=21843 | speaker=unknown"
msgid "  In fact, it seemed to be getting stronger. The sun hadn't set yet, but it was already as dark as night outside."
msgstr "　むしろ勢いは増すばかりで、日没前だというのに外は夜並みの暗さになっていた。"

#. Occurrence WIK_D_A:264:21844: scene=WIK_D_A
#: WIK_D_A:264
msgctxt "text_id=21844 | speaker=unknown"
msgid "  The party had yet to begin."
msgstr "　パーティーはまだ始まらない。"

#. Occurrence WIK_D_A:269:21845: scene=WIK_D_A
#: WIK_D_A:269
msgctxt "text_id=21845 | speaker=unknown"
msgid "  Looking over the drawing room and the sunroom,"
msgstr "　居間とサンルームを見渡すと、"

#. Occurrence WIK_D_A:319:21846: scene=WIK_D_A
#: WIK_D_A:319
msgctxt "text_id=21846 | speaker=unknown"
msgid "  I saw everyone engaged in conversation."
msgstr "　これだけの人数が談話にふけっていた。"

#. Occurrence WIK_D_A:350:21847: scene=WIK_D_A
#: WIK_D_A:350
msgctxt "text_id=21847 | speaker=unknown"
msgid "  The card game Housuke brought had caused a stir in the drawing room."
msgstr "　居間では芳助が持ちこんできたカードゲームが思いの外盛り上がっている。"

#. Occurrence WIK_D_A:381:21848: scene=WIK_D_A
#: WIK_D_A:381
msgctxt "text_id=21848 | speaker=unknown"
msgid "  It was getting competitive, mainly."
msgstr "　おもに、いがみ合う方向で。"

#. Occurrence WIK_D_A:401:21849: scene=WIK_D_A
#: WIK_D_A:401
msgctxt "text_id=21849 | speaker=unknown"
msgid "  Apparently they were playing a fantasy-themed construction game from Germany, called Puppet Pass."
msgstr "　なんでも『<傀儡|かいらい>さんが<徹|トゥー>る』という、ドイツ製の、ファンタジー版ゼネコンシミュレーションゲームなのだそうだ。"

#. Occurrence WIK_D_A:406:21850: scene=WIK_D_A
#: WIK_D_A:406
msgctxt "text_id=21850 | speaker=unknown"
msgid "  It was basically the kind of game where players try to sabotage their opponents, so everyone was putting on forced smiles while they schemed against each other."
msgstr "　基本、いかに相手の足を引っ張るかというゲームなので、みな愛想笑いをしながら内心ではまったく笑えず、騙し討ちの機会を狙っている。"

#. Occurrence WIK_D_A:427:21851: scene=WIK_D_A
#: WIK_D_A:427
msgctxt "text_id=21851 | speaker=unknown"
msgid "  In contrast, the older people in the sunroom were drinking wine and watching the students intently."
msgstr "　一方、サンルームの大人組はワインなどを片手に、そんな学生たちの様子を眺めている。"

#. Occurrence WIK_D_A:453:21852: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_D_A_0000; voice_prefix=B40; voice_category=8; scene=WIK_D_A
#: WIK_D_A:453
msgctxt "text_id=21852 | speaker=eiri"
msgid "\"I'm surprised you're allowing people to roam around before the birthday party, Alice. Had a change of heart?\""
msgstr "「驚きましたね。誕生会が始まるまで、館内は自由に歩いていい決まりだとは。有珠さん、どんな心境の変化ですか？」"

#. Occurrence WIK_D_A:474:21853: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_D_A_0000; voice_prefix=A40; voice_category=2; scene=WIK_D_A
#: WIK_D_A:474
msgctxt "text_id=21853 | speaker=alice"
msgid "\"...Not particularly. I made walls where I didn't want people to go. It's only for today, so no one should get lost.\""
msgstr "「……別に。入られたら困るところは、そもそも壁に変えたから。今日だけの変更だけど、それなら遭難者もでないでしょう」"

#. Occurrence WIK_D_A:508:21854: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_D_A_0000; voice_prefix=B50; voice_category=6; scene=WIK_D_A
#: WIK_D_A:508
msgctxt "text_id=21854 | speaker=kinomi"
msgid "\"You made walls? From what?"
msgstr "「？　壁に変えたってなにをー？"

#. Occurrence WIK_D_A:521:21855: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_D_A_0001; voice_prefix=B50; voice_category=6; scene=WIK_D_A
#: WIK_D_A:521
msgctxt "text_id=21855 | speaker=kinomi"
msgid "And what do you mean about people getting lost? I know the mansion's big, but it's not that big.\""
msgstr "　それに遭難者とか、有珠ちゃんったら大げさなんだから～。そりゃでけえ屋敷だけど、迷子になんかなりませんよ？」"

#. Occurrence WIK_D_A:561:21856: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_D_A_0005; voice_prefix=B30; voice_category=9; scene=WIK_D_A
#: WIK_D_A:561
msgctxt "text_id=21856 | speaker=ritsuka"
msgid "\"Thank you for preparing guest rooms for us, by the way. I plan to leave this evening, but I appreciate the gesture!"
msgstr "「私たちの客室も用意してくれたのね。夜になったら帰る予定だけど、心遣いは助かっちゃうな～♪"

#. Occurrence WIK_D_A:572:21857: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_D_A_0006; voice_prefix=B30; voice_category=9; scene=WIK_D_A
#: WIK_D_A:572
msgctxt "text_id=21857 | speaker=ritsuka"
msgid "  Since we're here, Yui, why don't you go change?"
msgstr "　唯ちゃん、せっかくだし服、着替えてこない？"

#. Occurrence WIK_D_A:583:21858: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_D_A_0007; voice_prefix=B30; voice_category=9; scene=WIK_D_A
#: WIK_D_A:583
msgctxt "text_id=21858 | speaker=ritsuka"
msgid "  I'll lend you my qipao. Even a nun shouldn't attend a party in her habit.\""
msgstr "　お姉さんのチャイナドレスとか貸してあげるから。さすがにパーティー会場にシスターはどうかと思うし」"

#. Occurrence WIK_D_A:614:21859: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_D_A_0000; voice_prefix=B20; voice_category=10; scene=WIK_D_A
#: WIK_D_A:614
msgctxt "text_id=21859 | speaker=yuika"
msgid "\"I'm fine, thank you. Taking off my Mystic Code in a witch's house would be tantamount to suicide. Unlike you, I'm not here for fun.\""
msgstr "「結構です。魔女の家で礼装を脱ぐなど自殺行為。私は貴女のように、遊びに来ている訳ではありませんので」"

#. Occurrence WIK_D_A:639:21860: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_D_A_0001; voice_prefix=B40; voice_category=8; scene=WIK_D_A
#: WIK_D_A:639
msgctxt "text_id=21860 | speaker=eiri"
msgid "\"We *are* here for fun, actually. Even I came unarmed, but Sister Yuika insisted..."
msgstr "「いや、遊びに来てるんですけどねぇ。私ですら手ぶらで来ているのに、シスター唯架ときたら……。"

#. Occurrence WIK_D_A:651:21861: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_D_A_0002; voice_prefix=B40; voice_category=8; scene=WIK_D_A
#: WIK_D_A:651
msgctxt "text_id=21861 | speaker=eiri"
msgid "  Why do you always have to be so on edge, like you're ready to fight at a moment's notice?\""
msgstr "　どうしてこう、いつでも臨戦状態、よらば切る出刃包丁みたいな性格になったんだか」"

#. Occurrence WIK_D_A:665:21862: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_D_A_0001; voice_prefix=B20; voice_category=10; scene=WIK_D_A
#: WIK_D_A:665
msgctxt "text_id=21862 | speaker=yuika"
msgid "\"Someone has to be serious out of the three of us.\""
msgstr "「貴方たち二人が不真面目な分、私が引き締めなくてはいけないだけですっ」"

#. Occurrence WIK_D_A:734:21863: scene=WIK_D_A
#: WIK_D_A:734
msgctxt "text_id=21863 | speaker=unknown"
msgid "  The clock struck six."
msgstr "　時刻は六時になった。"

#. Occurrence WIK_D_A:739:21864: scene=WIK_D_A
#: WIK_D_A:739
msgctxt "text_id=21864 | speaker=unknown"
msgid "  Outside, it was completely dark."
msgstr "　外はもう完全に夜。"

#. Occurrence WIK_D_A:744:21865: scene=WIK_D_A
#: WIK_D_A:744
msgctxt "text_id=21865 | speaker=unknown"
msgid "  With Mr. Yamasiro and the church staff here, it would probably be safe to go home tonight, but the rain gave me pause."
msgstr "　山城先生や教会組がいるから、帰りの夜道は安全だろうけど、それでもこの雨脚には不安をあおられる。"

#. Occurrence WIK_D_A:801:21866: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_D_A_0001; voice_prefix=A40; voice_category=2; scene=WIK_D_A
#: WIK_D_A:801
msgctxt "text_id=21866 | speaker=alice"
msgid "\"...I think it's about time we got ready."
msgstr "「……そろそろ支度をするべきではないかしら。"

#. Occurrence WIK_D_A:814:21867: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_D_A_0002; voice_prefix=A40; voice_category=2; scene=WIK_D_A
#: WIK_D_A:814
msgctxt "text_id=21867 | speaker=alice"
msgid "  Has anyone seen Tokie?\""
msgstr "　トッキィーはどこに？」"

#. Occurrence WIK_D_A:820:21868: scene=WIK_D_A
#: WIK_D_A:820
msgctxt "text_id=21868 | speaker=unknown"
msgid "  Miss Kuonji declared the end to the card games with an unexpected question."
msgstr "　何度目かのカードゲームを終えて、ふと、久遠寺さんが妙なコトを口にした。"

#. Occurrence WIK_D_A:845:21869: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_D_A_0002; voice_prefix=B10; voice_category=5; scene=WIK_D_A
#: WIK_D_A:845
msgctxt "text_id=21869 | speaker=kojika"
msgid "\"Tokie? Who's Tokie?\""
msgstr "「トッキィー？　トッキィーって、誰？」"

#. Occurrence WIK_D_A:856:21870: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_D_A_0002; voice_prefix=B50; voice_category=6; scene=WIK_D_A
#: WIK_D_A:856
msgctxt "text_id=21870 | speaker=kinomi"
msgid "\"You mean Mr. Tokitsu? He's... huh?"
msgstr "「誰って、土桔の爺さんだろ。あれ……？"

#. Occurrence WIK_D_A:869:21871: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_D_A_0003; voice_prefix=B50; voice_category=6; scene=WIK_D_A
#: WIK_D_A:869
msgctxt "text_id=21871 | speaker=kinomi"
msgid "  Wait, Kojika, you haven't spoken to the old man yet?\""
msgstr "　もしかして金鹿、爺さんに挨拶してねえの？」"

#. Occurrence WIK_D_A:881:21872: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_D_A_0003; voice_prefix=B10; voice_category=5; scene=WIK_D_A
#: WIK_D_A:881
msgctxt "text_id=21872 | speaker=kojika"
msgid "\"What old man? Are there even more people coming? How many guests are going to be at this party, anyway?\""
msgstr "「知らない。まだこの家に人がいるの？　……いまさらだけど、全部で何人の予定なの、このパーティー」"

#. Occurrence WIK_D_A:908:21873: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_D_A_0003; voice_prefix=A40; voice_category=2; scene=WIK_D_A
#: WIK_D_A:908
msgctxt "text_id=21873 | speaker=alice"
msgid "\"Me, Aoko, Sizuki, Tsukiji, Kinomi, you, Tokie, and a few others. Thirteen in all."
msgstr "「わたし、青子、静希君、槻司君、木乃美君、久万梨さん、トッキィー、その他、で合計十三人。"

#. Occurrence WIK_D_A:914:21874: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_D_A_0004; voice_prefix=A40; voice_category=2; scene=WIK_D_A
#: WIK_D_A:914
msgctxt "text_id=21874 | speaker=alice"
msgid "  We haven't been able to get everyone in the same room yet, though.\""
msgstr "　さっきから一堂には揃わないみたいだけど」"

#. Occurrence WIK_D_A:926:21875: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_D_A_0004; voice_prefix=B10; voice_category=5; scene=WIK_D_A
#: WIK_D_A:926
msgctxt "text_id=21875 | speaker=kojika"
msgid "\"Thirteen...\""
msgstr "「十三人か」"

#. Occurrence WIK_D_A:931:21876: scene=WIK_D_A
#: WIK_D_A:931
msgctxt "text_id=21876 | speaker=unknown"
msgid "  One, two, three..."
msgstr "　ひと、ふた、みー、と数えてみる。"

#. Occurrence WIK_D_A:936:21877: scene=WIK_D_A
#: WIK_D_A:936
msgctxt "text_id=21877 | speaker=unknown"
msgid "  I counted the people in the room."
msgstr "　今までの情報から数えてみると……"

#. Occurrence WIK_SELECT_E:8:21878: scene=WIK_SELECT_E
#: WIK_SELECT_E:8
msgctxt "text_id=21878 | speaker=unknown"
msgid "-Decision E-"
msgstr "～選択肢Ｅ～"

#. Occurrence WIK_E:38:21879: scene=WIK_E
#: WIK_E:38
msgctxt "text_id=21879 | speaker=unknown"
msgid "  Just then..."
msgstr "　その時、"

#. Occurrence WIK_E:66:21880: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_E_0000; voice_prefix=B10; voice_category=5; scene=WIK_E
#: WIK_E:66
msgctxt "text_id=21880 | speaker=kojika"
msgid "\"...?\""
msgstr "「？」"

#. Occurrence WIK_E:112:21881: scene=WIK_E
#: WIK_E:112
msgctxt "text_id=21881 | speaker=unknown"
msgid "  I heard a strange sound outside, like something cutting through the wind."
msgstr "　外から異様な風切り音が聞こえてきた。"

#. Occurrence WIK_E:168:21882: scene=WIK_E
#: WIK_E:168
msgctxt "text_id=21882 | speaker=unknown"
msgid "  It grew into a lour roar that seemed to pound the very walls of the building."
msgstr "　洋館の壁をたたき付けるような爆音。"

#. Occurrence WIK_E:237:21883: scene=WIK_E
#: WIK_E:237
msgctxt "text_id=21883 | speaker=unknown"
msgid "  While we were all distracted by that..."
msgstr "　それに、誰もが意識を取られている中、"

#. Occurrence WIK_E:338:21884: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0000; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:338
msgctxt "text_id=21884 | speaker=liddell"
msgid "\"You've got some nerve to exclude me, you little nursery rhyme girl!"
msgstr "「このメルヘン女、アタシをのけ者とかザケてんの！？"

#. Occurrence WIK_E:344:21885: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0001; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:344
msgctxt "text_id=21885 | speaker=liddell"
msgid "  You call these dimwits to your birthday party, but not everybody's favorite English beauty, May Riddell Archelot?!\""
msgstr "　こんなボンクラどもはホイホイ呼んで、大本命かつ大人気、この超☆英国美少女であるリデル様を、なんで、アンタの誕生会に呼ばないのよっ！！！！」"

#. Occurrence WIK_E:350:21886: scene=WIK_E
#: WIK_E:350
msgctxt "text_id=21886 | speaker=unknown"
msgid "  The girl who arrived was several times louder than the storm."
msgstr "　外の雨より何倍もやかましい、"

#. Occurrence WIK_E:355:21887: scene=WIK_E
#: WIK_E:355
msgctxt "text_id=21887 | speaker=unknown"
msgid "  Maybe she *was* the storm."
msgstr "　嵐の化身みたいな女がやって来た。"

#. Occurrence WIK_E:396:21888: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_E_0000; voice_prefix=B70; voice_category=4; scene=WIK_E
#: WIK_E:396
msgctxt "text_id=21888 | speaker=tobimaru"
msgid "\"Riddell?! I thought you had other plans! How the hell did you even get here?!\""
msgstr "「リデル！？　おまえ、今日は<余所|よそ>でイベントだったじゃねえか。どうやってここに来やがった！？」"

#. Occurrence WIK_E:408:21889: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0002; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:408
msgctxt "text_id=21889 | speaker=liddell"
msgid "\"By helicopter, *obviously*."
msgstr "「ふん、決まってるじゃない。ヘリを飛ばして、よ。"

#. Occurrence WIK_E:414:21890: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0003; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:414
msgctxt "text_id=21890 | speaker=liddell"
msgid "  Remember this well, Tobimaru: Unlike you 'extras,' *nothing* is impossible for me. With a snap of my fingers, I can send missiles flying from the other side of the Earth.\""
msgstr "　覚えておきなさいトビマル。アンタたちみたいな端役と違って、アタシに不可能なんてないの。ちょっと一声かければ、地球の裏側からだってミサイル飛ばせるんだから」"

#. Occurrence WIK_E:425:21891: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_E_0001; voice_prefix=B70; voice_category=4; scene=WIK_E
#: WIK_E:425
msgctxt "text_id=21891 | speaker=tobimaru"
msgid "\"Well, don't do that.\""
msgstr "「いや、ミサイル飛ばされてもな」"

#. Occurrence WIK_E:459:21892: scene=WIK_E
#: WIK_E:459
msgctxt "text_id=21892 | speaker=unknown"
msgid "  Without so much as a glance in our direction, the girl walked right up to Miss Kuonji. She was dressed in pink from head to toe."
msgstr "　ピンク色で統一された女は、わたしや芳助には視線も投げず久遠寺さんへと歩み寄る。"

#. Occurrence WIK_E:464:21893: scene=WIK_E
#: WIK_E:464
msgctxt "text_id=21893 | speaker=unknown"
msgid "  It was more accurate to call it a strut than a walk. Her boots made an aggressive clacking sound as they struck the ground."
msgstr "　これみよがしにツカツカと響くブーツの音。挑発的な軍靴のようだ。"

#. Occurrence WIK_E:505:21894: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0004; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:505
msgctxt "text_id=21894 | speaker=liddell"
msgid "\"The Association's crème de la crème, adored by countless admirers, the first witch star in history to pass a hundred million fans has taken time out of her busy schedule to come here for you."
msgstr "「ほら、忙しくて引く手<数多|あまた>、史上初の億超えウィッチ、自他共に認める協会ナンバーワンのアイドルが、わざわざ専用機<飛|と>ばしてまで来てやったわよ？"

#. Occurrence WIK_E:518:21895: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0005; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:518
msgctxt "text_id=21895 | speaker=liddell"
msgid "  How does that feel? You must feel so *terrible*. But such a wonderful surprise beyond your wildest dreams, no doubt. Go ahead, weep with joy.\""
msgstr "　悔しい？　悔しいでしょ？　夢にも思わなかったぐらいサプライズでしょ？　いいわ、遠慮なく喜びなさい」"

#. Occurrence WIK_E:551:21896: scene=WIK_E
#: WIK_E:551
msgctxt "text_id=21896 | speaker=unknown"
msgid "  Wow..."
msgstr "　……すごい。"

#. Occurrence WIK_E:556:21897: scene=WIK_E
#: WIK_E:556
msgctxt "text_id=21897 | speaker=unknown"
msgid "  I never thought I'd see the day Miss Kuonji's stoicism replaced with pure irritation."
msgstr "　あの無表情な久遠寺さんが心底うんざりしている場面に出くわすとか、たしかに夢にも思わなかった。"

#. Occurrence WIK_E:583:21898: scene=WIK_E
#: WIK_E:583
msgctxt "text_id=21898 | speaker=unknown"
msgid "  The girl in pink nodded smugly down at Miss Kuonji, before finally noticing the rest of us."
msgstr "　ピンク女はげんなりする久遠寺さんを見下ろし、満足そうに頷いて、ようやく周囲を見渡した。"

#. Occurrence WIK_E:608:21899: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0006; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:608
msgctxt "text_id=21899 | speaker=liddell"
msgid "\"Atrocious. Who are these nobodies? I thought this was a birthday party! You have terrible taste in company. Are you really so sick in the head as to call your parents' enemies here?"
msgstr "「バッド。なにこのトンチキな面子。せっかくの誕生会だってのに、人選どうなってるの？　親の仇まで呼んじゃって、アンタ、そこまで病んじゃった？"

#. Occurrence WIK_E:620:21900: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0007; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:620
msgctxt "text_id=21900 | speaker=liddell"
msgid "  Hey you! Priest boy! Why don't you kiss our feet, strip, eat chicken, and then hang yourself?\""
msgstr "　ほら、そこの神父。とりあえず私たちにドゥゲザした<後|あと>、全裸になってチキン食べながら切腹してくれない？」"

#. Occurrence WIK_E:645:21901: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_E_0000; voice_prefix=B40; voice_category=8; scene=WIK_E
#: WIK_E:645
msgctxt "text_id=21901 | speaker=eiri"
msgid "\"Hahaha. You are the absolute last person I want to hear that from."
msgstr "「はははは。貴女にだけは言われたくありませんねぇ。"

#. Occurrence WIK_E:656:21902: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_E_0001; voice_prefix=B40; voice_category=8; scene=WIK_E
#: WIK_E:656
msgctxt "text_id=21902 | speaker=eiri"
msgid "  Perhaps you're the one who should be apologizing to Alice. When you steal something, it's only right to return it to the proper owner.\""
msgstr "　有珠さんに謝罪というのなら、まず貴女がするべきではないですか？　奪ったものは、きちんと本人に返さなければねぇ」"

#. Occurrence WIK_E:683:21903: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0008; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:683
msgctxt "text_id=21903 | speaker=liddell"
msgid "\"I'll have you know I paid her back in full, thank you!"
msgstr "「アタシはいいのよ、ちゃんと後でお金払ったし！"

#. Occurrence WIK_E:696:21904: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0009_0; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:696
msgctxt "text_id=21904 | speaker=liddell"
msgid "  Alice accepted the money, so it's mine now, fair and square!"
msgstr "　アリスだってキャッシュで受け取ったんだし、アレはもうアタシのモノっ！"

#. Occurrence WIK_E:710:21905: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0009_1; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:710
msgctxt "text_id=21905 | speaker=liddell"
msgid " Mind your own business!\""
msgstr "　外野がいちいち口はさんでんじゃないわよ」"

#. Occurrence WIK_E:721:21906: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_E_0002; voice_prefix=B40; voice_category=8; scene=WIK_E
#: WIK_E:721
msgctxt "text_id=21906 | speaker=eiri"
msgid "\"Oh my. Alice sold one of her precious Ploys?\""
msgstr "「なんと。有珠さんが、貴重なプロイを売却するとは」"

#. Occurrence WIK_E:746:21907: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0000; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:746
msgctxt "text_id=21907 | speaker=alice"
msgid "\"...Haah. I told her over and over that it wasn't up for sale, but she's a materialistic dog, so she never returned it.\""
msgstr "「……はあ。お金で解決できる問題じゃないと何度も言ったのだけど。この子、資本主義の犬だから。どう言っても返してくれないの」"

#. Occurrence WIK_E:758:21908: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0010; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:758
msgctxt "text_id=21908 | speaker=liddell"
msgid "\"Oh, sweet Alice, still playing coy."
msgstr "「またまた、照れ隠ししちゃって、この～♪"

#. Occurrence WIK_E:775:21909: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0011; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:775
msgctxt "text_id=21909 | speaker=liddell"
msgid "  That was just a savvy sales tactic! Everyone knows 'not for sale' is just code for increasing the price!\""
msgstr "　アンタも取引上手よね、“お金では譲れない”とか言って巧みにレートをあげていくんだから」"

#. Occurrence WIK_E:826:21910: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_E_0000; voice_prefix=B50; voice_category=6; scene=WIK_E
#: WIK_E:826
msgctxt "text_id=21910 | speaker=kinomi"
msgid "\"Hey, Your Highness. That girl's something else. I could swear I've seen her somewhere before. Is she a friend of Alice's?\""
msgstr "「……なあ殿下。あのすげえ女、どっかで見覚えあんだけど。有珠ちゃんの知り合い？」"

#. Occurrence WIK_E:838:21911: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_E_0002; voice_prefix=B70; voice_category=4; scene=WIK_E
#: WIK_E:838
msgctxt "text_id=21911 | speaker=tobimaru"
msgid "\"You're just imagining things. Forget about it. She's nothing but trouble. All harm, no good.\""
msgstr "「気のせいだ、忘れとけ。ありゃあ関わったら破滅する系の女だ。百害あって一利もねえ」"

#. Occurrence WIK_E:850:21912: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_E_0001; voice_prefix=B50; voice_category=6; scene=WIK_E
#: WIK_E:850
msgctxt "text_id=21912 | speaker=kinomi"
msgid "\"Y-Yeah, you're right. I probably couldn't handle her...\""
msgstr "「そ、そうですよね。オレもあそこまでキラキラしている人は、ちょっと……」"

#. Occurrence WIK_E:884:21913: scene=WIK_E
#: WIK_E:884
msgctxt "text_id=21913 | speaker=unknown"
msgid "  Despite whatever Tsukiji was saying, I knew the truth."
msgstr "　槻司はああ言っているけど、わたしは知っている。"

#. Occurrence WIK_E:904:21914: scene=WIK_E
#: WIK_E:904
msgctxt "text_id=21914 | speaker=unknown"
msgid "  Her name was Riddell."
msgstr "　彼女の名前はリデル。"

#. Occurrence WIK_E:909:21915: scene=WIK_E
#: WIK_E:909
msgctxt "text_id=21915 | speaker=unknown"
msgid "  She stayed at Tsukiji's house for a time."
msgstr "　一時期、槻司の家にホームステイしていた女の子だ。"

#. Occurrence WIK_E:914:21916: scene=WIK_E
#: WIK_E:914
msgctxt "text_id=21916 | speaker=unknown"
msgid "  Apparently, their fathers were business acquaintances."
msgstr "　槻司のお父さんとリデルのお父さん、企業間の付き合いでのコトらしい。"

#. Occurrence WIK_E:920:21917: scene=WIK_E
#: WIK_E:920
msgctxt "text_id=21917 | speaker=unknown"
msgid "  Well, I say she stayed with him, but the Tsukiji estate was so large, they were basically in different houses... Or at least, I hope that was the case."
msgstr "　……といっても槻司の屋敷は大きいので、一つ屋根の下、という話ではないだろうし、そう親しい仲ではない、と思いたい。"

#. Occurrence WIK_E:960:21918: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0001; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:960
msgctxt "text_id=21918 | speaker=alice"
msgid "\"I suppose I should ask―"
msgstr "「……一応、訊いてあげるけど。"

#. Occurrence WIK_E:966:21919: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0002; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:966
msgctxt "text_id=21919 | speaker=alice"
msgid "  Riddell. What are you doing here?\""
msgstr "　リデル。貴女、何をしにきたの？」"

#. Occurrence WIK_E:991:21920: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0012; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:991
msgctxt "text_id=21920 | speaker=liddell"
msgid "\"What do you mean, Alice? It's your birthday!"
msgstr "「なにって、アンタの誕生会でしょ？"

#. Occurrence WIK_E:997:21921: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0013; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:997
msgctxt "text_id=21921 | speaker=liddell"
msgid "  When I called Tobimaru's house, they told me 'the young master is attending a birthday party at Miss Kuonji's house.'"
msgstr "　トビマルの家に電話したら、“坊ちゃんなら久遠寺さんの家の誕生会にでかけた”とか言っちゃってさ。"

#. Occurrence WIK_E:1009:21922: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0014; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:1009
msgctxt "text_id=21922 | speaker=liddell"
msgid "  I couldn't let that slide, so I cancelled my concert at the last minute and flew here.\""
msgstr "　もうカーッと<脳髄|あたま>ハイになっちゃって、ライブキャンセルして飛んできたってワケ」"

#. Occurrence WIK_E:1030:21923: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0003; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:1030
msgctxt "text_id=21923 | speaker=alice"
msgid "\"...Do you even remember when my birthday is?\""
msgstr "「……貴女、わたしの誕生日、覚えている？」"

#. Occurrence WIK_E:1042:21924: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0015; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:1042
msgctxt "text_id=21924 | speaker=liddell"
msgid "\"Of course I do! I could forget mine, but I could never forget your―"
msgstr "「あったりまえじゃない！　自分のは忘れてもアンタのだけは忘れな………"

#. Occurrence WIK_E:1054:21925: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0016; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:1054
msgctxt "text_id=21925 | speaker=liddell"
msgid "  Wait a second. It's still autumn here, isn't it?\""
msgstr "　あれ？　まだ秋よね、この国？」"

#. Occurrence WIK_E:1094:21926: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0004; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:1094
msgctxt "text_id=21926 | speaker=alice"
msgid "\"Glad to see you haven't lost your mind completely."
msgstr "「良かった、脳は<ま|・><だ|・>正常ねリデル。"

#. Occurrence WIK_E:1106:21927: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0005; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:1106
msgctxt "text_id=21927 | speaker=alice"
msgid "  I hit your head a little too hard last time, remember?"
msgstr "　ほら。わたし、貴女の頭を叩きすぎたでしょう？"

#. Occurrence WIK_E:1112:21928: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0006; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:1112
msgctxt "text_id=21928 | speaker=alice"
msgid "  You had me ever so slightly worried that I might've caused you brain damage.\""
msgstr "　それで気の毒な結果を招いてしまったのかと、少しだけ心配してしまったわ」"

#. Occurrence WIK_E:1142:21929: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0017; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:1142
msgctxt "text_id=21929 | speaker=liddell"
msgid "\"Tobimaru, you liar! It's not Alice's birthday at all!\""
msgstr "「ちょっとトビマル！　なにウソ言ってんのよ、今日はアリスの誕生日じゃないっての！」"

#. Occurrence WIK_E:1180:21930: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_E_0003; voice_prefix=B70; voice_category=4; scene=WIK_E
#: WIK_E:1180
msgctxt "text_id=21930 | speaker=tobimaru"
msgid "\"Wait, the invitation definitely mentioned a birthday party at the Kuonji Estate.\""
msgstr "「いや、でも招待状には確かに、久遠寺邸で誕生会をするから、ぜひ参加するように、とだな」"

#. Occurrence WIK_E:1191:21931: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_E_0002; voice_prefix=B50; voice_category=6; scene=WIK_E
#: WIK_E:1191
msgctxt "text_id=21931 | speaker=kinomi"
msgid "\"Mine, too. Man, that invitation cost me a fortune. 2000 yen from the prez, can you believe it?"
msgstr "「そうそう。オレも会長から二千円と引き替えに招待状もらったよ？"

#. Occurrence WIK_E:1203:21932: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_E_0003; voice_prefix=B50; voice_category=6; scene=WIK_E
#: WIK_E:1203
msgctxt "text_id=21932 | speaker=kinomi"
msgid "Wait... I wasn't the only one who had to pay, was I?\""
msgstr "　ところで、料金とられたのオレだけじゃないよね？」"

#. Occurrence WIK_E:1244:21933: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_E_0003; voice_prefix=B40; voice_category=8; scene=WIK_E
#: WIK_E:1244
msgctxt "text_id=21933 | speaker=eiri"
msgid "\"Hahahaha. Some things are better left unsaid. Though, I do recall something about a birthday party at the Kuonji Estate.\""
msgstr "「はははは。知らない方が幸せな話ってどこにでもあるんですねぇ。ああ、私も久遠寺邸で誕生会をする、と覚えてきましたが」"

#. Occurrence WIK_E:1256:21934: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_E_0000; voice_prefix=B30; voice_category=9; scene=WIK_E
#: WIK_E:1256
msgctxt "text_id=21934 | speaker=ritsuka"
msgid "\"But it's not Allie's birthday, right?\""
msgstr "「でも、アッちゃんの誕生日じゃないのよね？」"

#. Occurrence WIK_E:1302:21935: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0007; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:1302
msgctxt "text_id=21935 | speaker=alice"
msgid "\"...Looks like there's been a misunderstanding."
msgstr "「……なぜそんな勘違いを生んだのかしら。"

#. Occurrence WIK_E:1314:21936: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0008; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:1314
msgctxt "text_id=21936 | speaker=alice"
msgid "  Yes, we are here for a birthday party, but not mine. It's Tokie's."
msgstr "　たしかに誕生会だけど、わたしじゃなくてトッキィーの誕生会よ。"

#. Occurrence WIK_E:1321:21937: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0009; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:1321
msgctxt "text_id=21937 | speaker=alice"
msgid "He wanted me to celebrate his birthday, so I simply made this mansion the venue.\""
msgstr "彼、わたしに祝ってほしいというから、この屋敷を会場にしただけなのだけど」"

#. Occurrence WIK_E:1384:21938: scene=WIK_E
#: WIK_E:1384
msgctxt "text_id=21938 | speaker=unknown"
msgid "  I reread the invitation."
msgstr "　わたしは招待状を見直した。"

#. Occurrence WIK_E:1389:21939: scene=WIK_E
#: WIK_E:1389
msgctxt "text_id=21939 | speaker=unknown"
msgid "\"You are cordially invited to a birthday party at the Kuonji Estate.\""
msgstr "“久遠寺邸で誕生会を開くから、ぜひ参加してほしい”"

#. Occurrence WIK_E:1394:21940: scene=WIK_E
#: WIK_E:1394
msgctxt "text_id=21940 | speaker=unknown"
msgid "  Now I see."
msgstr "　なるほど。"

#. Occurrence WIK_E:1399:21941: scene=WIK_E
#: WIK_E:1399
msgctxt "text_id=21941 | speaker=unknown"
msgid "  It didn't say anything about whose party it was."
msgstr "　たしかに、誰の誕生日とは書かれていない。"

#. Occurrence WIK_E:1457:21942: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_E_0000; voice_prefix=A10; voice_category=1; scene=WIK_E
#: WIK_E:1457
msgctxt "text_id=21942 | speaker=aoko"
msgid "\"Hey, everyone! What are we all getting so worked up about?"
msgstr "「やっほー。盛り上がっちゃって、何の騒ぎ？"

#. Occurrence WIK_E:1476:21943: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_E_0001; voice_prefix=A10; voice_category=1; scene=WIK_E
#: WIK_E:1476
msgctxt "text_id=21943 | speaker=aoko"
msgid "  ...Wait, Riddell Riddle?! What're you doing here?! What about your concert at Tokyo Bay?!"
msgstr "　……って、リデルリドル!?　アンタ、なんでここにいんのよ!?　ライブは!?　ねえ、いまＮＫホールでライブやってんじゃないの!?"

#. Occurrence WIK_E:1482:21944: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_E_0002; voice_prefix=A10; voice_category=1; scene=WIK_E
#: WIK_E:1482
msgctxt "text_id=21944 | speaker=aoko"
msgid "  I even set the VCR to record it!\""
msgstr "　私、ビデオ録画してるんですけど!?」"

#. Occurrence WIK_E:1497:21945: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0018; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:1497
msgctxt "text_id=21945 | speaker=liddell"
msgid "\"It's been sabotaged. The curry I had for lunch today was too spicy.\""
msgstr "「サボタージュ。ランチのカレーが<辛|から>かったから」"

#. Occurrence WIK_E:1529:21946: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_E_0003; voice_prefix=A10; voice_category=1; scene=WIK_E
#: WIK_E:1529
msgctxt "text_id=21946 | speaker=aoko"
msgid "\"What the hell kind of a reason is that?! Apologize to the god of music, right now! What about your fans?!\""
msgstr "「そ、そんなバカな理由でコンサートをドタキャンするヤツがいるかーーーー！　音楽の神に謝れ！　ファンをなんだと思ってんのよアンタは!?」"

#. Occurrence WIK_E:1555:21947: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0019; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:1555
msgctxt "text_id=21947 | speaker=liddell"
msgid "\"Ugh, it's always yap, yap, yap with you."
msgstr "「チッ、やっぱりコイツマジうざい。"

#. Occurrence WIK_E:1566:21948: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0020; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:1566
msgctxt "text_id=21948 | speaker=liddell"
msgid "  I don't care about music or any of that crap. Fans support me financially. That's it. I always end up feeling all emo after concerts, anyway. That's when the razor blades come out."
msgstr "　だいたいアタシ、音楽とかどうでもいいし。ファンなんてアタシに貢ぐだけの働きアリだし。ライブがハネた後はいつも空しくなってリスカするし。"

#. Occurrence WIK_E:1577:21949: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0021; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:1577
msgctxt "text_id=21949 | speaker=liddell"
msgid "  Even when I'm in the spotlight, no one really sees the real me.\""
msgstr "　スポットライトは当たっても、ホントのアタシは誰も見てくれないし」"

#. Occurrence WIK_E:1597:21950: scene=WIK_E
#: WIK_E:1597
msgctxt "text_id=21950 | speaker=unknown"
msgid "  Whoa. That took a dark turn."
msgstr "　ピンク女の空気が突如、一変する。"

#. Occurrence WIK_E:1646:21951: scene=WIK_E
#: WIK_E:1646
msgctxt "text_id=21951 | speaker=unknown"
msgid "  Chirping sweetly, a blue robin landed on the girl's shoulder."
msgstr "　ぶつぶつと呟く彼女の肩に、チチチ、と可愛らしく鳴く青い駒鳥が降り立った。"

#. Occurrence WIK_E:1669:21952: voice_id=BA0_WIK_E_0000; voice_prefix=BA0; voice_category=0; scene=WIK_E
#: WIK_E:1669
msgctxt "text_id=21952 | speaker=unknown"
msgid "\"Hahaha! Nothing ever rifle ranges with ye, May! Yer emotions are all over the place! You come into the room like ye own the place and then complain about no one seeing the real you! Come on! You're definitely more a mangle and wringer than a mage!\""
msgstr "『ハハハ、さすがリデルさん、感情のオンオフ激しいっスね！　ホントのアタシを見てー、とか、メルヘン全開で恥ずかしくないッスか？　恥ずかしくないんスよね。スゲー、やっぱリデルさん、魔術師よりアイドル向けッス！』"

#. Occurrence WIK_E:1696:21953: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0022; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:1696
msgctxt "text_id=21953 | speaker=liddell"
msgid "\"I know. Sorry. I'm just tired of never seeing my efforts pay off. I go around thinking I'm the best of the best, when really I'm the lowest of the low. Just a dumb clown."
msgstr "「そうよ、悪い。どうせアタシは報われない、自分を主役と勘違いしている乞食みたいな最下層の生き物なのよ。道化なのよ。"

#. Occurrence WIK_E:1709:21954: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_E_0023; voice_prefix=B80; voice_category=13; scene=WIK_E
#: WIK_E:1709
msgctxt "text_id=21954 | speaker=liddell"
msgid "I know already, so leave it alone, Robin. Or I'll chop you up and feed you to a dog later.\""
msgstr "わかってるからほっといてよロビン。後できっちり細切れにして、犬に食わせてあげるから」"

#. Occurrence WIK_E:1715:21955: scene=WIK_E
#: WIK_E:1715
msgctxt "text_id=21955 | speaker=unknown"
msgid "  Our newest guest... was talking to a bird."
msgstr "　……なんか、鳥と話しているし。"

#. Occurrence WIK_E:1720:21956: scene=WIK_E
#: WIK_E:1720
msgctxt "text_id=21956 | speaker=unknown"
msgid "  She really was one of those crazy pop stars you hear about in the tabloids."
msgstr "　本格的に電波だったんだ、あのアイドル。"

#. Occurrence WIK_E:1764:21957: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_E_0004; voice_prefix=B40; voice_category=8; scene=WIK_E
#: WIK_E:1764
msgctxt "text_id=21957 | speaker=eiri"
msgid "\"So it's Mr. Tokitsu's birthday party."
msgstr "「なるほど、<土桔|ときつ>さんの誕生会でしたか。"

#. Occurrence WIK_E:1770:21958: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_E_0005; voice_prefix=B40; voice_category=8; scene=WIK_E
#: WIK_E:1770
msgctxt "text_id=21958 | speaker=eiri"
msgid "  We wondered why we'd been invited, but now I understand."
msgstr "　私たちもどうして呼ばれたのか半信半疑でしたが、それなら合点がいきます。"

#. Occurrence WIK_E:1782:21959: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_E_0006; voice_prefix=B40; voice_category=8; scene=WIK_E
#: WIK_E:1782
msgctxt "text_id=21959 | speaker=eiri"
msgid "  Sister Yuika even suggested we come fully armed, because she thought it was a trap.\""
msgstr "　シスター唯架なんて、これは罠だから完全武装で行くべきです、とか言いだす始末ですし」"

#. Occurrence WIK_E:1809:21960: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_E_0000; voice_prefix=B20; voice_category=10; scene=WIK_E
#: WIK_E:1809
msgctxt "text_id=21960 | speaker=yuika"
msgid "\"...Ahem."
msgstr "「……コホン。"

#. Occurrence WIK_E:1821:21961: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_E_0001; voice_prefix=B20; voice_category=10; scene=WIK_E
#: WIK_E:1821
msgctxt "text_id=21961 | speaker=yuika"
msgid "  So, Miss Kuonji, where is the guest of honor?"
msgstr "　しかし久遠寺さん、肝心の土桔<由里彦|ゆりひこ>氏は何処に？"

#. Occurrence WIK_E:1827:21962: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_E_0002; voice_prefix=B20; voice_category=10; scene=WIK_E
#: WIK_E:1827
msgctxt "text_id=21962 | speaker=yuika"
msgid "  We haven't seen him yet.\""
msgstr "　私たちも挨拶をしていないのですが」"

#. Occurrence WIK_E:1852:21963: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0010; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:1852
msgctxt "text_id=21963 | speaker=alice"
msgid "\"Now that you mention it..."
msgstr "「そういえば、そうね。"

#. Occurrence WIK_E:1865:21964: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0011; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:1865
msgctxt "text_id=21964 | speaker=alice"
msgid "Aoko, have you seen Tokie?\""
msgstr "青子、トッキィーは？」"

#. Occurrence WIK_E:1891:21965: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_E_0004; voice_prefix=A10; voice_category=1; scene=WIK_E
#: WIK_E:1891
msgctxt "text_id=21965 | speaker=aoko"
msgid "\"He's not here? But he was in charge of the dinner arrangements! He told us we could take it easy, because he'd be arranging some top chefs.\""
msgstr "「え、居ないの？　夕食の手配、ぜんぶあの人が担当なのに。とびきりのシェフ団を手配するから、君たちはゆっくりしていなさいって自慢してたじゃない」"

#. Occurrence WIK_E:1917:21966: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_E_0004; voice_prefix=B70; voice_category=4; scene=WIK_E
#: WIK_E:1917
msgctxt "text_id=21966 | speaker=tobimaru"
msgid "\"That's a bit weird, isn't it? If that was the plan, the chefs would need to arrive by four at the latest in order to make it in time for dinner."
msgstr "「そりゃおかしいな。そういう段取りなら、シェフ団とやらは四時には到着していないと間に合わねえぞ。"

#. Occurrence WIK_E:1923:21967: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_E_0005; voice_prefix=B70; voice_category=4; scene=WIK_E
#: WIK_E:1923
msgctxt "text_id=21967 | speaker=tobimaru"
msgid "  Hasn't anybody seen Yurihiko?\""
msgstr "　誰か、土桔の爺さんを見なかったか？」"

#. Occurrence WIK_E:1963:21968: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_E_0000; voice_prefix=A50; voice_category=12; scene=WIK_E
#: WIK_E:1963
msgctxt "text_id=21968 | speaker=beo"
msgid "\"He was here until noon, but I haven't seen him since.\""
msgstr "「お昼まではここにいたけど、それ以降は見てないよ」"

#. Occurrence WIK_E:1988:21969: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_E_0001; voice_prefix=B30; voice_category=9; scene=WIK_E
#: WIK_E:1988
msgctxt "text_id=21969 | speaker=ritsuka"
msgid "\"I haven't seen him at all."
msgstr "「わたしは一度も見てないわ。"

#. Occurrence WIK_E:1988:21970: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_E_0001; voice_prefix=B30; voice_category=9; scene=WIK_E
#: WIK_E:1988
msgctxt "text_id=21970 | speaker=ritsuka"
msgid "  I stepped out a few times, but he wasn't outside, either.\""
msgstr "　何度か席を外したけど、その時も見かけなかったし」"

#. Occurrence WIK_E:2023:21971: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_E_0012; voice_prefix=A40; voice_category=2; scene=WIK_E
#: WIK_E:2023
msgctxt "text_id=21971 | speaker=alice"
msgid "\"It's been nearly five hours since noon. Has nobody seen him during that time?\""
msgstr "「……昼過ぎから今まで、五時間近く、誰もトッキィーを見ていないの……？」"

#. Occurrence WIK_E:2043:21972: scene=WIK_E
#: WIK_E:2043
msgctxt "text_id=21972 | speaker=unknown"
msgid "  The room was silent."
msgstr "　返事はない。"

#. Occurrence WIK_E:2048:21973: scene=WIK_E
#: WIK_E:2048
msgctxt "text_id=21973 | speaker=unknown"
msgid "  Everyone seemed to be waiting for someone else to say something. Even Housuke and the pink girl didn't have any banter to offer."
msgstr "　……全員、何か予感じみたものがあったのか、あのピンク女や芳助でさえ無駄口を叩かない。"

#. Occurrence WIK_E:2105:21974: voice_id=BA0_WIK_E_0001; voice_prefix=BA0; voice_category=0; scene=WIK_E
#: WIK_E:2105
msgctxt "text_id=21974 | speaker=unknown"
msgid "\"Hmm? Why'd the place go all Simon Said? Are we about to do some karaoke? Don't you know I'm so good I'd knock your rhythm n' blues right off? I'm a rock robin, you see? Just stick a microphone under my beak and...\""
msgstr "『ん、なんスかこの空気？　カラオケ？　カラオケはじまるッスか？　ジブン、テディボーイブルースとか得意ッスよ？　フリッキーにも歌つけてくれないっスかね？』"

#. Occurrence WIK_E:2111:21975: scene=WIK_E
#: WIK_E:2111
msgctxt "text_id=21975 | speaker=unknown"
msgid "  The only one making any noise was the robin on the table. It was bobbing its head in a strange way."
msgstr "　声を上げているのは、テーブルの上で不思議そうに首を傾げている駒鳥だけ。"

#. Occurrence WIK_E:2190:21976: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_E_0000; voice_prefix=A30; voice_category=3; scene=WIK_E
#: WIK_E:2190
msgctxt "text_id=21976 | speaker=soujuurou"
msgid "\"Ah, everyone's here. Is dinner ready?\""
msgstr "「ああ、みんな揃ってた。夕飯の支度は終わった？」"

#. Occurrence WIK_E:2196:21977: scene=WIK_E
#: WIK_E:2196
msgctxt "text_id=21977 | speaker=unknown"
msgid "  The voice cut through the tension."
msgstr "　……と。"

#. Occurrence WIK_E:2201:21978: scene=WIK_E
#: WIK_E:2201
msgctxt "text_id=21978 | speaker=unknown"
msgid "  A young man, looking calm and composed, had arrived."
msgstr "　そこへ、ひとり<安穏|あんのん>とした男がやってきた。"

#. Occurrence WIK_E:2263:21979: scene=WIK_E
#: WIK_E:2263
msgctxt "text_id=21979 | speaker=unknown"
msgid "  He must have picked up on the mood in the room... right?"
msgstr "　場の雰囲気を察したんだろう。"

#. Occurrence WIK_E:2292:21980: scene=WIK_E
#: WIK_E:2292
msgctxt "text_id=21980 | speaker=unknown"
msgid "  With his staple, unreadable grin, Sizuki looked around the room at everyone gathered."
msgstr "　静希は例の、なに考えているか分からない笑顔で集まった人々を見渡して、一言。"

#. Occurrence WIK_E:2319:21981: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_E_0001; voice_prefix=A30; voice_category=3; scene=WIK_E
#: WIK_E:2319
msgctxt "text_id=21981 | speaker=soujuurou"
msgid "\"By the way..."
msgstr "「ところで。"

#. Occurrence WIK_E:2325:21982: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_E_0002; voice_prefix=A30; voice_category=3; scene=WIK_E
#: WIK_E:2325
msgctxt "text_id=21982 | speaker=soujuurou"
msgid "  ...Mr. Tokitsu's dead in the attic. What should we do?\""
msgstr "　屋根裏で土桔さんが死んでいるんだけど、どうしようか？」"

#. Occurrence WIK_E:2331:21983: voice_id=X50_WIK_E_0000; voice_prefix=X50; voice_category=0; scene=WIK_E
#: WIK_E:2331
msgctxt "text_id=21983 | speaker=unknown"
msgid "\"Wh...\""
msgstr "「な―――」"

#. Occurrence WIK_E:2366:21984: voice_id=X50_WIK_E_0001; voice_prefix=X50; voice_category=0; scene=WIK_E
#: WIK_E:2366
msgctxt "text_id=21984 | speaker=unknown"
msgid "\"WHAT?!?!\""
msgstr "「「「「なんだってーーーーーーー！！！？」」」」"

#. Occurrence WIK_F_1:32:21985: scene=WIK_F_1
#: WIK_F_1:32
msgctxt "text_id=21985 | speaker=unknown"
msgid "  I feel like something terrible is about to happen."
msgstr "　これから陰惨な事件が始まるのだ、と思った。"

#. Occurrence WIK_F_2:32:21986: scene=WIK_F_2
#: WIK_F_2:32
msgctxt "text_id=21986 | speaker=unknown"
msgid "  I feel like something crazy is about to go down."
msgstr "　これからトンデモな事件が始まるな、と思った。"

#. Occurrence WIK_F_3:24:21987: scene=WIK_F_3
#: WIK_F_3:24
msgctxt "text_id=21987 | speaker=unknown"
msgid "  I know this isn't the time or place, but I'm glad that Tsukiji and I were paired together."
msgstr "　こんな状況で不謹慎ではあるけれど、槻司と組み分けされる流れになって良かった、と思った。"

#. Occurrence WIK_F_A:110:21988: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_F_A_0000; voice_prefix=A10; voice_category=1; scene=WIK_F_A
#: WIK_F_A:110
msgctxt "text_id=21988 | speaker=aoko"
msgid "\"Things sure have gotten out of hand.\""
msgstr "「しっかし、とんでもない<事態|こと>になったわね」"

#. Occurrence WIK_F_A:116:21989: scene=WIK_F_A
#: WIK_F_A:116
msgctxt "text_id=21989 | speaker=unknown"
msgid "  I silently agreed with Aozaki's muttering."
msgstr "　蒼崎の呟きに、わたしも無言で同意する。"

#. Occurrence WIK_F_A:144:21990: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_F_A_0000; voice_prefix=B70; voice_category=4; scene=WIK_F_A
#: WIK_F_A:144
msgctxt "text_id=21990 | speaker=tobimaru"
msgid "\"The weather's getting worse, too."
msgstr "「外の天気も荒れる一方だ。"

#. Occurrence WIK_F_A:150:21991: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_F_A_0001; voice_prefix=B70; voice_category=4; scene=WIK_F_A
#: WIK_F_A:150
msgctxt "text_id=21991 | speaker=tobimaru"
msgid "  I wouldn't be surprised if there's a mudslide tonight. It would be like getting stranded on an island.\""
msgstr "　こりゃあ土砂崩れの一つも起きてもおかしくねえ。そうなりゃ陸の孤島だな、ここは」"

#. Occurrence WIK_F_A:173:21992: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_F_A_0000; voice_prefix=B50; voice_category=6; scene=WIK_F_A
#: WIK_F_A:173
msgctxt "text_id=21992 | speaker=kinomi"
msgid "\"Seriously?! Sweet, sleepover! Oh, man. If Alice gets scared, can I be the one who comforts her?!\""
msgstr "「うそ、マジ！？　ラッキー、そうなればお泊まりじゃん！　なに、これフラグ？　怖がる有珠ちゃんを励ます係とか、オレ立候補しちゃっていいの！？」"

#. Occurrence WIK_F_A:185:21993: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_F_A_0001; voice_prefix=A10; voice_category=1; scene=WIK_F_A
#: WIK_F_A:185
msgctxt "text_id=21993 | speaker=aoko"
msgid "\"By all means, go ahead."
msgstr "「どうぞご自由に。"

#. Occurrence WIK_F_A:191:21994: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_F_A_0002; voice_prefix=A10; voice_category=1; scene=WIK_F_A
#: WIK_F_A:191
msgctxt "text_id=21994 | speaker=aoko"
msgid "  Another dead person's not going to change anything.\""
msgstr "　ま、ひとり死んでるんだから、もうひとり増えてもいいんじゃない？」"

#. Occurrence WIK_F_A:211:21995: scene=WIK_F_A
#: WIK_F_A:211
msgctxt "text_id=21995 | speaker=unknown"
msgid "  Aozaki, Tsukiji, Housuke, and I had grouped up."
msgstr "　わたしたちは、蒼崎、槻司、芳助の四人で固まっている。"

#. Occurrence WIK_F_A:216:21996: scene=WIK_F_A
#: WIK_F_A:216
msgctxt "text_id=21996 | speaker=unknown"
msgid "  For now, the four of us were Team School."
msgstr "　仮に、この集まりを学校組と呼ぼう。"

#. Occurrence WIK_F_A:257:21997: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_F_A_0000; voice_prefix=B20; voice_category=10; scene=WIK_F_A
#: WIK_F_A:257
msgctxt "text_id=21997 | speaker=yuika"
msgid "\"Father Eiri, about the body...\""
msgstr "「エイリ神父、先ほどの死体ですが―――」"

#. Occurrence WIK_F_A:268:21998: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_F_A_0000; voice_prefix=B40; voice_category=8; scene=WIK_F_A
#: WIK_F_A:268
msgctxt "text_id=21998 | speaker=eiri"
msgid "\"I know. This is clearly a homicide."
msgstr "「分かっています、明らかに殺人事件です。"

#. Occurrence WIK_F_A:274:21999: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_F_A_0001; voice_prefix=B40; voice_category=8; scene=WIK_F_A
#: WIK_F_A:274
msgctxt "text_id=21999 | speaker=eiri"
msgid "  But given our location, we can't exactly call the police right away.\""
msgstr "　ですが場所が場所ですからねぇ。おいそれと警察を呼ぶ訳にはいきません」"

#. Occurrence WIK_F_A:310:22000: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_F_A_0000; voice_prefix=B30; voice_category=9; scene=WIK_F_A
#: WIK_F_A:310
msgctxt "text_id=22000 | speaker=ritsuka"
msgid "\"Hehe... hehehehe... Six years... Six years it's been since Ako made fun of my 'sketchy' hobbies..."
msgstr "「……ふふ……ふふふふ…………きたわあ………辛気くさい趣味だってアコちゃんに罵られてはや六年……"

#. Occurrence WIK_F_A:331:22001: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_F_A_0001; voice_prefix=B30; voice_category=9; scene=WIK_F_A
#: WIK_F_A:331
msgctxt "text_id=22001 | speaker=ritsuka"
msgid "And now, we're here... a real murder scene! It's like a dream come true!\""
msgstr "夢にまで見た、殺人事件の現場がきたーーー！」"

#. Occurrence WIK_F_A:337:22002: scene=WIK_F_A
#: WIK_F_A:337
msgctxt "text_id=22002 | speaker=unknown"
msgid "  Team Church was made of those three."
msgstr "　教会組は三人で固まっている。"

#. Occurrence WIK_F_A:342:22003: scene=WIK_F_A
#: WIK_F_A:342
msgctxt "text_id=22003 | speaker=unknown"
msgid "  I'd expected them to be the most cohesive group, but that didn't seem to be the case."
msgstr "　鉄の結束力に見えて、若干、コンセンサスがとれていない模様。"

#. Occurrence WIK_F_A:389:22004: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_F_A_0000; voice_prefix=B80; voice_category=13; scene=WIK_F_A
#: WIK_F_A:389
msgctxt "text_id=22004 | speaker=liddell"
msgid "\"Hey, Soujyuro, where are the tea and scones?"
msgstr "「ちょっとソウジューロー、お茶もスコーンもでないの？"

#. Occurrence WIK_F_A:395:22005: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_F_A_0001; voice_prefix=B80; voice_category=13; scene=WIK_F_A
#: WIK_F_A:395
msgctxt "text_id=22005 | speaker=liddell"
msgid "  I'm a star, you know? I come all this way and not only do I get a slipshod welcome, but now there's been a murder! Have you people no sense of courtesy?!\""
msgstr "　せっかくスターが訪問してあげたのに、ろくな歓迎もなしいきなり殺人事件とか、アナタたち、礼儀ってもんがなってないんじゃない？」"

#. Occurrence WIK_F_A:404:22006: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_F_A_0000; voice_prefix=A30; voice_category=3; scene=WIK_F_A
#: WIK_F_A:404
msgctxt "text_id=22006 | speaker=soujuurou"
msgid "\"Well, hold on."
msgstr "「いや、しかし待ってほしい。"

#. Occurrence WIK_F_A:410:22007: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_F_A_0001; voice_prefix=A30; voice_category=3; scene=WIK_F_A
#: WIK_F_A:410
msgctxt "text_id=22007 | speaker=soujuurou"
msgid "  Demanding tea and scones after someone's died is worse than bad manners.\""
msgstr "　人がひとり死んでいるのにお茶とお菓子を要求するのは、礼儀以前の問題ではないだろうか」"

#. Occurrence WIK_F_A:456:22008: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_F_A_0002; voice_prefix=B80; voice_category=13; scene=WIK_F_A
#: WIK_F_A:456
msgctxt "text_id=22008 | speaker=liddell"
msgid "\"And what is *that* supposed to mean? Is the dog barking orders at his master? Don't pretend you're the one with common sense here.\""
msgstr "「あぁ？　なに、番犬のクセにご主人様に意見しようっての？　どうしてこう、ここぞという時に常識人ぶんのよアンタは！」"

#. Occurrence WIK_F_A:492:22009: scene=WIK_F_A
#: WIK_F_A:492
msgctxt "text_id=22009 | speaker=unknown"
msgid "  The girl in pink grabbed Sizuki by the collar shook him viciously."
msgstr "　静希の首輪を掴んで、ガクガクと揺さぶるピンク女。"

#. Occurrence WIK_F_A:498:22010: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_F_A_0002; voice_prefix=A30; voice_category=3; scene=WIK_F_A
#: WIK_F_A:498
msgctxt "text_id=22010 | speaker=soujuurou"
msgid "\"Whoa... I see two... Aozakis...\""
msgstr "「蒼崎……蒼崎が、二人……」"

#. Occurrence WIK_F_A:503:22011: scene=WIK_F_A
#: WIK_F_A:503
msgctxt "text_id=22011 | speaker=unknown"
msgid "  Sizuki's eyes began to glaze over, probably because her fingers were digging into his carotid artery."
msgstr "　頸動脈に食い込んでいるのか、静希の目はうつろである。"

#. Occurrence WIK_F_A:567:22012: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_F_A_0000; voice_prefix=A50; voice_category=12; scene=WIK_F_A
#: WIK_F_A:567
msgctxt "text_id=22012 | speaker=beo"
msgid "\"Heh-heh. Hey, pinkie. You don't look very tasty for a human, but hands off Soujyuro before I bite your head off.\""
msgstr "「ふふふ。そこのピンク。不味そうな人間だけど、それ以上草十郎さんに触れたら頭から丸かじるぞ☆」"

#. Occurrence WIK_F_A:598:22013: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_F_A_0003_0; voice_prefix=B80; voice_category=13; scene=WIK_F_A
#: WIK_F_A:598
msgctxt "text_id=22013 | speaker=liddell"
msgid "\"Oh, really? Why don't you try it?"
msgstr "「はあ？　やれるもんならやってみればあ？"

#. Occurrence WIK_F_A:611:22014: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_F_A_0003_1; voice_prefix=B80; voice_category=13; scene=WIK_F_A
#: WIK_F_A:611
msgctxt "text_id=22014 | speaker=liddell"
msgid " I know your weakness. Want me to beat you again and shrink you down to the size of a mouse?\""
msgstr "　ふん、アンタの弱点なんて分かってんだから。また返り討ちにされて、ネズミ<大|だい>の大きさにしてほしいワケ？」"

#. Occurrence WIK_F_A:648:22015: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_F_A_0001; voice_prefix=A50; voice_category=12; scene=WIK_F_A
#: WIK_F_A:648
msgctxt "text_id=22015 | speaker=beo"
msgid "\"Oh, so you think you know me, do you? Just shows how blind you really are."
msgstr "「へえ。アレがこっちの本気だと思っていたなんて、<目|め><利|き>きが悪いにもホドがある。"

#. Occurrence WIK_F_A:659:22016: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_F_A_0002; voice_prefix=A50; voice_category=12; scene=WIK_F_A
#: WIK_F_A:659
msgctxt "text_id=22016 | speaker=beo"
msgid "  Don't forget, your ancestors were a bunch of soot witches born in the Industrial Revolution. I don't know how you've done it, but you're even dumber.\""
msgstr "　しょせんは産業革命の陰でポッと発生した<煤|すす>の魔女の末裔ってコト？　ほーんと、格落ち品らしい、スカスカの脳味噌だよねー」"

#. Occurrence WIK_F_A:704:22017: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_F_A_0004_0; voice_prefix=B80; voice_category=13; scene=WIK_F_A
#: WIK_F_A:704
msgctxt "text_id=22017 | speaker=liddell"
msgid "\"All right, time to die. I'm happy to add another two mangy mutts to the body count right now."
msgstr "「よし死んで。犬同士仲良く二匹、これ以上ないっていうぐらい愉快に死んで。"

#. Occurrence WIK_F_A:717:22018: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_F_A_0004_1; voice_prefix=B80; voice_category=13; scene=WIK_F_A
#: WIK_F_A:717
msgctxt "text_id=22018 | speaker=liddell"
msgid "There's already one dead guy. What's another six or so corpses on top of that?\""
msgstr "もうひとり死んでるんだし、あと六人ぐらい追加されても構わないわよねぇ？」"

#. Occurrence WIK_F_A:757:22019: scene=WIK_F_A
#: WIK_F_A:757
msgctxt "text_id=22019 | speaker=unknown"
msgid "  Meanwhile, the disagreeable Team Mansion was centered around Miss Kuonji, who was sitting on the sofa."
msgstr "　一方、ソファーに座った久遠寺さんを中心に、とにかく仲の悪いグループを洋館組と呼ぶ。"

#. Occurrence WIK_F_A:762:22020: scene=WIK_F_A
#: WIK_F_A:762
msgctxt "text_id=22020 | speaker=unknown"
msgid "  The pink girl, Beo, and Sizuki were bickering bitterly about something or other."
msgstr "　ピンク女、ベオ、静希は何やら揉めているけど、"

#. Occurrence WIK_F_A:768:22021: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_F_A_0000; voice_prefix=A40; voice_category=2; scene=WIK_F_A
#: WIK_F_A:768
msgctxt "text_id=22021 | speaker=alice"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence WIK_F_A:773:22022: scene=WIK_F_A
#: WIK_F_A:773
msgctxt "text_id=22022 | speaker=unknown"
msgid "  Miss Kuonji, the mistress of the house, remained silent, her expression pensive."
msgstr "　屋敷の主人である久遠寺さんは、さっきから思案顔で一言も発していなかった。"

#. Occurrence WIK_F_A:778:22023: scene=WIK_F_A
#: WIK_F_A:778
msgctxt "text_id=22023 | speaker=unknown"
msgid "  That blue robin had gone off somewhere again."
msgstr "　また、あの青い駒鳥の姿も消えていた。"

#. Occurrence WIK_F_A:823:22024: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_F_A_0002; voice_prefix=B30; voice_category=9; scene=WIK_F_A
#: WIK_F_A:823
msgctxt "text_id=22024 | speaker=ritsuka"
msgid "\"Okay, everyone! Enough of that."
msgstr "「はいはい、みんなそこまで！"

#. Occurrence WIK_F_A:831:22025: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_F_A_0003_0; voice_prefix=B30; voice_category=9; scene=WIK_F_A
#: WIK_F_A:831
msgctxt "text_id=22025 | speaker=ritsuka"
msgid "  We're in a wonderful―"
msgstr "　この素敵な展開…"

#. Occurrence WIK_F_A:845:22026: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_F_A_0003_1; voice_prefix=B30; voice_category=9; scene=WIK_F_A
#: WIK_F_A:845
msgctxt "text_id=22026 | speaker=ritsuka"
msgid "Ahem."
msgstr "…ゴホン、"

#. Occurrence WIK_F_A:858:22027: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_F_A_0003_2; voice_prefix=B30; voice_category=9; scene=WIK_F_A
#: WIK_F_A:858
msgctxt "text_id=22027 | speaker=ritsuka"
msgid "We're in a tight situation. This is no time to fight among ourselves!"
msgstr "異常な事態を前にして、ケンカしている場合じゃありませんっ！"

#. Occurrence WIK_F_A:870:22028: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_F_A_0004; voice_prefix=B30; voice_category=9; scene=WIK_F_A
#: WIK_F_A:870
msgctxt "text_id=22028 | speaker=ritsuka"
msgid "  Mr. Yurihiko Tokitsu has died; the mansion's telephone line is out."
msgstr "　状況は火を見るより明らかです。土桔由里彦氏が死亡していた事と、屋敷の電話線が消失していた事。"

#. Occurrence WIK_F_A:882:22029: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_F_A_0005; voice_prefix=B30; voice_category=9; scene=WIK_F_A
#: WIK_F_A:882
msgctxt "text_id=22029 | speaker=ritsuka"
msgid "  These two things can't be a coincidence."
msgstr "　この二つの事件は偶然ではありません。"

#. Occurrence WIK_F_A:894:22030: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_F_A_0006; voice_prefix=B30; voice_category=9; scene=WIK_F_A
#: WIK_F_A:894
msgctxt "text_id=22030 | speaker=ritsuka"
msgid "  As such, it's logical to conclude that we are dealing with―\""
msgstr "　これは連続した、ある人物によって引き起こされた事件と見るほうが論理的です。即ち―――」"

#. Occurrence WIK_F_A:929:22031: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_F_A_0000; voice_prefix=B10; voice_category=5; scene=WIK_F_A
#: WIK_F_A:929
msgctxt "text_id=22031 | speaker=kojika"
msgid "\"Murder... So you're saying whoever killed Mr. Tokitsu made sure that we couldn't contact the police?\""
msgstr "「殺人事件……土桔氏を殺害した何者かは、警察に連絡させないために電話を使用不能にした、という事ですか？」"

#. Occurrence WIK_F_A:941:22032: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_F_A_0007; voice_prefix=B30; voice_category=9; scene=WIK_F_A
#: WIK_F_A:941
msgctxt "text_id=22032 | speaker=ritsuka"
msgid "\"Yes! Precisely, Kojika!"
msgstr "「そう！　その通りよ金鹿ちゃん！"

#. Occurrence WIK_F_A:948:22033: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_F_A_0008_0; voice_prefix=B30; voice_category=9; scene=WIK_F_A
#: WIK_F_A:948
msgctxt "text_id=22033 | speaker=ritsuka"
msgid "  This is a perfect murder case! And the murderer is someone here!"
msgstr "　これはもう立派な殺人事件です！　そして犯人はこの中にいる！"

#. Occurrence WIK_F_A:962:22034: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_F_A_0008_1; voice_prefix=B30; voice_category=9; scene=WIK_F_A
#: WIK_F_A:962
msgctxt "text_id=22034 | speaker=ritsuka"
msgid "Or I hope so, anyway!\""
msgstr "　といいなー！」"

#. Occurrence WIK_F_A:989:22035: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_F_A_0001; voice_prefix=B50; voice_category=6; scene=WIK_F_A
#: WIK_F_A:989
msgctxt "text_id=22035 | speaker=kinomi"
msgid "\"What?! That's what's going down?!\""
msgstr "「ええ！？　これ、そういうイベントだったの！？」"

#. Occurrence WIK_F_A:1014:22036: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_F_A_0009; voice_prefix=B30; voice_category=9; scene=WIK_F_A
#: WIK_F_A:1014
msgctxt "text_id=22036 | speaker=ritsuka"
msgid "\"Yes, Kinomi! That is exactly what's going down!"
msgstr "「そうよ木乃美くん、これはそういうイベントなの！"

#. Occurrence WIK_F_A:1039:22037: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_F_A_0010; voice_prefix=B30; voice_category=9; scene=WIK_F_A
#: WIK_F_A:1039
msgctxt "text_id=22037 | speaker=ritsuka"
msgid "  Drop your guard, and from behind... BAM! DEAD!"
msgstr "　油断していると後ろからバッサリなんだから！"

#. Occurrence WIK_F_A:1050:22038: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_F_A_0011; voice_prefix=B30; voice_category=9; scene=WIK_F_A
#: WIK_F_A:1050
msgctxt "text_id=22038 | speaker=ritsuka"
msgid "  Right, who wants to give their theory first?!\""
msgstr "　さあ、誰から<持論|じろん>を<披露|ひろう>しましょうか！」"

#. Occurrence WIK_F_A:1091:22039: scene=WIK_F_A
#: WIK_F_A:1091
msgctxt "text_id=22039 | speaker=unknown"
msgid "  I've never seen Ritsuka so excited."
msgstr "　あれほど活き活きとした律架さんを見たのは初めてだ。"

#. Occurrence WIK_F_A:1096:22040: scene=WIK_F_A
#: WIK_F_A:1096
msgctxt "text_id=22040 | speaker=unknown"
msgid "  Maybe this is how she reacts to fear."
msgstr "　恐怖の反動で精神が高揚しているのかもしれない。"

#. Occurrence WIK_F_A:1135:22041: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_F_A_0001; voice_prefix=B20; voice_category=10; scene=WIK_F_A
#: WIK_F_A:1135
msgctxt "text_id=22041 | speaker=yuika"
msgid "\"Ritsuka.\""
msgstr "「律架」"

#. Occurrence WIK_F_A:1174:22042: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_F_A_0012; voice_prefix=B30; voice_category=9; scene=WIK_F_A
#: WIK_F_A:1174
msgctxt "text_id=22042 | speaker=ritsuka"
msgid "\"Ack!\""
msgstr "「ぐっふぅ……！？」"

#. Occurrence WIK_F_A:1264:22043: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_F_A_0002; voice_prefix=B40; voice_category=8; scene=WIK_F_A
#: WIK_F_A:1264
msgctxt "text_id=22043 | speaker=eiri"
msgid "\"Allow me to apologize for Ritsuka's unsettling remarks."
msgstr "「申し訳ありません。うちの者が不穏な発言をいたしました。"

#. Occurrence WIK_F_A:1275:22044: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_F_A_0003; voice_prefix=B40; voice_category=8; scene=WIK_F_A
#: WIK_F_A:1275
msgctxt "text_id=22044 | speaker=eiri"
msgid "  However, despite her enthusiasm, she has a point."
msgstr "　しかし、まったくの狂言でない事も理解してください。"

#. Occurrence WIK_F_A:1275:22045: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_F_A_0003; voice_prefix=B40; voice_category=8; scene=WIK_F_A
#: WIK_F_A:1275
msgctxt "text_id=22045 | speaker=eiri"
msgid "  While we can't be certain Mr. Tokitsu's killer is one of us, we do need to make sense of the situation.\""
msgstr "　土桔氏を殺害した犯人がこの中にいる、というのは先走りすぎですが、状況の整理は必要でしょう」"

#. Occurrence WIK_F_A:1312:22046: scene=WIK_F_A
#: WIK_F_A:1312
msgctxt "text_id=22046 | speaker=unknown"
msgid "  That sounded reasonable enough."
msgstr "　反論する理由はない。"

#. Occurrence WIK_F_A:1317:22047: scene=WIK_F_A
#: WIK_F_A:1317
msgctxt "text_id=22047 | speaker=unknown"
msgid "  Father Eiri kicked off the proceedings."
msgstr "　詠梨神父の仕切りで状況整理が始まった。"

#. Occurrence WIK_F_A:1342:22048: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_F_A_0003; voice_prefix=A10; voice_category=1; scene=WIK_F_A
#: WIK_F_A:1342
msgctxt "text_id=22048 | speaker=aoko"
msgid "\"Let's start with the scene in the attic."
msgstr "「まず屋根裏の状況から。"

#. Occurrence WIK_F_A:1348:22049: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_F_A_0004; voice_prefix=A10; voice_category=1; scene=WIK_F_A
#: WIK_F_A:1348
msgctxt "text_id=22049 | speaker=aoko"
msgid "  As the attic isn't locked, anyone could have entered at any time."
msgstr "　あの部屋は鍵がなくて、誰でも入れる状況だった。"

#. Occurrence WIK_F_A:1360:22050: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_F_A_0005; voice_prefix=A10; voice_category=1; scene=WIK_F_A
#: WIK_F_A:1360
msgctxt "text_id=22050 | speaker=aoko"
msgid "  Did anyone here see Mr. Tokitsu heading for the attic or did he say anything about going there?\""
msgstr "　この中で土桔の爺さんが屋根裏に向かうところを見た人、あるいは相談された人はいる？」"

#. Occurrence WIK_F_A:1403:22051: scene=WIK_F_A
#: WIK_F_A:1403
msgctxt "text_id=22051 | speaker=unknown"
msgid "  No takers."
msgstr "　<挙手|きょしゅ>はない。"

#. Occurrence WIK_F_A:1408:22052: scene=WIK_F_A
#: WIK_F_A:1408
msgctxt "text_id=22052 | speaker=unknown"
msgid "  Either Mr. Tokitsu entered the attic by himself without telling anyone, or he was taken there by the killer."
msgstr "　土桔氏はひとりで、誰にも内緒で屋根裏部屋に入ったか、あるいは犯人に連れこまれたのだ。"

#. Occurrence WIK_F_A:1455:22053: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_F_A_0004; voice_prefix=B40; voice_category=8; scene=WIK_F_A
#: WIK_F_A:1455
msgctxt "text_id=22053 | speaker=eiri"
msgid "\"Who saw Mr. Tokitsu last?"
msgstr "「土桔氏を最後に見たのは誰でしょう？"

#. Occurrence WIK_F_A:1467:22054: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_F_A_0005; voice_prefix=B40; voice_category=8; scene=WIK_F_A
#: WIK_F_A:1467
msgctxt "text_id=22054 | speaker=eiri"
msgid "  The three of us entered the mansion this evening, but we didn't see him.\""
msgstr "　私たち三人は夕方から入館しましたが、その時点で土桔氏の姿を見てはいません」"

#. Occurrence WIK_F_A:1476:22055: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_F_A_0002; voice_prefix=B50; voice_category=6; scene=WIK_F_A
#: WIK_F_A:1476
msgctxt "text_id=22055 | speaker=kinomi"
msgid "\"We've been here since this morning; he was with us then."
msgstr "「オレたちは午前中から居たけど、朝は一緒だったぜ？"

#. Occurrence WIK_F_A:1487:22056: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_F_A_0003; voice_prefix=B50; voice_category=6; scene=WIK_F_A
#: WIK_F_A:1487
msgctxt "text_id=22056 | speaker=kinomi"
msgid "  We fought for a seat next to Alice."
msgstr "　有珠ちゃんの隣を奪い合ったから、これは間違いない。"

#. Occurrence WIK_F_A:1498:22057: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_F_A_0004; voice_prefix=B50; voice_category=6; scene=WIK_F_A
#: WIK_F_A:1498
msgctxt "text_id=22057 | speaker=kinomi"
msgid "  Then... Oh, yeah. I think he looked at the clock, said something about it being 'time,' then left the drawing room.\""
msgstr "　でも……そうだ、あの爺さん、時計を見て“時間だ”とか呟いて、居間から出ていったんだっけ」"

#. Occurrence WIK_F_A:1518:22058: scene=WIK_F_A
#: WIK_F_A:1518
msgctxt "text_id=22058 | speaker=unknown"
msgid "  Despite appearances, Housuke had a pretty good memory..."
msgstr "　芳助はああ見えて、記憶力はいい。"

#. Occurrence WIK_F_A:1523:22059: scene=WIK_F_A
#: WIK_F_A:1523
msgctxt "text_id=22059 | speaker=unknown"
msgid "  ...when it came to anything besides studying, that is."
msgstr "　勉強以外の、おもにどうでもいい方面で。"

#. Occurrence WIK_F_A:1528:22060: scene=WIK_F_A
#: WIK_F_A:1528
msgctxt "text_id=22060 | speaker=unknown"
msgid "  In the end, Housuke's statement was the last eyewitness account we had of Mr. Tokitsu."
msgstr "　結局、芳助の目撃談が土桔氏を見た最後の証言になった。"

#. Occurrence WIK_F_A:1556:22061: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_F_A_0006; voice_prefix=B40; voice_category=8; scene=WIK_F_A
#: WIK_F_A:1556
msgctxt "text_id=22061 | speaker=eiri"
msgid "\"That means Mr. Tokitsu disappeared sometime after noon. This is troubling. None of us have a watertight alibi.\""
msgstr "「となると……土桔氏が消えたのは正午過ぎから、ですか。まいりましたね。これでは、全員に等しくアリバイがない」"

#. Occurrence WIK_F_A:1591:22062: scene=WIK_F_A
#: WIK_F_A:1591
msgctxt "text_id=22062 | speaker=unknown"
msgid "  Right. The time between his disappearance and discovery had been too long."
msgstr "　そう。不在から発見までの時間帯が長すぎるのだ。"

#. Occurrence WIK_F_A:1596:22063: scene=WIK_F_A
#: WIK_F_A:1596
msgctxt "text_id=22063 | speaker=unknown"
msgid "  Even though I arrived in the afternoon, I'd been to the bathroom a few times. The same went for Aozaki and Mr. Yamasiro."
msgstr "　午後に来たわたしや蒼崎、山城先生でさえ、何度かトイレやら休憩やらで席を立っている。"

#. Occurrence WIK_F_A:1601:22064: scene=WIK_F_A
#: WIK_F_A:1601
msgctxt "text_id=22064 | speaker=unknown"
msgid "  Everyone had been alone for at least five to ten minutes at some point."
msgstr "　五分から十分程度なら、ひとりでいる時間が誰にでもあったという事だ。"

#. Occurrence WIK_F_A:1606:22065: scene=WIK_F_A
#: WIK_F_A:1606
msgctxt "text_id=22065 | speaker=unknown"
msgid "  The only exception, who had stayed here with someone the entire time, was Miss Kuonji."
msgstr "　ずっと誰かといた―――ずっとこの場所にいたのは、久遠寺さんだけである。"

#. Occurrence WIK_F_A:1642:22066: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_F_A_0006; voice_prefix=A10; voice_category=1; scene=WIK_F_A
#: WIK_F_A:1642
msgctxt "text_id=22066 | speaker=aoko"
msgid "\"Alice, you only got up once to greet Eiri and the others. That's a pretty strong alibi.\""
msgstr "「有珠、詠梨たちを迎えに行く時しか動いてないものね。鉄壁のアリバイだわ」"

#. Occurrence WIK_F_A:1685:22067: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_F_A_0007; voice_prefix=B40; voice_category=8; scene=WIK_F_A
#: WIK_F_A:1685
msgctxt "text_id=22067 | speaker=eiri"
msgid "\"I thought examining everyone's statements would've yielded some insight into his absence...but it appears not. We're all suspects."
msgstr "「細かく証言をすりあわせていけばより確かな不在時間がでてくるでしょうが、あまり効果はないでしょうね。誰もが犯人に該当しすぎる。"

#. Occurrence WIK_F_A:1697:22068: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_F_A_0008; voice_prefix=B40; voice_category=8; scene=WIK_F_A
#: WIK_F_A:1697
msgctxt "text_id=22068 | speaker=eiri"
msgid "  I suggest we should discuss the motive and the murder weapon.\""
msgstr "　ここはアリバイより動機、あるいは凶器について話しあいますか」"

#. Occurrence WIK_F_A:1741:22069: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_F_A_0002; voice_prefix=B70; voice_category=4; scene=WIK_F_A
#: WIK_F_A:1741
msgctxt "text_id=22069 | speaker=tobimaru"
msgid "\"If we look at motives, then we're all innocent."
msgstr "「動機の線でいけば、俺たちは全員白ですよ。"

#. Occurrence WIK_F_A:1753:22070: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_F_A_0003; voice_prefix=B70; voice_category=4; scene=WIK_F_A
#: WIK_F_A:1753
msgctxt "text_id=22070 | speaker=tobimaru"
msgid "  It has to be someone from outside who set this up. Old Yurihiko owned a massive enterprise. I can imagine a family member taking him out over rights or inheritance."
msgstr "　むしろ外部による犯行とした方が通りがいい。土桔の爺さんはあれで大企業のトップですからね。親族による利権がらみで殺された、ってのが普通の考えでしょう。"

#. Occurrence WIK_F_A:1765:22071: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_F_A_0004; voice_prefix=B70; voice_category=4; scene=WIK_F_A
#: WIK_F_A:1765
msgctxt "text_id=22071 | speaker=tobimaru"
msgid "  I don't think this line of questioning is going to get us anywhere.\""
msgstr "　なんで、動機をあれこれ想像するのも無駄骨かと」"

#. Occurrence WIK_F_A:1798:22072: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_F_A_0013; voice_prefix=B30; voice_category=9; scene=WIK_F_A
#: WIK_F_A:1798
msgctxt "text_id=22072 | speaker=ritsuka"
msgid "\"Ugh... I... I wanted to say that... But Yui's body blow... it hurts...\""
msgstr "「うう……その台詞、わたし……わたしが言いたかった……のに……唯ちゃんのボディブロー……痛すぎ……」"

#. Occurrence WIK_F_A:1835:22073: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_F_A_0009; voice_prefix=B40; voice_category=8; scene=WIK_F_A
#: WIK_F_A:1835
msgctxt "text_id=22073 | speaker=eiri"
msgid "\"I see. So you're saying we should consider the weapon, or the modus operandi.\""
msgstr "「なるほど。では、貴方は凶器について……殺害方法について考察するべきだと言うのですね」"

#. Occurrence WIK_F_A:1846:22074: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_F_A_0005; voice_prefix=B70; voice_category=4; scene=WIK_F_A
#: WIK_F_A:1846
msgctxt "text_id=22074 | speaker=tobimaru"
msgid "\"I'd think so. If we find out what weapon was used, we can figure out who carried it."
msgstr "「そういう事になりますかね。凶器を特定させれば、誰なら殺害可能かって問題に移れるでしょ。"

#. Occurrence WIK_F_A:1857:22075: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_F_A_0006; voice_prefix=B70; voice_category=4; scene=WIK_F_A
#: WIK_F_A:1857
msgctxt "text_id=22075 | speaker=tobimaru"
msgid "  Luckily, it's clear what the weapon was. Isn't it, Father?\""
msgstr "　幸い、凶器はハッキリしていますから。詠梨神父は気付いていますか？」"

#. Occurrence WIK_F_A:1883:22076: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_F_A_0010; voice_prefix=B40; voice_category=8; scene=WIK_F_A
#: WIK_F_A:1883
msgctxt "text_id=22076 | speaker=eiri"
msgid "\"To a certain extent, yes. I still don't know why we didn't hear it from here, however."
msgstr "「ええ、それなりには。居間と屋根裏<間|かん>でなぜ聞こえなかったのか、という不思議は残りますが。"

#. Occurrence WIK_F_A:1894:22077: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_F_A_0011; voice_prefix=B40; voice_category=8; scene=WIK_F_A
#: WIK_F_A:1894
msgctxt "text_id=22077 | speaker=eiri"
msgid "  Does everyone know what it was?\""
msgstr "　皆さんは分かりますか？」"

#. Occurrence WIK_F_A:1928:22078: scene=WIK_F_A
#: WIK_F_A:1928
msgctxt "text_id=22078 | speaker=unknown"
msgid "  It was a rather mean-spirited question. Father Eiri observed everyone's faces as he waited for a response."
msgstr "　詠梨神父はこの場にいる全員の顔を観察しながら、意地の悪い質問をした。"

#. Occurrence WIK_F_A:1933:22079: scene=WIK_F_A
#: WIK_F_A:1933
msgctxt "text_id=22079 | speaker=unknown"
msgid "  So, how was Yurihiko Tokitsu killed?"
msgstr "　土桔由里彦を殺害せしめた手段はなにか？"

#. Occurrence WIK_F_A:1938:22080: scene=WIK_F_A
#: WIK_F_A:1938
msgctxt "text_id=22080 | speaker=unknown"
msgid "  I..."
msgstr "　わたしは―――"

#. Occurrence WIK_SELECT_G:8:22081: scene=WIK_SELECT_G
#: WIK_SELECT_G:8
msgctxt "text_id=22081 | speaker=unknown"
msgid "-Decision G-"
msgstr "～選択肢Ｇ～"

#. Occurrence WIK_FIN:83:22082: scene=WIK_FIN
#: WIK_FIN:83
msgctxt "text_id=22082 | speaker=unknown"
msgid "  I woke up to find myself on a wooden floor."
msgstr "　目を覚ますと、そこは木の床の上だった。"

#. Occurrence WIK_FIN:125:22083: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_FIN_0000; voice_prefix=B10; voice_category=5; scene=WIK_FIN
#: WIK_FIN:125
msgctxt "text_id=22083 | speaker=kojika"
msgid "\"Huh...? What am I doing here...?\""
msgstr "「あれ……わたし、なんでこんな所に？」"

#. Occurrence WIK_FIN:131:22084: scene=WIK_FIN
#: WIK_FIN:131
msgctxt "text_id=22084 | speaker=unknown"
msgid "  I slowly picked myself up."
msgstr "　ゆっくりと体を起こす。"

#. Occurrence WIK_FIN:136:22085: scene=WIK_FIN
#: WIK_FIN:136
msgctxt "text_id=22085 | speaker=unknown"
msgid "  This was the hall of the Kuonji Estate."
msgstr "　場所は久遠寺邸のホール。"

#. Occurrence WIK_FIN:178:22086: scene=WIK_FIN
#: WIK_FIN:178
msgctxt "text_id=22086 | speaker=unknown"
msgid "  The grandfather clock told me it was almost seven in the morning."
msgstr "　柱時計は午前七時に差し掛かろうとしている。"

#. Occurrence WIK_FIN:183:22087: scene=WIK_FIN
#: WIK_FIN:183
msgctxt "text_id=22087 | speaker=unknown"
msgid "  At the edge of the foyer was a woman dressed like a nun, collapsed on the floor like me. Oh, she was just asleep."
msgstr "　ロビーの端っこにはシスター服の女性が、わたしと同じように倒れている。いや、眠っている。"

#. Occurrence WIK_FIN:232:22088: scene=WIK_FIN
#: WIK_FIN:232
msgctxt "text_id=22088 | speaker=unknown"
msgid "  The mansion was quiet, but I could hear several noises if I strained my ears."
msgstr "　洋館は静かで、けれど、耳を澄ますと様々な音が聞こえてきた。"

#. Occurrence WIK_FIN:238:22089: scene=WIK_FIN
#: WIK_FIN:238
msgctxt "text_id=22089 | speaker=unknown"
msgid "  There was the clinking of kitchenware."
msgstr "　台所からは食器と食器の重なる音。"

#. Occurrence WIK_FIN:244:22090: scene=WIK_FIN
#: WIK_FIN:244
msgctxt "text_id=22090 | speaker=unknown"
msgid "  Footsteps down the corridors. Old doors creaking."
msgstr "　廊下を行く足音や、<蝶番|ちょうつがい>の軋む音。"

#. Occurrence WIK_FIN:249:22091: scene=WIK_FIN
#: WIK_FIN:249
msgctxt "text_id=22091 | speaker=unknown"
msgid "  And..."
msgstr "　それと、"

#. Occurrence WIK_FIN:271:22092: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_FIN_0000; voice_prefix=B70; voice_category=4; scene=WIK_FIN
#: WIK_FIN:271
msgctxt "text_id=22092 | speaker=tobimaru"
msgid "\"...? Hey, what's going on here? What're we doing sleeping at Kuonji's place? Hey, wake up, Kinomi! Get your head on straight!\""
msgstr "「……？　おい、どうなってんだこりゃ。なんで俺ら久遠寺の家で寝てんだ？　起きろ木乃美、話きかせろ！」"

#. Occurrence WIK_FIN:277:22093: scene=WIK_FIN
#: WIK_FIN:277
msgctxt "text_id=22093 | speaker=unknown"
msgid "  A familiar voice echoed from the second floor."
msgstr "　二階からは、聞き慣れたアイツの声。"

#. Occurrence WIK_FIN:312:22094: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_FIN_0001; voice_prefix=B10; voice_category=5; scene=WIK_FIN
#: WIK_FIN:312
msgctxt "text_id=22094 | speaker=kojika"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence WIK_FIN:317:22095: scene=WIK_FIN
#: WIK_FIN:317
msgctxt "text_id=22095 | speaker=unknown"
msgid "  Somehow, the tightness in my chest lightened, and I stood up."
msgstr "　わたしはなぜか胸が楽になって、体を起こした。"

#. Occurrence WIK_FIN:322:22096: scene=WIK_FIN
#: WIK_FIN:322
msgctxt "text_id=22096 | speaker=unknown"
msgid "  To be honest, I was relieved."
msgstr "　有り体に言えばホッとしていた。"

#. Occurrence WIK_FIN:328:22097: scene=WIK_FIN
#: WIK_FIN:328
msgctxt "text_id=22097 | speaker=unknown"
msgid "  I glanced down, and saw something like an eggshell and a note."
msgstr "　ふと視線を下にやると、そこには卵のカラのようなものと、一枚のメモがあった。"

#. Occurrence WIK_FIN:344:22098: scene=WIK_FIN
#: WIK_FIN:344
msgctxt "text_id=22098 | speaker=unknown"
msgid "  There were just a few words on the note, scribbled in pink crayon."
msgstr "　メモにはピンクのクレヨンでたった一言。"

#. Occurrence WIK_FIN:369:22099: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B11_WIK_FIN_0000; voice_prefix=B11; voice_category=5; scene=WIK_FIN
#: WIK_FIN:369
msgctxt "text_id=22099 | speaker=kojika"
msgid "            \"Why not just live for love?\""
msgstr "　　　　　　『恋に生きたっていいんじゃない？』"

#. Occurrence WIK_FIN:390:22100: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_FIN_0002; voice_prefix=B10; voice_category=5; scene=WIK_FIN
#: WIK_FIN:390
msgctxt "text_id=22100 | speaker=kojika"
msgid "\"Huh?\""
msgstr "「は」"

#. Occurrence WIK_FIN:395:22101: scene=WIK_FIN
#: WIK_FIN:395
msgctxt "text_id=22101 | speaker=unknown"
msgid "  Stupid sweets-brain. Even after you're dead, you're still a pain in the ass."
msgstr "　さすがスイーツ脳。死んでもゴメンだ。"

#. Occurrence WIK_FIN:400:22102: scene=WIK_FIN
#: WIK_FIN:400
msgctxt "text_id=22102 | speaker=unknown"
msgid "  Besides, I was too passive to do that. It's how I fell for your trap to begin with."
msgstr "　そもそも、そんな簡単に開き直れないから、アンタの魔の手に引っかかったんじゃない。"

#. Occurrence WIK_FIN:445:22103: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B11_WIK_FIN_0001; voice_prefix=B11; voice_category=5; scene=WIK_FIN
#: WIK_FIN:445
msgctxt "text_id=22103 | speaker=kojika"
msgid "(Well, duh!)"
msgstr "“だよねー！”"

#. Occurrence WIK_FIN:450:22104: scene=WIK_FIN
#: WIK_FIN:450
msgctxt "text_id=22104 | speaker=unknown"
msgid "  Sweets Hearts's tone was lively, yet strangely encouraging."
msgstr "　妙に元気のいい、こちらを<励|はげ>ますような音。"

#. Occurrence WIK_FIN:462:22105: scene=WIK_FIN
#: WIK_FIN:462
msgctxt "text_id=22105 | speaker=unknown"
msgid "  Cracks began forming in the eggshell,"
msgstr "　卵の表面に<罅|ひび>が入る。"

#. Occurrence WIK_FIN:467:22106: scene=WIK_FIN
#: WIK_FIN:467
msgctxt "text_id=22106 | speaker=unknown"
msgid "  and then it crumbled,"
msgstr "　それはあっさりと砕けて、"

#. Occurrence WIK_FIN:490:22107: scene=WIK_FIN
#: WIK_FIN:490
msgctxt "text_id=22107 | speaker=unknown"
msgid "  taking everything, even my memories, with it."
msgstr "　何もかも、記憶すら持ちさって退場した。"

#. Occurrence WIK_FIN:511:22108: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_FIN_0003; voice_prefix=B10; voice_category=5; scene=WIK_FIN
#: WIK_FIN:511
msgctxt "text_id=22108 | speaker=kojika"
msgid "\"Huh. I feel like I was right in the middle of something.\""
msgstr "「あれ―――？　何かあった気がするん、だけど」"

#. Occurrence WIK_FIN:517:22109: scene=WIK_FIN
#: WIK_FIN:517
msgctxt "text_id=22109 | speaker=unknown"
msgid "  I picked up the note in front of me and frowned at it."
msgstr "　目の前のおかしなメモを手にして、首をかしげる。"

#. Occurrence WIK_FIN:522:22110: scene=WIK_FIN
#: WIK_FIN:522
msgctxt "text_id=22110 | speaker=unknown"
msgid "  Irritated by the presumptuous, obnoxious scribbling, I crumpled it up... and after a moment's hesitation, stowed it in my pocket."
msgstr "　あまりに脳天気かつ単細胞な走り書きに怒りを覚えたわたしは、メモをクシャッと握り潰して、ちょっと迷った後、ポケットにしまい込んだ。"

#. Occurrence WIK_FIN:561:22111: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_FIN_0001; voice_prefix=B70; voice_category=4; scene=WIK_FIN
#: WIK_FIN:561
msgctxt "text_id=22111 | speaker=tobimaru"
msgid "\"Oh, Kumari. You're here too?"
msgstr "「お？　久万梨も来てるじゃねえか。"

#. Occurrence WIK_FIN:567:22112: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_FIN_0002; voice_prefix=B70; voice_category=4; scene=WIK_FIN
#: WIK_FIN:567
msgctxt "text_id=22112 | speaker=tobimaru"
msgid "  What's going on? Did they move up the party?\""
msgstr "　どうなってんだこりゃ、パーティーの開始、午前中に変更したのか？」"

#. Occurrence WIK_FIN:573:22113: scene=WIK_FIN
#: WIK_FIN:573
msgctxt "text_id=22113 | speaker=unknown"
msgid "  There was a commotion coming from the stairs,"
msgstr "　階段の上からは、がやがやと人の気配。"

#. Occurrence WIK_FIN:578:22114: scene=WIK_FIN
#: WIK_FIN:578
msgctxt "text_id=22114 | speaker=unknown"
msgid "  plus the face of a guy I hadn't heard was coming."
msgstr "　プラス、来ていると聞いていなかったヤツの顔。"

#. Occurrence WIK_FIN:583:22115: scene=WIK_FIN
#: WIK_FIN:583
msgctxt "text_id=22115 | speaker=unknown"
msgid "  I quickly turned away and checked myself in a nearby mirror. Good. Nothing too out of place."
msgstr "　わたしは急いで顔をそむけて、ロビーにある鏡で自分をチェック。よし、おかしなところはとりあえず無い。"

#. Occurrence WIK_FIN:633:22116: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_FIN_0004; voice_prefix=B10; voice_category=5; scene=WIK_FIN
#: WIK_FIN:633
msgctxt "text_id=22116 | speaker=kojika"
msgid "\"That's what I'd like to know."
msgstr "「どうなってるか聞きたいのはこっちの方よ。"

#. Occurrence WIK_FIN:647:22117: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_FIN_0005_0; voice_prefix=B10; voice_category=5; scene=WIK_FIN
#: WIK_FIN:647
msgctxt "text_id=22117 | speaker=kojika"
msgid "  Is Miss Kuonji's birthday party really today? The date on the invitation could've been wrong..."
msgstr "　久遠寺さんの誕生会って、ほんとに今日なの？　招待状の日付、間違えてたんじゃ……"

#. Occurrence WIK_FIN:662:22118: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_FIN_0005_1; voice_prefix=B10; voice_category=5; scene=WIK_FIN
#: WIK_FIN:662
msgctxt "text_id=22118 | speaker=kojika"
msgid "Wait, huh?\""
msgstr "って、あれ？」"

#. Occurrence WIK_FIN:699:22119: scene=WIK_FIN
#: WIK_FIN:699
msgctxt "text_id=22119 | speaker=unknown"
msgid "  Where was this déjà vu coming from?"
msgstr "　この台詞、なんか言った覚えがあるような……？"

#. Occurrence WIK_FIN:705:22120: scene=WIK_FIN
#: WIK_FIN:705
msgctxt "text_id=22120 | speaker=unknown"
msgid "  Must have been my imagination."
msgstr "　ま、ただの気のせいだろう。"

#. Occurrence WIK_FIN:710:22121: scene=WIK_FIN
#: WIK_FIN:710
msgctxt "text_id=22121 | speaker=unknown"
msgid "  It was awfully rare to have a birthday party out at the Kuonji Estate."
msgstr "　今日は<稀少|レア>と言えば<稀少|レア>な、久遠寺邸での誕生会だ。"

#. Occurrence WIK_FIN:715:22122: scene=WIK_FIN
#: WIK_FIN:715
msgctxt "text_id=22122 | speaker=unknown"
msgid "  Our high school days were numbered."
msgstr "　高校生活は残り少ない。"

#. Occurrence WIK_FIN:720:22123: scene=WIK_FIN
#: WIK_FIN:720
msgctxt "text_id=22123 | speaker=unknown"
msgid "  The season would be over before we knew it. I had to make sure I finished it with no regrets."
msgstr "　気を抜けば終わってしまうだろう最後の季節を、わたしは後悔のないよう、自分らしくクリアしないと。"

#. Occurrence WIK_FIN:763:22124: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_FIN_0000; voice_prefix=B50; voice_category=6; scene=WIK_FIN
#: WIK_FIN:763
msgctxt "text_id=22124 | speaker=kinomi"
msgid "\"Whoa, Kojika?! You were invited, too?!"
msgstr "「うお、金鹿じゃん！？　おまえも呼ばれたワケ！？"

#. Occurrence WIK_FIN:769:22125: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_FIN_0001; voice_prefix=B50; voice_category=6; scene=WIK_FIN
#: WIK_FIN:769
msgctxt "text_id=22125 | speaker=kinomi"
msgid "  Do you know Alice?!\""
msgstr "　有珠ちゃんと面識あったのかよ！？」"

#. Occurrence WIK_FIN:782:22126: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_FIN_0006_0; voice_prefix=B10; voice_category=5; scene=WIK_FIN
#: WIK_FIN:782
msgctxt "text_id=22126 | speaker=kojika"
msgid "\"Anyone who's friends with Aozaki knows her."
msgstr "「そりゃあるわよ、蒼崎と友達やってれば。"

#. Occurrence WIK_FIN:796:22127: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_FIN_0006_1; voice_prefix=B10; voice_category=5; scene=WIK_FIN
#: WIK_FIN:796
msgctxt "text_id=22127 | speaker=kojika"
msgid " Anyway, simmer down, Housuke. You ever thought about growing up?\""
msgstr "ってか少しは落ち着け芳助。アンタ、ガキの頃から成長ないんだから」"

#. Occurrence WIK_FIN:849:22128: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_FIN_0003; voice_prefix=B70; voice_category=4; scene=WIK_FIN
#: WIK_FIN:849
msgctxt "text_id=22128 | speaker=tobimaru"
msgid "\"Hey, it's good to see childhood friends getting along."
msgstr "「おーおー。さすが幼なじみ、仲が良いコトで。"

#. Occurrence WIK_FIN:862:22129: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_FIN_0004; voice_prefix=B70; voice_category=4; scene=WIK_FIN
#: WIK_FIN:862
msgctxt "text_id=22129 | speaker=tobimaru"
msgid "  You should coach him, Kumari. You'd be helping him and everyone around him, too.\""
msgstr "　その調子で木乃美を仕付けてやれよ久万梨。まわりと、何より本人の為になるぜ」"

#. Occurrence WIK_FIN:891:22130: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_FIN_0007_0; voice_prefix=B10; voice_category=5; scene=WIK_FIN
#: WIK_FIN:891
msgctxt "text_id=22130 | speaker=kojika"
msgid "\"No way. No amount of money would be worth that much effort. I may as well bang my head against a wall."
msgstr "「嫌。億つまれたってお断り。労働と報酬が釣り合わないし。わたし、<無駄骨|むだぼね>折ってる時間ないし。"

#. Occurrence WIK_FIN:906:22131: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_FIN_0007_1; voice_prefix=B10; voice_category=5; scene=WIK_FIN
#: WIK_FIN:906
msgctxt "text_id=22131 | speaker=kojika"
msgid " No matter how many times you smack him, he won't change.\""
msgstr "こいつ、叩いても叩いても元通りになる形状記憶合金だし」"

#. Occurrence WIK_FIN:919:22132: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_FIN_0005; voice_prefix=B70; voice_category=4; scene=WIK_FIN
#: WIK_FIN:919
msgctxt "text_id=22132 | speaker=tobimaru"
msgid "\"Haha! I guess you're right! In that case, let's leave him and go say hi to Kuonji. She's probably in the drawing room with Aozaki.\""
msgstr "「はは、違ぇねえ！　んじゃまあ、コイツはほっといて久遠寺に挨拶に行くか。蒼崎と久遠寺は居間かねぇ」"

#. Occurrence WIK_FIN:946:22133: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_FIN_0002; voice_prefix=B50; voice_category=6; scene=WIK_FIN
#: WIK_FIN:946
msgctxt "text_id=22133 | speaker=kinomi"
msgid "\"Hey! Wait, before you go! There's a nun on the floor over there, Your Highness!"
msgstr "「ちょっ、その前にあそこ！　シスターが倒れてるぜ殿下！"

#. Occurrence WIK_FIN:962:22134: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_FIN_0003; voice_prefix=B50; voice_category=6; scene=WIK_FIN
#: WIK_FIN:962
msgctxt "text_id=22134 | speaker=kinomi"
msgid "  Maybe I can help her get to her feet and be her hero!\""
msgstr "　おおお、俺が抱き起こしちゃっていいかな！？」"

#. Occurrence WIK_FIN:975:22135: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_FIN_0006; voice_prefix=B70; voice_category=4; scene=WIK_FIN
#: WIK_FIN:975
msgctxt "text_id=22135 | speaker=tobimaru"
msgid "\"Go ahead. All she'll do is knock you out, at worst.\""
msgstr "「いいんじゃねえの？　最悪、テメエがのされるだけだし」"

#. Occurrence WIK_FIN:1024:22136: scene=WIK_FIN
#: WIK_FIN:1024
msgctxt "text_id=22136 | speaker=unknown"
msgid "  Tsukiji sounded like he was enjoying himself. His voice carried through the hall."
msgstr "　平凡で、楽しげな話し声はホールへと下りていく。"

#. Occurrence WIK_FIN:1054:22137: scene=WIK_FIN
#: WIK_FIN:1054
msgctxt "text_id=22137 | speaker=unknown"
msgid "  Dust particles flitted in the air, appearing and disappearing in the rays coming through the skylight."
msgstr "　風に散った粒子は天窓を透り抜けて、太陽に焼かれるように消えていく。"

#. Occurrence WIK_FIN:1062:22138: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B11_WIK_FIN_0002; voice_prefix=B11; voice_category=5; scene=WIK_FIN
#: WIK_FIN:1062
msgctxt "text_id=22138 | speaker=kojika"
msgid "    (Mm, I guess this could've ended worse!)"
msgstr "　　“んー、まあそういうオチもいいっちゃいいか！”"

#. Occurrence WIK_FIN:1068:22139: scene=WIK_FIN
#: WIK_FIN:1068
msgctxt "text_id=22139 | speaker=unknown"
msgid "  An oddly cheerful voice summed up her honest thoughts."
msgstr "　妙に清々しい、カノジョの素直な気持ちを代弁しながら。"

#. Occurrence WIK_FIN:1109:22140: scene=WIK_FIN
#: WIK_FIN:1109
msgctxt "text_id=22140 | speaker=unknown"
msgid "  The mad rhapsody drew to a close."
msgstr "　狂想曲はこれにて終了。"

#. Occurrence WIK_FIN:1114:22141: scene=WIK_FIN
#: WIK_FIN:1114
msgctxt "text_id=22141 | speaker=unknown"
msgid "  She smiled in her own way. Each to their own."
msgstr "　彼女は「自分らしく」と微笑んだけれど、それもやっぱり人それぞれ。"

#. Occurrence WIK_FIN:1151:22142: scene=WIK_FIN
#: WIK_FIN:1151
msgctxt "text_id=22142 | speaker=unknown"
msgid "  Everyone had a choice. To lament the little time one had left,"
msgstr "　少ない時間を惜しむのも、"

msgctxt "text_id=22143 | speaker=unknown"
msgid "  or to gamble on it?"
msgstr "　残った時間に賭けるのも、人それぞれの選択だ。"

#. Occurrence WIK_FIN:1159:22144: scene=WIK_FIN
#: WIK_FIN:1159
msgctxt "text_id=22144 | speaker=unknown"
msgid "  Perhaps we find things beautiful because they don't last."
msgstr "　けだし、過ぎ去るものはみな美しく。"

#. Occurrence WIK_FIN:1164:22145: scene=WIK_FIN
#: WIK_FIN:1164
msgctxt "text_id=22145 | speaker=unknown"
msgid "  Someday, this would all end...but not just yet."
msgstr "　終わりはいつか訪れるにしても、それは<暫|しばら>く先の話。"

#. Occurrence WIK_FIN:1185:22146: scene=WIK_FIN
#: WIK_FIN:1185
msgctxt "text_id=22146 | speaker=unknown"
msgid "  This jolly tale was simply another book to add to the shelf."
msgstr "　この華やいだ一日も、一編、本棚に収まる程度の<物語|はなし>。"

#. Occurrence WIK_FIN:1192:22147: scene=WIK_FIN
#: WIK_FIN:1192
msgctxt "text_id=22147 | speaker=unknown"
msgid "  Youth is both fleeting and never-ending."
msgstr "　―――青春時代は短く長く。"

#. Occurrence WIK_FIN:1197:22148: scene=WIK_FIN
#: WIK_FIN:1197
msgctxt "text_id=22148 | speaker=unknown"
msgid "  The stories of young boys and girls are full of hardships yet unseen."
msgstr "　少年少女の物語は、まだ見ぬ波乱に満ちている。"

#. Occurrence WIK_FIN:1204:22149: scene=WIK_FIN
#: WIK_FIN:1204
msgctxt "text_id=22149 | speaker=unknown"
msgid "  Which means, my friends,"
msgstr "　であれば皆さま。"

#. Occurrence WIK_FIN:1209:22150: scene=WIK_FIN
#: WIK_FIN:1209
msgctxt "text_id=22150 | speaker=unknown"
msgid "  we shall no doubt meet again."
msgstr "　いつかまた、次の機会にお会いしましょう―――"

#. Occurrence WIK_G_1:30:22151: scene=WIK_G_1
#: WIK_G_1:30
msgctxt "text_id=22151 | speaker=unknown"
msgid "  Broadly speaking, I think the weapon used was bread."
msgstr "　わたしは、大雑把に言うとパンだ、と思った。"

#. Occurrence WIK_G_2:30:22152: scene=WIK_G_2
#: WIK_G_2:30
msgctxt "text_id=22152 | speaker=unknown"
msgid "  I think it was a small explosive, practically speaking."
msgstr "　わたしは、現実的に小型爆薬だ、と思った。"

#. Occurrence WIK_G_3:30:22153: scene=WIK_G_3
#: WIK_G_3:30
msgctxt "text_id=22153 | speaker=unknown"
msgid "  As crazy as it sounds, maybe he was eaten by a dog or something."
msgstr "　わたしは、ほんっとーに突拍子もないが、犬か何かに食いちぎられたのでは、と思った。"

#. Occurrence WIK_G_3:35:22154: scene=WIK_G_3
#: WIK_G_3:35
msgctxt "text_id=22154 | speaker=unknown"
msgid "  ...But why?"
msgstr "　……なんで？"

#. Occurrence WIK_G_A:40:22155: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_G_A_0000; voice_prefix=A10; voice_category=1; scene=WIK_G_A
#: WIK_G_A:40
msgctxt "text_id=22155 | speaker=aoko"
msgid "\"Huh? What do you mean? Isn't it obvious?"
msgstr "「え？　なにって一目瞭然でしょ、あんなの。"

#. Occurrence WIK_G_A:46:22156: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_G_A_0001; voice_prefix=A10; voice_category=1; scene=WIK_G_A
#: WIK_G_A:46
msgctxt "text_id=22156 | speaker=aoko"
msgid "  They probably stuck dynamite to his hands, feet, and face.\""
msgstr "　手と足と顔にダイナマイトつけたんじゃないの？」"

#. Occurrence WIK_G_A:56:22157: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_G_A_0000; voice_prefix=B80; voice_category=13; scene=WIK_G_A
#: WIK_G_A:56
msgctxt "text_id=22157 | speaker=liddell"
msgid "\"That would be the logical conclusion."
msgstr "「ええ、当然の論理的帰結ね。"

#. Occurrence WIK_G_A:62:22158: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_G_A_0001; voice_prefix=B80; voice_category=13; scene=WIK_G_A
#: WIK_G_A:62
msgctxt "text_id=22158 | speaker=liddell"
msgid "  I mean, those parts of his body were totally gone.\""
msgstr "　だって手と足と顔がないんだもの」"

#. Occurrence WIK_G_A:71:22159: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_G_A_0000; voice_prefix=B70; voice_category=4; scene=WIK_G_A
#: WIK_G_A:71
msgctxt "text_id=22159 | speaker=tobimaru"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence WIK_G_A:76:22160: scene=WIK_G_A
#: WIK_G_A:76
msgctxt "text_id=22160 | speaker=unknown"
msgid "  Aozaki was a thorough realist, but she could arrive at some pretty wild conclusions sometimes."
msgstr "　徹底した現実主義な為か、蒼崎はときどき、素っ頓狂な結論に辿り着く。"

#. Occurrence WIK_G_A:102:22161: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_G_A_0001; voice_prefix=B70; voice_category=4; scene=WIK_G_A
#: WIK_G_A:102
msgctxt "text_id=22161 | speaker=tobimaru"
msgid "\"While that's possible, I don't think that's what happened."
msgstr "「その可能性もなくはないが、今回は別だ。"

#. Occurrence WIK_G_A:113:22162: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_G_A_0002; voice_prefix=B70; voice_category=4; scene=WIK_G_A
#: WIK_G_A:113
msgctxt "text_id=22162 | speaker=tobimaru"
msgid "  We don't know how Mr. Tokitsu ended up in the attic, but we do know what happened there. It was a dust explosion.\""
msgstr "　土桔の爺さんがどういう経緯であの部屋に居たかは不明だが、あの部屋で何が起きたかは分かる。<粉塵|ふんじん>爆発だ」"

#. Occurrence WIK_G_A:160:22163: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_G_A_0002; voice_prefix=A10; voice_category=1; scene=WIK_G_A
#: WIK_G_A:160
msgctxt "text_id=22163 | speaker=aoko"
msgid "\"By that, you mean an explosion caused by something like fireworks igniting something combustible in the air?\""
msgstr "「はあ？　粉塵爆発って、大気中に可燃性の石炭が舞っていて、花火とかで引火したら爆発するっていう、アレ？」"

#. Occurrence WIK_G_A:198:22164: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_G_A_0000; voice_prefix=B40; voice_category=8; scene=WIK_G_A
#: WIK_G_A:198
msgctxt "text_id=22164 | speaker=eiri"
msgid "\"You're on the right track. In a closed space like that, an explosion can occur when there's a certain amount of combustible dust, like flour."
msgstr "「大雑把に言うとそうですね。石炭にかぎらず、そこが密室で、一定量の可燃性の粉塵であれば爆発は起きるんですよ。家庭用品でいうと小麦粉ですね。"

#. Occurrence WIK_G_A:210:22165: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_G_A_0001; voice_prefix=B40; voice_category=8; scene=WIK_G_A
#: WIK_G_A:210
msgctxt "text_id=22165 | speaker=eiri"
msgid "  You can even make thermite out of aluminum foil and the rust from old pots and pans. But based on the situation, a powder seems more likely.\""
msgstr "　他には鍋の錆とアルミホイルでテルミットも作れますが、まあ、状況からして粉塵の方でしょう」"

#. Occurrence WIK_G_A:244:22166: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_G_A_0003; voice_prefix=A10; voice_category=1; scene=WIK_G_A
#: WIK_G_A:244
msgctxt "text_id=22166 | speaker=aoko"
msgid "\"But if that was the case, why was only his torso intact?"
msgstr "「でも、ならどうして胴体だけ残ってたの？"

#. Occurrence WIK_G_A:256:22167: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_G_A_0004; voice_prefix=A10; voice_category=1; scene=WIK_G_A
#: WIK_G_A:256
msgctxt "text_id=22167 | speaker=aoko"
msgid "  Are dust explosions even that powerful?\""
msgstr "　そもそも粉塵爆発ってそんなに強いの？」"

#. Occurrence WIK_G_A:265:22168: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_G_A_0003; voice_prefix=B70; voice_category=4; scene=WIK_G_A
#: WIK_G_A:265
msgctxt "text_id=22168 | speaker=tobimaru"
msgid "\"That's what we need to find out. It's possible his jacket was blast-resistant."
msgstr "「そこはこれから探るところだが、爺さんのコート、あれ防弾ジャケットなのかもな。"

#. Occurrence WIK_G_A:276:22169: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_G_A_0004; voice_prefix=B70; voice_category=4; scene=WIK_G_A
#: WIK_G_A:276
msgctxt "text_id=22169 | speaker=tobimaru"
msgid "  And we don't know if it was the explosion that killed him. The culprit could've set off the blast after they murdered him. Given that the explosion itself was small, his limbs and face could've already been burned.\""
msgstr "　それと、死因は粉塵爆発とはかぎらない。殺した後に爆発を起こした、って線もある。爆発自体は小さいもので、手足と顔は、あらかじめ灼いてあったのかもだ」"

#. Occurrence WIK_G_A:315:22170: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_G_A_0002; voice_prefix=B40; voice_category=8; scene=WIK_G_A
#: WIK_G_A:315
msgctxt "text_id=22170 | speaker=eiri"
msgid "\"True. That would also explain why we didn't hear the explosion from the drawing room."
msgstr "「そうですね。それなら爆発の音が居間まで聞こえなかった説明にもなる。"

#. Occurrence WIK_G_A:321:22171: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_G_A_0003; voice_prefix=B40; voice_category=8; scene=WIK_G_A
#: WIK_G_A:321
msgctxt "text_id=22171 | speaker=eiri"
msgid "  We can't overlook the possibility that the dust explosion traces are some sort of misdirection.\""
msgstr "　あの粉塵爆発の跡は、何らかのカモフラージュという説も捨て切れません」"

#. Occurrence WIK_G_A:331:22172: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_G_A_0000; voice_prefix=B10; voice_category=5; scene=WIK_G_A
#: WIK_G_A:331
msgctxt "text_id=22172 | speaker=kojika"
msgid "\"Misdirection? What would they be hiding?\""
msgstr "「カモフラージュって……何を隠すっていうんですか？」"

#. Occurrence WIK_G_A:357:22173: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_G_A_0004; voice_prefix=B40; voice_category=8; scene=WIK_G_A
#: WIK_G_A:357
msgctxt "text_id=22173 | speaker=eiri"
msgid "\"The unnatural aspects of this entire killing, of course."
msgstr "「ですから、“不自然さ”をです。"

#. Occurrence WIK_G_A:368:22174: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_G_A_0005; voice_prefix=B40; voice_category=8; scene=WIK_G_A
#: WIK_G_A:368
msgctxt "text_id=22174 | speaker=eiri"
msgid "  For instance, what if the corpse wasn't actually Mr. Tokitsu's, but someone else's?"
msgstr "　たとえば、あの遺体が土桔氏ではなく、まったく関係のない人間の死体だったらどうです？"

#. Occurrence WIK_G_A:374:22175: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_G_A_0006; voice_prefix=B40; voice_category=8; scene=WIK_G_A
#: WIK_G_A:374
msgctxt "text_id=22175 | speaker=eiri"
msgid "  In that case, the culprit would need to obscure his face. However, burning the face alone would be too obvious.\""
msgstr "　その場合、顔があってはあの死体が土桔氏でない事は明白です。犯人はなんとしても顔を隠したい。しかし、だからといって顔を焼いては、その行為そのものが証拠になります」"

#. Occurrence WIK_G_A:400:22176: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_G_A_0007; voice_prefix=B40; voice_category=8; scene=WIK_G_A
#: WIK_G_A:400
msgctxt "text_id=22176 | speaker=eiri"
msgid "\"Perhaps to make it seem 'normal' his face had been burned, they purposefully disguised their overall approach with an explosion."
msgstr "「なので、焼かれていても不自然ではない状態を演出する為に、あえて不自然な粉塵爆発を使って、大本の不自然さを隠した、とか。"

#. Occurrence WIK_G_A:411:22177: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_G_A_0008; voice_prefix=B40; voice_category=8; scene=WIK_G_A
#: WIK_G_A:411
msgctxt "text_id=22177 | speaker=eiri"
msgid "  A bigger deception to mask smaller lies.\""
msgstr "　大きな嘘の前には、小さな嘘が消えてしまうというヤツですよ」"

#. Occurrence WIK_G_A:440:22178: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_G_A_0000; voice_prefix=B30; voice_category=9; scene=WIK_G_A
#: WIK_G_A:440
msgctxt "text_id=22178 | speaker=ritsuka"
msgid "\"Come ooon... I wanted to say that... I really wanted to say that...\""
msgstr "「うう……それも言いたかった、言いたかったのにー」"

#. Occurrence WIK_G_A:476:22179: scene=WIK_G_A
#: WIK_G_A:476
msgctxt "text_id=22179 | speaker=unknown"
msgid "  Everyone seemed impressed by Tsukiji and the priest. Heck, I sure was."
msgstr "　神父と槻司の考察に、思わず感心してしまうわたしたちだった。"

#. Occurrence WIK_G_A:481:22180: scene=WIK_G_A
#: WIK_G_A:481
msgctxt "text_id=22180 | speaker=unknown"
msgid "  Even if I'd pinned down the possibility there was a dust explosion in the room, I wouldn't have figured out why."
msgstr "　あの部屋で粉塵爆発が起きた可能性までは追及できたとしても、その先、なぜ爆発なんてものを起こしたのか、までわたしは行き着いていなかったのだ。"

#. Occurrence WIK_G_A:518:22181: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_G_A_0000; voice_prefix=B50; voice_category=6; scene=WIK_G_A
#: WIK_G_A:518
msgctxt "text_id=22181 | speaker=kinomi"
msgid "\"A dust explosion, I see.\""
msgstr "「なるほど、粉塵爆発にそんな意味が」"

#. Occurrence WIK_G_A:523:22182: scene=WIK_G_A
#: WIK_G_A:523
msgctxt "text_id=22182 | speaker=unknown"
msgid "  Housuke nodded solemnly."
msgstr "　うむ、ともっともらしく頷く芳助。"

#. Occurrence WIK_G_A:535:22183: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_G_A_0001; voice_prefix=B50; voice_category=6; scene=WIK_G_A
#: WIK_G_A:535
msgctxt "text_id=22183 | speaker=kinomi"
msgid "\"Um, what does that mean?\""
msgstr "「で、ごめん。それってどういうコトなの？」"

#. Occurrence WIK_G_A:546:22184: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_G_A_0005; voice_prefix=B70; voice_category=4; scene=WIK_G_A
#: WIK_G_A:546
msgctxt "text_id=22184 | speaker=tobimaru"
msgid "\"For now, it means we can pinpoint the location of the weapon."
msgstr "「とりあえず、凶器の所在を明らかにできるってコトだ。"

#. Occurrence WIK_G_A:557:22185: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_G_A_0006; voice_prefix=B70; voice_category=4; scene=WIK_G_A
#: WIK_G_A:557
msgctxt "text_id=22185 | speaker=tobimaru"
msgid "  Soujyuro, is there flour in the kitchen?\""
msgstr "　草十郎、台所に小麦粉はあるか？」"

#. Occurrence WIK_G_A:563:22186: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_G_A_0000; voice_prefix=A30; voice_category=3; scene=WIK_G_A
#: WIK_G_A:563
msgctxt "text_id=22186 | speaker=soujuurou"
msgid "\"I'm checking now... Nope, nothing."
msgstr "「いま調べてる。……ないな。"

#. Occurrence WIK_G_A:577:22187: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_G_A_0001; voice_prefix=A30; voice_category=3; scene=WIK_G_A
#: WIK_G_A:577
msgctxt "text_id=22187 | speaker=soujuurou"
msgid "  I bought extra, but the bags are gone.\""
msgstr "　買い置きがあったのに、袋ごとなくなってる」"

#. Occurrence WIK_G_A:653:22188: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_G_A_0002; voice_prefix=B50; voice_category=6; scene=WIK_G_A
#: WIK_G_A:653
msgctxt "text_id=22188 | speaker=kinomi"
msgid "\"Okay... So what does that mean?\""
msgstr "「つまり―――どういうコトだってばよ？」"

#. Occurrence WIK_G_A:664:22189: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_G_A_0001; voice_prefix=B10; voice_category=5; scene=WIK_G_A
#: WIK_G_A:664
msgctxt "text_id=22189 | speaker=kojika"
msgid "\"Someone took the flour from the kitchen."
msgstr "「誰かが台所から小麦粉を持ち出したってコトでしょ。"

#. Occurrence WIK_G_A:675:22190: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_G_A_0002; voice_prefix=B10; voice_category=5; scene=WIK_G_A
#: WIK_G_A:675
msgctxt "text_id=22190 | speaker=kojika"
msgid "  Which goes to show...\""
msgstr "　それが示すところは―――」"

#. Occurrence WIK_G_A:681:22191: scene=WIK_G_A
#: WIK_G_A:681
msgctxt "text_id=22191 | speaker=unknown"
msgid "  That the culprit knew their way around the kitchen... right?"
msgstr "　犯人は、この家の台所に精通している者……と考えていいのだろうか？"

#. Occurrence WIK_G_A:686:22192: scene=WIK_G_A
#: WIK_G_A:686
msgctxt "text_id=22192 | speaker=unknown"
msgid "  Or was this another possible misdirection?"
msgstr "　それとも、そう思わせる為のミスリードか？"

#. Occurrence WIK_G_A:706:22193: scene=WIK_G_A
#: WIK_G_A:706
msgctxt "text_id=22193 | speaker=unknown"
msgid "  Just then..."
msgstr "　……と。"

#. Occurrence WIK_G_A:765:22194: scene=WIK_G_A
#: WIK_G_A:765
msgctxt "text_id=22194 | speaker=unknown"
msgid "  ...the blue robin, which had been gone all this time, came flapping back into the drawing room."
msgstr "　今まで何処に行っていたのか、青い駒鳥がパタパタと居間に舞い戻ってきた。"

#. Occurrence WIK_G_A:770:22195: scene=WIK_G_A
#: WIK_G_A:770
msgctxt "text_id=22195 | speaker=unknown"
msgid "  It perched on Miss Kuonji's shoulder and let out a shrill chirp."
msgstr "　駒鳥は久遠寺さんの肩に留まり、チチチ、と甲高い声をあげる。"

#. Occurrence WIK_G_A:817:22196: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0000; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:817
msgctxt "text_id=22196 | speaker=alice"
msgid "\"Oh dear.\""
msgstr "「まあ」"

#. Occurrence WIK_G_A:849:22197: scene=WIK_G_A
#: WIK_G_A:849
msgctxt "text_id=22197 | speaker=unknown"
msgid "  Miss Kuonji stood up from the sofa and looked at all of us."
msgstr "　久遠寺さんはソファーから立ち上がると、ぐるりと一同を見渡した。"

#. Occurrence WIK_G_A:874:22198: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0001; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:874
msgctxt "text_id=22198 | speaker=alice"
msgid "\"Sorry to interrupt the serious discussion, but I have bad news."
msgstr "「真剣に討論をしているところ申し訳ないのだけど、皆さんにたいへんなお知らせがあります。"

#. Occurrence WIK_G_A:886:22199: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0002; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:886
msgctxt "text_id=22199 | speaker=alice"
msgid "  Before that, Sizuki, do you have a moment?\""
msgstr "　その前に。静希君、少しいい……？」"

#. Occurrence WIK_G_A:948:22200: scene=WIK_G_A
#: WIK_G_A:948
msgctxt "text_id=22200 | speaker=unknown"
msgid "  She gestured Sizuki over to her, and spoke to him in a hushed voice."
msgstr "　久遠寺さんは静希を手招きして小声で話しかける。"

#. Occurrence WIK_G_A:965:22201: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_G_A_0002; voice_prefix=B80; voice_category=13; scene=WIK_G_A
#: WIK_G_A:965
msgctxt "text_id=22201 | speaker=liddell"
msgid "\"Hey, what're you getting all buddy-buddy over there for?"
msgstr "「ちょっと。そこ、近いんじゃないの？"

#. Occurrence WIK_G_A:971:22202: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_G_A_0003; voice_prefix=B80; voice_category=13; scene=WIK_G_A
#: WIK_G_A:971
msgctxt "text_id=22202 | speaker=liddell"
msgid "  If you have something to say, say it to all of us. Ugh, some people...\""
msgstr "　隠し事とか、感じ悪いんだけど」"

#. Occurrence WIK_G_A:1023:22203: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0003; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:1023
msgctxt "text_id=22203 | speaker=alice"
msgid "\"Sorry, Riddell. But it seems Sizuki has something to say to you."
msgstr "「ごめんなさいリデル。でも、その前に静希君から貴女に、とっておきの小話があるそうよ。"

#. Occurrence WIK_G_A:1029:22204: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0004; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:1029
msgctxt "text_id=22204 | speaker=alice"
msgid "  I'm sure it's quite wonderful, so do listen.\""
msgstr "　きっと素敵な話だろうから、聞いてみてあげて」"

#. Occurrence WIK_G_A:1055:22205: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_G_A_0002; voice_prefix=A30; voice_category=3; scene=WIK_G_A
#: WIK_G_A:1055
msgctxt "text_id=22205 | speaker=soujuurou"
msgid "\"Yeah. This might help."
msgstr "「ああ。こんなコトでいいなら、是非聞いてほしい。"

#. Occurrence WIK_G_A:1066:22206: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_G_A_0003; voice_prefix=A30; voice_category=3; scene=WIK_G_A
#: WIK_G_A:1066
msgctxt "text_id=22206 | speaker=soujuurou"
msgid "  Alice assured me you'd be interested. You've helped me time and time again, so it would mean a lot if you would hear me out.\""
msgstr "　リデルの心を打つコト請け合いだって、有珠が。君には何度か助けられたし、喜んでもらえるなら俺も嬉しい」"

#. Occurrence WIK_G_A:1098:22207: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_G_A_0004; voice_prefix=B80; voice_category=13; scene=WIK_G_A
#: WIK_G_A:1098
msgctxt "text_id=22207 | speaker=liddell"
msgid "\"F-Fine. I'm listening. Spit it out already.\""
msgstr "「っ……い、いいじゃない、聞いてあげるから言いなさいよ」"

#. Occurrence WIK_G_A:1181:22208: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_G_A_0004; voice_prefix=A30; voice_category=3; scene=WIK_G_A
#: WIK_G_A:1181
msgctxt "text_id=22208 | speaker=soujuurou"
msgid "\"Je t'aime. Je t'aime, mon amour.\""
msgstr "「ジュッティム。ジュテェーム、モナムゥー」"

#. Occurrence WIK_G_A:1274:22209: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_G_A_0005; voice_prefix=B80; voice_category=13; scene=WIK_G_A
#: WIK_G_A:1274
msgctxt "text_id=22209 | speaker=liddell"
msgid "\"What...?\""
msgstr "「は……？」"

#. Occurrence WIK_G_A:1303:22210: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_G_A_0006; voice_prefix=B80; voice_category=13; scene=WIK_G_A
#: WIK_G_A:1303
msgctxt "text_id=22210 | speaker=liddell"
msgid "\"Why the hell would you of all people say that?!"
msgstr "「って、なにそれ、おっかしいの、似合わない！"

#. Occurrence WIK_G_A:1310:22211: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_G_A_0007_0; voice_prefix=B80; voice_category=13; scene=WIK_G_A
#: WIK_G_A:1310
msgctxt "text_id=22211 | speaker=liddell"
msgid "  Soujyuro, Alice is messing with you. Do you even know what you just sai―"
msgstr "　ソウジューロー、アリスに遊ばれてるってば、いまの台詞、どんな意味だかわかっ―――"

#. Occurrence WIK_G_A:1364:22212: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_G_A_0007_1; voice_prefix=B80; voice_category=13; scene=WIK_G_A
#: WIK_G_A:1364
msgctxt "text_id=22212 | speaker=liddell"
msgid " Whuh?!\""
msgstr "ぐはっ！？」"

#. Occurrence WIK_G_A:1488:22213: voice_id=X80_WIK_G_A_0000; voice_prefix=X80; voice_category=0; scene=WIK_G_A
#: WIK_G_A:1488
msgctxt "text_id=22213 | speaker=unknown"
msgid "\"She vomited blood and collapsed!\""
msgstr "「ちょっ、いきなり<吐血|とけつ>して倒れこんだーーーーー！？」"

#. Occurrence WIK_G_A:1506:22214: scene=WIK_G_A
#: WIK_G_A:1506
msgctxt "text_id=22214 | speaker=unknown"
msgid "  I rushed over to the girl in pink."
msgstr "　倒れたピンク女に駆け寄る。"

#. Occurrence WIK_G_A:1549:22215: scene=WIK_G_A
#: WIK_G_A:1549
msgctxt "text_id=22215 | speaker=unknown"
msgid "  No pulse. She wasn't breathing, either."
msgstr "　脈拍、なし。呼吸、なし。"

#. Occurrence WIK_G_A:1554:22216: scene=WIK_G_A
#: WIK_G_A:1554
msgctxt "text_id=22216 | speaker=unknown"
msgid "  Pupils unresponsive. No sign of life at all."
msgstr "　瞳孔、生体反射、なし。"

#. Occurrence WIK_G_A:1563:22217: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_G_A_0003; voice_prefix=B10; voice_category=5; scene=WIK_G_A
#: WIK_G_A:1563
msgctxt "text_id=22217 | speaker=kojika"
msgid "\"She's totally dead.\""
msgstr "「完全に死んでいるわ」"

#. Occurrence WIK_G_A:1603:22218: scene=WIK_G_A
#: WIK_G_A:1603
msgctxt "text_id=22218 | speaker=unknown"
msgid "  The atmosphere in the drawing room turned frenzied."
msgstr "　居間はちょっとした混乱状態になった。"

#. Occurrence WIK_G_A:1624:22219: scene=WIK_G_A
#: WIK_G_A:1624
msgctxt "text_id=22219 | speaker=unknown"
msgid "  Some looked shocked,"
msgstr "　驚く者、"

#. Occurrence WIK_G_A:1648:22220: scene=WIK_G_A
#: WIK_G_A:1648
msgctxt "text_id=22220 | speaker=unknown"
msgid "  while others looked cautious."
msgstr "　周囲に注意を払う者、"

#. Occurrence WIK_G_A:1667:22221: scene=WIK_G_A
#: WIK_G_A:1667
msgctxt "text_id=22221 | speaker=unknown"
msgid "  And a few of us were utterly dumbfounded."
msgstr "　まったく事態を理解できていない者。"

#. Occurrence WIK_G_A:1701:22222: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0005; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:1701
msgctxt "text_id=22222 | speaker=alice"
msgid "\"Things are getting worse.\""
msgstr "「やっぱり。困ったコトになったわね」"

#. Occurrence WIK_G_A:1724:22223: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_G_A_0005; voice_prefix=A10; voice_category=1; scene=WIK_G_A
#: WIK_G_A:1724
msgctxt "text_id=22223 | speaker=aoko"
msgid "\"What's going on, Alice? Why'd Riddell die?\""
msgstr "「どういうこと有珠、リデルのヤツ、なんで死んだの？」"

#. Occurrence WIK_G_A:1736:22224: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0006; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:1736
msgctxt "text_id=22224 | speaker=alice"
msgid "\"It's simple, actually."
msgstr "「説明するのは簡単よ。"

#. Occurrence WIK_G_A:1742:22225: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0007; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:1742
msgctxt "text_id=22225 | speaker=alice"
msgid "  I had my suspicions when we found Tokie in the attic, so I had Robin go and check the vault."
msgstr "　トッキィーの殺害現場で気になる事があったから、さっきロビンに保管庫の様子を見に行かせたの。"

#. Occurrence WIK_G_A:1748:22226: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0008; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:1748
msgctxt "text_id=22226 | speaker=alice"
msgid "  One Ploy Kickshaw's missing.\""
msgstr "　そうしたら一体分、プロイキッシャーが空席だって」"

#. Occurrence WIK_G_A:1774:22227: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_G_A_0006; voice_prefix=A10; voice_category=1; scene=WIK_G_A
#: WIK_G_A:1774
msgctxt "text_id=22227 | speaker=aoko"
msgid "\"Missing? So you're saying Mr. Tokitsu and Riddell were killed by a Ploy?\""
msgstr "「プロイが……？　じゃあ爺さんとリデルを殺ったのはそのプロイだって言うの？」"

#. Occurrence WIK_G_A:1786:22228: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0009; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:1786
msgctxt "text_id=22228 | speaker=alice"
msgid "\"It'd be more accurate to say they were caught by the Ploy's rules."
msgstr "「正確にはプロイのルールにひっかかった、というべきね。"

#. Occurrence WIK_G_A:1798:22229: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0010; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:1798
msgctxt "text_id=22229 | speaker=alice"
msgid "  No point in hiding anything now, so I'll explain."
msgstr "　隠していても仕方のない事だから、はっきりと言うわ。"

#. Occurrence WIK_G_A:1804:22230: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0011; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:1804
msgctxt "text_id=22230 | speaker=alice"
msgid "  Until tomorrow morning, laughter is strictly forbidden.\""
msgstr "　これから朝まで、笑うのは絶対に禁止よ」"

#. Occurrence WIK_G_A:1848:22231: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_G_A_0004; voice_prefix=B10; voice_category=5; scene=WIK_G_A
#: WIK_G_A:1848
msgctxt "text_id=22231 | speaker=kojika"
msgid "\"Why?\""
msgstr "「なんで？」"

#. Occurrence WIK_G_A:1860:22232: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0012; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:1860
msgctxt "text_id=22232 | speaker=alice"
msgid "\"The mansion has become a world where those who laugh... die.\""
msgstr "「だって。この洋館、笑ったら死ぬ世界になったから」"

#. Occurrence WIK_G_A:1919:22233: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_G_A_0003; voice_prefix=B50; voice_category=6; scene=WIK_G_A
#: WIK_G_A:1919
msgctxt "text_id=22233 | speaker=kinomi"
msgid "\"No way! That's crazy scary!"
msgstr "「そんなあ、笑ったら死ぬとかマジ怖いじゃん！"

#. Occurrence WIK_G_A:1932:22234: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_G_A_0004; voice_prefix=B50; voice_category=6; scene=WIK_G_A
#: WIK_G_A:1932
msgctxt "text_id=22234 | speaker=kinomi"
msgid "  You got me, Alice! Great joke! Hahahaha!\""
msgstr "　有珠ちゃんったら冗談うまいんだから、ははははは！」"

#. Occurrence WIK_G_A:2112:22235: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_G_A_0005; voice_prefix=B10; voice_category=5; scene=WIK_G_A
#: WIK_G_A:2112
msgctxt "text_id=22235 | speaker=kojika"
msgid "\"H-Housuke?!\""
msgstr "「ほ、芳助ぇぇーーーーえ！？」"

#. Occurrence WIK_G_A:2240:22236: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_G_A_0007; voice_prefix=A10; voice_category=1; scene=WIK_G_A
#: WIK_G_A:2240
msgctxt "text_id=22236 | speaker=aoko"
msgid "\"It seems 'crazy' is right...\""
msgstr "「……<本気|マジ>のようね」"

#. Occurrence WIK_G_A:2252:22237: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0013; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:2252
msgctxt "text_id=22237 | speaker=alice"
msgid "\"Thanks to Kinomi, the Ploy's rules are clear now."
msgstr "「木乃美君のおかげでよりルールが見えてきたわ。"

#. Occurrence WIK_G_A:2258:22238: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0014; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:2258
msgctxt "text_id=22238 | speaker=alice"
msgid "  Laughing of your own accord doesn't count; neither does insincere laughter."
msgstr "　自分から笑う分にはノーカウントで、愛想笑いも除外。"

#. Occurrence WIK_G_A:2264:22239: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0015; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:2264
msgctxt "text_id=22239 | speaker=alice"
msgid "  However, laugh from the gut about another person's words, actions, or tricks, and you're out.\""
msgstr "　でも人の言動や仕掛けで、心の底から笑ってしまったらアウトと判断されるのね」"

#. Occurrence WIK_G_A:2274:22240: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_G_A_0006; voice_prefix=B10; voice_category=5; scene=WIK_G_A
#: WIK_G_A:2274
msgctxt "text_id=22240 | speaker=kojika"
msgid "\"Uh... what?\""
msgstr "「え……え？」"

#. Occurrence WIK_G_A:2294:22241: scene=WIK_G_A
#: WIK_G_A:2294
msgctxt "text_id=22241 | speaker=unknown"
msgid "  I had no idea what was going on."
msgstr "　ちょっと、本気で、意味が分からない。"

#. Occurrence WIK_G_A:2299:22242: scene=WIK_G_A
#: WIK_G_A:2299
msgctxt "text_id=22242 | speaker=unknown"
msgid "  Laugh and you die? Really?"
msgstr "　笑わされたら死ぬって、はい？"

#. Occurrence WIK_G_A:2304:22243: scene=WIK_G_A
#: WIK_G_A:2304
msgctxt "text_id=22243 | speaker=unknown"
msgid "  I knew Miss Kuonji wasn't exactly normal, but I didn't know she was insane... Then again, two people died in front of me after bursting out laughing, so was it true after all?"
msgstr "　久遠寺さん、ちょっと普通じゃないと思ったけど、本気で電波な人だった？　いや、でも実際、爆笑して死亡したのが目の前に二人もいて、じゃあなに、これって本当の話なの？"

#. Occurrence WIK_G_A:2344:22244: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_G_A_0009; voice_prefix=B40; voice_category=8; scene=WIK_G_A
#: WIK_G_A:2344
msgctxt "text_id=22244 | speaker=eiri"
msgid "\"So you're saying that a Ploy Kickshaw is active."
msgstr "「プロイキッシャーが稼働している、というのですか。"

#. Occurrence WIK_G_A:2355:22245: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_G_A_0010; voice_prefix=B40; voice_category=8; scene=WIK_G_A
#: WIK_G_A:2355
msgctxt "text_id=22245 | speaker=eiri"
msgid "  But, if that's so, why hasn't Sister Yuika noticed?\""
msgstr "　しかし、そんな魔力の流れがあるのならシスター唯架に気付かれない筈がありません」"

#. Occurrence WIK_G_A:2368:22246: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0016_0; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:2368
msgctxt "text_id=22246 | speaker=alice"
msgid "\"This Ploy has perfect camouflage."
msgstr "「これは完全潜行型のプロイ。"

#. Occurrence WIK_G_A:2382:22247: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0016_1; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:2382
msgctxt "text_id=22247 | speaker=alice"
msgid " That and Yuika―\""
msgstr "それに、唯架さん」"

#. Occurrence WIK_G_A:2406:22248: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_G_A_0000; voice_prefix=B20; voice_category=10; scene=WIK_G_A
#: WIK_G_A:2406
msgctxt "text_id=22248 | speaker=yuika"
msgid "\"Right. I couldn't even attempt to measure the amount of magical energy within the Kuonji Estate. We're inside an enormous Mystic as it is. Measuring the flow of energy became impossible the moment we stepped foot on this mountain.\""
msgstr "「はい。久遠寺邸の中で魔力の<多|た><寡|か>を測るのは馬鹿げています。エイリ神父、私たちは一つの巨大な神秘の中にいるのです。魔力の流れなんて、この山に入った時点で測りようがありません」"

#. Occurrence WIK_G_A:2420:22249: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_G_A_0011; voice_prefix=B40; voice_category=8; scene=WIK_G_A
#: WIK_G_A:2420
msgctxt "text_id=22249 | speaker=eiri"
msgid "\"You're right. Do pardon me. I seem to be a bit disoriented.\""
msgstr "「そうでしたね。……お恥ずかしい、私も混乱しているようです」"

#. Occurrence WIK_G_A:2440:22250: scene=WIK_G_A
#: WIK_G_A:2440
msgctxt "text_id=22250 | speaker=unknown"
msgid "  Being calm in this situation would be weirder."
msgstr "　いや、この状況で冷静である方がおかしい。"

#. Occurrence WIK_G_A:2445:22251: scene=WIK_G_A
#: WIK_G_A:2445
msgctxt "text_id=22251 | speaker=unknown"
msgid "  Father Eiri seemed cold at first glance, but maybe he's actually a more feeling person than I realized."
msgstr "　詠梨神父には冷たいイメージしかなかったけど、あの人、わりと真人間なのかもしれない。"

#. Occurrence WIK_G_A:2450:22252: scene=WIK_G_A
#: WIK_G_A:2450
msgctxt "text_id=22252 | speaker=unknown"
msgid "  But what on Earth was a Ploy?"
msgstr "　でもプロイってなに？"

#. Occurrence WIK_G_A:2455:22253: scene=WIK_G_A
#: WIK_G_A:2455
msgctxt "text_id=22253 | speaker=unknown"
msgid "  The conversation was starting to leave me in the dust."
msgstr "　事は完全に、わたしを置いてけぼりにして進んでいる。"

#. Occurrence WIK_G_A:2496:22254: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_G_A_0007; voice_prefix=B70; voice_category=4; scene=WIK_G_A
#: WIK_G_A:2496
msgctxt "text_id=22254 | speaker=tobimaru"
msgid "\"I have a question. I get that if someone makes you laugh, you die."
msgstr "「……ひとついいか？　笑わされたら死ぬ、ってのはいいよ。アンタの事だ、それぐらいあるかもしれねえ。"

#. Occurrence WIK_G_A:2508:22255: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_G_A_0008; voice_prefix=B70; voice_category=4; scene=WIK_G_A
#: WIK_G_A:2508
msgctxt "text_id=22255 | speaker=tobimaru"
msgid "  But why are people dying in different ways?"
msgstr "　だが死に方が一致しないのはどういう事だ？"

#. Occurrence WIK_G_A:2514:22256: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_G_A_0009; voice_prefix=B70; voice_category=4; scene=WIK_G_A
#: WIK_G_A:2514
msgctxt "text_id=22256 | speaker=tobimaru"
msgid "  Gramps, Riddell, Kinomi―all different. You said something about rules, but is it random?\""
msgstr "　爺さんもリデルも木乃美もそれぞれ違う死に方だ。ルールと言ったが、そこはランダムなのか？」"

#. Occurrence WIK_G_A:2540:22257: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0017; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:2540
msgctxt "text_id=22257 | speaker=alice"
msgid "\"Their deaths relate to their nature.\""
msgstr "「死に方は、その人の人間性によるわ」"

#. Occurrence WIK_G_A:2567:22258: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_G_A_0007; voice_prefix=B10; voice_category=5; scene=WIK_G_A
#: WIK_G_A:2567
msgctxt "text_id=22258 | speaker=kojika"
msgid "\"Their nature...? Like their issues, personality, and all that?\""
msgstr "「人間性……トラウマとか本質とか、そういうのを表すの？」"

#. Occurrence WIK_G_A:2578:22259: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0018; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:2578
msgctxt "text_id=22259 | speaker=alice"
msgid "\"Right. Even their hidden idiosyncrasies.\""
msgstr "「ええ。隠された<性癖|せいへき>も<暴露|ばくろ>されかねないわ」"

#. Occurrence WIK_G_A:2607:22260: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_G_A_0008; voice_prefix=A10; voice_category=1; scene=WIK_G_A
#: WIK_G_A:2607
msgctxt "text_id=22260 | speaker=aoko"
msgid "\"Oh, I get it now. I thought something was strange, but their deaths are also part of the design.\""
msgstr "「ああ、そういう事だったのね……ようやく合点がいった。いくらなんでもおかしいと思ったのよ。あの死に様はそういう<絡繰|カラクリ>だったのか……」"

#. Occurrence WIK_G_A:2633:22261: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_G_A_0001; voice_prefix=B30; voice_category=9; scene=WIK_G_A
#: WIK_G_A:2633
msgctxt "text_id=22261 | speaker=ritsuka"
msgid "\"Wow. So Kinomi must have really wanted to be rich to die in a shower of money...\""
msgstr "「……木乃美くん、札束まき散らして死ぬとか、どれだけゴージャスな人生を期待していたのかしら……」"

#. Occurrence WIK_G_A:2660:22262: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_G_A_0010; voice_prefix=B70; voice_category=4; scene=WIK_G_A
#: WIK_G_A:2660
msgctxt "text_id=22262 | speaker=tobimaru"
msgid "\"Ironically, money couldn't've saved him this time.\""
msgstr "「その札束もこれじゃあ救えねえがな」"

#. Occurrence WIK_G_A:2697:22263: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_G_A_0005; voice_prefix=A30; voice_category=3; scene=WIK_G_A
#: WIK_G_A:2697
msgctxt "text_id=22263 | speaker=soujuurou"
msgid "\"Riddell died a pretty normal death."
msgstr "「リデルは普通なんだな。"

#. Occurrence WIK_G_A:2708:22264: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_G_A_0006; voice_prefix=A30; voice_category=3; scene=WIK_G_A
#: WIK_G_A:2708
msgctxt "text_id=22264 | speaker=soujuurou"
msgid "  Knowing her, I expected her to transform into an airplane or a yacht or something.\""
msgstr "　彼女の事だから、俺はてっきり飛行機とかクルーザーに変形するかと思ったのに」"

#. Occurrence WIK_G_A:2759:22265: voice_id=BA0_WIK_G_A_0000; voice_prefix=BA0; voice_category=0; scene=WIK_G_A
#: WIK_G_A:2759
msgctxt "text_id=22265 | speaker=unknown"
msgid "\"Yeah, yeah! Riddell's all bark no bite! Vomiting claret and dying right then and there is balls! Even worse than Kinomi's death... All icing, no Sexton Blake!\""
msgstr "『そッスね、さすがリデルさん、見かけ倒し度がハンパないッス！　吐血して突然死とか、本気で地味すぎるっていうかぁ、木乃美のダンナ以下とか、これだから<三下|さんした>はデオチすぎて救えねぇーッス！』"

#. Occurrence WIK_G_A:2787:22266: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_G_A_0008_0; voice_prefix=B80; voice_category=13; scene=WIK_G_A
#: WIK_G_A:2787
msgctxt "text_id=22266 | speaker=liddell"
msgid "\""
msgstr "「"

msgctxt "text_id=22267 | speaker=unknown"
msgid "W... "
msgstr "だ、"

msgctxt "text_id=22268 | speaker=unknown"
msgid "Watch..."
msgstr "誰がっ、"

#. Occurrence WIK_G_A:2807:22269: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_G_A_0008_1; voice_prefix=B80; voice_category=13; scene=WIK_G_A
#: WIK_G_A:2807
msgctxt "text_id=22269 | speaker=liddell"
msgid "your..."
msgstr "三下、"

#. Occurrence WIK_G_A:2823:22270: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_G_A_0008_2; voice_prefix=B80; voice_category=13; scene=WIK_G_A
#: WIK_G_A:2823
msgctxt "text_id=22270 | speaker=liddell"
msgid "beak...!\""
msgstr "だっつーのっっっっ！」"

#. Occurrence WIK_G_A:2875:22271: voice_id=X60_WIK_G_A_0000; voice_prefix=X60; voice_category=0; scene=WIK_G_A
#: WIK_G_A:2875
msgctxt "text_id=22271 | speaker=unknown"
msgid "\"She's alive!\""
msgstr "「い、生き返ったぁ！？」"

#. Occurrence WIK_G_A:2920:22272: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_G_A_0009_0; voice_prefix=B80; voice_category=13; scene=WIK_G_A
#: WIK_G_A:2920
msgctxt "text_id=22272 | speaker=liddell"
msgid "\"Don't... "
msgstr "「"

msgctxt "text_id=22273 | speaker=unknown"
msgid "under―"
msgstr "舐めんじゃ、"

#. Occurrence WIK_G_A:2933:22274: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_G_A_0009_1; voice_prefix=B80; voice_category=13; scene=WIK_G_A
#: WIK_G_A:2933
msgctxt "text_id=22274 | speaker=liddell"
msgid "ungh... "
msgstr "ないわよ！　"

msgctxt "text_id=22275 | speaker=unknown"
msgid "underestimate me..."
msgstr "ぐっ、"

#. Occurrence WIK_G_A:2949:22276: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_G_A_0010_0; voice_prefix=B80; voice_category=13; scene=WIK_G_A
#: WIK_G_A:2949
msgctxt "text_id=22276 | speaker=liddell"
msgid "Stopping my heart..."
msgstr "心臓止まったぐらいで、"

#. Occurrence WIK_G_A:2960:22277: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_G_A_0010_1; voice_prefix=B80; voice_category=13; scene=WIK_G_A
#: WIK_G_A:2960
msgctxt "text_id=22277 | speaker=liddell"
msgid "unf..."
msgstr "うぐぅ、"

#. Occurrence WIK_G_A:2970:22278: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_G_A_0011_0; voice_prefix=B80; voice_category=13; scene=WIK_G_A
#: WIK_G_A:2970
msgctxt "text_id=22278 | speaker=liddell"
msgid "isn't... "
msgstr "死んで、"

msgctxt "text_id=22279 | speaker=unknown"
msgid "going to..."
msgstr "死んで"

#. Occurrence WIK_G_A:2980:22280: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_G_A_0011_1; voice_prefix=B80; voice_category=13; scene=WIK_G_A
#: WIK_G_A:2980
msgctxt "text_id=22280 | speaker=liddell"
msgid "STOP... "
msgstr "たまるもん、"

msgctxt "text_id=22281 | speaker=unknown"
msgid "ME!\""
msgstr "かっ！」"

#. Occurrence WIK_G_A:3002:22282: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_G_A_0000_0; voice_prefix=A50; voice_category=12; scene=WIK_G_A
#: WIK_G_A:3002
msgctxt "text_id=22282 | speaker=beo"
msgid "\"Whoa...! I didn't know humans could survive heart attacks just by being stubborn!"
msgstr "「うわあ……心停止を気合いで耐えた人類、初めて見ました……"

#. Occurrence WIK_G_A:3016:22283: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_G_A_0000_1; voice_prefix=A50; voice_category=12; scene=WIK_G_A
#: WIK_G_A:3016
msgctxt "text_id=22283 | speaker=beo"
msgid " Looks like you need better jokes to kill her.\""
msgstr "あの程度の笑いじゃ、リデルさんは殺せそうにありませんねー」"

#. Occurrence WIK_G_A:3056:22284: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_G_A_0007; voice_prefix=A30; voice_category=3; scene=WIK_G_A
#: WIK_G_A:3056
msgctxt "text_id=22284 | speaker=soujuurou"
msgid "\"Incredible. You'll have to teach me that trick sometime!\""
msgstr "「すごいな。今度、その<秘訣|ひけつ>を教えてほしい」"

#. Occurrence WIK_G_A:3068:22285: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0019; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:3068
msgctxt "text_id=22285 | speaker=alice"
msgid "\"I knew you'd come back from the dead, Riddell. Like a zombie.\""
msgstr "「ええ、完成されたゾンビのよう。わたしは信じていたわ、リデル」"

#. Occurrence WIK_G_A:3080:22286: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_G_A_0012; voice_prefix=B80; voice_category=13; scene=WIK_G_A
#: WIK_G_A:3080
msgctxt "text_id=22286 | speaker=liddell"
msgid "\"Hey! How about an apology?!"
msgstr "「ア、アンタたち、褒める前に謝るのが、先じゃない！？"

#. Occurrence WIK_G_A:3092:22287: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_G_A_0013; voice_prefix=B80; voice_category=13; scene=WIK_G_A
#: WIK_G_A:3092
msgctxt "text_id=22287 | speaker=liddell"
msgid "  Why not test your theory on that stupid werewolf over there?!"
msgstr "　だいたい、試すならそこの<人狼|ウェアウルフ>の方が適任でしょ！？"

#. Occurrence WIK_G_A:3092:22288: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_G_A_0013; voice_prefix=B80; voice_category=13; scene=WIK_G_A
#: WIK_G_A:3092
msgctxt "text_id=22288 | speaker=liddell"
msgid "  He resurrects no matter what! Why go for me?!\""
msgstr "　殺してもほっとけば生き返るんだから！　なんでアタシを狙い撃ちなのよ！」"

#. Occurrence WIK_G_A:3119:22289: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0020; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:3119
msgctxt "text_id=22289 | speaker=alice"
msgid "\"What do you mean 'why?' We're rivals, aren't we?"
msgstr "「え？　……だってわたしたち、ライバルなんでしょう？"

#. Occurrence WIK_G_A:3125:22290: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0021; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:3125
msgctxt "text_id=22290 | speaker=alice"
msgid "  Of course we'd try to kill each other.\""
msgstr "　なら、殺し合いをするのは当然だと思うけど」"

#. Occurrence WIK_G_A:3137:22291: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_G_A_0014; voice_prefix=B80; voice_category=13; scene=WIK_G_A
#: WIK_G_A:3137
msgctxt "text_id=22291 | speaker=liddell"
msgid "\"Uh... um... yeah... Yeah, of course!"
msgstr "「え……あ、うん、そうよ、ライバルってそういうものよ。"

#. Occurrence WIK_G_A:3149:22292: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_G_A_0015; voice_prefix=B80; voice_category=13; scene=WIK_G_A
#: WIK_G_A:3149
msgctxt "text_id=22292 | speaker=liddell"
msgid "  N-Not bad. You really took me by surprise. I underestimated you!\""
msgstr "　や、やるじゃない。隙あらば仕掛けてくるなんて、見直したわ」"

#. Occurrence WIK_G_A:3187:22293: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_G_A_0011; voice_prefix=B70; voice_category=4; scene=WIK_G_A
#: WIK_G_A:3187
msgctxt "text_id=22293 | speaker=tobimaru"
msgid "\"Figures she'd be the type to survive even if someone kills her. Damn.\""
msgstr "「やっぱりあの女、殺しても死なない系だったか。……たまんねえな」"

#. Occurrence WIK_G_A:3193:22294: scene=WIK_G_A
#: WIK_G_A:3193
msgctxt "text_id=22294 | speaker=unknown"
msgid "  Though clearly shocked by the girl in pink's horror show, Tsukiji was taking this way too well."
msgstr "　そんなピンク女のホラーショウを、槻司は呆れつつもすんなり受け入れていた。"

#. Occurrence WIK_G_A:3220:22295: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_G_A_0008; voice_prefix=B10; voice_category=5; scene=WIK_G_A
#: WIK_G_A:3220
msgctxt "text_id=22295 | speaker=kojika"
msgid "\"Um, Tsukiji? Don't you think this is weird? Someone just died, you know!"
msgstr "「……ちょっと槻司。アンタ、今のおかしいと思わないの？　人が死んだのよ？"

#. Occurrence WIK_G_A:3232:22296: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_G_A_0009; voice_prefix=B10; voice_category=5; scene=WIK_G_A
#: WIK_G_A:3232
msgctxt "text_id=22296 | speaker=kojika"
msgid "  And Housuke turned into confetti! Dying from laughter... I mean, what is all this? Am I dreaming?!\""
msgstr "　芳助とか紙吹雪になって死体もないのよ？　笑ったら死ぬとか、なんだっていうのよコレ？　もしかしてわたし、とっくに夢見ちゃってる？」"

#. Occurrence WIK_G_A:3258:22297: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_G_A_0012; voice_prefix=B70; voice_category=4; scene=WIK_G_A
#: WIK_G_A:3258
msgctxt "text_id=22297 | speaker=tobimaru"
msgid "\"Calm down. I don't want to believe this is happening, but it is."
msgstr "「落ち着け、信じたくねえが現実だよ。"

#. Occurrence WIK_G_A:3269:22298: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_G_A_0013; voice_prefix=B70; voice_category=4; scene=WIK_G_A
#: WIK_G_A:3269
msgctxt "text_id=22298 | speaker=tobimaru"
msgid "  Like Kuonji said, this mansion's another world now, with new rules. Riddell got caught out, but she resisted."
msgstr "　久遠寺の言う通り、この洋館はそういうルールの世界になって、リデルはそれに引っかかったが、自力でルールに抵抗したってワケだ。"

#. Occurrence WIK_G_A:3280:22299: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_G_A_0014; voice_prefix=B70; voice_category=4; scene=WIK_G_A
#: WIK_G_A:3280
msgctxt "text_id=22299 | speaker=tobimaru"
msgid "  I know it all sounds crazy, but Kuonji and Riddell can do some crazy things.\""
msgstr "　頭の痛いことだが、久遠寺とリデルはその手のオカルトがアリな奴らなんだよ」"

#. Occurrence WIK_G_A:3306:22300: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_G_A_0015; voice_prefix=B70; voice_category=4; scene=WIK_G_A
#: WIK_G_A:3306
msgctxt "text_id=22300 | speaker=tobimaru"
msgid "\"I don't know exactly what they can do, but that's probably for the best. I just know from watching them, they're the real deal. Trust me on this.\""
msgstr "「俺も具体的には知らねえけどな。というか、踏みこんだら巻きこまれる。ギリギリ外から眺めた結果、あの二人が本物だと判断した。今はそれで納得しとけ」"

#. Occurrence WIK_G_A:3332:22301: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_G_A_0010; voice_prefix=B10; voice_category=5; scene=WIK_G_A
#: WIK_G_A:3332
msgctxt "text_id=22301 | speaker=kojika"
msgid "\"Trust you?! Housuke is dead!\""
msgstr "「納得できないっ、だって芳助死んじゃったのよ！？」"

#. Occurrence WIK_G_A:3341:22302: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0022; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:3341
msgctxt "text_id=22302 | speaker=alice"
msgid "\"Miss Kumari. You shouldn't mourn Kinomi just yet."
msgstr "「久万梨さん。木乃美君の死を悲しむのはまだ早いわ。"

#. Occurrence WIK_G_A:3341:22303: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0022; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:3341
msgctxt "text_id=22303 | speaker=alice"
msgid "  He and Tokie simply triggered the Ploy and now they're 'out.' In reality, they're just missing."
msgstr "　彼やトッキィーはアウト扱いで退場しただけ。現実ではまだ“行方不明”状態よ。"

#. Occurrence WIK_G_A:3352:22304: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0023; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:3352
msgctxt "text_id=22304 | speaker=alice"
msgid "  If someone wins the game, then it will be rendered null, and everything will return to normal.\""
msgstr "　誰かがこのゲームをクリアすればゲーム内容はすべて<無効|むこう>扱いになって、彼らも元通りになるわ」"

#. Occurrence WIK_G_A:3378:22305: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_G_A_0011; voice_prefix=B10; voice_category=5; scene=WIK_G_A
#: WIK_G_A:3378
msgctxt "text_id=22305 | speaker=kojika"
msgid "\"They're not dead? Someone just needs to win the game?\""
msgstr "「……死んでない？　ゲームをクリアすれば、元通りになる、ですって……？」"

#. Occurrence WIK_G_A:3384:22306: scene=WIK_G_A
#: WIK_G_A:3384
msgctxt "text_id=22306 | speaker=unknown"
msgid "  I understood what Miss Kuonji is saying. But, for better or worse, I was a realist like Aozaki."
msgstr "　言っている意味は分かるけど、あいにく、わたしは蒼崎同様、現実主義だ。"

#. Occurrence WIK_G_A:3389:22307: scene=WIK_G_A
#: WIK_G_A:3389
msgctxt "text_id=22307 | speaker=unknown"
msgid "  This sci-fi and fantasy nonsense was too hard for me to swallow."
msgstr "　そんなＳＦ小説みたいな台詞、簡単には鵜呑みにできない。"

#. Occurrence WIK_G_A:3413:22308: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_G_A_0009; voice_prefix=A10; voice_category=1; scene=WIK_G_A
#: WIK_G_A:3413
msgctxt "text_id=22308 | speaker=aoko"
msgid "\"Relax, Kuma. I know where you're coming from, but listen to what we're saying."
msgstr "「クマ、落ち着いて。気持ちも信条も分かるけど、今は話を聞きましょう。"

#. Occurrence WIK_G_A:3424:22309: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_G_A_0010; voice_prefix=A10; voice_category=1; scene=WIK_G_A
#: WIK_G_A:3424
msgctxt "text_id=22309 | speaker=aoko"
msgid "  Alice, you should explain in more detail."
msgstr "　……有珠、もっと詳しく話して。"

#. Occurrence WIK_G_A:3430:22310: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_G_A_0011; voice_prefix=A10; voice_category=1; scene=WIK_G_A
#: WIK_G_A:3430
msgctxt "text_id=22310 | speaker=aoko"
msgid "  I get that this is the Ploy's doing, but what are the actual current rules? What do you mean by winning the game?\""
msgstr "　プロイの仕業なのは分かったけど、具体的にどういうルールになったの？　クリアってなに？」"

#. Occurrence WIK_G_A:3476:22311: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0024; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:3476
msgctxt "text_id=22311 | speaker=alice"
msgid "\"We're dealing with a probability-shifting Ploy."
msgstr "「このプロイは確率変動型のプロイなの。"

#. Occurrence WIK_G_A:3482:22312: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0025; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:3482
msgctxt "text_id=22312 | speaker=alice"
msgid "  Once the user's conditions are satisfied, it will activate and then operate for a full day. That's the 'game.'"
msgstr "　使用者が定めた条件が満たされたら発動して、あとはまる一日稼働し続ける。これが『ゲーム』。"

#. Occurrence WIK_G_A:3494:22313: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0026; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:3494
msgctxt "text_id=22313 | speaker=alice"
msgid "  During the game, a new rule will be added to the real world. In this case, dying when someone makes you laugh.\""
msgstr "　ゲーム中は現実世界に新しい『ルール』が一つ追加される。今回は『笑わされたら死ぬ』でしょうね」"

#. Occurrence WIK_G_A:3521:22314: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0027; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:3521
msgctxt "text_id=22314 | speaker=alice"
msgid "\"And don't even bother trying to escape. It's not possible. There are only two ways to end this."
msgstr "「また、ゲーム中は区域からの脱出は困難になる。この区域から脱出する方法は二つだけ。"

#. Occurrence WIK_G_A:3536:22315: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0028; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:3536
msgctxt "text_id=22315 | speaker=alice"
msgid "  The first is to expose the Ploy's user."
msgstr "　一つは誰がプロイの使用者なのか暴くこと。"

#. Occurrence WIK_G_A:3548:22316: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0029; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:3548
msgctxt "text_id=22316 | speaker=alice"
msgid "  However, we shouldn't point the finger at just anyone."
msgstr "　……でも軽率に犯人を指名するのは避けるべきね。"

#. Occurrence WIK_G_A:3554:22317: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0030; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:3554
msgctxt "text_id=22317 | speaker=alice"
msgid "  If the accuser is mistaken or lacks evidence, they'll be eliminated.\""
msgstr "　もし間違えていたり、証拠が欠けていた場合、犯人を指名した人物も“<消滅|アウト>”になるから」"

#. Occurrence WIK_G_A:3613:22318: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0031; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:3613
msgctxt "text_id=22318 | speaker=alice"
msgid "\"The other way is for any player other than the Ploy―even just one person―to survive until the end of the game."
msgstr "「もう一つはゲームが終わるまで、プロイ以外の参加者が一人でもいいから生き延びること。"

#. Occurrence WIK_G_A:3625:22319: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_G_A_0032; voice_prefix=A40; voice_category=2; scene=WIK_G_A
#: WIK_G_A:3625
msgctxt "text_id=22319 | speaker=alice"
msgid "  That's how you 'win' the game and bring all the victims back. Their memories of the game disappear, though.\""
msgstr "　このどちらでも『クリア』になるわ。クリアさえしてしまえば、何人犠牲者がでようと帳消し。みんな生き返って、ゲーム中の記憶は失う」"

#. Occurrence WIK_G_A:3690:22320: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_G_A_0001; voice_prefix=B20; voice_category=10; scene=WIK_G_A
#: WIK_G_A:3690
msgctxt "text_id=22320 | speaker=yuika"
msgid "\"...Well, that takes the pressure off. If we wait until dawn, we'll be fine.\""
msgstr "「……どうなる事かと思いましたが、それなら問題はありませんね。このまま夜が明けるのを待てばいいのですから」"

#. Occurrence WIK_G_A:3696:22321: scene=WIK_G_A
#: WIK_G_A:3696
msgctxt "text_id=22321 | speaker=unknown"
msgid "  The sister seemed relieved, but I wasn't. Not by a long shot."
msgstr "　シスターは安心したようだけど、わたしはそこまで楽観できない。"

#. Occurrence WIK_G_A:3701:22322: scene=WIK_G_A
#: WIK_G_A:3701
msgctxt "text_id=22322 | speaker=unknown"
msgid "  Maybe it was because I was having a hard time wrapping my head around the situation, but I felt so on edge."
msgstr "　状況がわたしの理解の範疇を超えている、というのもあるけど、どうしても不安がぬぐえない。"

#. Occurrence WIK_G_A:3706:22323: scene=WIK_G_A
#: WIK_G_A:3706
msgctxt "text_id=22323 | speaker=unknown"
msgid "  I..."
msgstr "　わたしは―――"

#. Occurrence WIK_SELECT_H:8:22324: scene=WIK_SELECT_H
#: WIK_SELECT_H:8
msgctxt "text_id=22324 | speaker=unknown"
msgid "-Decision H-"
msgstr "～選択肢Ｈ～"

#. Occurrence WIK_H_1:39:22325: scene=WIK_H_1
#: WIK_H_1:39
msgctxt "text_id=22325 | speaker=unknown"
msgid "  I thought about it, and concluded that Yurihiko Tokitsu's death was what we had to focus on now."
msgstr "　わたしは、土桔由里彦氏の死がネックだ、と思った。"

#. Occurrence WIK_H_2:39:22326: scene=WIK_H_2
#: WIK_H_2:39
msgctxt "text_id=22326 | speaker=unknown"
msgid "  I think it's easy enough to not laugh for one night."
msgstr "　わたしは、一晩笑わないのなんて簡単、と思った。"

#. Occurrence WIK_H_3:39:22327: scene=WIK_H_3
#: WIK_H_3:39
msgctxt "text_id=22327 | speaker=unknown"
msgid "  I felt like it was about time I pointed out that we were still missing someone."
msgstr "　……わたしは、一人足りない事をそろそろ指摘すべきだろうか、と思った。"

#. Occurrence WIK_H_A:48:22328: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_H_A_0000; voice_prefix=B30; voice_category=9; scene=WIK_H_A
#: WIK_H_A:48
msgctxt "text_id=22328 | speaker=ritsuka"
msgid "\"I'm not convinced things will go so smoothly, Yui.\""
msgstr "「どうかしら。そうはいかないと思うわよ、唯ちゃん」"

#. Occurrence WIK_H_A:61:22329: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_H_A_0000; voice_prefix=B20; voice_category=10; scene=WIK_H_A
#: WIK_H_A:61
msgctxt "text_id=22329 | speaker=yuika"
msgid "\"What do you mean, Ritsuka?\""
msgstr "「？　律架、それはどういう―――」"

#. Occurrence WIK_H_A:88:22330: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_H_A_0001; voice_prefix=B30; voice_category=9; scene=WIK_H_A
#: WIK_H_A:88
msgctxt "text_id=22330 | speaker=ritsuka"
msgid "\"Kinomi and Miss Riddell aside, it's possible someone forced Mr. Tokitsu to laugh."
msgstr "「木乃美くんやリデルさんはともかく、土桔さんは無理やり誰かに笑わされた可能性があるんだから。"

#. Occurrence WIK_H_A:99:22331: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_H_A_0002; voice_prefix=B30; voice_category=9; scene=WIK_H_A
#: WIK_H_A:99
msgctxt "text_id=22331 | speaker=ritsuka"
msgid "  And remember what Allie said? The user decides the rules. This Ploy didn't start by itself; someone activated it.\""
msgstr "　それにアッちゃんはこう言ったわ。<使|・><用|・><者|・><が|・><定|・><め|・><た|・><条|・><件|・>だって。このプロイは事故で起動したんじゃなくて、誰かが意図的に起動させたって事でしょう？」"

#. Occurrence WIK_H_A:126:22332: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_H_A_0001; voice_prefix=B20; voice_category=10; scene=WIK_H_A
#: WIK_H_A:126
msgctxt "text_id=22332 | speaker=yuika"
msgid "\"You mean...\""
msgstr "「では……」"

#. Occurrence WIK_H_A:135:22333: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_H_A_0000; voice_prefix=A10; voice_category=1; scene=WIK_H_A
#: WIK_H_A:135
msgctxt "text_id=22333 | speaker=aoko"
msgid "\"...The culprit is still at large."
msgstr "「……犯人がいるってコト。"

#. Occurrence WIK_H_A:141:22334: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_H_A_0001; voice_prefix=A10; voice_category=1; scene=WIK_H_A
#: WIK_H_A:141
msgctxt "text_id=22334 | speaker=aoko"
msgid "  We still don't know who they are. But seeing as they created the rules, they're probably going to try to make us laugh however they can.\""
msgstr "　そいつが誰かは分からないけど、こんなルールを作った以上、なんとしても私たちを笑わせようとするんじゃない？」"

#. Occurrence WIK_H_A:167:22335: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_H_A_0002; voice_prefix=A10; voice_category=1; scene=WIK_H_A
#: WIK_H_A:167
msgctxt "text_id=22335 | speaker=aoko"
msgid "\"They might not even need to go that far, actually."
msgstr "「いえ、そうでなくても犠牲者は出るかもしれない。"

#. Occurrence WIK_H_A:178:22336: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_H_A_0003; voice_prefix=A10; voice_category=1; scene=WIK_H_A
#: WIK_H_A:178
msgctxt "text_id=22336 | speaker=aoko"
msgid "  I hate to say it, but in mystery novels the guests often end up tearing each other apart out of suspicion.\""
msgstr "　……こんなコト言いたくないけど。疑心暗鬼から来客たちが自滅しあうのはミステリの定番でしょ、律架」"

#. Occurrence WIK_H_A:206:22337: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_H_A_0003; voice_prefix=B30; voice_category=9; scene=WIK_H_A
#: WIK_H_A:206
msgctxt "text_id=22337 | speaker=ritsuka"
msgid "\"Yes! Bang on, Aoko!"
msgstr "「そう、その通りなのです！　さっすがアコちゃん、分かってるぅ！"

#. Occurrence WIK_H_A:220:22338: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_H_A_0004; voice_prefix=B30; voice_category=9; scene=WIK_H_A
#: WIK_H_A:220
msgctxt "text_id=22338 | speaker=ritsuka"
msgid "  The nasty thing about this rule is that anyone can kill anyone. However, that also means we can survive without identifying the culprit."
msgstr "　このルールの底意地が悪いところは、殺害方法が犯人だけの特権ではない事よ。極論として、犯人を突き止めなくても生き残れる方法はある。"

#. Occurrence WIK_H_A:232:22339: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_H_A_0005; voice_prefix=B30; voice_category=9; scene=WIK_H_A
#: WIK_H_A:232
msgctxt "text_id=22339 | speaker=ritsuka"
msgid "  We only need to make sure no one else can make us laugh.\""
msgstr "　要は、他人に笑わせられなければいいんだから―――」"

#. Occurrence WIK_H_A:256:22340: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_H_A_0000; voice_prefix=B70; voice_category=4; scene=WIK_H_A
#: WIK_H_A:256
msgctxt "text_id=22340 | speaker=tobimaru"
msgid "\"Do unto others, before they do unto you."
msgstr "「やられる前にやれ。"

#. Occurrence WIK_H_A:262:22341: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_H_A_0001; voice_prefix=B70; voice_category=4; scene=WIK_H_A
#: WIK_H_A:262
msgctxt "text_id=22341 | speaker=tobimaru"
msgid "  You could remove everyone else to guarantee your own safety."
msgstr "　自分以外の人間を、先に消してしまえば安全だ。"

#. Occurrence WIK_H_A:268:22342: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_H_A_0002; voice_prefix=B70; voice_category=4; scene=WIK_H_A
#: WIK_H_A:268
msgctxt "text_id=22342 | speaker=tobimaru"
msgid "  Is that what you're saying?\""
msgstr "　……まとめるとこういう事ですか？」"

#. Occurrence WIK_H_A:294:22343: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_H_A_0003; voice_prefix=B70; voice_category=4; scene=WIK_H_A
#: WIK_H_A:294
msgctxt "text_id=22343 | speaker=tobimaru"
msgid "\"Okay, one: The mansion's now a world where you die if you laugh."
msgstr "「１．いま、洋館は笑うと死ぬ世界になっている。"

#. Occurrence WIK_H_A:300:22344: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_H_A_0004; voice_prefix=B70; voice_category=4; scene=WIK_H_A
#: WIK_H_A:300
msgctxt "text_id=22344 | speaker=tobimaru"
msgid "  Two: Person A made this happen."
msgstr "　２．その状況を望んだ人物Ａがいる。"

#. Occurrence WIK_H_A:306:22345: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_H_A_0005; voice_prefix=B70; voice_category=4; scene=WIK_H_A
#: WIK_H_A:306
msgctxt "text_id=22345 | speaker=tobimaru"
msgid "  Three: We can't rest until we figure out who the Person A is; they've already murdered Mr. Tokitsu, and they could kill again."
msgstr "　３．俺たちは、その人物Ａが誰なのかを見抜くまで安心できない。なぜなら、その人物Ａは既に土桔老人を殺害しており、他の人間を殺さない保証はないからである。"

#. Occurrence WIK_H_A:317:22346: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_H_A_0006; voice_prefix=B70; voice_category=4; scene=WIK_H_A
#: WIK_H_A:317
msgctxt "text_id=22346 | speaker=tobimaru"
msgid "  Four: We suspect anyone but ourselves and reveal the culprit, hold out until morning, or make everyone else laugh.\""
msgstr "　４．必然、俺たちは自分以外の人間を疑い、正体を暴くか、朝まで身を守るか、笑わせて消していくしかない、と」"

#. Occurrence WIK_H_A:371:22347: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_H_A_0000; voice_prefix=A40; voice_category=2; scene=WIK_H_A
#: WIK_H_A:371
msgctxt "text_id=22347 | speaker=alice"
msgid "\"Only one group can survive.\""
msgstr "「生き残れるのは、ただ一組」"

#. Occurrence WIK_H_A:389:22348: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_H_A_0000; voice_prefix=B80; voice_category=13; scene=WIK_H_A
#: WIK_H_A:389
msgctxt "text_id=22348 | speaker=liddell"
msgid "\"You think you're some badass, talking like that?!"
msgstr "「なに格好よくまとめてんのよアンタは！"

#. Occurrence WIK_H_A:401:22349: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_H_A_0001; voice_prefix=B80; voice_category=13; scene=WIK_H_A
#: WIK_H_A:401
msgctxt "text_id=22349 | speaker=liddell"
msgid "  Alice, what number Ploy is this?\""
msgstr "　アリス、これ何番のプロイ？」"

#. Occurrence WIK_H_A:413:22350: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_H_A_0001; voice_prefix=A40; voice_category=2; scene=WIK_H_A
#: WIK_H_A:413
msgctxt "text_id=22350 | speaker=alice"
msgid "\"Fifteen. It's a Ploy Kickshaw of magical reinforcement via charms, probability shifting, two minds in one body, and prayer.\""
msgstr "「十五番。<呪|まじな>いと確率変動、二心同体、願掛けによる魔力強化のプロイキッシャーよ」"

#. Occurrence WIK_H_A:439:22351: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_H_A_0002; voice_prefix=B80; voice_category=13; scene=WIK_H_A
#: WIK_H_A:439
msgctxt "text_id=22351 | speaker=liddell"
msgid "\"Oh, bollocks... that sounds like Sweets Hearts, all right."
msgstr "「あちゃあ……やっぱりスイーツハーツだったか。"

#. Occurrence WIK_H_A:450:22352: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_H_A_0003; voice_prefix=B80; voice_category=13; scene=WIK_H_A
#: WIK_H_A:450
msgctxt "text_id=22352 | speaker=liddell"
msgid "  Perfect, just perfect. How spineless do Japanese people have to be to use something like that?\""
msgstr "　最悪。あんなの使うヤツがいるなんて、どんだけ優柔不断なのよ日本人って」"

#. Occurrence WIK_H_A:475:22353: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_H_A_0004; voice_prefix=A10; voice_category=1; scene=WIK_H_A
#: WIK_H_A:475
msgctxt "text_id=22353 | speaker=aoko"
msgid "\"'Sweets Hearts'?"
msgstr "「スイーツハーツ……？"

#. Occurrence WIK_H_A:486:22354: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_H_A_0005; voice_prefix=A10; voice_category=1; scene=WIK_H_A
#: WIK_H_A:486
msgctxt "text_id=22354 | speaker=aoko"
msgid "  Is that this Ploy's name, Alice?\""
msgstr "　それがこのプロイの名前なの、有珠？」"

#. Occurrence WIK_H_A:526:22355: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_H_A_0004; voice_prefix=B80; voice_category=13; scene=WIK_H_A
#: WIK_H_A:526
msgctxt "text_id=22355 | speaker=liddell"
msgid "\"Yes. It creates rules, and boosts the survivor's magical energy; it's like a test-your-luck Ploy you use before a battle. Usually Sweets Hearts wins and everyone dies, though..."
msgstr "「イエス。一定のルールを作って、その中で生き延びたパーティーの魔力を向上させる、戦闘前の運試しみたいなプロイよ。たいていはみんな全滅してスイーツハーツの一人勝ち、生存者はいないってデスゲームだけど。"

#. Occurrence WIK_H_A:537:22356: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_H_A_0005; voice_prefix=B80; voice_category=13; scene=WIK_H_A
#: WIK_H_A:537
msgctxt "text_id=22356 | speaker=liddell"
msgid "  Very well, I shall be teaming up with Alice.\""
msgstr "　じゃ、アタシはアリスと組むから」"

#. Occurrence WIK_H_A:548:22357: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_H_A_0006; voice_prefix=A10; voice_category=1; scene=WIK_H_A
#: WIK_H_A:548
msgctxt "text_id=22357 | speaker=aoko"
msgid "\"Excuse me? Who said we're teaming up?\""
msgstr "「は？　何よ、その組むって」"

#. Occurrence WIK_H_A:595:22358: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_H_A_0006; voice_prefix=B80; voice_category=13; scene=WIK_H_A
#: WIK_H_A:595
msgctxt "text_id=22358 | speaker=liddell"
msgid "\"This is a fight for survival. The game is about trust and betrayal, so grouping up in pairs will give us the best chance of victory."
msgstr "「これはパーティーサバイバルなの。ゲームは二心同体、二人一組で挑んだ方が勝率はあがるわ。"

#. Occurrence WIK_H_A:601:22359: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_H_A_0007; voice_prefix=B80; voice_category=13; scene=WIK_H_A
#: WIK_H_A:601
msgctxt "text_id=22359 | speaker=liddell"
msgid "  Instead of running around trying to find the culprit, we should just try to make each other laugh. I mean, we all want to survive, don't we?\""
msgstr "　だって、最終的には面倒な犯人当てより、力ずくの笑わせ合いになるのは明白でしょう？　誰だって最後に生き残るのは自分でありたいんだし」"

#. Occurrence WIK_H_A:627:22360: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_H_A_0008; voice_prefix=B80; voice_category=13; scene=WIK_H_A
#: WIK_H_A:627
msgctxt "text_id=22360 | speaker=liddell"
msgid "\"Thus, Alice and I make the ultimate team. Alice never laughs, and I can be the joker."
msgstr "「その点、アタシとアリスなら絶対よ。アリスは笑わないし、アタシは<実力行使|パーティージョーク>を担当できるし。"

#. Occurrence WIK_H_A:638:22361: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_H_A_0009; voice_prefix=B80; voice_category=13; scene=WIK_H_A
#: WIK_H_A:638
msgctxt "text_id=22361 | speaker=liddell"
msgid "  Right, Alice?\""
msgstr "　ね、そうでしょうアリス？」"

#. Occurrence WIK_H_A:666:22362: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_H_A_0002; voice_prefix=A40; voice_category=2; scene=WIK_H_A
#: WIK_H_A:666
msgctxt "text_id=22362 | speaker=alice"
msgid "\"Hmm."
msgstr "「そうね。"

msgctxt "text_id=22363 | speaker=unknown"
msgid " Mind if I join you, Sizuki?\""
msgstr "静希君、お願いできる？」"

#. Occurrence WIK_H_A:687:22364: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_H_A_0000; voice_prefix=A30; voice_category=3; scene=WIK_H_A
#: WIK_H_A:687
msgctxt "text_id=22364 | speaker=soujuurou"
msgid "\"Sure. Based on what I've heard, you're the safest person to be with.\""
msgstr "「そうだね。聞いたかぎり、有珠なら安全だ」"

#. Occurrence WIK_H_A:699:22365: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_H_A_0010; voice_prefix=B80; voice_category=13; scene=WIK_H_A
#: WIK_H_A:699
msgctxt "text_id=22365 | speaker=liddell"
msgid "\"Whatever happened to kindness in this cruel world?!\""
msgstr "「優しさとかないの、アンタたちには！？」"

#. Occurrence WIK_H_A:747:22366: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_H_A_0000; voice_prefix=B40; voice_category=8; scene=WIK_H_A
#: WIK_H_A:747
msgctxt "text_id=22366 | speaker=eiri"
msgid "\"I see. Partner with someone you trust, someone you don't believe to be the culprit, and work together."
msgstr "「なるほど。自分が犯人ではないと思う、信じられる知人をパートナーにして協力しあうのですね。"

#. Occurrence WIK_H_A:758:22367: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_H_A_0001; voice_prefix=B40; voice_category=8; scene=WIK_H_A
#: WIK_H_A:758
msgctxt "text_id=22367 | speaker=eiri"
msgid "  Sister Yuika, would you mind?\""
msgstr "　シスター唯架、よろしいですか？」"

#. Occurrence WIK_H_A:769:22368: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_H_A_0002; voice_prefix=B20; voice_category=10; scene=WIK_H_A
#: WIK_H_A:769
msgctxt "text_id=22368 | speaker=yuika"
msgid "\"My pleasure. While this is frightening situation, you appear to be the most trustworthy person here.\""
msgstr "「そうですね。恐ろしい事ですが、この中でもっとも信用できるのはエイリ神父のようですから」"

#. Occurrence WIK_H_A:793:22369: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_H_A_0006; voice_prefix=B30; voice_category=9; scene=WIK_H_A
#: WIK_H_A:793
msgctxt "text_id=22369 | speaker=ritsuka"
msgid "\"Hey, what about me?"
msgstr "「えー、わたしはのけ者かー。"

#. Occurrence WIK_H_A:818:22370: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_H_A_0007; voice_prefix=B30; voice_category=9; scene=WIK_H_A
#: WIK_H_A:818
msgctxt "text_id=22370 | speaker=ritsuka"
msgid "  Want to partner up, Aoko?\""
msgstr "　アコちゃん、わたしと組むー？」"

#. Occurrence WIK_H_A:854:22371: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_H_A_0007; voice_prefix=A10; voice_category=1; scene=WIK_H_A
#: WIK_H_A:854
msgctxt "text_id=22371 | speaker=aoko"
msgid "\"Riddell. Let's pair up."
msgstr "「リデル、組みましょう。"

#. Occurrence WIK_H_A:854:22372: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_H_A_0007; voice_prefix=A10; voice_category=1; scene=WIK_H_A
#: WIK_H_A:854
msgctxt "text_id=22372 | speaker=aoko"
msgid "  Just for tonight, we should put everything behind us.\""
msgstr "　今夜だけは過去のことは水に流して」"

#. Occurrence WIK_H_A:865:22373: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_H_A_0008; voice_prefix=B30; voice_category=9; scene=WIK_H_A
#: WIK_H_A:865
msgctxt "text_id=22373 | speaker=ritsuka"
msgid "\"Oh, come on! You can make peace with me, too!\""
msgstr "「流しましょう！　わたしの事も水に流しましょう！」"

#. Occurrence WIK_H_A:894:22374: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_H_A_0011; voice_prefix=B80; voice_category=13; scene=WIK_H_A
#: WIK_H_A:894
msgctxt "text_id=22374 | speaker=liddell"
msgid "\"Hmph. Fine."
msgstr "「……ふん。いいわよ、好きにして。"

#. Occurrence WIK_H_A:905:22375: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_H_A_0012; voice_prefix=B80; voice_category=13; scene=WIK_H_A
#: WIK_H_A:905
msgctxt "text_id=22375 | speaker=liddell"
msgid "  If push comes to shove, we can just demolish the mansion.\""
msgstr "　いざとなれば、ふたりで洋館ごと木っ端微塵よ」"

#. Occurrence WIK_H_A:943:22376: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_H_A_0007; voice_prefix=B70; voice_category=4; scene=WIK_H_A
#: WIK_H_A:943
msgctxt "text_id=22376 | speaker=tobimaru"
msgid "\"Makes sense so far. How about it, Kumari? Just two regular Joes with common sense.\""
msgstr "「自然な流れだな。んじゃあまあ、常識人らしく俺たちは俺たちで組むか、久万梨」"

#. Occurrence WIK_H_A:955:22377: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_H_A_0000; voice_prefix=B10; voice_category=5; scene=WIK_H_A
#: WIK_H_A:955
msgctxt "text_id=22377 | speaker=kojika"
msgid "\"...!\""
msgstr "「っ」"

#. Occurrence WIK_H_A:982:22378: scene=WIK_H_A
#: WIK_H_A:982
msgctxt "text_id=22378 | speaker=unknown"
msgid "  I-I didn't see that coming!"
msgstr "　よ、予想外の展開になった……！"

#. Occurrence WIK_H_A:987:22379: scene=WIK_H_A
#: WIK_H_A:987
msgctxt "text_id=22379 | speaker=unknown"
msgid "  All the weirdness and murder mysteries were bad enough, but now this?!"
msgstr "　さっきの屋根裏といい、事態は最悪だけど、状況はとんでもない方向に動いている。"

#. Occurrence WIK_H_A:1011:22380: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_H_A_0000_0; voice_prefix=A50; voice_category=12; scene=WIK_H_A
#: WIK_H_A:1011
msgctxt "text_id=22380 | speaker=beo"
msgid "\"Hmm. Well, if I can't be with Soujyuro, then I don't need anyone else."
msgstr "「んー、草十郎さんと組めないんなら、ボクはひとりでいいや。"

#. Occurrence WIK_H_A:1023:22381: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_H_A_0000_1; voice_prefix=A50; voice_category=12; scene=WIK_H_A
#: WIK_H_A:1023
msgctxt "text_id=22381 | speaker=beo"
msgid " This just playtime for me anyway.\""
msgstr "どうせ遊びだしさー」"

#. Occurrence WIK_H_A:1043:22382: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_H_A_0009; voice_prefix=B30; voice_category=9; scene=WIK_H_A
#: WIK_H_A:1043
msgctxt "text_id=22382 | speaker=ritsuka"
msgid "\"Aww, I guess that means I'm stuck with Mr. Yamasiro, then..."
msgstr "「あーん、残念。それじゃあわたしは山城先生と……"

#. Occurrence WIK_H_A:1056:22383: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_H_A_0010; voice_prefix=B30; voice_category=9; scene=WIK_H_A
#: WIK_H_A:1056
msgctxt "text_id=22383 | speaker=ritsuka"
msgid "  Huh?\""
msgstr "　あれ？」"

#. Occurrence WIK_H_A:1087:22384: scene=WIK_H_A
#: WIK_H_A:1087
msgctxt "text_id=22384 | speaker=unknown"
msgid "  We all looked at each other."
msgstr "　全員が顔を合わせる。"

#. Occurrence WIK_H_A:1092:22385: scene=WIK_H_A
#: WIK_H_A:1092
msgctxt "text_id=22385 | speaker=unknown"
msgid "  I'd been wondering when someone would notice: Mr. Yamasiro had been missing for a while."
msgstr "　そう。そろそろ誰かが気付くと思っていたけど、ずいぶん前から山城先生の姿はなかったのだ。"

#. Occurrence WIK_I:38:22386: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_I_0000_0; voice_prefix=A30; voice_category=3; scene=WIK_I
#: WIK_I:38
msgctxt "text_id=22386 | speaker=soujuurou"
msgid "\"Hmm. I've been in the mansion most of the time. Been too busy preparing for the party to really talk to anyone."
msgstr "「うーん。ほとんど屋敷にいたんだけど、パーティーの準備が忙しくてあまりみんなと話していないな。"

#. Occurrence WIK_I:52:22387: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_I_0000_1; voice_prefix=A30; voice_category=3; scene=WIK_I
#: WIK_I:52
msgctxt "text_id=22387 | speaker=soujuurou"
msgid " Mainly because a certain duo didn't want to help."
msgstr "誰かさんと誰かさんが手伝ってくれないから。"

#. Occurrence WIK_I:64:22388: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_I_0001; voice_prefix=A30; voice_category=3; scene=WIK_I
#: WIK_I:64
msgctxt "text_id=22388 | speaker=soujuurou"
msgid "  Aside from that, I was mostly in the drawing room."
msgstr "　それはともかくとして、基本的には居間にいたよ。"

#. Occurrence WIK_I:71:22389: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_I_0002_0; voice_prefix=A30; voice_category=3; scene=WIK_I
#: WIK_I:71
msgctxt "text_id=22389 | speaker=soujuurou"
msgid "  I did go shopping and tend to the garden, but that was earlier in the afternoon."
msgstr "　買い出しとか庭の手入れもしたけど、あれは午後だったかな。"

#. Occurrence WIK_I:85:22390: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_I_0002_1; voice_prefix=A30; voice_category=3; scene=WIK_I
#: WIK_I:85
msgctxt "text_id=22390 | speaker=soujuurou"
msgid "When I returned to my room in the evening, Mr. Tokitsu was already dead.\""
msgstr "夕方になって部屋に戻ったら、土桔さんがたいへんなことに」"

#. Occurrence WIK_I:123:22391: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_I_0000; voice_prefix=A40; voice_category=2; scene=WIK_I
#: WIK_I:123
msgctxt "text_id=22391 | speaker=alice"
msgid "\"As for me... Nobody else was on hand, so I locked the west wing myself before Tokie arrived."
msgstr "「わたしは……そうね。人手がなかったから、トッキィーが来る前に自分で西館の施錠をすませて居間に移動したわ。"

#. Occurrence WIK_I:135:22392: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_I_0001; voice_prefix=A40; voice_category=2; scene=WIK_I
#: WIK_I:135
msgctxt "text_id=22392 | speaker=alice"
msgid "  The west wing contains many rooms that are off-limits, including the Ploy vault."
msgstr "　プロイの保管庫を含めて、西館には立ち入り禁止の部屋が多いから。"

#. Occurrence WIK_I:147:22393: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_I_0002; voice_prefix=A40; voice_category=2; scene=WIK_I
#: WIK_I:147
msgctxt "text_id=22393 | speaker=alice"
msgid "  From there, I went to the drawing room to look after the guests; I couldn't tell you who left their seat or for how long.\""
msgstr "　それからはずっと居間でゲストの様子を見ていたけど、誰がいつ、どのくらい席を立っていたかまでは把握していないわ」"

#. Occurrence WIK_I:185:22394: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_I_0000; voice_prefix=B10; voice_category=5; scene=WIK_I
#: WIK_I:185
msgctxt "text_id=22394 | speaker=kojika"
msgid "\"My story's the same as Aozaki's, but I guess I should tell you anyway."
msgstr "「わたしも蒼崎と同じだけど、一応証言はしとく。"

msgctxt "text_id=22395 | speaker=unknown"
msgid "  "
msgstr "　"

#. Occurrence WIK_I:198:22396: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_I_0001; voice_prefix=B10; voice_category=5; scene=WIK_I
#: WIK_I:198
msgctxt "text_id=22396 | speaker=kojika"
msgid "  I met up with Aozaki and Mr. Yamasiro at one in the afternoon, and arrived at the Kuonji Estate sometime after two."
msgstr "　午後イチに蒼崎、山城先生と合流して、午後二時過ぎに久遠寺邸に到着。"

#. Occurrence WIK_I:210:22397: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_I_0002; voice_prefix=B10; voice_category=5; scene=WIK_I
#: WIK_I:210
msgctxt "text_id=22397 | speaker=kojika"
msgid "  I took a short break in my room from 3:30 to 4:00."
msgstr "　客室で一度休憩をとったのが三時半から四時。"

#. Occurrence WIK_I:222:22398: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_I_0003; voice_prefix=B10; voice_category=5; scene=WIK_I
#: WIK_I:222
msgctxt "text_id=22398 | speaker=kojika"
msgid "  I remember the priest and the sisters coming to the foyer at around four o'clock."
msgstr "　四時にロビーに神父さんたちがやってきたのを覚えています。"

#. Occurrence WIK_I:235:22399: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_I_0004; voice_prefix=B10; voice_category=5; scene=WIK_I
#: WIK_I:235
msgctxt "text_id=22399 | speaker=kojika"
msgid "Oh, also... while I was napping, I thought I heard laughter, but it might've been my imagination. Don't read into it too much. Might make things confusing.\""
msgstr "あ……あと、そうだ。仮眠中、誰かの笑い声が聞こえた気がするけど、気のせいかもしれないし、これは推理の材料にしないで。混乱させるだけだわ」"

#. Occurrence WIK_I:268:22400: scene=WIK_I
#: WIK_I:268
msgctxt "text_id=22400 | speaker=unknown"
msgid "  I..."
msgstr "　わたしは、"

#. Occurrence WIK_SELECT_J:8:22401: scene=WIK_SELECT_J
#: WIK_SELECT_J:8
msgctxt "text_id=22401 | speaker=unknown"
msgid "-Decision J-"
msgstr "～選択肢Ｊ～"

#. Occurrence WIK_J:38:22402: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_J_0000; voice_prefix=B40; voice_category=8; scene=WIK_J
#: WIK_J:38
msgctxt "text_id=22402 | speaker=eiri"
msgid "\"After I finished my work in the afternoon, I made my way to the mansion, like Aoko's invitation said I should do, with no fuss."
msgstr "「私は午後の業務を済ませ、青子からの招待状通り、平和的な出で立ちで洋館を目指しました。"

#. Occurrence WIK_J:50:22403: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_J_0001; voice_prefix=B40; voice_category=8; scene=WIK_J
#: WIK_J:50
msgctxt "text_id=22403 | speaker=eiri"
msgid "  I arrived at about 4 o'clock and had tea in the sunroom until Riddell charged in. I found out Mr. Tokitsu had been killed after that."
msgstr "　午後四時に洋館に到着し、サンルームでお茶をいただいているとリデルくんが乱入し、その後、土桔氏が殺害されている事が判明しました。"

#. Occurrence WIK_J:62:22404: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_J_0002; voice_prefix=B40; voice_category=8; scene=WIK_J
#: WIK_J:62
msgctxt "text_id=22404 | speaker=eiri"
msgid "  I haven't seen him once during my time here."
msgstr "　こちらに来てからは土桔氏と出会っていません。"

#. Occurrence WIK_J:74:22405: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_J_0003; voice_prefix=B40; voice_category=8; scene=WIK_J
#: WIK_J:74
msgctxt "text_id=22405 | speaker=eiri"
msgid "  I recall Mr. Yamasiro disappearing just before the Mr. Tokitsu incident came to light.\""
msgstr "　また、山城先生の姿が消えたのは土桔氏の事件が発覚する前だったと思います」"

#. Occurrence WIK_J:112:22406: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_J_0000; voice_prefix=B20; voice_category=10; scene=WIK_J
#: WIK_J:112
msgctxt "text_id=22406 | speaker=yuika"
msgid "\"I'm the same as Father Eiri."
msgstr "「私もエイリ神父と同じです。"

#. Occurrence WIK_J:125:22407: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_J_0001; voice_prefix=B20; voice_category=10; scene=WIK_J
#: WIK_J:125
msgctxt "text_id=22407 | speaker=yuika"
msgid "  I haven't left the drawing room since arriving here.\""
msgstr "　この屋敷に到着してから事件が起きるまで、一度も居間から離れてはいません」"

#. Occurrence WIK_J:163:22408: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_J_0000; voice_prefix=B30; voice_category=9; scene=WIK_J
#: WIK_J:163
msgctxt "text_id=22408 | speaker=ritsuka"
msgid "\"I-I, umm...I left my seat a few times, to use the restroom and explore the mansion."
msgstr "「わ、わたしは……あっちゃあ、何度か席を立っちゃったなあ。おトイレと、ちょっと洋館探索に。"

#. Occurrence WIK_J:175:22409: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_J_0001; voice_prefix=B30; voice_category=9; scene=WIK_J
#: WIK_J:175
msgctxt "text_id=22409 | speaker=ritsuka"
msgid "  I-I mean, how often does Allie invite people over? There are so many rare magical trinkets to appreciate! So I took a little self-guided tour, but everything was locked up tight."
msgstr "　だ、だってアッちゃんが家にあげてくれるなんて珍しいじゃない？　<魔術品|レアもの>も見たいなー、と歩き回ってたけど、案の定、どこもロックは完璧でした。"

#. Occurrence WIK_J:187:22410: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_J_0002; voice_prefix=B30; voice_category=9; scene=WIK_J
#: WIK_J:187
msgctxt "text_id=22410 | speaker=ritsuka"
msgid "  Oh, but I never went up to the second floor. That's the truth.\""
msgstr "　あ、でも二階には行ってないわよ。これは本当」"

#. Occurrence WIK_J:220:22411: scene=WIK_J
#: WIK_J:220
msgctxt "text_id=22411 | speaker=unknown"
msgid "  I..."
msgstr "　わたしは、"

#. Occurrence WIK_SELECT_K:8:22412: scene=WIK_SELECT_K
#: WIK_SELECT_K:8
msgctxt "text_id=22412 | speaker=unknown"
msgid "-Decision K-"
msgstr "～選択肢Ｋ～"

#. Occurrence WIK_K:73:22413: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_K_0000; voice_prefix=B10; voice_category=5; scene=WIK_K
#: WIK_K:73
msgctxt "text_id=22413 | speaker=kojika"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence WIK_K:113:22414: scene=WIK_K
#: WIK_K:113
msgctxt "text_id=22414 | speaker=unknown"
msgid "  The mood was a little tense, but there were no obvious contradictions between the alibis. The room grew silent."
msgstr "　細かな違和感はあれ、証言されたアリバイに大きな矛盾はなく、居間は沈黙に包まれた。"

#. Occurrence WIK_K:118:22415: scene=WIK_K
#: WIK_K:118
msgctxt "text_id=22415 | speaker=unknown"
msgid "  There wasn't enough evidence to pinpoint the time of Tokitsu's death."
msgstr "　土桔氏が殺害された時間は特定できない。"

#. Occurrence WIK_K:123:22416: scene=WIK_K
#: WIK_K:123
msgctxt "text_id=22416 | speaker=unknown"
msgid "  Nobody heard an explosion. And apparently, thanks to this Ploy Kickshaw nonsense, even rigor mortis wasn't a reliable indicator."
msgstr "　誰も爆発音を聞いていないし、プロイキッシャーとやらのせいで死後硬直の問題も、かなり曖昧になっているらしい。"

#. Occurrence WIK_K:146:22417: scene=WIK_K
#: WIK_K:146
msgctxt "text_id=22417 | speaker=unknown"
msgid "  Since there was no way to deduce the exact time of death by examining the body, we could only estimate it based on the last time Tokitsu and Mr. Yamasiro were seen."
msgstr "　死体の状態から犯行時間が特定できない以上、土桔氏と山城先生、二人がいつみんなの前からいなくなったか、で死亡時間を計るしかない。"

#. Occurrence WIK_K:186:22418: scene=WIK_K
#: WIK_K:186
msgctxt "text_id=22418 | speaker=unknown"
msgid "  Mr. Tokitsu likely died between 1:00PM and 6:00PM;"
msgstr "　土桔氏の死亡推定時刻は午後一時以降～午後六時まで。"

#. Occurrence WIK_K:194:22419: scene=WIK_K
#: WIK_K:194
msgctxt "text_id=22419 | speaker=unknown"
msgid "  Mr. Yamasiro, between 4:00PM and 8:00PM."
msgstr "　山城先生は午後四時から八時まで。"

#. Occurrence WIK_K:199:22420: scene=WIK_K
#: WIK_K:199
msgctxt "text_id=22420 | speaker=unknown"
msgid "  However, everyone was together at 7:00PM, so it had to have been sometime between 4:00PM and 7:00PM."
msgstr "　ただし、七時からは全員が集まっていたので、実際には四時から七時までの時間だろう。"

#. Occurrence WIK_K:246:22421: scene=WIK_K
#: WIK_K:246
msgctxt "text_id=22421 | speaker=unknown"
msgid "  Only three people had solid alibis: Miss Kuonji, Father Eiri, and Sister Yuika."
msgstr "　いずれの時間も、完全なアリバイがあるのは久遠寺さんと詠梨神父、シスター唯架だけ。"

#. Occurrence WIK_K:251:22422: scene=WIK_K
#: WIK_K:251
msgctxt "text_id=22422 | speaker=unknown"
msgid "  Tsukiji and I have alibis when it comes to Mr. Yamasiro, because we were both in the drawing room at the time."
msgstr "　山城先生に関してはわたしと槻司も完全にアリバイがある。二人とも居間にいたからだ。"

#. Occurrence WIK_K:287:22423: scene=WIK_K
#: WIK_K:287
msgctxt "text_id=22423 | speaker=unknown"
msgid "  Aozaki, Sizuki, and Beo... were unknowns."
msgstr "　蒼崎と静希とベオは……どうだっただろう、把握していない。"

#. Occurrence WIK_K:331:22424: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_K_0000; voice_prefix=A50; voice_category=12; scene=WIK_K
#: WIK_K:331
msgctxt "text_id=22424 | speaker=beo"
msgid "\"I think the most likely suspects are Aoko, Alice, and Ritsuka; they knew about the Ploy. The rest of us had never heard of this Sweets Hearts.\""
msgstr "「でも、怪しいのはプロイの事を知っているアオコとアリス、あとリツカだよね。だって僕ら、スイーツハーツなんて知らなかったんだし」"

#. Occurrence WIK_K:362:22425: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_K_0000; voice_prefix=B70; voice_category=4; scene=WIK_K
#: WIK_K:362
msgctxt "text_id=22425 | speaker=tobimaru"
msgid "\"Right. We should start by considering those who've known about it for a while."
msgstr "「そうだな。前もって知る機会があったかは別にして、まずはそこから検討しないとな。"

#. Occurrence WIK_K:373:22426: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_K_0001; voice_prefix=B70; voice_category=4; scene=WIK_K
#: WIK_K:373
msgctxt "text_id=22426 | speaker=tobimaru"
msgid "  There's a huge difference between them and the rest of us who learned about it today.\""
msgstr "　今日ここで知ったのか、はじめから知っていたのか。この違いは大きいぜ」"

#. Occurrence WIK_K:409:22427: scene=WIK_K
#: WIK_K:409
msgctxt "text_id=22427 | speaker=unknown"
msgid "  He was right. We needed to know when the Ploy was activated."
msgstr "　そう。問題は、いつプロイとやらを起動させたか、だ。"

#. Occurrence WIK_K:423:22428: scene=WIK_K
#: WIK_K:423
msgctxt "text_id=22428 | speaker=unknown"
msgid "  If it was me or Mr. Yamasiro, once we arrived at the mansion, we'd have needed to find Sweets Hearts and activate it without knowing what it was."
msgstr "　たとえばわたしや山城先生がスイーツハーツだとしたら、洋館にやってきてから、見も知らないスイーツハーツとやらを発見し、起動させなくてはならない。"

#. Occurrence WIK_K:428:22429: scene=WIK_K
#: WIK_K:428
msgctxt "text_id=22429 | speaker=unknown"
msgid "  Not impossible, but not realistic."
msgstr "　絶対にないとは言い切れないが、まず現実的ではない。"

#. Occurrence WIK_K:433:22430: scene=WIK_K
#: WIK_K:433
msgctxt "text_id=22430 | speaker=unknown"
msgid "  That would classify this game as type of murder mystery involving sudden crimes―"
msgstr "　この場合、このゲームは突発的な犯罪に分類される。"

#. Occurrence WIK_K:438:22431: scene=WIK_K
#: WIK_K:438
msgctxt "text_id=22431 | speaker=unknown"
msgid "  the kind of scenario where unexpected tragedies occurred one after another."
msgstr "　たまたま、が重なって起きてしまった悲劇という事だ。"

#. Occurrence WIK_K:491:22432: scene=WIK_K
#: WIK_K:491
msgctxt "text_id=22432 | speaker=unknown"
msgid "  On the other hand, if someone knew about the Ploy and had access to it anytime they wanted, that would make this a premeditated crime."
msgstr "　逆に、前もって知っていて、いつでも使用できる状態だったのなら、これは計画的な犯罪だ。"

#. Occurrence WIK_K:496:22433: scene=WIK_K
#: WIK_K:496
msgctxt "text_id=22433 | speaker=unknown"
msgid "  There was no need to figure out when the Ploy was found."
msgstr "　プロイをいつ見付けたかは推理しなくていい。"

#. Occurrence WIK_K:518:22434: scene=WIK_K
#: WIK_K:518
msgctxt "text_id=22434 | speaker=unknown"
msgid "  Person A would have already switched places with the Ploy and executed their plan at their leisure once everyone was gathered."
msgstr "　人物Ａは既にプロイと入れ替わっていて、あとはゆっくり、全員が揃ったタイミングでルールを発動させればいいのだから。"

#. Occurrence WIK_K:523:22435: scene=WIK_K
#: WIK_K:523
msgctxt "text_id=22435 | speaker=unknown"
msgid "  Currently, that was the most likely scenario."
msgstr "　今のところ、可能性はこちらの方が大きいだろう。"

#. Occurrence WIK_K:570:22436: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_K_0002; voice_prefix=B70; voice_category=4; scene=WIK_K
#: WIK_K:570
msgctxt "text_id=22436 | speaker=tobimaru"
msgid "\"If we assume the perpetrator knew about the Ploy from the start, that makes Aozaki a suspect."
msgstr "「はじめからプロイを知っている、という前提で絞るなら、怪しいのは蒼崎だな。"

#. Occurrence WIK_K:581:22437: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_K_0003; voice_prefix=B70; voice_category=4; scene=WIK_K
#: WIK_K:581
msgctxt "text_id=22437 | speaker=tobimaru"
msgid "  She had enough time to kill them both."
msgstr "　蒼崎なら両名を殺せる時間があった。"

#. Occurrence WIK_K:587:22438: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_K_0004; voice_prefix=B70; voice_category=4; scene=WIK_K
#: WIK_K:587
msgctxt "text_id=22438 | speaker=tobimaru"
msgid "  It would've been tough for Ritsuka to kill Yurihiko."
msgstr "　律架さんの場合、土桔爺さんの殺害は難しい。"

#. Occurrence WIK_K:598:22439: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_K_0005; voice_prefix=B70; voice_category=4; scene=WIK_K
#: WIK_K:598
msgctxt "text_id=22439 | speaker=tobimaru"
msgid "  Kuonji... was the only person in the drawing room the entire time, so she couldn't have done it.\""
msgstr "　久遠寺は……ずっと居間にいた唯一の人間だ、犯行にはおよべない」"

#. Occurrence WIK_K:623:22440: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_K_0000; voice_prefix=A10; voice_category=1; scene=WIK_K
#: WIK_K:623
msgctxt "text_id=22440 | speaker=aoko"
msgid "\"Can't deny that. I had more than enough chances to do it.\""
msgstr "「そうね。それは否定しないわ。その二人に関してなら、私はいくらでもやれるチャンスはあったでしょう」"

#. Occurrence WIK_K:636:22441: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_K_0000; voice_prefix=B20; voice_category=10; scene=WIK_K
#: WIK_K:636
msgctxt "text_id=22441 | speaker=yuika"
msgid "\"I knew it.\""
msgstr "「では、やはり」"

#. Occurrence WIK_K:663:22442: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_K_0001; voice_prefix=A10; voice_category=1; scene=WIK_K
#: WIK_K:663
msgctxt "text_id=22442 | speaker=aoko"
msgid "\"What's *that* supposed to mean?"
msgstr "「やはりって何よ、やはりって。"

#. Occurrence WIK_K:675:22443: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_K_0002; voice_prefix=A10; voice_category=1; scene=WIK_K
#: WIK_K:675
msgctxt "text_id=22443 | speaker=aoko"
msgid "  I'm just saying it's possible. It's also possible somebody came to the mansion, found the Ploy, gobbled it up, and then turned into Sweets Hearts, right?"
msgstr "　あくまで可能性の話でしょ。それを言うなら、洋館にやってきて、すぐにプロイを発見して、勢い食べちゃって、それでスイーツハーツになっちゃった、って偶然もあるわけだし？"

#. Occurrence WIK_K:687:22444: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_K_0003; voice_prefix=A10; voice_category=1; scene=WIK_K
#: WIK_K:687
msgctxt "text_id=22444 | speaker=aoko"
msgid "  Don't be stupid. We're all suspicious to some degree here.\""
msgstr "　怪しさでいえばみんな同じよ。水掛論だわ」"

#. Occurrence WIK_K:714:22445: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_K_0001; voice_prefix=B20; voice_category=10; scene=WIK_K
#: WIK_K:714
msgctxt "text_id=22445 | speaker=yuika"
msgid "\"...Father Eiri and I have been cleared of guilt, though.\""
msgstr "「……私とエイリ神父は潔白だと証明されましたが」"

#. Occurrence WIK_K:726:22446: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_K_0004; voice_prefix=A10; voice_category=1; scene=WIK_K
#: WIK_K:726
msgctxt "text_id=22446 | speaker=aoko"
msgid "\"But how much do we really know about how you arrived at the mansion?"
msgstr "「アンタらがどんな経緯で洋館に来たかは不明よね？"

#. Occurrence WIK_K:738:22447: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_K_0005; voice_prefix=A10; voice_category=1; scene=WIK_K
#: WIK_K:738
msgctxt "text_id=22447 | speaker=aoko"
msgid "  Alice met you in the foyer because she heard your voices, didn't she? You can't prove where you were before that.\""
msgstr "　ロビーで話し声が聞こえたから有珠が出迎えたんでしょう？　それ以前、アンタらが何処にいたかなんて誰も証明できないじゃない」"

#. Occurrence WIK_K:766:22448: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_K_0000; voice_prefix=B30; voice_category=9; scene=WIK_K
#: WIK_K:766
msgctxt "text_id=22448 | speaker=ritsuka"
msgid "\"She's right. And it's also possible I'm conspiring with Father Eiri and Yui.\""
msgstr "「そうねえ。可能性でいうなら、詠梨さんと唯ちゃんとわたしが共謀してる、というのもアリだし」"

#. Occurrence WIK_K:778:22449: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_K_0002; voice_prefix=B20; voice_category=10; scene=WIK_K
#: WIK_K:778
msgctxt "text_id=22449 | speaker=yuika"
msgid "\"Ritsuka, whose side are you on?\""
msgstr "「姉さん。貴女はどちらの味方ですか」"

#. Occurrence WIK_K:804:22450: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_K_0001; voice_prefix=B30; voice_category=9; scene=WIK_K
#: WIK_K:804
msgctxt "text_id=22450 | speaker=ritsuka"
msgid "\"I'm on logic's side! I swear on my pride as a detective (fan) to remain totally impartial!"
msgstr "「わたしは論理の味方よ！　マニアの<矜持|きょうじ>に誓って、どちらにも肩入れはしないから！"

#. Occurrence WIK_K:816:22451: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_K_0002; voice_prefix=B30; voice_category=9; scene=WIK_K
#: WIK_K:816
msgctxt "text_id=22451 | speaker=ritsuka"
msgid "  Anyway, if we're focusing on who already knew about the Ploy, I can think of one other person that doesn't quite add up. Who wants to point her out?\""
msgstr "　んー、まあ、それはそれとして、プロイを知っている、って条件ならもう一人、とびきり不自然な<娘|こ>もいるんだけど。それは誰かが指摘するでしょう」"

#. Occurrence WIK_K:836:22452: scene=WIK_K
#: WIK_K:836
msgctxt "text_id=22452 | speaker=unknown"
msgid "  Aozaki and the sister glared at each other so intensely I thought I saw sparks flying."
msgstr "　無言で火花を散らすシスターと蒼崎。"

#. Occurrence WIK_K:841:22453: scene=WIK_K
#: WIK_K:841
msgctxt "text_id=22453 | speaker=unknown"
msgid "  They probably didn't get along even at the best of times."
msgstr "　あの二人は日頃から仲が悪いのだろう。"

#. Occurrence WIK_K:846:22454: scene=WIK_K
#: WIK_K:846
msgctxt "text_id=22454 | speaker=unknown"
msgid "  Given the situation, it's no wonder they were at each other's throats."
msgstr "　この状況では、もはや完全に敵同士だ。"

#. Occurrence WIK_K:888:22455: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_K_0000; voice_prefix=A40; voice_category=2; scene=WIK_K
#: WIK_K:888
msgctxt "text_id=22455 | speaker=alice"
msgid "\"Aoko. I wouldn't provoke Yuika if I were you. Given the current rules, she's our best trump card.\""
msgstr "「青子。あまり唯架さんを挑発しない方がいいと思うけど。今回のルールでは、彼女は最強の切り札なんだから」"

#. Occurrence WIK_K:899:22456: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_K_0006; voice_prefix=A10; voice_category=1; scene=WIK_K
#: WIK_K:899
msgctxt "text_id=22456 | speaker=aoko"
msgid "\"Wha? Don't you mean our greatest foe?\""
msgstr "「は？　最悪の敵、の間違いじゃない？」"

#. Occurrence WIK_K:911:22457: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_K_0001; voice_prefix=A40; voice_category=2; scene=WIK_K
#: WIK_K:911
msgctxt "text_id=22457 | speaker=alice"
msgid "\"No. She's in the safest position."
msgstr "「切り札よ。だってあの人、この中で一番安全だもの。"

#. Occurrence WIK_K:923:22458: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_K_0002; voice_prefix=A40; voice_category=2; scene=WIK_K
#: WIK_K:923
msgctxt "text_id=22458 | speaker=alice"
msgid "  Isn't that right, Yuika?\""
msgstr "　そうでしょう、唯架さん？」"

#. Occurrence WIK_K:949:22459: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_K_0003; voice_prefix=B20; voice_category=10; scene=WIK_K
#: WIK_K:949
msgctxt "text_id=22459 | speaker=yuika"
msgid "\"Yes. I literally do not know how to laugh."
msgstr "「ええ。私には笑いが分かりませんから。"

#. Occurrence WIK_K:955:22460: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_K_0004; voice_prefix=B20; voice_category=10; scene=WIK_K
#: WIK_K:955
msgctxt "text_id=22460 | speaker=yuika"
msgid "  Jokes don't work on me. I have no doubt that you'll be the first to self-destruct, Aoko.\""
msgstr "　冗談で笑う、なんて事はまずあり得ません。ですから、先に退場するのは青子さんの方でしょうね」"

#. Occurrence WIK_K:980:22461: scene=WIK_K
#: WIK_K:980
msgctxt "text_id=22461 | speaker=unknown"
msgid "  Kuonji appeared to have only meant it as a warning, but I could tell that the room was getting more tense."
msgstr "　久遠寺さんは場を<諫|いさ>めたつもりっぽいけど、空気はますます剣呑になっていった。"

#. Occurrence WIK_K:985:22462: scene=WIK_K
#: WIK_K:985
msgctxt "text_id=22462 | speaker=unknown"
msgid "  Just then, the blue robin appeared in front of Miss Kuonji."
msgstr "　そんな中、久遠寺さんの前に青い駒鳥が現れた。"

#. Occurrence WIK_K:1056:22463: scene=WIK_K
#: WIK_K:1056
msgctxt "text_id=22463 | speaker=unknown"
msgid "  It landed on the black table and started chirping."
msgstr "　黒いテーブルに着地すると、駒鳥はチチチ、と"

#. Occurrence WIK_K:1062:22464: voice_id=BA0_WIK_K_0000; voice_prefix=BA0; voice_category=0; scene=WIK_K
#: WIK_K:1062
msgctxt "text_id=22464 | speaker=unknown"
msgid "\"I knows the perp. Wanna hear it?\""
msgstr "『ジブン、ハンニン分かったんスけど、言っていいッスか？』"

#. Occurrence WIK_K:1067:22465: scene=WIK_K
#: WIK_K:1067
msgctxt "text_id=22465 | speaker=unknown"
msgid "  It tweeted."
msgstr "　鳴いた。"

#. Occurrence WIK_K:1146:22466: voice_id=BA0_WIK_K_0001; voice_prefix=BA0; voice_category=0; scene=WIK_K
#: WIK_K:1146
msgctxt "text_id=22466 | speaker=unknown"
msgid "\"Bwark?!\""
msgstr "『ブギャッ！？』"

#. Occurrence WIK_K:1151:22467: scene=WIK_K
#: WIK_K:1151
msgctxt "text_id=22467 | speaker=unknown"
msgid "  Miss Kuonji mercilessly squashed it with a karate chop."
msgstr "　久遠寺さんの手刀が、容赦なく青い鳥を粉砕した。"

#. Occurrence WIK_K:1164:22468: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_K_0003; voice_prefix=A40; voice_category=2; scene=WIK_K
#: WIK_K:1164
msgctxt "text_id=22468 | speaker=alice"
msgid "\"...Anyway..."
msgstr "「……ともかく。"

#. Occurrence WIK_K:1176:22469: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_K_0004; voice_prefix=A40; voice_category=2; scene=WIK_K
#: WIK_K:1176
msgctxt "text_id=22469 | speaker=alice"
msgid "  One funny line could be the end of you.\""
msgstr "　いつまでも笑い話と思っていると、全滅するわよ」"

#. Occurrence WIK_K:1200:22470: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_K_0001; voice_prefix=A50; voice_category=12; scene=WIK_K
#: WIK_K:1200
msgctxt "text_id=22470 | speaker=beo"
msgid "\"True. Anyone not named Yuika might want to find a good place to hide before it's too late.\""
msgstr "「そうだね。唯架さんはともかく、笑い上戸な人はどこかに隠れていた方がいいんじゃない？」"

#. Occurrence WIK_K:1226:22471: scene=WIK_K
#: WIK_K:1226
msgctxt "text_id=22471 | speaker=unknown"
msgid "  That made sense to me."
msgstr "　二人の意見はもっともだ。"

#. Occurrence WIK_K:1231:22472: scene=WIK_K
#: WIK_K:1231
msgctxt "text_id=22472 | speaker=unknown"
msgid "  I..."
msgstr "　わたしは、"

#. Occurrence WIK_SELECT_L:8:22473: scene=WIK_SELECT_L
#: WIK_SELECT_L:8
msgctxt "text_id=22473 | speaker=unknown"
msgid "-Decision L-"
msgstr "～選択肢Ｌ～"

#. Occurrence WIK_L_1:30:22474: scene=WIK_L_1
#: WIK_L_1:30
msgctxt "text_id=22474 | speaker=unknown"
msgid "  I felt that it was best..."
msgstr "　わたしは、"

#. Occurrence WIK_L_1:30:22475: scene=WIK_L_1
#: WIK_L_1:30
msgctxt "text_id=22475 | speaker=unknown"
msgid "  ...for everyone to stay in different guest rooms until morning."
msgstr "　それぞれ客室で朝まで過ごすべきでは、と思った。"

#. Occurrence WIK_L_1:66:22476: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_L_1_0000; voice_prefix=B20; voice_category=10; scene=WIK_L_1
#: WIK_L_1:66
msgctxt "text_id=22476 | speaker=yuika"
msgid "\"That's all there is to say."
msgstr "「話はここまでです。"

#. Occurrence WIK_L_1:77:22477: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_L_1_0001; voice_prefix=B20; voice_category=10; scene=WIK_L_1
#: WIK_L_1:77
msgctxt "text_id=22477 | speaker=yuika"
msgid "  There's no point in ratcheting up suspicions even further. We can resolve this, whether we know the culprit or not.\""
msgstr "　疑心暗鬼をこれ以上深める必要はないでしょう。犯人は分からずとも、解決する手段は明白なのですから」"

#. Occurrence WIK_L_1:83:22478: scene=WIK_L_1
#: WIK_L_1:83
msgctxt "text_id=22478 | speaker=unknown"
msgid "  Just like that, Sister Yuika took the reins."
msgstr "　ぴしゃり、と唯架さんが場を制する。"

#. Occurrence WIK_L_1:130:22479: scene=WIK_L_1
#: WIK_L_1:130
msgctxt "text_id=22479 | speaker=unknown"
msgid "  Nobody objected to her display of authority. Well, almost nobody. Ritsuka was sulking."
msgstr "　その迫力に誰も異論は……いや、律架さんだけはいじいじと拗ねているが、それ以外は誰も口を挟まない。"

#. Occurrence WIK_L_1:168:22480: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_L_1_0002; voice_prefix=B20; voice_category=10; scene=WIK_L_1
#: WIK_L_1:168
msgctxt "text_id=22480 | speaker=yuika"
msgid "\"Everyone, please spend the night in different guest rooms."
msgstr "「皆さんはそれぞれ客室で夜を過ごしてください。"

#. Occurrence WIK_L_1:174:22481: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_L_1_0003; voice_prefix=B20; voice_category=10; scene=WIK_L_1
#: WIK_L_1:174
msgctxt "text_id=22481 | speaker=yuika"
msgid "  Make sure to lock your doors and don't let anyone in until morning."
msgstr "　きちんと鍵をかけて、朝まで誰も入れないように。"

#. Occurrence WIK_L_1:180:22482: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_L_1_0004; voice_prefix=B20; voice_category=10; scene=WIK_L_1
#: WIK_L_1:180
msgctxt "text_id=22482 | speaker=yuika"
msgid "  Father Eiri, Ritsuka, and I will stand guard here, so if anything unusual happens, we'll come running.\""
msgstr "　私とエイリ神父、律架の三人はここで寝ずの番をしますので、何か異常があるようでしたら駆けつけます」"

#. Occurrence WIK_L_1:216:22483: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_L_1_0000; voice_prefix=A10; voice_category=1; scene=WIK_L_1
#: WIK_L_1:216
msgctxt "text_id=22483 | speaker=aoko"
msgid "\"...Good enough for me."
msgstr "「……まあ妥当なところね。"

#. Occurrence WIK_L_1:227:22484: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_L_1_0001; voice_prefix=A10; voice_category=1; scene=WIK_L_1
#: WIK_L_1:227
msgctxt "text_id=22484 | speaker=aoko"
msgid "  The suspect could be from the Church, but at least there's no chance Yuika's a Ploy.\""
msgstr "　教会組も犯人候補だけど、唯架さんだけはプロイである可能性はないんだし」"

#. Occurrence WIK_L_1:238:22485: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_L_1_0000; voice_prefix=A30; voice_category=3; scene=WIK_L_1
#: WIK_L_1:238
msgctxt "text_id=22485 | speaker=soujuurou"
msgid "\"Why is that?\""
msgstr "「それはなぜ？」"

#. Occurrence WIK_L_1:264:22486: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_L_1_0002; voice_prefix=A10; voice_category=1; scene=WIK_L_1
#: WIK_L_1:264
msgctxt "text_id=22486 | speaker=aoko"
msgid "\"She hates witches. No way she'd ever fall for a Ploy Kickshaw's sweet talk."
msgstr "「魔女嫌いの唯架さんは、プロイキッシャーの口車には乗らないでしょ。"

#. Occurrence WIK_L_1:275:22487: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_L_1_0003; voice_prefix=A10; voice_category=1; scene=WIK_L_1
#: WIK_L_1:275
msgctxt "text_id=22487 | speaker=aoko"
msgid "  Okay, we're done here. Everyone grab what you need, return to your rooms, and lock yourselves in until morning."
msgstr "　さ、そうと分かったら解散解散。各自、必要な物を手にしたら客室に戻って、朝まで籠城すること。"

#. Occurrence WIK_L_1:281:22488: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_L_1_0004; voice_prefix=A10; voice_category=1; scene=WIK_L_1
#: WIK_L_1:281
msgctxt "text_id=22488 | speaker=aoko"
msgid "  You'll just have to postpone your toilet breaks until tomorrow.\""
msgstr "　あと、トイレは物理的に我慢して」"

#. Occurrence WIK_L_1:317:22489: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_L_1_0000; voice_prefix=B10; voice_category=5; scene=WIK_L_1
#: WIK_L_1:317
msgctxt "text_id=22489 | speaker=kojika"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence WIK_L_1:323:22490: scene=WIK_L_1
#: WIK_L_1:323
msgctxt "text_id=22490 | speaker=unknown"
msgid "  The plan to hole up in our rooms was accepted before I could say anything."
msgstr "　わたしが切り出すまでもなく、<籠城|ろうじょう>案が可決された。"

#. Occurrence WIK_L_1:328:22491: scene=WIK_L_1
#: WIK_L_1:328
msgctxt "text_id=22491 | speaker=unknown"
msgid "  It did seem like the safest and simplest plan."
msgstr "　そりゃあ、これが一番安全かつ簡単な方針だろうけど。"

#. Occurrence WIK_L_1:364:22492: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_L_1_0001; voice_prefix=A30; voice_category=3; scene=WIK_L_1
#: WIK_L_1:364
msgctxt "text_id=22492 | speaker=soujuurou"
msgid "\"...I can't use my room, though."
msgstr "「……俺の部屋は使えないな。"

#. Occurrence WIK_L_1:375:22493: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_L_1_0002; voice_prefix=A30; voice_category=3; scene=WIK_L_1
#: WIK_L_1:375
msgctxt "text_id=22493 | speaker=soujuurou"
msgid "  Tobimaru, can I stay in yours?\""
msgstr "　鳶丸、そっちの客室に行っていいか？」"

#. Occurrence WIK_L_1:386:22494: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_L_1_0000; voice_prefix=B70; voice_category=4; scene=WIK_L_1
#: WIK_L_1:386
msgctxt "text_id=22494 | speaker=tobimaru"
msgid "\"Yeah. Kinomi's gone, so that's fine.\""
msgstr "「ああ、木乃美がいなくなったからな、ちょうどいい」"

#. Occurrence WIK_L_1:407:22495: scene=WIK_L_1
#: WIK_L_1:407
msgctxt "text_id=22495 | speaker=unknown"
msgid "  Tsukiji took some cookies and a pitcher of water from Sizuki, before heading begrudgingly for the foyer."
msgstr "　槻司は静希からクッキーやら水の入ったピッチャーやらを受け取って、やれやれとロビーに向かう。"

#. Occurrence WIK_L_1:447:22496: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_L_1_0001; voice_prefix=B10; voice_category=5; scene=WIK_L_1
#: WIK_L_1:447
msgctxt "text_id=22496 | speaker=kojika"
msgid "\"Hold on, Tsukiji! Are you really fine with this?!\""
msgstr "「ちょっと待って、槻司はそれでいいの！？」"

#. Occurrence WIK_L_1:458:22497: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_L_1_0001; voice_prefix=B70; voice_category=4; scene=WIK_L_1
#: WIK_L_1:458
msgctxt "text_id=22497 | speaker=tobimaru"
msgid "\"Hell no, but the majority's spoken. We're smothering the problem without solving it-gotta love democracy."
msgstr "「よくはねえが多数決なら仕方がねえ。問題を解決せずに封殺しちまうのは、民主主義の欠点だな。"

#. Occurrence WIK_L_1:469:22498: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_L_1_0002; voice_prefix=B70; voice_category=4; scene=WIK_L_1
#: WIK_L_1:469
msgctxt "text_id=22498 | speaker=tobimaru"
msgid "  Still, it's the obvious choice. If anything happens, shout for help. I'm on the second floor, so I got you covered.\""
msgstr "　しかしまあ、これも鉄板の選択だ。何かあったら大声で助けを呼んでくれや。俺も二階だから、すぐに駆けつけられる」"

#. Occurrence WIK_L_1:519:22499: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_1_0000; voice_prefix=B80; voice_category=13; scene=WIK_L_1
#: WIK_L_1:519
msgctxt "text_id=22499 | speaker=liddell"
msgid "\"Ugh. I never should've cancelled my concert."
msgstr "「あーあ、こんな事ならライブキャンセルするんじゃなかったわ。"

#. Occurrence WIK_L_1:531:22500: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_1_0001; voice_prefix=B80; voice_category=13; scene=WIK_L_1
#: WIK_L_1:531
msgctxt "text_id=22500 | speaker=liddell"
msgid "Alice, show me to my room. And by that, I mean *your* room, obviously; not a guest room."
msgstr "アリス、早く部屋に案内しなさいよ。もちろんゲストルームじゃなくて、アンタの部屋よ。"

#. Occurrence WIK_L_1:542:22501: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_1_0002; voice_prefix=B80; voice_category=13; scene=WIK_L_1
#: WIK_L_1:542
msgctxt "text_id=22501 | speaker=liddell"
msgid "  I know I can't expect a royal suite here, so I'll suffer the owner's room.\""
msgstr "　ここじゃロイヤルクラスなんて望むべくもないでしょ？　だから特別に、家主の部屋で妥協してあげるわ」"

#. Occurrence WIK_L_1:588:22502: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_L_1_0005; voice_prefix=A10; voice_category=1; scene=WIK_L_1
#: WIK_L_1:588
msgctxt "text_id=22502 | speaker=aoko"
msgid "\"I'll be in my bedroom. Nobody better come near it until morning.\""
msgstr "「私は自分の部屋にいるから。朝まで誰も近づいちゃダメよ」"

#. Occurrence WIK_L_1:602:22503: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_L_1_0000; voice_prefix=A50; voice_category=12; scene=WIK_L_1
#: WIK_L_1:602
msgctxt "text_id=22503 | speaker=beo"
msgid "\"I'll just sleep here. Wake me if anything happens.\""
msgstr "「ボクはここで寝てるよー。何かあったら起こしてね」"

#. Occurrence WIK_L_1:636:22504: scene=WIK_L_1
#: WIK_L_1:636
msgctxt "text_id=22504 | speaker=unknown"
msgid "  ...Everyone went their separate ways."
msgstr "　……みんな、思い思いの場所に移動していく。"

#. Occurrence WIK_L_1:641:22505: scene=WIK_L_1
#: WIK_L_1:641
msgctxt "text_id=22505 | speaker=unknown"
msgid "  Doubt still nagged at me, but I went to my assigned guest room for the time being."
msgstr "　わたしは釈然としないまま、自分用にあてがわれた客室に移動した。"

#. Occurrence WIK_L_1:690:22506: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_L_1_0002; voice_prefix=B10; voice_category=5; scene=WIK_L_1
#: WIK_L_1:690
msgctxt "text_id=22506 | speaker=kojika"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence WIK_L_1:696:22507: scene=WIK_L_1
#: WIK_L_1:696
msgctxt "text_id=22507 | speaker=unknown"
msgid "  I locked the door and lay on the bed."
msgstr "　鍵をかけてベッドに横になる。"

#. Occurrence WIK_L_1:703:22508: scene=WIK_L_1
#: WIK_L_1:703
msgctxt "text_id=22508 | speaker=unknown"
msgid "  Just in case, I decided not to change into my pajamas."
msgstr "　万が一の事態に対応できるよう、寝間着には着替えていない。"

#. Occurrence WIK_L_1:732:22509: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_L_1_0003; voice_prefix=B10; voice_category=5; scene=WIK_L_1
#: WIK_L_1:732
msgctxt "text_id=22509 | speaker=kojika"
msgid "\"Laugh and you die? Doesn't make any sense...\""
msgstr "「笑ったら死ぬ、とかワケが分からないけど……」"

#. Occurrence WIK_L_1:738:22510: scene=WIK_L_1
#: WIK_L_1:738
msgctxt "text_id=22510 | speaker=unknown"
msgid "  Someone or something was clearly trying to kill us all."
msgstr "　ここにいるわたしたち全員を殺そうとする何者かがいるのは確かだ。"

#. Occurrence WIK_L_1:743:22511: scene=WIK_L_1
#: WIK_L_1:743
msgctxt "text_id=22511 | speaker=unknown"
msgid "  I turned on my side, thoughts racing."
msgstr "　わたしは横になって考える。"

#. Occurrence WIK_L_1:748:22512: scene=WIK_L_1
#: WIK_L_1:748
msgctxt "text_id=22512 | speaker=unknown"
msgid "  To me, Tsukiji and Father Eiri were *too* rational. They'd overlooked something."
msgstr "　槻司や詠梨神父は論理的すぎて、ある疑問を見逃していると思う。"

#. Occurrence WIK_L_1:768:22513: scene=WIK_L_1
#: WIK_L_1:768
msgctxt "text_id=22513 | speaker=unknown"
msgid "  I wasn't fixated on the culprit's face or identity."
msgstr "　わたしが思うのは犯人の顔や正体じゃない。"

#. Occurrence WIK_L_1:773:22514: scene=WIK_L_1
#: WIK_L_1:773
msgctxt "text_id=22514 | speaker=unknown"
msgid "  I was more concerned with the whydunit."
msgstr "　そいつは、どうしてこんな事をする気になったのか。"

#. Occurrence WIK_L_1:778:22515: scene=WIK_L_1
#: WIK_L_1:778
msgctxt "text_id=22515 | speaker=unknown"
msgid "  What did the culprit have to gain by killing us all?"
msgstr "　わたしたち全員を殺して何の得があるんだろう、とうろんな頭で考え続けて―――"

#. Occurrence WIK_L_2:33:22516: scene=WIK_L_2
#: WIK_L_2:33
msgctxt "text_id=22516 | speaker=unknown"
msgid "  I felt that..."
msgstr "　その前に、"

#. Occurrence WIK_L_2:33:22517: scene=WIK_L_2
#: WIK_L_2:33
msgctxt "text_id=22517 | speaker=unknown"
msgid "  we needed to dig more into the pink girl's alibi."
msgstr "　あのピンク女のアリバイも検証するべきだと思った。"

#. Occurrence WIK_L_2:61:22518: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0000; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:61
msgctxt "text_id=22518 | speaker=liddell"
msgid "\"Huh? You want me to go, too?"
msgstr "「へ？　アタシにもやれっていうの？"

#. Occurrence WIK_L_2:77:22519: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0001; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:77
msgctxt "text_id=22519 | speaker=liddell"
msgid "  I've got nothing to do with any of this. If you thought about it for even a second, you'd realize those two idiots died before I got here."
msgstr "　アタシは関係ないじゃない。だってアタシが来た時、もう爺さんもセンセイとやらもいなくなってたんでしょ？　常識的に考えて、完全にシロよ。"

#. Occurrence WIK_L_2:89:22520: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0002; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:89
msgctxt "text_id=22520 | speaker=liddell"
msgid "  I don't even have a reason to use Sweets Hearts. I'm a rich celebrity; I can solve most of my problems with money, not to mention petty wishes. If I wanted to call down a storm, I'd do it even if it meant sacrificing everyone around me.\""
msgstr "　だいたい、アタシにはスイーツハーツなんて使う理由がないし。なに不自由のないアイドルだし、願い事なんてたいていはお金で解決できるし。どうせ嵐を呼ぶなら、自分の手で起こして、まわりを犠牲にしてもスッパリ成就させまくるし」"

#. Occurrence WIK_L_2:120:22521: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_L_2_0000; voice_prefix=B70; voice_category=4; scene=WIK_L_2
#: WIK_L_2:120
msgctxt "text_id=22521 | speaker=tobimaru"
msgid "\"Don't be a dumbass. You're as much a suspect as anyone."
msgstr "「バカいってんじゃねえ、テメエだって怪しいだろ。"

#. Occurrence WIK_L_2:131:22522: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_L_2_0001; voice_prefix=B70; voice_category=4; scene=WIK_L_2
#: WIK_L_2:131
msgctxt "text_id=22522 | speaker=tobimaru"
msgid "  You know about Ploys, you have a grudge against Aozaki and Kuonji, and you're way too over the top."
msgstr "　プロイとやらを知っていて、蒼崎と久遠寺に恨みがあって、おまけに慢性的なヒスときた。"

#. Occurrence WIK_L_2:137:22523: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_L_2_0002; voice_prefix=B70; voice_category=4; scene=WIK_L_2
#: WIK_L_2:137
msgctxt "text_id=22523 | speaker=tobimaru"
msgid "  On top of that, you showed up uninvited. In a freakin' helicopter!\""
msgstr "　そもそも、なんで呼ばれもしていないのにやって来た。わざわざヘリ飛ばしてまでよ？」"

#. Occurrence WIK_L_2:164:22524: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_L_2_0003; voice_prefix=B70; voice_category=4; scene=WIK_L_2
#: WIK_L_2:164
msgctxt "text_id=22524 | speaker=tobimaru"
msgid "\"What's more, you weren't wet from the rain when you came in."
msgstr "「つーかアレだ。テメエ、ヘリでやってきた時、まったく雨に濡れていなかったよな？"

#. Occurrence WIK_L_2:170:22525: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_L_2_0004; voice_prefix=B70; voice_category=4; scene=WIK_L_2
#: WIK_L_2:170
msgctxt "text_id=22525 | speaker=tobimaru"
msgid "  Care to explain that?"
msgstr "　ありゃどういうコトだ。"

#. Occurrence WIK_L_2:181:22526: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_L_2_0005; voice_prefix=B70; voice_category=4; scene=WIK_L_2
#: WIK_L_2:181
msgctxt "text_id=22526 | speaker=tobimaru"
msgid "  I bet you hid somewhere in the mansion, called your helicopter in, then made it seem like you just got here!\""
msgstr "　それまで屋敷に隠れていて、ヘリを呼びつけたタイミングで登場すれば、さも“たったいま着きましたー！”って状況になるよなあ？」"

#. Occurrence WIK_L_2:209:22527: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0003; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:209
msgctxt "text_id=22527 | speaker=liddell"
msgid "\"Oh, come off it!"
msgstr "「なっ、なによそれ！？"

#. Occurrence WIK_L_2:221:22528: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0004; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:221
msgctxt "text_id=22528 | speaker=liddell"
msgid "  Of course I came here in a helicopter! I used my Goblin to keep the rain off me! You seriously think I'd come here just to murder you all?!\""
msgstr "　アタシ、ちゃんとヘリで来たってば！　雨に濡れないのはゴブリンで弾いたからだし！　なんでアタシが、アンタらを皆殺しにしようなんて思うのよ！？」"

#. Occurrence WIK_L_2:258:22529: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_L_2_0000; voice_prefix=A30; voice_category=3; scene=WIK_L_2
#: WIK_L_2:258
msgctxt "text_id=22529 | speaker=soujuurou"
msgid "\"You've definitely thought about it before.\""
msgstr "「いや。思ってたじゃないか、実際」"

#. Occurrence WIK_L_2:264:22530: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_L_2_0000; voice_prefix=A40; voice_category=2; scene=WIK_L_2
#: WIK_L_2:264
msgctxt "text_id=22530 | speaker=alice"
msgid "\"She has.\""
msgstr "「ええ。したわね、実際」"

#. Occurrence WIK_L_2:291:22531: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0005; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:291
msgctxt "text_id=22531 | speaker=liddell"
msgid "\"That has nothing to do with this!"
msgstr "「あれはあれ、これはこれでしょう！？"

#. Occurrence WIK_L_2:303:22532: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0006; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:303
msgctxt "text_id=22532 | speaker=liddell"
msgid "  Ugh, you're giving me a headache. I'm leaving. Just you wait, I'll be back with an Operation British of my own. Ground zero: this house.\""
msgstr "　ああもう、マジ頭きた。アタシ帰る。帰って第二次ブリティッシュ作戦の準備する。もちろん、標的はここだからね」"

#. Occurrence WIK_L_2:343:22533: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_L_2_0000; voice_prefix=A10; voice_category=1; scene=WIK_L_2
#: WIK_L_2:343
msgctxt "text_id=22533 | speaker=aoko"
msgid "\"Can you even leave? Remember what Alice said?\""
msgstr "「できるの？　脱出は困難だって、有珠が」"

#. Occurrence WIK_L_2:355:22534: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_L_2_0001; voice_prefix=A40; voice_category=2; scene=WIK_L_2
#: WIK_L_2:355
msgctxt "text_id=22534 | speaker=alice"
msgid "\"It's highly likely that Sweets Hearts's probability shift has collapsed the roads."
msgstr "「ええ。スイーツハーツの確率変動で、道は土砂崩れになっている可能性が高いわ。"

#. Occurrence WIK_L_2:361:22535: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_L_2_0002; voice_prefix=A40; voice_category=2; scene=WIK_L_2
#: WIK_L_2:361
msgctxt "text_id=22535 | speaker=alice"
msgid "  And the phone is still out.\""
msgstr "　電話線もなくなってるから、外部と連絡もとれないし」"

#. Occurrence WIK_L_2:385:22536: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0007; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:385
msgctxt "text_id=22536 | speaker=liddell"
msgid "\"Ha! I can still fly."
msgstr "「はん、地上がダメなら空があるわ。"

#. Occurrence WIK_L_2:396:22537: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0008; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:396
msgctxt "text_id=22537 | speaker=liddell"
msgid "  I'll just call my helicopter to come pick me up."
msgstr "　いいわよ、ヘリでしょ、お望み通り呼んでやるわよ。"

#. Occurrence WIK_L_2:402:22538: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0009; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:402
msgctxt "text_id=22538 | speaker=liddell"
msgid "  Don't underestimate the power of my Goblin Nest!\""
msgstr "　アタシのゴブリンネストを舐めるんじゃないっての！」"

#. Occurrence WIK_L_2:430:22539: scene=WIK_L_2
#: WIK_L_2:430
msgctxt "text_id=22539 | speaker=unknown"
msgid "  The girl in pink stormed out into the hallway."
msgstr "　ピンク女は威勢良く<啖呵|たんか>をきって、廊下に出て行った。"

#. Occurrence WIK_L_2:502:22540: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0010; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:502
msgctxt "text_id=22540 | speaker=liddell"
msgid "\"Hello, Daddy? It's me. Can you send a helicopter to Shiroinuzuka in Misaki...? Yes, *that* Misaki."
msgstr "『ハロー。パパ？　アタシだけど、いますぐミサキ町の白犬塚までヘリ、飛ばして。そう、あのミサキ町。"

#. Occurrence WIK_L_2:515:22541: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0011; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:515
msgctxt "text_id=22541 | speaker=liddell"
msgid "What?! What do you mean, give up?! Have you gone SENILE, you old codger?! I decided I'd keep trying until victory is mine! And I NEVER lost in the first place! That was just a draw!"
msgstr "はぁ！？　まだ諦めてないのか、ですって？　ヴァァァァァカ、頭ん中カボチャになってんじゃないの！？　勝つまでやるのがアタシだし！　第一、まだぜんっぜん負けてないし！　あんなの引き分けにすぎないわよ！"

#. Occurrence WIK_L_2:528:22542: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0012; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:528
msgctxt "text_id=22542 | speaker=liddell"
msgid "  You know the coordinates. Send me a chopper now! You've got ten minutes!\""
msgstr "　ほら、座標は分かるでしょ。さっさと飛ばして。十分以内よ、十分以内』"

#. Occurrence WIK_L_2:555:22543: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0013; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:555
msgctxt "text_id=22543 | speaker=liddell"
msgid "\"Huh? What do you mean you can't send one in this storm? Do I sound like I care!?"
msgstr "『は？　支社にあるヘリじゃ無理？　嵐がひどくて近づけない？　ッタコ、んなコト分かってるわよ！"

#. Occurrence WIK_L_2:561:22544: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0014; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:561
msgctxt "text_id=22544 | speaker=liddell"
msgid "  Or are you suggesting that I fly myself out of here like a missile!?"
msgstr "　それでも、このアタシが、今すぐ、ミサイルみたいにカッ飛ばせって言ってんの……！"

#. Occurrence WIK_L_2:573:22545: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0015; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:573
msgctxt "text_id=22545 | speaker=liddell"
msgid "  ...We don't have any helicopters to send? You call yourself a businessman, you dimwit? Use your brain! There's a military base nearby, remember? They're testing a prototype assault craft there. Just charter it!\""
msgstr "　飛ばしたくても機体がない？　このハイトンチキ、アンタそれでも商人？　頭使いなさいよね。近くに軍用基地あるでしょ。そこに試作の最新鋭機があるって話よ。強襲用の。それ、一機チャーターして』"

#. Occurrence WIK_L_2:600:22546: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0016; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:600
msgctxt "text_id=22546 | speaker=liddell"
msgid "\"Goodness, can't you do *anything* on your own?"
msgstr "『あーもう、ムリムリうるさいわねそれしか言えないの？"

#. Occurrence WIK_L_2:612:22547: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0017; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:612
msgctxt "text_id=22547 | speaker=liddell"
msgid "  WHAT?! What do you mean, cash is tight because you're restructuring?! You'd have to buy the entire aircraft and crew? Go ahead, then! I can make you back that money in a day! I'll just do a private concert for some oil sheikh or a Chinese billionaire! That good enough for you?\""
msgstr "　はぁ？　会社の立て直しで<実弾|キャッシュ>がない？　機体プラス、スタッフごと買い取らなきゃならん？　上等じゃない、その程度アタシがいくらでも稼いであげるってーの！　アラブの坊ちゃん宅だろうがチャイナの金満家の所だろうが、プライベートライブ<二三|にさん><発|ぱつ>ぶちかましてあげるわよ！　それでおつりがくるでしょ？』"

#. Occurrence WIK_L_2:639:22548: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0018; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:639
msgctxt "text_id=22548 | speaker=liddell"
msgid "\"Oh *please*, don't cry and tell me how proud you are of me. It's just for the *money*, Daddy. I couldn't care less about the music industry!"
msgstr "『うざっ、泣いて喜ぶとか本気で止めて。お金のためよお金のため、音楽業なんてどうでもいいんだから！"

#. Occurrence WIK_L_2:645:22549: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0019; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:645
msgctxt "text_id=22549 | speaker=liddell"
msgid "  Just get me that helicopter within TEN minutes! That new, experimental, super-cool one! NOT some budget Apache or any other rubbish like that, or I'LL NEVER SPEAK TO YOU AGAIN!\""
msgstr "　わかったら十分以内！　最新鋭機の、スーパーカッコイイの！　クソアパッチなんか寄越したら親子の縁切るから、覚悟しておくコトね！』"

#. Occurrence WIK_L_2:699:22550: scene=WIK_L_2
#: WIK_L_2:699
msgctxt "text_id=22550 | speaker=unknown"
msgid "  The pink girl's vicious berating could be heard throughout the house."
msgstr "　……なんか、ものすごい罵詈雑言が響いてきている。"

#. Occurrence WIK_L_2:704:22551: scene=WIK_L_2
#: WIK_L_2:704
msgctxt "text_id=22551 | speaker=unknown"
msgid "  She was speaking English so quickly and with so much slang mixed in that I couldn't quite catch it all."
msgstr "　ピンク女は英語でひとりごとを呟いているっぽいんだけど、あまりにも早口＆<俗語|スラング>の連続で、もう何を言っているんだか聞き取れない。"

#. Occurrence WIK_L_2:709:22552: scene=WIK_L_2
#: WIK_L_2:709
msgctxt "text_id=22552 | speaker=unknown"
msgid "  ...Listening wasn't a particular strength of mine, anyway."
msgstr "　……そもそもわたし、ヒアリング得意じゃないし。"

#. Occurrence WIK_L_2:737:22553: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_L_2_0006; voice_prefix=B70; voice_category=4; scene=WIK_L_2
#: WIK_L_2:737
msgctxt "text_id=22553 | speaker=tobimaru"
msgid "\"Did that moron really just order a military chopper?\""
msgstr "「……あの馬鹿、本気で軍用ヘリ呼びつけやがった……」"

#. Occurrence WIK_L_2:778:22554: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0020; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:778
msgctxt "text_id=22554 | speaker=liddell"
msgid "\"Right, that's all settled. My guardian angel will be descending from the skies in about ten minutes."
msgstr "「お待たせ。あと十分もしたら救いの天使が来るわ。"

#. Occurrence WIK_L_2:791:22555: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0021; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:791
msgctxt "text_id=22555 | speaker=liddell"
msgid "  Sweets Hearts's rules only apply to this mountain. As soon as I get out of here, I'll put all this behind me. I'll just head home, have a fancy dinner, and relax.\""
msgstr "　スイーツハーツのルールはこの山限定だから、外に出てしまえば何もかもチャラ。アタシは一足先に家に帰って、豪華なディナーとしゃれこませてもらうから」"

#. Occurrence WIK_L_2:819:22556: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0022; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:819
msgctxt "text_id=22556 | speaker=liddell"
msgid "\"Oh, and don't worry."
msgstr "「ああ、けど安心なさい？"

#. Occurrence WIK_L_2:832:22557: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0023; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:832
msgctxt "text_id=22557 | speaker=liddell"
msgid "  I'm not that terrible of a person. If any of you want a ride, I'd be happy to oblige. I'm sure some of you are tired of this stupid detective game.\""
msgstr "　アタシだって鬼じゃないし、どうしてもって言うなら乗っけていってあげてもいいわよ？　こんな犯人当てゲームにこりごりな人は、いますぐアタシ側に来るコトね」"

#. Occurrence WIK_L_2:864:22558: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_L_2_0001; voice_prefix=A10; voice_category=1; scene=WIK_L_2
#: WIK_L_2:864
msgctxt "text_id=22558 | speaker=aoko"
msgid "\"Hold it, buddy. Where do you think you're going?\""
msgstr "「待てそこ。どうしてすぐ強い方に付こうとするのか」"

#. Occurrence WIK_L_2:881:22559: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_L_2_0001; voice_prefix=A30; voice_category=3; scene=WIK_L_2
#: WIK_L_2:881
msgctxt "text_id=22559 | speaker=soujuurou"
msgid "\"Well, she said she was our guardian angel.\""
msgstr "「いや、しかし。自ら救いの天使だと」"

#. Occurrence WIK_L_2:912:22560: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_L_2_0007; voice_prefix=B70; voice_category=4; scene=WIK_L_2
#: WIK_L_2:912
msgctxt "text_id=22560 | speaker=tobimaru"
msgid "\"I wouldn't if I were you, Soujyuro. If she's an angel, then that makes Aozaki a goddess of healing. Don't fall for her crazy metaphors.\""
msgstr "「やめとけ草十郎。そいつが救いの天使だってんなら、蒼崎なんざ癒しの女神クラスになっちまう。根本的に喩えを間違えてるぞ、アレ」"

#. Occurrence WIK_L_2:938:22561: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_L_2_0002; voice_prefix=A30; voice_category=3; scene=WIK_L_2
#: WIK_L_2:938
msgctxt "text_id=22561 | speaker=soujuurou"
msgid "\"Huh. What about you, Kumari?"
msgstr "「……むう。久万梨はどうする？"

#. Occurrence WIK_L_2:938:22562: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_L_2_0002; voice_prefix=A30; voice_category=3; scene=WIK_L_2
#: WIK_L_2:938
msgctxt "text_id=22562 | speaker=soujuurou"
msgid "  You heard what Tobimaru said.\""
msgstr "　鳶丸たちはこう言っているけど」"

#. Occurrence WIK_L_2:949:22563: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_L_2_0000; voice_prefix=B10; voice_category=5; scene=WIK_L_2
#: WIK_L_2:949
msgctxt "text_id=22563 | speaker=kojika"
msgid "\"I'm not going. If she wants to leave, she can go by herself.\""
msgstr "「わたしも辞退。帰るならひとりで帰ってもらえばいい」"

#. Occurrence WIK_L_2:955:22564: scene=WIK_L_2
#: WIK_L_2:955
msgctxt "text_id=22564 | speaker=unknown"
msgid "  To be honest, if rescue was coming, I really did want to leave. But I wasn't about to owe this pink princess any favors."
msgstr "　本当は助けが来るならすぐに乗りたいところだが、あのピンク女の手を借りるのは<御免蒙|ごめんこうむ>る。"

#. Occurrence WIK_L_2:980:22565: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0024; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:980
msgctxt "text_id=22565 | speaker=liddell"
msgid "\"Hmph. You must all be a bunch of dreamers to stay all chummy at a time like this."
msgstr "「ふん、この状況でも仲良しごっことか、ドリーマー極まったわね。"

#. Occurrence WIK_L_2:993:22566: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0025; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:993
msgctxt "text_id=22566 | speaker=liddell"
msgid "  You lot can do as you please. Just don't let tomorrow's headline be, 'all guests missing from the hilltop mansion.'\""
msgstr "　いいわよ、好きにすれば？　明日の朝刊の見出しが“山の上の洋館、宿泊客全員行方不明か？”なんてモンにならないよう、せいぜい気をつけなさい」"

#. Occurrence WIK_L_2:1019:22567: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_L_2_0001; voice_prefix=B10; voice_category=5; scene=WIK_L_2
#: WIK_L_2:1019
msgctxt "text_id=22567 | speaker=kojika"
msgid "\"Ha! Snark all you want, coward."
msgstr "「はん。逃げだす女がよく言ったものね。"

#. Occurrence WIK_L_2:1030:22568: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_L_2_0002; voice_prefix=B10; voice_category=5; scene=WIK_L_2
#: WIK_L_2:1030
msgctxt "text_id=22568 | speaker=kojika"
msgid "  Nobody's coming for you in this weather. It's like hell out there. Who's really dreaming?\""
msgstr "　そもそもこの天候で助けなんて来るハズないし。外の天気、嵐というより地獄でしょ。夢見がちなのはそっちの頭の方だと思う」"

#. Occurrence WIK_L_2:1043:22569: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0026; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:1043
msgctxt "text_id=22569 | speaker=liddell"
msgid "\"...!\""
msgstr "「っ……！」"

#. Occurrence WIK_L_2:1065:22570: scene=WIK_L_2
#: WIK_L_2:1065
msgctxt "text_id=22570 | speaker=unknown"
msgid "  And then..."
msgstr "　……と。"

#. Occurrence WIK_L_2:1070:22571: scene=WIK_L_2
#: WIK_L_2:1070
msgctxt "text_id=22571 | speaker=unknown"
msgid "  Before even ten minutes had gone by, there was a bizarre noise from outside that was separate from the howling storm."
msgstr "　十分を待たずして外からは強風とは別の、異質な風切り音が聞こえてきた。"

#. Occurrence WIK_L_2:1102:22572: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0027; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:1102
msgctxt "text_id=22572 | speaker=liddell"
msgid "\"Aha! Earlier than expected!"
msgstr "「あはっ、予定よりすっごく早い！"

#. Occurrence WIK_L_2:1108:22573: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0028; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:1108
msgctxt "text_id=22573 | speaker=liddell"
msgid "  I knew Daddy would come through! He's got friends in high places, and he knows how to use them!\""
msgstr "　さっすがパパ、なんだかんだ言ってコネクションも行動力もあるんだからー♪」"

#. Occurrence WIK_L_2:1212:22574: scene=WIK_L_2
#: WIK_L_2:1212
msgctxt "text_id=22574 | speaker=unknown"
msgid "  In the midst of the tempest, a demonic bird came bearing down on us."
msgstr "　吹きすさぶ嵐の中、一つ目の魔鳥が接近してくる。"

#. Occurrence WIK_L_2:1217:22575: scene=WIK_L_2
#: WIK_L_2:1217
msgctxt "text_id=22575 | speaker=unknown"
msgid "  Bright spots that I'd thought were eyes turned out to be a powerful searchlight, its beam stretching out for miles."
msgstr "　目と思われたのは、何キロメートル先さえ照らす強力なサーチライトだ。"

#. Occurrence WIK_L_2:1222:22576: scene=WIK_L_2
#: WIK_L_2:1222
msgctxt "text_id=22576 | speaker=unknown"
msgid "  The steel helicopter struggled against winds in excess of 50 miles per hour, and then..."
msgstr "　鋼鉄のヘリコプターは、風速八十キロもの風をものともせず、"

#. Occurrence WIK_L_2:1580:22577: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_L_2_0003; voice_prefix=B10; voice_category=5; scene=WIK_L_2
#: WIK_L_2:1580
msgctxt "text_id=22577 | speaker=kojika"
msgid "\"Oh. It crashed.\""
msgstr "「あ、落ちた」"

#. Occurrence WIK_L_2:1593:22578: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0029; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:1593
msgctxt "text_id=22578 | speaker=liddell"
msgid "\"Ah... AaaaAAaAAAhhh...\""
msgstr "「あ―――あ、あ、あ」"

#. Occurrence WIK_L_2:1694:22579: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_L_2_0000; voice_prefix=B40; voice_category=8; scene=WIK_L_2
#: WIK_L_2:1694
msgctxt "text_id=22579 | speaker=eiri"
msgid "\"They should've known better than to fly in this weather. Even Alice has better common sense than that.\""
msgstr "「いやあ、この天候でフライトとか、常識的に考えて無茶でしょう。有珠さんでもそこまで世間知らずではありませんよ」"

#. Occurrence WIK_L_2:1718:22580: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_L_2_0003; voice_prefix=A40; voice_category=2; scene=WIK_L_2
#: WIK_L_2:1718
msgctxt "text_id=22580 | speaker=alice"
msgid "\"Right. I knew it was going to crash. None of Riddell's silly plans ever work out.\""
msgstr "「ええ。必ず落ちると思ったわ。リデルの作戦がうまくいった事なんて、今まで一度もないのだし」"

#. Occurrence WIK_L_2:1728:22581: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0030; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:1728
msgctxt "text_id=22581 | speaker=liddell"
msgid "\"They work perfectly every time! Just never when you're around!"
msgstr "「あるわよ、アンタさえ関わらなければいつだってアタシはパーフェクトだっつーの！"

#. Occurrence WIK_L_2:1741:22582: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0031; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:1741
msgctxt "text_id=22582 | speaker=liddell"
msgid "  Anyway, that was just a test."
msgstr "　それに、今のはただのテストよ。"

#. Occurrence WIK_L_2:1755:22583: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0032_0; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:1755
msgctxt "text_id=22583 | speaker=liddell"
msgid "  My real plan is just beginning."
msgstr "　本命は後からやって―――"

#. Occurrence WIK_L_2:1769:22584: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0032_1; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:1769
msgctxt "text_id=22584 | speaker=liddell"
msgid "Hang on, I have to take this. Time out.\""
msgstr "ちょっと待って、タイム」"

#. Occurrence WIK_L_2:1806:22585: scene=WIK_L_2
#: WIK_L_2:1806
msgctxt "text_id=22585 | speaker=unknown"
msgid "  The pink girl went back out into the hallway. Maybe she had a pager in her pocket."
msgstr "　ポケットにポケベルでも入っているのか、ピンク女はまた廊下に出て行ってしまった。"

#. Occurrence WIK_L_2:1814:22586: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0033; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:1814
msgctxt "text_id=22586 | speaker=liddell"
msgid "\"WHAT!? They're claiming you're responsible...?! Special forces are breaching the company office!?\""
msgstr "『はあ、責任問題になったァ！？　いま特殊部隊が本社ビルの屋上から侵入して来てるですってーー！？』"

#. Occurrence WIK_L_2:1832:22587: scene=WIK_L_2
#: WIK_L_2:1832
msgctxt "text_id=22587 | speaker=unknown"
msgid "  Her yelling resonated through the hallway."
msgstr "　なんか、廊下から悲鳴が聞こえてくる。"

#. Occurrence WIK_L_2:1872:22588: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0034; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:1872
msgctxt "text_id=22588 | speaker=liddell"
msgid "\"Calm down. Don't do anything stupid. Talk to the commanding officer. Huh? They want you to pay for the damages? They're going to kill you if you don't buy out the entire project? You're already tied up? Ugh, what's Kai doing at a time like this?! So how much do they want? Pfft! That's at least two more zeroes than it should be! We can't pay that, not right away!"
msgstr "『落ち着いて、下手な抵抗はしちゃダメよ、すぐ無線で相手のトップと交渉して。え、損害賠償？　プロジェクトごと買い取らないと殺すって？　つーかもう拘束されてる？　ああもう、カイは何やってんのよ！？　で、いくら？　ごはっ、なにその金額、ケタ二つ違くない！？　払えない払えない、そんなのすぐに払えない！"

#. Occurrence WIK_L_2:1900:22589: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0035; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:1900
msgctxt "text_id=22589 | speaker=liddell"
msgid "Hold on a second, um... hmm... maybe there is a way.\""
msgstr "　ちょっと待って、えーと……う、うん、なんとかなるかも』"

#. Occurrence WIK_L_2:1921:22590: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_L_2_0036; voice_prefix=B80; voice_category=13; scene=WIK_L_2
#: WIK_L_2:1921
msgctxt "text_id=22590 | speaker=liddell"
msgid "\"I'll extend my tour this year, sell off my stock, my island in Tahiti... That should be enough. Okay, it's a deal! Sign the papers! The defense industry is new territory for us, but your life is more important, Daddy!\""
msgstr "『今年のツアー延長と、アタシの持ち株と、タヒチの島を売却すれば、なんとかなりそう。いいわ、契約成立、買い取っちゃって！　軍事産業とか畑違いだけど、とりあえずパパの安全が最優先！』"

#. Occurrence WIK_L_2:1957:22591: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_L_2_0004; voice_prefix=B10; voice_category=5; scene=WIK_L_2
#: WIK_L_2:1957
msgctxt "text_id=22591 | speaker=kojika"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence WIK_L_2:1962:22592: scene=WIK_L_2
#: WIK_L_2:1962
msgctxt "text_id=22592 | speaker=unknown"
msgid "  I was a little curious now."
msgstr "　ちょっと気になる。"

#. Occurrence WIK_L_2:1967:22593: scene=WIK_L_2
#: WIK_L_2:1967
msgctxt "text_id=22593 | speaker=unknown"
msgid "  I..."
msgstr "　わたしは、"

#. Occurrence WIK_SELECT_M:8:22594: scene=WIK_SELECT_M
#: WIK_SELECT_M:8
msgctxt "text_id=22594 | speaker=unknown"
msgid "-Decision M-"
msgstr "～選択肢Ｍ～"

#. Occurrence WIK_M_1:30:22595: scene=WIK_M_1
#: WIK_M_1:30
msgctxt "text_id=22595 | speaker=unknown"
msgid "  I think I'll take a peek in the hallway."
msgstr "　わたしは、ちらっと廊下の様子を見てみたい、と思った。"

#. Occurrence WIK_M_1:72:22596: scene=WIK_M_1
#: WIK_M_1:72
msgctxt "text_id=22596 | speaker=unknown"
msgid "  There, I saw..."
msgstr "　そこには、"

#. Occurrence WIK_M_1:85:22597: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_M_1_0000; voice_prefix=B80; voice_category=13; scene=WIK_M_1
#: WIK_M_1:85
msgctxt "text_id=22597 | speaker=liddell"
msgid "\"...I've lost everything... Everything...\""
msgstr "「……失った……すべて失ったわ……」"

#. Occurrence WIK_M_1:90:22598: scene=WIK_M_1
#: WIK_M_1:90
msgctxt "text_id=22598 | speaker=unknown"
msgid "  Her face was haunted, as if she'd looked upon the end of the world."
msgstr "　この世の終わりを見たような、語るも無惨な幽鬼の顔があったりした。"

#. Occurrence WIK_M_1:95:22599: scene=WIK_M_1
#: WIK_M_1:95
msgctxt "text_id=22599 | speaker=unknown"
msgid "  I quickly shut the door and pretended I didn't see anything. She deserved a warrior's dignity, at the very least."
msgstr "　武士の情けで見なかったフリで、急いでドアを閉める。"

#. Occurrence WIK_M_A:33:22600: scene=WIK_M_A
#: WIK_M_A:33
msgctxt "text_id=22600 | speaker=unknown"
msgid "  A moment went by."
msgstr "　しばらくの間。"

#. Occurrence WIK_M_A:38:22601: scene=WIK_M_A
#: WIK_M_A:38
msgctxt "text_id=22601 | speaker=unknown"
msgid "  After about a minute..."
msgstr "　一分ほど経った後、"

#. Occurrence WIK_M_A:66:22602: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_M_A_0000; voice_prefix=B80; voice_category=13; scene=WIK_M_A
#: WIK_M_A:66
msgctxt "text_id=22602 | speaker=liddell"
msgid "\"Forget that stupid helicopter."
msgstr "「まあ、ヘリの事はきっぱり忘れるとして。"

#. Occurrence WIK_M_A:77:22603: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_M_A_0001; voice_prefix=B80; voice_category=13; scene=WIK_M_A
#: WIK_M_A:77
msgctxt "text_id=22603 | speaker=liddell"
msgid "  Let's think more positively.\""
msgstr "　もっと前向きな話をしましょう」"

#. Occurrence WIK_M_A:85:22604: scene=WIK_M_A
#: WIK_M_A:85
msgctxt "text_id=22604 | speaker=unknown"
msgid "  She returned, acting as if nothing had happened."
msgstr "　彼女は何事もなかったように現れた。"

#. Occurrence WIK_M_A:90:22605: scene=WIK_M_A
#: WIK_M_A:90
msgctxt "text_id=22605 | speaker=unknown"
msgid "  We were enemies, but I had to respect her sense of pride."
msgstr "　敵ながら、そのプライドの高さは認めざるを得ない。"

#. Occurrence WIK_M_A:127:22606: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_M_A_0000; voice_prefix=B70; voice_category=4; scene=WIK_M_A
#: WIK_M_A:127
msgctxt "text_id=22606 | speaker=tobimaru"
msgid "\"Riddell, you...\""
msgstr "「リデル、オマ……」"

#. Occurrence WIK_M_A:138:22607: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_M_A_0002; voice_prefix=B80; voice_category=13; scene=WIK_M_A
#: WIK_M_A:138
msgctxt "text_id=22607 | speaker=liddell"
msgid "\"Tobimaru. I said, let's move on.\""
msgstr "「トビマル。前向きな話をしましょう」"

#. Occurrence WIK_M_A:149:22608: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_M_A_0001; voice_prefix=B70; voice_category=4; scene=WIK_M_A
#: WIK_M_A:149
msgctxt "text_id=22608 | speaker=tobimaru"
msgid "\"...Fine. At least we know you're innocent. If it turns out you're Sweets Hearts after all this crap, I don't think I can look you in the eye ever again.\""
msgstr "「……分かった。とりあえず、オマエさんが潔白だってのだけは分かった。というか、これでスイーツハーツがオマエだったら、酷すぎて目も当てられねえ」"

#. Occurrence WIK_M_A:175:22609: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_M_A_0003; voice_prefix=B80; voice_category=13; scene=WIK_M_A
#: WIK_M_A:175
msgctxt "text_id=22609 | speaker=liddell"
msgid "\"I told you I had nothing to do with any of this from the start."
msgstr "「そんなの当たり前でしょ。さっきからアタシは関係ないって言ってるじゃない。"

#. Occurrence WIK_M_A:186:22610: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_M_A_0004; voice_prefix=B80; voice_category=13; scene=WIK_M_A
#: WIK_M_A:186
msgctxt "text_id=22610 | speaker=liddell"
msgid "  I'm a genius, a rare Meinster, a witch for the modern age. The great Riddell would never stoop to using silly obsolete Ploys.\""
msgstr "　だいたいね、このアタシ、希代の天才マイスター、新世代魔女であるリデル様が、こーんなバカっぽくて古くさいプロイに引っかかるワケないじゃない」"

#. Occurrence WIK_M_A:218:22611: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_M_A_0002; voice_prefix=B70; voice_category=4; scene=WIK_M_A
#: WIK_M_A:218
msgctxt "text_id=22611 | speaker=tobimaru"
msgid "\"But you'd use a helicopter?\""
msgstr "「いや、ひっかかっただろ、あのヘリ」"

#. Occurrence WIK_M_A:229:22612: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_M_A_0005; voice_prefix=B80; voice_category=13; scene=WIK_M_A
#: WIK_M_A:229
msgctxt "text_id=22612 | speaker=liddell"
msgid "\"Shut up about the helicopter! This is about ME!"
msgstr "「ヘリはヘリ、アタシはアタシよ！"

#. Occurrence WIK_M_A:235:22613: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_M_A_0006; voice_prefix=B80; voice_category=13; scene=WIK_M_A
#: WIK_M_A:235
msgctxt "text_id=22613 | speaker=liddell"
msgid "  I laughed, but I'm still alive, aren't I?"
msgstr "　さっきだって笑ったけど耐えきったでしょ。"

#. Occurrence WIK_M_A:246:22614: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_M_A_0007; voice_prefix=B80; voice_category=13; scene=WIK_M_A
#: WIK_M_A:246
msgctxt "text_id=22614 | speaker=liddell"
msgid "  There isn't a chance in hell I'm going to laugh again. I'm going to watch you all get picked off one by one by some ancient Ploy!\""
msgstr "　いっとくけど、アタシは絶対笑わないからね。ここでゆっくり、アンタらが古くさいプロイなんかにやられて消えていくのを眺めてやるから！」"

#. Occurrence WIK_M_A:305:22615: scene=WIK_M_A
#: WIK_M_A:305
msgctxt "text_id=22615 | speaker=unknown"
msgid "  She sounded aggressive, but I think the pink girl was more concerned than she let on."
msgstr "　憎まれ口を叩いてはいるが、ピンク女も観念したのだろう。"

#. Occurrence WIK_M_A:310:22616: scene=WIK_M_A
#: WIK_M_A:310
msgctxt "text_id=22616 | speaker=unknown"
msgid "  With one last huff through her nose, she plopped down on the sofa."
msgstr "　ふん、と鼻を鳴らしてソファーに腰を下ろす。"

#. Occurrence WIK_M_A:315:22617: scene=WIK_M_A
#: WIK_M_A:315
msgctxt "text_id=22617 | speaker=unknown"
msgid "  She seemed to made up her mind to work with us for tonight."
msgstr "　わたしたち同様、この夜に付き合う腹を決めたようだ。"

#. Occurrence WIK_M_A:340:22618: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_M_A_0000; voice_prefix=A40; voice_category=2; scene=WIK_M_A
#: WIK_M_A:340
msgctxt "text_id=22618 | speaker=alice"
msgid "\"Sorry, but I'll be back in a second. Carry on.\""
msgstr "「ごめんなさい。少し席を外すわ。すぐに戻ってくるから、話を続けていて」"

#. Occurrence WIK_M_A:349:22619: scene=WIK_M_A
#: WIK_M_A:349
msgctxt "text_id=22619 | speaker=unknown"
msgid "  Miss Kuonji was... ah, the bathroom."
msgstr "　久遠寺さんは……あ、トイレか。"

#. Occurrence WIK_M_A:373:22620: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_M_A_0000; voice_prefix=B40; voice_category=8; scene=WIK_M_A
#: WIK_M_A:373
msgctxt "text_id=22620 | speaker=eiri"
msgid "\"Now we know for sure that escape is impossible."
msgstr "「しかし、<図|はか>らずも脱出は不可能である事が証明されてしまいましたね。"

#. Occurrence WIK_M_A:384:22621: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_M_A_0001; voice_prefix=B40; voice_category=8; scene=WIK_M_A
#: WIK_M_A:384
msgctxt "text_id=22621 | speaker=eiri"
msgid "  We need to figure out who Sweets Hearts is, or survive until morning. I personally favor the latter.\""
msgstr "　誰がスイーツハーツなのか特定するか、朝まで全滅しないように注意を払うか。私は後者を選びたいところですが」"

#. Occurrence WIK_M_A:420:22622: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_M_A_0000; voice_prefix=A10; voice_category=1; scene=WIK_M_A
#: WIK_M_A:420
msgctxt "text_id=22622 | speaker=aoko"
msgid "\"Me, too. If we keep poking the hornet's nest, we might all end up dead."
msgstr "「賛成。薮をつついて蛇を出したら、それこそ全滅の可能性もでてくるし。"

#. Occurrence WIK_M_A:431:22623: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_M_A_0001; voice_prefix=A10; voice_category=1; scene=WIK_M_A
#: WIK_M_A:431
msgctxt "text_id=22623 | speaker=aoko"
msgid "  What about you, Kumari?\""
msgstr "　久万梨は？」"

#. Occurrence WIK_M_A:457:22624: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_M_A_0000; voice_prefix=B10; voice_category=5; scene=WIK_M_A
#: WIK_M_A:457
msgctxt "text_id=22624 | speaker=kojika"
msgid "\"I'm fine with either... Tsukiji?\""
msgstr "「わたしはどっちでもいいけど……槻司はどうなの？」"

#. Occurrence WIK_M_A:475:22625: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_M_A_0003; voice_prefix=B70; voice_category=4; scene=WIK_M_A
#: WIK_M_A:475
msgctxt "text_id=22625 | speaker=tobimaru"
msgid "\"Me? I vote we figure out who the killer is."
msgstr "「俺か？　俺は犯人特定に一票だな。"

#. Occurrence WIK_M_A:487:22626: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_M_A_0004; voice_prefix=B70; voice_category=4; scene=WIK_M_A
#: WIK_M_A:487
msgctxt "text_id=22626 | speaker=tobimaru"
msgid "  I'd like to give them a piece of my mind.\""
msgstr "　こんな状況を作り出した間抜けには、きっちり文句いわねえとな」"

#. Occurrence WIK_M_A:525:22627: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_M_A_0000; voice_prefix=B20; voice_category=10; scene=WIK_M_A
#: WIK_M_A:525
msgctxt "text_id=22627 | speaker=yuika"
msgid "\"I'm fine either way. I don't share Miss Riddell's opinion, but I'll be safe with either option.\""
msgstr "「私はどちらでも。リデルさんではありませんが、どちらに転んでも安全ですので」"

#. Occurrence WIK_M_A:535:22628: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_M_A_0000; voice_prefix=B30; voice_category=9; scene=WIK_M_A
#: WIK_M_A:535
msgctxt "text_id=22628 | speaker=ritsuka"
msgid "\"I'm with Tsukiji."
msgstr "「わたしは槻司くんに賛成っ。"

#. Occurrence WIK_M_A:535:22629: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_M_A_0000; voice_prefix=B30; voice_category=9; scene=WIK_M_A
#: WIK_M_A:535
msgctxt "text_id=22629 | speaker=ritsuka"
msgid "  Time for a little deductive reasoning!\""
msgstr "　推理、推理しましょう、みんな！」"

#. Occurrence WIK_M_A:572:22630: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_M_A_0000; voice_prefix=A30; voice_category=3; scene=WIK_M_A
#: WIK_M_A:572
msgctxt "text_id=22630 | speaker=soujuurou"
msgid "\"As for me... Let me think. The weather's only getting worse, so maybe we should stay in our rooms, lock the doors, and go to sleep. Nobody can make us laugh, then.\""
msgstr "「俺は……そうですね。外の天気も荒れる一方だし、みんな部屋に立てこもった方がいいとは思う。鍵をかけて寝てしまえば他人に笑わせられようがないし」"

#. Occurrence WIK_M_A:583:22631: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_M_A_0000; voice_prefix=A50; voice_category=12; scene=WIK_M_A
#: WIK_M_A:583
msgctxt "text_id=22631 | speaker=beo"
msgid "\"Aww, but that's so boring!"
msgstr "「えー、つまんないでーす！"

#. Occurrence WIK_M_A:594:22632: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_M_A_0001; voice_prefix=A50; voice_category=12; scene=WIK_M_A
#: WIK_M_A:594
msgctxt "text_id=22632 | speaker=beo"
msgid "  Come on, Soujyuro! Let's stick this out! Don't you want to watch Aoko die?\""
msgstr "　草十郎さん、ここはもうちょっと様子見ようよー。アオコの死に方とか、すごく興味ない？」"

#. Occurrence WIK_M_A:606:22633: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_M_A_0001_0; voice_prefix=A30; voice_category=3; scene=WIK_M_A
#: WIK_M_A:606
msgctxt "text_id=22633 | speaker=soujuurou"
msgid "\"Beo, that's not funny―"
msgstr "「ベオ、そういうのは冗談でも―――"

#. Occurrence WIK_M_A:619:22634: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_M_A_0001_1; voice_prefix=A30; voice_category=3; scene=WIK_M_A
#: WIK_M_A:619
msgctxt "text_id=22634 | speaker=soujuurou"
msgid "Hm?\""
msgstr "む？」"

#. Occurrence WIK_M_A:679:22635: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_M_A_0001; voice_prefix=B10; voice_category=5; scene=WIK_M_A
#: WIK_M_A:679
msgctxt "text_id=22635 | speaker=kojika"
msgid "\"!\""
msgstr "「！」"

#. Occurrence WIK_M_A:684:22636: scene=WIK_M_A
#: WIK_M_A:684
msgctxt "text_id=22636 | speaker=unknown"
msgid "  Suddenly, the room was pitch-dark."
msgstr "　突然、部屋が真っ暗になった。"

#. Occurrence WIK_M_A:710:22637: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_M_A_0002; voice_prefix=B40; voice_category=8; scene=WIK_M_A
#: WIK_M_A:710
msgctxt "text_id=22637 | speaker=eiri"
msgid "\"Everyone stay calm. It's just a power outage. If I find out who turned the lights out, I'll knock *their* lights out.\""
msgstr "「落ち着いて。電気が切れたようです。皆さん、<無闇|むやみ>に動いてはいけませんよ。<闇|やみ>だけに」"

#. Occurrence WIK_M_A:717:22638: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_M_A_0002; voice_prefix=B10; voice_category=5; scene=WIK_M_A
#: WIK_M_A:717
msgctxt "text_id=22638 | speaker=kojika"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence WIK_M_A:723:22639: scene=WIK_M_A
#: WIK_M_A:723
msgctxt "text_id=22639 | speaker=unknown"
msgid "  That was a close one. I heard several people almost fail to suppress a laugh."
msgstr "　危ない危ない。あまりの寒さに、一周まわって吹きだしかけてしまった。"

#. Occurrence WIK_M_A:749:22640: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_M_A_0002; voice_prefix=A10; voice_category=1; scene=WIK_M_A
#: WIK_M_A:749
msgctxt "text_id=22640 | speaker=aoko"
msgid "\"What're you thinking, Eiri?! You could've killed us all!\""
msgstr "「なに考えてんのよ詠梨！　全滅するかと思ったじゃない！」"

#. Occurrence WIK_M_A:754:22641: scene=WIK_M_A
#: WIK_M_A:754
msgctxt "text_id=22641 | speaker=unknown"
msgid "  He would've killed *you*, maybe."
msgstr "　いやそれはない、"

#. Occurrence WIK_M_A:759:22642: scene=WIK_M_A
#: WIK_M_A:759
msgctxt "text_id=22642 | speaker=unknown"
msgid "  But I decided to keep that to myself."
msgstr "　とツッコミを入れたいわたしだった。"

#. Occurrence WIK_M_A:786:22643: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_M_A_0003; voice_prefix=B40; voice_category=8; scene=WIK_M_A
#: WIK_M_A:786
msgctxt "text_id=22643 | speaker=eiri"
msgid "\"I couldn't help it. The opportunity presented itself.\""
msgstr "「いやあ、今なら切れる、と心が騒いでしまいまして」"

#. Occurrence WIK_M_A:809:22644: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_M_A_0002; voice_prefix=A30; voice_category=3; scene=WIK_M_A
#: WIK_M_A:809
msgctxt "text_id=22644 | speaker=soujuurou"
msgid "\"Good timing, though. Even a silly joke can be effective if the timing is right.\""
msgstr "「うん、タイミングはバッチリだった。つまんないダジャレも、切り出し方次第で人を殺せるんだな」"

#. Occurrence WIK_M_A:820:22645: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_M_A_0005; voice_prefix=B70; voice_category=4; scene=WIK_M_A
#: WIK_M_A:820
msgctxt "text_id=22645 | speaker=tobimaru"
msgid "\"Something about not being able to see his face makes it funnier, too.\""
msgstr "「顔が見えないのがまた効くよな」"

#. Occurrence WIK_M_A:831:22646: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_M_A_0008; voice_prefix=B80; voice_category=13; scene=WIK_M_A
#: WIK_M_A:831
msgctxt "text_id=22646 | speaker=liddell"
msgid "\"Good grief. Even I almost laughed. Are you sure he isn't the killer?\""
msgstr "「まったくよ。このアタシですらちょっとブルっときたわ。もしかしてアイツが犯人なんじゃないの？」"

#. Occurrence WIK_M_A:866:22647: scene=WIK_M_A
#: WIK_M_A:866
msgctxt "text_id=22647 | speaker=unknown"
msgid "  Our conversation continued in the dark."
msgstr "　暗闇の中で会話は続く。"

#. Occurrence WIK_M_A:871:22648: scene=WIK_M_A
#: WIK_M_A:871
msgctxt "text_id=22648 | speaker=unknown"
msgid "  It reminded me of telling ghost stories on a school trip; it's just fun to talk in the dark sometimes."
msgstr "　……修学旅行の怪談話というか、暗闇の中でのやりとりは妙に興奮するというか。"

#. Occurrence WIK_M_A:876:22649: scene=WIK_M_A
#: WIK_M_A:876
msgctxt "text_id=22649 | speaker=unknown"
msgid "  For whatever reason, I could tell we were all tempted to make each other laugh."
msgstr "　なんとなく、誰もが“今ならひとりぐらい笑わせてもいいんじゃないかな？”なんて浮ついた空気になってきた。"

#. Occurrence WIK_M_A:908:22650: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_M_A_0003; voice_prefix=A10; voice_category=1; scene=WIK_M_A
#: WIK_M_A:908
msgctxt "text_id=22650 | speaker=aoko"
msgid "\"Found a candle. Anyone got some matches?"
msgstr "「あ、蝋燭みつけた。誰かライター持ってない？"

#. Occurrence WIK_M_A:908:22651: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_M_A_0003; voice_prefix=A10; voice_category=1; scene=WIK_M_A
#: WIK_M_A:908
msgctxt "text_id=22651 | speaker=aoko"
msgid "  Or a lighter?\""
msgstr "　もしくはマッチ」"

#. Occurrence WIK_M_A:917:22652: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_M_A_0004; voice_prefix=B40; voice_category=8; scene=WIK_M_A
#: WIK_M_A:917
msgctxt "text_id=22652 | speaker=eiri"
msgid "\"When my Italian plumber lost weight, he got-a-lighter.\""
msgstr "「ちょっと待ッチ」"

#. Occurrence WIK_M_A:929:22653: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_M_A_0003; voice_prefix=B10; voice_category=5; scene=WIK_M_A
#: WIK_M_A:929
msgctxt "text_id=22653 | speaker=kojika"
msgid "\"Was that Father Eiri again?\""
msgstr "「え、今のも神父さん？」"

#. Occurrence WIK_M_A:955:22654: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_M_A_0003; voice_prefix=A30; voice_category=3; scene=WIK_M_A
#: WIK_M_A:955
msgctxt "text_id=22654 | speaker=soujuurou"
msgid "\"Oh, man. That was so bad.\""
msgstr "「酷い。酷すぎる」"

#. Occurrence WIK_M_A:967:22655: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_M_A_0001; voice_prefix=B20; voice_category=10; scene=WIK_M_A
#: WIK_M_A:967
msgctxt "text_id=22655 | speaker=yuika"
msgid "\"I feel dumber for having heard it.\""
msgstr "「脳が退化しているとしか思えません」"

#. Occurrence WIK_M_A:978:22656: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_M_A_0006; voice_prefix=B70; voice_category=4; scene=WIK_M_A
#: WIK_M_A:978
msgctxt "text_id=22656 | speaker=tobimaru"
msgid "\"Nah. I think the simple jokes actually work better given the primal circumstances we're in.\""
msgstr "「いや、この原始の状態じゃあ<知性|エスプリ>利かせてもインパクトねぇぞ。シンプルイズベストだ」"

#. Occurrence WIK_M_A:1021:22657: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_M_A_0004; voice_prefix=A30; voice_category=3; scene=WIK_M_A
#: WIK_M_A:1021
msgctxt "text_id=22657 | speaker=soujuurou"
msgid "\"Hey, be quiet. I think the power's coming back on.\""
msgstr "「あ。みんな静かに、電気つきそうだぞ」"

#. Occurrence WIK_M_A:1075:22658: scene=WIK_M_A
#: WIK_M_A:1075
msgctxt "text_id=22658 | speaker=unknown"
msgid "  Did the Kuonji Estate have its own power generator?"
msgstr "　久遠寺邸には自家発電装置でもあるのだろうか。"

#. Occurrence WIK_M_A:1080:22659: scene=WIK_M_A
#: WIK_M_A:1080
msgctxt "text_id=22659 | speaker=unknown"
msgid "  It wasn't clear who restored the power, but the drawing room was flooded with artificial light."
msgstr "　誰が復旧させたかはともかく、居間はあっさりと人工の明かりを取り戻した。"

#. Occurrence WIK_M_A:1105:22660: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_M_A_0009; voice_prefix=B80; voice_category=13; scene=WIK_M_A
#: WIK_M_A:1105
msgctxt "text_id=22660 | speaker=liddell"
msgid "\"Looks like this old mansion at least has some proper equipment. I was worried we were going to be stuck in the dark until morning.\""
msgstr "「あら、古くさい屋敷のクセに設備はしっかりしてるのね。このまま暗闇で朝まで過ごすのかと心配しちゃったわ」"

#. Occurrence WIK_M_A:1112:22661: scene=WIK_M_A
#: WIK_M_A:1112
msgctxt "text_id=22661 | speaker=unknown"
msgid "  Riddell had moved next to me at some point. She looked up."
msgstr "　いつの間にか隣にいたピンク女が顔をあげる。"

#. Occurrence WIK_M_A:1117:22662: scene=WIK_M_A
#: WIK_M_A:1117
msgctxt "text_id=22662 | speaker=unknown"
msgid "  I followed her gaze..."
msgstr "　わたしもつられて顔を上げて、"

#. Occurrence WIK_M_A:1273:22663: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_M_A_0010; voice_prefix=B80; voice_category=13; scene=WIK_M_A
#: WIK_M_A:1273
msgctxt "text_id=22663 | speaker=liddell"
msgid "\"Bwahahahaha―"
msgstr "「ぎゃははははははははは"

msgctxt "text_id=22664 | speaker=unknown"
msgid "Hurk!\""
msgstr "ぎごばぁ！？」"

#. Occurrence WIK_M_A:1428:22665: scene=WIK_M_A
#: WIK_M_A:1428
msgctxt "text_id=22665 | speaker=unknown"
msgid "  The pink girl took what looked like several impacts to the chest, spun around dramatically, and collapsed."
msgstr "　ピンク女は胸にドンドンドンと衝撃を受けて、くるくると踊りながら激倒した。"

#. Occurrence WIK_M_A:1474:22666: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_M_A_0004; voice_prefix=A10; voice_category=1; scene=WIK_M_A
#: WIK_M_A:1474
msgctxt "text_id=22666 | speaker=aoko"
msgid "\"Riddell?! What happened?!\""
msgstr "「リデル！？　ちょっと、何があったの！？」"

#. Occurrence WIK_M_A:1486:22667: scene=WIK_M_A
#: WIK_M_A:1486
msgctxt "text_id=22667 | speaker=unknown"
msgid "  Aozaki rushed over to her side."
msgstr "　蒼崎がリデルに駆け寄る。"

#. Occurrence WIK_M_A:1491:22668: scene=WIK_M_A
#: WIK_M_A:1491
msgctxt "text_id=22668 | speaker=unknown"
msgid "  I'd narrowly avoided the same fate."
msgstr "　わたしは間一髪の差で助かった。"

#. Occurrence WIK_M_A:1496:22669: scene=WIK_M_A
#: WIK_M_A:1496
msgctxt "text_id=22669 | speaker=unknown"
msgid "  If she hadn't started laughing first, I'd have busted a gut for sure."
msgstr "　ピンク女……リデルが先に笑っていなかったら、間違いなくわたしが笑っていただろう。"

#. Occurrence WIK_M_A:1554:22670: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_M_A_0005; voice_prefix=A10; voice_category=1; scene=WIK_M_A
#: WIK_M_A:1554
msgctxt "text_id=22670 | speaker=aoko"
msgid "\"Riddell! Hang in there!"
msgstr "「リデル、しっかりしなさいリデル！"

#. Occurrence WIK_M_A:1560:22671: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_M_A_0006; voice_prefix=A10; voice_category=1; scene=WIK_M_A
#: WIK_M_A:1560
msgctxt "text_id=22671 | speaker=aoko"
msgid "  Before you die, tell us what you saw! Was it the killer?!\""
msgstr "　死ぬ前に教えて、何を見たの！？　犯人？　犯人ね！？」"

#. Occurrence WIK_M_A:1567:22672: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_M_A_0011_0; voice_prefix=B80; voice_category=13; scene=WIK_M_A
#: WIK_M_A:1567
msgctxt "text_id=22672 | speaker=liddell"
msgid "\"H-Heh... No, something... much more... interesting...much worse... a squishy... demon..."
msgstr "「ふ、ふふ……そんな、つまんないヤツ、より……もっとおぞましくて、ぷにぷにした、悪魔、が―――"

#. Occurrence WIK_M_A:1577:22673: speaker=liddell; speaker_ja=リデル; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B80_WIK_M_A_0011_1; voice_prefix=B80; voice_category=13; scene=WIK_M_A
#: WIK_M_A:1577
msgctxt "text_id=22673 | speaker=liddell"
msgid "Blargh.\""
msgstr "ばたり」"

#. Occurrence WIK_M_A:1608:22674: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_M_A_0007; voice_prefix=A10; voice_category=1; scene=WIK_M_A
#: WIK_M_A:1608
msgctxt "text_id=22674 | speaker=aoko"
msgid "\"Riddell!!!\""
msgstr "「リデルーーーーーーー！」"

#. Occurrence WIK_M_A:1628:22675: scene=WIK_M_A
#: WIK_M_A:1628
msgctxt "text_id=22675 | speaker=unknown"
msgid "  Aozaki burst into tears, clutching May's lifeless body in her arms."
msgstr "　リデルを抱きかかえながら号泣する蒼崎。"

#. Occurrence WIK_M_A:1633:22676: scene=WIK_M_A
#: WIK_M_A:1633
msgctxt "text_id=22676 | speaker=unknown"
msgid "  They were probably more alike than they cared to admit."
msgstr "　似たもの同士、感じ入るものがあったらしい。"

#. Occurrence WIK_M_A:1645:22677: scene=WIK_M_A
#: WIK_M_A:1645
msgctxt "text_id=22677 | speaker=unknown"
msgid "  Amidst the commotion, Miss Kuonji returned, not appearing to have noticed the death."
msgstr "　そんな中、何事もなかったかのように戻ってくる久遠寺さん。"

#. Occurrence WIK_M_A:1672:22678: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_M_A_0001; voice_prefix=A40; voice_category=2; scene=WIK_M_A
#: WIK_M_A:1672
msgctxt "text_id=22678 | speaker=alice"
msgid "\"What's going on?\""
msgstr "「何かあったのかしら」"

#. Occurrence WIK_M_A:1682:22679: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_M_A_0007; voice_prefix=B70; voice_category=4; scene=WIK_M_A
#: WIK_M_A:1682
msgctxt "text_id=22679 | speaker=tobimaru"
msgid "\"I don't know. She just burst out laughing for no reason and then she was gone."
msgstr "「分からん。わけもなく爆笑して自滅した。"

#. Occurrence WIK_M_A:1682:22680: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_M_A_0007; voice_prefix=B70; voice_category=4; scene=WIK_M_A
#: WIK_M_A:1682
msgctxt "text_id=22680 | speaker=tobimaru"
msgid "  Don't think she's coming back from this one.\""
msgstr "　今度はさすがに復活は無理っぽい」"

#. Occurrence WIK_M_A:1716:22681: scene=WIK_M_A
#: WIK_M_A:1716
msgctxt "text_id=22681 | speaker=unknown"
msgid "  Perhaps out of pity, Tsukiji covered her with a tablecloth and lay her to rest at the side of the room."
msgstr "　とにかくこのままでは可哀想だ、と槻司はリデルにテーブルクロスをかけて部屋の隅に寝かせる。"

#. Occurrence WIK_M_A:1721:22682: scene=WIK_M_A
#: WIK_M_A:1721
msgctxt "text_id=22682 | speaker=unknown"
msgid "  I quietly shuffled over to Miss Kuonji and whispered in her ear."
msgstr "　わたしはそそそっ、と久遠寺さんに近づいて、耳打ちなど一つ。"

#. Occurrence WIK_M_A:1763:22683: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_M_A_0004; voice_prefix=B10; voice_category=5; scene=WIK_M_A
#: WIK_M_A:1763
msgctxt "text_id=22683 | speaker=kojika"
msgid "\"Miss Kuonji, what was *that*?!\""
msgstr "「久遠寺さん、今の、なに？」"

#. Occurrence WIK_M_A:1775:22684: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_M_A_0002; voice_prefix=A40; voice_category=2; scene=WIK_M_A
#: WIK_M_A:1775
msgctxt "text_id=22684 | speaker=alice"
msgid "\"I mixed up my change of clothes. Don't tell anyone, Kumari.\""
msgstr "「着替える服を間違えたの。みんなには黙っていてね、久万梨さん」"

#. Occurrence WIK_M_A:1787:22685: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_M_A_0005; voice_prefix=B10; voice_category=5; scene=WIK_M_A
#: WIK_M_A:1787
msgctxt "text_id=22685 | speaker=kojika"
msgid "\"...Okay, but you're not the killer, are you?\""
msgstr "「……いいけど。犯人じゃないのよね、貴女？」"

#. Occurrence WIK_M_A:1814:22686: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_M_A_0003; voice_prefix=A40; voice_category=2; scene=WIK_M_A
#: WIK_M_A:1814
msgctxt "text_id=22686 | speaker=alice"
msgid "\"Of course not. This was just a hobby of mine, don't worry."
msgstr "「ええ。今のはただの趣味だから安心して。"

#. Occurrence WIK_M_A:1826:22687: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_M_A_0004; voice_prefix=A40; voice_category=2; scene=WIK_M_A
#: WIK_M_A:1826
msgctxt "text_id=22687 | speaker=alice"
msgid "  For some reason, I've always felt like bullying her, and I can't explain why.\""
msgstr "　昔から、あの娘を見ていると何故かいじめたくなってしまって」"

#. Occurrence WIK_M_A:1837:22688: scene=WIK_M_A
#: WIK_M_A:1837
msgctxt "text_id=22688 | speaker=unknown"
msgid "  \"It's really too bad,\" she sighed."
msgstr "　困ったものだわ、と嘆息する久遠寺さん。"

#. Occurrence WIK_M_A:1842:22689: scene=WIK_M_A
#: WIK_M_A:1842
msgctxt "text_id=22689 | speaker=unknown"
msgid "  Again, I felt a little sorry for Riddell."
msgstr "　わたしは改めて、リデルにちょっとだけ同情したのだった。"

#. Occurrence WIK_M_A:1951:22690: scene=WIK_M_A
#: WIK_M_A:1951
msgctxt "text_id=22690 | speaker=unknown"
msgid "  That made four victims."
msgstr "　犠牲者は四人になった。"

#. Occurrence WIK_M_A:1956:22691: scene=WIK_M_A
#: WIK_M_A:1956
msgctxt "text_id=22691 | speaker=unknown"
msgid "  Everyone seemed resigned to locking ourselves in our rooms for the night."
msgstr "　ここにきて全体の雰囲気は“部屋に閉じこもって朝を待つ”方向に傾きつつある。"

#. Occurrence WIK_M_A:1962:22692: scene=WIK_M_A
#: WIK_M_A:1962
msgctxt "text_id=22692 | speaker=unknown"
msgid "  I..."
msgstr "　わたしは、"

#. Occurrence WIK_SELECT_N:8:22693: scene=WIK_SELECT_N
#: WIK_SELECT_N:8
msgctxt "text_id=22693 | speaker=unknown"
msgid "-Decision N-"
msgstr "～選択肢Ｎ～"

#. Occurrence WIK_N_1_A:93:22694: scene=WIK_N_1_A
#: WIK_N_1_A:93
msgctxt "text_id=22694 | speaker=unknown"
msgid "  ...I was roused by the sound of wind."
msgstr "　……風の音で目が覚めた。"

#. Occurrence WIK_N_1_A:98:22695: scene=WIK_N_1_A
#: WIK_N_1_A:98
msgctxt "text_id=22695 | speaker=unknown"
msgid "  The lights were out."
msgstr "　明かりは消えている。"

#. Occurrence WIK_N_1_A:104:22696: scene=WIK_N_1_A
#: WIK_N_1_A:104
msgctxt "text_id=22696 | speaker=unknown"
msgid "  I didn't remember turning them off before I went to sleep."
msgstr "　寝る前に消灯した記憶はない。"

msgctxt "text_id=22697 | speaker=unknown"
msgid " I got up and tried the light switch, but nothing happened."
msgstr "何事かと、起きて電灯のスイッチをいれてみたが、反応はない。"

#. Occurrence WIK_N_1_A:130:22698: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_N_1_A_0000; voice_prefix=B10; voice_category=5; scene=WIK_N_1_A
#: WIK_N_1_A:130
msgctxt "text_id=22698 | speaker=kojika"
msgid "\"...\""
msgstr "「……………………」"

#. Occurrence WIK_N_1_A:135:22699: scene=WIK_N_1_A
#: WIK_N_1_A:135
msgctxt "text_id=22699 | speaker=unknown"
msgid "  I wanted to check the time, but that wasn't happening in this darkness."
msgstr "　時間を確かめたいけど、この暗さでは確かめられない。"

#. Occurrence WIK_N_1_A:140:22700: scene=WIK_N_1_A
#: WIK_N_1_A:140
msgctxt "text_id=22700 | speaker=unknown"
msgid "  I tried my best to go back to sleep and pretend everything was okay, but I was too on edge. I could barely even stay still."
msgstr "　何にも気づかなかったフリをして寝直そうと努力したが、高ぶった神経は寝直す事も、じっとしている事も許してはくれなかった。"

#. Occurrence WIK_N_1_A:161:22701: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_N_1_A_0001; voice_prefix=B10; voice_category=5; scene=WIK_N_1_A
#: WIK_N_1_A:161
msgctxt "text_id=22701 | speaker=kojika"
msgid "\"Aozaki's room is the closest, right...?\""
msgstr "「……蒼崎の部屋が、一番近いよね……」"

#. Occurrence WIK_N_1_A:167:22702: scene=WIK_N_1_A
#: WIK_N_1_A:167
msgctxt "text_id=22702 | speaker=unknown"
msgid "  I moved as quietly as possible to the door, unlocked it, and peeked into the hallway."
msgstr "　わたしは物音をたてないよう、静かにドアまで移動して、鍵を開けて、そっと廊下をのぞき見た。"

#. Occurrence WIK_N_1_A:219:22703: scene=WIK_N_1_A
#: WIK_N_1_A:219
msgctxt "text_id=22703 | speaker=unknown"
msgid "  ...It seemed empty."
msgstr "　―――廊下に人の気配はない。"

#. Occurrence WIK_N_1_A:225:22704: scene=WIK_N_1_A
#: WIK_N_1_A:225
msgctxt "text_id=22704 | speaker=unknown"
msgid "  ...The only sound came from the wind and rain."
msgstr "　―――ただ、風の音と、雨の音だけが。"

#. Occurrence WIK_N_1_A:231:22705: scene=WIK_N_1_A
#: WIK_N_1_A:231
msgctxt "text_id=22705 | speaker=unknown"
msgid "  ...As if led by something, I ventured into the hallway and down towards Aozaki's room."
msgstr "　―――わたしは何かに誘われるように、廊下の突き当たりの蒼崎の部屋に向かった。"

#. Occurrence WIK_N_1_A:251:22706: scene=WIK_N_1_A
#: WIK_N_1_A:251
msgctxt "text_id=22706 | speaker=unknown"
msgid "  I placed my hand on her doorknob."
msgstr "　蒼崎の部屋のドアノブに手を置く。"

#. Occurrence WIK_N_1_A:274:22707: scene=WIK_N_1_A
#: WIK_N_1_A:274
msgctxt "text_id=22707 | speaker=unknown"
msgid "  It was unlocked."
msgstr "　鍵はかかっていなかった。"

#. Occurrence WIK_N_1_A:279:22708: scene=WIK_N_1_A
#: WIK_N_1_A:279
msgctxt "text_id=22708 | speaker=unknown"
msgid "  Inside her room, I found..."
msgstr "　部屋の中には、"

#. Occurrence WIK_N_1_A:316:22709: scene=WIK_N_1_A
#: WIK_N_1_A:316
msgctxt "text_id=22709 | speaker=unknown"
msgid "  ...a dead body. The corpse of a woman I've never seen before."
msgstr "　見知らぬ女性の、死体がひとつ。"

#. Occurrence WIK_N_1_A:337:22710: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_N_1_A_0002; voice_prefix=B10; voice_category=5; scene=WIK_N_1_A
#: WIK_N_1_A:337
msgctxt "text_id=22710 | speaker=kojika"
msgid "\"...!\""
msgstr "「――――――」"

#. Occurrence WIK_N_1_A:342:22711: scene=WIK_N_1_A
#: WIK_N_1_A:342
msgctxt "text_id=22711 | speaker=unknown"
msgid "  Did I scream? Did I manage to hold it in? I couldn't tell."
msgstr "　悲鳴を上げたのか、押し殺せたのか、自分でも分からない。"

#. Occurrence WIK_N_1_A:347:22712: scene=WIK_N_1_A
#: WIK_N_1_A:347
msgctxt "text_id=22712 | speaker=unknown"
msgid "  The rain tonight was too intense."
msgstr "　今夜は雨の音が強すぎる。"

#. Occurrence WIK_N_1_A:353:22713: scene=WIK_N_1_A
#: WIK_N_1_A:353
msgctxt "text_id=22713 | speaker=unknown"
msgid "  Creak. Creak."
msgstr "　きぃ、きぃ。"

#. Occurrence WIK_N_1_A:358:22714: scene=WIK_N_1_A
#: WIK_N_1_A:358
msgctxt "text_id=22714 | speaker=unknown"
msgid "  Oh, that wasn't the rain. It was the sound of hinges."
msgstr "　ああ、この音は雨音じゃなくて、<蝶番|ちょうつがい>の音。"

#. Occurrence WIK_N_1_A:363:22715: scene=WIK_N_1_A
#: WIK_N_1_A:363
msgctxt "text_id=22715 | speaker=unknown"
msgid "  I realized a door was swinging, and looked in its direction."
msgstr "　ドアが揺れている音だ、と視線を向ける。"

#. Occurrence WIK_N_1_A:383:22716: scene=WIK_N_1_A
#: WIK_N_1_A:383
msgctxt "text_id=22716 | speaker=unknown"
msgid "  It was coming from the room next to Aozaki's."
msgstr "　その音は、蒼崎の部屋のすぐ隣りの部屋からだった。"

#. Occurrence WIK_N_1_A:388:22717: scene=WIK_N_1_A
#: WIK_N_1_A:388
msgctxt "text_id=22717 | speaker=unknown"
msgid "  Sizuki told me before that it was her study."
msgstr "　そこが蒼崎の書斎であることは、静希から聞いていた。"

#. Occurrence WIK_N_1_A:393:22718: scene=WIK_N_1_A
#: WIK_N_1_A:393
msgctxt "text_id=22718 | speaker=unknown"
msgid "  Something was on the door."
msgstr "　扉には、"

#. Occurrence WIK_N_1_A:419:22719: scene=WIK_N_1_A
#: WIK_N_1_A:419
msgctxt "text_id=22719 | speaker=unknown"
msgid "  A liquid, thick... and red... like paint."
msgstr "　真っ赤な、ペンキみたいな、液体が、べったりと。"

#. Occurrence WIK_N_1_A:448:22720: scene=WIK_N_1_A
#: WIK_N_1_A:448
msgctxt "text_id=22720 | speaker=unknown"
msgid "  Inside the study"
msgstr "　書斎の中には"

#. Occurrence WIK_N_1_A:479:22721: scene=WIK_N_1_A
#: WIK_N_1_A:479
msgctxt "text_id=22721 | speaker=unknown"
msgid "  I found"
msgstr "　蒼崎青子の"

#. Occurrence WIK_N_1_A:525:22722: scene=WIK_N_1_A
#: WIK_N_1_A:525
msgctxt "text_id=22722 | speaker=unknown"
msgid "  the gruesome sight of"
msgstr "　無残な"

#. Occurrence WIK_N_1_A:571:22723: scene=WIK_N_1_A
#: WIK_N_1_A:571
msgctxt "text_id=22723 | speaker=unknown"
msgid "  Aoko Aozaki."
msgstr "　が。"

#. Occurrence WIK_N_1_A:639:22724: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_N_1_A_0003; voice_prefix=B10; voice_category=5; scene=WIK_N_1_A
#: WIK_N_1_A:639
msgctxt "text_id=22724 | speaker=kojika"
msgid "\"...!\""
msgstr "「―――！」"

#. Occurrence WIK_N_1_A:686:22725: scene=WIK_N_1_A
#: WIK_N_1_A:686
msgctxt "text_id=22725 | speaker=unknown"
msgid "  I ran down the hallway. I didn't care about making noise anymore. The storm was too loud to hear anything."
msgstr "　廊下を走る。もう物音なんて気にしていられない。そもそもこの嵐だ、走る気配なんてどうでもいい。"

#. Occurrence WIK_N_1_A:696:22726: scene=WIK_N_1_A
#: WIK_N_1_A:696
msgctxt "text_id=22726 | speaker=unknown"
msgid "  I threw open the door to each guest room."
msgstr "　わたしは客室という客室を開けていく。"

#. Occurrence WIK_N_1_A:705:22727: scene=WIK_N_1_A
#: WIK_N_1_A:705
msgctxt "text_id=22727 | speaker=unknown"
msgid "  In the third room, I find the lifeless body of the boy who'd been on my mind for three years."
msgstr "　三つ目で、この三年間、意識し続けた男子生徒の死体を発見した。"

#. Occurrence WIK_N_1_A:761:22728: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_N_1_A_0004; voice_prefix=B10; voice_category=5; scene=WIK_N_1_A
#: WIK_N_1_A:761
msgctxt "text_id=22728 | speaker=kojika"
msgid "\"Hah, hah, hah!\""
msgstr "「はっ、はっ、はっ―――！」"

#. Occurrence WIK_N_1_A:767:22729: scene=WIK_N_1_A
#: WIK_N_1_A:767
msgctxt "text_id=22729 | speaker=unknown"
msgid "  Panting, I nearly rolled down the stairs."
msgstr "　階段を転がるように下りる。"

#. Occurrence WIK_N_1_A:772:22730: scene=WIK_N_1_A
#: WIK_N_1_A:772
msgctxt "text_id=22730 | speaker=unknown"
msgid "  Too fast. I fell. My body bounced off the steps, and rolled into the foyer."
msgstr "　実際、転んでしまって体中を打ち付けながらロビーに転がりでた。"

#. Occurrence WIK_N_1_A:792:22731: scene=WIK_N_1_A
#: WIK_N_1_A:792
msgctxt "text_id=22731 | speaker=unknown"
msgid "  Nobody was around."
msgstr "　人の気配はない。"

#. Occurrence WIK_N_1_A:797:22732: scene=WIK_N_1_A
#: WIK_N_1_A:797
msgctxt "text_id=22732 | speaker=unknown"
msgid "  The front door's wide open, as if we had a visitor."
msgstr "　来訪者があったのか、玄関は開きっぱなしだ。"

#. Occurrence WIK_N_1_A:802:22733: scene=WIK_N_1_A
#: WIK_N_1_A:802
msgctxt "text_id=22733 | speaker=unknown"
msgid "  My instincts told me that the church members were already ____."
msgstr "　直感的に、教会の人たちも既に　　でいるのだと理解した。"

#. Occurrence WIK_N_1_A:826:22734: scene=WIK_N_1_A
#: WIK_N_1_A:826
msgctxt "text_id=22734 | speaker=unknown"
msgid "  I heard faint footsteps."
msgstr "　やけに耳に残る、靴の音。"

#. Occurrence WIK_N_1_A:831:22735: scene=WIK_N_1_A
#: WIK_N_1_A:831
msgctxt "text_id=22735 | speaker=unknown"
msgid "  The sound of the storm faded."
msgstr "　嵐の音が、意識から除外される。"

#. Occurrence WIK_N_1_A:836:22736: scene=WIK_N_1_A
#: WIK_N_1_A:836
msgctxt "text_id=22736 | speaker=unknown"
msgid "  All sounds around me washed away."
msgstr "　わたしの世界から、あらゆる音が途絶えていく。"

#. Occurrence WIK_N_1_A:841:22737: scene=WIK_N_1_A
#: WIK_N_1_A:841
msgctxt "text_id=22737 | speaker=unknown"
msgid "  In front of me..."
msgstr "　目の前には、"

#. Occurrence WIK_N_1_A:863:22738: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_N_1_A_0005; voice_prefix=B10; voice_category=5; scene=WIK_N_1_A
#: WIK_N_1_A:863
msgctxt "text_id=22738 | speaker=kojika"
msgid "\"Ahh...\""
msgstr "「ああ―――」"

#. Occurrence WIK_N_1_A:869:22739: scene=WIK_N_1_A
#: WIK_N_1_A:869
msgctxt "text_id=22739 | speaker=unknown"
msgid "  I felt nothing. No fear. No anger."
msgstr "　恐怖も怒りも、なんにもない。"

#. Occurrence WIK_N_1_A:874:22740: scene=WIK_N_1_A
#: WIK_N_1_A:874
msgctxt "text_id=22740 | speaker=unknown"
msgid "  My heart was as calm as a lake, as I laid eyes on the stormy night killer."
msgstr "　わたしは静かな心持ちで、嵐の夜の殺人鬼を見た。"

#. Occurrence WIK_N_1_A:954:22741: scene=WIK_N_1_A
#: WIK_N_1_A:954
msgctxt "text_id=22741 | speaker=unknown"
msgid "  Two eyes flashed in the darkness."
msgstr "　闇の中で光る二つの目。"

#. Occurrence WIK_N_1_A:959:22742: scene=WIK_N_1_A
#: WIK_N_1_A:959
msgctxt "text_id=22742 | speaker=unknown"
msgid "  Light glinted off the weapon in their hands."
msgstr "　そいつの手にある凶器が光を放つ。"

#. Occurrence WIK_N_1_A:1007:22743: scene=WIK_N_1_A
#: WIK_N_1_A:1007
msgctxt "text_id=22743 | speaker=unknown"
msgid "  Their face was unworldly, twisted, demonic."
msgstr "　―――この世のものとは思えない、いびつにゆがんだ鬼の<面|かお>。"

#. Occurrence WIK_N_1_A:1012:22744: scene=WIK_N_1_A
#: WIK_N_1_A:1012
msgctxt "text_id=22744 | speaker=unknown"
msgid "  It was the last thing I ever saw."
msgstr "　それが、わたしの見た、この夜最後の映像だった―――"

#. Occurrence WIK_N_1:30:22745: scene=WIK_N_1
#: WIK_N_1:30
msgctxt "text_id=22745 | speaker=unknown"
msgid "  I agreed that it was the best option we had."
msgstr "　わたしは、その意見に賛成すべきだ、と思った。"

#. Occurrence WIK_N_1:60:22746: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_N_1_0000; voice_prefix=A10; voice_category=1; scene=WIK_N_1
#: WIK_N_1:60
msgctxt "text_id=22746 | speaker=aoko"
msgid "\"We won't gain anything from grilling each other. Let's just make a decision."
msgstr "「ここで腹の探り合いをしていても空しいだけね。いいかげん決を採りましょう。"

#. Occurrence WIK_N_1:66:22747: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_N_1_0001; voice_prefix=A10; voice_category=1; scene=WIK_N_1
#: WIK_N_1:66
msgctxt "text_id=22747 | speaker=aoko"
msgid "  Raise your hand if you think we should stay in our rooms until morning.\""
msgstr "　自分の部屋に閉じこもって朝を待つ、に賛成な人」"

#. Occurrence WIK_N_1:102:22748: scene=WIK_N_1
#: WIK_N_1:102
msgctxt "text_id=22748 | speaker=unknown"
msgid "  I raised my hand."
msgstr "　賛成、と手を挙げる。"

#. Occurrence WIK_N_1:108:22749: scene=WIK_N_1
#: WIK_N_1:108
msgctxt "text_id=22749 | speaker=unknown"
msgid "  In favor were... Aozaki, Sister Yuika, Sizuki, and..."
msgstr "　手を挙げたのはわたし、蒼崎、唯架さん、静希……と、"

msgctxt "text_id=22750 | speaker=unknown"
msgid " Beo, who voted along with Sizuki."
msgstr "それにつられてベオの五人。"

#. Occurrence WIK_N_1:142:22751: scene=WIK_N_1
#: WIK_N_1:142
msgctxt "text_id=22751 | speaker=unknown"
msgid "  Those against were Ritsuka, Father Eiri, Tsukiji, and Miss Kuonji."
msgstr "　反対は律架さん、詠梨神父、槻司、久遠寺さんの四人。"

#. Occurrence WIK_N_1:147:22752: scene=WIK_N_1
#: WIK_N_1:147
msgctxt "text_id=22752 | speaker=unknown"
msgid "  With Beo as the tiebreaker, our side won."
msgstr "　ベオの差でわたしたちの勝ちである。"

#. Occurrence WIK_N_1:172:22753: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_N_1_0002; voice_prefix=A10; voice_category=1; scene=WIK_N_1
#: WIK_N_1:172
msgctxt "text_id=22753 | speaker=aoko"
msgid "\"That settles it. Everyone go to your rooms, lock them, and don't leave until morning."
msgstr "「決まりね。それじゃ各自、部屋にこもって、しっかり鍵かけて、朝まで外にでないこと。"

#. Occurrence WIK_N_1:184:22754: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_N_1_0003; voice_prefix=A10; voice_category=1; scene=WIK_N_1
#: WIK_N_1:184
msgctxt "text_id=22754 | speaker=aoko"
msgid "  If you need anything, get it from the kitchen now."
msgstr "　必要な物があったら台所から持っていって。"

#. Occurrence WIK_N_1:196:22755: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_N_1_0004; voice_prefix=A10; voice_category=1; scene=WIK_N_1
#: WIK_N_1:196
msgctxt "text_id=22755 | speaker=aoko"
msgid "  If you need to use the toilet, hold it.\""
msgstr "　あと、トイレは精神的に耐えきって」"

#. Occurrence WIK_N_1:233:22756: scene=WIK_N_1
#: WIK_N_1:233
msgctxt "text_id=22756 | speaker=unknown"
msgid "  Everyone had to be exhausted from a long night of deduction."
msgstr "　みんな長時間の推理に疲れていたのだろう。"

#. Occurrence WIK_N_1:238:22757: scene=WIK_N_1
#: WIK_N_1:238
msgctxt "text_id=22757 | speaker=unknown"
msgid "  We barely spoke as we headed off to our respective rooms."
msgstr "　とくに何を言うでもなく、あてがわれた部屋に向かっていった。"

#. Occurrence WIK_N_1:288:22758: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_N_1_0000; voice_prefix=B10; voice_category=5; scene=WIK_N_1
#: WIK_N_1:288
msgctxt "text_id=22758 | speaker=kojika"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence WIK_N_1:294:22759: scene=WIK_N_1
#: WIK_N_1:294
msgctxt "text_id=22759 | speaker=unknown"
msgid "  I locked the door and lay down on the bed."
msgstr "　鍵をかけてベッドに横になる。"

#. Occurrence WIK_N_1:301:22760: scene=WIK_N_1
#: WIK_N_1:301
msgctxt "text_id=22760 | speaker=unknown"
msgid "  Just in case, I decided not to change into my pajamas."
msgstr "　万が一の事態に対応できるよう、寝間着には着替えていない。"

#. Occurrence WIK_N_1:329:22761: scene=WIK_N_1
#: WIK_N_1:329
msgctxt "text_id=22761 | speaker=unknown"
msgid "  The day was almost over."
msgstr "　もうじき日付が変わる。"

#. Occurrence WIK_N_1:334:22762: scene=WIK_N_1
#: WIK_N_1:334
msgctxt "text_id=22762 | speaker=unknown"
msgid "  Once midnight passed, the first day of our three-day break would come to a close."
msgstr "　零時を過ぎれば連休の一日目が終わる。"

#. Occurrence WIK_N_1:339:22763: scene=WIK_N_1
#: WIK_N_1:339
msgctxt "text_id=22763 | speaker=unknown"
msgid "  I never imagined spending a vacation like this in a million years."
msgstr "　せっかくの三連休がこんなカタチで始まるなんて、夢にも思わなかった。"

#. Occurrence WIK_N_1:371:22764: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_N_1_0001; voice_prefix=B10; voice_category=5; scene=WIK_N_1
#: WIK_N_1:371
msgctxt "text_id=22764 | speaker=kojika"
msgid "\"...Oh, crap... getting... sleepy...\""
msgstr "「……まず……すごく眠い、わたし……」"

#. Occurrence WIK_N_1:377:22765: scene=WIK_N_1
#: WIK_N_1:377
msgctxt "text_id=22765 | speaker=unknown"
msgid "  My eyelids grew heavy the instant I lay down."
msgstr "　横になったとたん、目蓋が重くなっていく。"

#. Occurrence WIK_N_1:382:22766: scene=WIK_N_1
#: WIK_N_1:382
msgctxt "text_id=22766 | speaker=unknown"
msgid "  I knew I still had things to consider, but warm slumber embraced me in moments."
msgstr "　もっと考えるべき事があるのに、わたしは急速に、浅い眠りに落ちていった。"

#. Occurrence WIK_N_2:30:22767: scene=WIK_N_2
#: WIK_N_2:30
msgctxt "text_id=22767 | speaker=unknown"
msgid "  I think it's too dangerous to hole up in our rooms."
msgstr "　わたしは、部屋に閉じこもるのは危険だ、と思った。"

#. Occurrence WIK_N_2:35:22768: scene=WIK_N_2
#: WIK_N_2:35
msgctxt "text_id=22768 | speaker=unknown"
msgid "  The reason being..."
msgstr "　その根拠として―――"

#. Occurrence WIK_SELECT_O:8:22769: scene=WIK_SELECT_O
#: WIK_SELECT_O:8
msgctxt "text_id=22769 | speaker=unknown"
msgid "-Decision O-"
msgstr "～選択肢Ｏ～"

#. Occurrence WIK_NAP:27:22770: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_NAP_0000; voice_prefix=B10; voice_category=5; scene=WIK_NAP
#: WIK_NAP:27
msgctxt "text_id=22770 | speaker=kojika"
msgid "\"Whew, I'm beat.\""
msgstr "「はー、疲れたぁ」"

#. Occurrence WIK_NAP:50:22771: scene=WIK_NAP
#: WIK_NAP:50
msgctxt "text_id=22771 | speaker=unknown"
msgid "  I plopped my butt down on the bed."
msgstr "　ぼすん、とベッドに腰を下ろす。"

#. Occurrence WIK_NAP:55:22772: scene=WIK_NAP
#: WIK_NAP:55
msgctxt "text_id=22772 | speaker=unknown"
msgid "  I was always self-conscious around Tsukiji, but Miss Kuonji made me nervous in a different way."
msgstr "　槻司と話すのも気を遣うが、久遠寺さんとはまた違った意味で緊張する。"

#. Occurrence WIK_NAP:93:22773: scene=WIK_NAP
#: WIK_NAP:93
msgctxt "text_id=22773 | speaker=unknown"
msgid "  For some reason, I always felt a pang of guilt whenever she looked at me."
msgstr "　あの<娘|こ>に見つめられると妙な罪悪感に襲われるのだ。"

#. Occurrence WIK_NAP:98:22774: scene=WIK_NAP
#: WIK_NAP:98
msgctxt "text_id=22774 | speaker=unknown"
msgid "  It was like being gently interrogated, being confronted with all of my life's failures."
msgstr "　痛くもない腹を探られているというか、自分がしでかしてきた多くの失敗を責め立てられているような。"

#. Occurrence WIK_NAP:124:22775: scene=WIK_NAP
#: WIK_NAP:124
msgctxt "text_id=22775 | speaker=unknown"
msgid "  I doubt she meant to make me feel that way. It was just how I reacted to her."
msgstr "　彼女本人にその気はまったくないらしいから、これはわたしの心の問題だろう。"

#. Occurrence WIK_NAP:129:22776: scene=WIK_NAP
#: WIK_NAP:129
msgctxt "text_id=22776 | speaker=unknown"
msgid "  Nobody was perfect, after all."
msgstr "　誰だって叩けばホコリは出る、というヤツである。"

#. Occurrence WIK_NAP:172:22777: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_NAP_0001; voice_prefix=B10; voice_category=5; scene=WIK_NAP
#: WIK_NAP:172
msgctxt "text_id=22777 | speaker=kojika"
msgid "\"I don't know how Aozaki and Sizuki can live with her every day.\""
msgstr "「蒼崎も静希も、よくあの娘と暮らせるもんだわ」"

#. Occurrence WIK_NAP:178:22778: scene=WIK_NAP
#: WIK_NAP:178
msgctxt "text_id=22778 | speaker=unknown"
msgid "  I could only respect them for that."
msgstr "　そこは素直に尊敬する。"

#. Occurrence WIK_NAP:186:22779: scene=WIK_NAP
#: WIK_NAP:186
msgctxt "text_id=22779 | speaker=unknown"
msgid "  Aozaki simply had an iron will; I bet she lived life without any regrets."
msgstr "　蒼崎は鉄の精神力、かつ、後ろめたいものがないからだろう。"

#. Occurrence WIK_NAP:197:22780: scene=WIK_NAP
#: WIK_NAP:197
msgctxt "text_id=22780 | speaker=unknown"
msgid "  Sizuki was completely different; it was clear he was just oblivious to how scary Miss Kuonji's gaze could be."
msgstr "　静希の場合は逆で、久遠寺さんの視線の怖さにまったく気付いていないと見た。"

#. Occurrence WIK_NAP:245:22781: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_NAP_0002; voice_prefix=B10; voice_category=5; scene=WIK_NAP
#: WIK_NAP:245
msgctxt "text_id=22781 | speaker=kojika"
msgid "\"Anyway...\""
msgstr "「それはともかく」"

#. Occurrence WIK_NAP:255:22782: scene=WIK_NAP
#: WIK_NAP:255
msgctxt "text_id=22782 | speaker=unknown"
msgid "  I fell backward onto the bed."
msgstr "　ばふん、とベッドに仰向けに寝ころぶ。"

#. Occurrence WIK_NAP:280:22783: scene=WIK_NAP
#: WIK_NAP:280
msgctxt "text_id=22783 | speaker=unknown"
msgid "  Outside my window, the sky was overcast."
msgstr "　窓ごしの空は曇天。"

#. Occurrence WIK_NAP:285:22784: scene=WIK_NAP
#: WIK_NAP:285
msgctxt "text_id=22784 | speaker=unknown"
msgid "  The weather forecast had said the three-day weekend was supposed to be sunny. Not so in the mountains, I suppose."
msgstr "　天気予報によると、この三連休はぜんぶ晴れらしいけど、山の天気はそのかぎりではないらしい。"

#. Occurrence WIK_NAP:327:22785: scene=WIK_NAP
#: WIK_NAP:327
msgctxt "text_id=22785 | speaker=unknown"
msgid "  At this point, I'd met six people staying here:"
msgstr "　久遠寺邸に集まった人間で、きちんと挨拶をしたのは今のところ六人。"

#. Occurrence WIK_NAP:334:22786: scene=WIK_NAP
#: WIK_NAP:334
msgctxt "text_id=22786 | speaker=unknown"
msgid "  Aozaki,"
msgstr "　蒼崎、"

#. Occurrence WIK_NAP:342:22787: scene=WIK_NAP
#: WIK_NAP:342
msgctxt "text_id=22787 | speaker=unknown"
msgid " Miss Kuonji,"
msgstr "久遠寺さん、"

#. Occurrence WIK_NAP:350:22788: scene=WIK_NAP
#: WIK_NAP:350
msgctxt "text_id=22788 | speaker=unknown"
msgid " Sizuki,"
msgstr "静希、"

#. Occurrence WIK_NAP:359:22789: scene=WIK_NAP
#: WIK_NAP:359
msgctxt "text_id=22789 | speaker=unknown"
msgid " Tsukiji"
msgstr "槻司、"

#. Occurrence WIK_NAP:368:22790: scene=WIK_NAP
#: WIK_NAP:368
msgctxt "text_id=22790 | speaker=unknown"
msgid " that idiot Housuke,"
msgstr "<芳|バ><助|カ>、"

#. Occurrence WIK_NAP:376:22791: scene=WIK_NAP
#: WIK_NAP:376
msgctxt "text_id=22791 | speaker=unknown"
msgid " Mr. Yamasiro,"
msgstr "山城先生、"

#. Occurrence WIK_NAP:385:22792: scene=WIK_NAP
#: WIK_NAP:385
msgctxt "text_id=22792 | speaker=unknown"
msgid " and Beo."
msgstr "ベオ。"

#. Occurrence WIK_NAP:390:22793: scene=WIK_NAP
#: WIK_NAP:390
msgctxt "text_id=22793 | speaker=unknown"
msgid "  Miss Kuonji had implied that there were other guests staying here, too."
msgstr "　他にもゲストがいるような事を久遠寺さんは言っていた。"

#. Occurrence WIK_NAP:407:22794: scene=WIK_NAP
#: WIK_NAP:407
msgctxt "text_id=22794 | speaker=unknown"
msgid "  This was a Western-style house and people didn't take their shoes off at the entrance, so I couldn't guess their number by counting shoes."
msgstr "　この洋館では玄関で靴は脱がないので、靴の数で人数を特定する事はできない。"

#. Occurrence WIK_NAP:412:22795: scene=WIK_NAP
#: WIK_NAP:412
msgctxt "text_id=22795 | speaker=unknown"
msgid "  For now, I had no idea how many other people were here."
msgstr "　館内に何人の人間がいるのか、いまいち定まらないのはそのせいだ。"

#. Occurrence WIK_NAP:456:22796: scene=WIK_NAP
#: WIK_NAP:456
msgctxt "text_id=22796 | speaker=unknown"
msgid "  I decided to rest my eyes and take a short nap."
msgstr "　目蓋を閉じて、少しだけ眠る事にした。"

#. Occurrence WIK_NAP:461:22797: scene=WIK_NAP
#: WIK_NAP:461
msgctxt "text_id=22797 | speaker=unknown"
msgid "  One trick I'd picked up from years of part-time work was the ability to sleep in exact 15-minute intervals."
msgstr "　小刻みなアルバイト生活の<賜|たまもの>か、わたしは十五分単位での仮眠を得意としている。"

#. Occurrence WIK_NAP:482:22798: scene=WIK_NAP
#: WIK_NAP:482
msgctxt "text_id=22798 | speaker=unknown"
msgid "  ..."
msgstr "　……。"

#. Occurrence WIK_NAP:487:22799: scene=WIK_NAP
#: WIK_NAP:487
msgctxt "text_id=22799 | speaker=unknown"
msgid "  ......"
msgstr "　………………。"

#. Occurrence WIK_NAP:492:22800: scene=WIK_NAP
#: WIK_NAP:492
msgctxt "text_id=22800 | speaker=unknown"
msgid "  ........."
msgstr "　………………………………。"

#. Occurrence WIK_NAP:497:22801: scene=WIK_NAP
#: WIK_NAP:497
msgctxt "text_id=22801 | speaker=unknown"
msgid "  As I drifted off, I heard a laugh. Or was it a scream?"
msgstr "　薄いまどろみの中、どこかで、悲鳴のような笑い声が聞こえた気がした。"

#. Occurrence WIK_NOROOM:74:22802: scene=WIK_NOROOM
#: WIK_NOROOM:74
msgctxt "text_id=22802 | speaker=unknown"
msgid "  Slinging over my shoulder the bag I'd put down in the drawing room, I headed up to the guest rooms on the second floor."
msgstr "　居間に置いておいた荷物を肩に担いで、二階の客室を目指す。"

#. Occurrence WIK_NOROOM:79:22803: scene=WIK_NOROOM
#: WIK_NOROOM:79
msgctxt "text_id=22803 | speaker=unknown"
msgid "  According to Aozaki, I would be staying in the second room of the east wing."
msgstr "　蒼崎の話では二階の東館、手前から二つ目がわたしに宛がわれた部屋だそうだ。"

#. Occurrence WIK_NOROOM:135:22804: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_NOROOM_0000; voice_prefix=A10; voice_category=1; scene=WIK_NOROOM
#: WIK_NOROOM:135
msgctxt "text_id=22804 | speaker=aoko"
msgid "\"Oh.\""
msgstr "「あら」"

#. Occurrence WIK_NOROOM:140:22805: scene=WIK_NOROOM
#: WIK_NOROOM:140
msgctxt "text_id=22805 | speaker=unknown"
msgid "  As I headed out into the hallway, I ran into Aozaki."
msgstr "　廊下に出ると、蒼崎と出くわした。"

#. Occurrence WIK_NOROOM:145:22806: scene=WIK_NOROOM
#: WIK_NOROOM:145
msgctxt "text_id=22806 | speaker=unknown"
msgid "  She seemed to be on her way from the bedrooms to the hall."
msgstr "　彼女は廊下の奥から、ホールに向かっていたところらしい。"

#. Occurrence WIK_NOROOM:166:22807: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_NOROOM_0000; voice_prefix=B10; voice_category=5; scene=WIK_NOROOM
#: WIK_NOROOM:166
msgctxt "text_id=22807 | speaker=kojika"
msgid "\"You taking a break too, Aozaki? Is that your room on the end there?\""
msgstr "「蒼崎も休憩？　あの突き当たりってアンタの部屋なの？」"

#. Occurrence WIK_NOROOM:178:22808: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_NOROOM_0001; voice_prefix=A10; voice_category=1; scene=WIK_NOROOM
#: WIK_NOROOM:178
msgctxt "text_id=22808 | speaker=aoko"
msgid "\"Um, y-yeah, but I'm not going in there."
msgstr "「え、そ、そうだけど、別に部屋には寄ってないわよ？"

#. Occurrence WIK_NOROOM:190:22809: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_NOROOM_0002; voice_prefix=A10; voice_category=1; scene=WIK_NOROOM
#: WIK_NOROOM:190
msgctxt "text_id=22809 | speaker=aoko"
msgid "  I'm just looking for something. Don't mind me."
msgstr "　私はちょっとした探し物の途中だから、気にしないで。"

#. Occurrence WIK_NOROOM:202:22810: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_NOROOM_0003; voice_prefix=A10; voice_category=1; scene=WIK_NOROOM
#: WIK_NOROOM:202
msgctxt "text_id=22810 | speaker=aoko"
msgid "  Oh, the door to your room's open. I left your key on the desk, so make sure to lock the door whenever you leave.\""
msgstr "　あ、客室の鍵は開いてるから。部屋の机の上に鍵があるから、出る時はそれで施錠してね」"

#. Occurrence WIK_NOROOM:214:22811: scene=WIK_NOROOM
#: WIK_NOROOM:214
msgctxt "text_id=22811 | speaker=unknown"
msgid "  Aozaki took the stairs down to the first floor."
msgstr "　蒼崎は一階に下りていった。"

#. Occurrence WIK_NOROOM:265:22812: scene=WIK_NOROOM
#: WIK_NOROOM:265
msgctxt "text_id=22812 | speaker=unknown"
msgid "  My room was unoccupied."
msgstr "　部屋には誰もいない。"

#. Occurrence WIK_NOROOM:270:22813: scene=WIK_NOROOM
#: WIK_NOROOM:270
msgctxt "text_id=22813 | speaker=unknown"
msgid "  I checked to make sure I was alone, then put down my luggage and stowed my wallet in a pocket."
msgstr "　わたしは無人である事を確かめて、荷物を置き、サイフをポケットにいれた。"

#. Occurrence WIK_NOROOM:275:22814: scene=WIK_NOROOM
#: WIK_NOROOM:275
msgctxt "text_id=22814 | speaker=unknown"
msgid "  I considered keeping my favorite bunny-shaped commuter pass-and lucky charm-with me, but all it contained was a yearly school festival photo anyway. I left it on the table."
msgstr "　お<守|まも>り<兼|けん>お気に入りである<×口|バツくち>兎のパスケースを携帯するかは迷ったが、どうせ中には定期と学祭での記念写真しか入っていないので、テーブルに置いておく。"

#. Occurrence WIK_NOROOM:280:22815: scene=WIK_NOROOM
#: WIK_NOROOM:280
msgctxt "text_id=22815 | speaker=unknown"
msgid "  I was going to be spending the night in an unfamiliar building. It was best to travel light."
msgstr "　馴染みのない建物で過ごすのだ。体はできるだけ身軽の方が疲れない。"

#. Occurrence WIK_NOROOM:301:22816: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_NOROOM_0001; voice_prefix=B10; voice_category=5; scene=WIK_NOROOM
#: WIK_NOROOM:301
msgctxt "text_id=22816 | speaker=kojika"
msgid "\"Where's that key...? Oh, here it is.\""
msgstr "「鍵は……ああ、これね」"

#. Occurrence WIK_NOROOM:307:22817: scene=WIK_NOROOM
#: WIK_NOROOM:307
msgctxt "text_id=22817 | speaker=unknown"
msgid "  It was a brass key, with an old-fashioned and elaborate design that perfectly complemented the mansion's European theme."
msgstr "　<真鍮|しんちゅう>の鍵。この洋館に相応しい、古めかしくも凝ったデザインだった。"

#. Occurrence WIK_O:30:22818: scene=WIK_O
#: WIK_O:30
msgctxt "text_id=22818 | speaker=unknown"
msgid "  I thought it was best to tackle the problem now."
msgstr "　今こそ、あの問題を追及しようと思った。"

#. Occurrence WIK_O:54:22819: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_O_0000; voice_prefix=A10; voice_category=1; scene=WIK_O
#: WIK_O:54
msgctxt "text_id=22819 | speaker=aoko"
msgid "\"Okay everyone, to your―\""
msgstr "「それじゃあ各自、自分の部屋に―――」"

#. Occurrence WIK_O:65:22820: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_O_0000; voice_prefix=B10; voice_category=5; scene=WIK_O
#: WIK_O:65
msgctxt "text_id=22820 | speaker=kojika"
msgid "\"Wait. Before that, I want to check something."
msgstr "「ちょっと待って。その前に確かめたい事がある。"

#. Occurrence WIK_O:77:22821: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_O_0001; voice_prefix=B10; voice_category=5; scene=WIK_O
#: WIK_O:77
msgctxt "text_id=22821 | speaker=kojika"
msgid "  Does everybody know how many guests are here today?\""
msgstr "　みんな、今日のゲストは何人か、分かってる？」"

#. Occurrence WIK_O:86:22822: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_O_0000; voice_prefix=B70; voice_category=4; scene=WIK_O
#: WIK_O:86
msgctxt "text_id=22822 | speaker=tobimaru"
msgid "\"Thirteen, including Kuonji."
msgstr "「何人かって、久遠寺いれて十三人だろ。"

#. Occurrence WIK_O:86:22823: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_O_0000; voice_prefix=B70; voice_category=4; scene=WIK_O
#: WIK_O:86
msgctxt "text_id=22823 | speaker=tobimaru"
msgid "  What about it?\""
msgstr "　それがどうかしたか？」"

#. Occurrence WIK_O:98:22824: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_O_0002; voice_prefix=B10; voice_category=5; scene=WIK_O
#: WIK_O:98
msgctxt "text_id=22824 | speaker=kojika"
msgid "\"Does that include Riddell?\""
msgstr "「それはリデルを入れての話？」"

#. Occurrence WIK_O:125:22825: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_O_0001; voice_prefix=B70; voice_category=4; scene=WIK_O
#: WIK_O:125
msgctxt "text_id=22825 | speaker=tobimaru"
msgid "\"What...?\""
msgstr "「―――なに？」"

#. Occurrence WIK_O:145:22826: scene=WIK_O
#: WIK_O:145
msgctxt "text_id=22826 | speaker=unknown"
msgid "  Tsukiji's eyes went wide."
msgstr "　槻司の目が見開かれる。"

#. Occurrence WIK_O:151:22827: scene=WIK_O
#: WIK_O:151
msgctxt "text_id=22827 | speaker=unknown"
msgid "  He was acquainted with Riddell, so her being here hadn't felt out of place to him."
msgstr "　リデルと顔見知りである槻司からすれば、リデルは参加していても違和感のないメンバーだ。"

#. Occurrence WIK_O:156:22828: scene=WIK_O
#: WIK_O:156
msgctxt "text_id=22828 | speaker=unknown"
msgid "  But, to someone like me who didn't know her, she stuck out like a sore thumb."
msgstr "　けれど彼女とは疎遠なわたしからすれば、リデルの登場は不自然であり、予定外だった。"

#. Occurrence WIK_O:161:22829: scene=WIK_O
#: WIK_O:161
msgctxt "text_id=22829 | speaker=unknown"
msgid "  She had crashed the party without a formal invitation."
msgstr "　彼女はあくまで乱入者であり、正式な招待客ではないからだ。"

#. Occurrence WIK_O:187:22830: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_O_0002; voice_prefix=B70; voice_category=4; scene=WIK_O
#: WIK_O:187
msgctxt "text_id=22830 | speaker=tobimaru"
msgid "\"Now you mention it, Riddell wasn't actually invited. So I suppose there's only twelve of us.\""
msgstr "「そうか。リデルは招かれていない。ゲストとは数えないから、最終的な人数は十二人になる」"

#. Occurrence WIK_O:199:22831: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_O_0003; voice_prefix=B10; voice_category=5; scene=WIK_O
#: WIK_O:199
msgctxt "text_id=22831 | speaker=kojika"
msgid "\"Do you mind explaining, Miss Kuonji?\""
msgstr "「どういう事か説明してくれる、久遠寺さん？」"

#. Occurrence WIK_O:243:22832: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_O_0000; voice_prefix=A40; voice_category=2; scene=WIK_O
#: WIK_O:243
msgctxt "text_id=22832 | speaker=alice"
msgid "\"...I didn't realize, either. Aoko and Sizuki were in charge of sending out invitations."
msgstr "「……そうね。わたしもうっかりしていたわ。招待状はわたしと青子、静希君で分けて出したの。"

#. Occurrence WIK_O:255:22833: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_O_0001; voice_prefix=A40; voice_category=2; scene=WIK_O
#: WIK_O:255
msgctxt "text_id=22833 | speaker=alice"
msgid "  No one told me they only set out nine invitations. Tokie and I are the hosts, so including Aoko and Sizuki that should've been thirteen."
msgstr "　最終的に九枚消費したとしか、わたしは聞いていなかったから。わたしとトッキィーはホストで、青子と静希君は知っていたから、合わせて十三人だって。"

#. Occurrence WIK_O:267:22834: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_O_0002; voice_prefix=A40; voice_category=2; scene=WIK_O
#: WIK_O:267
msgctxt "text_id=22834 | speaker=alice"
msgid "  Oh, I should mention,"
msgstr "　ちなみに、わたしは"

msgctxt "text_id=22835 | speaker=unknown"
msgid " I personally sent invitations to Ritsuka"
msgstr "律架さんと"

msgctxt "text_id=22836 | speaker=unknown"
msgid " and Beo.\""
msgstr "ベオに招待状を送ったわ」"

#. Occurrence WIK_O:344:22837: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_O_0001; voice_prefix=A10; voice_category=1; scene=WIK_O
#: WIK_O:344
msgctxt "text_id=22837 | speaker=aoko"
msgid "\"I invited "
msgstr "「私は"

msgctxt "text_id=22838 | speaker=unknown"
msgid "Eiri, "
msgstr "詠梨と"

msgctxt "text_id=22839 | speaker=unknown"
msgid "Yuika, "
msgstr "唯架さん、"

msgctxt "text_id=22840 | speaker=unknown"
msgid "Kinomi, "
msgstr "木乃美と"

msgctxt "text_id=22841 | speaker=unknown"
msgid "and Tobimaru.\""
msgstr "鳶丸」"

#. Occurrence WIK_O:447:22842: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_O_0000_0; voice_prefix=A30; voice_category=3; scene=WIK_O
#: WIK_O:447
msgctxt "text_id=22842 | speaker=soujuurou"
msgid "\"I invited "
msgstr "「自分は"

msgctxt "text_id=22843 | speaker=unknown"
msgid "Kumari. "
msgstr "久万梨と、"

msgctxt "text_id=22844 | speaker=unknown"
msgid "I gave the leftover invitations to "
msgstr "最後に余ったのを"

msgctxt "text_id=22845 | speaker=unknown"
msgid "Mr. Yamasiro and "
msgstr "先生と、"

#. Occurrence WIK_O:479:22846: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_O_0000_1; voice_prefix=A30; voice_category=3; scene=WIK_O
#: WIK_O:479
msgctxt "text_id=22846 | speaker=soujuurou"
msgid "someone I really, really "
msgstr "とても名前を口に"

msgctxt "text_id=22847 | speaker=unknown"
msgid "shouldn't mention out loud.\""
msgstr "できない人に一枚」"

#. Occurrence WIK_O:539:22848: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_O_0002; voice_prefix=A10; voice_category=1; scene=WIK_O
#: WIK_O:539
msgctxt "text_id=22848 | speaker=aoko"
msgid "\"So the numbers add up, then."
msgstr "「なるほど、数は合っているわね。"

#. Occurrence WIK_O:550:22849: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_O_0003; voice_prefix=A10; voice_category=1; scene=WIK_O
#: WIK_O:550
msgctxt "text_id=22849 | speaker=aoko"
msgid "  Soujyuro, tell me who you invited, before I yell at you."
msgstr "　ところで草十郎、<叱|しか>られる前に白状した方がいいわよ？"

#. Occurrence WIK_O:550:22850: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_O_0003; voice_prefix=A10; voice_category=1; scene=WIK_O
#: WIK_O:550
msgctxt "text_id=22850 | speaker=aoko"
msgid "  I'm pretty sure I know already, but tell me. Who you sent. The last invitation to.\""
msgstr "　もうなんとなく分かったけど、一体誰に、招待状を、送りやがったの？」"

#. Occurrence WIK_O:578:22851: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_O_0001; voice_prefix=A30; voice_category=3; scene=WIK_O
#: WIK_O:578
msgctxt "text_id=22851 | speaker=soujuurou"
msgid "\"...Oh, I, um... I mean, it's not good to leave people out, so―\""
msgstr "「……いや、だって。仲間はずれは良くないじゃないか」"

#. Occurrence WIK_O:618:22852: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_O_0004; voice_prefix=A10; voice_category=1; scene=WIK_O
#: WIK_O:618
msgctxt "text_id=22852 | speaker=aoko"
msgid "\"Touko. You're the one who invited Touko!\""
msgstr "「橙子ね。橙子を呼びつけたのはアンタだったのね！」"

#. Occurrence WIK_O:623:22853: scene=WIK_O
#: WIK_O:623
msgctxt "text_id=22853 | speaker=unknown"
msgid "  Aozaki grabbed Sizuki by his collar and shook him violently, like a bobblehead."
msgstr "　蒼崎は静希の襟元を掴んで、頭をガクガクと揺らす。"

#. Occurrence WIK_O:629:22854: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_O_0002; voice_prefix=A30; voice_category=3; scene=WIK_O
#: WIK_O:629
msgctxt "text_id=22854 | speaker=soujuurou"
msgid "\"Ohh... Two Riddells...\""
msgstr "「二人……リデルが、二人……」"

#. Occurrence WIK_O:666:22855: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_O_0000; voice_prefix=B40; voice_category=8; scene=WIK_O
#: WIK_O:666
msgctxt "text_id=22855 | speaker=eiri"
msgid "\"So you invited Touko. But I thought she couldn't step foot inside Misaki anymore.\""
msgstr "「橙子さんに招待状を送った……しかし、彼女は今、三咲町には立ち入れない筈ですが」"

#. Occurrence WIK_O:675:22856: speaker=beo; speaker_ja=ベオ; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A50_WIK_O_0000; voice_prefix=A50; voice_category=12; scene=WIK_O
#: WIK_O:675
msgctxt "text_id=22856 | speaker=beo"
msgid "\"Hm? Miss Touko said she beat that curse a long time ago. Mentioned about 'thinking outside the box.' 'If my body's cursed, I'll just use a new one,' or something like that.\""
msgstr "「ん？　呪いならトーコさん、とっくにクリアしたって言ってたよ？　ハッソウのテンカンだ、とか言って。なんでも、肉体にかかった呪いがとけないなら、その肉体を使わなければいい、とかなんとか」"

#. Occurrence WIK_O:699:22857: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_O_0005; voice_prefix=A10; voice_category=1; scene=WIK_O
#: WIK_O:699
msgctxt "text_id=22857 | speaker=aoko"
msgid "\"What kind of logic is that?"
msgstr "「どんな理屈よそれ。"

#. Occurrence WIK_O:699:22858: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_O_0005; voice_prefix=A10; voice_category=1; scene=WIK_O
#: WIK_O:699
msgctxt "text_id=22858 | speaker=aoko"
msgid "  ...Ugh. My sister's crazy as always.\""
msgstr "　……相変わらずネジとんでるわね、姉貴」"

#. Occurrence WIK_O:708:22859: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_O_0003; voice_prefix=A40; voice_category=2; scene=WIK_O
#: WIK_O:708
msgctxt "text_id=22859 | speaker=alice"
msgid "\"At any rate, if she was invited, she could be here.\""
msgstr "「……ともかく、橙子さんに招待状が送られてしまった以上、彼女がここに来ている可能性があるのね」"

#. Occurrence WIK_O:746:22860: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_O_0004; voice_prefix=B10; voice_category=5; scene=WIK_O
#: WIK_O:746
msgctxt "text_id=22860 | speaker=kojika"
msgid "\"Right. And remember the entrance when the phone line was cut?"
msgstr "「そう。そこで思い出してほしいのが、電話線がなくなってた時の玄関。"

#. Occurrence WIK_O:765:22861: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_O_0005; voice_prefix=B10; voice_category=5; scene=WIK_O
#: WIK_O:765
msgctxt "text_id=22861 | speaker=kojika"
msgid "  There was a puddle on the floor."
msgstr "　あの時、玄関の床には水滴がついていた。"

#. Occurrence WIK_O:777:22862: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_O_0006; voice_prefix=B10; voice_category=5; scene=WIK_O
#: WIK_O:777
msgctxt "text_id=22862 | speaker=kojika"
msgid "  None of us have been outside since the rain started."
msgstr "　わたしたちは雨が降り出してから一度も外に出ていない。"

#. Occurrence WIK_O:783:22863: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_O_0007; voice_prefix=B10; voice_category=5; scene=WIK_O
#: WIK_O:783
msgctxt "text_id=22863 | speaker=kojika"
msgid "  I thought it hinted that Riddell might've snuck in here ahead of time, but she wasn't wet at all."
msgstr "　だから事件の直前にやってきたリデルの足跡かと思ってたけど、彼女、まったく雨に濡れていなかった。"

#. Occurrence WIK_O:795:22864: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_O_0008; voice_prefix=B10; voice_category=5; scene=WIK_O
#: WIK_O:795
msgctxt "text_id=22864 | speaker=kojika"
msgid "  In other words...\""
msgstr "　つまり、」"

#. Occurrence WIK_O:829:22865: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_O_0000; voice_prefix=B30; voice_category=9; scene=WIK_O
#: WIK_O:829
msgctxt "text_id=22865 | speaker=ritsuka"
msgid "\"It's evidence that someone other than Riddell entered the mansion, right?"
msgstr "「あの雨の跡はリデルさん以外の、何者かが洋館に入ってきたという証拠……という事ね？"

#. Occurrence WIK_O:841:22866: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_O_0001; voice_prefix=B30; voice_category=9; scene=WIK_O
#: WIK_O:841
msgctxt "text_id=22866 | speaker=ritsuka"
msgid "  But everyone except for Mr. Tokitsu and Mr. Yamasiro was there at that time...\""
msgstr "　あの時、玄関には土桔さんと山城先生以外のみんながいたから―――」"

#. Occurrence WIK_O:850:22867: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_O_0001; voice_prefix=B40; voice_category=8; scene=WIK_O
#: WIK_O:850
msgctxt "text_id=22867 | speaker=eiri"
msgid "\"So we have an unknown participant."
msgstr "「姿のない参加者。"

#. Occurrence WIK_O:856:22868: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_O_0002; voice_prefix=B40; voice_category=8; scene=WIK_O
#: WIK_O:856
msgctxt "text_id=22868 | speaker=eiri"
msgid "  A thirteenth guest, if you will.\""
msgstr "　十三人目のゲストがいる、という事ですね」"

#. Occurrence WIK_O:940:22869: scene=WIK_O
#: WIK_O:940
msgctxt "text_id=22869 | speaker=unknown"
msgid "  This changed everything."
msgstr "　状況はここにきて一変した。"

#. Occurrence WIK_O:945:22870: scene=WIK_O
#: WIK_O:945
msgctxt "text_id=22870 | speaker=unknown"
msgid "  I'd never heard that Aozaki had an older sister, but now wasn't the time to ask about that."
msgstr "　蒼崎にお姉さんがいる、というのは初耳だけど、ここは追及している場合じゃない。"

#. Occurrence WIK_O:950:22871: scene=WIK_O
#: WIK_O:950
msgctxt "text_id=22871 | speaker=unknown"
msgid "  The tension in the air was enough to tell me that there was bad blood between her and the people here."
msgstr "　みんなの緊迫した空気からすると、そのお姉さんとやらはここにいる全員に敵意を持っているらしい。"

#. Occurrence WIK_O:983:22872: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_O_0000; voice_prefix=B20; voice_category=10; scene=WIK_O
#: WIK_O:983
msgctxt "text_id=22872 | speaker=yuika"
msgid "\"Touko Aozaki. She'd be more than capable of using Ploys, and she's familiar with the Kuonji mansion."
msgstr "「蒼崎橙子ですか。彼女なら、たしかにプロイに精通し、久遠寺の屋敷の見取りも把握しています。"

#. Occurrence WIK_O:994:22873: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_O_0001; voice_prefix=B20; voice_category=10; scene=WIK_O
#: WIK_O:994
msgctxt "text_id=22873 | speaker=yuika"
msgid "  Most of all, she's out to kill us-or rather, Aoko specifically. That gives her a far stronger motive than any other suspect.\""
msgstr "　なにより私たち―――とくに青子さんに強力な殺意がある。今まで見えてこなかった動機の面でも、最有力候補ですね」"

#. Occurrence WIK_O:1020:22874: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_O_0003; voice_prefix=B40; voice_category=8; scene=WIK_O
#: WIK_O:1020
msgctxt "text_id=22874 | speaker=eiri"
msgid "\"Indeed. If Touko is our killer, then locking ourselves in our rooms won't do much good. She could just force her way in.\""
msgstr "「ですね。橙子さんが犯人だとしたら、部屋に閉じこもるのは得策ではありません。何をやっても力ずくで侵入してくるでしょう」"

#. Occurrence WIK_O:1047:22875: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_O_0002; voice_prefix=B30; voice_category=9; scene=WIK_O
#: WIK_O:1047
msgctxt "text_id=22875 | speaker=ritsuka"
msgid "\"Ooh, she *would* do that! Toko's a huge horror fan, after all! ...Hmm. It would be too bad if the genre shifted to horror, but let's worry about our safety first.\""
msgstr "「うん、トコちゃんならやるわ。だってホラー大好きだもの！　……うーん。ここにきて展開がホラーになるのは残念だけど、まずは安全を確保しないとね」"

#. Occurrence WIK_O:1058:22876: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_O_0004; voice_prefix=B40; voice_category=8; scene=WIK_O
#: WIK_O:1058
msgctxt "text_id=22876 | speaker=eiri"
msgid "\"Let's split up and search the mansion. We need to figure out if Touko is really here or not.\""
msgstr "「皆さん、手分けして洋館内を調査しましょう。橙子さんがいるのかいないのか、そこをハッキリさせなくては」"

#. Occurrence WIK_O:1096:22877: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_O_0006; voice_prefix=A10; voice_category=1; scene=WIK_O
#: WIK_O:1096
msgctxt "text_id=22877 | speaker=aoko"
msgid "\"Huh? Oh, um, yeah."
msgstr "「え？　あ、うん、そうよね。"

#. Occurrence WIK_O:1108:22878: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_O_0007; voice_prefix=A10; voice_category=1; scene=WIK_O
#: WIK_O:1108
msgctxt "text_id=22878 | speaker=aoko"
msgid "  ...I'll, uh, go check the area around my room.\""
msgstr "　……じゃ、じゃあ私は、自分の部屋周辺を調べるわ」"

#. Occurrence WIK_O:1123:22879: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_O_0004; voice_prefix=A40; voice_category=2; scene=WIK_O
#: WIK_O:1123
msgctxt "text_id=22879 | speaker=alice"
msgid "\"I'll check the west wing and the basement, just in case."
msgstr "「わたしは西館と、念のため地下室に。"

#. Occurrence WIK_O:1134:22880: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_O_0005; voice_prefix=A40; voice_category=2; scene=WIK_O
#: WIK_O:1134
msgctxt "text_id=22880 | speaker=alice"
msgid "  the rest of you should stay here, for your own safety.\""
msgstr "　久万梨さんたちは危険だから、ここで待っていて」"

#. Occurrence WIK_O:1167:22881: scene=WIK_O
#: WIK_O:1167
msgctxt "text_id=22881 | speaker=unknown"
msgid "  With that, they left the drawing room on a mission,"
msgstr "　そんな訳で、ドタバタと慌ただしく居間を後にしていく人々。"

#. Occurrence WIK_O:1173:22882: scene=WIK_O
#: WIK_O:1173
msgctxt "text_id=22882 | speaker=unknown"
msgid "  leaving me, Tsukiji, Sizuki, and Ritsuka behind."
msgstr "　わたしと槻司、静希、律架さんを残して、みんな館内の探索に出払ってしまった。"

#. Occurrence WIK_O:1219:22883: scene=WIK_O
#: WIK_O:1219
msgctxt "text_id=22883 | speaker=unknown"
msgid "  Time passed by slowly."
msgstr "　……時間だけが過ぎていく。"

#. Occurrence WIK_O:1224:22884: scene=WIK_O
#: WIK_O:1224
msgctxt "text_id=22884 | speaker=unknown"
msgid "  My eyelids began to feel heavy from anxiety and exhaustion."
msgstr "　緊張と疲れからか、目蓋がやや重い。"

#. Occurrence WIK_O:1229:22885: scene=WIK_O
#: WIK_O:1229
msgctxt "text_id=22885 | speaker=unknown"
msgid "  The clock struck midnight."
msgstr "　時計の針が零時を示す。"

#. Occurrence WIK_O:1280:22886: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_O_0003; voice_prefix=B70; voice_category=4; scene=WIK_O
#: WIK_O:1280
msgctxt "text_id=22886 | speaker=tobimaru"
msgid "\"I'll go brew some tea. Soujyuro, where do you keep it?\""
msgstr "「紅茶でも淹れてくるか。草十郎、お茶はどこで？」"

#. Occurrence WIK_O:1290:22887: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_O_0003; voice_prefix=A30; voice_category=3; scene=WIK_O
#: WIK_O:1290
msgctxt "text_id=22887 | speaker=soujuurou"
msgid "\"There's a pot on the table in the sunroom. Should still be warm.\""
msgstr "「それならサンルームのテーブルに、まだ温かいポットがあるよ」"

#. Occurrence WIK_O:1301:22888: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_O_0004; voice_prefix=B70; voice_category=4; scene=WIK_O
#: WIK_O:1301
msgctxt "text_id=22888 | speaker=tobimaru"
msgid "\"Perfect. I'll go get it.\""
msgstr "「よし。取ってくる」"

#. Occurrence WIK_O:1318:22889: scene=WIK_O
#: WIK_O:1318
msgctxt "text_id=22889 | speaker=unknown"
msgid "  He probably wanted to get his mind off things."
msgstr "　気分転換のつもりなんだろう。"

#. Occurrence WIK_O:1323:22890: scene=WIK_O
#: WIK_O:1323
msgctxt "text_id=22890 | speaker=unknown"
msgid "  Tsukiji strode off toward the sunroom."
msgstr "　槻司は自発的にサンルームに向かった。"

#. Occurrence WIK_O:1349:22891: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_O_0005; voice_prefix=B70; voice_category=4; scene=WIK_O
#: WIK_O:1349
msgctxt "text_id=22891 | speaker=tobimaru"
msgid "\"Oh.\""
msgstr "「お？」"

#. Occurrence WIK_O:1383:22892: scene=WIK_O
#: WIK_O:1383
msgctxt "text_id=22892 | speaker=unknown"
msgid "  Another blackout."
msgstr "　また電気が落ちた。"

#. Occurrence WIK_O:1389:22893: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_O_0006; voice_prefix=B70; voice_category=4; scene=WIK_O
#: WIK_O:1389
msgctxt "text_id=22893 | speaker=tobimaru"
msgid "\"I can't see a damn thi―\""
msgstr "「まいったな、これじゃ何も見え―――」"

#. Occurrence WIK_O:1412:22894: scene=WIK_O
#: WIK_O:1412
msgctxt "text_id=22894 | speaker=unknown"
msgid "  There was a dazzling flash of light."
msgstr "　まばゆい閃光。"

#. Occurrence WIK_O:1417:22895: scene=WIK_O
#: WIK_O:1417
msgctxt "text_id=22895 | speaker=unknown"
msgid "  Through the window in the sunroom,"
msgstr "　サンルームの窓ガラス越しに、"

#. Occurrence WIK_O:1422:22896: scene=WIK_O
#: WIK_O:1422
msgctxt "text_id=22896 | speaker=unknown"
msgid "  I could see lightning-"
msgstr "　外の落雷の様子、が―――"

#. Occurrence WIK_O:1604:22897: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_O_0009; voice_prefix=B10; voice_category=5; scene=WIK_O
#: WIK_O:1604
msgctxt "text_id=22897 | speaker=kojika"
msgid "\"Aghhhhhhhhhhhh!\""
msgstr "「きゃーーーーー！」"

#. Occurrence WIK_O:1610:22898: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_O_0003; voice_prefix=B30; voice_category=9; scene=WIK_O
#: WIK_O:1610
msgctxt "text_id=22898 | speaker=ritsuka"
msgid "\"Tsukiji, get back! Now!\""
msgstr "「槻司くん、下がって！　早く！」"

#. Occurrence WIK_O:1635:22899: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_O_0007; voice_prefix=B70; voice_category=4; scene=WIK_O
#: WIK_O:1635
msgctxt "text_id=22899 | speaker=tobimaru"
msgid "\"W-w-what the hell was that!? Someone was there!\""
msgstr "「な、なんだ今の、誰かいたぞ！？」"

#. Occurrence WIK_O:1646:22900: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_O_0004; voice_prefix=B30; voice_category=9; scene=WIK_O
#: WIK_O:1646
msgctxt "text_id=22900 | speaker=ritsuka"
msgid "\"You three, over here! Into the hall!\""
msgstr "「三人とも、こっち！　ホールに移動しましょう！」"

#. Occurrence WIK_O:1680:22901: scene=WIK_O
#: WIK_O:1680
msgctxt "text_id=22901 | speaker=unknown"
msgid "  Ritsuka grabbed my hand and pulled me away from the pitch-black drawing room."
msgstr "　律架さんに手を引かれて、暗闇の居間を後にする。"

#. Occurrence WIK_O:1685:22902: scene=WIK_O
#: WIK_O:1685
msgctxt "text_id=22902 | speaker=unknown"
msgid "  I definitely saw the outline of a person against the lightning."
msgstr "　落雷による目の錯覚―――にしては、人影は明白すぎた。"

#. Occurrence WIK_O:1690:22903: scene=WIK_O
#: WIK_O:1690
msgctxt "text_id=22903 | speaker=unknown"
msgid "  Someone was outside, in the raging storm."
msgstr "　この強風の中、屋敷の外に誰かがいる。"

#. Occurrence WIK_O:1695:22904: scene=WIK_O
#: WIK_O:1695
msgctxt "text_id=22904 | speaker=unknown"
msgid "  It could only be the thirteenth guest."
msgstr "　それはどう考えても、正体不明の“十三人目”の実在を示していた。"

#. Occurrence WIK_O:1727:22905: scene=WIK_O
#: WIK_O:1727
msgctxt "text_id=22905 | speaker=unknown"
msgid "  We fled to the hall."
msgstr "　逃げるようにホールに駆け込んだ。"

#. Occurrence WIK_O:1732:22906: scene=WIK_O
#: WIK_O:1732
msgctxt "text_id=22906 | speaker=unknown"
msgid "  The wall lamps here appeared to be on separate wiring, so at least it wasn't completely dark."
msgstr "　壁の電灯は別電源らしく、完全に闇に没していない。"

#. Occurrence WIK_O:1756:22907: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_O_0008; voice_prefix=A10; voice_category=1; scene=WIK_O
#: WIK_O:1756
msgctxt "text_id=22907 | speaker=aoko"
msgid "\"Kuma? What's going on?\""
msgstr "「クマ？　どうしたのよ、血相変えちゃって」"

#. Occurrence WIK_O:1778:22908: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_O_0010; voice_prefix=B10; voice_category=5; scene=WIK_O
#: WIK_O:1778
msgctxt "text_id=22908 | speaker=kojika"
msgid "\"Th-Th-There was someone outside!\""
msgstr "「そ、外、外に誰かいた！」"

#. Occurrence WIK_O:1790:22909: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_O_0009; voice_prefix=A10; voice_category=1; scene=WIK_O
#: WIK_O:1790
msgctxt "text_id=22909 | speaker=aoko"
msgid "\"I'll go take a look. Soujyuro, Tobimaru, look after Kojika.\""
msgstr "「ちょっと見てくる。草十郎、鳶丸、<金鹿|こじか>をお願い」"

#. Occurrence WIK_O:1862:22910: scene=WIK_O
#: WIK_O:1862
msgctxt "text_id=22910 | speaker=unknown"
msgid "  Jogging, Aozaki disappeared into the dark corridor connecting to the parlor."
msgstr "　蒼崎は居間に通じる<廊下|やみ>へと小走りで消えていった。"

#. Occurrence WIK_O:1867:22911: scene=WIK_O
#: WIK_O:1867
msgctxt "text_id=22911 | speaker=unknown"
msgid "  Father Eiri and Sister Yuika came down the stairs, and Miss Kuonji returned from the west wing. They must have heard the commotion."
msgstr "　騒ぎを聞きつけたのか、二階からは詠梨神父、シスター唯架、一階の西館からは久遠寺さんがやってきた。"

#. Occurrence WIK_O:1892:22912: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_O_0005; voice_prefix=B40; voice_category=8; scene=WIK_O
#: WIK_O:1892
msgctxt "text_id=22912 | speaker=eiri"
msgid "\"Looks like the power is out again. Did something happen?\""
msgstr "「屋敷の電源がまた落ちたようですが、何かあったのですか？」"

#. Occurrence WIK_O:1902:22913: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_O_0005; voice_prefix=B30; voice_category=9; scene=WIK_O
#: WIK_O:1902
msgctxt "text_id=22913 | speaker=ritsuka"
msgid "\"We think we saw someone outside the sunroom, so we ran in here. Aoko went to check on it.\""
msgstr "「それが、サンルームの外に人影っぽいものが見えて、つい逃げてきちゃった。いまはアコちゃんが様子を見に行ってるわ」"

#. Occurrence WIK_O:1922:22914: scene=WIK_O
#: WIK_O:1922
msgctxt "text_id=22914 | speaker=unknown"
msgid "  Aozaki returned as we explained the situation."
msgstr "　状況を説明していると、すぐに蒼崎が戻ってきた。"

#. Occurrence WIK_O:1932:22915: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_O_0010; voice_prefix=A10; voice_category=1; scene=WIK_O
#: WIK_O:1932
msgctxt "text_id=22915 | speaker=aoko"
msgid "\"Nothing out of the ordinary for the moment. No broken windows in the sunroom, so I don't think anyone slipped inside.\""
msgstr "「とりあえず異状なし。サンルームの窓も割れてないし、誰かが中に入ってきた様子はないわ」"

#. Occurrence WIK_O:1958:22916: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_O_0006; voice_prefix=B40; voice_category=8; scene=WIK_O
#: WIK_O:1958
msgctxt "text_id=22916 | speaker=eiri"
msgid "\"We also didn't see anything unusual. Touko doesn't seem to be inside the mansion. Which means...\""
msgstr "「こちらも異状はありませんでした。館内に橙子さんはいないようです。そうなると……」"

#. Occurrence WIK_O:1968:22917: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_O_0002; voice_prefix=B20; voice_category=10; scene=WIK_O
#: WIK_O:1968
msgctxt "text_id=22917 | speaker=yuika"
msgid "\"That could have been her. If we didn't find anything inside, she might be creeping around the grounds.\""
msgstr "「先ほどの、外に人影を見た、という件ですね。館内に異常がないのなら、あとは屋敷の周りだけです」"

#. Occurrence WIK_O:1994:22918: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_O_0007; voice_prefix=B40; voice_category=8; scene=WIK_O
#: WIK_O:1994
msgctxt "text_id=22918 | speaker=eiri"
msgid "\"All right, we should look outside then."
msgstr "「分かりました、外を調べに行きましょう。"

#. Occurrence WIK_O:2000:22919: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_O_0008; voice_prefix=B40; voice_category=8; scene=WIK_O
#: WIK_O:2000
msgctxt "text_id=22919 | speaker=eiri"
msgid "  Let's start around the sunroom. It might be dangerous, so Sister Yuika and I will go... Aoko, would you mind coming with us?\""
msgstr "　まずはサンルームのあたりですね。危険ですから、調べに行くのは私とシスター唯架……それと青子、頼めますか？」"

#. Occurrence WIK_O:2026:22920: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_O_0003; voice_prefix=B20; voice_category=10; scene=WIK_O
#: WIK_O:2026
msgctxt "text_id=22920 | speaker=yuika"
msgid "\"...Unfortunately, Father, I don't think I'll be of much use in this wind. I won't be able to hear a thing.\""
msgstr "「……エイリ神父。この風では、私はあまりお役に立てないかと。耳が利きません」"

#. Occurrence WIK_O:2052:22921: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_O_0009; voice_prefix=B40; voice_category=8; scene=WIK_O
#: WIK_O:2052
msgctxt "text_id=22921 | speaker=eiri"
msgid "\"You're right."
msgstr "「そうでしたね。"

#. Occurrence WIK_O:2063:22922: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_O_0010; voice_prefix=B40; voice_category=8; scene=WIK_O
#: WIK_O:2063
msgctxt "text_id=22922 | speaker=eiri"
msgid "  I just didn't want to make Aoko go alone.\""
msgstr "　しかし、私はともかく青子をひとりにするのは……」"

#. Occurrence WIK_O:2074:22923: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_O_0011; voice_prefix=A10; voice_category=1; scene=WIK_O
#: WIK_O:2074
msgctxt "text_id=22923 | speaker=aoko"
msgid "\"Don't worry, I can defend myself."
msgstr "「気にしないで、私はひとりで身を守れるから。"

#. Occurrence WIK_O:2080:22924: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_O_0012; voice_prefix=A10; voice_category=1; scene=WIK_O
#: WIK_O:2080
msgctxt "text_id=22924 | speaker=aoko"
msgid "  I'm more worried about you, to be honest. You're not armed.\""
msgstr "　詠梨の方こそ大丈夫？　今日、武装してないんでしょ？」"

#. Occurrence WIK_O:2106:22925: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_O_0011; voice_prefix=B40; voice_category=8; scene=WIK_O
#: WIK_O:2106
msgctxt "text_id=22925 | speaker=eiri"
msgid "\"In that case, can I ask you, Soujyuro?"
msgstr "「それでしたら……草十郎君、お願いできますか？"

#. Occurrence WIK_O:2106:22926: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_O_0011; voice_prefix=B40; voice_category=8; scene=WIK_O
#: WIK_O:2106
msgctxt "text_id=22926 | speaker=eiri"
msgid "  We seem to work well enough together.\""
msgstr "　彼なら互いの呼吸を心得ていますので」"

#. Occurrence WIK_O:2128:22927: scene=WIK_O
#: WIK_O:2128
msgctxt "text_id=22927 | speaker=unknown"
msgid "  Sizuki nodded solemnly."
msgstr "　詠梨神父の申し出に、静希は深刻な顔で頷いた。"

#. Occurrence WIK_O:2133:22928: scene=WIK_O
#: WIK_O:2133
msgctxt "text_id=22928 | speaker=unknown"
msgid "  I..."
msgstr "　わたしは―――"

#. Occurrence WIK_SELECT_P:8:22929: scene=WIK_SELECT_P
#: WIK_SELECT_P:8
msgctxt "text_id=22929 | speaker=unknown"
msgid "-Decision P-"
msgstr "～選択肢Ｐ～"

#. Occurrence WIK_P_1:36:22930: scene=WIK_P_1
#: WIK_P_1:36
msgctxt "text_id=22930 | speaker=unknown"
msgid "  I think it's too dangerous to leave Aozaki alone."
msgstr "　わたしは、蒼崎をひとりにするのは危険だ、と思った。"

#. Occurrence WIK_P_1:68:22931: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_P_1_0000; voice_prefix=B10; voice_category=5; scene=WIK_P_1
#: WIK_P_1:68
msgctxt "text_id=22931 | speaker=kojika"
msgid "\"Wait, Aozaki. I'll go with you.\""
msgstr "「待って蒼崎。わたしも行く」"

#. Occurrence WIK_P_1:82:22932: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_P_1_0000; voice_prefix=A10; voice_category=1; scene=WIK_P_1
#: WIK_P_1:82
msgctxt "text_id=22932 | speaker=aoko"
msgid "\"Wh-What're you talking about, Kuma? It's too dangerous outside. Wait in the foyer with Tobimaru.\""
msgstr "「！？　な、なに言ってんのよクマ、外は危ないんだってば。いいからクマは鳶丸とロビーで待機していてよ」"

#. Occurrence WIK_P_1:93:22933: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_P_1_0001; voice_prefix=B10; voice_category=5; scene=WIK_P_1
#: WIK_P_1:93
msgctxt "text_id=22933 | speaker=kojika"
msgid "\"But if it's dangerous, I don't want to let you go out there alone. I'm your friend.\""
msgstr "「危ないのはアンタも同じでしょ。友人として、ひとりで出歩かせることはできないわ」"

#. Occurrence WIK_P_1:120:22934: scene=WIK_P_1
#: WIK_P_1:120
msgctxt "text_id=22934 | speaker=unknown"
msgid "  Aozaki couldn't refuse when I put it like that."
msgstr "　こう言えば蒼崎は断れない。"

#. Occurrence WIK_P_1:125:22935: scene=WIK_P_1
#: WIK_P_1:125
msgctxt "text_id=22935 | speaker=unknown"
msgid "  I wanted to watch her back, of course, but I had another reason too."
msgstr "　わたしが同行を申し出たのは、彼女の身を案じて……もあるけど、もうひとつ、見過ごせない理由があるからだ。"

#. Occurrence WIK_P_1:192:22936: scene=WIK_P_1
#: WIK_P_1:192
msgctxt "text_id=22936 | speaker=unknown"
msgid "  Aozaki was currently the most suspicious survivor."
msgstr "　残ったメンバーの中で不審な点が多いのは、トップクラスで蒼崎だ。"

#. Occurrence WIK_P_1:197:22937: scene=WIK_P_1
#: WIK_P_1:197
msgctxt "text_id=22937 | speaker=unknown"
msgid "  It wasn't a good idea to let her go alone, for multiple reasons."
msgstr "　彼女をひとりで行動させるのは、いろいろと良くない。"

#. Occurrence WIK_P_1:202:22938: scene=WIK_P_1
#: WIK_P_1:202
msgctxt "text_id=22938 | speaker=unknown"
msgid "  If she was the killer―or Sweets Hearts, or whatever―then our lives were in danger. If I didn't go with her, then it would cast more doubt on her later."
msgstr "　彼女が真犯人……スイーツハーツとやらならわたしたちの命が危ないし、そうでないなら、後々彼女が疑われてしまう。"

#. Occurrence WIK_P_1:222:22939: scene=WIK_P_1
#: WIK_P_1:222
msgctxt "text_id=22939 | speaker=unknown"
msgid "  Anyone could see how dangerous it was outside."
msgstr "　外は見るからに危険だし、"

#. Occurrence WIK_P_1:227:22940: scene=WIK_P_1
#: WIK_P_1:227
msgctxt "text_id=22940 | speaker=unknown"
msgid "  Of course, I would've liked to stay with Tsukiji,"
msgstr "　槻司と番をしている未来にも未練はあるけど、"

#. Occurrence WIK_P_1:232:22941: scene=WIK_P_1
#: WIK_P_1:232
msgctxt "text_id=22941 | speaker=unknown"
msgid "  but petty feelings like that weren't more important than my friendship with Aozaki."
msgstr "　ここで自分可愛さで黙っていられるほど、蒼崎との高校生活は軽くはなかったのだ。"

#. Occurrence WIK_P_1:288:22942: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_P_1_0001; voice_prefix=A10; voice_category=1; scene=WIK_P_1
#: WIK_P_1:288
msgctxt "text_id=22942 | speaker=aoko"
msgid "\"...Okay. Fine."
msgstr "「……オッケー、了解。"

#. Occurrence WIK_P_1:300:22943: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_P_1_0002; voice_prefix=A10; voice_category=1; scene=WIK_P_1
#: WIK_P_1:300
msgctxt "text_id=22943 | speaker=aoko"
msgid "  Just promise you won't leave my side, no matter what."
msgstr "　でも、ぜったいに私のそばから離れないでね。"

#. Occurrence WIK_P_1:306:22944: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_P_1_0003; voice_prefix=A10; voice_category=1; scene=WIK_P_1
#: WIK_P_1:306
msgctxt "text_id=22944 | speaker=aoko"
msgid "  Does that work for you, Eiri?\""
msgstr "　それでいいでしょ、詠梨？」"

#. Occurrence WIK_P_1:315:22945: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_P_1_0000; voice_prefix=B40; voice_category=8; scene=WIK_P_1
#: WIK_P_1:315
msgctxt "text_id=22945 | speaker=eiri"
msgid "\"Yes. I wanted to send someone with you anyway. Miss Kumari would be as good as anyone.\""
msgstr "「ええ、実のところ、私も青子にひとり付けたかったのです。久万梨さんなら適任でしょう」"

#. Occurrence WIK_P_1:340:22946: scene=WIK_P_1
#: WIK_P_1:340
msgctxt "text_id=22946 | speaker=unknown"
msgid "  Father Eiri seemed to thinking along the same lines."
msgstr "　詠梨神父も同じ考えらしい。"

#. Occurrence WIK_P_1:345:22947: scene=WIK_P_1
#: WIK_P_1:345
msgctxt "text_id=22947 | speaker=unknown"
msgid "  ...He had a cool demeanor, but maybe he had genuine concern for Aozaki."
msgstr "　……彼、冷酷なイメージがあったけど、ホントは人一倍蒼崎を心配しているんじゃないだろうか？"

#. Occurrence WIK_P_1:393:22948: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_P_1_0004; voice_prefix=A10; voice_category=1; scene=WIK_P_1
#: WIK_P_1:393
msgctxt "text_id=22948 | speaker=aoko"
msgid "\"Tobimaru, look after Yuika and Alice. If we don't find anything in twenty minutes, we'll be back."
msgstr "「鳶丸、唯架さんと有珠をよろしくね。二十分捜して何も見つからなかったら戻ってくるから。"

#. Occurrence WIK_P_1:405:22949: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_P_1_0005; voice_prefix=A10; voice_category=1; scene=WIK_P_1
#: WIK_P_1:405
msgctxt "text_id=22949 | speaker=aoko"
msgid "  Eiri, when we get outside, you head right; we'll go left.\""
msgstr "　詠梨、外にでたら右手側からぐるっと一周してきて。私は左手側から見ていくから」"

#. Occurrence WIK_P_1:417:22950: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_P_1_0001; voice_prefix=B40; voice_category=8; scene=WIK_P_1
#: WIK_P_1:417
msgctxt "text_id=22950 | speaker=eiri"
msgid "\"Sounds like a plan. Let's go, Soujyuro.\""
msgstr "「賢明です。行きますよ、草十郎君」"

#. Occurrence WIK_P_1:452:22951: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_P_1_0006; voice_prefix=A10; voice_category=1; scene=WIK_P_1
#: WIK_P_1:452
msgctxt "text_id=22951 | speaker=aoko"
msgid "\"Soujyuro?\""
msgstr "「草十郎」"

#. Occurrence WIK_P_1:463:22952: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_P_1_0000; voice_prefix=A30; voice_category=3; scene=WIK_P_1
#: WIK_P_1:463
msgctxt "text_id=22952 | speaker=soujuurou"
msgid "\"Don't worry about me. Take care of Kumari."
msgstr "「心配はこっちじゃなく久万梨に。"

#. Occurrence WIK_P_1:474:22953: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_P_1_0001; voice_prefix=A30; voice_category=3; scene=WIK_P_1
#: WIK_P_1:474
msgctxt "text_id=22953 | speaker=soujuurou"
msgid "  Kumari, watch out for flying branches in this weather. Aozaki is weirdly effective at times like these, so just follow her lead.\""
msgstr "　久万梨、枝が飛んでくるかもしれないから頭を低くしておくんだぞ。蒼崎はこういう時にかぎって不思議な効果を発揮するから、そうなったらフォローしてやってくれ」"

#. Occurrence WIK_P_1:486:22954: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_P_1_0007; voice_prefix=A10; voice_category=1; scene=WIK_P_1
#: WIK_P_1:486
msgctxt "text_id=22954 | speaker=aoko"
msgid "\"And what is that supposed to mean?\""
msgstr "「どういう意味よそれ」"

#. Occurrence WIK_P_1:521:22955: scene=WIK_P_1
#: WIK_P_1:521
msgctxt "text_id=22955 | speaker=unknown"
msgid "  I nodded to Sizuki, and made my way outside with Aozaki."
msgstr "　静希の忠告にうなずいて、わたしは蒼崎と一緒に外に出た。"

#. Occurrence WIK_P_1:583:22956: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_P_1_0002; voice_prefix=B10; voice_category=5; scene=WIK_P_1
#: WIK_P_1:583
msgctxt "text_id=22956 | speaker=kojika"
msgid "\"...!\""
msgstr "「っ……！」"

#. Occurrence WIK_P_1:589:22957: scene=WIK_P_1
#: WIK_P_1:589
msgctxt "text_id=22957 | speaker=unknown"
msgid "  The storm was worse than I expected."
msgstr "　外の嵐は予想以上だった。"

#. Occurrence WIK_P_1:594:22958: scene=WIK_P_1
#: WIK_P_1:594
msgctxt "text_id=22958 | speaker=unknown"
msgid "  I could barely keep my eyes open in this wind."
msgstr "　風が強くてまともに目を開けていられない。"

#. Occurrence WIK_P_1:615:22959: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_P_1_0008; voice_prefix=A10; voice_category=1; scene=WIK_P_1
#: WIK_P_1:615
msgctxt "text_id=22959 | speaker=aoko"
msgid "\"Kojika! Give me your hand!\""
msgstr "「<金鹿|こじか>、手！」"

#. Occurrence WIK_P_1:621:22960: scene=WIK_P_1
#: WIK_P_1:621
msgctxt "text_id=22960 | speaker=unknown"
msgid "  Aozaki extended her left hand toward me."
msgstr "　前を行く蒼崎が左手を出してくる。"

#. Occurrence WIK_P_1:626:22961: scene=WIK_P_1
#: WIK_P_1:626
msgctxt "text_id=22961 | speaker=unknown"
msgid "  I grabbed hold tightly. Her hand was so cold it sent a shiver down my spine."
msgstr "　わたしはしっかり握り返す。蒼崎の手は、ゾッとするほど冷たかった。"

#. Occurrence WIK_P_1:693:22962: scene=WIK_P_1
#: WIK_P_1:693
msgctxt "text_id=22962 | speaker=unknown"
msgid "  As we rounded one side of the mansion, Aozaki stopped."
msgstr "　屋敷の側面に回ったあたりで、蒼崎の足が止まった。"

#. Occurrence WIK_P_1:699:22963: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_P_1_0009; voice_prefix=A10; voice_category=1; scene=WIK_P_1
#: WIK_P_1:699
msgctxt "text_id=22963 | speaker=aoko"
msgid "\"Kuma! Did you see that light?!\""
msgstr "「クマー！　今、なにか光らなかった！？」"

#. Occurrence WIK_P_1:705:22964: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_P_1_0003; voice_prefix=B10; voice_category=5; scene=WIK_P_1
#: WIK_P_1:705
msgctxt "text_id=22964 | speaker=kojika"
msgid "\"What light?!\""
msgstr "「なにがーーー！？」"

#. Occurrence WIK_P_1:711:22965: scene=WIK_P_1
#: WIK_P_1:711
msgctxt "text_id=22965 | speaker=unknown"
msgid "  I couldn't even open my eyes."
msgstr "　とてもじゃないが目を開けていられない。"

#. Occurrence WIK_P_1:716:22966: scene=WIK_P_1
#: WIK_P_1:716
msgctxt "text_id=22966 | speaker=unknown"
msgid "  Aozaki paused before speaking."
msgstr "　蒼崎はちょっとだけ思案した後、"

#. Occurrence WIK_P_1:737:22967: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_P_1_0010; voice_prefix=A10; voice_category=1; scene=WIK_P_1
#: WIK_P_1:737
msgctxt "text_id=22967 | speaker=aoko"
msgid "\"Stick to the wall and head back to the entrance!"
msgstr "「このまま屋敷の壁づたいに玄関まで戻ってて！"

#. Occurrence WIK_P_1:737:22968: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_P_1_0010; voice_prefix=A10; voice_category=1; scene=WIK_P_1
#: WIK_P_1:737
msgctxt "text_id=22968 | speaker=aoko"
msgid "  That light had to be the killer!\""
msgstr "　さっきの光、間違いなくアイツだ……！」"

#. Occurrence WIK_P_1:744:22969: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_P_1_0004; voice_prefix=B10; voice_category=5; scene=WIK_P_1
#: WIK_P_1:744
msgctxt "text_id=22969 | speaker=kojika"
msgid "\"What?! No way! I can't leave you alone out here!\""
msgstr "「え!?　ダ、ダメだってば蒼崎、ひとりになんな―――！」"

#. Occurrence WIK_P_1:765:22970: scene=WIK_P_1
#: WIK_P_1:765
msgctxt "text_id=22970 | speaker=unknown"
msgid "  My words failed to reach her."
msgstr "　わたしの制止の声も届かない。"

#. Occurrence WIK_P_1:770:22971: scene=WIK_P_1
#: WIK_P_1:770
msgctxt "text_id=22971 | speaker=unknown"
msgid "  Aozaki ran away from the mansion into the darkness of the woods."
msgstr "　蒼崎は屋敷とは反対の、深い森へと走っていってしまった。"

#. Occurrence WIK_P_1:791:22972: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_P_1_0005; voice_prefix=B10; voice_category=5; scene=WIK_P_1
#: WIK_P_1:791
msgctxt "text_id=22972 | speaker=kojika"
msgid "\"Stick to the wall... But I can't even get back to the mansion, you idiot!\""
msgstr "「壁づたいに戻れって……そもそも屋敷まで戻れないわよ、バカーーー！」"

#. Occurrence WIK_P_1:796:22973: scene=WIK_P_1
#: WIK_P_1:796
msgctxt "text_id=22973 | speaker=unknown"
msgid "  I screamed out in frustration."
msgstr "　ヤケになって叫ぶ。"

#. Occurrence WIK_P_1:801:22974: scene=WIK_P_1
#: WIK_P_1:801
msgctxt "text_id=22974 | speaker=unknown"
msgid "  Somehow, she heard me."
msgstr "　と、わたしの声が聞こえたのか、"

#. Occurrence WIK_P_1:842:22975: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_P_1_0011; voice_prefix=A10; voice_category=1; scene=WIK_P_1
#: WIK_P_1:842
msgctxt "text_id=22975 | speaker=aoko"
msgid "\"What?! Did you say something, Kuma?!\""
msgstr "「え、なにーーー！？　なにか言ったクマーーーー！？」"

#. Occurrence WIK_P_1:847:22976: scene=WIK_P_1
#: WIK_P_1:847
msgctxt "text_id=22976 | speaker=unknown"
msgid "  Aozaki voice came from the tree line."
msgstr "　森からは蒼崎の声が返ってきた。"

#. Occurrence WIK_P_1:868:22977: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_P_1_0006; voice_prefix=B10; voice_category=5; scene=WIK_P_1
#: WIK_P_1:868
msgctxt "text_id=22977 | speaker=kojika"
msgid "\"I said, I can't get back to the mansion by myself―\""
msgstr "「だーかーらー、わたしひとりじゃまっすぐ屋敷まで戻れ、」"

#. Occurrence WIK_P_1:874:22978: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_P_1_0012; voice_prefix=A10; voice_category=1; scene=WIK_P_1
#: WIK_P_1:874
msgctxt "text_id=22978 | speaker=aoko"
msgid "\"Behind you! The mansion's directly behind you!"
msgstr "「後ろ、すぐ後ろが屋敷だってば！"

#. Occurrence WIK_P_1:880:22979: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_P_1_0013; voice_prefix=A10; voice_category=1; scene=WIK_P_1
#: WIK_P_1:880
msgctxt "text_id=22979 | speaker=aoko"
msgid "  Just turn around and―Pffhahahahaha!\""
msgstr "　ちゃんと振り返れば―――ぶっ、あははははははは！」"

#. Occurrence WIK_P_1:886:22980: scene=WIK_P_1
#: WIK_P_1:886
msgctxt "text_id=22980 | speaker=unknown"
msgid "  Huh?"
msgstr "　へ？"

#. Occurrence WIK_P_1:963:22981: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_P_1_0014; voice_prefix=A10; voice_category=1; scene=WIK_P_1
#: WIK_P_1:963
msgctxt "text_id=22981 | speaker=aoko"
msgid "\"OH, CRAP!"
msgstr "「し、しまったーーーー！"

#. Occurrence WIK_P_1:1024:22982: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_P_1_0015; voice_prefix=A10; voice_category=1; scene=WIK_P_1
#: WIK_P_1:1024
msgctxt "text_id=22982 | speaker=aoko"
msgid "  Did I actually just fall for that?! KUMAAA!\""
msgstr "　そんなネタで釣られた、クマーーーー！？」"

#. Occurrence WIK_P_1:1030:22983: scene=WIK_P_1
#: WIK_P_1:1030
msgctxt "text_id=22983 | speaker=unknown"
msgid "  Aozaki's words hung in the air, as her body suddenly flew to one side. It was as if she was hit by a high-powered rifle."
msgstr "　と。蒼崎と思わしき体が、タン、と踊るように横に飛んだ。まるで横から猟銃に撃たれたような挙動。"

#. Occurrence WIK_P_1:1076:22984: scene=WIK_P_1
#: WIK_P_1:1076
msgctxt "text_id=22984 | speaker=unknown"
msgid "  She lay lifelessly on the ground."
msgstr "　蒼崎はそのまま地面に倒れ、ぴくりとも動かない。"

#. Occurrence WIK_P_1:1097:22985: scene=WIK_P_1
#: WIK_P_1:1097
msgctxt "text_id=22985 | speaker=unknown"
msgid "  I... I..."
msgstr "　わたし、は"

#. Occurrence WIK_P_1:1103:22986: scene=WIK_P_1
#: WIK_P_1:1103
msgctxt "text_id=22986 | speaker=unknown"
msgid "  ...I know she looked in my direction before she burst out laughing."
msgstr "　蒼崎がわたしを―――いや、わたしがいる方向を見て爆笑した事を、正しく理解した。"

#. Occurrence WIK_P_1:1124:22987: scene=WIK_P_1
#: WIK_P_1:1124
msgctxt "text_id=22987 | speaker=unknown"
msgid "  Behind me."
msgstr "　背後には。"

#. Occurrence WIK_P_1:1129:22988: scene=WIK_P_1
#: WIK_P_1:1129
msgctxt "text_id=22988 | speaker=unknown"
msgid "  Footsteps. I could barely make them out in the rain."
msgstr "　雨音に紛れて、忍び寄ってくる足音が。"

#. Occurrence WIK_P_1:1136:22989: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_P_1_0007; voice_prefix=B10; voice_category=5; scene=WIK_P_1
#: WIK_P_1:1136
msgctxt "text_id=22989 | speaker=kojika"
msgid "\"...!\""
msgstr "「―――！」"

#. Occurrence WIK_P_1:1160:22990: scene=WIK_P_1
#: WIK_P_1:1160
msgctxt "text_id=22990 | speaker=unknown"
msgid "  I don't have time to look back or think."
msgstr "　振り返ることも、迷う余裕もなかった。"

#. Occurrence WIK_P_1:1165:22991: scene=WIK_P_1
#: WIK_P_1:1165
msgctxt "text_id=22991 | speaker=unknown"
msgid "  I ran as fast as I could."
msgstr "　わたしは全力で走り出す。"

#. Occurrence WIK_P_1:1170:22992: scene=WIK_P_1
#: WIK_P_1:1170
msgctxt "text_id=22992 | speaker=unknown"
msgid "  I needed to get away from whatever was behind me."
msgstr "　背後に忍び寄った人影から逃げるために。"

#. Occurrence WIK_P_1:1175:22993: scene=WIK_P_1
#: WIK_P_1:1175
msgctxt "text_id=22993 | speaker=unknown"
msgid "  I sprinted into the deep, dark forest, away from the mansion."
msgstr "　背後にあった屋敷から正反対の、暗い暗い嵐の森に。"

#. Occurrence WIK_P_1:1196:22994: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_P_1_0008; voice_prefix=B10; voice_category=5; scene=WIK_P_1
#: WIK_P_1:1196
msgctxt "text_id=22994 | speaker=kojika"
msgid "\"Hah, hah, hah, hah!\""
msgstr "「はっ、はっ、はっ、はっ―――！」"

#. Occurrence WIK_P_1:1202:22995: scene=WIK_P_1
#: WIK_P_1:1202
msgctxt "text_id=22995 | speaker=unknown"
msgid "  My chest burned with the exertion."
msgstr "　息をあげて走る。"

#. Occurrence WIK_P_1:1207:22996: scene=WIK_P_1
#: WIK_P_1:1207
msgctxt "text_id=22996 | speaker=unknown"
msgid "  I'd never pushed myself this hard, even during P.E. class."
msgstr "　体育の授業でも見せたことのない全力疾走。"

#. Occurrence WIK_P_1:1212:22997: scene=WIK_P_1
#: WIK_P_1:1212
msgctxt "text_id=22997 | speaker=unknown"
msgid "  Wow. I was a pretty good runner."
msgstr "　なんだ、わたしも結構走れるじゃん。"

#. Occurrence WIK_P_1:1217:22998: scene=WIK_P_1
#: WIK_P_1:1217
msgctxt "text_id=22998 | speaker=unknown"
msgid "  It's amazing what humans could do when we think we're about to die."
msgstr "　やっぱり人間、死ぬ気になれば最低でも人並みの運動神経は発揮できるんだ、とにやついたりする。"

#. Occurrence WIK_P_1:1222:22999: scene=WIK_P_1
#: WIK_P_1:1222
msgctxt "text_id=22999 | speaker=unknown"
msgid "  My mind began to wander, trying to escape the reality of the situation, when..."
msgstr "　その脳天気に現実逃避のツケが、"

#. Occurrence WIK_P_1:1274:23000: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_P_1_0009; voice_prefix=B10; voice_category=5; scene=WIK_P_1
#: WIK_P_1:1274
msgctxt "text_id=23000 | speaker=kojika"
msgid "\"Huh?\""
msgstr "「え？」"

#. Occurrence WIK_P_1:1281:23001: scene=WIK_P_1
#: WIK_P_1:1281
msgctxt "text_id=23001 | speaker=unknown"
msgid "  Suddenly, I felt like I was floating."
msgstr "　突然の浮遊感。"

#. Occurrence WIK_P_1:1286:23002: scene=WIK_P_1
#: WIK_P_1:1286
msgctxt "text_id=23002 | speaker=unknown"
msgid "  My feet kicked wildly at the air."
msgstr "　わたしの足は、地面ではなく、何もない中空を蹴っていた。"

#. Occurrence WIK_P_1:1307:23003: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_P_1_0010; voice_prefix=B10; voice_category=5; scene=WIK_P_1
#: WIK_P_1:1307
msgctxt "text_id=23003 | speaker=kojika"
msgid "\"Wait... what?\""
msgstr "「あ―――れ」"

#. Occurrence WIK_P_1:1373:23004: scene=WIK_P_1
#: WIK_P_1:1373
msgctxt "text_id=23004 | speaker=unknown"
msgid "  I seemed to be falling backward."
msgstr "　背中から落ちたらしい。"

#. Occurrence WIK_P_1:1378:23005: scene=WIK_P_1
#: WIK_P_1:1378
msgctxt "text_id=23005 | speaker=unknown"
msgid "  Every breath sent a painful spasm through my back."
msgstr "　呼吸をすると背中が痛む。"

#. Occurrence WIK_P_1:1383:23006: scene=WIK_P_1
#: WIK_P_1:1383
msgctxt "text_id=23006 | speaker=unknown"
msgid "  I reached for my back, feeling like something was wrong, and touched something wet."
msgstr "　やばい、と思って背中に指をあてると、ぬるり、と液体らしきものの感触があった。"

#. Occurrence WIK_P_1:1406:23007: scene=WIK_P_1
#: WIK_P_1:1406
msgctxt "text_id=23007 | speaker=unknown"
msgid "  ...I timidly looked at my hand."
msgstr "　……しげしげと眺める。"

#. Occurrence WIK_P_1:1411:23008: scene=WIK_P_1
#: WIK_P_1:1411
msgctxt "text_id=23008 | speaker=unknown"
msgid "  As much I hated to admit it... my hand was strawberry red."
msgstr "　言いたくないけど、<苺|いちご>みたいに<真|ま>っ<赤|か>っ<赤|か>。"

#. Occurrence WIK_P_1:1416:23009: scene=WIK_P_1
#: WIK_P_1:1416
msgctxt "text_id=23009 | speaker=unknown"
msgid "  I licked it. Yup, tastes like iron."
msgstr "　舐めてみると、やっぱりかすかな鉄の味。"

#. Occurrence WIK_P_1:1421:23010: scene=WIK_P_1
#: WIK_P_1:1421
msgctxt "text_id=23010 | speaker=unknown"
msgid "  I'd lost over a liter of blood, and it only kept flowing."
msgstr "　出血量は一リットル超えで、いまもまだ増量中。"

#. Occurrence WIK_P_1:1442:23011: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_P_1_0011; voice_prefix=B10; voice_category=5; scene=WIK_P_1
#: WIK_P_1:1442
msgctxt "text_id=23011 | speaker=kojika"
msgid "\"I can't... believe this...\""
msgstr "「……信じ、らんない……」"

#. Occurrence WIK_P_1:1449:23012: scene=WIK_P_1
#: WIK_P_1:1449
msgctxt "text_id=23012 | speaker=unknown"
msgid "  Horrifying reality stopped me from finishing my sentence."
msgstr "　どうしようもない事実に、喉をあえがせる。"

#. Occurrence WIK_P_1:1454:23013: scene=WIK_P_1
#: WIK_P_1:1454
msgctxt "text_id=23013 | speaker=unknown"
msgid "  Something was coming this way."
msgstr "“何者か”が近寄ってくる。"

#. Occurrence WIK_P_1:1459:23014: scene=WIK_P_1
#: WIK_P_1:1459
msgctxt "text_id=23014 | speaker=unknown"
msgid "  At this point, I didn't really care."
msgstr "　けどわたしにはもうどうでもいい事だ。"

#. Occurrence WIK_P_1:1464:23015: scene=WIK_P_1
#: WIK_P_1:1464
msgctxt "text_id=23015 | speaker=unknown"
msgid "  Would I sleep forever..."
msgstr "　このまま意識を失って永遠に目覚めないか、"

#. Occurrence WIK_P_1:1469:23016: scene=WIK_P_1
#: WIK_P_1:1469
msgctxt "text_id=23016 | speaker=unknown"
msgid "  ...or be captured by the killer?"
msgstr "　正体不明の殺人鬼に捕まるか。"

#. Occurrence WIK_P_1:1490:23017: scene=WIK_P_1
#: WIK_P_1:1490
msgctxt "text_id=23017 | speaker=unknown"
msgid "  Either way,"
msgstr "　どちらにせよ、もう、"

#. Occurrence WIK_P_1:1496:23018: scene=WIK_P_1
#: WIK_P_1:1496
msgctxt "text_id=23018 | speaker=unknown"
msgid "  apparently, this was how my night would end."
msgstr "　わたしの夜は、ここで、おしまいという事らしい―――"

#. Occurrence WIK_P_2:30:23019: scene=WIK_P_2
#: WIK_P_2:30
msgctxt "text_id=23019 | speaker=unknown"
msgid "  I should wait inside the mansion for all three of them to return."
msgstr "　ここは館内で、三人の帰りを待つべきだと思った。"

#. Occurrence WIK_P_2:63:23020: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_P_2_0000; voice_prefix=A10; voice_category=1; scene=WIK_P_2
#: WIK_P_2:63
msgctxt "text_id=23020 | speaker=aoko"
msgid "\"I'm going to head out. If I don't find anything after twenty minutes, I'll be back.\""
msgstr "「それじゃ行ってくる。二十分捜して何も見つからなかったら戻りましょう」"

#. Occurrence WIK_P_2:82:23021: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_P_2_0000; voice_prefix=B40; voice_category=8; scene=WIK_P_2
#: WIK_P_2:82
msgctxt "text_id=23021 | speaker=eiri"
msgid "\"Sounds like a plan. Let's go, Soujyuro.\""
msgstr "「賢明です。行きますよ、草十郎君」"

#. Occurrence WIK_P_2:105:23022: scene=WIK_P_2
#: WIK_P_2:105
msgctxt "text_id=23022 | speaker=unknown"
msgid "  Sizuki usually kept his distance from Father Eiri, but there was nothing usual about tonight."
msgstr "　普段は詠梨神父の近くに寄らない静希だけど、今夜はさすがに特別みたいだ。"

#. Occurrence WIK_P_2:110:23023: scene=WIK_P_2
#: WIK_P_2:110
msgctxt "text_id=23023 | speaker=unknown"
msgid "  He kept pace at the priest's side, his head on a swivel."
msgstr "　ぴったりと横に張り付いて、背中を守るように走っていった。"

#. Occurrence WIK_P_2:208:23024: scene=WIK_P_2
#: WIK_P_2:208
msgctxt "text_id=23024 | speaker=unknown"
msgid "  I waited for what felt like an eternity."
msgstr "　……待つだけの時間が過ぎていく。"

#. Occurrence WIK_P_2:213:23025: scene=WIK_P_2
#: WIK_P_2:213
msgctxt "text_id=23025 | speaker=unknown"
msgid "  The power still wasn't back on."
msgstr "　屋敷の電気はまだ回復しない。"

#. Occurrence WIK_P_2:222:23026: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_P_2_0000; voice_prefix=A40; voice_category=2; scene=WIK_P_2
#: WIK_P_2:222
msgctxt "text_id=23026 | speaker=alice"
msgid "\"Looks like we're not going to get the lights back tonight."
msgstr "「もう今夜中の復旧はないみたい。"

#. Occurrence WIK_P_2:234:23027: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_P_2_0001; voice_prefix=A40; voice_category=2; scene=WIK_P_2
#: WIK_P_2:234
msgctxt "text_id=23027 | speaker=alice"
msgid "  The guest rooms run on a separate set of wiring, so let's hope they're still good.\""
msgstr "　客室の配線は別系統だから、まだ電源が生きていればいいけど」"

#. Occurrence WIK_P_2:255:23028: scene=WIK_P_2
#: WIK_P_2:255
msgctxt "text_id=23028 | speaker=unknown"
msgid "  Those rooms must've been added at a later date."
msgstr "　久遠寺邸の客室は後から造られたものらしい。"

#. Occurrence WIK_P_2:260:23029: scene=WIK_P_2
#: WIK_P_2:260
msgctxt "text_id=23029 | speaker=unknown"
msgid "  All the older areas of the mansion, like the drawing room, hallways, and west wing, were pitch-dark."
msgstr "　古くからある箇所……居間や廊下、西館は完全に闇に没したようだ。"

#. Occurrence WIK_P_2:285:23030: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_P_2_0000; voice_prefix=B70; voice_category=4; scene=WIK_P_2
#: WIK_P_2:285
msgctxt "text_id=23030 | speaker=tobimaru"
msgid "\"Wait. Where's Beo?\""
msgstr "「待て。ベオはどこにいった？」"

#. Occurrence WIK_P_2:295:23031: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_P_2_0000; voice_prefix=B10; voice_category=5; scene=WIK_P_2
#: WIK_P_2:295
msgctxt "text_id=23031 | speaker=kojika"
msgid "\"Huh?! Oh, yeah. I don't see him anywhere.\""
msgstr "「！　そういえば何処にもいないけど……」"

#. Occurrence WIK_P_2:306:23032: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_P_2_0000; voice_prefix=B30; voice_category=9; scene=WIK_P_2
#: WIK_P_2:306
msgctxt "text_id=23032 | speaker=ritsuka"
msgid "\"I'll go look for him. Everyone else stay here. Don't leave Yuika's side. Got it?\""
msgstr "「わたしが捜してくる。みんなはここにいて。いい、決して唯架ちゃんから離れちゃダメよ」"

#. Occurrence WIK_P_2:315:23033: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_P_2_0000; voice_prefix=B20; voice_category=10; scene=WIK_P_2
#: WIK_P_2:315
msgctxt "text_id=23033 | speaker=yuika"
msgid "\"Ritsuka...\""
msgstr "「姉さん」"

#. Occurrence WIK_P_2:326:23034: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_P_2_0001_B; voice_prefix=B30; voice_category=9; scene=WIK_P_2
#: WIK_P_2:326
msgctxt "text_id=23034 | speaker=ritsuka"
msgid "\"I'll be fine, trust me. I'm used to dark nights like these.\""
msgstr "「大丈夫よ、信頼して。これでも闇夜には慣れてるわ」"

#. Occurrence WIK_P_2:351:23035: scene=WIK_P_2
#: WIK_P_2:351
msgctxt "text_id=23035 | speaker=unknown"
msgid "  Ritsuka disappeared up the stairs to the second floor of the mansion."
msgstr "　律架さんは屋敷の二階へと消えていった。"

#. Occurrence WIK_P_2:373:23036: scene=WIK_P_2
#: WIK_P_2:373
msgctxt "text_id=23036 | speaker=unknown"
msgid "  I..."
msgstr "　わたしは、"

#. Occurrence WIK_SELECT_Q:8:23037: scene=WIK_SELECT_Q
#: WIK_SELECT_Q:8
msgctxt "text_id=23037 | speaker=unknown"
msgid "-Decision Q-"
msgstr "～選択肢Ｑ～"

#. Occurrence WIK_Q_1:30:23038: scene=WIK_Q_1
#: WIK_Q_1:30
msgctxt "text_id=23038 | speaker=unknown"
msgid "  I feel like if this was a horror movie, this would be the part that gets us killed."
msgstr "　不謹慎だけど、ホラー映画ならまっさきに死ぬパターンだ、と思った。"

#. Occurrence WIK_Q_2:30:23039: scene=WIK_Q_2
#: WIK_Q_2:30
msgctxt "text_id=23039 | speaker=unknown"
msgid "  Thinking about it..."
msgstr "　……そういえば。"

#. Occurrence WIK_Q_2:35:23040: scene=WIK_Q_2
#: WIK_Q_2:35
msgctxt "text_id=23040 | speaker=unknown"
msgid "  ...they were away for a while, so, like Aozaki, they could've murdered Mr. Tokitsu and Mr. Yamasiro, too."
msgstr "　あの人も蒼崎同様、土桔氏と山城先生、その両名を殺害できる“不在時間”を持つ人だった、と思った。"

#. Occurrence WIK_Q_A:41:23041: scene=WIK_Q_A
#: WIK_Q_A:41
msgctxt "text_id=23041 | speaker=unknown"
msgid "  After a long twenty minutes, Aozaki returned."
msgstr "　二十分が経過して、まず蒼崎が戻ってきた。"

#. Occurrence WIK_Q_A:46:23042: scene=WIK_Q_A
#: WIK_Q_A:46
msgctxt "text_id=23042 | speaker=unknown"
msgid "  She took off her raincoat, and dried herself off with a towel."
msgstr "　蒼崎は雨ガッパを脱いで、バスタオルで体を拭いている。"

#. Occurrence WIK_Q_A:70:23043: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_Q_A_0000; voice_prefix=A10; voice_category=1; scene=WIK_Q_A
#: WIK_Q_A:70
msgctxt "text_id=23043 | speaker=aoko"
msgid "\"Whew, that's some storm out there."
msgstr "「いや、ひどい嵐だわ、こりゃ。"

#. Occurrence WIK_Q_A:81:23044: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_Q_A_0001; voice_prefix=A10; voice_category=1; scene=WIK_Q_A
#: WIK_Q_A:81
msgctxt "text_id=23044 | speaker=aoko"
msgid "  The wind's like a brick wall. I'm surprised the trees are still upright... Then again, that's probably the Ploy's doing.\""
msgstr "　もう風っていうより壁？　周りの木が飛んでいってないのが不思議なくらい。……まあ、プロイの仕業なんだから、それぐらいアリなんだろうけど」"

#. Occurrence WIK_Q_A:101:23045: scene=WIK_Q_A
#: WIK_Q_A:101
msgctxt "text_id=23045 | speaker=unknown"
msgid "  Aozaki explained that she'd patrolled a loop of the entire mansion, starting from the left side."
msgstr "　蒼崎は洋館を出て、左手方向からぐるりと洋館を回ってきたらしい。"

#. Occurrence WIK_Q_A:106:23046: scene=WIK_Q_A
#: WIK_Q_A:106
msgctxt "text_id=23046 | speaker=unknown"
msgid "  She didn't find anything in front of the sunroom."
msgstr "　サンルームの前には何もなかったそうだ。"

#. Occurrence WIK_Q_A:132:23047: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_Q_A_0002; voice_prefix=A10; voice_category=1; scene=WIK_Q_A
#: WIK_Q_A:132
msgctxt "text_id=23047 | speaker=aoko"
msgid "\"So where are Father Eiri and Soujyuro?\""
msgstr "「それより詠梨と草十郎は？」"

#. Occurrence WIK_Q_A:148:23048: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_Q_A_0000; voice_prefix=B20; voice_category=10; scene=WIK_Q_A
#: WIK_Q_A:148
msgctxt "text_id=23048 | speaker=yuika"
msgid "\"...You didn't run into them?\""
msgstr "「……途中ですれ違わなかったのですか？」"

#. Occurrence WIK_Q_A:157:23049: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_Q_A_0003_0; voice_prefix=A10; voice_category=1; scene=WIK_Q_A
#: WIK_Q_A:157
msgctxt "text_id=23049 | speaker=aoko"
msgid "\"Nope. Soon as we got outside, they said they wanted to check out the forest."
msgstr "「ぜんぜん。外に出る時、森の方が気になる、とか言ってたけど……"

#. Occurrence WIK_Q_A:170:23050: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_Q_A_0003_1; voice_prefix=A10; voice_category=1; scene=WIK_Q_A
#: WIK_Q_A:170
msgctxt "text_id=23050 | speaker=aoko"
msgid "There's no way they went there in this storm, is there...?\""
msgstr "まさかあの二人、この嵐の中で森に入ったんじゃ……」"

#. Occurrence WIK_Q_A:175:23051: scene=WIK_Q_A
#: WIK_Q_A:175
msgctxt "text_id=23051 | speaker=unknown"
msgid "  Aozaki and Sister Yuika exchanged concerned glances."
msgstr "　不安げに顔を合わせる蒼崎とシスター唯架。"

#. Occurrence WIK_Q_A:180:23052: scene=WIK_Q_A
#: WIK_Q_A:180
msgctxt "text_id=23052 | speaker=unknown"
msgid "  Then..."
msgstr "　そこへ、"

#. Occurrence WIK_Q_A:221:23053: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_Q_A_0000; voice_prefix=A30; voice_category=3; scene=WIK_Q_A
#: WIK_Q_A:221
msgctxt "text_id=23053 | speaker=soujuurou"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence WIK_Q_A:226:23054: scene=WIK_Q_A
#: WIK_Q_A:226
msgctxt "text_id=23054 | speaker=unknown"
msgid "  Sizuki came back inside, looking sullen and dripping wet."
msgstr "　沈んだ顔で、ずぶ濡れの静希が戻ってきた。"

#. Occurrence WIK_Q_A:231:23055: scene=WIK_Q_A
#: WIK_Q_A:231
msgctxt "text_id=23055 | speaker=unknown"
msgid "  Father Eiri wasn't with him."
msgstr "　詠梨神父の姿はない。"

#. Occurrence WIK_Q_A:257:23056: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_Q_A_0001; voice_prefix=A30; voice_category=3; scene=WIK_Q_A
#: WIK_Q_A:257
msgctxt "text_id=23056 | speaker=soujuurou"
msgid "\"...Sorry."
msgstr "「……すまない。"

#. Occurrence WIK_Q_A:257:23057: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_Q_A_0001; voice_prefix=A30; voice_category=3; scene=WIK_Q_A
#: WIK_Q_A:257
msgctxt "text_id=23057 | speaker=soujuurou"
msgid "  I looked away for a second, and then something very funny happened to the Father.\""
msgstr "　目を離した<隙|すき>に、詠梨神父がすごく面白いコトに」"

#. Occurrence WIK_Q_A:278:23058: scene=WIK_Q_A
#: WIK_Q_A:278
msgctxt "text_id=23058 | speaker=unknown"
msgid "  Sizuki was clearly downtrodden, but he'd made a bizarre choice of words."
msgstr "　悲愴な顔つきなのに、台詞だけはあいかわらず空気を読まない静希だった。"

#. Occurrence WIK_Q_A:321:23059: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_Q_A_0001; voice_prefix=B20; voice_category=10; scene=WIK_Q_A
#: WIK_Q_A:321
msgctxt "text_id=23059 | speaker=yuika"
msgid "\"Mr. Sizuki. You mean Father Eiri's...?\""
msgstr "「静希さん。まさか、エイリ神父が……？」"

#. Occurrence WIK_Q_A:332:23060: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_Q_A_0004; voice_prefix=A10; voice_category=1; scene=WIK_Q_A
#: WIK_Q_A:332
msgctxt "text_id=23060 | speaker=aoko"
msgid "\"...Sounds that way. Who on earth could take out someone like Father Eiri...?!\""
msgstr "「……そのまさかみたいね。あの詠梨までやられるなんて……何者なのよ、一体……」"

#. Occurrence WIK_Q_A:353:23061: scene=WIK_Q_A
#: WIK_Q_A:353
msgctxt "text_id=23061 | speaker=unknown"
msgid "  The foyer fell silent."
msgstr "　ロビーは沈黙に包まれた。"

#. Occurrence WIK_Q_A:358:23062: scene=WIK_Q_A
#: WIK_Q_A:358
msgctxt "text_id=23062 | speaker=unknown"
msgid "  Sizuki was biting his lip, clearly ashamed of losing track of the priest and falling for the killer's trap."
msgstr "　一緒にいながら神父を見失い、みすみす“犯人”の餌食にさせてしまった後悔で、静希は唇を噛みしめている。"

#. Occurrence WIK_Q_A:389:23063: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_Q_A_0000; voice_prefix=B70; voice_category=4; scene=WIK_Q_A
#: WIK_Q_A:389
msgctxt "text_id=23063 | speaker=tobimaru"
msgid "\"Hm? Soujyuro, what are you holding?\""
msgstr "「？　草十郎、その手に持ってるの、なんだ？」"

#. Occurrence WIK_Q_A:395:23064: scene=WIK_Q_A
#: WIK_Q_A:395
msgctxt "text_id=23064 | speaker=unknown"
msgid "  Looking closer, I could see something long and fluffy in his hand, about eight inches in length."
msgstr "　よく見れば、静希は手に二十センチほどの、もふもふしたものを持っていた。"

#. Occurrence WIK_Q_A:423:23065: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_Q_A_0002; voice_prefix=A30; voice_category=3; scene=WIK_Q_A
#: WIK_Q_A:423
msgctxt "text_id=23065 | speaker=soujuurou"
msgid "\"I found it at the east wing, in front of the sunroom.\""
msgstr "「いや、館の東側……サンルームの前に落ちてたんだけど」"

#. Occurrence WIK_Q_A:446:23066: scene=WIK_Q_A
#: WIK_Q_A:446
msgctxt "text_id=23066 | speaker=unknown"
msgid "  He held up what looked like a golden dog plushie. There was a strange pattern on its forehead."
msgstr "　そう言って静希が差し出したものは、金色の犬のぬいぐるみだった。額にはおかしな紋様が刻まれている。"

#. Occurrence WIK_Q_A:476:23067: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_Q_A_0000; voice_prefix=A40; voice_category=2; scene=WIK_Q_A
#: WIK_Q_A:476
msgctxt "text_id=23067 | speaker=alice"
msgid "\"The fifth victim.\""
msgstr "「五人目の犠牲者ね」"

#. Occurrence WIK_Q_A:485:23068: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_Q_A_0005; voice_prefix=A10; voice_category=1; scene=WIK_Q_A
#: WIK_Q_A:485
msgctxt "text_id=23068 | speaker=aoko"
msgid "\"Wait, is that Beo?!"
msgstr "「って、それベオ！？"

#. Occurrence WIK_Q_A:485:23069: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_Q_A_0005; voice_prefix=A10; voice_category=1; scene=WIK_Q_A
#: WIK_Q_A:485
msgctxt "text_id=23069 | speaker=aoko"
msgid "  So he was the one we saw in front of the sunroom?\""
msgstr "　じゃあ、あいつがサンルームの前にいた人影！？」"

#. Occurrence WIK_Q_A:494:23070: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_Q_A_0001; voice_prefix=B70; voice_category=4; scene=WIK_Q_A
#: WIK_Q_A:494
msgctxt "text_id=23070 | speaker=tobimaru"
msgid "\"Oh... now you mention it, it did look like Beo."
msgstr "「お……言われてみれば、たしかにベオだったな。"

#. Occurrence WIK_Q_A:505:23071: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_Q_A_0002; voice_prefix=B70; voice_category=4; scene=WIK_Q_A
#: WIK_Q_A:505
msgctxt "text_id=23071 | speaker=tobimaru"
msgid "  Wait, was he trying to ask for our help?\""
msgstr "　あれ？　もしかしてアイツ、俺たちに助けを求めていたのか？」"

#. Occurrence WIK_Q_A:541:23072: scene=WIK_Q_A
#: WIK_Q_A:541
msgctxt "text_id=23072 | speaker=unknown"
msgid "  If he was, what did that mean?"
msgstr "　……そうなると、どうなる？"

#. Occurrence WIK_Q_A:583:23073: scene=WIK_Q_A
#: WIK_Q_A:583
msgctxt "text_id=23073 | speaker=unknown"
msgid "  Beo saw the killer outside the sunroom,"
msgstr "　ベオはサンルームの外で犯人を見て、"

#. Occurrence WIK_Q_A:588:23074: scene=WIK_Q_A
#: WIK_Q_A:588
msgctxt "text_id=23074 | speaker=unknown"
msgid "  was made to laugh somehow, remembered we were inside, and tried to get our attention?"
msgstr "　何らかの手段で笑わされて、咄嗟に部屋の中にいるわたしたちに助けを求めた……？"

#. Occurrence WIK_Q_A:648:23075: scene=WIK_Q_A
#: WIK_Q_A:648
msgctxt "text_id=23075 | speaker=unknown"
msgid "  Ritsuka was the one who warned us to stay away from Beo."
msgstr "　そんなベオから離れよう、と言いだしたのは律架さんだ。"

#. Occurrence WIK_Q_A:653:23076: scene=WIK_Q_A
#: WIK_Q_A:653
msgctxt "text_id=23076 | speaker=unknown"
msgid "  She said she was used to dark nights."
msgstr "　彼女は闇夜に慣れている、と言っていた。"

#. Occurrence WIK_Q_A:658:23077: scene=WIK_Q_A
#: WIK_Q_A:658
msgctxt "text_id=23077 | speaker=unknown"
msgid "  Did she know that the silhouette was Beo trying not to laugh?"
msgstr "　ならあの時、律架さんには人影が笑いを堪えようとしているベオだと分かっていたのではないか……？"

#. Occurrence WIK_Q_A:700:23078: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_Q_A_0006; voice_prefix=A10; voice_category=1; scene=WIK_Q_A
#: WIK_Q_A:700
msgctxt "text_id=23078 | speaker=aoko"
msgid "\"Maybe Beo found something. This is bad. I was secretly counting on him the most."
msgstr "「……ベオは何か見付けたのかもね。ひそかに一番頼りにしてたのに、痛手だわ。"

#. Occurrence WIK_Q_A:712:23079: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_Q_A_0007; voice_prefix=A10; voice_category=1; scene=WIK_Q_A
#: WIK_Q_A:712
msgctxt "text_id=23079 | speaker=aoko"
msgid "  Soujyuro, where was Father Eiri killed?\""
msgstr "　それで草十郎、詠梨はどのあたりでやられたの？」"

#. Occurrence WIK_Q_A:734:23080: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_Q_A_0003; voice_prefix=A30; voice_category=3; scene=WIK_Q_A
#: WIK_Q_A:734
msgctxt "text_id=23080 | speaker=soujuurou"
msgid "\"On the west side of the forest."
msgstr "「西側の森だ。"

#. Occurrence WIK_Q_A:778:23081: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_Q_A_0004; voice_prefix=A30; voice_category=3; scene=WIK_Q_A
#: WIK_Q_A:778
msgctxt "text_id=23081 | speaker=soujuurou"
msgid "We thought we saw something moving, and when we went to check I heard laughter."
msgstr "何か動くものがあるって森に入っていって、すぐに笑い声が聞こえてきた。"

#. Occurrence WIK_Q_A:818:23082: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_Q_A_0005; voice_prefix=A30; voice_category=3; scene=WIK_Q_A
#: WIK_Q_A:818
msgctxt "text_id=23082 | speaker=soujuurou"
msgid "  Then I heard this scream like thunder, and there was a shower of blood. When I looked up, I saw...\""
msgstr "　その後、落雷のような悲鳴と、滝のような血が降ってきて……見上げてみたら……」"

#. Occurrence WIK_Q_A:867:23083: scene=WIK_Q_A
#: WIK_Q_A:867
msgctxt "text_id=23083 | speaker=unknown"
msgid "  Everyone held their breath in anticipation."
msgstr "　ごくり、と全員が息を呑む。"

#. Occurrence WIK_Q_A:872:23084: scene=WIK_Q_A
#: WIK_Q_A:872
msgctxt "text_id=23084 | speaker=unknown"
msgid "  We all braced for the gruesome description of the priest's demise."
msgstr "　あの神父さんの死に様は、よほど悲惨なものだろうと覚悟して。"

#. Occurrence WIK_Q_A:898:23085: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_Q_A_0008; voice_prefix=A10; voice_category=1; scene=WIK_Q_A
#: WIK_Q_A:898
msgctxt "text_id=23085 | speaker=aoko"
msgid "\"You saw...?\""
msgstr "「見上げたら？」"

#. Occurrence WIK_Q_A:945:23086: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_Q_A_0006; voice_prefix=A30; voice_category=3; scene=WIK_Q_A
#: WIK_Q_A:945
msgctxt "text_id=23086 | speaker=soujuurou"
msgid "\"A bunch of ropes tied up like a spider's web between the trees."
msgstr "「うん。木と木の間に、蜘蛛の巣みたいにロープが張り巡らされていて。"

#. Occurrence WIK_Q_A:1143:23087: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_Q_A_0007; voice_prefix=A30; voice_category=3; scene=WIK_Q_A
#: WIK_Q_A:1143
msgctxt "text_id=23087 | speaker=soujuurou"
msgid "  His body was at the center, all twisted."
msgstr "　その中心で、クネクネしたポーズで死んでた。"

#. Occurrence WIK_Q_A:1149:23088: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_Q_A_0008; voice_prefix=A30; voice_category=3; scene=WIK_Q_A
#: WIK_Q_A:1149
msgctxt "text_id=23088 | speaker=soujuurou"
msgid "  He was completely naked."
msgstr "　なんか裸になって、"

#. Occurrence WIK_Q_A:1206:23089: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_Q_A_0009; voice_prefix=A30; voice_category=3; scene=WIK_Q_A
#: WIK_Q_A:1206
msgctxt "text_id=23089 | speaker=soujuurou"
msgid "And he had a rose in his mouth―\""
msgstr "薔薇くわえて」"

#. Occurrence WIK_Q_A:1214:23090: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_Q_A_0002; voice_prefix=B20; voice_category=10; scene=WIK_Q_A
#: WIK_Q_A:1214
msgctxt "text_id=23090 | speaker=yuika"
msgid "\"Ahahahahahahahaha!\""
msgstr "「あははははははははははは！」"

#. Occurrence WIK_Q_A:1267:23091: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_Q_A_0000; voice_prefix=B10; voice_category=5; scene=WIK_Q_A
#: WIK_Q_A:1267
msgctxt "text_id=23091 | speaker=kojika"
msgid "\"Huh?\""
msgstr "「へ？」"

#. Occurrence WIK_Q_A:1272:23092: scene=WIK_Q_A
#: WIK_Q_A:1272
msgctxt "text_id=23092 | speaker=unknown"
msgid "  Instinctively, I turned to face the laughter behind me."
msgstr "　背後から響いた爆笑に、つい振り返る。"

#. Occurrence WIK_Q_A:1289:23093: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_Q_A_0003; voice_prefix=B20; voice_category=10; scene=WIK_Q_A
#: WIK_Q_A:1289
msgctxt "text_id=23093 | speaker=yuika"
msgid "\"...Oops.\""
msgstr "「―――あ」"

#. Occurrence WIK_Q_A:1329:23094: scene=WIK_Q_A
#: WIK_Q_A:1329
msgctxt "text_id=23094 | speaker=unknown"
msgid "  It all happened so quickly."
msgstr "　あっという間の出来事だった。"

#. Occurrence WIK_Q_A:1334:23095: scene=WIK_Q_A
#: WIK_Q_A:1334
msgctxt "text_id=23095 | speaker=unknown"
msgid "  Sister Yuika had turned to stone as soon as she heard Sizuki's report."
msgstr "　静希からの報告を聞いた唯架さんは、一瞬で彫像になっていた。"

#. Occurrence WIK_Q_A:1381:23096: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_Q_A_0009; voice_prefix=A10; voice_category=1; scene=WIK_Q_A
#: WIK_Q_A:1381
msgctxt "text_id=23096 | speaker=aoko"
msgid "\"Yuika got petrified!\""
msgstr "「唯架さん、石化して死んだーーー！？」"

#. Occurrence WIK_Q_A:1408:23097: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_Q_A_0001; voice_prefix=A40; voice_category=2; scene=WIK_Q_A
#: WIK_Q_A:1408
msgctxt "text_id=23097 | speaker=alice"
msgid "\"Poor Yuika. She must've pictured what Sizuki was talking about.\""
msgstr "「悲劇ね。なまじ耳で世界を捉える人だから、静希君の言葉をリアルにイメージできてしまったのよ」"

#. Occurrence WIK_Q_A:1417:23098: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_Q_A_0003; voice_prefix=B70; voice_category=4; scene=WIK_Q_A
#: WIK_Q_A:1417
msgctxt "text_id=23098 | speaker=tobimaru"
msgid "\"She and Father Eiri were two of the sternest people I've ever met, and yet... Anyway, that's seven victims now. We're dropping like flies.\""
msgstr "「……俺は普段、この人と神父がどんだけ険悪なのか気になって仕方がないが、ともかくこれで七人だ。一気に減ったな」"

#. Occurrence WIK_Q_A:1437:23099: scene=WIK_Q_A
#: WIK_Q_A:1437
msgctxt "text_id=23099 | speaker=unknown"
msgid "  Unfortunately for us, all the people who posed the greatest threat to the killer were gone."
msgstr "　そう。不幸な事故だったけど、犯人にとっては一番厄介な人が、これで消えてしまった。"

#. Occurrence WIK_Q_A:1442:23100: scene=WIK_Q_A
#: WIK_Q_A:1442
msgctxt "text_id=23100 | speaker=unknown"
msgid "  The clock approached 1:00 AM."
msgstr "　時刻はじき午前一時になろうとしていた。"

#. Occurrence WIK_R_1:36:23101: scene=WIK_R_1
#: WIK_R_1:36
msgctxt "text_id=23101 | speaker=unknown"
msgid "  I could rest easy now."
msgstr "　私は、これで安心して眠れる、と思った。"

#. Occurrence WIK_R_1:71:23102: scene=WIK_R_1
#: WIK_R_1:71
msgctxt "text_id=23102 | speaker=unknown"
msgid "  I returned to my room, alone."
msgstr "　ひとりきりで部屋に戻る。"

#. Occurrence WIK_R_1:76:23103: scene=WIK_R_1
#: WIK_R_1:76
msgctxt "text_id=23103 | speaker=unknown"
msgid "  Even with Aozaki in confinement, we still had to stay on guard."
msgstr "　犯人候補の蒼崎が幽閉されても油断は禁物。"

#. Occurrence WIK_R_1:82:23104: scene=WIK_R_1
#: WIK_R_1:82
msgctxt "text_id=23104 | speaker=unknown"
msgid "  I locked the door to my room"
msgstr "　きっちりドアに鍵をかけて、"

msgctxt "text_id=23105 | speaker=unknown"
msgid " and lay down on my bed."
msgstr "ベッドに横になる。"

#. Occurrence WIK_R_1:90:23106: scene=WIK_R_1
#: WIK_R_1:90
msgctxt "text_id=23106 | speaker=unknown"
msgid "  All that was left to do was wait for morning."
msgstr "　後は朝を待つだけだ。"

#. Occurrence WIK_R_1:95:23107: scene=WIK_R_1
#: WIK_R_1:95
msgctxt "text_id=23107 | speaker=unknown"
msgid "  So much had happened, but at least I could finally sleep without worrying."
msgstr "　色々あったけど、これでようやく安心して眠れる。"

#. Occurrence WIK_R_1:130:23108: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_R_1_0000; voice_prefix=B10; voice_category=5; scene=WIK_R_1
#: WIK_R_1:130
msgctxt "text_id=23108 | speaker=kojika"
msgid "\"...Whew.\""
msgstr "「…………ふう」"

#. Occurrence WIK_R_1:136:23109: scene=WIK_R_1
#: WIK_R_1:136
msgctxt "text_id=23109 | speaker=unknown"
msgid "  God, if you're listening..."
msgstr "　神様、お願いします。"

#. Occurrence WIK_R_1:141:23110: scene=WIK_R_1
#: WIK_R_1:141
msgctxt "text_id=23110 | speaker=unknown"
msgid "  ...make everything go back to how it was by the time I wake up..."
msgstr "　目を覚ましたら、ちゃんと何もかも元通りになっていますように―――"

#. Occurrence WIK_R_1:259:23111: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_R_1_0001; voice_prefix=B10; voice_category=5; scene=WIK_R_1
#: WIK_R_1:259
msgctxt "text_id=23111 | speaker=kojika"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence WIK_R_1:264:23112: scene=WIK_R_1
#: WIK_R_1:264
msgctxt "text_id=23112 | speaker=unknown"
msgid "  I woke up to the sound of birds chirping outside."
msgstr "　小鳥の鳴き声で目を覚ました。"

#. Occurrence WIK_R_1:271:23113: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_R_1_0002; voice_prefix=B10; voice_category=5; scene=WIK_R_1
#: WIK_R_1:271
msgctxt "text_id=23113 | speaker=kojika"
msgid "\"Ungh... It's morning...\""
msgstr "「朝……朝に、なってる……」"

#. Occurrence WIK_R_1:277:23114: scene=WIK_R_1
#: WIK_R_1:277
msgctxt "text_id=23114 | speaker=unknown"
msgid "  The clock read half past five."
msgstr "　時刻は五時半。"

#. Occurrence WIK_R_1:282:23115: scene=WIK_R_1
#: WIK_R_1:282
msgctxt "text_id=23115 | speaker=unknown"
msgid "  The sun was beginning to peek over the horizon."
msgstr "　外はうっすらと日が差し始めている。"

#. Occurrence WIK_R_1:304:23116: scene=WIK_R_1
#: WIK_R_1:304
msgctxt "text_id=23116 | speaker=unknown"
msgid "  My ability to rise early was one of my few strong points, so I must've been really exhausted."
msgstr "　目覚めがいいのがわたしの数少ない取り柄なのに、疲れがたまっていたんだろう。"

#. Occurrence WIK_R_1:309:23117: scene=WIK_R_1
#: WIK_R_1:309
msgctxt "text_id=23117 | speaker=unknown"
msgid "  I foggily examined my wrinkled clothes in the mirror."
msgstr "　ぼんやりとした頭のまま、姿見で洋服のシワを確認する。"

#. Occurrence WIK_R_1:314:23118: scene=WIK_R_1
#: WIK_R_1:314
msgctxt "text_id=23118 | speaker=unknown"
msgid "  It was so quiet outside, like last night's storm never happened."
msgstr "　外は昨夜の嵐が嘘のように静かだ。"

#. Occurrence WIK_R_1:319:23119: scene=WIK_R_1
#: WIK_R_1:319
msgctxt "text_id=23119 | speaker=unknown"
msgid "  A silent morning, with no sounds of movement or talking in the house."
msgstr "　物音も、人の気配も、話し声もしない朝。"

#. Occurrence WIK_R_1:324:23120: scene=WIK_R_1
#: WIK_R_1:324
msgctxt "text_id=23120 | speaker=unknown"
msgid "  I stepped out into the hallway, feeling a vague premonition coming on."
msgstr "　わたしは漠然と、ある予感を抱いたまま廊下に出た。"

#. Occurrence WIK_R_1:370:23121: scene=WIK_R_1
#: WIK_R_1:370
msgctxt "text_id=23121 | speaker=unknown"
msgid "  It was quiet."
msgstr "　静かだ。"

#. Occurrence WIK_R_1:375:23122: scene=WIK_R_1
#: WIK_R_1:375
msgctxt "text_id=23122 | speaker=unknown"
msgid "  The air was crisp."
msgstr "　とても清潔な空気感。"

#. Occurrence WIK_R_1:422:23123: scene=WIK_R_1
#: WIK_R_1:422
msgctxt "text_id=23123 | speaker=unknown"
msgid "  Tsukiji's room was clean and tidy."
msgstr "　槻司の客室も清潔。"

#. Occurrence WIK_R_1:427:23124: scene=WIK_R_1
#: WIK_R_1:427
msgctxt "text_id=23124 | speaker=unknown"
msgid "  Father Eiri's room was clean and tidy."
msgstr "　詠梨神父用の客室も清潔。"

#. Occurrence WIK_R_1:432:23125: scene=WIK_R_1
#: WIK_R_1:432
msgctxt "text_id=23125 | speaker=unknown"
msgid "  Ritsuka's room was clean and tidy."
msgstr "　律架さんの客室も清潔。"

#. Occurrence WIK_R_1:454:23126: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_R_1_0003; voice_prefix=B10; voice_category=5; scene=WIK_R_1
#: WIK_R_1:454
msgctxt "text_id=23126 | speaker=kojika"
msgid "\"Anyone alive out there?\""
msgstr "「誰か、生きている人、いますかー？」"

#. Occurrence WIK_R_1:460:23127: scene=WIK_R_1
#: WIK_R_1:460
msgctxt "text_id=23127 | speaker=unknown"
msgid "  I yelled into the void of the west wing, but no one responded."
msgstr "　西館に呼びかけても返事はない。"

#. Occurrence WIK_R_1:465:23128: scene=WIK_R_1
#: WIK_R_1:465
msgctxt "text_id=23128 | speaker=unknown"
msgid "  My hunch was spot on. Something was wrong."
msgstr "　ああ、やっぱり、予感の通り。"

#. Occurrence WIK_R_1:471:23129: scene=WIK_R_1
#: WIK_R_1:471
msgctxt "text_id=23129 | speaker=unknown"
msgid "  This mansion was now the cleanest, quietest place in all of Misaki. It was over."
msgstr "　いま、この屋敷は三咲町で一番、静かで綺麗で、終わっている。"

#. Occurrence WIK_R_1:520:23130: scene=WIK_R_1
#: WIK_R_1:520
msgctxt "text_id=23130 | speaker=unknown"
msgid "  I went down to the basement where Aozaki was confined,"
msgstr "　蒼崎を閉じこめた地下室に向かう。"

#. Occurrence WIK_R_1:525:23131: scene=WIK_R_1
#: WIK_R_1:525
msgctxt "text_id=23131 | speaker=unknown"
msgid "  down the narrow staircase to the door."
msgstr "　狭い階段を下りて、扉につきあたる。"

#. Occurrence WIK_R_1:539:23132: scene=WIK_R_1
#: WIK_R_1:539
msgctxt "text_id=23132 | speaker=unknown"
msgid "  The padlock had been broken clean off from the outside."
msgstr "　南京錠は外側から外されていた。"

#. Occurrence WIK_R_1:637:23133: scene=WIK_R_1
#: WIK_R_1:637
msgctxt "text_id=23133 | speaker=unknown"
msgid "  Inside the tiny cellar, I saw... a single dead body, lying prone."
msgstr "　狭い地下室には、うつぶせで倒れた死体が一つ。"

#. Occurrence WIK_R_1:642:23134: scene=WIK_R_1
#: WIK_R_1:642
msgctxt "text_id=23134 | speaker=unknown"
msgid "  The beautiful, long hair was all I needed to know who it was. Aozaki."
msgstr "　彩度の高い、どこか日本人離れした長髪は、間違いなく蒼崎のものだ。"

#. Occurrence WIK_R_1:648:23135: scene=WIK_R_1
#: WIK_R_1:648
msgctxt "text_id=23135 | speaker=unknown"
msgid "  She wasn't breathing."
msgstr "　完全に呼吸は止まっている。"

#. Occurrence WIK_R_1:668:23136: scene=WIK_R_1
#: WIK_R_1:668
msgctxt "text_id=23136 | speaker=unknown"
msgid "  She hadn't been the killer."
msgstr "　蒼崎は犯人ではなかった。"

#. Occurrence WIK_R_1:673:23137: scene=WIK_R_1
#: WIK_R_1:673
msgctxt "text_id=23137 | speaker=unknown"
msgid "  It was unclear what time she was murdered."
msgstr "　彼女が何時殺されたのかは定かではない。"

#. Occurrence WIK_R_1:678:23138: scene=WIK_R_1
#: WIK_R_1:678
msgctxt "text_id=23138 | speaker=unknown"
msgid "  But whoever the killer was broke the lock, made Aozaki laugh, nonchalantly went upstairs, and..."
msgstr "　けれど、鍵をあけ、蒼崎を笑わせた犯人は、なに食わぬ顔で地上に戻り、そして―――"

#. Occurrence WIK_R_1:686:23139: scene=WIK_R_1
#: WIK_R_1:686
msgctxt "text_id=23139 | speaker=unknown"
msgid "  ...cut off my means of escape. They were going to show up soon."
msgstr "　わたしの逃げ場を塞いで、目の前に現れようとしていた。"

#. Occurrence WIK_R_1:706:23140: scene=WIK_R_1
#: WIK_R_1:706
msgctxt "text_id=23140 | speaker=unknown"
msgid "  They must have been hiding somewhere waiting for me to come down into the basement."
msgstr "　ソレはわたしが地下室に入るまで、どこかに隠れていたのだろう。"

#. Occurrence WIK_R_1:711:23141: scene=WIK_R_1
#: WIK_R_1:711
msgctxt "text_id=23141 | speaker=unknown"
msgid "  The stairs were the only way out."
msgstr "　地下室の階段は一本道だ。"

#. Occurrence WIK_R_1:716:23142: scene=WIK_R_1
#: WIK_R_1:716
msgctxt "text_id=23142 | speaker=unknown"
msgid "  If the killer followed me down here, I was trapped."
msgstr "　わたしが下りた後、後ろから下りればわたしを袋小路に追い詰められる。"

#. Occurrence WIK_R_1:749:23143: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_R_1_0004; voice_prefix=B10; voice_category=5; scene=WIK_R_1
#: WIK_R_1:749
msgctxt "text_id=23143 | speaker=kojika"
msgid "\"...Oh, well. Doesn't matter anymore.\""
msgstr "「……まあ、もうどうでもいっか」"

#. Occurrence WIK_R_1:755:23144: scene=WIK_R_1
#: WIK_R_1:755
msgctxt "text_id=23144 | speaker=unknown"
msgid "  I was at a dead end."
msgstr "　この状況は、もう手詰まりだ。"

#. Occurrence WIK_R_1:760:23145: scene=WIK_R_1
#: WIK_R_1:760
msgctxt "text_id=23145 | speaker=unknown"
msgid "  Game over. Victory to the real killer."
msgstr "　ゲームは真犯人の勝ち。"

#. Occurrence WIK_R_1:765:23146: scene=WIK_R_1
#: WIK_R_1:765
msgctxt "text_id=23146 | speaker=unknown"
msgid "  My thoughts were interrupted by the sounds of footsteps. The footsteps of Death..."
msgstr "　わたしは何を間違えていたのかをぼんやりと考えながら、破滅の足音に耳をかたむけた―――"

#. Occurrence WIK_R_2:30:23147: scene=WIK_R_2
#: WIK_R_2:30
msgctxt "text_id=23147 | speaker=unknown"
msgid "  I wasn't so sure about that."
msgstr "　わたしは、本当にそうだろうか、と思った。"

#. Occurrence WIK_R_2:69:23148: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_R_2_0000; voice_prefix=B30; voice_category=9; scene=WIK_R_2
#: WIK_R_2:69
msgctxt "text_id=23148 | speaker=ritsuka"
msgid "\"Now we can finally get some sleep."
msgstr "「これでやっと眠れるわ。"

#. Occurrence WIK_R_2:80:23149: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_R_2_0001; voice_prefix=B30; voice_category=9; scene=WIK_R_2
#: WIK_R_2:80
msgctxt "text_id=23149 | speaker=ritsuka"
msgid "  Good night, everyone.\""
msgstr "　それじゃあみんな、おやすみなさい」"

#. Occurrence WIK_R_2:90:23150: scene=WIK_R_2
#: WIK_R_2:90
msgctxt "text_id=23150 | speaker=unknown"
msgid "  Ritsuka disappeared up the west-wing stairs."
msgstr "　律架さんは西館の二階に消えていった。"

#. Occurrence WIK_R_2:121:23151: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_R_2_0000; voice_prefix=A40; voice_category=2; scene=WIK_R_2
#: WIK_R_2:121
msgctxt "text_id=23151 | speaker=alice"
msgid "\"...I'm going to get some rest too."
msgstr "「……わたしも休ませてもらうわ。"

#. Occurrence WIK_R_2:132:23152: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_R_2_0001; voice_prefix=A40; voice_category=2; scene=WIK_R_2
#: WIK_R_2:132
msgctxt "text_id=23152 | speaker=alice"
msgid "  Sizuki, your room's out of bounds until morning, so take the room you wanted to give to Father Eiri.\""
msgstr "　静希君は詠梨神父にあてがっていた部屋を使って。夜があけるまで、静希君の部屋は使えないから」"

#. Occurrence WIK_R_2:143:23153: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_R_2_0000; voice_prefix=A30; voice_category=3; scene=WIK_R_2
#: WIK_R_2:143
msgctxt "text_id=23153 | speaker=soujuurou"
msgid "\"Right. Thanks, Alice.\""
msgstr "「あ、そうだった。ありがとう有珠」"

#. Occurrence WIK_R_2:163:23154: scene=WIK_R_2
#: WIK_R_2:163
msgctxt "text_id=23154 | speaker=unknown"
msgid "  Miss Kuonji and Sizuki retired to their respective rooms."
msgstr "　久遠寺さんと静希もそれぞれの部屋に戻っていった。"

#. Occurrence WIK_R_2:194:23155: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0000; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:194
msgctxt "text_id=23155 | speaker=tobimaru"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence WIK_R_2:200:23156: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_R_2_0000; voice_prefix=B10; voice_category=5; scene=WIK_R_2
#: WIK_R_2:200
msgctxt "text_id=23156 | speaker=kojika"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence WIK_R_2:205:23157: scene=WIK_R_2
#: WIK_R_2:205
msgctxt "text_id=23157 | speaker=unknown"
msgid "  It was just us left."
msgstr "　あとはわたしたちだけだ。"

#. Occurrence WIK_R_2:210:23158: scene=WIK_R_2
#: WIK_R_2:210
msgctxt "text_id=23158 | speaker=unknown"
msgid "  I mustered up the courage to look at Tsukiji."
msgstr "　わたしは意を決して槻司の顔を見上げて、"

#. Occurrence WIK_R_2:245:23159: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0001; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:245
msgctxt "text_id=23159 | speaker=tobimaru"
msgid "\"Kumari, got a minute?\""
msgstr "「久万梨。話、ちょっとだけいいか？」"

#. Occurrence WIK_R_2:251:23160: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_R_2_0001; voice_prefix=B10; voice_category=5; scene=WIK_R_2
#: WIK_R_2:251
msgctxt "text_id=23160 | speaker=kojika"
msgid "\"Tsukiji, can I talk to you?\""
msgstr "「槻司、少しだけ話さない？」"

#. Occurrence WIK_R_2:287:23161: scene=WIK_R_2
#: WIK_R_2:287
msgctxt "text_id=23161 | speaker=unknown"
msgid "  We smiled at each other. We'd both had the same idea, apparently."
msgstr "　お互い同じ気持ちであったコトに、ちょっとだけ笑いあったりするのだった。"

#. Occurrence WIK_R_2:413:23162: scene=WIK_R_2
#: WIK_R_2:413
msgctxt "text_id=23162 | speaker=unknown"
msgid "  Things had gotten really out of hand tonight."
msgstr "　しかし、改めて考えると、とんでもないコトになった。"

#. Occurrence WIK_R_2:433:23163: scene=WIK_R_2
#: WIK_R_2:433
msgctxt "text_id=23163 | speaker=unknown"
msgid "  It was an ungodly hour."
msgstr "　時刻は草木も眠る丑三つ時。"

#. Occurrence WIK_R_2:438:23164: scene=WIK_R_2
#: WIK_R_2:438
msgctxt "text_id=23164 | speaker=unknown"
msgid "  The storm's raging outside seemed to portend the end of the world."
msgstr "　締め切った雨戸の外は、この世の終わりのような嵐。"

#. Occurrence WIK_R_2:443:23165: scene=WIK_R_2
#: WIK_R_2:443
msgctxt "text_id=23165 | speaker=unknown"
msgid "  If we laugh, we die, and yet here I am with a guy I've had a crush on for three years."
msgstr "　笑ったら死ぬ、なんておかしな世界で、わたしは、三年間それとなく意識していた男子と個室にいるのである。"

#. Occurrence WIK_R_2:467:23166: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0002; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:467
msgctxt "text_id=23166 | speaker=tobimaru"
msgid "\"I'm gonna have some tea. You want some?\""
msgstr "「お茶を淹れられるな、ここ。久万梨は紅茶でいいか？」"

#. Occurrence WIK_R_2:479:23167: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_R_2_0002; voice_prefix=B10; voice_category=5; scene=WIK_R_2
#: WIK_R_2:479
msgctxt "text_id=23167 | speaker=kojika"
msgid "\"I'll take a coffee. Black, no sugar.\""
msgstr "「コーヒー。すごく苦いの。砂糖いれないで」"

#. Occurrence WIK_R_2:490:23168: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0003; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:490
msgctxt "text_id=23168 | speaker=tobimaru"
msgid "\"Very badass. Sweet enough already for you?\""
msgstr "「そりゃ剛気だ。甘みは必要ねえってか」"

#. Occurrence WIK_R_2:500:23169: scene=WIK_R_2
#: WIK_R_2:500
msgctxt "text_id=23169 | speaker=unknown"
msgid "  That sounded a little sarcastic, but I know he didn't mean it that way."
msgstr "　槻司の悪態は、嫌味のようでいて、そうでない。"

#. Occurrence WIK_R_2:536:23170: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_R_2_0003; voice_prefix=B10; voice_category=5; scene=WIK_R_2
#: WIK_R_2:536
msgctxt "text_id=23170 | speaker=kojika"
msgid "\"Want to talk about Person A?\""
msgstr "「話って、人物Ａのコト？」"

#. Occurrence WIK_R_2:542:23171: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0004; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:542
msgctxt "text_id=23171 | speaker=tobimaru"
msgid "\"Yep. Still haven't got it figured out. You don't think it's 100% Aozaki, do you?\""
msgstr "「おう。まだ解決とは言えないからな。久万梨だって蒼崎が１００パーセント<星|ほし>だと思ってねえだろ？」"

#. Occurrence WIK_R_2:559:23172: scene=WIK_R_2
#: WIK_R_2:559
msgctxt "text_id=23172 | speaker=unknown"
msgid "  He passed me a coffee, and I slowly brought it to my mouth before taking a sip."
msgstr "　コーヒーカップを受け取って、口をつけながら頷く。"

#. Occurrence WIK_R_2:564:23173: scene=WIK_R_2
#: WIK_R_2:564
msgctxt "text_id=23173 | speaker=unknown"
msgid "  He was right. I didn't."
msgstr "　ま、そりゃそうよね。"

#. Occurrence WIK_R_2:569:23174: scene=WIK_R_2
#: WIK_R_2:569
msgctxt "text_id=23174 | speaker=unknown"
msgid "  We were both on the same page."
msgstr "　こういう話よね、わたしたち。"

#. Occurrence WIK_R_2:603:23175: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_R_2_0004; voice_prefix=B10; voice_category=5; scene=WIK_R_2
#: WIK_R_2:603
msgctxt "text_id=23175 | speaker=kojika"
msgid "\"Signs point to Aozaki, but you can't rule out Ritsuka and Sizuki, either."
msgstr "「蒼崎が該当するのは確かだけど。それを言うなら律架さんも静希もだしね。"

#. Occurrence WIK_R_2:615:23176: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_R_2_0005; voice_prefix=B10; voice_category=5; scene=WIK_R_2
#: WIK_R_2:615
msgctxt "text_id=23176 | speaker=kojika"
msgid "  The only people we can really trust are Miss Kuonji and each other. I mean, we've all been together since this started.\""
msgstr "　信頼できるのは久遠寺さんと、事件が起きてからずっと一緒にいたわたしたちぐらいじゃない？」"

#. Occurrence WIK_R_2:636:23177: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0005; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:636
msgctxt "text_id=23177 | speaker=tobimaru"
msgid "\"Hmm. I don't know about Kuonji."
msgstr "「ん？　久遠寺は信用できねえだろ。"

#. Occurrence WIK_R_2:648:23178: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0006; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:648
msgctxt "text_id=23178 | speaker=tobimaru"
msgid "  Feels to me more like she's on the Ploys' side.\""
msgstr "　アイツ、基本的にプロイとやらの味方じゃねえか」"

#. Occurrence WIK_R_2:684:23179: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_R_2_0006; voice_prefix=B10; voice_category=5; scene=WIK_R_2
#: WIK_R_2:684
msgctxt "text_id=23179 | speaker=kojika"
msgid "\"Really? She seems neutral to me. Got anything to back that up?\""
msgstr "「そうなの？　たしかにずっと中立っぽい態度だったけど、根拠は？」"

#. Occurrence WIK_R_2:706:23180: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0007_0; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:706
msgctxt "text_id=23180 | speaker=tobimaru"
msgid "\"She doesn't seem interested in finding the killer, for one... Oh, I know."
msgstr "「犯人捜しをする気がないっていうのと……そうだな、"

#. Occurrence WIK_R_2:720:23181: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0007_1; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:720
msgctxt "text_id=23181 | speaker=tobimaru"
msgid " This is just a hunch, but I feel like she's helping them somehow.\""
msgstr "勘で申し訳ないんだが、人物Ａとやらに肩入れしている気がする」"

#. Occurrence WIK_R_2:756:23182: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_R_2_0007; voice_prefix=B10; voice_category=5; scene=WIK_R_2
#: WIK_R_2:756
msgctxt "text_id=23182 | speaker=kojika"
msgid "\"It's possible. The Ploy belongs to her, and the killer's a Ploy in disguise. Maybe that's why she's neutral.\""
msgstr "「そりゃそうでしょ、プロイって久遠寺さんの持ち物なんだし、もう人物Ａはプロイが化けてるんだし。だから中立だったんじゃない？」"

#. Occurrence WIK_R_2:792:23183: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0008; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:792
msgctxt "text_id=23183 | speaker=tobimaru"
msgid "\"I don't mean she's helping the Ploy; I mean the person using it."
msgstr "「いや、そっちじゃない。いま動いているプロイにじゃなくて、使ったヤツに対してだよ。"

#. Occurrence WIK_R_2:804:23184: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0009; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:804
msgctxt "text_id=23184 | speaker=tobimaru"
msgid "  For a start, she didn't seem mad at all about someone using her Ploy like that.\""
msgstr "　だってアイツ、怒ってなかっただろ。自分の持ち物が勝手に使われたっていうのに」"

#. Occurrence WIK_R_2:824:23185: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_R_2_0008; voice_prefix=B10; voice_category=5; scene=WIK_R_2
#: WIK_R_2:824
msgctxt "text_id=23185 | speaker=kojika"
msgid "\"Oh.\""
msgstr "「あ」"

#. Occurrence WIK_R_2:844:23186: scene=WIK_R_2
#: WIK_R_2:844
msgctxt "text_id=23186 | speaker=unknown"
msgid "  He was right."
msgstr "　なるほど、と納得した。"

#. Occurrence WIK_R_2:849:23187: scene=WIK_R_2
#: WIK_R_2:849
msgctxt "text_id=23187 | speaker=unknown"
msgid "  Does that mean Miss Kuonji knew who the killer was?"
msgstr "　じゃあ、久遠寺さんは犯人を知っていたのだろうか？"

#. Occurrence WIK_R_2:875:23188: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0010; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:875
msgctxt "text_id=23188 | speaker=tobimaru"
msgid "\"I don't think she necessarily knows. Still, she's definitely hiding something."
msgstr "「知らないとは思うぜ。だが、あえて口にしていない事はあるだろうな。"

#. Occurrence WIK_R_2:886:23189: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0011; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:886
msgctxt "text_id=23189 | speaker=tobimaru"
msgid "  About Sweets Hearts, for example. Going off what Riddell said, you need a certain something to use it.\""
msgstr "　たとえばスイーツハーツとやらの詳しい特徴だ。リデルの口ぶりからすると、使う人間にはある種の特徴がありそうだった」"

#. Occurrence WIK_R_2:912:23190: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0012; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:912
msgctxt "text_id=23190 | speaker=tobimaru"
msgid "\"Maybe it's like a magical sword."
msgstr "「スイーツハーツは誰にでも使えるもんじゃねえと思う。"

#. Occurrence WIK_R_2:918:23191: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0013; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:918
msgctxt "text_id=23191 | speaker=tobimaru"
msgid "  Y'know, not just anyone can wield it. Only 'the chosen one.'\""
msgstr "　ほら、妖刀とか名刀とかで、持ち物が持ち主を選ぶって言うじゃねえか。あんな感じでな」"

#. Occurrence WIK_R_2:951:23192: scene=WIK_R_2
#: WIK_R_2:951
msgctxt "text_id=23192 | speaker=unknown"
msgid "  Could a thing really choose who uses it?"
msgstr "　……持ち物が使用者を選ぶ……？"

#. Occurrence WIK_R_2:956:23193: scene=WIK_R_2
#: WIK_R_2:956
msgctxt "text_id=23193 | speaker=unknown"
msgid "  If so, did that mean Miss Kuonji was supporting―no, empathetic to it?"
msgstr "　では、その条件とやらが久遠寺さん的には応援―――いや、共感できるものだったとか？"

#. Occurrence WIK_R_2:977:23194: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0014; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:977
msgctxt "text_id=23194 | speaker=tobimaru"
msgid "\"That aside, I know this is a little late to ask, but are you really okay with teaming up with me?\""
msgstr "「しっかし。今さらだけどな、久万梨、俺とコンビで良かったのか？」"

#. Occurrence WIK_R_2:982:23195: scene=WIK_R_2
#: WIK_R_2:982
msgctxt "text_id=23195 | speaker=unknown"
msgid "  Well, that came out of nowhere."
msgstr "　突然の、とんでもない質問。"

#. Occurrence WIK_R_2:987:23196: scene=WIK_R_2
#: WIK_R_2:987
msgctxt "text_id=23196 | speaker=unknown"
msgid "  I tried my best to stay calm as I answered,"
msgstr "　わたしは努めてクールに返答した。"

#. Occurrence WIK_R_2:1023:23197: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_R_2_0009; voice_prefix=B10; voice_category=5; scene=WIK_R_2
#: WIK_R_2:1023
msgctxt "text_id=23197 | speaker=kojika"
msgid "\"Yeah. I trust you, Tsukiji.\""
msgstr "「それはいい。わたし、槻司のこと信頼してるし」"

#. Occurrence WIK_R_2:1054:23198: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0015_0; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:1054
msgctxt "text_id=23198 | speaker=tobimaru"
msgid "\"Not a good idea trusting anyone in a situation like this."
msgstr "「いやあ、この場合まずいだろ、それ。"

#. Occurrence WIK_R_2:1068:23199: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0015_1; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:1068
msgctxt "text_id=23199 | speaker=tobimaru"
msgid " Feels like the person you trust the most'll stab you in the back.\""
msgstr "今夜にかぎっちゃ信頼している奴ほど危ねえじゃねえか」"

#. Occurrence WIK_R_2:1091:23200: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_R_2_0010; voice_prefix=B10; voice_category=5; scene=WIK_R_2
#: WIK_R_2:1091
msgctxt "text_id=23200 | speaker=kojika"
msgid "\"...I guess you're right. We should all be wary of everyone.\""
msgstr "「……そうね。疑ってかかるぐらいがちょうどいい」"

#. Occurrence WIK_R_2:1126:23201: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0016; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:1126
msgctxt "text_id=23201 | speaker=tobimaru"
msgid "\"Exactly. We can only trust ourselves. That's why we all need someone to keep an eye on us, objectively."
msgstr "「そういうコト。この事件で一番信用しちゃあならねえのは自分だ。だから常に、客観的に監視している相棒がいないと無実が証明できない。"

#. Occurrence WIK_R_2:1137:23202: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0017; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:1137
msgctxt "text_id=23202 | speaker=tobimaru"
msgid "  It's probably why Riddell wanted us all to pair up, too. Two minds, one body. Kinda appropriate given we're dealing with Sweets Hearts here.\""
msgstr "　リデルのヤツが二人一組で行動しようって言いだしたのは、そのあたりも含めてだろうよ。二心同体、スイーツハーツとは良く言ったもんだ」"

#. Occurrence WIK_R_2:1162:23203: scene=WIK_R_2
#: WIK_R_2:1162
msgctxt "text_id=23203 | speaker=unknown"
msgid "  We put Riddell behind us."
msgstr "　リデルの話はともかくとして。"

#. Occurrence WIK_R_2:1173:23204: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_R_2_0011; voice_prefix=B10; voice_category=5; scene=WIK_R_2
#: WIK_R_2:1173
msgctxt "text_id=23204 | speaker=kojika"
msgid "\"So who do you think's the most likely suspect at this point?\""
msgstr "「じゃあ槻司は、誰が一番怪しいと思ってる？」"

#. Occurrence WIK_R_2:1199:23205: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0018; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:1199
msgctxt "text_id=23205 | speaker=tobimaru"
msgid "\"I think we're all on equal ground. I still don't know if Yurihiko's body was the real deal or not."
msgstr "「全員平等だぜ。怪しいってんなら、俺はまだ土桔の爺さんの死体が本物かどうかさえ保留してるしな。"

#. Occurrence WIK_R_2:1210:23206: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0019; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:1210
msgctxt "text_id=23206 | speaker=tobimaru"
msgid "  I think the killer tricked Aozaki into hiding whatever's in her room, too. Get rid of the biggest threat, and all that.\""
msgstr "　蒼崎が自分の部屋を隠していた事も、ありゃ真犯人にうまく<嵌|は>められたんじゃないかって思ってる。一番の強敵を、真っ先に封じにきた結果かもしれん」"

#. Occurrence WIK_R_2:1236:23207: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_R_2_0012; voice_prefix=B10; voice_category=5; scene=WIK_R_2
#: WIK_R_2:1236
msgctxt "text_id=23207 | speaker=kojika"
msgid "\"You think she was framed?\""
msgstr "「蒼崎が嵌められた？」"

#. Occurrence WIK_R_2:1247:23208: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0020; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:1247
msgctxt "text_id=23208 | speaker=tobimaru"
msgid "\"Yeah. She was too preoccupied with covering something up to think about anything else."
msgstr "「ああ。事実上、あの行動力の固まりみたいな女が、自分の部屋を隠す事で手一杯だっただろ。"

#. Occurrence WIK_R_2:1259:23209: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0021_0; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:1259
msgctxt "text_id=23209 | speaker=tobimaru"
msgid "  Plus, she was saying some weird things. When do you think"
msgstr "　それに妙なコト言ってたじゃねえか。蒼崎の姉貴がいつああなったか、"

#. Occurrence WIK_R_2:1272:23210: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_R_2_0021_1; voice_prefix=B70; voice_category=4; scene=WIK_R_2
#: WIK_R_2:1272
msgctxt "text_id=23210 | speaker=tobimaru"
msgid " that business with Touko happened?\""
msgstr "久万梨はどう思う？」"

#. Occurrence WIK_R_2:1306:23211: scene=WIK_R_2
#: WIK_R_2:1306
msgctxt "text_id=23211 | speaker=unknown"
msgid "  I..."
msgstr "　……わたしは、"

#. Occurrence WIK_SELECT_S:8:23212: scene=WIK_SELECT_S
#: WIK_SELECT_S:8
msgctxt "text_id=23212 | speaker=unknown"
msgid "-Decision S-"
msgstr "～選択肢Ｓ～"

#. Occurrence WIK_ROBBY:36:23213: scene=WIK_ROBBY
#: WIK_ROBBY:36
msgctxt "text_id=23213 | speaker=unknown"
msgid "  I spaced out, and random thoughts filled my mind."
msgstr "　ぼんやりと、脳裏によぎった雑感にひたる。"

#. Occurrence WIK_ROBBY:47:23214: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_ROBBY_0000; voice_prefix=B60; voice_category=7; scene=WIK_ROBBY
#: WIK_ROBBY:47
msgctxt "text_id=23214 | speaker=yamashiro"
msgid "\"Kumari? What're you doing? Let's go.\""
msgstr "「久万梨くーん？　何しているんですか、行きますよー」"

#. Occurrence WIK_ROBBY:60:23215: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_ROBBY_0000; voice_prefix=B10; voice_category=5; scene=WIK_ROBBY
#: WIK_ROBBY:60
msgctxt "text_id=23215 | speaker=kojika"
msgid "\"Oh, sorry. Coming.\""
msgstr "「あ、はい、すぐ行きます」"

#. Occurrence WIK_ROBBY:85:23216: scene=WIK_ROBBY
#: WIK_ROBBY:85
msgctxt "text_id=23216 | speaker=unknown"
msgid "  The other two had already set off. I picked up my things and followed them."
msgstr "　わたしは荷物をまとめ直して、いつの間にか先行していたふたりを追いかけた。"

#. Occurrence WIK_ROBBY:128:23217: scene=WIK_ROBBY
#: WIK_ROBBY:128
msgctxt "text_id=23217 | speaker=unknown"
msgid "  Aozaki was verbally sparring with Mr. Yamasiro as they walked down the tree-lined path."
msgstr "　蒼崎は山城先生と口論しながら林道を歩いていく。"

#. Occurrence WIK_ROBBY:133:23218: scene=WIK_ROBBY
#: WIK_ROBBY:133
msgctxt "text_id=23218 | speaker=unknown"
msgid "  I hurried after them."
msgstr "　遅れないよう彼女の後を追う。"

#. Occurrence WIK_ROBBY:153:23219: scene=WIK_ROBBY
#: WIK_ROBBY:153
msgctxt "text_id=23219 | speaker=unknown"
msgid "  Looking up at the sky, I saw ominous clouds starting to roll in."
msgstr "　ふと空を仰ぐと、あれだけ晴れていた空模様は崩れ始めていた。"

#. Occurrence WIK_ROBBY:174:23220: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_ROBBY_0001; voice_prefix=B10; voice_category=5; scene=WIK_ROBBY
#: WIK_ROBBY:174
msgctxt "text_id=23220 | speaker=kojika"
msgid "\"Wait, what's the weather forecast for today?\""
msgstr "「あれ。今日の天気予報、どうだったっけ」"

#. Occurrence WIK_ROBBY:180:23221: scene=WIK_ROBBY
#: WIK_ROBBY:180
msgctxt "text_id=23221 | speaker=unknown"
msgid "  The heavens looked like they could open up any moment."
msgstr "　今にも泣き出しそうな空。"

#. Occurrence WIK_ROBBY:185:23222: scene=WIK_ROBBY
#: WIK_ROBBY:185
msgctxt "text_id=23222 | speaker=unknown"
msgid "  Would I have to trek back home in the rain?"
msgstr "　この分では、下手をすると帰りは雨になるんじゃないだろうな、とわたしは思った。"

#. Occurrence WIK_ROBBY:310:23223: scene=WIK_ROBBY
#: WIK_ROBBY:310
msgctxt "text_id=23223 | speaker=unknown"
msgid "  Once we were past of the woods, I could see more clearly."
msgstr "　林道を抜けると視界が開けた。"

#. Occurrence WIK_ROBBY:315:23224: scene=WIK_ROBBY
#: WIK_ROBBY:315
msgctxt "text_id=23224 | speaker=unknown"
msgid "  In the clearing stood a large building that felt out of time."
msgstr "　くり抜かれた空の下、時代錯誤な建物がある。"

#. Occurrence WIK_ROBBY:358:23225: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_ROBBY_0001; voice_prefix=B60; voice_category=7; scene=WIK_ROBBY
#: WIK_ROBBY:358
msgctxt "text_id=23225 | speaker=yamashiro"
msgid "\"What a magnificent European mansion! How anyone could call such a work of art a haunted house is beyond me!\""
msgstr "「おや、これはまた立派な洋館だ。幽霊屋敷なんて誰が言いだしたんだろうね。<誹謗|ひぼう><中傷|ちゅうしょう>もいいところだ」"

#. Occurrence WIK_ROBBY:388:23226: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_ROBBY_0000; voice_prefix=A10; voice_category=1; scene=WIK_ROBBY
#: WIK_ROBBY:388
msgctxt "text_id=23226 | speaker=aoko"
msgid "\"Well, they kind of have a point. No smoke without fire, right? That kind of thing happens around here. You should keep an eye out for ghosts, Mr. Yamasiro.\""
msgstr "「そうでもないですよ。火のないところに煙は立たないって言葉、ここにかぎっては本当ですから。お化けが出たぐらいで騒がないでくださいね、山城センセ」"

#. Occurrence WIK_ROBBY:394:23227: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_ROBBY_0002; voice_prefix=B60; voice_category=7; scene=WIK_ROBBY
#: WIK_ROBBY:394
msgctxt "text_id=23227 | speaker=yamashiro"
msgid "\"Hahaha! I find your attempts at humor scarier than any ghost, Aozaki.\""
msgstr "「ははは。蒼崎くんがそんな冗談を口にするなんて、僕らとしてはそっちの方が怖いな」"

#. Occurrence WIK_ROBBY:414:23228: scene=WIK_ROBBY
#: WIK_ROBBY:414
msgctxt "text_id=23228 | speaker=unknown"
msgid "  I wonder if he actually believed her."
msgstr "　蒼崎の忠告を、山城先生はどこまで真剣に受けとめているのだろう。"

#. Occurrence WIK_ROBBY:419:23229: scene=WIK_ROBBY
#: WIK_ROBBY:419
msgctxt "text_id=23229 | speaker=unknown"
msgid "  I've known Aozaki for three years and I think she's never told a joke with *that* expression."
msgstr "　しかし。三年程度の付き合いとはいえ、彼女が<あ|・><の|・><顔|・>で冗談を言った記憶はない。"

#. Occurrence WIK_ROBBY:446:23230: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_ROBBY_0002; voice_prefix=B10; voice_category=5; scene=WIK_ROBBY
#: WIK_ROBBY:446
msgctxt "text_id=23230 | speaker=kojika"
msgid "\"Aozaki. Were you serious about that?\""
msgstr "「蒼崎。今の話、本当？」"

#. Occurrence WIK_ROBBY:472:23231: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_ROBBY_0001_0; voice_prefix=A10; voice_category=1; scene=WIK_ROBBY
#: WIK_ROBBY:472
msgctxt "text_id=23231 | speaker=aoko"
msgid "\"Ghosts aside, strange stuff does happen here."
msgstr "「お化けが出るかは別にして、不思議な事なら起こらない事もないわ。"

#. Occurrence WIK_ROBBY:486:23232: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_ROBBY_0001_1; voice_prefix=A10; voice_category=1; scene=WIK_ROBBY
#: WIK_ROBBY:486
msgctxt "text_id=23232 | speaker=aoko"
msgid " Nothing to worry about though. If you see anything weird, ignore it.\""
msgstr "大丈夫、おかしなものを見てもスルーすれば害はないから」"

#. Occurrence WIK_ROBBY:507:23233: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_ROBBY_0003; voice_prefix=B10; voice_category=5; scene=WIK_ROBBY
#: WIK_ROBBY:507
msgctxt "text_id=23233 | speaker=kojika"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence WIK_ROBBY:512:23234: scene=WIK_ROBBY
#: WIK_ROBBY:512
msgctxt "text_id=23234 | speaker=unknown"
msgid "  I agreed with Mr. Yamasiro."
msgstr "　山城先生の意見に賛成する。"

#. Occurrence WIK_ROBBY:517:23235: scene=WIK_ROBBY
#: WIK_ROBBY:517
msgctxt "text_id=23235 | speaker=unknown"
msgid "  \"Ignore anything weird, even ghosts\" was kind of a scary thing to say."
msgstr "　幽霊を見ても無視すればＯＫ、という蒼崎の性格がいちばん怖い。"

#. Occurrence WIK_ROBBY:605:23236: scene=WIK_ROBBY
#: WIK_ROBBY:605
msgctxt "text_id=23236 | speaker=unknown"
msgid "  The foyer of the Kuonji Estate was colder than I expected."
msgstr "　久遠寺邸のロビーは冷えきっていた。"

#. Occurrence WIK_ROBBY:610:23237: scene=WIK_ROBBY
#: WIK_ROBBY:610
msgctxt "text_id=23237 | speaker=unknown"
msgid "  I knew the mountains were colder, but this was something else."
msgstr "　山中なので街より気温が低い……といっても、限度というものがある。"

#. Occurrence WIK_ROBBY:615:23238: scene=WIK_ROBBY
#: WIK_ROBBY:615
msgctxt "text_id=23238 | speaker=unknown"
msgid "  It felt like winter in here."
msgstr "　ここではもう、冬が到来しているような寒さだった。"

#. Occurrence WIK_ROBBY:636:23239: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_ROBBY_0003; voice_prefix=B60; voice_category=7; scene=WIK_ROBBY
#: WIK_ROBBY:636
msgctxt "text_id=23239 | speaker=yamashiro"
msgid "\"Would you look at this decor! From the outside, it looks like a standard Tudor style construction, but the foyer is closer to Romanesque architecture."
msgstr "「中も驚きですねぇ。外見から典型的なチューダー式かと思いましたが、ロビーの造りはロマネスク建築に近い。"

#. Occurrence WIK_ROBBY:642:23240: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_ROBBY_0004; voice_prefix=B60; voice_category=7; scene=WIK_ROBBY
#: WIK_ROBBY:642
msgctxt "text_id=23240 | speaker=yamashiro"
msgid "  The connecting hallway and the lobby here appear to be from different time periods. It's as though another building has been tacked on―Oh?\""
msgstr "　隣の通路とロビーとでも大きく年代が違いますね。まるでここだけ違う建物から持ってきた……おや？」"

#. Occurrence WIK_ROBBY:655:23241: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_ROBBY_0000; voice_prefix=B50; voice_category=6; scene=WIK_ROBBY
#: WIK_ROBBY:655
msgctxt "text_id=23241 | speaker=kinomi"
msgid "\"Whaaaat? Seriously? Mr. Yamasiro?\""
msgstr "「うえー？　不思議ぃー、山城がいるよー？」"

#. Occurrence WIK_ROBBY:676:23242: scene=WIK_ROBBY
#: WIK_ROBBY:676
msgctxt "text_id=23242 | speaker=unknown"
msgid "  I heard a stupid, irritating voice behind me, and sure enough, there was an idiot standing in the foyer."
msgstr "　聞き飽きたバカっぽい声に振り向くと、ロビーにはバカがいた。"

#. Occurrence WIK_ROBBY:687:23243: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_ROBBY_0001; voice_prefix=B50; voice_category=6; scene=WIK_ROBBY
#: WIK_ROBBY:687
msgctxt "text_id=23243 | speaker=kinomi"
msgid "\"Whoa! And Kojika, too!"
msgstr "「お、<金鹿|こじか>も一緒じゃーん。"

#. Occurrence WIK_ROBBY:693:23244: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_ROBBY_0002; voice_prefix=B50; voice_category=6; scene=WIK_ROBBY
#: WIK_ROBBY:693
msgctxt "text_id=23244 | speaker=kinomi"
msgid "  I wondered where the prez got to this morning. Guess she was picking up you two, huh?\""
msgstr "　そっか、会長ったら朝からいないと思ったら、ふたりを迎えに行ってたんだな！」"

#. Occurrence WIK_ROBBY:730:23245: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_ROBBY_0004; voice_prefix=B10; voice_category=5; scene=WIK_ROBBY
#: WIK_ROBBY:730
msgctxt "text_id=23245 | speaker=kojika"
msgid "\"Hey, what's Housuke doing here?\""
msgstr "「ちょっと。なんで<芳助|ほうすけ>がいんのよ」"

#. Occurrence WIK_ROBBY:741:23246: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_ROBBY_0002; voice_prefix=A10; voice_category=1; scene=WIK_ROBBY
#: WIK_ROBBY:741
msgctxt "text_id=23246 | speaker=aoko"
msgid "\"Soujyuro probably invited him. He said something this morning about a 'nice surprise' for everyone."
msgstr "「草十郎が声をかけたんでしょ。アイツ、今日はみんなを喜ばせる、とかはりきってたから。"

#. Occurrence WIK_ROBBY:752:23247: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_ROBBY_0003; voice_prefix=A10; voice_category=1; scene=WIK_ROBBY
#: WIK_ROBBY:752
msgctxt "text_id=23247 | speaker=aoko"
msgid "  Can't say I agree with his choice, but it could be worse. At least Kinomi can liven the mood.\""
msgstr "　ま、適切なチョイスじゃないけど、最悪ってワケでもないんじゃない？　<木|き><乃|の><美|み>君、とにかく騒がしいし」"

#. Occurrence WIK_ROBBY:789:23248: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_ROBBY_0003; voice_prefix=B50; voice_category=6; scene=WIK_ROBBY
#: WIK_ROBBY:789
msgctxt "text_id=23248 | speaker=kinomi"
msgid "\"Hell yeah I can! I've got a bunch of party tricks and jokes ready to go! Ghost stories, impressions, you name it!\""
msgstr "「おお、まっかせとけ！　ご期待に添うよう、今日は大量に新ネタ仕込んできたからね！　怪談もモノマネ芸も、そう簡単には品切れにはならねーぜ！」"

#. Occurrence WIK_ROBBY:815:23249: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_ROBBY_0005; voice_prefix=B10; voice_category=5; scene=WIK_ROBBY
#: WIK_ROBBY:815
msgctxt "text_id=23249 | speaker=kojika"
msgid "\"If we wanted something loud and annoying, we would've brought a cockatoo."
msgstr "「騒がしいだけならガチョウでも代用は利くでしょうに。"

#. Occurrence WIK_ROBBY:815:23250: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_ROBBY_0005; voice_prefix=B10; voice_category=5; scene=WIK_ROBBY
#: WIK_ROBBY:815
msgctxt "text_id=23250 | speaker=kojika"
msgid "  I can never tell what that Sizuki is thinking."
msgstr "　静希の考えって、ほんっと分かんない。"

#. Occurrence WIK_ROBBY:826:23251: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_ROBBY_0006; voice_prefix=B10; voice_category=5; scene=WIK_ROBBY
#: WIK_ROBBY:826
msgctxt "text_id=23251 | speaker=kojika"
msgid "  Housuke, make yourself useful and help me with my luggage.\""
msgstr "　芳助、バカっとしてないで荷物、持ってよ」"

#. Occurrence WIK_ROBBY:837:23252: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_ROBBY_0004; voice_prefix=B50; voice_category=6; scene=WIK_ROBBY
#: WIK_ROBBY:837
msgctxt "text_id=23252 | speaker=kinomi"
msgid "\"Come on! You know I'm funny!\""
msgstr "「そこはボケだよね！　ボケって言うんだよね、フツー！」"

#. Occurrence WIK_ROBBY:857:23253: scene=WIK_ROBBY
#: WIK_ROBBY:857
msgctxt "text_id=23253 | speaker=unknown"
msgid "  I ignored him and put my overnight bag down on the floor."
msgstr "　芳助の軽口を無視して、着替えの入ったボストンバッグを床に置く。"

#. Occurrence WIK_ROBBY:868:23254: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_ROBBY_0007; voice_prefix=B10; voice_category=5; scene=WIK_ROBBY
#: WIK_ROBBY:868
msgctxt "text_id=23254 | speaker=kojika"
msgid "\"Don't look inside.\""
msgstr "「中身、見ないでよね」"

#. Occurrence WIK_ROBBY:879:23255: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_ROBBY_0005; voice_prefix=B50; voice_category=6; scene=WIK_ROBBY
#: WIK_ROBBY:879
msgctxt "text_id=23255 | speaker=kinomi"
msgid "\"I know, I know. I don't wanna see your boring grandma underwear anyway!"
msgstr "「頼まれたって見ないっショ。金鹿の色気のない着替えとかもうノーサンクス／ノーフューチャー／ノータックス。"

#. Occurrence WIK_ROBBY:892:23256: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_WIK_ROBBY_0006; voice_prefix=B50; voice_category=6; scene=WIK_ROBBY
#: WIK_ROBBY:892
msgctxt "text_id=23256 | speaker=kinomi"
msgid "  ...Oof, man, this is heavy! Your granny panties made from chain mail?\""
msgstr "　……や、にしても重いな。体に似合わず重装備じゃねえか、オイ」"

#. Occurrence WIK_ROBBY:926:23257: scene=WIK_ROBBY
#: WIK_ROBBY:926
msgctxt "text_id=23257 | speaker=unknown"
msgid "  Housuke picked up my bag and carried it toward the hallway to the east wing."
msgstr "　芳助はわたしの荷物を担いで、ロビーの東側の通路に向かおうとする。"

#. Occurrence WIK_ROBBY:931:23258: scene=WIK_ROBBY
#: WIK_ROBBY:931
msgctxt "text_id=23258 | speaker=unknown"
msgid "  Of course it was heavy. Couldn't come here without my trusty wok, cleaver, rice, and char siu. What if I wanted fried rice later?"
msgstr "　重いのは当然だ。万が一の時に備えて、中華鍋と中華包丁、米と金豚チャーシューが入っているんだから。"

#. Occurrence WIK_ROBBY:952:23259: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_ROBBY_0004; voice_prefix=A10; voice_category=1; scene=WIK_ROBBY
#: WIK_ROBBY:952
msgctxt "text_id=23259 | speaker=aoko"
msgid "\"The drawing room's over there. That's where the party's going to be."
msgstr "「あっちが居間よ。基本、パーティー会場はこっちだから。"

#. Occurrence WIK_ROBBY:958:23260: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_ROBBY_0005; voice_prefix=A10; voice_category=1; scene=WIK_ROBBY
#: WIK_ROBBY:958
msgctxt "text_id=23260 | speaker=aoko"
msgid "  Alice made up guest rooms for each of you, so if you're tired, head on up. You can change in there too, if you like.\""
msgstr "　それと、有珠の気遣いで客室も用意されているから、疲れたらそっちに移動して。着替えとかは客室で済ませちゃってね」"

#. Occurrence WIK_ROBBY:963:23261: scene=WIK_ROBBY
#: WIK_ROBBY:963
msgctxt "text_id=23261 | speaker=unknown"
msgid "  Hmm."
msgstr "　そうか。"

#. Occurrence WIK_ROBBY:968:23262: scene=WIK_ROBBY
#: WIK_ROBBY:968
msgctxt "text_id=23262 | speaker=unknown"
msgid "  In that case..."
msgstr "　それじゃあ、わたしは―――"

#. Occurrence WIK_SELECT_B:9:23263: scene=WIK_SELECT_B
#: WIK_SELECT_B:9
msgctxt "text_id=23263 | speaker=unknown"
msgid "-Decision B-"
msgstr "～選択肢Ｂ～"

#. Occurrence WIK_ROOM:111:23264: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_ROOM_0000; voice_prefix=A10; voice_category=1; scene=WIK_ROOM
#: WIK_ROOM:111
msgctxt "text_id=23264 | speaker=aoko"
msgid "\"Oh!\""
msgstr "「あら」"

#. Occurrence WIK_ROOM:116:23265: scene=WIK_ROOM
#: WIK_ROOM:116
msgctxt "text_id=23265 | speaker=unknown"
msgid "  Out in the hallway, I ran into Aozaki."
msgstr "　廊下に出ると、蒼崎と出くわした。"

#. Occurrence WIK_ROOM:121:23266: scene=WIK_ROOM
#: WIK_ROOM:121
msgctxt "text_id=23266 | speaker=unknown"
msgid "  She seemed to be on her way from the bedrooms to the hall."
msgstr "　彼女は廊下の奥から、ホールに向かっていたところらしい。"

#. Occurrence WIK_ROOM:142:23267: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_ROOM_0000; voice_prefix=B10; voice_category=5; scene=WIK_ROOM
#: WIK_ROOM:142
msgctxt "text_id=23267 | speaker=kojika"
msgid "\"You taking a break too, Aozaki? Is that your room at the end?\""
msgstr "「蒼崎も休憩？　あの突き当たりってアンタの部屋なの？」"

#. Occurrence WIK_ROOM:154:23268: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_ROOM_0001; voice_prefix=A10; voice_category=1; scene=WIK_ROOM
#: WIK_ROOM:154
msgctxt "text_id=23268 | speaker=aoko"
msgid "\"Um, y-yeah, but I'm not going in there."
msgstr "「え、そ、そうだけど、別に部屋には寄ってないわよ？"

#. Occurrence WIK_ROOM:166:23269: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_ROOM_0002; voice_prefix=A10; voice_category=1; scene=WIK_ROOM
#: WIK_ROOM:166
msgctxt "text_id=23269 | speaker=aoko"
msgid "  I'm just looking for something. Don't mind me.\""
msgstr "　私はちょっとした探し物の途中だから、気にしないで」"

#. Occurrence WIK_ROOM:178:23270: scene=WIK_ROOM
#: WIK_ROOM:178
msgctxt "text_id=23270 | speaker=unknown"
msgid "  Aozaki took the stairs down to the first floor."
msgstr "　蒼崎は一階に下りていった。"

#. Occurrence WIK_ROOM:229:23271: scene=WIK_ROOM
#: WIK_ROOM:229
msgctxt "text_id=23271 | speaker=unknown"
msgid "  I unlocked the door and entered my room."
msgstr "　鍵を開けて部屋に入る。"

#. Occurrence WIK_ROOM:234:23272: scene=WIK_ROOM
#: WIK_ROOM:234
msgctxt "text_id=23272 | speaker=unknown"
msgid "  Nobody was inside, and there was no sign of any items having been disturbed."
msgstr "　部屋には誰もおらず、荷物が荒らされた痕跡はない。"

#. Occurrence WIK_S_1:30:23273: scene=WIK_S_1
#: WIK_S_1:30
msgctxt "text_id=23273 | speaker=unknown"
msgid "  I think Touko Aozaki was the first victim."
msgstr "　わたしは、蒼崎橙子は一番はじめの犠牲者だ、と思った。"

#. Occurrence WIK_S_1:64:23274: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_S_1_0000; voice_prefix=B70; voice_category=4; scene=WIK_S_1
#: WIK_S_1:64
msgctxt "text_id=23274 | speaker=tobimaru"
msgid "\"Touko has to have been first, otherwise Aozaki wouldn't have acted so weird."
msgstr "「ああ、そう考えないと蒼崎の行動はおかしい。"

#. Occurrence WIK_S_1:76:23275: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_S_1_0001; voice_prefix=B70; voice_category=4; scene=WIK_S_1
#: WIK_S_1:76
msgctxt "text_id=23275 | speaker=tobimaru"
msgid "  Aozaki was out shopping all morning. Her big sister must have been killed sometime after she left, but before she brought you all here and went back into her room.\""
msgstr "　蒼崎は午前中は街で買い物をしていた。蒼崎姉はあいつが部屋を留守にしている間……久万梨たちを連れて一息ついて、部屋に戻るまでの間に殺されたと見るべきだろう」"

#. Occurrence WIK_S_1:99:23276: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_S_1_0000_0; voice_prefix=B10; voice_category=5; scene=WIK_S_1
#: WIK_S_1:99
msgctxt "text_id=23276 | speaker=kojika"
msgid "\"I passed Aozaki in the hallway on the second floor around 3:30."
msgstr "「１５時半頃、わたし、二階廊下で蒼崎とすれ違ったけど……"

#. Occurrence WIK_S_1:112:23277: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_S_1_0000_1; voice_prefix=B10; voice_category=5; scene=WIK_S_1
#: WIK_S_1:112
msgctxt "text_id=23277 | speaker=kojika"
msgid " Touko must've been drowning herself in oldies right around then.\""
msgstr "あの時、東館の奥、蒼崎の部屋は演歌地獄になってた訳ね」"

#. Occurrence WIK_S_2:36:23278: scene=WIK_S_2
#: WIK_S_2:36
msgctxt "text_id=23278 | speaker=unknown"
msgid "  I think Touko must've died sometime between 4:00PM and 6:00PM."
msgstr "　わたしは、蒼崎橙子が死亡したのは１６時から１８時の間なのかもしれない、と思った。"

#. Occurrence WIK_S_3:36:23279: scene=WIK_S_3
#: WIK_S_3:36
msgctxt "text_id=23279 | speaker=unknown"
msgid "  I think Touko must've died sometime between 6:00PM and 8:00PM."
msgstr "　わたしは、蒼崎橙子が死亡したのは１８時から２０時の間なのかもしれない、と思った。"

#. Occurrence WIK_S_4:36:23280: scene=WIK_S_4
#: WIK_S_4:36
msgctxt "text_id=23280 | speaker=unknown"
msgid "  I think Touko must've died sometime between 8:00PM and 10:00PM."
msgstr "　わたしは、蒼崎橙子が死亡したのは２０時から２２時の間なのかもしれない、と思った。"

#. Occurrence WIK_S_5:36:23281: scene=WIK_S_5
#: WIK_S_5:36
msgctxt "text_id=23281 | speaker=unknown"
msgid "  I think Touko must've died sometime between 10:00PM and midnight."
msgstr "　わたしは、蒼崎橙子が死亡したのは２２時から０時の間なのかもしれない、と思った。"

#. Occurrence WIK_S_A:41:23282: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_S_A_0000; voice_prefix=B70; voice_category=4; scene=WIK_S_A
#: WIK_S_A:41
msgctxt "text_id=23282 | speaker=tobimaru"
msgid "\"Well, until we can come up with any real conclusions, this is all just speculation."
msgstr "「ま、断定できない以上、<憶測|おくそく>は憶測でしかねえけどな。"

#. Occurrence WIK_S_A:52:23283: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_S_A_0001; voice_prefix=B70; voice_category=4; scene=WIK_S_A
#: WIK_S_A:52
msgctxt "text_id=23283 | speaker=tobimaru"
msgid "  I think the real problem isn't figuring out when the murder was committed, but how.\""
msgstr "　それよりだ、久万梨。ネックは<何時|いつ>殺したか、じゃなく、どうやって殺したか、だと思わねえか？」"

#. Occurrence WIK_S_A:84:23284: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_S_A_0002; voice_prefix=B70; voice_category=4; scene=WIK_S_A
#: WIK_S_A:84
msgctxt "text_id=23284 | speaker=tobimaru"
msgid "\"It takes a serious sense of humor to make someone like Mr. Yamasiro or Father Eiri to laugh out loud."
msgstr "「山城にしろ詠梨神父にしろ、あの鉄仮面たちを笑わせられるのはよっぽどのセンスだ。"

#. Occurrence WIK_S_A:95:23285: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_S_A_0003; voice_prefix=B70; voice_category=4; scene=WIK_S_A
#: WIK_S_A:95
msgctxt "text_id=23285 | speaker=tobimaru"
msgid "  Other factors like timeframe being equal, just having a sense of humor excludes some people right off the bat, like Soujyuro, Beo, and Kinomi.\""
msgstr "　殺害可能時間は平等にあっても、そのセンスだけは限られる。この点で言えば、まあ、草十郎やらベオやら木乃美やらは除外される」"

#. Occurrence WIK_S_A:128:23286: scene=WIK_S_A
#: WIK_S_A:128
msgctxt "text_id=23286 | speaker=unknown"
msgid "  Tsukiji had latched onto something big."
msgstr "　槻司はさも興味深そうに、今まで検討されてこなかった問題点を挙げた。"

#. Occurrence WIK_S_A:133:23287: scene=WIK_S_A
#: WIK_S_A:133
msgctxt "text_id=23287 | speaker=unknown"
msgid "  Why hadn't anyone else thought of that?"
msgstr "　たしかにそれは盲点だった。"

#. Occurrence WIK_S_A:138:23288: scene=WIK_S_A
#: WIK_S_A:138
msgctxt "text_id=23288 | speaker=unknown"
msgid "  Housuke's jokes only made people cringe; Beo didn't even understand the concept of humor."
msgstr "　笑いが滑るだけの芳助、まだジョークを理解していないベオには難易度が高すぎる。"

#. Occurrence WIK_S_A:143:23289: scene=WIK_S_A
#: WIK_S_A:143
msgctxt "text_id=23289 | speaker=unknown"
msgid "  As for Sizuki, I've met planks of wood that get jokes quicker."
msgstr "　静希に至っては『冗談のセンスがない』とみんなにダメだしされるほどのボケ体質だし。"

#. Occurrence WIK_S_A:209:23290: scene=WIK_S_A
#: WIK_S_A:209
msgctxt "text_id=23290 | speaker=unknown"
msgid "  Our discussion carried on until nearly 3:00 AM."
msgstr "　問題点を語りあっているうちに、時間は午前三時になろうとしていた。"

#. Occurrence WIK_S_A:235:23291: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_S_A_0000; voice_prefix=B10; voice_category=5; scene=WIK_S_A
#: WIK_S_A:235
msgctxt "text_id=23291 | speaker=kojika"
msgid "\"Huah...\""
msgstr "「ふあ……」"

#. Occurrence WIK_S_A:240:23292: scene=WIK_S_A
#: WIK_S_A:240
msgctxt "text_id=23292 | speaker=unknown"
msgid "  I yawned. I was by no means relaxed, just exhausted."
msgstr "　気が緩んだ訳ではないけど、さすがに眠気が襲ってくる。"

#. Occurrence WIK_S_A:245:23293: scene=WIK_S_A
#: WIK_S_A:245
msgctxt "text_id=23293 | speaker=unknown"
msgid "  After everything that's happened, I'd be surprised if anyone had any real energy left."
msgstr "　こんな一日を経験したら、誰だってそろそろエネルギー切れだ。"

#. Occurrence WIK_S_A:276:23294: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_S_A_0004; voice_prefix=B70; voice_category=4; scene=WIK_S_A
#: WIK_S_A:276
msgctxt "text_id=23294 | speaker=tobimaru"
msgid "\"It's late. We should probably get some sleep. Are you gonna rest? I can crash on the sofa just to be safe.\""
msgstr "「夜更かししすぎたな。そろそろ眠り時だが、どうする？　念には念だ、オレもそこのソファーで眠るってのもアリだが」"

#. Occurrence WIK_S_A:319:23295: scene=WIK_S_A
#: WIK_S_A:319
msgctxt "text_id=23295 | speaker=unknown"
msgid "  He was clearly on guard for Sweets Hearts disguised as Aozaki, or someone else."
msgstr "　蒼崎に化けたスイーツハーツ、あるいは他の人物Ａに化けたスイーツハーツの侵入を警戒しての意見だろう。"

#. Occurrence WIK_S_A:325:23296: scene=WIK_S_A
#: WIK_S_A:325
msgctxt "text_id=23296 | speaker=unknown"
msgid "  I yawned again."
msgstr "　わた、わたしは、"

#. Occurrence WIK_SELECT_T:8:23297: scene=WIK_SELECT_T
#: WIK_SELECT_T:8
msgctxt "text_id=23297 | speaker=unknown"
msgid "-Decision T-"
msgstr "～選択肢Ｔ～"

#. Occurrence WIK_T_1:40:23298: scene=WIK_T_1
#: WIK_T_1:40
msgctxt "text_id=23298 | speaker=unknown"
msgid "  It should be safe as long as the door is locked, but we still had other things to worry about."
msgstr "　鍵をかければ安全だし、それは色々まずい、と思った。"

#. Occurrence WIK_T_1:75:23299: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_1_0000; voice_prefix=B10; voice_category=5; scene=WIK_T_1
#: WIK_T_1:75
msgctxt "text_id=23299 | speaker=kojika"
msgid "\"We've made it this far. Only a little longer to go."
msgstr "「いい。ここまできたらあと少しだし。"

#. Occurrence WIK_T_1:81:23300: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_1_0001; voice_prefix=B10; voice_category=5; scene=WIK_T_1
#: WIK_T_1:81
msgctxt "text_id=23300 | speaker=kojika"
msgid "  Y'know, Tsukiji, you're the one who said not to trust anybody.\""
msgstr "　だいたい、全員を疑えって言ったの、槻司じゃん」"

#. Occurrence WIK_T_1:92:23301: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_T_1_0000; voice_prefix=B70; voice_category=4; scene=WIK_T_1
#: WIK_T_1:92
msgctxt "text_id=23301 | speaker=tobimaru"
msgid "\"Oh, yeah. I'm a suspect, too."
msgstr "「そうだったな。俺も容疑者の一人だった。"

#. Occurrence WIK_T_1:103:23302: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_T_1_0001; voice_prefix=B70; voice_category=4; scene=WIK_T_1
#: WIK_T_1:103
msgctxt "text_id=23302 | speaker=tobimaru"
msgid "  Guess I didn't need to worry about you, huh?\""
msgstr "　さすが久万梨、余計な心配だったぜ」"

#. Occurrence WIK_T_1:127:23303: scene=WIK_T_1
#: WIK_T_1:127
msgctxt "text_id=23303 | speaker=unknown"
msgid "  Tsukiji turned to the door, ready to leave."
msgstr "　それじゃあな、と槻司はドアに向かう。"

#. Occurrence WIK_T_1:132:23304: scene=WIK_T_1
#: WIK_T_1:132
msgctxt "text_id=23304 | speaker=unknown"
msgid "  I tried to say something."
msgstr "　わたしは何か言おうとして、"

#. Occurrence WIK_T_1:170:23305: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_1_0002; voice_prefix=B10; voice_category=5; scene=WIK_T_1
#: WIK_T_1:170
msgctxt "text_id=23305 | speaker=kojika"
msgid "\"Th-This doesn't have anything to do with anything, but..."
msgstr "「か、関係ないけど。"

#. Occurrence WIK_T_1:182:23306: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_1_0003; voice_prefix=B10; voice_category=5; scene=WIK_T_1
#: WIK_T_1:182
msgctxt "text_id=23306 | speaker=kojika"
msgid "  ...even though it's been, y'know, a rough day, you seem―I dunno―content.\""
msgstr "　ひどい一日だったのに、槻司はなんか、満足そうね」"

#. Occurrence WIK_T_1:187:23307: scene=WIK_T_1
#: WIK_T_1:187
msgctxt "text_id=23307 | speaker=unknown"
msgid "  What the hell was I saying?"
msgstr "　なんだそれ。"

#. Occurrence WIK_T_1:192:23308: scene=WIK_T_1
#: WIK_T_1:192
msgctxt "text_id=23308 | speaker=unknown"
msgid "  I was just embarrassing myself."
msgstr "　我がコトながら、とことん可愛げのない女。"

#. Occurrence WIK_T_1:230:23309: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_T_1_0002; voice_prefix=B70; voice_category=4; scene=WIK_T_1
#: WIK_T_1:230
msgctxt "text_id=23309 | speaker=tobimaru"
msgid "\"People died and I almost joined them. 'Rough day' is putting it lightly.\""
msgstr "「何人も死んで、自分も殺されかけた一日、か。確かにひでぇ一日だった」"

#. Occurrence WIK_T_1:235:23310: scene=WIK_T_1
#: WIK_T_1:235
msgctxt "text_id=23310 | speaker=unknown"
msgid "  Luckily, he took my question seriously."
msgstr "　でも槻司は真面目に考えてくれて、"

#. Occurrence WIK_T_1:247:23311: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_T_1_0003; voice_prefix=B70; voice_category=4; scene=WIK_T_1
#: WIK_T_1:247
msgctxt "text_id=23311 | speaker=tobimaru"
msgid "\"But, I guess, in a way... it's been kind of fun."
msgstr "「けどまあ、なんだかんだと楽しかったからな。"

#. Occurrence WIK_T_1:259:23312: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_T_1_0004; voice_prefix=B70; voice_category=4; scene=WIK_T_1
#: WIK_T_1:259
msgctxt "text_id=23312 | speaker=tobimaru"
msgid "  You feel the same, don't you, Kumari?\""
msgstr "　久万梨もそうじゃなかったのか？」"

#. Occurrence WIK_T_1:265:23313: scene=WIK_T_1
#: WIK_T_1:265
msgctxt "text_id=23313 | speaker=unknown"
msgid "  His considerate reply was so reassuring, I almost forgot my anxiety."
msgstr "　わたしの不安を笑い飛ばすように、お気楽な言葉を返した。"

#. Occurrence WIK_T_1:303:23314: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_1_0004; voice_prefix=B10; voice_category=5; scene=WIK_T_1
#: WIK_T_1:303
msgctxt "text_id=23314 | speaker=kojika"
msgid "\"That's a surprise. I thought you looked down on this sort of thing.\""
msgstr "「意外。槻司はこういうの、鼻で笑うかと思った」"

#. Occurrence WIK_T_1:323:23315: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_T_1_0005; voice_prefix=B70; voice_category=4; scene=WIK_T_1
#: WIK_T_1:323
msgctxt "text_id=23315 | speaker=tobimaru"
msgid "\"Well, you were wrong, then. I love this kind of chaos. I don't want to take life too seriously.\""
msgstr "「そりゃ見込み違いだったな。こういうバカ騒ぎ好きなんだよ、俺。ふざけた人生を送りたいんでな」"

#. Occurrence WIK_T_1:334:23316: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_1_0005; voice_prefix=B10; voice_category=5; scene=WIK_T_1
#: WIK_T_1:334
msgctxt "text_id=23316 | speaker=kojika"
msgid "\"For real? Well, you just blew my mind.\""
msgstr "「なにそれ。げーん、めーつ」"

#. Occurrence WIK_T_1:367:23317: scene=WIK_T_1
#: WIK_T_1:367
msgctxt "text_id=23317 | speaker=unknown"
msgid "  I was being serious. It reminded of the time I first realized that I'd fallen for him."
msgstr "　本気で言いつつ、わたしはコイツを好きだと気付いた原因、はじめのとっかかりを思い出した。"

#. Occurrence WIK_T_1:372:23318: scene=WIK_T_1
#: WIK_T_1:372
msgctxt "text_id=23318 | speaker=unknown"
msgid "  Tsukiji was an amazing person."
msgstr "　槻司は本当に、すごい人なのだ。"

#. Occurrence WIK_T_1:377:23319: scene=WIK_T_1
#: WIK_T_1:377
msgctxt "text_id=23319 | speaker=unknown"
msgid "  But he was squandering his potential."
msgstr "　なのにその能力を無駄にしている。"

#. Occurrence WIK_T_1:382:23320: scene=WIK_T_1
#: WIK_T_1:382
msgctxt "text_id=23320 | speaker=unknown"
msgid "  He didn't want glory or to move up in the world."
msgstr "　彼にはどうしてか名誉欲というか、上昇志向がないのだ。"

#. Occurrence WIK_T_1:402:23321: scene=WIK_T_1
#: WIK_T_1:402
msgctxt "text_id=23321 | speaker=unknown"
msgid "  It felt like such a waste of human capital."
msgstr "　まさに人的資源の無駄遣い。"

#. Occurrence WIK_T_1:407:23322: scene=WIK_T_1
#: WIK_T_1:407
msgctxt "text_id=23322 | speaker=unknown"
msgid "  I could never do that. How long had I been watching him, wanting to kick his butt into gear?"
msgstr "　わたしはそういうのが我慢できない性格で、とにかくコイツを、相応しい場に蹴り出したくて、いつのまにか日々観察していたんだっけ。"

#. Occurrence WIK_T_1:443:23323: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_1_0006; voice_prefix=B10; voice_category=5; scene=WIK_T_1
#: WIK_T_1:443
msgctxt "text_id=23323 | speaker=kojika"
msgid "\"Look, I know this probably isn't the time..."
msgstr "「……こっちも今さらだけど。"

#. Occurrence WIK_T_1:449:23324: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_1_0007; voice_prefix=B10; voice_category=5; scene=WIK_T_1
#: WIK_T_1:449
msgctxt "text_id=23324 | speaker=kojika"
msgid "  ...but you're not exactly a people-person sometimes, and yet you talk to me. Why is that?\""
msgstr "　槻司、わりと人付き合い悪いじゃない。なのにどうして、わたしとは普通に話すの？」"

#. Occurrence WIK_T_1:473:23325: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_T_1_0006_0; voice_prefix=B70; voice_category=4; scene=WIK_T_1
#: WIK_T_1:473
msgctxt "text_id=23325 | speaker=tobimaru"
msgid "\"Hm?"
msgstr "「ん？"

#. Occurrence WIK_T_1:487:23326: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_T_1_0006_1; voice_prefix=B70; voice_category=4; scene=WIK_T_1
#: WIK_T_1:487
msgctxt "text_id=23326 | speaker=tobimaru"
msgid " You've worked your ass off for six years, without relying once on your parents, teachers, or anyone else.\""
msgstr "　そりゃあおまえさん、親にも教師にも頼らず、六年間ひとりで戦ってきたヤツには敬意を<表|ひょう>すだろ？」"

#. Occurrence WIK_T_1:522:23327: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_1_0008; voice_prefix=B10; voice_category=5; scene=WIK_T_1
#: WIK_T_1:522
msgctxt "text_id=23327 | speaker=kojika"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence WIK_T_1:533:23328: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_T_1_0007; voice_prefix=B70; voice_category=4; scene=WIK_T_1
#: WIK_T_1:533
msgctxt "text_id=23328 | speaker=tobimaru"
msgid "\"Anyway, I'll catch you in the morning down in the foyer.\""
msgstr "「じゃあな。朝になったらロビーで会おうぜ」"

#. Occurrence WIK_T_1:574:23329: scene=WIK_T_1
#: WIK_T_1:574
msgctxt "text_id=23329 | speaker=unknown"
msgid "  And with that, the room went quiet again."
msgstr "　そうして、部屋はとたんに静かになった。"

#. Occurrence WIK_T_1:579:23330: scene=WIK_T_1
#: WIK_T_1:579
msgctxt "text_id=23330 | speaker=unknown"
msgid "  For some reason, I felt a tight squeezing sensation in my chest."
msgstr "　わたしはなんでか、胸がいっぱいになりながら、"

#. Occurrence WIK_T_1:585:23331: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_T_1_0008; voice_prefix=B70; voice_category=4; scene=WIK_T_1
#: WIK_T_1:585
msgctxt "text_id=23331 | speaker=tobimaru"
msgid "\"In a way... it's been kind of fun.\""
msgstr "“なんだかんだと―――”"

#. Occurrence WIK_T_1:591:23332: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_T_1_0009; voice_prefix=B70; voice_category=4; scene=WIK_T_1
#: WIK_T_1:591
msgctxt "text_id=23332 | speaker=tobimaru"
msgid "\"You feel the same, don't you, Kumari?\""
msgstr "“久万梨もそうじゃなかったのか？”"

#. Occurrence WIK_T_1:596:23333: scene=WIK_T_1
#: WIK_T_1:596
msgctxt "text_id=23333 | speaker=unknown"
msgid "  Tsukiji's words replayed themselves over and over in my head."
msgstr "　さっきの槻司の言葉を思い返す。"

#. Occurrence WIK_T_1:639:23334: scene=WIK_T_1
#: WIK_T_1:639
msgctxt "text_id=23334 | speaker=unknown"
msgid "  ...Yeah. He was right."
msgstr "　……うん、そっか。"

#. Occurrence WIK_T_1:644:23335: scene=WIK_T_1
#: WIK_T_1:644
msgctxt "text_id=23335 | speaker=unknown"
msgid "  Maybe it had been fun."
msgstr "　わたしも、やっぱり楽しかったんだ。"

#. Occurrence WIK_T_1:760:23336: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_1_0009; voice_prefix=B10; voice_category=5; scene=WIK_T_1
#: WIK_T_1:760
msgctxt "text_id=23336 | speaker=kojika"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence WIK_T_1:767:23337: scene=WIK_T_1
#: WIK_T_1:767
msgctxt "text_id=23337 | speaker=unknown"
msgid "  I woke up to the sound of birds chirping."
msgstr "　小鳥の鳴き声で目を覚ました。"

#. Occurrence WIK_T_1:773:23338: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_1_0010; voice_prefix=B10; voice_category=5; scene=WIK_T_1
#: WIK_T_1:773
msgctxt "text_id=23338 | speaker=kojika"
msgid "\"Ungh... It's morning...\""
msgstr "「朝……朝に、なってる……」"

#. Occurrence WIK_T_1:778:23339: scene=WIK_T_1
#: WIK_T_1:778
msgctxt "text_id=23339 | speaker=unknown"
msgid "  The clock read half past five."
msgstr "　時刻は五時半。"

#. Occurrence WIK_T_1:783:23340: scene=WIK_T_1
#: WIK_T_1:783
msgctxt "text_id=23340 | speaker=unknown"
msgid "  The sun was beginning to peek over the horizon."
msgstr "　外はうっすらと日が差し始めている。"

#. Occurrence WIK_T_1:804:23341: scene=WIK_T_1
#: WIK_T_1:804
msgctxt "text_id=23341 | speaker=unknown"
msgid "  My ability to rise early was one of my few strong points, so I must've been really exhausted."
msgstr "　目覚めがいいのがわたしの数少ない取り柄なのに、疲れがたまっていたんだろう。"

#. Occurrence WIK_T_1:809:23342: scene=WIK_T_1
#: WIK_T_1:809
msgctxt "text_id=23342 | speaker=unknown"
msgid "  I foggily examined my wrinkled clothes in the mirror."
msgstr "　ぼんやりとした頭のまま、姿見で洋服のシワを確認する。"

#. Occurrence WIK_T_1:829:23343: scene=WIK_T_1
#: WIK_T_1:829
msgctxt "text_id=23343 | speaker=unknown"
msgid "  My body was still asleep."
msgstr "　まだ全身に血が巡っていない。"

#. Occurrence WIK_T_1:838:23344: scene=WIK_T_1
#: WIK_T_1:838
msgctxt "text_id=23344 | speaker=unknown"
msgid "  I was too tired to even make tea, so I just grabbed my wallet and card case off the table."
msgstr "　お茶を淹れるのも億劫で、わたしはノソノソとテーブルに置いたお財布とパスケースを手に取る。"

#. Occurrence WIK_T_1:843:23345: scene=WIK_T_1
#: WIK_T_1:843
msgctxt "text_id=23345 | speaker=unknown"
msgid "  The case contained my commuter pass and some pictures I took each year."
msgstr "　パスケースには定期と、記念写真が入っている。"

#. Occurrence WIK_T_1:864:23346: scene=WIK_T_1
#: WIK_T_1:864
msgctxt "text_id=23346 | speaker=unknown"
msgid "  I had a rare shot of Aozaki making a fool of herself at this year's school festival."
msgstr "　今年の学園祭で、蒼崎が失態をかましたレアな一枚だ。"

#. Occurrence WIK_T_1:884:23347: scene=WIK_T_1
#: WIK_T_1:884
msgctxt "text_id=23347 | speaker=unknown"
msgid "  She either drank champagne thinking it was a soft drink,"
msgstr "　ジュースと間違えてシャンパンを飲んだのか、"

#. Occurrence WIK_T_1:889:23348: scene=WIK_T_1
#: WIK_T_1:889
msgctxt "text_id=23348 | speaker=unknown"
msgid "  or someone slipped alcohol in the juice cocktail."
msgstr "　誰かがモンブランの隠し味であるアルコール量を間違えたのか。"

#. Occurrence WIK_T_1:894:23349: scene=WIK_T_1
#: WIK_T_1:894
msgctxt "text_id=23349 | speaker=unknown"
msgid "  Next thing I knew, she was all hyper, yelling about wearing someone else's clothes."
msgstr "　とにかく、目を離した隙に蒼崎はとんでもない上機嫌になっていて、“私もあの服きるー！”と暴れてしまった。"

#. Occurrence WIK_T_1:937:23350: scene=WIK_T_1
#: WIK_T_1:937
msgctxt "text_id=23350 | speaker=unknown"
msgid "  I got a great shot of her with my disposable camera."
msgstr "　この一枚はその名場面を使い捨てカメラで撮ったものだ。"

#. Occurrence WIK_T_1:942:23351: scene=WIK_T_1
#: WIK_T_1:942
msgctxt "text_id=23351 | speaker=unknown"
msgid "  I loved that photo so much I carried it with me in my card case everywhere I go."
msgstr "　あまりにも面白いので、こうしてパスケースに収めている。"

#. Occurrence WIK_T_1:947:23352: scene=WIK_T_1
#: WIK_T_1:947
msgctxt "text_id=23352 | speaker=unknown"
msgid "  Whenever I felt down, it always cheered me up to look at it and remember how adorable Aozaki could be. It was a side of herself that nobody who knew her would ever expect."
msgstr "　気分が沈みがちになった時、この愛らしく、普段の蒼崎を知っている人間からするとあり得ない写真を見ると励まされるのである。"

#. Occurrence WIK_T_1:952:23353: scene=WIK_T_1
#: WIK_T_1:952
msgctxt "text_id=23353 | speaker=unknown"
msgid "  Especially her comedic side."
msgstr "　おもに笑い方面で。"

#. Occurrence WIK_T_1:987:23354: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_1_0011; voice_prefix=B10; voice_category=5; scene=WIK_T_1
#: WIK_T_1:987
msgctxt "text_id=23354 | speaker=kojika"
msgid "\"...Huh?\""
msgstr "「―――あれ？」"

#. Occurrence WIK_T_1:992:23355: scene=WIK_T_1
#: WIK_T_1:992
msgctxt "text_id=23355 | speaker=unknown"
msgid "  Wait a second."
msgstr "　なにか、いま。"

#. Occurrence WIK_T_1:997:23356: scene=WIK_T_1
#: WIK_T_1:997
msgctxt "text_id=23356 | speaker=unknown"
msgid "  Did I just think something I really shouldn't have, that would be incredibly bad to bring up now?"
msgstr "　ものすごく、いまになって言わないでほしい、レベルの事を提示しなかった、わたし？"

#. Occurrence WIK_T_1:1018:23357: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_1_0012; voice_prefix=B10; voice_category=5; scene=WIK_T_1
#: WIK_T_1:1018
msgctxt "text_id=23357 | speaker=kojika"
msgid "\"Oh, right... where is everyone?\""
msgstr "「そうだ―――みんなは？」"

#. Occurrence WIK_T_1:1025:23358: scene=WIK_T_1
#: WIK_T_1:1025
msgctxt "text_id=23358 | speaker=unknown"
msgid "  I rifled through my overnight bag to see if anything might be of use."
msgstr "　わたしはボストンバッグをあさり、万が一の時に役に立つものはないか、と物色する。"

#. Occurrence WIK_T_1:1030:23359: scene=WIK_T_1
#: WIK_T_1:1030
msgctxt "text_id=23359 | speaker=unknown"
msgid "  Turns out, the stuff I brought to cook with was worth bringing."
msgstr "　<炒飯|チャーハン>を作ろうと持ってきた荷物が役に立った。"

#. Occurrence WIK_T_1:1061:23360: scene=WIK_T_1
#: WIK_T_1:1061
msgctxt "text_id=23360 | speaker=unknown"
msgid "  I hovered over the wok or the cleaver, ultimately deciding to take the wok with me."
msgstr "　愛用の中華鍋と中華包丁、どちらにするか迷ったけど、ここは鍋を選んだ。"

#. Occurrence WIK_T_1:1111:23361: scene=WIK_T_1
#: WIK_T_1:1111
msgctxt "text_id=23361 | speaker=unknown"
msgid "  I went out into the hallway."
msgstr "　廊下に出る。"

#. Occurrence WIK_T_1:1116:23362: scene=WIK_T_1
#: WIK_T_1:1116
msgctxt "text_id=23362 | speaker=unknown"
msgid "  The air was slightly cooler than inside the guest room."
msgstr "　客室よりふたまわり冷たい空気。"

#. Occurrence WIK_T_1:1121:23363: scene=WIK_T_1
#: WIK_T_1:1121
msgctxt "text_id=23363 | speaker=unknown"
msgid "  Silence had fallen over the mansion once again."
msgstr "　洋館は静まり返っていた。"

#. Occurrence WIK_T_1:1126:23364: scene=WIK_T_1
#: WIK_T_1:1126
msgctxt "text_id=23364 | speaker=unknown"
msgid "  There was no sound, no sign of life."
msgstr "　何の音も、何の気配もない。"

#. Occurrence WIK_T_1:1131:23365: scene=WIK_T_1
#: WIK_T_1:1131
msgctxt "text_id=23365 | speaker=unknown"
msgid "  It was like the storm never happened."
msgstr "　昨夜の嵐が嘘のようだ。"

#. Occurrence WIK_T_1:1178:23366: scene=WIK_T_1
#: WIK_T_1:1178
msgctxt "text_id=23366 | speaker=unknown"
msgid "  Tsukiji's room was empty."
msgstr "　槻司の客室には誰もいなかった。"

#. Occurrence WIK_T_1:1183:23367: scene=WIK_T_1
#: WIK_T_1:1183
msgctxt "text_id=23367 | speaker=unknown"
msgid "  Sizuki wasn't in Father Eiri's room."
msgstr "　詠梨神父用の客室に静希の姿はなかった。"

#. Occurrence WIK_T_1:1188:23368: scene=WIK_T_1
#: WIK_T_1:1188
msgctxt "text_id=23368 | speaker=unknown"
msgid "  Nobody was in Ritsuka's room, either."
msgstr "　律架さんの客室には誰もいなかった。"

#. Occurrence WIK_T_1:1196:23369: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_1_0013; voice_prefix=B10; voice_category=5; scene=WIK_T_1
#: WIK_T_1:1196
msgctxt "text_id=23369 | speaker=kojika"
msgid "\"Miss Kuonji!\""
msgstr "「久遠寺さーん」"

#. Occurrence WIK_T_1:1202:23370: scene=WIK_T_1
#: WIK_T_1:1202
msgctxt "text_id=23370 | speaker=unknown"
msgid "  I called out into the void of the west wing, but got no response."
msgstr "　西館に呼びかけても返事はない。"

#. Occurrence WIK_T_1:1208:23371: scene=WIK_T_1
#: WIK_T_1:1208
msgctxt "text_id=23371 | speaker=unknown"
msgid "  I was alone."
msgstr "　誰も　いない。"

#. Occurrence WIK_T_1:1257:23372: scene=WIK_T_1
#: WIK_T_1:1257
msgctxt "text_id=23372 | speaker=unknown"
msgid "  I headed down to the basement where Aozaki was confined,"
msgstr "　蒼崎を閉じこめた地下室に向かう。"

#. Occurrence WIK_T_1:1262:23373: scene=WIK_T_1
#: WIK_T_1:1262
msgctxt "text_id=23373 | speaker=unknown"
msgid "  down a narrow staircase to a door."
msgstr "　狭い階段を下りて、扉につきあたる。"

#. Occurrence WIK_T_1:1267:23374: scene=WIK_T_1
#: WIK_T_1:1267
msgctxt "text_id=23374 | speaker=unknown"
msgid "  The padlock had been broken clean off from the outside."
msgstr "　南京錠は外側から外されていた。"

#. Occurrence WIK_T_1:1282:23375: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_1_0014; voice_prefix=B10; voice_category=5; scene=WIK_T_1
#: WIK_T_1:1282
msgctxt "text_id=23375 | speaker=kojika"
msgid "\"...Aozaki?\""
msgstr "「―――蒼崎？」"

#. Occurrence WIK_T_1:1287:23376: scene=WIK_T_1
#: WIK_T_1:1287
msgctxt "text_id=23376 | speaker=unknown"
msgid "  I braced myself for whatever was to come, and opened the door."
msgstr "　わたしはある種の覚悟をして、扉を開ける。"

#. Occurrence WIK_T_1:1383:23377: scene=WIK_T_1
#: WIK_T_1:1383
msgctxt "text_id=23377 | speaker=unknown"
msgid "  Inside the tiny cellar, I saw ...a dead body, lying face down."
msgstr "　狭い地下室には、うつぶせで倒れた死体がひとつ。"

#. Occurrence WIK_T_1:1388:23378: scene=WIK_T_1
#: WIK_T_1:1388
msgctxt "text_id=23378 | speaker=unknown"
msgid "  The beautiful, long hair was all I needed to see to know it was Aozaki."
msgstr "　彩度の高い、どこか日本人離れした長髪は、間違いなく蒼崎のものだ。"

#. Occurrence WIK_T_1:1393:23379: scene=WIK_T_1
#: WIK_T_1:1393
msgctxt "text_id=23379 | speaker=unknown"
msgid "  She wasn't breathing."
msgstr "　呼吸は完全に止まっている。"

#. Occurrence WIK_T_1:1398:23380: scene=WIK_T_1
#: WIK_T_1:1398
msgctxt "text_id=23380 | speaker=unknown"
msgid "  She'd scrawled something with her left hand in her last moments."
msgstr "　彼女は倒れたまま、左手で床に文字を残していた。"

#. Occurrence WIK_T_1:1403:23381: scene=WIK_T_1
#: WIK_T_1:1403
msgctxt "text_id=23381 | speaker=unknown"
msgid "  It was dying message, written in blood."
msgstr "　血文字のダイイング・メッセージ。"

#. Occurrence WIK_T_1:1423:23382: scene=WIK_T_1
#: WIK_T_1:1423
msgctxt "text_id=23382 | speaker=unknown"
msgid "  I could feel the disdain in the words."
msgstr "　床には、怨念のこもった文字で、"

#. Occurrence WIK_T_1:1433:23383: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_T_1_0000; voice_prefix=A10; voice_category=1; scene=WIK_T_1
#: WIK_T_1:1433
msgctxt "text_id=23383 | speaker=aoko"
msgid "\"Told you so.\""
msgstr "『やっぱりっていうな』"

#. Occurrence WIK_T_1:1456:23384: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_1_0015; voice_prefix=B10; voice_category=5; scene=WIK_T_1
#: WIK_T_1:1456
msgctxt "text_id=23384 | speaker=kojika"
msgid "\"You sure did...\""
msgstr "「やっぱり……」"

#. Occurrence WIK_T_1:1462:23385: scene=WIK_T_1
#: WIK_T_1:1462
msgctxt "text_id=23385 | speaker=unknown"
msgid "  Aozaki wasn't the killer."
msgstr "　蒼崎は犯人ではなかったのだ。"

#. Occurrence WIK_T_1:1467:23386: scene=WIK_T_1
#: WIK_T_1:1467
msgctxt "text_id=23386 | speaker=unknown"
msgid "  It wasn't clear when she was murdered."
msgstr "　彼女が<何|い><時|つ>殺されたのかは定かではない。"

#. Occurrence WIK_T_1:1472:23387: scene=WIK_T_1
#: WIK_T_1:1472
msgctxt "text_id=23387 | speaker=unknown"
msgid "  But whoever the killer was broke the lock, made her laugh, nonchalantly went upstairs, and..."
msgstr "　けれど、鍵をあけ、蒼崎を笑わせた犯人は、なに食わぬ顔で地上に戻り、そして―――"

#. Occurrence WIK_T_1:1520:23388: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_1_0016; voice_prefix=B10; voice_category=5; scene=WIK_T_1
#: WIK_T_1:1520
msgctxt "text_id=23388 | speaker=kojika"
msgid "\"Hah, hah, hah!\""
msgstr "「はっ、はっ、は……！」"

#. Occurrence WIK_T_1:1526:23389: scene=WIK_T_1
#: WIK_T_1:1526
msgctxt "text_id=23389 | speaker=unknown"
msgid "  I tried to control my breathing and my racing mind."
msgstr "　千々に乱れる呼吸と思考を、必死に押さえつける。"

#. Occurrence WIK_T_1:1531:23390: scene=WIK_T_1
#: WIK_T_1:1531
msgctxt "text_id=23390 | speaker=unknown"
msgid "  Everyone was dead."
msgstr "　全員死んだ。"

#. Occurrence WIK_T_1:1536:23391: scene=WIK_T_1
#: WIK_T_1:1536
msgctxt "text_id=23391 | speaker=unknown"
msgid "  Everyone was dead."
msgstr "　全員死んだ。"

#. Occurrence WIK_T_1:1541:23392: scene=WIK_T_1
#: WIK_T_1:1541
msgctxt "text_id=23392 | speaker=unknown"
msgid "  Probably, only the killer and I were left."
msgstr "　おそらく、犯人とわたし以外は全員死んだ。"

#. Occurrence WIK_T_1:1571:23393: scene=WIK_T_1
#: WIK_T_1:1571
msgctxt "text_id=23393 | speaker=unknown"
msgid "  But the sun was already up."
msgstr "　夜は明けたのに？"

#. Occurrence WIK_T_1:1576:23394: scene=WIK_T_1
#: WIK_T_1:1576
msgctxt "text_id=23394 | speaker=unknown"
msgid "  Wait, not completely."
msgstr "　いや、まだ太陽は昇りきっていない。"

#. Occurrence WIK_T_1:1581:23395: scene=WIK_T_1
#: WIK_T_1:1581
msgctxt "text_id=23395 | speaker=unknown"
msgid "  If the rules said it ended in the morning, then the game wasn't over yet."
msgstr "　朝を迎えるのが条件なら、まだゲームは終わっていない。"

#. Occurrence WIK_T_1:1586:23396: scene=WIK_T_1
#: WIK_T_1:1586
msgctxt "text_id=23396 | speaker=unknown"
msgid "  I had to get out of here now and figure out who the killer is."
msgstr "　なら逃げるか、犯人を特定しなければ。"

#. Occurrence WIK_T_1:1591:23397: scene=WIK_T_1
#: WIK_T_1:1591
msgctxt "text_id=23397 | speaker=unknown"
msgid "  There was no winning this unless I did something."
msgstr "　このままだと『クリア』にならない。"

#. Occurrence WIK_T_1:1596:23398: scene=WIK_T_1
#: WIK_T_1:1596
msgctxt "text_id=23398 | speaker=unknown"
msgid "  Everyone was dead. No turning back now."
msgstr "　蒼崎たちは死んだまま、もう二度と戻らない。"

#. Occurrence WIK_T_1:1629:23399: scene=WIK_T_1
#: WIK_T_1:1629
msgctxt "text_id=23399 | speaker=unknown"
msgid "  I..."
msgstr "　わたしは、"

#. Occurrence WIK_SELECT_U:8:23400: scene=WIK_SELECT_U
#: WIK_SELECT_U:8
msgctxt "text_id=23400 | speaker=unknown"
msgid "-Decision U-"
msgstr "～選択肢Ｕ～"

#. Occurrence WIK_T_2:41:23401: scene=WIK_T_2
#: WIK_T_2:41
msgctxt "text_id=23401 | speaker=unknown"
msgid "  If that's how it has to be, then there's no helping it now."
msgstr "　そ、そういうコトなら、仕方がない、と思った。"

#. Occurrence WIK_T_2:82:23402: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_2_0000; voice_prefix=B10; voice_category=5; scene=WIK_T_2
#: WIK_T_2:82
msgctxt "text_id=23402 | speaker=kojika"
msgid "\"Y-Yeah, I guess it's the best option right now."
msgstr "「そ、そうよね、万が一の時、便利だし。"

#. Occurrence WIK_T_2:93:23403: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_2_0001; voice_prefix=B10; voice_category=5; scene=WIK_T_2
#: WIK_T_2:93
msgctxt "text_id=23403 | speaker=kojika"
msgid "  I-I mean I have lots of brothers, so I'm used to sleeping in the same room as boys. It's fine. Completely fine.\""
msgstr "　わたしはほら、兄貴が売るほどいるから、男子と一緒の部屋とか、たぶんなれてる、し」"

#. Occurrence WIK_T_2:104:23404: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_T_2_0000; voice_prefix=B70; voice_category=4; scene=WIK_T_2
#: WIK_T_2:104
msgctxt "text_id=23404 | speaker=tobimaru"
msgid "\"Perfect. I'll take the sofa then."
msgstr "「そりゃ頼もしい。んじゃ、ソファーを借りるぜ。"

#. Occurrence WIK_T_2:115:23405: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_WIK_T_2_0001; voice_prefix=B70; voice_category=4; scene=WIK_T_2
#: WIK_T_2:115
msgctxt "text_id=23405 | speaker=tobimaru"
msgid "  I'm pretty exhausted myself. Hopefully, I can get some rest if I know you're nearby.\""
msgstr "　いいかげん、俺も気を張り続けて疲れた。久万梨がいるなら、ちっとは安心して眠れる」"

#. Occurrence WIK_T_2:151:23406: scene=WIK_T_2
#: WIK_T_2:151
msgctxt "text_id=23406 | speaker=unknown"
msgid "  Tsukiji quickly fell asleep after raising his hand to wave goodnight."
msgstr "　じゃあな、と片手をあげて、槻司はあっさりと眠ってしまった。"

#. Occurrence WIK_T_2:156:23407: scene=WIK_T_2
#: WIK_T_2:156
msgctxt "text_id=23407 | speaker=unknown"
msgid "  I looked at him all wrapped up in a blanket..."
msgstr "　毛布にくるまって、ソファーにごろん、である。"

#. Occurrence WIK_T_2:182:23408: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_2_0002; voice_prefix=B10; voice_category=5; scene=WIK_T_2
#: WIK_T_2:182
msgctxt "text_id=23408 | speaker=kojika"
msgid "\"Oh, come on.\""
msgstr "「なにそれ」"

#. Occurrence WIK_T_2:188:23409: scene=WIK_T_2
#: WIK_T_2:188
msgctxt "text_id=23409 | speaker=unknown"
msgid "  Seeing him fall asleep so quickly helped me to feel relaxed too."
msgstr "　あまりの簡素さに、わたしもすっかり落ち着いてしまった。"

#. Occurrence WIK_T_2:193:23410: scene=WIK_T_2
#: WIK_T_2:193
msgctxt "text_id=23410 | speaker=unknown"
msgid "  ...I definitely didn't want to get excited in a situation like this. Plus, I was beat."
msgstr "　……まあ、この状況でドキドキするのもどうかと思うし。わたしだって疲れているし。"

#. Occurrence WIK_T_2:226:23411: scene=WIK_T_2
#: WIK_T_2:226
msgctxt "text_id=23411 | speaker=unknown"
msgid "  I didn't have any pajamas, and didn't feel like changing anyway."
msgstr "　寝間着はないし、そもそも着替える気もないし。"

#. Occurrence WIK_T_2:235:23412: scene=WIK_T_2
#: WIK_T_2:235
msgctxt "text_id=23412 | speaker=unknown"
msgid "  For comfort, I did remove my wallet and card case from my pockets and place them on a table, before sliding under a blanket fully-clothed."
msgstr "　わたしは洋服のまま、せめてポケットにしまっていたパスケースやら財布やらをテーブルにおいて身軽になって、ベッドに潜りこむ。"

#. Occurrence WIK_T_2:284:23413: scene=WIK_T_2
#: WIK_T_2:284
msgctxt "text_id=23413 | speaker=unknown"
msgid "  I couldn't fall asleep as fast as Tsukiji, but I could feel myself drifting off already."
msgstr "　槻司じゃないけど、目をつむったとたん、意識は闇に落ちていった。"

#. Occurrence WIK_T_2:289:23414: scene=WIK_T_2
#: WIK_T_2:289
msgctxt "text_id=23414 | speaker=unknown"
msgid "  Into a deep, deep sleep..."
msgstr "　……深い深い眠り。"

#. Occurrence WIK_T_2:294:23415: scene=WIK_T_2
#: WIK_T_2:294
msgctxt "text_id=23415 | speaker=unknown"
msgid "  Did... I just hear... laughter... next to me...?"
msgstr "　どこか、すぐ近くで、誰かの笑い声を聞いた気がした。"

#. Occurrence WIK_T_2:407:23416: scene=WIK_T_2
#: WIK_T_2:407
msgctxt "text_id=23416 | speaker=unknown"
msgid "  I woke up to the sound of birds chirping."
msgstr "　小鳥の鳴き声で目を覚ました。"

#. Occurrence WIK_T_2:414:23417: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_2_0003; voice_prefix=B10; voice_category=5; scene=WIK_T_2
#: WIK_T_2:414
msgctxt "text_id=23417 | speaker=kojika"
msgid "\"Ungh... It's morning...\""
msgstr "「朝……朝に、なってる……」"

#. Occurrence WIK_T_2:420:23418: scene=WIK_T_2
#: WIK_T_2:420
msgctxt "text_id=23418 | speaker=unknown"
msgid "  The clock read half past five."
msgstr "　時刻は五時半。"

#. Occurrence WIK_T_2:425:23419: scene=WIK_T_2
#: WIK_T_2:425
msgctxt "text_id=23419 | speaker=unknown"
msgid "  The sun was beginning to peek over the horizon."
msgstr "　外はうっすらと日が差し始めている。"

#. Occurrence WIK_T_2:447:23420: scene=WIK_T_2
#: WIK_T_2:447
msgctxt "text_id=23420 | speaker=unknown"
msgid "  My ability to rise early was one of my few strong points, so I must've been really exhausted."
msgstr "　目覚めがいいのがわたしの数少ない取り柄なのに、疲れがたまっていたんだろう。"

#. Occurrence WIK_T_2:452:23421: scene=WIK_T_2
#: WIK_T_2:452
msgctxt "text_id=23421 | speaker=unknown"
msgid "  I looked around the room, my vision blurry."
msgstr "　ぼんやりとした頭で部屋を見渡して、"

#. Occurrence WIK_T_2:461:23422: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_2_0004; voice_prefix=B10; voice_category=5; scene=WIK_T_2
#: WIK_T_2:461
msgctxt "text_id=23422 | speaker=kojika"
msgid "\"Oh! Tsukiji!\""
msgstr "「そうだ、槻司―――！」"

#. Occurrence WIK_T_2:467:23423: scene=WIK_T_2
#: WIK_T_2:467
msgctxt "text_id=23423 | speaker=unknown"
msgid "  I went to sleep in the same room as him."
msgstr "　わたしは槻司と一緒の部屋にいるコトを思い出して、"

#. Occurrence WIK_T_2:488:23424: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_2_0005; voice_prefix=B10; voice_category=5; scene=WIK_T_2
#: WIK_T_2:488
msgctxt "text_id=23424 | speaker=kojika"
msgid "\"Huh?\""
msgstr "「え？」"

#. Occurrence WIK_T_2:495:23425: scene=WIK_T_2
#: WIK_T_2:495
msgctxt "text_id=23425 | speaker=unknown"
msgid "  I finally realized that he wasn't where I'd last seen him."
msgstr "　そこにいる筈の人物が、いないコトにやっと気づいた。"

#. Occurrence WIK_T_2:515:23426: scene=WIK_T_2
#: WIK_T_2:515
msgctxt "text_id=23426 | speaker=unknown"
msgid "  There was nobody on the sofa."
msgstr "　ソファーには誰もいない。"

#. Occurrence WIK_T_2:520:23427: scene=WIK_T_2
#: WIK_T_2:520
msgctxt "text_id=23427 | speaker=unknown"
msgid "  Just his clothes."
msgstr "　あるのは槻司が着ていた洋服だけだ。"

#. Occurrence WIK_T_2:525:23428: scene=WIK_T_2
#: WIK_T_2:525
msgctxt "text_id=23428 | speaker=unknown"
msgid "  They were laid out neatly like they were on display."
msgstr "　洋服だけが、まるで標本のようにソファーに置かれている。"

#. Occurrence WIK_T_2:530:23429: scene=WIK_T_2
#: WIK_T_2:530
msgctxt "text_id=23429 | speaker=unknown"
msgid "  It was like he'd shrunk so small he'd disappeared, or melted away somewhere."
msgstr "　小さくなって消えてしまったとか、氷のように溶けてしまったとか、とにかく、そんな感じ。"

#. Occurrence WIK_T_2:535:23430: scene=WIK_T_2
#: WIK_T_2:535
msgctxt "text_id=23430 | speaker=unknown"
msgid "  Maybe he wanted to die by completely vanishing."
msgstr "　跡形もなく消える、というのが、アイツの望む“死に方”みたい。"

#. Occurrence WIK_T_2:556:23431: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_2_0006; voice_prefix=B10; voice_category=5; scene=WIK_T_2
#: WIK_T_2:556
msgctxt "text_id=23431 | speaker=kojika"
msgid "\"...Tsukiji?\""
msgstr "「……………槻司？」"

#. Occurrence WIK_T_2:563:23432: scene=WIK_T_2
#: WIK_T_2:563
msgctxt "text_id=23432 | speaker=unknown"
msgid "  I tried touching his clothes."
msgstr "　洋服に触れてみる。"

#. Occurrence WIK_T_2:568:23433: scene=WIK_T_2
#: WIK_T_2:568
msgctxt "text_id=23433 | speaker=unknown"
msgid "  I touched his blanket, and the sofa."
msgstr "　毛布とソファーに触れてみる。"

#. Occurrence WIK_T_2:573:23434: scene=WIK_T_2
#: WIK_T_2:573
msgctxt "text_id=23434 | speaker=unknown"
msgid "  His warmth had long since faded."
msgstr "　熱はとっくに冷め切っている。"

#. Occurrence WIK_T_2:578:23435: scene=WIK_T_2
#: WIK_T_2:578
msgctxt "text_id=23435 | speaker=unknown"
msgid "  My card case had fallen around where his hand might have been."
msgstr "　手があったと思われる位置には、わたしのパスケースが落ちている。"

#. Occurrence WIK_T_2:598:23436: scene=WIK_T_2
#: WIK_T_2:598
msgctxt "text_id=23436 | speaker=unknown"
msgid "  I could guess what happened."
msgstr "　わたしは漠然と、理解した。"

#. Occurrence WIK_T_2:603:23437: scene=WIK_T_2
#: WIK_T_2:603
msgctxt "text_id=23437 | speaker=unknown"
msgid "  He never really fell asleep."
msgstr "　槻司は眠ってなんかいなかった。"

#. Occurrence WIK_T_2:608:23438: scene=WIK_T_2
#: WIK_T_2:608
msgctxt "text_id=23438 | speaker=unknown"
msgid "  He pretended to, so I'd relax. Then he stayed up to watch over me all night."
msgstr "　眠ったフリをして、わたしを安心させて、寝ずの番をしていてくれたのだ。"

#. Occurrence WIK_T_2:628:23439: scene=WIK_T_2
#: WIK_T_2:628
msgctxt "text_id=23439 | speaker=unknown"
msgid "  This was a locked-room murder."
msgstr "　これは密室殺人だ。"

#. Occurrence WIK_T_2:633:23440: scene=WIK_T_2
#: WIK_T_2:633
msgctxt "text_id=23440 | speaker=unknown"
msgid "  It was clear what the murder weapon is, and I was finally close to figuring out who the killer was, too."
msgstr "　でも凶器はハッキリしているし、わたしもようやく、誰が犯人なのか理解できた。"

#. Occurrence WIK_T_2:653:23441: scene=WIK_T_2
#: WIK_T_2:653
msgctxt "text_id=23441 | speaker=unknown"
msgid "  I picked up my card case, and left the room feeling empty inside."
msgstr "　わたしはパスケースを拾い上げて、空虚な気持ちで部屋を後にする。"

#. Occurrence WIK_T_2:673:23442: scene=WIK_T_2
#: WIK_T_2:673
msgctxt "text_id=23442 | speaker=unknown"
msgid "  ...I'm so sorry, Tsukiji."
msgstr "　……ごめんね、槻司。"

#. Occurrence WIK_T_2:678:23443: scene=WIK_T_2
#: WIK_T_2:678
msgctxt "text_id=23443 | speaker=unknown"
msgid "  As Aozaki's friend, of course you'd laugh at that photo."
msgstr "　あんなもの見ちゃったら、そりゃあ、蒼崎好きのアンタは大笑いしちゃうよね。"

#. Occurrence WIK_T_2:721:23444: scene=WIK_T_2
#: WIK_T_2:721
msgctxt "text_id=23444 | speaker=unknown"
msgid "  It was quiet."
msgstr "　静かだ。"

#. Occurrence WIK_T_2:726:23445: scene=WIK_T_2
#: WIK_T_2:726
msgctxt "text_id=23445 | speaker=unknown"
msgid "  The air was crisp."
msgstr "　とても清潔な空気感。"

#. Occurrence WIK_T_2:731:23446: scene=WIK_T_2
#: WIK_T_2:731
msgctxt "text_id=23446 | speaker=unknown"
msgid "  My mind was so blank I almost laughed."
msgstr "　わたしの気持ちも、もう、笑ってしまうぐらい真っ白だ。"

#. Occurrence WIK_T_2:778:23447: scene=WIK_T_2
#: WIK_T_2:778
msgctxt "text_id=23447 | speaker=unknown"
msgid "  Tsukiji's room was clean and tidy."
msgstr "　槻司の客室も清潔。"

#. Occurrence WIK_T_2:783:23448: scene=WIK_T_2
#: WIK_T_2:783
msgctxt "text_id=23448 | speaker=unknown"
msgid "  Father Eiri's room was clean and tidy."
msgstr "　詠梨神父用の客室も清潔。"

#. Occurrence WIK_T_2:788:23449: scene=WIK_T_2
#: WIK_T_2:788
msgctxt "text_id=23449 | speaker=unknown"
msgid "  Ritsuka's room was clean and tidy."
msgstr "　律架さんの客室も清潔。"

#. Occurrence WIK_T_2:809:23450: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_2_0007; voice_prefix=B10; voice_category=5; scene=WIK_T_2
#: WIK_T_2:809
msgctxt "text_id=23450 | speaker=kojika"
msgid "\"Anyone alive out there?\""
msgstr "「誰か、生きている人、いますかー？」"

#. Occurrence WIK_T_2:815:23451: scene=WIK_T_2
#: WIK_T_2:815
msgctxt "text_id=23451 | speaker=unknown"
msgid "  I yelled into the void of the west wing, but no one responded."
msgstr "　西館に呼びかけても返事はない。"

#. Occurrence WIK_T_2:820:23452: scene=WIK_T_2
#: WIK_T_2:820
msgctxt "text_id=23452 | speaker=unknown"
msgid "  My hunch was spot on. Something was wrong."
msgstr "　ああ、やっぱり、予感の通り。"

#. Occurrence WIK_T_2:826:23453: scene=WIK_T_2
#: WIK_T_2:826
msgctxt "text_id=23453 | speaker=unknown"
msgid "  This mansion was now the cleanest, quietest place in all of Misaki. It was over."
msgstr "　いま、この屋敷は三咲町で一番、静かで綺麗で、終わっている。"

#. Occurrence WIK_T_2:875:23454: scene=WIK_T_2
#: WIK_T_2:875
msgctxt "text_id=23454 | speaker=unknown"
msgid "  I went down to the basement where Aozaki was confined,"
msgstr "　蒼崎を閉じこめた地下室に向かう。"

#. Occurrence WIK_T_2:880:23455: scene=WIK_T_2
#: WIK_T_2:880
msgctxt "text_id=23455 | speaker=unknown"
msgid "  down the narrow staircase to the door."
msgstr "　狭い階段を下りて、扉につきあたる。"

#. Occurrence WIK_T_2:894:23456: scene=WIK_T_2
#: WIK_T_2:894
msgctxt "text_id=23456 | speaker=unknown"
msgid "  The padlock had been broken clean off from the outside."
msgstr "　南京錠は外側から外されていた。"

#. Occurrence WIK_T_2:992:23457: scene=WIK_T_2
#: WIK_T_2:992
msgctxt "text_id=23457 | speaker=unknown"
msgid "  Inside the tiny cellar, I saw... a single dead body, lying prone."
msgstr "　狭い地下室には、うつぶせで倒れた死体が一つ。"

#. Occurrence WIK_T_2:997:23458: scene=WIK_T_2
#: WIK_T_2:997
msgctxt "text_id=23458 | speaker=unknown"
msgid "  The beautiful, long hair was all I needed to know who it was. Aozaki."
msgstr "　彩度の高い、どこか日本人離れした長髪は、間違いなく蒼崎のものだ。"

#. Occurrence WIK_T_2:1002:23459: scene=WIK_T_2
#: WIK_T_2:1002
msgctxt "text_id=23459 | speaker=unknown"
msgid "  She wasn't breathing."
msgstr "　完全に呼吸は止まっている。"

#. Occurrence WIK_T_2:1022:23460: scene=WIK_T_2
#: WIK_T_2:1022
msgctxt "text_id=23460 | speaker=unknown"
msgid "  She hadn't been the killer."
msgstr "　蒼崎は犯人ではなかった。"

#. Occurrence WIK_T_2:1027:23461: scene=WIK_T_2
#: WIK_T_2:1027
msgctxt "text_id=23461 | speaker=unknown"
msgid "  It was unclear what time she was murdered."
msgstr "　彼女が何時殺されたのかは定かではない。"

#. Occurrence WIK_T_2:1032:23462: scene=WIK_T_2
#: WIK_T_2:1032
msgctxt "text_id=23462 | speaker=unknown"
msgid "  But whoever the killer was broke the lock, made Aozaki laugh, nonchalantly went upstairs, and..."
msgstr "　けれど、鍵をあけ、蒼崎を笑わせた犯人は、なに食わぬ顔で地上に戻り、そして―――"

#. Occurrence WIK_T_2:1040:23463: scene=WIK_T_2
#: WIK_T_2:1040
msgctxt "text_id=23463 | speaker=unknown"
msgid "  ...cut off my means of escape. They were going to show up soon."
msgstr "　わたしの逃げ場を塞いで、目の前に現れようとしていた。"

#. Occurrence WIK_T_2:1060:23464: scene=WIK_T_2
#: WIK_T_2:1060
msgctxt "text_id=23464 | speaker=unknown"
msgid "  They must have been hiding somewhere waiting for me to come down into the basement."
msgstr "　ソレはわたしが地下室に入るまで、どこかに隠れていたのだろう。"

#. Occurrence WIK_T_2:1065:23465: scene=WIK_T_2
#: WIK_T_2:1065
msgctxt "text_id=23465 | speaker=unknown"
msgid "  The stairs were the only way out."
msgstr "　地下室の階段は一本道だ。"

#. Occurrence WIK_T_2:1070:23466: scene=WIK_T_2
#: WIK_T_2:1070
msgctxt "text_id=23466 | speaker=unknown"
msgid "  If the killer followed me down here, I was trapped."
msgstr "　わたしが下りた後、後ろから下りればわたしを袋小路に追い詰められる。"

#. Occurrence WIK_T_2:1104:23467: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_T_2_0008; voice_prefix=B10; voice_category=5; scene=WIK_T_2
#: WIK_T_2:1104
msgctxt "text_id=23467 | speaker=kojika"
msgid "\"...Oh, well. Doesn't matter anymore.\""
msgstr "「……まあ、もうどうでもいっか」"

#. Occurrence WIK_T_2:1110:23468: scene=WIK_T_2
#: WIK_T_2:1110
msgctxt "text_id=23468 | speaker=unknown"
msgid "  I was at a dead end."
msgstr "　この状況は、もう手詰まりだ。"

#. Occurrence WIK_T_2:1115:23469: scene=WIK_T_2
#: WIK_T_2:1115
msgctxt "text_id=23469 | speaker=unknown"
msgid "  Game over. Victory to the real killer."
msgstr "　ゲームは真犯人の勝ち。"

#. Occurrence WIK_T_2:1120:23470: scene=WIK_T_2
#: WIK_T_2:1120
msgctxt "text_id=23470 | speaker=unknown"
msgid "  My thoughts were interrupted by the sounds of footsteps. The footsteps of Death..."
msgstr "　わたしは何を間違えていたのかをぼんやりと考えながら、破滅の足音に耳をかたむけた―――"

#. Occurrence WIK_TITLEIN:65:23471: scene=WIK_TITLEIN
#: WIK_TITLEIN:65
msgctxt "text_id=23471 | speaker=unknown"
msgid "  Noon. Central Park."
msgstr "　午前十二時、中央公園。"

#. Occurrence WIK_TITLEIN:70:23472: scene=WIK_TITLEIN
#: WIK_TITLEIN:70
msgctxt "text_id=23472 | speaker=unknown"
msgid "  I finished making extra prints at the store, and threw away the disposable camera so I didn't have to carry it around."
msgstr "　わたしはコンビニで焼き増しを済ませ、手荷物になる使い捨てカメラをゴミ箱に投げ捨てた。"

#. Occurrence WIK_TITLEIN:112:23473: scene=WIK_TITLEIN
#: WIK_TITLEIN:112
msgctxt "text_id=23473 | speaker=unknown"
msgid "  It was a beautiful day out; the sky was clear, and the autumn air was crisp."
msgstr "　空はご覧の通り、天高く<馬肥|うまこ>ゆる秋。"

#. Occurrence WIK_TITLEIN:117:23474: scene=WIK_TITLEIN
#: WIK_TITLEIN:117
msgctxt "text_id=23474 | speaker=unknown"
msgid "  The troubles of the summer were gone, and it was a brand new day."
msgstr "　あの物騒な夏が過ぎ去った<晴天|サニーデイ>。"

#. Occurrence WIK_TITLEIN:139:23475: scene=WIK_TITLEIN
#: WIK_TITLEIN:139
msgctxt "text_id=23475 | speaker=unknown"
msgid "  I, Kojika Kumari, was about to spend my long weekend at the strangest of events."
msgstr "　わたしこと<久|く><万|ま><梨|り><金鹿|こじか>は、せっかくの連休をおかしなイベントで消費しようとしていた。"

#. Occurrence WIK_TITLEIN:194:23476: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_TITLEIN_0000; voice_prefix=A10; voice_category=1; scene=WIK_TITLEIN
#: WIK_TITLEIN:194
msgctxt "text_id=23476 | speaker=aoko"
msgid "\"Thanks for waiting!"
msgstr "「お待たせー！"

#. Occurrence WIK_TITLEIN:205:23477: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_TITLEIN_0001; voice_prefix=A10; voice_category=1; scene=WIK_TITLEIN
#: WIK_TITLEIN:205
msgctxt "text_id=23477 | speaker=aoko"
msgid "  Whoa, what's with all the stuff? Damn, that's a huge overnight bag.\""
msgstr "　あれ、クマったら大荷物。なんでそんな大きなボストンバッグなんて持ってきたの？」"

#. Occurrence WIK_TITLEIN:225:23478: scene=WIK_TITLEIN
#: WIK_TITLEIN:225
msgctxt "text_id=23478 | speaker=unknown"
msgid "  An hour had passed already, and it was 1:00 PM."
msgstr "　あれからちょっと時間が過ぎて、午後一時。"

#. Occurrence WIK_TITLEIN:230:23479: scene=WIK_TITLEIN
#: WIK_TITLEIN:230
msgctxt "text_id=23479 | speaker=unknown"
msgid "  Aoko Aozaki arrived at our meeting place."
msgstr "　待ち合わせ場所に<蒼崎|あおざき><青子|あおこ>がやってきた。"

#. Occurrence WIK_TITLEIN:235:23480: scene=WIK_TITLEIN
#: WIK_TITLEIN:235
msgctxt "text_id=23480 | speaker=unknown"
msgid "  Aozaki was my classmate, friend, and comrade on the student council."
msgstr "　彼女はわたし、久万梨金鹿の同期生であり友人であり、生徒会の戦友でもある。"

#. Occurrence WIK_TITLEIN:272:23481: scene=WIK_TITLEIN
#: WIK_TITLEIN:272
msgctxt "text_id=23481 | speaker=unknown"
msgid "  We'd only been friends since high school, but it oddly felt longer, like we'd always known each other."
msgstr "　蒼崎との付き合いは高校に入ってからだけど、不思議とそんな気はしない。十年来の付き合いのようだ。"

#. Occurrence WIK_TITLEIN:283:23482: scene=WIK_TITLEIN
#: WIK_TITLEIN:283
msgctxt "text_id=23482 | speaker=unknown"
msgid "  As you can see, she was as bright and lively as ever."
msgstr "　見ての通り、<明朗快活|めいろうかいかつ><即日払|そくじつばら>い。"

#. Occurrence WIK_TITLEIN:288:23483: scene=WIK_TITLEIN
#: WIK_TITLEIN:288
msgctxt "text_id=23483 | speaker=unknown"
msgid "  If she was a drink, she'd be a soft drink, a carbonated soda. She was the kind of person who solved a tough problem by hitting it until it surrendered."
msgstr "　飲みもので喩えるなら清涼飲料、でも炭酸系。押してもダメなら押し倒せ系の女、とわたしは思っている。"

#. Occurrence WIK_TITLEIN:323:23484: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_TITLEIN_0002; voice_prefix=A10; voice_category=1; scene=WIK_TITLEIN
#: WIK_TITLEIN:323
msgctxt "text_id=23484 | speaker=aoko"
msgid "\"Didn't I write on the invitation that I'd have everything for the party at the Kuonji house, so don't bring anything?\""
msgstr "「今日の<久遠寺|くおんじ>邸パーティーはこっちで色々用意してあるから、手ぶらでいいって招待状に書いてなかった？」"

#. Occurrence WIK_TITLEIN:341:23485: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_TITLEIN_0000; voice_prefix=B10; voice_category=5; scene=WIK_TITLEIN
#: WIK_TITLEIN:341
msgctxt "text_id=23485 | speaker=kojika"
msgid "\"I don't know what you're talking about."
msgstr "「なにそれ、聞いてない。"

#. Occurrence WIK_TITLEIN:353:23486: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_TITLEIN_0001; voice_prefix=B10; voice_category=5; scene=WIK_TITLEIN
#: WIK_TITLEIN:353
msgctxt "text_id=23486 | speaker=kojika"
msgid "  The invitation just said there's a birthday party, so come at the start of the long weekend, and bring your own food.\""
msgstr "　……まったく、間違いだらけね。誕生日を祝うから連休はじめに来てほしい、各自料理持参、としか書かれていなかったわ」"

#. Occurrence WIK_TITLEIN:379:23487: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_TITLEIN_0003; voice_prefix=A10; voice_category=1; scene=WIK_TITLEIN
#: WIK_TITLEIN:379
msgctxt "text_id=23487 | speaker=aoko"
msgid "\"Seriously? Sorry. Alice is new to this kind of thing. That's probably why you called this morning and wanted me to come meet you."
msgstr "「そうなの？　ごめんごめん、<有珠|ありす>ったらこういうの、まだ慣れていないから。朝イチで“やっぱり迎えに来て”って電話してきたのはそういうワケだったのね。"

#. Occurrence WIK_TITLEIN:402:23488: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_TITLEIN_0004_0; voice_prefix=A10; voice_category=1; scene=WIK_TITLEIN
#: WIK_TITLEIN:402
msgctxt "text_id=23488 | speaker=aoko"
msgid "  Anyway, moving on..."
msgstr "　まあ、それはそれとして。久万梨さん、"

#. Occurrence WIK_TITLEIN:426:23489: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_TITLEIN_0004_1; voice_prefix=A10; voice_category=1; scene=WIK_TITLEIN
#: WIK_TITLEIN:426
msgctxt "text_id=23489 | speaker=aoko"
msgid " Is that dull guy behind you with you? He looks kinda out of place.\""
msgstr "後ろのなんとも場違いに地味な方って、もしかしてお連れの方？」"

#. Occurrence WIK_TITLEIN:476:23490: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_TITLEIN_0000; voice_prefix=B60; voice_category=7; scene=WIK_TITLEIN
#: WIK_TITLEIN:476
msgctxt "text_id=23490 | speaker=yamashiro"
msgid "\"Oh, come on! I just got this suit yesterday. Don't I clean up pretty well?\""
msgstr "「あれ、いやだなあ。このスーツ、昨日下ろしたばっかりなんだけど、おめかしして見えないかい？」"

#. Occurrence WIK_TITLEIN:500:23491: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_TITLEIN_0005; voice_prefix=A10; voice_category=1; scene=WIK_TITLEIN
#: WIK_TITLEIN:500
msgctxt "text_id=23491 | speaker=aoko"
msgid "\"As always, you look about as plain as copy paper, Mr. Yamasiro."
msgstr "「コピーペーパーと見間違うほどいつも通りです、<山城|やましろ>先生。"

#. Occurrence WIK_TITLEIN:511:23492: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_TITLEIN_0006; voice_prefix=A10; voice_category=1; scene=WIK_TITLEIN
#: WIK_TITLEIN:511
msgctxt "text_id=23492 | speaker=aoko"
msgid "  So what're you doing here today?"
msgstr "　それで、今日はなんでしょう？"

#. Occurrence WIK_TITLEIN:511:23493: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_TITLEIN_0006; voice_prefix=A10; voice_category=1; scene=WIK_TITLEIN
#: WIK_TITLEIN:511
msgctxt "text_id=23493 | speaker=aoko"
msgid "  Following your students around? You know that'll be illegal one day, so I wouldn't get into a habit of doing it.\""
msgstr "　教え子を尾行するとか、あと数年したら立派な犯罪になりますから自重してほしいんですけど」"

#. Occurrence WIK_TITLEIN:531:23494: scene=WIK_TITLEIN
#: WIK_TITLEIN:531
msgctxt "text_id=23494 | speaker=unknown"
msgid "  Aozaki never pulled her punches, inside or outside of school."
msgstr "　蒼崎は学校の外でも容赦がない。"

#. Occurrence WIK_TITLEIN:536:23495: scene=WIK_TITLEIN
#: WIK_TITLEIN:536
msgctxt "text_id=23495 | speaker=unknown"
msgid "  She was particularly harsh to Mr. Yamasiro, almost like they were related."
msgstr "　特に山城先生への当たりは遠慮がなさすぎて、もう兄妹なんじゃないかって思うぐらい。"

#. Occurrence WIK_TITLEIN:573:23496: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_TITLEIN_0001_0; voice_prefix=B60; voice_category=7; scene=WIK_TITLEIN
#: WIK_TITLEIN:573
msgctxt "text_id=23496 | speaker=yamashiro"
msgid "\"Oh, you mean stalking?"
msgstr "「お、ストーキングってヤツだね。"

#. Occurrence WIK_TITLEIN:585:23497: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_TITLEIN_0001_1; voice_prefix=B60; voice_category=7; scene=WIK_TITLEIN
#: WIK_TITLEIN:585
msgctxt "text_id=23497 | speaker=yamashiro"
msgid " I think you're probably the expert on that, Aozaki. That's just my personal impression of you, though."
msgstr "そういうのは蒼崎くんの方が得意だと思うんだが。ああいや、あくまで個人的な感想だから聞き流して。"

#. Occurrence WIK_TITLEIN:596:23498: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_TITLEIN_0002; voice_prefix=B60; voice_category=7; scene=WIK_TITLEIN
#: WIK_TITLEIN:596
msgctxt "text_id=23498 | speaker=yamashiro"
msgid "  Don't look at me like that. Anyway, here..."
msgstr "　ほら、怖い顔しないでこれを見て見て。"

#. Occurrence WIK_TITLEIN:605:23499: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_TITLEIN_0003; voice_prefix=B60; voice_category=7; scene=WIK_TITLEIN
#: WIK_TITLEIN:605
msgctxt "text_id=23499 | speaker=yamashiro"
msgid "  I received an invitation this morning, so I'm participating as an advisor to the student council. I have a responsibility to chaperone you, don't I?\""
msgstr "　今朝、僕のところにも招待状が送られていてね。見れば生徒会の役員が参加とある。生徒会顧問として、君たちの監督をしないといけないだろう？」"

#. Occurrence WIK_TITLEIN:644:23500: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_TITLEIN_0002; voice_prefix=B10; voice_category=5; scene=WIK_TITLEIN
#: WIK_TITLEIN:644
msgctxt "text_id=23500 | speaker=kojika"
msgid "\"...\""
msgstr "「―――――」"

#. Occurrence WIK_TITLEIN:649:23501: scene=WIK_TITLEIN
#: WIK_TITLEIN:649
msgctxt "text_id=23501 | speaker=unknown"
msgid "  The invitation Mr. Yamasiro pulled out was the same as the one I got."
msgstr "　山城先生の差しだした招待状は、わたしに送られたものと同じものだ。"

#. Occurrence WIK_TITLEIN:654:23502: scene=WIK_TITLEIN
#: WIK_TITLEIN:654
msgctxt "text_id=23502 | speaker=unknown"
msgid "  Aozaki looked surprised, to say the least."
msgstr "　聞いていなかったのか、蒼崎は心底から驚いている。"

#. Occurrence WIK_TITLEIN:659:23503: scene=WIK_TITLEIN
#: WIK_TITLEIN:659
msgctxt "text_id=23503 | speaker=unknown"
msgid "  That was no act."
msgstr "　そこに演技の香りはしない。"

#. Occurrence WIK_TITLEIN:686:23504: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_TITLEIN_0007; voice_prefix=A10; voice_category=1; scene=WIK_TITLEIN
#: WIK_TITLEIN:686
msgctxt "text_id=23504 | speaker=aoko"
msgid "\"Ugh. That's Soujyuro's handwriting... I should've known better than to ask him for help...\""
msgstr "「くっ、その字は<草十郎|そうじゅうろう>か……あいつがヘンに律儀な事、気をつけておくべきだった……」"

#. Occurrence WIK_TITLEIN:711:23505: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_TITLEIN_0004; voice_prefix=B60; voice_category=7; scene=WIK_TITLEIN
#: WIK_TITLEIN:711
msgctxt "text_id=23505 | speaker=yamashiro"
msgid "\"Hahaha! I thought it very considerate of him!"
msgstr "「ははは、素晴らしい気遣いじゃないか！"

#. Occurrence WIK_TITLEIN:717:23506: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_TITLEIN_0005; voice_prefix=B60; voice_category=7; scene=WIK_TITLEIN
#: WIK_TITLEIN:717
msgctxt "text_id=23506 | speaker=yamashiro"
msgid "  Why, Aozaki, I imagine Sizuki could really go places, given the right opportunities."
msgstr "　僕はね、蒼崎くん。<静希|しずき>くんはいつかたぶん、おそらく機会さえあれば<や|・><る|・>生徒だと思っていたんだ。"

#. Occurrence WIK_TITLEIN:723:23507: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_TITLEIN_0006; voice_prefix=B60; voice_category=7; scene=WIK_TITLEIN
#: WIK_TITLEIN:723
msgctxt "text_id=23507 | speaker=yamashiro"
msgid "  And look at what else he wrote."
msgstr "　それが、こんな楽しそうなイベントに"

#. Occurrence WIK_TITLEIN:723:23508: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_TITLEIN_0006; voice_prefix=B60; voice_category=7; scene=WIK_TITLEIN
#: WIK_TITLEIN:723
msgctxt "text_id=23508 | speaker=yamashiro"
msgid "'Please watch over the party, because who knows what Aozaki might do.'"
msgstr "“蒼崎が何するか不安なのでカントクしに来てください”"

#. Occurrence WIK_TITLEIN:729:23509: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_TITLEIN_0007; voice_prefix=B60; voice_category=7; scene=WIK_TITLEIN
#: WIK_TITLEIN:729
msgctxt "text_id=23509 | speaker=yamashiro"
msgid "  He's even preparing for emergencies! Fine management skills, if you ask me.\""
msgstr "　なんて書かれた招待状を送ってくるなんて、成長の度合い<著|いちじる>しい。驚くべき危機管理能力だ」"

#. Occurrence WIK_TITLEIN:755:23510: scene=WIK_TITLEIN
#: WIK_TITLEIN:755
msgctxt "text_id=23510 | speaker=unknown"
msgid "  Aozaki let out a defeated sigh."
msgstr "　観念したのか、蒼崎は力なくため息をついた。"

#. Occurrence WIK_TITLEIN:760:23511: scene=WIK_TITLEIN
#: WIK_TITLEIN:760
msgctxt "text_id=23511 | speaker=unknown"
msgid "  She couldn't turn away Mr. Yamasiro, since he'd been formally invited."
msgstr "　招待されている以上、山城先生を追い返す訳にもいかないのだろう。"

#. Occurrence WIK_TITLEIN:765:23512: scene=WIK_TITLEIN
#: WIK_TITLEIN:765
msgctxt "text_id=23512 | speaker=unknown"
msgid "  However cold-hearted she appeared, she did have a sense of etiquette."
msgstr "　どんなに邪険にしていても、道理が通っているのなら無視はできない彼女である。"

#. Occurrence WIK_TITLEIN:802:23513: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_TITLEIN_0008; voice_prefix=A10; voice_category=1; scene=WIK_TITLEIN
#: WIK_TITLEIN:802
msgctxt "text_id=23513 | speaker=aoko"
msgid "\"Okay, okay. Follow me, I guess."
msgstr "「仕方ない、コブつきだけど案内するわ。"

#. Occurrence WIK_TITLEIN:813:23514: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_TITLEIN_0009; voice_prefix=A10; voice_category=1; scene=WIK_TITLEIN
#: WIK_TITLEIN:813
msgctxt "text_id=23514 | speaker=aoko"
msgid "  Is this the first time you've both visited the Kuonji Estate?\""
msgstr "　ふたりとも、久遠寺邸は初めて？」"

#. Occurrence WIK_TITLEIN:829:23515: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_TITLEIN_0008; voice_prefix=B60; voice_category=7; scene=WIK_TITLEIN
#: WIK_TITLEIN:829
msgctxt "text_id=23515 | speaker=yamashiro"
msgid "\"It is. People around here don't usually go near Shiroinuzuka. Take what happened this past summer, for instance.\""
msgstr "「初めてです。地元の住人なら、白犬塚にはあまり近寄りませんからねぇ。今年の夏だって、ほら」"

#. Occurrence WIK_TITLEIN:840:23516: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_TITLEIN_0003; voice_prefix=B10; voice_category=5; scene=WIK_TITLEIN
#: WIK_TITLEIN:840
msgctxt "text_id=23516 | speaker=kojika"
msgid "\"I've been this way a few times."
msgstr "「わたしはそうでもないけど。"

#. Occurrence WIK_TITLEIN:851:23517: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_TITLEIN_0004; voice_prefix=B10; voice_category=5; scene=WIK_TITLEIN
#: WIK_TITLEIN:851
msgctxt "text_id=23517 | speaker=kojika"
msgid "  This mountain's like sacred ground for all the kids around here.\""
msgstr "　そもそもこの山、このあたりの子供にしたらちょっとした聖地なんだし」"

#. Occurrence WIK_TITLEIN:891:23518: scene=WIK_TITLEIN
#: WIK_TITLEIN:891
msgctxt "text_id=23518 | speaker=unknown"
msgid "  Maybe \"sacred ground\" was an exaggeration, but I couldn't think of a better way to describe it."
msgstr "　聖地というのは言い過ぎだが、他に適切な表現がない。"

#. Occurrence WIK_TITLEIN:896:23519: scene=WIK_TITLEIN
#: WIK_TITLEIN:896
msgctxt "text_id=23519 | speaker=unknown"
msgid "  For years, there had been urban legends circulating about the hills there."
msgstr "　昔からこの丘には怪談がついてまわる。"

#. Occurrence WIK_TITLEIN:901:23520: scene=WIK_TITLEIN
#: WIK_TITLEIN:901
msgctxt "text_id=23520 | speaker=unknown"
msgid "  Like the \"Demon Dog of the Slope.\""
msgstr "　神隠しの化け犬坂。"

#. Occurrence WIK_TITLEIN:906:23521: scene=WIK_TITLEIN
#: WIK_TITLEIN:906
msgctxt "text_id=23521 | speaker=unknown"
msgid "  Or the one where, if you went into the woods on a foggy day, you'd come out either as someone different or with strange powers."
msgstr "　霧の深い日に踏み入ったら別人になって帰ってくるとか、逆に不思議な力を授かるとか。"

#. Occurrence WIK_TITLEIN:926:23522: scene=WIK_TITLEIN
#: WIK_TITLEIN:926
msgctxt "text_id=23522 | speaker=unknown"
msgid "  Those stories were probably the reason kids came here: to test their courage."
msgstr "　そんなうわさ話のせいか、たまに勇気ある小学生たちが肝試しとして山に挑んでいるのだ。"

#. Occurrence WIK_TITLEIN:931:23523: scene=WIK_TITLEIN
#: WIK_TITLEIN:931
msgctxt "text_id=23523 | speaker=unknown"
msgid "  In elementary school, if you went into the woods and touched the mailbox of the haunted house, you were officially awesome right up until graduation."
msgstr "　森に入り、お化け屋敷のポストに触れてきた小学生は、以後、卒業まで一目置かれるコトになる。"

#. Occurrence WIK_TITLEIN:936:23524: scene=WIK_TITLEIN
#: WIK_TITLEIN:936
msgctxt "text_id=23524 | speaker=unknown"
msgid "  I guess that's why sacred ground seemed to fit the area."
msgstr "　これを聖地と言わずなんと言おう。"

#. Occurrence WIK_TITLEIN:970:23525: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_TITLEIN_0009; voice_prefix=B60; voice_category=7; scene=WIK_TITLEIN
#: WIK_TITLEIN:970
msgctxt "text_id=23525 | speaker=yamashiro"
msgid "\"You walked all this way to and from school for over two years, Aozaki? You must be very athletic.\""
msgstr "「なるほど。蒼崎くんは二年半、この道を通学路に使っていたんだね。そりゃあ足も鍛えられるってもんだ」"

#. Occurrence WIK_TITLEIN:989:23526: scene=WIK_TITLEIN
#: WIK_TITLEIN:989
msgctxt "text_id=23526 | speaker=unknown"
msgid "  Mr. Yamasiro gazed down at the city excitedly; maybe it was the first time he'd seen it from this angle."
msgstr "　物珍しいのか、山城先生は楽しそうに眼下の街並みを眺めている。"

#. Occurrence WIK_TITLEIN:994:23527: scene=WIK_TITLEIN
#: WIK_TITLEIN:994
msgctxt "text_id=23527 | speaker=unknown"
msgid "  I'd like to feel that excited, too, but I couldn't relax, given the situation."
msgstr "　わたしも同じ気持ちになりたいところではあるが、立場上、そこまでお気楽な気持ちにはなれない。"

#. Occurrence WIK_TITLEIN:999:23528: scene=WIK_TITLEIN
#: WIK_TITLEIN:999
msgctxt "text_id=23528 | speaker=unknown"
msgid "  Because-"
msgstr "　なぜなら、"

#. Occurrence WIK_TITLEIN:1024:23529: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_TITLEIN_0010; voice_prefix=B60; voice_category=7; scene=WIK_TITLEIN
#: WIK_TITLEIN:1024
msgctxt "text_id=23529 | speaker=yamashiro"
msgid "\"How's your exam studying going, Aozaki?"
msgstr "「蒼崎くん、受験勉強ははかどってる？"

#. Occurrence WIK_TITLEIN:1030:23530: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_TITLEIN_0011; voice_prefix=B60; voice_category=7; scene=WIK_TITLEIN
#: WIK_TITLEIN:1030
msgctxt "text_id=23530 | speaker=yamashiro"
msgid "  I'm sure you've got it under control, so there's probably no need to worry about you.\""
msgstr "　ま、君はきっちり自己管理できる子だから心配するまでもないんだけどね」"

#. Occurrence WIK_TITLEIN:1048:23531: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_TITLEIN_0010; voice_prefix=A10; voice_category=1; scene=WIK_TITLEIN
#: WIK_TITLEIN:1048
msgctxt "text_id=23531 | speaker=aoko"
msgid "\"Of course, I have it under control."
msgstr "「言われなくてもきっちりやってます。"

#. Occurrence WIK_TITLEIN:1054:23532: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_TITLEIN_0011; voice_prefix=A10; voice_category=1; scene=WIK_TITLEIN
#: WIK_TITLEIN:1054
msgctxt "text_id=23532 | speaker=aoko"
msgid "  I wouldn't dare cause any trouble for you, Mr. Yamasiro.\""
msgstr "　山城先生のお手は煩わせません」"

#. Occurrence WIK_TITLEIN:1080:23533: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_TITLEIN_0012; voice_prefix=B60; voice_category=7; scene=WIK_TITLEIN
#: WIK_TITLEIN:1080
msgctxt "text_id=23533 | speaker=yamashiro"
msgid "\"Glad to hear it. You always turn down my advice, after all. Are you really that against attending a local university?\""
msgstr "「ならいいけど。蒼崎くん、推薦けっちゃうんだもんなあ。そんなに地元の大学はいやかい？」"

#. Occurrence WIK_TITLEIN:1108:23534: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_TITLEIN_0012; voice_prefix=A10; voice_category=1; scene=WIK_TITLEIN
#: WIK_TITLEIN:1108
msgctxt "text_id=23534 | speaker=aoko"
msgid "\"Not particularly. I just want to keep my options open. If anyone needs advice, it's Kumari.\""
msgstr "「いや、という訳ではありません。選択肢を狭めたくなかっただけです。私は結構ですから、助言なら久万梨さんにしてあげてください」"

#. Occurrence WIK_TITLEIN:1134:23535: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_TITLEIN_0013; voice_prefix=B60; voice_category=7; scene=WIK_TITLEIN
#: WIK_TITLEIN:1134
msgctxt "text_id=23535 | speaker=yamashiro"
msgid "\"Not at all. She's doing just fine. She's taken my recommendation for Mizora. She and her parents have already decided she'll be attending there.\""
msgstr "「いや、久万梨くんは鉄板でしょ？　もう<渠裸|ミゾラ>の推薦とっているんですから。ご両親も久万梨くん自身も、渠裸への進学を決めているワケですし」"

#. Occurrence WIK_TITLEIN:1163:23536: voice_id=X40_WIK_TITLEIN_0000; voice_prefix=X40; voice_category=0; scene=WIK_TITLEIN
#: WIK_TITLEIN:1163
msgctxt "text_id=23536 | speaker=unknown"
msgid "\"Ah.\""
msgstr "「あ」"

#. Occurrence WIK_TITLEIN:1204:23537: scene=WIK_TITLEIN
#: WIK_TITLEIN:1204
msgctxt "text_id=23537 | speaker=unknown"
msgid "  I silently tried to tell Aozaki to ignore the topic."
msgstr "　口を滑らせた蒼崎に、わたしは無言で“このままスルーしろ”と合図を送る。"

#. Occurrence WIK_TITLEIN:1225:23538: scene=WIK_TITLEIN
#: WIK_TITLEIN:1225
msgctxt "text_id=23538 | speaker=unknown"
msgid "  Let me take a moment here to talk about my history and what was happening today."
msgstr "　さて、ここでわたしの経歴と、今日これからの事情を説明しよう。"

#. Occurrence WIK_TITLEIN:1259:23539: scene=WIK_TITLEIN
#: WIK_TITLEIN:1259
msgctxt "text_id=23539 | speaker=unknown"
msgid "  My name is Kojika Kumari; I'm a third-year senior in high school."
msgstr "　わたし、久万梨金鹿は高校三年生。"

#. Occurrence WIK_TITLEIN:1264:23540: scene=WIK_TITLEIN
#: WIK_TITLEIN:1264
msgctxt "text_id=23540 | speaker=unknown"
msgid "  You know what students are like, struggling through exams without any hopes or dreams..."
msgstr "　来年の二月までは夢も希望もない受験生である。"

#. Occurrence WIK_TITLEIN:1269:23541: scene=WIK_TITLEIN
#: WIK_TITLEIN:1269
msgctxt "text_id=23541 | speaker=unknown"
msgid "  Well, I'm not a typical student. I want to attend a college in the city."
msgstr "　……と言いつつ、それは都心の大学を志望した子たちの話であって、わたしには関係ない。"

#. Occurrence WIK_TITLEIN:1275:23542: scene=WIK_TITLEIN
#: WIK_TITLEIN:1275
msgctxt "text_id=23542 | speaker=unknown"
msgid "  I'm planning to attend a local university. Given my current academic performance, that should be a piece of cake."
msgstr "　わたしは地元の大学に推薦をとっており、今の学力なら労せずして進学できるからだ。"

#. Occurrence WIK_TITLEIN:1319:23543: scene=WIK_TITLEIN
#: WIK_TITLEIN:1319
msgctxt "text_id=23543 | speaker=unknown"
msgid "  My parents insist I get a job; they don't want me attending college at all."
msgstr "　もともとわたしの両親はガッチガチの就職派で、地元の大学への進学すら否定的だった。"

#. Occurrence WIK_TITLEIN:1341:23544: voice_id=D30_WIK_TITLEIN_0000; voice_prefix=D30; voice_category=0; scene=WIK_TITLEIN
#: WIK_TITLEIN:1341
msgctxt "text_id=23544 | speaker=unknown"
msgid "\"You're going to help out with the family business. Why go to college?\""
msgstr "『おまえはうちの家業を手伝うんだから、大学に行く必要はない』"

#. Occurrence WIK_TITLEIN:1374:23545: scene=WIK_TITLEIN
#: WIK_TITLEIN:1374
msgctxt "text_id=23545 | speaker=unknown"
msgid "  That's my old-fashioned father for you―as big and as hard-headed as a bear."
msgstr "　頭が固くて、体が大きくて、山奥の熊みたいな<父親|オヤジ>の弁である。"

#. Occurrence WIK_TITLEIN:1379:23546: scene=WIK_TITLEIN
#: WIK_TITLEIN:1379
msgctxt "text_id=23546 | speaker=unknown"
msgid "  Luckily, my older brothers managed to convince him to let me go despite his archaic ways."
msgstr "　そんな時代錯誤で野蛮な父を、兄たちがこぞって説得してくれた。"

#. Occurrence WIK_TITLEIN:1429:23547: voice_id=E80_WIK_TITLEIN_0000; voice_prefix=E80; voice_category=0; scene=WIK_TITLEIN
#: WIK_TITLEIN:1429
msgctxt "text_id=23547 | speaker=unknown"
msgid "\"Mad Daddy, Kojika needs to experience college life, and do gymnastics there. Don't you want to see her on the pommel horse?\""
msgstr "『マッドダディ、金鹿にはまだ学生生活が必要だ。とくに体操競技とか。あん馬をやらずして何が青春か』"

#. Occurrence WIK_TITLEIN:1461:23548: voice_id=E90_WIK_TITLEIN_0000; voice_prefix=E90; voice_category=0; scene=WIK_TITLEIN
#: WIK_TITLEIN:1461
msgctxt "text_id=23548 | speaker=unknown"
msgid "\"Hahaha, that's why you're the oldest, brother. I think the rings are more her thing! She's too weak for horses.\""
msgstr "『ははは、だからおまえは長男なのだ。つり輪こそ至宝。あん馬とか軟弱すぎて話にならん』"

#. Occurrence WIK_TITLEIN:1493:23549: voice_id=F10_WIK_TITLEIN_0000; voice_prefix=F10; voice_category=0; scene=WIK_TITLEIN
#: WIK_TITLEIN:1493
msgctxt "text_id=23549 | speaker=unknown"
msgid "\"You kidding, my double bros? The horizontal bar is where it's at! Once you get a taste of those vertical flips, you'll never go back!\""
msgstr "『バッカじゃねえのダブル兄貴、カッチョイイのは鉄棒でしょやっぱ。縦回転のグルーブ感とか脳内麻薬ドッパドパ。ありゃハマッたら社会復帰とか難しいから』"

#. Occurrence WIK_TITLEIN:1543:23550: voice_id=F20_WIK_TITLEIN_0000; voice_prefix=F20; voice_category=0; scene=WIK_TITLEIN
#: WIK_TITLEIN:1543
msgctxt "text_id=23550 | speaker=unknown"
msgid "\"Yeah, and she's a hit with the guys. We can use that! I bet those dumbasses at the skating club will beg us to convince her to join their team!\""
msgstr "『そして自慢したい。うちの妹、三咲で一番可愛いって自慢したい。クソいけすかねえスケート部の奴らとか、間違いなく俺たちに土下座するよね。妹さんをスケート部にくださいって！』"

#. Occurrence WIK_TITLEIN:1677:23551: scene=WIK_TITLEIN
#: WIK_TITLEIN:1677
msgctxt "text_id=23551 | speaker=unknown"
msgid "  Honestly, my brothers are idiots."
msgstr "　正直、うんざりする兄貴どもである。"

#. Occurrence WIK_TITLEIN:1682:23552: scene=WIK_TITLEIN
#: WIK_TITLEIN:1682
msgctxt "text_id=23552 | speaker=unknown"
msgid "  Those gymnastics events were male-only, for goodness' sake."
msgstr "　あと、彼らが口にした体操競技はぜんぶ男性限定だから。"

#. Occurrence WIK_TITLEIN:1713:23553: voice_id=D30_WIK_TITLEIN_0001; voice_prefix=D30; voice_category=0; scene=WIK_TITLEIN
#: WIK_TITLEIN:1713
msgctxt "text_id=23553 | speaker=unknown"
msgid "\"B"
msgstr "『な"

msgctxt "text_id=23554 | speaker=unknown"
msgid "U"
msgstr "ん"

msgctxt "text_id=23555 | speaker=unknown"
msgid "N"
msgstr "と"

msgctxt "text_id=23556 | speaker=unknown"
msgid "C"
msgstr "い"

msgctxt "text_id=23557 | speaker=unknown"
msgid "H"
msgstr "う"

msgctxt "text_id=23558 | speaker=unknown"
msgid "O"
msgstr "む"

msgctxt "text_id=23559 | speaker=unknown"
msgid "F"
msgstr "く"

msgctxt "text_id=23560 | speaker=unknown"
msgid "C"
msgstr "つ"

msgctxt "text_id=23561 | speaker=unknown"
msgid "R"
msgstr "け"

msgctxt "text_id=23562 | speaker=unknown"
msgid "E"
msgstr "き"

msgctxt "text_id=23563 | speaker=unknown"
msgid "E"
msgstr "兄"

msgctxt "text_id=23564 | speaker=unknown"
msgid "P"
msgstr "妹"

msgctxt "text_id=23565 | speaker=unknown"
msgid "S!"
msgstr "愛。"

#. Occurrence WIK_TITLEIN:1774:23566: voice_id=D30_WIK_TITLEIN_0002; voice_prefix=D30; voice_category=0; scene=WIK_TITLEIN
#: WIK_TITLEIN:1774
msgctxt "text_id=23566 | speaker=unknown"
msgid "I don't really want to keep any more meatheads around here, but it's the only way to protect Kojika."
msgstr "おまえたちのような脳筋をこれ以上増やしたくないが、金鹿ならそんな悪夢は起きまい。"

#. Occurrence WIK_TITLEIN:1781:23567: voice_id=D30_WIK_TITLEIN_0003; voice_prefix=D30; voice_category=0; scene=WIK_TITLEIN
#: WIK_TITLEIN:1781
msgctxt "text_id=23567 | speaker=unknown"
msgid "Fine, but only if it's Mizora College. It's close, and she might even bring in some new regulars!"
msgstr "しゃあねえ、ミゾラ大なら俺も許す！　地元の大学だし、うちの常連さんも増えるだろうしな！"

#. Occurrence WIK_TITLEIN:1794:23568: voice_id=D30_WIK_TITLEIN_0004; voice_prefix=D30; voice_category=0; scene=WIK_TITLEIN
#: WIK_TITLEIN:1794
msgctxt "text_id=23568 | speaker=unknown"
msgid "  Gahahaha!\""
msgstr "　ガハハハハ』"

#. Occurrence WIK_TITLEIN:1799:23569: scene=WIK_TITLEIN
#: WIK_TITLEIN:1799
msgctxt "text_id=23569 | speaker=unknown"
msgid "  That was the decision my four brothers and my father came to in their little huddle."
msgstr "　兄四匹と父親一匹、がっしりとスクラムを組んでの結論だった。"

#. Occurrence WIK_TITLEIN:1850:23570: scene=WIK_TITLEIN
#: WIK_TITLEIN:1850
msgctxt "text_id=23570 | speaker=unknown"
msgid "  Just thinking about my family makes me want to die, but that's how it's been since elementary school, so I'm used to feeling like that."
msgstr "　あれがわたしの家族だと思うと死にたくなるが、そんなのは小学校から慣れっこなのでぐっと耐えた。"

#. Occurrence WIK_TITLEIN:1867:23571: scene=WIK_TITLEIN
#: WIK_TITLEIN:1867
msgctxt "text_id=23571 | speaker=unknown"
msgid "  I did as my father asked and set my sights on Mizora Sport Science U."
msgstr "　わたしは父の言いつけに従い、進学先を渠裸体育大に決めた。推薦はあっさり取れた。"

#. Occurrence WIK_TITLEIN:1879:23572: scene=WIK_TITLEIN
#: WIK_TITLEIN:1879
msgctxt "text_id=23572 | speaker=unknown"
msgid "  That put him at ease, but I had other things in mind."
msgstr "　それで父は安心したが、わたしの逆襲はここからである。"

#. Occurrence WIK_TITLEIN:1915:23573: scene=WIK_TITLEIN
#: WIK_TITLEIN:1915
msgctxt "text_id=23573 | speaker=unknown"
msgid "  I convinced him to let me put down a college in the city as my \"safety school.\""
msgstr "　わたしは“あくまで滑り止めだから”と都心の大学を第二候補として書き留めた。"

#. Occurrence WIK_TITLEIN:1922:23574: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_TITLEIN_0005; voice_prefix=B10; voice_category=5; scene=WIK_TITLEIN
#: WIK_TITLEIN:1922
msgctxt "text_id=23574 | speaker=kojika"
msgid "\"You're supposed to write down up to three schools you're interested in for your teacher to review. Just a formality, so I don't need any extra money or anything.\""
msgstr "『先生への建前上、進路希望には三つまで志望校を書く必要があったの。カタチの上だけだから、受験代の用意はしなくていい』"

#. Occurrence WIK_TITLEIN:1942:23575: scene=WIK_TITLEIN
#: WIK_TITLEIN:1942
msgctxt "text_id=23575 | speaker=unknown"
msgid "  My father believed every word of it."
msgstr "　わたしの言葉に、父は完全に騙された。"

#. Occurrence WIK_TITLEIN:1947:23576: scene=WIK_TITLEIN
#: WIK_TITLEIN:1947
msgctxt "text_id=23576 | speaker=unknown"
msgid "  Of course, I fully intended to go to my second choice in the city."
msgstr "　もちろん本命はその第二候補。"

#. Occurrence WIK_TITLEIN:1968:23577: scene=WIK_TITLEIN
#: WIK_TITLEIN:1968
msgctxt "text_id=23577 | speaker=unknown"
msgid "  That's why I secretly worked a part-time job."
msgstr "　そのために父に内緒でアルバイトをし続けた。"

#. Occurrence WIK_TITLEIN:1973:23578: scene=WIK_TITLEIN
#: WIK_TITLEIN:1973
msgctxt "text_id=23578 | speaker=unknown"
msgid "  I'd saved enough over three years to cover living costs if I got in. I'd have to get a loan for tuition fees, but it was the only way to make the plan work."
msgstr "　入試代金と、合格した後の生活費を三年計画で貯めたのだ。授業料は大学側に借り受けることが前提だが、この計画なら有無を言わさず進学する事ができる。"

#. Occurrence WIK_TITLEIN:2009:23579: scene=WIK_TITLEIN
#: WIK_TITLEIN:2009
msgctxt "text_id=23579 | speaker=unknown"
msgid "  My father was stubborn and brash, but he appreciated hard work and diligence."
msgstr "　父は頑固で力ずくな性格だが、人の努力を無視できるほど悪人でもない。"

#. Occurrence WIK_TITLEIN:2014:23580: scene=WIK_TITLEIN
#: WIK_TITLEIN:2014
msgctxt "text_id=23580 | speaker=unknown"
msgid "  If he saw that I passed my exams while saving up enough money to pay for myself, he'd probably let me go."
msgstr "　わたしが結果をだして、その後の資金すら貯めていたと知れば、しぶしぶ都心への上京を認めるだろう。"

#. Occurrence WIK_TITLEIN:2019:23581: scene=WIK_TITLEIN
#: WIK_TITLEIN:2019
msgctxt "text_id=23581 | speaker=unknown"
msgid "  Not that I wouldn't even if he disapproved."
msgstr "　ま、認めなくても上京するけど。"

#. Occurrence WIK_TITLEIN:2053:23582: scene=WIK_TITLEIN
#: WIK_TITLEIN:2053
msgctxt "text_id=23582 | speaker=unknown"
msgid "  Everything was going according to plan so far."
msgstr "　ここまで計画は順調だ。"

#. Occurrence WIK_TITLEIN:2058:23583: scene=WIK_TITLEIN
#: WIK_TITLEIN:2058
msgctxt "text_id=23583 | speaker=unknown"
msgid "  The only thing that could stop me was sudden illness preventing me from taking the entrance exam."
msgstr "　わたしを止められるものは、入学試験当日に風邪を引いてしまうか、あるいは―――"

#. Occurrence WIK_TITLEIN:2064:23584: scene=WIK_TITLEIN
#: WIK_TITLEIN:2064
msgctxt "text_id=23584 | speaker=unknown"
msgid "  Oh, right. There was one other thing..."
msgstr "　そう、あるいは―――その、"

#. Occurrence WIK_TITLEIN:2085:23585: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_TITLEIN_0014; voice_prefix=B60; voice_category=7; scene=WIK_TITLEIN
#: WIK_TITLEIN:2085
msgctxt "text_id=23585 | speaker=yamashiro"
msgid "\"So, do you have a boyfriend, Aozaki?\""
msgstr "「そういえば、蒼崎くんは彼氏とかいないのかい？」"

#. Occurrence WIK_TITLEIN:2107:23586: scene=WIK_TITLEIN
#: WIK_TITLEIN:2107
msgctxt "text_id=23586 | speaker=unknown"
msgid "  Aozaki didn't reply."
msgstr "　絶句する蒼崎。"

#. Occurrence WIK_TITLEIN:2112:23587: scene=WIK_TITLEIN
#: WIK_TITLEIN:2112
msgctxt "text_id=23587 | speaker=unknown"
msgid "  It's a beautiful day and Mr. Yamasiro had been invited to a party, so he couldn't be thinking straight."
msgstr "　このよく晴れた日、久遠寺邸でのパーティーというレアイベントに浮かれていたのだろう。"

#. Occurrence WIK_TITLEIN:2117:23588: scene=WIK_TITLEIN
#: WIK_TITLEIN:2117
msgctxt "text_id=23588 | speaker=unknown"
msgid "  He'd unknowingly spoken a word forbidden in Misaki High."
msgstr "　山城先生は三咲高校最大の禁句を口にした。"

#. Occurrence WIK_TITLEIN:2164:23589: scene=WIK_TITLEIN
#: WIK_TITLEIN:2164
msgctxt "text_id=23589 | speaker=unknown"
msgid "  Strangely―then again, maybe it's not so strange―Aozaki was single."
msgstr "　不思議なこと―――もとい、不思議でもなんでもないけど、蒼崎に彼氏はいない。"

#. Occurrence WIK_TITLEIN:2169:23590: scene=WIK_TITLEIN
#: WIK_TITLEIN:2169
msgctxt "text_id=23590 | speaker=unknown"
msgid "  She was undoubtedly attractive if she wasn't speaking to you,"
msgstr "　黙っていれば誰もが認める美少女な蒼崎だけど、"

#. Occurrence WIK_TITLEIN:2200:23591: scene=WIK_TITLEIN
#: WIK_TITLEIN:2200
msgctxt "text_id=23591 | speaker=unknown"
msgid " but she was permanently in a bad mood, and didn't bother with small talk."
msgstr "基本状態が不機嫌なため、浮ついた話は一切ないのだ。"

#. Occurrence WIK_TITLEIN:2248:23592: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_TITLEIN_0013_A; voice_prefix=A10; voice_category=1; scene=WIK_TITLEIN
#: WIK_TITLEIN:2248
msgctxt "text_id=23592 | speaker=aoko"
msgid "\"Were you up all night, Mr. Yamasiro?\""
msgstr "「山城先生、徹夜明けですか？」"

#. Occurrence WIK_TITLEIN:2259:23593: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_TITLEIN_0015; voice_prefix=B60; voice_category=7; scene=WIK_TITLEIN
#: WIK_TITLEIN:2259
msgctxt "text_id=23593 | speaker=yamashiro"
msgid "\"Oh, I, um, I was just, you know, curious. You're almost free of your student council duties, and I'm simply raising a glass to your youth as your teacher...\""
msgstr "「いや、だってほら、気になるでしょ。もうすぐ生徒会の役割から解放される訳ですしねぇ。蒼崎くんほどの子が青春を謳歌しないのは、教師として僕も心苦し、」"

#. Occurrence WIK_TITLEIN:2286:23594: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_TITLEIN_0014; voice_prefix=A10; voice_category=1; scene=WIK_TITLEIN
#: WIK_TITLEIN:2286
msgctxt "text_id=23594 | speaker=aoko"
msgid "\"Thank you *ever* so kindly for your concern, Mr. Yamasiro."
msgstr "「お心遣いありがとうございます、山城センセ。"

#. Occurrence WIK_TITLEIN:2292:23595: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_TITLEIN_0015; voice_prefix=A10; voice_category=1; scene=WIK_TITLEIN
#: WIK_TITLEIN:2292
msgctxt "text_id=23595 | speaker=aoko"
msgid "  If you're so concerned about me, perhaps we should date."
msgstr "　でしたら今から付き合いましょうか、私たち？"

#. Occurrence WIK_TITLEIN:2305:23596: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_TITLEIN_0016_0; voice_prefix=A10; voice_category=1; scene=WIK_TITLEIN
#: WIK_TITLEIN:2305
msgctxt "text_id=23596 | speaker=aoko"
msgid "  But what would happen if people were to find out?"
msgstr "　とりあえず、恋人同士らしくそこの暗がりに連れこんでいいですか？"

#. Occurrence WIK_TITLEIN:2335:23597: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_TITLEIN_0016_1; voice_prefix=A10; voice_category=1; scene=WIK_TITLEIN
#: WIK_TITLEIN:2335
msgctxt "text_id=23597 | speaker=aoko"
msgid "  What would happen if they found out our dark, little secret?\""
msgstr "　ええ、これからするコトとか、あまり人目につくとまずいので」"

#. Occurrence WIK_TITLEIN:2341:23598: scene=WIK_TITLEIN
#: WIK_TITLEIN:2341
msgctxt "text_id=23598 | speaker=unknown"
msgid "  Aozaki beamed."
msgstr "　にっこりと笑う蒼崎。"

#. Occurrence WIK_TITLEIN:2346:23599: scene=WIK_TITLEIN
#: WIK_TITLEIN:2346
msgctxt "text_id=23599 | speaker=unknown"
msgid "  If looks could kill..."
msgstr "　間違いなく人殺しの目つきだった。"

#. Occurrence WIK_TITLEIN:2382:23600: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_TITLEIN_0016; voice_prefix=B60; voice_category=7; scene=WIK_TITLEIN
#: WIK_TITLEIN:2382
msgctxt "text_id=23600 | speaker=yamashiro"
msgid "\"...I'm sorry. I was out of line. Please, don't go doing anything that would put me out of a job."
msgstr "「―――ごめん、たしかに正気じゃなかった。だからその、明日にも僕から職を奪いそうな企みはやめてくれ。"

#. Occurrence WIK_TITLEIN:2396:23601: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_TITLEIN_0017; voice_prefix=B60; voice_category=7; scene=WIK_TITLEIN
#: WIK_TITLEIN:2396
msgctxt "text_id=23601 | speaker=yamashiro"
msgid "  You've got exams coming up, so of course you don't need to worry about relationships."
msgstr "　そ、そもそも受験生に恋はご法度だったしね！"

#. Occurrence WIK_TITLEIN:2396:23602: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_WIK_TITLEIN_0017; voice_prefix=B60; voice_category=7; scene=WIK_TITLEIN
#: WIK_TITLEIN:2396
msgctxt "text_id=23602 | speaker=yamashiro"
msgid "  Excellent. Yes. You study hard, Aozaki!\""
msgstr "　いや、健全でおおいに結構！」"

#. Occurrence WIK_TITLEIN:2401:23603: scene=WIK_TITLEIN
#: WIK_TITLEIN:2401
msgctxt "text_id=23603 | speaker=unknown"
msgid "  Mr. Yamasiro laughed uncomfortably."
msgstr "　はははは、と軽やかに笑う山城先生。"

#. Occurrence WIK_TITLEIN:2428:23604: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_TITLEIN_0017; voice_prefix=A10; voice_category=1; scene=WIK_TITLEIN
#: WIK_TITLEIN:2428
msgctxt "text_id=23604 | speaker=aoko"
msgid "\"Good. Please, think before you speak in the future. Certain people at the mansion might not take kindly to slips of the tongue. Right, Kuma?\""
msgstr "「まったくです。くれぐれも口には気をつけてくださいね山城先生。これから行くところで、そんな浮ついた頭のヤツとかいませんから。ね、クマ」"

#. Occurrence WIK_TITLEIN:2453:23605: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_TITLEIN_0006; voice_prefix=B10; voice_category=5; scene=WIK_TITLEIN
#: WIK_TITLEIN:2453
msgctxt "text_id=23605 | speaker=kojika"
msgid "\"Right..."
msgstr "「……そうね。"

#. Occurrence WIK_TITLEIN:2465:23606: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_TITLEIN_0007; voice_prefix=B10; voice_category=5; scene=WIK_TITLEIN
#: WIK_TITLEIN:2465
msgctxt "text_id=23606 | speaker=kojika"
msgid "  Sure, it's a party, but it's for someone's birthday.\""
msgstr "　パーティーといっても、あくまで誕生会って話だし」"

#. Occurrence WIK_TITLEIN:2499:23607: scene=WIK_TITLEIN
#: WIK_TITLEIN:2499
msgctxt "text_id=23607 | speaker=unknown"
msgid "  I was starting to feel a little inadequate."
msgstr "　返答して、自分のハンパさに滅入ってしまう。"

#. Occurrence WIK_TITLEIN:2504:23608: scene=WIK_TITLEIN
#: WIK_TITLEIN:2504
msgctxt "text_id=23608 | speaker=unknown"
msgid "  I wasn't as attractive or cool as Aozaki."
msgstr "　わたしは蒼崎ほど男前でもないし、格好よくもない。"

#. Occurrence WIK_TITLEIN:2509:23609: scene=WIK_TITLEIN
#: WIK_TITLEIN:2509
msgctxt "text_id=23609 | speaker=unknown"
msgid "  I mean, I wasn't even sure my college plan was really going to work. I felt more anxious every day."
msgstr "　だって今さら、わたしは自分の計画に迷ってしまっている。臆病になっている、と言っていい。"

#. Occurrence WIK_TITLEIN:2515:23610: scene=WIK_TITLEIN
#: WIK_TITLEIN:2515
msgctxt "text_id=23610 | speaker=unknown"
msgid "  Pathetic, I know."
msgstr "　ほんと、自分でも情けないと思うんだけど。"

#. Occurrence WIK_TITLEIN:2520:23611: scene=WIK_TITLEIN
#: WIK_TITLEIN:2520
msgctxt "text_id=23611 | speaker=unknown"
msgid "  If I didn't already have enough to worry about, there was the equally big problem of a boy at school."
msgstr "　わたしにはどうも、進学問題と同じ比重を持った男子生徒が、いるようなのだった。"

#. Occurrence WIK_TITLEIN:2552:23612: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_TITLEIN_0008; voice_prefix=B10; voice_category=5; scene=WIK_TITLEIN
#: WIK_TITLEIN:2552
msgctxt "text_id=23612 | speaker=kojika"
msgid "\"I'm surprised Miss Kuonji is holding a party at her place. Aozaki, you mentioned even her father rarely gets to visit.\""
msgstr "「けど、よく久遠寺さんが承諾したわね。蒼崎の話じゃ、彼女の父親でさえ滅多に入れないんでしょう？」"

#. Occurrence WIK_TITLEIN:2573:23613: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_TITLEIN_0018; voice_prefix=A10; voice_category=1; scene=WIK_TITLEIN
#: WIK_TITLEIN:2573
msgctxt "text_id=23613 | speaker=aoko"
msgid "\"It came as a shock to me too, actually. I guess people really can change."
msgstr "「うん、それには私も驚いてる。人間、変われば変わるもんだってね。"

#. Occurrence WIK_TITLEIN:2624:23614: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_TITLEIN_0000; voice_prefix=A40; voice_category=2; scene=WIK_TITLEIN
#: WIK_TITLEIN:2624
msgctxt "text_id=23614 | speaker=alice"
msgid "'Sizuki's friends can come, too. I don't mind.'"
msgstr "“静希君のお友達なら、あがってもらって構わないけど”"

#. Occurrence WIK_TITLEIN:2630:23615: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_WIK_TITLEIN_0019; voice_prefix=A10; voice_category=1; scene=WIK_TITLEIN
#: WIK_TITLEIN:2630
msgctxt "text_id=23615 | speaker=aoko"
msgid "  Never thought I'd hear Alice say something like that.\""
msgstr "　なんて台詞、有珠からでると思わなかったわ」"

#. Occurrence WIK_TITLEIN:2681:23616: scene=WIK_TITLEIN
#: WIK_TITLEIN:2681
msgctxt "text_id=23616 | speaker=unknown"
msgid "  The gate to Shiroinuzuka stood tall, as if designed to warn off visitors."
msgstr "　白犬塚の山中にある門は、来訪者を拒むようにそびえ立っている。"

#. Occurrence WIK_TITLEIN:2686:23617: scene=WIK_TITLEIN
#: WIK_TITLEIN:2686
msgctxt "text_id=23617 | speaker=unknown"
msgid "  Aozaki opened the gate; it wasn't even locked."
msgstr "　蒼崎は解錠の素振りもなく鉄扉を開ける。"

#. Occurrence WIK_TITLEIN:2691:23618: scene=WIK_TITLEIN
#: WIK_TITLEIN:2691
msgctxt "text_id=23618 | speaker=unknown"
msgid "  I felt like we were passing into a different world. Was it just me, or did the trees and mountains look different inside?"
msgstr "　門は境界になっているのか、内と外では山林の様子が違って見えた。"

#. Occurrence WIK_TITLEIN:2696:23619: scene=WIK_TITLEIN
#: WIK_TITLEIN:2696
msgctxt "text_id=23619 | speaker=unknown"
msgid "  I..."
msgstr "　わたしは―――"

#. Occurrence WIK_SELECT_A:9:23620: scene=WIK_SELECT_A
#: WIK_SELECT_A:9
msgctxt "text_id=23620 | speaker=unknown"
msgid "-Decision A-"
msgstr "～選択肢Ａ～"

#. Occurrence WIK_U_1:30:23621: scene=WIK_U_1
#: WIK_U_1:30
msgctxt "text_id=23621 | speaker=unknown"
msgid "  I think it would be best to run away until the morning."
msgstr "　わたしは、このまま朝まで逃げきるべきだ、と思った。"

#. Occurrence WIK_U_1:63:23622: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_U_1_0000; voice_prefix=B10; voice_category=5; scene=WIK_U_1
#: WIK_U_1:63
msgctxt "text_id=23622 | speaker=kojika"
msgid "\"Huh?\""
msgstr "「あれ？」"

#. Occurrence WIK_U_1:69:23623: scene=WIK_U_1
#: WIK_U_1:69
msgctxt "text_id=23623 | speaker=unknown"
msgid "  Something felt off for a second there."
msgstr "　今、妙な食い違いがあったような。"

#. Occurrence WIK_U_1:74:23624: scene=WIK_U_1
#: WIK_U_1:74
msgctxt "text_id=23624 | speaker=unknown"
msgid "  It was as if my decision was completely different from the words that came from my mouth."
msgstr "　わたしの選択と、わたしの口が、微妙にニュアンスが違うことを言ったような。"

#. Occurrence WIK_U_1:95:23625: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_U_1_0001; voice_prefix=B10; voice_category=5; scene=WIK_U_1
#: WIK_U_1:95
msgctxt "text_id=23625 | speaker=kojika"
msgid "\"No time for that! I have to get out of here!\""
msgstr "「ううん、それどころじゃない！　早く逃げないと！」"

#. Occurrence WIK_U_1:171:23626: scene=WIK_U_1
#: WIK_U_1:171
msgctxt "text_id=23626 | speaker=unknown"
msgid "  The game would end if I could just keep from getting caught until sunrise."
msgstr "　太陽が昇りきるまで逃げれば、このゲームはおしまいだ。"

#. Occurrence WIK_U_1:176:23627: scene=WIK_U_1
#: WIK_U_1:176
msgctxt "text_id=23627 | speaker=unknown"
msgid "  As long as I survived, Sweets Hearts wouldn't win."
msgstr "　わたしという生存者がいるかぎり、スイーツハーツの勝ちにはならない。"

#. Occurrence WIK_U_1:181:23628: scene=WIK_U_1
#: WIK_U_1:181
msgctxt "text_id=23628 | speaker=unknown"
msgid "  The storm was over. If I could just make it to the city, everything would go back to normal...!"
msgstr "　嵐も止んだし、このまま町まで下りてしまえば何もかも元通りなんだ……！"

#. Occurrence WIK_U_1:234:23629: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_U_1_0002; voice_prefix=B10; voice_category=5; scene=WIK_U_1
#: WIK_U_1:234
msgctxt "text_id=23629 | speaker=kojika"
msgid "\"...No way.\""
msgstr "「―――うそ」"

#. Occurrence WIK_U_1:240:23630: scene=WIK_U_1
#: WIK_U_1:240
msgctxt "text_id=23630 | speaker=unknown"
msgid "  I'd been heading downhill all this time, so how did I end up behind the mansion?"
msgstr "　わたしは下に向かって駆け続けたのに、たどり着いたのは洋館の裏。"

#. Occurrence WIK_U_1:320:23631: scene=WIK_U_1
#: WIK_U_1:320
msgctxt "text_id=23631 | speaker=unknown"
msgid "  Aaah..."
msgstr "　ああ―――"

#. Occurrence WIK_U_1:325:23632: scene=WIK_U_1
#: WIK_U_1:325
msgctxt "text_id=23632 | speaker=unknown"
msgid "  The ground distorted."
msgstr "　地面が歪んでいる。"

#. Occurrence WIK_U_1:330:23633: scene=WIK_U_1
#: WIK_U_1:330
msgctxt "text_id=23633 | speaker=unknown"
msgid "  My senses went haywire."
msgstr "　感覚が狂っている。"

#. Occurrence WIK_U_1:335:23634: scene=WIK_U_1
#: WIK_U_1:335
msgctxt "text_id=23634 | speaker=unknown"
msgid "  The world crumbled."
msgstr "　世界は崩れている。"

#. Occurrence WIK_U_1:341:23635: scene=WIK_U_1
#: WIK_U_1:341
msgctxt "text_id=23635 | speaker=unknown"
msgid "  I must've done something wrong."
msgstr "　わたしはきっと、何かを、間違えてしまっている。"

#. Occurrence WIK_U_1:386:23636: scene=WIK_U_1
#: WIK_U_1:386
msgctxt "text_id=23636 | speaker=unknown"
msgid "  Suddenly, a voice whispered in my ear."
msgstr "　不意に、耳元で"

#. Occurrence WIK_U_1:396:23637: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_U_1_0000; voice_prefix=A30; voice_category=3; scene=WIK_U_1
#: WIK_U_1:396
msgctxt "text_id=23637 | speaker=soujuurou"
msgid "          \"Con-"
msgstr "　　　　　「み"

msgctxt "text_id=23638 | speaker=unknown"
msgid "gra-"
msgstr "な"

msgctxt "text_id=23639 | speaker=unknown"
msgid "tu-"
msgstr "ご"

msgctxt "text_id=23640 | speaker=unknown"
msgid "lations"
msgstr "ろ"

msgctxt "text_id=23641 | speaker=unknown"
msgid " on"
msgstr "し、"

msgctxt "text_id=23642 | speaker=unknown"
msgid " kill-"
msgstr "お"

msgctxt "text_id=23643 | speaker=unknown"
msgid "ing"
msgstr "め"

msgctxt "text_id=23644 | speaker=unknown"
msgid " ev-"
msgstr "で"

msgctxt "text_id=23645 | speaker=unknown"
msgid "ery-"
msgstr "と"

msgctxt "text_id=23646 | speaker=unknown"
msgid "one.\""
msgstr "う」"

#. Occurrence WIK_U_1:428:23647: scene=WIK_U_1
#: WIK_U_1:428
msgctxt "text_id=23647 | speaker=unknown"
msgid "  It was a voice of terror that I'd never heard before,"
msgstr "　一度も聞いたコトのない、世にも恐ろしい、"

#. Occurrence WIK_U_1:433:23648: scene=WIK_U_1
#: WIK_U_1:433
msgctxt "text_id=23648 | speaker=unknown"
msgid "  yet it sounded so familiar..."
msgstr "　近しい他人の声を聞いた―――"

#. Occurrence WIK_U_2:30:23649: scene=WIK_U_2
#: WIK_U_2:30
msgctxt "text_id=23649 | speaker=unknown"
msgid "  I thought I should try to deduce who the killer is."
msgstr "　わたしは、犯人を推理するべきだ、と思った。"

#. Occurrence WIK_U_2:63:23650: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_U_2_0000; voice_prefix=B10; voice_category=5; scene=WIK_U_2
#: WIK_U_2:63
msgctxt "text_id=23650 | speaker=kojika"
msgid "\"Calm down. Everything should be in order.\""
msgstr "「落ち着け。もう条件は揃ってる、はず」"

#. Occurrence WIK_U_2:69:23651: scene=WIK_U_2
#: WIK_U_2:69
msgctxt "text_id=23651 | speaker=unknown"
msgid "  I controlled my breathing and began to organize the facts in my head."
msgstr "　呼吸を整えながら、これまでの事を整理する。"

#. Occurrence WIK_U_2:74:23652: scene=WIK_U_2
#: WIK_U_2:74
msgctxt "text_id=23652 | speaker=unknown"
msgid "  I didn't have a decisive answer to the killer's motive, method, or identity."
msgstr "　この<事件|ケース>では、動機も殺害方法も、犯人特定への切り札にはなり得なかった。"

#. Occurrence WIK_U_2:94:23653: scene=WIK_U_2
#: WIK_U_2:94
msgctxt "text_id=23653 | speaker=unknown"
msgid "  There was only one thing I knew for sure."
msgstr "　確かなものは一つだけ。"

#. Occurrence WIK_U_2:99:23654: scene=WIK_U_2
#: WIK_U_2:99
msgctxt "text_id=23654 | speaker=unknown"
msgid "  Tsukiji had said it many times."
msgstr "　槻司は何度も言っていた。"

#. Occurrence WIK_U_2:104:23655: scene=WIK_U_2
#: WIK_U_2:104
msgctxt "text_id=23655 | speaker=unknown"
msgid "  It's not about who committed the murders,"
msgstr "“誰が殺したか”ではない。"

#. Occurrence WIK_U_2:109:23656: scene=WIK_U_2
#: WIK_U_2:109
msgctxt "text_id=23656 | speaker=unknown"
msgid "but rather who *could have* committed the murders."
msgstr "“誰なら殺せるのか”を考えろ、と。"

#. Occurrence WIK_U_2:138:23657: scene=WIK_U_2
#: WIK_U_2:138
msgctxt "text_id=23657 | speaker=unknown"
msgid "  The first murder: Tokitsu's capture and death by explosion."
msgstr "　第一の殺人。土桔氏の軟禁爆破殺人。"

#. Occurrence WIK_U_2:144:23658: scene=WIK_U_2
#: WIK_U_2:144
msgctxt "text_id=23658 | speaker=unknown"
msgid "  We could exclude the following suspects: Me,"
msgstr "　これが不可能だったと断言できるのはわたし、"

msgctxt "text_id=23659 | speaker=unknown"
msgid " Miss Kuonji,"
msgstr "久遠寺さん、"

msgctxt "text_id=23660 | speaker=unknown"
msgid " Tsukiji,"
msgstr "槻司、"

msgctxt "text_id=23661 | speaker=unknown"
msgid " Housuke,"
msgstr "芳助、"

msgctxt "text_id=23662 | speaker=unknown"
msgid " Father Eiri,"
msgstr "詠梨神父、"

msgctxt "text_id=23663 | speaker=unknown"
msgid " and Sister Yuika."
msgstr "唯架さん。"

#. Occurrence WIK_U_2:210:23664: scene=WIK_U_2
#: WIK_U_2:210
msgctxt "text_id=23664 | speaker=unknown"
msgid "  The second murder: Mr. Yamasiro's fabulous funeral."
msgstr "　第二の殺人。山城先生の豪華送別式殺人。"

#. Occurrence WIK_U_2:215:23665: scene=WIK_U_2
#: WIK_U_2:215
msgctxt "text_id=23665 | speaker=unknown"
msgid "  Impossible to rule any suspects out."
msgstr "　不可能だったのは―――これは特定できない。"

#. Occurrence WIK_U_2:222:23666: scene=WIK_U_2
#: WIK_U_2:222
msgctxt "text_id=23666 | speaker=unknown"
msgid "  At a stretch, we could maybe exclude Miss Kuonji."
msgstr "　かろうじて久遠寺さんぐらいだ。"

#. Occurrence WIK_U_2:227:23667: scene=WIK_U_2
#: WIK_U_2:227
msgctxt "text_id=23667 | speaker=unknown"
msgid "  We don't know when Mr. Yamasiro was killed, because we were all looking around after Tokitsu's murder."
msgstr "　山城先生がいつ殺されたのかは不明だし、土桔氏の事件の後、みんなで手分けして家捜ししてしまったからだ。"

#. Occurrence WIK_U_2:232:23668: scene=WIK_U_2
#: WIK_U_2:232
msgctxt "text_id=23668 | speaker=unknown"
msgid "  It's unlikely the murder was committed within that ten-minute gap, but we couldn't rule it out completely."
msgstr "　たった十分程度の時間で、犯行はほぼ不可能だけど、絶対にできなかった、とは断定できない。"

#. Occurrence WIK_U_2:273:23669: scene=WIK_U_2
#: WIK_U_2:273
msgctxt "text_id=23669 | speaker=unknown"
msgid "  The third murder: Housuke and Riddell."
msgstr "　第三の殺人、芳助＆リデル。"

#. Occurrence WIK_U_2:280:23670: scene=WIK_U_2
#: WIK_U_2:280
msgctxt "text_id=23670 | speaker=unknown"
msgid "  Who cares?"
msgstr "　これはどうでもいい。"

#. Occurrence WIK_U_2:334:23671: scene=WIK_U_2
#: WIK_U_2:334
msgctxt "text_id=23671 | speaker=unknown"
msgid "  The fourth murder: Beo."
msgstr "　第四の殺人、ベオ。"

#. Occurrence WIK_U_2:340:23672: scene=WIK_U_2
#: WIK_U_2:340
msgctxt "text_id=23672 | speaker=unknown"
msgid "  It can't have been me, because I didn't search for Aozaki's sister."
msgstr "　不可能だったのは……蒼崎姉を捜しに行かなかったわたしと"

msgctxt "text_id=23673 | speaker=unknown"
msgid " Neither could it have been Tsukiji,"
msgstr "槻司、"

msgctxt "text_id=23674 | speaker=unknown"
msgid " Sizuki,"
msgstr "静希、"

msgctxt "text_id=23675 | speaker=unknown"
msgid " or Ritsuka."
msgstr "律架さん。"

#. Occurrence WIK_U_2:432:23676: scene=WIK_U_2
#: WIK_U_2:432
msgctxt "text_id=23676 | speaker=unknown"
msgid "  The fifth murder: Father Eiri's web."
msgstr "　第五の殺人は詠梨神父の空中耽美系首つり殺人。"

#. Occurrence WIK_U_2:438:23677: scene=WIK_U_2
#: WIK_U_2:438
msgctxt "text_id=23677 | speaker=unknown"
msgid "  We were in the foyer, so it couldn't have been me,"
msgstr "　不可能だったのはロビーに残ったわたしと"

msgctxt "text_id=23678 | speaker=unknown"
msgid " Tsukiji,"
msgstr "槻司、"

msgctxt "text_id=23679 | speaker=unknown"
msgid " Ritsuka,"
msgstr "律架さん、"

msgctxt "text_id=23680 | speaker=unknown"
msgid " or Miss Kuonji."
msgstr "久遠寺さん。"

#. Occurrence WIK_U_2:484:23681: scene=WIK_U_2
#: WIK_U_2:484
msgctxt "text_id=23681 | speaker=unknown"
msgid "  The sixth murder: The Yuika statue."
msgstr "　第六の殺人、唯架さん石化殺人。"

#. Occurrence WIK_U_2:490:23682: scene=WIK_U_2
#: WIK_U_2:490
msgctxt "text_id=23682 | speaker=unknown"
msgid "  This one didn't matter, either."
msgstr "　これもどうでもいい。"

#. Occurrence WIK_U_2:514:23683: scene=WIK_U_2
#: WIK_U_2:514
msgctxt "text_id=23683 | speaker=unknown"
msgid "  The seventh murder: the elder Aozaki's death by alcohol poisoning."
msgstr "　第七の殺人、蒼崎姉・みちのくアルコール中毒殺人。"

#. Occurrence WIK_U_2:520:23684: scene=WIK_U_2
#: WIK_U_2:520
msgctxt "text_id=23684 | speaker=unknown"
msgid "  This might actually have been the first murder in the timeline. We could exclude..."
msgstr "　時系列的には第一の事件では、と疑いがあるので、不可能だったのは―――"

msgctxt "text_id=23685 | speaker=unknown"
msgid " maybe only Miss Kuonji, barely."
msgstr "かろうじて、久遠寺さんぐらい。"

#. Occurrence WIK_U_2:559:23686: scene=WIK_U_2
#: WIK_U_2:559
msgctxt "text_id=23686 | speaker=unknown"
msgid "  That's everything I knew."
msgstr "　わたしが体験した殺人は以上だ。"

#. Occurrence WIK_U_2:564:23687: scene=WIK_U_2
#: WIK_U_2:564
msgctxt "text_id=23687 | speaker=unknown"
msgid "  Now it came down to simple process of elimination."
msgstr "　これは単純な消去法の問題。"

#. Occurrence WIK_U_2:569:23688: scene=WIK_U_2
#: WIK_U_2:569
msgctxt "text_id=23688 | speaker=unknown"
msgid "  Who was the invisible killer who made everyone laugh?"
msgstr "　誰がみんなを笑わせて回った、姿なき殺人者なのか。"

#. Occurrence WIK_U_2:574:23689: scene=WIK_U_2
#: WIK_U_2:574
msgctxt "text_id=23689 | speaker=unknown"
msgid "  I think the killer must be..."
msgstr "　わたしが指名する犯人は―――"

#. Occurrence WIK_SELECT_V:8:23690: scene=WIK_SELECT_V
#: WIK_SELECT_V:8
msgctxt "text_id=23690 | speaker=unknown"
msgid "-Decision V-"
msgstr "～選択肢Ｖ～"

#. Occurrence WIK_V_1:39:23691: scene=WIK_V_1
#: WIK_V_1:39
msgctxt "text_id=23691 | speaker=unknown"
msgid "  ...It was Sizuki."
msgstr "　―――静希だ。"

#. Occurrence WIK_V_1:45:23692: scene=WIK_V_1
#: WIK_V_1:45
msgctxt "text_id=23692 | speaker=unknown"
msgid "  If the facts were pointing to anyone, it was him."
msgstr "　あいつが一番、条件を満たしている。"

#. Occurrence WIK_V_1:50:23693: scene=WIK_V_1
#: WIK_V_1:50
msgctxt "text_id=23693 | speaker=unknown"
msgid "  He knew this mansion inside and out."
msgstr "　この洋館に精通していること。"

#. Occurrence WIK_V_1:55:23694: scene=WIK_V_1
#: WIK_V_1:55
msgctxt "text_id=23694 | speaker=unknown"
msgid "  He'd been helping out with the birthday party, so he could move about freely without raising suspicion."
msgstr "　誕生会のホスト側だったので動き回っていても違和感はなかったこと。"

#. Occurrence WIK_V_1:60:23695: scene=WIK_V_1
#: WIK_V_1:60
msgctxt "text_id=23695 | speaker=unknown"
msgid "  But the biggest piece of evidence..."
msgstr "　そして、何より―――"

#. Occurrence WIK_V_1:80:23696: scene=WIK_V_1
#: WIK_V_1:80
msgctxt "text_id=23696 | speaker=unknown"
msgid "  ...was the glaring discrepancy between his and Miss Kuonji's alibis."
msgstr "　あいつと久遠寺さんのアリバイ証言に、致命的な食い違いがあった事。"

#. Occurrence WIK_V_1:85:23697: scene=WIK_V_1
#: WIK_V_1:85
msgctxt "text_id=23697 | speaker=unknown"
msgid "  Sizuki said he was in the mansion in the morning."
msgstr "　朝は屋敷にいたと静希は言っていた。"

#. Occurrence WIK_V_1:90:23698: scene=WIK_V_1
#: WIK_V_1:90
msgctxt "text_id=23698 | speaker=unknown"
msgid "  However, that's not what his landlady said."
msgstr "　けれど久遠寺さんはこう言っていた。"

#. Occurrence WIK_V_1:95:23699: scene=WIK_V_1
#: WIK_V_1:95
msgctxt "text_id=23699 | speaker=unknown"
msgid "  She said that \"no one was around to help,\" so she locked the place up herself."
msgstr "“人手がなかったから、自分が施錠してまわる事になった”と。"

#. Occurrence WIK_V_1:115:23700: scene=WIK_V_1
#: WIK_V_1:115
msgctxt "text_id=23700 | speaker=unknown"
msgid "  If she did that on a regular basis, she wouldn't have bothered to mention that."
msgstr "　もともと、屋敷を施錠してまわる役目が彼女のものなら、あんな言い回しはしない筈だ。"

#. Occurrence WIK_V_1:120:23701: scene=WIK_V_1
#: WIK_V_1:120
msgctxt "text_id=23701 | speaker=unknown"
msgid "  Miss Kuonji wanted either Sizuki or Aozaki to lock the doors."
msgstr "　久遠寺さんは静希、あるいは蒼崎に施錠を頼む気だった。"

#. Occurrence WIK_V_1:125:23702: scene=WIK_V_1
#: WIK_V_1:125
msgctxt "text_id=23702 | speaker=unknown"
msgid "  Aozaki said she was in town in that morning."
msgstr "　蒼崎は午前中は街にいた、と証言した。"

#. Occurrence WIK_V_1:130:23703: scene=WIK_V_1
#: WIK_V_1:130
msgctxt "text_id=23703 | speaker=unknown"
msgid "  That's likely why her sister was able to enter her room."
msgstr "　それは部屋を留守にして、結果的にお姉さんの侵入を許した事で証明できる。"

#. Occurrence WIK_V_1:135:23704: scene=WIK_V_1
#: WIK_V_1:135
msgctxt "text_id=23704 | speaker=unknown"
msgid "  Sizuki lied about being at the mansion at that time."
msgstr "　けれど静希は、洋館にいた、と嘘の供述をしたのだ。"

#. Occurrence WIK_V_1:170:23705: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_V_1_0000; voice_prefix=B10; voice_category=5; scene=WIK_V_1
#: WIK_V_1:170
msgctxt "text_id=23705 | speaker=kojika"
msgid "\"Not the strongest case, I know, but that's all I have to go on...\""
msgstr "「決め手がそれだけっていうのが、なんとも弱いけど……」"

#. Occurrence WIK_V_1:176:23706: scene=WIK_V_1
#: WIK_V_1:176
msgctxt "text_id=23706 | speaker=unknown"
msgid "  I felt that there was more I could pin on him, but I wasn't sure what right now."
msgstr "　他にもう一つか二つはある気がするけど、今は頭が働かない。"

#. Occurrence WIK_V_1:181:23707: scene=WIK_V_1
#: WIK_V_1:181
msgctxt "text_id=23707 | speaker=unknown"
msgid "  I had to find Sizuki before morning. Before..."
msgstr "　早く、朝になる前に静希を見付けて、見付け―――"

#. Occurrence WIK_V_1:197:23708: scene=WIK_V_1
#: WIK_V_1:197
msgctxt "text_id=23708 | speaker=unknown"
msgid "  Someone was behind me."
msgstr "　後ろに。誰かが。立っている。気配が。"

msgctxt "text_id=23709 | speaker=unknown"
msgid "\"So you're the killer,"
msgstr "「アンタが"

msgctxt "text_id=23710 | speaker=unknown"
msgid " Sizuki!!!\""
msgstr "犯人ね静希ーーーー！」"

#. Occurrence WIK_V_1:298:23711: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_V_1_0000; voice_prefix=A30; voice_category=3; scene=WIK_V_1
#: WIK_V_1:298
msgctxt "text_id=23711 | speaker=soujuurou"
msgid "\"Whuh?!\""
msgstr "「ごはっ！？」"

#. Occurrence WIK_V_1:318:23712: scene=WIK_V_1
#: WIK_V_1:318
msgctxt "text_id=23712 | speaker=unknown"
msgid "  Eat this!"
msgstr "　だっしゃあーーーーーー！"

#. Occurrence WIK_V_1:323:23713: scene=WIK_V_1
#: WIK_V_1:323
msgctxt "text_id=23713 | speaker=unknown"
msgid "  I took up my trusty wok and swing it as hard as I could, before he could lay a hand on me."
msgstr "　振り向きざまに、<襲|おそ>われるより先に、手にした中華鍋をフルスイングするわたし。"

#. Occurrence WIK_V_1:354:23714: scene=WIK_V_1
#: WIK_V_1:354
msgctxt "text_id=23714 | speaker=unknown"
msgid "  It connected, hard."
msgstr "　決まった。"

#. Occurrence WIK_V_1:359:23715: scene=WIK_V_1
#: WIK_V_1:359
msgctxt "text_id=23715 | speaker=unknown"
msgid "  Harder than it should have..."
msgstr "　決まりすぎた。"

#. Occurrence WIK_V_1:365:23716: scene=WIK_V_1
#: WIK_V_1:365
msgctxt "text_id=23716 | speaker=unknown"
msgid "  Sizuki... I only saw him briefly, but I knew it was him. He collapsed to the ground,"
msgstr "　静希……一瞬だけ見えたけど、やっぱり静希だった……は倒れこみ、"

msgctxt "text_id=23717 | speaker=unknown"
msgid " and a strange item tumbled onto the floor."
msgstr "床にはおかしなアイテムが転がった。"

#. Occurrence WIK_V_1:392:23718: scene=WIK_V_1
#: WIK_V_1:392
msgctxt "text_id=23718 | speaker=unknown"
msgid "  ...It was the kind of cheap fake glasses and nose you'd find in any bag of party favors."
msgstr "　アレは―――パーティーアイテムとしてそれなりに定番の、変装グッズ鼻メガネだ。"

#. Occurrence WIK_V_1:413:23719: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_V_1_0002; voice_prefix=B10; voice_category=5; scene=WIK_V_1
#: WIK_V_1:413
msgctxt "text_id=23719 | speaker=kojika"
msgid "\"W-Who would actually laugh at this?!\""
msgstr "「そ、そんなんで笑わせるとか、アリ！？」"

#. Occurrence WIK_V_1:419:23720: scene=WIK_V_1
#: WIK_V_1:419
msgctxt "text_id=23720 | speaker=unknown"
msgid "  The only ones who would were Miss Kuonji who didn't get out much... and Aozaki, who thought so much of Sizuki."
msgstr "　あんなんで笑うのは箱入り娘の久遠寺さんと、なんだかんだと静希を買っている蒼崎ぐらいだろう。"

#. Occurrence WIK_V_1:458:23721: scene=WIK_V_1
#: WIK_V_1:458
msgctxt "text_id=23721 | speaker=unknown"
msgid "  Whatever. I started running."
msgstr "　ともあれ、わたしは走りだした。"

#. Occurrence WIK_V_1:463:23722: scene=WIK_V_1
#: WIK_V_1:463
msgctxt "text_id=23722 | speaker=unknown"
msgid "  As long as I've guessed the killer correctly, I've beaten the game."
msgstr "　犯人が分かった以上、このゲームはクリアされた。"

#. Occurrence WIK_V_1:468:23723: scene=WIK_V_1
#: WIK_V_1:468
msgctxt "text_id=23723 | speaker=unknown"
msgid "  But maybe Sizuki would recover and come after me."
msgstr "　けど殴られ、見抜かれ、逆上した静希がいつ反撃してくるか分からない。"

#. Occurrence WIK_V_1:498:23724: scene=WIK_V_1
#: WIK_V_1:498
msgctxt "text_id=23724 | speaker=unknown"
msgid "  I decided to escape through the foyer."
msgstr "　わたしは急いでロビーから脱出する。"

#. Occurrence WIK_V_1:504:23725: scene=WIK_V_1
#: WIK_V_1:504
msgctxt "text_id=23725 | speaker=unknown"
msgid "  If I could make it to the forest outside, I'd win."
msgstr "　外に出て森に入ればわたしの勝ち。"

#. Occurrence WIK_V_1:509:23726: scene=WIK_V_1
#: WIK_V_1:509
msgctxt "text_id=23726 | speaker=unknown"
msgid "  It had to be morning by now...!"
msgstr "　逃げ回っているうちに朝になっているだろう……！"

#. Occurrence WIK_V_1:555:23727: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_V_1_0003; voice_prefix=B10; voice_category=5; scene=WIK_V_1
#: WIK_V_1:555
msgctxt "text_id=23727 | speaker=kojika"
msgid "\"Huh...?\""
msgstr "「え―――？」"

#. Occurrence WIK_V_1:561:23728: scene=WIK_V_1
#: WIK_V_1:561
msgctxt "text_id=23728 | speaker=unknown"
msgid "  It was still dark outside."
msgstr "　外は、まだ、暗い。"

#. Occurrence WIK_V_1:566:23729: scene=WIK_V_1
#: WIK_V_1:566
msgctxt "text_id=23729 | speaker=unknown"
msgid "  What?"
msgstr "　どういうコト？"

#. Occurrence WIK_V_1:571:23730: scene=WIK_V_1
#: WIK_V_1:571
msgctxt "text_id=23730 | speaker=unknown"
msgid "  How?"
msgstr "　どういうコト？"

#. Occurrence WIK_V_1:596:23731: scene=WIK_V_1
#: WIK_V_1:596
msgctxt "text_id=23731 | speaker=unknown"
msgid "  How was it still dark out?!"
msgstr "　どういうコトなんだ―――！？"

#. Occurrence WIK_V_1:617:23732: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B11_WIK_V_1_0000; voice_prefix=B11; voice_category=5; scene=WIK_V_1
#: WIK_V_1:617
msgctxt "text_id=23732 | speaker=kojika"
msgid "\"Excellent... work... I must say...\""
msgstr "「貴女―――よくも、やって、くれた、わね―――」"

#. Occurrence WIK_V_1:623:23733: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_V_1_0004; voice_prefix=B10; voice_category=5; scene=WIK_V_1
#: WIK_V_1:623
msgctxt "text_id=23733 | speaker=kojika"
msgid "\"Eh?\""
msgstr "「へ？」"

#. Occurrence WIK_V_1:628:23734: scene=WIK_V_1
#: WIK_V_1:628
msgctxt "text_id=23734 | speaker=unknown"
msgid "  A resentful female voice croaked from the foyer."
msgstr "　ロビーからは恨みがましい女の声。"

#. Occurrence WIK_V_1:633:23735: scene=WIK_V_1
#: WIK_V_1:633
msgctxt "text_id=23735 | speaker=unknown"
msgid "  Wait, female?!"
msgstr "　女の声！？"

#. Occurrence WIK_V_1:659:23736: scene=WIK_V_1
#: WIK_V_1:659
msgctxt "text_id=23736 | speaker=unknown"
msgid "  But who was it?! I thought Sizuki was the killer!"
msgstr "　誰だアレ、静希なのに、静希じゃない……！？"

#. Occurrence WIK_V_1:715:23737: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_V_1_0005; voice_prefix=B10; voice_category=5; scene=WIK_V_1
#: WIK_V_1:715
msgctxt "text_id=23737 | speaker=kojika"
msgid "\"Hah, hah, hah, hah!\""
msgstr "「はっ、はっ、はっ、は―――！」"

#. Occurrence WIK_V_1:721:23738: scene=WIK_V_1
#: WIK_V_1:721
msgctxt "text_id=23738 | speaker=unknown"
msgid "  Run. Just run. RUN!"
msgstr "　走る。走る。走る。"

#. Occurrence WIK_V_1:726:23739: scene=WIK_V_1
#: WIK_V_1:726
msgctxt "text_id=23739 | speaker=unknown"
msgid "  I was confused, but I could still run."
msgstr "　混乱しながら走る。"

#. Occurrence WIK_V_1:754:23740: scene=WIK_V_1
#: WIK_V_1:754
msgctxt "text_id=23740 | speaker=unknown"
msgid "  I tripped and fell. As I stood up, I tried to take a second to think."
msgstr "　転んで、立ち上がろうとして、それよりまず、考える方が先だと自分を叱咤した。"

#. Occurrence WIK_V_1:774:23741: scene=WIK_V_1
#: WIK_V_1:774
msgctxt "text_id=23741 | speaker=unknown"
msgid "  I was mistaken."
msgstr "　わたしは間違えていた。"

#. Occurrence WIK_V_1:779:23742: scene=WIK_V_1
#: WIK_V_1:779
msgctxt "text_id=23742 | speaker=unknown"
msgid "  The game was still on."
msgstr "　まだゲームは続いている。"

#. Occurrence WIK_V_1:784:23743: scene=WIK_V_1
#: WIK_V_1:784
msgctxt "text_id=23743 | speaker=unknown"
msgid "  If that was true, then Sweets Hearts had won."
msgstr "　このままだとスイーツハーツ完全勝利。"

#. Occurrence WIK_V_1:815:23744: scene=WIK_V_1
#: WIK_V_1:815
msgctxt "text_id=23744 | speaker=unknown"
msgid "  Sizuki was the killer. I was sure of it!"
msgstr "　犯人は静希だった。それは間違いない。"

#. Occurrence WIK_V_1:820:23745: scene=WIK_V_1
#: WIK_V_1:820
msgctxt "text_id=23745 | speaker=unknown"
msgid "  I'd said it out loud, and I was still alive, wasn't I?"
msgstr "　だってそう口にした、わたしがまだ生きている。"

#. Occurrence WIK_V_1:869:23746: scene=WIK_V_1
#: WIK_V_1:869
msgctxt "text_id=23746 | speaker=unknown"
msgid "  Remember the rules:"
msgstr "　ルールを思い出せ。"

#. Occurrence WIK_V_1:874:23747: scene=WIK_V_1
#: WIK_V_1:874
msgctxt "text_id=23747 | speaker=unknown"
msgid "  If you accuse someone and you're wrong, you die."
msgstr "　犯人を告訴しても、間違えていたら死ぬ。"

#. Occurrence WIK_V_1:879:23748: scene=WIK_V_1
#: WIK_V_1:879
msgctxt "text_id=23748 | speaker=unknown"
msgid "  As long as I was still alive, Sizuki had to be the killer."
msgstr "　わたしは生きている以上、静希犯人説は正しい筈だ。"

#. Occurrence WIK_V_1:884:23749: scene=WIK_V_1
#: WIK_V_1:884
msgctxt "text_id=23749 | speaker=unknown"
msgid "  Was I wrong? *Was I missing something?!*"
msgstr "　間違えていないのなら―――きっと、<何|・><か|・><が|・><足|・><り|・><な|・><い|・><ん|・><だ|・>！"

#. Occurrence WIK_V_1:922:23750: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_V_1_0006; voice_prefix=B10; voice_category=5; scene=WIK_V_1
#: WIK_V_1:922
msgctxt "text_id=23750 | speaker=kojika"
msgid "\"My guess about the killer..."
msgstr "「さっきの犯人当て―――"

#. Occurrence WIK_V_1:928:23751: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_V_1_0007; voice_prefix=B10; voice_category=5; scene=WIK_V_1
#: WIK_V_1:928
msgctxt "text_id=23751 | speaker=kojika"
msgid "  It must have been a hint! Think! How did things come to this...?!\""
msgstr "　あれがヒントなのは間違いない……！　考えるんだ、順序だてて、そもそも何が原因なのか……！」"

#. Occurrence WIK_V_1:949:23752: scene=WIK_V_1
#: WIK_V_1:949
msgctxt "text_id=23752 | speaker=unknown"
msgid "  I heard footsteps getting louder."
msgstr "　足音が近づいてくる。"

#. Occurrence WIK_V_1:954:23753: scene=WIK_V_1
#: WIK_V_1:954
msgctxt "text_id=23753 | speaker=unknown"
msgid "  Morning was almost here."
msgstr "　朝が近づいている。"

#. Occurrence WIK_V_1:959:23754: scene=WIK_V_1
#: WIK_V_1:959
msgctxt "text_id=23754 | speaker=unknown"
msgid "  This is my last and only chance."
msgstr "　これが正真正銘、最後のチャンス。"

#. Occurrence WIK_V_1:966:23755: scene=WIK_V_1
#: WIK_V_1:966
msgctxt "text_id=23755 | speaker=unknown"
msgid "  I..."
msgstr "　わたしは、"

#. Occurrence WIK_SELECT_W:8:23756: scene=WIK_SELECT_W
#: WIK_SELECT_W:8
msgctxt "text_id=23756 | speaker=unknown"
msgid "-Decision W-"
msgstr "～選択肢Ｗ～"

#. Occurrence WIK_V_2:41:23757: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_V_2_0000; voice_prefix=B10; voice_category=5; scene=WIK_V_2
#: WIK_V_2:41
msgctxt "text_id=23757 | speaker=kojika"
msgid "\"It's no use. There's not enough evidence..."
msgstr "「だめ、根拠が薄い……"

#. Occurrence WIK_V_2:41:23758: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_V_2_0000; voice_prefix=B10; voice_category=5; scene=WIK_V_2
#: WIK_V_2:41
msgctxt "text_id=23758 | speaker=kojika"
msgid "  If I guess wrong, I'm done for...\""
msgstr "　これで指摘したら、わたしがアウトだ……」"

#. Occurrence WIK_V_2:73:23759: scene=WIK_V_2
#: WIK_V_2:73
msgctxt "text_id=23759 | speaker=unknown"
msgid "  I didn't know who the killer was."
msgstr "　犯人を特定できない。"

#. Occurrence WIK_V_2:78:23760: scene=WIK_V_2
#: WIK_V_2:78
msgctxt "text_id=23760 | speaker=unknown"
msgid "  But we were the only ones left in the mansion."
msgstr "　もう洋館にはわたしと真犯人しかいない。"

#. Occurrence WIK_V_2:83:23761: scene=WIK_V_2
#: WIK_V_2:83
msgctxt "text_id=23761 | speaker=unknown"
msgid "  If I made a random guess and ended up being eliminated, I was finished."
msgstr "　当てずっぽうで指名して、わたしが消えてしまったらすべてが終わってしまうのだ。"

#. Occurrence WIK_V_2:88:23762: scene=WIK_V_2
#: WIK_V_2:88
msgctxt "text_id=23762 | speaker=unknown"
msgid "  In that case, maybe I should just make a run for it, and win the game that way...?"
msgstr "　そんなコトになるのなら、このまま逃げ切ってゲームクリアを目指した方がよっぽど現実、的だ―――？"

#. Occurrence WIK_V_2:128:23763: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_V_2_0001; voice_prefix=B10; voice_category=5; scene=WIK_V_2
#: WIK_V_2:128
msgctxt "text_id=23763 | speaker=kojika"
msgid "\"You...\""
msgstr "「―――あなた、は―――」"

#. Occurrence WIK_V_2:134:23764: scene=WIK_V_2
#: WIK_V_2:134
msgctxt "text_id=23764 | speaker=unknown"
msgid "  A shadowy figure crept up behind me."
msgstr "　わたしの背後に忍び寄っていた影。"

#. Occurrence WIK_V_2:139:23765: scene=WIK_V_2
#: WIK_V_2:139
msgctxt "text_id=23765 | speaker=unknown"
msgid "  It raised its hand as if to say hello."
msgstr "　そいつは朝の挨拶をするように「やあ」と手を挙げて、"

#. Occurrence WIK_V_2:188:23766: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_V_2_0000; voice_prefix=A30; voice_category=3; scene=WIK_V_2
#: WIK_V_2:188
msgctxt "text_id=23766 | speaker=soujuurou"
msgid "\"I"
msgstr "「ワ"

msgctxt "text_id=23767 | speaker=unknown"
msgid " aM"
msgstr "レ"

msgctxt "text_id=23768 | speaker=unknown"
msgid " An"
msgstr "ワ"

msgctxt "text_id=23769 | speaker=unknown"
msgid " AlieN"
msgstr "レ"

msgctxt "text_id=23770 | speaker=unknown"
msgid " FrOM"
msgstr "ハ　"

msgctxt "text_id=23771 | speaker=unknown"
msgid " OuTeR"
msgstr "宇"

msgctxt "text_id=23772 | speaker=unknown"
msgid " SpAcE,"
msgstr "宙"

msgctxt "text_id=23773 | speaker=unknown"
msgid " EarTH"
msgstr "人　"

msgctxt "text_id=23774 | speaker=unknown"
msgid " CREatuRE.\""
msgstr "ダ」"

#. Occurrence WIK_V_2:240:23775: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_V_2_0002; voice_prefix=B10; voice_category=5; scene=WIK_V_2
#: WIK_V_2:240
msgctxt "text_id=23775 | speaker=kojika"
msgid "\"Pfft!\""
msgstr "「ぶっ……！」"

#. Occurrence WIK_V_2:245:23776: scene=WIK_V_2
#: WIK_V_2:245
msgctxt "text_id=23776 | speaker=unknown"
msgid "  The primitive directness of his greeting caught me off guard."
msgstr "　あまりにも原始的、かつ直接的な手段で、わたしの感性を揺らしやがった。"

#. Occurrence WIK_V_2:316:23777: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_V_2_0003; voice_prefix=B10; voice_category=5; scene=WIK_V_2
#: WIK_V_2:316
msgctxt "text_id=23777 | speaker=kojika"
msgid "\"Sizuki?! You're the killer?!\""
msgstr "「静希……！　あ、あんたが犯人だったの……！？」"

#. Occurrence WIK_V_2:324:23778: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_V_2_0001; voice_prefix=A30; voice_category=3; scene=WIK_V_2
#: WIK_V_2:324
msgctxt "text_id=23778 | speaker=soujuurou"
msgid "\"YeS."
msgstr "「ソウダ。"

msgctxt "text_id=23779 | speaker=unknown"
msgid " wE dID iT."
msgstr "ワレワレハ　"

msgctxt "text_id=23780 | speaker=unknown"
msgid " We DId It."
msgstr "ヤッタゼ　"

msgctxt "text_id=23781 | speaker=unknown"
msgid " WE DiD iT.\""
msgstr "ヤッタゼ」"

#. Occurrence WIK_V_2:338:23782: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_V_2_0004; voice_prefix=B10; voice_category=5; scene=WIK_V_2
#: WIK_V_2:338
msgctxt "text_id=23782 | speaker=kojika"
msgid "\"You can cut that voice out now.\""
msgstr "「いや、その演技はいいから」"

#. Occurrence WIK_V_2:386:23783: scene=WIK_V_2
#: WIK_V_2:386
msgctxt "text_id=23783 | speaker=unknown"
msgid "  I struggled to inject calm into my voice, and to keep my arms and legs from shaking."
msgstr "　手足のしびれを気合いで押さえ込んで、間抜けメガネにツッコミを入れる。"

#. Occurrence WIK_V_2:391:23784: scene=WIK_V_2
#: WIK_V_2:391
msgctxt "text_id=23784 | speaker=unknown"
msgid "  That voice really was something."
msgstr "　確かにアレは凄い。"

#. Occurrence WIK_V_2:396:23785: scene=WIK_V_2
#: WIK_V_2:396
msgctxt "text_id=23785 | speaker=unknown"
msgid "  So much that I was more concerned with making it stop than whodunits or howdunits."
msgstr "　ここに至ってＷＨＷへの疑問より、あのしゃべり方をやめさせる方を優先させるぐらいなんだから。"

#. Occurrence WIK_V_2:435:23786: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_V_2_0002; voice_prefix=A30; voice_category=3; scene=WIK_V_2
#: WIK_V_2:435
msgctxt "text_id=23786 | speaker=soujuurou"
msgid "\"..."
msgstr "「――――"

msgctxt "text_id=23787 | speaker=unknown"
msgid " wE"
msgstr "ワレワレハ　"

msgctxt "text_id=23788 | speaker=unknown"
msgid " aRe"
msgstr "火星人　"

msgctxt "text_id=23789 | speaker=unknown"
msgid " MarTIAnS.\""
msgstr "ダ」"

#. Occurrence WIK_V_2:447:23790: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_V_2_0005; voice_prefix=B10; voice_category=5; scene=WIK_V_2
#: WIK_V_2:447
msgctxt "text_id=23790 | speaker=kojika"
msgid "\"I don't care."
msgstr "「そういう話でもなくて。"

#. Occurrence WIK_V_2:454:23791: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_V_2_0006; voice_prefix=B10; voice_category=5; scene=WIK_V_2
#: WIK_V_2:454
msgctxt "text_id=23791 | speaker=kojika"
msgid "Just explain what's going on already."
msgstr "いいからまじめに話せバカ。"

#. Occurrence WIK_V_2:460:23792: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_V_2_0007; voice_prefix=B10; voice_category=5; scene=WIK_V_2
#: WIK_V_2:460
msgctxt "text_id=23792 | speaker=kojika"
msgid "  I already laughed, so I'm going to die. I'd at least like to know what's going on before I do.\""
msgstr "　わたし、笑っちゃったからもうすぐ死ぬのよ。せめて最期に、どうしてこうなったのかをブチまけて」"

#. Occurrence WIK_V_2:495:23793: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_V_2_0003; voice_prefix=A30; voice_category=3; scene=WIK_V_2
#: WIK_V_2:495
msgctxt "text_id=23793 | speaker=soujuurou"
msgid "\"Sorry, but I can't do that."
msgstr "「すまないが、それは説明できない。"

#. Occurrence WIK_V_2:501:23794: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_V_2_0004; voice_prefix=A30; voice_category=3; scene=WIK_V_2
#: WIK_V_2:501
msgctxt "text_id=23794 | speaker=soujuurou"
msgid "  I can only discuss my own situation.\""
msgstr "　俺が話せるのは俺の事情だけだからだ」"

#. Occurrence WIK_V_2:507:23795: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_V_2_0008; voice_prefix=B10; voice_category=5; scene=WIK_V_2
#: WIK_V_2:507
msgctxt "text_id=23795 | speaker=kojika"
msgid "\"?\""
msgstr "「？」"

#. Occurrence WIK_V_2:512:23796: scene=WIK_V_2
#: WIK_V_2:512
msgctxt "text_id=23796 | speaker=unknown"
msgid "  What was that supposed to mean?"
msgstr "　それはどういう意味だったのか。"

#. Occurrence WIK_V_2:517:23797: scene=WIK_V_2
#: WIK_V_2:517
msgctxt "text_id=23797 | speaker=unknown"
msgid "  Sizuki could only talk about himself."
msgstr "　静希が話せるのは静希の理由だけ。"

#. Occurrence WIK_V_2:522:23798: scene=WIK_V_2
#: WIK_V_2:522
msgctxt "text_id=23798 | speaker=unknown"
msgid "  Does that mean... there was someone else...?"
msgstr "　それは、つまり―――静希の他に―――"

#. Occurrence WIK_V_2:549:23799: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_V_2_0005; voice_prefix=A30; voice_category=3; scene=WIK_V_2
#: WIK_V_2:549
msgctxt "text_id=23799 | speaker=soujuurou"
msgid "\"You've got to understand, Kumari."
msgstr "「久万梨。君に分かるだろうか。"

#. Occurrence WIK_V_2:561:23800: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_V_2_0006; voice_prefix=A30; voice_category=3; scene=WIK_V_2
#: WIK_V_2:561
msgctxt "text_id=23800 | speaker=soujuurou"
msgid "  Can you imagine a whole year of being picked on again and again for having no sense of humor?"
msgstr "　一年間、ひたすら“冗談のセンスがない”と言われ続けた男の気持ちが。"

#. Occurrence WIK_V_2:573:23801: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_V_2_0007; voice_prefix=A30; voice_category=3; scene=WIK_V_2
#: WIK_V_2:573
msgctxt "text_id=23801 | speaker=soujuurou"
msgid "  How it feels for a man to muster up the courage to liven the party mood, only to be shot down?\""
msgstr "　パーティーを盛り上げようと勇気を振り絞るたびに、お呼びじゃない、と突っ返される男の気持ちが」"

#. Occurrence WIK_V_2:579:23802: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_V_2_0009; voice_prefix=B10; voice_category=5; scene=WIK_V_2
#: WIK_V_2:579
msgctxt "text_id=23802 | speaker=kojika"
msgid "\"I know how it feels to want to punch you right now.\""
msgstr "「よし分かった、ブン殴る」"

#. Occurrence WIK_V_2:606:23803: scene=WIK_V_2
#: WIK_V_2:606
msgctxt "text_id=23803 | speaker=unknown"
msgid "  I didn't even want to think about this anymore, but did he seriously do all this to prove he has a sense of humor?"
msgstr "　もう真剣に考えたくもないが、コイツの動機は“冗談センスの証明”だった。"

#. Occurrence WIK_V_2:611:23804: scene=WIK_V_2
#: WIK_V_2:611
msgctxt "text_id=23804 | speaker=unknown"
msgid "  I'd say he failed the moment he put on that ridiculous disguise, but was that any reason to help a murderer?!"
msgstr "　あの鼻メガネの段階で証明は失敗しているが、とにかく、この男はそんな理由で真犯人に手を貸していたのだっ！"

#. Occurrence WIK_V_2:632:23805: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_V_2_0010; voice_prefix=B10; voice_category=5; scene=WIK_V_2
#: WIK_V_2:632
msgctxt "text_id=23805 | speaker=kojika"
msgid "\"The only people who'd laugh at something like that are Aozaki and Miss Kuonji."
msgstr "「でも、それで笑うのは蒼崎と久遠寺さんぐらいよ。"

#. Occurrence WIK_V_2:638:23806: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_V_2_0011; voice_prefix=B10; voice_category=5; scene=WIK_V_2
#: WIK_V_2:638
msgctxt "text_id=23806 | speaker=kojika"
msgid "  No one else on this planet would.\""
msgstr "　そんな一発芸で笑う文明人が、他にいるハズがない」"

#. Occurrence WIK_V_2:651:23807: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_V_2_0008; voice_prefix=A30; voice_category=3; scene=WIK_V_2
#: WIK_V_2:651
msgctxt "text_id=23807 | speaker=soujuurou"
msgid "\"No one but you.\""
msgstr "「いや、でも、久万梨は」"

#. Occurrence WIK_V_2:657:23808: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_V_2_0012; voice_prefix=B10; voice_category=5; scene=WIK_V_2
#: WIK_V_2:657
msgctxt "text_id=23808 | speaker=kojika"
msgid "\"Oh, I'm gonna hit you.\""
msgstr "「ほんっとにブン殴るわよ」"

#. Occurrence WIK_V_2:669:23809: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_V_2_0009; voice_prefix=A30; voice_category=3; scene=WIK_V_2
#: WIK_V_2:669
msgctxt "text_id=23809 | speaker=soujuurou"
msgid "\"I'm sorry. Never mind.\""
msgstr "「ごめんなさい、なんでもないです」"

#. Occurrence WIK_V_2:690:23810: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_V_2_0013; voice_prefix=B10; voice_category=5; scene=WIK_V_2
#: WIK_V_2:690
msgctxt "text_id=23810 | speaker=kojika"
msgid "\"So..."
msgstr "「……あれでしょ。"

#. Occurrence WIK_V_2:690:23811: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_V_2_0013; voice_prefix=B10; voice_category=5; scene=WIK_V_2
#: WIK_V_2:690
msgctxt "text_id=23811 | speaker=kojika"
msgid "  ...it was Aozaki's photo that made Tsukiji and the others laugh, wasn't it?\""
msgstr "　槻司たちを笑わせたのは、蒼崎の写真でしょ？」"

#. Occurrence WIK_V_2:702:23812: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_V_2_0010; voice_prefix=A30; voice_category=3; scene=WIK_V_2
#: WIK_V_2:702
msgctxt "text_id=23812 | speaker=soujuurou"
msgid "\"Yeah. That was the ace up my sleeve."
msgstr "「そうだ。あれこそ切り札だ。"

#. Occurrence WIK_V_2:708:23813: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_V_2_0011; voice_prefix=A30; voice_category=3; scene=WIK_V_2
#: WIK_V_2:708
msgctxt "text_id=23813 | speaker=soujuurou"
msgid "  And a treat for me, too.\""
msgstr "　同時に、それは俺への報酬でもある」"

#. Occurrence WIK_V_2:728:23814: scene=WIK_V_2
#: WIK_V_2:728
msgctxt "text_id=23814 | speaker=unknown"
msgid "  Any of the guys who knew Aozaki would laugh at that picture of her."
msgstr "　あの写真。蒼崎の痴態を撮ったアレなら、蒼崎を知っている男連中は笑ってしまう。"

#. Occurrence WIK_V_2:733:23815: scene=WIK_V_2
#: WIK_V_2:733
msgctxt "text_id=23815 | speaker=unknown"
msgid "  Particularly Mr. Yamasiro, Tsukiji, and Father Eiri."
msgstr "　とくに山城先生と槻司、詠梨神父にとってはガード不能の攻撃だったに違いない。"

#. Occurrence WIK_V_2:740:23816: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_V_2_0014; voice_prefix=B10; voice_category=5; scene=WIK_V_2
#: WIK_V_2:740
msgctxt "text_id=23816 | speaker=kojika"
msgid "\"So that means the killer must be...\""
msgstr "「つまり、犯人は―――」"

#. Occurrence WIK_V_2:805:23817: scene=WIK_V_2
#: WIK_V_2:805
msgctxt "text_id=23817 | speaker=unknown"
msgid "  I tried to speak, but the words didn't come out."
msgstr "　口にしようとした喉が、ざらりと崩れ去る。"

#. Occurrence WIK_V_2:825:23818: scene=WIK_V_2
#: WIK_V_2:825
msgctxt "text_id=23818 | speaker=unknown"
msgid "  I'd played right into Sweets Hearts's hands."
msgstr "　すべてはスイーツハーツの思惑通り。"

#. Occurrence WIK_V_2:830:23819: scene=WIK_V_2
#: WIK_V_2:830
msgctxt "text_id=23819 | speaker=unknown"
msgid "  The killer―Sizuki―was the last person left standing, while I'd failed to guess correctly and just stood here, mind blank."
msgstr "　犯人である静希は最後まで残り、犯人当ては失敗し、わたしはここで真っ白になる。"

#. Occurrence WIK_V_2:850:23820: scene=WIK_V_2
#: WIK_V_2:850
msgctxt "text_id=23820 | speaker=unknown"
msgid "  I was just one step away..."
msgstr "　―――あともう一歩。"

#. Occurrence WIK_V_2:855:23821: scene=WIK_V_2
#: WIK_V_2:855
msgctxt "text_id=23821 | speaker=unknown"
msgid "  I'd almost figured it all out."
msgstr "　あともう少しで元凶にたどり着いたのに。"

#. Occurrence WIK_V_2:860:23822: scene=WIK_V_2
#: WIK_V_2:860
msgctxt "text_id=23822 | speaker=unknown"
msgid "  If I'd just focused more in the evening..."
msgstr "　夕方からこっち、もっとまじめに、"

#. Occurrence WIK_V_2:865:23823: scene=WIK_V_2
#: WIK_V_2:865
msgctxt "text_id=23823 | speaker=unknown"
msgid "  ...and thought it through a bit more..."
msgstr "　正しい推理を重ねていれば―――"

#. Occurrence WIK_W_35:29:23824: scene=WIK_W_35
#: WIK_W_35:29
msgctxt "text_id=23824 | speaker=unknown"
msgid "  ...There had to be two."
msgstr "　―――二つ。"

#. Occurrence WIK_W_35:35:23825: scene=WIK_W_35
#: WIK_W_35:35
msgctxt "text_id=23825 | speaker=unknown"
msgid "  Yeah, two."
msgstr "　そうだ、二つなんだ、とわたしは思った。"

#. Occurrence WIK_W_35:55:23826: scene=WIK_W_35
#: WIK_W_35:55
msgctxt "text_id=23826 | speaker=unknown"
msgid "  It was impossible to explain some things if there was only one method."
msgstr "　一つだと、ひとりだと考えるから無理が生じる。"

#. Occurrence WIK_W_35:60:23827: scene=WIK_W_35
#: WIK_W_35:60
msgctxt "text_id=23827 | speaker=unknown"
msgid "  But what if there were two?"
msgstr "　でも二つならどうだろう？"

#. Occurrence WIK_W_35:80:23828: scene=WIK_W_35
#: WIK_W_35:80
msgctxt "text_id=23828 | speaker=unknown"
msgid "  First, to consider the nature of the murders."
msgstr "　まず殺人の種類。"

#. Occurrence WIK_W_35:85:23829: scene=WIK_W_35
#: WIK_W_35:85
msgctxt "text_id=23829 | speaker=unknown"
msgid "  They could be divided up into the times the killer made the victim laugh,"
msgstr "　明確に、“犯人”によって笑わされた場合と、"

#. Occurrence WIK_W_35:90:23830: scene=WIK_W_35
#: WIK_W_35:90
msgctxt "text_id=23830 | speaker=unknown"
msgid "  and times when the victim saw a dead body and laughed."
msgstr "　死体を見て笑ってしまった場合とに分かれる。"

#. Occurrence WIK_W_35:110:23831: scene=WIK_W_35
#: WIK_W_35:110
msgctxt "text_id=23831 | speaker=unknown"
msgid "  Housuke, Riddell, and Sister Yuika fell under the latter self-destructive category,"
msgstr "　芳助、リデル、唯架さんが“自爆”組だ。"

#. Occurrence WIK_W_35:115:23832: scene=WIK_W_35
#: WIK_W_35:115
msgctxt "text_id=23832 | speaker=unknown"
msgid "  but it might have applied to another victim, too,"
msgstr "　けどもうひとり、自爆組に含まれそうなヤツがいる。"

#. Occurrence WIK_W_35:122:23833: scene=WIK_W_35
#: WIK_W_35:122
msgctxt "text_id=23833 | speaker=unknown"
msgid "  ...Beo."
msgstr "　―――ベオだ。"

#. Occurrence WIK_W_35:170:23834: scene=WIK_W_35
#: WIK_W_35:170
msgctxt "text_id=23834 | speaker=unknown"
msgid "  Beo died outside the sunroom after he laughed,"
msgstr "　ベオはサンルームの外で笑ってしまい、死亡した。"

#. Occurrence WIK_W_35:175:23835: scene=WIK_W_35
#: WIK_W_35:175
msgctxt "text_id=23835 | speaker=unknown"
msgid "  but there was nothing in the sunroom that could've made him laugh."
msgstr "　けどサンルームにはアイツが笑う要因なんて一つもない。"

#. Occurrence WIK_W_35:180:23836: scene=WIK_W_35
#: WIK_W_35:180
msgctxt "text_id=23836 | speaker=unknown"
msgid "  It was unlikely anything had been set up in the forest,"
msgstr "　周囲の森に何か仕掛けられていた、とも考えづらい。"

#. Occurrence WIK_W_35:185:23837: scene=WIK_W_35
#: WIK_W_35:185
msgctxt "text_id=23837 | speaker=unknown"
msgid "  not when the weather was so bad."
msgstr "　あの嵐の中、外にトラップをしかけるのは不確実だからだ。"

#. Occurrence WIK_W_35:206:23838: scene=WIK_W_35
#: WIK_W_35:206
msgctxt "text_id=23838 | speaker=unknown"
msgid "  So, the trap must have been laid inside,"
msgstr "　となると、やはり罠は室内に仕掛けられていた。"

#. Occurrence WIK_W_35:211:23839: scene=WIK_W_35
#: WIK_W_35:211
msgctxt "text_id=23839 | speaker=unknown"
msgid "  but not in the sunroom."
msgstr "　サンルームにはない。"

#. Occurrence WIK_W_35:216:23840: scene=WIK_W_35
#: WIK_W_35:216
msgctxt "text_id=23840 | speaker=unknown"
msgid "  What about above the sunroom, on the second floor?"
msgstr "　じゃあサンルームの<上|・>、二階の部屋はどうだろう？"

#. Occurrence WIK_W_35:256:23841: scene=WIK_W_35
#: WIK_W_35:256
msgctxt "text_id=23841 | speaker=unknown"
msgid "  Aozaki's bedroom was directly above the sunroom."
msgstr "　サンルームの上は蒼崎の部屋。"

#. Occurrence WIK_W_35:261:23842: scene=WIK_W_35
#: WIK_W_35:261
msgctxt "text_id=23842 | speaker=unknown"
msgid "  Maybe someone had asked Beo to look into Aozaki's room from the outside."
msgstr "　ベオは何者かに「外から蒼崎の部屋を調べてほしい」と頼まれたのではないか？"

#. Occurrence WIK_W_35:266:23843: scene=WIK_W_35
#: WIK_W_35:266
msgctxt "text_id=23843 | speaker=unknown"
msgid "  And then, Beo had seen something:"
msgstr "　そうして、ベオは外からあの部屋を見てしまった。"

#. Occurrence WIK_W_35:271:23844: scene=WIK_W_35
#: WIK_W_35:271
msgctxt "text_id=23844 | speaker=unknown"
msgid "  Touko out of her mind, dead drunk."
msgstr "　蒼崎橙子がヘベレケになっている姿を。"

#. Occurrence WIK_W_35:317:23845: scene=WIK_W_35
#: WIK_W_35:317
msgctxt "text_id=23845 | speaker=unknown"
msgid "  Beo knew Touko well."
msgstr "　ベオは蒼崎姉を知っている素振りだった。"

#. Occurrence WIK_W_35:329:23846: scene=WIK_W_35
#: WIK_W_35:329
msgctxt "text_id=23846 | speaker=unknown"
msgid "There was definitely a chance he'd laugh if he saw her like that."
msgstr "見知った人間のあんな姿を見たら、つい笑ってしまう公算が高い。"

#. Occurrence WIK_W_35:334:23847: scene=WIK_W_35
#: WIK_W_35:334
msgctxt "text_id=23847 | speaker=unknown"
msgid "  It was ingenious, as traps went."
msgstr "　トラップとしては優秀だ。"

#. Occurrence WIK_W_35:339:23848: scene=WIK_W_35
#: WIK_W_35:339
msgctxt "text_id=23848 | speaker=unknown"
msgid "  Either way, even if he didn't laugh, the person who asked him simply told him to check, so they wouldn't seem suspicious."
msgstr "　なにしろベオが笑わなくても、「調べて欲しい」と言った人物に疑いはかからない。"

#. Occurrence WIK_W_35:344:23849: scene=WIK_W_35
#: WIK_W_35:344
msgctxt "text_id=23849 | speaker=unknown"
msgid "  It would only make people suspect Aozaki sooner."
msgstr "　蒼崎に不審の目が向けられるターンが早まるだけなのだから。"

#. Occurrence WIK_W_35:379:23850: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_W_35_0000; voice_prefix=B10; voice_category=5; scene=WIK_W_35
#: WIK_W_35:379
msgctxt "text_id=23850 | speaker=kojika"
msgid "\"...So there are two M.O.s."
msgstr "「……殺害方法は二種類あったんだ。"

#. Occurrence WIK_W_35:385:23851: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_W_35_0001; voice_prefix=B10; voice_category=5; scene=WIK_W_35
#: WIK_W_35:385
msgctxt "text_id=23851 | speaker=kojika"
msgid "  A direct method, and a secondary method that uses the victims."
msgstr "　犯人による直接的な方法と、その後の、犠牲者を利用した二次災害。"

#. Occurrence WIK_W_35:391:23852: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_W_35_0002; voice_prefix=B10; voice_category=5; scene=WIK_W_35
#: WIK_W_35:391
msgctxt "text_id=23852 | speaker=kojika"
msgid "  Similarly...\""
msgstr "　それと同じように―――」"

#. Occurrence WIK_W_35:411:23853: scene=WIK_W_35
#: WIK_W_35:411
msgctxt "text_id=23853 | speaker=unknown"
msgid "  There were two killers."
msgstr "　このゲームには、<共|・><犯|・><者|・><が|・><い|・><る|・>。"

#. Occurrence WIK_W_35:416:23854: scene=WIK_W_35
#: WIK_W_35:416
msgctxt "text_id=23854 | speaker=unknown"
msgid "  Riddell's suggestions."
msgstr "　リデルの台詞。"

#. Occurrence WIK_W_35:421:23855: scene=WIK_W_35
#: WIK_W_35:421
msgctxt "text_id=23855 | speaker=unknown"
msgid "  Tsukiji's suspicions."
msgstr "　槻司の疑問。"

#. Occurrence WIK_W_35:447:23856: scene=WIK_W_35
#: WIK_W_35:447
msgctxt "text_id=23856 | speaker=unknown"
msgid "  Teams of two. Intimate betrayal―two minds, one body."
msgstr "　二人一組、二心同体。"

#. Occurrence WIK_W_35:452:23857: scene=WIK_W_35
#: WIK_W_35:452
msgctxt "text_id=23857 | speaker=unknown"
msgid "  Sweets Hearts, the prayer Ploy Kickshaw."
msgstr "　願掛けのプロイキッシャー、スイーツハーツ。"

#. Occurrence WIK_W_35:457:23858: scene=WIK_W_35
#: WIK_W_35:457
msgctxt "text_id=23858 | speaker=unknown"
msgid "  In retrospect, it was such a revealing name."
msgstr "　ああ、なんて露骨な名前だろう。"

#. Occurrence WIK_W_35:462:23859: scene=WIK_W_35
#: WIK_W_35:462
msgctxt "text_id=23859 | speaker=unknown"
msgid "  If \"sweet\" referred to its pudding body, then what about \"heart\"?"
msgstr "　スイーツが<本体|プリン>なら、ハーツは何を示している？"

#. Occurrence WIK_W_35:483:23860: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_W_35_0003; voice_prefix=B10; voice_category=5; scene=WIK_W_35
#: WIK_W_35:483
msgctxt "text_id=23860 | speaker=kojika"
msgid "\"Humans. The enemy can take on multiple forms!\""
msgstr "「人間だ。敵は複数形だった―――！」"

#. Occurrence WIK_W_35:500:23861: scene=WIK_W_35
#: WIK_W_35:500
msgctxt "text_id=23861 | speaker=unknown"
msgid "  That meant there were *two* Sweets Hearts."
msgstr "　だとしたら、スイーツハーツは二人いる。"

#. Occurrence WIK_W_35:505:23862: scene=WIK_W_35
#: WIK_W_35:505
msgctxt "text_id=23862 | speaker=unknown"
msgid "  In this game, the killer and prime suspect had to be separate people!"
msgstr "　このゲームにおいて、実行犯と人物Ａは別人なんだ……！"

#. Occurrence WIK_W_35:525:23863: scene=WIK_W_35
#: WIK_W_35:525
msgctxt "text_id=23863 | speaker=unknown"
msgid "  The prime suspect used a Ploy,"
msgstr "　プロイを使用した人物Ａ。"

#. Occurrence WIK_W_35:530:23864: scene=WIK_W_35
#: WIK_W_35:530
msgctxt "text_id=23864 | speaker=unknown"
msgid "  while their accomplice carried out the killings."
msgstr "　そして、それに協力している実行犯。"

#. Occurrence WIK_W_35:539:23865: scene=WIK_W_35
#: WIK_W_35:539
msgctxt "text_id=23865 | speaker=unknown"
msgid "  Sizuki merely played the role of the suspect."
msgstr "　静希はその協力者、実行犯にすぎない。"

#. Occurrence WIK_W_35:544:23866: scene=WIK_W_35
#: WIK_W_35:544
msgctxt "text_id=23866 | speaker=unknown"
msgid "  I had guessed correctly, but I hadn't seen the full picture."
msgstr "　当たっていたけど正解じゃない。"

#. Occurrence WIK_W_35:549:23867: scene=WIK_W_35
#: WIK_W_35:549
msgctxt "text_id=23867 | speaker=unknown"
msgid "  That must be why I wasn't out of the woods yet, so to speak."
msgstr "　わたしが消えなかったのはそういう理屈に違いない。"

#. Occurrence WIK_W_35:608:23868: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_W_35_0004; voice_prefix=B10; voice_category=5; scene=WIK_W_35
#: WIK_W_35:608
msgctxt "text_id=23868 | speaker=kojika"
msgid "\"Wait. Hold on. Wait one stir-fired second!"
msgstr "「待て―――待って、待って待って待って……！"

#. Occurrence WIK_W_35:614:23869: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_W_35_0005; voice_prefix=B10; voice_category=5; scene=WIK_W_35
#: WIK_W_35:614
msgctxt "text_id=23869 | speaker=kojika"
msgid "  The answer is obvious, now! I just need to solve one problem!\""
msgstr "　それならもう答えは明白、後は、ほら、あの問題を検証すればいいだけだ……！」"

#. Occurrence WIK_W_35:620:23870: scene=WIK_W_35
#: WIK_W_35:620
msgctxt "text_id=23870 | speaker=unknown"
msgid "  I..."
msgstr "　わたしは、"

#. Occurrence WIK_SELECT_X:8:23871: scene=WIK_SELECT_X
#: WIK_SELECT_X:8
msgctxt "text_id=23871 | speaker=unknown"
msgid "-Decision X-"
msgstr "～選択肢Ｘ～"

#. Occurrence WIK_WAKEUP:90:23872: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_WAKEUP_0000; voice_prefix=B10; voice_category=5; scene=WIK_WAKEUP
#: WIK_WAKEUP:90
msgctxt "text_id=23872 | speaker=kojika"
msgid "\"All right.\""
msgstr "「よし」"

#. Occurrence WIK_WAKEUP:95:23873: scene=WIK_WAKEUP
#: WIK_WAKEUP:95
msgctxt "text_id=23873 | speaker=unknown"
msgid "  Fifteen-minute nap done! I checked myself in the mirror."
msgstr "　きっかり十五分で目を覚まして、姿見で全身をチェック。"

#. Occurrence WIK_WAKEUP:100:23874: scene=WIK_WAKEUP
#: WIK_WAKEUP:100
msgctxt "text_id=23874 | speaker=unknown"
msgid "  I took a hairbrush out of my bag, quickly brushed my hair, and left the room."
msgstr "　荷物からブラシを取り出して、軽く髪をとかして客室を出た。"

#. Occurrence WIK_WAKEUP:143:23875: scene=WIK_WAKEUP
#: WIK_WAKEUP:143
msgctxt "text_id=23875 | speaker=unknown"
msgid "  As I locked the door behind me, I heard an unfamiliar voice coming from downstairs."
msgstr "　部屋に鍵をかけていると、一階の方から何やら聞き慣れない声が聞こえてきた。"

#. Occurrence WIK_WAKEUP:148:23876: scene=WIK_WAKEUP
#: WIK_WAKEUP:148
msgctxt "text_id=23876 | speaker=unknown"
msgid "  A new guest?"
msgstr "　新しいゲストだろうか？"

#. Occurrence WIK_WAKEUP:153:23877: scene=WIK_WAKEUP
#: WIK_WAKEUP:153
msgctxt "text_id=23877 | speaker=unknown"
msgid "  I didn't hear a peep until I left the guest room... it must have had great soundproofing."
msgstr "　廊下では聞こえて、部屋の中では聞こえなかった……部屋の防音はしっかりしている、という事だ。"

#. Occurrence WIK_WAKEUP:229:23878: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_WAKEUP_0000; voice_prefix=B40; voice_category=8; scene=WIK_WAKEUP
#: WIK_WAKEUP:229
msgctxt "text_id=23878 | speaker=eiri"
msgid "\"It's really coming down out there."
msgstr "「いやあ、降ってきましたねぇ。"

#. Occurrence WIK_WAKEUP:235:23879: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_WAKEUP_0001; voice_prefix=B40; voice_category=8; scene=WIK_WAKEUP
#: WIK_WAKEUP:235
msgctxt "text_id=23879 | speaker=eiri"
msgid "  I thought it was supposed to be clear skies all through the long weekend, but I guess we couldn't be that lucky.\""
msgstr "　連休中は晴れるという話でしたが、二日目からこれとは我々もついていない」"

#. Occurrence WIK_WAKEUP:247:23880: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_WAKEUP_0000; voice_prefix=B20; voice_category=10; scene=WIK_WAKEUP
#: WIK_WAKEUP:247
msgctxt "text_id=23880 | speaker=yuika"
msgid "\"Perhaps the problem lies with the people here... Then again, I can hardly disagree with you if you say there isn't a problem, Father.\""
msgstr "「どうでしょう。ここに集まった人間に問題があるともとれますが。……まあ、エイリ神父に問題がないかと言えば、それはそれで首を縦に振れないのですけど」"

#. Occurrence WIK_WAKEUP:271:23881: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_WAKEUP_0000; voice_prefix=B30; voice_category=9; scene=WIK_WAKEUP
#: WIK_WAKEUP:271
msgctxt "text_id=23881 | speaker=ritsuka"
msgid "\"Shh. You don't have to say everything you think, Yui!"
msgstr "「しっ、そういう事は思うだけで口にしちゃダメよ<唯|ゆい>ちゃん。"

#. Occurrence WIK_WAKEUP:283:23882: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_WAKEUP_0001; voice_prefix=B30; voice_category=9; scene=WIK_WAKEUP
#: WIK_WAKEUP:283
msgctxt "text_id=23882 | speaker=ritsuka"
msgid "Oh, did you leave the laundry outside? Please tell me our sheets aren't getting wet as we speak.\""
msgstr "あ、お洗濯、ちゃんと片づけてきた？　お布団とかだしっぱなしじゃないかしら？」"

#. Occurrence WIK_WAKEUP:295:23883: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_WAKEUP_0001; voice_prefix=B20; voice_category=10; scene=WIK_WAKEUP
#: WIK_WAKEUP:295
msgctxt "text_id=23883 | speaker=yuika"
msgid "\"Don't worry, it's taken care of. I had a feeling something bad would happen today.\""
msgstr "「それはご心配なく。今日の面子を聞いた時点で、しっかり取り込ませていただきました。不吉な予感しかしませんでしたので」"

#. Occurrence WIK_WAKEUP:316:23884: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_WAKEUP_0001; voice_prefix=B10; voice_category=5; scene=WIK_WAKEUP
#: WIK_WAKEUP:316
msgctxt "text_id=23884 | speaker=kojika"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence WIK_WAKEUP:322:23885: scene=WIK_WAKEUP
#: WIK_WAKEUP:322
msgctxt "text_id=23885 | speaker=unknown"
msgid "  The guests were from Aida Church."
msgstr "　新しくやってきたゲストは、教会の神父たちだった。"

#. Occurrence WIK_WAKEUP:327:23886: scene=WIK_WAKEUP
#: WIK_WAKEUP:327
msgctxt "text_id=23886 | speaker=unknown"
msgid "  Miss Kuonji appeared to have overheard them-she came out from the east wing to greet them."
msgstr "　声を聞きつけたのか、東館から久遠寺さんが出迎えに現れた。"

#. Occurrence WIK_WAKEUP:376:23887: speaker=eiri; speaker_ja=詠梨神父; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B40_WIK_WAKEUP_0002; voice_prefix=B40; voice_category=8; scene=WIK_WAKEUP
#: WIK_WAKEUP:376
msgctxt "text_id=23887 | speaker=eiri"
msgid "\"Forgive our tardiness, after you personally invited us. Are you well, Alice?\""
msgstr "「面目ない、せっかくお招きいただいたのに遅くなりました。お変わりはありませんか、有珠さん」"

#. Occurrence WIK_WAKEUP:387:23888: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_WAKEUP_0000; voice_prefix=A40; voice_category=2; scene=WIK_WAKEUP
#: WIK_WAKEUP:387
msgctxt "text_id=23888 | speaker=alice"
msgid "\"I don't remember inviting you, but you're here now so I suppose that's fine. This way."
msgstr "「貴方を呼んだ覚えはないけど、来てしまったのなら仕方がないわね。どうぞあちらに。"

#. Occurrence WIK_WAKEUP:398:23889: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_WIK_WAKEUP_0001; voice_prefix=A40; voice_category=2; scene=WIK_WAKEUP
#: WIK_WAKEUP:398
msgctxt "text_id=23889 | speaker=alice"
msgid "  I only prepared a seat for Ritsuka, but I'll get some more chairs.\""
msgstr "　<律架|りつか>さんの席しか用意していなかったけれど、急いで椅子を用意するわ」"

#. Occurrence WIK_WAKEUP:430:23890: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_WAKEUP_0002; voice_prefix=B20; voice_category=10; scene=WIK_WAKEUP
#: WIK_WAKEUP:430
msgctxt "text_id=23890 | speaker=yuika"
msgid "\"No need to go out of your way. Father Eiri and I will be leaving soon."
msgstr "「別段お構いなく。律架はともかく、私とエイリ神父は早々に立ち去りますから。"

#. Occurrence WIK_WAKEUP:443:23891: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_WIK_WAKEUP_0003; voice_prefix=B20; voice_category=10; scene=WIK_WAKEUP
#: WIK_WAKEUP:443
msgctxt "text_id=23891 | speaker=yuika"
msgid "Besides, if we need to sit down, we can just sit on Ritsuka.\""
msgstr "それと、椅子も間に合っています。いざとなれば律架が椅子になると」"

#. Occurrence WIK_WAKEUP:468:23892: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_WAKEUP_0002; voice_prefix=B30; voice_category=9; scene=WIK_WAKEUP
#: WIK_WAKEUP:468
msgctxt "text_id=23892 | speaker=ritsuka"
msgid "\"Hey!"
msgstr "「唯ちゃんひどい！"

msgctxt "text_id=23893 | speaker=unknown"
msgid " That's mean, Yui! And what makes it worse is you're not even joking!"
msgstr "　何がひどいって、本気で人間椅子にさせられる現実とか、実力行使できる唯ちゃんとわたしのパワーバランスがひどい！"

#. Occurrence WIK_WAKEUP:478:23894: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_WAKEUP_0003; voice_prefix=B30; voice_category=9; scene=WIK_WAKEUP
#: WIK_WAKEUP:478
msgctxt "text_id=23894 | speaker=ritsuka"
msgid "  You should be nicer to your big sister!\""
msgstr "　……お姉さんに対して当たりきつすぎると思うわ、わたし」"

#. Occurrence WIK_WAKEUP:522:23895: scene=WIK_WAKEUP
#: WIK_WAKEUP:522
msgctxt "text_id=23895 | speaker=unknown"
msgid "  Let's just call these guys \"Team Church.\""
msgstr "　いろいろ面倒なので、彼らを教会組と呼称する。"

#. Occurrence WIK_WAKEUP:543:23896: scene=WIK_WAKEUP
#: WIK_WAKEUP:543
msgctxt "text_id=23896 | speaker=unknown"
msgid "  Miss Kuonji led Father Eiri and Yuika into the drawing room."
msgstr "　<詠梨|えいり>神父とシスター<唯架|ゆいか>は久遠寺さんの先導で居間に向かっていった。"

#. Occurrence WIK_WAKEUP:570:23897: scene=WIK_WAKEUP
#: WIK_WAKEUP:570
msgctxt "text_id=23897 | speaker=unknown"
msgid "  Father Eiri looked like he was enjoying himself."
msgstr "　詠梨神父は見ての通り、楽しげだ。"

#. Occurrence WIK_WAKEUP:575:23898: scene=WIK_WAKEUP
#: WIK_WAKEUP:575
msgctxt "text_id=23898 | speaker=unknown"
msgid "  He was always so laid back, with a permanent smile on his face. It was hard to tell how he really felt about being here."
msgstr "　あの神父はいつも笑顔でリラックスしているので、本心ではこのイベントをどう<捉|とら>えているかは分からない。"

#. Occurrence WIK_WAKEUP:611:23899: scene=WIK_WAKEUP
#: WIK_WAKEUP:611
msgctxt "text_id=23899 | speaker=unknown"
msgid "  Sister Yuika was clearly unhappy."
msgstr "　シスター唯架は、これまた見ての通り、不満そうだ。"

#. Occurrence WIK_WAKEUP:616:23900: scene=WIK_WAKEUP
#: WIK_WAKEUP:616
msgctxt "text_id=23900 | speaker=unknown"
msgid "  Then again, like Father Eiri, her expression rarely changed, so who knew how she really felt?"
msgstr "　あのシスターはいつも辛気くさい顔付きなので、内心はどう思っているのか、これまた定かではない。"

#. Occurrence WIK_WAKEUP:621:23901: scene=WIK_WAKEUP
#: WIK_WAKEUP:621
msgctxt "text_id=23901 | speaker=unknown"
msgid "  And then there was..."
msgstr "　そして、"

#. Occurrence WIK_WAKEUP:658:23902: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_WAKEUP_0004; voice_prefix=B30; voice_category=9; scene=WIK_WAKEUP
#: WIK_WAKEUP:658
msgctxt "text_id=23902 | speaker=ritsuka"
msgid "\"Oh, Kojika! Ciao!\""
msgstr "「あ、金鹿ちゃんだー。チャオー♪」"

#. Occurrence WIK_WAKEUP:663:23903: scene=WIK_WAKEUP
#: WIK_WAKEUP:663
msgctxt "text_id=23903 | speaker=unknown"
msgid "  ...Ritsuka. I wondered what manner of beast lurked beneath that cheerful veneer."
msgstr "　このお気楽な人も、心の底ではどんな獣を隠しているものやら。"

#. Occurrence WIK_WAKEUP:668:23904: scene=WIK_WAKEUP
#: WIK_WAKEUP:668
msgctxt "text_id=23904 | speaker=unknown"
msgid "  Probably not even a kitten."
msgstr "　ま、猫の仔一匹隠れてはいないと思うけど。"

#. Occurrence WIK_WAKEUP:703:23905: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_WAKEUP_0002; voice_prefix=B10; voice_category=5; scene=WIK_WAKEUP
#: WIK_WAKEUP:703
msgctxt "text_id=23905 | speaker=kojika"
msgid "\"Hi, Ritsuka."
msgstr "「こんにちは、律架さん。"

#. Occurrence WIK_WAKEUP:709:23906: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_WAKEUP_0003; voice_prefix=B10; voice_category=5; scene=WIK_WAKEUP
#: WIK_WAKEUP:709
msgctxt "text_id=23906 | speaker=kojika"
msgid "  I didn't know you were invited.\""
msgstr "　律架さんたちも誘われたんですか、パーティー」"

#. Occurrence WIK_WAKEUP:720:23907: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_WAKEUP_0005; voice_prefix=B30; voice_category=9; scene=WIK_WAKEUP
#: WIK_WAKEUP:720
msgctxt "text_id=23907 | speaker=ritsuka"
msgid "\"Yeah! Allie told me I definitely had to come."
msgstr "「ええ、ぜひ来てくださいって、アッちゃんから。"

#. Occurrence WIK_WAKEUP:731:23908: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_WAKEUP_0006; voice_prefix=B30; voice_category=9; scene=WIK_WAKEUP
#: WIK_WAKEUP:731
msgctxt "text_id=23908 | speaker=ritsuka"
msgid "  Father Eiri and Yuika both got a letter from Ako..."
msgstr "　詠梨さんと唯ちゃんにはアコちゃんから手紙があったみたい。"

#. Occurrence WIK_WAKEUP:742:23909: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_WAKEUP_0007; voice_prefix=B30; voice_category=9; scene=WIK_WAKEUP
#: WIK_WAKEUP:742
msgctxt "text_id=23909 | speaker=ritsuka"
msgid "  Wait. Does that mean different people got different invitations?\""
msgstr "　……ん？　もしかして招待状の差出人って、それぞれ違うのかしら」"

#. Occurrence WIK_WAKEUP:753:23910: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_WAKEUP_0004; voice_prefix=B10; voice_category=5; scene=WIK_WAKEUP
#: WIK_WAKEUP:753
msgctxt "text_id=23910 | speaker=kojika"
msgid "\"Seems like it. I was invited by Sizuki.\""
msgstr "「そうみたいですね。わたしは静希からだったし」"

#. Occurrence WIK_WAKEUP:773:23911: scene=WIK_WAKEUP
#: WIK_WAKEUP:773
msgctxt "text_id=23911 | speaker=unknown"
msgid "  Ritsuka was Yuika's sister, and not a real member of the clergy."
msgstr "　律架さんはシスター唯架の姉で、厳密に言えば教会の人ではない。"

#. Occurrence WIK_WAKEUP:778:23912: scene=WIK_WAKEUP
#: WIK_WAKEUP:778
msgctxt "text_id=23912 | speaker=unknown"
msgid "  She was just a regular citizen of Misaki. I saw her every now and then in the shopping district."
msgstr "　商店街では二日に一度顔を会わす、いたって平凡な三咲町の住人である。"

#. Occurrence WIK_WAKEUP:804:23913: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_WAKEUP_0005; voice_prefix=B10; voice_category=5; scene=WIK_WAKEUP
#: WIK_WAKEUP:804
msgctxt "text_id=23913 | speaker=kojika"
msgid "\"Anyway, what's the deal with the weather?\""
msgstr "「それより律架さん。雨、降ってきたんですか？」"

#. Occurrence WIK_WAKEUP:816:23914: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_WIK_WAKEUP_0008; voice_prefix=B30; voice_category=9; scene=WIK_WAKEUP
#: WIK_WAKEUP:816
msgctxt "text_id=23914 | speaker=ritsuka"
msgid "\"I know, right? It's started raining, but hopefully it'll clear up soon.\""
msgstr "「ええ、パラパラとね。すぐに止んでくれればいいけど」"

#. Occurrence WIK_WAKEUP:834:23915: scene=WIK_WAKEUP
#: WIK_WAKEUP:834
msgctxt "text_id=23915 | speaker=unknown"
msgid "  Ritsuka glanced outside, concerned."
msgstr "　律架さんは不安げな視線を外に送る。"

#. Occurrence WIK_WAKEUP:839:23916: scene=WIK_WAKEUP
#: WIK_WAKEUP:839
msgctxt "text_id=23916 | speaker=unknown"
msgid "  I..."
msgstr "　わたしは、"

#. Occurrence WIK_SELECT_D:8:23917: scene=WIK_SELECT_D
#: WIK_SELECT_D:8
msgctxt "text_id=23917 | speaker=unknown"
msgid "-Decision D-"
msgstr "～選択肢Ｄ～"

#. Occurrence WIK_WXYZ:74:23918: scene=WIK_WXYZ
#: WIK_WXYZ:74
msgctxt "text_id=23918 | speaker=unknown"
msgid "  ...This wasn't working. I couldn't think straight!"
msgstr "　―――ダメだ、考えがまとまらない！"

#. Occurrence WIK_WXYZ:80:23919: scene=WIK_WXYZ
#: WIK_WXYZ:80
msgctxt "text_id=23919 | speaker=unknown"
msgid "  At this rate, I'd never figure out who the killer was."
msgstr "　このまま犯人を指摘する事はできない。"

#. Occurrence WIK_WXYZ:85:23920: scene=WIK_WXYZ
#: WIK_WXYZ:85
msgctxt "text_id=23920 | speaker=unknown"
msgid "  If I couldn't use my head, I'd have to rely on my legs and get out of here!"
msgstr "　今は知能より体力勝負、とにかく逃げ切らないと！"

#. Occurrence WIK_WXYZ:135:23921: scene=WIK_WXYZ
#: WIK_WXYZ:135
msgctxt "text_id=23921 | speaker=unknown"
msgid "  The game would end if I could just keep from getting caught until sunrise."
msgstr "　太陽が昇りきるまで逃げれば、このゲームはおしまいだ。"

#. Occurrence WIK_WXYZ:140:23922: scene=WIK_WXYZ
#: WIK_WXYZ:140
msgctxt "text_id=23922 | speaker=unknown"
msgid "  As long as I survived, Sweets Hearts wouldn't win."
msgstr "　わたしという生存者がいるかぎり、スイーツハーツの勝ちにはならない。"

#. Occurrence WIK_WXYZ:145:23923: scene=WIK_WXYZ
#: WIK_WXYZ:145
msgctxt "text_id=23923 | speaker=unknown"
msgid "  The storm was over. If I could just make it to the city, everything would go back to normal...!"
msgstr "　嵐も止んだし、このまま町まで下りてしまえば何もかも元通りなんだ……！"

#. Occurrence WIK_WXYZ:209:23924: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_WXYZ_0000; voice_prefix=B10; voice_category=5; scene=WIK_WXYZ
#: WIK_WXYZ:209
msgctxt "text_id=23924 | speaker=kojika"
msgid "\"...No way.\""
msgstr "「―――うそ」"

#. Occurrence WIK_WXYZ:215:23925: scene=WIK_WXYZ
#: WIK_WXYZ:215
msgctxt "text_id=23925 | speaker=unknown"
msgid "  I've been heading downhill all this time! How am I at the back of the mansion?!"
msgstr "　わたしは下に向かって駆け続けたのに、たどり着いたのは洋館の裏。"

#. Occurrence WIK_WXYZ:235:23926: scene=WIK_WXYZ
#: WIK_WXYZ:235
msgctxt "text_id=23926 | speaker=unknown"
msgid "  I'd been heading downhill all this time, so how did I end up behind the mansion?"
msgstr "　ああ―――"

#. Occurrence WIK_WXYZ:240:23927: scene=WIK_WXYZ
#: WIK_WXYZ:240
msgctxt "text_id=23927 | speaker=unknown"
msgid "  Aaah..."
msgstr "　地面が歪んでいる。"

#. Occurrence WIK_WXYZ:245:23928: scene=WIK_WXYZ
#: WIK_WXYZ:245
msgctxt "text_id=23928 | speaker=unknown"
msgid "  The ground distorted."
msgstr "　感覚が狂っている。"

#. Occurrence WIK_WXYZ:250:23929: scene=WIK_WXYZ
#: WIK_WXYZ:250
msgctxt "text_id=23929 | speaker=unknown"
msgid "  My senses went haywire."
msgstr "　世界は崩れている。"

#. Occurrence WIK_WXYZ:256:23930: scene=WIK_WXYZ
#: WIK_WXYZ:256
msgctxt "text_id=23930 | speaker=unknown"
msgid "  I must've done something wrong."
msgstr "　わたしはきっと、何かを、間違えてしまっている。"

#. Occurrence WIK_WXYZ:301:23931: scene=WIK_WXYZ
#: WIK_WXYZ:301
msgctxt "text_id=23931 | speaker=unknown"
msgid "  Suddenly, a voice whispers in my ear."
msgstr "　不意に、耳元で"

#. Occurrence WIK_WXYZ:312:23932: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_WIK_WXYZ_0000; voice_prefix=A30; voice_category=3; scene=WIK_WXYZ
#: WIK_WXYZ:312
msgctxt "text_id=23932 | speaker=soujuurou"
msgid "          \"Con-"
msgstr "　　　　　「み"

msgctxt "text_id=23933 | speaker=unknown"
msgid "gra-"
msgstr "な"

msgctxt "text_id=23934 | speaker=unknown"
msgid "tu-"
msgstr "ご"

msgctxt "text_id=23935 | speaker=unknown"
msgid "lations"
msgstr "ろ"

msgctxt "text_id=23936 | speaker=unknown"
msgid " on"
msgstr "し、"

msgctxt "text_id=23937 | speaker=unknown"
msgid " kill-"
msgstr "お"

msgctxt "text_id=23938 | speaker=unknown"
msgid "ing"
msgstr "め"

msgctxt "text_id=23939 | speaker=unknown"
msgid " ev-"
msgstr "で"

msgctxt "text_id=23940 | speaker=unknown"
msgid "ery-"
msgstr "と"

msgctxt "text_id=23941 | speaker=unknown"
msgid "one.\""
msgstr "う」"

#. Occurrence WIK_WXYZ:344:23942: scene=WIK_WXYZ
#: WIK_WXYZ:344
msgctxt "text_id=23942 | speaker=unknown"
msgid "  It was a voice of terror that I'd never heard before,"
msgstr "　一度も聞いたコトのない、世にも恐ろしい、"

#. Occurrence WIK_WXYZ:349:23943: scene=WIK_WXYZ
#: WIK_WXYZ:349
msgctxt "text_id=23943 | speaker=unknown"
msgid "  yet it sounded so familiar..."
msgstr "　近しい他人の声を聞いた―――"

#. Occurrence WIK_X_2:40:23944: scene=WIK_X_2
#: WIK_X_2:40
msgctxt "text_id=23944 | speaker=unknown"
msgid "  Only one of them could have caused this all to happen."
msgstr "　そいつがすべての元凶。"

#. Occurrence WIK_X_2:45:23945: scene=WIK_X_2
#: WIK_X_2:45
msgctxt "text_id=23945 | speaker=unknown"
msgid "  I considered who could have activated the Ploys."
msgstr "　プロイとやらを起動させられたのは誰だ、とわたしは思った。"

#. Occurrence WIK_X_2:299:23946: scene=WIK_X_2
#: WIK_X_2:299
msgctxt "text_id=23946 | speaker=unknown"
msgid "  Right."
msgstr "　そうだ。"

#. Occurrence WIK_X_2:304:23947: scene=WIK_X_2
#: WIK_X_2:304
msgctxt "text_id=23947 | speaker=unknown"
msgid "  Our prime suspect was..."
msgstr "　つまり、人物Ａは、"

#. Occurrence WIK_SELECT_Y:8:23948: scene=WIK_SELECT_Y
#: WIK_SELECT_Y:8
msgctxt "text_id=23948 | speaker=unknown"
msgid "-Decision Y-"
msgstr "～選択肢Ｙ～"

#. Occurrence WIK_SELECT_Z:7:23949: scene=WIK_SELECT_Z
#: WIK_SELECT_Z:7
msgctxt "text_id=23949 | speaker=unknown"
msgid "  Was there a simpler explanation?"
msgstr "　その、もっとも分かりやすい根拠は？"

#. Occurrence WIK_SELECT_Z:7:23950: scene=WIK_SELECT_Z
#: WIK_SELECT_Z:7
msgctxt "text_id=23950 | speaker=unknown"
msgid "-Decision Z-"
msgstr "～選択肢Ｚ～"

#. Occurrence WIK_Z_3:98:23951: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_Z_3_0000; voice_prefix=B10; voice_category=5; scene=WIK_Z_3
#: WIK_Z_3:98
msgctxt "text_id=23951 | speaker=kojika"
msgid "\"...It's me.\""
msgstr "「―――わたしだ」"

#. Occurrence WIK_Z_3:104:23952: scene=WIK_Z_3
#: WIK_Z_3:104
msgctxt "text_id=23952 | speaker=unknown"
msgid "  It could only be."
msgstr "　そう。"

#. Occurrence WIK_Z_3:109:23953: scene=WIK_Z_3
#: WIK_Z_3:109
msgctxt "text_id=23953 | speaker=unknown"
msgid "  The fact that everything had gone just the way I'd thought was proof above all that I was Sweets Hearts."
msgstr "　この、自分の思った通りに事が運ぶ状況こそが、わたしがスイーツハーツである、何よりの証拠だった。"

#. Occurrence WIK_Z_3:150:23954: scene=WIK_Z_3
#: WIK_Z_3:150
msgctxt "text_id=23954 | speaker=unknown"
msgid "  And as Sweets Hearts, I couldn't remember anything that worked against me."
msgstr "　スイーツハーツであるわたしは、都合の悪い事は思い出せない。"

#. Occurrence WIK_Z_3:155:23955: scene=WIK_Z_3
#: WIK_Z_3:155
msgctxt "text_id=23955 | speaker=unknown"
msgid "  I had to look at this objectively."
msgstr "　なので客観的に考えよう。"

#. Occurrence WIK_Z_3:160:23956: scene=WIK_Z_3
#: WIK_Z_3:160
msgctxt "text_id=23956 | speaker=unknown"
msgid "  Who activated the Ploy Kickshaw on the day of the party?"
msgstr "　パーティーの日、プロイキッシャーを起動させたのは誰なのか。"

#. Occurrence WIK_Z_3:180:23957: scene=WIK_Z_3
#: WIK_Z_3:180
msgctxt "text_id=23957 | speaker=unknown"
msgid "  The answer was, \"no one.\""
msgstr "　答えは『誰もいない』だ。"

#. Occurrence WIK_Z_3:194:23958: scene=WIK_Z_3
#: WIK_Z_3:194
msgctxt "text_id=23958 | speaker=unknown"
msgid "  Miss Kuonji personally locked the room were she stored her Ploys."
msgstr "　プロイが保管されていた部屋は、久遠寺さん本人が施錠している。"

#. Occurrence WIK_Z_3:199:23959: scene=WIK_Z_3
#: WIK_Z_3:199
msgctxt "text_id=23959 | speaker=unknown"
msgid "  No one could possibly break inside."
msgstr "　ドアが壁になっている部屋に侵入できる者はいない。"

#. Occurrence WIK_Z_3:204:23960: scene=WIK_Z_3
#: WIK_Z_3:204
msgctxt "text_id=23960 | speaker=unknown"
msgid "  As long as there weren't any special tricks, we could eliminate that possibility entirely."
msgstr "　トリックの可能性が提示されていないのなら、そこに“なんとかして壁を開けた”なんて可能性は除外される。"

#. Occurrence WIK_Z_3:209:23961: scene=WIK_Z_3
#: WIK_Z_3:209
msgctxt "text_id=23961 | speaker=unknown"
msgid "  It was only logical―"
msgstr "　それが推理の鉄則だ。"

#. Occurrence WIK_Z_3:229:23962: scene=WIK_Z_3
#: WIK_Z_3:229
msgctxt "text_id=23962 | speaker=unknown"
msgid "  Therefore, if someone took the Ploy, they had to have done it *before* today."
msgstr "　故に、プロイを奪えるとしたら、それは<今|・><日|・><以|・><前|・>。"

#. Occurrence WIK_Z_3:234:23963: scene=WIK_Z_3
#: WIK_Z_3:234
msgctxt "text_id=23963 | speaker=unknown"
msgid "  They would have broken in before she locked the vault."
msgstr "　単純に考えて、久遠寺さんが施錠する前日に入るしかないのである。"

#. Occurrence WIK_Z_3:239:23964: scene=WIK_Z_3
#: WIK_Z_3:239
msgctxt "text_id=23964 | speaker=unknown"
msgid "  Only someone who had accidentally come on the first day of the long weekend"
msgstr "　パーティーの当日である三連休の二日目ではなく、"

#. Occurrence WIK_Z_3:244:23965: scene=WIK_Z_3
#: WIK_Z_3:244
msgctxt "text_id=23965 | speaker=unknown"
msgid "  would have had the opportunity."
msgstr "　間違えて一日目にやってきてしまった人物にのみ、そのチャンスがあったのだ。"

#. Occurrence WIK_Z_3:277:23966: scene=WIK_Z_3
#: WIK_Z_3:277
msgctxt "text_id=23966 | speaker=unknown"
msgid "  So, why did they come on the first day by mistake?"
msgstr "　では、どうしてその人物は間違えてやってきてしまったのか？"

#. Occurrence WIK_Z_3:282:23967: scene=WIK_Z_3
#: WIK_Z_3:282
msgctxt "text_id=23967 | speaker=unknown"
msgid "  Simple: the invitation itself was wrong."
msgstr "　これも明白だ。招待状の内容が、そもそも間違えていた。"

#. Occurrence WIK_Z_3:312:23968: scene=WIK_Z_3
#: WIK_Z_3:312
msgctxt "text_id=23968 | speaker=unknown"
msgid "\"A birthday party will be held at the start of the long weekend.\""
msgstr "“連休のはじめに、誕生会を開きます”"

#. Occurrence WIK_Z_3:317:23969: scene=WIK_Z_3
#: WIK_Z_3:317
msgctxt "text_id=23969 | speaker=unknown"
msgid "  The blockhead who wrote that on the invitations"
msgstr "　そんな間抜けなミスをした男と、"

#. Occurrence WIK_Z_3:322:23970: scene=WIK_Z_3
#: WIK_Z_3:322
msgctxt "text_id=23970 | speaker=unknown"
msgid "  sent them out to three people total."
msgstr "　その男に招待状を送られたのは三人。"

#. Occurrence WIK_Z_3:372:23971: scene=WIK_Z_3
#: WIK_Z_3:372
msgctxt "text_id=23971 | speaker=unknown"
msgid "  Of those people, Touko Aozaki probably had it all figured out. But, she laughed at something she wasn't expecting, so that took care of her."
msgstr "　うちひとり、蒼崎橙子はあらかたの事情を看破していたかもしれない。けど、彼女が想像もしていなかったネタで笑わされ、リタイヤした。"

#. Occurrence WIK_Z_3:405:23972: scene=WIK_Z_3
#: WIK_Z_3:405
msgctxt "text_id=23972 | speaker=unknown"
msgid "  Then there was Mr. Yamasiro."
msgstr "　もうひとりは山城先生。"

#. Occurrence WIK_Z_3:410:23973: scene=WIK_Z_3
#: WIK_Z_3:410
msgctxt "text_id=23973 | speaker=unknown"
msgid "  He'd said..."
msgstr "　山城先生はこう言っていた。"

#. Occurrence WIK_Z_3:415:23974: scene=WIK_Z_3
#: WIK_Z_3:415
msgctxt "text_id=23974 | speaker=unknown"
msgid "  ...that he'd gotten his invitation that morning."
msgstr "『今朝、招待状が届いた』と。"

#. Occurrence WIK_Z_3:420:23975: scene=WIK_Z_3
#: WIK_Z_3:420
msgctxt "text_id=23975 | speaker=unknown"
msgid "  Everyone else had received theirs before that."
msgstr "　みんなの招待状はもっと前に届いていた。"

#. Occurrence WIK_Z_3:425:23976: scene=WIK_Z_3
#: WIK_Z_3:425
msgctxt "text_id=23976 | speaker=unknown"
msgid "  It's highly likely it was delivered directly to his mailbox instead of being mailed."
msgstr "　なので、山城先生の招待状は郵便ではなく、昨日直接ポストに入れられた可能性が高い。"

#. Occurrence WIK_Z_3:445:23977: scene=WIK_Z_3
#: WIK_Z_3:445
msgctxt "text_id=23977 | speaker=unknown"
msgid "  If Sizuki was working with the prime suspect, then they likely edited the invitation."
msgstr "　―――仮に、その時点で静希が“人物Ａ”の協力者になっていたのなら、招待状の内容は彼らにとって都合のいいものに改竄されていただろう。"

#. Occurrence WIK_Z_3:450:23978: scene=WIK_Z_3
#: WIK_Z_3:450
msgctxt "text_id=23978 | speaker=unknown"
msgid "  Sizuki became an accomplice on the first day, and then invited Mr. Yamasiro on the morning of the second day. This was to hide the fact that the prime suspect was \"accidentally\" invited on the first day."
msgstr "　一日目で共犯者になった静希は、二日目の朝、その日に山城先生を呼ぶ招待状を送った。彼が“間違えて人物Ａを一日目に呼んでしまった”事実を誤魔化す為に。"

#. Occurrence WIK_Z_3:455:23979: scene=WIK_Z_3
#: WIK_Z_3:455
msgctxt "text_id=23979 | speaker=unknown"
msgid "  Mr. Yamasiro wasn't just invited to be killed, but to act as an alibi for the culprit."
msgstr "　山城先生は殺される為に呼び出されたのではなく、人物Ａのアリバイを偽証するために呼ばれたのだ。"

#. Occurrence WIK_Z_3:488:23980: scene=WIK_Z_3
#: WIK_Z_3:488
msgctxt "text_id=23980 | speaker=unknown"
msgid "  Then, there was me."
msgstr "　そして最後のひとり、わたしは―――"

#. Occurrence WIK_Z_3:493:23981: scene=WIK_Z_3
#: WIK_Z_3:493
msgctxt "text_id=23981 | speaker=unknown"
msgid "  I was sure the party would be on the first day of the long weekend."
msgstr "　このパーティーを、連休の一日目だと思いこんでいた。"

#. Occurrence WIK_Z_3:499:23982: scene=WIK_Z_3
#: WIK_Z_3:499
msgctxt "text_id=23982 | speaker=unknown"
msgid "  Based on all this information, the only people who could have activated the Ploy were me and Sizuki."
msgstr "　以上の事から、プロイを起動させる可能性があるのは、登場人物の中ではこのわたし、久万梨金鹿と静希草十郎のみ。"

#. Occurrence WIK_Z_3:538:23983: scene=WIK_Z_3
#: WIK_Z_3:538
msgctxt "text_id=23983 | speaker=unknown"
msgid "  I could only imagine the kind of hospitality he must have offered Kojika Kumari for suddenly showing up on the wrong day."
msgstr "　日付を間違えてやってきた久万梨金鹿を、静希草十郎がどのように持てなしたかは想像するしかない。"

#. Occurrence WIK_Z_3:552:23984: scene=WIK_Z_3
#: WIK_Z_3:552
msgctxt "text_id=23984 | speaker=unknown"
msgid "  But, it wasn't unreasonable that he'd put out tea and snacks for a fellow schoolmate."
msgstr "　けど、自分の責任で無駄足を踏ませた同級生に、お菓子と紅茶を振る舞うのは、そう突飛な話ではないと思う。"

#. Occurrence WIK_Z_3:557:23985: scene=WIK_Z_3
#: WIK_Z_3:557
msgctxt "text_id=23985 | speaker=unknown"
msgid "  The problem is, where did Sizuki obtain those snacks from?"
msgstr "　問題は、そのお菓子を静希草十郎がどこから持ち出したのか、という事だ。"

#. Occurrence WIK_Z_3:597:23986: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B11_WIK_Z_3_0000; voice_prefix=B11; voice_category=5; scene=WIK_Z_3
#: WIK_Z_3:597
msgctxt "text_id=23986 | speaker=kojika"
msgid "\"Ah, well. You figured it out, huh?"
msgstr "「あーあ。気付いちゃったかあ。"

#. Occurrence WIK_Z_3:603:23987: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B11_WIK_Z_3_0001; voice_prefix=B11; voice_category=5; scene=WIK_Z_3
#: WIK_Z_3:603
msgctxt "text_id=23987 | speaker=kojika"
msgid "  I was so close to winning, too. This girl's smarter than I thought.\""
msgstr "　もう少しであたしの勝ちだったのに。あの子も予想以上にうまくやっていたんだけどなー」"

#. Occurrence WIK_Z_3:613:23988: scene=WIK_Z_3
#: WIK_Z_3:613
msgctxt "text_id=23988 | speaker=unknown"
msgid "  Just then..."
msgstr "　そして。"

#. Occurrence WIK_Z_3:618:23989: scene=WIK_Z_3
#: WIK_Z_3:618
msgctxt "text_id=23989 | speaker=unknown"
msgid "  From the mansion, another me appeared from the mansion-the one who had been Sizuki chasing me."
msgstr "　洋館からは、わたしを追いかけてきた、さっきまで静希だったわたしが現れた。"

#. Occurrence WIK_Z_3:755:23990: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_Z_3_0001; voice_prefix=B10; voice_category=5; scene=WIK_Z_3
#: WIK_Z_3:755
msgctxt "text_id=23990 | speaker=kojika"
msgid "\"Are you Sweets Hearts?\""
msgstr "「アンタが、スイーツハーツ？」"

#. Occurrence WIK_Z_3:760:23991: scene=WIK_Z_3
#: WIK_Z_3:760
msgctxt "text_id=23991 | speaker=unknown"
msgid "  I got up off my knees to face my other self."
msgstr "　膝をついた姿勢から立ち上がって、もうひとりのわたしと対峙する。"

#. Occurrence WIK_Z_3:771:23992: scene=WIK_Z_3
#: WIK_Z_3:771
msgctxt "text_id=23992 | speaker=unknown"
msgid "  She nodded yes, admitting defeat."
msgstr "　そいつはええ、とあっさり負けを認めた。"

#. Occurrence WIK_Z_3:798:23993: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B11_WIK_Z_3_0002; voice_prefix=B11; voice_category=5; scene=WIK_Z_3
#: WIK_Z_3:798
msgctxt "text_id=23993 | speaker=kojika"
msgid "\"You're Sweets Hearts, too, though."
msgstr "「そう言う貴女もスイーツハーツだけどね。"

#. Occurrence WIK_Z_3:810:23994: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B11_WIK_Z_3_0003; voice_prefix=B11; voice_category=5; scene=WIK_Z_3
#: WIK_Z_3:810
msgctxt "text_id=23994 | speaker=kojika"
msgid "  I was disguised as him; You were disguised as her."
msgstr "　あたしはカレに化けていた方で、貴女はカノジョに化けていた方。"

#. Occurrence WIK_Z_3:822:23995: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B11_WIK_Z_3_0004; voice_prefix=B11; voice_category=5; scene=WIK_Z_3
#: WIK_Z_3:822
msgctxt "text_id=23995 | speaker=kojika"
msgid "  But you're exactly the same as Kojika Kumari, so I'm the only one with any memory of being Sweets Hearts.\""
msgstr "　でも貴女は久万梨金鹿と完全に同じだから、スイーツハーツとしての記憶を持ってるのはあたしだけだけど」"

#. Occurrence WIK_Z_3:850:23996: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_Z_3_0002; voice_prefix=B10; voice_category=5; scene=WIK_Z_3
#: WIK_Z_3:850
msgctxt "text_id=23996 | speaker=kojika"
msgid "\"Is that so? Well, it's time for us to go. Game over. The sun's almost up.\""
msgstr "「あっそ。じゃあ消えて。これでゲームクリアでしょ。もうじき完全に日が昇るわ」"

#. Occurrence WIK_Z_3:894:23997: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B11_WIK_Z_3_0005; voice_prefix=B11; voice_category=5; scene=WIK_Z_3
#: WIK_Z_3:894
msgctxt "text_id=23997 | speaker=kojika"
msgid "\"Are you sure you want the game to end?"
msgstr "「いいの？　クリアしちゃって？"

#. Occurrence WIK_Z_3:906:23998: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B11_WIK_Z_3_0006; voice_prefix=B11; voice_category=5; scene=WIK_Z_3
#: WIK_Z_3:906
msgctxt "text_id=23998 | speaker=kojika"
msgid "  You're about to win. Don't you want your prize?\""
msgstr "　このままなら貴女の勝ちなのに。勝者の報酬は惜しくないの？」"

#. Occurrence WIK_Z_3:939:23999: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_Z_3_0003; voice_prefix=B10; voice_category=5; scene=WIK_Z_3
#: WIK_Z_3:939
msgctxt "text_id=23999 | speaker=kojika"
msgid "\"My what? I didn't know there was a prize involved.\""
msgstr "「……なにそれ。聞いてない。どういうこと？」"

#. Occurrence WIK_Z_3:986:24000: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B11_WIK_Z_3_0007; voice_prefix=B11; voice_category=5; scene=WIK_Z_3
#: WIK_Z_3:986
msgctxt "text_id=24000 | speaker=kojika"
msgid "\"I'm talking about what Kojika Kumari wished for and was worried about when she ate me."
msgstr "「久万梨金鹿があたしを食べる時、なにを願って、なにを迷っていたかって話。"

#. Occurrence WIK_Z_3:1008:24001: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B11_WIK_Z_3_0008; voice_prefix=B11; voice_category=5; scene=WIK_Z_3
#: WIK_Z_3:1008
msgctxt "text_id=24001 | speaker=kojika"
msgid "  You don't want it to end. You wish this half-baked, uncertain life could go on forever, don't you?\""
msgstr "　終わりたくない。もっと今が、この半熟卵みたいな、曖昧な生活が続けばいいと思ったでしょう？」"

#. Occurrence WIK_Z_3:1057:24002: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B11_WIK_Z_3_0009; voice_prefix=B11; voice_category=5; scene=WIK_Z_3
#: WIK_Z_3:1057
msgctxt "text_id=24002 | speaker=kojika"
msgid "\"'Why is high school only three years?'"
msgstr "「なんで高校生活は三年だけなのか。"

#. Occurrence WIK_Z_3:1075:24003: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B11_WIK_Z_3_0010; voice_prefix=B11; voice_category=5; scene=WIK_Z_3
#: WIK_Z_3:1075
msgctxt "text_id=24003 | speaker=kojika"
msgid "  'Why did I waste so much time?'"
msgstr "　どうして自分はあんな無駄な時間を過ごしたのか。"

#. Occurrence WIK_Z_3:1093:24004: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B11_WIK_Z_3_0011; voice_prefix=B11; voice_category=5; scene=WIK_Z_3
#: WIK_Z_3:1093
msgctxt "text_id=24004 | speaker=kojika"
msgid "  'Why wasn't I honest about my feelings?'"
msgstr "　なんで素直になれなかったのか。"

#. Occurrence WIK_Z_3:1153:24005: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B11_WIK_Z_3_0012; voice_prefix=B11; voice_category=5; scene=WIK_Z_3
#: WIK_Z_3:1153
msgctxt "text_id=24005 | speaker=kojika"
msgid "  All those things."
msgstr "　そういうの、"

msgctxt "text_id=24006 | speaker=unknown"
msgid " I can make all your woes go away. I'm Sweets Hearts, the Ploy Kickshaw of prayer for girls in the prime of their youth only.  Whaddya say?\""
msgstr "ぜーんぶひっくるめて叶えてあげるのがあたし、願掛け卵、思春期限定・女の子限定のプロイキッシャー・スイーツハーツなの。どう、納得いった？」"

#. Occurrence WIK_Z_3:1240:24007: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_Z_3_0004; voice_prefix=B10; voice_category=5; scene=WIK_Z_3
#: WIK_Z_3:1240
msgctxt "text_id=24007 | speaker=kojika"
msgid "\"Thanks, but no thanks. I don't care what you can do, and I don't care what happened."
msgstr "「納得なんていくワケないでしょ。能書きはいいし、何があったかなんて知りたくもないから。"

#. Occurrence WIK_Z_3:1261:24008: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_Z_3_0005; voice_prefix=B10; voice_category=5; scene=WIK_Z_3
#: WIK_Z_3:1261
msgctxt "text_id=24008 | speaker=kojika"
msgid "  I'm done talking to you. Time's up."
msgstr "　もうお喋りはたくさん。ノータイムでリセットよ。"

#. Occurrence WIK_Z_3:1267:24009: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_Z_3_0006; voice_prefix=B10; voice_category=5; scene=WIK_Z_3
#: WIK_Z_3:1267
msgctxt "text_id=24009 | speaker=kojika"
msgid "  You're finished.\""
msgstr "　アンタは、ここで」"

#. Occurrence WIK_Z_3:1362:24010: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B11_WIK_Z_3_0013; voice_prefix=B11; voice_category=5; scene=WIK_Z_3
#: WIK_Z_3:1362
msgctxt "text_id=24010 | speaker=kojika"
msgid "\"W-wait! But I can only be used by someone who has unrequited―\""
msgstr "「え、ちょっ、だってあたしの使用条件は、片思―――」"

#. Occurrence WIK_Z_3:1367:24011: scene=WIK_Z_3
#: WIK_Z_3:1367
msgctxt "text_id=24011 | speaker=unknown"
msgid "  At the end of the day..."
msgstr "　っていうか、そもそも、"

#. Occurrence WIK_Z_3:1438:24012: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_WIK_Z_3_0007; voice_prefix=B10; voice_category=5; scene=WIK_Z_3
#: WIK_Z_3:1438
msgctxt "text_id=24012 | speaker=kojika"
msgid "\"Get lost. Sizuki is the killer! I'm the user, Kojika Kumari.\""
msgstr "「消えて。犯人は静希。使用者はわたし、久万梨金鹿よ」"

#. Occurrence WIK_Z_3:1534:24013: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B11_WIK_Z_3_0014; voice_prefix=B11; voice_category=5; scene=WIK_Z_3
#: WIK_Z_3:1534
msgctxt "text_id=24013 | speaker=kojika"
msgid "\"What? Seriously?! But that's so unmaidenly!\""
msgstr "「えぇ、そんなぁー！？　女の子にあるまじきーー！？」"

#. Occurrence WIK_Z_3:1566:24014: scene=WIK_Z_3
#: WIK_Z_3:1566
msgctxt "text_id=24014 | speaker=unknown"
msgid "  There wasn't anything left to wish for, now that Tsukiji was dead."
msgstr "　槻司が死んでるのに、願掛けも何もないっての。"

msgctxt "text_id=24015 | speaker=unknown"
msgid "Might be an ill omen."
msgstr "それは何か、不吉な兆しなのでは、と思った。"

msgctxt "text_id=24016 | speaker=unknown"
msgid "Maybe it's always unlocked."
msgstr "鍵はいつも開けっ放しなのか、と思った。"

msgctxt "text_id=24017 | speaker=unknown"
msgid "I could enter by myself."
msgstr "これならひとりでも入れるな、と思った。"

msgctxt "text_id=24018 | speaker=unknown"
msgid "I should head to the drawing room."
msgstr "このまま居間に移動した方がいいと思った。"

msgctxt "text_id=24019 | speaker=unknown"
msgid "I'll check out the guest room first."
msgstr "その前に客室の様子を見た方がいいと思った。"

msgctxt "text_id=24020 | speaker=unknown"
msgid "I'll do something random."
msgstr "意味のない行動をしてみるのもいいと思った。"

msgctxt "text_id=24021 | speaker=unknown"
msgid "Something's wrong. I should go back to the mansion."
msgstr "何か不穏。洋館に戻るべきだと思った。"

msgctxt "text_id=24022 | speaker=unknown"
msgid "Curious. I should check it out."
msgstr "気になる。確かめてみるべきだと思った。"

msgctxt "text_id=24023 | speaker=unknown"
msgid "The rain's going to get worse."
msgstr "このまま雨脚は強くなるな、と思った。"

msgctxt "text_id=24024 | speaker=unknown"
msgid "The rain might turn to hail."
msgstr "このまま雨は雹になるな、と思った。"

msgctxt "text_id=24025 | speaker=unknown"
msgid "I should just go home."
msgstr "このまま帰ってしまおうか、と思った。"

msgctxt "text_id=24026 | speaker=unknown"
msgid "The numbers add up."
msgstr "数はあっているな、と思った。"

msgctxt "text_id=24027 | speaker=unknown"
msgid "The numbers are off."
msgstr "数を間違えているな、と思った。"

msgctxt "text_id=24028 | speaker=unknown"
msgid "...I haven't seen Sizuki, come to think of it."
msgstr "……そういえば、まだ静希を見ていないな、と思った。"

msgctxt "text_id=24029 | speaker=unknown"
msgid "Something horrible's about to happen."
msgstr "これから陰惨な事件が始まるのだ、と思った。"

msgctxt "text_id=24030 | speaker=unknown"
msgid "Something crazy's about to go down."
msgstr "これからトンデモな事件が始まるのだ、と思った。"

msgctxt "text_id=24031 | speaker=unknown"
msgid "I'm glad I was paired with Tsukiji."
msgstr "槻司と組めて良かった、と思った。"

msgctxt "text_id=24032 | speaker=unknown"
msgid "It was some kind of bread."
msgstr "大雑把に言うとパンだ、と思った。"

msgctxt "text_id=24033 | speaker=unknown"
msgid "Realistically, a small explosive."
msgstr "現実的に小型爆薬だ、と思った。"

msgctxt "text_id=24034 | speaker=unknown"
msgid "A dog or something chewed him up."
msgstr "犬か何かに食いちぎられたのでは、と思った。"

msgctxt "text_id=24035 | speaker=unknown"
msgid "I think we should focus on Tokitsu's death."
msgstr "土桔由里彦氏の死がネックだ、と思った。"

msgctxt "text_id=24036 | speaker=unknown"
msgid "It's easy enough to not laugh for one night."
msgstr "たしかに一晩笑わないのなんて簡単、と思った。"

msgctxt "text_id=24037 | speaker=unknown"
msgid "...I should point out we're one person down."
msgstr "……そろそろひとり足りない事を指摘すべきだろうか、と思った。"

msgctxt "text_id=24038 | speaker=unknown"
msgid "Tsukiji's story doesn't add up."
msgstr "槻司の話はおかしい、と思った。"

msgctxt "text_id=24039 | speaker=unknown"
msgid "Aozaki's story doesn't add up."
msgstr "蒼崎の話はおかしい、と思った。"

msgctxt "text_id=24040 | speaker=unknown"
msgid "Beo's annoying."
msgstr "ベオの話はむかつく、と思った。"

msgctxt "text_id=24041 | speaker=unknown"
msgid "Tsukiji and Aozaki's stories don't add up."
msgstr "槻司と蒼崎の話はおかしい、と思った。"

msgctxt "text_id=24042 | speaker=unknown"
msgid "Tsukiji and Beo's stories don't add up."
msgstr "槻司とベオの話はおかしい、と思った。"

msgctxt "text_id=24043 | speaker=unknown"
msgid "Aozaki and Beo's stories don't add up."
msgstr "蒼崎とベオの話はおかしい、と思った。"

msgctxt "text_id=24044 | speaker=unknown"
msgid "Sizuki's story doesn't add up."
msgstr "静希の話はおかしい、と思った。"

msgctxt "text_id=24045 | speaker=unknown"
msgid "Miss Kuonji's story doesn't add up."
msgstr "久遠寺さんの話はおかしい、と思った。"

msgctxt "text_id=24046 | speaker=unknown"
msgid "I don't think what I said adds up."
msgstr "わたしの話は合っているだろうか、と不安に思った。"

msgctxt "text_id=24047 | speaker=unknown"
msgid "Sizuki and Miss Kuonji's stories don't add up."
msgstr "静希と久遠寺さんの話はおかしい、と思った。"

msgctxt "text_id=24048 | speaker=unknown"
msgid "I don't think what Sizuki and I said adds up."
msgstr "静希とわたしの話はおかしい、と思った。"

msgctxt "text_id=24049 | speaker=unknown"
msgid "I don't think what Miss Kuonji and I said adds up."
msgstr "久遠寺さんとわたしの話はおかしい、と思った。"

msgctxt "text_id=24050 | speaker=unknown"
msgid "Father Eiri's story doesn't add up."
msgstr "詠梨神父の話はおかしい、と思った。"

msgctxt "text_id=24051 | speaker=unknown"
msgid "Sister Yuika's story doesn't add up."
msgstr "シスターの話はおかしい、と思った。"

msgctxt "text_id=24052 | speaker=unknown"
msgid "Ritsuka's story doesn't add up."
msgstr "律架さんの話はおかしい、と思った。"

msgctxt "text_id=24053 | speaker=unknown"
msgid "We should each stay in our rooms until morning."
msgstr "それぞれ客室で朝まで過ごすべきでは、と思った。"

msgctxt "text_id=24054 | speaker=unknown"
msgid "We should check Riddell's alibi."
msgstr "その前に、リデルのアリバイ検証もするべきだ、と思った。"

msgctxt "text_id=24055 | speaker=unknown"
msgid "I'll go peek into the hallway."
msgstr "ちらっと廊下を盗み見たい、と思った。"

msgctxt "text_id=24056 | speaker=unknown"
msgid "I think I'll just leave it alone."
msgstr "そっとしておこう、と思った。"

msgctxt "text_id=24057 | speaker=unknown"
msgid "I agree."
msgstr "その意見に賛成するべきだ、と思った。"

msgctxt "text_id=24058 | speaker=unknown"
msgid "Sounds dangerous."
msgstr "それは危険だ、と思った。"

msgctxt "text_id=24059 | speaker=unknown"
msgid "Because there's a 13th person."
msgstr "十三人目の存在がいるからだ、と思った。"

msgctxt "text_id=24060 | speaker=unknown"
msgid "We should focus on how the phone line was cut."
msgstr "電話線がなくなっていた時の、あの違和感について追求するべきだからだ、と思った。"

msgctxt "text_id=24061 | speaker=unknown"
msgid "It's dangerous for Aozaki to go alone."
msgstr "……蒼崎をひとりにするのは危険だ、と思った。"

msgctxt "text_id=24062 | speaker=unknown"
msgid "It's best to wait for all three to return."
msgstr "……ここで三人の帰りを待つべきだ、と思った。"

msgctxt "text_id=24063 | speaker=unknown"
msgid "I don't see this ending well at all."
msgstr "すごい死亡フラグだ、と思った。"

msgctxt "text_id=24064 | speaker=unknown"
msgid "Come to think of it, Beo..."
msgstr "そういえばあの人も……、と思った。"

msgctxt "text_id=24065 | speaker=unknown"
msgid "I can rest easy now."
msgstr "あとは安心して眠れる、と思った。"

msgctxt "text_id=24066 | speaker=unknown"
msgid "I'm not sure about that."
msgstr "……本当にそうだろうか？　と思った。"

msgctxt "text_id=24067 | speaker=unknown"
msgid "Between 2:00PM and 4:00PM?"
msgstr "１４時～１６時の間？　と思った。"

msgctxt "text_id=24068 | speaker=unknown"
msgid "Between 4:00PM and 6:00PM?"
msgstr "１６時～１８時の間？　と思った。"

msgctxt "text_id=24069 | speaker=unknown"
msgid "Between 6:00PM and 8:00PM?"
msgstr "１８時～２０時の間？　と思った。"

msgctxt "text_id=24070 | speaker=unknown"
msgid "Between 8:00PM and 10:00PM?"
msgstr "２０時～２２時の間？　と思った。"

msgctxt "text_id=24071 | speaker=unknown"
msgid "Between 10:00PM and midnight?"
msgstr "２２時～０時の間？　と思った。"

msgctxt "text_id=24072 | speaker=unknown"
msgid "A-As long as I lock the door... but I won't be able to sleep!"
msgstr "か、鍵をかければ安全だし、そんなことされたら逆に眠れない！　と思った。"

msgctxt "text_id=24073 | speaker=unknown"
msgid "No helping it, then."
msgstr "そ、そういうコトなら、仕方がない、と思った。"

msgctxt "text_id=24074 | speaker=unknown"
msgid "Should keep running until morning."
msgstr "朝まで逃げるべきだ、と思った。"

msgctxt "text_id=24075 | speaker=unknown"
msgid "Should try to guess who the killer is."
msgstr "犯人を推理すべきだ、と思った。"

msgctxt "text_id=24076 | speaker=unknown"
msgid "Aoko Aozaki"
msgstr "蒼崎 青子"

msgctxt "text_id=24077 | speaker=unknown"
msgid "Alice Kuonji"
msgstr "久遠寺 有珠"

