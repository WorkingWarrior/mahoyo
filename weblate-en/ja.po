#
msgid ""
msgstr ""
"Language: ja\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Source-Language: en\n"

#. Occurrence 1_0:49:0: scene=1_0
#: 1_0:49
msgctxt "text_id=0 | speaker=unknown"
msgid "  It was a winter's day eight years ago..."
msgstr "　その子の影になったのは８年前の冬のこと。"

#. Occurrence 1_0:55:1: scene=1_0
#: 1_0:55
msgctxt "text_id=1 | speaker=unknown"
msgid "  That solemn morning when she understood the value of life for the very first time."
msgstr "　彼女がはじめて命に<触|ふ>れた、<厳|しず>かな朝の出来事だ。"

#. Occurrence 1_0:124:2: scene=1_0
#: 1_0:124
msgctxt "text_id=2 | speaker=unknown"
msgid "  Her home was nestled on the side of a mountain."
msgstr "　彼女の家は山の<中腹|ちゅうふく>にあった。"

#. Occurrence 1_0:130:3: scene=1_0
#: 1_0:130
msgctxt "text_id=3 | speaker=unknown"
msgid "  Around it was nothing but inhospitable wilderness."
msgstr "　まわりは何もない荒れ地。"

#. Occurrence 1_0:135:4: scene=1_0
#: 1_0:135
msgctxt "text_id=4 | speaker=unknown"
msgid "  She had no neighbors or childhood friends to speak of. Things like traveling to school or playing outside were more trouble than they ought to be."
msgstr "　おとなりに住む<幼馴染|おさななじ>みなんて望むべくもなく、学校に通うのも、遊びに出かけるのも不便なコトこの上ない。"

#. Occurrence 1_0:143:5: scene=1_0
#: 1_0:143
msgctxt "text_id=5 | speaker=unknown"
msgid "  Indeed, with its pure water and bright stars, it was a place rich with memories both frustrating and halcyon."
msgstr "　けれど水も星も綺麗な、ちょっとの不満と大きな安らぎのある、思い出の家だった。"

#. Occurrence 1_0:163:6: scene=1_0
#: 1_0:163
msgctxt "text_id=6 | speaker=unknown"
msgid "  That was only during summer, though."
msgstr "　もっとも、それは夏だけの話。"

#. Occurrence 1_0:172:7: scene=1_0
#: 1_0:172
msgctxt "text_id=7 | speaker=unknown"
msgid "  Winters in those mountains were extremely frigid, each morning more severe than the last."
msgstr "　山中の冬は寒すぎて、朝はいつも辛かった。"

#. Occurrence 1_0:177:8: scene=1_0
#: 1_0:177
msgctxt "text_id=8 | speaker=unknown"
msgid "  Her father would drive her to the train station..."
msgstr "　お父さんは自動車で駅まで送ってくれるけれど、"

#. Occurrence 1_0:177:9: scene=1_0
#: 1_0:177
msgctxt "text_id=9 | speaker=unknown"
msgid "  ...after waiting ten minutes for the engine to warm up and the iced-over windows to clear."
msgstr "　車の窓はびっしり<霜|しも>だらけで、出かける何十分か前にエンジンをかけないと走りだせない。"

#. Occurrence 1_0:205:10: voice_id=F70_1_0_0000_A; voice_prefix=F70; voice_category=0; scene=1_0
#: 1_0:205
msgctxt "text_id=10 | speaker=unknown"
msgid "\"Mind starting up the car for me?\""
msgstr "「　　、キーを回してきてくれるかい？」"

#. Occurrence 1_0:211:11: scene=1_0
#: 1_0:211
msgctxt "text_id=11 | speaker=unknown"
msgid "  Her father would savor his morning coffee, leaving her to venture outside and rev the engine."
msgstr "　お父さんが食後のコーヒーを楽しんでいる時、外に出て車のエンジンをかけるのが彼女の日課だった。"

#. Occurrence 1_0:231:12: scene=1_0
#: 1_0:231
msgctxt "text_id=12 | speaker=unknown"
msgid "  Out the front door she would go, traversing the garden with icy breath, until she reached that old sedan."
msgstr "　玄関を出て、白い息をはきながら庭を横ぎって、年代物のセダンのドアを開ける。"

#. Occurrence 1_0:237:13: scene=1_0
#: 1_0:237
msgctxt "text_id=13 | speaker=unknown"
msgid "  As always, she inserted the key, then started the ignition."
msgstr "　いつも通りにキーを差し込んでぐるりと回して、"

msgctxt "text_id=14 | speaker=unknown"
msgid "The engine rumbled to life."
msgstr "　ぶるるるる、とエンジンを振動させる。"

#. Occurrence 1_0:245:15: scene=1_0
#: 1_0:245
msgctxt "text_id=15 | speaker=unknown"
msgid "  Just as she proudly finished that humble task she'd done so many times before..."
msgstr "　そんな、今まで何十回とくり返してきた、小さな彼女の誇らしげな仕事が終わったとき。"

#. Occurrence 1_0:266:16: voice_id=C80_1_0_0000; voice_prefix=C80; voice_category=0; scene=1_0
#: 1_0:266
msgctxt "text_id=16 | speaker=unknown"
msgid "\"■■■■■―\""
msgstr "『■■■■■―――』"

#. Occurrence 1_0:272:17: scene=1_0
#: 1_0:272
msgctxt "text_id=17 | speaker=unknown"
msgid "  A shrill scream pierced the air."
msgstr "　<甲|カン>高い悲鳴が<響|ひび>く。"

#. Occurrence 1_0:277:18: scene=1_0
#: 1_0:277
msgctxt "text_id=18 | speaker=unknown"
msgid "  She knew, even though it wasn't human, that the feeble sound was a cry of agony."
msgstr "　彼女は人間の言葉でもないのに、痛いと泣き叫ぶような、小さな小さな<音|こえ>を聞いた。"

#. Occurrence 1_0:297:19: scene=1_0
#: 1_0:297
msgctxt "text_id=19 | speaker=unknown"
msgid "  A few moments passed."
msgstr "　数分後。"

#. Occurrence 1_0:303:20: scene=1_0
#: 1_0:303
msgctxt "text_id=20 | speaker=unknown"
msgid "Her father came out and opened the hood of the car."
msgstr "お父さんが車のボンネットを開けると、そこにはひとつの命があった。"

#. Occurrence 1_0:328:21: scene=1_0
#: 1_0:328
msgctxt "text_id=21 | speaker=unknown"
msgid "  Creaking fan belts..."
msgstr "　ギチギチしたベルトとか、"

#. Occurrence 1_0:333:22: scene=1_0
#: 1_0:333
msgctxt "text_id=22 | speaker=unknown"
msgid "  A monstrous-looking engine..."
msgstr "　怪物みたいなエンジンが、"

#. Occurrence 1_0:338:23: scene=1_0
#: 1_0:338
msgctxt "text_id=23 | speaker=unknown"
msgid "  And something that didn't belong."
msgstr "　びっちりと押しこまれたハコの中。"

#. Occurrence 1_0:344:24: scene=1_0
#: 1_0:344
msgctxt "text_id=24 | speaker=unknown"
msgid "  There was a cat―a mother by the looks of it―and her two kittens."
msgstr "　母親であろう猫と、二匹の子猫の姿は、あまりにも<場違|ばちが>いだった。"

#. Occurrence 1_0:364:25: scene=1_0
#: 1_0:364
msgctxt "text_id=25 | speaker=unknown"
msgid "  The three cats had been huddling for warmth in the engine's compartment."
msgstr "　三匹の猫はエンジンルームの中で、寄りそうように丸まっていた。"

#. Occurrence 1_0:370:26: scene=1_0
#: 1_0:370
msgctxt "text_id=26 | speaker=unknown"
msgid "  The mother cat was missing its head."
msgstr "　母親の猫は首から上がない。"

#. Occurrence 1_0:375:27: scene=1_0
#: 1_0:375
msgctxt "text_id=27 | speaker=unknown"
msgid "  One of the kittens had been mangled beyond recognition by the engine belts, and surely died instantly."
msgstr "　子猫のうち一匹は、<機械|ベルト>に巻きこまれた部分が多すぎて動きがない。きっと即死だったろう。"

#. Occurrence 1_0:395:28: scene=1_0
#: 1_0:395
msgctxt "text_id=28 | speaker=unknown"
msgid "  The other kitten, its face half-covered in blood, panted faintly."
msgstr "　残った子猫は顔の半分を真っ赤にして、雨に濡れたやせ犬みたいに、ヒューヒューと息をしていた。"

#. Occurrence 1_0:401:29: scene=1_0
#: 1_0:401
msgctxt "text_id=29 | speaker=unknown"
msgid "  It desperately clung to its mother―or rather, the chunk of meat that had been its mother―with the last bit of life it could muster."
msgstr "　子猫はその<亡骸|なきがら>―――いや、半ば肉片となった親猫に寄りそいながら、おそらくはあと数分たらずの命で、<懸命|けんめい>に懸命に、母親の胸にすがっていた。"

#. Occurrence 1_0:424:30: voice_id=F70_1_0_0001_A; voice_prefix=F70; voice_category=0; scene=1_0
#: 1_0:424
msgctxt "text_id=30 | speaker=unknown"
msgid "\"Poor things.\""
msgstr "「かわいそうに―――」"

#. Occurrence 1_0:430:31: scene=1_0
#: 1_0:430
msgctxt "text_id=31 | speaker=unknown"
msgid "  Her father lamented their plight."
msgstr "　<悼|いた>むようなお父さんの声。"

#. Occurrence 1_0:450:32: scene=1_0
#: 1_0:450
msgctxt "text_id=32 | speaker=unknown"
msgid "  The previous night had been especially cold."
msgstr "　昨夜の冷えこみは一段と厳しかった。"

#. Occurrence 1_0:455:33: scene=1_0
#: 1_0:455
msgctxt "text_id=33 | speaker=unknown"
msgid "  After he had returned home yesterday, the cats must have snuck under the hood, drawn by the warmth of the engine."
msgstr "　お父さんが車で帰ってきた後、エンジンの暖気に誘われて猫たちはボンネットに忍びこんだのだ。"

#. Occurrence 1_0:461:34: scene=1_0
#: 1_0:461
msgctxt "text_id=34 | speaker=unknown"
msgid "  They had slept next to the engine..."
msgstr "　彼らはエンジンルームで夜を明かし、"

msgctxt "text_id=35 | speaker=unknown"
msgid "  ...and awoken to a storm of spinning belts."
msgstr "　翌朝、ベルトの回転に巻きこまれて目を覚ました。"

#. Occurrence 1_0:469:36: scene=1_0
#: 1_0:469
msgctxt "text_id=36 | speaker=unknown"
msgid "  Cars in the eighties were not sealed particularly well, so this was not unheard of."
msgstr "　気密性の<乏|とぼ>しい80年代の車には、それなりにあった話らしい。"

#. Occurrence 1_0:497:37: voice_id=F70_1_0_0002_A; voice_prefix=F70; voice_category=0; scene=1_0
#: 1_0:497
msgctxt "text_id=37 | speaker=unknown"
msgid "\"...It's okay, ____. It wasn't your fault.\""
msgstr "「―――いいんだ。　　が悪いんじゃないんだよ」"

#. Occurrence 1_0:503:38: scene=1_0
#: 1_0:503
msgctxt "text_id=38 | speaker=unknown"
msgid "  Her father's voice seemed distant."
msgstr "　お父さんの声が遠い。"

#. Occurrence 1_0:523:39: scene=1_0
#: 1_0:523
msgctxt "text_id=39 | speaker=unknown"
msgid "  She could only make out a small tuft of the kitten's gray fur."
msgstr "　灰色にささくれだった子猫の毛並み。"

#. Occurrence 1_0:528:40: scene=1_0
#: 1_0:528
msgctxt "text_id=40 | speaker=unknown"
msgid "  The rest of it was caked in the blood of its mother and brother."
msgstr "　母親と兄弟の血と、半身をけずられた自らの血で、"

#. Occurrence 1_0:534:41: scene=1_0
#: 1_0:534
msgctxt "text_id=41 | speaker=unknown"
msgid "        ...I can see its skull..."
msgstr "　　　　―――ああ、丸い頭蓋骨が見えている―――"

#. Occurrence 1_0:549:42: scene=1_0
#: 1_0:549
msgctxt "text_id=42 | speaker=unknown"
msgid "  The fragile life of a speckled kitten..."
msgstr "　まだらに染まった小さな命。"

#. Occurrence 1_0:554:43: scene=1_0
#: 1_0:554
msgctxt "text_id=43 | speaker=unknown"
msgid "  Trembling and possibly blind, it continued to nuzzle against its dead mother's chest."
msgstr "　子猫はもう目も見えないのか、<震|ふる>えながら、一心に死んだ母親の胸にくるまっている。"

#. Occurrence 1_0:600:44: voice_id=F70_1_0_0003_A; voice_prefix=F70; voice_category=0; scene=1_0
#: 1_0:600
msgctxt "text_id=44 | speaker=unknown"
msgid "\"Hmm? ____, wait!\""
msgstr "「　　……？　待ちなさい、　　―――！」"

#. Occurrence 1_0:606:45: scene=1_0
#: 1_0:606
msgctxt "text_id=45 | speaker=unknown"
msgid "  She took the kitten into her arms"
msgstr "　彼女は子猫を抱き上げ、"

#. Occurrence 1_0:606:46: scene=1_0
#: 1_0:606
msgctxt "text_id=46 | speaker=unknown"
msgid "  and ran deep into the mountains, to her grandfather's house."
msgstr "　山奥に別居している祖父の元へ走った。"

#. Occurrence 1_0:612:47: scene=1_0
#: 1_0:612
msgctxt "text_id=47 | speaker=unknown"
msgid "  Was it because she was overcome with regret?"
msgstr "　後悔で動揺していたのか、"

#. Occurrence 1_0:617:48: scene=1_0
#: 1_0:617
msgctxt "text_id=48 | speaker=unknown"
msgid "  Or was it the shock of grief? Years later, she still wasn't sure."
msgstr "　悲しくて混乱していたのか、正直、今でも分からない。"

#. Occurrence 1_0:637:49: scene=1_0
#: 1_0:637
msgctxt "text_id=49 | speaker=unknown"
msgid "  Fighting back the welling tears, she burst into her grandfather's workshop."
msgstr "　彼女はこみあげる涙をせいいっぱい我慢しながら、祖父の工房に飛びこんだ。"

#. Occurrence 1_0:657:50: scene=1_0
#: 1_0:657
msgctxt "text_id=50 | speaker=unknown"
msgid "  Her grandfather was a magician who could do anything."
msgstr "　祖父は何でもできる魔法使いだった。"

#. Occurrence 1_0:662:51: scene=1_0
#: 1_0:662
msgctxt "text_id=51 | speaker=unknown"
msgid "  She had never seen magic. She knew that magic was a fantasy straight out of fairy tales... but so was her grandfather."
msgstr "　彼女自身「魔法」なんて見たコトもないし、おとぎ話の空想だと分かっていたけれど、そんな常識とは違う基準で、祖父はそういう生き物なんだと知っていた。"

#. Occurrence 1_0:676:52: scene=1_0
#: 1_0:676
msgctxt "text_id=52 | speaker=unknown"
msgid "  She had to find him."
msgstr "　だから。"

#. Occurrence 1_0:681:53: scene=1_0
#: 1_0:681
msgctxt "text_id=53 | speaker=unknown"
msgid "  He was the only one who could help."
msgstr "　祖父ならきっと、助けてくれると思ったのだ。"

#. Occurrence 1_0:703:54: voice_id=F60_1_0_0000; voice_prefix=F60; voice_category=0; scene=1_0
#: 1_0:703
msgctxt "text_id=54 | speaker=unknown"
msgid "\"I suppose you want me to alter this kitten's fate,\""
msgstr "『その子猫の運命を変えろと言う』"

#. Occurrence 1_0:734:55: scene=1_0
#: 1_0:734
msgctxt "text_id=55 | speaker=unknown"
msgid "  the cave-dwelling magician said indifferently."
msgstr "　洞窟に<棲|す>む魔法使いは、関心のない声で言った。"

#. Occurrence 1_0:754:56: scene=1_0
#: 1_0:754
msgctxt "text_id=56 | speaker=unknown"
msgid "  \"This kitten needs our help,\" she pleaded."
msgstr "　助けたい、と彼女は<懇願|こんがん>する。"

#. Occurrence 1_0:759:57: scene=1_0
#: 1_0:759
msgctxt "text_id=57 | speaker=unknown"
msgid "  Whether it was a simple task,"
msgstr "　魔法使いはおやすいご用だとも、"

#. Occurrence 1_0:764:58: scene=1_0
#: 1_0:764
msgctxt "text_id=58 | speaker=unknown"
msgid "  or a herculean labor, her grandfather would not say."
msgstr "　それは世界を<換|か>える<大事|だいじ>だとも言わず、"

#. Occurrence 1_0:770:59: scene=1_0
#: 1_0:770
msgctxt "text_id=59 | speaker=unknown"
msgid "  He simply granted the girl's childish wish, like a machine."
msgstr "　まるで機械みたいにあっさりと、彼女の身勝手な願いを叶えてやった。"

#. Occurrence 1_0:854:60: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A11_1_0_0000; voice_prefix=A11; voice_category=1; scene=1_0
#: 1_0:854
msgctxt "text_id=60 | speaker=aoko"
msgid "\"...Oh no,\" the girl said."
msgstr "『…………あ』"

#. Occurrence 1_0:860:61: scene=1_0
#: 1_0:860
msgctxt "text_id=61 | speaker=unknown"
msgid "  Before she knew it, however, she was holding a tiny corpse in her hands."
msgstr "　気が付くと彼女の手には小さな<亡骸|なきがら>。"

#. Occurrence 1_0:865:62: scene=1_0
#: 1_0:865
msgctxt "text_id=62 | speaker=unknown"
msgid "  Its fur was cold."
msgstr "　冷えきった毛なみ。"

#. Occurrence 1_0:870:63: scene=1_0
#: 1_0:870
msgctxt "text_id=63 | speaker=unknown"
msgid "  The warmth of life had left its body."
msgstr "　とうに命の温度は消えていた。"

#. Occurrence 1_0:875:64: scene=1_0
#: 1_0:875
msgctxt "text_id=64 | speaker=unknown"
msgid "  And the tears she had fought so hard to hold back poured from her eyes."
msgstr "　流すまいと<律|りっ>していた涙が、瞳からこぼれている。"

#. Occurrence 1_0:881:65: scene=1_0
#: 1_0:881
msgctxt "text_id=65 | speaker=unknown"
msgid "  Regret spread through her chest like an endless gray sky."
msgstr "　胸には灰色の空みたいに果てのない、大きすぎる後悔の念。"

#. Occurrence 1_0:915:66: voice_id=F60_1_0_0001; voice_prefix=F60; voice_category=0; scene=1_0
#: 1_0:915
msgctxt "text_id=66 | speaker=unknown"
msgid "\"We were too late. Some things cannot be undone.\""
msgstr "『徒労だったな。結局、元に戻すとは』"

#. Occurrence 1_0:947:67: scene=1_0
#: 1_0:947
msgctxt "text_id=67 | speaker=unknown"
msgid "  Her mind struggled to come to grips with what had just occurred."
msgstr "　何が起こったのか、彼女には把握できない。"

#. Occurrence 1_0:967:68: scene=1_0
#: 1_0:967
msgctxt "text_id=68 | speaker=unknown"
msgid "  The last ten minutes were a total blank."
msgstr "　この十分間の空白に何を経験して、"

#. Occurrence 1_0:972:69: scene=1_0
#: 1_0:972
msgctxt "text_id=69 | speaker=unknown"
msgid "  Who she met..."
msgstr "　誰と出会い、"

#. Occurrence 1_0:977:70: scene=1_0
#: 1_0:977
msgctxt "text_id=70 | speaker=unknown"
msgid "  What she had known... It was all as if it never happened."
msgstr "　何を知ったのかも、無責任にも元通り。"

#. Occurrence 1_0:982:71: scene=1_0
#: 1_0:982
msgctxt "text_id=71 | speaker=unknown"
msgid "  The only thing she was sure of was that life, once extinguished, can never return."
msgstr "　確かなコトは、死に行く命は戻らないという事と、"

#. Occurrence 1_0:994:72: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A11_1_0_0001; voice_prefix=A11; voice_category=1; scene=1_0
#: 1_0:994
msgctxt "text_id=72 | speaker=aoko"
msgid "        \"Umm... Is somebody there?\""
msgstr "　　　　「あの―――そこにだれか、いるの？」"

#. Occurrence 1_0:1001:73: scene=1_0
#: 1_0:1001
msgctxt "text_id=73 | speaker=unknown"
msgid "  That day..."
msgstr "　その日。"

#. Occurrence 1_0:1006:74: scene=1_0
#: 1_0:1006
msgctxt "text_id=74 | speaker=unknown"
msgid "  It was her mistake that gave birth to me."
msgstr "　私という、彼女が生まれた<過|あやま>ちだけ。"

#. Occurrence 1_0:1040:75: scene=1_0
#: 1_0:1040
msgctxt "text_id=75 | speaker=unknown"
msgid "            ...Indeed."
msgstr "　　　　　　………ああ。"

#. Occurrence 1_0:1046:76: scene=1_0
#: 1_0:1046
msgctxt "text_id=76 | speaker=unknown"
msgid "            Whatever occurred that day,"
msgstr "　　　　　　何にせよ、"

msgctxt "text_id=77 | speaker=unknown"
msgid "            it was a day of nostalgia and longing."
msgstr "　　　　　　全てが<懐|なつ>かしく、待ち遠しい。"

#. Occurrence 1_0:1091:78: scene=1_0
#: 1_0:1091
msgctxt "text_id=78 | speaker=unknown"
msgid "  This is the fairy tale of eight years ago."
msgstr "　それは<現実|イマ>から８年前のおとぎ話。"

#. Occurrence 1_0:1096:79: scene=1_0
#: 1_0:1096
msgctxt "text_id=79 | speaker=unknown"
msgid "  The day they first met, that no magic can ever bring back."
msgstr "　どんな魔法を使っても取り戻せない、いちばん初めに、彼女たちの出会った日。"

#. Occurrence 1_1:69:80: scene=1_1
#: 1_1:69
msgctxt "text_id=80 | speaker=unknown"
msgid "  Arrogant, greedy, and able only to destroy..."
msgstr "　<傲慢|ごうまん>で<貪欲|どんよく>で、壊すことしか能のない、"

msgctxt "text_id=81 | speaker=unknown"
msgid "  I must be a wolf."
msgstr "　私はきっと狼だ。"

#. Occurrence 1_1:77:82: scene=1_1
#: 1_1:77
msgctxt "text_id=82 | speaker=unknown"
msgid "  I don't have regrets. There's no looking back."
msgstr "　かえりみなくてふり向かなくて、"

msgctxt "text_id=83 | speaker=unknown"
msgid "  If my pride has left you behind, my sincere condolences."
msgstr "　気づかないままむねをはり、<独|ひと>りになるならご愁傷さま。"

#. Occurrence 1_1:87:84: scene=1_1
#: 1_1:87
msgctxt "text_id=84 | speaker=unknown"
msgid "  But at any rate,"
msgstr "　いずれあっさり、"

msgctxt "text_id=85 | speaker=unknown"
msgid "  I suppose it's my fate to die at the hands of Little Red Riding Hood."
msgstr "　赤ずきんに<退治|ころ>されるのが定めでしょう―――"

#. Occurrence 1_1:145:86: scene=1_1
#: 1_1:145
msgctxt "text_id=86 | speaker=unknown"
msgid "  It was a quiet morning."
msgstr "　それは、静かな朝だった。"

#. Occurrence 1_1:169:87: scene=1_1
#: 1_1:169
msgctxt "text_id=87 | speaker=unknown"
msgid "  From her bed, she could see the sky was an ashen, watercolor gray."
msgstr "　ベッドから<覗|のぞ>く空模様が絵の具を塗りたくったような灰色でも、"

#. Occurrence 1_1:174:88: scene=1_1
#: 1_1:174
msgctxt "text_id=88 | speaker=unknown"
msgid "  The thermometer displayed 43 degrees Fahrenheit, a rather unforgiving temperature for November."
msgstr "　温度計は六度前後と十一月にしては容赦のない<数値|きろく>をたたきだしていても、"

#. Occurrence 1_1:179:89: scene=1_1
#: 1_1:179
msgctxt "text_id=89 | speaker=unknown"
msgid "  Her stomach woke her up with a growl, pathetically reminding her that she had completely missed breakfast."
msgstr "　朝食<時|どき>はとっくに過ぎていて、情けないコトに空腹なんかで目を覚ましたとしても。"

#. Occurrence 1_1:185:90: scene=1_1
#: 1_1:185
msgctxt "text_id=90 | speaker=unknown"
msgid "  But lazy mornings like today's were, for her, a blessing."
msgstr "　こうして<緩慢|かんまん>に眠っていられるだけで、彼女にとって、今日の朝は幸福なものだった。"

#. Occurrence 1_1:279:91: scene=1_1
#: 1_1:279
msgctxt "text_id=91 | speaker=unknown"
msgid "  It was already well past eight in the morning."
msgstr "　時計はとうに朝の八時を回っている。"

#. Occurrence 1_1:284:92: scene=1_1
#: 1_1:284
msgctxt "text_id=92 | speaker=unknown"
msgid "  On any ordinary weekday tardiness would be unavoidable, but today, classes were cancelled in commemoration of the school's anniversary."
msgstr "　平日なら絶望的な時間、どうあがいても遅刻確定な状態だが、今日は創立記念日につき休校だ。"

#. Occurrence 1_1:289:93: scene=1_1
#: 1_1:289
msgctxt "text_id=93 | speaker=unknown"
msgid "  Gratefully, she had every intention of taking it easy for the first time in ages."
msgstr "　おかげで久しぶりに、のんびりと朝を過ごす事ができる。"

#. Occurrence 1_1:309:94: scene=1_1
#: 1_1:309
msgctxt "text_id=94 | speaker=unknown"
msgid "  Outside the window was a gloomy gray, and it reminded her more of evening than morning."
msgstr "　くり返すが、窓の外は<陰鬱|いんうつ>とした鋼色で、朝というより夕方を思わせる。"

#. Occurrence 1_1:314:95: scene=1_1
#: 1_1:314
msgctxt "text_id=95 | speaker=unknown"
msgid "  It wasn't a pleasant morning by any stretch of the imagination."
msgstr "　お世辞にも気持ちいい朝とは言えない。"

#. Occurrence 1_1:320:96: scene=1_1
#: 1_1:320
msgctxt "text_id=96 | speaker=unknown"
msgid "  But having been up all night until just three hours ago, she couldn't care less about the weather outside."
msgstr "　が、つい三時間前まで夜通し起きていた彼女にとって、外の天気なんてどうでもいい事だった。"

#. Occurrence 1_1:340:97: scene=1_1
#: 1_1:340
msgctxt "text_id=97 | speaker=unknown"
msgid "  All she cared about was more sleep."
msgstr "　いまは何より眠気がすべて。"

#. Occurrence 1_1:346:98: scene=1_1
#: 1_1:346
msgctxt "text_id=98 | speaker=unknown"
msgid "  As long as she could spend her morning in bed, what was happening outside was of no concern to her."
msgstr "　ベッドで<微睡|まどろ>めるなら気持ちのいい朝なわけで、外の事情なんて当局は一切関知いたしません―――と、窓の向こうをシャットアウト。"

#. Occurrence 1_1:400:99: scene=1_1
#: 1_1:400
msgctxt "text_id=99 | speaker=unknown"
msgid "  She shut the curtains."
msgstr "　カーテンを閉める。"

#. Occurrence 1_1:521:100: scene=1_1
#: 1_1:521
msgctxt "text_id=100 | speaker=unknown"
msgid "  Then closed her eyes and tried to let sleep reclaim her."
msgstr "　再び<瞼|まぶた>を閉じて、すみやかに眠りに戻ろうと努力する。"

#. Occurrence 1_1:530:101: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_1_0000; voice_prefix=A10; voice_category=1; scene=1_1
#: 1_1:530
msgctxt "text_id=101 | speaker=aoko"
msgid "\"I'd like a nice uneventful dream for two hours, thank you.\""
msgstr "“……せめてあと二時間ぐらいは<凡庸|ぼんよう>な夢を見ていられますように。”"

#. Occurrence 1_1:536:102: scene=1_1
#: 1_1:536
msgctxt "text_id=102 | speaker=unknown"
msgid "  Blissful slumber found her soon enough."
msgstr "　眠気はじゅうぶん残っていて、すぐに幸せはやってきた。"

#. Occurrence 1_1:541:103: scene=1_1
#: 1_1:541
msgctxt "text_id=103 | speaker=unknown"
msgid "  Her consciousness faded."
msgstr "　意識は沈むように落ちていく。"

#. Occurrence 1_1:562:104: scene=1_1
#: 1_1:562
msgctxt "text_id=104 | speaker=unknown"
msgid "  However..."
msgstr "　しかし。"

#. Occurrence 1_1:567:105: scene=1_1
#: 1_1:567
msgctxt "text_id=105 | speaker=unknown"
msgid "  ...her simple request would be mercilessly refused."
msgstr "　彼女のささやかな願いは、容赦なく却下された。"

#. Occurrence 1_1:590:106: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_1_0001; voice_prefix=A10; voice_category=1; scene=1_1
#: 1_1:590
msgctxt "text_id=106 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 1_1:596:107: scene=1_1
#: 1_1:596
msgctxt "text_id=107 | speaker=unknown"
msgid "  A faint but shrill sound lingered in her ears."
msgstr "　小さいクセにカン高く耳に残る。"

#. Occurrence 1_1:601:108: scene=1_1
#: 1_1:601
msgctxt "text_id=108 | speaker=unknown"
msgid "  It was the unmistakable ring of a telephone."
msgstr "　間違いなく電話の音だ。"

#. Occurrence 1_1:606:109: scene=1_1
#: 1_1:606
msgctxt "text_id=109 | speaker=unknown"
msgid "  Much to her chagrin, her eyes popped open out of habit."
msgstr "　習慣のなせる業だろう。閉じたばかりの瞼は、彼女の意思とは正反対にぱちりと開く。"

#. Occurrence 1_1:627:110: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_1_0002; voice_prefix=A10; voice_category=1; scene=1_1
#: 1_1:627
msgctxt "text_id=110 | speaker=aoko"
msgid "\"Oh, c'mon. Why today of all days?\""
msgstr "“こんな日にかぎって……”"

#. Occurrence 1_1:633:111: scene=1_1
#: 1_1:633
msgctxt "text_id=111 | speaker=unknown"
msgid "  The telephone was situated in the foyer on the first floor."
msgstr "　受話器は一階のロビーに設置されている。"

#. Occurrence 1_1:640:112: scene=1_1
#: 1_1:640
msgctxt "text_id=112 | speaker=unknown"
msgid "  Answering it meant walking down a thirty-foot corridor and going down a flight of stairs."
msgstr "　この部屋からでは廊下十メートル分と、階段一つ分離れた先だ。"

#. Occurrence 1_1:645:113: scene=1_1
#: 1_1:645
msgctxt "text_id=113 | speaker=unknown"
msgid "  In her sleep-deprived state, that distance seemed somewhere between incredibly far and astronomically far."
msgstr "　寝不足の彼女にとって、その距離は遥かと<彼方|かなた>の中間ぐらい遠かった。"

#. Occurrence 1_1:683:114: scene=1_1
#: 1_1:683
msgctxt "text_id=114 | speaker=unknown"
msgid "  The phone's incessant ringing continued."
msgstr "　……電話の音は<辛抱|しんぼう>強く鳴り響いている。"

#. Occurrence 1_1:688:115: scene=1_1
#: 1_1:688
msgctxt "text_id=115 | speaker=unknown"
msgid "  She knew the caller would eventually give up if she ignored it, but she chose to fight the urge."
msgstr "　無視してしまえばいずれ止むにしても、それができるほど、彼女は自分に優しくはなかった。"

#. Occurrence 1_1:769:116: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_1_0003; voice_prefix=A10; voice_category=1; scene=1_1
#: 1_1:769
msgctxt "text_id=116 | speaker=aoko"
msgid "\"Why doesn't Alice answer it?\""
msgstr "「……<有珠|ありす>、でないの？」"

#. Occurrence 1_1:775:117: scene=1_1
#: 1_1:775
msgctxt "text_id=117 | speaker=unknown"
msgid "  She thought her housemate would get it, but she soon had to abandon all hope."
msgstr "　未練がましく同居人の活躍に期待してみたものの、すぐに<諦|あきら>めた。"

#. Occurrence 1_1:780:118: scene=1_1
#: 1_1:780
msgctxt "text_id=118 | speaker=unknown"
msgid "  The realization struck that her housemate did not have the day off from school and was likely in class at her prestigious little hilltop academy."
msgstr "　考えてみれば休日なのは自分の<学校|ところ>だけで、同居人は丘の上の学院のお嬢様だ。とっくに学校に行っている。"

#. Occurrence 1_1:829:119: scene=1_1
#: 1_1:829
msgctxt "text_id=119 | speaker=unknown"
msgid "  The caller proved incredibly persistent."
msgstr "　電話の根気強さは並ではない。"

#. Occurrence 1_1:834:120: scene=1_1
#: 1_1:834
msgctxt "text_id=120 | speaker=unknown"
msgid "  That persistence made the volume of the ringing seem even louder."
msgstr "　そのあまりのしつこさに、気持ち、ボリュームがランクアップして聞こえる。"

#. Occurrence 1_1:855:121: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_1_0004; voice_prefix=A10; voice_category=1; scene=1_1
#: 1_1:855
msgctxt "text_id=121 | speaker=aoko"
msgid "\"Ugh. I'm trying to sleep here!\""
msgstr "「ああもう、せっかくの安眠を……！」"

#. Occurrence 1_1:898:122: scene=1_1
#: 1_1:898
msgctxt "text_id=122 | speaker=unknown"
msgid "  She was left with no choice but to get up, throw a top on, and leave the room."
msgstr "　仕方なくベッドから出て、軽く上着を羽織って、彼女は部屋を後にする。"

#. Occurrence 1_1:951:123: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_1_0005; voice_prefix=A10; voice_category=1; scene=1_1
#: 1_1:951
msgctxt "text_id=123 | speaker=aoko"
msgid "\"God, it's cold...\""
msgstr "「うわ、さむ―――」"

#. Occurrence 1_1:957:124: scene=1_1
#: 1_1:957
msgctxt "text_id=124 | speaker=unknown"
msgid "  She rubbed her hands together to warm her numb fingers."
msgstr "　手を合わせて、かじかむ指を温める。"

#. Occurrence 1_1:962:125: scene=1_1
#: 1_1:962
msgctxt "text_id=125 | speaker=unknown"
msgid "  The mansion's heating system was inadequate, to say the least."
msgstr "　この屋敷は暖房設備が<乏|とぼ>しい。"

#. Occurrence 1_1:967:126: scene=1_1
#: 1_1:967
msgctxt "text_id=126 | speaker=unknown"
msgid "  Which meant that Winter was the very worst of uninvited guests."
msgstr "　なので、冬の気温は恐るべき難敵だ。"

#. Occurrence 1_1:1002:127: scene=1_1
#: 1_1:1002
msgctxt "text_id=127 | speaker=unknown"
msgid "  Never more so than on a dreary morning as this, when one didn't need to use a thermometer to know how cold it was."
msgstr "　<曇|くも>りに曇った朝なら尚更で、温度計を見なくても真冬なみの寒さと分かる。"

#. Occurrence 1_1:1007:128: scene=1_1
#: 1_1:1007
msgctxt "text_id=128 | speaker=unknown"
msgid "  The mansion sat in the mountains and was surrounded by dense forest. Winter always arrived here first, before moving on to nearby towns."
msgstr "　この屋敷はちょっとした山中にあり、周りはそれなりに深い森なので、街より冬の到来が早いのだ。"

#. Occurrence 1_1:1052:129: scene=1_1
#: 1_1:1052
msgctxt "text_id=129 | speaker=unknown"
msgid "  The robotic ring of the telephone reverberated throughout the long hallway."
msgstr "　長い廊下に、無機質なコール音が反響していく。"

#. Occurrence 1_1:1057:130: scene=1_1
#: 1_1:1057
msgctxt "text_id=130 | speaker=unknown"
msgid "  The mansion's furnishings had been so perfectly maintained that it made the place feel unlived."
msgstr "　館内の調度品はそれなりに手入れされているものの、生活臭は感じられない。"

#. Occurrence 1_1:1062:131: scene=1_1
#: 1_1:1062
msgctxt "text_id=131 | speaker=unknown"
msgid "  It seemed lonelier than it did splendid."
msgstr "　豪華さより<淋|さび>しさが強く出ている。"

#. Occurrence 1_1:1067:132: scene=1_1
#: 1_1:1067
msgctxt "text_id=132 | speaker=unknown"
msgid "  Coupled with the dreary morning, it could have passed for a haunted house."
msgstr "　薄暗い朝の様子もあいまって幽霊屋敷に見えなくもない。"

#. Occurrence 1_1:1128:133: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_1_0006; voice_prefix=A10; voice_category=1; scene=1_1
#: 1_1:1128
msgctxt "text_id=133 | speaker=aoko"
msgid "\"Well, it is a haunted house, I suppose."
msgstr "「……ま、幽霊屋敷そのものだけど。"

#. Occurrence 1_1:1134:134: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_1_0007; voice_prefix=A10; voice_category=1; scene=1_1
#: 1_1:1134
msgctxt "text_id=134 | speaker=aoko"
msgid "  It's too large for just the two of us.\""
msgstr "　だいたいふたりで住むには広すぎるのよ、この家は」"

#. Occurrence 1_1:1182:135: scene=1_1
#: 1_1:1182
msgctxt "text_id=135 | speaker=unknown"
msgid "  She counted more than thirty rings since it first began."
msgstr "　コール数はもう三十を超えていた。"

#. Occurrence 1_1:1187:136: scene=1_1
#: 1_1:1187
msgctxt "text_id=136 | speaker=unknown"
msgid "  The caller either had a lot of free time on their hands or had a good understanding of the house's circumstances."
msgstr "　相手はよっぽど暇なのか、それとも、この家の事情が分かっているのか。"

#. Occurrence 1_1:1192:137: scene=1_1
#: 1_1:1192
msgctxt "text_id=137 | speaker=unknown"
msgid "  She had a strong hunch that it was the latter."
msgstr "　彼女は後者だと直感した。"

#. Occurrence 1_1:1213:138: scene=1_1
#: 1_1:1213
msgctxt "text_id=138 | speaker=unknown"
msgid "  The window above looked out onto a gloomy sky."
msgstr "　見上げた窓は憂鬱な色。"

#. Occurrence 1_1:1219:139: scene=1_1
#: 1_1:1219
msgctxt "text_id=139 | speaker=unknown"
msgid "  She hastened to catch the unrelenting ring in the act as soon as possible."
msgstr "　自重しない電話の音を捕まえるように歩を速める。"

#. Occurrence 1_1:1225:140: scene=1_1
#: 1_1:1225
msgctxt "text_id=140 | speaker=unknown"
msgid "  Though she had a feeling that her happy morning might come to a close the moment she caught it."
msgstr "　たぶん、捕まえた瞬間に、幸せな朝は<泡|あわ>と消えると予感しながら。"

#. Occurrence 1_1:1267:141: scene=1_1
#: 1_1:1267
msgctxt "text_id=141 | speaker=unknown"
msgid "  It was here that a series of incidents began."
msgstr "　ともあれ、これが一連の事件の最初の話。"

#. Occurrence 1_1:1273:142: scene=1_1
#: 1_1:1273
msgctxt "text_id=142 | speaker=unknown"
msgid "  Apologies for the lack of romance to this tale."
msgstr "　浪漫が足りないのは、どうか大目に見てほしい。"

#. Occurrence 1_1:1278:143: scene=1_1
#: 1_1:1278
msgctxt "text_id=143 | speaker=unknown"
msgid "  For whether it be objectively true or merely supposition..."
msgstr "　統計というか、通説というか。"

#. Occurrence 1_1:1285:144: scene=1_1
#: 1_1:1285
msgctxt "text_id=144 | speaker=unknown"
msgid "  ...it is always from gloomy and unassuming beginnings that extraordinary events are set into motion.    "
msgstr "　物事のはじまりは、大抵こんな風に平凡で、穏やかに回りだすものなのだから―――　　"

#. Occurrence 1_2:34:145: scene=1_2
#: 1_2:34
msgctxt "text_id=145 | speaker=unknown"
msgid "  The rain had subsided somewhat by the time she reached the school gate."
msgstr "　彼女が正門についた頃、雨脚は弱くなっていた。"

#. Occurrence 1_2:39:146: scene=1_2
#: 1_2:39
msgctxt "text_id=146 | speaker=unknown"
msgid "  Sunlight seemed to be playing peek-a-boo behind the clouds in the distance."
msgstr "　遠くの空には日射しが見え隠れしている。"

#. Occurrence 1_2:44:147: scene=1_2
#: 1_2:44
msgctxt "text_id=147 | speaker=unknown"
msgid "  It looked like it might be cleared up by early afternoon."
msgstr "　この分なら、雨は昼過ぎにあがっているかもしれない。"

#. Occurrence 1_2:76:148: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0000; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:76
msgctxt "text_id=148 | speaker=aoko"
msgid "\"...Not that it has anything to do with me, though.\""
msgstr "「……といっても、私には関係のない話だけど」"

#. Occurrence 1_2:82:149: scene=1_2
#: 1_2:82
msgctxt "text_id=149 | speaker=unknown"
msgid "  The weather reflected her luck."
msgstr "　空模様とは裏腹に、彼女の運勢はボロボロだ。"

#. Occurrence 1_2:87:150: scene=1_2
#: 1_2:87
msgctxt "text_id=150 | speaker=unknown"
msgid "  On top of being forced out of the house at such an early hour, she had to suffer through a winter rain."
msgstr "　徹夜明けの朝に起こされたうえ、冬の雨に見舞われた。"

#. Occurrence 1_2:124:151: scene=1_2
#: 1_2:124
msgctxt "text_id=151 | speaker=unknown"
msgid "  I'm getting a bad feeling about this..."
msgstr "　この分では、用件とやらもロクな事じゃない―――"

#. Occurrence 1_2:129:152: scene=1_2
#: 1_2:129
msgctxt "text_id=152 | speaker=unknown"
msgid "  The sinking feeling she had only grew as she passed through the entrance and headed inside."
msgstr "　そんな予感に頭痛を覚えながら、彼女は正門を抜けて校舎に向かう。"

#. Occurrence 1_2:182:153: scene=1_2
#: 1_2:182
msgctxt "text_id=153 | speaker=unknown"
msgid "  She didn't encounter any other students along the way."
msgstr "　途中、すれ違った生徒はひとりもいない。"

#. Occurrence 1_2:187:154: scene=1_2
#: 1_2:187
msgctxt "text_id=154 | speaker=unknown"
msgid "  Nor did she see anyone taking part in club activities, either."
msgstr "　部活中の生徒も見あたらない。"

#. Occurrence 1_2:192:155: scene=1_2
#: 1_2:192
msgctxt "text_id=155 | speaker=unknown"
msgid "  The reception desk to the faculty room simply read \"Faculty Closed.\""
msgstr "　職員用の玄関の受付には“休憩中”の立て看板。"

#. Occurrence 1_2:197:156: scene=1_2
#: 1_2:197
msgctxt "text_id=156 | speaker=unknown"
msgid "  The school had given all of its students the day off."
msgstr "　学校は生徒に平等な休日を与えていた。"

#. Occurrence 1_2:202:157: scene=1_2
#: 1_2:202
msgctxt "text_id=157 | speaker=unknown"
msgid "  Except those explicitly summoned, like her."
msgstr "　もちろん、こんな時間に呼び出された彼女を除いて。"

#. Occurrence 1_2:207:158: scene=1_2
#: 1_2:207
msgctxt "text_id=158 | speaker=unknown"
msgid "  A fact that irked her more and more as the minutes passed."
msgstr "　そんな事実がますます感情を<逆撫|さかな>でする。"

#. Occurrence 1_2:253:159: scene=1_2
#: 1_2:253
msgctxt "text_id=159 | speaker=unknown"
msgid "  She opened the door to the faculty room and headed toward the desk she had visited a number of times before."
msgstr "　彼女が職員室の扉を開けると、見慣れた教師が机に向かっていた。"

#. Occurrence 1_2:258:160: scene=1_2
#: 1_2:258
msgctxt "text_id=160 | speaker=unknown"
msgid "  The man at the desk wore a plain shirt and suit that were nonetheless neatly pressed."
msgstr "　地味だがパリッとしたシャツと背広、"

#. Occurrence 1_2:263:161: scene=1_2
#: 1_2:263
msgctxt "text_id=161 | speaker=unknown"
msgid "  Slim-framed glasses adorned his face, giving off an amicable yet cunning air."
msgstr "　穏やかではあるが油断ならない細眼鏡。"

#. Occurrence 1_2:268:162: scene=1_2
#: 1_2:268
msgctxt "text_id=162 | speaker=unknown"
msgid "  The mild-mannered image this mid-twenties man presented clashed with the cigarette he smoked."
msgstr "　似合わない煙草をふかしている、二十代中盤の優男。"

#. Occurrence 1_2:273:163: scene=1_2
#: 1_2:273
msgctxt "text_id=163 | speaker=unknown"
msgid "  He didn't appear to have noticed her yet."
msgstr "　どうにも、まだ彼女に気付いていない様子だ。"

#. Occurrence 1_2:295:164: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0001; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:295
msgctxt "text_id=164 | speaker=aoko"
msgid "\"Mr. Yamasiro?\""
msgstr "「<山城|やましろ>先生」"

#. Occurrence 1_2:301:165: scene=1_2
#: 1_2:301
msgctxt "text_id=165 | speaker=unknown"
msgid "  She closed the door with a bang."
msgstr "　勢いよく扉を閉める。"

#. Occurrence 1_2:308:166: scene=1_2
#: 1_2:308
msgctxt "text_id=166 | speaker=unknown"
msgid "  Showing no response to the sudden sound, Mr. Yamasiro lifted his head."
msgstr "　その音にさして驚いた様子もなく、山城と呼ばれた教師は顔を上げた。"

#. Occurrence 1_2:343:167: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0000; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:343
msgctxt "text_id=167 | speaker=yamashiro"
msgid "\"Hey there. Good morning, Ms. Aozaki. I guess this means you got the call.\""
msgstr "「やあ、おはよう<蒼崎|あおざき>くん。用件は聞いているかな？」"

#. Occurrence 1_2:349:168: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0002; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:349
msgctxt "text_id=168 | speaker=aoko"
msgid "\"Yes. They called me at home about an hour ago, out of the blue...\""
msgstr "「はい。一時間前に自宅で。事前に何の相談もなく」"

#. Occurrence 1_2:360:169: scene=1_2
#: 1_2:360
msgctxt "text_id=169 | speaker=unknown"
msgid "  Having graduated from this high school himself, Mr. Yamasiro was not much older than the rest of the students."
msgstr "　この高校の卒業生である<山城|かれ>は、生徒たちとそう歳が離れていない。"

#. Occurrence 1_2:365:170: scene=1_2
#: 1_2:365
msgctxt "text_id=170 | speaker=unknown"
msgid "  For that reason, the students preferred him over the other teachers."
msgstr "　そのせいか他の教師より生徒に<慕|した>われている。"

#. Occurrence 1_2:402:171: scene=1_2
#: 1_2:402
msgctxt "text_id=171 | speaker=unknown"
msgid "  He always had something interesting to talk about, and kept conversations casual."
msgstr "　話題も<豊富|ほうふ>で口調も<穏和|おんわ>。"

#. Occurrence 1_2:407:172: scene=1_2
#: 1_2:407
msgctxt "text_id=172 | speaker=unknown"
msgid "    In fact, he seemed more like an older student than a teacher, but she unfortunately didn't share her fellow students' fondness for him."
msgstr "　教師というより頼れる先輩といった人物だが、あいにく、彼女はそう慕ってもいなかった。"

#. Occurrence 1_2:427:173: scene=1_2
#: 1_2:427
msgctxt "text_id=173 | speaker=unknown"
msgid "  She was of the opinion that teachers should come across as more austere."
msgstr "　教師は<冷徹|れいてつ>であるべきである。"

#. Occurrence 1_2:432:174: scene=1_2
#: 1_2:432
msgctxt "text_id=174 | speaker=unknown"
msgid "  Like an iron fist that could inspire both love and hate in equal measure... Not a buddy to joke and pal around with."
msgstr "　生徒にとっては愛憎いり交じった険しい壁であり、間違っても<憩|いこ>いの場でニコニコ笑っているお兄さん……であってはならない、というのが彼女の持論だ。"

#. Occurrence 1_2:452:175: scene=1_2
#: 1_2:452
msgctxt "text_id=175 | speaker=unknown"
msgid "  He was the exact opposite of how she felt a teacher should be. It was only natural that her manner towards him would be forced and unfriendly."
msgstr "　山城教諭は彼女が良しとする教師像とは正反対の人物で、自然、彼への口調は堅く、愛想のないものになる。"

#. Occurrence 1_2:458:176: scene=1_2
#: 1_2:458
msgctxt "text_id=176 | speaker=unknown"
msgid "  Not that she'd ever been wired to make friendly small talk."
msgstr "　……もっとも。愛想なんて微笑ましいもの、彼女には初めから装備されてはいないのだが。"

#. Occurrence 1_2:492:177: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0001; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:492
msgctxt "text_id=177 | speaker=yamashiro"
msgid "\"You're in a foul mood today.\""
msgstr "「はあ。今日もご機嫌ななめみたいだね、君は」"

#. Occurrence 1_2:498:178: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0003; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:498
msgctxt "text_id=178 | speaker=aoko"
msgid "\"You must be imagining it."
msgstr "「それは先生の気のせいです。"

#. Occurrence 1_2:498:179: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0003; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:498
msgctxt "text_id=179 | speaker=aoko"
msgid "  I'm like this every day.\""
msgstr "　今日だけ特別、という話ではありませんから」"

#. Occurrence 1_2:518:180: scene=1_2
#: 1_2:518
msgctxt "text_id=180 | speaker=unknown"
msgid "  The matter-of-fact answer perfectly matched the displeasure displayed on her face."
msgstr "　きっぱりと返答しつつも、彼女自身、自分がひどい顔をしているのは承知していた。"

#. Occurrence 1_2:523:181: scene=1_2
#: 1_2:523
msgctxt "text_id=181 | speaker=unknown"
msgid "  Her bad mood from having to get up early and the tiredness from staying up late must have collectively made her look positively adversarial."
msgstr "　寝起きの機嫌の悪さと寝不足の疲れがあいまって、<仇|かたき>を見るような目つきになっているだろう。"

#. Occurrence 1_2:556:182: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0002; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:556
msgctxt "text_id=182 | speaker=yamashiro"
msgid "\"If you say so. Just go easy on our guest, okay? To be honest, we're not completely sure how to deal with him yet.\""
msgstr "「そう。ならいいんだけどね、彼にはそう辛く当たらないでくれよ。僕らじゃ正直、どう扱っていいか分からないところもあるし」"

#. Occurrence 1_2:562:183: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0004; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:562
msgctxt "text_id=183 | speaker=aoko"
msgid "\"About that. Do you wanna tell me what the hell is going on? Because I have no clue.\""
msgstr "「先生。その件ですけど、私、まだ詳しい話を聞かされていないのですが」"

#. Occurrence 1_2:572:184: scene=1_2
#: 1_2:572
msgctxt "text_id=184 | speaker=unknown"
msgid "  As Mr. Yamasiro met her piercing eyes, he finally understood the reason behind her tone, and slowly put out his cigarette."
msgstr "　刺すような彼女の視線と声に、山城教諭はああ、と応えて煙草の火をもみ消した。"

#. Occurrence 1_2:608:185: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0003; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:608
msgctxt "text_id=185 | speaker=yamashiro"
msgid "\"Let's start at the beginning. What did they tell you over the phone?\""
msgstr "「んー、電話じゃなんて聞いたの？」"

#. Occurrence 1_2:614:186: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0005; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:614
msgctxt "text_id=186 | speaker=aoko"
msgid "\"Just that I'd be introduced to a transfer student."
msgstr "「転入生の紹介をする、とだけです。"

#. Occurrence 1_2:614:187: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0005; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:614
msgctxt "text_id=187 | speaker=aoko"
msgid "  They were a little hazy on the rest, though.\""
msgstr "　理由も<脈絡|みゃくらく>も無い説明でした」"

#. Occurrence 1_2:634:188: scene=1_2
#: 1_2:634
msgctxt "text_id=188 | speaker=unknown"
msgid "  One of Mr. Yamasiro's eyebrows stood up, impressed with the brevity of her answer."
msgstr "　簡潔な答えに、山城は感心して眉を上げた。"

#. Occurrence 1_2:639:189: scene=1_2
#: 1_2:639
msgctxt "text_id=189 | speaker=unknown"
msgid "  He could see that she was angry, not because she had been called to school on her day off, but because she hadn't been told why she was here."
msgstr "　彼女が怒っているのは見てとれたが、その理由が休日に呼び出された件ではなく、電話の内容が<要領|ようりょう>を得なかったからだとは。"

#. Occurrence 1_2:656:190: scene=1_2
#: 1_2:656
msgctxt "text_id=190 | speaker=unknown"
msgid "  Mr. Yamasiro chuckled sympathetically."
msgstr "　いやはや実に<厳格|げんかく>だ、と山城教諭は苦笑した。"

#. Occurrence 1_2:694:191: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0006; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:694
msgctxt "text_id=191 | speaker=aoko"
msgid "\"If this was all a joke to you, perhaps I should just go home.\""
msgstr "「先生。これが笑い話なら、そろそろ帰っていいでしょうか？」"

#. Occurrence 1_2:705:192: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0004; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:705
msgctxt "text_id=192 | speaker=yamashiro"
msgid "\"Wait, wait. I didn't mean to laugh. This is not a practical joke. We could really use your help.\""
msgstr "「いや、ごめんごめん、謝るよ。冗談じゃなくて真面目な話なんだ。ちょっと、君の手を借りたくてね」"

#. Occurrence 1_2:711:193: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0007; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:711
msgctxt "text_id=193 | speaker=aoko"
msgid "\"So there really is a transfer student?\""
msgstr "「本当に、転入生の問題で？」"

#. Occurrence 1_2:739:194: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0005; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:739
msgctxt "text_id=194 | speaker=yamashiro"
msgid "\"Yes, but he has... how should I put it? Difficult circumstances."
msgstr "「うん、訳ありというか、難しいというか。"

#. Occurrence 1_2:745:195: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0006; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:745
msgctxt "text_id=195 | speaker=yamashiro"
msgid "  His name...is Soujyuro. And he's a bit...well, peculiar. So we thought someone around the same age would be best suited to show him the ropes.\""
msgstr "　彼……<草十郎|そうじゅうろう>くんというんだけど、ちょっと、色々とズレていてね。僕らが案内してあげるより、同世代の君の方が適任だと思ったんだ」"

#. Occurrence 1_2:779:196: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0008; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:779
msgctxt "text_id=196 | speaker=aoko"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence 1_2:785:197: scene=1_2
#: 1_2:785
msgctxt "text_id=197 | speaker=unknown"
msgid "  She threw him an unamused look."
msgstr "　彼女は不審げに表情を<曇|くも>らせた。"

#. Occurrence 1_2:790:198: scene=1_2
#: 1_2:790
msgctxt "text_id=198 | speaker=unknown"
msgid "  It was negligent of them to be pushing teaching duties on her, but she did wonder how exactly this transfer student was peculiar."
msgstr "　教師の業務を生徒に押しつけるのも<怠慢|たいまん>だが、それ以上にその転入生が『ズレている』とはどういう事だろう？"

#. Occurrence 1_2:795:199: scene=1_2
#: 1_2:795
msgctxt "text_id=199 | speaker=unknown"
msgid "  Maybe he meant the student had behavioral problems or was difficult somehow."
msgstr "　素行に問題がある、扱いが難しい、というのなら想像しやすい。"

#. Occurrence 1_2:801:200: scene=1_2
#: 1_2:801
msgctxt "text_id=200 | speaker=unknown"
msgid "But 'peculiar?' She didn't have the slightest idea what that meant."
msgstr "しかし、ズレている、というのは何なのか。"

#. Occurrence 1_2:839:201: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0009; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:839
msgctxt "text_id=201 | speaker=aoko"
msgid "(You don't hear a teacher call someone that everyday.)"
msgstr "『ズレてるなんて、そう使わない表現だけど……』"

#. Occurrence 1_2:851:202: scene=1_2
#: 1_2:851
msgctxt "text_id=202 | speaker=unknown"
msgid "  She had her doubts but swept them aside for now."
msgstr "　彼女は不審げに思案するも、すぐに頭を切りかえた。"

#. Occurrence 1_2:856:203: scene=1_2
#: 1_2:856
msgctxt "text_id=203 | speaker=unknown"
msgid "  This wasn't the time to get distracted by more concerns."
msgstr "　あれこれ悩んでも仕方がない。"

#. Occurrence 1_2:861:204: scene=1_2
#: 1_2:861
msgctxt "text_id=204 | speaker=unknown"
msgid "  The fact remained that this conversation was all the \"peculiar\" she could handle, and she needed more information. She was already beginning to fantasize about saying no and curling up in her warm bed at home."
msgstr "　なんだかこの会話自体がズレているようで居心地が悪いし、情報が少なすぎるし、そもそも、断るつもりなら今頃ベッドの上でうろんな貝の気分になっている。"

#. Occurrence 1_2:888:205: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0010; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:888
msgctxt "text_id=205 | speaker=aoko"
msgid "\"I have a question.\""
msgstr "「ひとつ、質問があります」"

#. Occurrence 1_2:911:206: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0007; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:911
msgctxt "text_id=206 | speaker=yamashiro"
msgid "\"Yes? Ah, he's a second-year student like you. He's well-behaved and a good listener. He's not the most energetic individual, but that just means he'll be easier to get along with, right?"
msgstr "「なに？　あ、学年は君と同じ二年生だよ。性格は落ち着きがあって、人の話をよく聞くタイプ。裏を返せば覇気がないともとれるけど、それならそれで付き合いやすいだろ？"

#. Occurrence 1_2:922:207: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0008; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:922
msgctxt "text_id=207 | speaker=yamashiro"
msgid "  He's not in the same homeroom class as you, but I'm sure you'll get along just-\""
msgstr "　蒼崎くんとはクラスは違うけど、きっと仲良くな―――」"

#. Occurrence 1_2:965:208: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0011; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:965
msgctxt "text_id=208 | speaker=aoko"
msgid "\"I'll be the judge of that when I actually meet him."
msgstr "「そういった事は本人から直接<訊|き>きますし、<量|はか>ります。"

#. Occurrence 1_2:971:209: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0012; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:971
msgctxt "text_id=209 | speaker=aoko"
msgid "  And none of that answered my question: why me?\""
msgstr "　そうではなく、なぜ私なんでしょうか」"

#. Occurrence 1_2:996:210: scene=1_2
#: 1_2:996
msgctxt "text_id=210 | speaker=unknown"
msgid "  Though her tone was still stern, it was clear that she was willing to cooperate."
msgstr "　<刺々|とげとげ>しい<質|こ><問|え>は、同時に転入生の案内を承諾していた。"

#. Occurrence 1_2:1032:211: scene=1_2
#: 1_2:1032
msgctxt "text_id=211 | speaker=unknown"
msgid "  She had decided to put her feelings of dissatisfaction aside and focus on the task at hand."
msgstr "　不満ではあるが、とりあえず自分の感情は置いて、与えられた役目に取り組んでみる。"

#. Occurrence 1_2:1037:212: scene=1_2
#: 1_2:1037
msgctxt "text_id=212 | speaker=unknown"
msgid "  Forcing herself to act empathetic in spite of her self-absorbed nature was something she was used to."
msgstr "　<極|きわ>めて自己中心的な気質でありながら、<努|つと>めて公正でいようとするのが彼女の特長だ。"

#. Occurrence 1_2:1042:213: scene=1_2
#: 1_2:1042
msgctxt "text_id=213 | speaker=unknown"
msgid "  Paradoxically, this force of will was also the reason teachers put so much faith in her."
msgstr "　やや<倒錯|とうさく>しているが、その芯の強さを山城などは頼もしく思ってしまう。"

#. Occurrence 1_2:1062:214: scene=1_2
#: 1_2:1062
msgctxt "text_id=214 | speaker=unknown"
msgid "  ...To a point."
msgstr "　……まあ。"

#. Occurrence 1_2:1067:215: scene=1_2
#: 1_2:1067
msgctxt "text_id=215 | speaker=unknown"
msgid "  At times, that strength shattered expectation, and on those occasions they were left with no choice but to treat it like a natural disaster and weather it until it passed. That was how Mr. Yamasiro had come to deal with her as over the past year."
msgstr "　時折、その強さが予想の<範疇|はんちゅう>を超える事もあるが、それはそれ、天災と思って<諦|あきら>めるのが、ここ一年で山城教諭が学んだ彼女への対応策である。"

#. Occurrence 1_2:1088:216: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0013; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:1088
msgctxt "text_id=216 | speaker=aoko"
msgid "\"I'll ask you one more time, Mr. Yamasiro."
msgstr "「もう一度だけ訊きます、山城先生。"

#. Occurrence 1_2:1112:217: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0014; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:1112
msgctxt "text_id=217 | speaker=aoko"
msgid "  Why does it have to be me?\""
msgstr "　それで、なぜ私なんでしょうか？」"

#. Occurrence 1_2:1132:218: scene=1_2
#: 1_2:1132
msgctxt "text_id=218 | speaker=unknown"
msgid "  Pressured by a question without a clear yes or no answer, he answered."
msgstr "　有無を言わせぬ<詰問|きつもん>に、山城教諭はやや押されながらも返答する。"

#. Occurrence 1_2:1158:219: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0009; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:1158
msgctxt "text_id=219 | speaker=yamashiro"
msgid "\"Well, about that..."
msgstr "「うん、それはね。"

#. Occurrence 1_2:1164:220: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0010; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:1164
msgctxt "text_id=220 | speaker=yamashiro"
msgid "  You're probably thinking it's because you're the iron-fisted ruler of the student council and are willing to strike down both teacher and student for the good of the school, but you'd be wrong.\""
msgstr "　別に、蒼崎くんが先生方に<敬遠|けいえん>されているのと同じぐらい信頼されていて、学校のためなら教師も生徒も一緒くたに斬って捨てる鉄の生徒会長、だからじゃないよ」"

#. Occurrence 1_2:1187:221: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0015; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:1187
msgctxt "text_id=221 | speaker=aoko"
msgid "\"I can't imagine any other reason you'd call me.\""
msgstr "「……それ以外に、こんな呼びつけを受ける理由はないと思いますけど」"

#. Occurrence 1_2:1207:222: scene=1_2
#: 1_2:1207
msgctxt "text_id=222 | speaker=unknown"
msgid "  Her eyes did nothing to hide her disbelief as she glared at him."
msgstr "　信用ならない、と彼女は半眼で生徒会顧問を見据えた。"

#. Occurrence 1_2:1213:223: scene=1_2
#: 1_2:1213
msgctxt "text_id=223 | speaker=unknown"
msgid "  Strength far beyond that of an ordinary seventeen-year-old girl..."
msgstr "　十七才の少女にあるまじき迫力と、"

msgctxt "text_id=224 | speaker=unknown"
msgid "  ...coupled with the youthful beauty of one."
msgstr "　十七才の少女らしい愛らしさ。"

#. Occurrence 1_2:1220:225: scene=1_2
#: 1_2:1220
msgctxt "text_id=225 | speaker=unknown"
msgid "  Mr. Yamasiro let slip a genuine smile, admiring the miraculous balance of qualities."
msgstr "　奇跡的なバランスで両立する眼差しを、山城教諭は見惚れるように、穏やかな笑顔で受けとめる。"

#. Occurrence 1_2:1260:226: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0011; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:1260
msgctxt "text_id=226 | speaker=yamashiro"
msgid "\"I mean, I'd handle this myself if it was just about pure obligation. But who gets this job has nothing to do with whether they're a teacher or on the student council."
msgstr "「いや、責務だけでいいなら僕がやってるさ。この人選に関しちゃ教師や生徒会長といった役職も関係ないよ。"

#. Occurrence 1_2:1266:227: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0012; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:1266
msgctxt "text_id=227 | speaker=yamashiro"
msgid "  I just felt that you were the only one who would entertain this kind of a request without needing to weigh all sides. That's why I insisted it be you.\""
msgstr "　なんていうか、こんな頼みを<損得|そんとく>抜きで聞いてくれるのは君だけだと思ってね。適任ですから、と強く推薦したわけ」"

#. Occurrence 1_2:1272:228: scene=1_2
#: 1_2:1272
msgctxt "text_id=228 | speaker=unknown"
msgid "  In other words, he knew she wouldn't say no."
msgstr "　要は、“なんだかんだ言って底抜けに人がいいでしょ君”と言われているようなものだ。"

#. Occurrence 1_2:1312:229: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0016; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:1312
msgctxt "text_id=229 | speaker=aoko"
msgid "\"...Mr. Yamasiro.\""
msgstr "「―――山城先生」"

#. Occurrence 1_2:1330:230: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0013; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:1330
msgctxt "text_id=230 | speaker=yamashiro"
msgid "\"Oh, dear. Would you stop glaring at me like that already? At least put on a smile for your new schoolmate."
msgstr "「うわ怖っ。もう、<睨|にら>まない睨まない。言ったろ、僕にはともかく彼には笑顔でって。"

#. Occurrence 1_2:1336:231: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0014; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:1336
msgctxt "text_id=231 | speaker=yamashiro"
msgid "  Look, if you're agreeing to help, we should go see him. We've already kept him waiting long enough as it is."
msgstr "　とまあ、納得してくれたなら、すぐに移動しよう。もうずいぶん待たせてしまっているからね。"

#. Occurrence 1_2:1342:232: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0015; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:1342
msgctxt "text_id=232 | speaker=yamashiro"
msgid "  And because you braved the rain to get here, I'd be happy to give you a ride home.\""
msgstr "　それと、雨の中ご苦労さま。帰りはもちろん車で送るよ」"

#. Occurrence 1_2:1372:233: scene=1_2
#: 1_2:1372
msgctxt "text_id=233 | speaker=unknown"
msgid "  Mr. Yamasiro stood up gracefully."
msgstr "　スマートに立ち上がる山城教諭。"

#. Occurrence 1_2:1377:234: scene=1_2
#: 1_2:1377
msgctxt "text_id=234 | speaker=unknown"
msgid "  \"I'm good, thanks,\" she replied, before turning and walking out of the faculty room."
msgstr "　それにけっこうです、とだけ返して、彼女は職員室を後にした。"

#. Occurrence 1_2:1435:235: scene=1_2
#: 1_2:1435
msgctxt "text_id=235 | speaker=unknown"
msgid "  He had been waiting for about an hour."
msgstr "　待ち続けること一時間。"

#. Occurrence 1_2:1440:236: scene=1_2
#: 1_2:1440
msgctxt "text_id=236 | speaker=unknown"
msgid "  While he did, the rain shower lightened into a drizzle."
msgstr "　いつのまにか、空模様は小雨になっていた。"

#. Occurrence 1_2:1446:237: scene=1_2
#: 1_2:1446
msgctxt "text_id=237 | speaker=unknown"
msgid "  His mind wandered as he listened to the sound of the raindrops."
msgstr "　彼はぼんやりと、雨だれの音を聴いている。"

#. Occurrence 1_2:1490:238: scene=1_2
#: 1_2:1490
msgctxt "text_id=238 | speaker=unknown"
msgid "  The room was filled with neatly arranged rectangular tables."
msgstr "　長方形の机が事務的に置かれただけの部屋。"

#. Occurrence 1_2:1495:239: scene=1_2
#: 1_2:1495
msgctxt "text_id=239 | speaker=unknown"
msgid "  He was the only one there."
msgstr "　人影は一つ。彼の他には誰もいない。"

#. Occurrence 1_2:1500:240: scene=1_2
#: 1_2:1500
msgctxt "text_id=240 | speaker=unknown"
msgid "  Quite some time had passed since he had been brought to this room and asked to wait."
msgstr "　この部屋に通され、座って待っているように言われてから、もうずいぶんと時間が経っている。"

#. Occurrence 1_2:1505:241: scene=1_2
#: 1_2:1505
msgctxt "text_id=241 | speaker=unknown"
msgid "  Even the best-behaved student might have grown dissatisfied or anxious with the situation by now, but the boy stuck to his spot like a scarecrow."
msgstr "　まっとうな学生なら不満や不安をクチにしてもいい頃だろうに、少年はそれこそ畑のカカシのように、じっと言いつけを守っていた。"

#. Occurrence 1_2:1525:242: scene=1_2
#: 1_2:1525
msgctxt "text_id=242 | speaker=unknown"
msgid "  He was chilled to the bone."
msgstr "　体の<芯|しん>にまで届く寒さ。"

#. Occurrence 1_2:1530:243: scene=1_2
#: 1_2:1530
msgctxt "text_id=243 | speaker=unknown"
msgid "  It was the end of November, and the low temperature in the morning had marked the start of winter."
msgstr "　十一月の終わり、冬を迎え始めた午前の気温である。"

#. Occurrence 1_2:1535:244: scene=1_2
#: 1_2:1535
msgctxt "text_id=244 | speaker=unknown"
msgid "  The room was not much warmer."
msgstr "　室温は外より幾らかましな程度。"

#. Occurrence 1_2:1540:245: scene=1_2
#: 1_2:1540
msgctxt "text_id=245 | speaker=unknown"
msgid "  The heater hadn't been turned on. Either he'd missed the teacher telling him to turn it on, or he'd never seen one in his life."
msgstr "　ストーブをつけていいから、という教師の声を聞き逃したのか、このタイプのストーブはまだ見た事がなかったのか、暖房は入っていない。"

#. Occurrence 1_2:1560:246: scene=1_2
#: 1_2:1560
msgctxt "text_id=246 | speaker=unknown"
msgid "  He breathed lightly on his freezing fingers as he aimlessly surveyed his surroundings."
msgstr "　彼は冷たくなってきた指先に軽く息をあてながら、ぼんやりと周囲を観察する。"

#. Occurrence 1_2:1566:247: scene=1_2
#: 1_2:1566
msgctxt "text_id=247 | speaker=unknown"
msgid "  This dreary place was apparently a meeting room."
msgstr "　この殺風景な部屋は会議室と言うらしい。"

#. Occurrence 1_2:1571:248: scene=1_2
#: 1_2:1571
msgctxt "text_id=248 | speaker=unknown"
msgid "  The other students might have considered it a wonderful place to meet, but to him it was drab and overly spacious."
msgstr "　在校生から見れば<仰々|ぎょうぎょう>しい会議室だが、彼から見れば飾り気のない、広いだけの部屋だった。"

#. Occurrence 1_2:1614:249: scene=1_2
#: 1_2:1614
msgctxt "text_id=249 | speaker=unknown"
msgid "  It was a lifeless place that reminded him of an arid cave."
msgstr "　生活の匂いがしないため、つい、乾ききった<岩屋|いわや>などを連想してしまう。"

#. Occurrence 1_2:1619:250: scene=1_2
#: 1_2:1619
msgctxt "text_id=250 | speaker=unknown"
msgid "  Stuck in this cold room with absolutely nothing to do, his mind turned to what they wanted to discuss."
msgstr "　彼はやる事もないので、こんな冷たい場所でどんな話し合いをするのだろう、と真剣に検討してみた。"

#. Occurrence 1_2:1654:251: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0000; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:1654
msgctxt "text_id=251 | speaker=soujuurou"
msgid "\"..."
msgstr "「…………………………"

msgctxt "text_id=252 | speaker=unknown"
msgid "...Hrm.\""
msgstr "、むう」"

#. Occurrence 1_2:1676:253: scene=1_2
#: 1_2:1676
msgctxt "text_id=253 | speaker=unknown"
msgid "  Unable to come up with a solid answer, he returned his attention to the sound of the rain."
msgstr "　どう考えても答えはでそうにないので、<雨音|あまおと>に意識を戻す。"

#. Occurrence 1_2:1681:254: scene=1_2
#: 1_2:1681
msgctxt "text_id=254 | speaker=unknown"
msgid "  The rain hardly resembled the rain in the mountains."
msgstr "　雨の空は、山のものと少しだけ似ている。"

#. Occurrence 1_2:1686:255: scene=1_2
#: 1_2:1686
msgctxt "text_id=255 | speaker=unknown"
msgid "  Though, he could still recognize it, barely."
msgstr "　いや、かろうじて原形を留めている。"

#. Occurrence 1_2:1691:256: scene=1_2
#: 1_2:1691
msgctxt "text_id=256 | speaker=unknown"
msgid "  Its smell and sound were harsher. But at the end of the day, rain was still rain."
msgstr "　匂いも音も<硬|かた>くなっているが、根底は同じモノだ。"

#. Occurrence 1_2:1696:257: scene=1_2
#: 1_2:1696
msgctxt "text_id=257 | speaker=unknown"
msgid "  So even this world, alien as it was, could have something in common with the mountains..."
msgstr "　こんな異界にあっても山と共通する物がある―――"

#. Occurrence 1_2:1701:258: scene=1_2
#: 1_2:1701
msgctxt "text_id=258 | speaker=unknown"
msgid "  That trivial detail perked him up a little."
msgstr "　そんな<些細|ささい>な事がしんみりと嬉しい。"

#. Occurrence 1_2:1745:259: scene=1_2
#: 1_2:1745
msgctxt "text_id=259 | speaker=unknown"
msgid "  He liked how the town looked soaked in rain."
msgstr "　雨に濡れた町は好きだ。"

#. Occurrence 1_2:1750:260: scene=1_2
#: 1_2:1750
msgctxt "text_id=260 | speaker=unknown"
msgid "  Naturally, he preferred sunny weather, but he liked rain in its own way."
msgstr "　よく晴れた晴天の方が心地よいのは当然だが、そういう気持ち良さとは別の視点で、彼は雨空を好いている。"

#. Occurrence 1_2:1755:261: scene=1_2
#: 1_2:1755
msgctxt "text_id=261 | speaker=unknown"
msgid "  The fog from the rain had soaked up the scent of the soil, and it reminded him of home."
msgstr "　雨に<煙|けぶ>った町並みは少しだけ土の匂いが増して、未練がましくも故郷を<想|おも>ってしまう。"

#. Occurrence 1_2:1760:262: scene=1_2
#: 1_2:1760
msgctxt "text_id=262 | speaker=unknown"
msgid "  It was at times like these that he was able to numb the anxiety the city gave him."
msgstr "　そんな時だけ、都会にやってきた不安も少しは薄れていく気がするからだ。"

#. Occurrence 1_2:1781:263: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0001; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:1781
msgctxt "text_id=263 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 1_2:1799:264: scene=1_2
#: 1_2:1799
msgctxt "text_id=264 | speaker=unknown"
msgid "  ...But then he let out a discouraged sigh."
msgstr "　……と、すぐに<落胆|らくたん>の息がこぼれた。"

#. Occurrence 1_2:1804:265: scene=1_2
#: 1_2:1804
msgctxt "text_id=265 | speaker=unknown"
msgid "  How pathetic."
msgstr "　まったく情けない。"

#. Occurrence 1_2:1810:266: scene=1_2
#: 1_2:1810
msgctxt "text_id=266 | speaker=unknown"
msgid "He'd already been here two weeks and thoughts of his hometown still made him sad."
msgstr "引っ越して二週間も経つのに、気を抜くと故郷を<偲|しの>ぶ未練がましさに肩を落とす。"

#. Occurrence 1_2:1815:267: scene=1_2
#: 1_2:1815
msgctxt "text_id=267 | speaker=unknown"
msgid "  Perhaps feeling that he was being unfair to his new life, he composed himself and continued to wait patiently."
msgstr "　これではせっかくの新生活に申し訳がないではないか、と彼はひとり気合いを入れ直して、行儀良く待ち続けることにした。"

#. Occurrence 1_2:1843:268: scene=1_2
#: 1_2:1843
msgctxt "text_id=268 | speaker=unknown"
msgid "  As if having a passion for distractions, his attention returned to the sound of the rain once more."
msgstr "　ぼんやりと熱心に、雨の音に意識を向ける。"

#. Occurrence 1_2:1849:269: scene=1_2
#: 1_2:1849
msgctxt "text_id=269 | speaker=unknown"
msgid "  Waiting like this didn't seem to be particularly hard for him."
msgstr "　彼にとって、この程度の待ちぼうけは苦でもないらしい。"

#. Occurrence 1_2:1869:270: scene=1_2
#: 1_2:1869
msgctxt "text_id=270 | speaker=unknown"
msgid "  He quietly endured the numbing cold and the hour alone with calm, deep breaths."
msgstr "　痺れるような寒さも、一時間の放置も、深呼吸と一緒にあっさり飲み下す平常心。"

#. Occurrence 1_2:1874:271: scene=1_2
#: 1_2:1874
msgctxt "text_id=271 | speaker=unknown"
msgid "  As the saying goes, \"Good things come to those who wait.\""
msgstr "　岩の上にも三年とか、耐え続けた<赤穂浪士|あこうろうし>とか。"

#. Occurrence 1_2:1879:272: scene=1_2
#: 1_2:1879
msgctxt "text_id=272 | speaker=unknown"
msgid "  A strong point of his or not, he was astonishingly patient."
msgstr "　長所かどうかはさておいて、呆れるほどの辛抱強さ。"

#. Occurrence 1_2:1885:273: scene=1_2
#: 1_2:1885
msgctxt "text_id=273 | speaker=unknown"
msgid "  It was certainly helping him out in this moment."
msgstr "　それが現時点における、この少年の特長だった。"

#. Occurrence 1_2:1968:274: scene=1_2
#: 1_2:1968
msgctxt "text_id=274 | speaker=unknown"
msgid "  She, on the other hand, was livid."
msgstr "　一方、彼女はいたくご<立腹|りっぷく>だった。"

#. Occurrence 1_2:1974:275: scene=1_2
#: 1_2:1974
msgctxt "text_id=275 | speaker=unknown"
msgid "  The profile of the transfer student had been explained to her on her way to the meeting room."
msgstr "　職員室から会議室に向かうまでの間、これから会う人物のプロフィールを聞いたからだ。"

#. Occurrence 1_2:1979:276: scene=1_2
#: 1_2:1979
msgctxt "text_id=276 | speaker=unknown"
msgid "  She was told he had lived his whole life up in the mountains without any electricity."
msgstr "　なんでも、その人物は生まれてから今の今まで、電気も<通|かよ>っていない山奥で暮らしていたらしい。"

#. Occurrence 1_2:2018:277: scene=1_2
#: 1_2:2018
msgctxt "text_id=277 | speaker=unknown"
msgid "  That meant more than half of civilized society would have been an utter mystery to him."
msgstr "　電気がないという事は、現在の文明社会の半分以上を知らない事になる。"

#. Occurrence 1_2:2025:278: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0017; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2025
msgctxt "text_id=278 | speaker=aoko"
msgid "(What a miserable level of isolation. How is this even possible in post-war Japan?"
msgstr "『なんて絶望的な断絶、戦後どころか戦前の話じゃない。"

#. Occurrence 1_2:2025:279: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0017; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2025
msgctxt "text_id=279 | speaker=aoko"
msgid "  He's like Robinson Crusoe!)"
msgstr "　ロビンソンにも程がある……！』"

#. Occurrence 1_2:2031:280: scene=1_2
#: 1_2:2031
msgctxt "text_id=280 | speaker=unknown"
msgid "  She had every right to be angry."
msgstr "　彼女のそんな<憤|いきどお>りもやむをえまい。"

#. Occurrence 1_2:2083:281: scene=1_2
#: 1_2:2083
msgctxt "text_id=281 | speaker=unknown"
msgid "  His village had apparently remained isolated in the mountains for many years."
msgstr "　なんでも、その山奥の村は長いこと集落として孤立していたらしい。"

#. Occurrence 1_2:2088:282: scene=1_2
#: 1_2:2088
msgctxt "text_id=282 | speaker=unknown"
msgid "  Contact with villages in the foothills of the mountains only occurred once a month or so, which was unfathomable in modern Japan."
msgstr "　<麓|ふもと>の村とですら月に一度の郵便で連絡をとるだけなんて、現代日本とは思えない。"

#. Occurrence 1_2:2093:283: scene=1_2
#: 1_2:2093
msgctxt "text_id=283 | speaker=unknown"
msgid "  Although expressways and Japan Rail-the old National Railways-now spanned the country like arteries, it wasn't entirely impossible for mountain villages like his to exist."
msgstr "　が、しかし。今や高速道路やＪＲ……旧国鉄……といった動脈静脈が張り巡らされた我が国ではあるが、そういった山村は無いと言い切れないのも事実である。"

#. Occurrence 1_2:2117:284: scene=1_2
#: 1_2:2117
msgctxt "text_id=284 | speaker=unknown"
msgid "  But she couldn't imagine how someone born to such circumstances would think or live."
msgstr "　いま確かなコトは、そんな状況で暮らしてきた人間が何を考えて生きているか想像できない、というコトだけだ。"

#. Occurrence 1_2:2152:285: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0018; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2152
msgctxt "text_id=285 | speaker=aoko"
msgid "\"When you say no electricity... you mean in general, right? Like, he must have had access to a public phone.\""
msgstr "「電気がないって……村に行き渡っていないだけで、公衆電話ぐらいはあったんですよね？」"

#. Occurrence 1_2:2175:286: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0016; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:2175
msgctxt "text_id=286 | speaker=yamashiro"
msgid "\"Apparently not. He mentioned how shocked he was by the phones when he started living here."
msgstr "「なかったそうだよ。こっちに暮らすようになって、まず驚いたのが電話だそうだし。"

#. Occurrence 1_2:2181:287: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0017; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:2181
msgctxt "text_id=287 | speaker=yamashiro"
msgid "  I kid you not, he said, 'Wow, telephones are so useful.' Couldn't really deny that, could I?\""
msgstr "　電話って便利ですね、なんて真顔で言われてねぇ。そういえばそうだなあ、と再確認させられたぐらいだよ」"

#. Occurrence 1_2:2201:288: scene=1_2
#: 1_2:2201
msgctxt "text_id=288 | speaker=unknown"
msgid "  She shot a sidelong glare his way as he laughed."
msgstr "　あはは、と笑う教師を彼女は横目で睨む。"

#. Occurrence 1_2:2206:289: scene=1_2
#: 1_2:2206
msgctxt "text_id=289 | speaker=unknown"
msgid "  It seemed that the naivete of the country boy had cheered up Mr. Yamasiro a bit."
msgstr "　何が嬉しいのか、山城教諭は田舎の純朴な少年にあてられて<和|なご>んでいるらしい。"

#. Occurrence 1_2:2242:290: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0019; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2242
msgctxt "text_id=290 | speaker=aoko"
msgid "\"They probably didn't have police officers, either. My family home is up in the mountains, so it's not inconceivable they wouldn't have electricity."
msgstr "「……<駐在|ちゅうざい>もいないって事か……うちも実家は山奥ですから、電気が通っていないのはあり得ないとは言いませんけど。"

#. Occurrence 1_2:2248:291: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0020; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2248
msgctxt "text_id=291 | speaker=aoko"
msgid "  But... he doesn't even know what school is?\""
msgstr "　―――そいつ、学校<も|・>知らないんですか？」"

#. Occurrence 1_2:2269:292: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0018; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:2269
msgctxt "text_id=292 | speaker=yamashiro"
msgid "\"Nope. He'd heard of them, but this is apparently his first time visiting one. Maybe that's why he's nervous. He wasn't very talkative."
msgstr "「うん。どんなものかは知っていたそうだけど、実際来るのは今日が初めてらしい。それで緊張していたのかな、あまり会話も<弾|はず>まなかった。"

#. Occurrence 1_2:2275:293: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0019; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:2275
msgctxt "text_id=293 | speaker=yamashiro"
msgid "  He's almost―what would you call it―feral? Like a boy raised by wolves. I suppose that makes this a safari!\""
msgstr "　うーん、ああいうのも野生児っていうのかな？　狼に育てられた狼少年、みたいな？　いや、探検隊の話だねぇ！」"

#. Occurrence 1_2:2314:294: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0021; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2314
msgctxt "text_id=294 | speaker=aoko"
msgid "\"...\""
msgstr "「…………………」"

#. Occurrence 1_2:2320:295: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0020; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:2320
msgctxt "text_id=295 | speaker=yamashiro"
msgid "\"Hey, you're scaring me, Aozaki. I was joking. Go easy, okay?"
msgstr "「ちょっ、怖いなあ蒼崎くん。冗談、冗談だって。そう睨まないでくれ。"

#. Occurrence 1_2:2326:296: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0021; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:2326
msgctxt "text_id=296 | speaker=yamashiro"
msgid "  And don't worry. I got the feeling from talking to him that he's a nice kid!"
msgstr "　大丈夫、話してみた感じ、おとなしい子だったから！"

#. Occurrence 1_2:2326:297: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0021; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:2326
msgctxt "text_id=297 | speaker=yamashiro"
msgid "  He was almost like, I don't know, a cute little animal that doesn't speak human!\""
msgstr "　なんていうか、言葉の通じない小動物みたいな感じ」"

#. Occurrence 1_2:2339:298: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0022; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2339
msgctxt "text_id=298 | speaker=aoko"
msgid "\"Your jokes and metaphors aren't helping.\""
msgstr "「山城先生。その<喩|たと>え、気休めになってませんから」"

#. Occurrence 1_2:2377:299: scene=1_2
#: 1_2:2377
msgctxt "text_id=299 | speaker=unknown"
msgid "  As she gave her blunt reply, she tried to simulate in her mind what life without electricity would be like, but the thought of it took her sour mood from bad to worse."
msgstr "　つっけんどんに返しつつ、彼女は電気のない生活とやらをシミュレートしようとし、ただでさえ不機嫌な顔をいっそう刺々しく曇らせた。"

#. Occurrence 1_2:2409:300: scene=1_2
#: 1_2:2409
msgctxt "text_id=300 | speaker=unknown"
msgid "  After all, it was a world she had never known."
msgstr "　だって、それは彼女の知らない世界だ。"

#. Occurrence 1_2:2414:301: scene=1_2
#: 1_2:2414
msgctxt "text_id=301 | speaker=unknown"
msgid "  She could understand why the teachers had given up."
msgstr "　教師陣が両手を上げて降参したのも頷ける。"

#. Occurrence 1_2:2420:302: scene=1_2
#: 1_2:2420
msgctxt "text_id=302 | speaker=unknown"
msgid "  She, too, wanted to give up and return to her warm bed, but her good-for-nothing pride was holding her hostage."
msgstr "　本当は彼女も降参して暖かなベッドに戻りたかったが、<一|いち><文|もん>にもならない自尊心が押しとどめていた。"

#. Occurrence 1_2:2425:303: scene=1_2
#: 1_2:2425
msgctxt "text_id=303 | speaker=unknown"
msgid "  Not only did the teachers believe she was up to the task, but she also believed she could do it. It wasn't that easy to go back on her word-no matter how bad things looked after the fact."
msgstr "　出来ると見込まれ、自分も出来ると判断して引き受けた以上、経緯や内容はどうあれ、そう簡単に放り出すワケにはいかないのだ。"

#. Occurrence 1_2:2460:304: scene=1_2
#: 1_2:2460
msgctxt "text_id=304 | speaker=unknown"
msgid "  She walked along the hallway, the rain pattering in the background."
msgstr "　<雨音|あまおと>を背に、冷めきった廊下を歩いていく。"

#. Occurrence 1_2:2466:305: scene=1_2
#: 1_2:2466
msgctxt "text_id=305 | speaker=unknown"
msgid "  The meeting room was already in sight."
msgstr "　会議室はもう目前。"

#. Occurrence 1_2:2471:306: scene=1_2
#: 1_2:2471
msgctxt "text_id=306 | speaker=unknown"
msgid "  With a furrowed brow, she fixed her long hair in anticipation of meeting the unknown stranger within."
msgstr "　眉間に<皺|しわ>をよせたまま、長い髪を揺らして、彼女はまだ見ぬ異邦人へと向かっていく。"

#. Occurrence 1_2:2476:307: scene=1_2
#: 1_2:2476
msgctxt "text_id=307 | speaker=unknown"
msgid "  Her elegant strides were like those of a confident general going into battle."
msgstr "　優雅な足取りのまま、戦場に突撃するかの如く。"

#. Occurrence 1_2:2515:308: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0022; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:2515
msgctxt "text_id=308 | speaker=yamashiro"
msgid "\"...Umm, Aozaki?"
msgstr "「……いや、蒼崎くん？"

#. Occurrence 1_2:2521:309: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0023; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:2521
msgctxt "text_id=309 | speaker=yamashiro"
msgid "  I believe in you and all, but I'll say it again. Be nice, okay? Can you at least try to smile?\""
msgstr "　君を信頼してる僕だけど、念のため確認しておくよ。なんていうか、優しくね。できれば笑顔とか作れないかな？」"

#. Occurrence 1_2:2533:310: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0023; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2533
msgctxt "text_id=310 | speaker=aoko"
msgid "\"I'm bad at faking smiles. But I'll do my best.\""
msgstr "「作り笑いは苦手です。一応、努力しているつもりですが」"

#. Occurrence 1_2:2539:311: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0024; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:2539
msgctxt "text_id=311 | speaker=yamashiro"
msgid "\"Really? That's a relief..."
msgstr "「あ。そうなんだ、それは良かった。"

#. Occurrence 1_2:2545:312: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0025; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:2545
msgctxt "text_id=312 | speaker=yamashiro"
msgid "  I really mean it. It's good to know you're not good at everything.\""
msgstr "　……いやあ、ほんと良かった。蒼崎くんにも苦手なものってあったんだねぇ……」"

#. Occurrence 1_2:2594:313: scene=1_2
#: 1_2:2594
msgctxt "text_id=313 | speaker=unknown"
msgid "  Mr. Yamasiro's shoulders slumped the second they reached the meeting room."
msgstr "　山城教諭が肩を落とすのと、<件|くだん>の会議室に到着したのは同時だった。"

#. Occurrence 1_2:2599:314: scene=1_2
#: 1_2:2599
msgctxt "text_id=314 | speaker=unknown"
msgid "  As he put his hand to the door, his eyes seemed to say to her, \"Be nice, please.\""
msgstr "　山城教諭は“優しく、優しくね”と目配せし、会議室の扉に手をかける。"

#. Occurrence 1_2:2604:315: scene=1_2
#: 1_2:2604
msgctxt "text_id=315 | speaker=unknown"
msgid "  This only made her more irritated."
msgstr "　そんな扱いに、彼女のイライラは増すばかりだ。"

#. Occurrence 1_2:2642:316: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0024; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2642
msgctxt "text_id=316 | speaker=aoko"
msgid "(I already know I'm not the friendliest-looking person in the world, but I can't just make myself smile at the drop of a hat."
msgstr "『……分かってるわよ、愛想が悪いってのは。でも笑顔なんて意識して作るものじゃないんだし……"

#. Occurrence 1_2:2649:317: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0025; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2649
msgctxt "text_id=317 | speaker=aoko"
msgid "You should have asked Tobimaru if that's what you were after.)"
msgstr "だいたい、そういうインスタントな人付き合いなら<鳶丸|とびまる>の方が向いてるっての』"

#. Occurrence 1_2:2682:318: scene=1_2
#: 1_2:2682
msgctxt "text_id=318 | speaker=unknown"
msgid "  She sighed about her social shortcomings, but then it occurred to her that being called into school on a day off while sleep-deprived wasn't anything to smile about anyway."
msgstr "　彼女は自分の愛想の無さにため息をつくが、考えてみると、寝不足のまま休日の学校に呼び出されては笑顔も何もあったものではない。"

#. Occurrence 1_2:2687:319: scene=1_2
#: 1_2:2687
msgctxt "text_id=319 | speaker=unknown"
msgid "  She also thought the person responsible for this mess would be better off attending elementary school."
msgstr "　くわえて、その元凶は高校生より小学生から始めた方がよさそうな人物なのだ。"

#. Occurrence 1_2:2707:320: scene=1_2
#: 1_2:2707
msgctxt "text_id=320 | speaker=unknown"
msgid "  It might not be his fault, but neither was it her duty or obligation to do the teachers' work for them."
msgstr "　……その人物に責任はないにせよ、彼女にだって、学校側の仕事を押しつけられる責任も義理もないのである。"

#. Occurrence 1_2:2712:321: scene=1_2
#: 1_2:2712
msgctxt "text_id=321 | speaker=unknown"
msgid "  At the very least..."
msgstr "　せめて、なんというか。"

#. Occurrence 1_2:2717:322: scene=1_2
#: 1_2:2717
msgctxt "text_id=322 | speaker=unknown"
msgid "  They could have used their brains and organized all this on a normal school day―another complaint she wanted to voice later."
msgstr "　もうちょっと空気を読んで平日にやってきてくれたのなら、と愚痴の一つも言いたくなる。"

#. Occurrence 1_2:2756:323: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0026; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2756
msgctxt "text_id=323 | speaker=aoko"
msgid "(I hate him already. He's my sworn enemy and I haven't even met him."
msgstr "『……いや。というか敵。何であろうと敵。"

#. Occurrence 1_2:2756:324: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0026; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2756
msgctxt "text_id=324 | speaker=aoko"
msgid "  Sorry, but I couldn't care less about his extenuating circumstances!"
msgstr "　悪いけど<情状酌量|じょうじょうしゃくりょう>以前に敵……！"

#. Occurrence 1_2:2762:325: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0027; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2762
msgctxt "text_id=325 | speaker=aoko"
msgid "  You think this isn't awkward for me, too? Honestly, why did this have to happen when I'm so busy!?)"
msgstr "　間が悪いのはお互い様っていうか、ほんと、なんでよりにもよってこんな忙しい時に―――』"

#. Occurrence 1_2:2819:326: scene=1_2
#: 1_2:2819
msgctxt "text_id=326 | speaker=unknown"
msgid "  Her pounding headache from a lack of sleep had boosted her aggression by ten percent."
msgstr "　寝不足でキリキリ痛む頭が、彼女の攻撃性を一割増しにする。"

#. Occurrence 1_2:2824:327: scene=1_2
#: 1_2:2824
msgctxt "text_id=327 | speaker=unknown"
msgid "  No matter how harmless the guy on the other side of the door may be, anyone who disturbed her sleep was the enemy."
msgstr "　この扉の向こうにいる人物がどれだけ無害であれ、我が眠りを妨げたモノはみんな敵。"

#. Occurrence 1_2:2832:328: scene=1_2
#: 1_2:2832
msgctxt "text_id=328 | speaker=unknown"
msgid "  And just as she was reaching peak annoyance, Mr. Yamasiro opened the door to the meeting room."
msgstr "　そんな彼女のイライラが頂点に達しかけたタイミングで、山城教諭は会議室の扉を開けた。"

#. Occurrence 1_2:2853:329: scene=1_2
#: 1_2:2853
msgctxt "text_id=329 | speaker=unknown"
msgid "  The room slowly slid into view."
msgstr "　……ゆっくりと横に開いていく風景。"

#. Occurrence 1_2:2858:330: scene=1_2
#: 1_2:2858
msgctxt "text_id=330 | speaker=unknown"
msgid "  She didn't care for formalities,"
msgstr "　<情緒|じょうちょ>なんてお構いなし。"

#. Occurrence 1_2:2863:331: scene=1_2
#: 1_2:2863
msgctxt "text_id=331 | speaker=unknown"
msgid "  just looked straight ahead and stormed into the room."
msgstr "　まっすぐな視線のまま、彼女は会議室に<突撃|しんこう>し―――"

#. Occurrence 1_2:2869:332: scene=1_2
#: 1_2:2869
msgctxt "text_id=332 | speaker=unknown"
msgid "  And found herself face to face with a most unusual opponent."
msgstr "　その、一風変わった敵と対面した。"

#. Occurrence 1_2:2914:333: scene=1_2
#: 1_2:2914
msgctxt "text_id=333 | speaker=unknown"
msgid "  Before we go on, let's see from another perspective."
msgstr "　カメラは再び一方に。"

#. Occurrence 1_2:2919:334: scene=1_2
#: 1_2:2919
msgctxt "text_id=334 | speaker=unknown"
msgid "  Turning back the clock just a little..."
msgstr "　時間は、少しだけ巻き戻る。"

#. Occurrence 1_2:2953:335: scene=1_2
#: 1_2:2953
msgctxt "text_id=335 | speaker=unknown"
msgid "\"You don't have to do anything.\""
msgstr "『何をしなくともいい』という指令は、"

#. Occurrence 1_2:2953:336: scene=1_2
#: 1_2:2953
msgctxt "text_id=336 | speaker=unknown"
msgid "  For some, these words are a priceless luxury."
msgstr "　ある種の人間にとってはかけがえのない贅沢であり、"

#. Occurrence 1_2:2953:337: scene=1_2
#: 1_2:2953
msgctxt "text_id=337 | speaker=unknown"
msgid "  For others, they are unbearable torture."
msgstr "　ある種の人間にとっては耐えがたい責め苦である。"

#. Occurrence 1_2:2990:338: scene=1_2
#: 1_2:2990
msgctxt "text_id=338 | speaker=unknown"
msgid "  For the proactive girl, it was definitely the former, though she'd be too suspicious of the motives of anyone giving her such a gift to accept it."
msgstr "　能動的な彼女にすれば<羨|うらや>ましい反面、怪しすぎて受け取れない高級品。"

#. Occurrence 1_2:2996:339: scene=1_2
#: 1_2:2996
msgctxt "text_id=339 | speaker=unknown"
msgid "  For the passive boy, it was definitely the latter. A bitter thorn that made him homesick, though at this very moment his mind was still distracted with the wait for his face to reveal any discontent."
msgstr "　受動的な彼にすれば親しめる反面、郷愁を起こす<苦|にが>い棘……の筈なのだが、目下、絶賛待たされっぱなしの顔にこれといった不満は見られない。"

#. Occurrence 1_2:3016:340: scene=1_2
#: 1_2:3016
msgctxt "text_id=340 | speaker=unknown"
msgid "  He maintained perfect posture as he stared at the gray sky."
msgstr "　彼は自然に、姿勢を正したまま灰色の空模様を眺めている。"

#. Occurrence 1_2:3021:341: scene=1_2
#: 1_2:3021
msgctxt "text_id=341 | speaker=unknown"
msgid "  He had already waited a whole hour, but figured they must have had their reasons for making him wait."
msgstr "　さらに待ち続けてはや一時間だが、まあ、先方さんにも都合があるのだろうし、何もお金を取られるワケでもなし。"

#. Occurrence 1_2:3026:342: scene=1_2
#: 1_2:3026
msgctxt "text_id=342 | speaker=unknown"
msgid "  And as long as he had the sound of the rain to soothe him, he could keep on waiting."
msgstr "　雨音さえあればいつまでも待ち続けられる、といった風。"

#. Occurrence 1_2:3061:343: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0002; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:3061
msgctxt "text_id=343 | speaker=soujuurou"
msgid "(It must be nine o' clock already."
msgstr "『でも、そろそろ九時を過ぎるのか……"

msgctxt "text_id=344 | speaker=unknown"
msgid "  Yeah, that seems about right.)"
msgstr "　うん、どうなんだろう』"

#. Occurrence 1_2:3069:345: scene=1_2
#: 1_2:3069
msgctxt "text_id=345 | speaker=unknown"
msgid "  He had been vaguely keeping track of the time as he listened to the rain."
msgstr "　それでも漠然と、いちおう時計を気にしながら、ぼんやりと雨音を聴く。"

#. Occurrence 1_2:3103:346: scene=1_2
#: 1_2:3103
msgctxt "text_id=346 | speaker=unknown"
msgid "  Due to the holiday, the school building was completely silent,"
msgstr "　休日の校舎に<雑音|かいわ>はない。"

#. Occurrence 1_2:3109:347: scene=1_2
#: 1_2:3109
msgctxt "text_id=347 | speaker=unknown"
msgid "  except for the patter of the rain on the window."
msgstr "　ポツポツと窓を叩く雨。"

#. Occurrence 1_2:3170:348: scene=1_2
#: 1_2:3170
msgctxt "text_id=348 | speaker=unknown"
msgid "  The mood felt as damp as the air."
msgstr "　しん……と沈みこむ空気の<軋|きし>み。"

#. Occurrence 1_2:3176:349: scene=1_2
#: 1_2:3176
msgctxt "text_id=349 | speaker=unknown"
msgid "  It was then..."
msgstr "　それと、"

#. Occurrence 1_2:3204:350: scene=1_2
#: 1_2:3204
msgctxt "text_id=350 | speaker=unknown"
msgid "  ...he heard the heavy clatter of footsteps approaching."
msgstr "　カツカツとまっすぐに、<力|ちから>強く響いてくる<靴|くつ>の音。"

#. Occurrence 1_2:3225:351: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0003; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:3225
msgctxt "text_id=351 | speaker=soujuurou"
msgid "(Finally. I thought they'd forgotten about me.)"
msgstr "『……良かった、忘れられているかと思った』"

#. Occurrence 1_2:3242:352: scene=1_2
#: 1_2:3242
msgctxt "text_id=352 | speaker=unknown"
msgid "  He could hear two sets of footsteps, one heavier set belonging to an adult."
msgstr "　軽い足音と、それより重い大人の足音が聞こえる。"

#. Occurrence 1_2:3261:353: scene=1_2
#: 1_2:3261
msgctxt "text_id=353 | speaker=unknown"
msgid "  He breathed a sigh of relief as the door slid open."
msgstr "　彼がほっと安堵の息をもらした時、会議室の扉がスライドした。"

#. Occurrence 1_2:3299:354: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0026; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:3299
msgctxt "text_id=354 | speaker=yamashiro"
msgid "\"So sorry to keep you waiting.\""
msgstr "「すまないね、ずいぶんとお待たせしちゃって」"

#. Occurrence 1_2:3305:355: scene=1_2
#: 1_2:3305
msgctxt "text_id=355 | speaker=unknown"
msgid "  The first person he saw was a man wearing glasses and an awkward smile."
msgstr "　まず目に入ったのが、バツの悪そうな笑顔をした、眼鏡をかけた男性。"

#. Occurrence 1_2:3310:356: scene=1_2
#: 1_2:3310
msgctxt "text_id=356 | speaker=unknown"
msgid "  That's Mr. Yamasiro, the one who brought me here."
msgstr "　たしか<山城和樹|やましろかずき>という先生で、ここに案内してくれたのも彼だった。"

#. Occurrence 1_2:3331:357: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0027; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:3331
msgctxt "text_id=357 | speaker=yamashiro"
msgid "\"Hey, where's Mr. Satonaka?"
msgstr "「って、あれ？　<里中|さとなか>先生いないんですか？"

#. Occurrence 1_2:3331:358: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0027; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:3331
msgctxt "text_id=358 | speaker=yamashiro"
msgid "  I told him to keep you company. He shouldn't have left you here.\""
msgstr "　……酷いなあ、話し相手になってあげてと言ったのに」"

#. Occurrence 1_2:3337:359: scene=1_2
#: 1_2:3337
msgctxt "text_id=359 | speaker=unknown"
msgid "  Mr. Yamasiro scratched his head, looking increasingly apologetic."
msgstr "　山城氏はますます申し訳なさそうに頭をかく。"

#. Occurrence 1_2:3342:360: scene=1_2
#: 1_2:3342
msgctxt "text_id=360 | speaker=unknown"
msgid "  And then, from behind him..."
msgstr "　その後ろから、"

#. Occurrence 1_2:3416:361: scene=1_2
#: 1_2:3416
msgctxt "text_id=361 | speaker=unknown"
msgid "  With a tight-lipped expression that made it clear she didn't want to be there,"
msgstr "　不機嫌そうに口を閉ざしたまま。"

#. Occurrence 1_2:3421:362: scene=1_2
#: 1_2:3421
msgctxt "text_id=362 | speaker=unknown"
msgid "  a dark-haired girl with a determined look in her eyes appeared."
msgstr "　迷いのない眼差しで、長い黒髪の少女が現れた。"

#. Occurrence 1_2:3489:363: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0004; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:3489
msgctxt "text_id=363 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 1_2:3495:364: scene=1_2
#: 1_2:3495
msgctxt "text_id=364 | speaker=unknown"
msgid "  Soujyuro gulped."
msgstr "　呆然と息を<呑|の>む。"

#. Occurrence 1_2:3500:365: scene=1_2
#: 1_2:3500
msgctxt "text_id=365 | speaker=unknown"
msgid "  The sound of the rain on the window faded into nothingness."
msgstr "　窓を打つ雨音が<聴覚|せかい>から消失する。"

#. Occurrence 1_2:3505:366: scene=1_2
#: 1_2:3505
msgctxt "text_id=366 | speaker=unknown"
msgid "  That's when he knew..."
msgstr "　……この時。"

#. Occurrence 1_2:3510:367: scene=1_2
#: 1_2:3510
msgctxt "text_id=367 | speaker=unknown"
msgid "  This was how it felt when time stood still."
msgstr "　錯覚ではあれ、時間の経過を感じなくなる事は本当にあるのだと、彼ははじめて思い知った。"

#. Occurrence 1_2:3599:368: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0028; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:3599
msgctxt "text_id=368 | speaker=aoko"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 1_2:3605:369: scene=1_2
#: 1_2:3605
msgctxt "text_id=369 | speaker=unknown"
msgid "  She blinked quickly a few times as if taken aback."
msgstr "　彼女はほんの少し、驚くように<瞬|またた>いた。"

#. Occurrence 1_2:3610:370: scene=1_2
#: 1_2:3610
msgctxt "text_id=370 | speaker=unknown"
msgid "  Why was anyone's guess."
msgstr "　理由は不明。"

#. Occurrence 1_2:3615:371: scene=1_2
#: 1_2:3615
msgctxt "text_id=371 | speaker=unknown"
msgid "  The boy was everything she expected a naive country boy to look like. However, she felt something she couldn't understand."
msgstr "　先だって聞いていた通り、少年は純朴な田舎のイメージそのものだったのに、直感的に“納得いかない”と反発して。"

#. Occurrence 1_2:3649:372: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0005; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:3649
msgctxt "text_id=372 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 1_2:3655:373: scene=1_2
#: 1_2:3655
msgctxt "text_id=373 | speaker=unknown"
msgid "  His eyes widened slightly as if taken aback."
msgstr "　彼はほんの少し、驚くように目を開いた。"

#. Occurrence 1_2:3660:374: scene=1_2
#: 1_2:3660
msgctxt "text_id=374 | speaker=unknown"
msgid "  The reason was obvious."
msgstr "　理由は明白。"

#. Occurrence 1_2:3665:375: scene=1_2
#: 1_2:3665
msgctxt "text_id=375 | speaker=unknown"
msgid "  Putting his feeling into words was a different matter altogether. So we will never know exactly what he experienced in that moment."
msgstr "　……ただ、それを正しくカタチにできる言葉を知らなかったので、結局こちらも解答欄は空白のまま。"

#. Occurrence 1_2:3702:376: scene=1_2
#: 1_2:3702
msgctxt "text_id=376 | speaker=unknown"
msgid "  That's when it hit him..."
msgstr "　この瞬間。"

#. Occurrence 1_2:3707:377: scene=1_2
#: 1_2:3707
msgctxt "text_id=377 | speaker=unknown"
msgid "  He sensed he'd been touched by the hands of destiny."
msgstr "　少年はたしかに、何か運命じみたものに触れた気がした。"

#. Occurrence 1_2:3746:378: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0028; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:3746
msgctxt "text_id=378 | speaker=yamashiro"
msgid "\"Allow me to introduce the two of you. This is the transfer student I mentioned, Soujyuro Sizuki."
msgstr "「紹介するよ。彼が転入生の<静希|しずき><草十郎|そうじゅうろう>くん。"

#. Occurrence 1_2:3764:379: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0029; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:3764
msgctxt "text_id=379 | speaker=yamashiro"
msgid "  And this is the girl that will be showing you around."
msgstr "　で、こっちの彼女が静希くんの案内役。"

#. Occurrence 1_2:3770:380: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0030; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:3770
msgctxt "text_id=380 | speaker=yamashiro"
msgid "  She's our student council president and came in on her day off just to welcome you. Her name is Aoko Aozaki.\""
msgstr "　うちの生徒会長で、休日を押して新しい仲間の案内役を買って出てくれた、<蒼崎|あおざき><青子|あおこ>くんだ」"

#. Occurrence 1_2:3870:381: scene=1_2
#: 1_2:3870
msgctxt "text_id=381 | speaker=unknown"
msgid "  His voice and the sound of the rain seemed distant."
msgstr "　―――声も雨音も<仄|ほの>かに遠く。"

#. Occurrence 1_2:3876:382: scene=1_2
#: 1_2:3876
msgctxt "text_id=382 | speaker=unknown"
msgid "  This is how they first met."
msgstr "　二人の出会いはこんな感じ。"

#. Occurrence 1_2:3881:383: scene=1_2
#: 1_2:3881
msgctxt "text_id=383 | speaker=unknown"
msgid "  Such was their start, for better or worse. Like the ephemeral beauty of fireworks."
msgstr "　良きにしろ<悪|わる>きにしろ、バチッと火花が散るような、そんな、どうでもいい始まりだった。"

#. Occurrence 1_2:3978:384: scene=1_2
#: 1_2:3978
msgctxt "text_id=384 | speaker=unknown"
msgid "  It was commonly believed among the students..."
msgstr "　生徒たちの通説によると。"

#. Occurrence 1_2:3983:385: scene=1_2
#: 1_2:3983
msgctxt "text_id=385 | speaker=unknown"
msgid "  ...that Aoko was always in a foul mood."
msgstr "　蒼崎青子は、いつもご機嫌ななめである。"

#. Occurrence 1_2:4023:386: scene=1_2
#: 1_2:4023
msgctxt "text_id=386 | speaker=unknown"
msgid "  But this gossip was ninety percent prejudice, as Aoko simply didn't have time to be irritated twenty-four seven."
msgstr "　これは九割がた偏見で、青子だって、そんな四六時中イライラできるほど暇ではない。"

#. Occurrence 1_2:4028:387: scene=1_2
#: 1_2:4028
msgctxt "text_id=387 | speaker=unknown"
msgid "  The reality was she simply didn't want to explain herself all the time"
msgstr "　彼女は単に言い訳をしたがらない性格なだけで、"

#. Occurrence 1_2:4033:388: scene=1_2
#: 1_2:4033
msgctxt "text_id=388 | speaker=unknown"
msgid "  and therefore seemed angry about something, obvious or not."
msgstr "　たえず微妙に、ときに露骨に、見えない何かに対して怒っているように見えるだけなのだ。"

#. Occurrence 1_2:4038:389: scene=1_2
#: 1_2:4038
msgctxt "text_id=389 | speaker=unknown"
msgid "  This idle gossip did, however, lead to her earning the title of one the school's Seven Deadly Threats."
msgstr "　なので九割がたは偏見の、噂に尾ひれのついた学園七脅威の一つにすぎない。"

#. Occurrence 1_2:4060:390: scene=1_2
#: 1_2:4060
msgctxt "text_id=390 | speaker=unknown"
msgid "  The remaining ten percent of the gossip was right on the mark."
msgstr "　ただし、残りの一割は真実だ。"

#. Occurrence 1_2:4065:391: scene=1_2
#: 1_2:4065
msgctxt "text_id=391 | speaker=unknown"
msgid "  Aoko herself often had the feeling that her tendency to feel animosity toward harmless things was akin to what a chronic headache sufferer might experience."
msgstr "　青子自身、自分が慢性的な頭痛持ちなんじゃないかと疑うほど、無害なものに反感を覚える事があったりする。"

#. Occurrence 1_2:4073:392: scene=1_2
#: 1_2:4073
msgctxt "text_id=392 | speaker=unknown"
msgid "  Today fell under that ten percent."
msgstr "　今日はその一割の話。"

#. Occurrence 1_2:4078:393: scene=1_2
#: 1_2:4078
msgctxt "text_id=393 | speaker=unknown"
msgid "  For today her anger was pure,"
msgstr "　そういう時にかぎって彼女の怒りは純真な、"

#. Occurrence 1_2:4078:394: scene=1_2
#: 1_2:4078
msgctxt "text_id=394 | speaker=unknown"
msgid "  and her childish and selfish display was befitting of her actual age."
msgstr "　年相応に子供らしいわがままだったりするのだが。"

#. Occurrence 1_2:4121:395: scene=1_2
#: 1_2:4121
msgctxt "text_id=395 | speaker=unknown"
msgid "  The meeting room was dimly lit, awash in the colors of the rain."
msgstr "　会議室は薄暗い、雨の色に染まっていた。"

#. Occurrence 1_2:4126:396: scene=1_2
#: 1_2:4126
msgctxt "text_id=396 | speaker=unknown"
msgid "  To reduce electricity costs, school regulations forbid the use of lights during the day."
msgstr "　電気代節約のため、昼間は電灯をつけないのが学校のルールだ。"

#. Occurrence 1_2:4131:397: scene=1_2
#: 1_2:4131
msgctxt "text_id=397 | speaker=unknown"
msgid "  This was the setting the three of them found themselves in."
msgstr "　そんな中に、<件|くだん>の人物は立っていた。"

#. Occurrence 1_2:4166:398: scene=1_2
#: 1_2:4166
msgctxt "text_id=398 | speaker=unknown"
msgid "  Her first impression was that his calm demeanor reminded her of a field of wildflowers."
msgstr "　第一印象は、野花を連想させる落ち着き様。"

#. Occurrence 1_2:4171:399: scene=1_2
#: 1_2:4171
msgctxt "text_id=399 | speaker=unknown"
msgid "  In spite of his perfect posture, his overall air felt placid―tame, even."
msgstr "　すっと伸びた背筋のクセに、全体的に力が抜けていて、とにかくおとなしい。"

#. Occurrence 1_2:4176:400: scene=1_2
#: 1_2:4176
msgctxt "text_id=400 | speaker=unknown"
msgid "  And though describing him as meek would be going too far, at the very least he was passive."
msgstr "　ひょろり、とはいかないまでも、ひっそり、ぐらいの<頼|たよ>りなさ。"

#. Occurrence 1_2:4216:401: scene=1_2
#: 1_2:4216
msgctxt "text_id=401 | speaker=unknown"
msgid "  Even through his uniform, she could see that he was thinner than average."
msgstr "　制服の上からでも分かる、標準よりやや細い体つき。"

#. Occurrence 1_2:4221:402: scene=1_2
#: 1_2:4221
msgctxt "text_id=402 | speaker=unknown"
msgid "  His dark hair was unkempt, and he came across as a wholly forgettable boy."
msgstr "　あまり手入れをされていない黒髪と、とくに目を引く部分のない少年像が、そこにはあった。"

#. Occurrence 1_2:4226:403: scene=1_2
#: 1_2:4226
msgctxt "text_id=403 | speaker=unknown"
msgid "  If she had to look at him in a more positive light, she would describe him more a young man than a boy."
msgstr "　いや。その<凡庸|ぼんよう>さを好意的に解釈するなら、少年ではなく青年っぽいというべきだろう。"

#. Occurrence 1_2:4231:404: scene=1_2
#: 1_2:4231
msgctxt "text_id=404 | speaker=unknown"
msgid "  It was his calm demeanor that made him seem more mature."
msgstr "　落ち着いた雰囲気がどことなく大人びている。"

#. Occurrence 1_2:4251:405: scene=1_2
#: 1_2:4251
msgctxt "text_id=405 | speaker=unknown"
msgid "  Was that the cause of Aoko's reasonless reaction?"
msgstr "　……そのあたりが青子の“理由なき反感”に繋がったのか。"

#. Occurrence 1_2:4256:406: scene=1_2
#: 1_2:4256
msgctxt "text_id=406 | speaker=unknown"
msgid "  He seemed almost too at home in the meeting room, and she was left with the impression that it was her and the teacher, not this outsider, who were the guests here."
msgstr "　少年はあまりに自然で、違和感なく会議室の風景に溶けこんでいた。学校では彼の方が異分子なのに、自分たちの方が客人になったような錯覚。"

#. Occurrence 1_2:4293:407: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0029; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:4293
msgctxt "text_id=407 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 1_2:4299:408: scene=1_2
#: 1_2:4299
msgctxt "text_id=408 | speaker=unknown"
msgid "  She felt an unidentifiable aggravation building within her, almost as if her right to be here was in question."
msgstr "　まるで、自分たちが持って生まれた正当性を<糾|ただ>されたような、正体不明の苛立ち。"

#. Occurrence 1_2:4304:409: scene=1_2
#: 1_2:4304
msgctxt "text_id=409 | speaker=unknown"
msgid "  Aoko felt herself raising her natural defenses."
msgstr "　カチン、と警戒心にスイッチが入るのを青子は感じた。"

#. Occurrence 1_2:4343:410: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0030; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:4343
msgctxt "text_id=410 | speaker=aoko"
msgid "(...What's with me?"
msgstr "『―――信じられない。"

#. Occurrence 1_2:4349:411: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0031; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:4349
msgctxt "text_id=411 | speaker=aoko"
msgid "  Am I really this angry for no reason?)"
msgstr "　私、いま<意|ワ><味|ケ>もなく怒ってない……？』"

#. Occurrence 1_2:4435:412: scene=1_2
#: 1_2:4435
msgctxt "text_id=412 | speaker=unknown"
msgid "  She hated not understanding things, her own emotions, in particular."
msgstr "　分からない事は苛立たしい。自分の<感|コ><情|ト>なら尚更だ。"

#. Occurrence 1_2:4440:413: scene=1_2
#: 1_2:4440
msgctxt "text_id=413 | speaker=unknown"
msgid "  It pained her less than you would imagine for a perfectionist like her, but it still nagged her like a thorn in her side."
msgstr "　完璧主義者である彼女にとって、それは痛くはないけど気がかりなトゲのようなもので、"

#. Occurrence 1_2:4447:414: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0031; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:4447
msgctxt "text_id=414 | speaker=yamashiro"
msgid "\"Uh, hahaha. Aozaki, why don't you introduce yourself?\""
msgstr "「いやぁ、ははは。ほら蒼崎くん、挨拶してあげなくちゃ」"

#. Occurrence 1_2:4490:415: scene=1_2
#: 1_2:4490
msgctxt "text_id=415 | speaker=unknown"
msgid "  Mr. Yamasiro's attempt to relieve the tension was equally irritating."
msgstr "　山城の場を取り<繕|つくろ>う声にも、わりと本気でイラっとした。"

#. Occurrence 1_2:4531:416: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0032; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:4531
msgctxt "text_id=416 | speaker=aoko"
msgid "\"...Introduce myself, huh.\""
msgstr "「―――挨拶？」"

#. Occurrence 1_2:4537:417: scene=1_2
#: 1_2:4537
msgctxt "text_id=417 | speaker=unknown"
msgid "  After casting a nasty glance in the teacher's direction, Aoko turned to face the boy."
msgstr "　じろりと山城を横目で睨んでから、青子はまっすぐに少年を見据えた。"

#. Occurrence 1_2:4560:418: scene=1_2
#: 1_2:4560
msgctxt "text_id=418 | speaker=unknown"
msgid "  From an outsider's perspective, it might have looked like a staredown."
msgstr "　いや、第三者的に見れば、正面から睨みつけた。"

#. Occurrence 1_2:4572:419: scene=1_2
#: 1_2:4572
msgctxt "text_id=419 | speaker=unknown"
msgid "  And in that instant..."
msgstr "　この瞬間。"

#. Occurrence 1_2:4577:420: scene=1_2
#: 1_2:4577
msgctxt "text_id=420 | speaker=unknown"
msgid "  The culmination of her emotional state hurtled toward the innocent boy, and skewered him."
msgstr "　災難なことに、彼女の感情の矛先はぴったりと、なんの罪もない初対面の少年に向けられたのである。"

#. Occurrence 1_2:4629:421: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0032; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:4629
msgctxt "text_id=421 | speaker=yamashiro"
msgid "\"Again, sorry for the wait, Sizuki.\""
msgstr "「いや、待たせたね静希くん」"

#. Occurrence 1_2:4643:422: scene=1_2
#: 1_2:4643
msgctxt "text_id=422 | speaker=unknown"
msgid "  Hearing his name, Soujyuro came to his senses."
msgstr "　名前を呼ばれて少年……草十郎は我に返った。"

#. Occurrence 1_2:4648:423: scene=1_2
#: 1_2:4648
msgctxt "text_id=423 | speaker=unknown"
msgid "  His stunned gaze shook loose."
msgstr "　見惚れていた目をゆるめて、"

#. Occurrence 1_2:4653:424: scene=1_2
#: 1_2:4653
msgctxt "text_id=424 | speaker=unknown"
msgid "  He took a deep breath to clear his head."
msgstr "　目眩を飲みこむように息を吸う。"

#. Occurrence 1_2:4658:425: scene=1_2
#: 1_2:4658
msgctxt "text_id=425 | speaker=unknown"
msgid "  Chalking it up to nerves, Mr. Yamasiro broke out a smile and turned to the girl standing beside him."
msgstr "　その仕草から緊張していると見たのか、山城教諭は穏やかに笑って、かたわらの少女に語りかけた。"

#. Occurrence 1_2:4699:426: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0033; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:4699
msgctxt "text_id=426 | speaker=yamashiro"
msgid "\"I'll do the introductions then. This is the transfer student, Soujyuro Sizuki."
msgstr "「紹介するよ。彼が転入生の静希草十郎くん。"

#. Occurrence 1_2:4705:427: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0034; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:4705
msgctxt "text_id=427 | speaker=yamashiro"
msgid "  And this is our student council president who came in on her day off just to show you around. Her name is Aoko Aozaki.\""
msgstr "　で、こっちの彼女が静希くんの案内役。うちの生徒会長で、休日を押して新しい仲間の案内役を買って出てくれた、蒼崎青子くんだ」"

#. Occurrence 1_2:4743:428: scene=1_2
#: 1_2:4743
msgctxt "text_id=428 | speaker=unknown"
msgid "  Having been introduced by Mr. Yamasiro, the girl took a step forward."
msgstr "　山城教諭に紹介され、少女は一歩前に出る。"

#. Occurrence 1_2:4748:429: scene=1_2
#: 1_2:4748
msgctxt "text_id=429 | speaker=unknown"
msgid "  Her eyes were merciless."
msgstr "　視線に容赦はない。"

#. Occurrence 1_2:4753:430: scene=1_2
#: 1_2:4753
msgctxt "text_id=430 | speaker=unknown"
msgid "  Her stare, an unspoken threat to violently trample her opponent."
msgstr "　ほとんど暴力に近い、<値|ね><踏|ぶ>みするような凝視。"

#. Occurrence 1_2:4787:431: scene=1_2
#: 1_2:4787
msgctxt "text_id=431 | speaker=unknown"
msgid "  Soujyuro, on the other hand, managed to keep his own composure despite the shock at how confrontational she appeared."
msgstr "　<一方|いっぽう>草十郎は、正面から堂々と見つめられる事に驚きつつ、なんとか平静を保っていた。"

#. Occurrence 1_2:4792:432: scene=1_2
#: 1_2:4792
msgctxt "text_id=432 | speaker=unknown"
msgid "  He had never been greeted quite like this before, but supposed, mistakenly, that this was how people treated each other in the city."
msgstr "　これまでこういう挨拶には出会わなかったけれど、都会では珍しいものではないのだろう、と勘違いしての事である。"

#. Occurrence 1_2:4836:433: scene=1_2
#: 1_2:4836
msgctxt "text_id=433 | speaker=unknown"
msgid "  The exchange must have looked quite dramatic to an onlooker."
msgstr "　そんなふたりのやり取りは、第三者視点からすると壮絶なものがあった。"

#. Occurrence 1_2:4842:434: scene=1_2
#: 1_2:4842
msgctxt "text_id=434 | speaker=unknown"
msgid "  A girl ready to brawl..."
msgstr "　とにかく因縁をつけたがっている乱暴者と、"

#. Occurrence 1_2:4847:435: scene=1_2
#: 1_2:4847
msgctxt "text_id=435 | speaker=unknown"
msgid "  An earnest country boy desperate to understand..."
msgstr "　それを何事だろう、と真剣に眺めている田舎者。"

#. Occurrence 1_2:4853:436: scene=1_2
#: 1_2:4853
msgctxt "text_id=436 | speaker=unknown"
msgid "  It was a murderous limbo, especially for anyone in the room with them."
msgstr "　当事者たちはともかく、周りにいる人間にとっては蛇の生殺しに近い。"

#. Occurrence 1_2:4894:437: scene=1_2
#: 1_2:4894
msgctxt "text_id=437 | speaker=unknown"
msgid "  Like Mr. Yamasiro, for example."
msgstr "　たとえば、青子の後ろにいる山城教諭とか。"

#. Occurrence 1_2:4899:438: scene=1_2
#: 1_2:4899
msgctxt "text_id=438 | speaker=unknown"
msgid "  While he had thought he had made the right decision in choosing an honor student to help him out, she was in an inexplicably bad mood, and the tension in the air was undeniable."
msgstr "　良かれと思って案内役に優等生を選んでみたものの、なぜかその優等生はご機嫌ななめ。今もピリピリと空気を<震|ふる>わせている。"

#. Occurrence 1_2:4993:439: scene=1_2
#: 1_2:4993
msgctxt "text_id=439 | speaker=unknown"
msgid "  It was this moment that he realized his failure."
msgstr "　ここに至って、山城は自らの失敗を受け入れた。"

#. Occurrence 1_2:4998:440: scene=1_2
#: 1_2:4998
msgctxt "text_id=440 | speaker=unknown"
msgid "  His realization had come far too late."
msgstr "　今さらの話ではあるが、"

#. Occurrence 1_2:5003:441: scene=1_2
#: 1_2:5003
msgctxt "text_id=441 | speaker=unknown"
msgid "  One false move, and this girl, for whom no problem was too large, would becoming a storm that would rock the very foundations of the school."
msgstr "　この、万事をそつなく解決する女子生徒は、扱いどころを間違えると一転して学校を<震|ふる>わす嵐になる。"

#. Occurrence 1_2:5008:442: scene=1_2
#: 1_2:5008
msgctxt "text_id=442 | speaker=unknown"
msgid "  Just as the almighty joker card could bring either fortune or disaster, the sole teacher who had been present at the time would come to bear the blame for the scandal that ensued."
msgstr "　オールマイティの絵柄が<悪魔|ジョーカー>みたいなもので、そんな時、現場に居合わせた教師はたいてい、<不祥事|ふしょうじ>の責任を取らされるのだ。"

#. Occurrence 1_2:5073:443: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0035; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:5073
msgctxt "text_id=443 | speaker=yamashiro"
msgid "\"Wow, you two really seem to have hit it off!"
msgstr "「あー、うん。いけてる、二人とも気は合うようだね！"

#. Occurrence 1_2:5079:444: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0036; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:5079
msgctxt "text_id=444 | speaker=yamashiro"
msgid "  ...I suppose I can leave you two to it, then?\""
msgstr "　……それじゃ、僕はこのヘンでいいかな？」"

#. Occurrence 1_2:5085:445: scene=1_2
#: 1_2:5085
msgctxt "text_id=445 | speaker=unknown"
msgid "  Mr. Yamasiro laughed nervously as he crept toward the door."
msgstr "　あはは、と白けた笑い声をあげながら、山城教諭はそろりそろりと扉に後じさった。"

#. Occurrence 1_2:5126:446: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0037; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:5126
msgctxt "text_id=446 | speaker=yamashiro"
msgid "\"I'll be in the faculty room. Stop by when you're finished."
msgstr "「僕は職員室にいるから、終わったら来るように。"

#. Occurrence 1_2:5132:447: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0038; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:5132
msgctxt "text_id=447 | speaker=yamashiro"
msgid "  You'll be alright, won't you, Aozaki?"
msgstr "　いいかい蒼崎くん、くれぐれも、くれぐれもだぜ？"

#. Occurrence 1_2:5145:448: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0039; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:5145
msgctxt "text_id=448 | speaker=yamashiro"
msgid "  You're the student council president! Don't let me down!\""
msgstr "　なんていうか、生徒会長としての度量の広さを、このさい僕に信じさせてほしいかな！」"

#. Occurrence 1_2:5216:449: scene=1_2
#: 1_2:5216
msgctxt "text_id=449 | speaker=unknown"
msgid "  Mr. Yamasiro left, leaving the two in a locked-eyed state, one in which one set of eyes was doing all the glaring."
msgstr "　見つめあう……正確に言うと、一方は睨まれている…ふたりをそれきりにして、山城教諭は去っていった。"

#. Occurrence 1_2:5222:450: scene=1_2
#: 1_2:5222
msgctxt "text_id=450 | speaker=unknown"
msgid "  All that remained in the room was an artless boy"
msgstr "　残されたのは<木訥|ぼくとつ>さの化身みたいな少年と、"

#. Occurrence 1_2:5227:451: scene=1_2
#: 1_2:5227
msgctxt "text_id=451 | speaker=unknown"
msgid "  and a cross-armed, guarded girl."
msgstr "　ずーんと腕組みをしている少女だけ。"

#. Occurrence 1_2:5283:452: scene=1_2
#: 1_2:5283
msgctxt "text_id=452 | speaker=unknown"
msgid "  The two lingered in silence."
msgstr "　しばしの沈黙。"

#. Occurrence 1_2:5288:453: scene=1_2
#: 1_2:5288
msgctxt "text_id=453 | speaker=unknown"
msgid "  They resembled shogi players agonizing over their first moves, though it was only Aoko who was reading so much into the situation."
msgstr "　お互い初手に悩んでいる将棋指しのようだが、その実、思案しているのは自分だけである事に青子は気付いた。"

#. Occurrence 1_2:5308:454: scene=1_2
#: 1_2:5308
msgctxt "text_id=454 | speaker=unknown"
msgid "  She decided to put her irritation aside for the time being."
msgstr "　とりあえず、<苛々|イライラ>するのは置いておいて。"

#. Occurrence 1_2:5322:455: scene=1_2
#: 1_2:5322
msgctxt "text_id=455 | speaker=unknown"
msgid "  With no reason to feel revulsion for him in the first place, she sighed deeply and faced Soujyuro."
msgstr "　そもそも彼に反感を覚える理由はないんだから、と大きくため息をついて、青子は草十郎に向き直った。"

#. Occurrence 1_2:5360:456: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0033; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:5360
msgctxt "text_id=456 | speaker=aoko"
msgid "\"Whatever. It's not like this is the first time that Mr. Yamasiro landed me in it."
msgstr "「まあいいわ。山城先生が<昼行灯|ひるあんどん>なのは今に始まった事じゃないし。"

#. Occurrence 1_2:5367:457: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0034; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:5367
msgctxt "text_id=457 | speaker=aoko"
msgid "So... what's your name again?\""
msgstr "―――それで。あなた、名前は？」"

#. Occurrence 1_2:5379:458: scene=1_2
#: 1_2:5379
msgctxt "text_id=458 | speaker=unknown"
msgid "  Her tone was nothing if not reproachful, though he had done nothing to offend her."
msgstr "　きつい口調は、自分から話しかけてこない少年を非難してのものだ。"

#. Occurrence 1_2:5385:459: scene=1_2
#: 1_2:5385
msgctxt "text_id=459 | speaker=unknown"
msgid "But the boy failed to pick up on it."
msgstr "が、少年は声に含まれた嫌味に気が付かなかった。"

#. Occurrence 1_2:5426:460: scene=1_2
#: 1_2:5426
msgctxt "text_id=460 | speaker=unknown"
msgid "  Incapable of such venom himself,"
msgstr "　そういう毒っ気とは一生<縁|えん>のない顔で、"

#. Occurrence 1_2:5440:461: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0006; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:5440
msgctxt "text_id=461 | speaker=soujuurou"
msgid "\"I'm Soujyuro Sizuki,\" he replied. \"And you're... Miss Aozaki, right?\""
msgstr "「ああ、静希草十郎かな。君は蒼崎さんだったね」"

#. Occurrence 1_2:5446:462: scene=1_2
#: 1_2:5446
msgctxt "text_id=462 | speaker=unknown"
msgid "  For whatever reason, he came across as happy in his response."
msgstr "　なぜか嬉しげに、噛みしめるように応答した。"

#. Occurrence 1_2:5493:463: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0035; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:5493
msgctxt "text_id=463 | speaker=aoko"
msgid "\"Drop the 'Miss.' That's not my style."
msgstr "「さんはいいわ、<柄|ガラ>じゃないから。"

#. Occurrence 1_2:5499:464: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0036; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:5499
msgctxt "text_id=464 | speaker=aoko"
msgid "  Is Sizuki fine?\""
msgstr "　こっちは静希君でいい？」"

#. Occurrence 1_2:5505:465: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0007; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:5505
msgctxt "text_id=465 | speaker=soujuurou"
msgid "\"What do you mean?\""
msgstr "「いいって、なにが？」"

#. Occurrence 1_2:5516:466: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0037; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:5516
msgctxt "text_id=466 | speaker=aoko"
msgid "\"What do you mean, what do I mean?\""
msgstr "「だから呼び方。<君|くん>付けでいいかって訊いてるの」"

#. Occurrence 1_2:5553:467: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0008; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:5553
msgctxt "text_id=467 | speaker=soujuurou"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 1_2:5575:468: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0038; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:5575
msgctxt "text_id=468 | speaker=aoko"
msgid "\"Hello? Did I say something weird?\""
msgstr "「……なによ。おかしなコト言った、私？」"

#. Occurrence 1_2:5588:469: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0009; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:5588
msgctxt "text_id=469 | speaker=soujuurou"
msgid "\"Yeah, very-\""
msgstr "「いや、すごく」"

#. Occurrence 1_2:5593:470: scene=1_2
#: 1_2:5593
msgctxt "text_id=470 | speaker=unknown"
msgid "  The boy replied immediately as if it was a natural response, but quickly second guessed himself."
msgstr "　少年は当たり前のように即答しながら、あれ、そうでもないのか、などとひとりこぼす。"

#. Occurrence 1_2:5621:471: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0010; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:5621
msgctxt "text_id=471 | speaker=soujuurou"
msgid "\"Uh, never mind. That must be normal here."
msgstr "「いや、いいんだ、ごく一般的なんだろう。"

#. Occurrence 1_2:5633:472: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0011; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:5633
msgctxt "text_id=472 | speaker=soujuurou"
msgid "  You can call me Sizuki. You mind if I call you Aozaki?\""
msgstr "　静希君で頼む。君は蒼崎でいいんだよな？」"

#. Occurrence 1_2:5658:473: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0039; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:5658
msgctxt "text_id=473 | speaker=aoko"
msgid "\"Suit yourself.\""
msgstr "「ええ、よろしく」"

#. Occurrence 1_2:5669:474: scene=1_2
#: 1_2:5669
msgctxt "text_id=474 | speaker=unknown"
msgid "  She followed her blunt reply with a swift turn away from him."
msgstr "　素っ気なく応えて<踵|きびす>を返す青子。"

#. Occurrence 1_2:5674:475: scene=1_2
#: 1_2:5674
msgctxt "text_id=475 | speaker=unknown"
msgid "  While she was hardly thrilled at the prospect of the task at hand, it had been entrusted to her, and it was her personal policy to see it through to the end."
msgstr "　気は乗らないが、任されたからにはきちんと仕事をこなすのが彼女のポリシーである。"

#. Occurrence 1_2:5707:476: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0040; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:5707
msgctxt "text_id=476 | speaker=aoko"
msgid "\"Sorry, but I'm not in the mood for pleasantries."
msgstr "「悪いけど、優しくしてあげる気はないから。"

#. Occurrence 1_2:5713:477: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0041; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:5713
msgctxt "text_id=477 | speaker=aoko"
msgid "  Time is short, so let's get this over with.\""
msgstr "　時間も惜しいし、手早くいくわよ」"

#. Occurrence 1_2:5733:478: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0012; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:5733
msgctxt "text_id=478 | speaker=soujuurou"
msgid "\"Sure. I know your time is valuable.\""
msgstr "「それは助かる。やっぱり時間は大切だ」"

#. Occurrence 1_2:5739:479: scene=1_2
#: 1_2:5739
msgctxt "text_id=479 | speaker=unknown"
msgid "  Aoko's blunt rancor was lost on him once again."
msgstr "　青子の<直球|いやみ>は、またも効果なくスルーされた。"

#. Occurrence 1_2:5778:480: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0042; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:5778
msgctxt "text_id=480 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 1_2:5784:481: scene=1_2
#: 1_2:5784
msgctxt "text_id=481 | speaker=unknown"
msgid "  Humans tend to be overly conscious about being ignored, whatever form that takes."
msgstr "　どんな行為にしろ、無視をされると余計意識してしまうのが人間である。"

#. Occurrence 1_2:5789:482: scene=1_2
#: 1_2:5789
msgctxt "text_id=482 | speaker=unknown"
msgid "  But despite being peeved at landing none of her attacks, Aoko did her best to act professional and directed her guest into the hallway."
msgstr "　さっきからことごとく攻撃が<空|から>ぶっている事にムッとしながらも、青子は<努|つと>めて事務的に廊下に出るよう<促|うなが>した。"

#. Occurrence 1_2:5839:483: scene=1_2
#: 1_2:5839
msgctxt "text_id=483 | speaker=unknown"
msgid "  There was no sunlight in the hallway, nor any sign of life."
msgstr "　窓のない通路には外からの日差しも、人の気配もない。"

#. Occurrence 1_2:5844:484: scene=1_2
#: 1_2:5844
msgctxt "text_id=484 | speaker=unknown"
msgid "  This was more like a prison than the cave that was the meeting room."
msgstr "　会議室が天然の岩屋なら、こちらは人工の監獄を思わせる。"

#. Occurrence 1_2:5849:485: scene=1_2
#: 1_2:5849
msgctxt "text_id=485 | speaker=unknown"
msgid "  As it dawned on Aoko that the hallway matched her mood, she sighed once again."
msgstr "　実に今の気分にあった廊下だわ、と青子はまたもため息ひとつ。"

#. Occurrence 1_2:5889:486: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0043; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:5889
msgctxt "text_id=486 | speaker=aoko"
msgid "\"First things first. Did you understand everything Mr. Yamasiro explained to you?\""
msgstr "「まず訊いておくけど、山城先生から聞いた事は理解してる？」"

#. Occurrence 1_2:5913:487: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0013; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:5913
msgctxt "text_id=487 | speaker=soujuurou"
msgid "\"Yes, I get how the school works."
msgstr "「ああ、学校の仕組みについては分かった。"

#. Occurrence 1_2:5919:488: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0014; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:5919
msgctxt "text_id=488 | speaker=soujuurou"
msgid "  But it's still a bit hard to imagine that everyone here is around the same age.\""
msgstr "　この建物ぜんぶに<同|おな>い<年|どし>の人間がいるなんて、ちょっと想像できないけど」"

#. Occurrence 1_2:5953:489: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0044; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:5953
msgctxt "text_id=489 | speaker=aoko"
msgid "\"...I see. Great.\""
msgstr "「……そ、良かったわね」"

#. Occurrence 1_2:5959:490: scene=1_2
#: 1_2:5959
msgctxt "text_id=490 | speaker=unknown"
msgid "  Aoko rubbed her forehead."
msgstr "　額を指で押さえる青子。"

#. Occurrence 1_2:5964:491: scene=1_2
#: 1_2:5964
msgctxt "text_id=491 | speaker=unknown"
msgid "  This Soujyuro kid had no idea what he was in for."
msgstr "　この草十郎という少年は学校のなんたるかも知らなかった。"

#. Occurrence 1_2:5970:492: scene=1_2
#: 1_2:5970
msgctxt "text_id=492 | speaker=unknown"
msgid "Apparently, all he'd heard about school was that it was a place where a lot of people met to study."
msgstr "ただ漠然と、大勢の人々で学習する場所、としか聞いていなかったらしい。"

#. Occurrence 1_2:5999:493: scene=1_2
#: 1_2:5999
msgctxt "text_id=493 | speaker=unknown"
msgid "  High school teachers imparted to students their knowledge in various fields of study, while fostering discipline and creativity."
msgstr "　高校教師は様々な分野の知識や見識、<機構|きこう>と創造性を生徒に教授する。"

#. Occurrence 1_2:6004:494: scene=1_2
#: 1_2:6004
msgctxt "text_id=494 | speaker=unknown"
msgid "  But never did Aoko imagine that she would have to explain the concept of school itself to someone."
msgstr "　が、そもそも学校とは何か、と根本の理念を語る日がこようとは、夢にも思わなかっただろう。"

#. Occurrence 1_2:6009:495: scene=1_2
#: 1_2:6009
msgctxt "text_id=495 | speaker=unknown"
msgid "  Yes, fundamentals were important. But this was absurd."
msgstr "　基本は大事というが、それにしても基本すぎる。"

#. Occurrence 1_2:6014:496: scene=1_2
#: 1_2:6014
msgctxt "text_id=496 | speaker=unknown"
msgid "  She had serious doubts whether he could even handle classes, but Mr. Yamasiro insisted that things would work out somehow."
msgstr "　……そんなんで高等学校の授業についてこられるのかと青子は疑問を抱いたが、山城教諭曰く、そこは何とかなっていたとのこと。"

#. Occurrence 1_2:6019:497: scene=1_2
#: 1_2:6019
msgctxt "text_id=497 | speaker=unknown"
msgid "  Soujyuro had managed to pass the transfer exam, after all. Barely."
msgstr "　一応、転入試験はギリギリでパスしたらしい。"

#. Occurrence 1_2:6059:498: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0045; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:6059
msgctxt "text_id=498 | speaker=aoko"
msgid "(Not my problem.)"
msgstr "『……ま、私には関係ないけど』"

#. Occurrence 1_2:6065:499: scene=1_2
#: 1_2:6065
msgctxt "text_id=499 | speaker=unknown"
msgid "  Aoko grumbled mentally as she walked down the hallway."
msgstr "　内心で呟きながら廊下を歩く青子。"

#. Occurrence 1_2:6070:500: scene=1_2
#: 1_2:6070
msgctxt "text_id=500 | speaker=unknown"
msgid "  She consoled herself with the fact that today would be the only day she'd spend with this boy out of time... or at least, she'd try to keep it that way."
msgstr "　なんであれ、この<時代錯誤|じだいさくご>な男子と付き合うのは今日だけなのだ、いや、今日だけにしたい、と自分に言い聞かせながら。"

#. Occurrence 1_2:6104:501: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0015; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:6104
msgctxt "text_id=501 | speaker=soujuurou"
msgid "\"Aozaki?\""
msgstr "「蒼崎」"

#. Occurrence 1_2:6110:502: scene=1_2
#: 1_2:6110
msgctxt "text_id=502 | speaker=unknown"
msgid "  He asked, calmly trying to get her attention."
msgstr "　そんな青子に、少年は平然と話しかけた。"

#. Occurrence 1_2:6131:503: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0046; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:6131
msgctxt "text_id=503 | speaker=aoko"
msgid "\"What?\""
msgstr "「なに？」"

#. Occurrence 1_2:6137:504: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0016; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:6137
msgctxt "text_id=504 | speaker=soujuurou"
msgid "\"Can I ask you something?\""
msgstr "「こっちもひとつ訊いていいかな」"

#. Occurrence 1_2:6159:505: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0047; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:6159
msgctxt "text_id=505 | speaker=aoko"
msgid "\"Yes. What is it?\""
msgstr "「だから、なに？」"

#. Occurrence 1_2:6187:506: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0017; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:6187
msgctxt "text_id=506 | speaker=soujuurou"
msgid "\"I could be wrong about this, but you seem upset about something."
msgstr "「俺の気のせいだと思うんだが、君はまるで、何かを睨んでいるように見える。"

#. Occurrence 1_2:6193:507: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0018; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:6193
msgctxt "text_id=507 | speaker=soujuurou"
msgid "  You're not a morning person, are you?\""
msgstr "　やはり、今朝は悪いものでも？」"

#. Occurrence 1_2:6199:508: scene=1_2
#: 1_2:6199
msgctxt "text_id=508 | speaker=unknown"
msgid "  His gaze revealed earnest concern, as if asking her if she'd remembered to eat breakfast."
msgstr "　食べたのかい？　と本気で心配する眼差し。"

#. Occurrence 1_2:6228:509: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0048; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:6228
msgctxt "text_id=509 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 1_2:6248:510: scene=1_2
#: 1_2:6248
msgctxt "text_id=510 | speaker=unknown"
msgid "  It was like another hammer to her head."
msgstr "　ガン、と二度目のハンマーが青子の頭を叩いた。"

#. Occurrence 1_2:6280:511: scene=1_2
#: 1_2:6280
msgctxt "text_id=511 | speaker=unknown"
msgid "  It was true that Aoko had been glaring at Soujyuro the entire time."
msgstr "　たしかに青子はさっきから草十郎を睨んでいる。"

#. Occurrence 1_2:6285:512: scene=1_2
#: 1_2:6285
msgctxt "text_id=512 | speaker=unknown"
msgid "  Glaring red-hot daggers, in fact."
msgstr "　というかもう本気で睨んでいる。"

#. Occurrence 1_2:6290:513: scene=1_2
#: 1_2:6290
msgctxt "text_id=513 | speaker=unknown"
msgid "  Not just at him, but the universe."
msgstr "　むしろあらゆるものを睨んでいる。"

#. Occurrence 1_2:6310:514: scene=1_2
#: 1_2:6310
msgctxt "text_id=514 | speaker=unknown"
msgid "  Even on her best days, her roommate used to remark,"
msgstr "　平時でさえ同居人から、"

#. Occurrence 1_2:6346:515: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_2_0000; voice_prefix=A40; voice_category=2; scene=1_2
#: 1_2:6346
msgctxt "text_id=515 | speaker=alice"
msgid "\"Most people can't handle your scowl, Aoko."
msgstr "『青子の視線は普通の人には厳しいわ。"

#. Occurrence 1_2:6352:516: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_2_0001; voice_prefix=A40; voice_category=2; scene=1_2
#: 1_2:6352
msgctxt "text_id=516 | speaker=alice"
msgid "  It wouldn't hurt you to be a little more tolerant.\""
msgstr "　もう少し、多くのことに寛大になるべきね』"

#. Occurrence 1_2:6358:517: scene=1_2
#: 1_2:6358
msgctxt "text_id=517 | speaker=unknown"
msgid "  She'd been warned that her emotions were so naked on her face that people treated her like a powder keg. How naive could the boy be that he could not pick up on this?"
msgstr "　と<諭|さと>されるぐらいの視線が、明確に“これ以上負荷がかかったらキレる”と意思表示しまくっているのだ。それを気のせいと感じられるほど、この少年は鈍感なのだろうか？"

#. Occurrence 1_2:6418:518: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0049; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:6418
msgctxt "text_id=518 | speaker=aoko"
msgid "(He's not making fun of me, is he? No... he couldn't be.)"
msgstr "『……私を馬鹿にしてる……って訳じゃなさそうよね、この場合』"

#. Occurrence 1_2:6434:519: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0019; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:6434
msgctxt "text_id=519 | speaker=soujuurou"
msgid "\"Hm?\""
msgstr "「？」"

#. Occurrence 1_2:6439:520: scene=1_2
#: 1_2:6439
msgctxt "text_id=520 | speaker=unknown"
msgid "  Even she found her own attempt to reassure herself unconvincing."
msgstr "　自分にそう言い聞かせてみたが、あまり確証は取れそうになかった。"

#. Occurrence 1_2:6475:521: scene=1_2
#: 1_2:6475
msgctxt "text_id=521 | speaker=unknown"
msgid "  It began to dawn on Aoko, far too late..."
msgstr "　青子は今さらながら直感する。"

#. Occurrence 1_2:6480:522: scene=1_2
#: 1_2:6480
msgctxt "text_id=522 | speaker=unknown"
msgid "  ...that compared to her, this laid-back transfer student might as well have been from another planet."
msgstr "　この間の抜けた転入生は、自分にとって未知の生き物と同義なのではないだろうか、と。"

#. Occurrence 1_2:6518:523: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0050; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:6518
msgctxt "text_id=523 | speaker=aoko"
msgid "\"Look. Let me spell it out for you, because you're just not getting it."
msgstr "「……いいわ。言葉にしないと分からないようだから言うけど、まるで、じゃなくて、ずばりそうなの。"

#. Occurrence 1_2:6524:524: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0051; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:6524
msgctxt "text_id=524 | speaker=aoko"
msgid "  It's not your imagination. I am angry and anyone could see that in my eyes. It's easier than trying to make conversation.\""
msgstr "　貴方の気のせいじゃなくて、私は視線で遠回しに感情を表現してたの。いちいち声にだすのも、会話にするのも面倒だから」"

#. Occurrence 1_2:6530:525: scene=1_2
#: 1_2:6530
msgctxt "text_id=525 | speaker=unknown"
msgid "  In response to her words, the Martian clapped his hands together."
msgstr "　青子の言葉に、ポン、と両手を叩くインベーダー。"

#. Occurrence 1_2:6570:526: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0020; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:6570
msgctxt "text_id=526 | speaker=soujuurou"
msgid "\"That makes sense. I don't know why you'd want to do it that way, but I get that it's a faster way to express yourself.\""
msgstr "「なるほど。どうしてそうしたいのかは分からないが、たしかに、そっちの方がてっとり早い意思表現だ」"

#. Occurrence 1_2:6590:527: scene=1_2
#: 1_2:6590
msgctxt "text_id=527 | speaker=unknown"
msgid "  Soujyuro accepted her reasoning without argument."
msgstr "　素直に納得する草十郎。"

#. Occurrence 1_2:6595:528: scene=1_2
#: 1_2:6595
msgctxt "text_id=528 | speaker=unknown"
msgid "  Though he still had no idea what kinds of emotions she was trying to express."
msgstr "　けれど、彼は青子がどんな感情を表現しているのかが分かっていない。"

#. Occurrence 1_2:6600:529: scene=1_2
#: 1_2:6600
msgctxt "text_id=529 | speaker=unknown"
msgid "  It was as if he could hear the words but didn't grasp the meaning."
msgstr "　文字は読めるけれど、その意味までは掴めていない。"

#. Occurrence 1_2:6605:530: scene=1_2
#: 1_2:6605
msgctxt "text_id=530 | speaker=unknown"
msgid "  Ideas that should have connected were instead separated into blocks."
msgstr "　本来直結して考えるべき事が、ブロック単位で離れている感じ。"

#. Occurrence 1_2:6647:531: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0052; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:6647
msgctxt "text_id=531 | speaker=aoko"
msgid "(So it's true. He really is peculiar.)"
msgstr "『……たしかにズレてるわ、こいつ……』"

#. Occurrence 1_2:6653:532: scene=1_2
#: 1_2:6653
msgctxt "text_id=532 | speaker=unknown"
msgid "  Mr. Yamasiro's words made sense to her now."
msgstr "　青子は山城教諭の言葉を今更ながらに納得した。"

#. Occurrence 1_2:6658:533: scene=1_2
#: 1_2:6658
msgctxt "text_id=533 | speaker=unknown"
msgid "  What was odd about this boy went way beyond naivety."
msgstr "　この少年のおかしさは、鈍感だとかそういった基準の話ではないらしい。"

#. Occurrence 1_2:6663:534: scene=1_2
#: 1_2:6663
msgctxt "text_id=534 | speaker=unknown"
msgid "  A stranger in a strange land he may be, but it was only civilized to forgive him some jet lag-induced confusion."
msgstr "　……それでも。彼にとってここは異国の地のようなもの、多少の時差ボケは許容するのが文明人というものだろう。"

#. Occurrence 1_2:6696:535: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0053; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:6696
msgctxt "text_id=535 | speaker=aoko"
msgid "\"Let's visit your classroom.\""
msgstr "「じゃ、とりあえず貴方の教室に行くから」"

#. Occurrence 1_2:6702:536: scene=1_2
#: 1_2:6702
msgctxt "text_id=536 | speaker=unknown"
msgid "  She had regained her composure."
msgstr "　気を取り直して青子は言う。"

#. Occurrence 1_2:6707:537: scene=1_2
#: 1_2:6707
msgctxt "text_id=537 | speaker=unknown"
msgid "  Soujyuro raised his hand and stopped in his tracks."
msgstr "　それを草十郎は片手を上げて止めた。"

#. Occurrence 1_2:6741:538: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0021; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:6741
msgctxt "text_id=538 | speaker=soujuurou"
msgid "\"Just one more thing.\""
msgstr "「ああ、あとひとつ」"

#. Occurrence 1_2:6769:539: scene=1_2
#: 1_2:6769
msgctxt "text_id=539 | speaker=unknown"
msgid "  Aoko waited for Soujyuro to continue. The boy was patient to a fault."
msgstr "　あくまで泰然と言う草十郎に、青子は黙って先を<促|うなが>した。"

#. Occurrence 1_2:6774:540: scene=1_2
#: 1_2:6774
msgctxt "text_id=540 | speaker=unknown"
msgid "  She rubbed her forehead with her hand again, nursing a vague feeling of uneasiness."
msgstr "　額を指で押さえたまま、漠然とした不安を感じたまま。"

#. Occurrence 1_2:6816:541: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0022; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:6816
msgctxt "text_id=541 | speaker=soujuurou"
msgid "\"I wanted to ask-why are you so angry?"
msgstr "「これもちょっとした疑問なんだが、なんで君は怒ってるんだ？"

#. Occurrence 1_2:6823:542: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0023; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:6823
msgctxt "text_id=542 | speaker=soujuurou"
msgid "  Is it your line of business? Or does it run in your family?\""
msgstr "　怒るのが商売とか、そういう家柄の人なのか？」"

#. Occurrence 1_2:6851:543: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0054; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:6851
msgctxt "text_id=543 | speaker=aoko"
msgid "\"...\""
msgstr "「―――――――――」"

#. Occurrence 1_2:6886:544: scene=1_2
#: 1_2:6886
msgctxt "text_id=544 | speaker=unknown"
msgid "  A long silence."
msgstr "　長い沈黙。"

#. Occurrence 1_2:6891:545: scene=1_2
#: 1_2:6891
msgctxt "text_id=545 | speaker=unknown"
msgid "  Though she knew it wouldn't change the situation, she remembered her regret at answering the phone that morning."
msgstr "　今となっては後の祭りだが、青子はしばし、今朝の電話を取った事を痛烈に後悔した。"

#. Occurrence 1_2:6896:546: scene=1_2
#: 1_2:6896
msgctxt "text_id=546 | speaker=unknown"
msgid "  He meant no harm."
msgstr "　相手に悪気はない。"

#. Occurrence 1_2:6901:547: scene=1_2
#: 1_2:6901
msgctxt "text_id=547 | speaker=unknown"
msgid "  She repeated this thought like a mantra in an attempt to keep her impulses in check."
msgstr "　これは天然、ただの天然、と心の中で繰り返し、青子は直情を抑えこんだ。"

#. Occurrence 1_2:6954:548: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0055; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:6954
msgctxt "text_id=548 | speaker=aoko"
msgid "\"It's not you, if that's what you're worried about."
msgstr "「別にあなたのせいじゃないから、気にする必要はないわ。"

#. Occurrence 1_2:6960:549: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0056; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:6960
msgctxt "text_id=549 | speaker=aoko"
msgid "  I'm just trying not to think how much better my day would've gone if I'd slept in until noon.\""
msgstr "　ただ、この一瞬とお昼まで眠っていた場合を<秤|はかり>にかけたらあまりに利益の違いがあって、頭を抱えただけよ」"

#. Occurrence 1_2:6966:550: scene=1_2
#: 1_2:6966
msgctxt "text_id=550 | speaker=unknown"
msgid "  With that vague answer, she started to walk again."
msgstr "　回りくどい返事をして、今度こそ青子は歩きだした。"

#. Occurrence 1_2:6971:551: scene=1_2
#: 1_2:6971
msgctxt "text_id=551 | speaker=unknown"
msgid "  And turned her gaze away from this rude stranger named Soujyuro Sizuki."
msgstr "　静希草十郎という失礼なストレンジャーを、完全に視界から切り離して。"

#. Occurrence 1_3:41:552: scene=1_3
#: 1_3:41
msgctxt "text_id=552 | speaker=unknown"
msgid "  While what constitutes 'normal' is certainly up for debate, most would undoubtedly refer to him as so. He was a simple and nice boy with nondescript features. If he were an ice cream flavor, he would be vanilla."
msgstr "　何を基準にして普通というのか疑問だけれど、性格はいたって<普通|ノーマル>。素朴でいい人。イメージカラーはあえて白。性別は男子。容姿はぼんやりしている。"

#. Occurrence 1_3:70:553: scene=1_3
#: 1_3:70
msgctxt "text_id=553 | speaker=unknown"
msgid "  And Soujyuro found Aoko to be very businesslike and full of life."
msgstr "　そんな草十郎から見ると、蒼崎青子という人物はシャキシャキとよく動いて元気が良かった。"

#. Occurrence 1_3:75:554: scene=1_3
#: 1_3:75
msgctxt "text_id=554 | speaker=unknown"
msgid "  There was a certain purpose to her movements, as they began and ended in an orderly fashion."
msgstr "　何げない動作にも無駄がなく、ピッと動いて、ピタリときれいに止まる。"

#. Occurrence 1_3:95:555: scene=1_3
#: 1_3:95
msgctxt "text_id=555 | speaker=unknown"
msgid "  The way her finger raised when she pointed at things..."
msgstr "　物を指す時に上げる指とか、"

#. Occurrence 1_3:104:556: scene=1_3
#: 1_3:104
msgctxt "text_id=556 | speaker=unknown"
msgid "  The way she made her way across the hallways and classrooms..."
msgstr "　廊下や教室を横断する時の動作とか、"

#. Occurrence 1_3:113:557: scene=1_3
#: 1_3:113
msgctxt "text_id=557 | speaker=unknown"
msgid "  The way she would occasionally glance back at him to make sure he was keeping pace..."
msgstr "　時折、先行しすぎないように後ろを振り向いて同行人を確認するところとか、"

#. Occurrence 1_3:118:558: scene=1_3
#: 1_3:118
msgctxt "text_id=558 | speaker=unknown"
msgid "  Each and every movement was so impressive that he couldn't take his eyes off her."
msgstr "　その一挙一動が実に印象的で、目を引かずにはいられない。"

#. Occurrence 1_3:173:559: scene=1_3
#: 1_3:173
msgctxt "text_id=559 | speaker=unknown"
msgid "  Aoko showed him to his homeroom-Class C of the 11th grade."
msgstr "　青子はまず二年Ｃ組の教室を案内した。"

#. Occurrence 1_3:180:560: scene=1_3
#: 1_3:180
msgctxt "text_id=560 | speaker=unknown"
msgid "  The room certainly displayed more of a human touch than the previous meeting room, but Soujyuro was none the wiser as to its function."
msgstr "　先ほどの会議室よりは人の匂いは感じられたが、やはり草十郎には何をする場所なのか見当がつかなかった。"

#. Occurrence 1_3:185:561: scene=1_3
#: 1_3:185
msgctxt "text_id=561 | speaker=unknown"
msgid "  Aoko gave a brief explanation before they visited individual subject classrooms, as well as the gym, cafeteria, locker room, and school infirmary."
msgstr "　青子から短い説明を受けた後、何種類かある特別教室、体育館、食堂、更衣室、保健室と回っていく。"

#. Occurrence 1_3:190:562: scene=1_3
#: 1_3:190
msgctxt "text_id=562 | speaker=unknown"
msgid "  Soujyuro asked so many questions that much time passed before they reached the AV room on the second floor."
msgstr "　草十郎が行く先々で説明を求めたせいか、二階の視聴覚室を出た頃にはずいぶんと時間が経っていた。"

#. Occurrence 1_3:225:563: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0000; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:225
msgctxt "text_id=563 | speaker=soujuurou"
msgid "\"...Oh dear.\""
msgstr "「……まずいな」"

#. Occurrence 1_3:260:564: scene=1_3
#: 1_3:260
msgctxt "text_id=564 | speaker=unknown"
msgid "  Soujyuro stopped, looking genuinely concerned."
msgstr "　深刻な顔で、草十郎は足を止めた。"

#. Occurrence 1_3:267:565: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0001; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:267
msgctxt "text_id=565 | speaker=soujuurou"
msgid "\"It's twenty to one already.\""
msgstr "「あと二十分経つと<一時|いちじ>だ」"

#. Occurrence 1_3:300:566: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0000; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:300
msgctxt "text_id=566 | speaker=aoko"
msgid "\"Huh? You're kidding, right? This school isn't that big. We'll be done soon.\""
msgstr "「へ？　嘘でしょ、うちの校舎そんな広くないわよ？」"

#. Occurrence 1_3:306:567: scene=1_3
#: 1_3:306
msgctxt "text_id=567 | speaker=unknown"
msgid "  The tour had begun around ten, which meant that three hours had passed."
msgstr "　たしか案内を始めたのが午前十時前だから、一時という事はかれこれ三時間は経つ事になる。"

#. Occurrence 1_3:318:568: scene=1_3
#: 1_3:318
msgctxt "text_id=568 | speaker=unknown"
msgid "  A tour of a school shouldn't take anywhere near this long."
msgstr "　たかだか校内案内でそんな筈はないのだが……"

#. Occurrence 1_3:377:569: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0001; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:377
msgctxt "text_id=569 | speaker=aoko"
msgid "\"Maybe if you didn't ask so many questions, we'd be done by now. It's a miracle it's still light out.\""
msgstr "「……そうだったわね。行く先々で根ほり葉ほり訊かれちゃ、そりゃあ何時間でも経つわ。日が暮れていないのが不思議なくらいね」"

#. Occurrence 1_3:391:570: scene=1_3
#: 1_3:391
msgctxt "text_id=570 | speaker=unknown"
msgid "  Aoko glared at Soujyuro."
msgstr "　青子はじろりと草十郎を見すえる。"

#. Occurrence 1_3:396:571: scene=1_3
#: 1_3:396
msgctxt "text_id=571 | speaker=unknown"
msgid "  She was being sarcastic, of course, knowing full well he would never pick up on it."
msgstr "　こんな嫌味が通じる相手じゃない、と分かった上での小言である。"

#. Occurrence 1_3:436:572: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0002; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:436
msgctxt "text_id=572 | speaker=aoko"
msgid "(...Is he...?)"
msgstr "『………え？』"

#. Occurrence 1_3:442:573: scene=1_3
#: 1_3:442
msgctxt "text_id=573 | speaker=unknown"
msgid "  To her surprise..."
msgstr "　が。"

#. Occurrence 1_3:448:574: scene=1_3
#: 1_3:448
msgctxt "text_id=574 | speaker=unknown"
msgid "He looked down apologetically, unable to hide his dejection."
msgstr "どんな心境の変化か、草十郎は申し訳なさそうに目を伏せていた。"

#. Occurrence 1_3:488:575: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0003; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:488
msgctxt "text_id=575 | speaker=aoko"
msgid "(Oops. I think I broke him.)"
msgstr "『なんだ、コイツ―――ちゃんとしてる、じゃん』"

#. Occurrence 1_3:494:576: scene=1_3
#: 1_3:494
msgctxt "text_id=576 | speaker=unknown"
msgid "  The guy before her now was nothing like earlier."
msgstr "　困っている草十郎は別人のようだ。"

#. Occurrence 1_3:499:577: scene=1_3
#: 1_3:499
msgctxt "text_id=577 | speaker=unknown"
msgid "  In contrast to seeing his once-impenetrable veneer when they first met, she found herself feeling sympathetic."
msgstr "　これまでの、青子が何を言っても反応せずの無表情と違って、言い難い親近感が湧く。"

#. Occurrence 1_3:521:578: scene=1_3
#: 1_3:521
msgctxt "text_id=578 | speaker=unknown"
msgid "  Momentarily, at least, until her irritation returned in full force."
msgstr "　そして、なぜだかやっぱり、青子は理由もなくイライラしてしまうのだった。"

#. Occurrence 1_3:573:579: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0004; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:573
msgctxt "text_id=579 | speaker=aoko"
msgid "\"What's the hurry?"
msgstr "「で、なにがまずいの？"

msgctxt "text_id=580 | speaker=unknown"
msgid "  Don't tell me your brain's not big enough to remember all this stuff.\""
msgstr "　覚える事が多すぎてパンクした、なんて言わないでね」"

#. Occurrence 1_3:586:581: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0002; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:586
msgctxt "text_id=581 | speaker=soujuurou"
msgid "\"Well, there's that, but it's more about it almost being one o'clock.\""
msgstr "「いや、それもあるけど。学校の事は別にして、一時になるとまずいんだ」"

#. Occurrence 1_3:598:582: scene=1_3
#: 1_3:598
msgctxt "text_id=582 | speaker=unknown"
msgid "  Soujyuro's gaze wandered as if worried about something."
msgstr "　つい、と心配そうに視線を逸らす草十郎。"

#. Occurrence 1_3:603:583: scene=1_3
#: 1_3:603
msgctxt "text_id=583 | speaker=unknown"
msgid "  If he was worried about the weather, he would have a hard time seeing it as there were no windows in this hallway."
msgstr "　外の様子が気になるのだろうが、あいにく、この廊下に窓はない。"

#. Occurrence 1_3:643:584: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0005; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:643
msgctxt "text_id=584 | speaker=aoko"
msgid "\"Don't tell me―you've got somewhere better to be."
msgstr "「……へえ。時間を気にするってコトは、用事があるのね。"

#. Occurrence 1_3:649:585: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0006; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:649
msgctxt "text_id=585 | speaker=aoko"
msgid "  Thaaat's perfect. I take time out of my day for you, and you don't have the decency to even hang around."
msgstr "　ふーん、そう。人の予定を引っ掻き回しておいて、自分だけ好きなようにやろうっていうんだ。"

#. Occurrence 1_3:674:586: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0007; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:674
msgctxt "text_id=586 | speaker=aoko"
msgid "  You're a real piece of work, you know that?\""
msgstr "　なんだ。顔に似合わずいい人ね、君」"

#. Occurrence 1_3:735:587: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0003; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:735
msgctxt "text_id=587 | speaker=soujuurou"
msgid "\"Umm, thanks, I guess? That's nice of you to say.\""
msgstr "「？　いや、誉めても何もでないぞ」"

#. Occurrence 1_3:754:588: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0008; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:754
msgctxt "text_id=588 | speaker=aoko"
msgid "\"Not a compliment!\""
msgstr "「誰も誉めちゃいないわよ！」"

#. Occurrence 1_3:760:589: scene=1_3
#: 1_3:760
msgctxt "text_id=589 | speaker=unknown"
msgid "  She yelled at him, unable to hold back her fury."
msgstr "　つい怒鳴ってしまった青子だった。"

#. Occurrence 1_3:796:590: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0009; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:796
msgctxt "text_id=590 | speaker=aoko"
msgid "\"Well?\""
msgstr "「で？」"

#. Occurrence 1_3:817:591: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0004; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:817
msgctxt "text_id=591 | speaker=soujuurou"
msgid "\"Well what?\""
msgstr "「で？」"

#. Occurrence 1_3:834:592: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0010; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:834
msgctxt "text_id=592 | speaker=aoko"
msgid "\"What's happening in twenty minutes?\""
msgstr "「それで。いったい、何の用なの」"

#. Occurrence 1_3:839:593: scene=1_3
#: 1_3:839
msgctxt "text_id=593 | speaker=unknown"
msgid "  Soujyuro's face lit up, as he finally understood what she was asking him."
msgstr "　青子の言わんとする事が分かって、草十郎はああ、と落ち着いた顔で頷き、"

#. Occurrence 1_3:845:594: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0005; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:845
msgctxt "text_id=594 | speaker=soujuurou"
msgid "\"It's a secret.\""
msgstr "「そこは秘密にしておきたい」"

#. Occurrence 1_3:872:595: scene=1_3
#: 1_3:872
msgctxt "text_id=595 | speaker=unknown"
msgid "  He said with a perfectly straight face."
msgstr "　深刻に、ふざけた返答を口にした。"

#. Occurrence 1_3:929:596: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0011; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:929
msgctxt "text_id=596 | speaker=aoko"
msgid "(Ugh. Every time I think I've got this guy figured out, he finds a way to trip me up.)"
msgstr "『……馴れ始めたつもりだったけど、コイツのこういったテンポには失神しそうになるわ……』"

#. Occurrence 1_3:935:597: scene=1_3
#: 1_3:935
msgctxt "text_id=597 | speaker=unknown"
msgid "  Her frustration was natural."
msgstr "　もちろん怒りで。"

#. Occurrence 1_3:941:598: scene=1_3
#: 1_3:941
msgctxt "text_id=598 | speaker=unknown"
msgid "Still, she did everything she could to stifle her feelings and fake a smile."
msgstr "そんな気持ちをぐっと飲みこんで、青子は極上の笑顔を作る。"

#. Occurrence 1_3:1000:599: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0012; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1000
msgctxt "text_id=599 | speaker=aoko"
msgid "\"You want to repeat that, Sizuki?\""
msgstr "「静希くん？」"

#. Occurrence 1_3:1005:600: scene=1_3
#: 1_3:1005
msgctxt "text_id=600 | speaker=unknown"
msgid "  She took a step forward."
msgstr "　ずいっと一歩前に出る青子。"

#. Occurrence 1_3:1035:601: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0006; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:1035
msgctxt "text_id=601 | speaker=soujuurou"
msgid "\"Like I said, it's a secret.\""
msgstr "「秘密だってば」"

#. Occurrence 1_3:1040:602: scene=1_3
#: 1_3:1040
msgctxt "text_id=602 | speaker=unknown"
msgid "  Feeling the mood change drastically, Soujyuro took a step back."
msgstr "　なんだか殺気めいたものを感じて、ずいっと一歩後ずさる草十郎。"

#. Occurrence 1_3:1070:603: scene=1_3
#: 1_3:1070
msgctxt "text_id=603 | speaker=unknown"
msgid "  And another... And another..."
msgstr "　ずいっ、ずいっ。"

#. Occurrence 1_3:1075:604: scene=1_3
#: 1_3:1075
msgctxt "text_id=604 | speaker=unknown"
msgid "  No matter how many steps he took back, she kept edging toward him."
msgstr "　磁石のように、どんなにさがっても青子は近寄ってくる。"

#. Occurrence 1_3:1080:605: scene=1_3
#: 1_3:1080
msgctxt "text_id=605 | speaker=unknown"
msgid "  She was smiling, but he thought he could see the blood boiling beneath her skin."
msgstr "　笑顔のまま、こめかみをちょっと震わせて。"

#. Occurrence 1_3:1123:606: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0013; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1123
msgctxt "text_id=606 | speaker=aoko"
msgid "\"Last question:"
msgstr "「これ、最後の質問にしとくわね。"

#. Occurrence 1_3:1129:607: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0014; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1129
msgctxt "text_id=607 | speaker=aoko"
msgid "  Do you enjoy mocking me?\""
msgstr "　―――貴方、私をからかって楽しい？」"

#. Occurrence 1_3:1135:608: scene=1_3
#: 1_3:1135
msgctxt "text_id=608 | speaker=unknown"
msgid "  He had no intention of mocking her, though at this point he doubted presenting any evidence to prove this would do much to erase that forced smile on her face."
msgstr "　神に誓ってそんな気はないのだが、身の潔白を証明したところで青子の無理やりな笑顔は消えないだろう。"

#. Occurrence 1_3:1141:609: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0007; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:1141
msgctxt "text_id=609 | speaker=soujuurou"
msgid "\"...Let me explain.\""
msgstr "「……分かった、説明する」"

#. Occurrence 1_3:1153:610: scene=1_3
#: 1_3:1153
msgctxt "text_id=610 | speaker=unknown"
msgid "  His arms raised in surrender."
msgstr "　降参して手を上げる。"

#. Occurrence 1_3:1158:611: scene=1_3
#: 1_3:1158
msgctxt "text_id=611 | speaker=unknown"
msgid "  She halted her advance and freed her face from that unseemly smile."
msgstr "　青子も前進を止め、不似合いな笑みを消した。"

#. Occurrence 1_3:1211:612: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0008; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:1211
msgctxt "text_id=612 | speaker=soujuurou"
msgid "\"The truth is that my part-time job shift starts at one."
msgstr "「実は一時からアルバイトがあるんだ。"

msgctxt "text_id=613 | speaker=unknown"
msgid "  But, students aren't allowed to have jobs, right?\""
msgstr "　でも、ここはそういうの禁止なんだろ？」"

#. Occurrence 1_3:1219:614: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0015; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1219
msgctxt "text_id=614 | speaker=aoko"
msgid "\"Yeah... Wait, were you being tight-lipped because you thought you'd get in trouble? All you have to do is get permission, dweeb!\""
msgstr "「そうだけど……あ、禁止されてるから秘密にしようと思ったの？　バカね、それなら許可さえ下りていれば問題ないわよ？」"

#. Occurrence 1_3:1240:615: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0009; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:1240
msgctxt "text_id=615 | speaker=soujuurou"
msgid "\"I know, and I did. I got permission when they accepted me to the school.\""
msgstr "「知ってる。試験の時に許可はもらってる」"

#. Occurrence 1_3:1253:616: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0016; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1253
msgctxt "text_id=616 | speaker=aoko"
msgid "\"Really.\""
msgstr "「へえ」"

#. Occurrence 1_3:1258:617: scene=1_3
#: 1_3:1258
msgctxt "text_id=617 | speaker=unknown"
msgid "  Aoko's face lit up as she realized he might not be the piece of work she thought him to be."
msgstr "　顔に似合わず手回しいいじゃない、と青子は顔を輝かせた。"

#. Occurrence 1_3:1263:618: scene=1_3
#: 1_3:1263
msgctxt "text_id=618 | speaker=unknown"
msgid "  Yet..."
msgstr "　が。"

#. Occurrence 1_3:1291:619: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0010; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:1291
msgctxt "text_id=619 | speaker=soujuurou"
msgid "\"But I only got permission for one of my jobs.\""
msgstr "「しかし、許可はひとつしかもらえなかった」"

#. Occurrence 1_3:1304:620: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0017; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1304
msgctxt "text_id=620 | speaker=aoko"
msgid "\"Wait, you have more than one job?\""
msgstr "「？　ひとつって、貴方、掛け持ちでバイトしてるの？」"

#. Occurrence 1_3:1317:621: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0011; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:1317
msgctxt "text_id=621 | speaker=soujuurou"
msgid "\"Well, I quit two of them..."
msgstr "「……これでも二件減らしたんだ。"

#. Occurrence 1_3:1323:622: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0012; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:1323
msgctxt "text_id=622 | speaker=soujuurou"
msgid "  Living expenses are bad enough, but now I have to earn money for school as well. Don't you think it's unreasonable of them to only let me work one job?\""
msgstr "　生活費だけで大変なのに、学費まで稼がなくちゃいけない。なのに、働き先はひとつだけと言うのはあんまりだと思わないか？」"

#. Occurrence 1_3:1351:623: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0018; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1351
msgctxt "text_id=623 | speaker=aoko"
msgid "\"...No, I think you're the one who's being unreasonable.\""
msgstr "「……いや。あんまりなのは貴方の方だと思うけど」"

#. Occurrence 1_3:1371:624: scene=1_3
#: 1_3:1371
msgctxt "text_id=624 | speaker=unknown"
msgid "  Though still irritated, her opinion of him changed a little."
msgstr "　青子は呆れながらも、草十郎を少しだけ見直した。"

#. Occurrence 1_3:1382:625: scene=1_3
#: 1_3:1382
msgctxt "text_id=625 | speaker=unknown"
msgid "  She was impressed that he was able to take care of his tuition and living expenses all on his own."
msgstr "　学費はおろか生活費まで自分でどうにかしているのは立派だと思う。"

#. Occurrence 1_3:1387:626: scene=1_3
#: 1_3:1387
msgctxt "text_id=626 | speaker=unknown"
msgid "  She could also empathize with having no time to oneself. Her anger began to subside."
msgstr "　そういう遊びのない事情に、蒼崎青子はわりと弱かった。さっきまでの怒りも薄れてしまう程度には。"

#. Occurrence 1_3:1392:627: scene=1_3
#: 1_3:1392
msgctxt "text_id=627 | speaker=unknown"
msgid "  The words 'part-time job' were about the last things she ever expected to hear out of this country boy's mouth."
msgstr "　……調子を崩したのは、この世間知らずの少年から『アルバイト』なんて単語が出るとは思いもしなかっただけだ。"

#. Occurrence 1_3:1419:628: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0019; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1419
msgctxt "text_id=628 | speaker=aoko"
msgid "\"Well, you gotta do what you gotta do, I guess."
msgstr "「……そういうことなら仕方ないわね。"

#. Occurrence 1_3:1425:629: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0020; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1425
msgctxt "text_id=629 | speaker=aoko"
msgid "  It's fine. You can go. I get it.\""
msgstr "　いいわ、行きなさいよ。事情は分かったから」"

#. Occurrence 1_3:1431:630: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0013; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:1431
msgctxt "text_id=630 | speaker=soujuurou"
msgid "\"Will you be okay?\""
msgstr "「蒼崎はいいのか？」"

#. Occurrence 1_3:1462:631: scene=1_3
#: 1_3:1462
msgctxt "text_id=631 | speaker=unknown"
msgid "  She had no idea what his question meant, but she at least understood he was trying to be considerate."
msgstr "　何がいいのだか青子にはさっぱりだが、草十郎が気を遣っている事だけは分かる。"

#. Occurrence 1_3:1467:632: scene=1_3
#: 1_3:1467
msgctxt "text_id=632 | speaker=unknown"
msgid "  Which also took her by surprise."
msgstr "　……それも、青子にはなんとなく意外だった。"

#. Occurrence 1_3:1472:633: scene=1_3
#: 1_3:1472
msgctxt "text_id=633 | speaker=unknown"
msgid "  She figured he'd be just as dense about people's feelings as he was about everything else."
msgstr "　もう少しこう、人の心にも鈍感な少年だと思ったのだ。"

#. Occurrence 1_3:1500:634: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0021; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1500
msgctxt "text_id=634 | speaker=aoko"
msgid "\"I'll be fine. I'll just head home.\""
msgstr "「別に。私もこのまま帰るから」"

#. Occurrence 1_3:1538:635: scene=1_3
#: 1_3:1538
msgctxt "text_id=635 | speaker=unknown"
msgid "  First, though, she thought it best that they both stop by the faculty room."
msgstr "　ちなみに、職員室に寄っていく選択は<潔|いさぎよ>いぐらい無い。"

#. Occurrence 1_3:1543:636: scene=1_3
#: 1_3:1543
msgctxt "text_id=636 | speaker=unknown"
msgid "  Mr. Yamasiro had mentioned that the transfer procedures had already been completed, so all that remained was for him to sign off on her duties."
msgstr "　山城曰く、転入手続きやらは終わっているというし、後は<社交辞令|おやくそく>の挨拶だけだろう。"

#. Occurrence 1_3:1601:637: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0022; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1601
msgctxt "text_id=637 | speaker=aoko"
msgid "\"I've finished showing him around.\""
msgstr "“先生、案内終わりました”"

#. Occurrence 1_3:1607:638: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_3_0000; voice_prefix=B60; voice_category=7; scene=1_3
#: 1_3:1607
msgctxt "text_id=638 | speaker=yamashiro"
msgid "\"Great job. That goes for you, too, Sizuki. What did you think of our school?\""
msgstr "“それはお疲れさま。静希くんもお疲れさま。それで、校舎をまわった感想はどうかな？”"

#. Occurrence 1_3:1613:639: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0014; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:1613
msgctxt "text_id=639 | speaker=soujuurou"
msgid "\"Thank you for the tour. It's like a real school!\""
msgstr "“ありがとうございます。なんというか、とても学校ですね！”"

#. Occurrence 1_3:1619:640: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_3_0001; voice_prefix=B60; voice_category=7; scene=1_3
#: 1_3:1619
msgctxt "text_id=640 | speaker=yamashiro"
msgid "\"Hahaha. That's great to hear. Okay, then. Best of luck starting tomorrow!\""
msgstr "“ははは、そうかそうか。うん、明日から頑張りなさい！”"

#. Occurrence 1_3:1627:641: scene=1_3
#: 1_3:1627
msgctxt "text_id=641 | speaker=unknown"
msgid "  She had no interest whatsoever in this pointless wrap-up meeting."
msgstr "　そんなどうでもいい締めのイベントなぞ、彼女には何ら関係のない話である。"

#. Occurrence 1_3:1683:642: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0023; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1683
msgctxt "text_id=642 | speaker=aoko"
msgid "\"You'll have to forgive Mr. Yamasiro."
msgstr "「山城先生の事は気にしないでいいわ。"

#. Occurrence 1_3:1689:643: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0024; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1689
msgctxt "text_id=643 | speaker=aoko"
msgid "  He likes the faculty room so much he chooses to kick back there while getting his students to do his dirty work for him. I bet he spends hours in there."
msgstr "　教え子に厄介な事を押しつけてふんぞり返っているぐらい職員室が好きなんだから、何時間でも待ってるでしょ。"

#. Occurrence 1_3:1695:644: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0025; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1695
msgctxt "text_id=644 | speaker=aoko"
msgid "  Actually, that's pretty smart of him.\""
msgstr "　いえ、待ってるべきじゃない？」"

#. Occurrence 1_3:1722:645: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0015; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:1722
msgctxt "text_id=645 | speaker=soujuurou"
msgid "\"Okay, Aozaki. If you're fine with it, then so am I.\""
msgstr "「そうか。蒼崎がいいんなら、いいんだな」"

#. Occurrence 1_3:1734:646: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0026; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1734
msgctxt "text_id=646 | speaker=aoko"
msgid "\"Huh?\""
msgstr "「？」"

#. Occurrence 1_3:1739:647: scene=1_3
#: 1_3:1739
msgctxt "text_id=647 | speaker=unknown"
msgid "  There it was again."
msgstr "　だから、何がいいんだろうか？"

#. Occurrence 1_3:1744:648: scene=1_3
#: 1_3:1744
msgctxt "text_id=648 | speaker=unknown"
msgid "  Whatever Soujyuro was getting at, Aoko had no idea."
msgstr "　草十郎の言わんとするところが、青子にはやっぱりさっぱり。"

#. Occurrence 1_3:1786:649: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0016; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:1786
msgctxt "text_id=649 | speaker=soujuurou"
msgid "\"I'm going to get going. Thanks again for today.\""
msgstr "「それじゃ行くよ。今日はありがとう」"

#. Occurrence 1_3:1792:650: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0027; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1792
msgctxt "text_id=650 | speaker=aoko"
msgid "\"Yes, today. Today only.\""
msgstr "「今日だけよ、今日だけ」"

#. Occurrence 1_3:1798:651: scene=1_3
#: 1_3:1798
msgctxt "text_id=651 | speaker=unknown"
msgid "  She shooed him away with her hand."
msgstr "　ほら、さっさと行った、とばかりに青子は片手をひらひらと払う。"

#. Occurrence 1_3:1810:652: scene=1_3
#: 1_3:1810
msgctxt "text_id=652 | speaker=unknown"
msgid "  His face bent into a broad smile, as if he found the gesture endearing."
msgstr "　その仕草が気に入ったのか、草十郎は嬉しげに笑った。"

#. Occurrence 1_3:1853:653: scene=1_3
#: 1_3:1853
msgctxt "text_id=653 | speaker=unknown"
msgid "  It was a softer expression than she had grown accustomed to seeing out of him."
msgstr "　常時ぼんやりしているせいか、彼のそういった顔はきわだって柔らかく見える。"

#. Occurrence 1_3:1858:654: scene=1_3
#: 1_3:1858
msgctxt "text_id=654 | speaker=unknown"
msgid "  It was the kind of smile that would make anyone smile back."
msgstr "　つい笑みを返してしまうぐらいの<和|なご>み度だ。"

#. Occurrence 1_3:1864:655: scene=1_3
#: 1_3:1864
msgctxt "text_id=655 | speaker=unknown"
msgid "  Well, most people at least..."
msgstr "　けれどやっぱり、"

msgctxt "text_id=656 | speaker=unknown"
msgid "  Aoko Aozaki didn't betray the slightest hint of a smile."
msgstr "　そういったものに反応しないのが蒼崎青子だった。"

#. Occurrence 1_3:1920:657: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0017; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:1920
msgctxt "text_id=657 | speaker=soujuurou"
msgid "\"See you later.\""
msgstr "「それじゃ、また」"

#. Occurrence 1_3:1946:658: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0028; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1946
msgctxt "text_id=658 | speaker=aoko"
msgid "\"Huh?\""
msgstr "「は？」"

#. Occurrence 1_3:1952:659: scene=1_3
#: 1_3:1952
msgctxt "text_id=659 | speaker=unknown"
msgid "  And with that friendly farewell, Soujyuro walked toward the end of the hallway."
msgstr "　旧知の友人みたいな言葉を残して、草十郎は廊下の先……"

#. Occurrence 1_3:1957:660: scene=1_3
#: 1_3:1957
msgctxt "text_id=660 | speaker=unknown"
msgid "  Or so she thought before he turned into the next class over."
msgstr "　ではなく、隣の教室に入っていった。"

#. Occurrence 1_3:2006:661: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0029; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2006
msgctxt "text_id=661 | speaker=aoko"
msgid "\"Did he just...?\""
msgstr "「ちょ―――」"

#. Occurrence 1_3:2011:662: scene=1_3
#: 1_3:2011
msgctxt "text_id=662 | speaker=unknown"
msgid "  Soujyuro headed straight for one of the classroom's windows."
msgstr "　その背中が、まっすぐに窓に向かっていく。"

#. Occurrence 1_3:2102:663: scene=1_3
#: 1_3:2102
msgctxt "text_id=663 | speaker=unknown"
msgid "  Whereupon he opened it with ease."
msgstr "　彼はおもむろに教室の窓を開けた。"

#. Occurrence 1_3:2107:664: scene=1_3
#: 1_3:2107
msgctxt "text_id=664 | speaker=unknown"
msgid "  The chilly November air filled the room as the soft sounds of the rain doubled in volume."
msgstr "　十一月の肌寒い風と、おぼろだった雨の音が鮮明になる。"

#. Occurrence 1_3:2112:665: scene=1_3
#: 1_3:2112
msgctxt "text_id=665 | speaker=unknown"
msgid "  In that instant, she realized his intention with opening the window--she really wished she hadn't."
msgstr "　それが何を意味するのかを、蒼崎青子は瞬時に悟った。悟れてしまった。"

#. Occurrence 1_3:2183:666: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0030; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2183
msgctxt "text_id=666 | speaker=aoko"
msgid "\"Nooo! Stop stop stop STOP!\""
msgstr "「いや、待て待て待てーーーーっっっ！」"

#. Occurrence 1_3:2189:667: scene=1_3
#: 1_3:2189
msgctxt "text_id=667 | speaker=unknown"
msgid "  He already had one leg out the window when she dashed to stop him."
msgstr "　今まさに、窓枠に片足を乗っける草十郎を、青子は必死の形相で止めた。"

#. Occurrence 1_3:2282:668: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0031; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2282
msgctxt "text_id=668 | speaker=aoko"
msgid "\"What do you think you're doing!?\""
msgstr "「なにするつもりよ、あんたはっ！」"

#. Occurrence 1_3:2288:669: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0018; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:2288
msgctxt "text_id=669 | speaker=soujuurou"
msgid "\"What am I doing? I'm leaving for my job, that's what.\""
msgstr "「なにって、アルバイトに行くんだけど」"

#. Occurrence 1_3:2303:670: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0032; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2303
msgctxt "text_id=670 | speaker=aoko"
msgid "\"You do know that this window isn't an exit, don't you!?"
msgstr "「その窓は人が出入りするところじゃないの！"

#. Occurrence 1_3:2309:671: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0033; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2309
msgctxt "text_id=671 | speaker=aoko"
msgid "  I mean, do you even know what floor you're on!?\""
msgstr "　だいたい、ここ何階だと思ってるの!?」"

#. Occurrence 1_3:2324:672: scene=1_3
#: 1_3:2324
msgctxt "text_id=672 | speaker=unknown"
msgid "  She saw the light of understanding dawn in his eyes."
msgstr "　言われて、あ、と声をあげる草十郎。"

#. Occurrence 1_3:2379:673: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0019; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:2379
msgctxt "text_id=673 | speaker=soujuurou"
msgid "\"...Oh my god, I almost died. Who would put an exit here? This is dangerous.\""
msgstr "「……死ぬところだった。二階から下りたら危なすぎる」"

#. Occurrence 1_3:2385:674: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0034; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2385
msgctxt "text_id=674 | speaker=aoko"
msgid "\"It's the lack of something between your ears that's dangerous.\""
msgstr "「危ないのはあんたの頭……」"

#. Occurrence 1_3:2391:675: scene=1_3
#: 1_3:2391
msgctxt "text_id=675 | speaker=unknown"
msgid "  Her insult went right over his head."
msgstr "　脱力しつつも<暴言|ぼうげん>をこぼすが、幸い、草十郎には聞こえていなかった。"

#. Occurrence 1_3:2460:676: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0035; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2460
msgctxt "text_id=676 | speaker=aoko"
msgid "\"People here don't normally enter and exit through windows, okay?"
msgstr "「あのね、こっちじゃ窓から人は出入りしないの。"

#. Occurrence 1_3:2460:677: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0035; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2460
msgctxt "text_id=677 | speaker=aoko"
msgid "  You should probably remember this information for future reference.\""
msgstr "　さっき言っとくべきだったわ」"

#. Occurrence 1_3:2472:678: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0020; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:2472
msgctxt "text_id=678 | speaker=soujuurou"
msgid "\"Oh, I know. I just wanted to save some time."
msgstr "「知ってるよ、時間がないんであわててたんだ。"

#. Occurrence 1_3:2478:679: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0021; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:2478
msgctxt "text_id=679 | speaker=soujuurou"
msgid "  But thanks. I'll be more careful from now on.\""
msgstr "　ありがとう、これからは気をつける」"

#. Occurrence 1_3:2559:680: scene=1_3
#: 1_3:2559
msgctxt "text_id=680 | speaker=unknown"
msgid "  He pulled his leg back inside and closed the window."
msgstr "　よいしょ、と窓枠から片足を下ろして窓を閉める草十郎。"

#. Occurrence 1_3:2564:681: scene=1_3
#: 1_3:2564
msgctxt "text_id=681 | speaker=unknown"
msgid "  His school uniform was soaking wet from the rain."
msgstr "　見るからに下ろしたての制服は、今ので雨に濡れてしまっていた。"

#. Occurrence 1_3:2592:682: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0036; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2592
msgctxt "text_id=682 | speaker=aoko"
msgid "\"Hey, be my guest."
msgstr "「……いいけど、私は別に。"

#. Occurrence 1_3:2598:683: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0037; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2598
msgctxt "text_id=683 | speaker=aoko"
msgid "  Go outside any way you like. Just don't do it in front of me from now on."
msgstr "　あなたが何処から外に出ようが関係ないもの。ただ、できれば私の前ではやらないでほしいだけよ。"

#. Occurrence 1_3:2614:684: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0038; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2614
msgctxt "text_id=684 | speaker=aoko"
msgid "  Anyway... You start school tomorrow, right?\""
msgstr "　それより……貴方、本当に明日から学校に来るの？」"

#. Occurrence 1_3:2626:685: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0022; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:2626
msgctxt "text_id=685 | speaker=soujuurou"
msgid "\"Yeah. I'm a little nervous, though, which is why I came in early for the tour.\""
msgstr "「来るよ。不安だけど、案内してもらったし」"

#. Occurrence 1_3:2685:686: scene=1_3
#: 1_3:2685
msgctxt "text_id=686 | speaker=unknown"
msgid "  He bid her farewell before running away down the hallway."
msgstr "　それじゃあ、と返して、少年は廊下を走っていった。"

#. Occurrence 1_3:2690:687: scene=1_3
#: 1_3:2690
msgctxt "text_id=687 | speaker=unknown"
msgid "  She hoped he would walk down the stairs and leave through the school entrance, like a normal person."
msgstr "　今度こそ普通に、階段を下りて昇降口から出ていくのだろう。"

#. Occurrence 1_3:2717:688: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0039; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2717
msgctxt "text_id=688 | speaker=aoko"
msgid "\"Ugh... I wonder if he's really going to be okay here.\""
msgstr "「……はあ。大丈夫なのか、あんなんで」"

#. Occurrence 1_3:2742:689: scene=1_3
#: 1_3:2742
msgctxt "text_id=689 | speaker=unknown"
msgid "  The image of him disappearing into the distance popped into her head, in spite of her ire."
msgstr "　呆れながらも、走り去った彼の背中を回想する。"

#. Occurrence 1_3:2747:690: scene=1_3
#: 1_3:2747
msgctxt "text_id=690 | speaker=unknown"
msgid "  She had no intention of spending any more time with him, and yet, she felt strangely anxious."
msgstr "　もうあんな田舎者とは関わりたくないのに、妙なところで気に掛かる。"

#. Occurrence 1_3:2752:691: scene=1_3
#: 1_3:2752
msgctxt "text_id=691 | speaker=unknown"
msgid "  She couldn't tell if the feeling was fueled by concern or irritation."
msgstr "　心配からか、それとも癪に障るからなのか、いまいち納得のいく答えは出ない。"

#. Occurrence 1_3:2778:692: scene=1_3
#: 1_3:2778
msgctxt "text_id=692 | speaker=unknown"
msgid "  Why had she even gotten angry with this insignificant transfer student in the first place?"
msgstr "　そもそもどうして自分はさしたる理由もなく、あのどうでもいい転入生に怒りを覚えたのか。"

#. Occurrence 1_3:2783:693: scene=1_3
#: 1_3:2783
msgctxt "text_id=693 | speaker=unknown"
msgid "  A strange day with a strange transfer student resulting in strange emotions."
msgstr "　妙な一日、妙な転入生、妙な感情。"

#. Occurrence 1_3:2788:694: scene=1_3
#: 1_3:2788
msgctxt "text_id=694 | speaker=unknown"
msgid "  Her head tilted as she reflected on what should have been a more enjoyable day than the irritating experience she just had."
msgstr "　こうして振り返ってみると、実は怒るべきじゃなく楽しむべきコトだったんじゃないか、と首をかしげる自分もいる。"

#. Occurrence 1_3:2823:695: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0040; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2823
msgctxt "text_id=695 | speaker=aoko"
msgid "\"Whatever."
msgstr "「―――ま、いっか。"

#. Occurrence 1_3:2829:696: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0041; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2829
msgctxt "text_id=696 | speaker=aoko"
msgid "  It's not as if I'll see him again.\""
msgstr "　どうせこれっきりなんだし」"

#. Occurrence 1_3:2937:697: scene=1_3
#: 1_3:2937
msgctxt "text_id=697 | speaker=unknown"
msgid "  The sound of the rain echoed quietly all around her."
msgstr "　静かに響く雨の音。"

#. Occurrence 1_3:2942:698: scene=1_3
#: 1_3:2942
msgctxt "text_id=698 | speaker=unknown"
msgid "  The gray sky seemed frozen in time."
msgstr "　灰色の空は時間の<有様|ありよう>を麻痺させる。"

#. Occurrence 1_3:2947:699: scene=1_3
#: 1_3:2947
msgctxt "text_id=699 | speaker=unknown"
msgid "  It was impossible to discern whether it was morning or evening."
msgstr "　今はまだ午前中なのか、夕方なのかも判らない。"

#. Occurrence 1_3:2952:700: scene=1_3
#: 1_3:2952
msgctxt "text_id=700 | speaker=unknown"
msgid "  Mr. Yamasiro and Aoko were likely the only ones left at school."
msgstr "　校舎にはたぶん自分と、山城ぐらいしかいないだろう。"

#. Occurrence 1_3:2957:701: scene=1_3
#: 1_3:2957
msgctxt "text_id=701 | speaker=unknown"
msgid "  The unlit classroom looked overly gloomy and ominous as Aoko stood in it alone."
msgstr "　電灯の消えた教室は薄暗く、ひとりになるとやけに不気味だった。"

#. Occurrence 1_3:2979:702: scene=1_3
#: 1_3:2979
msgctxt "text_id=702 | speaker=unknown"
msgid "  She pulled up her left sleeve."
msgstr "　つと―――青子は左手の<袖|そで>を上げた。"

#. Occurrence 1_3:2984:703: scene=1_3
#: 1_3:2984
msgctxt "text_id=703 | speaker=unknown"
msgid "  Her dainty, unremarkable watch showed that it was almost one o'clock."
msgstr "　飾り気のない小さな腕時計は、たしかに午後一時になろうとしている。"

#. Occurrence 1_3:2991:704: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0042; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2991
msgctxt "text_id=704 | speaker=aoko"
msgid "\"He was right about the time.\""
msgstr "「……時間、あってる」"

#. Occurrence 1_3:3033:705: scene=1_3
#: 1_3:3033
msgctxt "text_id=705 | speaker=unknown"
msgid "  She looked out the window at the grounds below."
msgstr "　言って、青子は窓ごしに地上を見下ろした。"

#. Occurrence 1_3:3038:706: scene=1_3
#: 1_3:3038
msgctxt "text_id=706 | speaker=unknown"
msgid "  She saw a boy in uniform running through the rain without an umbrella. A sight she must have seen before, but for whatever reason, affected her far more than she wished."
msgstr "　小雨の中、制服姿の男子が傘もささずに走っていく。見慣れている筈の光景が、彼女にはひどく印象深かった。"

#. Occurrence 1_4:80:707: scene=1_4
#: 1_4:80
msgctxt "text_id=707 | speaker=unknown"
msgid "  Aoko did not stop by the faculty room before heading home."
msgstr "　青子は先の公言通り、職員室に寄らず帰路についた。"

#. Occurrence 1_4:85:708: scene=1_4
#: 1_4:85
msgctxt "text_id=708 | speaker=unknown"
msgid "  While Mr. Yamasiro's offer to drive her home was tempting, she decided it would ultimately be far more satisfying to ruin his day just as he had hers."
msgstr "　山城の「帰りは車で送るよ」という提案には心揺さぶられるものがあったが、せめてもの報復として彼の休日にも共倒れしてもらうのはどうか、という案の方が何倍も魅力的だったからだ。"

#. Occurrence 1_4:105:709: scene=1_4
#: 1_4:105
msgctxt "text_id=709 | speaker=unknown"
msgid "  She walked as quietly as she could toward the entrance and opened her bright red umbrella."
msgstr "　足音を立てず昇降口に行き、まっ赤な傘を開く。"

#. Occurrence 1_4:110:710: scene=1_4
#: 1_4:110
msgctxt "text_id=710 | speaker=unknown"
msgid "  As she had predicted that morning, the rain was waning in the afternoon."
msgstr "　朝の予報通り、正午を過ぎて雨は小降りになっていた。"

#. Occurrence 1_4:115:711: scene=1_4
#: 1_4:115
msgctxt "text_id=711 | speaker=unknown"
msgid "  At this rate, it would probably cease completely in an hour or so."
msgstr "　この分なら、あと一時間ほどで止むだろう。"

#. Occurrence 1_4:120:712: scene=1_4
#: 1_4:120
msgctxt "text_id=712 | speaker=unknown"
msgid "  The distant sunshine would likely have reached her by the time she arrived home."
msgstr "　青子が帰宅するのと入れ替わりで、遠くの空に見えた日射しがやってくる事になる。"

#. Occurrence 1_4:178:713: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0000; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:178
msgctxt "text_id=713 | speaker=aoko"
msgid "\"Well, I suppose it could be worse.\""
msgstr "「――――ま、それも悪くないか」"

#. Occurrence 1_4:184:714: scene=1_4
#: 1_4:184
msgctxt "text_id=714 | speaker=unknown"
msgid "  She shrugged her shoulders in resignation."
msgstr "　肩をすくめて観念する。"

#. Occurrence 1_4:189:715: scene=1_4
#: 1_4:189
msgctxt "text_id=715 | speaker=unknown"
msgid "  She neither liked nor disliked rain, but she found herself enjoying her walk home with her red umbrella in hand."
msgstr "　雨は好きでも嫌いでもない青子だが、赤い傘を開いて歩く事には、ちょっとした愉しみがあるからだ。"

#. Occurrence 1_4:245:716: scene=1_4
#: 1_4:245
msgctxt "text_id=716 | speaker=unknown"
msgid "  The teachers at Misaki High School weren't fond of bright colors, so Aoko's red umbrella was an unusual sight."
msgstr "　教師たちがそろって派手目を嫌う<三咲|みさき>高において、青子の赤い傘は珍しい色と言える。"

#. Occurrence 1_4:250:717: scene=1_4
#: 1_4:250
msgctxt "text_id=717 | speaker=unknown"
msgid "  A ghost story about how the umbrella was once pure white had been making the rounds, but it featured Aoko instead of a ghost."
msgstr "　一時期、“蒼崎の傘は昔は白かった”なんて語りだしの怪談が<流|は><行|や>ったが、その話ではお化けのかわりに青子が活躍しているらしい。"

#. Occurrence 1_4:255:718: scene=1_4
#: 1_4:255
msgctxt "text_id=718 | speaker=unknown"
msgid "  It was with that umbrella that she made her way toward Misaki Station."
msgstr "　そんな曰くつきの傘を開いて、青子は<三咲町|みさきちょう>の駅に向かう。"

#. Occurrence 1_4:332:719: scene=1_4
#: 1_4:332
msgctxt "text_id=719 | speaker=unknown"
msgid "  Misaki Private High School took its namesake from the town it was in."
msgstr "　彼女の通う私立三咲高等学校は、その名の通り三咲町にある。"

#. Occurrence 1_4:337:720: scene=1_4
#: 1_4:337
msgctxt "text_id=720 | speaker=unknown"
msgid "  The area was once a sprawl of farmland and woodland, but rapid growth over the last ten years had led to unprecedented modernization."
msgstr "　昔から大部分が畑と森だった三咲町だが、ここ十年、高度成長期の勢いで急激に近代化が進んでいた。"

#. Occurrence 1_4:357:721: scene=1_4
#: 1_4:357
msgctxt "text_id=721 | speaker=unknown"
msgid "  There were some who fought to preserve Misaki's natural treasures."
msgstr "　自然に満ちた三咲町を残すべきではないか、という声もあったが、"

#. Occurrence 1_4:363:722: voice_id=F40_1_4_0000; voice_prefix=F40; voice_category=0; scene=1_4
#: 1_4:363
msgctxt "text_id=722 | speaker=unknown"
msgid "\"I agree in principle to preserving the land, but not at the expense of our prosperity.\""
msgstr "『残す事には賛成ですが、それでは<遺|のこ>すだけになってしまうでしょう』"

#. Occurrence 1_4:368:723: scene=1_4
#: 1_4:368
msgctxt "text_id=723 | speaker=unknown"
msgid "  With those words, the mayor snuffed out the voices of the minority and ushered in a long-term plan for new urban development."
msgstr "　なんて市長の一声で少数派は鎮圧。長期計画で新しい街作りがはじまった。"

#. Occurrence 1_4:431:724: scene=1_4
#: 1_4:431
msgctxt "text_id=724 | speaker=unknown"
msgid "  More than enough funds for the urban development were collected,"
msgstr "　都市開発には十分すぎる金額が集められ、"

#. Occurrence 1_4:436:725: scene=1_4
#: 1_4:436
msgctxt "text_id=725 | speaker=unknown"
msgid "  and the unassuming town of Misaki became the largest municipality of Misaki City in merely ten years."
msgstr "　わりかし普通の町だった三咲町はわずか十年で三咲市を代表する町になったのである。"

#. Occurrence 1_4:442:726: scene=1_4
#: 1_4:442
msgctxt "text_id=726 | speaker=unknown"
msgid "  Even though it lacked the modernity of neighboring Yashirogi"
msgstr "　……もっとも、近代的な面では隣町である<社木|やしろぎ>に一歩譲り、"

#. Occurrence 1_4:447:727: scene=1_4
#: 1_4:447
msgctxt "text_id=727 | speaker=unknown"
msgid "  or the elegance of Misaki Hills..."
msgstr "　<上品|エレガント>さでもこれまた隣町の三咲丘に一歩譲る立ち位置だ。"

#. Occurrence 1_4:502:728: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0001; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:502
msgctxt "text_id=728 | speaker=aoko"
msgid "\"What did people expect? To keep the town hidden atop the mountain forever? It's not like they were gonna flatten the mountain or something.\""
msgstr "「……それも当然よね。どういじくっても元々が山中の宿場町だし。山ごと切り崩すっていうんなら別だけど」"

#. Occurrence 1_4:536:729: scene=1_4
#: 1_4:536
msgctxt "text_id=729 | speaker=unknown"
msgid "  Urbanization had been contained to the lowlands around the station, with most of the hills and mountains still standing as they did ten years prior."
msgstr "　都市化が進んでいるのは平坦な駅周辺だけで、丘や山は十年前のままだ。"

#. Occurrence 1_4:541:730: scene=1_4
#: 1_4:541
msgctxt "text_id=730 | speaker=unknown"
msgid "  The exhaustion of funds succeeded in protecting the old Misaki where the citizens could not."
msgstr "　昔ながらの三咲町なんてものは、住民が守らなくても資金の枯渇が守ってくれたらしい。"

#. Occurrence 1_4:561:731: scene=1_4
#: 1_4:561
msgctxt "text_id=731 | speaker=unknown"
msgid "  It became a truly odd suburban town, welcoming an increasingly urban population with its vestiges of old country charm."
msgstr "　かくして、三咲町は都心の人間がやってきても、まあ、あまりの田舎っぷりに呆れられるコトだけはないという、実に半端な地方都市になりつつある。"

#. Occurrence 1_4:595:732: scene=1_4
#: 1_4:595
msgctxt "text_id=732 | speaker=unknown"
msgid "  Misaki High School was a private school established long before the town's current state."
msgstr "　そんな三咲町の中にあって、三咲高は開発以前からあった私立高校である。"

#. Occurrence 1_4:600:733: scene=1_4
#: 1_4:600
msgctxt "text_id=733 | speaker=unknown"
msgid "  The original campus, built fifty years ago, was located high up in the mountains, making its current location its second incarnation."
msgstr "　今あるのは第二校舎で、五十年前に建てられた初代校舎はさらに上った山の中。"

#. Occurrence 1_4:646:734: scene=1_4
#: 1_4:646
msgctxt "text_id=734 | speaker=unknown"
msgid "  The path to the old grounds was not only steep and remote―"
msgstr "　遠い、坂道がきつい、"

#. Occurrence 1_4:651:735: scene=1_4
#: 1_4:651
msgctxt "text_id=735 | speaker=unknown"
msgid "  it had become an overgrown game trail with the passage of time."
msgstr "　それ以前に通学路が<獣道|けものみち>と化している、"

#. Occurrence 1_4:656:736: scene=1_4
#: 1_4:656
msgctxt "text_id=736 | speaker=unknown"
msgid "  For these reasons, among others, Misaki High School had been shuttered until almost 20 years ago, when it received a donation from a department store chain that allowed for the construction of a new campus in the city."
msgstr "　等々の理由で二十年前まで閉校していた三咲高校だったが、三咲市に本拠地を持つ某デパートグループからの寄付金をもとに新校舎を設立。"

#. Occurrence 1_4:661:737: scene=1_4
#: 1_4:661
msgctxt "text_id=737 | speaker=unknown"
msgid "  And thus, Misaki High School reopened its doors, the old woodland campus forgotten."
msgstr "　かくて、森の校舎は旧校舎として忘れ去られる事になり、三咲高校は再び学舎として開かれた。"

#. Occurrence 1_4:696:738: scene=1_4
#: 1_4:696
msgctxt "text_id=738 | speaker=unknown"
msgid "  In fact, most of the students attending Misaki High School were not from Misaki at all."
msgstr "　しかし、実のところを言えば、三咲高校の生徒の多くは三咲町の住人ではない。"

#. Occurrence 1_4:701:739: scene=1_4
#: 1_4:701
msgctxt "text_id=739 | speaker=unknown"
msgid "  The hearty rustic people of this country town preferred prefectural schools to private ones."
msgstr "　この田舎町に住んでいた善良で素朴な人々は、私立高校より県立高校を望んでいたからである。"

#. Occurrence 1_4:758:740: scene=1_4
#: 1_4:758
msgctxt "text_id=740 | speaker=unknown"
msgid "  Truth be told, Aoko herself was one of them."
msgstr "　何を隠そう、青子もそういった人種の一人だった。"

#. Occurrence 1_4:763:741: scene=1_4
#: 1_4:763
msgctxt "text_id=741 | speaker=unknown"
msgid "  All she had wanted after junior high was to move to Tokyo, where she hoped to spend her days touring her favorite bands on her way to entering a public university."
msgstr "　彼女には中学卒業とともに上京して、国立大学をめざしながらライブハウスを毎日はしごして回るという慎ましやかな野望があったのだ。"

#. Occurrence 1_4:768:742: scene=1_4
#: 1_4:768
msgctxt "text_id=742 | speaker=unknown"
msgid "  But her hopes were dashed with her sister's departure, so here she was, walking alone in town with only a red umbrella to keep her company on what should have been a day off."
msgstr "　そんな彼女の夢も姉の抜け駆けで台無しにされてしまい、何の因果かせっかくの創立記念日に真っ赤な傘をさして歩いている。"

#. Occurrence 1_4:811:743: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0002; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:811
msgctxt "text_id=743 | speaker=aoko"
msgid "\"...Looking back on it now..."
msgstr "「……思い返して見ると。"

msgctxt "text_id=744 | speaker=unknown"
msgid "  It's like my whole life has been one disaster after another.\""
msgstr "　私の人生って、なんか災難続きっぽい……」"

#. Occurrence 1_4:819:745: scene=1_4
#: 1_4:819
msgctxt "text_id=745 | speaker=unknown"
msgid "  Her frustration evaporated into the cold December air."
msgstr "　十二月を前にした寒さの中、ひとりきりでそう呟く。"

#. Occurrence 1_4:869:746: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0003; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:869
msgctxt "text_id=746 | speaker=aoko"
msgid "\"Oh well. At least it's not boring.\""
msgstr "「でもま、いっか。退屈だけはしないワケだし」"

#. Occurrence 1_4:875:747: scene=1_4
#: 1_4:875
msgctxt "text_id=747 | speaker=unknown"
msgid "  With those words, her mood brightened a bit as she left the school in her wake."
msgstr "　語尾をかすかに弾ませて学校を後にする。"

#. Occurrence 1_4:880:748: scene=1_4
#: 1_4:880
msgctxt "text_id=748 | speaker=unknown"
msgid "  The busier part of town met her at the bottom of the gently sloping road."
msgstr "　ゆるやかな坂道を下ってしまえば、そこは賑わいに満ちた人々の住まう街だ。"

#. Occurrence 1_4:964:749: scene=1_4
#: 1_4:964
msgctxt "text_id=749 | speaker=unknown"
msgid "  Misaki's train station was brand new."
msgstr "　三咲町の駅は真新しい。"

#. Occurrence 1_4:969:750: scene=1_4
#: 1_4:969
msgctxt "text_id=750 | speaker=unknown"
msgid "  Once looking no prettier than an abandoned factory, it had been renovated into a multi-purpose structure with huge department stores on its east and west sides."
msgstr "　かつては廃工場にしか見えなかった<建物|えき>は、今では東と西に巨大デパートを持つ複合建築に造り替えられていた。"

#. Occurrence 1_4:989:751: scene=1_4
#: 1_4:989
msgctxt "text_id=751 | speaker=unknown"
msgid "  When the department stores first opened, Aoko and her friends had been impressed with their modern feel, but in time, the stores, too, became dated."
msgstr "　このデパートが出来た時、青子も近代化万歳！　と友人たちとはしゃいだものだが、この建物もあと何年かすれば時代遅れになるのだろう。"

#. Occurrence 1_4:1009:752: scene=1_4
#: 1_4:1009
msgctxt "text_id=752 | speaker=unknown"
msgid "  She had no shopping to do today, so she passed them by."
msgstr "　これといった買い物はないのでデパートを通り過ぎる。"

#. Occurrence 1_4:1014:753: scene=1_4
#: 1_4:1014
msgctxt "text_id=753 | speaker=unknown"
msgid "  What she really wanted to do was rest at a café, but she fought the urge, knowing her roommate would never let her hear the end of it if she frittered away her money―"
msgstr "　本当は喫茶店にでもよって体を休めたいところだが、ひとりだけで無駄遣いをするとまた同居人がヘソを曲げかねないので我慢して―――"

#. Occurrence 1_4:1131:754: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0004; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:1131
msgctxt "text_id=754 | speaker=aoko"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 1_4:1137:755: scene=1_4
#: 1_4:1137
msgctxt "text_id=755 | speaker=unknown"
msgid "  She looked back and blinked."
msgstr "　振り返って、目をしばたたく。"

#. Occurrence 1_4:1142:756: scene=1_4
#: 1_4:1142
msgctxt "text_id=756 | speaker=unknown"
msgid "  For just a moment, she could have sworn she had seen someone suspicious in a red dress out of the corner of her eye."
msgstr "　一瞬。視界の隅に、赤い<服|ドレス>の<不審人物|ナニモノか>を見た気がした。"

#. Occurrence 1_4:1177:757: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0005; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:1177
msgctxt "text_id=757 | speaker=aoko"
msgid "\"..."
msgstr "「――――――"

msgctxt "text_id=758 | speaker=unknown"
msgid "Heh.\""
msgstr "、ふぅ」"

#. Occurrence 1_4:1185:759: scene=1_4
#: 1_4:1185
msgctxt "text_id=759 | speaker=unknown"
msgid "  It must have been her imagination."
msgstr "　どうやらいつもの勘違い。"

#. Occurrence 1_4:1190:760: scene=1_4
#: 1_4:1190
msgctxt "text_id=760 | speaker=unknown"
msgid "  The sixth-sense chill she was experiencing down her spine was a familiar one at this point."
msgstr "　背筋には第六感じみた悪寒があるけど、それも慣れたものだと受け流す。"

#. Occurrence 1_4:1210:761: scene=1_4
#: 1_4:1210
msgctxt "text_id=761 | speaker=unknown"
msgid "  She continued her walk home, brushing off the event as if it had never happened."
msgstr "　まったくもって何事もなかったように振る舞って、青子はいつも通りの帰路につく。"

#. Occurrence 1_4:1226:762: scene=1_4
#: 1_4:1226
msgctxt "text_id=762 | speaker=unknown"
msgid "  In time, the chill faded and all that was left was the sounds of the town."
msgstr "　ほどなくして背中の悪寒は消え、街の喧噪だけが耳に残った。"

#. Occurrence 1_4:1288:763: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0006; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:1288
msgctxt "text_id=763 | speaker=aoko"
msgid "\"...Ugh...\""
msgstr "「…………はあ」"

#. Occurrence 1_4:1294:764: scene=1_4
#: 1_4:1294
msgctxt "text_id=764 | speaker=unknown"
msgid "  She sighed heavily."
msgstr "　大きくため息をひとつ。"

#. Occurrence 1_4:1299:765: scene=1_4
#: 1_4:1299
msgctxt "text_id=765 | speaker=unknown"
msgid "  Had she imagined it?"
msgstr "　まったく。"

#. Occurrence 1_4:1304:766: scene=1_4
#: 1_4:1304
msgctxt "text_id=766 | speaker=unknown"
msgid "  Even if it had all been in her head, she was far from comfortable with the feeling that still lingered."
msgstr "　気のせいにしても、気持ちのいいものじゃない。"

#. Occurrence 1_4:1359:767: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0007; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:1359
msgctxt "text_id=767 | speaker=aoko"
msgid "\"...Even mosquitoes have the grace to buzz off eventually.\""
msgstr "「……夏場の蚊だって、もう少し、こう」"

#. Occurrence 1_4:1365:768: scene=1_4
#: 1_4:1365
msgctxt "text_id=768 | speaker=unknown"
msgid "  She grumbled under her breath."
msgstr "　節度を<弁|わきま>えている……こともないか、と愚痴をこぼす。"

#. Occurrence 1_4:1420:769: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0008; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:1420
msgctxt "text_id=769 | speaker=aoko"
msgid "\"...Whether good or bad, this too shall pass, so the saying goes."
msgstr "「……波瀾万丈、商売繁盛、諸行無常、と。"

#. Occurrence 1_4:1426:770: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0009; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:1426
msgctxt "text_id=770 | speaker=aoko"
msgid "  Yeah. I've got enough on my plate as it is.\""
msgstr "　そうそう、忙しさにグチを言っても始まらないわ」"

#. Occurrence 1_4:1432:771: scene=1_4
#: 1_4:1432
msgctxt "text_id=771 | speaker=unknown"
msgid "  Unfortunately, summer and bugs go hand-in-hand."
msgstr "　うっとうしいけど夏場に蚊はいて当然だし。"

#. Occurrence 1_4:1437:772: scene=1_4
#: 1_4:1437
msgctxt "text_id=772 | speaker=unknown"
msgid "  She could see how bugs could be drawn to all the sweet fruit."
msgstr "　甘い果実に虫が寄ってくるのは、まあ、正しい価値観だろう、と納得する青子だった。"

#. Occurrence 1_4:1507:773: scene=1_4
#: 1_4:1507
msgctxt "text_id=773 | speaker=unknown"
msgid "  Rank with grease and heat, the kitchen was closed for the time being."
msgstr "　油と熱のこもった厨房は、一時の休眠に入っている。"

#. Occurrence 1_4:1512:774: scene=1_4
#: 1_4:1512
msgctxt "text_id=774 | speaker=unknown"
msgid "  The lunch rush had come and gone."
msgstr "　本日も無事、昼の修羅場を乗り切った。"

#. Occurrence 1_4:1517:775: scene=1_4
#: 1_4:1517
msgctxt "text_id=775 | speaker=unknown"
msgid "  But one last battle remained: dinner time. Only after the evening chaos could the kitchen crew remove their white armor and call it a day."
msgstr "　あとは<夕食|よる>の混雑さえ乗り越えれば誰もがコックコートを脱いでしまえる。"

#. Occurrence 1_4:1522:776: scene=1_4
#: 1_4:1522
msgctxt "text_id=776 | speaker=unknown"
msgid "  In the midst of the warzone was a lone newcomer."
msgstr "　そんな、激戦を終えたばかりの<厨房|キッチン>で、ぽつんと立ちつくす<新参者|アルバイト>がひとり。"

#. Occurrence 1_4:1543:777: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_4_0000; voice_prefix=A30; voice_category=3; scene=1_4
#: 1_4:1543
msgctxt "text_id=777 | speaker=soujuurou"
msgid "\"Umm, do I have to wear this?\""
msgstr "「ええっと、これ着るんですか？」"

#. Occurrence 1_4:1549:778: scene=1_4
#: 1_4:1549
msgctxt "text_id=778 | speaker=unknown"
msgid "  His voice was uneasy, betraying how new he was."
msgstr "　新人らしく、不安そうな声で訊ねる。"

#. Occurrence 1_4:1594:779: voice_id=H10_1_4_0000; voice_prefix=H10; voice_category=0; scene=1_4
#: 1_4:1594
msgctxt "text_id=779 | speaker=unknown"
msgid "\"I know how you feel, man. I feel the same. Unfortunately, it's the boss's orders, so you'll have to suck it up, okay? 'The future of this shopping arcade is at stake'... apparently. I really hate to ask, but the rain has stopped, so would you mind going out for me? Get back in one piece, and I'll buy you dinner.\""
msgstr "「気持ちは分かる。俺もどうかと思うけど、店長の言うことだからもう笑顔で乗り越えてくれ。これも商店街の明日のため、なんだとよ。本気で申し訳ないんだが、雨も止んだし、なんとか行って来てくれないか？　無事帰ってきたら晩メシおごってやっから」"

#. Occurrence 1_4:1600:780: scene=1_4
#: 1_4:1600
msgctxt "text_id=780 | speaker=unknown"
msgid "  His bright orange co-worker clasped his hands together as if to beg for forgiveness as he saddled him with this unreasonable task."
msgstr "　まぶしいオレンジ色の制服を着こんだ先輩は、本気ですまないと手を合わせて、無理難題を押しつけた。"

#. Occurrence 1_4:1648:781: scene=1_4
#: 1_4:1648
msgctxt "text_id=781 | speaker=unknown"
msgid "  Ten years ago, Misaki City was a town of farm and woodland."
msgstr "　十年前、三咲市は畑と森の町だった。"

#. Occurrence 1_4:1653:782: scene=1_4
#: 1_4:1653
msgctxt "text_id=782 | speaker=unknown"
msgid "  But everything had changed. The front of the station was now lined with tall multi-story buildings, and the residential areas were similarly full of apartment complexes. The once rustic scenery around the station had long become a thing of the past."
msgstr "　<現|い><在|ま>は開発が進み、駅前にはビルディングが立ち並び、住宅地にも二階建て以上の建築が増え、かつての田園風景は駅から離れないと見られない。"

#. Occurrence 1_4:1658:783: scene=1_4
#: 1_4:1658
msgctxt "text_id=783 | speaker=unknown"
msgid "  Shiroinuzuka was the only place in the city that still contained vestiges of the old town. A pocket of the past inside an urban jungle."
msgstr "　そんな中、都市部においても昔ながらの面影を残しているのがここ、三咲市のエアポケットと言われる<白犬塚|しろいぬづか>である。"

#. Occurrence 1_4:1678:784: scene=1_4
#: 1_4:1678
msgctxt "text_id=784 | speaker=unknown"
msgid "  The road extended up a conspicuously high hill,"
msgstr "　ひときわ高い丘に敷かれた長い坂道。"

#. Occurrence 1_4:1683:785: scene=1_4
#: 1_4:1683
msgctxt "text_id=785 | speaker=unknown"
msgid "  to an old residential district far from the hustle and bustle of the train station."
msgstr "　人々の生活の中心である駅から離れた、昔ながらの住宅地。"

#. Occurrence 1_4:1688:786: scene=1_4
#: 1_4:1688
msgctxt "text_id=786 | speaker=unknown"
msgid "  Long ago, it had been considered unwise to build on high ground, so nobody lived above a certain elevation."
msgstr "　その昔、三咲では高い土地に住居を構えるのはよくない事とされ、一定以上の高みに住む人間はいなかった。"

#. Occurrence 1_4:1693:787: scene=1_4
#: 1_4:1693
msgctxt "text_id=787 | speaker=unknown"
msgid "  Shiroinuzuka, sitting as it did atop a hill in the middle of town, was no exception to that convention and had no residences to speak of."
msgstr "　町の中心にそびえる丘、この白犬塚もその例にならい、ここから先に民家は見られない。"

#. Occurrence 1_4:1715:788: scene=1_4
#: 1_4:1715
msgctxt "text_id=788 | speaker=unknown"
msgid "  The asphalt continued for some time, eventually giving way to a mountain road that was swallowed into the cover of trees."
msgstr "　アスファルトの坂道は延々と続くものの、やがて森に閉ざされ、あとは山道のごとき道が続くだけ。"

#. Occurrence 1_4:1720:789: scene=1_4
#: 1_4:1720
msgctxt "text_id=789 | speaker=unknown"
msgid "  A lone vending machine stood to mark the boundary between town and beyond."
msgstr "　坂道の途中にぽつんと置かれた自動販売機は、さながら町と丘の境界線のようだ。"

#. Occurrence 1_4:1725:790: scene=1_4
#: 1_4:1725
msgctxt "text_id=790 | speaker=unknown"
msgid "  Even the children knew that there was nothing beyond the new playground in development that so enthralled them."
msgstr "　新しい遊び場の開発に余念がない子供たちでも、この先には何もないと知っている。"

#. Occurrence 1_4:1730:791: scene=1_4
#: 1_4:1730
msgctxt "text_id=791 | speaker=unknown"
msgid "  Well, that was not entirely true."
msgstr "　いや、<正|ただ>しくは。"

#. Occurrence 1_4:1735:792: scene=1_4
#: 1_4:1735
msgctxt "text_id=792 | speaker=unknown"
msgid "  There was nothing... besides the haunted house."
msgstr "　この先には、あのお化け屋敷しかないと知っている。"

#. Occurrence 1_4:1778:793: scene=1_4
#: 1_4:1778
msgctxt "text_id=793 | speaker=unknown"
msgid "  Aoko Aozaki traversed the long slope."
msgstr "　長い坂を、蒼崎青子は上っていく。"

#. Occurrence 1_4:1799:794: scene=1_4
#: 1_4:1799
msgctxt "text_id=794 | speaker=unknown"
msgid "  Below her, she could see the whole of Misaki."
msgstr "　眼下には三咲町の景観が広がっている。"

#. Occurrence 1_4:1804:795: scene=1_4
#: 1_4:1804
msgctxt "text_id=795 | speaker=unknown"
msgid "  The symmetrical town looked like a miniature set from this height."
msgstr "　おもちゃの風景のように均整の取れた町並み。"

#. Occurrence 1_4:1809:796: scene=1_4
#: 1_4:1809
msgctxt "text_id=796 | speaker=unknown"
msgid "  It would look like a painting if there had been a sea next to it, but unfortunately, Misaki City was very much landlocked."
msgstr "　これで近くに海でもあれば絵になるが、残念ながら三咲市は山中の町である。"

#. Occurrence 1_4:1829:797: scene=1_4
#: 1_4:1829
msgctxt "text_id=797 | speaker=unknown"
msgid "  While it was overcast at the moment, the scene was quite breathtaking on clear evenings."
msgstr "　空はいまだ曇天だが、晴れた夕暮れ時、ここの風景は素晴らしいものになる。"

#. Occurrence 1_4:1834:798: scene=1_4
#: 1_4:1834
msgctxt "text_id=798 | speaker=unknown"
msgid "  The view was the one thing that made the arduous climb worthwhile, and today, she had been denied even that."
msgstr "　それだけで坂道を上る苦労も報われるのだが、今日はその報酬の影すらなかった。"

#. Occurrence 1_4:1875:799: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0010; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:1875
msgctxt "text_id=799 | speaker=aoko"
msgid "\"...Ugh. I'd cycle home if it wasn't for this rain. Even a bus route would be a fine thing.\""
msgstr "「……はあ。雨の日は自転車も使えないし。一日に二回ぐらいバスでも通ってくれないもんかな、ホント」"

#. Occurrence 1_4:1881:800: scene=1_4
#: 1_4:1881
msgctxt "text_id=800 | speaker=unknown"
msgid "  Aoko had been using this road to get to school for almost two years now, but the journey had never gotten easier."
msgstr "　この坂道を通学路にしてじき二年になる青子だが、辛いものは辛いらしい。"

#. Occurrence 1_4:1952:801: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0011; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:1952
msgctxt "text_id=801 | speaker=aoko"
msgid "\"Oh, it's locked?"
msgstr "「あれ、鍵<閉|し>まったまま？"

#. Occurrence 1_4:1958:802: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0012; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:1958
msgctxt "text_id=802 | speaker=aoko"
msgid "  I guess Alice isn't back yet.\""
msgstr "　……<有珠|ありす>、まだ帰ってきてないんだ」"

#. Occurrence 1_4:1964:803: scene=1_4
#: 1_4:1964
msgctxt "text_id=803 | speaker=unknown"
msgid "  With a weary shrug, she put her hand on the rusty iron fence."
msgstr "　青子はやれやれと肩をすくめて、古びた鉄柵に手をかける。"

#. Occurrence 1_4:1984:804: scene=1_4
#: 1_4:1984
msgctxt "text_id=804 | speaker=unknown"
msgid "  Quietly, the heavy gate swung open as if to welcome her home."
msgstr "　重苦しい鉄の門は静かに、この年若い少女を歓迎するように開いていった。"

#. Occurrence 1_4:2043:805: scene=1_4
#: 1_4:2043
msgctxt "text_id=805 | speaker=unknown"
msgid "  \"...There sits atop that hill a haunted house.\""
msgstr "　―――丘の上にはお化け屋敷が建っている。"

#. Occurrence 1_4:2079:806: scene=1_4
#: 1_4:2079
msgctxt "text_id=806 | speaker=unknown"
msgid "  That is how the story much shared around town used to begin."
msgstr "　それは三咲町に古くから伝わるむかし話。"

#. Occurrence 1_4:2084:807: scene=1_4
#: 1_4:2084
msgctxt "text_id=807 | speaker=unknown"
msgid "  But fresh rumors about the house had sprung to life almost as fast as the town's modernization:"
msgstr "　そして町の近代化に合わせるよう、ひっそりと<蘇|よみがえ>った最新のうわさ話。"

#. Occurrence 1_4:2142:808: scene=1_4
#: 1_4:2142
msgctxt "text_id=808 | speaker=unknown"
msgid "  Despite being dilapidated and abandoned for many years, lights can be seen inside the house at night..."
msgstr "　たとえば、もう何年も前に朽ち果てた廃屋なのに、夜になると明かりが灯ったりする。"

#. Occurrence 1_4:2148:809: scene=1_4
#: 1_4:2148
msgctxt "text_id=809 | speaker=unknown"
msgid "  An angry murder of crows often gathers atop the hill before mysteriously vanishing..."
msgstr "　たとえば、丘の上に無数のカラスが集まっては消えていく。"

#. Occurrence 1_4:2154:810: scene=1_4
#: 1_4:2154
msgctxt "text_id=810 | speaker=unknown"
msgid "  Children get lost in the fog, never to be seen again..."
msgstr "　たとえば、霧が深い日は子供が迷いこんで神隠しにあう。"

#. Occurrence 1_4:2174:811: scene=1_4
#: 1_4:2174
msgctxt "text_id=811 | speaker=unknown"
msgid "  Late at night, a shrieking sound can be heard all the way to town-this particular piece of slander was the one Aoko wished to discredit the most."
msgstr "　たとえば、深夜、叫び声にしか聞こえない怪音が住宅地にまで響いてくる。……これは青子的に不名誉な噂なので改めたい。"

#. Occurrence 1_4:2180:812: scene=1_4
#: 1_4:2180
msgctxt "text_id=812 | speaker=unknown"
msgid "  The final rumor was of an eye-catching luxury car that sometimes made its way up and down the hill."
msgstr "　あと、たまに目を疑うような高級車が坂道を登っていく。"

#. Occurrence 1_4:2245:813: scene=1_4
#: 1_4:2245
msgctxt "text_id=813 | speaker=unknown"
msgid "  The rumors spread and grew by the day."
msgstr "　噂話は日に日に種類を増していた。"

#. Occurrence 1_4:2250:814: scene=1_4
#: 1_4:2250
msgctxt "text_id=814 | speaker=unknown"
msgid "  And while they grew, the house that everyone thought had rotted away was restored over the recent years."
msgstr "　そんな感じで、朽ちたはずの丘の上の洋館は、数年前から息を吹き返していた。"

#. Occurrence 1_4:2255:815: scene=1_4
#: 1_4:2255
msgctxt "text_id=815 | speaker=unknown"
msgid "  Deep in a wood on top of a hill no one dared to approach,"
msgstr "　人々の寄りつかない丘のただ中。"

#. Occurrence 1_4:2260:816: scene=1_4
#: 1_4:2260
msgctxt "text_id=816 | speaker=unknown"
msgid "  like a ruin, shrouded from view even on the brightest of days,"
msgstr "　昼なお暗い森に隠された廃墟。"

#. Occurrence 1_4:2265:817: scene=1_4
#: 1_4:2265
msgctxt "text_id=817 | speaker=unknown"
msgid "  stood a relic out of time, a building from a fairy tale."
msgstr "　おとぎ話に出てきそうな、時代に取り残された魔法の<残|ざん><滓|し>。"

#. Occurrence 1_4:2270:818: scene=1_4
#: 1_4:2270
msgctxt "text_id=818 | speaker=unknown"
msgid "  The house..."
msgstr "　それが、"

#. Occurrence 1_4:2308:819: scene=1_4
#: 1_4:2308
msgctxt "text_id=819 | speaker=unknown"
msgid "  ...was the Kuonji Mansion."
msgstr "　この<久遠寺|くおんじ>邸。"

#. Occurrence 1_4:2313:820: scene=1_4
#: 1_4:2313
msgctxt "text_id=820 | speaker=unknown"
msgid "  Everyone in town knew about the witch's house on the hill."
msgstr "　三咲町の誰もが知っている、丘の上の魔女の家。"

#. Occurrence 1_4:2318:821: scene=1_4
#: 1_4:2318
msgctxt "text_id=821 | speaker=unknown"
msgid "  It was an unabashedly haunted house where Aoko Aozaki resided, for reasons known only to her."
msgstr "　ワケあって蒼崎青子が下宿している、正真正銘の幽霊屋敷なのだった。"

#. Occurrence 1_4:2338:822: scene=1_4
#: 1_4:2338
msgctxt "text_id=822 | speaker=unknown"
msgid "  Needless to say, it was not really haunted."
msgstr "　言うまでもなく、幽霊屋敷というのは俗称である。"

#. Occurrence 1_4:2343:823: scene=1_4
#: 1_4:2343
msgctxt "text_id=823 | speaker=unknown"
msgid "  The Kuonji family home was a grand Western-style mansion with a long and storied history, stretching all the way back to England."
msgstr "　久遠寺邸はとある経緯でイギリスから運ばれてきた、由緒正しい洋館だ。"

#. Occurrence 1_4:2363:824: scene=1_4
#: 1_4:2363
msgctxt "text_id=824 | speaker=unknown"
msgid "  It was too small to be a dormitory, yet too big to be called a house."
msgstr "　寮にするほど広くはないけれど、家にするには広すぎる。"

#. Occurrence 1_4:2368:825: scene=1_4
#: 1_4:2368
msgctxt "text_id=825 | speaker=unknown"
msgid "  The main building contained as many as three normal houses' worth of rooms and was surrounded by a large all-encompassing courtyard."
msgstr "　普通の住宅が三つほど入りそうな本館と、ぐるりと囲む庭。"

#. Occurrence 1_4:2373:826: scene=1_4
#: 1_4:2373
msgctxt "text_id=826 | speaker=unknown"
msgid "  The perimeter of the grounds was surrounded by a high, iron fence covered in thorny vines."
msgstr "　庭の四方には鉄柵が高くそびえ、ご丁寧に<茨|いばら>めいた植物の<蔓|つる>まで絡み付いている。"

#. Occurrence 1_4:2378:827: scene=1_4
#: 1_4:2378
msgctxt "text_id=827 | speaker=unknown"
msgid "  There was also an annex to the main building."
msgstr "　おまけに本館から離れた高台には別館まで完備している念の入れよう。"

#. Occurrence 1_4:2411:828: scene=1_4
#: 1_4:2411
msgctxt "text_id=828 | speaker=unknown"
msgid "  Given such extravagance, it was no wonder that it inspired rumors."
msgstr "　これだけ徹底していれば尾ひれがつくのは致し方ない。"

#. Occurrence 1_4:2416:829: scene=1_4
#: 1_4:2416
msgctxt "text_id=829 | speaker=unknown"
msgid "  To the town residents, the mere existence of such a lavish and out-of-place mansion on top of the hill was a cause for suspicion."
msgstr "　町の住人からすれば、不自然に豪勢な館が丘の上に建っているだけで不気味だろうし。"

#. Occurrence 1_4:2421:830: scene=1_4
#: 1_4:2421
msgctxt "text_id=830 | speaker=unknown"
msgid "  Rumors, lies, and slander were the prices to be paid for fame."
msgstr "　<誹謗|ひぼう><中傷|ちゅうしょう>、<誤解|ごかい><軋轢|あつれき>は有名税みたいなものだ。"

#. Occurrence 1_4:2426:831: scene=1_4
#: 1_4:2426
msgctxt "text_id=831 | speaker=unknown"
msgid "  With only two lodgers, it was hard to disagree with the perception that vampires must be living here."
msgstr "　しかも住んでいるのは二人だけなのだから、その住人は吸血鬼扱いされても文句は言えまい。"

#. Occurrence 1_4:2480:832: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0013; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:2480
msgctxt "text_id=832 | speaker=aoko"
msgid "\"...Well, I know I'm not one, but Alice...\""
msgstr "「……まあ、私はともかく、有珠はそういうの、やりかねないし」"

#. Occurrence 1_4:2502:833: scene=1_4
#: 1_4:2502
msgctxt "text_id=833 | speaker=unknown"
msgid "  She put her hand on the front door."
msgstr "　玄関に手をかける。"

#. Occurrence 1_4:2507:834: scene=1_4
#: 1_4:2507
msgctxt "text_id=834 | speaker=unknown"
msgid "  It was a grand double door that would have paired well with a brass lock, and yet, it was secured with little more than a simple keyhole."
msgstr "　<真鍮|しんちゅう>の鍵が似合いそうな両開きの扉には、しかし、鍵穴などという不粋な物はない。"

#. Occurrence 1_4:2524:835: scene=1_4
#: 1_4:2524
msgctxt "text_id=835 | speaker=unknown"
msgid "  Pushing it open with one hand, she entered the supposedly haunted house."
msgstr "　青子は片手で扉を押し開き、幽霊屋敷と称される館の中へと入っていった。"

#. Occurrence 1_4:2549:836: scene=1_4
#: 1_4:2549
msgctxt "text_id=836 | speaker=unknown"
msgid "  ...And by the way..."
msgstr "　……ところで。"

#. Occurrence 1_4:2554:837: scene=1_4
#: 1_4:2554
msgctxt "text_id=837 | speaker=unknown"
msgid "  If vampires were not enough to scare you, ghosts were known to appear on certain nights."
msgstr "　吸血鬼云々はともかく、幽霊に関しては、状況次第で出ないコトもないという。"

#. Occurrence 1_5:93:838: scene=1_5
#: 1_5:93
msgctxt "text_id=838 | speaker=unknown"
msgid "  Much like the weather outside, the foyer was overcast with shades of gray."
msgstr "　外の天気同様、ロビーも灰色に曇っていた。"

#. Occurrence 1_5:98:839: scene=1_5
#: 1_5:98
msgctxt "text_id=839 | speaker=unknown"
msgid "  Perhaps by deliberate design, the architect had chosen not to include any lights in the entrance area."
msgstr "　設計者の趣向によるものか、このエントランスは電灯を可能なかぎり排除していた。"

#. Occurrence 1_5:103:840: scene=1_5
#: 1_5:103
msgctxt "text_id=840 | speaker=unknown"
msgid "  The ceiling was two floors high."
msgstr "　天井は二階まで吹き抜け。"

#. Occurrence 1_5:108:841: scene=1_5
#: 1_5:108
msgctxt "text_id=841 | speaker=unknown"
msgid "  The only light in the room came from the skylight."
msgstr "　明かりになるのは、その高い天井にある窓から差しこむ日光と月光だけだ。"

#. Occurrence 1_5:128:842: scene=1_5
#: 1_5:128
msgctxt "text_id=842 | speaker=unknown"
msgid "  It was particularly gloomy on rainy days."
msgstr "　雨の日は夜明け前のように<仄|ほの>暗く、"

#. Occurrence 1_5:133:843: scene=1_5
#: 1_5:133
msgctxt "text_id=843 | speaker=unknown"
msgid "  On moonless nights, it was like the world itself ceased to be."
msgstr "　月のない夜は冷たい暗黒星のように、あらゆるものが途絶えている。"

#. Occurrence 1_5:153:844: scene=1_5
#: 1_5:153
msgctxt "text_id=844 | speaker=unknown"
msgid "  Aoko decided the drawing room to the east would be a good place to rest, but knowing that she would not be able to relax until she changed clothes, she started up the stairs."
msgstr "　<憩|いこ>いの場となる居間はこのロビーのすぐ真東だが、その前に自分の部屋で着替えなくては落ち着かない、と青子は階段に足をかけた。"

#. Occurrence 1_5:160:845: scene=1_5
#: 1_5:160
msgctxt "text_id=845 | speaker=unknown"
msgid "  The stairs curled up the wall to the second-floor hall."
msgstr "　壁に<沿|そ>った階段はいったん二階のホールで終わっている。"

#. Occurrence 1_5:165:846: scene=1_5
#: 1_5:165
msgctxt "text_id=846 | speaker=unknown"
msgid "  There was a third-floor attic as well, accessible from the far end of the hall."
msgstr "　三階の屋根裏部屋まではホールの裏側にまわらなければならない。"

#. Occurrence 1_5:170:847: scene=1_5
#: 1_5:170
msgctxt "text_id=847 | speaker=unknown"
msgid "  She had never set foot in there in the two years she had lived here, though."
msgstr "　といっても、青子はこの二年間、屋根裏部屋を利用した事はないが。"

#. Occurrence 1_5:200:848: scene=1_5
#: 1_5:200
msgctxt "text_id=848 | speaker=unknown"
msgid "  The Kuonji mansion was more or less divided into two wings: east and west."
msgstr "　久遠寺邸は大まかに、東館と西館とに分かれている。"

#. Occurrence 1_5:205:849: scene=1_5
#: 1_5:205
msgctxt "text_id=849 | speaker=unknown"
msgid "  Aoko had been given the entire east wing, but two rooms were more than enough as far as she was concerned."
msgstr "　青子に間借りが許されているのは館の東部分だけだが、それも二部屋で事足りる。"

#. Occurrence 1_5:210:850: scene=1_5
#: 1_5:210
msgctxt "text_id=850 | speaker=unknown"
msgid "  She had no desire to open a door that would trap you in a storybook world or lead to an attic that had only been used for storage these last five years."
msgstr "　開けたとたん絵本の世界に閉じこめられるドアやら、過去五年間物置になっている屋根裏部屋など使うまでもない。"

#. Occurrence 1_5:264:851: scene=1_5
#: 1_5:264
msgctxt "text_id=851 | speaker=unknown"
msgid "  Aoko's room was at the end of the east wing's long corridor."
msgstr "　東館の長廊下の奥が青子の部屋だ。"

#. Occurrence 1_5:269:852: scene=1_5
#: 1_5:269
msgctxt "text_id=852 | speaker=unknown"
msgid "  She had elected for a smaller room for no other reason other than that she thought it would be easier to clean."
msgstr "　青子は下宿の際、そう広くない部屋を選んだ。遠慮しての事ではなく、単に掃除の手間を省いただけである。"

#. Occurrence 1_5:274:853: scene=1_5
#: 1_5:274
msgctxt "text_id=853 | speaker=unknown"
msgid "  It was furnished with a large bed, her beloved mahogany desk, a wardrobe and chest for her clothes, and two nine-shelf bookcases."
msgstr "　部屋には大きめのベッドと愛用のマホガニー製の机、洋服ダンスと上着が整列する収納ダンス、それに九段の本棚を二つほど。"

#. Occurrence 1_5:294:854: scene=1_5
#: 1_5:294
msgctxt "text_id=854 | speaker=unknown"
msgid "  That was the extent of what she'd brought from home."
msgstr "　実家から運びこんだ荷物はそれだけ。"

#. Occurrence 1_5:302:855: scene=1_5
#: 1_5:302
msgctxt "text_id=855 | speaker=unknown"
msgid "  Her entire life of sixteen years, reduced to this."
msgstr "　蒼崎青子が十六年<培|つちか>ってきた彼女の証明は、いざとなればその程度に短縮できてしまったらしい。"

#. Occurrence 1_5:307:856: scene=1_5
#: 1_5:307
msgctxt "text_id=856 | speaker=unknown"
msgid "  She'd also borrowed the next room down for her own purposes."
msgstr "　あとは隣の部屋に、これからの自分用の部屋を借りておしまい。"

#. Occurrence 1_5:344:857: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0000; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:344
msgctxt "text_id=857 | speaker=aoko"
msgid "\"Oh yeah. I should check on the watchtower I got from Alice.\""
msgstr "「―――そうだ。有珠にもらった見張り塔、壊れてないかチェックしないと」"

#. Occurrence 1_5:399:858: scene=1_5
#: 1_5:399
msgctxt "text_id=858 | speaker=unknown"
msgid "  She needed to see if the project she had been working on all night had borne fruit."
msgstr "　今朝方までの徹夜の成果を確かめる。"

#. Occurrence 1_5:421:859: scene=1_5
#: 1_5:421
msgctxt "text_id=859 | speaker=unknown"
msgid "  The study next door served as proof of the life she had been living for the last year and how different that life was from the one she had lived before."
msgstr "　壁一枚を隔てた書斎は、先ほどの蒼崎青子の生活とはまったく別の、まだ一年足らずの彼女の人生を示すものだ。"

#. Occurrence 1_5:426:860: scene=1_5
#: 1_5:426
msgctxt "text_id=860 | speaker=unknown"
msgid "  It was not a room for the person she had been."
msgstr "　それまでの彼女の為でなく、"

#. Occurrence 1_5:431:861: scene=1_5
#: 1_5:431
msgctxt "text_id=861 | speaker=unknown"
msgid "  It was a room for the person she would eventually become. A place of solitude that only she could enter. Or so she thought..."
msgstr "　これからの彼女の証明になる、余人には立ち入れない独りの世界、の筈なのだが―――"

#. Occurrence 1_5:452:862: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0001; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:452
msgctxt "text_id=862 | speaker=aoko"
msgid "\"Wow. Not only did it break, it vanished without a trace... Looks like I've still got a long way to go... Go ahead, laugh it up, Robin.\""
msgstr "「うわ……壊れてるどころか、跡形もなく消え去ってる……やっぱ自己流アレンジはまだ早かったか……いいわよ。笑いなさいよ、コマドリ」"

#. Occurrence 1_5:467:863: scene=1_5
#: 1_5:467
msgctxt "text_id=863 | speaker=unknown"
msgid "  The nosy neighbor that had intruded upon her sanctuary flew away."
msgstr "　平気の平左でくつろいでいた<余人|コマドリ>が飛び去っていく。"

#. Occurrence 1_5:474:864: scene=1_5
#: 1_5:474
msgctxt "text_id=864 | speaker=unknown"
msgid "  While not exceptionally talented, Aoko did not lack for effort and was not afraid to fail."
msgstr "　才能は人並み、努力は惜しまず、失敗は恐れずに。"

#. Occurrence 1_5:479:865: scene=1_5
#: 1_5:479
msgctxt "text_id=865 | speaker=unknown"
msgid "  One could have almost mistaken her approach for optimism."
msgstr "　それは時に楽天的にさえ見える、青子の自由奔放さだった。"

#. Occurrence 1_5:606:866: scene=1_5
#: 1_5:606
msgctxt "text_id=866 | speaker=unknown"
msgid "  She changed out of her uniform and returned to the first floor."
msgstr "　制服から普段着に着替えて一階に戻る。"

#. Occurrence 1_5:674:867: scene=1_5
#: 1_5:674
msgctxt "text_id=867 | speaker=unknown"
msgid "  Down the stairs, she opened the door to the east wing into the corridor as dark as a cellar."
msgstr "　階段をおりて東側の扉を開けると、地下室のように暗い廊下が続いていた。"

#. Occurrence 1_5:682:868: scene=1_5
#: 1_5:682
msgctxt "text_id=868 | speaker=unknown"
msgid "  The absence of windows meant it was pitch black without the lights on, so she flicked the switch and entered the nearby doorway."
msgstr "　この廊下は外に面した窓がないだけに、電灯がなければ真っ暗だ。スイッチをいれて明かりをつけ、青子はすぐ近くの扉を開けた。"

#. Occurrence 1_5:753:869: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0002; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:753
msgctxt "text_id=869 | speaker=aoko"
msgid "\"Life without electricity... I don't even want to imagine it.\""
msgstr "「電気のない生活か……想像したくないな」"

#. Occurrence 1_5:759:870: scene=1_5
#: 1_5:759
msgctxt "text_id=870 | speaker=unknown"
msgid "  It had been her idea to update the drawing room."
msgstr "　居間は彼女の趣向で現代ライクな造りに変更されている。"

#. Occurrence 1_5:764:871: scene=1_5
#: 1_5:764
msgctxt "text_id=871 | speaker=unknown"
msgid "  The walls were decorated with extravagant patterns,"
msgstr "　<豪奢|ごうしゃ>な紋様の入った壁、"

#. Occurrence 1_5:769:872: scene=1_5
#: 1_5:769
msgctxt "text_id=872 | speaker=unknown"
msgid "  and around the room were large, majestic sofas,"
msgstr "　<威厳|いげん>に満ちた大きなソファー、"

#. Occurrence 1_5:774:873: scene=1_5
#: 1_5:774
msgctxt "text_id=873 | speaker=unknown"
msgid "  and a luxurious Persian rug."
msgstr "　ペルシャ製の高級絨毯。"

#. Occurrence 1_5:779:874: scene=1_5
#: 1_5:779
msgctxt "text_id=874 | speaker=unknown"
msgid "  Amidst it all was a thirty-inch television that seemed completely out of place."
msgstr "　城の一室めいた空間に、空気を読まず不釣り合いな30インチのテレビジョンが<鎮座|ちんざ>している。"

#. Occurrence 1_5:817:875: scene=1_5
#: 1_5:817
msgctxt "text_id=875 | speaker=unknown"
msgid "  It stood looking over the other furniture like the emperor with no clothes."
msgstr "　テレビはハダカの王様のように、精一杯の虚勢を張ってソファーたちを従えていた。"

#. Occurrence 1_5:822:876: scene=1_5
#: 1_5:822
msgctxt "text_id=876 | speaker=unknown"
msgid "  The mansion's owner would have rather done without it, but to a commoner like Aoko it was an essential commodity."
msgstr "　洋館の持ち主は嫌がったが、このとってつけた感こそ庶民である青子には必要不可欠な<憩|いこ>いである。"

#. Occurrence 1_5:827:877: scene=1_5
#: 1_5:827
msgctxt "text_id=877 | speaker=unknown"
msgid "  They had fought over its presence at first, but eventually came to an agreement and now mutually enjoyed this modern comfort."
msgstr "　下宿を始めてすぐの頃、これで同居人と一戦争あったが、今ではお互い納得の文明機器になっている。"

#. Occurrence 1_5:873:878: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0003; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:873
msgctxt "text_id=878 | speaker=aoko"
msgid "\"Guess I'm one to talk."
msgstr "「……なんだ、人のことは言えないか。"

#. Occurrence 1_5:873:879: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0003; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:873
msgctxt "text_id=879 | speaker=aoko"
msgid "  I came from a pretty traditional household myself.\""
msgstr "　うちもあんがい、時代錯誤な家だった」"

#. Occurrence 1_5:885:880: scene=1_5
#: 1_5:885
msgctxt "text_id=880 | speaker=unknown"
msgid "  Now in a somewhat pleasant mood, she decided to brew some tea."
msgstr "　なんとなく愉快な気持ちになって、青子はお茶にする事にした。"

#. Occurrence 1_5:902:881: scene=1_5
#: 1_5:902
msgctxt "text_id=881 | speaker=unknown"
msgid "  She boiled some water in the kitchen, prepared a teapot, and made herself some black tea."
msgstr "　居間と壁一つでつながっている台所でお湯を沸かし、ティーポットと鍋を用意して、万全の準備で紅茶を淹れる。"

#. Occurrence 1_5:964:882: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0004; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:964
msgctxt "text_id=882 | speaker=aoko"
msgid "\"Whew.\""
msgstr "「はーあ、っと」"

#. Occurrence 1_5:972:883: scene=1_5
#: 1_5:972
msgctxt "text_id=883 | speaker=unknown"
msgid "  With a flop, she sank into the sofa."
msgstr "　ぼすん、とソファーに深々と沈みこむ。"

#. Occurrence 1_5:1063:884: scene=1_5
#: 1_5:1063
msgctxt "text_id=884 | speaker=unknown"
msgid "  She took a sip of her tea, then another."
msgstr "　紅茶を一口、それから二口。"

#. Occurrence 1_5:1183:885: scene=1_5
#: 1_5:1183
msgctxt "text_id=885 | speaker=unknown"
msgid "  Lulled by the ticking of the clock, she took a third sip as she pondered how to spend her afternoon."
msgstr "　時計の針に耳を<傾|かたむ>けながら、ああ、今日は午後からどうしよう、とぼんやり思って三口目。"

#. Occurrence 1_5:1188:886: scene=1_5
#: 1_5:1188
msgctxt "text_id=886 | speaker=unknown"
msgid "  The sofa almost seemed to be inviting her, and she sunk even further into its comforting embrace."
msgstr "　柔らかなソファーの感触に、どこまでも沈みこんでいきたい衝動にかられた頃。"

#. Occurrence 1_5:1240:887: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0005; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1240
msgctxt "text_id=887 | speaker=aoko"
msgid "\"...\""
msgstr "『――――――』"

#. Occurrence 1_5:1246:888: scene=1_5
#: 1_5:1246
msgctxt "text_id=888 | speaker=unknown"
msgid "  Aoko blearily opened her eyes as she lifted her body up from the cushions."
msgstr "　青子は目をパチパチとまたたいて、クッションから体を起こした。"

#. Occurrence 1_5:1258:889: scene=1_5
#: 1_5:1258
msgctxt "text_id=889 | speaker=unknown"
msgid "  This was no dream or delusion."
msgstr "　夢でも妄想でもない。"

#. Occurrence 1_5:1263:890: scene=1_5
#: 1_5:1263
msgctxt "text_id=890 | speaker=unknown"
msgid "  At some point, a girl had sat down across from her."
msgstr "　いつのまにか、目の前にひとりの少女が座っている。"

#. Occurrence 1_5:1300:891: scene=1_5
#: 1_5:1300
msgctxt "text_id=891 | speaker=unknown"
msgid "  Not the least bit surprised, she reached for her teacup."
msgstr "　さして驚かず、青子はティーカップに指をあてた。"

#. Occurrence 1_5:1305:892: scene=1_5
#: 1_5:1305
msgctxt "text_id=892 | speaker=unknown"
msgid "  But the tea within had gone completely cold."
msgstr "　淹れたばかりの紅茶は完全に冷めきっている。"

#. Occurrence 1_5:1311:893: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0006; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1311
msgctxt "text_id=893 | speaker=aoko"
msgid "\"Did I doze off?\""
msgstr "「寝てた？」"

#. Occurrence 1_5:1316:894: scene=1_5
#: 1_5:1316
msgctxt "text_id=894 | speaker=unknown"
msgid "  She asked the question to the girl on the other side of the table."
msgstr "　テーブル向こうの少女に問いかける、青子の声。"

#. Occurrence 1_5:1322:895: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0000; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:1322
msgctxt "text_id=895 | speaker=alice"
msgid "\"Yes.\""
msgstr "「ええ」"

#. Occurrence 1_5:1327:896: scene=1_5
#: 1_5:1327
msgctxt "text_id=896 | speaker=unknown"
msgid "  The girl answered without lifting her gaze."
msgstr "　少女は視線をあげず、関心なさげに答えた。"

#. Occurrence 1_5:1362:897: scene=1_5
#: 1_5:1362
msgctxt "text_id=897 | speaker=unknown"
msgid "  When silent, she could have been mistaken for a beautiful doll."
msgstr "　―――声をあげなければ、あるいは、美しい人形と見間違えるだろう。"

#. Occurrence 1_5:1368:898: scene=1_5
#: 1_5:1368
msgctxt "text_id=898 | speaker=unknown"
msgid "  The girl sitting on the opposite sofa was reading an old book."
msgstr "　その少女はソファーに座り、古い本を読んでいる。"

#. Occurrence 1_5:1373:899: scene=1_5
#: 1_5:1373
msgctxt "text_id=899 | speaker=unknown"
msgid "  She had delicate limbs and pale white skin."
msgstr "　細い手足と陽の光を知らぬ白い肌。"

#. Occurrence 1_5:1378:900: scene=1_5
#: 1_5:1378
msgctxt "text_id=900 | speaker=unknown"
msgid "  Not a hint of humanity emanated from her melancholic aura."
msgstr "　愁いがちな趣きは、人間らしい意思を感じさせない。"

#. Occurrence 1_5:1398:901: scene=1_5
#: 1_5:1398
msgctxt "text_id=901 | speaker=unknown"
msgid "  She had darker hair than Aoko,"
msgstr "　青子より濃い、混じりけのない黒髪。"

#. Occurrence 1_5:1403:902: scene=1_5
#: 1_5:1403
msgctxt "text_id=902 | speaker=unknown"
msgid "  and her icy eyes were focused on the pages in front of her."
msgstr "　冷たい色をした瞳は、しずしずとページへ視線を落としている。"

#. Occurrence 1_5:1408:903: scene=1_5
#: 1_5:1408
msgctxt "text_id=903 | speaker=unknown"
msgid "  Her clothes resembled that of a nun but were actually her school uniform."
msgstr "　修道女を思わせる黒衣は彼女の通う女学院の制服だ。"

#. Occurrence 1_5:1413:904: scene=1_5
#: 1_5:1413
msgctxt "text_id=904 | speaker=unknown"
msgid "  In Aoko's humble opinion, the gloominess suited her."
msgstr "　その<翳|くら>さは少女によく似合っていたが、青子に言わせれば似合いすぎて良くないらしい。"

#. Occurrence 1_5:1433:905: scene=1_5
#: 1_5:1433
msgctxt "text_id=905 | speaker=unknown"
msgid "  She evoked something like out of a painting."
msgstr "　……さながら一枚の風景画。"

#. Occurrence 1_5:1438:906: scene=1_5
#: 1_5:1438
msgctxt "text_id=906 | speaker=unknown"
msgid "  There was something unreal about her, as if she were frozen in time."
msgstr "　初めからそういう形で生まれてきたとさえ思える現実感の無さ。"

#. Occurrence 1_5:1443:907: scene=1_5
#: 1_5:1443
msgctxt "text_id=907 | speaker=unknown"
msgid "  The white of her gently arched neck was so lovely that even Aoko found herself enchanted by it."
msgstr "　<俯|うつむ>く彼女の首の白さは、同性の青子でさえ見とれるほど美しい。"

#. Occurrence 1_5:1448:908: scene=1_5
#: 1_5:1448
msgctxt "text_id=908 | speaker=unknown"
msgid "  The girl was one of the haunted house's two residents."
msgstr "　この少女こそ、幽霊屋敷に住む二人のうちの一人。"

#. Occurrence 1_5:1453:909: scene=1_5
#: 1_5:1453
msgctxt "text_id=909 | speaker=unknown"
msgid "  Her name was Alice Kuonji, and she was the same age as Aoko."
msgstr "　<久遠寺|くおんじ><有珠|アリス>という名前の、青子と同い年の同居人。"

#. Occurrence 1_5:1499:910: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0007; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1499
msgctxt "text_id=910 | speaker=aoko"
msgid "\"How long was I asleep?\""
msgstr "「私、どれくらい寝てた？」"

#. Occurrence 1_5:1507:911: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0001; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:1507
msgctxt "text_id=911 | speaker=alice"
msgid "\"At least an hour. You'll catch a cold if you keep sleeping here.\""
msgstr "「一時間と少し。……ここで眠ると風邪、ひくわよ」"

#. Occurrence 1_5:1527:912: scene=1_5
#: 1_5:1527
msgctxt "text_id=912 | speaker=unknown"
msgid "  Alice answered indifferently. Not that it bothered Aoko, who was now used to it."
msgstr "　有珠は関心なく答えるが、いつもの事なので青子は気にしない。"

#. Occurrence 1_5:1532:913: scene=1_5
#: 1_5:1532
msgctxt "text_id=913 | speaker=unknown"
msgid "  She looked at the clock on the wall and saw that it was already seven."
msgstr "　柱時計を見てみると、針は午後七時を回っていた。"

#. Occurrence 1_5:1537:914: scene=1_5
#: 1_5:1537
msgctxt "text_id=914 | speaker=unknown"
msgid "  She had been asleep for two hours."
msgstr "　二時間ほど眠っていた事になる。"

#. Occurrence 1_5:1542:915: scene=1_5
#: 1_5:1542
msgctxt "text_id=915 | speaker=unknown"
msgid "  The day had been a rough one for her, and she had slept little the night before, so it was no surprise that she had dozed off for as long as she had."
msgstr "　思い返せば散々な一日だった。徹夜明けで疲れた体が寝入ってしまったのも、無理のない話だろう。"

#. Occurrence 1_5:1576:916: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0008; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1576
msgctxt "text_id=916 | speaker=aoko"
msgid "\"You could have woken me up."
msgstr "「起こしてくれても良かったのに。"

#. Occurrence 1_5:1582:917: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0009; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1582
msgctxt "text_id=917 | speaker=aoko"
msgid "  Now my tea is cold.\""
msgstr "　せっかくの紅茶が冷めちゃったじゃない」"

#. Occurrence 1_5:1591:918: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0002; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:1591
msgctxt "text_id=918 | speaker=alice"
msgid "\"It was already cold by the time I got here.\""
msgstr "「わたしが来た時は、もう冷めてたわ」"

#. Occurrence 1_5:1597:919: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0010; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1597
msgctxt "text_id=919 | speaker=aoko"
msgid "\"I'm sure it was. I'm just saying...\""
msgstr "「でしょうね。言ってみただけよ」"

#. Occurrence 1_5:1628:920: scene=1_5
#: 1_5:1628
msgctxt "text_id=920 | speaker=unknown"
msgid "  Aoko drank down the rest of the cold tea in one gulp."
msgstr "　青子は冷めきった紅茶を一気に飲み下す。"

#. Occurrence 1_5:1633:921: scene=1_5
#: 1_5:1633
msgctxt "text_id=921 | speaker=unknown"
msgid "  In the poorly-heated Kuonji mansion, that was more than enough to clear her head and wake up."
msgstr "　暖房の乏しい久遠寺邸では、その冷たさだけでも寝惚けた頭を目覚めさせるには十分だった。"

#. Occurrence 1_5:1655:922: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0011; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1655
msgctxt "text_id=922 | speaker=aoko"
msgid "\"Nothing quite beats this tea, not even the expensive kind from Britain."
msgstr "「こうなるとフォートナム＆メイソンも何もないわね。"

#. Occurrence 1_5:1687:923: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0012; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1687
msgctxt "text_id=923 | speaker=aoko"
msgid "  Anyway, welcome home, Alice. The universe seems determined to keep me from even the occasional luxury without you."
msgstr "　おかえり、有珠。たまの贅沢もアンタ抜きじゃ<締|し>まらないってコトかしら。"

#. Occurrence 1_5:1693:924: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0013; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1693
msgctxt "text_id=924 | speaker=aoko"
msgid "  Ugh, what is it about today? Is it just my luck, or what? At this rate I'm due a temple visit, just to be safe.\""
msgstr "　今日は厄日か<天誅殺|てんちゅうさつ>か―――ちょっと早いけどお参りってのも十分アリかもね」"

#. Occurrence 1_5:1698:925: scene=1_5
#: 1_5:1698
msgctxt "text_id=925 | speaker=unknown"
msgid "  Aoko shrugged her shoulders as if resigning herself to her fate."
msgstr "　毒食わば皿まで的な玉砕精神で、と肩をすくめる青子。"

#. Occurrence 1_5:1736:926: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0003; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:1736
msgctxt "text_id=926 | speaker=alice"
msgid "\"Something happen?\""
msgstr "「それで、何があったの？」"

#. Occurrence 1_5:1757:927: scene=1_5
#: 1_5:1757
msgctxt "text_id=927 | speaker=unknown"
msgid "  After two years together, they knew each other quite well."
msgstr "　同居生活も二年近く続けば、お互いの様子に気が付くらしい。"

#. Occurrence 1_5:1762:928: scene=1_5
#: 1_5:1762
msgctxt "text_id=928 | speaker=unknown"
msgid "  Aoko had one way of asking questions,"
msgstr "　青子は青子なりの、"

#. Occurrence 1_5:1767:929: scene=1_5
#: 1_5:1767
msgctxt "text_id=929 | speaker=unknown"
msgid "  and Alice had another."
msgstr "　有珠は有珠なりの問いかけをする。"

#. Occurrence 1_5:1772:930: scene=1_5
#: 1_5:1772
msgctxt "text_id=930 | speaker=unknown"
msgid "  Alice asked without raising her head, and Aoko gave her the details."
msgstr "　顔もあげず問いかけてくる同居人に、青子はきっぱりと現状を報告した。"

#. Occurrence 1_5:1804:931: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0014; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1804
msgctxt "text_id=931 | speaker=aoko"
msgid "\"I should start by apologizing."
msgstr "「まず謝らなくちゃいけない。"

#. Occurrence 1_5:1810:932: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0015; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1810
msgctxt "text_id=932 | speaker=aoko"
msgid "  The project I was working on all night was a total failure. I only took my eyes off it for a second, but I think it boiled over and fell apart."
msgstr "　昨日徹夜で完成させた例のアレ、意味がなくなっちゃったのよ。ちょっと目を離した隙に沸騰しすぎて壊れちゃったみたい。"

#. Occurrence 1_5:1817:933: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0016; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1817
msgctxt "text_id=933 | speaker=aoko"
msgid "Though I'll add that I shuffled the circulation codes as a precaution.\""
msgstr "そうならないよう、循環のコードを二、三本外したり<縫合|ほうごう>したりしたんだけど」"

#. Occurrence 1_5:1844:934: scene=1_5
#: 1_5:1844
msgctxt "text_id=934 | speaker=unknown"
msgid "  Aoko tried to laugh it off as if it was someone else's problem."
msgstr "　いやー、まいったね、と他人ごとのように青子は言った。"

#. Occurrence 1_5:1882:935: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0004; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:1882
msgctxt "text_id=935 | speaker=alice"
msgid "\"...And?\""
msgstr "「……どういう事？」"

#. Occurrence 1_5:1900:936: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0017; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1900
msgctxt "text_id=936 | speaker=aoko"
msgid "\"Something came up this morning, and I was called into school."
msgstr "「<今|け><朝|さ>急用が入って、学校に呼び出しうけたの。"

#. Occurrence 1_5:1900:937: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0017; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1900
msgctxt "text_id=937 | speaker=aoko"
msgid "  They made me show this transfer student around, and it took up my whole day. By the time I got back, it had vanished without a trace."
msgstr "　そこで転入生の世話を押しつけられて、一日が無残にも消費されちゃって、帰ってきたら跡形もなく消えてました。"

#. Occurrence 1_5:1906:938: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0018; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1906
msgctxt "text_id=938 | speaker=aoko"
msgid "  You're not mad, are you?\""
msgstr "　怒る、有珠？」"

#. Occurrence 1_5:1947:939: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0005; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:1947
msgctxt "text_id=939 | speaker=alice"
msgid "\"...Hardly. If I got mad every time you broke something, there would be no end to the fighting."
msgstr "「……別に。青子の器物破損にいちいち怒っていたら、一生分の口論をする事になるでしょう？"

#. Occurrence 1_5:1953:940: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0006; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:1953
msgctxt "text_id=940 | speaker=alice"
msgid "  I have more materials, so you can just start over."
msgstr "　代用品はあるから、また一から始めればいいわ。"

#. Occurrence 1_5:1965:941: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0007; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:1965
msgctxt "text_id=941 | speaker=alice"
msgid "  However, aren't you really the one who's angry?\""
msgstr "　それより―――怒ってるのは貴方の方じゃないの？」"

#. Occurrence 1_5:2006:942: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0019; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2006
msgctxt "text_id=942 | speaker=aoko"
msgid "\"...Hmph.\""
msgstr "「……む」"

#. Occurrence 1_5:2012:943: scene=1_5
#: 1_5:2012
msgctxt "text_id=943 | speaker=unknown"
msgid "  Alice was very much on point today."
msgstr "　今日はいつになく<鋭|するど>い。"

#. Occurrence 1_5:2017:944: scene=1_5
#: 1_5:2017
msgctxt "text_id=944 | speaker=unknown"
msgid "  It was true that, despite outward appearances, Aoko was seething with frustration."
msgstr "　こういう時、涼しい顔をしてホントは怒っているのが青子なのだ。"

#. Occurrence 1_5:2022:945: scene=1_5
#: 1_5:2022
msgctxt "text_id=945 | speaker=unknown"
msgid "  That aside..."
msgstr "　それはともかく。"

#. Occurrence 1_5:2056:946: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0020; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2056
msgctxt "text_id=946 | speaker=aoko"
msgid "\"True enough. The transfer student I mentioned earlier was a real piece of work."
msgstr "「ええ。この転入生っていうのがひどくズレててね。"

#. Occurrence 1_5:2068:947: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0021; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2068
msgctxt "text_id=947 | speaker=aoko"
msgid "  He's been living deep in the mountains and has literally zero common sense. I know people say that the mountains are like an entirely different world, but I had no idea how true it was, Alice.\""
msgstr "　すごい山奥で暮らしてたらしくて、こっちの常識が通じないんだから。<山門異界|さんもんいかい>って言葉があるけど、あれってホントの事なのね、有珠」"

#. Occurrence 1_5:2090:948: scene=1_5
#: 1_5:2090
msgctxt "text_id=948 | speaker=unknown"
msgid "  Alice raised her head in response to hearing her name,"
msgstr "　名前を呼ばれて有珠は顔を上げた。"

#. Occurrence 1_5:2095:949: scene=1_5
#: 1_5:2095
msgctxt "text_id=949 | speaker=unknown"
msgid "  but Aoko kept going on before she could get a word in edgewise. Aoko, after all, expected no sympathy in the first place."
msgstr "　もともと有珠からの同情なんて期待していない青子は、さらに口調を速めて愚痴をこぼす。"

#. Occurrence 1_5:2130:950: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0022; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2130
msgctxt "text_id=950 | speaker=aoko"
msgid "\"We didn't get along well from the start, but things really took a turn for the worse when I took him to a classroom."
msgstr "「初対面から癪に障るヤツだったけど、教室を案内した時なんか失神しそうになったわ。"

#. Occurrence 1_5:2136:951: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0023; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2136
msgctxt "text_id=951 | speaker=aoko"
msgid "  He apparently thought it was a place where you'd get one-on-one tutoring. And that's not all... I mean, you're never gonna believe this...\""
msgstr "　そいつ、教室で教師と一対一で授業を受けるもんだと思ってたらしいの。……ええ、それはそれでまだ流せる。許容範囲よ、あの程度の冗談は」"

#. Occurrence 1_5:2165:952: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0024; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2165
msgctxt "text_id=952 | speaker=aoko"
msgid "\"What do you think he asked when I politely explained what a classroom is to him?"
msgstr "「で、私が簡潔かつ丁寧に教室のなんたるかを教えた後で、そいつなんて言ったと思う？"

#. Occurrence 1_5:2174:953: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0025; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2174
msgctxt "text_id=953 | speaker=aoko"
msgid "  He goes, 'but then what are the other classrooms for?'"
msgstr "『それで蒼崎。他の教室は何に使うんだ？』"

#. Occurrence 1_5:2186:954: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0026; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2186
msgctxt "text_id=954 | speaker=aoko"
msgid "  Unbelievable, right!?"
msgstr "　ですって！"

#. Occurrence 1_5:2192:955: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0027; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2192
msgctxt "text_id=955 | speaker=aoko"
msgid "  I mean, a classroom is a classroom!\""
msgstr "　教室に他も何もないでしょう？」"

#. Occurrence 1_5:2219:956: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0028; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2219
msgctxt "text_id=956 | speaker=aoko"
msgid "\"And no matter how vague or unhelpful anything I said was, he just kept nodding."
msgstr "「なんていうか、そいつは少しでも説明を怠るとそのままで納得しちゃうのよ。"

#. Occurrence 1_5:2225:957: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0029; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2225
msgctxt "text_id=957 | speaker=aoko"
msgid "  It's like he was just taking everything at face value. I don't know if he just lacks an imagination or never uses it."
msgstr "　何も疑問に思わないというか、想像力が欠如してるっていうか、想像する事に慣れてないっていうか。"

#. Occurrence 1_5:2245:958: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0030; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2245
msgctxt "text_id=958 | speaker=aoko"
msgid "  Anyway... he at least seemed to grasp most of what I told him the first time around, so I suppose he's not a complete idiot.\""
msgstr "　まあ……一度言った事はちゃんと分かってるっぽいから、馬鹿ってワケじゃないんだけど……」"

#. Occurrence 1_5:2270:959: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0008; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:2270
msgctxt "text_id=959 | speaker=alice"
msgid "\"It's rare to see you so judgmental."
msgstr "「貴方が人を批評するのは珍しいわね。"

#. Occurrence 1_5:2270:960: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0008; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:2270
msgctxt "text_id=960 | speaker=alice"
msgid "  Is it really worth getting worked up over someone like that?\""
msgstr "　……そういうダメな人、気にする<質|たち>だったの？」"

#. Occurrence 1_5:2279:961: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0031; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2279
msgctxt "text_id=961 | speaker=aoko"
msgid "\"I couldn't care less about him. I'm just worried he'll screw up somehow.\""
msgstr "「<微塵|みじん>たりとも気にしないわよ。けど、明日からどんな間違いをしでかすのかちょっと心配なだけ」"

#. Occurrence 1_5:2299:962: scene=1_5
#: 1_5:2299
msgctxt "text_id=962 | speaker=unknown"
msgid "  What she was really worried about was having to clean up that mess if and when it happened."
msgstr "　そう。心配なのは、その間違いの後始末が高い確率で自分に回ってくるからに違いない。"

#. Occurrence 1_5:2320:963: scene=1_5
#: 1_5:2320
msgctxt "text_id=963 | speaker=unknown"
msgid "  That had to be it."
msgstr "　たぶん、そうだと思う。"

#. Occurrence 1_5:2325:964: scene=1_5
#: 1_5:2325
msgctxt "text_id=964 | speaker=unknown"
msgid "  If not, it would mean she had no real idea why she could not get him out of his head."
msgstr "　そうでもなければ、今日一日を潰してくれた転入生を気に病む理由が見当たらない。"

#. Occurrence 1_5:2358:965: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0032; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2358
msgctxt "text_id=965 | speaker=aoko"
msgid "\"Well, he was a weirdo all right. You two would probably hit it off great.\""
msgstr "「とにかく変なヤツなの。案外有珠と気が合うかも」"

#. Occurrence 1_5:2376:966: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0009; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:2376
msgctxt "text_id=966 | speaker=alice"
msgid "\"Another world in the mountains doesn't sound so bad.\""
msgstr "「……山門異界はいい言葉ね」"

#. Occurrence 1_5:2393:967: scene=1_5
#: 1_5:2393
msgctxt "text_id=967 | speaker=unknown"
msgid "  But from her eyes it was clear that the question of whether they would get along was irrelevant, given that they would never meet in the first place."
msgstr "　けれど、その人物とは気が合う前に会う事もないでしょう、と視線だけで少女は語る。"

#. Occurrence 1_5:2398:968: scene=1_5
#: 1_5:2398
msgctxt "text_id=968 | speaker=unknown"
msgid "  Aoko gave a noncommittal response."
msgstr "　それに青子はでしょうね、とだけ答えた。"

#. Occurrence 1_5:2444:969: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0033; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2444
msgctxt "text_id=969 | speaker=aoko"
msgid "\"Anyway, what have you been reading?\""
msgstr "「ところで有珠、さっきからなに読んでるの？」"

#. Occurrence 1_5:2450:970: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0010; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:2450
msgctxt "text_id=970 | speaker=alice"
msgid "\"A book about spiritual evolution based on The Spiritual Diary.\""
msgstr "「霊的進化論の二次創作。スピリチュアル・ダイアリのまがい物」"

#. Occurrence 1_5:2468:971: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0034; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2468
msgctxt "text_id=971 | speaker=aoko"
msgid "\"Ah, Swedenborg, huh? Is that really worth reading again?\""
msgstr "「ああ、スウェーデンボリ。そんなの、いまさら読んでも仕方ないんじゃない？」"

#. Occurrence 1_5:2497:972: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0011; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:2497
msgctxt "text_id=972 | speaker=alice"
msgid "\"I wouldn't bother if it were the original, but this is a knock-off."
msgstr "「真書なら退屈だけど、これは偽書だから。"

#. Occurrence 1_5:2503:973: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0012; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:2503
msgctxt "text_id=973 | speaker=alice"
msgid "  It exaggerates the pros and cons of Swedenborg's style and reads like a well-written adventure. Having the secret organization Kant standing in his way was a nice addition."
msgstr "　彼の欠点と長所を劇的に誉めあげている。よくできた冒険小説のようよ。立ちはだかる秘密組織の名前がカントとか、気が利いているわ。"

#. Occurrence 1_5:2509:974: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0013; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:2509
msgctxt "text_id=974 | speaker=alice"
msgid "  ...The handwriting of the notes in the margin belongs to your grandfather, by the way.\""
msgstr "　……筆跡は、あなたのお祖父さんのものだけど」"

#. Occurrence 1_5:2540:975: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0035; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2540
msgctxt "text_id=975 | speaker=aoko"
msgid "\"Huh, I had no idea he was into that sort of thing."
msgstr "「……へえ、あの人そういう趣味まであったんだ。"

#. Occurrence 1_5:2540:976: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0035; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2540
msgctxt "text_id=976 | speaker=aoko"
msgid "  He had a great sense of humor. I really miss him.\""
msgstr "　わりとユーモアがあったのね。惜しい人をなくしたわ」"

#. Occurrence 1_5:2557:977: scene=1_5
#: 1_5:2557
msgctxt "text_id=977 | speaker=unknown"
msgid "  Aoko seemed nostalgic over her now-deceased grandfather."
msgstr "　もうこの世にいない祖父を懐かしむように青子。"

#. Occurrence 1_5:2580:978: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0014; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:2580
msgctxt "text_id=978 | speaker=alice"
msgid "\"He just contacted you this last summer, didn't he?\""
msgstr "「あなたのお祖父さん、夏に便りをくれたけど」"

#. Occurrence 1_5:2588:979: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0036; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2588
msgctxt "text_id=979 | speaker=aoko"
msgid "\"Do we really have to go there? Why can't dead stay dead?\""
msgstr "「よしてよ、死んだものと考えたいのに」"

#. Occurrence 1_5:2625:980: scene=1_5
#: 1_5:2625
msgctxt "text_id=980 | speaker=unknown"
msgid "  Aoko sighed and laid back on the sofa."
msgstr "　ふう、とため息をついて、青子はソファーに思いっきり寄り掛かった。"

#. Occurrence 1_5:2630:981: scene=1_5
#: 1_5:2630
msgctxt "text_id=981 | speaker=unknown"
msgid "  The soft cushions caved in under her weight."
msgstr "　クッションにガタがきているのか、背もたれと一緒に青子は床に寝そべる形になる。"

#. Occurrence 1_5:2660:982: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0015; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:2660
msgctxt "text_id=982 | speaker=alice"
msgid "\"As I was saying...\""
msgstr "「……話は戻るけど」"

#. Occurrence 1_5:2670:983: scene=1_5
#: 1_5:2670
msgctxt "text_id=983 | speaker=unknown"
msgid "  Alice shot a glance at Aoko."
msgstr "　寝そべっている青子に、有珠はちらりと視線を投げた。"

#. Occurrence 1_5:2675:984: scene=1_5
#: 1_5:2675
msgctxt "text_id=984 | speaker=unknown"
msgid "  Her body, buried in the sofa, remained as still as a corpse."
msgstr "　ソファーに埋もれた青子の体は、横臥したまま死体のように動かない。"

#. Occurrence 1_5:2695:985: scene=1_5
#: 1_5:2695
msgctxt "text_id=985 | speaker=unknown"
msgid "  It was clear Aoko had tuned out of the conversation."
msgstr "　ソファーに寝そべった青子の心境は、少し乾いていた。"

#. Occurrence 1_5:2715:986: scene=1_5
#: 1_5:2715
msgctxt "text_id=986 | speaker=unknown"
msgid "  Alice silently chastised her with a look."
msgstr "　有珠は無言で<青子|じぶん>を責めている。"

#. Occurrence 1_5:2720:987: scene=1_5
#: 1_5:2720
msgctxt "text_id=987 | speaker=unknown"
msgid "  The more she thought about it, the less important the events of the day seemed to become."
msgstr "　それを思うと今日一日の新鮮な出来事も、次第に<瑞々|みずみず>しさを失っていく。"

#. Occurrence 1_5:2753:988: scene=1_5
#: 1_5:2753
msgctxt "text_id=988 | speaker=unknown"
msgid "  If she just ignored Alice, the conversation would end there."
msgstr "　……有珠の無言の責めを無視すれば、話はここで終わってくれる。"

#. Occurrence 1_5:2758:989: scene=1_5
#: 1_5:2758
msgctxt "text_id=989 | speaker=unknown"
msgid "  They would eventually get up and leave today's mistake unresolved for another day."
msgstr "　ふたりはこのまま席を立ち、今日のミスをうやむやにしたまま明日を迎えられるだろう。"

#. Occurrence 1_5:2764:990: scene=1_5
#: 1_5:2764
msgctxt "text_id=990 | speaker=unknown"
msgid "  However..."
msgstr "　しかし。"

msgctxt "text_id=991 | speaker=unknown"
msgid " That's not the kind of person Aoko Aozaki was."
msgstr "蒼崎青子は、そういう真似ができない人間だ。"

#. Occurrence 1_5:2798:992: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0037; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2798
msgctxt "text_id=992 | speaker=aoko"
msgid "\"Yeah. What is it?\""
msgstr "「いいわよ、なに？」"

#. Occurrence 1_5:2803:993: scene=1_5
#: 1_5:2803
msgctxt "text_id=993 | speaker=unknown"
msgid "  She asked still lying down."
msgstr "　青子は倒れこんだまま有珠に問う。"

#. Occurrence 1_5:2811:994: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0016; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:2811
msgctxt "text_id=994 | speaker=alice"
msgid "\"It's upsetting that you failed today.\""
msgstr "「今日できなかったのは、少し痛いわね」"

#. Occurrence 1_5:2817:995: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0038; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2817
msgctxt "text_id=995 | speaker=aoko"
msgid "\"Like I said, I'm thinking about it."
msgstr "「だから反省してるって。"

#. Occurrence 1_5:2817:996: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0038; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2817
msgctxt "text_id=996 | speaker=aoko"
msgid "  I need to focus on becoming a full-fledged mage before thinking about school, I know that.\""
msgstr "　学校優先は一人前になってから、でしょ」"

#. Occurrence 1_5:2837:997: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0017; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:2837
msgctxt "text_id=997 | speaker=alice"
msgid "\"I hope you do.\""
msgstr "「なら、いいけど」"

#. Occurrence 1_5:2843:998: scene=1_5
#: 1_5:2843
msgctxt "text_id=998 | speaker=unknown"
msgid "  The coldness in her voice made Aoko gnash her teeth."
msgstr "　無機質な有珠の声に、青子はぎり、と歯を噛んだ。"

#. Occurrence 1_5:2876:999: scene=1_5
#: 1_5:2876
msgctxt "text_id=999 | speaker=unknown"
msgid "  She knew what Alice wanted to say."
msgstr "　彼女の言いたい事は分かっている。"

#. Occurrence 1_5:2892:1000: scene=1_5
#: 1_5:2892
msgctxt "text_id=1000 | speaker=unknown"
msgid "  She knew better than anyone."
msgstr "　なにより青子自身がよく分かっている。"

#. Occurrence 1_5:2907:1001: scene=1_5
#: 1_5:2907
msgctxt "text_id=1001 | speaker=unknown"
msgid "  The veneer she wore for school was different than the way she lived at home."
msgstr "　学園生活の<外面|そとづら>と、今の生き方との折り合い。"

#. Occurrence 1_5:2929:1002: scene=1_5
#: 1_5:2929
msgctxt "text_id=1002 | speaker=unknown"
msgid "  While it could be called hiding in plain sight, Alice thought it was silly."
msgstr "　現代に隠れ住むというけれど、その隠れ方が半端だと有珠は言っている。"

#. Occurrence 1_5:2946:1003: scene=1_5
#: 1_5:2946
msgctxt "text_id=1003 | speaker=unknown"
msgid "  And what the silence told her was..."
msgstr "　つまり、彼女の沈黙が語るところは―――"

#. Occurrence 1_5:2980:1004: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0039; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2980
msgctxt "text_id=1004 | speaker=aoko"
msgid "('Make up your mind already,' I know.)"
msgstr "『……覚悟を決めろって言いたいのよね、あんたは』"

#. Occurrence 1_5:3001:1005: scene=1_5
#: 1_5:3001
msgctxt "text_id=1005 | speaker=unknown"
msgid "  Today's failure was not a colossal one."
msgstr "　今日の失敗はそれほど大きいものじゃない。"

#. Occurrence 1_5:3006:1006: scene=1_5
#: 1_5:3006
msgctxt "text_id=1006 | speaker=unknown"
msgid "  She'd just happened to upset the delicate balance between her home and school lives, chasing one at the expense of the other."
msgstr "　この洋館と学園生活を秤にかけて、たまたま学園に重きをおいてミスをしただけの、小さな事件だ。"

#. Occurrence 1_5:3011:1007: scene=1_5
#: 1_5:3011
msgctxt "text_id=1007 | speaker=unknown"
msgid "  And yet, that careless mistake was a clear sign of Aoko's lack of commitment."
msgstr "　ただ、今の青子の半端さを象徴する、分かりやすい心の甘さであっただけ。"

#. Occurrence 1_5:3049:1008: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0040; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:3049
msgctxt "text_id=1008 | speaker=aoko"
msgid "(This doesn't concern Alice."
msgstr "『……有珠は関係ない。"

#. Occurrence 1_5:3049:1009: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0040; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:3049
msgctxt "text_id=1009 | speaker=aoko"
msgid "  It's my decision to make.)"
msgstr "　これは、私が私で決めなくちゃいけない事……』"

#. Occurrence 1_5:3096:1010: scene=1_5
#: 1_5:3096
msgctxt "text_id=1010 | speaker=unknown"
msgid "  She had only known for sure for the last year and a half."
msgstr "　基礎はたった一年と半年。"

#. Occurrence 1_5:3101:1011: scene=1_5
#: 1_5:3101
msgctxt "text_id=1011 | speaker=unknown"
msgid "  But she'd had a hunch for as long as she could remember:"
msgstr "　けれど予感は物心がついた時からあった。"

#. Occurrence 1_5:3107:1012: scene=1_5
#: 1_5:3107
msgctxt "text_id=1012 | speaker=unknown"
msgid "\"Make the choice, and the day will come.\""
msgstr "“選んだのなら、いつか必ずその日は来る”、と。"

#. Occurrence 1_5:3113:1013: scene=1_5
#: 1_5:3113
msgctxt "text_id=1013 | speaker=unknown"
msgid "  It was little wonder that her morals and conscience had been stripped away."
msgstr "　なら自分の良心も道徳も、いいかげん根負けしている頃だ。"

#. Occurrence 1_5:3121:1014: scene=1_5
#: 1_5:3121
msgctxt "text_id=1014 | speaker=unknown"
msgid "  Aoko pushed herself back up."
msgstr "　よし、と青子は勢いよく体を起こす。"

#. Occurrence 1_5:3126:1015: scene=1_5
#: 1_5:3126
msgctxt "text_id=1015 | speaker=unknown"
msgid "  She was met by Alice's cold beauty and wordless gaze."
msgstr "　起きた先には、無言で視線を向ける有珠のか細い美貌だけがあった。"

#. Occurrence 1_5:3162:1016: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0041; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:3162
msgctxt "text_id=1016 | speaker=aoko"
msgid "\"Okay, Alice. We can do it next week."
msgstr "「オッケー、有珠。来週中に決着をつけよう。"

#. Occurrence 1_5:3168:1017: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0042; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:3168
msgctxt "text_id=1017 | speaker=aoko"
msgid "  That work for you?\""
msgstr "　それでいいんでしょ？」"

#. Occurrence 1_5:3187:1018: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0018; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:3187
msgctxt "text_id=1018 | speaker=alice"
msgid "\"As long as it works for you.\""
msgstr "「ええ。青子がいいなら」"

#. Occurrence 1_5:3204:1019: scene=1_5
#: 1_5:3204
msgctxt "text_id=1019 | speaker=unknown"
msgid "  Aoko could not help but shake her head, feeling like she was hearing something similar for the second time that day."
msgstr "　それと似たような言葉をつい数時間前に聞いた気がして、ブンブンと頭を振る。"

#. Occurrence 1_5:3233:1020: scene=1_5
#: 1_5:3233
msgctxt "text_id=1020 | speaker=unknown"
msgid "  Even in the comfort of her own, she couldn't banish thoughts of that country boy from her mind."
msgstr "　なんだって帰ってきてまで、あんな田舎者を思い出さなくちゃいけないのか。"

#. Occurrence 1_5:3270:1021: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0043; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:3270
msgctxt "text_id=1021 | speaker=aoko"
msgid "\"I'll let you set it up, then. That's still beyond my abilities.\""
msgstr "「じゃあ下準備はよろしくね。私まだ出来ないし」"

#. Occurrence 1_5:3284:1022: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0019; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:3284
msgctxt "text_id=1022 | speaker=alice"
msgid "\"Should we do it at that park?\""
msgstr "「場所は例の公園でいい？」"

#. Occurrence 1_5:3315:1023: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0044; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:3315
msgctxt "text_id=1023 | speaker=aoko"
msgid "\"Sure. The line there is suitable enough. But what about that other thing?"
msgstr "「妥当な線ね。あ、でももう一件の方は？"

#. Occurrence 1_5:3321:1024: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0045; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:3321
msgctxt "text_id=1024 | speaker=aoko"
msgid "  Isn't that a more urgent concern?\""
msgstr "　そっちの方が急務じゃない？」"

#. Occurrence 1_5:3337:1025: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0020; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:3337
msgctxt "text_id=1025 | speaker=alice"
msgid "\"It depends on the conditions. I'll let you know if there are any changes to the woods.\""
msgstr "「時と場合。森に変化があれば教えるわ」"

#. Occurrence 1_5:3364:1026: scene=1_5
#: 1_5:3364
msgctxt "text_id=1026 | speaker=unknown"
msgid "  After that brief exchange, Alice returned her attention to the book on her lap."
msgstr "　そんな短いやりとりが終わると、有珠は膝に置いた本へと顔を落とした。"

#. Occurrence 1_5:3371:1027: scene=1_5
#: 1_5:3371
msgctxt "text_id=1027 | speaker=unknown"
msgid "  Shop talk was over."
msgstr "　両者にとって最も重要な話は終わった。"

#. Occurrence 1_5:3376:1028: scene=1_5
#: 1_5:3376
msgctxt "text_id=1028 | speaker=unknown"
msgid "  Now, they could return to their normal relationship as roommates."
msgstr "　あとは普段通りの、それとなく気が合う同居人に戻るだけである。"

#. Occurrence 1_5:3400:1029: scene=1_5
#: 1_5:3400
msgctxt "text_id=1029 | speaker=unknown"
msgid "  Aoko grabbed the remote and turned on the TV. Since Alice was busy reading, Aoko decided to tune in to a variety show that had already started."
msgstr "　さて、とばかりに青子はテレビのリモコンを取って電源を入れた。有珠が読書しているので、自分はブラウン管に映る<出来事|バラエティー>に途中参加しようとし、"

#. Occurrence 1_5:3447:1030: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0021; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:3447
msgctxt "text_id=1030 | speaker=alice"
msgid "\"Ahh-\""
msgstr "「あ」"

#. Occurrence 1_5:3482:1031: scene=1_5
#: 1_5:3482
msgctxt "text_id=1031 | speaker=unknown"
msgid "  Alice started to speak but suddenly cut herself off."
msgstr "　突然、有珠がそんな声を上げて、消した。"

#. Occurrence 1_5:3509:1032: scene=1_5
#: 1_5:3509
msgctxt "text_id=1032 | speaker=unknown"
msgid "  One of her delicate hands raised to her mouth."
msgstr "　見れば片手で口を押さえている。"

#. Occurrence 1_5:3514:1033: scene=1_5
#: 1_5:3514
msgctxt "text_id=1033 | speaker=unknown"
msgid "  She would always cut herself off the second she realized she was about to say something trivial."
msgstr "　何かを話そうとして、それが意味の無い話だと気付くと彼女はすぐに口を閉ざしてしまう。"

#. Occurrence 1_5:3545:1034: scene=1_5
#: 1_5:3545
msgctxt "text_id=1034 | speaker=unknown"
msgid "  Sometimes, her self-restraint would hit too late, and she would make a gesture like the one she was making now."
msgstr "　時々その自制が間に合わなくて、今のような仕草をする事が<希|まれ>にある。"

#. Occurrence 1_5:3550:1035: scene=1_5
#: 1_5:3550
msgctxt "text_id=1035 | speaker=unknown"
msgid "  It occurred to Aoko that the \"ah\" sound her cute little roommate made just now was different than the \"wha\" she blurted in times past."
msgstr "　たしか、前は『な』だったな、と思い返しながら、青子は可憐な同居人に視線を向けた。"

#. Occurrence 1_5:3628:1036: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0046; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:3628
msgctxt "text_id=1036 | speaker=aoko"
msgid "\"Hm? What is it?\""
msgstr "「ん、なに？」"

#. Occurrence 1_5:3633:1037: scene=1_5
#: 1_5:3633
msgctxt "text_id=1037 | speaker=unknown"
msgid "  Aoko turned down the volume on the TV, her intense eyes lit up like those of a mischievous cat."
msgstr "　テレビの音量を下げる青子。意志の強い目が、猫のようにいたずらっぽい光を放っていた。"

#. Occurrence 1_5:3639:1038: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0022; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:3639
msgctxt "text_id=1038 | speaker=alice"
msgid "\"It's nothing really, but...\""
msgstr "「……どうという事はないんだけど」"

#. Occurrence 1_5:3704:1039: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0047; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:3704
msgctxt "text_id=1039 | speaker=aoko"
msgid "\"But what?\""
msgstr "「ないんだけど？」"

#. Occurrence 1_5:3750:1040: scene=1_5
#: 1_5:3750
msgctxt "text_id=1040 | speaker=unknown"
msgid "  Alice looked away bashfully, not knowing if she should bring it up or not."
msgstr "　有珠は言おうか言うまいか迷っていて、恥ずかしそうにそっぽを向いている。"

#. Occurrence 1_5:3755:1041: scene=1_5
#: 1_5:3755
msgctxt "text_id=1041 | speaker=unknown"
msgid "  It was times like these that her expression carried a real warmth and surprising charm."
msgstr "　こういった時の彼女の表情は温かみがあって、なんだか歯痒いぐらい好感が持てた。"

#. Occurrence 1_5:3760:1042: scene=1_5
#: 1_5:3760
msgctxt "text_id=1042 | speaker=unknown"
msgid "  If he could see her in this moment, Alice's father would have to admit that her name suited her perfectly."
msgstr "　たぶん今の有珠を見れば彼女の父親も、その名前がぴったり似合っていたと思えるだろうに。"

#. Occurrence 1_5:3785:1043: scene=1_5
#: 1_5:3785
msgctxt "text_id=1043 | speaker=unknown"
msgid "\"..."
msgstr "「……"

#. Occurrence 1_5:3792:1044: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0023; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:3792
msgctxt "text_id=1044 | speaker=alice"
msgid "It's just that I saw something strange on my way home and wanted to tell someone about it.\""
msgstr "今日、帰ってくる時おかしな物を見て、誰かに話そうと思っていたんだけど……」"

#. Occurrence 1_5:3798:1045: scene=1_5
#: 1_5:3798
msgctxt "text_id=1045 | speaker=unknown"
msgid "  Aoko nodded, beckoning her to continue."
msgstr "　青子はうん、と頷いて先を促す。"

#. Occurrence 1_5:3840:1046: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0024; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:3840
msgctxt "text_id=1046 | speaker=alice"
msgid "\"It's silly, really."
msgstr "「つまらない、本当に意味のないコトよ。"

#. Occurrence 1_5:3846:1047: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0025; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:3846
msgctxt "text_id=1047 | speaker=alice"
msgid "  But I just can't make sense of it no matter how much I think about it."
msgstr "　けど、どう考えてもそんな事をする理由が分からない。"

#. Occurrence 1_5:3852:1048: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0026; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:3852
msgctxt "text_id=1048 | speaker=alice"
msgid "  Aoko... Do you have any idea why a man-sized cat... would be riding around town... delivering meals to people?\""
msgstr "　……青子、人間ぐらいの大きな猫が、ひょこひょこ出前をする理由って、分かる？」"

#. Occurrence 1_5:3885:1049: scene=1_5
#: 1_5:3885
msgctxt "text_id=1049 | speaker=unknown"
msgid "  For a second, Aoko thought Alice was trying and failing miserably to make a joke again."
msgstr "　一瞬、青子はまた、有珠の冗談になっていない冗談のたぐいだと思った。"

#. Occurrence 1_5:3890:1050: scene=1_5
#: 1_5:3890
msgctxt "text_id=1050 | speaker=unknown"
msgid "  One would think that about anyone, really."
msgstr "　いや、普通は思う。"

#. Occurrence 1_5:3895:1051: scene=1_5
#: 1_5:3895
msgctxt "text_id=1051 | speaker=unknown"
msgid "  But she seemed completely serious."
msgstr "　けれど有珠は真剣に悩んでいる。"

#. Occurrence 1_5:3900:1052: scene=1_5
#: 1_5:3900
msgctxt "text_id=1052 | speaker=unknown"
msgid "  Even if Alice's sense of humor fell flat for Aoko, this story already sounded more fanciful than Alice's usual attempt at jokes. Aoko concluded that her roommate was talking about something she had actually seen."
msgstr "　有珠のユーモアセンスに零点をつけたのは青子だが、これは零点にしてはわりとロマンがあるので、やっぱり有珠は見たままの事を話しているらしい。"

#. Occurrence 1_5:3937:1053: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0048; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:3937
msgctxt "text_id=1053 | speaker=aoko"
msgid "\"Hmm. There are a few things off about that. Maybe we should break it down.\""
msgstr "「んー……その話にはふたつぐらい信じがたい部分があるけど、ひとつずつ論破していい……？」"

#. Occurrence 1_5:3943:1054: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0027; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:3943
msgctxt "text_id=1054 | speaker=alice"
msgid "\"Let's not. Even I can think of a few mundane explanations."
msgstr "「いいの。わたしもカラクリぐらいは思いつくから。"

#. Occurrence 1_5:3949:1055: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0028; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:3949
msgctxt "text_id=1055 | speaker=alice"
msgid "  I'm just asking because I can't figure out why somebody would do that."
msgstr "　ただ、理由が分からないから聞いてるの。"

#. Occurrence 1_5:3949:1056: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0028; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:3949
msgctxt "text_id=1056 | speaker=alice"
msgid "  Maybe it's as simple as someone just dressing up in a finely-crafted cat suit to deliver food for a restaurant?\""
msgstr "　わざわざ精巧な猫のぬいぐるみを着て、出前の<店屋物|てんやもの>を届けに行く事って、そんなに簡単かしらね」"

#. Occurrence 1_5:3982:1057: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0049; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:3982
msgctxt "text_id=1057 | speaker=aoko"
msgid "\"I'm more worried about the person doing it than their reasons, personally.\""
msgstr "「難易度以前に、それをやる人間の常識性を疑うけどね、私は」"

#. Occurrence 1_5:3988:1058: scene=1_5
#: 1_5:3988
msgctxt "text_id=1058 | speaker=unknown"
msgid "  Alice nodded tentatively at her words."
msgstr "　青子の言葉に、有珠も少し頷く。"

#. Occurrence 1_5:4009:1059: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0050; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4009
msgctxt "text_id=1059 | speaker=aoko"
msgid "\"But whatever does it for them, I guess. In a world with people like us and weirdos that live like mountain hermits, there's no telling what kinds of freaks are out there."
msgstr "「まあ、世の中色々あるから。私達みたいのもいれば、外界から遮断された山奥で暮らしていた奴まで十人十色よ。"

#. Occurrence 1_5:4015:1060: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0051; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4015
msgctxt "text_id=1060 | speaker=aoko"
msgid "  I personally would have just gone up to them and asked them what they were doing.\""
msgstr "　私だったら、見かけたら声かけて理由を<訊|たず>ねただろうけど」"

#. Occurrence 1_5:4041:1061: scene=1_5
#: 1_5:4041
msgctxt "text_id=1061 | speaker=unknown"
msgid "  Alice's gaze drifted at that."
msgstr "　その言葉に、有珠は少しだけ顔を背けた。"

#. Occurrence 1_5:4080:1062: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0052; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4080
msgctxt "text_id=1062 | speaker=aoko"
msgid "\"Hmm... A delivery cat riding through neighborhoods in the evening. Sounds like something straight out of a fantasy story."
msgstr "「……ふーん……暮れゆく住宅街にさまよう<出前猫|でまえねこ>かあ……背景が夕焼けだったらファンタジーだったでしょうに。"

#. Occurrence 1_5:4086:1063: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0053; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4086
msgctxt "text_id=1063 | speaker=aoko"
msgid "  ...Hey, what should we do for dinner tonight?"
msgstr "　……で、今日の夕飯どうする？"

#. Occurrence 1_5:4086:1064: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0053; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4086
msgctxt "text_id=1064 | speaker=aoko"
msgid "  Speaking of delivery, maybe we should order in.\""
msgstr "　せっかく話が出たし、私らも<店屋物|てんやもの>にしようか？」"

#. Occurrence 1_5:4119:1065: scene=1_5
#: 1_5:4119
msgctxt "text_id=1065 | speaker=unknown"
msgid "  Aoko loved getting takeout, and her faced glowed as she spoke."
msgstr "　出前好きな青子は嬉々として言う。"

#. Occurrence 1_5:4124:1066: scene=1_5
#: 1_5:4124
msgctxt "text_id=1066 | speaker=unknown"
msgid "  They had no hard rules for dinner, but if one of them was in the mood to cook, they made it a point to make enough for two."
msgstr "　この館において夕食は当番制でもなんでもなく、気が向いたほうが二人分用意する、という実にアバウトな方式が採用されていた。"

#. Occurrence 1_5:4129:1067: scene=1_5
#: 1_5:4129
msgctxt "text_id=1067 | speaker=unknown"
msgid "  At the very worst, this meant entire weeks without dinner, but the two of them agreed that this was the system that worked best for them."
msgstr "　下手をすると一週間夕飯なしが続くという展開もあるが、ふたりにとってはこれが一番居心地が良いのだ。"

#. Occurrence 1_5:4161:1068: scene=1_5
#: 1_5:4161
msgctxt "text_id=1068 | speaker=unknown"
msgid "  Whether they found cooking to be too much effort or simply liked ordering out..."
msgstr "　調理の手間を惜しんでか、それとも単純に出前が好きなのか。"

#. Occurrence 1_5:4166:1069: scene=1_5
#: 1_5:4166
msgctxt "text_id=1069 | speaker=unknown"
msgid "  Nights like this one were a common occurrence, much to the chagrin of the restaurants of Misaki Town."
msgstr "　今夜のような展開は珍しくもなく、結果、三咲町の食事処からこの館は要注意扱いされていた。"

#. Occurrence 1_5:4171:1070: scene=1_5
#: 1_5:4171
msgctxt "text_id=1070 | speaker=unknown"
msgid "  Delivering to the mansion meant coming all the way up to the top of this hill, the source of their disgruntlement."
msgstr "　決まって夜遅く……人気も絶えた夜八時過ぎ……に、こんな坂の上まで来いというのだから、彼らの憂鬱も当然である。"

#. Occurrence 1_5:4192:1071: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0054; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4192
msgctxt "text_id=1071 | speaker=aoko"
msgid "\"It's still before eight, so we're good. I'm really in the mood for Kongetsu tonight. I haven't had their tsukimi soba in ages.\""
msgstr "「時間は八時前、ぎりぎりセーフね。私<昏月|こんげつ>がいいな。あそこの月見そば、最近ご無沙汰だったし」"

#. Occurrence 1_5:4201:1072: scene=1_5
#: 1_5:4201
msgctxt "text_id=1072 | speaker=unknown"
msgid "  The hungry student council president laid out a stack of take-out menus like she might fan a deck of cards, and excitedly scanned for anything that stood out."
msgstr "　ポーカーのカードのように並べられた店々のお品書きを取り出し、まだ見ぬ夕食にご満悦の生徒会長。"

#. Occurrence 1_5:4207:1073: scene=1_5
#: 1_5:4207
msgctxt "text_id=1073 | speaker=unknown"
msgid "Alice casually responded without sparing so much as a glance."
msgstr "そんな、幸せそうな青子を一目も見ずに、有珠はさらりと返答する。"

#. Occurrence 1_5:4226:1074: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0029; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:4226
msgctxt "text_id=1074 | speaker=alice"
msgid "\"Sorry, but I've already had dinner.\""
msgstr "「悪いけど、わたし夕飯済んでるの」"

#. Occurrence 1_5:4273:1075: scene=1_5
#: 1_5:4273
msgctxt "text_id=1075 | speaker=unknown"
msgid "  With those words, Aoko froze."
msgstr "　その言葉で青子の体は凍りついた。"

#. Occurrence 1_5:4278:1076: scene=1_5
#: 1_5:4278
msgctxt "text_id=1076 | speaker=unknown"
msgid "  All deliveries required a minimum of two items, so she was out of luck without an accomplice."
msgstr "　出前物は最低二品、つまり共同者がいなければ運ばれないのだ。"

#. Occurrence 1_5:4283:1077: scene=1_5
#: 1_5:4283
msgctxt "text_id=1077 | speaker=unknown"
msgid "  Cruel society had decided it couldn't be bothered to deliver to a princess who only ordered a single serving of food."
msgstr "　たった一品の蕎麦で人を呼びつけるようなお姫さまに、世間は果てしなく冷たい。"

#. Occurrence 1_5:4318:1078: scene=1_5
#: 1_5:4318
msgctxt "text_id=1078 | speaker=unknown"
msgid "  Incidentally, to counteract orders from the hilltop mansion, the restaurants had declared,"
msgstr "　余談だが、実は坂の上対策として"

#. Occurrence 1_5:4324:1079: scene=1_5
#: 1_5:4324
msgctxt "text_id=1079 | speaker=unknown"
msgid "\"The minimum number of orders will be three, starting next year.\""
msgstr "『来年から三品以上の注文のみ出前アリとする』"

#. Occurrence 1_5:4330:1080: scene=1_5
#: 1_5:4330
msgctxt "text_id=1080 | speaker=unknown"
msgid "  Aoko and Alice were still in the dark to this fiendish change in direction."
msgstr "　なんて魔のルールが可決されつつある事を、青子たちはまだ知らない。"

#. Occurrence 1_5:4365:1081: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0055; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4365
msgctxt "text_id=1081 | speaker=aoko"
msgid "\"T-traitor!"
msgstr "「こ、この裏切り者…！"

#. Occurrence 1_5:4383:1082: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0056; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4383
msgctxt "text_id=1082 | speaker=aoko"
msgid "  Is that why you were late getting back!?"
msgstr "　ふん、だから帰ってくるのが遅かったのね!?"

#. Occurrence 1_5:4389:1083: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0057; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4389
msgctxt "text_id=1083 | speaker=aoko"
msgid "  Between the bus ride and the walk, the trip home takes only twenty minutes! I should have known something was up when you didn't get home before five o'clock!\""
msgstr "　帰宅部、学校までバス・徒歩込みで片道二十分のあんたが、なんで五時以降に帰ってくんのか考えるべきだったわ！」"

#. Occurrence 1_5:4395:1084: scene=1_5
#: 1_5:4395
msgctxt "text_id=1084 | speaker=unknown"
msgid "  Unfortunately for Aoko, she had been too out of it to even remember that she was the one who'd fallen asleep."
msgstr "　しかし悲しいかな、その時の青子は自分が眠った事にも気付かないほど寝惚けていたのだった。"

#. Occurrence 1_5:4422:1085: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0058; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4422
msgctxt "text_id=1085 | speaker=aoko"
msgid "\"Talk about ice queen-I thought it was clear that if either of us got food, we would bring enough home for the other person!"
msgstr "「あーあ、ひどい女。そういう時は残されたひとりのためにお土産買ってくるのが暗黙の了解だったのに。"

#. Occurrence 1_5:4428:1086: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0059; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4428
msgctxt "text_id=1086 | speaker=aoko"
msgid "  Didn't I bring back something for you when I ate out last time!?\""
msgstr "　私だって、この前の外食の時は有珠の分も買ってきたじゃない」"

#. Occurrence 1_5:4472:1087: scene=1_5
#: 1_5:4472
msgctxt "text_id=1087 | speaker=unknown"
msgid "  It was unknown how serious Aoko was being, but she was visibly angry."
msgstr "　どこまで本気なのか不明なのだけれど、青子はそれなりに怒っている。"

#. Occurrence 1_5:4477:1088: scene=1_5
#: 1_5:4477
msgctxt "text_id=1088 | speaker=unknown"
msgid "  She had already woken up hungry that morning, and from the time she was called into school until now, she had consumed nothing but tea. It was a small miracle that her stomach was not growling."
msgstr "　なにしろ朝は空腹で目が覚め、電話で呼び出されて以来、紅茶しか口にしていない。これでお<腹|なか>が鳴らないのは奇跡に近かった。"

#. Occurrence 1_5:4482:1089: scene=1_5
#: 1_5:4482
msgctxt "text_id=1089 | speaker=unknown"
msgid "  She knew it was her own fault, but she persisted, wanting to get revenge on Alice for scolding her earlier."
msgstr "　まあ、それはそれで自分が悪いとして、ついでに別件として、さっきいじめられた反撃とばかりに青子は一気にまくし立てて、"

#. Occurrence 1_5:4516:1090: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0030; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:4516
msgctxt "text_id=1090 | speaker=alice"
msgid "\"By 'last time' you mean..."
msgstr "「……この前ってアレの事？"

#. Occurrence 1_5:4522:1091: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0031; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:4522
msgctxt "text_id=1091 | speaker=alice"
msgid "  The time you went into the city and ate sushi but only came back with a plastic bag full of convenience store food? That time?\""
msgstr "　あなたが都心に出向いた時、夕食にお寿司を食べてきたのに、お土産はなぜかコンビニエンスストアのビニール袋だったって話？」"

#. Occurrence 1_5:4544:1092: scene=1_5
#: 1_5:4544
msgctxt "text_id=1092 | speaker=unknown"
msgid "  Aoko had kicked a hornet's nest."
msgstr "　<薮蛇|やぶへび>だった。"

#. Occurrence 1_5:4568:1093: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0060; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4568
msgctxt "text_id=1093 | speaker=aoko"
msgid "\"S-so what? It was better than nothing, wasn't it?\""
msgstr "「な、なによ、買ってこないよりはマシでしょう」"

#. Occurrence 1_5:4577:1094: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0032; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:4577
msgctxt "text_id=1094 | speaker=alice"
msgid "\"There are times when you'd be better off saying nothing at all.\""
msgstr "「真実は時に<隠蔽|いんぺい>すべきね」"

#. Occurrence 1_5:4623:1095: scene=1_5
#: 1_5:4623
msgctxt "text_id=1095 | speaker=unknown"
msgid "  Alice's icy gaze pierced right through her."
msgstr "　有珠の視線は冷たい。"

#. Occurrence 1_5:4678:1096: scene=1_5
#: 1_5:4678
msgctxt "text_id=1096 | speaker=unknown"
msgid "  Aoko had certainly crossed a line by going on and on about how the sushi circled around the restaurant while Alice ate her convenience store meal."
msgstr "　たしかに、あの時もくもくとコンビニ弁当を食べる有珠の横で回るお寿司の話をしたのは失敗だった。"

#. Occurrence 1_5:4683:1097: scene=1_5
#: 1_5:4683
msgctxt "text_id=1097 | speaker=unknown"
msgid "  But new things fascinated her, and she couldn't contain her curiosity towards the conveyer belt sushi shops that started popping up at the time. They were nothing short of miraculous."
msgstr "　だが新しい物好きの青子にとって、近頃オープンしだした『回転寿司屋』という驚異について考察する欲求は抑えられなかったのだ。"

#. Occurrence 1_5:4688:1098: scene=1_5
#: 1_5:4688
msgctxt "text_id=1098 | speaker=unknown"
msgid "  Even honesty can be a sin, given the right circumstances."
msgstr "　正直なのも場合によっては罪になる。"

#. Occurrence 1_5:4740:1099: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0061; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4740
msgctxt "text_id=1099 | speaker=aoko"
msgid "\"Fine. Fine, I get it. Does this at least mean we're even now?\""
msgstr "「……分かった。分かりました。じゃあ、今回のは前のと帳消しって事でいいわね？」"

#. Occurrence 1_5:4760:1100: scene=1_5
#: 1_5:4760
msgctxt "text_id=1100 | speaker=unknown"
msgid "  Alice went back to her book without so much as recognizing the question."
msgstr "　これといった否定の意を示さず、本に視線を戻す有珠。"

#. Occurrence 1_5:4765:1101: scene=1_5
#: 1_5:4765
msgctxt "text_id=1101 | speaker=unknown"
msgid "  The fact that she did not confirm it made Aoko anxious."
msgstr "　肯定の意も示さなかったのが少し怖い。"

#. Occurrence 1_5:4816:1102: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0062; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4816
msgctxt "text_id=1102 | speaker=aoko"
msgid "\"Well, today has been a total disaster."
msgstr "「仕方ない、今日は<厄日|やくび>だし。"

#. Occurrence 1_5:4816:1103: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0062; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4816
msgctxt "text_id=1103 | speaker=aoko"
msgid "  I guess I'll just whip up something in the kitchen.\""
msgstr "　大人しく台所に立って料理の腕を<磨|みが>くとしましょう」"

#. Occurrence 1_5:4822:1104: scene=1_5
#: 1_5:4822
msgctxt "text_id=1104 | speaker=unknown"
msgid "  She stood up, announcing her intent to no one in particular."
msgstr "　誰に言うのでもなく立ち上がる青子。"

#. Occurrence 1_5:4858:1105: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0063; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4858
msgctxt "text_id=1105 | speaker=aoko"
msgid "\"Oh, I almost forgot to ask. Where did you end up eating, anyway?\""
msgstr "「あ、聞き忘れてた。有珠、どこで夕食すませたの？」"

#. Occurrence 1_5:4864:1106: scene=1_5
#: 1_5:4864
msgctxt "text_id=1106 | speaker=unknown"
msgid "  Alice's hand froze on her current page."
msgstr "　ぴたり、と本の<頁|ページ>をめくる手がとまる。"

#. Occurrence 1_5:4890:1107: scene=1_5
#: 1_5:4890
msgctxt "text_id=1107 | speaker=unknown"
msgid "  She suddenly shut the book she was reading and stood up, as if at wits' end."
msgstr "　ここまで青子の相手をしながら読書していたけど、それももう限界、と本は閉じられた。"

#. Occurrence 1_5:4912:1108: scene=1_5
#: 1_5:4912
msgctxt "text_id=1108 | speaker=unknown"
msgid "  She walked across the drawing room with her book in hand."
msgstr "　有珠は本を片手に立ち上がると、スタスタと居間を横断。"

#. Occurrence 1_5:4917:1109: scene=1_5
#: 1_5:4917
msgctxt "text_id=1109 | speaker=unknown"
msgid "  When she reached the door, she stopped and turned toward Aoko."
msgstr "　扉に着いたところで青子へと振り向いた。"

#. Occurrence 1_5:4955:1110: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0033; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:4955
msgctxt "text_id=1110 | speaker=alice"
msgid "\"You really want to know?\""
msgstr "「聞きたい？」"

#. Occurrence 1_5:4968:1111: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0064; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4968
msgctxt "text_id=1111 | speaker=aoko"
msgid "\"Um, sure.\""
msgstr "「まあ、なんとなく……」"

#. Occurrence 1_5:4973:1112: scene=1_5
#: 1_5:4973
msgctxt "text_id=1112 | speaker=unknown"
msgid "  Aoko nodded timidly, cowed by Alice's sudden vigor."
msgstr "　迫力に押されて、遠慮がちに頷く青子。"

#. Occurrence 1_5:4978:1113: scene=1_5
#: 1_5:4978
msgctxt "text_id=1113 | speaker=unknown"
msgid "  Alice continued in her matter-of-fact way."
msgstr "　有珠は何でもない事のように、"

#. Occurrence 1_5:5000:1114: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0034; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:5000
msgctxt "text_id=1114 | speaker=alice"
msgid "\"The cat gave me one of his leftover deliveries.\""
msgstr "「その猫が、あまったメニューをくれたのよ」"

#. Occurrence 1_5:5006:1115: scene=1_5
#: 1_5:5006
msgctxt "text_id=1115 | speaker=unknown"
msgid "  And with that brief response, she left the room."
msgstr "　簡潔に答えて、居間から立ち去っていった。"

#. Occurrence 1DOT5_1:48:1116: scene=1DOT5_1
#: 1DOT5_1:48
msgctxt "text_id=1116 | speaker=unknown"
msgid "  Morning in the city moved incredibly fast."
msgstr "　都会の朝は遅いようで早い。"

#. Occurrence 1DOT5_1:53:1117: scene=1DOT5_1
#: 1DOT5_1:53
msgctxt "text_id=1117 | speaker=unknown"
msgid "  It made one wonder if it was even a morning at all, with people so bright-eyed and bushy-tailed."
msgstr "　もしかしたら朝なんて無いんじゃないかと思うぐらい、どこもかしこも目が覚めている。"

#. Occurrence 1DOT5_1:101:1118: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0000; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:101
msgctxt "text_id=1118 | speaker=soujuurou"
msgid "\"...\""
msgstr "「…………」"

#. Occurrence 1DOT5_1:107:1119: scene=1DOT5_1
#: 1DOT5_1:107
msgctxt "text_id=1119 | speaker=unknown"
msgid "  The unfamiliar roar that awoke him reminded him of a rockslide."
msgstr "　まだ聞き慣れない、岩を<転|ころ>がすような<悲鳴|ひめい>で目を覚ました。"

#. Occurrence 1DOT5_1:112:1120: scene=1DOT5_1
#: 1DOT5_1:112
msgctxt "text_id=1120 | speaker=unknown"
msgid "  The identity of the monstrous sound was the engine of a motorcycle. Mr. Yoshida, his neighbor, was leaving for work."
msgstr "　怪音の正体は自動二輪車のエンジン音で、どうやらおとなりの<吉田|よしだ>さんが出勤したらしい。"

#. Occurrence 1DOT5_1:117:1121: scene=1DOT5_1
#: 1DOT5_1:117
msgctxt "text_id=1121 | speaker=unknown"
msgid "  It was hard to determine when night ended and morning began here."
msgstr "　朝が<曖昧|あいまい>なこの街は、夜だって曖昧だ。"

#. Occurrence 1DOT5_1:122:1122: scene=1DOT5_1
#: 1DOT5_1:122
msgctxt "text_id=1122 | speaker=unknown"
msgid "  The town's urbanization was synonymous with insomnia."
msgstr "　機械仕掛けというのは眠らない事と同義なのだろう。"

#. Occurrence 1DOT5_1:143:1123: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0001; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:143
msgctxt "text_id=1123 | speaker=soujuurou"
msgid "\"Already? It's barely sun-up yet... Where could Mr. Yoshida be going so early?\""
msgstr "「信じられない……まだ陽も昇ってないのに……吉田さんはどこに行くのか……」"

#. Occurrence 1DOT5_1:150:1124: scene=1DOT5_1
#: 1DOT5_1:150
msgctxt "text_id=1124 | speaker=unknown"
msgid "  He sluggishly lifted himself off the floor."
msgstr "　のっそり床から身を起こす。"

#. Occurrence 1DOT5_1:155:1125: scene=1DOT5_1
#: 1DOT5_1:155
msgctxt "text_id=1125 | speaker=unknown"
msgid "  He caught himself starting to survey his surroundings out of habit before deciding better of it, and made his way to the washroom."
msgstr "　これまでの習慣であたりを徘徊しそうになって、その必要はないと気が付き、流し場に向かう。"

#. Occurrence 1DOT5_1:188:1126: scene=1DOT5_1
#: 1DOT5_1:188
msgctxt "text_id=1126 | speaker=unknown"
msgid "  There, he poured himself a cup of water and slowly gulped it down."
msgstr "　コップに<二口|ふたくち>分の水を<汲|く>んで、ゆっくりと喉に通した。"

#. Occurrence 1DOT5_1:196:1127: scene=1DOT5_1
#: 1DOT5_1:196
msgctxt "text_id=1127 | speaker=unknown"
msgid "  Having been relegated to well water until recently, he found the convenience pleasing."
msgstr "　ちょっと前までは井戸水を汲んでいた草十郎にとって、この便利さは喜ばしい。"

#. Occurrence 1DOT5_1:201:1128: scene=1DOT5_1
#: 1DOT5_1:201
msgctxt "text_id=1128 | speaker=unknown"
msgid "  'Pleased' was definitely the word that best described how he felt."
msgstr "　喜ばしい、と思うことが正しい。"

#. Occurrence 1DOT5_1:230:1129: scene=1DOT5_1
#: 1DOT5_1:230
msgctxt "text_id=1129 | speaker=unknown"
msgid "  Civilization is about erasing inconveniences through optimization."
msgstr "　文明とは複雑化と最適化を突き詰めるもので、"

#. Occurrence 1DOT5_1:235:1130: scene=1DOT5_1
#: 1DOT5_1:235
msgctxt "text_id=1130 | speaker=unknown"
msgid "  The reduction of labor in our daily lives."
msgstr "　生活に必要なものは手間を減らし、"

#. Occurrence 1DOT5_1:240:1131: scene=1DOT5_1
#: 1DOT5_1:240
msgctxt "text_id=1131 | speaker=unknown"
msgid "  Mr. Koga had taught him that while the essentials were easier than ever to get our hands on, life itself was growing more and more complex."
msgstr "　人生に必要なものはより複雑さを増していく、と教えてくれたのは<恒河|こうが>さんだったか。"

#. Occurrence 1DOT5_1:245:1132: scene=1DOT5_1
#: 1DOT5_1:245
msgctxt "text_id=1132 | speaker=unknown"
msgid "  So too was it his duty to adjust to his new reality."
msgstr "　<手前|テメエ>はともかく前者の方から慣れるべきだ、とも彼は言った。"

#. Occurrence 1DOT5_1:281:1133: scene=1DOT5_1
#: 1DOT5_1:281
msgctxt "text_id=1133 | speaker=unknown"
msgid "  As a distant relative of Soujyuro's father, Mr. Koga had taken Soujyuro in, even though the boy had been little more than a stranger in his life till that point."
msgstr "　草十郎の父の遠縁である恒河氏は、わりと、ほとんど他人に近い草十郎をここまで世話してくれた恩人である。"

#. Occurrence 1DOT5_1:287:1134: scene=1DOT5_1
#: 1DOT5_1:287
msgctxt "text_id=1134 | speaker=unknown"
msgid "  Mr. Koga had helped him get registered at school and find an apartment to lease."
msgstr "　アパートの契約や学校の手続きが問題なく済んだのは恒河氏の<尽力|じんりょく>あってのものだ。"

#. Occurrence 1DOT5_1:292:1135: scene=1DOT5_1
#: 1DOT5_1:292
msgctxt "text_id=1135 | speaker=unknown"
msgid "  Though, he had insisted that Soujyuro handle his residence card and register his change of address by himself."
msgstr "　一方、住民票の<写|うつ>しやら移転届けやらは自分の手でやりやがれと叱られた。"

#. Occurrence 1DOT5_1:325:1136: scene=1DOT5_1
#: 1DOT5_1:325
msgctxt "text_id=1136 | speaker=unknown"
msgid "  This series of procedures proved exceedingly difficult for Soujyuro, but knowing that this was a part of his new city life, he did his best to complete them diligently."
msgstr "　草十郎にとって手続き関連は困難なことこの上なかったが、これから都会で暮らしていくんだから、と前向きにこなしてみれば、こちらも呆気なく片が付いた。"

#. Occurrence 1DOT5_1:330:1137: scene=1DOT5_1
#: 1DOT5_1:330
msgctxt "text_id=1137 | speaker=unknown"
msgid "(While they may have a reputation for being a stickler for the rules, city offices aren't all that bad.)"
msgstr "『お役所仕事は厳しそうに見えてわりといい加減』"

#. Occurrence 1DOT5_1:335:1138: scene=1DOT5_1
#: 1DOT5_1:335
msgctxt "text_id=1138 | speaker=unknown"
msgid "  It was the first thing Soujyuro learned after beginning his life in the city."
msgstr "　草十郎が街での生活を始めてから、最初に覚えた教訓である。"

#. Occurrence 1DOT5_1:369:1139: scene=1DOT5_1
#: 1DOT5_1:369
msgctxt "text_id=1139 | speaker=unknown"
msgid "  Two weeks had elapsed since he left the countryside."
msgstr "　草十郎が田舎からやってきて二週間。"

#. Occurrence 1DOT5_1:374:1140: scene=1DOT5_1
#: 1DOT5_1:374
msgctxt "text_id=1140 | speaker=unknown"
msgid "  As uneasy as living alone made him feel, he felt he could make it work."
msgstr "　不安だらけだったひとり暮らしも、やってみればなんとかなるものだ。"

#. Occurrence 1DOT5_1:379:1141: scene=1DOT5_1
#: 1DOT5_1:379
msgctxt "text_id=1141 | speaker=unknown"
msgid "  It was not as if the people here spoke another language, and Mr. Koga was absolutely right about how practical the rules of the city were."
msgstr "　言葉が通じるんだから当たり前と言えば当たり前だし、なにより恒河氏の言うとおり、生活面だけなら都会の<あり方|ルール>はがっしりと筋が通っている。"

#. Occurrence 1DOT5_1:423:1142: scene=1DOT5_1
#: 1DOT5_1:423
msgctxt "text_id=1142 | speaker=unknown"
msgid "  Soujyuro continued down the hard, but surprisingly walkable path."
msgstr "　硬い、驚くほど歩きやすい道を歩く。"

#. Occurrence 1DOT5_1:428:1143: scene=1DOT5_1
#: 1DOT5_1:428
msgctxt "text_id=1143 | speaker=unknown"
msgid "  Before work, he jogged in the park to pass the time."
msgstr "　アルバイトの時間まで、時間つぶしに公園をジョギングする。"

#. Occurrence 1DOT5_1:433:1144: scene=1DOT5_1
#: 1DOT5_1:433
msgctxt "text_id=1144 | speaker=unknown"
msgid "  Even exercise like this offered lessons for Soujyuro to learn."
msgstr "　草十郎にしてみれば、こんな運動すら大事な教訓になる。"

#. Occurrence 1DOT5_1:471:1145: scene=1DOT5_1
#: 1DOT5_1:471
msgctxt "text_id=1145 | speaker=unknown"
msgid "  Each passing person was a new face to look at."
msgstr "　通り過ぎる人々はひとりひとりが新鮮で、"

#. Occurrence 1DOT5_1:476:1146: scene=1DOT5_1
#: 1DOT5_1:476
msgctxt "text_id=1146 | speaker=unknown"
msgid "  The old man who greeted him,"
msgstr "　挨拶をしてくれるおじいさんも、"

#. Occurrence 1DOT5_1:481:1147: scene=1DOT5_1
#: 1DOT5_1:481
msgctxt "text_id=1147 | speaker=unknown"
msgid "  the young worker with his eyes on the ground,"
msgstr "　うつむいて歩く二十歳ぐらいのお兄さんも、"

#. Occurrence 1DOT5_1:486:1148: scene=1DOT5_1
#: 1DOT5_1:486
msgctxt "text_id=1148 | speaker=unknown"
msgid "  and the girl on the bench, surrounded by birds..."
msgstr "　ベンチに座って鳥に囲まれている女の子も、"

#. Occurrence 1DOT5_1:491:1149: scene=1DOT5_1
#: 1DOT5_1:491
msgctxt "text_id=1149 | speaker=unknown"
msgid "  They were all unfamiliar sights to Soujyuro."
msgstr "　草十郎にとっては<得難|えがた>い風景だ。"

#. Occurrence 1DOT5_1:497:1150: scene=1DOT5_1
#: 1DOT5_1:497
msgctxt "text_id=1150 | speaker=unknown"
msgid "  Unaccustomed to the city, he labored to understand its rules."
msgstr "　まだ街に慣れていない彼は、とにかくルールの把握に努めなくてはいけなかった。"

#. Occurrence 1DOT5_1:529:1151: scene=1DOT5_1
#: 1DOT5_1:529
msgctxt "text_id=1151 | speaker=unknown"
msgid "  Whether they were complex, simple,"
msgstr "　複雑だったり単純だったり、"

#. Occurrence 1DOT5_1:534:1152: scene=1DOT5_1
#: 1DOT5_1:534
msgctxt "text_id=1152 | speaker=unknown"
msgid "  or completely meaningless..."
msgstr "　意味があったりなかったり。"

#. Occurrence 1DOT5_1:540:1153: scene=1DOT5_1
#: 1DOT5_1:540
msgctxt "text_id=1153 | speaker=unknown"
msgid "  Compared to mountain life, which only dealt with nature, city life left one with way too many options."
msgstr "　自然とだけ向き合っていればよかった山の暮らしと比べて、街の暮らしは選択肢が多すぎる。"

#. Occurrence 1DOT5_1:545:1154: scene=1DOT5_1
#: 1DOT5_1:545
msgctxt "text_id=1154 | speaker=unknown"
msgid "  One could argue that such an environment was toxic for Soujyuro."
msgstr "　正直、今の草十郎には毒々しいとさえ言えた。"

#. Occurrence 1DOT5_1:578:1155: scene=1DOT5_1
#: 1DOT5_1:578
msgctxt "text_id=1155 | speaker=unknown"
msgid "  His life was a string of unsettling moments."
msgstr "　いまのところは不安になるような出来事ばかり。"

#. Occurrence 1DOT5_1:583:1156: scene=1DOT5_1
#: 1DOT5_1:583
msgctxt "text_id=1156 | speaker=unknown"
msgid "  But amongst it all, there were rules that he sincerely admired."
msgstr "　ただ、その中にも心の底から感心できるルールだってある。"

#. Occurrence 1DOT5_1:589:1157: scene=1DOT5_1
#: 1DOT5_1:589
msgctxt "text_id=1157 | speaker=unknown"
msgid "  For one, that the city revolved around various forms of profit and loss."
msgstr "　色々と合点のいかない<損得勘定|ルール>で回る都会だが。"

#. Occurrence 1DOT5_1:594:1158: scene=1DOT5_1
#: 1DOT5_1:594
msgctxt "text_id=1158 | speaker=unknown"
msgid "  The fact that one only needed money to get the bare essentials to survive the city was a comforting thought to Soujyuro."
msgstr "　とりあえず、お金さえあれば必要な物はあらかた貰えるのは、なるほど、都会の暮らしも悪くないと思う草十郎なのだった。"

#. Occurrence 1DOT5_1:671:1159: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0000; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:671
msgctxt "text_id=1159 | speaker=kinomi"
msgid "\"Hey, not everything's that simple."
msgstr "「いや、そうシンプルな話じゃねぇよ。"

#. Occurrence 1DOT5_1:677:1160: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0001; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:677
msgctxt "text_id=1160 | speaker=kinomi"
msgid "  Money is just a symbol. It's the other stuff that truly matters."
msgstr "　金なんてものはあくまで記号で、本当に大事なのは別にあんだからさあ。"

#. Occurrence 1DOT5_1:688:1161: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0002; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:688
msgctxt "text_id=1161 | speaker=kinomi"
msgid "  Money ain't that different from those free shoulder massage coupons people hand out, and it's not like the food you buy with a ten-thousand yen bill won't turn out bogus. Look, money can't buy you happiness, you get me?\""
msgstr "　しょせんは流動する肩たたき券と変わんねーっつーか、別に一万円札食っても<旨|うま>くねぇっつーか……あー、ともかく金で真心は買えねえじゃん？」"

#. Occurrence 1DOT5_1:709:1162: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0002; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:709
msgctxt "text_id=1162 | speaker=soujuurou"
msgid "\"Maybe.\""
msgstr "「えー」"

#. Occurrence 1DOT5_1:729:1163: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0003; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:729
msgctxt "text_id=1163 | speaker=kinomi"
msgid "\"'Maybe'!? Are you for real? Man, I can't believe you right now."
msgstr "「えーじゃねえよ！　ザケンなよー、オレは悲しいよー。"

#. Occurrence 1DOT5_1:735:1164: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0004; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:735
msgctxt "text_id=1164 | speaker=kinomi"
msgid "  One day you're happy to break your back working a full day for a measly four thousand yen, the next you're elbow-deep in dirty dishes saying, 'It's all about the money.' What's your major malfunction?\""
msgstr "　ついこの間まで四千円っぽっちの日当に鹿みたいに首かしげていた正直者が、くっだらねえ皿洗いをしながら“ま、世の中金だよね”なんて、ぼそっと言わないでくれっつの」"

#. Occurrence 1DOT5_1:756:1165: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0003; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:756
msgctxt "text_id=1165 | speaker=soujuurou"
msgid "\"No, I think that the current system is kind of amazing. To be honest, I never realized how limited bartering can be."
msgstr "「いや、貨幣制度は素晴らしいと思う。正直、物々交換の限界を感じた。"

#. Occurrence 1DOT5_1:762:1166: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0004; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:762
msgctxt "text_id=1166 | speaker=soujuurou"
msgid "  Anyway, Kinomi--you're gonna drop that if you aren't careful.\""
msgstr "　それより<木乃美|きのみ>、ふざけてると<皿|それ>、落とすぞ」"

#. Occurrence 1DOT5_1:794:1167: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0005; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:794
msgctxt "text_id=1167 | speaker=kinomi"
msgid "\"Huh? Crap! Ooh, damn! That was close! If I break any more, it'll be my head next!"
msgstr "「え？　って、うおぉぉおヤベえヤベえ、つぎ割ったら今度こそオレの頭が割られちまうからな！"

#. Occurrence 1DOT5_1:807:1168: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0006; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:807
msgctxt "text_id=1168 | speaker=kinomi"
msgid "  Thanks for the save. So...what did you want to talk to me about? It's money, isn't it?\""
msgstr "　忠告サンキュー。それで、相談ごと？　なに、もしかして金？」"

#. Occurrence 1DOT5_1:813:1169: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0005; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:813
msgctxt "text_id=1169 | speaker=soujuurou"
msgid "\"Exactly. I learned my lesson the hard way, but now I know that it's better to have more money than less. That's why I'd like to work even more than I am now.\""
msgstr "「そうなんだ。とりあえずお金は大事で、たくさんあるに越したことはないって痛感した。なんで、出来ればもうちょっと働きたい」"

#. Occurrence 1DOT5_1:839:1170: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0007; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:839
msgctxt "text_id=1170 | speaker=kinomi"
msgid "\"Are you for real? You already wash dishes like a machine."
msgstr "「うぇ、マジぃ？　マシーンみたいに皿洗いをこなしながら夢のないコト言わないでほしいなあ。"

#. Occurrence 1DOT5_1:850:1171: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0008; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:850
msgctxt "text_id=1171 | speaker=kinomi"
msgid "  Didn't I just how money can't buy happiness? Love can, but... Back right up. Why's the water so cold? Say, we should probably get paid more for washing dishes in the winter, huh?\""
msgstr "　世の中金じゃねえって言ったばかりじゃんか。やっぱラブじゃんか。ところで水冷たくないですかね？　冬場の皿洗いって割合わねえコトこの上ねえよな？」"

#. Occurrence 1DOT5_1:871:1172: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0006; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:871
msgctxt "text_id=1172 | speaker=soujuurou"
msgid "\"It's cold all right, but nothing I can't handle."
msgstr "「そりゃ冷たいけど、これぐらいは我慢しないと。"

#. Occurrence 1DOT5_1:871:1173: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0006; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:871
msgctxt "text_id=1173 | speaker=soujuurou"
msgid "  Mountain water is so cold it hurts.\""
msgstr "　山の水は冷たいっていうより痛かったし」"

#. Occurrence 1DOT5_1:907:1174: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0009; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:907
msgctxt "text_id=1174 | speaker=kinomi"
msgid "\"I didn't mean it was ice water, you hick. That thick skin of yours can be real annoying, you know that?"
msgstr "「氷水とおんなじにすんな野生児め。……しっかしアレだね、あきれた順応力、いや忍耐力？　つーの？"

#. Occurrence 1DOT5_1:913:1175: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0010; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:913
msgctxt "text_id=1175 | speaker=kinomi"
msgid "  For someone who couldn't even work a cash register four days ago, you sure got comfortable workin' for The Man. I guess money really is everything. The power of capitalism ain't nothing to mess with!\""
msgstr "　レジ打ちすらできなかった新人がよぅ、たった四日でしみったれたメシ屋の<社畜|しゃちく>になっちまうなんて……やっぱ世の中金ってコトかねー。資本主義ってすげー」"

#. Occurrence 1DOT5_1:930:1176: voice_id=D30_1DOT5_1_0000; voice_prefix=D30; voice_category=0; scene=1DOT5_1
#: 1DOT5_1:930
msgctxt "text_id=1176 | speaker=unknown"
msgid "\"Shut yer pie holes, part-timers! The door's right there if you wanna quit!"
msgstr "「うるっせえぞバカバイト、文句あんなら辞めちまえ！"

#. Occurrence 1DOT5_1:936:1177: voice_id=D30_1DOT5_1_0001; voice_prefix=D30; voice_category=0; scene=1DOT5_1
#: 1DOT5_1:936
msgctxt "text_id=1177 | speaker=unknown"
msgid "  I don't have the cash to waste on deadbeats!\""
msgstr "　うちにゃあ<穀潰|ごくつぶ>しにくれてやる小遣いはねえ！」"

#. Occurrence 1DOT5_1:956:1178: scene=1DOT5_1
#: 1DOT5_1:956
msgctxt "text_id=1178 | speaker=unknown"
msgid "  The complaints and chopsticks flew at them like a storm."
msgstr "　間髪いれず、すっかーん、と飛ばされる罵声と<菜箸|さいばし>。"

#. Occurrence 1DOT5_1:961:1179: scene=1DOT5_1
#: 1DOT5_1:961
msgctxt "text_id=1179 | speaker=unknown"
msgid "  This mess of a Chinese restaurant manager was a stubborn man who was willing to let minors work for him and didn't shy from violence, even if it was directed at the son of a lifelong friend."
msgstr "　未成年でも働かせてくれるアバウトな中華飯店の店長は、たとえ赤ん坊の頃から顔見知り……お隣さんの息子さん……であろうと鉄拳を振るう、たくましい人物だった。"

#. Occurrence 1DOT5_1:967:1180: scene=1DOT5_1
#: 1DOT5_1:967
msgctxt "text_id=1180 | speaker=unknown"
msgid "  Soujyuro felt that this is what Sparta must have been like."
msgstr "　こういうのをスパルタと言うんだな、と草十郎は感心する。"

#. Occurrence 1DOT5_1:988:1181: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0007; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:988
msgctxt "text_id=1181 | speaker=soujuurou"
msgid "\"Look, he's angry. We need to work harder.\""
msgstr "「ほら怒られた。任された事はきちんとやらないと」"

#. Occurrence 1DOT5_1:1009:1182: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0011; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1009
msgctxt "text_id=1182 | speaker=kinomi"
msgid "\"Wow, your nose get any browner yet? Me, I'm tryin' to make the most of my teens."
msgstr "「けっ、優等生め。こっちは何かと反抗したい年頃だっつの。"

#. Occurrence 1DOT5_1:1021:1183: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0012; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1021
msgctxt "text_id=1183 | speaker=kinomi"
msgid "  Whatever. Right, been meaning to ask..."
msgstr "　まあいいや。話は変わるんだけどよ。"

#. Occurrence 1DOT5_1:1027:1184: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0013; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1027
msgctxt "text_id=1184 | speaker=kinomi"
msgid "  Are you the type that likes to go out on late-night strolls or more of a bicycle kind of guy? Not that it really matters, but...\""
msgstr "　静希、夜に出歩くタイプ？　それかチャリンコで出ばる趣味？　いやまぁ、どっちかでいいんだけど」"

#. Occurrence 1DOT5_1:1049:1185: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0008; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:1049
msgctxt "text_id=1185 | speaker=soujuurou"
msgid "\"Hm? It's always late when I go home after the restaurant, but that's not what you're asking, is it? I'm not really into walking when it's late out. Why do you ask?\""
msgstr "「……？　バイトの帰りはほとんど夜になるけど、そういう話じゃないんだよな。夜の散歩も遠出も趣味じゃないけど、それが？」"

#. Occurrence 1DOT5_1:1076:1186: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0014; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1076
msgctxt "text_id=1186 | speaker=kinomi"
msgid "\"No reason. Like, you just moved here. Kinda weird question, but don't you think the town is dangerous? Not like people are bad or nothing."
msgstr "「いや、なにさ。静希、引っ越してきたばかりだっていうからよ。オレらが言うのもなんだけど、<三咲町|うち>、ちょい治安が悪いっての？　ガラが悪いワケじゃねえんだけどな。"

#. Occurrence 1DOT5_1:1108:1187: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0015; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1108
msgctxt "text_id=1187 | speaker=kinomi"
msgid "  But I mean, you know that we get ten attacks like outta a slasher flick every year, right? And since they started there's-\""
msgstr "　年間十人ぐらい通り魔事件っての？　そういうの、起きてっから」"

#. Occurrence 1DOT5_1:1114:1188: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0009; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:1114
msgctxt "text_id=1188 | speaker=soujuurou"
msgid "\"What's a slasher?\""
msgstr "「……とおりまって、なんだ？」"

#. Occurrence 1DOT5_1:1135:1189: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0016; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1135
msgctxt "text_id=1189 | speaker=kinomi"
msgid "\"You don't know!?"
msgstr "「そっからかよ！"

#. Occurrence 1DOT5_1:1141:1190: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0017; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1141
msgctxt "text_id=1190 | speaker=kinomi"
msgid "  It's like... when a thief snatches someone's purse... No, bad example."
msgstr "　……なんだ、ほら！　カバン強盗……でもないか。"

#. Occurrence 1DOT5_1:1148:1191: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0018; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1148
msgctxt "text_id=1191 | speaker=kinomi"
msgid "It's more like someone's killing to see if they can get away with it. Buncha dead people in the woods near the suburbs. Real gnarly."
msgstr "<辻斬|つじぎ>りってのが近いのか。住宅街とか、まだ森が残ってる方によく出やがるんだよ、そういうおかしいのが。"

#. Occurrence 1DOT5_1:1173:1192: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0019; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1173
msgctxt "text_id=1192 | speaker=kinomi"
msgid "  That's why you shouldn't go out too late. The park in Misaki Hills is a hot spot for the weird stuff."
msgstr "　なんで、あんまり夜遅くは出歩くなよな。三咲丘の公園とか、有名な怪奇スポットだから。"

#. Occurrence 1DOT5_1:1179:1193: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0020; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1179
msgctxt "text_id=1193 | speaker=kinomi"
msgid "  Haven't you heard about how they think the freak doing it is some chick with a sliced mouth?\""
msgstr "　通り魔の犯人は口裂け女だったって話、知らねえか？」"

#. Occurrence 1DOT5_1:1200:1194: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0010; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:1200
msgctxt "text_id=1194 | speaker=soujuurou"
msgid "\"Nope. This is the first I've heard of a sliced-mouth woman.\""
msgstr "「ごめん、まずその口裂け女ってのが分からない」"

#. Occurrence 1DOT5_1:1218:1195: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0021; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1218
msgctxt "text_id=1195 | speaker=kinomi"
msgid "\"Like I said, slasher film shit. They say her mouth extends all the way to her ears."
msgstr "「怪談だよ。口が耳まで裂けてるってヤツ。"

#. Occurrence 1DOT5_1:1218:1196: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0021; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1218
msgctxt "text_id=1196 | speaker=kinomi"
msgid "  It's a pretty old-school kinda urban legend, these days.\""
msgstr "　今じゃさすがに時代遅れだけどよ」"

#. Occurrence 1DOT5_1:1239:1197: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0022; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1239
msgctxt "text_id=1197 | speaker=kinomi"
msgid "\"How did it go again? There's a woman in a coat who asks 'Am I beautiful?' in the dead of night."
msgstr "「えーとなんだっけ、深夜の道にな、コート姿の女が待ち伏せていて『わたしきれい？』とか聞いてくるんだよ。"

#. Occurrence 1DOT5_1:1260:1198: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0023; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1260
msgctxt "text_id=1198 | speaker=kinomi"
msgid "  Even if you say she is, she'll follow you home and kill you."
msgstr "　で、キレイって言ってもイマイチって言っても家まで追っかけられて殺されるの。"

#. Occurrence 1DOT5_1:1273:1199: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0024; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1273
msgctxt "text_id=1199 | speaker=kinomi"
msgid "Intense chicks like that are a no-no. It's like, something you'd see in an American comic book.\""
msgstr "女の情念はおっかねえっつうか、アメコミの怪人っぽいっつうか」"

#. Occurrence 1DOT5_1:1294:1200: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0011; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:1294
msgctxt "text_id=1200 | speaker=soujuurou"
msgid "\"...That sounds really scary."
msgstr "「……いや、それ本気で怖くないか？"

#. Occurrence 1DOT5_1:1294:1201: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0011; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:1294
msgctxt "text_id=1201 | speaker=soujuurou"
msgid "  Does she actually follow you home?\""
msgstr "　家まであがってくるのか、その女の人？」"

#. Occurrence 1DOT5_1:1307:1202: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0025_0; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1307
msgctxt "text_id=1202 | speaker=kinomi"
msgid "\"They say she crawls in through a window."
msgstr "「窓から入ってくるらしいぜ。"

#. Occurrence 1DOT5_1:1307:1203: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0025_0; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1307
msgctxt "text_id=1203 | speaker=kinomi"
msgid "  Squeezes her way in like a cockroa-"
msgstr "　ガサガサと、こう、ゴキブリみた―――"

#. Occurrence 1DOT5_1:1323:1204: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0025_1; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1323
msgctxt "text_id=1204 | speaker=kinomi"
msgid "AAAGH!\""
msgstr "ぎゃっ！？」"

#. Occurrence 1DOT5_1:1340:1205: voice_id=D30_1DOT5_1_0002; voice_prefix=D30; voice_category=0; scene=1DOT5_1
#: 1DOT5_1:1340
msgctxt "text_id=1205 | speaker=unknown"
msgid "\"I told you not to utter that word in this kitchen! I'm gonna kill you, you little turd!\""
msgstr "「っのクソガキが、厨房でその四文字は禁止だってんだろ、殺すぞ！」"

#. Occurrence 1DOT5_1:1360:1206: scene=1DOT5_1
#: 1DOT5_1:1360
msgctxt "text_id=1206 | speaker=unknown"
msgid "  The back of Kinomi's head exploded in pain with the impact of his boss's frying pan."
msgstr "　そうして木乃美の後頭部に炸裂する、店長のフライパン／縦攻撃。"

#. Occurrence 1DOT5_1:1365:1207: scene=1DOT5_1
#: 1DOT5_1:1365
msgctxt "text_id=1207 | speaker=unknown"
msgid "  Soujyuro was reminded of just how dangerous this town could be."
msgstr "　なるほど、町は危険であふれている、と草十郎は再び感心した。"

#. Occurrence 1DOT5_1:1401:1208: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0026; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1401
msgctxt "text_id=1208 | speaker=kinomi"
msgid "\"'I'm gonna kill you, I'm gonna kill you!' Yeah right! I'd like to see him try!"
msgstr "「殺す殺すってバカじゃねえの!?"

#. Occurrence 1DOT5_1:1414:1209: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0027; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1414
msgctxt "text_id=1209 | speaker=kinomi"
msgid "  And what kind of boss says that anyway!? This is a restaurant, ain't it!? Well, maybe calling it that is too much!\""
msgstr "　フツーそっちの方が禁止用語じゃねえの!?　ここレストランなんだしさ！　いや、あんまうまくねーけど！」"

#. Occurrence 1DOT5_1:1420:1210: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0012; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:1420
msgctxt "text_id=1210 | speaker=soujuurou"
msgid "\"Is your head okay, Kinomi?\""
msgstr "「木乃美、頭、大丈夫か？」"

#. Occurrence 1DOT5_1:1447:1211: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0028; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1447
msgctxt "text_id=1211 | speaker=kinomi"
msgid "\"Huh? Ah, it's nothing. People tell me I'm real tough. Especially my head."
msgstr "「え？　あ、ん、心配無用。オレ、なんでか頑丈さには定評があるから。特に頭部について。"

#. Occurrence 1DOT5_1:1459:1212: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0029; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1459
msgctxt "text_id=1212 | speaker=kinomi"
msgid "  Anyway, avoid the dark, okay? You look like a sitting duck.\""
msgstr "　ともかく、そういうワケなんで夜の暗がりは気をつけるぞなもし。静希、見るからにカモそうな顔してるし」"

#. Occurrence 1DOT5_1:1465:1213: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0013; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:1465
msgctxt "text_id=1213 | speaker=soujuurou"
msgid "\"Thanks."
msgstr "「ありがとう。"

#. Occurrence 1DOT5_1:1471:1214: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0014; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:1471
msgctxt "text_id=1214 | speaker=soujuurou"
msgid "  By the way, is ten victims per year a lot?\""
msgstr "　ところで、年間十人というのは多い方なのか？」"

#. Occurrence 1DOT5_1:1498:1215: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0030; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1498
msgctxt "text_id=1215 | speaker=kinomi"
msgid "\"Don't know. It probably isn't a lot, but it totally ain't a few either."
msgstr "「知んねぇよ。少なくはないだろうけど、多い方でもないんじゃねえか？"

#. Occurrence 1DOT5_1:1510:1216: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0031; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1510
msgctxt "text_id=1216 | speaker=kinomi"
msgid "  The real scary shit is that they're still out there, somewhere, since they haven't been caught!\""
msgstr "　ま、<三|う><咲|ち>の通り魔事件が他に比べて厄介なのは、まだ犯人が見つかってないってコトだからネ！」"

#. Occurrence 1DOT5_1:1545:1217: scene=1DOT5_1
#: 1DOT5_1:1545
msgctxt "text_id=1217 | speaker=unknown"
msgid "  He laughed cheerfully."
msgstr "　はははは、と陽気に笑う。"

#. Occurrence 1DOT5_1:1550:1218: scene=1DOT5_1
#: 1DOT5_1:1550
msgctxt "text_id=1218 | speaker=unknown"
msgid "  Kinomi was probably trying to take the edge off of his story, but the noble intention of his laugh was completely lost on Soujyuro."
msgstr "　そうやって不吉な話を笑い話に切り替える木乃美の高度な意図は、もちろん草十郎には伝わっていない。"

#. Occurrence 1DOT5_1:1555:1219: scene=1DOT5_1
#: 1DOT5_1:1555
msgctxt "text_id=1219 | speaker=unknown"
msgid "  His friendly warning was equally futile."
msgstr "　親切な忠告も<糠|ぬか>に<釘|くぎ>。"

#. Occurrence 1DOT5_1:1565:1220: scene=1DOT5_1
#: 1DOT5_1:1565
msgctxt "text_id=1220 | speaker=unknown"
msgid "  Soujyuro was simply impressed that Kinomi was able to laugh it off."
msgstr "　そっか、ここは笑うところなのか、とまたも真剣に感心する草十郎なのだった。"

#. Occurrence 1DOT5_1:1607:1221: scene=1DOT5_1
#: 1DOT5_1:1607
msgctxt "text_id=1221 | speaker=unknown"
msgid "  On the way home..."
msgstr "　その帰り道。"

#. Occurrence 1DOT5_1:1612:1222: scene=1DOT5_1
#: 1DOT5_1:1612
msgctxt "text_id=1222 | speaker=unknown"
msgid "  Nobody ahead or behind. Soujyuro proceeded through the dimly lit street when suddenly..."
msgstr "　前にも後ろにも人のいない、電灯だけが照らす暗い住宅地で、草十郎は唐突に、"

#. Occurrence 1DOT5_1:1632:1223: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0015; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:1632
msgctxt "text_id=1223 | speaker=soujuurou"
msgid "\"...?\""
msgstr "「……？」"

#. Occurrence 1DOT5_1:1637:1224: scene=1DOT5_1
#: 1DOT5_1:1637
msgctxt "text_id=1224 | speaker=unknown"
msgid "  He turned to face an... improbable sound."
msgstr "　何か、ありえない物音に振り返った。"

#. Occurrence 1DOT5_1:1690:1225: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0016; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:1690
msgctxt "text_id=1225 | speaker=soujuurou"
msgid "\"...Ouch!\""
msgstr "「―――あいた！？」"

#. Occurrence 1DOT5_1:1704:1226: scene=1DOT5_1
#: 1DOT5_1:1704
msgctxt "text_id=1226 | speaker=unknown"
msgid "  Something stabbed him in the head, and fell to the floor."
msgstr "　脳天に刺さる衝撃と、ぽとん、と足下に落ちる音。"

#. Occurrence 1DOT5_1:1709:1227: scene=1DOT5_1
#: 1DOT5_1:1709
msgctxt "text_id=1227 | speaker=unknown"
msgid "  He frowned."
msgstr "　ついてない、と<眉|まゆ>を<曇|くも>らせる。"

#. Occurrence 1DOT5_1:1714:1228: scene=1DOT5_1
#: 1DOT5_1:1714
msgctxt "text_id=1228 | speaker=unknown"
msgid "  A small bird had apparently flown into the telephone pole before landing on his head."
msgstr "　電柱にぶつかって墜ちてきた小鳥に、歩いていた自分がぶつかってしまったらしい。"

#. Occurrence 1DOT5_1:1739:1229: scene=1DOT5_1
#: 1DOT5_1:1739
msgctxt "text_id=1229 | speaker=unknown"
msgid "  The starling cleaned itself off and flew away."
msgstr "　ムクドリは路面で<毛繕|けづくろ>いをした後、あわただしく飛んでいった。"

#. Occurrence 1DOT5_1:1744:1230: scene=1DOT5_1
#: 1DOT5_1:1744
msgctxt "text_id=1230 | speaker=unknown"
msgid "  The falling of the bird"
msgstr "　鳥が墜ちてくるコトも、"

#. Occurrence 1DOT5_1:1749:1231: scene=1DOT5_1
#: 1DOT5_1:1749
msgctxt "text_id=1231 | speaker=unknown"
msgid "  and its desperate escape thereafter"
msgstr "　その後、慌てるように飛び去っていくコトも、"

#. Occurrence 1DOT5_1:1754:1232: scene=1DOT5_1
#: 1DOT5_1:1754
msgctxt "text_id=1232 | speaker=unknown"
msgid "  was unlike anything he had experienced in his life up to now."
msgstr "　彼の今までの生活、今までの常識にはなかった事だ。"

#. Occurrence 1DOT5_1:1774:1233: scene=1DOT5_1
#: 1DOT5_1:1774
msgctxt "text_id=1233 | speaker=unknown"
msgid "  Most of the townsfolk would have seen the incident as unlucky, ominous, or even sinister, but Soujyuro just nodded and went about his business."
msgstr "　町の人間なら『墜ちてきた鳥に当たる』なんて不運、奇遇に、不吉なものを感じるのだろうが、草十郎はなるほど、とうなずいて帰路についた。"

#. Occurrence 1DOT5_1:1793:1234: scene=1DOT5_1
#: 1DOT5_1:1793
msgctxt "text_id=1234 | speaker=unknown"
msgid "  You must understand..."
msgstr "　―――なに。"

#. Occurrence 1DOT5_1:1798:1235: scene=1DOT5_1
#: 1DOT5_1:1798
msgctxt "text_id=1235 | speaker=unknown"
msgid "  What might have been a first for him was surely an everyday occurrence for these city folk."
msgstr "　自分にとっては初めての経験だったが、都会ではよくある事に違いない。"

#. Occurrence 1DOT5_2:78:1236: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0000; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:78
msgctxt "text_id=1236 | speaker=aoko"
msgid "\"I'm home! Alice, you here yet?"
msgstr "「たっだいまー！　ねぇ、有珠帰ってるー？"

#. Occurrence 1DOT5_2:84:1237: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0001; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:84
msgctxt "text_id=1237 | speaker=aoko"
msgid "  I got some stuff from the arcade while on the way home from church!"
msgstr "　教会から帰る時、商店街でお土産もらっちゃったー！"

#. Occurrence 1DOT5_2:84:1238: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0001; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:84
msgctxt "text_id=1238 | speaker=aoko"
msgid "  They're Iseya rice crackers, you wanna share some?\""
msgstr "　<伊|い><勢|せ><屋|や>の<煎餅|せんべい>、一緒に食べないー！？」"

#. Occurrence 1DOT5_2:116:1239: scene=1DOT5_2
#: 1DOT5_2:116
msgctxt "text_id=1239 | speaker=unknown"
msgid "  Her voice reverberated through the foyer dyed in the colors of the setting sun."
msgstr "　夕日色に染まったロビーに<弾|はず>んだ声が響く。"

#. Occurrence 1DOT5_2:121:1240: scene=1DOT5_2
#: 1DOT5_2:121
msgctxt "text_id=1240 | speaker=unknown"
msgid "  It was after five in the afternoon when Aoko, still in her school uniform, cheerfully returned home."
msgstr "　制服姿の青子が元気よく帰ってきたのは午後五時過ぎ。"

#. Occurrence 1DOT5_2:126:1241: scene=1DOT5_2
#: 1DOT5_2:126
msgctxt "text_id=1241 | speaker=unknown"
msgid "  She had finished her student council duties and attended her monthly meeting with the church."
msgstr "　生徒会の雑務と、月に一度の教会との<折衝|せっしょう>を終えてからの帰宅だった。"

#. Occurrence 1DOT5_2:161:1242: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0000; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:161
msgctxt "text_id=1242 | speaker=alice"
msgid "\"...Welcome back."
msgstr "「……おかえりなさい。"

#. Occurrence 1DOT5_2:167:1243: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0001; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:167
msgctxt "text_id=1243 | speaker=alice"
msgid "  I see that the meeting went as planned.\""
msgstr "　その様子なら何事もなく終わったみたいね、青子」"

#. Occurrence 1DOT5_2:173:1244: scene=1DOT5_2
#: 1DOT5_2:173
msgctxt "text_id=1244 | speaker=unknown"
msgid "  The voice was coming from the second floor."
msgstr "　出迎えの声は二階から。"

#. Occurrence 1DOT5_2:178:1245: scene=1DOT5_2
#: 1DOT5_2:178
msgctxt "text_id=1245 | speaker=unknown"
msgid "  In contrast with Aoko and her boundless energy, a considerably calmer girl descended from above."
msgstr "　活力に満ちた青子とは対照的な、静けさの化身じみた少女が下りてくる。"

#. Occurrence 1DOT5_2:210:1246: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0002; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:210
msgctxt "text_id=1246 | speaker=aoko"
msgid "\"There were some complaints but all in all it went well."
msgstr "「難癖はつけられたけど、<滞|とどこお>りなく。"

#. Occurrence 1DOT5_2:216:1247: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0003; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:216
msgctxt "text_id=1247 | speaker=aoko"
msgid "  Our problems are ours alone, so I decided not to get them involved. You okay with that, Alice?\""
msgstr "　うちの問題はうちの問題だから、今回も手はださないって方向でまとまったわ。……それでいいのよね、有珠？」"

#. Occurrence 1DOT5_2:234:1248: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0002; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:234
msgctxt "text_id=1248 | speaker=alice"
msgid "\"...Yes. I'd ask for their help in a pinch, but they can't be trusted. We'll call on them to clean up the mess, as usual.\""
msgstr "「……ええ。ネコの手なら借りたいけど、あの人たちの手は信用ならないし。いつも通り、後処理だけお願いしましょう」"

#. Occurrence 1DOT5_2:268:1249: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0004; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:268
msgctxt "text_id=1249 | speaker=aoko"
msgid "\"Agreed. No one likes to have to keep looking over their shoulder. We can't fully commit to this if we're worried about what's going on elsewhere.\""
msgstr "「賛成。後ろからバッサリやられかねないしね。だいたい、私もアンタも背中を気にして没頭できる柄じゃないし」"

#. Occurrence 1DOT5_2:286:1250: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0003; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:286
msgctxt "text_id=1250 | speaker=alice"
msgid "\"...Well, I can, but..."
msgstr "「……わたしはできるけど。"

#. Occurrence 1DOT5_2:292:1251: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0004; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:292
msgctxt "text_id=1251 | speaker=alice"
msgid "  You don't have time for that, do you, Aoko?\""
msgstr "　青子は単に、まだそれほどの余裕がないだけでしょう」"

#. Occurrence 1DOT5_2:298:1252: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0005; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:298
msgctxt "text_id=1252 | speaker=aoko"
msgid "\"Hmph.\""
msgstr "「む」"

#. Occurrence 1DOT5_2:333:1253: scene=1DOT5_2
#: 1DOT5_2:333
msgctxt "text_id=1253 | speaker=unknown"
msgid "  Tap, tap."
msgstr "　かつん、かつん。"

#. Occurrence 1DOT5_2:338:1254: scene=1DOT5_2
#: 1DOT5_2:338
msgctxt "text_id=1254 | speaker=unknown"
msgid "  With the graceful sounds of her steps, Alice entered the foyer."
msgstr "　階段を下りる足音も<淑|しと>やかに、久遠寺有珠はロビーに到達する。"

#. Occurrence 1DOT5_2:343:1255: scene=1DOT5_2
#: 1DOT5_2:343
msgctxt "text_id=1255 | speaker=unknown"
msgid "  ...As she did, Aoko's eyes were directed toward the skylight above."
msgstr "　……その途中、天井の窓ガラスに目をやった事を青子は見逃さない。"

#. Occurrence 1DOT5_2:377:1256: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0006; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:377
msgctxt "text_id=1256 | speaker=aoko"
msgid "\"The glass is kind of dirty.\""
msgstr "「ガラス、<曇|くも>ってるわね」"

#. Occurrence 1DOT5_2:383:1257: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0005; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:383
msgctxt "text_id=1257 | speaker=alice"
msgid "\"I wanted to discuss that. After today's business is concluded, that is."
msgstr "「その事で話があるわ。今日の課題が終わったら、だけど。"

#. Occurrence 1DOT5_2:401:1258: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0006; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:401
msgctxt "text_id=1258 | speaker=alice"
msgid "  ...Are you feeling okay, Aoko? You can rest if you're not.\""
msgstr "　……青子、体の調子は？　疲れているなら休みを入れてもいいけど」"

#. Occurrence 1DOT5_2:407:1259: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0007; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:407
msgctxt "text_id=1259 | speaker=aoko"
msgid "\"Huh? Oh, don't be such a nag. I'm not stressed or anything. Today was pretty normal. Do I look that tired?\""
msgstr "「え？　なによ、気味悪いなあ。気遣いされるコトなんてないってば。いつも通りの一日だったし、そんな疲れた顔してる、私？」"

#. Occurrence 1DOT5_2:456:1260: scene=1DOT5_2
#: 1DOT5_2:456
msgctxt "text_id=1260 | speaker=unknown"
msgid "  As school activities went, today's were a breeze."
msgstr "　そう。あえて言うなら、本日の学園生活、順風にして波高し。"

#. Occurrence 1DOT5_2:485:1261: scene=1DOT5_2
#: 1DOT5_2:485
msgctxt "text_id=1261 | speaker=unknown"
msgid "  At a glance, her school life might have seemed almost idyllic."
msgstr "　ざっと<俯瞰|ふかん>すればいつも通りの平和なスクールライフで、"

#. Occurrence 1DOT5_2:521:1262: scene=1DOT5_2
#: 1DOT5_2:521
msgctxt "text_id=1262 | speaker=unknown"
msgid "  Though the more she thought about it, some headache-inducing incidents may have stood out here and there."
msgstr "　よくよく思い返すと微妙に頭の痛い出来事があったりして、"

#. Occurrence 1DOT5_2:556:1263: scene=1DOT5_2
#: 1DOT5_2:556
msgctxt "text_id=1263 | speaker=unknown"
msgid "  And with some sincere introspection, Aoko might have recognized the signs of her own mental fatigue, but doing so would have further added to her stress."
msgstr "　つきつめると精神的にちょい疲れているけど、それを意識するとよけい疲れるので避けたい青子なのだった。"

#. Occurrence 1DOT5_2:600:1264: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0008; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:600
msgctxt "text_id=1264 | speaker=aoko"
msgid "\"Okay, enough about that. I didn't come home just to stress out over school."
msgstr "「……ストップ。なんで帰って来てまで、あんなののコトで疲れなくちゃいけないんだ、私。"

#. Occurrence 1DOT5_2:611:1265: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0009; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:611
msgctxt "text_id=1265 | speaker=aoko"
msgid "  What were we learning about today...? Mesmerize basics, right? 'Wish'? "
msgstr "　えっと、今日の課題って初歩の<暗示|ウィッシュ>でしょ？"

#. Occurrence 1DOT5_2:622:1266: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0010; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:622
msgctxt "text_id=1266 | speaker=aoko"
msgid "  Then let's get started. I feel like I could master anything today.\""
msgstr "　問題ないわ、すぐ始めましょ。今日はなんか、勢いでうまくいきそうな気もするし」"

#. Occurrence 1DOT5_2:628:1267: scene=1DOT5_2
#: 1DOT5_2:628
msgctxt "text_id=1267 | speaker=unknown"
msgid "  Aoko focused on shedding her anger and stress,"
msgstr "　おもに怒りとか、ストレス発散の方向で。"

#. Occurrence 1DOT5_2:664:1268: scene=1DOT5_2
#: 1DOT5_2:664
msgctxt "text_id=1268 | speaker=unknown"
msgid "  and headed upstairs with gusto."
msgstr "　青子はよし、と気合いをいれて二階に向かう。"

#. Occurrence 1DOT5_2:670:1269: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0011; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:670
msgctxt "text_id=1269 | speaker=aoko"
msgid "\"Aren't you coming? I thought we were going to do it in your room, Alice?\""
msgstr "「どうしたのよ。有珠の部屋でやるんじゃないの？」"

#. Occurrence 1DOT5_2:676:1270: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0007; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:676
msgctxt "text_id=1270 | speaker=alice"
msgid "\"...\""
msgstr "「――――――」"

#. Occurrence 1DOT5_2:681:1271: scene=1DOT5_2
#: 1DOT5_2:681
msgctxt "text_id=1271 | speaker=unknown"
msgid "  The formally dressed Alice nodded in slight dissatisfaction."
msgstr "　礼服の少女はそうだけど、とやや不満そうにうなずいて、"

#. Occurrence 1DOT5_2:698:1272: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0008; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:698
msgctxt "text_id=1272 | speaker=alice"
msgid "\"Are we going to eat those Iseya rice crackers today, or...?\""
msgstr "「それで、伊勢屋の煎餅って、今日の？」"

#. Occurrence 1DOT5_2:703:1273: scene=1DOT5_2
#: 1DOT5_2:703
msgctxt "text_id=1273 | speaker=unknown"
msgid "  She looked at the freshly baked treats Aoko was holding."
msgstr "　青子の手にある、今日できあがったばかりの和菓子を見つめるのだった。"

#. Occurrence 1DOT5_2:762:1274: scene=1DOT5_2
#: 1DOT5_2:762
msgctxt "text_id=1274 | speaker=unknown"
msgid "  In the end, their lesson took place after Alice had her cup of tea."
msgstr "　結局、日課である有珠の授業は、軽くお茶をした後に行われた。"

#. Occurrence 1DOT5_2:767:1275: scene=1DOT5_2
#: 1DOT5_2:767
msgctxt "text_id=1275 | speaker=unknown"
msgid "  For an apprentice like Aoko, Alice Kuonji was the kind of roommate and teacher that was hard to come by."
msgstr "　まだまだ見習いである青子にとって、久遠寺有珠は同居人であると同時に得難い教師である。"

#. Occurrence 1DOT5_2:772:1276: scene=1DOT5_2
#: 1DOT5_2:772
msgctxt "text_id=1276 | speaker=unknown"
msgid "  If she insisted that Aoko rest to preserve her health, Aoko had no choice but to comply."
msgstr "　彼女が青子の健康をいたわって休みを入れると判断したのなら、大人しく従うしかない。"

#. Occurrence 1DOT5_2:804:1277: scene=1DOT5_2
#: 1DOT5_2:804
msgctxt "text_id=1277 | speaker=unknown"
msgid "  The lesson was over after two hours, so the two finished the dinner they had prepared and decided on a change of venue for where they would spend the last hours of the day."
msgstr "　授業は二時間で終了し、ふたりはそれぞれ用意しておいた夕食を済ませ、一日の締めである夕食後のひとときを過ごそう、と<河岸|かし>を変えた。"

#. Occurrence 1DOT5_2:837:1278: scene=1DOT5_2
#: 1DOT5_2:837
msgctxt "text_id=1278 | speaker=unknown"
msgid "  The sunroom was next to the drawing room in the east wing of the residence and offered a view of the beautiful grounds."
msgstr "　サンルームは居間のとなり、美しい庭園が見渡せる屋敷の東側にあった。"

#. Occurrence 1DOT5_2:842:1279: scene=1DOT5_2
#: 1DOT5_2:842
msgctxt "text_id=1279 | speaker=unknown"
msgid "  The proud Kuonji estate's luxurious sunroom featured furnishings on par with those in the splendid drawing room. Meanwhile..."
msgstr "　豪華な居間に負けず劣らず、細かな気遣いと格調高い調度品で飾られた久遠寺邸自慢のサンルームは、しかし。"

#. Occurrence 1DOT5_2:877:1280: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0012; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:877
msgctxt "text_id=1280 | speaker=aoko"
msgid "\"It's going to be a jungle come next year's summer.\""
msgstr "「来年の夏はジャングルね、この分だと」"

#. Occurrence 1DOT5_2:883:1281: scene=1DOT5_2
#: 1DOT5_2:883
msgctxt "text_id=1281 | speaker=unknown"
msgid "  The grounds outside had fallen into disrepair, neglected by the owner."
msgstr "　庭掃除という<意識|コマンド>が欠如した住人のせいで、色々と台無しだった。"

#. Occurrence 1DOT5_2:915:1282: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0013; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:915
msgctxt "text_id=1282 | speaker=aoko"
msgid "\"Don't you have any landscaping Ploys lying around, Alice?\""
msgstr "「ねえ有珠、庭掃除専用のプロイとかいないの？」"

#. Occurrence 1DOT5_2:923:1283: scene=1DOT5_2
#: 1DOT5_2:923
msgctxt "text_id=1283 | speaker=unknown"
msgid "  Aoko took a step into the sunroom and poured some tea."
msgstr "　一足先にサンルームに入り、ティーポットから紅茶を淹れる青子。"

#. Occurrence 1DOT5_2:956:1284: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0009; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:956
msgctxt "text_id=1284 | speaker=alice"
msgid "\"I'm sure I could find one, but it would take some effort.\""
msgstr "「探せばいるかもしれないけど、少し手間ね」"

#. Occurrence 1DOT5_2:962:1285: scene=1DOT5_2
#: 1DOT5_2:962
msgctxt "text_id=1285 | speaker=unknown"
msgid "  Playing along with her roommate's joke, Alice made to sit in her chair,"
msgstr "　同居人の<戯|ざ>れ言を流しながら、有珠も自分用の椅子に座ろうとし、"

#. Occurrence 1DOT5_2:976:1286: scene=1DOT5_2
#: 1DOT5_2:976
msgctxt "text_id=1286 | speaker=unknown"
msgid "  just as she caught sight of the box of chocolates on the table. Her lovely eyes narrowed in a frown."
msgstr "　テーブルの上に置かれたチョコレイトの箱を見て、<可憐|かれん>な眉を曇らせた。"

#. Occurrence 1DOT5_2:1014:1287: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0014; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1014
msgctxt "text_id=1287 | speaker=aoko"
msgid "\"D-Don't be like that. Today's screw-up was half your fault, you know?"
msgstr "「な、なによ。言っとくけど、今日の失敗は半分有珠のせいよ？"

#. Occurrence 1DOT5_2:1026:1288: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0015; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1026
msgctxt "text_id=1288 | speaker=aoko"
msgid "  Maybe the rice crackers threw us off our game, or maybe it was me being too aggressive that turned that Wish into a Gandr, but still...\""
msgstr "　お煎餅で気が<緩|ゆる>んだのが敗因っていうか、そりゃ、<暗|ウィ><示|ッシュ>のつもりがガンドになっちゃったのは、我ながら攻撃的すぎると思うけど……」"

#. Occurrence 1DOT5_2:1037:1289: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0010; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:1037
msgctxt "text_id=1289 | speaker=alice"
msgid "\"We're down six pieces.\""
msgstr "「六個、減ってるわ」"

#. Occurrence 1DOT5_2:1048:1290: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0016; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1048
msgctxt "text_id=1290 | speaker=aoko"
msgid "\"We are? Wait, that's what you're upset about?\""
msgstr "「え？　なんだ、そっちのコトか」"

#. Occurrence 1DOT5_2:1073:1291: scene=1DOT5_2
#: 1DOT5_2:1073
msgctxt "text_id=1291 | speaker=unknown"
msgid "  Aoko's eyes stared intently at the box of chocolates."
msgstr "　青子はどれどれ、とチョコレイトの箱をのぞき見る。"

#. Occurrence 1DOT5_2:1091:1292: scene=1DOT5_2
#: 1DOT5_2:1091
msgctxt "text_id=1292 | speaker=unknown"
msgid "  You could search the world and never find a finer selection of chocolates."
msgstr "　世界中さがしても、この街の、この洋館にしかない高級洋菓子。"

#. Occurrence 1DOT5_2:1096:1293: scene=1DOT5_2
#: 1DOT5_2:1096
msgctxt "text_id=1293 | speaker=unknown"
msgid "  The brand was Sixpence Songs, apparently."
msgstr "　銘柄は<６|シックス>ペンスの唄、と言うらしい。"

#. Occurrence 1DOT5_2:1133:1294: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0017; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1133
msgctxt "text_id=1294 | speaker=aoko"
msgid "\"So, what was it about the mirror you wanted to talk about?"
msgstr "「で、鏡の話をするんだっけ？"

#. Occurrence 1DOT5_2:1140:1295: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0018; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1140
msgctxt "text_id=1295 | speaker=aoko"
msgid "  It's still in Misaki mode, right? Not mansion mode?\""
msgstr "　アレ、いま洋館モードから三咲モードになってるんでしょ？」"

#. Occurrence 1DOT5_2:1153:1296: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0011; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:1153
msgctxt "text_id=1296 | speaker=alice"
msgid "\"Yes. The mansion can take care of itself for the time being, so I changed its target to Misaki City. ...Things have been cloudy there since yesterday."
msgstr "「ええ。ここの管理はおざなりになるけど、三咲市だけに切り替えたわ。……それが昨日から曇りだしている。"

#. Occurrence 1DOT5_2:1159:1297: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0012; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:1159
msgctxt "text_id=1297 | speaker=alice"
msgid "  Now I know for certain that with each passing day, the forces arrayed against us grow.\""
msgstr "　少しずつだけど、確実に包囲されてるわね」"

#. Occurrence 1DOT5_2:1194:1298: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0019; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1194
msgctxt "text_id=1298 | speaker=aoko"
msgid "\"You mean there's more of those things?\""
msgstr "「包囲って、数が増えたってコト？」"

#. Occurrence 1DOT5_2:1200:1299: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0013; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:1200
msgctxt "text_id=1299 | speaker=alice"
msgid "\"There's the one who was captured, and I've witnessed two other suspicious types. One in the city and one in the woods outside of town.\""
msgstr "「捕捉していた一名はもちろん、他にもう二名ほど不審者を目撃済み。都市部に一、郊外の森に二ね」"

#. Occurrence 1DOT5_2:1233:1300: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0020; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1233
msgctxt "text_id=1300 | speaker=aoko"
msgid "\"Ugh. Is it too much to ask that you could be wrong, just this once?"
msgstr "「はあ。アンタの目撃談はアテになるからなあ。"

#. Occurrence 1DOT5_2:1239:1301: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0021; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1239
msgctxt "text_id=1301 | speaker=aoko"
msgid "  Which one is causing the biggest ruckus?\""
msgstr "　で、うるさいのはどっち？」"

#. Occurrence 1DOT5_2:1245:1302: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0014; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:1245
msgctxt "text_id=1302 | speaker=alice"
msgid "\"...The one in the woods. I'm getting close to capturing it, but it knows it's being watched. It's not taking the bait.\""
msgstr "「……森の方。捕捉中だけど、こっちの目に気づいているみたい。なかなか誘いに乗ってこないわ」"

#. Occurrence 1DOT5_2:1261:1303: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0022; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1261
msgctxt "text_id=1303 | speaker=aoko"
msgid "\"I see..."
msgstr "「そっか。"

#. Occurrence 1DOT5_2:1268:1304: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0023; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1268
msgctxt "text_id=1304 | speaker=aoko"
msgid "You wanna go after it tonight?\""
msgstr "じゃあ今夜、仕掛ける？」"

#. Occurrence 1DOT5_2:1289:1305: scene=1DOT5_2
#: 1DOT5_2:1289
msgctxt "text_id=1305 | speaker=unknown"
msgid "  To go after it tonight..."
msgstr "“今夜、仕掛ける”"

#. Occurrence 1DOT5_2:1295:1306: scene=1DOT5_2
#: 1DOT5_2:1295
msgctxt "text_id=1306 | speaker=unknown"
msgid "  One simple suggestion that would change the course of her life forever."
msgstr "　それは彼女の人生を大きく、それこそまったく別のものに変化させる一大行事だ。"

#. Occurrence 1DOT5_2:1300:1307: scene=1DOT5_2
#: 1DOT5_2:1300
msgctxt "text_id=1307 | speaker=unknown"
msgid "  It was no overstatement to say that this was a roll of the dice that would decide whether she had the moxie to survive the experience of jumping out of a plane with a torn parachute."
msgstr "　大げさではなく、穴のあいたパラシュートで自由落下するぐらいの覚悟と冒険、適応資格アリナシを決めるダイス勝負。"

#. Occurrence 1DOT5_2:1320:1308: scene=1DOT5_2
#: 1DOT5_2:1320
msgctxt "text_id=1308 | speaker=unknown"
msgid "  Aoko swallowed her hesitation and fear with a little tea."
msgstr "　その恐れと迷いを、青子は紅茶と共にあっさり飲み下した。"

#. Occurrence 1DOT5_2:1325:1309: scene=1DOT5_2
#: 1DOT5_2:1325
msgctxt "text_id=1309 | speaker=unknown"
msgid "  On the school's anniversary night, she declared that she had made up her mind, and from that time on, she would not waver."
msgstr "　高校の創立記念日の夜、「もう決めた」と宣言して以来、彼女は心身共にキレイさっぱり切り替わっている。"

#. Occurrence 1DOT5_2:1331:1310: scene=1DOT5_2
#: 1DOT5_2:1331
msgctxt "text_id=1310 | speaker=unknown"
msgid "  Alice welcomed her roommate's strength with the barest hint of regret."
msgstr "　そんな同居人の強さを、有珠は伏し目がちに受け入れた。"

#. Occurrence 1DOT5_2:1364:1311: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0015; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:1364
msgctxt "text_id=1311 | speaker=alice"
msgid "\"...\""
msgstr "「………………」"

#. Occurrence 1DOT5_2:1370:1312: scene=1DOT5_2
#: 1DOT5_2:1370
msgctxt "text_id=1312 | speaker=unknown"
msgid "  As someone who shared the same motivations as her, Alice was ultimately reassured by Aoko's resolve."
msgstr "　同居人の心のあり方は、同じ目的を持つ者として心強い。"

#. Occurrence 1DOT5_2:1375:1313: scene=1DOT5_2
#: 1DOT5_2:1375
msgctxt "text_id=1313 | speaker=unknown"
msgid "  Well, perhaps more pleased than reassured."
msgstr "　いや、心強い、というより喜ばしい。"

#. Occurrence 1DOT5_2:1380:1314: scene=1DOT5_2
#: 1DOT5_2:1380
msgctxt "text_id=1314 | speaker=unknown"
msgid "  All in all it had taken the better part of a year, but finally Aoko had stepped out of Alice's shadow."
msgstr "　なにしろ一年かけて、ようやく彼女が自分と同じステージに立ったのだから。"

#. Occurrence 1DOT5_2:1413:1315: scene=1DOT5_2
#: 1DOT5_2:1413
msgctxt "text_id=1315 | speaker=unknown"
msgid "  The two partners now shared the same fate."
msgstr "　奇しくも同じ<結末|うんめい>を持った隣人。"

#. Occurrence 1DOT5_2:1418:1316: scene=1DOT5_2
#: 1DOT5_2:1418
msgctxt "text_id=1316 | speaker=unknown"
msgid "  Aoko was not the partner Alice had asked for, but a partner nonetheless."
msgstr "　けれど相容れない相手。"

#. Occurrence 1DOT5_2:1423:1317: scene=1DOT5_2
#: 1DOT5_2:1423
msgctxt "text_id=1317 | speaker=unknown"
msgid "  Strangers, worlds apart."
msgstr "　所詮分かり合えない他人。"

#. Occurrence 1DOT5_2:1428:1318: scene=1DOT5_2
#: 1DOT5_2:1428
msgctxt "text_id=1318 | speaker=unknown"
msgid "  And even if eventually they would battle each other to the death using all they had inherited, it was only right they did it on equal terms."
msgstr "　いずれ、互いが受け継いだ全ての遺産をもって殺し合う関係だとしても、まず対等にならなければ意味がない。"

#. Occurrence 1DOT5_2:1434:1319: scene=1DOT5_2
#: 1DOT5_2:1434
msgctxt "text_id=1319 | speaker=unknown"
msgid "  It was, at least for now, a cause for celebration over how far Aoko had come."
msgstr "　だから今は、彼女の成長を喜ぶのが正しいのだ。"

#. Occurrence 1DOT5_2:1468:1320: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0016; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:1468
msgctxt "text_id=1320 | speaker=alice"
msgid "\"...Generous, but I'll be fine on my own tonight."
msgstr "「……折角だけど、今夜はわたしひとりで十分よ。"

#. Occurrence 1DOT5_2:1479:1321: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0017; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:1479
msgctxt "text_id=1321 | speaker=alice"
msgid "  The time would be better spent practicing Mesmerize a little more. The park is under your jurisdiction, so I'll put you to work when the time comes.\""
msgstr "　そんな余裕があるのなら、貴女はもう少し暗示の練習をするべきね。公園は貴女の担当だから、その時は働いてもらうけど」"

#. Occurrence 1DOT5_2:1499:1322: scene=1DOT5_2
#: 1DOT5_2:1499
msgctxt "text_id=1322 | speaker=unknown"
msgid "  Alice did not so much as look at Aoko as she explained her reasons."
msgstr "　有珠は青子を見ずに淡々と説明する。"

#. Occurrence 1DOT5_2:1504:1323: scene=1DOT5_2
#: 1DOT5_2:1504
msgctxt "text_id=1323 | speaker=unknown"
msgid "  The scale of the enemy she would face that night..."
msgstr "　今夜の敵の規模。"

#. Occurrence 1DOT5_2:1509:1324: scene=1DOT5_2
#: 1DOT5_2:1509
msgctxt "text_id=1324 | speaker=unknown"
msgid "  Her plans for Aoko..."
msgstr "　今後の予定。"

#. Occurrence 1DOT5_2:1514:1325: scene=1DOT5_2
#: 1DOT5_2:1514
msgctxt "text_id=1325 | speaker=unknown"
msgid "  For in only two days from now, Aoko Aozaki would be reborn."
msgstr "　おそらく二日後あたりになるであろう、蒼崎青子の<新|・><し|・><い|・>誕生日について。"

#. Occurrence 1DOT5_2:1549:1326: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0024; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1549
msgctxt "text_id=1326 | speaker=aoko"
msgid "\"Fine. Whatever you say.\""
msgstr "「はいはい、わかりました」"

#. Occurrence 1DOT5_2:1555:1327: scene=1DOT5_2
#: 1DOT5_2:1555
msgctxt "text_id=1327 | speaker=unknown"
msgid "  Aoko finished her tea and stood up from her seat."
msgstr "　紅茶を飲み干し、席を立つ青子。"

#. Occurrence 1DOT5_2:1581:1328: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0025; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1581
msgctxt "text_id=1328 | speaker=aoko"
msgid "\"I guess I'm practicing, then."
msgstr "「お言葉通り、暗示の練習でもやってるわ。"

#. Occurrence 1DOT5_2:1587:1329: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0026; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1587
msgctxt "text_id=1329 | speaker=aoko"
msgid "  Uhm, how did the first part go again? 'Be light and frail, nimble and fast. Tick-tock, tick-tock, there's no time to waste.' That right?\""
msgstr "　えーと、一節目はたしか、“軽く、弱く。巧く、速く。チクタクチクタク　急げや急げ”よね？」"

#. Occurrence 1DOT5_2:1593:1330: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0018; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:1593
msgctxt "text_id=1330 | speaker=alice"
msgid "\"Ugh, no. You're missing the quiet part. Remember, 'the weight of the air, the tremble of one's breast. Light lags behind while shadows pull ahead.'"
msgstr "「……はあ。そこは“空<気のおも|かるく　よわく>り、<胸のふるえ|うまく　はやく>。ひ<かりは|いそげやい><遅|そげ>れる、か<げは先立|チクタクチクタク>つ”よ。"

#. Occurrence 1DOT5_2:1599:1331: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0019; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:1599
msgctxt "text_id=1331 | speaker=alice"
msgid "  Be careful. Or you may find yourself in a state of unease.\""
msgstr "　気をつけなさい。それだと逆に落ち着かなくなるわ」"

#. Occurrence 1DOT5_2:1625:1332: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0027; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1625
msgctxt "text_id=1332 | speaker=aoko"
msgid "\"Yeah, yeah, I remember now. Now, if you'll excuse me...\""
msgstr "「そうだったそうだった。んじゃ、ひとつ失礼」"

#. Occurrence 1DOT5_2:1631:1333: scene=1DOT5_2
#: 1DOT5_2:1631
msgctxt "text_id=1333 | speaker=unknown"
msgid "  Aoko grabbed a piece of chocolate and popped it into her mouth."
msgstr "　チョコをひとつ<摘|つ>んで、ぽいっと口に<放|ほう>る。"

#. Occurrence 1DOT5_2:1665:1334: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0020; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:1665
msgctxt "text_id=1334 | speaker=alice"
msgid "\"......\""
msgstr "「……………………」"

#. Occurrence 1DOT5_2:1671:1335: scene=1DOT5_2
#: 1DOT5_2:1671
msgctxt "text_id=1335 | speaker=unknown"
msgid "  She waved before leaving Alice alone in silence."
msgstr "　手を振ってサンルームを去る青子を、有珠は無言で見送る。"

#. Occurrence 1DOT5_2:1685:1336: scene=1DOT5_2
#: 1DOT5_2:1685
msgctxt "text_id=1336 | speaker=unknown"
msgid "  Alice stiffened a moment before slamming the box of chocolates shut as if it could serve to scold Aoko for snacking."
msgstr "　少女はしばし固まったあと、同居人のつまみ食いを<咎|とが>めるように、カチリと乱暴にチョコレイトの箱を閉じた。"

#. Occurrence 1DOT5_3:190:1337: voice_id=C50_1DOT5_3_0000; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:190
msgctxt "text_id=1337 | speaker=unknown"
msgid "  GOOD MORNING."
msgstr "　―――オハヨウ　ゴザイマス。"

#. Occurrence 1DOT5_3:197:1338: voice_id=C50_1DOT5_3_0001; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:197
msgctxt "text_id=1338 | speaker=unknown"
msgid "  TIME CHECK: 00:00"
msgstr "　午前零時ヲ　確認　シマシタ。"

#. Occurrence 1DOT5_3:259:1339: voice_id=C50_1DOT5_3_0002; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:259
msgctxt "text_id=1339 | speaker=unknown"
msgid "  24 HOURS SINCE LAST UPDATE."
msgstr "　前回更新ヨリ　二十四時間　経過。"

#. Occurrence 1DOT5_3:265:1340: voice_id=C50_1DOT5_3_0003; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:265
msgctxt "text_id=1340 | speaker=unknown"
msgid "  RUNNING BACKUP... TRANSMITTING LOG..."
msgstr "　<安全管理|バックアップ>、開始。<行|レ><動|コ><記|ー><録|ド>、送信。"

#. Occurrence 1DOT5_3:271:1341: voice_id=C50_1DOT5_3_0004; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:271
msgctxt "text_id=1341 | speaker=unknown"
msgid "  COMMENCING LOCAL SCAN..."
msgstr "　周囲ノ地形ヲ　<再確認|スキャン>　シマス。"

#. Occurrence 1DOT5_3:344:1342: voice_id=C50_1DOT5_3_0005; voice_prefix=C50; voice_category=0; scene=1DOT5_3
