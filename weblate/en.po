#. Occurrence 8_EX:3676:11595: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0020; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:3676
msgctxt "text_id=11595 | speaker=tobimaru"
msgid "「？」"
