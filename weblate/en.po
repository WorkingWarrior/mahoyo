#. Occurrence 8_EX:2456:11513: scene=8_EX
#: 8_EX:2456
msgctxt "text_id=11513 | speaker=unknown"
msgid "　Ａ組男子を追い回すのも疲れたのか、木乃美はアゴをさすりながら戻ってきた。"
msgstr "  Rubbing his jaw, Kinomi returned to their side, tired of wasting his energy chasing after the Class A boys."

#. Occurrence 8_EX:2496:11514: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0014; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2496
msgctxt "text_id=11514 | speaker=kinomi"
msgid "「そんなコトより遊びにいこうぜー。"
