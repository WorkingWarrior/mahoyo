msgctxt "text_id=24093 | speaker=unknown"
msgid "久遠寺さんは本当に潔癖か？と思った。"
msgstr "Is Miss Kuonji a neat freak?"

msgctxt "text_id=24094 | speaker=unknown"
msgid "土桔氏はどうして誕生会を？と思った。"
msgstr "Why did Tokitsu come to this party?"

msgctxt "text_id=24095 | speaker=unknown"
msgid "殺人は二種類に分けられる？と思った。"
msgstr "Are there two types of murders?"

msgctxt "text_id=24096 | speaker=unknown"
msgid "律架さんのピッキング……！と思った。"
msgstr "Ritsuka's lockpicking skills!"

msgctxt "text_id=24097 | speaker=unknown"
msgid "名は体を表す、と思った。"
msgstr "Names define us."

msgctxt "text_id=24098 | speaker=unknown"
msgid "魔力とやらを持っているのは誰だ、と思った。"
msgstr "Who has magical energy?"

msgctxt "text_id=24099 | speaker=unknown"
msgid "プロイとやらを起動できたのは誰だ、と思った。"
msgstr "Who could activate a Ploy?"

msgctxt "text_id=24100 | speaker=unknown"
msgid "常にみんなに見られていたのは誰だ、と思った。"
msgstr "Who's always being watched by everyone?"

