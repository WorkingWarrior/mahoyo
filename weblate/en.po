#. Occurrence 8_EX:3930:11611: scene=8_EX
#: 8_EX:3930
msgctxt "text_id=11611 | speaker=unknown"
msgid "　お茶請けには砂糖をまぶした苺を完備。"
msgstr "  To accompany her tea, she had some strawberries dipped in sugar."

#. Occurrence 8_EX:3935:11612: scene=8_EX
#: 8_EX:3935
msgctxt "text_id=11612 | speaker=unknown"
msgid "　もう完全に自分だけの世界を形成している。"
msgstr "  She was in a world all her own."

#. Occurrence 8_EX:3968:11613: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0020; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:3968
msgctxt "text_id=11613 | speaker=soujuurou"
msgid "「つまり、一日中お茶を飲んでいるのか？」"
