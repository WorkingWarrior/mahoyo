msgid ""
msgstr ""
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Source-Language: ja\n"
"Language: en\n"

#. Occurrence 1_0:49:0: scene=1_0
#: 1_0:49
msgctxt "text_id=0 | speaker=unknown"
msgid "　その子の影になったのは８年前の冬のこと。"
msgstr "  It was a winter's day eight years ago..."

#. Occurrence 1_0:55:1: scene=1_0
#: 1_0:55
msgctxt "text_id=1 | speaker=unknown"
msgid "　彼女がはじめて命に<触|ふ>れた、<厳|しず>かな朝の出来事だ。"
msgstr "  That solemn morning when she understood the value of life for the very first time."

#. Occurrence 1_0:124:2: scene=1_0
#: 1_0:124
msgctxt "text_id=2 | speaker=unknown"
msgid "　彼女の家は山の<中腹|ちゅうふく>にあった。"
msgstr "  Her home was nestled on the side of a mountain."

#. Occurrence 1_0:130:3: scene=1_0
#: 1_0:130
msgctxt "text_id=3 | speaker=unknown"
msgid "　まわりは何もない荒れ地。"
msgstr "  Around it was nothing but inhospitable wilderness."

#. Occurrence 1_0:135:4: scene=1_0
#: 1_0:135
msgctxt "text_id=4 | speaker=unknown"
msgid "　おとなりに住む<幼馴染|おさななじ>みなんて望むべくもなく、学校に通うのも、遊びに出かけるのも不便なコトこの上ない。"
msgstr "  She had no neighbors or childhood friends to speak of. Things like traveling to school or playing outside were more trouble than they ought to be."

#. Occurrence 1_0:143:5: scene=1_0
#: 1_0:143
msgctxt "text_id=5 | speaker=unknown"
msgid "　けれど水も星も綺麗な、ちょっとの不満と大きな安らぎのある、思い出の家だった。"
msgstr "  Indeed, with its pure water and bright stars, it was a place rich with memories both frustrating and halcyon."

#. Occurrence 1_0:163:6: scene=1_0
#: 1_0:163
msgctxt "text_id=6 | speaker=unknown"
msgid "　もっとも、それは夏だけの話。"
msgstr "  That was only during summer, though."

#. Occurrence 1_0:172:7: scene=1_0
#: 1_0:172
msgctxt "text_id=7 | speaker=unknown"
msgid "　山中の冬は寒すぎて、朝はいつも辛かった。"
msgstr "  Winters in those mountains were extremely frigid, each morning more severe than the last."

#. Occurrence 1_0:177:8: scene=1_0
#: 1_0:177
msgctxt "text_id=8 | speaker=unknown"
msgid "　お父さんは自動車で駅まで送ってくれるけれど、"
msgstr "  Her father would drive her to the train station..."

#. Occurrence 1_0:177:9: scene=1_0
#: 1_0:177
msgctxt "text_id=9 | speaker=unknown"
msgid "　車の窓はびっしり<霜|しも>だらけで、出かける何十分か前にエンジンをかけないと走りだせない。"
msgstr "  ...after waiting ten minutes for the engine to warm up and the iced-over windows to clear."

#. Occurrence 1_0:205:10: voice_id=F70_1_0_0000_A; voice_prefix=F70; voice_category=0; scene=1_0
#: 1_0:205
msgctxt "text_id=10 | speaker=unknown"
msgid "「　　、キーを回してきてくれるかい？」"
msgstr "\"Mind starting up the car for me?\""

#. Occurrence 1_0:211:11: scene=1_0
#: 1_0:211
msgctxt "text_id=11 | speaker=unknown"
msgid "　お父さんが食後のコーヒーを楽しんでいる時、外に出て車のエンジンをかけるのが彼女の日課だった。"
msgstr "  Her father would savor his morning coffee, leaving her to venture outside and rev the engine."

#. Occurrence 1_0:231:12: scene=1_0
#: 1_0:231
msgctxt "text_id=12 | speaker=unknown"
msgid "　玄関を出て、白い息をはきながら庭を横ぎって、年代物のセダンのドアを開ける。"
msgstr "  Out the front door she would go, traversing the garden with icy breath, until she reached that old sedan."

#. Occurrence 1_0:237:13: scene=1_0
#: 1_0:237
msgctxt "text_id=13 | speaker=unknown"
msgid "　いつも通りにキーを差し込んでぐるりと回して、"
msgstr "  As always, she inserted the key, then started the ignition."

msgctxt "text_id=14 | speaker=unknown"
msgid "　ぶるるるる、とエンジンを振動させる。"
msgstr "The engine rumbled to life."

#. Occurrence 1_0:245:15: scene=1_0
#: 1_0:245
msgctxt "text_id=15 | speaker=unknown"
msgid "　そんな、今まで何十回とくり返してきた、小さな彼女の誇らしげな仕事が終わったとき。"
msgstr "  Just as she proudly finished that humble task she'd done so many times before..."

#. Occurrence 1_0:266:16: voice_id=C80_1_0_0000; voice_prefix=C80; voice_category=0; scene=1_0
#: 1_0:266
msgctxt "text_id=16 | speaker=unknown"
msgid "『■■■■■―――』"
msgstr "\"■■■■■―\""

#. Occurrence 1_0:272:17: scene=1_0
#: 1_0:272
msgctxt "text_id=17 | speaker=unknown"
msgid "　<甲|カン>高い悲鳴が<響|ひび>く。"
msgstr "  A shrill scream pierced the air."

#. Occurrence 1_0:277:18: scene=1_0
#: 1_0:277
msgctxt "text_id=18 | speaker=unknown"
msgid "　彼女は人間の言葉でもないのに、痛いと泣き叫ぶような、小さな小さな<音|こえ>を聞いた。"
msgstr "  She knew, even though it wasn't human, that the feeble sound was a cry of agony."

#. Occurrence 1_0:297:19: scene=1_0
#: 1_0:297
msgctxt "text_id=19 | speaker=unknown"
msgid "　数分後。"
msgstr "  A few moments passed."

#. Occurrence 1_0:303:20: scene=1_0
#: 1_0:303
msgctxt "text_id=20 | speaker=unknown"
msgid "お父さんが車のボンネットを開けると、そこにはひとつの命があった。"
msgstr "Her father came out and opened the hood of the car."

#. Occurrence 1_0:328:21: scene=1_0
#: 1_0:328
msgctxt "text_id=21 | speaker=unknown"
msgid "　ギチギチしたベルトとか、"
msgstr "  Creaking fan belts..."

#. Occurrence 1_0:333:22: scene=1_0
#: 1_0:333
msgctxt "text_id=22 | speaker=unknown"
msgid "　怪物みたいなエンジンが、"
msgstr "  A monstrous-looking engine..."

#. Occurrence 1_0:338:23: scene=1_0
#: 1_0:338
msgctxt "text_id=23 | speaker=unknown"
msgid "　びっちりと押しこまれたハコの中。"
msgstr "  And something that didn't belong."

#. Occurrence 1_0:344:24: scene=1_0
#: 1_0:344
msgctxt "text_id=24 | speaker=unknown"
msgid "　母親であろう猫と、二匹の子猫の姿は、あまりにも<場違|ばちが>いだった。"
msgstr "  There was a cat―a mother by the looks of it―and her two kittens."

#. Occurrence 1_0:364:25: scene=1_0
#: 1_0:364
msgctxt "text_id=25 | speaker=unknown"
msgid "　三匹の猫はエンジンルームの中で、寄りそうように丸まっていた。"
msgstr "  The three cats had been huddling for warmth in the engine's compartment."

#. Occurrence 1_0:370:26: scene=1_0
#: 1_0:370
msgctxt "text_id=26 | speaker=unknown"
msgid "　母親の猫は首から上がない。"
msgstr "  The mother cat was missing its head."

#. Occurrence 1_0:375:27: scene=1_0
#: 1_0:375
msgctxt "text_id=27 | speaker=unknown"
msgid "　子猫のうち一匹は、<機械|ベルト>に巻きこまれた部分が多すぎて動きがない。きっと即死だったろう。"
msgstr "  One of the kittens had been mangled beyond recognition by the engine belts, and surely died instantly."

#. Occurrence 1_0:395:28: scene=1_0
#: 1_0:395
msgctxt "text_id=28 | speaker=unknown"
msgid "　残った子猫は顔の半分を真っ赤にして、雨に濡れたやせ犬みたいに、ヒューヒューと息をしていた。"
msgstr "  The other kitten, its face half-covered in blood, panted faintly."

#. Occurrence 1_0:401:29: scene=1_0
#: 1_0:401
msgctxt "text_id=29 | speaker=unknown"
msgid "　子猫はその<亡骸|なきがら>―――いや、半ば肉片となった親猫に寄りそいながら、おそらくはあと数分たらずの命で、<懸命|けんめい>に懸命に、母親の胸にすがっていた。"
msgstr "  It desperately clung to its mother―or rather, the chunk of meat that had been its mother―with the last bit of life it could muster."

#. Occurrence 1_0:424:30: voice_id=F70_1_0_0001_A; voice_prefix=F70; voice_category=0; scene=1_0
#: 1_0:424
msgctxt "text_id=30 | speaker=unknown"
msgid "「かわいそうに―――」"
msgstr "\"Poor things.\""

#. Occurrence 1_0:430:31: scene=1_0
#: 1_0:430
msgctxt "text_id=31 | speaker=unknown"
msgid "　<悼|いた>むようなお父さんの声。"
msgstr "  Her father lamented their plight."

#. Occurrence 1_0:450:32: scene=1_0
#: 1_0:450
msgctxt "text_id=32 | speaker=unknown"
msgid "　昨夜の冷えこみは一段と厳しかった。"
msgstr "  The previous night had been especially cold."

#. Occurrence 1_0:455:33: scene=1_0
#: 1_0:455
msgctxt "text_id=33 | speaker=unknown"
msgid "　お父さんが車で帰ってきた後、エンジンの暖気に誘われて猫たちはボンネットに忍びこんだのだ。"
msgstr "  After he had returned home yesterday, the cats must have snuck under the hood, drawn by the warmth of the engine."

#. Occurrence 1_0:461:34: scene=1_0
#: 1_0:461
msgctxt "text_id=34 | speaker=unknown"
msgid "　彼らはエンジンルームで夜を明かし、"
msgstr "  They had slept next to the engine..."

msgctxt "text_id=35 | speaker=unknown"
msgid "　翌朝、ベルトの回転に巻きこまれて目を覚ました。"
msgstr "  ...and awoken to a storm of spinning belts."

#. Occurrence 1_0:469:36: scene=1_0
#: 1_0:469
msgctxt "text_id=36 | speaker=unknown"
msgid "　気密性の<乏|とぼ>しい80年代の車には、それなりにあった話らしい。"
msgstr "  Cars in the eighties were not sealed particularly well, so this was not unheard of."

#. Occurrence 1_0:497:37: voice_id=F70_1_0_0002_A; voice_prefix=F70; voice_category=0; scene=1_0
#: 1_0:497
msgctxt "text_id=37 | speaker=unknown"
msgid "「―――いいんだ。　　が悪いんじゃないんだよ」"
msgstr "\"...It's okay, ____. It wasn't your fault.\""

#. Occurrence 1_0:503:38: scene=1_0
#: 1_0:503
msgctxt "text_id=38 | speaker=unknown"
msgid "　お父さんの声が遠い。"
msgstr "  Her father's voice seemed distant."

#. Occurrence 1_0:523:39: scene=1_0
#: 1_0:523
msgctxt "text_id=39 | speaker=unknown"
msgid "　灰色にささくれだった子猫の毛並み。"
msgstr "  She could only make out a small tuft of the kitten's gray fur."

#. Occurrence 1_0:528:40: scene=1_0
#: 1_0:528
msgctxt "text_id=40 | speaker=unknown"
msgid "　母親と兄弟の血と、半身をけずられた自らの血で、"
msgstr "  The rest of it was caked in the blood of its mother and brother."

#. Occurrence 1_0:534:41: scene=1_0
#: 1_0:534
msgctxt "text_id=41 | speaker=unknown"
msgid "　　　　―――ああ、丸い頭蓋骨が見えている―――"
msgstr "        ...I can see its skull..."

#. Occurrence 1_0:549:42: scene=1_0
#: 1_0:549
msgctxt "text_id=42 | speaker=unknown"
msgid "　まだらに染まった小さな命。"
msgstr "  The fragile life of a speckled kitten..."

#. Occurrence 1_0:554:43: scene=1_0
#: 1_0:554
msgctxt "text_id=43 | speaker=unknown"
msgid "　子猫はもう目も見えないのか、<震|ふる>えながら、一心に死んだ母親の胸にくるまっている。"
msgstr "  Trembling and possibly blind, it continued to nuzzle against its dead mother's chest."

#. Occurrence 1_0:600:44: voice_id=F70_1_0_0003_A; voice_prefix=F70; voice_category=0; scene=1_0
#: 1_0:600
msgctxt "text_id=44 | speaker=unknown"
msgid "「　　……？　待ちなさい、　　―――！」"
msgstr "\"Hmm? ____, wait!\""

#. Occurrence 1_0:606:45: scene=1_0
#: 1_0:606
msgctxt "text_id=45 | speaker=unknown"
msgid "　彼女は子猫を抱き上げ、"
msgstr "  She took the kitten into her arms"

#. Occurrence 1_0:606:46: scene=1_0
#: 1_0:606
msgctxt "text_id=46 | speaker=unknown"
msgid "　山奥に別居している祖父の元へ走った。"
msgstr "  and ran deep into the mountains, to her grandfather's house."

#. Occurrence 1_0:612:47: scene=1_0
#: 1_0:612
msgctxt "text_id=47 | speaker=unknown"
msgid "　後悔で動揺していたのか、"
msgstr "  Was it because she was overcome with regret?"

#. Occurrence 1_0:617:48: scene=1_0
#: 1_0:617
msgctxt "text_id=48 | speaker=unknown"
msgid "　悲しくて混乱していたのか、正直、今でも分からない。"
msgstr "  Or was it the shock of grief? Years later, she still wasn't sure."

#. Occurrence 1_0:637:49: scene=1_0
#: 1_0:637
msgctxt "text_id=49 | speaker=unknown"
msgid "　彼女はこみあげる涙をせいいっぱい我慢しながら、祖父の工房に飛びこんだ。"
msgstr "  Fighting back the welling tears, she burst into her grandfather's workshop."

#. Occurrence 1_0:657:50: scene=1_0
#: 1_0:657
msgctxt "text_id=50 | speaker=unknown"
msgid "　祖父は何でもできる魔法使いだった。"
msgstr "  Her grandfather was a magician who could do anything."

#. Occurrence 1_0:662:51: scene=1_0
#: 1_0:662
msgctxt "text_id=51 | speaker=unknown"
msgid "　彼女自身「魔法」なんて見たコトもないし、おとぎ話の空想だと分かっていたけれど、そんな常識とは違う基準で、祖父はそういう生き物なんだと知っていた。"
msgstr "  She had never seen magic. She knew that magic was a fantasy straight out of fairy tales... but so was her grandfather."

#. Occurrence 1_0:676:52: scene=1_0
#: 1_0:676
msgctxt "text_id=52 | speaker=unknown"
msgid "　だから。"
msgstr "  She had to find him."

#. Occurrence 1_0:681:53: scene=1_0
#: 1_0:681
msgctxt "text_id=53 | speaker=unknown"
msgid "　祖父ならきっと、助けてくれると思ったのだ。"
msgstr "  He was the only one who could help."

#. Occurrence 1_0:703:54: voice_id=F60_1_0_0000; voice_prefix=F60; voice_category=0; scene=1_0
#: 1_0:703
msgctxt "text_id=54 | speaker=unknown"
msgid "『その子猫の運命を変えろと言う』"
msgstr "\"I suppose you want me to alter this kitten's fate,\""

#. Occurrence 1_0:734:55: scene=1_0
#: 1_0:734
msgctxt "text_id=55 | speaker=unknown"
msgid "　洞窟に<棲|す>む魔法使いは、関心のない声で言った。"
msgstr "  the cave-dwelling magician said indifferently."

#. Occurrence 1_0:754:56: scene=1_0
#: 1_0:754
msgctxt "text_id=56 | speaker=unknown"
msgid "　助けたい、と彼女は<懇願|こんがん>する。"
msgstr "  \"This kitten needs our help,\" she pleaded."

#. Occurrence 1_0:759:57: scene=1_0
#: 1_0:759
msgctxt "text_id=57 | speaker=unknown"
msgid "　魔法使いはおやすいご用だとも、"
msgstr "  Whether it was a simple task,"

#. Occurrence 1_0:764:58: scene=1_0
#: 1_0:764
msgctxt "text_id=58 | speaker=unknown"
msgid "　それは世界を<換|か>える<大事|だいじ>だとも言わず、"
msgstr "  or a herculean labor, her grandfather would not say."

#. Occurrence 1_0:770:59: scene=1_0
#: 1_0:770
msgctxt "text_id=59 | speaker=unknown"
msgid "　まるで機械みたいにあっさりと、彼女の身勝手な願いを叶えてやった。"
msgstr "  He simply granted the girl's childish wish, like a machine."

#. Occurrence 1_0:854:60: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A11_1_0_0000; voice_prefix=A11; voice_category=1; scene=1_0
#: 1_0:854
msgctxt "text_id=60 | speaker=aoko"
msgid "『…………あ』"
msgstr "\"...Oh no,\" the girl said."

#. Occurrence 1_0:860:61: scene=1_0
#: 1_0:860
msgctxt "text_id=61 | speaker=unknown"
msgid "　気が付くと彼女の手には小さな<亡骸|なきがら>。"
msgstr "  Before she knew it, however, she was holding a tiny corpse in her hands."

#. Occurrence 1_0:865:62: scene=1_0
#: 1_0:865
msgctxt "text_id=62 | speaker=unknown"
msgid "　冷えきった毛なみ。"
msgstr "  Its fur was cold."

#. Occurrence 1_0:870:63: scene=1_0
#: 1_0:870
msgctxt "text_id=63 | speaker=unknown"
msgid "　とうに命の温度は消えていた。"
msgstr "  The warmth of life had left its body."

#. Occurrence 1_0:875:64: scene=1_0
#: 1_0:875
msgctxt "text_id=64 | speaker=unknown"
msgid "　流すまいと<律|りっ>していた涙が、瞳からこぼれている。"
msgstr "  And the tears she had fought so hard to hold back poured from her eyes."

#. Occurrence 1_0:881:65: scene=1_0
#: 1_0:881
msgctxt "text_id=65 | speaker=unknown"
msgid "　胸には灰色の空みたいに果てのない、大きすぎる後悔の念。"
msgstr "  Regret spread through her chest like an endless gray sky."

#. Occurrence 1_0:915:66: voice_id=F60_1_0_0001; voice_prefix=F60; voice_category=0; scene=1_0
#: 1_0:915
msgctxt "text_id=66 | speaker=unknown"
msgid "『徒労だったな。結局、元に戻すとは』"
msgstr "\"We were too late. Some things cannot be undone.\""

#. Occurrence 1_0:947:67: scene=1_0
#: 1_0:947
msgctxt "text_id=67 | speaker=unknown"
msgid "　何が起こったのか、彼女には把握できない。"
msgstr "  Her mind struggled to come to grips with what had just occurred."

#. Occurrence 1_0:967:68: scene=1_0
#: 1_0:967
msgctxt "text_id=68 | speaker=unknown"
msgid "　この十分間の空白に何を経験して、"
msgstr "  The last ten minutes were a total blank."

#. Occurrence 1_0:972:69: scene=1_0
#: 1_0:972
msgctxt "text_id=69 | speaker=unknown"
msgid "　誰と出会い、"
msgstr "  Who she met..."

#. Occurrence 1_0:977:70: scene=1_0
#: 1_0:977
msgctxt "text_id=70 | speaker=unknown"
msgid "　何を知ったのかも、無責任にも元通り。"
msgstr "  What she had known... It was all as if it never happened."

#. Occurrence 1_0:982:71: scene=1_0
#: 1_0:982
msgctxt "text_id=71 | speaker=unknown"
msgid "　確かなコトは、死に行く命は戻らないという事と、"
msgstr "  The only thing she was sure of was that life, once extinguished, can never return."

#. Occurrence 1_0:994:72: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A11_1_0_0001; voice_prefix=A11; voice_category=1; scene=1_0
#: 1_0:994
msgctxt "text_id=72 | speaker=aoko"
msgid "　　　　「あの―――そこにだれか、いるの？」"
msgstr "        \"Umm... Is somebody there?\""

#. Occurrence 1_0:1001:73: scene=1_0
#: 1_0:1001
msgctxt "text_id=73 | speaker=unknown"
msgid "　その日。"
msgstr "  That day..."

#. Occurrence 1_0:1006:74: scene=1_0
#: 1_0:1006
msgctxt "text_id=74 | speaker=unknown"
msgid "　私という、彼女が生まれた<過|あやま>ちだけ。"
msgstr "  It was her mistake that gave birth to me."

#. Occurrence 1_0:1040:75: scene=1_0
#: 1_0:1040
msgctxt "text_id=75 | speaker=unknown"
msgid "　　　　　　………ああ。"
msgstr "            ...Indeed."

#. Occurrence 1_0:1046:76: scene=1_0
#: 1_0:1046
msgctxt "text_id=76 | speaker=unknown"
msgid "　　　　　　何にせよ、"
msgstr "            Whatever occurred that day,"

msgctxt "text_id=77 | speaker=unknown"
msgid "　　　　　　全てが<懐|なつ>かしく、待ち遠しい。"
msgstr "            it was a day of nostalgia and longing."

#. Occurrence 1_0:1091:78: scene=1_0
#: 1_0:1091
msgctxt "text_id=78 | speaker=unknown"
msgid "　それは<現実|イマ>から８年前のおとぎ話。"
msgstr "  This is the fairy tale of eight years ago."

#. Occurrence 1_0:1096:79: scene=1_0
#: 1_0:1096
msgctxt "text_id=79 | speaker=unknown"
msgid "　どんな魔法を使っても取り戻せない、いちばん初めに、彼女たちの出会った日。"
msgstr "  The day they first met, that no magic can ever bring back."

#. Occurrence 1_1:69:80: scene=1_1
#: 1_1:69
msgctxt "text_id=80 | speaker=unknown"
msgid "　<傲慢|ごうまん>で<貪欲|どんよく>で、壊すことしか能のない、"
msgstr "  Arrogant, greedy, and able only to destroy..."

msgctxt "text_id=81 | speaker=unknown"
msgid "　私はきっと狼だ。"
msgstr "  I must be a wolf."

#. Occurrence 1_1:77:82: scene=1_1
#: 1_1:77
msgctxt "text_id=82 | speaker=unknown"
msgid "　かえりみなくてふり向かなくて、"
msgstr "  I don't have regrets. There's no looking back."

msgctxt "text_id=83 | speaker=unknown"
msgid "　気づかないままむねをはり、<独|ひと>りになるならご愁傷さま。"
msgstr "  If my pride has left you behind, my sincere condolences."

#. Occurrence 1_1:87:84: scene=1_1
#: 1_1:87
msgctxt "text_id=84 | speaker=unknown"
msgid "　いずれあっさり、"
msgstr "  But at any rate,"

msgctxt "text_id=85 | speaker=unknown"
msgid "　赤ずきんに<退治|ころ>されるのが定めでしょう―――"
msgstr "  I suppose it's my fate to die at the hands of Little Red Riding Hood."

#. Occurrence 1_1:145:86: scene=1_1
#: 1_1:145
msgctxt "text_id=86 | speaker=unknown"
msgid "　それは、静かな朝だった。"
msgstr "  It was a quiet morning."

#. Occurrence 1_1:169:87: scene=1_1
#: 1_1:169
msgctxt "text_id=87 | speaker=unknown"
msgid "　ベッドから<覗|のぞ>く空模様が絵の具を塗りたくったような灰色でも、"
msgstr "  From her bed, she could see the sky was an ashen, watercolor gray."

#. Occurrence 1_1:174:88: scene=1_1
#: 1_1:174
msgctxt "text_id=88 | speaker=unknown"
msgid "　温度計は六度前後と十一月にしては容赦のない<数値|きろく>をたたきだしていても、"
msgstr "  The thermometer displayed 43 degrees Fahrenheit, a rather unforgiving temperature for November."

#. Occurrence 1_1:179:89: scene=1_1
#: 1_1:179
msgctxt "text_id=89 | speaker=unknown"
msgid "　朝食<時|どき>はとっくに過ぎていて、情けないコトに空腹なんかで目を覚ましたとしても。"
msgstr "  Her stomach woke her up with a growl, pathetically reminding her that she had completely missed breakfast."

#. Occurrence 1_1:185:90: scene=1_1
#: 1_1:185
msgctxt "text_id=90 | speaker=unknown"
msgid "　こうして<緩慢|かんまん>に眠っていられるだけで、彼女にとって、今日の朝は幸福なものだった。"
msgstr "  But lazy mornings like today's were, for her, a blessing."

#. Occurrence 1_1:279:91: scene=1_1
#: 1_1:279
msgctxt "text_id=91 | speaker=unknown"
msgid "　時計はとうに朝の八時を回っている。"
msgstr "  It was already well past eight in the morning."

#. Occurrence 1_1:284:92: scene=1_1
#: 1_1:284
msgctxt "text_id=92 | speaker=unknown"
msgid "　平日なら絶望的な時間、どうあがいても遅刻確定な状態だが、今日は創立記念日につき休校だ。"
msgstr "  On any ordinary weekday tardiness would be unavoidable, but today, classes were cancelled in commemoration of the school's anniversary."

#. Occurrence 1_1:289:93: scene=1_1
#: 1_1:289
msgctxt "text_id=93 | speaker=unknown"
msgid "　おかげで久しぶりに、のんびりと朝を過ごす事ができる。"
msgstr "  Gratefully, she had every intention of taking it easy for the first time in ages."

#. Occurrence 1_1:309:94: scene=1_1
#: 1_1:309
msgctxt "text_id=94 | speaker=unknown"
msgid "　くり返すが、窓の外は<陰鬱|いんうつ>とした鋼色で、朝というより夕方を思わせる。"
msgstr "  Outside the window was a gloomy gray, and it reminded her more of evening than morning."

#. Occurrence 1_1:314:95: scene=1_1
#: 1_1:314
msgctxt "text_id=95 | speaker=unknown"
msgid "　お世辞にも気持ちいい朝とは言えない。"
msgstr "  It wasn't a pleasant morning by any stretch of the imagination."

#. Occurrence 1_1:320:96: scene=1_1
#: 1_1:320
msgctxt "text_id=96 | speaker=unknown"
msgid "　が、つい三時間前まで夜通し起きていた彼女にとって、外の天気なんてどうでもいい事だった。"
msgstr "  But having been up all night until just three hours ago, she couldn't care less about the weather outside."

#. Occurrence 1_1:340:97: scene=1_1
#: 1_1:340
msgctxt "text_id=97 | speaker=unknown"
msgid "　いまは何より眠気がすべて。"
msgstr "  All she cared about was more sleep."

#. Occurrence 1_1:346:98: scene=1_1
#: 1_1:346
msgctxt "text_id=98 | speaker=unknown"
msgid "　ベッドで<微睡|まどろ>めるなら気持ちのいい朝なわけで、外の事情なんて当局は一切関知いたしません―――と、窓の向こうをシャットアウト。"
msgstr "  As long as she could spend her morning in bed, what was happening outside was of no concern to her."

#. Occurrence 1_1:400:99: scene=1_1
#: 1_1:400
msgctxt "text_id=99 | speaker=unknown"
msgid "　カーテンを閉める。"
msgstr "  She shut the curtains."

#. Occurrence 1_1:521:100: scene=1_1
#: 1_1:521
msgctxt "text_id=100 | speaker=unknown"
msgid "　再び<瞼|まぶた>を閉じて、すみやかに眠りに戻ろうと努力する。"
msgstr "  Then closed her eyes and tried to let sleep reclaim her."

#. Occurrence 1_1:530:101: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_1_0000; voice_prefix=A10; voice_category=1; scene=1_1
#: 1_1:530
msgctxt "text_id=101 | speaker=aoko"
msgid "“……せめてあと二時間ぐらいは<凡庸|ぼんよう>な夢を見ていられますように。”"
msgstr "\"I'd like a nice uneventful dream for two hours, thank you.\""

#. Occurrence 1_1:536:102: scene=1_1
#: 1_1:536
msgctxt "text_id=102 | speaker=unknown"
msgid "　眠気はじゅうぶん残っていて、すぐに幸せはやってきた。"
msgstr "  Blissful slumber found her soon enough."

#. Occurrence 1_1:541:103: scene=1_1
#: 1_1:541
msgctxt "text_id=103 | speaker=unknown"
msgid "　意識は沈むように落ちていく。"
msgstr "  Her consciousness faded."

#. Occurrence 1_1:562:104: scene=1_1
#: 1_1:562
msgctxt "text_id=104 | speaker=unknown"
msgid "　しかし。"
msgstr "  However..."

#. Occurrence 1_1:567:105: scene=1_1
#: 1_1:567
msgctxt "text_id=105 | speaker=unknown"
msgid "　彼女のささやかな願いは、容赦なく却下された。"
msgstr "  ...her simple request would be mercilessly refused."

#. Occurrence 1_1:590:106: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_1_0001; voice_prefix=A10; voice_category=1; scene=1_1
#: 1_1:590
msgctxt "text_id=106 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 1_1:596:107: scene=1_1
#: 1_1:596
msgctxt "text_id=107 | speaker=unknown"
msgid "　小さいクセにカン高く耳に残る。"
msgstr "  A faint but shrill sound lingered in her ears."

#. Occurrence 1_1:601:108: scene=1_1
#: 1_1:601
msgctxt "text_id=108 | speaker=unknown"
msgid "　間違いなく電話の音だ。"
msgstr "  It was the unmistakable ring of a telephone."

#. Occurrence 1_1:606:109: scene=1_1
#: 1_1:606
msgctxt "text_id=109 | speaker=unknown"
msgid "　習慣のなせる業だろう。閉じたばかりの瞼は、彼女の意思とは正反対にぱちりと開く。"
msgstr "  Much to her chagrin, her eyes popped open out of habit."

#. Occurrence 1_1:627:110: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_1_0002; voice_prefix=A10; voice_category=1; scene=1_1
#: 1_1:627
msgctxt "text_id=110 | speaker=aoko"
msgid "“こんな日にかぎって……”"
msgstr "\"Oh, c'mon. Why today of all days?\""

#. Occurrence 1_1:633:111: scene=1_1
#: 1_1:633
msgctxt "text_id=111 | speaker=unknown"
msgid "　受話器は一階のロビーに設置されている。"
msgstr "  The telephone was situated in the foyer on the first floor."

#. Occurrence 1_1:640:112: scene=1_1
#: 1_1:640
msgctxt "text_id=112 | speaker=unknown"
msgid "　この部屋からでは廊下十メートル分と、階段一つ分離れた先だ。"
msgstr "  Answering it meant walking down a thirty-foot corridor and going down a flight of stairs."

#. Occurrence 1_1:645:113: scene=1_1
#: 1_1:645
msgctxt "text_id=113 | speaker=unknown"
msgid "　寝不足の彼女にとって、その距離は遥かと<彼方|かなた>の中間ぐらい遠かった。"
msgstr "  In her sleep-deprived state, that distance seemed somewhere between incredibly far and astronomically far."

#. Occurrence 1_1:683:114: scene=1_1
#: 1_1:683
msgctxt "text_id=114 | speaker=unknown"
msgid "　……電話の音は<辛抱|しんぼう>強く鳴り響いている。"
msgstr "  The phone's incessant ringing continued."

#. Occurrence 1_1:688:115: scene=1_1
#: 1_1:688
msgctxt "text_id=115 | speaker=unknown"
msgid "　無視してしまえばいずれ止むにしても、それができるほど、彼女は自分に優しくはなかった。"
msgstr "  She knew the caller would eventually give up if she ignored it, but she chose to fight the urge."

#. Occurrence 1_1:769:116: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_1_0003; voice_prefix=A10; voice_category=1; scene=1_1
#: 1_1:769
msgctxt "text_id=116 | speaker=aoko"
msgid "「……<有珠|ありす>、でないの？」"
msgstr "\"Why doesn't Alice answer it?\""

#. Occurrence 1_1:775:117: scene=1_1
#: 1_1:775
msgctxt "text_id=117 | speaker=unknown"
msgid "　未練がましく同居人の活躍に期待してみたものの、すぐに<諦|あきら>めた。"
msgstr "  She thought her housemate would get it, but she soon had to abandon all hope."

#. Occurrence 1_1:780:118: scene=1_1
#: 1_1:780
msgctxt "text_id=118 | speaker=unknown"
msgid "　考えてみれば休日なのは自分の<学校|ところ>だけで、同居人は丘の上の学院のお嬢様だ。とっくに学校に行っている。"
msgstr "  The realization struck that her housemate did not have the day off from school and was likely in class at her prestigious little hilltop academy."

#. Occurrence 1_1:829:119: scene=1_1
#: 1_1:829
msgctxt "text_id=119 | speaker=unknown"
msgid "　電話の根気強さは並ではない。"
msgstr "  The caller proved incredibly persistent."

#. Occurrence 1_1:834:120: scene=1_1
#: 1_1:834
msgctxt "text_id=120 | speaker=unknown"
msgid "　そのあまりのしつこさに、気持ち、ボリュームがランクアップして聞こえる。"
msgstr "  That persistence made the volume of the ringing seem even louder."

#. Occurrence 1_1:855:121: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_1_0004; voice_prefix=A10; voice_category=1; scene=1_1
#: 1_1:855
msgctxt "text_id=121 | speaker=aoko"
msgid "「ああもう、せっかくの安眠を……！」"
msgstr "\"Ugh. I'm trying to sleep here!\""

#. Occurrence 1_1:898:122: scene=1_1
#: 1_1:898
msgctxt "text_id=122 | speaker=unknown"
msgid "　仕方なくベッドから出て、軽く上着を羽織って、彼女は部屋を後にする。"
msgstr "  She was left with no choice but to get up, throw a top on, and leave the room."

#. Occurrence 1_1:951:123: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_1_0005; voice_prefix=A10; voice_category=1; scene=1_1
#: 1_1:951
msgctxt "text_id=123 | speaker=aoko"
msgid "「うわ、さむ―――」"
msgstr "\"God, it's cold...\""

#. Occurrence 1_1:957:124: scene=1_1
#: 1_1:957
msgctxt "text_id=124 | speaker=unknown"
msgid "　手を合わせて、かじかむ指を温める。"
msgstr "  She rubbed her hands together to warm her numb fingers."

#. Occurrence 1_1:962:125: scene=1_1
#: 1_1:962
msgctxt "text_id=125 | speaker=unknown"
msgid "　この屋敷は暖房設備が<乏|とぼ>しい。"
msgstr "  The mansion's heating system was inadequate, to say the least."

#. Occurrence 1_1:967:126: scene=1_1
#: 1_1:967
msgctxt "text_id=126 | speaker=unknown"
msgid "　なので、冬の気温は恐るべき難敵だ。"
msgstr "  Which meant that Winter was the very worst of uninvited guests."

#. Occurrence 1_1:1002:127: scene=1_1
#: 1_1:1002
msgctxt "text_id=127 | speaker=unknown"
msgid "　<曇|くも>りに曇った朝なら尚更で、温度計を見なくても真冬なみの寒さと分かる。"
msgstr "  Never more so than on a dreary morning as this, when one didn't need to use a thermometer to know how cold it was."

#. Occurrence 1_1:1007:128: scene=1_1
#: 1_1:1007
msgctxt "text_id=128 | speaker=unknown"
msgid "　この屋敷はちょっとした山中にあり、周りはそれなりに深い森なので、街より冬の到来が早いのだ。"
msgstr "  The mansion sat in the mountains and was surrounded by dense forest. Winter always arrived here first, before moving on to nearby towns."

#. Occurrence 1_1:1052:129: scene=1_1
#: 1_1:1052
msgctxt "text_id=129 | speaker=unknown"
msgid "　長い廊下に、無機質なコール音が反響していく。"
msgstr "  The robotic ring of the telephone reverberated throughout the long hallway."

#. Occurrence 1_1:1057:130: scene=1_1
#: 1_1:1057
msgctxt "text_id=130 | speaker=unknown"
msgid "　館内の調度品はそれなりに手入れされているものの、生活臭は感じられない。"
msgstr "  The mansion's furnishings had been so perfectly maintained that it made the place feel unlived."

#. Occurrence 1_1:1062:131: scene=1_1
#: 1_1:1062
msgctxt "text_id=131 | speaker=unknown"
msgid "　豪華さより<淋|さび>しさが強く出ている。"
msgstr "  It seemed lonelier than it did splendid."

#. Occurrence 1_1:1067:132: scene=1_1
#: 1_1:1067
msgctxt "text_id=132 | speaker=unknown"
msgid "　薄暗い朝の様子もあいまって幽霊屋敷に見えなくもない。"
msgstr "  Coupled with the dreary morning, it could have passed for a haunted house."

#. Occurrence 1_1:1128:133: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_1_0006; voice_prefix=A10; voice_category=1; scene=1_1
#: 1_1:1128
msgctxt "text_id=133 | speaker=aoko"
msgid "「……ま、幽霊屋敷そのものだけど。"
msgstr "\"Well, it is a haunted house, I suppose."

#. Occurrence 1_1:1134:134: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_1_0007; voice_prefix=A10; voice_category=1; scene=1_1
#: 1_1:1134
msgctxt "text_id=134 | speaker=aoko"
msgid "　だいたいふたりで住むには広すぎるのよ、この家は」"
msgstr "  It's too large for just the two of us.\""

#. Occurrence 1_1:1182:135: scene=1_1
#: 1_1:1182
msgctxt "text_id=135 | speaker=unknown"
msgid "　コール数はもう三十を超えていた。"
msgstr "  She counted more than thirty rings since it first began."

#. Occurrence 1_1:1187:136: scene=1_1
#: 1_1:1187
msgctxt "text_id=136 | speaker=unknown"
msgid "　相手はよっぽど暇なのか、それとも、この家の事情が分かっているのか。"
msgstr "  The caller either had a lot of free time on their hands or had a good understanding of the house's circumstances."

#. Occurrence 1_1:1192:137: scene=1_1
#: 1_1:1192
msgctxt "text_id=137 | speaker=unknown"
msgid "　彼女は後者だと直感した。"
msgstr "  She had a strong hunch that it was the latter."

#. Occurrence 1_1:1213:138: scene=1_1
#: 1_1:1213
msgctxt "text_id=138 | speaker=unknown"
msgid "　見上げた窓は憂鬱な色。"
msgstr "  The window above looked out onto a gloomy sky."

#. Occurrence 1_1:1219:139: scene=1_1
#: 1_1:1219
msgctxt "text_id=139 | speaker=unknown"
msgid "　自重しない電話の音を捕まえるように歩を速める。"
msgstr "  She hastened to catch the unrelenting ring in the act as soon as possible."

#. Occurrence 1_1:1225:140: scene=1_1
#: 1_1:1225
msgctxt "text_id=140 | speaker=unknown"
msgid "　たぶん、捕まえた瞬間に、幸せな朝は<泡|あわ>と消えると予感しながら。"
msgstr "  Though she had a feeling that her happy morning might come to a close the moment she caught it."

#. Occurrence 1_1:1267:141: scene=1_1
#: 1_1:1267
msgctxt "text_id=141 | speaker=unknown"
msgid "　ともあれ、これが一連の事件の最初の話。"
msgstr "  It was here that a series of incidents began."

#. Occurrence 1_1:1273:142: scene=1_1
#: 1_1:1273
msgctxt "text_id=142 | speaker=unknown"
msgid "　浪漫が足りないのは、どうか大目に見てほしい。"
msgstr "  Apologies for the lack of romance to this tale."

#. Occurrence 1_1:1278:143: scene=1_1
#: 1_1:1278
msgctxt "text_id=143 | speaker=unknown"
msgid "　統計というか、通説というか。"
msgstr "  For whether it be objectively true or merely supposition..."

#. Occurrence 1_1:1285:144: scene=1_1
#: 1_1:1285
msgctxt "text_id=144 | speaker=unknown"
msgid "　物事のはじまりは、大抵こんな風に平凡で、穏やかに回りだすものなのだから―――　　"
msgstr "  ...it is always from gloomy and unassuming beginnings that extraordinary events are set into motion.    "

#. Occurrence 1_2:34:145: scene=1_2
#: 1_2:34
msgctxt "text_id=145 | speaker=unknown"
msgid "　彼女が正門についた頃、雨脚は弱くなっていた。"
msgstr "  The rain had subsided somewhat by the time she reached the school gate."

#. Occurrence 1_2:39:146: scene=1_2
#: 1_2:39
msgctxt "text_id=146 | speaker=unknown"
msgid "　遠くの空には日射しが見え隠れしている。"
msgstr "  Sunlight seemed to be playing peek-a-boo behind the clouds in the distance."

#. Occurrence 1_2:44:147: scene=1_2
#: 1_2:44
msgctxt "text_id=147 | speaker=unknown"
msgid "　この分なら、雨は昼過ぎにあがっているかもしれない。"
msgstr "  It looked like it might be cleared up by early afternoon."

#. Occurrence 1_2:76:148: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0000; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:76
msgctxt "text_id=148 | speaker=aoko"
msgid "「……といっても、私には関係のない話だけど」"
msgstr "\"...Not that it has anything to do with me, though.\""

#. Occurrence 1_2:82:149: scene=1_2
#: 1_2:82
msgctxt "text_id=149 | speaker=unknown"
msgid "　空模様とは裏腹に、彼女の運勢はボロボロだ。"
msgstr "  The weather reflected her luck."

#. Occurrence 1_2:87:150: scene=1_2
#: 1_2:87
msgctxt "text_id=150 | speaker=unknown"
msgid "　徹夜明けの朝に起こされたうえ、冬の雨に見舞われた。"
msgstr "  On top of being forced out of the house at such an early hour, she had to suffer through a winter rain."

#. Occurrence 1_2:124:151: scene=1_2
#: 1_2:124
msgctxt "text_id=151 | speaker=unknown"
msgid "　この分では、用件とやらもロクな事じゃない―――"
msgstr "  I'm getting a bad feeling about this..."

#. Occurrence 1_2:129:152: scene=1_2
#: 1_2:129
msgctxt "text_id=152 | speaker=unknown"
msgid "　そんな予感に頭痛を覚えながら、彼女は正門を抜けて校舎に向かう。"
msgstr "  The sinking feeling she had only grew as she passed through the entrance and headed inside."

#. Occurrence 1_2:182:153: scene=1_2
#: 1_2:182
msgctxt "text_id=153 | speaker=unknown"
msgid "　途中、すれ違った生徒はひとりもいない。"
msgstr "  She didn't encounter any other students along the way."

#. Occurrence 1_2:187:154: scene=1_2
#: 1_2:187
msgctxt "text_id=154 | speaker=unknown"
msgid "　部活中の生徒も見あたらない。"
msgstr "  Nor did she see anyone taking part in club activities, either."

#. Occurrence 1_2:192:155: scene=1_2
#: 1_2:192
msgctxt "text_id=155 | speaker=unknown"
msgid "　職員用の玄関の受付には“休憩中”の立て看板。"
msgstr "  The reception desk to the faculty room simply read \"Faculty Closed.\""

#. Occurrence 1_2:197:156: scene=1_2
#: 1_2:197
msgctxt "text_id=156 | speaker=unknown"
msgid "　学校は生徒に平等な休日を与えていた。"
msgstr "  The school had given all of its students the day off."

#. Occurrence 1_2:202:157: scene=1_2
#: 1_2:202
msgctxt "text_id=157 | speaker=unknown"
msgid "　もちろん、こんな時間に呼び出された彼女を除いて。"
msgstr "  Except those explicitly summoned, like her."

#. Occurrence 1_2:207:158: scene=1_2
#: 1_2:207
msgctxt "text_id=158 | speaker=unknown"
msgid "　そんな事実がますます感情を<逆撫|さかな>でする。"
msgstr "  A fact that irked her more and more as the minutes passed."

#. Occurrence 1_2:253:159: scene=1_2
#: 1_2:253
msgctxt "text_id=159 | speaker=unknown"
msgid "　彼女が職員室の扉を開けると、見慣れた教師が机に向かっていた。"
msgstr "  She opened the door to the faculty room and headed toward the desk she had visited a number of times before."

#. Occurrence 1_2:258:160: scene=1_2
#: 1_2:258
msgctxt "text_id=160 | speaker=unknown"
msgid "　地味だがパリッとしたシャツと背広、"
msgstr "  The man at the desk wore a plain shirt and suit that were nonetheless neatly pressed."

#. Occurrence 1_2:263:161: scene=1_2
#: 1_2:263
msgctxt "text_id=161 | speaker=unknown"
msgid "　穏やかではあるが油断ならない細眼鏡。"
msgstr "  Slim-framed glasses adorned his face, giving off an amicable yet cunning air."

#. Occurrence 1_2:268:162: scene=1_2
#: 1_2:268
msgctxt "text_id=162 | speaker=unknown"
msgid "　似合わない煙草をふかしている、二十代中盤の優男。"
msgstr "  The mild-mannered image this mid-twenties man presented clashed with the cigarette he smoked."

#. Occurrence 1_2:273:163: scene=1_2
#: 1_2:273
msgctxt "text_id=163 | speaker=unknown"
msgid "　どうにも、まだ彼女に気付いていない様子だ。"
msgstr "  He didn't appear to have noticed her yet."

#. Occurrence 1_2:295:164: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0001; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:295
msgctxt "text_id=164 | speaker=aoko"
msgid "「<山城|やましろ>先生」"
msgstr "\"Mr. Yamasiro?\""

#. Occurrence 1_2:301:165: scene=1_2
#: 1_2:301
msgctxt "text_id=165 | speaker=unknown"
msgid "　勢いよく扉を閉める。"
msgstr "  She closed the door with a bang."

#. Occurrence 1_2:308:166: scene=1_2
#: 1_2:308
msgctxt "text_id=166 | speaker=unknown"
msgid "　その音にさして驚いた様子もなく、山城と呼ばれた教師は顔を上げた。"
msgstr "  Showing no response to the sudden sound, Mr. Yamasiro lifted his head."

#. Occurrence 1_2:343:167: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0000; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:343
msgctxt "text_id=167 | speaker=yamashiro"
msgid "「やあ、おはよう<蒼崎|あおざき>くん。用件は聞いているかな？」"
msgstr "\"Hey there. Good morning, Ms. Aozaki. I guess this means you got the call.\""

#. Occurrence 1_2:349:168: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0002; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:349
msgctxt "text_id=168 | speaker=aoko"
msgid "「はい。一時間前に自宅で。事前に何の相談もなく」"
msgstr "\"Yes. They called me at home about an hour ago, out of the blue...\""

#. Occurrence 1_2:360:169: scene=1_2
#: 1_2:360
msgctxt "text_id=169 | speaker=unknown"
msgid "　この高校の卒業生である<山城|かれ>は、生徒たちとそう歳が離れていない。"
msgstr "  Having graduated from this high school himself, Mr. Yamasiro was not much older than the rest of the students."

#. Occurrence 1_2:365:170: scene=1_2
#: 1_2:365
msgctxt "text_id=170 | speaker=unknown"
msgid "　そのせいか他の教師より生徒に<慕|した>われている。"
msgstr "  For that reason, the students preferred him over the other teachers."

#. Occurrence 1_2:402:171: scene=1_2
#: 1_2:402
msgctxt "text_id=171 | speaker=unknown"
msgid "　話題も<豊富|ほうふ>で口調も<穏和|おんわ>。"
msgstr "  He always had something interesting to talk about, and kept conversations casual."

#. Occurrence 1_2:407:172: scene=1_2
#: 1_2:407
msgctxt "text_id=172 | speaker=unknown"
msgid "　教師というより頼れる先輩といった人物だが、あいにく、彼女はそう慕ってもいなかった。"
msgstr "    In fact, he seemed more like an older student than a teacher, but she unfortunately didn't share her fellow students' fondness for him."

#. Occurrence 1_2:427:173: scene=1_2
#: 1_2:427
msgctxt "text_id=173 | speaker=unknown"
msgid "　教師は<冷徹|れいてつ>であるべきである。"
msgstr "  She was of the opinion that teachers should come across as more austere."

#. Occurrence 1_2:432:174: scene=1_2
#: 1_2:432
msgctxt "text_id=174 | speaker=unknown"
msgid "　生徒にとっては愛憎いり交じった険しい壁であり、間違っても<憩|いこ>いの場でニコニコ笑っているお兄さん……であってはならない、というのが彼女の持論だ。"
msgstr "  Like an iron fist that could inspire both love and hate in equal measure... Not a buddy to joke and pal around with."

#. Occurrence 1_2:452:175: scene=1_2
#: 1_2:452
msgctxt "text_id=175 | speaker=unknown"
msgid "　山城教諭は彼女が良しとする教師像とは正反対の人物で、自然、彼への口調は堅く、愛想のないものになる。"
msgstr "  He was the exact opposite of how she felt a teacher should be. It was only natural that her manner towards him would be forced and unfriendly."

#. Occurrence 1_2:458:176: scene=1_2
#: 1_2:458
msgctxt "text_id=176 | speaker=unknown"
msgid "　……もっとも。愛想なんて微笑ましいもの、彼女には初めから装備されてはいないのだが。"
msgstr "  Not that she'd ever been wired to make friendly small talk."

#. Occurrence 1_2:492:177: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0001; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:492
msgctxt "text_id=177 | speaker=yamashiro"
msgid "「はあ。今日もご機嫌ななめみたいだね、君は」"
msgstr "\"You're in a foul mood today.\""

#. Occurrence 1_2:498:178: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0003; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:498
msgctxt "text_id=178 | speaker=aoko"
msgid "「それは先生の気のせいです。"
msgstr "\"You must be imagining it."

#. Occurrence 1_2:498:179: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0003; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:498
msgctxt "text_id=179 | speaker=aoko"
msgid "　今日だけ特別、という話ではありませんから」"
msgstr "  I'm like this every day.\""

#. Occurrence 1_2:518:180: scene=1_2
#: 1_2:518
msgctxt "text_id=180 | speaker=unknown"
msgid "　きっぱりと返答しつつも、彼女自身、自分がひどい顔をしているのは承知していた。"
msgstr "  The matter-of-fact answer perfectly matched the displeasure displayed on her face."

#. Occurrence 1_2:523:181: scene=1_2
#: 1_2:523
msgctxt "text_id=181 | speaker=unknown"
msgid "　寝起きの機嫌の悪さと寝不足の疲れがあいまって、<仇|かたき>を見るような目つきになっているだろう。"
msgstr "  Her bad mood from having to get up early and the tiredness from staying up late must have collectively made her look positively adversarial."

#. Occurrence 1_2:556:182: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0002; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:556
msgctxt "text_id=182 | speaker=yamashiro"
msgid "「そう。ならいいんだけどね、彼にはそう辛く当たらないでくれよ。僕らじゃ正直、どう扱っていいか分からないところもあるし」"
msgstr "\"If you say so. Just go easy on our guest, okay? To be honest, we're not completely sure how to deal with him yet.\""

#. Occurrence 1_2:562:183: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0004; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:562
msgctxt "text_id=183 | speaker=aoko"
msgid "「先生。その件ですけど、私、まだ詳しい話を聞かされていないのですが」"
msgstr "\"About that. Do you wanna tell me what the hell is going on? Because I have no clue.\""

#. Occurrence 1_2:572:184: scene=1_2
#: 1_2:572
msgctxt "text_id=184 | speaker=unknown"
msgid "　刺すような彼女の視線と声に、山城教諭はああ、と応えて煙草の火をもみ消した。"
msgstr "  As Mr. Yamasiro met her piercing eyes, he finally understood the reason behind her tone, and slowly put out his cigarette."

#. Occurrence 1_2:608:185: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0003; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:608
msgctxt "text_id=185 | speaker=yamashiro"
msgid "「んー、電話じゃなんて聞いたの？」"
msgstr "\"Let's start at the beginning. What did they tell you over the phone?\""

#. Occurrence 1_2:614:186: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0005; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:614
msgctxt "text_id=186 | speaker=aoko"
msgid "「転入生の紹介をする、とだけです。"
msgstr "\"Just that I'd be introduced to a transfer student."

#. Occurrence 1_2:614:187: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0005; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:614
msgctxt "text_id=187 | speaker=aoko"
msgid "　理由も<脈絡|みゃくらく>も無い説明でした」"
msgstr "  They were a little hazy on the rest, though.\""

#. Occurrence 1_2:634:188: scene=1_2
#: 1_2:634
msgctxt "text_id=188 | speaker=unknown"
msgid "　簡潔な答えに、山城は感心して眉を上げた。"
msgstr "  One of Mr. Yamasiro's eyebrows stood up, impressed with the brevity of her answer."

#. Occurrence 1_2:639:189: scene=1_2
#: 1_2:639
msgctxt "text_id=189 | speaker=unknown"
msgid "　彼女が怒っているのは見てとれたが、その理由が休日に呼び出された件ではなく、電話の内容が<要領|ようりょう>を得なかったからだとは。"
msgstr "  He could see that she was angry, not because she had been called to school on her day off, but because she hadn't been told why she was here."

#. Occurrence 1_2:656:190: scene=1_2
#: 1_2:656
msgctxt "text_id=190 | speaker=unknown"
msgid "　いやはや実に<厳格|げんかく>だ、と山城教諭は苦笑した。"
msgstr "  Mr. Yamasiro chuckled sympathetically."

#. Occurrence 1_2:694:191: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0006; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:694
msgctxt "text_id=191 | speaker=aoko"
msgid "「先生。これが笑い話なら、そろそろ帰っていいでしょうか？」"
msgstr "\"If this was all a joke to you, perhaps I should just go home.\""

#. Occurrence 1_2:705:192: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0004; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:705
msgctxt "text_id=192 | speaker=yamashiro"
msgid "「いや、ごめんごめん、謝るよ。冗談じゃなくて真面目な話なんだ。ちょっと、君の手を借りたくてね」"
msgstr "\"Wait, wait. I didn't mean to laugh. This is not a practical joke. We could really use your help.\""

#. Occurrence 1_2:711:193: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0007; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:711
msgctxt "text_id=193 | speaker=aoko"
msgid "「本当に、転入生の問題で？」"
msgstr "\"So there really is a transfer student?\""

#. Occurrence 1_2:739:194: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0005; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:739
msgctxt "text_id=194 | speaker=yamashiro"
msgid "「うん、訳ありというか、難しいというか。"
msgstr "\"Yes, but he has... how should I put it? Difficult circumstances."

#. Occurrence 1_2:745:195: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0006; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:745
msgctxt "text_id=195 | speaker=yamashiro"
msgid "　彼……<草十郎|そうじゅうろう>くんというんだけど、ちょっと、色々とズレていてね。僕らが案内してあげるより、同世代の君の方が適任だと思ったんだ」"
msgstr "  His name...is Soujyuro. And he's a bit...well, peculiar. So we thought someone around the same age would be best suited to show him the ropes.\""

#. Occurrence 1_2:779:196: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0008; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:779
msgctxt "text_id=196 | speaker=aoko"
msgid "「…………」"
msgstr "\"...\""

#. Occurrence 1_2:785:197: scene=1_2
#: 1_2:785
msgctxt "text_id=197 | speaker=unknown"
msgid "　彼女は不審げに表情を<曇|くも>らせた。"
msgstr "  She threw him an unamused look."

#. Occurrence 1_2:790:198: scene=1_2
#: 1_2:790
msgctxt "text_id=198 | speaker=unknown"
msgid "　教師の業務を生徒に押しつけるのも<怠慢|たいまん>だが、それ以上にその転入生が『ズレている』とはどういう事だろう？"
msgstr "  It was negligent of them to be pushing teaching duties on her, but she did wonder how exactly this transfer student was peculiar."

#. Occurrence 1_2:795:199: scene=1_2
#: 1_2:795
msgctxt "text_id=199 | speaker=unknown"
msgid "　素行に問題がある、扱いが難しい、というのなら想像しやすい。"
msgstr "  Maybe he meant the student had behavioral problems or was difficult somehow."

#. Occurrence 1_2:801:200: scene=1_2
#: 1_2:801
msgctxt "text_id=200 | speaker=unknown"
msgid "しかし、ズレている、というのは何なのか。"
msgstr "But 'peculiar?' She didn't have the slightest idea what that meant."

#. Occurrence 1_2:839:201: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0009; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:839
msgctxt "text_id=201 | speaker=aoko"
msgid "『ズレてるなんて、そう使わない表現だけど……』"
msgstr "(You don't hear a teacher call someone that everyday.)"

#. Occurrence 1_2:851:202: scene=1_2
#: 1_2:851
msgctxt "text_id=202 | speaker=unknown"
msgid "　彼女は不審げに思案するも、すぐに頭を切りかえた。"
msgstr "  She had her doubts but swept them aside for now."

#. Occurrence 1_2:856:203: scene=1_2
#: 1_2:856
msgctxt "text_id=203 | speaker=unknown"
msgid "　あれこれ悩んでも仕方がない。"
msgstr "  This wasn't the time to get distracted by more concerns."

#. Occurrence 1_2:861:204: scene=1_2
#: 1_2:861
msgctxt "text_id=204 | speaker=unknown"
msgid "　なんだかこの会話自体がズレているようで居心地が悪いし、情報が少なすぎるし、そもそも、断るつもりなら今頃ベッドの上でうろんな貝の気分になっている。"
msgstr "  The fact remained that this conversation was all the \"peculiar\" she could handle, and she needed more information. She was already beginning to fantasize about saying no and curling up in her warm bed at home."

#. Occurrence 1_2:888:205: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0010; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:888
msgctxt "text_id=205 | speaker=aoko"
msgid "「ひとつ、質問があります」"
msgstr "\"I have a question.\""

#. Occurrence 1_2:911:206: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0007; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:911
msgctxt "text_id=206 | speaker=yamashiro"
msgid "「なに？　あ、学年は君と同じ二年生だよ。性格は落ち着きがあって、人の話をよく聞くタイプ。裏を返せば覇気がないともとれるけど、それならそれで付き合いやすいだろ？"
msgstr "\"Yes? Ah, he's a second-year student like you. He's well-behaved and a good listener. He's not the most energetic individual, but that just means he'll be easier to get along with, right?"

#. Occurrence 1_2:922:207: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0008; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:922
msgctxt "text_id=207 | speaker=yamashiro"
msgid "　蒼崎くんとはクラスは違うけど、きっと仲良くな―――」"
msgstr "  He's not in the same homeroom class as you, but I'm sure you'll get along just-\""

#. Occurrence 1_2:965:208: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0011; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:965
msgctxt "text_id=208 | speaker=aoko"
msgid "「そういった事は本人から直接<訊|き>きますし、<量|はか>ります。"
msgstr "\"I'll be the judge of that when I actually meet him."

#. Occurrence 1_2:971:209: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0012; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:971
msgctxt "text_id=209 | speaker=aoko"
msgid "　そうではなく、なぜ私なんでしょうか」"
msgstr "  And none of that answered my question: why me?\""

#. Occurrence 1_2:996:210: scene=1_2
#: 1_2:996
msgctxt "text_id=210 | speaker=unknown"
msgid "　<刺々|とげとげ>しい<質|こ><問|え>は、同時に転入生の案内を承諾していた。"
msgstr "  Though her tone was still stern, it was clear that she was willing to cooperate."

#. Occurrence 1_2:1032:211: scene=1_2
#: 1_2:1032
msgctxt "text_id=211 | speaker=unknown"
msgid "　不満ではあるが、とりあえず自分の感情は置いて、与えられた役目に取り組んでみる。"
msgstr "  She had decided to put her feelings of dissatisfaction aside and focus on the task at hand."

#. Occurrence 1_2:1037:212: scene=1_2
#: 1_2:1037
msgctxt "text_id=212 | speaker=unknown"
msgid "　<極|きわ>めて自己中心的な気質でありながら、<努|つと>めて公正でいようとするのが彼女の特長だ。"
msgstr "  Forcing herself to act empathetic in spite of her self-absorbed nature was something she was used to."

#. Occurrence 1_2:1042:213: scene=1_2
#: 1_2:1042
msgctxt "text_id=213 | speaker=unknown"
msgid "　やや<倒錯|とうさく>しているが、その芯の強さを山城などは頼もしく思ってしまう。"
msgstr "  Paradoxically, this force of will was also the reason teachers put so much faith in her."

#. Occurrence 1_2:1062:214: scene=1_2
#: 1_2:1062
msgctxt "text_id=214 | speaker=unknown"
msgid "　……まあ。"
msgstr "  ...To a point."

#. Occurrence 1_2:1067:215: scene=1_2
#: 1_2:1067
msgctxt "text_id=215 | speaker=unknown"
msgid "　時折、その強さが予想の<範疇|はんちゅう>を超える事もあるが、それはそれ、天災と思って<諦|あきら>めるのが、ここ一年で山城教諭が学んだ彼女への対応策である。"
msgstr "  At times, that strength shattered expectation, and on those occasions they were left with no choice but to treat it like a natural disaster and weather it until it passed. That was how Mr. Yamasiro had come to deal with her as over the past year."

#. Occurrence 1_2:1088:216: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0013; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:1088
msgctxt "text_id=216 | speaker=aoko"
msgid "「もう一度だけ訊きます、山城先生。"
msgstr "\"I'll ask you one more time, Mr. Yamasiro."

#. Occurrence 1_2:1112:217: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0014; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:1112
msgctxt "text_id=217 | speaker=aoko"
msgid "　それで、なぜ私なんでしょうか？」"
msgstr "  Why does it have to be me?\""

#. Occurrence 1_2:1132:218: scene=1_2
#: 1_2:1132
msgctxt "text_id=218 | speaker=unknown"
msgid "　有無を言わせぬ<詰問|きつもん>に、山城教諭はやや押されながらも返答する。"
msgstr "  Pressured by a question without a clear yes or no answer, he answered."

#. Occurrence 1_2:1158:219: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0009; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:1158
msgctxt "text_id=219 | speaker=yamashiro"
msgid "「うん、それはね。"
msgstr "\"Well, about that..."

#. Occurrence 1_2:1164:220: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0010; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:1164
msgctxt "text_id=220 | speaker=yamashiro"
msgid "　別に、蒼崎くんが先生方に<敬遠|けいえん>されているのと同じぐらい信頼されていて、学校のためなら教師も生徒も一緒くたに斬って捨てる鉄の生徒会長、だからじゃないよ」"
msgstr "  You're probably thinking it's because you're the iron-fisted ruler of the student council and are willing to strike down both teacher and student for the good of the school, but you'd be wrong.\""

#. Occurrence 1_2:1187:221: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0015; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:1187
msgctxt "text_id=221 | speaker=aoko"
msgid "「……それ以外に、こんな呼びつけを受ける理由はないと思いますけど」"
msgstr "\"I can't imagine any other reason you'd call me.\""

#. Occurrence 1_2:1207:222: scene=1_2
#: 1_2:1207
msgctxt "text_id=222 | speaker=unknown"
msgid "　信用ならない、と彼女は半眼で生徒会顧問を見据えた。"
msgstr "  Her eyes did nothing to hide her disbelief as she glared at him."

#. Occurrence 1_2:1213:223: scene=1_2
#: 1_2:1213
msgctxt "text_id=223 | speaker=unknown"
msgid "　十七才の少女にあるまじき迫力と、"
msgstr "  Strength far beyond that of an ordinary seventeen-year-old girl..."

msgctxt "text_id=224 | speaker=unknown"
msgid "　十七才の少女らしい愛らしさ。"
msgstr "  ...coupled with the youthful beauty of one."

#. Occurrence 1_2:1220:225: scene=1_2
#: 1_2:1220
msgctxt "text_id=225 | speaker=unknown"
msgid "　奇跡的なバランスで両立する眼差しを、山城教諭は見惚れるように、穏やかな笑顔で受けとめる。"
msgstr "  Mr. Yamasiro let slip a genuine smile, admiring the miraculous balance of qualities."

#. Occurrence 1_2:1260:226: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0011; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:1260
msgctxt "text_id=226 | speaker=yamashiro"
msgid "「いや、責務だけでいいなら僕がやってるさ。この人選に関しちゃ教師や生徒会長といった役職も関係ないよ。"
msgstr "\"I mean, I'd handle this myself if it was just about pure obligation. But who gets this job has nothing to do with whether they're a teacher or on the student council."

#. Occurrence 1_2:1266:227: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0012; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:1266
msgctxt "text_id=227 | speaker=yamashiro"
msgid "　なんていうか、こんな頼みを<損得|そんとく>抜きで聞いてくれるのは君だけだと思ってね。適任ですから、と強く推薦したわけ」"
msgstr "  I just felt that you were the only one who would entertain this kind of a request without needing to weigh all sides. That's why I insisted it be you.\""

#. Occurrence 1_2:1272:228: scene=1_2
#: 1_2:1272
msgctxt "text_id=228 | speaker=unknown"
msgid "　要は、“なんだかんだ言って底抜けに人がいいでしょ君”と言われているようなものだ。"
msgstr "  In other words, he knew she wouldn't say no."

#. Occurrence 1_2:1312:229: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0016; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:1312
msgctxt "text_id=229 | speaker=aoko"
msgid "「―――山城先生」"
msgstr "\"...Mr. Yamasiro.\""

#. Occurrence 1_2:1330:230: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0013; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:1330
msgctxt "text_id=230 | speaker=yamashiro"
msgid "「うわ怖っ。もう、<睨|にら>まない睨まない。言ったろ、僕にはともかく彼には笑顔でって。"
msgstr "\"Oh, dear. Would you stop glaring at me like that already? At least put on a smile for your new schoolmate."

#. Occurrence 1_2:1336:231: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0014; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:1336
msgctxt "text_id=231 | speaker=yamashiro"
msgid "　とまあ、納得してくれたなら、すぐに移動しよう。もうずいぶん待たせてしまっているからね。"
msgstr "  Look, if you're agreeing to help, we should go see him. We've already kept him waiting long enough as it is."

#. Occurrence 1_2:1342:232: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0015; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:1342
msgctxt "text_id=232 | speaker=yamashiro"
msgid "　それと、雨の中ご苦労さま。帰りはもちろん車で送るよ」"
msgstr "  And because you braved the rain to get here, I'd be happy to give you a ride home.\""

#. Occurrence 1_2:1372:233: scene=1_2
#: 1_2:1372
msgctxt "text_id=233 | speaker=unknown"
msgid "　スマートに立ち上がる山城教諭。"
msgstr "  Mr. Yamasiro stood up gracefully."

#. Occurrence 1_2:1377:234: scene=1_2
#: 1_2:1377
msgctxt "text_id=234 | speaker=unknown"
msgid "　それにけっこうです、とだけ返して、彼女は職員室を後にした。"
msgstr "  \"I'm good, thanks,\" she replied, before turning and walking out of the faculty room."

#. Occurrence 1_2:1435:235: scene=1_2
#: 1_2:1435
msgctxt "text_id=235 | speaker=unknown"
msgid "　待ち続けること一時間。"
msgstr "  He had been waiting for about an hour."

#. Occurrence 1_2:1440:236: scene=1_2
#: 1_2:1440
msgctxt "text_id=236 | speaker=unknown"
msgid "　いつのまにか、空模様は小雨になっていた。"
msgstr "  While he did, the rain shower lightened into a drizzle."

#. Occurrence 1_2:1446:237: scene=1_2
#: 1_2:1446
msgctxt "text_id=237 | speaker=unknown"
msgid "　彼はぼんやりと、雨だれの音を聴いている。"
msgstr "  His mind wandered as he listened to the sound of the raindrops."

#. Occurrence 1_2:1490:238: scene=1_2
#: 1_2:1490
msgctxt "text_id=238 | speaker=unknown"
msgid "　長方形の机が事務的に置かれただけの部屋。"
msgstr "  The room was filled with neatly arranged rectangular tables."

#. Occurrence 1_2:1495:239: scene=1_2
#: 1_2:1495
msgctxt "text_id=239 | speaker=unknown"
msgid "　人影は一つ。彼の他には誰もいない。"
msgstr "  He was the only one there."

#. Occurrence 1_2:1500:240: scene=1_2
#: 1_2:1500
msgctxt "text_id=240 | speaker=unknown"
msgid "　この部屋に通され、座って待っているように言われてから、もうずいぶんと時間が経っている。"
msgstr "  Quite some time had passed since he had been brought to this room and asked to wait."

#. Occurrence 1_2:1505:241: scene=1_2
#: 1_2:1505
msgctxt "text_id=241 | speaker=unknown"
msgid "　まっとうな学生なら不満や不安をクチにしてもいい頃だろうに、少年はそれこそ畑のカカシのように、じっと言いつけを守っていた。"
msgstr "  Even the best-behaved student might have grown dissatisfied or anxious with the situation by now, but the boy stuck to his spot like a scarecrow."

#. Occurrence 1_2:1525:242: scene=1_2
#: 1_2:1525
msgctxt "text_id=242 | speaker=unknown"
msgid "　体の<芯|しん>にまで届く寒さ。"
msgstr "  He was chilled to the bone."

#. Occurrence 1_2:1530:243: scene=1_2
#: 1_2:1530
msgctxt "text_id=243 | speaker=unknown"
msgid "　十一月の終わり、冬を迎え始めた午前の気温である。"
msgstr "  It was the end of November, and the low temperature in the morning had marked the start of winter."

#. Occurrence 1_2:1535:244: scene=1_2
#: 1_2:1535
msgctxt "text_id=244 | speaker=unknown"
msgid "　室温は外より幾らかましな程度。"
msgstr "  The room was not much warmer."

#. Occurrence 1_2:1540:245: scene=1_2
#: 1_2:1540
msgctxt "text_id=245 | speaker=unknown"
msgid "　ストーブをつけていいから、という教師の声を聞き逃したのか、このタイプのストーブはまだ見た事がなかったのか、暖房は入っていない。"
msgstr "  The heater hadn't been turned on. Either he'd missed the teacher telling him to turn it on, or he'd never seen one in his life."

#. Occurrence 1_2:1560:246: scene=1_2
#: 1_2:1560
msgctxt "text_id=246 | speaker=unknown"
msgid "　彼は冷たくなってきた指先に軽く息をあてながら、ぼんやりと周囲を観察する。"
msgstr "  He breathed lightly on his freezing fingers as he aimlessly surveyed his surroundings."

#. Occurrence 1_2:1566:247: scene=1_2
#: 1_2:1566
msgctxt "text_id=247 | speaker=unknown"
msgid "　この殺風景な部屋は会議室と言うらしい。"
msgstr "  This dreary place was apparently a meeting room."

#. Occurrence 1_2:1571:248: scene=1_2
#: 1_2:1571
msgctxt "text_id=248 | speaker=unknown"
msgid "　在校生から見れば<仰々|ぎょうぎょう>しい会議室だが、彼から見れば飾り気のない、広いだけの部屋だった。"
msgstr "  The other students might have considered it a wonderful place to meet, but to him it was drab and overly spacious."

#. Occurrence 1_2:1614:249: scene=1_2
#: 1_2:1614
msgctxt "text_id=249 | speaker=unknown"
msgid "　生活の匂いがしないため、つい、乾ききった<岩屋|いわや>などを連想してしまう。"
msgstr "  It was a lifeless place that reminded him of an arid cave."

#. Occurrence 1_2:1619:250: scene=1_2
#: 1_2:1619
msgctxt "text_id=250 | speaker=unknown"
msgid "　彼はやる事もないので、こんな冷たい場所でどんな話し合いをするのだろう、と真剣に検討してみた。"
msgstr "  Stuck in this cold room with absolutely nothing to do, his mind turned to what they wanted to discuss."

#. Occurrence 1_2:1654:251: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0000; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:1654
msgctxt "text_id=251 | speaker=soujuurou"
msgid "「…………………………"
msgstr "\"..."

msgctxt "text_id=252 | speaker=unknown"
msgid "、むう」"
msgstr "...Hrm.\""

#. Occurrence 1_2:1676:253: scene=1_2
#: 1_2:1676
msgctxt "text_id=253 | speaker=unknown"
msgid "　どう考えても答えはでそうにないので、<雨音|あまおと>に意識を戻す。"
msgstr "  Unable to come up with a solid answer, he returned his attention to the sound of the rain."

#. Occurrence 1_2:1681:254: scene=1_2
#: 1_2:1681
msgctxt "text_id=254 | speaker=unknown"
msgid "　雨の空は、山のものと少しだけ似ている。"
msgstr "  The rain hardly resembled the rain in the mountains."

#. Occurrence 1_2:1686:255: scene=1_2
#: 1_2:1686
msgctxt "text_id=255 | speaker=unknown"
msgid "　いや、かろうじて原形を留めている。"
msgstr "  Though, he could still recognize it, barely."

#. Occurrence 1_2:1691:256: scene=1_2
#: 1_2:1691
msgctxt "text_id=256 | speaker=unknown"
msgid "　匂いも音も<硬|かた>くなっているが、根底は同じモノだ。"
msgstr "  Its smell and sound were harsher. But at the end of the day, rain was still rain."

#. Occurrence 1_2:1696:257: scene=1_2
#: 1_2:1696
msgctxt "text_id=257 | speaker=unknown"
msgid "　こんな異界にあっても山と共通する物がある―――"
msgstr "  So even this world, alien as it was, could have something in common with the mountains..."

#. Occurrence 1_2:1701:258: scene=1_2
#: 1_2:1701
msgctxt "text_id=258 | speaker=unknown"
msgid "　そんな<些細|ささい>な事がしんみりと嬉しい。"
msgstr "  That trivial detail perked him up a little."

#. Occurrence 1_2:1745:259: scene=1_2
#: 1_2:1745
msgctxt "text_id=259 | speaker=unknown"
msgid "　雨に濡れた町は好きだ。"
msgstr "  He liked how the town looked soaked in rain."

#. Occurrence 1_2:1750:260: scene=1_2
#: 1_2:1750
msgctxt "text_id=260 | speaker=unknown"
msgid "　よく晴れた晴天の方が心地よいのは当然だが、そういう気持ち良さとは別の視点で、彼は雨空を好いている。"
msgstr "  Naturally, he preferred sunny weather, but he liked rain in its own way."

#. Occurrence 1_2:1755:261: scene=1_2
#: 1_2:1755
msgctxt "text_id=261 | speaker=unknown"
msgid "　雨に<煙|けぶ>った町並みは少しだけ土の匂いが増して、未練がましくも故郷を<想|おも>ってしまう。"
msgstr "  The fog from the rain had soaked up the scent of the soil, and it reminded him of home."

#. Occurrence 1_2:1760:262: scene=1_2
#: 1_2:1760
msgctxt "text_id=262 | speaker=unknown"
msgid "　そんな時だけ、都会にやってきた不安も少しは薄れていく気がするからだ。"
msgstr "  It was at times like these that he was able to numb the anxiety the city gave him."

#. Occurrence 1_2:1781:263: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0001; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:1781
msgctxt "text_id=263 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 1_2:1799:264: scene=1_2
#: 1_2:1799
msgctxt "text_id=264 | speaker=unknown"
msgid "　……と、すぐに<落胆|らくたん>の息がこぼれた。"
msgstr "  ...But then he let out a discouraged sigh."

#. Occurrence 1_2:1804:265: scene=1_2
#: 1_2:1804
msgctxt "text_id=265 | speaker=unknown"
msgid "　まったく情けない。"
msgstr "  How pathetic."

#. Occurrence 1_2:1810:266: scene=1_2
#: 1_2:1810
msgctxt "text_id=266 | speaker=unknown"
msgid "引っ越して二週間も経つのに、気を抜くと故郷を<偲|しの>ぶ未練がましさに肩を落とす。"
msgstr "He'd already been here two weeks and thoughts of his hometown still made him sad."

#. Occurrence 1_2:1815:267: scene=1_2
#: 1_2:1815
msgctxt "text_id=267 | speaker=unknown"
msgid "　これではせっかくの新生活に申し訳がないではないか、と彼はひとり気合いを入れ直して、行儀良く待ち続けることにした。"
msgstr "  Perhaps feeling that he was being unfair to his new life, he composed himself and continued to wait patiently."

#. Occurrence 1_2:1843:268: scene=1_2
#: 1_2:1843
msgctxt "text_id=268 | speaker=unknown"
msgid "　ぼんやりと熱心に、雨の音に意識を向ける。"
msgstr "  As if having a passion for distractions, his attention returned to the sound of the rain once more."

#. Occurrence 1_2:1849:269: scene=1_2
#: 1_2:1849
msgctxt "text_id=269 | speaker=unknown"
msgid "　彼にとって、この程度の待ちぼうけは苦でもないらしい。"
msgstr "  Waiting like this didn't seem to be particularly hard for him."

#. Occurrence 1_2:1869:270: scene=1_2
#: 1_2:1869
msgctxt "text_id=270 | speaker=unknown"
msgid "　痺れるような寒さも、一時間の放置も、深呼吸と一緒にあっさり飲み下す平常心。"
msgstr "  He quietly endured the numbing cold and the hour alone with calm, deep breaths."

#. Occurrence 1_2:1874:271: scene=1_2
#: 1_2:1874
msgctxt "text_id=271 | speaker=unknown"
msgid "　岩の上にも三年とか、耐え続けた<赤穂浪士|あこうろうし>とか。"
msgstr "  As the saying goes, \"Good things come to those who wait.\""

#. Occurrence 1_2:1879:272: scene=1_2
#: 1_2:1879
msgctxt "text_id=272 | speaker=unknown"
msgid "　長所かどうかはさておいて、呆れるほどの辛抱強さ。"
msgstr "  A strong point of his or not, he was astonishingly patient."

#. Occurrence 1_2:1885:273: scene=1_2
#: 1_2:1885
msgctxt "text_id=273 | speaker=unknown"
msgid "　それが現時点における、この少年の特長だった。"
msgstr "  It was certainly helping him out in this moment."

#. Occurrence 1_2:1968:274: scene=1_2
#: 1_2:1968
msgctxt "text_id=274 | speaker=unknown"
msgid "　一方、彼女はいたくご<立腹|りっぷく>だった。"
msgstr "  She, on the other hand, was livid."

#. Occurrence 1_2:1974:275: scene=1_2
#: 1_2:1974
msgctxt "text_id=275 | speaker=unknown"
msgid "　職員室から会議室に向かうまでの間、これから会う人物のプロフィールを聞いたからだ。"
msgstr "  The profile of the transfer student had been explained to her on her way to the meeting room."

#. Occurrence 1_2:1979:276: scene=1_2
#: 1_2:1979
msgctxt "text_id=276 | speaker=unknown"
msgid "　なんでも、その人物は生まれてから今の今まで、電気も<通|かよ>っていない山奥で暮らしていたらしい。"
msgstr "  She was told he had lived his whole life up in the mountains without any electricity."

#. Occurrence 1_2:2018:277: scene=1_2
#: 1_2:2018
msgctxt "text_id=277 | speaker=unknown"
msgid "　電気がないという事は、現在の文明社会の半分以上を知らない事になる。"
msgstr "  That meant more than half of civilized society would have been an utter mystery to him."

#. Occurrence 1_2:2025:278: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0017; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2025
msgctxt "text_id=278 | speaker=aoko"
msgid "『なんて絶望的な断絶、戦後どころか戦前の話じゃない。"
msgstr "(What a miserable level of isolation. How is this even possible in post-war Japan?"

#. Occurrence 1_2:2025:279: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0017; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2025
msgctxt "text_id=279 | speaker=aoko"
msgid "　ロビンソンにも程がある……！』"
msgstr "  He's like Robinson Crusoe!)"

#. Occurrence 1_2:2031:280: scene=1_2
#: 1_2:2031
msgctxt "text_id=280 | speaker=unknown"
msgid "　彼女のそんな<憤|いきどお>りもやむをえまい。"
msgstr "  She had every right to be angry."

#. Occurrence 1_2:2083:281: scene=1_2
#: 1_2:2083
msgctxt "text_id=281 | speaker=unknown"
msgid "　なんでも、その山奥の村は長いこと集落として孤立していたらしい。"
msgstr "  His village had apparently remained isolated in the mountains for many years."

#. Occurrence 1_2:2088:282: scene=1_2
#: 1_2:2088
msgctxt "text_id=282 | speaker=unknown"
msgid "　<麓|ふもと>の村とですら月に一度の郵便で連絡をとるだけなんて、現代日本とは思えない。"
msgstr "  Contact with villages in the foothills of the mountains only occurred once a month or so, which was unfathomable in modern Japan."

#. Occurrence 1_2:2093:283: scene=1_2
#: 1_2:2093
msgctxt "text_id=283 | speaker=unknown"
msgid "　が、しかし。今や高速道路やＪＲ……旧国鉄……といった動脈静脈が張り巡らされた我が国ではあるが、そういった山村は無いと言い切れないのも事実である。"
msgstr "  Although expressways and Japan Rail-the old National Railways-now spanned the country like arteries, it wasn't entirely impossible for mountain villages like his to exist."

#. Occurrence 1_2:2117:284: scene=1_2
#: 1_2:2117
msgctxt "text_id=284 | speaker=unknown"
msgid "　いま確かなコトは、そんな状況で暮らしてきた人間が何を考えて生きているか想像できない、というコトだけだ。"
msgstr "  But she couldn't imagine how someone born to such circumstances would think or live."

#. Occurrence 1_2:2152:285: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0018; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2152
msgctxt "text_id=285 | speaker=aoko"
msgid "「電気がないって……村に行き渡っていないだけで、公衆電話ぐらいはあったんですよね？」"
msgstr "\"When you say no electricity... you mean in general, right? Like, he must have had access to a public phone.\""

#. Occurrence 1_2:2175:286: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0016; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:2175
msgctxt "text_id=286 | speaker=yamashiro"
msgid "「なかったそうだよ。こっちに暮らすようになって、まず驚いたのが電話だそうだし。"
msgstr "\"Apparently not. He mentioned how shocked he was by the phones when he started living here."

#. Occurrence 1_2:2181:287: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0017; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:2181
msgctxt "text_id=287 | speaker=yamashiro"
msgid "　電話って便利ですね、なんて真顔で言われてねぇ。そういえばそうだなあ、と再確認させられたぐらいだよ」"
msgstr "  I kid you not, he said, 'Wow, telephones are so useful.' Couldn't really deny that, could I?\""

#. Occurrence 1_2:2201:288: scene=1_2
#: 1_2:2201
msgctxt "text_id=288 | speaker=unknown"
msgid "　あはは、と笑う教師を彼女は横目で睨む。"
msgstr "  She shot a sidelong glare his way as he laughed."

#. Occurrence 1_2:2206:289: scene=1_2
#: 1_2:2206
msgctxt "text_id=289 | speaker=unknown"
msgid "　何が嬉しいのか、山城教諭は田舎の純朴な少年にあてられて<和|なご>んでいるらしい。"
msgstr "  It seemed that the naivete of the country boy had cheered up Mr. Yamasiro a bit."

#. Occurrence 1_2:2242:290: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0019; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2242
msgctxt "text_id=290 | speaker=aoko"
msgid "「……<駐在|ちゅうざい>もいないって事か……うちも実家は山奥ですから、電気が通っていないのはあり得ないとは言いませんけど。"
msgstr "\"They probably didn't have police officers, either. My family home is up in the mountains, so it's not inconceivable they wouldn't have electricity."

#. Occurrence 1_2:2248:291: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0020; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2248
msgctxt "text_id=291 | speaker=aoko"
msgid "　―――そいつ、学校<も|・>知らないんですか？」"
msgstr "  But... he doesn't even know what school is?\""

#. Occurrence 1_2:2269:292: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0018; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:2269
msgctxt "text_id=292 | speaker=yamashiro"
msgid "「うん。どんなものかは知っていたそうだけど、実際来るのは今日が初めてらしい。それで緊張していたのかな、あまり会話も<弾|はず>まなかった。"
msgstr "\"Nope. He'd heard of them, but this is apparently his first time visiting one. Maybe that's why he's nervous. He wasn't very talkative."

#. Occurrence 1_2:2275:293: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0019; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:2275
msgctxt "text_id=293 | speaker=yamashiro"
msgid "　うーん、ああいうのも野生児っていうのかな？　狼に育てられた狼少年、みたいな？　いや、探検隊の話だねぇ！」"
msgstr "  He's almost―what would you call it―feral? Like a boy raised by wolves. I suppose that makes this a safari!\""

#. Occurrence 1_2:2314:294: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0021; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2314
msgctxt "text_id=294 | speaker=aoko"
msgid "「…………………」"
msgstr "\"...\""

#. Occurrence 1_2:2320:295: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0020; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:2320
msgctxt "text_id=295 | speaker=yamashiro"
msgid "「ちょっ、怖いなあ蒼崎くん。冗談、冗談だって。そう睨まないでくれ。"
msgstr "\"Hey, you're scaring me, Aozaki. I was joking. Go easy, okay?"

#. Occurrence 1_2:2326:296: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0021; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:2326
msgctxt "text_id=296 | speaker=yamashiro"
msgid "　大丈夫、話してみた感じ、おとなしい子だったから！"
msgstr "  And don't worry. I got the feeling from talking to him that he's a nice kid!"

#. Occurrence 1_2:2326:297: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0021; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:2326
msgctxt "text_id=297 | speaker=yamashiro"
msgid "　なんていうか、言葉の通じない小動物みたいな感じ」"
msgstr "  He was almost like, I don't know, a cute little animal that doesn't speak human!\""

#. Occurrence 1_2:2339:298: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0022; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2339
msgctxt "text_id=298 | speaker=aoko"
msgid "「山城先生。その<喩|たと>え、気休めになってませんから」"
msgstr "\"Your jokes and metaphors aren't helping.\""

#. Occurrence 1_2:2377:299: scene=1_2
#: 1_2:2377
msgctxt "text_id=299 | speaker=unknown"
msgid "　つっけんどんに返しつつ、彼女は電気のない生活とやらをシミュレートしようとし、ただでさえ不機嫌な顔をいっそう刺々しく曇らせた。"
msgstr "  As she gave her blunt reply, she tried to simulate in her mind what life without electricity would be like, but the thought of it took her sour mood from bad to worse."

#. Occurrence 1_2:2409:300: scene=1_2
#: 1_2:2409
msgctxt "text_id=300 | speaker=unknown"
msgid "　だって、それは彼女の知らない世界だ。"
msgstr "  After all, it was a world she had never known."

#. Occurrence 1_2:2414:301: scene=1_2
#: 1_2:2414
msgctxt "text_id=301 | speaker=unknown"
msgid "　教師陣が両手を上げて降参したのも頷ける。"
msgstr "  She could understand why the teachers had given up."

#. Occurrence 1_2:2420:302: scene=1_2
#: 1_2:2420
msgctxt "text_id=302 | speaker=unknown"
msgid "　本当は彼女も降参して暖かなベッドに戻りたかったが、<一|いち><文|もん>にもならない自尊心が押しとどめていた。"
msgstr "  She, too, wanted to give up and return to her warm bed, but her good-for-nothing pride was holding her hostage."

#. Occurrence 1_2:2425:303: scene=1_2
#: 1_2:2425
msgctxt "text_id=303 | speaker=unknown"
msgid "　出来ると見込まれ、自分も出来ると判断して引き受けた以上、経緯や内容はどうあれ、そう簡単に放り出すワケにはいかないのだ。"
msgstr "  Not only did the teachers believe she was up to the task, but she also believed she could do it. It wasn't that easy to go back on her word-no matter how bad things looked after the fact."

#. Occurrence 1_2:2460:304: scene=1_2
#: 1_2:2460
msgctxt "text_id=304 | speaker=unknown"
msgid "　<雨音|あまおと>を背に、冷めきった廊下を歩いていく。"
msgstr "  She walked along the hallway, the rain pattering in the background."

#. Occurrence 1_2:2466:305: scene=1_2
#: 1_2:2466
msgctxt "text_id=305 | speaker=unknown"
msgid "　会議室はもう目前。"
msgstr "  The meeting room was already in sight."

#. Occurrence 1_2:2471:306: scene=1_2
#: 1_2:2471
msgctxt "text_id=306 | speaker=unknown"
msgid "　眉間に<皺|しわ>をよせたまま、長い髪を揺らして、彼女はまだ見ぬ異邦人へと向かっていく。"
msgstr "  With a furrowed brow, she fixed her long hair in anticipation of meeting the unknown stranger within."

#. Occurrence 1_2:2476:307: scene=1_2
#: 1_2:2476
msgctxt "text_id=307 | speaker=unknown"
msgid "　優雅な足取りのまま、戦場に突撃するかの如く。"
msgstr "  Her elegant strides were like those of a confident general going into battle."

#. Occurrence 1_2:2515:308: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0022; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:2515
msgctxt "text_id=308 | speaker=yamashiro"
msgid "「……いや、蒼崎くん？"
msgstr "\"...Umm, Aozaki?"

#. Occurrence 1_2:2521:309: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0023; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:2521
msgctxt "text_id=309 | speaker=yamashiro"
msgid "　君を信頼してる僕だけど、念のため確認しておくよ。なんていうか、優しくね。できれば笑顔とか作れないかな？」"
msgstr "  I believe in you and all, but I'll say it again. Be nice, okay? Can you at least try to smile?\""

#. Occurrence 1_2:2533:310: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0023; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2533
msgctxt "text_id=310 | speaker=aoko"
msgid "「作り笑いは苦手です。一応、努力しているつもりですが」"
msgstr "\"I'm bad at faking smiles. But I'll do my best.\""

#. Occurrence 1_2:2539:311: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0024; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:2539
msgctxt "text_id=311 | speaker=yamashiro"
msgid "「あ。そうなんだ、それは良かった。"
msgstr "\"Really? That's a relief..."

#. Occurrence 1_2:2545:312: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0025; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:2545
msgctxt "text_id=312 | speaker=yamashiro"
msgid "　……いやあ、ほんと良かった。蒼崎くんにも苦手なものってあったんだねぇ……」"
msgstr "  I really mean it. It's good to know you're not good at everything.\""

#. Occurrence 1_2:2594:313: scene=1_2
#: 1_2:2594
msgctxt "text_id=313 | speaker=unknown"
msgid "　山城教諭が肩を落とすのと、<件|くだん>の会議室に到着したのは同時だった。"
msgstr "  Mr. Yamasiro's shoulders slumped the second they reached the meeting room."

#. Occurrence 1_2:2599:314: scene=1_2
#: 1_2:2599
msgctxt "text_id=314 | speaker=unknown"
msgid "　山城教諭は“優しく、優しくね”と目配せし、会議室の扉に手をかける。"
msgstr "  As he put his hand to the door, his eyes seemed to say to her, \"Be nice, please.\""

#. Occurrence 1_2:2604:315: scene=1_2
#: 1_2:2604
msgctxt "text_id=315 | speaker=unknown"
msgid "　そんな扱いに、彼女のイライラは増すばかりだ。"
msgstr "  This only made her more irritated."

#. Occurrence 1_2:2642:316: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0024; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2642
msgctxt "text_id=316 | speaker=aoko"
msgid "『……分かってるわよ、愛想が悪いってのは。でも笑顔なんて意識して作るものじゃないんだし……"
msgstr "(I already know I'm not the friendliest-looking person in the world, but I can't just make myself smile at the drop of a hat."

#. Occurrence 1_2:2649:317: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0025; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2649
msgctxt "text_id=317 | speaker=aoko"
msgid "だいたい、そういうインスタントな人付き合いなら<鳶丸|とびまる>の方が向いてるっての』"
msgstr "You should have asked Tobimaru if that's what you were after.)"

#. Occurrence 1_2:2682:318: scene=1_2
#: 1_2:2682
msgctxt "text_id=318 | speaker=unknown"
msgid "　彼女は自分の愛想の無さにため息をつくが、考えてみると、寝不足のまま休日の学校に呼び出されては笑顔も何もあったものではない。"
msgstr "  She sighed about her social shortcomings, but then it occurred to her that being called into school on a day off while sleep-deprived wasn't anything to smile about anyway."

#. Occurrence 1_2:2687:319: scene=1_2
#: 1_2:2687
msgctxt "text_id=319 | speaker=unknown"
msgid "　くわえて、その元凶は高校生より小学生から始めた方がよさそうな人物なのだ。"
msgstr "  She also thought the person responsible for this mess would be better off attending elementary school."

#. Occurrence 1_2:2707:320: scene=1_2
#: 1_2:2707
msgctxt "text_id=320 | speaker=unknown"
msgid "　……その人物に責任はないにせよ、彼女にだって、学校側の仕事を押しつけられる責任も義理もないのである。"
msgstr "  It might not be his fault, but neither was it her duty or obligation to do the teachers' work for them."

#. Occurrence 1_2:2712:321: scene=1_2
#: 1_2:2712
msgctxt "text_id=321 | speaker=unknown"
msgid "　せめて、なんというか。"
msgstr "  At the very least..."

#. Occurrence 1_2:2717:322: scene=1_2
#: 1_2:2717
msgctxt "text_id=322 | speaker=unknown"
msgid "　もうちょっと空気を読んで平日にやってきてくれたのなら、と愚痴の一つも言いたくなる。"
msgstr "  They could have used their brains and organized all this on a normal school day―another complaint she wanted to voice later."

#. Occurrence 1_2:2756:323: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0026; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2756
msgctxt "text_id=323 | speaker=aoko"
msgid "『……いや。というか敵。何であろうと敵。"
msgstr "(I hate him already. He's my sworn enemy and I haven't even met him."

#. Occurrence 1_2:2756:324: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0026; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2756
msgctxt "text_id=324 | speaker=aoko"
msgid "　悪いけど<情状酌量|じょうじょうしゃくりょう>以前に敵……！"
msgstr "  Sorry, but I couldn't care less about his extenuating circumstances!"

#. Occurrence 1_2:2762:325: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0027; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:2762
msgctxt "text_id=325 | speaker=aoko"
msgid "　間が悪いのはお互い様っていうか、ほんと、なんでよりにもよってこんな忙しい時に―――』"
msgstr "  You think this isn't awkward for me, too? Honestly, why did this have to happen when I'm so busy!?)"

#. Occurrence 1_2:2819:326: scene=1_2
#: 1_2:2819
msgctxt "text_id=326 | speaker=unknown"
msgid "　寝不足でキリキリ痛む頭が、彼女の攻撃性を一割増しにする。"
msgstr "  Her pounding headache from a lack of sleep had boosted her aggression by ten percent."

#. Occurrence 1_2:2824:327: scene=1_2
#: 1_2:2824
msgctxt "text_id=327 | speaker=unknown"
msgid "　この扉の向こうにいる人物がどれだけ無害であれ、我が眠りを妨げたモノはみんな敵。"
msgstr "  No matter how harmless the guy on the other side of the door may be, anyone who disturbed her sleep was the enemy."

#. Occurrence 1_2:2832:328: scene=1_2
#: 1_2:2832
msgctxt "text_id=328 | speaker=unknown"
msgid "　そんな彼女のイライラが頂点に達しかけたタイミングで、山城教諭は会議室の扉を開けた。"
msgstr "  And just as she was reaching peak annoyance, Mr. Yamasiro opened the door to the meeting room."

#. Occurrence 1_2:2853:329: scene=1_2
#: 1_2:2853
msgctxt "text_id=329 | speaker=unknown"
msgid "　……ゆっくりと横に開いていく風景。"
msgstr "  The room slowly slid into view."

#. Occurrence 1_2:2858:330: scene=1_2
#: 1_2:2858
msgctxt "text_id=330 | speaker=unknown"
msgid "　<情緒|じょうちょ>なんてお構いなし。"
msgstr "  She didn't care for formalities,"

#. Occurrence 1_2:2863:331: scene=1_2
#: 1_2:2863
msgctxt "text_id=331 | speaker=unknown"
msgid "　まっすぐな視線のまま、彼女は会議室に<突撃|しんこう>し―――"
msgstr "  just looked straight ahead and stormed into the room."

#. Occurrence 1_2:2869:332: scene=1_2
#: 1_2:2869
msgctxt "text_id=332 | speaker=unknown"
msgid "　その、一風変わった敵と対面した。"
msgstr "  And found herself face to face with a most unusual opponent."

#. Occurrence 1_2:2914:333: scene=1_2
#: 1_2:2914
msgctxt "text_id=333 | speaker=unknown"
msgid "　カメラは再び一方に。"
msgstr "  Before we go on, let's see from another perspective."

#. Occurrence 1_2:2919:334: scene=1_2
#: 1_2:2919
msgctxt "text_id=334 | speaker=unknown"
msgid "　時間は、少しだけ巻き戻る。"
msgstr "  Turning back the clock just a little..."

#. Occurrence 1_2:2953:335: scene=1_2
#: 1_2:2953
msgctxt "text_id=335 | speaker=unknown"
msgid "『何をしなくともいい』という指令は、"
msgstr "\"You don't have to do anything.\""

#. Occurrence 1_2:2953:336: scene=1_2
#: 1_2:2953
msgctxt "text_id=336 | speaker=unknown"
msgid "　ある種の人間にとってはかけがえのない贅沢であり、"
msgstr "  For some, these words are a priceless luxury."

#. Occurrence 1_2:2953:337: scene=1_2
#: 1_2:2953
msgctxt "text_id=337 | speaker=unknown"
msgid "　ある種の人間にとっては耐えがたい責め苦である。"
msgstr "  For others, they are unbearable torture."

#. Occurrence 1_2:2990:338: scene=1_2
#: 1_2:2990
msgctxt "text_id=338 | speaker=unknown"
msgid "　能動的な彼女にすれば<羨|うらや>ましい反面、怪しすぎて受け取れない高級品。"
msgstr "  For the proactive girl, it was definitely the former, though she'd be too suspicious of the motives of anyone giving her such a gift to accept it."

#. Occurrence 1_2:2996:339: scene=1_2
#: 1_2:2996
msgctxt "text_id=339 | speaker=unknown"
msgid "　受動的な彼にすれば親しめる反面、郷愁を起こす<苦|にが>い棘……の筈なのだが、目下、絶賛待たされっぱなしの顔にこれといった不満は見られない。"
msgstr "  For the passive boy, it was definitely the latter. A bitter thorn that made him homesick, though at this very moment his mind was still distracted with the wait for his face to reveal any discontent."

#. Occurrence 1_2:3016:340: scene=1_2
#: 1_2:3016
msgctxt "text_id=340 | speaker=unknown"
msgid "　彼は自然に、姿勢を正したまま灰色の空模様を眺めている。"
msgstr "  He maintained perfect posture as he stared at the gray sky."

#. Occurrence 1_2:3021:341: scene=1_2
#: 1_2:3021
msgctxt "text_id=341 | speaker=unknown"
msgid "　さらに待ち続けてはや一時間だが、まあ、先方さんにも都合があるのだろうし、何もお金を取られるワケでもなし。"
msgstr "  He had already waited a whole hour, but figured they must have had their reasons for making him wait."

#. Occurrence 1_2:3026:342: scene=1_2
#: 1_2:3026
msgctxt "text_id=342 | speaker=unknown"
msgid "　雨音さえあればいつまでも待ち続けられる、といった風。"
msgstr "  And as long as he had the sound of the rain to soothe him, he could keep on waiting."

#. Occurrence 1_2:3061:343: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0002; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:3061
msgctxt "text_id=343 | speaker=soujuurou"
msgid "『でも、そろそろ九時を過ぎるのか……"
msgstr "(It must be nine o' clock already."

msgctxt "text_id=344 | speaker=unknown"
msgid "　うん、どうなんだろう』"
msgstr "  Yeah, that seems about right.)"

#. Occurrence 1_2:3069:345: scene=1_2
#: 1_2:3069
msgctxt "text_id=345 | speaker=unknown"
msgid "　それでも漠然と、いちおう時計を気にしながら、ぼんやりと雨音を聴く。"
msgstr "  He had been vaguely keeping track of the time as he listened to the rain."

#. Occurrence 1_2:3103:346: scene=1_2
#: 1_2:3103
msgctxt "text_id=346 | speaker=unknown"
msgid "　休日の校舎に<雑音|かいわ>はない。"
msgstr "  Due to the holiday, the school building was completely silent,"

#. Occurrence 1_2:3109:347: scene=1_2
#: 1_2:3109
msgctxt "text_id=347 | speaker=unknown"
msgid "　ポツポツと窓を叩く雨。"
msgstr "  except for the patter of the rain on the window."

#. Occurrence 1_2:3170:348: scene=1_2
#: 1_2:3170
msgctxt "text_id=348 | speaker=unknown"
msgid "　しん……と沈みこむ空気の<軋|きし>み。"
msgstr "  The mood felt as damp as the air."

#. Occurrence 1_2:3176:349: scene=1_2
#: 1_2:3176
msgctxt "text_id=349 | speaker=unknown"
msgid "　それと、"
msgstr "  It was then..."

#. Occurrence 1_2:3204:350: scene=1_2
#: 1_2:3204
msgctxt "text_id=350 | speaker=unknown"
msgid "　カツカツとまっすぐに、<力|ちから>強く響いてくる<靴|くつ>の音。"
msgstr "  ...he heard the heavy clatter of footsteps approaching."

#. Occurrence 1_2:3225:351: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0003; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:3225
msgctxt "text_id=351 | speaker=soujuurou"
msgid "『……良かった、忘れられているかと思った』"
msgstr "(Finally. I thought they'd forgotten about me.)"

#. Occurrence 1_2:3242:352: scene=1_2
#: 1_2:3242
msgctxt "text_id=352 | speaker=unknown"
msgid "　軽い足音と、それより重い大人の足音が聞こえる。"
msgstr "  He could hear two sets of footsteps, one heavier set belonging to an adult."

#. Occurrence 1_2:3261:353: scene=1_2
#: 1_2:3261
msgctxt "text_id=353 | speaker=unknown"
msgid "　彼がほっと安堵の息をもらした時、会議室の扉がスライドした。"
msgstr "  He breathed a sigh of relief as the door slid open."

#. Occurrence 1_2:3299:354: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0026; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:3299
msgctxt "text_id=354 | speaker=yamashiro"
msgid "「すまないね、ずいぶんとお待たせしちゃって」"
msgstr "\"So sorry to keep you waiting.\""

#. Occurrence 1_2:3305:355: scene=1_2
#: 1_2:3305
msgctxt "text_id=355 | speaker=unknown"
msgid "　まず目に入ったのが、バツの悪そうな笑顔をした、眼鏡をかけた男性。"
msgstr "  The first person he saw was a man wearing glasses and an awkward smile."

#. Occurrence 1_2:3310:356: scene=1_2
#: 1_2:3310
msgctxt "text_id=356 | speaker=unknown"
msgid "　たしか<山城和樹|やましろかずき>という先生で、ここに案内してくれたのも彼だった。"
msgstr "  That's Mr. Yamasiro, the one who brought me here."

#. Occurrence 1_2:3331:357: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0027; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:3331
msgctxt "text_id=357 | speaker=yamashiro"
msgid "「って、あれ？　<里中|さとなか>先生いないんですか？"
msgstr "\"Hey, where's Mr. Satonaka?"

#. Occurrence 1_2:3331:358: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0027; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:3331
msgctxt "text_id=358 | speaker=yamashiro"
msgid "　……酷いなあ、話し相手になってあげてと言ったのに」"
msgstr "  I told him to keep you company. He shouldn't have left you here.\""

#. Occurrence 1_2:3337:359: scene=1_2
#: 1_2:3337
msgctxt "text_id=359 | speaker=unknown"
msgid "　山城氏はますます申し訳なさそうに頭をかく。"
msgstr "  Mr. Yamasiro scratched his head, looking increasingly apologetic."

#. Occurrence 1_2:3342:360: scene=1_2
#: 1_2:3342
msgctxt "text_id=360 | speaker=unknown"
msgid "　その後ろから、"
msgstr "  And then, from behind him..."

#. Occurrence 1_2:3416:361: scene=1_2
#: 1_2:3416
msgctxt "text_id=361 | speaker=unknown"
msgid "　不機嫌そうに口を閉ざしたまま。"
msgstr "  With a tight-lipped expression that made it clear she didn't want to be there,"

#. Occurrence 1_2:3421:362: scene=1_2
#: 1_2:3421
msgctxt "text_id=362 | speaker=unknown"
msgid "　迷いのない眼差しで、長い黒髪の少女が現れた。"
msgstr "  a dark-haired girl with a determined look in her eyes appeared."

#. Occurrence 1_2:3489:363: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0004; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:3489
msgctxt "text_id=363 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 1_2:3495:364: scene=1_2
#: 1_2:3495
msgctxt "text_id=364 | speaker=unknown"
msgid "　呆然と息を<呑|の>む。"
msgstr "  Soujyuro gulped."

#. Occurrence 1_2:3500:365: scene=1_2
#: 1_2:3500
msgctxt "text_id=365 | speaker=unknown"
msgid "　窓を打つ雨音が<聴覚|せかい>から消失する。"
msgstr "  The sound of the rain on the window faded into nothingness."

#. Occurrence 1_2:3505:366: scene=1_2
#: 1_2:3505
msgctxt "text_id=366 | speaker=unknown"
msgid "　……この時。"
msgstr "  That's when he knew..."

#. Occurrence 1_2:3510:367: scene=1_2
#: 1_2:3510
msgctxt "text_id=367 | speaker=unknown"
msgid "　錯覚ではあれ、時間の経過を感じなくなる事は本当にあるのだと、彼ははじめて思い知った。"
msgstr "  This was how it felt when time stood still."

#. Occurrence 1_2:3599:368: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0028; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:3599
msgctxt "text_id=368 | speaker=aoko"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 1_2:3605:369: scene=1_2
#: 1_2:3605
msgctxt "text_id=369 | speaker=unknown"
msgid "　彼女はほんの少し、驚くように<瞬|またた>いた。"
msgstr "  She blinked quickly a few times as if taken aback."

#. Occurrence 1_2:3610:370: scene=1_2
#: 1_2:3610
msgctxt "text_id=370 | speaker=unknown"
msgid "　理由は不明。"
msgstr "  Why was anyone's guess."

#. Occurrence 1_2:3615:371: scene=1_2
#: 1_2:3615
msgctxt "text_id=371 | speaker=unknown"
msgid "　先だって聞いていた通り、少年は純朴な田舎のイメージそのものだったのに、直感的に“納得いかない”と反発して。"
msgstr "  The boy was everything she expected a naive country boy to look like. However, she felt something she couldn't understand."

#. Occurrence 1_2:3649:372: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0005; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:3649
msgctxt "text_id=372 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 1_2:3655:373: scene=1_2
#: 1_2:3655
msgctxt "text_id=373 | speaker=unknown"
msgid "　彼はほんの少し、驚くように目を開いた。"
msgstr "  His eyes widened slightly as if taken aback."

#. Occurrence 1_2:3660:374: scene=1_2
#: 1_2:3660
msgctxt "text_id=374 | speaker=unknown"
msgid "　理由は明白。"
msgstr "  The reason was obvious."

#. Occurrence 1_2:3665:375: scene=1_2
#: 1_2:3665
msgctxt "text_id=375 | speaker=unknown"
msgid "　……ただ、それを正しくカタチにできる言葉を知らなかったので、結局こちらも解答欄は空白のまま。"
msgstr "  Putting his feeling into words was a different matter altogether. So we will never know exactly what he experienced in that moment."

#. Occurrence 1_2:3702:376: scene=1_2
#: 1_2:3702
msgctxt "text_id=376 | speaker=unknown"
msgid "　この瞬間。"
msgstr "  That's when it hit him..."

#. Occurrence 1_2:3707:377: scene=1_2
#: 1_2:3707
msgctxt "text_id=377 | speaker=unknown"
msgid "　少年はたしかに、何か運命じみたものに触れた気がした。"
msgstr "  He sensed he'd been touched by the hands of destiny."

#. Occurrence 1_2:3746:378: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0028; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:3746
msgctxt "text_id=378 | speaker=yamashiro"
msgid "「紹介するよ。彼が転入生の<静希|しずき><草十郎|そうじゅうろう>くん。"
msgstr "\"Allow me to introduce the two of you. This is the transfer student I mentioned, Soujyuro Sizuki."

#. Occurrence 1_2:3764:379: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0029; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:3764
msgctxt "text_id=379 | speaker=yamashiro"
msgid "　で、こっちの彼女が静希くんの案内役。"
msgstr "  And this is the girl that will be showing you around."

#. Occurrence 1_2:3770:380: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0030; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:3770
msgctxt "text_id=380 | speaker=yamashiro"
msgid "　うちの生徒会長で、休日を押して新しい仲間の案内役を買って出てくれた、<蒼崎|あおざき><青子|あおこ>くんだ」"
msgstr "  She's our student council president and came in on her day off just to welcome you. Her name is Aoko Aozaki.\""

#. Occurrence 1_2:3870:381: scene=1_2
#: 1_2:3870
msgctxt "text_id=381 | speaker=unknown"
msgid "　―――声も雨音も<仄|ほの>かに遠く。"
msgstr "  His voice and the sound of the rain seemed distant."

#. Occurrence 1_2:3876:382: scene=1_2
#: 1_2:3876
msgctxt "text_id=382 | speaker=unknown"
msgid "　二人の出会いはこんな感じ。"
msgstr "  This is how they first met."

#. Occurrence 1_2:3881:383: scene=1_2
#: 1_2:3881
msgctxt "text_id=383 | speaker=unknown"
msgid "　良きにしろ<悪|わる>きにしろ、バチッと火花が散るような、そんな、どうでもいい始まりだった。"
msgstr "  Such was their start, for better or worse. Like the ephemeral beauty of fireworks."

#. Occurrence 1_2:3978:384: scene=1_2
#: 1_2:3978
msgctxt "text_id=384 | speaker=unknown"
msgid "　生徒たちの通説によると。"
msgstr "  It was commonly believed among the students..."

#. Occurrence 1_2:3983:385: scene=1_2
#: 1_2:3983
msgctxt "text_id=385 | speaker=unknown"
msgid "　蒼崎青子は、いつもご機嫌ななめである。"
msgstr "  ...that Aoko was always in a foul mood."

#. Occurrence 1_2:4023:386: scene=1_2
#: 1_2:4023
msgctxt "text_id=386 | speaker=unknown"
msgid "　これは九割がた偏見で、青子だって、そんな四六時中イライラできるほど暇ではない。"
msgstr "  But this gossip was ninety percent prejudice, as Aoko simply didn't have time to be irritated twenty-four seven."

#. Occurrence 1_2:4028:387: scene=1_2
#: 1_2:4028
msgctxt "text_id=387 | speaker=unknown"
msgid "　彼女は単に言い訳をしたがらない性格なだけで、"
msgstr "  The reality was she simply didn't want to explain herself all the time"

#. Occurrence 1_2:4033:388: scene=1_2
#: 1_2:4033
msgctxt "text_id=388 | speaker=unknown"
msgid "　たえず微妙に、ときに露骨に、見えない何かに対して怒っているように見えるだけなのだ。"
msgstr "  and therefore seemed angry about something, obvious or not."

#. Occurrence 1_2:4038:389: scene=1_2
#: 1_2:4038
msgctxt "text_id=389 | speaker=unknown"
msgid "　なので九割がたは偏見の、噂に尾ひれのついた学園七脅威の一つにすぎない。"
msgstr "  This idle gossip did, however, lead to her earning the title of one the school's Seven Deadly Threats."

#. Occurrence 1_2:4060:390: scene=1_2
#: 1_2:4060
msgctxt "text_id=390 | speaker=unknown"
msgid "　ただし、残りの一割は真実だ。"
msgstr "  The remaining ten percent of the gossip was right on the mark."

#. Occurrence 1_2:4065:391: scene=1_2
#: 1_2:4065
msgctxt "text_id=391 | speaker=unknown"
msgid "　青子自身、自分が慢性的な頭痛持ちなんじゃないかと疑うほど、無害なものに反感を覚える事があったりする。"
msgstr "  Aoko herself often had the feeling that her tendency to feel animosity toward harmless things was akin to what a chronic headache sufferer might experience."

#. Occurrence 1_2:4073:392: scene=1_2
#: 1_2:4073
msgctxt "text_id=392 | speaker=unknown"
msgid "　今日はその一割の話。"
msgstr "  Today fell under that ten percent."

#. Occurrence 1_2:4078:393: scene=1_2
#: 1_2:4078
msgctxt "text_id=393 | speaker=unknown"
msgid "　そういう時にかぎって彼女の怒りは純真な、"
msgstr "  For today her anger was pure,"

#. Occurrence 1_2:4078:394: scene=1_2
#: 1_2:4078
msgctxt "text_id=394 | speaker=unknown"
msgid "　年相応に子供らしいわがままだったりするのだが。"
msgstr "  and her childish and selfish display was befitting of her actual age."

#. Occurrence 1_2:4121:395: scene=1_2
#: 1_2:4121
msgctxt "text_id=395 | speaker=unknown"
msgid "　会議室は薄暗い、雨の色に染まっていた。"
msgstr "  The meeting room was dimly lit, awash in the colors of the rain."

#. Occurrence 1_2:4126:396: scene=1_2
#: 1_2:4126
msgctxt "text_id=396 | speaker=unknown"
msgid "　電気代節約のため、昼間は電灯をつけないのが学校のルールだ。"
msgstr "  To reduce electricity costs, school regulations forbid the use of lights during the day."

#. Occurrence 1_2:4131:397: scene=1_2
#: 1_2:4131
msgctxt "text_id=397 | speaker=unknown"
msgid "　そんな中に、<件|くだん>の人物は立っていた。"
msgstr "  This was the setting the three of them found themselves in."

#. Occurrence 1_2:4166:398: scene=1_2
#: 1_2:4166
msgctxt "text_id=398 | speaker=unknown"
msgid "　第一印象は、野花を連想させる落ち着き様。"
msgstr "  Her first impression was that his calm demeanor reminded her of a field of wildflowers."

#. Occurrence 1_2:4171:399: scene=1_2
#: 1_2:4171
msgctxt "text_id=399 | speaker=unknown"
msgid "　すっと伸びた背筋のクセに、全体的に力が抜けていて、とにかくおとなしい。"
msgstr "  In spite of his perfect posture, his overall air felt placid―tame, even."

#. Occurrence 1_2:4176:400: scene=1_2
#: 1_2:4176
msgctxt "text_id=400 | speaker=unknown"
msgid "　ひょろり、とはいかないまでも、ひっそり、ぐらいの<頼|たよ>りなさ。"
msgstr "  And though describing him as meek would be going too far, at the very least he was passive."

#. Occurrence 1_2:4216:401: scene=1_2
#: 1_2:4216
msgctxt "text_id=401 | speaker=unknown"
msgid "　制服の上からでも分かる、標準よりやや細い体つき。"
msgstr "  Even through his uniform, she could see that he was thinner than average."

#. Occurrence 1_2:4221:402: scene=1_2
#: 1_2:4221
msgctxt "text_id=402 | speaker=unknown"
msgid "　あまり手入れをされていない黒髪と、とくに目を引く部分のない少年像が、そこにはあった。"
msgstr "  His dark hair was unkempt, and he came across as a wholly forgettable boy."

#. Occurrence 1_2:4226:403: scene=1_2
#: 1_2:4226
msgctxt "text_id=403 | speaker=unknown"
msgid "　いや。その<凡庸|ぼんよう>さを好意的に解釈するなら、少年ではなく青年っぽいというべきだろう。"
msgstr "  If she had to look at him in a more positive light, she would describe him more a young man than a boy."

#. Occurrence 1_2:4231:404: scene=1_2
#: 1_2:4231
msgctxt "text_id=404 | speaker=unknown"
msgid "　落ち着いた雰囲気がどことなく大人びている。"
msgstr "  It was his calm demeanor that made him seem more mature."

#. Occurrence 1_2:4251:405: scene=1_2
#: 1_2:4251
msgctxt "text_id=405 | speaker=unknown"
msgid "　……そのあたりが青子の“理由なき反感”に繋がったのか。"
msgstr "  Was that the cause of Aoko's reasonless reaction?"

#. Occurrence 1_2:4256:406: scene=1_2
#: 1_2:4256
msgctxt "text_id=406 | speaker=unknown"
msgid "　少年はあまりに自然で、違和感なく会議室の風景に溶けこんでいた。学校では彼の方が異分子なのに、自分たちの方が客人になったような錯覚。"
msgstr "  He seemed almost too at home in the meeting room, and she was left with the impression that it was her and the teacher, not this outsider, who were the guests here."

#. Occurrence 1_2:4293:407: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0029; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:4293
msgctxt "text_id=407 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 1_2:4299:408: scene=1_2
#: 1_2:4299
msgctxt "text_id=408 | speaker=unknown"
msgid "　まるで、自分たちが持って生まれた正当性を<糾|ただ>されたような、正体不明の苛立ち。"
msgstr "  She felt an unidentifiable aggravation building within her, almost as if her right to be here was in question."

#. Occurrence 1_2:4304:409: scene=1_2
#: 1_2:4304
msgctxt "text_id=409 | speaker=unknown"
msgid "　カチン、と警戒心にスイッチが入るのを青子は感じた。"
msgstr "  Aoko felt herself raising her natural defenses."

#. Occurrence 1_2:4343:410: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0030; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:4343
msgctxt "text_id=410 | speaker=aoko"
msgid "『―――信じられない。"
msgstr "(...What's with me?"

#. Occurrence 1_2:4349:411: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0031; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:4349
msgctxt "text_id=411 | speaker=aoko"
msgid "　私、いま<意|ワ><味|ケ>もなく怒ってない……？』"
msgstr "  Am I really this angry for no reason?)"

#. Occurrence 1_2:4435:412: scene=1_2
#: 1_2:4435
msgctxt "text_id=412 | speaker=unknown"
msgid "　分からない事は苛立たしい。自分の<感|コ><情|ト>なら尚更だ。"
msgstr "  She hated not understanding things, her own emotions, in particular."

#. Occurrence 1_2:4440:413: scene=1_2
#: 1_2:4440
msgctxt "text_id=413 | speaker=unknown"
msgid "　完璧主義者である彼女にとって、それは痛くはないけど気がかりなトゲのようなもので、"
msgstr "  It pained her less than you would imagine for a perfectionist like her, but it still nagged her like a thorn in her side."

#. Occurrence 1_2:4447:414: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0031; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:4447
msgctxt "text_id=414 | speaker=yamashiro"
msgid "「いやぁ、ははは。ほら蒼崎くん、挨拶してあげなくちゃ」"
msgstr "\"Uh, hahaha. Aozaki, why don't you introduce yourself?\""

#. Occurrence 1_2:4490:415: scene=1_2
#: 1_2:4490
msgctxt "text_id=415 | speaker=unknown"
msgid "　山城の場を取り<繕|つくろ>う声にも、わりと本気でイラっとした。"
msgstr "  Mr. Yamasiro's attempt to relieve the tension was equally irritating."

#. Occurrence 1_2:4531:416: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0032; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:4531
msgctxt "text_id=416 | speaker=aoko"
msgid "「―――挨拶？」"
msgstr "\"...Introduce myself, huh.\""

#. Occurrence 1_2:4537:417: scene=1_2
#: 1_2:4537
msgctxt "text_id=417 | speaker=unknown"
msgid "　じろりと山城を横目で睨んでから、青子はまっすぐに少年を見据えた。"
msgstr "  After casting a nasty glance in the teacher's direction, Aoko turned to face the boy."

#. Occurrence 1_2:4560:418: scene=1_2
#: 1_2:4560
msgctxt "text_id=418 | speaker=unknown"
msgid "　いや、第三者的に見れば、正面から睨みつけた。"
msgstr "  From an outsider's perspective, it might have looked like a staredown."

#. Occurrence 1_2:4572:419: scene=1_2
#: 1_2:4572
msgctxt "text_id=419 | speaker=unknown"
msgid "　この瞬間。"
msgstr "  And in that instant..."

#. Occurrence 1_2:4577:420: scene=1_2
#: 1_2:4577
msgctxt "text_id=420 | speaker=unknown"
msgid "　災難なことに、彼女の感情の矛先はぴったりと、なんの罪もない初対面の少年に向けられたのである。"
msgstr "  The culmination of her emotional state hurtled toward the innocent boy, and skewered him."

#. Occurrence 1_2:4629:421: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0032; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:4629
msgctxt "text_id=421 | speaker=yamashiro"
msgid "「いや、待たせたね静希くん」"
msgstr "\"Again, sorry for the wait, Sizuki.\""

#. Occurrence 1_2:4643:422: scene=1_2
#: 1_2:4643
msgctxt "text_id=422 | speaker=unknown"
msgid "　名前を呼ばれて少年……草十郎は我に返った。"
msgstr "  Hearing his name, Soujyuro came to his senses."

#. Occurrence 1_2:4648:423: scene=1_2
#: 1_2:4648
msgctxt "text_id=423 | speaker=unknown"
msgid "　見惚れていた目をゆるめて、"
msgstr "  His stunned gaze shook loose."

#. Occurrence 1_2:4653:424: scene=1_2
#: 1_2:4653
msgctxt "text_id=424 | speaker=unknown"
msgid "　目眩を飲みこむように息を吸う。"
msgstr "  He took a deep breath to clear his head."

#. Occurrence 1_2:4658:425: scene=1_2
#: 1_2:4658
msgctxt "text_id=425 | speaker=unknown"
msgid "　その仕草から緊張していると見たのか、山城教諭は穏やかに笑って、かたわらの少女に語りかけた。"
msgstr "  Chalking it up to nerves, Mr. Yamasiro broke out a smile and turned to the girl standing beside him."

#. Occurrence 1_2:4699:426: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0033; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:4699
msgctxt "text_id=426 | speaker=yamashiro"
msgid "「紹介するよ。彼が転入生の静希草十郎くん。"
msgstr "\"I'll do the introductions then. This is the transfer student, Soujyuro Sizuki."

#. Occurrence 1_2:4705:427: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0034; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:4705
msgctxt "text_id=427 | speaker=yamashiro"
msgid "　で、こっちの彼女が静希くんの案内役。うちの生徒会長で、休日を押して新しい仲間の案内役を買って出てくれた、蒼崎青子くんだ」"
msgstr "  And this is our student council president who came in on her day off just to show you around. Her name is Aoko Aozaki.\""

#. Occurrence 1_2:4743:428: scene=1_2
#: 1_2:4743
msgctxt "text_id=428 | speaker=unknown"
msgid "　山城教諭に紹介され、少女は一歩前に出る。"
msgstr "  Having been introduced by Mr. Yamasiro, the girl took a step forward."

#. Occurrence 1_2:4748:429: scene=1_2
#: 1_2:4748
msgctxt "text_id=429 | speaker=unknown"
msgid "　視線に容赦はない。"
msgstr "  Her eyes were merciless."

#. Occurrence 1_2:4753:430: scene=1_2
#: 1_2:4753
msgctxt "text_id=430 | speaker=unknown"
msgid "　ほとんど暴力に近い、<値|ね><踏|ぶ>みするような凝視。"
msgstr "  Her stare, an unspoken threat to violently trample her opponent."

#. Occurrence 1_2:4787:431: scene=1_2
#: 1_2:4787
msgctxt "text_id=431 | speaker=unknown"
msgid "　<一方|いっぽう>草十郎は、正面から堂々と見つめられる事に驚きつつ、なんとか平静を保っていた。"
msgstr "  Soujyuro, on the other hand, managed to keep his own composure despite the shock at how confrontational she appeared."

#. Occurrence 1_2:4792:432: scene=1_2
#: 1_2:4792
msgctxt "text_id=432 | speaker=unknown"
msgid "　これまでこういう挨拶には出会わなかったけれど、都会では珍しいものではないのだろう、と勘違いしての事である。"
msgstr "  He had never been greeted quite like this before, but supposed, mistakenly, that this was how people treated each other in the city."

#. Occurrence 1_2:4836:433: scene=1_2
#: 1_2:4836
msgctxt "text_id=433 | speaker=unknown"
msgid "　そんなふたりのやり取りは、第三者視点からすると壮絶なものがあった。"
msgstr "  The exchange must have looked quite dramatic to an onlooker."

#. Occurrence 1_2:4842:434: scene=1_2
#: 1_2:4842
msgctxt "text_id=434 | speaker=unknown"
msgid "　とにかく因縁をつけたがっている乱暴者と、"
msgstr "  A girl ready to brawl..."

#. Occurrence 1_2:4847:435: scene=1_2
#: 1_2:4847
msgctxt "text_id=435 | speaker=unknown"
msgid "　それを何事だろう、と真剣に眺めている田舎者。"
msgstr "  An earnest country boy desperate to understand..."

#. Occurrence 1_2:4853:436: scene=1_2
#: 1_2:4853
msgctxt "text_id=436 | speaker=unknown"
msgid "　当事者たちはともかく、周りにいる人間にとっては蛇の生殺しに近い。"
msgstr "  It was a murderous limbo, especially for anyone in the room with them."

#. Occurrence 1_2:4894:437: scene=1_2
#: 1_2:4894
msgctxt "text_id=437 | speaker=unknown"
msgid "　たとえば、青子の後ろにいる山城教諭とか。"
msgstr "  Like Mr. Yamasiro, for example."

#. Occurrence 1_2:4899:438: scene=1_2
#: 1_2:4899
msgctxt "text_id=438 | speaker=unknown"
msgid "　良かれと思って案内役に優等生を選んでみたものの、なぜかその優等生はご機嫌ななめ。今もピリピリと空気を<震|ふる>わせている。"
msgstr "  While he had thought he had made the right decision in choosing an honor student to help him out, she was in an inexplicably bad mood, and the tension in the air was undeniable."

#. Occurrence 1_2:4993:439: scene=1_2
#: 1_2:4993
msgctxt "text_id=439 | speaker=unknown"
msgid "　ここに至って、山城は自らの失敗を受け入れた。"
msgstr "  It was this moment that he realized his failure."

#. Occurrence 1_2:4998:440: scene=1_2
#: 1_2:4998
msgctxt "text_id=440 | speaker=unknown"
msgid "　今さらの話ではあるが、"
msgstr "  His realization had come far too late."

#. Occurrence 1_2:5003:441: scene=1_2
#: 1_2:5003
msgctxt "text_id=441 | speaker=unknown"
msgid "　この、万事をそつなく解決する女子生徒は、扱いどころを間違えると一転して学校を<震|ふる>わす嵐になる。"
msgstr "  One false move, and this girl, for whom no problem was too large, would becoming a storm that would rock the very foundations of the school."

#. Occurrence 1_2:5008:442: scene=1_2
#: 1_2:5008
msgctxt "text_id=442 | speaker=unknown"
msgid "　オールマイティの絵柄が<悪魔|ジョーカー>みたいなもので、そんな時、現場に居合わせた教師はたいてい、<不祥事|ふしょうじ>の責任を取らされるのだ。"
msgstr "  Just as the almighty joker card could bring either fortune or disaster, the sole teacher who had been present at the time would come to bear the blame for the scandal that ensued."

#. Occurrence 1_2:5073:443: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0035; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:5073
msgctxt "text_id=443 | speaker=yamashiro"
msgid "「あー、うん。いけてる、二人とも気は合うようだね！"
msgstr "\"Wow, you two really seem to have hit it off!"

#. Occurrence 1_2:5079:444: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0036; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:5079
msgctxt "text_id=444 | speaker=yamashiro"
msgid "　……それじゃ、僕はこのヘンでいいかな？」"
msgstr "  ...I suppose I can leave you two to it, then?\""

#. Occurrence 1_2:5085:445: scene=1_2
#: 1_2:5085
msgctxt "text_id=445 | speaker=unknown"
msgid "　あはは、と白けた笑い声をあげながら、山城教諭はそろりそろりと扉に後じさった。"
msgstr "  Mr. Yamasiro laughed nervously as he crept toward the door."

#. Occurrence 1_2:5126:446: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0037; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:5126
msgctxt "text_id=446 | speaker=yamashiro"
msgid "「僕は職員室にいるから、終わったら来るように。"
msgstr "\"I'll be in the faculty room. Stop by when you're finished."

#. Occurrence 1_2:5132:447: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0038; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:5132
msgctxt "text_id=447 | speaker=yamashiro"
msgid "　いいかい蒼崎くん、くれぐれも、くれぐれもだぜ？"
msgstr "  You'll be alright, won't you, Aozaki?"

#. Occurrence 1_2:5145:448: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_2_0039; voice_prefix=B60; voice_category=7; scene=1_2
#: 1_2:5145
msgctxt "text_id=448 | speaker=yamashiro"
msgid "　なんていうか、生徒会長としての度量の広さを、このさい僕に信じさせてほしいかな！」"
msgstr "  You're the student council president! Don't let me down!\""

#. Occurrence 1_2:5216:449: scene=1_2
#: 1_2:5216
msgctxt "text_id=449 | speaker=unknown"
msgid "　見つめあう……正確に言うと、一方は睨まれている…ふたりをそれきりにして、山城教諭は去っていった。"
msgstr "  Mr. Yamasiro left, leaving the two in a locked-eyed state, one in which one set of eyes was doing all the glaring."

#. Occurrence 1_2:5222:450: scene=1_2
#: 1_2:5222
msgctxt "text_id=450 | speaker=unknown"
msgid "　残されたのは<木訥|ぼくとつ>さの化身みたいな少年と、"
msgstr "  All that remained in the room was an artless boy"

#. Occurrence 1_2:5227:451: scene=1_2
#: 1_2:5227
msgctxt "text_id=451 | speaker=unknown"
msgid "　ずーんと腕組みをしている少女だけ。"
msgstr "  and a cross-armed, guarded girl."

#. Occurrence 1_2:5283:452: scene=1_2
#: 1_2:5283
msgctxt "text_id=452 | speaker=unknown"
msgid "　しばしの沈黙。"
msgstr "  The two lingered in silence."

#. Occurrence 1_2:5288:453: scene=1_2
#: 1_2:5288
msgctxt "text_id=453 | speaker=unknown"
msgid "　お互い初手に悩んでいる将棋指しのようだが、その実、思案しているのは自分だけである事に青子は気付いた。"
msgstr "  They resembled shogi players agonizing over their first moves, though it was only Aoko who was reading so much into the situation."

#. Occurrence 1_2:5308:454: scene=1_2
#: 1_2:5308
msgctxt "text_id=454 | speaker=unknown"
msgid "　とりあえず、<苛々|イライラ>するのは置いておいて。"
msgstr "  She decided to put her irritation aside for the time being."

#. Occurrence 1_2:5322:455: scene=1_2
#: 1_2:5322
msgctxt "text_id=455 | speaker=unknown"
msgid "　そもそも彼に反感を覚える理由はないんだから、と大きくため息をついて、青子は草十郎に向き直った。"
msgstr "  With no reason to feel revulsion for him in the first place, she sighed deeply and faced Soujyuro."

#. Occurrence 1_2:5360:456: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0033; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:5360
msgctxt "text_id=456 | speaker=aoko"
msgid "「まあいいわ。山城先生が<昼行灯|ひるあんどん>なのは今に始まった事じゃないし。"
msgstr "\"Whatever. It's not like this is the first time that Mr. Yamasiro landed me in it."

#. Occurrence 1_2:5367:457: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0034; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:5367
msgctxt "text_id=457 | speaker=aoko"
msgid "―――それで。あなた、名前は？」"
msgstr "So... what's your name again?\""

#. Occurrence 1_2:5379:458: scene=1_2
#: 1_2:5379
msgctxt "text_id=458 | speaker=unknown"
msgid "　きつい口調は、自分から話しかけてこない少年を非難してのものだ。"
msgstr "  Her tone was nothing if not reproachful, though he had done nothing to offend her."

#. Occurrence 1_2:5385:459: scene=1_2
#: 1_2:5385
msgctxt "text_id=459 | speaker=unknown"
msgid "が、少年は声に含まれた嫌味に気が付かなかった。"
msgstr "But the boy failed to pick up on it."

#. Occurrence 1_2:5426:460: scene=1_2
#: 1_2:5426
msgctxt "text_id=460 | speaker=unknown"
msgid "　そういう毒っ気とは一生<縁|えん>のない顔で、"
msgstr "  Incapable of such venom himself,"

#. Occurrence 1_2:5440:461: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0006; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:5440
msgctxt "text_id=461 | speaker=soujuurou"
msgid "「ああ、静希草十郎かな。君は蒼崎さんだったね」"
msgstr "\"I'm Soujyuro Sizuki,\" he replied. \"And you're... Miss Aozaki, right?\""

#. Occurrence 1_2:5446:462: scene=1_2
#: 1_2:5446
msgctxt "text_id=462 | speaker=unknown"
msgid "　なぜか嬉しげに、噛みしめるように応答した。"
msgstr "  For whatever reason, he came across as happy in his response."

#. Occurrence 1_2:5493:463: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0035; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:5493
msgctxt "text_id=463 | speaker=aoko"
msgid "「さんはいいわ、<柄|ガラ>じゃないから。"
msgstr "\"Drop the 'Miss.' That's not my style."

#. Occurrence 1_2:5499:464: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0036; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:5499
msgctxt "text_id=464 | speaker=aoko"
msgid "　こっちは静希君でいい？」"
msgstr "  Is Sizuki fine?\""

#. Occurrence 1_2:5505:465: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0007; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:5505
msgctxt "text_id=465 | speaker=soujuurou"
msgid "「いいって、なにが？」"
msgstr "\"What do you mean?\""

#. Occurrence 1_2:5516:466: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0037; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:5516
msgctxt "text_id=466 | speaker=aoko"
msgid "「だから呼び方。<君|くん>付けでいいかって訊いてるの」"
msgstr "\"What do you mean, what do I mean?\""

#. Occurrence 1_2:5553:467: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0008; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:5553
msgctxt "text_id=467 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 1_2:5575:468: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0038; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:5575
msgctxt "text_id=468 | speaker=aoko"
msgid "「……なによ。おかしなコト言った、私？」"
msgstr "\"Hello? Did I say something weird?\""

#. Occurrence 1_2:5588:469: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0009; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:5588
msgctxt "text_id=469 | speaker=soujuurou"
msgid "「いや、すごく」"
msgstr "\"Yeah, very-\""

#. Occurrence 1_2:5593:470: scene=1_2
#: 1_2:5593
msgctxt "text_id=470 | speaker=unknown"
msgid "　少年は当たり前のように即答しながら、あれ、そうでもないのか、などとひとりこぼす。"
msgstr "  The boy replied immediately as if it was a natural response, but quickly second guessed himself."

#. Occurrence 1_2:5621:471: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0010; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:5621
msgctxt "text_id=471 | speaker=soujuurou"
msgid "「いや、いいんだ、ごく一般的なんだろう。"
msgstr "\"Uh, never mind. That must be normal here."

#. Occurrence 1_2:5633:472: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0011; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:5633
msgctxt "text_id=472 | speaker=soujuurou"
msgid "　静希君で頼む。君は蒼崎でいいんだよな？」"
msgstr "  You can call me Sizuki. You mind if I call you Aozaki?\""

#. Occurrence 1_2:5658:473: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0039; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:5658
msgctxt "text_id=473 | speaker=aoko"
msgid "「ええ、よろしく」"
msgstr "\"Suit yourself.\""

#. Occurrence 1_2:5669:474: scene=1_2
#: 1_2:5669
msgctxt "text_id=474 | speaker=unknown"
msgid "　素っ気なく応えて<踵|きびす>を返す青子。"
msgstr "  She followed her blunt reply with a swift turn away from him."

#. Occurrence 1_2:5674:475: scene=1_2
#: 1_2:5674
msgctxt "text_id=475 | speaker=unknown"
msgid "　気は乗らないが、任されたからにはきちんと仕事をこなすのが彼女のポリシーである。"
msgstr "  While she was hardly thrilled at the prospect of the task at hand, it had been entrusted to her, and it was her personal policy to see it through to the end."

#. Occurrence 1_2:5707:476: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0040; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:5707
msgctxt "text_id=476 | speaker=aoko"
msgid "「悪いけど、優しくしてあげる気はないから。"
msgstr "\"Sorry, but I'm not in the mood for pleasantries."

#. Occurrence 1_2:5713:477: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0041; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:5713
msgctxt "text_id=477 | speaker=aoko"
msgid "　時間も惜しいし、手早くいくわよ」"
msgstr "  Time is short, so let's get this over with.\""

#. Occurrence 1_2:5733:478: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0012; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:5733
msgctxt "text_id=478 | speaker=soujuurou"
msgid "「それは助かる。やっぱり時間は大切だ」"
msgstr "\"Sure. I know your time is valuable.\""

#. Occurrence 1_2:5739:479: scene=1_2
#: 1_2:5739
msgctxt "text_id=479 | speaker=unknown"
msgid "　青子の<直球|いやみ>は、またも効果なくスルーされた。"
msgstr "  Aoko's blunt rancor was lost on him once again."

#. Occurrence 1_2:5778:480: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0042; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:5778
msgctxt "text_id=480 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 1_2:5784:481: scene=1_2
#: 1_2:5784
msgctxt "text_id=481 | speaker=unknown"
msgid "　どんな行為にしろ、無視をされると余計意識してしまうのが人間である。"
msgstr "  Humans tend to be overly conscious about being ignored, whatever form that takes."

#. Occurrence 1_2:5789:482: scene=1_2
#: 1_2:5789
msgctxt "text_id=482 | speaker=unknown"
msgid "　さっきからことごとく攻撃が<空|から>ぶっている事にムッとしながらも、青子は<努|つと>めて事務的に廊下に出るよう<促|うなが>した。"
msgstr "  But despite being peeved at landing none of her attacks, Aoko did her best to act professional and directed her guest into the hallway."

#. Occurrence 1_2:5839:483: scene=1_2
#: 1_2:5839
msgctxt "text_id=483 | speaker=unknown"
msgid "　窓のない通路には外からの日差しも、人の気配もない。"
msgstr "  There was no sunlight in the hallway, nor any sign of life."

#. Occurrence 1_2:5844:484: scene=1_2
#: 1_2:5844
msgctxt "text_id=484 | speaker=unknown"
msgid "　会議室が天然の岩屋なら、こちらは人工の監獄を思わせる。"
msgstr "  This was more like a prison than the cave that was the meeting room."

#. Occurrence 1_2:5849:485: scene=1_2
#: 1_2:5849
msgctxt "text_id=485 | speaker=unknown"
msgid "　実に今の気分にあった廊下だわ、と青子はまたもため息ひとつ。"
msgstr "  As it dawned on Aoko that the hallway matched her mood, she sighed once again."

#. Occurrence 1_2:5889:486: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0043; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:5889
msgctxt "text_id=486 | speaker=aoko"
msgid "「まず訊いておくけど、山城先生から聞いた事は理解してる？」"
msgstr "\"First things first. Did you understand everything Mr. Yamasiro explained to you?\""

#. Occurrence 1_2:5913:487: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0013; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:5913
msgctxt "text_id=487 | speaker=soujuurou"
msgid "「ああ、学校の仕組みについては分かった。"
msgstr "\"Yes, I get how the school works."

#. Occurrence 1_2:5919:488: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0014; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:5919
msgctxt "text_id=488 | speaker=soujuurou"
msgid "　この建物ぜんぶに<同|おな>い<年|どし>の人間がいるなんて、ちょっと想像できないけど」"
msgstr "  But it's still a bit hard to imagine that everyone here is around the same age.\""

#. Occurrence 1_2:5953:489: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0044; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:5953
msgctxt "text_id=489 | speaker=aoko"
msgid "「……そ、良かったわね」"
msgstr "\"...I see. Great.\""

#. Occurrence 1_2:5959:490: scene=1_2
#: 1_2:5959
msgctxt "text_id=490 | speaker=unknown"
msgid "　額を指で押さえる青子。"
msgstr "  Aoko rubbed her forehead."

#. Occurrence 1_2:5964:491: scene=1_2
#: 1_2:5964
msgctxt "text_id=491 | speaker=unknown"
msgid "　この草十郎という少年は学校のなんたるかも知らなかった。"
msgstr "  This Soujyuro kid had no idea what he was in for."

#. Occurrence 1_2:5970:492: scene=1_2
#: 1_2:5970
msgctxt "text_id=492 | speaker=unknown"
msgid "ただ漠然と、大勢の人々で学習する場所、としか聞いていなかったらしい。"
msgstr "Apparently, all he'd heard about school was that it was a place where a lot of people met to study."

#. Occurrence 1_2:5999:493: scene=1_2
#: 1_2:5999
msgctxt "text_id=493 | speaker=unknown"
msgid "　高校教師は様々な分野の知識や見識、<機構|きこう>と創造性を生徒に教授する。"
msgstr "  High school teachers imparted to students their knowledge in various fields of study, while fostering discipline and creativity."

#. Occurrence 1_2:6004:494: scene=1_2
#: 1_2:6004
msgctxt "text_id=494 | speaker=unknown"
msgid "　が、そもそも学校とは何か、と根本の理念を語る日がこようとは、夢にも思わなかっただろう。"
msgstr "  But never did Aoko imagine that she would have to explain the concept of school itself to someone."

#. Occurrence 1_2:6009:495: scene=1_2
#: 1_2:6009
msgctxt "text_id=495 | speaker=unknown"
msgid "　基本は大事というが、それにしても基本すぎる。"
msgstr "  Yes, fundamentals were important. But this was absurd."

#. Occurrence 1_2:6014:496: scene=1_2
#: 1_2:6014
msgctxt "text_id=496 | speaker=unknown"
msgid "　……そんなんで高等学校の授業についてこられるのかと青子は疑問を抱いたが、山城教諭曰く、そこは何とかなっていたとのこと。"
msgstr "  She had serious doubts whether he could even handle classes, but Mr. Yamasiro insisted that things would work out somehow."

#. Occurrence 1_2:6019:497: scene=1_2
#: 1_2:6019
msgctxt "text_id=497 | speaker=unknown"
msgid "　一応、転入試験はギリギリでパスしたらしい。"
msgstr "  Soujyuro had managed to pass the transfer exam, after all. Barely."

#. Occurrence 1_2:6059:498: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0045; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:6059
msgctxt "text_id=498 | speaker=aoko"
msgid "『……ま、私には関係ないけど』"
msgstr "(Not my problem.)"

#. Occurrence 1_2:6065:499: scene=1_2
#: 1_2:6065
msgctxt "text_id=499 | speaker=unknown"
msgid "　内心で呟きながら廊下を歩く青子。"
msgstr "  Aoko grumbled mentally as she walked down the hallway."

#. Occurrence 1_2:6070:500: scene=1_2
#: 1_2:6070
msgctxt "text_id=500 | speaker=unknown"
msgid "　なんであれ、この<時代錯誤|じだいさくご>な男子と付き合うのは今日だけなのだ、いや、今日だけにしたい、と自分に言い聞かせながら。"
msgstr "  She consoled herself with the fact that today would be the only day she'd spend with this boy out of time... or at least, she'd try to keep it that way."

#. Occurrence 1_2:6104:501: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0015; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:6104
msgctxt "text_id=501 | speaker=soujuurou"
msgid "「蒼崎」"
msgstr "\"Aozaki?\""

#. Occurrence 1_2:6110:502: scene=1_2
#: 1_2:6110
msgctxt "text_id=502 | speaker=unknown"
msgid "　そんな青子に、少年は平然と話しかけた。"
msgstr "  He asked, calmly trying to get her attention."

#. Occurrence 1_2:6131:503: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0046; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:6131
msgctxt "text_id=503 | speaker=aoko"
msgid "「なに？」"
msgstr "\"What?\""

#. Occurrence 1_2:6137:504: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0016; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:6137
msgctxt "text_id=504 | speaker=soujuurou"
msgid "「こっちもひとつ訊いていいかな」"
msgstr "\"Can I ask you something?\""

#. Occurrence 1_2:6159:505: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0047; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:6159
msgctxt "text_id=505 | speaker=aoko"
msgid "「だから、なに？」"
msgstr "\"Yes. What is it?\""

#. Occurrence 1_2:6187:506: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0017; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:6187
msgctxt "text_id=506 | speaker=soujuurou"
msgid "「俺の気のせいだと思うんだが、君はまるで、何かを睨んでいるように見える。"
msgstr "\"I could be wrong about this, but you seem upset about something."

#. Occurrence 1_2:6193:507: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0018; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:6193
msgctxt "text_id=507 | speaker=soujuurou"
msgid "　やはり、今朝は悪いものでも？」"
msgstr "  You're not a morning person, are you?\""

#. Occurrence 1_2:6199:508: scene=1_2
#: 1_2:6199
msgctxt "text_id=508 | speaker=unknown"
msgid "　食べたのかい？　と本気で心配する眼差し。"
msgstr "  His gaze revealed earnest concern, as if asking her if she'd remembered to eat breakfast."

#. Occurrence 1_2:6228:509: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0048; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:6228
msgctxt "text_id=509 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 1_2:6248:510: scene=1_2
#: 1_2:6248
msgctxt "text_id=510 | speaker=unknown"
msgid "　ガン、と二度目のハンマーが青子の頭を叩いた。"
msgstr "  It was like another hammer to her head."

#. Occurrence 1_2:6280:511: scene=1_2
#: 1_2:6280
msgctxt "text_id=511 | speaker=unknown"
msgid "　たしかに青子はさっきから草十郎を睨んでいる。"
msgstr "  It was true that Aoko had been glaring at Soujyuro the entire time."

#. Occurrence 1_2:6285:512: scene=1_2
#: 1_2:6285
msgctxt "text_id=512 | speaker=unknown"
msgid "　というかもう本気で睨んでいる。"
msgstr "  Glaring red-hot daggers, in fact."

#. Occurrence 1_2:6290:513: scene=1_2
#: 1_2:6290
msgctxt "text_id=513 | speaker=unknown"
msgid "　むしろあらゆるものを睨んでいる。"
msgstr "  Not just at him, but the universe."

#. Occurrence 1_2:6310:514: scene=1_2
#: 1_2:6310
msgctxt "text_id=514 | speaker=unknown"
msgid "　平時でさえ同居人から、"
msgstr "  Even on her best days, her roommate used to remark,"

#. Occurrence 1_2:6346:515: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_2_0000; voice_prefix=A40; voice_category=2; scene=1_2
#: 1_2:6346
msgctxt "text_id=515 | speaker=alice"
msgid "『青子の視線は普通の人には厳しいわ。"
msgstr "\"Most people can't handle your scowl, Aoko."

#. Occurrence 1_2:6352:516: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_2_0001; voice_prefix=A40; voice_category=2; scene=1_2
#: 1_2:6352
msgctxt "text_id=516 | speaker=alice"
msgid "　もう少し、多くのことに寛大になるべきね』"
msgstr "  It wouldn't hurt you to be a little more tolerant.\""

#. Occurrence 1_2:6358:517: scene=1_2
#: 1_2:6358
msgctxt "text_id=517 | speaker=unknown"
msgid "　と<諭|さと>されるぐらいの視線が、明確に“これ以上負荷がかかったらキレる”と意思表示しまくっているのだ。それを気のせいと感じられるほど、この少年は鈍感なのだろうか？"
msgstr "  She'd been warned that her emotions were so naked on her face that people treated her like a powder keg. How naive could the boy be that he could not pick up on this?"

#. Occurrence 1_2:6418:518: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0049; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:6418
msgctxt "text_id=518 | speaker=aoko"
msgid "『……私を馬鹿にしてる……って訳じゃなさそうよね、この場合』"
msgstr "(He's not making fun of me, is he? No... he couldn't be.)"

#. Occurrence 1_2:6434:519: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0019; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:6434
msgctxt "text_id=519 | speaker=soujuurou"
msgid "「？」"
msgstr "\"Hm?\""

#. Occurrence 1_2:6439:520: scene=1_2
#: 1_2:6439
msgctxt "text_id=520 | speaker=unknown"
msgid "　自分にそう言い聞かせてみたが、あまり確証は取れそうになかった。"
msgstr "  Even she found her own attempt to reassure herself unconvincing."

#. Occurrence 1_2:6475:521: scene=1_2
#: 1_2:6475
msgctxt "text_id=521 | speaker=unknown"
msgid "　青子は今さらながら直感する。"
msgstr "  It began to dawn on Aoko, far too late..."

#. Occurrence 1_2:6480:522: scene=1_2
#: 1_2:6480
msgctxt "text_id=522 | speaker=unknown"
msgid "　この間の抜けた転入生は、自分にとって未知の生き物と同義なのではないだろうか、と。"
msgstr "  ...that compared to her, this laid-back transfer student might as well have been from another planet."

#. Occurrence 1_2:6518:523: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0050; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:6518
msgctxt "text_id=523 | speaker=aoko"
msgid "「……いいわ。言葉にしないと分からないようだから言うけど、まるで、じゃなくて、ずばりそうなの。"
msgstr "\"Look. Let me spell it out for you, because you're just not getting it."

#. Occurrence 1_2:6524:524: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0051; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:6524
msgctxt "text_id=524 | speaker=aoko"
msgid "　貴方の気のせいじゃなくて、私は視線で遠回しに感情を表現してたの。いちいち声にだすのも、会話にするのも面倒だから」"
msgstr "  It's not your imagination. I am angry and anyone could see that in my eyes. It's easier than trying to make conversation.\""

#. Occurrence 1_2:6530:525: scene=1_2
#: 1_2:6530
msgctxt "text_id=525 | speaker=unknown"
msgid "　青子の言葉に、ポン、と両手を叩くインベーダー。"
msgstr "  In response to her words, the Martian clapped his hands together."

#. Occurrence 1_2:6570:526: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0020; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:6570
msgctxt "text_id=526 | speaker=soujuurou"
msgid "「なるほど。どうしてそうしたいのかは分からないが、たしかに、そっちの方がてっとり早い意思表現だ」"
msgstr "\"That makes sense. I don't know why you'd want to do it that way, but I get that it's a faster way to express yourself.\""

#. Occurrence 1_2:6590:527: scene=1_2
#: 1_2:6590
msgctxt "text_id=527 | speaker=unknown"
msgid "　素直に納得する草十郎。"
msgstr "  Soujyuro accepted her reasoning without argument."

#. Occurrence 1_2:6595:528: scene=1_2
#: 1_2:6595
msgctxt "text_id=528 | speaker=unknown"
msgid "　けれど、彼は青子がどんな感情を表現しているのかが分かっていない。"
msgstr "  Though he still had no idea what kinds of emotions she was trying to express."

#. Occurrence 1_2:6600:529: scene=1_2
#: 1_2:6600
msgctxt "text_id=529 | speaker=unknown"
msgid "　文字は読めるけれど、その意味までは掴めていない。"
msgstr "  It was as if he could hear the words but didn't grasp the meaning."

#. Occurrence 1_2:6605:530: scene=1_2
#: 1_2:6605
msgctxt "text_id=530 | speaker=unknown"
msgid "　本来直結して考えるべき事が、ブロック単位で離れている感じ。"
msgstr "  Ideas that should have connected were instead separated into blocks."

#. Occurrence 1_2:6647:531: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0052; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:6647
msgctxt "text_id=531 | speaker=aoko"
msgid "『……たしかにズレてるわ、こいつ……』"
msgstr "(So it's true. He really is peculiar.)"

#. Occurrence 1_2:6653:532: scene=1_2
#: 1_2:6653
msgctxt "text_id=532 | speaker=unknown"
msgid "　青子は山城教諭の言葉を今更ながらに納得した。"
msgstr "  Mr. Yamasiro's words made sense to her now."

#. Occurrence 1_2:6658:533: scene=1_2
#: 1_2:6658
msgctxt "text_id=533 | speaker=unknown"
msgid "　この少年のおかしさは、鈍感だとかそういった基準の話ではないらしい。"
msgstr "  What was odd about this boy went way beyond naivety."

#. Occurrence 1_2:6663:534: scene=1_2
#: 1_2:6663
msgctxt "text_id=534 | speaker=unknown"
msgid "　……それでも。彼にとってここは異国の地のようなもの、多少の時差ボケは許容するのが文明人というものだろう。"
msgstr "  A stranger in a strange land he may be, but it was only civilized to forgive him some jet lag-induced confusion."

#. Occurrence 1_2:6696:535: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0053; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:6696
msgctxt "text_id=535 | speaker=aoko"
msgid "「じゃ、とりあえず貴方の教室に行くから」"
msgstr "\"Let's visit your classroom.\""

#. Occurrence 1_2:6702:536: scene=1_2
#: 1_2:6702
msgctxt "text_id=536 | speaker=unknown"
msgid "　気を取り直して青子は言う。"
msgstr "  She had regained her composure."

#. Occurrence 1_2:6707:537: scene=1_2
#: 1_2:6707
msgctxt "text_id=537 | speaker=unknown"
msgid "　それを草十郎は片手を上げて止めた。"
msgstr "  Soujyuro raised his hand and stopped in his tracks."

#. Occurrence 1_2:6741:538: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0021; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:6741
msgctxt "text_id=538 | speaker=soujuurou"
msgid "「ああ、あとひとつ」"
msgstr "\"Just one more thing.\""

#. Occurrence 1_2:6769:539: scene=1_2
#: 1_2:6769
msgctxt "text_id=539 | speaker=unknown"
msgid "　あくまで泰然と言う草十郎に、青子は黙って先を<促|うなが>した。"
msgstr "  Aoko waited for Soujyuro to continue. The boy was patient to a fault."

#. Occurrence 1_2:6774:540: scene=1_2
#: 1_2:6774
msgctxt "text_id=540 | speaker=unknown"
msgid "　額を指で押さえたまま、漠然とした不安を感じたまま。"
msgstr "  She rubbed her forehead with her hand again, nursing a vague feeling of uneasiness."

#. Occurrence 1_2:6816:541: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0022; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:6816
msgctxt "text_id=541 | speaker=soujuurou"
msgid "「これもちょっとした疑問なんだが、なんで君は怒ってるんだ？"
msgstr "\"I wanted to ask-why are you so angry?"

#. Occurrence 1_2:6823:542: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_2_0023; voice_prefix=A30; voice_category=3; scene=1_2
#: 1_2:6823
msgctxt "text_id=542 | speaker=soujuurou"
msgid "　怒るのが商売とか、そういう家柄の人なのか？」"
msgstr "  Is it your line of business? Or does it run in your family?\""

#. Occurrence 1_2:6851:543: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0054; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:6851
msgctxt "text_id=543 | speaker=aoko"
msgid "「―――――――――」"
msgstr "\"...\""

#. Occurrence 1_2:6886:544: scene=1_2
#: 1_2:6886
msgctxt "text_id=544 | speaker=unknown"
msgid "　長い沈黙。"
msgstr "  A long silence."

#. Occurrence 1_2:6891:545: scene=1_2
#: 1_2:6891
msgctxt "text_id=545 | speaker=unknown"
msgid "　今となっては後の祭りだが、青子はしばし、今朝の電話を取った事を痛烈に後悔した。"
msgstr "  Though she knew it wouldn't change the situation, she remembered her regret at answering the phone that morning."

#. Occurrence 1_2:6896:546: scene=1_2
#: 1_2:6896
msgctxt "text_id=546 | speaker=unknown"
msgid "　相手に悪気はない。"
msgstr "  He meant no harm."

#. Occurrence 1_2:6901:547: scene=1_2
#: 1_2:6901
msgctxt "text_id=547 | speaker=unknown"
msgid "　これは天然、ただの天然、と心の中で繰り返し、青子は直情を抑えこんだ。"
msgstr "  She repeated this thought like a mantra in an attempt to keep her impulses in check."

#. Occurrence 1_2:6954:548: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0055; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:6954
msgctxt "text_id=548 | speaker=aoko"
msgid "「別にあなたのせいじゃないから、気にする必要はないわ。"
msgstr "\"It's not you, if that's what you're worried about."

#. Occurrence 1_2:6960:549: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_2_0056; voice_prefix=A10; voice_category=1; scene=1_2
#: 1_2:6960
msgctxt "text_id=549 | speaker=aoko"
msgid "　ただ、この一瞬とお昼まで眠っていた場合を<秤|はかり>にかけたらあまりに利益の違いがあって、頭を抱えただけよ」"
msgstr "  I'm just trying not to think how much better my day would've gone if I'd slept in until noon.\""

#. Occurrence 1_2:6966:550: scene=1_2
#: 1_2:6966
msgctxt "text_id=550 | speaker=unknown"
msgid "　回りくどい返事をして、今度こそ青子は歩きだした。"
msgstr "  With that vague answer, she started to walk again."

#. Occurrence 1_2:6971:551: scene=1_2
#: 1_2:6971
msgctxt "text_id=551 | speaker=unknown"
msgid "　静希草十郎という失礼なストレンジャーを、完全に視界から切り離して。"
msgstr "  And turned her gaze away from this rude stranger named Soujyuro Sizuki."

#. Occurrence 1_3:41:552: scene=1_3
#: 1_3:41
msgctxt "text_id=552 | speaker=unknown"
msgid "　何を基準にして普通というのか疑問だけれど、性格はいたって<普通|ノーマル>。素朴でいい人。イメージカラーはあえて白。性別は男子。容姿はぼんやりしている。"
msgstr "  While what constitutes 'normal' is certainly up for debate, most would undoubtedly refer to him as so. He was a simple and nice boy with nondescript features. If he were an ice cream flavor, he would be vanilla."

#. Occurrence 1_3:70:553: scene=1_3
#: 1_3:70
msgctxt "text_id=553 | speaker=unknown"
msgid "　そんな草十郎から見ると、蒼崎青子という人物はシャキシャキとよく動いて元気が良かった。"
msgstr "  And Soujyuro found Aoko to be very businesslike and full of life."

#. Occurrence 1_3:75:554: scene=1_3
#: 1_3:75
msgctxt "text_id=554 | speaker=unknown"
msgid "　何げない動作にも無駄がなく、ピッと動いて、ピタリときれいに止まる。"
msgstr "  There was a certain purpose to her movements, as they began and ended in an orderly fashion."

#. Occurrence 1_3:95:555: scene=1_3
#: 1_3:95
msgctxt "text_id=555 | speaker=unknown"
msgid "　物を指す時に上げる指とか、"
msgstr "  The way her finger raised when she pointed at things..."

#. Occurrence 1_3:104:556: scene=1_3
#: 1_3:104
msgctxt "text_id=556 | speaker=unknown"
msgid "　廊下や教室を横断する時の動作とか、"
msgstr "  The way she made her way across the hallways and classrooms..."

#. Occurrence 1_3:113:557: scene=1_3
#: 1_3:113
msgctxt "text_id=557 | speaker=unknown"
msgid "　時折、先行しすぎないように後ろを振り向いて同行人を確認するところとか、"
msgstr "  The way she would occasionally glance back at him to make sure he was keeping pace..."

#. Occurrence 1_3:118:558: scene=1_3
#: 1_3:118
msgctxt "text_id=558 | speaker=unknown"
msgid "　その一挙一動が実に印象的で、目を引かずにはいられない。"
msgstr "  Each and every movement was so impressive that he couldn't take his eyes off her."

#. Occurrence 1_3:173:559: scene=1_3
#: 1_3:173
msgctxt "text_id=559 | speaker=unknown"
msgid "　青子はまず二年Ｃ組の教室を案内した。"
msgstr "  Aoko showed him to his homeroom-Class C of the 11th grade."

#. Occurrence 1_3:180:560: scene=1_3
#: 1_3:180
msgctxt "text_id=560 | speaker=unknown"
msgid "　先ほどの会議室よりは人の匂いは感じられたが、やはり草十郎には何をする場所なのか見当がつかなかった。"
msgstr "  The room certainly displayed more of a human touch than the previous meeting room, but Soujyuro was none the wiser as to its function."

#. Occurrence 1_3:185:561: scene=1_3
#: 1_3:185
msgctxt "text_id=561 | speaker=unknown"
msgid "　青子から短い説明を受けた後、何種類かある特別教室、体育館、食堂、更衣室、保健室と回っていく。"
msgstr "  Aoko gave a brief explanation before they visited individual subject classrooms, as well as the gym, cafeteria, locker room, and school infirmary."

#. Occurrence 1_3:190:562: scene=1_3
#: 1_3:190
msgctxt "text_id=562 | speaker=unknown"
msgid "　草十郎が行く先々で説明を求めたせいか、二階の視聴覚室を出た頃にはずいぶんと時間が経っていた。"
msgstr "  Soujyuro asked so many questions that much time passed before they reached the AV room on the second floor."

#. Occurrence 1_3:225:563: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0000; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:225
msgctxt "text_id=563 | speaker=soujuurou"
msgid "「……まずいな」"
msgstr "\"...Oh dear.\""

#. Occurrence 1_3:260:564: scene=1_3
#: 1_3:260
msgctxt "text_id=564 | speaker=unknown"
msgid "　深刻な顔で、草十郎は足を止めた。"
msgstr "  Soujyuro stopped, looking genuinely concerned."

#. Occurrence 1_3:267:565: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0001; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:267
msgctxt "text_id=565 | speaker=soujuurou"
msgid "「あと二十分経つと<一時|いちじ>だ」"
msgstr "\"It's twenty to one already.\""

#. Occurrence 1_3:300:566: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0000; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:300
msgctxt "text_id=566 | speaker=aoko"
msgid "「へ？　嘘でしょ、うちの校舎そんな広くないわよ？」"
msgstr "\"Huh? You're kidding, right? This school isn't that big. We'll be done soon.\""

#. Occurrence 1_3:306:567: scene=1_3
#: 1_3:306
msgctxt "text_id=567 | speaker=unknown"
msgid "　たしか案内を始めたのが午前十時前だから、一時という事はかれこれ三時間は経つ事になる。"
msgstr "  The tour had begun around ten, which meant that three hours had passed."

#. Occurrence 1_3:318:568: scene=1_3
#: 1_3:318
msgctxt "text_id=568 | speaker=unknown"
msgid "　たかだか校内案内でそんな筈はないのだが……"
msgstr "  A tour of a school shouldn't take anywhere near this long."

#. Occurrence 1_3:377:569: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0001; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:377
msgctxt "text_id=569 | speaker=aoko"
msgid "「……そうだったわね。行く先々で根ほり葉ほり訊かれちゃ、そりゃあ何時間でも経つわ。日が暮れていないのが不思議なくらいね」"
msgstr "\"Maybe if you didn't ask so many questions, we'd be done by now. It's a miracle it's still light out.\""

#. Occurrence 1_3:391:570: scene=1_3
#: 1_3:391
msgctxt "text_id=570 | speaker=unknown"
msgid "　青子はじろりと草十郎を見すえる。"
msgstr "  Aoko glared at Soujyuro."

#. Occurrence 1_3:396:571: scene=1_3
#: 1_3:396
msgctxt "text_id=571 | speaker=unknown"
msgid "　こんな嫌味が通じる相手じゃない、と分かった上での小言である。"
msgstr "  She was being sarcastic, of course, knowing full well he would never pick up on it."

#. Occurrence 1_3:436:572: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0002; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:436
msgctxt "text_id=572 | speaker=aoko"
msgid "『………え？』"
msgstr "(...Is he...?)"

#. Occurrence 1_3:442:573: scene=1_3
#: 1_3:442
msgctxt "text_id=573 | speaker=unknown"
msgid "　が。"
msgstr "  To her surprise..."

#. Occurrence 1_3:448:574: scene=1_3
#: 1_3:448
msgctxt "text_id=574 | speaker=unknown"
msgid "どんな心境の変化か、草十郎は申し訳なさそうに目を伏せていた。"
msgstr "He looked down apologetically, unable to hide his dejection."

#. Occurrence 1_3:488:575: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0003; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:488
msgctxt "text_id=575 | speaker=aoko"
msgid "『なんだ、コイツ―――ちゃんとしてる、じゃん』"
msgstr "(Oops. I think I broke him.)"

#. Occurrence 1_3:494:576: scene=1_3
#: 1_3:494
msgctxt "text_id=576 | speaker=unknown"
msgid "　困っている草十郎は別人のようだ。"
msgstr "  The guy before her now was nothing like earlier."

#. Occurrence 1_3:499:577: scene=1_3
#: 1_3:499
msgctxt "text_id=577 | speaker=unknown"
msgid "　これまでの、青子が何を言っても反応せずの無表情と違って、言い難い親近感が湧く。"
msgstr "  In contrast to seeing his once-impenetrable veneer when they first met, she found herself feeling sympathetic."

#. Occurrence 1_3:521:578: scene=1_3
#: 1_3:521
msgctxt "text_id=578 | speaker=unknown"
msgid "　そして、なぜだかやっぱり、青子は理由もなくイライラしてしまうのだった。"
msgstr "  Momentarily, at least, until her irritation returned in full force."

#. Occurrence 1_3:573:579: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0004; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:573
msgctxt "text_id=579 | speaker=aoko"
msgid "「で、なにがまずいの？"
msgstr "\"What's the hurry?"

msgctxt "text_id=580 | speaker=unknown"
msgid "　覚える事が多すぎてパンクした、なんて言わないでね」"
msgstr "  Don't tell me your brain's not big enough to remember all this stuff.\""

#. Occurrence 1_3:586:581: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0002; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:586
msgctxt "text_id=581 | speaker=soujuurou"
msgid "「いや、それもあるけど。学校の事は別にして、一時になるとまずいんだ」"
msgstr "\"Well, there's that, but it's more about it almost being one o'clock.\""

#. Occurrence 1_3:598:582: scene=1_3
#: 1_3:598
msgctxt "text_id=582 | speaker=unknown"
msgid "　つい、と心配そうに視線を逸らす草十郎。"
msgstr "  Soujyuro's gaze wandered as if worried about something."

#. Occurrence 1_3:603:583: scene=1_3
#: 1_3:603
msgctxt "text_id=583 | speaker=unknown"
msgid "　外の様子が気になるのだろうが、あいにく、この廊下に窓はない。"
msgstr "  If he was worried about the weather, he would have a hard time seeing it as there were no windows in this hallway."

#. Occurrence 1_3:643:584: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0005; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:643
msgctxt "text_id=584 | speaker=aoko"
msgid "「……へえ。時間を気にするってコトは、用事があるのね。"
msgstr "\"Don't tell me―you've got somewhere better to be."

#. Occurrence 1_3:649:585: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0006; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:649
msgctxt "text_id=585 | speaker=aoko"
msgid "　ふーん、そう。人の予定を引っ掻き回しておいて、自分だけ好きなようにやろうっていうんだ。"
msgstr "  Thaaat's perfect. I take time out of my day for you, and you don't have the decency to even hang around."

#. Occurrence 1_3:674:586: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0007; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:674
msgctxt "text_id=586 | speaker=aoko"
msgid "　なんだ。顔に似合わずいい人ね、君」"
msgstr "  You're a real piece of work, you know that?\""

#. Occurrence 1_3:735:587: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0003; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:735
msgctxt "text_id=587 | speaker=soujuurou"
msgid "「？　いや、誉めても何もでないぞ」"
msgstr "\"Umm, thanks, I guess? That's nice of you to say.\""

#. Occurrence 1_3:754:588: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0008; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:754
msgctxt "text_id=588 | speaker=aoko"
msgid "「誰も誉めちゃいないわよ！」"
msgstr "\"Not a compliment!\""

#. Occurrence 1_3:760:589: scene=1_3
#: 1_3:760
msgctxt "text_id=589 | speaker=unknown"
msgid "　つい怒鳴ってしまった青子だった。"
msgstr "  She yelled at him, unable to hold back her fury."

#. Occurrence 1_3:796:590: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0009; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:796
msgctxt "text_id=590 | speaker=aoko"
msgid "「で？」"
msgstr "\"Well?\""

#. Occurrence 1_3:817:591: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0004; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:817
msgctxt "text_id=591 | speaker=soujuurou"
msgid "「で？」"
msgstr "\"Well what?\""

#. Occurrence 1_3:834:592: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0010; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:834
msgctxt "text_id=592 | speaker=aoko"
msgid "「それで。いったい、何の用なの」"
msgstr "\"What's happening in twenty minutes?\""

#. Occurrence 1_3:839:593: scene=1_3
#: 1_3:839
msgctxt "text_id=593 | speaker=unknown"
msgid "　青子の言わんとする事が分かって、草十郎はああ、と落ち着いた顔で頷き、"
msgstr "  Soujyuro's face lit up, as he finally understood what she was asking him."

#. Occurrence 1_3:845:594: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0005; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:845
msgctxt "text_id=594 | speaker=soujuurou"
msgid "「そこは秘密にしておきたい」"
msgstr "\"It's a secret.\""

#. Occurrence 1_3:872:595: scene=1_3
#: 1_3:872
msgctxt "text_id=595 | speaker=unknown"
msgid "　深刻に、ふざけた返答を口にした。"
msgstr "  He said with a perfectly straight face."

#. Occurrence 1_3:929:596: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0011; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:929
msgctxt "text_id=596 | speaker=aoko"
msgid "『……馴れ始めたつもりだったけど、コイツのこういったテンポには失神しそうになるわ……』"
msgstr "(Ugh. Every time I think I've got this guy figured out, he finds a way to trip me up.)"

#. Occurrence 1_3:935:597: scene=1_3
#: 1_3:935
msgctxt "text_id=597 | speaker=unknown"
msgid "　もちろん怒りで。"
msgstr "  Her frustration was natural."

#. Occurrence 1_3:941:598: scene=1_3
#: 1_3:941
msgctxt "text_id=598 | speaker=unknown"
msgid "そんな気持ちをぐっと飲みこんで、青子は極上の笑顔を作る。"
msgstr "Still, she did everything she could to stifle her feelings and fake a smile."

#. Occurrence 1_3:1000:599: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0012; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1000
msgctxt "text_id=599 | speaker=aoko"
msgid "「静希くん？」"
msgstr "\"You want to repeat that, Sizuki?\""

#. Occurrence 1_3:1005:600: scene=1_3
#: 1_3:1005
msgctxt "text_id=600 | speaker=unknown"
msgid "　ずいっと一歩前に出る青子。"
msgstr "  She took a step forward."

#. Occurrence 1_3:1035:601: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0006; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:1035
msgctxt "text_id=601 | speaker=soujuurou"
msgid "「秘密だってば」"
msgstr "\"Like I said, it's a secret.\""

#. Occurrence 1_3:1040:602: scene=1_3
#: 1_3:1040
msgctxt "text_id=602 | speaker=unknown"
msgid "　なんだか殺気めいたものを感じて、ずいっと一歩後ずさる草十郎。"
msgstr "  Feeling the mood change drastically, Soujyuro took a step back."

#. Occurrence 1_3:1070:603: scene=1_3
#: 1_3:1070
msgctxt "text_id=603 | speaker=unknown"
msgid "　ずいっ、ずいっ。"
msgstr "  And another... And another..."

#. Occurrence 1_3:1075:604: scene=1_3
#: 1_3:1075
msgctxt "text_id=604 | speaker=unknown"
msgid "　磁石のように、どんなにさがっても青子は近寄ってくる。"
msgstr "  No matter how many steps he took back, she kept edging toward him."

#. Occurrence 1_3:1080:605: scene=1_3
#: 1_3:1080
msgctxt "text_id=605 | speaker=unknown"
msgid "　笑顔のまま、こめかみをちょっと震わせて。"
msgstr "  She was smiling, but he thought he could see the blood boiling beneath her skin."

#. Occurrence 1_3:1123:606: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0013; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1123
msgctxt "text_id=606 | speaker=aoko"
msgid "「これ、最後の質問にしとくわね。"
msgstr "\"Last question:"

#. Occurrence 1_3:1129:607: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0014; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1129
msgctxt "text_id=607 | speaker=aoko"
msgid "　―――貴方、私をからかって楽しい？」"
msgstr "  Do you enjoy mocking me?\""

#. Occurrence 1_3:1135:608: scene=1_3
#: 1_3:1135
msgctxt "text_id=608 | speaker=unknown"
msgid "　神に誓ってそんな気はないのだが、身の潔白を証明したところで青子の無理やりな笑顔は消えないだろう。"
msgstr "  He had no intention of mocking her, though at this point he doubted presenting any evidence to prove this would do much to erase that forced smile on her face."

#. Occurrence 1_3:1141:609: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0007; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:1141
msgctxt "text_id=609 | speaker=soujuurou"
msgid "「……分かった、説明する」"
msgstr "\"...Let me explain.\""

#. Occurrence 1_3:1153:610: scene=1_3
#: 1_3:1153
msgctxt "text_id=610 | speaker=unknown"
msgid "　降参して手を上げる。"
msgstr "  His arms raised in surrender."

#. Occurrence 1_3:1158:611: scene=1_3
#: 1_3:1158
msgctxt "text_id=611 | speaker=unknown"
msgid "　青子も前進を止め、不似合いな笑みを消した。"
msgstr "  She halted her advance and freed her face from that unseemly smile."

#. Occurrence 1_3:1211:612: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0008; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:1211
msgctxt "text_id=612 | speaker=soujuurou"
msgid "「実は一時からアルバイトがあるんだ。"
msgstr "\"The truth is that my part-time job shift starts at one."

msgctxt "text_id=613 | speaker=unknown"
msgid "　でも、ここはそういうの禁止なんだろ？」"
msgstr "  But, students aren't allowed to have jobs, right?\""

#. Occurrence 1_3:1219:614: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0015; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1219
msgctxt "text_id=614 | speaker=aoko"
msgid "「そうだけど……あ、禁止されてるから秘密にしようと思ったの？　バカね、それなら許可さえ下りていれば問題ないわよ？」"
msgstr "\"Yeah... Wait, were you being tight-lipped because you thought you'd get in trouble? All you have to do is get permission, dweeb!\""

#. Occurrence 1_3:1240:615: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0009; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:1240
msgctxt "text_id=615 | speaker=soujuurou"
msgid "「知ってる。試験の時に許可はもらってる」"
msgstr "\"I know, and I did. I got permission when they accepted me to the school.\""

#. Occurrence 1_3:1253:616: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0016; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1253
msgctxt "text_id=616 | speaker=aoko"
msgid "「へえ」"
msgstr "\"Really.\""

#. Occurrence 1_3:1258:617: scene=1_3
#: 1_3:1258
msgctxt "text_id=617 | speaker=unknown"
msgid "　顔に似合わず手回しいいじゃない、と青子は顔を輝かせた。"
msgstr "  Aoko's face lit up as she realized he might not be the piece of work she thought him to be."

#. Occurrence 1_3:1263:618: scene=1_3
#: 1_3:1263
msgctxt "text_id=618 | speaker=unknown"
msgid "　が。"
msgstr "  Yet..."

#. Occurrence 1_3:1291:619: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0010; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:1291
msgctxt "text_id=619 | speaker=soujuurou"
msgid "「しかし、許可はひとつしかもらえなかった」"
msgstr "\"But I only got permission for one of my jobs.\""

#. Occurrence 1_3:1304:620: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0017; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1304
msgctxt "text_id=620 | speaker=aoko"
msgid "「？　ひとつって、貴方、掛け持ちでバイトしてるの？」"
msgstr "\"Wait, you have more than one job?\""

#. Occurrence 1_3:1317:621: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0011; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:1317
msgctxt "text_id=621 | speaker=soujuurou"
msgid "「……これでも二件減らしたんだ。"
msgstr "\"Well, I quit two of them..."

#. Occurrence 1_3:1323:622: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0012; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:1323
msgctxt "text_id=622 | speaker=soujuurou"
msgid "　生活費だけで大変なのに、学費まで稼がなくちゃいけない。なのに、働き先はひとつだけと言うのはあんまりだと思わないか？」"
msgstr "  Living expenses are bad enough, but now I have to earn money for school as well. Don't you think it's unreasonable of them to only let me work one job?\""

#. Occurrence 1_3:1351:623: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0018; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1351
msgctxt "text_id=623 | speaker=aoko"
msgid "「……いや。あんまりなのは貴方の方だと思うけど」"
msgstr "\"...No, I think you're the one who's being unreasonable.\""

#. Occurrence 1_3:1371:624: scene=1_3
#: 1_3:1371
msgctxt "text_id=624 | speaker=unknown"
msgid "　青子は呆れながらも、草十郎を少しだけ見直した。"
msgstr "  Though still irritated, her opinion of him changed a little."

#. Occurrence 1_3:1382:625: scene=1_3
#: 1_3:1382
msgctxt "text_id=625 | speaker=unknown"
msgid "　学費はおろか生活費まで自分でどうにかしているのは立派だと思う。"
msgstr "  She was impressed that he was able to take care of his tuition and living expenses all on his own."

#. Occurrence 1_3:1387:626: scene=1_3
#: 1_3:1387
msgctxt "text_id=626 | speaker=unknown"
msgid "　そういう遊びのない事情に、蒼崎青子はわりと弱かった。さっきまでの怒りも薄れてしまう程度には。"
msgstr "  She could also empathize with having no time to oneself. Her anger began to subside."

#. Occurrence 1_3:1392:627: scene=1_3
#: 1_3:1392
msgctxt "text_id=627 | speaker=unknown"
msgid "　……調子を崩したのは、この世間知らずの少年から『アルバイト』なんて単語が出るとは思いもしなかっただけだ。"
msgstr "  The words 'part-time job' were about the last things she ever expected to hear out of this country boy's mouth."

#. Occurrence 1_3:1419:628: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0019; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1419
msgctxt "text_id=628 | speaker=aoko"
msgid "「……そういうことなら仕方ないわね。"
msgstr "\"Well, you gotta do what you gotta do, I guess."

#. Occurrence 1_3:1425:629: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0020; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1425
msgctxt "text_id=629 | speaker=aoko"
msgid "　いいわ、行きなさいよ。事情は分かったから」"
msgstr "  It's fine. You can go. I get it.\""

#. Occurrence 1_3:1431:630: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0013; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:1431
msgctxt "text_id=630 | speaker=soujuurou"
msgid "「蒼崎はいいのか？」"
msgstr "\"Will you be okay?\""

#. Occurrence 1_3:1462:631: scene=1_3
#: 1_3:1462
msgctxt "text_id=631 | speaker=unknown"
msgid "　何がいいのだか青子にはさっぱりだが、草十郎が気を遣っている事だけは分かる。"
msgstr "  She had no idea what his question meant, but she at least understood he was trying to be considerate."

#. Occurrence 1_3:1467:632: scene=1_3
#: 1_3:1467
msgctxt "text_id=632 | speaker=unknown"
msgid "　……それも、青子にはなんとなく意外だった。"
msgstr "  Which also took her by surprise."

#. Occurrence 1_3:1472:633: scene=1_3
#: 1_3:1472
msgctxt "text_id=633 | speaker=unknown"
msgid "　もう少しこう、人の心にも鈍感な少年だと思ったのだ。"
msgstr "  She figured he'd be just as dense about people's feelings as he was about everything else."

#. Occurrence 1_3:1500:634: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0021; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1500
msgctxt "text_id=634 | speaker=aoko"
msgid "「別に。私もこのまま帰るから」"
msgstr "\"I'll be fine. I'll just head home.\""

#. Occurrence 1_3:1538:635: scene=1_3
#: 1_3:1538
msgctxt "text_id=635 | speaker=unknown"
msgid "　ちなみに、職員室に寄っていく選択は<潔|いさぎよ>いぐらい無い。"
msgstr "  First, though, she thought it best that they both stop by the faculty room."

#. Occurrence 1_3:1543:636: scene=1_3
#: 1_3:1543
msgctxt "text_id=636 | speaker=unknown"
msgid "　山城曰く、転入手続きやらは終わっているというし、後は<社交辞令|おやくそく>の挨拶だけだろう。"
msgstr "  Mr. Yamasiro had mentioned that the transfer procedures had already been completed, so all that remained was for him to sign off on her duties."

#. Occurrence 1_3:1601:637: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0022; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1601
msgctxt "text_id=637 | speaker=aoko"
msgid "“先生、案内終わりました”"
msgstr "\"I've finished showing him around.\""

#. Occurrence 1_3:1607:638: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_3_0000; voice_prefix=B60; voice_category=7; scene=1_3
#: 1_3:1607
msgctxt "text_id=638 | speaker=yamashiro"
msgid "“それはお疲れさま。静希くんもお疲れさま。それで、校舎をまわった感想はどうかな？”"
msgstr "\"Great job. That goes for you, too, Sizuki. What did you think of our school?\""

#. Occurrence 1_3:1613:639: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0014; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:1613
msgctxt "text_id=639 | speaker=soujuurou"
msgid "“ありがとうございます。なんというか、とても学校ですね！”"
msgstr "\"Thank you for the tour. It's like a real school!\""

#. Occurrence 1_3:1619:640: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1_3_0001; voice_prefix=B60; voice_category=7; scene=1_3
#: 1_3:1619
msgctxt "text_id=640 | speaker=yamashiro"
msgid "“ははは、そうかそうか。うん、明日から頑張りなさい！”"
msgstr "\"Hahaha. That's great to hear. Okay, then. Best of luck starting tomorrow!\""

#. Occurrence 1_3:1627:641: scene=1_3
#: 1_3:1627
msgctxt "text_id=641 | speaker=unknown"
msgid "　そんなどうでもいい締めのイベントなぞ、彼女には何ら関係のない話である。"
msgstr "  She had no interest whatsoever in this pointless wrap-up meeting."

#. Occurrence 1_3:1683:642: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0023; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1683
msgctxt "text_id=642 | speaker=aoko"
msgid "「山城先生の事は気にしないでいいわ。"
msgstr "\"You'll have to forgive Mr. Yamasiro."

#. Occurrence 1_3:1689:643: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0024; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1689
msgctxt "text_id=643 | speaker=aoko"
msgid "　教え子に厄介な事を押しつけてふんぞり返っているぐらい職員室が好きなんだから、何時間でも待ってるでしょ。"
msgstr "  He likes the faculty room so much he chooses to kick back there while getting his students to do his dirty work for him. I bet he spends hours in there."

#. Occurrence 1_3:1695:644: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0025; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1695
msgctxt "text_id=644 | speaker=aoko"
msgid "　いえ、待ってるべきじゃない？」"
msgstr "  Actually, that's pretty smart of him.\""

#. Occurrence 1_3:1722:645: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0015; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:1722
msgctxt "text_id=645 | speaker=soujuurou"
msgid "「そうか。蒼崎がいいんなら、いいんだな」"
msgstr "\"Okay, Aozaki. If you're fine with it, then so am I.\""

#. Occurrence 1_3:1734:646: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0026; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1734
msgctxt "text_id=646 | speaker=aoko"
msgid "「？」"
msgstr "\"Huh?\""

#. Occurrence 1_3:1739:647: scene=1_3
#: 1_3:1739
msgctxt "text_id=647 | speaker=unknown"
msgid "　だから、何がいいんだろうか？"
msgstr "  There it was again."

#. Occurrence 1_3:1744:648: scene=1_3
#: 1_3:1744
msgctxt "text_id=648 | speaker=unknown"
msgid "　草十郎の言わんとするところが、青子にはやっぱりさっぱり。"
msgstr "  Whatever Soujyuro was getting at, Aoko had no idea."

#. Occurrence 1_3:1786:649: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0016; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:1786
msgctxt "text_id=649 | speaker=soujuurou"
msgid "「それじゃ行くよ。今日はありがとう」"
msgstr "\"I'm going to get going. Thanks again for today.\""

#. Occurrence 1_3:1792:650: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0027; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1792
msgctxt "text_id=650 | speaker=aoko"
msgid "「今日だけよ、今日だけ」"
msgstr "\"Yes, today. Today only.\""

#. Occurrence 1_3:1798:651: scene=1_3
#: 1_3:1798
msgctxt "text_id=651 | speaker=unknown"
msgid "　ほら、さっさと行った、とばかりに青子は片手をひらひらと払う。"
msgstr "  She shooed him away with her hand."

#. Occurrence 1_3:1810:652: scene=1_3
#: 1_3:1810
msgctxt "text_id=652 | speaker=unknown"
msgid "　その仕草が気に入ったのか、草十郎は嬉しげに笑った。"
msgstr "  His face bent into a broad smile, as if he found the gesture endearing."

#. Occurrence 1_3:1853:653: scene=1_3
#: 1_3:1853
msgctxt "text_id=653 | speaker=unknown"
msgid "　常時ぼんやりしているせいか、彼のそういった顔はきわだって柔らかく見える。"
msgstr "  It was a softer expression than she had grown accustomed to seeing out of him."

#. Occurrence 1_3:1858:654: scene=1_3
#: 1_3:1858
msgctxt "text_id=654 | speaker=unknown"
msgid "　つい笑みを返してしまうぐらいの<和|なご>み度だ。"
msgstr "  It was the kind of smile that would make anyone smile back."

#. Occurrence 1_3:1864:655: scene=1_3
#: 1_3:1864
msgctxt "text_id=655 | speaker=unknown"
msgid "　けれどやっぱり、"
msgstr "  Well, most people at least..."

msgctxt "text_id=656 | speaker=unknown"
msgid "　そういったものに反応しないのが蒼崎青子だった。"
msgstr "  Aoko Aozaki didn't betray the slightest hint of a smile."

#. Occurrence 1_3:1920:657: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0017; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:1920
msgctxt "text_id=657 | speaker=soujuurou"
msgid "「それじゃ、また」"
msgstr "\"See you later.\""

#. Occurrence 1_3:1946:658: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0028; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:1946
msgctxt "text_id=658 | speaker=aoko"
msgid "「は？」"
msgstr "\"Huh?\""

#. Occurrence 1_3:1952:659: scene=1_3
#: 1_3:1952
msgctxt "text_id=659 | speaker=unknown"
msgid "　旧知の友人みたいな言葉を残して、草十郎は廊下の先……"
msgstr "  And with that friendly farewell, Soujyuro walked toward the end of the hallway."

#. Occurrence 1_3:1957:660: scene=1_3
#: 1_3:1957
msgctxt "text_id=660 | speaker=unknown"
msgid "　ではなく、隣の教室に入っていった。"
msgstr "  Or so she thought before he turned into the next class over."

#. Occurrence 1_3:2006:661: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0029; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2006
msgctxt "text_id=661 | speaker=aoko"
msgid "「ちょ―――」"
msgstr "\"Did he just...?\""

#. Occurrence 1_3:2011:662: scene=1_3
#: 1_3:2011
msgctxt "text_id=662 | speaker=unknown"
msgid "　その背中が、まっすぐに窓に向かっていく。"
msgstr "  Soujyuro headed straight for one of the classroom's windows."

#. Occurrence 1_3:2102:663: scene=1_3
#: 1_3:2102
msgctxt "text_id=663 | speaker=unknown"
msgid "　彼はおもむろに教室の窓を開けた。"
msgstr "  Whereupon he opened it with ease."

#. Occurrence 1_3:2107:664: scene=1_3
#: 1_3:2107
msgctxt "text_id=664 | speaker=unknown"
msgid "　十一月の肌寒い風と、おぼろだった雨の音が鮮明になる。"
msgstr "  The chilly November air filled the room as the soft sounds of the rain doubled in volume."

#. Occurrence 1_3:2112:665: scene=1_3
#: 1_3:2112
msgctxt "text_id=665 | speaker=unknown"
msgid "　それが何を意味するのかを、蒼崎青子は瞬時に悟った。悟れてしまった。"
msgstr "  In that instant, she realized his intention with opening the window--she really wished she hadn't."

#. Occurrence 1_3:2183:666: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0030; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2183
msgctxt "text_id=666 | speaker=aoko"
msgid "「いや、待て待て待てーーーーっっっ！」"
msgstr "\"Nooo! Stop stop stop STOP!\""

#. Occurrence 1_3:2189:667: scene=1_3
#: 1_3:2189
msgctxt "text_id=667 | speaker=unknown"
msgid "　今まさに、窓枠に片足を乗っける草十郎を、青子は必死の形相で止めた。"
msgstr "  He already had one leg out the window when she dashed to stop him."

#. Occurrence 1_3:2282:668: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0031; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2282
msgctxt "text_id=668 | speaker=aoko"
msgid "「なにするつもりよ、あんたはっ！」"
msgstr "\"What do you think you're doing!?\""

#. Occurrence 1_3:2288:669: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0018; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:2288
msgctxt "text_id=669 | speaker=soujuurou"
msgid "「なにって、アルバイトに行くんだけど」"
msgstr "\"What am I doing? I'm leaving for my job, that's what.\""

#. Occurrence 1_3:2303:670: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0032; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2303
msgctxt "text_id=670 | speaker=aoko"
msgid "「その窓は人が出入りするところじゃないの！"
msgstr "\"You do know that this window isn't an exit, don't you!?"

#. Occurrence 1_3:2309:671: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0033; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2309
msgctxt "text_id=671 | speaker=aoko"
msgid "　だいたい、ここ何階だと思ってるの!?」"
msgstr "  I mean, do you even know what floor you're on!?\""

#. Occurrence 1_3:2324:672: scene=1_3
#: 1_3:2324
msgctxt "text_id=672 | speaker=unknown"
msgid "　言われて、あ、と声をあげる草十郎。"
msgstr "  She saw the light of understanding dawn in his eyes."

#. Occurrence 1_3:2379:673: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0019; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:2379
msgctxt "text_id=673 | speaker=soujuurou"
msgid "「……死ぬところだった。二階から下りたら危なすぎる」"
msgstr "\"...Oh my god, I almost died. Who would put an exit here? This is dangerous.\""

#. Occurrence 1_3:2385:674: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0034; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2385
msgctxt "text_id=674 | speaker=aoko"
msgid "「危ないのはあんたの頭……」"
msgstr "\"It's the lack of something between your ears that's dangerous.\""

#. Occurrence 1_3:2391:675: scene=1_3
#: 1_3:2391
msgctxt "text_id=675 | speaker=unknown"
msgid "　脱力しつつも<暴言|ぼうげん>をこぼすが、幸い、草十郎には聞こえていなかった。"
msgstr "  Her insult went right over his head."

#. Occurrence 1_3:2460:676: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0035; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2460
msgctxt "text_id=676 | speaker=aoko"
msgid "「あのね、こっちじゃ窓から人は出入りしないの。"
msgstr "\"People here don't normally enter and exit through windows, okay?"

#. Occurrence 1_3:2460:677: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0035; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2460
msgctxt "text_id=677 | speaker=aoko"
msgid "　さっき言っとくべきだったわ」"
msgstr "  You should probably remember this information for future reference.\""

#. Occurrence 1_3:2472:678: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0020; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:2472
msgctxt "text_id=678 | speaker=soujuurou"
msgid "「知ってるよ、時間がないんであわててたんだ。"
msgstr "\"Oh, I know. I just wanted to save some time."

#. Occurrence 1_3:2478:679: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0021; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:2478
msgctxt "text_id=679 | speaker=soujuurou"
msgid "　ありがとう、これからは気をつける」"
msgstr "  But thanks. I'll be more careful from now on.\""

#. Occurrence 1_3:2559:680: scene=1_3
#: 1_3:2559
msgctxt "text_id=680 | speaker=unknown"
msgid "　よいしょ、と窓枠から片足を下ろして窓を閉める草十郎。"
msgstr "  He pulled his leg back inside and closed the window."

#. Occurrence 1_3:2564:681: scene=1_3
#: 1_3:2564
msgctxt "text_id=681 | speaker=unknown"
msgid "　見るからに下ろしたての制服は、今ので雨に濡れてしまっていた。"
msgstr "  His school uniform was soaking wet from the rain."

#. Occurrence 1_3:2592:682: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0036; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2592
msgctxt "text_id=682 | speaker=aoko"
msgid "「……いいけど、私は別に。"
msgstr "\"Hey, be my guest."

#. Occurrence 1_3:2598:683: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0037; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2598
msgctxt "text_id=683 | speaker=aoko"
msgid "　あなたが何処から外に出ようが関係ないもの。ただ、できれば私の前ではやらないでほしいだけよ。"
msgstr "  Go outside any way you like. Just don't do it in front of me from now on."

#. Occurrence 1_3:2614:684: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0038; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2614
msgctxt "text_id=684 | speaker=aoko"
msgid "　それより……貴方、本当に明日から学校に来るの？」"
msgstr "  Anyway... You start school tomorrow, right?\""

#. Occurrence 1_3:2626:685: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_3_0022; voice_prefix=A30; voice_category=3; scene=1_3
#: 1_3:2626
msgctxt "text_id=685 | speaker=soujuurou"
msgid "「来るよ。不安だけど、案内してもらったし」"
msgstr "\"Yeah. I'm a little nervous, though, which is why I came in early for the tour.\""

#. Occurrence 1_3:2685:686: scene=1_3
#: 1_3:2685
msgctxt "text_id=686 | speaker=unknown"
msgid "　それじゃあ、と返して、少年は廊下を走っていった。"
msgstr "  He bid her farewell before running away down the hallway."

#. Occurrence 1_3:2690:687: scene=1_3
#: 1_3:2690
msgctxt "text_id=687 | speaker=unknown"
msgid "　今度こそ普通に、階段を下りて昇降口から出ていくのだろう。"
msgstr "  She hoped he would walk down the stairs and leave through the school entrance, like a normal person."

#. Occurrence 1_3:2717:688: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0039; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2717
msgctxt "text_id=688 | speaker=aoko"
msgid "「……はあ。大丈夫なのか、あんなんで」"
msgstr "\"Ugh... I wonder if he's really going to be okay here.\""

#. Occurrence 1_3:2742:689: scene=1_3
#: 1_3:2742
msgctxt "text_id=689 | speaker=unknown"
msgid "　呆れながらも、走り去った彼の背中を回想する。"
msgstr "  The image of him disappearing into the distance popped into her head, in spite of her ire."

#. Occurrence 1_3:2747:690: scene=1_3
#: 1_3:2747
msgctxt "text_id=690 | speaker=unknown"
msgid "　もうあんな田舎者とは関わりたくないのに、妙なところで気に掛かる。"
msgstr "  She had no intention of spending any more time with him, and yet, she felt strangely anxious."

#. Occurrence 1_3:2752:691: scene=1_3
#: 1_3:2752
msgctxt "text_id=691 | speaker=unknown"
msgid "　心配からか、それとも癪に障るからなのか、いまいち納得のいく答えは出ない。"
msgstr "  She couldn't tell if the feeling was fueled by concern or irritation."

#. Occurrence 1_3:2778:692: scene=1_3
#: 1_3:2778
msgctxt "text_id=692 | speaker=unknown"
msgid "　そもそもどうして自分はさしたる理由もなく、あのどうでもいい転入生に怒りを覚えたのか。"
msgstr "  Why had she even gotten angry with this insignificant transfer student in the first place?"

#. Occurrence 1_3:2783:693: scene=1_3
#: 1_3:2783
msgctxt "text_id=693 | speaker=unknown"
msgid "　妙な一日、妙な転入生、妙な感情。"
msgstr "  A strange day with a strange transfer student resulting in strange emotions."

#. Occurrence 1_3:2788:694: scene=1_3
#: 1_3:2788
msgctxt "text_id=694 | speaker=unknown"
msgid "　こうして振り返ってみると、実は怒るべきじゃなく楽しむべきコトだったんじゃないか、と首をかしげる自分もいる。"
msgstr "  Her head tilted as she reflected on what should have been a more enjoyable day than the irritating experience she just had."

#. Occurrence 1_3:2823:695: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0040; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2823
msgctxt "text_id=695 | speaker=aoko"
msgid "「―――ま、いっか。"
msgstr "\"Whatever."

#. Occurrence 1_3:2829:696: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0041; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2829
msgctxt "text_id=696 | speaker=aoko"
msgid "　どうせこれっきりなんだし」"
msgstr "  It's not as if I'll see him again.\""

#. Occurrence 1_3:2937:697: scene=1_3
#: 1_3:2937
msgctxt "text_id=697 | speaker=unknown"
msgid "　静かに響く雨の音。"
msgstr "  The sound of the rain echoed quietly all around her."

#. Occurrence 1_3:2942:698: scene=1_3
#: 1_3:2942
msgctxt "text_id=698 | speaker=unknown"
msgid "　灰色の空は時間の<有様|ありよう>を麻痺させる。"
msgstr "  The gray sky seemed frozen in time."

#. Occurrence 1_3:2947:699: scene=1_3
#: 1_3:2947
msgctxt "text_id=699 | speaker=unknown"
msgid "　今はまだ午前中なのか、夕方なのかも判らない。"
msgstr "  It was impossible to discern whether it was morning or evening."

#. Occurrence 1_3:2952:700: scene=1_3
#: 1_3:2952
msgctxt "text_id=700 | speaker=unknown"
msgid "　校舎にはたぶん自分と、山城ぐらいしかいないだろう。"
msgstr "  Mr. Yamasiro and Aoko were likely the only ones left at school."

#. Occurrence 1_3:2957:701: scene=1_3
#: 1_3:2957
msgctxt "text_id=701 | speaker=unknown"
msgid "　電灯の消えた教室は薄暗く、ひとりになるとやけに不気味だった。"
msgstr "  The unlit classroom looked overly gloomy and ominous as Aoko stood in it alone."

#. Occurrence 1_3:2979:702: scene=1_3
#: 1_3:2979
msgctxt "text_id=702 | speaker=unknown"
msgid "　つと―――青子は左手の<袖|そで>を上げた。"
msgstr "  She pulled up her left sleeve."

#. Occurrence 1_3:2984:703: scene=1_3
#: 1_3:2984
msgctxt "text_id=703 | speaker=unknown"
msgid "　飾り気のない小さな腕時計は、たしかに午後一時になろうとしている。"
msgstr "  Her dainty, unremarkable watch showed that it was almost one o'clock."

#. Occurrence 1_3:2991:704: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_3_0042; voice_prefix=A10; voice_category=1; scene=1_3
#: 1_3:2991
msgctxt "text_id=704 | speaker=aoko"
msgid "「……時間、あってる」"
msgstr "\"He was right about the time.\""

#. Occurrence 1_3:3033:705: scene=1_3
#: 1_3:3033
msgctxt "text_id=705 | speaker=unknown"
msgid "　言って、青子は窓ごしに地上を見下ろした。"
msgstr "  She looked out the window at the grounds below."

#. Occurrence 1_3:3038:706: scene=1_3
#: 1_3:3038
msgctxt "text_id=706 | speaker=unknown"
msgid "　小雨の中、制服姿の男子が傘もささずに走っていく。見慣れている筈の光景が、彼女にはひどく印象深かった。"
msgstr "  She saw a boy in uniform running through the rain without an umbrella. A sight she must have seen before, but for whatever reason, affected her far more than she wished."

#. Occurrence 1_4:80:707: scene=1_4
#: 1_4:80
msgctxt "text_id=707 | speaker=unknown"
msgid "　青子は先の公言通り、職員室に寄らず帰路についた。"
msgstr "  Aoko did not stop by the faculty room before heading home."

#. Occurrence 1_4:85:708: scene=1_4
#: 1_4:85
msgctxt "text_id=708 | speaker=unknown"
msgid "　山城の「帰りは車で送るよ」という提案には心揺さぶられるものがあったが、せめてもの報復として彼の休日にも共倒れしてもらうのはどうか、という案の方が何倍も魅力的だったからだ。"
msgstr "  While Mr. Yamasiro's offer to drive her home was tempting, she decided it would ultimately be far more satisfying to ruin his day just as he had hers."

#. Occurrence 1_4:105:709: scene=1_4
#: 1_4:105
msgctxt "text_id=709 | speaker=unknown"
msgid "　足音を立てず昇降口に行き、まっ赤な傘を開く。"
msgstr "  She walked as quietly as she could toward the entrance and opened her bright red umbrella."

#. Occurrence 1_4:110:710: scene=1_4
#: 1_4:110
msgctxt "text_id=710 | speaker=unknown"
msgid "　朝の予報通り、正午を過ぎて雨は小降りになっていた。"
msgstr "  As she had predicted that morning, the rain was waning in the afternoon."

#. Occurrence 1_4:115:711: scene=1_4
#: 1_4:115
msgctxt "text_id=711 | speaker=unknown"
msgid "　この分なら、あと一時間ほどで止むだろう。"
msgstr "  At this rate, it would probably cease completely in an hour or so."

#. Occurrence 1_4:120:712: scene=1_4
#: 1_4:120
msgctxt "text_id=712 | speaker=unknown"
msgid "　青子が帰宅するのと入れ替わりで、遠くの空に見えた日射しがやってくる事になる。"
msgstr "  The distant sunshine would likely have reached her by the time she arrived home."

#. Occurrence 1_4:178:713: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0000; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:178
msgctxt "text_id=713 | speaker=aoko"
msgid "「――――ま、それも悪くないか」"
msgstr "\"Well, I suppose it could be worse.\""

#. Occurrence 1_4:184:714: scene=1_4
#: 1_4:184
msgctxt "text_id=714 | speaker=unknown"
msgid "　肩をすくめて観念する。"
msgstr "  She shrugged her shoulders in resignation."

#. Occurrence 1_4:189:715: scene=1_4
#: 1_4:189
msgctxt "text_id=715 | speaker=unknown"
msgid "　雨は好きでも嫌いでもない青子だが、赤い傘を開いて歩く事には、ちょっとした愉しみがあるからだ。"
msgstr "  She neither liked nor disliked rain, but she found herself enjoying her walk home with her red umbrella in hand."

#. Occurrence 1_4:245:716: scene=1_4
#: 1_4:245
msgctxt "text_id=716 | speaker=unknown"
msgid "　教師たちがそろって派手目を嫌う<三咲|みさき>高において、青子の赤い傘は珍しい色と言える。"
msgstr "  The teachers at Misaki High School weren't fond of bright colors, so Aoko's red umbrella was an unusual sight."

#. Occurrence 1_4:250:717: scene=1_4
#: 1_4:250
msgctxt "text_id=717 | speaker=unknown"
msgid "　一時期、“蒼崎の傘は昔は白かった”なんて語りだしの怪談が<流|は><行|や>ったが、その話ではお化けのかわりに青子が活躍しているらしい。"
msgstr "  A ghost story about how the umbrella was once pure white had been making the rounds, but it featured Aoko instead of a ghost."

#. Occurrence 1_4:255:718: scene=1_4
#: 1_4:255
msgctxt "text_id=718 | speaker=unknown"
msgid "　そんな曰くつきの傘を開いて、青子は<三咲町|みさきちょう>の駅に向かう。"
msgstr "  It was with that umbrella that she made her way toward Misaki Station."

#. Occurrence 1_4:332:719: scene=1_4
#: 1_4:332
msgctxt "text_id=719 | speaker=unknown"
msgid "　彼女の通う私立三咲高等学校は、その名の通り三咲町にある。"
msgstr "  Misaki Private High School took its namesake from the town it was in."

#. Occurrence 1_4:337:720: scene=1_4
#: 1_4:337
msgctxt "text_id=720 | speaker=unknown"
msgid "　昔から大部分が畑と森だった三咲町だが、ここ十年、高度成長期の勢いで急激に近代化が進んでいた。"
msgstr "  The area was once a sprawl of farmland and woodland, but rapid growth over the last ten years had led to unprecedented modernization."

#. Occurrence 1_4:357:721: scene=1_4
#: 1_4:357
msgctxt "text_id=721 | speaker=unknown"
msgid "　自然に満ちた三咲町を残すべきではないか、という声もあったが、"
msgstr "  There were some who fought to preserve Misaki's natural treasures."

#. Occurrence 1_4:363:722: voice_id=F40_1_4_0000; voice_prefix=F40; voice_category=0; scene=1_4
#: 1_4:363
msgctxt "text_id=722 | speaker=unknown"
msgid "『残す事には賛成ですが、それでは<遺|のこ>すだけになってしまうでしょう』"
msgstr "\"I agree in principle to preserving the land, but not at the expense of our prosperity.\""

#. Occurrence 1_4:368:723: scene=1_4
#: 1_4:368
msgctxt "text_id=723 | speaker=unknown"
msgid "　なんて市長の一声で少数派は鎮圧。長期計画で新しい街作りがはじまった。"
msgstr "  With those words, the mayor snuffed out the voices of the minority and ushered in a long-term plan for new urban development."

#. Occurrence 1_4:431:724: scene=1_4
#: 1_4:431
msgctxt "text_id=724 | speaker=unknown"
msgid "　都市開発には十分すぎる金額が集められ、"
msgstr "  More than enough funds for the urban development were collected,"

#. Occurrence 1_4:436:725: scene=1_4
#: 1_4:436
msgctxt "text_id=725 | speaker=unknown"
msgid "　わりかし普通の町だった三咲町はわずか十年で三咲市を代表する町になったのである。"
msgstr "  and the unassuming town of Misaki became the largest municipality of Misaki City in merely ten years."

#. Occurrence 1_4:442:726: scene=1_4
#: 1_4:442
msgctxt "text_id=726 | speaker=unknown"
msgid "　……もっとも、近代的な面では隣町である<社木|やしろぎ>に一歩譲り、"
msgstr "  Even though it lacked the modernity of neighboring Yashirogi"

#. Occurrence 1_4:447:727: scene=1_4
#: 1_4:447
msgctxt "text_id=727 | speaker=unknown"
msgid "　<上品|エレガント>さでもこれまた隣町の三咲丘に一歩譲る立ち位置だ。"
msgstr "  or the elegance of Misaki Hills..."

#. Occurrence 1_4:502:728: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0001; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:502
msgctxt "text_id=728 | speaker=aoko"
msgid "「……それも当然よね。どういじくっても元々が山中の宿場町だし。山ごと切り崩すっていうんなら別だけど」"
msgstr "\"What did people expect? To keep the town hidden atop the mountain forever? It's not like they were gonna flatten the mountain or something.\""

#. Occurrence 1_4:536:729: scene=1_4
#: 1_4:536
msgctxt "text_id=729 | speaker=unknown"
msgid "　都市化が進んでいるのは平坦な駅周辺だけで、丘や山は十年前のままだ。"
msgstr "  Urbanization had been contained to the lowlands around the station, with most of the hills and mountains still standing as they did ten years prior."

#. Occurrence 1_4:541:730: scene=1_4
#: 1_4:541
msgctxt "text_id=730 | speaker=unknown"
msgid "　昔ながらの三咲町なんてものは、住民が守らなくても資金の枯渇が守ってくれたらしい。"
msgstr "  The exhaustion of funds succeeded in protecting the old Misaki where the citizens could not."

#. Occurrence 1_4:561:731: scene=1_4
#: 1_4:561
msgctxt "text_id=731 | speaker=unknown"
msgid "　かくして、三咲町は都心の人間がやってきても、まあ、あまりの田舎っぷりに呆れられるコトだけはないという、実に半端な地方都市になりつつある。"
msgstr "  It became a truly odd suburban town, welcoming an increasingly urban population with its vestiges of old country charm."

#. Occurrence 1_4:595:732: scene=1_4
#: 1_4:595
msgctxt "text_id=732 | speaker=unknown"
msgid "　そんな三咲町の中にあって、三咲高は開発以前からあった私立高校である。"
msgstr "  Misaki High School was a private school established long before the town's current state."

#. Occurrence 1_4:600:733: scene=1_4
#: 1_4:600
msgctxt "text_id=733 | speaker=unknown"
msgid "　今あるのは第二校舎で、五十年前に建てられた初代校舎はさらに上った山の中。"
msgstr "  The original campus, built fifty years ago, was located high up in the mountains, making its current location its second incarnation."

#. Occurrence 1_4:646:734: scene=1_4
#: 1_4:646
msgctxt "text_id=734 | speaker=unknown"
msgid "　遠い、坂道がきつい、"
msgstr "  The path to the old grounds was not only steep and remote―"

#. Occurrence 1_4:651:735: scene=1_4
#: 1_4:651
msgctxt "text_id=735 | speaker=unknown"
msgid "　それ以前に通学路が<獣道|けものみち>と化している、"
msgstr "  it had become an overgrown game trail with the passage of time."

#. Occurrence 1_4:656:736: scene=1_4
#: 1_4:656
msgctxt "text_id=736 | speaker=unknown"
msgid "　等々の理由で二十年前まで閉校していた三咲高校だったが、三咲市に本拠地を持つ某デパートグループからの寄付金をもとに新校舎を設立。"
msgstr "  For these reasons, among others, Misaki High School had been shuttered until almost 20 years ago, when it received a donation from a department store chain that allowed for the construction of a new campus in the city."

#. Occurrence 1_4:661:737: scene=1_4
#: 1_4:661
msgctxt "text_id=737 | speaker=unknown"
msgid "　かくて、森の校舎は旧校舎として忘れ去られる事になり、三咲高校は再び学舎として開かれた。"
msgstr "  And thus, Misaki High School reopened its doors, the old woodland campus forgotten."

#. Occurrence 1_4:696:738: scene=1_4
#: 1_4:696
msgctxt "text_id=738 | speaker=unknown"
msgid "　しかし、実のところを言えば、三咲高校の生徒の多くは三咲町の住人ではない。"
msgstr "  In fact, most of the students attending Misaki High School were not from Misaki at all."

#. Occurrence 1_4:701:739: scene=1_4
#: 1_4:701
msgctxt "text_id=739 | speaker=unknown"
msgid "　この田舎町に住んでいた善良で素朴な人々は、私立高校より県立高校を望んでいたからである。"
msgstr "  The hearty rustic people of this country town preferred prefectural schools to private ones."

#. Occurrence 1_4:758:740: scene=1_4
#: 1_4:758
msgctxt "text_id=740 | speaker=unknown"
msgid "　何を隠そう、青子もそういった人種の一人だった。"
msgstr "  Truth be told, Aoko herself was one of them."

#. Occurrence 1_4:763:741: scene=1_4
#: 1_4:763
msgctxt "text_id=741 | speaker=unknown"
msgid "　彼女には中学卒業とともに上京して、国立大学をめざしながらライブハウスを毎日はしごして回るという慎ましやかな野望があったのだ。"
msgstr "  All she had wanted after junior high was to move to Tokyo, where she hoped to spend her days touring her favorite bands on her way to entering a public university."

#. Occurrence 1_4:768:742: scene=1_4
#: 1_4:768
msgctxt "text_id=742 | speaker=unknown"
msgid "　そんな彼女の夢も姉の抜け駆けで台無しにされてしまい、何の因果かせっかくの創立記念日に真っ赤な傘をさして歩いている。"
msgstr "  But her hopes were dashed with her sister's departure, so here she was, walking alone in town with only a red umbrella to keep her company on what should have been a day off."

#. Occurrence 1_4:811:743: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0002; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:811
msgctxt "text_id=743 | speaker=aoko"
msgid "「……思い返して見ると。"
msgstr "\"...Looking back on it now..."

msgctxt "text_id=744 | speaker=unknown"
msgid "　私の人生って、なんか災難続きっぽい……」"
msgstr "  It's like my whole life has been one disaster after another.\""

#. Occurrence 1_4:819:745: scene=1_4
#: 1_4:819
msgctxt "text_id=745 | speaker=unknown"
msgid "　十二月を前にした寒さの中、ひとりきりでそう呟く。"
msgstr "  Her frustration evaporated into the cold December air."

#. Occurrence 1_4:869:746: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0003; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:869
msgctxt "text_id=746 | speaker=aoko"
msgid "「でもま、いっか。退屈だけはしないワケだし」"
msgstr "\"Oh well. At least it's not boring.\""

#. Occurrence 1_4:875:747: scene=1_4
#: 1_4:875
msgctxt "text_id=747 | speaker=unknown"
msgid "　語尾をかすかに弾ませて学校を後にする。"
msgstr "  With those words, her mood brightened a bit as she left the school in her wake."

#. Occurrence 1_4:880:748: scene=1_4
#: 1_4:880
msgctxt "text_id=748 | speaker=unknown"
msgid "　ゆるやかな坂道を下ってしまえば、そこは賑わいに満ちた人々の住まう街だ。"
msgstr "  The busier part of town met her at the bottom of the gently sloping road."

#. Occurrence 1_4:964:749: scene=1_4
#: 1_4:964
msgctxt "text_id=749 | speaker=unknown"
msgid "　三咲町の駅は真新しい。"
msgstr "  Misaki's train station was brand new."

#. Occurrence 1_4:969:750: scene=1_4
#: 1_4:969
msgctxt "text_id=750 | speaker=unknown"
msgid "　かつては廃工場にしか見えなかった<建物|えき>は、今では東と西に巨大デパートを持つ複合建築に造り替えられていた。"
msgstr "  Once looking no prettier than an abandoned factory, it had been renovated into a multi-purpose structure with huge department stores on its east and west sides."

#. Occurrence 1_4:989:751: scene=1_4
#: 1_4:989
msgctxt "text_id=751 | speaker=unknown"
msgid "　このデパートが出来た時、青子も近代化万歳！　と友人たちとはしゃいだものだが、この建物もあと何年かすれば時代遅れになるのだろう。"
msgstr "  When the department stores first opened, Aoko and her friends had been impressed with their modern feel, but in time, the stores, too, became dated."

#. Occurrence 1_4:1009:752: scene=1_4
#: 1_4:1009
msgctxt "text_id=752 | speaker=unknown"
msgid "　これといった買い物はないのでデパートを通り過ぎる。"
msgstr "  She had no shopping to do today, so she passed them by."

#. Occurrence 1_4:1014:753: scene=1_4
#: 1_4:1014
msgctxt "text_id=753 | speaker=unknown"
msgid "　本当は喫茶店にでもよって体を休めたいところだが、ひとりだけで無駄遣いをするとまた同居人がヘソを曲げかねないので我慢して―――"
msgstr "  What she really wanted to do was rest at a café, but she fought the urge, knowing her roommate would never let her hear the end of it if she frittered away her money―"

#. Occurrence 1_4:1131:754: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0004; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:1131
msgctxt "text_id=754 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 1_4:1137:755: scene=1_4
#: 1_4:1137
msgctxt "text_id=755 | speaker=unknown"
msgid "　振り返って、目をしばたたく。"
msgstr "  She looked back and blinked."

#. Occurrence 1_4:1142:756: scene=1_4
#: 1_4:1142
msgctxt "text_id=756 | speaker=unknown"
msgid "　一瞬。視界の隅に、赤い<服|ドレス>の<不審人物|ナニモノか>を見た気がした。"
msgstr "  For just a moment, she could have sworn she had seen someone suspicious in a red dress out of the corner of her eye."

#. Occurrence 1_4:1177:757: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0005; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:1177
msgctxt "text_id=757 | speaker=aoko"
msgid "「――――――"
msgstr "\"..."

msgctxt "text_id=758 | speaker=unknown"
msgid "、ふぅ」"
msgstr "Heh.\""

#. Occurrence 1_4:1185:759: scene=1_4
#: 1_4:1185
msgctxt "text_id=759 | speaker=unknown"
msgid "　どうやらいつもの勘違い。"
msgstr "  It must have been her imagination."

#. Occurrence 1_4:1190:760: scene=1_4
#: 1_4:1190
msgctxt "text_id=760 | speaker=unknown"
msgid "　背筋には第六感じみた悪寒があるけど、それも慣れたものだと受け流す。"
msgstr "  The sixth-sense chill she was experiencing down her spine was a familiar one at this point."

#. Occurrence 1_4:1210:761: scene=1_4
#: 1_4:1210
msgctxt "text_id=761 | speaker=unknown"
msgid "　まったくもって何事もなかったように振る舞って、青子はいつも通りの帰路につく。"
msgstr "  She continued her walk home, brushing off the event as if it had never happened."

#. Occurrence 1_4:1226:762: scene=1_4
#: 1_4:1226
msgctxt "text_id=762 | speaker=unknown"
msgid "　ほどなくして背中の悪寒は消え、街の喧噪だけが耳に残った。"
msgstr "  In time, the chill faded and all that was left was the sounds of the town."

#. Occurrence 1_4:1288:763: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0006; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:1288
msgctxt "text_id=763 | speaker=aoko"
msgid "「…………はあ」"
msgstr "\"...Ugh...\""

#. Occurrence 1_4:1294:764: scene=1_4
#: 1_4:1294
msgctxt "text_id=764 | speaker=unknown"
msgid "　大きくため息をひとつ。"
msgstr "  She sighed heavily."

#. Occurrence 1_4:1299:765: scene=1_4
#: 1_4:1299
msgctxt "text_id=765 | speaker=unknown"
msgid "　まったく。"
msgstr "  Had she imagined it?"

#. Occurrence 1_4:1304:766: scene=1_4
#: 1_4:1304
msgctxt "text_id=766 | speaker=unknown"
msgid "　気のせいにしても、気持ちのいいものじゃない。"
msgstr "  Even if it had all been in her head, she was far from comfortable with the feeling that still lingered."

#. Occurrence 1_4:1359:767: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0007; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:1359
msgctxt "text_id=767 | speaker=aoko"
msgid "「……夏場の蚊だって、もう少し、こう」"
msgstr "\"...Even mosquitoes have the grace to buzz off eventually.\""

#. Occurrence 1_4:1365:768: scene=1_4
#: 1_4:1365
msgctxt "text_id=768 | speaker=unknown"
msgid "　節度を<弁|わきま>えている……こともないか、と愚痴をこぼす。"
msgstr "  She grumbled under her breath."

#. Occurrence 1_4:1420:769: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0008; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:1420
msgctxt "text_id=769 | speaker=aoko"
msgid "「……波瀾万丈、商売繁盛、諸行無常、と。"
msgstr "\"...Whether good or bad, this too shall pass, so the saying goes."

#. Occurrence 1_4:1426:770: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0009; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:1426
msgctxt "text_id=770 | speaker=aoko"
msgid "　そうそう、忙しさにグチを言っても始まらないわ」"
msgstr "  Yeah. I've got enough on my plate as it is.\""

#. Occurrence 1_4:1432:771: scene=1_4
#: 1_4:1432
msgctxt "text_id=771 | speaker=unknown"
msgid "　うっとうしいけど夏場に蚊はいて当然だし。"
msgstr "  Unfortunately, summer and bugs go hand-in-hand."

#. Occurrence 1_4:1437:772: scene=1_4
#: 1_4:1437
msgctxt "text_id=772 | speaker=unknown"
msgid "　甘い果実に虫が寄ってくるのは、まあ、正しい価値観だろう、と納得する青子だった。"
msgstr "  She could see how bugs could be drawn to all the sweet fruit."

#. Occurrence 1_4:1507:773: scene=1_4
#: 1_4:1507
msgctxt "text_id=773 | speaker=unknown"
msgid "　油と熱のこもった厨房は、一時の休眠に入っている。"
msgstr "  Rank with grease and heat, the kitchen was closed for the time being."

#. Occurrence 1_4:1512:774: scene=1_4
#: 1_4:1512
msgctxt "text_id=774 | speaker=unknown"
msgid "　本日も無事、昼の修羅場を乗り切った。"
msgstr "  The lunch rush had come and gone."

#. Occurrence 1_4:1517:775: scene=1_4
#: 1_4:1517
msgctxt "text_id=775 | speaker=unknown"
msgid "　あとは<夕食|よる>の混雑さえ乗り越えれば誰もがコックコートを脱いでしまえる。"
msgstr "  But one last battle remained: dinner time. Only after the evening chaos could the kitchen crew remove their white armor and call it a day."

#. Occurrence 1_4:1522:776: scene=1_4
#: 1_4:1522
msgctxt "text_id=776 | speaker=unknown"
msgid "　そんな、激戦を終えたばかりの<厨房|キッチン>で、ぽつんと立ちつくす<新参者|アルバイト>がひとり。"
msgstr "  In the midst of the warzone was a lone newcomer."

#. Occurrence 1_4:1543:777: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1_4_0000; voice_prefix=A30; voice_category=3; scene=1_4
#: 1_4:1543
msgctxt "text_id=777 | speaker=soujuurou"
msgid "「ええっと、これ着るんですか？」"
msgstr "\"Umm, do I have to wear this?\""

#. Occurrence 1_4:1549:778: scene=1_4
#: 1_4:1549
msgctxt "text_id=778 | speaker=unknown"
msgid "　新人らしく、不安そうな声で訊ねる。"
msgstr "  His voice was uneasy, betraying how new he was."

#. Occurrence 1_4:1594:779: voice_id=H10_1_4_0000; voice_prefix=H10; voice_category=0; scene=1_4
#: 1_4:1594
msgctxt "text_id=779 | speaker=unknown"
msgid "「気持ちは分かる。俺もどうかと思うけど、店長の言うことだからもう笑顔で乗り越えてくれ。これも商店街の明日のため、なんだとよ。本気で申し訳ないんだが、雨も止んだし、なんとか行って来てくれないか？　無事帰ってきたら晩メシおごってやっから」"
msgstr "\"I know how you feel, man. I feel the same. Unfortunately, it's the boss's orders, so you'll have to suck it up, okay? 'The future of this shopping arcade is at stake'... apparently. I really hate to ask, but the rain has stopped, so would you mind going out for me? Get back in one piece, and I'll buy you dinner.\""

#. Occurrence 1_4:1600:780: scene=1_4
#: 1_4:1600
msgctxt "text_id=780 | speaker=unknown"
msgid "　まぶしいオレンジ色の制服を着こんだ先輩は、本気ですまないと手を合わせて、無理難題を押しつけた。"
msgstr "  His bright orange co-worker clasped his hands together as if to beg for forgiveness as he saddled him with this unreasonable task."

#. Occurrence 1_4:1648:781: scene=1_4
#: 1_4:1648
msgctxt "text_id=781 | speaker=unknown"
msgid "　十年前、三咲市は畑と森の町だった。"
msgstr "  Ten years ago, Misaki City was a town of farm and woodland."

#. Occurrence 1_4:1653:782: scene=1_4
#: 1_4:1653
msgctxt "text_id=782 | speaker=unknown"
msgid "　<現|い><在|ま>は開発が進み、駅前にはビルディングが立ち並び、住宅地にも二階建て以上の建築が増え、かつての田園風景は駅から離れないと見られない。"
msgstr "  But everything had changed. The front of the station was now lined with tall multi-story buildings, and the residential areas were similarly full of apartment complexes. The once rustic scenery around the station had long become a thing of the past."

#. Occurrence 1_4:1658:783: scene=1_4
#: 1_4:1658
msgctxt "text_id=783 | speaker=unknown"
msgid "　そんな中、都市部においても昔ながらの面影を残しているのがここ、三咲市のエアポケットと言われる<白犬塚|しろいぬづか>である。"
msgstr "  Shiroinuzuka was the only place in the city that still contained vestiges of the old town. A pocket of the past inside an urban jungle."

#. Occurrence 1_4:1678:784: scene=1_4
#: 1_4:1678
msgctxt "text_id=784 | speaker=unknown"
msgid "　ひときわ高い丘に敷かれた長い坂道。"
msgstr "  The road extended up a conspicuously high hill,"

#. Occurrence 1_4:1683:785: scene=1_4
#: 1_4:1683
msgctxt "text_id=785 | speaker=unknown"
msgid "　人々の生活の中心である駅から離れた、昔ながらの住宅地。"
msgstr "  to an old residential district far from the hustle and bustle of the train station."

#. Occurrence 1_4:1688:786: scene=1_4
#: 1_4:1688
msgctxt "text_id=786 | speaker=unknown"
msgid "　その昔、三咲では高い土地に住居を構えるのはよくない事とされ、一定以上の高みに住む人間はいなかった。"
msgstr "  Long ago, it had been considered unwise to build on high ground, so nobody lived above a certain elevation."

#. Occurrence 1_4:1693:787: scene=1_4
#: 1_4:1693
msgctxt "text_id=787 | speaker=unknown"
msgid "　町の中心にそびえる丘、この白犬塚もその例にならい、ここから先に民家は見られない。"
msgstr "  Shiroinuzuka, sitting as it did atop a hill in the middle of town, was no exception to that convention and had no residences to speak of."

#. Occurrence 1_4:1715:788: scene=1_4
#: 1_4:1715
msgctxt "text_id=788 | speaker=unknown"
msgid "　アスファルトの坂道は延々と続くものの、やがて森に閉ざされ、あとは山道のごとき道が続くだけ。"
msgstr "  The asphalt continued for some time, eventually giving way to a mountain road that was swallowed into the cover of trees."

#. Occurrence 1_4:1720:789: scene=1_4
#: 1_4:1720
msgctxt "text_id=789 | speaker=unknown"
msgid "　坂道の途中にぽつんと置かれた自動販売機は、さながら町と丘の境界線のようだ。"
msgstr "  A lone vending machine stood to mark the boundary between town and beyond."

#. Occurrence 1_4:1725:790: scene=1_4
#: 1_4:1725
msgctxt "text_id=790 | speaker=unknown"
msgid "　新しい遊び場の開発に余念がない子供たちでも、この先には何もないと知っている。"
msgstr "  Even the children knew that there was nothing beyond the new playground in development that so enthralled them."

#. Occurrence 1_4:1730:791: scene=1_4
#: 1_4:1730
msgctxt "text_id=791 | speaker=unknown"
msgid "　いや、<正|ただ>しくは。"
msgstr "  Well, that was not entirely true."

#. Occurrence 1_4:1735:792: scene=1_4
#: 1_4:1735
msgctxt "text_id=792 | speaker=unknown"
msgid "　この先には、あのお化け屋敷しかないと知っている。"
msgstr "  There was nothing... besides the haunted house."

#. Occurrence 1_4:1778:793: scene=1_4
#: 1_4:1778
msgctxt "text_id=793 | speaker=unknown"
msgid "　長い坂を、蒼崎青子は上っていく。"
msgstr "  Aoko Aozaki traversed the long slope."

#. Occurrence 1_4:1799:794: scene=1_4
#: 1_4:1799
msgctxt "text_id=794 | speaker=unknown"
msgid "　眼下には三咲町の景観が広がっている。"
msgstr "  Below her, she could see the whole of Misaki."

#. Occurrence 1_4:1804:795: scene=1_4
#: 1_4:1804
msgctxt "text_id=795 | speaker=unknown"
msgid "　おもちゃの風景のように均整の取れた町並み。"
msgstr "  The symmetrical town looked like a miniature set from this height."

#. Occurrence 1_4:1809:796: scene=1_4
#: 1_4:1809
msgctxt "text_id=796 | speaker=unknown"
msgid "　これで近くに海でもあれば絵になるが、残念ながら三咲市は山中の町である。"
msgstr "  It would look like a painting if there had been a sea next to it, but unfortunately, Misaki City was very much landlocked."

#. Occurrence 1_4:1829:797: scene=1_4
#: 1_4:1829
msgctxt "text_id=797 | speaker=unknown"
msgid "　空はいまだ曇天だが、晴れた夕暮れ時、ここの風景は素晴らしいものになる。"
msgstr "  While it was overcast at the moment, the scene was quite breathtaking on clear evenings."

#. Occurrence 1_4:1834:798: scene=1_4
#: 1_4:1834
msgctxt "text_id=798 | speaker=unknown"
msgid "　それだけで坂道を上る苦労も報われるのだが、今日はその報酬の影すらなかった。"
msgstr "  The view was the one thing that made the arduous climb worthwhile, and today, she had been denied even that."

#. Occurrence 1_4:1875:799: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0010; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:1875
msgctxt "text_id=799 | speaker=aoko"
msgid "「……はあ。雨の日は自転車も使えないし。一日に二回ぐらいバスでも通ってくれないもんかな、ホント」"
msgstr "\"...Ugh. I'd cycle home if it wasn't for this rain. Even a bus route would be a fine thing.\""

#. Occurrence 1_4:1881:800: scene=1_4
#: 1_4:1881
msgctxt "text_id=800 | speaker=unknown"
msgid "　この坂道を通学路にしてじき二年になる青子だが、辛いものは辛いらしい。"
msgstr "  Aoko had been using this road to get to school for almost two years now, but the journey had never gotten easier."

#. Occurrence 1_4:1952:801: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0011; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:1952
msgctxt "text_id=801 | speaker=aoko"
msgid "「あれ、鍵<閉|し>まったまま？"
msgstr "\"Oh, it's locked?"

#. Occurrence 1_4:1958:802: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0012; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:1958
msgctxt "text_id=802 | speaker=aoko"
msgid "　……<有珠|ありす>、まだ帰ってきてないんだ」"
msgstr "  I guess Alice isn't back yet.\""

#. Occurrence 1_4:1964:803: scene=1_4
#: 1_4:1964
msgctxt "text_id=803 | speaker=unknown"
msgid "　青子はやれやれと肩をすくめて、古びた鉄柵に手をかける。"
msgstr "  With a weary shrug, she put her hand on the rusty iron fence."

#. Occurrence 1_4:1984:804: scene=1_4
#: 1_4:1984
msgctxt "text_id=804 | speaker=unknown"
msgid "　重苦しい鉄の門は静かに、この年若い少女を歓迎するように開いていった。"
msgstr "  Quietly, the heavy gate swung open as if to welcome her home."

#. Occurrence 1_4:2043:805: scene=1_4
#: 1_4:2043
msgctxt "text_id=805 | speaker=unknown"
msgid "　―――丘の上にはお化け屋敷が建っている。"
msgstr "  \"...There sits atop that hill a haunted house.\""

#. Occurrence 1_4:2079:806: scene=1_4
#: 1_4:2079
msgctxt "text_id=806 | speaker=unknown"
msgid "　それは三咲町に古くから伝わるむかし話。"
msgstr "  That is how the story much shared around town used to begin."

#. Occurrence 1_4:2084:807: scene=1_4
#: 1_4:2084
msgctxt "text_id=807 | speaker=unknown"
msgid "　そして町の近代化に合わせるよう、ひっそりと<蘇|よみがえ>った最新のうわさ話。"
msgstr "  But fresh rumors about the house had sprung to life almost as fast as the town's modernization:"

#. Occurrence 1_4:2142:808: scene=1_4
#: 1_4:2142
msgctxt "text_id=808 | speaker=unknown"
msgid "　たとえば、もう何年も前に朽ち果てた廃屋なのに、夜になると明かりが灯ったりする。"
msgstr "  Despite being dilapidated and abandoned for many years, lights can be seen inside the house at night..."

#. Occurrence 1_4:2148:809: scene=1_4
#: 1_4:2148
msgctxt "text_id=809 | speaker=unknown"
msgid "　たとえば、丘の上に無数のカラスが集まっては消えていく。"
msgstr "  An angry murder of crows often gathers atop the hill before mysteriously vanishing..."

#. Occurrence 1_4:2154:810: scene=1_4
#: 1_4:2154
msgctxt "text_id=810 | speaker=unknown"
msgid "　たとえば、霧が深い日は子供が迷いこんで神隠しにあう。"
msgstr "  Children get lost in the fog, never to be seen again..."

#. Occurrence 1_4:2174:811: scene=1_4
#: 1_4:2174
msgctxt "text_id=811 | speaker=unknown"
msgid "　たとえば、深夜、叫び声にしか聞こえない怪音が住宅地にまで響いてくる。……これは青子的に不名誉な噂なので改めたい。"
msgstr "  Late at night, a shrieking sound can be heard all the way to town-this particular piece of slander was the one Aoko wished to discredit the most."

#. Occurrence 1_4:2180:812: scene=1_4
#: 1_4:2180
msgctxt "text_id=812 | speaker=unknown"
msgid "　あと、たまに目を疑うような高級車が坂道を登っていく。"
msgstr "  The final rumor was of an eye-catching luxury car that sometimes made its way up and down the hill."

#. Occurrence 1_4:2245:813: scene=1_4
#: 1_4:2245
msgctxt "text_id=813 | speaker=unknown"
msgid "　噂話は日に日に種類を増していた。"
msgstr "  The rumors spread and grew by the day."

#. Occurrence 1_4:2250:814: scene=1_4
#: 1_4:2250
msgctxt "text_id=814 | speaker=unknown"
msgid "　そんな感じで、朽ちたはずの丘の上の洋館は、数年前から息を吹き返していた。"
msgstr "  And while they grew, the house that everyone thought had rotted away was restored over the recent years."

#. Occurrence 1_4:2255:815: scene=1_4
#: 1_4:2255
msgctxt "text_id=815 | speaker=unknown"
msgid "　人々の寄りつかない丘のただ中。"
msgstr "  Deep in a wood on top of a hill no one dared to approach,"

#. Occurrence 1_4:2260:816: scene=1_4
#: 1_4:2260
msgctxt "text_id=816 | speaker=unknown"
msgid "　昼なお暗い森に隠された廃墟。"
msgstr "  like a ruin, shrouded from view even on the brightest of days,"

#. Occurrence 1_4:2265:817: scene=1_4
#: 1_4:2265
msgctxt "text_id=817 | speaker=unknown"
msgid "　おとぎ話に出てきそうな、時代に取り残された魔法の<残|ざん><滓|し>。"
msgstr "  stood a relic out of time, a building from a fairy tale."

#. Occurrence 1_4:2270:818: scene=1_4
#: 1_4:2270
msgctxt "text_id=818 | speaker=unknown"
msgid "　それが、"
msgstr "  The house..."

#. Occurrence 1_4:2308:819: scene=1_4
#: 1_4:2308
msgctxt "text_id=819 | speaker=unknown"
msgid "　この<久遠寺|くおんじ>邸。"
msgstr "  ...was the Kuonji Mansion."

#. Occurrence 1_4:2313:820: scene=1_4
#: 1_4:2313
msgctxt "text_id=820 | speaker=unknown"
msgid "　三咲町の誰もが知っている、丘の上の魔女の家。"
msgstr "  Everyone in town knew about the witch's house on the hill."

#. Occurrence 1_4:2318:821: scene=1_4
#: 1_4:2318
msgctxt "text_id=821 | speaker=unknown"
msgid "　ワケあって蒼崎青子が下宿している、正真正銘の幽霊屋敷なのだった。"
msgstr "  It was an unabashedly haunted house where Aoko Aozaki resided, for reasons known only to her."

#. Occurrence 1_4:2338:822: scene=1_4
#: 1_4:2338
msgctxt "text_id=822 | speaker=unknown"
msgid "　言うまでもなく、幽霊屋敷というのは俗称である。"
msgstr "  Needless to say, it was not really haunted."

#. Occurrence 1_4:2343:823: scene=1_4
#: 1_4:2343
msgctxt "text_id=823 | speaker=unknown"
msgid "　久遠寺邸はとある経緯でイギリスから運ばれてきた、由緒正しい洋館だ。"
msgstr "  The Kuonji family home was a grand Western-style mansion with a long and storied history, stretching all the way back to England."

#. Occurrence 1_4:2363:824: scene=1_4
#: 1_4:2363
msgctxt "text_id=824 | speaker=unknown"
msgid "　寮にするほど広くはないけれど、家にするには広すぎる。"
msgstr "  It was too small to be a dormitory, yet too big to be called a house."

#. Occurrence 1_4:2368:825: scene=1_4
#: 1_4:2368
msgctxt "text_id=825 | speaker=unknown"
msgid "　普通の住宅が三つほど入りそうな本館と、ぐるりと囲む庭。"
msgstr "  The main building contained as many as three normal houses' worth of rooms and was surrounded by a large all-encompassing courtyard."

#. Occurrence 1_4:2373:826: scene=1_4
#: 1_4:2373
msgctxt "text_id=826 | speaker=unknown"
msgid "　庭の四方には鉄柵が高くそびえ、ご丁寧に<茨|いばら>めいた植物の<蔓|つる>まで絡み付いている。"
msgstr "  The perimeter of the grounds was surrounded by a high, iron fence covered in thorny vines."

#. Occurrence 1_4:2378:827: scene=1_4
#: 1_4:2378
msgctxt "text_id=827 | speaker=unknown"
msgid "　おまけに本館から離れた高台には別館まで完備している念の入れよう。"
msgstr "  There was also an annex to the main building."

#. Occurrence 1_4:2411:828: scene=1_4
#: 1_4:2411
msgctxt "text_id=828 | speaker=unknown"
msgid "　これだけ徹底していれば尾ひれがつくのは致し方ない。"
msgstr "  Given such extravagance, it was no wonder that it inspired rumors."

#. Occurrence 1_4:2416:829: scene=1_4
#: 1_4:2416
msgctxt "text_id=829 | speaker=unknown"
msgid "　町の住人からすれば、不自然に豪勢な館が丘の上に建っているだけで不気味だろうし。"
msgstr "  To the town residents, the mere existence of such a lavish and out-of-place mansion on top of the hill was a cause for suspicion."

#. Occurrence 1_4:2421:830: scene=1_4
#: 1_4:2421
msgctxt "text_id=830 | speaker=unknown"
msgid "　<誹謗|ひぼう><中傷|ちゅうしょう>、<誤解|ごかい><軋轢|あつれき>は有名税みたいなものだ。"
msgstr "  Rumors, lies, and slander were the prices to be paid for fame."

#. Occurrence 1_4:2426:831: scene=1_4
#: 1_4:2426
msgctxt "text_id=831 | speaker=unknown"
msgid "　しかも住んでいるのは二人だけなのだから、その住人は吸血鬼扱いされても文句は言えまい。"
msgstr "  With only two lodgers, it was hard to disagree with the perception that vampires must be living here."

#. Occurrence 1_4:2480:832: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_4_0013; voice_prefix=A10; voice_category=1; scene=1_4
#: 1_4:2480
msgctxt "text_id=832 | speaker=aoko"
msgid "「……まあ、私はともかく、有珠はそういうの、やりかねないし」"
msgstr "\"...Well, I know I'm not one, but Alice...\""

#. Occurrence 1_4:2502:833: scene=1_4
#: 1_4:2502
msgctxt "text_id=833 | speaker=unknown"
msgid "　玄関に手をかける。"
msgstr "  She put her hand on the front door."

#. Occurrence 1_4:2507:834: scene=1_4
#: 1_4:2507
msgctxt "text_id=834 | speaker=unknown"
msgid "　<真鍮|しんちゅう>の鍵が似合いそうな両開きの扉には、しかし、鍵穴などという不粋な物はない。"
msgstr "  It was a grand double door that would have paired well with a brass lock, and yet, it was secured with little more than a simple keyhole."

#. Occurrence 1_4:2524:835: scene=1_4
#: 1_4:2524
msgctxt "text_id=835 | speaker=unknown"
msgid "　青子は片手で扉を押し開き、幽霊屋敷と称される館の中へと入っていった。"
msgstr "  Pushing it open with one hand, she entered the supposedly haunted house."

#. Occurrence 1_4:2549:836: scene=1_4
#: 1_4:2549
msgctxt "text_id=836 | speaker=unknown"
msgid "　……ところで。"
msgstr "  ...And by the way..."

#. Occurrence 1_4:2554:837: scene=1_4
#: 1_4:2554
msgctxt "text_id=837 | speaker=unknown"
msgid "　吸血鬼云々はともかく、幽霊に関しては、状況次第で出ないコトもないという。"
msgstr "  If vampires were not enough to scare you, ghosts were known to appear on certain nights."

#. Occurrence 1_5:93:838: scene=1_5
#: 1_5:93
msgctxt "text_id=838 | speaker=unknown"
msgid "　外の天気同様、ロビーも灰色に曇っていた。"
msgstr "  Much like the weather outside, the foyer was overcast with shades of gray."

#. Occurrence 1_5:98:839: scene=1_5
#: 1_5:98
msgctxt "text_id=839 | speaker=unknown"
msgid "　設計者の趣向によるものか、このエントランスは電灯を可能なかぎり排除していた。"
msgstr "  Perhaps by deliberate design, the architect had chosen not to include any lights in the entrance area."

#. Occurrence 1_5:103:840: scene=1_5
#: 1_5:103
msgctxt "text_id=840 | speaker=unknown"
msgid "　天井は二階まで吹き抜け。"
msgstr "  The ceiling was two floors high."

#. Occurrence 1_5:108:841: scene=1_5
#: 1_5:108
msgctxt "text_id=841 | speaker=unknown"
msgid "　明かりになるのは、その高い天井にある窓から差しこむ日光と月光だけだ。"
msgstr "  The only light in the room came from the skylight."

#. Occurrence 1_5:128:842: scene=1_5
#: 1_5:128
msgctxt "text_id=842 | speaker=unknown"
msgid "　雨の日は夜明け前のように<仄|ほの>暗く、"
msgstr "  It was particularly gloomy on rainy days."

#. Occurrence 1_5:133:843: scene=1_5
#: 1_5:133
msgctxt "text_id=843 | speaker=unknown"
msgid "　月のない夜は冷たい暗黒星のように、あらゆるものが途絶えている。"
msgstr "  On moonless nights, it was like the world itself ceased to be."

#. Occurrence 1_5:153:844: scene=1_5
#: 1_5:153
msgctxt "text_id=844 | speaker=unknown"
msgid "　<憩|いこ>いの場となる居間はこのロビーのすぐ真東だが、その前に自分の部屋で着替えなくては落ち着かない、と青子は階段に足をかけた。"
msgstr "  Aoko decided the drawing room to the east would be a good place to rest, but knowing that she would not be able to relax until she changed clothes, she started up the stairs."

#. Occurrence 1_5:160:845: scene=1_5
#: 1_5:160
msgctxt "text_id=845 | speaker=unknown"
msgid "　壁に<沿|そ>った階段はいったん二階のホールで終わっている。"
msgstr "  The stairs curled up the wall to the second-floor hall."

#. Occurrence 1_5:165:846: scene=1_5
#: 1_5:165
msgctxt "text_id=846 | speaker=unknown"
msgid "　三階の屋根裏部屋まではホールの裏側にまわらなければならない。"
msgstr "  There was a third-floor attic as well, accessible from the far end of the hall."

#. Occurrence 1_5:170:847: scene=1_5
#: 1_5:170
msgctxt "text_id=847 | speaker=unknown"
msgid "　といっても、青子はこの二年間、屋根裏部屋を利用した事はないが。"
msgstr "  She had never set foot in there in the two years she had lived here, though."

#. Occurrence 1_5:200:848: scene=1_5
#: 1_5:200
msgctxt "text_id=848 | speaker=unknown"
msgid "　久遠寺邸は大まかに、東館と西館とに分かれている。"
msgstr "  The Kuonji mansion was more or less divided into two wings: east and west."

#. Occurrence 1_5:205:849: scene=1_5
#: 1_5:205
msgctxt "text_id=849 | speaker=unknown"
msgid "　青子に間借りが許されているのは館の東部分だけだが、それも二部屋で事足りる。"
msgstr "  Aoko had been given the entire east wing, but two rooms were more than enough as far as she was concerned."

#. Occurrence 1_5:210:850: scene=1_5
#: 1_5:210
msgctxt "text_id=850 | speaker=unknown"
msgid "　開けたとたん絵本の世界に閉じこめられるドアやら、過去五年間物置になっている屋根裏部屋など使うまでもない。"
msgstr "  She had no desire to open a door that would trap you in a storybook world or lead to an attic that had only been used for storage these last five years."

#. Occurrence 1_5:264:851: scene=1_5
#: 1_5:264
msgctxt "text_id=851 | speaker=unknown"
msgid "　東館の長廊下の奥が青子の部屋だ。"
msgstr "  Aoko's room was at the end of the east wing's long corridor."

#. Occurrence 1_5:269:852: scene=1_5
#: 1_5:269
msgctxt "text_id=852 | speaker=unknown"
msgid "　青子は下宿の際、そう広くない部屋を選んだ。遠慮しての事ではなく、単に掃除の手間を省いただけである。"
msgstr "  She had elected for a smaller room for no other reason other than that she thought it would be easier to clean."

#. Occurrence 1_5:274:853: scene=1_5
#: 1_5:274
msgctxt "text_id=853 | speaker=unknown"
msgid "　部屋には大きめのベッドと愛用のマホガニー製の机、洋服ダンスと上着が整列する収納ダンス、それに九段の本棚を二つほど。"
msgstr "  It was furnished with a large bed, her beloved mahogany desk, a wardrobe and chest for her clothes, and two nine-shelf bookcases."

#. Occurrence 1_5:294:854: scene=1_5
#: 1_5:294
msgctxt "text_id=854 | speaker=unknown"
msgid "　実家から運びこんだ荷物はそれだけ。"
msgstr "  That was the extent of what she'd brought from home."

#. Occurrence 1_5:302:855: scene=1_5
#: 1_5:302
msgctxt "text_id=855 | speaker=unknown"
msgid "　蒼崎青子が十六年<培|つちか>ってきた彼女の証明は、いざとなればその程度に短縮できてしまったらしい。"
msgstr "  Her entire life of sixteen years, reduced to this."

#. Occurrence 1_5:307:856: scene=1_5
#: 1_5:307
msgctxt "text_id=856 | speaker=unknown"
msgid "　あとは隣の部屋に、これからの自分用の部屋を借りておしまい。"
msgstr "  She'd also borrowed the next room down for her own purposes."

#. Occurrence 1_5:344:857: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0000; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:344
msgctxt "text_id=857 | speaker=aoko"
msgid "「―――そうだ。有珠にもらった見張り塔、壊れてないかチェックしないと」"
msgstr "\"Oh yeah. I should check on the watchtower I got from Alice.\""

#. Occurrence 1_5:399:858: scene=1_5
#: 1_5:399
msgctxt "text_id=858 | speaker=unknown"
msgid "　今朝方までの徹夜の成果を確かめる。"
msgstr "  She needed to see if the project she had been working on all night had borne fruit."

#. Occurrence 1_5:421:859: scene=1_5
#: 1_5:421
msgctxt "text_id=859 | speaker=unknown"
msgid "　壁一枚を隔てた書斎は、先ほどの蒼崎青子の生活とはまったく別の、まだ一年足らずの彼女の人生を示すものだ。"
msgstr "  The study next door served as proof of the life she had been living for the last year and how different that life was from the one she had lived before."

#. Occurrence 1_5:426:860: scene=1_5
#: 1_5:426
msgctxt "text_id=860 | speaker=unknown"
msgid "　それまでの彼女の為でなく、"
msgstr "  It was not a room for the person she had been."

#. Occurrence 1_5:431:861: scene=1_5
#: 1_5:431
msgctxt "text_id=861 | speaker=unknown"
msgid "　これからの彼女の証明になる、余人には立ち入れない独りの世界、の筈なのだが―――"
msgstr "  It was a room for the person she would eventually become. A place of solitude that only she could enter. Or so she thought..."

#. Occurrence 1_5:452:862: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0001; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:452
msgctxt "text_id=862 | speaker=aoko"
msgid "「うわ……壊れてるどころか、跡形もなく消え去ってる……やっぱ自己流アレンジはまだ早かったか……いいわよ。笑いなさいよ、コマドリ」"
msgstr "\"Wow. Not only did it break, it vanished without a trace... Looks like I've still got a long way to go... Go ahead, laugh it up, Robin.\""

#. Occurrence 1_5:467:863: scene=1_5
#: 1_5:467
msgctxt "text_id=863 | speaker=unknown"
msgid "　平気の平左でくつろいでいた<余人|コマドリ>が飛び去っていく。"
msgstr "  The nosy neighbor that had intruded upon her sanctuary flew away."

#. Occurrence 1_5:474:864: scene=1_5
#: 1_5:474
msgctxt "text_id=864 | speaker=unknown"
msgid "　才能は人並み、努力は惜しまず、失敗は恐れずに。"
msgstr "  While not exceptionally talented, Aoko did not lack for effort and was not afraid to fail."

#. Occurrence 1_5:479:865: scene=1_5
#: 1_5:479
msgctxt "text_id=865 | speaker=unknown"
msgid "　それは時に楽天的にさえ見える、青子の自由奔放さだった。"
msgstr "  One could have almost mistaken her approach for optimism."

#. Occurrence 1_5:606:866: scene=1_5
#: 1_5:606
msgctxt "text_id=866 | speaker=unknown"
msgid "　制服から普段着に着替えて一階に戻る。"
msgstr "  She changed out of her uniform and returned to the first floor."

#. Occurrence 1_5:674:867: scene=1_5
#: 1_5:674
msgctxt "text_id=867 | speaker=unknown"
msgid "　階段をおりて東側の扉を開けると、地下室のように暗い廊下が続いていた。"
msgstr "  Down the stairs, she opened the door to the east wing into the corridor as dark as a cellar."

#. Occurrence 1_5:682:868: scene=1_5
#: 1_5:682
msgctxt "text_id=868 | speaker=unknown"
msgid "　この廊下は外に面した窓がないだけに、電灯がなければ真っ暗だ。スイッチをいれて明かりをつけ、青子はすぐ近くの扉を開けた。"
msgstr "  The absence of windows meant it was pitch black without the lights on, so she flicked the switch and entered the nearby doorway."

#. Occurrence 1_5:753:869: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0002; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:753
msgctxt "text_id=869 | speaker=aoko"
msgid "「電気のない生活か……想像したくないな」"
msgstr "\"Life without electricity... I don't even want to imagine it.\""

#. Occurrence 1_5:759:870: scene=1_5
#: 1_5:759
msgctxt "text_id=870 | speaker=unknown"
msgid "　居間は彼女の趣向で現代ライクな造りに変更されている。"
msgstr "  It had been her idea to update the drawing room."

#. Occurrence 1_5:764:871: scene=1_5
#: 1_5:764
msgctxt "text_id=871 | speaker=unknown"
msgid "　<豪奢|ごうしゃ>な紋様の入った壁、"
msgstr "  The walls were decorated with extravagant patterns,"

#. Occurrence 1_5:769:872: scene=1_5
#: 1_5:769
msgctxt "text_id=872 | speaker=unknown"
msgid "　<威厳|いげん>に満ちた大きなソファー、"
msgstr "  and around the room were large, majestic sofas,"

#. Occurrence 1_5:774:873: scene=1_5
#: 1_5:774
msgctxt "text_id=873 | speaker=unknown"
msgid "　ペルシャ製の高級絨毯。"
msgstr "  and a luxurious Persian rug."

#. Occurrence 1_5:779:874: scene=1_5
#: 1_5:779
msgctxt "text_id=874 | speaker=unknown"
msgid "　城の一室めいた空間に、空気を読まず不釣り合いな30インチのテレビジョンが<鎮座|ちんざ>している。"
msgstr "  Amidst it all was a thirty-inch television that seemed completely out of place."

#. Occurrence 1_5:817:875: scene=1_5
#: 1_5:817
msgctxt "text_id=875 | speaker=unknown"
msgid "　テレビはハダカの王様のように、精一杯の虚勢を張ってソファーたちを従えていた。"
msgstr "  It stood looking over the other furniture like the emperor with no clothes."

#. Occurrence 1_5:822:876: scene=1_5
#: 1_5:822
msgctxt "text_id=876 | speaker=unknown"
msgid "　洋館の持ち主は嫌がったが、このとってつけた感こそ庶民である青子には必要不可欠な<憩|いこ>いである。"
msgstr "  The mansion's owner would have rather done without it, but to a commoner like Aoko it was an essential commodity."

#. Occurrence 1_5:827:877: scene=1_5
#: 1_5:827
msgctxt "text_id=877 | speaker=unknown"
msgid "　下宿を始めてすぐの頃、これで同居人と一戦争あったが、今ではお互い納得の文明機器になっている。"
msgstr "  They had fought over its presence at first, but eventually came to an agreement and now mutually enjoyed this modern comfort."

#. Occurrence 1_5:873:878: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0003; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:873
msgctxt "text_id=878 | speaker=aoko"
msgid "「……なんだ、人のことは言えないか。"
msgstr "\"Guess I'm one to talk."

#. Occurrence 1_5:873:879: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0003; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:873
msgctxt "text_id=879 | speaker=aoko"
msgid "　うちもあんがい、時代錯誤な家だった」"
msgstr "  I came from a pretty traditional household myself.\""

#. Occurrence 1_5:885:880: scene=1_5
#: 1_5:885
msgctxt "text_id=880 | speaker=unknown"
msgid "　なんとなく愉快な気持ちになって、青子はお茶にする事にした。"
msgstr "  Now in a somewhat pleasant mood, she decided to brew some tea."

#. Occurrence 1_5:902:881: scene=1_5
#: 1_5:902
msgctxt "text_id=881 | speaker=unknown"
msgid "　居間と壁一つでつながっている台所でお湯を沸かし、ティーポットと鍋を用意して、万全の準備で紅茶を淹れる。"
msgstr "  She boiled some water in the kitchen, prepared a teapot, and made herself some black tea."

#. Occurrence 1_5:964:882: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0004; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:964
msgctxt "text_id=882 | speaker=aoko"
msgid "「はーあ、っと」"
msgstr "\"Whew.\""

#. Occurrence 1_5:972:883: scene=1_5
#: 1_5:972
msgctxt "text_id=883 | speaker=unknown"
msgid "　ぼすん、とソファーに深々と沈みこむ。"
msgstr "  With a flop, she sank into the sofa."

#. Occurrence 1_5:1063:884: scene=1_5
#: 1_5:1063
msgctxt "text_id=884 | speaker=unknown"
msgid "　紅茶を一口、それから二口。"
msgstr "  She took a sip of her tea, then another."

#. Occurrence 1_5:1183:885: scene=1_5
#: 1_5:1183
msgctxt "text_id=885 | speaker=unknown"
msgid "　時計の針に耳を<傾|かたむ>けながら、ああ、今日は午後からどうしよう、とぼんやり思って三口目。"
msgstr "  Lulled by the ticking of the clock, she took a third sip as she pondered how to spend her afternoon."

#. Occurrence 1_5:1188:886: scene=1_5
#: 1_5:1188
msgctxt "text_id=886 | speaker=unknown"
msgid "　柔らかなソファーの感触に、どこまでも沈みこんでいきたい衝動にかられた頃。"
msgstr "  The sofa almost seemed to be inviting her, and she sunk even further into its comforting embrace."

#. Occurrence 1_5:1240:887: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0005; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1240
msgctxt "text_id=887 | speaker=aoko"
msgid "『――――――』"
msgstr "\"...\""

#. Occurrence 1_5:1246:888: scene=1_5
#: 1_5:1246
msgctxt "text_id=888 | speaker=unknown"
msgid "　青子は目をパチパチとまたたいて、クッションから体を起こした。"
msgstr "  Aoko blearily opened her eyes as she lifted her body up from the cushions."

#. Occurrence 1_5:1258:889: scene=1_5
#: 1_5:1258
msgctxt "text_id=889 | speaker=unknown"
msgid "　夢でも妄想でもない。"
msgstr "  This was no dream or delusion."

#. Occurrence 1_5:1263:890: scene=1_5
#: 1_5:1263
msgctxt "text_id=890 | speaker=unknown"
msgid "　いつのまにか、目の前にひとりの少女が座っている。"
msgstr "  At some point, a girl had sat down across from her."

#. Occurrence 1_5:1300:891: scene=1_5
#: 1_5:1300
msgctxt "text_id=891 | speaker=unknown"
msgid "　さして驚かず、青子はティーカップに指をあてた。"
msgstr "  Not the least bit surprised, she reached for her teacup."

#. Occurrence 1_5:1305:892: scene=1_5
#: 1_5:1305
msgctxt "text_id=892 | speaker=unknown"
msgid "　淹れたばかりの紅茶は完全に冷めきっている。"
msgstr "  But the tea within had gone completely cold."

#. Occurrence 1_5:1311:893: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0006; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1311
msgctxt "text_id=893 | speaker=aoko"
msgid "「寝てた？」"
msgstr "\"Did I doze off?\""

#. Occurrence 1_5:1316:894: scene=1_5
#: 1_5:1316
msgctxt "text_id=894 | speaker=unknown"
msgid "　テーブル向こうの少女に問いかける、青子の声。"
msgstr "  She asked the question to the girl on the other side of the table."

#. Occurrence 1_5:1322:895: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0000; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:1322
msgctxt "text_id=895 | speaker=alice"
msgid "「ええ」"
msgstr "\"Yes.\""

#. Occurrence 1_5:1327:896: scene=1_5
#: 1_5:1327
msgctxt "text_id=896 | speaker=unknown"
msgid "　少女は視線をあげず、関心なさげに答えた。"
msgstr "  The girl answered without lifting her gaze."

#. Occurrence 1_5:1362:897: scene=1_5
#: 1_5:1362
msgctxt "text_id=897 | speaker=unknown"
msgid "　―――声をあげなければ、あるいは、美しい人形と見間違えるだろう。"
msgstr "  When silent, she could have been mistaken for a beautiful doll."

#. Occurrence 1_5:1368:898: scene=1_5
#: 1_5:1368
msgctxt "text_id=898 | speaker=unknown"
msgid "　その少女はソファーに座り、古い本を読んでいる。"
msgstr "  The girl sitting on the opposite sofa was reading an old book."

#. Occurrence 1_5:1373:899: scene=1_5
#: 1_5:1373
msgctxt "text_id=899 | speaker=unknown"
msgid "　細い手足と陽の光を知らぬ白い肌。"
msgstr "  She had delicate limbs and pale white skin."

#. Occurrence 1_5:1378:900: scene=1_5
#: 1_5:1378
msgctxt "text_id=900 | speaker=unknown"
msgid "　愁いがちな趣きは、人間らしい意思を感じさせない。"
msgstr "  Not a hint of humanity emanated from her melancholic aura."

#. Occurrence 1_5:1398:901: scene=1_5
#: 1_5:1398
msgctxt "text_id=901 | speaker=unknown"
msgid "　青子より濃い、混じりけのない黒髪。"
msgstr "  She had darker hair than Aoko,"

#. Occurrence 1_5:1403:902: scene=1_5
#: 1_5:1403
msgctxt "text_id=902 | speaker=unknown"
msgid "　冷たい色をした瞳は、しずしずとページへ視線を落としている。"
msgstr "  and her icy eyes were focused on the pages in front of her."

#. Occurrence 1_5:1408:903: scene=1_5
#: 1_5:1408
msgctxt "text_id=903 | speaker=unknown"
msgid "　修道女を思わせる黒衣は彼女の通う女学院の制服だ。"
msgstr "  Her clothes resembled that of a nun but were actually her school uniform."

#. Occurrence 1_5:1413:904: scene=1_5
#: 1_5:1413
msgctxt "text_id=904 | speaker=unknown"
msgid "　その<翳|くら>さは少女によく似合っていたが、青子に言わせれば似合いすぎて良くないらしい。"
msgstr "  In Aoko's humble opinion, the gloominess suited her."

#. Occurrence 1_5:1433:905: scene=1_5
#: 1_5:1433
msgctxt "text_id=905 | speaker=unknown"
msgid "　……さながら一枚の風景画。"
msgstr "  She evoked something like out of a painting."

#. Occurrence 1_5:1438:906: scene=1_5
#: 1_5:1438
msgctxt "text_id=906 | speaker=unknown"
msgid "　初めからそういう形で生まれてきたとさえ思える現実感の無さ。"
msgstr "  There was something unreal about her, as if she were frozen in time."

#. Occurrence 1_5:1443:907: scene=1_5
#: 1_5:1443
msgctxt "text_id=907 | speaker=unknown"
msgid "　<俯|うつむ>く彼女の首の白さは、同性の青子でさえ見とれるほど美しい。"
msgstr "  The white of her gently arched neck was so lovely that even Aoko found herself enchanted by it."

#. Occurrence 1_5:1448:908: scene=1_5
#: 1_5:1448
msgctxt "text_id=908 | speaker=unknown"
msgid "　この少女こそ、幽霊屋敷に住む二人のうちの一人。"
msgstr "  The girl was one of the haunted house's two residents."

#. Occurrence 1_5:1453:909: scene=1_5
#: 1_5:1453
msgctxt "text_id=909 | speaker=unknown"
msgid "　<久遠寺|くおんじ><有珠|アリス>という名前の、青子と同い年の同居人。"
msgstr "  Her name was Alice Kuonji, and she was the same age as Aoko."

#. Occurrence 1_5:1499:910: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0007; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1499
msgctxt "text_id=910 | speaker=aoko"
msgid "「私、どれくらい寝てた？」"
msgstr "\"How long was I asleep?\""

#. Occurrence 1_5:1507:911: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0001; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:1507
msgctxt "text_id=911 | speaker=alice"
msgid "「一時間と少し。……ここで眠ると風邪、ひくわよ」"
msgstr "\"At least an hour. You'll catch a cold if you keep sleeping here.\""

#. Occurrence 1_5:1527:912: scene=1_5
#: 1_5:1527
msgctxt "text_id=912 | speaker=unknown"
msgid "　有珠は関心なく答えるが、いつもの事なので青子は気にしない。"
msgstr "  Alice answered indifferently. Not that it bothered Aoko, who was now used to it."

#. Occurrence 1_5:1532:913: scene=1_5
#: 1_5:1532
msgctxt "text_id=913 | speaker=unknown"
msgid "　柱時計を見てみると、針は午後七時を回っていた。"
msgstr "  She looked at the clock on the wall and saw that it was already seven."

#. Occurrence 1_5:1537:914: scene=1_5
#: 1_5:1537
msgctxt "text_id=914 | speaker=unknown"
msgid "　二時間ほど眠っていた事になる。"
msgstr "  She had been asleep for two hours."

#. Occurrence 1_5:1542:915: scene=1_5
#: 1_5:1542
msgctxt "text_id=915 | speaker=unknown"
msgid "　思い返せば散々な一日だった。徹夜明けで疲れた体が寝入ってしまったのも、無理のない話だろう。"
msgstr "  The day had been a rough one for her, and she had slept little the night before, so it was no surprise that she had dozed off for as long as she had."

#. Occurrence 1_5:1576:916: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0008; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1576
msgctxt "text_id=916 | speaker=aoko"
msgid "「起こしてくれても良かったのに。"
msgstr "\"You could have woken me up."

#. Occurrence 1_5:1582:917: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0009; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1582
msgctxt "text_id=917 | speaker=aoko"
msgid "　せっかくの紅茶が冷めちゃったじゃない」"
msgstr "  Now my tea is cold.\""

#. Occurrence 1_5:1591:918: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0002; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:1591
msgctxt "text_id=918 | speaker=alice"
msgid "「わたしが来た時は、もう冷めてたわ」"
msgstr "\"It was already cold by the time I got here.\""

#. Occurrence 1_5:1597:919: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0010; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1597
msgctxt "text_id=919 | speaker=aoko"
msgid "「でしょうね。言ってみただけよ」"
msgstr "\"I'm sure it was. I'm just saying...\""

#. Occurrence 1_5:1628:920: scene=1_5
#: 1_5:1628
msgctxt "text_id=920 | speaker=unknown"
msgid "　青子は冷めきった紅茶を一気に飲み下す。"
msgstr "  Aoko drank down the rest of the cold tea in one gulp."

#. Occurrence 1_5:1633:921: scene=1_5
#: 1_5:1633
msgctxt "text_id=921 | speaker=unknown"
msgid "　暖房の乏しい久遠寺邸では、その冷たさだけでも寝惚けた頭を目覚めさせるには十分だった。"
msgstr "  In the poorly-heated Kuonji mansion, that was more than enough to clear her head and wake up."

#. Occurrence 1_5:1655:922: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0011; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1655
msgctxt "text_id=922 | speaker=aoko"
msgid "「こうなるとフォートナム＆メイソンも何もないわね。"
msgstr "\"Nothing quite beats this tea, not even the expensive kind from Britain."

#. Occurrence 1_5:1687:923: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0012; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1687
msgctxt "text_id=923 | speaker=aoko"
msgid "　おかえり、有珠。たまの贅沢もアンタ抜きじゃ<締|し>まらないってコトかしら。"
msgstr "  Anyway, welcome home, Alice. The universe seems determined to keep me from even the occasional luxury without you."

#. Occurrence 1_5:1693:924: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0013; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1693
msgctxt "text_id=924 | speaker=aoko"
msgid "　今日は厄日か<天誅殺|てんちゅうさつ>か―――ちょっと早いけどお参りってのも十分アリかもね」"
msgstr "  Ugh, what is it about today? Is it just my luck, or what? At this rate I'm due a temple visit, just to be safe.\""

#. Occurrence 1_5:1698:925: scene=1_5
#: 1_5:1698
msgctxt "text_id=925 | speaker=unknown"
msgid "　毒食わば皿まで的な玉砕精神で、と肩をすくめる青子。"
msgstr "  Aoko shrugged her shoulders as if resigning herself to her fate."

#. Occurrence 1_5:1736:926: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0003; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:1736
msgctxt "text_id=926 | speaker=alice"
msgid "「それで、何があったの？」"
msgstr "\"Something happen?\""

#. Occurrence 1_5:1757:927: scene=1_5
#: 1_5:1757
msgctxt "text_id=927 | speaker=unknown"
msgid "　同居生活も二年近く続けば、お互いの様子に気が付くらしい。"
msgstr "  After two years together, they knew each other quite well."

#. Occurrence 1_5:1762:928: scene=1_5
#: 1_5:1762
msgctxt "text_id=928 | speaker=unknown"
msgid "　青子は青子なりの、"
msgstr "  Aoko had one way of asking questions,"

#. Occurrence 1_5:1767:929: scene=1_5
#: 1_5:1767
msgctxt "text_id=929 | speaker=unknown"
msgid "　有珠は有珠なりの問いかけをする。"
msgstr "  and Alice had another."

#. Occurrence 1_5:1772:930: scene=1_5
#: 1_5:1772
msgctxt "text_id=930 | speaker=unknown"
msgid "　顔もあげず問いかけてくる同居人に、青子はきっぱりと現状を報告した。"
msgstr "  Alice asked without raising her head, and Aoko gave her the details."

#. Occurrence 1_5:1804:931: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0014; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1804
msgctxt "text_id=931 | speaker=aoko"
msgid "「まず謝らなくちゃいけない。"
msgstr "\"I should start by apologizing."

#. Occurrence 1_5:1810:932: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0015; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1810
msgctxt "text_id=932 | speaker=aoko"
msgid "　昨日徹夜で完成させた例のアレ、意味がなくなっちゃったのよ。ちょっと目を離した隙に沸騰しすぎて壊れちゃったみたい。"
msgstr "  The project I was working on all night was a total failure. I only took my eyes off it for a second, but I think it boiled over and fell apart."

#. Occurrence 1_5:1817:933: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0016; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1817
msgctxt "text_id=933 | speaker=aoko"
msgid "そうならないよう、循環のコードを二、三本外したり<縫合|ほうごう>したりしたんだけど」"
msgstr "Though I'll add that I shuffled the circulation codes as a precaution.\""

#. Occurrence 1_5:1844:934: scene=1_5
#: 1_5:1844
msgctxt "text_id=934 | speaker=unknown"
msgid "　いやー、まいったね、と他人ごとのように青子は言った。"
msgstr "  Aoko tried to laugh it off as if it was someone else's problem."

#. Occurrence 1_5:1882:935: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0004; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:1882
msgctxt "text_id=935 | speaker=alice"
msgid "「……どういう事？」"
msgstr "\"...And?\""

#. Occurrence 1_5:1900:936: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0017; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1900
msgctxt "text_id=936 | speaker=aoko"
msgid "「<今|け><朝|さ>急用が入って、学校に呼び出しうけたの。"
msgstr "\"Something came up this morning, and I was called into school."

#. Occurrence 1_5:1900:937: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0017; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1900
msgctxt "text_id=937 | speaker=aoko"
msgid "　そこで転入生の世話を押しつけられて、一日が無残にも消費されちゃって、帰ってきたら跡形もなく消えてました。"
msgstr "  They made me show this transfer student around, and it took up my whole day. By the time I got back, it had vanished without a trace."

#. Occurrence 1_5:1906:938: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0018; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:1906
msgctxt "text_id=938 | speaker=aoko"
msgid "　怒る、有珠？」"
msgstr "  You're not mad, are you?\""

#. Occurrence 1_5:1947:939: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0005; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:1947
msgctxt "text_id=939 | speaker=alice"
msgid "「……別に。青子の器物破損にいちいち怒っていたら、一生分の口論をする事になるでしょう？"
msgstr "\"...Hardly. If I got mad every time you broke something, there would be no end to the fighting."

#. Occurrence 1_5:1953:940: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0006; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:1953
msgctxt "text_id=940 | speaker=alice"
msgid "　代用品はあるから、また一から始めればいいわ。"
msgstr "  I have more materials, so you can just start over."

#. Occurrence 1_5:1965:941: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0007; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:1965
msgctxt "text_id=941 | speaker=alice"
msgid "　それより―――怒ってるのは貴方の方じゃないの？」"
msgstr "  However, aren't you really the one who's angry?\""

#. Occurrence 1_5:2006:942: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0019; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2006
msgctxt "text_id=942 | speaker=aoko"
msgid "「……む」"
msgstr "\"...Hmph.\""

#. Occurrence 1_5:2012:943: scene=1_5
#: 1_5:2012
msgctxt "text_id=943 | speaker=unknown"
msgid "　今日はいつになく<鋭|するど>い。"
msgstr "  Alice was very much on point today."

#. Occurrence 1_5:2017:944: scene=1_5
#: 1_5:2017
msgctxt "text_id=944 | speaker=unknown"
msgid "　こういう時、涼しい顔をしてホントは怒っているのが青子なのだ。"
msgstr "  It was true that, despite outward appearances, Aoko was seething with frustration."

#. Occurrence 1_5:2022:945: scene=1_5
#: 1_5:2022
msgctxt "text_id=945 | speaker=unknown"
msgid "　それはともかく。"
msgstr "  That aside..."

#. Occurrence 1_5:2056:946: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0020; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2056
msgctxt "text_id=946 | speaker=aoko"
msgid "「ええ。この転入生っていうのがひどくズレててね。"
msgstr "\"True enough. The transfer student I mentioned earlier was a real piece of work."

#. Occurrence 1_5:2068:947: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0021; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2068
msgctxt "text_id=947 | speaker=aoko"
msgid "　すごい山奥で暮らしてたらしくて、こっちの常識が通じないんだから。<山門異界|さんもんいかい>って言葉があるけど、あれってホントの事なのね、有珠」"
msgstr "  He's been living deep in the mountains and has literally zero common sense. I know people say that the mountains are like an entirely different world, but I had no idea how true it was, Alice.\""

#. Occurrence 1_5:2090:948: scene=1_5
#: 1_5:2090
msgctxt "text_id=948 | speaker=unknown"
msgid "　名前を呼ばれて有珠は顔を上げた。"
msgstr "  Alice raised her head in response to hearing her name,"

#. Occurrence 1_5:2095:949: scene=1_5
#: 1_5:2095
msgctxt "text_id=949 | speaker=unknown"
msgid "　もともと有珠からの同情なんて期待していない青子は、さらに口調を速めて愚痴をこぼす。"
msgstr "  but Aoko kept going on before she could get a word in edgewise. Aoko, after all, expected no sympathy in the first place."

#. Occurrence 1_5:2130:950: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0022; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2130
msgctxt "text_id=950 | speaker=aoko"
msgid "「初対面から癪に障るヤツだったけど、教室を案内した時なんか失神しそうになったわ。"
msgstr "\"We didn't get along well from the start, but things really took a turn for the worse when I took him to a classroom."

#. Occurrence 1_5:2136:951: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0023; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2136
msgctxt "text_id=951 | speaker=aoko"
msgid "　そいつ、教室で教師と一対一で授業を受けるもんだと思ってたらしいの。……ええ、それはそれでまだ流せる。許容範囲よ、あの程度の冗談は」"
msgstr "  He apparently thought it was a place where you'd get one-on-one tutoring. And that's not all... I mean, you're never gonna believe this...\""

#. Occurrence 1_5:2165:952: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0024; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2165
msgctxt "text_id=952 | speaker=aoko"
msgid "「で、私が簡潔かつ丁寧に教室のなんたるかを教えた後で、そいつなんて言ったと思う？"
msgstr "\"What do you think he asked when I politely explained what a classroom is to him?"

#. Occurrence 1_5:2174:953: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0025; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2174
msgctxt "text_id=953 | speaker=aoko"
msgid "『それで蒼崎。他の教室は何に使うんだ？』"
msgstr "  He goes, 'but then what are the other classrooms for?'"

#. Occurrence 1_5:2186:954: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0026; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2186
msgctxt "text_id=954 | speaker=aoko"
msgid "　ですって！"
msgstr "  Unbelievable, right!?"

#. Occurrence 1_5:2192:955: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0027; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2192
msgctxt "text_id=955 | speaker=aoko"
msgid "　教室に他も何もないでしょう？」"
msgstr "  I mean, a classroom is a classroom!\""

#. Occurrence 1_5:2219:956: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0028; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2219
msgctxt "text_id=956 | speaker=aoko"
msgid "「なんていうか、そいつは少しでも説明を怠るとそのままで納得しちゃうのよ。"
msgstr "\"And no matter how vague or unhelpful anything I said was, he just kept nodding."

#. Occurrence 1_5:2225:957: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0029; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2225
msgctxt "text_id=957 | speaker=aoko"
msgid "　何も疑問に思わないというか、想像力が欠如してるっていうか、想像する事に慣れてないっていうか。"
msgstr "  It's like he was just taking everything at face value. I don't know if he just lacks an imagination or never uses it."

#. Occurrence 1_5:2245:958: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0030; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2245
msgctxt "text_id=958 | speaker=aoko"
msgid "　まあ……一度言った事はちゃんと分かってるっぽいから、馬鹿ってワケじゃないんだけど……」"
msgstr "  Anyway... he at least seemed to grasp most of what I told him the first time around, so I suppose he's not a complete idiot.\""

#. Occurrence 1_5:2270:959: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0008; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:2270
msgctxt "text_id=959 | speaker=alice"
msgid "「貴方が人を批評するのは珍しいわね。"
msgstr "\"It's rare to see you so judgmental."

#. Occurrence 1_5:2270:960: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0008; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:2270
msgctxt "text_id=960 | speaker=alice"
msgid "　……そういうダメな人、気にする<質|たち>だったの？」"
msgstr "  Is it really worth getting worked up over someone like that?\""

#. Occurrence 1_5:2279:961: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0031; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2279
msgctxt "text_id=961 | speaker=aoko"
msgid "「<微塵|みじん>たりとも気にしないわよ。けど、明日からどんな間違いをしでかすのかちょっと心配なだけ」"
msgstr "\"I couldn't care less about him. I'm just worried he'll screw up somehow.\""

#. Occurrence 1_5:2299:962: scene=1_5
#: 1_5:2299
msgctxt "text_id=962 | speaker=unknown"
msgid "　そう。心配なのは、その間違いの後始末が高い確率で自分に回ってくるからに違いない。"
msgstr "  What she was really worried about was having to clean up that mess if and when it happened."

#. Occurrence 1_5:2320:963: scene=1_5
#: 1_5:2320
msgctxt "text_id=963 | speaker=unknown"
msgid "　たぶん、そうだと思う。"
msgstr "  That had to be it."

#. Occurrence 1_5:2325:964: scene=1_5
#: 1_5:2325
msgctxt "text_id=964 | speaker=unknown"
msgid "　そうでもなければ、今日一日を潰してくれた転入生を気に病む理由が見当たらない。"
msgstr "  If not, it would mean she had no real idea why she could not get him out of his head."

#. Occurrence 1_5:2358:965: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0032; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2358
msgctxt "text_id=965 | speaker=aoko"
msgid "「とにかく変なヤツなの。案外有珠と気が合うかも」"
msgstr "\"Well, he was a weirdo all right. You two would probably hit it off great.\""

#. Occurrence 1_5:2376:966: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0009; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:2376
msgctxt "text_id=966 | speaker=alice"
msgid "「……山門異界はいい言葉ね」"
msgstr "\"Another world in the mountains doesn't sound so bad.\""

#. Occurrence 1_5:2393:967: scene=1_5
#: 1_5:2393
msgctxt "text_id=967 | speaker=unknown"
msgid "　けれど、その人物とは気が合う前に会う事もないでしょう、と視線だけで少女は語る。"
msgstr "  But from her eyes it was clear that the question of whether they would get along was irrelevant, given that they would never meet in the first place."

#. Occurrence 1_5:2398:968: scene=1_5
#: 1_5:2398
msgctxt "text_id=968 | speaker=unknown"
msgid "　それに青子はでしょうね、とだけ答えた。"
msgstr "  Aoko gave a noncommittal response."

#. Occurrence 1_5:2444:969: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0033; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2444
msgctxt "text_id=969 | speaker=aoko"
msgid "「ところで有珠、さっきからなに読んでるの？」"
msgstr "\"Anyway, what have you been reading?\""

#. Occurrence 1_5:2450:970: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0010; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:2450
msgctxt "text_id=970 | speaker=alice"
msgid "「霊的進化論の二次創作。スピリチュアル・ダイアリのまがい物」"
msgstr "\"A book about spiritual evolution based on The Spiritual Diary.\""

#. Occurrence 1_5:2468:971: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0034; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2468
msgctxt "text_id=971 | speaker=aoko"
msgid "「ああ、スウェーデンボリ。そんなの、いまさら読んでも仕方ないんじゃない？」"
msgstr "\"Ah, Swedenborg, huh? Is that really worth reading again?\""

#. Occurrence 1_5:2497:972: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0011; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:2497
msgctxt "text_id=972 | speaker=alice"
msgid "「真書なら退屈だけど、これは偽書だから。"
msgstr "\"I wouldn't bother if it were the original, but this is a knock-off."

#. Occurrence 1_5:2503:973: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0012; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:2503
msgctxt "text_id=973 | speaker=alice"
msgid "　彼の欠点と長所を劇的に誉めあげている。よくできた冒険小説のようよ。立ちはだかる秘密組織の名前がカントとか、気が利いているわ。"
msgstr "  It exaggerates the pros and cons of Swedenborg's style and reads like a well-written adventure. Having the secret organization Kant standing in his way was a nice addition."

#. Occurrence 1_5:2509:974: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0013; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:2509
msgctxt "text_id=974 | speaker=alice"
msgid "　……筆跡は、あなたのお祖父さんのものだけど」"
msgstr "  ...The handwriting of the notes in the margin belongs to your grandfather, by the way.\""

#. Occurrence 1_5:2540:975: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0035; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2540
msgctxt "text_id=975 | speaker=aoko"
msgid "「……へえ、あの人そういう趣味まであったんだ。"
msgstr "\"Huh, I had no idea he was into that sort of thing."

#. Occurrence 1_5:2540:976: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0035; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2540
msgctxt "text_id=976 | speaker=aoko"
msgid "　わりとユーモアがあったのね。惜しい人をなくしたわ」"
msgstr "  He had a great sense of humor. I really miss him.\""

#. Occurrence 1_5:2557:977: scene=1_5
#: 1_5:2557
msgctxt "text_id=977 | speaker=unknown"
msgid "　もうこの世にいない祖父を懐かしむように青子。"
msgstr "  Aoko seemed nostalgic over her now-deceased grandfather."

#. Occurrence 1_5:2580:978: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0014; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:2580
msgctxt "text_id=978 | speaker=alice"
msgid "「あなたのお祖父さん、夏に便りをくれたけど」"
msgstr "\"He just contacted you this last summer, didn't he?\""

#. Occurrence 1_5:2588:979: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0036; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2588
msgctxt "text_id=979 | speaker=aoko"
msgid "「よしてよ、死んだものと考えたいのに」"
msgstr "\"Do we really have to go there? Why can't dead stay dead?\""

#. Occurrence 1_5:2625:980: scene=1_5
#: 1_5:2625
msgctxt "text_id=980 | speaker=unknown"
msgid "　ふう、とため息をついて、青子はソファーに思いっきり寄り掛かった。"
msgstr "  Aoko sighed and laid back on the sofa."

#. Occurrence 1_5:2630:981: scene=1_5
#: 1_5:2630
msgctxt "text_id=981 | speaker=unknown"
msgid "　クッションにガタがきているのか、背もたれと一緒に青子は床に寝そべる形になる。"
msgstr "  The soft cushions caved in under her weight."

#. Occurrence 1_5:2660:982: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0015; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:2660
msgctxt "text_id=982 | speaker=alice"
msgid "「……話は戻るけど」"
msgstr "\"As I was saying...\""

#. Occurrence 1_5:2670:983: scene=1_5
#: 1_5:2670
msgctxt "text_id=983 | speaker=unknown"
msgid "　寝そべっている青子に、有珠はちらりと視線を投げた。"
msgstr "  Alice shot a glance at Aoko."

#. Occurrence 1_5:2675:984: scene=1_5
#: 1_5:2675
msgctxt "text_id=984 | speaker=unknown"
msgid "　ソファーに埋もれた青子の体は、横臥したまま死体のように動かない。"
msgstr "  Her body, buried in the sofa, remained as still as a corpse."

#. Occurrence 1_5:2695:985: scene=1_5
#: 1_5:2695
msgctxt "text_id=985 | speaker=unknown"
msgid "　ソファーに寝そべった青子の心境は、少し乾いていた。"
msgstr "  It was clear Aoko had tuned out of the conversation."

#. Occurrence 1_5:2715:986: scene=1_5
#: 1_5:2715
msgctxt "text_id=986 | speaker=unknown"
msgid "　有珠は無言で<青子|じぶん>を責めている。"
msgstr "  Alice silently chastised her with a look."

#. Occurrence 1_5:2720:987: scene=1_5
#: 1_5:2720
msgctxt "text_id=987 | speaker=unknown"
msgid "　それを思うと今日一日の新鮮な出来事も、次第に<瑞々|みずみず>しさを失っていく。"
msgstr "  The more she thought about it, the less important the events of the day seemed to become."

#. Occurrence 1_5:2753:988: scene=1_5
#: 1_5:2753
msgctxt "text_id=988 | speaker=unknown"
msgid "　……有珠の無言の責めを無視すれば、話はここで終わってくれる。"
msgstr "  If she just ignored Alice, the conversation would end there."

#. Occurrence 1_5:2758:989: scene=1_5
#: 1_5:2758
msgctxt "text_id=989 | speaker=unknown"
msgid "　ふたりはこのまま席を立ち、今日のミスをうやむやにしたまま明日を迎えられるだろう。"
msgstr "  They would eventually get up and leave today's mistake unresolved for another day."

#. Occurrence 1_5:2764:990: scene=1_5
#: 1_5:2764
msgctxt "text_id=990 | speaker=unknown"
msgid "　しかし。"
msgstr "  However..."

msgctxt "text_id=991 | speaker=unknown"
msgid "蒼崎青子は、そういう真似ができない人間だ。"
msgstr " That's not the kind of person Aoko Aozaki was."

#. Occurrence 1_5:2798:992: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0037; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2798
msgctxt "text_id=992 | speaker=aoko"
msgid "「いいわよ、なに？」"
msgstr "\"Yeah. What is it?\""

#. Occurrence 1_5:2803:993: scene=1_5
#: 1_5:2803
msgctxt "text_id=993 | speaker=unknown"
msgid "　青子は倒れこんだまま有珠に問う。"
msgstr "  She asked still lying down."

#. Occurrence 1_5:2811:994: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0016; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:2811
msgctxt "text_id=994 | speaker=alice"
msgid "「今日できなかったのは、少し痛いわね」"
msgstr "\"It's upsetting that you failed today.\""

#. Occurrence 1_5:2817:995: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0038; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2817
msgctxt "text_id=995 | speaker=aoko"
msgid "「だから反省してるって。"
msgstr "\"Like I said, I'm thinking about it."

#. Occurrence 1_5:2817:996: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0038; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2817
msgctxt "text_id=996 | speaker=aoko"
msgid "　学校優先は一人前になってから、でしょ」"
msgstr "  I need to focus on becoming a full-fledged mage before thinking about school, I know that.\""

#. Occurrence 1_5:2837:997: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0017; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:2837
msgctxt "text_id=997 | speaker=alice"
msgid "「なら、いいけど」"
msgstr "\"I hope you do.\""

#. Occurrence 1_5:2843:998: scene=1_5
#: 1_5:2843
msgctxt "text_id=998 | speaker=unknown"
msgid "　無機質な有珠の声に、青子はぎり、と歯を噛んだ。"
msgstr "  The coldness in her voice made Aoko gnash her teeth."

#. Occurrence 1_5:2876:999: scene=1_5
#: 1_5:2876
msgctxt "text_id=999 | speaker=unknown"
msgid "　彼女の言いたい事は分かっている。"
msgstr "  She knew what Alice wanted to say."

#. Occurrence 1_5:2892:1000: scene=1_5
#: 1_5:2892
msgctxt "text_id=1000 | speaker=unknown"
msgid "　なにより青子自身がよく分かっている。"
msgstr "  She knew better than anyone."

#. Occurrence 1_5:2907:1001: scene=1_5
#: 1_5:2907
msgctxt "text_id=1001 | speaker=unknown"
msgid "　学園生活の<外面|そとづら>と、今の生き方との折り合い。"
msgstr "  The veneer she wore for school was different than the way she lived at home."

#. Occurrence 1_5:2929:1002: scene=1_5
#: 1_5:2929
msgctxt "text_id=1002 | speaker=unknown"
msgid "　現代に隠れ住むというけれど、その隠れ方が半端だと有珠は言っている。"
msgstr "  While it could be called hiding in plain sight, Alice thought it was silly."

#. Occurrence 1_5:2946:1003: scene=1_5
#: 1_5:2946
msgctxt "text_id=1003 | speaker=unknown"
msgid "　つまり、彼女の沈黙が語るところは―――"
msgstr "  And what the silence told her was..."

#. Occurrence 1_5:2980:1004: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0039; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:2980
msgctxt "text_id=1004 | speaker=aoko"
msgid "『……覚悟を決めろって言いたいのよね、あんたは』"
msgstr "('Make up your mind already,' I know.)"

#. Occurrence 1_5:3001:1005: scene=1_5
#: 1_5:3001
msgctxt "text_id=1005 | speaker=unknown"
msgid "　今日の失敗はそれほど大きいものじゃない。"
msgstr "  Today's failure was not a colossal one."

#. Occurrence 1_5:3006:1006: scene=1_5
#: 1_5:3006
msgctxt "text_id=1006 | speaker=unknown"
msgid "　この洋館と学園生活を秤にかけて、たまたま学園に重きをおいてミスをしただけの、小さな事件だ。"
msgstr "  She'd just happened to upset the delicate balance between her home and school lives, chasing one at the expense of the other."

#. Occurrence 1_5:3011:1007: scene=1_5
#: 1_5:3011
msgctxt "text_id=1007 | speaker=unknown"
msgid "　ただ、今の青子の半端さを象徴する、分かりやすい心の甘さであっただけ。"
msgstr "  And yet, that careless mistake was a clear sign of Aoko's lack of commitment."

#. Occurrence 1_5:3049:1008: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0040; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:3049
msgctxt "text_id=1008 | speaker=aoko"
msgid "『……有珠は関係ない。"
msgstr "(This doesn't concern Alice."

#. Occurrence 1_5:3049:1009: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0040; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:3049
msgctxt "text_id=1009 | speaker=aoko"
msgid "　これは、私が私で決めなくちゃいけない事……』"
msgstr "  It's my decision to make.)"

#. Occurrence 1_5:3096:1010: scene=1_5
#: 1_5:3096
msgctxt "text_id=1010 | speaker=unknown"
msgid "　基礎はたった一年と半年。"
msgstr "  She had only known for sure for the last year and a half."

#. Occurrence 1_5:3101:1011: scene=1_5
#: 1_5:3101
msgctxt "text_id=1011 | speaker=unknown"
msgid "　けれど予感は物心がついた時からあった。"
msgstr "  But she'd had a hunch for as long as she could remember:"

#. Occurrence 1_5:3107:1012: scene=1_5
#: 1_5:3107
msgctxt "text_id=1012 | speaker=unknown"
msgid "“選んだのなら、いつか必ずその日は来る”、と。"
msgstr "\"Make the choice, and the day will come.\""

#. Occurrence 1_5:3113:1013: scene=1_5
#: 1_5:3113
msgctxt "text_id=1013 | speaker=unknown"
msgid "　なら自分の良心も道徳も、いいかげん根負けしている頃だ。"
msgstr "  It was little wonder that her morals and conscience had been stripped away."

#. Occurrence 1_5:3121:1014: scene=1_5
#: 1_5:3121
msgctxt "text_id=1014 | speaker=unknown"
msgid "　よし、と青子は勢いよく体を起こす。"
msgstr "  Aoko pushed herself back up."

#. Occurrence 1_5:3126:1015: scene=1_5
#: 1_5:3126
msgctxt "text_id=1015 | speaker=unknown"
msgid "　起きた先には、無言で視線を向ける有珠のか細い美貌だけがあった。"
msgstr "  She was met by Alice's cold beauty and wordless gaze."

#. Occurrence 1_5:3162:1016: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0041; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:3162
msgctxt "text_id=1016 | speaker=aoko"
msgid "「オッケー、有珠。来週中に決着をつけよう。"
msgstr "\"Okay, Alice. We can do it next week."

#. Occurrence 1_5:3168:1017: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0042; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:3168
msgctxt "text_id=1017 | speaker=aoko"
msgid "　それでいいんでしょ？」"
msgstr "  That work for you?\""

#. Occurrence 1_5:3187:1018: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0018; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:3187
msgctxt "text_id=1018 | speaker=alice"
msgid "「ええ。青子がいいなら」"
msgstr "\"As long as it works for you.\""

#. Occurrence 1_5:3204:1019: scene=1_5
#: 1_5:3204
msgctxt "text_id=1019 | speaker=unknown"
msgid "　それと似たような言葉をつい数時間前に聞いた気がして、ブンブンと頭を振る。"
msgstr "  Aoko could not help but shake her head, feeling like she was hearing something similar for the second time that day."

#. Occurrence 1_5:3233:1020: scene=1_5
#: 1_5:3233
msgctxt "text_id=1020 | speaker=unknown"
msgid "　なんだって帰ってきてまで、あんな田舎者を思い出さなくちゃいけないのか。"
msgstr "  Even in the comfort of her own, she couldn't banish thoughts of that country boy from her mind."

#. Occurrence 1_5:3270:1021: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0043; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:3270
msgctxt "text_id=1021 | speaker=aoko"
msgid "「じゃあ下準備はよろしくね。私まだ出来ないし」"
msgstr "\"I'll let you set it up, then. That's still beyond my abilities.\""

#. Occurrence 1_5:3284:1022: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0019; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:3284
msgctxt "text_id=1022 | speaker=alice"
msgid "「場所は例の公園でいい？」"
msgstr "\"Should we do it at that park?\""

#. Occurrence 1_5:3315:1023: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0044; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:3315
msgctxt "text_id=1023 | speaker=aoko"
msgid "「妥当な線ね。あ、でももう一件の方は？"
msgstr "\"Sure. The line there is suitable enough. But what about that other thing?"

#. Occurrence 1_5:3321:1024: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0045; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:3321
msgctxt "text_id=1024 | speaker=aoko"
msgid "　そっちの方が急務じゃない？」"
msgstr "  Isn't that a more urgent concern?\""

#. Occurrence 1_5:3337:1025: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0020; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:3337
msgctxt "text_id=1025 | speaker=alice"
msgid "「時と場合。森に変化があれば教えるわ」"
msgstr "\"It depends on the conditions. I'll let you know if there are any changes to the woods.\""

#. Occurrence 1_5:3364:1026: scene=1_5
#: 1_5:3364
msgctxt "text_id=1026 | speaker=unknown"
msgid "　そんな短いやりとりが終わると、有珠は膝に置いた本へと顔を落とした。"
msgstr "  After that brief exchange, Alice returned her attention to the book on her lap."

#. Occurrence 1_5:3371:1027: scene=1_5
#: 1_5:3371
msgctxt "text_id=1027 | speaker=unknown"
msgid "　両者にとって最も重要な話は終わった。"
msgstr "  Shop talk was over."

#. Occurrence 1_5:3376:1028: scene=1_5
#: 1_5:3376
msgctxt "text_id=1028 | speaker=unknown"
msgid "　あとは普段通りの、それとなく気が合う同居人に戻るだけである。"
msgstr "  Now, they could return to their normal relationship as roommates."

#. Occurrence 1_5:3400:1029: scene=1_5
#: 1_5:3400
msgctxt "text_id=1029 | speaker=unknown"
msgid "　さて、とばかりに青子はテレビのリモコンを取って電源を入れた。有珠が読書しているので、自分はブラウン管に映る<出来事|バラエティー>に途中参加しようとし、"
msgstr "  Aoko grabbed the remote and turned on the TV. Since Alice was busy reading, Aoko decided to tune in to a variety show that had already started."

#. Occurrence 1_5:3447:1030: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0021; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:3447
msgctxt "text_id=1030 | speaker=alice"
msgid "「あ」"
msgstr "\"Ahh-\""

#. Occurrence 1_5:3482:1031: scene=1_5
#: 1_5:3482
msgctxt "text_id=1031 | speaker=unknown"
msgid "　突然、有珠がそんな声を上げて、消した。"
msgstr "  Alice started to speak but suddenly cut herself off."

#. Occurrence 1_5:3509:1032: scene=1_5
#: 1_5:3509
msgctxt "text_id=1032 | speaker=unknown"
msgid "　見れば片手で口を押さえている。"
msgstr "  One of her delicate hands raised to her mouth."

#. Occurrence 1_5:3514:1033: scene=1_5
#: 1_5:3514
msgctxt "text_id=1033 | speaker=unknown"
msgid "　何かを話そうとして、それが意味の無い話だと気付くと彼女はすぐに口を閉ざしてしまう。"
msgstr "  She would always cut herself off the second she realized she was about to say something trivial."

#. Occurrence 1_5:3545:1034: scene=1_5
#: 1_5:3545
msgctxt "text_id=1034 | speaker=unknown"
msgid "　時々その自制が間に合わなくて、今のような仕草をする事が<希|まれ>にある。"
msgstr "  Sometimes, her self-restraint would hit too late, and she would make a gesture like the one she was making now."

#. Occurrence 1_5:3550:1035: scene=1_5
#: 1_5:3550
msgctxt "text_id=1035 | speaker=unknown"
msgid "　たしか、前は『な』だったな、と思い返しながら、青子は可憐な同居人に視線を向けた。"
msgstr "  It occurred to Aoko that the \"ah\" sound her cute little roommate made just now was different than the \"wha\" she blurted in times past."

#. Occurrence 1_5:3628:1036: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0046; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:3628
msgctxt "text_id=1036 | speaker=aoko"
msgid "「ん、なに？」"
msgstr "\"Hm? What is it?\""

#. Occurrence 1_5:3633:1037: scene=1_5
#: 1_5:3633
msgctxt "text_id=1037 | speaker=unknown"
msgid "　テレビの音量を下げる青子。意志の強い目が、猫のようにいたずらっぽい光を放っていた。"
msgstr "  Aoko turned down the volume on the TV, her intense eyes lit up like those of a mischievous cat."

#. Occurrence 1_5:3639:1038: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0022; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:3639
msgctxt "text_id=1038 | speaker=alice"
msgid "「……どうという事はないんだけど」"
msgstr "\"It's nothing really, but...\""

#. Occurrence 1_5:3704:1039: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0047; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:3704
msgctxt "text_id=1039 | speaker=aoko"
msgid "「ないんだけど？」"
msgstr "\"But what?\""

#. Occurrence 1_5:3750:1040: scene=1_5
#: 1_5:3750
msgctxt "text_id=1040 | speaker=unknown"
msgid "　有珠は言おうか言うまいか迷っていて、恥ずかしそうにそっぽを向いている。"
msgstr "  Alice looked away bashfully, not knowing if she should bring it up or not."

#. Occurrence 1_5:3755:1041: scene=1_5
#: 1_5:3755
msgctxt "text_id=1041 | speaker=unknown"
msgid "　こういった時の彼女の表情は温かみがあって、なんだか歯痒いぐらい好感が持てた。"
msgstr "  It was times like these that her expression carried a real warmth and surprising charm."

#. Occurrence 1_5:3760:1042: scene=1_5
#: 1_5:3760
msgctxt "text_id=1042 | speaker=unknown"
msgid "　たぶん今の有珠を見れば彼女の父親も、その名前がぴったり似合っていたと思えるだろうに。"
msgstr "  If he could see her in this moment, Alice's father would have to admit that her name suited her perfectly."

#. Occurrence 1_5:3785:1043: scene=1_5
#: 1_5:3785
msgctxt "text_id=1043 | speaker=unknown"
msgid "「……"
msgstr "\"..."

#. Occurrence 1_5:3792:1044: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0023; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:3792
msgctxt "text_id=1044 | speaker=alice"
msgid "今日、帰ってくる時おかしな物を見て、誰かに話そうと思っていたんだけど……」"
msgstr "It's just that I saw something strange on my way home and wanted to tell someone about it.\""

#. Occurrence 1_5:3798:1045: scene=1_5
#: 1_5:3798
msgctxt "text_id=1045 | speaker=unknown"
msgid "　青子はうん、と頷いて先を促す。"
msgstr "  Aoko nodded, beckoning her to continue."

#. Occurrence 1_5:3840:1046: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0024; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:3840
msgctxt "text_id=1046 | speaker=alice"
msgid "「つまらない、本当に意味のないコトよ。"
msgstr "\"It's silly, really."

#. Occurrence 1_5:3846:1047: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0025; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:3846
msgctxt "text_id=1047 | speaker=alice"
msgid "　けど、どう考えてもそんな事をする理由が分からない。"
msgstr "  But I just can't make sense of it no matter how much I think about it."

#. Occurrence 1_5:3852:1048: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0026; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:3852
msgctxt "text_id=1048 | speaker=alice"
msgid "　……青子、人間ぐらいの大きな猫が、ひょこひょこ出前をする理由って、分かる？」"
msgstr "  Aoko... Do you have any idea why a man-sized cat... would be riding around town... delivering meals to people?\""

#. Occurrence 1_5:3885:1049: scene=1_5
#: 1_5:3885
msgctxt "text_id=1049 | speaker=unknown"
msgid "　一瞬、青子はまた、有珠の冗談になっていない冗談のたぐいだと思った。"
msgstr "  For a second, Aoko thought Alice was trying and failing miserably to make a joke again."

#. Occurrence 1_5:3890:1050: scene=1_5
#: 1_5:3890
msgctxt "text_id=1050 | speaker=unknown"
msgid "　いや、普通は思う。"
msgstr "  One would think that about anyone, really."

#. Occurrence 1_5:3895:1051: scene=1_5
#: 1_5:3895
msgctxt "text_id=1051 | speaker=unknown"
msgid "　けれど有珠は真剣に悩んでいる。"
msgstr "  But she seemed completely serious."

#. Occurrence 1_5:3900:1052: scene=1_5
#: 1_5:3900
msgctxt "text_id=1052 | speaker=unknown"
msgid "　有珠のユーモアセンスに零点をつけたのは青子だが、これは零点にしてはわりとロマンがあるので、やっぱり有珠は見たままの事を話しているらしい。"
msgstr "  Even if Alice's sense of humor fell flat for Aoko, this story already sounded more fanciful than Alice's usual attempt at jokes. Aoko concluded that her roommate was talking about something she had actually seen."

#. Occurrence 1_5:3937:1053: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0048; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:3937
msgctxt "text_id=1053 | speaker=aoko"
msgid "「んー……その話にはふたつぐらい信じがたい部分があるけど、ひとつずつ論破していい……？」"
msgstr "\"Hmm. There are a few things off about that. Maybe we should break it down.\""

#. Occurrence 1_5:3943:1054: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0027; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:3943
msgctxt "text_id=1054 | speaker=alice"
msgid "「いいの。わたしもカラクリぐらいは思いつくから。"
msgstr "\"Let's not. Even I can think of a few mundane explanations."

#. Occurrence 1_5:3949:1055: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0028; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:3949
msgctxt "text_id=1055 | speaker=alice"
msgid "　ただ、理由が分からないから聞いてるの。"
msgstr "  I'm just asking because I can't figure out why somebody would do that."

#. Occurrence 1_5:3949:1056: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0028; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:3949
msgctxt "text_id=1056 | speaker=alice"
msgid "　わざわざ精巧な猫のぬいぐるみを着て、出前の<店屋物|てんやもの>を届けに行く事って、そんなに簡単かしらね」"
msgstr "  Maybe it's as simple as someone just dressing up in a finely-crafted cat suit to deliver food for a restaurant?\""

#. Occurrence 1_5:3982:1057: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0049; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:3982
msgctxt "text_id=1057 | speaker=aoko"
msgid "「難易度以前に、それをやる人間の常識性を疑うけどね、私は」"
msgstr "\"I'm more worried about the person doing it than their reasons, personally.\""

#. Occurrence 1_5:3988:1058: scene=1_5
#: 1_5:3988
msgctxt "text_id=1058 | speaker=unknown"
msgid "　青子の言葉に、有珠も少し頷く。"
msgstr "  Alice nodded tentatively at her words."

#. Occurrence 1_5:4009:1059: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0050; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4009
msgctxt "text_id=1059 | speaker=aoko"
msgid "「まあ、世の中色々あるから。私達みたいのもいれば、外界から遮断された山奥で暮らしていた奴まで十人十色よ。"
msgstr "\"But whatever does it for them, I guess. In a world with people like us and weirdos that live like mountain hermits, there's no telling what kinds of freaks are out there."

#. Occurrence 1_5:4015:1060: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0051; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4015
msgctxt "text_id=1060 | speaker=aoko"
msgid "　私だったら、見かけたら声かけて理由を<訊|たず>ねただろうけど」"
msgstr "  I personally would have just gone up to them and asked them what they were doing.\""

#. Occurrence 1_5:4041:1061: scene=1_5
#: 1_5:4041
msgctxt "text_id=1061 | speaker=unknown"
msgid "　その言葉に、有珠は少しだけ顔を背けた。"
msgstr "  Alice's gaze drifted at that."

#. Occurrence 1_5:4080:1062: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0052; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4080
msgctxt "text_id=1062 | speaker=aoko"
msgid "「……ふーん……暮れゆく住宅街にさまよう<出前猫|でまえねこ>かあ……背景が夕焼けだったらファンタジーだったでしょうに。"
msgstr "\"Hmm... A delivery cat riding through neighborhoods in the evening. Sounds like something straight out of a fantasy story."

#. Occurrence 1_5:4086:1063: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0053; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4086
msgctxt "text_id=1063 | speaker=aoko"
msgid "　……で、今日の夕飯どうする？"
msgstr "  ...Hey, what should we do for dinner tonight?"

#. Occurrence 1_5:4086:1064: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0053; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4086
msgctxt "text_id=1064 | speaker=aoko"
msgid "　せっかく話が出たし、私らも<店屋物|てんやもの>にしようか？」"
msgstr "  Speaking of delivery, maybe we should order in.\""

#. Occurrence 1_5:4119:1065: scene=1_5
#: 1_5:4119
msgctxt "text_id=1065 | speaker=unknown"
msgid "　出前好きな青子は嬉々として言う。"
msgstr "  Aoko loved getting takeout, and her faced glowed as she spoke."

#. Occurrence 1_5:4124:1066: scene=1_5
#: 1_5:4124
msgctxt "text_id=1066 | speaker=unknown"
msgid "　この館において夕食は当番制でもなんでもなく、気が向いたほうが二人分用意する、という実にアバウトな方式が採用されていた。"
msgstr "  They had no hard rules for dinner, but if one of them was in the mood to cook, they made it a point to make enough for two."

#. Occurrence 1_5:4129:1067: scene=1_5
#: 1_5:4129
msgctxt "text_id=1067 | speaker=unknown"
msgid "　下手をすると一週間夕飯なしが続くという展開もあるが、ふたりにとってはこれが一番居心地が良いのだ。"
msgstr "  At the very worst, this meant entire weeks without dinner, but the two of them agreed that this was the system that worked best for them."

#. Occurrence 1_5:4161:1068: scene=1_5
#: 1_5:4161
msgctxt "text_id=1068 | speaker=unknown"
msgid "　調理の手間を惜しんでか、それとも単純に出前が好きなのか。"
msgstr "  Whether they found cooking to be too much effort or simply liked ordering out..."

#. Occurrence 1_5:4166:1069: scene=1_5
#: 1_5:4166
msgctxt "text_id=1069 | speaker=unknown"
msgid "　今夜のような展開は珍しくもなく、結果、三咲町の食事処からこの館は要注意扱いされていた。"
msgstr "  Nights like this one were a common occurrence, much to the chagrin of the restaurants of Misaki Town."

#. Occurrence 1_5:4171:1070: scene=1_5
#: 1_5:4171
msgctxt "text_id=1070 | speaker=unknown"
msgid "　決まって夜遅く……人気も絶えた夜八時過ぎ……に、こんな坂の上まで来いというのだから、彼らの憂鬱も当然である。"
msgstr "  Delivering to the mansion meant coming all the way up to the top of this hill, the source of their disgruntlement."

#. Occurrence 1_5:4192:1071: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0054; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4192
msgctxt "text_id=1071 | speaker=aoko"
msgid "「時間は八時前、ぎりぎりセーフね。私<昏月|こんげつ>がいいな。あそこの月見そば、最近ご無沙汰だったし」"
msgstr "\"It's still before eight, so we're good. I'm really in the mood for Kongetsu tonight. I haven't had their tsukimi soba in ages.\""

#. Occurrence 1_5:4201:1072: scene=1_5
#: 1_5:4201
msgctxt "text_id=1072 | speaker=unknown"
msgid "　ポーカーのカードのように並べられた店々のお品書きを取り出し、まだ見ぬ夕食にご満悦の生徒会長。"
msgstr "  The hungry student council president laid out a stack of take-out menus like she might fan a deck of cards, and excitedly scanned for anything that stood out."

#. Occurrence 1_5:4207:1073: scene=1_5
#: 1_5:4207
msgctxt "text_id=1073 | speaker=unknown"
msgid "そんな、幸せそうな青子を一目も見ずに、有珠はさらりと返答する。"
msgstr "Alice casually responded without sparing so much as a glance."

#. Occurrence 1_5:4226:1074: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0029; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:4226
msgctxt "text_id=1074 | speaker=alice"
msgid "「悪いけど、わたし夕飯済んでるの」"
msgstr "\"Sorry, but I've already had dinner.\""

#. Occurrence 1_5:4273:1075: scene=1_5
#: 1_5:4273
msgctxt "text_id=1075 | speaker=unknown"
msgid "　その言葉で青子の体は凍りついた。"
msgstr "  With those words, Aoko froze."

#. Occurrence 1_5:4278:1076: scene=1_5
#: 1_5:4278
msgctxt "text_id=1076 | speaker=unknown"
msgid "　出前物は最低二品、つまり共同者がいなければ運ばれないのだ。"
msgstr "  All deliveries required a minimum of two items, so she was out of luck without an accomplice."

#. Occurrence 1_5:4283:1077: scene=1_5
#: 1_5:4283
msgctxt "text_id=1077 | speaker=unknown"
msgid "　たった一品の蕎麦で人を呼びつけるようなお姫さまに、世間は果てしなく冷たい。"
msgstr "  Cruel society had decided it couldn't be bothered to deliver to a princess who only ordered a single serving of food."

#. Occurrence 1_5:4318:1078: scene=1_5
#: 1_5:4318
msgctxt "text_id=1078 | speaker=unknown"
msgid "　余談だが、実は坂の上対策として"
msgstr "  Incidentally, to counteract orders from the hilltop mansion, the restaurants had declared,"

#. Occurrence 1_5:4324:1079: scene=1_5
#: 1_5:4324
msgctxt "text_id=1079 | speaker=unknown"
msgid "『来年から三品以上の注文のみ出前アリとする』"
msgstr "\"The minimum number of orders will be three, starting next year.\""

#. Occurrence 1_5:4330:1080: scene=1_5
#: 1_5:4330
msgctxt "text_id=1080 | speaker=unknown"
msgid "　なんて魔のルールが可決されつつある事を、青子たちはまだ知らない。"
msgstr "  Aoko and Alice were still in the dark to this fiendish change in direction."

#. Occurrence 1_5:4365:1081: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0055; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4365
msgctxt "text_id=1081 | speaker=aoko"
msgid "「こ、この裏切り者…！"
msgstr "\"T-traitor!"

#. Occurrence 1_5:4383:1082: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0056; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4383
msgctxt "text_id=1082 | speaker=aoko"
msgid "　ふん、だから帰ってくるのが遅かったのね!?"
msgstr "  Is that why you were late getting back!?"

#. Occurrence 1_5:4389:1083: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0057; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4389
msgctxt "text_id=1083 | speaker=aoko"
msgid "　帰宅部、学校までバス・徒歩込みで片道二十分のあんたが、なんで五時以降に帰ってくんのか考えるべきだったわ！」"
msgstr "  Between the bus ride and the walk, the trip home takes only twenty minutes! I should have known something was up when you didn't get home before five o'clock!\""

#. Occurrence 1_5:4395:1084: scene=1_5
#: 1_5:4395
msgctxt "text_id=1084 | speaker=unknown"
msgid "　しかし悲しいかな、その時の青子は自分が眠った事にも気付かないほど寝惚けていたのだった。"
msgstr "  Unfortunately for Aoko, she had been too out of it to even remember that she was the one who'd fallen asleep."

#. Occurrence 1_5:4422:1085: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0058; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4422
msgctxt "text_id=1085 | speaker=aoko"
msgid "「あーあ、ひどい女。そういう時は残されたひとりのためにお土産買ってくるのが暗黙の了解だったのに。"
msgstr "\"Talk about ice queen-I thought it was clear that if either of us got food, we would bring enough home for the other person!"

#. Occurrence 1_5:4428:1086: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0059; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4428
msgctxt "text_id=1086 | speaker=aoko"
msgid "　私だって、この前の外食の時は有珠の分も買ってきたじゃない」"
msgstr "  Didn't I bring back something for you when I ate out last time!?\""

#. Occurrence 1_5:4472:1087: scene=1_5
#: 1_5:4472
msgctxt "text_id=1087 | speaker=unknown"
msgid "　どこまで本気なのか不明なのだけれど、青子はそれなりに怒っている。"
msgstr "  It was unknown how serious Aoko was being, but she was visibly angry."

#. Occurrence 1_5:4477:1088: scene=1_5
#: 1_5:4477
msgctxt "text_id=1088 | speaker=unknown"
msgid "　なにしろ朝は空腹で目が覚め、電話で呼び出されて以来、紅茶しか口にしていない。これでお<腹|なか>が鳴らないのは奇跡に近かった。"
msgstr "  She had already woken up hungry that morning, and from the time she was called into school until now, she had consumed nothing but tea. It was a small miracle that her stomach was not growling."

#. Occurrence 1_5:4482:1089: scene=1_5
#: 1_5:4482
msgctxt "text_id=1089 | speaker=unknown"
msgid "　まあ、それはそれで自分が悪いとして、ついでに別件として、さっきいじめられた反撃とばかりに青子は一気にまくし立てて、"
msgstr "  She knew it was her own fault, but she persisted, wanting to get revenge on Alice for scolding her earlier."

#. Occurrence 1_5:4516:1090: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0030; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:4516
msgctxt "text_id=1090 | speaker=alice"
msgid "「……この前ってアレの事？"
msgstr "\"By 'last time' you mean..."

#. Occurrence 1_5:4522:1091: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0031; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:4522
msgctxt "text_id=1091 | speaker=alice"
msgid "　あなたが都心に出向いた時、夕食にお寿司を食べてきたのに、お土産はなぜかコンビニエンスストアのビニール袋だったって話？」"
msgstr "  The time you went into the city and ate sushi but only came back with a plastic bag full of convenience store food? That time?\""

#. Occurrence 1_5:4544:1092: scene=1_5
#: 1_5:4544
msgctxt "text_id=1092 | speaker=unknown"
msgid "　<薮蛇|やぶへび>だった。"
msgstr "  Aoko had kicked a hornet's nest."

#. Occurrence 1_5:4568:1093: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0060; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4568
msgctxt "text_id=1093 | speaker=aoko"
msgid "「な、なによ、買ってこないよりはマシでしょう」"
msgstr "\"S-so what? It was better than nothing, wasn't it?\""

#. Occurrence 1_5:4577:1094: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0032; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:4577
msgctxt "text_id=1094 | speaker=alice"
msgid "「真実は時に<隠蔽|いんぺい>すべきね」"
msgstr "\"There are times when you'd be better off saying nothing at all.\""

#. Occurrence 1_5:4623:1095: scene=1_5
#: 1_5:4623
msgctxt "text_id=1095 | speaker=unknown"
msgid "　有珠の視線は冷たい。"
msgstr "  Alice's icy gaze pierced right through her."

#. Occurrence 1_5:4678:1096: scene=1_5
#: 1_5:4678
msgctxt "text_id=1096 | speaker=unknown"
msgid "　たしかに、あの時もくもくとコンビニ弁当を食べる有珠の横で回るお寿司の話をしたのは失敗だった。"
msgstr "  Aoko had certainly crossed a line by going on and on about how the sushi circled around the restaurant while Alice ate her convenience store meal."

#. Occurrence 1_5:4683:1097: scene=1_5
#: 1_5:4683
msgctxt "text_id=1097 | speaker=unknown"
msgid "　だが新しい物好きの青子にとって、近頃オープンしだした『回転寿司屋』という驚異について考察する欲求は抑えられなかったのだ。"
msgstr "  But new things fascinated her, and she couldn't contain her curiosity towards the conveyer belt sushi shops that started popping up at the time. They were nothing short of miraculous."

#. Occurrence 1_5:4688:1098: scene=1_5
#: 1_5:4688
msgctxt "text_id=1098 | speaker=unknown"
msgid "　正直なのも場合によっては罪になる。"
msgstr "  Even honesty can be a sin, given the right circumstances."

#. Occurrence 1_5:4740:1099: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0061; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4740
msgctxt "text_id=1099 | speaker=aoko"
msgid "「……分かった。分かりました。じゃあ、今回のは前のと帳消しって事でいいわね？」"
msgstr "\"Fine. Fine, I get it. Does this at least mean we're even now?\""

#. Occurrence 1_5:4760:1100: scene=1_5
#: 1_5:4760
msgctxt "text_id=1100 | speaker=unknown"
msgid "　これといった否定の意を示さず、本に視線を戻す有珠。"
msgstr "  Alice went back to her book without so much as recognizing the question."

#. Occurrence 1_5:4765:1101: scene=1_5
#: 1_5:4765
msgctxt "text_id=1101 | speaker=unknown"
msgid "　肯定の意も示さなかったのが少し怖い。"
msgstr "  The fact that she did not confirm it made Aoko anxious."

#. Occurrence 1_5:4816:1102: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0062; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4816
msgctxt "text_id=1102 | speaker=aoko"
msgid "「仕方ない、今日は<厄日|やくび>だし。"
msgstr "\"Well, today has been a total disaster."

#. Occurrence 1_5:4816:1103: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0062; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4816
msgctxt "text_id=1103 | speaker=aoko"
msgid "　大人しく台所に立って料理の腕を<磨|みが>くとしましょう」"
msgstr "  I guess I'll just whip up something in the kitchen.\""

#. Occurrence 1_5:4822:1104: scene=1_5
#: 1_5:4822
msgctxt "text_id=1104 | speaker=unknown"
msgid "　誰に言うのでもなく立ち上がる青子。"
msgstr "  She stood up, announcing her intent to no one in particular."

#. Occurrence 1_5:4858:1105: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0063; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4858
msgctxt "text_id=1105 | speaker=aoko"
msgid "「あ、聞き忘れてた。有珠、どこで夕食すませたの？」"
msgstr "\"Oh, I almost forgot to ask. Where did you end up eating, anyway?\""

#. Occurrence 1_5:4864:1106: scene=1_5
#: 1_5:4864
msgctxt "text_id=1106 | speaker=unknown"
msgid "　ぴたり、と本の<頁|ページ>をめくる手がとまる。"
msgstr "  Alice's hand froze on her current page."

#. Occurrence 1_5:4890:1107: scene=1_5
#: 1_5:4890
msgctxt "text_id=1107 | speaker=unknown"
msgid "　ここまで青子の相手をしながら読書していたけど、それももう限界、と本は閉じられた。"
msgstr "  She suddenly shut the book she was reading and stood up, as if at wits' end."

#. Occurrence 1_5:4912:1108: scene=1_5
#: 1_5:4912
msgctxt "text_id=1108 | speaker=unknown"
msgid "　有珠は本を片手に立ち上がると、スタスタと居間を横断。"
msgstr "  She walked across the drawing room with her book in hand."

#. Occurrence 1_5:4917:1109: scene=1_5
#: 1_5:4917
msgctxt "text_id=1109 | speaker=unknown"
msgid "　扉に着いたところで青子へと振り向いた。"
msgstr "  When she reached the door, she stopped and turned toward Aoko."

#. Occurrence 1_5:4955:1110: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0033; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:4955
msgctxt "text_id=1110 | speaker=alice"
msgid "「聞きたい？」"
msgstr "\"You really want to know?\""

#. Occurrence 1_5:4968:1111: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1_5_0064; voice_prefix=A10; voice_category=1; scene=1_5
#: 1_5:4968
msgctxt "text_id=1111 | speaker=aoko"
msgid "「まあ、なんとなく……」"
msgstr "\"Um, sure.\""

#. Occurrence 1_5:4973:1112: scene=1_5
#: 1_5:4973
msgctxt "text_id=1112 | speaker=unknown"
msgid "　迫力に押されて、遠慮がちに頷く青子。"
msgstr "  Aoko nodded timidly, cowed by Alice's sudden vigor."

#. Occurrence 1_5:4978:1113: scene=1_5
#: 1_5:4978
msgctxt "text_id=1113 | speaker=unknown"
msgid "　有珠は何でもない事のように、"
msgstr "  Alice continued in her matter-of-fact way."

#. Occurrence 1_5:5000:1114: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1_5_0034; voice_prefix=A40; voice_category=2; scene=1_5
#: 1_5:5000
msgctxt "text_id=1114 | speaker=alice"
msgid "「その猫が、あまったメニューをくれたのよ」"
msgstr "\"The cat gave me one of his leftover deliveries.\""

#. Occurrence 1_5:5006:1115: scene=1_5
#: 1_5:5006
msgctxt "text_id=1115 | speaker=unknown"
msgid "　簡潔に答えて、居間から立ち去っていった。"
msgstr "  And with that brief response, she left the room."

#. Occurrence 1DOT5_1:48:1116: scene=1DOT5_1
#: 1DOT5_1:48
msgctxt "text_id=1116 | speaker=unknown"
msgid "　都会の朝は遅いようで早い。"
msgstr "  Morning in the city moved incredibly fast."

#. Occurrence 1DOT5_1:53:1117: scene=1DOT5_1
#: 1DOT5_1:53
msgctxt "text_id=1117 | speaker=unknown"
msgid "　もしかしたら朝なんて無いんじゃないかと思うぐらい、どこもかしこも目が覚めている。"
msgstr "  It made one wonder if it was even a morning at all, with people so bright-eyed and bushy-tailed."

#. Occurrence 1DOT5_1:101:1118: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0000; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:101
msgctxt "text_id=1118 | speaker=soujuurou"
msgid "「…………」"
msgstr "\"...\""

#. Occurrence 1DOT5_1:107:1119: scene=1DOT5_1
#: 1DOT5_1:107
msgctxt "text_id=1119 | speaker=unknown"
msgid "　まだ聞き慣れない、岩を<転|ころ>がすような<悲鳴|ひめい>で目を覚ました。"
msgstr "  The unfamiliar roar that awoke him reminded him of a rockslide."

#. Occurrence 1DOT5_1:112:1120: scene=1DOT5_1
#: 1DOT5_1:112
msgctxt "text_id=1120 | speaker=unknown"
msgid "　怪音の正体は自動二輪車のエンジン音で、どうやらおとなりの<吉田|よしだ>さんが出勤したらしい。"
msgstr "  The identity of the monstrous sound was the engine of a motorcycle. Mr. Yoshida, his neighbor, was leaving for work."

#. Occurrence 1DOT5_1:117:1121: scene=1DOT5_1
#: 1DOT5_1:117
msgctxt "text_id=1121 | speaker=unknown"
msgid "　朝が<曖昧|あいまい>なこの街は、夜だって曖昧だ。"
msgstr "  It was hard to determine when night ended and morning began here."

#. Occurrence 1DOT5_1:122:1122: scene=1DOT5_1
#: 1DOT5_1:122
msgctxt "text_id=1122 | speaker=unknown"
msgid "　機械仕掛けというのは眠らない事と同義なのだろう。"
msgstr "  The town's urbanization was synonymous with insomnia."

#. Occurrence 1DOT5_1:143:1123: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0001; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:143
msgctxt "text_id=1123 | speaker=soujuurou"
msgid "「信じられない……まだ陽も昇ってないのに……吉田さんはどこに行くのか……」"
msgstr "\"Already? It's barely sun-up yet... Where could Mr. Yoshida be going so early?\""

#. Occurrence 1DOT5_1:150:1124: scene=1DOT5_1
#: 1DOT5_1:150
msgctxt "text_id=1124 | speaker=unknown"
msgid "　のっそり床から身を起こす。"
msgstr "  He sluggishly lifted himself off the floor."

#. Occurrence 1DOT5_1:155:1125: scene=1DOT5_1
#: 1DOT5_1:155
msgctxt "text_id=1125 | speaker=unknown"
msgid "　これまでの習慣であたりを徘徊しそうになって、その必要はないと気が付き、流し場に向かう。"
msgstr "  He caught himself starting to survey his surroundings out of habit before deciding better of it, and made his way to the washroom."

#. Occurrence 1DOT5_1:188:1126: scene=1DOT5_1
#: 1DOT5_1:188
msgctxt "text_id=1126 | speaker=unknown"
msgid "　コップに<二口|ふたくち>分の水を<汲|く>んで、ゆっくりと喉に通した。"
msgstr "  There, he poured himself a cup of water and slowly gulped it down."

#. Occurrence 1DOT5_1:196:1127: scene=1DOT5_1
#: 1DOT5_1:196
msgctxt "text_id=1127 | speaker=unknown"
msgid "　ちょっと前までは井戸水を汲んでいた草十郎にとって、この便利さは喜ばしい。"
msgstr "  Having been relegated to well water until recently, he found the convenience pleasing."

#. Occurrence 1DOT5_1:201:1128: scene=1DOT5_1
#: 1DOT5_1:201
msgctxt "text_id=1128 | speaker=unknown"
msgid "　喜ばしい、と思うことが正しい。"
msgstr "  'Pleased' was definitely the word that best described how he felt."

#. Occurrence 1DOT5_1:230:1129: scene=1DOT5_1
#: 1DOT5_1:230
msgctxt "text_id=1129 | speaker=unknown"
msgid "　文明とは複雑化と最適化を突き詰めるもので、"
msgstr "  Civilization is about erasing inconveniences through optimization."

#. Occurrence 1DOT5_1:235:1130: scene=1DOT5_1
#: 1DOT5_1:235
msgctxt "text_id=1130 | speaker=unknown"
msgid "　生活に必要なものは手間を減らし、"
msgstr "  The reduction of labor in our daily lives."

#. Occurrence 1DOT5_1:240:1131: scene=1DOT5_1
#: 1DOT5_1:240
msgctxt "text_id=1131 | speaker=unknown"
msgid "　人生に必要なものはより複雑さを増していく、と教えてくれたのは<恒河|こうが>さんだったか。"
msgstr "  Mr. Koga had taught him that while the essentials were easier than ever to get our hands on, life itself was growing more and more complex."

#. Occurrence 1DOT5_1:245:1132: scene=1DOT5_1
#: 1DOT5_1:245
msgctxt "text_id=1132 | speaker=unknown"
msgid "　<手前|テメエ>はともかく前者の方から慣れるべきだ、とも彼は言った。"
msgstr "  So too was it his duty to adjust to his new reality."

#. Occurrence 1DOT5_1:281:1133: scene=1DOT5_1
#: 1DOT5_1:281
msgctxt "text_id=1133 | speaker=unknown"
msgid "　草十郎の父の遠縁である恒河氏は、わりと、ほとんど他人に近い草十郎をここまで世話してくれた恩人である。"
msgstr "  As a distant relative of Soujyuro's father, Mr. Koga had taken Soujyuro in, even though the boy had been little more than a stranger in his life till that point."

#. Occurrence 1DOT5_1:287:1134: scene=1DOT5_1
#: 1DOT5_1:287
msgctxt "text_id=1134 | speaker=unknown"
msgid "　アパートの契約や学校の手続きが問題なく済んだのは恒河氏の<尽力|じんりょく>あってのものだ。"
msgstr "  Mr. Koga had helped him get registered at school and find an apartment to lease."

#. Occurrence 1DOT5_1:292:1135: scene=1DOT5_1
#: 1DOT5_1:292
msgctxt "text_id=1135 | speaker=unknown"
msgid "　一方、住民票の<写|うつ>しやら移転届けやらは自分の手でやりやがれと叱られた。"
msgstr "  Though, he had insisted that Soujyuro handle his residence card and register his change of address by himself."

#. Occurrence 1DOT5_1:325:1136: scene=1DOT5_1
#: 1DOT5_1:325
msgctxt "text_id=1136 | speaker=unknown"
msgid "　草十郎にとって手続き関連は困難なことこの上なかったが、これから都会で暮らしていくんだから、と前向きにこなしてみれば、こちらも呆気なく片が付いた。"
msgstr "  This series of procedures proved exceedingly difficult for Soujyuro, but knowing that this was a part of his new city life, he did his best to complete them diligently."

#. Occurrence 1DOT5_1:330:1137: scene=1DOT5_1
#: 1DOT5_1:330
msgctxt "text_id=1137 | speaker=unknown"
msgid "『お役所仕事は厳しそうに見えてわりといい加減』"
msgstr "(While they may have a reputation for being a stickler for the rules, city offices aren't all that bad.)"

#. Occurrence 1DOT5_1:335:1138: scene=1DOT5_1
#: 1DOT5_1:335
msgctxt "text_id=1138 | speaker=unknown"
msgid "　草十郎が街での生活を始めてから、最初に覚えた教訓である。"
msgstr "  It was the first thing Soujyuro learned after beginning his life in the city."

#. Occurrence 1DOT5_1:369:1139: scene=1DOT5_1
#: 1DOT5_1:369
msgctxt "text_id=1139 | speaker=unknown"
msgid "　草十郎が田舎からやってきて二週間。"
msgstr "  Two weeks had elapsed since he left the countryside."

#. Occurrence 1DOT5_1:374:1140: scene=1DOT5_1
#: 1DOT5_1:374
msgctxt "text_id=1140 | speaker=unknown"
msgid "　不安だらけだったひとり暮らしも、やってみればなんとかなるものだ。"
msgstr "  As uneasy as living alone made him feel, he felt he could make it work."

#. Occurrence 1DOT5_1:379:1141: scene=1DOT5_1
#: 1DOT5_1:379
msgctxt "text_id=1141 | speaker=unknown"
msgid "　言葉が通じるんだから当たり前と言えば当たり前だし、なにより恒河氏の言うとおり、生活面だけなら都会の<あり方|ルール>はがっしりと筋が通っている。"
msgstr "  It was not as if the people here spoke another language, and Mr. Koga was absolutely right about how practical the rules of the city were."

#. Occurrence 1DOT5_1:423:1142: scene=1DOT5_1
#: 1DOT5_1:423
msgctxt "text_id=1142 | speaker=unknown"
msgid "　硬い、驚くほど歩きやすい道を歩く。"
msgstr "  Soujyuro continued down the hard, but surprisingly walkable path."

#. Occurrence 1DOT5_1:428:1143: scene=1DOT5_1
#: 1DOT5_1:428
msgctxt "text_id=1143 | speaker=unknown"
msgid "　アルバイトの時間まで、時間つぶしに公園をジョギングする。"
msgstr "  Before work, he jogged in the park to pass the time."

#. Occurrence 1DOT5_1:433:1144: scene=1DOT5_1
#: 1DOT5_1:433
msgctxt "text_id=1144 | speaker=unknown"
msgid "　草十郎にしてみれば、こんな運動すら大事な教訓になる。"
msgstr "  Even exercise like this offered lessons for Soujyuro to learn."

#. Occurrence 1DOT5_1:471:1145: scene=1DOT5_1
#: 1DOT5_1:471
msgctxt "text_id=1145 | speaker=unknown"
msgid "　通り過ぎる人々はひとりひとりが新鮮で、"
msgstr "  Each passing person was a new face to look at."

#. Occurrence 1DOT5_1:476:1146: scene=1DOT5_1
#: 1DOT5_1:476
msgctxt "text_id=1146 | speaker=unknown"
msgid "　挨拶をしてくれるおじいさんも、"
msgstr "  The old man who greeted him,"

#. Occurrence 1DOT5_1:481:1147: scene=1DOT5_1
#: 1DOT5_1:481
msgctxt "text_id=1147 | speaker=unknown"
msgid "　うつむいて歩く二十歳ぐらいのお兄さんも、"
msgstr "  the young worker with his eyes on the ground,"

#. Occurrence 1DOT5_1:486:1148: scene=1DOT5_1
#: 1DOT5_1:486
msgctxt "text_id=1148 | speaker=unknown"
msgid "　ベンチに座って鳥に囲まれている女の子も、"
msgstr "  and the girl on the bench, surrounded by birds..."

#. Occurrence 1DOT5_1:491:1149: scene=1DOT5_1
#: 1DOT5_1:491
msgctxt "text_id=1149 | speaker=unknown"
msgid "　草十郎にとっては<得難|えがた>い風景だ。"
msgstr "  They were all unfamiliar sights to Soujyuro."

#. Occurrence 1DOT5_1:497:1150: scene=1DOT5_1
#: 1DOT5_1:497
msgctxt "text_id=1150 | speaker=unknown"
msgid "　まだ街に慣れていない彼は、とにかくルールの把握に努めなくてはいけなかった。"
msgstr "  Unaccustomed to the city, he labored to understand its rules."

#. Occurrence 1DOT5_1:529:1151: scene=1DOT5_1
#: 1DOT5_1:529
msgctxt "text_id=1151 | speaker=unknown"
msgid "　複雑だったり単純だったり、"
msgstr "  Whether they were complex, simple,"

#. Occurrence 1DOT5_1:534:1152: scene=1DOT5_1
#: 1DOT5_1:534
msgctxt "text_id=1152 | speaker=unknown"
msgid "　意味があったりなかったり。"
msgstr "  or completely meaningless..."

#. Occurrence 1DOT5_1:540:1153: scene=1DOT5_1
#: 1DOT5_1:540
msgctxt "text_id=1153 | speaker=unknown"
msgid "　自然とだけ向き合っていればよかった山の暮らしと比べて、街の暮らしは選択肢が多すぎる。"
msgstr "  Compared to mountain life, which only dealt with nature, city life left one with way too many options."

#. Occurrence 1DOT5_1:545:1154: scene=1DOT5_1
#: 1DOT5_1:545
msgctxt "text_id=1154 | speaker=unknown"
msgid "　正直、今の草十郎には毒々しいとさえ言えた。"
msgstr "  One could argue that such an environment was toxic for Soujyuro."

#. Occurrence 1DOT5_1:578:1155: scene=1DOT5_1
#: 1DOT5_1:578
msgctxt "text_id=1155 | speaker=unknown"
msgid "　いまのところは不安になるような出来事ばかり。"
msgstr "  His life was a string of unsettling moments."

#. Occurrence 1DOT5_1:583:1156: scene=1DOT5_1
#: 1DOT5_1:583
msgctxt "text_id=1156 | speaker=unknown"
msgid "　ただ、その中にも心の底から感心できるルールだってある。"
msgstr "  But amongst it all, there were rules that he sincerely admired."

#. Occurrence 1DOT5_1:589:1157: scene=1DOT5_1
#: 1DOT5_1:589
msgctxt "text_id=1157 | speaker=unknown"
msgid "　色々と合点のいかない<損得勘定|ルール>で回る都会だが。"
msgstr "  For one, that the city revolved around various forms of profit and loss."

#. Occurrence 1DOT5_1:594:1158: scene=1DOT5_1
#: 1DOT5_1:594
msgctxt "text_id=1158 | speaker=unknown"
msgid "　とりあえず、お金さえあれば必要な物はあらかた貰えるのは、なるほど、都会の暮らしも悪くないと思う草十郎なのだった。"
msgstr "  The fact that one only needed money to get the bare essentials to survive the city was a comforting thought to Soujyuro."

#. Occurrence 1DOT5_1:671:1159: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0000; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:671
msgctxt "text_id=1159 | speaker=kinomi"
msgid "「いや、そうシンプルな話じゃねぇよ。"
msgstr "\"Hey, not everything's that simple."

#. Occurrence 1DOT5_1:677:1160: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0001; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:677
msgctxt "text_id=1160 | speaker=kinomi"
msgid "　金なんてものはあくまで記号で、本当に大事なのは別にあんだからさあ。"
msgstr "  Money is just a symbol. It's the other stuff that truly matters."

#. Occurrence 1DOT5_1:688:1161: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0002; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:688
msgctxt "text_id=1161 | speaker=kinomi"
msgid "　しょせんは流動する肩たたき券と変わんねーっつーか、別に一万円札食っても<旨|うま>くねぇっつーか……あー、ともかく金で真心は買えねえじゃん？」"
msgstr "  Money ain't that different from those free shoulder massage coupons people hand out, and it's not like the food you buy with a ten-thousand yen bill won't turn out bogus. Look, money can't buy you happiness, you get me?\""

#. Occurrence 1DOT5_1:709:1162: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0002; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:709
msgctxt "text_id=1162 | speaker=soujuurou"
msgid "「えー」"
msgstr "\"Maybe.\""

#. Occurrence 1DOT5_1:729:1163: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0003; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:729
msgctxt "text_id=1163 | speaker=kinomi"
msgid "「えーじゃねえよ！　ザケンなよー、オレは悲しいよー。"
msgstr "\"'Maybe'!? Are you for real? Man, I can't believe you right now."

#. Occurrence 1DOT5_1:735:1164: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0004; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:735
msgctxt "text_id=1164 | speaker=kinomi"
msgid "　ついこの間まで四千円っぽっちの日当に鹿みたいに首かしげていた正直者が、くっだらねえ皿洗いをしながら“ま、世の中金だよね”なんて、ぼそっと言わないでくれっつの」"
msgstr "  One day you're happy to break your back working a full day for a measly four thousand yen, the next you're elbow-deep in dirty dishes saying, 'It's all about the money.' What's your major malfunction?\""

#. Occurrence 1DOT5_1:756:1165: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0003; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:756
msgctxt "text_id=1165 | speaker=soujuurou"
msgid "「いや、貨幣制度は素晴らしいと思う。正直、物々交換の限界を感じた。"
msgstr "\"No, I think that the current system is kind of amazing. To be honest, I never realized how limited bartering can be."

#. Occurrence 1DOT5_1:762:1166: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0004; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:762
msgctxt "text_id=1166 | speaker=soujuurou"
msgid "　それより<木乃美|きのみ>、ふざけてると<皿|それ>、落とすぞ」"
msgstr "  Anyway, Kinomi--you're gonna drop that if you aren't careful.\""

#. Occurrence 1DOT5_1:794:1167: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0005; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:794
msgctxt "text_id=1167 | speaker=kinomi"
msgid "「え？　って、うおぉぉおヤベえヤベえ、つぎ割ったら今度こそオレの頭が割られちまうからな！"
msgstr "\"Huh? Crap! Ooh, damn! That was close! If I break any more, it'll be my head next!"

#. Occurrence 1DOT5_1:807:1168: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0006; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:807
msgctxt "text_id=1168 | speaker=kinomi"
msgid "　忠告サンキュー。それで、相談ごと？　なに、もしかして金？」"
msgstr "  Thanks for the save. So...what did you want to talk to me about? It's money, isn't it?\""

#. Occurrence 1DOT5_1:813:1169: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0005; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:813
msgctxt "text_id=1169 | speaker=soujuurou"
msgid "「そうなんだ。とりあえずお金は大事で、たくさんあるに越したことはないって痛感した。なんで、出来ればもうちょっと働きたい」"
msgstr "\"Exactly. I learned my lesson the hard way, but now I know that it's better to have more money than less. That's why I'd like to work even more than I am now.\""

#. Occurrence 1DOT5_1:839:1170: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0007; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:839
msgctxt "text_id=1170 | speaker=kinomi"
msgid "「うぇ、マジぃ？　マシーンみたいに皿洗いをこなしながら夢のないコト言わないでほしいなあ。"
msgstr "\"Are you for real? You already wash dishes like a machine."

#. Occurrence 1DOT5_1:850:1171: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0008; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:850
msgctxt "text_id=1171 | speaker=kinomi"
msgid "　世の中金じゃねえって言ったばかりじゃんか。やっぱラブじゃんか。ところで水冷たくないですかね？　冬場の皿洗いって割合わねえコトこの上ねえよな？」"
msgstr "  Didn't I just how money can't buy happiness? Love can, but... Back right up. Why's the water so cold? Say, we should probably get paid more for washing dishes in the winter, huh?\""

#. Occurrence 1DOT5_1:871:1172: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0006; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:871
msgctxt "text_id=1172 | speaker=soujuurou"
msgid "「そりゃ冷たいけど、これぐらいは我慢しないと。"
msgstr "\"It's cold all right, but nothing I can't handle."

#. Occurrence 1DOT5_1:871:1173: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0006; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:871
msgctxt "text_id=1173 | speaker=soujuurou"
msgid "　山の水は冷たいっていうより痛かったし」"
msgstr "  Mountain water is so cold it hurts.\""

#. Occurrence 1DOT5_1:907:1174: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0009; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:907
msgctxt "text_id=1174 | speaker=kinomi"
msgid "「氷水とおんなじにすんな野生児め。……しっかしアレだね、あきれた順応力、いや忍耐力？　つーの？"
msgstr "\"I didn't mean it was ice water, you hick. That thick skin of yours can be real annoying, you know that?"

#. Occurrence 1DOT5_1:913:1175: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0010; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:913
msgctxt "text_id=1175 | speaker=kinomi"
msgid "　レジ打ちすらできなかった新人がよぅ、たった四日でしみったれたメシ屋の<社畜|しゃちく>になっちまうなんて……やっぱ世の中金ってコトかねー。資本主義ってすげー」"
msgstr "  For someone who couldn't even work a cash register four days ago, you sure got comfortable workin' for The Man. I guess money really is everything. The power of capitalism ain't nothing to mess with!\""

#. Occurrence 1DOT5_1:930:1176: voice_id=D30_1DOT5_1_0000; voice_prefix=D30; voice_category=0; scene=1DOT5_1
#: 1DOT5_1:930
msgctxt "text_id=1176 | speaker=unknown"
msgid "「うるっせえぞバカバイト、文句あんなら辞めちまえ！"
msgstr "\"Shut yer pie holes, part-timers! The door's right there if you wanna quit!"

#. Occurrence 1DOT5_1:936:1177: voice_id=D30_1DOT5_1_0001; voice_prefix=D30; voice_category=0; scene=1DOT5_1
#: 1DOT5_1:936
msgctxt "text_id=1177 | speaker=unknown"
msgid "　うちにゃあ<穀潰|ごくつぶ>しにくれてやる小遣いはねえ！」"
msgstr "  I don't have the cash to waste on deadbeats!\""

#. Occurrence 1DOT5_1:956:1178: scene=1DOT5_1
#: 1DOT5_1:956
msgctxt "text_id=1178 | speaker=unknown"
msgid "　間髪いれず、すっかーん、と飛ばされる罵声と<菜箸|さいばし>。"
msgstr "  The complaints and chopsticks flew at them like a storm."

#. Occurrence 1DOT5_1:961:1179: scene=1DOT5_1
#: 1DOT5_1:961
msgctxt "text_id=1179 | speaker=unknown"
msgid "　未成年でも働かせてくれるアバウトな中華飯店の店長は、たとえ赤ん坊の頃から顔見知り……お隣さんの息子さん……であろうと鉄拳を振るう、たくましい人物だった。"
msgstr "  This mess of a Chinese restaurant manager was a stubborn man who was willing to let minors work for him and didn't shy from violence, even if it was directed at the son of a lifelong friend."

#. Occurrence 1DOT5_1:967:1180: scene=1DOT5_1
#: 1DOT5_1:967
msgctxt "text_id=1180 | speaker=unknown"
msgid "　こういうのをスパルタと言うんだな、と草十郎は感心する。"
msgstr "  Soujyuro felt that this is what Sparta must have been like."

#. Occurrence 1DOT5_1:988:1181: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0007; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:988
msgctxt "text_id=1181 | speaker=soujuurou"
msgid "「ほら怒られた。任された事はきちんとやらないと」"
msgstr "\"Look, he's angry. We need to work harder.\""

#. Occurrence 1DOT5_1:1009:1182: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0011; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1009
msgctxt "text_id=1182 | speaker=kinomi"
msgid "「けっ、優等生め。こっちは何かと反抗したい年頃だっつの。"
msgstr "\"Wow, your nose get any browner yet? Me, I'm tryin' to make the most of my teens."

#. Occurrence 1DOT5_1:1021:1183: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0012; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1021
msgctxt "text_id=1183 | speaker=kinomi"
msgid "　まあいいや。話は変わるんだけどよ。"
msgstr "  Whatever. Right, been meaning to ask..."

#. Occurrence 1DOT5_1:1027:1184: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0013; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1027
msgctxt "text_id=1184 | speaker=kinomi"
msgid "　静希、夜に出歩くタイプ？　それかチャリンコで出ばる趣味？　いやまぁ、どっちかでいいんだけど」"
msgstr "  Are you the type that likes to go out on late-night strolls or more of a bicycle kind of guy? Not that it really matters, but...\""

#. Occurrence 1DOT5_1:1049:1185: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0008; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:1049
msgctxt "text_id=1185 | speaker=soujuurou"
msgid "「……？　バイトの帰りはほとんど夜になるけど、そういう話じゃないんだよな。夜の散歩も遠出も趣味じゃないけど、それが？」"
msgstr "\"Hm? It's always late when I go home after the restaurant, but that's not what you're asking, is it? I'm not really into walking when it's late out. Why do you ask?\""

#. Occurrence 1DOT5_1:1076:1186: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0014; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1076
msgctxt "text_id=1186 | speaker=kinomi"
msgid "「いや、なにさ。静希、引っ越してきたばかりだっていうからよ。オレらが言うのもなんだけど、<三咲町|うち>、ちょい治安が悪いっての？　ガラが悪いワケじゃねえんだけどな。"
msgstr "\"No reason. Like, you just moved here. Kinda weird question, but don't you think the town is dangerous? Not like people are bad or nothing."

#. Occurrence 1DOT5_1:1108:1187: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0015; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1108
msgctxt "text_id=1187 | speaker=kinomi"
msgid "　年間十人ぐらい通り魔事件っての？　そういうの、起きてっから」"
msgstr "  But I mean, you know that we get ten attacks like outta a slasher flick every year, right? And since they started there's-\""

#. Occurrence 1DOT5_1:1114:1188: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0009; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:1114
msgctxt "text_id=1188 | speaker=soujuurou"
msgid "「……とおりまって、なんだ？」"
msgstr "\"What's a slasher?\""

#. Occurrence 1DOT5_1:1135:1189: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0016; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1135
msgctxt "text_id=1189 | speaker=kinomi"
msgid "「そっからかよ！"
msgstr "\"You don't know!?"

#. Occurrence 1DOT5_1:1141:1190: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0017; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1141
msgctxt "text_id=1190 | speaker=kinomi"
msgid "　……なんだ、ほら！　カバン強盗……でもないか。"
msgstr "  It's like... when a thief snatches someone's purse... No, bad example."

#. Occurrence 1DOT5_1:1148:1191: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0018; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1148
msgctxt "text_id=1191 | speaker=kinomi"
msgid "<辻斬|つじぎ>りってのが近いのか。住宅街とか、まだ森が残ってる方によく出やがるんだよ、そういうおかしいのが。"
msgstr "It's more like someone's killing to see if they can get away with it. Buncha dead people in the woods near the suburbs. Real gnarly."

#. Occurrence 1DOT5_1:1173:1192: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0019; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1173
msgctxt "text_id=1192 | speaker=kinomi"
msgid "　なんで、あんまり夜遅くは出歩くなよな。三咲丘の公園とか、有名な怪奇スポットだから。"
msgstr "  That's why you shouldn't go out too late. The park in Misaki Hills is a hot spot for the weird stuff."

#. Occurrence 1DOT5_1:1179:1193: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0020; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1179
msgctxt "text_id=1193 | speaker=kinomi"
msgid "　通り魔の犯人は口裂け女だったって話、知らねえか？」"
msgstr "  Haven't you heard about how they think the freak doing it is some chick with a sliced mouth?\""

#. Occurrence 1DOT5_1:1200:1194: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0010; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:1200
msgctxt "text_id=1194 | speaker=soujuurou"
msgid "「ごめん、まずその口裂け女ってのが分からない」"
msgstr "\"Nope. This is the first I've heard of a sliced-mouth woman.\""

#. Occurrence 1DOT5_1:1218:1195: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0021; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1218
msgctxt "text_id=1195 | speaker=kinomi"
msgid "「怪談だよ。口が耳まで裂けてるってヤツ。"
msgstr "\"Like I said, slasher film shit. They say her mouth extends all the way to her ears."

#. Occurrence 1DOT5_1:1218:1196: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0021; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1218
msgctxt "text_id=1196 | speaker=kinomi"
msgid "　今じゃさすがに時代遅れだけどよ」"
msgstr "  It's a pretty old-school kinda urban legend, these days.\""

#. Occurrence 1DOT5_1:1239:1197: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0022; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1239
msgctxt "text_id=1197 | speaker=kinomi"
msgid "「えーとなんだっけ、深夜の道にな、コート姿の女が待ち伏せていて『わたしきれい？』とか聞いてくるんだよ。"
msgstr "\"How did it go again? There's a woman in a coat who asks 'Am I beautiful?' in the dead of night."

#. Occurrence 1DOT5_1:1260:1198: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0023; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1260
msgctxt "text_id=1198 | speaker=kinomi"
msgid "　で、キレイって言ってもイマイチって言っても家まで追っかけられて殺されるの。"
msgstr "  Even if you say she is, she'll follow you home and kill you."

#. Occurrence 1DOT5_1:1273:1199: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0024; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1273
msgctxt "text_id=1199 | speaker=kinomi"
msgid "女の情念はおっかねえっつうか、アメコミの怪人っぽいっつうか」"
msgstr "Intense chicks like that are a no-no. It's like, something you'd see in an American comic book.\""

#. Occurrence 1DOT5_1:1294:1200: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0011; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:1294
msgctxt "text_id=1200 | speaker=soujuurou"
msgid "「……いや、それ本気で怖くないか？"
msgstr "\"...That sounds really scary."

#. Occurrence 1DOT5_1:1294:1201: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0011; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:1294
msgctxt "text_id=1201 | speaker=soujuurou"
msgid "　家まであがってくるのか、その女の人？」"
msgstr "  Does she actually follow you home?\""

#. Occurrence 1DOT5_1:1307:1202: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0025_0; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1307
msgctxt "text_id=1202 | speaker=kinomi"
msgid "「窓から入ってくるらしいぜ。"
msgstr "\"They say she crawls in through a window."

#. Occurrence 1DOT5_1:1307:1203: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0025_0; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1307
msgctxt "text_id=1203 | speaker=kinomi"
msgid "　ガサガサと、こう、ゴキブリみた―――"
msgstr "  Squeezes her way in like a cockroa-"

#. Occurrence 1DOT5_1:1323:1204: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0025_1; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1323
msgctxt "text_id=1204 | speaker=kinomi"
msgid "ぎゃっ！？」"
msgstr "AAAGH!\""

#. Occurrence 1DOT5_1:1340:1205: voice_id=D30_1DOT5_1_0002; voice_prefix=D30; voice_category=0; scene=1DOT5_1
#: 1DOT5_1:1340
msgctxt "text_id=1205 | speaker=unknown"
msgid "「っのクソガキが、厨房でその四文字は禁止だってんだろ、殺すぞ！」"
msgstr "\"I told you not to utter that word in this kitchen! I'm gonna kill you, you little turd!\""

#. Occurrence 1DOT5_1:1360:1206: scene=1DOT5_1
#: 1DOT5_1:1360
msgctxt "text_id=1206 | speaker=unknown"
msgid "　そうして木乃美の後頭部に炸裂する、店長のフライパン／縦攻撃。"
msgstr "  The back of Kinomi's head exploded in pain with the impact of his boss's frying pan."

#. Occurrence 1DOT5_1:1365:1207: scene=1DOT5_1
#: 1DOT5_1:1365
msgctxt "text_id=1207 | speaker=unknown"
msgid "　なるほど、町は危険であふれている、と草十郎は再び感心した。"
msgstr "  Soujyuro was reminded of just how dangerous this town could be."

#. Occurrence 1DOT5_1:1401:1208: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0026; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1401
msgctxt "text_id=1208 | speaker=kinomi"
msgid "「殺す殺すってバカじゃねえの!?"
msgstr "\"'I'm gonna kill you, I'm gonna kill you!' Yeah right! I'd like to see him try!"

#. Occurrence 1DOT5_1:1414:1209: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0027; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1414
msgctxt "text_id=1209 | speaker=kinomi"
msgid "　フツーそっちの方が禁止用語じゃねえの!?　ここレストランなんだしさ！　いや、あんまうまくねーけど！」"
msgstr "  And what kind of boss says that anyway!? This is a restaurant, ain't it!? Well, maybe calling it that is too much!\""

#. Occurrence 1DOT5_1:1420:1210: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0012; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:1420
msgctxt "text_id=1210 | speaker=soujuurou"
msgid "「木乃美、頭、大丈夫か？」"
msgstr "\"Is your head okay, Kinomi?\""

#. Occurrence 1DOT5_1:1447:1211: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0028; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1447
msgctxt "text_id=1211 | speaker=kinomi"
msgid "「え？　あ、ん、心配無用。オレ、なんでか頑丈さには定評があるから。特に頭部について。"
msgstr "\"Huh? Ah, it's nothing. People tell me I'm real tough. Especially my head."

#. Occurrence 1DOT5_1:1459:1212: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0029; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1459
msgctxt "text_id=1212 | speaker=kinomi"
msgid "　ともかく、そういうワケなんで夜の暗がりは気をつけるぞなもし。静希、見るからにカモそうな顔してるし」"
msgstr "  Anyway, avoid the dark, okay? You look like a sitting duck.\""

#. Occurrence 1DOT5_1:1465:1213: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0013; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:1465
msgctxt "text_id=1213 | speaker=soujuurou"
msgid "「ありがとう。"
msgstr "\"Thanks."

#. Occurrence 1DOT5_1:1471:1214: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0014; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:1471
msgctxt "text_id=1214 | speaker=soujuurou"
msgid "　ところで、年間十人というのは多い方なのか？」"
msgstr "  By the way, is ten victims per year a lot?\""

#. Occurrence 1DOT5_1:1498:1215: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0030; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1498
msgctxt "text_id=1215 | speaker=kinomi"
msgid "「知んねぇよ。少なくはないだろうけど、多い方でもないんじゃねえか？"
msgstr "\"Don't know. It probably isn't a lot, but it totally ain't a few either."

#. Occurrence 1DOT5_1:1510:1216: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_1_0031; voice_prefix=B50; voice_category=6; scene=1DOT5_1
#: 1DOT5_1:1510
msgctxt "text_id=1216 | speaker=kinomi"
msgid "　ま、<三|う><咲|ち>の通り魔事件が他に比べて厄介なのは、まだ犯人が見つかってないってコトだからネ！」"
msgstr "  The real scary shit is that they're still out there, somewhere, since they haven't been caught!\""

#. Occurrence 1DOT5_1:1545:1217: scene=1DOT5_1
#: 1DOT5_1:1545
msgctxt "text_id=1217 | speaker=unknown"
msgid "　はははは、と陽気に笑う。"
msgstr "  He laughed cheerfully."

#. Occurrence 1DOT5_1:1550:1218: scene=1DOT5_1
#: 1DOT5_1:1550
msgctxt "text_id=1218 | speaker=unknown"
msgid "　そうやって不吉な話を笑い話に切り替える木乃美の高度な意図は、もちろん草十郎には伝わっていない。"
msgstr "  Kinomi was probably trying to take the edge off of his story, but the noble intention of his laugh was completely lost on Soujyuro."

#. Occurrence 1DOT5_1:1555:1219: scene=1DOT5_1
#: 1DOT5_1:1555
msgctxt "text_id=1219 | speaker=unknown"
msgid "　親切な忠告も<糠|ぬか>に<釘|くぎ>。"
msgstr "  His friendly warning was equally futile."

#. Occurrence 1DOT5_1:1565:1220: scene=1DOT5_1
#: 1DOT5_1:1565
msgctxt "text_id=1220 | speaker=unknown"
msgid "　そっか、ここは笑うところなのか、とまたも真剣に感心する草十郎なのだった。"
msgstr "  Soujyuro was simply impressed that Kinomi was able to laugh it off."

#. Occurrence 1DOT5_1:1607:1221: scene=1DOT5_1
#: 1DOT5_1:1607
msgctxt "text_id=1221 | speaker=unknown"
msgid "　その帰り道。"
msgstr "  On the way home..."

#. Occurrence 1DOT5_1:1612:1222: scene=1DOT5_1
#: 1DOT5_1:1612
msgctxt "text_id=1222 | speaker=unknown"
msgid "　前にも後ろにも人のいない、電灯だけが照らす暗い住宅地で、草十郎は唐突に、"
msgstr "  Nobody ahead or behind. Soujyuro proceeded through the dimly lit street when suddenly..."

#. Occurrence 1DOT5_1:1632:1223: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0015; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:1632
msgctxt "text_id=1223 | speaker=soujuurou"
msgid "「……？」"
msgstr "\"...?\""

#. Occurrence 1DOT5_1:1637:1224: scene=1DOT5_1
#: 1DOT5_1:1637
msgctxt "text_id=1224 | speaker=unknown"
msgid "　何か、ありえない物音に振り返った。"
msgstr "  He turned to face an... improbable sound."

#. Occurrence 1DOT5_1:1690:1225: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_1_0016; voice_prefix=A30; voice_category=3; scene=1DOT5_1
#: 1DOT5_1:1690
msgctxt "text_id=1225 | speaker=soujuurou"
msgid "「―――あいた！？」"
msgstr "\"...Ouch!\""

#. Occurrence 1DOT5_1:1704:1226: scene=1DOT5_1
#: 1DOT5_1:1704
msgctxt "text_id=1226 | speaker=unknown"
msgid "　脳天に刺さる衝撃と、ぽとん、と足下に落ちる音。"
msgstr "  Something stabbed him in the head, and fell to the floor."

#. Occurrence 1DOT5_1:1709:1227: scene=1DOT5_1
#: 1DOT5_1:1709
msgctxt "text_id=1227 | speaker=unknown"
msgid "　ついてない、と<眉|まゆ>を<曇|くも>らせる。"
msgstr "  He frowned."

#. Occurrence 1DOT5_1:1714:1228: scene=1DOT5_1
#: 1DOT5_1:1714
msgctxt "text_id=1228 | speaker=unknown"
msgid "　電柱にぶつかって墜ちてきた小鳥に、歩いていた自分がぶつかってしまったらしい。"
msgstr "  A small bird had apparently flown into the telephone pole before landing on his head."

#. Occurrence 1DOT5_1:1739:1229: scene=1DOT5_1
#: 1DOT5_1:1739
msgctxt "text_id=1229 | speaker=unknown"
msgid "　ムクドリは路面で<毛繕|けづくろ>いをした後、あわただしく飛んでいった。"
msgstr "  The starling cleaned itself off and flew away."

#. Occurrence 1DOT5_1:1744:1230: scene=1DOT5_1
#: 1DOT5_1:1744
msgctxt "text_id=1230 | speaker=unknown"
msgid "　鳥が墜ちてくるコトも、"
msgstr "  The falling of the bird"

#. Occurrence 1DOT5_1:1749:1231: scene=1DOT5_1
#: 1DOT5_1:1749
msgctxt "text_id=1231 | speaker=unknown"
msgid "　その後、慌てるように飛び去っていくコトも、"
msgstr "  and its desperate escape thereafter"

#. Occurrence 1DOT5_1:1754:1232: scene=1DOT5_1
#: 1DOT5_1:1754
msgctxt "text_id=1232 | speaker=unknown"
msgid "　彼の今までの生活、今までの常識にはなかった事だ。"
msgstr "  was unlike anything he had experienced in his life up to now."

#. Occurrence 1DOT5_1:1774:1233: scene=1DOT5_1
#: 1DOT5_1:1774
msgctxt "text_id=1233 | speaker=unknown"
msgid "　町の人間なら『墜ちてきた鳥に当たる』なんて不運、奇遇に、不吉なものを感じるのだろうが、草十郎はなるほど、とうなずいて帰路についた。"
msgstr "  Most of the townsfolk would have seen the incident as unlucky, ominous, or even sinister, but Soujyuro just nodded and went about his business."

#. Occurrence 1DOT5_1:1793:1234: scene=1DOT5_1
#: 1DOT5_1:1793
msgctxt "text_id=1234 | speaker=unknown"
msgid "　―――なに。"
msgstr "  You must understand..."

#. Occurrence 1DOT5_1:1798:1235: scene=1DOT5_1
#: 1DOT5_1:1798
msgctxt "text_id=1235 | speaker=unknown"
msgid "　自分にとっては初めての経験だったが、都会ではよくある事に違いない。"
msgstr "  What might have been a first for him was surely an everyday occurrence for these city folk."

#. Occurrence 1DOT5_2:78:1236: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0000; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:78
msgctxt "text_id=1236 | speaker=aoko"
msgid "「たっだいまー！　ねぇ、有珠帰ってるー？"
msgstr "\"I'm home! Alice, you here yet?"

#. Occurrence 1DOT5_2:84:1237: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0001; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:84
msgctxt "text_id=1237 | speaker=aoko"
msgid "　教会から帰る時、商店街でお土産もらっちゃったー！"
msgstr "  I got some stuff from the arcade while on the way home from church!"

#. Occurrence 1DOT5_2:84:1238: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0001; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:84
msgctxt "text_id=1238 | speaker=aoko"
msgid "　<伊|い><勢|せ><屋|や>の<煎餅|せんべい>、一緒に食べないー！？」"
msgstr "  They're Iseya rice crackers, you wanna share some?\""

#. Occurrence 1DOT5_2:116:1239: scene=1DOT5_2
#: 1DOT5_2:116
msgctxt "text_id=1239 | speaker=unknown"
msgid "　夕日色に染まったロビーに<弾|はず>んだ声が響く。"
msgstr "  Her voice reverberated through the foyer dyed in the colors of the setting sun."

#. Occurrence 1DOT5_2:121:1240: scene=1DOT5_2
#: 1DOT5_2:121
msgctxt "text_id=1240 | speaker=unknown"
msgid "　制服姿の青子が元気よく帰ってきたのは午後五時過ぎ。"
msgstr "  It was after five in the afternoon when Aoko, still in her school uniform, cheerfully returned home."

#. Occurrence 1DOT5_2:126:1241: scene=1DOT5_2
#: 1DOT5_2:126
msgctxt "text_id=1241 | speaker=unknown"
msgid "　生徒会の雑務と、月に一度の教会との<折衝|せっしょう>を終えてからの帰宅だった。"
msgstr "  She had finished her student council duties and attended her monthly meeting with the church."

#. Occurrence 1DOT5_2:161:1242: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0000; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:161
msgctxt "text_id=1242 | speaker=alice"
msgid "「……おかえりなさい。"
msgstr "\"...Welcome back."

#. Occurrence 1DOT5_2:167:1243: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0001; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:167
msgctxt "text_id=1243 | speaker=alice"
msgid "　その様子なら何事もなく終わったみたいね、青子」"
msgstr "  I see that the meeting went as planned.\""

#. Occurrence 1DOT5_2:173:1244: scene=1DOT5_2
#: 1DOT5_2:173
msgctxt "text_id=1244 | speaker=unknown"
msgid "　出迎えの声は二階から。"
msgstr "  The voice was coming from the second floor."

#. Occurrence 1DOT5_2:178:1245: scene=1DOT5_2
#: 1DOT5_2:178
msgctxt "text_id=1245 | speaker=unknown"
msgid "　活力に満ちた青子とは対照的な、静けさの化身じみた少女が下りてくる。"
msgstr "  In contrast with Aoko and her boundless energy, a considerably calmer girl descended from above."

#. Occurrence 1DOT5_2:210:1246: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0002; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:210
msgctxt "text_id=1246 | speaker=aoko"
msgid "「難癖はつけられたけど、<滞|とどこお>りなく。"
msgstr "\"There were some complaints but all in all it went well."

#. Occurrence 1DOT5_2:216:1247: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0003; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:216
msgctxt "text_id=1247 | speaker=aoko"
msgid "　うちの問題はうちの問題だから、今回も手はださないって方向でまとまったわ。……それでいいのよね、有珠？」"
msgstr "  Our problems are ours alone, so I decided not to get them involved. You okay with that, Alice?\""

#. Occurrence 1DOT5_2:234:1248: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0002; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:234
msgctxt "text_id=1248 | speaker=alice"
msgid "「……ええ。ネコの手なら借りたいけど、あの人たちの手は信用ならないし。いつも通り、後処理だけお願いしましょう」"
msgstr "\"...Yes. I'd ask for their help in a pinch, but they can't be trusted. We'll call on them to clean up the mess, as usual.\""

#. Occurrence 1DOT5_2:268:1249: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0004; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:268
msgctxt "text_id=1249 | speaker=aoko"
msgid "「賛成。後ろからバッサリやられかねないしね。だいたい、私もアンタも背中を気にして没頭できる柄じゃないし」"
msgstr "\"Agreed. No one likes to have to keep looking over their shoulder. We can't fully commit to this if we're worried about what's going on elsewhere.\""

#. Occurrence 1DOT5_2:286:1250: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0003; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:286
msgctxt "text_id=1250 | speaker=alice"
msgid "「……わたしはできるけど。"
msgstr "\"...Well, I can, but..."

#. Occurrence 1DOT5_2:292:1251: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0004; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:292
msgctxt "text_id=1251 | speaker=alice"
msgid "　青子は単に、まだそれほどの余裕がないだけでしょう」"
msgstr "  You don't have time for that, do you, Aoko?\""

#. Occurrence 1DOT5_2:298:1252: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0005; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:298
msgctxt "text_id=1252 | speaker=aoko"
msgid "「む」"
msgstr "\"Hmph.\""

#. Occurrence 1DOT5_2:333:1253: scene=1DOT5_2
#: 1DOT5_2:333
msgctxt "text_id=1253 | speaker=unknown"
msgid "　かつん、かつん。"
msgstr "  Tap, tap."

#. Occurrence 1DOT5_2:338:1254: scene=1DOT5_2
#: 1DOT5_2:338
msgctxt "text_id=1254 | speaker=unknown"
msgid "　階段を下りる足音も<淑|しと>やかに、久遠寺有珠はロビーに到達する。"
msgstr "  With the graceful sounds of her steps, Alice entered the foyer."

#. Occurrence 1DOT5_2:343:1255: scene=1DOT5_2
#: 1DOT5_2:343
msgctxt "text_id=1255 | speaker=unknown"
msgid "　……その途中、天井の窓ガラスに目をやった事を青子は見逃さない。"
msgstr "  ...As she did, Aoko's eyes were directed toward the skylight above."

#. Occurrence 1DOT5_2:377:1256: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0006; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:377
msgctxt "text_id=1256 | speaker=aoko"
msgid "「ガラス、<曇|くも>ってるわね」"
msgstr "\"The glass is kind of dirty.\""

#. Occurrence 1DOT5_2:383:1257: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0005; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:383
msgctxt "text_id=1257 | speaker=alice"
msgid "「その事で話があるわ。今日の課題が終わったら、だけど。"
msgstr "\"I wanted to discuss that. After today's business is concluded, that is."

#. Occurrence 1DOT5_2:401:1258: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0006; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:401
msgctxt "text_id=1258 | speaker=alice"
msgid "　……青子、体の調子は？　疲れているなら休みを入れてもいいけど」"
msgstr "  ...Are you feeling okay, Aoko? You can rest if you're not.\""

#. Occurrence 1DOT5_2:407:1259: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0007; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:407
msgctxt "text_id=1259 | speaker=aoko"
msgid "「え？　なによ、気味悪いなあ。気遣いされるコトなんてないってば。いつも通りの一日だったし、そんな疲れた顔してる、私？」"
msgstr "\"Huh? Oh, don't be such a nag. I'm not stressed or anything. Today was pretty normal. Do I look that tired?\""

#. Occurrence 1DOT5_2:456:1260: scene=1DOT5_2
#: 1DOT5_2:456
msgctxt "text_id=1260 | speaker=unknown"
msgid "　そう。あえて言うなら、本日の学園生活、順風にして波高し。"
msgstr "  As school activities went, today's were a breeze."

#. Occurrence 1DOT5_2:485:1261: scene=1DOT5_2
#: 1DOT5_2:485
msgctxt "text_id=1261 | speaker=unknown"
msgid "　ざっと<俯瞰|ふかん>すればいつも通りの平和なスクールライフで、"
msgstr "  At a glance, her school life might have seemed almost idyllic."

#. Occurrence 1DOT5_2:521:1262: scene=1DOT5_2
#: 1DOT5_2:521
msgctxt "text_id=1262 | speaker=unknown"
msgid "　よくよく思い返すと微妙に頭の痛い出来事があったりして、"
msgstr "  Though the more she thought about it, some headache-inducing incidents may have stood out here and there."

#. Occurrence 1DOT5_2:556:1263: scene=1DOT5_2
#: 1DOT5_2:556
msgctxt "text_id=1263 | speaker=unknown"
msgid "　つきつめると精神的にちょい疲れているけど、それを意識するとよけい疲れるので避けたい青子なのだった。"
msgstr "  And with some sincere introspection, Aoko might have recognized the signs of her own mental fatigue, but doing so would have further added to her stress."

#. Occurrence 1DOT5_2:600:1264: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0008; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:600
msgctxt "text_id=1264 | speaker=aoko"
msgid "「……ストップ。なんで帰って来てまで、あんなののコトで疲れなくちゃいけないんだ、私。"
msgstr "\"Okay, enough about that. I didn't come home just to stress out over school."

#. Occurrence 1DOT5_2:611:1265: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0009; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:611
msgctxt "text_id=1265 | speaker=aoko"
msgid "　えっと、今日の課題って初歩の<暗示|ウィッシュ>でしょ？"
msgstr "  What were we learning about today...? Mesmerize basics, right? 'Wish'? "

#. Occurrence 1DOT5_2:622:1266: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0010; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:622
msgctxt "text_id=1266 | speaker=aoko"
msgid "　問題ないわ、すぐ始めましょ。今日はなんか、勢いでうまくいきそうな気もするし」"
msgstr "  Then let's get started. I feel like I could master anything today.\""

#. Occurrence 1DOT5_2:628:1267: scene=1DOT5_2
#: 1DOT5_2:628
msgctxt "text_id=1267 | speaker=unknown"
msgid "　おもに怒りとか、ストレス発散の方向で。"
msgstr "  Aoko focused on shedding her anger and stress,"

#. Occurrence 1DOT5_2:664:1268: scene=1DOT5_2
#: 1DOT5_2:664
msgctxt "text_id=1268 | speaker=unknown"
msgid "　青子はよし、と気合いをいれて二階に向かう。"
msgstr "  and headed upstairs with gusto."

#. Occurrence 1DOT5_2:670:1269: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0011; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:670
msgctxt "text_id=1269 | speaker=aoko"
msgid "「どうしたのよ。有珠の部屋でやるんじゃないの？」"
msgstr "\"Aren't you coming? I thought we were going to do it in your room, Alice?\""

#. Occurrence 1DOT5_2:676:1270: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0007; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:676
msgctxt "text_id=1270 | speaker=alice"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 1DOT5_2:681:1271: scene=1DOT5_2
#: 1DOT5_2:681
msgctxt "text_id=1271 | speaker=unknown"
msgid "　礼服の少女はそうだけど、とやや不満そうにうなずいて、"
msgstr "  The formally dressed Alice nodded in slight dissatisfaction."

#. Occurrence 1DOT5_2:698:1272: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0008; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:698
msgctxt "text_id=1272 | speaker=alice"
msgid "「それで、伊勢屋の煎餅って、今日の？」"
msgstr "\"Are we going to eat those Iseya rice crackers today, or...?\""

#. Occurrence 1DOT5_2:703:1273: scene=1DOT5_2
#: 1DOT5_2:703
msgctxt "text_id=1273 | speaker=unknown"
msgid "　青子の手にある、今日できあがったばかりの和菓子を見つめるのだった。"
msgstr "  She looked at the freshly baked treats Aoko was holding."

#. Occurrence 1DOT5_2:762:1274: scene=1DOT5_2
#: 1DOT5_2:762
msgctxt "text_id=1274 | speaker=unknown"
msgid "　結局、日課である有珠の授業は、軽くお茶をした後に行われた。"
msgstr "  In the end, their lesson took place after Alice had her cup of tea."

#. Occurrence 1DOT5_2:767:1275: scene=1DOT5_2
#: 1DOT5_2:767
msgctxt "text_id=1275 | speaker=unknown"
msgid "　まだまだ見習いである青子にとって、久遠寺有珠は同居人であると同時に得難い教師である。"
msgstr "  For an apprentice like Aoko, Alice Kuonji was the kind of roommate and teacher that was hard to come by."

#. Occurrence 1DOT5_2:772:1276: scene=1DOT5_2
#: 1DOT5_2:772
msgctxt "text_id=1276 | speaker=unknown"
msgid "　彼女が青子の健康をいたわって休みを入れると判断したのなら、大人しく従うしかない。"
msgstr "  If she insisted that Aoko rest to preserve her health, Aoko had no choice but to comply."

#. Occurrence 1DOT5_2:804:1277: scene=1DOT5_2
#: 1DOT5_2:804
msgctxt "text_id=1277 | speaker=unknown"
msgid "　授業は二時間で終了し、ふたりはそれぞれ用意しておいた夕食を済ませ、一日の締めである夕食後のひとときを過ごそう、と<河岸|かし>を変えた。"
msgstr "  The lesson was over after two hours, so the two finished the dinner they had prepared and decided on a change of venue for where they would spend the last hours of the day."

#. Occurrence 1DOT5_2:837:1278: scene=1DOT5_2
#: 1DOT5_2:837
msgctxt "text_id=1278 | speaker=unknown"
msgid "　サンルームは居間のとなり、美しい庭園が見渡せる屋敷の東側にあった。"
msgstr "  The sunroom was next to the drawing room in the east wing of the residence and offered a view of the beautiful grounds."

#. Occurrence 1DOT5_2:842:1279: scene=1DOT5_2
#: 1DOT5_2:842
msgctxt "text_id=1279 | speaker=unknown"
msgid "　豪華な居間に負けず劣らず、細かな気遣いと格調高い調度品で飾られた久遠寺邸自慢のサンルームは、しかし。"
msgstr "  The proud Kuonji estate's luxurious sunroom featured furnishings on par with those in the splendid drawing room. Meanwhile..."

#. Occurrence 1DOT5_2:877:1280: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0012; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:877
msgctxt "text_id=1280 | speaker=aoko"
msgid "「来年の夏はジャングルね、この分だと」"
msgstr "\"It's going to be a jungle come next year's summer.\""

#. Occurrence 1DOT5_2:883:1281: scene=1DOT5_2
#: 1DOT5_2:883
msgctxt "text_id=1281 | speaker=unknown"
msgid "　庭掃除という<意識|コマンド>が欠如した住人のせいで、色々と台無しだった。"
msgstr "  The grounds outside had fallen into disrepair, neglected by the owner."

#. Occurrence 1DOT5_2:915:1282: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0013; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:915
msgctxt "text_id=1282 | speaker=aoko"
msgid "「ねえ有珠、庭掃除専用のプロイとかいないの？」"
msgstr "\"Don't you have any landscaping Ploys lying around, Alice?\""

#. Occurrence 1DOT5_2:923:1283: scene=1DOT5_2
#: 1DOT5_2:923
msgctxt "text_id=1283 | speaker=unknown"
msgid "　一足先にサンルームに入り、ティーポットから紅茶を淹れる青子。"
msgstr "  Aoko took a step into the sunroom and poured some tea."

#. Occurrence 1DOT5_2:956:1284: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0009; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:956
msgctxt "text_id=1284 | speaker=alice"
msgid "「探せばいるかもしれないけど、少し手間ね」"
msgstr "\"I'm sure I could find one, but it would take some effort.\""

#. Occurrence 1DOT5_2:962:1285: scene=1DOT5_2
#: 1DOT5_2:962
msgctxt "text_id=1285 | speaker=unknown"
msgid "　同居人の<戯|ざ>れ言を流しながら、有珠も自分用の椅子に座ろうとし、"
msgstr "  Playing along with her roommate's joke, Alice made to sit in her chair,"

#. Occurrence 1DOT5_2:976:1286: scene=1DOT5_2
#: 1DOT5_2:976
msgctxt "text_id=1286 | speaker=unknown"
msgid "　テーブルの上に置かれたチョコレイトの箱を見て、<可憐|かれん>な眉を曇らせた。"
msgstr "  just as she caught sight of the box of chocolates on the table. Her lovely eyes narrowed in a frown."

#. Occurrence 1DOT5_2:1014:1287: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0014; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1014
msgctxt "text_id=1287 | speaker=aoko"
msgid "「な、なによ。言っとくけど、今日の失敗は半分有珠のせいよ？"
msgstr "\"D-Don't be like that. Today's screw-up was half your fault, you know?"

#. Occurrence 1DOT5_2:1026:1288: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0015; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1026
msgctxt "text_id=1288 | speaker=aoko"
msgid "　お煎餅で気が<緩|ゆる>んだのが敗因っていうか、そりゃ、<暗|ウィ><示|ッシュ>のつもりがガンドになっちゃったのは、我ながら攻撃的すぎると思うけど……」"
msgstr "  Maybe the rice crackers threw us off our game, or maybe it was me being too aggressive that turned that Wish into a Gandr, but still...\""

#. Occurrence 1DOT5_2:1037:1289: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0010; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:1037
msgctxt "text_id=1289 | speaker=alice"
msgid "「六個、減ってるわ」"
msgstr "\"We're down six pieces.\""

#. Occurrence 1DOT5_2:1048:1290: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0016; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1048
msgctxt "text_id=1290 | speaker=aoko"
msgid "「え？　なんだ、そっちのコトか」"
msgstr "\"We are? Wait, that's what you're upset about?\""

#. Occurrence 1DOT5_2:1073:1291: scene=1DOT5_2
#: 1DOT5_2:1073
msgctxt "text_id=1291 | speaker=unknown"
msgid "　青子はどれどれ、とチョコレイトの箱をのぞき見る。"
msgstr "  Aoko's eyes stared intently at the box of chocolates."

#. Occurrence 1DOT5_2:1091:1292: scene=1DOT5_2
#: 1DOT5_2:1091
msgctxt "text_id=1292 | speaker=unknown"
msgid "　世界中さがしても、この街の、この洋館にしかない高級洋菓子。"
msgstr "  You could search the world and never find a finer selection of chocolates."

#. Occurrence 1DOT5_2:1096:1293: scene=1DOT5_2
#: 1DOT5_2:1096
msgctxt "text_id=1293 | speaker=unknown"
msgid "　銘柄は<６|シックス>ペンスの唄、と言うらしい。"
msgstr "  The brand was Sixpence Songs, apparently."

#. Occurrence 1DOT5_2:1133:1294: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0017; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1133
msgctxt "text_id=1294 | speaker=aoko"
msgid "「で、鏡の話をするんだっけ？"
msgstr "\"So, what was it about the mirror you wanted to talk about?"

#. Occurrence 1DOT5_2:1140:1295: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0018; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1140
msgctxt "text_id=1295 | speaker=aoko"
msgid "　アレ、いま洋館モードから三咲モードになってるんでしょ？」"
msgstr "  It's still in Misaki mode, right? Not mansion mode?\""

#. Occurrence 1DOT5_2:1153:1296: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0011; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:1153
msgctxt "text_id=1296 | speaker=alice"
msgid "「ええ。ここの管理はおざなりになるけど、三咲市だけに切り替えたわ。……それが昨日から曇りだしている。"
msgstr "\"Yes. The mansion can take care of itself for the time being, so I changed its target to Misaki City. ...Things have been cloudy there since yesterday."

#. Occurrence 1DOT5_2:1159:1297: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0012; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:1159
msgctxt "text_id=1297 | speaker=alice"
msgid "　少しずつだけど、確実に包囲されてるわね」"
msgstr "  Now I know for certain that with each passing day, the forces arrayed against us grow.\""

#. Occurrence 1DOT5_2:1194:1298: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0019; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1194
msgctxt "text_id=1298 | speaker=aoko"
msgid "「包囲って、数が増えたってコト？」"
msgstr "\"You mean there's more of those things?\""

#. Occurrence 1DOT5_2:1200:1299: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0013; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:1200
msgctxt "text_id=1299 | speaker=alice"
msgid "「捕捉していた一名はもちろん、他にもう二名ほど不審者を目撃済み。都市部に一、郊外の森に二ね」"
msgstr "\"There's the one who was captured, and I've witnessed two other suspicious types. One in the city and one in the woods outside of town.\""

#. Occurrence 1DOT5_2:1233:1300: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0020; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1233
msgctxt "text_id=1300 | speaker=aoko"
msgid "「はあ。アンタの目撃談はアテになるからなあ。"
msgstr "\"Ugh. Is it too much to ask that you could be wrong, just this once?"

#. Occurrence 1DOT5_2:1239:1301: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0021; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1239
msgctxt "text_id=1301 | speaker=aoko"
msgid "　で、うるさいのはどっち？」"
msgstr "  Which one is causing the biggest ruckus?\""

#. Occurrence 1DOT5_2:1245:1302: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0014; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:1245
msgctxt "text_id=1302 | speaker=alice"
msgid "「……森の方。捕捉中だけど、こっちの目に気づいているみたい。なかなか誘いに乗ってこないわ」"
msgstr "\"...The one in the woods. I'm getting close to capturing it, but it knows it's being watched. It's not taking the bait.\""

#. Occurrence 1DOT5_2:1261:1303: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0022; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1261
msgctxt "text_id=1303 | speaker=aoko"
msgid "「そっか。"
msgstr "\"I see..."

#. Occurrence 1DOT5_2:1268:1304: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0023; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1268
msgctxt "text_id=1304 | speaker=aoko"
msgid "じゃあ今夜、仕掛ける？」"
msgstr "You wanna go after it tonight?\""

#. Occurrence 1DOT5_2:1289:1305: scene=1DOT5_2
#: 1DOT5_2:1289
msgctxt "text_id=1305 | speaker=unknown"
msgid "“今夜、仕掛ける”"
msgstr "  To go after it tonight..."

#. Occurrence 1DOT5_2:1295:1306: scene=1DOT5_2
#: 1DOT5_2:1295
msgctxt "text_id=1306 | speaker=unknown"
msgid "　それは彼女の人生を大きく、それこそまったく別のものに変化させる一大行事だ。"
msgstr "  One simple suggestion that would change the course of her life forever."

#. Occurrence 1DOT5_2:1300:1307: scene=1DOT5_2
#: 1DOT5_2:1300
msgctxt "text_id=1307 | speaker=unknown"
msgid "　大げさではなく、穴のあいたパラシュートで自由落下するぐらいの覚悟と冒険、適応資格アリナシを決めるダイス勝負。"
msgstr "  It was no overstatement to say that this was a roll of the dice that would decide whether she had the moxie to survive the experience of jumping out of a plane with a torn parachute."

#. Occurrence 1DOT5_2:1320:1308: scene=1DOT5_2
#: 1DOT5_2:1320
msgctxt "text_id=1308 | speaker=unknown"
msgid "　その恐れと迷いを、青子は紅茶と共にあっさり飲み下した。"
msgstr "  Aoko swallowed her hesitation and fear with a little tea."

#. Occurrence 1DOT5_2:1325:1309: scene=1DOT5_2
#: 1DOT5_2:1325
msgctxt "text_id=1309 | speaker=unknown"
msgid "　高校の創立記念日の夜、「もう決めた」と宣言して以来、彼女は心身共にキレイさっぱり切り替わっている。"
msgstr "  On the school's anniversary night, she declared that she had made up her mind, and from that time on, she would not waver."

#. Occurrence 1DOT5_2:1331:1310: scene=1DOT5_2
#: 1DOT5_2:1331
msgctxt "text_id=1310 | speaker=unknown"
msgid "　そんな同居人の強さを、有珠は伏し目がちに受け入れた。"
msgstr "  Alice welcomed her roommate's strength with the barest hint of regret."

#. Occurrence 1DOT5_2:1364:1311: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0015; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:1364
msgctxt "text_id=1311 | speaker=alice"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 1DOT5_2:1370:1312: scene=1DOT5_2
#: 1DOT5_2:1370
msgctxt "text_id=1312 | speaker=unknown"
msgid "　同居人の心のあり方は、同じ目的を持つ者として心強い。"
msgstr "  As someone who shared the same motivations as her, Alice was ultimately reassured by Aoko's resolve."

#. Occurrence 1DOT5_2:1375:1313: scene=1DOT5_2
#: 1DOT5_2:1375
msgctxt "text_id=1313 | speaker=unknown"
msgid "　いや、心強い、というより喜ばしい。"
msgstr "  Well, perhaps more pleased than reassured."

#. Occurrence 1DOT5_2:1380:1314: scene=1DOT5_2
#: 1DOT5_2:1380
msgctxt "text_id=1314 | speaker=unknown"
msgid "　なにしろ一年かけて、ようやく彼女が自分と同じステージに立ったのだから。"
msgstr "  All in all it had taken the better part of a year, but finally Aoko had stepped out of Alice's shadow."

#. Occurrence 1DOT5_2:1413:1315: scene=1DOT5_2
#: 1DOT5_2:1413
msgctxt "text_id=1315 | speaker=unknown"
msgid "　奇しくも同じ<結末|うんめい>を持った隣人。"
msgstr "  The two partners now shared the same fate."

#. Occurrence 1DOT5_2:1418:1316: scene=1DOT5_2
#: 1DOT5_2:1418
msgctxt "text_id=1316 | speaker=unknown"
msgid "　けれど相容れない相手。"
msgstr "  Aoko was not the partner Alice had asked for, but a partner nonetheless."

#. Occurrence 1DOT5_2:1423:1317: scene=1DOT5_2
#: 1DOT5_2:1423
msgctxt "text_id=1317 | speaker=unknown"
msgid "　所詮分かり合えない他人。"
msgstr "  Strangers, worlds apart."

#. Occurrence 1DOT5_2:1428:1318: scene=1DOT5_2
#: 1DOT5_2:1428
msgctxt "text_id=1318 | speaker=unknown"
msgid "　いずれ、互いが受け継いだ全ての遺産をもって殺し合う関係だとしても、まず対等にならなければ意味がない。"
msgstr "  And even if eventually they would battle each other to the death using all they had inherited, it was only right they did it on equal terms."

#. Occurrence 1DOT5_2:1434:1319: scene=1DOT5_2
#: 1DOT5_2:1434
msgctxt "text_id=1319 | speaker=unknown"
msgid "　だから今は、彼女の成長を喜ぶのが正しいのだ。"
msgstr "  It was, at least for now, a cause for celebration over how far Aoko had come."

#. Occurrence 1DOT5_2:1468:1320: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0016; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:1468
msgctxt "text_id=1320 | speaker=alice"
msgid "「……折角だけど、今夜はわたしひとりで十分よ。"
msgstr "\"...Generous, but I'll be fine on my own tonight."

#. Occurrence 1DOT5_2:1479:1321: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0017; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:1479
msgctxt "text_id=1321 | speaker=alice"
msgid "　そんな余裕があるのなら、貴女はもう少し暗示の練習をするべきね。公園は貴女の担当だから、その時は働いてもらうけど」"
msgstr "  The time would be better spent practicing Mesmerize a little more. The park is under your jurisdiction, so I'll put you to work when the time comes.\""

#. Occurrence 1DOT5_2:1499:1322: scene=1DOT5_2
#: 1DOT5_2:1499
msgctxt "text_id=1322 | speaker=unknown"
msgid "　有珠は青子を見ずに淡々と説明する。"
msgstr "  Alice did not so much as look at Aoko as she explained her reasons."

#. Occurrence 1DOT5_2:1504:1323: scene=1DOT5_2
#: 1DOT5_2:1504
msgctxt "text_id=1323 | speaker=unknown"
msgid "　今夜の敵の規模。"
msgstr "  The scale of the enemy she would face that night..."

#. Occurrence 1DOT5_2:1509:1324: scene=1DOT5_2
#: 1DOT5_2:1509
msgctxt "text_id=1324 | speaker=unknown"
msgid "　今後の予定。"
msgstr "  Her plans for Aoko..."

#. Occurrence 1DOT5_2:1514:1325: scene=1DOT5_2
#: 1DOT5_2:1514
msgctxt "text_id=1325 | speaker=unknown"
msgid "　おそらく二日後あたりになるであろう、蒼崎青子の<新|・><し|・><い|・>誕生日について。"
msgstr "  For in only two days from now, Aoko Aozaki would be reborn."

#. Occurrence 1DOT5_2:1549:1326: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0024; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1549
msgctxt "text_id=1326 | speaker=aoko"
msgid "「はいはい、わかりました」"
msgstr "\"Fine. Whatever you say.\""

#. Occurrence 1DOT5_2:1555:1327: scene=1DOT5_2
#: 1DOT5_2:1555
msgctxt "text_id=1327 | speaker=unknown"
msgid "　紅茶を飲み干し、席を立つ青子。"
msgstr "  Aoko finished her tea and stood up from her seat."

#. Occurrence 1DOT5_2:1581:1328: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0025; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1581
msgctxt "text_id=1328 | speaker=aoko"
msgid "「お言葉通り、暗示の練習でもやってるわ。"
msgstr "\"I guess I'm practicing, then."

#. Occurrence 1DOT5_2:1587:1329: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0026; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1587
msgctxt "text_id=1329 | speaker=aoko"
msgid "　えーと、一節目はたしか、“軽く、弱く。巧く、速く。チクタクチクタク　急げや急げ”よね？」"
msgstr "  Uhm, how did the first part go again? 'Be light and frail, nimble and fast. Tick-tock, tick-tock, there's no time to waste.' That right?\""

#. Occurrence 1DOT5_2:1593:1330: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0018; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:1593
msgctxt "text_id=1330 | speaker=alice"
msgid "「……はあ。そこは“空<気のおも|かるく　よわく>り、<胸のふるえ|うまく　はやく>。ひ<かりは|いそげやい><遅|そげ>れる、か<げは先立|チクタクチクタク>つ”よ。"
msgstr "\"Ugh, no. You're missing the quiet part. Remember, 'the weight of the air, the tremble of one's breast. Light lags behind while shadows pull ahead.'"

#. Occurrence 1DOT5_2:1599:1331: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0019; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:1599
msgctxt "text_id=1331 | speaker=alice"
msgid "　気をつけなさい。それだと逆に落ち着かなくなるわ」"
msgstr "  Be careful. Or you may find yourself in a state of unease.\""

#. Occurrence 1DOT5_2:1625:1332: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_2_0027; voice_prefix=A10; voice_category=1; scene=1DOT5_2
#: 1DOT5_2:1625
msgctxt "text_id=1332 | speaker=aoko"
msgid "「そうだったそうだった。んじゃ、ひとつ失礼」"
msgstr "\"Yeah, yeah, I remember now. Now, if you'll excuse me...\""

#. Occurrence 1DOT5_2:1631:1333: scene=1DOT5_2
#: 1DOT5_2:1631
msgctxt "text_id=1333 | speaker=unknown"
msgid "　チョコをひとつ<摘|つ>んで、ぽいっと口に<放|ほう>る。"
msgstr "  Aoko grabbed a piece of chocolate and popped it into her mouth."

#. Occurrence 1DOT5_2:1665:1334: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_2_0020; voice_prefix=A40; voice_category=2; scene=1DOT5_2
#: 1DOT5_2:1665
msgctxt "text_id=1334 | speaker=alice"
msgid "「……………………」"
msgstr "\"......\""

#. Occurrence 1DOT5_2:1671:1335: scene=1DOT5_2
#: 1DOT5_2:1671
msgctxt "text_id=1335 | speaker=unknown"
msgid "　手を振ってサンルームを去る青子を、有珠は無言で見送る。"
msgstr "  She waved before leaving Alice alone in silence."

#. Occurrence 1DOT5_2:1685:1336: scene=1DOT5_2
#: 1DOT5_2:1685
msgctxt "text_id=1336 | speaker=unknown"
msgid "　少女はしばし固まったあと、同居人のつまみ食いを<咎|とが>めるように、カチリと乱暴にチョコレイトの箱を閉じた。"
msgstr "  Alice stiffened a moment before slamming the box of chocolates shut as if it could serve to scold Aoko for snacking."

#. Occurrence 1DOT5_3:190:1337: voice_id=C50_1DOT5_3_0000; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:190
msgctxt "text_id=1337 | speaker=unknown"
msgid "　―――オハヨウ　ゴザイマス。"
msgstr "  GOOD MORNING."

#. Occurrence 1DOT5_3:197:1338: voice_id=C50_1DOT5_3_0001; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:197
msgctxt "text_id=1338 | speaker=unknown"
msgid "　午前零時ヲ　確認　シマシタ。"
msgstr "  TIME CHECK: 00:00"

#. Occurrence 1DOT5_3:259:1339: voice_id=C50_1DOT5_3_0002; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:259
msgctxt "text_id=1339 | speaker=unknown"
msgid "　前回更新ヨリ　二十四時間　経過。"
msgstr "  24 HOURS SINCE LAST UPDATE."

#. Occurrence 1DOT5_3:265:1340: voice_id=C50_1DOT5_3_0003; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:265
msgctxt "text_id=1340 | speaker=unknown"
msgid "　<安全管理|バックアップ>、開始。<行|レ><動|コ><記|ー><録|ド>、送信。"
msgstr "  RUNNING BACKUP... TRANSMITTING LOG..."

#. Occurrence 1DOT5_3:271:1341: voice_id=C50_1DOT5_3_0004; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:271
msgctxt "text_id=1341 | speaker=unknown"
msgid "　周囲ノ地形ヲ　<再確認|スキャン>　シマス。"
msgstr "  COMMENCING LOCAL SCAN..."

#. Occurrence 1DOT5_3:344:1342: voice_id=C50_1DOT5_3_0005; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:344
msgctxt "text_id=1342 | speaker=unknown"
msgid "　大気成分―――"
msgstr "  RUNNING ATMOSPHERIC ANALYSIS:"

#. Occurrence 1DOT5_3:350:1343: voice_id=C50_1DOT5_3_9001; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:350
msgctxt "text_id=1343 | speaker=unknown"
msgid "　窒素、異常ナシ。"
msgstr "  NITROGEN: NOMINAL."

#. Occurrence 1DOT5_3:356:1344: voice_id=C50_1DOT5_3_9002; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:356
msgctxt "text_id=1344 | speaker=unknown"
msgid "　酸素、異常ナシ。"
msgstr "  OXYGEN: NOMINAL."

#. Occurrence 1DOT5_3:362:1345: voice_id=C50_1DOT5_3_9003; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:362
msgctxt "text_id=1345 | speaker=unknown"
msgid "　アルゴン、異常ナシ。"
msgstr "  ARGON: NOMINAL."

#. Occurrence 1DOT5_3:368:1346: voice_id=C50_1DOT5_3_9004; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:368
msgctxt "text_id=1346 | speaker=unknown"
msgid "　二酸化炭素、異常ナシ。"
msgstr "  CARBON DIOXIDE: NOMINAL."

#. Occurrence 1DOT5_3:376:1347: voice_id=C50_1DOT5_3_0006; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:376
msgctxt "text_id=1347 | speaker=unknown"
msgid "　第五仮説要素―――異常／異常／異常／アリ。"
msgstr "  FIFTH THEORETICAL FACTOR: MULTIPLE ANOMALIES DETECTED."

#. Occurrence 1DOT5_3:399:1348: voice_id=C50_1DOT5_3_0007; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:399
msgctxt "text_id=1348 | speaker=unknown"
msgid "　周囲ノ時空連続体ニ　齟齬ヲ　確認。"
msgstr "  LOCAL SPACE-TIME DISCREPANCY DETECTED."

#. Occurrence 1DOT5_3:406:1349: voice_id=C50_1DOT5_3_0008; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:406
msgctxt "text_id=1349 | speaker=unknown"
msgid "　第一種　危険物トノ　遭遇ト　断定。"
msgstr "  CONCLUSION: CONTACT, CLASS 1 THREAT."

#. Occurrence 1DOT5_3:443:1350: voice_id=C50_1DOT5_3_0009; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:443
msgctxt "text_id=1350 | speaker=unknown"
msgid "　知覚領域ヲ　主観→客観ニ　変更。"
msgstr "  SHIFTING PERCEPTION RANGE FROM SUBJECTIVE TO OBJECTIVE..."

#. Occurrence 1DOT5_3:451:1351: voice_id=C50_1DOT5_3_0010; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:451
msgctxt "text_id=1351 | speaker=unknown"
msgid "　自律回路ヲ　予備電源　ニ　、"
msgstr "  SHIFTING AUTONOMOUS CIRCUIT TO RESERVE POWER..."

msgctxt "text_id=1352 | speaker=unknown"
msgid "　計測回路ヲ　主電源　ニ　変更。"
msgstr "  SHIFTING DIAGNOSTIC CIRCUIT TO MAIN POWER..."

#. Occurrence 1DOT5_3:461:1353: voice_id=C50_1DOT5_3_0011; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:461
msgctxt "text_id=1353 | speaker=unknown"
msgid "　<視覚|カメラ>ヲ　赤外線計測　カラ"
msgstr "  SHIFTING VIEW MODE..."

msgctxt "text_id=1354 | speaker=unknown"
msgid "　虚数線計測　ニ　変更。"
msgstr "  I.R. FILTER INACTIVE. i FILTER ACTIVE."

#. Occurrence 1DOT5_3:489:1355: voice_id=C50_1DOT5_3_0012; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:489
msgctxt "text_id=1355 | speaker=unknown"
msgid "　―――デハ。"
msgstr "  NOW, IT BEGINS."

#. Occurrence 1DOT5_3:495:1356: voice_id=C50_1DOT5_3_0013; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:495
msgctxt "text_id=1356 | speaker=unknown"
msgid "　コレヨリ　戦闘行為ノ　記述ヲ　開始シマス。"
msgstr "  INITIATING COMBAT LOG..."

#. Occurrence 1DOT5_3:503:1357: voice_id=C50_1DOT5_3_0014; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:503
msgctxt "text_id=1357 | speaker=unknown"
msgid "　主ヨ。"
msgstr "  OH, MASTER. "

msgctxt "text_id=1358 | speaker=unknown"
msgid "ドウカ我ガ身ヲ　護リタマエ。"
msgstr "PRESERVE ME FROM HARM."

#. Occurrence 1DOT5_3:571:1359: scene=1DOT5_3
#: 1DOT5_3:571
msgctxt "text_id=1359 | speaker=unknown"
msgid "　三咲市には森が多い。"
msgstr "  Misaki City was a thickly wooded area."

#. Occurrence 1DOT5_3:576:1360: scene=1DOT5_3
#: 1DOT5_3:576
msgctxt "text_id=1360 | speaker=unknown"
msgid "　都市開発は進んでいるが、郊外にはいまだ深い自然が息づいている。"
msgstr "  Urban development continued unabated, but Mother Nature still drew breath in its outskirts."

#. Occurrence 1DOT5_3:596:1361: scene=1DOT5_3
#: 1DOT5_3:596
msgctxt "text_id=1361 | speaker=unknown"
msgid "　<物知|ものし>りな樹木が伐採され、"
msgstr "  Wise old trees had been turned to lumber."

#. Occurrence 1DOT5_3:601:1362: scene=1DOT5_3
#: 1DOT5_3:601
msgctxt "text_id=1362 | speaker=unknown"
msgid "　温かな腐葉土が<拓|ひら>かれ、"
msgstr "  The leaves had begun to turn to mulch."

#. Occurrence 1DOT5_3:606:1363: scene=1DOT5_3
#: 1DOT5_3:606
msgctxt "text_id=1363 | speaker=unknown"
msgid "　不思議そうに首をかしげる小鳥たちが消え去っても、真に力のある<緑|みどり>は生き続ける。"
msgstr "  Even though the birds who curiously tilted their heads had moved on, the verdure lived on, a testament to its enduring strength."

#. Occurrence 1DOT5_3:612:1364: scene=1DOT5_3
#: 1DOT5_3:612
msgctxt "text_id=1364 | speaker=unknown"
msgid "　文明の光が、彼らの<培|つちか>ってきた年月を<侵|おか>すほどの強さになるその時まで、神秘の領域として有り続ける。"
msgstr "  Until the time came that the devouring light of civilization became powerful enough to encroach upon nature's mysterious domain."

#. Occurrence 1DOT5_3:659:1365: scene=1DOT5_3
#: 1DOT5_3:659
msgctxt "text_id=1365 | speaker=unknown"
msgid "　……この森もその一つ。"
msgstr "  These woods were no exception."

#. Occurrence 1DOT5_3:664:1366: scene=1DOT5_3
#: 1DOT5_3:664
msgctxt "text_id=1366 | speaker=unknown"
msgid "　手つかずのまま郊外に放置された三咲町と三咲丘の<境界|ボーダー>。"
msgstr "  The outlying border between Misaki City and Misaki Hills had been left untouched."

#. Occurrence 1DOT5_3:670:1367: scene=1DOT5_3
#: 1DOT5_3:670
msgctxt "text_id=1367 | speaker=unknown"
msgid "　今では住みかを追われた獣たちが細々と暮らす、地方都市ならどこにでもある、いたって<平均|ノーマル>な、帰らずの森である。"
msgstr "  Though driven from their nests and dens here, wildlife continued to subsist even today. No longer able to return to the days before man, this was just like any other forest situated next to a town."

#. Occurrence 1DOT5_3:714:1368: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0000_A; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:714
msgctxt "text_id=1368 | speaker=alice"
msgid "　　　"
msgstr "                      "

#. Occurrence 1DOT5_3:714:1369: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0000_A; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:714
msgctxt "text_id=1369 | speaker=alice"
msgid "Hey diddle diddle,"
msgstr "Hey diddle diddle,"

#. Occurrence 1DOT5_3:714:1370: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0000_A; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:714
msgctxt "text_id=1370 | speaker=alice"
msgid "　　　The cat and the fiddle,"
msgstr "                      The cat and the fiddle..."

#. Occurrence 1DOT5_3:752:1371: scene=1DOT5_3
#: 1DOT5_3:752
msgctxt "text_id=1371 | speaker=unknown"
msgid "　森には、既に冬が到来していた。"
msgstr "  Winter had arrived in the woods."

#. Occurrence 1DOT5_3:757:1372: scene=1DOT5_3
#: 1DOT5_3:757
msgctxt "text_id=1372 | speaker=unknown"
msgid "　<薄刃|カミソリ>のように肌を<削|そ>ぐ冷気。"
msgstr "  The chill cut like a razor,"

#. Occurrence 1DOT5_3:762:1373: scene=1DOT5_3
#: 1DOT5_3:762
msgctxt "text_id=1373 | speaker=unknown"
msgid "　膝元までにじりよる氷の気配。"
msgstr "  the icy air so thick it could reached one's bones."

#. Occurrence 1DOT5_3:768:1374: scene=1DOT5_3
#: 1DOT5_3:768
msgctxt "text_id=1374 | speaker=unknown"
msgid "　露出した<頬|ほほ>はこわばり、吐息は白い雲になって消えていく。"
msgstr "  Exposed cheeks stiffened, and wisps of breath formed swirls in the air before disappearing."

#. Occurrence 1DOT5_3:773:1375: scene=1DOT5_3
#: 1DOT5_3:773
msgctxt "text_id=1375 | speaker=unknown"
msgid "　気温にして摂氏一度。"
msgstr "  It was one degree above freezing."

#. Occurrence 1DOT5_3:778:1376: scene=1DOT5_3
#: 1DOT5_3:778
msgctxt "text_id=1376 | speaker=unknown"
msgid "　寒波は森全体に、大地や木々、獣たちに染み渡る。"
msgstr "  The cold snap penetrated every nook and cranny of the woods, from the ground, to the trees, to the wildlife."

#. Occurrence 1DOT5_3:838:1377: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0001_A; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:838
msgctxt "text_id=1377 | speaker=alice"
msgid "　　　　　　"
msgstr "                                "

#. Occurrence 1DOT5_3:838:1378: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0001_A; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:838
msgctxt "text_id=1378 | speaker=alice"
msgid "The cow jump'd over the moon,"
msgstr "The cow jump'd over the moon,"

#. Occurrence 1DOT5_3:838:1379: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0001_A; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:838
msgctxt "text_id=1379 | speaker=alice"
msgid "　　　　　　The little dog laugh'd"
msgstr "                                The little dog laugh'd..."

#. Occurrence 1DOT5_3:914:1380: scene=1DOT5_3
#: 1DOT5_3:914
msgctxt "text_id=1380 | speaker=unknown"
msgid "　昼の森は人々を立ち入らせず、"
msgstr "  The forest allowed nobody entry during the day."

#. Occurrence 1DOT5_3:919:1381: scene=1DOT5_3
#: 1DOT5_3:919
msgctxt "text_id=1381 | speaker=unknown"
msgid "　冬の森は獣たちすら眠らせる。"
msgstr "  During the winter, it willed the animals to slumber."

#. Occurrence 1DOT5_3:926:1382: scene=1DOT5_3
#: 1DOT5_3:926
msgctxt "text_id=1382 | speaker=unknown"
msgid "　漂う<夜気|やき>は亡霊の息そのものだ。"
msgstr "  The still evening air felt like the stagnant breath of the lingering dead."

#. Occurrence 1DOT5_3:931:1383: scene=1DOT5_3
#: 1DOT5_3:931
msgctxt "text_id=1383 | speaker=unknown"
msgid "　<月|つき><明|あ>かりを<呑|の>み、<一寸先|いっすんさき>の<崖|がけ>を隠し、迷いこんだ哀れな生贄を破滅させる。"
msgstr "  The forest consumed the moonlight, obscuring the sight of even the closest of precipices, and hastening the untimely doom of any soul unfortunate enough to become lost within."

#. Occurrence 1DOT5_3:951:1384: scene=1DOT5_3
#: 1DOT5_3:951
msgctxt "text_id=1384 | speaker=unknown"
msgid "　聞こえるのは<微|かす>かな風の音と、川のせせらぎ。"
msgstr "  The only noises to be heard were the whisperings of the wind and the murmurings of the stream."

#. Occurrence 1DOT5_3:956:1385: scene=1DOT5_3
#: 1DOT5_3:956
msgctxt "text_id=1385 | speaker=unknown"
msgid "　ここは<生命|いのち>を感じさせない<無窮|むきゅう>の闇。"
msgstr "  The immortal darkness stifled any sense of life."

#. Occurrence 1DOT5_3:961:1386: scene=1DOT5_3
#: 1DOT5_3:961
msgctxt "text_id=1386 | speaker=unknown"
msgid "　獣はおろか、人の息など有るはずがない。"
msgstr "  Not the breath of an animal, much less that of a person, was drawn in this place."

#. Occurrence 1DOT5_3:966:1387: scene=1DOT5_3
#: 1DOT5_3:966
msgctxt "text_id=1387 | speaker=unknown"
msgid "　だが、"
msgstr "  However..."

#. Occurrence 1DOT5_3:988:1388: scene=1DOT5_3
#: 1DOT5_3:988
msgctxt "text_id=1388 | speaker=unknown"
msgid "　その中を行く、不釣り合いな黒衣があった。"
msgstr "  A figure in black, not of this place, skulked within."

#. Occurrence 1DOT5_3:993:1389: scene=1DOT5_3
#: 1DOT5_3:993
msgctxt "text_id=1389 | speaker=unknown"
msgid "　霧の海に迷いこんだ小舟のような、あまりにも小さく弱々しいシルエット。"
msgstr "  It cast the tiniest, frailest of silhouettes, like a small boat lost in a sea of fog."

#. Occurrence 1DOT5_3:999:1390: scene=1DOT5_3
#: 1DOT5_3:999
msgctxt "text_id=1390 | speaker=unknown"
msgid "　たよりなげな足音が響く。"
msgstr "  Its trepidatious footsteps echoed through the woods."

#. Occurrence 1DOT5_3:1004:1391: scene=1DOT5_3
#: 1DOT5_3:1004
msgctxt "text_id=1391 | speaker=unknown"
msgid "　木々のヴェールを抜けるのは、紛れもなく、年若い人間の少女である。"
msgstr "  There, exiting the veil of trees, was the unmistakable likeness of a young girl."

#. Occurrence 1DOT5_3:1034:1392: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0002_A; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:1034
msgctxt "text_id=1392 | speaker=alice"
msgid "　　　　"
msgstr "                          "

#. Occurrence 1DOT5_3:1034:1393: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0002_A; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:1034
msgctxt "text_id=1393 | speaker=alice"
msgid "To see such craft,"
msgstr "To see such craft,"

#. Occurrence 1DOT5_3:1034:1394: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0002_A; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:1034
msgctxt "text_id=1394 | speaker=alice"
msgid "　　　　And the dish ran away with the spoon."
msgstr "                          And the dish ran away with the spoon."

#. Occurrence 1DOT5_3:1082:1395: voice_id=C20_1DOT5_3_0000; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1082
msgctxt "text_id=1395 | speaker=unknown"
msgid "　　　『来たぞ来たぞ』"
msgstr "      \"Someone's here, someone's here!\""

#. Occurrence 1DOT5_3:1088:1396: voice_id=C30_1DOT5_3_0000; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1088
msgctxt "text_id=1396 | speaker=unknown"
msgid "　　　　　　　　　　　　　　『居るぞ居るぞ！』"
msgstr "                            \"There they are, there they are!\""

#. Occurrence 1DOT5_3:1119:1397: voice_id=C20_1DOT5_3_0001; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1119
msgctxt "text_id=1397 | speaker=unknown"
msgid "　　『誰が誰が？』"
msgstr "    \"Who can they be, who can they be?\""

#. Occurrence 1DOT5_3:1125:1398: voice_id=C30_1DOT5_3_0001; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1125
msgctxt "text_id=1398 | speaker=unknown"
msgid "　　　　　　　　　　　『誰と誰が！』"
msgstr "                      \"Someone and someone!\""

#. Occurrence 1DOT5_3:1149:1399: voice_id=C20_1DOT5_3_0002; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1149
msgctxt "text_id=1399 | speaker=unknown"
msgid "　『お腹は減ったの？』"
msgstr "  \"Are you hungry?\""

#. Occurrence 1DOT5_3:1155:1400: voice_id=C30_1DOT5_3_0002; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1155
msgctxt "text_id=1400 | speaker=unknown"
msgid "　　　　　　　　　　　　　　　『お腹は鳴ったさ！』"
msgstr "                              \"I'm starving!\""

#. Occurrence 1DOT5_3:1198:1401: voice_id=C20_1DOT5_3_0003; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1198
msgctxt "text_id=1401 | speaker=unknown"
msgid "　　『どっちが食べる？』"
msgstr "    \"Which one should we eat?\""

#. Occurrence 1DOT5_3:1204:1402: voice_id=C30_1DOT5_3_0003; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1204
msgctxt "text_id=1402 | speaker=unknown"
msgid "　　　　　　　　　　　　　　『どっちも食べる！』"
msgstr "                            \"Let's eat them both!\""

#. Occurrence 1DOT5_3:1228:1403: voice_id=C20_1DOT5_3_0004; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1228
msgctxt "text_id=1403 | speaker=unknown"
msgid "　『キミは左手、』"
msgstr "  \"You take the left!\""

#. Occurrence 1DOT5_3:1234:1404: voice_id=C30_1DOT5_3_0004; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1234
msgctxt "text_id=1404 | speaker=unknown"
msgid "　　　　　　　　　　　『オマエは右手！』"
msgstr "                      \"You take the right!\""

#. Occurrence 1DOT5_3:1258:1405: voice_id=C20_1DOT5_3_0005; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1258
msgctxt "text_id=1405 | speaker=unknown"
msgid "　　『歓迎しないと、』"
msgstr "    \"We must welcome them!\""

#. Occurrence 1DOT5_3:1264:1406: voice_id=C30_1DOT5_3_0005; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1264
msgctxt "text_id=1406 | speaker=unknown"
msgid "　　　　　　　　　　　　　　　　『感激しないと！』"
msgstr "                                \"We must entertain them!\""

#. Occurrence 1DOT5_3:1292:1407: voice_id=X10_1DOT5_3_0000; voice_prefix=X10; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1292
msgctxt "text_id=1407 | speaker=unknown"
msgid "　　　　　『『なにしろようやく楽しいお客！』』"
msgstr "          \"\"After all, we don't often have guests!\"\""

#. Occurrence 1DOT5_3:1370:1408: voice_id=C20_1DOT5_3_0006; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1370
msgctxt "text_id=1408 | speaker=unknown"
msgid "　　　　　　　『ついでにお<腹|なか>と<頸骨|けいこつ>も、』"
msgstr "              \"While we're at it, the stomach and the tibia.\""

#. Occurrence 1DOT5_3:1376:1409: voice_id=C30_1DOT5_3_0006; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1376
msgctxt "text_id=1409 | speaker=unknown"
msgid "　　　　　『せっかくだからよく噛まないと！』"
msgstr "          \"It's not often we get to chew the fat!\""

#. Occurrence 1DOT5_3:1451:1410: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0003; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:1451
msgctxt "text_id=1410 | speaker=alice"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 1DOT5_3:1457:1411: scene=1DOT5_3
#: 1DOT5_3:1457
msgctxt "text_id=1411 | speaker=unknown"
msgid "　木々の影が不気味に笑う。"
msgstr "  The shadows in the trees laughed ominously."

#. Occurrence 1DOT5_3:1462:1412: scene=1DOT5_3
#: 1DOT5_3:1462
msgctxt "text_id=1412 | speaker=unknown"
msgid "　幻聴か。錯覚か。あるいは<本|・><物|・>か。"
msgstr "  A hallucination? An illusion? Or perhaps... Something real?"

#. Occurrence 1DOT5_3:1467:1413: scene=1DOT5_3
#: 1DOT5_3:1467
msgctxt "text_id=1413 | speaker=unknown"
msgid "　少女の歩みに合わせて、寄り添う影がパタパタはしゃぐ。"
msgstr "  The shadows frolicked in time to the girl's pace."

#. Occurrence 1DOT5_3:1511:1414: voice_id=C20_1DOT5_3_8001; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1511
msgctxt "text_id=1414 | speaker=unknown"
msgid "『さあさあ、さあさあ』"
msgstr "\"Come, come!\""

#. Occurrence 1DOT5_3:1518:1415: voice_id=C30_1DOT5_3_8001; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1518
msgctxt "text_id=1415 | speaker=unknown"
msgid "『もっと奥へ、もっと奥へ！』"
msgstr " \"Deeper and deeper!\""

#. Occurrence 1DOT5_3:1525:1416: voice_id=C20_1DOT5_3_0008; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1525
msgctxt "text_id=1416 | speaker=unknown"
msgid "『ところでダイスは細工済み？』"
msgstr "\"Did you remember to rig the dice?\""

#. Occurrence 1DOT5_3:1531:1417: voice_id=C30_1DOT5_3_0008; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1531
msgctxt "text_id=1417 | speaker=unknown"
msgid "『お<胃|なか>の重いローデッド』"
msgstr "\"Loaded innards, they have.\""

#. Occurrence 1DOT5_3:1537:1418: voice_id=C20_1DOT5_3_0009; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1537
msgctxt "text_id=1418 | speaker=unknown"
msgid "『はじっこ<囓|かじ>ったエッジワーク！』"
msgstr "\"Nibbled around the edges, they be!\""

#. Occurrence 1DOT5_3:1544:1419: voice_id=C30_1DOT5_3_0009; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1544
msgctxt "text_id=1419 | speaker=unknown"
msgid "『どうでもいいけど、<肝心|かんじん><要|かなめ>の六の目だけはださないように！』"
msgstr "\"Just remember, don't roll that vital six!\""

#. Occurrence 1DOT5_3:1612:1420: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0004; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:1612
msgctxt "text_id=1420 | speaker=alice"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 1DOT5_3:1618:1421: scene=1DOT5_3
#: 1DOT5_3:1618
msgctxt "text_id=1421 | speaker=unknown"
msgid "　少女の眉が、かすかに歪む。"
msgstr "  The girl knitted her eyebrows."

#. Occurrence 1DOT5_3:1623:1422: scene=1DOT5_3
#: 1DOT5_3:1623
msgctxt "text_id=1422 | speaker=unknown"
msgid "　聞こえる筈のない声、"
msgstr "  She heard voices and felt the presence of things that should not be."

#. Occurrence 1DOT5_3:1628:1423: scene=1DOT5_3
#: 1DOT5_3:1628
msgctxt "text_id=1423 | speaker=unknown"
msgid "　いる筈のない獣の気配に怯えるように？"
msgstr "  Scary enough to frighten this particular girl?"

#. Occurrence 1DOT5_3:1633:1424: scene=1DOT5_3
#: 1DOT5_3:1633
msgctxt "text_id=1424 | speaker=unknown"
msgid "　まさか。"
msgstr "  As if."

#. Occurrence 1DOT5_3:1638:1425: scene=1DOT5_3
#: 1DOT5_3:1638
msgctxt "text_id=1425 | speaker=unknown"
msgid "　きつく結ばれた唇には、微塵の恐れもありはしない。"
msgstr "  Her tightly pursed lips betrayed not a hint of fear."

#. Occurrence 1DOT5_3:1720:1426: scene=1DOT5_3
#: 1DOT5_3:1720
msgctxt "text_id=1426 | speaker=unknown"
msgid "　少女の歩みは自らの意志によるもの。"
msgstr "  The girl walked of her own volition."

#. Occurrence 1DOT5_3:1725:1427: scene=1DOT5_3
#: 1DOT5_3:1725
msgctxt "text_id=1427 | speaker=unknown"
msgid "　恐怖があるのなら、そもそも足は進ませない。"
msgstr "  If she had truly felt fear, her legs would be frozen."

#. Occurrence 1DOT5_3:1730:1428: scene=1DOT5_3
#: 1DOT5_3:1730
msgctxt "text_id=1428 | speaker=unknown"
msgid "　木々の奥。"
msgstr "  Deep within the trees..."

#. Occurrence 1DOT5_3:1735:1429: scene=1DOT5_3
#: 1DOT5_3:1735
msgctxt "text_id=1429 | speaker=unknown"
msgid "　夜気に隠れながら見つめてくる二体の人影に、少女はきちんと気づいている。"
msgstr "  She was perfectly aware of the two humanoid figures stalking her through the still, night air."

#. Occurrence 1DOT5_3:1761:1430: voice_id=C20_1DOT5_3_0010; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1761
msgctxt "text_id=1430 | speaker=unknown"
msgid "『見たぞ見たぞ』"
msgstr "\"I saw them, I saw them!\""

#. Occurrence 1DOT5_3:1767:1431: voice_id=C30_1DOT5_3_0010; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1767
msgctxt "text_id=1431 | speaker=unknown"
msgid "『来るぞ来るぞ！』"
msgstr "\"They're coming, they're coming!\""

#. Occurrence 1DOT5_3:1773:1432: voice_id=C20_1DOT5_3_0011; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1773
msgctxt "text_id=1432 | speaker=unknown"
msgid "『もう諦めろ』"
msgstr "\"Give up!\""

#. Occurrence 1DOT5_3:1779:1433: voice_id=C30_1DOT5_3_0011; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1779
msgctxt "text_id=1433 | speaker=unknown"
msgid "『もう帰れない！』"
msgstr "\"There's no going back!\""

#. Occurrence 1DOT5_3:1867:1434: voice_id=C20_1DOT5_3_0012; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1867
msgctxt "text_id=1434 | speaker=unknown"
msgid "　　　　　　『あんなに教えてあげたのに』"
msgstr "            \"We warned you!\""

#. Occurrence 1DOT5_3:1938:1435: voice_id=C30_1DOT5_3_0012; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:1938
msgctxt "text_id=1435 | speaker=unknown"
msgid "　　　　　『<余|よ><所|そ>に消えないオマエが悪い！』"
msgstr "          \"It's your fault for staying!\""

#. Occurrence 1DOT5_3:2019:1436: scene=1DOT5_3
#: 1DOT5_3:2019
msgctxt "text_id=1436 | speaker=unknown"
msgid "　少女の歩みが止まる。"
msgstr "  The girl halted her steps."

#. Occurrence 1DOT5_3:2024:1437: scene=1DOT5_3
#: 1DOT5_3:2024
msgctxt "text_id=1437 | speaker=unknown"
msgid "　<蠢|うごめ>いていた二人分の声も止まる。"
msgstr "  The racket from the accompanying voices died in turn."

#. Occurrence 1DOT5_3:2029:1438: scene=1DOT5_3
#: 1DOT5_3:2029
msgctxt "text_id=1438 | speaker=unknown"
msgid "　小川のせせらぎが、たき火の<爆|は>ぜ音のように聞こえる。"
msgstr "  The babbling brook suddenly sounded like a crackling fire."

#. Occurrence 1DOT5_3:2070:1439: scene=1DOT5_3
#: 1DOT5_3:2070
msgctxt "text_id=1439 | speaker=unknown"
msgid "　そうして。"
msgstr "  And then..."

#. Occurrence 1DOT5_3:2075:1440: scene=1DOT5_3
#: 1DOT5_3:2075
msgctxt "text_id=1440 | speaker=unknown"
msgid "　<踝|くるぶし>ほどの小さな川の向こうに、街はおろか、この森にすら<在|あ>ってはならないモノが現れた。"
msgstr "  Across the shallow stream, something appeared that should not exist in the city, much less these woods."

#. Occurrence 1DOT5_3:2198:1441: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0005; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:2198
msgctxt "text_id=1441 | speaker=alice"
msgid "「今晩は。話の分かる<主人|ひと>はいる？」"
msgstr "\"Good evening. I don't suppose I could speak to your master?\""

#. Occurrence 1DOT5_3:2204:1442: scene=1DOT5_3
#: 1DOT5_3:2204
msgctxt "text_id=1442 | speaker=unknown"
msgid "　少女は平然と語りかける。"
msgstr "  The girl addressed them calmly."

#. Occurrence 1DOT5_3:2209:1443: scene=1DOT5_3
#: 1DOT5_3:2209
msgctxt "text_id=1443 | speaker=unknown"
msgid "　二人の口裂け男は<蝸牛|かぎゅう>のように、じりじりとにじり寄る。"
msgstr "  These men with their Glasgow grins creeped toward her like two slugs."

#. Occurrence 1DOT5_3:2243:1444: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0006; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:2243
msgctxt "text_id=1444 | speaker=alice"
msgid "「……そう。ただの<墓守|はかもり>、監視だけが仕事なのね。"
msgstr "\"...I see. Simple graveyard wards, sent to be lookouts."

#. Occurrence 1DOT5_3:2249:1445: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0007; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:2249
msgctxt "text_id=1445 | speaker=alice"
msgid "　失敗したわ。これなら青子に任せれば良かった。"
msgstr "  My mistake. I should have entrusted this to Aoko."

#. Occurrence 1DOT5_3:2266:1446: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0008; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:2266
msgctxt "text_id=1446 | speaker=alice"
msgid "　ああ、けど―――」"
msgstr "  However...\""

#. Occurrence 1DOT5_3:2304:1447: scene=1DOT5_3
#: 1DOT5_3:2304
msgctxt "text_id=1447 | speaker=unknown"
msgid "　一方の口裂け男は立ったまま。"
msgstr "  The one grinning man stood still."

#. Occurrence 1DOT5_3:2309:1448: scene=1DOT5_3
#: 1DOT5_3:2309
msgctxt "text_id=1448 | speaker=unknown"
msgid "　もう一方の口裂け男は、我慢できないとばかりに、ぐらりと体を<傾|かたむ>かせる。"
msgstr "  The other, shaking violently as if unable to contain himself any longer, turned toward the girl."

#. Occurrence 1DOT5_3:2330:1449: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0009; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:2330
msgctxt "text_id=1449 | speaker=alice"
msgid "「青子にはまだ荷が重いわね。"
msgstr "\"Aoko still has a lot on her plate."

#. Occurrence 1DOT5_3:2336:1450: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0010; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:2336
msgctxt "text_id=1450 | speaker=alice"
msgid "　そんな姿だけど、貴方たちは一人前の魔術師のようだし」"
msgstr "  Although you far from look the part, you seem to be on the level of a fully-fledged mage.\""

#. Occurrence 1DOT5_3:2396:1451: scene=1DOT5_3
#: 1DOT5_3:2396
msgctxt "text_id=1451 | speaker=unknown"
msgid "　黒衣が動く。"
msgstr "  Her black outfit stirred."

#. Occurrence 1DOT5_3:2401:1452: scene=1DOT5_3
#: 1DOT5_3:2401
msgctxt "text_id=1452 | speaker=unknown"
msgid "　少女の右手には、夜なお深い<硝子|ガラス>の猫。"
msgstr "  In her right hand she held a vitreous cat, darker than the deepest night."

#. Occurrence 1DOT5_3:2452:1453: voice_id=C50_1DOT5_3_0015; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:2452
msgctxt "text_id=1453 | speaker=unknown"
msgid "“…………？”"
msgstr "\"...?\""

#. Occurrence 1DOT5_3:2458:1454: scene=1DOT5_3
#: 1DOT5_3:2458
msgctxt "text_id=1454 | speaker=unknown"
msgid "　こぼれたものは、小さな警戒と、脈絡のない<畏|おそ>れだった。"
msgstr "  The two Glasgow men let out a yelp of caution and incoherent fear."

#. Occurrence 1DOT5_3:2463:1455: scene=1DOT5_3
#: 1DOT5_3:2463
msgctxt "text_id=1455 | speaker=unknown"
msgid "　二体の口裂け男はこの時、ようやく自らの<感情|いし>を表し、"
msgstr "  It was at this moment that they finally bared their intent and emotion."

#. Occurrence 1DOT5_3:2488:1456: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0011; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:2488
msgctxt "text_id=1456 | speaker=alice"
msgid "「さようなら、お客様。"
msgstr "\"Farewell, my guests."

#. Occurrence 1DOT5_3:2494:1457: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0012; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:2494
msgctxt "text_id=1457 | speaker=alice"
msgid "　きっと一瞬だろうから、お<別|わか>れだけ言っておくわ」"
msgstr "  Since this will take but a moment, I offer only a good-bye.\""

#. Occurrence 1DOT5_3:2563:1458: scene=1DOT5_3
#: 1DOT5_3:2563
msgctxt "text_id=1458 | speaker=unknown"
msgid "　その言葉に、彼等は明確に戦慄した。"
msgstr "  The two shuddered at her words."

#. Occurrence 1DOT5_3:2631:1459: scene=1DOT5_3
#: 1DOT5_3:2631
msgctxt "text_id=1459 | speaker=unknown"
msgid "　そもそも彼らには耳と口と脳がない。だから言葉なんて必要ない。"
msgstr "  They had no mouths, nor ears or brains to begin with. For creatures like these, words were redundant."

#. Occurrence 1DOT5_3:2636:1460: scene=1DOT5_3
#: 1DOT5_3:2636
msgctxt "text_id=1460 | speaker=unknown"
msgid "　彼らにとって有るものは“この瞬間”だけ。"
msgstr "  All that existed was the present."

#. Occurrence 1DOT5_3:2641:1461: scene=1DOT5_3
#: 1DOT5_3:2641
msgctxt "text_id=1461 | speaker=unknown"
msgid "　恐怖も、期待も、心のない彼等にとって起こりえない“<未|き><来|ぼう>”でしかない。"
msgstr "  For these soulless creatures, fears and hopes were nothing more than an unimaginable future."

#. Occurrence 1DOT5_3:2708:1462: scene=1DOT5_3
#: 1DOT5_3:2708
msgctxt "text_id=1462 | speaker=unknown"
msgid "　なのに、彼らは予感したのだ。"
msgstr "  Then what could be this feeling of foreboding they felt?"

#. Occurrence 1DOT5_3:2713:1463: scene=1DOT5_3
#: 1DOT5_3:2713
msgctxt "text_id=1463 | speaker=unknown"
msgid "　たった今、そしてこれから、身の毛のよだつ奇跡が、自分たちをメチャクチャにする―――"
msgstr "  ...The spine-chilling miracle that would rip them to pieces not moments from now."

#. Occurrence 1DOT5_3:2882:1464: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0013; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:2882
msgctxt "text_id=1464 | speaker=alice"
msgid "「さあ―――ごっこ遊びをしましょう、お人形さん」"
msgstr "\"Come then, puppets, let us play make-believe.\""

#. Occurrence 1DOT5_3:2912:1465: scene=1DOT5_3
#: 1DOT5_3:2912
msgctxt "text_id=1465 | speaker=unknown"
msgid "　白い森に、鐘のような<夜|うた>が響く。"
msgstr "  Her song sounded like a bell, echoing through the white woods."

#. Occurrence 1DOT5_3:2917:1466: scene=1DOT5_3
#: 1DOT5_3:2917
msgctxt "text_id=1466 | speaker=unknown"
msgid "　森を凍らせていた寒波が、少女の声に吹き消されていく。"
msgstr "  The girl's voice vanquished the frost that had gripped the trees."

#. Occurrence 1DOT5_3:2922:1467: scene=1DOT5_3
#: 1DOT5_3:2922
msgctxt "text_id=1467 | speaker=unknown"
msgid "　そして、"
msgstr "  Then..."

#. Occurrence 1DOT5_3:3026:1468: voice_id=C20_1DOT5_3_0013; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:3026
msgctxt "text_id=1468 | speaker=unknown"
msgid "　　　　　『いやいやずいぶん待たされた！』"
msgstr "          \"Come on, don't keep us waiting!\""

#. Occurrence 1DOT5_3:3032:1469: voice_id=C30_1DOT5_3_0013; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:3032
msgctxt "text_id=1469 | speaker=unknown"
msgid "　　　　　『さあ―――赤ずきんの登場だ！』"
msgstr "          \"Come on, it's time for Little Red Riding Hood!\""

#. Occurrence 1DOT5_3:3053:1470: scene=1DOT5_3
#: 1DOT5_3:3053
msgctxt "text_id=1470 | speaker=unknown"
msgid "　<夜の饗宴|ディドルディドル>の幕が<開|あ>く。"
msgstr "  The curtains opened on Diddle Diddle, the Banquet of the Night."

#. Occurrence 1DOT5_3:3058:1471: scene=1DOT5_3
#: 1DOT5_3:3058
msgctxt "text_id=1471 | speaker=unknown"
msgid "　一方の口裂け男は混乱して少女へと襲いかかる。"
msgstr "  In confusion, one slit-mouthed man swooped toward the girl."

#. Occurrence 1DOT5_3:3063:1472: scene=1DOT5_3
#: 1DOT5_3:3063
msgctxt "text_id=1472 | speaker=unknown"
msgid "　一方の口裂け男は恐怖から<森|うしろ>へと走り出す。"
msgstr "  In fear, the other fled into the woods behind him."

#. Occurrence 1DOT5_3:3221:1473: scene=1DOT5_3
#: 1DOT5_3:3221
msgctxt "text_id=1473 | speaker=unknown"
msgid "　水しぶきをあげ、少女に躍りかかる<奇形|きけい>の人影。"
msgstr "  The deformed humanoid darted forth, kicking up water as it rushed the girl."

#. Occurrence 1DOT5_3:3226:1474: scene=1DOT5_3
#: 1DOT5_3:3226
msgctxt "text_id=1474 | speaker=unknown"
msgid "　少女は知っている。"
msgstr "  She already knew what this fiend was."

#. Occurrence 1DOT5_3:3231:1475: scene=1DOT5_3
#: 1DOT5_3:3231
msgctxt "text_id=1475 | speaker=unknown"
msgid "　この口裂け男の両手はハサミで、心は子鬼。"
msgstr "  The grinning figure had scissors for hands and a demon's heart."

#. Occurrence 1DOT5_3:3236:1476: scene=1DOT5_3
#: 1DOT5_3:3236
msgctxt "text_id=1476 | speaker=unknown"
msgid "　捕まえた子供を容赦なく、胴体からまっぷたつに切る悪魔だと。"
msgstr "  It was a wretch who kidnapped children, mercilessly rendering them into pieces."

#. Occurrence 1DOT5_3:3317:1477: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0014; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:3317
msgctxt "text_id=1477 | speaker=alice"
msgid "「トゥィードル」"
msgstr "\"Tweedle.\""

#. Occurrence 1DOT5_3:3323:1478: voice_id=C20_1DOT5_3_0014; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:3323
msgctxt "text_id=1478 | speaker=unknown"
msgid "『お任せお任せ！』"
msgstr "\"Leave it to us!\""

#. Occurrence 1DOT5_3:3330:1479: voice_id=C30_1DOT5_3_0014; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:3330
msgctxt "text_id=1479 | speaker=unknown"
msgid "『ようやく出番だ、あらよっと！』"
msgstr "\"It's finally our turn!\""

#. Occurrence 1DOT5_3:3445:1480: scene=1DOT5_3
#: 1DOT5_3:3445
msgctxt "text_id=1480 | speaker=unknown"
msgid "　飛びだした子豚は<手鞠|てまり>のように。"
msgstr "  The piglets bounded and rebounded, like paddle balls."

#. Occurrence 1DOT5_3:3450:1481: scene=1DOT5_3
#: 1DOT5_3:3450
msgctxt "text_id=1481 | speaker=unknown"
msgid "　一メートルほどのぬいぐるみは、木々の合間を躍りながらすり抜けていく。"
msgstr "  The stuffed animals, over three feet in length, jumped and weaved their way between the trees."

#. Occurrence 1DOT5_3:3601:1482: scene=1DOT5_3
#: 1DOT5_3:3601
msgctxt "text_id=1482 | speaker=unknown"
msgid "　そんな怪異を前にしても、口裂け男に迷いはない。"
msgstr "  Even with these strange creatures before him, the grinning man did not so much as blink."

#. Occurrence 1DOT5_3:3606:1483: scene=1DOT5_3
#: 1DOT5_3:3606
msgctxt "text_id=1483 | speaker=unknown"
msgid "　男の両腕が上がる。長いコートの袖から現れたものは、人間の腕ではない。"
msgstr "  He raised his arms, but what emerged from his coat sleeves were not the human appendages you would expect."

#. Occurrence 1DOT5_3:3611:1484: scene=1DOT5_3
#: 1DOT5_3:3611
msgctxt "text_id=1484 | speaker=unknown"
msgid "　刃渡り五十センチを超える、凶悪な<出|デ><刃|バ><包丁|ソード>。"
msgstr "  In their place, fiendish cleavers, more than a foot and a half in length."

#. Occurrence 1DOT5_3:3616:1485: scene=1DOT5_3
#: 1DOT5_3:3616
msgctxt "text_id=1485 | speaker=unknown"
msgid "　今まで多くのエモノを切り裂いてきた両腕が、跳び<交|か>う子豚たちを正面から両断する。"
msgstr "  These appendages, which had torn so much of their prey to pieces, sliced cleanly through the flying pigs' skulls."

#. Occurrence 1DOT5_3:3734:1486: voice_id=C60_1DOT5_3_0000; voice_prefix=C60; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:3734
msgctxt "text_id=1486 | speaker=unknown"
msgid "“―――！？”"
msgstr "\"-?!\""

#. Occurrence 1DOT5_3:3740:1487: scene=1DOT5_3
#: 1DOT5_3:3740
msgctxt "text_id=1487 | speaker=unknown"
msgid "　口裂け男の手足が凍る。"
msgstr "  His limbs froze in place."

#. Occurrence 1DOT5_3:3745:1488: scene=1DOT5_3
#: 1DOT5_3:3745
msgctxt "text_id=1488 | speaker=unknown"
msgid "　切られた子豚の体が割れる。"
msgstr "  The pigs' bodies were sliced perfectly in half."

#. Occurrence 1DOT5_3:3789:1489: scene=1DOT5_3
#: 1DOT5_3:3789
msgctxt "text_id=1489 | speaker=unknown"
msgid "　がちん、と。"
msgstr "  And then..."

#. Occurrence 1DOT5_3:3794:1490: scene=1DOT5_3
#: 1DOT5_3:3794
msgctxt "text_id=1490 | speaker=unknown"
msgid "　頭から尾っぽまで断たれた子豚は、そのまま巨大なワニの口になって、口裂け男の腕に噛みついた。"
msgstr "  Bisected from head to tail, the pigs' innards became as alligator jaws and clamped down upon the grinning man's arms."

#. Occurrence 1DOT5_3:3814:1491: scene=1DOT5_3
#: 1DOT5_3:3814
msgctxt "text_id=1491 | speaker=unknown"
msgid "　文字通り、肩口まで丸飲みである。"
msgstr "  From fingertips to shoulders, they were swallowed whole."

#. Occurrence 1DOT5_3:3819:1492: scene=1DOT5_3
#: 1DOT5_3:3819
msgctxt "text_id=1492 | speaker=unknown"
msgid "　それだけで男から全身の自由が消失した。"
msgstr "  It was all it took to rob the man of control over his entire body."

#. Occurrence 1DOT5_3:3849:1493: voice_id=C60_1DOT5_3_0001; voice_prefix=C60; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:3849
msgctxt "text_id=1493 | speaker=unknown"
msgid "“―――、―――！”"
msgstr "\"-, -!\""

#. Occurrence 1DOT5_3:3854:1494: scene=1DOT5_3
#: 1DOT5_3:3854
msgctxt "text_id=1494 | speaker=unknown"
msgid "　走る<怖気|おぞけ>。"
msgstr "  Another shiver of fear."

#. Occurrence 1DOT5_3:3859:1495: scene=1DOT5_3
#: 1DOT5_3:3859
msgctxt "text_id=1495 | speaker=unknown"
msgid "　コレは子豚の使い魔ではない。"
msgstr "  These were no mere pig familiars."

#. Occurrence 1DOT5_3:3864:1496: scene=1DOT5_3
#: 1DOT5_3:3864
msgctxt "text_id=1496 | speaker=unknown"
msgid "　子豚のカタチをした、<文房具|ホッチキス>の化け物である事を、口裂け男は瞬時に理解した。"
msgstr "  Immediately he realized that these were stapler monsters disguised as mere pigs."

#. Occurrence 1DOT5_3:3922:1497: voice_id=C20_1DOT5_3_0015; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:3922
msgctxt "text_id=1497 | speaker=unknown"
msgid "『捕まえたのはダムでした！』"
msgstr "\"I got him!\""

#. Occurrence 1DOT5_3:3930:1498: voice_id=C30_1DOT5_3_0015; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:3930
msgctxt "text_id=1498 | speaker=unknown"
msgid "『捕まえたのはディーだってば！』"
msgstr "\"No, I got him!\""

#. Occurrence 1DOT5_3:3939:1499: voice_id=C20_1DOT5_3_0016; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:3939
msgctxt "text_id=1499 | speaker=unknown"
msgid "『ああでも残念、ご主人様は無口で無情で無関心！』"
msgstr "\"Oh, but too bad Master has no words, no emotion, no interest!\""

#. Occurrence 1DOT5_3:3945:1500: voice_id=C30_1DOT5_3_0016; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:3945
msgctxt "text_id=1500 | speaker=unknown"
msgid "『けっきょく、どっちの手柄も同じこと！』"
msgstr "\"In the end, it doesn't really matter who did it!\""

#. Occurrence 1DOT5_3:4034:1501: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0015; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:4034
msgctxt "text_id=1501 | speaker=alice"
msgid "　　　　　"
msgstr "                              "

#. Occurrence 1DOT5_3:4034:1502: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0015; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:4034
msgctxt "text_id=1502 | speaker=alice"
msgid "London Bridge is broken down,"
msgstr "London Bridge is broken down,"

#. Occurrence 1DOT5_3:4034:1503: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0015; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:4034
msgctxt "text_id=1503 | speaker=alice"
msgid "　　　　　Broken down,broken down."
msgstr "                              Broken down, broken down..."

#. Occurrence 1DOT5_3:4108:1504: voice_id=C60_1DOT5_3_0002; voice_prefix=C60; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:4108
msgctxt "text_id=1504 | speaker=unknown"
msgid "“―――、ギ”"
msgstr "\"-, Ghh!\""

#. Occurrence 1DOT5_3:4114:1505: scene=1DOT5_3
#: 1DOT5_3:4114
msgctxt "text_id=1505 | speaker=unknown"
msgid "　ありえない、と再三、口裂け男の気配が呟く。"
msgstr "  \"Impossible!\" its presence murmured three times."

#. Occurrence 1DOT5_3:4120:1506: scene=1DOT5_3
#: 1DOT5_3:4120
msgctxt "text_id=1506 | speaker=unknown"
msgid "　これはなんだ。"
msgstr "  Not possible."

msgctxt "text_id=1507 | speaker=unknown"
msgid "これはなんだ。"
msgstr " Not possible."

msgctxt "text_id=1508 | speaker=unknown"
msgid "これはなんだ？"
msgstr " Not... possible?"

#. Occurrence 1DOT5_3:4145:1509: scene=1DOT5_3
#: 1DOT5_3:4145
msgctxt "text_id=1509 | speaker=unknown"
msgid "　喋る子豚。それはいい。"
msgstr "  Talking pigs were one thing."

#. Occurrence 1DOT5_3:4150:1510: scene=1DOT5_3
#: 1DOT5_3:4150
msgctxt "text_id=1510 | speaker=unknown"
msgid "　肩口まで食いつかれた腕。それもいい。"
msgstr "  Even having one's arms chomped off was in the realm of occupational hazard."

#. Occurrence 1DOT5_3:4156:1511: scene=1DOT5_3
#: 1DOT5_3:4156
msgctxt "text_id=1511 | speaker=unknown"
msgid "　一瞬で森を<覆|おお>った、あまりにも濃密な魔力の波。"
msgstr "  In an instant, the wood was enveloped in a dense wave of magical energy."

msgctxt "text_id=1512 | speaker=unknown"
msgid "<忌々|いまいま>しいが、素晴らしい。"
msgstr "^Though vexing, it was still impressive."

#. Occurrence 1DOT5_3:4178:1513: scene=1DOT5_3
#: 1DOT5_3:4178
msgctxt "text_id=1513 | speaker=unknown"
msgid "　しかし、それらは別段、驚くに値しない。"
msgstr "  None of these facts were particularly extraordinary."

#. Occurrence 1DOT5_3:4183:1514: scene=1DOT5_3
#: 1DOT5_3:4183
msgctxt "text_id=1514 | speaker=unknown"
msgid "　稀少な使い魔、猟奇的な攻撃、他を圧する天賦の魔力。"
msgstr "  These rare familiars, their bizarre attack, the sheer innate magical energy to overwhelm others..."

#. Occurrence 1DOT5_3:4188:1515: scene=1DOT5_3
#: 1DOT5_3:4188
msgctxt "text_id=1515 | speaker=unknown"
msgid "　そういったモノは彼らにも覚えがあるのだ。"
msgstr "  He had experience with all these things."

#. Occurrence 1DOT5_3:4193:1516: scene=1DOT5_3
#: 1DOT5_3:4193
msgctxt "text_id=1516 | speaker=unknown"
msgid "　何しろ彼らの雇い主が、その<類|たぐい>の異人である。"
msgstr "  His employer was skilled enough to achieve all of this as well."

#. Occurrence 1DOT5_3:4219:1517: scene=1DOT5_3
#: 1DOT5_3:4219
msgctxt "text_id=1517 | speaker=unknown"
msgid "　しかし―――"
msgstr "  However..."

#. Occurrence 1DOT5_3:4258:1518: voice_id=C20_1DOT5_3_0017; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:4258
msgctxt "text_id=1518 | speaker=unknown"
msgid "『どうするどうする、いつまで放置？』"
msgstr "\"What now? What now? How long should we hold him like this?\""

#. Occurrence 1DOT5_3:4265:1519: voice_id=C30_1DOT5_3_0017; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:4265
msgctxt "text_id=1519 | speaker=unknown"
msgid "『手足一本、まばたきだって贅沢だ！』"
msgstr "\"Even a blink of an eye is too long! Let's take an arm. \""

#. Occurrence 1DOT5_3:4302:1520: voice_id=C20_1DOT5_3_0018; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:4302
msgctxt "text_id=1520 | speaker=unknown"
msgid "『お支払いは面倒でも、できればポンドでお願いします！』"
msgstr "\"I'll give you a good price if you'll pay me in pounds!\""

#. Occurrence 1DOT5_3:4350:1521: scene=1DOT5_3
#: 1DOT5_3:4350
msgctxt "text_id=1521 | speaker=unknown"
msgid "　コレは、なんだ。"
msgstr "  What... were they?"

#. Occurrence 1DOT5_3:4355:1522: scene=1DOT5_3
#: 1DOT5_3:4355
msgctxt "text_id=1522 | speaker=unknown"
msgid "　器物でもない。"
msgstr "  Not vessels."

#. Occurrence 1DOT5_3:4360:1523: scene=1DOT5_3
#: 1DOT5_3:4360
msgctxt "text_id=1523 | speaker=unknown"
msgid "　生物でもない。"
msgstr "  Not living creatures."

#. Occurrence 1DOT5_3:4365:1524: scene=1DOT5_3
#: 1DOT5_3:4365
msgctxt "text_id=1524 | speaker=unknown"
msgid "　魔術回路によって動くクリーチャーですらない。"
msgstr "  Not beings powered by Magic Circuits."

#. Occurrence 1DOT5_3:4457:1525: scene=1DOT5_3
#: 1DOT5_3:4457
msgctxt "text_id=1525 | speaker=unknown"
msgid "　噛まれた箇所は両腕だけだというのに、全身が動かない。"
msgstr "  Even though only his arms had been bitten, none of his body would move."

#. Occurrence 1DOT5_3:4462:1526: scene=1DOT5_3
#: 1DOT5_3:4462
msgctxt "text_id=1526 | speaker=unknown"
msgid "　金縛りや衰弱とはまるで違う。"
msgstr "  It was nothing like being bound or weakened."

#. Occurrence 1DOT5_3:4467:1527: scene=1DOT5_3
#: 1DOT5_3:4467
msgctxt "text_id=1527 | speaker=unknown"
msgid "　まるで自分が<本|・><に|・><書|・><か|・><れ|・><た|・><文|・><字|・>になってしまったような、もうどこにも行けない感覚。"
msgstr "  This felt more like he had become words written in a book, fated to keep to their page."

#. Occurrence 1DOT5_3:4524:1528: scene=1DOT5_3
#: 1DOT5_3:4524
msgctxt "text_id=1528 | speaker=unknown"
msgid "　この口裂け男とて、その<奇形|きけい>が<示|しめ>す通り、幾たびの怪異を越えてきた。"
msgstr "  As the grinning figure's deformities indicated, he had overcome numerous curiosities and monstrosities."

#. Occurrence 1DOT5_3:4529:1529: scene=1DOT5_3
#: 1DOT5_3:4529
msgctxt "text_id=1529 | speaker=unknown"
msgid "　<幻惑|げんわく>、<魅了|みりょう>、<強制|きょうせい>。"
msgstr "  Illusions, enthrallment, compulsions..."

#. Occurrence 1DOT5_3:4534:1530: scene=1DOT5_3
#: 1DOT5_3:4534
msgctxt "text_id=1530 | speaker=unknown"
msgid "　<氷結|ひょうけつ>、<屍蝋|しろう>、はては<魔眼|まがん>の最奥である石化まで。"
msgstr "  Freezings, putrefactions, and even petrifications-a power granted to only the pinnacle of Mystic Eyes..."

#. Occurrence 1DOT5_3:4539:1531: scene=1DOT5_3
#: 1DOT5_3:4539
msgctxt "text_id=1531 | speaker=unknown"
msgid "　薬物から魔術、多くの<戒|いまし>めを経験した彼は叫ぶ。"
msgstr "  From poisons to magecraft, he had weathered a great deal."

#. Occurrence 1DOT5_3:4544:1532: scene=1DOT5_3
#: 1DOT5_3:4544
msgctxt "text_id=1532 | speaker=unknown"
msgid "　これは違う。違うものだ、と。"
msgstr "  But this was something different altogether."

#. Occurrence 1DOT5_3:4633:1533: scene=1DOT5_3
#: 1DOT5_3:4633
msgctxt "text_id=1533 | speaker=unknown"
msgid "　いま彼を縛る戒めは、"
msgstr "  The penalty that bound him now"

msgctxt "text_id=1534 | speaker=unknown"
msgid "　血液、筋肉、酸素、熱量とは別の法則。"
msgstr "  was based on different principles from blood, flesh, oxygen, or heat."

#. Occurrence 1DOT5_3:4640:1535: scene=1DOT5_3
#: 1DOT5_3:4640
msgctxt "text_id=1535 | speaker=unknown"
msgid "　どのルールにも当てはまらない未知の束縛。"
msgstr "  It was an unknown restraint that followed no rules he knew."

#. Occurrence 1DOT5_3:4646:1536: scene=1DOT5_3
#: 1DOT5_3:4646
msgctxt "text_id=1536 | speaker=unknown"
msgid "　……ああ、口にするのもおぞましいが。"
msgstr "  Indeed, though it was terrifying to admit..."

#. Occurrence 1DOT5_3:4652:1537: scene=1DOT5_3
#: 1DOT5_3:4652
msgctxt "text_id=1537 | speaker=unknown"
msgid "　まるで、この世のすべてと<乖離|かいり>している。"
msgstr "  It was as if he'd encountered something alien to everything in this world."

#. Occurrence 1DOT5_3:4755:1538: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0016; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:4755
msgctxt "text_id=1538 | speaker=alice"
msgid "　　　　　　"
msgstr "                                "

#. Occurrence 1DOT5_3:4755:1539: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0016; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:4755
msgctxt "text_id=1539 | speaker=alice"
msgid "London Bridge is broken down,"
msgstr "London Bridge is broken down,"

#. Occurrence 1DOT5_3:4755:1540: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0016; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:4755
msgctxt "text_id=1540 | speaker=alice"
msgid "　　　　　　Broken down,broken down."
msgstr "                                Broken down, broken down."

#. Occurrence 1DOT5_3:4755:1541: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0016; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:4755
msgctxt "text_id=1541 | speaker=alice"
msgid "　　　　　　London Bridge is broken down,"
msgstr "                                London Bridge is broken down,"

#. Occurrence 1DOT5_3:4755:1542: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0016; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:4755
msgctxt "text_id=1542 | speaker=alice"
msgid "　　　　　　My fair lady."
msgstr "                                My fair lady."

#. Occurrence 1DOT5_3:4833:1543: voice_id=C60_1DOT5_3_0003; voice_prefix=C60; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:4833
msgctxt "text_id=1543 | speaker=unknown"
msgid "“ギ―――”"
msgstr "\"Gh―\""

#. Occurrence 1DOT5_3:4841:1544: scene=1DOT5_3
#: 1DOT5_3:4841
msgctxt "text_id=1544 | speaker=unknown"
msgid "　左右の肩口に食いこむ牙。"
msgstr "  Fangs sank into his left and right shoulders."

#. Occurrence 1DOT5_3:4846:1545: scene=1DOT5_3
#: 1DOT5_3:4846
msgctxt "text_id=1545 | speaker=unknown"
msgid "　彼はこのカタチとして生まれてから、はじめて怒りの<感情|いし>を覚えた。"
msgstr "  For the first time in this form, he felt rage seethe up inside him."

#. Occurrence 1DOT5_3:4866:1546: scene=1DOT5_3
#: 1DOT5_3:4866
msgctxt "text_id=1546 | speaker=unknown"
msgid "　……基準は絶対でなければならない。"
msgstr "  ...The basis of all things had to be absolute."

#. Occurrence 1DOT5_3:4871:1547: scene=1DOT5_3
#: 1DOT5_3:4871
msgctxt "text_id=1547 | speaker=unknown"
msgid "　いかな神秘、いかな怪奇にも法則はある。"
msgstr "  All Mystics, all things bizarre obeyed some set of laws."

#. Occurrence 1DOT5_3:4876:1548: scene=1DOT5_3
#: 1DOT5_3:4876
msgctxt "text_id=1548 | speaker=unknown"
msgid "　コレらはそんな、彼らの<矜持|きょうじ>を無視するものだ。"
msgstr "  But these pigs ignored this, along with his dignity."

#. Occurrence 1DOT5_3:4947:1549: voice_id=C20_1DOT5_3_0019; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:4947
msgctxt "text_id=1549 | speaker=unknown"
msgid "『さあ、三日で衰弱！』"
msgstr "\"After three days you weaken!\""

#. Occurrence 1DOT5_3:4953:1550: voice_id=C30_1DOT5_3_0018; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:4953
msgctxt "text_id=1550 | speaker=unknown"
msgid "　　　『六日で溺死！』"
msgstr "      \"After six, you drown!\""

#. Occurrence 1DOT5_3:4959:1551: voice_id=C20_1DOT5_3_0020; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:4959
msgctxt "text_id=1551 | speaker=unknown"
msgid "『半年たてば<惨|みじ>めな<骸骨|がいこつ>！』"
msgstr "\"After half a year, you'll be a wretched skeleton!\""

#. Occurrence 1DOT5_3:4966:1552: voice_id=X10_1DOT5_3_0001; voice_prefix=X10; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:4966
msgctxt "text_id=1552 | speaker=unknown"
msgid "『『でもでもご無礼、面倒だからいま殺そうか！』』"
msgstr "\"\"Sorry to be rude, but we'll just kill you now!\"\""

#. Occurrence 1DOT5_3:5058:1553: voice_id=C60_1DOT5_3_0004; voice_prefix=C60; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:5058
msgctxt "text_id=1553 | speaker=unknown"
msgid "“シィィィィィィイイイイイ！！！！！！”"
msgstr "\"SSSSHHHHHHHHHHH!!!\""

#. Occurrence 1DOT5_3:5074:1554: scene=1DOT5_3
#: 1DOT5_3:5074
msgctxt "text_id=1554 | speaker=unknown"
msgid "　吠えた。"
msgstr "  A howl."

#. Occurrence 1DOT5_3:5079:1555: scene=1DOT5_3
#: 1DOT5_3:5079
msgctxt "text_id=1555 | speaker=unknown"
msgid "　口のないものが、<憤怒|ふんぬ>の叫びを響かせる。"
msgstr "  Though he had no voice, he let out an exasperated scream."

#. Occurrence 1DOT5_3:5174:1556: voice_id=C20_1DOT5_3_0021; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:5174
msgctxt "text_id=1556 | speaker=unknown"
msgid "『うげ？』"
msgstr "\"Huh?\""

#. Occurrence 1DOT5_3:5180:1557: voice_id=C30_1DOT5_3_0019; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:5180
msgctxt "text_id=1557 | speaker=unknown"
msgid "『うげげ！？』"
msgstr "\"Huh?!\""

#. Occurrence 1DOT5_3:5186:1558: voice_id=C20_1DOT5_3_0022; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:5186
msgctxt "text_id=1558 | speaker=unknown"
msgid "『なんて便利、自分の腕を<外|はず>せる<機構|きこう>！』"
msgstr "\"What a convenient function, to be able to detach your arms!\""

#. Occurrence 1DOT5_3:5192:1559: voice_id=C30_1DOT5_3_0020; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:5192
msgctxt "text_id=1559 | speaker=unknown"
msgid "『おお、オマエこそ三国一のモノノフよー！』"
msgstr "\"What an unparalleled warrior!\""

#. Occurrence 1DOT5_3:5296:1560: scene=1DOT5_3
#: 1DOT5_3:5296
msgctxt "text_id=1560 | speaker=unknown"
msgid "　お喋りな子豚たちは小川に落ちた。"
msgstr "  The talkative pigs fell into the stream."

#. Occurrence 1DOT5_3:5301:1561: scene=1DOT5_3
#: 1DOT5_3:5301
msgctxt "text_id=1561 | speaker=unknown"
msgid "　憤怒の<声|おと>は、自ら両肩を破壊した炸裂音だ。"
msgstr "  That exasperated scream was the sound of the figure tearing his arms from their sockets."

#. Occurrence 1DOT5_3:5306:1562: scene=1DOT5_3
#: 1DOT5_3:5306
msgctxt "text_id=1562 | speaker=unknown"
msgid "　両腕を失ってなお、口裂け男は少女へと走る。"
msgstr "  Armless, he rushed the girl."

#. Occurrence 1DOT5_3:5319:1563: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0017; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:5319
msgctxt "text_id=1563 | speaker=alice"
msgid "「……役立たず。後でおしおきが必要ね」"
msgstr "\"...Useless swine. I'll see you be punished later.\""

#. Occurrence 1DOT5_3:5361:1564: scene=1DOT5_3
#: 1DOT5_3:5361
msgctxt "text_id=1564 | speaker=unknown"
msgid "　もはや切りきざむ腕はないが、彼には最大の悪意が残っている。"
msgstr "  He may have lost his mangled arms, but not the object of his malice."

#. Occurrence 1DOT5_3:5526:1565: scene=1DOT5_3
#: 1DOT5_3:5526
msgctxt "text_id=1565 | speaker=unknown"
msgid "　<睨|にら>んだ者の心臓を<射|い><止|と>める魔眼。"
msgstr "  A Mystic Eye to pierce the heart of its victim."

#. Occurrence 1DOT5_3:5531:1566: scene=1DOT5_3
#: 1DOT5_3:5531
msgctxt "text_id=1566 | speaker=unknown"
msgid "　心筋を<梗塞|こうそく>させる事のみに特化した魔術回路。"
msgstr "  A Magic Circuit designed to stop a beating heart."

#. Occurrence 1DOT5_3:5536:1567: scene=1DOT5_3
#: 1DOT5_3:5536
msgctxt "text_id=1567 | speaker=unknown"
msgid "　<単純|シンプル>ではあるが、だからこそ、この至近距離で放てば回避は不可能な死の<散弾|ショットガン>。"
msgstr "  It was beautiful in its simplicity. At point-blank range, it was the equivalent of an unavoidable shotgun blast."

#. Occurrence 1DOT5_3:5740:1568: voice_id=C60_1DOT5_3_0005; voice_prefix=C60; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:5740
msgctxt "text_id=1568 | speaker=unknown"
msgid "“―――？”"
msgstr "\"...?\""

#. Occurrence 1DOT5_3:5746:1569: scene=1DOT5_3
#: 1DOT5_3:5746
msgctxt "text_id=1569 | speaker=unknown"
msgid "　だが。"
msgstr "  But..."

#. Occurrence 1DOT5_3:5751:1570: scene=1DOT5_3
#: 1DOT5_3:5751
msgctxt "text_id=1570 | speaker=unknown"
msgid "　不幸な事に、彼には目しかなく。"
msgstr "  Tragically, that eye was all he had."

#. Occurrence 1DOT5_3:5781:1571: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0018; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:5781
msgctxt "text_id=1571 | speaker=alice"
msgid "　　　　"
msgstr "                          "

#. Occurrence 1DOT5_3:5781:1572: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0018; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:5781
msgctxt "text_id=1572 | speaker=alice"
msgid "Build it up with wood and clay,"
msgstr "Build it up with wood and clay,"

#. Occurrence 1DOT5_3:5781:1573: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0018; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:5781
msgctxt "text_id=1573 | speaker=alice"
msgid "　　　　Wood and clay,Wood and clay,"
msgstr "                          Wood and clay, Wood and clay,"

#. Occurrence 1DOT5_3:5781:1574: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0018; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:5781
msgctxt "text_id=1574 | speaker=alice"
msgid "　　　　Build it up with wood and clay,"
msgstr "                          Build it up with wood and clay,"

#. Occurrence 1DOT5_3:5781:1575: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0018; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:5781
msgctxt "text_id=1575 | speaker=alice"
msgid "　　　　My fair lady."
msgstr "                          My fair lady."

#. Occurrence 1DOT5_3:5802:1576: scene=1DOT5_3
#: 1DOT5_3:5802
msgctxt "text_id=1576 | speaker=unknown"
msgid "　少女の唄が違うものになっていた事に、最後まで気づかなかった。"
msgstr "  He failed to realize that her song had changed."

#. Occurrence 1DOT5_3:5917:1577: scene=1DOT5_3
#: 1DOT5_3:5917
msgctxt "text_id=1577 | speaker=unknown"
msgid "　ソレにとって大地を震わす一撃は、虫を払った程度のものでしかない。"
msgstr "  For the giant, the earth-shattering strike was akin to the act of shooing away an insect."

#. Occurrence 1DOT5_3:5938:1578: scene=1DOT5_3
#: 1DOT5_3:5938
msgctxt "text_id=1578 | speaker=unknown"
msgid "　隆々とわきたつ緑の血管。"
msgstr "  Its green, verdant veins pulsed."

#. Occurrence 1DOT5_3:5943:1579: scene=1DOT5_3
#: 1DOT5_3:5943
msgctxt "text_id=1579 | speaker=unknown"
msgid "　<乾|かわ>き、何百年という時を<食|は>み、電動の<回転刃|チェインソー>すら<弾|はじ>く<樫|かし>の皮。"
msgstr "  Oaken bark covered its body, hardened sufficiently over centuries to repel even a chainsaw."

#. Occurrence 1DOT5_3:5948:1580: scene=1DOT5_3
#: 1DOT5_3:5948
msgctxt "text_id=1580 | speaker=unknown"
msgid "　額には色とりどりの絵の具で落書きされた「emeth」の文字。……ところどころ間違った、お約束にすぎない綴りではあるが。"
msgstr "  On its forehead, inscribed in all manner of colors, was the word \"emeth,\" though judging from its misspelling, the inscription was purely decorative."

#. Occurrence 1DOT5_3:6103:1581: scene=1DOT5_3
#: 1DOT5_3:6103
msgctxt "text_id=1581 | speaker=unknown"
msgid "　その姿こそテムズトロル。"
msgstr "  The Thames Troll."

#. Occurrence 1DOT5_3:6108:1582: scene=1DOT5_3
#: 1DOT5_3:6108
msgctxt "text_id=1582 | speaker=unknown"
msgid "　あるいはフォーリンダウン。"
msgstr "  It also went by the moniker Falling Down."

#. Occurrence 1DOT5_3:6113:1583: scene=1DOT5_3
#: 1DOT5_3:6113
msgctxt "text_id=1583 | speaker=unknown"
msgid "　またの名をグレートブリッジ。"
msgstr "  Or alternatively, the Great Bridge."

#. Occurrence 1DOT5_3:6118:1584: scene=1DOT5_3
#: 1DOT5_3:6118
msgctxt "text_id=1584 | speaker=unknown"
msgid "　<数多|あまた><異形|いぎょう>に賞賛される、四つの奇蹟の最初のいっぽ。"
msgstr "  Admired in different forms, it was the first of four miracles."

#. Occurrence 1DOT5_3:6205:1585: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0019; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:6205
msgctxt "text_id=1585 | speaker=alice"
msgid "「テムズ、もう一体をお願い」"
msgstr "\"Thames, please take care of the other one.\""

#. Occurrence 1DOT5_3:6230:1586: scene=1DOT5_3
#: 1DOT5_3:6230
msgctxt "text_id=1586 | speaker=unknown"
msgid "　少女の言葉に巨人が応える。"
msgstr "  The giant responded to the girl's words."

#. Occurrence 1DOT5_3:6235:1587: scene=1DOT5_3
#: 1DOT5_3:6235
msgctxt "text_id=1587 | speaker=unknown"
msgid "　地に根を張った緑の巨人は一歩も動かず、その左腕を天に<掲|かか>げ―――"
msgstr "  With roots rent deep into the earth, it raised its left arm to the heavens without moving a step."

#. Occurrence 1DOT5_3:6426:1588: voice_id=C50_1DOT5_3_0016; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:6426
msgctxt "text_id=1588 | speaker=unknown"
msgid "“―――、―――”"
msgstr "\"-, -\""

#. Occurrence 1DOT5_3:6432:1589: scene=1DOT5_3
#: 1DOT5_3:6432
msgctxt "text_id=1589 | speaker=unknown"
msgid "　一方。"
msgstr "  Elsewhere in the forest..."

#. Occurrence 1DOT5_3:6437:1590: scene=1DOT5_3
#: 1DOT5_3:6437
msgctxt "text_id=1590 | speaker=unknown"
msgid "　交戦と同時に逃げ出した口裂け男は、夜の森をひた走っていた。"
msgstr "  The grinning figure who had chosen to flee the battle was running through the night forest at full speed."

#. Occurrence 1DOT5_3:6442:1591: scene=1DOT5_3
#: 1DOT5_3:6442
msgctxt "text_id=1591 | speaker=unknown"
msgid "　相手を記録し、記述する事。"
msgstr "  Record and provide a detailed description of the enemy."

#. Occurrence 1DOT5_3:6447:1592: scene=1DOT5_3
#: 1DOT5_3:6447
msgctxt "text_id=1592 | speaker=unknown"
msgid "　それが、彼が己に課した<使命|オーダー>である。"
msgstr "  Those were the orders assigned to him."

#. Occurrence 1DOT5_3:6509:1593: scene=1DOT5_3
#: 1DOT5_3:6509
msgctxt "text_id=1593 | speaker=unknown"
msgid "　住み慣れた森を全力で逃げていく。"
msgstr "  He poured all of his energy into escaping this forest with which he had become so familiar."

#. Occurrence 1DOT5_3:6514:1594: scene=1DOT5_3
#: 1DOT5_3:6514
msgctxt "text_id=1594 | speaker=unknown"
msgid "　有事の際は一体が敵に挑み、もう一体は撤退し、雇い主に報告するのが彼らの戦術だった。"
msgstr "  In case of emergency, the plan was for one to challenge the enemy while the other made a tactical retreat in order to report to their master."

#. Occurrence 1DOT5_3:6520:1595: scene=1DOT5_3
#: 1DOT5_3:6520
msgctxt "text_id=1595 | speaker=unknown"
msgid "　森を駆ける事。"
msgstr "  He dashed through the forest."

#. Occurrence 1DOT5_3:6525:1596: scene=1DOT5_3
#: 1DOT5_3:6525
msgctxt "text_id=1596 | speaker=unknown"
msgid "　逃げる事だけに機能を特化させた口裂け男は、恐怖に縛られながらも、自身の勝ちを確信した。"
msgstr "  Though gripped by fear, he was confident in his ability to perform the mission he was designed for."

#. Occurrence 1DOT5_3:6628:1597: scene=1DOT5_3
#: 1DOT5_3:6628
msgctxt "text_id=1597 | speaker=unknown"
msgid "　森で彼に追いつけるモノはいない。"
msgstr "  Nothing could catch him in these woods."

#. Occurrence 1DOT5_3:6633:1598: scene=1DOT5_3
#: 1DOT5_3:6633
msgctxt "text_id=1598 | speaker=unknown"
msgid "　野生の狼ですら、離されないよう追尾するのがやっとだろう。"
msgstr "  Even the wolves could not track him."

#. Occurrence 1DOT5_3:6638:1599: scene=1DOT5_3
#: 1DOT5_3:6638
msgctxt "text_id=1599 | speaker=unknown"
msgid "　カッカッ、と地面を蹴る鳥形の脚。"
msgstr "  His bird-like legs thumped as they kicked the ground."

#. Occurrence 1DOT5_3:6643:1600: scene=1DOT5_3
#: 1DOT5_3:6643
msgctxt "text_id=1600 | speaker=unknown"
msgid "　制作者の<偏|かたよ>った趣味なのか、走行のみに特化した場合、彼の脚はこのように変形する。"
msgstr "  Perhaps it was his creator's eccentric tastes that dictated their form when optimizing them for running."

#. Occurrence 1DOT5_3:6749:1601: scene=1DOT5_3
#: 1DOT5_3:6749
msgctxt "text_id=1601 | speaker=unknown"
msgid "　最高時速70キロ。"
msgstr "  The grinning man could reach a maximum speed of 45 miles per hour,"

#. Occurrence 1DOT5_3:6754:1602: scene=1DOT5_3
#: 1DOT5_3:6754
msgctxt "text_id=1602 | speaker=unknown"
msgid "　二足歩行生物の限界を超えながら森を行く口裂け男。"
msgstr "  well past the limit of any bipedal creature."

#. Occurrence 1DOT5_3:6759:1603: scene=1DOT5_3
#: 1DOT5_3:6759
msgctxt "text_id=1603 | speaker=unknown"
msgid "　彼は数キロもの距離をとり、背後の安全を確認した。"
msgstr "  After securing a distance of several miles, he turned around to confirm his safety."

#. Occurrence 1DOT5_3:6813:1604: scene=1DOT5_3
#: 1DOT5_3:6813
msgctxt "text_id=1604 | speaker=unknown"
msgid "　……追ってくるモノはいない。"
msgstr "  ...There was no sign of pursuit."

#. Occurrence 1DOT5_3:6818:1605: scene=1DOT5_3
#: 1DOT5_3:6818
msgctxt "text_id=1605 | speaker=unknown"
msgid "　三日月型の口―――いや、目がほう、と安堵に<緩|ゆる>む。"
msgstr "  His crescent-shaped mouth―nay, eye―slackened in relief."

#. Occurrence 1DOT5_3:6841:1606: scene=1DOT5_3
#: 1DOT5_3:6841
msgctxt "text_id=1606 | speaker=unknown"
msgid "　そうして。"
msgstr "  And then..."

#. Occurrence 1DOT5_3:6848:1607: voice_id=C50_1DOT5_3_0017; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:6848
msgctxt "text_id=1607 | speaker=unknown"
msgid "“―――？”"
msgstr "\"-?\""

#. Occurrence 1DOT5_3:6880:1608: scene=1DOT5_3
#: 1DOT5_3:6880
msgctxt "text_id=1608 | speaker=unknown"
msgid "　前方に体を向き直した時、彼は自らの死を見上げた。"
msgstr "  After facing forward once more, he looked up to lock eyes with his doom."

#. Occurrence 1DOT5_3:6910:1609: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0020; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:6910
msgctxt "text_id=1609 | speaker=alice"
msgid "　　　　　　"
msgstr "                                "

#. Occurrence 1DOT5_3:6910:1610: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0020; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:6910
msgctxt "text_id=1610 | speaker=alice"
msgid "London Bridge is broken down,"
msgstr "London Bridge is broken down,"

#. Occurrence 1DOT5_3:6910:1611: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0020; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:6910
msgctxt "text_id=1611 | speaker=alice"
msgid "　　　　　　Broken down,broken down―――"
msgstr "                                Broken down, broken down..."

#. Occurrence 1DOT5_3:6971:1612: scene=1DOT5_3
#: 1DOT5_3:6971
msgctxt "text_id=1612 | speaker=unknown"
msgid "　彼方から聞こえる<暗黒童話|マザーグース>。"
msgstr "  In the distance, he could hear the dark rhymes of Mother Goose."

#. Occurrence 1DOT5_3:6976:1613: scene=1DOT5_3
#: 1DOT5_3:6976
msgctxt "text_id=1613 | speaker=unknown"
msgid "　地面から伸びた無数の<蔓|つる>。"
msgstr "  Countless vines extended from the ground."

#. Occurrence 1DOT5_3:6981:1614: scene=1DOT5_3
#: 1DOT5_3:6981
msgctxt "text_id=1614 | speaker=unknown"
msgid "　<橋|アーチ>を思わせる怪異は、さながら、巨大な腕に似て―――"
msgstr "  They formed into a monstrosity that conjured up images of an arched bridge, something resembling a giant arm."

#. Occurrence 1DOT5_3:7088:1615: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0021; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:7088
msgctxt "text_id=1615 | speaker=alice"
msgid "　　　　　　"
msgstr "                                "

msgctxt "text_id=1616 | speaker=unknown"
msgid "London Bridge is broken down,"
msgstr "London Bridge is broken down,"

msgctxt "text_id=1617 | speaker=unknown"
msgid "　　　　　　My fair lady."
msgstr "                                My fair lady."

#. Occurrence 1DOT5_3:7205:1618: voice_id=C50_1DOT5_3_0018; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7205
msgctxt "text_id=1618 | speaker=unknown"
msgid "　最終報告。"
msgstr "  FINAL REPORT."

#. Occurrence 1DOT5_3:7212:1619: voice_id=C50_1DOT5_3_0019; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7212
msgctxt "text_id=1619 | speaker=unknown"
msgid "　生還ハ　困難。"
msgstr "  SURVIVAL: UNABLE TO COMPLETE."

#. Occurrence 1DOT5_3:7218:1620: voice_id=C50_1DOT5_3_0020; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7218
msgctxt "text_id=1620 | speaker=unknown"
msgid "　解析ハ　困難。"
msgstr "  ANALYSIS: UNABLE TO COMPLETE."

#. Occurrence 1DOT5_3:7224:1621: voice_id=C50_1DOT5_3_0021; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7224
msgctxt "text_id=1621 | speaker=unknown"
msgid "　転送ハ　困難。"
msgstr "  TRANSMISSION: UNABLE TO COMPLETE."

#. Occurrence 1DOT5_3:7230:1622: voice_id=C50_1DOT5_3_0022; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7230
msgctxt "text_id=1622 | speaker=unknown"
msgid "　状況ヲ　終了シマス。"
msgstr "  ENDING SESSION..."

#. Occurrence 1DOT5_3:7237:1623: voice_id=C50_1DOT5_3_0023; voice_prefix=C50; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7237
msgctxt "text_id=1623 | speaker=unknown"
msgid "　Ａａａａａ。主ヨ。ドウカ、コノ身ヲ、護リ―――"
msgstr "  AAAH. OH, MASTER. PRESERVE ME FROM-"

#. Occurrence 1DOT5_3:7439:1624: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0022; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:7439
msgctxt "text_id=1624 | speaker=alice"
msgid "「……済んだようね。お疲れさま、戻ってテムズ。"
msgstr "\"...I think we're about done here. Well done, Thames. You can return now."

#. Occurrence 1DOT5_3:7451:1625: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0023; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:7451
msgctxt "text_id=1625 | speaker=alice"
msgid "　次はもっと、高価な場所ならいいのだけど」"
msgstr "  Hopefully, our next encounter will be more worth our time.\""

#. Occurrence 1DOT5_3:7535:1626: scene=1DOT5_3
#: 1DOT5_3:7535
msgctxt "text_id=1626 | speaker=unknown"
msgid "　少女は踵を返す。"
msgstr "  The girl turned on her heel."

#. Occurrence 1DOT5_3:7540:1627: scene=1DOT5_3
#: 1DOT5_3:7540
msgctxt "text_id=1627 | speaker=unknown"
msgid "　この森に工房を構えた外敵は消し去った。"
msgstr "  The invaders who had set up shop in the woods were eliminated."

#. Occurrence 1DOT5_3:7545:1628: scene=1DOT5_3
#: 1DOT5_3:7545
msgctxt "text_id=1628 | speaker=unknown"
msgid "　彼らが善悪どちらのもので、どれだけの被害者を築き上げてきたか、少女には関心のない事だ。"
msgstr "  She had no interest in whether they had been good or evil, nor how many victims they had claimed."

#. Occurrence 1DOT5_3:7550:1629: scene=1DOT5_3
#: 1DOT5_3:7550
msgctxt "text_id=1629 | speaker=unknown"
msgid "　人間社会のしがらみに関心は持たない。"
msgstr "  The shackles of civic society held no sway over her."

#. Occurrence 1DOT5_3:7555:1630: scene=1DOT5_3
#: 1DOT5_3:7555
msgctxt "text_id=1630 | speaker=unknown"
msgid "　それが純血の魔女、マインスターのあり方だ。"
msgstr "  This was the way of a pure-blooded witch, the way of a Meinster."

#. Occurrence 1DOT5_3:7640:1631: voice_id=C20_1DOT5_3_0023; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7640
msgctxt "text_id=1631 | speaker=unknown"
msgid "『ちょ、ボクたちは！？　ねえボクたちは！？』"
msgstr "\"Hey, what about us!? What about us!?\""

#. Occurrence 1DOT5_3:7648:1632: voice_id=C30_1DOT5_3_0021; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7648
msgctxt "text_id=1632 | speaker=unknown"
msgid "『腕、この腕ぬけないんだけど！』"
msgstr "\"Help me get this arm outta my teeth!\""

#. Occurrence 1DOT5_3:7654:1633: voice_id=C20_1DOT5_3_0024; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7654
msgctxt "text_id=1633 | speaker=unknown"
msgid "『噛んだままだとボクらも動けないっていうかさあ』"
msgstr "\"We really shouldn't move while we're eating.\""

#. Occurrence 1DOT5_3:7662:1634: voice_id=C30_1DOT5_3_0022; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7662
msgctxt "text_id=1634 | speaker=unknown"
msgid "『ひどい、飛べないブタに用はないと！？』"
msgstr "\"Don't tell us you don't need pigs that can't fly!\""

#. Occurrence 1DOT5_3:7669:1635: voice_id=C20_1DOT5_3_0025; voice_prefix=C20; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7669
msgctxt "text_id=1635 | speaker=unknown"
msgid "『次、次はお役に立ちますきっと！　生まれてこの方、失敗続きのボクらだけど！』"
msgstr "\"W-We'll do a better job next time, though we're nothing but screw-ups!\""

#. Occurrence 1DOT5_3:7677:1636: voice_id=C30_1DOT5_3_0023; voice_prefix=C30; voice_category=0; scene=1DOT5_3
#: 1DOT5_3:7677
msgctxt "text_id=1636 | speaker=unknown"
msgid "『うん、壊れるまでに一度ぐらいは褒められたいね！』"
msgstr "\"Yeah, you owe us at least one compliment before the end!\""

#. Occurrence 1DOT5_3:7760:1637: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0024; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:7760
msgctxt "text_id=1637 | speaker=alice"
msgid "「…………」"
msgstr "\"...\""

#. Occurrence 1DOT5_3:7770:1638: scene=1DOT5_3
#: 1DOT5_3:7770
msgctxt "text_id=1638 | speaker=unknown"
msgid "　少女はため息をついて小川に足を運ぶと、黒い手袋をとって、細い指を氷水に浸した。"
msgstr "  The girl let out a sigh and stepped into the stream. She removed her gloves and dipped her slender fingers into the ice water."

#. Occurrence 1DOT5_3:7831:1639: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0025; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:7831
msgctxt "text_id=1639 | speaker=alice"
msgid "「六の目はだすなって言うけど。"
msgstr "\"I told you not to roll sixes."

#. Occurrence 1DOT5_3:7838:1640: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0026; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:7838
msgctxt "text_id=1640 | speaker=alice"
msgid "六の目しかでないようになってるわよね、貴方たち」"
msgstr "But I suppose it is the only number you can roll.\""

#. Occurrence 1DOT5_3:7858:1641: scene=1DOT5_3
#: 1DOT5_3:7858
msgctxt "text_id=1641 | speaker=unknown"
msgid "　憂鬱な呟きに、<応|こた>えの声はない。"
msgstr "  There was no response to her melancholy tone."

#. Occurrence 1DOT5_3:7863:1642: scene=1DOT5_3
#: 1DOT5_3:7863
msgctxt "text_id=1642 | speaker=unknown"
msgid "　あれほど騒がしかった子豚は影も形もなく、少女の手のひらには黒い<賽子|ダイス>が二つだけ。"
msgstr "  In place of the once-boisterous pigs were two black dice, now sitting in the palm of her hand."

#. Occurrence 1DOT5_3:7868:1643: scene=1DOT5_3
#: 1DOT5_3:7868
msgctxt "text_id=1643 | speaker=unknown"
msgid "　少女は散らばった残骸に声をかけようとして、あ、と口元に手を当てた。"
msgstr "  As the girl was about to say something to the scattered remains around her, she realized something that made her put a hand to her mouth."

#. Occurrence 1DOT5_3:7908:1644: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0027; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:7908
msgctxt "text_id=1644 | speaker=alice"
msgid "「……お別れは済ませていたわね。"
msgstr "\"...The farewell is over."

#. Occurrence 1DOT5_3:7914:1645: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_1DOT5_3_0028; voice_prefix=A40; voice_category=2; scene=1DOT5_3
#: 1DOT5_3:7914
msgctxt "text_id=1645 | speaker=alice"
msgid "　<銘|めい>ぐらいは、聞いておくべきだったかしら」"
msgstr "  Should I have asked them if they had any last words?\""

#. Occurrence 1DOT5_3:7972:1646: scene=1DOT5_3
#: 1DOT5_3:7972
msgctxt "text_id=1646 | speaker=unknown"
msgid "　白魚のような指が、名残惜しそうに唇をなぞる。"
msgstr "  Her slender, pale fingers traced her lips, as if reluctant to part from them."

#. Occurrence 1DOT5_3:7977:1647: scene=1DOT5_3
#: 1DOT5_3:7977
msgctxt "text_id=1647 | speaker=unknown"
msgid "　少女は二度目のため息をついた後、訪れた時と同じように、ゆっくりと暗い森を後にした。"
msgstr "  Sighing again, she calmly left the dark woods the same way she had entered."

#. Occurrence 1DOT5_4:47:1648: scene=1DOT5_4
#: 1DOT5_4:47
msgctxt "text_id=1648 | speaker=unknown"
msgid "　カメラは少しだけさかのぼる。"
msgstr "  Let us rewind to a moment in the recent past."

#. Occurrence 1DOT5_4:52:1649: scene=1DOT5_4
#: 1DOT5_4:52
msgctxt "text_id=1649 | speaker=unknown"
msgid "　日付にすると１２月初めの、ちょっとした閑話休題。"
msgstr "  The scene took place on a Saturday morning in early December."

#. Occurrence 1DOT5_4:100:1650: scene=1DOT5_4
#: 1DOT5_4:100
msgctxt "text_id=1650 | speaker=unknown"
msgid "　三時限目の授業が終わり、帰りの<ＨＲ|ホームルーム>を残すだけの土曜の昼前。"
msgstr "  With third period over just before lunch, the only activity that remained before the scholastic day ended was homeroom."

#. Occurrence 1DOT5_4:105:1651: scene=1DOT5_4
#: 1DOT5_4:105
msgctxt "text_id=1651 | speaker=unknown"
msgid "　２－Ｃ組の生徒である<静希|しずき><草十郎|そうじゅうろう>と<木|き><乃|の><美|み><芳助|ほうすけ>は、担任の山城和樹がいっこうに現れない為、帰りたいのに帰れない、という宙づり状態でベランダから校庭など眺めていた。"
msgstr "  Two of Class C's students, Soujyuro Sizuki and Housuke Kinomi, were standing outside on the balcony overlooking the schoolyard. They were stuck waiting for their homeroom teacher, Mr. Kazuki Yamasiro, and could not leave until he arrived."

#. Occurrence 1DOT5_4:125:1652: scene=1DOT5_4
#: 1DOT5_4:125
msgctxt "text_id=1652 | speaker=unknown"
msgid "　他のクラスメイトたちは教室内で雑談中。"
msgstr "  The rest of their classmates were chatting idly in the classroom."

#. Occurrence 1DOT5_4:146:1653: scene=1DOT5_4
#: 1DOT5_4:146
msgctxt "text_id=1653 | speaker=unknown"
msgid "　ふたりの隣には、暇つぶしで付き合っている<Ａ|よ><組|そ>のクラスの<槻司|つきじ><鳶丸|とびまる>の姿があった。"
msgstr "  Class A's Tobimaru Tsukiji was killing time alongside them."

#. Occurrence 1DOT5_4:151:1654: scene=1DOT5_4
#: 1DOT5_4:151
msgctxt "text_id=1654 | speaker=unknown"
msgid "　三人はやる気なさげにベランダの<欄干|らんかん>によりかかり、週末の予定などを話しあっている。"
msgstr "  The listless trio discussed their weekend plans as they leaned on the veranda's railing."

#. Occurrence 1DOT5_4:177:1655: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0000; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:177
msgctxt "text_id=1655 | speaker=soujuurou"
msgid "「木乃美はベアでアルバイトか？」"
msgstr "\"You working at the Bear this weekend, Kinomi?\""

#. Occurrence 1DOT5_4:190:1656: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0000; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:190
msgctxt "text_id=1656 | speaker=kinomi"
msgid "「バッカ、誰が日曜まで働くかってーの。"
msgstr "\"Like hell I am. Who the hell works 'til Sunday?"

#. Occurrence 1DOT5_4:196:1657: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0001; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:196
msgctxt "text_id=1657 | speaker=kinomi"
msgid "　明日はほら、Ｂ組の子たちと遊びに行く……予定だったんだけどなー。なんかうちから出られねぇー」"
msgstr "  I'm going out tomorrow with some chicks from Class B... 'least that was the plan. They said they're grounded or something...\""

#. Occurrence 1DOT5_4:241:1658: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0001; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:241
msgctxt "text_id=1658 | speaker=soujuurou"
msgid "「む。それはつまり、またふられたのか」"
msgstr "\"So, in other words, you failed again.\""

#. Occurrence 1DOT5_4:270:1659: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0002; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:270
msgctxt "text_id=1659 | speaker=kinomi"
msgid "「ごはっ、直撃!?　言いづらいコトをまっすぐ言うよね静希クンってば！」"
msgstr "\"Jeez, kick a man when he's down much, Sizuki?!\""

#. Occurrence 1DOT5_4:299:1660: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_1DOT5_4_0000; voice_prefix=B70; voice_category=4; scene=1DOT5_4
#: 1DOT5_4:299
msgctxt "text_id=1660 | speaker=tobimaru"
msgid "「そりゃ毎日テメエのバカ面みてれば、ヒヨコだってふられるって言葉を覚えるだろうよ。自滅するのは勝手だけどな、くれぐれも草の字にヘンな遊び教えんなよ」"
msgstr "\"Please, even the most airheaded chicks know better than to accept an invite from your dumb ass. Crash and burn all you like, but don't drag Sono-G into the fallout, will you?\""

#. Occurrence 1DOT5_4:342:1661: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0003; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:342
msgctxt "text_id=1661 | speaker=kinomi"
msgid "「あん、そりゃ<殿下|でんか>の方じゃねえの？"
msgstr "\"Well excuse me, Your Majesty. You're one to talk!"

#. Occurrence 1DOT5_4:348:1662: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0004; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:348
msgctxt "text_id=1662 | speaker=kinomi"
msgid "　気ぃつけろよ静希、<槻司|つきじ>はマジで腹黒いからよ。"
msgstr "  Word to the wise, Sizuki. Tsukiji's heart is as black as they come."

#. Occurrence 1DOT5_4:354:1663: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0005; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:354
msgctxt "text_id=1663 | speaker=kinomi"
msgid "　コイツの頭ん中は、ほら、アレ。ゴミ捨て場の貼り紙？　あんな感じだから。くっきり使えるモンと使えないモン分けてんだよ」"
msgstr "  In his mind he's like... you know those labels you use to separate the trash? This dude uses them to label people―you're either useful to him or you ain't.\""

#. Occurrence 1DOT5_4:395:1664: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0002; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:395
msgctxt "text_id=1664 | speaker=soujuurou"
msgid "「ああ、それは知ってる。"
msgstr "\"Yeah, I figured that out."

#. Occurrence 1DOT5_4:406:1665: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0003; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:406
msgctxt "text_id=1665 | speaker=soujuurou"
msgid "　―――ところで唐突に思ったんだが、鳶丸の中じゃ木乃美はどういう扱いなんだ？」"
msgstr "  ...Speaking of which, I know this is a bit out of the blue, but what do you think about Kinomi, Tobimaru?\""

#. Occurrence 1DOT5_4:434:1666: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_1DOT5_4_0001; voice_prefix=B70; voice_category=4; scene=1DOT5_4
#: 1DOT5_4:434
msgctxt "text_id=1666 | speaker=tobimaru"
msgid "「そうだなあ。粗大ゴミ回収は、金でも貰わねえとワリ合わなくなるんじゃねえか？　国が無料で回収するのはそろそろおしまいってトコ」"
msgstr "\"Hmm... Well you know how the country's going to stop collecting oversized scrap for free soon, since it costs too much to dispose of? That's because of people like him.\""

#. Occurrence 1DOT5_4:478:1667: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0006; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:478
msgctxt "text_id=1667 | speaker=kinomi"
msgid "「はあ？　なに言ってんのオマエ？　使い古しの箪笥とか高く売れるじゃん！"
msgstr "\"What kinda nonsense is that? Who throws out big stuff like cabinets when you can make good money off of them?!"

#. Occurrence 1DOT5_4:490:1668: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0007; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:490
msgctxt "text_id=1668 | speaker=kinomi"
msgid "　オレみたいな開封・即使用、みたいな男がこれからのトレンドなワケでしょ？　ほら、コンビニで売ってる使い捨てカメラとか大人気だし？　ようやく流行がオレの消費文明に追いついたと、」"
msgstr "  The future is grab-and-go, you know. Just look how rad those disposable cameras you can buy at convenience stores are. Looks like the times have finally caught up with my idea of consumer culture―\""

#. Occurrence 1DOT5_4:532:1669: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0004_0; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:532
msgctxt "text_id=1669 | speaker=soujuurou"
msgid "「じゃあ木乃美はバイト、と。"
msgstr "\"So, Kinomi's working this weekend."

#. Occurrence 1DOT5_4:546:1670: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0004_1; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:546
msgctxt "text_id=1670 | speaker=soujuurou"
msgid "鳶丸は？」"
msgstr "What about you, Tobimaru?\""

#. Occurrence 1DOT5_4:558:1671: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0008; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:558
msgctxt "text_id=1671 | speaker=kinomi"
msgid "「来るからネ、ちゃんとオレの時代！」"
msgstr "\"My time is coming, just watch!\""

#. Occurrence 1DOT5_4:569:1672: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_1DOT5_4_0002; voice_prefix=B70; voice_category=4; scene=1DOT5_4
#: 1DOT5_4:569
msgctxt "text_id=1672 | speaker=tobimaru"
msgid "「俺はちょい私用だ。親父の客が来てるんで接待しなきゃならん。街の案内をしてくれとさ」"
msgstr "\"There's some business to attend to on my end. I'll be entertaining a guest of my father's. Giving a tour of the city, stuff like that.\""

#. Occurrence 1DOT5_4:596:1673: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0009; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:596
msgctxt "text_id=1673 | speaker=kinomi"
msgid "「きけよー。人の話きけよー。"
msgstr "\"Friggin' rude! Don't interrupt a guy when he's talking."

#. Occurrence 1DOT5_4:627:1674: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0010; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:627
msgctxt "text_id=1674 | speaker=kinomi"
msgid "　あのよぅ、オレは妹の相手してやるだけなんだよぅ。隣のクソ中華飯店の手伝いなんかしねーよー」"
msgstr "  I was gonna say, I'm gonna be watching my kid sister. I ain't helping out at that crappy Chinese restaurant.\""

#. Occurrence 1DOT5_4:655:1675: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_1DOT5_4_0003; voice_prefix=B70; voice_category=4; scene=1DOT5_4
#: 1DOT5_4:655
msgctxt "text_id=1675 | speaker=tobimaru"
msgid "「草の字は？　明日もバイトか？」"
msgstr "\"What about you, Sono-G? You working tomorrow?\""

#. Occurrence 1DOT5_4:683:1676: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0005; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:683
msgctxt "text_id=1676 | speaker=soujuurou"
msgid "「いや、それが一日空いてる。今日はこれから遊園地でアルバイトだけど」"
msgstr "\"No, no plans. But I am going to work at the amusement park after school today.\""

#. Occurrence 1DOT5_4:727:1677: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0011; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:727
msgctxt "text_id=1677 | speaker=kinomi"
msgid "「うげぇ、それって魔のキッツィーランド？"
msgstr "\"What, Magic Kitsy Land? Seriously?"

#. Occurrence 1DOT5_4:733:1678: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0012; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:733
msgctxt "text_id=1678 | speaker=kinomi"
msgid "　タフだねぇ静希。あそこのバイトは柔道部の連中でも音を上げるって話じゃんか」"
msgstr "  You're tougher than you look, Sizuki. I heard even the judo guys who worked there bailed.\""

#. Occurrence 1DOT5_4:761:1679: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0006; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:761
msgctxt "text_id=1679 | speaker=soujuurou"
msgid "「……なんと。まさか、ネコクロの荷物運びより辛い？」"
msgstr "\"It couldn't possibly be worse than carrying boxes for ExFed, right?\""

#. Occurrence 1DOT5_4:796:1680: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0013; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:796
msgctxt "text_id=1680 | speaker=kinomi"
msgid "「んー。いや、そこまではよく。"
msgstr "\"Well... okay, not that bad."

#. Occurrence 1DOT5_4:802:1681: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0014; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:802
msgctxt "text_id=1681 | speaker=kinomi"
msgid "　しっかし山城のヤロウ遅ぇなあ。見ろ、となりのＢ組すらお帰りになられてるぞ」"
msgstr "  Damn, that a-hole Yamasiro is taking his sweet time. Look, Class B is already leaving!\""

#. Occurrence 1DOT5_4:808:1682: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_1DOT5_4_0004; voice_prefix=B70; voice_category=4; scene=1DOT5_4
#: 1DOT5_4:808
msgctxt "text_id=1682 | speaker=tobimaru"
msgid "「だな。仕方ねえ、面倒だが呼んでくるか。草の字を遅刻させるワケにゃいかねえし」"
msgstr "\"Looks like it. You know, I didn't wanna pull this card, but we'll just have to call him. We can't let Sono-G be late for work.\""

#. Occurrence 1DOT5_4:851:1683: scene=1DOT5_4
#: 1DOT5_4:851
msgctxt "text_id=1683 | speaker=unknown"
msgid "　大儀そうにベランダの手すりから体を起こす槻司鳶丸と、"
msgstr "  And as if by design, the moment Tobimaru Tsukiji stood up wearily from the balcony railing..."

#. Occurrence 1DOT5_4:858:1684: scene=1DOT5_4
#: 1DOT5_4:858
msgctxt "text_id=1684 | speaker=unknown"
msgid "　狙いすましたように、ピンポンパン、と鳴り響く校内放送。"
msgstr "  ...the school's PA system chime rang."

#. Occurrence 1DOT5_4:896:1685: voice_id=F30_1DOT5_4_0000_A; voice_prefix=F30; voice_category=0; scene=1DOT5_4
#: 1DOT5_4:896
msgctxt "text_id=1685 | speaker=unknown"
msgid "『２年Ｃ組の静希草十郎くん。山城先生がお呼びです。至急、職員室まで来てください。繰り返します、２年Ｃ組の～』"
msgstr "\"Soujyuro Sizuki, Class 2-C, please report immediately to Mr. Yamasiro in the faculty room. I repeat, Soujyuro Sizuki, Class 2-C...\""

#. Occurrence 1DOT5_4:920:1686: scene=1DOT5_4
#: 1DOT5_4:920
msgctxt "text_id=1686 | speaker=unknown"
msgid "　三人の間に気まずい沈黙。"
msgstr "  An awkward silence fell upon the three."

#. Occurrence 1DOT5_4:925:1687: scene=1DOT5_4
#: 1DOT5_4:925
msgctxt "text_id=1687 | speaker=unknown"
msgid "　五秒ほどぼんやりしてから、草十郎はそれじゃあ、とふたりを残してベランダを後にした。"
msgstr "  After a long five seconds, Soujyuro said goodbye and headed back inside."

#. Occurrence 1DOT5_4:964:1688: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0015; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:964
msgctxt "text_id=1688 | speaker=kinomi"
msgid "「面白いコトねぇなあ。誰か、校庭にミステリーサークルとか作ってくんねぇかなあ」"
msgstr "\"Ugh, nothing interesting ever happens here. Can't someone make a crop circle in the schoolyard or something?\""

#. Occurrence 1DOT5_4:970:1689: scene=1DOT5_4
#: 1DOT5_4:970
msgctxt "text_id=1689 | speaker=unknown"
msgid "　肩の力を抜きまくり、完全脱力人間になりながらぼやく木乃美。"
msgstr "  Kinomi grumbled, slouching his shoulders and succumbing to his lethargy."

#. Occurrence 1DOT5_4:1013:1690: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_1DOT5_4_0005; voice_prefix=B70; voice_category=4; scene=1DOT5_4
#: 1DOT5_4:1013
msgctxt "text_id=1690 | speaker=tobimaru"
msgid "「他人の妄想力に期待すんなよ。刺激が欲しいならテメエでイベント起こせ。ほら、クラス分け発表の時よろしく、蒼崎につっかかればすぐだぜ」"
msgstr "\"Stop expecting others to make life interesting. If you're bored, then make something happen yourself. Challenge Aozaki to an inter-class debate or something.\""

#. Occurrence 1DOT5_4:1060:1691: scene=1DOT5_4
#: 1DOT5_4:1060
msgctxt "text_id=1691 | speaker=unknown"
msgid "「ひいい、蘇るトラウマ！　やだよー、会長の<大立|おおた>ちまわりは<面白|おもしろ>いのを通りこして<恐|おそ>ろしいよー。"
msgstr "\"Suffering ain't interesting! Scrapping with the prez is asking for it. I said 'interesting' not 'terrifying.'"

#. Occurrence 1DOT5_4:1072:1692: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0016_1; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:1072
msgctxt "text_id=1692 | speaker=kinomi"
msgid "善良な一男子生徒としちゃあ、美少女が転校してくるだけでいいんだよー。"
msgstr "As a decent, upstanding, red-blooded male, I'd happily settle for a hot transfer student showing up."

#. Occurrence 1DOT5_4:1083:1693: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0017; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:1083
msgctxt "text_id=1693 | speaker=kinomi"
msgid "　んー、まあ、フツーの子じゃつまんないから、ハリウッドのプロデューサーとか、イギリスの歌姫とかー」"
msgstr "  As long as she isn't boring, anyway. Maybe if she were a Hollywood producer, or some famous English singer, or-\""

#. Occurrence 1DOT5_4:1114:1694: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_1DOT5_4_0006; voice_prefix=B70; voice_category=4; scene=1DOT5_4
#: 1DOT5_4:1114
msgctxt "text_id=1694 | speaker=tobimaru"
msgid "「どんな<括|くく>りだそりゃ。そこは火星のお姫さまあたりにしとけよ」"
msgstr "\"Laaame. If you're going that far, at least make her a babe from Mars.\""

#. Occurrence 1DOT5_4:1137:1695: voice_id=F30_1DOT5_4_0001; voice_prefix=F30; voice_category=0; scene=1DOT5_4
#: 1DOT5_4:1137
msgctxt "text_id=1695 | speaker=unknown"
msgid "『それと、２年Ｃ組の皆さんへ、山城先生から伝言です。"
msgstr "\"Attention, Class 2-C. This is an announcement from Mr. Yamasiro:"

#. Occurrence 1DOT5_4:1143:1696: voice_id=F30_1DOT5_4_0002; voice_prefix=F30; voice_category=0; scene=1DOT5_4
#: 1DOT5_4:1143
msgctxt "text_id=1696 | speaker=unknown"
msgid "“山城先生は訳あってＨＲを欠席しますので、各自、勝手に下校しちゃってくださいね。それではでは”"
msgstr "Mr. Yamasiro is currently occupied and unable to attend homeroom. Please make your way home."

#. Occurrence 1DOT5_4:1149:1697: voice_id=F30_1DOT5_4_0003; voice_prefix=F30; voice_category=0; scene=1DOT5_4
#: 1DOT5_4:1149
msgctxt "text_id=1697 | speaker=unknown"
msgid "　以上、放送室からお知らせしました』"
msgstr "  This concludes all announcements for the day.\""

#. Occurrence 1DOT5_4:1175:1698: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_1DOT5_4_0018; voice_prefix=B50; voice_category=6; scene=1DOT5_4
#: 1DOT5_4:1175
msgctxt "text_id=1698 | speaker=kinomi"
msgid "「……どうよコレ。山城、新車買ってからフリーダムすぎねえ？　このままではあの真新しいセルビアに、オレのギザ<十|じゅう>がうなりかねん」"
msgstr "\"...The hell? Ever since Yamasiro bought that new car, he's been a real punk! Maybe I'll see what sound this dime makes against the door of a new Serbia!\""

#. Occurrence 1DOT5_4:1181:1699: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_1DOT5_4_0007; voice_prefix=B70; voice_category=4; scene=1DOT5_4
#: 1DOT5_4:1181
msgctxt "text_id=1699 | speaker=tobimaru"
msgid "「鍵穴にガム程度にしとけ。教師の薄給はマジ同情に値するからな」"
msgstr "\"Hold it, hotshot. Just put gum in the keyhole. Teachers get paid peanuts, man.\""

#. Occurrence 1DOT5_4:1216:1700: scene=1DOT5_4
#: 1DOT5_4:1216
msgctxt "text_id=1700 | speaker=unknown"
msgid "　ぼやきながらも教室に戻る悪友ふたり。"
msgstr "  The two frenemies returned to the classroom, complaining all the while,"

#. Occurrence 1DOT5_4:1221:1701: scene=1DOT5_4
#: 1DOT5_4:1221
msgctxt "text_id=1701 | speaker=unknown"
msgid "　職員室に呼び出された友人の心配は、これっぽっちもしていなかった。"
msgstr "  their concern for their mutual friend summoned to the faculty office completely out of mind."

#. Occurrence 1DOT5_4:1267:1702: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0000; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1267
msgctxt "text_id=1702 | speaker=aoko"
msgid "「納得いきません。生徒のアルバイトは認められています。"
msgstr "\"I don't agree. The school allows for students to hold part-time jobs."

#. Occurrence 1DOT5_4:1273:1703: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0001; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1273
msgctxt "text_id=1703 | speaker=aoko"
msgid "　学校公認の職場であるなら、社会経験の一環として推奨する、と校則にもありますが」"
msgstr "  According to school regulations, a job at a workplace authorized by the school is recommended as a social experience.\""

#. Occurrence 1DOT5_4:1291:1704: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0000; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1291
msgctxt "text_id=1704 | speaker=yamashiro"
msgid "「そうなんだけどねえ。彼の場合、やりすぎなのが問題なワケで。"
msgstr "\"That's true, but in his case it's a matter of going too far."

#. Occurrence 1DOT5_4:1298:1705: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0001; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1298
msgctxt "text_id=1705 | speaker=yamashiro"
msgid "仮に、もし認可していない、労働基準法に反してそうな所で働いてたら困るでしょ、<学校|うち>も彼も」"
msgstr "What if, let's suppose, he were working somewhere without permission, somewhere that might be violating the Labor Standards Law? That would spell trouble for both the school and for him.\""

#. Occurrence 1DOT5_4:1329:1706: scene=1DOT5_4
#: 1DOT5_4:1329
msgctxt "text_id=1706 | speaker=unknown"
msgid "　<土曜日|ハンドン>の昼食を前に浮き足立つ職員室で、鬼の生徒会長となあなあ現国教師が危険な匂いをまき散らす。"
msgstr "  The volatile tension between the ruthless student council president and the easygoing modern language teacher permeated the room."

#. Occurrence 1DOT5_4:1334:1707: scene=1DOT5_4
#: 1DOT5_4:1334
msgctxt "text_id=1707 | speaker=unknown"
msgid "　他の教師陣はくわばらくわばら、と会議室にそそくさ移動。"
msgstr "  Praying to be spared from the impending confrontation, the other teachers hurriedly relocated to the meeting room."

#. Occurrence 1DOT5_4:1339:1708: scene=1DOT5_4
#: 1DOT5_4:1339
msgctxt "text_id=1708 | speaker=unknown"
msgid "　山城教諭がおや？と気づいた時、職員室にいるのは彼と、生徒会長・蒼崎青子その人だけだった。"
msgstr "  By the time Mr. Yamasiro noticed this, the only other person in the room was the student council president, Aoko Aozaki."

#. Occurrence 1DOT5_4:1372:1709: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0002; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1372
msgctxt "text_id=1709 | speaker=yamashiro"
msgid "「……逃げたか。ひどいなあみんな、怖いのは僕に押しつけてばっかりだもんなあ」"
msgstr "\"...They all ran, huh. Why does everyone always push the scary jobs on me? They're so mean.\""

#. Occurrence 1DOT5_4:1390:1710: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0002; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1390
msgctxt "text_id=1710 | speaker=aoko"
msgid "「話の続きです、先生。"
msgstr "\"Don't change the subject, sir."

#. Occurrence 1DOT5_4:1396:1711: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0003; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1396
msgctxt "text_id=1711 | speaker=aoko"
msgid "　仮に彼が指定以外のアルバイトをしているとしたら、それは彼の要求に学校側が応えていないからではありませんか？」"
msgstr "  If we do suppose that he is working at an unauthorized workplace, doesn't that mean that the school isn't accommodating his needs?\""

#. Occurrence 1DOT5_4:1422:1712: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0004; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1422
msgctxt "text_id=1712 | speaker=aoko"
msgid "「下宿先の家賃を奨学金でまかなえとは言いませんが、時間の許すかぎり働きたい、という要望は考慮すべきです。"
msgstr "\"I'm not saying that the school needs to cover his room and board, but as long as he's not working too much, his request deserves due consideration."

#. Occurrence 1DOT5_4:1433:1713: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0005; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1433
msgctxt "text_id=1713 | speaker=aoko"
msgid "　指定外のアルバイトを疑うのなら、まず“働き先は一生徒につき一件だけ”という規則を改めてください」"
msgstr "  And if you are still concerned about unauthorized workplaces, please first revise the rule that limits each student to only one.\""

#. Occurrence 1DOT5_4:1465:1714: scene=1DOT5_4
#: 1DOT5_4:1465
msgctxt "text_id=1714 | speaker=unknown"
msgid "　生徒会長の静かな語り口調に、これはどうあっても引いてくれないなあ、と山城教諭はうなだれる。"
msgstr "  After hearing her out and realizing there was no way she would back down, Mr. Yamasiro hung his head."

#. Occurrence 1DOT5_4:1495:1715: scene=1DOT5_4
#: 1DOT5_4:1495
msgctxt "text_id=1715 | speaker=unknown"
msgid "　事はもっと単純に済む筈だった。"
msgstr "  This was supposed to be easy."

#. Occurrence 1DOT5_4:1500:1716: scene=1DOT5_4
#: 1DOT5_4:1500
msgctxt "text_id=1716 | speaker=unknown"
msgid "『複数のアルバイトをしている』と噂をたてられた生徒を呼び出して事情を<訊|たず>ね、これが真実なら注意・指導し、世は全て事も無し、と昼食に向かう予定だったのだ。"
msgstr "  The plan was to call in the student rumored to be working multiple jobs, confirm whether the rumor was true, and if so, give him a warning and some guidance, then head to lunch with the knowledge that all was right with the world."

#. Occurrence 1DOT5_4:1505:1717: scene=1DOT5_4
#: 1DOT5_4:1505
msgctxt "text_id=1717 | speaker=unknown"
msgid "　その話をたまたま職員室に来ていた生徒会長が聞きつけ、それはおかしい、と食いついてしまった。"
msgstr "  The student council president, who was coincidentally in the faculty room at the time, had heard the entire issue and decided to call out this injustice."

#. Occurrence 1DOT5_4:1525:1718: scene=1DOT5_4
#: 1DOT5_4:1525
msgctxt "text_id=1718 | speaker=unknown"
msgid "　山城自身、生徒会長の意見はもっともだし、<件|くだん>の生徒の事情も理解している。"
msgstr "  As far as Mr. Yamasiro was concerned, she was in the right, and he was well aware of the aforementioned student's situation."

#. Occurrence 1DOT5_4:1530:1719: scene=1DOT5_4
#: 1DOT5_4:1530
msgctxt "text_id=1719 | speaker=unknown"
msgid "　個人的には応援してやりたいのだが、彼も悲しい新米教師。"
msgstr "  Personally, he would have liked to help, but among the faculty he was just the new kid on the block."

#. Occurrence 1DOT5_4:1535:1720: scene=1DOT5_4
#: 1DOT5_4:1535
msgctxt "text_id=1720 | speaker=unknown"
msgid "　副教頭のご機嫌もうかがいたいし、薄給とはいえ職を失うのもよろしくない。"
msgstr "  He wanted to stay on the vice principal's good side, and at the very least not lose his job, as badly paid as it was."

#. Occurrence 1DOT5_4:1574:1721: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0003; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1574
msgctxt "text_id=1721 | speaker=yamashiro"
msgid "「……こればかりはね。副教頭先生直々の注意なんで、僕も助けてあげられないんだよ」"
msgstr "\"...Look. This was a warning straight from the vice principal. I can't do anything more to help.\""

#. Occurrence 1DOT5_4:1580:1722: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0006; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1580
msgctxt "text_id=1722 | speaker=aoko"
msgid "「それでしたら、落としどころがあればいいんですね？」"
msgstr "\"What if we compromised?\""

#. Occurrence 1DOT5_4:1591:1723: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0004; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1591
msgctxt "text_id=1723 | speaker=yamashiro"
msgid "「うん？」"
msgstr "\"What do you mean?\""

#. Occurrence 1DOT5_4:1612:1724: scene=1DOT5_4
#: 1DOT5_4:1612
msgctxt "text_id=1724 | speaker=unknown"
msgid "　生徒会長は鞄から一枚の書類を取り出した。"
msgstr "  The student council president removed a document from her bag."

#. Occurrence 1DOT5_4:1617:1725: scene=1DOT5_4
#: 1DOT5_4:1617
msgctxt "text_id=1725 | speaker=unknown"
msgid "　今朝の職員会議でも取り上げられた、全教員の頭痛の種の一つである。"
msgstr "  It was a document that had been brought up in the morning's faculty meeting, bringing a host of headaches with it."

#. Occurrence 1DOT5_4:1643:1726: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0005; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1643
msgctxt "text_id=1726 | speaker=yamashiro"
msgid "「蒼崎くん、それは」"
msgstr "\"Ms. Aozaki, that's not the...\""

#. Occurrence 1DOT5_4:1665:1727: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0007; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1665
msgctxt "text_id=1727 | speaker=aoko"
msgid "「はい。<合田|あいだ>教会のボランティア参加の申告書です。"
msgstr "\"Yes. This is the Aida Church's volunteer registration form."

#. Occurrence 1DOT5_4:1671:1728: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0008; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1671
msgctxt "text_id=1728 | speaker=aoko"
msgid "　今月も希望者ゼロですね。敬虔なクリスチャンである副教頭先生は、さぞお気を悪くしているかと。"
msgstr "  There were zero applicants again this month, a fact that would certainly bother a devout Christian like the vice principal."

#. Occurrence 1DOT5_4:1677:1729: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0009; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1677
msgctxt "text_id=1729 | speaker=aoko"
msgid "　我が校の生徒には信心が足りん、と、今朝も<嘆|なげ>かれていたとか？」"
msgstr "  Even this morning he was lamenting our students' lack of faith.\""

#. Occurrence 1DOT5_4:1710:1730: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0006; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1710
msgctxt "text_id=1730 | speaker=yamashiro"
msgid "「……そうだけど。どうして君が今朝の職員会議の内容を知っているか聞きたいよ、ホント」"
msgstr "\"...I can't deny that, but what I'd really like to know is how you became so well-informed of the content of this morning's faculty meeting.\""

#. Occurrence 1DOT5_4:1716:1731: scene=1DOT5_4
#: 1DOT5_4:1716
msgctxt "text_id=1731 | speaker=unknown"
msgid "　頭を掻く山城教諭だが、その目は楽しげに笑っている。"
msgstr "  Mr. Yamasiro scratched his head, but his eyes were smiling gleefully."

#. Occurrence 1DOT5_4:1721:1732: scene=1DOT5_4
#: 1DOT5_4:1721
msgctxt "text_id=1732 | speaker=unknown"
msgid "　生徒会長の狙いに合点がいったからだ。"
msgstr "  He had figured out the student council president's objective."

#. Occurrence 1DOT5_4:1760:1733: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0007; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1760
msgctxt "text_id=1733 | speaker=yamashiro"
msgid "「<魚心|うおごころ>あれば<水心|みずごころ>あり、ですか。"
msgstr "\"So, I'll scratch your back, and you'll scratch mine. Is that it?"

#. Occurrence 1DOT5_4:1766:1734: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0008; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1766
msgctxt "text_id=1734 | speaker=yamashiro"
msgid "　教会への奉仕活動はボランティアだけど、きちんと謝礼がでる。あれもカタチの上では学校側が推奨する社会見学だからね。"
msgstr "  Work conducted on the church's behalf is done on a voluntary basis, but still compensated in some form. And it's officially recognized by the school as a form of social study."

#. Occurrence 1DOT5_4:1772:1735: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0009; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1772
msgctxt "text_id=1735 | speaker=yamashiro"
msgid "　副教頭先生は参加者がでた事に喜び、加えて、」"
msgstr "  The vice principal will be overjoyed to have a participant, and-\""

#. Occurrence 1DOT5_4:1809:1736: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0010; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1809
msgctxt "text_id=1736 | speaker=aoko"
msgid "「その参加希望者が既に他のアルバイトに就いていた場合、学校側の認可が二つになっちゃいますね。"
msgstr "\"And in the event that said volunteer is already employed somewhere else, the school's permission will be extended to both."

#. Occurrence 1DOT5_4:1815:1737: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0011; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1815
msgctxt "text_id=1737 | speaker=aoko"
msgid "　前例にしては、いい落としどころだと思いますが」"
msgstr "  Considering the precedent, I find this to be a good compromise.\""

#. Occurrence 1DOT5_4:1850:1738: scene=1DOT5_4
#: 1DOT5_4:1850
msgctxt "text_id=1738 | speaker=unknown"
msgid "　まいった、と手をあげる山城教諭。"
msgstr "  Mr. Yamasiro raised his hands in surrender."

#. Occurrence 1DOT5_4:1855:1739: scene=1DOT5_4
#: 1DOT5_4:1855
msgctxt "text_id=1739 | speaker=unknown"
msgid "　問題を告発しながらも、きちんと解決策を提案してくる生徒はそういない。"
msgstr "  There were few students able to both raise a complaint and propose a proper solution."

#. Occurrence 1DOT5_4:1860:1740: scene=1DOT5_4
#: 1DOT5_4:1860
msgctxt "text_id=1740 | speaker=unknown"
msgid "　この女生徒が恐れられながらも頼られているのは、この姉御肌なところによるものだろう。"
msgstr "  Perhaps it was her big-sisterly disposition that made this girl so simultaneously feared yet trusted."

#. Occurrence 1DOT5_4:1891:1741: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0010; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1891
msgctxt "text_id=1741 | speaker=yamashiro"
msgid "「よし、その方向で攻めてみよう。上手くいくよう祈ってくれよ」"
msgstr "\"All right, let's try it your way. Just... say a prayer for me, okay?\""

#. Occurrence 1DOT5_4:1909:1742: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0012; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1909
msgctxt "text_id=1742 | speaker=aoko"
msgid "「他力本願は嫌いです。<悪巧|わるだく>みに乗ってくれるのなら、きちんと活躍してください、山城先生」"
msgstr "\"I don't like it when people are overly reliant on others. If you're going to participate in this scheme, please take your part seriously, Mr. Yamasiro.\""

#. Occurrence 1DOT5_4:1919:1743: scene=1DOT5_4
#: 1DOT5_4:1919
msgctxt "text_id=1743 | speaker=unknown"
msgid "　それでは失礼します、と礼をして職員室を去る生徒会長。"
msgstr "  With a bow, the student council president turned to leave the faculty room."

#. Occurrence 1DOT5_4:1940:1744: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0011; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1940
msgctxt "text_id=1744 | speaker=yamashiro"
msgid "「あ、待った待った、君も残るんだ。"
msgstr "\"Ah, wait a second. You're not going anywhere."

#. Occurrence 1DOT5_4:1947:1745: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0012; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:1947
msgctxt "text_id=1745 | speaker=yamashiro"
msgid "今から静希くんを呼ぶから、ちゃんと面倒見てもらわないと」"
msgstr "I'm going to go ahead and call in Sizuki now, so I'll need you to stay and look after him properly.\""

#. Occurrence 1DOT5_4:1970:1746: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0013; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:1970
msgctxt "text_id=1746 | speaker=aoko"
msgid "「――――――は？」"
msgstr "\"...What?\""

#. Occurrence 1DOT5_4:1990:1747: scene=1DOT5_4
#: 1DOT5_4:1990
msgctxt "text_id=1747 | speaker=unknown"
msgid "　少女のクールな瞳が、きゅっと細くなる。"
msgstr "  The girl's cool eyes narrowed."

#. Occurrence 1DOT5_4:1995:1748: scene=1DOT5_4
#: 1DOT5_4:1995
msgctxt "text_id=1748 | speaker=unknown"
msgid "　いま、心底理解できない台詞を聞いたんだけど、と山城教諭を睨みつける。"
msgstr "  Unable to process what she had just heard, her expression turned to a scowl."

#. Occurrence 1DOT5_4:2034:1749: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0013; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:2034
msgctxt "text_id=1749 | speaker=yamashiro"
msgid "「いや、参加希望者は一人より二人の方がいいだろ。"
msgstr "\"If we're looking for volunteers, two is better than one, right?"

#. Occurrence 1DOT5_4:2040:1750: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0014; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:2040
msgctxt "text_id=1750 | speaker=yamashiro"
msgid "　蒼崎くんがフォローしてくれるなら僕も安心だしね」"
msgstr "  Plus, knowing that you are following up on this would give me great peace of mind.\""

#. Occurrence 1DOT5_4:2046:1751: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0014; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2046
msgctxt "text_id=1751 | speaker=aoko"
msgid "「あの、ちょっと、先生」"
msgstr "\"But, sir, I don't―\""

#. Occurrence 1DOT5_4:2087:1752: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0015; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:2087
msgctxt "text_id=1752 | speaker=yamashiro"
msgid "「あ、放送室？　２年Ｃ組の静希草十郎くん、至急職員室に来てください、で放送、お願いします」"
msgstr "\"Hello, broadcasting room? Please put out an announcement asking for Class 2-C student Soujyuro Sizuki to report to Mr. Yamasiro in the staff room immediately.\""

#. Occurrence 1DOT5_4:2093:1753: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0015; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2093
msgctxt "text_id=1753 | speaker=aoko"
msgid "「その、だから、先生」"
msgstr "\"No, like I was about to say―\""

#. Occurrence 1DOT5_4:2127:1754: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0016; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:2127
msgctxt "text_id=1754 | speaker=yamashiro"
msgid "「いやあ、これで万全だ！　まさか頭痛のタネが同時に消え去るなんて、今日はついてる！"
msgstr "\"Oh, this is perfect! And to think that the source of my headache would go away, too. Today's my lucky day!"

#. Occurrence 1DOT5_4:2134:1755: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_1DOT5_4_0017; voice_prefix=B60; voice_category=7; scene=1DOT5_4
#: 1DOT5_4:2134
msgctxt "text_id=1755 | speaker=yamashiro"
msgid "　ああ、けど蒼崎くん、ずいぶん親身になってくれるんだね。なに、もしかしてああいうのがタイプ？　あ、放送室さん、ついでに生徒会長が心からお待ちしていますと付け足して―――」"
msgstr "  Ms. Aozaki, what would I do without your kindness? Wait a second... He's not your type, is he? ...Oh, broadcasting room? Please add the following: 'The student council president is eagerly awaiting-'\""

#. Occurrence 1DOT5_4:2140:1756: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0016; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2140
msgctxt "text_id=1756 | speaker=aoko"
msgid "「って、山城ォ―――！」"
msgstr "\"Mr. Yamasirooo!\""

#. Occurrence 1DOT5_4:2251:1757: scene=1DOT5_4
#: 1DOT5_4:2251
msgctxt "text_id=1757 | speaker=unknown"
msgid "　翌日、気持ちのいい日曜日。"
msgstr "  The next day, a pleasant Sunday."

#. Occurrence 1DOT5_4:2257:1758: scene=1DOT5_4
#: 1DOT5_4:2257
msgctxt "text_id=1758 | speaker=unknown"
msgid "　草十郎は待ち合わせの時間より二時間早く目を覚ました。"
msgstr "  Soujyuro was awake two hours before the time he was supposed to meet her."

#. Occurrence 1DOT5_4:2294:1759: scene=1DOT5_4
#: 1DOT5_4:2294
msgctxt "text_id=1759 | speaker=unknown"
msgid "　その後、気を落ち着けるためにジョギングがてらの散歩にでかけ、三十分で戻るつもりがあれこれ考えているうちに一時間近く経っている事に気づき、あわてて帰宅。"
msgstr "  After getting up, he decided to go for a leisurely jog to clear his mind, but, lost among his own thoughts, his thirty-minute jog turned into almost an hour. Upon realizing, he rushed home."

#. Occurrence 1DOT5_4:2299:1760: scene=1DOT5_4
#: 1DOT5_4:2299
msgctxt "text_id=1760 | speaker=unknown"
msgid "　何を着ていくものか考え抜いたあげく、結局、学校の制服で臨むことにした。"
msgstr "  After thoroughly racking his brain over what to wear for the occasion, he decided upon wearing his school uniform."

#. Occurrence 1DOT5_4:2333:1761: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0017; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2333
msgctxt "text_id=1761 | speaker=aoko"
msgid "“午前十時、三咲中央公園の東入り口で待ち合わせ”"
msgstr "\"Ten o'clock, Misaki Central Park, east entrance. I'll meet you there.\""

#. Occurrence 1DOT5_4:2354:1762: scene=1DOT5_4
#: 1DOT5_4:2354
msgctxt "text_id=1762 | speaker=unknown"
msgid "　昨日の職員室。"
msgstr "  Yesterday in the faculty room..."

#. Occurrence 1DOT5_4:2359:1763: scene=1DOT5_4
#: 1DOT5_4:2359
msgctxt "text_id=1763 | speaker=unknown"
msgid "　風邪気味だったのか、蒼崎青子は頭痛を押し殺すような顔でそう言った。"
msgstr "  When Aoko Aozaki had shared the time and place with him that day, she said it with such pain on her face. Maybe she was fighting a headache at the time."

#. Occurrence 1DOT5_4:2394:1764: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0007; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2394
msgctxt "text_id=1764 | speaker=soujuurou"
msgid "「しかし、蒼崎の風邪は治っているのだろうか」"
msgstr "\"I wonder if Aozaki is feeling better.\""

#. Occurrence 1DOT5_4:2400:1765: scene=1DOT5_4
#: 1DOT5_4:2400
msgctxt "text_id=1765 | speaker=unknown"
msgid "　草十郎はあさっての方向を見ながら、あさってを向いた心配ごとを呟く。"
msgstr "  Soujyuro muttered, his words of concern misguided as they were."

#. Occurrence 1DOT5_4:2405:1766: scene=1DOT5_4
#: 1DOT5_4:2405
msgctxt "text_id=1766 | speaker=unknown"
msgid "　ともあれ、そうして待つこと約五分。"
msgstr "  In any case, he waited for about five minutes."

#. Occurrence 1DOT5_4:2410:1767: scene=1DOT5_4
#: 1DOT5_4:2410
msgctxt "text_id=1767 | speaker=unknown"
msgid "　十時きっかりに生徒会長は登場した。"
msgstr "  At precisely ten o'clock, the student council president appeared."

#. Occurrence 1DOT5_4:2445:1768: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0018; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2445
msgctxt "text_id=1768 | speaker=aoko"
msgid "「おはよ。"
msgstr "\"Good morning."

#. Occurrence 1DOT5_4:2445:1769: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0018; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2445
msgctxt "text_id=1769 | speaker=aoko"
msgid "　いつもの事だけど、時間だけはピッタリよね、貴方」"
msgstr "  Punctual as usual, I see.\""

#. Occurrence 1DOT5_4:2463:1770: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0008; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2463
msgctxt "text_id=1770 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 1DOT5_4:2483:1771: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0019; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2483
msgctxt "text_id=1771 | speaker=aoko"
msgid "「ひどい顔ね。もしかして気分悪いの？」"
msgstr "\"What's wrong with your face? Are you sick?\""

#. Occurrence 1DOT5_4:2504:1772: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0009; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2504
msgctxt "text_id=1772 | speaker=soujuurou"
msgid "「いや、体調はいいと思う」"
msgstr "\"No, I think I feel fine.\""

#. Occurrence 1DOT5_4:2509:1773: scene=1DOT5_4
#: 1DOT5_4:2509
msgctxt "text_id=1773 | speaker=unknown"
msgid "　しんぱいごむよう、と軽く弁明する草十郎。"
msgstr "  He waved off her concern."

#. Occurrence 1DOT5_4:2515:1774: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0010; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2515
msgctxt "text_id=1774 | speaker=soujuurou"
msgid "「だがしかし、蒼崎は制服だった」"
msgstr "\"You're wearing your school uniform.\""

#. Occurrence 1DOT5_4:2526:1775: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0020; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2526
msgctxt "text_id=1775 | speaker=aoko"
msgid "「ええ。学校の行事だもの、当然でしょう？」"
msgstr "\"Of course I'm wearing my uniform. This is a school activity, isn't it?\""

#. Occurrence 1DOT5_4:2532:1776: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0011; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2532
msgctxt "text_id=1776 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 1DOT5_4:2566:1777: scene=1DOT5_4
#: 1DOT5_4:2566
msgctxt "text_id=1777 | speaker=unknown"
msgid "　がっくりと肩に重みを感じる草十郎。"
msgstr "  A heavy weight of despondency fell upon Soujyuro's shoulders."

#. Occurrence 1DOT5_4:2571:1778: scene=1DOT5_4
#: 1DOT5_4:2571
msgctxt "text_id=1778 | speaker=unknown"
msgid "　朝から<益体|やくたい>もなく浮き足立っていた二時間は、こうして容赦なく台無しにされた。"
msgstr "  The angsting over his outfit for the previous two hours had been rendered meaningless just like that."

#. Occurrence 1DOT5_4:2636:1779: scene=1DOT5_4
#: 1DOT5_4:2636
msgctxt "text_id=1779 | speaker=unknown"
msgid "　休日の駅前を、制服姿の男女が歩く。"
msgstr "  The duo, clad in their school uniforms on a day off, walked by the train station."

#. Occurrence 1DOT5_4:2641:1780: scene=1DOT5_4
#: 1DOT5_4:2641
msgctxt "text_id=1780 | speaker=unknown"
msgid "　はじめは丁寧に街の案内をしていた青子だが、今は必要最低限の説明だけにとどめている。"
msgstr "  In the beginning, Aoko had made efforts to give Soujyuro a thorough lay of the land, but today she only shared the bare minimum of explanations."

#. Occurrence 1DOT5_4:2673:1781: scene=1DOT5_4
#: 1DOT5_4:2673
msgctxt "text_id=1781 | speaker=unknown"
msgid "　草十郎が思いのほか町に詳しくなっていた事もあるが、"
msgstr "  This was partly because, surprisingly, Soujyuro had become well-accustomed to the town."

#. Occurrence 1DOT5_4:2678:1782: scene=1DOT5_4
#: 1DOT5_4:2678
msgctxt "text_id=1782 | speaker=unknown"
msgid "　やれここのゴハンがおいしいだの、"
msgstr "  Which restaurants were good... Which shortcuts to use in a rush..."

#. Occurrence 1DOT5_4:2683:1783: scene=1DOT5_4
#: 1DOT5_4:2683
msgctxt "text_id=1783 | speaker=unknown"
msgid "　急いでる時はこっちが近道だの、自転車を買うなら駅前デパートよりあっちの専門店のがいいだの、"
msgstr "  And why the nearby bicycle shop was better than the department store by the station if you wanted to buy a bicycle... things a local would know."

#. Occurrence 1DOT5_4:2693:1784: scene=1DOT5_4
#: 1DOT5_4:2693
msgctxt "text_id=1784 | speaker=unknown"
msgid "　そんな会話をしている時、ハタと冷静に、今の状況が第三者的にどう見えるかに気付いたからだ。"
msgstr "  But the other reason was that it had dawned on Aoko how the two of them conversing might look to passersby."

#. Occurrence 1DOT5_4:2729:1785: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0012; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2729
msgctxt "text_id=1785 | speaker=soujuurou"
msgid "「話は変わるけど。具体的にどんな労働内容なのか、そろそろ聞いていいかな」"
msgstr "\"On a different topic, do you mind telling me what kind of work we'll be doing today?\""

#. Occurrence 1DOT5_4:2749:1786: scene=1DOT5_4
#: 1DOT5_4:2749
msgctxt "text_id=1786 | speaker=unknown"
msgid "　教会の奉仕作業に参加すれば、今後、アルバイトの<掛|か>け<持|も>ちを大目にみてあげられる―――"
msgstr "  From here on, volunteering at the church meant that the school would tolerate his multiple jobs."

#. Occurrence 1DOT5_4:2754:1787: scene=1DOT5_4
#: 1DOT5_4:2754
msgctxt "text_id=1787 | speaker=unknown"
msgid "　そんな甘い誘いにコクコクと頷いた草十郎だが、例によって例の如く、どんな作業なのか考えてもいないようだ。"
msgstr "  Soujyuro had quickly agreed to the tempting offer, nodding like a bobblehead. But, as was typical for him, he had failed to consider the content of the proposal."

#. Occurrence 1DOT5_4:2787:1788: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0021; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2787
msgctxt "text_id=1788 | speaker=aoko"
msgid "「……まあ、そんなコトだろうと覚悟はしてたけど。"
msgstr "\"...Somehow, I just knew you had no idea what we're going to be doing today."

#. Occurrence 1DOT5_4:2793:1789: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0022; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2793
msgctxt "text_id=1789 | speaker=aoko"
msgid "　貴方、<合田|あいだ>教会は初めて？」"
msgstr "  Is this your first time going to Aida Church?\""

#. Occurrence 1DOT5_4:2799:1790: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0013; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2799
msgctxt "text_id=1790 | speaker=soujuurou"
msgid "「教会なら二回目だ。珍しい建物なんで近寄ったら、中の人がタダでお菓子をくれたんだけど……」"
msgstr "\"This is my second time. The last time was because I was outside admiring the strange architecture, and then a person inside gave me some free candy.\""

#. Occurrence 1DOT5_4:2836:1791: scene=1DOT5_4
#: 1DOT5_4:2836
msgctxt "text_id=1791 | speaker=unknown"
msgid "　どういう仕組みなんだろう、と草十郎は真剣に考えこんでいる。"
msgstr "  He pondered with all sincerity how exactly a church worked."

#. Occurrence 1DOT5_4:2841:1792: scene=1DOT5_4
#: 1DOT5_4:2841
msgctxt "text_id=1792 | speaker=unknown"
msgid "　うつむく仕草は哲学者のソレだが、しょせん、"
msgstr "  His contemplative posture made him appear the part of the philosopher, but after all his thinking, he concluded,"

#. Occurrence 1DOT5_4:2847:1793: scene=1DOT5_4
#: 1DOT5_4:2847
msgctxt "text_id=1793 | speaker=unknown"
msgid "“やっぱり二回目からはお金をとられるのだろうか？”"
msgstr "\"I guess they start taking your money on your second visit?\""

#. Occurrence 1DOT5_4:2853:1794: scene=1DOT5_4
#: 1DOT5_4:2853
msgctxt "text_id=1794 | speaker=unknown"
msgid "　程度の悩みである。"
msgstr "  ...Such was the extent of Soujyuro's concerns."

#. Occurrence 1DOT5_4:2888:1795: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0023; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2888
msgctxt "text_id=1795 | speaker=aoko"
msgid "「……普通、そういうコトは子供にしかしないんだけどね、あの教会は」"
msgstr "\"...Normally, the church only gives candy out to children, you know.\""

#. Occurrence 1DOT5_4:2894:1796: scene=1DOT5_4
#: 1DOT5_4:2894
msgctxt "text_id=1796 | speaker=unknown"
msgid "　よっぽど迷える子羊に見えたんだろう、とため息をつく青子。"
msgstr "  Aoko sighed at the lost little lamb."

#. Occurrence 1DOT5_4:2928:1797: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0024; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2928
msgctxt "text_id=1797 | speaker=aoko"
msgid "「で、どんな人にあったの？　神父、それともシスター？」"
msgstr "\"So who did you end up meeting? The priest? One of the sisters?\""

#. Occurrence 1DOT5_4:2934:1798: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0014; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2934
msgctxt "text_id=1798 | speaker=soujuurou"
msgid "「それはそれは、綺麗な女の人だった」"
msgstr "\"A very beautiful woman, as it happens.\""

#. Occurrence 1DOT5_4:2955:1799: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0025; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2955
msgctxt "text_id=1799 | speaker=aoko"
msgid "「じゃあ<唯架|ゆいか>さんの方ね。今日会ったらお礼を……って、必要ないか。アンタの事だから、そのあたりはキチッとしてるだろうし」"
msgstr "\"Oh, Sister Yuika, then. If we see her today, you'll need to thank her... or, then again, no need. You're doing just fine in that department anyway.\""

#. Occurrence 1DOT5_4:2961:1800: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0015; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:2961
msgctxt "text_id=1800 | speaker=soujuurou"
msgid "「？」"
msgstr "\"Hm?\""

#. Occurrence 1DOT5_4:2988:1801: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0026; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2988
msgctxt "text_id=1801 | speaker=aoko"
msgid "「仕事の話なら簡単よ。学校でやってる事と変わらないから。"
msgstr "\"As far as work goes, it's not much different from what you've been doing at school, so it should be straightforward."

#. Occurrence 1DOT5_4:2995:1802: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0027; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:2995
msgctxt "text_id=1802 | speaker=aoko"
msgid "あの教会、規模のわりに人数が少ないのよ」"
msgstr "And considering the church's size, there's actually not a lot of people.\""

#. Occurrence 1DOT5_4:3015:1803: scene=1DOT5_4
#: 1DOT5_4:3015
msgctxt "text_id=1803 | speaker=unknown"
msgid "　早足で教会に向かう青子。"
msgstr "  Aoko picked up her pace as they headed for the church."

#. Occurrence 1DOT5_4:3020:1804: scene=1DOT5_4
#: 1DOT5_4:3020
msgctxt "text_id=1804 | speaker=unknown"
msgid "　なんだか敵地に向かう鬼将軍のようだ、と草十郎は不安げに眉を曇らせた。"
msgstr "  Somehow, she seemed like a general invading enemy territory. It made Soujyuro furrow his brows in discomfort."

#. Occurrence 1DOT5_4:3067:1805: scene=1DOT5_4
#: 1DOT5_4:3067
msgctxt "text_id=1805 | speaker=unknown"
msgid "　合田教会は古い歴史を持つ教会だ。"
msgstr "  Aida Church had a long history."

#. Occurrence 1DOT5_4:3072:1806: scene=1DOT5_4
#: 1DOT5_4:3072
msgctxt "text_id=1806 | speaker=unknown"
msgid "　駅から離れた、オフィス街と住宅地の<狭間|はざま>に建てられた白い聖域。"
msgstr "  Far from the station, it was a white-painted sanctuary nestled between the business and residential districts."

#. Occurrence 1DOT5_4:3077:1807: scene=1DOT5_4
#: 1DOT5_4:3077
msgctxt "text_id=1807 | speaker=unknown"
msgid "　青子の知るかぎり、たしか八年ほど前に今のカタチに改装された、こんな田舎町には十分すぎるほどの大教会である。"
msgstr "  As far as Aoko could remember, the church as she knew it now was the result of remodeling done eight years prior. It was practically a cathedral for a town of this size."

#. Occurrence 1DOT5_4:3110:1808: scene=1DOT5_4
#: 1DOT5_4:3110
msgctxt "text_id=1808 | speaker=unknown"
msgid "　ちなみに横にあるのは三咲市一の総合病院。"
msgstr "  Incidentally, located next to it was the Misaki City General Hospital."

#. Occurrence 1DOT5_4:3115:1809: scene=1DOT5_4
#: 1DOT5_4:3115
msgctxt "text_id=1809 | speaker=unknown"
msgid "　青子からすれば、町で一番多くの命が失われる場所の隣にちゃっかり居を構える時点で信用ならない―――のだが、その所感を知るのは同居人である久遠寺有珠と、教会の神父だけに留まっている。"
msgstr "  From Aoko's perspective, it seemed awfully suspicious for the church to take up residence next to the location in the city where the most lives were lost, though the only two who were aware of this opinion were her roommate, Alice Kuonji, and the priest."

#. Occurrence 1DOT5_4:3147:1810: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0016; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:3147
msgctxt "text_id=1810 | speaker=soujuurou"
msgid "「蒼崎はこの教会に<縁|えん>があるのか？」"
msgstr "\"Are you a regular at this place?\""

#. Occurrence 1DOT5_4:3158:1811: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0028; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3158
msgctxt "text_id=1811 | speaker=aoko"
msgid "「私？　私はこれっぽっちも、もう過去に戻って<改竄|かいざん>したいぐらい微塵もないけど、うちの父と祖父は長い付き合い。"
msgstr "\"Me? Not in the slightest. My father and grandfather had a long history with it, but if I could, I'd go back in time and cut all of our ties to this place."

#. Occurrence 1DOT5_4:3169:1812: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0029; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3169
msgctxt "text_id=1812 | speaker=aoko"
msgid "　ここの手伝いなんて、忌々しいコトに小学生の頃は毎日してたもんだけど―――」"
msgstr "  I had to come here every day in elementary school to help out, and boy, did that ever rub me the wrong way.\""

#. Occurrence 1DOT5_4:3195:1813: scene=1DOT5_4
#: 1DOT5_4:3195
msgctxt "text_id=1813 | speaker=unknown"
msgid "　話せば話すほど、青子の表情は凶悪になっていく。"
msgstr "  The more Aoko spoke, the more twisted her expression became."

#. Occurrence 1DOT5_4:3200:1814: scene=1DOT5_4
#: 1DOT5_4:3200
msgctxt "text_id=1814 | speaker=unknown"
msgid "　忘れがたいトラウマと向き合い、胸ぐらを掴み、豪快に一本背負いをかまして脳天を地面にたたきつけたあと、無防備な胴体にローキックを食らわせる―――"
msgstr "  Recalling this made her want to grab it by the proverbial collar, give it the proverbial one-arm judo back throw, smash its proverbial head into the proverbial ground, and kick the proverbial living daylights out of its defenseless proverbial torso."

#. Occurrence 1DOT5_4:3205:1815: scene=1DOT5_4
#: 1DOT5_4:3205
msgctxt "text_id=1815 | speaker=unknown"
msgid "　トラウマとやらが擬人化していれば、その程度の報復行為を軽く五セットはこなしそうな、それはそれは凄まじい気炎をあげるのだった。"
msgstr "  Such was her so-called trauma that if it were anthropomorphized, it would take more than a five-round beating to satisfy her thirst for vengeance."

#. Occurrence 1DOT5_4:3240:1816: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0017; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:3240
msgctxt "text_id=1816 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 1DOT5_4:3246:1817: scene=1DOT5_4
#: 1DOT5_4:3246
msgctxt "text_id=1817 | speaker=unknown"
msgid "　そんな青子の不機嫌っぷりに、草十郎が我が身の危険を感じだした頃。"
msgstr "  It was in this moment, as he became aware of Aoko's mood, that Soujyuro began to fear for his safety."

#. Occurrence 1DOT5_4:3252:1818: scene=1DOT5_4
#: 1DOT5_4:3252
msgctxt "text_id=1818 | speaker=unknown"
msgid "　教会の上空にバサバサ集まりだしたカラスに惹かれたのか、"
msgstr "  Perhaps attracted by the noisy murder of crows outside the church,"

msgctxt "text_id=1819 | speaker=unknown"
msgid "正面玄関から<修道女|シスター>服の女性が姿を見せた。"
msgstr " a woman in a nun's habit emerged from the front entrance."

#. Occurrence 1DOT5_4:3288:1820: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0000; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3288
msgctxt "text_id=1820 | speaker=yuika"
msgid "「失礼ですが、どちらのお客様でしょう。"
msgstr "\"Excuse me, do you have business with the church today?"

#. Occurrence 1DOT5_4:3294:1821: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0001; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3294
msgctxt "text_id=1821 | speaker=yuika"
msgid "　当教会は暴力団関係の方はご遠慮いただいておりますので、日を<改|あらた>める、<或|ある>いは生き方を<悔|く>い改めた後、社会的な罪を<償|つぐな>ってから門をくぐって頂きたいのですが―――」"
msgstr "  I'm afraid this church does not associate with criminals, so if you would be so kind as to consider coming another day, or perhaps return once you have repented of your sinful ways and paid for your crimes to society, you can―\""

#. Occurrence 1DOT5_4:3300:1822: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0030; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3300
msgctxt "text_id=1822 | speaker=aoko"
msgid "「蒼崎青子です、シスター唯架」"
msgstr "\"It's Aoko Aozaki, Sister Yuika.\""

#. Occurrence 1DOT5_4:3333:1823: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0002; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3333
msgctxt "text_id=1823 | speaker=yuika"
msgid "「まあ―――青子さんでしたか。"
msgstr "\"Well, if it isn't Aoko."

#. Occurrence 1DOT5_4:3339:1824: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0003; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3339
msgctxt "text_id=1824 | speaker=yuika"
msgid "　驚きました。昼間のうちに貴女が来るのは久しぶりです」"
msgstr "  What a lovely surprise. It's been such a long time since you've visited.\""

#. Occurrence 1DOT5_4:3357:1825: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0031; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3357
msgctxt "text_id=1825 | speaker=aoko"
msgid "「そうですね。いつもは夜に呼ばれて、神父さまとだけお話をしていますから。唯架さんとは……"
msgstr "\"I suppose it has. I'm only ever called at night to speak with the father."

#. Occurrence 1DOT5_4:3363:1826: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0032; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3363
msgctxt "text_id=1826 | speaker=aoko"
msgid "　まあ。意外ですね、一年近く<ま|・><と|・><も|・>にお話をしていません。"
msgstr "  I suppose it's been, what, close to a year since we had a face-to-face conversation."

#. Occurrence 1DOT5_4:3376:1827: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0033; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3376
msgctxt "text_id=1827 | speaker=aoko"
msgid "ま、この先だって一度もないでしょうけど」"
msgstr "And who knows how long it'll be until the next time.\""

#. Occurrence 1DOT5_4:3414:1828: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0004; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3414
msgctxt "text_id=1828 | speaker=yuika"
msgid "「ええ。貴女もずいぶんと立派になられたようで、ガッカリです。なにより、今の気配は清らかな少女とは思えないほど<悪辣|あくらつ>でした」"
msgstr "\"Yes. I'm almost sad to see you grow up so fast. Your presence has become so menacing, you hardly resemble the virtuous girl I remember so well.\""

#. Occurrence 1DOT5_4:3420:1829: scene=1DOT5_4
#: 1DOT5_4:3420
msgctxt "text_id=1829 | speaker=unknown"
msgid "　表向き、和気あいあいと挨拶を交わすふたり。"
msgstr "  On the surface, the two exchanged congenial greetings."

#. Occurrence 1DOT5_4:3425:1830: scene=1DOT5_4
#: 1DOT5_4:3425
msgctxt "text_id=1830 | speaker=unknown"
msgid "　そのピリピリした空気をまったく読めず、仲がいいなあ、と見守る草十郎。"
msgstr "  Unable to read between the lines, all Soujyuro could see were two good friends."

#. Occurrence 1DOT5_4:3462:1831: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0034; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3462
msgctxt "text_id=1831 | speaker=aoko"
msgid "「今月のボランティアは私とそこの彼です。"
msgstr "\"He and I are this month's volunteers."

#. Occurrence 1DOT5_4:3468:1832: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0035; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3468
msgctxt "text_id=1832 | speaker=aoko"
msgid "　親愛なる合田教会のためですから。十時から三時まで、一分の狂いもなく、きっかり働かせていただきますわ」"
msgstr "  For the beloved Aida Church, it would be our pleasure to be working from exactly ten to three, and not a minute more.\""

#. Occurrence 1DOT5_4:3486:1833: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0005; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3486
msgctxt "text_id=1833 | speaker=yuika"
msgid "「まあ。世も末ですが歓迎しますね。"
msgstr "\"Well, as you know we are reaching the end times, but your spirit of service is welcome."

#. Occurrence 1DOT5_4:3492:1834: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0006; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3492
msgctxt "text_id=1834 | speaker=yuika"
msgid "　神の家は万人に等しく開くもの。この際、貴女の内面は見なかった事にしておきましょう」"
msgstr "  The house of the Lord is open to all who might enter, even those with wickedness in their hearts.\""

#. Occurrence 1DOT5_4:3512:1835: scene=1DOT5_4
#: 1DOT5_4:3512
msgctxt "text_id=1835 | speaker=unknown"
msgid "　上品に、しかし酷薄に微笑むシスター。"
msgstr "  The nun flashed a smile that was equal parts elegant and cruel."

#. Occurrence 1DOT5_4:3517:1836: scene=1DOT5_4
#: 1DOT5_4:3517
msgctxt "text_id=1836 | speaker=unknown"
msgid "　表向きはどうあれ、労働力が手に入ったのは喜ばしい事らしい。"
msgstr "  Keeping up appearances aside, she seemed overjoyed to have able hands to put to work."

#. Occurrence 1DOT5_4:3565:1837: scene=1DOT5_4
#: 1DOT5_4:3565
msgctxt "text_id=1837 | speaker=unknown"
msgid "　シスターは<周|す><瀬|せ><唯架|ゆいか>と名乗り、自ら奉仕活動を希望した草十郎に礼を述べた。"
msgstr "  The sister introduced herself as Yuika Suse and thanked Soujyuro, who had volunteered of his own volition."

#. Occurrence 1DOT5_4:3570:1838: scene=1DOT5_4
#: 1DOT5_4:3570
msgctxt "text_id=1838 | speaker=unknown"
msgid "　彼女の閉じた目に気づいていた草十郎だったが、青子の手前もあるし、なにより失礼な事かもしれない、と質問は遠慮した。"
msgstr "  Soujyuro noticed that her eyes were always shut, but not wanting to be rude, especially in front of Aoko, he decided not to pry."

#. Occurrence 1DOT5_4:3605:1839: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0007; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3605
msgctxt "text_id=1839 | speaker=yuika"
msgid "「静希さんと仰るのですね。"
msgstr "\"So you're Mr. Sizuki."

#. Occurrence 1DOT5_4:3611:1840: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0008; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3611
msgctxt "text_id=1840 | speaker=yuika"
msgid "　声のイメージ通り、落ち着いたお名前です」"
msgstr "  Your name is as calm as your countenance.\""

#. Occurrence 1DOT5_4:3617:1841: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0018; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:3617
msgctxt "text_id=1841 | speaker=soujuurou"
msgid "「はあ。それはどうも」"
msgstr "\"It is? Well, thanks.\""

#. Occurrence 1DOT5_4:3623:1842: scene=1DOT5_4
#: 1DOT5_4:3623
msgctxt "text_id=1842 | speaker=unknown"
msgid "　名前を誉められてもいまいち実感の湧かない草十郎に、シスターはわずかに顔を曇らせる。"
msgstr "  The sister let slip a frown at Soujyuro's ambivalent response to her compliment."

#. Occurrence 1DOT5_4:3651:1843: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0009; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3651
msgctxt "text_id=1843 | speaker=yuika"
msgid "「失礼、名字で呼ばれるのはお嫌いのようですね。"
msgstr "\"I apologize. I did not mean to cause discomfort by using your surname."

#. Occurrence 1DOT5_4:3657:1844: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0010; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3657
msgctxt "text_id=1844 | speaker=yuika"
msgid "　草十郎さん、でよろしいですか？」"
msgstr "  May I call you Soujyuro instead?\""

#. Occurrence 1DOT5_4:3677:1845: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0019; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:3677
msgctxt "text_id=1845 | speaker=soujuurou"
msgid "「え、いや、どっちでも、いいですけど」"
msgstr "\"Oh, um, whichever. Either one is fine.\""

#. Occurrence 1DOT5_4:3710:1846: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0011; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3710
msgctxt "text_id=1846 | speaker=yuika"
msgid "「ではそのように。……本当、難儀なことですね」"
msgstr "\"Well then, as you wish. ...I had not appreciated how difficult a subject it would be.\""

#. Occurrence 1DOT5_4:3716:1847: scene=1DOT5_4
#: 1DOT5_4:3716
msgctxt "text_id=1847 | speaker=unknown"
msgid "　口調こそ穏やかだが、シスターの言葉はどこか冷淡だ。"
msgstr "  Though the sister's tone was gentle, her words seemed somewhat indifferent."

#. Occurrence 1DOT5_4:3721:1848: scene=1DOT5_4
#: 1DOT5_4:3721
msgctxt "text_id=1848 | speaker=unknown"
msgid "　視界を閉ざしている彼女だが、確かな足取りで青子たちを先導する。"
msgstr "  She lacked sight, but she guided the two with certainty in her step."

#. Occurrence 1DOT5_4:3764:1849: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0012; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3764
msgctxt "text_id=1849 | speaker=yuika"
msgid "「それで、奉仕の内容ですが」"
msgstr "\"Well then, as for what you will be doing...\""

#. Occurrence 1DOT5_4:3776:1850: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0036; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3776
msgctxt "text_id=1850 | speaker=aoko"
msgid "「分かってます。クリスマス前だし、面倒な掃除を済ませておきたいんでしょう？"
msgstr "\"I already know. Christmas is coming up, so you want to get all of the tedious cleaning out of the way, right?"

#. Occurrence 1DOT5_4:3782:1851: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0037; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3782
msgctxt "text_id=1851 | speaker=aoko"
msgid "　問題ありません、そういうの得意ですから」"
msgstr "  That won't be a problem. Cleaning is our strong suit.\""

#. Occurrence 1DOT5_4:3788:1852: scene=1DOT5_4
#: 1DOT5_4:3788
msgctxt "text_id=1852 | speaker=unknown"
msgid "　青子ではなく、おもに連れの草十郎がであるが。"
msgstr "  It wasn't \"their\" strong suit, as much as it was Soujyuro's."

#. Occurrence 1DOT5_4:3828:1853: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0013; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3828
msgctxt "text_id=1853 | speaker=yuika"
msgid "「……。では青子さんは<竈|かまど>の方で、<聖餅|せいへい>の作り置きを。"
msgstr "\"...Then Aoko, you will be at the stove preparing the communion wafers."

#. Occurrence 1DOT5_4:3835:1854: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0014_0; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3835
msgctxt "text_id=1854 | speaker=yuika"
msgid "　静希さんは外に。"
msgstr "  Mr. Sizuki, you will be outside."

#. Occurrence 1DOT5_4:3847:1855: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0014_1; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3847
msgctxt "text_id=1855 | speaker=yuika"
msgid "私どもでは手の届かない箇所の清掃をお願いします」"
msgstr "I will need your help cleaning the areas I can't reach.\""

#. Occurrence 1DOT5_4:3859:1856: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0038; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:3859
msgctxt "text_id=1856 | speaker=aoko"
msgid "「ちょっと待って。台所に<律架|りつか>のヤツ、いないでしょうね？　こんな所であんなのに会うなんてゴメンだから」"
msgstr "\"One question. Ritsuka isn't in the kitchen, is she? You can't make me go in there if she is.\""

#. Occurrence 1DOT5_4:3872:1857: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0015; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3872
msgctxt "text_id=1857 | speaker=yuika"
msgid "「律架は留守です。ですので、どうぞ気兼ねなく」"
msgstr "\"Don't worry―Ritsuka is not here right now. There's no need to hold back on her account.\""

#. Occurrence 1DOT5_4:3898:1858: scene=1DOT5_4
#: 1DOT5_4:3898
msgctxt "text_id=1858 | speaker=unknown"
msgid "　はいはい、と手を振って、青子は礼拝堂奥のドアに向かっていった。"
msgstr "  With a dismissive wave, Aoko headed toward the door in the back of the worship hall."

#. Occurrence 1DOT5_4:3903:1859: scene=1DOT5_4
#: 1DOT5_4:3903
msgctxt "text_id=1859 | speaker=unknown"
msgid "　公言通り、この教会には慣れきっているようだ。"
msgstr "  As she had indicated, she was quite accustomed to this church."

#. Occurrence 1DOT5_4:3942:1860: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0016; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3942
msgctxt "text_id=1860 | speaker=yuika"
msgid "「静希さんはこちらに。"
msgstr "\"This way please, Mr. Sizuki."

#. Occurrence 1DOT5_4:3948:1861: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0017; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:3948
msgctxt "text_id=1861 | speaker=yuika"
msgid "　まずは物置から、清掃道具を運んでいただきます」"
msgstr "  We will start with the storeroom. I'd like to ask you to carry the cleaning supplies.\""

#. Occurrence 1DOT5_4:4006:1862: scene=1DOT5_4
#: 1DOT5_4:4006
msgctxt "text_id=1862 | speaker=unknown"
msgid "　草十郎に託された仕事は、これといって特殊な技術を必要としない、いたって普通の窓拭きだった。"
msgstr "  The work entrusted to Soujyuro did not require any particular skill. It was window cleaning at its most standard."

#. Occurrence 1DOT5_4:4027:1863: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0020; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:4027
msgctxt "text_id=1863 | speaker=soujuurou"
msgid "「窓を全部拭けばいいんですね？」"
msgstr "\"Should I clean all of the windows?\""

#. Occurrence 1DOT5_4:4033:1864: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0018; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:4033
msgctxt "text_id=1864 | speaker=yuika"
msgid "「水拭きとから拭き、その後にコートスプレーもお願いします。ハシゴの高さは足りますか？」"
msgstr "\"Yes. Start with a wet rag, then wipe with a dry rag, then use the cleaning spray. Is the ladder tall enough?\""

#. Occurrence 1DOT5_4:4039:1865: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0021; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:4039
msgctxt "text_id=1865 | speaker=soujuurou"
msgid "「あれ。ちょっと足りないっぽいですね」"
msgstr "\"Oh. It looks like it might be a little short.\""

#. Occurrence 1DOT5_4:4045:1866: speaker=yuika; speaker_ja=唯架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B20_1DOT5_4_0019; voice_prefix=B20; voice_category=10; scene=1DOT5_4
#: 1DOT5_4:4045
msgctxt "text_id=1866 | speaker=yuika"
msgid "「では届く範囲で結構ですので、よろしくお願いします」"
msgstr "\"Then just clean what you can reach. Thank you very much.\""

#. Occurrence 1DOT5_4:4092:1867: scene=1DOT5_4
#: 1DOT5_4:4092
msgctxt "text_id=1867 | speaker=unknown"
msgid "　そんな簡潔なやりとりをして、シスターは教会に戻ってしまった。"
msgstr "  After the brief exchange, the sister returned to the church."

#. Occurrence 1DOT5_4:4097:1868: scene=1DOT5_4
#: 1DOT5_4:4097
msgctxt "text_id=1868 | speaker=unknown"
msgid "　よほど草十郎を信頼しているのか、もともとドライな性格なのか。"
msgstr "  Soujyuro began to wonder if it was out of distrust in him that she was being so curt."

#. Occurrence 1DOT5_4:4102:1869: scene=1DOT5_4
#: 1DOT5_4:4102
msgctxt "text_id=1869 | speaker=unknown"
msgid "　初対面で判断がつく筈もなし、そもそも草十郎にそんな詮索ができる筈もなし。"
msgstr "  He understood that it was too soon to glean an answer from their first meeting, but then again such answers always eluded Soujyuro."

#. Occurrence 1DOT5_4:4113:1870: scene=1DOT5_4
#: 1DOT5_4:4113
msgctxt "text_id=1870 | speaker=unknown"
msgid "　ぽつんと独り放置されても腐ることなく、草十郎は窓拭きを開始した。"
msgstr "  Left alone but no less encouraged, Soujyuro began cleaning the windows."

#. Occurrence 1DOT5_4:4162:1871: scene=1DOT5_4
#: 1DOT5_4:4162
msgctxt "text_id=1871 | speaker=unknown"
msgid "　今日も天候は思わしくない。"
msgstr "  The day's weather was a disappointment once again."

#. Occurrence 1DOT5_4:4167:1872: scene=1DOT5_4
#: 1DOT5_4:4167
msgctxt "text_id=1872 | speaker=unknown"
msgid "　雨が降る程ではないが太陽も見えないハンパな天気だ。"
msgstr "  It had not gone so far as to rain, but was too overcast to enjoy the sun."

#. Occurrence 1DOT5_4:4172:1873: scene=1DOT5_4
#: 1DOT5_4:4172
msgctxt "text_id=1873 | speaker=unknown"
msgid "　高いハシゴに腰をかけて、高さにして五メートル近い窓をのどかに掃除する。"
msgstr "  He leaned against the tall ladder and, beginning with a window about five yards from the ground, quietly cleaned."

#. Occurrence 1DOT5_4:4177:1874: scene=1DOT5_4
#: 1DOT5_4:4177
msgctxt "text_id=1874 | speaker=unknown"
msgid "　草十郎は肉体労働が苦にならない人柄なので、これで空が真っ青であったら、それだけで素晴らしい休日になったかもしれない。"
msgstr "  Soujyuro was never the kind of person to mind physical labor. In fact, if there had been a blue sky, this might have been a perfect day off to him."

#. Occurrence 1DOT5_4:4212:1875: scene=1DOT5_4
#: 1DOT5_4:4212
msgctxt "text_id=1875 | speaker=unknown"
msgid "　三枚目、四枚目、と仕上げていくうちに気が<緩|ゆる>み、口笛など吹きつつ窓を拭く。"
msgstr "  By the time he finished his third or fourth window, he felt very relaxed and began to whistle."

#. Occurrence 1DOT5_4:4217:1876: scene=1DOT5_4
#: 1DOT5_4:4217
msgctxt "text_id=1876 | speaker=unknown"
msgid "　五メートル近い高さは怖くはあるが、同時に絶景でもあった。"
msgstr "  Though 15 feet was an intimidating height, it provided a wonderful view at the same time."

#. Occurrence 1DOT5_4:4222:1877: scene=1DOT5_4
#: 1DOT5_4:4222
msgctxt "text_id=1877 | speaker=unknown"
msgid "　ふと町の方に目を向ければ、引っ越してきてからずっと気になっていた、緑の丘が見てとれる。"
msgstr "  Turning toward the town gave Soujyuro a clear view of the tree-topped hill that had previously caught his eye."

#. Occurrence 1DOT5_4:4252:1878: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0022; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:4252
msgctxt "text_id=1878 | speaker=soujuurou"
msgid "「やっぱり、林の中に家があるような……」"
msgstr "\"So there really is a house in the woods.\""

#. Occurrence 1DOT5_4:4258:1879: scene=1DOT5_4
#: 1DOT5_4:4258
msgctxt "text_id=1879 | speaker=unknown"
msgid "　三咲町のはずれにある丘と森。"
msgstr "  The hill and the woods just outside of town."

#. Occurrence 1DOT5_4:4263:1880: scene=1DOT5_4
#: 1DOT5_4:4263
msgctxt "text_id=1880 | speaker=unknown"
msgid "　眠らない町を見下ろす森は、ここから見ると異国の城塞のようだ。"
msgstr "  From here, the forest overlooking the sleepless city looked like a foreign castle."

#. Occurrence 1DOT5_4:4285:1881: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0000; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4285
msgctxt "text_id=1881 | speaker=ritsuka"
msgid "「あれ？　なになに、ドロボウさんー？」"
msgstr "\"Well, well. Do we have a burglar?\""

#. Occurrence 1DOT5_4:4291:1882: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0023; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:4291
msgctxt "text_id=1882 | speaker=soujuurou"
msgid "「？」"
msgstr "\"...?\""

#. Occurrence 1DOT5_4:4324:1883: scene=1DOT5_4
#: 1DOT5_4:4324
msgctxt "text_id=1883 | speaker=unknown"
msgid "　―――と。"
msgstr "  Just then..."

#. Occurrence 1DOT5_4:4329:1884: scene=1DOT5_4
#: 1DOT5_4:4329
msgctxt "text_id=1884 | speaker=unknown"
msgid "　物思いにふけりながらもセッセと腕を動かしていた草十郎の眼下で、トコトコと人の気配。"
msgstr "  Lost in his thoughts while wiping windows, Soujyuro was pulled out of his trance by someone pacing below him."

#. Occurrence 1DOT5_4:4334:1885: scene=1DOT5_4
#: 1DOT5_4:4334
msgctxt "text_id=1885 | speaker=unknown"
msgid "　視線を下げると、そこには一見して人の良さそうな、それでいてだらしなさそうな、女性の姿があった。"
msgstr "  He looked down and saw a girl, her unkempt clothes otherwise contrasting with her kind visage. "

#. Occurrence 1DOT5_4:4366:1886: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0001; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4366
msgctxt "text_id=1886 | speaker=ritsuka"
msgid "「ん、でもちょっと怪盗には似合わないのんびり屋さん風味。どっちかって言うと、あれかしら。暖炉から現れては微妙に要らないオモチャを押しつける<聖者|セイント>、みたいな。"
msgstr "\"Hmm. But you look a little too loosey-goosey to be a thief. Wait, I know. Maybe you're the type that jumps out of people's fireplaces and gives them toys they don't need, like that one saint."

#. Occurrence 1DOT5_4:4377:1887: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0002; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4377
msgctxt "text_id=1887 | speaker=ritsuka"
msgid "　うわあ……わたし、あのヒゲ苦手なのよねぇ……だってどう見ても不法侵入者じゃない、あの人？」"
msgstr "  Oh, but I just can't stand his beard. You know all that guy is doing is breaking and entering, right?\""

#. Occurrence 1DOT5_4:4414:1888: scene=1DOT5_4
#: 1DOT5_4:4414
msgctxt "text_id=1888 | speaker=unknown"
msgid "　年齢は二十代後半、だろうか。"
msgstr "  She looked to be in her late twenties."

#. Occurrence 1DOT5_4:4419:1889: scene=1DOT5_4
#: 1DOT5_4:4419
msgctxt "text_id=1889 | speaker=unknown"
msgid "　この寒さで上着を羽織っておらず、バッグらしきものも持っていない。草十郎はまだ知りえないコトだが、大人の女性とバッグはワンセットの存在である。"
msgstr "  Despite the cold, she was not wearing a coat. She had no purse either, which was rather strange as a woman and her purse were never far apart. Not that Soujyuro knew this truth quite yet."

#. Occurrence 1DOT5_4:4424:1890: scene=1DOT5_4
#: 1DOT5_4:4424
msgctxt "text_id=1890 | speaker=unknown"
msgid "　そのあたりを無視しているあたり、この女性の自由奔放さが<窺|うかが>える。"
msgstr "  Based on the fact that none of this seemed to apply to her, one could have easily surmised that she was herself a little \"loosey-goosey.\""

#. Occurrence 1DOT5_4:4430:1891: scene=1DOT5_4
#: 1DOT5_4:4430
msgctxt "text_id=1891 | speaker=unknown"
msgid "抜けている、とも言う。"
msgstr " A few cards short of a full deck, one might also say."

#. Occurrence 1DOT5_4:4471:1892: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0003; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4471
msgctxt "text_id=1892 | speaker=ritsuka"
msgid "「あ。わたし、ピーンと来たわ。"
msgstr "\"Oh, I got it!"

#. Occurrence 1DOT5_4:4477:1893: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0004; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4477
msgctxt "text_id=1893 | speaker=ritsuka"
msgid "　キミ、ミサ高のバイトの子？　偉いわ、今時の高校生は業者さん顔負けなのね！」"
msgstr "  Are you that part-timer from Misaki High? Wow, high schoolers these days really are something. You put the pros to shame!\""

#. Occurrence 1DOT5_4:4483:1894: scene=1DOT5_4
#: 1DOT5_4:4483
msgctxt "text_id=1894 | speaker=unknown"
msgid "　ハシゴの頂点に座った草十郎を見上げて、女性は感動しきっている。"
msgstr "  The girl looked up in admiration to Soujyuro, as he stood atop his ladder."

#. Occurrence 1DOT5_4:4509:1895: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0005; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4509
msgctxt "text_id=1895 | speaker=ritsuka"
msgid "「よーし、わたしも手伝っちゃおうかな！"
msgstr "\"Cool, let me help!"

#. Occurrence 1DOT5_4:4515:1896: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0006; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4515
msgctxt "text_id=1896 | speaker=ritsuka"
msgid "　ハシゴはまだある？　他の<雑巾|ぞうきん>は？　あ、どうせだからホースで水をかけるのはどうかしら！　こうバアーっと、けるひゃー！とか叫びながら！　バチあたりだけど、それなら少しぐらいは楽しくなりそうじゃない？」"
msgstr "  Is there another ladder? And rags? Ah, since we're doing this anyway, why don't we just use the hose? You know, spray water all over the place, yelling and having a good time. We might get in trouble, but a little fun never hurt anybody, right?\""

#. Occurrence 1DOT5_4:4549:1897: scene=1DOT5_4
#: 1DOT5_4:4549
msgctxt "text_id=1897 | speaker=unknown"
msgid "　心底から楽しそうに女性は笑った。"
msgstr "  The girl let out a hearty laugh."

#. Occurrence 1DOT5_4:4554:1898: scene=1DOT5_4
#: 1DOT5_4:4554
msgctxt "text_id=1898 | speaker=unknown"
msgid "　光がこぼれそうな、自立して走りまわるサボテンみたいな笑顔だった。"
msgstr "  Her smile glowed like a cactus that had sprouted legs and begun to run about."

#. Occurrence 1DOT5_4:4560:1899: scene=1DOT5_4
#: 1DOT5_4:4560
msgctxt "text_id=1899 | speaker=unknown"
msgid "はた迷惑という意味だった。"
msgstr "...Inasmuch as a running cactus could only cause trouble."

#. Occurrence 1DOT5_4:4567:1900: scene=1DOT5_4
#: 1DOT5_4:4567
msgctxt "text_id=1900 | speaker=unknown"
msgid "　そんな草十郎の連想通り、女性は草十郎の返事を待たず、まあまあ、と窓拭きに参加した。"
msgstr "  As Soujyuro anticipated, the girl began to clean without waiting for his approval."

#. Occurrence 1DOT5_4:4632:1901: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0007; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4632
msgctxt "text_id=1901 | speaker=ritsuka"
msgid "「いえ、教会の前を通ったら、人影っぽいのが窓にへばりついてるのが見えちゃったの。昼間っから泥棒とか豪快だなあって、ちょっと興味ひかれちゃって。"
msgstr "\"So I was walking by the church, and I saw a figure stuck to the window. 'A daylight burglary seems pretty bold,' I thought, but my curiosity got the best of me."

#. Occurrence 1DOT5_4:4638:1902: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0008; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4638
msgctxt "text_id=1902 | speaker=ritsuka"
msgid "　そしたら可愛い子が真面目に労働してたワケ。窓拭きの達人みたいに、ビっと格好よく。そんなの見せられたら手伝いたくなるのが人情じゃない？」"
msgstr "  Imagine my surprise when I saw such a cute boy working as diligently as a window wiping expert. You can't blame a girl for wanting to help out after seeing that, can you?\""

#. Occurrence 1DOT5_4:4658:1903: scene=1DOT5_4
#: 1DOT5_4:4658
msgctxt "text_id=1903 | speaker=unknown"
msgid "　草十郎のひとつ隣の窓を拭きながら、女性は陽気に話しかけてくる。"
msgstr "  Wiping the window next to Soujyuro, the girl continued to chatter cheerfully."

#. Occurrence 1DOT5_4:4663:1904: scene=1DOT5_4
#: 1DOT5_4:4663
msgctxt "text_id=1904 | speaker=unknown"
msgid "　そんな、考えようによっては怪しいコトこの上ない女性にうんうんと真面目に同意する草十郎。"
msgstr "  Although this was all kinds of suspicious, Soujyuro politely followed her lead, nodding and agreeing as she spoke."

#. Occurrence 1DOT5_4:4668:1905: scene=1DOT5_4
#: 1DOT5_4:4668
msgctxt "text_id=1905 | speaker=unknown"
msgid "　なんというか、彼の本能が理解したのだ。"
msgstr "  Perhaps it was an instinctive camaraderie."

#. Occurrence 1DOT5_4:4673:1906: scene=1DOT5_4
#: 1DOT5_4:4673
msgctxt "text_id=1906 | speaker=unknown"
msgid "　この女性は自分と同じように、いつもこういう地味な作業を押しつけられる同士なのだと―――！"
msgstr "  He sensed this girl was just like him, always getting the short end of the stick when it came to menial work."

#. Occurrence 1DOT5_4:4720:1907: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0024; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:4720
msgctxt "text_id=1907 | speaker=soujuurou"
msgid "「貴方は教会の人なんですか？」"
msgstr "\"So are you from the church?\""

#. Occurrence 1DOT5_4:4752:1908: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0009; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4752
msgctxt "text_id=1908 | speaker=ritsuka"
msgid "「わたし？　いえ、ただの通りすがりよ。"
msgstr "\"Me? No, I was just passing by."

#. Occurrence 1DOT5_4:4763:1909: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0010; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4763
msgctxt "text_id=1909 | speaker=ritsuka"
msgid "　それより貴方ってのは他人行儀ねぇ。キミとは商店街で何度も会ってるのに」"
msgstr "  More importantly, why are you acting like we've never met before? Don't you remember all those times we met in the shopping mall?\""

#. Occurrence 1DOT5_4:4769:1910: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0025; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:4769
msgctxt "text_id=1910 | speaker=soujuurou"
msgid "「いや、会ってませんよ？」"
msgstr "\"No... When did that happen?\""

#. Occurrence 1DOT5_4:4819:1911: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0011_0; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4819
msgctxt "text_id=1911 | speaker=ritsuka"
msgid "「会ってますー。キミ、<魚達|うおたつ>さんでバイトしてる子でしょう？　今週だけでも何度か行ってるもん、わたし。"
msgstr "\"All the time, silly! You work at that restaurant, Uotatsu, right? I was there several times just this week!"

#. Occurrence 1DOT5_4:4831:1912: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0011_1; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4831
msgctxt "text_id=1912 | speaker=ritsuka"
msgid "　わたしは―――ええっと、そうね、"
msgstr "  I'm... um... Oh, right."

#. Occurrence 1DOT5_4:4843:1913: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0011_2; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4843
msgctxt "text_id=1913 | speaker=ritsuka"
msgid "<花澤|はなざわ>って言うんだけど、キミの名前は？」"
msgstr "I'm Hanazawa. What's your name?\""

#. Occurrence 1DOT5_4:4863:1914: scene=1DOT5_4
#: 1DOT5_4:4863
msgctxt "text_id=1914 | speaker=unknown"
msgid "　台詞の途中、ちらりと眼下の花壇を見ながら、きさくに笑いかける花澤さん。"
msgstr "  Hanazawa took a quick glance at the flower bed below in the middle of her introduction, then gave him a friendly laugh."

#. Occurrence 1DOT5_4:4868:1915: scene=1DOT5_4
#: 1DOT5_4:4868
msgctxt "text_id=1915 | speaker=unknown"
msgid "　草十郎はいつも通り、自信なげに自己紹介を済ませた。"
msgstr "  Soujyuro's self-introduction, however, was his usual brand of awkward."

#. Occurrence 1DOT5_4:4915:1916: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0012; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4915
msgctxt "text_id=1916 | speaker=ritsuka"
msgid "「草十郎さん……うん、いい名前ね、古風な感じで。"
msgstr "\"Soujyuro, huh? ...Your name's cute, in an old-fashioned kind of way."

#. Occurrence 1DOT5_4:4921:1917: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0013; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:4921
msgctxt "text_id=1917 | speaker=ritsuka"
msgid "　名前に数字が入ってると、なんか日本人って感じがしない？　ここの神父さんとかシスターの名前、知ってる？　エイリとかユイカとか、なんか外国風なんだけど」"
msgstr "  The 'jyu' in your name means 'ten,' right? Names with numbers in them are so Japanese, don't you think? ...Do you know the priest and sisters here? Eiri and Yuika... Their names sound so foreign.\""

#. Occurrence 1DOT5_4:4953:1918: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0026; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:4953
msgctxt "text_id=1918 | speaker=soujuurou"
msgid "「エイリさんはともかく、唯架さんは綺麗な黒髪の女の人でしたよ？」"
msgstr "\"I don't know Eiri, but Yuika was the woman with the pretty dark hair, right?\""

#. Occurrence 1DOT5_4:5002:1919: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0014; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5002
msgctxt "text_id=1919 | speaker=ritsuka"
msgid "「あら、神父さんにはまだ会っていないのね。"
msgstr "\"Oh, so you haven't met the priest yet."

#. Occurrence 1DOT5_4:5008:1920: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0015; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5008
msgctxt "text_id=1920 | speaker=ritsuka"
msgid "　合田教会の美形神父と美人姉妹って言ったら有名なんだけど……あ、そうか！　さてはキミ、最近引っ越してきたんでしょう！　しかもひとり暮らしと見たわ！」"
msgstr "  Aida Church is famous for its handsome priest and beautiful sisters, you know. ...Oh, that's right! You just moved here! You're living on your own, right?\""

#. Occurrence 1DOT5_4:5043:1921: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0027_0; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5043
msgctxt "text_id=1921 | speaker=soujuurou"
msgid "「そうですけど……"
msgstr "\"Yes..."

#. Occurrence 1DOT5_4:5056:1922: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0027_1; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5056
msgctxt "text_id=1922 | speaker=soujuurou"
msgid "花澤さん、すごいですね？　さっきからあまりにも的確なあてずっぽうです」"
msgstr "You're really sharp, Ms. Hanazawa. You seem to be pretty good at guessing things about me.\""

#. Occurrence 1DOT5_4:5092:1923: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0016; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5092
msgctxt "text_id=1923 | speaker=ritsuka"
msgid "「いえいえ、推理と言ってくれたまえ。"
msgstr "\"It's called deductive reasoning, silly."

#. Occurrence 1DOT5_4:5098:1924: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0017; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5098
msgctxt "text_id=1924 | speaker=ritsuka"
msgid "　キミぐらいの子がアルバイトに精を出すほど、この町の娯楽は魅力的じゃないもの。遊ぶお金ならバイト一件で<賄|まかな>えちゃうわ。キミは物欲のあるタイプじゃなさそうだし。"
msgstr "  This town doesn't have much to do for fun, certainly not enough that a kid like you would need to work this much. Normally, you'd just need one job to cover spending money. You don't seem like the materialistic type, either."

#. Occurrence 1DOT5_4:5104:1925: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0018; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5104
msgctxt "text_id=1925 | speaker=ritsuka"
msgid "　となると、これはもう生活費のためと考えるのが健全でしょう？"
msgstr "  Which leaves living expenses as the only wholesome reason for working this hard, right?"

#. Occurrence 1DOT5_4:5111:1926: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0019; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5111
msgctxt "text_id=1926 | speaker=ritsuka"
msgid "　……んー、まあ、学生さんが生活費も学費も自分だけで賄う、なんてのは健全じゃないんだけど」"
msgstr "Hmm. Then again, it isn't very 'wholesome' for a student to be paying for his own room, board, and tuition.\""

#. Occurrence 1DOT5_4:5166:1927: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0028; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5166
msgctxt "text_id=1927 | speaker=soujuurou"
msgid "「いや、そうでもないですよ？"
msgstr "\"Not necessarily."

#. Occurrence 1DOT5_4:5166:1928: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0028; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5166
msgctxt "text_id=1928 | speaker=soujuurou"
msgid "　働かざるもの食うべからずです」"
msgstr "  Don't they say he who does not work, doesn't eat?\""

#. Occurrence 1DOT5_4:5180:1929: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0020; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5180
msgctxt "text_id=1929 | speaker=ritsuka"
msgid "「そっかぁ。草十郎さんは若いのに立派ねー。"
msgstr "\"Wow, Soujyuro. You're pretty mature for your age."

#. Occurrence 1DOT5_4:5180:1930: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0020; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5180
msgctxt "text_id=1930 | speaker=ritsuka"
msgid "　わたしも学生の頃はバイト三昧だったから、少しはキミのたいへんさも分かるわよー」"
msgstr "  When I was a student, I was completely absorbed in work, too, so I understand how difficult things must be for you.\""

#. Occurrence 1DOT5_4:5191:1931: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0029; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5191
msgctxt "text_id=1931 | speaker=soujuurou"
msgid "「なんと。花澤さんもひとり暮らしだったんですか？」"
msgstr "\"Oh. You lived by yourself as well, Ms. Hanazawa?\""

#. Occurrence 1DOT5_4:5217:1932: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0021; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5217
msgctxt "text_id=1932 | speaker=ritsuka"
msgid "「ええ。親の反対をおしきって、よその国に留学しちゃったの。<留学先|あっち>にはトモダチもいたから下宿先には困らなかったけど、さすがに食費ぐらいは稼がないとねー。"
msgstr "\"Yeah. I studied abroad over my parents' objections. I went to the same school as a friend, and we roomed together to save money. But food wasn't free, as you know."

#. Occurrence 1DOT5_4:5223:1933: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0022; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5223
msgctxt "text_id=1933 | speaker=ritsuka"
msgid "　けどまあ、こう見えて肉体労働は苦にならないタイプだし。学院もバイトも楽しい思い出になってるわ」"
msgstr "  That said, I'm the kind of person who doesn't mind a bit of elbow grease. Looking back on it now, my time at school and work was a great memory.\""

#. Occurrence 1DOT5_4:5280:1934: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0030; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5280
msgctxt "text_id=1934 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 1DOT5_4:5286:1935: scene=1DOT5_4
#: 1DOT5_4:5286
msgctxt "text_id=1935 | speaker=unknown"
msgid "　おお、とまたもコクコク頷く草十郎。"
msgstr "  Soujyuro nodded agreeably."

#. Occurrence 1DOT5_4:5291:1936: scene=1DOT5_4
#: 1DOT5_4:5291
msgctxt "text_id=1936 | speaker=unknown"
msgid "　<節操|せっそう>なく湧きたつ親近感を<抑|おさ>えられない。"
msgstr "  Dignified or not, he could barely hold back the sense of solidarity that was welling up within him."

#. Occurrence 1DOT5_4:5340:1937: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0023; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5340
msgctxt "text_id=1937 | speaker=ritsuka"
msgid "「ふふふ。これも何かの縁だし、魚達さんではこれからお世話になりそうだし。頼りないだろうけど、相談事があったらぜひ言ってね。精神面で力になるわ」"
msgstr "\"Hehehe. Well, since this might be fate, and I'll probably be seeing more of you at Uotatsu from here on out, come see me if you need someone to talk to. I can't promise that I'll be much help, but I'll do my best impression of a sounding board.\""

#. Occurrence 1DOT5_4:5389:1938: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0031; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5389
msgctxt "text_id=1938 | speaker=soujuurou"
msgid "「ありがとうございます。"
msgstr "\"Thank you, I appreciate it."

#. Occurrence 1DOT5_4:5396:1939: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0032_0; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5396
msgctxt "text_id=1939 | speaker=soujuurou"
msgid "　じゃあ早速ですけど、"
msgstr "  Maybe you can help me out right now."

#. Occurrence 1DOT5_4:5408:1940: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0032_1; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5408
msgctxt "text_id=1940 | speaker=soujuurou"
msgid "ここは何をするところなんでしょう？"
msgstr "What do they actually do here?"

#. Occurrence 1DOT5_4:5408:1941: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0032_1; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5408
msgctxt "text_id=1941 | speaker=soujuurou"
msgid "」"
msgstr "\""

#. Occurrence 1DOT5_4:5415:1942: scene=1DOT5_4
#: 1DOT5_4:5415
msgctxt "text_id=1942 | speaker=unknown"
msgid "　ここ、と教会を指さす草十郎。"
msgstr "  As Soujyuro said \"here,\" he pointed at the church."

#. Occurrence 1DOT5_4:5464:1943: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0024; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5464
msgctxt "text_id=1943 | speaker=ritsuka"
msgid "「え、えっと？」"
msgstr "\"Uhh...what do you mean?\""

#. Occurrence 1DOT5_4:5470:1944: scene=1DOT5_4
#: 1DOT5_4:5470
msgctxt "text_id=1944 | speaker=unknown"
msgid "　さすがの花澤さんも面食らっている。"
msgstr "  Even Hanazawa was taken aback by his question."

#. Occurrence 1DOT5_4:5475:1945: scene=1DOT5_4
#: 1DOT5_4:5475
msgctxt "text_id=1945 | speaker=unknown"
msgid "　草十郎がビンテージものの田舎者である事なんぞ知らない花澤さんであるが、持ち前の機転の良さで、これは高度な皮肉なのだと勘違いしてしまったようだ。"
msgstr "  Unaware of Soujyuro's provincial background―combined with her quick-witted nature―Hanazawa seemingly mistook his question for some kind of sophisticated wit."

#. Occurrence 1DOT5_4:5513:1946: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0025; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5513
msgctxt "text_id=1946 | speaker=ritsuka"
msgid "「うーん、そうねー。"
msgstr "\"Hmm. Good question."

#. Occurrence 1DOT5_4:5519:1947: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0026; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5519
msgctxt "text_id=1947 | speaker=ritsuka"
msgid "　心の安全を扱っている、というのはどうかしら。いえ、安全というよりは鎧？　ツギハギのバリケード？　とにかく本人はちっとも鍛えられないってコトは同じよね。"
msgstr "  I guess people treat it as a spiritual sanctuary... Is that the right word for it? No, maybe not sanctuary, more like a shield, or... a place that plugs leaks in your mind? It's basically a way for people to avoid getting better."

#. Occurrence 1DOT5_4:5525:1948: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0027; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5525
msgctxt "text_id=1948 | speaker=ritsuka"
msgid "　ああ、あとはパンとワインも分けてくれるわね」"
msgstr "  Oh, and they give out free bread and wine.\""

#. Occurrence 1DOT5_4:5531:1949: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0033; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5531
msgctxt "text_id=1949 | speaker=soujuurou"
msgid "「無料でですか？」"
msgstr "\"For free?\""

#. Occurrence 1DOT5_4:5552:1950: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0028; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5552
msgctxt "text_id=1950 | speaker=ritsuka"
msgid "「もちろん。富める者は勝手に置いていくって話。"
msgstr "\"Sure! I mean, I've heard rich people just donate a bunch of money anyway."

#. Occurrence 1DOT5_4:5558:1951: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0029; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5558
msgctxt "text_id=1951 | speaker=ritsuka"
msgid "　あとは―――そっか。これが一番大きいんだけど、収入に税金がかからない。心の安全は扱いが難しいけど、きちんと売り物にできればノーリスクハイリターンよ」"
msgstr "  Oh yeah, one more thing, and this is the most important wrinkle--their income isn't taxed. Saving souls is tough work, but it's zero-risk high-reward if you've got a solid business plan.\""

#. Occurrence 1DOT5_4:5616:1952: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0034; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5616
msgctxt "text_id=1952 | speaker=soujuurou"
msgid "「……はあ。よく分からないですけど、ピンチの時はここに転がりこめばいいんですね？」"
msgstr "\"Is that so... I don't really follow, but are you saying that that it's a good place to come when you're in trouble?\""

#. Occurrence 1DOT5_4:5622:1953: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0030; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5622
msgctxt "text_id=1953 | speaker=ritsuka"
msgid "「んー、それはおすすめしないなあ。"
msgstr "\"Umm... I wouldn't recommend that."

#. Occurrence 1DOT5_4:5628:1954: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0031; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5628
msgctxt "text_id=1954 | speaker=ritsuka"
msgid "　ご利用は月に一回、気休め程度にした方がいいと思う」"
msgstr "  I think it would be better to visit once a month or so, just for a little peace of mind.\""

#. Occurrence 1DOT5_4:5671:1955: scene=1DOT5_4
#: 1DOT5_4:5671
msgctxt "text_id=1955 | speaker=unknown"
msgid "　きゅっきゅっ、と窓を<拭|ふ>く音が響く。"
msgstr "  The rags squeaked as the two carefree souls continued to wipe down the windows."

#. Occurrence 1DOT5_4:5676:1956: scene=1DOT5_4
#: 1DOT5_4:5676
msgctxt "text_id=1956 | speaker=unknown"
msgid "　趣味を同じくするふたりは<暢気|のんき>に口笛を吹きながら一枚、また一枚、と教会の窓を磨き上げていく。"
msgstr "  Whistling as they went, they shined up one window. Then another. Then another."

#. Occurrence 1DOT5_4:5719:1957: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0035; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5719
msgctxt "text_id=1957 | speaker=soujuurou"
msgid "「そうだ、もうひとつあります。"
msgstr "\"Oh yeah, one more question."

#. Occurrence 1DOT5_4:5725:1958: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0036; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5725
msgctxt "text_id=1958 | speaker=soujuurou"
msgid "　ここから見えるあの森、なんですか？」"
msgstr "  What are those woods way over there?\""

#. Occurrence 1DOT5_4:5737:1959: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0032; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5737
msgctxt "text_id=1959 | speaker=ritsuka"
msgid "「森？　あの山の上にある森のコト？」"
msgstr "\"Woods? On the mountain, you mean?\""

#. Occurrence 1DOT5_4:5773:1960: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0037; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5773
msgctxt "text_id=1960 | speaker=soujuurou"
msgid "「ですけど、アレは山じゃなくて丘と言うべきです」"
msgstr "\"Well, yeah, but that's really more of a hill than a mountain.\""

#. Occurrence 1DOT5_4:5779:1961: scene=1DOT5_4
#: 1DOT5_4:5779
msgctxt "text_id=1961 | speaker=unknown"
msgid "　田舎育ちの人間として、あの程度の高台を山というのはプライドが許さないらしい。"
msgstr "  As someone raised in the countryside, Soujyuro's pride would not allow for a mound of dirt to be called a mountain."

#. Occurrence 1DOT5_4:5828:1962: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0033; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5828
msgctxt "text_id=1962 | speaker=ritsuka"
msgid "「そう？　あれはあれで、けっこう登るのに体力使うんだけど……まあ、<丘|そっち>の方がより<ら|・><し|・><い|・>わねぇ」"
msgstr "\"You think so? Any incline that takes energy to climb is a mountain in my book. But if you say so...\""

#. Occurrence 1DOT5_4:5834:1963: scene=1DOT5_4
#: 1DOT5_4:5834
msgctxt "text_id=1963 | speaker=unknown"
msgid "　女性の気さくな笑顔に自虐的な影がさす。"
msgstr "  It was as if a shadow fell over her till-now sunny disposition."

#. Occurrence 1DOT5_4:5839:1964: scene=1DOT5_4
#: 1DOT5_4:5839
msgctxt "text_id=1964 | speaker=unknown"
msgid "　もともと端整な顔つきをした美人だ。"
msgstr "  She was undoubtedly a beautiful woman with very lovely features."

#. Occurrence 1DOT5_4:5844:1965: scene=1DOT5_4
#: 1DOT5_4:5844
msgctxt "text_id=1965 | speaker=unknown"
msgid "　笑顔を崩すと一転して酷薄な、見るものを威圧する表情になる事に、今さらながら草十郎は気が付いた。"
msgstr "  But as Soujyuro looked at her in that moment, her smile melted away, and he saw how disturbed she was at his comment."

#. Occurrence 1DOT5_4:5849:1966: scene=1DOT5_4
#: 1DOT5_4:5849
msgctxt "text_id=1966 | speaker=unknown"
msgid "　もちろん、"
msgstr "  And when it comes down to it..."

#. Occurrence 1DOT5_4:5887:1967: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0038; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5887
msgctxt "text_id=1967 | speaker=soujuurou"
msgid "「あれは丘です。それとほら、ここから<煙突|えんとつ>みたいなの見えますけど、アレはなんですか？」"
msgstr "\"It's definitely a hill. Oh, and what about that thing that looks like a chimney?\""

#. Occurrence 1DOT5_4:5893:1968: scene=1DOT5_4
#: 1DOT5_4:5893
msgctxt "text_id=1968 | speaker=unknown"
msgid "　そんな事で草十郎があれこれ遠慮したり、怪しんだりする事はないのだった。"
msgstr "  Soujyuro was not one to closely watch people's reactions and fuss over his speech."

#. Occurrence 1DOT5_4:5914:1969: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0034; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5914
msgctxt "text_id=1969 | speaker=ritsuka"
msgid "「あれは本物の煙突よ。"
msgstr "\"It looks like a chimney because it is a chimney."

#. Occurrence 1DOT5_4:5920:1970: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0035; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5920
msgctxt "text_id=1970 | speaker=ritsuka"
msgid "　あの森は全部私有地なんだけど、その中にでっかい洋館が建っているの。でも私有地だから地元の人間も入ったコトはないんじゃないかしら。"
msgstr "  That forest is all private property, and a huge mansion sits right in the middle of it. None of the locals really know anything about it because they're not allowed in there."

#. Occurrence 1DOT5_4:5962:1971: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0036; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5962
msgctxt "text_id=1971 | speaker=ritsuka"
msgid "　通称、<久遠寺|くおんじ>のお化け屋敷ってね。近所の皆さんは気味悪がってるし、あんまり近寄らない方がいいんじゃない？　あんな小さな森なのに遭難したとか、野犬が出るとか、物騒な話には事欠かないから」"
msgstr "  People call it the Kuonji Haunted Mansion. The locals are all spooked by it, so it's probably best that you keep your distance. For a tiny wooded area, there have been all kinds of freaky stories about the place―weird accidents, wild dog sightings, you name it.\""

#. Occurrence 1DOT5_4:5988:1972: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0039; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:5988
msgctxt "text_id=1972 | speaker=soujuurou"
msgid "「野犬って、都会にも野犬？」"
msgstr "\"Wild dogs? You get wild dogs here in the city, too?\""

#. Occurrence 1DOT5_4:5999:1973: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0037; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:5999
msgctxt "text_id=1973 | speaker=ritsuka"
msgid "「たくさんいるわよー。この教会の裏手の空き地にだっているし。ここの神父さんは物好きだからパンとかあげちゃって、それでワンちゃんの巡回ルートになっちゃってるんでしょうけど」"
msgstr "\"Lots of them! There are even some in the empty lot behind the church. The priest here is a bit eccentric, and one time he gave them some bread, and the pups made the area part of their patrol route.\""

#. Occurrence 1DOT5_4:6005:1974: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0040; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6005
msgctxt "text_id=1974 | speaker=soujuurou"
msgid "「？」"
msgstr "\"...?\""

#. Occurrence 1DOT5_4:6063:1975: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0038; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:6063
msgctxt "text_id=1975 | speaker=ritsuka"
msgid "「とにかく、君子危うきに近寄らず、よ。あの森には入らないのが街のルールなの。"
msgstr "\"Anyway, don't go up there. You know what they say about idiots and high places. It's something of an unspoken rule around here to stay out."

#. Occurrence 1DOT5_4:6069:1976: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0039; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:6069
msgctxt "text_id=1976 | speaker=ritsuka"
msgid "　そもそも私有地だし、入ったらお巡りさんを呼ばれちゃって、そのまま交番でお説教ターイム！　なんて、あんまり楽しくないでしょう？」"
msgstr "  For one thing, it's private property! If you trespass, someone's going to call the cops, and then you're going to spend the rest of the day getting grilled at the station. That doesn't sound like much fun, does it?\""

#. Occurrence 1DOT5_4:6115:1977: scene=1DOT5_4
#: 1DOT5_4:6115
msgctxt "text_id=1977 | speaker=unknown"
msgid "　なるほど、とハシゴの上から遥か彼方の煙突を眺める。"
msgstr "  Soujyuro nodded along to her story as he stared at the far-off chimney from his vantage point on the ladder."

#. Occurrence 1DOT5_4:6120:1978: scene=1DOT5_4
#: 1DOT5_4:6120
msgctxt "text_id=1978 | speaker=unknown"
msgid "　少しだけ、ほんの少しだけ故郷の森を連想させる丘なので気になっていたが、どうやら自分には何の関係もないようだと納得し、草十郎は窓拭きを再開した。"
msgstr "  A teeny tiny part of him was curious about that hill, because it reminded him of the woods where he grew up, but after reminding himself that it was none of his business, he returned to window washing."

#. Occurrence 1DOT5_4:6177:1979: scene=1DOT5_4
#: 1DOT5_4:6177
msgctxt "text_id=1979 | speaker=unknown"
msgid "　花澤さんの協力のおかげで、窓拭きは滞りなく終了した。"
msgstr "  Thanks to Hanazawa lending a hand, they were able to finish the job without a hitch."

#. Occurrence 1DOT5_4:6182:1980: scene=1DOT5_4
#: 1DOT5_4:6182
msgctxt "text_id=1980 | speaker=unknown"
msgid "　ふたりがかりで、地味だが手間のかかる仕事をやり遂げたのだ。"
msgstr "  Between the two of them, they had accomplished a simple but very time-consuming task."

#. Occurrence 1DOT5_4:6221:1981: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0040; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:6221
msgctxt "text_id=1981 | speaker=ritsuka"
msgid "「はい、ごくろうさまでした。"
msgstr "\"Nice work."

#. Occurrence 1DOT5_4:6227:1982: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0041; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:6227
msgctxt "text_id=1982 | speaker=ritsuka"
msgid "　うん、あれだけ砂まみれだった窓が見違えたわね！"
msgstr "  I hardly recognize these windows, considering how filthy they were before!"

#. Occurrence 1DOT5_4:6245:1983: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0042; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:6245
msgctxt "text_id=1983 | speaker=ritsuka"
msgid "　どう、これから適当な<茶店|さてん>でお茶にしない？　草十郎さんの仕事っぷりに敬意を表して、わたしがおご"
msgstr "  Why don't we head to a café somewhere and get something to drink? I'll treat you as a reward for all your"

#. Occurrence 1DOT5_4:6258:1984: scene=1DOT5_4
#: 1DOT5_4:6258
msgctxt "text_id=1984 | speaker=unknown"
msgid "―――」"
msgstr "―\""

#. Occurrence 1DOT5_4:6284:1985: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0041; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6284
msgctxt "text_id=1985 | speaker=soujuurou"
msgid "「はい？　何か言いました、花澤さ―――」"
msgstr "\"Ms. Hanazawa? You were in the middle of saying som―\""

#. Occurrence 1DOT5_4:6296:1986: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0043; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:6296
msgctxt "text_id=1986 | speaker=ritsuka"
msgid "「いえ、ごめんなさい、急用を思い出しちゃった。"
msgstr "\"Oh, sorry, I just remembered some urgent business I need to attend to."

#. Occurrence 1DOT5_4:6307:1987: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_1DOT5_4_0044; voice_prefix=B30; voice_category=9; scene=1DOT5_4
#: 1DOT5_4:6307
msgctxt "text_id=1987 | speaker=ritsuka"
msgid "　花澤さんはここで失礼するのでした。チャオ～」"
msgstr "  Catch you later! Ciao!\""

#. Occurrence 1DOT5_4:6318:1988: scene=1DOT5_4
#: 1DOT5_4:6318
msgctxt "text_id=1988 | speaker=unknown"
msgid "　ハシゴを片づけていた草十郎が振り向くと、女性は<脱兎|だっと>の如く表通りに走り去っていた。"
msgstr "  By the time Soujyuro, who had started putting away the ladder, turned around, he was only able to catch a glimpse of the girl's figure dashing toward the street at lightning speed."

#. Occurrence 1DOT5_4:6352:1989: scene=1DOT5_4
#: 1DOT5_4:6352
msgctxt "text_id=1989 | speaker=unknown"
msgid "　時刻はそろそろ三時。"
msgstr "  It was just before three o'clock."

#. Occurrence 1DOT5_4:6357:1990: scene=1DOT5_4
#: 1DOT5_4:6357
msgctxt "text_id=1990 | speaker=unknown"
msgid "　花澤さんが手伝いを申し出てから三時間以上経過している。"
msgstr "  More than three hours had passed since Hanazawa offered to help."

#. Occurrence 1DOT5_4:6392:1991: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0042; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6392
msgctxt "text_id=1991 | speaker=soujuurou"
msgid "「うむ」"
msgstr "\"Hmm...\""

#. Occurrence 1DOT5_4:6398:1992: scene=1DOT5_4
#: 1DOT5_4:6398
msgctxt "text_id=1992 | speaker=unknown"
msgid "　彼女の急変をしたり顔で見送る草十郎。"
msgstr "  Soujyuro watched the girl with many strange faces disappear."

#. Occurrence 1DOT5_4:6403:1993: scene=1DOT5_4
#: 1DOT5_4:6403
msgctxt "text_id=1993 | speaker=unknown"
msgid "　行くあてなく散歩をしていたように見えた花澤さんだが、これだけ時間を潰したのだ。"
msgstr "  For someone who seemed to have been on an aimless walk, Hanazawa had spent a good deal of time with him."

#. Occurrence 1DOT5_4:6408:1994: scene=1DOT5_4
#: 1DOT5_4:6408
msgctxt "text_id=1994 | speaker=unknown"
msgid "　手伝ってくれた時と同じように、適当な用事を思いだしてしまったのだろう。"
msgstr "  Maybe helping Soujyuro out reminded her of something she needed to do."

#. Occurrence 1DOT5_4:6439:1995: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0039; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6439
msgctxt "text_id=1995 | speaker=aoko"
msgid "「静希君、そっちにいるの？」"
msgstr "\"Sizuki, are you out there?\""

#. Occurrence 1DOT5_4:6445:1996: scene=1DOT5_4
#: 1DOT5_4:6445
msgctxt "text_id=1996 | speaker=unknown"
msgid "　と。教会の角からひょっこり顔を出す生徒会長。"
msgstr "  The student council president popped her head out from the corner of the church."

#. Occurrence 1DOT5_4:6483:1997: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0040; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6483
msgctxt "text_id=1997 | speaker=aoko"
msgid "「あ、声かけてゴメン。いいから作業に専念―――」"
msgstr "\"Ah, don't mind me. You do your thing...\""

#. Occurrence 1DOT5_4:6489:1998: scene=1DOT5_4
#: 1DOT5_4:6489
msgctxt "text_id=1998 | speaker=unknown"
msgid "　自分の背丈より長いハシゴを片づけている草十郎を見て、青子は面食らったようだ。"
msgstr "  The sight of Soujyuro putting away a ladder taller than himself seemed to have provoked an emotional response in Aoko."

#. Occurrence 1DOT5_4:6499:1999: scene=1DOT5_4
#: 1DOT5_4:6499
msgctxt "text_id=1999 | speaker=unknown"
msgid "　それも一瞬の事で、彼女は腕まくりをして草十郎に歩み寄った。"
msgstr "  Then, in an instant, she rolled up her sleeves and began to approach him."

#. Occurrence 1DOT5_4:6537:2000: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0043; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6537
msgctxt "text_id=2000 | speaker=soujuurou"
msgid "「？」"
msgstr "\"Hm?\""

#. Occurrence 1DOT5_4:6542:2001: scene=1DOT5_4
#: 1DOT5_4:6542
msgctxt "text_id=2001 | speaker=unknown"
msgid "　とつぜん現れた青子より、草十郎にはそっちの方が驚きだったらしい。"
msgstr "  This surprised him more than Aoko's sudden appearance."

#. Occurrence 1DOT5_4:6547:2002: scene=1DOT5_4
#: 1DOT5_4:6547
msgctxt "text_id=2002 | speaker=unknown"
msgid "　当惑する草十郎をよそに、青子はてきぱきと指示をだす。"
msgstr "  Ignoring Soujyuro's bewilderment, Aoko promptly began issuing orders."

#. Occurrence 1DOT5_4:6574:2003: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0041; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6574
msgctxt "text_id=2003 | speaker=aoko"
msgid "「ハシゴ、横に倒していいわよ。"
msgstr "\"Put the ladder on its side."

#. Occurrence 1DOT5_4:6574:2004: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0041; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6574
msgctxt "text_id=2004 | speaker=aoko"
msgid "　下の方は私が持つから、貴方は上の方お願い」"
msgstr "  I'll hold the bottom, so you take the top.\""

#. Occurrence 1DOT5_4:6586:2005: scene=1DOT5_4
#: 1DOT5_4:6586
msgctxt "text_id=2005 | speaker=unknown"
msgid "　それがあまりに自然な行為だったので、ひとりで十分だと強がる前に、草十郎はハシゴを横に倒していた。"
msgstr "  She did all of this so matter-of-factly, that Soujyuro began lowering the ladder before he even had a chance to insist that he could do it by himself."

#. Occurrence 1DOT5_4:6649:2006: scene=1DOT5_4
#: 1DOT5_4:6649
msgctxt "text_id=2006 | speaker=unknown"
msgid "　アルバイトが終わり、シスターから気持ち程度の謝礼を受け取って、ふたりは教会を後にした。"
msgstr "  With work finished and the sister's thank you gifts in hand, the two put the church behind them."

#. Occurrence 1DOT5_4:6654:2007: scene=1DOT5_4
#: 1DOT5_4:6654
msgctxt "text_id=2007 | speaker=unknown"
msgid "　青子は駅前に用事があるとの事で、とりあえずそこまでは同じ道行きだ。"
msgstr "  Since Aoko apparently had something to do around the station, they decided they would walk together until they got there."

#. Occurrence 1DOT5_4:6688:2008: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0042; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6688
msgctxt "text_id=2008 | speaker=aoko"
msgid "「でも、ほんとにアルバイト慣れしてるのね」"
msgstr "\"You're a really hard worker.\""

#. Occurrence 1DOT5_4:6694:2009: scene=1DOT5_4
#: 1DOT5_4:6694
msgctxt "text_id=2009 | speaker=unknown"
msgid "　じき夕暮れになる空の下。"
msgstr "  Beneath the orange-tinged sky."

#. Occurrence 1DOT5_4:6699:2010: scene=1DOT5_4
#: 1DOT5_4:6699
msgctxt "text_id=2010 | speaker=unknown"
msgid "　話しかけるというよりは感想をもらすように、青子はそんな台詞を口にした。"
msgstr "  Aoko spoke more as though she was expressing her thoughts out loud than striking up a conversation."

#. Occurrence 1DOT5_4:6725:2011: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0044; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6725
msgctxt "text_id=2011 | speaker=soujuurou"
msgid "「そうか。蒼崎から見てそうなら、少しは嬉しいな」"
msgstr "\"Really? Coming from you, Aozaki, that's really nice to hear.\""

#. Occurrence 1DOT5_4:6731:2012: scene=1DOT5_4
#: 1DOT5_4:6731
msgctxt "text_id=2012 | speaker=unknown"
msgid "　素直に微笑む草十郎。"
msgstr "  Soujyuro gave her an earnest smile."

#. Occurrence 1DOT5_4:6736:2013: scene=1DOT5_4
#: 1DOT5_4:6736
msgctxt "text_id=2013 | speaker=unknown"
msgid "　もっとも、給金をもらってから彼はずっとホクホク顔だったので、何に喜んでいるかは不明だった。"
msgstr "  But then again, he had been beaming ever since he received his pay, so the source of his joy was not so clear."

#. Occurrence 1DOT5_4:6776:2014: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0043; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6776
msgctxt "text_id=2014 | speaker=aoko"
msgid "「あ、あのね。貴方は普段が問題ばっかりなんだから、あんまり調子に乗らないように。差し引きゼロっていうか、まだまだマイナスなんだから」"
msgstr "\"Not so fast. You've still got a ways to go, buster, so don't get too carried away. You're only just breaking even, if that.\""

#. Occurrence 1DOT5_4:6782:2015: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0045; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6782
msgctxt "text_id=2015 | speaker=soujuurou"
msgid "「む。学校の事は、言われると悲しくなる」"
msgstr "\"You're not going to get on my back about school, are you? That'll really spoil my mood.\""

#. Occurrence 1DOT5_4:6816:2016: scene=1DOT5_4
#: 1DOT5_4:6816
msgctxt "text_id=2016 | speaker=unknown"
msgid "　草十郎はがっくりとうなだれた。"
msgstr "  Soujyuro hung his head dejectedly."

#. Occurrence 1DOT5_4:6821:2017: scene=1DOT5_4
#: 1DOT5_4:6821
msgctxt "text_id=2017 | speaker=unknown"
msgid "　アルバイトはこなせても、学校の授業ばかりはどうにもならない。試験はともかく、日々の授業は一朝一夕でついて行けるものではないからだ。"
msgstr "  Even if his job had been going well, school was still a bust. Exams were one thing, but even classwork was something he had found himself falling behind in."

#. Occurrence 1DOT5_4:6847:2018: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0046; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6847
msgctxt "text_id=2018 | speaker=soujuurou"
msgid "「蒼崎は成績悪いヤツは嫌いか？」"
msgstr "\"Why do you hate people with bad grades, Aozaki?\""

#. Occurrence 1DOT5_4:6865:2019: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0044; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6865
msgctxt "text_id=2019 | speaker=aoko"
msgid "「……。まあ、頭というか巡りの悪い人との話は、疲れるでしょうね。でも貴方はそれ以前だし、そもそも私にはこれっぽっちも関係ないし。"
msgstr "\"Well, dealing with lame-brains is certainly tiring, but that's beside the point in your case. And don't let this get to your head. We're not friends, okay?"

#. Occurrence 1DOT5_4:6876:2020: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0045; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6876
msgctxt "text_id=2020 | speaker=aoko"
msgid "　でっかいハンデをなんとかするのは先生たちの仕事で、それに応えるのは貴方の役目。アルバイトもいいけど、帰ったらきちんと予習、やっときなさいよ」"
msgstr "  It's the teachers' job to figure out how to help students overcome handicaps, and it's your job to follow through on that help. Having a job is fine with me, but make sure you study properly when you get home.\""

#. Occurrence 1DOT5_4:6913:2021: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0047; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6913
msgctxt "text_id=2021 | speaker=soujuurou"
msgid "「それはもちろん。学校の人たちはみんないい人だ」"
msgstr "\"You can count on me. Everyone at the school is good people.\""

#. Occurrence 1DOT5_4:6919:2022: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0046; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6919
msgctxt "text_id=2022 | speaker=aoko"
msgid "「そ。ならいいけど―――みんないい人？」"
msgstr "\"Fine, if you say so-wait. Did you just say 'everyone is good people'?\""

#. Occurrence 1DOT5_4:6925:2023: scene=1DOT5_4
#: 1DOT5_4:6925
msgctxt "text_id=2023 | speaker=unknown"
msgid "　今のやりとりで、なんでそんな台詞が返ってくるのか、と首をかしげる青子だった。"
msgstr "  Aoko cocked her head to one side, unsure how this exchange had resulted in that response."

#. Occurrence 1DOT5_4:6930:2024: scene=1DOT5_4
#: 1DOT5_4:6930
msgctxt "text_id=2024 | speaker=unknown"
msgid "　おそらく、草十郎なりの感謝の表れなんだろう、と納得する。"
msgstr "  She decided to interpret it as Soujyuro simply expressing his gratitude in his own peculiar way."

#. Occurrence 1DOT5_4:6967:2025: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0047; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6967
msgctxt "text_id=2025 | speaker=aoko"
msgid "「―――ところで。"
msgstr "\"...Oh, one more thing."

#. Occurrence 1DOT5_4:6974:2026: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0048; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:6974
msgctxt "text_id=2026 | speaker=aoko"
msgid "参考までに訊くんだけど、貴方、他にどんなバイトしてるの？」"
msgstr "I need to know what other kinds of jobs you're working, you know, in case it comes up.\""

#. Occurrence 1DOT5_4:6985:2027: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0048; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:6985
msgctxt "text_id=2027 | speaker=soujuurou"
msgid "「どこって、商店街が多い。魚のお店とか、花の店とか。ああ、でも昨日は隣町まで遠出したな。遊園地のアルバイト」"
msgstr "\"If you're asking where, I work at a lot of places in the shopping district. The fish shop, the flower shop, and so on. Oh, but yesterday I went over to the next town. I worked a shift at the amusement park.\""

#. Occurrence 1DOT5_4:7019:2028: scene=1DOT5_4
#: 1DOT5_4:7019
msgctxt "text_id=2028 | speaker=unknown"
msgid "　学校側が認可しているのは三咲町の商店街だけなので、予想通りの回答だった。"
msgstr "  Since the only school-authorized locations were in the Misaki shopping district, his response was much as she expected."

#. Occurrence 1DOT5_4:7024:2029: scene=1DOT5_4
#: 1DOT5_4:7024
msgctxt "text_id=2029 | speaker=unknown"
msgid "　最後に出た、およそ静希草十郎とは無関係の単語以外は。"
msgstr "  That is, except for the decidedly unexpected last part."

#. Occurrence 1DOT5_4:7062:2030: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0049; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7062
msgctxt "text_id=2030 | speaker=aoko"
msgid "「遊園地って、<社木|やしろぎ>の!?」"
msgstr "\"When you say amusement park... you don't mean the one in Yashirogi, do you?!\""

#. Occurrence 1DOT5_4:7068:2031: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0049; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:7068
msgctxt "text_id=2031 | speaker=soujuurou"
msgid "「そう。使わなくなった看板とかオブジェとか、解体して運び出したんだ。さすがに疲れたな、あれは」"
msgstr "\"That's the one. I disassembled and moved unused signs and curios and stuff. It was exhausting.\""

#. Occurrence 1DOT5_4:7080:2032: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0050; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7080
msgctxt "text_id=2032 | speaker=aoko"
msgid "「へえー……うん、それは体力勝負でしょうね」"
msgstr "\"That so... Yeah, I can imagine it took a lot out of you.\""

#. Occurrence 1DOT5_4:7100:2033: scene=1DOT5_4
#: 1DOT5_4:7100
msgctxt "text_id=2033 | speaker=unknown"
msgid "　今度こそ本気で感心する青子。"
msgstr "  This left Aoko rather impressed."

#. Occurrence 1DOT5_4:7105:2034: scene=1DOT5_4
#: 1DOT5_4:7105
msgctxt "text_id=2034 | speaker=unknown"
msgid "　遊園地で使われる機械の運搬は、ちょっと、学生が片手間でやる仕事ではないからだ。"
msgstr "  Transporting unused amusement park machinery was not a job that students did willingly in their free time."

#. Occurrence 1DOT5_4:7140:2035: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0051; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7140
msgctxt "text_id=2035 | speaker=aoko"
msgid "「でもいいなあ。私、キッツィーランドって一度も行った事ないの。三咲町に住んでるのに」"
msgstr "\"I'm a bit jealous. I've never even been to Kitsy Land, even though it's so close to here.\""

#. Occurrence 1DOT5_4:7189:2036: scene=1DOT5_4
#: 1DOT5_4:7189
msgctxt "text_id=2036 | speaker=unknown"
msgid "　青子は隣町の方角を仰ぎ見る。"
msgstr "  Aoko looked up in the direction of the neighboring town."

#. Occurrence 1DOT5_4:7194:2037: scene=1DOT5_4
#: 1DOT5_4:7194
msgctxt "text_id=2037 | speaker=unknown"
msgid "　ここから見えるのは、かろうじて観覧車だけ。"
msgstr "  From here you could just barely make out the Ferris wheel."

#. Occurrence 1DOT5_4:7199:2038: scene=1DOT5_4
#: 1DOT5_4:7199
msgctxt "text_id=2038 | speaker=unknown"
msgid "　夕日に照らされた円形の鉄骨仕掛けは、<寂|さび>れた<墓標|ぼひょう>を思わせる。"
msgstr "  The round, steel frame of the wheel, illuminated by the sunset as it was, was reminiscent of an old gravestone."

#. Occurrence 1DOT5_4:7246:2039: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0050; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:7246
msgctxt "text_id=2039 | speaker=soujuurou"
msgid "「……そうか。それは、金銭的な理由で？」"
msgstr "\"...That's a shame. Is it because you're short on cash?\""

#. Occurrence 1DOT5_4:7271:2040: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0052; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7271
msgctxt "text_id=2040 | speaker=aoko"
msgid "「っ―――」"
msgstr "\"Pft―\""

#. Occurrence 1DOT5_4:7277:2041: scene=1DOT5_4
#: 1DOT5_4:7277
msgctxt "text_id=2041 | speaker=unknown"
msgid "　途端、青子はおかしそうに口をおさえた。"
msgstr "  Aoko had to stifle her laughter."

#. Occurrence 1DOT5_4:7282:2042: scene=1DOT5_4
#: 1DOT5_4:7282
msgctxt "text_id=2042 | speaker=unknown"
msgid "　草十郎に失礼だと思ったものの、笑いのツボに入ってしまったらしい。"
msgstr "  She knew it would be rude to Soujyuro to burst out laughing, but the remark tickled her funny bone."

#. Occurrence 1DOT5_4:7308:2043: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0053; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7308
msgctxt "text_id=2043 | speaker=aoko"
msgid "「ううん、そういうんじゃなくて。"
msgstr "\"No, it's not like that."

#. Occurrence 1DOT5_4:7314:2044: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0054; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7314
msgctxt "text_id=2044 | speaker=aoko"
msgid "　単純に、あれが開園してから立てこんでて、遊びにいく暇がなかっただけよ。お金で解決する問題だったら、それこそ今すぐに行ってるわ」"
msgstr "  It's simple, really. Even back when it first opened, it was always packed with people, and I just never had the time to go. If it were a problem that could be solved with money, I would go right now.\""

#. Occurrence 1DOT5_4:7334:2045: scene=1DOT5_4
#: 1DOT5_4:7334
msgctxt "text_id=2045 | speaker=unknown"
msgid "　ほら、と青子は教会のアルバイト代の入った封筒を見せた。"
msgstr "  Aoko showed Soujyuro the envelope that contained the pay from the church."

#. Occurrence 1DOT5_4:7339:2046: scene=1DOT5_4
#: 1DOT5_4:7339
msgctxt "text_id=2046 | speaker=unknown"
msgid "　その仕草は明るいものだったが、それでも“行く”と口にしない青子に、草十郎はむっと顔を曇らせる。"
msgstr "  There was nothing sinister about her remark and gesture, but the fact that she did not jump at the chance to go made Soujyuro sad."

#. Occurrence 1DOT5_4:7374:2047: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0051; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:7374
msgctxt "text_id=2047 | speaker=soujuurou"
msgid "「それなら、今度行けばいいじゃないか」"
msgstr "\"Then why don't we go sometime?\""

#. Occurrence 1DOT5_4:7391:2048: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0055; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7391
msgctxt "text_id=2048 | speaker=aoko"
msgid "「ありがと。けどそれは無理な話。"
msgstr "\"Thanks, but no can do."

#. Occurrence 1DOT5_4:7398:2049: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0056; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7398
msgctxt "text_id=2049 | speaker=aoko"
msgid "アンタの事だから気づいていないと思うけど、アレ、つぶれてるのよ。"
msgstr "You probably didn't catch on because you are who you are, but the place went out of business."

#. Occurrence 1DOT5_4:7405:2050: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_1DOT5_4_0057; voice_prefix=A10; voice_category=1; scene=1DOT5_4
#: 1DOT5_4:7405
msgctxt "text_id=2050 | speaker=aoko"
msgid "廃園になってからもう二年以上は経つんじゃない？」"
msgstr "I think it's been about two years since the park closed down.\""

#. Occurrence 1DOT5_4:7416:2051: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0052; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:7416
msgctxt "text_id=2051 | speaker=soujuurou"
msgid "「―――なんと」"
msgstr "\"What...?\""

#. Occurrence 1DOT5_4:7450:2052: scene=1DOT5_4
#: 1DOT5_4:7450
msgctxt "text_id=2052 | speaker=unknown"
msgid "　どうりで客がいなかった、と草十郎は納得する。"
msgstr "  It was no wonder there were no customers all the time he was there."

#. Occurrence 1DOT5_4:7455:2053: scene=1DOT5_4
#: 1DOT5_4:7455
msgctxt "text_id=2053 | speaker=unknown"
msgid "　生徒会長は呆れながらも少しだけ楽しそうだ。"
msgstr "  Exasperated as she was at Soujyuro, the student council president seemed to be enjoying herself."

#. Occurrence 1DOT5_4:7460:2054: scene=1DOT5_4
#: 1DOT5_4:7460
msgctxt "text_id=2054 | speaker=unknown"
msgid "　いつもなら“そんな事まで教えないと分からないとは！”と呆れていた彼女だが、この夕暮れにかぎっては、なんだか微笑ましく見えたらしい。"
msgstr "  At this point, she would be yelling things at Soujyuro like, \"I can't believe you didn't know that!\" But this evening―this one and only evening―she found it charming."

#. Occurrence 1DOT5_4:7520:2055: scene=1DOT5_4
#: 1DOT5_4:7520
msgctxt "text_id=2055 | speaker=unknown"
msgid "　蒼崎青子と別れ、アパートに帰って学校の予習に埋没していると、あっという間にアルバイトの時間になった。"
msgstr "  They parted ways, and Soujyuro returned home to his apartment, immersed himself in his studies, and before he knew it was time to go to work."

#. Occurrence 1DOT5_4:7525:2056: scene=1DOT5_4
#: 1DOT5_4:7525
msgctxt "text_id=2056 | speaker=unknown"
msgid "　山と都会の違いはそれこそ数えきれないが、もっとも大きな点は時間の用途だ。"
msgstr "  The major cultural difference―though certainly not the only point of difference―between city and country was the use of time."

#. Occurrence 1DOT5_4:7530:2057: scene=1DOT5_4
#: 1DOT5_4:7530
msgctxt "text_id=2057 | speaker=unknown"
msgid "　此処ではともかく、時の流れが早すぎる。"
msgstr "  It did not matter what part of the city he was in, time flowed far too quickly here."

#. Occurrence 1DOT5_4:7535:2058: scene=1DOT5_4
#: 1DOT5_4:7535
msgctxt "text_id=2058 | speaker=unknown"
msgid "　ちっとも頭に入らなかった参考書を片づけて、草十郎は一日の締めとばかりに夜の町に出かけていった。"
msgstr "  Failing to squeeze even a drop of knowledge from his textbooks, he put them away for the day before heading into town."

#. Occurrence 1DOT5_4:7581:2059: scene=1DOT5_4
#: 1DOT5_4:7581
msgctxt "text_id=2059 | speaker=unknown"
msgid "　日付変更線を越えて、夜はますます深く眠りについていく。"
msgstr "  The night grew deeper as today turned into tomorrow."

#. Occurrence 1DOT5_4:7586:2060: scene=1DOT5_4
#: 1DOT5_4:7586
msgctxt "text_id=2060 | speaker=unknown"
msgid "　<襟|えり>をたてて、冷えこんだ冬の空気から首筋を守りながら、草十郎は帰路につく。"
msgstr "  Soujyuro reversed his collar to protect his neck from the bitter cold and began to make his way back home."

#. Occurrence 1DOT5_4:7591:2061: scene=1DOT5_4
#: 1DOT5_4:7591
msgctxt "text_id=2061 | speaker=unknown"
msgid "　周囲には<食べ物|ひろいもの>目当ての犬もいないし、ちょっとした買い物で出歩いている人もいない。"
msgstr "  Not a soul to be seen. No dogs scrounging for food, no late-night shoppers."

#. Occurrence 1DOT5_4:7596:2062: scene=1DOT5_4
#: 1DOT5_4:7596
msgctxt "text_id=2062 | speaker=unknown"
msgid "　この近くに一店だけのコンビニエンスストアも夜の十一時に閉まってしまう以上、買い物目的で外出する住民はいないのだろう。"
msgstr "  Why would there be; the solitary convenience store in the area closed at eleven o'clock."

#. Occurrence 1DOT5_4:7621:2063: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0053; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:7621
msgctxt "text_id=2063 | speaker=soujuurou"
msgid "「―――ふう」"
msgstr "\"...Hah.\""

#. Occurrence 1DOT5_4:7627:2064: scene=1DOT5_4
#: 1DOT5_4:7627
msgctxt "text_id=2064 | speaker=unknown"
msgid "　脱力して、ひときわ深く呼吸をする。"
msgstr "  He mustered what little energy he had to take in an especially deep breath."

#. Occurrence 1DOT5_4:7632:2065: scene=1DOT5_4
#: 1DOT5_4:7632
msgctxt "text_id=2065 | speaker=unknown"
msgid "　人気のない、人工物によって築かれた町並み。"
msgstr "  Man-made landmarks lined the deserted street."

#. Occurrence 1DOT5_4:7637:2066: scene=1DOT5_4
#: 1DOT5_4:7637
msgctxt "text_id=2066 | speaker=unknown"
msgid "　星明かりより眩しい、青い蛍光灯に照らされた暗がり。"
msgstr "  Garish blue fluorescent light, brighter than the stars above, illuminated the darkness."

#. Occurrence 1DOT5_4:7642:2067: scene=1DOT5_4
#: 1DOT5_4:7642
msgctxt "text_id=2067 | speaker=unknown"
msgid "　そういったものが、意識せずとも草十郎の不安をあおり立てる。"
msgstr "  An unconscious sense of anxiety stirred within him."

#. Occurrence 1DOT5_4:7699:2068: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0054; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:7699
msgctxt "text_id=2068 | speaker=soujuurou"
msgid "「……情けない。夜が怖いのは当たり前じゃないか」"
msgstr "\"...Get yourself together. It's normal for the night to be scary.\""

#. Occurrence 1DOT5_4:7705:2069: scene=1DOT5_4
#: 1DOT5_4:7705
msgctxt "text_id=2069 | speaker=unknown"
msgid "　ぶるっとくる寒気に背を丸めながら、強がりを口にする。"
msgstr "  A chill crept up his spine as he attempted to mask his weakness with words."

#. Occurrence 1DOT5_4:7710:2070: scene=1DOT5_4
#: 1DOT5_4:7710
msgctxt "text_id=2070 | speaker=unknown"
msgid "“暗がりに近づくな”"
msgstr "\"Stay out of the dark.\""

#. Occurrence 1DOT5_4:7715:2071: scene=1DOT5_4
#: 1DOT5_4:7715
msgctxt "text_id=2071 | speaker=unknown"
msgid "“人気のないところには立ち入るな”"
msgstr "\"Stay away from deserted places.\""

#. Occurrence 1DOT5_4:7720:2072: scene=1DOT5_4
#: 1DOT5_4:7720
msgctxt "text_id=2072 | speaker=unknown"
msgid "　何の因果か、それとも、それだけ情けない顔をしていたのか。"
msgstr "  Whether it was for some deeper reason, or perhaps the fact that he looked so helpless..."

#. Occurrence 1DOT5_4:7726:2073: scene=1DOT5_4
#: 1DOT5_4:7726
msgctxt "text_id=2073 | speaker=unknown"
msgid "草十郎がこれまで知り合ってきた人たちは、決まってそんな忠告をした。"
msgstr "Everybody he had met in his life seemed to warn him with those words."

#. Occurrence 1DOT5_4:7765:2074: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0055; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:7765
msgctxt "text_id=2074 | speaker=soujuurou"
msgid "「そうは言ってもしょうがないし、だいたい」"
msgstr "\"Did knowing that ever help anyone?\""

#. Occurrence 1DOT5_4:7790:2075: scene=1DOT5_4
#: 1DOT5_4:7790
msgctxt "text_id=2075 | speaker=unknown"
msgid "　暗がりに近づくな、なんて言われても実感が湧かない。"
msgstr "  What did that even mean, \"Stay out of the dark\"?"

#. Occurrence 1DOT5_4:7795:2076: scene=1DOT5_4
#: 1DOT5_4:7795
msgctxt "text_id=2076 | speaker=unknown"
msgid "　<都|こ><会|こ>には明かりのない場所はない。"
msgstr "  Nowhere in the city was without light."

#. Occurrence 1DOT5_4:7800:2077: scene=1DOT5_4
#: 1DOT5_4:7800
msgctxt "text_id=2077 | speaker=unknown"
msgid "　大通りは言うに及ばず、駅前の喧噪から離れた住宅地にだって電灯の明かりがある。"
msgstr "  Everywhere, from the bustling train station to the remote residential areas, was illuminated by artificial light, not least the main roads."

#. Occurrence 1DOT5_4:7820:2078: scene=1DOT5_4
#: 1DOT5_4:7820
msgctxt "text_id=2078 | speaker=unknown"
msgid "　怖いのは怖いが、怖さの質が山とは違う。"
msgstr "  Scary was scary, but this kind of fear was of a different sort than what he'd felt in the mountains."

#. Occurrence 1DOT5_4:7826:2079: scene=1DOT5_4
#: 1DOT5_4:7826
msgctxt "text_id=2079 | speaker=unknown"
msgid "　おそらくは根本になるルールが違うのだ。"
msgstr "  The most likely source of his fear was the fact that this place was governed by starkly different rules."

#. Occurrence 1DOT5_4:7831:2080: scene=1DOT5_4
#: 1DOT5_4:7831
msgctxt "text_id=2080 | speaker=unknown"
msgid "　因果応報の仕組みが一方にのみ優しく作られている。"
msgstr "  The way in which the city meted out justice was terribly imbalanced."

#. Occurrence 1DOT5_4:7836:2081: scene=1DOT5_4
#: 1DOT5_4:7836
msgctxt "text_id=2081 | speaker=unknown"
msgid "　怖いと言えば、そのルールがまだよく分からない事の方が、田舎育ちの彼には怖い。"
msgstr "  And to the provincial Soujyuro, his lack of familiarity with the laws of the land terrified him far more than the dark."

#. Occurrence 1DOT5_4:7860:2082: scene=1DOT5_4
#: 1DOT5_4:7860
msgctxt "text_id=2082 | speaker=unknown"
msgid "　山では、ルールを破った者は<そ|・><の|・><時|・><点|・>で報いを受ける。"
msgstr "  In the mountains, retribution came swiftly to those who broke the rules."

#. Occurrence 1DOT5_4:7865:2083: scene=1DOT5_4
#: 1DOT5_4:7865
msgctxt "text_id=2083 | speaker=unknown"
msgid "　例えば<獣道|けものみち>。"
msgstr "  Take a game trail, for example."

#. Occurrence 1DOT5_4:7871:2084: scene=1DOT5_4
#: 1DOT5_4:7871
msgctxt "text_id=2084 | speaker=unknown"
msgid "彼らの縄張りと気付かずに入ってしまえば、当然、住人である動物に襲われて怪我を負う。"
msgstr "Those who unwittingly trespassed on the animal kingdom's domain would, as a matter of course, be savaged by the native wildlife."

#. Occurrence 1DOT5_4:7876:2085: scene=1DOT5_4
#: 1DOT5_4:7876
msgctxt "text_id=2085 | speaker=unknown"
msgid "　このように、草十郎にとって過ちとはすぐさま返ってくるものだった。"
msgstr "  Accordingly, in Soujyuro's mind, an offender paid the price for one's mistakes immediately."

#. Occurrence 1DOT5_4:7881:2086: scene=1DOT5_4
#: 1DOT5_4:7881
msgctxt "text_id=2086 | speaker=unknown"
msgid "　誰が誰を罰するというのではなく、ルールを破れば即、その間違いがカタチになって降りかかると。"
msgstr "  It was not a matter of who punished whom; it was simply that the one who broke the rules would meet instant, tangible retribution."

#. Occurrence 1DOT5_4:7915:2087: scene=1DOT5_4
#: 1DOT5_4:7915
msgctxt "text_id=2087 | speaker=unknown"
msgid "　都会はそのあたりが少しだけ曖昧だと思う。"
msgstr "  He felt that, in this regard, the laws of the city were far too ambiguous."

#. Occurrence 1DOT5_4:7920:2088: scene=1DOT5_4
#: 1DOT5_4:7920
msgctxt "text_id=2088 | speaker=unknown"
msgid "　だから、一体なにが正しかったのか、なにが間違っていたのか、致命的な<結末|おわり>になるまで分からない。"
msgstr "  One could meet their demise without ever knowing whether one was in the right or wrong."

#. Occurrence 1DOT5_4:7941:2089: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0056; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:7941
msgctxt "text_id=2089 | speaker=soujuurou"
msgid "「……けど、基本的には変わらないんだよな、たぶん」"
msgstr "\"Though, I guess it's probably not that different when it comes down to it.\""

#. Occurrence 1DOT5_4:7947:2090: scene=1DOT5_4
#: 1DOT5_4:7947
msgctxt "text_id=2090 | speaker=unknown"
msgid "　単純に因果応報の効果が遅いだけ。"
msgstr "  To put it simply, retribution was delayed."

#. Occurrence 1DOT5_4:7952:2091: scene=1DOT5_4
#: 1DOT5_4:7952
msgctxt "text_id=2091 | speaker=unknown"
msgid "　さらに喩えるなら、彼の田舎には村の治安維持を任された人間はいなかった。"
msgstr "  To take the analogy a step further, back home in his village, no one individual had been given the responsibility of maintaining order."

#. Occurrence 1DOT5_4:7985:2092: scene=1DOT5_4
#: 1DOT5_4:7985
msgctxt "text_id=2092 | speaker=unknown"
msgid "　都会は人間に優しいかわりに、ルールを破った人間を罰する何者かが<据|す>えられている。"
msgstr "  In the city, however, someone was put in charge of punishing law-breakers on behalf of the kindhearted citizens who lived there."

#. Occurrence 1DOT5_4:7990:2093: scene=1DOT5_4
#: 1DOT5_4:7990
msgctxt "text_id=2093 | speaker=unknown"
msgid "　山では罪と罰は同義だったが、街ではその二つは切り離され、罪をおかした後に、罰を持ってくる他人がいるらしい。"
msgstr "  While crime and punishment in the mountains were synonymous, in the city the two were separated, and an unrelated person brought judgment after the crime had been committed."

#. Occurrence 1DOT5_4:8010:2094: scene=1DOT5_4
#: 1DOT5_4:8010
msgctxt "text_id=2094 | speaker=unknown"
msgid "　入ってはいけない場所。"
msgstr "  Entering places that must not be entered..."

#. Occurrence 1DOT5_4:8015:2095: scene=1DOT5_4
#: 1DOT5_4:8015
msgctxt "text_id=2095 | speaker=unknown"
msgid "　見てはいけない出来事。"
msgstr "  Seeing things that must not be seen..."

#. Occurrence 1DOT5_4:8020:2096: scene=1DOT5_4
#: 1DOT5_4:8020
msgctxt "text_id=2096 | speaker=unknown"
msgid "　そういったルールを破った時、何者かが罰しに来るのが社会のルールなのだ。"
msgstr "  Breaking a law had consequences; someone would come to exact justice for the law that was broken."

#. Occurrence 1DOT5_4:8050:2097: scene=1DOT5_4
#: 1DOT5_4:8050
msgctxt "text_id=2097 | speaker=unknown"
msgid "　なので―――町で安全に暮らす方法というのは、余人の事情に立ち入らないこと。"
msgstr "  The result of all this was that the safest way to survive the city was not to stick your nose in the affairs of others."

#. Occurrence 1DOT5_4:8056:2098: scene=1DOT5_4
#: 1DOT5_4:8056
msgctxt "text_id=2098 | speaker=unknown"
msgid "　草十郎を気遣ってくれた人たちが口を揃えて“近づくな”と言っていたのは、“そうなったら誰も助けてあげられない”からなのだろう。"
msgstr "  When the people who cared about Soujyuro told him to \"stay away,\" they probably meant, \"if you don't, nobody will be able to help you.\""

#. Occurrence 1DOT5_4:8077:2099: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0057; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:8077
msgctxt "text_id=2099 | speaker=soujuurou"
msgid "「……っと。いけない、また近道しそうになった」"
msgstr "\"Oh crap, I almost took another shortcut.\""

#. Occurrence 1DOT5_4:8097:2100: scene=1DOT5_4
#: 1DOT5_4:8097
msgctxt "text_id=2100 | speaker=unknown"
msgid "　なので、いくら邪魔だからといって人の家の塀をよじのぼって、すぐ向こうのアパートを目指してはいけないのである。"
msgstr "  No matter how much of a nuisance these obstacles were, one could not just climb over a neighbor's fence, even when one's apartment was just the other side."

#. Occurrence 1DOT5_4:8102:2101: scene=1DOT5_4
#: 1DOT5_4:8102
msgctxt "text_id=2101 | speaker=unknown"
msgid "　たまたま家の人が起きていたら警察に通報されて、誰にも助けてもらえなくなってしまう。"
msgstr "  If the people inside happened to be awake and call the police, nobody would lift a hand to help him."

#. Occurrence 1DOT5_4:8144:2102: scene=1DOT5_4
#: 1DOT5_4:8144
msgctxt "text_id=2102 | speaker=unknown"
msgid "　そんな見当違いの都市観を持ったまま、今日も静希草十郎の一日は平穏に終わっていく。"
msgstr "  With his misguided view of the city, Soujyuro once again ended his day in peace."

#. Occurrence 1DOT5_4:8180:2103: scene=1DOT5_4
#: 1DOT5_4:8180
msgctxt "text_id=2103 | speaker=unknown"
msgid "　すぐには寝つけず、床についたまま窓越しの空を眺める。"
msgstr "  Unable to fall asleep right away, he gazed out his window upon the night sky from the floor of his apartment."

#. Occurrence 1DOT5_4:8185:2104: scene=1DOT5_4
#: 1DOT5_4:8185
msgctxt "text_id=2104 | speaker=unknown"
msgid "　都会にきた彼が最初に戦慄した<風景|もの>。"
msgstr "  The cityscape had caused him to tremble in fear when he first moved here."

#. Occurrence 1DOT5_4:8190:2105: scene=1DOT5_4
#: 1DOT5_4:8190
msgctxt "text_id=2105 | speaker=unknown"
msgid "　スイッチひとつでたいていの事は解決される便利さも、"
msgstr "  The convenience of solving almost any problem with the flip of a switch..."

#. Occurrence 1DOT5_4:8195:2106: scene=1DOT5_4
#: 1DOT5_4:8195
msgctxt "text_id=2106 | speaker=unknown"
msgid "　壁一枚隣りに顔しか知らない他人が住んでいる新鮮さも、"
msgstr "  The novelty of living a wall away from a complete stranger..."

#. Occurrence 1DOT5_4:8200:2107: scene=1DOT5_4
#: 1DOT5_4:8200
msgctxt "text_id=2107 | speaker=unknown"
msgid "　この夜空を見上げた時に吹き飛んだ。"
msgstr "  It all disappeared into the night sky when he looked up."

#. Occurrence 1DOT5_4:8222:2108: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0058; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:8222
msgctxt "text_id=2108 | speaker=soujuurou"
msgid "“……こんな空も、あるのか”"
msgstr "\"...Is this really the same sky?\""

#. Occurrence 1DOT5_4:8228:2109: scene=1DOT5_4
#: 1DOT5_4:8228
msgctxt "text_id=2109 | speaker=unknown"
msgid "　意識せず、漠然とこぼれた言葉を覚えている。"
msgstr "  Unconsciously, he recalled his own words."

#. Occurrence 1DOT5_4:8248:2110: scene=1DOT5_4
#: 1DOT5_4:8248
msgctxt "text_id=2110 | speaker=unknown"
msgid "　なんて暗い星。"
msgstr "  \"What dim stars.\""

#. Occurrence 1DOT5_4:8253:2111: scene=1DOT5_4
#: 1DOT5_4:8253
msgctxt "text_id=2111 | speaker=unknown"
msgid "　なんて狭い空。"
msgstr "  \"What a cramped sky.\""

#. Occurrence 1DOT5_4:8258:2112: scene=1DOT5_4
#: 1DOT5_4:8258
msgctxt "text_id=2112 | speaker=unknown"
msgid "　ここでは星の見える夜はない。"
msgstr "  Here there were no starry nights."

#. Occurrence 1DOT5_4:8263:2113: scene=1DOT5_4
#: 1DOT5_4:8263
msgctxt "text_id=2113 | speaker=unknown"
msgid "　自分はここで暮らしていけるのかどうか―――"
msgstr "  Could he even survive here?"

#. Occurrence 1DOT5_4:8269:2114: scene=1DOT5_4
#: 1DOT5_4:8269
msgctxt "text_id=2114 | speaker=unknown"
msgid "　あの夜に抱いた不安は今も変わっていない。"
msgstr "  The same misgivings since his first night continued to haunt him."

#. Occurrence 1DOT5_4:8290:2115: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_1DOT5_4_0059; voice_prefix=A30; voice_category=3; scene=1DOT5_4
#: 1DOT5_4:8290
msgctxt "text_id=2115 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 1DOT5_4:8309:2116: scene=1DOT5_4
#: 1DOT5_4:8309
msgctxt "text_id=2116 | speaker=unknown"
msgid "　<瞼|まぶた>を閉じる。"
msgstr "  His eyelids fell shut."

#. Occurrence 1DOT5_4:8314:2117: scene=1DOT5_4
#: 1DOT5_4:8314
msgctxt "text_id=2117 | speaker=unknown"
msgid "　そんな女々しい悩みとは裏腹に、アルバイトと勉強で疲れた体はあっさり、ぐっすり安眠していった。"
msgstr "  Although he was fraught with worry, Soujyuro's body felt the fatigue from his work and studies, and thus, he fell fast asleep."

#. Occurrence 2_1:130:2118: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0000; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:130
msgctxt "text_id=2118 | speaker=soujuurou"
msgid "“都会は魔界だ。"
msgstr "\"The city is really strange,"

#. Occurrence 2_1:139:2119: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0001; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:139
msgctxt "text_id=2119 | speaker=soujuurou"
msgid "　けど、慣れればわりと住みやすいとは思う”"
msgstr "  but a pretty easy place to live, once you get the hang of it.\""

#. Occurrence 2_1:198:2120: scene=2_1
#: 2_1:198
msgctxt "text_id=2120 | speaker=unknown"
msgid "　はあ、と力のないため息がこぼれる。"
msgstr "  Soujyuro sighed listlessly."

#. Occurrence 2_1:203:2121: scene=2_1
#: 2_1:203
msgctxt "text_id=2121 | speaker=unknown"
msgid "　静希草十郎は冬の校庭を見下ろしながら、柄にもなく物思いに<耽|ふけ>っていた。"
msgstr "  He looked down at the winter schoolyard below, lost in thought."

#. Occurrence 2_1:233:2122: scene=2_1
#: 2_1:233
msgctxt "text_id=2122 | speaker=unknown"
msgid "　黒板の隅には１２月の日付。"
msgstr "  \"December\" was written on the corner of the chalkboard."

#. Occurrence 2_1:238:2123: scene=2_1
#: 2_1:238
msgctxt "text_id=2123 | speaker=unknown"
msgid "　早いもので、草十郎が転入してからすでに十日。"
msgstr "  He could not believe ten days had already passed since he transferred to the school."

#. Occurrence 2_1:243:2124: scene=2_1
#: 2_1:243
msgctxt "text_id=2124 | speaker=unknown"
msgid "　暦が１２月に移り、辛うじて残っていた秋の面影は見る影もない。"
msgstr "  The last vestiges of autumn had faded with the change of the month."

#. Occurrence 2_1:248:2125: scene=2_1
#: 2_1:248
msgctxt "text_id=2125 | speaker=unknown"
msgid "　校庭の木々はそのほとんどが裸になり、舞い散った落ち葉が地面を覆い隠している。"
msgstr "  The trees were all but barren, and the ground below them a mat of fallen leaves."

#. Occurrence 2_1:289:2126: scene=2_1
#: 2_1:289
msgctxt "text_id=2126 | speaker=unknown"
msgid "　古典の時間。"
msgstr "  Fourth period was classics."

#. Occurrence 2_1:294:2127: scene=2_1
#: 2_1:294
msgctxt "text_id=2127 | speaker=unknown"
msgid "　教壇からは老教師による見解が淡々と流れてくる。"
msgstr "  An elderly teacher stood at the lectern and rambled on."

#. Occurrence 2_1:299:2128: scene=2_1
#: 2_1:299
msgctxt "text_id=2128 | speaker=unknown"
msgid "　ようやく馴れてきた教室と、まだまだ追いつけない授業の四時限目。"
msgstr "  While he had finally gotten used to the classroom, he still had a long way to go to get up to speed in his classes."

#. Occurrence 2_1:304:2129: scene=2_1
#: 2_1:304
msgctxt "text_id=2129 | speaker=unknown"
msgid "　基礎が出来てない草十郎にとって、日々の授業は真剣勝負だ。"
msgstr "  Lacking even the basic understanding most students learn in their early scholastic life, it was a battle for Soujyuro to keep up."

#. Occurrence 2_1:309:2130: scene=2_1
#: 2_1:309
msgctxt "text_id=2130 | speaker=unknown"
msgid "　今は内容を正しく飲みこめなくともきっかり暗記し、後々に生かせるよう心がけている。"
msgstr "  Even if he was unable to grasp all of the content right away, he at least tried to memorize everything in the hope that he could make use of it down the road."

#. Occurrence 2_1:329:2131: scene=2_1
#: 2_1:329
msgctxt "text_id=2131 | speaker=unknown"
msgid "　なので雑念などもってのほか。"
msgstr "  Which is why losing himself in his thoughts was about the last thing he should have been doing."

#. Occurrence 2_1:334:2132: scene=2_1
#: 2_1:334
msgctxt "text_id=2132 | speaker=unknown"
msgid "　よそ見をしている暇はない、と厳しく自分に言いつけているのだが、"
msgstr "  He would normally chastise himself for daydreaming, but..."

#. Occurrence 2_1:374:2133: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0002; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:374
msgctxt "text_id=2133 | speaker=soujuurou"
msgid "「………………はあ」"
msgstr "\"...Hah.\""

#. Occurrence 2_1:379:2134: scene=2_1
#: 2_1:379
msgctxt "text_id=2134 | speaker=unknown"
msgid "　困ったコトに、今日はどうしても授業に集中できなかった。"
msgstr "  Troublingly, he was unable to concentrate in class today."

#. Occurrence 2_1:399:2135: scene=2_1
#: 2_1:399
msgctxt "text_id=2135 | speaker=unknown"
msgid "　集中力の不足はどこからきたものか。"
msgstr "  Soujyuro could not place the source of his lack of concentration."

#. Occurrence 2_1:404:2136: scene=2_1
#: 2_1:404
msgctxt "text_id=2136 | speaker=unknown"
msgid "　都市の冬は山に比べれば格段に住みやすいし、毎日のアルバイトだってそう<過酷|ハード>ではない。"
msgstr "  It could not have been the winter in the city; it was much milder than in the mountains. Neither was his part-time job particularly tiring."

#. Occurrence 2_1:409:2137: scene=2_1
#: 2_1:409
msgctxt "text_id=2137 | speaker=unknown"
msgid "　肉体的な疲れは、まあ、人並みだろうから理由にはあげられない。"
msgstr "  He was not any more physically fatigued than the average student, so that could not be it either."

#. Occurrence 2_1:445:2138: scene=2_1
#: 2_1:445
msgctxt "text_id=2138 | speaker=unknown"
msgid "　では授業そのものが退屈だから、と言われるとそれも違う。"
msgstr "  Others might conclude that it was because the courses were boring, but that seemed off the mark, too."

#. Occurrence 2_1:450:2139: scene=2_1
#: 2_1:450
msgctxt "text_id=2139 | speaker=unknown"
msgid "　草十郎はクラスメイトたちが言うほど授業をつまらないものだと感じていない。"
msgstr "  Soujyuro did not share his classmates' opinions about their classes."

#. Occurrence 2_1:455:2140: scene=2_1
#: 2_1:455
msgctxt "text_id=2140 | speaker=unknown"
msgid "　良いか悪いかで言えば、間違いなく良い部類に入る時間だ。"
msgstr "  On the contrary, he rather enjoyed his class time."

#. Occurrence 2_1:475:2141: scene=2_1
#: 2_1:475
msgctxt "text_id=2141 | speaker=unknown"
msgid "　なので精神的な面でも理由は見あたらない。"
msgstr "  No, his frame of mind was not to blame either."

#. Occurrence 2_1:480:2142: scene=2_1
#: 2_1:480
msgctxt "text_id=2142 | speaker=unknown"
msgid "　ここまで集中力が散漫になるのはどうかと思う、と草十郎は我が身の情けなさに落ちこんでいる。"
msgstr "  Trying to figure out what was wrong only made him more depressed."

#. Occurrence 2_1:527:2143: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0003; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:527
msgctxt "text_id=2143 | speaker=soujuurou"
msgid "『……いけない。こんなんじゃ気が散る一方だ』"
msgstr "(What's wrong with me? It's not like me to be so distracted.)"

#. Occurrence 2_1:553:2144: scene=2_1
#: 2_1:553
msgctxt "text_id=2144 | speaker=unknown"
msgid "　自分を叱って黒板に目を向ける。"
msgstr "  He scolded himself and turned his attention to the chalkboard."

#. Occurrence 2_1:558:2145: scene=2_1
#: 2_1:558
msgctxt "text_id=2145 | speaker=unknown"
msgid "　カツカツと規則正しく、なのになぜか眠気を誘う<白墨|チョーク>の滑る音も、この純朴な転入生を<堕落|だらく>させるには至らない。"
msgstr "  The rhythmic ticks of the chalk were sending him into a slumber, but he somehow managed to resist their lullaby."

#. Occurrence 2_1:607:2146: scene=2_1
#: 2_1:607
msgctxt "text_id=2146 | speaker=unknown"
msgid "　けれどやっぱり、彼は授業に集中できなかった。"
msgstr "  And yet, he was still unable to focus on the class."

#. Occurrence 2_1:613:2147: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0004; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:613
msgctxt "text_id=2147 | speaker=soujuurou"
msgid "『…………むう』"
msgstr "(...Ugh.)"

#. Occurrence 2_1:618:2148: scene=2_1
#: 2_1:618
msgctxt "text_id=2148 | speaker=unknown"
msgid "　重いため息をついて草十郎なりに考える。"
msgstr "  Soujyuro reflected silently as was his custom, and sighed inwardly."

#. Occurrence 2_1:623:2149: scene=2_1
#: 2_1:623
msgctxt "text_id=2149 | speaker=unknown"
msgid "　あまり考えたくはないが、原因は、まあ。"
msgstr "  Deep down he knew the real source of his agitation."

#. Occurrence 2_1:630:2150: scene=2_1
#: 2_1:630
msgctxt "text_id=2150 | speaker=unknown"
msgid "　思い返すたびにどうかと思う、昨夜の出来事以外ありえなかった。"
msgstr "  The events of the previous night were the only thing it could be."

#. Occurrence 2_1:686:2151: scene=2_1
#: 2_1:686
msgctxt "text_id=2151 | speaker=unknown"
msgid "　授業の終わりを告げるチャイムと、礼をして廊下に向かう老教師。"
msgstr "  With the chime to signal the end of class, the teacher bowed and exited into the hallway."

#. Occurrence 2_1:691:2152: scene=2_1
#: 2_1:691
msgctxt "text_id=2152 | speaker=unknown"
msgid "　彼の退室を見届けて、三十人もの生徒は一斉に席を立った。"
msgstr "  To see him off, the thirty or so students all stood up from their desks."

#. Occurrence 2_1:696:2153: scene=2_1
#: 2_1:696
msgctxt "text_id=2153 | speaker=unknown"
msgid "　11時半ごろから緩慢に進んでいた時計の針は、いまやピッタリと頂点を指し示している。"
msgstr "  The clock, which had seemed to slow dramatically around half-past eleven, now struck noon."

#. Occurrence 2_1:744:2154: scene=2_1
#: 2_1:744
msgctxt "text_id=2154 | speaker=unknown"
msgid "　ざあ、と<伝播|でんぱ>していく憩いの空気。"
msgstr "  The tension seemed to fade from the room all at once."

#. Occurrence 2_1:749:2155: scene=2_1
#: 2_1:749
msgctxt "text_id=2155 | speaker=unknown"
msgid "　堅苦しい授業からのひとときの解放、"
msgstr "  The release from a difficult lesson"

#. Occurrence 2_1:754:2156: scene=2_1
#: 2_1:754
msgctxt "text_id=2156 | speaker=unknown"
msgid "　学園生活の華ともいえる<昼食|ランチタイム>の始まりだ。"
msgstr "  was the start of lunchtime-the highlight of school life."

#. Occurrence 2_1:803:2157: scene=2_1
#: 2_1:803
msgctxt "text_id=2157 | speaker=unknown"
msgid "　三咲高校の学食の味つけはよろしくない。"
msgstr "  Misaki High's cafeteria was not particularly known for its quality of food."

#. Occurrence 2_1:808:2158: scene=2_1
#: 2_1:808
msgctxt "text_id=2158 | speaker=unknown"
msgid "　私立校にあるまじき怠慢、という抗議もどこ吹く風で、"
msgstr "  Complaints that the quality was below that of a private school went unheeded,"

#. Occurrence 2_1:813:2159: scene=2_1
#: 2_1:813
msgctxt "text_id=2159 | speaker=unknown"
msgid "　今日も今日とて独特の味を提供している。"
msgstr "  and the same \"unique\" flavors appeared on the menu each and every day."

#. Occurrence 2_1:818:2160: scene=2_1
#: 2_1:818
msgctxt "text_id=2160 | speaker=unknown"
msgid "　値段もそれなり、味もいまいち、となれば、必然、学校ではお弁当派が大勢力となる。"
msgstr "  Private school prices coupled with subpar quality led the majority of students to opt for boxed lunches instead."

#. Occurrence 2_1:852:2161: scene=2_1
#: 2_1:852
msgctxt "text_id=2161 | speaker=unknown"
msgid "　草十郎が転入した二年Ｃ組も例外ではない。"
msgstr "  Soujyuro's Class 2-C was no exception."

#. Occurrence 2_1:857:2162: scene=2_1
#: 2_1:857
msgctxt "text_id=2162 | speaker=unknown"
msgid "　男子は腕力にまかせて十個ほどの机をあわせ、長テーブルのような食卓を築く。"
msgstr "  The boys muscled as many as ten desks into what resembled a long dining table."

#. Occurrence 2_1:862:2163: scene=2_1
#: 2_1:862
msgctxt "text_id=2163 | speaker=unknown"
msgid "　一方、女子は洗練された手順で二、三個の机をこぢんまりとしたテーブルにかえ、いくつかのグループにわかれて談笑を始めていた。"
msgstr "  Conversely, the girls divided themselves into smaller tables of two or three desks with practiced ease, and started chatting within their cliques."

#. Occurrence 2_1:894:2164: scene=2_1
#: 2_1:894
msgctxt "text_id=2164 | speaker=unknown"
msgid "　貴重な昼休みを一分一秒も無駄にしない。"
msgstr "  Not a single student wasted even a second of their precious lunchtime."

#. Occurrence 2_1:899:2165: scene=2_1
#: 2_1:899
msgctxt "text_id=2165 | speaker=unknown"
msgid "　かたちは違えど、両陣営の信念は同じだった。"
msgstr "  Where both sides differed in method, they shared a common goal."

#. Occurrence 2_1:951:2166: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0005; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:951
msgctxt "text_id=2166 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 2_1:956:2167: scene=2_1
#: 2_1:956
msgctxt "text_id=2167 | speaker=unknown"
msgid "　その手際の良さに草十郎は呆気に取られている。"
msgstr "  Soujyuro was struck dumb by the efficiency of the transformation."

#. Occurrence 2_1:961:2168: scene=2_1
#: 2_1:961
msgctxt "text_id=2168 | speaker=unknown"
msgid "　転入してから十日経った今でもこのスピーディーさについていけず、いまだ自分の席に居座っていた。"
msgstr "  Even after ten days, he was unable to keep pace with the rest of the class and remained seated where he had sat during the previous period."

#. Occurrence 2_1:983:2169: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_2_1_0000; voice_prefix=B50; voice_category=6; scene=2_1
#: 2_1:983
msgctxt "text_id=2169 | speaker=kinomi"
msgid "「おーい、こっちこいよ静希！」"
msgstr "\"Hey, Sizuki! Over here!\""

#. Occurrence 2_1:994:2170: scene=2_1
#: 2_1:994
msgctxt "text_id=2170 | speaker=unknown"
msgid "　呼びかけてくる声は、教室の窓側を占拠した一大食卓からだった。"
msgstr "  The voice came from the large makeshift dining table near the window."

#. Occurrence 2_1:1036:2171: scene=2_1
#: 2_1:1036
msgctxt "text_id=2171 | speaker=unknown"
msgid "　だらしなく椅子をななめに立て、いつスッ<転|ころ>んでもおかしくない状態で手招きしているのは<木|き><乃|の><美|み><芳助|ほうすけ>。"
msgstr "  Housuke Kinomi was beckoning him over while leaning back in his chair in a way that looked like he could fall backward at any second."

#. Occurrence 2_1:1041:2172: scene=2_1
#: 2_1:1041
msgctxt "text_id=2172 | speaker=unknown"
msgid "　口が悪くて根性も無い、とクラス中から<酷評|こくひょう>される人物だが、さっぱりした性格のおかげか敵は少ない。"
msgstr "  He was regularly shot down by others in the class for being lazy and crass, but his earnest nature kept him from getting on anyone's bad side."

#. Occurrence 2_1:1046:2173: scene=2_1
#: 2_1:1046
msgctxt "text_id=2173 | speaker=unknown"
msgid "　たまに、さっぱりしすぎるのもどうか、とみなの頭を悩ませてもいる。"
msgstr "  Though something could be said for not being so forthcoming all the time, too."

#. Occurrence 2_1:1082:2174: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_2_1_0001; voice_prefix=B50; voice_category=6; scene=2_1
#: 2_1:1082
msgctxt "text_id=2174 | speaker=kinomi"
msgid "「メシにしようぜメシぃ。"
msgstr "\"Times-a-wastin'! Let's eat!"

#. Occurrence 2_1:1088:2175: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_2_1_0002; voice_prefix=B50; voice_category=6; scene=2_1
#: 2_1:1088
msgctxt "text_id=2175 | speaker=kinomi"
msgid "　オレさあ、昨日店の残り物もらいすぎたんだよ。春巻だよ春巻。それを見た親父がさあ、貰ったモンは残すなってうるさくてさあ。食いもん、春巻きしかねーんだわ」"
msgstr "  I've got a bunch of leftover spring rolls from yesterday, but when my dad saw 'em, he told me I shouldn't waste 'em, so that's the only thing I've got.\""

#. Occurrence 2_1:1113:2176: scene=2_1
#: 2_1:1113
msgctxt "text_id=2176 | speaker=unknown"
msgid "　なので救いの手を差し向けてくれ、とまっとうな弁当を呼びこもうと企む木乃美だった。"
msgstr "  It seemed his end game was to find someone who might take pity on him and trade him for something better."

#. Occurrence 2_1:1118:2177: scene=2_1
#: 2_1:1118
msgctxt "text_id=2177 | speaker=unknown"
msgid "　木乃美と草十郎は同じ店で働いており、転入前から顔見知りだった数少ないアルバイト仲間だ。"
msgstr "  The two of them worked at the same restaurant, so he was one of the few people Soujyuro knew before starting school."

#. Occurrence 2_1:1123:2178: scene=2_1
#: 2_1:1123
msgctxt "text_id=2178 | speaker=unknown"
msgid "　また、草十郎に『腐れ縁』という言葉をはじめて実感させた男でもある。"
msgstr "  He was also the reason Soujyuro was able to learn the true meaning of the phrase \"can't live with them, can't live without them.\""

#. Occurrence 2_1:1164:2179: voice_id=E20_2_1_0000; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1164
msgctxt "text_id=2179 | speaker=unknown"
msgid "「お、いいな、静希も来いよー！　今日は待ちに待った缶詰祭りをすっからさー！」"
msgstr "\"Yeah, Sizuki! Get your butt over here! It's the long-awaited Canned Food Festival today!\""

#. Occurrence 2_1:1170:2180: voice_id=E30_2_1_0000; voice_prefix=E30; voice_category=0; scene=2_1
#: 2_1:1170
msgctxt "text_id=2180 | speaker=unknown"
msgid "「……ついに決行するのかよ……誰か冷静になった方がいいんじゃないのか、実際……」"
msgstr "\"So we're really going through with this? We're absolutely sure we wanna do this?\""

#. Occurrence 2_1:1176:2181: voice_id=E20_2_1_9000; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1176
msgctxt "text_id=2181 | speaker=unknown"
msgid "「バカ、すげえ楽しいってきっと！　そりゃパチもんくさいけどカニ缶とか食い放題なんだぜ!?　サバ缶じゃなくて！」"
msgstr "\"You bet your ass we are! Sure, the stuff is processed to hell, but all the canned crab you can eat?! This ain't no sardines in a can, dude!\""

#. Occurrence 2_1:1224:2182: voice_id=E40_2_1_9000; voice_prefix=E40; voice_category=0; scene=2_1
#: 2_1:1224
msgctxt "text_id=2182 | speaker=unknown"
msgid "「まじ！？　やったー、オレも参加するー！"
msgstr "\"You for real?! Then hell yeah! Count me in!"

#. Occurrence 2_1:1224:2183: voice_id=E40_2_1_9000; voice_prefix=E40; voice_category=0; scene=2_1
#: 2_1:1224
msgctxt "text_id=2183 | speaker=unknown"
msgid "　コンビーフはひとり一個？　それとも早い者勝ち？」"
msgstr "  Is there enough corned beef for everyone? Or is it first come, first served?\""

#. Occurrence 2_1:1238:2184: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_2_1_0003; voice_prefix=B50; voice_category=6; scene=2_1
#: 2_1:1238
msgctxt "text_id=2184 | speaker=kinomi"
msgid "「おまえな、ひとりで何個も食えるもんじゃねえぞアレ。うまいのは最初の一個だけだって」"
msgstr "\"That's not somethin' you can eat a ton of, ya know. Only the first can tastes any good.\""

#. Occurrence 2_1:1244:2185: voice_id=E30_2_1_0001; voice_prefix=E30; voice_category=0; scene=2_1
#: 2_1:1244
msgctxt "text_id=2185 | speaker=unknown"
msgid "「静希たちがくるならノルマはひとり七個に下がるのか……助かるなあ……」"
msgstr "\"With Sizuki on board, we'd be at an even seven cans a piece. What a lifesaver...\""

#. Occurrence 2_1:1250:2186: voice_id=E50_2_1_0001; voice_prefix=E50; voice_category=0; scene=2_1
#: 2_1:1250
msgctxt "text_id=2186 | speaker=unknown"
msgid "「ところで木乃美の弁当の中身、なんか缶詰より硬そうじゃね？」"
msgstr "\"So what's up with your lunch, Kinomi? It looks harder than the cans.\""

#. Occurrence 2_1:1278:2187: scene=2_1
#: 2_1:1278
msgctxt "text_id=2187 | speaker=unknown"
msgid "　いつもは互いの弁当の不出来さをネタにして騒ぐ彼らは、今日に限って団結していた。"
msgstr "  The boys usually passed the time by making fun of each other's lunches, but today they were united against a common foe."

#. Occurrence 2_1:1289:2188: scene=2_1
#: 2_1:1289
msgctxt "text_id=2188 | speaker=unknown"
msgid "　テーブルにはピラミッド型につまれた無数の缶詰。"
msgstr "  A pyramid of countless cans stood in the middle of the table."

#. Occurrence 2_1:1294:2189: scene=2_1
#: 2_1:1294
msgctxt "text_id=2189 | speaker=unknown"
msgid "　賞味期限を油性のサインペンで塗りつぶされたソレは、ある男子生徒の家の倉庫から発掘されたものらしい。"
msgstr "  They had all been taken from the pantry of a certain student's house, and the expiration dates on them had all been scribbled out with a marker."

#. Occurrence 2_1:1332:2190: voice_id=E20_2_1_0001; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1332
msgctxt "text_id=2190 | speaker=unknown"
msgid "「よし野郎ども、各自マイ缶切りの用意はいいな？"
msgstr "\"All right, lads. Everyone got your can openers?"

#. Occurrence 2_1:1338:2191: voice_id=E20_2_1_0002; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1338
msgctxt "text_id=2191 | speaker=unknown"
msgid "　食べるも地獄、残すも地獄。我ら五時限目の授業はないものと恐れぬ修羅となり、鉄の悪魔どもを平らげん―――"
msgstr "  Eating them sucks! No one likes leftovers! But these metal demons must be slain at all costs, even if it means missing fifth period!"

#. Occurrence 2_1:1344:2192: voice_id=E20_2_1_0003; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1344
msgctxt "text_id=2192 | speaker=unknown"
msgid "　えー、食材は下町のなんでも商会、マーケット中山からの提供です！」"
msgstr "  Oh, and a special thanks to our sponsors, Downtown McCoy and Nakayama Market!\""

#. Occurrence 2_1:1384:2193: voice_id=E40_2_1_0001; voice_prefix=E40; voice_category=0; scene=2_1
#: 2_1:1384
msgctxt "text_id=2193 | speaker=unknown"
msgid "「ヒュー！　バカも休み休みyeah！」"
msgstr "\"Yeah, baby! Let's eat!\""

#. Occurrence 2_1:1389:2194: scene=2_1
#: 2_1:1389
msgctxt "text_id=2194 | speaker=unknown"
msgid "　一団となって、缶切りを持った手を天高く掲げる男子生徒の群れ。"
msgstr "  The boys united as one and hoisted their can openers into the air."

#. Occurrence 2_1:1454:2195: voice_id=E20_2_1_0004; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1454
msgctxt "text_id=2195 | speaker=unknown"
msgid "「ほら、静希も食べようぜー。缶切りならまだあるからさー」"
msgstr "\"Eat up, Sizuki! There's enough can openers to go around!\""

#. Occurrence 2_1:1466:2196: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0006; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:1466
msgctxt "text_id=2196 | speaker=soujuurou"
msgid "「いや、君らの弁当の毒見はゴメンだって昨日言ったはずだ。"
msgstr "\"I thought I told you yesterday that I'm not interested in being your taste tester."

#. Occurrence 2_1:1472:2197: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0007; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:1472
msgctxt "text_id=2197 | speaker=soujuurou"
msgid "　それに、その缶詰半分以上、賞味期限切れてるだろう」"
msgstr "  And besides, at least half of those cans are past their expiration date.\""

#. Occurrence 2_1:1478:2198: voice_id=E20_2_1_0005; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1478
msgctxt "text_id=2198 | speaker=unknown"
msgid "「なんだよー、つれねえなあー！」"
msgstr "\"Oh, c'mon! Live a little!\""

#. Occurrence 2_1:1489:2199: scene=2_1
#: 2_1:1489
msgctxt "text_id=2199 | speaker=unknown"
msgid "　どっと沸くならず者たち。"
msgstr "  Quite an inexplicably excited group of guys."

#. Occurrence 2_1:1494:2200: scene=2_1
#: 2_1:1494
msgctxt "text_id=2200 | speaker=unknown"
msgid "　<犠牲者|なかま>を一人でも増やそうと思っているに違いない。"
msgstr "  Their real motivation seemed to be to spread the pain."

#. Occurrence 2_1:1540:2201: scene=2_1
#: 2_1:1540
msgctxt "text_id=2201 | speaker=unknown"
msgid "　彼らの賑やかさにほだされ、仕方ない、と席を立つ草十郎。"
msgstr "  But moved by their energy and conceding defeat, Soujyuro got up from his seat and joined them."

#. Occurrence 2_1:1545:2202: scene=2_1
#: 2_1:1545
msgctxt "text_id=2202 | speaker=unknown"
msgid "　それを、"
msgstr "  And before he could..."

#. Occurrence 2_1:1552:2203: voice_id=D90_2_1_0000; voice_prefix=D90; voice_category=0; scene=2_1
#: 2_1:1552
msgctxt "text_id=2203 | speaker=unknown"
msgid "「じゃ、わたしたちが釣り上げよっかなー！"
msgstr "\"Hey! Give it a rest, why don't you?"

#. Occurrence 2_1:1558:2204: voice_id=D90_2_1_0001; voice_prefix=D90; voice_category=0; scene=2_1
#: 2_1:1558
msgctxt "text_id=2204 | speaker=unknown"
msgid "　静希くん、あんなの放っておいて一緒にどう？」"
msgstr "  Forget them, Sizuki! Come eat with us!\""

#. Occurrence 2_1:1564:2205: scene=2_1
#: 2_1:1564
msgctxt "text_id=2205 | speaker=unknown"
msgid "　もう一方の勢力がつかまえた。"
msgstr "  Another interested party joined the fray."

#. Occurrence 2_1:1584:2206: scene=2_1
#: 2_1:1584
msgctxt "text_id=2206 | speaker=unknown"
msgid "　呼び掛けたのはショートの髪がよく似合う女生徒だった。"
msgstr "  A girl with short but stylish hair had called out to him."

#. Occurrence 2_1:1589:2207: scene=2_1
#: 2_1:1589
msgctxt "text_id=2207 | speaker=unknown"
msgid "　数日前、草十郎を陸上部に勧誘してくれた事もある。"
msgstr "  She had also tried to get Soujyuro to join the track and field club several days earlier."

#. Occurrence 2_1:1630:2208: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0008; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:1630
msgctxt "text_id=2208 | speaker=soujuurou"
msgid "「……いや。そっちも遠慮したいな、できれば」"
msgstr "\"...Um, thanks for the offer, but I'd rather not.\""

#. Occurrence 2_1:1635:2209: scene=2_1
#: 2_1:1635
msgctxt "text_id=2209 | speaker=unknown"
msgid "　困り顔で返答する。"
msgstr "  He answered with a troubled look on his face."

#. Occurrence 2_1:1640:2210: scene=2_1
#: 2_1:1640
msgctxt "text_id=2210 | speaker=unknown"
msgid "　彼女達のテーブルには草十郎があまり知らない果実<だ|・><け|・>が山のようにつまれていた。"
msgstr "  On their table was nothing but a pile of fruit Soujyuro had never seen before."

#. Occurrence 2_1:1666:2211: voice_id=E10_2_1_0000; voice_prefix=E10; voice_category=0; scene=2_1
#: 2_1:1666
msgctxt "text_id=2211 | speaker=unknown"
msgid "「えー、なんでー？　パパイヤとか嫌い？"
msgstr "\"What? Whyyy? You don't like papayas?"

#. Occurrence 2_1:1666:2212: voice_id=E10_2_1_0000; voice_prefix=E10; voice_category=0; scene=2_1
#: 2_1:1666
msgctxt "text_id=2212 | speaker=unknown"
msgid "　マンゴーもあるし、ヤシの実だってあるし、内緒だけど夕張メロンもあるんだから！」"
msgstr "  We've got mango and coconut if you want something else! And don't tell anyone, but we've even got a Yubari melon!\""

#. Occurrence 2_1:1671:2213: scene=2_1
#: 2_1:1671
msgctxt "text_id=2213 | speaker=unknown"
msgid "　拳を立てて力説する果実グループ。"
msgstr "  The members of the fruit group pumped their fists in unison at that last delicacy."

#. Occurrence 2_1:1705:2214: voice_id=E20_2_1_0006; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1705
msgctxt "text_id=2214 | speaker=unknown"
msgid "「待て、なんだヤシの実って？　アレ食えるもんなの？」"
msgstr "\"Wait, coconuts? Can you even eat those?\""

#. Occurrence 2_1:1711:2215: voice_id=E30_2_1_0002; voice_prefix=E30; voice_category=0; scene=2_1
#: 2_1:1711
msgctxt "text_id=2215 | speaker=unknown"
msgid "「あ、マンゴー余ったら回してほしいなー」"
msgstr "\"Umm, I'd like a mango if you have any extra.\""

#. Occurrence 2_1:1717:2216: voice_id=E40_2_1_0002; voice_prefix=E40; voice_category=0; scene=2_1
#: 2_1:1717
msgctxt "text_id=2216 | speaker=unknown"
msgid "「ばか、肉食え肉。そんなんだから貧弱な体してんだぞ、おまえら！」"
msgstr "\"Idiots! Meat! MEEEAT! Eatin' anything else is just gonna make ya weak!\""

#. Occurrence 2_1:1722:2217: scene=2_1
#: 2_1:1722
msgctxt "text_id=2217 | speaker=unknown"
msgid "　飛びかう声に、やっぱり草十郎はついていけない。"
msgstr "  Soujyuro couldn't keep track of all of the voices flying across the room."

#. Occurrence 2_1:1755:2218: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0009; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:1755
msgctxt "text_id=2218 | speaker=soujuurou"
msgid "「……分かるのは、どっちも破滅的だってコトだけだ」"
msgstr "\"All I know is that nothing good will come out of either of these choices.\""

#. Occurrence 2_1:1761:2219: scene=2_1
#: 2_1:1761
msgctxt "text_id=2219 | speaker=unknown"
msgid "　言いつつ、草十郎はどちらも断りきれない。"
msgstr "  That being said, he found it difficult to refuse them outright."

#. Occurrence 2_1:1766:2220: scene=2_1
#: 2_1:1766
msgctxt "text_id=2220 | speaker=unknown"
msgid "　他人の好意を素直に受け取りすぎる彼は、時に優柔不断になる。"
msgstr "  His tendency to accept others' goodwill at face value occasionally left him frozen with indecision."

#. Occurrence 2_1:1771:2221: scene=2_1
#: 2_1:1771
msgctxt "text_id=2221 | speaker=unknown"
msgid "　人間、好意になれていないと、何を捨てるべきか咄嗟に判断できないのである。"
msgstr "  Not accustomed to regular human interaction, he was unable to judge when it was or was not appropriate to turn someone down."

#. Occurrence 2_1:1776:2222: scene=2_1
#: 2_1:1776
msgctxt "text_id=2222 | speaker=unknown"
msgid "　そんな迷える子羊の肩を叩く影がひとつ。"
msgstr "  Someone tapped the lost, little lamb on the shoulder."

#. Occurrence 2_1:1813:2223: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0000; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:1813
msgctxt "text_id=2223 | speaker=tobimaru"
msgid "「ほっとけほっとけ。いちいちここのバカどもに付き合ってちゃ人生台無しだ。適当に流しとけばいいんだよ。"
msgstr "\"Don't mind them. If you get involved with every idiot who invites you to do something, you'll mess up your whole life. It's okay to turn them down, you know."

#. Occurrence 2_1:1819:2224: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0001; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:1819
msgctxt "text_id=2224 | speaker=tobimaru"
msgid "　オラ、おまえらもな、善良な羊を悪の園に引きずりこんでんじゃねえよ」"
msgstr "  And you guys... Stop trying to lead this good soul over to the dark side!\""

#. Occurrence 2_1:1825:2225: scene=2_1
#: 2_1:1825
msgctxt "text_id=2225 | speaker=unknown"
msgid "　場違いにドスのきいた声が、草十郎の背後から教室に響きわたる。"
msgstr "  An inappropriately loud voice echoed throughout the classroom from behind him."

#. Occurrence 2_1:1861:2226: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0010; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:1861
msgctxt "text_id=2226 | speaker=soujuurou"
msgid "「副会長」"
msgstr "\"Vice president.\""

#. Occurrence 2_1:1866:2227: scene=2_1
#: 2_1:1866
msgctxt "text_id=2227 | speaker=unknown"
msgid "　草十郎が振り向くと、そこには彼より頭ひとつぶん背の高い男子生徒が立っていた。"
msgstr "  Soujyuro turned around to see a boy about a head taller than him."

#. Occurrence 2_1:1900:2228: scene=2_1
#: 2_1:1900
msgctxt "text_id=2228 | speaker=unknown"
msgid "　乱雑に、けれど見栄えよく撫で上げられた長髪。"
msgstr "  His long hair, while unkempt, had been brushed back, giving it an appealingly windswept look."

#. Occurrence 2_1:1905:2229: scene=2_1
#: 2_1:1905
msgctxt "text_id=2229 | speaker=unknown"
msgid "　整った美形でありながら刺々しい目つきでクラスを<睥睨|へいげい>する暴力性。"
msgstr "  His attractive features belied the contempt for the classroom his eyes carried."

#. Occurrence 2_1:1910:2230: scene=2_1
#: 2_1:1910
msgctxt "text_id=2230 | speaker=unknown"
msgid "　いつも眠そうな草十郎とは対照的な、一目で人を魅了する非の打ちどころのない美男子。"
msgstr "  Unlike the perpetually dopey-looking Soujyuro, he was an extremely attractive boy, capable of captivating anyone who so much as glanced at him."

#. Occurrence 2_1:1915:2231: scene=2_1
#: 2_1:1915
msgctxt "text_id=2231 | speaker=unknown"
msgid "　誰もが<畏|おそ>れ、<敬|うやま>うであろう彼への反応は、しかし。"
msgstr "  In most cases, such a boy's presence would be met with awe and respect. However..."

#. Occurrence 2_1:1948:2232: voice_id=E20_2_1_0007; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:1948
msgctxt "text_id=2232 | speaker=unknown"
msgid "「なんだよ、副会長さまのお出ましかよー！」"
msgstr "\"Oh look! Our mighty vice president has graciously decided to pay us a visit!\""

#. Occurrence 2_1:1954:2233: voice_id=E30_2_1_0003; voice_prefix=E30; voice_category=0; scene=2_1
#: 2_1:1954
msgctxt "text_id=2233 | speaker=unknown"
msgid "「テメエらのバカ顔にはこりごりだって、学食に陣取ってたんじゃなかったのかよー！」"
msgstr "\"I thought you were going to take up residence in the cafeteria so you wouldn't have to see our stupid faces anymore!\""

#. Occurrence 2_1:1960:2234: voice_id=E40_2_1_0003; voice_prefix=E40; voice_category=0; scene=2_1
#: 2_1:1960
msgctxt "text_id=2234 | speaker=unknown"
msgid "「へへへ、ここは見てのとおりボンクラどもが集う貧民街でございますよ、王子はほら、Ａ組のきれいどころとカフェでお茶でもしてればいいじゃない！」"
msgstr "\"Hehehe, have you lost your way, Your Highness? You're slumming where the commoners eat gruel from their troughs. Shouldn't you be sipping tea with the babes from Class A?\""

#. Occurrence 2_1:2003:2235: voice_id=E50_2_1_0002; voice_prefix=E50; voice_category=0; scene=2_1
#: 2_1:2003
msgctxt "text_id=2235 | speaker=unknown"
msgid "「また静希呼びに来たのかよ。青子女史といい鳶丸殿下といい、静希、なんかヤバいコトしちゃったのか……？」"
msgstr "\"Why don't you leave Sizuki alone, huh? First Lady Aoko has it in for him, now His Highness too! What could he have done to have earned the attention of such royalty?\""

#. Occurrence 2_1:2009:2236: voice_id=D90_2_1_0002; voice_prefix=D90; voice_category=0; scene=2_1
#: 2_1:2009
msgctxt "text_id=2236 | speaker=unknown"
msgid "「えー。静希くんは校則違反しないじゃん。"
msgstr "\"Really?! But Sizuki's such a goody-two-shoes! He's never broken any rules!"

#. Occurrence 2_1:2009:2237: voice_id=D90_2_1_0002; voice_prefix=D90; voice_category=0; scene=2_1
#: 2_1:2009
msgctxt "text_id=2237 | speaker=unknown"
msgid "　ちょっと、それ以外のルール破るだけで！」"
msgstr "  Well, the rules of the school at least!\""

#. Occurrence 2_1:2015:2238: voice_id=E10_2_1_0001; voice_prefix=E10; voice_category=0; scene=2_1
#: 2_1:2015
msgctxt "text_id=2238 | speaker=unknown"
msgid "「ってコトはやっぱり―――<槻司|つきじ>くん、蒼崎に振られてからそっちに走ったって本当だったのね!?」"
msgstr "\"Wait, could it be that...Tsukiji really switched teams after Aozaki rejected him!?\""

#. Occurrence 2_1:2050:2239: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_1_0011; voice_prefix=A30; voice_category=3; scene=2_1
#: 2_1:2050
msgctxt "text_id=2239 | speaker=soujuurou"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 2_1:2055:2240: scene=2_1
#: 2_1:2055
msgctxt "text_id=2240 | speaker=unknown"
msgid "　この通り、親愛と友情に満ちた暴言だった。"
msgstr "  They continued to give him a hard time."

#. Occurrence 2_1:2066:2241: scene=2_1
#: 2_1:2066
msgctxt "text_id=2241 | speaker=unknown"
msgid "　言われたい放題の男子に、草十郎はつい同情してしまう。"
msgstr "  Soujyuro could not help but feel sorry for him."

#. Occurrence 2_1:2071:2242: scene=2_1
#: 2_1:2071
msgctxt "text_id=2242 | speaker=unknown"
msgid "　もっとも、肝心の男子はまったくのノーリアクション。"
msgstr "  The class vice president, on the other hand, showed absolutely no reaction whatsoever."

#. Occurrence 2_1:2076:2243: scene=2_1
#: 2_1:2076
msgctxt "text_id=2243 | speaker=unknown"
msgid "　騒ぎ立てる彼らをつまらなげに<一瞥|いちべつ>すると、吐き捨てるように声をあげる。"
msgstr "  He glared at them with a bored look and simply raised his voice."

#. Occurrence 2_1:2116:2244: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0002; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2116
msgctxt "text_id=2244 | speaker=tobimaru"
msgid "「相変わらず無駄に元気があって結構じゃねえかテメエら。"
msgstr "\"You freaks should get some new material."

#. Occurrence 2_1:2123:2245: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0003; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2123
msgctxt "text_id=2245 | speaker=tobimaru"
msgid "　そんなに活力たぎってんなら冬期特別清掃班にだって参加出来るよなあ、"
msgstr "  Why don't you spend your time more productively for once? Like helping with the Special Winter Cleaning Team."

msgctxt "text_id=2246 | speaker=unknown"
msgid "オイ？"
msgstr " Yeah, you heard me."

#. Occurrence 2_1:2134:2247: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0004; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2134
msgctxt "text_id=2247 | speaker=tobimaru"
msgid "　いまんところ自主的に申し出てるのは全校で一人しかいねえんだ。２－Ｃ全員が参加すりゃあ、俺も蒼崎も肩の荷がおりるってもんなんだがよ……！」"
msgstr "  Only one student in the entire school has signed up so far! Having all of Class C with us would be a huge help, but I guess you want me and Aozaki to do all the work!\""

#. Occurrence 2_1:2169:2248: scene=2_1
#: 2_1:2169
msgctxt "text_id=2248 | speaker=unknown"
msgid "　その端整な顔立ちとはかけ離れた、ドスのきいた<胴間|どうま>声が教室に響く。"
msgstr "  The menacing growl in his voice contrasted greatly with the boy's well-constructed looks."

#. Occurrence 2_1:2174:2249: scene=2_1
#: 2_1:2174
msgctxt "text_id=2249 | speaker=unknown"
msgid "　彼の一喝で水を打ったように黙りこむ、ならず者部隊＆スイーツ愛好者たち。"
msgstr "  Both Team Canned and Team Fruit's words were doused like a fire being smothered. "

#. Occurrence 2_1:2179:2250: scene=2_1
#: 2_1:2179
msgctxt "text_id=2250 | speaker=unknown"
msgid "　この男子生徒を畏怖しての事もあるが、何より『冬期特別清掃班』が恐ろしいからである。"
msgstr "  This was partly due to their fear of the boy, but mostly due to their fear of the Special Winter Cleaning Team."

#. Occurrence 2_1:2199:2251: scene=2_1
#: 2_1:2199
msgctxt "text_id=2251 | speaker=unknown"
msgid "　冬期特別清掃班。"
msgstr "  Yes, the Special Winter Cleaning Team."

#. Occurrence 2_1:2204:2252: scene=2_1
#: 2_1:2204
msgctxt "text_id=2252 | speaker=unknown"
msgid "　それは先々代の生徒会からお手上げ状態で放置していた旧校舎、および山みたいな裏庭の森を冬休みを挙げて清掃しよう、という趣旨の、学園行事の名を借りた拷問だ。"
msgstr "  Joining meant spending part of your winter break cleaning up the old school building and mountainous rear courtyard that had been neglected by the previous two student councils."

#. Occurrence 2_1:2224:2253: scene=2_1
#: 2_1:2224
msgctxt "text_id=2253 | speaker=unknown"
msgid "　おそらく、冬休みのうち三日は完全に潰される。"
msgstr "  It was a form of legalized torture that could potentially ruin three whole days of your winter break."

#. Occurrence 2_1:2229:2254: scene=2_1
#: 2_1:2229
msgctxt "text_id=2254 | speaker=unknown"
msgid "　もちろん成績に残るような見返りはない。"
msgstr "  And forget about any compensation in the form of extra credits."

#. Occurrence 2_1:2234:2255: scene=2_1
#: 2_1:2234
msgctxt "text_id=2255 | speaker=unknown"
msgid "　ことはあくまで生徒会が立案しただけのボランティア。参加希望者が一人でもいたコトは奇跡に近い。"
msgstr "  No, it was pointless volunteer work for a student council project. It was practically a miracle that they had found even a single volunteer."

#. Occurrence 2_1:2269:2256: voice_id=E20_2_1_0008; voice_prefix=E20; voice_category=0; scene=2_1
#: 2_1:2269
msgctxt "text_id=2256 | speaker=unknown"
msgid "「あー……いや、僕ら、ちょっと体弱いんで……すみっちょで缶詰食べてますね？」"
msgstr "\"Umm... sorry, but we're clearly... not fit enough... yeah, that's it. That stuff takes conditioning. We'll just eat our canned food in the corner now, okay?\""

#. Occurrence 2_1:2275:2257: voice_id=D90_2_1_0003; voice_prefix=D90; voice_category=0; scene=2_1
#: 2_1:2275
msgctxt "text_id=2257 | speaker=unknown"
msgid "「わたしたちも貧血気味で……こうやって果物たべてないと死んじゃうっていうか……冬休みはもう予定いっぱいっていうか……」"
msgstr "\"Yeah, us, too. We're uh... anemic, you see... and if we don't eat this fruit, we'll, uh, die. That, and we already have plans, or something.\""

#. Occurrence 2_1:2292:2258: scene=2_1
#: 2_1:2292
msgctxt "text_id=2258 | speaker=unknown"
msgid "　一名を除いて、そそくさと隅に移動する２年Ｃ組の皆さん。"
msgstr "  All of the students but one scuffled away."

#. Occurrence 2_1:2318:2259: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0005; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2318
msgctxt "text_id=2259 | speaker=tobimaru"
msgid "「よし、昼食はやっぱり静かにやらねえとな。"
msgstr "\"That's much better. Lunchtime is best in silence."

#. Occurrence 2_1:2329:2260: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0006; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2329
msgctxt "text_id=2260 | speaker=tobimaru"
msgid "　一年坊主の教室より二年の教室の方がやかましいなんて苦情、いいかげんにしやがれよアホウども？」"
msgstr "  I'm tired of people complaining that you guys make even more noise than the freshmen. Get it together, you losers.\""

#. Occurrence 2_1:2354:2261: scene=2_1
#: 2_1:2354
msgctxt "text_id=2261 | speaker=unknown"
msgid "　うへーい、と弱々しく退散する有象無象たち。"
msgstr "  The mob meekly scurried away."

#. Occurrence 2_1:2359:2262: scene=2_1
#: 2_1:2359
msgctxt "text_id=2262 | speaker=unknown"
msgid "　その中に溶け込むように流れていく草十郎だったが、"
msgstr "  Soujyuro turned to join them, but as he did..."

#. Occurrence 2_1:2391:2263: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0007; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2391
msgctxt "text_id=2263 | speaker=tobimaru"
msgid "「おう、おまえはこっちだ草十郎。ちょい顔貸せ」"
msgstr "\"Hold on, Soujyuro. You're with me.\""

#. Occurrence 2_1:2397:2264: scene=2_1
#: 2_1:2397
msgctxt "text_id=2264 | speaker=unknown"
msgid "　強引に肩を引かれ、仲間入りを阻まれた。"
msgstr "  The hand on his shoulder held him in place."

#. Occurrence 2_1:2420:2265: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_2_1_0004; voice_prefix=B50; voice_category=6; scene=2_1
#: 2_1:2420
msgctxt "text_id=2265 | speaker=kinomi"
msgid "「……っだよ、生徒会横暴ー。人んちのテーブルマナーまで指図してほしくねーよなー！」"
msgstr "\"Jeez, who does the student council think they are, anyway? Barging into our classroom to lecture us on table manners!\""

#. Occurrence 2_1:2426:2266: scene=2_1
#: 2_1:2426
msgctxt "text_id=2266 | speaker=unknown"
msgid "　立ち去る背中を好機と見たのか、仲間うちでのみ聞こえるよう悪態をつく木乃美。"
msgstr "  Kinomi cursed him under his breath to his friends the second the vice president turned to go."

#. Occurrence 2_1:2459:2267: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0008; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2459
msgctxt "text_id=2267 | speaker=tobimaru"
msgid "「ああ？　上等じゃねえか木乃美、いいぜ、おまえが記念すべき二人目だ。冬休み、首を洗って待ってやがれ」"
msgstr "\"What was that, Kinomi? Oh! You wanna become our second volunteer? Perfect! I'll make it the best winter vacation you've ever had!\""

#. Occurrence 2_1:2465:2268: scene=2_1
#: 2_1:2465
msgctxt "text_id=2268 | speaker=unknown"
msgid "　きっかり聞こえていたのか、副会長は親指をたてて、ぐるん、と<一回転|ノックアウト>の意を示す。"
msgstr "  The vice president must have heard everything Kinomi said, because he gave a thumbs up before figuratively jabbing it in his eye."

#. Occurrence 2_1:2506:2269: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_2_1_0005; voice_prefix=B50; voice_category=6; scene=2_1
#: 2_1:2506
msgctxt "text_id=2269 | speaker=kinomi"
msgid "「はあ、なに言ってんですかアイツ？"
msgstr "\"Yo, is this guy for real?"

#. Occurrence 2_1:2512:2270: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_2_1_0006; voice_prefix=B50; voice_category=6; scene=2_1
#: 2_1:2512
msgctxt "text_id=2270 | speaker=kinomi"
msgid "　アレ自主的なイベントじゃん、いくら副会長ったって強制はできないですよねぇ!?」"
msgstr "  This is voluntary, isn't it? It ain't voluntary if you gotta force people to do it! Am I right?!\""

#. Occurrence 2_1:2518:2271: scene=2_1
#: 2_1:2518
msgctxt "text_id=2271 | speaker=unknown"
msgid "　ひひひ、と笑う２年Ｃ組の誇る問題児。"
msgstr "  The problem child of Class C laughed merrily."

#. Occurrence 2_1:2544:2272: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0009; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2544
msgctxt "text_id=2272 | speaker=tobimaru"
msgid "「そりゃ昨日までの話だ。"
msgstr "\"That was yesterday."

#. Occurrence 2_1:2550:2273: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0010; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2550
msgctxt "text_id=2273 | speaker=tobimaru"
msgid "　会長の提案が学校側に受理されてな、本日付けで生徒会役員は強制力のある推薦権をもらえたんだよ。"
msgstr "  The school has since accepted the president's proposal that council members be able to forcibly enlist students for participation."

#. Occurrence 2_1:2561:2274: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_1_0011; voice_prefix=B70; voice_category=4; scene=2_1
#: 2_1:2561
msgctxt "text_id=2274 | speaker=tobimaru"
msgid "　とくに会長と副会長の推薦は絶対だ。拒否した場合、学校側はともかく、蒼崎がなにするか俺には止められねえからそのつもりでな？」"
msgstr "  And recommendations by the president and vice president are ironclad. Refusing them means breaking school rules in addition to facing Aozaki's wrath, which, let me tell you now, I won't be able to stop.\""

#. Occurrence 2_1:2587:2275: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_2_1_0007; voice_prefix=B50; voice_category=6; scene=2_1
#: 2_1:2587
msgctxt "text_id=2275 | speaker=kinomi"
msgid "@o「げぇぇぇ!!!?　ちょ、それ事実上の死刑宣告じゃん!?　生徒^会まじ横暴ー！！！！」"
msgstr "\"Whaaat!? You're hanging me by my balls here! This is extortion, or blackmail, or something!\""

#. Occurrence 2_1:2610:2276: scene=2_1
#: 2_1:2610
msgctxt "text_id=2276 | speaker=unknown"
msgid "　悪態から悲鳴に変わる木乃美の断末魔を後に、副会長と草十郎は２年Ｃ組を後にした。"
msgstr "  Kinomi's terrified shrieking continued behind them as the vice president and Soujyuro left the classroom."

#. Occurrence 2_2:72:2277: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0000; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:72
msgctxt "text_id=2277 | speaker=tobimaru"
msgid "「おまえも大変だな、草十郎」"
msgstr "\"What am I going to do with you, Soujyuro?\""

#. Occurrence 2_2:78:2278: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0000; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:78
msgctxt "text_id=2278 | speaker=soujuurou"
msgid "「あんたもわりと暇なんだな、副会長」"
msgstr "\"With me? Aren't you busy with other things, vice president?\""

#. Occurrence 2_2:104:2279: scene=2_2
#: 2_2:104
msgctxt "text_id=2279 | speaker=unknown"
msgid "　無人の生徒会室に入るなり所感を口にするふたり。"
msgstr "  The two entered the empty student council room."

#. Occurrence 2_2:110:2280: scene=2_2
#: 2_2:110
msgctxt "text_id=2280 | speaker=unknown"
msgid "　三咲高校の生徒会室は二つあり、"
msgstr "  Misaki High's student council had the use of two rooms."

#. Occurrence 2_2:115:2281: scene=2_2
#: 2_2:115
msgctxt "text_id=2281 | speaker=unknown"
msgid "　一つは生徒会用に作られた大部屋、"
msgstr "  One was a large office specifically made for the student council."

#. Occurrence 2_2:120:2282: scene=2_2
#: 2_2:120
msgctxt "text_id=2282 | speaker=unknown"
msgid "　もう一つは数学の準備室だった資料室とに分かれている。"
msgstr "  The second was an archive room, once used as a preparatory office for math courses."

#. Occurrence 2_2:141:2283: scene=2_2
#: 2_2:141
msgctxt "text_id=2283 | speaker=unknown"
msgid "　こちらは資料室の方で、壁にはファイルのつまった資料棚がびっしりと並び、ただでさえ狭苦しい部屋を余計に窮屈に見せていた。"
msgstr "  As the latter of the two, the walls were lined with densely packed shelves, making an already cramped room seem even more confined."

#. Occurrence 2_2:148:2284: scene=2_2
#: 2_2:148
msgctxt "text_id=2284 | speaker=unknown"
msgid "　生徒会室というより、個人の隠れ家といった方が正しいだろう。"
msgstr "  For this reason, it served more as a private refuge to the student council."

#. Occurrence 2_2:153:2285: scene=2_2
#: 2_2:153
msgctxt "text_id=2285 | speaker=unknown"
msgid "　草十郎が椅子に座ると、向かい合うように男子生徒も腰を下ろした。"
msgstr "  The two students sat across from one another."

#. Occurrence 2_2:189:2286: scene=2_2
#: 2_2:189
msgctxt "text_id=2286 | speaker=unknown"
msgid "　<槻司|つきじ><鳶丸|とびまる>。"
msgstr "  Tobimaru Tsukiji."

#. Occurrence 2_2:194:2287: scene=2_2
#: 2_2:194
msgctxt "text_id=2287 | speaker=unknown"
msgid "　私立三咲高校の理事長の息子であり、生徒会副会長。"
msgstr "  He was the son of the chairman of Misaki High School and the vice president of its school council."

#. Occurrence 2_2:199:2288: scene=2_2
#: 2_2:199
msgctxt "text_id=2288 | speaker=unknown"
msgid "　学年は草十郎と同じく二年生で、約一週間前、転入生の世話を生徒会長に押しつけられてからの付き合いである。"
msgstr "  Like Soujyuro, he was in his second year, and first met the transfer student a week earlier when the task of looking after him was dumped onto the student council."

#. Occurrence 2_2:225:2289: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0001; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:225
msgctxt "text_id=2289 | speaker=tobimaru"
msgid "「副会長はやめろって。クソッタレな話だが、俺はしょせん会長の犬だからな」"
msgstr "\"I told you to stop calling me that. People may as well call me the president's dog, the shit I have to take from her.\""

#. Occurrence 2_2:231:2290: scene=2_2
#: 2_2:231
msgctxt "text_id=2290 | speaker=unknown"
msgid "　やれやれと自嘲するも、不満があるワケでもなさそうだ。"
msgstr "  As self-deprecating as his words were, he hardly seemed dissatisfied with the arrangement."

#. Occurrence 2_2:238:2291: scene=2_2
#: 2_2:238
msgctxt "text_id=2291 | speaker=unknown"
msgid "　鳶丸はポケットからスナック菓子を取りだし、実にまずそうに口に入れた。"
msgstr "  He took a snack from his pocket and grimaced at it before taking a bite."

#. Occurrence 2_2:250:2292: scene=2_2
#: 2_2:250
msgctxt "text_id=2292 | speaker=unknown"
msgid "　一本１００キロカロリーほどのブロック形式の簡易食を、それこそ干し肉を引きちぎるように片づけていく。"
msgstr "  The hundred-calorie energy bar sacrificed flavor for efficacy, but somehow not enough to prevent him gnawing on it like a piece of jerky."

#. Occurrence 2_2:303:2293: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0001; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:303
msgctxt "text_id=2293 | speaker=soujuurou"
msgid "「そうか。でも犬はよくないな、鳶丸」"
msgstr "\"I see what you're saying, Tobimaru, but being a dog isn't exactly a good thing.\""

#. Occurrence 2_2:345:2294: scene=2_2
#: 2_2:345
msgctxt "text_id=2294 | speaker=unknown"
msgid "　難しい顔つきで草十郎は椅子に座る。"
msgstr "  Soujyuro sat in the chair with a concerned look on his face."

#. Occurrence 2_2:356:2295: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0002; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:356
msgctxt "text_id=2295 | speaker=tobimaru"
msgid "「あん？　犬がどうしたって？」"
msgstr "\"Huh? What's wrong with dogs?\""

#. Occurrence 2_2:374:2296: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0002; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:374
msgctxt "text_id=2296 | speaker=soujuurou"
msgid "「犬はよくないって言った。喩えが違う気がするし、なにより怖いぞ、アレ」"
msgstr "\"Dogs aren't good. I mean, it's a bad comparison in the first place, but dogs are way scarier.\""

#. Occurrence 2_2:380:2297: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0003; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:380
msgctxt "text_id=2297 | speaker=tobimaru"
msgid "「？　なんだよ、山奥育ちのくせに犬が怖いのか？」"
msgstr "\"You grew up in the mountains, and you're still afraid of dogs?\""

#. Occurrence 2_2:406:2298: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0003; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:406
msgctxt "text_id=2298 | speaker=soujuurou"
msgid "「そりゃたいていの生き物は怖いけど、犬は別格だ。"
msgstr "\"I'm afraid of most animals, but dogs are in a class of their own."

#. Occurrence 2_2:412:2299: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0004; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:412
msgctxt "text_id=2299 | speaker=soujuurou"
msgid "　徒党を組んだ野犬ほど始末に負えないものはない。"
msgstr "  A pack of wild dogs is particularly terrifying."

#. Occurrence 2_2:418:2300: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0005; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:418
msgctxt "text_id=2300 | speaker=soujuurou"
msgid "　<脚|あし>の速さも脅威だけど、なにより執念深すぎる。"
msgstr "  They're as tenacious as they are fast."

#. Occurrence 2_2:429:2301: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0006; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:429
msgctxt "text_id=2301 | speaker=soujuurou"
msgid "　坂だろうと追いかけてくるし、最後の一匹になるまで引かないんだぞ」"
msgstr "  No matter where you run, they'll chase you as long as there's still life left in them.\""

#. Occurrence 2_2:474:2302: scene=2_2
#: 2_2:474
msgctxt "text_id=2302 | speaker=unknown"
msgid "　などと言いつつ、弁当の包みを開ける草十郎。"
msgstr "  Soujyuro opened his lunch as he spoke."

#. Occurrence 2_2:479:2303: scene=2_2
#: 2_2:479
msgctxt "text_id=2303 | speaker=unknown"
msgid "　若草色をした布には、綺麗な三角形をしたおにぎりが三つ包まれていた。"
msgstr "  Inside the bright green cloth: three beautifully made triangular rice balls."

#. Occurrence 2_2:524:2304: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0004; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:524
msgctxt "text_id=2304 | speaker=tobimaru"
msgid "「……ショックだ」"
msgstr "\"...Would you look at that.\""

#. Occurrence 2_2:554:2305: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0007; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:554
msgctxt "text_id=2305 | speaker=soujuurou"
msgid "「？　ショックってなにが？」"
msgstr "\"Look at what? What do you mean?\""

#. Occurrence 2_2:560:2306: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0005; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:560
msgctxt "text_id=2306 | speaker=tobimaru"
msgid "「いや、そんな、この世のものとは思えない握り飯を見たのは初めてだ。思わず絶句しちまった」"
msgstr "\"Oh, nothing. It's just that those are some special-looking rice balls you've got there.\""

#. Occurrence 2_2:572:2307: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0008; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:572
msgctxt "text_id=2307 | speaker=soujuurou"
msgid "「……。それ、どっちなんだ？」"
msgstr "\"...Is that a good thing or a bad thing?\""

#. Occurrence 2_2:596:2308: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0006; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:596
msgctxt "text_id=2308 | speaker=tobimaru"
msgid "「誉めてるんだよ、馬鹿」"
msgstr "\"I'm trying to compliment you, you idiot.\""

#. Occurrence 2_2:640:2309: scene=2_2
#: 2_2:640
msgctxt "text_id=2309 | speaker=unknown"
msgid "　草十郎を相手に侮辱とも称賛とも取れる言い回しはこういう結果を招く。婉曲な表現、遠回しな嫌味をかみ砕ける<機微|きび>がないためだ。"
msgstr "  Soujyuro was always confounded by phrasing that could be interpreted in multiple ways; euphemisms and subtle sarcasm were often lost on him."

#. Occurrence 2_2:645:2310: scene=2_2
#: 2_2:645
msgctxt "text_id=2310 | speaker=unknown"
msgid "　ただ、今のように言葉の良し悪しをいちいち訊ねるのは<希|まれ>だった。"
msgstr "  It was only on rare occasions, like this one, that he chose to confirm what was being said."

#. Occurrence 2_2:650:2311: scene=2_2
#: 2_2:650
msgctxt "text_id=2311 | speaker=unknown"
msgid "　鳶丸の推測だが、この少年は個人的に<譲|ゆず>れない事のみ白黒をハッキリさせる気質らしい。"
msgstr "  Tobimaru had come to suspect that Soujyuro had a very black-and-white way of seeing things."

#. Occurrence 2_2:676:2312: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0009; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:676
msgctxt "text_id=2312 | speaker=soujuurou"
msgid "「ところで。その固まった小麦粉みたいなの、美味しいのか？」"
msgstr "\"Say, does that hard chunk of flour-looking stuff taste any good?\""

#. Occurrence 2_2:682:2313: scene=2_2
#: 2_2:682
msgctxt "text_id=2313 | speaker=unknown"
msgid "　興味津々とばかりに鳶丸の簡易食を見つめる草十郎。"
msgstr "  Soujyuro stared at the energy bar with a curious look on his face."

#. Occurrence 2_2:723:2314: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0007; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:723
msgctxt "text_id=2314 | speaker=tobimaru"
msgid "「まずくはねえが美味くもねえよ。ま、試してみる分には止めねえが。"
msgstr "\"It's not meant to taste good. You can try it if you want."

#. Occurrence 2_2:735:2315: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0008; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:735
msgctxt "text_id=2315 | speaker=tobimaru"
msgid "　人間、何事も手間暇惜しむようになっちゃおしまいだぜ。事が三大欲求ならなおさらだ」"
msgstr "  People shouldn't hold back when it comes to the three base desires.\""

#. Occurrence 2_2:768:2316: scene=2_2
#: 2_2:768
msgctxt "text_id=2316 | speaker=unknown"
msgid "　鳶丸はガリガリとブロック菓子を平らげ、残った一本を机に置き、当然という手つきでおにぎりを一つ手に取った。"
msgstr "  Tobimaru quickly finished off his bar, put another one on the table, and grabbed one of Soujyuro's rice ball."

#. Occurrence 2_2:773:2317: scene=2_2
#: 2_2:773
msgctxt "text_id=2317 | speaker=unknown"
msgid "　草十郎も当然とばかりに鳶丸の暴挙を見逃し、差し出されたブロック菓子を食べてみる。"
msgstr "  Soujyuro failed to notice the rudeness of the forced exchange, and gave the proffered energy bar a try."

#. Occurrence 2_2:820:2318: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0010; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:820
msgctxt "text_id=2318 | speaker=soujuurou"
msgid "「……なんだか、土を食べてるみたいだ」"
msgstr "\"...It kind of tastes like dirt.\""

#. Occurrence 2_2:846:2319: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0009; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:846
msgctxt "text_id=2319 | speaker=tobimaru"
msgid "「違いない。遊びを無くせば人生こんなもんだって見本だな」"
msgstr "\"Now you get it. It's what a joyless existence tastes like.\""

#. Occurrence 2_2:869:2320: scene=2_2
#: 2_2:869
msgctxt "text_id=2320 | speaker=unknown"
msgid "　草十郎は苦い顔のまま、律儀に簡易食をかじっていく。"
msgstr "  Out of principle, Soujyuro labored over his energy bar, cringing all the while."

#. Occurrence 2_2:874:2321: scene=2_2
#: 2_2:874
msgctxt "text_id=2321 | speaker=unknown"
msgid "　未知への関心と、はじめた事はきっちり終わらせようとする律儀さである。"
msgstr "  He was both curious of the unknown and loathe to leave something unfinished."

#. Occurrence 2_2:905:2322: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0010; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:905
msgctxt "text_id=2322 | speaker=tobimaru"
msgid "「いま無理に平らげる必要はねえぞ。そいつの利点は携帯食ってところだからな。素で味けないが、食えるうちは味が落ちないのがいいところだ。"
msgstr "\"Don't force yourself to finish it right now. The whole point of it is that you can eat it on the run. And while the flavor isn't that great, at least it's consistent."

#. Occurrence 2_2:916:2323: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0011; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:916
msgctxt "text_id=2323 | speaker=tobimaru"
msgid "　ま、そっちはともかく。どうだ、少しは慣れたか？」"
msgstr "  Anyway, never mind that. Are you getting used to how things work around here?\""

#. Occurrence 2_2:963:2324: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0011; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:963
msgctxt "text_id=2324 | speaker=soujuurou"
msgid "「ああ。鳶丸や蒼崎が気を遣ってくれているからね」"
msgstr "\"Yes. You and Aozaki have been a huge help.\""

#. Occurrence 2_2:990:2325: scene=2_2
#: 2_2:990
msgctxt "text_id=2325 | speaker=unknown"
msgid "　屈託のない笑顔に、鳶丸はつい顔をそらしてしまった。"
msgstr "  Tobimaru turned his eyes up to the ceiling, unable to handle Soujyuro's carefree smile."

#. Occurrence 2_2:995:2326: scene=2_2
#: 2_2:995
msgctxt "text_id=2326 | speaker=unknown"
msgid "　草十郎はたしかに普段からぼんやりしているが、反面、こうして見せる感情表現はまっすぐで嘘がない。"
msgstr "  As absentminded as Soujyuro might have been, his expressions were nonetheless incredibly earnest."

#. Occurrence 2_2:1000:2327: scene=2_2
#: 2_2:1000
msgctxt "text_id=2327 | speaker=unknown"
msgid "　鳶丸のように若く利己的な人間にとっては、ささやかな毒にもなる。"
msgstr "  It was like poison to someone as self-absorbed as Tobimaru."

#. Occurrence 2_2:1040:2328: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0012; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1040
msgctxt "text_id=2328 | speaker=tobimaru"
msgid "『……だから蒼崎はこねえんだよなあ……』"
msgstr "(Now I know why Aozaki goes so out of her way to avoid him.)"

#. Occurrence 2_2:1046:2329: scene=2_2
#: 2_2:1046
msgctxt "text_id=2329 | speaker=unknown"
msgid "　内心呟いて、手にした握り飯を一口かじる鳶丸。"
msgstr "  He took a bite from the rice ball to steer himself away from such thoughts."

#. Occurrence 2_2:1051:2330: scene=2_2
#: 2_2:1051
msgctxt "text_id=2330 | speaker=unknown"
msgid "　冷めた白米でありながら、しっかり柔らかな食感である事に二度驚く鳶丸だった。"
msgstr "  Though now cold, the rice had managed to maintain its freshness, startling Tobimaru."

#. Occurrence 2_2:1095:2331: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0013; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1095
msgctxt "text_id=2331 | speaker=tobimaru"
msgid "「……ん？　"
msgstr "\"...Huh.  "

msgctxt "text_id=2332 | speaker=unknown"
msgid "いや待て、気を遣ってんのは俺だけじゃねえか。蒼崎なんておまえが転入した日に“彼、迷惑だから見張ってて”の一言だけだぞ!?」"
msgstr "Wait a sec, I'm the one that has your back, you know that right? Aozaki told me you were too annoying to deal with!\""

#. Occurrence 2_2:1132:2333: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0012; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1132
msgctxt "text_id=2333 | speaker=soujuurou"
msgid "「……なんでそこで君が怒るんだ？」"
msgstr "\"Did I say something to upset you?\""

#. Occurrence 2_2:1169:2334: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0014; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1169
msgctxt "text_id=2334 | speaker=tobimaru"
msgid "「いや、だからだな。おまえが学校に慣れるよう陰ながら見守ってんのは俺で、蒼崎は生徒会室で全校生徒の弱みを集めてるだけって話だ！"
msgstr "\"Don't you get it? I'm the only one helping you keep your head above water, while Aozaki sits in the student council room digging up dirt on other students!"

#. Occurrence 2_2:1169:2335: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0014; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1169
msgctxt "text_id=2335 | speaker=tobimaru"
msgid "　面倒な苦労してんのは俺だけじゃねえかって―――」"
msgstr "  I'm the one who gets lumbered with the crap jobs, while she gets to-\""

#. Occurrence 2_2:1193:2336: scene=2_2
#: 2_2:1193
msgctxt "text_id=2336 | speaker=unknown"
msgid "　そこまで口にして、鳶丸は自分の言い分が馬鹿らしくなった。草十郎の言う通り、鳶丸が怒る筋合いでもない。"
msgstr "  Tobimaru stopped himself, realizing how ridiculous he sounded. Soujyuro, rightly so, knew it was nothing to get this upset over."

#. Occurrence 2_2:1214:2337: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0015; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1214
msgctxt "text_id=2337 | speaker=tobimaru"
msgid "「……ま、いいさ。蒼崎に言いつけられなきゃこうなる事もなかったしな。"
msgstr "\"Well, whatever. I'm only here 'cause she told me to be."

#. Occurrence 2_2:1231:2338: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0016; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1231
msgctxt "text_id=2338 | speaker=tobimaru"
msgid "　知ってるか？"
msgstr "  Do you know?"

#. Occurrence 2_2:1231:2339: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0016; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1231
msgctxt "text_id=2339 | speaker=tobimaru"
msgid "　あいつ、どうして俺にこんな役させたと思う？」"
msgstr "  Do you know why she stuck me with you?\""

#. Occurrence 2_2:1242:2340: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0013; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1242
msgctxt "text_id=2340 | speaker=soujuurou"
msgid "「副会長だからだろ」"
msgstr "\"Because you're the vice president?\""

#. Occurrence 2_2:1253:2341: scene=2_2
#: 2_2:1253
msgctxt "text_id=2341 | speaker=unknown"
msgid "　言われて、鳶丸はその綺麗な顔を曇らせる。"
msgstr "  Tobimaru's handsome face went dark."

#. Occurrence 2_2:1280:2342: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0017; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1280
msgctxt "text_id=2342 | speaker=tobimaru"
msgid "「あのなあ。どうして副会長が転入生ひとりにかかりっきりにならなくちゃいけねえんだよ。"
msgstr "\"Do you really think it's normal for a student council vice president to waste all of his time on a single transfer student?"

#. Occurrence 2_2:1302:2343: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0018; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1302
msgctxt "text_id=2343 | speaker=tobimaru"
msgid "　チッ、いいぜ、機会があったら蒼崎本人に聞いてみな。あいつの本性が分かるからよ」"
msgstr "  Ugh, whatever, man. Try asking her directly if you get the chance. You'll learn who she really is.\""

#. Occurrence 2_2:1347:2344: scene=2_2
#: 2_2:1347
msgctxt "text_id=2344 | speaker=unknown"
msgid "　鳶丸は悪態をつきながらさらに握り飯をかじる。"
msgstr "  He snatched another bite of the rice ball while grumbling under his breath."

#. Occurrence 2_2:1352:2345: scene=2_2
#: 2_2:1352
msgctxt "text_id=2345 | speaker=unknown"
msgid "　乾燥した米粒でありながら、なんという<瑞々|みずみず>しさ……言うなれば<握|にぎ>り飯ではなく<包|つつ>み飯。力任せに米を固めたのではなく、職人の業で優しく『おにぎり』というカタチに集結させたとしか思えない……"
msgstr "  There it was again. Rice grains that were just dry enough to be fresh and tender in the mouth; a morsel that betrayed its humble description, which must have been delicately molded by a master chef rather than haphazardly clumped into a ball..."

#. Occurrence 2_2:1410:2346: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0019; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1410
msgctxt "text_id=2346 | speaker=tobimaru"
msgid "「そしてなによりこの塩加減、中の具からしみだした玄妙な醤油加減はどうだ―――"
msgstr "\"Just the right amount of salt, and the subtlest of soy sauce notes coming from the center, it..."

msgctxt "text_id=2347 | speaker=unknown"
msgid "食欲をそそるどころか、脳を食欲だけにするような―――"
msgstr " It doesn't just whet your appetite, it stimulates the desire centers of your brain and-"

msgctxt "text_id=2348 | speaker=unknown"
msgid "おお―――」"
msgstr " ...Oh wow.\""

#. Occurrence 2_2:1427:2349: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0014; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1427
msgctxt "text_id=2349 | speaker=soujuurou"
msgid "「鳶丸、思ってる事が口に出てるみたいだけど」"
msgstr "\"Tobimaru, you appear to be thinking out loud.\""

#. Occurrence 2_2:1455:2350: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0020; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1455
msgctxt "text_id=2350 | speaker=tobimaru"
msgid "「いや、それほどのショックだったってワケだ。"
msgstr "\"It's nothing, just color me surprised."

#. Occurrence 2_2:1489:2351: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0021; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1489
msgctxt "text_id=2351 | speaker=tobimaru"
msgid "　なあ草の字。これ、具はなんだ？」"
msgstr "  Hey, Sono-G, what's this filling, anyway?\""

#. Occurrence 2_2:1500:2352: scene=2_2
#: 2_2:1500
msgctxt "text_id=2352 | speaker=unknown"
msgid "　予想外の味に思わず訊ねる。"
msgstr "  It was only natural to inquire about the unexpectedly delicious bite."

#. Occurrence 2_2:1505:2353: scene=2_2
#: 2_2:1505
msgctxt "text_id=2353 | speaker=unknown"
msgid "　ちなみに、鳶丸はまだ外周だけで中心たる具に辿り着いていない。"
msgstr "  He had been nibbling around the edges and had not yet reached its center."

#. Occurrence 2_2:1551:2354: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0015; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1551
msgctxt "text_id=2354 | speaker=soujuurou"
msgid "「ああ、それはイナゴ」"
msgstr "\"Oh, that would be grasshopper.\""

#. Occurrence 2_2:1564:2355: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0022; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1564
msgctxt "text_id=2355 | speaker=tobimaru"
msgid "「ありえねえ！」"
msgstr "\"No way!\""

#. Occurrence 2_2:1570:2356: scene=2_2
#: 2_2:1570
msgctxt "text_id=2356 | speaker=unknown"
msgid "　がは、と咳きこむ副会長。"
msgstr "  The vice president choked on his cough."

#. Occurrence 2_2:1575:2357: scene=2_2
#: 2_2:1575
msgctxt "text_id=2357 | speaker=unknown"
msgid "　たしかに、山奥育ちの草十郎には海の幸より山の幸のイメージがあるような、でもイナゴはないような。"
msgstr "  He had assumed that Soujyuro would prefer earthy ingredients instead of seafood on account of his mountain life, but he never expected he would use grasshoppers."

#. Occurrence 2_2:1614:2358: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0023; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1614
msgctxt "text_id=2358 | speaker=tobimaru"
msgid "「クソ、食う前に言えよな！　信じられねえぐらい美味いと思っちまったじゃねえか！」"
msgstr "\"Damn it! You should have warned me first, Soujyuro! ...But man, was that delicious!\""

#. Occurrence 2_2:1645:2359: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0016; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1645
msgctxt "text_id=2359 | speaker=soujuurou"
msgid "「ああ、今のは嘘だよ」"
msgstr "\"Oh. I was just joking.\""

#. Occurrence 2_2:1673:2360: scene=2_2
#: 2_2:1673
msgctxt "text_id=2360 | speaker=unknown"
msgid "　瞬間、見つめ合うふたり。"
msgstr "  They locked eyes for a moment."

#. Occurrence 2_2:1708:2361: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0017; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1708
msgctxt "text_id=2361 | speaker=soujuurou"
msgid "「ほんとは鮭。いくらなんでも、イナゴはね」"
msgstr "\"It's salmon. I would never eat grasshopper.\""

#. Occurrence 2_2:1723:2362: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0024; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1723
msgctxt "text_id=2362 | speaker=tobimaru"
msgid "「―――お、おう。そうだよな、いや、安心した。"
msgstr "\"O-oh, right. Yeah. I knew that."

#. Occurrence 2_2:1723:2363: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0024; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1723
msgctxt "text_id=2363 | speaker=tobimaru"
msgid "　いくらなんでもイナゴはねえよな」"
msgstr "  Of course it wouldn't be grasshopper.\""

#. Occurrence 2_2:1754:2364: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0018; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1754
msgctxt "text_id=2364 | speaker=soujuurou"
msgid "「ああ、こんな都会で身のしまったイナゴが手に入るもんか」"
msgstr "\"Yeah. I mean, you can't find fresh grasshoppers in this city to begin with.\""

#. Occurrence 2_2:1760:2365: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0025; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1760
msgctxt "text_id=2365 | speaker=tobimaru"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 2_2:1765:2366: scene=2_2
#: 2_2:1765
msgctxt "text_id=2366 | speaker=unknown"
msgid "　気になる台詞だったが、あえて鳶丸はスルーする。"
msgstr "  As curious as those words were, Tobimaru decided to let them go."

#. Occurrence 2_2:1804:2367: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0026; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1804
msgctxt "text_id=2367 | speaker=tobimaru"
msgid "「……ったく。どっちにしても冗談きついぜ。あやうくはき出すところだったじゃねえか。らしくねえぞ、草十郎」"
msgstr "\"Jeez, Soujyuro. That's not something to joke about. You want me to hurl or something?\""

#. Occurrence 2_2:1810:2368: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0019; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1810
msgctxt "text_id=2368 | speaker=soujuurou"
msgid "「君が蒼崎の悪口を言うからだ」"
msgstr "\"Don't say bad things about Aozaki then.\""

#. Occurrence 2_2:1852:2369: scene=2_2
#: 2_2:1852
msgctxt "text_id=2369 | speaker=unknown"
msgid "　瞼を閉じ、不機嫌そうに握り飯を食べながら草十郎はそう言った。たしかに言った。"
msgstr "  Soujyuro closed his eyes as he continued to chew on his rice ball."

#. Occurrence 2_2:1857:2370: scene=2_2
#: 2_2:1857
msgctxt "text_id=2370 | speaker=unknown"
msgid "　不満そうにもぐもぐ口を動かす草十郎を、鳶丸は<唖然|あぜん>と見つめる。"
msgstr "  Tobimaru watched incredulously as Soujyuro made no attempt to hide his disapproval."

#. Occurrence 2_2:1895:2371: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0027; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:1895
msgctxt "text_id=2371 | speaker=tobimaru"
msgid "「―――おい。今のはさすがに聞き捨てならねえぞ。俺が蒼崎の悪口を言ったから<意趣返|いしゅがえ>しをしたと、そういうコトか？」"
msgstr "\"Okay, that I can't let go. You're really saying you were taking revenge for Aozaki?\""

#. Occurrence 2_2:1927:2372: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0020; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:1927
msgctxt "text_id=2372 | speaker=soujuurou"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 2_2:1933:2373: scene=2_2
#: 2_2:1933
msgctxt "text_id=2373 | speaker=unknown"
msgid "　もぐもぐもぐ。"
msgstr "  Soujyuro continued chewing."

#. Occurrence 2_2:1938:2374: scene=2_2
#: 2_2:1938
msgctxt "text_id=2374 | speaker=unknown"
msgid "　純朴な田舎少年の無言の抗議は、ますます真実味を増していく。"
msgstr "  The country boy's silent protest said all that needed to be said."

#. Occurrence 2_2:1981:2375: scene=2_2
#: 2_2:1981
msgctxt "text_id=2375 | speaker=unknown"
msgid "　間違いない、なんという悲劇、と副会長は落雷を受けたかのような頭痛にもだえた。"
msgstr "  The vice president suddenly looked like he had been struck by lightning."

#. Occurrence 2_2:2012:2376: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0028; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2012
msgctxt "text_id=2376 | speaker=tobimaru"
msgid "「なんてこった。おまえ、まさか蒼崎に惚れてんのか？"
msgstr "\"What the... Don't tell me you've fallen for Aozaki!"

#. Occurrence 2_2:2031:2377: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0029; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2031
msgctxt "text_id=2377 | speaker=tobimaru"
msgid "　そうなのか？　そうなんだな!?　おい、眠ってねえで起きろ！」"
msgstr "  You have, haven't you? ...Hey! I asked you a question, dammit!\""

#. Occurrence 2_2:2078:2378: scene=2_2
#: 2_2:2078
msgctxt "text_id=2378 | speaker=unknown"
msgid "　椅子から立ち上がり、草十郎の両肩を激しくシェイクする鳶丸。"
msgstr "  Tobimaru flew out of his chair and violently shook Soujyuro by the shoulders."

#. Occurrence 2_2:2089:2379: scene=2_2
#: 2_2:2089
msgctxt "text_id=2379 | speaker=unknown"
msgid "　仕方なく、むっとした顔で草十郎は目を開けた。"
msgstr "  Soujyuro opened his eyes."

#. Occurrence 2_2:2129:2380: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0030; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2129
msgctxt "text_id=2380 | speaker=tobimaru"
msgid "「そうか……おまえは一年前の惨劇を知らないんだな。"
msgstr "\"I forgot. You don't know about what happened a year ago..."

#. Occurrence 2_2:2135:2381: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0031; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2135
msgctxt "text_id=2381 | speaker=tobimaru"
msgid "　知ってりゃ、そんなストレートな破滅願望を持つ事もなかったろうに」"
msgstr "  'Cause if you did, you wouldn't be treading down this path of destruction, my friend.\""

#. Occurrence 2_2:2156:2382: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0021; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:2156
msgctxt "text_id=2382 | speaker=soujuurou"
msgid "「……君の言葉には誤解が含まれてるけど、それは後にする。それより、一年前の惨劇って？」"
msgstr "\"You've got it all wrong, but that's okay. Tell me what happened a year ago first.\""

#. Occurrence 2_2:2176:2383: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0032; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2176
msgctxt "text_id=2383 | speaker=tobimaru"
msgid "「―――む」"
msgstr "\"...Hmph.\""

#. Occurrence 2_2:2232:2384: scene=2_2
#: 2_2:2232
msgctxt "text_id=2384 | speaker=unknown"
msgid "　鳶丸はハッと我に返り、どうしたものかと考えたあげく、どすんと椅子に座る。"
msgstr "  Tobimaru regained his composure and sat down after a moment's thought."

#. Occurrence 2_2:2244:2385: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0033; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2244
msgctxt "text_id=2385 | speaker=tobimaru"
msgid "「仕方ねえ。この手の噂をするのは好きじゃねえんだけどな」"
msgstr "\"Okay. I'm not one to gossip, but for you I'm making an exception.\""

#. Occurrence 2_2:2250:2386: scene=2_2
#: 2_2:2250
msgctxt "text_id=2386 | speaker=unknown"
msgid "　しかしそれも青少年の輝かしい未来のためだ、と鳶丸は自己肯定した。"
msgstr "  Tobimaru reassured himself that it was in Soujyuro's best interests as a young man to know."

#. Occurrence 2_2:2294:2387: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0034; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2294
msgctxt "text_id=2387 | speaker=tobimaru"
msgid "「あれは蒼崎がまだ一年の頃の話だ。"
msgstr "\"It went down when Aozaki was a freshman."

#. Occurrence 2_2:2336:2388: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0035; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2336
msgctxt "text_id=2388 | speaker=tobimaru"
msgid "　あの頃はみんな入学したばっかりで、蒼崎がどんな性格か誰も知らなかった。"
msgstr "  Everybody was new to high school, so nobody knew what anyone was like yet, her included."

#. Occurrence 2_2:2353:2389: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0036; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2353
msgctxt "text_id=2389 | speaker=tobimaru"
msgid "　あいつ、外見は文句なしに美人だからな。"
msgstr "  She was a total babe. I mean just look at her!"

#. Occurrence 2_2:2359:2390: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0037; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2359
msgctxt "text_id=2390 | speaker=tobimaru"
msgid "　そりゃあ男どもは狂喜乱舞したもんさ」"
msgstr "  All the guys were crazy for her.\""

#. Occurrence 2_2:2376:2391: scene=2_2
#: 2_2:2376
msgctxt "text_id=2391 | speaker=unknown"
msgid "　そして、後に違った意味で狂喜乱舞する事になるとは、誰ひとり夢にも思わなかったのである。"
msgstr "  Little did they know that soon after they would go crazy for an entirely different reason."

#. Occurrence 2_2:2416:2392: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0038; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2416
msgctxt "text_id=2392 | speaker=tobimaru"
msgid "「四月、五月はもう上を下への大騒ぎでよ。"
msgstr "\"The first couple of months, the school descended into chaos."

#. Occurrence 2_2:2422:2393: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0039; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2422
msgctxt "text_id=2393 | speaker=tobimaru"
msgid "　あの時ばかりは上級生も下級生もなかったな。"
msgstr "  You gotta remember, that early on in the year, no one cared about class hierarchy."

#. Occurrence 2_2:2428:2394: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0040; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2428
msgctxt "text_id=2394 | speaker=tobimaru"
msgid "　野郎同士の牽制、共闘、はては決闘まで、まあよくも騒いだもんさ。蒼崎に近寄るだけでも大変だったんだぜ？」"
msgstr "  So tons of guys were fighting themselves over her, it was insane. Just getting anywhere near Aozaki was next to impossible.\""

#. Occurrence 2_2:2464:2395: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0022; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:2464
msgctxt "text_id=2395 | speaker=soujuurou"
msgid "「？　なんでそんなよく分からない事態になるんだ？」"
msgstr "\"I don't understand. Why would that happen?\""

#. Occurrence 2_2:2502:2396: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0041; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2502
msgctxt "text_id=2396 | speaker=tobimaru"
msgid "「そりゃ蒼崎はひとりきり、命知らずな野郎はのべ百人ほどいたからだよ。"
msgstr "\"'Cause that's what happens when a hundred guys like the same girl, duh."

#. Occurrence 2_2:2508:2397: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0042; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2508
msgctxt "text_id=2397 | speaker=tobimaru"
msgid "　ひとりひとり蒼崎とランチしても三ヶ月かかるだろ？"
msgstr "  It would have taken Aozaki three months just to have lunch with them all individually."

#. Occurrence 2_2:2519:2398: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0043; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2519
msgctxt "text_id=2398 | speaker=tobimaru"
msgid "　だから、まずは男同士でつまんねえ暗闘があったのさ」"
msgstr "  So people decided to fight over who got to ask her out.\""

#. Occurrence 2_2:2550:2399: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0023; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:2550
msgctxt "text_id=2399 | speaker=soujuurou"
msgid "「…………」"
msgstr "\"...\""

#. Occurrence 2_2:2556:2400: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0044; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2556
msgctxt "text_id=2400 | speaker=tobimaru"
msgid "「ま、いい。分からねえんならそこは飛ばそう。<所詮|しょせん>負け犬どもの話だしな、本筋にはなりえねえ」"
msgstr "\"They were all a bunch of losers if you ask me. But what happened next is the juicy part.\""

#. Occurrence 2_2:2613:2401: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0045; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2613
msgctxt "text_id=2401 | speaker=tobimaru"
msgid "「でな。そんなどうでもいい戦いを勝ち残ったヤツらは列なして一年の女に言い寄ったワケだ。"
msgstr "\"Those who emerged from the conflict unscathed made their move..."

#. Occurrence 2_2:2619:2402: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0046; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2619
msgctxt "text_id=2402 | speaker=tobimaru"
msgid "　蒼崎はアレでなんていうか、相手のなけなしの誠意？　じゃなくてアレか、勇気？　そういうの、無視できずに認めちまうヤツだからな。"
msgstr "  And though she might not seem like it, she's the type who likes to put a guy down lightly, you know, because of their sincerity or courage or whatever."

#. Occurrence 2_2:2625:2403: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0047; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2625
msgctxt "text_id=2403 | speaker=tobimaru"
msgid "　言い寄ってくる相手を可能なかぎり丁寧に断ってた」"
msgstr "  At any rate, she rejected all comers as politely as she could.\""

#. Occurrence 2_2:2670:2404: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0048; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2670
msgctxt "text_id=2404 | speaker=tobimaru"
msgid "「が、中にはそれで勘違いしちまう奴もいてよ。"
msgstr "\"But there was one guy who couldn't take a hint."

#. Occurrence 2_2:2676:2405: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0049; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2676
msgctxt "text_id=2405 | speaker=tobimaru"
msgid "　三年のある野郎がこれは脈アリと見て蒼崎に何度も言い寄ったんだよ。"
msgstr "  He was a third-year who just refused to give up."

#. Occurrence 2_2:2682:2406: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0050; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2682
msgctxt "text_id=2406 | speaker=tobimaru"
msgid "　……たぶん、そいつ頭がおかしかったんだ。今にして思うと、そうとしか思えん」"
msgstr "  ...Maybe he was a little bit nuts. It's hard to see it any other way at this point.\""

#. Occurrence 2_2:2688:2407: scene=2_2
#: 2_2:2688
msgctxt "text_id=2407 | speaker=unknown"
msgid "　ちなみに、その三年生とやらが前期の生徒会長である事を、鳶丸は秘する事にした。"
msgstr "  Incidentally, Tobimaru decided to gloss over the fact that this student was also the former student council president."

#. Occurrence 2_2:2739:2408: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0051; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2739
msgctxt "text_id=2408 | speaker=tobimaru"
msgid "「学園ばかりか蒼崎の家まで押しかけたそうでな。"
msgstr "\"But he didn't keep it up only at school. Later he started following her home."

msgctxt "text_id=2409 | speaker=unknown"
msgid "あまりにしつこいんで蒼崎も堪忍袋の緒が切れたんだろう。ちょっと、口にするのは<憚|はばか>られる方法でふったんだよ」"
msgstr " That must have been the last straw, because Aozaki wigged out. She sent him packing in ways I'm not comfortable repeating out loud.\""

#. Occurrence 2_2:2816:2410: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0052; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2816
msgctxt "text_id=2410 | speaker=tobimaru"
msgid "「結果、そいつは自分から他校に転入希望したばかりか三咲町からも逃げ出しちまって、蒼崎も一ヶ月ばかり自宅謹慎を食らった。"
msgstr "\"The conclusion? The student didn't just request a transfer, he tucked tail and left Misaki completely. Aozaki was sentenced to a month of house arrest."

#. Occurrence 2_2:2822:2411: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0053; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2822
msgctxt "text_id=2411 | speaker=tobimaru"
msgid "　世に言う血の公会堂事件だ。"
msgstr "  It came to be known as the Bloody Town Hall Incident."

#. Occurrence 2_2:2828:2412: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0054; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2828
msgctxt "text_id=2412 | speaker=tobimaru"
msgid "　詳しく知りたけりゃ本人………はまずいな、新聞部にでもいけ。あそこの部長は命知らずだから、訊けば面白がって教えてくれる」"
msgstr "  She could tell you more about it than I can... but I wouldn't recommend asking her. Ask the school newspaper editor instead. She loves a bit of gossip.\""

#. Occurrence 2_2:2895:2413: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0024; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:2895
msgctxt "text_id=2413 | speaker=soujuurou"
msgid "「……鳶丸。その、具体的な表現を故意に避けてないか？」"
msgstr "\"Tobimaru. I get the feeling you're not telling me everything.\""

#. Occurrence 2_2:2919:2414: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0055; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2919
msgctxt "text_id=2414 | speaker=tobimaru"
msgid "「仕方ねえだろ。理事長の息子だろうが何だろうが怖いものは怖ぇし、高校ぐらいは無事卒業しとかねえとな。"
msgstr "\"Hey, you'd do the same if you were me. I may be the board chairman's son and all, but some things scare even me, and I wanna graduate in one piece."

#. Occurrence 2_2:2930:2415: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0056; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:2930
msgctxt "text_id=2415 | speaker=tobimaru"
msgid "　うちの女子の制服みるたびに奇声をあげるトラウマなんて持ちたくねえよ」"
msgstr "  You want me to freak out every time I see a girl in a school uniform?\""

#. Occurrence 2_2:2977:2416: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0025; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:2977
msgctxt "text_id=2416 | speaker=soujuurou"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 2_2:2983:2417: scene=2_2
#: 2_2:2983
msgctxt "text_id=2417 | speaker=unknown"
msgid "　むう、と納得いかなげに首をかしげる草十郎。"
msgstr "  Soujyuro tilted his head to the side in confusion."

#. Occurrence 2_2:2988:2418: scene=2_2
#: 2_2:2988
msgctxt "text_id=2418 | speaker=unknown"
msgid "　鳶丸の言わんとするところが、彼にはさっぱり分からない。"
msgstr "  Tobimaru had lost him with that comment."

#. Occurrence 2_2:3032:2419: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0057; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3032
msgctxt "text_id=2419 | speaker=tobimaru"
msgid "「まあいい。"
msgstr "\"Well, whatever."

#. Occurrence 2_2:3038:2420: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0058; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3038
msgctxt "text_id=2420 | speaker=tobimaru"
msgid "　それより、なんで蒼崎なんかがいいんだよ、草十郎」"
msgstr "  What is it about Aozaki that you like anyway?\""

#. Occurrence 2_2:3066:2421: scene=2_2
#: 2_2:3066
msgctxt "text_id=2421 | speaker=unknown"
msgid "　言われて、今度は逆の方向に、はて、と草十郎は首をかしげた。"
msgstr "  He tilted his head again, this time to the other side."

#. Occurrence 2_2:3093:2422: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0059; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3093
msgctxt "text_id=2422 | speaker=tobimaru"
msgid "「おい。おまえ、本当に蒼崎が好きなのか？"
msgstr "\"Whoa. Are you really that hot for her?"

#. Occurrence 2_2:3099:2423: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0060; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3099
msgctxt "text_id=2423 | speaker=tobimaru"
msgid "　たんに胸がドキドキいってるだけなら、それは恋じゃなくて恐怖だってオチもあるぜ。いくら草の字がぼんやりでも理由ってもんがあるだろ？」"
msgstr "  'Cause if your heart pounds in her presence, that could be caused by fear, you know. Tell me you aren't stupid enough to like her for no good reason.\""

#. Occurrence 2_2:3105:2424: scene=2_2
#: 2_2:3105
msgctxt "text_id=2424 | speaker=unknown"
msgid "　草十郎はさらに首をかしげる。"
msgstr "  He tilted his head even further."

#. Occurrence 2_2:3152:2425: scene=2_2
#: 2_2:3152
msgctxt "text_id=2425 | speaker=unknown"
msgid "　鳶丸の言い分には<語弊|ごへい>があるが、とりあえず今はそれを抜きにするとして。"
msgstr "  What Tobimaru was saying sounded off, but Soujyuro decided not to press the matter."

#. Occurrence 2_2:3157:2426: scene=2_2
#: 2_2:3157
msgctxt "text_id=2426 | speaker=unknown"
msgid "　草十郎自身、蒼崎青子に抱く感情には理解できないものが多すぎた。"
msgstr "  All the more because he found many of his own emotions towards Aoko Aozaki to be incomprehensible."

#. Occurrence 2_2:3183:2427: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0026; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3183
msgctxt "text_id=2427 | speaker=soujuurou"
msgid "「そうだな、おかしい。俺は、あまり彼女を知らないのにね」"
msgstr "\"It is kind of strange, to be honest. I don't even know her that well.\""

#. Occurrence 2_2:3206:2428: scene=2_2
#: 2_2:3206
msgctxt "text_id=2428 | speaker=unknown"
msgid "　それもその筈、創立記念日の案内以来、学園内において草十郎と青子は一度も話していないのだ。"
msgstr "  That was because they had not truly spoken to each other since the day she showed him around."

#. Occurrence 2_2:3211:2429: scene=2_2
#: 2_2:3211
msgctxt "text_id=2429 | speaker=unknown"
msgid "　草十郎が話し掛けようとすると青子は素早く立ち去ってしまう。"
msgstr "  Every time Soujyuro tried to talk to her, she immediately got up and left."

#. Occurrence 2_2:3216:2430: scene=2_2
#: 2_2:3216
msgctxt "text_id=2430 | speaker=unknown"
msgid "　この間の日曜日には縁あって労働を共にしたが、あれだって往復時間に軽く話した程度である。"
msgstr "  As fate would have it, they ended up working together that recent Sunday, but made only idle chatter on the way and back."

#. Occurrence 2_2:3257:2431: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0027; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3257
msgctxt "text_id=2431 | speaker=soujuurou"
msgid "「けど鳶丸、君は知らないだけなんだ。"
msgstr "\"There's something you don't know, either, Tobimaru."

#. Occurrence 2_2:3263:2432: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0028; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3263
msgctxt "text_id=2432 | speaker=soujuurou"
msgid "　時々なんだが、誰かの視線を感じて振り返ってみると、いつ失敗するかを心配して見ている人がいる。"
msgstr "  Sometimes I feel someone's gaze on me, and when I turn around to see who it is, she's there, looking like she's worried about me, that I'll mess up."

#. Occurrence 2_2:3269:2433: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0029; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3269
msgctxt "text_id=2433 | speaker=soujuurou"
msgid "　鳶丸の言うとおり、ただ廊下で俺を見かけて、たんに監視していただけなのかも知れない。本当は俺の事なんて気にせず素通りしたいのかも知れない。"
msgstr "  I know what you'll say-she just happened to see me in the hallway and was keeping an eye on me. Maybe she secretly wishes she could ignore me when we pass each other."

#. Occurrence 2_2:3275:2434: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0030; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3275
msgctxt "text_id=2434 | speaker=soujuurou"
msgid "　けど、どんな種類であれ彼女の心配は本物だ」"
msgstr "  But whatever the reason, I believe her concern is genuine.\""

#. Occurrence 2_2:3333:2435: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0031; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3333
msgctxt "text_id=2435 | speaker=soujuurou"
msgid "「それに、ここが一番大事だと思うんだけど。"
msgstr "\"And that's the most important thing about all this."

#. Occurrence 2_2:3339:2436: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0032; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3339
msgctxt "text_id=2436 | speaker=soujuurou"
msgid "　実際の話、蒼崎のそういうところのおかげで、俺は助かっていたりするんだ」"
msgstr "  I believe that nature of hers has helped me out repeatedly.\""

#. Occurrence 2_2:3384:2437: scene=2_2
#: 2_2:3384
msgctxt "text_id=2437 | speaker=unknown"
msgid "　何の気負いもなく、真剣に彼は言った。"
msgstr "  His tone was measured and sincere."

#. Occurrence 2_2:3389:2438: scene=2_2
#: 2_2:3389
msgctxt "text_id=2438 | speaker=unknown"
msgid "　それを聞いた鳶丸は軽い後悔と共に、ため息などをこぼしてしまう。"
msgstr "  Tobimaru sighed with a tinge of regret."

#. Occurrence 2_2:3415:2439: scene=2_2
#: 2_2:3415
msgctxt "text_id=2439 | speaker=unknown"
msgid "　今の台詞さえ聞かなければ適当な女生徒を紹介して、草十郎が平穏な高校生活を送れるよう段取っただろうに。"
msgstr "  If not for those words, he could have introduced Soujyuro to a more suitable girl with whom he could have lived out the rest of his school days in peace."

#. Occurrence 2_2:3433:2440: scene=2_2
#: 2_2:3433
msgctxt "text_id=2440 | speaker=unknown"
msgid "　本来、彼がそこまで男友達のために骨折るコトはない。"
msgstr "  He never went to such lengths for his other friends."

#. Occurrence 2_2:3438:2441: scene=2_2
#: 2_2:3438
msgctxt "text_id=2441 | speaker=unknown"
msgid "　利用できる相手なら損得のために騙しあい、助け合う。"
msgstr "  Generally speaking, if it was of some benefit to him, he was unafraid of exploiting another."

#. Occurrence 2_2:3443:2442: scene=2_2
#: 2_2:3443
msgctxt "text_id=2442 | speaker=unknown"
msgid "　利用できない人間は、そも利用するべきではないと判断して距離を置くのが槻司鳶丸の信念だ。"
msgstr "  If they were of no use, he didn't bother getting involved with them. That was how Tobimaru Tsukiji operated."

#. Occurrence 2_2:3448:2443: scene=2_2
#: 2_2:3448
msgctxt "text_id=2443 | speaker=unknown"
msgid "　そんな彼をして、静希草十郎は益を得る相手ではないクセに、手を貸したくなる人種だった。"
msgstr "  Soujyuro happened to be the type of person who provided no benefit to Tobimaru, yet somehow sparked in him a desire to help."

#. Occurrence 2_2:3512:2444: scene=2_2
#: 2_2:3512
msgctxt "text_id=2444 | speaker=unknown"
msgid "　彼は友情には<疎|うと>くなかったが、"
msgstr "  It was not that friendship was completely alien to him."

#. Occurrence 2_2:3517:2445: scene=2_2
#: 2_2:3517
msgctxt "text_id=2445 | speaker=unknown"
msgid "　友人と呼べる人物にはそう恵まれていなかった。"
msgstr "  He just did not have many people he felt that close to."

#. Occurrence 2_2:3523:2446: scene=2_2
#: 2_2:3523
msgctxt "text_id=2446 | speaker=unknown"
msgid "　……なので、草十郎が本気で青子に惚れているのなら、友人として、それを改めさせる野暮はできなかった。"
msgstr "  So if Soujyuro had really fallen for Aoko, it was not his place, as a friend, to try to change his mind."

#. Occurrence 2_2:3576:2447: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0061; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3576
msgctxt "text_id=2447 | speaker=tobimaru"
msgid "「……やれやれ。結局、惚れてる奴にゃあ理由なんていらねえんだな」"
msgstr "\"Ugh, well, I guess it's true that love knows no reason.\""

#. Occurrence 2_2:3589:2448: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0033; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3589
msgctxt "text_id=2448 | speaker=soujuurou"
msgid "「そんな事はない。理由ならひとつある。"
msgstr "\"I wouldn't say there's no reason for it. I can think of one at least."

#. Occurrence 2_2:3589:2449: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0033; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3589
msgctxt "text_id=2449 | speaker=soujuurou"
msgid "　彼女を<一目|ひとめ>みた時に、綺麗だなって思ったぞ」"
msgstr "  I thought she was beautiful the moment I first laid eyes on her.\""

#. Occurrence 2_2:3601:2450: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0062; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3601
msgctxt "text_id=2450 | speaker=tobimaru"
msgid "「あ？」"
msgstr "\"Uh.\""

#. Occurrence 2_2:3606:2451: scene=2_2
#: 2_2:3606
msgctxt "text_id=2451 | speaker=unknown"
msgid "　がくん、と肩を落とす鳶丸。"
msgstr "  Tobimaru's shoulders slumped."

#. Occurrence 2_2:3641:2452: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0063; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3641
msgctxt "text_id=2452 | speaker=tobimaru"
msgid "「なんだぁ!?　あんだけ恥ずかしい台詞いっといて、要は外見に惚れてますだあ？　結局見てくれかよ草十郎！」"
msgstr "\"After all that, you just like her for her looks? Listen to yourself, Soujyuro!\""

#. Occurrence 2_2:3647:2453: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0034; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3647
msgctxt "text_id=2453 | speaker=soujuurou"
msgid "「綺麗なものに見惚れるのは、いいことじゃないのか？"
msgstr "\"What's wrong with appreciating beauty?"

#. Occurrence 2_2:3653:2454: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0035; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3653
msgctxt "text_id=2454 | speaker=soujuurou"
msgid "　自分を綺麗に見せる努力をしているんだから、外見から内面を判断するのは、そんなおかしな話じゃないと思う」"
msgstr "  I don't think there is anything wrong with judging someone by the physical appearance they worked hard to create.\""

#. Occurrence 2_2:3674:2455: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0064; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3674
msgctxt "text_id=2455 | speaker=tobimaru"
msgid "「む」"
msgstr "\"Hrm.\""

#. Occurrence 2_2:3679:2456: scene=2_2
#: 2_2:3679
msgctxt "text_id=2456 | speaker=unknown"
msgid "　詭弁のようではあるが、なんとなく正論のような気もする。"
msgstr "  That sounded like a sophism to Tobimaru, but he had no counterpoint to offer."

#. Occurrence 2_2:3706:2457: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0065; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3706
msgctxt "text_id=2457 | speaker=tobimaru"
msgid "「……しょうがねえ、分かったよ。この話はもう止めよう。草の字が誰を<自分|テメエ>の女にするか、俺の知った事じゃねえし」"
msgstr "\"All right. I get it. I'll let it go. It's none of my business who you go after anyway.\""

#. Occurrence 2_2:3747:2458: scene=2_2
#: 2_2:3747
msgctxt "text_id=2458 | speaker=unknown"
msgid "　さて。"
msgstr "  Now..."

#. Occurrence 2_2:3752:2459: scene=2_2
#: 2_2:3752
msgctxt "text_id=2459 | speaker=unknown"
msgid "　ここで、鳶丸はひとつ、大きな勘違いをしていた。"
msgstr "  Tobimaru was mistaken about one major point during this whole conversation."

#. Occurrence 2_2:3757:2460: scene=2_2
#: 2_2:3757
msgctxt "text_id=2460 | speaker=unknown"
msgid "　静希草十郎は蒼崎青子に好意を持っているだけであって、別に、心の底から好きだとか、恋人として付き合いたいなんて願望は、むしろ一片も無かった、という点である。"
msgstr "  Namely, that Soujyuro was not head-over-heels in love with Aoko and hoped to go steady with her. He merely liked her as a person."

#. Occurrence 2_2:3763:2461: scene=2_2
#: 2_2:3763
msgctxt "text_id=2461 | speaker=unknown"
msgid "　この勘違いが後に大きな禍根となるコトを、神ならざる彼らが気付くよしもない。"
msgstr "  Nobody could have foreseen the massive calamity that would be caused by this simple misunderstanding."

#. Occurrence 2_2:3803:2462: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0066; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3803
msgctxt "text_id=2462 | speaker=tobimaru"
msgid "「だがよ、ひとつだけ忠告しておくぜ草十郎。"
msgstr "\"I've just got one piece of advice for you, Soujyuro."

#. Occurrence 2_2:3810:2463: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0067_0; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3810
msgctxt "text_id=2463 | speaker=tobimaru"
msgid "蒼崎はケンカをした相手だろうと別に嫌うワケじゃない。逆に言えば、親切にしたって別に好かれるワケでもない。"
msgstr "  Just because Aozaki fights with someone doesn't mean she hates them, and just because she's nice to someone doesn't mean she likes them."

#. Occurrence 2_2:3824:2464: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0067_1; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3824
msgctxt "text_id=2464 | speaker=tobimaru"
msgid "いい例が俺だ」"
msgstr " I'm a prime example of that.\""

#. Occurrence 2_2:3830:2465: scene=2_2
#: 2_2:3830
msgctxt "text_id=2465 | speaker=unknown"
msgid "　過去の傷心を思いだしたのか、鳶丸は重いため息とともに語る。"
msgstr "  He spoke with a pained sigh as if opening old wounds from the past."

#. Occurrence 2_2:3879:2466: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0036; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:3879
msgctxt "text_id=2466 | speaker=soujuurou"
msgid "「そうか、"
msgstr "\"I see."

msgctxt "text_id=2467 | speaker=unknown"
msgid "詳しく」"
msgstr " What happened?\""

#. Occurrence 2_2:3924:2468: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0068; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3924
msgctxt "text_id=2468 | speaker=tobimaru"
msgid "「おう。昔な、あいつがあんまりに独善的だったんでつい手をあげかけちまった事がある。"
msgstr "\"Long story short, she used to be really full of herself, and I once tried to hit her."

#. Occurrence 2_2:3930:2469: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0069; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3930
msgctxt "text_id=2469 | speaker=tobimaru"
msgid "　半年前の夏だ。一年もあいつと生徒会やってたもんだから、俺も女っつーより戦友って気になっててな。"
msgstr "  It happened last summer. I'd already been working with her in the student council for a year at that point and saw her more like a fellow soldier in the trenches than as a girl."

#. Occurrence 2_2:3936:2470: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0070; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:3936
msgctxt "text_id=2470 | speaker=tobimaru"
msgid "　つい勢いで平手打ちをしようと右手をあげた。―――我ながら四番<打者|バッター>もかくやという腰のひねり。たしかな実感とともに、俺は勝利を確信したもんさ」"
msgstr "  One day, I lost my temper and I took a swing at her. I like to think I've got a mean right hook, and I slugged her pretty good, so I thought I won that round.\""

#. Occurrence 2_2:3970:2471: scene=2_2
#: 2_2:3970
msgctxt "text_id=2471 | speaker=unknown"
msgid "　ふっ、と遠い目をする彼は、その後の<顛末|てんまつ>を話そうとはしなかった。"
msgstr "  He had a distant look in his eyes as his words trailed off."

#. Occurrence 2_2:4017:2472: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0071; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:4017
msgctxt "text_id=2472 | speaker=tobimaru"
msgid "「翌日になって、こりゃあ完全に敵扱いされたな、と覚悟して生徒会室にいってみりゃあ、蒼崎はいつも通りだった。"
msgstr "\"The next day, when I came to the student council room, I thought she'd be spoiling for a fight, but she was the same as always."

#. Occurrence 2_2:4023:2473: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0072; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:4023
msgctxt "text_id=2473 | speaker=tobimaru"
msgid "　で、以来あいつと俺は会長と副会長で納まってる」"
msgstr "  And since then, we've simply continued working together as president and vice president.\""

#. Occurrence 2_2:4070:2474: scene=2_2
#: 2_2:4070
msgctxt "text_id=2474 | speaker=unknown"
msgid "　話を聞き終わり、ふーん、と感想を漏らす草十郎。"
msgstr "  Soujyuro sighed at his story."

#. Occurrence 2_2:4075:2475: scene=2_2
#: 2_2:4075
msgctxt "text_id=2475 | speaker=unknown"
msgid "　そうして自信を持って、"
msgstr "  He then said, with absolute confidence,"

#. Occurrence 2_2:4109:2476: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0037; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:4109
msgctxt "text_id=2476 | speaker=soujuurou"
msgid "「いまの話を総合すると、君はたんに<惚気|のろけ>たいのか？」"
msgstr "\"So, you just wanted to brag about how close you two are?\""

#. Occurrence 2_2:4115:2477: scene=2_2
#: 2_2:4115
msgctxt "text_id=2477 | speaker=unknown"
msgid "　真顔で、まったく分かってない感想を口にするのだった。"
msgstr "  Clearly, he had missed the point entirely."

#. Occurrence 2_2:4171:2478: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0073; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:4171
msgctxt "text_id=2478 | speaker=tobimaru"
msgid "「んなワケあるかぁ！！！！　"
msgstr "\"Are you kidding me!?  "

msgctxt "text_id=2479 | speaker=unknown"
msgid "いまの話のどこに甘ずっぱい要素があんだよ！？"
msgstr " How in the hell do you come to that conclusion after hearing a story like that!?"

#. Occurrence 2_2:4185:2480: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0074; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:4185
msgctxt "text_id=2480 | speaker=tobimaru"
msgid "　"
msgstr "  "

msgctxt "text_id=2481 | speaker=unknown"
msgid "俺としちゃあ、あいつを女として見なくなった決定的な事件だったんだがねぇ！？」"
msgstr "I'm telling you that from that day forward I could never see her again as a woman!\""

#. Occurrence 2_2:4199:2482: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0038; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:4199
msgctxt "text_id=2482 | speaker=soujuurou"
msgid "「なんだ、違うのか」"
msgstr "\"Oh, I was mistaken?\""

#. Occurrence 2_2:4227:2483: scene=2_2
#: 2_2:4227
msgctxt "text_id=2483 | speaker=unknown"
msgid "　もったいない、と不満そうに漏らす草十郎。"
msgstr "  A look of disappointment flittered across Soujyuro's face. "

#. Occurrence 2_2:4232:2484: scene=2_2
#: 2_2:4232
msgctxt "text_id=2484 | speaker=unknown"
msgid "　……この男、単純のようで底が知れぬのかも、と鳶丸は考えを改めた。"
msgstr "  Tobimaru revised his opinion: Soujyuro was something of a simpleton, but there was a quality to him that Tobimaru could not quite place."

#. Occurrence 2_2:4281:2485: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0075; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:4281
msgctxt "text_id=2485 | speaker=tobimaru"
msgid "「とにかくだ。俺が言いたいのは、蒼崎青子の“好き嫌いの基準”ってのは普通じゃないって事だ。"
msgstr "\"Just take it from me―her standards are anything but normal."

#. Occurrence 2_2:4287:2486: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0076; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:4287
msgctxt "text_id=2486 | speaker=tobimaru"
msgid "いいコトをすれば好かれる、気に入らないコトをすれば嫌われる、ってワケじゃねえんだよ、あのお姫さまは」"
msgstr "  She won't like you for being nice to her, and she won't hate you for being mean to her. That's the kind of princess she is.\""

#. Occurrence 2_2:4306:2487: scene=2_2
#: 2_2:4306
msgctxt "text_id=2487 | speaker=unknown"
msgid "　参考にするよ、と答えて草十郎は時計を見る。"
msgstr "  Soujyuro answered that he would keep it in mind, as he looked to the clock."

#. Occurrence 2_2:4311:2488: scene=2_2
#: 2_2:4311
msgctxt "text_id=2488 | speaker=unknown"
msgid "　長話がすぎたらしい。昼休みは残り少なくなっていた。"
msgstr "  They had been talking for a while, and lunch was almost over."

#. Occurrence 2_2:4332:2489: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0039; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:4332
msgctxt "text_id=2489 | speaker=soujuurou"
msgid "「もう君からの話はないか？」"
msgstr "\"Is there anything else you wanted to discuss?\""

#. Occurrence 2_2:4338:2490: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0077; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:4338
msgctxt "text_id=2490 | speaker=tobimaru"
msgid "「あ？　はじめからねえよ、そんなの」"
msgstr "\"Huh? I didn't have anything to discuss in the first place.\""

#. Occurrence 2_2:4359:2491: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0040; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:4359
msgctxt "text_id=2491 | speaker=soujuurou"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 2_2:4365:2492: scene=2_2
#: 2_2:4365
msgctxt "text_id=2492 | speaker=unknown"
msgid "　なら何故この男は自分をここに連れこんだのだろう？　と首をかしげる草十郎だったが、今は他に本題がある。"
msgstr "  Why had Tobimaru even brought him here in the first place? Soujyuro tilted his head in wonder but shook it off to deal with the more pressing matters at hand."

#. Occurrence 2_2:4406:2493: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0041; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:4406
msgctxt "text_id=2493 | speaker=soujuurou"
msgid "「よし。じゃあもう少し付きあってくれ。"
msgstr "\"Could you stay a little longer?"

#. Occurrence 2_2:4406:2494: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0041; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:4406
msgctxt "text_id=2494 | speaker=soujuurou"
msgid "　鳶丸に訊きたいことがあったんだ」"
msgstr "  There's something I wanted to ask you.\""

#. Occurrence 2_2:4412:2495: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_2_0078; voice_prefix=B70; voice_category=4; scene=2_2
#: 2_2:4412
msgctxt "text_id=2495 | speaker=tobimaru"
msgid "「？」"
msgstr "\"?\""

#. Occurrence 2_2:4451:2496: scene=2_2
#: 2_2:4451
msgctxt "text_id=2496 | speaker=unknown"
msgid "　今までにない真剣な表情の草十郎に、思わず姿勢を正す鳶丸。"
msgstr "  Tobimaru sat up straight, having never seen Soujyuro's face look so serious before."

#. Occurrence 2_2:4456:2497: scene=2_2
#: 2_2:4456
msgctxt "text_id=2497 | speaker=unknown"
msgid "　食べかけのおにぎりもそのままに、ゴホン、と草十郎は咳払いをする。"
msgstr "  Soujyuro set aside his rice ball and cleared his throat."

#. Occurrence 2_2:4505:2498: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_2_0042; voice_prefix=A30; voice_category=3; scene=2_2
#: 2_2:4505
msgctxt "text_id=2498 | speaker=soujuurou"
msgid "「―――実は昨日、こんなコトがあって……」"
msgstr "\"It's about something that happened yesterday.\""

#. Occurrence 2_2:4511:2499: scene=2_2
#: 2_2:4511
msgctxt "text_id=2499 | speaker=unknown"
msgid "　語りだしは厳かに。"
msgstr "  He spoke solemnly."

#. Occurrence 2_2:4516:2500: scene=2_2
#: 2_2:4516
msgctxt "text_id=2500 | speaker=unknown"
msgid "　草十郎はできるだけ正確に、昨夜出会ったある出来事について話し始めた。"
msgstr "  And as carefully as possible, he recounted what had occurred the night before..."

#. Occurrence 2_3:50:2501: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0000; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:50
msgctxt "text_id=2501 | speaker=aoko"
msgid "「静希君、いる？」"
msgstr "\"Sizuki, you in here?\""

#. Occurrence 2_3:56:2502: scene=2_3
#: 2_3:56
msgctxt "text_id=2502 | speaker=unknown"
msgid "　昼休みも終わろうとしている十二時五十分。"
msgstr "  It was ten to twelve and lunchtime was quickly coming to an end."

#. Occurrence 2_3:61:2503: scene=2_3
#: 2_3:61
msgctxt "text_id=2503 | speaker=unknown"
msgid "　一向に活気の<衰|おとろ>えない二年Ｃ組の教室に顔を出し、"
msgstr "  Her face popped into Class C. As lively as ever,"

#. Occurrence 2_3:66:2504: scene=2_3
#: 2_3:66
msgctxt "text_id=2504 | speaker=unknown"
msgid "　……彼女にとってはごく普通の仕草で……"
msgstr "  as if it were an everyday occurrence..."

#. Occurrence 2_3:71:2505: scene=2_3
#: 2_3:71
msgctxt "text_id=2505 | speaker=unknown"
msgid "　蒼崎青子はそう告げた。"
msgstr "  ...Aoko Aozaki announced her presence."

#. Occurrence 2_3:105:2506: scene=2_3
#: 2_3:105
msgctxt "text_id=2506 | speaker=unknown"
msgid "　青子にとってＣ組は<余所|よそ>のクラスだが、そんな事はおかまいなしで気軽に教室へと入っていく。"
msgstr "  While Aoko wasn't part of Class C, she didn't let it bother her as she casually entered the classroom."

#. Occurrence 2_3:151:2507: scene=2_3
#: 2_3:151
msgctxt "text_id=2507 | speaker=unknown"
msgid "　一方。リラックスした彼女とは対照的に、今まで餌を前にした<雛鳥|ひなどり>の如く騒がしかった生徒達は白々しいほど静かに、行儀よく席につきはじめた。"
msgstr "  In contrast, the baby birds who had been so noisily chirping while eating lunch quickly quieted and began to rearrange their seats."

#. Occurrence 2_3:192:2508: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0001; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:192
msgctxt "text_id=2508 | speaker=aoko"
msgid "『……どういう意味よ、それ……』"
msgstr "(Hmph. Are they trying to tell me something?)"

#. Occurrence 2_3:198:2509: scene=2_3
#: 2_3:198
msgctxt "text_id=2509 | speaker=unknown"
msgid "　内心で舌打ちしつつ、青子は教室を見回した。"
msgstr "  She bristled internally before looking around the room."

#. Occurrence 2_3:203:2510: scene=2_3
#: 2_3:203
msgctxt "text_id=2510 | speaker=unknown"
msgid "　目当ての男子生徒の姿はない。"
msgstr "  She could not see the male student she had come here to find."

#. Occurrence 2_3:208:2511: scene=2_3
#: 2_3:208
msgctxt "text_id=2511 | speaker=unknown"
msgid "　目立たない奴だから、はじっこに隠れているかと思えばそうでもなさそうだ。"
msgstr "  He hardly stood out, so she thought he might be hidden in a corner somewhere, but that appeared to not be the case."

#. Occurrence 2_3:242:2512: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0002; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:242
msgctxt "text_id=2512 | speaker=aoko"
msgid "「有里君。出席番号12番の静希君は？」"
msgstr "\"Arisato, do you have any idea where Sizuki from seat 12 is?\""

#. Occurrence 2_3:247:2513: scene=2_3
#: 2_3:247
msgctxt "text_id=2513 | speaker=unknown"
msgid "　青子はあくまで事務的に問う。"
msgstr "  Aoko kept her tone professional."

#. Occurrence 2_3:253:2514: voice_id=E70_2_3_0000; voice_prefix=E70; voice_category=0; scene=2_3
#: 2_3:253
msgctxt "text_id=2514 | speaker=unknown"
msgid "「え、俺……？　えーと、静希ならさっき鳶丸<殿下|でんか>が連れていったよ」"
msgstr "\"Wait, me? Umm, Sizuki left with His Highness Tobimaru a while ago.\""

#. Occurrence 2_3:258:2515: scene=2_3
#: 2_3:258
msgctxt "text_id=2515 | speaker=unknown"
msgid "　名前を呼ばれた男子生徒は、青子が自分の名前を知っている事に驚きつつ返答した。"
msgstr "  The boy was shocked that she actually knew his name."

#. Occurrence 2_3:284:2516: scene=2_3
#: 2_3:284
msgctxt "text_id=2516 | speaker=unknown"
msgid "　余談ではあるが、<槻司|つきじ><鳶丸|とびまる>が殿下と呼ばれるのは彼が理事長の息子だから……という訳でもなく、純粋に彼の振るまいが王子のようだからである。"
msgstr "  One might think that the reason students referred to Tobimaru Tsukiji by a royal title was because he was the chairman's son, but it was because he actually acted like royalty."

#. Occurrence 2_3:289:2517: scene=2_3
#: 2_3:289
msgctxt "text_id=2517 | speaker=unknown"
msgid "　本人もそのアダ名は気に入っているらしい。"
msgstr "  In fact, the vice president was said to have taken a liking to the title."

#. Occurrence 2_3:316:2518: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0003; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:316
msgctxt "text_id=2518 | speaker=aoko"
msgid "「鳶丸が……？　あいつ、静希君と仲いいの？」"
msgstr "\"He's with Tobimaru? Are those two friends or something?\""

#. Occurrence 2_3:337:2519: scene=2_3
#: 2_3:337
msgctxt "text_id=2519 | speaker=unknown"
msgid "　意外そうに訊く青子と、"
msgstr "  She seemed surprised."

#. Occurrence 2_3:342:2520: scene=2_3
#: 2_3:342
msgctxt "text_id=2520 | speaker=unknown"
msgid "　その台詞を意外そうに聞くクラス一同。"
msgstr "  The class seemed surprised at her surprise."

#. Occurrence 2_3:364:2521: voice_id=D90_2_3_0000; voice_prefix=D90; voice_category=0; scene=2_3
#: 2_3:364
msgctxt "text_id=2521 | speaker=unknown"
msgid "「良いも悪いも、槻司くんが男子と仲良く話してるのって今まで見たことなかったよ、あたし達。"
msgstr "\"No idea, but we've never seen Tsukiji be that friendly with another boy before."

#. Occurrence 2_3:370:2522: voice_id=D90_2_3_0001; voice_prefix=D90; voice_category=0; scene=2_3
#: 2_3:370
msgctxt "text_id=2522 | speaker=unknown"
msgid "　あ、木乃美くんはバカだから別だけど」"
msgstr "  Well, maybe Kinomi, but he's an idiot, so that hardly counts.\""

#. Occurrence 2_3:376:2523: voice_id=E20_2_3_0000; voice_prefix=E20; voice_category=0; scene=2_3
#: 2_3:376
msgctxt "text_id=2523 | speaker=unknown"
msgid "「そうだよなあ。はじめは殿下もあんまり話してなかったけど、三日もしたら楽しそうに口喧嘩してたもんなぁ」"
msgstr "\"Yeah. His Highness was slow to warm to him, but since the third day, it's been nothing but friendly arguments.\""

#. Occurrence 2_3:382:2524: voice_id=E30_2_3_0000; voice_prefix=E30; voice_category=0; scene=2_3
#: 2_3:382
msgctxt "text_id=2524 | speaker=unknown"
msgid "「ま、静希相手につっぱっても仕方ないじゃん？　あいつ変だけどいい奴だし」"
msgstr "\"Well, you can't really help but like Sizuki. He may be a little odd, but he's good people.\""

#. Occurrence 2_3:388:2525: voice_id=E10_2_3_0000; voice_prefix=E10; voice_category=0; scene=2_3
#: 2_3:388
msgctxt "text_id=2525 | speaker=unknown"
msgid "「そーよねー。いい人だもんねー草十郎くん！」"
msgstr "\"Totally! Soujyuro is really nice!\""

#. Occurrence 2_3:422:2526: scene=2_3
#: 2_3:422
msgctxt "text_id=2526 | speaker=unknown"
msgid "　調子を取り戻しつつあるのか、二年Ｃ組の面々はざわざわと会話をリレーしはじめる。"
msgstr "  Having recomposed themselves, Class C started chatting again."

#. Occurrence 2_3:440:2527: scene=2_3
#: 2_3:440
msgctxt "text_id=2527 | speaker=unknown"
msgid "　それをしばらく聞いていた青子だったが、唐突にくるりと背を向け、"
msgstr "  Aoko listened for a bit before turning around"

msgctxt "text_id=2528 | speaker=unknown"
msgid "「それじゃ」と二年Ｃ組を後にした。"
msgstr " and leaving the class with a, \"later.\""

#. Occurrence 2_3:509:2529: scene=2_3
#: 2_3:509
msgctxt "text_id=2529 | speaker=unknown"
msgid "　とりあえず手短に、草十郎の話は済んだ。"
msgstr "  All the Soujyuro talk finished as quickly as it had started."

#. Occurrence 2_3:515:2530: scene=2_3
#: 2_3:515
msgctxt "text_id=2530 | speaker=unknown"
msgid "　昼休みも残り数分と迫った生徒会室。"
msgstr "  Lunchtime was coming to a close in the student council room."

#. Occurrence 2_3:520:2531: scene=2_3
#: 2_3:520
msgctxt "text_id=2531 | speaker=unknown"
msgid "　話し終えて満足顔の草十郎と、"
msgstr "  Soujyuro, having told his story, was smiling in satisfaction."

#. Occurrence 2_3:525:2532: scene=2_3
#: 2_3:525
msgctxt "text_id=2532 | speaker=unknown"
msgid "　聞き終わって難色顔の鳶丸が、机をはさんで向かいあっている。"
msgstr "  Tobimaru, still sitting across from him, was frowning."

#. Occurrence 2_3:566:2533: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0000; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:566
msgctxt "text_id=2533 | speaker=soujuurou"
msgid "「さ、感想を聞かせてくれ」"
msgstr "\"So, what do you think?\""

#. Occurrence 2_3:572:2534: scene=2_3
#: 2_3:572
msgctxt "text_id=2534 | speaker=unknown"
msgid "　話す事はすべて話した、と草十郎。"
msgstr "  Soujyuro told his yarn as best he could."

#. Occurrence 2_3:577:2535: scene=2_3
#: 2_3:577
msgctxt "text_id=2535 | speaker=unknown"
msgid "　鳶丸はというと、怒っているような、悩んでいるような、曖昧な表情で額に指を当てていた。"
msgstr "  Tobimaru fingered his brow as if he was angry or concerned."

#. Occurrence 2_3:620:2536: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0000; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:620
msgctxt "text_id=2536 | speaker=tobimaru"
msgid "「……なあ、草の字。おまえ、人を馬鹿にできるほど器用な奴じゃねえよな」"
msgstr "\"Sono-G. Are you trying to make fun of me? A word of advice, leave that to us smart people, hmm?\""

#. Occurrence 2_3:653:2537: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0001; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:653
msgctxt "text_id=2537 | speaker=soujuurou"
msgid "「失礼な。器用な方だぞ、俺は」"
msgstr "\"Take that back. I'm more clever than you think.\""

#. Occurrence 2_3:658:2538: scene=2_3
#: 2_3:658
msgctxt "text_id=2538 | speaker=unknown"
msgid "　その返答に、つくづく不器用な性格だと確信する。"
msgstr "  His response only confirmed Tobimaru's suspicions."

#. Occurrence 2_3:663:2539: scene=2_3
#: 2_3:663
msgctxt "text_id=2539 | speaker=unknown"
msgid "　となると結論は二つに一つだ。"
msgstr "  It had to be one of two possible conclusions."

#. Occurrence 2_3:700:2540: scene=2_3
#: 2_3:700
msgctxt "text_id=2540 | speaker=unknown"
msgid "　一つは、いま聞いた話は真実だという事。"
msgstr "  That what Soujyuro had just told him was true..."

#. Occurrence 2_3:705:2541: scene=2_3
#: 2_3:705
msgctxt "text_id=2541 | speaker=unknown"
msgid "　あるいは、彼が幻覚を見るほど疲れきっているという事。"
msgstr "  ...or that Soujyuro was so tired that he must have been hallucinating at the time."

#. Occurrence 2_3:715:2542: scene=2_3
#: 2_3:715
msgctxt "text_id=2542 | speaker=unknown"
msgid "　鳶丸としては後者であってほしいものだが……。"
msgstr "  Tobimaru sincerely hoped it was the latter."

#. Occurrence 2_3:741:2543: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0001; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:741
msgctxt "text_id=2543 | speaker=tobimaru"
msgid "「……草十郎。率直に言って、俺はおまえが気に入っている。"
msgstr "\"To be honest, Soujyuro. You're growing on me."

#. Occurrence 2_3:752:2544: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0002; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:752
msgctxt "text_id=2544 | speaker=tobimaru"
msgid "　嘘のない人間なんてのは人間じゃねえ。"
msgstr "  Anybody that never lies can't really be considered human."

#. Occurrence 2_3:760:2545: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0003_0; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:760
msgctxt "text_id=2545 | speaker=tobimaru"
msgid "俺は人間嫌いだから、そんなおまえさんが気に入ってたりするんだが……"
msgstr "So for a misanthrope like me, I suppose you could say its easy to like you."

#. Occurrence 2_3:772:2546: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0003_1; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:772
msgctxt "text_id=2546 | speaker=tobimaru"
msgid "そんなヤツまでバカげたコトを言い出したら、俺は明日から何を頼りに昼メシを食えばいいんだ？」"
msgstr " But if you're gonna stick to your dumb story, I'm not sure what I'm going to do for lunch starting tomorrow.\""

#. Occurrence 2_3:791:2547: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0002; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:791
msgctxt "text_id=2547 | speaker=soujuurou"
msgid "「学食で食べればいいんじゃないか？」"
msgstr "\"Why not just eat in the cafeteria?\""

#. Occurrence 2_3:796:2548: scene=2_3
#: 2_3:796
msgctxt "text_id=2548 | speaker=unknown"
msgid "　あっさりとした一言に、鳶丸はいっそう表情を暗くする。"
msgstr "  Hearing his suggestion, Tobimaru's face darkened."

#. Occurrence 2_3:826:2549: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0004; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:826
msgctxt "text_id=2549 | speaker=tobimaru"
msgid "「分かった、はっきり言おう。それは幻覚だ。"
msgstr "\"Okay. I'll spell it out for you. You were hallucinating."

#. Occurrence 2_3:832:2550: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0005; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:832
msgctxt "text_id=2550 | speaker=tobimaru"
msgid "　幽霊の正体見たり<枯|か>れ<尾花|おばな>ってヤツだろうさ。それでも納得いかないってんなら、いい精神科を紹介してやる」"
msgstr "  If you still insist you saw a ghost, I'd be more than happy to introduce you to a good psychiatrist.\""

#. Occurrence 2_3:858:2551: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0003; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:858
msgctxt "text_id=2551 | speaker=soujuurou"
msgid "「それが君の感想か。よし、ならいいんだ」"
msgstr "\"So that's your take on it. Good to know.\""

#. Occurrence 2_3:863:2552: scene=2_3
#: 2_3:863
msgctxt "text_id=2552 | speaker=unknown"
msgid "　聞きようによっては侮辱としか取れない鳶丸の言葉を、草十郎は<泰然|たいぜん>と受けとめた。"
msgstr "  As bitter as Tobimaru's words might have sounded to most, Soujyuro swallowed them whole."

#. Occurrence 2_3:889:2553: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0004; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:889
msgctxt "text_id=2553 | speaker=soujuurou"
msgid "「そりゃあ俺だって神隠しの<類|たぐい>だと思ったよ。"
msgstr "\"I already figured as much. It sounds like a tall tale to me, too."

#. Occurrence 2_3:900:2554: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0005; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:900
msgctxt "text_id=2554 | speaker=soujuurou"
msgid "　けど、都会じゃもしかしてそれも有りなのかもしれないだろ。確かめたかったのはそこなんだ」"
msgstr "  I was starting to wonder if it was normal for that kind of thing to go on in a city, so I wanted to hear your opinion.\""

#. Occurrence 2_3:928:2555: scene=2_3
#: 2_3:928
msgctxt "text_id=2555 | speaker=unknown"
msgid "　良かった、とばかりに草十郎は残った最後の握り飯をぺろっと平らげ、包み布をたたむ。"
msgstr "  Satisfied, Soujyuro finished off his last rice ball and neatly folded the cloth."

#. Occurrence 2_3:955:2556: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0006; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:955
msgctxt "text_id=2556 | speaker=tobimaru"
msgid "「……おい。すると何か？"
msgstr "\"Hey, hold on a second."

#. Occurrence 2_3:961:2557: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0007; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:961
msgctxt "text_id=2557 | speaker=tobimaru"
msgid "　おまえは都会の人間は口から火を吹いたり、腕が伸びたりするのが普通だと思ったのか？」"
msgstr "  You didn't actually think it was normal for people in the city to breathe fire or extend their arms like they're made of rubber, did you?\""

#. Occurrence 2_3:967:2558: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0006; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:967
msgctxt "text_id=2558 | speaker=soujuurou"
msgid "「……まあ、普通じゃないけど、特別でもないんじゃないかと思ったんだ。"
msgstr "\"Well, not normal, as much as within the realm of possibility."

#. Occurrence 2_3:973:2559: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0007; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:973
msgctxt "text_id=2559 | speaker=soujuurou"
msgid "　ここは山に無い物があふれている、何でもありの場所だ。だから、それぐらいやってのける人だって、もしかしているのかなと」"
msgstr "  This city is full of extraordinary things we don't have up in the mountains. I thought it might have some extraordinary people as well.\""

#. Occurrence 2_3:1015:2560: scene=2_3
#: 2_3:1015
msgctxt "text_id=2560 | speaker=unknown"
msgid "　真顔で返す草十郎を見て、鳶丸は自分と彼を<隔|へだ>てている文化レベルの違いを痛感した。"
msgstr "  That his face was as serious as it was made Tobimaru realize just how big a culture shock Soujyuro must've been experiencing."

#. Occurrence 2_3:1020:2561: scene=2_3
#: 2_3:1020
msgctxt "text_id=2561 | speaker=unknown"
msgid "　電気も通わない山奥。"
msgstr "  Living up in the mountains, with no electricity."

#. Occurrence 2_3:1025:2562: scene=2_3
#: 2_3:1025
msgctxt "text_id=2562 | speaker=unknown"
msgid "　夜は太古のままの夜で、人間は主役ではなくどうでもいい端役、自然を構築する一パーツに留まっているのなら、たしかに、この少年のような人間が出来るのだろう。"
msgstr "  In a place where the night sky was as it always had been, where humans were just one more organism in nature's garden. It makes sense that those conditions would create a boy like him."

#. Occurrence 2_3:1070:2563: scene=2_3
#: 2_3:1070
msgctxt "text_id=2563 | speaker=unknown"
msgid "　赤子が無垢なまま成長したと言えば聞こえはいいが、要は人が少なすぎて文明が発達するまでもなかった、"
msgstr "  The idea of children growing up so pure was an appealing one, but maybe it was natural to forgo civilization when your population was so small."

#. Occurrence 2_3:1075:2564: scene=2_3
#: 2_3:1075
msgctxt "text_id=2564 | speaker=unknown"
msgid "　あるいは、余分な知識体系を必要としなかった素朴な世界だったのだ。"
msgstr "  Or perhaps it was so simple a world that excessive knowledge was deemed irrelevant."

#. Occurrence 2_3:1081:2565: scene=2_3
#: 2_3:1081
msgctxt "text_id=2565 | speaker=unknown"
msgid "　都会の生活を“今までの生活では全てありえなかった事”と感じる彼だからこそ、逆説的に、“起こりえる事は全てありえる事”に取ってしまう。"
msgstr "  It was precisely because city life offered him so much that was impossible up till now that he had come to the conclusion that anything was possible here."

#. Occurrence 2_3:1118:2566: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0008; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1118
msgctxt "text_id=2566 | speaker=tobimaru"
msgid "「安心しろ。たしかにこっちには<性質|たち>の悪いヤツらばっかりだけどな、そんな魔法使いみたいなヤツはいねえよ」"
msgstr "\"Relax. The city might have its share of shady guys, but none of them are magicians in disguise.\""

#. Occurrence 2_3:1124:2567: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0008; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1124
msgctxt "text_id=2567 | speaker=soujuurou"
msgid "「そうだと良いんだけど」"
msgstr "\"I hope you're right.\""

#. Occurrence 2_3:1130:2568: scene=2_3
#: 2_3:1130
msgctxt "text_id=2568 | speaker=unknown"
msgid "　どこか納得のいかない様子の草十郎。"
msgstr "  But Soujyuro seemed unsure."

#. Occurrence 2_3:1135:2569: scene=2_3
#: 2_3:1135
msgctxt "text_id=2569 | speaker=unknown"
msgid "　……確かに、今の話の中で納得のいかない点は鳶丸にもあった。"
msgstr "  And on Tobimaru's part, there were things to Soujyuro's story that he found hard to swallow."

#. Occurrence 2_3:1141:2570: scene=2_3
#: 2_3:1141
msgctxt "text_id=2570 | speaker=unknown"
msgid "アリかナシかはともかくとして、いま聞かされた出来事は人道的によろしくない。"
msgstr "Whether true or not, the incident Soujyuro had described was disturbing."

#. Occurrence 2_3:1188:2571: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0009; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1188
msgctxt "text_id=2571 | speaker=tobimaru"
msgid "「まあ、事の真偽というか、どんな間違いでそう見えたかは置いておいてだ。"
msgstr "\"For the time being, let's assume what you say actually happened."

#. Occurrence 2_3:1194:2572: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0010; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1194
msgctxt "text_id=2572 | speaker=tobimaru"
msgid "　結果だけ見ればうちの生徒が夜の公園で人を殺したって事になる。しかも双方控えめに表現しても普通じゃねえ」"
msgstr "  That would ultimately mean that one of our school's students killed someone in the park last night and that neither of the parties involved were... normal.\""

#. Occurrence 2_3:1199:2573: scene=2_3
#: 2_3:1199
msgctxt "text_id=2573 | speaker=unknown"
msgid "　町にやってきて日の浅い草十郎は、同い年の少年少女は『みなこの学校の生徒である』と誤認していたのだが、幸か不幸か結論として間違いではなかった。"
msgstr "  As a newcomer to town, Soujyuro assumed that everyone his age was a student at this school. For better or worse, he was right."

#. Occurrence 2_3:1230:2574: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0011; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1230
msgctxt "text_id=2574 | speaker=tobimaru"
msgid "「一人は火炎放射器を持って、もう一人は……"
msgstr "\"One of them was equipped with a flamethrower, while the other..."

msgctxt "text_id=2575 | speaker=unknown"
msgid "まあ、なんだ。<長刀|なぎなた>でも持ち出したのか、刃物らしきものが何メートルも伸びたときた」"
msgstr " had a naginata... or at least a bladed weapon resembling one that was a good few feet in length.\""

#. Occurrence 2_3:1258:2576: scene=2_3
#: 2_3:1258
msgctxt "text_id=2576 | speaker=unknown"
msgid "　鳶丸の呆れ声を聞きながら、なるほど、と小さく頷く草十郎。こうして<他人|ひと>の口から聞くと、相手を馬鹿にしてるとしか思えない内容だ。"
msgstr "  Soujyuro bobbed his head up and down as he listened to the disbelief in Tobimaru's voice. Hearing it repeated by someone else, he could see how someone might think he was taking them for a ride."

#. Occurrence 2_3:1301:2577: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0009; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1301
msgctxt "text_id=2577 | speaker=soujuurou"
msgid "「正気を疑うな。尋常じゃないぞ、その話」"
msgstr "\"Look, I'm not crazy, it really did happen like I said.\""

#. Occurrence 2_3:1338:2578: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0012; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1338
msgctxt "text_id=2578 | speaker=tobimaru"
msgid "「草十郎。おまえ、実は俺をからかってんだろう？」"
msgstr "\"Give it to me straight, Soujyuro. You're pulling my leg, aren't you?\""

#. Occurrence 2_3:1365:2579: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0010; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1365
msgctxt "text_id=2579 | speaker=soujuurou"
msgid "「いや、まったく。"
msgstr "\"No, I'm not."

#. Occurrence 2_3:1387:2580: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0011; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1387
msgctxt "text_id=2580 | speaker=soujuurou"
msgid "　けどまあ、都会にはそんな人間はいないんだろう？"
msgstr "  But I get it. There's no one in the city who can do that...right?"

#. Occurrence 2_3:1393:2581: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0012; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1393
msgctxt "text_id=2581 | speaker=soujuurou"
msgid "　なら鳶丸の言う通り、夢でも見てたんだ。ここのところアルバイトと試験が重なって辛くて」"
msgstr "  If not, I was probably just hallucinating like you said. Working part-time while studying for exams has been pretty trying.\""

#. Occurrence 2_3:1399:2582: scene=2_3
#: 2_3:1399
msgctxt "text_id=2582 | speaker=unknown"
msgid "　今は冬休み直前。期末試験は一週間後に迫っている。草十郎にとっては何よりも手強い難敵だ。"
msgstr "  Winter break was just around the corner and the end of term exams were but a week away. Both were proving formidable opponents for Soujyuro."

#. Occurrence 2_3:1420:2583: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0013; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1420
msgctxt "text_id=2583 | speaker=soujuurou"
msgid "「俺は基本ができてないから、人の倍程度の勉強じゃ追いつけない。ほら、勉強ばかりしているとノイローゼをするんだろう？」"
msgstr "\"I don't even know the basics, so I need to study twice as hard as everyone else. I mean, anyone would start to lose it if they did nothing but study, right?\""

#. Occurrence 2_3:1440:2584: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0013; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1440
msgctxt "text_id=2584 | speaker=tobimaru"
msgid "「そりゃするんじゃなくてなるものだが、ま、なんにせよやり過ぎ飲み過ぎはよくねえわな。試験前ぐらいはバイト減らしたらどうだ？」"
msgstr "\"I wouldn't say you're losing it, but you're definitely pushing yourself too hard. Maybe cut back on work a bit until the exams are over?\""

#. Occurrence 2_3:1468:2585: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0014; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1468
msgctxt "text_id=2585 | speaker=soujuurou"
msgid "「減らしてはいるんだけどね。年末ってアルバイトを休む人も多くて、その代行も頼まれがちだし」"
msgstr "\"I've tried to cut back, but a lot of people take off at the end of the year, so they often ask me to fill in for their shifts.\""

#. Occurrence 2_3:1473:2586: scene=2_3
#: 2_3:1473
msgctxt "text_id=2586 | speaker=unknown"
msgid "　草十郎はやれやれと肩をすくめる。"
msgstr "  He shrugged helplessly."

#. Occurrence 2_3:1485:2587: scene=2_3
#: 2_3:1485
msgctxt "text_id=2587 | speaker=unknown"
msgid "　その口ぶりから彼の忙しさは読み取れる。"
msgstr "  It was obvious from his words that he had been busy."

#. Occurrence 2_3:1490:2588: scene=2_3
#: 2_3:1490
msgctxt "text_id=2588 | speaker=unknown"
msgid "　ノイローゼはともかく、睡眠不足で白昼夢を見るぐらいあるかもしれない。……実際、その場面にでくわしたのは深夜とのコトではあるが。"
msgstr "  Even if he was not going crazy, lack of sleep could have caused him to daydream, even if this all did go down in the middle of the night."

#. Occurrence 2_3:1524:2589: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0014; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1524
msgctxt "text_id=2589 | speaker=tobimaru"
msgid "「なんだか大変そうだな、草十郎」"
msgstr "\"Sounds tough, Soujyuro.\""

#. Occurrence 2_3:1550:2590: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0015; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1550
msgctxt "text_id=2590 | speaker=soujuurou"
msgid "「ああ、実はかなりまいってる。都会の暮らしは深刻だ」"
msgstr "\"Yeah, city life has been exhausting.\""

#. Occurrence 2_3:1561:2591: scene=2_3
#: 2_3:1561
msgctxt "text_id=2591 | speaker=unknown"
msgid "　困ったもんだと真顔で頷く草十郎。"
msgstr "  Soujyuro nodded with a pained look on his face."

#. Occurrence 2_3:1566:2592: scene=2_3
#: 2_3:1566
msgctxt "text_id=2592 | speaker=unknown"
msgid "　毛ほども疲れていないように見えるのが困りものだった。"
msgstr "  What was strange, however, was that he did not look the least bit tired."

#. Occurrence 2_3:1616:2593: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0015; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1616
msgctxt "text_id=2593 | speaker=tobimaru"
msgid "「泣き言いわねえのは感心するけどな。"
msgstr "\"I'm impressed you never complain about it."

#. Occurrence 2_3:1616:2594: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0015; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1616
msgctxt "text_id=2594 | speaker=tobimaru"
msgid "　おまえ、心労は顔に出ない<性質|タチ>か？」"
msgstr "  You always look like nothing bothers you at all.\""

#. Occurrence 2_3:1622:2595: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0016; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1622
msgctxt "text_id=2595 | speaker=soujuurou"
msgid "「？　そりゃ、心労はどこも痛まないからね」"
msgstr "\"Hm? That's just because it isn't bad enough to bother me.\""

#. Occurrence 2_3:1628:2596: scene=2_3
#: 2_3:1628
msgctxt "text_id=2596 | speaker=unknown"
msgid "　答えて、草十郎はちらりと壁の時計を見る。"
msgstr "  As he answered, Soujyuro looked up at the clock on the wall."

#. Occurrence 2_3:1633:2597: scene=2_3
#: 2_3:1633
msgctxt "text_id=2597 | speaker=unknown"
msgid "　そろそろ昼休みも終わろうとしていた。"
msgstr "  Lunchtime was almost over."

#. Occurrence 2_3:1656:2598: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0017; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1656
msgctxt "text_id=2598 | speaker=soujuurou"
msgid "「鳶丸、時間だ」"
msgstr "\"Tobimaru, the time.\""

#. Occurrence 2_3:1662:2599: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0016; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1662
msgctxt "text_id=2599 | speaker=tobimaru"
msgid "「お？　ああ、もうそんなに経ったか。気にせず先に行ってていいぜ。俺はまだ用があるからよ」"
msgstr "\"Really? It's that late already? You can go on ahead. I still have things to do.\""

#. Occurrence 2_3:1690:2600: scene=2_3
#: 2_3:1690
msgctxt "text_id=2600 | speaker=unknown"
msgid "　生徒会役員は大変なんだとジェスチャーする鳶丸を、草十郎はマジマジと見つめる。"
msgstr "  Soujyuro watched as Tobimaru made a gesture that seemed to lament the life of a student council member."

#. Occurrence 2_3:1695:2601: scene=2_3
#: 2_3:1695
msgctxt "text_id=2601 | speaker=unknown"
msgid "　価値の分からない美術品を見るような目で。"
msgstr "  His eyes looked as if they were looking at a piece of art and not understanding its value."

#. Occurrence 2_3:1721:2602: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0018; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1721
msgctxt "text_id=2602 | speaker=soujuurou"
msgid "「授業をさぼれる身分っていうのは羨ましいな。"
msgstr "\"I'm jealous that you can just skip class whenever you want."

#. Occurrence 2_3:1727:2603: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0019; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1727
msgctxt "text_id=2603 | speaker=soujuurou"
msgid "　そういうの、鳶丸が嫌いな手抜きじゃないのか？」"
msgstr "  I would have thought you were a stickler for the rules.\""

#. Occurrence 2_3:1765:2604: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0017; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1765
msgctxt "text_id=2604 | speaker=tobimaru"
msgid "「そりゃ誤解も<甚|はなは>だしい！　俺の欠席は手抜きじゃねえ、特権ってヤツだと言ったろう!?」"
msgstr "\"How many times do I have to tell you?! It's not skipping when I've got special permission!\""

#. Occurrence 2_3:1771:2605: scene=2_3
#: 2_3:1771
msgctxt "text_id=2605 | speaker=unknown"
msgid "　心外だ、とばかりに席を立って力説する副会長。"
msgstr "  The vice president angrily defended himself as he stood up."

#. Occurrence 2_3:1776:2606: scene=2_3
#: 2_3:1776
msgctxt "text_id=2606 | speaker=unknown"
msgid "　それをふーん、と無感動に眺める転入生。"
msgstr "  The transfer student merely gazed at him, unfazed."

#. Occurrence 2_3:1803:2607: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0018; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1803
msgctxt "text_id=2607 | speaker=tobimaru"
msgid "「おいおい、アレだけ説明したのにぜんっぜん分かってなかったのか!?"
msgstr "\"Hey! You're not honestly implying you still don't understand after all that, are you?!"

#. Occurrence 2_3:1809:2608: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0019; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1809
msgctxt "text_id=2608 | speaker=tobimaru"
msgid "　しょうがねえ、まず座れ。いいか草の字。"
msgstr "  Oh well. Just sit down and listen, Sono-G."

#. Occurrence 2_3:1815:2609: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0020; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1815
msgctxt "text_id=2609 | speaker=tobimaru"
msgid "　常人をうわまわる英気と幸運を兼ね備えながら、座する事なく精進してきた俺でも、ここを卒業しちまえば裸一貫になっちまうんだぞ？」"
msgstr "  I was granted talent and luck beyond that of most people, but I always put the work in. But once I leave here I'm on my own, now do you get it?\""

#. Occurrence 2_3:1842:2610: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0021; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1842
msgctxt "text_id=2610 | speaker=tobimaru"
msgid "「ひでえ話だ。"
msgstr "\"I'm sick of explaining this to people."

#. Occurrence 2_3:1848:2611: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0022; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1848
msgctxt "text_id=2611 | speaker=tobimaru"
msgid "　<自分|テメエ>の家柄を活用できんのはあと一年ちょいだけなんだぜ？　これの一体どこが羨ましいってんだ？"
msgstr "  My family's status will only keep me afloat for one more year. What about that could you possibly envy?"

#. Occurrence 2_3:1854:2612: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0023; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1854
msgctxt "text_id=2612 | speaker=tobimaru"
msgid "　ふつう一生続くはずの親の七光って<権利|ヤツ>が、俺の場合はたった三年間しかねえんだからな！」"
msgstr "  Most people can live off privilege for their entire lives, but the best I get is three measly years!\""

#. Occurrence 2_3:1881:2613: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0024; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1881
msgctxt "text_id=2613 | speaker=tobimaru"
msgid "「となりゃあ、有効なうちに使っておかなきゃもったいなくてオチオチ眠ってもいられねえ。"
msgstr "\"So I have to take advantage of what I have while I have it."

#. Occurrence 2_3:1887:2614: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0025; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:1887
msgctxt "text_id=2614 | speaker=tobimaru"
msgid "　ああイヤだイヤだ、何がイヤかってバカどもと<雁首|がんくび>ならべて金勘定するのがイヤだ！　ったく、嫉妬渦巻く大人の世界じゃ俺のオブラートみたいな心なんてぱっくり呑まれて溶けちまうコト請け合いだろうさ！」"
msgstr "  Just the thought of having to count beans like the rest of the idiots out there gets me livid. The adult world is going to kill me. The envy alone will be enough to destroy my fragile heart!\""

#. Occurrence 2_3:1935:2615: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0020; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:1935
msgctxt "text_id=2615 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 2_3:1940:2616: scene=2_3
#: 2_3:1940
msgctxt "text_id=2616 | speaker=unknown"
msgid "　冗談にしか取れない熱弁は、草十郎の聞くかぎりどうも本気のようだった。"
msgstr "  While he must have been joking, Soujyuro took his tone to be completely sincere."

#. Occurrence 2_3:1951:2617: scene=2_3
#: 2_3:1951
msgctxt "text_id=2617 | speaker=unknown"
msgid "　そういう事を本気で言える人間性が羨ましい、などと思いつつ、草十郎はなるほど、と納得する。"
msgstr "  He listened as he envied Tobimaru's ability to be so open about his feelings."

#. Occurrence 2_3:1956:2618: scene=2_3
#: 2_3:1956
msgctxt "text_id=2618 | speaker=unknown"
msgid "　本人が言うのだから彼の主観的には正しいのだろうと。"
msgstr "  From his frame of reference, there was nothing he could do but take Tobimaru for his word."

#. Occurrence 2_3:1961:2619: scene=2_3
#: 2_3:1961
msgctxt "text_id=2619 | speaker=unknown"
msgid "　だが、"
msgstr "  When..."

#. Occurrence 2_3:1985:2620: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0004; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:1985
msgctxt "text_id=2620 | speaker=aoko"
msgid "「あら、そんな権利なんて留年すればいくらでも引き延ばせるのに。なんなら協力してあげましょうか、この私でよろしければ」"
msgstr "\"If you're looking to extend your privileges, why not stay in school? I'd be more than happy to arrange that for you.\""

#. Occurrence 2_3:1997:2621: scene=2_3
#: 2_3:1997
msgctxt "text_id=2621 | speaker=unknown"
msgid "　草十郎の骨のない相づちを蹴散らすように、生徒会室の扉が勢いよく開かれた。"
msgstr "  The door to the student council room flew open, washing away Soujyuro's half-hearted responses to his friend."

#. Occurrence 2_3:2036:2622: scene=2_3
#: 2_3:2036
msgctxt "text_id=2622 | speaker=unknown"
msgid "　ほんわかした空気を一撃で打ち砕く<冷静|クール>な一言。"
msgstr "  This frosty statement destroyed the warm atmosphere of the room."

#. Occurrence 2_3:2041:2623: scene=2_3
#: 2_3:2041
msgctxt "text_id=2623 | speaker=unknown"
msgid "　槻司鳶丸にあったこの場の支配権は、<蝙蝠|こうもり>より<潔|いさぎよ>く彼女の手に飛び立ったのだった。"
msgstr "  And it also marked the abrupt end to Tobimaru Tsukiji's reign there."

#. Occurrence 2_3:2067:2624: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0026; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:2067
msgctxt "text_id=2624 | speaker=tobimaru"
msgid "「……いや、いい。自分の夢は、自分の力だけで叶えようとつねづね思ってるんだ」"
msgstr "\"...No, I just meant that our dreams are something we take hold of ourselves.\""

#. Occurrence 2_3:2073:2625: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0005; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2073
msgctxt "text_id=2625 | speaker=aoko"
msgid "「そ。なら今みたいな恥ずかしいこと力説しないでね。"
msgstr "\"Really. Then why not spend more time on that than this pathetic display."

#. Occurrence 2_3:2073:2626: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0005; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2073
msgctxt "text_id=2626 | speaker=aoko"
msgid "　廊下にまで聞こえてたわよ、副会長さん」"
msgstr "  I could hear you all the way from the hallway, Mr. Vice President.\""

#. Occurrence 2_3:2119:2627: scene=2_3
#: 2_3:2119
msgctxt "text_id=2627 | speaker=unknown"
msgid "　さらりと言って、彼女……蒼崎青子が生徒会室に入ってくる。"
msgstr "  Not missing a beat, Aoko Aozaki stepped inside the room."

#. Occurrence 2_3:2124:2628: scene=2_3
#: 2_3:2124
msgctxt "text_id=2628 | speaker=unknown"
msgid "　長い黒髪がわずかに乱れているのは、ここまで走ってきたせいか。"
msgstr "  Her dark hair was slightly disheveled as if she had been running."

#. Occurrence 2_3:2129:2629: scene=2_3
#: 2_3:2129
msgctxt "text_id=2629 | speaker=unknown"
msgid "　青子の視線は座ったままの草十郎にではなく、熱弁していた副会長に向けられている。"
msgstr "  Her gaze missed the sitting Soujyuro entirely and was focused completely on the ranting vice president."

#. Occurrence 2_3:2177:2630: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0021; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2177
msgctxt "text_id=2630 | speaker=soujuurou"
msgid "「頑張れ、鳶丸」"
msgstr "\"Good luck, Tobimaru.\""

#. Occurrence 2_3:2189:2631: scene=2_3
#: 2_3:2189
msgctxt "text_id=2631 | speaker=unknown"
msgid "　そろそろ教室に戻らないといけない、と草十郎は静かに立ち上がる。"
msgstr "  Soujyuro quietly got up to head back to his classroom."

#. Occurrence 2_3:2195:2632: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0027; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:2195
msgctxt "text_id=2632 | speaker=tobimaru"
msgid "「……わりと薄情なんだな、おまえって」"
msgstr "\"...That's cold, man.\""

#. Occurrence 2_3:2225:2633: scene=2_3
#: 2_3:2225
msgctxt "text_id=2633 | speaker=unknown"
msgid "　青子を前にして呟く鳶丸。"
msgstr "  Tobimaru grumbled in front of Aoko."

#. Occurrence 2_3:2266:2634: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0022; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2266
msgctxt "text_id=2634 | speaker=soujuurou"
msgid "「だって時間がない」"
msgstr "\"But it's almost time for class.\""

#. Occurrence 2_3:2290:2635: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0028; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:2290
msgctxt "text_id=2635 | speaker=tobimaru"
msgid "「だから、そういうのが薄情とだな……」"
msgstr "\"You're just proving my point, you're-\""

#. Occurrence 2_3:2295:2636: scene=2_3
#: 2_3:2295
msgctxt "text_id=2636 | speaker=unknown"
msgid "　言いかけて言葉を呑む鳶丸。"
msgstr "  He cut himself off."

#. Occurrence 2_3:2315:2637: scene=2_3
#: 2_3:2315
msgctxt "text_id=2637 | speaker=unknown"
msgid "　今まで自分しか見ていなかった青子の視線が、草十郎をちらりと見たからだ。"
msgstr "  Aoko briefly shifted her gaze to Soujyuro."

#. Occurrence 2_3:2357:2638: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0006; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2357
msgctxt "text_id=2638 | speaker=aoko"
msgid "「時間がないのは私も同じよ。貴方にはいつも振り回される」"
msgstr "\"It's not like I have time for this, either, you know. It feels like I'm always having to clean up after you.\""

#. Occurrence 2_3:2363:2639: scene=2_3
#: 2_3:2363
msgctxt "text_id=2639 | speaker=unknown"
msgid "　これは文句ではなく、素直な意見らしい。"
msgstr "  Not a complaint. It was her honest opinion."

#. Occurrence 2_3:2377:2640: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0029; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:2377
msgctxt "text_id=2640 | speaker=tobimaru"
msgid "「なんだ、用件は草十郎かよ」"
msgstr "\"Wait, you're here for Soujyuro?\""

#. Occurrence 2_3:2388:2641: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0007; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2388
msgctxt "text_id=2641 | speaker=aoko"
msgid "「安心なさい、貴方にもあるから」"
msgstr "\"Don't worry. I'll deal with you next.\""

#. Occurrence 2_3:2425:2642: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_3_0030; voice_prefix=B70; voice_category=4; scene=2_3
#: 2_3:2425
msgctxt "text_id=2642 | speaker=tobimaru"
msgid "「……？」"
msgstr "\"...?\""

#. Occurrence 2_3:2430:2643: scene=2_3
#: 2_3:2430
msgctxt "text_id=2643 | speaker=unknown"
msgid "　心なしか、青子の目に殺伐とした<翳|かげ>りがある。"
msgstr "  Her eyes shimmered with a murderous glee."

#. Occurrence 2_3:2435:2644: scene=2_3
#: 2_3:2435
msgctxt "text_id=2644 | speaker=unknown"
msgid "　いつも不機嫌そうな青子の視線に見慣れている鳶丸だからこそ気づける、微妙な差異だ。"
msgstr "  It was slightly different from the more sullen gaze to which Tobimaru had grown accustomed."

#. Occurrence 2_3:2440:2645: scene=2_3
#: 2_3:2440
msgctxt "text_id=2645 | speaker=unknown"
msgid "　……理由は不明だが、蒼崎青子はいつになくご機嫌ななめという事らしい。"
msgstr "  For whatever reason, Aoko's mood seemed worse than usual."

#. Occurrence 2_3:2475:2646: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0008; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2475
msgctxt "text_id=2646 | speaker=aoko"
msgid "「静希君。貴方、走るのと泳ぐの、どっちが好き？」"
msgstr "\"Sizuki. Which do you prefer, running or swimming?\""

#. Occurrence 2_3:2494:2647: scene=2_3
#: 2_3:2494
msgctxt "text_id=2647 | speaker=unknown"
msgid "　唐突に青子が訊ねる。"
msgstr "  Aoko asked abruptly."

#. Occurrence 2_3:2499:2648: scene=2_3
#: 2_3:2499
msgctxt "text_id=2648 | speaker=unknown"
msgid "　草十郎は少し顔を曇らせてから、どっちも、と答えた。"
msgstr "  Soujyuro frowned a little before saying he was fine with either one."

#. Occurrence 2_3:2505:2649: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0009; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2505
msgctxt "text_id=2649 | speaker=aoko"
msgid "「だめよ、ひとつにして」"
msgstr "\"That won't do. Pick one.\""

#. Occurrence 2_3:2531:2650: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0023; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2531
msgctxt "text_id=2650 | speaker=soujuurou"
msgid "「……泳ぐほう、かな。けど、どうして？」"
msgstr "\"...Swimming, I guess. Why do you ask?\""

#. Occurrence 2_3:2537:2651: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0010; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2537
msgctxt "text_id=2651 | speaker=aoko"
msgid "「貴方がまだどこの部にも所属してないから」"
msgstr "\"Because you still haven't joined a club.\""

#. Occurrence 2_3:2542:2652: scene=2_3
#: 2_3:2542
msgctxt "text_id=2652 | speaker=unknown"
msgid "　実に無駄のない答えだった。"
msgstr "  A succinct reply."

#. Occurrence 2_3:2547:2653: scene=2_3
#: 2_3:2547
msgctxt "text_id=2653 | speaker=unknown"
msgid "　無駄がなさすぎて、草十郎の意見をはさむ隙間もない。"
msgstr "  One that left no room for Soujyuro to object."

#. Occurrence 2_3:2595:2654: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0011; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2595
msgctxt "text_id=2654 | speaker=aoko"
msgid "「うちの校則、読んだわよね。生徒はただ一人の例外もなく部活動に参加しなくてはならない。"
msgstr "\"You've read the school regulations. All students must participate in club activities."

#. Occurrence 2_3:2601:2655: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0012; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2601
msgctxt "text_id=2655 | speaker=aoko"
msgid "　正直どうかと思う校則だけど、決まりは決まりだから」"
msgstr "  I'm not the biggest fan of it myself, to be honest, but a rule is a rule.\""

#. Occurrence 2_3:2607:2656: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0024; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2607
msgctxt "text_id=2656 | speaker=soujuurou"
msgid "「そんな無茶な。悪いけど、そこまでの暇はないんだ」"
msgstr "\"That's crazy. How could I possibly find the time for that?\""

#. Occurrence 2_3:2625:2657: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0013; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2625
msgctxt "text_id=2657 | speaker=aoko"
msgid "「でしょうね」"
msgstr "\"How indeed?\""

#. Occurrence 2_3:2630:2658: scene=2_3
#: 2_3:2630
msgctxt "text_id=2658 | speaker=unknown"
msgid "　短い返答。"
msgstr "  An equally terse response."

#. Occurrence 2_3:2647:2659: scene=2_3
#: 2_3:2647
msgctxt "text_id=2659 | speaker=unknown"
msgid "　青子に容赦がないのはいつもの事だが、鳶丸には、彼女が草十郎との会話を避けているようにも見える。"
msgstr "  She was typically to the point, but Tobimaru got the impression that she was expressly trying to keep her interaction with Soujyuro short."

#. Occurrence 2_3:2694:2660: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0014; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2694
msgctxt "text_id=2660 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 2_3:2700:2661: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0025; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2700
msgctxt "text_id=2661 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 2_3:2706:2662: scene=2_3
#: 2_3:2706
msgctxt "text_id=2662 | speaker=unknown"
msgid "　無言で見つめあうふたり。"
msgstr "  They stared at each other in silence."

#. Occurrence 2_3:2711:2663: scene=2_3
#: 2_3:2711
msgctxt "text_id=2663 | speaker=unknown"
msgid "　第三者の鳶丸すら息がつまりそうな沈黙は、そうか、という草十郎の一言で破られた。"
msgstr "  Tobimaru stood breathlessly silent on the sidelines until Soujyuro broke the impasse."

#. Occurrence 2_3:2765:2664: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0026; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2765
msgctxt "text_id=2664 | speaker=soujuurou"
msgid "「蒼崎は分かってると思ってた。"
msgstr "\"I thought you of all people would understand, Aozaki."

#. Occurrence 2_3:2772:2665: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0027; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2772
msgctxt "text_id=2665 | speaker=soujuurou"
msgid "ああ、いや違う、きっと分かっているんだな。"
msgstr "I mean, of course you do."

#. Occurrence 2_3:2784:2666: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0028; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2784
msgctxt "text_id=2666 | speaker=soujuurou"
msgid "　うん。だから、そこが強いんだろうね」"
msgstr "  That's what makes you strong.\""

#. Occurrence 2_3:2807:2667: scene=2_3
#: 2_3:2807
msgctxt "text_id=2667 | speaker=unknown"
msgid "　席を離れる草十郎。"
msgstr "  Soujyuro stood up from his seat."

#. Occurrence 2_3:2825:2668: scene=2_3
#: 2_3:2825
msgctxt "text_id=2668 | speaker=unknown"
msgid "　青子の横を通り過ぎ、あっさりと廊下に出る。"
msgstr "  He walked past Aoko and into the hallway."

#. Occurrence 2_3:2846:2669: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_3_0029; voice_prefix=A30; voice_category=3; scene=2_3
#: 2_3:2846
msgctxt "text_id=2669 | speaker=soujuurou"
msgid "「それ、明日からでいいんだろ？」"
msgstr "\"Do you mind if I start tomorrow?\""

#. Occurrence 2_3:2859:2670: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_3_0015; voice_prefix=A10; voice_category=1; scene=2_3
#: 2_3:2859
msgctxt "text_id=2670 | speaker=aoko"
msgid "「静希君がいいならね」"
msgstr "\"Whatever works for you, Sizuki.\""

#. Occurrence 2_3:2880:2671: scene=2_3
#: 2_3:2880
msgctxt "text_id=2671 | speaker=unknown"
msgid "　できるだけ頑張るよ、と苦笑して、草十郎は生徒会室を後にした。"
msgstr "  He did his best to force a smile before leaving the student council room."

#. Occurrence 2_4:50:2672: scene=2_4
#: 2_4:50
msgctxt "text_id=2672 | speaker=unknown"
msgid "　そんな一連の出来事を観察しながら、鳶丸はつくづく草十郎に感心していた。"
msgstr "   While watching the events play out, Tobimaru found himself deeply impressed with Soujyuro."

#. Occurrence 2_4:80:2673: scene=2_4
#: 2_4:80
msgctxt "text_id=2673 | speaker=unknown"
msgid "　今の青子の態度は、相手を怒らせる事を前提としたものだ。しかし草十郎は怒りだす様子もなく、掴みどころのない……言ってるコトは本当に掴みようがなかったが……返答をして去っていった。"
msgstr "  He could tell from Aoko's behavior that she was trying to get a rise out of Soujyuro. Soujyuro, on the other hand, didn't react. Heedless of what Aoko was doing, he simply went on his way."

#. Occurrence 2_4:85:2674: scene=2_4
#: 2_4:85
msgctxt "text_id=2674 | speaker=unknown"
msgid "　草十郎とて少なからず不満に思っただろう。"
msgstr "  To Tobimaru, it was hard to believe that Soujyuro had not taken offense."

#. Occurrence 2_4:90:2675: scene=2_4
#: 2_4:90
msgctxt "text_id=2675 | speaker=unknown"
msgid "　それを表情にも仕草にも出さなかった事に、鳶丸は一流の芸を見た気がしたのである。"
msgstr "  From his point of view, Soujyuro's poker face had been the performance of a lifetime."

#. Occurrence 2_4:148:2676: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0000; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:148
msgctxt "text_id=2676 | speaker=tobimaru"
msgid "「いや、でも何が強いんだろうな会長？」"
msgstr "\"The kid has some balls, huh, president?\""

#. Occurrence 2_4:154:2677: scene=2_4
#: 2_4:154
msgctxt "text_id=2677 | speaker=unknown"
msgid "　鳶丸は首をかしげて青子を見る。"
msgstr "  He looked at Aoko curiously."

#. Occurrence 2_4:176:2678: scene=2_4
#: 2_4:176
msgctxt "text_id=2678 | speaker=unknown"
msgid "　青子は立ち尽くしたまま、じっと壁を睨んでいた。"
msgstr "  Aoko stood completely still, staring at the wall."

#. Occurrence 2_4:182:2679: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0001; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:182
msgctxt "text_id=2679 | speaker=tobimaru"
msgid "「……蒼崎？」"
msgstr "\"...Hey, Aozaki?\""

#. Occurrence 2_4:187:2680: scene=2_4
#: 2_4:187
msgctxt "text_id=2680 | speaker=unknown"
msgid "　鳶丸の呼び掛けに、青子は応えない。"
msgstr "  Aoko showed no response."

#. Occurrence 2_4:199:2681: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0002; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:199
msgctxt "text_id=2681 | speaker=tobimaru"
msgid "「おーい、かいちょー。蒼崎ぃー。……青子女史？"
msgstr "\"Yo. President. Earth to Aozaki, come in, come in. ...Lady Aoko?"

#. Occurrence 2_4:199:2682: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0002; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:199
msgctxt "text_id=2682 | speaker=tobimaru"
msgid "　……"
msgstr "  ..."

msgctxt "text_id=2683 | speaker=unknown"
msgid "おい、聞いてんのかよ蒼崎青子！」"
msgstr " Ahem. I'M TALKING TO YOU, AOKO AOZAKI!\""

#. Occurrence 2_4:260:2684: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0000; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:260
msgctxt "text_id=2684 | speaker=aoko"
msgid "「っさいわね！　あおあお呼ぶなっ！」"
msgstr "\"Enough with the 'AO, AO, AO,' already! God!\""

#. Occurrence 2_4:266:2685: scene=2_4
#: 2_4:266
msgctxt "text_id=2685 | speaker=unknown"
msgid "　怒鳴り声が生徒会室に響く。"
msgstr "  Her fury echoed across the student council room."

#. Occurrence 2_4:271:2686: scene=2_4
#: 2_4:271
msgctxt "text_id=2686 | speaker=unknown"
msgid "　さきほどの鳶丸の熱弁以上に、廊下にまで通る美声だった。"
msgstr "  It was a beautiful sound that could be heard into the hallway and made Tobimaru's rant from earlier pale in comparison."

#. Occurrence 2_4:308:2687: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0003; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:308
msgctxt "text_id=2687 | speaker=tobimaru"
msgid "「やかましい、うるせえのはテメエも同じだ！」"
msgstr "\"Look who's talking, miss megaphone!\""

#. Occurrence 2_4:313:2688: scene=2_4
#: 2_4:313
msgctxt "text_id=2688 | speaker=unknown"
msgid "　よほど耳に響いたのか、それとも怒鳴られたら怒鳴り返す性分なのか、鳶丸も反射的に言い返す。"
msgstr "  Perhaps her shouting was still ringing in his ears, or he was just the type to answer a shout with a shout, but he shot back reflexively."

#. Occurrence 2_4:319:2689: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0004; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:319
msgctxt "text_id=2689 | speaker=tobimaru"
msgid "「そんなんだから男の一人もできねえんだよ、おまえは。"
msgstr "\"No wonder you can't get a boyfriend."

#. Occurrence 2_4:319:2690: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0004; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:319
msgctxt "text_id=2690 | speaker=tobimaru"
msgid "　ほら、目ぇ覚めたか？」"
msgstr "  Do I have your attention now?\""

#. Occurrence 2_4:371:2691: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0001; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:371
msgctxt "text_id=2691 | speaker=aoko"
msgid "「別に、貴方の声は聞こえてた。わずらわしかったから無視してただけよ。黙らせるの面倒だし」"
msgstr "\"I could hear you before. I was just ignoring you because you were annoying me, and I thought it'd be easier than getting you to shut up.\""

#. Occurrence 2_4:391:2692: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0005; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:391
msgctxt "text_id=2692 | speaker=tobimaru"
msgid "「テメエな。俺は蚊かなんかか、おい」"
msgstr "\"You've got some nerve. Am I a mosquito to you?\""

#. Occurrence 2_4:402:2693: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0002; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:402
msgctxt "text_id=2693 | speaker=aoko"
msgid "「コミュニケーションが成立しない点で言えば、あっちのがまだ上品よね」"
msgstr "\"A mosquito would offer better company, so no.\""

#. Occurrence 2_4:440:2694: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0006; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:440
msgctxt "text_id=2694 | speaker=tobimaru"
msgid "「……ほう、その心は？」"
msgstr "\"...And what exactly is that supposed to mean?\""

#. Occurrence 2_4:461:2695: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0003; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:461
msgctxt "text_id=2695 | speaker=aoko"
msgid "「お互い、何を言ってるか分からない。意味のない会話なら、逢瀬みたいなものでしょう？」"
msgstr "\"We never see eye to eye. Talking to you is like going on a date, both pointless activities.\""

#. Occurrence 2_4:480:2696: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0007; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:480
msgctxt "text_id=2696 | speaker=tobimaru"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 2_4:485:2697: scene=2_4
#: 2_4:485
msgctxt "text_id=2697 | speaker=unknown"
msgid "　その論からいくと、彼女にとって恋人同士とは意味のない会話をするものらしい。"
msgstr "  Based on that statement, Aoko must have been under the assumption that dating was the act of two lovers whispering nonsense to each other."

#. Occurrence 2_4:518:2698: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0008; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:518
msgctxt "text_id=2698 | speaker=tobimaru"
msgid "「……問題は、おまえにとって意味のある会話ってのがどの程度の価値かってコトだが……まあいいか。"
msgstr "\"...The real question is what the hell qualifies as company to you, but whatever."

#. Occurrence 2_4:524:2699: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0009; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:524
msgctxt "text_id=2699 | speaker=tobimaru"
msgid "　いつになくきついじゃねえか、蒼崎」"
msgstr "  You're awfully harsh today, Aozaki.\""

#. Occurrence 2_4:530:2700: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0004; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:530
msgctxt "text_id=2700 | speaker=aoko"
msgid "「ちょっとね。いま愛嬌ふりまける状況じゃないのよ」"
msgstr "\"Maybe a little. This isn't exactly the time to make nice.\""

#. Occurrence 2_4:549:2701: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0010; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:549
msgctxt "text_id=2701 | speaker=tobimaru"
msgid "「不思議だ。この二年間で蒼崎の愛嬌なんてものは見たことがないんだが」"
msgstr "\"Funny you mention that―I haven't seen you try to be civil at all in the last two years.\""

#. Occurrence 2_4:575:2702: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0005; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:575
msgctxt "text_id=2702 | speaker=aoko"
msgid "「鳶丸のいない時にふりまいてたの」"
msgstr "\"Oh, I'm always civil―just not when you're in the same room.\""

#. Occurrence 2_4:598:2703: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0011; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:598
msgctxt "text_id=2703 | speaker=tobimaru"
msgid "「そうかよ。やっぱりあの時のこと恨んでるんだろ、生徒会長さんはよ」"
msgstr "\"So that's how it is. You're still upset with me for what happened, aren't you?\""

#. Occurrence 2_4:603:2704: scene=2_4
#: 2_4:603
msgctxt "text_id=2704 | speaker=unknown"
msgid "　鳶丸の言うあの時というのは一つしかない。"
msgstr "  There was only one thing that Tobimaru could be talking about--"

#. Occurrence 2_4:608:2705: scene=2_4
#: 2_4:608
msgctxt "text_id=2705 | speaker=unknown"
msgid "　今年の夏に起きた、生徒会室イン武道館事件の事である。"
msgstr "  the incident that occurred in the student council room this past summer."

#. Occurrence 2_4:643:2706: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0006; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:643
msgctxt "text_id=2706 | speaker=aoko"
msgid "「え、随分と昔の話じゃないそれ？"
msgstr "\"Huh? Isn't that ancient history at this point?"

#. Occurrence 2_4:649:2707: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0007; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:649
msgctxt "text_id=2707 | speaker=aoko"
msgid "　そんなどうでもいい事に容量を使っちゃもったいないわよ？　ただでさえ脳の覚醒部分が少ないのに」"
msgstr "  Don't you think you should stop wasting brainpower on this? I mean, you've got so few brain cells to work with as it is.\""

#. Occurrence 2_4:668:2708: scene=2_4
#: 2_4:668
msgctxt "text_id=2708 | speaker=unknown"
msgid "　会話が走ってきたおかげか、青子から先ほどまでの<殺伐|さつばつ>さが薄れつつあった。鋭い視線も、時たまにしか見せない<涼|すず>しげなものになる。"
msgstr "  As the conversation wore on, Aoko's murderous aura began to fade, and her sharp gaze gave way to a calmer demeanor rarely seen from her."

#. Occurrence 2_4:673:2709: scene=2_4
#: 2_4:673
msgctxt "text_id=2709 | speaker=unknown"
msgid "　学校内で彼女のこういった顔を見られるのは、今のところ槻司鳶丸だけだろう。"
msgstr "  It was quite possible that nobody besides Tobimaru had ever seen this side of her at school before."

#. Occurrence 2_4:707:2710: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0012; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:707
msgctxt "text_id=2710 | speaker=tobimaru"
msgid "「ご忠告どうも。俺だってあんな事は忘れてえよ。"
msgstr "\"Thanks for the concern, psych. And for the record, it's not like I want to relive it either."

#. Occurrence 2_4:718:2711: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0013; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:718
msgctxt "text_id=2711 | speaker=tobimaru"
msgid "　……ただ、さっき草の字が馬鹿な事いいやがるからつい思い出しちまったんだよ。くそ、考えてみりゃあ場所まで一緒じゃねえか！」"
msgstr "  ...It's just, when Sono-G was being an idiot earlier, it kinda reminded me of how it went down. Come to think of it, this is the room it happened in!\""

#. Occurrence 2_4:731:2712: scene=2_4
#: 2_4:731
msgctxt "text_id=2712 | speaker=unknown"
msgid "　などと悪態をつきながらも、まんざらでもなさげに過去を懐かしむ鳶丸。"
msgstr "  Despite his ranting, his face betrayed a touch of nostalgia."

#. Occurrence 2_4:756:2713: scene=2_4
#: 2_4:756
msgctxt "text_id=2713 | speaker=unknown"
msgid "　一方、青子は顔をしかめる。"
msgstr "  Aoko, on the other hand, was scowling."

#. Occurrence 2_4:778:2714: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0008; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:778
msgctxt "text_id=2714 | speaker=aoko"
msgid "「ちょっと待って。"
msgstr "\"Hold on."

#. Occurrence 2_4:784:2715: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0009; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:784
msgctxt "text_id=2715 | speaker=aoko"
msgid "　あの話、彼にしたの……？」"
msgstr "  You didn't tell him about what happened, did you?\""

#. Occurrence 2_4:804:2716: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0014; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:804
msgctxt "text_id=2716 | speaker=tobimaru"
msgid "「おう、俺がテメエに"
msgstr "\"Sure did. At least, "

#. Occurrence 2_4:804:2717: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0014; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:804
msgctxt "text_id=2717 | speaker=tobimaru"
msgid "“なんで会長になんか立候補したのよ。アンタは副会長って顔でしょ、どう見ても”"
msgstr "how you mocked my candidacy for president and told me my face had sidekick written all over it."

#. Occurrence 2_4:804:2718: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0014; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:804
msgctxt "text_id=2718 | speaker=tobimaru"
msgid "　なんて挑発されて、生涯最高の突きをしたところまでな」"
msgstr "  And the part where I took the bait and tried my damnedest to punch you for it.\""

#. Occurrence 2_4:827:2719: scene=2_4
#: 2_4:827
msgctxt "text_id=2719 | speaker=unknown"
msgid "　何故か、ほう、と青子は息をついた。その先を知られなくて良かった、という風に。"
msgstr "  Aoko let out a sigh... as if relieved that Tobimaru had not told Soujyuro the rest of the story."

#. Occurrence 2_4:846:2720: scene=2_4
#: 2_4:846
msgctxt "text_id=2720 | speaker=unknown"
msgid "　何故だかは鳶丸にも青子自身にも分からない。"
msgstr "  Even she wasn't sure why."

#. Occurrence 2_4:884:2721: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0010; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:884
msgctxt "text_id=2721 | speaker=aoko"
msgid "「アレはたしかに、びっくりするぐらいいい突きだった。"
msgstr "\"I'll admit that was quite a punch though."

#. Occurrence 2_4:884:2722: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0010; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:884
msgctxt "text_id=2722 | speaker=aoko"
msgid "　思わず体が反応しちゃったものね。"
msgstr "  It was enough to make me react on reflex."

#. Occurrence 2_4:890:2723: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0011; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:890
msgctxt "text_id=2723 | speaker=aoko"
msgid "　ところで、私そんなコト言ったっけ？」"
msgstr "  Did I really say that, by the way?\""

#. Occurrence 2_4:901:2724: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0015; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:901
msgctxt "text_id=2724 | speaker=tobimaru"
msgid "「言った。しかも俺が保健室に運ばれたのをこれ幸いと、強引に副会長にしやがった」"
msgstr "\"You sure did. And not only that―after I was taken to the infirmary, you had the balls to tell me you did me a favor by forcing me to be your number two.\""

#. Occurrence 2_4:924:2725: scene=2_4
#: 2_4:924
msgctxt "text_id=2725 | speaker=unknown"
msgid "　以来、鳶丸は選挙戦で負けた相手に副会長として使われているのであった。"
msgstr "  Since that day, Tobimaru had served as the vice president to the person who'd usurped the role from him."

#. Occurrence 2_4:951:2726: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0016; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:951
msgctxt "text_id=2726 | speaker=tobimaru"
msgid "「いいけどな。俺に会長職は合わねえって分かったし。副会長の方が性に合ってやがる。会長なんてやってたら、あやうく親父みたいな野郎になってただろうしよ」"
msgstr "\"It's fine, though. The president's chair doesn't suit me anyway. I feel much more at home as the vice president. Your job would have probably turned me into my dad.\""

#. Occurrence 2_4:985:2727: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0012; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:985
msgctxt "text_id=2727 | speaker=aoko"
msgid "「プライド高い分、できるコトは全部やるからね鳶丸は。"
msgstr "\"Your pride's never allowed you to give anything less than your best."

#. Occurrence 2_4:996:2728: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0013; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:996
msgctxt "text_id=2728 | speaker=aoko"
msgid "　ま、会長職に専心するあまり、気が付いたら優等生になってたアンタも見たかったけど？」"
msgstr "  You might be a little too comfortable on the student council, though. Makes me wonder how you would've looked as an honor student.\""

#. Occurrence 2_4:1030:2729: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0017; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1030
msgctxt "text_id=2729 | speaker=tobimaru"
msgid "「やめてくれ、ゾッとしねえ。"
msgstr "\"Don't even go there. Even thinking about it gives me the creeps."

#. Occurrence 2_4:1036:2730: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0018; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1036
msgctxt "text_id=2730 | speaker=tobimaru"
msgid "　ネコかぶるのはおまえだけで十分だ」"
msgstr "  Having one wolf in sheep's clothing around here is bad enough.\""

#. Occurrence 2_4:1047:2731: scene=2_4
#: 2_4:1047
msgctxt "text_id=2731 | speaker=unknown"
msgid "　しっしっ、と青子に手を振る鳶丸。"
msgstr "  Tobimaru shooed Aoko away like an annoying pest."

#. Occurrence 2_4:1052:2732: scene=2_4
#: 2_4:1052
msgctxt "text_id=2732 | speaker=unknown"
msgid "　男女にあるまじき戦いを繰り広げた者特有の、実にさっぱりした<罵|ののし>り合いだった。"
msgstr "  It was a typical example of the crude verbal abuse they exchanged on a daily basis, with a wittiness that only two longtime foes could manage."

#. Occurrence 2_4:1089:2733: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0014; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1089
msgctxt "text_id=2733 | speaker=aoko"
msgid "「―――で。"
msgstr "\"So..."

msgctxt "text_id=2734 | speaker=unknown"
msgid "なんでそんな話したのよ」"
msgstr " Why did you tell him?\""

#. Occurrence 2_4:1112:2735: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0019; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1112
msgctxt "text_id=2735 | speaker=tobimaru"
msgid "「は？」"
msgstr "\"Tell who what?\""

#. Occurrence 2_4:1118:2736: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0015; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1118
msgctxt "text_id=2736 | speaker=aoko"
msgid "「半年前の、ここの事件を、なんで彼に話したのよ」"
msgstr "\"Why did you tell him what happened between you and me?\""

#. Occurrence 2_4:1130:2737: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0020; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1130
msgctxt "text_id=2737 | speaker=tobimaru"
msgid "「あ、そっちか。"
msgstr "\"Oh, that."

#. Occurrence 2_4:1130:2738: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0020; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1130
msgctxt "text_id=2738 | speaker=tobimaru"
msgid "　いや、あいつが馬鹿なこと口走ったからなんだが―――」"
msgstr "  I was just trying to put a stop to the nonsense he was spewing and―\""

#. Occurrence 2_4:1135:2739: scene=2_4
#: 2_4:1135
msgctxt "text_id=2739 | speaker=unknown"
msgid "　その先は言えない。"
msgstr "  He stopped himself before he said any more."

#. Occurrence 2_4:1155:2740: scene=2_4
#: 2_4:1155
msgctxt "text_id=2740 | speaker=unknown"
msgid "　静希草十郎が蒼崎青子に惚れている、という事実は口に出来ない事だ。<漢|おとこ>としての暗黙の了解である。"
msgstr "  He knew better than to let slip the fact that Soujyuro had a thing for Aoko. Everyone knew guys didn't sell each other out like that."

#. Occurrence 2_4:1155:2741: scene=2_4
#: 2_4:1155
msgctxt "text_id=2741 | speaker=unknown"
msgid "　たとえ、それが彼の勘違いでもだ。"
msgstr "  Even if it was all, in truth, a misunderstanding."

#. Occurrence 2_4:1181:2742: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0021; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1181
msgctxt "text_id=2742 | speaker=tobimaru"
msgid "「それより、さっきのはないんじゃねえのか蒼崎。"
msgstr "\"Anyway, what the hell was that before, Aozaki?"

#. Occurrence 2_4:1187:2743: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0022; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1187
msgctxt "text_id=2743 | speaker=tobimaru"
msgid "　おまえ、草十郎に恨みでもあんの？」"
msgstr "  That's some grudge you've got against Soujyuro.\""

#. Occurrence 2_4:1198:2744: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0016; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1198
msgctxt "text_id=2744 | speaker=aoko"
msgid "「七日以上前の恨みを引きずるほど、私はお姫さまじゃないつもりだけど」"
msgstr "\"I'm not some princess who goes around holding grudges for something that happened over a week ago, you know.\""

#. Occurrence 2_4:1208:2745: scene=2_4
#: 2_4:1208
msgctxt "text_id=2745 | speaker=unknown"
msgid "　ああ、おまえはお姫さまっていうより女王さまだな、と言いかけて止める鳶丸。"
msgstr "  He wanted to retort that she was more like a queen than a princess."

#. Occurrence 2_4:1218:2746: scene=2_4
#: 2_4:1218
msgctxt "text_id=2746 | speaker=unknown"
msgid "　彼もこの二年で、十分に蒼崎青子を学習しているのだった。"
msgstr "  But he'd come to know her too well over the past two years to dig himself into a hole like that."

#. Occurrence 2_4:1244:2747: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0023; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1244
msgctxt "text_id=2747 | speaker=tobimaru"
msgid "「恨みはないねえ。それにしちゃあ故意にケンカ売ってただろ。なんでだ？"
msgstr "\"Okay, so why'd you a pick a fight with him?"

#. Occurrence 2_4:1251:2748: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0024; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1251
msgctxt "text_id=2748 | speaker=tobimaru"
msgid "　たしかに調子の狂うヤツだが、あいつほどいいヤツはいねえだろうに」"
msgstr "  I mean, he does throw you off when you talk to him, but there's not an evil bone in his body.\""

#. Occurrence 2_4:1284:2749: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0017; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1284
msgctxt "text_id=2749 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 2_4:1290:2750: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0025; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1290
msgctxt "text_id=2750 | speaker=tobimaru"
msgid "「おい待て。なんだその、足下の白アリを見るかのような態度は」"
msgstr "\"Wow. Why are you looking at me like you just stepped in a turd?\""

#. Occurrence 2_4:1296:2751: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0018; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1296
msgctxt "text_id=2751 | speaker=aoko"
msgid "「別に。アンタまでその台詞を言うのかって、心底から見下げ果てただけよ」"
msgstr "\"Oh, no big reason. Hearing you say that, I was just thinking that I've never met such a despicable person in my life.\""

#. Occurrence 2_4:1330:2752: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0019; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1330
msgctxt "text_id=2752 | speaker=aoko"
msgid "「……まあいいか。いいヤツ、いいひと、結構じゃない？　ケンカを売る相手としちゃあ上等だわ。誰も憎んであげないなら、私ぐらいそうしないとね」"
msgstr "\"...Well, whatever. So he's a good guy? That makes him the perfect person to pick a fight with. If nobody else'll do it, the job falls to me, right?\""

#. Occurrence 2_4:1344:2753: scene=2_4
#: 2_4:1344
msgctxt "text_id=2753 | speaker=unknown"
msgid "　うん、と気を取り直して気軽に言う青子。"
msgstr "  She said casually, having regained her composure."

#. Occurrence 2_4:1365:2754: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0026; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1365
msgctxt "text_id=2754 | speaker=tobimaru"
msgid "「しないとねって、おまえ」"
msgstr "\"You just can't help yourself, huh.\""

#. Occurrence 2_4:1370:2755: scene=2_4
#: 2_4:1370
msgctxt "text_id=2755 | speaker=unknown"
msgid "　鳶丸にはその結論がさっぱりである。"
msgstr "  Tobimaru could not follow her reasoning at all."

#. Occurrence 2_4:1396:2756: scene=2_4
#: 2_4:1396
msgctxt "text_id=2756 | speaker=unknown"
msgid "　蒼崎青子のこういう思考の飛び方に慣れてはいる鳶丸だが、理由もなく嫌われる草十郎があんまりと言えばあんまりで、脳裏にはあの人畜無害な顔が浮かんでしまい、つい、"
msgstr "  Tobimaru was used to Aoko's erratic trains of thought, but hating Soujyuro for no reason seemed needlessly cruel. His friend's naive and innocent face came to mind, and then he blurted,"

#. Occurrence 2_4:1410:2757: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0027; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1410
msgctxt "text_id=2757 | speaker=tobimaru"
msgid "「けど草十郎は蒼崎が好きなんだぜ。それでも嫌いなのか？」"
msgstr "\"But Soujyuro's taken a shine to you, Aozaki. How can you hate him, knowing that?\""

#. Occurrence 2_4:1441:2758: scene=2_4
#: 2_4:1441
msgctxt "text_id=2758 | speaker=unknown"
msgid "　二分足らずで、言うべきではないという誓いを破っていた。"
msgstr "  His vow of silence had lasted not even two minutes."

#. Occurrence 2_4:1479:2759: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0028; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1479
msgctxt "text_id=2759 | speaker=tobimaru"
msgid "「あ―――いや、今のはな、蒼崎」"
msgstr "\"Oh. Um... What I meant was...\""

#. Occurrence 2_4:1485:2760: scene=2_4
#: 2_4:1485
msgctxt "text_id=2760 | speaker=unknown"
msgid "　しまった、と口を閉ざすがもう遅い。"
msgstr "  He tried to take it back, but it was too late."

#. Occurrence 2_4:1490:2761: scene=2_4
#: 2_4:1490
msgctxt "text_id=2761 | speaker=unknown"
msgid "　そして閉まったものは仕方がない。"
msgstr "  She had heard his words loud and clear."

#. Occurrence 2_4:1496:2762: scene=2_4
#: 2_4:1496
msgctxt "text_id=2762 | speaker=unknown"
msgid "こうなると青子の反応に一縷の望みをかける鳶丸だが―――"
msgstr "All he could hope for now was that she would take it well."

#. Occurrence 2_4:1531:2763: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0020; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1531
msgctxt "text_id=2763 | speaker=aoko"
msgid "「そりゃそうでしょ、好き嫌いは誰にもあるし。"
msgstr "\"Because I like what I like and dislike what I don't like."

#. Occurrence 2_4:1537:2764: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0021; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1537
msgctxt "text_id=2764 | speaker=aoko"
msgid "　けどこればかりはね。彼が私と仲良くしたいって言っても、私は嫌いなんだから仕方ない」"
msgstr "  Just because he wants to be friends doesn't mean I have to suddenly like him.\""

#. Occurrence 2_4:1543:2765: scene=2_4
#: 2_4:1543
msgctxt "text_id=2765 | speaker=unknown"
msgid "　ドライと言えばドライ。"
msgstr "  Stone. Cold. Aoko."

#. Occurrence 2_4:1548:2766: scene=2_4
#: 2_4:1548
msgctxt "text_id=2766 | speaker=unknown"
msgid "　スマートと言えばスマートな青子の感想に、柄にもなく憤慨してしまうのだった。"
msgstr "  Tobimaru found himself filled with indignation at how detached Aoko was being."

#. Occurrence 2_4:1582:2767: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0029; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1582
msgctxt "text_id=2767 | speaker=tobimaru"
msgid "「いや、そんなお友達感覚の話じゃなくてだな！"
msgstr "\"Don't you get it? This isn't just about friendship!"

#. Occurrence 2_4:1588:2768: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0030; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1588
msgctxt "text_id=2768 | speaker=tobimaru"
msgid "　そういう好き嫌いじゃなくて、草の字は本気でおまえに惚れてるって言ったんだよ！」"
msgstr "  And I didn't mean he only 'likes' you, either! Believe me when I say that Sono-G really has a thing for you!\""

#. Occurrence 2_4:1607:2769: scene=2_4
#: 2_4:1607
msgctxt "text_id=2769 | speaker=unknown"
msgid "　真顔で怒鳴る鳶丸。"
msgstr "  He shouted, his face the embodiment of sincerity."

#. Occurrence 2_4:1612:2770: scene=2_4
#: 2_4:1612
msgctxt "text_id=2770 | speaker=unknown"
msgid "　それに、青子はぽかんとした顔を向けていた。"
msgstr "  Aoko gave him a blank stare."

#. Occurrence 2_4:1632:2771: scene=2_4
#: 2_4:1632
msgctxt "text_id=2771 | speaker=unknown"
msgid "　まっさらなその顔は、何時間か前に財布を落とした、と気付いた放心に似ている。"
msgstr "  It was the face of someone who had lost their wallet hours earlier and was only just realizing it now."

#. Occurrence 2_4:1637:2772: scene=2_4
#: 2_4:1637
msgctxt "text_id=2772 | speaker=unknown"
msgid "　なんでこんな<現実|コト>になってるのか、と我を疑う一瞬の間。"
msgstr "  The first instant of doubt that ushers in the reality of the situation."

#. Occurrence 2_4:1642:2773: scene=2_4
#: 2_4:1642
msgctxt "text_id=2773 | speaker=unknown"
msgid "　それは本当に一瞬で、"
msgstr "  But, an instant is all it was."

#. Occurrence 2_4:1679:2774: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0022; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1679
msgctxt "text_id=2774 | speaker=aoko"
msgid "「で？」"
msgstr "\"So what?\""

#. Occurrence 2_4:1685:2775: scene=2_4
#: 2_4:1685
msgctxt "text_id=2775 | speaker=unknown"
msgid "　何でもないコトのように、平然と青子は聞き返した。"
msgstr "  She answered coolly,"

#. Occurrence 2_4:1690:2776: scene=2_4
#: 2_4:1690
msgctxt "text_id=2776 | speaker=unknown"
msgid "　それが、一体、私にどんな意味があるのかと。"
msgstr "  as if she had no idea why it should matter to her at all."

#. Occurrence 2_4:1726:2777: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0031; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1726
msgctxt "text_id=2777 | speaker=tobimaru"
msgid "「で？　ときたか。鬼でもなけりゃ悪魔だな、おまえって女は。よかろう、聞こえなかったのならもう一度言ってやる」"
msgstr "\"'So what'?! Were you born in hell?! I'll assume you didn't hear me and I'll say it again. Soujyuro-\""

#. Occurrence 2_4:1732:2778: scene=2_4
#: 2_4:1732
msgctxt "text_id=2778 | speaker=unknown"
msgid "　こうなったら漢の約束もあったもんじゃない、と開き直る鳶丸。"
msgstr "  Tobimaru gave up any pretense of masculine solidarity and fired back hard."

#. Occurrence 2_4:1752:2779: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0023; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1752
msgctxt "text_id=2779 | speaker=aoko"
msgid "「いいわよそんなの。つまらないもの」"
msgstr "\"Don't bother. I couldn't care less.\""

#. Occurrence 2_4:1770:2780: scene=2_4
#: 2_4:1770
msgctxt "text_id=2780 | speaker=unknown"
msgid "　それをあっさりと、心底からの感想で彼女は切り捨てた。"
msgstr "  She ruthlessly cut him off."

#. Occurrence 2_4:1806:2781: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0032; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1806
msgctxt "text_id=2781 | speaker=tobimaru"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 2_4:1812:2782: scene=2_4
#: 2_4:1812
msgctxt "text_id=2782 | speaker=unknown"
msgid "　とりあえず、学校中のいまだ健気に片思いをしている男子生徒のため、この悪鬼に相応しい呼称はないかと模索する鳶丸だった。"
msgstr "  Thinking of the boys who still harbored unrequited love for Aoko, Tobimaru tried hard to come up with a name befitting the demoness in front of him."

#. Occurrence 2_4:1860:2783: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0024; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1860
msgctxt "text_id=2783 | speaker=aoko"
msgid "「なるほどね、それでさっきの話に結びつくワケだ。"
msgstr "\"Now I see. So that's why you told him about our little incident."

#. Occurrence 2_4:1871:2784: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0025; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1871
msgctxt "text_id=2784 | speaker=aoko"
msgid "　へぇー、柄にもなく友達思いじゃない殿下？"
msgstr "  Who could have thought His Highness could be so considerate to his friends?"

#. Occurrence 2_4:1877:2785: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0026; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1877
msgctxt "text_id=2785 | speaker=aoko"
msgid "　ってコトは聞くも無惨、語るも無情っていう私の噂話、教えてあげたんでしょう？」"
msgstr "  I bet you also told him all the nasty rumors floating about me, too, huh.\""

#. Occurrence 2_4:1883:2786: scene=2_4
#: 2_4:1883
msgctxt "text_id=2786 | speaker=unknown"
msgid "　ふふ、と妖しい笑みを浮かべる青子。"
msgstr "  She laughed as a fiendish smile adorned her face."

#. Occurrence 2_4:1888:2787: scene=2_4
#: 2_4:1888
msgctxt "text_id=2787 | speaker=unknown"
msgid "　鳶丸はこの相手に色恋ざたの話をした事を、どっかにいる神さまに懺悔した。"
msgstr "  Tobimaru repented to God, whoever and wherever he or she might be, for ever bringing up Aoko's love life."

#. Occurrence 2_4:1922:2788: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0027; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1922
msgctxt "text_id=2788 | speaker=aoko"
msgid "「鳶丸にしちゃあ正しい判断ね。誉めてあげるから、どんな話をしたのか聞きたいなー、私」"
msgstr "\"You did the right thing, Tobimaru. Now be a good little vice president and tell me every single thing you told him.\""

#. Occurrence 2_4:1927:2789: scene=2_4
#: 2_4:1927
msgctxt "text_id=2789 | speaker=unknown"
msgid "　笑顔のくせに殺気を放つのは止めてほしい。"
msgstr "  She was smiling, but Tobimaru wished she'd at least try to hide the bloodlust."

#. Occurrence 2_4:1950:2790: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0033; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:1950
msgctxt "text_id=2790 | speaker=tobimaru"
msgid "「……代表作と、ここでの事件を二つばかり」"
msgstr "\"Just two things, really... The story you're most infamous for, and what happened in this room.\""

#. Occurrence 2_4:1955:2791: scene=2_4
#: 2_4:1955
msgctxt "text_id=2791 | speaker=unknown"
msgid "　遠慮がちな鳶丸の返答を聞いて、満足げに頷く青子。"
msgstr "  Aoko nodded with satisfaction as she listened to Tobimaru's hesitant answer."

#. Occurrence 2_4:1991:2792: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0028; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:1991
msgctxt "text_id=2792 | speaker=aoko"
msgid "「こういう時、噂話って便利よね。うるさいのを追っ払ってくれるから。でも、そんな話を考えなしで広めたら大変だから、これからは気をつけてね」"
msgstr "\"Rumors like those can come in handy sometimes. You can use them chase off annoying people. Just be careful about who you tell, okay?\""

#. Occurrence 2_4:2012:2793: scene=2_4
#: 2_4:2012
msgctxt "text_id=2793 | speaker=unknown"
msgid "　それは、語尾にハートマークでもつきそうな、ゾッとするほど甘い笑顔だった。"
msgstr "  Had this been in writing, the chillingly sweet tone of her words could've been signed with a heart."

#. Occurrence 2_4:2048:2794: scene=2_4
#: 2_4:2048
msgctxt "text_id=2794 | speaker=unknown"
msgid "　怒りにしろ喜びにしろ、感情がハイになると蒼崎は可愛らしい口調になる……"
msgstr "  Whether angry or happy, Aozaki spoke in a disturbingly cute manner when she was in a heightened emotional state."

#. Occurrence 2_4:2053:2795: scene=2_4
#: 2_4:2053
msgctxt "text_id=2795 | speaker=unknown"
msgid "　そんな新事実を発見した鳶丸だが、だからといってこの場がどうにかなる訳でもない。"
msgstr "  Tobimaru took note of this new discovery, aware that it did nothing to get him out of this situation."

#. Occurrence 2_4:2091:2796: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0034; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2091
msgctxt "text_id=2796 | speaker=tobimaru"
msgid "「ああ、俺も命は惜しいからな、口はもう滑らねえよ。"
msgstr "\"Don't worry. I value my life, so I'll shut my mouth."

#. Occurrence 2_4:2103:2797: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0035; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2103
msgctxt "text_id=2797 | speaker=tobimaru"
msgid "　……けどよ蒼崎。本気で草十郎が嫌いなのか？」"
msgstr "  ...But Aozaki... Do you really hate Soujyuro that much?\""

#. Occurrence 2_4:2124:2798: scene=2_4
#: 2_4:2124
msgctxt "text_id=2798 | speaker=unknown"
msgid "　もうこの話題は避けるべきだと分かっていても<果敢|かかん>に挑む鳶丸。"
msgstr "  He knew that it was a topic he would be better off avoiding, but he tried asking anyway."

#. Occurrence 2_4:2129:2799: scene=2_4
#: 2_4:2129
msgctxt "text_id=2799 | speaker=unknown"
msgid "　男の友情というものは、時に真珠より美しい。"
msgstr "  The bonds between men, at times, shine more beautifully than a pearl."

#. Occurrence 2_4:2162:2800: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0029; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2162
msgctxt "text_id=2800 | speaker=aoko"
msgid "「まあ……好きじゃないから嫌い、っていうワケじゃないけど。私が彼の事を嫌う理由は自分でも分からない。"
msgstr "\"Well... I might not like him... but that doesn't mean I hate him. I'm not even sure why I feel the way I do."

#. Occurrence 2_4:2192:2801: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0030; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2192
msgctxt "text_id=2801 | speaker=aoko"
msgid "　だからダメなのね、きっと」"
msgstr "  Which is probably the problem.\""

#. Occurrence 2_4:2197:2802: scene=2_4
#: 2_4:2197
msgctxt "text_id=2802 | speaker=unknown"
msgid "　鳶丸の顔を立てていくらか思考実験したのか、青子はしばし悩んでからそんな返答をする。"
msgstr "  Perhaps to placate Tobimaru, Aoko paused in contemplation before she answered."

#. Occurrence 2_4:2202:2803: scene=2_4
#: 2_4:2202
msgctxt "text_id=2803 | speaker=unknown"
msgid "　即答ではなく熟考しての答えなら、鳶丸も文句を言う筋合いはない。"
msgstr "  Giving it a moment without immediately blurting out a response meant that not even he could complain."

#. Occurrence 2_4:2241:2804: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0036; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2241
msgctxt "text_id=2804 | speaker=tobimaru"
msgid "「そうか。ま、そういうコトならしょうがねえか。"
msgstr "\"Huh. I guess that makes sense."

#. Occurrence 2_4:2252:2805: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0037; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2252
msgctxt "text_id=2805 | speaker=tobimaru"
msgid "　なにしろきれいさっぱり感情論だ。お互い理由もなく好きと嫌いじゃ手を貸す隙間もねえワケだし」"
msgstr "  As much as emotional arguments can make sense. There's nothing I can do if neither of you understand why you feel the way you do.\""

#. Occurrence 2_4:2257:2806: scene=2_4
#: 2_4:2257
msgctxt "text_id=2806 | speaker=unknown"
msgid "　これでこの話は終わりか、と草十郎に謝りながら天をあおぐ鳶丸。"
msgstr "  Thinking that would be the end of it, Tobimaru looked up toward the ceiling and silently apologized to Soujyuro."

#. Occurrence 2_4:2275:2807: scene=2_4
#: 2_4:2275
msgctxt "text_id=2807 | speaker=unknown"
msgid "　しかし。"
msgstr "  However..."

#. Occurrence 2_4:2294:2808: scene=2_4
#: 2_4:2294
msgctxt "text_id=2808 | speaker=unknown"
msgid "　その降参を告げる一言が、蒼崎青子の興味を引いたらしい。"
msgstr "  His final sentence appeared to have piqued Aoko's interest."

#. Occurrence 2_4:2320:2809: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0031; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2320
msgctxt "text_id=2809 | speaker=aoko"
msgid "「……待って。今の、どういう意味？」"
msgstr "\"...Wait. What do you mean by that?\""

#. Occurrence 2_4:2326:2810: scene=2_4
#: 2_4:2326
msgctxt "text_id=2810 | speaker=unknown"
msgid "　上機嫌ぽかった口調が変わる。"
msgstr "  Her faux cheer had vanished."

#. Occurrence 2_4:2331:2811: scene=2_4
#: 2_4:2331
msgctxt "text_id=2811 | speaker=unknown"
msgid "　それに気付かず、軽い気持ちで鳶丸は答えた。"
msgstr "  Failing to pick up on this, Tobimaru answered nonchalantly."

#. Occurrence 2_4:2358:2812: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0038; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2358
msgctxt "text_id=2812 | speaker=tobimaru"
msgid "「いやアイツもさ、蒼崎に惚れた理由が分からない、なんて言いやがってよ。……ああ、違ったか、理由なんてない、なんて意味だったかな」"
msgstr "\"Oh, nothing. It's just that Soujyuro also said he wasn't exactly sure why he liked you... or more like, there was no particular reason for how he felt, I think.\""

#. Occurrence 2_4:2364:2813: scene=2_4
#: 2_4:2364
msgctxt "text_id=2813 | speaker=unknown"
msgid "　鳶丸は“青子の外見に惹かれた”なんて草十郎の言葉を信じていないので、そこはあっさりと切り離す。"
msgstr "  Tobimaru was still in disbelief that Soujyuro had been charmed by Aoko's appearance, so he purposely left that part out."

#. Occurrence 2_4:2391:2814: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0032; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2391
msgctxt "text_id=2814 | speaker=aoko"
msgid "「理由はない、ですって……？」"
msgstr "\"He said he likes me... for no reason?\""

#. Occurrence 2_4:2404:2815: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0039; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2404
msgctxt "text_id=2815 | speaker=tobimaru"
msgid "「ああ。なんで、俺がいくらおまえの噂話をしても無駄だった。あまつさえなんて言ってたかな……そうそう、理由はどうあれ、蒼崎の心配は本物なんだ、とか、自分はそれで助かってるとか。俺なんかにゃ言えない台詞だったのは確かだね、どーにも。"
msgstr "\"Yeah. I mean, I even told him about all the rumors around you, and it had no effect on him whatsoever. What did he say again...? Oh, right. He was going on about how genuine your concern for him was, and how it really helped him. It's almost too mushy for me to repeat out loud."

#. Occurrence 2_4:2417:2816: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0040; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2417
msgctxt "text_id=2816 | speaker=tobimaru"
msgid "　はっきりしてんのは他の野郎どもと違って、噂を聞いても手を引く素振りなんざ微塵もなかったって事だけ―――」"
msgstr "  All I can say is that, unlike the other boys, the rumors didn't faze him in the least.\""

#. Occurrence 2_4:2454:2817: scene=2_4
#: 2_4:2454
msgctxt "text_id=2817 | speaker=unknown"
msgid "　そこまで調子よく語って、鳶丸は青子の変化に気が付いた。"
msgstr "  Tobimaru finally noticed the shift in Aoko's demeanor."

#. Occurrence 2_4:2477:2818: scene=2_4
#: 2_4:2477
msgctxt "text_id=2818 | speaker=unknown"
msgid "　彼女は壁を睨んでいる。"
msgstr "  She was scowling at the wall."

#. Occurrence 2_4:2482:2819: scene=2_4
#: 2_4:2482
msgctxt "text_id=2819 | speaker=unknown"
msgid "　その、仇を見るような視線は無言のまま何分か続けられた。"
msgstr "  She glared at it in silence like it was her worst enemy, and this continued for several minutes."

#. Occurrence 2_4:2530:2820: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0033; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2530
msgctxt "text_id=2820 | speaker=aoko"
msgid "「……なにそれ。さっきといいそれといい、どこかで聞いたような事ばっかり―――」"
msgstr "\"...What the hell is that? Why can't I shake the feeling that I've heard all this before somewhere.\""

#. Occurrence 2_4:2569:2821: scene=2_4
#: 2_4:2569
msgctxt "text_id=2821 | speaker=unknown"
msgid "　ぎり、と歯を噛む音がする。"
msgstr "  So great was her ire that the gnashing of her teeth was audible."

#. Occurrence 2_4:2574:2822: scene=2_4
#: 2_4:2574
msgctxt "text_id=2822 | speaker=unknown"
msgid "　反感ここに極まり、あまりの不機嫌さに目の前にいる鳶丸が視界に入っていないようだ。"
msgstr "  The irritation seethed until it reached the point that Aoko forgot Tobimaru was even in the room."

#. Occurrence 2_4:2584:2823: scene=2_4
#: 2_4:2584
msgctxt "text_id=2823 | speaker=unknown"
msgid "　なんか、また絶望的に草十郎に迷惑かける事を言っちまったな、と鳶丸は天をあおいだ。"
msgstr "  Tobimaru looked heavenward for forgiveness, sensing that he'd brought further calamity down upon Soujyuro's head."

#. Occurrence 2_4:2649:2824: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0034; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2649
msgctxt "text_id=2824 | speaker=aoko"
msgid "「……少し分かったわ。なんでアイツが気に喰わないのか」"
msgstr "\"...I kind of get it now. I think I know why I don't like him.\""

#. Occurrence 2_4:2661:2825: scene=2_4
#: 2_4:2661
msgctxt "text_id=2825 | speaker=unknown"
msgid "　聞きたくない、どっかよそで喋ってくれないもんかなー、などと目を逸らす鳶丸を無視して、青子は<呪詛|じゅそ>のように言葉を紡ぐ。"
msgstr "  Tobimaru looked away as if to indicate that he'd rather not know, but Aoko ignored him and began to grumble venomously."

#. Occurrence 2_4:2687:2826: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0035; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2687
msgctxt "text_id=2826 | speaker=aoko"
msgid "「あいつ、私が嫌いな奴と言動が似てるのよ。"
msgstr "\"The way he acts and talks reminds me of someone I despise."

#. Occurrence 2_4:2693:2827: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0036; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2693
msgctxt "text_id=2827 | speaker=aoko"
msgid "　誰彼かまわずいい人扱いされるところとか。妙にふわふわしてるところとか。いちいち私の癇に障るところとか」"
msgstr "  Like how everyone thinks he's an angel, and how nothing seems to bother him. Maybe it's how good he is at getting on my nerves.\""

#. Occurrence 2_4:2711:2828: scene=2_4
#: 2_4:2711
msgctxt "text_id=2828 | speaker=unknown"
msgid "　最後のはただの八つ当たりだよな、と所在なげに時計とか見てみる副会長。"
msgstr "  Glancing idly up at the clock, Tobimaru thought that last part just sounded like misplaced anger."

#. Occurrence 2_4:2733:2829: scene=2_4
#: 2_4:2733
msgctxt "text_id=2829 | speaker=unknown"
msgid "　―――と。"
msgstr "  And that was that."

#. Occurrence 2_4:2738:2830: scene=2_4
#: 2_4:2738
msgctxt "text_id=2830 | speaker=unknown"
msgid "　時計は、当然のように午後一時を回っていた。"
msgstr "  One o'clock had come and gone."

#. Occurrence 2_4:2782:2831: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0041; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2782
msgctxt "text_id=2831 | speaker=tobimaru"
msgid "「……分かった、もういい。この話をした俺が悪かった。"
msgstr "\"...Fine. I get it. Sorry I said anything."

#. Occurrence 2_4:2793:2832: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0042; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2793
msgctxt "text_id=2832 | speaker=tobimaru"
msgid "　で、俺に用ってのはなんだよ。言っとくけど、もう授業始まってるぜ？」"
msgstr "  So did you need me for anything? Class has already started, you know.\""

#. Occurrence 2_4:2812:2833: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0037_0; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2812
msgctxt "text_id=2833 | speaker=aoko"
msgid "「へ？　授業って、なんで？　"
msgstr "\"Huh? What do you mean by class?  "

#. Occurrence 2_4:2824:2834: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0037_1; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2824
msgctxt "text_id=2834 | speaker=aoko"
msgid "いつ？」"
msgstr "When did it...\""

#. Occurrence 2_4:2835:2835: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0043; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2835
msgctxt "text_id=2835 | speaker=tobimaru"
msgid "「いや、さっき草の字が出てってから、蒼崎がぎらーんって壁睨んでた時にチャイムが鳴ったんだよ。いいのか生徒会長。五時限目ばっくれて」"
msgstr "\"The bell rang right after Sono-G left, around the time you were busy being pissed off at the wall. Tell me, Ms. President. Are you allowed to miss fifth period?\""

#. Occurrence 2_4:2929:2836: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0038; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2929
msgctxt "text_id=2836 | speaker=aoko"
msgid "「っ、いいわけないでしょ！"
msgstr "\"Of course I'm not!"

msgctxt "text_id=2837 | speaker=unknown"
msgid "　なんで黙ってんのよアンタはーっ！」"
msgstr "  Why didn't you say something!?\""

#. Occurrence 2_4:2938:2838: scene=2_4
#: 2_4:2938
msgctxt "text_id=2838 | speaker=unknown"
msgid "　鳶丸のネクタイをひっぱりながら、半泣き状態で青子は怒鳴る。"
msgstr "  She looked like she was on the verge of tears as she shouted and pulled at his necktie."

#. Occurrence 2_4:2944:2839: scene=2_4
#: 2_4:2944
msgctxt "text_id=2839 | speaker=unknown"
msgid "対して、鳶丸は両手をギブアップの形で上げていた。勝者の余裕である。"
msgstr "Tobimaru raised his hands in mock surrender―a gesture reserved only for the true victor."

#. Occurrence 2_4:2980:2840: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0044; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2980
msgctxt "text_id=2840 | speaker=tobimaru"
msgid "「蚊のほうがエレガントなんて言いやがった仕返しだ。"
msgstr "\"Consider this revenge for saying I was worse than a mosquito."

#. Occurrence 2_4:2980:2841: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0044; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:2980
msgctxt "text_id=2841 | speaker=tobimaru"
msgid "　思い知るがいい、男の純情を踏みにじったり焼き殺したりするエリート悪魔め」"
msgstr "  Hopefully you've learned your lesson, oh hellish demon who feasts upon the hearts of men.\""

#. Occurrence 2_4:2999:2842: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0039; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2999
msgctxt "text_id=2842 | speaker=aoko"
msgid "「あいかわらず細かく根に持つ男！"
msgstr "\"You're so petty, you know that!?"

#. Occurrence 2_4:2999:2843: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0039; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:2999
msgctxt "text_id=2843 | speaker=aoko"
msgid "　言動には言動で返しなさいよね、卑怯者！」"
msgstr "  You're supposed to repay insults with insults, you coward!\""

#. Occurrence 2_4:3005:2844: scene=2_4
#: 2_4:3005
msgctxt "text_id=2844 | speaker=unknown"
msgid "　鳶丸の首にぐいぐいとネクタイが締まっていく。"
msgstr "  She tightened his necktie around his neck with a yank."

#. Occurrence 2_4:3010:2845: scene=2_4
#: 2_4:3010
msgctxt "text_id=2845 | speaker=unknown"
msgid "　それすら勝者の愉悦、とチンピラ顔で笑う副会長。"
msgstr "  The vice president smiled a thuggish grin, as if her reaction made his victory that much sweeter."

#. Occurrence 2_4:3057:2846: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0045; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:3057
msgctxt "text_id=2846 | speaker=tobimaru"
msgid "「ふふふ、おまえの古典が<補習|はめつ>に向かっているのは周知の事実。そしてＡ組の五時限目は言うまでもない。<藤代|ふじしろ>のばあさん、蒼崎のこと嫌ってるしな」"
msgstr "\"Heh. It's no secret you're heading to remedial classics. And I don't have to tell you who teaches Class A during fifth period. Old bat Fujishiro is going to have your head!\""

#. Occurrence 2_4:3063:2847: scene=2_4
#: 2_4:3063
msgctxt "text_id=2847 | speaker=unknown"
msgid "　藤代というのは古参教師のひとりで、言うまでもなく、担当は古典である。"
msgstr "  Fujishiro had one of the longest tenures at the school, so it was only natural she would be in charge of teaching the classics."

#. Occurrence 2_4:3084:2848: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0046; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:3084
msgctxt "text_id=2848 | speaker=tobimaru"
msgid "「さあ、こんな所で俺のネクタイを引っぱる余裕があるのなら、急いで自分の教室に立ち返るがいい。"
msgstr "\"This is where you stop yanking on my tie and haul ass to your classroom."

#. Occurrence 2_4:3090:2849: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0047; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:3090
msgctxt "text_id=2849 | speaker=tobimaru"
msgid "　情けだ、別に止めはしねえよ」"
msgstr "  I won't even try to stop you. Am I not merciful?\""

#. Occurrence 2_4:3121:2850: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0040; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:3121
msgctxt "text_id=2850 | speaker=aoko"
msgid "「っっっクソ、あんたなんかに嵌められるなんて！"
msgstr "\"Damn! It! All! I can't believe you of all people pulled one over on me!"

#. Occurrence 2_4:3121:2851: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0040; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:3121
msgctxt "text_id=2851 | speaker=aoko"
msgid "　えぇい、このまま死んでしまえ！」"
msgstr "  Just die already!\""

#. Occurrence 2_4:3127:2852: scene=2_4
#: 2_4:3127
msgctxt "text_id=2852 | speaker=unknown"
msgid "　さらに締まるネクタイ。"
msgstr "  She choked him even harder with his necktie."

#. Occurrence 2_4:3132:2853: scene=2_4
#: 2_4:3132
msgctxt "text_id=2853 | speaker=unknown"
msgid "　有言実行、容赦のない青子の窒息攻撃にひととき、神を見る鳶丸だった。"
msgstr "  As Aoko put words into action and mercilessly strangled Tobimaru, he saw his life flash before his eyes."

#. Occurrence 2_4:3182:2854: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0048; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:3182
msgctxt "text_id=2854 | speaker=tobimaru"
msgid "「―――ハ！？　いや、待て待て、ホントに死んじまうだろうがっ！　今ならまだ間に合う、十分過ぎたら遅刻から欠席扱いだぞ！？」"
msgstr "\"Ggahhhh! Wait! Stop! I'm gonna die! It isn't too late! Do you want them to mark you absent!?\""

#. Occurrence 2_4:3188:2855: scene=2_4
#: 2_4:3188
msgctxt "text_id=2855 | speaker=unknown"
msgid "　とっさに時計を見る青子。"
msgstr "  Aoko glanced up at the clock."

#. Occurrence 2_4:3208:2856: scene=2_4
#: 2_4:3208
msgctxt "text_id=2856 | speaker=unknown"
msgid "　時刻は午後一時七分。二階である第二生徒会室から、三階端のＡ組の教室まで走ればギリギリ間に合う距離だった。"
msgstr "  It was still only seven past one. Her route was from the student council room on the second floor to the Class A classroom on the third floor. If she ran she could make it."

#. Occurrence 2_4:3251:2857: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0041; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:3251
msgctxt "text_id=2857 | speaker=aoko"
msgid "「命<拾|ひろ>ったわね、鳶丸」"
msgstr "\"I'll let you live, Tobimaru. This time.\""

#. Occurrence 2_4:3257:2858: scene=2_4
#: 2_4:3257
msgctxt "text_id=2858 | speaker=unknown"
msgid "　ち、と言い捨てる青子。"
msgstr "  Aoko clicked her tongue disappointedly."

#. Occurrence 2_4:3262:2859: scene=2_4
#: 2_4:3262
msgctxt "text_id=2859 | speaker=unknown"
msgid "　あながち嘘でもないのが鳶丸的に頭がいたい。"
msgstr "  What disturbed Tobimaru was that it didn't sound like an empty threat. "

#. Occurrence 2_4:3308:2860: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0042; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:3308
msgctxt "text_id=2860 | speaker=aoko"
msgid "「あと放課後、ここにいて。"
msgstr "\"Be here after school."

#. Occurrence 2_4:3308:2861: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_2_4_0042; voice_prefix=A10; voice_category=1; scene=2_4
#: 2_4:3308
msgctxt "text_id=2861 | speaker=aoko"
msgid "　頼みたい事があるのはホントなんだから」"
msgstr "  I actually do have something I need you to do.\""

#. Occurrence 2_4:3332:2862: scene=2_4
#: 2_4:3332
msgctxt "text_id=2862 | speaker=unknown"
msgid "　言うが早いか、青子は隼のように生徒会室から飛び出していった。"
msgstr "  She was halfway out of the room before she even finished her sentence."

#. Occurrence 2_4:3380:2863: scene=2_4
#: 2_4:3380
msgctxt "text_id=2863 | speaker=unknown"
msgid "　ようやくひとりになって、"
msgstr "  Finally all alone,"

msgctxt "text_id=2864 | speaker=unknown"
msgid "鳶丸は開けっぱなしの扉を閉め、鍵をかけて"
msgstr " Tobimaru closed the open door, locked it,"

msgctxt "text_id=2865 | speaker=unknown"
msgid "椅子に座る。"
msgstr " and slumped into a chair."

#. Occurrence 2_4:3391:2866: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0049; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:3391
msgctxt "text_id=2866 | speaker=tobimaru"
msgid "「……ったく。ああしてる分には楽しいヤツなんだけどよ、蒼崎は」"
msgstr "\"...Never a dull moment with Aozaki around, that's for sure.\""

#. Occurrence 2_4:3397:2867: scene=2_4
#: 2_4:3397
msgctxt "text_id=2867 | speaker=unknown"
msgid "　ギシリ、とパイプ椅子の背もたれを<軋|きし>ませてため息をつく。"
msgstr "  He leaned back in the creaky folding chair and let out a sigh."

#. Occurrence 2_4:3454:2868: scene=2_4
#: 2_4:3454
msgctxt "text_id=2868 | speaker=unknown"
msgid "　窓の外は気持ちのいい晴れ模様。"
msgstr "  The weather outside was beautiful."

#. Occurrence 2_4:3459:2869: scene=2_4
#: 2_4:3459
msgctxt "text_id=2869 | speaker=unknown"
msgid "　が、冬の日射しはすぐに弱くなっていく。"
msgstr "  But the sunlight waned early in the winter."

#. Occurrence 2_4:3464:2870: scene=2_4
#: 2_4:3464
msgctxt "text_id=2870 | speaker=unknown"
msgid "　じき日の勢いも翳って、暖房の入っていない生徒会室は段々と冷えていくだろう。"
msgstr "  Before long, daylight would fade, and the unheated student council room would grow colder and colder."

#. Occurrence 2_4:3469:2871: scene=2_4
#: 2_4:3469
msgctxt "text_id=2871 | speaker=unknown"
msgid "　ストーブなんて気の利いた物は第一生徒会室に流れているので、この寒さには慣れろという他ないのだが。"
msgstr "  All of the good equipment, like the heater, had ended up in the main office, so he had no choice but to settle in for a chilly afternoon."

#. Occurrence 2_4:3558:2872: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0050; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:3558
msgctxt "text_id=2872 | speaker=tobimaru"
msgid "「こんな天気が続けばいいんだがねぇ。"
msgstr "\"If only this weather would last..."

#. Occurrence 2_4:3558:2873: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_2_4_0050; voice_prefix=B70; voice_category=4; scene=2_4
#: 2_4:3558
msgctxt "text_id=2873 | speaker=tobimaru"
msgid "　天気予報じゃ、また雲行き怪しいって話だが」"
msgstr "  Shame the forecast predicted more clouds.\""

#. Occurrence 2_4:3575:2874: scene=2_4
#: 2_4:3575
msgctxt "text_id=2874 | speaker=unknown"
msgid "　なんとなく暗示的な独白の後、鳶丸は草十郎の姿を思い浮べた。"
msgstr "  After his somewhat suggestive monologue, Tobimaru's mind drifted."

#. Occurrence 2_4:3580:2875: scene=2_4
#: 2_4:3580
msgctxt "text_id=2875 | speaker=unknown"
msgid "　曇りと晴れ。そのどちらが彼らしいか考えてみたが、ついに答えは出なかった。"
msgstr "  He idly wondered to himself whether Soujyuro was an overcast day or a clear day sort of guy, but no answers came."

#. Occurrence 2_5:55:2876: scene=2_5
#: 2_5:55
msgctxt "text_id=2876 | speaker=unknown"
msgid "　その日の学校が終わると、草十郎は寄り道一つせずアルバイト先に直行した。"
msgstr "  The school day over, Soujyuro headed straight to his job."

#. Occurrence 2_5:60:2877: scene=2_5
#: 2_5:60
msgctxt "text_id=2877 | speaker=unknown"
msgid "　学校側に申告してあるのは三咲町商店街にある中華飯店と鮮魚店だけで、他のアルバイトは秘密にしている。"
msgstr "  While the school had approved his jobs at the Chinese restaurant and fish market in Misaki's shopping district, there was other work he hadn't mentioned to them."

#. Occurrence 2_5:65:2878: scene=2_5
#: 2_5:65
msgctxt "text_id=2878 | speaker=unknown"
msgid "　それも単に数が多いからではなく、それ以前に法律に違反していそうな働き先だったからだ。"
msgstr "  And it was not because he knew that they would complain at him working too many, but rather because of the illicit nature of one job in particular."

#. Occurrence 2_5:121:2879: scene=2_5
#: 2_5:121
msgctxt "text_id=2879 | speaker=unknown"
msgid "　今日のアルバイト先はその最たるもので、<社木|やしろぎ>駅前にあるパチンコ店だ。"
msgstr "  Today, his workplace was a pachinko parlor in front of Yashirogi Station."

#. Occurrence 2_5:128:2880: scene=2_5
#: 2_5:128
msgctxt "text_id=2880 | speaker=unknown"
msgid "　学校の制服から店の黒いタキシードじみた制服に着替え、仕事はじめに店周りの掃除をする。"
msgstr "  Soujyuro changed out of his school uniform and into a black faux tuxedo uniform, then began cleaning the storefront."

#. Occurrence 2_5:174:2881: scene=2_5
#: 2_5:174
msgctxt "text_id=2881 | speaker=unknown"
msgid "　三咲市の顔である<社木|やしろぎ>の駅前は幾多のショッピングビルが競い合うように乱立し、アーケード街もそれらに<倣|なら>うように騒がしい。"
msgstr "  Yashirogi was the jewel of Misaki City, a busy place with a vast assortment of commercial centers and shopping arcades."

#. Occurrence 2_5:179:2882: scene=2_5
#: 2_5:179
msgctxt "text_id=2882 | speaker=unknown"
msgid "　人が多くなれば生み出される物も多くなる。"
msgstr "  Where there were people en masse, there were products made en masse."

#. Occurrence 2_5:184:2883: scene=2_5
#: 2_5:184
msgctxt "text_id=2883 | speaker=unknown"
msgid "　浪漫として言えば笑顔であり、"
msgstr "  A romantic might describe it as a place of joy,"

#. Occurrence 2_5:189:2884: scene=2_5
#: 2_5:189
msgctxt "text_id=2884 | speaker=unknown"
msgid "　現実的に言えば流通であり、"
msgstr "  a realist would note the free enterprise,"

#. Occurrence 2_5:194:2885: scene=2_5
#: 2_5:194
msgctxt "text_id=2885 | speaker=unknown"
msgid "　より現実的に言えばゴミである。"
msgstr "  and a cynic would point at all the garbage."

#. Occurrence 2_5:248:2886: scene=2_5
#: 2_5:248
msgctxt "text_id=2886 | speaker=unknown"
msgid "　クリーンな町作りを目指している社木だが、そのルールには逆らえない。"
msgstr "  Local authorities had attempted to beautify Yashirogi, but there was one basic tenet of society they could not overcome."

#. Occurrence 2_5:253:2887: scene=2_5
#: 2_5:253
msgctxt "text_id=2887 | speaker=unknown"
msgid "　それがこういった店なら尚更だ。"
msgstr "  This establishment was the embodiment of that rule."

#. Occurrence 2_5:258:2888: scene=2_5
#: 2_5:258
msgctxt "text_id=2888 | speaker=unknown"
msgid "　商売柄<質|たち>の悪い人種を呼びこみやすいホールの前は、日に何度も清掃を心がけるべきである。"
msgstr "  Businesses such as this attracted the dregs of society, and as such, the front of the parlor had to be cleaned several times a day."

#. Occurrence 2_5:279:2889: scene=2_5
#: 2_5:279
msgctxt "text_id=2889 | speaker=unknown"
msgid "　冬の寒空の下、草十郎は煙草の吸い殻を集め、チラシを拾い、空き缶をゴミ箱へ。"
msgstr "  Soujyuro stood outside in the winter cold sweeping used-up cigarette butts, picking up discarded fliers, and tossing empty cans into the trash."

#. Occurrence 2_5:284:2890: scene=2_5
#: 2_5:284
msgctxt "text_id=2890 | speaker=unknown"
msgid "　山での生活を彷彿とさせるものがあるらしく、草十郎は気軽に、淡々と掃除をこなした。"
msgstr "  Something about it must have reminded him of mountain life, because he cheerfully finished the job with ease."

#. Occurrence 2_5:339:2891: scene=2_5
#: 2_5:339
msgctxt "text_id=2891 | speaker=unknown"
msgid "　ひととおり店周りを綺麗にし、晴れて暖房の効いた店内に戻る。"
msgstr "  After making sure the storefront was acceptably clean, he returned to the inside of the parlor where it was nice and warm."

#. Occurrence 2_5:344:2892: scene=2_5
#: 2_5:344
msgctxt "text_id=2892 | speaker=unknown"
msgid "　まぶしく目に痛い騒音、"
msgstr "  Blinding lights, deafening sounds,"

#. Occurrence 2_5:349:2893: scene=2_5
#: 2_5:349
msgctxt "text_id=2893 | speaker=unknown"
msgid "　充満するタバコの臭いに圧倒されながら店内を横断して事務所へ向かう。"
msgstr "  and the oppressive odor of tobacco assaulted him as he passed through the parlor on his way to the office."

#. Occurrence 2_5:399:2894: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0000; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:399
msgctxt "text_id=2894 | speaker=soujuurou"
msgid "「店長。外まわりの掃除、終わりました」"
msgstr "\"Boss, I've finished cleaning outside.\""

#. Occurrence 2_5:405:2895: voice_id=D10_2_5_0000; voice_prefix=D10; voice_category=0; scene=2_5
#: 2_5:405
msgctxt "text_id=2895 | speaker=unknown"
msgid "「はい、ごくろうさま。それで、いいかな。二階の四十番台のお客さんの様子、見てきてくれない？"
msgstr "\"Good job. I've got something else for you. Could you go check on the customer on machine forty on the second floor for me?"

#. Occurrence 2_5:411:2896: voice_id=D10_2_5_0001; voice_prefix=D10; voice_category=0; scene=2_5
#: 2_5:411
msgctxt "text_id=2896 | speaker=unknown"
msgid "　どうも懐にのんでそうなんだよね、あのお姉さん」"
msgstr "  I have a hunch she might be cheating.\""

#. Occurrence 2_5:431:2897: scene=2_5
#: 2_5:431
msgctxt "text_id=2897 | speaker=unknown"
msgid "　元会社員の、人の良さそうな店長さんである。"
msgstr "  His boss was a good-natured man who used to work a desk job."

#. Occurrence 2_5:436:2898: scene=2_5
#: 2_5:436
msgctxt "text_id=2898 | speaker=unknown"
msgid "　あきらかに学生である草十郎を採用したのはその苦学生ぶりに感動したから―――ではなく、"
msgstr "  The reason he employed someone like Soujyuro, even though he was clearly a student, was not because he admired him for working his way through school."

#. Occurrence 2_5:441:2899: scene=2_5
#: 2_5:441
msgctxt "text_id=2899 | speaker=unknown"
msgid "　店員がみんな怖い顔をしているので一人でも心安らげる店員がほしい、という理由らしい。"
msgstr "  It was because all of the other employees were scary and intimidating, and he wanted at least one employee who was not."

#. Occurrence 2_5:462:2900: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0001; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:462
msgctxt "text_id=2900 | speaker=soujuurou"
msgid "「いいんですか？　トイレの掃除、まだですけど」"
msgstr "\"Are you sure? I still haven't cleaned the toilets.\""

#. Occurrence 2_5:468:2901: voice_id=D10_2_5_0002; voice_prefix=D10; voice_category=0; scene=2_5
#: 2_5:468
msgctxt "text_id=2901 | speaker=unknown"
msgid "「いいのいいの。なんかねぇ、カメラの死角にいるんでイマイチ確証とれないの。"
msgstr "\"It's fine, it's fine. She's in the security camera's blind spot, so we have no way of confirming whether she's up to no good."

#. Occurrence 2_5:474:2902: voice_id=D10_2_5_0003; voice_prefix=D10; voice_category=0; scene=2_5
#: 2_5:474
msgctxt "text_id=2902 | speaker=unknown"
msgid "　草ちゃん、いまのところ的中率百パーセントでしょ。様子見てきてくれないかなぁ」"
msgstr "  I want you to go because you've got a sixth sense about these things. Go check on her, will you?\""

#. Occurrence 2_5:484:2903: scene=2_5
#: 2_5:484
msgctxt "text_id=2903 | speaker=unknown"
msgid "　そういう事でしたら、と掃除用具を片付けて草十郎は二階フロアに向かった。"
msgstr "  Hearing that, Soujyuro put away his cleaning equipment and headed upstairs."

#. Occurrence 2_5:542:2904: scene=2_5
#: 2_5:542
msgctxt "text_id=2904 | speaker=unknown"
msgid "　店は典型的な二階建ての、大きい部類に入るパチンコ店である。"
msgstr "  It was a typically large-scale pachinko parlor with two floors."

#. Occurrence 2_5:547:2905: scene=2_5
#: 2_5:547
msgctxt "text_id=2905 | speaker=unknown"
msgid "　基本的には地域密着型で、あまりあこぎな調整もせず、少しずつ町の皆さんから収入を得ることを良しとしている。"
msgstr "  It prided itself on being a local establishment that was satisfied with taking the locals' money little-by-little without resorting to more exploitative means."

#. Occurrence 2_5:552:2906: scene=2_5
#: 2_5:552
msgctxt "text_id=2906 | speaker=unknown"
msgid "　が、店側はそのつもりでも、お客様は千差万別。"
msgstr "  But regardless of the parlor's intentions, its customers were not so scrupulous."

#. Occurrence 2_5:572:2907: scene=2_5
#: 2_5:572
msgctxt "text_id=2907 | speaker=unknown"
msgid "　気軽に遊びに来る者もいれば、これで食べている<職業博徒|プ　　ロ>、はては不正を働いて儲けようという輩もやってくる。"
msgstr "  Among them were casual players, professional gamblers, and cheaters looking to profit by exploiting whatever loopholes they could find."

#. Occurrence 2_5:577:2908: scene=2_5
#: 2_5:577
msgctxt "text_id=2908 | speaker=unknown"
msgid "　中でも八十年代中期から流行しだしたある機械は、ゲーム台の電気系統に外部からアクセスしてプログラムを狂わせ、俗に言うスリーセブン等の大当たりをたやすく実現してしまう。"
msgstr "  Of particular prevalence was a device developed in the mid-eighties that could disrupt a machine's circuitry from the outside and make it much easier to get what was called a triple seven jackpot."

#. Occurrence 2_5:608:2909: scene=2_5
#: 2_5:608
msgctxt "text_id=2909 | speaker=unknown"
msgid "　当然店側としてもそういった人種の入場はお断りしたいのだが、確たる証拠もなしにお帰り願う訳にもいかない。"
msgstr "  As much as the parlor wanted to deny these cheaters entry, it needed to present hard evidence of cheating, or risk losing customers."

#. Occurrence 2_5:608:2910: scene=2_5
#: 2_5:608
msgctxt "text_id=2910 | speaker=unknown"
msgid "　客商売である以上、疑わしきは罰せず、がルールである。"
msgstr "  Particularly in the service industry, \"innocent until proven guilty\" was not a rule taken lightly."

#. Occurrence 2_5:613:2911: scene=2_5
#: 2_5:613
msgctxt "text_id=2911 | speaker=unknown"
msgid "　結果、現行犯としてとっ捕まえるのが店側の正義となる。"
msgstr "  As a result, they could only punish the customers they caught in the act."

#. Occurrence 2_5:618:2912: scene=2_5
#: 2_5:618
msgctxt "text_id=2912 | speaker=unknown"
msgid "　そういった不心得者をゴト師と言うらしいが、草十郎にはそのへんの事情は一切分かっていない。"
msgstr "  Such cheaters were known as gotoshi, a slice of society which Soujyuro knew nothing about."

#. Occurrence 2_5:623:2913: scene=2_5
#: 2_5:623
msgctxt "text_id=2913 | speaker=unknown"
msgid "　彼が承知しているのは、彼らが店側にとって厄介な相手であり、かつ、不正を働いているルール違反者である、という事だけだ。"
msgstr "  What he did know was that they were inconveniencing his employer and violating their rules."

#. Occurrence 2_5:662:2914: scene=2_5
#: 2_5:662
msgctxt "text_id=2914 | speaker=unknown"
msgid "　二階に上がる。"
msgstr "  He went upstairs."

#. Occurrence 2_5:667:2915: scene=2_5
#: 2_5:667
msgctxt "text_id=2915 | speaker=unknown"
msgid "　有線のラジオもゲーム台の音も、一階よりは控えめに流れている。"
msgstr "  The radio and game machine sounds on the second floor were quieter than the cacophony downstairs."

#. Occurrence 2_5:672:2916: scene=2_5
#: 2_5:672
msgctxt "text_id=2916 | speaker=unknown"
msgid "　一階の百台に対して二階のゲーム台の数は八十あまり。空席はちらほらとあるものの、夕方にしては客入りは良好だろう。"
msgstr "  There were a hundred game machines on the ground floor and over eighty on the second. While there were some empty seats here and there, it was a solid evening turnout."

#. Occurrence 2_5:677:2917: scene=2_5
#: 2_5:677
msgctxt "text_id=2917 | speaker=unknown"
msgid "　店長の言う四十番台は店の中ごろの列だ。"
msgstr "  The machine mentioned by his boss was in the center aisle."

#. Occurrence 2_5:695:2918: scene=2_5
#: 2_5:695
msgctxt "text_id=2918 | speaker=unknown"
msgid "　さりげなく列の入り口あたりの壁に寄りかかってみると、たしかに派手に<大当たり|フィーバー>しているお客さんがいた。"
msgstr "  Soujyuro nonchalantly leaned back against the wall and watched the customer hit the jackpot over and over again."

#. Occurrence 2_5:741:2919: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0002; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:741
msgctxt "text_id=2919 | speaker=soujuurou"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 2_5:746:2920: scene=2_5
#: 2_5:746
msgctxt "text_id=2920 | speaker=unknown"
msgid "　<一目|ひとめ>見た瞬間に違うな、と草十郎は直感した。"
msgstr "  The second he saw her, his gut told him that she was not cheating."

#. Occurrence 2_5:751:2921: scene=2_5
#: 2_5:751
msgctxt "text_id=2921 | speaker=unknown"
msgid "　何を以てプロと言うかは疑問だが、特別という意味なら彼女は本物だ。"
msgstr "  He still was not sure what made someone a master swindler, but if it meant they were special, this woman certainly fit that description."

#. Occurrence 2_5:756:2922: scene=2_5
#: 2_5:756
msgctxt "text_id=2922 | speaker=unknown"
msgid "　なんとなく、その幸運の強さが感じ取れる。"
msgstr "  It was almost as if he could feel the luck emanating from her."

#. Occurrence 2_5:761:2923: scene=2_5
#: 2_5:761
msgctxt "text_id=2923 | speaker=unknown"
msgid "　周りの客達の関心を一身に浴びながら、彼女は黙々とハンドルを回している。"
msgstr "  As the customers looked on, she silently turned the handle again and again."

#. Occurrence 2_5:781:2924: scene=2_5
#: 2_5:781
msgctxt "text_id=2924 | speaker=unknown"
msgid "　歳は<草十郎|じぶん>より何歳か上。"
msgstr "  She appeared older than Soujyuro."

#. Occurrence 2_5:786:2925: scene=2_5
#: 2_5:786
msgctxt "text_id=2925 | speaker=unknown"
msgid "　緑色の、体の線がはっきりと判る洋服を着ている。上着とスカートが一体になったような服だ。"
msgstr "  She wore a green, form-fitting, one-piece dress."

#. Occurrence 2_5:791:2926: scene=2_5
#: 2_5:791
msgctxt "text_id=2926 | speaker=unknown"
msgid "　足は素肌ではなくストッキングをはいている。"
msgstr "  A pair of stockings covered her legs."

#. Occurrence 2_5:796:2927: scene=2_5
#: 2_5:796
msgctxt "text_id=2927 | speaker=unknown"
msgid "　細い両足は艶やかに組まれ、パチンコをしているというよりは絵画のモデルのような優雅さだった。"
msgstr "  Her slender legs were gracefully crossed, and her elegance suited a painting better than a casino."

#. Occurrence 2_5:801:2928: scene=2_5
#: 2_5:801
msgctxt "text_id=2928 | speaker=unknown"
msgid "　赤みのかかった黒髪は短く、涼しげにかけたメガネと赤い唇がやけに決まっていた。"
msgstr "  Her dark, reddish hair was cut short in a bob, perfectly framing her stylish spectacles and crimson lips."

#. Occurrence 2_5:821:2929: scene=2_5
#: 2_5:821
msgctxt "text_id=2929 | speaker=unknown"
msgid "　正直に言って、こんな場所でフィーバーを出していい美人ではない。"
msgstr "  Truth be told, something was off about this picturesque beauty ringing the jackpot over and over again."

#. Occurrence 2_5:826:2930: scene=2_5
#: 2_5:826
msgctxt "text_id=2930 | speaker=unknown"
msgid "　彼女の足元には四つの大箱が重ねられていて、その勢いは留まるところを知らない。"
msgstr "  Four boxes' worth of pachinko balls sat at her feet, and her winning streak showed no sign of abating."

#. Occurrence 2_5:831:2931: scene=2_5
#: 2_5:831
msgctxt "text_id=2931 | speaker=unknown"
msgid "　退屈そうに、細い陶器のような指が長い煙草を唇に運ぶ。"
msgstr "  She looked bored as her slender, porcelain fingers lifted a long cigarette to her lips."

#. Occurrence 2_5:852:2932: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0003; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:852
msgctxt "text_id=2932 | speaker=soujuurou"
msgid "『……なんか……どっかで……』"
msgstr "(Feels like... I've seen her somewhere...)"

#. Occurrence 2_5:857:2933: scene=2_5
#: 2_5:857
msgctxt "text_id=2933 | speaker=unknown"
msgid "　そう思った瞬間、メガネごしに視線が壁側―――草十郎を見た。"
msgstr "  Just as that thought crossed his mind, her gaze turned toward the wall, and Soujyuro."

#. Occurrence 2_5:1004:2934: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0004; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1004
msgctxt "text_id=2934 | speaker=soujuurou"
msgid "「………！」"
msgstr "\"...!\""

#. Occurrence 2_5:1009:2935: scene=2_5
#: 2_5:1009
msgctxt "text_id=2935 | speaker=unknown"
msgid "　とたん、背中に走る悪寒。"
msgstr "  Suddenly, a chill ran down his spine."

#. Occurrence 2_5:1014:2936: scene=2_5
#: 2_5:1014
msgctxt "text_id=2936 | speaker=unknown"
msgid "　反射的にこぼれる悲鳴を必死に手で押さえつける。"
msgstr "  He reflexively covered his mouth to keep from shrieking."

#. Occurrence 2_5:1049:2937: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0005; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1049
msgctxt "text_id=2937 | speaker=soujuurou"
msgid "『あの<女|ひと>、昨日の……！』"
msgstr "(It's her! The woman from yesterday!)"

#. Occurrence 2_5:1097:2938: scene=2_5
#: 2_5:1097
msgctxt "text_id=2938 | speaker=unknown"
msgid "　確証のない直感に弾かれて、草十郎は<脱兎|だっと>の如く走り出した。"
msgstr "  Acting on pure instinct, Soujyuro took off running."

#. Occurrence 2_5:1102:2939: scene=2_5
#: 2_5:1102
msgctxt "text_id=2939 | speaker=unknown"
msgid "　この場から一刻も早く逃れようと、まず一階へ。"
msgstr "  He headed straight downstairs, desperate to not be on the same floor as her."

#. Occurrence 2_5:1121:2940: scene=2_5
#: 2_5:1121
msgctxt "text_id=2940 | speaker=unknown"
msgid "　そのまま外に駆け出そうとしたが、最低限の責任として店長に声をかける。"
msgstr "  He would have run straight out the door, but for his obligations to his job."

#. Occurrence 2_5:1163:2941: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0006; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1163
msgctxt "text_id=2941 | speaker=soujuurou"
msgid "「店長、早退します。それと、二階の人は問題ないです」"
msgstr "\"Boss, I'm leaving early. And the person upstairs is fine.\""

#. Occurrence 2_5:1183:2942: scene=2_5
#: 2_5:1183
msgctxt "text_id=2942 | speaker=unknown"
msgid "　心の動揺をなんとか抑えこみながら告げ、学校の制服を紙袋につめて店を飛びだした。"
msgstr "  He tried to keep his composure as he spoke, jamming his school uniform into a paper bag as he ran out of the parlor."

#. Occurrence 2_5:1258:2943: scene=2_5
#: 2_5:1258
msgctxt "text_id=2943 | speaker=unknown"
msgid "　曇った天候のせいか、すでに夜の影が濃い社木の商店街を走り抜けて駅に向かう。"
msgstr "  Cloudy weather brought the shadow of night over Yashirogi as he ran through the shopping arcade toward the station."

#. Occurrence 2_5:1263:2944: scene=2_5
#: 2_5:1263
msgctxt "text_id=2944 | speaker=unknown"
msgid "　長い階段を矢のように駆け上がり、定期を財布から素早く取り出して改札を通り過ぎる。"
msgstr "  He shot up the long staircase like an arrow, quickly pulled his train pass from his wallet, and passed through the ticket gate."

#. Occurrence 2_5:1301:2945: scene=2_5
#: 2_5:1301
msgctxt "text_id=2945 | speaker=unknown"
msgid "　改札には大勢の人々がそれぞれの事情で立ち止まったり、歩いたり、話し合ったりしていた。"
msgstr "  The ticket gate was crowded with people standing around, walking, and talking."

#. Occurrence 2_5:1306:2946: scene=2_5
#: 2_5:1306
msgctxt "text_id=2946 | speaker=unknown"
msgid "　その中で無愛想な顔をしているのは自動改札の横にある駅員室の駅員ぐらいで、ここにはちょっとだけ騒がしい安心があふれていた。"
msgstr "  The station attendant by the automatic ticket machine had an unpleasant look on his face. There was now a familiar, comforting hustle and bustle around him."

#. Occurrence 2_5:1311:2947: scene=2_5
#: 2_5:1311
msgctxt "text_id=2947 | speaker=unknown"
msgid "　都市の日常、と言い換えてもいい。"
msgstr "  Just another day in the city."

#. Occurrence 2_5:1316:2948: scene=2_5
#: 2_5:1316
msgctxt "text_id=2948 | speaker=unknown"
msgid "　間違っても、昨夜の草十郎が見てしまった風景はどこにも見当たらない。"
msgstr "  Nothing like what he witnessed the night before."

#. Occurrence 2_5:1362:2949: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0007; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1362
msgctxt "text_id=2949 | speaker=soujuurou"
msgid "「――――――はあ」"
msgstr "\"...Phew.\""

#. Occurrence 2_5:1368:2950: scene=2_5
#: 2_5:1368
msgctxt "text_id=2950 | speaker=unknown"
msgid "　ようやく肺に空気を送る。"
msgstr "  He could finally breathe again."

#. Occurrence 2_5:1373:2951: scene=2_5
#: 2_5:1373
msgctxt "text_id=2951 | speaker=unknown"
msgid "　つかの間の安心から、草十郎はぴたりと立ち止まった。"
msgstr "  The momentary rush of relief brought him to an abrupt stop."

#. Occurrence 2_5:1378:2952: scene=2_5
#: 2_5:1378
msgctxt "text_id=2952 | speaker=unknown"
msgid "　おそるおそる背後を振り返る。"
msgstr "  He nervously turned around."

#. Occurrence 2_5:1397:2953: scene=2_5
#: 2_5:1397
msgctxt "text_id=2953 | speaker=unknown"
msgid "　当然のように、追いかけてくる危険人物など居るはずもない。"
msgstr "  There was no way that dangerous individual could be behind him."

#. Occurrence 2_5:1418:2954: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0008; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1418
msgctxt "text_id=2954 | speaker=soujuurou"
msgid "『……って、考えてみると……』"
msgstr "(Wait, why would I even...?)"

#. Occurrence 2_5:1424:2955: scene=2_5
#: 2_5:1424
msgctxt "text_id=2955 | speaker=unknown"
msgid "　なぜ唐突に走りだしたのか、その理由が脆弱すぎた。"
msgstr "  He couldn't think of a good reason for why he'd fled so desperately."

#. Occurrence 2_5:1429:2956: scene=2_5
#: 2_5:1429
msgctxt "text_id=2956 | speaker=unknown"
msgid "　そもそも自分は、人相が分かるほど“<危険|あいて>の顔”を見ていなかったではないか、と呆れかえる。"
msgstr "  As far as he could remember, he hadn't even seen the threat's face long enough to form an opinion about her."

#. Occurrence 2_5:1447:2957: scene=2_5
#: 2_5:1447
msgctxt "text_id=2957 | speaker=unknown"
msgid "　頬を叩いて気合いを入れ直し、草十郎は早足でプラットホームに下りていく。"
msgstr "  Soujyuro gave himself a good slap on the cheek to pull himself together and quickly made his way down to the platform."

#. Occurrence 2_5:1452:2958: scene=2_5
#: 2_5:1452
msgctxt "text_id=2958 | speaker=unknown"
msgid "　あいにく電車は十分待ちだったが、ここで取り乱しても仕方がないので大人しく椅子に座った。"
msgstr "  Unfortunately, the next train was ten minutes away, and panicking would do him no favors, so he quietly found an empty seat and sat down."

#. Occurrence 2_5:1514:2959: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0009; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1514
msgctxt "text_id=2959 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 2_5:1520:2960: scene=2_5
#: 2_5:1520
msgctxt "text_id=2960 | speaker=unknown"
msgid "　もういちど深呼吸。"
msgstr "  He took another deep breath."

#. Occurrence 2_5:1525:2961: scene=2_5
#: 2_5:1525
msgctxt "text_id=2961 | speaker=unknown"
msgid "　周りには自分と同じく、電車待ちの人々の姿がある。"
msgstr "  He was surrounded by people waiting for the train just like he was."

#. Occurrence 2_5:1530:2962: scene=2_5
#: 2_5:1530
msgctxt "text_id=2962 | speaker=unknown"
msgid "　……追いかけてくる“誰か”なんて影も形もない。"
msgstr "  ...And no sign of anyone pursuing him."

#. Occurrence 2_5:1535:2963: scene=2_5
#: 2_5:1535
msgctxt "text_id=2963 | speaker=unknown"
msgid "　考えすぎだった、と、ようやく頭がクリアになる。"
msgstr "  His head finally cleared up, and he assured himself that he was overthinking things."

#. Occurrence 2_5:1540:2964: scene=2_5
#: 2_5:1540
msgctxt "text_id=2964 | speaker=unknown"
msgid "　ただ、がっくりと落ちた両肩が重いのが意外だった。"
msgstr "  Though, he was surprised at how heavy his shoulders felt."

#. Occurrence 2_5:1593:2965: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0010; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1593
msgctxt "text_id=2965 | speaker=soujuurou"
msgid "『……疲れてるのは分かってる。自分の体のコトだし』"
msgstr "(I'm just tired, I'm sure of it. I know my own body best, after all.)"

#. Occurrence 2_5:1599:2966: scene=2_5
#: 2_5:1599
msgctxt "text_id=2966 | speaker=unknown"
msgid "　予想以上の強い疲労に、草十郎は嘆息した。"
msgstr "  Soujyuro sighed at his greater-than-expected fatigue."

#. Occurrence 2_5:1604:2967: scene=2_5
#: 2_5:1604
msgctxt "text_id=2967 | speaker=unknown"
msgid "　山を下りてきてからの生活はたしかに過酷だったが、こうして座って振り返ってみると我慢できないほどではなかった。"
msgstr "  He had certainly struggled since coming down from the mountains, but in retrospect, it could have been worse."

#. Occurrence 2_5:1609:2968: scene=2_5
#: 2_5:1609
msgctxt "text_id=2968 | speaker=unknown"
msgid "　肉体的にはたぶんまだまだ大丈夫。"
msgstr "  Physically, he was probably holding up fine."

#. Occurrence 2_5:1614:2969: scene=2_5
#: 2_5:1614
msgctxt "text_id=2969 | speaker=unknown"
msgid "　<音|ね>をあげているのは心の問題だ。"
msgstr "  He was much less confident in his mental state."

#. Occurrence 2_5:1663:2970: scene=2_5
#: 2_5:1663
msgctxt "text_id=2970 | speaker=unknown"
msgid "　ここと山とでは何もかもが違う。"
msgstr "  The city and the mountains could not have been more different."

#. Occurrence 2_5:1668:2971: scene=2_5
#: 2_5:1668
msgctxt "text_id=2971 | speaker=unknown"
msgid "　それを認めて適応する事はひどく難しかった。"
msgstr "  He had been slow to recognize the differences and adapt."

#. Occurrence 2_5:1673:2972: scene=2_5
#: 2_5:1673
msgctxt "text_id=2972 | speaker=unknown"
msgid "　馴染むのは簡単だ。人間はなんにだって慣れる生き物なので、放っておいても順応していく。"
msgstr "  Acclimation was simple enough. Humans were nothing if not adaptable. Even without any effort, one would learn to adjust over time."

#. Occurrence 2_5:1678:2973: scene=2_5
#: 2_5:1678
msgctxt "text_id=2973 | speaker=unknown"
msgid "　なので。難しかったのは、たぶん認める方だろう。"
msgstr "  Recognizing the challenges had been the hard part."

#. Occurrence 2_5:1699:2974: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0011; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1699
msgctxt "text_id=2974 | speaker=soujuurou"
msgid "「……そりゃあ。とにかく、難しいコトだらけだし」"
msgstr "\"...Actually, it's all been difficult.\""

#. Occurrence 2_5:1720:2975: scene=2_5
#: 2_5:1720
msgctxt "text_id=2975 | speaker=unknown"
msgid "　今まで口にしたことのない弱音を漏らす。"
msgstr "  Soujyuro grumbled a complaint he'd never uttered before."

#. Occurrence 2_5:1725:2976: scene=2_5
#: 2_5:1725
msgctxt "text_id=2976 | speaker=unknown"
msgid "　正直、草十郎は町を出歩く事すらいまだに怖い。"
msgstr "  To be honest, he was still afraid to wander around town."

#. Occurrence 2_5:1730:2977: scene=2_5
#: 2_5:1730
msgctxt "text_id=2977 | speaker=unknown"
msgid "　都会の人々には当たり前の事でも、彼にとっては未知の事ばかりなのだ。そんな事が連続するたびに驚いているのだから、まいらない筈がない。"
msgstr "  There were so many things city people took for granted that Soujyuro had yet to grasp. It was little wonder that this neverending chain of surprises would wear on him."

#. Occurrence 2_5:1755:2978: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0012; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1755
msgctxt "text_id=2978 | speaker=soujuurou"
msgid "『……そっか……疲れてるのは体じゃないのか……』"
msgstr "(Oh... It isn't my body that's tired.)"

#. Occurrence 2_5:1773:2979: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0013; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1773
msgctxt "text_id=2979 | speaker=soujuurou"
msgid "「だから、あんな幻を見る」"
msgstr "\"That would explain the hallucination.\""

#. Occurrence 2_5:1808:2980: scene=2_5
#: 2_5:1808
msgctxt "text_id=2980 | speaker=unknown"
msgid "　呟いてみて、草十郎は小さく首を横に振った。"
msgstr "  He muttered to himself, then shook his head."

#. Occurrence 2_5:1813:2981: scene=2_5
#: 2_5:1813
msgctxt "text_id=2981 | speaker=unknown"
msgid "　有る物は有るのが、世の習わしだ。"
msgstr "  That which exists, exists. Such was the way of all things."

#. Occurrence 2_5:1818:2982: scene=2_5
#: 2_5:1818
msgctxt "text_id=2982 | speaker=unknown"
msgid "　鳶丸にはああは言ったが、草十郎は<あ|・><の|・><出|・><来|・><事|・>が現実だと解っていた。"
msgstr "  Tobimaru had called it a hallucination, but Soujyuro knew what he saw was real."

#. Occurrence 2_5:1892:2983: scene=2_5
#: 2_5:1892
msgctxt "text_id=2983 | speaker=unknown"
msgid "　ここは山に比べれば魔法の国だ。"
msgstr "  The city was a magical kingdom compared to the mountains."

#. Occurrence 2_5:1897:2984: scene=2_5
#: 2_5:1897
msgctxt "text_id=2984 | speaker=unknown"
msgid "　それなら、本物の魔法使いがこっそり暮らしててもおかしくはない。"
msgstr "  If there were real magicians secretly living here, that should have been no surprise at all."

#. Occurrence 2_5:1902:2985: scene=2_5
#: 2_5:1902
msgctxt "text_id=2985 | speaker=unknown"
msgid "　一度でもそう思ってしまったら、椅子に座った両足が小刻みに震えていた。どうも怖いらしい、と気付いたのはしばらくしてからだ。"
msgstr "  The thought alone made his legs tremble. It took him a moment longer to realize that they were quivering out of fear."

#. Occurrence 2_5:1907:2986: scene=2_5
#: 2_5:1907
msgctxt "text_id=2986 | speaker=unknown"
msgid "　自然以外を怖いと思うのは、子供のころ山道でばったり野生の熊に出会った時以来である。"
msgstr "  He had feared the unnatural ever since he encountered a wild bear on a mountain path as a child."

#. Occurrence 2_5:1959:2987: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0014; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1959
msgctxt "text_id=2987 | speaker=soujuurou"
msgid "「いや、あれはこんなもんじゃなかったっけ。"
msgstr "\"But this is nothing like that."

#. Occurrence 2_5:1965:2988: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0015; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:1965
msgctxt "text_id=2988 | speaker=soujuurou"
msgid "　なりふりかまわず泣き叫んだもんな、あの時は」"
msgstr "  I cried and screamed my head off back then.\""

#. Occurrence 2_5:1971:2989: scene=2_5
#: 2_5:1971
msgctxt "text_id=2989 | speaker=unknown"
msgid "　幼少期のトンデモなトラウマを思い出し、草十郎はつい<微|わ><笑|ら>ってしまった。"
msgstr "  Soujyuro smiled a little as he recalled his traumatic childhood memory."

#. Occurrence 2_5:1991:2990: scene=2_5
#: 2_5:1991
msgctxt "text_id=2990 | speaker=unknown"
msgid "　たしかに二メートル以上の獣がのっそり現れ、ぐるるる、なんて唸った日には誰だって卒倒するだろう。"
msgstr "  Anyone would have fainted at the sudden appearance of a growling beast that towered over 6 feet tall."

#. Occurrence 2_5:1996:2991: scene=2_5
#: 2_5:1996
msgctxt "text_id=2991 | speaker=unknown"
msgid "　山で生活していた草十郎からしてどのくらい迫力があったかと言うと、ほんの二日前に映画で見た大怪獣をぬいぐるみでは、と錯覚するぐらい野生の獣は怖かった。"
msgstr "  The monster in the movie that Soujyuro saw not two days ago was the equivalent of a cuddly stuffed animal when compared to the wild mountain creatures."

#. Occurrence 2_5:2001:2992: scene=2_5
#: 2_5:2001
msgctxt "text_id=2992 | speaker=unknown"
msgid "　それを思い出せば、たしかに、これぐらいはなんとか我慢できる話かもしれない。"
msgstr "  He was reminded that he'd faced far worse before, and his ordeal now was something he could endure."

#. Occurrence 2_5:2054:2993: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0016; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:2054
msgctxt "text_id=2993 | speaker=soujuurou"
msgid "「……そうだよな。今の問題は、えーと……チラっと聞こえた最後の台詞か。『捕まえて始末する』っていうのは、どうなんだ？」"
msgstr "\"That's right. The problem now, is... what I heard someone say at the end. What's 'catch and eliminate' supposed to mean?\""

#. Occurrence 2_5:2060:2994: scene=2_5
#: 2_5:2060
msgctxt "text_id=2994 | speaker=unknown"
msgid "　額面通りにとるのなら、それこそ文字通りの意味、というヤツだ。"
msgstr "  At face value, the meaning was obvious."

#. Occurrence 2_5:2065:2995: scene=2_5
#: 2_5:2065
msgctxt "text_id=2995 | speaker=unknown"
msgid "　あまりにも物騒な意味合いすぎて、真剣に考察することが難しい。何かの聞き間違い、あるいは言い間違いだったのだろう、と放り投げてしまいたくなる。"
msgstr "  But the implications were simply too frightening to contemplate seriously. Perhaps he had misheard the words, or perhaps the speaker had misspoke."

#. Occurrence 2_5:2087:2996: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0017; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:2087
msgctxt "text_id=2996 | speaker=soujuurou"
msgid "「都会のルール……誰かが、きっと罰しに来る、か……」"
msgstr "\"The law of the city... means someone will deal out punishment eventually...\""

#. Occurrence 2_5:2093:2997: scene=2_5
#: 2_5:2093
msgctxt "text_id=2997 | speaker=unknown"
msgid "　自分で言っておきながら、やっぱり他人ごとのようで、夢だったと割り切りたい気分だ。"
msgstr "  Even as he said it, the idea didn't feel quite real. It was hard to imagine that it applied to him."

#. Occurrence 2_5:2116:2998: scene=2_5
#: 2_5:2116
msgctxt "text_id=2998 | speaker=unknown"
msgid "　草十郎は息をついて瞼を閉じる。"
msgstr "  Soujyuro breathed in and closed his eyes."

#. Occurrence 2_5:2121:2999: scene=2_5
#: 2_5:2121
msgctxt "text_id=2999 | speaker=unknown"
msgid "　視界の暗転と共に先ほどの光景をすべて棚上げ。"
msgstr "  His vision dimmed, putting the illuminated cityscape out of sight, and out of mind."

#. Occurrence 2_5:2126:3000: scene=2_5
#: 2_5:2126
msgctxt "text_id=3000 | speaker=unknown"
msgid "　とりあえず、今はきれいさっぱり昨夜の出来事を忘れる事にした。"
msgstr "  For now, he resolved to put last night's events behind him."

#. Occurrence 2_5:2175:3001: scene=2_5
#: 2_5:2175
msgctxt "text_id=3001 | speaker=unknown"
msgid "　瞼を開けると、呼吸はすっかり落ち着いていた。"
msgstr "  When he opened his eyes, his breathing had calmed."

#. Occurrence 2_5:2182:3002: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0018; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:2182
msgctxt "text_id=3002 | speaker=soujuurou"
msgid "「それでさ。"
msgstr "\"I wonder..."

#. Occurrence 2_5:2188:3003: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_2_5_0019; voice_prefix=A30; voice_category=3; scene=2_5
#: 2_5:2188
msgctxt "text_id=3003 | speaker=soujuurou"
msgid "　蒼崎を殴りつけようとして、結局どうなったんだ鳶丸？」"
msgstr "  What happened to Tobimaru when he tried to hit Aozaki?\""

#. Occurrence 2_5:2195:3004: scene=2_5
#: 2_5:2195
msgctxt "text_id=3004 | speaker=unknown"
msgid "　なんとなく唐突に、そんな疑問が湧いたりする。"
msgstr "  The question suddenly popped into Soujyuro's head."

#. Occurrence 2_5:2200:3005: scene=2_5
#: 2_5:2200
msgctxt "text_id=3005 | speaker=unknown"
msgid "　今度聞いてみよう、と草十郎が椅子から立ち上がった時、長い光を引いて電車がやってきた。"
msgstr "  He decided he would ask next time, and stood up from his chair. A long streak of light blazed by, announcing the arrival of the next train."

#. Occurrence 3_1:59:3006: scene=3_1
#: 3_1:59
msgctxt "text_id=3006 | speaker=unknown"
msgid "　つまり、"
msgstr "  Let me tell you..."

msgctxt "text_id=3007 | speaker=unknown"
msgid "昨日こんな事があった。"
msgstr " how the events of yesterday transpired."

#. Occurrence 3_1:108:3008: scene=3_1
#: 3_1:108
msgctxt "text_id=3008 | speaker=unknown"
msgid "　“月の無い夜は、決して振り向いてはいけないよ―――”"
msgstr "  \"On moonless nights, you must never look back.\""

#. Occurrence 3_1:130:3009: scene=3_1
#: 3_1:130
msgctxt "text_id=3009 | speaker=unknown"
msgid "　それは教訓だったのか、警告だったのか。"
msgstr "  Was it a lesson or was it a warning?"

#. Occurrence 3_1:135:3010: scene=3_1
#: 3_1:135
msgctxt "text_id=3010 | speaker=unknown"
msgid "　ずいぶんと昔……私がまだ今の<自分|ありかた>を夢にも思っていなかった頃。"
msgstr "  It was so very long ago. At the time, I could not have imagined what I, what my very being, would become."

#. Occurrence 3_1:140:3011: scene=3_1
#: 3_1:140
msgctxt "text_id=3011 | speaker=unknown"
msgid "　突然、何の前触れもなく、泣きだしたくなるぐらいの不安でいっぱいになって、祖父の工房に逃げこんだ夜の話だ。"
msgstr "  One night, it came without warning. I was filled with an anxiety so heightened that it made me want to burst into tears, so I fled to my grandfather's workshop."

#. Occurrence 3_1:145:3012: scene=3_1
#: 3_1:145
msgctxt "text_id=3012 | speaker=unknown"
msgid "　祖父は別人のように優しく微笑み、私の頭に静かに手を乗せて、"
msgstr "  Unlike the grandfather I knew, he smiled and kindly placed his hand upon my head."

#. Occurrence 3_1:170:3013: scene=3_1
#: 3_1:170
msgctxt "text_id=3013 | speaker=unknown"
msgid "　“―――<赤色|あかいろ>の死が、おまえの背中を見ているからね”"
msgstr "  \"...Yes, the red death follows your every step.\""

#. Occurrence 3_1:192:3014: scene=3_1
#: 3_1:192
msgctxt "text_id=3014 | speaker=unknown"
msgid "　そんな、気休めどころかより絶望的な言葉を残して、私を家につき返した。"
msgstr "  Rather than consoling me, he sent me home with only those haunting words."

#. Occurrence 3_1:197:3015: scene=3_1
#: 3_1:197
msgctxt "text_id=3015 | speaker=unknown"
msgid "　私はあの夜、たしかに背後に<潜|ひそ>む影を認めた。"
msgstr "  That night, I was certain that I sensed a shadow lurking behind me."

#. Occurrence 3_1:202:3016: scene=3_1
#: 3_1:202
msgctxt "text_id=3016 | speaker=unknown"
msgid "　ずっと遠くから私を見ている何者か。"
msgstr "  Something or someone watching me from afar..."

#. Occurrence 3_1:209:3017: scene=3_1
#: 3_1:209
msgctxt "text_id=3017 | speaker=unknown"
msgid "　それは少しずつ、年々距離を<縮|ちぢ>めていき―――"
msgstr "  Then little by little, year by year, it drew closer."

#. Occurrence 3_1:215:3018: scene=3_1
#: 3_1:215
msgctxt "text_id=3018 | speaker=unknown"
msgid "　小さな点ほどだった気配は、その息づかいさえ感じるほどすぐ後ろまで迫っていた。"
msgstr "  Eventually, the presence that once felt like a spot on the horizon grew so close that I could feel its breath down the base of my neck."

#. Occurrence 3_1:245:3019: scene=3_1
#: 3_1:245
msgctxt "text_id=3019 | speaker=unknown"
msgid "　もちろん錯覚。"
msgstr "  Of course it was all in my mind."

#. Occurrence 3_1:250:3020: scene=3_1
#: 3_1:250
msgctxt "text_id=3020 | speaker=unknown"
msgid "　振り向いた先には誰もいない。"
msgstr "  When I turned around, nobody was there."

#. Occurrence 3_1:256:3021: scene=3_1
#: 3_1:256
msgctxt "text_id=3021 | speaker=unknown"
msgid "　ただ―――きっかけになったあの夜。"
msgstr "  But that night marked the beginning."

#. Occurrence 3_1:261:3022: scene=3_1
#: 3_1:261
msgctxt "text_id=3022 | speaker=unknown"
msgid "　あの時の言いようのない不安は、間違いなく、約束された<恐怖|し>に起因するものだった。"
msgstr "  In hindsight, I later understood that the indescribable anxiety I felt was the dread of certain death."

#. Occurrence 3_1:336:3023: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_3_1_9000; voice_prefix=A40; voice_category=2; scene=3_1
#: 3_1:336
msgctxt "text_id=3023 | speaker=alice"
msgid "“"
msgstr "\""

msgctxt "text_id=3024 | speaker=unknown"
msgid "……Hey diddle diddle,The cat and the fiddle,"
msgstr "...Hey diddle diddle, the cat and the fiddle,"

msgctxt "text_id=3025 | speaker=unknown"
msgid "　The cow jump'd over the moon,"
msgstr "  The cow jump'd over the moon,"

msgctxt "text_id=3026 | speaker=unknown"
msgid "　The little dog laugh'd……”"
msgstr "  The little dog laugh'd...\""

#. Occurrence 3_1:357:3027: scene=3_1
#: 3_1:357
msgctxt "text_id=3027 | speaker=unknown"
msgid "　……あれはいつの話だっただろう。"
msgstr "  ...How much time has passed since that night?"

#. Occurrence 3_1:362:3028: scene=3_1
#: 3_1:362
msgctxt "text_id=3028 | speaker=unknown"
msgid "　遠い子供の頃の記憶の片隅。"
msgstr "  It lingered deep in the recesses of my mind where childhood memories are kept."

#. Occurrence 3_1:367:3029: scene=3_1
#: 3_1:367
msgctxt "text_id=3029 | speaker=unknown"
msgid "　絵日記じみたかすかな思い出。"
msgstr "  A faded, story book-esque memory."

#. Occurrence 3_1:372:3030: scene=3_1
#: 3_1:372
msgctxt "text_id=3030 | speaker=unknown"
msgid "　……暗い夜には決まって祖父の言葉が耳に響く。"
msgstr "  On dark nights, I still hear the faint echo of my grandfather's words."

#. Occurrence 3_1:377:3031: scene=3_1
#: 3_1:377
msgctxt "text_id=3031 | speaker=unknown"
msgid "　どんなに風が強く吹いても、<傍|かたわ>らの少女の<鐘|うた>が聞き惚れるほどのものでも、不吉な言葉をかき消す事はできない。"
msgstr "  But no matter how strong the wind may howl, or how entrancing the song of the girl next to me, I could never bury his ominous words completely."

#. Occurrence 3_1:411:3032: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_3_1_0000; voice_prefix=A40; voice_category=2; scene=3_1
#: 3_1:411
msgctxt "text_id=3032 | speaker=alice"
msgid "「……ご到着ね」"
msgstr "\"...It's here.\""

#. Occurrence 3_1:427:3033: scene=3_1
#: 3_1:427
msgctxt "text_id=3033 | speaker=unknown"
msgid "　傍らの<少女|ありす>が言った。"
msgstr "  The girl beside me said."

#. Occurrence 3_1:432:3034: scene=3_1
#: 3_1:432
msgctxt "text_id=3034 | speaker=unknown"
msgid "　抑揚のない声は、完全に傍観者でいる事を示している。"
msgstr "  Alice's inflectionless voice spoke volumes of her role as the bystander."

#. Occurrence 3_1:464:3035: scene=3_1
#: 3_1:464
msgctxt "text_id=3035 | speaker=unknown"
msgid "　夜の公園には私と彼女だけ。"
msgstr "  That night, there was only me and her."

#. Occurrence 3_1:469:3036: scene=3_1
#: 3_1:469
msgctxt "text_id=3036 | speaker=unknown"
msgid "　今日は私にとって“今の自分”の誕生日。"
msgstr "  It was the night I would mark as the birth of who I am today."

#. Occurrence 3_1:474:3037: scene=3_1
#: 3_1:474
msgctxt "text_id=3037 | speaker=unknown"
msgid "　記念すべき<初陣|ういじん>にしては、少々不吉な夜と言わざるをえない。"
msgstr "  For what should have been quite the memorable night, it sure wasn't a promising start."

#. Occurrence 3_1:522:3038: scene=3_1
#: 3_1:522
msgctxt "text_id=3038 | speaker=unknown"
msgid "　ぶあつい雲は黒い傘のように星明かりを<遮|さえぎ>っている。"
msgstr "  Dense clouds blocked the starlight above like a black umbrella."

#. Occurrence 3_1:527:3039: scene=3_1
#: 3_1:527
msgctxt "text_id=3039 | speaker=unknown"
msgid "　強い風は夜空を引き裂き、重い雲を運んでいく。"
msgstr "  Strong wind tore through the sky, carrying the heavy clouds with it."

#. Occurrence 3_1:532:3040: scene=3_1
#: 3_1:532
msgctxt "text_id=3040 | speaker=unknown"
msgid "　公園の真ん中に立つ柱時計の針は、二本とも頭上の月を指すように頂点を向いている。"
msgstr "  The hands on the clock in the middle of the park pointed skyward, as if reaching for the moon."

#. Occurrence 3_1:556:3041: scene=3_1
#: 3_1:556
msgctxt "text_id=3041 | speaker=unknown"
msgid "　あいにくと、今日は月のない夜だったけれど。"
msgstr "  Unfortunately for them, tonight there was no moon to point at."

#. Occurrence 3_1:607:3042: scene=3_1
#: 3_1:607
msgctxt "text_id=3042 | speaker=unknown"
msgid "　冬の大気は、深夜になって狂暴さを増している。"
msgstr "  The winter air grew fiercer as the night wore on."

#. Occurrence 3_1:612:3043: scene=3_1
#: 3_1:612
msgctxt "text_id=3043 | speaker=unknown"
msgid "　息を吸うだけで体の中が凍る気がする。"
msgstr "  Inhaling felt as though it would freeze me from the inside."

#. Occurrence 3_1:655:3044: scene=3_1
#: 3_1:655
msgctxt "text_id=3044 | speaker=unknown"
msgid "　骨に染みこむような冷気は、そのまま背骨を通じて脳に直接入りこんでくる。"
msgstr "  The air chilled me to the bone, threatening to pass up my spine directly to my brain."

#. Occurrence 3_1:661:3045: scene=3_1
#: 3_1:661
msgctxt "text_id=3045 | speaker=unknown"
msgid "　思考が寒さで麻痺しないよう、"
msgstr "  To prevent my mind from being paralyzed,"

#. Occurrence 3_1:667:3046: scene=3_1
#: 3_1:667
msgctxt "text_id=3046 | speaker=unknown"
msgid "　指先が寒気で化石にならないよう、"
msgstr "  and to prevent my fingertips from becoming stone,"

#. Occurrence 3_1:673:3047: scene=3_1
#: 3_1:673
msgctxt "text_id=3047 | speaker=unknown"
msgid "　私は、自分の<鼓動|リズム>と感情を炎にくべた。"
msgstr "  I sparked a fire using my internal rhythm and emotion. "

#. Occurrence 3_1:731:3048: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_3_1_0001; voice_prefix=A40; voice_category=2; scene=3_1
#: 3_1:731
msgctxt "text_id=3048 | speaker=alice"
msgid "「触覚を<譲|ゆず>るわ。……幸運ね。"
msgstr "\"I'm transferring tactile feedback to you. ...Good luck."

#. Occurrence 3_1:731:3049: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_3_1_0001; voice_prefix=A40; voice_category=2; scene=3_1
#: 3_1:731
msgctxt "text_id=3049 | speaker=alice"
msgid "　あの位置なら刻んでおいた<鬼火|ウィスプ>が灯る」"
msgstr "  Stand over there, and the engraved will-o'-the-wisp will ignite.\""

#. Occurrence 3_1:737:3050: scene=3_1
#: 3_1:737
msgctxt "text_id=3050 | speaker=unknown"
msgid "　有珠の言葉に頷きだけで応える。"
msgstr "  I responded to Alice with a nod."

#. Occurrence 3_1:742:3051: scene=3_1
#: 3_1:742
msgctxt "text_id=3051 | speaker=unknown"
msgid "　その時、一瞬だけ地面が見えた。"
msgstr "  And then, for just a moment, I saw the ground."

#. Occurrence 3_1:762:3052: scene=3_1
#: 3_1:762
msgctxt "text_id=3052 | speaker=unknown"
msgid "　……私の両足はかすかに震えている。"
msgstr "  ...My legs quivered ever so faintly."

#. Occurrence 3_1:767:3053: scene=3_1
#: 3_1:767
msgctxt "text_id=3053 | speaker=unknown"
msgid "　寒いから震えているんだ、と判断したけれど自信はなかった。"
msgstr "  I told myself they were shaking from the cold, but I wasn't so sure."

#. Occurrence 3_1:772:3054: scene=3_1
#: 3_1:772
msgctxt "text_id=3054 | speaker=unknown"
msgid "　本当は寒さではなく恐怖で<痺|しび>れてしまっているのかも知れない。……ホッと息を吐く。感情が働いているのなら、私はじゅうぶんに人間らしい。"
msgstr "  In reality, they may not have been numbed by the cold, but by fear. I breathe a sigh of relief. My humanity must still be intact if my emotions are still present."

#. Occurrence 3_1:847:3055: scene=3_1
#: 3_1:847
msgctxt "text_id=3055 | speaker=unknown"
msgid "　そんな感傷にひたる間もなく、結界の感触が有珠から私に移ってきた。"
msgstr "  Before I could sink into a pool of my own sentimentality, the sensations from the Bounded Field flowed from Alice into me."

#. Occurrence 3_1:853:3056: scene=3_1
#: 3_1:853
msgctxt "text_id=3056 | speaker=unknown"
msgid "　この公園一帯に敷かれた透明の<境|かべ>。"
msgstr "  A transparent wall covered the entire park."

#. Occurrence 3_1:858:3057: scene=3_1
#: 3_1:858
msgctxt "text_id=3057 | speaker=unknown"
msgid "　地中深くまで根を張った認知外の絨毯。"
msgstr "  An unrecognizable carpet rooted deep under the earth."

#. Occurrence 3_1:937:3058: scene=3_1
#: 3_1:937
msgctxt "text_id=3058 | speaker=unknown"
msgid "　―――夜に<浸|ひび>く、久遠寺有珠の<童話詠唱|マザーグース>。"
msgstr "  Alice Kuonji's chants of the Mother Goose fairy tales permeated the night."

#. Occurrence 3_1:947:3059: scene=3_1
#: 3_1:947
msgctxt "text_id=3059 | speaker=unknown"
msgid "　それらの感覚と、私の体がひとつになる。"
msgstr "  The sensations became one with my body."

#. Occurrence 3_1:986:3060: scene=3_1
#: 3_1:986
msgctxt "text_id=3060 | speaker=unknown"
msgid "　ざわり、と右腕に鳥肌がたつ。"
msgstr "  I felt goosebumps on my quivering right arm."

#. Occurrence 3_1:991:3061: scene=3_1
#: 3_1:991
msgctxt "text_id=3061 | speaker=unknown"
msgid "　誰かが私の腕に侵入したのだ。"
msgstr "  Someone had trespassed."

#. Occurrence 3_1:1038:3062: scene=3_1
#: 3_1:1038
msgctxt "text_id=3062 | speaker=unknown"
msgid "　鳥肌は<蟻|あり>のように右腕を<這|は>い上がってくる。"
msgstr "  The goosebumps crept up my right arm like ants,"

#. Occurrence 3_1:1043:3063: scene=3_1
#: 3_1:1043
msgctxt "text_id=3063 | speaker=unknown"
msgid "　ゆっくりと、確実に、この心臓めがけて。"
msgstr "  and slowly but surely, made inroads for my heart."

#. Occurrence 3_1:1048:3064: scene=3_1
#: 3_1:1048
msgctxt "text_id=3064 | speaker=unknown"
msgid "　払い<除|の>けたくなる衝動をおさえて、より決定的な位置、より確実な到来を待つ。"
msgstr "  Holding back the desire to drive them out, I waited for them to reach a certain, definitive position."

#. Occurrence 3_1:1093:3065: scene=3_1
#: 3_1:1093
msgctxt "text_id=3065 | speaker=unknown"
msgid "　月の無い夜。"
msgstr "  A moonless night."

#. Occurrence 3_1:1098:3066: scene=3_1
#: 3_1:1098
msgctxt "text_id=3066 | speaker=unknown"
msgid "　公園の小さな街灯だけでは、闇の<全容|すべて>は見渡せない。"
msgstr "  The park's quaint street lights were not enough to lift the darkness."

#. Occurrence 3_1:1136:3067: scene=3_1
#: 3_1:1136
msgctxt "text_id=3067 | speaker=unknown"
msgid "　蟻の進行は止まった。"
msgstr "  The ants came to a stop."

#. Occurrence 3_1:1141:3068: scene=3_1
#: 3_1:1141
msgctxt "text_id=3068 | speaker=unknown"
msgid "　私の右腕から離れて離れて<心臓|まなか>のとなり。"
msgstr "  Far, far from my right arm, they had reached my very heart."

#. Occurrence 3_1:1168:3069: scene=3_1
#: 3_1:1168
msgctxt "text_id=3069 | speaker=unknown"
msgid "　視覚を動員することなく、闇に<潜|ひそ>む侵入者の姿が見える。"
msgstr "  Even without the aid of my sense of sight, I could see the intruder lurking in the darkness."

#. Occurrence 3_1:1173:3070: scene=3_1
#: 3_1:1173
msgctxt "text_id=3070 | speaker=unknown"
msgid "　ここから<右舷|うげん>後方三十歩ほどの茂みの<陰|かげ>、四つんばいに手足をついたソレは<手招|てまね>きするように右手をあげ―――"
msgstr "  To starboard, in the bushes about thirty steps back, on all fours. It was beckoning with its right hand."

#. Occurrence 3_1:1204:3071: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0000; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:1204
msgctxt "text_id=3071 | speaker=aoko"
msgid "「―――そこ！」"
msgstr "\"...There!\""

#. Occurrence 3_1:1210:3072: scene=3_1
#: 3_1:1210
msgctxt "text_id=3072 | speaker=unknown"
msgid "　私の知覚と、敵の行動はほぼ同時だった。"
msgstr "  The enemy's movement and my perception of it were in lockstep."

#. Occurrence 3_1:1230:3073: scene=3_1
#: 3_1:1230
msgctxt "text_id=3073 | speaker=unknown"
msgid "　体が振り向く。"
msgstr "  I spun around."

#. Occurrence 3_1:1282:3074: scene=3_1
#: 3_1:1282
msgctxt "text_id=3074 | speaker=unknown"
msgid "　敵の腕は槍のように伸びた。"
msgstr "  The enemy's arm stretched out like a spear."

#. Occurrence 3_1:1330:3075: scene=3_1
#: 3_1:1330
msgctxt "text_id=3075 | speaker=unknown"
msgid "　高速で後頭部に放たれた凶器が、私の髪をさらっていく。"
msgstr "  This lethal weapon, aimed at the back of my head, brushed my hair at breakneck speed."

#. Occurrence 3_1:1335:3076: scene=3_1
#: 3_1:1335
msgctxt "text_id=3076 | speaker=unknown"
msgid "　有珠から結界を<譲渡|じょうと>され、ここ一帯そのものとなった全能の知覚が、最小の回避を可能とする。"
msgstr "  With the omniscient awareness granted by Alice's ward, I managed to avoid it by the skin of my teeth."

#. Occurrence 3_1:1388:3077: scene=3_1
#: 3_1:1388
msgctxt "text_id=3077 | speaker=unknown"
msgid "　礼儀知らずの蛮行に舞い上がる髪。"
msgstr "  My hair fanned through the air from the violence of the attack."

#. Occurrence 3_1:1428:3078: scene=3_1
#: 3_1:1428
msgctxt "text_id=3078 | speaker=unknown"
msgid "　頬をかする、小さいが鋭い痛み。"
msgstr "  The strike grazed my cheek, and I felt a small, sharp pain."

#. Occurrence 3_1:1456:3079: scene=3_1
#: 3_1:1456
msgctxt "text_id=3079 | speaker=unknown"
msgid "　―――死が、魂に触れた気がした。"
msgstr "  It felt like the kiss of death."

#. Occurrence 3_1:1508:3080: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0001; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:1508
msgctxt "text_id=3080 | speaker=aoko"
msgid "「っ―――！」"
msgstr "\"...!\""

#. Occurrence 3_1:1563:3081: scene=3_1
#: 3_1:1563
msgctxt "text_id=3081 | speaker=unknown"
msgid "　体内の血流を、異なる<循環|かいろ>に切り替える。"
msgstr "  I switched the flow of my body's blood to a different cycle."

#. Occurrence 3_1:1568:3082: scene=3_1
#: 3_1:1568
msgctxt "text_id=3082 | speaker=unknown"
msgid "　秒速一メートルで体内を巡る血液が、架空の元素に変質する。"
msgstr "  The blood running through my veins at a few feet per second transmuted into an imaginary element."

#. Occurrence 3_1:1574:3083: scene=3_1
#: 3_1:1574
msgctxt "text_id=3083 | speaker=unknown"
msgid "心臓はまったく別の<生|エ><成|ン><機|ジ><関|ン>に成りはてて、私の体を一つの回路として利用する。"
msgstr "My body became a single circuit and my heart transformed into a completely different engine."

#. Occurrence 3_1:1595:3084: scene=3_1
#: 3_1:1595
msgctxt "text_id=3084 | speaker=unknown"
msgid "　熱量として計測されない不可知の運動。"
msgstr "  Within me stirred an unknowable motion of immeasurable heat--"

#. Occurrence 3_1:1600:3085: scene=3_1
#: 3_1:1600
msgctxt "text_id=3085 | speaker=unknown"
msgid "　私を今の私にならしめた、いまだ人の手の及ばぬ神秘。"
msgstr "  Something Mystic, yet untapped by humankind, that made me who I am."

#. Occurrence 3_1:1605:3086: scene=3_1
#: 3_1:1605
msgctxt "text_id=3086 | speaker=unknown"
msgid "　あらゆる奇跡、<寓話|ぐうわ>の動力となる生命の火。"
msgstr "  It was the fire of life behind all miracles and fables--"

#. Occurrence 3_1:1657:3087: scene=3_1
#: 3_1:1657
msgctxt "text_id=3087 | speaker=unknown"
msgid "　これを、私たちは魔力と呼ぶ。"
msgstr "  what we mages called magical energy."

#. Occurrence 3_1:1705:3088: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0002; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:1705
msgctxt "text_id=3088 | speaker=aoko"
msgid "「―――<接続|セット>」"
msgstr "\"...<Connecting|Set.>.\""

#. Occurrence 3_1:1752:3089: scene=3_1
#: 3_1:1752
msgctxt "text_id=3089 | speaker=unknown"
msgid "　振り向いて敵を視界に収め、片手を振りかぶる。"
msgstr "  I turned around, set the enemy in my sights, and held up one hand."

#. Occurrence 3_1:1757:3090: scene=3_1
#: 3_1:1757
msgctxt "text_id=3090 | speaker=unknown"
msgid "　腕は意志の代行だ。"
msgstr "  My arm was the agent of my will."

#. Occurrence 3_1:1762:3091: scene=3_1
#: 3_1:1762
msgctxt "text_id=3091 | speaker=unknown"
msgid "　私はまだ未熟だから、<発|こ><音|え>と<手足|どうさ>を使わないと魔術は働いてくれない。"
msgstr "  My lack of experience meant my magecraft would only be possible with the use of vocalizations and gestures."

#. Occurrence 3_1:1842:3092: scene=3_1
#: 3_1:1842
msgctxt "text_id=3092 | speaker=unknown"
msgid "　魔術式は予め公園に刻まれている。"
msgstr "  Magical formulae were engraved all over the park."

#. Occurrence 3_1:1847:3093: scene=3_1
#: 3_1:1847
msgctxt "text_id=3093 | speaker=unknown"
msgid "　私がするコトは、その式に火をくべるだけ。"
msgstr "  All I had to do was ignite them."

#. Occurrence 3_1:1852:3094: scene=3_1
#: 3_1:1852
msgctxt "text_id=3094 | speaker=unknown"
msgid "　体内で生成した魔力を、各自それぞれの方式で流しこめばいい。"
msgstr "  I needed to direct the flow of the magical energy within my body into each formula."

#. Occurrence 3_1:1903:3095: scene=3_1
#: 3_1:1903
msgctxt "text_id=3095 | speaker=unknown"
msgid "　たいていの魔術師は転移方式だ。有線にしろ無線にしろ、式に魔力を<注|そそ>げばいい。"
msgstr "  Typically, a mage acts as a conduit. Whether wired or wireless, the mage simply pours magical energy into the formula."

#. Occurrence 3_1:1909:3096: scene=3_1
#: 3_1:1909
msgctxt "text_id=3096 | speaker=unknown"
msgid "　“出す”“撃つ”“流す”と色々あるけど、私の場合はなんていうか、こう―――"
msgstr "  Releasing this energy in the form of a projectile, stream, or any number of other methods would usually suffice, but in my case..."

msgctxt "text_id=3097 | speaker=unknown"
msgid "自分の手足で<弾|はじ>く感じ……！"
msgstr " It was the feeling of my limbs whipping out!"

#. Occurrence 3_1:1951:3098: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0003; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:1951
msgctxt "text_id=3098 | speaker=aoko"
msgid "「―――燃えろ！」"
msgstr "\"Burn!\""

#. Occurrence 3_1:2015:3099: scene=3_1
#: 3_1:2015
msgctxt "text_id=3099 | speaker=unknown"
msgid "　高速に高速で対抗する。"
msgstr "  I fought speed with speed."

#. Occurrence 3_1:2072:3100: scene=3_1
#: 3_1:2072
msgctxt "text_id=3100 | speaker=unknown"
msgid "　数メートル伸ばした腕はそのまま、敵は炎に包まれた。"
msgstr "  The enemy's arm, extended ten feet forward, became engulfed in flames."

#. Occurrence 3_1:2077:3101: scene=3_1
#: 3_1:2077
msgctxt "text_id=3101 | speaker=unknown"
msgid "　夜の公園というコトもあってキャンプファイヤーを連想させる。ただ、炎の中で影絵のように<蠢|うごめ>くのは人間らしき姿だったけど。"
msgstr "  It was nighttime at the park. The scene, reminiscent of a campfire, but one in which the center of the flames contained a humanoid figure wriggling like a shadow puppet."

#. Occurrence 3_1:2135:3102: scene=3_1
#: 3_1:2135
msgctxt "text_id=3102 | speaker=unknown"
msgid "　不自然に発した炎は、やっぱり不自然に消えた。"
msgstr "  The flame subsided just as unnaturally as it had ignited."

#. Occurrence 3_1:2140:3103: scene=3_1
#: 3_1:2140
msgctxt "text_id=3103 | speaker=unknown"
msgid "　物を焼く音も、焦げた臭いもあまりない。"
msgstr "  No crackling, no burning smell."

#. Occurrence 3_1:2185:3104: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0004; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2185
msgctxt "text_id=3104 | speaker=aoko"
msgid "「―――結界、返すわ。死体を確認するから」"
msgstr "\"You can have the Bounded Field back. I'll check the remains.\""

#. Occurrence 3_1:2209:3105: scene=3_1
#: 3_1:2209
msgctxt "text_id=3105 | speaker=unknown"
msgid "　傍らの彼女に言って、もう動かない人影に足を向けた。"
msgstr "  After telling this to Alice, I headed toward the motionless figure."

#. Occurrence 3_1:2232:3106: scene=3_1
#: 3_1:2232
msgctxt "text_id=3106 | speaker=unknown"
msgid "　殺した。"
msgstr "  I killed it."

#. Occurrence 3_1:2238:3107: scene=3_1
#: 3_1:2238
msgctxt "text_id=3107 | speaker=unknown"
msgid "殺した。"
msgstr "I killed it."

#. Occurrence 3_1:2244:3108: scene=3_1
#: 3_1:2244
msgctxt "text_id=3108 | speaker=unknown"
msgid "殺した。"
msgstr "I killed it."

#. Occurrence 3_1:2249:3109: scene=3_1
#: 3_1:2249
msgctxt "text_id=3109 | speaker=unknown"
msgid "　相手が何者であれ、人の命に、手をかけた。"
msgstr "  Regardless of who my opponent was, I just took someone's life."

#. Occurrence 3_1:2254:3110: scene=3_1
#: 3_1:2254
msgctxt "text_id=3110 | speaker=unknown"
msgid "　その、現実味もなければ手応えもなかった事実を、<渇|かわ>ききった喉で嚥下する。"
msgstr "  My throat parched, I swallowed the truth that without this sense of reality I would have been helpless."

#. Occurrence 3_1:2260:3111: scene=3_1
#: 3_1:2260
msgctxt "text_id=3111 | speaker=unknown"
msgid "硬くて苦くてこれっぽっちも飲み込めないけど、嚥下しようと努めていた。"
msgstr "So hard and bitter, impossible to swallow...but I tried to anyway."

#. Occurrence 3_1:2298:3112: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0005; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2298
msgctxt "text_id=3112 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 3_1:2304:3113: scene=3_1
#: 3_1:2304
msgctxt "text_id=3113 | speaker=unknown"
msgid "　私はいたって冷静だ。心拍数はレートを幾分オーバーしていて、呼吸も<千|ち><々|ぢ>に乱れているけど、頭はすっごく冷静の筈。"
msgstr "  I was unnervingly calm. My heart pounded and my breath felt heavy, but my mind was nonetheless calm."

#. Occurrence 3_1:2309:3114: scene=3_1
#: 3_1:2309
msgctxt "text_id=3114 | speaker=unknown"
msgid "　気が付けば消し炭はもう目の前。"
msgstr "  By the time I realized it, the charred remains were already in front of me."

#. Occurrence 3_1:2314:3115: scene=3_1
#: 3_1:2314
msgctxt "text_id=3115 | speaker=unknown"
msgid "　反撃を想定しつつ、ゆっくり死骸を確認する。"
msgstr "  Bracing for a counter-attack, I carefully examined the corpse."

#. Occurrence 3_1:2332:3116: scene=3_1
#: 3_1:2332
msgctxt "text_id=3116 | speaker=unknown"
msgid "　……よし、問題なし。公園の地面に倒れ臥したそれは、燃えつきて灰になっていた。"
msgstr "  Everything seemed fine. This body lying slumped to the ground, was nothing but ash."

#. Occurrence 3_1:2353:3117: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0006; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2353
msgctxt "text_id=3117 | speaker=aoko"
msgid "「………？」"
msgstr "\"...?\""

#. Occurrence 3_1:2359:3118: scene=3_1
#: 3_1:2359
msgctxt "text_id=3118 | speaker=unknown"
msgid "　けれど何かおかしい。"
msgstr "  But something wasn't right."

#. Occurrence 3_1:2364:3119: scene=3_1
#: 3_1:2364
msgctxt "text_id=3119 | speaker=unknown"
msgid "　一見した感想、残骸のあり方に生命の匂いがしない。"
msgstr "  To begin with, its remains didn't smell organic."

#. Occurrence 3_1:2369:3120: scene=3_1
#: 3_1:2369
msgctxt "text_id=3120 | speaker=unknown"
msgid "　まさか、と人影の顔を見る。"
msgstr "  Not willing to believe my hunch, I took a closer look at the corpse's face."

#. Occurrence 3_1:2374:3121: scene=3_1
#: 3_1:2374
msgctxt "text_id=3121 | speaker=unknown"
msgid "　そこには目も鼻もなく、マネキンのような白い面だけがあった。"
msgstr "  All that greeted me was the featureless white face of a mannequin."

#. Occurrence 3_1:2418:3122: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0007; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2418
msgctxt "text_id=3122 | speaker=aoko"
msgid "「ちくしょー、またやられた！」"
msgstr "\"Damn it, they got us again!\""

#. Occurrence 3_1:2425:3123: scene=3_1
#: 3_1:2425
msgctxt "text_id=3123 | speaker=unknown"
msgid "　叫んでマネキンを蹴っとばす。"
msgstr "  Screaming, I kicked the mannequin."

#. Occurrence 3_1:2430:3124: scene=3_1
#: 3_1:2430
msgctxt "text_id=3124 | speaker=unknown"
msgid "　灰は風に舞い、死体も風化していく。"
msgstr "  The corpse crumbled to ash and disappeared with the wind."

#. Occurrence 3_1:2436:3125: scene=3_1
#: 3_1:2436
msgctxt "text_id=3125 | speaker=unknown"
msgid "いや、死体というのは正しくないか。これはただの人形で、結局、おびき寄せたつもりが、またハズレを引かされた。"
msgstr "No, this was no corpse. This was just a puppet, and for all our efforts to lure the master out, we had once again been tricked by a familiar."

#. Occurrence 3_1:2441:3126: scene=3_1
#: 3_1:2441
msgctxt "text_id=3126 | speaker=unknown"
msgid "　……本当の意味での初陣は、また先送りになったということだ。"
msgstr "  My debut, my first test out in the open, would be postponed for another day."

#. Occurrence 3_1:2486:3127: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0008; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2486
msgctxt "text_id=3127 | speaker=aoko"
msgid "「はあ……"
msgstr "\"Argh..."

msgctxt "text_id=3128 | speaker=unknown"
msgid "いつになったら一人前にって……"
msgstr " Will I ever pass this test...?"

msgctxt "text_id=3129 | speaker=unknown"
msgid "あれ？」"
msgstr " ...What?\""

#. Occurrence 3_1:2510:3130: scene=3_1
#: 3_1:2510
msgctxt "text_id=3130 | speaker=unknown"
msgid "　その時、ふと視界を見慣れた物がかすめた。"
msgstr "  At that moment, I suddenly noticed something familiar in the corner of my eye."

#. Occurrence 3_1:2515:3131: scene=3_1
#: 3_1:2515
msgctxt "text_id=3131 | speaker=unknown"
msgid "　むこうの滑り台の影のカタチがおかしい。なんというか、余分なモノでぷくっと太っている気がする。"
msgstr "  Something seemed strange about the slide on the other end of the park. It appeared as though its shadow were larger than it should be."

#. Occurrence 3_1:2540:3132: scene=3_1
#: 3_1:2540
msgctxt "text_id=3132 | speaker=unknown"
msgid "　戦闘の余熱でのぼせていたのか。"
msgstr "  Was I still drunk on the high of battle?"

#. Occurrence 3_1:2545:3133: scene=3_1
#: 3_1:2545
msgctxt "text_id=3133 | speaker=unknown"
msgid "　私は、その“余分な影”が何であるか、思い出すのに一秒もかかってしまった。"
msgstr "  It took me a second to realize what it was."

#. Occurrence 3_1:2589:3134: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0009; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2589
msgctxt "text_id=3134 | speaker=aoko"
msgid "「―――誰ッ！？」"
msgstr "\"Who's there!?\""

#. Occurrence 3_1:2596:3135: scene=3_1
#: 3_1:2596
msgctxt "text_id=3135 | speaker=unknown"
msgid "　自分で言うのもなんだけど、失敗だった。"
msgstr "  Calling out was a mistake."

#. Occurrence 3_1:2602:3136: scene=3_1
#: 3_1:2602
msgctxt "text_id=3136 | speaker=unknown"
msgid "　その見慣れた高校の制服を着た誰かは私の声でビクっと後じさって、そのまま、"
msgstr "  Startled by my voice, the figure, wearing a familiar high school uniform, took a step back, and then..."

msgctxt "text_id=3137 | speaker=unknown"
msgid "ものすごい勢いで走り出した。"
msgstr " It broke into a sprint."

#. Occurrence 3_1:2612:3138: scene=3_1
#: 3_1:2612
msgctxt "text_id=3138 | speaker=unknown"
msgid "　まるで必死に逃げるみたい―――"
msgstr "  Like someone running for their life."

#. Occurrence 3_1:2634:3139: scene=3_1
#: 3_1:2634
msgctxt "text_id=3139 | speaker=unknown"
msgid "　―――って、実際逃げてるんだアレ！"
msgstr "  ...Or should I say, he was doing exactly that!"

#. Occurrence 3_1:2678:3140: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0010; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2678
msgctxt "text_id=3140 | speaker=aoko"
msgid "「追いかけて！　見られた！」"
msgstr "\"After him! We've been spotted!\""

#. Occurrence 3_1:2684:3141: scene=3_1
#: 3_1:2684
msgctxt "text_id=3141 | speaker=unknown"
msgid "　急いで相棒に言うけれど、彼女は第三者の存在に気付いてもいなかった。"
msgstr "  In a rush, I shouted to my partner, but she hadn't even noticed the third party's presence in the first place."

#. Occurrence 3_1:2689:3142: scene=3_1
#: 3_1:2689
msgctxt "text_id=3142 | speaker=unknown"
msgid "　かといって自分も動けない。情けない事に、今の戦闘でまだ足がすくんでやがる……！"
msgstr "  Though, it wasn't as if I could move by myself. Embarrassingly, the fight had taken more out of me than I'd have liked...!"

#. Occurrence 3_1:2751:3143: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0011; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2751
msgctxt "text_id=3143 | speaker=aoko"
msgid "「だめ、逃げられる！"
msgstr "\"No, he'll get away!"

#. Occurrence 3_1:2757:3144: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0012; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2757
msgctxt "text_id=3144 | speaker=aoko"
msgid "　捕まえて始末しないと……！」"
msgstr "  We need to catch and eliminate him!\""

#. Occurrence 3_1:2763:3145: scene=3_1
#: 3_1:2763
msgctxt "text_id=3145 | speaker=unknown"
msgid "　上品に振る舞う余裕なんてない。"
msgstr "  There was no time for niceties."

#. Occurrence 3_1:2768:3146: scene=3_1
#: 3_1:2768
msgctxt "text_id=3146 | speaker=unknown"
msgid "　この現場を誰かに見られる事は、私たちにとって生死に関わる問題なんだから―――！"
msgstr "  For us, being seen here was a matter of life and death!"

#. Occurrence 3_1:2827:3147: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0013; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2827
msgctxt "text_id=3147 | speaker=aoko"
msgid "「待て、この……！」"
msgstr "\"Wait, get back here you...!\""

#. Occurrence 3_1:2833:3148: scene=3_1
#: 3_1:2833
msgctxt "text_id=3148 | speaker=unknown"
msgid "　足の<痺|しび>れを振り払って公園の外に出る。"
msgstr "  Shaking off the numbness in my legs, I made for the park's exit."

#. Occurrence 3_1:2861:3149: scene=3_1
#: 3_1:2861
msgctxt "text_id=3149 | speaker=unknown"
msgid "　……なんて見事な逃げ足だろう。"
msgstr "  I had to admire his escape."

#. Occurrence 3_1:2866:3150: scene=3_1
#: 3_1:2866
msgctxt "text_id=3150 | speaker=unknown"
msgid "　一部始終を目撃していた何者かは、跡形もなく住宅地の闇に消えていた。"
msgstr "  The witness, party to the entire night's proceedings, had disappeared into the darkness of the residential district without a trace."

#. Occurrence 3_1:2887:3151: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0014; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:2887
msgctxt "text_id=3151 | speaker=aoko"
msgid "「ああもう、結界にあいつの感触なんてなかったのに……！」"
msgstr "\"Why the hell didn't I sense him in the field!?\""

#. Occurrence 3_1:2893:3152: scene=3_1
#: 3_1:2893
msgctxt "text_id=3152 | speaker=unknown"
msgid "　などと、文句を言ってみても学生服の人影が戻ってくる筈もない。"
msgstr "  Complaining to myself wouldn't bring back the figure in uniform."

#. Occurrence 3_1:2898:3153: scene=3_1
#: 3_1:2898
msgctxt "text_id=3153 | speaker=unknown"
msgid "　自分の情けなさを恨めしく思いながら、私は追跡を諦めた。"
msgstr "  Bitter at my own incompetence, I gave up the chase."

#. Occurrence 3_1:2951:3154: scene=3_1
#: 3_1:2951
msgctxt "text_id=3154 | speaker=unknown"
msgid "　一時的にしろ、公園は有珠の“森”になっている。"
msgstr "  Though temporary, the park had become Alice's \"woods.\""

#. Occurrence 3_1:2956:3155: scene=3_1
#: 3_1:2956
msgctxt "text_id=3155 | speaker=unknown"
msgid "　ここでは一メートル以内にいようと人物像の特定、声の確認はあやふやになる。なにしろ童話の中の出来事だ。"
msgstr "  For anyone within a few feet of the park, other park-goers' identifiable features and voices became murky, like the stuff of fairy tales."

#. Occurrence 3_1:2961:3156: scene=3_1
#: 3_1:2961
msgctxt "text_id=3156 | speaker=unknown"
msgid "　一連の出来事は見られたが、私や彼女の顔や素性は知られていない―――なら、他に打つ手はある。"
msgstr "  Tonight's proceedings may have had a witness, but if our identities were still hidden... Then this was still a chance."

#. Occurrence 3_1:3027:3157: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0015; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:3027
msgctxt "text_id=3157 | speaker=aoko"
msgid "「あの背中、男だった」"
msgstr "\"That looked like a male from behind.\""

#. Occurrence 3_1:3033:3158: scene=3_1
#: 3_1:3033
msgctxt "text_id=3158 | speaker=unknown"
msgid "　公園に戻る。"
msgstr "  I returned to the park."

#. Occurrence 3_1:3038:3159: scene=3_1
#: 3_1:3038
msgctxt "text_id=3159 | speaker=unknown"
msgid "　見慣れていて当然で、アレは間違いなくうちの高校の制服だ。"
msgstr "  That uniform was, without a doubt, from my high school."

#. Occurrence 3_1:3043:3160: scene=3_1
#: 3_1:3043
msgctxt "text_id=3160 | speaker=unknown"
msgid "　手がかりとしてはそれで十分。うちの生徒なら洗いだす手段はいくらでもある。"
msgstr "  That was clue enough. If he was a schoolmate of mine, I had plenty of methods to flush him out."

#. Occurrence 3_1:3064:3161: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_3_1_0016; voice_prefix=A10; voice_category=1; scene=3_1
#: 3_1:3064
msgctxt "text_id=3161 | speaker=aoko"
msgid "「……にしても。どうしてこう問題ばっかり増えていくんだろう」"
msgstr "\"...It's one thing after another.\""

#. Occurrence 3_1:3070:3162: scene=3_1
#: 3_1:3070
msgctxt "text_id=3162 | speaker=unknown"
msgid "　などと愚痴りつつも、解決の優先順位ははっきりしていた。"
msgstr "  Amidst my grumbling, I set my priorities straight."

#. Occurrence 3_1:3075:3163: scene=3_1
#: 3_1:3075
msgctxt "text_id=3163 | speaker=unknown"
msgid "　変な噂をばらまかれるより早く、さっきの目撃者の口を封じなくてはいけない。"
msgstr "  Before some strange rumors spread, I needed to seal the witness's mouth shut."

#. Occurrence 3_1:3080:3164: scene=3_1
#: 3_1:3080
msgctxt "text_id=3164 | speaker=unknown"
msgid "　それも最優先で、迅速に、容赦なく。"
msgstr "  That was the highest priority. Quickly and without mercy."

#. Occurrence 3_1:3126:3165: scene=3_1
#: 3_1:3126
msgctxt "text_id=3165 | speaker=unknown"
msgid "　顔を上げると、離れていた有珠の姿が見えた。"
msgstr "  Looking up, I saw Alice's previously distant figure."

#. Occurrence 3_1:3131:3166: scene=3_1
#: 3_1:3131
msgctxt "text_id=3166 | speaker=unknown"
msgid "　魔術師としてのあり方を目撃され、ピンチなのは彼女も同じなのに、"
msgstr "  Though she was in as much trouble as I was with her existence as a mage also exposed, she had but one thing to say."

#. Occurrence 3_1:3162:3167: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_3_1_0002; voice_prefix=A40; voice_category=2; scene=3_1
#: 3_1:3162
msgctxt "text_id=3167 | speaker=alice"
msgid "「……これは、困った事になったわね」"
msgstr "\"...This means trouble.\""

#. Occurrence 3_1:3168:3168: scene=3_1
#: 3_1:3168
msgctxt "text_id=3168 | speaker=unknown"
msgid "　人影の走り去った闇を見つめる姿は、冷静というより彫像か何かのように無反応。"
msgstr "  Her statue-like figure, staring into the darkness, seemed more expressionless than calm."

#. Occurrence 3_1:3174:3169: scene=3_1
#: 3_1:3174
msgctxt "text_id=3169 | speaker=unknown"
msgid "　……本当、うんざりする。"
msgstr "  ...I was pissed off."

#. Occurrence 3_1:3174:3170: scene=3_1
#: 3_1:3174
msgctxt "text_id=3170 | speaker=unknown"
msgid "　抑揚のないその声は、月の無い晩に、憎らしいほど似合っていた。"
msgstr "  Her inscrutable voice resembled the moonless night so much it made me angry."

#. Occurrence 4_1:44:3171: scene=4_1
#: 4_1:44
msgctxt "text_id=3171 | speaker=unknown"
msgid "　唐突に言うと、私は魔法使いである。"
msgstr "  There really isn't any other way of saying this. I am a magician."

#. Occurrence 4_1:73:3172: scene=4_1
#: 4_1:73
msgctxt "text_id=3172 | speaker=unknown"
msgid "　なんていうか、指先ひとつで奇跡を起こして、<辺鄙|へんぴ>な森に隠れ住んでいる童話のあれだ。"
msgstr "  Kind of like those witches in fairy tales who live alone in the woods and perform miracles with the wave of a finger."

#. Occurrence 4_1:78:3173: scene=4_1
#: 4_1:78
msgctxt "text_id=3173 | speaker=unknown"
msgid "　イメージはちょっと違うけど、わりと的を射ているので採用したいと思う。"
msgstr "  While the popular depiction of it differs from reality, it's closer to the truth than you know."

#. Occurrence 4_1:100:3174: scene=4_1
#: 4_1:100
msgctxt "text_id=3174 | speaker=unknown"
msgid "　ただ断っておくと、ホウキに乗って空は飛ばない。"
msgstr "  Though just so we're clear, no, I don't fly through the sky on a broom."

#. Occurrence 4_1:105:3175: scene=4_1
#: 4_1:105
msgctxt "text_id=3175 | speaker=unknown"
msgid "　動物に変身したり小鳥と話したりもできない。"
msgstr "  I cannot transform into animals or speak with small birds."

#. Occurrence 4_1:110:3176: scene=4_1
#: 4_1:110
msgctxt "text_id=3176 | speaker=unknown"
msgid "　夢があるようでないのが今風の魔術師なのである。"
msgstr "  Modern mages are nothing so fanciful."

#. Occurrence 4_1:164:3177: scene=4_1
#: 4_1:164
msgctxt "text_id=3177 | speaker=unknown"
msgid "　非常識だけど現実的。"
msgstr "  Our existence sounds unbelievable, but we're quite grounded. "

#. Occurrence 4_1:169:3178: scene=4_1
#: 4_1:169
msgctxt "text_id=3178 | speaker=unknown"
msgid "　万能なようでわりと<窮屈|きゅうくつ>。"
msgstr "  Though it may seem like we can do anything, we're actually majorly constrained."

#. Occurrence 4_1:174:3179: scene=4_1
#: 4_1:174
msgctxt "text_id=3179 | speaker=unknown"
msgid "　胸を張るには色々半端なものだけど、私の本当の職業は学生じゃなくて、そんな<浪漫|ロマン>あふれるものだった。"
msgstr "  And while I still have a lot to learn about it, this is my real job. Sounds a lot more romantic than being a high school student, right?"

#. Occurrence 4_1:194:3180: scene=4_1
#: 4_1:194
msgctxt "text_id=3180 | speaker=unknown"
msgid "　けど、その事はもちろん秘密。"
msgstr "  Naturally, this is a secret I don't just share with anyone."

#. Occurrence 4_1:200:3181: scene=4_1
#: 4_1:200
msgctxt "text_id=3181 | speaker=unknown"
msgid "“魔術師はこれ、その<御業|みわざ>をすべて<隠匿|いんとく>すべし”"
msgstr "\"A mage must do everything in their power to conceal their work.\""

#. Occurrence 4_1:206:3182: scene=4_1
#: 4_1:206
msgctxt "text_id=3182 | speaker=unknown"
msgid "　協会の十箇条のトップに出ている事だし、私だってこんなワケわかんない<話|こと>を口外する気はさらさらない。"
msgstr "  That is the first and most important of the Association's ten laws, not that I'm tempted to let the cat out the bag in the least."

#. Occurrence 4_1:253:3183: scene=4_1
#: 4_1:253
msgctxt "text_id=3183 | speaker=unknown"
msgid "　これでも外じゃ優等生で通っているし、だいたい、知らしめたところで私が嬉しい事なんてまったくない。"
msgstr "  My secret identity as an honor student is intact, and absolutely no good would come of me revealing my true nature."

#. Occurrence 4_1:258:3184: scene=4_1
#: 4_1:258
msgctxt "text_id=3184 | speaker=unknown"
msgid "　どっちかというと頭の痛いことばかりだ。"
msgstr "  If anything, it'd only lead to more headaches."

#. Occurrence 4_1:263:3185: scene=4_1
#: 4_1:263
msgctxt "text_id=3185 | speaker=unknown"
msgid "　なので、そんなつまんない事は極力、自重するにかぎる。"
msgstr "  That's why I do everything in my power to keep it a secret."

#. Occurrence 4_1:298:3186: scene=4_1
#: 4_1:298
msgctxt "text_id=3186 | speaker=unknown"
msgid "　もっとも、それはまだ私が立派な魔法使いになれていないからだ。"
msgstr "  Of course, if I'd accomplished anything as a magician by now, then maybe I'd see it differently."

#. Occurrence 4_1:303:3187: scene=4_1
#: 4_1:303
msgctxt "text_id=3187 | speaker=unknown"
msgid "　生涯の秘密というのは、私自身が立派になって一人前になった時、たったひとりにだけ打ち明けられれば、それで幸せだと思う。"
msgstr "  I've fantasized about revealing my secret life's work to a single, special person, when I finally make something of myself."

#. Occurrence 4_1:323:3188: scene=4_1
#: 4_1:323
msgctxt "text_id=3188 | speaker=unknown"
msgid "　うん。いちばん大きな秘密の告白が『実は魔法使いでした』なんていうのは、たいへん洒落ている。"
msgstr "  Yeah... it'd be pretty stellar to just confess one day, \"By the way, I'm a magician.\""

#. Occurrence 4_1:329:3189: scene=4_1
#: 4_1:329
msgctxt "text_id=3189 | speaker=unknown"
msgid "　そのシーンを想像すると妙におかしくて、協会の規則なんかより晩年のために秘密を守りたくなるぐらい。"
msgstr "  That idea alone is enough to keep me from spoiling the big reveal, regardless of the Association's rules."

#. Occurrence 4_1:374:3190: scene=4_1
#: 4_1:374
msgctxt "text_id=3190 | speaker=unknown"
msgid "　以上の事を祖父に話すと、彼は私の頭を撫でてくれた。"
msgstr "  My grandfather patted me on the head when I shared these thoughts with him."

#. Occurrence 4_1:380:3191: scene=4_1
#: 4_1:380
msgctxt "text_id=3191 | speaker=unknown"
msgid "　誉めてくれたのか<窘|たしな>めていたのかは分からないけど、あの人にしては優しい感触だったと思う。"
msgstr "  I don't know if that was praise or what, but I remember that his touch was gentle."

#. Occurrence 4_1:411:3192: scene=4_1
#: 4_1:411
msgctxt "text_id=3192 | speaker=unknown"
msgid "　私が魔術―――祖父の後を継ぐ事になったのは、中学を卒業したその日だった。"
msgstr "  I first learned that I would be succeeding my grandfather on the day I graduated middle school."

#. Occurrence 4_1:416:3193: scene=4_1
#: 4_1:416
msgctxt "text_id=3193 | speaker=unknown"
msgid "　家に帰るなり祖父は"
msgstr "  When I returned home, there he was."

#. Occurrence 4_1:422:3194: scene=4_1
#: 4_1:422
msgctxt "text_id=3194 | speaker=unknown"
msgid "『姉は旅に出た。今日からおまえが蒼崎の後継ぎだ』"
msgstr "\"Your elder sister left on a journey. From this day forth, you are the heir to the Aozaki.\""

#. Occurrence 4_1:428:3195: scene=4_1
#: 4_1:428
msgctxt "text_id=3195 | speaker=unknown"
msgid "　なんて事を淡々と語ったのだ。"
msgstr "  He said it in such a matter-of-fact way."

#. Occurrence 4_1:460:3196: scene=4_1
#: 4_1:460
msgctxt "text_id=3196 | speaker=unknown"
msgid "　蒼崎の家が魔術なんて古くさいものを伝えていた事は知っていたけど、正直、自分にそのおはちが回ってくるとは思ってもいなかった。"
msgstr "  I knew that the Aozaki family passed down this old tradition of magecraft, but to be honest, I never imagined I would be the one to wield it."

#. Occurrence 4_1:493:3197: scene=4_1
#: 4_1:493
msgctxt "text_id=3197 | speaker=unknown"
msgid "　魔術の継承は<一子相伝|いっしそうでん>とかなんとか。"
msgstr "  Magecraft is supposed to be passed down to a single child."

#. Occurrence 4_1:499:3198: scene=4_1
#: 4_1:499
msgctxt "text_id=3198 | speaker=unknown"
msgid "　色々と決まり事の多そうな魔法使いの座とやらは姉貴の役割で、私はそういうトンデモとは無関係。いたってノーマルな生活設計、将来希望だったのだ。"
msgstr "  It was my sister's role to take the mantle, and I had no interest in dedicating myself to so many rules and routines. I planned to live a normal life; I had hopes and dreams for the future."

#. Occurrence 4_1:519:3199: scene=4_1
#: 4_1:519
msgctxt "text_id=3199 | speaker=unknown"
msgid "　なので、姉貴には悪いけど自由気ままに人生を送らせてもらいましょう―――"
msgstr "  I felt bad for my sister, but I was determined to live my life my way."

#. Occurrence 4_1:524:3200: scene=4_1
#: 4_1:524
msgctxt "text_id=3200 | speaker=unknown"
msgid "　なんて気楽にやってきたところで、とんでもないカウンターが待っていたワケである。"
msgstr "  And while I managed to do just that for a time, I was blindsided by a vicious counterpunch."

#. Occurrence 4_1:557:3201: scene=4_1
#: 4_1:557
msgctxt "text_id=3201 | speaker=unknown"
msgid "　以来、私は今まで横目で見ていただけの世界に身を置くことになった。"
msgstr "  Since then, I've been thrust headlong into a world I had only observed from afar."

#. Occurrence 4_1:562:3202: scene=4_1
#: 4_1:562
msgctxt "text_id=3202 | speaker=unknown"
msgid "　まさかまさかの高校デビュー。"
msgstr "  It was a hell of a way to start high school."

#. Occurrence 4_1:568:3203: scene=4_1
#: 4_1:568
msgctxt "text_id=3203 | speaker=unknown"
msgid "　まあ、新生活のスタートとしては悪くない。"
msgstr "  But I suppose it wasn't all that bad, all things considered."

#. Occurrence 4_1:604:3204: scene=4_1
#: 4_1:604
msgctxt "text_id=3204 | speaker=unknown"
msgid "　……それから色々あって現在。"
msgstr "  ...A lot has happened since then."

#. Occurrence 4_1:609:3205: scene=4_1
#: 4_1:609
msgctxt "text_id=3205 | speaker=unknown"
msgid "　この役柄には戸惑ったけど、それも気が付けばもう二年目に届こうとしている。"
msgstr "  I was so dazed by this newfound life that a year of school motored right by. I was a second-year before I knew it."

#. Occurrence 4_1:641:3206: scene=4_1
#: 4_1:641
msgctxt "text_id=3206 | speaker=unknown"
msgid "　その間にトラブルらしき物は一切なかったし……私たちの名誉のため、半年に<亘|わた>る同居人との殺し合いはカウントしない……"
msgstr "  Thankfully, nothing drastic has happened... the six months my roommate and I totally tried to kill each other nonwithstanding."

#. Occurrence 4_1:647:3207: scene=4_1
#: 4_1:647
msgctxt "text_id=3207 | speaker=unknown"
msgid "魔法使いとしての才能もそれなりに優れているみたいで、まだ壁にはぶつかってはいない。"
msgstr "As it happens, I've got a natural talent at this magic stuff, so I've yet to have any hang-ups there, either."

#. Occurrence 4_1:691:3208: scene=4_1
#: 4_1:691
msgctxt "text_id=3208 | speaker=unknown"
msgid "　人間なんだから頭の痛い悩みは二つや三つあるけれど、今のところ将来に不安を感じる事はまったくなかった。"
msgstr "  I'm only human, so I've had my fair share of headaches for sure, but never once did I worry about my future."

#. Occurrence 4_1:696:3209: scene=4_1
#: 4_1:696
msgctxt "text_id=3209 | speaker=unknown"
msgid "　私の生活は、このまま<順風満帆|じゅんぷうまんぱん>に行くと思っていたのだ。"
msgstr "  I thought my life would be smooth sailing all the way."

#. Occurrence 4_1:713:3210: scene=4_1
#: 4_1:713
msgctxt "text_id=3210 | speaker=unknown"
msgid "　昨夜の、例の一件さえ起こらなければ。"
msgstr "  If only everything had gone to plan last night."

#. Occurrence 4_1:748:3211: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0000; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:748
msgctxt "text_id=3211 | speaker=alice"
msgid "「どう？」"
msgstr "\"Well?\""

#. Occurrence 4_1:770:3212: scene=4_1
#: 4_1:770
msgctxt "text_id=3212 | speaker=unknown"
msgid "　久遠寺邸に帰宅するなり、蒼崎青子は久遠寺有珠にそう<訊|たず>ねられた。"
msgstr "  Alice Kuonji asked Aoko Aozaki the second she entered the house."

#. Occurrence 4_1:775:3213: scene=4_1
#: 4_1:775
msgctxt "text_id=3213 | speaker=unknown"
msgid "　切迫感も危機感もない声だが、<玻|は><璃|り>のような<黒瞳|こくどう>が事の重要性を告げている。"
msgstr "  Her dark eyes succeeded where her voice failed to communicate the gravity of the situation."

#. Occurrence 4_1:826:3214: scene=4_1
#: 4_1:826
msgctxt "text_id=3214 | speaker=unknown"
msgid "　色気のないコートを脱いでハンガーにかけ、青子はソファーに腰を下ろした。"
msgstr "  Aoko took off her unflattering coat, hung it on the hanger, and sat down on the sofa."

#. Occurrence 4_1:831:3215: scene=4_1
#: 4_1:831
msgctxt "text_id=3215 | speaker=unknown"
msgid "　正面にはテーブルを挟んで有珠が座っている。"
msgstr "  Alice sat across from her, with a table separating them."

#. Occurrence 4_1:865:3216: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0000; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:865
msgctxt "text_id=3216 | speaker=aoko"
msgid "「そっちは？」"
msgstr "\"Any progress with those things?\""

#. Occurrence 4_1:885:3217: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0001; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:885
msgctxt "text_id=3217 | speaker=alice"
msgid "「良くないわね。<偵察|ていさつ>に行けるのは七個ぐらい。ここのところ使ってばかりで、作り置きをする余裕もなかったし」"
msgstr "\"Not at all. I've only got seven left that are any good for reconnaissance. I've been using them up fast and haven't had time to make more.\""

#. Occurrence 4_1:891:3218: scene=4_1
#: 4_1:891
msgctxt "text_id=3218 | speaker=unknown"
msgid "　青子から視線を逸らすと、有珠はテーブルの上に置かれた箱に視線を戻す。"
msgstr "  Alice's gaze drifted from Aoko to the box on the table."

#. Occurrence 4_1:937:3219: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0001; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:937
msgctxt "text_id=3219 | speaker=aoko"
msgid "「あの夜、街を監視していたヤツはいないの？"
msgstr "\"Were none of them keeping watch that night?"

#. Occurrence 4_1:937:3220: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0001; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:937
msgctxt "text_id=3220 | speaker=aoko"
msgid "　街の偵察は完璧なんでしょ、そいつら」"
msgstr "  They've never let you down when it comes to this sort of thing, have they?\""

#. Occurrence 4_1:953:3221: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0002; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:953
msgctxt "text_id=3221 | speaker=alice"
msgid "「それは昼間の話よ。夜間飛行は危険が多いわ」"
msgstr "\"During the day, no. But there is quite the risk when flying them at night.\""

#. Occurrence 4_1:990:3222: scene=4_1
#: 4_1:990
msgctxt "text_id=3222 | speaker=unknown"
msgid "　肝心なところで役に立たないのね、とため息をつく青子。"
msgstr "  Meaning they were of the least use when needed the most. Aoko sighed."

#. Occurrence 4_1:1017:3223: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0003; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:1017
msgctxt "text_id=3223 | speaker=alice"
msgid "「……そういう貴女は？　朝はずいぶんと強気だったけど？」"
msgstr "\"...Well, how are you faring? You seemed pretty confident this morning.\""

#. Occurrence 4_1:1046:3224: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0002; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1046
msgctxt "text_id=3224 | speaker=aoko"
msgid "「ん？　"
msgstr "\"Hm?"

msgctxt "text_id=3225 | speaker=unknown"
msgid "あ、こっちは予定通りよ。"
msgstr " Yeah, I guess everything's good on my end."

#. Occurrence 4_1:1059:3226: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0003; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1059
msgctxt "text_id=3226 | speaker=aoko"
msgid "　明日までにはしぼりこめると思う。今朝、鳶丸にうちの生徒の自宅と行動時間を調べさせたから。"
msgstr "  I'm pretty sure I'll know by tomorrow. I told Tobimaru to look into all of the students' addresses and schedules."

#. Occurrence 4_1:1065:3227: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0004; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1065
msgctxt "text_id=3227 | speaker=aoko"
msgid "　あの時間に公園をうろつく奴は滅多にいないし、簡単に割り出せる」"
msgstr "  Not many people wander the park that time of night, so it should be easy enough to figure out who it was.\""

#. Occurrence 4_1:1098:3228: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0004; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:1098
msgctxt "text_id=3228 | speaker=alice"
msgid "「そう簡単にいくの？」"
msgstr "\"How can you be so sure?\""

#. Occurrence 4_1:1104:3229: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0005; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1104
msgctxt "text_id=3229 | speaker=aoko"
msgid "「いくわよ。<伊|ダ><達|テ>に生徒会に勤めてないわ。その程度のデータは揃えてある。"
msgstr "\"Because. I didn't just join the student council to keep up appearances. I've been using my position to keep tabs on everyone."

#. Occurrence 4_1:1111:3230: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0006; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1111
msgctxt "text_id=3230 | speaker=aoko"
msgid "月一のバイト先はおろか親しい友人宅との移動時間、その優先順位まで調べ上げてるんだから。"
msgstr "I have info on everything from part-time jobs, to friends' addresses, to what they're up to in their spare time."

#. Occurrence 4_1:1117:3231: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0007; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1117
msgctxt "text_id=3231 | speaker=aoko"
msgid "　<他|ひ><人|と>には見せたくなかったリストだけど、そんな余裕ないでしょ？　だから、そういうのが向いてる副会長にやらせたの」"
msgstr "  It's a list I was hoping to keep secret, but we can't afford to do that now, can we? That's why I keep the vice president around. It's the kind of thing he does best.\""

#. Occurrence 4_1:1155:3232: scene=4_1
#: 4_1:1155
msgctxt "text_id=3232 | speaker=unknown"
msgid "　余談ではあるが、その機密ファイルが作成されたのは青子が生徒会長になってからである。"
msgstr "  Incidentally, the creation of this secret file started the moment Aoko became student council president."

#. Occurrence 4_1:1160:3233: scene=4_1
#: 4_1:1160
msgctxt "text_id=3233 | speaker=unknown"
msgid "　その存在だけが噂され、彼女が全校生徒に恐れられる一因になっている、いわく付きの一品だ。"
msgstr "  The mere rumor of its existence was enough to strike fear into the entire student body."

#. Occurrence 4_1:1199:3234: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0005; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:1199
msgctxt "text_id=3234 | speaker=alice"
msgid "「……そう。徹底しているわね、あい変わらず」"
msgstr "\"...As thorough as always, I see.\""

#. Occurrence 4_1:1205:3235: scene=4_1
#: 4_1:1205
msgctxt "text_id=3235 | speaker=unknown"
msgid "　やや呆れ気味に漏らす有珠。"
msgstr "  Alice was only mildly surprised."

#. Occurrence 4_1:1210:3236: scene=4_1
#: 4_1:1210
msgctxt "text_id=3236 | speaker=unknown"
msgid "　同居をはじめて二年近く。"
msgstr "  It had been almost two years since they first started living together."

#. Occurrence 4_1:1215:3237: scene=4_1
#: 4_1:1215
msgctxt "text_id=3237 | speaker=unknown"
msgid "　一度やると決めればとことんまで突っ走るのが蒼崎青子だと、有珠も十分身にしみている。"
msgstr "  She knew as well as anyone that when Aoko put her mind to something, she saw it through to the end."

#. Occurrence 4_1:1258:3238: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0008; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1258
msgctxt "text_id=3238 | speaker=aoko"
msgid "「ま、私もアレがこんな風に役立つとは思ってもみなかったけど。ほんと、備えあれば憂いなしとはこの事ね」"
msgstr "\"Well, I never imagined I'd have to use it like this. But it's better to be safe than sorry.\""

#. Occurrence 4_1:1264:3239: scene=4_1
#: 4_1:1264
msgctxt "text_id=3239 | speaker=unknown"
msgid "　とはいえ昨夜の出来事は異例中の異例だ。"
msgstr "  But what happened last night was far beyond a mere exception to the rule."

#. Occurrence 4_1:1269:3240: scene=4_1
#: 4_1:1269
msgctxt "text_id=3240 | speaker=unknown"
msgid "　この状況は、本来起こりえるものではない。"
msgstr "  This predicament should not have even been possible."

#. Occurrence 4_1:1308:3241: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_9000; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1308
msgctxt "text_id=3241 | speaker=aoko"
msgid "「それより原因は分かったの？　結界の<結|むす>びに不手際があったなんてのは聞かないわよ」"
msgstr "\"More importantly, have you figured out what went wrong? And don't tell me it had anything to do with your link to the Bounded Field.\""

#. Occurrence 4_1:1314:3242: scene=4_1
#: 4_1:1314
msgctxt "text_id=3242 | speaker=unknown"
msgid "　凛とした視線を一際強くする青子。"
msgstr "  Aoko glared at her."

#. Occurrence 4_1:1319:3243: scene=4_1
#: 4_1:1319
msgctxt "text_id=3243 | speaker=unknown"
msgid "　結界の仕上げは有珠の役割だ。"
msgstr "  The ward was Alice's responsibility."

#. Occurrence 4_1:1324:3244: scene=4_1
#: 4_1:1324
msgctxt "text_id=3244 | speaker=unknown"
msgid "　昨夜のトラブルの原因が結界にあるのなら、責任の所在は明らかにしなくてはならない。"
msgstr "  If it was to blame for last night's trouble, Alice had to own up to her fair share."

#. Occurrence 4_1:1361:3245: scene=4_1
#: 4_1:1361
msgctxt "text_id=3245 | speaker=unknown"
msgid "　同居人であり相棒である青子と有珠だが、それはあくまで利害が一致しているからである。"
msgstr "  Alice and Aoko may have been roommates and partners, but it was a relationship of convenience."

#. Occurrence 4_1:1366:3246: scene=4_1
#: 4_1:1366
msgctxt "text_id=3246 | speaker=unknown"
msgid "　ふたりの関係は、それが家柄によるものだとしても、味方というより敵に近い。"
msgstr "  While lineage had brought them together, they were more like enemies than allies."

#. Occurrence 4_1:1371:3247: scene=4_1
#: 4_1:1371
msgctxt "text_id=3247 | speaker=unknown"
msgid "　最終的な話、蒼崎青子と久遠寺有珠は<相容|あいい>れない。"
msgstr "  Ultimately, they were just not a match."

#. Occurrence 4_1:1407:3248: scene=4_1
#: 4_1:1407
msgctxt "text_id=3248 | speaker=unknown"
msgid "　失点があれば叩く。"
msgstr "  Where there was a blunder, it was punished."

#. Occurrence 4_1:1426:3249: scene=4_1
#: 4_1:1426
msgctxt "text_id=3249 | speaker=unknown"
msgid "　隙があれば攻撃する。"
msgstr "  Where there was an opening, it would be attacked."

#. Occurrence 4_1:1453:3250: scene=4_1
#: 4_1:1453
msgctxt "text_id=3250 | speaker=unknown"
msgid "　―――機会さえ。"
msgstr "  If there was even an opportunity..."

#. Occurrence 4_1:1458:3251: scene=4_1
#: 4_1:1458
msgctxt "text_id=3251 | speaker=unknown"
msgid "　互いが信条的に納得のいく機会が訪れるのなら、当然のように殺し合う関係だ。"
msgstr "  The two of them would kill each other in the event of such a moment."

#. Occurrence 4_1:1514:3252: scene=4_1
#: 4_1:1514
msgctxt "text_id=3252 | speaker=unknown"
msgid "　そんな青子の視線を、有珠は正面から受けとめる。"
msgstr "  Alice locked eyes with Aoko."

#. Occurrence 4_1:1542:3253: scene=4_1
#: 4_1:1542
msgctxt "text_id=3253 | speaker=unknown"
msgid "　大の男でもたじろぐ視線を前にして、有珠の<表情|かお>は微塵も変わらない。"
msgstr "  Aoko's fierce gaze could make a grown man cower in fear, but Alice did not bat an eyelash."

#. Occurrence 4_1:1569:3254: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0007; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:1569
msgctxt "text_id=3254 | speaker=alice"
msgid "「……仮の話だけど。あの結界に落ち度があったのなら、今まで何度もこういう状況になっていたでしょうね」"
msgstr "\"...Assuming the Bounded Field was the problem, wouldn't this have happened countless times before?\""

#. Occurrence 4_1:1591:3255: scene=4_1
#: 4_1:1591
msgctxt "text_id=3255 | speaker=unknown"
msgid "　でしょうね、と青子は頷いた。立場上問いつめただけで、青子は有珠を信頼している。"
msgstr "  \"I suppose you're right,\" Aoko agreed, as the question reaffirmed her trust in Alice."

#. Occurrence 4_1:1626:3256: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0009; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1626
msgctxt "text_id=3256 | speaker=aoko"
msgid "「結界の在り方は完璧だったのね？」"
msgstr "\"So you're saying there was nothing wrong with it?\""

#. Occurrence 4_1:1650:3257: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0008; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:1650
msgctxt "text_id=3257 | speaker=alice"
msgid "「絶対とまでは、断言はできないけど」"
msgstr "\"I honestly can't say for sure.\""

#. Occurrence 4_1:1656:3258: scene=4_1
#: 4_1:1656
msgctxt "text_id=3258 | speaker=unknown"
msgid "　やはり抑揚のない声で答える有珠。"
msgstr "  Alice answered as flatly as ever."

#. Occurrence 4_1:1718:3259: scene=4_1
#: 4_1:1718
msgctxt "text_id=3259 | speaker=unknown"
msgid "　結界とは、一つの閉じられた世界を意味する。"
msgstr "  A Bounded Field is like a sanctuary sealed away from the real world."

#. Occurrence 4_1:1723:3260: scene=4_1
#: 4_1:1723
msgctxt "text_id=3260 | speaker=unknown"
msgid "　閉じたい場所を、どのような手段であれ外界から<遮断|しゃだん>した状況を結界と呼ぶ。"
msgstr "  Steps are taken whereby a certain area is cut off from the outside world."

#. Occurrence 4_1:1728:3261: scene=4_1
#: 4_1:1728
msgctxt "text_id=3261 | speaker=unknown"
msgid "　結界には様々な種類があり、"
msgstr "  There are various kinds of Bounded Fields."

#. Occurrence 4_1:1733:3262: scene=4_1
#: 4_1:1733
msgctxt "text_id=3262 | speaker=unknown"
msgid "　実際にその区間を壁で隔離する物理的なものもあれば、"
msgstr "  There are physical ones that close off an area behind a wall,"

#. Occurrence 4_1:1738:3263: scene=4_1
#: 4_1:1738
msgctxt "text_id=3263 | speaker=unknown"
msgid "　区間内の様子を鏡や霧、森の囲み等で隠してしまう視覚的なものもある。"
msgstr "  and less tangible ones that use mirrors, mist, or trees to conceal that which occurs within."

#. Occurrence 4_1:1759:3264: scene=4_1
#: 4_1:1759
msgctxt "text_id=3264 | speaker=unknown"
msgid "　ただし、それらの結界は『内部』を閉じるために『外部』に異常性を報せてしまっている。"
msgstr "  However, when closing off an area to the outside world, you cannot avoid communicating the abnormality's existence."

#. Occurrence 4_1:1764:3265: scene=4_1
#: 4_1:1764
msgctxt "text_id=3265 | speaker=unknown"
msgid "　立ち入り禁止にはできても、その区間が立ち入り禁止となっている事実を隠蔽できない。"
msgstr "  In other words, the area may be closed off to the outside world, but it is impossible to hide the fact that it is closed off."

#. Occurrence 4_1:1769:3266: scene=4_1
#: 4_1:1769
msgctxt "text_id=3266 | speaker=unknown"
msgid "　いずれ、中の様子が見えずとも“立ち入り禁止”区域そのものに興味を持つ者がでてくるだろう。"
msgstr "  In time, someone will take interest in a sealed-off area even if they cannot see what is going on inside."

#. Occurrence 4_1:1804:3267: scene=4_1
#: 4_1:1804
msgctxt "text_id=3267 | speaker=unknown"
msgid "　それでは本末転倒だ。"
msgstr "  Some might say this is putting the cart before the horse."

#. Occurrence 4_1:1809:3268: scene=4_1
#: 4_1:1809
msgctxt "text_id=3268 | speaker=unknown"
msgid "　真に優れた結界とは、外界に何ら異変を感じさせず、同時に、外から干渉されない<隔|へだ>たりでなくてはならない。"
msgstr "  The ideal field would be one that was both undetectable and impervious to interference from the outside."

#. Occurrence 4_1:1847:3269: scene=4_1
#: 4_1:1847
msgctxt "text_id=3269 | speaker=unknown"
msgid "　昨夜、久遠寺有珠が公園に敷いた結界はその<類|たぐい>の、“理想的な”結界だった。"
msgstr "  That was exactly the kind Alice had generated in the park the night before."

#. Occurrence 4_1:1868:3270: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0010; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1868
msgctxt "text_id=3270 | speaker=aoko"
msgid "「……その場所に用があっても、今は無いように思わせれば誰もそこには立ち入らない。"
msgstr "\"...Even if someone has a reason to be in a place, they shouldn't enter if you've made them forget their reason for being there."

#. Occurrence 4_1:1899:3271: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0011; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1899
msgctxt "text_id=3271 | speaker=aoko"
msgid "　隠したい場所の周りに、一時的な意識の<改竄|かいざん>を<促|うなが>す結界を張る……手間はかかるんだけど、一時間程度の<人避|ひとよ>けには信頼性は高い結界よね。"
msgstr "  It takes an immense amount of time and energy to create a field that produces a temporary illusion around a location you wish to conceal, but they prove extremely effective for at least an hour or so, right?"

#. Occurrence 4_1:1918:3272: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0012; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1918
msgctxt "text_id=3272 | speaker=aoko"
msgid "　有珠の鏡を使った一級品だし、途中で破れる事もない。事実、入ってきたのはあの人形だけだとはっきり感じられた。"
msgstr "  And, to top it all, it was top-class, made from your mirrors, and it's not like they shattered while we were using it. The only other presence I felt inside was that of that puppet."

#. Occurrence 4_1:1918:3273: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0012; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:1918
msgctxt "text_id=3273 | speaker=aoko"
msgid "　これで完璧じゃなかったら何が完璧なのよ？」"
msgstr "  If that isn't a perfectly constructed Bounded Field, then what is?\""

#. Occurrence 4_1:1956:3274: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0009; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:1956
msgctxt "text_id=3274 | speaker=alice"
msgid "「……わたしも分からない。森作りに落ち度はなかったわ。"
msgstr "\"...I have no idea. The trees were prepared perfectly."

#. Occurrence 4_1:1962:3275: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0010; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:1962
msgctxt "text_id=3275 | speaker=alice"
msgid "　森は数日かけて栽培したものだし、今まで通り信頼できる結界よ。けど例外があったのなら、どこかで見落としがあったのね」"
msgstr "  I cultivated the trees and plants over several days, and it's always proved to be a reliable field. But maybe, just maybe, there was something I didn't account for.\""

#. Occurrence 4_1:1968:3276: scene=4_1
#: 4_1:1968
msgctxt "text_id=3276 | speaker=unknown"
msgid "　そう言う有珠の瞳は、その見落とし自体なかった事を示している。"
msgstr "  Though Alice's words conceded the possibility, her eyes expressed her confidence that she had overlooked nothing."

#. Occurrence 4_1:2010:3277: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0013; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2010
msgctxt "text_id=3277 | speaker=aoko"
msgid "「……まいった。こうなると、一番いいのは<目撃者|あいつ>が人形使いだってパターンね。それならかろうじて納得できる。相手が魔術師なら、結界の侵入ぐらいできるでしょうし。"
msgstr "\"...Well, crap. In that case, we'd better hope that the witness was the puppeteer, which would make sense. A mage would probably be able to penetrate it."

#. Occurrence 4_1:2022:3278: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0014; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2022
msgctxt "text_id=3278 | speaker=aoko"
msgid "　問題は……侵入した時の違和感を、どうやって消したかって事だけど」"
msgstr "  Something else bothers me, though. How did he avoid detection?\""

#. Occurrence 4_1:2042:3279: scene=4_1
#: 4_1:2042
msgctxt "text_id=3279 | speaker=unknown"
msgid "　そんな使い手が自分たちを狙っている、というのもぞっとしない話だ。"
msgstr "  The thought of being targeted by this individual was pretty terrifying."

#. Occurrence 4_1:2047:3280: scene=4_1
#: 4_1:2047
msgctxt "text_id=3280 | speaker=unknown"
msgid "　有珠の結界を魔術で騙し通せるという事は、相手は久遠寺有珠を上回る魔術の腕を持つという事。"
msgstr "  If they were able to penetrate Alice's field, it could only mean that their skill in magecraft was superior to Alice's."

#. Occurrence 4_1:2066:3281: scene=4_1
#: 4_1:2066
msgctxt "text_id=3281 | speaker=unknown"
msgid "　―――とてもではないが、今の蒼崎青子にどうにかできる相手ではない。"
msgstr "  ...Alice, in her current state, would be completely helpless against such a foe."

#. Occurrence 4_1:2116:3282: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0011; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:2116
msgctxt "text_id=3282 | speaker=alice"
msgid "「……その線はないわ。"
msgstr "\"...I've already determined that it was not a mage."

#. Occurrence 4_1:2122:3283: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0012; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:2122
msgctxt "text_id=3283 | speaker=alice"
msgid "　彼は部外者よ。<椋鳥|むくどり>はともかく、ロビンが後を<辿|たど>れなかったもの。魔力の気配はまったくなし。誰かの魔術で操られている犠牲者、というのもないわね」"
msgstr "  This was most certainly an outsider. The starlings are one thing, but not even Robin was able to follow him. There were no traces of magical energy, so that rules out a magical pawn.\""

#. Occurrence 4_1:2156:3284: scene=4_1
#: 4_1:2156
msgctxt "text_id=3284 | speaker=unknown"
msgid "　はかない希望は打ち砕かれた。"
msgstr "  Aoko was quickly running out of straws to grasp at."

#. Occurrence 4_1:2161:3285: scene=4_1
#: 4_1:2161
msgctxt "text_id=3285 | speaker=unknown"
msgid "　なら、これで青子の質問は終わりだ。"
msgstr "  And that meant she was out of questions to ask."

#. Occurrence 4_1:2166:3286: scene=4_1
#: 4_1:2166
msgctxt "text_id=3286 | speaker=unknown"
msgid "　ここはもう、たんに運が無かったと諦めて昨夜の事を認めるしかない。"
msgstr "  All she could do was call it bad luck and leave it at that."

#. Occurrence 4_1:2211:3287: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0015; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2211
msgctxt "text_id=3287 | speaker=aoko"
msgid "『……魔術師の秘密を見られて、おまけに目撃者を逃がした、か……。普通の高校生の悩みじゃないなぁ……』"
msgstr "(First you get found out that you're a mage, then you let the witness get away. Why couldn't I just have normal high schooler problems...)"

#. Occurrence 4_1:2217:3288: scene=4_1
#: 4_1:2217
msgctxt "text_id=3288 | speaker=unknown"
msgid "　ばふ、とソファーに大きく背中を預ける。"
msgstr "  The sofa groaned as she leaned back."

#. Occurrence 4_1:2222:3289: scene=4_1
#: 4_1:2222
msgctxt "text_id=3289 | speaker=unknown"
msgid "　悲しいかな、見上げた空はブラウンの天井だ。"
msgstr "  Her gaze went up to the brown ceiling with a sigh."

#. Occurrence 4_1:2227:3290: scene=4_1
#: 4_1:2227
msgctxt "text_id=3290 | speaker=unknown"
msgid "　風情も何もあったものじゃない、とますます青子はブルーになる。"
msgstr "  It wasn't much of a view. She was becoming increasingly depressed."

#. Occurrence 4_1:2248:3291: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0013; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:2248
msgctxt "text_id=3291 | speaker=alice"
msgid "「青子。覚悟を決めておいて」"
msgstr "\"Aoko. Make up your mind.\""

#. Occurrence 4_1:2273:3292: scene=4_1
#: 4_1:2273
msgctxt "text_id=3292 | speaker=unknown"
msgid "　超然とした同居人の声。"
msgstr "  Her roommate's voice seemed indifferent."

#. Occurrence 4_1:2278:3293: scene=4_1
#: 4_1:2278
msgctxt "text_id=3293 | speaker=unknown"
msgid "　天井を見上げる青子の瞳に変化はない。ただ、ぼんやりと木造の景色を眺めている。"
msgstr "  But Aoko just kept staring up at the wooden ceiling."

#. Occurrence 4_1:2304:3294: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0014; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:2304
msgctxt "text_id=3294 | speaker=alice"
msgid "「……それとも。貴女にできないのなら、わたしが行ってあげてもいいけど」"
msgstr "\"...If you're not up to the task, I can take care of it myself.\""

#. Occurrence 4_1:2339:3295: scene=4_1
#: 4_1:2339
msgctxt "text_id=3295 | speaker=unknown"
msgid "　冷酷な彼女の言葉は、真実、冷酷な意味を持っていた。"
msgstr "  The cool-mannered girl's statement carried an equally icy implication."

#. Occurrence 4_1:2344:3296: scene=4_1
#: 4_1:2344
msgctxt "text_id=3296 | speaker=unknown"
msgid "　それをゆっくり、自分に許される精一杯の誠実さで青子は飲みこんだ。"
msgstr "  Aoko took the words in slowly with as much sincerity as she could muster."

#. Occurrence 4_1:2349:3297: scene=4_1
#: 4_1:2349
msgctxt "text_id=3297 | speaker=unknown"
msgid "　決して消化できない、熱した<鉛|なまり>を口にするように。"
msgstr "  It was like trying to swallow molten lead."

#. Occurrence 4_1:2393:3298: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0016; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2393
msgctxt "text_id=3298 | speaker=aoko"
msgid "『……そうだ。覚悟なんて、もう決めたでしょう』"
msgstr "(She's right. And I've already made up my mind.)"

#. Occurrence 4_1:2399:3299: scene=4_1
#: 4_1:2399
msgctxt "text_id=3299 | speaker=unknown"
msgid "　自分に言い聞かせるが、それも誤魔化しだ。"
msgstr "  The thought sounded hollow even as it popped into her head."

#. Occurrence 4_1:2404:3300: scene=4_1
#: 4_1:2404
msgctxt "text_id=3300 | speaker=unknown"
msgid "　明らかに前回と今回は違う。"
msgstr "  This was clearly different from last time."

#. Occurrence 4_1:2409:3301: scene=4_1
#: 4_1:2409
msgctxt "text_id=3301 | speaker=unknown"
msgid "　やる事は同じだとしても、その対象の立場が違う。"
msgstr "  While the aim was indeed the same, the circumstances surrounding her target were clearly different."

#. Occurrence 4_1:2440:3302: scene=4_1
#: 4_1:2440
msgctxt "text_id=3302 | speaker=unknown"
msgid "　前回の覚悟は、いわば魔術師としての覚悟だった。"
msgstr "  She may have been determined before, but that was as a mage."

#. Occurrence 4_1:2445:3303: scene=4_1
#: 4_1:2445
msgctxt "text_id=3303 | speaker=unknown"
msgid "　敵が来るから倒す。"
msgstr "  If enemies emerged, she would kill them."

#. Occurrence 4_1:2450:3304: scene=4_1
#: 4_1:2450
msgctxt "text_id=3304 | speaker=unknown"
msgid "　戦いを挑まれたのならこれに応える。"
msgstr "  If she was challenged, she would step up to the fight."

#. Occurrence 4_1:2455:3305: scene=4_1
#: 4_1:2455
msgctxt "text_id=3305 | speaker=unknown"
msgid "　こちらもむこうも同じ魔術師で、形式上<非|ひ>はあちら側にある。たとえその決着が殺人以外の何物でもないとしても、お互い合意の行動だ。"
msgstr "  It was a fight between two mages, and her opponent was in the wrong. Even if this could only end in death for one of them, it was an outcome both parties could accept."

#. Occurrence 4_1:2460:3306: scene=4_1
#: 4_1:2460
msgctxt "text_id=3306 | speaker=unknown"
msgid "　殺し、殺される<天秤|てんびん>の上での行為。"
msgstr "  Kill or be killed."

#. Occurrence 4_1:2465:3307: scene=4_1
#: 4_1:2465
msgctxt "text_id=3307 | speaker=unknown"
msgid "　彼らも彼女も、善悪の<秤|はかり>をそもそも用意していない。"
msgstr "  Morality had no weight on this scale."

#. Occurrence 4_1:2503:3308: scene=4_1
#: 4_1:2503
msgctxt "text_id=3308 | speaker=unknown"
msgid "　けれど今回は違う。"
msgstr "  But this time was different."

#. Occurrence 4_1:2508:3309: scene=4_1
#: 4_1:2508
msgctxt "text_id=3309 | speaker=unknown"
msgid "　相手は敵でもないし、魔術師でもない。こっちはそのつもりでも、相手にその気はないだろう。"
msgstr "  Her opponent was neither enemy nor mage. Even if she was prepared to kill them, this person was likely not ready to die."

#. Occurrence 4_1:2513:3310: scene=4_1
#: 4_1:2513
msgctxt "text_id=3310 | speaker=unknown"
msgid "　……だから、これはきっと善悪の話になる。"
msgstr "  ...That's why morality did factor into it, now."

#. Occurrence 4_1:2518:3311: scene=4_1
#: 4_1:2518
msgctxt "text_id=3311 | speaker=unknown"
msgid "　無関係な殺戮を、果たして自分は負えるのか。"
msgstr "  Was she truly up to the task of murdering an innocent person?"

#. Occurrence 4_1:2523:3312: scene=4_1
#: 4_1:2523
msgctxt "text_id=3312 | speaker=unknown"
msgid "　魔術師なら当然の、よくある<手|こ><間|と>だと飲みこむのか。"
msgstr "  Could she swallow the fact that this was a common occurrence for a mage?"

#. Occurrence 4_1:2571:3313: scene=4_1
#: 4_1:2571
msgctxt "text_id=3313 | speaker=unknown"
msgid "　まさか、と鼻で笑う。"
msgstr "  She snorted sardonically."

#. Occurrence 4_1:2576:3314: scene=4_1
#: 4_1:2576
msgctxt "text_id=3314 | speaker=unknown"
msgid "『魔術師だから』なんて理由で現実社会との折り合いを無くす超越性なぞ、はなから青子は持っていない。"
msgstr "  Being a mage did not mean that Aoko was some kind of monk who could cut ties with the real world on a whim."

#. Occurrence 4_1:2581:3315: scene=4_1
#: 4_1:2581
msgctxt "text_id=3315 | speaker=unknown"
msgid "　心に確信のないまま、"
msgstr "  If there was one thing Aoko hated..."

#. Occurrence 4_1:2586:3316: scene=4_1
#: 4_1:2586
msgctxt "text_id=3316 | speaker=unknown"
msgid "　分からないまま行動する事を、青子は嫌っている。"
msgstr "  It was doing things without conviction or an understanding of exactly why she was doing them."

#. Occurrence 4_1:2591:3317: scene=4_1
#: 4_1:2591
msgctxt "text_id=3317 | speaker=unknown"
msgid "　彼女が走る時は、いつも自分に決断を下した後だ。"
msgstr "  When she acted, she preferred to act decisively."

#. Occurrence 4_1:2654:3318: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0017; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2654
msgctxt "text_id=3318 | speaker=aoko"
msgid "「うん。ま、やるしかないだろうね」"
msgstr "\"I guess I don't have any other choice.\""

#. Occurrence 4_1:2687:3319: scene=4_1
#: 4_1:2687
msgctxt "text_id=3319 | speaker=unknown"
msgid "　さばさばした一言とともに、青子はソファーから背を離した。いいかげん天井は見飽きたらしい。"
msgstr "  As she said it, she got up from the sofa, having had her fill of the ceiling for one day."

#. Occurrence 4_1:2692:3320: scene=4_1
#: 4_1:2692
msgctxt "text_id=3320 | speaker=unknown"
msgid "　青子はいつも通りの青子で、有珠もあえて言及はしない。"
msgstr "  Aoko had returned to the Aoko of always, and Alice was done probing her."

#. Occurrence 4_1:2720:3321: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0015; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:2720
msgctxt "text_id=3321 | speaker=alice"
msgid "「じゃあ、これ」"
msgstr "\"Take this.\""

#. Occurrence 4_1:2726:3322: scene=4_1
#: 4_1:2726
msgctxt "text_id=3322 | speaker=unknown"
msgid "　ご褒美、とばかりに有珠は<小瓶|こびん>を取り出した。"
msgstr "  As if to reward her, Alice produced a small bottle."

#. Occurrence 4_1:2762:3323: scene=4_1
#: 4_1:2762
msgctxt "text_id=3323 | speaker=unknown"
msgid "　手のひらに収まるほどの大きさ。"
msgstr "  It fit neatly in the palm of her hand."

#. Occurrence 4_1:2767:3324: scene=4_1
#: 4_1:2767
msgctxt "text_id=3324 | speaker=unknown"
msgid "　少女の細い指先とは不釣り合いな、寸胴の、見栄えしない瓶である。"
msgstr "  The bottle looked completely out of place in her slender fingers."

#. Occurrence 4_1:2772:3325: scene=4_1
#: 4_1:2772
msgctxt "text_id=3325 | speaker=unknown"
msgid "　瓶は曇っていて、中身はカラ。"
msgstr "  The glass was cloudy and it appeared empty."

#. Occurrence 4_1:2777:3326: scene=4_1
#: 4_1:2777
msgctxt "text_id=3326 | speaker=unknown"
msgid "　表面にはラベルのシールを強引に剥がした跡が見られた。"
msgstr "  Some shreds of paper remained on the front where there was once a label."

#. Occurrence 4_1:2798:3327: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0018; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2798
msgctxt "text_id=3327 | speaker=aoko"
msgid "「なによ、それ」"
msgstr "\"What's that?\""

#. Occurrence 4_1:2822:3328: scene=4_1
#: 4_1:2822
msgctxt "text_id=3328 | speaker=unknown"
msgid "　不吉なものを感じて、<胡散|うさん>臭そうに小瓶を睨む。"
msgstr "  Aoko stared at the bottle suspiciously."

#. Occurrence 4_1:2862:3329: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0016; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:2862
msgctxt "text_id=3329 | speaker=alice"
msgid "「収納の小瓶。ちょうどひとつ余ってたから、あげるわ」"
msgstr "\"It's a storage bottle. I had one to spare, so I'm giving it to you.\""

#. Occurrence 4_1:2899:3330: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0019; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2899
msgctxt "text_id=3330 | speaker=aoko"
msgid "「はい？」"
msgstr "\"A what?\""

#. Occurrence 4_1:2905:3331: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0017; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:2905
msgctxt "text_id=3331 | speaker=alice"
msgid "「名前は忘れたけど、中国の小説に出てきたのと同じよ」"
msgstr "\"I forgot what it's called, but it's a thing out of a Chinese novel.\""

#. Occurrence 4_1:2918:3332: scene=4_1
#: 4_1:2918
msgctxt "text_id=3332 | speaker=unknown"
msgid "　素っ気ない言葉に、青子は驚異の理解力を示した。"
msgstr "  Aoko was miraculously able to parse what Alice meant."

#. Occurrence 4_1:2958:3333: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0020_0; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2958
msgctxt "text_id=3333 | speaker=aoko"
msgid "「それって<蓮華洞|れんげどう>の<番人|きょうだい>の話？　じゃ、あの赤い<瓢箪|ひょうたん>と同じなわけ？"
msgstr "\"Are you saying that this is the red drinking gourd from the story about the two brothers who guarded the Lotus Cave?"

#. Occurrence 4_1:2985:3334: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0020_1; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:2985
msgctxt "text_id=3334 | speaker=aoko"
msgid "　言いたくないけど、そこらへんの風邪薬のラベルを無理やり剥がして、小瓶に見せかけてるそれが？」"
msgstr "  Don't take this the wrong way, but it looks like your everyday medicine bottle with the label ripped off.\""

#. Occurrence 4_1:3034:3335: scene=4_1
#: 4_1:3034
msgctxt "text_id=3335 | speaker=unknown"
msgid "　言われて、たしかにセンスも何もない、と小瓶をまじまじと見る有珠。"
msgstr "  Alice looked at the bottle and acknowledged how ordinary it looked."

#. Occurrence 4_1:3060:3336: scene=4_1
#: 4_1:3060
msgctxt "text_id=3336 | speaker=unknown"
msgid "　が、別に自分が使うわけでもないと悟ったのか、あっさりと小瓶をテーブルに置いた。"
msgstr "  She also understood that she would not be the one using it as she set it on the table."

#. Occurrence 4_1:3087:3337: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0018; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3087
msgctxt "text_id=3337 | speaker=alice"
msgid "「赤い瓢箪じゃなくて、<羊脂玉|ようしぎょく>の<浄瓶|じょうびん>の方」"
msgstr "\"Except this is a jade flask, not a red drinking gourd.\""

#. Occurrence 4_1:3117:3338: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0021; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:3117
msgctxt "text_id=3338 | speaker=aoko"
msgid "「そういう問題じゃない。私は魔術師としての雰囲気を論じてるんだっ」"
msgstr "\"That's not the problem. The problem is maintaining my dignity as a mage.\""

#. Occurrence 4_1:3130:3339: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0019; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3130
msgctxt "text_id=3339 | speaker=alice"
msgid "「些細な事を気にするのね。<正露丸|せいろがん>の瓶じゃないだけいいと思うけど」"
msgstr "\"Don't get stuck on the details. Just be happy it's not a bottle of laxatives.\""

#. Occurrence 4_1:3143:3340: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0022; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:3143
msgctxt "text_id=3340 | speaker=aoko"
msgid "「―――む」"
msgstr "\"...Fine.\""

#. Occurrence 4_1:3148:3341: scene=4_1
#: 4_1:3148
msgctxt "text_id=3341 | speaker=unknown"
msgid "　あまりにも説得力のある返答だった。"
msgstr "  She made a good point."

#. Occurrence 4_1:3199:3342: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0020; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3199
msgctxt "text_id=3342 | speaker=alice"
msgid "「ふたを開けて、相手の名前を<訊|たず>ねればいいから。"
msgstr "\"Just open the lid and ask for the person's name."

#. Occurrence 4_1:3205:3343: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0021; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3205
msgctxt "text_id=3343 | speaker=alice"
msgid "　ただし相手に抵抗する意志が残っている場合、小瓶は割れるから気をつけて」"
msgstr "  But be careful, because if the target is resistant, the bottle will shatter.\""

#. Occurrence 4_1:3210:3344: scene=4_1
#: 4_1:3210
msgctxt "text_id=3344 | speaker=unknown"
msgid "　淡々と語る有珠と、眉をひそめる青子。"
msgstr "  Aoko raised her eyebrows."

#. Occurrence 4_1:3226:3345: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0023; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:3226
msgctxt "text_id=3345 | speaker=aoko"
msgid "「ちょっと待った。抵抗する意志があるとダメって、眠っている時にやれってコト？」"
msgstr "\"Hang on. If he's resistant, I can only use it when he's asleep, right?\""

#. Occurrence 4_1:3277:3346: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0022; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3277
msgctxt "text_id=3346 | speaker=alice"
msgid "「……それは試したコトがなかったわ。"
msgstr "\"...I've never tried it, to be honest."

#. Occurrence 4_1:3283:3347: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0023; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3283
msgctxt "text_id=3347 | speaker=alice"
msgid "　眠っているのに返事をする人っているの？」"
msgstr "  But is there anyone who responds to things in their sleep?\""

#. Occurrence 4_1:3304:3348: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0024; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:3304
msgctxt "text_id=3348 | speaker=aoko"
msgid "「……たまにいるけど。"
msgstr "\"...You'd be surprised."

#. Occurrence 4_1:3304:3349: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0024; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:3304
msgctxt "text_id=3349 | speaker=aoko"
msgid "　まあ、確かに珍しいわね、そういう人」"
msgstr "  But, true. People like that are rare.\""

#. Occurrence 4_1:3310:3350: scene=4_1
#: 4_1:3310
msgctxt "text_id=3350 | speaker=unknown"
msgid "　となると、あとは相手が思いっきり衰弱していて、前後不覚になっている、といった状況ぐらいか。"
msgstr "  In that case, one would have to weaken them until they were about to pass out."

#. Occurrence 4_1:3331:3351: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0024; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3331
msgctxt "text_id=3351 | speaker=alice"
msgid "「あ、そうそう。薬や魔術がかかっていると、その<余分|おも>さでも割れるから気をつけて」"
msgstr "\"Oh, I almost forgot. Drugs or magecraft will also cause the bottle to break.\""

#. Occurrence 4_1:3376:3352: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0025; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:3376
msgctxt "text_id=3352 | speaker=aoko"
msgid "「つっかえない！"
msgstr "\"Then what good is it!?"

#. Occurrence 4_1:3376:3353: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0025; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:3376
msgctxt "text_id=3353 | speaker=aoko"
msgid "　それってほとんど役たたずって事じゃない！」"
msgstr "  What won't break the damn thing?\""

#. Occurrence 4_1:3406:3354: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0025; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3406
msgctxt "text_id=3354 | speaker=alice"
msgid "「それは青子しだいね」"
msgstr "\"A tool is only as good as the person using it.\""

#. Occurrence 4_1:3411:3355: scene=4_1
#: 4_1:3411
msgctxt "text_id=3355 | speaker=unknown"
msgid "　言って、有珠は視線を外す。"
msgstr "  Alice turned away as she replied,"

#. Occurrence 4_1:3416:3356: scene=4_1
#: 4_1:3416
msgctxt "text_id=3356 | speaker=unknown"
msgid "　もうこの話題はどうでもいい、と言うように。"
msgstr "  as if the topic no longer mattered to her."

#. Occurrence 4_1:3466:3357: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_1_0026; voice_prefix=A10; voice_category=1; scene=4_1
#: 4_1:3466
msgctxt "text_id=3357 | speaker=aoko"
msgid "「……はあ。有珠がこういう小道具好きなのは知ってたけどね……これも趣味なワケ？」"
msgstr "\"...Ugh. I know you're fond of using dainty tools like this. Is it a hobby of yours or something?\""

#. Occurrence 4_1:3471:3358: scene=4_1
#: 4_1:3471
msgctxt "text_id=3358 | speaker=unknown"
msgid "　あんまりこういう趣味は持ってほしくないな、と思いつつ青子は問う。"
msgstr "  Aoko asked, hoping Alice would deny it."

#. Occurrence 4_1:3484:3359: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0026; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3484
msgctxt "text_id=3359 | speaker=alice"
msgid "「たぶん。"
msgstr "\"Perhaps."

#. Occurrence 4_1:3490:3360: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_1_0027; voice_prefix=A40; voice_category=2; scene=4_1
#: 4_1:3490
msgctxt "text_id=3360 | speaker=alice"
msgid "　それで、どうするの？　持っていくのか、いかないのか」"
msgstr "  So? Are you going to take it or leave it?\""

#. Occurrence 4_1:3555:3361: scene=4_1
#: 4_1:3555
msgctxt "text_id=3361 | speaker=unknown"
msgid "　その質問には答えず、しばし迷ってから青子は小瓶を手に取ると、ポケットにしまいこんだ。"
msgstr "  Without answering, Aoko dithered a bit before taking the bottle and putting it in her pocket."

#. Occurrence 4_1:3561:3362: scene=4_1
#: 4_1:3561
msgctxt "text_id=3362 | speaker=unknown"
msgid "　まあ、何かの役には立つかもしれない。"
msgstr "  She figured she might be able to find some use for it."

#. Occurrence 4_2:54:3363: scene=4_2
#: 4_2:54
msgctxt "text_id=3363 | speaker=unknown"
msgid "　それから二時間ほど経った午後九時。"
msgstr "  Two hours had passed and the clock struck nine."

#. Occurrence 4_2:59:3364: scene=4_2
#: 4_2:59
msgctxt "text_id=3364 | speaker=unknown"
msgid "　ふたりは話し合いの場を居間からサンルームに移し、この洋館に不釣り合いな光景をくり広げていた。"
msgstr "  Their conversation had moved from the drawing room to the sunroom, and had manifested into the kind of scene one would not expect in such a mansion."

#. Occurrence 4_2:105:3365: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0000; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:105
msgctxt "text_id=3365 | speaker=aoko"
msgid "「まあホントはね、鳶丸に任せる気はなかったんだけど」"
msgstr "\"To be honest, I didn't really want to leave it to Tobimaru like this.\""

#. Occurrence 4_2:111:3366: scene=4_2
#: 4_2:111
msgctxt "text_id=3366 | speaker=unknown"
msgid "　テーブルの上にでん、と土鍋が置かれている。"
msgstr "  A hot earthenware pot sat on the table."

#. Occurrence 4_2:117:3367: scene=4_2
#: 4_2:117
msgctxt "text_id=3367 | speaker=unknown"
msgid "　くつくつと温かな湯気をたてる土鍋を<箸|はし>でつつきながら、青子は誰に語るでもなくぼやいている。"
msgstr "  Aoko spat out complaints to no one in particular as she plucked food from it with her chopsticks."

#. Occurrence 4_2:137:3368: scene=4_2
#: 4_2:137
msgctxt "text_id=3368 | speaker=unknown"
msgid "　今晩の夕食は、洋館にあるまじき和食だった。"
msgstr "  Tonight they were eating a traditional Japanese meal that looked out of place in this mansion."

#. Occurrence 4_2:142:3369: scene=4_2
#: 4_2:142
msgctxt "text_id=3369 | speaker=unknown"
msgid "　こういう日本的、かつ材料を買ってくるだけで済む鍋物はおもに青子の担当である。"
msgstr "  When it came to the kind of Japanese hotpot where all one had to do was buy and boil ingredients, it was usually Aoko's responsibility."

#. Occurrence 4_2:148:3370: scene=4_2
#: 4_2:148
msgctxt "text_id=3370 | speaker=unknown"
msgid "　有珠は青子の対面で、やはり無言で鍋にフォークを入れていた。"
msgstr "  Alice sat across from Aoko as she silently poked at the pot with a fork."

#. Occurrence 4_2:200:3371: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0001; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:200
msgctxt "text_id=3371 | speaker=aoko"
msgid "「<山城|ヤマシロ>の奴が来るなり『静希くんはまだ部活に入っていないから、面倒みてあげてくれないかな』なんて言ってくるもんだからさ。全校生徒の行動範囲なんて見直す気力無くなっちゃったのよ」"
msgstr "\"Yamasiro made it a point to say that Sizuki hadn't joined a club. It's not like I have the time or energy to keep track of every single student.\""

#. Occurrence 4_2:240:3372: scene=4_2
#: 4_2:240
msgctxt "text_id=3372 | speaker=unknown"
msgid "　取った玉子はまだ乙女のように純白だったので鍋に返す。"
msgstr "  The egg she had plucked was still as silky as a baby's bottom, so she returned it to the pot."

#. Occurrence 4_2:245:3373: scene=4_2
#: 4_2:245
msgctxt "text_id=3373 | speaker=unknown"
msgid "　仕方なく火の通りの早いしらたきに手を出した。"
msgstr "  She settled for the shirataki noodles instead."

#. Occurrence 4_2:372:3374: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0002; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:372
msgctxt "text_id=3374 | speaker=aoko"
msgid "「そりゃあ、あのバカがバイトで忙しいのは知ってるわよ。"
msgstr "\"I already know that the idiot is constantly busy with his jobs."

#. Occurrence 4_2:378:3375: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0003; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:378
msgctxt "text_id=3375 | speaker=aoko"
msgid "　だから出来るだけ春先までのんびりしてて、あんなのでも親身になってくれそうな部の部長にあたってみたのに。"
msgstr "  That's why I tried my best to set him up with a club activity captain that'd be accommodating."

#. Occurrence 4_2:387:3376: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0004_0; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:387
#. Occurrence 4_2:395:3376: scene=4_2
#: 4_2:395
msgctxt "text_id=3376 | speaker=aoko"
msgid "ありがとうのひとつも無いってのは、ちょっと癪にさわるわよね。"
msgstr "But the nerve of the guy, not even a thanks."

#. Occurrence 4_2:438:3377: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0004_1; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:438
msgctxt "text_id=3377 | speaker=aoko"
msgid "　ね、聞いてる有珠？」"
msgstr "  Are you even listening, Alice?\""

#. Occurrence 4_2:486:3378: scene=4_2
#: 4_2:486
msgctxt "text_id=3378 | speaker=unknown"
msgid "　具を口に含んでいたのか、声を上げずに有珠は首を縦に振った。"
msgstr "  As if her mouth was full, she simply nodded in response."

#. Occurrence 4_2:491:3379: scene=4_2
#: 4_2:491
msgctxt "text_id=3379 | speaker=unknown"
msgid "　興味も意見もまったくないという<表情|かお>だが、話だけは聞いているようだ。"
msgstr "  Her expression stated that she had no interest nor opinion on the matter, but she at least appeared to be listening."

#. Occurrence 4_2:496:3380: scene=4_2
#: 4_2:496
msgctxt "text_id=3380 | speaker=unknown"
msgid "　それに満足して青子ははんぺんをかじった。"
msgstr "  Satisfied, Aoko nibbled on some hanpen fish cake."

#. Occurrence 4_2:554:3381: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0005; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:554
msgctxt "text_id=3381 | speaker=aoko"
msgid "「それに私、いい人ー、なんて言われるヤツは信用できないのよ。あろう事か鳶丸までそんなこと口走る始末だし。"
msgstr "\"I just can't trust anyone who says he's a great guy. Surprise, even Tobimaru was gushing about him."

#. Occurrence 4_2:554:3382: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0005; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:554
msgctxt "text_id=3382 | speaker=aoko"
msgid "　あれはいい人なんじゃなくて、ただぼんやりしてるだけなんだっての。"
msgstr "  The only thing he's great at is being an airhead."

#. Occurrence 4_2:566:3383: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0006; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:566
msgctxt "text_id=3383 | speaker=aoko"
msgid "　……大体、あそこまで言われて怒りもしないなんてどうかしてるわ」"
msgstr "  ...I mean, there's really something wrong with his brain if he didn't get angry after what I said.\""

#. Occurrence 4_2:625:3384: scene=4_2
#: 4_2:625
msgctxt "text_id=3384 | speaker=unknown"
msgid "　今日の生徒会室での一件を思い出す。"
msgstr "  Her thoughts went to what had happened in the student council room earlier that day."

#. Occurrence 4_2:630:3385: scene=4_2
#: 4_2:630
msgctxt "text_id=3385 | speaker=unknown"
msgid "　草十郎は青子の一方的な言葉に、さして反論もせずそのまま去っていった。"
msgstr "  She remembered how non-responsive Soujyuro had been to her words."

#. Occurrence 4_2:635:3386: scene=4_2
#: 4_2:635
msgctxt "text_id=3386 | speaker=unknown"
msgid "　あの取り澄ました顔を思い出すだけで残ったはんぺんを噛まずに飲みこんでしまう青子なのだった。"
msgstr "  His unconcerned face alone was enough for her to swallow the rest of her hanpen without chewing it."

#. Occurrence 4_2:691:3387: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0007; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:691
msgctxt "text_id=3387 | speaker=aoko"
msgid "『……ふん。なにが分かってるんだな、よ』"
msgstr "\"I thought you would understand,\" he says. Hah!"

#. Occurrence 4_2:697:3388: scene=4_2
#: 4_2:697
msgctxt "text_id=3388 | speaker=unknown"
msgid "　草十郎の一言と、幼年期の終わりに贈られた言葉が重なる。"
msgstr "  His words were a lot like those that ended her childhood."

#. Occurrence 4_2:718:3389: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_4_2_0000; voice_prefix=B30; voice_category=9; scene=4_2
#: 4_2:718
msgctxt "text_id=3389 | speaker=ritsuka"
msgid "“―――青子ちゃんは分かっているんだね。"
msgstr "\"You know it, don't you, Aoko?"

#. Occurrence 4_2:724:3390: speaker=ritsuka; speaker_ja=律架; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B30_4_2_0001; voice_prefix=B30; voice_category=9; scene=4_2
#: 4_2:724
msgctxt "text_id=3390 | speaker=ritsuka"
msgid "　それでも自分であり続けられるという事は、とても強い事なんだよ―――”"
msgstr "  Through it all, you never lose sight of who you are. You're so strong...\""

#. Occurrence 4_2:730:3391: scene=4_2
#: 4_2:730
msgctxt "text_id=3391 | speaker=unknown"
msgid "　たぶん、あの言葉は誉めてくれていたのだ。"
msgstr "  Perhaps it was meant as a compliment."

#. Occurrence 4_2:735:3392: scene=4_2
#: 4_2:735
msgctxt "text_id=3392 | speaker=unknown"
msgid "　でも自分にとって残酷な評価だった。"
msgstr "  But she took it as a patronizing way to pity her."

#. Occurrence 4_2:740:3393: scene=4_2
#: 4_2:740
msgctxt "text_id=3393 | speaker=unknown"
msgid "　だって、それを告げるあの人の顔は、痛ましいものを見るような顔をしていたのだ。"
msgstr "  Because the person who said it had acted like she was looking at a wounded animal."

#. Occurrence 4_2:761:3394: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0008; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:761
msgctxt "text_id=3394 | speaker=aoko"
msgid "『―――ま。あんな変態の言ってたコトなんて、いまさらどうでもいいけどさ』"
msgstr "(Whatever. Who cares what that weirdo thinks or says?)"

#. Occurrence 4_2:767:3395: scene=4_2
#: 4_2:767
msgctxt "text_id=3395 | speaker=unknown"
msgid "　それでも、生涯最大の気の迷いであったワケだけど、憧れていた人物にあんな顔をされたのは幼心にショックだった。"
msgstr "  That episode might have made her the most confused she had ever been in her life. Yet, what shocked young Aoko the most was to look of pity on the face of the person she admired the most."

#. Occurrence 4_2:788:3396: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0000; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:788
msgctxt "text_id=3396 | speaker=alice"
msgid "「……ケンカ」"
msgstr "\"...You fought.\""

#. Occurrence 4_2:829:3397: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0009; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:829
msgctxt "text_id=3397 | speaker=aoko"
msgid "「え？」"
msgstr "\"Huh?\""

#. Occurrence 4_2:834:3398: scene=4_2
#: 4_2:834
msgctxt "text_id=3398 | speaker=unknown"
msgid "　箸を浮かせたまま物思いに<耽|ふけ>っていた青子に、有珠は唐突にそう言い放った。"
msgstr "  The abrupt comment stopped her in her tracks."

#. Occurrence 4_2:876:3399: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0010; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:876
msgctxt "text_id=3399 | speaker=aoko"
msgid "「ごめん、聞いてなかった。ケンカって、あの喧嘩？」"
msgstr "\"Sorry, what'd you say? Something about a fight?\""

#. Occurrence 4_2:881:3400: scene=4_2
#: 4_2:881
msgctxt "text_id=3400 | speaker=unknown"
msgid "　こくり、と可憐な首が頷く。"
msgstr "  Alice nodded."

#. Occurrence 4_2:932:3401: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0001; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:932
msgctxt "text_id=3401 | speaker=alice"
msgid "「貴女の感想だけじゃ状況はよく掴めないけど。"
msgstr "\"I can't say I completely understand from what you've said."

#. Occurrence 4_2:944:3402: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0002; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:944
msgctxt "text_id=3402 | speaker=alice"
msgid "　つまり、青子はその人に喧嘩を売りたかったのね」"
msgstr "  But it does come across as if you were trying to pick a fight with him.\""

#. Occurrence 4_2:981:3403: scene=4_2
#: 4_2:981
msgctxt "text_id=3403 | speaker=unknown"
msgid "　はむ、と最後のはんぺんに口をつける有珠。"
msgstr "  Alice bit into the very last hanpen."

#. Occurrence 4_2:986:3404: scene=4_2
#: 4_2:986
msgctxt "text_id=3404 | speaker=unknown"
msgid "　それはあんまりに予想外で、いやに的を射た意見のような。"
msgstr "  Her remark was unexpected but completely on point."

#. Occurrence 4_2:1040:3405: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0011; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1040
msgctxt "text_id=3405 | speaker=aoko"
msgid "「な……なんでそうなるのよ!?"
msgstr "\"...W-why did you go there!?"

#. Occurrence 4_2:1047:3406: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0012_0; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1047
msgctxt "text_id=3406 | speaker=aoko"
msgid "　私はあんなのと一秒だって関わりたくないだけだってば！"
msgstr "  I'd rather die than spend another second with him!"

#. Occurrence 4_2:1088:3407: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0012_1; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1088
msgctxt "text_id=3407 | speaker=aoko"
msgid "だいたいそれどころじゃないし！　興味とかまったくないし！"
msgstr "I mean, seriously! Gross! I have no interest in him whatsoever!"

#. Occurrence 4_2:1127:3408: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0012_2; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1127
msgctxt "text_id=3408 | speaker=aoko"
msgid "会話もこれ以上ないってぐらい簡潔に切り上げたし！」"
msgstr " I'd love it if I never had to say anything about him ever again!\""

#. Occurrence 4_2:1162:3409: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0003; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:1162
msgctxt "text_id=3409 | speaker=alice"
msgid "「なら、どうして今そんな話をするの？」"
msgstr "\"So why all the talk about him?\""

#. Occurrence 4_2:1201:3410: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0013; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1201
msgctxt "text_id=3410 | speaker=aoko"
msgid "「え……それは……その、"
msgstr "\"W-what...I, err..."

msgctxt "text_id=3411 | speaker=unknown"
msgid "アンタに今日の調査過程を報せてあげたのよ。それ以外何があるって言うの？」"
msgstr " I was just reporting on today's investigation. Something wrong with that?\""

#. Occurrence 4_2:1255:3412: scene=4_2
#: 4_2:1255
msgctxt "text_id=3412 | speaker=unknown"
msgid "　本当に、それ以外に何があるって言うんだろう？"
msgstr "  What other reason could Alice be suggesting Aoko had for bringing it up?"

#. Occurrence 4_2:1274:3413: scene=4_2
#: 4_2:1274
msgctxt "text_id=3413 | speaker=unknown"
msgid "　自ら墓穴を掘って中に入り、追い打ちとばかりに土を被っている事に青子が気付くのは数時間後、おやすみなさいとベッドに入ってからである。"
msgstr "  It would be several hours later, in bed, that Aoko realized that she had dug her own grave."

#. Occurrence 4_2:1316:3414: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0004; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:1316
msgctxt "text_id=3414 | speaker=alice"
msgid "「いいけど、わたしは別に。"
msgstr "\"No, not really."

#. Occurrence 4_2:1322:3415: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0005; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:1322
msgctxt "text_id=3415 | speaker=alice"
msgid "　ただ……青子は、本当にその人が嫌いなの？」"
msgstr "  But... does he really bother you that much?\""

#. Occurrence 4_2:1328:3416: scene=4_2
#: 4_2:1328
msgctxt "text_id=3416 | speaker=unknown"
msgid "　何か神聖な作業をするように、黙々とおでんを食べながら有珠は質問する。"
msgstr "  Alice ate her hotpot in silence as if she was honoring some sort of sacred ritual."

#. Occurrence 4_2:1382:3417: scene=4_2
#: 4_2:1382
msgctxt "text_id=3417 | speaker=unknown"
msgid "　表情こそいつも通り無関心だが、内面では青子の態度を面白がっている節がある。"
msgstr "  Her face was as indifferent as always, but she was secretly enjoying how flustered Aoko was."

#. Occurrence 4_2:1387:3418: scene=4_2
#: 4_2:1387
msgctxt "text_id=3418 | speaker=unknown"
msgid "　そんな有珠の思惑にも青子は気付けなかった。"
msgstr "  Aoko remained oblivious to this."

#. Occurrence 4_2:1392:3419: scene=4_2
#: 4_2:1392
msgctxt "text_id=3419 | speaker=unknown"
msgid "　いつもなら簡単に気が付くのだが、ちょっとした心の混乱がその余裕を奪っている。"
msgstr "  Normally, she would have noticed immediately, but she was not quite herself at this moment."

#. Occurrence 4_2:1444:3420: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0014; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1444
msgctxt "text_id=3420 | speaker=aoko"
msgid "「本当にって……そりゃそうよ。気にくわないって何度も言ってるじゃない」"
msgstr "\"Does he really―well, of course he does. I think I've said that often enough.\""

#. Occurrence 4_2:1453:3421: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0006; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:1453
msgctxt "text_id=3421 | speaker=alice"
msgid "「そ。具体的には？」"
msgstr "\"Okay. What specifically about him do you dislike?\""

#. Occurrence 4_2:1462:3422: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0015; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1462
msgctxt "text_id=3422 | speaker=aoko"
msgid "「はあ？　具体的にはって、そんなのに理由なんて……」"
msgstr "\"Huh? I don't need a specific reason to...\""

#. Occurrence 4_2:1498:3423: scene=4_2
#: 4_2:1498
msgctxt "text_id=3423 | speaker=unknown"
msgid "　そこまで口にして、ようやく青子はその矛盾に気が付いた。"
msgstr "  She trailed off as she finally realized how disagreeable she was being."

#. Occurrence 4_2:1525:3424: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0016; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1525
msgctxt "text_id=3424 | speaker=aoko"
msgid "『……む……ぬ？』"
msgstr "(...Hrm. ...Mm?)"

#. Occurrence 4_2:1530:3425: scene=4_2
#: 4_2:1530
msgctxt "text_id=3425 | speaker=unknown"
msgid "　そう、理由なんてこれっぽっちもない。"
msgstr "  She could come up with no reason why."

#. Occurrence 4_2:1535:3426: scene=4_2
#: 4_2:1535
msgctxt "text_id=3426 | speaker=unknown"
msgid "　一目見た時からあの田舎者とは相容れないな、と本能が告げただけだ。"
msgstr "  Her instincts had told her that she was incompatible with that hick."

#. Occurrence 4_2:1540:3427: scene=4_2
#: 4_2:1540
msgctxt "text_id=3427 | speaker=unknown"
msgid "　でも、それは一体どうしてだろう？"
msgstr "  But why such a strong reaction?"

#. Occurrence 4_2:1545:3428: scene=4_2
#: 4_2:1545
msgctxt "text_id=3428 | speaker=unknown"
msgid "　そもそも理由のない感情、根拠のない決めつけなんてものは、彼女が一番嫌うところだ。"
msgstr "  More than anything in the world, Aoko hated emotions without reason and decisions made with no rationale."

#. Occurrence 4_2:1599:3429: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0017; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1599
msgctxt "text_id=3429 | speaker=aoko"
msgid "「う……き、嫌いな物は嫌いなんだから……ちゃんと、どっかに理由があるんだ、と思うけど……」"
msgstr "\"Ugh... I just don't like him. I'm... sure there's a good reason for it. I think.\""

#. Occurrence 4_2:1605:3430: scene=4_2
#: 4_2:1605
msgctxt "text_id=3430 | speaker=unknown"
msgid "　口にすればするほど歯切れが悪くなる。"
msgstr "  She became more flustered the more she talked."

#. Occurrence 4_2:1610:3431: scene=4_2
#: 4_2:1610
msgctxt "text_id=3431 | speaker=unknown"
msgid "　……困ったことに、青子には静希草十郎を嫌がる理由が見当たらなかった。"
msgstr "  Unfortunately for her, she could not come up with a coherent reason to hate Soujyuro Sizuki."

#. Occurrence 4_2:1692:3432: scene=4_2
#: 4_2:1692
msgctxt "text_id=3432 | speaker=unknown"
msgid "　常識がないのは彼の今までの環境が悪いのであって、草十郎自身に非はない。"
msgstr "  It was not his fault that he had zero common sense. It was the fault of the environment he grew up in."

#. Occurrence 4_2:1697:3433: scene=4_2
#: 4_2:1697
msgctxt "text_id=3433 | speaker=unknown"
msgid "　いや、逆になんとか文明社会に順応しようとする姿勢には好感が持てる筈だ。"
msgstr "  In fact, it was admirable that he was trying so hard to adapt to civilized society."

#. Occurrence 4_2:1723:3434: scene=4_2
#: 4_2:1723
msgctxt "text_id=3434 | speaker=unknown"
msgid "　ぼんやりした所も、行動が<緩慢|かんまん>という訳ではない。"
msgstr "  As clueless as he might seem, he was not a complete waste of space."

#. Occurrence 4_2:1728:3435: scene=4_2
#: 4_2:1728
msgctxt "text_id=3435 | speaker=unknown"
msgid "　彼の仕草や言動がワンテンポ遅く見えるのは、彼が自分の言動に注意を払っているからであり、結果、緩やかに見えるだけなのだ。"
msgstr "  If he seemed a bit slow, it was only because his gentle nature compelled him to think before acting."

#. Occurrence 4_2:1733:3436: scene=4_2
#: 4_2:1733
msgctxt "text_id=3436 | speaker=unknown"
msgid "　そうやって静希草十郎という人物をあくまで公平に環境と人格に分けて評価すれば、結果は分かりきっている。"
msgstr "  When one looked at everything objectively, the conclusion was obvious."

#. Occurrence 4_2:1738:3437: scene=4_2
#: 4_2:1738
msgctxt "text_id=3437 | speaker=unknown"
msgid "　認めたくないが、みんなの言う通り、嫌味のない『いい人』像がそこにある。"
msgstr "  As much as she was loathe to admit it, he really was unassuming do-gooder everyone had him pegged as."

#. Occurrence 4_2:1765:3438: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_2_0018; voice_prefix=A10; voice_category=1; scene=4_2
#: 4_2:1765
msgctxt "text_id=3438 | speaker=aoko"
msgid "『ちょっと本気かっての……人間的に悪いところ、ホントに微塵もないのかアレ………？』"
msgstr "(I can't believe what I'm thinking. Is there really nothing wrong with him?)"

#. Occurrence 4_2:1817:3439: scene=4_2
#: 4_2:1817
msgctxt "text_id=3439 | speaker=unknown"
msgid "　ダメな部分は山ほどあるのでとりあえずそこは保留。"
msgstr "  There was plenty, so she left it at that for now."

#. Occurrence 4_2:1822:3440: scene=4_2
#: 4_2:1822
msgctxt "text_id=3440 | speaker=unknown"
msgid "　今まで忙しなく動いていたおでんをつつく箸は、ここで完全に停止した。"
msgstr "  The chopsticks she had been using came to a stop."

#. Occurrence 4_2:1827:3441: scene=4_2
#: 4_2:1827
msgctxt "text_id=3441 | speaker=unknown"
msgid "　なんか、ますますムカつく。"
msgstr "  She was getting very annoyed."

#. Occurrence 4_2:1885:3442: scene=4_2
#: 4_2:1885
msgctxt "text_id=3442 | speaker=unknown"
msgid "　理由のない反感に青子はぐるぐる頭を回す。"
msgstr "  An irrational hatred burned through her head."

#. Occurrence 4_2:1890:3443: scene=4_2
#: 4_2:1890
msgctxt "text_id=3443 | speaker=unknown"
msgid "　それはまずい、自分的にそんなのは許容できない、と必死に静希草十郎を分析するのだが、ますます自分を追いつめるだけだった。"
msgstr "  Unable to come to terms with her feelings, she desperately tried to analyze Soujyuro, but her mind only went in more circles."

#. Occurrence 4_2:1935:3444: scene=4_2
#: 4_2:1935
msgctxt "text_id=3444 | speaker=unknown"
msgid "　そんな袋小路に<陥|おちい>った青子を、有珠はまじまじと眺める。"
msgstr "  Alice fixed Aoko with a deadpan stare."

#. Occurrence 4_2:1946:3445: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0007; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:1946
msgctxt "text_id=3445 | speaker=alice"
msgid "「……あきれた」"
msgstr "\"...I'm shocked.\""

#. Occurrence 4_2:1951:3446: scene=4_2
#: 4_2:1951
msgctxt "text_id=3446 | speaker=unknown"
msgid "　小さな嘆息。"
msgstr "  A small sigh."

#. Occurrence 4_2:2020:3447: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_2_0008; voice_prefix=A40; voice_category=2; scene=4_2
#: 4_2:2020
msgctxt "text_id=3447 | speaker=alice"
msgid "「らしくないわね、青子」"
msgstr "\"This isn't like you, Aoko.\""

#. Occurrence 4_2:2029:3448: scene=4_2
#: 4_2:2029
msgctxt "text_id=3448 | speaker=unknown"
msgid "　その一言は、青子にとってまさにとどめだった。"
msgstr "  Those words were the final blow."

#. Occurrence 4_2:2034:3449: scene=4_2
#: 4_2:2034
msgctxt "text_id=3449 | speaker=unknown"
msgid "　自分の理解不能ぶりに目眩がする。"
msgstr "  Aoko felt the floor fall out from under her."

#. Occurrence 4_2:2066:3450: scene=4_2
#: 4_2:2066
msgctxt "text_id=3450 | speaker=unknown"
msgid "　ご馳走さまと有珠が居間に立ち去った後、しばらく椅子から立てなかった程に。"
msgstr "  She was unable to leave her chair until long after Alice had finished eating and left."

#. Occurrence 4_3:72:3451: scene=4_3
#: 4_3:72
msgctxt "text_id=3451 | speaker=unknown"
msgid "　しかし。"
msgstr "  However..."

#. Occurrence 4_3:77:3452: scene=4_3
#: 4_3:77
msgctxt "text_id=3452 | speaker=unknown"
msgid "　とどめを刺されたからといって、いつまでも伏せっている蒼崎青子ではなかった。"
msgstr "  Even after getting knocked down, Aoko Aozaki was not one to be kept that way."

#. Occurrence 4_3:82:3453: scene=4_3
#: 4_3:82
msgctxt "text_id=3453 | speaker=unknown"
msgid "　早々に夕食の片付けを済ませ、はじめのお風呂を有珠に譲って居間を後にする。"
msgstr "  She made short work of clearing up after dinner and, after conceding the first bath of the night to Alice, left the drawing room."

#. Occurrence 4_3:87:3454: scene=4_3
#: 4_3:87
msgctxt "text_id=3454 | speaker=unknown"
msgid "　洋館では人のいない場所に電灯はつけない決まりなので、明かりがついているのは居間と彼女たちの部屋ぐらいだ。"
msgstr "  Since it was customary in these sorts of mansions to turn the lights off when leaving an empty room, the only lit areas of the house were the drawing room and the two girls' bedrooms."

#. Occurrence 4_3:109:3455: scene=4_3
#: 4_3:109
msgctxt "text_id=3455 | speaker=unknown"
msgid "　二階は暗闇に包まれている。"
msgstr "  The upstairs was enveloped in darkness."

#. Occurrence 4_3:114:3456: scene=4_3
#: 4_3:114
msgctxt "text_id=3456 | speaker=unknown"
msgid "　長い、月明かりだけが頼りの廊下をスタスタと移動して、青子は二階東側の最奥にある自室に辿り着いた。"
msgstr "  Aoko briskly made her way to the deepest part of the east wing along the long corridor, illuminated only by the light of the moon, and arrived at her room."

#. Occurrence 4_3:163:3457: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0000; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:163
msgctxt "text_id=3457 | speaker=aoko"
msgid "「―――結論として。"
msgstr "\"...All being said..."

#. Occurrence 4_3:169:3458: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0001; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:169
msgctxt "text_id=3458 | speaker=aoko"
msgid "　やっぱり、<騙|だま>し<討|う>ちは気にくわない」"
msgstr "  Sneak attacks make me sick to my stomach.\""

#. Occurrence 4_3:193:3459: scene=4_3
#: 4_3:193
msgctxt "text_id=3459 | speaker=unknown"
msgid "　廊下を歩きながら、いや、居間からずっと考えていたのか。"
msgstr "  She had been considering this on the way down the corridor, or perhaps ever since she left the drawing room."

#. Occurrence 4_3:198:3460: scene=4_3
#: 4_3:198
msgctxt "text_id=3460 | speaker=unknown"
msgid "　部屋に入るなり、青子はきっぱりと断言した。"
msgstr "  The moment she entered her room, she drew her proverbial line in the sand."

#. Occurrence 4_3:219:3461: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0002; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:219
msgctxt "text_id=3461 | speaker=aoko"
msgid "「やるにしても隠れるのはなし。正面から堂々と、向かいあって理由を言う」"
msgstr "\"If I'm going to do it, I'm going to do it face to face. I'll give it to him straight.\""

#. Occurrence 4_3:225:3462: scene=4_3
#: 4_3:225
msgctxt "text_id=3462 | speaker=unknown"
msgid "　情けにかられての精一杯の譲歩、ではない。"
msgstr "  This was not a concession driven by feelings of sympathy or compassion."

#. Occurrence 4_3:230:3463: scene=4_3
#: 4_3:230
msgctxt "text_id=3463 | speaker=unknown"
msgid "　単に、彼女にとってそういうあり方が<当然|スタンダード>というだけだ。"
msgstr "  For her, this was simply the way things ought to be."

#. Occurrence 4_3:251:3464: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0003; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:251
msgctxt "text_id=3464 | speaker=aoko"
msgid "「よし、そうと決まれば―――」"
msgstr "\"Okay, with that out of the way...\""

#. Occurrence 4_3:275:3465: scene=4_3
#: 4_3:275
msgctxt "text_id=3465 | speaker=unknown"
msgid "　自分の意志を確認して、隣室の書斎に向かう。"
msgstr "  After settling her resolve, she headed to the study next door."

#. Occurrence 4_3:339:3466: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0004; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:339
msgctxt "text_id=3466 | speaker=aoko"
msgid "「えーと、木曜棚の冬至覧、緑の背表紙、と……」"
msgstr "\"Let's see, Thursday shelf, winter solstice, green spine...\""

#. Occurrence 4_3:345:3467: scene=4_3
#: 4_3:345
msgctxt "text_id=3467 | speaker=unknown"
msgid "　無数の本の中から迷わず一冊を抜き取る。"
msgstr "  Without hesitation, she removed one book from the countless volumes on the shelf."

#. Occurrence 4_3:351:3468: scene=4_3
#: 4_3:351
msgctxt "text_id=3468 | speaker=unknown"
msgid "　蒼崎の家から運びこんだ入門書は、月曜から土曜と六つの<棚|カテゴリ>に振り分けられていた。"
msgstr "  The introductory textbooks transported here from the Aozaki residence were separated into six shelves, labeled Monday to Saturday."

#. Occurrence 4_3:402:3469: scene=4_3
#: 4_3:402
msgctxt "text_id=3469 | speaker=unknown"
msgid "　青子は蔵書を項目、分類、用途に分けておおまかに記憶している。"
msgstr "  Aoko had organized the books by topic, genre, and purpose, and had more or less memorized exactly what was in her personal library."

#. Occurrence 4_3:407:3470: scene=4_3
#: 4_3:407
msgctxt "text_id=3470 | speaker=unknown"
msgid "　必要な知識、資料の検索には時間はとらない。"
msgstr "  Referencing any of this material took her no time at all."

#. Occurrence 4_3:412:3471: scene=4_3
#: 4_3:412
msgctxt "text_id=3471 | speaker=unknown"
msgid "　書斎の主として最低限の務めである。"
msgstr "  It was to be expected from keeper of this study."

#. Occurrence 4_3:432:3472: scene=4_3
#: 4_3:432
msgctxt "text_id=3472 | speaker=unknown"
msgid "　……などと偉ぶっても、所詮はちっぽけな書斎の管理のみ。"
msgstr "  ...Though, this keeper's fiefdom was nothing more than a small room."

#. Occurrence 4_3:437:3473: scene=4_3
#: 4_3:437
msgctxt "text_id=3473 | speaker=unknown"
msgid "　別館にある図書室は青子も有珠もお手上げの魔窟だ。"
msgstr "  Both Aoko and Alice had given up all hope on the cluttered mess of a library in the annex."

#. Occurrence 4_3:442:3474: scene=4_3
#: 4_3:442
msgctxt "text_id=3474 | speaker=unknown"
msgid "　もしこの書斎だけで用が足りないのなら、有珠に声をかけて別館に<赴|おもむ>くしかない。"
msgstr "  Nevertheless, on occasion, Aoko would have no option other than to give Alice a heads-up and visit it when this study did not meet her needs."

#. Occurrence 4_3:488:3475: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0005; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:488
msgctxt "text_id=3475 | speaker=aoko"
msgid "「……できればそれは避けたいところだけど、っと」"
msgstr "\"...I really hope I don't have to go over there now.\""

#. Occurrence 4_3:509:3476: scene=4_3
#: 4_3:509
msgctxt "text_id=3476 | speaker=unknown"
msgid "　緑色の、分厚い装丁の本を机に置いて、椅子に座る。"
msgstr "  Aoko placed the thick, green book down and took a seat."

#. Occurrence 4_3:516:3477: scene=4_3
#: 4_3:516
msgctxt "text_id=3477 | speaker=unknown"
msgid "　頑丈で硬質で温かみのない机。"
msgstr "  The desk she sat at was sturdy but uninviting."

#. Occurrence 4_3:521:3478: scene=4_3
#: 4_3:521
msgctxt "text_id=3478 | speaker=unknown"
msgid "　まだ年若い少女が愛用する物ではないが、青子はこの洗練されすぎて骨しかないような豪華さが好きだった。"
msgstr "  It wasn't the sort of furniture girls her age grew attached to, but she liked its minimalist elegance nonetheless."

#. Occurrence 4_3:527:3479: scene=4_3
#: 4_3:527
msgctxt "text_id=3479 | speaker=unknown"
msgid "　古びた本のページが、その机の上ではらりとめくられる。"
msgstr "  She flipped lightly through the book's old, worn pages."

#. Occurrence 4_3:560:3480: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0006; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:560
msgctxt "text_id=3480 | speaker=aoko"
msgid "『……有珠みたいな結界は私にはまだ無理だ。"
msgstr "(I still can't manage anything like Alice's Bounded Field."

#. Occurrence 4_3:567:3481: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0007; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:567
msgctxt "text_id=3481 | speaker=aoko"
msgid "人払いはその場所自体に頼らないといけないか……』"
msgstr "I guess I'll just have to find a place off the beaten track.)"

#. Occurrence 4_3:573:3482: scene=4_3
#: 4_3:573
msgctxt "text_id=3482 | speaker=unknown"
msgid "　たとえば山奥。"
msgstr "  The mountains?"

#. Occurrence 4_3:578:3483: scene=4_3
#: 4_3:578
msgctxt "text_id=3483 | speaker=unknown"
msgid "　たとえば林中。"
msgstr "  The woods?"

#. Occurrence 4_3:583:3484: scene=4_3
#: 4_3:583
msgctxt "text_id=3484 | speaker=unknown"
msgid "　たとえば、生徒のいない深夜の校舎。"
msgstr "  The school building, empty at night?"

#. Occurrence 4_3:588:3485: scene=4_3
#: 4_3:588
msgctxt "text_id=3485 | speaker=unknown"
msgid "　場所自体に魔術をかけなくても、よっぽど運が悪くないかぎり誰もやってこない場所が望ましい。"
msgstr "  She was looking for a place that would be, except for the worst of luck, void of people, allowing her to forgo the use of magecraft."

#. Occurrence 4_3:615:3486: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0008; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:615
msgctxt "text_id=3486 | speaker=aoko"
msgid "『茨の壁だの魔力の霧だの、そういう回りくどいのもナンだしなあ……退路を断つ、っていうなら、もっとこう、見た目にも状況的にも派手な方が効果的だし』"
msgstr "(Walls of thorns and magical mists are so indirect. If I want to cut off any route of escape, I need someplace... flashy and obvious, both in purpose and in looks.)"

#. Occurrence 4_3:627:3487: scene=4_3
#: 4_3:627
msgctxt "text_id=3487 | speaker=unknown"
msgid "　ぶつぶつと自分好みの、初歩的な術式はないものかとページをめくる青子。"
msgstr "  Muttering about how there had to be some basic spell that fit her needs, she continued to flip through the pages."

#. Occurrence 4_3:632:3488: scene=4_3
#: 4_3:632
msgctxt "text_id=3488 | speaker=unknown"
msgid "　言うまでもなく、彼女が探しているのは昨夜の目撃者を始末する方法だ。"
msgstr "  It goes without saying that she was looking for a way to deal with the witness from the previous night."

#. Occurrence 4_3:667:3489: scene=4_3
#: 4_3:667
msgctxt "text_id=3489 | speaker=unknown"
msgid "　魔術は万能ではあるが有限である。"
msgstr "  Magecraft's uses were many, but not all-encompassing."

#. Occurrence 4_3:683:3490: scene=4_3
#: 4_3:683
msgctxt "text_id=3490 | speaker=unknown"
msgid "　基本的に、<地上|ここ>にある物、<現実|ここ>で起きる事を、実現時間や必要経費を多少無視して発現させるだけのものだ。"
msgstr "  Fundamentally, magecraft was good for making things or phenomena that existed already, while more or less bypassing the time and resources conventional means would require."

#. Occurrence 4_3:688:3491: scene=4_3
#: 4_3:688
msgctxt "text_id=3491 | speaker=unknown"
msgid "　この<宇宙|せかい>で起きえない現象は、魔術では発現できない。"
msgstr "  It was, however, unable to manifest phenomena that were impossible in this world."

#. Occurrence 4_3:693:3492: scene=4_3
#: 4_3:693
msgctxt "text_id=3492 | speaker=unknown"
msgid "　要はショートカットを使いまくった等価交換だ。"
msgstr "  It was essentially an equivalent exchange that used a variety of shortcuts."

#. Occurrence 4_3:713:3493: scene=4_3
#: 4_3:713
msgctxt "text_id=3493 | speaker=unknown"
msgid "　人の手で可能となる現象を、個人の力で実行する―――"
msgstr "  A phenomenon made possible by human hands, actualized by an individual's power―"

#. Occurrence 4_3:713:3494: scene=4_3
#: 4_3:713
msgctxt "text_id=3494 | speaker=unknown"
msgid "　それが一般的な魔術のあり方である。"
msgstr "  that was generally what magecraft was."

#. Occurrence 4_3:718:3495: scene=4_3
#: 4_3:718
msgctxt "text_id=3495 | speaker=unknown"
msgid "　単純な話、その気になれば巨大な湖をこの洋館に持ってくる事もできる。"
msgstr "  To give a simple example, if Aoko were so inclined, she could make an entire lake appear at the mansion."

#. Occurrence 4_3:723:3496: scene=4_3
#: 4_3:723
msgctxt "text_id=3496 | speaker=unknown"
msgid "　けれど、<こ|・><の|・><世|・><に|・><な|・><い|・><も|・><の|・>を持ってくるコトは、たとえ小指の先ほどであろうと許されない。"
msgstr "  However, it had to be something that existed within this world. Nothing, not even the smallest matter, could escape this unbreakable law."

#. Occurrence 4_3:755:3497: scene=4_3
#: 4_3:755
msgctxt "text_id=3497 | speaker=unknown"
msgid "　例えば、青子単体で<戦闘機|Ｆ－１５>のアフターバーナー並みの熱量を放出できたとしても、それは魔術式によって蒼崎青子という回路が一時的に入力の変数になっただけだ。"
msgstr "  Even if Aoko were to release a level of heat on par with an F-15 fighter jet's afterburner, that event would only be possible if the circuit named Aoko Aozaki acted as a temporary input variable in a magical formula."

#. Occurrence 4_3:775:3498: scene=4_3
#: 4_3:775
msgctxt "text_id=3498 | speaker=unknown"
msgid "　導き出されるイコールそのものは、現実に起こりえる数値となる。"
msgstr "  The derived equivalence was simply a value that already occurred in reality."

#. Occurrence 4_3:780:3499: scene=4_3
#: 4_3:780
msgctxt "text_id=3499 | speaker=unknown"
msgid "　だが、そのイコールそのものが現実にないモノである場合、術式は成り立たない。"
msgstr "  If the variable in the equation did not exist elsewhere in reality, the spell would not be valid."

#. Occurrence 4_3:814:3500: scene=4_3
#: 4_3:814
msgctxt "text_id=3500 | speaker=unknown"
msgid "　魔力という架空要素は、発火の瞬間だけ秩序の網をくぐり抜ける嘘のようなもの。"
msgstr "  The imaginary element known as magical energy was like a lie that could only slip its fantasy through the network of order at the moment of ignition."

#. Occurrence 4_3:830:3501: scene=4_3
#: 4_3:830
msgctxt "text_id=3501 | speaker=unknown"
msgid "　この世にないものをカタチにする事―――幻想が現実を侵す事を、この宇宙は容認しない。"
msgstr "  Giving form to the nonexistent--illusions invading reality--was something the universe did not allow."

#. Occurrence 4_3:878:3502: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0009; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:878
msgctxt "text_id=3502 | speaker=aoko"
msgid "『……とは言っても<架|エ><空|ー><要|テ><素|ル>は基本なんにでも<付属|で>きるんで、<大本|おおもと>がウソ、なんだっけ。"
msgstr "(Still, what was it? You can combine the imaginary factor--Ether--with pretty much anything else since it's not real itself...?"

#. Occurrence 4_3:884:3503: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0010; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:884
msgctxt "text_id=3503 | speaker=aoko"
msgid "　魔力だけで構成されたものは幻想扱いされて急速に消えていくとか……典型的な結界、茨の壁とかはもともと茨を生やしておいて、魔力で一気に成長・強化してるものだし。"
msgstr "  Anything composed entirely of magical energy is little more than an illusion and will quickly dissipate. Even a typical field, like a wall of thorns, generally starts with the user planting the thorns first before using magical energy to grow and strengthen them in an instant."

#. Occurrence 4_3:890:3504: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0011; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:890
msgctxt "text_id=3504 | speaker=aoko"
msgid "　魔力っていうのは結局、使い勝手のいいガソリン、兼、事象に火をつける火花ってワケで―――』"
msgstr "  In the end, magical energy is just an easy-to-use fuel source, while acting as a firework that ignites a phenomenon.)"

#. Occurrence 4_3:916:3505: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0012; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:916
msgctxt "text_id=3505 | speaker=aoko"
msgid "「―――なんて言いつつ。"
msgstr "\"...Or so they say."

#. Occurrence 4_3:922:3506: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0013; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:922
msgctxt "text_id=3506 | speaker=aoko"
msgid "　架空要素<云々|うんぬん>より、基本的な回路の接続と、魔力を加工して弾く事ぐらいしかできないのよね、私」"
msgstr "  Imaginary factors are all well and good, but all I can do is connect a basic circuit, and process energy into a projectile.\""

#. Occurrence 4_3:948:3507: scene=4_3
#: 4_3:948
msgctxt "text_id=3507 | speaker=unknown"
msgid "　あはは、と笑って<現|い><状|ま>の自分に作れる結界は何か、と検索する。"
msgstr "  Laughing to herself, she looked for a Bounded Field or something similar more suited to her current ability."

#. Occurrence 4_3:953:3508: scene=4_3
#: 4_3:953
msgctxt "text_id=3508 | speaker=unknown"
msgid "　目撃者の素性は不明だが、相手が同じ高校の生徒なら呼び出す口実はいくらでもある。"
msgstr "  The identity of the witness was still unknown, but if they were a classmate of Aoko's, she had any number of pretexts by which to lure them out."

#. Occurrence 4_3:958:3509: scene=4_3
#: 4_3:958
msgctxt "text_id=3509 | speaker=unknown"
msgid "　問題は呼び出した後だろう。"
msgstr "  The problem was after that."

#. Occurrence 4_3:985:3510: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0014; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:985
msgctxt "text_id=3510 | speaker=aoko"
msgid "『そうなると、問題は命中率よね……。一撃で決めないと逃げられちゃうだろうし』"
msgstr "(Then it becomes a question of precision. If I don't take care of him in one blow, he might slip away.)"

#. Occurrence 4_3:991:3511: scene=4_3
#: 4_3:991
msgctxt "text_id=3511 | speaker=unknown"
msgid "　正直、有珠のサポートなしで上手くやれる自信はない。"
msgstr "  To be honest, she wasn't confident she could handle this smoothly without Alice's support."

#. Occurrence 4_3:996:3512: scene=4_3
#: 4_3:996
msgctxt "text_id=3512 | speaker=unknown"
msgid "　けれど相手が一般人なら自分だけで十分、と青子は助力を一切拒否したのだ。"
msgstr "  But Aoko saw no reason to ask for help given that the target in question was a regular bystander."

#. Occurrence 4_3:1001:3513: scene=4_3
#: 4_3:1001
msgctxt "text_id=3513 | speaker=unknown"
msgid "　半人前ではあるが、青子にも魔術師としてのプライドがある。"
msgstr "  Fledgling as she was, she still had her pride as a mage."

#. Occurrence 4_3:1058:3514: scene=4_3
#: 4_3:1058
msgctxt "text_id=3514 | speaker=unknown"
msgid "　ページはリズムよくめくられていく。"
msgstr "  She continued to turn through the pages rhythmically."

#. Occurrence 4_3:1063:3515: scene=4_3
#: 4_3:1063
msgctxt "text_id=3515 | speaker=unknown"
msgid "　パラパラと小さな音をたてる中、青子の指がぴたりとあるページで止まった。"
msgstr "  In the midst of the fluttering sound of thumbing through the volume, Aoko suddenly stopped her finger at a certain page."

#. Occurrence 4_3:1102:3516: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0015; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1102
msgctxt "text_id=3516 | speaker=aoko"
msgid "「見付けた」"
msgstr "\"Found it.\""

#. Occurrence 4_3:1108:3517: scene=4_3
#: 4_3:1108
msgctxt "text_id=3517 | speaker=unknown"
msgid "　小さな微笑。"
msgstr "  She smiled to herself."

#. Occurrence 4_3:1113:3518: scene=4_3
#: 4_3:1113
msgctxt "text_id=3518 | speaker=unknown"
msgid "　それは記憶の片隅にあった、ただ壊すだけの単純な魔術式。"
msgstr "  It was a simple formula that she had tucked away somewhere in the recesses of her memory. A spell of simple destruction."

#. Occurrence 4_3:1134:3519: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0016; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1134
msgctxt "text_id=3519 | speaker=aoko"
msgid "『……檻をね、作ればいいのよ。"
msgstr "(...A cage. That's all I need to make."

#. Occurrence 4_3:1140:3520: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0017; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1140
msgctxt "text_id=3520 | speaker=aoko"
msgid "　狩りをする時の常套手段じゃない。獲物を逃げられないようにするのは』"
msgstr "  It's the oldest trick in the book that any hunter worth their salt would use.)"

#. Occurrence 4_3:1171:3521: scene=4_3
#: 4_3:1171
msgctxt "text_id=3521 | speaker=unknown"
msgid "　ページに栞を挟んで、部屋に持ち帰ろうと立ち上がる。"
msgstr "  She placed a bookmark in the book, closed it, and got up to return to her room."

#. Occurrence 4_3:1206:3522: scene=4_3
#: 4_3:1206
msgctxt "text_id=3522 | speaker=unknown"
msgid "　ふいに視線を感じた。"
msgstr "  Suddenly she felt someone watching her."

#. Occurrence 4_3:1254:3523: scene=4_3
#: 4_3:1254
msgctxt "text_id=3523 | speaker=unknown"
msgid "　夜を<透|とお>す窓に、冷めきった目の少女が映っている。"
msgstr "  Through the window, she saw her in the night―a girl, staring back with a coldhearted expression."

#. Occurrence 4_3:1259:3524: scene=4_3
#: 4_3:1259
msgctxt "text_id=3524 | speaker=unknown"
msgid "　それが今の自分の<表情|かお>である事を、青子は冷静に受けとめる。"
msgstr "  The girl's face was hers, the expression undoubtedly her own."

#. Occurrence 4_3:1280:3525: scene=4_3
#: 4_3:1280
msgctxt "text_id=3525 | speaker=unknown"
msgid "　―――目撃者を消す計画を立て始めた。"
msgstr "  ...She began planning how to erase the witness."

#. Occurrence 4_3:1286:3526: scene=4_3
#: 4_3:1286
msgctxt "text_id=3526 | speaker=unknown"
msgid "　いや、計画なんて複雑なものではない。"
msgstr "  Though to say it was something as elaborate as a plan was overkill."

#. Occurrence 4_3:1291:3527: scene=4_3
#: 4_3:1291
msgctxt "text_id=3527 | speaker=unknown"
msgid "　これはただの作業。"
msgstr "  This was just a job."

#. Occurrence 4_3:1296:3528: scene=4_3
#: 4_3:1296
msgctxt "text_id=3528 | speaker=unknown"
msgid "　事前に檻を作っておき、そこに獲物を誘うだけの話。"
msgstr "  She was going to make a cage and then lure her prey into it."

#. Occurrence 4_3:1301:3529: scene=4_3
#: 4_3:1301
msgctxt "text_id=3529 | speaker=unknown"
msgid "　まったくもって、何の言い逃れもできない暴力だ。"
msgstr "  There was no getting around it―premeditated violence."

#. Occurrence 4_3:1375:3530: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0018; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1375
msgctxt "text_id=3530 | speaker=aoko"
msgid "「さ、そろそろ有珠は上がったかな」"
msgstr "\"I wonder if Alice is done with her bath.\""

#. Occurrence 4_3:1381:3531: scene=4_3
#: 4_3:1381
msgctxt "text_id=3531 | speaker=unknown"
msgid "　青子は冷めた心に熱を戻すように、どうでもいい独り言を口にした。"
msgstr "  She mumbled out loud, as if the bath would return some warmth to her chilled heart."

#. Occurrence 4_3:1465:3532: scene=4_3
#: 4_3:1465
msgctxt "text_id=3532 | speaker=unknown"
msgid "　有珠にはじめの入浴を譲ってから二十分近く経つ。"
msgstr "  About twenty minutes had passed since she gave Alice the privilege of using the hot water first."

#. Occurrence 4_3:1470:3533: scene=4_3
#: 4_3:1470
msgctxt "text_id=3533 | speaker=unknown"
msgid "　彼女のお風呂はカラスの行水よろしく、十分もあれば終わっている。"
msgstr "  Alice tended to bathe quickly, finishing well under ten minutes."

#. Occurrence 4_3:1475:3534: scene=4_3
#: 4_3:1475
msgctxt "text_id=3534 | speaker=unknown"
msgid "　有珠はお風呂の情緒を理解できないタイプで、風呂はあくまで体のメンテナンスをするものと捉えている。"
msgstr "  Her roommate was the type that could not understand the spirit of the bath, treating it as nothing more than a necessity for looking after one's body."

#. Occurrence 4_3:1480:3535: scene=4_3
#: 4_3:1480
msgctxt "text_id=3535 | speaker=unknown"
msgid "　温泉宿のすばらしさも有珠にとっては“なんか面倒なところ”にすぎず、そのあたりには本気で同情する青子だった。"
msgstr "  For Alice, the concept of staying at a hot spring inn sounded more like a chore than anything, though in this regard Aoko had to agree."

#. Occurrence 4_3:1530:3536: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0019; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1530
msgctxt "text_id=3536 | speaker=aoko"
msgid "「よし、浴場はカラ、と……あれ？　居間に電気ついてる？」"
msgstr "\"I guess it's my time to... Huh? Is that the drawing room light on?\""

#. Occurrence 4_3:1536:3537: scene=4_3
#: 4_3:1536
msgctxt "text_id=3537 | speaker=unknown"
msgid "　入浴を済ませた後、有珠が居間にいるのは珍しい。"
msgstr "  It was unusual for Alice to sit in the drawing room after her bath."

#. Occurrence 4_3:1541:3538: scene=4_3
#: 4_3:1541
msgctxt "text_id=3538 | speaker=unknown"
msgid "　話し合いのない夜は、さっさと自室に戻るのが彼女のスタイルなのだが。"
msgstr "  On nights when she had nothing to discuss, it was her style to return directly to her bedroom."

#. Occurrence 4_3:1593:3539: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0020; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1593
msgctxt "text_id=3539 | speaker=aoko"
msgid "「有珠、いるの？」"
msgstr "\"Alice, are you in here?\""

#. Occurrence 4_3:1603:3540: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0000; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:1603
msgctxt "text_id=3540 | speaker=alice"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 4_3:1608:3541: scene=4_3
#: 4_3:1608
msgctxt "text_id=3541 | speaker=unknown"
msgid "　こくり、と頷く有珠。"
msgstr "  Alice nodded."

#. Occurrence 4_3:1613:3542: scene=4_3
#: 4_3:1613
msgctxt "text_id=3542 | speaker=unknown"
msgid "　読書中でもなく、彼女は青子を待っていたようだ。"
msgstr "  With no book in hand, it appeared that Alice had been waiting for Aoko."

#. Occurrence 4_3:1647:3543: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0021; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1647
msgctxt "text_id=3543 | speaker=aoko"
msgid "『……そういうコト。私も信用ないな、ほんと』"
msgstr "(So that's how it is. She really has no faith in me, does she?)"

#. Occurrence 4_3:1653:3544: scene=4_3
#: 4_3:1653
msgctxt "text_id=3544 | speaker=unknown"
msgid "　はあ、と頭を掻く青子。"
msgstr "  Aoko scratched her head in exasperation."

#. Occurrence 4_3:1658:3545: scene=4_3
#: 4_3:1658
msgctxt "text_id=3545 | speaker=unknown"
msgid "　信用されていないのか、心配されているのか。"
msgstr "  Was it that Alice was worried about her, or had no faith in her?"

#. Occurrence 4_3:1663:3546: scene=4_3
#: 4_3:1663
msgctxt "text_id=3546 | speaker=unknown"
msgid "　久遠寺有珠の表情は静かすぎて、いまいち真意が読み取れない。"
msgstr "  Her expression was so calm Aoko could hardly figure what she was thinking."

#. Occurrence 4_3:1689:3547: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0022; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1689
msgctxt "text_id=3547 | speaker=aoko"
msgid "「方針なら決まったけど。聞く？」"
msgstr "\"I have a plan. Wanna hear it?\""

#. Occurrence 4_3:1709:3548: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0001; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:1709
msgctxt "text_id=3548 | speaker=alice"
msgid "「……その顔を見れば聞かなくても分かるわ。"
msgstr "\"...I can tell what it is by the look on your face."

#. Occurrence 4_3:1720:3549: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0002; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:1720
msgctxt "text_id=3549 | speaker=alice"
msgid "　迷いがなくなったのはいい事だけど。……悪い癖ね、青子」"
msgstr "  It's good that you're no longer wavering, but...you must do something about that tell of yours, Aoko.\""

#. Occurrence 4_3:1726:3550: scene=4_3
#: 4_3:1726
msgctxt "text_id=3550 | speaker=unknown"
msgid "　小さなため息。"
msgstr "  Alice let out a small sigh."

#. Occurrence 4_3:1731:3551: scene=4_3
#: 4_3:1731
msgctxt "text_id=3551 | speaker=unknown"
msgid "　この黒衣の少女がこれみよがしに<落胆|らくたん>を表すのは珍しい。"
msgstr "  It was unusual for Alice to make such a display of her disappointment."

#. Occurrence 4_3:1766:3552: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0023; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1766
msgctxt "text_id=3552 | speaker=aoko"
msgid "「ええ。騙し討ちは趣味じゃないから。殺すにしても正々堂々、正面から理由を言った後にする。"
msgstr "\"I don't like sneaky attacks, so I'm going to do it fairly, and only after I've told him why straight to his face."

#. Occurrence 4_3:1772:3553: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0024; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1772
msgctxt "text_id=3553 | speaker=aoko"
msgid "　それならすっぱり後腐れもないし。文句ある？」"
msgstr "  That way there will be absolutely no trouble later. Any complaints?\""

#. Occurrence 4_3:1790:3554: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0003; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:1790
msgctxt "text_id=3554 | speaker=alice"
msgid "「文句はないわ。そういうの、好きか嫌いかはこの<際|さい>関係ないでしょうし。"
msgstr "\"Why would I have any? This is really only a matter of personal preference, after all."

#. Occurrence 4_3:1801:3555: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0004; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:1801
msgctxt "text_id=3555 | speaker=alice"
msgid "　けど―――」"
msgstr "  However...\""

#. Occurrence 4_3:1840:3556: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0025; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1840
msgctxt "text_id=3556 | speaker=aoko"
msgid "「確実性はどうかってコトでしょ。私、いまいち命中率悪いし。そのへんの問題は場所選びでフォローしようかなと。"
msgstr "\"You're worried that I'll mess up, right? My accuracy hasn't exactly been stellar lately, so I was thinking about how to cover my bases with the location."

#. Occurrence 4_3:1852:3557: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0026; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1852
msgctxt "text_id=3557 | speaker=aoko"
msgid "　私は有珠のようにはいかないから、物理的に逃げられない場所にしようと思うんだけど……なにかアイデアない？」"
msgstr "  I can't throw up a field like you, so I was thinking of doing it somewhere where he physically can't escape. Any ideas?\""

#. Occurrence 4_3:1891:3558: scene=4_3
#: 4_3:1891
msgctxt "text_id=3558 | speaker=unknown"
msgid "　青子からの相談に、そうね、と一考する有珠。"
msgstr "  Alice nodded in thought."

#. Occurrence 4_3:1896:3559: scene=4_3
#: 4_3:1896
msgctxt "text_id=3559 | speaker=unknown"
msgid "　そっと唇にあてた指が、彼女好みの質問だったコトを示している。"
msgstr "  The finger that gently rested on her lips indicated that the question was to her liking."

#. Occurrence 4_3:1922:3560: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0005; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:1922
msgctxt "text_id=3560 | speaker=alice"
msgid "「鏡はどう？　鏡の国なら永遠に閉じこめていられるけど」"
msgstr "\"What about mirrors? You could easily seal him in the house of mirrors for all eternity.\""

#. Occurrence 4_3:1940:3561: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0027; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:1940
msgctxt "text_id=3561 | speaker=aoko"
msgid "「……アンタ、そういうところ常識ないわよね」"
msgstr "\"...Seriously? That's your idea?\""

#. Occurrence 4_3:1950:3562: scene=4_3
#: 4_3:1950
msgctxt "text_id=3562 | speaker=unknown"
msgid "　というか悪趣味、と青子は顔をしかめる。"
msgstr "  She frowned at Alice's bad taste."

#. Occurrence 4_3:1984:3563: scene=4_3
#: 4_3:1984
msgctxt "text_id=3563 | speaker=unknown"
msgid "　同居人なりのクリティカルなアイデアだったのだろうが、とても参考にならない。"
msgstr "  It was the kind of idea her roommate found to be inspired, but Aoko knew was out of the question."

#. Occurrence 4_3:2004:3564: scene=4_3
#: 4_3:2004
msgctxt "text_id=3564 | speaker=unknown"
msgid "　青子は自分に用意できる結界を知りたいのであって、魔法スレスレの大結界など望んでいないし、用意もできないのだ。"
msgstr "  Aoko was looking for a natural Bounded Field she could prepare, not a realm bordering on True Magic that she couldn't create to begin with."

#. Occurrence 4_3:2030:3565: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0006; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:2030
msgctxt "text_id=3565 | speaker=alice"
msgid "「なら他をあたるのね。……でも、ここを使うのだけはやめてちょうだい」"
msgstr "\"Then you'll choose otherwise, I suppose. But please, whatever you do, do not bring him here.\""

#. Occurrence 4_3:2050:3566: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0028; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:2050
msgctxt "text_id=3566 | speaker=aoko"
msgid "「言われなくても分かってるって。"
msgstr "\"You don't need to tell me that."

#. Occurrence 4_3:2062:3567: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0029; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:2062
msgctxt "text_id=3567 | speaker=aoko"
msgid "　あ―――けど、そうね。"
msgstr "  But, actually... Yeah."

#. Occurrence 4_3:2068:3568: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0030; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:2068
msgctxt "text_id=3568 | speaker=aoko"
msgid "　ミラーハウスはいいアイデアかも」"
msgstr "  A house of mirrors might actually work.\""

#. Occurrence 4_3:2096:3569: scene=4_3
#: 4_3:2096
msgctxt "text_id=3569 | speaker=unknown"
msgid "　ニヤリと微笑って、青子は壁に寄りかかっていた体を起こした。"
msgstr "  Aoko smirked and shifted her balance away from the wall she was resting on."

#. Occurrence 4_3:2132:3570: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0031; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:2132
msgctxt "text_id=3570 | speaker=aoko"
msgid "「サンキュ、有珠。全体の流れはできあがったわ。"
msgstr "\"Thanks, Alice. I just figured out the whole plan."

#. Occurrence 4_3:2139:3571: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_3_0032; voice_prefix=A10; voice_category=1; scene=4_3
#: 4_3:2139
msgctxt "text_id=3571 | speaker=aoko"
msgid "ほんと、こういうのってダメもとでも相談してみるものよね」"
msgstr "I guess it's always best to talk to someone when you're in a bind.\""

#. Occurrence 4_3:2167:3572: scene=4_3
#: 4_3:2167
msgctxt "text_id=3572 | speaker=unknown"
msgid "　ご機嫌な様子で立ち去る青子。"
msgstr "  Now in a good mood, Aoko retreated from the drawing room."

#. Occurrence 4_3:2172:3573: scene=4_3
#: 4_3:2172
msgctxt "text_id=3573 | speaker=unknown"
msgid "　どんな青写真ができたのか有珠には見当もつかないが、彼女なりに万全の策ができたらしい。"
msgstr "  Alice tried and failed to visualize what kind of blueprint Aoko had drawn up in her mind, but whatever it was, it appeared to be the thorough kind Aoko was good at."

#. Occurrence 4_3:2203:3574: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0007; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:2203
msgctxt "text_id=3574 | speaker=alice"
msgid "「……………………」"
msgstr "\"...\""

#. Occurrence 4_3:2209:3575: scene=4_3
#: 4_3:2209
msgctxt "text_id=3575 | speaker=unknown"
msgid "　鼻歌まじりに浴場に向かう同居人。"
msgstr "  Aoko headed for the bathroom, humming to herself as she went."

#. Occurrence 4_3:2214:3576: scene=4_3
#: 4_3:2214
msgctxt "text_id=3576 | speaker=unknown"
msgid "　ここ一年半の経験か。"
msgstr "  A year and a half of sharing a living space had taught Alice something:"

#. Occurrence 4_3:2219:3577: scene=4_3
#: 4_3:2219
msgctxt "text_id=3577 | speaker=unknown"
msgid "　黒衣の少女は、蒼崎青子は有頂天になった時こそ信じられないトラブルに見舞われる事を知っていた。"
msgstr "  When Aoko Aozaki was in this good of a mood, only deep trouble could follow."

#. Occurrence 4_3:2274:3578: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0008; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:2274
msgctxt "text_id=3578 | speaker=alice"
msgid "「え？　……青子ひとりに<任|まか>せていいのか、ですって？」"
msgstr "\"Hm? You want to know if I'm okay with letting Aoko handle this on her own?\""

#. Occurrence 4_3:2287:3579: scene=4_3
#: 4_3:2287
msgctxt "text_id=3579 | speaker=unknown"
msgid "　いつから居間にいたのか。"
msgstr "  It was unclear how long the bird had been in the drawing room."

#. Occurrence 4_3:2293:3580: scene=4_3
#: 4_3:2293
msgctxt "text_id=3580 | speaker=unknown"
msgid "　コマドリ……のような鳥が、チチチ、と鳴き声をあげながら調度品の上を<闊歩|かっぽ>する。"
msgstr "  Chirping at Alice, the... robin-like bird pranced across the furniture as if it were its property. "

#. Occurrence 4_3:2319:3581: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0009; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:2319
msgctxt "text_id=3581 | speaker=alice"
msgid "「……そうね。彼女がひとりでやると言ったのだから、任せるのが正しい信頼関係なんでしょうけど―――」"
msgstr "\"...Yes, I suppose. She said that she wanted to do it alone, and I do want her to know she has my every faith. Still...\""

#. Occurrence 4_3:2325:3582: scene=4_3
#: 4_3:2325
msgctxt "text_id=3582 | speaker=unknown"
msgid "　黒衣の少女の腕があがる。"
msgstr "  The girl in black raised her arm."

#. Occurrence 4_3:2380:3583: scene=4_3
#: 4_3:2380
msgctxt "text_id=3583 | speaker=unknown"
msgid "　口づけを許すように差し出された指先に、チチチ、と鳴き声が舞い降りる。"
msgstr "  The bird, chirping once again, alighted on her outstretched, affectionate finger."

#. Occurrence 4_3:2387:3584: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0010; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:2387
msgctxt "text_id=3584 | speaker=alice"
msgid "「……嫌な話だけど。"
msgstr "\"Suffice to say..."

#. Occurrence 4_3:2394:3585: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_3_0011; voice_prefix=A40; voice_category=2; scene=4_3
#: 4_3:2394
msgctxt "text_id=3585 | speaker=alice"
msgid "信頼と信用は、また違う話よね」"
msgstr "Trust and faith are two very different things.\""

#. Occurrence 4_3:2401:3586: scene=4_3
#: 4_3:2401
msgctxt "text_id=3586 | speaker=unknown"
msgid "　<言|こえ>なき鳥が、そのでっぷりとした胸を張って同意する。"
msgstr "  The bird puffed out its stout chest in agreement."

#. Occurrence 4_3:2406:3587: scene=4_3
#: 4_3:2406
msgctxt "text_id=3587 | speaker=unknown"
msgid "　わりかし物騒な同居人の<囁|ささや>きを、もちろん、青子は知るよしもないのだった。"
msgstr "  And Aoko was none the wiser to her roommate's rather unsettling comments."

#. Occurrence 4_4:97:3588: scene=4_4
#: 4_4:97
msgctxt "text_id=3588 | speaker=unknown"
msgid "　翌日。空は相変わらずの曇り模様。"
msgstr "  The following day was a typically overcast one."

#. Occurrence 4_4:119:3589: scene=4_4
#: 4_4:119
msgctxt "text_id=3589 | speaker=unknown"
msgid "　一日の授業は何事もなく終わった。"
msgstr "  The day's classes ended as they had started: uneventfully."

#. Occurrence 4_4:124:3590: scene=4_4
#: 4_4:124
msgctxt "text_id=3590 | speaker=unknown"
msgid "　冬休み前の期末試験まであとわずか。"
msgstr "  Winter break was just around the corner, and with it, final exams."

#. Occurrence 4_4:129:3591: scene=4_4
#: 4_4:129
msgctxt "text_id=3591 | speaker=unknown"
msgid "　今では厳しい規律に支配された<三咲高|ミサコー>であるが、もともとは生徒の自主性を第一とするおおらかな私立高校である。"
msgstr "  Although Misaki High prided itself on discipline, it was still a private school which promoted a culture of independence among its students."

#. Occurrence 4_4:149:3592: scene=4_4
#: 4_4:149
msgctxt "text_id=3592 | speaker=unknown"
msgid "　真面目な生徒は生徒会長の<庇|ひ><護|ご>の下とことん真面目に。"
msgstr "  Industrious students had a place to explore that side of themselves under the guardianship of the student council president."

#. Occurrence 4_4:154:3593: scene=4_4
#: 4_4:154
msgctxt "text_id=3593 | speaker=unknown"
msgid "　気楽な生徒は、まあ個人の責任のかぎり、とことん自由に放課後を過ごしているのだった。"
msgstr "  More easygoing students could spend their time after school as they wished, as long as they were mindful of personal responsibility."

#. Occurrence 4_4:174:3594: scene=4_4
#: 4_4:174
msgctxt "text_id=3594 | speaker=unknown"
msgid "　そして、その自由な生徒の代表みたいな男が生徒会の副会長にいるあたり、この学校の懐の深さはちょっとおかしい。"
msgstr "  The fact that the poster boy of independence was the student council vice president indicated just how vast the spectrum was."

#. Occurrence 4_4:225:3595: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0000; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:225
msgctxt "text_id=3595 | speaker=tobimaru"
msgid "「蒼崎、いるかー！」"
msgstr "\"Aozaki, you in here?\""

#. Occurrence 4_4:254:3596: scene=4_4
#: 4_4:254
msgctxt "text_id=3596 | speaker=unknown"
msgid "　おもに密会用と噂される第二生徒会室の扉を、<槻司|つきじ><鳶丸|とびまる>は陽気にブチ開けた。"
msgstr "  Tobimaru Tsukiji threw open the door to the satellite student council room, the rumored location for their secret meetings."

#. Occurrence 4_4:259:3597: scene=4_4
#: 4_4:259
msgctxt "text_id=3597 | speaker=unknown"
msgid "　これでも副会長さまであり、生徒会の<陰|かげ>の雑務係と哀れまれる人物である。"
msgstr "  Despite all appearances, he was the student council vice president, who also happened to be the poor soul responsible for executing the student council's dirty work."

#. Occurrence 4_4:294:3598: scene=4_4
#: 4_4:294
msgctxt "text_id=3598 | speaker=unknown"
msgid "　狭苦しい室内には待ち人がひとり。"
msgstr "  One person was waiting for him in the cramped room."

#. Occurrence 4_4:299:3599: scene=4_4
#: 4_4:299
msgctxt "text_id=3599 | speaker=unknown"
msgid "　生徒会長・蒼崎青子は姿勢良くパイプ椅子に座って、大声を上げた鳶丸をじろりと睨んでいる。"
msgstr "  The student council president, Aoko Aozaki, sat imperiously in a folding chair, glaring at Tobimaru and his boisterous entrance."

#. Occurrence 4_4:344:3600: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0001; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:344
msgctxt "text_id=3600 | speaker=tobimaru"
msgid "「あいかわらず寒いなこの部屋。"
msgstr "\"This room is freezing, as usual."

#. Occurrence 4_4:344:3601: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0001; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:344
msgctxt "text_id=3601 | speaker=tobimaru"
msgid "　なあ、今度ストーブ購入しようぜ」"
msgstr "  We really need to buy a heater.\""

#. Occurrence 4_4:350:3602: scene=4_4
#: 4_4:350
msgctxt "text_id=3602 | speaker=unknown"
msgid "　青子の無言の圧迫に負けないように、鳶丸は何気なく会話を切り出した。"
msgstr "  So as not to succumb to Aoko's oppressive silence, Tobimaru opened with some casual small talk."

#. Occurrence 4_4:396:3603: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0000; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:396
msgctxt "text_id=3603 | speaker=aoko"
msgid "「お疲れさま。ところでアンタ、何しに来たのか分かってる？」"
msgstr "\"Thank you for coming. Let's get down to business. Do you know why I've asked you here?\""

#. Occurrence 4_4:419:3604: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0002; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:419
msgctxt "text_id=3604 | speaker=tobimaru"
msgid "「まあな。ただ、事務的に話すのって寒いじゃねえか。"
msgstr "\"I have an idea. What's up with the formality, Aozaki?"

#. Occurrence 4_4:425:3605: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0003; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:425
msgctxt "text_id=3605 | speaker=tobimaru"
msgid "　少しぐらい世間話でもしねえとつまらねえだろ？」"
msgstr "  Pretty cold to talk shop right away all the time, you know?\""

#. Occurrence 4_4:452:3606: scene=4_4
#: 4_4:452
msgctxt "text_id=3606 | speaker=unknown"
msgid "　鳶丸は扉を閉めて、青子の前の椅子に座った。"
msgstr "  Tobimaru closed the door and sat down across from Aoko."

#. Occurrence 4_4:457:3607: scene=4_4
#: 4_4:457
msgctxt "text_id=3607 | speaker=unknown"
msgid "　その手には青い封筒を抱えている。"
msgstr "  He was holding a blue envelope."

#. Occurrence 4_4:501:3608: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0001; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:501
msgctxt "text_id=3608 | speaker=aoko"
msgid "「こういう時は無駄口はたたかない方がいいわよ。"
msgstr "\"Yeah, and loose lips sink ships."

#. Occurrence 4_4:507:3609: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0002; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:507
msgctxt "text_id=3609 | speaker=aoko"
msgid "　なんとなくプロっぽいでしょ」"
msgstr "  Might remember that once you get out into the real world.\""

#. Occurrence 4_4:513:3610: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0004; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:513
msgctxt "text_id=3610 | speaker=tobimaru"
msgid "「なる―――いや、いやいやいや」"
msgstr "\"All right, I'll remem―wait a sec. Nice try.\""

#. Occurrence 4_4:534:3611: scene=4_4
#: 4_4:534
msgctxt "text_id=3611 | speaker=unknown"
msgid "　青子の刺々しい返答にそうかも、と同意しかけて、鳶丸はイヤイヤと首を振った。"
msgstr "  Tobimaru was halfway to agreeing with Aoko before he caught himself and began to shake his head."

#. Occurrence 4_4:539:3612: scene=4_4
#: 4_4:539
msgctxt "text_id=3612 | speaker=unknown"
msgid "　いくらフリーダムな鳶丸でも、そんな諜報員めいた日常は<御免|ごめん><蒙|こうむ>る。"
msgstr "  As much as Tobimaru enjoyed the lack of red tape in his new line of work, he was not ready to turn full spy on his first day on the job."

#. Occurrence 4_4:566:3613: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0003; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:566
msgctxt "text_id=3613 | speaker=aoko"
msgid "「それで、調べ終わったの？」"
msgstr "\"So then. Are you done with your investigation?\""

#. Occurrence 4_4:578:3614: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0005; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:578
msgctxt "text_id=3614 | speaker=tobimaru"
msgid "「ああ。ついさっき最後の聴取を済ませてきた。"
msgstr "\"Yeah. I finished the last interview just now."

#. Occurrence 4_4:584:3615: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0006; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:584
msgctxt "text_id=3615 | speaker=tobimaru"
msgid "　詳しい事はその封筒に入ってる。おまえから渡された例のファイルも、そん中」"
msgstr "  The details are in the envelope along with the file you gave me.\""

#. Occurrence 4_4:629:3616: scene=4_4
#: 4_4:629
msgctxt "text_id=3616 | speaker=unknown"
msgid "　ぱさり、と机に置かれる青封筒。"
msgstr "  He tossed the envelope onto the table."

#. Occurrence 4_4:660:3617: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0004; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:660
msgctxt "text_id=3617 | speaker=aoko"
msgid "「そう」"
msgstr "\"Good.\""

#. Occurrence 4_4:719:3618: scene=4_4
#: 4_4:719
msgctxt "text_id=3618 | speaker=unknown"
msgid "　青子は封筒を手にし、中の書類に目を通す。"
msgstr "  Aoko picked it up and began to scan through the documents that were inside."

#. Occurrence 4_4:724:3619: scene=4_4
#: 4_4:724
msgctxt "text_id=3619 | speaker=unknown"
msgid "　そこからは完全に彼女ひとりの世界で、鳶丸に対して気を配ってさえいない。"
msgstr "  She entered her own little world, not sparing the slightest bit of attention for Tobimaru."

#. Occurrence 4_4:729:3620: scene=4_4
#: 4_4:729
msgctxt "text_id=3620 | speaker=unknown"
msgid "　歯に<衣|きぬ>着せずに言えば、パーフェクトなまでの無視っぷりである。"
msgstr "  If ignoring other people were a skill, she would be a master at it."

#. Occurrence 4_4:808:3621: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0007; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:808
msgctxt "text_id=3621 | speaker=tobimaru"
msgid "「………………なあ」"
msgstr "\"...Ahem.\""

#. Occurrence 4_4:814:3622: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0005; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:814
msgctxt "text_id=3622 | speaker=aoko"
msgid "「なに？」"
msgstr "\"What?\""

#. Occurrence 4_4:820:3623: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0008; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:820
msgctxt "text_id=3623 | speaker=tobimaru"
msgid "「ひとつ、聞きたいんだけどよ」"
msgstr "\"I just wanted to ask one thing.\""

#. Occurrence 4_4:832:3624: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0006; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:832
msgctxt "text_id=3624 | speaker=aoko"
msgid "「だから、なに？」"
msgstr "\"Yeah, and?\""

#. Occurrence 4_4:859:3625: scene=4_4
#: 4_4:859
msgctxt "text_id=3625 | speaker=unknown"
msgid "　冷えきった沈黙。"
msgstr "  The room was filled with a chilling silence."

#. Occurrence 4_4:864:3626: scene=4_4
#: 4_4:864
msgctxt "text_id=3626 | speaker=unknown"
msgid "　無感情に書類をチェックする青子と、"
msgstr "  Aoko continued reading without an ounce of emotion upon her face."

#. Occurrence 4_4:869:3627: scene=4_4
#: 4_4:869
msgctxt "text_id=3627 | speaker=unknown"
msgid "　そんな青子をどうでもよさげに、しかし正面から見据える鳶丸。"
msgstr "  Though Tobimaru kept up an air of indifference, his stare remained fixed intently on her."

#. Occurrence 4_4:890:3628: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0009; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:890
msgctxt "text_id=3628 | speaker=tobimaru"
msgid "「蒼崎、そういうの作って楽しい？」"
msgstr "\"Do you get a kick out of doing this kind of thing, Aozaki?\""

#. Occurrence 4_4:947:3629: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0007; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:947
msgctxt "text_id=3629 | speaker=aoko"
msgid "「楽しいワケないでしょ。こんなの、作ったところであんまり使う機会なんてないんだから」"
msgstr "\"Of course not. What's so fun about gathering intel I hardly even get to use?\""

#. Occurrence 4_4:981:3630: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0010; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:981
msgctxt "text_id=3630 | speaker=tobimaru"
msgid "「そうか。ならいい」"
msgstr "\"Riiight. Just wanted to check.\""

#. Occurrence 4_4:989:3631: scene=4_4
#: 4_4:989
msgctxt "text_id=3631 | speaker=unknown"
msgid "　納得いったのか、<憮然|ぶぜん>顔のまま鳶丸は席を立った。"
msgstr "  Whether or not he was convinced, Tobimaru stood up from his chair with a disappointed expression."

#. Occurrence 4_4:1024:3632: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0011; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:1024
msgctxt "text_id=3632 | speaker=tobimaru"
msgid "「最後まで読めば分かるだろうが、あんまり確証は取れなかったぜ。"
msgstr "\"You'll figure this out just by reading it all, but I wasn't able to dig up anything conclusive."

#. Occurrence 4_4:1031:3633: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0012; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:1031
msgctxt "text_id=3633 | speaker=tobimaru"
msgid "というより、一昨日あの辺りにいた生徒はいないって話になりそうだ。ま、断定はできないけどな」"
msgstr "By all indications, that there weren't any students in the area the day before yesterday. It's not like I can say that for sure, though.\""

#. Occurrence 4_4:1082:3634: scene=4_4
#: 4_4:1082
msgctxt "text_id=3634 | speaker=unknown"
msgid "　鳶丸はつれない態度でドアに向かう。"
msgstr "  No longer concerned over his task, Tobimaru headed toward the door,"

#. Occurrence 4_4:1087:3635: scene=4_4
#: 4_4:1087
msgctxt "text_id=3635 | speaker=unknown"
msgid "　俺はこの件には無関係です、と言わんばかりだ。"
msgstr "  as if to say it was out of his hands."

#. Occurrence 4_4:1137:3636: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0013; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:1137
msgctxt "text_id=3636 | speaker=tobimaru"
msgid "「―――っと、そうだ。"
msgstr "\"...Oh, and one more thing."

#. Occurrence 4_4:1143:3637: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0014; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:1143
msgctxt "text_id=3637 | speaker=tobimaru"
msgid "　そういえば一人だけ該当しなかった奴がいる。季節外れの転入生までは、蒼崎も調べきれなかったみてえじゃねぇか」"
msgstr "  There was one student that wasn't included in your dragnet. You forgot to include any out-of-term transfers.\""

#. Occurrence 4_4:1187:3638: scene=4_4
#: 4_4:1187
msgctxt "text_id=3638 | speaker=unknown"
msgid "　わずかに顔をあげる青子。"
msgstr "  Aoko raised her head ever so slightly."

#. Occurrence 4_4:1192:3639: scene=4_4
#: 4_4:1192
msgctxt "text_id=3639 | speaker=unknown"
msgid "　たしかに転入したばかりの生徒は彼女の調査範囲に含まれてはいない。"
msgstr "  He was right. The recent transfer student was not included within the scope of her investigation."

#. Occurrence 4_4:1213:3640: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0015; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:1213
msgctxt "text_id=3640 | speaker=tobimaru"
msgid "「そんなわけで草の字に関しては調べてないぜ。"
msgstr "\"So I haven't looked at Sono-G."

#. Occurrence 4_4:1219:3641: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_4_4_0016; voice_prefix=B70; voice_category=4; scene=4_4
#: 4_4:1219
msgctxt "text_id=3641 | speaker=tobimaru"
msgid "　ま、アイツならいつだろうと遅くまでバイトだろうが……いや、人殺しを見た、なんてコト口走ってるようじゃ、家で悪い夢でも見てたのかもしれねえか」"
msgstr "  Though, considering it's him, it's safe to assume that he was working late. Or, wait, it would be if he hadn't have mentioned something about... seeing a murder or whatever. I told him that it was probably just a bad dream.\""

#. Occurrence 4_4:1256:3642: scene=4_4
#: 4_4:1256
msgctxt "text_id=3642 | speaker=unknown"
msgid "　鳶丸は陽気にこぼして去っていった。"
msgstr "  Tobimaru cheerfully left the student council room."

#. Occurrence 4_4:1291:3643: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0008; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:1291
msgctxt "text_id=3643 | speaker=aoko"
msgid "「―――、は？」"
msgstr "\"...What?\""

#. Occurrence 4_4:1297:3644: scene=4_4
#: 4_4:1297
msgctxt "text_id=3644 | speaker=unknown"
msgid "　同時に、青子は持っていた書類を机に落とした。"
msgstr "  Simultaneously, Aoko felt her fingers go numb,"

#. Occurrence 4_4:1302:3645: scene=4_4
#: 4_4:1302
msgctxt "text_id=3645 | speaker=unknown"
msgid "　別にそんなつもりはなかったのに、なぜか、指先から力が失われてしまったらしい。"
msgstr "  and the documents she was holding spilled all over the table."

#. Occurrence 4_4:1353:3646: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0009; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:1353
msgctxt "text_id=3646 | speaker=aoko"
msgid "「……そんな、まさかね」"
msgstr "\"It can't be. That's not possible...\""

#. Occurrence 4_4:1359:3647: scene=4_4
#: 4_4:1359
msgctxt "text_id=3647 | speaker=unknown"
msgid "　考えすぎだ、と自分に対して軽口を言ってみる。"
msgstr "  She broke out into a cold sweat and tried to tell herself that there must be some kind of mistake."

#. Occurrence 4_4:1364:3648: scene=4_4
#: 4_4:1364
msgctxt "text_id=3648 | speaker=unknown"
msgid "　けれど突然生まれた不安は消えず、こういう時の自分の直感がたいてい合っている事を、蒼崎青子は知っていた。"
msgstr "  However, the uncomfortable feeling in her gut would simply not go away. Perhaps because her intuition was almost always right at times like these."

#. Occurrence 4_4:1456:3649: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0010; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:1456
msgctxt "text_id=3649 | speaker=aoko"
msgid "「―――馬鹿らしい」"
msgstr "\"...You gotta be kidding me.\""

#. Occurrence 4_4:1462:3650: scene=4_4
#: 4_4:1462
msgctxt "text_id=3650 | speaker=unknown"
msgid "　だとしてもやる事は同じだ。"
msgstr "  And yet, she knew what she had to do."

#. Occurrence 4_4:1467:3651: scene=4_4
#: 4_4:1467
msgctxt "text_id=3651 | speaker=unknown"
msgid "　仮に目撃者が鳶丸だった場合、青子は<躊躇|ためら>わず殺せるだろう。"
msgstr "  She would not have hesitated to kill Tobimaru if he had been the witness."

#. Occurrence 4_4:1472:3652: scene=4_4
#: 4_4:1472
msgctxt "text_id=3652 | speaker=unknown"
msgid "　けれど、それが彼だったら？"
msgstr "  But what if it was who she was thinking of?"

#. Occurrence 4_4:1477:3653: scene=4_4
#: 4_4:1477
msgctxt "text_id=3653 | speaker=unknown"
msgid "　そんな『もしも』を連想した途端、どんな仮定より冷めきっていく自分を感じた。"
msgstr "  Just considering the possibility caused her blood to run cold."

#. Occurrence 4_4:1514:3654: scene=4_4
#: 4_4:1514
msgctxt "text_id=3654 | speaker=unknown"
msgid "　青子は額に手を当てて考えこむ。"
msgstr "  Aoko put her forehead in her hands and began to brood."

#. Occurrence 4_4:1519:3655: scene=4_4
#: 4_4:1519
msgctxt "text_id=3655 | speaker=unknown"
msgid "　そうして唐突に、"
msgstr "  And then, suddenly―"

#. Occurrence 4_4:1579:3656: scene=4_4
#: 4_4:1579
msgctxt "text_id=3656 | speaker=unknown"
msgid "「選択の話をしよう。おまえは常に二者択一を迫られる。"
msgstr "\"Let us talk choice. You will always be faced with choices."

#. Occurrence 4_4:1584:3657: scene=4_4
#: 4_4:1584
msgctxt "text_id=3657 | speaker=unknown"
msgid "　善良な愚者と醜悪な賢者。すべてを救う手段はない。どちらかを選ぶこと。それだけが、おまえに許された自由となる」"
msgstr "  A virtuous fool and a wicked sage. You cannot save both. You must pick one. That is the freedom granted to you.\""

#. Occurrence 4_4:1644:3658: scene=4_4
#: 4_4:1644
msgctxt "text_id=3658 | speaker=unknown"
msgid "　二年前。"
msgstr "  Two years earlier."

#. Occurrence 4_4:1649:3659: scene=4_4
#: 4_4:1649
msgctxt "text_id=3659 | speaker=unknown"
msgid "　姉に代わって後継ぎになった日に祖父から贈られた言葉を呟いて、青子は小さく嘆息した。"
msgstr "  Aoko muttered the words offered by her grandfather the day she replaced her elder sister as his successor, and let out a sigh of lament."

#. Occurrence 4_4:1656:3660: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0011; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:1656
msgctxt "text_id=3660 | speaker=aoko"
msgid "「―――すごく、バカみたい」"
msgstr "\"...This has to be a joke.\""

#. Occurrence 4_4:1670:3661: scene=4_4
#: 4_4:1670
msgctxt "text_id=3661 | speaker=unknown"
msgid "　自分の勘の良さに<嗤|わら>ってしまう。"
msgstr "  She laughed at her own intuition."

#. Occurrence 4_4:1676:3662: scene=4_4
#: 4_4:1676
msgctxt "text_id=3662 | speaker=unknown"
msgid "　本当。"
msgstr "  But it was no joke."

msgctxt "text_id=3663 | speaker=unknown"
msgid "そんな台詞、口にしなければよかったのにと。"
msgstr " If only those words had never been said."

#. Occurrence 4_4:1776:3664: scene=4_4
#: 4_4:1776
msgctxt "text_id=3664 | speaker=unknown"
msgid "　青子は戸締まりを済ませ、生徒会室を後にした。"
msgstr "  Aoko locked up the student council room and left for the day."

#. Occurrence 4_4:1781:3665: scene=4_4
#: 4_4:1781
msgctxt "text_id=3665 | speaker=unknown"
msgid "　平然と、それこそ何もなかったようにすれ違う生徒たちと挨拶を交わせるあたり、自分らしいと呆れながら。"
msgstr "  Calmly, as though nothing untoward had happened, she greeted the students as they passed her in the halls. She was almost shocked by how natural she seemed."

#. Occurrence 4_4:1830:3666: scene=4_4
#: 4_4:1830
msgctxt "text_id=3666 | speaker=unknown"
msgid "　学校にはまだ活気がある。"
msgstr "  There were still plenty of students at the school."

#. Occurrence 4_4:1835:3667: scene=4_4
#: 4_4:1835
msgctxt "text_id=3667 | speaker=unknown"
msgid "　部活動の生徒は言うに及ばず、用を済ませて下校していく生徒たちの話し声で校庭は騒がしい。"
msgstr "  The grounds were noisy with the chattering of students who had finished the day but had yet to head home. Others still had club activities."

#. Occurrence 4_4:1840:3668: scene=4_4
#: 4_4:1840
msgctxt "text_id=3668 | speaker=unknown"
msgid "　今にも泣きだしそうな灰色の空だが、彼らにはさして気になる問題ではないようだ。"
msgstr "  The gray sky looked ready to pour, but nobody seemed to pay it any mind."

#. Occurrence 4_4:1887:3669: scene=4_4
#: 4_4:1887
msgctxt "text_id=3669 | speaker=unknown"
msgid "　そんな喧噪にまじって、青子は早足で校門に向かう。"
msgstr "  Amidst the clamor, Aoko hastened to the school gate."

#. Occurrence 4_4:1892:3670: scene=4_4
#: 4_4:1892
msgctxt "text_id=3670 | speaker=unknown"
msgid "　お<喋|しゃべ>りに花を咲かす生徒たちを通りすぎる。"
msgstr "  She passed by some students in animated conversation."

#. Occurrence 4_4:1897:3671: scene=4_4
#: 4_4:1897
msgctxt "text_id=3671 | speaker=unknown"
msgid "　会話の内容は放課後の予定について。"
msgstr "  They seemed to be talking about their after-school plans."

#. Occurrence 4_4:1903:3672: scene=4_4
#: 4_4:1903
msgctxt "text_id=3672 | speaker=unknown"
msgid "いかに無駄なく充実した放課後を過ごすかを真剣に論じている。"
msgstr "Apparently, they were adamant about maximizing their free time."

#. Occurrence 4_4:1923:3673: scene=4_4
#: 4_4:1923
msgctxt "text_id=3673 | speaker=unknown"
msgid "　彼らが持つ、<遮二無二|しゃにむに>に遊ぼうという気は知れないけど、馬鹿にする気も、羨ましがる気持ちも青子にはない。"
msgstr "  She could not figure how they could possibly be so irresponsibly focused on fun, but at the same time was in no mood to make fun of or feel envious of them."

#. Occurrence 4_4:1928:3674: scene=4_4
#: 4_4:1928
msgctxt "text_id=3674 | speaker=unknown"
msgid "　ほんの二年前まで、そういった自由を心から愛していた自分がいたとしてもだ。"
msgstr "  Two short years prior, she had been just like them."

#. Occurrence 4_4:1949:3675: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0012; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:1949
msgctxt "text_id=3675 | speaker=aoko"
msgid "『……根は冷めてるのかな、私って』"
msgstr "(I wonder if I'm becoming desensitized to it all.)"

#. Occurrence 4_4:1955:3676: scene=4_4
#: 4_4:1955
msgctxt "text_id=3676 | speaker=unknown"
msgid "　マフラーをきつめに締めてみたが、それで孤独を漂わせるにはまだ経験が少なかった。"
msgstr "  She re-tied her scarf, this time more tightly, to give off an air of solitude, but she was fooling no one."

#. Occurrence 4_4:1960:3677: scene=4_4
#: 4_4:1960
msgctxt "text_id=3677 | speaker=unknown"
msgid "　そもそも淋しいと思わない人間が孤独を装っても、それは孤独ではなく拒絶と言うのだ。"
msgstr "  After all, what people who feign solitude are really masking is rejection."

#. Occurrence 4_4:1981:3678: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0013; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:1981
msgctxt "text_id=3678 | speaker=aoko"
msgid "『……そうよね。孤独っていうのはああいうのを言うもんでしょうし』"
msgstr "(Solitude, rejection... They're two sides of the same coin.)"

#. Occurrence 4_4:1989:3679: scene=4_4
#: 4_4:1989
msgctxt "text_id=3679 | speaker=unknown"
msgid "　校門はいつもより騒がしい。"
msgstr "  The area by the school gate was busier than usual."

#. Occurrence 4_4:1994:3680: scene=4_4
#: 4_4:1994
msgctxt "text_id=3680 | speaker=unknown"
msgid "　原因は校門の陰で立往生をしている男子生徒たちだ。"
msgstr "  A group of boys appeared to be huddled behind it."

#. Occurrence 4_4:1999:3681: scene=4_4
#: 4_4:1999
msgctxt "text_id=3681 | speaker=unknown"
msgid "　寄り添って密談をしている彼らは、校門の陰に隠れて、表通りに立っている一人の少女について、ざわざわと論じあっていた。"
msgstr "  Their transparent attempt to be discreet in terms of both location and loudness of voices did nothing to hide the fact that they were noisily arguing about a girl standing alone on the other side of the street."

#. Occurrence 4_4:2079:3682: scene=4_4
#: 4_4:2079
msgctxt "text_id=3682 | speaker=unknown"
msgid "　少女は黒いケープに身を包んでいた。"
msgstr "  The girl was cloaked in a black cape."

#. Occurrence 4_4:2084:3683: scene=4_4
#: 4_4:2084
msgctxt "text_id=3683 | speaker=unknown"
msgid "　一見すると普段着だが、三咲町の人間なら、ケープ下の服がとある名門女子校の制服である事を知っている。"
msgstr "  At first glance it could have been mistaken for normal attire, but those from Misaki could tell that she wore the uniform of a prestigious girls' school."

#. Occurrence 4_4:2089:3684: scene=4_4
#: 4_4:2089
msgctxt "text_id=3684 | speaker=unknown"
msgid "　もっとも、その女学院は三咲高校とは縁もゆかりもない、距離的にも精神的にも遠く離れた存在である。"
msgstr "  Said school had no connection to Misaki High in any way, shape, or form. The two schools were miles apart both physically and spiritually."

#. Occurrence 4_4:2109:3685: scene=4_4
#: 4_4:2109
msgctxt "text_id=3685 | speaker=unknown"
msgid "　彼女達の大半は寮生活を強いられており、町中で見かける事は滅多にない。"
msgstr "  A member of that school's student body was a rare sighting, as the majority were forced to live in the school dorm."

#. Occurrence 4_4:2114:3686: scene=4_4
#: 4_4:2114
msgctxt "text_id=3686 | speaker=unknown"
msgid "　お嬢様学園と名こそ響いているが、実際にはそうお目にかかれない礼園女学院の制服だ。"
msgstr "  Reien Girls Academy had a reputation as a school for princesses, and it was rare indeed for one to be slumming with the common folk."

#. Occurrence 4_4:2134:3687: scene=4_4
#: 4_4:2134
msgctxt "text_id=3687 | speaker=unknown"
msgid "　それだけで男どもが騒ぎ立てるには十分だが、くわえて、その少女は上等すぎた。"
msgstr "  That alone would have been enough to cause the ruckus among the boys, but this girl looked the epitome of class."

#. Occurrence 4_4:2154:3688: scene=4_4
#: 4_4:2154
msgctxt "text_id=3688 | speaker=unknown"
msgid "　可憐としか言いようのない立ち姿。"
msgstr "  One could not help but describe the standing figure as charming."

#. Occurrence 4_4:2159:3689: scene=4_4
#: 4_4:2159
msgctxt "text_id=3689 | speaker=unknown"
msgid "　身じろぎひとつせず待ち続ける様は、丁寧に描かれた絵画を思わせる。"
msgstr "  The way she silently, motionlessly waited was reminiscent of a meticulously composed portrait."

#. Occurrence 4_4:2164:3690: scene=4_4
#: 4_4:2164
msgctxt "text_id=3690 | speaker=unknown"
msgid "　その姿を見て、一言で青子が『孤独』と断言したように。"
msgstr "  Aoko took one look at her before instantly recalling that one word: solitude."

#. Occurrence 4_4:2212:3691: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0014; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:2212
msgctxt "text_id=3691 | speaker=aoko"
msgid "『……まったく、うちの男子どもは。家に帰りもせず、陰でこそこそやってるのはそういうコト』"
msgstr "(Okay you lamebrains, don't you have anywhere better to be?)"

#. Occurrence 4_4:2218:3692: scene=4_4
#: 4_4:2218
msgctxt "text_id=3692 | speaker=unknown"
msgid "　呆れながら、青子はずかずかと校門を通過した。"
msgstr "  Disgusted, Aoko barged through the gate."

#. Occurrence 4_4:2223:3693: scene=4_4
#: 4_4:2223
msgctxt "text_id=3693 | speaker=unknown"
msgid "　いつもなら坂道を下りていくところを、まっすぐアスファルトを横断し、道端に立ち続ける少女へと向かう。"
msgstr "  At this point she would normally head home, but today, she crossed the street toward the waiting girl."

#. Occurrence 4_4:2284:3694: voice_id=F80_4_4_0000; voice_prefix=F80; voice_category=0; scene=4_4
#: 4_4:2284
msgctxt "text_id=3694 | speaker=unknown"
msgid "「げぇー!?　あれなるは生徒会長さまー!?」"
msgstr "\"Oh crap! Is that the student council president?!\""

#. Occurrence 4_4:2290:3695: voice_id=F90_4_4_0000; voice_prefix=F90; voice_category=0; scene=4_4
#: 4_4:2290
msgctxt "text_id=3695 | speaker=unknown"
msgid "「くそ、追っ払う気なのかよぅ。居たいんならいつまでだって居させてあげればいいじゃんかー！」"
msgstr "\"Damn it, she's trying to chase her away! ...Let the girl be! She has a right to stand there if she wants to!\""

#. Occurrence 4_4:2304:3696: voice_id=G10_4_4_0000; voice_prefix=G10; voice_category=0; scene=4_4
#: 4_4:2304
msgctxt "text_id=3696 | speaker=unknown"
msgid "「ってか怒られる？　怒られるのあの天使？」"
msgstr "\"She's gonna go nuclear! The president versus the angel!\""

#. Occurrence 4_4:2310:3697: voice_id=G20_4_4_0000; voice_prefix=G20; voice_category=0; scene=4_4
#: 4_4:2310
msgctxt "text_id=3697 | speaker=unknown"
msgid "「<他校|よそ>の生徒でも、校門前にいるぐらいなら……別に問題はないと思う……けど……」"
msgstr "\"What gives, man? Who cares if she's from another school! She's not even on school property...right? Right guys?\""

#. Occurrence 4_4:2316:3698: voice_id=G30_4_4_9000; voice_prefix=G30; voice_category=0; scene=4_4
#: 4_4:2316
msgctxt "text_id=3698 | speaker=unknown"
msgid "「青子女史は容赦ねえからな。下手すると平手だぜ、平手」"
msgstr "\"Don't mess with Madam Aoko. You're just asking to be smacked.\""

#. Occurrence 4_4:2362:3699: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0015; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:2362
msgctxt "text_id=3699 | speaker=aoko"
msgid "「…………はあ」"
msgstr "\"...Hah.\""

#. Occurrence 4_4:2367:3700: scene=4_4
#: 4_4:2367
msgctxt "text_id=3700 | speaker=unknown"
msgid "　背中では言いたい放題だ。"
msgstr "  The boys ran their mouths behind her back."

#. Occurrence 4_4:2372:3701: scene=4_4
#: 4_4:2372
msgctxt "text_id=3701 | speaker=unknown"
msgid "　振り返って黙らせる気分でもなく、青子は少女の目前まで歩いて、やあ、とばかりに片手を上げた。"
msgstr "  Not in the mood to shut them up, Aoko walked right up to the girl and offered an informal wave."

#. Occurrence 4_4:2425:3702: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0016; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:2425
msgctxt "text_id=3702 | speaker=aoko"
msgid "「どうしたの有珠？　こんなところに来たって、何も面白いコトはないって言ったのに」"
msgstr "\"Something the matter, Alice? I told you before, there's nothing of interest for you here.\""

#. Occurrence 4_4:2445:3703: voice_id=X20_4_4_0000; voice_prefix=X20; voice_category=0; scene=4_4
#: 4_4:2445
msgctxt "text_id=3703 | speaker=unknown"
msgid "「ちょ、ありえねーーーーーーー！！！！？」"
msgstr "\"For real!?\""

#. Occurrence 4_4:2451:3704: scene=4_4
#: 4_4:2451
msgctxt "text_id=3704 | speaker=unknown"
msgid "　校門の陰から悲鳴らしきものがハモって聞こえたが、もちろん無視する青子だった。"
msgstr "  Aoko heard the boys by the gate lose their collective minds, and did her best to ignore them."

#. Occurrence 4_4:2490:3705: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0000_0; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:2490
msgctxt "text_id=3705 | speaker=alice"
msgid "「あの事を確かめに。―――"
msgstr "\"I wanted to be sure, but―"

#. Occurrence 4_4:2504:3706: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0000_1; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:2504
msgctxt "text_id=3706 | speaker=alice"
msgid "青子。"
msgstr "Aoko?"

#. Occurrence 4_4:2543:3707: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0001; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:2543
msgctxt "text_id=3707 | speaker=alice"
msgid "　あの人たち、邪魔なんだけど」"
msgstr "  Those people are a nuisance.\""

#. Occurrence 4_4:2555:3708: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0017; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:2555
msgctxt "text_id=3708 | speaker=aoko"
msgid "「分かってる、いま追っ払うから」"
msgstr "\"You think? I'll chase them off.\""

#. Occurrence 4_4:2561:3709: scene=4_4
#: 4_4:2561
msgctxt "text_id=3709 | speaker=unknown"
msgid "　細い有珠の声に対して、青子ははっきりと、これみよがしに声を大きくしている。"
msgstr "  In contrast to Alice's small voice, Aoko spoke loud and clear."

#. Occurrence 4_4:2566:3710: scene=4_4
#: 4_4:2566
msgctxt "text_id=3710 | speaker=unknown"
msgid "　無論、校門の陰に群がる<十把一絡|じっぱひとから>げに聞こえるように。"
msgstr "  Naturally, this was on purpose, so as to deal with the riffraff by the gate all at once."

#. Occurrence 4_4:2640:3711: voice_id=F80_4_4_0002; voice_prefix=F80; voice_category=0; scene=4_4
#: 4_4:2640
msgctxt "text_id=3711 | speaker=unknown"
msgid "「げ、会長こっち来んぞ!?」"
msgstr "\"Crap, she's coming this way!\""

#. Occurrence 4_4:2646:3712: voice_id=F90_4_4_0001; voice_prefix=F90; voice_category=0; scene=4_4
#: 4_4:2646
msgctxt "text_id=3712 | speaker=unknown"
msgid "「おい、押すなよ、うしろのヤツどけって！　オレ校舎に逃げるから！」"
msgstr "\"Hey, stop pushing me! Move it! I'm out!\""

#. Occurrence 4_4:2652:3713: voice_id=G10_4_4_0001; voice_prefix=G10; voice_category=0; scene=4_4
#: 4_4:2652
msgctxt "text_id=3713 | speaker=unknown"
msgid "「いや、でも……あの<娘|こ>、会長と知り合いなんでしょ？　うまく会長に紹介してもらう、とか……」"
msgstr "\"But... doesn't it look like they're tight? Maybe we could get the prez to introduce us.\""

#. Occurrence 4_4:2658:3714: voice_id=G20_4_4_9000; voice_prefix=G20; voice_category=0; scene=4_4
#: 4_4:2658
msgctxt "text_id=3714 | speaker=unknown"
msgid "「あはは、さすが一年坊主。まだ戦場の現実ってもんを理解していねぇ。―――よし、死の<間際|まぎわ>までいい夢見ろよ」"
msgstr "\"Hahaha. Rookie mistake. You still haven't experienced the realities of the battlefield. On second thought, don't let dreams be dreams. It's your funeral.\""

#. Occurrence 4_4:2730:3715: scene=4_4
#: 4_4:2730
msgctxt "text_id=3715 | speaker=unknown"
msgid "　一ヶ所に集まりすぎたのか、混乱きわまって校門の陰でつまる男子生徒たち。"
msgstr "  Perhaps because too many of them had gathered in one place, the mob entered a frenzied panic as they tried to escape."

#. Occurrence 4_4:2736:3716: scene=4_4
#: 4_4:2736
msgctxt "text_id=3716 | speaker=unknown"
msgid "そんな彼らを、"
msgstr "Aoko addressed them all."

#. Occurrence 4_4:2748:3717: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0018; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:2748
msgctxt "text_id=3717 | speaker=aoko"
msgid "「さーて。部活動があるワケでもなし、ただ家に帰るだけの帰宅部の皆さん？　こんなところで何を集まってるのか、教えてくれる？」"
msgstr "\"Well, well, well, what do we have here? If it isn't the Go Home Early Club? Would you mind telling me what you're all doing gathered in a place like this with no club activities to attend?\""

#. Occurrence 4_4:2759:3718: voice_id=X20_4_4_0001; voice_prefix=X20; voice_category=0; scene=4_4
#: 4_4:2759
msgctxt "text_id=3718 | speaker=unknown"
msgid "「ひぃぃいい！」"
msgstr "\"Eeeep!\""

#. Occurrence 4_4:2765:3719: scene=4_4
#: 4_4:2765
msgctxt "text_id=3719 | speaker=unknown"
msgid "　どーん、と擬音を背負って<睥睨|へいげい>する生徒会長。"
msgstr "  The student council president stared daggers at the boys."

#. Occurrence 4_4:2806:3720: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0019; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:2806
msgctxt "text_id=3720 | speaker=aoko"
msgid "「なにしろ試験前だもの。"
msgstr "\"In any case, exams are coming up."

#. Occurrence 4_4:2812:3721: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0020; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:2812
msgctxt "text_id=3721 | speaker=aoko"
msgid "　<実|み>になる事なら私も教えてほしいけど、まさか<雁首|がんくび>並べて女学院のお嬢様を<眺|なが>めてただけ、なんて事はないわよね？"
msgstr "  It sure would be horrible if, instead of going home to study, you were loitering around just to ogle another school's student, now wouldn't it?"

#. Occurrence 4_4:2818:3722: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0021; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:2818
msgctxt "text_id=3722 | speaker=aoko"
msgid "　声をかける勇気もなくて、眺めてただけ、なんて事は」"
msgstr "  It's not like a single one of you had the guts to even go up to her and say something.\""

#. Occurrence 4_4:2836:3723: scene=4_4
#: 4_4:2836
msgctxt "text_id=3723 | speaker=unknown"
msgid "　はい、実はそうなんです、などと返答できる剛の者はいなかった。それだけの勇気があるならとっくに声をかけている。"
msgstr "  Not one of them was brave enough to admit that this hit the nail on the head. If any of them had such courage, they would have already been chatting the young lady up."

#. Occurrence 4_4:2900:3724: voice_id=F80_4_4_9000; voice_prefix=F80; voice_category=0; scene=4_4
#: 4_4:2900
msgctxt "text_id=3724 | speaker=unknown"
msgid "「……いや、ボク教室にちょっと忘れ物が……」"
msgstr "\"Uh... I think I forgot something in the classroom.\""

#. Occurrence 4_4:2910:3725: voice_id=F90_4_4_9000; voice_prefix=F90; voice_category=0; scene=4_4
#: 4_4:2910
msgctxt "text_id=3725 | speaker=unknown"
msgid "「こんなオチならダメもとで玉砕しとくんだった……」"
msgstr "\"If I had known it was going to end like this, I would have at least gone down trying.\""

#. Occurrence 4_4:2916:3726: voice_id=G10_4_4_9000; voice_prefix=G10; voice_category=0; scene=4_4
#: 4_4:2916
msgctxt "text_id=3726 | speaker=unknown"
msgid "「天文部にいって双眼鏡借りるのどうだ？　屋上からお顔を<賜|たまわ>るとか」"
msgstr "\"What if we go borrow binoculars from the Astronomy Club? I'm sure we could get a good view from the roof.\""

#. Occurrence 4_4:2926:3727: voice_id=G20_4_4_9001; voice_prefix=G20; voice_category=0; scene=4_4
#: 4_4:2926
msgctxt "text_id=3727 | speaker=unknown"
msgid "「天文部にそんなのねえよ！　あるとしたら野鳥同好会じゃね？」"
msgstr "\"The Astronomy Club doesn't have binoculars, dummy! If anyone does, it would be the Wild Bird Society.\""

#. Occurrence 4_4:2951:3728: voice_id=G30_4_4_9001; voice_prefix=G30; voice_category=0; scene=4_4
#: 4_4:2951
msgctxt "text_id=3728 | speaker=unknown"
msgid "「あはははは。それ、先月会長が潰したじゃん。<鳥|とり><愛|め>でてる暇があるなら彼女作れって」"
msgstr "\"Haha! The prez destroyed those last month! If you have enough time for bird-watching, you have enough time to find a girlfriend, chicken.\""

#. Occurrence 4_4:2961:3729: voice_id=G60_4_4_9000; voice_prefix=G60; voice_category=0; scene=4_4
#: 4_4:2961
msgctxt "text_id=3729 | speaker=unknown"
msgid "「あはは、は……彼女、作れです、か……すみませんっす、今日は裏口から帰るっす、ザキさん……」"
msgstr "\"Hahaha. Find a girlfriend? ...S-Sorry, 'Zaki, I'm gonna cut out through the back exit.\""

#. Occurrence 4_4:2971:3730: voice_id=F90_4_4_0003; voice_prefix=F90; voice_category=0; scene=4_4
#: 4_4:2971
msgctxt "text_id=3730 | speaker=unknown"
msgid "「クソ、じゃあなー会長ー！　また明日ー！」"
msgstr "\"I gotta jet, too! Later, prez! See ya tomorrow!\""

#. Occurrence 4_4:3007:3731: scene=4_4
#: 4_4:3007
msgctxt "text_id=3731 | speaker=unknown"
msgid "　愛らしい捨て台詞を残し、負け犬のようにハラハラと散っていく男子生徒たち。"
msgstr "  And with those oh-so-charming remarks, the boys scattered with their tails between their legs."

#. Occurrence 4_4:3040:3732: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0002; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:3040
msgctxt "text_id=3732 | speaker=alice"
msgid "「楽しそうね、青子」"
msgstr "\"You seem to be enjoying yourself, Aoko.\""

#. Occurrence 4_4:3056:3733: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0022; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3056
msgctxt "text_id=3733 | speaker=aoko"
msgid "「あ、わかる？」"
msgstr "\"How could you tell?\""

#. Occurrence 4_4:3061:3734: scene=4_4
#: 4_4:3061
msgctxt "text_id=3734 | speaker=unknown"
msgid "　有珠の一言に、つい即答する青子。"
msgstr "  Aoko's response slipped out all too easily."

#. Occurrence 4_4:3066:3735: scene=4_4
#: 4_4:3066
msgctxt "text_id=3735 | speaker=unknown"
msgid "　事実、三咲高校の生徒たちは嫌味のない人間ばかりで、彼らとのやりとりは愉快ではあるのだ。"
msgstr "  In truth, there were not that many bad apples at Misaki High, and dealing with them wasn't really that bad."

#. Occurrence 4_4:3096:3736: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0023; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3096
msgctxt "text_id=3736 | speaker=aoko"
msgid "「―――で。"
msgstr "\"...So?"

#. Occurrence 4_4:3117:3737: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0024; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3117
msgctxt "text_id=3737 | speaker=aoko"
msgid "　ここまで出向くって事は、何か分かったの？」"
msgstr "  What brings you down here? Did you find something out?\""

#. Occurrence 4_4:3123:3738: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0003; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:3123
msgctxt "text_id=3738 | speaker=alice"
msgid "「結界に残っていた気配の識別は。あとはここで確かめればいいだけよ」"
msgstr "\"I identified traces of the witness from within the field. All we need to do now is put a name to them.\""

#. Occurrence 4_4:3129:3739: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0025; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3129
msgctxt "text_id=3739 | speaker=aoko"
msgid "「そう。ん……？　有珠、いつからここに？」"
msgstr "\"I see. ...Alice, how long have you been waiting here?\""

#. Occurrence 4_4:3135:3740: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0004; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:3135
msgctxt "text_id=3740 | speaker=alice"
msgid "「下校時刻から」"
msgstr "\"Since school was dismissed.\""

#. Occurrence 4_4:3140:3741: scene=4_4
#: 4_4:3140
msgctxt "text_id=3741 | speaker=unknown"
msgid "　……という事はかれこれ一時間は経つ。"
msgstr "  So she had been here for roughly an hour."

#. Occurrence 4_4:3145:3742: scene=4_4
#: 4_4:3145
msgctxt "text_id=3742 | speaker=unknown"
msgid "　寒がりな彼女にとって、同じ場所に一時間も立つのは辛かっただろう。"
msgstr "  Standing in the same place for an hour would be taxing for someone as sensitive to the cold as Alice."

#. Occurrence 4_4:3175:3743: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0026; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3175
msgctxt "text_id=3743 | speaker=aoko"
msgid "「悪いわね、無理させて」"
msgstr "\"I'm sorry. If you would have told me...\""

#. Occurrence 4_4:3181:3744: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0005; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:3181
msgctxt "text_id=3744 | speaker=alice"
msgid "「……別に。好きでやってる事だから」"
msgstr "\"...Don't be. I'm just doing it because I wanted to.\""

#. Occurrence 4_4:3187:3745: scene=4_4
#: 4_4:3187
msgctxt "text_id=3745 | speaker=unknown"
msgid "　言いながらも、彼女の黒い瞳は校門を通る生徒たちを見つめている。"
msgstr "  As she spoke, her black eyes were fixed upon the gate and the students passing through it."

#. Occurrence 4_4:3192:3746: scene=4_4
#: 4_4:3192
msgctxt "text_id=3746 | speaker=unknown"
msgid "　こうやって一時間ものあいだ、有珠は校門を監視していたのだろう。"
msgstr "  She had likely been observing the gate in this manner for the past hour."

#. Occurrence 4_4:3213:3747: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0027; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3213
msgctxt "text_id=3747 | speaker=aoko"
msgid "「私を待ってたワケじゃないんでしょ？　今からでも付き合うわ」"
msgstr "\"You're weren't waiting for me, were you? ...Well I'm here now anyway so we can go.\""

#. Occurrence 4_4:3218:3748: scene=4_4
#: 4_4:3218
msgctxt "text_id=3748 | speaker=unknown"
msgid "　こくん、と頷く有珠。"
msgstr "  Alice nodded in assent."

#. Occurrence 4_4:3223:3749: scene=4_4
#: 4_4:3223
msgctxt "text_id=3749 | speaker=unknown"
msgid "　有珠が残っているのは、いまだ目撃者を発見できていないからだ。"
msgstr "  If Alice was still here, it meant she had not found the witness yet."

#. Occurrence 4_4:3228:3750: scene=4_4
#: 4_4:3228
msgctxt "text_id=3750 | speaker=unknown"
msgid "　結界に残った気配に一致する生徒がいたのなら、有珠は青子を待たずに帰宅し、その生徒の素性を調べていただろう。"
msgstr "  If she had found this student, Alice would have already gone home ahead of Aoko and begun to research the student's background."

#. Occurrence 4_4:3271:3751: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0028; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3271
msgctxt "text_id=3751 | speaker=aoko"
msgid "「私の方はダメだった」"
msgstr "\"Nothing came up on my end.\""

#. Occurrence 4_4:3277:3752: scene=4_4
#: 4_4:3277
msgctxt "text_id=3752 | speaker=unknown"
msgid "　鳶丸に調べさせた結果について、青子は結果だけを告げた。有珠に言葉はない。"
msgstr "  She reported the results of Tobimaru's investigation. Alice remained silent."

#. Occurrence 4_4:3282:3753: scene=4_4
#: 4_4:3282
msgctxt "text_id=3753 | speaker=unknown"
msgid "　会話はそれで打ち止めになり、あとは冷たい風に耐えるだけである。"
msgstr "  With that the conversation ended, leaving the two to silently endure the freezing wind."

#. Occurrence 4_4:3333:3754: scene=4_4
#: 4_4:3333
msgctxt "text_id=3754 | speaker=unknown"
msgid "　……無言の監視はあてもなく続く。"
msgstr "  ...The silent stakeout dragged on endlessly."

#. Occurrence 4_4:3338:3755: scene=4_4
#: 4_4:3338
msgctxt "text_id=3755 | speaker=unknown"
msgid "　校門に来た生徒たちは、生徒会長と礼園女学院の生徒という組み合わせに驚きつつ下校していく。"
msgstr "  Students continued to pass the gate, each shocked at the sight of the unusual combo, and head home."

#. Occurrence 4_4:3343:3756: scene=4_4
#: 4_4:3343
msgctxt "text_id=3756 | speaker=unknown"
msgid "　退屈さと冬の寒さも手伝ってか、二十分もすぎると青子はため息をついていた。"
msgstr "  After twenty minutes Aoko let a sigh escape her mouth, perhaps from boredom, perhaps from the cold, or perhaps from both."

#. Occurrence 4_4:3394:3757: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0029; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3394
msgctxt "text_id=3757 | speaker=aoko"
msgid "「ね、有珠。帰り、<黎明|レイメイ>に寄ってかない？」"
msgstr "\"Hey, on our way home, do you want to drop by Dawn?\""

#. Occurrence 4_4:3400:3758: scene=4_4
#: 4_4:3400
msgctxt "text_id=3758 | speaker=unknown"
msgid "　ちらり、と有珠の顔を覗きこむ青子。"
msgstr "  Aoko quickly turned to Alice to catch her reaction."

#. Occurrence 4_4:3405:3759: scene=4_4
#: 4_4:3405
msgctxt "text_id=3759 | speaker=unknown"
msgid "　黎明は青子お気に入りの喫茶店の名前である。"
msgstr "  Dawn was the name of one of Aoko's favorite coffee shops."

#. Occurrence 4_4:3442:3760: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0006; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:3442
msgctxt "text_id=3760 | speaker=alice"
msgid "「……………………」"
msgstr "\"...\""

#. Occurrence 4_4:3448:3761: scene=4_4
#: 4_4:3448
msgctxt "text_id=3761 | speaker=unknown"
msgid "　状況を理解していない青子への非難か、それともわりと同意なのか、有珠は微かに視線を動かした。"
msgstr "  Offering no clear indication as to whether she was critical of Aoko's blasé attitude or agreeing to her whims, Alice's gaze shifted ever so slightly."

#. Occurrence 4_4:3453:3762: scene=4_4
#: 4_4:3453
msgctxt "text_id=3762 | speaker=unknown"
msgid "　その視線の先には―――"
msgstr "  Aoko followed her stare..."

#. Occurrence 4_4:3492:3763: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0000; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:3492
msgctxt "text_id=3763 | speaker=soujuurou"
msgid "「あれ、蒼崎も待ち合わせか？」"
msgstr "\"Hey, Aozaki. Are you meeting someone here, too?\""

#. Occurrence 4_4:3498:3764: scene=4_4
#: 4_4:3498
msgctxt "text_id=3764 | speaker=unknown"
msgid "　意識の隙を<衝|つ>くような、突然の声。"
msgstr "  The sudden voice took her off guard."

#. Occurrence 4_4:3503:3765: scene=4_4
#: 4_4:3503
msgctxt "text_id=3765 | speaker=unknown"
msgid "　自然な、刺のない口調が誰であるかは言うまでもない。"
msgstr "  There was only one person who spoke with this gentle, good-natured tone."

#. Occurrence 4_4:3564:3766: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0030; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3564
msgctxt "text_id=3766 | speaker=aoko"
msgid "「―――そ。やっぱ、そうなるワケか」"
msgstr "\"...Of course it'd be him.\""

#. Occurrence 4_4:3570:3767: scene=4_4
#: 4_4:3570
msgctxt "text_id=3767 | speaker=unknown"
msgid "　有珠に背中を向けて、青子はキッと、やってきた生徒を見据える。"
msgstr "  Turning her back to Alice, Aoko moved her focus to the newly appeared student."

#. Occurrence 4_4:3620:3768: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0031; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3620
msgctxt "text_id=3768 | speaker=aoko"
msgid "「それで、今日は何の用？」"
msgstr "\"Can I help you with something?\""

#. Occurrence 4_4:3626:3769: scene=4_4
#: 4_4:3626
msgctxt "text_id=3769 | speaker=unknown"
msgid "　こんにちはも何もない。"
msgstr "  All politeness flew out the window."

#. Occurrence 4_4:3631:3770: scene=4_4
#: 4_4:3631
msgctxt "text_id=3770 | speaker=unknown"
msgid "　不機嫌な青子の視線は、その険悪さをより増して草十郎に向けられる。"
msgstr "  Already in a bad mood, Aoko's mood plummeted the longer she looked at Soujyuro."

#. Occurrence 4_4:3636:3771: scene=4_4
#: 4_4:3636
msgctxt "text_id=3771 | speaker=unknown"
msgid "　が、そんな青子の眼力も草十郎には通じなかったようだ。"
msgstr "  The subtlety of her expression, however, was lost on him."

#. Occurrence 4_4:3664:3772: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0001; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:3664
msgctxt "text_id=3772 | speaker=soujuurou"
msgid "「いや、これから駅前で水泳部の部長と待ち合わせなんだけど、その事でお礼を言っておきたくて」"
msgstr "\"No thanks, I was just on my way to the station to meet the swimming club captain, and I wanted to say thanks.\""

#. Occurrence 4_4:3688:3773: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0032; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3688
msgctxt "text_id=3773 | speaker=aoko"
msgid "「？」"
msgstr "\"Hmm?\""

#. Occurrence 4_4:3693:3774: scene=4_4
#: 4_4:3693
msgctxt "text_id=3774 | speaker=unknown"
msgid "　それは、意外と言えば意外な一言だった筈だ。"
msgstr "  Well, that was completely unexpected."

#. Occurrence 4_4:3698:3775: scene=4_4
#: 4_4:3698
msgctxt "text_id=3775 | speaker=unknown"
msgid "　部活とお礼。"
msgstr "  Thanks... Joining a club..."

#. Occurrence 4_4:3703:3776: scene=4_4
#: 4_4:3703
msgctxt "text_id=3776 | speaker=unknown"
msgid "　……ただ、その組み合わせなら、この人物は間の抜けた事を言ってくるだろうと、青子は思ってもいた。なんの根拠もなかったけれど。"
msgstr "  Aoko had a hunch that he was about to say something brainless."

#. Occurrence 4_4:3729:3777: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0033; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3729
msgctxt "text_id=3777 | speaker=aoko"
msgid "「……ふうん。お礼って、お礼参りってこと？」"
msgstr "\"...And by 'thanks' you mean 'payback,' right?\""

#. Occurrence 4_4:3735:3778: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0002; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:3735
msgctxt "text_id=3778 | speaker=soujuurou"
msgid "「？」"
msgstr "\"?\""

#. Occurrence 4_4:3740:3779: scene=4_4
#: 4_4:3740
msgctxt "text_id=3779 | speaker=unknown"
msgid "　これまた幸運な事に、学生におけるお礼参りの意味も、草十郎はまだ知らずにいたらしい。"
msgstr "  Fortunately, Soujyuro was completely unaware of the more sinister implications to the word \"payback.\""

#. Occurrence 4_4:3775:3780: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0003; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:3775
msgctxt "text_id=3780 | speaker=soujuurou"
msgid "「よく分からないけど、そんな大した事じゃないよ。"
msgstr "\"I'm not sure what you mean by that, but it's no big deal."

#. Occurrence 4_4:3781:3781: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0004; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:3781
msgctxt "text_id=3781 | speaker=soujuurou"
msgid "　ただ、水泳部は夏までそう忙しくないって話だったから」"
msgstr "  It's just that the swimming club captain said that the club doesn't get that busy until summer.\""

#. Occurrence 4_4:3787:3782: scene=4_4
#: 4_4:3787
msgctxt "text_id=3782 | speaker=unknown"
msgid "　そういう部活を<薦|すす>めてくれたんだな、と草十郎は続けようとしたが、青子はつまらなそうな顔で遮った。"
msgstr "  Soujyuro was just about to thank her for recommending a club that would not take up much of his time, when Aoko cut him off with an expression of disinterest."

#. Occurrence 4_4:3823:3783: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0034; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3823
msgctxt "text_id=3783 | speaker=aoko"
msgid "「当然でしょう。幽霊部員になりそうな生徒なんて、紹介できないから。忙しい貴方でも<勤|つと>まりそうな場所があったから、口に出しただけよ」"
msgstr "\"Well of course. I couldn't very well introduce you to a club that I knew you would never turn up to. All I did was mention some that even someone as busy as you could join.\""

#. Occurrence 4_4:3843:3784: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0005; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:3843
msgctxt "text_id=3784 | speaker=soujuurou"
msgid "「なるほど、無駄がないね」"
msgstr "\"I see. Very efficient.\""

#. Occurrence 4_4:3863:3785: scene=4_4
#: 4_4:3863
msgctxt "text_id=3785 | speaker=unknown"
msgid "　感心する草十郎に、青子は文句を言う気も無くしてしまった。"
msgstr "  His open admiration for her sapped Aoko's will to fight."

#. Occurrence 4_4:3868:3786: scene=4_4
#: 4_4:3868
msgctxt "text_id=3786 | speaker=unknown"
msgid "　彼女にとって、彼に似合った部活を探して部長に話をつけること自体が無駄な事だったのだが。"
msgstr "  Finding a suitable club and negotiating with its captain hadn't been an efficient use of her time at all."

#. Occurrence 4_4:3895:3787: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0006; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:3895
msgctxt "text_id=3787 | speaker=soujuurou"
msgid "「とにかく、お世話になったから。"
msgstr "\"Anyway, you really helped me out."

#. Occurrence 4_4:3895:3788: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0006; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:3895
msgctxt "text_id=3788 | speaker=soujuurou"
msgid "　それで礼を言っときたくて」"
msgstr "  I just wanted to say thanks.\""

#. Occurrence 4_4:3901:3789: scene=4_4
#: 4_4:3901
msgctxt "text_id=3789 | speaker=unknown"
msgid "　ありがとう、と今にも頭を下げそうな草十郎を、あわてて青子は止める。"
msgstr "  Soujyuro gratefully dipped his head, but not before the flustered Aoko stopped him."

#. Occurrence 4_4:3940:3790: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0035; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3940
msgctxt "text_id=3790 | speaker=aoko"
msgid "「よしてよ。いま貴方にそんな事されても迷惑だから。"
msgstr "\"Gimme a break. You're just going to give me a headache if you do that."

#. Occurrence 4_4:3946:3791: scene=4_4
#: 4_4:3946
msgctxt "text_id=3791 | speaker=unknown"
msgid "　……"
msgstr "  ..."

#. Occurrence 4_4:3958:3792: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0036; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:3958
msgctxt "text_id=3792 | speaker=aoko"
msgid "それで、水泳部はどう？　やっていけそう？」"
msgstr " So. How's the swimming club? Does it seem like a good fit?\""

#. Occurrence 4_4:3984:3793: scene=4_4
#: 4_4:3984
msgctxt "text_id=3793 | speaker=unknown"
msgid "　鋭かった視線が、どこか気まずいものに変わる。"
msgstr "  An awkwardness infiltrated her previously sharp gaze."

#. Occurrence 4_4:3989:3794: scene=4_4
#: 4_4:3989
msgctxt "text_id=3794 | speaker=unknown"
msgid "　青子の態度に違和感を覚える草十郎だったが、その理由までは分からない。"
msgstr "  Soujyuro was able to pick up on the odd change in her behavior, but could not divine its reason."

#. Occurrence 4_4:3994:3795: scene=4_4
#: 4_4:3994
msgctxt "text_id=3795 | speaker=unknown"
msgid "　なので、とりあえず分かるところから、と最新のニュースを青子に告げた。"
msgstr "  So he simply started with what he knew so far and reported the most recent information he had."

#. Occurrence 4_4:4032:3796: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0007; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4032
msgctxt "text_id=3796 | speaker=soujuurou"
msgid "「ああ、水泳部はクビになった」"
msgstr "\"Oh, I got kicked out of the club already.\""

#. Occurrence 4_4:4055:3797: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0037; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4055
msgctxt "text_id=3797 | speaker=aoko"
msgid "「な、"
msgstr "\"W-"

msgctxt "text_id=3798 | speaker=unknown"
msgid "なんでよーーー！？」"
msgstr " WHAT!? Why!?\""

#. Occurrence 4_4:4071:3799: scene=4_4
#: 4_4:4071
msgctxt "text_id=3799 | speaker=unknown"
msgid "　予想外の返答に、思わず怒鳴る青子。"
msgstr "  Aoko instinctively shouted at the unexpected response."

#. Occurrence 4_4:4076:3800: scene=4_4
#: 4_4:4076
msgctxt "text_id=3800 | speaker=unknown"
msgid "　……びっくり箱の化身にも程がある。"
msgstr "  Like a human jack-in-the-box."

#. Occurrence 4_4:4081:3801: scene=4_4
#: 4_4:4081
msgctxt "text_id=3801 | speaker=unknown"
msgid "　あまりの展開に、青子の複雑にねじれていた心持ちが一瞬で真っ白になるぐらい。"
msgstr "  This unexpected development threw her mind in a tizzy, and she momentarily forgot the complicated feelings she had been wrestling with."

#. Occurrence 4_4:4108:3802: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0038; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4108
msgctxt "text_id=3802 | speaker=aoko"
msgid "「だだ、だって、今から待ち合わせだって……！」"
msgstr "\"B-B-But you just said that you were on your way to meet the captain!\""

#. Occurrence 4_4:4145:3803: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0008; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4145
msgctxt "text_id=3803 | speaker=soujuurou"
msgid "「それは、これから<社木|やしろぎ>の温水プールに連れていってくれるからだよ」"
msgstr "\"Yeah, the captain's taking me to a heated pool in Yashirogi.\""

#. Occurrence 4_4:4151:3804: scene=4_4
#: 4_4:4151
msgctxt "text_id=3804 | speaker=unknown"
msgid "　驚く青子に、うん、と告げる草十郎。"
msgstr "  Soujyuro stated this very matter-of-factly to the still-reeling Aoko."

#. Occurrence 4_4:4182:3805: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0039; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4182
msgctxt "text_id=3805 | speaker=aoko"
msgid "「……話が繋がらない。そこまで上手くいってるのに、どうして入部を拒否されるのよ、アンタは！」"
msgstr "\"...I'm not following. Things seem to be going fine. Why would they kick you out!?\""

#. Occurrence 4_4:4195:3806: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0009; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4195
msgctxt "text_id=3806 | speaker=soujuurou"
msgid "「そりゃあ、俺が泳げないからだろ」"
msgstr "\"Oh, that's easy. Because I can't swim.\""

#. Occurrence 4_4:4230:3807: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0040; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4230
msgctxt "text_id=3807 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 4_4:4235:3808: scene=4_4
#: 4_4:4235
msgctxt "text_id=3808 | speaker=unknown"
msgid "　なるほど、そうきたか、と眉間を指で押さえる青子。"
msgstr "  Aoko reached up with her fingers and pinched the bridge of her nose as she processed his answer."

#. Occurrence 4_4:4270:3809: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0041; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4270
msgctxt "text_id=3809 | speaker=aoko"
msgid "「……静希君。昨日の私の質問は覚えてる？　走るのか泳ぐのか、どっちがいいかってヤツ。"
msgstr "\"Sizuki, do you remember my question from yesterday? The one where I asked whether you preferred running or swimming?"

#. Occurrence 4_4:4276:3810: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0042; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4276
msgctxt "text_id=3810 | speaker=aoko"
msgid "　私の記憶は正しいけど、いちおう確認しておくわね。"
msgstr "  I'm confident that I remember your answer, but please repeat it to me."

#. Occurrence 4_4:4296:3811: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0043; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4296
msgctxt "text_id=3811 | speaker=aoko"
msgid "　貴方、たしかに泳ぐ方だって言ったけど……？」"
msgstr "  You said you preferred 'swimming.' Right?\""

#. Occurrence 4_4:4323:3812: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0010; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4323
msgctxt "text_id=3812 | speaker=soujuurou"
msgid "「ああ。昔から、泳げないのはなんとか克服したかったんだ。反対に、走る方は得意だけど」"
msgstr "\"Yeah. Since I was little, I've always wanted to learn, and I'm already really good at running, so...\""

#. Occurrence 4_4:4335:3813: scene=4_4
#: 4_4:4335
msgctxt "text_id=3813 | speaker=unknown"
msgid "　あっそ、と答えて青子は力尽きた。"
msgstr "  Her energy spent, Aoko finally understood."

#. Occurrence 4_4:4370:3814: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0011; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4370
msgctxt "text_id=3814 | speaker=soujuurou"
msgid "「俺が一年なら一から鍛えてくれたらしいんだけど。"
msgstr "\"Apparently, they would have taken me in and trained me from square one if I were in my first year."

#. Occurrence 4_4:4376:3815: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0012; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4376
msgctxt "text_id=3815 | speaker=soujuurou"
msgid "　あと三ヶ月で三年になる身分なのに、カナヅチの部員は雇えないそうだ。"
msgstr "  Sadly, it sounds like they can't recruit a second-year like me who sinks like a rock, especially with only three months left in the school year."

#. Occurrence 4_4:4387:3816: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0013; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4387
msgctxt "text_id=3816 | speaker=soujuurou"
msgid "　けど部長が親身になってくれて、これから泳ぎを教えてくれる事になったんだよ」"
msgstr "  But the captain was really nice about it and even offered to teach me how to swim.\""

#. Occurrence 4_4:4409:3817: scene=4_4
#: 4_4:4409
msgctxt "text_id=3817 | speaker=unknown"
msgid "　どこか嬉しそうに言う草十郎の言葉は、青子にはあまり届いていない。"
msgstr "  Soujyuro's words were spoken from a place of joy, a fact that failed to reach Aoko."

#. Occurrence 4_4:4448:3818: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0044_0; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4448
msgctxt "text_id=3818 | speaker=aoko"
msgid "『はあ……つまり、欠陥品を売り付けたってワケか……こりゃ水泳部の部長に合わす顔がない……っと、"
msgstr "(Hah... So in other words, I tried to palm off defective goods. I'll never be able to show my face to the swimming club captain again."

#. Occurrence 4_4:4460:3819: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0044_1; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4460
msgctxt "text_id=3819 | speaker=aoko"
msgid "ちょっと待った』"
msgstr " Wait, but isn't the captain a...)"

#. Occurrence 4_4:4472:3820: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0045; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4472
msgctxt "text_id=3820 | speaker=aoko"
msgid "「静希君。水泳部の部長って……」"
msgstr "\"Sizuki, the swimming club captain is...\""

#. Occurrence 4_4:4478:3821: scene=4_4
#: 4_4:4478
msgctxt "text_id=3821 | speaker=unknown"
msgid "　女子、と言いかけて止めた。"
msgstr "  She stopped herself short of, \"a girl.\""

#. Occurrence 4_4:4483:3822: scene=4_4
#: 4_4:4483
msgctxt "text_id=3822 | speaker=unknown"
msgid "　口にした途端、自分が変なことを口走りそうで怖くなったからだ。"
msgstr "  She was afraid of how that might look, that she might not be able to rein herself in if she started."

#. Occurrence 4_4:4509:3823: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0046; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4509
msgctxt "text_id=3823 | speaker=aoko"
msgid "「……もういいわ。気持ちは分かったから、どこか遠くにいてくれない？　少し疲れてて、とてもじゃないけど貴方の相手はしていられないの」"
msgstr "\"...You know what? It doesn't matter. I understand now, so you can just go. Far, far from here, 'kay? I just can't deal with you right now.\""

#. Occurrence 4_4:4532:3824: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0014; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4532
msgctxt "text_id=3824 | speaker=soujuurou"
msgid "「鳶丸もそんな事を言ってたな。蒼崎は昨日と今日、めずらしく疲れてるって。何かあったのか？」"
msgstr "\"Tobimaru said the same thing, come to think of it. He said that you were unusually tired yesterday and today. Did something happen?\""

#. Occurrence 4_4:4538:3825: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0047; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4538
msgctxt "text_id=3825 | speaker=aoko"
msgid "「ちょっとね。でもいいの。解決したみたいだから。"
msgstr "\"Kind of. But it's fine. It seems to have resolved itself."

#. Occurrence 4_4:4544:3826: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0048; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4544
msgctxt "text_id=3826 | speaker=aoko"
msgid "　それより……静希君はどう見える？　私、そんなに疲れて見えるのかな」"
msgstr "  Anyway... How do I look to you, Sizuki? Do I really look that exhausted?\""

#. Occurrence 4_4:4577:3827: scene=4_4
#: 4_4:4577
msgctxt "text_id=3827 | speaker=unknown"
msgid "　何故そんな事を訊ねたのか。"
msgstr "  Why had she asked him this?"

#. Occurrence 4_4:4583:3828: scene=4_4
#: 4_4:4583
msgctxt "text_id=3828 | speaker=unknown"
msgid "　青子にしては珍しい、"
msgstr "  Blurting out things for no reason and on impulse..."

msgctxt "text_id=3829 | speaker=unknown"
msgid "　理由のない、<惰性|だせい>で口から出た言葉だ。"
msgstr "  This was not usual for Aoko."

#. Occurrence 4_4:4591:3830: scene=4_4
#: 4_4:4591
msgctxt "text_id=3830 | speaker=unknown"
msgid "　……あえて言うなら、これが最後だろうから、何かしらか普通の会話をしておこうと思ったのかもしれない。"
msgstr "  Perhaps it was because she realized that this would be their last chance to have a normal conversation."

#. Occurrence 4_4:4623:3831: scene=4_4
#: 4_4:4623
msgctxt "text_id=3831 | speaker=unknown"
msgid "　草十郎はしばし考えこんでから、そのぼんやりした雰囲気からかけ離れた笑顔を浮かべた。"
msgstr "  After a few moments of contemplation, Soujyuro conjured up a grin that cut straight through the tension."

#. Occurrence 4_4:4649:3832: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0015; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4649
msgctxt "text_id=3832 | speaker=soujuurou"
msgid "「そうだな、疲れているというより生き生きしているように見える。仕方なく畑をたがやしていた狼が、久しぶりに狩りにでる事になって<気炎|きえん>をあげている感じだ」"
msgstr "\"Well, I would say you look more lively than you do tired. Like a wolf that's been forced to plow fields for a long time, but is excited to finally go on a hunt again.\""

#. Occurrence 4_4:4655:3833: scene=4_4
#: 4_4:4655
msgctxt "text_id=3833 | speaker=unknown"
msgid "　めでたいな、と。"
msgstr "  He seemed so cheerful."

#. Occurrence 4_4:4660:3834: scene=4_4
#: 4_4:4660
msgctxt "text_id=3834 | speaker=unknown"
msgid "　まるで我が事のように、彼は微笑んだ。"
msgstr "  Like he was so happy for her."

#. Occurrence 4_4:4693:3835: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0049; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4693
msgctxt "text_id=3835 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 4_4:4699:3836: scene=4_4
#: 4_4:4699
msgctxt "text_id=3836 | speaker=unknown"
msgid "　知れず、青子は頬に手を当てた。"
msgstr "  Without thinking, Aoko's hands went to her cheeks."

#. Occurrence 4_4:4704:3837: scene=4_4
#: 4_4:4704
msgctxt "text_id=3837 | speaker=unknown"
msgid "　彼の言う事が本当なら、今の自分はこの上なく味のあるニヤけ顔をしている事になる。"
msgstr "  If what he said were true, then she was grinning from ear to ear."

#. Occurrence 4_4:4709:3838: scene=4_4
#: 4_4:4709
msgctxt "text_id=3838 | speaker=unknown"
msgid "　当然、そんなヘマは犯していなかったが。"
msgstr "  There was just no way she would have made such a mistake."

#. Occurrence 4_4:4733:3839: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0016; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4733
msgctxt "text_id=3839 | speaker=soujuurou"
msgid "「とにかくありがとう。じゃあ、また明日」"
msgstr "\"Anyway, thanks again! See you tomorrow.\""

#. Occurrence 4_4:4739:3840: scene=4_4
#: 4_4:4739
msgctxt "text_id=3840 | speaker=unknown"
msgid "　まだ手を上げるほどの気楽さはないのか、草十郎は真摯な声と<表情|かお>だけで挨拶をして去ろうとする。"
msgstr "  Perhaps still not comfortable enough to wave to her, he said his goodbye with sincerity in his voice and smile, and took his leave."

#. Occurrence 4_4:4781:3841: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0050; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4781
msgctxt "text_id=3841 | speaker=aoko"
msgid "「待って。こんな話があるの。聞いてから行って」"
msgstr "\"Wait. I have a question for you. Then you can go.\""

#. Occurrence 4_4:4787:3842: scene=4_4
#: 4_4:4787
msgctxt "text_id=3842 | speaker=unknown"
msgid "　そんな草十郎を青子は呼び止めた。"
msgstr "  Aoko called out after him."

#. Occurrence 4_4:4792:3843: scene=4_4
#: 4_4:4792
msgctxt "text_id=3843 | speaker=unknown"
msgid "　温和になりかけていた自分を<戒|いまし>める、冷たい声で。"
msgstr "  Her voice was cold as she admonished herself for having been somewhat affable earlier."

#. Occurrence 4_4:4841:3844: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0017; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4841
msgctxt "text_id=3844 | speaker=soujuurou"
msgid "「うん？」"
msgstr "\"Yeah?\""

#. Occurrence 4_4:4847:3845: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0051; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4847
msgctxt "text_id=3845 | speaker=aoko"
msgid "「意味のない<喩|たと>え話よ。"
msgstr "\"This is just a hypothetical question."

#. Occurrence 4_4:4853:3846: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0052; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4853
msgctxt "text_id=3846 | speaker=aoko"
msgid "　……そうね。貴方が空腹で死にそうな時、目の前に、同じように空腹で死にそうな二匹の動物がいるとするわ。"
msgstr "  Let's say you're on the brink of starvation and right in front of you are two animals, also starving."

#. Occurrence 4_4:4859:3847: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0053; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4859
msgctxt "text_id=3847 | speaker=aoko"
msgid "　静希君に銃をあげる。それでどちらかの動物を撃って。"
msgstr "  Someone gives you a gun and tells you to shoot one of them."

#. Occurrence 4_4:4859:3848: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0053; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:4859
msgctxt "text_id=3848 | speaker=aoko"
msgid "　右はライオンで左は子猫。選ぶのは貴方の自由だから」"
msgstr "  The one on the right is a lion. The one on the left is a kitten. What do you do?\""

#. Occurrence 4_4:4912:3849: scene=4_4
#: 4_4:4912
msgctxt "text_id=3849 | speaker=unknown"
msgid "　どことなく童話めいた質問。"
msgstr "  It was a fable-like moral dilemma,"

#. Occurrence 4_4:4917:3850: scene=4_4
#: 4_4:4917
msgctxt "text_id=3850 | speaker=unknown"
msgid "　残酷さと教訓と、押しつけがましいところがとくに。"
msgstr "  especially the way in which it was cruel and rather preachy."

#. Occurrence 4_4:4922:3851: scene=4_4
#: 4_4:4922
msgctxt "text_id=3851 | speaker=unknown"
msgid "　この手の話は考えこむときりがない。"
msgstr "  The kind that if you thought too hard about, you would never find an answer."

#. Occurrence 4_4:4927:3852: scene=4_4
#: 4_4:4927
msgctxt "text_id=3852 | speaker=unknown"
msgid "　が、彼はあっさりと返答した。"
msgstr "  Soujyuro answered quickly and calmly."

#. Occurrence 4_4:4964:3853: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0018; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:4964
msgctxt "text_id=3853 | speaker=soujuurou"
msgid "「いや、撃たないと思うよ。だって、自分の好きにしていいんだろう？　それにほら、空腹ならお互い様だ」"
msgstr "\"I don't think I'd shoot at all. You asked me what I'd do, right? And, come on, all three of us are starving.\""

#. Occurrence 4_4:4970:3854: scene=4_4
#: 4_4:4970
msgctxt "text_id=3854 | speaker=unknown"
msgid "　おそらくは悩む間もなかっただろう。"
msgstr "  He was not in the least fazed by the dilemma."

#. Occurrence 4_4:4975:3855: scene=4_4
#: 4_4:4975
msgctxt "text_id=3855 | speaker=unknown"
msgid "　それは本当にどうかと思うぐらい、真っ白な解答だった。"
msgstr "  He gave the most innocent response. So innocent, in fact, that it would give anyone pause."

#. Occurrence 4_4:5008:3856: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0054; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5008
msgctxt "text_id=3856 | speaker=aoko"
msgid "「……長生きするわ、貴方」"
msgstr "\"...You're going to live a long life, Sizuki.\""

#. Occurrence 4_4:5026:3857: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_4_4_0019; voice_prefix=A30; voice_category=3; scene=4_4
#: 4_4:5026
msgctxt "text_id=3857 | speaker=soujuurou"
msgid "「すごい台詞だな。そんなコトを言われたのは、たぶん君が初めてだ」"
msgstr "\"Whoa, you think so? I think that's the first time anyone has ever said that to me.\""

#. Occurrence 4_4:5031:3858: scene=4_4
#: 4_4:5031
msgctxt "text_id=3858 | speaker=unknown"
msgid "　笑顔には似つかわしくない台詞。"
msgstr "  Adorning his face was a smile wholly out of sync with his comment."

#. Occurrence 4_4:5050:3859: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0055; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5050
msgctxt "text_id=3859 | speaker=aoko"
msgid "「――――――なによ、それ」"
msgstr "\"...What the heck is that supposed to mean?\""

#. Occurrence 4_4:5055:3860: scene=4_4
#: 4_4:5055
msgctxt "text_id=3860 | speaker=unknown"
msgid "　……呼び止めるべきではなかったと後悔する。"
msgstr "  She regretted stopping him."

#. Occurrence 4_4:5060:3861: scene=4_4
#: 4_4:5060
msgctxt "text_id=3861 | speaker=unknown"
msgid "　あのまま見送っていれば、こんな答えを聞くこともなかったのに、と。"
msgstr "  If only she had just watched him go, this conversation would have never happened."

#. Occurrence 4_4:5105:3862: scene=4_4
#: 4_4:5105
msgctxt "text_id=3862 | speaker=unknown"
msgid "　そして、静希草十郎はてくてくと坂道を下っていった。"
msgstr "  Soujyuro Sizuki made his way down the sloped street."

#. Occurrence 4_4:5110:3863: scene=4_4
#: 4_4:5110
msgctxt "text_id=3863 | speaker=unknown"
msgid "　今日も今日とて、夜遅くまでアルバイトでもあるのだろう。"
msgstr "  Today, just like every day, he probably had to work late again."

#. Occurrence 4_4:5115:3864: scene=4_4
#: 4_4:5115
msgctxt "text_id=3864 | speaker=unknown"
msgid "　残されたのは青子と、今まで背景と化していた有珠だけである。"
msgstr "  Only Aoko and Alice remained, with Alice doing what she could to simply blend in."

#. Occurrence 4_4:5149:3865: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0056; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5149
msgctxt "text_id=3865 | speaker=aoko"
msgid "「つくづく……こっちのペースを乱してくれるわね、あの人畜無害な田舎者は」"
msgstr "\"That harmless hick really throws me for a loop.\""

#. Occurrence 4_4:5155:3866: scene=4_4
#: 4_4:5155
msgctxt "text_id=3866 | speaker=unknown"
msgid "　ぐっと右手を強く握り締めて、青子は独白する。"
msgstr "  Aoko clenched her right fist tightly as she cursed out loud."

#. Occurrence 4_4:5160:3867: scene=4_4
#: 4_4:5160
msgctxt "text_id=3867 | speaker=unknown"
msgid "　どこでもいいから体に力を入れておかないと、ここで意味不明の大声を上げかねなかった。"
msgstr "  Anything to prevent herself from screaming at the top of her lungs."

#. Occurrence 4_4:5165:3868: scene=4_4
#: 4_4:5165
msgctxt "text_id=3868 | speaker=unknown"
msgid "　……それが相手への罵倒なのか、自分への罵倒なのかは、口にしないと分からない。"
msgstr "  ...Whether that scream would be directed toward Soujyuro or toward herself was another matter entirely."

#. Occurrence 4_4:5196:3869: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0007; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:5196
msgctxt "text_id=3869 | speaker=alice"
msgid "「青子」"
msgstr "\"Aoko.\""

#. Occurrence 4_4:5202:3870: scene=4_4
#: 4_4:5202
msgctxt "text_id=3870 | speaker=unknown"
msgid "　後ろから有珠の細い声が聞こえる。彼女が何を言おうとしているかは、ちょっと前から分かっている。"
msgstr "  Aoko heard Alice's soft voice behind her. Aoko knew what she was going to say, as she had known for the entire time."

#. Occurrence 4_4:5207:3871: scene=4_4
#: 4_4:5207
msgctxt "text_id=3871 | speaker=unknown"
msgid "　……今までどんな生徒にも無反応だった彼女が、草十郎の出現で表情を変えた時から。"
msgstr "  Ever since Alice, having shown no reaction to any of the other students, changed her expression upon seeing Soujyuro."

#. Occurrence 4_4:5243:3872: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0057; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5243
msgctxt "text_id=3872 | speaker=aoko"
msgid "「言わなくてもいい。あいつでしょ、目撃者は」"
msgstr "\"You don't need to say it. It's him, right? The witness.\""

#. Occurrence 4_4:5249:3873: scene=4_4
#: 4_4:5249
msgctxt "text_id=3873 | speaker=unknown"
msgid "　それは冷めきった、"
msgstr "  Her voice was cold as ice."

#. Occurrence 4_4:5249:3874: scene=4_4
#: 4_4:5249
msgctxt "text_id=3874 | speaker=unknown"
msgid "　知らない人間の事を口にする声だった。"
msgstr "  It was the voice of someone talking about a complete stranger."

#. Occurrence 4_4:5308:3875: scene=4_4
#: 4_4:5308
msgctxt "text_id=3875 | speaker=unknown"
msgid "　―――ライオンと猫。"
msgstr "  ...The lion and the kitten."

#. Occurrence 4_4:5313:3876: scene=4_4
#: 4_4:5313
msgctxt "text_id=3876 | speaker=unknown"
msgid "　それぞれ長所短所のある、結局のところ、自分とは違う生き物を選べと彼女は言った。"
msgstr "  There were pros and cons to choosing either of these animals, the point being that she had asked him to choose one of them."

#. Occurrence 4_4:5333:3877: scene=4_4
#: 4_4:5333
msgctxt "text_id=3877 | speaker=unknown"
msgid "　リスクでいうのならライオンの方が大きい。銃口を向けた瞬間、最後の反撃をする可能性もある。"
msgstr "  In terms of risk, the lion was the more dangerous choice. The instant the gun was pointed at it there was the chance it would fight back."

#. Occurrence 4_4:5338:3878: scene=4_4
#: 4_4:5338
msgctxt "text_id=3878 | speaker=unknown"
msgid "　だから、ライオンを狙う方が勇気はいるけれど、同時に銃を持つという後ろめたさはなくなっている。"
msgstr "  Those who chose the lion required more courage, but any sense of guilt that came with holding a gun would be forgotten."

#. Occurrence 4_4:5343:3879: scene=4_4
#: 4_4:5343
msgctxt "text_id=3879 | speaker=unknown"
msgid "　なにしろ相手は強い生き物だ。人間側の勝手な言い訳であれ、銃を使うことへの罪悪感は薄れてくれる。"
msgstr "  Lions were fierce creatures―a poor excuse to shoot an animal, perhaps, but one that certainly helped alleviate the guilt."

#. Occurrence 4_4:5363:3880: scene=4_4
#: 4_4:5363
msgctxt "text_id=3880 | speaker=unknown"
msgid "　では、猫はどうだろう。弱い生き物。"
msgstr "  But what about the kitten―the weaker creature?"

#. Occurrence 4_4:5368:3881: scene=4_4
#: 4_4:5368
msgctxt "text_id=3881 | speaker=unknown"
msgid "　言うまでもなくライオンを狙うより簡単だ。けれど、誰だって不快な気持ちになる。"
msgstr "  It goes without saying that the kitten would be the easier target of the two, but choosing it would be a disquieting decision for anyone."

#. Occurrence 4_4:5373:3882: scene=4_4
#: 4_4:5373
msgctxt "text_id=3882 | speaker=unknown"
msgid "　初めから対等でないとしても、その理不尽さはあまりにも度が過ぎている。"
msgstr "  Even if the kitten had no chance to survive, it was still too senseless to carry out."

#. Occurrence 4_4:5378:3883: scene=4_4
#: 4_4:5378
msgctxt "text_id=3883 | speaker=unknown"
msgid "　青子にとって、草十郎はその“理不尽さ”に該当するものだった。"
msgstr "  And to Aoko, Soujyuro was that choice."

#. Occurrence 4_4:5442:3884: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0058; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5442
msgctxt "text_id=3884 | speaker=aoko"
msgid "『……てっきり、私もそうだと思ってた……』"
msgstr "(...I knew it was him, too.)"

#. Occurrence 4_4:5448:3885: scene=4_4
#: 4_4:5448
msgctxt "text_id=3885 | speaker=unknown"
msgid "　生徒会室でもしもと危惧した時は、そうであっても仕方がない、と思いきった。"
msgstr "  When she had felt that sinking feeling in the student council room, she ignored it; there was no getting around what must be done, she told herself."

#. Occurrence 4_4:5454:3886: scene=4_4
#: 4_4:5454
msgctxt "text_id=3886 | speaker=unknown"
msgid "けれど去りぎわの草十郎の言葉で、その決心が揺らいでいる。"
msgstr "Until, that is, Soujyuro went and said what he did, causing her resolve to waver."

#. Occurrence 4_4:5474:3887: scene=4_4
#: 4_4:5474
msgctxt "text_id=3887 | speaker=unknown"
msgid "　この胸の不快さは、後ろめたさだけの<躊躇|とまど>いではない。"
msgstr "  But the discomfort in her chest did not stem from any guilt she may have felt."

#. Occurrence 4_4:5480:3888: scene=4_4
#: 4_4:5480
msgctxt "text_id=3888 | speaker=unknown"
msgid "　静希草十郎は気に入らない人間であり、弱い相手であり、誰よりも御しやすい相手だ。"
msgstr "  She could care less for Soujyuro; he was weak, and would be incredibly easy to deal with."

#. Occurrence 4_4:5485:3889: scene=4_4
#: 4_4:5485
msgctxt "text_id=3889 | speaker=unknown"
msgid "　なのになぜ、自分は躊躇いを覚えるのか。"
msgstr "  Yet, for some reason she could not dispel her reservations."

#. Occurrence 4_4:5526:3890: scene=4_4
#: 4_4:5526
msgctxt "text_id=3890 | speaker=unknown"
msgid "　田舎から上京してきて身寄りもない転入生。"
msgstr "  A transfer student who moved to the city from the middle of nowhere, with no family to speak of..."

#. Occurrence 4_4:5531:3891: scene=4_4
#: 4_4:5531
msgctxt "text_id=3891 | speaker=unknown"
msgid "　他のまっとうな人間と違って、ここで消えたところで騒ぎだす人間も少ない。"
msgstr "  Few would notice if he were to suddenly disappear compared to a person of some renown. "

#. Occurrence 4_4:5536:3892: scene=4_4
#: 4_4:5536
msgctxt "text_id=3892 | speaker=unknown"
msgid "　殺すなら、それこそ猫の首をひねるように仕留められる。"
msgstr "  If she were to kill him, it would be as simple as wringing a cat's neck."

#. Occurrence 4_4:5541:3893: scene=4_4
#: 4_4:5541
msgctxt "text_id=3893 | speaker=unknown"
msgid "　……ほんと、いい事ずくめで頭にくる。"
msgstr "  And it all served to just piss her off."

#. Occurrence 4_4:5546:3894: scene=4_4
#: 4_4:5546
msgctxt "text_id=3894 | speaker=unknown"
msgid "　なんて<幸運|ラッキー>。その尻をつま先で蹴り飛ばしてムチャクチャにしたいぐらい、正直、余計なお世話と苛々する―――"
msgstr "  It was too lucky. Like everything was neatly handed to her. She wanted to just dropkick it right into orbit."

#. Occurrence 4_4:5604:3895: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0059; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5604
msgctxt "text_id=3895 | speaker=aoko"
msgid "「……信じられない。私、嫌がってる。これは違う。"
msgstr "\"I can't believe it. I hate it. This isn't how it's supposed to be."

#. Occurrence 4_4:5610:3896: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0060; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5610
msgctxt "text_id=3896 | speaker=aoko"
msgid "　―――こんなの、私じゃない」"
msgstr "  ...Why am I like this?\""

#. Occurrence 4_4:5616:3897: scene=4_4
#: 4_4:5616
msgctxt "text_id=3897 | speaker=unknown"
msgid "　呟きは背後の有珠にも聞こえていたかも知れない。"
msgstr "  Standing behind her, Alice heard all of the muttering."

#. Occurrence 4_4:5621:3898: scene=4_4
#: 4_4:5621
msgctxt "text_id=3898 | speaker=unknown"
msgid "　しかし、有珠は相棒の<癇癪|かんしゃく>など気にもせず、"
msgstr "  Nevertheless, she seemed ignore it and said,"

#. Occurrence 4_4:5660:3899: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0008; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:5660
msgctxt "text_id=3899 | speaker=alice"
msgid "「彼、首に布を巻いていたわね」"
msgstr "\"He had something wrapped around his neck.\""

#. Occurrence 4_4:5666:3900: scene=4_4
#: 4_4:5666
msgctxt "text_id=3900 | speaker=unknown"
msgid "　などと、まったく関係のない感想を口にした。"
msgstr "  A wholly unrelated topic."

#. Occurrence 4_4:5692:3901: scene=4_4
#: 4_4:5692
msgctxt "text_id=3901 | speaker=unknown"
msgid "　有珠の言葉に青子はハッと我に返る。"
msgstr "  Aoko returned to her senses."

#. Occurrence 4_4:5698:3902: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0061; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5698
msgctxt "text_id=3902 | speaker=aoko"
msgid "「くび……？」"
msgstr "\"...His neck?\""

#. Occurrence 4_4:5709:3903: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0009; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:5709
msgctxt "text_id=3903 | speaker=alice"
msgid "「……ええ。水泳部のクビとかけていたのかしら」"
msgstr "\"...Yes. I wonder if it had something to do with being rejected by the swimming club.\""

#. Occurrence 4_4:5714:3904: scene=4_4
#: 4_4:5714
msgctxt "text_id=3904 | speaker=unknown"
msgid "　ほとんど独り言の、心底から考えている有珠だった。"
msgstr "  Alice had put much thought into this, as if it had a deeper meaning to her somehow."

#. Occurrence 4_4:5753:3905: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0062; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5753
msgctxt "text_id=3905 | speaker=aoko"
msgid "「そういえば……あいつ、初めて会った時も首に布巻いてたっけ。<衿|えり>を行儀よく締めてるから目立たないけど」"
msgstr "\"Now that you mention it... I saw him wearing the same thing the first time we met. I must have missed it because he always has his collar done up.\""

#. Occurrence 4_4:5759:3906: scene=4_4
#: 4_4:5759
msgctxt "text_id=3906 | speaker=unknown"
msgid "　重要性のない、意味のない会話。"
msgstr "  The conversation turned to idle nonsense. "

#. Occurrence 4_4:5764:3907: scene=4_4
#: 4_4:5764
msgctxt "text_id=3907 | speaker=unknown"
msgid "　何ら解決を生むものではなかったけれど、ぐらぐらと揺れていた青子の思考は、それできっかり落ち着いてくれた。"
msgstr "  And though it solved none of her current problems, it did help calm Aoko's frazzled nerves."

#. Occurrence 4_4:5790:3908: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0063; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5790
msgctxt "text_id=3908 | speaker=aoko"
msgid "「……サンキュ、落ち着いたわ有珠。"
msgstr "\"...Thanks, Alice. I'm good."

#. Occurrence 4_4:5801:3909: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0064; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5801
msgctxt "text_id=3909 | speaker=aoko"
msgid "　それと気合いも入った。"
msgstr "  I'm ready to go."

#. Occurrence 4_4:5807:3910: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0065; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5807
msgctxt "text_id=3910 | speaker=aoko"
msgid "　善は急げ、あいつが言い触らす前に決着をつけよう」"
msgstr "  Let's strike while the iron's hot and end this before he spreads any rumors.\""

#. Occurrence 4_4:5827:3911: scene=4_4
#: 4_4:5827
msgctxt "text_id=3911 | speaker=unknown"
msgid "　よし、とばかりに青子は校門に背を向ける。"
msgstr "  Pumped once more, Aoko turned her back to the school gate."

#. Occurrence 4_4:5832:3912: scene=4_4
#: 4_4:5832
msgctxt "text_id=3912 | speaker=unknown"
msgid "　とりあえず、洋館に戻って戦闘準備をしなくてはならない。"
msgstr "  For now, they would retire to the mansion and prepare for battle."

#. Occurrence 4_4:5908:3913: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_4_4_0010; voice_prefix=A40; voice_category=2; scene=4_4
#: 4_4:5908
msgctxt "text_id=3913 | speaker=alice"
msgid "「……いいけど、いつ、どこで彼を殺すの？」"
msgstr "\"...Sure, but when and where do you plan to kill him?\""

#. Occurrence 4_4:5921:3914: scene=4_4
#: 4_4:5921
msgctxt "text_id=3914 | speaker=unknown"
msgid "　……小さい声だが公衆の面前で口にする言葉ではない。"
msgstr "  She said quietly so as not to be overheard by anyone else."

#. Occurrence 4_4:5926:3915: scene=4_4
#: 4_4:5926
msgctxt "text_id=3915 | speaker=unknown"
msgid "　有珠のこういった物騒さをたしなめるのは青子の役割だが、物騒さで言えば今の彼女も大差はないらしい。"
msgstr "  Normally, Aoko had to rein in that side of Alice, out in the open as they were. But this was far from a normal situation."

#. Occurrence 4_4:5969:3916: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_4_4_0066; voice_prefix=A10; voice_category=1; scene=4_4
#: 4_4:5969
msgctxt "text_id=3916 | speaker=aoko"
msgid "「今日の夜。場所はとっておきの夢の国よ」"
msgstr "\"Tonight. As for the place... We shall meet him in the land of dreams.\""

#. Occurrence 4_4:5975:3917: scene=4_4
#: 4_4:5975
msgctxt "text_id=3917 | speaker=unknown"
msgid "　有珠を<咎|とが>めもせず、クスリと不敵な笑みを浮かべる青子。"
msgstr "  She gave a fearless laugh."

#. Occurrence 4_4:5981:3918: scene=4_4
#: 4_4:5981
msgctxt "text_id=3918 | speaker=unknown"
msgid "　それは恋人と待ち合わせる時のような、不思議と<爽|さわ>やかな響きだった。"
msgstr "  A strangely pleasant sound, like the kind one would make when meeting their lover."

#. Occurrence 5A_1:70:3919: scene=5A_1
#: 5A_1:70
msgctxt "text_id=3919 | speaker=unknown"
msgid "　雲のかかった夜空の下、草十郎はあいかわらずの徒歩でアパートに帰ってきた。"
msgstr "  Soujyuro returned to his apartment on foot as per routine, under a blanket of clouds in the night sky."

#. Occurrence 5A_1:90:3920: scene=5A_1
#: 5A_1:90
msgctxt "text_id=3920 | speaker=unknown"
msgid "　カンカンカン、と<錆|さ>びた金属音を踏みながら階段を上っていく。"
msgstr "  The rusty stairs of his apartment building clanged with each step."

#. Occurrence 5A_1:95:3921: scene=5A_1
#: 5A_1:95
msgctxt "text_id=3921 | speaker=unknown"
msgid "　アパートの塀に置かれた自転車をチラリと見て、"
msgstr "  Out of the corner of his eye, he could see the bicycles parked by the apartment building's outer wall."

#. Occurrence 5A_1:100:3922: scene=5A_1
#: 5A_1:100
msgctxt "text_id=3922 | speaker=unknown"
msgid "　自分も自転車があれば楽なのだろうか、でも余分な出費だし、あれば便利だけど無くて死ぬようなものじゃなし、もう少し我慢しよう、などと真剣に悩んでみる。"
msgstr "  He debated the pros and cons of a bicycle―how much easier life would be versus the expense, the convenience versus the necessity―but in the end, decided one was not right for him just now."

#. Occurrence 5A_1:146:3923: scene=5A_1
#: 5A_1:146
msgctxt "text_id=3923 | speaker=unknown"
msgid "　ドアに到着して、リンゴのつまった紙袋を抱えたまま鍵を取り出す。"
msgstr "  Clutching the bag of apples under his arm, he took out the key to his residence."

#. Occurrence 5A_1:153:3924: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_1_0000; voice_prefix=A30; voice_category=3; scene=5A_1
#: 5A_1:153
msgctxt "text_id=3924 | speaker=soujuurou"
msgid "　　　　　“あれば便利だけど無くて―――”"
msgstr "          \"A bike sure would be convenient, but it's not like...\""

#. Occurrence 5A_1:159:3925: scene=5A_1
#: 5A_1:159
msgctxt "text_id=3925 | speaker=unknown"
msgid "　ん？と首をかしげる。"
msgstr "  He tilted his head in confusion."

#. Occurrence 5A_1:164:3926: scene=5A_1
#: 5A_1:164
msgctxt "text_id=3926 | speaker=unknown"
msgid "　<益体|やくたい>も無い自分の言葉にひっかかるものを感じた草十郎だったが、もらい物の<果物|リンゴ>をどうさばくかでいっぱいだったコトもあり、あっけなくスルーした。"
msgstr "  More and more he found himself preoccupied with such random thoughts, when the real issue at hand was deciding what to do with the apples he had received."

#. Occurrence 5A_1:231:3927: scene=5A_1
#: 5A_1:231
msgctxt "text_id=3927 | speaker=unknown"
msgid "　紙袋を流し場に置いて、部屋の電気をつける。"
msgstr "  He placed the paper bag by the sink and switched on the lights."

#. Occurrence 5A_1:236:3928: scene=5A_1
#: 5A_1:236
msgctxt "text_id=3928 | speaker=unknown"
msgid "　時刻は午後十時過ぎ。"
msgstr "  It was just after ten in the evening."

#. Occurrence 5A_1:241:3929: scene=5A_1
#: 5A_1:241
msgctxt "text_id=3929 | speaker=unknown"
msgid "　試験前なのでいつもより一時間早い帰宅。"
msgstr "  With the end-of-term exams just around the corner, he had come home an hour earlier than usual."

#. Occurrence 5A_1:257:3930: scene=5A_1
#: 5A_1:257
msgctxt "text_id=3930 | speaker=unknown"
msgid "　とりあえずリンゴをひとつ食べてみるか、と台所を振り返ると、新聞受けに差しこまれた封筒に気が付いた。"
msgstr "  As he made back for the kitchen to pick one of the apples to snack on, he found an envelope stuffed in his mail slot."

#. Occurrence 5A_1:284:3931: scene=5A_1
#: 5A_1:284
msgctxt "text_id=3931 | speaker=unknown"
msgid "　差出人の明記はなく、切手すら貼っていない。"
msgstr "  The envelope had no name, return address, or stamp."

#. Occurrence 5A_1:289:3932: scene=5A_1
#: 5A_1:289
msgctxt "text_id=3932 | speaker=unknown"
msgid "　中には一枚の手紙が入っていて、用件と差出人の名前だけが書かれていた。"
msgstr "  Inside was a single piece of paper that had only the sender's name and a short message."

#. Occurrence 5A_1:327:3933: scene=5A_1
#: 5A_1:327
msgctxt "text_id=3933 | speaker=unknown"
msgid "　内容はいたってシンプルで、"
msgstr "  It read:"

#. Occurrence 5A_1:334:3934: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_1_0000; voice_prefix=A10; voice_category=1; scene=5A_1
#: 5A_1:334
msgctxt "text_id=3934 | speaker=aoko"
msgid "『話があるので今夜どこそこのここに来られたし、"
msgstr "\"There is something we need to talk about tonight."

#. Occurrence 5A_1:334:3935: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_1_0000; voice_prefix=A10; voice_category=1; scene=5A_1
#: 5A_1:334
msgctxt "text_id=3935 | speaker=aoko"
msgid "　大事な用なので来るまでずっと待っている、"
msgstr "  It's important, so I'll be waiting."

#. Occurrence 5A_1:334:3936: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_1_0000; voice_prefix=A10; voice_category=1; scene=5A_1
#: 5A_1:334
msgctxt "text_id=3936 | speaker=aoko"
msgid "　言うまでもなく他言無用―――』"
msgstr "  Needless to say, keep this a secret.\""

#. Occurrence 5A_1:340:3937: scene=5A_1
#: 5A_1:340
msgctxt "text_id=3937 | speaker=unknown"
msgid "　という<旨|むね>が、簡潔、かつ凛々しい文字で<綴|つづ>られていた。"
msgstr "  A concise set of orders, neatly written."

#. Occurrence 5A_1:360:3938: scene=5A_1
#: 5A_1:360
msgctxt "text_id=3938 | speaker=unknown"
msgid "　差出人の名前は蒼崎青子とある。"
msgstr "  It was signed Aoko Aozaki."

#. Occurrence 5A_1:365:3939: scene=5A_1
#: 5A_1:365
msgctxt "text_id=3939 | speaker=unknown"
msgid "　丁寧な事に、待ちあわせ場所の詳細な地図まで同封されていた。"
msgstr "  She had been considerate enough to enclose a detailed map of the meeting place."

#. Occurrence 5A_1:370:3940: scene=5A_1
#: 5A_1:370
msgctxt "text_id=3940 | speaker=unknown"
msgid "　ふむ、と少しだけ首をかしげて、彼はアパートを後にした。"
msgstr "  Puzzled, he cocked his head to the side then headed out the door."

#. Occurrence 5A_1:428:3941: scene=5A_1
#: 5A_1:428
msgctxt "text_id=3941 | speaker=unknown"
msgid "　……その後。"
msgstr "  Afterward..."

#. Occurrence 5A_1:435:3942: scene=5A_1
#: 5A_1:435
msgctxt "text_id=3942 | speaker=unknown"
msgid "　主人のいなくなった部屋で残された封筒はひとりでに燃えだし、はじめから何も無かったかのように、跡形もなく消滅した。"
msgstr "  Upon the room's sole tenant leaving the premises, the envelope burst into flames and evaporated without a trace, as though it had never existed in the first place."

#. Occurrence 5A_1:499:3943: scene=5A_1
#: 5A_1:499
msgctxt "text_id=3943 | speaker=unknown"
msgid "　高度成長期もひとまずの落ち着きを見せ、安定期に入った８０年代後半。"
msgstr "  By the late '80s, Japan's postwar economic boom had somewhat stabilized and the city experienced a period of steady growth."

#. Occurrence 5A_1:504:3944: scene=5A_1
#: 5A_1:504
msgctxt "text_id=3944 | speaker=unknown"
msgid "　街の近代化は着々と進み、新時代を代表するＪＲの駅が落成しようとしていた頃。"
msgstr "  The city's modernization marched on, and the Japan Railways train station, a symbol of the new era, neared completion."

#. Occurrence 5A_1:510:3945: scene=5A_1
#: 5A_1:510
msgctxt "text_id=3945 | speaker=unknown"
msgid "　三咲町の隣町である<社木|やしろぎ>に、またひとつ、町の新しいシンボルが生まれようとしていた。"
msgstr "  In Misaki's neighboring town of Yashirogi, a new symbol of its own was about to be born."

#. Occurrence 5A_1:564:3946: scene=5A_1
#: 5A_1:564
msgctxt "text_id=3946 | speaker=unknown"
msgid "　その名はやしろぎブレッド＆キッツィーランド。"
msgstr "  Yashirogi Bread & Kitsy Land."

#. Occurrence 5A_1:570:3947: scene=5A_1
#: 5A_1:570
msgctxt "text_id=3947 | speaker=unknown"
msgid "　三咲市最大の不良債権。"
msgstr "  It was Misaki's worst investment."

#. Occurrence 5A_1:575:3948: scene=5A_1
#: 5A_1:575
msgctxt "text_id=3948 | speaker=unknown"
msgid "　<後|のち>にバブルのあだ花と言われる、一つの時代の残骸である。"
msgstr "  Years later, it would be dubbed the fool's gold of the economic bubble, a relic of a bygone age."

#. Occurrence 5A_1:597:3949: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_5A_1_0000; voice_prefix=B90; voice_category=14; scene=5A_1
#: 5A_1:597
msgctxt "text_id=3949 | speaker=yurihiko"
msgid "“この町には<夢|ゆめ>とか<洒脱|しゃだつ>さが足りない”"
msgstr "\"This city lacks aspiration and sophistication.\""

#. Occurrence 5A_1:603:3950: scene=5A_1
#: 5A_1:603
msgctxt "text_id=3950 | speaker=unknown"
msgid "　今をさかのぼること十年前。"
msgstr "  Ten years ago..."

#. Occurrence 5A_1:608:3951: scene=5A_1
#: 5A_1:608
msgctxt "text_id=3951 | speaker=unknown"
msgid "　社木の名士であり、全国に多くの工場をかまえる<土桔|ときつ>製パン株式会社―――通称トッパンの経営者・<土桔|トキツ><由里彦|ユリヒコ>翁（当時五十六歳）はそんな使命感を合い言葉に、所有地であった社木郊外の土地を開放、三咲市を代表するレジャーランドの建築に着手した。"
msgstr "  Yashirogi's renowned Tokitsu Baking Company ran factories all across the nation. Its proprietor was a middle-aged gentleman (then age fifty-six) by the name of Yurihiko Tokitsu, known affectionately by most as Toppan. He took it upon himself to begin development on an estate on the outskirts of Yashirogi and broke ground on a recreational wonderland that he hoped to be the pride of Misaki City."

#. Occurrence 5A_1:628:3952: scene=5A_1
#: 5A_1:628
msgctxt "text_id=3952 | speaker=unknown"
msgid "　こうして運命の１９８１年。"
msgstr "  The long-awaited opening came in 1981."

#. Occurrence 5A_1:633:3953: scene=5A_1
#: 5A_1:633
msgctxt "text_id=3953 | speaker=unknown"
msgid "　完成までに三年の月日を費やし、夢とユーモアあふれる地域密着型遊園地・やしろぎブレッド＆キッツィーランドはその短い人生をスタートさせた。"
msgstr "  After three years of investment, this local amusement park, full of all kinds of hopes and dreams, began its short-lived tenure."

#. Occurrence 5A_1:653:3954: scene=5A_1
#: 5A_1:653
msgctxt "text_id=3954 | speaker=unknown"
msgid "　敷地面積三十五万㎡。"
msgstr "  It covered more than eighty-five square acres."

#. Occurrence 5A_1:660:3955: scene=5A_1
#: 5A_1:660
msgctxt "text_id=3955 | speaker=unknown"
msgid "　<入り口|ゲート>をくぐった人々の目を奪う豪華絢爛なメリーゴーラウンド。"
msgstr "  Its magnificent merry-go-round dazzled all who passed through the park's gates."

#. Occurrence 5A_1:665:3956: scene=5A_1
#: 5A_1:665
msgctxt "text_id=3956 | speaker=unknown"
msgid "　のたうつ龍のように遊園地をぐるりと囲むコースター。"
msgstr "  Its roller coaster twisted and turned about the edges of the park like a writhing Japanese dragon."

#. Occurrence 5A_1:674:3957: scene=5A_1
#: 5A_1:674
msgctxt "text_id=3957 | speaker=unknown"
msgid "　当時の建築技術の限界に挑んだといわれる、無駄にギミック満載な観覧車。"
msgstr "  Its Ferris wheel, packed beyond necessity with gimmicks, was said to have tested the limits of modern engineering."

#. Occurrence 5A_1:695:3958: speaker=yurihiko; speaker_ja=由里彦; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B90_5A_1_0001; voice_prefix=B90; voice_category=14; scene=5A_1
#: 5A_1:695
msgctxt "text_id=3958 | speaker=yurihiko"
msgid "“完璧だ。遊園地に必要なものはすべてつぎこんだ”"
msgstr "\"It's perfect, infused with everything an amusement park could ever need.\""

#. Occurrence 5A_1:703:3959: scene=5A_1
#: 5A_1:703
msgctxt "text_id=3959 | speaker=unknown"
msgid "　自らの仕事っぷりに目を細める由里彦翁。"
msgstr "  Old Yurihiko looked upon his creation and smiled."

#. Occurrence 5A_1:708:3960: scene=5A_1
#: 5A_1:708
msgctxt "text_id=3960 | speaker=unknown"
msgid "　その自信を裏付けるように、開園当時の盛況はこの世の春だったという。"
msgstr "  Only boosting his confidence was the fact that its grand opening was staged during a period of prosperity, the springtime of the world."

#. Occurrence 5A_1:713:3961: scene=5A_1
#: 5A_1:713
msgctxt "text_id=3961 | speaker=unknown"
msgid "　だが。"
msgstr "  But..."

#. Occurrence 5A_1:748:3962: scene=5A_1
#: 5A_1:748
msgctxt "text_id=3962 | speaker=unknown"
msgid "　だがしかし。"
msgstr "  In spite of this."

#. Occurrence 5A_1:753:3963: scene=5A_1
#: 5A_1:753
msgctxt "text_id=3963 | speaker=unknown"
msgid "　夢と洒脱のバランスを、彼らは豪快に間違えていた。"
msgstr "  They splendidly miscalculated the balance between aspirations and sophistication."

#. Occurrence 5A_1:804:3964: scene=5A_1
#: 5A_1:804
msgctxt "text_id=3964 | speaker=unknown"
msgid "　あまりにも不細工、かつパチもん臭いオリジナルマスコット・キッツィーちゃん。"
msgstr "  Its mascot, Kitsy, was poorly designed and appeared like a cheap knockoff."

#. Occurrence 5A_1:809:3965: scene=5A_1
#: 5A_1:809
msgctxt "text_id=3965 | speaker=unknown"
msgid "　必要以上に園内をにぎわす焼きたてブレッドの売店。"
msgstr "  The park was stuffed to the brim with bread stands."

#. Occurrence 5A_1:814:3966: scene=5A_1
#: 5A_1:814
msgctxt "text_id=3966 | speaker=unknown"
msgid "　８０年初頭から流行しだした大迷路を極限まで難解にしたミラーメイズ。"
msgstr "  Even its impossible-to-navigate mirror maze seemed out of date from the start."

#. Occurrence 5A_1:834:3967: scene=5A_1
#: 5A_1:834
msgctxt "text_id=3967 | speaker=unknown"
msgid "“キッツィーランドにドリームはない。"
msgstr "\"There are no dreams to be had at Kitsy Land."

#. Occurrence 5A_1:834:3968: scene=5A_1
#: 5A_1:834
msgctxt "text_id=3968 | speaker=unknown"
msgid "　ただ悪夢のようなユーモアがあるだけだ”"
msgstr "  Only nightmarish satire.\""

#. Occurrence 5A_1:840:3969: scene=5A_1
#: 5A_1:840
msgctxt "text_id=3969 | speaker=unknown"
msgid "　各種専門誌はこぞってキッツィーランドの欠点をあげつらい、客足は減少。"
msgstr "  Numerous trade magazines lambasted Kitsy Land's shortcomings, and customer attendance declined."

#. Occurrence 5A_1:845:3970: scene=5A_1
#: 5A_1:845
msgctxt "text_id=3970 | speaker=unknown"
msgid "　また、不運な事に母親とはぐれた六歳児が園内の施設で遭難し、衰弱死寸前で救出される事件まで起きてしまった。"
msgstr "  There was even an incident where a six-year-old strayed from his mother, had an accident, and nearly died."

#. Occurrence 5A_1:899:3971: scene=5A_1
#: 5A_1:899
msgctxt "text_id=3971 | speaker=unknown"
msgid "　開園から五年後の１９８６年。"
msgstr "  1986, five years after the park opened."

#. Occurrence 5A_1:910:3972: scene=5A_1
#: 5A_1:910
msgctxt "text_id=3972 | speaker=unknown"
msgid "　悪化の一途をたどる経営不振、"
msgstr "  The situation had grown from bad to worse, and the park was hemorrhaging money."

#. Occurrence 5A_1:915:3973: scene=5A_1
#: 5A_1:915
msgctxt "text_id=3973 | speaker=unknown"
msgid "　キッツィーちゃんのブレイクに余生をかけていた由里彦翁の引退が重なり、キッツィーランドの運営は困難となった。"
msgstr "  On top of everything, Yurihiko, who had bet everything on the success of mascot Kitsy, retired, and Kitsy Land's operations were officially in trouble."

#. Occurrence 5A_1:921:3974: scene=5A_1
#: 5A_1:921
msgctxt "text_id=3974 | speaker=unknown"
msgid "　こうして、地域の人々に惜しまれながらも三咲市唯一の遊園地は、その短い一生を終えたのだった。"
msgstr "  And thus, amidst the scorn of nearly all residents of the area, ended Misaki City's one and only amusement park."

#. Occurrence 5A_1:945:3975: scene=5A_1
#: 5A_1:945
msgctxt "text_id=3975 | speaker=unknown"
msgid "　……また。"
msgstr "  What's more..."

msgctxt "text_id=3976 | speaker=unknown"
msgid "　余談ではあるが、キッツィーちゃんをデザインしたパリ在住（自称）のアーティスト、トッキー・ユーリッヒ氏も、閉園を<悼|いた>むようにその筆を折ったという。"
msgstr "  Perhaps best described as a footnote to this debacle, the (self-proclaimed) Parisian artist who designed the mascot, Toki Julich, was said to have snapped his brush in mourning over the closure of the park."

#. Occurrence 5A_1:983:3977: scene=5A_1
#: 5A_1:983
msgctxt "text_id=3977 | speaker=unknown"
msgid "　そして現在。"
msgstr "  Returning to the present..."

#. Occurrence 5A_1:1005:3978: scene=5A_1
#: 5A_1:1005
msgctxt "text_id=3978 | speaker=unknown"
msgid "　深夜零時のキッツィーランドは、かつての栄華など微塵も見られない。"
msgstr "  It was midnight, and the Kitsy Land of today was a shadow of its former glory."

#. Occurrence 5A_1:1010:3979: scene=5A_1
#: 5A_1:1010
msgctxt "text_id=3979 | speaker=unknown"
msgid "　オモチャ箱の片隅においやられた人形のように、ひとり寂しく、今も生き続ける町からの明かりに照らされている。"
msgstr "  Like a doll abandoned in the corner of a toy box, the lonely park was illuminated only by the light of the town that continued to live around it."

#. Occurrence 5A_1:1031:3980: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_1_0001; voice_prefix=A30; voice_category=3; scene=5A_1
#: 5A_1:1031
msgctxt "text_id=3980 | speaker=soujuurou"
msgid "「なるほど」"
msgstr "\"So that's what happened.\""

#. Occurrence 5A_1:1037:3981: scene=5A_1
#: 5A_1:1037
msgctxt "text_id=3981 | speaker=unknown"
msgid "　草十郎はぱたん、と来る途中で拾った『社木案内のしおり』を閉じた。"
msgstr "  Soujyuro closed the Yashirogi guidebook that he had picked up on the way here."

#. Occurrence 5A_1:1042:3982: scene=5A_1
#: 5A_1:1042
msgctxt "text_id=3982 | speaker=unknown"
msgid "　いまいち実感の湧かない歴史だが、これも<必衰|ひっすい>というヤツだろう、と納得する。"
msgstr "  The story of its history was almost difficult to believe, but he supposed this was what people referred to as entropy."

#. Occurrence 5A_1:1088:3983: scene=5A_1
#: 5A_1:1088
msgctxt "text_id=3983 | speaker=unknown"
msgid "　遊園地の正門は施錠されていなかった。"
msgstr "  The park's front gate was unlocked."

#. Occurrence 5A_1:1093:3984: scene=5A_1
#: 5A_1:1093
msgctxt "text_id=3984 | speaker=unknown"
msgid "　以前アルバイトにきた時、<鉄柵|いりぐち>は錆びた鎖によって施錠されていたが、今は外され、鉄柵も少しだけ開いている。"
msgstr "  When he worked here the previous time, the iron fence was locked shut with a rusty chain, but the chain was nowhere to be seen and the gate left ajar."

#. Occurrence 5A_1:1114:3985: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_1_0002; voice_prefix=A30; voice_category=3; scene=5A_1
#: 5A_1:1114
msgctxt "text_id=3985 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5A_1:1133:3986: scene=5A_1
#: 5A_1:1133
msgctxt "text_id=3986 | speaker=unknown"
msgid "　草十郎は手紙に描かれた地図にしたがって、ひょこっと園内に侵入する。"
msgstr "  Following the map drawn in the letter, Soujyuro quickly made his way inside."

#. Occurrence 5A_1:1156:3987: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_1_0003; voice_prefix=A30; voice_category=3; scene=5A_1
#: 5A_1:1156
msgctxt "text_id=3987 | speaker=soujuurou"
msgid "「……急ぎの用なんだろうけど。こんな夜中に、なんなんだいったい」"
msgstr "\"...It sounded urgent, but to meet this late at night? What in the world could she want?\""

#. Occurrence 5A_1:1162:3988: scene=5A_1
#: 5A_1:1162
msgctxt "text_id=3988 | speaker=unknown"
msgid "　らしくなく<愚|ぐ><痴|ち>を言う。"
msgstr "  Soujyuro complained, quite out of character for him."

#. Occurrence 5A_1:1192:3989: scene=5A_1
#: 5A_1:1192
msgctxt "text_id=3989 | speaker=unknown"
msgid "　世間知らずな彼にでも、この行為がよくない事だと分かっているからだろう。"
msgstr "  It was probably because, in spite of his naivety, even he knew that something was amiss."

#. Occurrence 5A_1:1197:3990: scene=5A_1
#: 5A_1:1197
msgctxt "text_id=3990 | speaker=unknown"
msgid "　廃墟になったとはいえ、立ち入り禁止の遊園地に忍びこんでいる。"
msgstr "  Though the park was abandoned, this was still trespassing."

#. Occurrence 5A_1:1202:3991: scene=5A_1
#: 5A_1:1202
msgctxt "text_id=3991 | speaker=unknown"
msgid "　不法侵入、窃盗、泥棒。"
msgstr "  Unlawful entry, larceny, burglary..."

#. Occurrence 5A_1:1208:3992: scene=5A_1
#: 5A_1:1208
msgctxt "text_id=3992 | speaker=unknown"
msgid "決して胸を張れる事ではなく、犯罪と言えば犯罪なのだが―――"
msgstr "These were certainly not things, or perhaps crimes, that Soujyuro was proud to do, but..."

#. Occurrence 5A_1:1229:3993: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_1_0004; voice_prefix=A30; voice_category=3; scene=5A_1
#: 5A_1:1229
msgctxt "text_id=3993 | speaker=soujuurou"
msgid "「……すまない、お金は払えないんだ。"
msgstr "\"...Sorry, I can't pay you any money."

#. Occurrence 5A_1:1235:3994: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_1_0005; voice_prefix=A30; voice_category=3; scene=5A_1
#: 5A_1:1235
msgctxt "text_id=3994 | speaker=soujuurou"
msgid "　タダで入って申しわけない」"
msgstr "  I'm really sorry for coming in for free.\""

#. Occurrence 5A_1:1251:3995: scene=5A_1
#: 5A_1:1251
msgctxt "text_id=3995 | speaker=unknown"
msgid "　彼にとって後ろめたいのはその一点だけらしい。"
msgstr "  Money, apparently, was why his conscience was gnawing at him."

#. Occurrence 5A_1:1256:3996: scene=5A_1
#: 5A_1:1256
msgctxt "text_id=3996 | speaker=unknown"
msgid "　目のペンキがいい感じで<融解|とけだ>しているキッツィーちゃん像に、ぱんぱん、と手を合わせる。"
msgstr "  He clapped his hands in apology toward the statue of Kitsy, on whose eyes the paint had begun to aptly dissolve."

#. Occurrence 5A_1:1261:3997: scene=5A_1
#: 5A_1:1261
msgctxt "text_id=3997 | speaker=unknown"
msgid "　赤ペンキを<眼窩|がんか>から流すマスコットを通過して、草十郎は夜の遊園地へと歩き出した。"
msgstr "  Soujyuro passed the mascot bleeding red paint from its eye sockets and began to walk the night park."

#. Occurrence 5A_1:1307:3998: scene=5A_1
#: 5A_1:1307
msgctxt "text_id=3998 | speaker=unknown"
msgid "　色落ちた建物。"
msgstr "  The buildings' colors had faded."

#. Occurrence 5A_1:1312:3999: scene=5A_1
#: 5A_1:1312
msgctxt "text_id=3999 | speaker=unknown"
msgid "　錆び付いた機械の群。"
msgstr "  The collection of machines was rusted."

#. Occurrence 5A_1:1317:4000: scene=5A_1
#: 5A_1:1317
msgctxt "text_id=4000 | speaker=unknown"
msgid "　もう時を刻むことのない、作り物の住人たち。"
msgstr "  The man-made residents no longer felt the passage of time."

#. Occurrence 5A_1:1322:4001: scene=5A_1
#: 5A_1:1322
msgctxt "text_id=4001 | speaker=unknown"
msgid "　かつての栄華とのあまりの落差に、幽霊すらいたたまれず住み着かなくなったゴーストタウン。"
msgstr "  Even the ghosts themselves could not endure the disparity between this forsaken place and its previous grand stature."

#. Occurrence 5A_1:1342:4002: scene=5A_1
#: 5A_1:1342
msgctxt "text_id=4002 | speaker=unknown"
msgid "　―――まるで<童話|ユメ>の化石だ。"
msgstr "  It was like a fossilized dream."

#. Occurrence 5A_1:1348:4003: scene=5A_1
#: 5A_1:1348
msgctxt "text_id=4003 | speaker=unknown"
msgid "　ここは<現実|人の手>によって造られながら、<現実|ひとびと>に置き去りにされた楽園の跡。"
msgstr "  These were the ruins of a paradise both created and abandoned by man and reality."

#. Occurrence 5A_1:1354:4004: scene=5A_1
#: 5A_1:1354
msgctxt "text_id=4004 | speaker=unknown"
msgid "　経済が安定し、"
msgstr "  The economy had stabilized,"

msgctxt "text_id=4005 | speaker=unknown"
msgid "　人々の生活水準は右肩あがりで、誰もが未来に不安を抱かなかった、狂騒の時代の遺物である。"
msgstr "  and the standard of living was on the rise. Nobody was overly concerned with the future. These were the remains of a wild and exciting era."

#. Occurrence 5A_1:1419:4006: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_1_0006; voice_prefix=A30; voice_category=3; scene=5A_1
#: 5A_1:1419
msgctxt "text_id=4006 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5A_1:1425:4007: scene=5A_1
#: 5A_1:1425
msgctxt "text_id=4007 | speaker=unknown"
msgid "　白い息を吐きながら、草十郎は廃遊園地を歩いていく。"
msgstr "  His breath turning to white wisps before him, Soujyuro continued through the abandoned amusement park."

#. Occurrence 5A_1:1430:4008: scene=5A_1
#: 5A_1:1430
msgctxt "text_id=4008 | speaker=unknown"
msgid "　人気はないが、山中の闇に比べればそう怖くもない。"
msgstr "  Though void of human presence, this was not nearly as frightening as the darkness deep in the mountains."

#. Occurrence 5A_1:1450:4009: scene=5A_1
#: 5A_1:1450
msgctxt "text_id=4009 | speaker=unknown"
msgid "　郊外といっても様々で、キッツィーランドは遊園地にしては珍しく、住宅地の<傍|そば>に造られている。"
msgstr "  City suburbs can take many different forms, but Kitsy Land was unusual for an amusement park insomuch as it had been built adjacent to a residential district."

#. Occurrence 5A_1:1455:4010: scene=5A_1
#: 5A_1:1455
msgctxt "text_id=4010 | speaker=unknown"
msgid "　遊園地は林に囲まれているが、それも所詮は人工のもの。教室の窓を閉ざすカーテンとなんら変わりはない。"
msgstr "  The park was surrounded by a forest, but even that, ultimately, was man-made. It was no different from the curtains on a classroom window."

#. Occurrence 5A_1:1478:4011: scene=5A_1
#: 5A_1:1478
msgctxt "text_id=4011 | speaker=unknown"
msgid "　キッツィーランドを囲む鉄柵を越え、二十メートルほど造林された木々を抜ければ、簡単に見慣れた町並みに帰ることができる。"
msgstr "  If he were to scale the iron fence encircling Kitsy Land and break through the twenty yards of afforested trees, he could make it back to the familiar townscape."

#. Occurrence 5A_1:1483:4012: scene=5A_1
#: 5A_1:1483
msgctxt "text_id=4012 | speaker=unknown"
msgid "　都会の人間にとって夜の遊園地は恐怖を喚起させるものだが、草十郎にとっては、この遊園地も駅前の喧噪も“怖さ”の深度は同じだった。"
msgstr "  Though the amusement park tended to arouse dread in the city folk, to Soujyuro it was little different from the commotion and terror of downtown."

#. Occurrence 5A_10:63:4013: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0000; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:63
msgctxt "text_id=4013 | speaker=aoko"
msgid "“結構きついかもね、あなたの役目”"
msgstr "\"Just so you know, this is going to be pretty tough for you.\""

#. Occurrence 5A_10:69:4014: scene=5A_10
#: 5A_10:69
msgctxt "text_id=4014 | speaker=unknown"
msgid "　草十郎にそう告げて、青子は静かに、可能なかぎり音を殺して走り出した。"
msgstr "  Aoko warned Soujyuro, moving as fast as she could without her footfalls causing a din of noise."

#. Occurrence 5A_10:74:4015: scene=5A_10
#: 5A_10:74
msgctxt "text_id=4015 | speaker=unknown"
msgid "　二階のほぼ中心、渦の終点には草十郎だけが残っている。"
msgstr "  Soujyuro remained near the center of the spiral maze on the second floor."

#. Occurrence 5A_10:131:4016: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0001; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:131
msgctxt "text_id=4016 | speaker=aoko"
msgid "“実を言うと、もう一つ用意しておいた仕掛けがあるの。"
msgstr "\"I'll let you in on a secret: I have another trap up my sleeve."

#. Occurrence 5A_10:137:4017: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0002; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:137
msgctxt "text_id=4017 | speaker=aoko"
msgid "　自分でもやりすぎだって呆れたもんだけど、貴方が<遊園地|ここ>に来るのが遅かったから。ちょっと興に乗っちゃって”"
msgstr "  I think I might have gone overboard with this one, but when you didn't show up on time, I just couldn't help myself.\""

#. Occurrence 5A_10:166:4018: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0000; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:166
msgctxt "text_id=4018 | speaker=soujuurou"
msgid "“……？　仕掛けって、俺用の？”"
msgstr "\"A trap? For me?\""

#. Occurrence 5A_10:186:4019: scene=5A_10
#: 5A_10:186
msgctxt "text_id=4019 | speaker=unknown"
msgid "　リスのように首をかしげる草十郎に、青子はそ、と気軽に答えて、伏せておいた最後の切り札を提示した。"
msgstr "  Soujyuro tilted his head like a squirrel as Aoko freely discussed the final ace up her sleeve."

#. Occurrence 5A_10:234:4020: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0003; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:234
msgctxt "text_id=4020 | speaker=aoko"
msgid "“地下の<支柱|はしら>に着火型の、ちょっとした魔術式を刻んでおいたの。中心の柱に点火することで、連鎖的に他の柱に仕掛けた魔術も起動する。"
msgstr "\"I engraved an ignition formula into the support pillars in the basement. If I ignite the central pillar, it will start a chain reaction that will ignite the rest."

#. Occurrence 5A_10:240:4021: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0004; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:240
msgctxt "text_id=4021 | speaker=aoko"
msgid "　ジャミングを食らう前に作ったものだから、直接魔力をたたき込めば一気に、こう、いくわ”"
msgstr "  I made it before that thing started jamming me, so if I infuse it with a bit of magical energy, it'll go boom.\""

#. Occurrence 5A_10:246:4022: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0001; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:246
msgctxt "text_id=4022 | speaker=soujuurou"
msgid "“………………”"
msgstr "\"...\""

#. Occurrence 5A_10:251:4023: scene=5A_10
#: 5A_10:251
msgctxt "text_id=4023 | speaker=unknown"
msgid "　具体的な表現を避ける青子に、一抹の不安を隠せない草十郎なのだった。"
msgstr "  Soujyuro was a little unsettled by how unclear that last bit was."

#. Occurrence 5A_10:291:4024: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0002; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:291
msgctxt "text_id=4024 | speaker=soujuurou"
msgid "“……蒼崎。こう、じゃ分からない。できるだけ明確に、どこまで爆破する気だったのか白状してくれ。"
msgstr "\"...Aozaki, could you, um, clarify? I want to know how much you were going to blow me up. Please be honest."

#. Occurrence 5A_10:297:4025: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0003; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:297
msgctxt "text_id=4025 | speaker=soujuurou"
msgid "　あと、もしかして俺、早まったか？”"
msgstr "  Also, did I make a mistake agreeing to team up with you?\""

#. Occurrence 5A_10:331:4026: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0005; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:331
msgctxt "text_id=4026 | speaker=aoko"
msgid "“いや、その……単なる保険って言うか。"
msgstr "\"Don't be silly. It was just an... insurance policy. Yeah."

#. Occurrence 5A_10:337:4027: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0006; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:337
msgctxt "text_id=4027 | speaker=aoko"
msgid "　追いかけっこの途中でアンタを見失ったら、いっそ建物ごと爆破しちゃおうかなー、って”"
msgstr "  I just thought that if I lost sight of you at any point, I could blow the whole building and you with it.\""

#. Occurrence 5A_10:525:4028: scene=5A_10
#: 5A_10:525
msgctxt "text_id=4028 | speaker=unknown"
msgid "　なにごとも徹底しておくものねー、と照れ笑いをしながら頭を<掻|か>く青子。"
msgstr "  It was her policy to be thorough to a fault, after all. She laughed, embarrassed to hear herself say it aloud."

#. Occurrence 5A_10:532:4029: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0004; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:532
msgctxt "text_id=4029 | speaker=soujuurou"
msgid "“いくらなんでも徹底しすぎてる！”"
msgstr "\"Don't you think that's overkill!?\""

#. Occurrence 5A_10:538:4030: scene=5A_10
#: 5A_10:538
msgctxt "text_id=4030 | speaker=unknown"
msgid "　そんな青子の暴虐ぶりに、草十郎は状況を忘れて、心底からの感想で抗議した。"
msgstr "  Faced with Aoko's cruelty, Soujyuro forgot about the situation at hand and protested from the bottom of his heart."

#. Occurrence 5A_10:589:4031: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0007; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:589
msgctxt "text_id=4031 | speaker=aoko"
msgid "「……なによ。いいじゃない、そのおかげでなんとかなりそうなんだから」"
msgstr "\"...Stop complaining. At least now we have a way to fight back.\""

#. Occurrence 5A_10:595:4032: scene=5A_10
#: 5A_10:595
msgctxt "text_id=4032 | speaker=unknown"
msgid "　……などと。"
msgstr "  She shot back."

#. Occurrence 5A_10:600:4033: scene=5A_10
#: 5A_10:600
msgctxt "text_id=4033 | speaker=unknown"
msgid "　草十郎が聞いたら<協力|けいかく>を白紙に戻しかねない<愚|グ><痴|チ>をこぼしつつ、青子は通路をひた走る。"
msgstr "  Aoko dashed down the corridor mumbling things that probably would have sent Soujyuro packing if he heard them."

#. Occurrence 5A_10:633:4034: scene=5A_10
#: 5A_10:633
msgctxt "text_id=4034 | speaker=unknown"
msgid "　作戦はシンプルだ。"
msgstr "  The strategy was simple."

#. Occurrence 5A_10:649:4035: scene=5A_10
#: 5A_10:649
msgctxt "text_id=4035 | speaker=unknown"
msgid "　青子は右に曲がる抜け道を利用し、人形を避けて地下一階まで移動。"
msgstr "  Aoko would use the escape route to the right and avoid the puppet while making her way down to the basement."

#. Occurrence 5A_10:654:4036: scene=5A_10
#: 5A_10:654
msgctxt "text_id=4036 | speaker=unknown"
msgid "　地下中央の柱まで辿り着き、仕掛けておいた魔術式に直接魔力を注入し、脱出する。"
msgstr "  Upon reaching the central pillar, she would infuse the formula she had prepared with magical energy and escape."

#. Occurrence 5A_10:659:4037: scene=5A_10
#: 5A_10:659
msgctxt "text_id=4037 | speaker=unknown"
msgid "　魔術式が起動し、崩壊がミラーハウス全体に広がるまで早くて一分、その後の倒壊まであと一分。"
msgstr "  Once ignited, it would take about a minute for the chain reaction to spread throughout the whole house of mirrors, and another minute for the building to collapse."

#. Occurrence 5A_10:675:4038: scene=5A_10
#: 5A_10:675
msgctxt "text_id=4038 | speaker=unknown"
msgid "　……厳しいが、迷路を暗記している青子ならギリギリで脱出できるスケジュールだ。"
msgstr "  ...She would be cutting it a little close, but because she had committed the maze to memory, she was sure she could make it out in time."

#. Occurrence 5A_10:721:4039: scene=5A_10
#: 5A_10:721
msgctxt "text_id=4039 | speaker=unknown"
msgid "　人形による入り口の<結界|かべ>は、柱の連鎖爆破で吹き飛ぶ程度だろうと青子は予想している。"
msgstr "  Aoko assumed that the chain reaction caused by the pillar would clear the barrier that the puppet had placed at the entrance."

#. Occurrence 5A_10:726:4040: scene=5A_10
#: 5A_10:726
msgctxt "text_id=4040 | speaker=unknown"
msgid "　仮にもっと上等な結界だとしても、建物全体が歪んでしまえば消えざるを得ない。地下の魔術式さえ起動させれば草十郎の脱出路は確保できる。"
msgstr "  And even if it was strong enough to withstand the blast, it would not be able to stay standing once the foundations buckled. Soujyuro's escape was assured as long as the formula in the basement was activated."

#. Occurrence 5A_10:761:4041: scene=5A_10
#: 5A_10:761
msgctxt "text_id=4041 | speaker=unknown"
msgid "　最後に、肝心の標的について。"
msgstr "  Next came the most important part."

#. Occurrence 5A_10:779:4042: scene=5A_10
#: 5A_10:779
msgctxt "text_id=4042 | speaker=unknown"
msgid "　あのオートマタは遮蔽物だらけの<この場所|ミラーハウス>を苦手としている。アレは構造上、この地形での全速移動はできない。"
msgstr "  The automaton was at a disadvantage in the obstacle-laden house of mirrors and was unable to move at full speed."

#. Occurrence 5A_10:784:4043: scene=5A_10
#: 5A_10:784
msgctxt "text_id=4043 | speaker=unknown"
msgid "　建物が崩壊しだした時に二階の中心付近にいれば、倒壊に巻きこまれてあえなくスクラップだ。"
msgstr "  If it was near the center of the second floor when the building collapsed, it would be caught up and crushed by it."

#. Occurrence 5A_10:801:4044: scene=5A_10
#: 5A_10:801
msgctxt "text_id=4044 | speaker=unknown"
msgid "　なので問題は、青子が地下に行くまで、いかにして人形を二階に押しとどめておくか、という事だった。"
msgstr "  So the problem was keeping the puppet on the second floor until Aoko could make it down to the basement."

#. Occurrence 5A_10:822:4045: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0008; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:822
msgctxt "text_id=4045 | speaker=aoko"
msgid "“……アテにしたからね、静希君。"
msgstr "\"...I'm counting on you, Sizuki."

#. Occurrence 5A_10:822:4046: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0008; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:822
msgctxt "text_id=4046 | speaker=aoko"
msgid "　せめて三分ぐらいは引き付けて―――”"
msgstr "  I just need you to keep it occupied for three minutes.\""

#. Occurrence 5A_10:883:4047: scene=5A_10
#: 5A_10:883
msgctxt "text_id=4047 | speaker=unknown"
msgid "　青子が地下に到達し、魔術式を起動させるまで人形を引き付けてくれるなら文句なし。"
msgstr "  Ideally, he would be able to keep it busy until she could activate the formula."

#. Occurrence 5A_10:888:4048: scene=5A_10
#: 5A_10:888
msgctxt "text_id=4048 | speaker=unknown"
msgid "　もしくは、せめて一階の大広間に下りるまで囮になってくれれば、この作戦は上手くいく。"
msgstr "  If that failed to work, him luring it down to the first floor would be the next best thing."

#. Occurrence 5A_10:908:4049: scene=5A_10
#: 5A_10:908
msgctxt "text_id=4049 | speaker=unknown"
msgid "　草十郎が危険なのは百も承知だが、<青子|じぶん>からあれだけ逃げ回った草十郎の運と脚力は馬鹿にできない。"
msgstr "  She understood perfectly well the danger she was putting Soujyuro in, but his lucky streak and running speed were nothing to scoff at."

#. Occurrence 5A_10:935:4050: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0009; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:935
msgctxt "text_id=4050 | speaker=aoko"
msgid "“……うん、ただ逃げるだけなら、もしかして―――"
msgstr "\"As long as all he has to do is run, then maybe...just maybe..."

#. Occurrence 5A_10:935:4051: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0009; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:935
msgctxt "text_id=4051 | speaker=aoko"
msgid "　トンデモない事をしてくれるかも、アイツ”"
msgstr "  Just maybe... he can actually pull this off.\""

#. Occurrence 5A_10:1017:4052: scene=5A_10
#: 5A_10:1017
msgctxt "text_id=4052 | speaker=unknown"
msgid "　などと。迷路の横道を走りながら、青子はつい、ここには居ない草十郎に期待をよせたのだった。"
msgstr "  Aoko made her way through the hidden passage of the maze, her hopes pinned on Soujyuro."

#. Occurrence 5A_10:1118:4053: scene=5A_10
#: 5A_10:1118
msgctxt "text_id=4053 | speaker=unknown"
msgid "　―――一方。"
msgstr "  Meanwhile..."

#. Occurrence 5A_10:1124:4054: scene=5A_10
#: 5A_10:1124
msgctxt "text_id=4054 | speaker=unknown"
msgid "　そんな青子の声が聞こえるはずもなく、草十郎は必死の追いかけっこに挑もうとしていた。"
msgstr "  Well out of earshot, Soujyuro was readying himself for another desperate chase."

#. Occurrence 5A_10:1129:4055: scene=5A_10
#: 5A_10:1129
msgctxt "text_id=4055 | speaker=unknown"
msgid "　彼は自分なりの方法で<心|む><臓|ね>の動悸を押さえつける。"
msgstr "  He calmed his beating heart using a method of his own making."

#. Occurrence 5A_10:1134:4056: scene=5A_10
#: 5A_10:1134
msgctxt "text_id=4056 | speaker=unknown"
msgid "　大事なのは落ち着く事だ。作戦自体はシンプルで、そう難しいものじゃない。"
msgstr "  What mattered most was that he remained calm. The plan was simple enough,"

#. Occurrence 5A_10:1139:4057: scene=5A_10
#: 5A_10:1139
msgctxt "text_id=4057 | speaker=unknown"
msgid "　青子の指示は短く、実に分かりやすかった。"
msgstr "  and Aoko's orders were succinct and easy to understand."

#. Occurrence 5A_10:1229:4058: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0010; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:1229
msgctxt "text_id=4058 | speaker=aoko"
msgid "“十メートルぐらいの距離を保って、できるだけゆっくり通路を三、四周する事。"
msgstr "\"Keep a distance of around thirty feet and weave through the corridors as slowly as you can three or four times."

#. Occurrence 5A_10:1235:4059: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0011; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:1235
msgctxt "text_id=4059 | speaker=aoko"
msgid "　横道は鏡のつなぎ目で覚えて。ここなら左回りで六、三、七、二枚目にあるから、そこをぐるぐる回ってれば比較的安全よ”"
msgstr "  Count the mirrors as you move to locate the hidden passages. From here, they are on the sixth, third, seventh, and second mirrors counterclockwise. Use those, and you should be relatively safe.\""

#. Occurrence 5A_10:1255:4060: scene=5A_10
#: 5A_10:1255
msgctxt "text_id=4060 | speaker=unknown"
msgid "　……要は円を描くマラソンである。"
msgstr "  It was essentially a looping marathon."

#. Occurrence 5A_10:1260:4061: scene=5A_10
#: 5A_10:1260
msgctxt "text_id=4061 | speaker=unknown"
msgid "　人形からは伸びる腕だけが届いて、ぎりぎり追跡できるじれったい距離をキープしていれば、相手はしつこく追いかけてくる筈だ。"
msgstr "  As long as Soujyuro kept just enough distance from the puppet's extended arm to allow her to track him, she could continue to chase him indefinitely."

#. Occurrence 5A_10:1265:4062: scene=5A_10
#: 5A_10:1265
msgctxt "text_id=4062 | speaker=unknown"
msgid "　単純作業だが、草十郎にとっては命懸けの囮役である。"
msgstr "  Simple though the task was, Soujyuro was putting his life on the line as bait."

#. Occurrence 5A_10:1270:4063: scene=5A_10
#: 5A_10:1270
msgctxt "text_id=4063 | speaker=unknown"
msgid "　加えて、建物が揺れだしたら全力で出口まで走れ、という無茶な注文付き。"
msgstr "  And then there was the final order to run as fast as he could to the exit when the building began to sway."

#. Occurrence 5A_10:1362:4064: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0005; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:1362
msgctxt "text_id=4064 | speaker=soujuurou"
msgid "「……けっこうじゃなくて、かなりきついんじゃないかな、コレは」"
msgstr "\"This is more than just a little tough...\""

#. Occurrence 5A_10:1430:4065: scene=5A_10
#: 5A_10:1430
msgctxt "text_id=4065 | speaker=unknown"
msgid "　おびえおびえのぎこちない動作で、草十郎は曲がり角から顔を出す。"
msgstr "  He nervously stuck his head out from around the corner."

#. Occurrence 5A_10:1435:4066: scene=5A_10
#: 5A_10:1435
msgctxt "text_id=4066 | speaker=unknown"
msgid "　……突き当たりの曲がり角からは例のオルゴールの音。"
msgstr "  He could hear the sound of the music box from the other side of the corridor."

#. Occurrence 5A_10:1440:4067: scene=5A_10
#: 5A_10:1440
msgctxt "text_id=4067 | speaker=unknown"
msgid "　まずはここで顔を合わせて、右側のショートカットを抜けて、ループ状の鬼ごっこを開始しなくてはいけない。"
msgstr "  First he had to make eye contact with it, then head through the shortcut on the right and begin their game of tag."

#. Occurrence 5A_10:1476:4068: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0006; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:1476
msgctxt "text_id=4068 | speaker=soujuurou"
msgid "「…………！」"
msgstr "\"...!\""

#. Occurrence 5A_10:1548:4069: scene=5A_10
#: 5A_10:1548
msgctxt "text_id=4069 | speaker=unknown"
msgid "　来た、と身構える。"
msgstr "  He spotted it and braced himself."

#. Occurrence 5A_10:1553:4070: scene=5A_10
#: 5A_10:1553
msgctxt "text_id=4070 | speaker=unknown"
msgid "　引きつけて、引きつけて。"
msgstr "  Closer... Closer..."

#. Occurrence 5A_10:1558:4071: scene=5A_10
#: 5A_10:1558
msgctxt "text_id=4071 | speaker=unknown"
msgid "　いつ伸びてくるか分からない腕におびえながら、草十郎は青子の説明を思いかえ―――"
msgstr "  Fearing that her arm could fly at him at any moment, he went over Aoko's instructions in his head."

#. Occurrence 5A_10:1658:4072: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0007; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:1658
msgctxt "text_id=4072 | speaker=soujuurou"
msgid "「…………あれ？」"
msgstr "\"...Wait.\""

#. Occurrence 5A_10:1664:4073: scene=5A_10
#: 5A_10:1664
msgctxt "text_id=4073 | speaker=unknown"
msgid "　ところで。"
msgstr "  However..."

#. Occurrence 5A_10:1669:4074: scene=5A_10
#: 5A_10:1669
msgctxt "text_id=4074 | speaker=unknown"
msgid "　一番はじめの横道は、何枚目だったっけ？"
msgstr "  He could not quite remember which pane led to the first hidden passage."

#. Occurrence 5A_10:1674:4075: scene=5A_10
#: 5A_10:1674
msgctxt "text_id=4075 | speaker=unknown"
msgid "　三枚目か、六枚目か、九枚目か―――"
msgstr "  The third? The sixth? The ninth...?"

#. Occurrence 5A_10:1705:4076: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0008; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:1705
msgctxt "text_id=4076 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5A_10:1711:4077: scene=5A_10
#: 5A_10:1711
msgctxt "text_id=4077 | speaker=unknown"
msgid "　違う。"
msgstr "  No..."

#. Occurrence 5A_10:1716:4078: scene=5A_10
#: 5A_10:1716
msgctxt "text_id=4078 | speaker=unknown"
msgid "　なんか、全部違う気がする。"
msgstr "  He was sure that was mistaken..."

#. Occurrence 5A_10:1721:4079: scene=5A_10
#: 5A_10:1721
msgctxt "text_id=4079 | speaker=unknown"
msgid "　さっきまでは完璧に思い返せたのに、緊張からか、草十郎の頭はぐるんぐるんに回りはじめ―――"
msgstr "  He was confident he had it memorized moments ago, but his nerves had gotten the best of him, and his head was now spinning."

#. Occurrence 5A_10:1765:4080: scene=5A_10
#: 5A_10:1765
msgctxt "text_id=4080 | speaker=unknown"
msgid "　……と。"
msgstr "  ...Then."

#. Occurrence 5A_10:1772:4081: scene=5A_10
#: 5A_10:1772
msgctxt "text_id=4081 | speaker=unknown"
msgid "　草十郎は前方にあった追跡者の<物音|プレッシャー>が、唐突に離れていく事に気が付いた。"
msgstr "  Soujyuro realized that the sound of his pursuer was beginning to grow distant."

#. Occurrence 5A_10:1777:4082: scene=5A_10
#: 5A_10:1777
msgctxt "text_id=4082 | speaker=unknown"
msgid "　それも予想外のスピードで、ガシャガシャと音をたてながら。"
msgstr "  And at an incredible speed."

#. Occurrence 5A_10:2011:4083: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0009; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:2011
msgctxt "text_id=4083 | speaker=soujuurou"
msgid "「……なに？」"
msgstr "\"...What's it doing now?\""

#. Occurrence 5A_10:2017:4084: scene=5A_10
#: 5A_10:2017
msgctxt "text_id=4084 | speaker=unknown"
msgid "　異様な人形のシルエットに、<唖然|あぜん>とする草十郎。"
msgstr "  The unusual silhouette of the puppet astonished him."

#. Occurrence 5A_10:2022:4085: scene=5A_10
#: 5A_10:2022
msgctxt "text_id=4085 | speaker=unknown"
msgid "　あろうことか、美しい少女のカタチをした人形は唐突に、"
msgstr "  Before it had taken the form of a beautiful girl,"

#. Occurrence 5A_10:2076:4086: scene=5A_10
#: 5A_10:2076
msgctxt "text_id=4086 | speaker=unknown"
msgid "　構造的にあり得ない変形をして、"
msgstr "  but now it made a bizarre transformation,"

msgctxt "text_id=4087 | speaker=unknown"
msgid "　一階に下りていった“本命”へと踵を返した。"
msgstr "  and returned to the first floor to pursue her primary target."

#. Occurrence 5A_10:2200:4088: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0010; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:2200
msgctxt "text_id=4088 | speaker=soujuurou"
msgid "「あ―――いや、それは」"
msgstr "\"Oh... This isn't the plan.\""

#. Occurrence 5A_10:2206:4089: scene=5A_10
#: 5A_10:2206
msgctxt "text_id=4089 | speaker=unknown"
msgid "　まずいな、と呟いて、途方にくれる草十郎。"
msgstr "  Soujyuro was no longer sure what to do."

#. Occurrence 5A_10:2211:4090: scene=5A_10
#: 5A_10:2211
msgctxt "text_id=4090 | speaker=unknown"
msgid "　失敗を悔やむ時間すらない。人形はもう影もカタチもなく、草十郎の前から走り去ってしまったのだ。"
msgstr "  Before he'd even had time to mourn his failure, the puppet had vanished out of sight."

#. Occurrence 5A_10:2216:4091: scene=5A_10
#: 5A_10:2216
msgctxt "text_id=4091 | speaker=unknown"
msgid "“役に立つから見逃してくれ”"
msgstr "\"I'll help, so let me go.\""

#. Occurrence 5A_10:2221:4092: scene=5A_10
#: 5A_10:2221
msgctxt "text_id=4092 | speaker=unknown"
msgid "　……などと言っておいて、コレでは立場も何もない。"
msgstr "  Or so he had said, but now he could not follow through."

#. Occurrence 5A_10:2292:4093: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_10_0012; voice_prefix=A30; voice_category=3; scene=5A_10
#: 5A_10:2292
msgctxt "text_id=4093 | speaker=soujuurou"
msgid "「…………さて、自分はこれからどうしよう」"
msgstr "\"...So, what am I supposed to do now?\""

#. Occurrence 5A_10:2298:4094: scene=5A_10
#: 5A_10:2298
msgctxt "text_id=4094 | speaker=unknown"
msgid "　ひとり、困ったように首をかしげる。"
msgstr "  Alone, he tilted his head in frustration."

#. Occurrence 5A_10:2303:4095: scene=5A_10
#: 5A_10:2303
msgctxt "text_id=4095 | speaker=unknown"
msgid "　草十郎は<傍|かたわ>らに青子がいるかのように、暗い通路に語りかけた。"
msgstr "  He spoke into the darkness as if Aoko would be there to answer him."

#. Occurrence 5A_10:2391:4096: scene=5A_10
#: 5A_10:2391
msgctxt "text_id=4096 | speaker=unknown"
msgid "　同時刻。"
msgstr "  Meanwhile, downstairs..."

msgctxt "text_id=4097 | speaker=unknown"
msgid "青子は一階の広間に辿り着いた時、正しく状況を受け入れた。"
msgstr " As soon as she arrived on the first floor, Aoko understood what had transpired above her."

#. Occurrence 5A_10:2413:4098: scene=5A_10
#: 5A_10:2413
msgctxt "text_id=4098 | speaker=unknown"
msgid "　耳を澄ませるまでもない。"
msgstr "  She did not even have to strain her ears to hear the puppet."

#. Occurrence 5A_10:2418:4099: scene=5A_10
#: 5A_10:2418
msgctxt "text_id=4099 | speaker=unknown"
msgid "　このアトラクションが<栄華|えいが>を誇っていた頃ですら、なかったであろう<騒音|にぎわい>。"
msgstr "  Even during its heyday, this attraction had never made sounds like the one she heard coming toward her now."

#. Occurrence 5A_10:2423:4100: scene=5A_10
#: 5A_10:2423
msgctxt "text_id=4100 | speaker=unknown"
msgid "　ハリネズミのお化けが鏡をけずりながら大挙して迫ってくるような、そんな、絶望に似たノイズが聞こえてくる。"
msgstr "  It was the sound of despair, as if a horde of monstrous hedgehogs were scraping their way past the mirrors in her direction."

#. Occurrence 5A_10:2453:4101: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0012; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:2453
msgctxt "text_id=4101 | speaker=aoko"
msgid "「…………あのドジ。三分どころか十秒<保|も>たないって、どういうコトよ」"
msgstr "\"...That ditz. Three minutes? He couldn't even last ten seconds.\""

#. Occurrence 5A_10:2459:4102: scene=5A_10
#: 5A_10:2459
msgctxt "text_id=4102 | speaker=unknown"
msgid "　時間を稼ぐ、どころの話じゃない。"
msgstr "  Rather than buying her time, Soujyuro had instead stolen hers."

#. Occurrence 5A_10:2464:4103: scene=5A_10
#: 5A_10:2464
msgctxt "text_id=4103 | speaker=unknown"
msgid "　本当、ただ逃げるだけなのにトンデモない事をしてくれやがった、と悪態のひとつもつきたくなる。"
msgstr "  He had one job―to run away, that was all! She cursed him under her breath."

#. Occurrence 5A_10:2502:4104: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0013; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:2502
msgctxt "text_id=4104 | speaker=aoko"
msgid "「―――複数の足音―――ってコトは、二足から多脚に切り替えたのね」"
msgstr "\"Multiple footsteps...so it's switched from bipedal to multi-leg form?\""

#. Occurrence 5A_10:2508:4105: scene=5A_10
#: 5A_10:2508
msgctxt "text_id=4105 | speaker=unknown"
msgid "　反響する何人もの足音。"
msgstr "  The echoes made it sound like dozens of feet were approaching."

#. Occurrence 5A_10:2513:4106: scene=5A_10
#: 5A_10:2513
msgctxt "text_id=4106 | speaker=unknown"
msgid "　それだけで青子は、通路を走る、六足歩行の巨大な蜘蛛を予想した。"
msgstr "  Aoko's mind conjured an image of a giant, six-legged spider tearing its way down the corridor."

#. Occurrence 5A_10:2615:4107: scene=5A_10
#: 5A_10:2615
msgctxt "text_id=4107 | speaker=unknown"
msgid "　敵の移動速度が今までとは比較にならないのは当然だ。"
msgstr "  It was little wonder that it was so much faster than before."

#. Occurrence 5A_10:2620:4108: scene=5A_10
#: 5A_10:2620
msgctxt "text_id=4108 | speaker=unknown"
msgid "　反響定位による環境把握は暗闇でこそ生きる。"
msgstr "  Its perception of its surroundings through echolocation was of particular use in the dark."

#. Occurrence 5A_10:2625:4109: scene=5A_10
#: 5A_10:2625
msgctxt "text_id=4109 | speaker=unknown"
msgid "　鏡の迷路において、視力に頼る人間より、自動人形は何倍も精確に周囲を把握している。"
msgstr "  Compared to sight-dependent humans, this automaton was far better equipped to navigate its way through the labyrinth of mirrors."

#. Occurrence 5A_10:2630:4110: scene=5A_10
#: 5A_10:2630
msgctxt "text_id=4110 | speaker=unknown"
msgid "　それでも青子に追いつけなかったのは、たんに二本足では小刻みな方向転換に耐えられなかったからだ。"
msgstr "  If it could not keep pace earlier, that had been because its bipedal mode made it less maneuverable."

#. Occurrence 5A_10:2635:4111: scene=5A_10
#: 5A_10:2635
msgctxt "text_id=4111 | speaker=unknown"
msgid "　多脚という安定性を持てば、そのスピードは人間を遥かに凌駕する。"
msgstr "  Now, the stability provided by multiple legs gave it a speed that far exceeded that of any human."

#. Occurrence 5A_10:2732:4112: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0014; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:2732
msgctxt "text_id=4112 | speaker=aoko"
msgid "“どうする、どうする、どうする―――！”"
msgstr "(What now? What now!?)"

#. Occurrence 5A_10:2738:4113: scene=5A_10
#: 5A_10:2738
msgctxt "text_id=4113 | speaker=unknown"
msgid "　混乱する思考のまま、迅速に打開策を模索する。"
msgstr "  Her thoughts spun out as she tried to come up with a Plan B."

#. Occurrence 5A_10:2743:4114: scene=5A_10
#: 5A_10:2743
msgctxt "text_id=4114 | speaker=unknown"
msgid "　はっきりしているのは、ここが勝敗の分かれ目というコトだけ。"
msgstr "  All she knew for sure was that this was a pivotal moment."

#. Occurrence 5A_10:2770:4115: scene=5A_10
#: 5A_10:2770
msgctxt "text_id=4115 | speaker=unknown"
msgid "　このまま足を止めていれば十秒ほどで追いつかれる。"
msgstr "  If she continued standing still, she had seconds left at most."

#. Occurrence 5A_10:2775:4116: scene=5A_10
#: 5A_10:2775
msgctxt "text_id=4116 | speaker=unknown"
msgid "　入り口の<結界|かべ>は今の青子でも小指一本で解除できる<稚拙さ|レベル>だ。魔術と言わず、魔力を流すだけで中和できる。"
msgstr "  Even in her current state, she knew she could easily neutralize the Bounded Field blocking the entrance without casting a spell. All she had to do was feed a little of her own energy into it."

#. Occurrence 5A_10:2780:4117: scene=5A_10
#: 5A_10:2780
msgctxt "text_id=4117 | speaker=unknown"
msgid "　青子が全力で走り続けられるのは三分強。"
msgstr "  Aoko could sprint with all her might for a little more than three minutes."

#. Occurrence 5A_10:2785:4118: scene=5A_10
#: 5A_10:2785
msgctxt "text_id=4118 | speaker=unknown"
msgid "　<我慢|スタミナ>比べはどう見ても人形に分がある。"
msgstr "  The puppet had far more stamina than she did."

#. Occurrence 5A_10:2848:4119: scene=5A_10
#: 5A_10:2848
msgctxt "text_id=4119 | speaker=unknown"
msgid "　考えられる選択肢は三つ。"
msgstr "  She could only come up with three options."

#. Occurrence 5A_10:2853:4120: scene=5A_10
#: 5A_10:2853
msgctxt "text_id=4120 | speaker=unknown"
msgid "　一つ、出口は目の前、外に逃げる。"
msgstr "  The first was to escape through the exit in front of her."

#. Occurrence 5A_10:2858:4121: scene=5A_10
#: 5A_10:2858
msgctxt "text_id=4121 | speaker=unknown"
msgid "　二つ、二階より複雑な一階の迷路に身を隠す。"
msgstr "  The second was to hide somewhere on the more complicated first floor."

#. Occurrence 5A_10:2863:4122: scene=5A_10
#: 5A_10:2863
msgctxt "text_id=4122 | speaker=unknown"
msgid "　三つ、地下に走って、袋のネズミとばかりに、あの人形に追いつめられる―――"
msgstr "  And the third was to run into the basement and be stuck like a rat in a trap."

#. Occurrence 5A_10:2898:4123: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_10_0015; voice_prefix=A10; voice_category=1; scene=5A_10
#: 5A_10:2898
msgctxt "text_id=4123 | speaker=aoko"
msgid "「―――なんだ、考えるまでもない」"
msgstr "\"Well, that's obvious enough.\""

#. Occurrence 5A_10:2904:4124: scene=5A_10
#: 5A_10:2904
msgctxt "text_id=4124 | speaker=unknown"
msgid "　決断はまたたきの内に。"
msgstr "  She made her decision with zero hesitation,"

#. Occurrence 5A_10:2909:4125: scene=5A_10
#: 5A_10:2909
msgctxt "text_id=4125 | speaker=unknown"
msgid "　立ちつくしていた両足には確かな力。"
msgstr "  moving her stiff legs again with determined strength."

#. Occurrence 5A_10:2914:4126: scene=5A_10
#: 5A_10:2914
msgctxt "text_id=4126 | speaker=unknown"
msgid "　嵐はもう頭上に迫っている。"
msgstr "  The oncoming storm was almost upon her."

#. Occurrence 5A_10:2950:4127: scene=5A_10
#: 5A_10:2950
msgctxt "text_id=4127 | speaker=unknown"
msgid "　意を決して、少女は眼下の暗闇に向かって走りだした。"
msgstr "  Her resolve firm, she turned and ran, descending into the darkness."

#. Occurrence 5A_11:56:4128: scene=5A_11
#: 5A_11:56
msgctxt "text_id=4128 | speaker=unknown"
msgid "　　何であれ、<終局|フィナーレ>は華やかに。"
msgstr "    No matter what, a finale should be glorious."

#. Occurrence 5A_11:61:4129: scene=5A_11
#: 5A_11:61
msgctxt "text_id=4129 | speaker=unknown"
msgid "　　鏡の城に最後の見せ場が訪れる。"
msgstr "    This would be the mirror castle's final scene."

#. Occurrence 5A_11:83:4130: scene=5A_11
#: 5A_11:83
msgctxt "text_id=4130 | speaker=unknown"
msgid "　入場者は二人プラス一体。"
msgstr "  Two humans and a puppet."

#. Occurrence 5A_11:88:4131: scene=5A_11
#: 5A_11:88
msgctxt "text_id=4131 | speaker=unknown"
msgid "　魔法使いの少女は城の心臓部である地下に走り、"
msgstr "  A young sorceress ran toward the subterranean heart of the castle,"

#. Occurrence 5A_11:93:4132: scene=5A_11
#: 5A_11:93
msgctxt "text_id=4132 | speaker=unknown"
msgid "　自律するアンティークは少女を追いかけて魔のダンジョンへ。"
msgstr "  while an autonomous antique chased its prey into the depths of a demonic dungeon."

#. Occurrence 5A_11:306:4133: scene=5A_11
#: 5A_11:306
msgctxt "text_id=4133 | speaker=unknown"
msgid "　一分の<後|のち>、城には微弱な青い電荷が走り抜けた。"
msgstr "  A minute later, a faint, blue charge would ripple through the castle."

#. Occurrence 5A_11:312:4134: scene=5A_11
#: 5A_11:312
msgctxt "text_id=4134 | speaker=unknown"
msgid "　地下一階、最深最奥のメインピラー。"
msgstr "  This was the main pillar in the deepest depths of the basement."

#. Occurrence 5A_11:317:4135: scene=5A_11
#: 5A_11:317
msgctxt "text_id=4135 | speaker=unknown"
msgid "　城を支えているワケではないけれど、象徴であった柱を、少女は渾身の魔力をこめた拳で打ち叩いた。"
msgstr "  Though not critical to the castle's structure, the pillar was a visible symbol of it. The girl concentrated her magical energy into a fist and thrust it at the pillar."

#. Occurrence 5A_11:473:4136: scene=5A_11
#: 5A_11:473
msgctxt "text_id=4136 | speaker=unknown"
msgid "　この一撃で鏡の城は崩れ去る。"
msgstr "  This was the blow that would bring down the castle."

#. Occurrence 5A_11:478:4137: scene=5A_11
#: 5A_11:478
msgctxt "text_id=4137 | speaker=unknown"
msgid "　そんなイメージの元に放った<正拳|ストレート>は、数秒の後、イメージを真実に変換する。"
msgstr "  She imagined the destruction as she threw the punch, and that scene blossomed into reality seconds later."

#. Occurrence 5A_11:483:4138: scene=5A_11
#: 5A_11:483
msgctxt "text_id=4138 | speaker=unknown"
msgid "　城の四方の柱、地盤に刻まれた魔力を圧縮、解放させるだけの単純な発火魔術。"
msgstr "  It was simple ignition magecraft, meant to release the condensed magical energy engraved into the four pillars at the corners of the structure."

#. Occurrence 5A_11:519:4139: scene=5A_11
#: 5A_11:519
msgctxt "text_id=4139 | speaker=unknown"
msgid "　仕掛けは電荷をスイッチにして、ほぼ同時に発動し―――"
msgstr "  Using electricity as a switch meant virtually instantaneous activation."

#. Occurrence 5A_11:864:4140: scene=5A_11
#: 5A_11:864
msgctxt "text_id=4140 | speaker=unknown"
msgid "　<緩|ゆる>やかに、<速|すみ>やかに。"
msgstr "  It happened swiftly and elegantly― "

#. Occurrence 5A_11:869:4141: scene=5A_11
#: 5A_11:869
msgctxt "text_id=4141 | speaker=unknown"
msgid "　二年もの歳月、かたくなに滅びを<拒|こば>んだ夢の城に、臨終の<槌|つち>が下ろされる。"
msgstr "  a hammer of destruction descended upon the castle of dreams that had stubbornly resisted its fate for two years."

#. Occurrence 5A_11:1037:4142: scene=5A_11
#: 5A_11:1037
msgctxt "text_id=4142 | speaker=unknown"
msgid "　―――それは、喜びに似た音だった。"
msgstr "  It was almost a joyous sound."

#. Occurrence 5A_11:1043:4143: scene=5A_11
#: 5A_11:1043
msgctxt "text_id=4143 | speaker=unknown"
msgid "　とうに命を失い、訪れる者のいなくなった鏡の城が迎えた、最後にして最大のショウタイム。"
msgstr "  And so, the lifeless and abandoned castle of mirrors set the stage for its final and most spectacular performance."

#. Occurrence 5A_11:1048:4144: scene=5A_11
#: 5A_11:1048
msgctxt "text_id=4144 | speaker=unknown"
msgid "　青子の魔力は電荷となって支柱に刻まれた魔術式を起動させ、連鎖的に、建物の息の根を止めていく。"
msgstr "  Aoko's magical energy became an electrical charge that activated the magecraft formula engraved into the pillar. The chain reaction would lead to the castle's destruction."

#. Occurrence 5A_11:1183:4145: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0000; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:1183
msgctxt "text_id=4145 | speaker=aoko"
msgid "「……ごくろうさま。"
msgstr "\"...You served your purpose."

#. Occurrence 5A_11:1189:4146: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0001; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:1189
msgctxt "text_id=4146 | speaker=aoko"
msgid "　でも、思ってたよりくたびれてたのね。これじゃ一分<保|も>つかどうか」"
msgstr "  But it must've been rough. Looks like you're gonna collapse anytime now.\""

#. Occurrence 5A_11:1199:4147: scene=5A_11
#: 5A_11:1199
msgctxt "text_id=4147 | speaker=unknown"
msgid "　地下一階の中央広場。"
msgstr "  The plaza in the center of the basement."

#. Occurrence 5A_11:1204:4148: scene=5A_11
#: 5A_11:1204
msgctxt "text_id=4148 | speaker=unknown"
msgid "　呼吸を整えながら、青子は魔術刻印をフル回転させる。"
msgstr "  Aoko tried to steady her breathing while rotating her Magic Crest at full speed."

#. Occurrence 5A_11:1209:4149: scene=5A_11
#: 5A_11:1209
msgctxt "text_id=4149 | speaker=unknown"
msgid "　魔術式を組めないのを承知の上で、その両手に青い光をまとわせる。"
msgstr "  She wreathed her arms in blue light, fully aware that she could no longer activate another formula."

#. Occurrence 5A_11:1393:4150: scene=5A_11
#: 5A_11:1393
msgctxt "text_id=4150 | speaker=unknown"
msgid "　……乱れた呼吸は簡単には治まらない。"
msgstr "  Her labored breathing refused to settle."

#. Occurrence 5A_11:1398:4151: scene=5A_11
#: 5A_11:1398
msgctxt "text_id=4151 | speaker=unknown"
msgid "　地下一階の中心。"
msgstr "  She stood at the center of the basement."

#. Occurrence 5A_11:1403:4152: scene=5A_11
#: 5A_11:1403
msgctxt "text_id=4152 | speaker=unknown"
msgid "　中心の柱にたどり着くまで、彼女は追跡者に背中を見せることなく走りきったのだ。百メートル走十三秒の俊足は間違いなく自己記録を更新した。"
msgstr "  Without being spotted even once, she had managed to make it all the way to the central pillar. It was a hundred-meter dash in thirteen seconds flat―undoubtedly a new personal best."

#. Occurrence 5A_11:1408:4153: scene=5A_11
#: 5A_11:1408
msgctxt "text_id=4153 | speaker=unknown"
msgid "　その先に待っているのが<こ|・><の|・><状|・><況|・>だと承知した上で、あえぐ心臓に鞭を打った。"
msgstr "  She spurred on her weakened heart, knowing full well the fate that awaited her."

#. Occurrence 5A_11:1519:4154: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0002; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:1519
msgctxt "text_id=4154 | speaker=aoko"
msgid "「……入れば追ってくる。地下に行けば逃げられない。"
msgstr "\"It can't help but follow me. And once down here, there'll be no escape."

#. Occurrence 5A_11:1525:4155: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0003; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:1525
msgctxt "text_id=4155 | speaker=aoko"
msgid "　当然よね。最後まで逃げ回ろうなんて、虫のいい話だった」"
msgstr "  I should've expected that. It was too much to expect that I could keep up the chase forever.\""

#. Occurrence 5A_11:1531:4156: scene=5A_11
#: 5A_11:1531
msgctxt "text_id=4156 | speaker=unknown"
msgid "　反省するわ、と青子は物言わぬ<人形|じぶん>に語りかける。"
msgstr "  Hindsight was 20/20."

#. Occurrence 5A_11:1675:4157: scene=5A_11
#: 5A_11:1675
msgctxt "text_id=4157 | speaker=unknown"
msgid "　城が完全に崩れるまで残り一分。"
msgstr "  The castle was only a minute away from collapsing completely."

#. Occurrence 5A_11:1680:4158: scene=5A_11
#: 5A_11:1680
msgctxt "text_id=4158 | speaker=unknown"
msgid "　ここに留まるかぎり、どちらも瓦礫の下敷きだ。"
msgstr "  If they stayed here, they would both be crushed by the rubble."

#. Occurrence 5A_11:1685:4159: scene=5A_11
#: 5A_11:1685
msgctxt "text_id=4159 | speaker=unknown"
msgid "　あの人形にとってはそれでオッケー。"
msgstr "  The puppet certainly did not care."

#. Occurrence 5A_11:1690:4160: scene=5A_11
#: 5A_11:1690
msgctxt "text_id=4160 | speaker=unknown"
msgid "　もとより命のないモノ、標的である蒼崎青子を殺す事だけが彼女の<目的|ねがい>なのだから。"
msgstr "  With no life of its own, its sole concern was the elimination of its target, Aoko Aozaki."

#. Occurrence 5A_11:1744:4161: scene=5A_11
#: 5A_11:1744
msgctxt "text_id=4161 | speaker=unknown"
msgid "　……そう。"
msgstr "  ...Indeed."

#. Occurrence 5A_11:1749:4162: scene=5A_11
#: 5A_11:1749
msgctxt "text_id=4162 | speaker=unknown"
msgid "　要するに、敵だけが初めから必死だった。"
msgstr "  The enemy had been willing to die from the start."

#. Occurrence 5A_11:1754:4163: scene=5A_11
#: 5A_11:1754
msgctxt "text_id=4163 | speaker=unknown"
msgid "　決意の甘さに<憤慨|ふんがい>する。"
msgstr "  She resented her own lack of resolve."

#. Occurrence 5A_11:1759:4164: scene=5A_11
#: 5A_11:1759
msgctxt "text_id=4164 | speaker=unknown"
msgid "　もろとも死ぬ事さえいとわない相手に尻尾を巻くなんて、あまりに自分らしくなかったな、と。"
msgstr "  It wasn't like her to tuck tail and run from an opponent that didn't fear death."

#. Occurrence 5A_11:1818:4165: voice_id=C40_5A_11_0000_C; voice_prefix=C40; voice_category=0; scene=5A_11
#: 5A_11:1818
msgctxt "text_id=4165 | speaker=unknown"
msgid "　　 “<Vivo in somno. Solitarie putresco in inferis|私は眠りの中で生きている。ひとりきりで土の中で腐っていく。>."
msgstr "                    \"<Vivo in somno. Solitarie putresco in inferis|In slumber, I live. In dirt, I rot.>."

#. Occurrence 5A_11:1818:4166: voice_id=C40_5A_11_0000_C; voice_prefix=C40; voice_category=0; scene=5A_11
#: 5A_11:1818
msgctxt "text_id=4166 | speaker=unknown"
msgid "@o<Hic dies meus obitus dies, et meus nativus dies. Te obeam.|今日は私の命日であり、誕生日だ。さあ、貴方に会いに行こう。>”"
msgstr "        <Hic dies meus obitus dies, et meus nativus dies. Te obeam.|Today is the day I died and was born. Now I come to you.>\""

#. Occurrence 5A_11:1839:4167: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0004; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:1839
msgctxt "text_id=4167 | speaker=aoko"
msgid "“……ふん。そもそも自爆覚悟じゃない、アレ。"
msgstr "(Hmph. It's always been on a suicide mission, huh."

#. Occurrence 5A_11:1845:4168: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0005; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:1845
msgctxt "text_id=4168 | speaker=aoko"
msgid "　六足歩行とフィンの一撃は<使|・><い|・><す|・><ぎ|・>よ。もう呪詛による魔力補給じゃ間に合わない”"
msgstr "  It doesn't have enough juice to power the six-legged form and the Finn Shots. The curses aren't recharging it fast enough.)"

#. Occurrence 5A_11:1867:4169: scene=5A_11
#: 5A_11:1867
msgctxt "text_id=4169 | speaker=unknown"
msgid "　……そう。永久機関と言っても、それは魔力の消費量を抑えてこその永久機関だ。"
msgstr "  Such a perpetual motion device was only as good as its ability to regulate its energy consumption."

#. Occurrence 5A_11:1872:4170: scene=5A_11
#: 5A_11:1872
msgctxt "text_id=4170 | speaker=unknown"
msgid "　あれだけの機巧を使えば燃料はすぐにカラになり、電力である呪詛を回す事もできなくなる。"
msgstr "  Using so many functions at once meant it was burning through fuel quickly and losing the ability to process the curses that powered it."

#. Occurrence 5A_11:1877:4171: scene=5A_11
#: 5A_11:1877
msgctxt "text_id=4171 | speaker=unknown"
msgid "　<人形|かのじょ>は与えられた機能を、目的の為に燃やし尽くす。"
msgstr "  It was using up all of the functions it had been given to achieve its aim."

#. Occurrence 5A_11:1882:4172: scene=5A_11
#: 5A_11:1882
msgctxt "text_id=4172 | speaker=unknown"
msgid "　それは知恵あるものでは届かない器物の誇り。"
msgstr "  This was the pride of a tool, if such things could have ego. Those endowed with sentience could never hope to understand."

#. Occurrence 5A_11:1887:4173: scene=5A_11
#: 5A_11:1887
msgctxt "text_id=4173 | speaker=unknown"
msgid "　走る為だけに生まれた獣の覚悟に、人が触れれば火傷する。"
msgstr "  A beast born to do nothing but run would burn any human who faced its resolve."

#. Occurrence 5A_11:1987:4174: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0006; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:1987
msgctxt "text_id=4174 | speaker=aoko"
msgid "“……ホント、勿体ない。"
msgstr "\"...It's a waste when you think about it."

#. Occurrence 5A_11:1993:4175: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0007; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:1993
msgctxt "text_id=4175 | speaker=aoko"
msgid "　こういう無茶をするのは姉貴だけかと思ってたけど、いるところにはいるもんね”"
msgstr "  I thought my sister was the only one capable of something this reckless, but I guess I was wrong.\""

#. Occurrence 5A_11:2093:4176: scene=5A_11
#: 5A_11:2093
msgctxt "text_id=4176 | speaker=unknown"
msgid "　だが、共倒れになる気は毛頭無い。"
msgstr "  But Aoko did not intend a sacrifice play here."

#. Occurrence 5A_11:2098:4177: scene=5A_11
#: 5A_11:2098
msgctxt "text_id=4177 | speaker=unknown"
msgid "　反省は済ませたし、敬意も払ったし。"
msgstr "  She respected her adversary now, and she was done regretting her choices."

#. Occurrence 5A_11:2103:4178: scene=5A_11
#: 5A_11:2103
msgctxt "text_id=4178 | speaker=unknown"
msgid "　時間もないしいい加減、"
msgstr "  There was no time to waste."

#. Occurrence 5A_11:2168:4179: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0008; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:2168
msgctxt "text_id=4179 | speaker=aoko"
msgid "「行くわよ。ここで、きっかり―――」"
msgstr "\"This is it. This ends now.\""

#. Occurrence 5A_11:2249:4180: scene=5A_11
#: 5A_11:2249
msgctxt "text_id=4180 | speaker=unknown"
msgid "　たまったツケを、倍にして返してやる―――！"
msgstr "  Aoko had every intention of paying it back double for what it had done to her."

#. Occurrence 5A_11:2306:4181: scene=5A_11
#: 5A_11:2306
msgctxt "text_id=4181 | speaker=unknown"
msgid "　溜めに溜めた力を、<右脚|みぎあし>に爆発させる。"
msgstr "  The energy Aoko had accumulated exploded out of her right leg."

#. Occurrence 5A_11:2311:4182: scene=5A_11
#: 5A_11:2311
msgctxt "text_id=4182 | speaker=unknown"
msgid "　狙いは一点、正面からの直接打撃―――！"
msgstr "  She aimed for a single thing: a head-on attack!"

#. Occurrence 5A_11:2407:4183: scene=5A_11
#: 5A_11:2407
msgctxt "text_id=4183 | speaker=unknown"
msgid "　迎え撃つは心臓を<鷲掴|わしづか>む呪いの一撃。"
msgstr "  The enemy responded with a lethal curse that reached for her heart like a set of talons."

#. Occurrence 5A_11:2412:4184: scene=5A_11
#: 5A_11:2412
msgctxt "text_id=4184 | speaker=unknown"
msgid "　燃え尽きる事を恐れない、最大出力の心臓破り。"
msgstr "  Humming with power, it meant to rend Aoko's heart and burn itself out in the process."

#. Occurrence 5A_11:2419:4185: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0009; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:2419
msgctxt "text_id=4185 | speaker=aoko"
msgid "“―――っ、フッ―――！”"
msgstr "\"Hup!\""

#. Occurrence 5A_11:2425:4186: scene=5A_11
#: 5A_11:2425
msgctxt "text_id=4186 | speaker=unknown"
msgid "　それを視認したのと同時に、青子は全力で床を蹴った。"
msgstr "  As soon as she saw it, Aoko kicked the floor as hard as she could."

#. Occurrence 5A_11:2509:4187: scene=5A_11
#: 5A_11:2509
msgctxt "text_id=4187 | speaker=unknown"
msgid "　長い髪を尾のようになびかせて、少女の体は真横に<踊|おど>る。"
msgstr "  Her long hair swirled through the air as she flipped aside."

#. Occurrence 5A_11:2530:4188: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0010; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:2530
msgctxt "text_id=4188 | speaker=aoko"
msgid "「っ、き―――」"
msgstr "\"...Hnngh!\""

#. Occurrence 5A_11:2536:4189: scene=5A_11
#: 5A_11:2536
msgctxt "text_id=4189 | speaker=unknown"
msgid "　無理やりな横移動で崩れる<体勢|からだ>を、腕の振りで転ばずに持ち直す。"
msgstr "  This lateral move almost sent her tumbling to the ground, but a quick swing of her arm allowed her to regain her balance."

#. Occurrence 5A_11:2577:4190: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0011; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:2577
msgctxt "text_id=4190 | speaker=aoko"
msgid "「っ……！」"
msgstr "\"...!\""

#. Occurrence 5A_11:2625:4191: scene=5A_11
#: 5A_11:2625
msgctxt "text_id=4191 | speaker=unknown"
msgid "　散弾が肩をかすめる。"
msgstr "  A shot grazed her arm,"

#. Occurrence 5A_11:2630:4192: scene=5A_11
#: 5A_11:2630
msgctxt "text_id=4192 | speaker=unknown"
msgid "　呪詛をうけた左肩が白熱する。"
msgstr "  the curse scorching her left shoulder."

#. Occurrence 5A_11:2635:4193: scene=5A_11
#: 5A_11:2635
msgctxt "text_id=4193 | speaker=unknown"
msgid "　構わない。どんな不利な体勢になろうと、“フィンの一撃”の直撃だけは回避する―――！"
msgstr "  She did not flinch. Aoko knew she could hold on as long as she continued to avoid a direct Finn Shot."

#. Occurrence 5A_11:2705:4194: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0012; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:2705
msgctxt "text_id=4194 | speaker=aoko"
msgid "「―――！」"
msgstr "\"...!\""

#. Occurrence 5A_11:2713:4195: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0013; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:2713
msgctxt "text_id=4195 | speaker=aoko"
msgid "“<弾いて|スナップ>……！”"
msgstr "\"Snap!\""

#. Occurrence 5A_11:2802:4196: scene=5A_11
#: 5A_11:2802
msgctxt "text_id=4196 | speaker=unknown"
msgid "　痛みとバランスの乱れから、立ち直るのに０．５秒。"
msgstr "  Off balance and in pain, it took her half a second to recover."

#. Occurrence 5A_11:2807:4197: scene=5A_11
#: 5A_11:2807
msgctxt "text_id=4197 | speaker=unknown"
msgid "　顔を上げた瞬間、目前に迫る凶器を、魔力を帯びた拳で殴り<弾|はじ>く。"
msgstr "  The moment she raised her head, she deflected the attack with a fist full of magical energy."

#. Occurrence 5A_11:2908:4198: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0014; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:2908
msgctxt "text_id=4198 | speaker=aoko"
msgid "「せー、のぉ……！」"
msgstr "\"Here goes...!\""

#. Occurrence 5A_11:2913:4199: scene=5A_11
#: 5A_11:2913
msgctxt "text_id=4199 | speaker=unknown"
msgid "　人形に意志があったのなら、間違いなく目を見張っただろう。"
msgstr "  If the puppet had a will of its own, its eyes would have popped right out of its sockets."

#. Occurrence 5A_11:2918:4200: scene=5A_11
#: 5A_11:2918
msgctxt "text_id=4200 | speaker=unknown"
msgid "　驚嘆すべきは。"
msgstr "  It would have been floored."

#. Occurrence 5A_11:2923:4201: scene=5A_11
#: 5A_11:2923
msgctxt "text_id=4201 | speaker=unknown"
msgid "　その一連の動作をしながらも、足を止めない彼女の意志の強さだった。"
msgstr "  Shocked at the strong will that allowed this girl to perform a series of moves like this."

#. Occurrence 5A_11:3011:4202: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0015; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:3011
msgctxt "text_id=4202 | speaker=aoko"
msgid "“<砕いて|クラック>……！”"
msgstr "\"Crack!\""

#. Occurrence 5A_11:3122:4203: scene=5A_11
#: 5A_11:3122
msgctxt "text_id=4203 | speaker=unknown"
msgid "　コンマの世界で弾かれる凶器。"
msgstr "  Aoko's response was instantaneous."

#. Occurrence 5A_11:3127:4204: scene=5A_11
#: 5A_11:3127
msgctxt "text_id=4204 | speaker=unknown"
msgid "　少女の力では完全に弾ききれず、凶器はわずかに軌道を逸らし、長い髪をさらっていく。"
msgstr "  While her power was not sufficient to completely redirect the arm's trajectory, it was just enough to deflect it harmlessly past her hair."

#. Occurrence 5A_11:3210:4205: voice_id=C40_5A_11_0001_C; voice_prefix=C40; voice_category=0; scene=5A_11
#: 5A_11:3210
msgctxt "text_id=4205 | speaker=unknown"
msgid "@o“―――<Initio erraveramus. Dum vivimus dolores sunt|すべてが間違いだったのです。生まれなければ良かったのです。>."
msgstr "\"...<Initio erraveramus. Dum vivimus dolores sunt|It was all a mistake. I should have never been born.>."

#. Occurrence 5A_11:3210:4206: voice_id=C40_5A_11_0001_C; voice_prefix=C40; voice_category=0; scene=5A_11
#: 5A_11:3210
msgctxt "text_id=4206 | speaker=unknown"
msgid "<Nemo adiuvat. Nemo adiuvat. Nemo adiuvat.|誰か私を償って。償って。償って。償って。償って。償って。償って。償って。償って―――！>”"
msgstr "<Nemo adiuvat. Nemo adiuvat. Nemo adiuvat.|Atone for me! Atone for me! Atone for me!>\""

#. Occurrence 5A_11:3216:4207: scene=5A_11
#: 5A_11:3216
msgctxt "text_id=4207 | speaker=unknown"
msgid "　詠唱は呪いとなって青子から気力を奪う。"
msgstr "  The chant became a curse that robbed Aoko of her vitality."

#. Occurrence 5A_11:3275:4208: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0016; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:3275
msgctxt "text_id=4208 | speaker=aoko"
msgid "「―――ハ」"
msgstr "\"...!\""

#. Occurrence 5A_11:3312:4209: scene=5A_11
#: 5A_11:3312
msgctxt "text_id=4209 | speaker=unknown"
msgid "　こぼれたのは余裕か怒りか。"
msgstr "  Did it still have something left in the tank, or was it actually indignant?"

#. Occurrence 5A_11:3317:4210: scene=5A_11
#: 5A_11:3317
msgctxt "text_id=4210 | speaker=unknown"
msgid "　あまりにも脆弱な防衛機能を気迫で<嚥下|レジスト>し、"
msgstr "  Whatever the reason, Aoko was easily able to resist its weakened defensive maneuver..."

#. Occurrence 5A_11:3491:4211: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0017; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:3491
msgctxt "text_id=4211 | speaker=aoko"
msgid "“蹴<り上げ|グライダー>る……！”"
msgstr "\"Glider!\""

#. Occurrence 5A_11:3497:4212: scene=5A_11
#: 5A_11:3497
msgctxt "text_id=4212 | speaker=unknown"
msgid "　魔力を帯びた渾身の右脚が、人形の<心|む><臓|ね>を打ち上げる！"
msgstr "  ...And her right leg, pulsing with magical energy, shot up into the puppet's chest from below."

#. Occurrence 5A_11:3728:4213: scene=5A_11
#: 5A_11:3728
msgctxt "text_id=4213 | speaker=unknown"
msgid "　人形の軽さは青子の予想以上だった。"
msgstr "  It was much lighter than Aoko anticipated."

#. Occurrence 5A_11:3733:4214: scene=5A_11
#: 5A_11:3733
msgctxt "text_id=4214 | speaker=unknown"
msgid "　いや、重さではなく力が無かった、と言うべきか。"
msgstr "  Or rather, she felt little resistance."

#. Occurrence 5A_11:3738:4215: scene=5A_11
#: 5A_11:3738
msgctxt "text_id=4215 | speaker=unknown"
msgid "　自動人形の重量はその内部構造―――動力源の大小によって決定される。"
msgstr "  An automaton's weight was determined by its internals―the size of its power source."

#. Occurrence 5A_11:3743:4216: scene=5A_11
#: 5A_11:3743
msgctxt "text_id=4216 | speaker=unknown"
msgid "　自動<詠唱永久|オルゴールエンジン>機関を持つこのオートマタは、皮肉な事に、その優秀さがアダになったのだ。"
msgstr "  Ironically, it was the superiority of its music box engine that would prove to be its downfall."

#. Occurrence 5A_11:3812:4217: voice_id=C40_5A_11_0002_C; voice_prefix=C40; voice_category=0; scene=5A_11
#: 5A_11:3812
msgctxt "text_id=4217 | speaker=unknown"
msgid "“……<Venite, Venite, Venite, meum sepulchrum|いらっしゃい、いらっしゃい、私の墓穴に、> ^<veniteeeeeeee……|いらっしゃいいいいいい……>”"
msgstr "\"...<Venite, Venite, Venite, meum sepulchrum veniteeeeeeee|Welcome! Welcome! Welcome to my graaaaaave>...\""

#. Occurrence 5A_11:3933:4218: scene=5A_11
#: 5A_11:3933
msgctxt "text_id=4218 | speaker=unknown"
msgid "　途切れ途切れの呪詛。"
msgstr "  A stuttering curse."

#. Occurrence 5A_11:3938:4219: scene=5A_11
#: 5A_11:3938
msgctxt "text_id=4219 | speaker=unknown"
msgid "　青子の蹴りと天井への衝突、とどめに落下の衝撃で、人形はほぼ停止していた。"
msgstr "  Having taken the full brunt of Aoko's kick, the puppet bounced from ceiling to floor, collapsing in a heap."

#. Occurrence 5A_11:3943:4220: scene=5A_11
#: 5A_11:3943
msgctxt "text_id=4220 | speaker=unknown"
msgid "　内部構造に歪みが生じ、動力源である<自動詠唱|オルゴール>のドラムが歪んでしまったのだ。"
msgstr "  Its internal construction had been warped by the impact, leaving the drum of the music box that powered the puppet warped as well."

#. Occurrence 5A_11:3971:4221: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0018; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:3971
msgctxt "text_id=4221 | speaker=aoko"
msgid "「恨むなら設計者を恨みなさい。"
msgstr "\"Take your design flaws up with your maker."

#. Occurrence 5A_11:3979:4222: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0019_0; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:3979
msgctxt "text_id=4222 | speaker=aoko"
msgid "ダイナモの一つでも積んでいれば、もうちょっとは重たくなったでしょうに……"
msgstr "A single dynamo would have been all you needed to―"

#. Occurrence 5A_11:3986:4223: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0019_1; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:3986
msgctxt "text_id=4223 | speaker=aoko"
msgid "って、うわ!?」"
msgstr "Wait, what the―!?\""

#. Occurrence 5A_11:4098:4224: scene=5A_11
#: 5A_11:4098
msgctxt "text_id=4224 | speaker=unknown"
msgid "　目の前に落ちてきた天井の衝撃で、青子は正しい意識を取り戻した。"
msgstr "  Part of the ceiling came crashing down in front of Aoko, snapping her back to her senses."

#. Occurrence 5A_11:4104:4225: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0020; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:4104
msgctxt "text_id=4225 | speaker=aoko"
msgid "“……ところでいま、どうやってぶっ倒したんだろう？”"
msgstr "(...Did I really just take her out?)"

#. Occurrence 5A_11:4109:4226: scene=5A_11
#: 5A_11:4109
msgctxt "text_id=4226 | speaker=unknown"
msgid "　と首をかしげるほど無我夢中だったので失念していたが、ミラーハウスの倒壊はもう始まっている。"
msgstr "  She was so stunned by her own victory that she forgot the house of mirrors had already begun to collapse."

#. Occurrence 5A_11:4147:4227: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0021; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:4147
msgctxt "text_id=4227 | speaker=aoko"
msgid "「って、こっちのがやばかった……！」"
msgstr "\"I've gotta get out of here!\""

#. Occurrence 5A_11:4299:4228: scene=5A_11
#: 5A_11:4299
msgctxt "text_id=4228 | speaker=unknown"
msgid "　勝利の余韻にひたっている場合でも、同情している余裕もない。"
msgstr "  There was no time to relish in her victory or pity her opponent."

#. Occurrence 5A_11:4304:4229: scene=5A_11
#: 5A_11:4304
msgctxt "text_id=4229 | speaker=unknown"
msgid "　このままだと数秒後には同じ運命。"
msgstr "  Not unless she wanted to meet the same fate."

#. Occurrence 5A_11:4309:4230: scene=5A_11
#: 5A_11:4309
msgctxt "text_id=4230 | speaker=unknown"
msgid "　青子自身、生還できる未来をイメージできないほど、状況は壊滅的だ。"
msgstr "  As the situation stood, she found it hard to imagine getting out alive."

#. Occurrence 5A_11:4342:4231: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_11_0022; voice_prefix=A10; voice_category=1; scene=5A_11
#: 5A_11:4342
msgctxt "text_id=4231 | speaker=aoko"
msgid "「急げ、ダッシュだ私……！」"
msgstr "\"Get a move on, Aoko!\""

#. Occurrence 5A_11:4361:4232: scene=5A_11
#: 5A_11:4361
msgctxt "text_id=4232 | speaker=unknown"
msgid "　それでも最善を尽くそうと頬を叩く。"
msgstr "  She clapped herself on the cheeks to motivate herself anew."

#. Occurrence 5A_11:4366:4233: scene=5A_11
#: 5A_11:4366
msgctxt "text_id=4233 | speaker=unknown"
msgid "　わずか数秒間の交戦の報酬。"
msgstr "  This was her bounty for finishing their battle in a matter of seconds."

#. Occurrence 5A_11:4371:4234: scene=5A_11
#: 5A_11:4371
msgctxt "text_id=4234 | speaker=unknown"
msgid "　興奮と緊張で乱れた呼吸もそのままに、青子は出口に向かって走りだした。"
msgstr "  Her breath ragged with excitement, Aoko ran for the exit."

#. Occurrence 5A_12:140:4235: scene=5A_12
#: 5A_12:140
msgctxt "text_id=4235 | speaker=unknown"
msgid "　秒単位で倒壊は激化していく。"
msgstr "  The collapse was intensifying by the second."

#. Occurrence 5A_12:145:4236: scene=5A_12
#: 5A_12:145
msgctxt "text_id=4236 | speaker=unknown"
msgid "　支柱を失った城は中心に折りたたまれるよう、自重によって潰れていく。"
msgstr "  Having lost its support pillars, the castle was buckling under its own weight."

#. Occurrence 5A_12:222:4237: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0000; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:222
msgctxt "text_id=4237 | speaker=aoko"
msgid "「この、邪魔……！」"
msgstr "\"Out of my way!\""

#. Occurrence 5A_12:334:4238: scene=5A_12
#: 5A_12:334
msgctxt "text_id=4238 | speaker=unknown"
msgid "　なので、地下からの脱出は困難を極めた。"
msgstr "  Escaping from the basement was proving to be no easy task."

#. Occurrence 5A_12:339:4239: scene=5A_12
#: 5A_12:339
msgctxt "text_id=4239 | speaker=unknown"
msgid "　迷路を最短距離で突っ切った青子だが、途中、崩落した天井に潰されかけたのが一度。"
msgstr "  While she was taking the shortest route possible through the maze, she was nearly crushed by a falling piece of the ceiling along the way."

#. Occurrence 5A_12:345:4240: scene=5A_12
#: 5A_12:345
msgctxt "text_id=4240 | speaker=unknown"
msgid "立ちふさがる瓦礫で一秒だけ足を止めたのが二度、いやこれで三度目。"
msgstr "This was the second time―no, third―she had to deal with fallen rubble along the way."

#. Occurrence 5A_12:500:4241: scene=5A_12
#: 5A_12:500
msgctxt "text_id=4241 | speaker=unknown"
msgid "　階段に降り積もった瓦礫を、走りながらの魔弾によって粉砕する。"
msgstr "  She destroyed the debris on the stairs with magic bullets as she ran."

#. Occurrence 5A_12:505:4242: scene=5A_12
#: 5A_12:505
msgctxt "text_id=4242 | speaker=unknown"
msgid "　既に、自動人形による<妨害電波|ジャミング>は途絶えている。"
msgstr "  The automaton's jamming had long since worn off."

#. Occurrence 5A_12:510:4243: scene=5A_12
#: 5A_12:510
msgctxt "text_id=4243 | speaker=unknown"
msgid "　先ほどの攻防で人形はその大部分の機能を破損したからだ。"
msgstr "  The earlier attack had damaged the vast majority of its functions."

#. Occurrence 5A_12:943:4244: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0001; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:943
msgctxt "text_id=4244 | speaker=aoko"
msgid "「―――、っ―――！」"
msgstr "\"-, -!\""

#. Occurrence 5A_12:949:4245: scene=5A_12
#: 5A_12:949
msgctxt "text_id=4245 | speaker=unknown"
msgid "　息を飲むように走る。"
msgstr "  Aoko's breathing was heavy as she ran."

#. Occurrence 5A_12:954:4246: scene=5A_12
#: 5A_12:954
msgctxt "text_id=4246 | speaker=unknown"
msgid "　窮地における緊張から、脳は倍速で稼働する。"
msgstr "  Desperation sparked her brain into overdrive."

#. Occurrence 5A_12:959:4247: scene=5A_12
#: 5A_12:959
msgctxt "text_id=4247 | speaker=unknown"
msgid "　崩れていく天井が緩やかに流れていく。"
msgstr "  The ceiling seemed to be collapsing in slow motion."

#. Occurrence 5A_12:967:4248: scene=5A_12
#: 5A_12:967
msgctxt "text_id=4248 | speaker=unknown"
msgid "　まるで死の<間際|まぎわ>の走馬灯。"
msgstr "  Life seemed to flash before her very eyes."

#. Occurrence 5A_12:972:4249: scene=5A_12
#: 5A_12:972
msgctxt "text_id=4249 | speaker=unknown"
msgid "　今の彼女には一秒が五秒に相当する。"
msgstr "  Each second stretched into five."

#. Occurrence 5A_12:977:4250: scene=5A_12
#: 5A_12:977
msgctxt "text_id=4250 | speaker=unknown"
msgid "　研ぎ澄まされた神経が、体感時間を延長する。"
msgstr "  Her frayed nerves made it hard to tell the time."

#. Occurrence 5A_12:1079:4251: scene=5A_12
#: 5A_12:1079
msgctxt "text_id=4251 | speaker=unknown"
msgid "　倒壊する地下から、崩落する一階へ。"
msgstr "  There was debris riddled throughout the stairway, forcing her to crawl up it."

#. Occurrence 5A_12:1084:4252: scene=5A_12
#: 5A_12:1084
msgctxt "text_id=4252 | speaker=unknown"
msgid "　青子は瓦礫で埋もれかけた階段を這って上りきった。"
msgstr "  She emerged from the destroyed basement into the collapsing first floor."

#. Occurrence 5A_12:1090:4253: scene=5A_12
#: 5A_12:1090
msgctxt "text_id=4253 | speaker=unknown"
msgid "　広間はまだ開けているコト自体が奇跡で、"
msgstr "  That the plaza was still traversable at all was a miracle in itself,"

#. Occurrence 5A_12:1090:4254: scene=5A_12
#: 5A_12:1090
msgctxt "text_id=4254 | speaker=unknown"
msgid "　肝心の出口への通路は―――幸運な事に、まだ崩落していない……！"
msgstr "  and fortunately for her, the crucial path to the exit was still intact."

#. Occurrence 5A_12:1207:4255: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0002; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:1207
msgctxt "text_id=4255 | speaker=aoko"
msgid "“よし、ついてる……！”"
msgstr "\"I made it!\""

#. Occurrence 5A_12:1213:4256: scene=5A_12
#: 5A_12:1213
msgctxt "text_id=4256 | speaker=unknown"
msgid "　入り口通路は地下に沈まない。"
msgstr "  The corridor to the entrance was still intact."

#. Occurrence 5A_12:1218:4257: scene=5A_12
#: 5A_12:1218
msgctxt "text_id=4257 | speaker=unknown"
msgid "　地下迷路があるのは広間までで、入り口通路は下に崩れようがないからだ。崩れるのは天井だけで、足場は最後まで残るはず。"
msgstr "  The basement maze only extended as far as the plaza, so the entrance corridor wouldn't collapse. Only the ceiling would cave in, leaving the scaffolding surround intact."

#. Occurrence 5A_12:1361:4258: scene=5A_12
#: 5A_12:1361
msgctxt "text_id=4258 | speaker=unknown"
msgid "　なので、この運任せの脱出は広場まで辿り着けるかの勝負だ、と青子は自分に言い聞かせて突き進んできた。"
msgstr "  She got herself this far by telling herself repeatedly that fate would decide whether or not she reached the plaza."

#. Occurrence 5A_12:1367:4259: scene=5A_12
#: 5A_12:1367
msgctxt "text_id=4259 | speaker=unknown"
msgid "　賭けは彼女の勝ちだ。幸運は青子に味方した。"
msgstr "  Her gamble paid off. It was her lucky day."

#. Occurrence 5A_12:1372:4260: scene=5A_12
#: 5A_12:1372
msgctxt "text_id=4260 | speaker=unknown"
msgid "　ここからは残りの体力を総動員して、脇目もふらず外を目指せば―――"
msgstr "  All she had to do was muster the last of her strength and keep moving forward until―"

#. Occurrence 5A_12:1420:4261: scene=5A_12
#: 5A_12:1420
msgctxt "text_id=4261 | speaker=unknown"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5A_12:1456:4262: scene=5A_12
#: 5A_12:1456
msgctxt "text_id=4262 | speaker=unknown"
msgid "　時間にして０．２秒だけ、青子は足を止めかける。"
msgstr "  She hesitated for a fraction of a second."

#. Occurrence 5A_12:1461:4263: scene=5A_12
#: 5A_12:1461
msgctxt "text_id=4263 | speaker=unknown"
msgid "　心の甘さか、責任か。"
msgstr "  Was it naivety? A sense of responsibility?"

#. Occurrence 5A_12:1514:4264: scene=5A_12
#: 5A_12:1514
msgctxt "text_id=4264 | speaker=unknown"
msgid "　脳裏によぎったイメージを振り払って、彼女は通路に向かって走りだした。"
msgstr "  She pushed aside the image that popped into her head and continued running down the corridor."

#. Occurrence 5A_12:1552:4265: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0004; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:1552
msgctxt "text_id=4265 | speaker=aoko"
msgid "“……言っとくけど時間合わせの余裕はないわよ。"
msgstr "\"...We don't have the luxury of coordinating the timing with each other to pull this off."

#. Occurrence 5A_12:1558:4266: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0005; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:1558
msgctxt "text_id=4266 | speaker=aoko"
msgid "　そんな上等な作戦じゃないし。お互い、できるコトをやったら最速で出口に向かいましょう”"
msgstr "  It's not the greatest plan in the world, but we both need to do our parts and get to the exit as quickly as possible.\""

#. Occurrence 5A_12:1580:4267: scene=5A_12
#: 5A_12:1580
msgctxt "text_id=4267 | speaker=unknown"
msgid "　たった五分前の話だ。"
msgstr "  That was five minutes ago."

#. Occurrence 5A_12:1585:4268: scene=5A_12
#: 5A_12:1585
msgctxt "text_id=4268 | speaker=unknown"
msgid "　それに、彼は少しだけ不安そうに頷いた。"
msgstr "  At the time, Soujyuro had nodded with trepidation."

#. Occurrence 5A_12:1590:4269: scene=5A_12
#: 5A_12:1590
msgctxt "text_id=4269 | speaker=unknown"
msgid "　あの顔は―――何に対してのものだったのか。"
msgstr "  And Aoko had not bothered to ask herself why."

#. Occurrence 5A_12:1651:4270: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0006; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:1651
msgctxt "text_id=4270 | speaker=aoko"
msgid "“っ、なに様だっての私、今は走ることだけ考えろ……！”"
msgstr "\"What are you spacing out for!? Just focus on running!\""

#. Occurrence 5A_12:1657:4271: scene=5A_12
#: 5A_12:1657
msgctxt "text_id=4271 | speaker=unknown"
msgid "　この通路も、もう<保|も>たない。"
msgstr "  This corridor was giving out too."

#. Occurrence 5A_12:1662:4272: scene=5A_12
#: 5A_12:1662
msgctxt "text_id=4272 | speaker=unknown"
msgid "　振り向けば迷路側から崩れている事だろう。"
msgstr "  If she were to look back, she was sure she would see the building collapsing in on her."

#. Occurrence 5A_12:1667:4273: scene=5A_12
#: 5A_12:1667
msgctxt "text_id=4273 | speaker=unknown"
msgid "　そして、今は振り向く時間すら惜しい。"
msgstr "  She was also sure she had no time to waste doing so."

#. Occurrence 5A_12:1785:4274: scene=5A_12
#: 5A_12:1785
msgctxt "text_id=4274 | speaker=unknown"
msgid "　建物の強度的にはきっとギリギリで、自分の運も絶対ギリギリ。"
msgstr "  Her luck was fading as fast as the building's structural integrity."

#. Occurrence 5A_12:1790:4275: scene=5A_12
#: 5A_12:1790
msgctxt "text_id=4275 | speaker=unknown"
msgid "　ここまで無傷だった事がそもそも破格のヒロイン補正で、これ以上はどんなトラブルも背負えない。"
msgstr "  It was a small miracle that she had escaped serious injury up to this point, and she could not afford even the slightest slip-up."

#. Occurrence 5A_12:1795:4276: scene=5A_12
#: 5A_12:1795
msgctxt "text_id=4276 | speaker=unknown"
msgid "　足首の<捻挫|ねんざ>、<目眩|めまい>、くしゃみ、その程度ですら死に繋がる。後ろから肩を叩かれるだけでゲームオーバーだ。"
msgstr "  An ankle sprain, loss of balance, or even a sneeze would be fatal. A simple pat on the back was enough to end it."

#. Occurrence 5A_12:1801:4277: scene=5A_12
#: 5A_12:1801
msgctxt "text_id=4277 | speaker=unknown"
msgid "　―――なので。"
msgstr "  So, naturally..."

#. Occurrence 5A_12:1920:4278: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0007; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:1920
msgctxt "text_id=4278 | speaker=aoko"
msgid "「―――、あ」"
msgstr "\"...Oh.\""

#. Occurrence 5A_12:1926:4279: scene=5A_12
#: 5A_12:1926
msgctxt "text_id=4279 | speaker=unknown"
msgid "　……彼女の瞳には、はっきりと。"
msgstr "  There it was, clear as day."

#. Occurrence 5A_12:1931:4280: scene=5A_12
#: 5A_12:1931
msgctxt "text_id=4280 | speaker=unknown"
msgid "　地下へ落ちる階段の瓦礫から、蒼<崎青|じぶん>子を道連れにしようとする“死”が見えた。"
msgstr "  From the detritus of the stairway, death had arisen to take her down with it."

#. Occurrence 5A_12:2021:4281: scene=5A_12
#: 5A_12:2021
msgctxt "text_id=4281 | speaker=unknown"
msgid "　<彼女|したい>は<奈落|ならく>から這い出てくる。"
msgstr "  A corpse that had crawled its way up from the depths of hell itself."

#. Occurrence 5A_12:2026:4282: scene=5A_12
#: 5A_12:2026
msgctxt "text_id=4282 | speaker=unknown"
msgid "　まだ<稼働|いき>ている。"
msgstr "  It was still operational."

#. Occurrence 5A_12:2086:4283: scene=5A_12
#: 5A_12:2086
msgctxt "text_id=4283 | speaker=unknown"
msgid "　まだ<呪詛|いし>がある。"
msgstr "  And it was still armed with curses."

#. Occurrence 5A_12:2091:4284: scene=5A_12
#: 5A_12:2091
msgctxt "text_id=4284 | speaker=unknown"
msgid "　<青子|じぶん>と同じように階段を這ってきて、<青子|じぶん>と同じ目で、一人だけ助かろうとする<少女|あおこ>を見つめている。"
msgstr "  It had crawled after her, watching as Aoko desperately tried to save herself."

#. Occurrence 5A_12:2170:4285: scene=5A_12
#: 5A_12:2170
msgctxt "text_id=4285 | speaker=unknown"
msgid "　人形の腕が突き出される。"
msgstr "  The puppet's arm shot forward."

#. Occurrence 5A_12:2175:4286: scene=5A_12
#: 5A_12:2175
msgctxt "text_id=4286 | speaker=unknown"
msgid "　青子が振り向かなくとも、鏡にその姿が映っている。"
msgstr "  While Aoko did not turn to meet it, she could see its reflection in the mirrors."

#. Occurrence 5A_12:2267:4287: voice_id=C40_5A_12_0000_C; voice_prefix=C40; voice_category=0; scene=5A_12
#: 5A_12:2267
msgctxt "text_id=4287 | speaker=unknown"
msgid "“Iis salvatio Iis salvatio Iis salvatio Iis salvatio”"
msgstr "\"Iis salvatio Iis salvatio Iis salvatio Iis salvatio.\""

#. Occurrence 5A_12:2273:4288: scene=5A_12
#: 5A_12:2273
msgctxt "text_id=4288 | speaker=unknown"
msgid "　伸びる。伸びる。伸びる。"
msgstr "  Extend. Extend. Extend."

#. Occurrence 5A_12:2278:4289: scene=5A_12
#: 5A_12:2278
msgctxt "text_id=4289 | speaker=unknown"
msgid "　今度こそ<躱|かわ>せない。躱しようがない。"
msgstr "  This time, she could not dodge it. There was absolutely nothing she could do."

#. Occurrence 5A_12:2299:4290: scene=5A_12
#: 5A_12:2299
msgctxt "text_id=4290 | speaker=unknown"
msgid "　同じ顔をした人形が<詠|うた>っている。"
msgstr "  The puppet with her face sang."

#. Occurrence 5A_12:2308:4291: voice_id=C40_5A_12_0001_C; voice_prefix=C40; voice_category=0; scene=5A_12
#: 5A_12:2308
msgctxt "text_id=4291 | speaker=unknown"
msgid "　<招き入れる|@_Venite domum meam.>。"
msgstr "  <I invite you|@_Venite domum meam.>."

#. Occurrence 5A_12:2316:4292: voice_id=C40_5A_12_0002_C; voice_prefix=C40; voice_category=0; scene=5A_12
#: 5A_12:2316
msgctxt "text_id=4292 | speaker=unknown"
msgid "　<泥のような死を|@_Luto simile somnium>。"
msgstr "  <to die a muddy death|@_Luto simile somnium.>."

#. Occurrence 5A_12:2324:4293: voice_id=C40_5A_12_0003_C; voice_prefix=C40; voice_category=0; scene=5A_12
#: 5A_12:2324
msgctxt "text_id=4293 | speaker=unknown"
msgid "　<塵となって囁く|@_et pulveri simile cotidianum>。"
msgstr "  <Become as whispering dust|@_et pulveri simile cotidianum.>."

#. Occurrence 5A_12:2332:4294: voice_id=C40_5A_12_0004_C; voice_prefix=C40; voice_category=0; scene=5A_12
#: 5A_12:2332
msgctxt "text_id=4294 | speaker=unknown"
msgid "　<心臓を抉り|@_Cor privo>出して、"
msgstr "  <Gouge out your heart|@_Cor privo.>."

#. Occurrence 5A_12:2342:4295: voice_id=C40_5A_12_0005_C; voice_prefix=C40; voice_category=0; scene=5A_12
#: 5A_12:2342
msgctxt "text_id=4295 | speaker=unknown"
msgid "　　　　　　　　"
msgstr "                                      "

msgctxt "text_id=4296 | speaker=unknown"
msgid "“「オ<マエニ、|Te iudico>死ヲ」”"
msgstr "  \"<Death be upon you!|Te iudico.>\""

#. Occurrence 5A_12:2398:4297: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0008; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:2398
msgctxt "text_id=4297 | speaker=aoko"
msgid "「―――、な」"
msgstr "\"Wha―\""

#. Occurrence 5A_12:2456:4298: scene=5A_12
#: 5A_12:2456
msgctxt "text_id=4298 | speaker=unknown"
msgid "　瞬間、青子は我が目を疑った。"
msgstr "  For a moment, she could not believe her eyes."

#. Occurrence 5A_12:2461:4299: scene=5A_12
#: 5A_12:2461
msgctxt "text_id=4299 | speaker=unknown"
msgid "　最後にとんでもない光景を見せられた。"
msgstr "  It was the last thing she'd expected to see."

#. Occurrence 5A_12:2514:4300: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0000; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:2514
msgctxt "text_id=4300 | speaker=soujuurou"
msgid "「しつこいぞ、おまえ」"
msgstr "\"Don't know when to give up, do you?\""

#. Occurrence 5A_12:2520:4301: scene=5A_12
#: 5A_12:2520
msgctxt "text_id=4301 | speaker=unknown"
msgid "　彼はむっとした顔で、広場にとどまって、伸びきった人形の腕を壊していた。"
msgstr "  A fierce expression adorned the face of the boy who had been waiting in the plaza, as he smashed the puppet's outstretched arm."

#. Occurrence 5A_12:2540:4302: scene=5A_12
#: 5A_12:2540
msgctxt "text_id=4302 | speaker=unknown"
msgid "　怒っている顔が本当に似合わない。"
msgstr "  Anger really did not suit him at all."

#. Occurrence 5A_12:2545:4303: scene=5A_12
#: 5A_12:2545
msgctxt "text_id=4303 | speaker=unknown"
msgid "　手にしている武器は消火器だった。"
msgstr "  His weapon of choice was a fire extinguisher."

#. Occurrence 5A_12:2550:4304: scene=5A_12
#: 5A_12:2550
msgctxt "text_id=4304 | speaker=unknown"
msgid "　きっと武器になるものを探して、いつまでも迷路の中に。"
msgstr "  He must have searched the maze for something to use as a weapon."

#. Occurrence 5A_12:2567:4305: scene=5A_12
#: 5A_12:2567
msgctxt "text_id=4305 | speaker=unknown"
msgid "　……いや、それよりも。"
msgstr "  No, never mind that!"

#. Occurrence 5A_12:2606:4306: scene=5A_12
#: 5A_12:2606
msgctxt "text_id=4306 | speaker=unknown"
msgid "　彼がまだ広間にいたのは、考えたくもないけど、まさかそういう理由なんだろうか？"
msgstr "  It was too crazy to contemplate... but had he stayed behind... for her?"

#. Occurrence 5A_12:2724:4307: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0009; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:2724
msgctxt "text_id=4307 | speaker=aoko"
msgid "「っ、静希君―――！」"
msgstr "\"Sizuki!\""

#. Occurrence 5A_12:2730:4308: scene=5A_12
#: 5A_12:2730
msgctxt "text_id=4308 | speaker=unknown"
msgid "　青子は決して止めまいと誓った足を止めて、無我夢中で手を伸ばす。"
msgstr "  Aoko stopped the feet she had sworn would never stop moving, and extended a hand out to him."

#. Occurrence 5A_12:2765:4309: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0010; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:2765
msgctxt "text_id=4309 | speaker=aoko"
msgid "「そんなのほっといていいから、早く！」"
msgstr "\"That's enough! Leave it! We have to go!\""

#. Occurrence 5A_12:2827:4310: scene=5A_12
#: 5A_12:2827
msgctxt "text_id=4310 | speaker=unknown"
msgid "　草十郎は消火器を捨てて走りだした。"
msgstr "  Soujyuro tossed the fire extinguisher aside and took off running."

#. Occurrence 5A_12:3010:4311: scene=5A_12
#: 5A_12:3010
msgctxt "text_id=4311 | speaker=unknown"
msgid "　ドミノ倒しに倒壊していく通路の天井。"
msgstr "  Pieces of the ceiling continued to collapse like dominos."

#. Occurrence 5A_12:3054:4312: scene=5A_12
#: 5A_12:3054
msgctxt "text_id=4312 | speaker=unknown"
msgid "　土砂に阻まれながらも先行する背。"
msgstr "  They kept moving with dust and dirt following in their wake."

#. Occurrence 5A_12:3190:4313: scene=5A_12
#: 5A_12:3190
msgctxt "text_id=4313 | speaker=unknown"
msgid "　崩れ落ちる通路を、全力で走るふたりの影。"
msgstr "  Their shadows raced through the collapsing corridor with all their strength."

#. Occurrence 5A_12:3311:4314: scene=5A_12
#: 5A_12:3311
msgctxt "text_id=4314 | speaker=unknown"
msgid "　……断末魔があがる。"
msgstr "  ...The castle was in the throes of death."

#. Occurrence 5A_12:3316:4315: scene=5A_12
#: 5A_12:3316
msgctxt "text_id=4315 | speaker=unknown"
msgid "　轟音と粉塵をまきあげ、キッツィーランドのシンボルであった御伽の城は、こうして、最後の<見せ場|ショウ>を終えたのだった。"
msgstr "  With a massive crash and a cloud of dust, the final chapter of the fairy tale that had been Kitsy Land came to an abrupt end."

#. Occurrence 5A_12:3402:4316: scene=5A_12
#: 5A_12:3402
msgctxt "text_id=4316 | speaker=unknown"
msgid "　生死を賭けたマラソンは終わった。"
msgstr "  This duel to the death was over."

#. Occurrence 5A_12:3407:4317: scene=5A_12
#: 5A_12:3407
msgctxt "text_id=4317 | speaker=unknown"
msgid "　苦楽とか命運とかを一瞬だけ共にしたふたりは、疲れきった体を芝生にあずけて、妙な連帯感に包まれていた。"
msgstr "  For a moment, amidst their swirling emotions, any past enmity was forgotten. The two collapsed on the lawn and basked in strange solidarity."

#. Occurrence 5A_12:3427:4318: scene=5A_12
#: 5A_12:3427
msgctxt "text_id=4318 | speaker=unknown"
msgid "　……耳鳴りはもう治まっている。"
msgstr "  The ringing in their ears subsided before long."

#. Occurrence 5A_12:3432:4319: scene=5A_12
#: 5A_12:3432
msgctxt "text_id=4319 | speaker=unknown"
msgid "　あれだけ大きかった地響きも、このさびれた遊園地では<彩|いろ>を失う。"
msgstr "  A tremor of such magnitude seemed impossible in an amusement park like this."

#. Occurrence 5A_12:3457:4320: scene=5A_12
#: 5A_12:3457
msgctxt "text_id=4320 | speaker=unknown"
msgid "　崩落の残響が廃墟に<沁|し>みこんでいくのを聞き届けながら、青子はとなりの人影に語りかけた。"
msgstr "  As the sounds of destruction echoed across the park, Aoko addressed the individual at her side."

#. Occurrence 5A_12:3465:4321: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0011; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3465
msgctxt "text_id=4321 | speaker=aoko"
msgid "「………………ねえ、生きてる？」"
msgstr "\"Hey...you alive?\""

#. Occurrence 5A_12:3471:4322: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0001; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:3471
msgctxt "text_id=4322 | speaker=soujuurou"
msgid "「うん」"
msgstr "\"Yeah.\""

#. Occurrence 5A_12:3477:4323: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0012; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3477
msgctxt "text_id=4323 | speaker=aoko"
msgid "「ちぇっ」"
msgstr "\"Tch.\""

#. Occurrence 5A_12:3482:4324: scene=5A_12
#: 5A_12:3482
msgctxt "text_id=4324 | speaker=unknown"
msgid "　可愛らしい舌打ちだったが、その真意は物騒なコトこの上ない。"
msgstr "  While the click of her tongue was adorable, the meaning behind it was anything but."

#. Occurrence 5A_12:3532:4325: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0002; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:3532
msgctxt "text_id=4325 | speaker=soujuurou"
msgid "「……蒼崎。あいつ、どうなった？」"
msgstr "\"...Aozaki? What happened to that thing?\""

#. Occurrence 5A_12:3538:4326: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0013; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3538
msgctxt "text_id=4326 | speaker=aoko"
msgid "「見ての通りよ。今ごろバラバラ死体になってるんじゃない？」"
msgstr "\"What do you think? It was crushed to bits.\""

#. Occurrence 5A_12:3544:4327: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0003; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:3544
msgctxt "text_id=4327 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5A_12:3564:4328: scene=5A_12
#: 5A_12:3564
msgctxt "text_id=4328 | speaker=unknown"
msgid "　身もふたもない青子の返答に、それならいいけど、とため息をつく草十郎。なぜなら、"
msgstr "  Soujyuro sighed, not wholly relieved by her frank response. His reason..."

#. Occurrence 5A_12:3589:4329: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0014; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3589
msgctxt "text_id=4329 | speaker=aoko"
msgid "「でも、そんな心配より自分の心配をした方がいいと思うわよ、静希くん？」"
msgstr "\"Never mind that thing. You should be worrying about yourself.\""

#. Occurrence 5A_12:3595:4330: scene=5A_12
#: 5A_12:3595
msgctxt "text_id=4330 | speaker=unknown"
msgid "　彼の災難は、目下継続中だったからだ。"
msgstr "  He wasn't out of the woods yet, after all."

#. Occurrence 5A_12:3654:4331: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0004; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:3654
msgctxt "text_id=4331 | speaker=soujuurou"
msgid "「……蒼崎、子供の頃はいじめっ子だっただろ」"
msgstr "\"...Aozaki, I'm guessing you were a bit of a bully as a kid.\""

#. Occurrence 5A_12:3674:4332: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0015; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3674
msgctxt "text_id=4332 | speaker=aoko"
msgid "「<加虐|かぎゃく>趣味はないって自負してるけど。"
msgstr "\"Maybe, but I don't get a kick out of seeing people suffer."

#. Occurrence 5A_12:3680:4333: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0016; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3680
msgctxt "text_id=4333 | speaker=aoko"
msgid "　それで、今の自分の立場、分かってる？」"
msgstr "  Never mind that. Do you know the situation you're in right now?\""

#. Occurrence 5A_12:3702:4334: scene=5A_12
#: 5A_12:3702
msgctxt "text_id=4334 | speaker=unknown"
msgid "　体を起こしてニコリと微笑む青子。"
msgstr "  She sat up and smiled."

#. Occurrence 5A_12:3707:4335: scene=5A_12
#: 5A_12:3707
msgctxt "text_id=4335 | speaker=unknown"
msgid "　口調も表情も優しいのに、なんでぞわっと寒気がするんだろうな、と草十郎はうなだれてみた。"
msgstr "  Soujyuro hung his head in shame, wondering why her kind tone and expression were so chilling."

#. Occurrence 5A_12:3739:4336: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0005; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:3739
msgctxt "text_id=4336 | speaker=soujuurou"
msgid "「……<面目|めんぼく>次第もございません」"
msgstr "\"Please accept my sincerest apologies.\""

#. Occurrence 5A_12:3759:4337: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0017; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3759
msgctxt "text_id=4337 | speaker=aoko"
msgid "「かしこまってもダメよ。あの提案には大前提があったわよね。これは取引だって。貴方が役に立つのなら見逃してあげるっていう」"
msgstr "\"Oh no, don't you even start. You know what our agreement was, and a deal is a deal. If you held up your end of the bargain, I'd let you go.\""

#. Occurrence 5A_12:3770:4338: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0006; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:3770
msgctxt "text_id=4338 | speaker=soujuurou"
msgid "「分かってる。だから面目ないって言ってるだろ」"
msgstr "\"Exactly. And that's why I'm apologizing.\""

#. Occurrence 5A_12:3776:4339: scene=5A_12
#: 5A_12:3776
msgctxt "text_id=4339 | speaker=unknown"
msgid "　草十郎はこれみよがしに顔を背けた。"
msgstr "  Soujyuro made a show of avoiding her eyes,"

#. Occurrence 5A_12:3781:4340: scene=5A_12
#: 5A_12:3781
msgctxt "text_id=4340 | speaker=unknown"
msgid "　ふん、と子供のようにふて腐れる。"
msgstr "  like a pouting child."

#. Occurrence 5A_12:3824:4341: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0018; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3824
msgctxt "text_id=4341 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5A_12:3830:4342: scene=5A_12
#: 5A_12:3830
msgctxt "text_id=4342 | speaker=unknown"
msgid "　その拗ねっぷりに面食らう青子。"
msgstr "  Aoko was taken aback by this sulky display."

#. Occurrence 5A_12:3835:4343: scene=5A_12
#: 5A_12:3835
msgctxt "text_id=4343 | speaker=unknown"
msgid "　……おそらく、ではあるが。"
msgstr "  Perhaps..."

#. Occurrence 5A_12:3841:4344: scene=5A_12
#: 5A_12:3841
msgctxt "text_id=4344 | speaker=unknown"
msgid "草十郎は青子にではなく、自分に対して怒っているのだ。"
msgstr "He was angry at himself rather than her."

#. Occurrence 5A_12:3846:4345: scene=5A_12
#: 5A_12:3846
msgctxt "text_id=4345 | speaker=unknown"
msgid "　青子に見逃してもらえない事より、役に立てなかった事が悔しかった、と。"
msgstr "  He was not mad because she would not let him go. He was mad that he had not done his part."

#. Occurrence 5A_12:3872:4346: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0019; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3872
msgctxt "text_id=4346 | speaker=aoko"
msgid "「――――――はあ」"
msgstr "\"...Haaah.\""

#. Occurrence 5A_12:3878:4347: scene=5A_12
#: 5A_12:3878
msgctxt "text_id=4347 | speaker=unknown"
msgid "　つい、<本日|ほんじつ>何度目かのため息を青子はもらした。"
msgstr "  Aoko sighed for what seemed like the millionth time that day."

#. Occurrence 5A_12:3883:4348: scene=5A_12
#: 5A_12:3883
msgctxt "text_id=4348 | speaker=unknown"
msgid "　……目前の少年のお人好し加減と、その長所を認めてしまった自分の甘さに呆れてしまう。"
msgstr "  She could not figure out what surprised her more: his unconditional kindness, or her naïve approval of it."

#. Occurrence 5A_12:3918:4349: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0020; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:3918
msgctxt "text_id=4349 | speaker=aoko"
msgid "「じゃあ覚悟は出来てるの？」"
msgstr "\"So, are you ready?\""

#. Occurrence 5A_12:3930:4350: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0007; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:3930
msgctxt "text_id=4350 | speaker=soujuurou"
msgid "「……そんなのは出来ないけど、約束だからな。結局は、何もしていないし」"
msgstr "\"Of course not, but a promise is a promise. In the end, I failed to do my part.\""

#. Occurrence 5A_12:3936:4351: scene=5A_12
#: 5A_12:3936
msgctxt "text_id=4351 | speaker=unknown"
msgid "　確かに、青子が期待した事は、なにひとつ。"
msgstr "  It was certainly the case that he failed to do any of the things she had expected of him."

#. Occurrence 5A_12:3946:4352: scene=5A_12
#: 5A_12:3946
msgctxt "text_id=4352 | speaker=unknown"
msgid "　けど、と青子は崩れ去ったミラーハウスを一瞥した。"
msgstr "  But just then, she glanced back at the collapsed house of mirrors."

#. Occurrence 5A_12:3951:4353: scene=5A_12
#: 5A_12:3951
msgctxt "text_id=4353 | speaker=unknown"
msgid "　囮役を見事に失敗し、途方にくれた彼は何を選択したのか。"
msgstr "  What had he done after failing so spectacularly?"

#. Occurrence 5A_12:3998:4354: scene=5A_12
#: 5A_12:3998
msgctxt "text_id=4354 | speaker=unknown"
msgid "　……わざわざ武器になるような消火器を探して、"
msgstr "  He had searched for the extinguisher so he could use it as a weapon,"

#. Occurrence 5A_12:4003:4355: scene=5A_12
#: 5A_12:4003
msgctxt "text_id=4355 | speaker=unknown"
msgid "　崩れだした迷路の中で、ひとりで出るわけにはいかないと、あの広間で足を止めていた。"
msgstr "  and waited patiently in the plaza as the maze collapsed all around him just because he thought it was wrong to leave her behind."

#. Occurrence 5A_12:4009:4356: scene=5A_12
#: 5A_12:4009
msgctxt "text_id=4356 | speaker=unknown"
msgid "　それは<躊躇|ためら>うことなく出口を目指した彼女とは真逆の、あまりにも愚かな選択だ。"
msgstr "  It was a foolish choice, and the exact opposite of her choice to run towards the exit without hesitation."

#. Occurrence 5A_12:4035:4357: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0021; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:4035
msgctxt "text_id=4357 | speaker=aoko"
msgid "“……ま、それでよしとするか”"
msgstr "\"I suppose I'll take it.\""

#. Occurrence 5A_12:4041:4358: scene=5A_12
#: 5A_12:4041
msgctxt "text_id=4358 | speaker=unknown"
msgid "　甘いなあ、と呆れながらも満足する。"
msgstr "  She was satisfied, even as she was shocked at how naive she was being."

#. Occurrence 5A_12:4046:4359: scene=5A_12
#: 5A_12:4046
msgctxt "text_id=4359 | speaker=unknown"
msgid "　だって救われたのは事実だし。"
msgstr "  It was true that he had saved her."

#. Occurrence 5A_12:4051:4360: scene=5A_12
#: 5A_12:4051
msgctxt "text_id=4360 | speaker=unknown"
msgid "　あの状況で待ち続ける勇気は、たとえ一秒だけだとしても賞賛に値すると、彼女は内心微笑んだ。"
msgstr "  She smiled inwardly, admiring―if only for a moment―the bravery he continued to show in the face of such extreme circumstances."

#. Occurrence 5A_12:4109:4361: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0022; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:4109
msgctxt "text_id=4361 | speaker=aoko"
msgid "“……役割は果たさなかったけど、アフターケアは合格だし。約束は、守らなくちゃね”"
msgstr "\"You may have blown your chance, but you did make up for it after the fact. I'll keep my promise.\""

#. Occurrence 5A_12:4115:4362: scene=5A_12
#: 5A_12:4115
msgctxt "text_id=4362 | speaker=unknown"
msgid "　ひとり頷いて、青子はすくっと立ち上がる。"
msgstr "  With a nod, she pulled herself to her feet."

#. Occurrence 5A_12:4143:4363: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0023; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:4143
msgctxt "text_id=4363 | speaker=aoko"
msgid "「約束は、ま、いつか守ってもらうとして」"
msgstr "\"But you'll pay back this favor, someday.\""

#. Occurrence 5A_12:4165:4364: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0008; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:4165
msgctxt "text_id=4364 | speaker=soujuurou"
msgid "「？」"
msgstr "\"...?\""

#. Occurrence 5A_12:4200:4365: scene=5A_12
#: 5A_12:4200
msgctxt "text_id=4365 | speaker=unknown"
msgid "　少女は出来るだけ無感情を装って、まだ倒れこんでいる少年に手を差し伸べる。"
msgstr "  The girl tried to keep a straight face as she offered a hand to the boy still lying on the ground."

#. Occurrence 5A_12:4221:4366: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0024; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:4221
msgctxt "text_id=4366 | speaker=aoko"
msgid "「結果はどうあれ手助けしてもらったし。"
msgstr "\"You managed to help me in the end."

#. Occurrence 5A_12:4228:4367: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0025; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:4228
msgctxt "text_id=4367 | speaker=aoko"
msgid "特別サービスってコトで、今夜はもう手を出さないであげる」"
msgstr "So, because of that, I'll let you off the hook. For tonight.\""

#. Occurrence 5A_12:4252:4368: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0009; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:4252
msgctxt "text_id=4368 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5A_12:4299:4369: scene=5A_12
#: 5A_12:4299
msgctxt "text_id=4369 | speaker=unknown"
msgid "　照れくさそうに顔を逸らす少女。"
msgstr "  She bashfully averted her gaze."

#. Occurrence 5A_12:4304:4370: scene=5A_12
#: 5A_12:4304
msgctxt "text_id=4370 | speaker=unknown"
msgid "　その横顔はあの日のものとは違っていたけれど、紛れもなく、少年がこの町に来てはじめて見入った、鮮やかな少女の顔だった。"
msgstr "  Though her profile appeared different than it had in the past, it was clearly still the face of the vibrant girl he met the day he first arrived in town."

#. Occurrence 5A_12:4338:4371: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0026; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:4338
msgctxt "text_id=4371 | speaker=aoko"
msgid "「――――――なによ」"
msgstr "\"What are you staring at!?\""

#. Occurrence 5A_12:4343:4372: scene=5A_12
#: 5A_12:4343
msgctxt "text_id=4372 | speaker=unknown"
msgid "　視線を感じたのか、口をとがらせてじろりと睨む青子。"
msgstr "  As if she had felt his eyes on her, she shot him a frowning glare."

#. Occurrence 5A_12:4363:4373: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0010; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:4363
msgctxt "text_id=4373 | speaker=soujuurou"
msgid "「いや。突拍子もないけど、蒼崎は律儀だなって」"
msgstr "\"Oh, sorry. It's just, as crazy as it is to say it aloud, you really are a fair person, Aozaki.\""

#. Occurrence 5A_12:4387:4374: scene=5A_12
#: 5A_12:4387
msgctxt "text_id=4374 | speaker=unknown"
msgid "　差し出された手を握る。"
msgstr "  He took her outstretched hand."

#. Occurrence 5A_12:4392:4375: scene=5A_12
#: 5A_12:4392
msgctxt "text_id=4375 | speaker=unknown"
msgid "　青子は草十郎の体重を感じながら、貴方にだけは言われたくはないわ、と手を引いた。"
msgstr "  Feeling his weight as she pulled him up, she could not help but think that he was about the last person she wanted to hear that from."

#. Occurrence 5A_12:4437:4376: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_12_0011; voice_prefix=A30; voice_category=3; scene=5A_12
#: 5A_12:4437
msgctxt "text_id=4376 | speaker=soujuurou"
msgid "「ところで。今夜はって言うけど、明日からは？」"
msgstr "\"By the way, you said you'd let me off the hook for tonight. What about tomorrow?\""

#. Occurrence 5A_12:4443:4377: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0027; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:4443
msgctxt "text_id=4377 | speaker=aoko"
msgid "「さあ。ま、その時になったら考えるわ」"
msgstr "\"Well, we'll just have to see.\""

#. Occurrence 5A_12:4449:4378: scene=5A_12
#: 5A_12:4449
msgctxt "text_id=4378 | speaker=unknown"
msgid "　自分でもなんだかなあ、と肩をすくめる青子。"
msgstr "  She shrugged her shoulders as if she was not sure herself."

#. Occurrence 5A_12:4454:4379: scene=5A_12
#: 5A_12:4454
msgctxt "text_id=4379 | speaker=unknown"
msgid "　その仕草がおかしく、草十郎も笑ってしまう。"
msgstr "  The response was so unlike her that it made Soujyuro smile."

#. Occurrence 5A_12:4493:4380: scene=5A_12
#: 5A_12:4493
msgctxt "text_id=4380 | speaker=unknown"
msgid "　共に死線をくぐり抜けた連帯感とか、つかの間<築|きず>かれた友情とか。"
msgstr "  Was it the solidarity of having escaped death together, or their fleeting camaraderie that made him do so?"

#. Occurrence 5A_12:4498:4381: scene=5A_12
#: 5A_12:4498
msgctxt "text_id=4381 | speaker=unknown"
msgid "　それが今夜かぎりのものでも、ふたりを包む空気は<和|なご>やかで、優しいものだった。"
msgstr "  It might have been for this night only, but the air between them was kind and gentle."

#. Occurrence 5A_12:4503:4382: scene=5A_12
#: 5A_12:4503
msgctxt "text_id=4382 | speaker=unknown"
msgid "　色々あったけれど、真冬の夜の悪夢はこれでおしまい。"
msgstr "  A lot had transpired, but the midwinter nightmare had come to an end."

#. Occurrence 5A_12:4508:4383: scene=5A_12
#: 5A_12:4508
msgctxt "text_id=4383 | speaker=unknown"
msgid "　ふたりはそれぞれの窮地を乗り越え、鏡の国を後にする。"
msgstr "  The pair had overcome many trials and tribulations and could now leave the mirror realm in their wake."

#. Occurrence 5A_12:4530:4384: scene=5A_12
#: 5A_12:4530
msgctxt "text_id=4384 | speaker=unknown"
msgid "　……けれど、その前に。"
msgstr "  But before that..."

#. Occurrence 5A_12:4577:4385: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5A_12_0000; voice_prefix=A40; voice_category=2; scene=5A_12
#: 5A_12:4577
msgctxt "text_id=4385 | speaker=alice"
msgid "「―――随分と身勝手ね。"
msgstr "\"...How selfish of you."

#. Occurrence 5A_12:4583:4386: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5A_12_0001; voice_prefix=A40; voice_category=2; scene=5A_12
#: 5A_12:4583
msgctxt "text_id=4386 | speaker=alice"
msgid "　それは貴女ひとりで決めていい事だったかしら、青子？」"
msgstr "  And who, may I ask, said you could decide that, Aoko?\""

#. Occurrence 5A_12:4773:4387: scene=5A_12
#: 5A_12:4773
msgctxt "text_id=4387 | speaker=unknown"
msgid "　それは美しい鳥のさえずりにも、"
msgstr "  It was the voice of a beautiful songbird"

#. Occurrence 5A_12:4773:4388: scene=5A_12
#: 5A_12:4773
msgctxt "text_id=4388 | speaker=unknown"
msgid "　無慈悲な機械の声にも似て。"
msgstr "  and a merciless machine, all rolled into one."

#. Occurrence 5A_12:4794:4389: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_12_0028; voice_prefix=A10; voice_category=1; scene=5A_12
#: 5A_12:4794
msgctxt "text_id=4389 | speaker=aoko"
msgid "「―――有珠」"
msgstr "\"...Alice.\""

#. Occurrence 5A_12:4800:4390: scene=5A_12
#: 5A_12:4800
msgctxt "text_id=4390 | speaker=unknown"
msgid "　……震える声で、青子は少女の名を口にした。"
msgstr "  Her voice quivered as she spoke the name."

#. Occurrence 5A_12:4857:4391: scene=5A_12
#: 5A_12:4857
msgctxt "text_id=4391 | speaker=unknown"
msgid "　降り立つ黒衣。"
msgstr "  The lady in black made her presence known."

#. Occurrence 5A_12:4863:4392: scene=5A_12
#: 5A_12:4863
msgctxt "text_id=4392 | speaker=unknown"
msgid "　……夜はまだ終わらない。"
msgstr "  The night was not yet over."

#. Occurrence 5A_12:4868:4393: scene=5A_12
#: 5A_12:4868
msgctxt "text_id=4393 | speaker=unknown"
msgid "　少女の名は久遠寺有珠。"
msgstr "  Her name was Alice Kuonji."

#. Occurrence 5A_12:4874:4394: scene=5A_12
#: 5A_12:4874
msgctxt "text_id=4394 | speaker=unknown"
msgid "　青子をして魔女と恐れさせる、"
msgstr "  She was a witch whose name struck fear into the heart of Aoko―"

msgctxt "text_id=4395 | speaker=unknown"
msgid "目撃者は例外なく逃がさない、夜の化身がやってきた。"
msgstr "an avatar of the night who would allow no witnesses."

#. Occurrence 5A_2:79:4396: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0000; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:79
msgctxt "text_id=4396 | speaker=soujuurou"
msgid "「あれか」"
msgstr "\"I guess that's it.\""

#. Occurrence 5A_2:86:4397: scene=5A_2
#: 5A_2:86
msgctxt "text_id=4397 | speaker=unknown"
msgid "　静まりかえった中央広場から、案内にしたがって西に。"
msgstr "  The central plaza was as silent as a grave. According to the map, the meeting spot was west of here."

#. Occurrence 5A_2:91:4398: scene=5A_2
#: 5A_2:91
msgctxt "text_id=4398 | speaker=unknown"
msgid "　着いた先には曇天の夜を<背景|バック>に、<凹凸|おうとつ>の多い、<威容|いよう><異彩|いさい>な城がそびえていた。"
msgstr "  Waiting for Soujyuro at his destination was a rugged, imposing, magnificent castle towering before the backdrop of the cloudy night sky."

#. Occurrence 5A_2:111:4399: scene=5A_2
#: 5A_2:111
msgctxt "text_id=4399 | speaker=unknown"
msgid "　廃遊園地の中でも<一際|ひときわ>大きい建造物。"
msgstr "  Even for an abandoned park, it was a remarkable structure."

#. Occurrence 5A_2:116:4400: scene=5A_2
#: 5A_2:116
msgctxt "text_id=4400 | speaker=unknown"
msgid "　コースターや観覧車が動のアトラクションなら、あれは静のアトラクション。"
msgstr "  If the roller coasters and the Ferris wheel were loud, intense attractions, this was comparatively quiet and easygoing."

#. Occurrence 5A_2:122:4401: scene=5A_2
#: 5A_2:122
msgctxt "text_id=4401 | speaker=unknown"
msgid "　キッツィーランドの三大シンボルの一つであり、ある意味、この楽園を閉鎖に導いた魔の建物だ。"
msgstr "  It was one of Kitsy Land's three iconic structures and, in a way, the wicked fortress that guided this paradise down the path of closure."

#. Occurrence 5A_2:158:4402: scene=5A_2
#: 5A_2:158
msgctxt "text_id=4402 | speaker=unknown"
msgid "　一般的に、遊園地の<迷路|メイズ>は大きく二種類に分類される。"
msgstr "  Generally speaking, amusement park mazes generally fell into one of two categories:"

#. Occurrence 5A_2:164:4403: scene=5A_2
#: 5A_2:164
msgctxt "text_id=4403 | speaker=unknown"
msgid "　建物の広さで来訪者を迷わす<大迷路|ラビュリントス>と、"
msgstr "  Labyrinths, which disorient visitors with their sheer size,"

#. Occurrence 5A_2:164:4404: scene=5A_2
#: 5A_2:164
msgctxt "text_id=4404 | speaker=unknown"
msgid "　交錯する光で来訪者を迷わすミラーハウスだ。"
msgstr "  and mirror houses, which disorient visitors with optical illusions."

#. Occurrence 5A_2:209:4405: scene=5A_2
#: 5A_2:209
msgctxt "text_id=4405 | speaker=unknown"
msgid "　大迷路はその広さ、つかの間の冒険性で、多くの来訪者たちを楽しませた。"
msgstr "  Many of a labyrinth's guests enjoyed the brief sense of adventure that it afforded."

#. Occurrence 5A_2:214:4406: scene=5A_2
#: 5A_2:214
msgctxt "text_id=4406 | speaker=unknown"
msgid "　後年、刺激をより増していく他のアトラクションに押され衰退していく事になるが、それは一世を<風靡|ふうび>したものの宿命だろう。"
msgstr "  Over the years, however, it would be usurped by the ever-increasing thrills of new attractions. Such was the way of all trends; the curse of fads."

#. Occurrence 5A_2:219:4407: scene=5A_2
#: 5A_2:219
msgctxt "text_id=4407 | speaker=unknown"
msgid "　新しいものは、次の新しいものに駆逐されなければならないのだから。"
msgstr "  The new must give way to the newer."

#. Occurrence 5A_2:243:4408: scene=5A_2
#: 5A_2:243
msgctxt "text_id=4408 | speaker=unknown"
msgid "　一方、ミラーハウスは古くから愛されてきた定番だ。"
msgstr "  On the other hand, the house of mirrors was a time-honored, beloved staple."

#. Occurrence 5A_2:248:4409: scene=5A_2
#: 5A_2:248
msgctxt "text_id=4409 | speaker=unknown"
msgid "　学校の教室ほどの広さでも鏡の設置と光の演出で来訪者を楽しませ、迷わせる。"
msgstr "  Even within the confines of a classroom's dimensions, well-placed mirrors and well-directed light could both perplex and delight its visitors."

#. Occurrence 5A_2:253:4410: scene=5A_2
#: 5A_2:253
msgctxt "text_id=4410 | speaker=unknown"
msgid "　コスト面に優れたミラーハウスは大迷路より遥かに長生きしたアトラクションだ。"
msgstr "  And figuring in the cost of maintenance, a well-designed house of mirrors could far outlive its labyrinth brethren."

#. Occurrence 5A_2:258:4411: scene=5A_2
#: 5A_2:258
msgctxt "text_id=4411 | speaker=unknown"
msgid "　両者とも新世紀には姿を消す事になるとしても、遊園地を代表する遊び場であるのは間違いない。"
msgstr "  Even if both types faded into obscurity, they would remain a staple of what constituted an amusement park."

#. Occurrence 5A_2:278:4412: scene=5A_2
#: 5A_2:278
msgctxt "text_id=4412 | speaker=unknown"
msgid "　……が。"
msgstr "  However..."

#. Occurrence 5A_2:289:4413: scene=5A_2
#: 5A_2:289
msgctxt "text_id=4413 | speaker=unknown"
msgid "　だからといって、その二つを混ぜるのはよろしくない。"
msgstr "  That didn't mean that combining them would produce double the fun."

#. Occurrence 5A_2:294:4414: scene=5A_2
#: 5A_2:294
msgctxt "text_id=4414 | speaker=unknown"
msgid "　それでは訪れた者を楽しませる迷路というより、踏み入れた者を帰さない魔境になってしまう。"
msgstr "  Together, they transformed from entertainment into an uncanny realm from which those who dared to step within could never leave."

#. Occurrence 5A_2:299:4415: scene=5A_2
#: 5A_2:299
msgctxt "text_id=4415 | speaker=unknown"
msgid "　さもありなん。"
msgstr "  In a similar sense,"

#. Occurrence 5A_2:304:4416: scene=5A_2
#: 5A_2:304
msgctxt "text_id=4416 | speaker=unknown"
msgid "　その魔境こそがここ、キッツィーミステリーツアー城なのであった。"
msgstr "  Kitsy's Mystery Tour Castle was the park's very own otherworld."

#. Occurrence 5A_2:324:4417: scene=5A_2
#: 5A_2:324
msgctxt "text_id=4417 | speaker=unknown"
msgid "　係員に助けを求めた入場者、実に５パーセント。"
msgstr "  Indeed, five percent of visitors ended up requesting staff assistance to get out."

#. Occurrence 5A_2:329:4418: scene=5A_2
#: 5A_2:329
msgctxt "text_id=4418 | speaker=unknown"
msgid "　西洋の城を模した建物は奥行き百メートルほどもあり、内部はさらに三層に分かれている。"
msgstr "  Modeled after European castles, it was greater than a football field in length, and the interior was further split into three floors."

#. Occurrence 5A_2:349:4419: scene=5A_2
#: 5A_2:349
msgctxt "text_id=4419 | speaker=unknown"
msgid "　地上二階、地下一階の迷路はすべて鏡張りで、熟練者でも脱出に三十分を要するほど複雑かつ広大。"
msgstr "  Two floors above ground and one below, lined with mirrors from top to bottom, equal parts complex and vast. The maze demanded at least thirty minutes even from veterans."

#. Occurrence 5A_2:354:4420: scene=5A_2
#: 5A_2:354
msgctxt "text_id=4420 | speaker=unknown"
msgid "　一度足を踏み入れたが最後、むこう半日は鏡面恐怖症におちいる大迷路のなれの果てが、こうして草十郎の目の前に立ちふさがっているのだが―――"
msgstr "  One visit was all it took to be struck by catoptrophobia for hours. It was this labyrinth that now stood in Soujyuro's way. "

#. Occurrence 5A_2:423:4421: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0001; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:423
msgctxt "text_id=4421 | speaker=soujuurou"
msgid "「真っ暗ってワケじゃないな……電気とか、ついてるんだろうか」"
msgstr "\"It looks like it's not entirely pitch black... I guess somebody turned the lights on.\""

#. Occurrence 5A_2:429:4422: scene=5A_2
#: 5A_2:429
msgctxt "text_id=4422 | speaker=unknown"
msgid "　そもそもミラーハウスを知らない草十郎の関心は、明かりの有無にのみ向けられている。"
msgstr "  It seemed that Soujyuro, unaware of what a house of mirrors even was, concerned himself only with its lighting."

#. Occurrence 5A_2:451:4423: scene=5A_2
#: 5A_2:451
msgctxt "text_id=4423 | speaker=unknown"
msgid "　もう一度、蒼崎青子からの手紙を確認する。"
msgstr "  He checked the letter from Aoko once more."

#. Occurrence 5A_2:456:4424: scene=5A_2
#: 5A_2:456
msgctxt "text_id=4424 | speaker=unknown"
msgid "　手紙には『ミラーハウス一階ロビーで待っています』とある。"
msgstr "  The letter read, \"I will be waiting in the first-floor lobby of the house of mirrors.\""

#. Occurrence 5A_2:476:4425: scene=5A_2
#: 5A_2:476
msgctxt "text_id=4425 | speaker=unknown"
msgid "　待ち合わせ場所はたしかにこの中だ。"
msgstr "  That meeting place was definitely in here."

#. Occurrence 5A_2:481:4426: scene=5A_2
#: 5A_2:481
msgctxt "text_id=4426 | speaker=unknown"
msgid "　電灯の有無はともかく、開けっ放しの入り口から見える内部はうっすらと明るい。"
msgstr "  There was something to see by at least, as he could just make out light faintly through the open doors."

#. Occurrence 5A_2:487:4427: scene=5A_2
#: 5A_2:487
msgctxt "text_id=4427 | speaker=unknown"
msgid "　なら間違いないだろう、と草十郎はミラーハウスの入り口に向かって歩きだした。"
msgstr "  Putting aside his suspicions, he headed toward the entrance."

#. Occurrence 5A_2:535:4428: scene=5A_2
#: 5A_2:535
msgctxt "text_id=4428 | speaker=unknown"
msgid "　……カツカツと煉瓦の道を踏みならす音。"
msgstr "  ...The sound of his steps against the brick-laid path echoed faintly."

#. Occurrence 5A_2:541:4429: scene=5A_2
#: 5A_2:541
msgctxt "text_id=4429 | speaker=unknown"
msgid "　街の喧噪は遠く、"
msgstr "  He was far from the hustle and bustle of the city."

#. Occurrence 5A_2:546:4430: scene=5A_2
#: 5A_2:546
msgctxt "text_id=4430 | speaker=unknown"
msgid "　時計の秒針は数年前から動かず、"
msgstr "  The park's clocks no longer made tick nor tock,"

#. Occurrence 5A_2:551:4431: scene=5A_2
#: 5A_2:551
msgctxt "text_id=4431 | speaker=unknown"
msgid "　風の音すら無い冬の夜。"
msgstr "  and the winter's bite no longer blew in the night."

#. Occurrence 5A_2:571:4432: scene=5A_2
#: 5A_2:571
msgctxt "text_id=4432 | speaker=unknown"
msgid "　そんな、第三者がいれば<固唾|かたず>を呑んで呼吸を止めそうな静寂のなか。"
msgstr "  From within the silence, the stillness that would cause any onlooker to hold their breath..."

#. Occurrence 5A_2:580:4433: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0002; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:580
msgctxt "text_id=4433 | speaker=soujuurou"
msgid "「……えーと」"
msgstr "\"...Hello?\""

#. Occurrence 5A_2:586:4434: scene=5A_2
#: 5A_2:586
msgctxt "text_id=4434 | speaker=unknown"
msgid "　草十郎はミラーハウスの入り口で、ぴたりと唐突に立ち止まると、"
msgstr "  Soujyuro stopped abruptly at the entrance to the house of mirrors."

#. Occurrence 5A_2:623:4435: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0003; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:623
msgctxt "text_id=4435 | speaker=soujuurou"
msgid "「ところで蒼崎。そんなところで何してるんだ？」"
msgstr "\"By the way, why are you over there, Aozaki?\""

#. Occurrence 5A_2:629:4436: scene=5A_2
#: 5A_2:629
msgctxt "text_id=4436 | speaker=unknown"
msgid "　いま歩いてきた広場を振り返って、不思議そうに呼びかけるのだった。"
msgstr "  He called out, turning back toward the plaza."

#. Occurrence 5A_2:666:4437: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0000; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:666
msgctxt "text_id=4437 | speaker=aoko"
msgid "「！？」"
msgstr "\"?!\""

#. Occurrence 5A_2:672:4438: scene=5A_2
#: 5A_2:672
msgctxt "text_id=4438 | speaker=unknown"
msgid "　勢い、身を隠していたゴミ箱ごと<突|つ>っ<伏|ぷ>す音。"
msgstr "  A sound rang out, as if someone had dove behind a garbage can and it fell to the ground in their haste."

#. Occurrence 5A_2:694:4439: scene=5A_2
#: 5A_2:694
msgctxt "text_id=4439 | speaker=unknown"
msgid "　……しばしの静寂。"
msgstr "  ...A short silence ensued."

#. Occurrence 5A_2:699:4440: scene=5A_2
#: 5A_2:699
msgctxt "text_id=4440 | speaker=unknown"
msgid "　一分ほどで廃遊園地はもとの静けさを取り戻した。"
msgstr "  For a moment, the abandoned park returned to its previous hush."

#. Occurrence 5A_2:704:4441: scene=5A_2
#: 5A_2:704
msgctxt "text_id=4441 | speaker=unknown"
msgid "　ついでに、観念したように物陰から現れる少女がひとり。"
msgstr "  Resigned to her having been exposed, the girl appeared from her hiding place."

#. Occurrence 5A_2:752:4442: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0004; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:752
msgctxt "text_id=4442 | speaker=soujuurou"
msgid "「あお―――」"
msgstr "\"Ao―\""

#. Occurrence 5A_2:768:4443: scene=5A_2
#: 5A_2:768
msgctxt "text_id=4443 | speaker=unknown"
msgid "　見知った顔と、見慣れない私服姿に声が止まる。"
msgstr "  His voice died in his throat as he took in the sight of the girl's familiar face in unfamiliar attire."

#. Occurrence 5A_2:773:4444: scene=5A_2
#: 5A_2:773
msgctxt "text_id=4444 | speaker=unknown"
msgid "　はらりと長髪を流して現れた蒼崎青子は、草十郎の知っている彼女とは違っていたからだ。"
msgstr "  This Aoko, with her long hair flowing in the breeze, was different from the Aoko that Soujyuro knew."

#. Occurrence 5A_2:820:4445: scene=5A_2
#: 5A_2:820
msgctxt "text_id=4445 | speaker=unknown"
msgid "　凛とした背筋と手足が、意志の強さをいっそう際立たせている。"
msgstr "  The resolute stance and posture she took exuded the strength of her will."

#. Occurrence 5A_2:825:4446: scene=5A_2
#: 5A_2:825
msgctxt "text_id=4446 | speaker=unknown"
msgid "　まっすぐに相手を<射|い><貫|ぬ>く瞳。"
msgstr "  She stared directly at him with a sharp-eyed, piercing gaze."

#. Occurrence 5A_2:830:4447: scene=5A_2
#: 5A_2:830
msgctxt "text_id=4447 | speaker=unknown"
msgid "　<澄|す>んだ瞳は<比|ひ><喩|ゆ>ではなく、錯覚でなければ、実際に<燐|うす>い光を帯びている。"
msgstr "  Her eyes were glowing with a dim phosphoric light, enough to give Soujyuro pause that he might be hallucinating."

#. Occurrence 5A_2:850:4448: scene=5A_2
#: 5A_2:850
msgctxt "text_id=4448 | speaker=unknown"
msgid "　氷の無機質さと、少女としての力強さ。"
msgstr "  An icy coldness and a girl's strength."

#. Occurrence 5A_2:855:4449: scene=5A_2
#: 5A_2:855
msgctxt "text_id=4449 | speaker=unknown"
msgid "　その不釣り合いな組み合わせが、危機感の欠如した草十郎をして、良からぬ空気を感じさせた。"
msgstr "  Soujyuro lacked a sense of danger, but the sense of imbalance caused even him to feel the malice in the air."

#. Occurrence 5A_2:861:4450: scene=5A_2
#: 5A_2:861
msgctxt "text_id=4450 | speaker=unknown"
msgid "　<喩|たと>えるなら、怪談でいう雪女が現実に現れたような。"
msgstr "  It was as though the yuki-onna spirit of folklore had climbed out from a ghost story and appeared here in reality."

#. Occurrence 5A_2:904:4451: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0005; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:904
msgctxt "text_id=4451 | speaker=soujuurou"
msgid "「……蒼崎？」"
msgstr "\"...Aozaki?\""

#. Occurrence 5A_2:918:4452: scene=5A_2
#: 5A_2:918
msgctxt "text_id=4452 | speaker=unknown"
msgid "　つい、と草十郎はあとずさる。"
msgstr "  Instinctively, Soujyuro took a step back."

#. Occurrence 5A_2:923:4453: scene=5A_2
#: 5A_2:923
msgctxt "text_id=4453 | speaker=unknown"
msgid "　小さな驚きと違和感。"
msgstr "  Surprised, he was starting to feel concerned."

#. Occurrence 5A_2:928:4454: scene=5A_2
#: 5A_2:928
msgctxt "text_id=4454 | speaker=unknown"
msgid "　そして、それらを上回る嫌な予感に混乱しつつあるが、とにかく都会の礼儀として声をかけたのだが……"
msgstr "  An unpleasant premonition rose to the surface, bringing with it a sense of anxiety. In spite of this, he felt obliged to honor urban etiquette by seeing if she was all right."

#. Occurrence 5A_2:949:4455: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0006; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:949
msgctxt "text_id=4455 | speaker=soujuurou"
msgid "「……その顔を見るに、何かあったのかといちおう聞いておくん、だけど―――」"
msgstr "\"...Did something happen to you? From the looks of it, I, um...\""

#. Occurrence 5A_2:972:4456: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0001; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:972
msgctxt "text_id=4456 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5A_2:978:4457: scene=5A_2
#: 5A_2:978
msgctxt "text_id=4457 | speaker=unknown"
msgid "　挨拶もなく、青子は一歩前に進んだ。"
msgstr "  Without acknowledging him, Aoko took a step forward."

#. Occurrence 5A_2:983:4458: scene=5A_2
#: 5A_2:983
msgctxt "text_id=4458 | speaker=unknown"
msgid "　その姿、その雰囲気が草十郎の曖昧な記憶を揺さぶる。"
msgstr "  Her figure, this atmosphere... Soujyuro found himself recalling a recent memory."

#. Occurrence 5A_2:1036:4459: scene=5A_2
#: 5A_2:1036
msgctxt "text_id=4459 | speaker=unknown"
msgid "　心中、交錯しまくっていた草十郎の不安は、そろそろ確信に変わりつつある。"
msgstr "  His twisted and knotted apprehension melted away and was replaced with a growing realization."

#. Occurrence 5A_2:1060:4460: scene=5A_2
#: 5A_2:1060
msgctxt "text_id=4460 | speaker=unknown"
msgid "　あの時は後ろ姿だけだったが、今にして思えば夜の公園で見た人影と目前の少女の姿はなんとなく……"
msgstr "  The girl before him was very similar to someone he had seen before, that night in the park, though he had only seen her from behind."

#. Occurrence 5A_2:1065:4461: scene=5A_2
#: 5A_2:1065
msgctxt "text_id=4461 | speaker=unknown"
msgid "　どころか、うり二つではないだろうか？　と<固唾|かたず>など呑む始末。"
msgstr "  With increasing certainty causing him to swallow nervously, he noted that they... might as well have been identical."

#. Occurrence 5A_2:1095:4462: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0002; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1095
msgctxt "text_id=4462 | speaker=aoko"
msgid "「何をしていたかって話なら、見ての通りよ。"
msgstr "\"You asked me what I was doing. Well, it's exactly what it looks like."

#. Occurrence 5A_2:1103:4463: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0003; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1103
msgctxt "text_id=4463 | speaker=aoko"
msgid "　ここで獲物が通り過ぎるのを待ってたの。貴方が入ってから私も入って、逃げ道を無くすつもりだったから」"
msgstr "  I was waiting for my prey to pass by. Once you went inside, I was going to follow and cut off your only route of escape.\""

#. Occurrence 5A_2:1112:4464: scene=5A_2
#: 5A_2:1112
msgctxt "text_id=4464 | speaker=unknown"
msgid "　なのにいきなりコレとはね、と腐りながら青子は言った。"
msgstr "  Aoko said, perturbed by the swift change in plans."

#. Occurrence 5A_2:1133:4465: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0007; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:1133
msgctxt "text_id=4465 | speaker=soujuurou"
msgid "“そうか。待ち合わせ場所はあってたんだな”"
msgstr "(Phew, so I came to the right place.)"

#. Occurrence 5A_2:1144:4466: scene=5A_2
#: 5A_2:1144
msgctxt "text_id=4466 | speaker=unknown"
msgid "　良かった、と内心でホッとする草十郎。"
msgstr "  Soujyuro was mightily relieved he had not got the wrong place."

#. Occurrence 5A_2:1149:4467: scene=5A_2
#: 5A_2:1149
msgctxt "text_id=4467 | speaker=unknown"
msgid "　わりと余裕があるのか、それとも事ここに至ってやっぱり現状が把握できていないのか。"
msgstr "  It was unclear whether he felt confident about dealing with what was to come, or if he had simply failed to grasp the hopelessness of the situation."

#. Occurrence 5A_2:1154:4468: scene=5A_2
#: 5A_2:1154
msgctxt "text_id=4468 | speaker=unknown"
msgid "　そんな草十郎の<鈍|にぶ>い反応をあえて無視して青子は続けた。"
msgstr "  Aoko ignored his obtuse response and continued."

#. Occurrence 5A_2:1180:4469: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0004; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1180
msgctxt "text_id=4469 | speaker=aoko"
msgid "「―――私はね、静希君。"
msgstr "\"You know, Sizuki."

#. Occurrence 5A_2:1211:4470: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0005; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1211
msgctxt "text_id=4470 | speaker=aoko"
msgid "　嫌いな人とか、憎い人とかは人並みにいるんだ。"
msgstr "  Just like anyone else, some people get on my nerves and some people I just really hate."

#. Occurrence 5A_2:1217:4471: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0006; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1217
msgctxt "text_id=4471 | speaker=aoko"
msgid "　ただ、ちょっとヘンなのが敵になる奴の条件でね」"
msgstr "  But the funny thing is, my enemies are never people on my shit list.\""

#. Occurrence 5A_2:1237:4472: scene=5A_2
#: 5A_2:1237
msgctxt "text_id=4472 | speaker=unknown"
msgid "　凍った<双眸|そうぼう>に火のような感情がともる。"
msgstr "  Cold emotion burned in her eyes."

#. Occurrence 5A_2:1242:4473: scene=5A_2
#: 5A_2:1242
msgctxt "text_id=4473 | speaker=unknown"
msgid "　彼女の足はさらに一歩前へ。"
msgstr "  Her feet had already moved one step closer to Soujyuro."

#. Occurrence 5A_2:1270:4474: scene=5A_2
#: 5A_2:1270
msgctxt "text_id=4474 | speaker=unknown"
msgid "　草十郎はますます嫌な予感……殺気、というのだろうか？……を覚えてあとじさりする。"
msgstr "  Soujyuro's sense of foreboding was growing stronger. Wondering if what he sensed was bloodlust, he retreated another step."

#. Occurrence 5A_2:1276:4475: scene=5A_2
#: 5A_2:1276
msgctxt "text_id=4475 | speaker=unknown"
msgid "　ふたりの距離は、なんだかんだときっかり五メートルをキープしている。"
msgstr "  Continuing as so, they maintained a distance of just fifteen feet."

#. Occurrence 5A_2:1298:4476: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0007; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1298
msgctxt "text_id=4476 | speaker=aoko"
msgid "「昔から、私は嫌いな相手でも敵と思った事はなかったの。"
msgstr "\"As far as I can recall, I've never thought of someone I didn't like as an enemy."

#. Occurrence 5A_2:1304:4477: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0008; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1304
msgctxt "text_id=4477 | speaker=aoko"
msgid "　でも逆に、好きな相手を敵だと思う事もあった。"
msgstr "  As it happens, I've even had enemies that I liked."

#. Occurrence 5A_2:1340:4478: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0009; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1340
msgctxt "text_id=4478 | speaker=aoko"
msgid "　理由は単純―――」"
msgstr "  And the reason is simple...\""

#. Occurrence 5A_2:1403:4479: scene=5A_2
#: 5A_2:1403
msgctxt "text_id=4479 | speaker=unknown"
msgid "　そして、彼女は右腕を目前に<掲|かか>げた。"
msgstr "  She held her right arm out."

#. Occurrence 5A_2:1408:4480: scene=5A_2
#: 5A_2:1408
msgctxt "text_id=4480 | speaker=unknown"
msgid "　洋服ごしに光って見えるのは目の錯覚ではなく―――"
msgstr "  The light about her was no illusion."

#. Occurrence 5A_2:1489:4481: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0010; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1489
msgctxt "text_id=4481 | speaker=aoko"
msgid "「―――当たり前のことだけど。"
msgstr "\"It's simple, really."

#. Occurrence 5A_2:1495:4482: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0011; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1495
msgctxt "text_id=4482 | speaker=aoko"
msgid "　私は、私の感情を乱す奴が敵なのよ」"
msgstr "  Anyone who throws me out of whack is my enemy.\""

#. Occurrence 5A_2:1503:4483: scene=5A_2
#: 5A_2:1503
msgctxt "text_id=4483 | speaker=unknown"
msgid "　掲げられた右腕が振るわれる。"
msgstr "  Her arm moved again."

#. Occurrence 5A_2:1528:4484: scene=5A_2
#: 5A_2:1528
msgctxt "text_id=4484 | speaker=unknown"
msgid "　瞬間、"
msgstr "  It was instantaneous."

#. Occurrence 5A_2:1623:4485: scene=5A_2
#: 5A_2:1623
msgctxt "text_id=4485 | speaker=unknown"
msgid "　何か、視認しづらい物騒なモノが、草十郎から二十センチばかり左にズレて放たれた。"
msgstr "  Something shot past Soujyuro in the blink of an eye, missing him by just a foot to his left."

#. Occurrence 5A_2:1653:4486: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0008; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:1653
msgctxt "text_id=4486 | speaker=soujuurou"
msgid "「ちょっ……」"
msgstr "\"Wai―\""

#. Occurrence 5A_2:1659:4487: scene=5A_2
#: 5A_2:1659
msgctxt "text_id=4487 | speaker=unknown"
msgid "　青い光とも、火の玉ともとれる発火現象を目の当たりにして、草十郎はようやく現状を把握した。"
msgstr "  Before his eyes, a blue light, something akin to a fireball, had ignited from nothing. He finally understood what was happening."

#. Occurrence 5A_2:1689:4488: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0009; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:1689
msgctxt "text_id=4488 | speaker=soujuurou"
msgid "「ちょっと待った、今のはたいへん見覚えがある！」"
msgstr "\"Wait a second, I've seen one of those before!\""

#. Occurrence 5A_2:1694:4489: scene=5A_2
#: 5A_2:1694
msgctxt "text_id=4489 | speaker=unknown"
msgid "　そんな間の抜けた感想は聞き流し、"
msgstr "  She ignored his dimwitted reaction."

#. Occurrence 5A_2:1736:4490: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0012; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1736
msgctxt "text_id=4490 | speaker=aoko"
msgid "「ち、外したか」"
msgstr "\"Damn it. I missed.\""

#. Occurrence 5A_2:1741:4491: scene=5A_2
#: 5A_2:1741
msgctxt "text_id=4491 | speaker=unknown"
msgid "　なんてコトを、青子は呟いた。"
msgstr "  Aoko muttered to herself."

#. Occurrence 5A_2:1761:4492: scene=5A_2
#: 5A_2:1761
msgctxt "text_id=4492 | speaker=unknown"
msgid "　青い光はミラーハウスの壁にこぶし大の穴をあけたばかりか、未だにゴウゴウと<燻|くすぶ>っていた。"
msgstr "  The fist-sized hole the blue light had made in the house of mirrors crackled and smoldered."

#. Occurrence 5A_2:1766:4493: scene=5A_2
#: 5A_2:1766
msgctxt "text_id=4493 | speaker=unknown"
msgid "　あれなら人間ひとりの<頭蓋|あたま>を<陥没|かんぼつ>させる事も、まるっと<黒|くろ><焦|こ>げにする事も可能だろう。"
msgstr "  A shot like that could easily cave in a human skull in addition to burning it to a crisp."

#. Occurrence 5A_2:1794:4494: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0013; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1794
msgctxt "text_id=4494 | speaker=aoko"
msgid "「……はあ。こんな射程で外すなんて、有珠に見られたら自殺ものね。"
msgstr "\"...Hah. I'd have to kill myself if Alice saw me miss at this range."

#. Occurrence 5A_2:1807:4495: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0014; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:1807
msgctxt "text_id=4495 | speaker=aoko"
msgid "　でもこれで分かったでしょ？　二度目だものね、貴方にとっては」"
msgstr "  But you get it now, right? This is it for you. There won't be a second chance.\""

#. Occurrence 5A_2:1829:4496: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0010; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:1829
msgctxt "text_id=4496 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5A_2:1849:4497: scene=5A_2
#: 5A_2:1849
msgctxt "text_id=4497 | speaker=unknown"
msgid "　急速に腰が引ける草十郎。"
msgstr "  Soujyuro backed away swiftly."

#. Occurrence 5A_2:1854:4498: scene=5A_2
#: 5A_2:1854
msgctxt "text_id=4498 | speaker=unknown"
msgid "　理解不能を通り越して思考停止まで一歩手前。"
msgstr "  Things were beyond incomprehensible. He was close to losing the ability to think at all."

#. Occurrence 5A_2:1873:4499: scene=5A_2
#: 5A_2:1873
msgctxt "text_id=4499 | speaker=unknown"
msgid "　瞳に<映|うつ>るのは頼れる生徒会長……だったもの……の姿と、二日前に目撃した夜の公園のフラッシュバックだけだ。"
msgstr "  All he could make out was the figure of the dependable student council president―or at least what he had thought was the president―and the memories of the park that night two days ago."

#. Occurrence 5A_2:1908:4500: scene=5A_2
#: 5A_2:1908
msgctxt "text_id=4500 | speaker=unknown"
msgid "　彼には経験がなく、また、法治国家に住むほとんどの人々には経験がない事だが。"
msgstr "  He had never experienced anything like this, though most people living in a civilized country would have never seen anything like it either."

#. Occurrence 5A_2:1913:4501: scene=5A_2
#: 5A_2:1913
msgctxt "text_id=4501 | speaker=unknown"
msgid "　指を引くだけで人間を殺せる凶器を向けられた時、知性は善悪はおろか夢と現実、過去と未来の判断を停止させる。"
msgstr "  A lethal weapon that could kill with nothing more than the pull of a finger had a way of suspending the ability of its target to determine between not just good and evil, but dreams and reality, past and future."

#. Occurrence 5A_2:1918:4502: scene=5A_2
#: 5A_2:1918
msgctxt "text_id=4502 | speaker=unknown"
msgid "　それまでの生活が平穏であった分だけ、その停止はより強いものになるだろう。"
msgstr "  And the more peaceful someone's life had been, the stronger that suspension was likely to be."

#. Occurrence 5A_2:1952:4503: scene=5A_2
#: 5A_2:1952
msgctxt "text_id=4503 | speaker=unknown"
msgid "　思考にあるのは「生きている今の自分」の姿だけ。"
msgstr "  All that one could think about was the fact that they were alive at that very moment."

#. Occurrence 5A_2:1957:4504: scene=5A_2
#: 5A_2:1957
msgctxt "text_id=4504 | speaker=unknown"
msgid "　白紙の上にぽつんと置かれた黒い点と変わらない。"
msgstr "  It was as if he was an unwritten character on a blank piece of white paper."

#. Occurrence 5A_2:1962:4505: scene=5A_2
#: 5A_2:1962
msgctxt "text_id=4505 | speaker=unknown"
msgid "　後も先もない、ただそれだけの状態。"
msgstr "  There was no before, there was no after, there was only what came next."

#. Occurrence 5A_2:1968:4506: scene=5A_2
#: 5A_2:1968
msgctxt "text_id=4506 | speaker=unknown"
msgid "　それが銃口を向けられた人間の、ごく平均的な思考である。"
msgstr "  This was a very common thought process for anyone staring down the barrel of a gun."

#. Occurrence 5A_2:2020:4507: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0015; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:2020
msgctxt "text_id=4507 | speaker=aoko"
msgid "「あ、<命乞|いのちご>いは止めてね。意味ないから。"
msgstr "\"Oh, don't bother begging. It's pointless."

#. Occurrence 5A_2:2026:4508: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0016; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:2026
msgctxt "text_id=4508 | speaker=aoko"
msgid "　でも恨み言ならご自由に。殺す側の義務として、一言一句聞いてあげる」"
msgstr "  But feel free to air your grievances. It's a killer's duty to listen to her victim's last words.\""

#. Occurrence 5A_2:2032:4509: scene=5A_2
#: 5A_2:2032
msgctxt "text_id=4509 | speaker=unknown"
msgid "　意味がない、とは、一切聞かない、というコトらしい。"
msgstr "  By saying it was pointless, she made it sound more like she would not listen to what he had to say."

#. Occurrence 5A_2:2037:4510: scene=5A_2
#: 5A_2:2037
msgctxt "text_id=4510 | speaker=unknown"
msgid "　もっとも、草十郎はショック状態で声をあげる行為そのものが思いつかない。"
msgstr "  However, Soujyuro was in such a state of shock that it did not even enter his mind to speak up."

#. Occurrence 5A_2:2085:4511: scene=5A_2
#: 5A_2:2085
msgctxt "text_id=4511 | speaker=unknown"
msgid "　確かな事は―――そう、理由はともかく、目の前の少女が自分を殺したがっている現実だけ。"
msgstr "  All he knew, for reasons unknown, was that the girl in front of him wanted him dead."

#. Occurrence 5A_2:2106:4512: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0011; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2106
msgctxt "text_id=4512 | speaker=soujuurou"
msgid "『う、嘘つきにもほどがある……！"
msgstr "(Y-You could have told me, Tobimaru!"

#. Occurrence 5A_2:2112:4513: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0012; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2112
msgctxt "text_id=4513 | speaker=soujuurou"
msgid "　鳶丸のバカ、何が“そんな生き物はいない”だ！"
msgstr "  You said that no such thing exists!"

#. Occurrence 5A_2:2112:4514: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0012; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2112
msgctxt "text_id=4514 | speaker=soujuurou"
msgid "　実際いるじゃないか、こんなお化けみたいなのが……！』"
msgstr "  Well, how about now, idiot? There's a monster right in front of me!)"

#. Occurrence 5A_2:2146:4515: scene=5A_2
#: 5A_2:2146
msgctxt "text_id=4515 | speaker=unknown"
msgid "　もし口に出していたら間髪入れず第二撃が飛んできたであろう感想を、草十郎はすんでのところで心にとどめた。"
msgstr "  Soujyuro felt that if he had said that aloud, the second blast would come even quicker than the last, so he kept it to himself."

#. Occurrence 5A_2:2151:4516: scene=5A_2
#: 5A_2:2151
msgctxt "text_id=4516 | speaker=unknown"
msgid "　友人への悪態で<麻痺|ショック>状態から<恐慌|パニック>状態に持ち直す。"
msgstr "  His mental expletives stirred his mind from paralysis to mere panic."

#. Occurrence 5A_2:2198:4517: scene=5A_2
#: 5A_2:2198
msgctxt "text_id=4517 | speaker=unknown"
msgid "　しかし、それは決して余裕からきたものではない。"
msgstr "  This response came not from confidence, however."

#. Occurrence 5A_2:2204:4518: scene=5A_2
#: 5A_2:2204
msgctxt "text_id=4518 | speaker=unknown"
msgid "“ある日突然、何者かに殺される”"
msgstr "\"Someday, out of the blue, someone is going to kill me.\""

#. Occurrence 5A_2:2210:4519: scene=5A_2
#: 5A_2:2210
msgctxt "text_id=4519 | speaker=unknown"
msgid "　その、あまりにも<経緯|りゆう>のない非日常は、"
msgstr "  While it may have seemed like a baseless belief to hold-"

#. Occurrence 5A_2:2231:4520: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0013; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2231
msgctxt "text_id=4520 | speaker=soujuurou"
msgid "『でも、そうだった……都会には<殺|・><人|・><事|・><件|・>がある。"
msgstr "(Oh, but now that I think about it, murders happen all the time in cities."

#. Occurrence 5A_2:2237:4521: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0014; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2237
msgctxt "text_id=4521 | speaker=soujuurou"
msgid "　ルールを破れば殺されるのは当たり前だって、ちゃんと教えてもらってた……！』"
msgstr "  I should have remembered: if you break the rules, you get killed! I knew that already!)"

#. Occurrence 5A_2:2243:4522: scene=5A_2
#: 5A_2:2243
msgctxt "text_id=4522 | speaker=unknown"
msgid "　都会に慣れていない草十郎にとって、極めて現実的なものだったからだ。"
msgstr "  To Soujyuro, the situation seemed to perfectly align with his inexperienced understanding that the city was a coldly pragmatic place."

#. Occurrence 5A_2:2263:4523: scene=5A_2
#: 5A_2:2263
msgctxt "text_id=4523 | speaker=unknown"
msgid "　彼にとって同級生に殺される現実は、そう驚くべき事ではないらしい。"
msgstr "  As far as he was concerned at this moment, being killed by a classmate was not something to be so surprised by."

#. Occurrence 5A_2:2268:4524: scene=5A_2
#: 5A_2:2268
msgctxt "text_id=4524 | speaker=unknown"
msgid "　人が人を殺す<事件|ケース>が起こりえる社会ならば、そういうコトもあるだろうと受け止められる。彼は青子の行為、凶行にいたる経緯に、なんら疑問を持っていない。"
msgstr "  In a society where murder was possible, he was able to accept this sort of situation as natural. Of virtually no concern was the series of events that led to Aoko's aggression toward him, "

#. Occurrence 5A_2:2314:4525: scene=5A_2
#: 5A_2:2314
msgctxt "text_id=4525 | speaker=unknown"
msgid "　なので、いま彼を混乱させているものは、青子が起こしている発火現象だけなのだった。"
msgstr "  The only thing that truly confused him was Aoko's blue fireball."

#. Occurrence 5A_2:2347:4526: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0015; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2347
msgctxt "text_id=4526 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5A_2:2364:4527: scene=5A_2
#: 5A_2:2364
msgctxt "text_id=4527 | speaker=unknown"
msgid "　草十郎の喉がごくりと唾を飲みこむ。"
msgstr "  Soujyuro swallowed with an audible gulp."

#. Occurrence 5A_2:2369:4528: scene=5A_2
#: 5A_2:2369
msgctxt "text_id=4528 | speaker=unknown"
msgid "　その反応は、誰の目にも恐怖で<痺|しび>れている犠牲者に見える。"
msgstr "  To anyone who may have been watching, it was the response of a victim paralyzed by fear."

#. Occurrence 5A_2:2403:4529: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0017; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:2403
msgctxt "text_id=4529 | speaker=aoko"
msgid "「そういう事よ。ようやく理解してくれたわね。"
msgstr "\"That's right. So you do finally get it."

#. Occurrence 5A_2:2409:4530: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0018; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:2409
msgctxt "text_id=4530 | speaker=aoko"
msgid "　多くは語らないけど、貴方にはここで死んでもらう。"
msgstr "  I'm all out of words, so I think it's time you died."

#. Occurrence 5A_2:2427:4531: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0019; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:2427
msgctxt "text_id=4531 | speaker=aoko"
msgid "　魔術は<隠匿|いんとく>するもの―――なんて言ってもそっちには関係のない事だし。単に運がなかったって思えばいいわ。大事なのは、私が、貴方を殺したってコトだけだから」"
msgstr "  I could go on about how magecraft has to stay hidden, but that doesn't really have anything to do with you. All you need to know is that you were in the wrong place at the wrong time. And that it was me who killed you.\""

#. Occurrence 5A_2:2482:4532: scene=5A_2
#: 5A_2:2482
msgctxt "text_id=4532 | speaker=unknown"
msgid "　さて、とばかりに青子は再度、右手を<掲|かか>げた。"
msgstr "  Done talking, Aoko once again lifted her right arm."

#. Occurrence 5A_2:2487:4533: scene=5A_2
#: 5A_2:2487
msgctxt "text_id=4533 | speaker=unknown"
msgid "　機械を思わせる駆動音。"
msgstr "  There was a hum like a machine."

#. Occurrence 5A_2:2492:4534: scene=5A_2
#: 5A_2:2492
msgctxt "text_id=4534 | speaker=unknown"
msgid "　<袖|ふく>の下で青い光が回転している。"
msgstr "  Blue light began to revolve about her arm beneath her sleeve."

#. Occurrence 5A_2:2497:4535: scene=5A_2
#: 5A_2:2497
msgctxt "text_id=4535 | speaker=unknown"
msgid "　それがさっきより長い―――つまり、きっと、いま背後の壁を燃やしているものよりずっと強い―――ことに気づいて、草十郎の混乱は加速していく。"
msgstr "  This was taking longer than last time, leading Soujyuro to believe that it was going to be much stronger than the attack that was still scorching the wall behind him. The realization caused his panic to heighten."

#. Occurrence 5A_2:2570:4536: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0016; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2570
msgctxt "text_id=4536 | speaker=soujuurou"
msgid "“いや、なんだ、つまり、始末するとかしないとか、あの夜のお化けは蒼崎だったとか、都会はホントに込み入ってるとか、そういうコトじゃなくて―――”"
msgstr "(No, wait, it's not about me having to die, or the fact that the monster that night was actually Aozaki, or even whether she's a part of the church... It's not about any of that.)"

#. Occurrence 5A_2:2576:4537: scene=5A_2
#: 5A_2:2576
msgctxt "text_id=4537 | speaker=unknown"
msgid "　混線する思考。"
msgstr "  His thoughts became jumbled."

#. Occurrence 5A_2:2581:4538: scene=5A_2
#: 5A_2:2581
msgctxt "text_id=4538 | speaker=unknown"
msgid "　早鐘を打つ心臓。"
msgstr "  His heart pounded like a hammer."

#. Occurrence 5A_2:2601:4539: scene=5A_2
#: 5A_2:2601
msgctxt "text_id=4539 | speaker=unknown"
msgid "　―――もう立ち尽くしている場合じゃない。"
msgstr "  ...This was no time to be standing still."

#. Occurrence 5A_2:2636:4540: scene=5A_2
#: 5A_2:2636
msgctxt "text_id=4540 | speaker=unknown"
msgid "　目の前の少女が同じ人間であるかさえ怪しいが"
msgstr "  He was not sure if the girl in front of him was really human."

#. Occurrence 5A_2:2661:4541: scene=5A_2
#: 5A_2:2661
msgctxt "text_id=4541 | speaker=unknown"
msgid "　それはともかく、やっぱり、たとえ納得がいくといってもきちんと考えてみたら、"
msgstr "  And more importantly, even if he could accept the events unfolding before him, when all was said and done..."

#. Occurrence 5A_2:2683:4542: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0017; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2683
msgctxt "text_id=4542 | speaker=soujuurou"
msgid "「まて、人殺しはいけないんだぞっ……！」"
msgstr "\"Wait! It's wrong to kill people!\""

#. Occurrence 5A_2:2689:4543: scene=5A_2
#: 5A_2:2689
msgctxt "text_id=4543 | speaker=unknown"
msgid "　この通り、いくら都会のルールだからって殺されるのはご<免|めん>こうむる……！"
msgstr "  Even if it was a fact of life in the city, Soujyuro was not about to lie down and die!"

#. Occurrence 5A_2:2779:4544: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0020; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:2779
msgctxt "text_id=4544 | speaker=aoko"
msgid "「分かってるわよ、そんな事はっ！」"
msgstr "\"Don't you think I know that?!\""

#. Occurrence 5A_2:2805:4545: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0018; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:2805
msgctxt "text_id=4545 | speaker=soujuurou"
msgid "「ちょっ、待―――！」"
msgstr "\"H-hey―waaaait!\""

#. Occurrence 5A_2:2811:4546: scene=5A_2
#: 5A_2:2811
msgctxt "text_id=4546 | speaker=unknown"
msgid "　あまりにも空気を読まない草十郎の意見は、的確に青子の<逆鱗|げきりん>に触れまくった。"
msgstr "  Soujyuro's scream, still entirely oblivious, was just the thing to invoke Aoko's full wrath."

#. Occurrence 5A_2:3052:4547: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0019; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3052
msgctxt "text_id=4547 | speaker=soujuurou"
msgid "「うわああああ――――――！！！？」"
msgstr "\"AaaAAAaaah!?\""

#. Occurrence 5A_2:3058:4548: scene=5A_2
#: 5A_2:3058
msgctxt "text_id=4548 | speaker=unknown"
msgid "　連続で<撃|う>ち出される青い<魔弾|まだん>と、"
msgstr "  Aoko fired a barrage of magical blue bullets."

#. Occurrence 5A_2:3063:4549: scene=5A_2
#: 5A_2:3063
msgctxt "text_id=4549 | speaker=unknown"
msgid "　とっさに背後の闇―――ミラーハウスの入り口に駆けこむ草十郎。"
msgstr "  In an instant, Soujyuro dashed into the shadows behind him, into the entrance to the house of mirrors."

#. Occurrence 5A_2:3242:4550: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0020; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3242
msgctxt "text_id=4550 | speaker=soujuurou"
msgid "「はっ―――なななんだ、今のなんだ―――！？」"
msgstr "\"W-w-what the heck was that!?\""

#. Occurrence 5A_2:3249:4551: scene=5A_2
#: 5A_2:3249
msgctxt "text_id=4551 | speaker=unknown"
msgid "　無我夢中で長い通路を走る。"
msgstr "  He darted feverishly down the hall."

#. Occurrence 5A_2:3254:4552: scene=5A_2
#: 5A_2:3254
msgctxt "text_id=4552 | speaker=unknown"
msgid "　たった二メートルの全力疾走で息が上がっているのは初撃を上回る“見たこともない出来事”への驚きと、本気で、あと一秒でも飛びのくのが遅かったら死んでいた、という実感のせいだ。"
msgstr "  After a mere few feet, he was left completely out of breath. This was due to his shock at seeing yet another attack, fiercer than the first, that he'd never seen in his life, and because he couldn't shake the thought that if he had moved even a second later, he would be dead."

#. Occurrence 5A_2:3330:4553: scene=5A_2
#: 5A_2:3330
msgctxt "text_id=4553 | speaker=unknown"
msgid "　足を止める余裕はない。"
msgstr "  He could not afford to stop."

#. Occurrence 5A_2:3339:4554: scene=5A_2
#: 5A_2:3339
msgctxt "text_id=4554 | speaker=unknown"
msgid "　草十郎の後ろには容赦のない足音が迫っている。"
msgstr "  The sound of merciless footsteps closed in behind him."

#. Occurrence 5A_2:3360:4555: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0021; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3360
msgctxt "text_id=4555 | speaker=soujuurou"
msgid "「……けど助かった。ここならなんとか―――」"
msgstr "\"I've bought myself some time. Maybe here I'll be able to figure out something...\""

#. Occurrence 5A_2:3382:4556: scene=5A_2
#: 5A_2:3382
msgctxt "text_id=4556 | speaker=unknown"
msgid "　なるかもしれない、と全力で走る。"
msgstr "  He threw everything into his legs as he sprinted."

#. Occurrence 5A_2:3388:4557: scene=5A_2
#: 5A_2:3388
msgctxt "text_id=4557 | speaker=unknown"
msgid "　ミラーハウスは入り口からエントランスにあたるロビーまで、細長い通路が二十メートルほど続いている。"
msgstr "  A straight, narrow passage about sixty feet long connected the entrance to the main lobby."

#. Occurrence 5A_2:3395:4558: scene=5A_2
#: 5A_2:3395
msgctxt "text_id=4558 | speaker=unknown"
msgid "　このままロビーまで逃げこめば、あとはいくらでも隠れ場所はありそうだ。"
msgstr "  At this rate, if he could just make it to the lobby, he was sure he would be able to find as many hiding spots as he needed."

#. Occurrence 5A_2:3453:4559: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0022; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3453
msgctxt "text_id=4559 | speaker=soujuurou"
msgid "『助かった……！』"
msgstr "(Thank god!)"

#. Occurrence 5A_2:3459:4560: scene=5A_2
#: 5A_2:3459
msgctxt "text_id=4560 | speaker=unknown"
msgid "　大きな空間にたどり着く。"
msgstr "  He arrived in a large, open space."

#. Occurrence 5A_2:3464:4561: scene=5A_2
#: 5A_2:3464
msgctxt "text_id=4561 | speaker=unknown"
msgid "　ここが一階ロビー。通路は三つ。"
msgstr "  This was the first-floor lobby. There were three passageways."

#. Occurrence 5A_2:3469:4562: scene=5A_2
#: 5A_2:3469
msgctxt "text_id=4562 | speaker=unknown"
msgid "　地下に下りる階段と、"
msgstr "  One led to the basement floor."

#. Occurrence 5A_2:3469:4563: scene=5A_2
#: 5A_2:3469
msgctxt "text_id=4563 | speaker=unknown"
msgid "　一階迷路への入り口通路と、"
msgstr "  One connected to the first-floor maze."

#. Occurrence 5A_2:3469:4564: scene=5A_2
#: 5A_2:3469
msgctxt "text_id=4564 | speaker=unknown"
msgid "　二階に上る階段。"
msgstr "  The other was a set of stairs leading to the second floor."

#. Occurrence 5A_2:3489:4565: scene=5A_2
#: 5A_2:3489
msgctxt "text_id=4565 | speaker=unknown"
msgid "　今はどれでもいい、と草十郎は直感的に一階の迷路へ逃げこもうと踏みこんで、"
msgstr "  Soujyuro did not particularly care which one he chose, so, trusting his intuition, he made a run for the first-floor maze, when..."

#. Occurrence 5A_2:3556:4566: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0023; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3556
msgctxt "text_id=4566 | speaker=soujuurou"
msgid "「痛……！？」"
msgstr "\"Ouch!\""

#. Occurrence 5A_2:3562:4567: scene=5A_2
#: 5A_2:3562
msgctxt "text_id=4567 | speaker=unknown"
msgid "　がいーん、と透明の壁に頭からぶつかった。"
msgstr "  He smacked his head into a transparent wall."

#. Occurrence 5A_2:3589:4568: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0024; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3589
msgctxt "text_id=4568 | speaker=soujuurou"
msgid "「か、鏡……!?」"
msgstr "\"A...mirror!?\""

#. Occurrence 5A_2:3595:4569: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0021; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3595
msgctxt "text_id=4569 | speaker=aoko"
msgid "「ええ。面倒だけど、それならフェアでしょ？"
msgstr "\"That's right. It's annoying, but I guess this makes things fair."

#. Occurrence 5A_2:3601:4570: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0022; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3601
msgctxt "text_id=4570 | speaker=aoko"
msgid "　追いかける方にも逃げる方にも有利不利がある」"
msgstr "  The chaser and the chased are on equal ground.\""

#. Occurrence 5A_2:3630:4571: scene=5A_2
#: 5A_2:3630
msgctxt "text_id=4571 | speaker=unknown"
msgid "　どことなく楽しげな声が届く。"
msgstr "  A somehow cheerful voice echoed in his direction."

#. Occurrence 5A_2:3635:4572: scene=5A_2
#: 5A_2:3635
msgctxt "text_id=4572 | speaker=unknown"
msgid "　いちいち振り向くまでもない。"
msgstr "  There was no need for Soujyuro to even turn around."

#. Occurrence 5A_2:3640:4573: scene=5A_2
#: 5A_2:3640
msgctxt "text_id=4573 | speaker=unknown"
msgid "　いま彼を<弾|はじ>いた鏡に、ゆっくりと歩いてくる蒼崎青子の姿が映っている。"
msgstr "  In the very same mirror he had crashed into he could see Aoko Aozaki's figure slowly approaching."

#. Occurrence 5A_2:3661:4574: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0023; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3661
msgctxt "text_id=4574 | speaker=aoko"
msgid "「それと、一階の奥にある出口は封鎖しといたから。結界じゃなくて物理的に。"
msgstr "\"You should know, I sealed off the first floor exit deeper inside. Physically, not with a Bounded Field."

#. Occurrence 5A_2:3667:4575: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0024; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3667
msgctxt "text_id=4575 | speaker=aoko"
msgid "　やりすぎて封鎖っていうより瓦礫？　土砂崩れ？　どっちでもいっか。とにかく下手に出口に近づくと崩落に巻き込まれるから。生き埋めがイヤなら近寄らないことね」"
msgstr "  Is calling it a seal going too far? Maybe plugged or buried works. Either way, if you get too close, you'll be swallowed by a cave-in. I recommend keeping your distance if you don't want to be buried alive.\""

#. Occurrence 5A_2:3711:4576: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0025; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3711
msgctxt "text_id=4576 | speaker=soujuurou"
msgid "「―――、―――！」"
msgstr "\"-, -!\""

#. Occurrence 5A_2:3717:4577: scene=5A_2
#: 5A_2:3717
msgctxt "text_id=4577 | speaker=unknown"
msgid "　近づいてくる足音に焦りながら、草十郎は手探りで壁に向かう。"
msgstr "  Panicked by the impending footsteps, Soujyuro groped for the wall."

#. Occurrence 5A_2:3722:4578: scene=5A_2
#: 5A_2:3722
msgctxt "text_id=4578 | speaker=unknown"
msgid "　見えているのは二階への階段だ。"
msgstr "  He could see the stairs to the second floor."

#. Occurrence 5A_2:3727:4579: scene=5A_2
#: 5A_2:3727
msgctxt "text_id=4579 | speaker=unknown"
msgid "　青子の言っている<内|コ><容|ト>はさっぱりだが、一階はまずい、という事だけは確かだった。"
msgstr "  He did not understand what Aoko had meant earlier, but he at least knew that the first floor was not going to save him."

#. Occurrence 5A_2:3768:4580: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0025; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3768
msgctxt "text_id=4580 | speaker=aoko"
msgid "「ま、私としてはそっちのが助かるけど。"
msgstr "\"It would save me a lot of trouble if you just died that way, though."

#. Occurrence 5A_2:3774:4581: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0026; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3774
msgctxt "text_id=4581 | speaker=aoko"
msgid "　形式上、事故死の方が後始末とか楽だから」"
msgstr "  The cleanup is much easier for accidental deaths.\""

#. Occurrence 5A_2:3786:4582: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0026; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3786
msgctxt "text_id=4582 | speaker=soujuurou"
msgid "「……！」"
msgstr "\"...!\""

#. Occurrence 5A_2:3792:4583: scene=5A_2
#: 5A_2:3792
msgctxt "text_id=4583 | speaker=unknown"
msgid "　背後には正体不明の生物。"
msgstr "  Behind him was a creature beyond words."

#. Occurrence 5A_2:3797:4584: scene=5A_2
#: 5A_2:3797
msgctxt "text_id=4584 | speaker=unknown"
msgid "　彼女は軽口と共に、これみよがしに右腕を持ち上げる。"
msgstr "  As she continued her idle taunting, she lifted her right arm ostentatiously."

#. Occurrence 5A_2:3855:4585: scene=5A_2
#: 5A_2:3855
msgctxt "text_id=4585 | speaker=unknown"
msgid "　……それは服の上からでも分かる、少女の体には不釣り合いな、一種奇怪な<紋様|もんよう>だった。"
msgstr "  Even from above her clothes one could see some kind of strange, incongruous pattern upon her body."

#. Occurrence 5A_2:3860:4586: scene=5A_2
#: 5A_2:3860
msgctxt "text_id=4586 | speaker=unknown"
msgid "　皮膚の下の血管。"
msgstr "  The veins beneath her skin..."

#. Occurrence 5A_2:3865:4587: scene=5A_2
#: 5A_2:3865
msgctxt "text_id=4587 | speaker=unknown"
msgid "　身体を巡る機能の一つが、人間以外のモノで回っているような。"
msgstr "  They made it seem as though something inhuman was circulating her body."

#. Occurrence 5A_2:3923:4588: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0027; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:3923
msgctxt "text_id=4588 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5A_2:3928:4589: scene=5A_2
#: 5A_2:3928
msgctxt "text_id=4589 | speaker=unknown"
msgid "　それを傷ましいとも、おぞましいとも感じたのか。"
msgstr "  Whether out of pity or repulsion,"

#. Occurrence 5A_2:3933:4590: scene=5A_2
#: 5A_2:3933
msgctxt "text_id=4590 | speaker=unknown"
msgid "　一瞬だけ足を止める草十郎と、"
msgstr "  Soujyuro stopped for just a moment."

#. Occurrence 5A_2:3933:4591: scene=5A_2
#: 5A_2:3933
msgctxt "text_id=4591 | speaker=unknown"
msgid "　その視線を受け流す追跡者。"
msgstr "  His pursuer evaded his gaze."

#. Occurrence 5A_2:3975:4592: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0027; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3975
msgctxt "text_id=4592 | speaker=aoko"
msgid "「ああ、これ？　普段は塗り薬で隠しているんだけど、今日は特別。"
msgstr "\"You've noticed, then. I normally hide it with ointment, but today is special."

#. Occurrence 5A_2:3986:4593: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0028; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3986
msgctxt "text_id=4593 | speaker=aoko"
msgid "　魔術刻印って言ってね、魔術師の証みたいな物よ。"
msgstr "  It's called a Magical Crest. It's proof that I'm a mage."

#. Occurrence 5A_2:3992:4594: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0029; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:3992
msgctxt "text_id=4594 | speaker=aoko"
msgid "　ほら、光が回ってるでしょ？　これがさっきのスナップ……分かりやすくいうと弾丸のもと。"
msgstr "  You see this light revolving around me, right? It's the beginning of what formed that Snap―those bullets."

#. Occurrence 5A_2:4003:4595: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0030; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:4003
msgctxt "text_id=4595 | speaker=aoko"
msgid "　今日は調子いいし、私、魔力を効率よく使うのだけは自信あるし―――うん、あと三十回ぐらいかな？　さっきみたいな掃射ができるのは」"
msgstr "  I'm feeling pretty good today, and I've never felt more confident in how to use my magical energy efficiently. I think I'm good for another thirty bullets or so.\""

#. Occurrence 5A_2:4023:4596: scene=5A_2
#: 5A_2:4023
msgctxt "text_id=4596 | speaker=unknown"
msgid "　感情がハイになっているのか、彼女はやけにフレンドリーな口調だった。"
msgstr "  Perhaps she was on an emotional high, for her voice had become frightfully friendly."

#. Occurrence 5A_2:4049:4597: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0028; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:4049
msgctxt "text_id=4597 | speaker=soujuurou"
msgid "「…………」"
msgstr "\"...\""

#. Occurrence 5A_2:4054:4598: scene=5A_2
#: 5A_2:4054
msgctxt "text_id=4598 | speaker=unknown"
msgid "　もっとも、会話の内容は物騒なコトこの上ないのだが。"
msgstr "  The substance of the conversation could not have been any more unsettling, however."

#. Occurrence 5A_2:4081:4599: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0029; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:4081
msgctxt "text_id=4599 | speaker=soujuurou"
msgid "「……そもそも、何を言っているかよく分からないんだけど、蒼崎」"
msgstr "\"...I don't understand a thing you're saying, Aozaki.\""

#. Occurrence 5A_2:4087:4600: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0031; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:4087
msgctxt "text_id=4600 | speaker=aoko"
msgid "「分からない？　弾数はあと三十発って事。"
msgstr "\"You don't? I'm telling you that I have thirty more shots in the tank."

#. Occurrence 5A_2:4093:4601: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0032; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:4093
msgctxt "text_id=4601 | speaker=aoko"
msgid "　そこまで逃げ切ればあなたの勝ちよ。とりあえず、今日のところはね」"
msgstr "  If you can escape before I use them up, it's your win. For today, that is.\""

#. Occurrence 5A_2:4126:4602: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_2_0030; voice_prefix=A30; voice_category=3; scene=5A_2
#: 5A_2:4126
msgctxt "text_id=4602 | speaker=soujuurou"
msgid "『……今日はって、明日もあるのかな……』"
msgstr "(...For today? You mean I have to do this tomorrow, too?)"

#. Occurrence 5A_2:4132:4603: scene=5A_2
#: 5A_2:4132
msgctxt "text_id=4603 | speaker=unknown"
msgid "　眉をひそめて悩む草十郎。"
msgstr "  Soujyuro knit his brows."

#. Occurrence 5A_2:4221:4604: scene=5A_2
#: 5A_2:4221
msgctxt "text_id=4604 | speaker=unknown"
msgid "　恐慌しながらも、やはり根っこのところで危機感のない態度に、青子も<微|かす>かに眉を寄せる。"
msgstr "  Aoko's expression creased into a scowl at his behavior. Although he was panicking, it seemed that deep down he still did not feel the full weight of the crisis."

#. Occurrence 5A_2:4226:4605: scene=5A_2
#: 5A_2:4226
msgctxt "text_id=4605 | speaker=unknown"
msgid "　やっぱりこいつは理解できない、と。"
msgstr "  She knew he still didn't get it."

#. Occurrence 5A_2:4254:4606: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0033; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:4254
msgctxt "text_id=4606 | speaker=aoko"
msgid "「宣言はしたわ。自由時間はこれでおしまい。"
msgstr "\"I said my piece. Free time is over."

#. Occurrence 5A_2:4260:4607: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0034; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:4260
msgctxt "text_id=4607 | speaker=aoko"
msgid "　まだ<罵|ののし>り足りないだろうけど、ま、その手の時間はキリがないしね。このあたりで<諦|あきら>めて」"
msgstr "  I may still have some trash talk left in me, but, well, there's never enough time to get it all off my chest, anyway. Just give up already.\""

#. Occurrence 5A_2:4287:4608: scene=5A_2
#: 5A_2:4287
msgctxt "text_id=4608 | speaker=unknown"
msgid "　どうも、この<弛緩|しかん>した会話劇は<意|い><図|と>的に用意されたものらしい。"
msgstr "  It appeared Aoko had prepared this theatrical dialogue ahead of time."

#. Occurrence 5A_2:4292:4609: scene=5A_2
#: 5A_2:4292
msgctxt "text_id=4609 | speaker=unknown"
msgid "　届かない命乞いではなく、殺人者を呪う<時間|けんり>。"
msgstr "  Not to allow her opponent time for futile pleading, but to give him the time to curse her, his killer."

#. Occurrence 5A_2:4297:4610: scene=5A_2
#: 5A_2:4297
msgctxt "text_id=4610 | speaker=unknown"
msgid "　……青子流の公正さなのだが、締まらないコトに、今回はうまく機能しなかったようだ。"
msgstr "  Such forthrightness was her modus operandi. With this victim, however, it was not going as she had hoped."

#. Occurrence 5A_2:4366:4611: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0035; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:4366
msgctxt "text_id=4611 | speaker=aoko"
msgid "「とにかくそういう事だから。"
msgstr "\"Anyway, that's all I have to say."

#. Occurrence 5A_2:4377:4612: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_2_0036; voice_prefix=A10; voice_category=1; scene=5A_2
#: 5A_2:4377
msgctxt "text_id=4612 | speaker=aoko"
msgid "　―――じゃ、狩りの時間といきましょうか」"
msgstr "  Shall we begin the hunt?\""

#. Occurrence 5A_2:4383:4613: scene=5A_2
#: 5A_2:4383
msgctxt "text_id=4613 | speaker=unknown"
msgid "　感情を<排|はい>した声と、冷酷に獲物を見据える瞳。"
msgstr "  Her voice was void of emotion, and her eyes ruthless as they bored into her prey."

#. Occurrence 5A_2:4388:4614: scene=5A_2
#: 5A_2:4388
msgctxt "text_id=4614 | speaker=unknown"
msgid "　それで今度こそ本当に、自分が殺されるという現実を、草十郎は実感した。"
msgstr "  This time, Soujyuro finally accepted that he was going to die."

#. Occurrence 5A_3:60:4615: scene=5A_3
#: 5A_3:60
msgctxt "text_id=4615 | speaker=unknown"
msgid "　……長らく入園者のいない夢の<廃墟|あと>に、<彼|ソ><女|レ>は力なく、亡霊のような静けさで足を踏み入れた。"
msgstr "  ...Silent as the dead, it stepped into the remnants of a dream that had long since seen no visitors."

#. Occurrence 5A_3:66:4616: scene=5A_3
#: 5A_3:66
msgctxt "text_id=4616 | speaker=unknown"
msgid "　今夜は無風で、周囲は無人。"
msgstr "  There was no wind this night, nor a soul to be seen."

#. Occurrence 5A_3:75:4617: scene=5A_3
#: 5A_3:75
msgctxt "text_id=4617 | speaker=unknown"
msgid "　それなのに響いてくる雑音に、<彼|ソ><女|レ>はにんまりと、手を合わせて微笑んだ。"
msgstr "  Still, it heard the echoes from within, clasped its hands together, and grinned."

#. Occurrence 5A_3:134:4618: scene=5A_3
#: 5A_3:134
msgctxt "text_id=4618 | speaker=unknown"
msgid "　可愛らしく合わされた<手|カタチ>は、チューリップの蕾のようだ。"
msgstr "  Its form, with hands clasped, resembled that of a budding tulip."

#. Occurrence 5A_3:140:4619: scene=5A_3
#: 5A_3:140
msgctxt "text_id=4619 | speaker=unknown"
msgid "　<入|ゲ><り|ー><口|ト>横の係員室の<曇|くも>った鏡に、造花の仕草が映し出される。"
msgstr "  The bearing of this artificial flower reflected in the cloudy mirror of the ticket attendant's office next to the gate."

#. Occurrence 5A_3:145:4620: scene=5A_3
#: 5A_3:145
msgctxt "text_id=4620 | speaker=unknown"
msgid "　その横には、錆びに錆びた掲示板。"
msgstr "  Next to it stood a display board, corroded by years upon years of rust."

#. Occurrence 5A_3:209:4621: scene=5A_3
#: 5A_3:209
msgctxt "text_id=4621 | speaker=unknown"
msgid "　　　　　『今日の入園者数：　　２人"
msgstr "                              No. of Visitors Today: 2"

#. Occurrence 5A_3:215:4622: scene=5A_3
#: 5A_3:215
msgctxt "text_id=4622 | speaker=unknown"
msgid "　　　　　　今日の××××：　　　件』"
msgstr "                              No. of ----        Today: __"

#. Occurrence 5A_3:222:4623: scene=5A_3
#: 5A_3:222
msgctxt "text_id=4623 | speaker=unknown"
msgid "　　　　　　今日の××××：　　　件』"
msgstr "                              No. of ----       Today: __"

#. Occurrence 5A_3:257:4624: scene=5A_3
#: 5A_3:257
msgctxt "text_id=4624 | speaker=unknown"
msgid "　風蝕にさらされた掲示板には心ない落書きが一つ。"
msgstr "  The board had graffiti crudely scrawled atop one of the words."

#. Occurrence 5A_3:263:4625: scene=5A_3
#: 5A_3:263
msgctxt "text_id=4625 | speaker=unknown"
msgid "　今日の××××数は、死亡事故、という単語に書き換えられていた。"
msgstr "  It was replaced with \"Deaths.\""

#. Occurrence 5A_3:268:4626: scene=5A_3
#: 5A_3:268
msgctxt "text_id=4626 | speaker=unknown"
msgid "　もう使われるコトのない記録表。"
msgstr "  The records board had long ago fallen to disrepair."

#. Occurrence 5A_3:273:4627: scene=5A_3
#: 5A_3:273
msgctxt "text_id=4627 | speaker=unknown"
msgid "　それが何であるかたっぷり十秒ほど考えて、<彼|ソ><女|レ>は新たな数字を付け足した。"
msgstr "  After taking a full ten seconds to digest what it was looking at, it made its own revision."

#. Occurrence 5A_3:332:4628: scene=5A_3
#: 5A_3:332
msgctxt "text_id=4628 | speaker=unknown"
msgid "　　　　　　『今日の入園者数：　　３人"
msgstr "                                No. of Visitors Today: 3"

msgctxt "text_id=4629 | speaker=unknown"
msgid "　　　　　　　今日の死亡事故：　　１件』"
msgstr "                                No. of Deaths  Today: 1"

#. Occurrence 5A_3:367:4630: scene=5A_3
#: 5A_3:367
msgctxt "text_id=4630 | speaker=unknown"
msgid "　人差し指で数字を付け足して、彼女は花のように微笑む。"
msgstr "  After appending this number with an index finger, she smiled like a flower."

#. Occurrence 5A_3:372:4631: scene=5A_3
#: 5A_3:372
msgctxt "text_id=4631 | speaker=unknown"
msgid "　……は、音に向かって歩きだす。"
msgstr "  Then she began to walk toward the source of the sound."

#. Occurrence 5A_3:433:4632: scene=5A_3
#: 5A_3:433
msgctxt "text_id=4632 | speaker=unknown"
msgid "　ミラーハウスから狂詩曲じみた雑音が<響|ひび>きだしてから、はや十分。"
msgstr "  It had been ten minutes since this rhapsody had begun to echo from the house of mirrors."

#. Occurrence 5A_3:440:4633: scene=5A_3
#: 5A_3:440
msgctxt "text_id=4633 | speaker=unknown"
msgid "　遊園地の入り口は、ずっと無人のままだった。"
msgstr "  The amusement park's entrance returned to as it was before: soulless."

#. Occurrence 5A_4:45:4634: scene=5A_4
#: 5A_4:45
msgctxt "text_id=4634 | speaker=unknown"
msgid "　結論から言えば。"
msgstr "  In the end..."

#. Occurrence 5A_4:50:4635: scene=5A_4
#: 5A_4:50
msgctxt "text_id=4635 | speaker=unknown"
msgid "　仮に、<草十郎|カレ>が世界で一番強運な男だとしても、逃げきれる筈はなかったのである。"
msgstr "  Even if Soujyuro had been the luckiest man alive, there was no way he should have been able to escape."

#. Occurrence 5A_4:88:4636: scene=5A_4
#: 5A_4:88
msgctxt "text_id=4636 | speaker=unknown"
msgid "　ただ、どこまでが計算通りで、"
msgstr "  The question, however, was how much of this was by design,"

#. Occurrence 5A_4:93:4637: scene=5A_4
#: 5A_4:93
msgctxt "text_id=4637 | speaker=unknown"
msgid "　どこまでが偶然だったのか。"
msgstr "  and how much was sheer coincidence?"

#. Occurrence 5A_4:98:4638: scene=5A_4
#: 5A_4:98
msgctxt "text_id=4638 | speaker=unknown"
msgid "　それは結末を用意していた青子にも分からない。"
msgstr "  Even Aoko, who had made all the arrangements, had no answer."

#. Occurrence 5A_4:119:4639: scene=5A_4
#: 5A_4:119
msgctxt "text_id=4639 | speaker=unknown"
msgid "　彼女に言えるのは三つだけ。"
msgstr "  Indeed, there were only three things she could say:"

#. Occurrence 5A_4:124:4640: scene=5A_4
#: 5A_4:124
msgctxt "text_id=4640 | speaker=unknown"
msgid "　思っていたより時間がかかって、"
msgstr "  It was taking longer than expected,"

#. Occurrence 5A_4:129:4641: scene=5A_4
#: 5A_4:129
msgctxt "text_id=4641 | speaker=unknown"
msgid "　予想していたより<手応|てごた>えがあって、"
msgstr "  he was putting up more resistance than she had anticipated,"

#. Occurrence 5A_4:134:4642: scene=5A_4
#: 5A_4:134
msgctxt "text_id=4642 | speaker=unknown"
msgid "　それと、ミラーハウスを選んだのは失敗だった、というコトぐらい。"
msgstr "  and that choosing the house of mirrors had been a mistake."

#. Occurrence 5A_4:202:4643: scene=5A_4
#: 5A_4:202
msgctxt "text_id=4643 | speaker=unknown"
msgid "　……そう、何が失敗かと言うと。"
msgstr "  She had really screwed the pooch on this one."

#. Occurrence 5A_4:207:4644: scene=5A_4
#: 5A_4:207
msgctxt "text_id=4644 | speaker=unknown"
msgid "　ミラーハウスは狩り場として文句なしの地形だったけれど、鏡に映る自分と向き合うのは半人前の彼女にとって、少しだけ苛立たしいコトだった。"
msgstr "  The location itself was an excellent choice, as the house of mirrors was perfect as a hunting ground. But seeing her own incompetence reflected in the mirrors was beginning to grate on her."

#. Occurrence 5A_4:463:4645: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0000; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:463
msgctxt "text_id=4645 | speaker=soujuurou"
msgid "「うわあ！」"
msgstr "\"Ahhh!\""

#. Occurrence 5A_4:469:4646: scene=5A_4
#: 5A_4:469
msgctxt "text_id=4646 | speaker=unknown"
msgid "　青子の右腕が光った瞬間、草十郎は目の前の階段に逃げこんだ。"
msgstr "  The moment Aoko's right arm began to glow, Soujyuro made a beeline for the staircase in front of him."

#. Occurrence 5A_4:474:4647: scene=5A_4
#: 5A_4:474
msgctxt "text_id=4647 | speaker=unknown"
msgid "　背後には連続する青い<閃光|ストロボ>。"
msgstr "  A strobing series of blue flashes lit the room behind him."

#. Occurrence 5A_4:479:4648: scene=5A_4
#: 5A_4:479
msgctxt "text_id=4648 | speaker=unknown"
msgid "　無我夢中で階段を駆け上がる獲物を、狩人はあわてずに追っていく。"
msgstr "  The hunter calmly followed her prey, and the prey desperately ran for his life up the stairs."

#. Occurrence 5A_4:592:4649: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0000; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:592
msgctxt "text_id=4649 | speaker=aoko"
msgid "「―――注文通り。"
msgstr "\"...Just what the doctor ordered."

#. Occurrence 5A_4:598:4650: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0001; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:598
msgctxt "text_id=4650 | speaker=aoko"
msgid "　そうでなくっちゃ、お<膳立|ぜんだ>てした甲斐がない」"
msgstr "  We can't very well let the best-laid plans go to waste now, can we?\""

#. Occurrence 5A_4:604:4651: scene=5A_4
#: 5A_4:604
msgctxt "text_id=4651 | speaker=unknown"
msgid "　走る草十郎とは対照的に、青子はやや早歩きで階段を上っていく。"
msgstr "  In stark contrast to Soujyuro's frenzied escape, Aoko walked briskly up the stairs."

#. Occurrence 5A_4:650:4652: scene=5A_4
#: 5A_4:650
msgctxt "text_id=4652 | speaker=unknown"
msgid "　青子が走って追わないのは、獲物と一定の距離を保つためだ。"
msgstr "  She elected not to run after her prey in order to maintain a set distance."

#. Occurrence 5A_4:655:4653: scene=5A_4
#: 5A_4:655
msgctxt "text_id=4653 | speaker=unknown"
msgid "　命中率に自信のない彼女にとって、もっとも対処に困るのが玉砕覚悟の突進である。"
msgstr "  As she lacked confidence in her accuracy, she would be the most challenged if Soujyuro bull-rushed her and went down fighting."

#. Occurrence 5A_4:751:4654: scene=5A_4
#: 5A_4:751
msgctxt "text_id=4654 | speaker=unknown"
msgid "　十メートル程度の距離があるのなら問題はない。"
msgstr "  But at a distance of thirty or so feet, he posed no threat."

#. Occurrence 5A_4:756:4655: scene=5A_4
#: 5A_4:756
msgctxt "text_id=4655 | speaker=unknown"
msgid "　獲物が接近するまで十発中四発は当てられる。"
msgstr "  By the time her prey drew near, she could fire ten shots and hit with at least four of them."

#. Occurrence 5A_4:761:4656: scene=5A_4
#: 5A_4:761
msgctxt "text_id=4656 | speaker=unknown"
msgid "　しかし先ほどの位置関係は少々まずかった。"
msgstr "  Their positioning just a moment ago hadn't been ideal."

#. Occurrence 5A_4:766:4657: scene=5A_4
#: 5A_4:766
msgctxt "text_id=4657 | speaker=unknown"
msgid "　あの距離、あの広さの空間で迂回されながら突進されたら、わずかではあるが、そのまま接近されて素手での争いになる可能性がある。"
msgstr "  At this distance, in a space this open, there was a chance, however small, that it could turn into a fistfight if he flanked and charged her."

#. Occurrence 5A_4:786:4658: scene=5A_4
#: 5A_4:786
msgctxt "text_id=4658 | speaker=unknown"
msgid "　現在、青子の最大の武器は右腕の魔弾だ。"
msgstr "  Currently, Aoko's best weapon was the bullets from her right arm."

#. Occurrence 5A_4:791:4659: scene=5A_4
#: 5A_4:791
msgctxt "text_id=4659 | speaker=unknown"
msgid "　この利点を生かすのなら距離を詰めすぎてはいけない。"
msgstr "  If she was going to capitalize on that advantage, it was in her best interest not to close the gap between them."

#. Occurrence 5A_4:796:4660: scene=5A_4
#: 5A_4:796
msgctxt "text_id=4660 | speaker=unknown"
msgid "　近づく時があるとしたら、それは獲物の体力がなくなり、<諦|あきら>めたあと。"
msgstr "  If there was a good time to approach, it was only after her prey had become exhausted and had lost the will to continue."

#. Occurrence 5A_4:851:4661: scene=5A_4
#: 5A_4:851
msgctxt "text_id=4661 | speaker=unknown"
msgid "　足を射貫くか、背中を撃つか。"
msgstr "  Would she pierce his leg? Shoot him in the back?"

#. Occurrence 5A_4:856:4662: scene=5A_4
#: 5A_4:856
msgctxt "text_id=4662 | speaker=unknown"
msgid "　あるいは、この迷路で心が折れるか。"
msgstr "  Or, perhaps, would he just give up after losing himself in the labyrinth?"

#. Occurrence 5A_4:861:4663: scene=5A_4
#: 5A_4:861
msgctxt "text_id=4663 | speaker=unknown"
msgid "　なんらかの傷を負って標的が走れなくなった時が、この狩りの幕引きとなる。"
msgstr "  The hunt would end when her target sustained some sort of injury and became unable to run."

#. Occurrence 5A_4:917:4664: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0001; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:917
msgctxt "text_id=4664 | speaker=soujuurou"
msgid "「っ―――！」"
msgstr "\"...!\""

#. Occurrence 5A_4:923:4665: scene=5A_4
#: 5A_4:923
msgctxt "text_id=4665 | speaker=unknown"
msgid "　一方、草十郎は悲鳴を<堪|こら>えながら迷路を走っていた。"
msgstr "  On Soujyuro's end, he could barely bite back on screaming as he bolted through the maze."

#. Occurrence 5A_4:928:4666: scene=5A_4
#: 5A_4:928
msgctxt "text_id=4666 | speaker=unknown"
msgid "　出口など目指しようもなく、まっすぐ走る事すら難しい。"
msgstr "  Even running in a straight line had become difficult, much less searching for an exit."

#. Occurrence 5A_4:988:4667: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0002; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:988
msgctxt "text_id=4667 | speaker=soujuurou"
msgid "「あいた！？」"
msgstr "\"Ow!\""

#. Occurrence 5A_4:994:4668: scene=5A_4
#: 5A_4:994
msgctxt "text_id=4668 | speaker=unknown"
msgid "　長く伸びている通路は、そう見えるだけで鏡の壁でふさがれている。"
msgstr "  The corridor stretched out far before him...or so the mirrors blocking the path had made it seem."

#. Occurrence 5A_4:1000:4669: scene=5A_4
#: 5A_4:1000
msgctxt "text_id=4669 | speaker=unknown"
msgid "　あわてて右に曲がろうとして、"
msgstr "  Panicked, he made a turn to the right."

#. Occurrence 5A_4:1066:4670: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0003; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:1066
msgctxt "text_id=4670 | speaker=soujuurou"
msgid "「あたた！？」"
msgstr "\"That hurt!\""

#. Occurrence 5A_4:1074:4671: scene=5A_4
#: 5A_4:1074
msgctxt "text_id=4671 | speaker=unknown"
msgid "　草十郎は額をおさえながら残った左に腕を伸ばし、壁がない事を確認し、"
msgstr "  Clutching his head in his right arm, Soujyuro led with his left, groping through the air to see whether a wall was there or not."

#. Occurrence 5A_4:1131:4672: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0004; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:1131
msgctxt "text_id=4672 | speaker=soujuurou"
msgid "「！」"
msgstr "\"Nngh!\""

#. Occurrence 5A_4:1136:4673: scene=5A_4
#: 5A_4:1136
msgctxt "text_id=4673 | speaker=unknown"
msgid "　とっさに左の通路に飛びこんで、コンマの差で凶弾から身をかわす。"
msgstr "  He dove down the hall to the left, narrowly dodging the bullets targeting his life."

#. Occurrence 5A_4:1219:4674: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0005; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:1219
msgctxt "text_id=4674 | speaker=soujuurou"
msgid "「はっ―――、は―――！」"
msgstr "\"Hah...haah...!\""

#. Occurrence 5A_4:1225:4675: scene=5A_4
#: 5A_4:1225
msgctxt "text_id=4675 | speaker=unknown"
msgid "　近づいてくる足音にせき立てられて、考える前にとにかく走る。"
msgstr "  Urged on by the sound of approaching footsteps, he ran without thinking."

#. Occurrence 5A_4:1273:4676: scene=5A_4
#: 5A_4:1273
msgctxt "text_id=4676 | speaker=unknown"
msgid "　今のは本当に紙一重だった。"
msgstr "  That last one was close. A hair closer would have meant his life."

#. Occurrence 5A_4:1279:4677: scene=5A_4
#: 5A_4:1279
msgctxt "text_id=4677 | speaker=unknown"
msgid "　後ろ髪の焦げた臭いがする。"
msgstr "  He caught the odor of burnt hair from the back of his neck."

#. Occurrence 5A_4:1284:4678: scene=5A_4
#: 5A_4:1284
msgctxt "text_id=4678 | speaker=unknown"
msgid "　きっと強運。"
msgstr "  He was very lucky."

#. Occurrence 5A_4:1289:4679: scene=5A_4
#: 5A_4:1289
msgctxt "text_id=4679 | speaker=unknown"
msgid "　あるいは悪運だ。"
msgstr "  Or perhaps very unlucky."

#. Occurrence 5A_4:1295:4680: scene=5A_4
#: 5A_4:1295
msgctxt "text_id=4680 | speaker=unknown"
msgid "幸運の類があるなら、そもそもこんな事態になってはいない。"
msgstr "If he were actually lucky, he would not be in this situation in the first place."

#. Occurrence 5A_4:1342:4681: scene=5A_4
#: 5A_4:1342
msgctxt "text_id=4681 | speaker=unknown"
msgid "　ミラーハウスの二階は巨大な渦巻き状になっているらしい。"
msgstr "  The second floor of the house of mirrors was structured like a giant spiral."

#. Occurrence 5A_4:1347:4682: scene=5A_4
#: 5A_4:1347
msgctxt "text_id=4682 | speaker=unknown"
msgid "　外周からはじまって、とにかく左に左にと曲がっていく。"
msgstr "  It wound left, starting from the outside wall."

#. Occurrence 5A_4:1352:4683: scene=5A_4
#: 5A_4:1352
msgctxt "text_id=4683 | speaker=unknown"
msgid "　いきつく先はどんづまり。逃げれば逃げるほど追いつめられる、<蝸牛|かたつむり>のカラに似た断頭台だ。"
msgstr "  Eventually, it would lead to a dead end. The more he tried to escape, the more cornered he would become, as though he were trapped in a twisted guillotine."

#. Occurrence 5A_4:1435:4684: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0006; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:1435
msgctxt "text_id=4684 | speaker=soujuurou"
msgid "「…………、っ」"
msgstr "\"Huff, huff...\""

#. Occurrence 5A_4:1443:4685: scene=5A_4
#: 5A_4:1443
msgctxt "text_id=4685 | speaker=unknown"
msgid "　<抑|おさ>えつけた悲鳴が、文句になって出てきそうだ。"
msgstr "  His stifled screams threatened to leak out as complaints."

#. Occurrence 5A_4:1448:4686: scene=5A_4
#: 5A_4:1448
msgctxt "text_id=4686 | speaker=unknown"
msgid "　どのみち殺されるのに、こんなワケの分からない状況がまだ<数秒|すうびょう><数分|すうふん>、自分の頑張り次第で続くなんて―――！"
msgstr "  No matter what he did, he was going to be killed. All of his struggling merely served to prolong the inevitable."

#. Occurrence 5A_4:1483:4687: scene=5A_4
#: 5A_4:1483
msgctxt "text_id=4687 | speaker=unknown"
msgid "　けれど走る。"
msgstr "  Yet he ran."

#. Occurrence 5A_4:1488:4688: scene=5A_4
#: 5A_4:1488
msgctxt "text_id=4688 | speaker=unknown"
msgid "　何度も鏡の壁にぶつかりながら走る。"
msgstr "  No matter how many mirrored walls he rammed himself into, he ran."

#. Occurrence 5A_4:1493:4689: scene=5A_4
#: 5A_4:1493
msgctxt "text_id=4689 | speaker=unknown"
msgid "　衝突のたび目に星が舞って、額から出血しても走る。"
msgstr "  Even after crashing so hard that his forehead bled and he saw stars, he ran."

#. Occurrence 5A_4:1570:4690: scene=5A_4
#: 5A_4:1570
msgctxt "text_id=4690 | speaker=unknown"
msgid "　激痛は数秒ごとに。"
msgstr "  Pain shot through him at every turn."

#. Occurrence 5A_4:1575:4691: scene=5A_4
#: 5A_4:1575
msgctxt "text_id=4691 | speaker=unknown"
msgid "　がむしゃらに走れば走るほど手ひどく透明の壁にぶつかってしまう。"
msgstr "  The more frantically he ran, the more intensely he smashed into the invisible walls."

#. Occurrence 5A_4:1580:4692: scene=5A_4
#: 5A_4:1580
msgctxt "text_id=4692 | speaker=unknown"
msgid "　体はもうその法則を覚え始めていて、これ以上は走りたくないと<訴|うった>える。"
msgstr "  His body began to understand this rule and begged him not to run anymore."

#. Occurrence 5A_4:1661:4693: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0007; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:1661
msgctxt "text_id=4693 | speaker=soujuurou"
msgid "「はっ、は―――！」"
msgstr "\"Hah, hah!\""

#. Occurrence 5A_4:1667:4694: scene=5A_4
#: 5A_4:1667
msgctxt "text_id=4694 | speaker=unknown"
msgid "　結果、たった六十メートル程度の全力疾走で息が上がっていた。"
msgstr "  His breath was already ragged after sprinting a couple hundred feet."

#. Occurrence 5A_4:1672:4695: scene=5A_4
#: 5A_4:1672
msgctxt "text_id=4695 | speaker=unknown"
msgid "　そもそも<而|しか>るに、どう考えてもマトモじゃない。いくらなんでも突拍子がなさすぎる。"
msgstr "  No matter how he thought about it, this was not normal. This was way too crazy."

#. Occurrence 5A_4:1679:4696: scene=5A_4
#: 5A_4:1679
msgctxt "text_id=4696 | speaker=unknown"
msgid "こんなのは<性質|たち>の悪い冗談で、振り返ればやりすぎてゴメンと謝る彼女がいるに決まっている。"
msgstr "This was all just a bad joke. If he turned around now, she would apologize to him for taking it too far."

#. Occurrence 5A_4:1686:4697: scene=5A_4
#: 5A_4:1686
msgctxt "text_id=4697 | speaker=unknown"
msgid "頭は真っ白で、体は度重なる衝突で音を上げて、そうに違いないと足を止めそうになったところに、"
msgstr "His mind had gone blank. As his body continued to slam into the mirrors again and again, his feet slowed as they began to believe that perhaps it really was all a joke. But then..."

#. Occurrence 5A_4:1729:4698: scene=5A_4
#: 5A_4:1729
msgctxt "text_id=4698 | speaker=unknown"
msgid "　ぞくりと。"
msgstr "  He felt a chill."

#. Occurrence 5A_4:1734:4699: scene=5A_4
#: 5A_4:1734
msgctxt "text_id=4699 | speaker=unknown"
msgid "　首もとに<被|かぶ>さるような、死の手触りを感じ取った。"
msgstr "  A touch of death upon his neck."

#. Occurrence 5A_4:1766:4700: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0008; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:1766
msgctxt "text_id=4700 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5A_4:1772:4701: scene=5A_4
#: 5A_4:1772
msgctxt "text_id=4701 | speaker=unknown"
msgid "　大げさな話ではなく、草十郎はこの類の悪寒をイヤというほど知っていた。"
msgstr "  It would not be an exaggeration to say that Soujyuro knew this kind of terrible chill far too well."

#. Occurrence 5A_4:1777:4702: scene=5A_4
#: 5A_4:1777
msgctxt "text_id=4702 | speaker=unknown"
msgid "　なにしろ町にやってきてからこっち、死にかけた事は一度や二度ではなかったのだ。"
msgstr "  Ever since he had arrived in the city, he had come face-to-face with more than one or two near-death experiences."

#. Occurrence 5A_4:1782:4703: scene=5A_4
#: 5A_4:1782
msgctxt "text_id=4703 | speaker=unknown"
msgid "　道を行く自動車や通勤ラッシュで混雑する駅のホームは、ルールを知らない彼からすれば、いまの状況とそう大差のないものなのだから。"
msgstr "  For someone who did not understand city life, his present predicament was not unlike when he experienced the traffic on the streets or the commuter rush on the station platform."

#. Occurrence 5A_4:1865:4704: scene=5A_4
#: 5A_4:1865
msgctxt "text_id=4704 | speaker=unknown"
msgid "　彼はまだ命も恐怖も知らない、無邪気な幼子ではない。"
msgstr "  He was far from an innocent babe unable to comprehend life or fear."

#. Occurrence 5A_4:1881:4705: scene=5A_4
#: 5A_4:1881
msgctxt "text_id=4705 | speaker=unknown"
msgid "　一つの人格としてかたちどられた知性が、ある日突然、まったく違う文化圏に放りこまれただけ。"
msgstr "  Rather, everything he had ever known became irrelevant when he was flung into a completely different cultural sphere."

#. Occurrence 5A_4:1886:4706: scene=5A_4
#: 5A_4:1886
msgctxt "text_id=4706 | speaker=unknown"
msgid "　この町にとって当然のもの―――安全が約束されている公共の機構ですら、彼にとっては“未知”の脅威だった。"
msgstr "  Even society's promises of safety―something urbanites took for granted―were threats unknown."

#. Occurrence 5A_4:1929:4707: scene=5A_4
#: 5A_4:1929
msgctxt "text_id=4707 | speaker=unknown"
msgid "　……だから、既に慣れてはいたし。"
msgstr "  ...So, he was used to this already."

#. Occurrence 5A_4:1934:4708: scene=5A_4
#: 5A_4:1934
msgctxt "text_id=4708 | speaker=unknown"
msgid "　正直に告白すれば、不満に思う事だってあったのだ。"
msgstr "  Though if he were to be honest, he was dissatisfied with some things."

#. Occurrence 5A_4:1974:4709: scene=5A_4
#: 5A_4:1974
msgctxt "text_id=4709 | speaker=unknown"
msgid "　まったく不要なもの。"
msgstr "  Things superfluous to necessity."

#. Occurrence 5A_4:1979:4710: scene=5A_4
#: 5A_4:1979
msgctxt "text_id=4710 | speaker=unknown"
msgid "　まったく価値を見いだせないものにあふれ、それらがすべて危険な役割を持った世界。"
msgstr "  This world was overflowing with valueless things, and they were all dangerous in some way."

#. Occurrence 5A_4:1984:4711: scene=5A_4
#: 5A_4:1984
msgctxt "text_id=4711 | speaker=unknown"
msgid "　コンビニエンスストアにある多くの日用雑貨すら、彼にとってはたいへん優れた“道具”である。"
msgstr "  Even the everyday necessities sold at the convenience store were, as far as he was concerned, amazing tools."

#. Occurrence 5A_4:2004:4712: scene=5A_4
#: 5A_4:2004
msgctxt "text_id=4712 | speaker=unknown"
msgid "　文明はその水準を上げるほど、人間の持つ危機感を麻痺させる。"
msgstr "  Civilization had raised the standard of living so high that it had numbed humanity's sense of danger."

#. Occurrence 5A_4:2009:4713: scene=5A_4
#: 5A_4:2009
msgctxt "text_id=4713 | speaker=unknown"
msgid "　裕福さ、便利さを進めていく街のあり方は、田舎で育った草十郎にとっては毒そのものだ。"
msgstr "  The city's constant pursuit of wealth and convenience was a poison to a country boy like Soujyuro,"

#. Occurrence 5A_4:2053:4714: scene=5A_4
#: 5A_4:2053
msgctxt "text_id=4714 | speaker=unknown"
msgid "　そして不幸な事に、彼には便利さを甘受するだけの余裕がなく。"
msgstr "  and he did not have the capacity to accept these conveniences."

#. Occurrence 5A_4:2058:4715: scene=5A_4
#: 5A_4:2058
msgctxt "text_id=4715 | speaker=unknown"
msgid "　扱い方を間違えるだけで<容易|ようい>に、唐突に、誰もが意図しなかった事故が起きる都会の便利さに、ずっと、違和感を抱いていた。"
msgstr "  That it was possible for such conveniences to easily and suddenly be misused and cause unintended accidents had always made him anxious."

#. Occurrence 5A_4:2063:4716: scene=5A_4
#: 5A_4:2063
msgctxt "text_id=4716 | speaker=unknown"
msgid "　どうして。"
msgstr "  Why?"

#. Occurrence 5A_4:2068:4717: scene=5A_4
#: 5A_4:2068
msgctxt "text_id=4717 | speaker=unknown"
msgid "　なんで自分は、こんなところにいるのだろう、と。"
msgstr "  He had to wonder why he was even here."

#. Occurrence 5A_4:2200:4718: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0009; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:2200
msgctxt "text_id=4718 | speaker=soujuurou"
msgid "「―――、ああ」"
msgstr "\"...Ah.\""

#. Occurrence 5A_4:2206:4719: scene=5A_4
#: 5A_4:2206
msgctxt "text_id=4719 | speaker=unknown"
msgid "　皮肉にすぎる。"
msgstr "  How ironic."

#. Occurrence 5A_4:2212:4720: scene=5A_4
#: 5A_4:2212
msgctxt "text_id=4720 | speaker=unknown"
msgid "　そんな、今まで気付かなかった本心に、"
msgstr "  It took the real threat of death to finally make him realize,"

msgctxt "text_id=4721 | speaker=unknown"
msgid "　命を狙われている状況で、<天啓|てんけい>のように思い知るなんて。"
msgstr "  like a divine revelation, what he'd failed to understand until now:"

#. Occurrence 5A_4:2234:4722: scene=5A_4
#: 5A_4:2234
msgctxt "text_id=4722 | speaker=unknown"
msgid "　……そう。唐突なのは今に始まった事ではない。"
msgstr "  He'd always had to expect the unexpected."

#. Occurrence 5A_4:2239:4723: scene=5A_4
#: 5A_4:2239
msgctxt "text_id=4723 | speaker=unknown"
msgid "　死にそうな目に遭うのはそこまで特別な事ではない。"
msgstr "  Near-death experiences were more common than one might think."

#. Occurrence 5A_4:2244:4724: scene=5A_4
#: 5A_4:2244
msgctxt "text_id=4724 | speaker=unknown"
msgid "　本来<安全|あんぜん>というのは対価を支払って得るものなのだし。"
msgstr "  To begin with, safety was something that came at a price."

#. Occurrence 5A_4:2249:4725: scene=5A_4
#: 5A_4:2249
msgctxt "text_id=4725 | speaker=unknown"
msgid "　生きているのなら常に逆の目が待っている。"
msgstr "  Being alive meant that the opposite was always lurking around the corner."

#. Occurrence 5A_4:2255:4726: scene=5A_4
#: 5A_4:2255
msgctxt "text_id=4726 | speaker=unknown"
msgid "　例えば、夜の街灯のように。"
msgstr "  It was just like a street light at night."

#. Occurrence 5A_4:2260:4727: scene=5A_4
#: 5A_4:2260
msgctxt "text_id=4727 | speaker=unknown"
msgid "　朝になれば当然、その明かりは消えるのだ。"
msgstr "  When the sun rose, its illumination would naturally disappear."

#. Occurrence 5A_4:2347:4728: scene=5A_4
#: 5A_4:2347
msgctxt "text_id=4728 | speaker=unknown"
msgid "　容赦なく撃ちだされる正体不明の凶器。"
msgstr "  Another barrage of strange projectiles whizzed mercilessly by him."

#. Occurrence 5A_4:2352:4729: scene=5A_4
#: 5A_4:2352
msgctxt "text_id=4729 | speaker=unknown"
msgid "　二日前の夜、青い炎に包まれて消し<炭|ずみ>になった人影が脳裏に蘇る。"
msgstr "  He recalled in the back of his mind the charred remains of someone at the hands of that blue flame two nights prior."

#. Occurrence 5A_4:2385:4730: scene=5A_4
#: 5A_4:2385
msgctxt "text_id=4730 | speaker=unknown"
msgid "　釣られた<人参|にんじん>欲しさに走る馬みたいだ、と彼は思った。"
msgstr "  Somehow this situation reminded him of a horse being led by a dangling carrot."

#. Occurrence 5A_4:2394:4731: scene=5A_4
#: 5A_4:2394
msgctxt "text_id=4731 | speaker=unknown"
msgid "　とにかくアゴをあげて迷路を走る。"
msgstr "  For now he lifted his head and continued to run through the labyrinth."

#. Occurrence 5A_4:2412:4732: scene=5A_4
#: 5A_4:2412
msgctxt "text_id=4732 | speaker=unknown"
msgid "　でも、いったい何のために？"
msgstr "  But for what purpose?"

#. Occurrence 5A_4:2460:4733: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0010; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:2460
msgctxt "text_id=4733 | speaker=soujuurou"
msgid "「はっ―――、はっ―――」"
msgstr "\"Hah... hah...\""

#. Occurrence 5A_4:2466:4734: scene=5A_4
#: 5A_4:2466
msgctxt "text_id=4734 | speaker=unknown"
msgid "　心臓の苦しさは本物なのに、まるで現実感がない。"
msgstr "  Though he knew the pain in his chest was very real, he felt disconnected from it."

#. Occurrence 5A_4:2472:4735: scene=5A_4
#: 5A_4:2472
msgctxt "text_id=4735 | speaker=unknown"
msgid "　天窓から見える夜空は泥を流したような<群青|ぐんじょう>で、<草十郎|カレ>の知っている夜空には似ても似つかない。"
msgstr "  The night sky visible through the skylight was a muddy ultramarine, no longer resembling the one he knew."

#. Occurrence 5A_4:2520:4736: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0011; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:2520
msgctxt "text_id=4736 | speaker=soujuurou"
msgid "「―――、は」"
msgstr "\"...Hah.\""

#. Occurrence 5A_4:2525:4737: scene=5A_4
#: 5A_4:2525
msgctxt "text_id=4737 | speaker=unknown"
msgid "　唐突に気が<緩|ゆる>む。"
msgstr "  And managed to calm himself."

#. Occurrence 5A_4:2530:4738: scene=5A_4
#: 5A_4:2530
msgctxt "text_id=4738 | speaker=unknown"
msgid "　<捨|す>て<鉢|ばち>気味に草十郎は笑って、わりと大切なものが折れた気がした。"
msgstr "  Soujyuro began to laugh in despair, as though something rather precious had been broken."

#. Occurrence 5A_4:2550:4739: scene=5A_4
#: 5A_4:2550
msgctxt "text_id=4739 | speaker=unknown"
msgid "　だって、そもそも全てがどうでもいい。"
msgstr "  Everything had become meaningless anyway."

#. Occurrence 5A_4:2617:4740: scene=5A_4
#: 5A_4:2617
msgctxt "text_id=4740 | speaker=unknown"
msgid "　それでもなんとか足が進んだのは、合わせ鏡に彼女の姿が映るからだ。"
msgstr "  Even so, his legs somehow made their way forward at the sight of her reflection in the mirror."

#. Occurrence 5A_4:2735:4741: scene=5A_4
#: 5A_4:2735
msgctxt "text_id=4741 | speaker=unknown"
msgid "　追いかけっこをするネコとネズミのように、草十郎は鏡の迷路を<遁走|とんそう>する。"
msgstr "  Like a game of cat and mouse, Soujyuro fled through the labyrinth of mirrors."

#. Occurrence 5A_4:2740:4742: scene=5A_4
#: 5A_4:2740
msgctxt "text_id=4742 | speaker=unknown"
msgid "　その、妙に現実感のない緊迫は、実質四分ほどで終了した。"
msgstr "  Then, after four minutes, that strangely unreal tension ended."

#. Occurrence 5A_4:2917:4743: scene=5A_4
#: 5A_4:2917
msgctxt "text_id=4743 | speaker=unknown"
msgid "　九回目の青い光が、草十郎の真横で発火する。"
msgstr "  The ninth shot of blue light hit inches away from him."

#. Occurrence 5A_4:2922:4744: scene=5A_4
#: 5A_4:2922
msgctxt "text_id=4744 | speaker=unknown"
msgid "　光は壁に被弾するなり爆発して、その衝撃で草十郎を反対側の壁に叩きつける。"
msgstr "  It exploded the moment it made impact, launching Soujyuro into the opposite wall."

#. Occurrence 5A_4:2928:4745: scene=5A_4
#: 5A_4:2928
msgctxt "text_id=4745 | speaker=unknown"
msgid "　文句なく、今までで一番「死」に近い一撃だった。"
msgstr "  Of all the fire he had taken thus far, this shot indisputably brought him the closest to death."

#. Occurrence 5A_4:3030:4746: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0012; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:3030
msgctxt "text_id=4746 | speaker=soujuurou"
msgid "「痛っ……！」"
msgstr "\"GAAAH!\""

#. Occurrence 5A_4:3036:4747: scene=5A_4
#: 5A_4:3036
msgctxt "text_id=4747 | speaker=unknown"
msgid "　呻いて、床に倒れこむ。"
msgstr "  Groaning, he collapsed to the floor."

#. Occurrence 5A_4:3041:4748: scene=5A_4
#: 5A_4:3041
msgctxt "text_id=4748 | speaker=unknown"
msgid "　背中はひりひりと痛んでいる。"
msgstr "  His back was on fire with pain."

#. Occurrence 5A_4:3046:4749: scene=5A_4
#: 5A_4:3046
msgctxt "text_id=4749 | speaker=unknown"
msgid "　出血はない。『痛い』程度で済んだのは幸運だろう。"
msgstr "  He was not bleeding, and was lucky he could still even scream."

#. Occurrence 5A_4:3082:4750: scene=5A_4
#: 5A_4:3082
msgctxt "text_id=4750 | speaker=unknown"
msgid "　けれど、体は<頑|がん>として動かなかった。"
msgstr "  Yet, his body refused to move."

#. Occurrence 5A_4:3087:4751: scene=5A_4
#: 5A_4:3087
msgctxt "text_id=4751 | speaker=unknown"
msgid "　肉体的にも精神的にもまだ余裕はある。"
msgstr "  Physically and mentally he still had something to spare."

#. Occurrence 5A_4:3092:4752: scene=5A_4
#: 5A_4:3092
msgctxt "text_id=4752 | speaker=unknown"
msgid "　起き上がれない程の痛みでもない。"
msgstr "  The pain was not so bad that he couldn't get back up."

#. Occurrence 5A_4:3121:4753: scene=5A_4
#: 5A_4:3121
msgctxt "text_id=4753 | speaker=unknown"
msgid "　ただ、倒れてふと見上げた天井には窓があって、暗い夜空が見えてしまった。"
msgstr "  It was just that there was a skylight above him, and he could glimpse the dark of the night sky beyond."

#. Occurrence 5A_4:3126:4754: scene=5A_4
#: 5A_4:3126
msgctxt "text_id=4754 | speaker=unknown"
msgid "　胸に去来した<感|も><情|の>は未熟な、身勝手な嘆きだった。"
msgstr "  The feeling that overcame him was a raw, selfish bout of grief."

#. Occurrence 5A_4:3133:4755: scene=5A_4
#: 5A_4:3133
msgctxt "text_id=4755 | speaker=unknown"
msgid "　……ああ、なんて醜い。"
msgstr "  Oh, it was just so cruel―"

#. Occurrence 5A_4:3138:4756: scene=5A_4
#: 5A_4:3138
msgctxt "text_id=4756 | speaker=unknown"
msgid "　こんなものを、これから一生、見続けていく。"
msgstr "  to have to stare at that for the remainder of whatever short life he had left."

#. Occurrence 5A_4:3189:4757: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0013; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:3189
msgctxt "text_id=4757 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5A_4:3195:4758: scene=5A_4
#: 5A_4:3195
msgctxt "text_id=4758 | speaker=unknown"
msgid "　乱れていた呼吸が、熱を失ったように治まった。"
msgstr "  Soujyuro's ragged breath slowed."

#. Occurrence 5A_4:3200:4759: scene=5A_4
#: 5A_4:3200
msgctxt "text_id=4759 | speaker=unknown"
msgid "　簡単に言うなら、彼はそれで諦めてしまったのだ。"
msgstr "  For all intents and purposes, he had given up."

#. Occurrence 5A_4:3205:4760: scene=5A_4
#: 5A_4:3205
msgctxt "text_id=4760 | speaker=unknown"
msgid "　追いかけてくる足音から逃げるという行為と、たぶん、もっと大きな、根本にある問題から。"
msgstr "  He had given up fleeing from the pursuing footsteps, and perhaps, even the root of all his problems."

#. Occurrence 5A_4:3238:4761: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0014; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:3238
msgctxt "text_id=4761 | speaker=soujuurou"
msgid "“まあ……蒼崎に殺されるなら、いいかな”"
msgstr "(Well, at least it was Aozaki who got to kill me.)"

#. Occurrence 5A_4:3245:4762: scene=5A_4
#: 5A_4:3245
msgctxt "text_id=4762 | speaker=unknown"
msgid "　静希草十郎という人間にとって、決してあってはならない感想が漏れる。"
msgstr "  Soujyuro Sizuki felt things that, in any other circumstance, he would never feel."

#. Occurrence 5A_4:3250:4763: scene=5A_4
#: 5A_4:3250
msgctxt "text_id=4763 | speaker=unknown"
msgid "　……余談ではあるが。"
msgstr "  Incidentally..."

#. Occurrence 5A_4:3256:4764: scene=5A_4
#: 5A_4:3256
msgctxt "text_id=4764 | speaker=unknown"
msgid "大げさな話ではなく、それは彼にとって、生涯ただ一度の過ちだった。"
msgstr "Without exaggeration or embellishment, this was the only mistake he had ever made in his entire life."

#. Occurrence 5A_4:3276:4765: scene=5A_4
#: 5A_4:3276
msgctxt "text_id=4765 | speaker=unknown"
msgid "　ぼんやりと夜空を見上げながら、草十郎は近づいてくる足音を聞く。"
msgstr "  Staring vacantly into the night sky above, Soujyuro listened as the footsteps drew nearer."

#. Occurrence 5A_4:3324:4766: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0002; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3324
msgctxt "text_id=4766 | speaker=aoko"
msgid "「ギブアップ？」"
msgstr "\"You give up?\""

#. Occurrence 5A_4:3330:4767: scene=5A_4
#: 5A_4:3330
msgctxt "text_id=4767 | speaker=unknown"
msgid "　今までで一番近い声。"
msgstr "  It was the closest her voice had ever been to him."

#. Occurrence 5A_4:3335:4768: scene=5A_4
#: 5A_4:3335
msgctxt "text_id=4768 | speaker=unknown"
msgid "　これで幕引きと踏んだのか、彼女は倒れこんだ草十郎の目前まで歩み寄った。"
msgstr "  Perhaps feeling that he really had given up, she approached his collapsed form."

#. Occurrence 5A_4:3355:4769: scene=5A_4
#: 5A_4:3355
msgctxt "text_id=4769 | speaker=unknown"
msgid "　暗い鏡張りの通路では、その表情はうかがい知れない。"
msgstr "  In the dark, mirror-lined corridor, he could not make out her expression."

#. Occurrence 5A_4:3360:4770: scene=5A_4
#: 5A_4:3360
msgctxt "text_id=4770 | speaker=unknown"
msgid "　草十郎は何を言うのでもなく、目前の殺人者を見上げている。"
msgstr "  Without a word, Soujyuro raised his eyes to meet his murderer."

#. Occurrence 5A_4:3460:4771: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0003; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3460
msgctxt "text_id=4771 | speaker=aoko"
msgid "「……返事がないならそれでいいけど。"
msgstr "\"...I suppose if you don't care, you don't have to ask."

#. Occurrence 5A_4:3466:4772: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0004; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3466
msgctxt "text_id=4772 | speaker=aoko"
msgid "　調子狂うわ。普通、どうして殺そうとするのかぐらい、訊くものじゃない？」"
msgstr "  You really do throw me off. Most people would ask me why I'm going to kill them right about now.\""

#. Occurrence 5A_4:3472:4773: scene=5A_4
#: 5A_4:3472
msgctxt "text_id=4773 | speaker=unknown"
msgid "　顔を陰に隠したまま青子は言う。"
msgstr "  Aoko spoke from within the shadows."

#. Occurrence 5A_4:3547:4774: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0015; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:3547
msgctxt "text_id=4774 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5A_4:3553:4775: scene=5A_4
#: 5A_4:3553
msgctxt "text_id=4775 | speaker=unknown"
msgid "　きょとんと目を大きくする草十郎。"
msgstr "  His eyes widened in bewilderment."

#. Occurrence 5A_4:3558:4776: scene=5A_4
#: 5A_4:3558
msgctxt "text_id=4776 | speaker=unknown"
msgid "　言われて、それが自然な疑問なのだと気が付いた。"
msgstr "  Now that she had mentioned it, he realized that would have been the obvious question to ask."

#. Occurrence 5A_4:3563:4777: scene=5A_4
#: 5A_4:3563
msgctxt "text_id=4777 | speaker=unknown"
msgid "　なんとなく雰囲気で“秘密を知ったから殺す”と読み取れたが、どうして自分がこんな目にあうのか、理由を聞きたくなるのが人情である。"
msgstr "  He had more or less picked up on the fact that he was being killed for learning some secret, but it was human nature to want to know more."

#. Occurrence 5A_4:3596:4778: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0016; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:3596
msgctxt "text_id=4778 | speaker=soujuurou"
msgid "「……そっか。それは、そうなるな」"
msgstr "\"...That makes sense, now that you mention it.\""

#. Occurrence 5A_4:3601:4779: scene=5A_4
#: 5A_4:3601
msgctxt "text_id=4779 | speaker=unknown"
msgid "　ああ、という肯定。"
msgstr "  A simple affirmation."

#. Occurrence 5A_4:3606:4780: scene=5A_4
#: 5A_4:3606
msgctxt "text_id=4780 | speaker=unknown"
msgid "　どこか寂しい願いと、諦めのまざった顔。"
msgstr "  His face was a mixture of resignation and a forlorn longing."

#. Occurrence 5A_4:3611:4781: scene=5A_4
#: 5A_4:3611
msgctxt "text_id=4781 | speaker=unknown"
msgid "　彼はしばし考えたあと、"
msgstr "  He thought for a moment, before..."

#. Occurrence 5A_4:3645:4782: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0017; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:3645
msgctxt "text_id=4782 | speaker=soujuurou"
msgid "「でも言う必要はない。"
msgstr "\"But you don't have to say anything."

#. Occurrence 5A_4:3652:4783: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0018; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:3652
msgctxt "text_id=4783 | speaker=soujuurou"
msgid "聞きたくないんだ、そういうのは」"
msgstr "I don't want to hear it.\""

#. Occurrence 5A_4:3658:4784: scene=5A_4
#: 5A_4:3658
msgctxt "text_id=4784 | speaker=unknown"
msgid "　大人びた、静かな声でそう答えた。"
msgstr "  He responded in a mature, subdued voice."

#. Occurrence 5A_4:3761:4785: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0005; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3761
msgctxt "text_id=4785 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5A_4:3767:4786: scene=5A_4
#: 5A_4:3767
msgctxt "text_id=4786 | speaker=unknown"
msgid "　鮮やかといえば、鮮やかすぎたその回答。"
msgstr "  His response was clear―rather, gallantly so."

#. Occurrence 5A_4:3798:4787: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0006; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3798
msgctxt "text_id=4787 | speaker=aoko"
msgid "「―――そ。"
msgstr "\"...I see."

#. Occurrence 5A_4:3804:4788: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0007; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3804
msgctxt "text_id=4788 | speaker=aoko"
msgid "　じゃ、殺すけど。死ぬの、恐くないの？」"
msgstr "  I'm still going to kill you. Aren't you scared of dying?\""

#. Occurrence 5A_4:3810:4789: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0019; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:3810
msgctxt "text_id=4789 | speaker=soujuurou"
msgid "「恐いに決まってる。なにより痛そうだ」"
msgstr "\"Of course I'm scared. It'll probably hurt.\""

#. Occurrence 5A_4:3840:4790: scene=5A_4
#: 5A_4:3840
msgctxt "text_id=4790 | speaker=unknown"
msgid "　口をとがらせて抗議する草十郎に、青子はむっ、と顔をくもらせる。"
msgstr "  His face turned wry as he objected, to which Aoko frowned."

#. Occurrence 5A_4:3846:4791: scene=5A_4
#: 5A_4:3846
msgctxt "text_id=4791 | speaker=unknown"
msgid "投げやりになっていても、自分の気持ちに素直な少年だった。"
msgstr "As nonchalant as he could be, he was honest about his feelings."

#. Occurrence 5A_4:3901:4792: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0008; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3901
msgctxt "text_id=4792 | speaker=aoko"
msgid "「そりゃ恐いでしょう。私だって恐いと思うし。"
msgstr "\"Of course that would be scary. I'd be scared, too, you know."

#. Occurrence 5A_4:3907:4793: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0009; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3907
msgctxt "text_id=4793 | speaker=aoko"
msgid "　でも悪いわね、我慢して。"
msgstr "  Sorry, though. You'll just need to deal with it."

#. Occurrence 5A_4:3913:4794: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0010; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3913
msgctxt "text_id=4794 | speaker=aoko"
msgid "　人でなしと<罵|ののし>ってくれて結構よ。今の私は本当にその通りだから。"
msgstr "  It's okay if you call me a monster. That's exactly what I am right now."

#. Occurrence 5A_4:3930:4795: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0011; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:3930
msgctxt "text_id=4795 | speaker=aoko"
msgid "……"
msgstr "..."

msgctxt "text_id=4796 | speaker=unknown"
msgid "そういった意味じゃアンタと同じ。普通の道徳がないのよ。だから、必要なら人も殺せる」"
msgstr " I guess in that way I'm just like you. I don't have what you would call normal morals. Helps when I need to murder someone.\""

#. Occurrence 5A_4:3961:4797: scene=5A_4
#: 5A_4:3961
msgctxt "text_id=4797 | speaker=unknown"
msgid "　淡々とした声に、ぴくりと草十郎の指が反応した。"
msgstr "  Soujyuro's finger twitched in response to her indifferent tone."

#. Occurrence 5A_4:3966:4798: scene=5A_4
#: 5A_4:3966
msgctxt "text_id=4798 | speaker=unknown"
msgid "　何もかも諦めていた彼の体が、今の言葉は聞き流せないと言うように。"
msgstr "  As if to say that, despite having given up on just about everything, his body could not let those words slide."

#. Occurrence 5A_4:4022:4799: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0020; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:4022
msgctxt "text_id=4799 | speaker=soujuurou"
msgid "「人殺しなんて、よくないぞ」"
msgstr "\"Murder is wrong, you know.\""

#. Occurrence 5A_4:4028:4800: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0012; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:4028
msgctxt "text_id=4800 | speaker=aoko"
msgid "「分かってるって言ってるでしょ」"
msgstr "\"We went through this. I know that already.\""

#. Occurrence 5A_4:4039:4801: scene=5A_4
#: 5A_4:4039
msgctxt "text_id=4801 | speaker=unknown"
msgid "　青子の右腕が掲げられる。"
msgstr "  Aoko raised her right hand."

#. Occurrence 5A_4:4044:4802: scene=5A_4
#: 5A_4:4044
msgctxt "text_id=4802 | speaker=unknown"
msgid "　刻印の光が顔を照らす。"
msgstr "  The light from the crest illuminated her face."

#. Occurrence 5A_4:4131:4803: scene=5A_4
#: 5A_4:4131
msgctxt "text_id=4803 | speaker=unknown"
msgid "　言うまでもなく、彼女の顔はいつも通りだ。"
msgstr "  It goes without saying that her expression was unchanged."

#. Occurrence 5A_4:4136:4804: scene=5A_4
#: 5A_4:4136
msgctxt "text_id=4804 | speaker=unknown"
msgid "　泣き顔でもなく笑顔でもない。"
msgstr "  She was not crying, nor was she smiling."

#. Occurrence 5A_4:4141:4805: scene=5A_4
#: 5A_4:4141
msgctxt "text_id=4805 | speaker=unknown"
msgid "　感情を<排|はい>した、どこにでもいる一人の少女。"
msgstr "  She was a young woman who had excised her feelings."

#. Occurrence 5A_4:4146:4806: scene=5A_4
#: 5A_4:4146
msgctxt "text_id=4806 | speaker=unknown"
msgid "　……我慢して、なんてとんでもない。"
msgstr "  ...\"Deal with it\" was another thing Soujyuro could not let slide."

#. Occurrence 5A_4:4151:4807: scene=5A_4
#: 5A_4:4151
msgctxt "text_id=4807 | speaker=unknown"
msgid "　普段の青子を知る草十郎にとって、それは、どんな<表|か><情|お>より<辛|つら>く映った。"
msgstr "  Soujyuro could read on Aoko's face that she was not herself. She was in pain, and to a degree he had never seen in her."

#. Occurrence 5A_4:4276:4808: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0021; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:4276
msgctxt "text_id=4808 | speaker=soujuurou"
msgid "「……すまない。ちょっと、いいかな」"
msgstr "\"...Sorry, but I guess I do have something to say.\""

#. Occurrence 5A_4:4282:4809: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0013; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:4282
msgctxt "text_id=4809 | speaker=aoko"
msgid "「なに？　ここまで<悲愴感|ひそうかん>を盛り上げておいて、やっぱり逃げるなんてのは却下よ」"
msgstr "\"What is it? But don't think you can trick me into letting you go by making me feel bad.\""

#. Occurrence 5A_4:4307:4810: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0022; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:4307
msgctxt "text_id=4810 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5A_4:4313:4811: scene=5A_4
#: 5A_4:4313
msgctxt "text_id=4811 | speaker=unknown"
msgid "　容赦のない青子の切り返しに、彼はつい頬を<緩|ゆる>ませた。"
msgstr "  He unconsciously smiled at Aoko's ruthless counter and breathed a sigh of relief."

#. Occurrence 5A_4:4318:4812: scene=5A_4
#: 5A_4:4318
msgctxt "text_id=4812 | speaker=unknown"
msgid "　ほっと息をつくように。さきほど見えた辛さは勘違いで、青子はやっぱり青子だった。"
msgstr "  He had misread the pain he saw in her face. This was the same Aoko."

#. Occurrence 5A_4:4323:4813: scene=5A_4
#: 5A_4:4323
msgctxt "text_id=4813 | speaker=unknown"
msgid "　それが嬉しくて草十郎は笑ったのだが、言うまでもなく、彼以外には真逆に見える笑いだった。"
msgstr "  Soujyuro laughed out loud in genuine joy, a laugh that most other people would have taken as an insult."

#. Occurrence 5A_4:4401:4814: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0014; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:4401
msgctxt "text_id=4814 | speaker=aoko"
msgid "「……<遺言|ゆいごん>でも聞いてあげようと思った私が甘かった。"
msgstr "\"I'm starting to regret letting you say your piece."

#. Occurrence 5A_4:4407:4815: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0015; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:4407
msgctxt "text_id=4815 | speaker=aoko"
msgid "　っていうか、今の小馬鹿にした笑いがアンタの遺言ってコトでオッケー？」"
msgstr "  Or should I take that attempt to make fun of me as just that?\""

#. Occurrence 5A_4:4458:4816: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_4_0023; voice_prefix=A30; voice_category=3; scene=5A_4
#: 5A_4:4458
msgctxt "text_id=4816 | speaker=soujuurou"
msgid "「いや、そうじゃなくて。あそこにいる人は、蒼崎の友人なのか？」"
msgstr "\"No, I'm not laughing at you. I was just wondering if that person over there was a friend of yours, Aozaki.\""

#. Occurrence 5A_4:4464:4817: scene=5A_4
#: 5A_4:4464
msgctxt "text_id=4817 | speaker=unknown"
msgid "　つい、と指で青子の背後を指す草十郎。"
msgstr "  Out of nowhere, Soujyuro pointed behind Aoko."

#. Occurrence 5A_4:4523:4818: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0016; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:4523
msgctxt "text_id=4818 | speaker=aoko"
msgid "「はあ？」"
msgstr "\"What?\""

#. Occurrence 5A_4:4529:4819: scene=5A_4
#: 5A_4:4529
msgctxt "text_id=4819 | speaker=unknown"
msgid "　使い古された手だと青子は思った。"
msgstr "  Aoko thought that it must have been that old, overused distraction technique."

#. Occurrence 5A_4:4535:4820: scene=5A_4
#: 5A_4:4535
msgctxt "text_id=4820 | speaker=unknown"
msgid "ここがステージならハリセンでダメ出しも辞さないところだ。"
msgstr "If this had been a Japanese comedy act, this would be the part where she gave him a whack with a paper fan."

#. Occurrence 5A_4:4535:4821: scene=5A_4
#: 5A_4:4535
msgctxt "text_id=4821 | speaker=unknown"
msgid "　……しかし草十郎にそんな雰囲気はないし、そもそもこの男には<流行|はやり>も古いもなかった、と思い直す。"
msgstr "  But after giving it a second thought, she realized Soujyuro didn't have the capacity for understanding old, or even new, tricks."

#. Occurrence 5A_4:4652:4822: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_4_0017; voice_prefix=A10; voice_category=1; scene=5A_4
#: 5A_4:4652
msgctxt "text_id=4822 | speaker=aoko"
msgid "「アンタ、なに言って―――」"
msgstr "\"What are you...\""

#. Occurrence 5A_4:4658:4823: scene=5A_4
#: 5A_4:4658
msgctxt "text_id=4823 | speaker=unknown"
msgid "　なんだかんだと律儀な性格が幸いしたのか。"
msgstr "  Perhaps his honest disposition had been to his benefit."

#. Occurrence 5A_4:4663:4824: scene=5A_4
#: 5A_4:4663
msgctxt "text_id=4824 | speaker=unknown"
msgid "　つい気になって、指差された背後に目を向ける青子。"
msgstr "  Without thinking, Aoko gave in to her curiosity and turned her gaze toward the direction in which his finger was pointed."

#. Occurrence 5A_4:4668:4825: scene=5A_4
#: 5A_4:4668
msgctxt "text_id=4825 | speaker=unknown"
msgid "　―――そこには、"
msgstr "  And there..."

#. Occurrence 5A_4:4758:4826: scene=5A_4
#: 5A_4:4758
msgctxt "text_id=4826 | speaker=unknown"
msgid "　ぎい、と。"
msgstr "  Something that should not have been there in the maze. Something with a creaking, wooden smile..."

#. Occurrence 5A_4:4766:4827: scene=5A_4
#: 5A_4:4766
msgctxt "text_id=4827 | speaker=unknown"
msgid "　この迷路には無い木製の<笑顔|きしみ>をあげる、不吉で不気味な“彼女”の姿が―――"
msgstr "  It was the ominous, creepy, uncanny figure of a girl."

#. Occurrence 5A_5:116:4828: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0000; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:116
msgctxt "text_id=4828 | speaker=aoko"
msgid "「―――人、形……？」"
msgstr "\"A... puppet?\""

#. Occurrence 5A_5:122:4829: scene=5A_5
#: 5A_5:122
msgctxt "text_id=4829 | speaker=unknown"
msgid "　暗がりに<仄|ほの>浮かぶ<二|ヒ><足|ト><二|ガ><手|タ>の異形。"
msgstr "  An unusual figure with two arms and two legs stood silently in the darkness."

#. Occurrence 5A_5:127:4830: scene=5A_5
#: 5A_5:127
msgctxt "text_id=4830 | speaker=unknown"
msgid "　その、物言わぬ<佇|たたず>まいと、遠目からでも分かる造りの美しさが、事の異常性を一瞬だけ漂白し―――"
msgstr "  If only for a moment, its beauty―which was even apparent from afar―dulled the insanity of the current situation."

#. Occurrence 5A_5:293:4831: scene=5A_5
#: 5A_5:293
msgctxt "text_id=4831 | speaker=unknown"
msgid "　伸びる。伸びる。伸びる。"
msgstr "  Extend. Extend. Extend."

#. Occurrence 5A_5:298:4832: scene=5A_5
#: 5A_5:298
msgctxt "text_id=4832 | speaker=unknown"
msgid "　その、あまりの“未知”に青子の思考は停止した。"
msgstr "  The utterly unknown threat made Aoko freeze on the spot."

#. Occurrence 5A_5:303:4833: scene=5A_5
#: 5A_5:303
msgctxt "text_id=4833 | speaker=unknown"
msgid "　避ける、という選択が浮かばない。人間は知性、知識がある故に、“初めて見る”ものに<鈍感|どんかん>で―――"
msgstr "  Avoiding it didn't even occur to her. Humans possess intelligence and knowledge, but when confronted with the unknown, they fail to process what to do, and―"

#. Occurrence 5A_5:393:4834: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0001; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:393
msgctxt "text_id=4834 | speaker=aoko"
msgid "「っ、ぁあぁあ――――――！！！！」"
msgstr "\"AaaAAAhhhHHH!!!\""

#. Occurrence 5A_5:399:4835: scene=5A_5
#: 5A_5:399
msgctxt "text_id=4835 | speaker=unknown"
msgid "　青子の口から悲鳴がこぼれる。"
msgstr "  A shriek escaped Aoko's mouth."

#. Occurrence 5A_5:404:4836: scene=5A_5
#: 5A_5:404
msgctxt "text_id=4836 | speaker=unknown"
msgid "　十メートル以上の距離を無視した魔の一撃。"
msgstr "  The magical attack crossed the thirty-foot gap in an instant."

#. Occurrence 5A_5:409:4837: scene=5A_5
#: 5A_5:409
msgctxt "text_id=4837 | speaker=unknown"
msgid "　奥の通路に現れた“彼女”の腕は細く速く、どこまでも長く伸び、青子の背中を<撃|う>ち<捉|とら>えた。"
msgstr "  The arm of the \"girl\" who had appeared at the rear of the corridor was slender and quick. It extended to a near-impossible length, striking Aoko from behind."

#. Occurrence 5A_5:488:4838: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0002; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:488
msgctxt "text_id=4838 | speaker=aoko"
msgid "「っ―――！」"
msgstr "\"Gnnngh!\""

#. Occurrence 5A_5:495:4839: scene=5A_5
#: 5A_5:495
msgctxt "text_id=4839 | speaker=unknown"
msgid "　青子は壁に激突しつつも、苦悶の声を飲みくだす。"
msgstr "  Aoko crashed into the wall as she fought back an anguished whimper."

#. Occurrence 5A_5:500:4840: scene=5A_5
#: 5A_5:500
msgctxt "text_id=4840 | speaker=unknown"
msgid "　一方、伸びきった腕は速やかに“彼女”へと戻っていく。"
msgstr "  The attacker retracted her arm."

#. Occurrence 5A_5:606:4841: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_5_0000; voice_prefix=A30; voice_category=3; scene=5A_5
#: 5A_5:606
msgctxt "text_id=4841 | speaker=soujuurou"
msgid "「蒼崎！」"
msgstr "\"Aozaki!\""

#. Occurrence 5A_5:652:4842: scene=5A_5
#: 5A_5:652
msgctxt "text_id=4842 | speaker=unknown"
msgid "　草十郎はすぐさま立ち上がっていた。"
msgstr "  Soujyuro sprang to his feet."

#. Occurrence 5A_5:657:4843: scene=5A_5
#: 5A_5:657
msgctxt "text_id=4843 | speaker=unknown"
msgid "　手足をついて咳きこむ青子に駆け寄ると、力任せに立ち上がらせ―――"
msgstr "  He darted to her side and used all the strength he could muster to get her to her feet."

#. Occurrence 5A_5:710:4844: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_5_0001; voice_prefix=A30; voice_category=3; scene=5A_5
#: 5A_5:710
msgctxt "text_id=4844 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5A_5:716:4845: scene=5A_5
#: 5A_5:716
msgctxt "text_id=4845 | speaker=unknown"
msgid "　その軽さに、少し戸惑う。"
msgstr "  He could not believe how light she was."

#. Occurrence 5A_5:721:4846: scene=5A_5
#: 5A_5:721
msgctxt "text_id=4846 | speaker=unknown"
msgid "　草十郎にとって、蒼崎青子は普段から凛としていて、中身がぎゅっと詰まっているイメージだった。"
msgstr "  In Soujyuro's mind, Aoko was an extraordinary individual."

#. Occurrence 5A_5:726:4847: scene=5A_5
#: 5A_5:726
msgctxt "text_id=4847 | speaker=unknown"
msgid "　だからきっと、<触|ふ>れた時は自分なんかより確かな力強さがあると思ったのだ。"
msgstr "  He'd expected that if he were to ever touch her, it would be apparent she was far stronger than he."

#. Occurrence 5A_5:732:4848: scene=5A_5
#: 5A_5:732
msgctxt "text_id=4848 | speaker=unknown"
msgid "けれど実際は四十五キロ程度の、少女として当たり前の重さだった。"
msgstr "But in reality, she felt about as heavy as you would expect a hundred-pound girl to feel."

#. Occurrence 5A_5:829:4849: scene=5A_5
#: 5A_5:829
msgctxt "text_id=4849 | speaker=unknown"
msgid "　……一方。"
msgstr "  Meanwhile,"

#. Occurrence 5A_5:834:4850: scene=5A_5
#: 5A_5:834
msgctxt "text_id=4850 | speaker=unknown"
msgid "　どのような<機巧|カラクリ>か、“彼女”は伸びきった腕を収納していく。"
msgstr "  that thing continued to reel in its arm, as if it were some sort of mechanism."

#. Occurrence 5A_5:839:4851: scene=5A_5
#: 5A_5:839
msgctxt "text_id=4851 | speaker=unknown"
msgid "　十メートル以上伸びた腕、何倍にも増設された<肘|ひじ>関節が、カシャンカシャンと元の<形状|おおきさ>に戻っていく。"
msgstr "  Having extended more than thirty feet from the elbow joint, it clanked as it returned to its previous shape and size."

#. Occurrence 5A_5:934:4852: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_5_0002; voice_prefix=A30; voice_category=3; scene=5A_5
#: 5A_5:934
msgctxt "text_id=4852 | speaker=soujuurou"
msgid "「大丈夫か？」"
msgstr "\"Are you okay?\""

#. Occurrence 5A_5:1030:4853: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0003; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:1030
msgctxt "text_id=4853 | speaker=aoko"
msgid "「……やめてよ。分からないわ、なんでそんな顔できるの」"
msgstr "\"...Are you for real? How can you even look at me like that right now?\""

#. Occurrence 5A_5:1085:4854: scene=5A_5
#: 5A_5:1085
msgctxt "text_id=4854 | speaker=unknown"
msgid "　呟きながら草十郎の手から離れる青子。"
msgstr "  Aoko tore her hand away from Soujyuro's."

#. Occurrence 5A_5:1090:4855: scene=5A_5
#: 5A_5:1090
msgctxt "text_id=4855 | speaker=unknown"
msgid "　途端、がくんと膝から倒れこんだが、彼女が膝をつくより早く、草十郎は肩を貸して立ちあがらせていた。"
msgstr "  Suddenly, she felt her knees buckle from under her, but Soujyuro caught her before she could hit the ground and helped her to her feet."

#. Occurrence 5A_5:1111:4856: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_5_0003; voice_prefix=A30; voice_category=3; scene=5A_5
#: 5A_5:1111
msgctxt "text_id=4856 | speaker=soujuurou"
msgid "「無理するな。……で、あいつは知り合いか？」"
msgstr "\"Don't push yourself too hard. ...So, do you know this thing?\""

#. Occurrence 5A_5:1174:4857: scene=5A_5
#: 5A_5:1174
msgctxt "text_id=4857 | speaker=unknown"
msgid "　草十郎は十メートル向こう、不気味に<佇|たたず>む人影を見据えている。伸びきった腕は、あと少しで完全に収納されようとしていた。"
msgstr "  He looked back at the eerie shadow thirty feet away as it finished retracting its arm."

#. Occurrence 5A_5:1181:4858: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0004; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:1181
msgctxt "text_id=4858 | speaker=aoko"
msgid "「……そうね。似たような奴とは命を<鬩|せめ>ぎ合った仲よ」"
msgstr "\"...Yeah. I fought one of its friends a while back.\""

#. Occurrence 5A_5:1201:4859: scene=5A_5
#: 5A_5:1201
msgctxt "text_id=4859 | speaker=unknown"
msgid "　青子は答えながら、自身の背中に指をはわせた。"
msgstr "  Aoko grabbed her lower back as she answered."

#. Occurrence 5A_5:1262:4860: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0005; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:1262
msgctxt "text_id=4860 | speaker=aoko"
msgid "「っ……！」"
msgstr "\"Aaah!\""

#. Occurrence 5A_5:1267:4861: scene=5A_5
#: 5A_5:1267
msgctxt "text_id=4861 | speaker=unknown"
msgid "　途端、火で<炙|あぶ>られるような痛みが走る。"
msgstr "  A searing pain shot through her."

#. Occurrence 5A_5:1332:4862: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0006; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:1332
msgctxt "text_id=4862 | speaker=aoko"
msgid "“っ……でも、痛いっちゃあ痛いけど、打撲だけ……？"
msgstr "\"It's just a bruise. How can it hurt THIS much?"

#. Occurrence 5A_5:1338:4863: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0007; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:1338
msgctxt "text_id=4863 | speaker=aoko"
msgid "　あれだけ絶好の奇襲をしておいて？　それとも、この距離じゃ当たっても致命傷にならない？"
msgstr "  It could have killed me, catching me off guard like that. Or maybe it can't kill from that distance...?"

#. Occurrence 5A_5:1345:4864: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0008; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:1345
msgctxt "text_id=4864 | speaker=aoko"
msgid "　……なんて、あるワケないか。なにか別の意味があると見るべきね―――”"
msgstr "  No, that can't be it. I must be missing something...\""

#. Occurrence 5A_5:1372:4865: scene=5A_5
#: 5A_5:1372
msgctxt "text_id=4865 | speaker=unknown"
msgid "　背中の<損傷|ダメージ>を量りながら、乱れた呼吸を整える青子。"
msgstr "  Aoko tried to steady her breathing as she assessed the damage done to her back."

#. Occurrence 5A_5:1377:4866: scene=5A_5
#: 5A_5:1377
msgctxt "text_id=4866 | speaker=unknown"
msgid "　痛みも呼吸もすぐに治まった。"
msgstr "  The pain was quick to fade and her breathing returned to normal."

#. Occurrence 5A_5:1382:4867: scene=5A_5
#: 5A_5:1382
msgctxt "text_id=4867 | speaker=unknown"
msgid "　あくまで今のところではあるが、運動機能に支障はない。"
msgstr "  For the time being, her motor functions were no longer hindered."

#. Occurrence 5A_5:1388:4868: scene=5A_5
#: 5A_5:1388
msgctxt "text_id=4868 | speaker=unknown"
msgid "　となると、深刻なダメージと言えるのは―――"
msgstr "  Which meant the real damage was elsewhere..."

#. Occurrence 5A_5:1548:4869: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_5_0004; voice_prefix=A30; voice_category=3; scene=5A_5
#: 5A_5:1548
msgctxt "text_id=4869 | speaker=soujuurou"
msgid "「あ、蒼崎、アレ！」"
msgstr "\"Ah, Aozaki! You're―\""

#. Occurrence 5A_5:1561:4870: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0009; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:1561
msgctxt "text_id=4870 | speaker=aoko"
msgid "「分かってるわ、黙ってて」"
msgstr "\"Ugh, I know. Just shut up already.\""

#. Occurrence 5A_5:1641:4871: scene=5A_5
#: 5A_5:1641
msgctxt "text_id=4871 | speaker=unknown"
msgid "　<薄闇|うすやみ>に青い光がともる。"
msgstr "  Blue light glowed across the gloom."

#. Occurrence 5A_5:1646:4872: scene=5A_5
#: 5A_5:1646
msgctxt "text_id=4872 | speaker=unknown"
msgid "　青子の呼吸に連動して生成された魔力が、その右腕に集められる。"
msgstr "  The magical energy generated by her breathing was accumulating in her right arm."

#. Occurrence 5A_5:1738:4873: scene=5A_5
#: 5A_5:1738
msgctxt "text_id=4873 | speaker=unknown"
msgid "　魔力が燃料なら、術式は点火装置だ。"
msgstr "  If magical energy was the fuel, the formula was the igniter."

#. Occurrence 5A_5:1743:4874: scene=5A_5
#: 5A_5:1743
msgctxt "text_id=4874 | speaker=unknown"
msgid "　青子にとって、これは二日前の夜の再現にすぎない。"
msgstr "  For Aoko, this was little more than a reenactment of two evenings ago."

#. Occurrence 5A_5:1748:4875: scene=5A_5
#: 5A_5:1748
msgctxt "text_id=4875 | speaker=unknown"
msgid "　あの人形が腕を伸ばしてきた時、最速で術式を走らせ、生成した<魔|た><力|ま>を弾く。"
msgstr "  Next time the puppet extended its arm, Aoko would fire a magic bullet as fast as she could."

#. Occurrence 5A_5:1779:4876: scene=5A_5
#: 5A_5:1779
msgctxt "text_id=4876 | speaker=unknown"
msgid "　およそ十メートルの格闘戦。"
msgstr "  A battle at approximately thirty feet."

#. Occurrence 5A_5:1784:4877: scene=5A_5
#: 5A_5:1784
msgctxt "text_id=4877 | speaker=unknown"
msgid "　生死を分かつクロスカウンターだが、二秒の隙間があるのなら青子でも合わせられる。"
msgstr "  As long as Aoko could secure a two-second window, she could create a counterattack to end their duel."

#. Occurrence 5A_5:1832:4878: scene=5A_5
#: 5A_5:1832
msgctxt "text_id=4878 | speaker=unknown"
msgid "“彼女”が動く。"
msgstr "  It made its move."

#. Occurrence 5A_5:1838:4879: scene=5A_5
#: 5A_5:1838
msgctxt "text_id=4879 | speaker=unknown"
msgid "　<俯|うつむ>いているので<表|か><情|お>は見えず、この距離、この暗さでは肉体年齢も判別できない。"
msgstr "  With its head tilted down, there was no expression to be seen. And in the darkness, its apparent age was impossible to make out."

#. Occurrence 5A_5:1843:4880: scene=5A_5
#: 5A_5:1843
msgctxt "text_id=4880 | speaker=unknown"
msgid "　青子たちにとって、人形はいまだ正体のない亡霊と変わらない。"
msgstr "  To the two humans, the puppet was not dissimilar to a faceless ghost."

#. Occurrence 5A_5:1892:4881: scene=5A_5
#: 5A_5:1892
msgctxt "text_id=4881 | speaker=unknown"
msgid "　キリキリと音をたてて左腕が持ち上がる。"
msgstr "  Its left arm slowly came up with a grinding sound."

#. Occurrence 5A_5:1897:4882: scene=5A_5
#: 5A_5:1897
msgctxt "text_id=4882 | speaker=unknown"
msgid "　<緩慢|かんまん>な、関節が<錆|さ>びきったような動作。"
msgstr "  Its movements were dull, as if the joints were rusty."

#. Occurrence 5A_5:1940:4883: scene=5A_5
#: 5A_5:1940
msgctxt "text_id=4883 | speaker=unknown"
msgid "　先ほど伸びた右腕は下げられている。"
msgstr "  The right arm, which had been extended earlier, hung at its side."

#. Occurrence 5A_5:1980:4884: scene=5A_5
#: 5A_5:1980
msgctxt "text_id=4884 | speaker=unknown"
msgid "　くすりと、長い髪に隠れた口元が笑った気がした。"
msgstr "  Though the puppet's mouth was hidden by its long locks, the sense was that it was smiling."

#. Occurrence 5A_5:2062:4885: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0010; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:2062
msgctxt "text_id=4885 | speaker=aoko"
msgid "“―――<右手|さっき>と用途が違う、<左|アレ>が本命―――！”"
msgstr "\"It's changing it up. It's attacking from the left!\""

#. Occurrence 5A_5:2091:4886: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0011; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:2091
msgctxt "text_id=4886 | speaker=aoko"
msgid "「静希君、どいて……！！」"
msgstr "\"Move it, Sizuki!\""

#. Occurrence 5A_5:2215:4887: scene=5A_5
#: 5A_5:2215
msgctxt "text_id=4887 | speaker=unknown"
msgid "　青子が草十郎を突きとばしつつ右手をなぎ払うのと、"
msgstr "  She threw herself into Soujyuro and extended her hand."

#. Occurrence 5A_5:2215:4888: scene=5A_5
#: 5A_5:2215
msgctxt "text_id=4888 | speaker=unknown"
msgid "“彼女”の左腕が伸びるのは同時だった。"
msgstr "  Its arm extended at that very moment."

#. Occurrence 5A_5:2235:4889: scene=5A_5
#: 5A_5:2235
msgctxt "text_id=4889 | speaker=unknown"
msgid "　タイミングは完璧。"
msgstr "  The timing was impeccable."

#. Occurrence 5A_5:2240:4890: scene=5A_5
#: 5A_5:2240
msgctxt "text_id=4890 | speaker=unknown"
msgid "　一秒の差で青子の<魔弾|スナップ>は人形の<凶|う><器|で>に直撃し、その軌道をズラしながら敵本体に炸裂する。"
msgstr "  In a single second, Aoko's Snap bullet scored a direct hit on the puppet's arm, throwing off its trajectory and sending it crashing into the puppet's body with a violent explosion."

#. Occurrence 5A_5:2265:4891: scene=5A_5
#: 5A_5:2265
msgctxt "text_id=4891 | speaker=unknown"
msgid "　―――肝心の、魔術式が駆動すればの話だが。"
msgstr "  ...Or at least, that is what would have happened had the magic formula been invoked."

#. Occurrence 5A_5:2525:4892: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0012; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:2525
msgctxt "text_id=4892 | speaker=aoko"
msgid "「ッ―――！？」"
msgstr "\"Huh?!\""

#. Occurrence 5A_5:2531:4893: scene=5A_5
#: 5A_5:2531
msgctxt "text_id=4893 | speaker=unknown"
msgid "　撃ち出された腕を紙一重でかわす青子。"
msgstr "  She barely avoided being struck once again."

#. Occurrence 5A_5:2536:4894: scene=5A_5
#: 5A_5:2536
msgctxt "text_id=4894 | speaker=unknown"
msgid "　魔術は発動しなかったが、相手の攻撃をかわせたのはここ一番の<勘|かん>の良さか。"
msgstr "  When her magecraft failed her, intuition took over, and she just managed to get away."

#. Occurrence 5A_5:2587:4895: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0013; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:2587
msgctxt "text_id=4895 | speaker=aoko"
msgid "“やられた、最初のはそういうコトか……！”"
msgstr "\"She got me! She knew what I was going to do!\""

#. Occurrence 5A_5:2593:4896: scene=5A_5
#: 5A_5:2593
msgctxt "text_id=4896 | speaker=unknown"
msgid "　こんちくしょう、と歯がみしつつ青子は思考を巡らせた。"
msgstr "  She clenched her teeth in frustration, her thoughts racing a mile a minute."

#. Occurrence 5A_5:2598:4897: scene=5A_5
#: 5A_5:2598
msgctxt "text_id=4897 | speaker=unknown"
msgid "　<走|せ>るべきか、<退|ひ>くべきか。"
msgstr "  Fight or flight?"

#. Occurrence 5A_5:2603:4898: scene=5A_5
#: 5A_5:2603
msgctxt "text_id=4898 | speaker=unknown"
msgid "　残る腕は一本。人形の腕は巻き戻しに時間がかかる。"
msgstr "  It only had one arm left, which would take time to retract."

#. Occurrence 5A_5:2608:4899: scene=5A_5
#: 5A_5:2608
msgctxt "text_id=4899 | speaker=unknown"
msgid "　言うまでもなく好機。やるのなら今だ。"
msgstr "  This was the best shot Aoko had at defeating it."

#. Occurrence 5A_5:2613:4900: scene=5A_5
#: 5A_5:2613
msgctxt "text_id=4900 | speaker=unknown"
msgid "　右腕だけならもう一度ギリギリでかわして、とにかく近づいてしまえば―――"
msgstr "  If she could evade the right arm just a fraction, she could get close enough to..."

#. Occurrence 5A_5:2655:4901: voice_id=C40_5A_5_0000_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:2655
msgctxt "text_id=4901 | speaker=unknown"
msgid "　　“<Vivo in somno. Solitarie putresco in inferis|私は眠りの中で生きている。ひとりきりで土の中で腐っていく。>."
msgstr "                  \"<Vivo in somno. Solitarie putresco in inferis|In slumber, I live. In dirt, I rot, alone>."

#. Occurrence 5A_5:2655:4902: voice_id=C40_5A_5_0000_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:2655
msgctxt "text_id=4902 | speaker=unknown"
msgid "@o<Hic dies meus obitus dies, et meus nativus dies. Te obeam.|今日は私の命日であり、誕生日だ。さあ、貴方に会いに行こう。>”"
msgstr "      <Hic dies meus obitus dies, et meus nativus dies. Te obeam.|Today is the day I died and was born. I come to you.>\""

#. Occurrence 5A_5:2690:4903: scene=5A_5
#: 5A_5:2690
msgctxt "text_id=4903 | speaker=unknown"
msgid "　がさついた音が<木霊|こだま>する。"
msgstr "  A crackle echoed through the corridor."

#. Occurrence 5A_5:2695:4904: scene=5A_5
#: 5A_5:2695
msgctxt "text_id=4904 | speaker=unknown"
msgid "　<詩文|しぶん>めいた<囁|ささや>きは、魔術師なら視覚できるほどの魔力の<残|の><留|こ><思|り><念|び>だった。"
msgstr "  The poetic murmurs contained enough magical energy for a mage to perceive."

#. Occurrence 5A_5:2700:4905: scene=5A_5
#: 5A_5:2700
msgctxt "text_id=4905 | speaker=unknown"
msgid "　唄い文句こそラテン語だが、ところどころに<呪詛|ガンド>の韻が含まれている。"
msgstr "  The verse itself was Latin, but it contained hints of the language of curses―Gandr."

#. Occurrence 5A_5:2705:4906: scene=5A_5
#: 5A_5:2705
msgctxt "text_id=4906 | speaker=unknown"
msgid "　本来なら憎い相手を<呪|のろ>う言葉。"
msgstr "  Originally, they were words meant to curse a hated adversary."

#. Occurrence 5A_5:2710:4907: scene=5A_5
#: 5A_5:2710
msgctxt "text_id=4907 | speaker=unknown"
msgid "　それを、"
msgstr "  However..."

#. Occurrence 5A_5:2765:4908: voice_id=C40_5A_5_0001_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:2765
msgctxt "text_id=4908 | speaker=unknown"
msgid "“<Mea anima immortalis. Autem mea futura necata sunt|私の命は不滅ですが、私の未来は殺されました。>."
msgstr "              \"<Mea anima immortalis. Autem mea futura necata sunt|My life is immortal, though my future was destroyed.>."

#. Occurrence 5A_5:2765:4909: voice_id=C40_5A_5_0001_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:2765
msgctxt "text_id=4909 | speaker=unknown"
msgid "　　　<Manes sum. Animam definire ambiguum est|私は亡霊です。生命の定義はあやふやです。>."
msgstr "                    <Manes sum. Animam definire ambiguum est|I am a ghost. The definition of life is ethereal.>."

#. Occurrence 5A_5:2765:4910: voice_id=C40_5A_5_0001_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:2765
msgctxt "text_id=4910 | speaker=unknown"
msgid "　　<Te odi, et te amo. Conveniamus in somnio ipso.|憎らしい、愛おしい貴方。どうか、夢で会いましょう。>”"
msgstr "                <Te odi, et te amo. Conveniamus in somnio ipso.|I hate you. I love you. Let us meet in a dream.>\""

#. Occurrence 5A_5:2812:4911: scene=5A_5
#: 5A_5:2812
msgctxt "text_id=4911 | speaker=unknown"
msgid "　……それを、あの人形は自分自身に向けていた。"
msgstr "  ...The puppet was directing the words at itself."

#. Occurrence 5A_5:2817:4912: scene=5A_5
#: 5A_5:2817
msgctxt "text_id=4912 | speaker=unknown"
msgid "　呪いは呪いを生む。被害者は加害者を呪い返す事で、負の連鎖を回していく。"
msgstr "  Curses beget curses. The victim calls down a curse on the assailant, creating a vicious cycle of negativity."

#. Occurrence 5A_5:2837:4913: scene=5A_5
#: 5A_5:2837
msgctxt "text_id=4913 | speaker=unknown"
msgid "　……あの詠唱はそのサイクルを利用したものだ。"
msgstr "  The incantation was meant to do just that."

#. Occurrence 5A_5:2842:4914: scene=5A_5
#: 5A_5:2842
msgctxt "text_id=4914 | speaker=unknown"
msgid "　ただしあくまで一人芝居。"
msgstr "  However, this was ultimately a one-puppet show."

#. Occurrence 5A_5:2847:4915: scene=5A_5
#: 5A_5:2847
msgctxt "text_id=4915 | speaker=unknown"
msgid "　自家中毒にも似た異例の動力源。"
msgstr "  An unprecedented source of power akin to autointoxication."

#. Occurrence 5A_5:2852:4916: scene=5A_5
#: 5A_5:2852
msgctxt "text_id=4916 | speaker=unknown"
msgid "　信じがたい事だが―――アレは呪い呪われる事で、一定の<動力|まりょく>を維持し続ける永久機関……！"
msgstr "  As unbelievable as it seemed, the cycle of curses had been turned into a perpetual motion device."

#. Occurrence 5A_5:2929:4917: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0014; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:2929
msgctxt "text_id=4917 | speaker=aoko"
msgid "「なにそれ、レベル高すぎじゃない……！？」"
msgstr "\"You've got to be kidding me. Isn't this overkill!?\""

#. Occurrence 5A_5:2989:4918: scene=5A_5
#: 5A_5:2989
msgctxt "text_id=4918 | speaker=unknown"
msgid "　青子は徹底抗戦の選択肢を切り捨てた。"
msgstr "  Aoko abandoned the idea of digging her heels in."

#. Occurrence 5A_5:2994:4919: scene=5A_5
#: 5A_5:2994
msgctxt "text_id=4919 | speaker=unknown"
msgid "　反撃はせず、最速で身をひるがえす。"
msgstr "  It was time to flee with all due haste."

#. Occurrence 5A_5:3075:4920: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_5_0015; voice_prefix=A10; voice_category=1; scene=5A_5
#: 5A_5:3075
msgctxt "text_id=4920 | speaker=aoko"
msgid "「なにしてんの、アンタも来る！」"
msgstr "\"What do you think you're doing?! Come on!\""

#. Occurrence 5A_5:3101:4921: scene=5A_5
#: 5A_5:3101
msgctxt "text_id=4921 | speaker=unknown"
msgid "　急展開に置いてけぼりだった草十郎の手をとって、青子は全力で鏡の国の奥地へと走り出す。"
msgstr "  She grabbed Soujyuro's hand and ran as fast as she could, deeper into the realm of mirrors."

#. Occurrence 5A_5:3119:4922: scene=5A_5
#: 5A_5:3119
msgctxt "text_id=4922 | speaker=unknown"
msgid "　ふたりの背後には、なお続くひび割れた声。"
msgstr "  The crackling voice continued its murmuring behind them."

#. Occurrence 5A_5:3155:4923: voice_id=C40_5A_5_0002_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:3155
msgctxt "text_id=4923 | speaker=unknown"
msgid "“<Proximi mihi neglegentes fuerunt. Omnes nos peccante|隣人は私に無関心でした。私たちは誰もが罪深く、>s"
msgstr "    \"<Proximi mihi neglegentes fuerunt. Omnes nos peccantes fuimus|My neighbors neglected me.>,"

#. Occurrence 5A_5:3155:4924: voice_id=C40_5A_5_0002_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:3155
msgctxt "text_id=4924 | speaker=unknown"
msgid "<fuimus, et omnes nos eidem fuimus, omnes nos peccatore|同類でした。私たちは罪人です。>s"
msgstr "        <et omnes nos eidem fuimus, omnes nos peccatores sumus|Not an innocent among us, we are all sinners.>."

#. Occurrence 5A_5:3155:4925: voice_id=C40_5A_5_0002_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:3155
msgctxt "text_id=4925 | speaker=unknown"
msgid "　　<sumus. Venite domum meam. Luto simile somnium|私の家にいらっしゃい。泥のような死を。>,"
msgstr "                    <Venite domum meam. Luto simile somnium|We are all sinners. Welcome to my house.>,"

#. Occurrence 5A_5:3155:4926: voice_id=C40_5A_5_0002_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:3155
msgctxt "text_id=4926 | speaker=unknown"
msgid "　　　　<et pulveri simile cotidianum. Cor privo.|塵となって囁く。この胸を去った心臓を抉り出して、>”"
msgstr "                      <et pulveri simile cotidianum. Cor privo.|May we die a muddy death. From dust to dust. Gouge out my heart.>\""

#. Occurrence 5A_5:3193:4927: voice_id=C40_5A_5_0003_C; voice_prefix=C40; voice_category=0; scene=5A_5
#: 5A_5:3193
msgctxt "text_id=4927 | speaker=unknown"
msgid "　　　　　　　　“「<オマエニ、死ヲ|Te iudico.>」”"
msgstr "                                      \"<Death be upon you.|Te iudico.>\""

#. Occurrence 5A_6:56:4928: scene=5A_6
#: 5A_6:56
msgctxt "text_id=4928 | speaker=unknown"
msgid "　青子は背中の痛みに耐えながら、鏡張りの通路を走る。"
msgstr "  Aoko fought against the pain in her back as she ran through the mirrored corridor."

#. Occurrence 5A_6:61:4929: scene=5A_6
#: 5A_6:61
msgctxt "text_id=4929 | speaker=unknown"
msgid "　その手に引かれておまけ状態の草十郎も走る。"
msgstr "  She dragged Soujyuro by the hand."

#. Occurrence 5A_6:147:4930: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0000; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:147
msgctxt "text_id=4930 | speaker=soujuurou"
msgid "「蒼崎、傷は？」"
msgstr "\"Aozaki, are you okay?\""

#. Occurrence 5A_6:154:4931: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0000; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:154
msgctxt "text_id=4931 | speaker=aoko"
msgid "「……べつに、背骨が<痺|しび>れてる程度よ。内臓は平気だし、出血もないみたい」"
msgstr "\"...My spine is numb, but it could be worse. My internal organs seem fine, and I don't think I'm bleeding internally.\""

#. Occurrence 5A_6:160:4932: scene=5A_6
#: 5A_6:160
msgctxt "text_id=4932 | speaker=unknown"
msgid "　ま、肝心の<神経|かいろ>はズタズタだけど、と内心呟く青子。"
msgstr "  She cursed inwardly at how much of a mess she felt, though."

#. Occurrence 5A_6:167:4933: scene=5A_6
#: 5A_6:167
msgctxt "text_id=4933 | speaker=unknown"
msgid "　草十郎と違い、青子は透明の壁にぶつからない。"
msgstr "  Unlike Soujyuro, Aoko did not run into any transparent walls,"

#. Occurrence 5A_6:172:4934: scene=5A_6
#: 5A_6:172
msgctxt "text_id=4934 | speaker=unknown"
msgid "　目がいいのではなく、ミラーハウスの構造を頭にたたきこんでいるからだ。"
msgstr "  thanks not to superior sight, but rather preparation―she'd hammered the layout of the building into her memory."

#. Occurrence 5A_6:225:4935: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0001; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:225
msgctxt "text_id=4935 | speaker=soujuurou"
msgid "「……平気って、分かるのか？」"
msgstr "\"...You're really okay? How can you tell?\""

#. Occurrence 5A_6:231:4936: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0001; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:231
msgctxt "text_id=4936 | speaker=aoko"
msgid "「そりゃ自分の体だもの。身体管理は基礎中の基礎よ」"
msgstr "\"Because it's my body. One of the first things a mage learns is how to keep track of your body.\""

#. Occurrence 5A_6:259:4937: scene=5A_6
#: 5A_6:259
msgctxt "text_id=4937 | speaker=unknown"
msgid "　恐る恐る訊ねる草十郎と、つまらなそうに答える青子。"
msgstr "  Aoko's matter-of-fact answer contrasted with Soujyuro's nervous questioning."

#. Occurrence 5A_6:264:4938: scene=5A_6
#: 5A_6:264
msgctxt "text_id=4938 | speaker=unknown"
msgid "　左曲がりの回廊は段々と、その直線距離を短くしていた。"
msgstr "  The corridor grew shorter with each and every left turn."

#. Occurrence 5A_6:269:4939: scene=5A_6
#: 5A_6:269
msgctxt "text_id=4939 | speaker=unknown"
msgid "　先ほどまではまっすぐに三十メートル。"
msgstr "  At first, they were able to advance in a straight line for about a hundred feet at a time."

#. Occurrence 5A_6:274:4940: scene=5A_6
#: 5A_6:274
msgctxt "text_id=4940 | speaker=unknown"
msgid "　今では十五メートルほどで曲がり角に突き当たる。"
msgstr "  But by now, they were forced to turn a corner every fifty feet or so."

#. Occurrence 5A_6:330:4941: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0002; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:330
msgctxt "text_id=4941 | speaker=soujuurou"
msgid "「あいつは、あの夜の……？」"
msgstr "\"Is that the one from... the other night?\""

#. Occurrence 5A_6:336:4942: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0002; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:336
msgctxt "text_id=4942 | speaker=aoko"
msgid "「たぶんね。同じタイプだと思う。貴重な<自動人形|オートマタ>を惜し気もなく使い捨てるなんて、よっぽどお金持ちなんだろうけど」"
msgstr "\"Probably the same pattern, at least. Whoever's behind it must be pretty wealthy to be throwing a valuable automaton around like it's a toy.\""

#. Occurrence 5A_6:366:4943: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0003; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:366
msgctxt "text_id=4943 | speaker=soujuurou"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 5A_6:371:4944: scene=5A_6
#: 5A_6:371
msgctxt "text_id=4944 | speaker=unknown"
msgid "　む、と眉間に<皺|しわ>の草十郎。"
msgstr "  Soujyuro furrowed his brows."

#. Occurrence 5A_6:376:4945: scene=5A_6
#: 5A_6:376
msgctxt "text_id=4945 | speaker=unknown"
msgid "　質問にきちんと答えてくれるのはありがたいが、聞けば聞くほど聴き慣れない単語が出てくるのは困りものだ。"
msgstr "  He was grateful that she was answering his questions, but baffled by the strange words she was using."

#. Occurrence 5A_6:476:4946: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0004; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:476
msgctxt "text_id=4946 | speaker=soujuurou"
msgid "「蒼崎、ストップ。もうずいぶん走ったぞ。"
msgstr "\"Hold up, Aozaki. We've been running for a long time."

#. Occurrence 5A_6:482:4947: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0005; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:482
msgctxt "text_id=4947 | speaker=soujuurou"
msgid "　あいつは曲がり<角|かど>一つぶん向こうだ。少し休もう」"
msgstr "  We're a good corner ahead of it. We can afford to rest a moment.\""

#. Occurrence 5A_6:488:4948: scene=5A_6
#: 5A_6:488
msgctxt "text_id=4948 | speaker=unknown"
msgid "　青子の傷を気遣って声をかける。"
msgstr "  His words suggested that he was still concerned about her injuries."

#. Occurrence 5A_6:493:4949: scene=5A_6
#: 5A_6:493
msgctxt "text_id=4949 | speaker=unknown"
msgid "　しかし、彼女は不機嫌そうに首を振った。"
msgstr "  Aoko shook her head in irritation."

#. Occurrence 5A_6:556:4950: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0003; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:556
msgctxt "text_id=4950 | speaker=aoko"
msgid "「あの距離を狙ってくる相手に通路一つ分のリードは無意味よ。せめて二つ分に行くまで走るの」"
msgstr "\"Not enough against something with that kind of range. We need to keep running until we're two or three turns clear, at least.\""

#. Occurrence 5A_6:576:4951: scene=5A_6
#: 5A_6:576
msgctxt "text_id=4951 | speaker=unknown"
msgid "　なるほど、と頷く草十郎。"
msgstr "  Soujyuro nodded."

#. Occurrence 5A_6:581:4952: scene=5A_6
#: 5A_6:581
msgctxt "text_id=4952 | speaker=unknown"
msgid "　と、それはともかくとして、"
msgstr "  With that matter settled, he asked,"

#. Occurrence 5A_6:602:4953: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0006; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:602
msgctxt "text_id=4953 | speaker=soujuurou"
msgid "「なんで俺を連れていってるんだ？」"
msgstr "\"Why didn't you leave me behind?\""

#. Occurrence 5A_6:642:4954: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0004; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:642
msgctxt "text_id=4954 | speaker=aoko"
msgid "「逃げられたくないからじゃない、馬鹿」"
msgstr "\"Why do you think? So you couldn't get away, idiot.\""

#. Occurrence 5A_6:651:4955: scene=5A_6
#: 5A_6:651
msgctxt "text_id=4955 | speaker=unknown"
msgid "　実に簡潔な返答をしつつ、平和ぼけした獲物をむっと睨む青子だった。"
msgstr "  Answering curtly, Aoko glared at her naïve prey."

#. Occurrence 5A_6:752:4956: scene=5A_6
#: 5A_6:752
msgctxt "text_id=4956 | speaker=unknown"
msgid "　ふたりはさらに先の曲がり角へ。"
msgstr "  The two of them headed for the next corner."

#. Occurrence 5A_6:757:4957: scene=5A_6
#: 5A_6:757
msgctxt "text_id=4957 | speaker=unknown"
msgid "　通路二つ分のリードをとって、ようやく足が止められる。"
msgstr "  Their legs began to slow as they rounded one more."

#. Occurrence 5A_6:832:4958: scene=5A_6
#: 5A_6:832
msgctxt "text_id=4958 | speaker=unknown"
msgid "　青子は息を整えながら背中に手を当てた。"
msgstr "  Aoko rubbed her back as she tried to catch her breath."

#. Occurrence 5A_6:837:4959: scene=5A_6
#: 5A_6:837
msgctxt "text_id=4959 | speaker=unknown"
msgid "　先ほどは“ぜんぜん平気”と断言した青子だが、どうも強がりだったらしい。"
msgstr "  Though Aoko had insisted that she was fine, it appeared to have been bravado."

#. Occurrence 5A_6:842:4960: scene=5A_6
#: 5A_6:842
msgctxt "text_id=4960 | speaker=unknown"
msgid "　なぜなら、空気の読めない草十郎にも分かるぐらい空気が重い。"
msgstr "  Even the usually clueless Soujyuro felt the desperation they were in."

#. Occurrence 5A_6:888:4961: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0007; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:888
msgctxt "text_id=4961 | speaker=soujuurou"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 5A_6:893:4962: scene=5A_6
#: 5A_6:893
msgctxt "text_id=4962 | speaker=unknown"
msgid "　そんな青子の後ろで、さて、と腕を組む草十郎。"
msgstr "  He stood behind Aoko with his arms folded."

#. Occurrence 5A_6:898:4963: scene=5A_6
#: 5A_6:898
msgctxt "text_id=4963 | speaker=unknown"
msgid "　鬼の居ぬ間になんとやらで、この隙に、彼は彼なりに現状把握などにトライしてみた。"
msgstr "  While they had a moment, he tried to make sense of everything."

#. Occurrence 5A_6:956:4964: scene=5A_6
#: 5A_6:956
msgctxt "text_id=4964 | speaker=unknown"
msgid "　まず、自分は蒼崎青子に殺されかけた。"
msgstr "  First, Aoko had nearly killed him."

#. Occurrence 5A_6:977:4965: scene=5A_6
#: 5A_6:977
msgctxt "text_id=4965 | speaker=unknown"
msgid "　あわやというところで助けが入ったが、割って入った人物は二日前の夜、青子によって燃やされた『怪奇腕が伸びる人間』だった。"
msgstr "  Though he was saved at the last possible second, it was by the strange, stretchy woman Aoko had burned to ashes two nights prior."

#. Occurrence 5A_6:982:4966: scene=5A_6
#: 5A_6:982
msgctxt "text_id=4966 | speaker=unknown"
msgid "　よく見えなかったが、とりあえず女性っぽかったので彼女と呼称する。"
msgstr "  He could barely make it out that night, but he considered it a \"her\" because it looked female."

#. Occurrence 5A_6:1021:4967: scene=5A_6
#: 5A_6:1021
msgctxt "text_id=4967 | speaker=unknown"
msgid "　その彼女の攻撃で青子は背中を負傷し、一旦逃走。"
msgstr "  The woman's attack wounded Aoko's back and forced her to flee."

#. Occurrence 5A_6:1026:4968: scene=5A_6
#: 5A_6:1026
msgctxt "text_id=4968 | speaker=unknown"
msgid "　その際、なぜか草十郎の手を取ったが、それはどさくさに紛れて<草十郎|エモノ>が逃げ出すのを阻止するため、とのコトだった。"
msgstr "  Aoko had taken Soujyuro with her, claiming that the reason she did so was to prevent her prey from escaping."

#. Occurrence 5A_6:1037:4969: scene=5A_6
#: 5A_6:1037
msgctxt "text_id=4969 | speaker=unknown"
msgid "　つまり―――"
msgstr "  In other words..."

#. Occurrence 5A_6:1068:4970: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0008; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:1068
msgctxt "text_id=4970 | speaker=soujuurou"
msgid "「蒼崎は、まだ<諦|あきら>めてないんだな？」"
msgstr "\"You haven't given up, have you, Aozaki?\""

#. Occurrence 5A_6:1099:4971: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0005; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1099
msgctxt "text_id=4971 | speaker=aoko"
msgid "「あったりまえよ。あんなヤツ、仮に二体と半分始末してもアンタ用の余力は残せるわ」"
msgstr "\"Of course not! Even if I had to face two of those things, I'd still have plenty left to take care of the likes of you.\""

#. Occurrence 5A_6:1105:4972: scene=5A_6
#: 5A_6:1105
msgctxt "text_id=4972 | speaker=unknown"
msgid "　などとタンカをきる青子の表情は、<草十郎|しろうと>目にも厳しい。"
msgstr "  Her tone was sharp, but even Soujyuro could see that she was struggling to stay confident."

#. Occurrence 5A_6:1110:4973: scene=5A_6
#: 5A_6:1110
msgctxt "text_id=4973 | speaker=unknown"
msgid "　彼女の体のダメージは無視できるものではなく、状況は楽観できるものではない。"
msgstr "  The damage to her body was too much to afford her any optimism."

#. Occurrence 5A_6:1145:4974: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0006; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1145
msgctxt "text_id=4974 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5A_6:1150:4975: scene=5A_6
#: 5A_6:1150
msgctxt "text_id=4975 | speaker=unknown"
msgid "　だが、彼女の目に秘められた激情が、その一切を否定する。"
msgstr "  Still, the fury in her eyes refused to accept her circumstances."

#. Occurrence 5A_6:1202:4976: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0007; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1202
msgctxt "text_id=4976 | speaker=aoko"
msgid "“<魔術回路|なか>がところどころショートしてる……"
msgstr "\"My Magic Circuits are shorting out like crazy..."

#. Occurrence 5A_6:1202:4977: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0007; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1202
msgctxt "text_id=4977 | speaker=aoko"
msgid "　あの右腕は回路を混線させる<術式妨害|ジャミング>ってワケね―――”"
msgstr "  Which means that right arm of hers must be jamming my spells.\""

#. Occurrence 5A_6:1208:4978: scene=5A_6
#: 5A_6:1208
msgctxt "text_id=4978 | speaker=unknown"
msgid "　本来ならピンチに震え上がるところだが、青子の拳を震わせたのは怒りだけだ。"
msgstr "  Though the proper response would have been for her to tremble in fear, she did nothing but shake her fists in anger."

#. Occurrence 5A_6:1235:4979: scene=5A_6
#: 5A_6:1235
msgctxt "text_id=4979 | speaker=unknown"
msgid "　術式妨害なんて初歩の初歩、かけだしの半人前にしか通じない。"
msgstr "  The disruption of formulae was only supposed to work on absolute beginners."

#. Occurrence 5A_6:1240:4980: scene=5A_6
#: 5A_6:1240
msgctxt "text_id=4980 | speaker=unknown"
msgid "　彼女の同居人レベルなら、あんなジャミングはそれこそ腕が触れた時点で弾き、接触しようとした相手の回路を逆に焼き切ってしまうだろう。"
msgstr "  If it had been her roommate, the arm would have been repelled the instant it hit her and the attacker's circuits burned out, rather than her own."

#. Occurrence 5A_6:1245:4981: scene=5A_6
#: 5A_6:1245
msgctxt "text_id=4981 | speaker=unknown"
msgid "　このように、他の魔術師と回路を繋げよう、なんて行為は自分の心臓を差し出すに等しい。卓越した魔術師同士の術理戦において、何の役にもたたない<駄機能|だきのう>だ。"
msgstr "  Attempting to establish a link to the Magic Circuits of another mage was like presenting your heart on a silver platter. It would be of no use in a battle against a superior mage."

#. Occurrence 5A_6:1296:4982: scene=5A_6
#: 5A_6:1296
msgctxt "text_id=4982 | speaker=unknown"
msgid "　なのに、あの敵にはそんな“余分な”機能が備えられていた。"
msgstr "  And yet, her adversary had been designed to do just that."

#. Occurrence 5A_6:1301:4983: scene=5A_6
#: 5A_6:1301
msgctxt "text_id=4983 | speaker=unknown"
msgid "　ここ数週間の、三咲の管理地を巡る戦いっぷりから出た、敵の結論。二日前、正式に魔術師として踏みだした彼女に対する評価がそれ。"
msgstr "  Coupled with the attacks on areas of Misaki under Aoko's jurisdiction these last few weeks, it was a clear statement from the enemy, who had revealed itself as a fellow mage two days ago."

#. Occurrence 5A_6:1308:4984: scene=5A_6
#: 5A_6:1308
msgctxt "text_id=4984 | speaker=unknown"
msgid "　要するに―――"
msgstr "  In other words,"

#. Occurrence 5A_6:1308:4985: scene=5A_6
#: 5A_6:1308
msgctxt "text_id=4985 | speaker=unknown"
msgid "　あの<人形|てき>は、蒼崎青子を完っ全に舐めている。"
msgstr "  the puppet saw Aoko as no threat at all."

#. Occurrence 5A_6:1375:4986: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0008; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1375
msgctxt "text_id=4986 | speaker=aoko"
msgid "「……ふん。敵ながら精確な判断だこと」"
msgstr "\"...Hmph. Played right into their hands, huh.\""

#. Occurrence 5A_6:1381:4987: scene=5A_6
#: 5A_6:1381
msgctxt "text_id=4987 | speaker=unknown"
msgid "　怒りはそのままに、浮き足立つ激情を冷却する。"
msgstr "  While she was still angry, the whirlwind of emotions within her started to fade."

#. Occurrence 5A_6:1386:4988: scene=5A_6
#: 5A_6:1386
msgctxt "text_id=4988 | speaker=unknown"
msgid "　十七歳の少女には似つかわしくない、達観した狩人の顔。"
msgstr "  Her face was that of a hunter far beyond her years."

#. Occurrence 5A_6:1467:4989: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0009; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:1467
msgctxt "text_id=4989 | speaker=soujuurou"
msgid "「なんか、俺の時より真剣だな」"
msgstr "\"You seem to be more concerned about this thing than you were about hunting me.\""

#. Occurrence 5A_6:1487:4990: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0009; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1487
msgctxt "text_id=4990 | speaker=aoko"
msgid "「まあね。アンタの時は遊びが入ってたし」"
msgstr "\"Well, naturally. I was only playing with you.\""

#. Occurrence 5A_6:1502:4991: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0010; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:1502
msgctxt "text_id=4991 | speaker=soujuurou"
msgid "「……む」"
msgstr "\"...Hm.\""

#. Occurrence 5A_6:1508:4992: scene=5A_6
#: 5A_6:1508
msgctxt "text_id=4992 | speaker=unknown"
msgid "　喜んでいいのか悲しんでいいのか、草十郎には難しい返答だった。"
msgstr "  Soujyuro was not sure whether to be happy or sad at that."

#. Occurrence 5A_6:1565:4993: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0011; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:1565
msgctxt "text_id=4993 | speaker=soujuurou"
msgid "「分からない事だらけで何を聞いていいか分からないんだけど、ひとつだけいいか？」"
msgstr "\"This is all so confusing that I don't even know where to start, but can I ask just one question?\""

#. Occurrence 5A_6:1606:4994: scene=5A_6
#: 5A_6:1606
msgctxt "text_id=4994 | speaker=unknown"
msgid "　青子は<応|こた>えず、目前の闇を見詰めている。"
msgstr "  Aoko didn't respond. Her eyes were focused on the darkness before them."

#. Occurrence 5A_6:1611:4995: scene=5A_6
#: 5A_6:1611
msgctxt "text_id=4995 | speaker=unknown"
msgid "　沈黙は重く、まとわりつく闇は締めつける<真綿|まわた>のようだ。"
msgstr "  The silence was heavy, and the darkness was like a noose closing in on them."

#. Occurrence 5A_6:1616:4996: scene=5A_6
#: 5A_6:1616
msgctxt "text_id=4996 | speaker=unknown"
msgid "　それでも、完全に自分を無いものと扱う青子に臆さず、草十郎は続けた。"
msgstr "  But Soujyuro continued in spite of her indifference."

#. Occurrence 5A_6:1638:4997: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0012; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:1638
msgctxt "text_id=4997 | speaker=soujuurou"
msgid "「蒼崎は、あいつも殺すのか」"
msgstr "\"Are you going to kill her, too, Aozaki?\""

#. Occurrence 5A_6:1644:4998: scene=5A_6
#: 5A_6:1644
msgctxt "text_id=4998 | speaker=unknown"
msgid "　<粛々|しゅくしゅく>と。"
msgstr "  A stillness fell over them."

#. Occurrence 5A_6:1649:4999: scene=5A_6
#: 5A_6:1649
msgctxt "text_id=4999 | speaker=unknown"
msgid "　その行為を、暗闇から引きずりだすように。"
msgstr "  It was as if the gloom was pulling them in."

#. Occurrence 5A_6:1703:5000: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0010; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1703
msgctxt "text_id=5000 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5A_6:1709:5001: scene=5A_6
#: 5A_6:1709
msgctxt "text_id=5001 | speaker=unknown"
msgid "　返事はない。"
msgstr "  No response."

#. Occurrence 5A_6:1714:5002: scene=5A_6
#: 5A_6:1714
msgctxt "text_id=5002 | speaker=unknown"
msgid "　薄影の廊下に、ふたりの息遣いだけが響く。"
msgstr "  Their breathing was the only sound echoing in the dim corridor."

#. Occurrence 5A_6:1769:5003: scene=5A_6
#: 5A_6:1769
msgctxt "text_id=5003 | speaker=unknown"
msgid "　罪を問いかける草十郎と、それを無視し続ける魔法使いの少女。"
msgstr "  There stood Soujyuro, forcing her to confront her sins, and the magician girl who continued to ignore him."

#. Occurrence 5A_6:1775:5004: scene=5A_6
#: 5A_6:1775
msgctxt "text_id=5004 | speaker=unknown"
msgid "……凍りつくような数秒の<後|のち>、"
msgstr "They spent a few seconds, seemingly frozen in time."

#. Occurrence 5A_6:1782:5005: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0011; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1782
msgctxt "text_id=5005 | speaker=aoko"
msgid "「―――そう。"
msgstr "\"...Yes."

#. Occurrence 5A_6:1788:5006: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0012; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1788
msgctxt "text_id=5006 | speaker=aoko"
msgid "　それが貴方のキーワードみたいね」"
msgstr "  That's a sticking point for you, isn't it?\""

#. Occurrence 5A_6:1820:5007: scene=5A_6
#: 5A_6:1820
msgctxt "text_id=5007 | speaker=unknown"
msgid "　抑揚のない声で、青子は呟いた。"
msgstr "  Aoko whispered in a lifeless tone."

#. Occurrence 5A_6:1825:5008: scene=5A_6
#: 5A_6:1825
msgctxt "text_id=5008 | speaker=unknown"
msgid "　観念したようにも、軽蔑したようにも取れる、ため息をこぼしながら。"
msgstr "  Her sigh was tinged with both resignation and contempt."

#. Occurrence 5A_6:1873:5009: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0013; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:1873
msgctxt "text_id=5009 | speaker=soujuurou"
msgid "「キー……なに？」"
msgstr "\"A sticky... what?\""

#. Occurrence 5A_6:1902:5010: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0013; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1902
msgctxt "text_id=5010 | speaker=aoko"
msgid "「独り言よ。忘れて。"
msgstr "\"Nothing. Forget it."

#. Occurrence 5A_6:1908:5011: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0014; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1908
msgctxt "text_id=5011 | speaker=aoko"
msgid "　それと。言っとくけど、あいつは人間じゃないわ。"
msgstr "  But just so you know, that thing that's following us isn't human."

#. Occurrence 5A_6:1914:5012: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0015; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1914
msgctxt "text_id=5012 | speaker=aoko"
msgid "　信じられないだろうけど自分の意志で動く人形なの。この前のも、今のヤツもね」"
msgstr "  You might not believe this, but it's a puppet that can move of its own will. Just like the one from the other night.\""

#. Occurrence 5A_6:1919:5013: scene=5A_6
#: 5A_6:1919
msgctxt "text_id=5013 | speaker=unknown"
msgid "　ふーん、と素直に頷く草十郎。"
msgstr "  Soujyuro nodded as he processed the information."

#. Occurrence 5A_6:1932:5014: scene=5A_6
#: 5A_6:1932
msgctxt "text_id=5014 | speaker=unknown"
msgid "　青子の話を信じないどころか、納得さえしている風だ。"
msgstr "  Not only did he not doubt her story, but he seemed to have accepted it at face value."

#. Occurrence 5A_6:1975:5015: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0016; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:1975
msgctxt "text_id=5015 | speaker=aoko"
msgid "「……なんか落ち着いてるわね、貴方」"
msgstr "\"...You're awfully calm.\""

#. Occurrence 5A_6:1988:5016: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0014; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:1988
msgctxt "text_id=5016 | speaker=soujuurou"
msgid "「まさか。もう何がなんだか分からないから、あまり考えない事にしてるだけだ。"
msgstr "\"No way. I have no idea what's going on, so I'm just trying not to think too hard about it."

#. Occurrence 5A_6:1995:5017: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0015; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:1995
msgctxt "text_id=5017 | speaker=soujuurou"
msgid "ただ、人形に関しては別に、どうという事はない」"
msgstr "The part about it being a puppet isn't too surprising to me, though.\""

#. Occurrence 5A_6:2009:5018: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0017; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:2009
msgctxt "text_id=5018 | speaker=aoko"
msgid "「え？　もしかして、他でも自動人形を見た事あるとか！？」"
msgstr "\"What? Are you saying you've seen one before!?\""

#. Occurrence 5A_6:2034:5019: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_6_0016; voice_prefix=A30; voice_category=3; scene=5A_6
#: 5A_6:2034
msgctxt "text_id=5019 | speaker=soujuurou"
msgid "「？　都会の人形ってああいうものじゃないのか？」"
msgstr "\"What do you mean? Aren't all puppets in the city like that?\""

#. Occurrence 5A_6:2083:5020: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0018; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:2083
msgctxt "text_id=5020 | speaker=aoko"
msgid "「な―――」"
msgstr "\"Wha...\""

#. Occurrence 5A_6:2098:5021: scene=5A_6
#: 5A_6:2098
msgctxt "text_id=5021 | speaker=unknown"
msgid "　ばたり、と倒れこみたい衝動をギリギリで<堪|こら>える青子。"
msgstr "  She barely stopped herself from falling to her knees."

#. Occurrence 5A_6:2103:5022: scene=5A_6
#: 5A_6:2103
msgctxt "text_id=5022 | speaker=unknown"
msgid "　そうなのだった。"
msgstr "  Of course. How could she have forgotten?"

#. Occurrence 5A_6:2109:5023: scene=5A_6
#: 5A_6:2109
msgctxt "text_id=5023 | speaker=unknown"
msgid "この、神がかった<呆|ほう>け者はそういう男なのだった。"
msgstr "She was dealing with a bona fide, natural-born moron."

#. Occurrence 5A_6:2114:5024: scene=5A_6
#: 5A_6:2114
msgctxt "text_id=5024 | speaker=unknown"
msgid "　天然保護動物なみに隔離された山奥からの転入生で、常識はずれの常識の無さで、見るものすべてが奇想天外という異邦人。"
msgstr "  As a student who transferred from the isolation of the mountains like an endangered species, his utter lack of common sense rendered anything miraculous as mundane."

#. Occurrence 5A_6:2141:5025: scene=5A_6
#: 5A_6:2141
msgctxt "text_id=5025 | speaker=unknown"
msgid "　自動車という鉄の塊が動くなら、人形だって動くと思っても不思議はない。"
msgstr "  If automobiles were moving hunks of metal, then moving puppets were nothing to write home about."

#. Occurrence 5A_6:2146:5026: scene=5A_6
#: 5A_6:2146
msgctxt "text_id=5026 | speaker=unknown"
msgid "　……なので、もしかしたら。"
msgstr "  Wait. That meant..."

#. Occurrence 5A_6:2151:5027: scene=5A_6
#: 5A_6:2151
msgctxt "text_id=5027 | speaker=unknown"
msgid "　彼にとってあの夜の出来事は“特別”なことではなく。"
msgstr "  To him, the incident from the other night hadn't been extraordinary at all."

#. Occurrence 5A_6:2156:5028: scene=5A_6
#: 5A_6:2156
msgctxt "text_id=5028 | speaker=unknown"
msgid "　都会ではよくある風景として、誰に言いふらすような事ではなかったのかもしれない。"
msgstr "  He might have even assumed it was an everyday occurrence in the city."

#. Occurrence 5A_6:2183:5029: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0019_A; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:2183
msgctxt "text_id=5029 | speaker=aoko"
msgid "「……まいった。いっぺん頭のなか覗いてみたいっていうか、ほんと、ここまでくると感心するわ。"
msgstr "\"...I give up. You know, I'd really like to get a look inside your head someday. I honestly have no idea how you've made it this far in life."

#. Occurrence 5A_6:2189:5030: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0020; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:2189
msgctxt "text_id=5030 | speaker=aoko"
msgid "　……調子が狂うのも当然だった。普通は私に襲われた時点でもっと違う反応をするはずなのに。"
msgstr "  No wonder you're such a weirdo. Normally, people wouldn't react the way you did when I attacked you."

#. Occurrence 5A_6:2196:5031: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0021; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:2196
msgctxt "text_id=5031 | speaker=aoko"
msgid "化け物とか、お化けとかさ。でも貴方にとっては『そういう事もある』で済まされてたワケなんだ。"
msgstr "I could have been a monster or a ghost, but for you, it was just another new fact of life."

#. Occurrence 5A_6:2227:5032: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_6_0022; voice_prefix=A10; voice_category=1; scene=5A_6
#: 5A_6:2227
msgctxt "text_id=5032 | speaker=aoko"
msgid "　……なんか<莫|ば><迦|か>みたいね、私」"
msgstr "  ...I'm starting to feel like the real moron here.\""

#. Occurrence 5A_6:2247:5033: scene=5A_6
#: 5A_6:2247
msgctxt "text_id=5033 | speaker=unknown"
msgid "　張りつめた彼女の顔が、一瞬だけ元に戻る。"
msgstr "  Her strained face returned to normal for a moment."

#. Occurrence 5A_6:2252:5034: scene=5A_6
#: 5A_6:2252
msgctxt "text_id=5034 | speaker=unknown"
msgid "　そう。それならもっと違った方法で、誰も傷つかずに済む選択があったかも知れない。"
msgstr "  It hit her; there had been another way to handle this without anyone getting hurt."

#. Occurrence 5A_6:2257:5035: scene=5A_6
#: 5A_6:2257
msgctxt "text_id=5035 | speaker=unknown"
msgid "　けれどもう遅い。"
msgstr "  But the damage had already been done."

#. Occurrence 5A_6:2262:5036: scene=5A_6
#: 5A_6:2262
msgctxt "text_id=5036 | speaker=unknown"
msgid "　基本、人生にやり直しはない。あってはならない。"
msgstr "  There were no do-overs in life, nor should there be."

#. Occurrence 5A_6:2282:5037: scene=5A_6
#: 5A_6:2282
msgctxt "text_id=5037 | speaker=unknown"
msgid "　些細な勘違い、勝手な思いこみで状況は悪化しすぎた。"
msgstr "  Her own mistaken assumptions had sent that situation spiraling out of control."

#. Occurrence 5A_6:2287:5038: scene=5A_6
#: 5A_6:2287
msgctxt "text_id=5038 | speaker=unknown"
msgid "　ここまで関わった以上、彼女は草十郎を手にかけて秘密を守らなければならない。"
msgstr "  But now that Soujyuro was involved, she had to make sure that her secret was safe with him."

#. Occurrence 5A_6:2293:5039: scene=5A_6
#: 5A_6:2293
msgctxt "text_id=5039 | speaker=unknown"
msgid "　……本当はもうひとつぐらい、最善の選択肢があっただろうけど後の祭り。"
msgstr "  Even if there had been another, better option, that ship had sailed."

#. Occurrence 5A_6:2298:5040: scene=5A_6
#: 5A_6:2298
msgctxt "text_id=5040 | speaker=unknown"
msgid "　所詮、人間の関わり合いなんて相互誤解で回るもの。"
msgstr "  Human relationships were ultimately driven by mutual misunderstandings;"

#. Occurrence 5A_6:2303:5041: scene=5A_6
#: 5A_6:2303
msgctxt "text_id=5041 | speaker=unknown"
msgid "　<意|い><図|と>の編み違いで転がっていく<織物|おりもの>だ。"
msgstr "  they were like tapestries, woven from mismatched intentions."

#. Occurrence 5A_7:58:5042: scene=5A_7
#: 5A_7:58
msgctxt "text_id=5042 | speaker=unknown"
msgid "　―――休憩はここまで。"
msgstr "  Breaktime was over."

#. Occurrence 5A_7:64:5043: scene=5A_7
#: 5A_7:64
msgctxt "text_id=5043 | speaker=unknown"
msgid "　蒼崎青子と静希草十郎。"
msgstr "  There stood Aoko Aozaki and Soujyuro Sizuki."

#. Occurrence 5A_7:69:5044: scene=5A_7
#: 5A_7:69
msgctxt "text_id=5044 | speaker=unknown"
msgid "　ふたりが自己紹介を交わした日以来の、なんでもない会話はここで終わり。"
msgstr "  Their first ever idle conversation had come to an end, not that they had a choice in the matter."

#. Occurrence 5A_7:74:5045: scene=5A_7
#: 5A_7:74
msgctxt "text_id=5045 | speaker=unknown"
msgid "　彼らの心情とは関係なく、曲がり角の向こうから耳障りな囁きが流れてくる。"
msgstr "  It was the jarring murmuring from around the corner that cut it short."

#. Occurrence 5A_7:153:5046: voice_id=C40_5A_7_0000_C; voice_prefix=C40; voice_category=0; scene=5A_7
#: 5A_7:153
msgctxt "text_id=5046 | speaker=unknown"
msgid "@o“<Nemo meum funus meminit, qui doluit exstinctus est|私のお葬式はもう誰も覚えていません。悲しむ人も消え去りました。>."
msgstr "    \"<Nemo meum funus meminit, qui doluit exstinctus est|Nobody remembers my funeral. My mourners have long since perished.>."

#. Occurrence 5A_7:153:5047: voice_id=C40_5A_7_0000_C; voice_prefix=C40; voice_category=0; scene=5A_7
#: 5A_7:153
msgctxt "text_id=5047 | speaker=unknown"
msgid "　　<Initio erraveramus. Dum vivimus dolores sunt|はじまりから私たちは間違えていました。生きているのは苦しいです。>."
msgstr "                    <Initio erraveramus. Dum vivimus dolores sunt|We were born wrong. Life is suffering.>."

#. Occurrence 5A_7:153:5048: voice_id=C40_5A_7_0000_C; voice_prefix=C40; voice_category=0; scene=5A_7
#: 5A_7:153
msgctxt "text_id=5048 | speaker=unknown"
msgid "　　　　　　　　　<Nemo adiuvat.|誰か、私を救ってください。>”"
msgstr "                                          <Nemo adiuvat|Somebody save me.>.\""

#. Occurrence 5A_7:211:5049: scene=5A_7
#: 5A_7:211
msgctxt "text_id=5049 | speaker=unknown"
msgid "　合わせ鏡に、曲がり<角|かど>向こうの敵が<映|うつ>る。"
msgstr "  The enemy was just around the corner, visible in the mirrors parallel to it."

#. Occurrence 5A_7:231:5050: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0000_0; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:231
msgctxt "text_id=5050 | speaker=aoko"
msgid "「……悠長に話してる場合じゃないわね。とにかく今は距離を―――"
msgstr "\"...We don't have time for this. We need to keep our dist―"

#. Occurrence 5A_7:243:5051: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0000_1; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:243
msgctxt "text_id=5051 | speaker=aoko"
msgid "っ、！？」"
msgstr " Huh!?\""

#. Occurrence 5A_7:452:5052: scene=5A_7
#: 5A_7:452
msgctxt "text_id=5052 | speaker=unknown"
msgid "　青子の鮮麗な青色とは違う、怨恨を思わせる赤い光。"
msgstr "  In contrast to Aoko's elegant blues, its lights were a malicious red."

#. Occurrence 5A_7:505:5053: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0001; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:505
msgctxt "text_id=5053 | speaker=aoko"
msgid "“ガンド撃ち……！”"
msgstr "\"Gandr Shots!\""

#. Occurrence 5A_7:589:5054: scene=5A_7
#: 5A_7:589
msgctxt "text_id=5054 | speaker=unknown"
msgid "　伸びる腕より速い、一瞬の閃光。"
msgstr "  There was a momentary flash of light, before she even extended her arm."

#. Occurrence 5A_7:594:5055: scene=5A_7
#: 5A_7:594
msgctxt "text_id=5055 | speaker=unknown"
msgid "　が、はっきりと敵の姿を視認した時点で、沈みかけていた青子の感情も一瞬で再熱していた。"
msgstr "  But the instant she saw the enemy, her dormant feelings erupted once more."

#. Occurrence 5A_7:615:5056: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0002; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:615
msgctxt "text_id=5056 | speaker=aoko"
msgid "「っ、さっきから邪魔なのよ……っ！」"
msgstr "\"You're a real pain in the ass!\""

#. Occurrence 5A_7:743:5057: scene=5A_7
#: 5A_7:743
msgctxt "text_id=5057 | speaker=unknown"
msgid "　行き場のない、ありったけの怒りをぶつけて彼女の右腕が突き出される。"
msgstr "  She channeled all of her pent-up anger and shunted it into her right arm."

#. Occurrence 5A_7:763:5058: scene=5A_7
#: 5A_7:763
msgctxt "text_id=5058 | speaker=unknown"
msgid "　展開された霧は魔術によるものではなく、魔力をぶちまけただけの障壁だ。"
msgstr "  The fog that filled the corridor was no magical weaving, but rather a barrier of raw energy."

#. Occurrence 5A_7:768:5059: scene=5A_7
#: 5A_7:768
msgctxt "text_id=5059 | speaker=unknown"
msgid "　飛来する一本の矢の威力をそぐために、バケツ三杯分のガソリンを燃やして壁を作るようなものである。"
msgstr "  It was equivalent to setting ablaze three buckets of gasoline to create a wall of fire, in the hope it would stop an arrow in flight."

#. Occurrence 5A_7:788:5060: scene=5A_7
#: 5A_7:788
msgctxt "text_id=5060 | speaker=unknown"
msgid "　これが人形の腕であったのなら魔力の壁はたやすく突破されただろうが、実像のない“呪い”だからこそ、魔力の壁に弾かれる。"
msgstr "  If the puppet had attacked with its arm, it could have pierced such a wall easily. But, because it had loosed curses with no definite form, the wall of energy repelled the attack."

#. Occurrence 5A_7:793:5061: scene=5A_7
#: 5A_7:793
msgctxt "text_id=5061 | speaker=unknown"
msgid "　膨大な魔力の無駄遣いだが、今の青子にはそれしか<防|ふせ>ぐ手段がない。"
msgstr "  While it was a huge waste of magical energy, it was the only means Aoko had to protect herself at that very moment."

#. Occurrence 5A_7:902:5062: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0000; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:902
msgctxt "text_id=5062 | speaker=soujuurou"
msgid "「……う」"
msgstr "\"...Urgh.\""

#. Occurrence 5A_7:908:5063: scene=5A_7
#: 5A_7:908
msgctxt "text_id=5063 | speaker=unknown"
msgid "　が、それで守りきれるのは青子だけだった。"
msgstr "  Unfortunately, its protection was reserved for Aoko alone."

#. Occurrence 5A_7:1042:5064: scene=5A_7
#: 5A_7:1042
msgctxt "text_id=5064 | speaker=unknown"
msgid "　口を押さえる草十郎。"
msgstr "  Soujyuro held his hand to his mouth."

#. Occurrence 5A_7:1047:5065: scene=5A_7
#: 5A_7:1047
msgctxt "text_id=5065 | speaker=unknown"
msgid "　青子には影響を及ぼさないほど小さくなった呪いでも、魔術師ではない草十郎には十分な効果がある。"
msgstr "  While the curse had been weakened to the point where Aoko could no longer feel it, it had plenty of effect on Soujyuro, who was not a mage."

#. Occurrence 5A_7:1116:5066: scene=5A_7
#: 5A_7:1116
msgctxt "text_id=5066 | speaker=unknown"
msgid "　それが理解できるのか、人形は青子ではなく、その背後にいる予定外の人間に視線を向けた。"
msgstr "  As if it understood this fact, the puppet turned its gaze from Aoko to the unanticipated human behind her."

#. Occurrence 5A_7:1161:5067: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0003; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:1161
msgctxt "text_id=5067 | speaker=aoko"
msgid "「この、こいつは関係ないでしょう……！」"
msgstr "\"T-this has nothing to do with him!\""

#. Occurrence 5A_7:1204:5068: scene=5A_7
#: 5A_7:1204
msgctxt "text_id=5068 | speaker=unknown"
msgid "　カッとなってもう一度腕を振るう。"
msgstr "  Enraged, she swung her arm forward once again."

#. Occurrence 5A_7:1209:5069: scene=5A_7
#: 5A_7:1209
msgctxt "text_id=5069 | speaker=unknown"
msgid "　わずか数秒、青い燐光は<呪い|ガンド>を防ぐ障壁となる。"
msgstr "  The blue light formed a wall to block the Gandr for a scant few seconds."

#. Occurrence 5A_7:1308:5070: scene=5A_7
#: 5A_7:1308
msgctxt "text_id=5070 | speaker=unknown"
msgid "　その隙。"
msgstr "  It was enough of an opening to exploit."

#. Occurrence 5A_7:1313:5071: scene=5A_7
#: 5A_7:1313
msgctxt "text_id=5071 | speaker=unknown"
msgid "　壁を張ったばかりの青子の顔を指さすように、人形の右腕が突き出され―――"
msgstr "  Just as Aoko was forming the wall, the puppet pointed its right arm at her face, and..."

#. Occurrence 5A_7:1320:5072: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0001; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:1320
msgctxt "text_id=5072 | speaker=soujuurou"
msgid "「関係あるみたいだから、逃げるぞ」"
msgstr "\"This apparently does have something to do with me. Time to run.\""

#. Occurrence 5A_7:1389:5073: scene=5A_7
#: 5A_7:1389
msgctxt "text_id=5073 | speaker=unknown"
msgid "　死のロケット弾が放たれる前に、草十郎はひょいっと青子を抱き抱えた。"
msgstr "  Before the rocket of death could be fired, Soujyuro scooped her up into his arms."

#. Occurrence 5A_7:1455:5074: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0004; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:1455
msgctxt "text_id=5074 | speaker=aoko"
msgid "「へ！？」"
msgstr "\"Huh?!\""

#. Occurrence 5A_7:1461:5075: scene=5A_7
#: 5A_7:1461
msgctxt "text_id=5075 | speaker=unknown"
msgid "　どこにそんな力が残っていたのか、草十郎は人形に背を向けて走り出した。"
msgstr "  How he mustered the strength to do so was a mystery, but he turned his back on the puppet and took off running."

#. Occurrence 5A_7:1549:5076: scene=5A_7
#: 5A_7:1549
msgctxt "text_id=5076 | speaker=unknown"
msgid "　軽快なスプリンターか、岩肌を跳ぶ鹿のようだ。"
msgstr "  He was a nimble sprinter, resembling a deer leaping across obstacles."

#. Occurrence 5A_7:1554:5077: scene=5A_7
#: 5A_7:1554
msgctxt "text_id=5077 | speaker=unknown"
msgid "　草十郎は曲がり角を二つ越え、"
msgstr "  Soujyuro rounded two more corners,"

#. Occurrence 5A_7:1579:5078: scene=5A_7
#: 5A_7:1579
msgctxt "text_id=5078 | speaker=unknown"
msgid "　なにか文句を言いたそうな青子を無視して、"
msgstr "  ignored whatever complaints Aoko was making,"

#. Occurrence 5A_7:1584:5079: scene=5A_7
#: 5A_7:1584
msgctxt "text_id=5079 | speaker=unknown"
msgid "　もうじき二階の中心、というところで足を止めて、青子から手を離した。"
msgstr "  and eventually stopped in the middle of the second floor. He set her down."

#. Occurrence 5A_7:1635:5080: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0002; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:1635
msgctxt "text_id=5080 | speaker=soujuurou"
msgid "「……よし。ここまでくれば少しは休めるな」"
msgstr "\"...All right. I bought us enough time to rest a bit.\""

#. Occurrence 5A_7:1641:5081: scene=5A_7
#: 5A_7:1641
msgctxt "text_id=5081 | speaker=unknown"
msgid "　ふう、と肩で息をする草十郎。"
msgstr "  Soujyuro's shoulders heaved as he caught his breath."

#. Occurrence 5A_7:1646:5082: scene=5A_7
#: 5A_7:1646
msgctxt "text_id=5082 | speaker=unknown"
msgid "　いくら軽いとは言え、人間ひとり抱えて走ったので息があがっている。"
msgstr "  As light as she was, running while carrying someone else would make anyone winded."

#. Occurrence 5A_7:1651:5083: scene=5A_7
#: 5A_7:1651
msgctxt "text_id=5083 | speaker=unknown"
msgid "　その顔を、青子は理解不能とばかりに見あげている。"
msgstr "  She looked up at him in incomprehension."

#. Occurrence 5A_7:1688:5084: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0005; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:1688
msgctxt "text_id=5084 | speaker=aoko"
msgid "「……こんな体力あったのに、なんで……？」"
msgstr "\"You had that much stamina all along? Then why...?\""

#. Occurrence 5A_7:1694:5085: scene=5A_7
#: 5A_7:1694
msgctxt "text_id=5085 | speaker=unknown"
msgid "　道理に合わない。"
msgstr "  It made no sense to her."

#. Occurrence 5A_7:1699:5086: scene=5A_7
#: 5A_7:1699
msgctxt "text_id=5086 | speaker=unknown"
msgid "　自分を抱えて走れるだけの体力があったのなら、床に倒れたあの時、まだ立ち上がって逃げられたはずなのにと。"
msgstr "  If he had the stamina to pick her up and run, surely he could have stood up and escaped when he had been downed earlier."

#. Occurrence 5A_7:1750:5087: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0003; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:1750
msgctxt "text_id=5087 | speaker=soujuurou"
msgid "「ああ、あの時は諦めてたから」"
msgstr "\"Oh, that time I had given up.\""

#. Occurrence 5A_7:1756:5088: scene=5A_7
#: 5A_7:1756
msgctxt "text_id=5088 | speaker=unknown"
msgid "　取り<繕|つくろ>いのない、さっぱりとした言葉。"
msgstr "  His words were unfiltered as ever."

#. Occurrence 5A_7:1761:5089: scene=5A_7
#: 5A_7:1761
msgctxt "text_id=5089 | speaker=unknown"
msgid "　一刻、一命を争う状況だ。普段のぼんやりした雰囲気は、さすがに薄くなっている。"
msgstr "  Though right then, fighting for their lives, he lacked some of his usual absentmindedness."

#. Occurrence 5A_7:1782:5090: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0006; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:1782
msgctxt "text_id=5090 | speaker=aoko"
msgid "「……諦めてたって、どうして？」"
msgstr "\"...But why?\""

#. Occurrence 5A_7:1823:5091: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0004; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:1823
msgctxt "text_id=5091 | speaker=soujuurou"
msgid "「さあ。忘れた、そんな事は」"
msgstr "\"Who knows? I've forgotten already.\""

#. Occurrence 5A_7:1829:5092: scene=5A_7
#: 5A_7:1829
msgctxt "text_id=5092 | speaker=unknown"
msgid "　言いたくない、と顔を背けるものの、律儀に草十郎は答える。"
msgstr "  Though he may have turned away because he regretted saying it aloud, his words spoke volumes."

#. Occurrence 5A_7:1834:5093: scene=5A_7
#: 5A_7:1834
msgctxt "text_id=5093 | speaker=unknown"
msgid "　その横顔は、青子にはなんだか痛かった。"
msgstr "  For some reason, it pained Aoko to see him like that."

#. Occurrence 5A_7:1882:5094: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0005; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:1882
msgctxt "text_id=5094 | speaker=soujuurou"
msgid "「それより蒼崎、とうとつに気分が悪いんだが……。"
msgstr "\"Also, Aozaki? I'm suddenly feeling really ill."

#. Occurrence 5A_7:1888:5095: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0006; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:1888
msgctxt "text_id=5095 | speaker=soujuurou"
msgid "　あの赤い光も、その……？」"
msgstr "  Was it that red light?\""

#. Occurrence 5A_7:1903:5096: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0007; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:1903
msgctxt "text_id=5096 | speaker=aoko"
msgid "「……ええ、魔術の類よ。ガンド撃ちって言ってね。北欧の呪詛の一つ。魔術回路のある私には効かないけど、抵抗のない貴方には効果てきめんみたいね」"
msgstr "\"...Yes. A form of magecraft. They're called Gandr Shots. A curse that originated in Scandinavia. It has no effect on someone with Magic Circuits like myself, but you're defenseless against it.\""

#. Occurrence 5A_7:1948:5097: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0007; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:1948
msgctxt "text_id=5097 | speaker=soujuurou"
msgid "「―――なんだ。蒼崎には効かないのか。"
msgstr "\"...I see. It doesn't work on you."

#. Occurrence 5A_7:1948:5098: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0007; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:1948
msgctxt "text_id=5098 | speaker=soujuurou"
msgid "　じゃあ、危ないのはあの腕だけだな」"
msgstr "  Then that arm is the only thing that poses a threat.\""

#. Occurrence 5A_7:1954:5099: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0008; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:1954
msgctxt "text_id=5099 | speaker=aoko"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 5A_7:2009:5100: scene=5A_7
#: 5A_7:2009
msgctxt "text_id=5100 | speaker=unknown"
msgid "　なぜかホッとする草十郎に、青子は奥歯を噛んで、突発的な<感|こ><情|え>を抑えこんだ。"
msgstr "  Aoko had no idea why he was relieved, but she gritted her teeth and fought down the urge to snap at him."

#. Occurrence 5A_7:2015:5101: scene=5A_7
#: 5A_7:2015
msgctxt "text_id=5101 | speaker=unknown"
msgid "　……こんなところで怒鳴っても仕方がないし。"
msgstr "  There was no use in yelling at a time like this."

#. Occurrence 5A_7:2020:5102: scene=5A_7
#: 5A_7:2020
msgctxt "text_id=5102 | speaker=unknown"
msgid "　なにより、どうしていま自分が最高にイラっときたかなんて、言語化したらそれこそ何もかもどうでもよくなってしまいそうだ。"
msgstr "  Above all, she felt that it would have been petty in the extreme to voice her annoyance right now."

#. Occurrence 5A_7:2079:5103: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0009; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2079
msgctxt "text_id=5103 | speaker=aoko"
msgid "「―――そうね。注意するのは伸ばしてくる腕だけ。大した相手じゃないわ、やっぱり」"
msgstr "\"...You're right. The extending arm is the only thing I have to worry about. So it's not that tough after all.\""

#. Occurrence 5A_7:2085:5104: scene=5A_7
#: 5A_7:2085
msgctxt "text_id=5104 | speaker=unknown"
msgid "　嘘偽りのない感想だった。"
msgstr "  This time it was not false bravado."

#. Occurrence 5A_7:2090:5105: scene=5A_7
#: 5A_7:2090
msgctxt "text_id=5105 | speaker=unknown"
msgid "　普段の蒼崎青子なら問題のない相手。"
msgstr "  Such an enemy would normally be a breeze for Aoko Aozaki."

#. Occurrence 5A_7:2095:5106: scene=5A_7
#: 5A_7:2095
msgctxt "text_id=5106 | speaker=unknown"
msgid "　ただ、目も当てられない油断から魔術回路に介入されて、自分がさらに大した相手じゃなくなっただけの話。"
msgstr "  But her shameful negligence had led to the disruption of her Magic Circuits, making her even less formidable than her enemy."

#. Occurrence 5A_7:2140:5107: scene=5A_7
#: 5A_7:2140
msgctxt "text_id=5107 | speaker=unknown"
msgid "　今の青子には攻撃手段がない。"
msgstr "  At this point, Aoko had no way of attacking."

#. Occurrence 5A_7:2145:5108: scene=5A_7
#: 5A_7:2145
msgctxt "text_id=5108 | speaker=unknown"
msgid "　こうなると相手の魔力切れを待つしかないのだが、相手は呪いの永久機関。"
msgstr "  The only option left to her was to wait for it to expend all of its magical energy, but its perpetual curse mechanism made that a non-starter."

#. Occurrence 5A_7:2150:5109: scene=5A_7
#: 5A_7:2150
msgctxt "text_id=5109 | speaker=unknown"
msgid "　この追いかけっこは、どちらかが息絶えるまで終わらない。"
msgstr "  This game of tag would not end until one of them was dead."

#. Occurrence 5A_7:2156:5110: scene=5A_7
#: 5A_7:2156
msgctxt "text_id=5110 | speaker=unknown"
msgid "　……まるでさっきの自分たちのようだと青子は自嘲する。"
msgstr "  She realized that she was in the same position she had cornered Soujyuro in earlier."

#. Occurrence 5A_7:2194:5111: scene=5A_7
#: 5A_7:2194
msgctxt "text_id=5111 | speaker=unknown"
msgid "　右腕をちらりと見る。"
msgstr "  She glanced at her right arm."

#. Occurrence 5A_7:2201:5112: scene=5A_7
#: 5A_7:2201
msgctxt "text_id=5112 | speaker=unknown"
msgid "　魔力残量はまだ半分以上もあるのに、このていたらくとは。"
msgstr "  She could not imagine how she had gotten into such a mess with her magical energy at more than half of its capacity."

#. Occurrence 5A_7:2206:5113: scene=5A_7
#: 5A_7:2206
msgctxt "text_id=5113 | speaker=unknown"
msgid "　面白がって草十郎を追いかけ回した<罰|ツケ>が、こんな形で回ってきた。"
msgstr "  This had to be karma for having enjoyed toying with Soujyuro earlier."

#. Occurrence 5A_7:2227:5114: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0010; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2227
msgctxt "text_id=5114 | speaker=aoko"
msgid "“……呆れた。居るところには居るものね、神さまって”"
msgstr "\"...Hah. Maybe there is a god after all.\""

#. Occurrence 5A_7:2254:5115: scene=5A_7
#: 5A_7:2254
msgctxt "text_id=5115 | speaker=unknown"
msgid "　ひとり<愚|ぐ><痴|ち>って、青子は意識を切り替える。"
msgstr "  She grumbled under her breath as she shifted her focus."

#. Occurrence 5A_7:2259:5116: scene=5A_7
#: 5A_7:2259
msgctxt "text_id=5116 | speaker=unknown"
msgid "　弾こそ撃てないがまだ燃料のある自分。"
msgstr "  She had the fuel for the fire but not the igniter."

#. Occurrence 5A_7:2264:5117: scene=5A_7
#: 5A_7:2264
msgctxt "text_id=5117 | speaker=unknown"
msgid "　尽きない動力で永久に追いかけてくる殺人機巧。"
msgstr "  And that killing machine would chase her until the end of time if need be."

#. Occurrence 5A_7:2269:5118: scene=5A_7
#: 5A_7:2269
msgctxt "text_id=5118 | speaker=unknown"
msgid "　なら、取るべき未来は明白すぎる。"
msgstr "  What she should do next was blindingly clear."

#. Occurrence 5A_7:2274:5119: scene=5A_7
#: 5A_7:2274
msgctxt "text_id=5119 | speaker=unknown"
msgid "　あとはいつもの自分に戻るだけだ。"
msgstr "  She had to get back to normal."

#. Occurrence 5A_7:2295:5120: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0008; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:2295
msgctxt "text_id=5120 | speaker=soujuurou"
msgid "「……蒼崎？」"
msgstr "\"...Aozaki?\""

#. Occurrence 5A_7:2332:5121: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0011; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2332
msgctxt "text_id=5121 | speaker=aoko"
msgid "「ごめん、考え事してた。"
msgstr "\"Sorry, I was thinking."

#. Occurrence 5A_7:2352:5122: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0012; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2352
msgctxt "text_id=5122 | speaker=aoko"
msgid "えっと、たしか……よし、あってる。静希君、そこに横道あるの、分かる？」"
msgstr "Hmm, maybe that could... Okay, Sizuki, I've got it. You see that side passage over there?\""

#. Occurrence 5A_7:2358:5123: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_7_0009; voice_prefix=A30; voice_category=3; scene=5A_7
#: 5A_7:2358
msgctxt "text_id=5123 | speaker=soujuurou"
msgid "「は？」"
msgstr "\"Huh?\""

#. Occurrence 5A_7:2403:5124: scene=5A_7
#: 5A_7:2403
msgctxt "text_id=5124 | speaker=unknown"
msgid "　青子が指さした先はどう見ても通路の壁で、横道なんて見あたらない。"
msgstr "  Aoko pointed, but he could see nothing but the walls of the corridor."

#. Occurrence 5A_7:2408:5125: scene=5A_7
#: 5A_7:2408
msgctxt "text_id=5125 | speaker=unknown"
msgid "　そもそもこのフロアは左に曲がるだけの造りで、青子が示しているのは右側に抜ける道だ。"
msgstr "  For one thing, the floor had nothing but left turns, and Aoko was pointing to the right."

#. Occurrence 5A_7:2436:5126: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0013; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2436
msgctxt "text_id=5126 | speaker=aoko"
msgid "「二階は中心までいくと一階に下りる階段があるんだけど、それは私が壊したから使えないの。"
msgstr "\"At the center of the second floor is a stairway down to the first floor, which I destroyed earlier so you couldn't use it."

#. Occurrence 5A_7:2442:5127: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0014; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2442
msgctxt "text_id=5127 | speaker=aoko"
msgid "　けどここの造りも意地が悪くてね。よく見れば右に曲がる通路もあるのよ。上級者だけに分かる抜け道ってヤツ。"
msgstr "  But there's another path that leads to the right, like this place is taunting you by design. It's a secret shortcut that only the hardcore fans know about."

#. Occurrence 5A_7:2448:5128: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0015; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2448
msgctxt "text_id=5128 | speaker=aoko"
msgid "　あとは注意して探せば、一階の階段までショートカットできる。悪いけどひとりで行って」"
msgstr "  If you search carefully, you can find a way to the stairs down to the first floor. Now do as I say and go on without me.\""

#. Occurrence 5A_7:2498:5129: scene=5A_7
#: 5A_7:2498
msgctxt "text_id=5129 | speaker=unknown"
msgid "　青子は草十郎に背を向けて歩きだした。"
msgstr "  Aoko turned her back to Soujyuro and started walking."

#. Occurrence 5A_7:2503:5130: scene=5A_7
#: 5A_7:2503
msgctxt "text_id=5130 | speaker=unknown"
msgid "　逃げ道である右に抜ける通路とは逆の、人形が追いかけてくる長い通路へと。"
msgstr "  Walking in the opposite direction of the escape route and down the long corridor toward the puppet in pursuit."

#. Occurrence 5A_7:2550:5131: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0016; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2550
msgctxt "text_id=5131 | speaker=aoko"
msgid "「あいつは無差別だから、ここで壊さないといけない。魔術師は魔術師同士で争うのはいいんだけど、みだりに一般人に手をだしちゃいけないって決まりがあるの。"
msgstr "\"That thing'll kill anything it sees, so I have to destroy it here and now. It's okay for two mages to fight each other, but dragging normal people into the conflict is strictly forbidden."

#. Occurrence 5A_7:2556:5132: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0017; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2556
msgctxt "text_id=5132 | speaker=aoko"
msgid "　あいつの目的は私のワケだし、結果がどうあれスッキリするでしょ？」"
msgstr "  I'm the target, so this the best outcome for everyone, don't you think?\""

#. Occurrence 5A_7:2593:5133: scene=5A_7
#: 5A_7:2593
msgctxt "text_id=5133 | speaker=unknown"
msgid "　青子が勝てば人形は壊れる。"
msgstr "  If Aoko won, the puppet would be destroyed."

#. Occurrence 5A_7:2598:5134: scene=5A_7
#: 5A_7:2598
msgctxt "text_id=5134 | speaker=unknown"
msgid "　青子が負けても目的完了という事で人形は停止する。"
msgstr "  If Aoko lost, its objective would be complete, and it would shut down."

#. Occurrence 5A_7:2603:5135: scene=5A_7
#: 5A_7:2603
msgctxt "text_id=5135 | speaker=unknown"
msgid "　どうあれ、ここで別れれば草十郎は無関係のまま生還できる。"
msgstr "  Either way, them going their separate ways would mean Soujyuro survived."

#. Occurrence 5A_7:2608:5136: scene=5A_7
#: 5A_7:2608
msgctxt "text_id=5136 | speaker=unknown"
msgid "　そういう事を青子は言っていた。"
msgstr "  This is what Aoko meant."

#. Occurrence 5A_7:2613:5137: scene=5A_7
#: 5A_7:2613
msgctxt "text_id=5137 | speaker=unknown"
msgid "　事務的に、あくまで他人事のように。"
msgstr "  Though she explained it as if the events were happening to two totally different people."

#. Occurrence 5A_7:2656:5138: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0018; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2656
msgctxt "text_id=5138 | speaker=aoko"
msgid "「運が良ければ入り口までたどり着けるわ。"
msgstr "\"If you're lucky enough, you'll make it back to the gate in one piece."

#. Occurrence 5A_7:2662:5139: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_7_0019; voice_prefix=A10; voice_category=1; scene=5A_7
#: 5A_7:2662
msgctxt "text_id=5139 | speaker=aoko"
msgid "　それじゃ、また明日ね」"
msgstr "  So, see you tomorrow then.\""

#. Occurrence 5A_7:2697:5140: scene=5A_7
#: 5A_7:2697
msgctxt "text_id=5140 | speaker=unknown"
msgid "　強がりであるのは草十郎ですら感じ取れた。"
msgstr "  Even Soujyuro could tell she was just trying to act tough."

#. Occurrence 5A_7:2702:5141: scene=5A_7
#: 5A_7:2702
msgctxt "text_id=5141 | speaker=unknown"
msgid "　けれど止める間も、その必要もなく、彼女は曲がり角に消えていった。"
msgstr "  But she had already disappeared around the corner by the time he thought to stop her."

#. Occurrence 5A_8:67:5142: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0000; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:67
msgctxt "text_id=5142 | speaker=aoko"
msgid "「―――さて」"
msgstr "\"...Well, then.\""

#. Occurrence 5A_8:73:5143: scene=5A_8
#: 5A_8:73
msgctxt "text_id=5143 | speaker=unknown"
msgid "　本格的にまずい事になったな、と青子は心中で呟いた。"
msgstr "  Mentally, Aoko bemoaned the disaster she was in."

#. Occurrence 5A_8:78:5144: scene=5A_8
#: 5A_8:78
msgctxt "text_id=5144 | speaker=unknown"
msgid "　今回の<人|て><形|き>は二日前の公園で倒したものとは<品|か><質|く>が違う。"
msgstr "  The quality of this puppet was on a completely different level compared to the one from the park two days ago."

#. Occurrence 5A_8:83:5145: scene=5A_8
#: 5A_8:83
msgctxt "text_id=5145 | speaker=unknown"
msgid "　自動詠唱による永久機関だけでも稀少品なのに、腕を伸ばすという荒事にも耐え、両目は<呪詛|ガンド>を投影する水晶製ときた。"
msgstr "  An auto-incanting perpetual motion machine was a rarity in and of itself, but this puppet was also equipped for battle with its extending arms and Gandr-projecting crystalline eyes."

#. Occurrence 5A_8:88:5146: scene=5A_8
#: 5A_8:88
msgctxt "text_id=5146 | speaker=unknown"
msgid "　日本円に換算すれば九桁に届きかねない超一級品である。"
msgstr "  It was a first-class product that, if put on the market, would sell for hundreds of millions of yen."

#. Occurrence 5A_8:123:5147: scene=5A_8
#: 5A_8:123
msgctxt "text_id=5147 | speaker=unknown"
msgid "　ただし。それはあくまでアンティークとしての話。"
msgstr "  Although, that was only when factoring in its value as an antique."

#. Occurrence 5A_8:128:5148: scene=5A_8
#: 5A_8:128
msgctxt "text_id=5148 | speaker=unknown"
msgid "　戦闘に<用|もち>いるのなら、もっと安価で、かつ戦いに適した使い魔を動員すべきだろうに。"
msgstr "  For the purposes of combat, it would have made more sense to mobilize a significantly less expensive familiar."

#. Occurrence 5A_8:133:5149: scene=5A_8
#: 5A_8:133
msgctxt "text_id=5149 | speaker=unknown"
msgid "　あれだけの高級品を殺人に用いるあたり、あの人形の持ち主は今までの“敵”とは一線を画した変態に違いない。"
msgstr "  To use such a precious commodity as a tool for murder marked this puppet's master as a completely different breed of crazy from the enemies she had faced up until now."

#. Occurrence 5A_8:333:5150: voice_id=C40_5A_8_0000_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:333
msgctxt "text_id=5150 | speaker=unknown"
msgid "“<Vivo|ウィウォ> <in|イン> <somno|スォムノ>. <Solitarie|スォリタリエ> <putresco|プトゥレスコ> <in|イン> <inferis|インフェリス>."
msgstr "  \"Vivo in somno. Solitarie putresco in inferis."

#. Occurrence 5A_8:333:5151: voice_id=C40_5A_8_0000_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:333
msgctxt "text_id=5151 | speaker=unknown"
msgid "@o<Hic|ヒク> <dies|ディエス> <meus|メウス> <obitus|オビトゥス> <dies|ディエス>, <et|エトゥ> <meus|メウス> <nativus|ナティウゥス> <dies|ディエス>. <Te|テ> <obeam|オベアム>.”"
msgstr "    Hic dies meus obitus dies, et meus nativus dies. Te obeam.\""

#. Occurrence 5A_8:469:5152: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0001; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:469
msgctxt "text_id=5152 | speaker=aoko"
msgid "「―――来たわね」"
msgstr "\"...Here it comes.\""

#. Occurrence 5A_8:475:5153: scene=5A_8
#: 5A_8:475
msgctxt "text_id=5153 | speaker=unknown"
msgid "　がさついたオルゴール。"
msgstr "  A sound of a crackling music box filled the air."

#. Occurrence 5A_8:480:5154: scene=5A_8
#: 5A_8:480
msgctxt "text_id=5154 | speaker=unknown"
msgid "　自らを呪う事で動力を得る<自動人形|オートマタ>が近づいてくる。"
msgstr "  The automata, animated by its own curses, approached."

#. Occurrence 5A_8:485:5155: scene=5A_8
#: 5A_8:485
msgctxt "text_id=5155 | speaker=unknown"
msgid "　通路の長さは約十メートル。青子は一つ奥の曲がり角で、人形が現れるのを待ちかまえる。"
msgstr "  The corridor measured approximately thirty feet in length. Aoko lay in wait around a corner further down the hall, anticipating the puppet's appearance."

#. Occurrence 5A_8:548:5156: scene=5A_8
#: 5A_8:548
msgctxt "text_id=5156 | speaker=unknown"
msgid "　……ここで決着をつけるのは静希草十郎を逃がす為ではない。断じてない。"
msgstr "  This was not to buy Soujyuro time to escape. Far from it."

#. Occurrence 5A_8:553:5157: scene=5A_8
#: 5A_8:553
msgctxt "text_id=5157 | speaker=unknown"
msgid "　青子は的確に、今の自分ではあの人形からは逃げきれないと判断しただけだ。"
msgstr "  Aoko had concluded that she couldn't make a break for it under the current circumstances."

#. Occurrence 5A_8:573:5158: scene=5A_8
#: 5A_8:573
msgctxt "text_id=5158 | speaker=unknown"
msgid "　仮に逃走を選んだ場合、幾つかの幸運が働いてミラーハウスから出られたとしてもそこまで。"
msgstr "  Even if she did try to escape, and―by some miracle―made it out of the house of mirrors, that was as far as she would go."

#. Occurrence 5A_8:578:5159: scene=5A_8
#: 5A_8:578
msgctxt "text_id=5159 | speaker=unknown"
msgid "　障害物のない外に出ればあっさりと追いつかれ、背中から串刺しにされる。"
msgstr "  Outside, with no cover, Aoko would quickly be overtaken and skewered from behind."

#. Occurrence 5A_8:603:5160: scene=5A_8
#: 5A_8:603
msgctxt "text_id=5160 | speaker=unknown"
msgid "　魔術が封じられている以上、追っ手から逃げきるのは不可能だ。"
msgstr "  As long as her magecraft was disabled, escape was impossible."

#. Occurrence 5A_8:608:5161: scene=5A_8
#: 5A_8:608
msgctxt "text_id=5161 | speaker=unknown"
msgid "　なので、ここで撃退する選択をとる。"
msgstr "  Instead, she chose to force the enemy back."

#. Occurrence 5A_8:613:5162: scene=5A_8
#: 5A_8:613
msgctxt "text_id=5162 | speaker=unknown"
msgid "　状況は不利だが、それはあちらも同じこと。"
msgstr "  Her situation was not the most favorable, but neither was the puppet's."

#. Occurrence 5A_8:680:5163: scene=5A_8
#: 5A_8:680
msgctxt "text_id=5163 | speaker=unknown"
msgid "　この細い通路では青子に逃げ場はないが、反面、あの人形も全速を出せずにいる。"
msgstr "  Though this narrow hall gave Aoko no place to run, it in turn prevented the puppet from reaching full speed."

#. Occurrence 5A_8:685:5164: scene=5A_8
#: 5A_8:685
msgctxt "text_id=5164 | speaker=unknown"
msgid "　機械仕掛けの欠点だ。"
msgstr "  That was the weak point of this machine."

#. Occurrence 5A_8:690:5165: scene=5A_8
#: 5A_8:690
msgctxt "text_id=5165 | speaker=unknown"
msgid "　<小刻|こきざ>みな加速と減速は、あの時代のオートマタにとっても苦手とする機能だろう。"
msgstr "  Automata of its era had a tendency to struggle with minute changes in speed."

#. Occurrence 5A_8:752:5166: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0002; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:752
msgctxt "text_id=5166 | speaker=aoko"
msgid "「―――<接続|セット>」"
msgstr "\"...<Connecting|Set.>.\""

#. Occurrence 5A_8:815:5167: scene=5A_8
#: 5A_8:815
msgctxt "text_id=5167 | speaker=unknown"
msgid "　断線だらけの魔術回路に魔力を流す。"
msgstr "  She flowed energy into her shorted circuits."

#. Occurrence 5A_8:820:5168: scene=5A_8
#: 5A_8:820
msgctxt "text_id=5168 | speaker=unknown"
msgid "　……血液の流れ、魔力の供給がまったく安定しない。"
msgstr "  Her blood flow and magical energy supply were unstable."

#. Occurrence 5A_8:825:5169: scene=5A_8
#: 5A_8:825
msgctxt "text_id=5169 | speaker=unknown"
msgid "　これでは魔術式を組むのは難しい。"
msgstr "  It would be difficult to construct a formula in this state."

#. Occurrence 5A_8:831:5170: scene=5A_8
#: 5A_8:831
msgctxt "text_id=5170 | speaker=unknown"
msgid "　魔力で右手を加工し、大雑把に硬度を上げる事しかできない。"
msgstr "  All she could do was harden her right arm by imbuing it with as much energy as she could."

#. Occurrence 5A_8:837:5171: scene=5A_8
#: 5A_8:837
msgctxt "text_id=5171 | speaker=unknown"
msgid "青子の武器はトンカチ以上、バット未満の<細腕|ほそうで><鈍器|どんき>だ。近づく事が前提の時点で、この上なく頼りない。"
msgstr "Doing so turned her arm into an improvised weapon like a hammer or bat. Assuming she could manage to get into close-combat range, this was the best she could do."

#. Occurrence 5A_8:923:5172: scene=5A_8
#: 5A_8:923
msgctxt "text_id=5172 | speaker=unknown"
msgid "　となると、あとは戦法だ。"
msgstr "  All she needed now was a plan of attack."

#. Occurrence 5A_8:928:5173: scene=5A_8
#: 5A_8:928
msgctxt "text_id=5173 | speaker=unknown"
msgid "　今はどんな武器を用意するかではなく、この武器でどう戦うかを選ばなくては。"
msgstr "  The question wasn't what weapon to use, but how to use the weapon she had."

#. Occurrence 5A_8:933:5174: scene=5A_8
#: 5A_8:933
msgctxt "text_id=5174 | speaker=unknown"
msgid "　簡単に考えつくのは鏡の反射を利用して姿を隠し、死角から襲いかかる―――しかし、それは通じまい。"
msgstr "  The simplest way would be to use the mirrors' reflections to hide and then rush the puppet from its blind spot... except for one major problem."

#. Occurrence 5A_8:953:5175: scene=5A_8
#: 5A_8:953
msgctxt "text_id=5175 | speaker=unknown"
msgid "　なぜなら、あの人形にはもともと視覚がない。"
msgstr "  It did not have a sense of sight in the first place."

#. Occurrence 5A_8:958:5176: scene=5A_8
#: 5A_8:958
msgctxt "text_id=5176 | speaker=unknown"
msgid "　人形は視覚情報からではなく、周囲の地形状況から世界を視ている。"
msgstr "  The puppet's view of the world around it did not stem from visual feedback, but from mapping the topography of its surroundings."

#. Occurrence 5A_8:963:5177: scene=5A_8
#: 5A_8:963
msgctxt "text_id=5177 | speaker=unknown"
msgid "　暗闇に棲息するコウモリと同じ理屈だ。高音の波を発し、その反響によって周囲の地形を<測|はか>る反響定位法。"
msgstr "  In theory, it was the same as a bat's echolocation. The environment could be measured based on the emission and return of high-frequency sound waves."

#. Occurrence 5A_8:968:5178: scene=5A_8
#: 5A_8:968
msgctxt "text_id=5178 | speaker=unknown"
msgid "　あの詠唱は<音波|センサー>の役割も果たしている。人形にとって壁は透明の板にすぎず、物陰からの奇襲なぞお笑い草だろう。"
msgstr "  Those chants served as sensor pulses. As far as the puppet was concerned, the mirrors were no better than transparent panes, making even the thought of an ambush laughable."

#. Occurrence 5A_8:994:5179: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0003; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:994
msgctxt "text_id=5179 | speaker=aoko"
msgid "“……近づけば近づくほど、より<明確|リアル>に察知される……ホントは遠距離からの狙撃が最適なんだけど……ガンドを撃ってくるなら、フィンの一撃ぐらい隠してるわよね……”"
msgstr "(...The closer it gets, the more it's able to sense me. I'd really rather fight it at a distance, but... if it's shooting Gandr, it's probably got at least a Finn Shot up its sleeve, too.)"

#. Occurrence 5A_8:1063:5180: scene=5A_8
#: 5A_8:1063
msgctxt "text_id=5180 | speaker=unknown"
msgid "　ガンド撃ちは北欧に伝わる、単純にして汎用性の高い呪詛だ。最適化されたものは“指をさす”だけで相手の体調を悪化させる。"
msgstr "  Gandr was Scandinavian in origin and, considering its simplicity, highly versatile. It was most effective at impairing a target's health by pointing a finger."

#. Occurrence 5A_8:1068:5181: scene=5A_8
#: 5A_8:1068
msgctxt "text_id=5181 | speaker=unknown"
msgid "　<一工程|シングルアクション>の魔術なので効果はあくまで“<病|やまい>”に限定されるが、ガンド撃ちには最奥と言われる秘術がある。"
msgstr "  As a single-action magecraft, it was limited to only causing illness, but there was a secret technique said to be the greatest mastery of the Gandr Shot..."

#. Occurrence 5A_8:1073:5182: scene=5A_8
#: 5A_8:1073
msgctxt "text_id=5182 | speaker=unknown"
msgid "　<曰|いわ>く“フィンの一撃”。"
msgstr "  The Finn Shot."

#. Occurrence 5A_8:1078:5183: scene=5A_8
#: 5A_8:1078
msgctxt "text_id=5183 | speaker=unknown"
msgid "　病ではなく、受けた相手の心臓を停止させる死の呪い。"
msgstr "  It could do more than cause simple illness. It was a deadly curse that could stop the heart."

#. Occurrence 5A_8:1186:5184: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0004; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:1186
msgctxt "text_id=5184 | speaker=aoko"
msgid "「…………っ」"
msgstr "\"...Nnngh.\""

#. Occurrence 5A_8:1193:5185: scene=5A_8
#: 5A_8:1193
msgctxt "text_id=5185 | speaker=unknown"
msgid "　背中に受けた傷が神経を<昂|たか>ぶらせる。"
msgstr "  The wound on her back set her nerves on fire."

#. Occurrence 5A_8:1198:5186: scene=5A_8
#: 5A_8:1198
msgctxt "text_id=5186 | speaker=unknown"
msgid "　武器を失った小娘と、即死の奥の手を持つ自動人形。"
msgstr "  An unarmed girl and a deadly automaton."

#. Occurrence 5A_8:1203:5187: scene=5A_8
#: 5A_8:1203
msgctxt "text_id=5187 | speaker=unknown"
msgid "　誰がどう見ても殺されるのは自分の方。"
msgstr "  It was clear that she was the one destined for death."

#. Occurrence 5A_8:1208:5188: scene=5A_8
#: 5A_8:1208
msgctxt "text_id=5188 | speaker=unknown"
msgid "　彼女は、現状の蒼<崎青|じぶん>子に生き延びる手段は<乏|とぼ>しいと考え、"
msgstr "  She considered her slim chances of survival."

#. Occurrence 5A_8:1208:5189: scene=5A_8
#: 5A_8:1208
msgctxt "text_id=5189 | speaker=unknown"
msgid "　そして―――"
msgstr "  When..."

#. Occurrence 5A_8:1347:5190: scene=5A_8
#: 5A_8:1347
msgctxt "text_id=5190 | speaker=unknown"
msgid "　その幻視に、ぞくりとした。"
msgstr "  A vision sent chills down her spine."

#. Occurrence 5A_8:1368:5191: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0005; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:1368
msgctxt "text_id=5191 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5A_8:1374:5192: scene=5A_8
#: 5A_8:1374
msgctxt "text_id=5192 | speaker=unknown"
msgid "　青子は静かに、<努|つと>めて全霊で、いつもの錯覚を堪え忍ぶ。"
msgstr "  Quietly, using everything she could to clamp down on the feeling, Aoko faced her all-too-familiar illusion."

#. Occurrence 5A_8:1379:5193: scene=5A_8
#: 5A_8:1379
msgctxt "text_id=5193 | speaker=unknown"
msgid "　カチカチと鳴りそうな奥歯をきっと噛みしめる。"
msgstr "  She clenched her teeth to keep them from making a deafening clatter."

#. Occurrence 5A_8:1384:5194: scene=5A_8
#: 5A_8:1384
msgctxt "text_id=5194 | speaker=unknown"
msgid "　ああ、でも、首筋にナニモノかの指が<這|は>っていく感触がある。背後にいる<幽霊|さっかく>が彼女を見て笑っている。"
msgstr "  But there, the sensation of fingers crawling up her neck. Behind her the specter stared and laughed."

#. Occurrence 5A_8:1389:5195: scene=5A_8
#: 5A_8:1389
msgctxt "text_id=5195 | speaker=unknown"
msgid "　それだけで逃げだす一歩手前なのに、五秒後の<脳内予測|シミュレート>では、十戦して二回も倒れる自分の姿。"
msgstr "  This alone made Aoko want to bolt. On top of it all, when Aoko tried to mentally simulate the coming fight, she estimated a two in ten chance of dying in the first five seconds."

#. Occurrence 5A_8:1531:5196: scene=5A_8
#: 5A_8:1531
msgctxt "text_id=5196 | speaker=unknown"
msgid "　……二回。彼女の予測は時に現実よりも現実的だ。"
msgstr "  ...Twenty percent. At times, her predictions were harsher than reality."

#. Occurrence 5A_8:1537:5197: scene=5A_8
#: 5A_8:1537
msgctxt "text_id=5197 | speaker=unknown"
msgid "　……十回やって、二回。イメージに留まらない、あまりに<真実|リアル>な自分の亡骸たちを幻視する。"
msgstr "  If Aoko fought the puppet ten times, she would die twice. She could not stop herself from visualizing her own corpse."

#. Occurrence 5A_8:1558:5198: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0006; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:1558
msgctxt "text_id=5198 | speaker=aoko"
msgid "「――――――、っ」"
msgstr "\"...\""

#. Occurrence 5A_8:1564:5199: scene=5A_8
#: 5A_8:1564
msgctxt "text_id=5199 | speaker=unknown"
msgid "　人形の呪いを受けて倒れている自分。"
msgstr "  She imagined herself collapsing, crumpling under the puppet's curse."

#. Occurrence 5A_8:1570:5200: scene=5A_8
#: 5A_8:1570
msgctxt "text_id=5200 | speaker=unknown"
msgid "　眼球は<河|フ><豚|グ>のようにこぼれかけ、<耳鼻口|みみはなくち>からだらしなく垂れる血小便。"
msgstr "  Her eyeballs swollen like a blowfish, blood and other fluids oozing from every bodily orifice."

msgctxt "text_id=5201 | speaker=unknown"
msgid "二回、二回、二回。"
msgstr " One in five, one in five, one in five..."

msgctxt "text_id=5202 | speaker=unknown"
msgid "一回だけでも耐えられないのに、二回も死ぬなんて、とても正気じゃいられない……！"
msgstr " A one in ten chance of death was bad enough, but one in five!? It drove her crazy."

#. Occurrence 5A_8:1662:5203: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0007; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:1662
msgctxt "text_id=5203 | speaker=aoko"
msgid "「―――、―――でも」"
msgstr "\"...But...\""

#. Occurrence 5A_8:1668:5204: scene=5A_8
#: 5A_8:1668
msgctxt "text_id=5204 | speaker=unknown"
msgid "　ねじ曲がろうとする心を<抑|おさ>える。"
msgstr "  Aoko forced down her heart as it tried to escape from her mouth."

#. Occurrence 5A_8:1673:5205: scene=5A_8
#: 5A_8:1673
msgctxt "text_id=5205 | speaker=unknown"
msgid "　青子は深呼吸をして、それがどうした、と鏡に映る自分を見つめ返した。"
msgstr "  Taking in a deep breath, she peered at her own reflection."

#. Occurrence 5A_8:1762:5206: scene=5A_8
#: 5A_8:1762
msgctxt "text_id=5206 | speaker=unknown"
msgid "　―――半年前の、あの白い夜を思い出せ。"
msgstr "  She thought back to that white night, half a year ago."

#. Occurrence 5A_8:1767:5207: scene=5A_8
#: 5A_8:1767
msgctxt "text_id=5207 | speaker=unknown"
msgid "　この程度、ピンチでもなんでもない。"
msgstr "  This, she decided, was nothing compared to that."

#. Occurrence 5A_8:1772:5208: scene=5A_8
#: 5A_8:1772
msgctxt "text_id=5208 | speaker=unknown"
msgid "　半年前の久遠寺の洋館。"
msgstr "  Six months ago, at the Kuonji Estate..."

#. Occurrence 5A_8:1777:5209: scene=5A_8
#: 5A_8:1777
msgctxt "text_id=5209 | speaker=unknown"
msgid "　深い霧に現れた<白薔薇|しろばら>の<猟犬|ワンダースナッチ>に、自分は十回中<百|・><回|・>は殺されたのではなかったか。"
msgstr "  The hound of white roses, the Wandersnatch that appeared from within the thick fog, had killed Aoko a hundred times out of ten. "

#. Occurrence 5A_8:1836:5210: voice_id=C40_5A_8_0001_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:1836
msgctxt "text_id=5210 | speaker=unknown"
msgid "“<Me|メア>a <ani|アニマ>ma <immorta|イムモルタリス>lis. <Aute|アウテム>m <me|メア>a <futu|フトゥラ>ra <nec|ネカタ>ata <sunt|スントゥ>."
msgstr "\"Mea anima immortalis. Autem mea futura necata sunt."

#. Occurrence 5A_8:1836:5211: voice_id=C40_5A_8_0001_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:1836
msgctxt "text_id=5211 | speaker=unknown"
msgid "　<Man|マネス>es <su|スム>m. <Anim|アニマム>am <defin|デフィニレ>ire <ambigu|アンビグウム>um <est.|エストゥ>”"
msgstr "  Manes sum. Animam definire ambiguum est.\""

#. Occurrence 5A_8:1856:5212: scene=5A_8
#: 5A_8:1856
msgctxt "text_id=5212 | speaker=unknown"
msgid "　青子の錯覚は、その<昏|くら>い呪詛によってかき消えた。"
msgstr "  A dark curse shattered Aoko's daydream."

#. Occurrence 5A_8:1856:5213: scene=5A_8
#: 5A_8:1856
msgctxt "text_id=5213 | speaker=unknown"
msgid "　距離にして約十メートル。"
msgstr "  It was only thirty feet away."

#. Occurrence 5A_8:1861:5214: scene=5A_8
#: 5A_8:1861
msgctxt "text_id=5214 | speaker=unknown"
msgid "　対面の曲がり角に少女の人形が現れる。"
msgstr "  The puppet rounded the corner."

#. Occurrence 5A_8:1866:5215: scene=5A_8
#: 5A_8:1866
msgctxt "text_id=5215 | speaker=unknown"
msgid "　お互い、<輪郭|りんかく>もはっきりしない影の間合い。"
msgstr "  Either side stood in the shadows, their forms indistinct."

#. Occurrence 5A_8:2032:5216: scene=5A_8
#: 5A_8:2032
msgctxt "text_id=5216 | speaker=unknown"
msgid "　人形には前口上も初動もない。"
msgstr "  The puppet gave no warning."

#. Occurrence 5A_8:2037:5217: scene=5A_8
#: 5A_8:2037
msgctxt "text_id=5217 | speaker=unknown"
msgid "　気配の起こりもなく撃ち出される<呪詛|ガンド>を、"
msgstr "  Without preamble, it swiftly fired a Gandr barrage."

#. Occurrence 5A_8:2146:5218: scene=5A_8
#: 5A_8:2146
msgctxt "text_id=5218 | speaker=unknown"
msgid "　青子は予測通り、魔力の霧で<削|けず>り<防|ふせ>ぐ。"
msgstr "  Just as Aoko planned, the curses fizzled out as they hit her mist-like barrier of magical energy."

#. Occurrence 5A_8:2306:5219: scene=5A_8
#: 5A_8:2306
msgctxt "text_id=5219 | speaker=unknown"
msgid "　わずか数秒の濃霧。"
msgstr "  The protection would only last a few seconds."

#. Occurrence 5A_8:2311:5220: scene=5A_8
#: 5A_8:2311
msgctxt "text_id=5220 | speaker=unknown"
msgid "　その隙をついて、"
msgstr "  Giving her just enough time to..."

#. Occurrence 5A_8:2356:5221: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0008; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:2356
msgctxt "text_id=5221 | speaker=aoko"
msgid "“―――来い！”"
msgstr "(...Come on!)"

#. Occurrence 5A_8:2362:5222: scene=5A_8
#: 5A_8:2362
msgctxt "text_id=5222 | speaker=unknown"
msgid "　伸縮する槍が、青子の顔へ撃ちだされる！"
msgstr "  Its stretchable spear sprang toward Aoko's face!"

#. Occurrence 5A_8:2515:5223: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0009; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:2515
msgctxt "text_id=5223 | speaker=aoko"
msgid "「っ、ビンゴ―――！」"
msgstr "\"Bingo!\""

#. Occurrence 5A_8:2557:5224: scene=5A_8
#: 5A_8:2557
msgctxt "text_id=5224 | speaker=unknown"
msgid "　横顔をかすめる凶器。"
msgstr "  The lethal weapon grazed her cheek."

#. Occurrence 5A_8:2562:5225: scene=5A_8
#: 5A_8:2562
msgctxt "text_id=5225 | speaker=unknown"
msgid "　死角からの攻撃を紙一重で<躱|かわ>せたのは、人形の攻撃パターンを既に経験していたからだ。"
msgstr "  All her experience analyzing puppet attack patterns gave her the wherewithal to evade the attack by a hair's breadth."

#. Occurrence 5A_8:2613:5226: scene=5A_8
#: 5A_8:2613
msgctxt "text_id=5226 | speaker=unknown"
msgid "　術者が操っているのならともかく、自律している自動人形の機能は限られている。"
msgstr "  It was one thing if a puppeteer were pulling the strings, but autonomous dolls had their limitations."

#. Occurrence 5A_8:2618:5227: scene=5A_8
#: 5A_8:2618
msgctxt "text_id=5227 | speaker=unknown"
msgid "　この距離ならこの攻撃、といったテンプレートを行うだけの殺戮機巧なら対応できると、青子は己の運に賭けたのだ。"
msgstr "  Aoko had bet everything on this killing machine following a predefined template. The puppet would use a given attack for a given range, and she could adjust her tactics to that."

#. Occurrence 5A_8:2742:5228: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0010; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:2742
msgctxt "text_id=5228 | speaker=aoko"
msgid "“いける、このまま―――！”"
msgstr "(Now's my chance!)"

#. Occurrence 5A_8:2748:5229: scene=5A_8
#: 5A_8:2748
msgctxt "text_id=5229 | speaker=unknown"
msgid "　伸びきった腕が巻き戻る前に、人形へ突撃する。"
msgstr "  Before its arm had a chance to fully retract, she charged the puppet."

#. Occurrence 5A_8:2753:5230: scene=5A_8
#: 5A_8:2753
msgctxt "text_id=5230 | speaker=unknown"
msgid "　勝算の薄い賭けではあったが、ともかく<勝機|しょうき>はもぎ取った。"
msgstr "  It was a risky gamble, but her overall chances were slim to begin with."

#. Occurrence 5A_8:2758:5231: scene=5A_8
#: 5A_8:2758
msgctxt "text_id=5231 | speaker=unknown"
msgid "　勝利の天秤は青子に<傾|かたむ>いた。"
msgstr "  The scales tipped in her favor."

#. Occurrence 5A_8:2866:5232: scene=5A_8
#: 5A_8:2866
msgctxt "text_id=5232 | speaker=unknown"
msgid "　予測による十回中二回の死は、あの間合いでフィンの一撃を使われた場合と。"
msgstr "  If her predictions were correct, there were two ways she would die. One was from a Finn Shot fired at that range."

#. Occurrence 5A_8:3046:5233: scene=5A_8
#: 5A_8:3046
msgctxt "text_id=5233 | speaker=unknown"
msgid "　このように。"
msgstr "  And the other..."

#. Occurrence 5A_8:3051:5234: scene=5A_8
#: 5A_8:3051
msgctxt "text_id=5234 | speaker=unknown"
msgid "　人形の攻撃パターンが、彼女の予想を大きく上まわった場合である。"
msgstr "  The other was if the puppet's attack pattern was beyond her ability to foresee."

#. Occurrence 5A_8:3072:5235: scene=5A_8
#: 5A_8:3072
msgctxt "text_id=5235 | speaker=unknown"
msgid "　一瞬の質量移動。"
msgstr "  Instantaneous mass transfer."

#. Occurrence 5A_8:3078:5236: scene=5A_8
#: 5A_8:3078
msgctxt "text_id=5236 | speaker=unknown"
msgid "あるいは<積載|せきさい>。"
msgstr "Otherwise known as mass displacement."

#. Occurrence 5A_8:3084:5237: scene=5A_8
#: 5A_8:3084
msgctxt "text_id=5237 | speaker=unknown"
msgid "　青子が人形の腕という槍を<躱|かわ>した直後、"
msgstr "  Immediately after Aoko dodged the puppet's arm,"

#. Occurrence 5A_8:3089:5238: scene=5A_8
#: 5A_8:3089
msgctxt "text_id=5238 | speaker=unknown"
msgid "　正体不明の重量が、彼女の腹部に激突していた。"
msgstr "  something smashed into her abdomen."

#. Occurrence 5A_8:3196:5239: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0011; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:3196
msgctxt "text_id=5239 | speaker=aoko"
msgid "「ご、ぶっ……！」"
msgstr "\"GAH!\""

#. Occurrence 5A_8:3202:5240: scene=5A_8
#: 5A_8:3202
msgctxt "text_id=5240 | speaker=unknown"
msgid "　ロケットで撃ち出されたとしか思えない、肩口からの正面衝突。"
msgstr "  The head-on collision from its shoulder felt like a rocket."

#. Occurrence 5A_8:3207:5241: scene=5A_8
#: 5A_8:3207
msgctxt "text_id=5241 | speaker=unknown"
msgid "　しかし、その推進力は何処から出たものなのか。"
msgstr "  But where had the ability to propel itself come from?"

#. Occurrence 5A_8:3212:5242: scene=5A_8
#: 5A_8:3212
msgctxt "text_id=5242 | speaker=unknown"
msgid "　自らを飛ばす機能なぞ、あの人形は持ち合わせていないというのに……！"
msgstr "  Puppets like this were not built to have the ability to jet around like that."

#. Occurrence 5A_8:3260:5243: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0012; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:3260
msgctxt "text_id=5243 | speaker=aoko"
msgid "“は―――、は―――！”"
msgstr "\"Hah... hah...\""

#. Occurrence 5A_8:3265:5244: scene=5A_8
#: 5A_8:3265
msgctxt "text_id=5244 | speaker=unknown"
msgid "　激痛で<薄|うす>れかける意識を<留|とど>めながら、青子は即座に攻撃の正体を看破した。"
msgstr "  Doing everything in her power to stay conscious in spite of the pain, Aoko could just make out what had happened."

#. Occurrence 5A_8:3272:5245: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0013; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:3272
msgctxt "text_id=5245 | speaker=aoko"
msgid "“今の、<推進力|すいしんりょく>じゃなくて、<牽引力|けんいんりょく>……！”"
msgstr "(It wasn't propelled, it was pulled!)"

#. Occurrence 5A_8:3278:5246: scene=5A_8
#: 5A_8:3278
msgctxt "text_id=5246 | speaker=unknown"
msgid "　そう。人形の腕は本体に戻るのではなく、壁に突き刺さったまま、本体を<引|・><き|・><寄|・><せ|・><た|・>のだ……！"
msgstr "  Yes. The puppet's arm had not returned to its body. It was lodged in the wall and reeled itself in from the other direction."

#. Occurrence 5A_8:3307:5247: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0014; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:3307
msgctxt "text_id=5247 | speaker=aoko"
msgid "“そ、そんなのアリか―――！？”"
msgstr "(It... it can do that?!)"

#. Occurrence 5A_8:3313:5248: scene=5A_8
#: 5A_8:3313
msgctxt "text_id=5248 | speaker=unknown"
msgid "　青子は驚きを飲み下しながら、必死に体勢を立て直す。"
msgstr "  Swallowing her surprise, she hastily pulled herself back up."

#. Occurrence 5A_8:3392:5249: scene=5A_8
#: 5A_8:3392
msgctxt "text_id=5249 | speaker=unknown"
msgid "　腹部、<横隔膜|おうかくまく>を強打された。"
msgstr "  Her abdomen, specifically her diaphragm, had been dealt a significant blow."

#. Occurrence 5A_8:3399:5250: scene=5A_8
#: 5A_8:3399
msgctxt "text_id=5250 | speaker=unknown"
msgid "衝撃で目も<眩|くら>んでいる。"
msgstr "The attack left her disoriented."

#. Occurrence 5A_8:3406:5251: scene=5A_8
#: 5A_8:3406
msgctxt "text_id=5251 | speaker=unknown"
msgid "だが人形は驚くほど軽い。"
msgstr "Thankfully, the puppet was surprisingly lightweight."

#. Occurrence 5A_8:3413:5252: scene=5A_8
#: 5A_8:3413
msgctxt "text_id=5252 | speaker=unknown"
msgid "おかげで骨にも内臓にも深刻なダメージはないが、とにかく呼吸ができない。"
msgstr "Her bones and organs were intact, and she had sustained no life-threatening damage. She was having a hard time breathing, however."

#. Occurrence 5A_8:3420:5253: scene=5A_8
#: 5A_8:3420
msgctxt "text_id=5253 | speaker=unknown"
msgid "気は動転しているけど根っこの部分ではまだ冷静だ、あと二秒もあれば持ち直す。いや違う、マトモになるまであと二秒もかかってしまう！"
msgstr "She was shaken, though she managed to keep her calm. In another two seconds, she'd be back on her feet―no, that was two seconds too long!"

#. Occurrence 5A_8:3440:5254: scene=5A_8
#: 5A_8:3440
msgctxt "text_id=5254 | speaker=unknown"
msgid "　いやいや落ち着け、もう落ち着いている、クラクラして位置関係が把握できないだけ、いい、今は呼吸も視力も後回しで、とにかく体を―――"
msgstr "  She told herself to calm down, that she was already calm. She'd only briefly lost her bearings, she was fine, she could recover her breath and her vision later if only her body would MOVE―"

#. Occurrence 5A_8:3462:5255: voice_id=C40_5A_8_0002_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:3462
msgctxt "text_id=5255 | speaker=unknown"
msgid "“<知性は不必要でした|インテルレクトゥス・ノン・ネケススァリウス・エストゥ>。<敬虔さは重荷でした|ピウス・クウィエスカトゥ>。<ああ、私たち|オ・ノストゥラ><の本質は奪い合いで|エススェンティア・アブラタ・フイトゥ>、<理性は全て後付けでした|ラティオ・フィクサァ・タントゥム・エストゥ>。<苦しみのも|ドロリス・イニティウム><とは、脳髄でした|ケレブルム・フイトゥ>”"
msgstr "\"Intellectus non necessarius est. Pius quiescat.^ O nostra essentia ablata fuit,^ratio fixa tantum est.^ Doloris initium cerebrum fuit.\""

#. Occurrence 5A_8:3468:5256: scene=5A_8
#: 5A_8:3468
msgctxt "text_id=5256 | speaker=unknown"
msgid "　頭上には<歪|ゆが>みをあげる駆動音。"
msgstr "  Above her Aoko could hear the warped noise of a powerful force."

#. Occurrence 5A_8:3475:5257: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0015; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:3475
msgctxt "text_id=5257 | speaker=aoko"
msgid "“足、動け……！　でもどっち、どっちにいけば―――”"
msgstr "(Come on legs, move! We've got to get to... to... Where!?)"

#. Occurrence 5A_8:3560:5258: scene=5A_8
#: 5A_8:3560
msgctxt "text_id=5258 | speaker=unknown"
msgid "　死の手触りがする。"
msgstr "  She could once more feel the touch of death."

#. Occurrence 5A_8:3567:5259: voice_id=C40_5A_8_0003_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:3567
msgctxt "text_id=5259 | speaker=unknown"
msgid "“<我々に救罪を|イィス・サルヴェティオ>。<我々に救罪を|イィス・サルヴェティオ>。<我々に救罪を|イィス・サルヴェティオ>。”"
msgstr "\"<Grant us salvation.|Iis salvatio.> <Grant us salvation.|Iis salvatio.> <Grant us salvation.|Iis salvatio.>\""

#. Occurrence 5A_8:3573:5260: scene=5A_8
#: 5A_8:3573
msgctxt "text_id=5260 | speaker=unknown"
msgid "　手を伸ばせば届く距離、"
msgstr "  The puppet was so close that Aoko could reach out and touch it."

#. Occurrence 5A_8:3578:5261: scene=5A_8
#: 5A_8:3578
msgctxt "text_id=5261 | speaker=unknown"
msgid "　手を下ろされば殺される距離にお互いがいて、"
msgstr "  That also meant that it could reach out and kill Aoko."

#. Occurrence 5A_8:3585:5262: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0016; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:3585
msgctxt "text_id=5262 | speaker=aoko"
msgid "“―――コイツの、右腕の死角に入れる……！”"
msgstr "(I need to get my right arm into its blind spot!)"

#. Occurrence 5A_8:3669:5263: scene=5A_8
#: 5A_8:3669
msgctxt "text_id=5263 | speaker=unknown"
msgid "　青子は<勘|カン>だけで人形の右側に転がりでた。"
msgstr "  By intuition alone Aoko rolled over to the puppet's right flank."

#. Occurrence 5A_8:3674:5264: scene=5A_8
#: 5A_8:3674
msgctxt "text_id=5264 | speaker=unknown"
msgid "　人形の右腕は壁に刺さったままだ。"
msgstr "  Its arm was still embedded within the wall."

#. Occurrence 5A_8:3679:5265: scene=5A_8
#: 5A_8:3679
msgctxt "text_id=5265 | speaker=unknown"
msgid "　必然、そちらからの攻撃はない。判断は正しく、一時的な<目眩|めまい>も消えた。"
msgstr "  From here it could not attack. She had made the right decision, and her dizziness faded."

#. Occurrence 5A_8:3733:5266: voice_id=C40_5A_8_0004_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:3733
msgctxt "text_id=5266 | speaker=unknown"
msgid "　“<Intellectus non necessarius est. Pius quiescat|正しさは脱ぎ捨てなさい。敬虔はお休みなさい。>."
msgstr "                      \"<Intellectus non necessarius est. Pius quiescat|Cast off righteousness. Lay piety to rest.>."

#. Occurrence 5A_8:3733:5267: voice_id=C40_5A_8_0004_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:3733
msgctxt "text_id=5267 | speaker=unknown"
msgid "　　　　　　<O nostra essentia ablata fuit|私たちは食み合う獣、その生はすべて装飾。>,"
msgstr "                                  <  O nostra essentia ablata fuit|We beasts are meant to consume each other. Life is but a decoration.>,"

#. Occurrence 5A_8:3733:5268: voice_id=C40_5A_8_0004_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:3733
msgctxt "text_id=5268 | speaker=unknown"
msgid "<　ratio fixa tantum est. Doloris initium cerebrum fuit|であれ知性のすべてをブチまけて―――>”"
msgstr "                    <ratio fixa tantum est. Doloris initium cerebrum fuit.|Throw away your intellect. Pain powers the mind.>\""

#. Occurrence 5A_8:3753:5269: scene=5A_8
#: 5A_8:3753
msgctxt "text_id=5269 | speaker=unknown"
msgid "　転がる体を立て直し、今度はこちらの番と顔を上げる青子。"
msgstr "  Aoko pulled herself back up. It was her turn."

#. Occurrence 5A_8:3773:5270: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0017; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:3773
msgctxt "text_id=5270 | speaker=aoko"
msgid "“え―――？”"
msgstr "(What...?)"

#. Occurrence 5A_8:3812:5271: scene=5A_8
#: 5A_8:3812
msgctxt "text_id=5271 | speaker=unknown"
msgid "　瞬間。"
msgstr "  It was only an instant."

#. Occurrence 5A_8:3818:5272: scene=5A_8
#: 5A_8:3818
msgctxt "text_id=5272 | speaker=unknown"
msgid "鏡の迷路の中で、彼女は、自分と同じ<像|すがた>を見た。"
msgstr "Within this labyrinth of mirrors she saw an image of herself."

#. Occurrence 5A_8:3860:5273: voice_id=C40_5A_8_0005_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:3860
msgctxt "text_id=5273 | speaker=unknown"
msgid "　　　　　　　"
msgstr "                                          "

msgctxt "text_id=5274 | speaker=unknown"
msgid "“「ワレ<ラ、死セリ|Iis salvatio>―――」”"
msgstr "\"<We die.|Iis salvatio>...\""

#. Occurrence 5A_8:4170:5275: scene=5A_8
#: 5A_8:4170
msgctxt "text_id=5275 | speaker=unknown"
msgid "　ひときわ鮮烈な光。"
msgstr "  A blinding, brilliant light flashed."

#. Occurrence 5A_8:4175:5276: scene=5A_8
#: 5A_8:4175
msgctxt "text_id=5276 | speaker=unknown"
msgid "　壁に刻まれていく爪痕じみた裂傷。"
msgstr "  Lacerations appeared across the walls."

#. Occurrence 5A_8:4180:5277: scene=5A_8
#: 5A_8:4180
msgctxt "text_id=5277 | speaker=unknown"
msgid "　人形の切札だろう一撃を、青子は体内を走る<血液|まりょく>の濃度をあげる原始的な対魔術で、かろうじて致死手前で踏みとどまった。"
msgstr "  At the last moment, Aoko managed to thicken the magical energy running through her veins into a primitive form of magecraft resistance. It just barely saved her life from what must have been the puppet's ace in the hole."

#. Occurrence 5A_8:4274:5278: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0018; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:4274
msgctxt "text_id=5278 | speaker=aoko"
msgid "「っ、こ、の…………！」"
msgstr "\"Why you...!\""

#. Occurrence 5A_8:4280:5279: scene=5A_8
#: 5A_8:4280
msgctxt "text_id=5279 | speaker=unknown"
msgid "　自分そっくりの人形。"
msgstr "  The puppet bore a striking resemblance to Aoko."

#. Occurrence 5A_8:4285:5280: scene=5A_8
#: 5A_8:4285
msgctxt "text_id=5280 | speaker=unknown"
msgid "　心臓を止めるだけではあきたらず、物質さえ<損傷|しめつ>させる強力な呪詛。"
msgstr "  This powerful curse was not satisfied with stopping Aoko's heart, but destroying her entire being."

#. Occurrence 5A_8:4290:5281: scene=5A_8
#: 5A_8:4290
msgctxt "text_id=5281 | speaker=unknown"
msgid "　どちらも目を見張る異常さだが、<呆|ほう>けている暇はない。"
msgstr "  Aoko did not even have the time to be shocked."

#. Occurrence 5A_8:4368:5282: scene=5A_8
#: 5A_8:4368
msgctxt "text_id=5282 | speaker=unknown"
msgid "　今度こそ反撃のチャンス。"
msgstr "  This was her chance for a counter-attack."

#. Occurrence 5A_8:4373:5283: scene=5A_8
#: 5A_8:4373
msgctxt "text_id=5283 | speaker=unknown"
msgid "　右腕を壁に突き刺したままの人形はバランスが悪い。"
msgstr "  The puppet's balance was unsteady, its right arm still embedded in the wall."

#. Occurrence 5A_8:4413:5284: scene=5A_8
#: 5A_8:4413
msgctxt "text_id=5284 | speaker=unknown"
msgid "　その無防備な体を蹴り上げようとして、しかし、青子は膝から床に倒れこんだ。"
msgstr "  Aoko prepared to give its defenseless body a strong kick, but her knees buckled and she collapsed into a heap on the floor."

#. Occurrence 5A_8:4438:5285: voice_id=C40_5A_8_0006_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:4438
msgctxt "text_id=5285 | speaker=unknown"
msgid "　　 “<Vivo in somno. Solitarie putresco in inferis|私は眠りの中で生きている。ひとりきりで土の中で腐っていく。>."
msgstr "                \"<Vivo in somno. Solitarie putresco in inferis|In slumber, I live. In dirt, I rot, alone>."

#. Occurrence 5A_8:4438:5286: voice_id=C40_5A_8_0006_C; voice_prefix=C40; voice_category=0; scene=5A_8
#: 5A_8:4438
msgctxt "text_id=5286 | speaker=unknown"
msgid "@o<Hic dies meus obitus dies, et meus nativus dies. Te obeam.|今日は私の命日であり、誕生日だ。さあ、貴方に会いに行こう。>”"
msgstr "          <Hic dies meus obitus dies, et meus nativus dies. Te obeam.|Today is the day I died and was born. I come to you.>\""

#. Occurrence 5A_8:4507:5287: scene=5A_8
#: 5A_8:4507
msgctxt "text_id=5287 | speaker=unknown"
msgid "　急激な吐き気と貧血。"
msgstr "  A sudden nausea and light-headedness overcame Aoko."

#. Occurrence 5A_8:4512:5288: scene=5A_8
#: 5A_8:4512
msgctxt "text_id=5288 | speaker=unknown"
msgid "　嘘のように低下していく体温。"
msgstr "  Her body temperature began to rapidly lower."

#. Occurrence 5A_8:4518:5289: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0019; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:4518
msgctxt "text_id=5289 | speaker=aoko"
msgid "“しまっ……こいつ、呪いをばらまいてるんだった……！”"
msgstr "(This... whole... time... It was spreading its curses the whole time!)"

#. Occurrence 5A_8:4523:5290: scene=5A_8
#: 5A_8:4523
msgctxt "text_id=5290 | speaker=unknown"
msgid "　気付いた時には遅かった。"
msgstr "  She noticed too late."

#. Occurrence 5A_8:4528:5291: scene=5A_8
#: 5A_8:4528
msgctxt "text_id=5291 | speaker=unknown"
msgid "　人形の周囲には呪詛が渦巻いている。"
msgstr "  The puppet's curses circled the hall."

#. Occurrence 5A_8:4533:5292: scene=5A_8
#: 5A_8:4533
msgctxt "text_id=5292 | speaker=unknown"
msgid "　人形の動力源である呪いの詩は、近寄る者に病をもたらす防衛機巧にもなっている。"
msgstr "  The cursed chant that the puppet used as a source of power doubled as a defense mechanism, crippling those who drew near with illness."

#. Occurrence 5A_8:4569:5293: scene=5A_8
#: 5A_8:4569
msgctxt "text_id=5293 | speaker=unknown"
msgid "　それをこんな間近で受け続けた。"
msgstr "  She bore the full brunt the entire time she was in close proximity to it."

#. Occurrence 5A_8:4574:5294: scene=5A_8
#: 5A_8:4574
msgctxt "text_id=5294 | speaker=unknown"
msgid "　魔術回路を持つ青子といえど、草十郎のように体調を崩してしまう。"
msgstr "  Although Aoko had Magic Circuits, she was succumbing just as Soujyuro had."

#. Occurrence 5A_8:4579:5295: scene=5A_8
#: 5A_8:4579
msgctxt "text_id=5295 | speaker=unknown"
msgid "　<気怠|けだる>く、倒れこみそうな体に鞭を打って、青子は人形から跳び退いた。"
msgstr "  Languidly, she forced her deteriorating body to jump back."

#. Occurrence 5A_8:4627:5296: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0020; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:4627
msgctxt "text_id=5296 | speaker=aoko"
msgid "「っ、負けるかぁ……！」"
msgstr "\"I'm not done yet!\""

#. Occurrence 5A_8:4633:5297: scene=5A_8
#: 5A_8:4633
msgctxt "text_id=5297 | speaker=unknown"
msgid "　気合いで呪詛の気怠さから逃れる。"
msgstr "  With all the energy she could muster, she forced her way past the exhaustion caused by the curse."

#. Occurrence 5A_8:4710:5298: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_8_0021; voice_prefix=A10; voice_category=1; scene=5A_8
#: 5A_8:4710
msgctxt "text_id=5298 | speaker=aoko"
msgid "「――――――、ぁ」"
msgstr "\"...Ah.\""

#. Occurrence 5A_8:4716:5299: scene=5A_8
#: 5A_8:4716
msgctxt "text_id=5299 | speaker=unknown"
msgid "　だが。呪いによる貧血ではなく、自らの窮地にざあ、と青子の血圧が低下する。"
msgstr "  However, Aoko's blood pressure took a steep nose dive, not from the curse-induced anemia, but from what appeared in front of her."

#. Occurrence 5A_8:4721:5300: scene=5A_8
#: 5A_8:4721
msgctxt "text_id=5300 | speaker=unknown"
msgid "　絶好の位置関係。"
msgstr "  They stood in perfect harmony."

#. Occurrence 5A_8:4726:5301: scene=5A_8
#: 5A_8:4726
msgctxt "text_id=5301 | speaker=unknown"
msgid "　跳び退いた青子の前には、左腕を矢のように差し出す、自分と同じ顔をした自動人形。"
msgstr "  In front of Aoko was the automata that shared her face, its left arm held out like an arrow."

#. Occurrence 5A_8:4819:5302: scene=5A_8
#: 5A_8:4819
msgctxt "text_id=5302 | speaker=unknown"
msgid "　……凶器は寸分違わず、青子の心臓へと撃ちだされた。"
msgstr "  The deadly weapon shot forward and honed in on her heart."

#. Occurrence 5A_8:4893:5303: scene=5A_8
#: 5A_8:4893
msgctxt "text_id=5303 | speaker=unknown"
msgid "　ただ、そのちょっと前。"
msgstr "  Then, a moment before it made contact..."

#. Occurrence 5A_8:4900:5304: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_8_0000; voice_prefix=A30; voice_category=3; scene=5A_8
#: 5A_8:4900
msgctxt "text_id=5304 | speaker=soujuurou"
msgid "「危ない」"
msgstr "\"Watch out!\""

#. Occurrence 5A_8:4977:5305: scene=5A_8
#: 5A_8:4977
msgctxt "text_id=5305 | speaker=unknown"
msgid "　なんて、まったく危機感のない声がしたかと思うと、青子の体はぐいっと横に引っ張られていた。"
msgstr "  The moment she heard that fearless voice, completely out of place in this storm of violence, Aoko's body was pulled forcefully to one side."

#. Occurrence 5A_8:5030:5306: scene=5A_8
#: 5A_8:5030
msgctxt "text_id=5306 | speaker=unknown"
msgid "　伸びる腕はまたも<虚空|こくう>を<掠|かす>めていく。"
msgstr "  Once again, the extending arm cut through empty air."

#. Occurrence 5A_8:5036:5307: scene=5A_8
#: 5A_8:5036
msgctxt "text_id=5307 | speaker=unknown"
msgid "　人形は急いで腕を巻き戻すが、彼はその隙にと青子の手を取って、一目散に走りだしていた。"
msgstr "  While the puppet quickly retracted its left arm, Soujyuro took the brief opportunity to take Aoko by the hand and flee at full speed."

#. Occurrence 5A_9:55:5308: scene=5A_9
#: 5A_9:55
msgctxt "text_id=5308 | speaker=unknown"
msgid "　デタラメに通路を走り、人形から十分離れたところで、草十郎は足を止めてきりだした。"
msgstr "  Soujyuro ran through the corridor as fast as he could, only stopping when he had put enough distance between them and the puppet."

#. Occurrence 5A_9:111:5309: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0000; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:111
msgctxt "text_id=5309 | speaker=soujuurou"
msgid "「その、考えてみると」"
msgstr "\"I was thinking and...\""

#. Occurrence 5A_9:147:5310: scene=5A_9
#: 5A_9:147
msgctxt "text_id=5310 | speaker=unknown"
msgid "　助けたはずの相手はこの通り、目に見えてご立腹だ。"
msgstr "  Though he had saved her, she looked angry rather than grateful."

#. Occurrence 5A_9:153:5311: scene=5A_9
#: 5A_9:153
msgctxt "text_id=5311 | speaker=unknown"
msgid "それでも彼は彼なりに考え抜いた、気の利いた<台詞|いいわけ>を口にする。"
msgstr "This did not keep Soujyuro from saying his piece."

#. Occurrence 5A_9:184:5312: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0001; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:184
msgctxt "text_id=5312 | speaker=soujuurou"
msgid "「明日は、どうも忙しいみたいなんだ」"
msgstr "\"Tomorrow is going to be a really busy day for me, so...\""

#. Occurrence 5A_9:190:5313: scene=5A_9
#: 5A_9:190
msgctxt "text_id=5313 | speaker=unknown"
msgid "“だから、用件は今日中に済ませてしまわないか？”"
msgstr "  In other words, let's finish this today."

#. Occurrence 5A_9:195:5314: scene=5A_9
#: 5A_9:195
msgctxt "text_id=5314 | speaker=unknown"
msgid "　なんて続きそうな、場違いな提案を。"
msgstr "  A rather awkward proposal."

#. Occurrence 5A_9:237:5315: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0000; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:237
msgctxt "text_id=5315 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5A_9:242:5316: scene=5A_9
#: 5A_9:242
msgctxt "text_id=5316 | speaker=unknown"
msgid "　青子は黙っている。"
msgstr "  Aoko remained silent."

#. Occurrence 5A_9:247:5317: scene=5A_9
#: 5A_9:247
msgctxt "text_id=5317 | speaker=unknown"
msgid "　ついでにかなり怒ってもいた。"
msgstr "  She was also rather angry,"

#. Occurrence 5A_9:252:5318: scene=5A_9
#: 5A_9:252
msgctxt "text_id=5318 | speaker=unknown"
msgid "　この男の精神構造が理解できないから、ではない。"
msgstr "  not that she could not figure out what made him tick,"

#. Occurrence 5A_9:257:5319: scene=5A_9
#: 5A_9:257
msgctxt "text_id=5319 | speaker=unknown"
msgid "　せっかく逃がしてやったのに戻ってきた事でもない。"
msgstr "  nor because he'd returned after escaping."

#. Occurrence 5A_9:262:5320: scene=5A_9
#: 5A_9:262
msgctxt "text_id=5320 | speaker=unknown"
msgid "　相変わらずの<間|ま><抜|ぬ>けな台詞に苛ついたからでもない。"
msgstr "  Not even because he was spouting his typically airheaded lines."

#. Occurrence 5A_9:322:5321: scene=5A_9
#: 5A_9:322
msgctxt "text_id=5321 | speaker=unknown"
msgid "　……なんというか、あの一瞬。"
msgstr "  ...It was, she supposed, that instant."

#. Occurrence 5A_9:327:5322: scene=5A_9
#: 5A_9:327
msgctxt "text_id=5322 | speaker=unknown"
msgid "　手を引かれた時、何も考えられなくなって<為|な>すがままになった事が、青子的に許せないらしい。"
msgstr "  The fact that when he grabbed her hand, her mind had gone completely blank-Aoko found it unforgivable."

#. Occurrence 5A_9:382:5323: scene=5A_9
#: 5A_9:382
msgctxt "text_id=5323 | speaker=unknown"
msgid "　なので、"
msgstr "  Which beckoned the response..."

#. Occurrence 5A_9:393:5324: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0001; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:393
msgctxt "text_id=5324 | speaker=aoko"
msgid "「貴方、正気？」"
msgstr "\"Are you insane?\""

#. Occurrence 5A_9:399:5325: scene=5A_9
#: 5A_9:399
msgctxt "text_id=5325 | speaker=unknown"
msgid "　勢いで、つい、そんな言葉を口にしていた。"
msgstr "  In the heat of the moment, she blurted it before she could stop herself."

#. Occurrence 5A_9:428:5326: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0002; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:428
msgctxt "text_id=5326 | speaker=aoko"
msgid "「それとも自殺願望でもあったワケ？　私も<人形|アイツ>も、アンタなんか殺す対象にすぎないのよ。"
msgstr "\"Or maybe you've got a death wish? Don't you realize that either of us could kill you with a snap of a finger?"

#. Occurrence 5A_9:434:5327: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0003; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:434
msgctxt "text_id=5327 | speaker=aoko"
msgid "　少なくとも恩を売る相手じゃない。"
msgstr "  At the very least, I don't owe you a damn thing."

#. Occurrence 5A_9:445:5328: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0004; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:445
msgctxt "text_id=5328 | speaker=aoko"
msgid "　言っとくけど、私、助けられたぐらいで曲がる信念は持ち合わせていないから」"
msgstr "  Saving my life doesn't change a thing between us.\""

#. Occurrence 5A_9:451:5329: scene=5A_9
#: 5A_9:451
msgctxt "text_id=5329 | speaker=unknown"
msgid "　だろうね、と頷く草十郎。"
msgstr "  Soujyuro nodded, clearly unperturbed."

#. Occurrence 5A_9:492:5330: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0002; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:492
msgctxt "text_id=5330 | speaker=soujuurou"
msgid "「蒼崎がそんな可愛らしいもんじゃないのは、この夜だけで骨身にしみてるよ」"
msgstr "\"Don't worry, Aozaki. If tonight taught me anything, it's that you're more ruthless than that.\""

#. Occurrence 5A_9:525:5331: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0005; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:525
msgctxt "text_id=5331 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5A_9:531:5332: scene=5A_9
#: 5A_9:531
msgctxt "text_id=5332 | speaker=unknown"
msgid "　それはそれでちょっと不満な青子だった。"
msgstr "  She found herself slightly offended."

#. Occurrence 5A_9:583:5333: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0003; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:583
msgctxt "text_id=5333 | speaker=soujuurou"
msgid "「けど君は勘違いをしてるから、少し正そう。"
msgstr "\"But I think you need to get one thing straight."

#. Occurrence 5A_9:589:5334: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0004; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:589
msgctxt "text_id=5334 | speaker=soujuurou"
msgid "　あいつの狙いは蒼崎だけじゃない。君だけじゃなく、俺も殺す気だと思う」"
msgstr "  That thing isn't just trying to kill you. I think it's trying to kill me as well.\""

#. Occurrence 5A_9:627:5335: scene=5A_9
#: 5A_9:627
msgctxt "text_id=5335 | speaker=unknown"
msgid "　それは嘘だ、と。"
msgstr "  She was having none of it."

#. Occurrence 5A_9:632:5336: scene=5A_9
#: 5A_9:632
msgctxt "text_id=5336 | speaker=unknown"
msgid "　視線をいっそう鋭くして、青子は草十郎を睨んだ。"
msgstr "  Her eyes shot daggers his way."

#. Occurrence 5A_9:676:5337: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0005; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:676
msgctxt "text_id=5337 | speaker=soujuurou"
msgid "「話は最後まで聞く。……どうしてかって言うと、一階の入り口あるだろ？　あの細長い通路。"
msgstr "\"And before you chew me out, you need to know something. Do you remember the first-floor entrance at the end of that long corridor?"

#. Occurrence 5A_9:691:5338: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0006; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:691
msgctxt "text_id=5338 | speaker=soujuurou"
msgid "　なんでかあそこから先に進めないんだ。逃げたくても逃げだせなくて、仕方なく戻ってきた」"
msgstr "  Well, it's blocked. I tried my best to find a way out, but no luck. There was no choice but to turn right back.\""

#. Occurrence 5A_9:727:5339: scene=5A_9
#: 5A_9:727
msgctxt "text_id=5339 | speaker=unknown"
msgid "　青子はわずかに目を見張った。"
msgstr "  Aoko's eyes widened ever so slightly in amazement."

#. Occurrence 5A_9:732:5340: scene=5A_9
#: 5A_9:732
msgctxt "text_id=5340 | speaker=unknown"
msgid "　あり得ない、と驚いたのではなく、そこまでしていたか、という敵への称賛だ。"
msgstr "  She felt admiration, rather than shock, that her enemy would go to such lengths."

#. Occurrence 5A_9:788:5341: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0007; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:788
msgctxt "text_id=5341 | speaker=soujuurou"
msgid "「それに、さっきので完全に敵扱いされた。あの人形、こっちをじろっと<睨|にら>んできたし。"
msgstr "\"And besides, it was hostile to me too earlier. I could tell by how it was glaring at me."

#. Occurrence 5A_9:808:5342: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0008; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:808
msgctxt "text_id=5342 | speaker=soujuurou"
msgid "　……いや、一瞬でよく見えなかったけど、生きた心地しなかったな。蒼崎も気をつけた方がいい。たぶん、よっぽど怖い顔をしているに違いないぞ、<彼|ア><女|レ>」"
msgstr "  ...Well, it happened so fast that I didn't really get a good look at it, but it was really unsettling. You should be careful. That thing... she sure has a terrifying face.\""

#. Occurrence 5A_9:878:5343: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0006; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:878
msgctxt "text_id=5343 | speaker=aoko"
msgid "「―――それはご親切に、どうも」"
msgstr "\"...Gee, thanks.\""

#. Occurrence 5A_9:906:5344: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0009; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:906
msgctxt "text_id=5344 | speaker=soujuurou"
msgid "「うん。なんで、これはもう他人事じゃないんだ。"
msgstr "\"You bet. I mean, I can't pretend like this isn't happening to me."

#. Occurrence 5A_9:912:5345: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0010; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:912
msgctxt "text_id=5345 | speaker=soujuurou"
msgid "　蒼崎と人形。結論として、どっちが勝っても俺は殺されてしまうんじゃないか？」"
msgstr "  Whichever of you wins, I'm a dead man either way, right?\""

#. Occurrence 5A_9:932:5346: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0007; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:932
msgctxt "text_id=5346 | speaker=aoko"
msgid "「……そうね。そこまでやってるなら、目撃者は消すでしょうね。私みたいに」"
msgstr "\"...I can't argue with that. If it's willing to go as far as to seal off the entrance, then it'd probably kill any witnesses as well. At least, that's what I'd do.\""

#. Occurrence 5A_9:975:5347: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0011; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:975
msgctxt "text_id=5347 | speaker=soujuurou"
msgid "「だろう。でも、俺はあいつには殺されたくない」"
msgstr "\"Right? And I don't want her to be the one who kills me.\""

#. Occurrence 5A_9:981:5348: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0008; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:981
msgctxt "text_id=5348 | speaker=aoko"
msgid "「え？」"
msgstr "\"Wait, what?\""

#. Occurrence 5A_9:1017:5349: scene=5A_9
#: 5A_9:1017
msgctxt "text_id=5349 | speaker=unknown"
msgid "　きっぱりと彼は断言した。"
msgstr "  His words were decisive."

#. Occurrence 5A_9:1022:5350: scene=5A_9
#: 5A_9:1022
msgctxt "text_id=5350 | speaker=unknown"
msgid "　まるで励ますような草十郎の言葉に、顔を上げる青子。"
msgstr "  As Aoko looked up at him, she could swear he was trying to encourage her."

#. Occurrence 5A_9:1028:5351: scene=5A_9
#: 5A_9:1028
msgctxt "text_id=5351 | speaker=unknown"
msgid "　……そうして、ようやく気づいた。"
msgstr "  It was then that she realized."

#. Occurrence 5A_9:1066:5352: scene=5A_9
#: 5A_9:1066
msgctxt "text_id=5352 | speaker=unknown"
msgid "　草十郎の顔色の悪さが、さっきより濃くなっている事に。"
msgstr "  Soujyuro was looking even worse than before."

#. Occurrence 5A_9:1096:5353: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0009; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1096
msgctxt "text_id=5353 | speaker=aoko"
msgid "「ちょっと待って。大丈夫なの、貴方？」"
msgstr "\"Hey. Are you okay?\""

#. Occurrence 5A_9:1111:5354: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0012; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:1111
msgctxt "text_id=5354 | speaker=soujuurou"
msgid "「……まあ、醤油を<一升瓶|いっしょうびん>飲むよりは、ましではないかと」"
msgstr "\"Well, I'm better than if I'd drunk an entire bottle of soy sauce.\""

#. Occurrence 5A_9:1117:5355: scene=5A_9
#: 5A_9:1117
msgctxt "text_id=5355 | speaker=unknown"
msgid "　彼なりに場を<和|なご>ませようとした軽口だが、額に脂汗を浮かべられては余計に重い。"
msgstr "  He tried to make light of the situation, but his forehead was clearly drenched in sweat."

#. Occurrence 5A_9:1171:5356: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0010; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1171
msgctxt "text_id=5356 | speaker=aoko"
msgid "“……そうか、さっき人形に近付いたから……”"
msgstr "(Right. It's because he was close to the puppet just now.)"

#. Occurrence 5A_9:1177:5357: scene=5A_9
#: 5A_9:1177
msgctxt "text_id=5357 | speaker=unknown"
msgid "　青子ですら吐き気に襲われる呪いの圏内に入って、草十郎が平気である筈がない。"
msgstr "  How could he possibly be able to withstand a curse that made even Aoko nauseous?"

#. Occurrence 5A_9:1189:5358: scene=5A_9
#: 5A_9:1189
msgctxt "text_id=5358 | speaker=unknown"
msgid "　……自分の洞察力の低さに唇を噛む。"
msgstr "  She bit her lip, annoyed at herself for not noticing this earlier."

#. Occurrence 5A_9:1194:5359: scene=5A_9
#: 5A_9:1194
msgctxt "text_id=5359 | speaker=unknown"
msgid "　あんまりに彼がぼんやりしているから、そこに考えがいたらなかった。"
msgstr "  Soujyuro was such an airhead that she hadn't even paused to consider his plight."

#. Occurrence 5A_9:1267:5360: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0011; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1267
msgctxt "text_id=5360 | speaker=aoko"
msgid "「……下で隠れていようとか思わなかったの？"
msgstr "\"...Why didn't you consider trying to hide down in the basement?"

#. Occurrence 5A_9:1267:5361: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0011; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1267
msgctxt "text_id=5361 | speaker=aoko"
msgid "　その方がどう考えても安全でしょ？」"
msgstr "  That would have been the safest bet, wouldn't it?\""

#. Occurrence 5A_9:1272:5362: scene=5A_9
#: 5A_9:1272
msgctxt "text_id=5362 | speaker=unknown"
msgid "　ほんとうに分からない、と青子。"
msgstr "  She really could not understand him at all."

#. Occurrence 5A_9:1287:5363: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0013; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:1287
msgctxt "text_id=5363 | speaker=soujuurou"
msgid "「それは蒼崎が言う台詞じゃないな。"
msgstr "\"You should really take your own advice sometimes, Aozaki."

#. Occurrence 5A_9:1337:5364: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0014; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:1337
msgctxt "text_id=5364 | speaker=soujuurou"
msgid "　―――でもまあ、長話をしている時間もない。そろそろ追いついて来る頃だ」"
msgstr "  ...But hey, this is no time to be chatting. She could catch up at any moment.\""

#. Occurrence 5A_9:1357:5365: scene=5A_9
#: 5A_9:1357
msgctxt "text_id=5365 | speaker=unknown"
msgid "　通路に視線を向ける草十郎。"
msgstr "  He turned to look down the corridor."

#. Occurrence 5A_9:1362:5366: scene=5A_9
#: 5A_9:1362
msgctxt "text_id=5366 | speaker=unknown"
msgid "　……鏡張りの闇からは、ざらついたオルゴールが聞こえだしていた。"
msgstr "  The crackling sounds of a music box could be heard creeping forth from the darkness."

#. Occurrence 5A_9:1394:5367: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0015; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:1394
msgctxt "text_id=5367 | speaker=soujuurou"
msgid "「さっき一階にいて考えたんだ。君がやられても俺は殺される。なら、まずヤツをどうにかするべきだ」"
msgstr "\"I was thinking about this while I was on the first floor earlier. If it kills you, I'm next. That's why we should deal with it first.\""

#. Occurrence 5A_9:1429:5368: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0012; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1429
msgctxt "text_id=5368 | speaker=aoko"
msgid "「…………………。"
msgstr "\"..."

#. Occurrence 5A_9:1442:5369: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0013; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1442
msgctxt "text_id=5369 | speaker=aoko"
msgid "　貴方、なにが言いたいの？」"
msgstr "  What are you getting at?\""

#. Occurrence 5A_9:1492:5370: scene=5A_9
#: 5A_9:1492
msgctxt "text_id=5370 | speaker=unknown"
msgid "　分かりきった事を、青子はあえて問いただした。"
msgstr "  She asked a question to which she already knew the answer."

#. Occurrence 5A_9:1497:5371: scene=5A_9
#: 5A_9:1497
msgctxt "text_id=5371 | speaker=unknown"
msgid "　草十郎の決意の程を試すように。"
msgstr "  She did it to put him to the test."

#. Occurrence 5A_9:1502:5372: scene=5A_9
#: 5A_9:1502
msgctxt "text_id=5372 | speaker=unknown"
msgid "　その先を半端な気持ちで口にするのなら、やっぱり今ここで始末する、と見据えながら。"
msgstr "  If he wavered even a little, she would have killed him where he stood."

#. Occurrence 5A_9:1545:5373: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0016; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:1545
msgctxt "text_id=5373 | speaker=soujuurou"
msgid "「提案。アイツをやっつけるのに協力したら、俺の事は見逃してくれる？」"
msgstr "\"My proposal is if I agree to help you kill that thing, will you let me go?\""

#. Occurrence 5A_9:1582:5374: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0014; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1582
msgctxt "text_id=5374 | speaker=aoko"
msgid "「……助けられたぐらいじゃ信念は曲げないって言ったでしょう。"
msgstr "\"...I thought I'd made it clear that helping me wasn't going to change my mind."

#. Occurrence 5A_9:1589:5375: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0015; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1589
msgctxt "text_id=5375 | speaker=aoko"
msgid "それに、貴方に何が出来るって言うの？」"
msgstr "And besides, what do you think you're going to do to it, anyway?\""

#. Occurrence 5A_9:1606:5376: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0017; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:1606
msgctxt "text_id=5376 | speaker=soujuurou"
msgid "「それは蒼崎が考えてくれ。得意だろ、そういうの」"
msgstr "\"Oh, that's your end of the bargain, Aozaki. This is your area of expertise, right?\""

#. Occurrence 5A_9:1655:5377: scene=5A_9
#: 5A_9:1655
msgctxt "text_id=5377 | speaker=unknown"
msgid "　協力者を適材適所にふりわけるのは指揮者の役割だ。"
msgstr "  The commander who had the overall picture was responsible for delegating roles to their teammates."

#. Occurrence 5A_9:1660:5378: scene=5A_9
#: 5A_9:1660
msgctxt "text_id=5378 | speaker=unknown"
msgid "　そもそもこの状況をまったく把握できず、また、自身と敵の差を理解できない人間に“何が出来るか”なんてコトを考えさせるのは間違っている、と草十郎は胸を張った。"
msgstr "  It was futile to depend on someone who was unable to grasp the situation or evaluate the enemy's strength. Soujyuro was proud to share that he knew this."

#. Occurrence 5A_9:1687:5379: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0016; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1687
msgctxt "text_id=5379 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5A_9:1692:5380: scene=5A_9
#: 5A_9:1692
msgctxt "text_id=5380 | speaker=unknown"
msgid "　彼の言う通り、草十郎を知り、自動人形を知っているのは蒼崎青子だけ。"
msgstr "  He spoke the truth. Aoko was the only one who knew both Soujyuro and the automata."

#. Occurrence 5A_9:1697:5381: scene=5A_9
#: 5A_9:1697
msgctxt "text_id=5381 | speaker=unknown"
msgid "　なので、青子の指示を全力でこなす事が“いまの自分に出来る事”だと彼は言った。"
msgstr "  That was why he pointed out that following her orders to the best of his ability was the only thing he could do."

#. Occurrence 5A_9:1702:5382: scene=5A_9
#: 5A_9:1702
msgctxt "text_id=5382 | speaker=unknown"
msgid "　思考放棄に近いが、それでも、草十郎の提案は自分が無力である事を受け入れた末の、最大限の信頼に他ならない。"
msgstr "  It may have seemed as though Soujyuro had surrendered his capacity for self-thought, but in accepting that he was helpless, he was in fact giving Aoko his complete trust."

#. Occurrence 5A_9:1737:5383: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0017; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1737
msgctxt "text_id=5383 | speaker=aoko"
msgid "「……。じゃあ、私の指示に百パーセント従うってこと？」"
msgstr "\"Fine, then. So you'll do exactly what I tell you to do?\""

#. Occurrence 5A_9:1750:5384: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0018; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:1750
msgctxt "text_id=5384 | speaker=soujuurou"
msgid "「ああ。それに、これは恩とか義理の話じゃない。"
msgstr "\"I will. And just so you know, I'm not doing this out of a sense of obligation or anything."

#. Occurrence 5A_9:1756:5385: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5A_9_0019; voice_prefix=A30; voice_category=3; scene=5A_9
#: 5A_9:1756
msgctxt "text_id=5385 | speaker=soujuurou"
msgid "　ひとりだと分が悪いからふたりでかかるだけだ。善意でも厚意でもない。取引って言わないか、こういうの？」"
msgstr "  It's just obvious that neither of us had a chance on our own. This isn't goodwill or kindness. It's a... transaction.\""

#. Occurrence 5A_9:1762:5386: scene=5A_9
#: 5A_9:1762
msgctxt "text_id=5386 | speaker=unknown"
msgid "　信条的な物々交換だ、純朴な<瞳|め>が語っている。"
msgstr "  His eyes sparkled, as if this was bartering in its truest form."

#. Occurrence 5A_9:1846:5387: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0018; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1846
msgctxt "text_id=5387 | speaker=aoko"
msgid "「――――――まったく」"
msgstr "\"...Oh my god.\""

#. Occurrence 5A_9:1852:5388: scene=5A_9
#: 5A_9:1852
msgctxt "text_id=5388 | speaker=unknown"
msgid "　……この少年にそんな知恵をつけたのは鳶丸の阿呆に違いない。"
msgstr "  This child must have learned that from Tobimaru, Aoko thought."

#. Occurrence 5A_9:1857:5389: scene=5A_9
#: 5A_9:1857
msgctxt "text_id=5389 | speaker=unknown"
msgid "　決して口にはこぼさないが、青子は少しだけ笑いたくなった。"
msgstr "  Though she refused to let him see it, she smiled inwardly."

#. Occurrence 5A_9:1863:5390: scene=5A_9
#: 5A_9:1863
msgctxt "text_id=5390 | speaker=unknown"
msgid "完全に一本とられたけど、なんというか、悔しくない敗北なんてものが、世の中にはあるらしい。"
msgstr "Sure, he had gotten the best of her just now, but there were times when defeat was not the worse outcome in the world."

#. Occurrence 5A_9:1890:5391: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0019; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1890
msgctxt "text_id=5391 | speaker=aoko"
msgid "「労働と報酬ってワケね。それなら理にかなってる。"
msgstr "\"Honest pay for honest work. Makes sense."

#. Occurrence 5A_9:1896:5392: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0020; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1896
msgctxt "text_id=5392 | speaker=aoko"
msgid "　うん、言いたくないけど―――」"
msgstr "  And... I hate to admit it, but...\""

#. Occurrence 5A_9:1929:5393: scene=5A_9
#: 5A_9:1929
msgctxt "text_id=5393 | speaker=unknown"
msgid "　少し間をおいて、やれやれ、と肩で息をする。"
msgstr "  She relaxed her shoulders and sighed."

#. Occurrence 5A_9:1934:5394: scene=5A_9
#: 5A_9:1934
msgctxt "text_id=5394 | speaker=unknown"
msgid "　青子はふっきれたような、見ようによっては邪悪な笑みをうかべて、"
msgstr "  Her face cracked into a wicked grin, as if her fears had suddenly washed away."

#. Occurrence 5A_9:1969:5395: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5A_9_0021; voice_prefix=A10; voice_category=1; scene=5A_9
#: 5A_9:1969
msgctxt "text_id=5395 | speaker=aoko"
msgid "「―――それ、けっこう私の好みよ」"
msgstr "\"Your plan is just my style.\""

#. Occurrence 5A_9:1975:5396: scene=5A_9
#: 5A_9:1975
msgctxt "text_id=5396 | speaker=unknown"
msgid "　彼が向けたのと同程度の信頼を、まっすぐに投げ返した。"
msgstr "  Aoko repaid Soujyuro's trust in equal measure."

#. Occurrence 5B_1:78:5397: scene=5B_1
#: 5B_1:78
msgctxt "text_id=5397 | speaker=unknown"
msgid "　それは、彼らにとって<郷愁|きょうしゅう>に似た旋律だった。"
msgstr "  The melody stirred an emotion like nostalgia within them."

#. Occurrence 5B_1:83:5398: scene=5B_1
#: 5B_1:83
msgctxt "text_id=5398 | speaker=unknown"
msgid "　かつてこの世界にありふれていたもの。"
msgstr "  Something once familiar but now lost to this world."

#. Occurrence 5B_1:88:5399: scene=5B_1
#: 5B_1:88
msgctxt "text_id=5399 | speaker=unknown"
msgid "　物言わぬ彼らのすべてが、永遠に続くと信じて疑わなかったもの。"
msgstr "  They believed, beyond a shadow of a doubt, that it would play for all eternity."

#. Occurrence 5B_1:93:5400: scene=5B_1
#: 5B_1:93
msgctxt "text_id=5400 | speaker=unknown"
msgid "　始まりに一度、終わりに一度。"
msgstr "  From opening stanza to final coda,"

#. Occurrence 5B_1:98:5401: scene=5B_1
#: 5B_1:98
msgctxt "text_id=5401 | speaker=unknown"
msgid "　夢の開園と、現実への帰還を告げる、陽気で、どこか寂しくなる不思議な<音楽|サイレン>。"
msgstr "  it was a mysterious siren's song, merry yet longing, that heralded a return from dreams to reality."

#. Occurrence 5B_1:187:5402: scene=5B_1
#: 5B_1:187
msgctxt "text_id=5402 | speaker=unknown"
msgid "　夜が<響|ひび>く。"
msgstr "  The night shook."

#. Occurrence 5B_1:192:5403: scene=5B_1
#: 5B_1:192
msgctxt "text_id=5403 | speaker=unknown"
msgid "　唄を<紡|つむ>ぐ。"
msgstr "  A song was spun."

#. Occurrence 5B_1:197:5404: scene=5B_1
#: 5B_1:197
msgctxt "text_id=5404 | speaker=unknown"
msgid "　今は失われた彼らの楽園を掘り返す。"
msgstr "  Now, their lost paradise was unearthed."

#. Occurrence 5B_1:202:5405: scene=5B_1
#: 5B_1:202
msgctxt "text_id=5405 | speaker=unknown"
msgid "　うち捨てられた多くの<夢路|ゆめじ>が、"
msgstr "  Abandoned dreams..."

#. Occurrence 5B_1:207:5406: scene=5B_1
#: 5B_1:207
msgctxt "text_id=5406 | speaker=unknown"
msgid "　見放されたかつての偶像が、"
msgstr "  Forsaken idols..."

#. Occurrence 5B_1:212:5407: scene=5B_1
#: 5B_1:212
msgctxt "text_id=5407 | speaker=unknown"
msgid "　青猫の鳴き声に呼応する。"
msgstr "  They all responded to the cry of the blue cat."

#. Occurrence 5B_1:236:5408: scene=5B_1
#: 5B_1:236
msgctxt "text_id=5408 | speaker=unknown"
msgid "　―――その鐘の名は“<夜の饗宴|ディドルディドル>”"
msgstr "  ...The name of that bell was Diddle Diddle, Banquet of the Night."

#. Occurrence 5B_1:243:5409: scene=5B_1
#: 5B_1:243
msgctxt "text_id=5409 | speaker=unknown"
msgid "　あらゆる寓話、"
msgstr "  All fables made possible,"

msgctxt "text_id=5410 | speaker=unknown"
msgid "　あらゆる不思議を許容する、"
msgstr "  all marvels made real,"

msgctxt "text_id=5411 | speaker=unknown"
msgid "　魔法以上に魔法に近い、久遠寺有珠の魔術である。"
msgstr "  by the magecraft of Alice Kuonji, more magical than magic itself."

#. Occurrence 5B_1:460:5412: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0000; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:460
msgctxt "text_id=5412 | speaker=alice"
msgid "「……随分と身勝手ね。"
msgstr "\"...How selfish of you."

#. Occurrence 5B_1:466:5413: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0001; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:466
msgctxt "text_id=5413 | speaker=alice"
msgid "　それは貴女ひとりで決めていい事だったかしら、青子？」"
msgstr "  Is that something you can really decide on your own, Aoko?\""

#. Occurrence 5B_1:472:5414: scene=5B_1
#: 5B_1:472
msgctxt "text_id=5414 | speaker=unknown"
msgid "　少女は黒い<凶鳥|まがどり>のように時計台の上に降り立った。"
msgstr "  Alice sat perched atop the clock tower like a black bird of ill omen."

#. Occurrence 5B_1:477:5415: scene=5B_1
#: 5B_1:477
msgctxt "text_id=5415 | speaker=unknown"
msgid "　細い指は静かに、羽をつくろうように、<衣服|スカート>の乱れを直す。"
msgstr "  She smoothed the ruffles of her skirt as if she were preening. "

#. Occurrence 5B_1:502:5416: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0000; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:502
msgctxt "text_id=5416 | speaker=aoko"
msgid "「―――有珠」"
msgstr "\"...Alice.\""

#. Occurrence 5B_1:508:5417: scene=5B_1
#: 5B_1:508
msgctxt "text_id=5417 | speaker=unknown"
msgid "　見上げる青子の声には<微|かす>かな緊張。"
msgstr "  There was tension in Aoko's voice as she lifted her head."

#. Occurrence 5B_1:513:5418: scene=5B_1
#: 5B_1:513
msgctxt "text_id=5418 | speaker=unknown"
msgid "　……先ほどまでの穏やかな空気は、有珠の視線だけで霧散していた。"
msgstr "  The calm atmosphere from a moment prior had long since been shooed away by Alice's gaze."

#. Occurrence 5B_1:547:5419: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_1_0000; voice_prefix=A30; voice_category=3; scene=5B_1
#: 5B_1:547
msgctxt "text_id=5419 | speaker=soujuurou"
msgid "“あの娘、たしか……”"
msgstr "\"That girl... I've seen her somewhere before.\""

#. Occurrence 5B_1:552:5420: scene=5B_1
#: 5B_1:552
msgctxt "text_id=5420 | speaker=unknown"
msgid "　草十郎は曖昧な記憶を辿る。"
msgstr "  Soujyuro searched his hazy memory."

#. Occurrence 5B_1:563:5421: scene=5B_1
#: 5B_1:563
msgctxt "text_id=5421 | speaker=unknown"
msgid "　遠くて顔ははっきりしないが、何度か町で見かけたかもしれない。"
msgstr "  He could not clearly make out her face at this distance, but he was sure he had seen her around town a number of times."

#. Occurrence 5B_1:568:5422: scene=5B_1
#: 5B_1:568
msgctxt "text_id=5422 | speaker=unknown"
msgid "　それが何処だったかを思い出そうとするのだが、妙な緊張感が邪魔をして、どうにもはっきりしなかった。"
msgstr "  Where and when eluded him, however, as the tension in the air kept him from connecting all the dots."

#. Occurrence 5B_1:644:5423: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0001; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:644
msgctxt "text_id=5423 | speaker=aoko"
msgid "「―――驚いた。ずいぶんと仲間思いになったのね有珠。"
msgstr "\"...Well, isn't this a turn of events. I didn't know you cared so much, Alice."

#. Occurrence 5B_1:644:5424: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0001; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:644
msgctxt "text_id=5424 | speaker=aoko"
msgid "　今夜は私に任せるんじゃなかったっけ？」"
msgstr "  I thought you were going to leave tonight to me.\""

#. Occurrence 5B_1:665:5425: scene=5B_1
#: 5B_1:665
msgctxt "text_id=5425 | speaker=unknown"
msgid "　青子はわずかに身構え、半歩だけ前に出た。"
msgstr "  Aoko readied her guard and took half a step forward."

#. Occurrence 5B_1:670:5426: scene=5B_1
#: 5B_1:670
msgctxt "text_id=5426 | speaker=unknown"
msgid "　無意識に。"
msgstr "  Unconsciously."

#. Occurrence 5B_1:675:5427: scene=5B_1
#: 5B_1:675
msgctxt "text_id=5427 | speaker=unknown"
msgid "　第三者的に見れば、<傍|かたわ>らの人影をかばうように。"
msgstr "  From an objective standpoint, it almost looked as though she were protecting the figure beside her."

#. Occurrence 5B_1:726:5428: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0002; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:726
msgctxt "text_id=5428 | speaker=alice"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5B_1:732:5429: scene=5B_1
#: 5B_1:732
msgctxt "text_id=5429 | speaker=unknown"
msgid "　有珠の沈黙はますます重くなっていく。"
msgstr "  Alice's silence grew ever heavier."

#. Occurrence 5B_1:737:5430: scene=5B_1
#: 5B_1:737
msgctxt "text_id=5430 | speaker=unknown"
msgid "　地上を<睥睨|へいげい>する瞳は感情に<乏|とぼ>しい。"
msgstr "  Her eyes, fixed on the ground below her, were devoid of emotion."

#. Occurrence 5B_1:742:5431: scene=5B_1
#: 5B_1:742
msgctxt "text_id=5431 | speaker=unknown"
msgid "　でありながら、言いようのない不安と重圧でこの広場を支配しつつある。"
msgstr "  An indescribable sense of dread and pressure laid claim over the plaza."

#. Occurrence 5B_1:813:5432: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_1_0001; voice_prefix=A30; voice_category=3; scene=5B_1
#: 5B_1:813
msgctxt "text_id=5432 | speaker=soujuurou"
msgid "“……鐘……？”"
msgstr "\"...A bell...?\""

#. Occurrence 5B_1:819:5433: scene=5B_1
#: 5B_1:819
msgctxt "text_id=5433 | speaker=unknown"
msgid "　耳を澄ますと、どこからか鐘の音が響いていた。"
msgstr "  If he strained his ears, he could make out the faint ringing of a bell echoing in the distance."

#. Occurrence 5B_1:824:5434: scene=5B_1
#: 5B_1:824
msgctxt "text_id=5434 | speaker=unknown"
msgid "　寄せ返すさざ波のような<鐘|おと>は、信じがたい事に地面の下から聴こえてくる。"
msgstr "  The rippling soundwave seemed, unbelievably, to be emanating from under the ground."

#. Occurrence 5B_1:851:5435: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_1_0002; voice_prefix=A30; voice_category=3; scene=5B_1
#: 5B_1:851
msgctxt "text_id=5435 | speaker=soujuurou"
msgid "「なあ蒼崎、あの<娘|こ>」"
msgstr "\"Hey Aozaki, that girl... She's―\""

#. Occurrence 5B_1:862:5436: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0002; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:862
msgctxt "text_id=5436 | speaker=aoko"
msgid "「黙ってて」"
msgstr "\"Quiet.\""

#. Occurrence 5B_1:874:5437: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_1_0003; voice_prefix=A30; voice_category=3; scene=5B_1
#: 5B_1:874
msgctxt "text_id=5437 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5B_1:880:5438: scene=5B_1
#: 5B_1:880
msgctxt "text_id=5438 | speaker=unknown"
msgid "　むう、と邪魔にならないよう引っこむ草十郎。"
msgstr "  Soujyuro stepped back, trying to stay out of the way."

#. Occurrence 5B_1:885:5439: scene=5B_1
#: 5B_1:885
msgctxt "text_id=5439 | speaker=unknown"
msgid "　知り合い？　という質問に、"
msgstr "  It was as though he had been told to go to hell"

#. Occurrence 5B_1:890:5440: scene=5B_1
#: 5B_1:890
msgctxt "text_id=5440 | speaker=unknown"
msgid "　死にたい？　と返された感じ。"
msgstr "  for the crime of asking if the girl was Aoko's friend."

#. Occurrence 5B_1:931:5441: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0003; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:931
msgctxt "text_id=5441 | speaker=alice"
msgid "「……そうね。仲間思い、に当てはまるかは微妙だけど、良くない予感がしたから様子を見に来ただけ。"
msgstr "\"I wouldn't go as far as to say I cared. I simply had a feeling something might be wrong and came to check."

#. Occurrence 5B_1:937:5442: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0004; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:937
msgctxt "text_id=5442 | speaker=alice"
msgid "　別に、貴女の仕事を疑ったワケじゃないわ。」"
msgstr "  It's not as though I had any doubts regarding your ability to handle the job.\""

#. Occurrence 5B_1:980:5443: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0003; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:980
msgctxt "text_id=5443 | speaker=aoko"
msgid "「それはどうも。どうせならもう少し早く、その良くない予感とやらに気づいてほしかったけど。"
msgstr "\"Much appreciated. It would have been nice if you had thought to come check just a bit earlier, though."

#. Occurrence 5B_1:986:5444: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0004; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:986
msgctxt "text_id=5444 | speaker=aoko"
msgid "　―――でもま、ごらんの通り自己解決したわ。"
msgstr "  ...As you can see, things seem to have worked themselves out."

#. Occurrence 5B_1:999:5445: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0005; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:999
msgctxt "text_id=5445 | speaker=aoko"
msgid "　夜も遅いし、さっさと帰っていいわよ有珠。私の仕事っぷりを疑うワケじゃないんでしょう？」"
msgstr "  It's late, so don't let me keep you, Alice. Since you have no doubts about my ability, right?\""

#. Occurrence 5B_1:1038:5446: scene=5B_1
#: 5B_1:1038
msgctxt "text_id=5446 | speaker=unknown"
msgid "　両者の視線が交差する。"
msgstr "  Their eyes locked on one another."

#. Occurrence 5B_1:1043:5447: scene=5B_1
#: 5B_1:1043
msgctxt "text_id=5447 | speaker=unknown"
msgid "　有珠はやや不快げに、冷たさをこめて。"
msgstr "  Alice's stare was uncomfortably cold."

#. Occurrence 5B_1:1048:5448: scene=5B_1
#: 5B_1:1048
msgctxt "text_id=5448 | speaker=unknown"
msgid "　青子は堂々と、文句があるなら言いやがれと挑発するように。"
msgstr "  Aoko's was bold, daring Alice to air her complaints."

#. Occurrence 5B_1:1084:5449: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0005; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1084
msgctxt "text_id=5449 | speaker=alice"
msgid "「……いえ、気が変わったわ。"
msgstr "\"...I think I've changed my mind."

#. Occurrence 5B_1:1090:5450: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0006; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1090
msgctxt "text_id=5450 | speaker=alice"
msgid "　せっかくだし<二|・><人|・><で|・><帰|・><り|・><ま|・><し|・><ょ|・><う|・>。その方が貴女らしいわ。帰りしな、人形の話でも聞かせてちょうだい」"
msgstr "  I'm here now, so why don't the two of us go home? That's more your style anyway, Aoko. You can tell me all about your adventures with the puppet on the way.\""

#. Occurrence 5B_1:1096:5451: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0006; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:1096
msgctxt "text_id=5451 | speaker=aoko"
msgid "「は。らしいってなによ、らしいって。"
msgstr "\"Ha! What's that supposed to mean?"

#. Occurrence 5B_1:1102:5452: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0007; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:1102
msgctxt "text_id=5452 | speaker=aoko"
msgid "　いいから帰れ帰れ、ぐうたら有珠。部屋に閉じこもって役に立たない<椋鳥|むくどり>でも作ってろっての」"
msgstr "  Go home, Alice. Shut yourself in your room and make some more of your worthless birds.\""

#. Occurrence 5B_1:1161:5453: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0007; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1161
msgctxt "text_id=5453 | speaker=alice"
msgid "「…………」"
msgstr "\"...\""

#. Occurrence 5B_1:1166:5454: scene=5B_1
#: 5B_1:1166
msgctxt "text_id=5454 | speaker=unknown"
msgid "　可憐な唇が<落胆|らくたん>の息をこぼす。"
msgstr "  A disappointed sigh escaped Alice's delicate lips."

#. Occurrence 5B_1:1171:5455: scene=5B_1
#: 5B_1:1171
msgctxt "text_id=5455 | speaker=unknown"
msgid "　黒衣の少女は怒るというより呆れたように、"
msgstr "  It seemed that the black-clad girl was more astonished than angry."

#. Occurrence 5B_1:1186:5456: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0008; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1186
msgctxt "text_id=5456 | speaker=alice"
msgid "「……青子。口にしたくないけど、本気？」"
msgstr "\"...Aoko. I hate to say this, but... seriously?\""

#. Occurrence 5B_1:1192:5457: scene=5B_1
#: 5B_1:1192
msgctxt "text_id=5457 | speaker=unknown"
msgid "　静かに。"
msgstr "  Quietly,"

#. Occurrence 5B_1:1197:5458: scene=5B_1
#: 5B_1:1197
msgctxt "text_id=5458 | speaker=unknown"
msgid "　二年近くともに暮らした同居人を問いただした。"
msgstr "  Alice questioned her roommate of nearly two years."

#. Occurrence 5B_1:1245:5459: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0008; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:1245
msgctxt "text_id=5459 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5B_1:1267:5460: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0009; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1267
msgctxt "text_id=5460 | speaker=alice"
msgid "「……呆れた。二人で秘密を守ると言ったのに？"
msgstr "\"...You surprise me. Did you not say we would protect our secret together?"

#. Occurrence 5B_1:1273:5461: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0010; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1273
msgctxt "text_id=5461 | speaker=alice"
msgid "　まだ半端にそっち側なの？　それとも情でも移った？」"
msgstr "  Are you still having trouble letting go of the other side? Or has compassion taken hold of you?\""

#. Occurrence 5B_1:1316:5462: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0009; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:1316
msgctxt "text_id=5462 | speaker=aoko"
msgid "「別に。情っていうより私の気分よ。"
msgstr "\"Not at all. This isn't compassion―I just feel like doing it this way."

#. Occurrence 5B_1:1328:5463: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0010; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:1328
msgctxt "text_id=5463 | speaker=aoko"
msgid "　だいたい、方針なんてその場その場で変わるもんでしょ。気分なら尚更よ。"
msgstr "  No plan survives contact with the enemy, you know that. The same goes for my mood."

#. Occurrence 5B_1:1335:5464: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0011; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:1335
msgctxt "text_id=5464 | speaker=aoko"
msgid "そっちこそ、一度した約束は絶対守"
msgstr "Besides, who goes out of her way to keep a promise"

#. Occurrence 5B_1:1335:5465: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0011; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:1335
msgctxt "text_id=5465 | speaker=aoko"
msgid "　るぅー、なんて、時代遅れなんじゃない？」"
msgstr "she made forever ago? A little old-fashioned, if you ask me.\""

#. Occurrence 5B_1:1385:5466: scene=5B_1
#: 5B_1:1385
msgctxt "text_id=5466 | speaker=unknown"
msgid "　睨みあうふたり。"
msgstr "  The proverbial knives were out, now."

#. Occurrence 5B_1:1390:5467: scene=5B_1
#: 5B_1:1390
msgctxt "text_id=5467 | speaker=unknown"
msgid "　歩み寄る気なんて微塵もなし。"
msgstr "  No quarter was given nor taken."

#. Occurrence 5B_1:1395:5468: scene=5B_1
#: 5B_1:1395
msgctxt "text_id=5468 | speaker=unknown"
msgid "　悲しい事だが、彼女たちの在り方はあくまで協力関係であって、相互理解の域には達していない。"
msgstr "  Sadly, their partnership was one of convenience, and had not reached the level of mutual understanding."

#. Occurrence 5B_1:1400:5469: scene=5B_1
#: 5B_1:1400
msgctxt "text_id=5469 | speaker=unknown"
msgid "　なので、友情のカタチは微妙かつ特殊だった。互いの意見が衝突したら、どちらかが砕けるまで先には進まない。"
msgstr "  Their version of friendship was both delicate and unique. When a conflict of opinion arose, each would refuse to budge until the other crumbled."

#. Occurrence 5B_1:1405:5470: scene=5B_1
#: 5B_1:1405
msgctxt "text_id=5470 | speaker=unknown"
msgid "　<青子|それ>は<青子|それ>、<有珠|これ>は<有珠|これ>、と綺麗さっぱり切り捨てられるのが、今のところ、彼女たちが良しとする友情である。"
msgstr "  Neither was concerned for the other's plight, and at least for now, that was how they liked it."

#. Occurrence 5B_1:1436:5471: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0011; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1436
msgctxt "text_id=5471 | speaker=alice"
msgid "「……そうね。今の暴言は貴女らしいとは思うけど」"
msgstr "\"...You know, I've come to accept stupid outbursts like that from you.\""

#. Occurrence 5B_1:1441:5472: scene=5B_1
#: 5B_1:1441
msgctxt "text_id=5472 | speaker=unknown"
msgid "　少女はもう一度、今度はさっきより大きなため息をついて、"
msgstr "  Once again she let out a sigh, even larger than the one before."

#. Occurrence 5B_1:1453:5473: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0012; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1453
msgctxt "text_id=5473 | speaker=alice"
msgid "「言い争いは後にしましょう。"
msgstr "\"Why don't we save this argument for later?"

#. Occurrence 5B_1:1459:5474: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0013; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1459
msgctxt "text_id=5474 | speaker=alice"
msgid "　そこの彼を<い|・><な|・><か|・><っ|・><た|・><事|・>にするのは、私だけで十分だし」"
msgstr "  I can make him disappear on my own.\""

#. Occurrence 5B_1:1465:5475: scene=5B_1
#: 5B_1:1465
msgctxt "text_id=5475 | speaker=unknown"
msgid "　つい、と。"
msgstr "  Finally, she struck straight to the point."

#. Occurrence 5B_1:1470:5476: scene=5B_1
#: 5B_1:1470
msgctxt "text_id=5476 | speaker=unknown"
msgid "　チェスの駒をさすような仕草で、細い指を動かした。"
msgstr "  As if making to move a chess piece, Alice lifted her slender finger."

#. Occurrence 5B_1:1643:5477: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_1_0004; voice_prefix=A30; voice_category=3; scene=5B_1
#: 5B_1:1643
msgctxt "text_id=5477 | speaker=soujuurou"
msgid "“うん？”"
msgstr "\"Hm?\""

#. Occurrence 5B_1:1649:5478: scene=5B_1
#: 5B_1:1649
msgctxt "text_id=5478 | speaker=unknown"
msgid "　それは、蒼崎青子に命を狙われ、まがりなりにも自動人形を目撃した草十郎をして、目を見張る“不思議”だった。"
msgstr "  Even this simple action seemed mysterious to Soujyuro, the same boy who had been hunted by his classmate Aoko Aozaki and borne witness to an automaton."

#. Occurrence 5B_1:1654:5479: scene=5B_1
#: 5B_1:1654
msgctxt "text_id=5479 | speaker=unknown"
msgid "　……青子の暴挙、動く人形。"
msgstr "  Aoko's violence and an animated doll―"

#. Occurrence 5B_1:1659:5480: scene=5B_1
#: 5B_1:1659
msgctxt "text_id=5480 | speaker=unknown"
msgid "　それらは常識外とは言え、<現|そ><実|こ>にあるものから派生した出来事だ。彼にとっては驚きこそすれ、不思議に思う事はない。"
msgstr "  Though perhaps far beyond the realm of logic, both these things were derived from reality. As surprised as he had been, there was no need to think of them as total mysteries."

#. Occurrence 5B_1:1729:5481: scene=5B_1
#: 5B_1:1729
msgctxt "text_id=5481 | speaker=unknown"
msgid "　しかし。"
msgstr "  However..."

#. Occurrence 5B_1:1734:5482: scene=5B_1
#: 5B_1:1734
msgctxt "text_id=5482 | speaker=unknown"
msgid "　何もない空間、何の関連もない動作から突如あらわれたソレは、彼にとっては不思議以外の何物でもなかった。"
msgstr "  When the thing appeared out of thin air from a seemingly unrelated gesture, he had no word for it besides \"mysterious.\""

#. Occurrence 5B_1:1739:5483: scene=5B_1
#: 5B_1:1739
msgctxt "text_id=5483 | speaker=unknown"
msgid "　草十郎は手品に見惚れるよう、指一本動かせず少女の魔術に襲われる。"
msgstr "  Soujyuro stood motionless, captivated by this stage performer's magic trick, as the girl's single-finger magecraft turned into an attack directed at him."

#. Occurrence 5B_1:1768:5484: scene=5B_1
#: 5B_1:1768
msgctxt "text_id=5484 | speaker=unknown"
msgid "　それを横から<弾|はじ>こう……として、<勢|いきお>い、<跡形|あとかた>もなく粉砕する青い光。"
msgstr "  A blue light flew from the side to repel it, annihilating it without a trace."

#. Occurrence 5B_1:1854:5485: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0012; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:1854
msgctxt "text_id=5485 | speaker=aoko"
msgid "「あ、やば」"
msgstr "\"Oh, crap.\""

#. Occurrence 5B_1:1860:5486: scene=5B_1
#: 5B_1:1860
msgctxt "text_id=5486 | speaker=unknown"
msgid "　青子は脊髄反射で手をだしてしまい、しまった、と反省する。"
msgstr "  Aoko immediately regretted her reflexive shot."

#. Occurrence 5B_1:1934:5487: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0014; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:1934
msgctxt "text_id=5487 | speaker=alice"
msgid "「…………どういう事？　<言葉|やくそく>を曲げただけじゃなく、ルールまで破るつもり？」"
msgstr "\"...What are you doing? You're not satisfied with breaking just our promise, so you must break the rules as well?\""

#. Occurrence 5B_1:1954:5488: scene=5B_1
#: 5B_1:1954
msgctxt "text_id=5488 | speaker=unknown"
msgid "　……ただでさえ冷えきっていた真冬の空気が、もう氷結レベルまで落ちこんでいく。"
msgstr "  The already chilled midwinter air plunged below freezing."

#. Occurrence 5B_1:1959:5489: scene=5B_1
#: 5B_1:1959
msgctxt "text_id=5489 | speaker=unknown"
msgid "　有珠はクールそうに見えて、その実、青子以上に激情家なところがあった。"
msgstr "  Alice looked calm and collected on the outside, but in reality she was sometimes even more hot-blooded than Aoko."

#. Occurrence 5B_1:1979:5490: scene=5B_1
#: 5B_1:1979
msgctxt "text_id=5490 | speaker=unknown"
msgid "　その最たるものが、使い魔への扱いである。"
msgstr "  This was especially true when it concerned her familiars."

#. Occurrence 5B_1:1984:5491: scene=5B_1
#: 5B_1:1984
msgctxt "text_id=5491 | speaker=unknown"
msgid "　悪意のないミスで壊してしまった場合は一週間程度の無言の抗議で済むが、"
msgstr "  Accidentally breaking one would often result in a week of silent treatment,"

#. Occurrence 5B_1:1989:5492: scene=5B_1
#: 5B_1:1989
msgctxt "text_id=5492 | speaker=unknown"
msgid "　悪意をもって破壊したのなら、もうどんな言い訳があろうと報復するのが彼女の性格だった。"
msgstr "  but against someone who maliciously destroyed her things, Alice was prone to retaliate without warning."

#. Occurrence 5B_1:2010:5493: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0013; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2010
msgctxt "text_id=5493 | speaker=aoko"
msgid "“あっちゃあ……いつかやるとは思ったけど、ついに<逆鱗|げきりん>に触れちゃったか……”"
msgstr "\"Whoops. I figured I'd do that someday, but I couldn't have picked a worse time...\""

#. Occurrence 5B_1:2016:5494: scene=5B_1
#: 5B_1:2016
msgctxt "text_id=5494 | speaker=unknown"
msgid "　あーあ、と。自分の馬鹿さ加減に呆れながらも、青子は<清々|すがすが>しさを感じていた。"
msgstr "  Aoko sighed at herself. Even she was exasperated by her own stupidity, yet she couldn't help but feel a pang of relief."

#. Occurrence 5B_1:2021:5495: scene=5B_1
#: 5B_1:2021
msgctxt "text_id=5495 | speaker=unknown"
msgid "　言い訳をする気はないし、後悔もしていない。"
msgstr "  She did not intend to make any excuses, and she had no regrets."

#. Occurrence 5B_1:2026:5496: scene=5B_1
#: 5B_1:2026
msgctxt "text_id=5496 | speaker=unknown"
msgid "　ルールを破ったというのなら、それは有珠も同じである。"
msgstr "  If she had broken the rules, then so had Alice."

#. Occurrence 5B_1:2097:5497: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0015; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:2097
msgctxt "text_id=5497 | speaker=alice"
msgid "「青子」"
msgstr "\"Aoko.\""

#. Occurrence 5B_1:2119:5498: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0014; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2119
msgctxt "text_id=5498 | speaker=aoko"
msgid "「ま、なんていうか―――」"
msgstr "\"How do I put it...\""

#. Occurrence 5B_1:2131:5499: scene=5B_1
#: 5B_1:2131
msgctxt "text_id=5499 | speaker=unknown"
msgid "　逆にさっぱりしたぐらいだ。"
msgstr "  If anything, this took a load off her mind."

#. Occurrence 5B_1:2136:5500: scene=5B_1
#: 5B_1:2136
msgctxt "text_id=5500 | speaker=unknown"
msgid "　だって、こうなった以上はもう色々仕方がない。"
msgstr "  After all, now there was no going back."

#. Occurrence 5B_1:2141:5501: scene=5B_1
#: 5B_1:2141
msgctxt "text_id=5501 | speaker=unknown"
msgid "　青子には自分のルールを破る気なんて毛頭なく、"
msgstr "  Aoko never intended to break her own rules."

#. Occurrence 5B_1:2183:5502: scene=5B_1
#: 5B_1:2183
msgctxt "text_id=5502 | speaker=unknown"
msgid "　反省する事があるといったら、それは力加減を間違えた事だけで、"
msgstr "  If there was anything for Aoko to regret, it was putting too little power into her shot."

#. Occurrence 5B_1:2190:5503: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0015; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2190
msgctxt "text_id=5503 | speaker=aoko"
msgid "「<私|わたし>的に、今夜コイツに死なれるのは困るのよ。"
msgstr "\"I have a problem with this guy dying tonight."

#. Occurrence 5B_1:2196:5504: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0016; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2196
msgctxt "text_id=5504 | speaker=aoko"
msgid "　なんで、日を改めて殺しに来てくれない有珠？　いいでしょ、たった一日ぐらい」"
msgstr "  So, can we reschedule the execution? What difference does a day make?\""

#. Occurrence 5B_1:2202:5505: scene=5B_1
#: 5B_1:2202
msgctxt "text_id=5505 | speaker=unknown"
msgid "　とっさに容疑者Ｓをかばったのは、彼女にとって当然の正義だった。"
msgstr "  To Aoko, it was simply natural to take on a pro bono case in defense of an innocent suspect."

#. Occurrence 5B_1:2255:5506: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0016; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:2255
msgctxt "text_id=5506 | speaker=alice"
msgid "「それは私情？」"
msgstr "\"...Is this personal?\""

#. Occurrence 5B_1:2264:5507: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0017; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2264
msgctxt "text_id=5507 | speaker=aoko"
msgid "「悪い？　一宿一飯の恩義ってわりと大事にしてるの、私」"
msgstr "\"So what if it is? You know that paying back my debts is pretty important to me.\""

#. Occurrence 5B_1:2273:5508: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0017; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:2273
msgctxt "text_id=5508 | speaker=alice"
msgid "「わたしとの協定より？」"
msgstr "\"More important than our agreement?\""

#. Occurrence 5B_1:2282:5509: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0018; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2282
msgctxt "text_id=5509 | speaker=aoko"
msgid "「ええ。時と場合によっては」"
msgstr "\"Sure, depending on the time and place.\""

#. Occurrence 5B_1:2338:5510: scene=5B_1
#: 5B_1:2338
msgctxt "text_id=5510 | speaker=unknown"
msgid "　この場にいる<草十郎|さんにんめ>の人権もなんのその。"
msgstr "  Soujyuro's human rights had not yet entered the argument."

#. Occurrence 5B_1:2349:5511: scene=5B_1
#: 5B_1:2349
msgctxt "text_id=5511 | speaker=unknown"
msgid "　少女たちは互いに油をかけあっていく。"
msgstr "  The girls were busy pouring oil on each other's flames."

#. Occurrence 5B_1:2370:5512: scene=5B_1
#: 5B_1:2370
msgctxt "text_id=5512 | speaker=unknown"
msgid "　感情の切り替え―――いや、感情に火をつけるのは、黒衣の少女の方が先だった。"
msgstr "  The girl clad in black was the first to move―or rather, to erupt."

#. Occurrence 5B_1:2403:5513: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0018; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:2403
msgctxt "text_id=5513 | speaker=alice"
msgid "「―――そう。よく分かったわ青子。"
msgstr "\"...I see. I understand how you feel, Aoko."

#. Occurrence 5B_1:2433:5514: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0019; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:2433
msgctxt "text_id=5514 | speaker=alice"
msgid "　わたしは彼をここで殺す。"
msgstr "  But I am going to have to kill him here."

#. Occurrence 5B_1:2478:5515: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0020; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:2478
msgctxt "text_id=5515 | speaker=alice"
msgid "　貴女は彼をここだけ生かす。"
msgstr "  I believe that you would let him live."

#. Occurrence 5B_1:2502:5516: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0021; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:2502
msgctxt "text_id=5516 | speaker=alice"
msgid "　……つまり。<わ|・><た|・><し|・><と|・><戦|・><う|・>、という事でいい？」"
msgstr "  Shall I take that to mean you're ready to fight me for it?\""

#. Occurrence 5B_1:2546:5517: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0019; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2546
msgctxt "text_id=5517 | speaker=aoko"
msgid "“……ふん。そんなの、いいワケないじゃない”"
msgstr "(...Hmph. You know damn well I'd rather not.)"

#. Occurrence 5B_1:2555:5518: scene=5B_1
#: 5B_1:2555
msgctxt "text_id=5518 | speaker=unknown"
msgid "　なんて弱音をぐっと堪える。"
msgstr "  Aoko bit back the retort."

#. Occurrence 5B_1:2560:5519: scene=5B_1
#: 5B_1:2560
msgctxt "text_id=5519 | speaker=unknown"
msgid "　青子は有珠の魔術を知っている。"
msgstr "  She was very familiar with Alice's magecraft,"

#. Occurrence 5B_1:2565:5520: scene=5B_1
#: 5B_1:2565
msgctxt "text_id=5520 | speaker=unknown"
msgid "　あの小さな体にどれほどの神秘を秘めているか、痛いほど経験している。"
msgstr "  and knew painfully well how many Mystics were hidden in Alice's tiny body."

#. Occurrence 5B_1:2625:5521: scene=5B_1
#: 5B_1:2625
msgctxt "text_id=5521 | speaker=unknown"
msgid "　勝ち目はほとんど、ぜったい<皆無|かいむ>。"
msgstr "  The odds of victory were essentially nonexistent."

#. Occurrence 5B_1:2630:5522: scene=5B_1
#: 5B_1:2630
msgctxt "text_id=5522 | speaker=unknown"
msgid "　そして一度でも口火をきれば、久遠寺有珠は容赦なしだ。"
msgstr "  And once the first shot had been fired, Alice Kuonji was without mercy."

#. Occurrence 5B_1:2643:5523: scene=5B_1
#: 5B_1:2643
msgctxt "text_id=5523 | speaker=unknown"
msgid "　同居人であろうと友人だろうと、"
msgstr "  Whether facing a roommate or a friend,"

#. Occurrence 5B_1:2648:5524: scene=5B_1
#: 5B_1:2648
msgctxt "text_id=5524 | speaker=unknown"
msgid "　彼女の最愛の肉親であろうと、"
msgstr "  a most beloved family member or a stranger,"

#. Occurrence 5B_1:2653:5525: scene=5B_1
#: 5B_1:2653
msgctxt "text_id=5525 | speaker=unknown"
msgid "　魔女として戦う以上、あの少女は<冷徹|れいてつ><無|む><比|ひ>な怪物となる。"
msgstr "  once Alice began to fight as a witch, she became a heartless, unflappable monster."

#. Occurrence 5B_1:2725:5526: scene=5B_1
#: 5B_1:2725
msgctxt "text_id=5526 | speaker=unknown"
msgid "　青子はもう半歩、自らを<鼓|こ><舞|ぶ>するよう前進した。"
msgstr "  Aoko advanced another half step forward as if to encourage herself."

#. Occurrence 5B_1:2730:5527: scene=5B_1
#: 5B_1:2730
msgctxt "text_id=5527 | speaker=unknown"
msgid "　今さら後には退けない。<事|コ><態|ト>はもう、どうでもいい<目撃者|だいさんしゃ>を<巡|めぐ>っての言い争いではない。"
msgstr "  It was too late to back down now. The situation was no longer a trivial quarrel over a witness."

#. Occurrence 5B_1:2735:5528: scene=5B_1
#: 5B_1:2735
msgctxt "text_id=5528 | speaker=unknown"
msgid "　彼女たちの友情らしきものは、実力差はどうあれ、精神的に対等である事が成立の条件になっている。"
msgstr "  The bedrock of their so-called friendship had nothing to do with their individual abilities, and everything to do with being equals in will."

#. Occurrence 5B_1:2741:5529: scene=5B_1
#: 5B_1:2741
msgctxt "text_id=5529 | speaker=unknown"
msgid "　だからこそ―――『自分』を通すのであれば、妥協も誤魔化しも、する訳にはいかなかった。"
msgstr "  That is why, in order to stay true to herself, Aoko had no room for compromise or deception."

#. Occurrence 5B_1:2775:5530: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0020; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2775
msgctxt "text_id=5530 | speaker=aoko"
msgid "「もちろん。アンタを殺す事になっても、そこのバカは生かしきるわ。それに―――」"
msgstr "\"Of course. I'm going to make sure this idiot lives, even if it means killing you. And besides...\""

#. Occurrence 5B_1:2881:5531: scene=5B_1
#: 5B_1:2881
msgctxt "text_id=5531 | speaker=unknown"
msgid "　うなりをあげて式を走らせる魔術回路。"
msgstr "  Her Magic Circuits howled as they kicked into gear."

#. Occurrence 5B_1:2887:5532: scene=5B_1
#: 5B_1:2887
msgctxt "text_id=5532 | speaker=unknown"
msgid "先の人形戦では眠っていた身体が、その真価を発揮させろと燃え上がり―――"
msgstr "Her body, which had mostly been dormant during the battle with the puppet, ignited, preparing to demonstrate its true worth."

#. Occurrence 5B_1:2939:5533: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0021; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:2939
msgctxt "text_id=5533 | speaker=aoko"
msgid "「それに。どのみち最後には殺し合う仲でしょ、私たち……！」"
msgstr "\"We were going to end up killing each other in the end anyway!\""

#. Occurrence 5B_1:2945:5534: scene=5B_1
#: 5B_1:2945
msgctxt "text_id=5534 | speaker=unknown"
msgid "　闘志を<以|もっ>て、強敵への恐怖を克服する―――！"
msgstr "  Her courage overpowered any fear she had for her opponent."

#. Occurrence 5B_1:3153:5535: scene=5B_1
#: 5B_1:3153
msgctxt "text_id=5535 | speaker=unknown"
msgid "　青子の魔弾は自身の体……魔術回路を銃身にして魔力を放つ、ごく単純な魔術式だ。"
msgstr "  Tuning her body―her Magic Circuits―to become like the barrel of a gun, Aoko fired a magic bullet. It was an exceedingly basic magecraft formula."

#. Occurrence 5B_1:3158:5536: scene=5B_1
#: 5B_1:3158
msgctxt "text_id=5536 | speaker=unknown"
msgid "　風を起こす、水を分ける、<劣化|じかん>をかける、といった自然干渉ではない。"
msgstr "  There was no nature interference: no creating of wind, parting of water, nor hastening of decay."

#. Occurrence 5B_1:3163:5537: scene=5B_1
#: 5B_1:3163
msgctxt "text_id=5537 | speaker=unknown"
msgid "　魔力という架空の運動を実在へと加工し、熱量として撃ちだしている。"
msgstr "  It was simply the process of converting the imaginary activity known as magical energy into something real, before releasing it as heat."

#. Occurrence 5B_1:3168:5538: scene=5B_1
#: 5B_1:3168
msgctxt "text_id=5538 | speaker=unknown"
msgid "　なので、その破壊力は青子が扱える魔力量がイコールとなる。"
msgstr "  Thus Aoko's destructive power was equal to her supply of magical energy."

#. Occurrence 5B_1:3188:5539: scene=5B_1
#: 5B_1:3188
msgctxt "text_id=5539 | speaker=unknown"
msgid "　草十郎相手に使用した魔弾は<一工程|シングルアクション>、詠唱を必要としない最低限の魔術だった。"
msgstr "  The magic bullets she had used against Soujyuro were among the most basic single-action magecraft that did not require an incantation."

#. Occurrence 5B_1:3194:5540: scene=5B_1
#: 5B_1:3194
msgctxt "text_id=5540 | speaker=unknown"
msgid "　現状、青子が主武器とする魔弾には三つの工程がある。"
msgstr "  At her present ability, Aoko's main mode of attack―her magic bullet―could be fired at three levels of power."

#. Occurrence 5B_1:3199:5541: scene=5B_1
#: 5B_1:3199
msgctxt "text_id=5541 | speaker=unknown"
msgid "　これはその二つめ。"
msgstr "  These were at the second level."

#. Occurrence 5B_1:3204:5542: scene=5B_1
#: 5B_1:3204
msgctxt "text_id=5542 | speaker=unknown"
msgid "　魔術刻印を<起動|リード>させ、簡略化詠唱を用いた二工程の魔弾である。"
msgstr "  This required a double-action magecraft―a casting through activation of her crest combined with a simplified incantation."

#. Occurrence 5B_1:3345:5543: scene=5B_1
#: 5B_1:3345
msgctxt "text_id=5543 | speaker=unknown"
msgid "　しかし。"
msgstr "  However..."

#. Occurrence 5B_1:3350:5544: scene=5B_1
#: 5B_1:3350
msgctxt "text_id=5544 | speaker=unknown"
msgid "　それなりに気合いを込めた青子の魔弾を、少女は<瞬|またた>き一つせず霧散させた。"
msgstr "  Without blinking, Alice dispersed the shot that Aoko had mustered all of her spirit to fire."

#. Occurrence 5B_1:3550:5545: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0022; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:3550
msgctxt "text_id=5545 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5B_1:3556:5546: scene=5B_1
#: 5B_1:3556
msgctxt "text_id=5546 | speaker=unknown"
msgid "　ち、と舌打ちする青子。"
msgstr "  Aoko tutted in frustration."

#. Occurrence 5B_1:3561:5547: scene=5B_1
#: 5B_1:3561
msgctxt "text_id=5547 | speaker=unknown"
msgid "　不意打ちの速攻―――詠唱を簡略した魔術行使では、久遠寺有珠の守りは破れない。"
msgstr "  A swift sneak attack that used a simplified incantation would not be enough to break Alice's guard."

#. Occurrence 5B_1:3630:5548: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0023; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:3630
msgctxt "text_id=5548 | speaker=aoko"
msgid "「相変わらずお<堅|かた>いこと。その<殻|カラ>、一段と独りよがりになってるんじゃない？」"
msgstr "\"As stiff as ever, I see. Don't you think that shell is making you complacent?\""

#. Occurrence 5B_1:3636:5549: scene=5B_1
#: 5B_1:3636
msgctxt "text_id=5549 | speaker=unknown"
msgid "　青子は内心の焦りをおくびにも出さず挑発する。"
msgstr "  Aoko provoked Alice in order to disguise her own lack of composure."

#. Occurrence 5B_1:3658:5550: scene=5B_1
#: 5B_1:3658
msgctxt "text_id=5550 | speaker=unknown"
msgid "　そのやせ我慢が気に入ったのか。"
msgstr "  Somehow Alice seemed delighted by Aoko's bravado."

#. Occurrence 5B_1:3665:5551: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0022; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:3665
msgctxt "text_id=5551 | speaker=alice"
msgid "「売り言葉に買い言葉、というヤツね。"
msgstr "\"I suppose this is what they call 'fighting words.'"

#. Occurrence 5B_1:3671:5552: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0023; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:3671
msgctxt "text_id=5552 | speaker=alice"
msgid "　こういう、勢いだけのきっかけは初めてだけど……」"
msgstr "  I've never fought to the death for such a trivial reason.\""

#. Occurrence 5B_1:3725:5553: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0024; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:3725
msgctxt "text_id=5553 | speaker=alice"
msgid "「驚いたわ。こんな下らない理由でも、その気になるものなのね、人間って」"
msgstr "\"I'm really shocked. Humans are such conceited creatures.\""

#. Occurrence 5B_1:3731:5554: scene=5B_1
#: 5B_1:3731
msgctxt "text_id=5554 | speaker=unknown"
msgid "　くすりと。"
msgstr "  Alice giggled."

#. Occurrence 5B_1:3736:5555: scene=5B_1
#: 5B_1:3736
msgctxt "text_id=5555 | speaker=unknown"
msgid "　心の底から感心するように微笑んで、少女は左手の指を地上に向けた。"
msgstr "  Smiling with heartfelt amazement, Alice gestured her left hand toward the earth."

#. Occurrence 5B_1:3978:5556: scene=5B_1
#: 5B_1:3978
msgctxt "text_id=5556 | speaker=unknown"
msgid "　<刺|zap>す。<刺|zap>す。<刺|zap>す。<刺|zap>す。"
msgstr "  <Stab.|Zap.> <Stab.|Zap.> <Stab.|Zap.> <Stab|Zap.>."

#. Occurrence 5B_1:3983:5557: scene=5B_1
#: 5B_1:3983
msgctxt "text_id=5557 | speaker=unknown"
msgid "　広場の地面、レンガを破って突き出る無数の槍。"
msgstr "  Countless utensils shot out from underneath the cobblestones paving the plaza."

#. Occurrence 5B_1:4050:5558: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0024; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:4050
msgctxt "text_id=5558 | speaker=aoko"
msgid "「静希君、後ろに跳んで！」"
msgstr "\"Sizuki, get back!\""

#. Occurrence 5B_1:4056:5559: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_1_0005; voice_prefix=A30; voice_category=3; scene=5B_1
#: 5B_1:4056
msgctxt "text_id=5559 | speaker=soujuurou"
msgid "「？」"
msgstr "\"...?\""

#. Occurrence 5B_1:4061:5560: scene=5B_1
#: 5B_1:4061
msgctxt "text_id=5560 | speaker=unknown"
msgid "　青子は呼びかけながら、彼が反応するより早く手を取って後ろに跳んだ。"
msgstr "  She grabbed his hand as she shouted, jumping backward before he even had a chance to respond."

#. Occurrence 5B_1:4128:5561: scene=5B_1
#: 5B_1:4128
msgctxt "text_id=5561 | speaker=unknown"
msgid "　地面から湧き立つ器物は意志を持つように、跳び退く青子たちを追いかける。"
msgstr "  As if they had wills of their own, the utensils that had suddenly appeared from the ground gave chase."

#. Occurrence 5B_1:4133:5562: scene=5B_1
#: 5B_1:4133
msgctxt "text_id=5562 | speaker=unknown"
msgid "　槍の守りは放射状に広がり、青子と草十郎を時計台から離していく。"
msgstr "  As the barrier of spears grew around them, Aoko and Soujyuro put some distance between themselves and the clock tower."

#. Occurrence 5B_1:4191:5563: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0025; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:4191
msgctxt "text_id=5563 | speaker=aoko"
msgid "「―――え、これで終わり？」"
msgstr "\"That all you've got?\""

#. Occurrence 5B_1:4197:5564: scene=5B_1
#: 5B_1:4197
msgctxt "text_id=5564 | speaker=unknown"
msgid "　後ろに下がること十メートル弱。"
msgstr "  Just under thirty feet stood between them and Alice."

#. Occurrence 5B_1:4202:5565: scene=5B_1
#: 5B_1:4202
msgctxt "text_id=5565 | speaker=unknown"
msgid "　地面を砕いて現れる凶器たちの成長は、青子の予想より小規模に留まった。"
msgstr "  The lethal weapons that had crumbled the stone beneath them fell short of what Aoko had anticipated."

#. Occurrence 5B_1:4207:5566: scene=5B_1
#: 5B_1:4207
msgctxt "text_id=5566 | speaker=unknown"
msgid "　少女の立つ時計台を守るソレは、<磔|はりつけ>にされた魔女を責める<薪|たきぎ>のようで―――"
msgstr "  They now encircled the clock tower, making the scene look like the burning of a witch at the stake."

#. Occurrence 5B_1:4228:5567: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0026; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:4228
msgctxt "text_id=5567 | speaker=aoko"
msgid "“……普通、逆じゃない？　ここは私たちを逃がさないよう、槍で周りを囲むものでしょう……？”"
msgstr "(Isn't this backwards? You'd expect the spears to try and stop us from escaping...)"

#. Occurrence 5B_1:4234:5568: scene=5B_1
#: 5B_1:4234
msgctxt "text_id=5568 | speaker=unknown"
msgid "　青子と草十郎の後ろには安全な道がある。"
msgstr "  The path behind them was safe."

#. Occurrence 5B_1:4239:5569: scene=5B_1
#: 5B_1:4239
msgctxt "text_id=5569 | speaker=unknown"
msgid "　その気になれば二人は遊園地の入り口まで走って、そのまま町へ逃げられる。"
msgstr "  If they wanted, they could try to make a break for the main gate and escape."

#. Occurrence 5B_1:4285:5570: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0027; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:4285
msgctxt "text_id=5570 | speaker=aoko"
msgid "「いいの有珠？"
msgstr "\"Are you sure about this, Alice?"

msgctxt "text_id=5571 | speaker=unknown"
msgid "　悪いけど、逃げられるなら逃げるわよ、私」"
msgstr "  Sorry, but if you're going to let me escape, I'm not going to pass the chance up.\""

#. Occurrence 5B_1:4293:5572: scene=5B_1
#: 5B_1:4293
msgctxt "text_id=5572 | speaker=unknown"
msgid "　町にまで出れば青子の勝ちだ。"
msgstr "  If she could just make it back to town, it would be Aoko's win."

#. Occurrence 5B_1:4298:5573: scene=5B_1
#: 5B_1:4298
msgctxt "text_id=5573 | speaker=unknown"
msgid "　今夜だけ草十郎を見逃したい青子にとって、彼を街に逃がしてしまえば目的は大部分達成―――"
msgstr "  All she wanted to do was let Soujyuro get away for the night, so if she could get him back to the city it would be, for the most part, mission accomplished."

#. Occurrence 5B_1:4354:5574: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0028; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:4354
msgctxt "text_id=5574 | speaker=aoko"
msgid "「？」"
msgstr "\"...?\""

#. Occurrence 5B_1:4374:5575: scene=5B_1
#: 5B_1:4374
msgctxt "text_id=5575 | speaker=unknown"
msgid "　―――なのだが。"
msgstr "  ...Or so she had thought."

#. Occurrence 5B_1:4379:5576: scene=5B_1
#: 5B_1:4379
msgctxt "text_id=5576 | speaker=unknown"
msgid "　有珠は眼下の標的に目もくれず、愛しい、大切なものを扱うように<小瓶|こびん>を取り出した。"
msgstr "  Without even offering a glance at her targets below, Alice carefully and lovingly pulled out a bottle from her pocket."

#. Occurrence 5B_1:4425:5577: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0029; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:4425
msgctxt "text_id=5577 | speaker=aoko"
msgid "「緑の……フラスコ？"
msgstr "\"A green... flask?"

#. Occurrence 5B_1:4431:5578: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0030; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:4431
msgctxt "text_id=5578 | speaker=aoko"
msgid "　あれってたしか―――やばっ、とにかく<撃て|ファイヤ>―――！」"
msgstr "  Wait, that's... Damn it! Fire!\""

#. Occurrence 5B_1:4665:5579: scene=5B_1
#: 5B_1:4665
msgctxt "text_id=5579 | speaker=unknown"
msgid "　防がれる魔弾。"
msgstr "  Her shot was deflected with ease."

#. Occurrence 5B_1:4670:5580: scene=5B_1
#: 5B_1:4670
msgctxt "text_id=5580 | speaker=unknown"
msgid "　青子の顔には、もう一片の余裕もない。"
msgstr "  Gone was Aoko's earlier bravado."

#. Occurrence 5B_1:4757:5581: scene=5B_1
#: 5B_1:4757
msgctxt "text_id=5581 | speaker=unknown"
msgid "　……そう。"
msgstr "  It was only natural―"

#. Occurrence 5B_1:4762:5582: scene=5B_1
#: 5B_1:4762
msgctxt "text_id=5582 | speaker=unknown"
msgid "　増長していたと言えば、青子はたしかに増長していた。"
msgstr "  Aoko had indeed grown as a mage."

#. Occurrence 5B_1:4767:5583: scene=5B_1
#: 5B_1:4767
msgctxt "text_id=5583 | speaker=unknown"
msgid "　この二年、学び続けた魔術に手応えもあった。"
msgstr "  Over the last two years of study, her studies had progressed well,"

#. Occurrence 5B_1:4772:5584: scene=5B_1
#: 5B_1:4772
msgctxt "text_id=5584 | speaker=unknown"
msgid "　同居人の性格、魔術もそれなりに把握していた。"
msgstr "  and she'd more or less gotten a grasp on her roommate's tendencies and abilities."

#. Occurrence 5B_1:4812:5585: scene=5B_1
#: 5B_1:4812
msgctxt "text_id=5585 | speaker=unknown"
msgid "　だから―――最善の立ち回りをすれば、久遠寺有珠に一杯くわせられると思い上がったのだ。"
msgstr "  This had made her conceited enough to believe that, under favorable circumstances, she'd be able to show Alice a thing or two in a fight."

#. Occurrence 5B_1:4890:5586: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0031; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:4890
msgctxt "text_id=5586 | speaker=aoko"
msgid "「あ―――」"
msgstr "\"Ah...\""

#. Occurrence 5B_1:4895:5587: scene=5B_1
#: 5B_1:4895
msgctxt "text_id=5587 | speaker=unknown"
msgid "　……魔法の<瓶|びん>の<蓋|ふた>が開く。"
msgstr "  Alice uncorked the magical bottle."

#. Occurrence 5B_1:4936:5588: scene=5B_1
#: 5B_1:4936
msgctxt "text_id=5588 | speaker=unknown"
msgid "　頬を優しい風が<撫|な>でる。"
msgstr "  A gentle breeze caressed her cheek."

#. Occurrence 5B_1:5050:5589: scene=5B_1
#: 5B_1:5050
msgctxt "text_id=5589 | speaker=unknown"
msgid "　夜の饗宴が、新たな主役の登場に尻尾を巻いて逃げ出していく。"
msgstr "  Diddle Diddle fled as a new player stepped onto the stage."

#. Occurrence 5B_1:5104:5590: scene=5B_1
#: 5B_1:5104
msgctxt "text_id=5590 | speaker=unknown"
msgid "　―――どこからか。"
msgstr "  ...But from where would it enter?"

#. Occurrence 5B_1:5109:5591: scene=5B_1
#: 5B_1:5109
msgctxt "text_id=5591 | speaker=unknown"
msgid "　懐かしい、パレードの足音がやってくる。"
msgstr "  The sound of footsteps, a nostalgic parade, approached."

#. Occurrence 5B_1:5380:5592: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_1_0032; voice_prefix=A10; voice_category=1; scene=5B_1
#: 5B_1:5380
msgctxt "text_id=5592 | speaker=aoko"
msgid "「う、そ―――」"
msgstr "\"No...way...\""

#. Occurrence 5B_1:5469:5593: scene=5B_1
#: 5B_1:5469
msgctxt "text_id=5593 | speaker=unknown"
msgid "　それは。"
msgstr "  What emerged..."

#. Occurrence 5B_1:5474:5594: scene=5B_1
#: 5B_1:5474
msgctxt "text_id=5594 | speaker=unknown"
msgid "　魔術師見習いである蒼崎青子ですら、体験した事のない奇跡だった。"
msgstr "  was a miracle that Aoko Aozaki, an apprentice mage, had never witnessed."

#. Occurrence 5B_1:5597:5595: scene=5B_1
#: 5B_1:5597
msgctxt "text_id=5595 | speaker=unknown"
msgid "　死んでいたモノが蘇る。"
msgstr "  The dead came to life."

#. Occurrence 5B_1:5602:5596: scene=5B_1
#: 5B_1:5602
msgctxt "text_id=5596 | speaker=unknown"
msgid "　生きていないモノが目を覚ます。"
msgstr "  The inanimate awakened."

#. Occurrence 5B_1:5607:5597: scene=5B_1
#: 5B_1:5607
msgctxt "text_id=5597 | speaker=unknown"
msgid "　霧に包まれた深い森。"
msgstr "  The woods were enveloped by the mists."

#. Occurrence 5B_1:5612:5598: scene=5B_1
#: 5B_1:5612
msgctxt "text_id=5598 | speaker=unknown"
msgid "　沼地にひそむ火を噴くトカゲ。"
msgstr "  Fire-breathing lizards lurked in the swamps."

#. Occurrence 5B_1:5617:5599: scene=5B_1
#: 5B_1:5617
msgctxt "text_id=5599 | speaker=unknown"
msgid "　午前零時をむかえてはしゃぎだすパペットたち。"
msgstr "  Puppets made merry at midnight."

#. Occurrence 5B_1:5627:5600: scene=5B_1
#: 5B_1:5627
msgctxt "text_id=5600 | speaker=unknown"
msgid "　久遠寺有珠の細い指は、年老いた猫の背中を撫でるように優しく、遊園地全体を変貌させ―――"
msgstr "  Alice Kuonji's slender fingers had transfigured the entirety of the park, as if gently stroking the back of an elderly cat."

#. Occurrence 5B_1:5677:5601: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0025_0; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:5677
msgctxt "text_id=5601 | speaker=alice"
msgid "　　「いいわ―――"
msgstr "    \"Very well..."

#. Occurrence 5B_1:5684:5602: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0025_1; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:5684
msgctxt "text_id=5602 | speaker=alice"
msgid "ごっこ遊びをしましょう、青子」"
msgstr " Let us play pretend, Aoko.\""

#. Occurrence 5B_1:5747:5603: scene=5B_1
#: 5B_1:5747
msgctxt "text_id=5603 | speaker=unknown"
msgid "　……ありし日の夢の廃棄場は、一夜かぎりの王国に生まれ変わる。"
msgstr "  For one night, the wasteland of dashed hopes and dreams was restored to its former glory."

#. Occurrence 5B_1:5853:5604: scene=5B_1
#: 5B_1:5853
msgctxt "text_id=5604 | speaker=unknown"
msgid "　それは現実を侵食する不死身の魔物。"
msgstr "  It was an immortal monster ready to devour reality-"

#. Occurrence 5B_1:5858:5605: scene=5B_1
#: 5B_1:5858
msgctxt "text_id=5605 | speaker=unknown"
msgid "　<一度|ひとたび>解き放たれれば、決して獲物を逃がさない暗黒童話。"
msgstr "  a dark fairy tale that, once unleashed, would never let its prey escape."

#. Occurrence 5B_1:5890:5606: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0026; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:5890
msgctxt "text_id=5606 | speaker=alice"
msgid "「逃げられるものなら逃げてみせて。"
msgstr "\"Run if you dare."

#. Occurrence 5B_1:5896:5607: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_1_0027; voice_prefix=A40; voice_category=2; scene=5B_1
#: 5B_1:5896
msgctxt "text_id=5607 | speaker=alice"
msgid "　どこまで行けるか分からないけど―――この夜を越える事ができたのなら、貴女の勝ちにしてあげる」"
msgstr "  I don't believe you'll get far, but if you can survive the night, I'll concede this round to you.\""

#. Occurrence 5B_1:5917:5608: scene=5B_1
#: 5B_1:5917
msgctxt "text_id=5608 | speaker=unknown"
msgid "　……絶望的な戦いの開幕宣言。"
msgstr "  Her declaration marked the start of a desperate battle."

#. Occurrence 5B_1:5922:5609: scene=5B_1
#: 5B_1:5922
msgctxt "text_id=5609 | speaker=unknown"
msgid "　親愛と悲しみ、それと無邪気な愉悦をこめて、"
msgstr "  The witch in black laughed at her friend,"

#. Occurrence 5B_1:5927:5610: scene=5B_1
#: 5B_1:5927
msgctxt "text_id=5610 | speaker=unknown"
msgid "　黒衣の魔女は友人へと<歌|わら>いかけた。"
msgstr "  her musical mirth filled with affection, sadness, and innocent delight."

#. Occurrence 5B_10:42:5611: scene=5B_10
#: 5B_10:42
msgctxt "text_id=5611 | speaker=unknown"
msgid "　けれど、希望はいつだって束の間のもの。"
msgstr "  But hope was something ever fleeting."

#. Occurrence 5B_10:47:5612: scene=5B_10
#: 5B_10:47
msgctxt "text_id=5612 | speaker=unknown"
msgid "　彼らの希望は三百メートル分しか続かなかった。"
msgstr "  In fact, it lasted not even three hundred yards."

#. Occurrence 5B_10:53:5613: scene=5B_10
#: 5B_10:53
msgctxt "text_id=5613 | speaker=unknown"
msgid "　遊園地の果ては、何の比喩もなく“世界の果て”そのものだったのだから。"
msgstr "  The edge of the amusement park may well have been the edge of the world."

#. Occurrence 5B_10:250:5614: scene=5B_10
#: 5B_10:250
msgctxt "text_id=5614 | speaker=unknown"
msgid "　波立つ、何十という地平線。"
msgstr "  Dozens of undulating horizons could be seen,"

#. Occurrence 5B_10:255:5615: scene=5B_10
#: 5B_10:255
msgctxt "text_id=5615 | speaker=unknown"
msgid "　それは<群雲|むらくも>のような、<緞帳|どんちょう>のような、"
msgstr "  crowding the sky like a giant cloud, or a thick curtain,"

#. Occurrence 5B_10:260:5616: scene=5B_10
#: 5B_10:260
msgctxt "text_id=5616 | speaker=unknown"
msgid "　あるいは呻きをもらす<唇|ひだ>のような、"
msgstr "  or perhaps, groaning lips."

#. Occurrence 5B_10:265:5617: scene=5B_10
#: 5B_10:265
msgctxt "text_id=5617 | speaker=unknown"
msgid "　あまりにも奇怪で、あまりにも童話めいた、この世界の行き止まり。"
msgstr "  It was the end of the road; the outer limit of an outrageous and fantastical realm."

#. Occurrence 5B_10:271:5618: scene=5B_10
#: 5B_10:271
msgctxt "text_id=5618 | speaker=unknown"
msgid "　―――さながら。"
msgstr "  And yet..."

#. Occurrence 5B_10:271:5619: scene=5B_10
#: 5B_10:271
msgctxt "text_id=5619 | speaker=unknown"
msgid "　巨大な紙芝居の最後の一枚だと、彼女は思った。"
msgstr "  Aoko found it to be much like the last page of an enormous picture book."

#. Occurrence 5B_10:426:5620: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0000; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:426
msgctxt "text_id=5620 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5B_10:432:5621: scene=5B_10
#: 5B_10:432
msgctxt "text_id=5621 | speaker=unknown"
msgid "　その光景を前にした時、青子は不覚にも、一切の思考を放棄した。"
msgstr "  The sight turned her mind blank."

#. Occurrence 5B_10:437:5622: scene=5B_10
#: 5B_10:437
msgctxt "text_id=5622 | speaker=unknown"
msgid "　……ああ、たいへんな事になったな、と。"
msgstr "  \"Well, this is about as bad as it gets,\" she thought."

#. Occurrence 5B_10:442:5623: scene=5B_10
#: 5B_10:442
msgctxt "text_id=5623 | speaker=unknown"
msgid "　波立つ境界線を見て、ようやく、この<絶望島|スナーク>に膝を屈した。"
msgstr "  The Snark―this island of despair―had, at last, brought Aoko to her knees as she stared at the swelling border."

#. Occurrence 5B_10:533:5624: scene=5B_10
#: 5B_10:533
msgctxt "text_id=5624 | speaker=unknown"
msgid "　遊園地に終わりはあった。"
msgstr "  The park indeed had an end."

#. Occurrence 5B_10:538:5625: scene=5B_10
#: 5B_10:538
msgctxt "text_id=5625 | speaker=unknown"
msgid "　青子たちの知っている通り、遊園地と住宅街を<隔|へだ>てる鉄柵はこうして今も。"
msgstr "  Even now, as Aoko and Soujyuro had expected, a fence divided the amusement park from the residential area neighboring it."

#. Occurrence 5B_10:558:5626: scene=5B_10
#: 5B_10:558
msgctxt "text_id=5626 | speaker=unknown"
msgid "　鉄柵は二倍ぐらい高くなっていたり、なんだか装飾が頑丈になっていたりするけど、それも想定の範囲内。"
msgstr "  It had both doubled in height and been made sturdier, another hurdle she had foreseen before even laying eyes on it."

#. Occurrence 5B_10:563:5627: scene=5B_10
#: 5B_10:563
msgctxt "text_id=5627 | speaker=unknown"
msgid "　たとえ鉄柵がスナーク化していようと、壁の一枚や二枚なら撃ち抜く<気概|つもり>で彼女はここまでやって来たのだから。"
msgstr "  Expecting it to have been Snarkified, Aoko had come prepared to demolish an obstacle or two."

#. Occurrence 5B_10:569:5628: scene=5B_10
#: 5B_10:569
msgctxt "text_id=5628 | speaker=unknown"
msgid "　……けれど。"
msgstr "  But this..."

#. Occurrence 5B_10:574:5629: scene=5B_10
#: 5B_10:574
msgctxt "text_id=5629 | speaker=unknown"
msgid "　目前に広がるモノは、もはや境界ですらなかった。"
msgstr "  This construction before her went far beyond a mere wall."

#. Occurrence 5B_10:647:5630: scene=5B_10
#: 5B_10:647
msgctxt "text_id=5630 | speaker=unknown"
msgid "　この異界と外界を分かつ海。"
msgstr "  It was an ocean that separated the underworld from the mortal one."

#. Occurrence 5B_10:652:5631: scene=5B_10
#: 5B_10:652
msgctxt "text_id=5631 | speaker=unknown"
msgid "　鉄柵は寄せ返す<波濤|はとう>の如く。"
msgstr "  The iron fence was like a restless, surging sea."

#. Occurrence 5B_10:657:5632: scene=5B_10
#: 5B_10:657
msgctxt "text_id=5632 | speaker=unknown"
msgid "　一枚、二枚はたやすく破れる。"
msgstr "  One or two walls could easily be toppled."

#. Occurrence 5B_10:662:5633: scene=5B_10
#: 5B_10:662
msgctxt "text_id=5633 | speaker=unknown"
msgid "　十枚、二十枚までは何とか進める。"
msgstr "  Even ten or twenty could be dealt with one way or another."

#. Occurrence 5B_10:667:5634: scene=5B_10
#: 5B_10:667
msgctxt "text_id=5634 | speaker=unknown"
msgid "　残った自身の魔力と、遊園地に満ちた魔力と、魔術回路と刻印を焼き切れるまで総動員すれば、ただ一度きり、<十戒|じっかい>の真似事ぐらいはやってみせると強がれる。"
msgstr "  Between the power left in her body and that which filled the park, putting on a brave front was within her power. She could fully mobilize her circuits and her crest to the point of burnout in a last-ditch effort, like some reenactment of the parting of the Red Sea."

#. Occurrence 5B_10:707:5635: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0001; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:707
msgctxt "text_id=5635 | speaker=aoko"
msgid "「―――でも、それで終わり」"
msgstr "\"But then that would be it.\""

#. Occurrence 5B_10:713:5636: scene=5B_10
#: 5B_10:713
msgctxt "text_id=5636 | speaker=unknown"
msgid "　この海を割った後、青子には立ち上がる体力さえ残らない。"
msgstr "  Even if a path could be opened, she would not have the energy left to walk it."

#. Occurrence 5B_10:718:5637: scene=5B_10
#: 5B_10:718
msgctxt "text_id=5637 | speaker=unknown"
msgid "　……その後の運命は明白だ。"
msgstr "  And it was obvious what would become of her afterward."

#. Occurrence 5B_10:723:5638: scene=5B_10
#: 5B_10:723
msgctxt "text_id=5638 | speaker=unknown"
msgid "　さんざん遊園地を壊してまわった青子を、住人たちは決して許しはしないだろう。<蜜|みつ>にたかる<蟻|あり>の如く、動けなくなった少女を八つ裂きにする。"
msgstr "  The residents would hardly forgive her for wreaking such havoc around their park. Like ants drawn to honey, they would swarm the helpless girl and tear her to pieces."

#. Occurrence 5B_10:757:5639: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0002; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:757
msgctxt "text_id=5639 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5B_10:763:5640: scene=5B_10
#: 5B_10:763
msgctxt "text_id=5640 | speaker=unknown"
msgid "　<落胆|らくたん>と疲れから、微かな後悔がこぼれる。"
msgstr "  Despondent and exhausted, she felt the faint sting of remorse."

#. Occurrence 5B_10:768:5641: scene=5B_10
#: 5B_10:768
msgctxt "text_id=5641 | speaker=unknown"
msgid "　遊園地から外に出る。"
msgstr "  Escaping the park..."

#. Occurrence 5B_10:773:5642: scene=5B_10
#: 5B_10:773
msgctxt "text_id=5642 | speaker=unknown"
msgid "　その選択自体が間違いだったと認めて、青子は来た道を振り返った。"
msgstr "  Looking back on how they had gotten here, Aoko recognized that her choices had been her undoing."

#. Occurrence 5B_10:924:5643: scene=5B_10
#: 5B_10:924
msgctxt "text_id=5643 | speaker=unknown"
msgid "　<金色|こんじき>の満月の下、鉄骨はうねり、針金細工のように集まっている。"
msgstr "  Under the golden full moon, beams of steel bent and merged like wire-frame sculptures."

#. Occurrence 5B_10:939:5644: scene=5B_10
#: 5B_10:939
msgctxt "text_id=5644 | speaker=unknown"
msgid "　遊園地そのものが巨大な“怪物”になるのも時間の問題だ。"
msgstr "  It was only a matter of time before the amusement park itself became one colossal monster."

#. Occurrence 5B_10:944:5645: scene=5B_10
#: 5B_10:944
msgctxt "text_id=5645 | speaker=unknown"
msgid "　有珠のいる広場には大量の使い魔が集っており近寄れもしない。"
msgstr "  The horde of familiars, gathered in the plaza where Alice was, had formed an impenetrable blockade around her."

#. Occurrence 5B_10:957:5646: scene=5B_10
#: 5B_10:957
msgctxt "text_id=5646 | speaker=unknown"
msgid "　傍らに立つ少年の頭上には、かわらず表面をシャッフルし続ける<囁く卵|スクラッチ・ダンプティ>。"
msgstr "  Just above the head of the boy beside her, the whispering egg―called Scratch Dumpty―continued to shuffle what appeared on its surface."

#. Occurrence 5B_10:1020:5647: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0000; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1020
msgctxt "text_id=5647 | speaker=soujuurou"
msgid "「―――蒼崎！」"
msgstr "\"Aozaki!\""

#. Occurrence 5B_10:1071:5648: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0003; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1071
msgctxt "text_id=5648 | speaker=aoko"
msgid "「静希君……？」"
msgstr "\"Sizuki?\""

#. Occurrence 5B_10:1141:5649: scene=5B_10
#: 5B_10:1141
msgctxt "text_id=5649 | speaker=unknown"
msgid "　少年の声に、止まっていた思考が動き出す。"
msgstr "  The boy's voice snapped Aoko out of her trance."

#. Occurrence 5B_10:1146:5650: scene=5B_10
#: 5B_10:1146
msgctxt "text_id=5650 | speaker=unknown"
msgid "　……けれど、それも一瞬。"
msgstr "  If only for a moment."

#. Occurrence 5B_10:1151:5651: scene=5B_10
#: 5B_10:1151
msgctxt "text_id=5651 | speaker=unknown"
msgid "　魔術師である青子は現状を把握してしまう。"
msgstr "  The stark reality of the situation quickly dawned on the novice mage―"

#. Occurrence 5B_10:1156:5652: scene=5B_10
#: 5B_10:1156
msgctxt "text_id=5652 | speaker=unknown"
msgid "　その絶望が、彼女から抗う<選択|いし>を根こそぎ奪っていた。"
msgstr "  the sheer hopelessness of it all, as it ripped out and snatched away any will she had to resist."

#. Occurrence 5B_10:1241:5653: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0001; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1241
msgctxt "text_id=5653 | speaker=soujuurou"
msgid "「<正門|ゲート>に行こう。ここはどうしようもないけど、入り口ならもうちょっとマシだろう。"
msgstr "\"Let's head for the gate. It's hopeless here, but we might have a chance at the entrance."

#. Occurrence 5B_10:1247:5654: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0002; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1247
msgctxt "text_id=5654 | speaker=soujuurou"
msgid "　フラットスナークだっけ？　コイツにもルールがあるって言ったじゃないか。"
msgstr "  That Flat Snark thing. You said it has its own set of rules to follow, right?"

#. Occurrence 5B_10:1254:5655: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0003; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1254
msgctxt "text_id=5655 | speaker=soujuurou"
msgid "なら、これは役割の問題だ。はじめから鉄柵は通れない壁だけど、正門なら出入り口として機能しているかも知れない」"
msgstr "Then, we need to think about the basics. The fence would have been impassable from the start, but the gate might still work as an entrance and exit.\""

#. Occurrence 5B_10:1282:5656: scene=5B_10
#: 5B_10:1282
msgctxt "text_id=5656 | speaker=unknown"
msgid "　草十郎はパニックに<陥|おちい>っていない。"
msgstr "  Soujyuro had not given in to panic."

#. Occurrence 5B_10:1287:5657: scene=5B_10
#: 5B_10:1287
msgctxt "text_id=5657 | speaker=unknown"
msgid "　この状況でスナークの特性を読み取れるのは凄いな、と青子は素直に感心した。"
msgstr "  Aoko found herself honestly admiring Soujyuro's ability to analyze Snark's characteristics, given the circumstances."

#. Occurrence 5B_10:1292:5658: scene=5B_10
#: 5B_10:1292
msgctxt "text_id=5658 | speaker=unknown"
msgid "　冷めきった、覚悟を決めた心持ちで。"
msgstr "  Now calm, she steeled her resolve."

#. Occurrence 5B_10:1326:5659: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0004; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1326
msgctxt "text_id=5659 | speaker=aoko"
msgid "「……そうね。たしかに門はあると思う。"
msgstr "\"You're right. The gate is a good option."

#. Occurrence 5B_10:1332:5660: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0005; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1332
msgctxt "text_id=5660 | speaker=aoko"
msgid "　けど、たどり着くのは難しいわ。一番弱かった焼きたてパンですら、今はもうアレだもの。"
msgstr "  But just getting there will be a challenge. Even the weakest enemies, those loaves, are becoming hard to deal with."

#. Occurrence 5B_10:1338:5661: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0006; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1338
msgctxt "text_id=5661 | speaker=aoko"
msgid "　広場や入り口にはもっと上等なのがたむろしてるだろうし、門だって、あの観覧車以上の怪物かもしれない。たしか大きなキッツィーちゃんだったでしょ、正門って」"
msgstr "  Plus, the best of her familiars are just going to keep gathering at the plaza and the entrance. I mean, the gate itself might be a monster even worse than the Ferris wheel. It's designed to look like a giant Kitsy.\""

#. Occurrence 5B_10:1411:5662: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0004; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1411
msgctxt "text_id=5662 | speaker=soujuurou"
msgid "「……蒼崎は正門には行かないのか？」"
msgstr "\"So you're not going to the front gate?\""

#. Occurrence 5B_10:1417:5663: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0007; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1417
msgctxt "text_id=5663 | speaker=aoko"
msgid "「まあね。それよりこっちの方が現実的だし」"
msgstr "\"Nah. We have a better chance over here.\""

#. Occurrence 5B_10:1431:5664: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0005; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1431
msgctxt "text_id=5664 | speaker=soujuurou"
msgid "「？」"
msgstr "\"...?\""

#. Occurrence 5B_10:1502:5665: scene=5B_10
#: 5B_10:1502
msgctxt "text_id=5665 | speaker=unknown"
msgid "　青子は波立つ鉄柵を<一瞥|いちべつ>する。"
msgstr "  Aoko took another glance at the undulating iron fences."

#. Occurrence 5B_10:1507:5666: scene=5B_10
#: 5B_10:1507
msgctxt "text_id=5666 | speaker=unknown"
msgid "　既に『生きて脱出する』という目標は達成できない。"
msgstr "  It was too late to achieve their goal of making it out alive."

#. Occurrence 5B_10:1512:5667: scene=5B_10
#: 5B_10:1512
msgctxt "text_id=5667 | speaker=unknown"
msgid "　である以上、残ったもう一つの約束を優先しようと、彼女は心を切り替えていた。"
msgstr "  In that case, she decided to prioritize the other promise she had made."

#. Occurrence 5B_10:1541:5668: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0008; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1541
msgctxt "text_id=5668 | speaker=aoko"
msgid "「今からこの鉄柵を壊すから、貴方はそこから外に出て。"
msgstr "\"I'm gonna go ahead and break down the fences here. You have to escape once you see an opening."

#. Occurrence 5B_10:1547:5669: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0009; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1547
msgctxt "text_id=5669 | speaker=aoko"
msgid "　それで、私の役割はおしまいよ」"
msgstr "  Then my job will be done.\""

#. Occurrence 5B_10:1600:5670: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0006; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1600
msgctxt "text_id=5670 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5B_10:1606:5671: scene=5B_10
#: 5B_10:1606
msgctxt "text_id=5671 | speaker=unknown"
msgid "　言葉は少なかったが、淡々とした声がすべてを物語っている。"
msgstr "  Though her words were few, her tone told the whole story."

#. Occurrence 5B_10:1611:5672: scene=5B_10
#: 5B_10:1611
msgctxt "text_id=5672 | speaker=unknown"
msgid "　彼女は彼に、ひとりで逃げろと言ったのだ。"
msgstr "  She was telling him to escape by himself."

#. Occurrence 5B_10:1683:5673: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0007; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1683
msgctxt "text_id=5673 | speaker=soujuurou"
msgid "「……信じられない。"
msgstr "\"It's not possible."

#. Occurrence 5B_10:1689:5674: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0008; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1689
msgctxt "text_id=5674 | speaker=soujuurou"
msgid "　こんなの、蒼崎だけじゃ壊せないだろう」"
msgstr "  You can't destroy them by yourself, Aozaki.\""

#. Occurrence 5B_10:1702:5675: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0010; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1702
msgctxt "text_id=5675 | speaker=aoko"
msgid "「私だけならね。でも、今はこの遊園地が味方してる。燃料がこれだけあるんだから、私は銃身になるだけでいいんだし。一発でかいのお見舞いしてやるわ。"
msgstr "\"If I were by myself, you'd be right. But right now, the park is actually helping me. With this much fuel, all I need to do is aim and pull the trigger. One good blast should be enough."

#. Occurrence 5B_10:1708:5676: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0011; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:1708
msgctxt "text_id=5676 | speaker=aoko"
msgid "　……ま、それでも一回が限度だから、穴をあけたら、アンタには全力で走り抜けてもらうしかないけど」"
msgstr "  That said, I'll only be able to do it once, so as soon as I open a hole, I need you to run like your life depends on it.\""

#. Occurrence 5B_10:1728:5677: scene=5B_10
#: 5B_10:1728
msgctxt "text_id=5677 | speaker=unknown"
msgid "　この鉄柵の海に道を作る。"
msgstr "  She would carve a path through this iron sea of fences,"

#. Occurrence 5B_10:1733:5678: scene=5B_10
#: 5B_10:1733
msgctxt "text_id=5678 | speaker=unknown"
msgid "　それは彼女の持てる力を総動員しての、一度きりの大詠唱、大射程の極限魔弾。"
msgstr "  gambling on one final effort: a great incantation to launch the biggest projectile she could manage."

#. Occurrence 5B_10:1801:5679: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0009; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:1801
msgctxt "text_id=5679 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5B_10:1807:5680: scene=5B_10
#: 5B_10:1807
msgctxt "text_id=5680 | speaker=unknown"
msgid "　門外漢である草十郎には、それがどれほどの負担をかけるものか想像もできない。ただ漠然と、遊園地に取り残される青子の姿が思い浮かぶ。"
msgstr "  As an outsider, Soujyuro could not even begin to imagine just how much of a burden this would be for her. All he could imagine was a hazy vision of Aoko being left behind in this park."

#. Occurrence 5B_10:1866:5681: scene=5B_10
#: 5B_10:1866
msgctxt "text_id=5681 | speaker=unknown"
msgid "　……残された彼女はどうなるのか。"
msgstr "  What would happen to her?"

#. Occurrence 5B_10:1871:5682: scene=5B_10
#: 5B_10:1871
msgctxt "text_id=5682 | speaker=unknown"
msgid "　あの黒衣の少女は彼女を助けるのか。"
msgstr "  Would that girl in black come to save her?"

#. Occurrence 5B_10:1937:5683: scene=5B_10
#: 5B_10:1937
msgctxt "text_id=5683 | speaker=unknown"
msgid "　無慈悲な話だが、それはない。"
msgstr "  Cruel as it was to imagine, he knew she would not."

#. Occurrence 5B_10:1942:5684: scene=5B_10
#: 5B_10:1942
msgctxt "text_id=5684 | speaker=unknown"
msgid "　青子が草十郎を助けるために最善を尽くした以上、あの少女も手を<緩|ゆる>めはしないだろう。"
msgstr "  After Aoko had exhausted her very best in order to save him, that girl would not stay her hand."

#. Occurrence 5B_10:2014:5685: scene=5B_10
#: 5B_10:2014
msgctxt "text_id=5685 | speaker=unknown"
msgid "　有珠が青子を見逃すとしたら、それは青子が自分の<命|いのち>惜しさに草十郎を殺した時だけだ。"
msgstr "  The only way Alice would let Aoko off the hook was if Aoko killed Soujyuro as payment."

#. Occurrence 5B_10:2019:5686: scene=5B_10
#: 5B_10:2019
msgctxt "text_id=5686 | speaker=unknown"
msgid "　そして、"
msgstr "  And so..."

#. Occurrence 5B_10:2091:5687: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0012; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:2091
msgctxt "text_id=5687 | speaker=aoko"
msgid "「二十メートルぐらい離れてて。"
msgstr "\"Get back about fifty feet."

#. Occurrence 5B_10:2098:5688: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0013; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:2098
msgctxt "text_id=5688 | speaker=aoko"
msgid "<詠唱|じゅんび>に手間どるけど、その卵の表面がゆで上がるまでには終わらせるから」"
msgstr "It'll take time to cast, but I'll make sure to finish this before that egg gets hardboiled.\""

#. Occurrence 5B_10:2104:5689: scene=5B_10
#: 5B_10:2104
msgctxt "text_id=5689 | speaker=unknown"
msgid "　言うまでもなく、彼女はその道を選ばない。"
msgstr "  It went without saying that this was the only path."

#. Occurrence 5B_10:2180:5690: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0010; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2180
msgctxt "text_id=5690 | speaker=soujuurou"
msgid "「待ってくれ。"
msgstr "\"Wait. I want to know."

#. Occurrence 5B_10:2180:5691: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0010; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2180
msgctxt "text_id=5691 | speaker=soujuurou"
msgid "　俺を逃がすっていうけど、それに意味はあるのか、蒼崎」"
msgstr "  Is there even a point in letting me go?\""

#. Occurrence 5B_10:2261:5692: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0014; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:2261
msgctxt "text_id=5692 | speaker=aoko"
msgid "「……ないけど。外に出られたところで有珠から逃げきれるとは思えないし。"
msgstr "\"None. Even once you get out, there's no way you'll be able to escape Alice forever."

#. Occurrence 5B_10:2268:5693: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0015; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:2268
msgctxt "text_id=5693 | speaker=aoko"
msgid "けど、これぐらいは最後の意地よ。守るって言ったんだから、できるところまでやらないと」"
msgstr "But I'm stubborn to the very end. I said I'd protect you, so I'm damn well going to do my best to keep you alive.\""

#. Occurrence 5B_10:2343:5694: scene=5B_10
#: 5B_10:2343
msgctxt "text_id=5694 | speaker=unknown"
msgid "　その芯の強さを、彼は驚きながら再認識した。"
msgstr "  Surprised by her seemingly moral stance, Soujyuro saw Aoko in a new light."

#. Occurrence 5B_10:2348:5695: scene=5B_10
#: 5B_10:2348
msgctxt "text_id=5695 | speaker=unknown"
msgid "　……つまりはそういうこと。"
msgstr "  ...Ah. But of course."

#. Occurrence 5B_10:2353:5696: scene=5B_10
#: 5B_10:2353
msgctxt "text_id=5696 | speaker=unknown"
msgid "　彼女は草十郎のためではなく、自分の誇りのために戦っている。"
msgstr "  Soujyuro realized that she was not fighting for his sake, but for the sake of her pride."

#. Occurrence 5B_10:2435:5697: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0011; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2435
msgctxt "text_id=5697 | speaker=soujuurou"
msgid "「……うん、そうだったな。"
msgstr "\"...Right. I guess you did say that."

#. Occurrence 5B_10:2441:5698: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0012; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2441
msgctxt "text_id=5698 | speaker=soujuurou"
msgid "　けど、それなら俺だけ逃がすのはらしくないぞ」"
msgstr "  But it's not like you to let me go by myself.\""

#. Occurrence 5B_10:2447:5699: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0016; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:2447
msgctxt "text_id=5699 | speaker=aoko"
msgid "「な、なによ。いいから離れてて」"
msgstr "\"Oh, give me a break! Just move already!\""

#. Occurrence 5B_10:2453:5700: scene=5B_10
#: 5B_10:2453
msgctxt "text_id=5700 | speaker=unknown"
msgid "　なんとなく、ちょっとだけ後退する青子。"
msgstr "  Aoko eased off, just a bit."

#. Occurrence 5B_10:2520:5701: scene=5B_10
#: 5B_10:2520
msgctxt "text_id=5701 | speaker=unknown"
msgid "　つい一時間ほど前、この顔に一本とられた事を思い出したのだ。"
msgstr "  She recalled how, an hour ago, he had gotten the better of her."

#. Occurrence 5B_10:2591:5702: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0013; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2591
msgctxt "text_id=5702 | speaker=soujuurou"
msgid "「蒼崎。まだ意地を張れるんなら、他の事をやろう。"
msgstr "\"Aozaki. If you're still willing to fight, then let's do it some other way."

#. Occurrence 5B_10:2642:5703: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0014; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2642
msgctxt "text_id=5703 | speaker=soujuurou"
msgid "　このお化けみたいな鉄柵を壊せるなら、他に壊すべきものがあるはずだ」"
msgstr "  If you can destroy that monster of a fence, then let's put your power to better use.\""

#. Occurrence 5B_10:2722:5704: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0017; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:2722
msgctxt "text_id=5704 | speaker=aoko"
msgid "「ないわよ。悪いけど、私は目に見えるものしか壊せないの。最後までカタチのない希望にすがるとか、考えるのも寒気がする。"
msgstr "\"There isn't anything else I can do! Sorry, but all I can do is destroy what I can see. Dying for some forlorn hope isn't how I want to go out."

#. Occurrence 5B_10:2737:5705: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0018; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:2737
msgctxt "text_id=5705 | speaker=aoko"
msgid "いい？　今はフラットスナークなんかより、この壁を壊してアンタを<足抜|あしぬ>けさせるのが私の現実。私に負える最大限の責任って―――」"
msgstr "Don't you get it? The fact is, blowing this thing up to let you slip out is all I can manage. I can't beat Flat Snark, or anything else. It's the least I can do after―\""

#. Occurrence 5B_10:2765:5706: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0015; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2765
msgctxt "text_id=5706 | speaker=soujuurou"
msgid "「逃げるのか」"
msgstr "\"So you're going to run from this responsibility, too?\""

#. Occurrence 5B_10:2770:5707: scene=5B_10
#: 5B_10:2770
msgctxt "text_id=5707 | speaker=unknown"
msgid "　背中を向けようとした青子の手が掴まれる。"
msgstr "  Aoko was just about to turn her back on him when Soujyuro clutched her hand."

#. Occurrence 5B_10:2845:5708: scene=5B_10
#: 5B_10:2845
msgctxt "text_id=5708 | speaker=unknown"
msgid "　その一言が少女の心を<沸騰|ふっとう>させた。"
msgstr "  His words caused something inside of her to boil with rage."

#. Occurrence 5B_10:2850:5709: scene=5B_10
#: 5B_10:2850
msgctxt "text_id=5709 | speaker=unknown"
msgid "　本当に、心臓に火を放たれたようだ。"
msgstr "  It was as though someone had set her heart on fire."

#. Occurrence 5B_10:2855:5710: scene=5B_10
#: 5B_10:2855
msgctxt "text_id=5710 | speaker=unknown"
msgid "　本心を突かれた驚きと、自分自身への不甲斐なさが、凍っていた手足を蘇らせる。"
msgstr "  The surprise that pricked open her true feelings and the disappointment she felt toward herself thawed her frozen limbs."

#. Occurrence 5B_10:2889:5711: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0019; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:2889
msgctxt "text_id=5711 | speaker=aoko"
msgid "「誰が―――！　逃げるのはそっちで、逃がしてあげるのはこっちだって言うのよ！　甘く見ないで、いざとなったら遊園地ごと爆破してみせるわ！」"
msgstr "\"Why you...! Don't get it backward! I'M the one letting YOU escape, not the other way around! I'll blow the whole damn park if I feel like it, just you watch!\""

#. Occurrence 5B_10:2958:5712: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0016; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2958
msgctxt "text_id=5712 | speaker=soujuurou"
msgid "「そうか。なら、ここで俺を逃がすのは無駄だな。"
msgstr "\"Okay. In that case, it'd be a waste to help me escape right now."

#. Occurrence 5B_10:2965:5713: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0017; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:2965
msgctxt "text_id=5713 | speaker=soujuurou"
msgid "その気迫は本命のためにとっておこう。それまでは俺も手伝うから」"
msgstr "Save that move for when you really mean it. I'll give you a hand until then.\""

#. Occurrence 5B_10:3053:5714: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0020; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3053
msgctxt "text_id=5714 | speaker=aoko"
msgid "「はあ!?　手伝う!?　それこそ無駄な気遣いよ！"
msgstr "\"Huh?! YOU help ME?! Talk about a waste of time!"

#. Occurrence 5B_10:3059:5715: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0021; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3059
msgctxt "text_id=5715 | speaker=aoko"
msgid "　あったまきた、いいから逃げろバカ！　だいたい、走りづめで息もたえだえなヤツなんか使えないわよ！」"
msgstr "  Now you're really pissing me off. Just get out of here, you dimwit! What use do I have for a dunce whose special power is running himself ragged?!\""

#. Occurrence 5B_10:3065:5716: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0018; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:3065
msgctxt "text_id=5716 | speaker=soujuurou"
msgid "「そりゃいいかげんヘトヘトだけど。"
msgstr "\"I may be pretty exhausted,"

#. Occurrence 5B_10:3072:5717: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0019; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:3072
msgctxt "text_id=5717 | speaker=soujuurou"
msgid "そういう蒼崎なんか、疲れ以上に傷の方が痛んでるだろ」"
msgstr " but you're in worse shape, Aozaki. Just look at yourself. You're tired and injured.\""

#. Occurrence 5B_10:3155:5718: scene=5B_10
#: 5B_10:3155
msgctxt "text_id=5718 | speaker=unknown"
msgid "　青子本人ですら忘れかけていた背中の痛み。"
msgstr "  Not to mention the injury to her back that Aoko had nearly forgotten about."

#. Occurrence 5B_10:3160:5719: scene=5B_10
#: 5B_10:3160
msgctxt "text_id=5719 | speaker=unknown"
msgid "　自動人形に強打された彼女の背中は、今では無視できないほどの痛みを<訴|うった>えていた。"
msgstr "  Even now, she couldn't ignore the pain that the automaton had inflicted on her spine."

#. Occurrence 5B_10:3165:5720: scene=5B_10
#: 5B_10:3165
msgctxt "text_id=5720 | speaker=unknown"
msgid "　青子は単に、鉄の自制心で背中の傷を後回しにしていただけなのだ。"
msgstr "  With iron will, she'd managed to push it out of her mind. Mostly."

#. Occurrence 5B_10:3186:5721: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0020; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:3186
msgctxt "text_id=5721 | speaker=soujuurou"
msgid "「ほら。魔術とか抜きにすれば、まだ俺の方がマシじゃないか。入り口までおぶっていくコトぐらいなら、なんとか」"
msgstr "\"Even without any of that magecraft stuff, I'm still in better shape than you are. I could probably even carry you all the way to the entrance if I needed to.\""

#. Occurrence 5B_10:3217:5722: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0022; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3217
msgctxt "text_id=5722 | speaker=aoko"
msgid "「できないコトは口にしないで。"
msgstr "\"Don't make promises you can't keep."

#. Occurrence 5B_10:3223:5723: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0023; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3223
msgctxt "text_id=5723 | speaker=aoko"
msgid "　……もう、いいから行って。慣れているもの、私は。でも貴方は違う。こういうの初めてでしょ？"
msgstr "  Just... go. I'm used to this, and you're not. This is your first time facing this sort of thing, right?"

#. Occurrence 5B_10:3229:5724: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0024; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3229
msgctxt "text_id=5724 | speaker=aoko"
msgid "　だから、いいの」"
msgstr "  So, it's okay.\""

#. Occurrence 5B_10:3324:5725: scene=5B_10
#: 5B_10:3324
msgctxt "text_id=5725 | speaker=unknown"
msgid "　こうして協力されるのも、"
msgstr "  The fact that they were a team..."

#. Occurrence 5B_10:3329:5726: scene=5B_10
#: 5B_10:3329
msgctxt "text_id=5726 | speaker=unknown"
msgid "　結局はそのあと少年を殺さなければいけない事も、"
msgstr "  The fact that she would still have to kill him after all of this..."

#. Occurrence 5B_10:3334:5727: scene=5B_10
#: 5B_10:3334
msgctxt "text_id=5727 | speaker=unknown"
msgid "　全部ひっくるめて彼女は言った。"
msgstr "  None of the irony was lost on her as she said these words."

#. Occurrence 5B_10:3340:5728: scene=5B_10
#: 5B_10:3340
msgctxt "text_id=5728 | speaker=unknown"
msgid "　もういいの、と。"
msgstr "  It didn't matter anymore."

#. Occurrence 5B_10:3385:5729: scene=5B_10
#: 5B_10:3385
msgctxt "text_id=5729 | speaker=unknown"
msgid "　けれど、草十郎は手を離さなかった。"
msgstr "  Still, Soujyuro didn't let go of her hand;"

#. Occurrence 5B_10:3390:5730: scene=5B_10
#: 5B_10:3390
msgctxt "text_id=5730 | speaker=unknown"
msgid "　掴んだ手の力は一段と増している。"
msgstr "  he gripped it even harder."

#. Occurrence 5B_10:3395:5731: scene=5B_10
#: 5B_10:3395
msgctxt "text_id=5731 | speaker=unknown"
msgid "　<表情|かお>はいつものままだけど、もしかして怒っているのかな、と青子は眉を<曇|くも>らせた。"
msgstr "  His expression was the same as ever. Aoko frowned, trying to figure out if he was upset with her."

#. Occurrence 5B_10:3449:5732: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0021; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:3449
msgctxt "text_id=5732 | speaker=soujuurou"
msgid "「たしかに、こういうのは初めてだ。"
msgstr "\"You're right. This is my first time with this sort of thing."

#. Occurrence 5B_10:3455:5733: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0022; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:3455
msgctxt "text_id=5733 | speaker=soujuurou"
msgid "　けど、山じゃ危険な目ぐらいあってる。<鹿|シカ>に襲われた事だってあるんだぞ、俺は」"
msgstr "  But I've experienced my own fair share of danger in the mountains. I've even been attacked by a deer, you know.\""

#. Occurrence 5B_10:3522:5734: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0025; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3522
msgctxt "text_id=5734 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5B_10:3542:5735: scene=5B_10
#: 5B_10:3542
msgctxt "text_id=5735 | speaker=unknown"
msgid "　少女は都会の人間で、シカ、なんて単語を出されてもいまいち実感は湧かなかったけれど、少年には確かな覚悟があると感じ取れた。"
msgstr "  As a city girl, she had no idea what it meant to be attacked by a deer, but his determination was apparent enough."

#. Occurrence 5B_10:3569:5736: scene=5B_10
#: 5B_10:3569
msgctxt "text_id=5736 | speaker=unknown"
msgid "　……たしかに。"
msgstr "  True..."

#. Occurrence 5B_10:3574:5737: scene=5B_10
#: 5B_10:3574
msgctxt "text_id=5737 | speaker=unknown"
msgid "　振り返れば、彼は努めて冷静だった。"
msgstr "  Looking back on it now, he had maintained his composure through it all."

#. Occurrence 5B_10:3579:5738: scene=5B_10
#: 5B_10:3579
msgctxt "text_id=5738 | speaker=unknown"
msgid "　普通ならパニック状態で会話する事さえ困難だろう。"
msgstr "  A normal person would barely be able to talk through such panic."

#. Occurrence 5B_10:3584:5739: scene=5B_10
#: 5B_10:3584
msgctxt "text_id=5739 | speaker=unknown"
msgid "　それをここまで、なんとか冷静でいようと努力できるのは、文明から離れた山奥で暮らしていたからなのか。"
msgstr "  Perhaps growing up deep in the mountains, far from civilization, had taught him how to stay calm in the face of so much."

#. Occurrence 5B_10:3666:5740: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0023; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:3666
msgctxt "text_id=5740 | speaker=soujuurou"
msgid "「だから信じてくれ。少しでいいから」"
msgstr "\"So trust me. Just a little.\""

#. Occurrence 5B_10:3672:5741: scene=5B_10
#: 5B_10:3672
msgctxt "text_id=5741 | speaker=unknown"
msgid "　飾り気のない本心。"
msgstr "  He spoke his plain, unadulterated feelings,"

#. Occurrence 5B_10:3677:5742: scene=5B_10
#: 5B_10:3677
msgctxt "text_id=5742 | speaker=unknown"
msgid "　簡潔な気持ちを口にして、草十郎は手を離した。"
msgstr "  and released his hand."

#. Occurrence 5B_10:3682:5743: scene=5B_10
#: 5B_10:3682
msgctxt "text_id=5743 | speaker=unknown"
msgid "　……少年の言葉に嘘はない。"
msgstr "  There was no lie in him."

#. Occurrence 5B_10:3687:5744: scene=5B_10
#: 5B_10:3687
msgctxt "text_id=5744 | speaker=unknown"
msgid "　それが余計、少女には信じられなかった。"
msgstr "  In fact, he was too honest; so much that she found it hard to believe him."

#. Occurrence 5B_10:3772:5745: scene=5B_10
#: 5B_10:3772
msgctxt "text_id=5745 | speaker=unknown"
msgid "　だって、草十郎にはそこまでの事をする理由がない。"
msgstr "  Soujyuro had no reason to go that far."

#. Occurrence 5B_10:3777:5746: scene=5B_10
#: 5B_10:3777
msgctxt "text_id=5746 | speaker=unknown"
msgid "　今の青子にはあらゆる未来がない。"
msgstr "  As it stood, Aoko had no future."

#. Occurrence 5B_10:3782:5747: scene=5B_10
#: 5B_10:3782
msgctxt "text_id=5747 | speaker=unknown"
msgid "　それを白状して逃げろと言っているのに、どうしてこの少年は、こんな自分に協力すると言うのだろう―――"
msgstr "  After confessing this and telling him to escape, why did this boy still offer to help a person like her?"

#. Occurrence 5B_10:3811:5748: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0026; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3811
msgctxt "text_id=5748 | speaker=aoko"
msgid "「分からない。どうしてそこまでするの。"
msgstr "\"I don't understand. Why do all this?"

#. Occurrence 5B_10:3817:5749: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0027; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3817
msgctxt "text_id=5749 | speaker=aoko"
msgid "　私に付き合えば貴方は死ぬのよ。"
msgstr "  You're going to die if you stay with me."

#. Occurrence 5B_10:3824:5750: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0028; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:3824
msgctxt "text_id=5750 | speaker=aoko"
msgid "これが最後だから、ちゃんと考えてよね。……貴方はここで逃げるべきよ」"
msgstr "This is it. This is your last chance. Think it through. You should be running.\""

#. Occurrence 5B_10:3901:5751: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0024; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:3901
msgctxt "text_id=5751 | speaker=soujuurou"
msgid "「それは分かるよ。でも行かない」"
msgstr "\"I know, but I'm not going anywhere.\""

#. Occurrence 5B_10:3906:5752: scene=5B_10
#: 5B_10:3906
msgctxt "text_id=5752 | speaker=unknown"
msgid "　即答しながら、青子はその理由をこそ求めている、と草十郎は気が付いた。"
msgstr "  Soujyuro answered immediately, realizing that Aoko was looking for his reason."

#. Occurrence 5B_10:3911:5753: scene=5B_10
#: 5B_10:3911
msgctxt "text_id=5753 | speaker=unknown"
msgid "　普段の彼からすればまさに<喝采|かっさい>ものの察しの良さで、"
msgstr "  This level of insight in Soujyuro demanded a round of applause."

#. Occurrence 5B_10:3926:5754: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0025; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:3926
msgctxt "text_id=5754 | speaker=soujuurou"
msgid "「そうすると、蒼崎が死んでしまいそうだ」"
msgstr "\"If I do, you'll die, Aozaki.\""

#. Occurrence 5B_10:3931:5755: scene=5B_10
#: 5B_10:3931
msgctxt "text_id=5755 | speaker=unknown"
msgid "　でた言葉は、いつも通りの理由の無さ。"
msgstr "  His words were as irrational as always."

#. Occurrence 5B_10:4016:5756: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0029; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:4016
msgctxt "text_id=5756 | speaker=aoko"
msgid "「だから、どうしてそこまでするのよアンタはっ！」"
msgstr "\"But why!? Why do it? Why go so far for me!?\""

#. Occurrence 5B_10:4021:5757: scene=5B_10
#: 5B_10:4021
msgctxt "text_id=5757 | speaker=unknown"
msgid "　苛立ちから怒鳴り付ける。"
msgstr "  She was yelling out of frustration."

#. Occurrence 5B_10:4026:5758: scene=5B_10
#: 5B_10:4026
msgctxt "text_id=5758 | speaker=unknown"
msgid "　少年は少しだけ考えこんでから、"
msgstr "  After thinking for a moment, Soujyuro replied."

#. Occurrence 5B_10:4033:5759: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0026; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:4033
msgctxt "text_id=5759 | speaker=soujuurou"
msgid "「―――そりゃあ、君が好きだからだろ」"
msgstr "\"I guess it's because... I like you.\""

#. Occurrence 5B_10:4047:5760: scene=5B_10
#: 5B_10:4047
msgctxt "text_id=5760 | speaker=unknown"
msgid "　あっさりと。"
msgstr "  Simple and to the point."

#. Occurrence 5B_10:4052:5761: scene=5B_10
#: 5B_10:4052
msgctxt "text_id=5761 | speaker=unknown"
msgid "　なんでそんなこと訊くんだ？　なんて顔で返答した。"
msgstr "  His face seemed to ask why she would even question him so."

#. Occurrence 5B_10:4142:5762: scene=5B_10
#: 5B_10:4142
msgctxt "text_id=5762 | speaker=unknown"
msgid "　……一秒か、たぶん二秒ほど。"
msgstr "  There was a pause, no more than two seconds."

#. Occurrence 5B_10:4147:5763: scene=5B_10
#: 5B_10:4147
msgctxt "text_id=5763 | speaker=unknown"
msgid "　あまりの不意打ちに、青子の時間は止まってしまった。"
msgstr "  His surprise attack had stopped Aoko in her tracks."

#. Occurrence 5B_10:4152:5764: scene=5B_10
#: 5B_10:4152
msgctxt "text_id=5764 | speaker=unknown"
msgid "　切り札を隠していたのは有珠だけではなかったようだ。"
msgstr "  Alice was not the only one who had an ace up her sleeve."

#. Occurrence 5B_10:4157:5765: scene=5B_10
#: 5B_10:4157
msgctxt "text_id=5765 | speaker=unknown"
msgid "　今の一言は、フラットスナークなんかより底が深い。"
msgstr "  That line reached deeper even than Flat Snark could ever hope to."

#. Occurrence 5B_10:4177:5766: scene=5B_10
#: 5B_10:4177
msgctxt "text_id=5766 | speaker=unknown"
msgid "　青子にとってはただただ呆れるばかりの返答。"
msgstr "  All Aoko could respond with was an expression of pure shock."

#. Occurrence 5B_10:4182:5767: scene=5B_10
#: 5B_10:4182
msgctxt "text_id=5767 | speaker=unknown"
msgid "　けれど単純で頑強な、地上でいちばん強い理由。"
msgstr "  It was a simple, stubborn reason. The strongest kind on Earth."

#. Occurrence 5B_10:4215:5768: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0030; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:4215
msgctxt "text_id=5768 | speaker=aoko"
msgid "「―――はあ」"
msgstr "\"...Ugh.\""

#. Occurrence 5B_10:4280:5769: scene=5B_10
#: 5B_10:4280
msgctxt "text_id=5769 | speaker=unknown"
msgid "　自分を殺そうとしている相手に無条件で協力出来るなんて、静希草十郎はやっぱり分からない。"
msgstr "  Soujyuro Sizuki was indeed incomprehensible, to be able to work unconditionally with someone who was trying to kill him."

#. Occurrence 5B_10:4285:5770: scene=5B_10
#: 5B_10:4285
msgctxt "text_id=5770 | speaker=unknown"
msgid "　ただ少しだけ、青子はこの少年の<為人|ひととなり>が掴めた気がした。"
msgstr "  But she felt as though she'd finally grasped a sliver of his true nature."

#. Occurrence 5B_10:4291:5771: scene=5B_10
#: 5B_10:4291
msgctxt "text_id=5771 | speaker=unknown"
msgid "　鳶丸たちの評価は、たぶん、間違ってはいないのだ。"
msgstr "  Tobimaru and the others' assessment of him was correct..."

msgctxt "text_id=5772 | speaker=unknown"
msgid "口惜しいことに。"
msgstr " as vexing as it was to her to admit."

#. Occurrence 5B_10:4378:5773: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0031; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:4378
msgctxt "text_id=5773 | speaker=aoko"
msgid "「莫迦ね。私は貴方のこと、嫌いなのに」"
msgstr "\"Even though I can't stand you... You sure are a dip, you know.\""

#. Occurrence 5B_10:4438:5774: scene=5B_10
#: 5B_10:4438
msgctxt "text_id=5774 | speaker=unknown"
msgid "　なんだか負け惜しみのような呟きに、少年は知ってるよ、と苦笑した。"
msgstr "  He laughed at her sour grumbling. At this point, he was used to her insults."

#. Occurrence 5B_10:4519:5775: scene=5B_10
#: 5B_10:4519
msgctxt "text_id=5775 | speaker=unknown"
msgid "　意地の張り合いはここで終わり。"
msgstr "  Their clash of wills ended here."

#. Occurrence 5B_10:4524:5776: scene=5B_10
#: 5B_10:4524
msgctxt "text_id=5776 | speaker=unknown"
msgid "　火を放たれた心臓が、青子の体に熱い血液を走らせる。"
msgstr "  Aoko's blood ran hot from her blazing heart."

#. Occurrence 5B_10:4529:5777: scene=5B_10
#: 5B_10:4529
msgctxt "text_id=5777 | speaker=unknown"
msgid "　だってあんな顔をされたら、ふたりそろって生還する方法しか考えられない。"
msgstr "  If he was going to make a face like that, all she could do was try to think of a way to get them both home."

#. Occurrence 5B_10:4605:5778: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0032; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:4605
msgctxt "text_id=5778 | speaker=aoko"
msgid "「……ま、私だって逃げっぱなしは性に合わないし。"
msgstr "\"Running away isn't really my thing, anyway."

#. Occurrence 5B_10:4611:5779: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0033; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:4611
msgctxt "text_id=5779 | speaker=aoko"
msgid "　いいわよ、最後まで粘ってみる。それに静希君が付き合ってくれるなら、何かの役には立つでしょう」"
msgstr "  Fine. I'll stick it out to the end. And if you're going to stay with me, Sizuki, I'm sure we can find some way for you to help.\""

#. Occurrence 5B_10:4637:5780: scene=5B_10
#: 5B_10:4637
msgctxt "text_id=5780 | speaker=unknown"
msgid "　軽口を叩きながらも、青子の眼にはまだ迷いがあった。"
msgstr "  Though her tone had lightened, there was still hesitation in her eyes."

#. Occurrence 5B_10:4642:5781: scene=5B_10
#: 5B_10:4642
msgctxt "text_id=5781 | speaker=unknown"
msgid "　当然だ。戦うも何も、青子にはスナークの正体、その糸口すら掴めていない。"
msgstr "  It was only natural. Aoko had not even a clue as to how to begin to fight the Snark."

#. Occurrence 5B_10:4647:5782: scene=5B_10
#: 5B_10:4647
msgctxt "text_id=5782 | speaker=unknown"
msgid "　自分がもう少し器用で、もう少しだけ修練を積んでいたのなら、あるいはスナークを探る手段もあっただろうに。"
msgstr "  If only she had been just a bit more skilled, or had trained just a bit more, there might have been some way to look for it."

#. Occurrence 5B_10:4803:5783: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0034; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:4803
msgctxt "text_id=5783 | speaker=aoko"
msgid "「……我ながら情けない。せめて、正体を暴く手がかりでもあればいいんだけど」"
msgstr "\"I'm better than this. If only I had a way to peel back its true form.\""

#. Occurrence 5B_10:4809:5784: scene=5B_10
#: 5B_10:4809
msgctxt "text_id=5784 | speaker=unknown"
msgid "　知らず、不安をこぼす。"
msgstr "  Unconsciously, she let her apprehension show."

#. Occurrence 5B_10:4814:5785: scene=5B_10
#: 5B_10:4814
msgctxt "text_id=5785 | speaker=unknown"
msgid "　こんな弱音、口にしても仕方がない。"
msgstr "  Sniveling was pointless."

#. Occurrence 5B_10:4819:5786: scene=5B_10
#: 5B_10:4819
msgctxt "text_id=5786 | speaker=unknown"
msgid "　その問題は自分が解決するしかない、と青子は自らを<鼓|こ><舞|ぶ>しようとして、"
msgstr "  She would just have to figure it out by herself, but―"

#. Occurrence 5B_10:4937:5787: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0027; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:4937
msgctxt "text_id=5787 | speaker=soujuurou"
msgid "「ん？　なんだ、正体さえ分かればいいのか？」"
msgstr "\"Hmm? What, that's all we need to figure out?\""

#. Occurrence 5B_10:4951:5788: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0035; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:4951
msgctxt "text_id=5788 | speaker=aoko"
msgid "「へ？」"
msgstr "\"Huh?\""

#. Occurrence 5B_10:4956:5789: scene=5B_10
#: 5B_10:4956
msgctxt "text_id=5789 | speaker=unknown"
msgid "　なにそれどういうイミ？　なんて顔をする青子と、"
msgstr "  Aoko gave him a look, as if to ask what *that* was supposed to mean."

#. Occurrence 5B_10:4970:5790: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0028; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:4970
msgctxt "text_id=5790 | speaker=soujuurou"
msgid "「いや、だからおかしなモノはどれかってコトだろ？」"
msgstr "\"I mean, you asked me earlier to look for something weird, right?\""

#. Occurrence 5B_10:4975:5791: scene=5B_10
#: 5B_10:4975
msgctxt "text_id=5791 | speaker=unknown"
msgid "　言ってくれれば良かったのに、なんて顔をする草十郎。"
msgstr "  Soujyuro also made a face that suggested she should have brought it up sooner."

#. Occurrence 5B_10:5072:5792: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0036; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:5072
msgctxt "text_id=5792 | speaker=aoko"
msgid "「ちょっ―――分かるの、アンタ!?」"
msgstr "\"Wait, you know what it is?!\""

#. Occurrence 5B_10:5078:5793: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_10_0029; voice_prefix=A30; voice_category=3; scene=5B_10
#: 5B_10:5078
msgctxt "text_id=5793 | speaker=soujuurou"
msgid "「たぶん。いや、けっこう前から気になっていたんだけど」"
msgstr "\"I think so. Well, I've been wondering about it for a while, actually.\""

#. Occurrence 5B_10:5099:5794: scene=5B_10
#: 5B_10:5099
msgctxt "text_id=5794 | speaker=unknown"
msgid "　草十郎は誰かに聞かれないよう、こっそりと青子に耳打ちをする。"
msgstr "  Soujyuro whispered in her ear quietly, so as not to be overheard."

#. Occurrence 5B_10:5171:5795: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_10_0037; voice_prefix=A10; voice_category=1; scene=5B_10
#: 5B_10:5171
msgctxt "text_id=5795 | speaker=aoko"
msgid "「――――――あ」"
msgstr "\"...Ah.\""

#. Occurrence 5B_10:5183:5796: scene=5B_10
#: 5B_10:5183
msgctxt "text_id=5796 | speaker=unknown"
msgid "　意外と言えば意外、"
msgstr "  It was certainly unexpected,"

#. Occurrence 5B_10:5188:5797: scene=5B_10
#: 5B_10:5188
msgctxt "text_id=5797 | speaker=unknown"
msgid "　当然と言えば当然の“間違い”を教えられて、青子はその“答え”が正しい事を直感した。"
msgstr "  but then again, equally obvious. After he explained the mistake, she knew right away that he was correct."

#. Occurrence 5B_10:5194:5798: scene=5B_10
#: 5B_10:5194
msgctxt "text_id=5798 | speaker=unknown"
msgid "　敵の正体。フラットスナークの本体とは、つまり―――"
msgstr "  At last, she had an inkling of Flat Snark's original form. Namely..."

#. Occurrence 5B_11:401:5799: scene=5B_11
#: 5B_11:401
msgctxt "text_id=5799 | speaker=unknown"
msgid "　密談は十分で終わった。"
msgstr "  They strategized for ten minutes."

#. Occurrence 5B_11:406:5800: scene=5B_11
#: 5B_11:406
msgctxt "text_id=5800 | speaker=unknown"
msgid "　スナーク本体の考察と、その撃破方法を導きだして、ふたりは互いの役割に頷きあう。"
msgstr "  After deliberating the Snark's true form and figuring out a plan of attack, the two exchanged nods in acceptance of their roles."

#. Occurrence 5B_11:438:5801: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_11_0000; voice_prefix=A10; voice_category=1; scene=5B_11
#: 5B_11:438
msgctxt "text_id=5801 | speaker=aoko"
msgid "「それじゃ、ここからは別行動ね。"
msgstr "\"We'll be splitting up now."

#. Occurrence 5B_11:444:5802: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_11_0001; voice_prefix=A10; voice_category=1; scene=5B_11
#: 5B_11:444
msgctxt "text_id=5802 | speaker=aoko"
msgid "　でもミラーハウスの時みたいなのは勘弁してよ。この作戦の<肝|きも>は貴方なんだから。開始一分でドジったら、ホントに打つ手なしだからね」"
msgstr "  Just don't make it a repeat of the blunder in the house of mirrors. You're the crux of this operation. If you bungle the start even a little, there's no coming back from this one.\""

#. Occurrence 5B_11:523:5803: scene=5B_11
#: 5B_11:523
msgctxt "text_id=5803 | speaker=unknown"
msgid "　ミラーハウスでの囮役失敗の件をチクチクとつつく青子だが、その声は明るい。"
msgstr "  Though she jabbed him for his previous failure as a decoy, her voice was bright."

#. Occurrence 5B_11:528:5804: scene=5B_11
#: 5B_11:528
msgctxt "text_id=5804 | speaker=unknown"
msgid "　草十郎の発見からこっち、彼女本来の力強さが戻っている。"
msgstr "  Aoko's original vigor had returned to her at Soujyuro's discovery of the truth."

#. Occurrence 5B_11:599:5805: scene=5B_11
#: 5B_11:599
msgctxt "text_id=5805 | speaker=unknown"
msgid "　一方、草十郎も彼なりに真剣だ。"
msgstr "  Meanwhile, Soujyuro was also getting serious in his own way."

#. Occurrence 5B_11:604:5806: scene=5B_11
#: 5B_11:604
msgctxt "text_id=5806 | speaker=unknown"
msgid "　青子の注意を真面目に受けとめている。"
msgstr "  He took Aoko's warning to heart."

#. Occurrence 5B_11:690:5807: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_11_0002; voice_prefix=A10; voice_category=1; scene=5B_11
#: 5B_11:690
msgctxt "text_id=5807 | speaker=aoko"
msgid "「……ならいいけど。いい、さっきと立場は反対よ。"
msgstr "\"Good. But remember that our positions are reversed this time."

#. Occurrence 5B_11:696:5808: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_11_0003; voice_prefix=A10; voice_category=1; scene=5B_11
#: 5B_11:696
msgctxt "text_id=5808 | speaker=aoko"
msgid "　失敗したら死ぬのは私じゃなくてそっち。もうフォローに回れないから、できるだけ慎重にね」"
msgstr "  If we fail, I'm not the one who's going to die―you are. I won't be there to clean up your mess, so watch your step.\""

#. Occurrence 5B_11:768:5809: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_11_0000; voice_prefix=A30; voice_category=3; scene=5B_11
#: 5B_11:768
msgctxt "text_id=5809 | speaker=soujuurou"
msgid "「分かってる。いまさらながら、やっぱりさっき逃がしてもらえば良かったと思うぐらい、慎重だ」"
msgstr "\"I know. After all this, I regret what not taking your advice earlier. I'll be careful.\""

#. Occurrence 5B_11:774:5810: scene=5B_11
#: 5B_11:774
msgctxt "text_id=5810 | speaker=unknown"
msgid "　任せてくれ、と頷く草十郎。恨み言のような台詞だが、彼なりに決意を表しているらしい。"
msgstr "  Soujyuro nodded, telling her to leave it to him. Though he made it sound like he was holding a grudge, it seemed to him to be the only way of showing her his resolve."

#. Occurrence 5B_11:779:5811: scene=5B_11
#: 5B_11:779
msgctxt "text_id=5811 | speaker=unknown"
msgid "　ちぐはぐで分かりづらい草十郎の仕草に、青子はまったく、と降参するようなため息ひとつ。"
msgstr "  Aoko let out a sigh of defeat. Once more, she couldn't figure him out."

#. Occurrence 5B_11:853:5812: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_11_0004; voice_prefix=A10; voice_category=1; scene=5B_11
#: 5B_11:853
msgctxt "text_id=5812 | speaker=aoko"
msgid "「ほんと、大バカなんだか大物なんだか。"
msgstr "\"Seriously, I can't tell if you're a big idiot or a big hero."

#. Occurrence 5B_11:865:5813: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_11_0005; voice_prefix=A10; voice_category=1; scene=5B_11
#: 5B_11:865
msgctxt "text_id=5813 | speaker=aoko"
msgid "　―――でも任せた。期待してるわ、静希君」"
msgstr "  Whichever one it is, I'm counting on you. Don't let me down.\""

#. Occurrence 5B_11:924:5814: scene=5B_11
#: 5B_11:924
msgctxt "text_id=5814 | speaker=unknown"
msgid "　信じている、と返してやりたかったが、さすがにそれは気恥ずかしかったらしい。"
msgstr "  She had wanted to say that she believed in him, but apparently, that was too embarrassing for her."

#. Occurrence 5B_11:1009:5815: scene=5B_11
#: 5B_11:1009
msgctxt "text_id=5815 | speaker=unknown"
msgid "　青子は草十郎に背を向けて走り出す。"
msgstr "  Aoko turned away from Soujyuro and began to run."

#. Occurrence 5B_11:1014:5816: scene=5B_11
#: 5B_11:1014
msgctxt "text_id=5816 | speaker=unknown"
msgid "　まあ、こういう風にペースを崩されるのも、たまにはいいかもしれない、なんて思いながら。"
msgstr "  She had begun to think that maybe this change of pace was not so bad after all."

#. Occurrence 5B_11:1065:5817: scene=5B_11
#: 5B_11:1065
msgctxt "text_id=5817 | speaker=unknown"
msgid "　―――休憩は終わりを告げた。"
msgstr "  And so ended the intermission."

#. Occurrence 5B_11:1070:5818: scene=5B_11
#: 5B_11:1070
msgctxt "text_id=5818 | speaker=unknown"
msgid "　未熟な役者に新たな脚本が手渡される。"
msgstr "  The young cast members were handed their new lines."

#. Occurrence 5B_11:1076:5819: scene=5B_11
#: 5B_11:1076
msgctxt "text_id=5819 | speaker=unknown"
msgid "　さて、結果はどうあれ。"
msgstr "  Whatever happened next,"

#. Occurrence 5B_11:1081:5820: scene=5B_11
#: 5B_11:1081
msgctxt "text_id=5820 | speaker=unknown"
msgid "　長かった魔法使いの夜は、最後の幕に入ったらしい。"
msgstr "  the night of witches had, at long last, entered its climax."

#. Occurrence 5B_12:87:5821: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0000; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:87
msgctxt "text_id=5821 | speaker=alice"
msgid "「―――別行動？　あの二人が？」"
msgstr "\"...They split up? You're sure?\""

#. Occurrence 5B_12:105:5822: scene=5B_12
#: 5B_12:105
msgctxt "text_id=5822 | speaker=unknown"
msgid "　駒鳥からの報告に、少女は不吉な響きを感じとった。"
msgstr "  She was filled with foreboding at the robin's report."

#. Occurrence 5B_12:110:5823: scene=5B_12
#: 5B_12:110
msgctxt "text_id=5823 | speaker=unknown"
msgid "　彼らはそれぞれ反対方向に移動したらしい。"
msgstr "  Apparently, they had gone in opposite directions."

#. Occurrence 5B_12:115:5824: scene=5B_12
#: 5B_12:115
msgctxt "text_id=5824 | speaker=unknown"
msgid "　遊園地の住人たちは目撃者の少年を追いかけ、あと数分で捕まえ、処理するという。"
msgstr "  The park's residents had set off after the boy witness, and it would take them mere minutes to capture him, so the bird said."

#. Occurrence 5B_12:191:5825: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0001; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:191
msgctxt "text_id=5825 | speaker=alice"
msgid "「……どういう事？　追いかけているのは本当に彼？　青子が変装しているのではなく？」"
msgstr "\"What do you mean? Is it actually him they're following? Not Aoko in disguise?\""

#. Occurrence 5B_12:198:5826: scene=5B_12
#: 5B_12:198
msgctxt "text_id=5826 | speaker=unknown"
msgid "　駒鳥は羽をすくめて主人の疑いを鳴きとばす。"
msgstr "  The robin flapped its wings, chirping away any doubt."

#. Occurrence 5B_12:203:5827: scene=5B_12
#: 5B_12:203
msgctxt "text_id=5827 | speaker=unknown"
msgid "　自分の目に間違いはない、広場方面に向かっているのは青子で、コースター方面に逃げているのはとっぽい小僧だと。"
msgstr "  It had seen them with its own two eyes. Aoko was heading for the plaza, while the cocky brat was making a run for the roller coaster."

#. Occurrence 5B_12:270:5828: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0002; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:270
msgctxt "text_id=5828 | speaker=alice"
msgid "「青子が彼を見捨てた、ですって？"
msgstr "\"Are you saying that Aoko abandoned him?"

#. Occurrence 5B_12:306:5829: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0003_0; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:306
msgctxt "text_id=5829 | speaker=alice"
msgid "　……そんな簡単な事ならいいけど。"
msgstr "  ...It sounds a little too good to be true."

#. Occurrence 5B_12:318:5830: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0003_1; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:318
msgctxt "text_id=5830 | speaker=alice"
msgid "ダンプティは彼に張り付いているの？」"
msgstr " Is Dumpty still on his tail?\""

#. Occurrence 5B_12:324:5831: scene=5B_12
#: 5B_12:324
msgctxt "text_id=5831 | speaker=unknown"
msgid "　駒鳥は自信満々に頷く。"
msgstr "  The robin nodded enthusiastically."

#. Occurrence 5B_12:329:5832: scene=5B_12
#: 5B_12:329
msgctxt "text_id=5832 | speaker=unknown"
msgid "　他の鳥はともかく、夜目の利く自分ならここからでもあのカモネギっぽい坊主を見て取れる。なにしろ相手は<高|・><い|・><と|・><こ|・><ろ|・><に|・><登|・><っ|・><て|・><い|・><る|・>し。"
msgstr "  It didn't know about the other birds, but with its superior night vision, it had seen that sucker clearly because he had moved to a high point."

#. Occurrence 5B_12:420:5833: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0004; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:420
msgctxt "text_id=5833 | speaker=alice"
msgid "「ダンプティはなんて？"
msgstr "\"And Dumpty?"

#. Occurrence 5B_12:447:5834: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0005; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:447
msgctxt "text_id=5834 | speaker=alice"
msgid "　……最後まで<吟|うた>わせろ、こんな<褒|ほ>め殺したい<間|ま><抜|ぬ>けはまたとない、ですって？」"
msgstr "  He said to let him sing to the very end? That he may never get the chance again to do so for a fool this asinine?\""

#. Occurrence 5B_12:512:5835: scene=5B_12
#: 5B_12:512
msgctxt "text_id=5835 | speaker=unknown"
msgid "　スクラッチダンプティは、捕捉した対象が目を離した途端に落下し、破裂する時限爆弾だ。"
msgstr "  Scratch Dumpty was a ticking time bomb that would drop and detonate the moment its target averted its gaze."

#. Occurrence 5B_12:517:5836: scene=5B_12
#: 5B_12:517
msgctxt "text_id=5836 | speaker=unknown"
msgid "　対象がきちんと監視していれば落下しない、ある意味紳士的な“<童話の怪物|プロイキッシャー>”。だが乱戦時においてこれほどの嫌がらせもないだろう。"
msgstr "  That is, as long as his target continued to observe him. In a way, he was a gentlemanly Ploy Kickshaw, though Alice wished he would forgo such niceties when in battle."

#. Occurrence 5B_12:554:5837: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0006; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:554
msgctxt "text_id=5837 | speaker=alice"
msgid "「……そうね。視線を切らないだけではダンプティからは逃げられない。表面の詩が完成すれば扉が開く。"
msgstr "\"...Let him have his fun. Keeping an eye on Dumpty won't save the boy anyway. Once the poem on his surface is complete, the door will open."

#. Occurrence 5B_12:560:5838: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0007; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:560
msgctxt "text_id=5838 | speaker=alice"
msgid "　彼がどこまで逃げようと、あと少しでダンプティが仕舞ってくれるわ」"
msgstr "  No matter how far he runs, Dumpty will end him for us.\""

#. Occurrence 5B_12:605:5839: scene=5B_12
#: 5B_12:605
msgctxt "text_id=5839 | speaker=unknown"
msgid "　何処に行こうと、この遊園地―――いや、スナークが破壊されない以上、少年は逃げられない。"
msgstr "  Until the park, or rather the Snark, was destroyed, Soujyuro would not be able to escape."

#. Occurrence 5B_12:610:5840: scene=5B_12
#: 5B_12:610
msgctxt "text_id=5840 | speaker=unknown"
msgid "　なら気になるのは青子の方だ。"
msgstr "  Which meant the larger concern was Aoko."

#. Occurrence 5B_12:615:5841: scene=5B_12
#: 5B_12:615
msgctxt "text_id=5841 | speaker=unknown"
msgid "　あの少年を守ると言い切った彼女は、いま何処に向かっているのか。"
msgstr "  Aoko had promised to protect the boy, which begged the question: where was she running to?"

#. Occurrence 5B_12:687:5842: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0008; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:687
msgctxt "text_id=5842 | speaker=alice"
msgid "「……ここにいるかぎり、青子の動向は掴めない」"
msgstr "\"As long as we stay here, we can't track Aoko.\""

#. Occurrence 5B_12:762:5843: scene=5B_12
#: 5B_12:762
msgctxt "text_id=5843 | speaker=unknown"
msgid "　羽を広げて存在をアピールする駒鳥を無視して、少女は遊園地を見渡した。"
msgstr "  Alice looked out over the park, ignoring the robin's attempt to get her attention with its plumage."

#. Occurrence 5B_12:836:5844: scene=5B_12
#: 5B_12:836
msgctxt "text_id=5844 | speaker=unknown"
msgid "　フラットスナークはもうじき育ちきる。"
msgstr "  Flat Snark had nearly reached its full size."

#. Occurrence 5B_12:841:5845: scene=5B_12
#: 5B_12:841
msgctxt "text_id=5845 | speaker=unknown"
msgid "　他の安価なプロイとは根本からして違う怪物。"
msgstr "  It was a different breed of beast compared to the other cheap Ploys."

#. Occurrence 5B_12:846:5846: scene=5B_12
#: 5B_12:846
msgctxt "text_id=5846 | speaker=unknown"
msgid "　少女にとって代えのきかない、貴重な三体の使い魔のうち一体。"
msgstr "  To her, it was one of her three most irreplaceable and precious familiars."

#. Occurrence 5B_12:932:5847: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0009; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:932
msgctxt "text_id=5847 | speaker=alice"
msgid "「……そうね。任せたわスナーク。"
msgstr "\"...Yes. She's all yours, Snark."

#. Occurrence 5B_12:932:5848: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0009; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:932
msgctxt "text_id=5848 | speaker=alice"
msgid "　青子が<諦|あきら>めない以上、貴方も手は抜かないで」"
msgstr "  Don't hold back until Aoko is brought to her knees.\""

#. Occurrence 5B_12:938:5849: scene=5B_12
#: 5B_12:938
msgctxt "text_id=5849 | speaker=unknown"
msgid "　少女は動かない。"
msgstr "  Alice remained where she was."

#. Occurrence 5B_12:943:5850: scene=5B_12
#: 5B_12:943
msgctxt "text_id=5850 | speaker=unknown"
msgid "　橋の巨人、毒爪トカゲと同じ<歴|か><史|ち>を持つ、<至高|しこう>のプロイ、フラットスナーク。"
msgstr "  With the same historical merit as the troll under the bridge and the poison-clawed reptile, Flat Snark was one of Alice's ultimate Ploys."

#. Occurrence 5B_12:948:5851: scene=5B_12
#: 5B_12:948
msgctxt "text_id=5851 | speaker=unknown"
msgid "　その名と能力を、ここは信頼する事にした。"
msgstr "  She was placing her trust in its reputation and ability."

#. Occurrence 5B_12:998:5852: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0010; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:998
msgctxt "text_id=5852 | speaker=alice"
msgid "「でも忘れないで。これはゲームよ。"
msgstr "\"But don't forget. This is a game."

#. Occurrence 5B_12:1004:5853: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_12_0011; voice_prefix=A40; voice_category=2; scene=5B_12
#: 5B_12:1004
msgctxt "text_id=5853 | speaker=alice"
msgid "　勝敗がついたのなら、わたしのところに帰ってきて」"
msgstr "  When the contest is over, return to me.\""

#. Occurrence 5B_12:1068:5854: scene=5B_12
#: 5B_12:1068
msgctxt "text_id=5854 | speaker=unknown"
msgid "“―――――――――”"
msgstr "\"...\""

#. Occurrence 5B_12:1074:5855: scene=5B_12
#: 5B_12:1074
msgctxt "text_id=5855 | speaker=unknown"
msgid "　主の言葉を、<漂|ただよ>う霧は聞き流す。"
msgstr "  The drifting fog ignored its master's words."

#. Occurrence 5B_12:1079:5856: scene=5B_12
#: 5B_12:1079
msgctxt "text_id=5856 | speaker=unknown"
msgid "　……有珠もそこだけは読み違えていた。"
msgstr "  It was the one thing that Alice had misread."

#. Occurrence 5B_12:1085:5857: scene=5B_12
#: 5B_12:1085
msgctxt "text_id=5857 | speaker=unknown"
msgid "フラットスナークはプロイの中でも<最悪|さいあく><低俗|ていぞく>な道化の王さま。"
msgstr "Flat Snark was a king, even among the other Ploys, of terrible, vulgar antics."

#. Occurrence 5B_12:1090:5858: scene=5B_12
#: 5B_12:1090
msgctxt "text_id=5858 | speaker=unknown"
msgid "　敗者には死を。惨たらしい悲劇を。"
msgstr "  Death to the defeated. Gruesome tragedy to the vanquished."

#. Occurrence 5B_12:1096:5859: scene=5B_12
#: 5B_12:1096
msgctxt "text_id=5859 | speaker=unknown"
msgid "財布も命も取りこぼす、素晴らしい破産じゃないと愉しめない。"
msgstr "It found no pleasure unless it brought about dramatic ruination of life and wealth."

#. Occurrence 5B_12:1116:5860: scene=5B_12
#: 5B_12:1116
msgctxt "text_id=5860 | speaker=unknown"
msgid "“―――――――――”"
msgstr "\"―――――――――\""

#. Occurrence 5B_12:1122:5861: scene=5B_12
#: 5B_12:1122
msgctxt "text_id=5861 | speaker=unknown"
msgid "　<邪|よこしま>な笑みのように霧が煙る。"
msgstr "  The fog billowed like wicked laughter."

#. Occurrence 5B_12:1127:5862: scene=5B_12
#: 5B_12:1127
msgctxt "text_id=5862 | speaker=unknown"
msgid "　そう。負かした相手をどう扱うかなんて、それこそ王さまの特権で、スナークは自分の欲望を止められない。"
msgstr "  After all, only a king had the right to decide the fate of the vanquished, and the Snark's greed could not be contained."

#. Occurrence 5B_12:1132:5863: scene=5B_12
#: 5B_12:1132
msgctxt "text_id=5863 | speaker=unknown"
msgid "　なので―――"
msgstr "  Thus..."

#. Occurrence 5B_12:1138:5864: scene=5B_12
#: 5B_12:1138
msgctxt "text_id=5864 | speaker=unknown"
msgid "　たとえ主人の言いつけであろうと、行儀の良いフェアプレーなんて、これっぽっちも、守る気はなかったのだ。"
msgstr "  It hadn't even the slightest intent to play fair, despite its master's orders."

#. Occurrence 5B_13:119:5865: scene=5B_13
#: 5B_13:119
msgctxt "text_id=5865 | speaker=unknown"
msgid "　地上四十メートルの高み。"
msgstr "  Over one hundred feet high."

#. Occurrence 5B_13:124:5866: scene=5B_13
#: 5B_13:124
msgctxt "text_id=5866 | speaker=unknown"
msgid "　遊園地の中心へ向かって延びる<骨組み|レール>の上を、慎重に慎重に、足場を確認しながら登っていく人影が一つ。"
msgstr "  One careful step at a time, the figure made its way gingerly up the track which stretched into the heart of the amusement park."

#. Occurrence 5B_13:145:5867: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0000; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:145
msgctxt "text_id=5867 | speaker=soujuurou"
msgid "「―――、―――」"
msgstr "\"―, ―\""

#. Occurrence 5B_13:151:5868: scene=5B_13
#: 5B_13:151
msgctxt "text_id=5868 | speaker=unknown"
msgid "　押さえつけているのは動悸と呼吸だ。"
msgstr "  He stayed his beating chest and the pounding of his breath."

#. Occurrence 5B_13:156:5869: scene=5B_13
#: 5B_13:156
msgctxt "text_id=5869 | speaker=unknown"
msgid "　今はそんな、わずかな動作すら前進の邪魔になる。"
msgstr "  Even tiny movements were an obstacle to his progress."

#. Occurrence 5B_13:253:5870: scene=5B_13
#: 5B_13:253
msgctxt "text_id=5870 | speaker=unknown"
msgid "　顔面蒼白でより高い位置を目指しているのは、あろう事か静希草十郎である。"
msgstr "  Amazingly, the one making this pale-faced advance higher and higher was Soujyuro Sizuki."

#. Occurrence 5B_13:258:5871: scene=5B_13
#: 5B_13:258
msgctxt "text_id=5871 | speaker=unknown"
msgid "　遥か地上を見下ろせば、コースター乗り場には焼きたてパンたちの群れ。"
msgstr "  Far below, he saw that a horde of bread creatures had congregated by the roller coaster platform."

#. Occurrence 5B_13:263:5872: scene=5B_13
#: 5B_13:263
msgctxt "text_id=5872 | speaker=unknown"
msgid "　入り口で右往左往している彼らは刻一刻と数を増やしながら、レールを登っていく草十郎へ<諸手|もろて>を挙げての応援中。"
msgstr "  As they bustled this way and that, their numbers continued to increase by the minute, seemingly cheering on Soujyuro with raised arms as he made his ascent."

#. Occurrence 5B_13:268:5873: scene=5B_13
#: 5B_13:268
msgctxt "text_id=5873 | speaker=unknown"
msgid "　もとい、下りてこいとブーイングをあげている。"
msgstr "  Or rather, they jeered as if beckoning him to come down."

#. Occurrence 5B_13:289:5874: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0001; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:289
msgctxt "text_id=5874 | speaker=soujuurou"
msgid "「……助かった。アレ、高いところは苦手なんだ」"
msgstr "\"...Well, at least they don't like heights.\""

#. Occurrence 5B_13:329:5875: scene=5B_13
#: 5B_13:329
msgctxt "text_id=5875 | speaker=unknown"
msgid "　もちろん草十郎も苦手だが、彼らに包囲されないのなら、これはこれで少しだけマシである。"
msgstr "  Of course, neither did Soujyuro, but his current state was the lesser of two evils."

#. Occurrence 5B_13:400:5876: scene=5B_13
#: 5B_13:400
msgctxt "text_id=5876 | speaker=unknown"
msgid "　追ってきているのは浮遊する卵だけ。"
msgstr "  The only thing that followed him now was the floating egg."

#. Occurrence 5B_13:405:5877: scene=5B_13
#: 5B_13:405
msgctxt "text_id=5877 | speaker=unknown"
msgid "　草十郎は大きく息をついた後、やや前屈みになって、天に向かって延びるコースターを登っていく。"
msgstr "  After heaving a huge sigh, Soujyuro bent forward a bit and climbed the track that inclined toward the heavens."

#. Occurrence 5B_13:410:5878: scene=5B_13
#: 5B_13:410
msgctxt "text_id=5878 | speaker=unknown"
msgid "　これで地上四十八メートル。"
msgstr "  One hundred and fifty feet now."

#. Occurrence 5B_13:415:5879: scene=5B_13
#: 5B_13:415
msgctxt "text_id=5879 | speaker=unknown"
msgid "　ビルで言うなら十六階の高さに相当する。"
msgstr "  If this were a skyscraper, he would be on the sixteenth floor."

#. Occurrence 5B_13:459:5880: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0002; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:459
msgctxt "text_id=5880 | speaker=soujuurou"
msgid "「っ、―――……！」"
msgstr "\"...!\""

#. Occurrence 5B_13:513:5881: scene=5B_13
#: 5B_13:513
msgctxt "text_id=5881 | speaker=unknown"
msgid "　強風が髪をさらう。"
msgstr "  A strong gust of wind whipped through his hair."

#. Occurrence 5B_13:518:5882: scene=5B_13
#: 5B_13:518
msgctxt "text_id=5882 | speaker=unknown"
msgid "　人間は根本的に高所を恐れる生き物だ。"
msgstr "  Humans had an instinctual fear of heights."

#. Occurrence 5B_13:523:5883: scene=5B_13
#: 5B_13:523
msgctxt "text_id=5883 | speaker=unknown"
msgid "　ことに、このように落下のイメージを想起させる場所では、本人にその気がなくとも膝が震える。"
msgstr "  In particular, a place like this, which called forth visions of falling to one's death, would cause a person's knees to tremble against their will."

#. Occurrence 5B_13:528:5884: scene=5B_13
#: 5B_13:528
msgctxt "text_id=5884 | speaker=unknown"
msgid "　死を<警戒|けいかい>する本能が、安全な地上への<回帰|かいき>を<促|うなが>している。"
msgstr "  It was an instinct that forewarned death, urging its master to return to the safety of the ground."

#. Occurrence 5B_13:548:5885: scene=5B_13
#: 5B_13:548
msgctxt "text_id=5885 | speaker=unknown"
msgid "　それも無理からぬ事。"
msgstr "  It was a reasonable reaction."

#. Occurrence 5B_13:553:5886: scene=5B_13
#: 5B_13:553
msgctxt "text_id=5886 | speaker=unknown"
msgid "　ジェットコースターのレールを人力で登ろうなどと、笑い話を通り越してファンタジーの領域なのだから。"
msgstr "  Climbing the roller coaster tracks went beyond funny stories and into the realm of fantasy."

#. Occurrence 5B_13:562:5887: scene=5B_13
#: 5B_13:562
msgctxt "text_id=5887 | speaker=unknown"
msgid "　気圧や強風による妨害。"
msgstr "  The strong winds and change in air pressure were a hindrance."

#. Occurrence 5B_13:567:5888: scene=5B_13
#: 5B_13:567
msgctxt "text_id=5888 | speaker=unknown"
msgid "　本能からの中止勧告、痺れる手足、筋力の衰え、とりとめなく暴走する思考。"
msgstr "  His instincts screamed at him to stop, causing his limbs to go numb, his muscles to go limp, and his mind to race."

#. Occurrence 5B_13:573:5889: scene=5B_13
#: 5B_13:573
msgctxt "text_id=5889 | speaker=unknown"
msgid "仮に命綱をしていようと、五メートルも登れば思考は恐怖で固まってしまう。"
msgstr "Even if he had been tied to a lifeline, a mere fifteen feet of climbing would still have caused his thoughts to freeze out of sheer terror."

#. Occurrence 5B_13:593:5890: scene=5B_13
#: 5B_13:593
msgctxt "text_id=5890 | speaker=unknown"
msgid "　加えて、この苦しみは倍々ゲームだ。"
msgstr "  And it would only get worse from here, exponentially so."

#. Occurrence 5B_13:598:5891: scene=5B_13
#: 5B_13:598
msgctxt "text_id=5891 | speaker=unknown"
msgid "　一メートル進めば、それだけ肉体と精神にかかる負担はいや増していく。"
msgstr "  Every foot forward increased the load on both his mind and his body by another degree."

#. Occurrence 5B_13:667:5892: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0003; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:667
msgctxt "text_id=5892 | speaker=soujuurou"
msgid "「―――よし。頂上まであと少し―――」"
msgstr "\"...I can do this. Just a little bit more to the top...\""

#. Occurrence 5B_13:673:5893: scene=5B_13
#: 5B_13:673
msgctxt "text_id=5893 | speaker=unknown"
msgid "　そんな精神の負担はともかく、体の調子を注意深く<測|はか>りながら草十郎は前進する。"
msgstr "  The burden on his mind notwithstanding, he carefully measured the toll on his body with every step."

#. Occurrence 5B_13:678:5894: scene=5B_13
#: 5B_13:678
msgctxt "text_id=5894 | speaker=unknown"
msgid "　走りづめだった足は、気を抜いたとたん、膝から崩れかねない。"
msgstr "  His legs, which had carried him running this far, threatened to buckle the moment he let down his guard."

#. Occurrence 5B_13:684:5895: scene=5B_13
#: 5B_13:684
msgctxt "text_id=5895 | speaker=unknown"
msgid "青子が“草十郎の方が危ない”と念を押したのも、疲労しきった体では危険すぎるからだろう。"
msgstr "This fatigue was likely why Aoko had stressed that Soujyuro's role was more dangerous than hers."

#. Occurrence 5B_13:721:5896: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0004; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:721
msgctxt "text_id=5896 | speaker=soujuurou"
msgid "「……待てよ。逆を言うと、疲れてなければなんとかなると思ってたんだよな、蒼崎は」"
msgstr "\"Wait. Would Aozaki have been so worried if I wasn't tired?\""

#. Occurrence 5B_13:775:5897: scene=5B_13
#: 5B_13:775
msgctxt "text_id=5897 | speaker=unknown"
msgid "　ふわふわ浮遊する卵を眺めながら、草十郎は思い出し笑いをする。"
msgstr "  Soujyuro laughed as he stared at the floating egg."

#. Occurrence 5B_13:780:5898: scene=5B_13
#: 5B_13:780
msgctxt "text_id=5898 | speaker=unknown"
msgid "　こんな無茶をする事になった<顛末|てんまつ>。"
msgstr "  He reflected on the course of events that had led to this absurd situation."

#. Occurrence 5B_13:785:5899: scene=5B_13
#: 5B_13:785
msgctxt "text_id=5899 | speaker=unknown"
msgid "　ほんの十分前、ふたりはこんな会話を交わしていた。"
msgstr "  Not even ten minutes ago, they had been engaged in conversation."

#. Occurrence 5B_13:836:5900: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0000; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:836
msgctxt "text_id=5900 | speaker=aoko"
msgid "「じゃあ次ね。正体が分かった以上、あとはどう壊すかを話しあいましょう」"
msgstr "\"Okay. Since we know what form it's taken, we need to talk about how we're going to destroy it.\""

#. Occurrence 5B_13:936:5901: scene=5B_13
#: 5B_13:936
msgctxt "text_id=5901 | speaker=unknown"
msgid "　にんまりと笑う青子に、ぞぞっと背筋が寒くなる草十郎。"
msgstr "  Soujyuro felt a shudder travel down his spine at Aoko's smug grin."

#. Occurrence 5B_13:941:5902: scene=5B_13
#: 5B_13:941
msgctxt "text_id=5902 | speaker=unknown"
msgid "　……思えば、この時から青子は草十郎に無茶をさせる気満々だったのだ。"
msgstr "  In hindsight, Aoko had been more than happy at this point to make him do something absurd."

#. Occurrence 5B_13:1013:5903: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0005; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:1013
msgctxt "text_id=5903 | speaker=soujuurou"
msgid "「どう壊すかって、それなら」"
msgstr "\"How we're going to destroy it? Can't you just...\""

#. Occurrence 5B_13:1019:5904: scene=5B_13
#: 5B_13:1019
msgctxt "text_id=5904 | speaker=unknown"
msgid "　この鉄柵を外まで壊せる魔術があるのなら考えるまでもないのでは、と手を挙げる草十郎。"
msgstr "  Soujyuro wondered aloud; from what he'd seen, Aoko had enough firepower to tear clean through the fence."

#. Occurrence 5B_13:1024:5905: scene=5B_13
#: 5B_13:1024
msgctxt "text_id=5905 | speaker=unknown"
msgid "　彼がこれまでフラットスナークの本体について意見しなかったのは、ひとえに『分かっていてもどうしようもない』と思っていたからだ。"
msgstr "  He'd refrained from speculating about Flat Snark's true form because he'd felt there was nothing they could do about it, even if they knew."

#. Occurrence 5B_13:1044:5906: scene=5B_13
#: 5B_13:1044
msgctxt "text_id=5906 | speaker=unknown"
msgid "　が、今は条件が違う。"
msgstr "  But that had changed."

#. Occurrence 5B_13:1049:5907: scene=5B_13
#: 5B_13:1049
msgctxt "text_id=5907 | speaker=unknown"
msgid "　青子なら文字通り、不可能に手が届く。"
msgstr "  For Aoko, the impossible was quite literally within her grasp."

#. Occurrence 5B_13:1122:5908: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0001; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1122
msgctxt "text_id=5908 | speaker=aoko"
msgid "「そうでもないわ。私の目算だと、あと五十メートル分、ギリギリで届かない」"
msgstr "\"It won't be that easy. By my estimate, I wouldn't get within a hundred and fifty feet of the thing.\""

#. Occurrence 5B_13:1136:5909: scene=5B_13
#: 5B_13:1136
msgctxt "text_id=5909 | speaker=unknown"
msgid "　だめじゃないか、と目で<訴|うった>える草十郎。"
msgstr "  Despair filled Soujyuro's eyes."

#. Occurrence 5B_13:1209:5910: scene=5B_13
#: 5B_13:1209
msgctxt "text_id=5910 | speaker=unknown"
msgid "　青子は自分の長髪に手をやると、魔力をこめた指で、<一房|ひとふさ>スパッと切った。"
msgstr "  Aoko lifted a hand to her long hair and, with a magically charged fingertip, clipped a clean tuft of it."

#. Occurrence 5B_13:1290:5911: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0002; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1290
msgctxt "text_id=5911 | speaker=aoko"
msgid "「足りない分は努力と根性ってね。"
msgstr "\"But we can make up the difference with some elbow grease."

#. Occurrence 5B_13:1296:5912: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0003; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1296
msgctxt "text_id=5912 | speaker=aoko"
msgid "　貴方はできるだけ高いところまで逃げて。頃合いを見て合図をだすから、そうしたらこれを空に放ってくれる？　静希君の役目はそれだけでいいから」"
msgstr "  Get to the highest place you can. When the time is right, I'll give you a sign. Just toss this into the air. That's all you need to do.\""

#. Occurrence 5B_13:1323:5913: scene=5B_13
#: 5B_13:1323
msgctxt "text_id=5913 | speaker=unknown"
msgid "　そう言う青子の視線は、とても“できるだけ”なんて言ってはいなかった。"
msgstr "  But based on where Aoko pointed her gaze, she did not really mean to leave it up to Soujyuro to pick the highest place he could find."

#. Occurrence 5B_13:1328:5914: scene=5B_13
#: 5B_13:1328
msgctxt "text_id=5914 | speaker=unknown"
msgid "　彼女はこれみよがしに、遊園地二大アトラクションの一つ、ジェットコースターを見つめている。"
msgstr "  She was staring conspicuously at one of the amusement park's two main attractions: the roller coaster."

#. Occurrence 5B_13:1349:5915: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0006; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:1349
msgctxt "text_id=5915 | speaker=soujuurou"
msgid "「…………。つまり、蒼崎とは別行動をとって、あの怪物たちに追われながら、高いところに逃げこめと？」"
msgstr "\"...So, in other words, you're saying we split up, then you want me to run away from the monsters chasing me and escape to somewhere high, right?\""

#. Occurrence 5B_13:1370:5916: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0004; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1370
msgctxt "text_id=5916 | speaker=aoko"
msgid "「そういうコト。ほら、あのうねうね動き出してるコースターのレールとか、よくない？」"
msgstr "\"Exactly. And hey, wouldn't you know it, the tracks of that winding roller coaster are perfect!\""

#. Occurrence 5B_13:1390:5917: scene=5B_13
#: 5B_13:1390
msgctxt "text_id=5917 | speaker=unknown"
msgid "　遊園地に悪魔は二匹いる。"
msgstr "  There were two demons in this park."

#. Occurrence 5B_13:1395:5918: scene=5B_13
#: 5B_13:1395
msgctxt "text_id=5918 | speaker=unknown"
msgid "　草十郎ですら「よくない」と即答したくなる笑顔だった。"
msgstr "  Her smile made even Soujyuro want to respond that it was far from perfect."

#. Occurrence 5B_13:1468:5919: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0007; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:1468
msgctxt "text_id=5919 | speaker=soujuurou"
msgid "「……疑いたくはないんだが。"
msgstr "\"Far be for me to question your motives here, but..."

#. Occurrence 5B_13:1474:5920: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0008; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:1474
msgctxt "text_id=5920 | speaker=soujuurou"
msgid "　ホントはあの子とグルで、俺を遠回しに殺そうとしてるんじゃないか？」"
msgstr "  You're not secretly working with that girl to kill me, are you?\""

#. Occurrence 5B_13:1487:5921: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0005; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1487
msgctxt "text_id=5921 | speaker=aoko"
msgid "「あら。私に殺されるのならいいんでしょう？」"
msgstr "\"Now now. Wasn't it you who said it was okay if I was the one who killed you?\""

#. Occurrence 5B_13:1565:5922: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0009; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:1565
msgctxt "text_id=5922 | speaker=soujuurou"
msgid "「……人の失言を悪用するのは、よくないと思う」"
msgstr "\"...It's not nice to twist other people's words.\""

#. Occurrence 5B_13:1593:5923: scene=5B_13
#: 5B_13:1593
msgctxt "text_id=5923 | speaker=unknown"
msgid "　とても正気じゃない、とうなだれる草十郎。"
msgstr "  Soujyuro hung his head. This was not sane."

#. Occurrence 5B_13:1606:5924: scene=5B_13
#: 5B_13:1606
msgctxt "text_id=5924 | speaker=unknown"
msgid "　青子の言う通りにしていたらキッツィーちゃんに食べられる前に過労死しそうだ。"
msgstr "  If he did as she said, he would die from exhaustion before Kitsy even had a chance to eat him."

#. Occurrence 5B_13:1685:5925: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0006; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1685
msgctxt "text_id=5925 | speaker=aoko"
msgid "「私だって鬼じゃないわ。ほら、こっち向いて。"
msgstr "\"I'm not a monster. Hey, Look at me."

#. Occurrence 5B_13:1691:5926: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0007; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1691
msgctxt "text_id=5926 | speaker=aoko"
msgid "　おまじない、かけてあげる」"
msgstr "  I'll cast a charm on you.\""

#. Occurrence 5B_13:1705:5927: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0010; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:1705
msgctxt "text_id=5927 | speaker=soujuurou"
msgid "「？」"
msgstr "\"...?\""

#. Occurrence 5B_13:1804:5928: scene=5B_13
#: 5B_13:1804
msgctxt "text_id=5928 | speaker=unknown"
msgid "　軽い接触。"
msgstr "  It was the lightest of touches."

#. Occurrence 5B_13:1809:5929: scene=5B_13
#: 5B_13:1809
msgctxt "text_id=5929 | speaker=unknown"
msgid "　息と息、肌と肌が触れ合う距離。"
msgstr "  Close enough for their breath and skin to come in contact."

#. Occurrence 5B_13:1876:5930: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0011; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:1876
msgctxt "text_id=5930 | speaker=soujuurou"
msgid "「―――、あ」"
msgstr "\"...Ao―\""

#. Occurrence 5B_13:1882:5931: scene=5B_13
#: 5B_13:1882
msgctxt "text_id=5931 | speaker=unknown"
msgid "　おざき、と続く声が弱い。"
msgstr "  \"...-zaki,\" he finished with a hushed voice."

#. Occurrence 5B_13:1887:5932: scene=5B_13
#: 5B_13:1887
msgctxt "text_id=5932 | speaker=unknown"
msgid "　それは、一方にとってはごく当たり前の魔術で、"
msgstr "  For one of them, this was a rather mundane magecraft."

#. Occurrence 5B_13:1892:5933: scene=5B_13
#: 5B_13:1892
msgctxt "text_id=5933 | speaker=unknown"
msgid "　一方にとっては頭が真っ白になるほどの、柔らかな不意打ちだった。"
msgstr "  For the other, it was a head-spinning, intimate ambush."

#. Occurrence 5B_13:1955:5934: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0008; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1955
msgctxt "text_id=5934 | speaker=aoko"
msgid "　　『―――空<気のおも|かるく、よわく>り、<胸のふる|うまく、はやく>え。"
msgstr "            \"<The weight of the air, the tremble of one's breast|Be light and frail, nimble and fast.>."

#. Occurrence 5B_13:1961:5935: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0009; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:1961
msgctxt "text_id=5935 | speaker=aoko"
msgid "　　　　　　ひ<かりは先|チクタクチクタク>立つ、<かげは遅|いそげやいそげ>れる。』"
msgstr "                    <Light lags behind while shadows pull ahead.|Tick-tock, tick-tock, there's no time to waste.>\""

#. Occurrence 5B_13:1981:5936: scene=5B_13
#: 5B_13:1981
msgctxt "text_id=5936 | speaker=unknown"
msgid "　通常の声帯では発音できない、何か特殊な重みをもった声が草十郎の鼓膜に響く。"
msgstr "  Words that could not be produced by a normal larynx, carrying a peculiar weight to them, reverberated against his eardrums."

#. Occurrence 5B_13:1986:5937: scene=5B_13
#: 5B_13:1986
msgctxt "text_id=5937 | speaker=unknown"
msgid "　……もし言葉に色が見えたのなら、きっと彼女の名前通りの色だっただろう。"
msgstr "  If words were given colors, these would have been the color of her name: blue."

#. Occurrence 5B_13:1991:5938: scene=5B_13
#: 5B_13:1991
msgctxt "text_id=5938 | speaker=unknown"
msgid "　疲れきっていた体が、熱くなっていた血液が、緩やかに冷やされていく。"
msgstr "  Soujyuro's exhausted body and burning blood gently cooled."

#. Occurrence 5B_13:2034:5939: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0010; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2034
msgctxt "text_id=5939 | speaker=aoko"
msgid "　　『<鳥は空に|と　　ぶ>、<魚は海に|お　よ　ぐ>、<貴方は彼方に|か け ぬ け る>。"
msgstr "        \"<A bird in the sky, a fish in the sea, you in the distance|Fly, swim, run.>."

#. Occurrence 5B_13:2040:5940: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0011; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2040
msgctxt "text_id=5940 | speaker=aoko"
msgid "　　　疑<問も不安も鞄|チクタクチクタク>の底に、旅路<の一歩は|きてきをならせ>曙に。"
msgstr "        <Stuff doubt and anxiety in a sack.|Tick-tock, tick-tock.> <Begin the journey at dawn|Sound the alarm.>."

#. Occurrence 5B_13:2046:5941: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0012; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2046
msgctxt "text_id=5941 | speaker=aoko"
msgid "　　　輝<く星はするりと降|ほしはいつでもきたのそら>ちて、今は<貴方の心の内|どこまでも、いつまでも>に。』"
msgstr "        <A shining star falls,|The star is always in the northern sky,> <into your heart.|no matter where you go.>\""

#. Occurrence 5B_13:2066:5942: scene=5B_13
#: 5B_13:2066
msgctxt "text_id=5942 | speaker=unknown"
msgid "　実際には五秒ほど。"
msgstr "  In reality, it took but a few seconds,"

#. Occurrence 5B_13:2071:5943: scene=5B_13
#: 5B_13:2071
msgctxt "text_id=5943 | speaker=unknown"
msgid "　不意を突かれた彼にとってはもう少しだけ長く感じられた触れ合いは、こうして何の失敗もなく、<名残|なごり>惜しくも完了した。"
msgstr "  but the sudden contact had felt a little longer."

#. Occurrence 5B_13:2135:5944: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0013; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2135
msgctxt "text_id=5944 | speaker=aoko"
msgid "「よし、暗示成功！　成功したはず！　ここまで手応えがあったの初めてだし！"
msgstr "\"Mesmerize successful! ...I think. This is the first time I've actually felt it take!"

#. Occurrence 5B_13:2141:5945: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0014; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2141
msgctxt "text_id=5945 | speaker=aoko"
msgid "　有珠の小言もたまには役に立つじゃない！」"
msgstr "  I guess all those lectures from Alice paid off!\""

#. Occurrence 5B_13:2190:5946: scene=5B_13
#: 5B_13:2190
msgctxt "text_id=5946 | speaker=unknown"
msgid "　はしゃぐ青子と、とにかく現状が掴めない草十郎。"
msgstr "  A very merry Aoko stood aside a very confused Soujyuro."

#. Occurrence 5B_13:2195:5947: scene=5B_13
#: 5B_13:2195
msgctxt "text_id=5947 | speaker=unknown"
msgid "　今のは一体なんだったのかと訊くと、"
msgstr "  After he asked what the heck had occurred, she responded."

#. Occurrence 5B_13:2222:5948: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0015; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2222
msgctxt "text_id=5948 | speaker=aoko"
msgid "「簡単な暗示よ。一時的に恐怖心を消しておいたから、高いところに登っても平気なはず。"
msgstr "\"It's an elementary suggestion. I temporarily erased your sense of fear, so you should be able to climb up there no problem."

#. Occurrence 5B_13:2228:5949: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0016; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2228
msgctxt "text_id=5949 | speaker=aoko"
msgid "　あの手の作業でいちばん足を引っ張るのは動揺でしょ？"
msgstr "  The biggest thing standing in your way is your nerves, right?"

#. Occurrence 5B_13:2240:5950: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0017; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2240
msgctxt "text_id=5950 | speaker=aoko"
msgid "　恐怖も何も感じなければ、地上何メートルだろうと平均台とそう変わらないってワケ」"
msgstr "  If you don't feel fear, then no matter how high you climb, it's no different from walking a balance beam!\""

#. Occurrence 5B_13:2312:5951: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0012; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:2312
msgctxt "text_id=5951 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5B_13:2354:5952: scene=5B_13
#: 5B_13:2354
msgctxt "text_id=5952 | speaker=unknown"
msgid "　なるほど、と手を打つ純朴少年。"
msgstr "  He seemed to get it..."

#. Occurrence 5B_13:2359:5953: scene=5B_13
#: 5B_13:2359
msgctxt "text_id=5953 | speaker=unknown"
msgid "　青子の言っている事は<眉唾|まゆつば>だが、さっきの謎の行為はそういう事か、と納得する草十郎だった。"
msgstr "  It actually all sounded like Greek to Soujyuro, but he accepted it as an explanation for her strange actions."

#. Occurrence 5B_13:2455:5954: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0013; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:2455
msgctxt "text_id=5954 | speaker=soujuurou"
msgid "「……はあ。やっと、着いた」"
msgstr "\"Hah... Finally, I made it.\""

#. Occurrence 5B_13:2461:5955: scene=5B_13
#: 5B_13:2461
msgctxt "text_id=5955 | speaker=unknown"
msgid "　山なりのレールの頂点。"
msgstr "  He'd arrived at the summit of the track."

#. Occurrence 5B_13:2466:5956: scene=5B_13
#: 5B_13:2466
msgctxt "text_id=5956 | speaker=unknown"
msgid "　草十郎は地上六十メートル近い高みに到着し、遊園地を俯瞰する。"
msgstr "  From nearly two hundred feet high, Soujyuro had a bird's-eye view of the entire amusement park."

#. Occurrence 5B_13:2486:5957: scene=5B_13
#: 5B_13:2486
msgctxt "text_id=5957 | speaker=unknown"
msgid "　青子の姿はすぐに発見できた。"
msgstr "  He was able to spot Aoko's figure right away."

#. Occurrence 5B_13:2491:5958: scene=5B_13
#: 5B_13:2491
msgctxt "text_id=5958 | speaker=unknown"
msgid "　この地点からそう離れていない広場で、なにやら怪しげな作業を行っている。"
msgstr "  In the plaza not so far from here, she seemed to be occupied with something conspicuous."

#. Occurrence 5B_13:2496:5959: scene=5B_13
#: 5B_13:2496
msgctxt "text_id=5959 | speaker=unknown"
msgid "　青子の周囲は静かなものだ。"
msgstr "  Her surroundings lay still."

#. Occurrence 5B_13:2501:5960: scene=5B_13
#: 5B_13:2501
msgctxt "text_id=5960 | speaker=unknown"
msgid "　ブレッドマンたちは草十郎を追いかけようとして、いまだコースター入り口で試行錯誤の真っ最中。"
msgstr "  The bread-men were still busy trying to figure how to reach Soujyuro by trial and error from the roller coaster's entrance."

#. Occurrence 5B_13:2506:5961: scene=5B_13
#: 5B_13:2506
msgctxt "text_id=5961 | speaker=unknown"
msgid "　距離にして、もう百メートル以上も離れている。"
msgstr "  They were over three hundred feet away, now."

#. Occurrence 5B_13:2594:5962: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0014; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:2594
msgctxt "text_id=5962 | speaker=soujuurou"
msgid "「……汗をかくはずだ。こんなに移動したのか」"
msgstr "\"No wonder I'm drenched in sweat. Look how much ground I've covered.\""

#. Occurrence 5B_13:2600:5963: scene=5B_13
#: 5B_13:2600
msgctxt "text_id=5963 | speaker=unknown"
msgid "　真冬の強風で額の汗はすぐに乾くが、シャツの下は汗で濡れている。"
msgstr "  The strong winter gales quickly dried the sweat on his brow, but he was drenched underneath his shirt."

#. Occurrence 5B_13:2605:5964: scene=5B_13
#: 5B_13:2605
msgctxt "text_id=5964 | speaker=unknown"
msgid "　一キロマラソン以上の運動量プラス、冷や汗分も含まれているに違いない。"
msgstr "  This much sweat was worth at least a half-mile run, not to mention all the scares he had experienced throughout the night."

#. Occurrence 5B_13:2633:5965: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0015; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:2633
msgctxt "text_id=5965 | speaker=soujuurou"
msgid "「でも良かった。あとは合図を待つだけだ」"
msgstr "\"Okay. Now all I have to do is wait for the signal.\""

#. Occurrence 5B_13:2639:5966: scene=5B_13
#: 5B_13:2639
msgctxt "text_id=5966 | speaker=unknown"
msgid "　心底から安心する。"
msgstr "  He felt a wave of relief,"

#. Occurrence 5B_13:2644:5967: scene=5B_13
#: 5B_13:2644
msgctxt "text_id=5967 | speaker=unknown"
msgid "　この方法で、青子が<遊園地|スナーク>を破壊できるから、ではない。"
msgstr "  but not at the thought of Aoko destroying the Snark and this nightmarish park."

#. Occurrence 5B_13:2649:5968: scene=5B_13
#: 5B_13:2649
msgctxt "text_id=5968 | speaker=unknown"
msgid "　彼はそんな事より、ミラーハウスでの借りを少しでも返せる気がして嬉しいのだ。"
msgstr "  He was simply happy that he could repay a bit of his debt from the house of mirrors."

#. Occurrence 5B_13:2776:5969: scene=5B_13
#: 5B_13:2776
msgctxt "text_id=5969 | speaker=unknown"
msgid "　青子のいた広場から青い魔弾が昇る。"
msgstr "  A blue bullet rose from the plaza where Aoko was located."

#. Occurrence 5B_13:2782:5970: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0016; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:2782
msgctxt "text_id=5970 | speaker=soujuurou"
msgid "「合図だ……！」"
msgstr "\"That's the signal!\""

#. Occurrence 5B_13:2787:5971: scene=5B_13
#: 5B_13:2787
msgctxt "text_id=5971 | speaker=unknown"
msgid "　草十郎はレールの上に立ち上がり、ポケットに仕舞った巾着袋を放り投げた。"
msgstr "  Soujyuro stood up atop the tracks, pulled out the pouch he had stowed in his pocket, and tossed it forward."

#. Occurrence 5B_13:2875:5972: scene=5B_13
#: 5B_13:2875
msgctxt "text_id=5972 | speaker=unknown"
msgid "　ここが不安定な足場である事を考えない、豪快なオーバースロー。"
msgstr "  Without any regard for his questionable footing, he gave it a mighty overarm pitch."

#. Occurrence 5B_13:2880:5973: scene=5B_13
#: 5B_13:2880
msgctxt "text_id=5973 | speaker=unknown"
msgid "　巾着は放物線を描きながら青子のいる方角に向かっていき、ほどなくして空に<解|と>けた。"
msgstr "  The small pouch drew a parabolic curve in Aoko's direction, quickly becoming untied in mid-air."

#. Occurrence 5B_13:2950:5974: scene=5B_13
#: 5B_13:2950
msgctxt "text_id=5974 | speaker=unknown"
msgid "　巾着には彼女の髪と、重しの小石が入っていた。"
msgstr "  Inside the bag was the lock of her hair and a small stone weight."

#. Occurrence 5B_13:2957:5975: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_13_0018; voice_prefix=A10; voice_category=1; scene=5B_13
#: 5B_13:2957
msgctxt "text_id=5975 | speaker=aoko"
msgid "“高いところから風に乗せてくれれば、後はなんとかするから”"
msgstr "\"Just throw it with the wind from somewhere high up, and I'll take it from there.\""

#. Occurrence 5B_13:2963:5976: scene=5B_13
#: 5B_13:2963
msgctxt "text_id=5976 | speaker=unknown"
msgid "　青子はそう言ったが、草十郎なりに工夫した結果である。"
msgstr "  Aoko had said, but it was Soujyuro's effort that had set the plan in motion."

#. Occurrence 5B_13:2968:5977: scene=5B_13
#: 5B_13:2968
msgctxt "text_id=5977 | speaker=unknown"
msgid "　<一房|ひとふさ>の髪は、持ち主である少女を見守るように<滞空|たいくう>する。"
msgstr "  The tuft of hair remained airborne, drifting as if watching over its owner."

#. Occurrence 5B_13:3055:5978: scene=5B_13
#: 5B_13:3055
msgctxt "text_id=5978 | speaker=unknown"
msgid "　草十郎に託された仕事は終わった。"
msgstr "  Soujyuro's job was done."

#. Occurrence 5B_13:3060:5979: scene=5B_13
#: 5B_13:3060
msgctxt "text_id=5979 | speaker=unknown"
msgid "　いまだ浮遊する卵は気になるが、これは彼にどうにかできる物ではない。"
msgstr "  He remained concerned about the egg hovering over him, but there was nothing he could do about it."

#. Occurrence 5B_13:3072:5980: scene=5B_13
#: 5B_13:3072
msgctxt "text_id=5980 | speaker=unknown"
msgid "　草十郎はホッと息をついて、事の成り行きを見届けようと身を乗り出し、"
msgstr "  Soujyuro breathed a sigh of relief, and leaned forward to watch the rest of the plan unfold, but then..."

#. Occurrence 5B_13:3151:5981: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_13_0017; voice_prefix=A30; voice_category=3; scene=5B_13
#: 5B_13:3151
msgctxt "text_id=5981 | speaker=soujuurou"
msgid "「…………むむ？」"
msgstr "\"Hmm?\""

#. Occurrence 5B_13:3157:5982: scene=5B_13
#: 5B_13:3157
msgctxt "text_id=5982 | speaker=unknown"
msgid "　視界の<隅|すみ>。"
msgstr "  In the corner of his eye,"

#. Occurrence 5B_13:3162:5983: scene=5B_13
#: 5B_13:3162
msgctxt "text_id=5983 | speaker=unknown"
msgid "　青子のいる広場に近寄りつつある、なにか、見覚えのあるものを見かけた気がした。"
msgstr "  he thought he spotted something familiar approaching Aoko."

#. Occurrence 5B_14:139:5984: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0000; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:139
msgctxt "text_id=5984 | speaker=aoko"
msgid "「<刻印|ルート>、<接続|セット>―――"
msgstr "\"<Connecting to Crest|Route, set.>."

#. Occurrence 5B_14:347:5985: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0001; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:347
msgctxt "text_id=5985 | speaker=aoko"
msgid "　直<流数|ディレクト>紋、一層、二層―――予備に三層。"
msgstr "  Direct current crests: First layer. Second layer. Third layer, reserved."

#. Occurrence 5B_14:369:5986: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0002; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:369
msgctxt "text_id=5986 | speaker=aoko"
msgid "　魔力提供、大源に固定。"
msgstr "  Magical energy supply fixed to Greater Source."

#. Occurrence 5B_14:375:5987: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0003; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:375
msgctxt "text_id=5987 | speaker=aoko"
msgid "　……<循環|じゅんかん>良し、<射角|しゃかく>良し、<術式|じゅつしき>安定、おおまか良し」"
msgstr "  Flow, check. Angle, check. Formula stability...good enough.\""

#. Occurrence 5B_14:395:5988: scene=5B_14
#: 5B_14:395
msgctxt "text_id=5988 | speaker=unknown"
msgid "　レンガの<路|うえ>に<紋様|もんよう>が刻まれていく。"
msgstr "  A pattern began to carve itself into the brick street."

#. Occurrence 5B_14:400:5989: scene=5B_14
#: 5B_14:400
msgctxt "text_id=5989 | speaker=unknown"
msgid "　かつてない大詠唱による、かつてない大射程の魔術行使。"
msgstr "  The casting of an unprecedented incantation with unprecedented range."

#. Occurrence 5B_14:405:5990: scene=5B_14
#: 5B_14:405
msgctxt "text_id=5990 | speaker=unknown"
msgid "　ほのかな緊張と高揚を胸に<留|とど>めながら、新米魔術師は指を鳴らす。"
msgstr "  Keeping the rising tension contained within her chest, the fledgling mage snapped her fingers."

#. Occurrence 5B_14:441:5991: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0004; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:441
msgctxt "text_id=5991 | speaker=aoko"
msgid "「―――決めた。<魔弾|ツアー><形式|プラン>、<収束|スター><投射|マイン>」"
msgstr "\"Done. <Bullet configuration|Tour Plan>: <convergent launch!|Starmine!>\""

#. Occurrence 5B_14:447:5992: scene=5B_14
#: 5B_14:447
msgctxt "text_id=5992 | speaker=unknown"
msgid "　術式の中心に膝をつき、夜空を見上げる青子。"
msgstr "  She kneeled at the center of the formula and raised her head to the night sky."

#. Occurrence 5B_14:452:5993: scene=5B_14
#: 5B_14:452
msgctxt "text_id=5993 | speaker=unknown"
msgid "　御伽の国と化した遊園地だったが、もう、その片鱗すら彼女の視界には<映|うつ>らない。"
msgstr "  Not even a glimpse of the transmogrified fantasy land around her entered her vision now."

#. Occurrence 5B_14:457:5994: scene=5B_14
#: 5B_14:457
msgctxt "text_id=5994 | speaker=unknown"
msgid "　青い目に映るのは、たったひとつの触れられぬもの。"
msgstr "  Only one thing, one untouchable thing, was reflected in her blue eyes."

#. Occurrence 5B_14:511:5995: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_14_0000; voice_prefix=A30; voice_category=3; scene=5B_14
#: 5B_14:511
msgctxt "text_id=5995 | speaker=soujuurou"
msgid "「実は、ずっと気になっていた事が」"
msgstr "\"So, this has been on my mind for a while now...\""

#. Occurrence 5B_14:591:5996: scene=5B_14
#: 5B_14:591
msgctxt "text_id=5996 | speaker=unknown"
msgid "　つい数分ほど前の話。"
msgstr "  This is how their conversation started a few minutes prior."

#. Occurrence 5B_14:596:5997: scene=5B_14
#: 5B_14:596
msgctxt "text_id=5997 | speaker=unknown"
msgid "　そう切りだして、草十郎はある事実を口にした。"
msgstr "  Soujyuro began with a simple statement of fact."

#. Occurrence 5B_14:601:5998: scene=5B_14
#: 5B_14:601
msgctxt "text_id=5998 | speaker=unknown"
msgid "　本当に単純な食い違い。"
msgstr "  In truth, it really was the simplest of discrepancies."

#. Occurrence 5B_14:606:5999: scene=5B_14
#: 5B_14:606
msgctxt "text_id=5999 | speaker=unknown"
msgid "　一時間前までの現実と、たった今の幻想と、その最小にして最大の間違い探しを。"
msgstr "  Any difference between the reality of an hour ago and the illusion of the present was both infinitesimal and infinite."

#. Occurrence 5B_14:683:6000: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_14_0001; voice_prefix=A30; voice_category=3; scene=5B_14
#: 5B_14:683
msgctxt "text_id=6000 | speaker=soujuurou"
msgid "「雲があったから、勘違いしたんだろうけど―――」"
msgstr "\"I thought maybe I didn't know what I was looking at because of the clouds...\""

#. Occurrence 5B_14:689:6001: scene=5B_14
#: 5B_14:689
msgctxt "text_id=6001 | speaker=unknown"
msgid "　見えているのに見えないもの。"
msgstr "  It was hiding in plain sight―"

#. Occurrence 5B_14:694:6002: scene=5B_14
#: 5B_14:694
msgctxt "text_id=6002 | speaker=unknown"
msgid "　現実では有りえなくて、ここに有るのもおかしいもの。"
msgstr "  too impossible to be real, too outlandish to be here."

#. Occurrence 5B_14:699:6003: scene=5B_14
#: 5B_14:699
msgctxt "text_id=6003 | speaker=unknown"
msgid "　あらゆる原型が変わっていく遊園地で、堂々と、正常なカタチを見せつけていた―――"
msgstr "  In this amusement park where every paradigm had shifted, something was brazenly flaunting its normalcy."

#. Occurrence 5B_14:781:6004: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_14_0002; voice_prefix=A30; voice_category=3; scene=5B_14
#: 5B_14:781
msgctxt "text_id=6004 | speaker=soujuurou"
msgid "「今夜は新月なんだ、蒼崎」"
msgstr "\"Tonight is supposed to be a new moon, Aozaki.\""

#. Occurrence 5B_14:889:6005: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0005; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:889
msgctxt "text_id=6005 | speaker=aoko"
msgid "「思えば、はじめっからそのカタチだったものね、アンタは」"
msgstr "\"Yeah...come to think of it, that's actually what you started as.\""

#. Occurrence 5B_14:895:6006: scene=5B_14
#: 5B_14:895
msgctxt "text_id=6006 | speaker=unknown"
msgid "　月までの距離は三十八万キロメートル。"
msgstr "  The distance from the Earth to the moon was 238,900 miles."

#. Occurrence 5B_14:900:6007: scene=5B_14
#: 5B_14:900
msgctxt "text_id=6007 | speaker=unknown"
msgid "　本当に<そ|・><こ|・><ま|・><で|・><同|・><じ|・>であるなら、まさしく異名に恥じない怪物だ。"
msgstr "  If it truly was identical to the actual moon, then this monster indeed lived up to its eerie reputation."

#. Occurrence 5B_14:995:6008: scene=5B_14
#: 5B_14:995
msgctxt "text_id=6008 | speaker=unknown"
msgid "　だが、そうであるのなら姿を隠す必要はない。堂々と正体を明かせばいい。"
msgstr "  At a distance that vast, there would have been no need to hide. It could flaunt its true form for all to see."

#. Occurrence 5B_14:1000:6009: scene=5B_14
#: 5B_14:1000
msgctxt "text_id=6009 | speaker=unknown"
msgid "　正体を隠すのは手の届く位置にいるからこそ。"
msgstr "  But if it had to hide its true form, that meant it was vulnerable."

#. Occurrence 5B_14:1005:6010: scene=5B_14
#: 5B_14:1005
msgctxt "text_id=6010 | speaker=unknown"
msgid "　あの怪物の擬態は、同時に、人間の手で<到|・><達|・><可|・><能|・>である事を示している……！"
msgstr "  The monster's camouflage implied that it sat within the reach of human hands!"

#. Occurrence 5B_14:1046:6011: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0006; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:1046
msgctxt "text_id=6011 | speaker=aoko"
msgid "「こっちの最大射程は、よくて六百ってところだけど……」"
msgstr "\"At best, my max range is 650 yards or so...\""

#. Occurrence 5B_14:1199:6012: scene=5B_14
#: 5B_14:1199
msgctxt "text_id=6012 | speaker=unknown"
msgid "　こうなったら力尽きるまで。"
msgstr "  At this point, it was time to give it all she had."

#. Occurrence 5B_14:1204:6013: scene=5B_14
#: 5B_14:1204
msgctxt "text_id=6013 | speaker=unknown"
msgid "　この遊園地中の魔力を総動員して、魔弾の手を伸ばしてみせる。"
msgstr "  Drawing on the energy surging throughout the park, she extended her firing arm."

#. Occurrence 5B_14:1260:6014: scene=5B_14
#: 5B_14:1260
msgctxt "text_id=6014 | speaker=unknown"
msgid "　夜空に青い花火が上がる。"
msgstr "  A blue firework launched into the air."

#. Occurrence 5B_14:1355:6015: scene=5B_14
#: 5B_14:1355
msgctxt "text_id=6015 | speaker=unknown"
msgid "　風に舞う自分の髪を見上げて、青子は虚空をつかむように右手を伸ばした。"
msgstr "  Looking up at her hair dancing in the wind above, Aoko reached out her right hand as if to catch the night sky."

#. Occurrence 5B_14:1360:6016: scene=5B_14
#: 5B_14:1360
msgctxt "text_id=6016 | speaker=unknown"
msgid "　魔術師にとって自身の肉体は一線級の触媒だ。"
msgstr "  A mage's own body made for the perfect catalyst."

#. Occurrence 5B_14:1365:6017: scene=5B_14
#: 5B_14:1365
msgctxt "text_id=6017 | speaker=unknown"
msgid "　女性の魔術師であるなら、年月を積み重ねた髪は特に貴重かつ強力な燃料になる。"
msgstr "  And for a female mage, the hair she had grown out over many years made for a particularly valuable and powerful source of fuel."

#. Occurrence 5B_14:1485:6018: scene=5B_14
#: 5B_14:1485
msgctxt "text_id=6018 | speaker=unknown"
msgid "　扱いはそれこそ念じるだけでいい。"
msgstr "  To use it, all she had to do was apply her will."

#. Occurrence 5B_14:1490:6019: scene=5B_14
#: 5B_14:1490
msgctxt "text_id=6019 | speaker=unknown"
msgid "　彼女は力強く、開いた指を握りこみ、"
msgstr "  She locked the fingers on both her hands together and shouted,"

#. Occurrence 5B_14:1507:6020: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0007; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:1507
msgctxt "text_id=6020 | speaker=aoko"
msgid "「三層展開！　全術式、連結起動―――！」"
msgstr "\"Deploy third layer! All formulae, commence linked activation!\""

#. Occurrence 5B_14:1544:6021: scene=5B_14
#: 5B_14:1544
msgctxt "text_id=6021 | speaker=unknown"
msgid "　月と自らを<繋|つな>げる、明確な挑戦状をたたきつけた。"
msgstr "  She hurled forth a clear challenge to bind the moon to herself."

#. Occurrence 5B_14:1671:6022: scene=5B_14
#: 5B_14:1671
msgctxt "text_id=6022 | speaker=unknown"
msgid "　霧が渦巻く。"
msgstr "  The mist began to whirl about in a vortex."

#. Occurrence 5B_14:1676:6023: scene=5B_14
#: 5B_14:1676
msgctxt "text_id=6023 | speaker=unknown"
msgid "　中空に現れた青い魔術式を見て、高みの怪物がその牙を<剥|む>きだしにする。"
msgstr "  The monster high above bore its fangs at the sight of the blue spell that appeared in midair."

#. Occurrence 5B_14:1738:6024: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_14_0000; voice_prefix=A40; voice_category=2; scene=5B_14
#: 5B_14:1738
msgctxt "text_id=6024 | speaker=alice"
msgid "「見抜かれた、ですって……？」"
msgstr "\"Did she figure it out...?\""

#. Occurrence 5B_14:1757:6025: scene=5B_14
#: 5B_14:1757
msgctxt "text_id=6025 | speaker=unknown"
msgid "　有珠がその変化に気付いた時、青子、スナークの両者は、ともに明確な敵意を向けあっていた。"
msgstr "  By the time Alice had noticed the change, the hostility between Aoko and the Snark was palpable."

#. Occurrence 5B_14:1827:6026: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_14_0001; voice_prefix=A40; voice_category=2; scene=5B_14
#: 5B_14:1827
msgctxt "text_id=6026 | speaker=alice"
msgid "「……そう。なら青子の勝ちよ。すぐに戻りなさい。"
msgstr "\"...Very well. This round goes to Aoko. Return immediately."

#. Occurrence 5B_14:1833:6027: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_14_0002; voice_prefix=A40; voice_category=2; scene=5B_14
#: 5B_14:1833
msgctxt "text_id=6027 | speaker=alice"
msgid "　たしかに雨雲を消したのはヒントのあげすぎだけど、それぐらいは大目に見て―――スナーク？」"
msgstr "  Perhaps removing the rain clouds was too obvious a hint, but I suppose one can't win them―Flat Snark?\""

#. Occurrence 5B_14:1843:6028: scene=5B_14
#: 5B_14:1843
msgctxt "text_id=6028 | speaker=unknown"
msgid "　霧の集結は止まらない。"
msgstr "  The fog continued to thicken with no sign of abating."

#. Occurrence 5B_14:1848:6029: scene=5B_14
#: 5B_14:1848
msgctxt "text_id=6029 | speaker=unknown"
msgid "　夜空に浮かぶ月は、<不遜|ふそん>極まる魔法使いを許しはしない。"
msgstr "  The moon that floated in the night sky could not pardon such an insolent mage."

#. Occurrence 5B_14:1853:6030: scene=5B_14
#: 5B_14:1853
msgctxt "text_id=6030 | speaker=unknown"
msgid "　夜の王たる自分を<敬|うやま>わぬばかりか、あんな、あからさまに挑戦状をたたき付けられては、怒りの<収|おさ>めようがない。"
msgstr "  As if the lord of the night would bow down to such impudence; there was no staying its wrath at a challenge so flagrant."

#. Occurrence 5B_14:1941:6031: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_14_0003; voice_prefix=A40; voice_category=2; scene=5B_14
#: 5B_14:1941
msgctxt "text_id=6031 | speaker=alice"
msgid "「スナーク！」"
msgstr "\"Snark!\""

#. Occurrence 5B_14:1948:6032: scene=5B_14
#: 5B_14:1948
msgctxt "text_id=6032 | speaker=unknown"
msgid "　あわてて報告に来る駒鳥を手で払いながら、少女は変貌していく黄金の月を凝視する。"
msgstr "  The robin swooped in to give its report, but Alice waved it away. Her gaze was fixed on the transforming golden moon."

#. Occurrence 5B_14:2067:6033: scene=5B_14
#: 5B_14:2067
msgctxt "text_id=6033 | speaker=unknown"
msgid "　制止の声は届かない。"
msgstr "  Her calls of restraint did not reach it."

#. Occurrence 5B_14:2072:6034: scene=5B_14
#: 5B_14:2072
msgctxt "text_id=6034 | speaker=unknown"
msgid "“童話の怪物”は誰はばかることなく、その強大な力を、ちっぽけな<青子|えもの>に振り下ろそうと―――"
msgstr "  This fairy-tale monster was beholden to nobody, and it would have no qualms unleashing its vast might upon its puny prey."

#. Occurrence 5B_14:2244:6035: scene=5B_14
#: 5B_14:2244
msgctxt "text_id=6035 | speaker=unknown"
msgid "　うなりをあげる魔弾の炉心。"
msgstr "  The core of her magic bullet howled."

#. Occurrence 5B_14:2249:6036: scene=5B_14
#: 5B_14:2249
msgctxt "text_id=6036 | speaker=unknown"
msgid "　回転する体内の魔術回路。"
msgstr "  The Magic Circuits within her body spun."

#. Occurrence 5B_14:2254:6037: scene=5B_14
#: 5B_14:2254
msgctxt "text_id=6037 | speaker=unknown"
msgid "　架空の炎に神経を焼かれながら、青子は魔力を走らせる。"
msgstr "  Aoko fed them magical energy, scorching her nerves with imaginary flame."

#. Occurrence 5B_14:2274:6038: scene=5B_14
#: 5B_14:2274
msgctxt "text_id=6038 | speaker=unknown"
msgid "　地面に刻んだ術式は青子と<連結|リンク>している。"
msgstr "  She was linked to the formula inscribed on the ground."

#. Occurrence 5B_14:2279:6039: scene=5B_14
#: 5B_14:2279
msgctxt "text_id=6039 | speaker=unknown"
msgid "　術式を読みこみ実行するのは今まで通りだが、出力はその比ではない。"
msgstr "  The spell was read and executed the same as it always was, but its output was beyond reckoning."

#. Occurrence 5B_14:2284:6040: scene=5B_14
#: 5B_14:2284
msgctxt "text_id=6040 | speaker=unknown"
msgid "　同じ工程でもこれほどの火力なら術者にも害が及ぶ。"
msgstr "  With this much firepower, even this mundane process would invite injury upon its caster."

#. Occurrence 5B_14:2289:6041: scene=5B_14
#: 5B_14:2289
msgctxt "text_id=6041 | speaker=unknown"
msgid "　あるいは、<砲身|しんけい>が焼き崩れるほどの。"
msgstr "  It was enough to burn up the nerves that were acting as the barrel."

#. Occurrence 5B_14:2374:6042: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0008; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:2374
msgctxt "text_id=6042 | speaker=aoko"
msgid "「―――、でも、いける……！」"
msgstr "\"Rrgh! I can...do this!\""

#. Occurrence 5B_14:2380:6043: scene=5B_14
#: 5B_14:2380
msgctxt "text_id=6043 | speaker=unknown"
msgid "　怖いくらいに上昇する架空の熱量。"
msgstr "  The imaginary heat had reached a terrifying temperature."

#. Occurrence 5B_14:2385:6044: scene=5B_14
#: 5B_14:2385
msgctxt "text_id=6044 | speaker=unknown"
msgid "　底なしの感覚に身震いする青子だが、そうでなくてはこの戦法を選んだ意味がない。"
msgstr "  Aoko trembled at this endless feeling, but would have to grin and bear it lest their efforts come to naught."

#. Occurrence 5B_14:2405:6045: scene=5B_14
#: 5B_14:2405
msgctxt "text_id=6045 | speaker=unknown"
msgid "　青子はもう移動できない。"
msgstr "  Aoko could no longer move."

#. Occurrence 5B_14:2410:6046: scene=5B_14
#: 5B_14:2410
msgctxt "text_id=6046 | speaker=unknown"
msgid "　草十郎からスナークの正体を聞いた時、彼女は“移動する砲台”の優位性を捨てて、設置砲台になる道を選んだ。"
msgstr "  When she had learned the Snark's true form from Soujyuro, she gave up on any superiority a moveable turret offered, instead opting to become a stationary cannon."

#. Occurrence 5B_14:2415:6047: scene=5B_14
#: 5B_14:2415
msgctxt "text_id=6047 | speaker=unknown"
msgid "　そうでなければ届かない。この位置、この角度で刻印を固定しなければ、スナーク<狩り|ハント>はできないのだ。"
msgstr "  That was the only way she could reach it. It was impossible to hunt the Snark unless she anchored her crest at this location and angle."

#. Occurrence 5B_14:2435:6048: scene=5B_14
#: 5B_14:2435
msgctxt "text_id=6048 | speaker=unknown"
msgid "　同時に、それは“次の手段”がない事を示している。"
msgstr "  At the same time, this action revealed that she was out of options."

#. Occurrence 5B_14:2440:6049: scene=5B_14
#: 5B_14:2440
msgctxt "text_id=6049 | speaker=unknown"
msgid "　口火をきればこの場所で最後まで戦うしかない。"
msgstr "  Once the fuse was lit, she would have no choice but to fight to the bitter end."

#. Occurrence 5B_14:2445:6050: scene=5B_14
#: 5B_14:2445
msgctxt "text_id=6050 | speaker=unknown"
msgid "　それでいい、と青子は大きく息を吸い込んだ。"
msgstr "  Aoko took a deep breath; this was the way she wanted it."

#. Occurrence 5B_14:2450:6051: scene=5B_14
#: 5B_14:2450
msgctxt "text_id=6051 | speaker=unknown"
msgid "　準備は万全。ロケットの噴射に等しい魔力の渦を、直接、あの月にまで届かせる―――！"
msgstr "  Her preparations were complete. She would be able deliver this maelstrom of magical energy directly to the moon, like a rocket payload!"

#. Occurrence 5B_14:2470:6052: scene=5B_14
#: 5B_14:2470
msgctxt "text_id=6052 | speaker=unknown"
msgid "　中空に浮かぶ第三層は臨界に達した魔力を撃ち出す銃口であり、射角を調整する<照星|しょうせい>だ。"
msgstr "  The third midair layer served as the cannon's muzzle and sight. It would fire the magical energy once it reached criticality, and it allowed Aoko to adjust the angle of fire."

#. Occurrence 5B_14:2485:6053: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0009; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:2485
msgctxt "text_id=6053 | speaker=aoko"
msgid "“霧……？”"
msgstr "(Fog...?)"

#. Occurrence 5B_14:2490:6054: scene=5B_14
#: 5B_14:2490
msgctxt "text_id=6054 | speaker=unknown"
msgid "　その照準越しに月が<歪|ゆが>む。"
msgstr "  The moon became warped within her scope."

#. Occurrence 5B_14:2600:6055: scene=5B_14
#: 5B_14:2600
msgctxt "text_id=6055 | speaker=unknown"
msgid "　魔力を充電する青子をあざ笑うように、黄金の月はその正体を現していく。"
msgstr "  As Aoko charged her magical energy, the Ploy displayed its golden form as if to mock her."

#. Occurrence 5B_14:2624:6056: scene=5B_14
#: 5B_14:2624
msgctxt "text_id=6056 | speaker=unknown"
msgid "　さあ―――<宙|てん>を仰げ、異能なき<無|む><辜|こ>の血統。"
msgstr "  Come. Worship the heavens, powerless scion of an innocent bloodline."

#. Occurrence 5B_14:2630:6057: scene=5B_14
#: 5B_14:2630
msgctxt "text_id=6057 | speaker=unknown"
msgid "　あれこそは魔天の一角、"
msgstr "  For there it was, a point among the otherworldly sky,"

msgctxt "text_id=6058 | speaker=unknown"
msgid "　緑色の霧、<紺碧|こんぺき>の雲にかすむ神秘の<貌|すがた>。"
msgstr "  a Mystical visage obfuscated by jade mists and azure clouds."

#. Occurrence 5B_14:2638:6059: scene=5B_14
#: 5B_14:2638
msgctxt "text_id=6059 | speaker=unknown"
msgid "　魔術世界において至宝と称され、"
msgstr "  Called the greatest treasure known to the world of magecraft,"

msgctxt "text_id=6060 | speaker=unknown"
msgid "　一つの王国より稀少と値付けられた<至高の幻想|クラウン・ファンタズム>。"
msgstr "  a rarity more valuable than an entire kingdom: Crown Phantasm."

#. Occurrence 5B_14:2759:6061: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0010; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:2759
msgctxt "text_id=6061 | speaker=aoko"
msgid "“あれが―――フラットスナーク……！！！！”"
msgstr "(That's it! That's Flat Snark!)"

#. Occurrence 5B_14:2765:6062: scene=5B_14
#: 5B_14:2765
msgctxt "text_id=6062 | speaker=unknown"
msgid "　<第一|はじまり>より<別|わか>たれた、この世でもっとも大きな虚構！"
msgstr "  Set apart from the First, the world's greatest fabrication!"

#. Occurrence 5B_14:2896:6063: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0011; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:2896
msgctxt "text_id=6063 | speaker=aoko"
msgid "“っ……まだ早い―――まだ早い、けど―――！”"
msgstr "(...Not yet! Just need...a little more time...)"

#. Occurrence 5B_14:2985:6064: scene=5B_14
#: 5B_14:2985
msgctxt "text_id=6064 | speaker=unknown"
msgid "　これ以上の<猶|た><予|め>は許されない、と本能が叫んでいた。"
msgstr "  Her instincts screamed at her to delay no further."

#. Occurrence 5B_14:2990:6065: scene=5B_14
#: 5B_14:2990
msgctxt "text_id=6065 | speaker=unknown"
msgid "　正体を暴かれようと敵は最高級の“童話の怪物”。"
msgstr "  This fairy-tale monster was the greatest of its kind, and it was about to expose its true form."

#. Occurrence 5B_14:2995:6066: scene=5B_14
#: 5B_14:2995
msgctxt "text_id=6066 | speaker=unknown"
msgid "　この状況でも反撃の用意はある事を、剥き出しの敵意が示している……！"
msgstr "  Its open hostility made it clear that it was ready to counterattack!"

#. Occurrence 5B_14:3016:6067: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0012; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:3016
msgctxt "text_id=6067 | speaker=aoko"
msgid "“こっちはもう動けない……逃げを捨てての大詠唱、先に撃たれたらそこで終わりだ……！”　"
msgstr "(I can't move! Not with an incantation this long! If it attacks before me, it's all over!)"

#. Occurrence 5B_14:3022:6068: scene=5B_14
#: 5B_14:3022
msgctxt "text_id=6068 | speaker=unknown"
msgid "　故に、その前に撃ち落とす。"
msgstr "  She had to shoot it down first."

#. Occurrence 5B_14:3027:6069: scene=5B_14
#: 5B_14:3027
msgctxt "text_id=6069 | speaker=unknown"
msgid "　魔力は八分、術式は正常稼働、あとは<引|ひ>き<金|がね>を引くだけだが―――"
msgstr "  Magical energy was at eighty percent. The formula was operating normally. All that was left was to pull the trigger, but..."

#. Occurrence 5B_14:3071:6070: scene=5B_14
#: 5B_14:3071
msgctxt "text_id=6070 | speaker=unknown"
msgid "　本当にそれでいいのか、と冷静な自分が告げる。"
msgstr "  The calm voice inside her head asked if that was really okay."

#. Occurrence 5B_14:3140:6071: scene=5B_14
#: 5B_14:3140
msgctxt "text_id=6071 | speaker=unknown"
msgid "　始めてしまえば後戻りはできない。"
msgstr "  She had one shot at this, and there was no going back."

#. Occurrence 5B_14:3145:6072: scene=5B_14
#: 5B_14:3145
msgctxt "text_id=6072 | speaker=unknown"
msgid "　この先はコンマの戦いだ。判断ミスを悔いる瞬間さえない。０．１秒の迷いが天秤をかたむける。"
msgstr "  It was a battle of precision with no room for miscalculations. Even a tenth of a second of hesitation would tip the scales."

#. Occurrence 5B_14:3215:6073: scene=5B_14
#: 5B_14:3215
msgctxt "text_id=6073 | speaker=unknown"
msgid "　痛みへの覚悟も、失着への開き直りはできているか？"
msgstr "  Was she ready for the pain? Was she ready to deal with the fallout if she missed?"

#. Occurrence 5B_14:3262:6074: scene=5B_14
#: 5B_14:3262
msgctxt "text_id=6074 | speaker=unknown"
msgid "　そもそも本当におまえは、そのちっぽけな魔弾で、月を落とす事ができるのか―――？"
msgstr "  Could she really even take down the moon with such a tiny bullet in the first place?"

#. Occurrence 5B_14:3325:6075: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0013; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:3325
msgctxt "text_id=6075 | speaker=aoko"
msgid "“いい―――とりあえず、当たった後で考える！”"
msgstr "(Enough! Shoot first, ask questions later!)"

#. Occurrence 5B_14:3331:6076: scene=5B_14
#: 5B_14:3331
msgctxt "text_id=6076 | speaker=unknown"
msgid "　月を見据える<双眸|そうぼう>に決意をこめる。"
msgstr "  Her eyes, fixed upon the moon, were filled with determination."

#. Occurrence 5B_14:3336:6077: scene=5B_14
#: 5B_14:3336
msgctxt "text_id=6077 | speaker=unknown"
msgid "　魔弾を放った瞬間、強大なフィードバックが全身を打ちのめす事を念頭にいれて、"
msgstr "  She knew that the moment she fired, the intense recoil would overwhelm her entire body. Still, she shouted,"

#. Occurrence 5B_14:3443:6078: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0014; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:3443
msgctxt "text_id=6078 | speaker=aoko"
msgid "「―――上等！"
msgstr "\"...Bring it on!"

#. Occurrence 5B_14:3443:6079: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0014; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:3443
msgctxt "text_id=6079 | speaker=aoko"
msgid "　出し惜しみはなし、めいっぱいブン回すわ……！」"
msgstr "  I'm gonna send this thing spinning with all I've got!\""

#. Occurrence 5B_14:3449:6080: scene=5B_14
#: 5B_14:3449
msgctxt "text_id=6080 | speaker=unknown"
msgid "　<宙|そら>を狙う狙撃手は気勢と共に、一撃必中、超長射程の魔弾を解き放つ……！"
msgstr "  With every ounce of spirit she possessed, she fired her ultra-long-range projectile into the sky."

#. Occurrence 5B_14:3760:6081: scene=5B_14
#: 5B_14:3760
msgctxt "text_id=6081 | speaker=unknown"
msgid "　地上からの魔弾を抱く第三層。"
msgstr "  The third layer embraced the magic bullet fired from the surface of the Earth."

#. Occurrence 5B_14:3765:6082: scene=5B_14
#: 5B_14:3765
msgctxt "text_id=6082 | speaker=unknown"
msgid "　青子の分身とも言える刻印が、月を射抜けと光を放つ。"
msgstr "  The crest, an extension of Aoko's self, unleashed light to pierce the moon."

#. Occurrence 5B_14:3770:6083: scene=5B_14
#: 5B_14:3770
msgctxt "text_id=6083 | speaker=unknown"
msgid "　―――だが。"
msgstr "  However..."

#. Occurrence 5B_14:4096:6084: scene=5B_14
#: 5B_14:4096
msgctxt "text_id=6084 | speaker=unknown"
msgid "　光を砕く<巨|あ><峰|お>の<天蓋|てんがい>。"
msgstr "  An enormous, blue canopy pulverized the beam."

#. Occurrence 5B_14:4101:6085: scene=5B_14
#: 5B_14:4101
msgctxt "text_id=6085 | speaker=unknown"
msgid "　瞬間火炎温度３０００度に匹敵する<架|エ><空|ー><要|テ><素|ル>が、真っ向から無に帰していく……！"
msgstr "  It returned the Ether, that 3000-degree flame, to nothing as it came in contact with the bullet."

#. Occurrence 5B_14:4233:6086: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0015; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4233
msgctxt "text_id=6086 | speaker=aoko"
msgid "「あ、づっ―――！！！！！」"
msgstr "\"Argh! Rrrrgh!\""

#. Occurrence 5B_14:4239:6087: scene=5B_14
#: 5B_14:4239
msgctxt "text_id=6087 | speaker=unknown"
msgid "　身に余る大魔術の反動に、全身の血が沸騰する。"
msgstr "  The recoil of the grand magecraft literally boiled her blood. Her body couldn't handle it."

#. Occurrence 5B_14:4244:6088: scene=5B_14
#: 5B_14:4244
msgctxt "text_id=6088 | speaker=unknown"
msgid "　停止した心臓。"
msgstr "  Her heart stopped."

#. Occurrence 5B_14:4249:6089: scene=5B_14
#: 5B_14:4249
msgctxt "text_id=6089 | speaker=unknown"
msgid "　激痛と衝撃で麻痺する<脳髄|のうずい>。"
msgstr "  Her brain went numb from the pain and impact."

#. Occurrence 5B_14:4254:6090: scene=5B_14
#: 5B_14:4254
msgctxt "text_id=6090 | speaker=unknown"
msgid "　末端から<壊|え><死|し>していく神経。"
msgstr "  Her nerves putrefied from end to end."

#. Occurrence 5B_14:4259:6091: scene=5B_14
#: 5B_14:4259
msgctxt "text_id=6091 | speaker=unknown"
msgid "　それらすべてを、魔術刻印が強引に蘇生させる。"
msgstr "  But her Magic Crest revived them all by force."

#. Occurrence 5B_14:4385:6092: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0016; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4385
msgctxt "text_id=6092 | speaker=aoko"
msgid "「は、ぁつ、ぁ―――！」"
msgstr "\"Ah... Gah...!\""

#. Occurrence 5B_14:4391:6093: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0017; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4391
msgctxt "text_id=6093 | speaker=aoko"
msgid "“氷―――！　氷で<防|ふせ>がれた！”"
msgstr "(Ice? It was blocked by ice!)"

#. Occurrence 5B_14:4397:6094: scene=5B_14
#: 5B_14:4397
msgctxt "text_id=6094 | speaker=unknown"
msgid "　真っ白に眩む視界のなか、青子はたしかに見た。"
msgstr "  Even though her vision had gone white, she could still see it."

#. Occurrence 5B_14:4402:6095: scene=5B_14
#: 5B_14:4402
msgctxt "text_id=6095 | speaker=unknown"
msgid "　<口内|こうない>の血を飲みこんで頭上を<睨|にら>む。"
msgstr "  Swallowing the blood in her mouth, Aoko looked up with a scowl."

#. Occurrence 5B_14:4509:6096: scene=5B_14
#: 5B_14:4509
msgctxt "text_id=6096 | speaker=unknown"
msgid "　そこには。"
msgstr "  There it was,"

#. Occurrence 5B_14:4515:6097: scene=5B_14
#: 5B_14:4515
msgctxt "text_id=6097 | speaker=unknown"
msgid "巨大な氷塊を盾にしてあざ笑う、いびつで邪悪な<髑髏|どくろ>の顔が……！"
msgstr " an enormous shield of ice and a sneering, deformed skull."

#. Occurrence 5B_14:4603:6098: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0018; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4603
msgctxt "text_id=6098 | speaker=aoko"
msgid "“撃つのが遅すぎた、それとも早すぎた……！？"
msgstr "(Did I fire too late? Did I fire too early!?"

#. Occurrence 5B_14:4603:6099: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0018; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4603
msgctxt "text_id=6099 | speaker=aoko"
msgid "　盾を作られる前に撃てばよかった！？"
msgstr "  Should I have shot before it made that shield?"

#. Occurrence 5B_14:4603:6100: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0018; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4603
msgctxt "text_id=6100 | speaker=aoko"
msgid "　それとも、正面からじゃ無謀すぎた……！？”"
msgstr "  Was it too reckless to shoot it head-on!?)"

#. Occurrence 5B_14:4697:6101: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0019; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4697
msgctxt "text_id=6101 | speaker=aoko"
msgid "「っ、どっちでもいい！"
msgstr "\"Who cares!?"

#. Occurrence 5B_14:4703:6102: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0020; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4703
msgctxt "text_id=6102 | speaker=aoko"
msgid "　一層、二層、再起動―――！　急いで！」"
msgstr "  First layer, second layer, reactivate! Hurry!\""

#. Occurrence 5B_14:4786:6103: scene=5B_14
#: 5B_14:4786
msgctxt "text_id=6103 | speaker=unknown"
msgid "　考える余分も、迷っている余裕もない。"
msgstr "  There was no time to think or hesitate."

#. Occurrence 5B_14:4849:6104: scene=5B_14
#: 5B_14:4849
msgctxt "text_id=6104 | speaker=unknown"
msgid "　遊園地<中|じゅう>の魔力が集結する。"
msgstr "  The magical energy throughout the park began to gather."

#. Occurrence 5B_14:4856:6105: scene=5B_14
#: 5B_14:4856
msgctxt "text_id=6105 | speaker=unknown"
msgid "　一方は青子に。"
msgstr "  Aoko knelt,"

#. Occurrence 5B_14:4861:6106: scene=5B_14
#: 5B_14:4861
msgctxt "text_id=6106 | speaker=unknown"
msgid "　もう一方は君臨する月の顔に。"
msgstr "  across from the tyrannical face of the moon."

#. Occurrence 5B_14:4866:6107: scene=5B_14
#: 5B_14:4866
msgctxt "text_id=6107 | speaker=unknown"
msgid "　今の氷は未完成だ、と青子は直感した。こちらがそうであったように、フラットスナークもまだ<極限|じょうげん>に達していない。"
msgstr "  She intuited that the ice had yet to fully form; Flat Snark still hadn't reached its full strength."

#. Occurrence 5B_14:4871:6108: scene=5B_14
#: 5B_14:4871
msgctxt "text_id=6108 | speaker=unknown"
msgid "　そう、だからこそ―――"
msgstr "  Which was exactly why..."

#. Occurrence 5B_14:4965:6109: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0021; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:4965
msgctxt "text_id=6109 | speaker=aoko"
msgid "“まずい―――まずい、まずい、まずい！”"
msgstr "(Dammit... Dammit, dammit, dammit!)"

#. Occurrence 5B_14:4971:6110: scene=5B_14
#: 5B_14:4971
msgctxt "text_id=6110 | speaker=unknown"
msgid "　術式の加速は青子自身を傷つける。"
msgstr "  By accelerating the spell, Aoko damaged her own body."

#. Occurrence 5B_14:4976:6111: scene=5B_14
#: 5B_14:4976
msgctxt "text_id=6111 | speaker=unknown"
msgid "　繋がっている以上、術式に負荷をかけるほど<軋|きし>みは青子の体にのしかかる。それでも今は耐えるしかない。"
msgstr "  The burden of linking the formula to the Snark caused intense pain. All she could do was grit her teeth and endure it."

#. Occurrence 5B_14:5003:6112: scene=5B_14
#: 5B_14:5003
msgctxt "text_id=6112 | speaker=unknown"
msgid "　なぜなら―――"
msgstr "  All because..."

#. Occurrence 5B_14:5066:6113: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0022; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:5066
msgctxt "text_id=6113 | speaker=aoko"
msgid "“―――あの氷、<私|・><の|・><マ|・><ッ|・><ク|・><ス|・><よ|・><り|・><も|・><っ|・><と|・><上|・><だ|・>！”"
msgstr "(That ice is tougher than my best shot!)"

#. Occurrence 5B_14:5072:6114: scene=5B_14
#: 5B_14:5072
msgctxt "text_id=6114 | speaker=unknown"
msgid "　今の一撃で互いの戦力が分かってしまった。"
msgstr "  Aoko had gotten a read on their relative strengths."

#. Occurrence 5B_14:5077:6115: scene=5B_14
#: 5B_14:5077
msgctxt "text_id=6115 | speaker=unknown"
msgid "　魔力量こそ同じでも、<神秘|カタチ>を成す術式の強度が違う。"
msgstr "  Even if its volume of magical energy was identical, Snark's form―its Mystic scale―was in a different league."

#. Occurrence 5B_14:5082:6116: scene=5B_14
#: 5B_14:5082
msgctxt "text_id=6116 | speaker=unknown"
msgid "　青子が限界まで魔力を充電しても、ようやく<今|・><の|・><氷|・><塊|・>を打ち抜ける程度なのだ。"
msgstr "  Aoko could charge her energy to her absolute limit, and that would barely make a dent in the ice wall."

#. Occurrence 5B_14:5087:6117: scene=5B_14
#: 5B_14:5087
msgctxt "text_id=6117 | speaker=unknown"
msgid "　<即|すなわ>ち、スナークが限界まで魔力を集めた場合、何をやっても圧し負ける……！"
msgstr "  Meanwhile, there was nothing she could do to prevent her own annihilation if the Snark gathered as much energy as it could...!"

#. Occurrence 5B_14:5177:6118: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0023; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:5177
msgctxt "text_id=6118 | speaker=aoko"
msgid "「なら、その前に―――！」"
msgstr "\"Then, before that happens...!\""

#. Occurrence 5B_14:5183:6119: scene=5B_14
#: 5B_14:5183
msgctxt "text_id=6119 | speaker=unknown"
msgid "　次弾を装填する。"
msgstr "  She loaded her next shot."

#. Occurrence 5B_14:5188:6120: scene=5B_14
#: 5B_14:5188
msgctxt "text_id=6120 | speaker=unknown"
msgid "　空中の第三層に命令を届かせる。"
msgstr "  She issued orders to the floating third layer."

#. Occurrence 5B_14:5193:6121: scene=5B_14
#: 5B_14:5193
msgctxt "text_id=6121 | speaker=unknown"
msgid "　体への負担を無視して一層の術式を加速させる。"
msgstr "  Ignoring the toll on her body, she began to accelerate the first layer formula."

#. Occurrence 5B_14:5280:6122: scene=5B_14
#: 5B_14:5280
msgctxt "text_id=6122 | speaker=unknown"
msgid "　右手の一層は周囲の魔力を吸収、蓄電する役割だ。"
msgstr "  The role of her right hand's single layer was to absorb and store surrounding magical energy."

#. Occurrence 5B_14:5285:6123: scene=5B_14
#: 5B_14:5285
msgctxt "text_id=6123 | speaker=unknown"
msgid "　遊園地を覆う濃霧。フラットスナーク自身がはき出した太古の<魔力|エーテル>が、術式に注ぎ込まれる。"
msgstr "  The thick fog that drifted through the park was an ancient Ether spewed out by Flat Snark's own body, but Aoko could pour it into her formula."

#. Occurrence 5B_14:5381:6124: scene=5B_14
#: 5B_14:5381
msgctxt "text_id=6124 | speaker=unknown"
msgid "　当然、術式と一体化している青子の身体は、許容量をはるかに超えた魔力に悲鳴をあげる。"
msgstr "  Aoko's body, which had integrated with the formula, took on an amount of magical energy that far surpassed its maximum capacity. It seethed in agony."

#. Occurrence 5B_14:5386:6125: scene=5B_14
#: 5B_14:5386
msgctxt "text_id=6125 | speaker=unknown"
msgid "　いや、歓喜にうち<震|ふる>える。"
msgstr "  Or rather, it trembled in delight."

#. Occurrence 5B_14:5406:6126: scene=5B_14
#: 5B_14:5406
msgctxt "text_id=6126 | speaker=unknown"
msgid "　魔術師にとって、魔力とは神秘に至る為の推進剤。"
msgstr "  For a mage, magical energy was a propellant to reach the realm of Mystics."

#. Occurrence 5B_14:5418:6127: scene=5B_14
#: 5B_14:5418
msgctxt "text_id=6127 | speaker=unknown"
msgid "　体内時間の膨張。"
msgstr "  The expansion of internal time..."

#. Occurrence 5B_14:5423:6128: scene=5B_14
#: 5B_14:5423
msgctxt "text_id=6128 | speaker=unknown"
msgid "　自我の融解。"
msgstr "  The liquefaction of the self..."

#. Occurrence 5B_14:5428:6129: scene=5B_14
#: 5B_14:5428
msgctxt "text_id=6129 | speaker=unknown"
msgid "　肉体からの解放。"
msgstr "  The release from the physical..."

#. Occurrence 5B_14:5433:6130: scene=5B_14
#: 5B_14:5433
msgctxt "text_id=6130 | speaker=unknown"
msgid "　言ってしまえば臨死体験。"
msgstr "  They were all what one might call a near-death experience."

#. Occurrence 5B_14:5463:6131: scene=5B_14
#: 5B_14:5463
msgctxt "text_id=6131 | speaker=unknown"
msgid "　そのギリギリの境界で、青子は現実を直視する。"
msgstr "  On the precipice of what lay beyond, Aoko stood firm, and faced reality."

#. Occurrence 5B_14:5551:6132: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0024; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:5551
msgctxt "text_id=6132 | speaker=aoko"
msgid "“――――――”"
msgstr "\"...\""

#. Occurrence 5B_14:5557:6133: scene=5B_14
#: 5B_14:5557
msgctxt "text_id=6133 | speaker=unknown"
msgid "　……その現実が、激痛に耐える意志を、折りにくる。"
msgstr "  Still, reality had come to break her will."

#. Occurrence 5B_14:5562:6134: scene=5B_14
#: 5B_14:5562
msgctxt "text_id=6134 | speaker=unknown"
msgid "　誰であろうと差は歴然。"
msgstr "  The gap between them was plain to any observer."

#. Occurrence 5B_14:5568:6135: scene=5B_14
#: 5B_14:5568
msgctxt "text_id=6135 | speaker=unknown"
msgid "　蒼崎青子という砲身では、"
msgstr "  The gun barrel named Aoko Aozaki..."

msgctxt "text_id=6136 | speaker=unknown"
msgid "　あの氷塊を<削|けず>る事さえできはしまい―――"
msgstr "  ...had not a chance to chip away at that lump of ice."

#. Occurrence 5B_14:5683:6137: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0025; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:5683
msgctxt "text_id=6137 | speaker=aoko"
msgid "“っ、<痛|そ><み|れ>が―――”"
msgstr "(Argh! So―)"

#. Occurrence 5B_14:5694:6138: scene=5B_14
#: 5B_14:5694
msgctxt "text_id=6138 | speaker=unknown"
msgid "　術式をなお加速させる。"
msgstr "  She accelerated the spell further."

#. Occurrence 5B_14:5759:6139: scene=5B_14
#: 5B_14:5759
msgctxt "text_id=6139 | speaker=unknown"
msgid "　髑髏が笑う。"
msgstr "  The skull grinned."

msgctxt "text_id=6140 | speaker=unknown"
msgid "氷塊は盾ではない。"
msgstr " That ice was no shield."

msgctxt "text_id=6141 | speaker=unknown"
msgid "アレは身を<弁|わきま>えない魔術師を押しつぶすもの。"
msgstr " It was a hammer to crush mages who did not know their place."

msgctxt "text_id=6142 | speaker=unknown"
msgid "遊園地全体を<陥没|かんぼつ>させる<氷塊|いちげき>で、青子だけでなく、コースターの上にいる彼さえも踏み砕こうと笑っている。"
msgstr " The moon laughed as it prepared to crush not just Aoko, but the boy atop the roller coaster, as well as the park in its entirety."

#. Occurrence 5B_14:5824:6143: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0026; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:5824
msgctxt "text_id=6143 | speaker=aoko"
msgid "“どうした―――！！！！”"
msgstr "(SO WHAT IF IT HURTS!?)"

#. Occurrence 5B_14:5884:6144: scene=5B_14
#: 5B_14:5884
msgctxt "text_id=6144 | speaker=unknown"
msgid "　臨界寸前の魔術回路。"
msgstr "  Her circuits were on the verge of going critical."

#. Occurrence 5B_14:5890:6145: scene=5B_14
#: 5B_14:5890
msgctxt "text_id=6145 | speaker=unknown"
msgid "指先はおろか眼球まで焼く電荷。"
msgstr "Her body had been charged with a scorching power supply, from her fingertips to her eyeballs."

#. Occurrence 5B_14:5895:6146: scene=5B_14
#: 5B_14:5895
msgctxt "text_id=6146 | speaker=unknown"
msgid "　それでも魔弾の引き金を<絞|しぼ>る。"
msgstr "  She would see the bullet fired."

#. Occurrence 5B_14:5900:6147: scene=5B_14
#: 5B_14:5900
msgctxt "text_id=6147 | speaker=unknown"
msgid "　神経の伝達速度で魔術式を<強化|アレンジ>する。"
msgstr "  She would arrange the magecraft formula as quickly as her nerves' transmission speed would allow."

#. Occurrence 5B_14:5927:6148: scene=5B_14
#: 5B_14:5927
msgctxt "text_id=6148 | speaker=unknown"
msgid "　一撃では越えられない。"
msgstr "  A single attack was not enough."

#. Occurrence 5B_14:5932:6149: scene=5B_14
#: 5B_14:5932
msgctxt "text_id=6149 | speaker=unknown"
msgid "　側面から撃つ手段はない。"
msgstr "  There was no way to shoot it from its flank."

#. Occurrence 5B_14:5959:6150: scene=5B_14
#: 5B_14:5959
msgctxt "text_id=6150 | speaker=unknown"
msgid "　なら、<試|や>るべき<手段|こたえ>は明白すぎる―――！"
msgstr "  Which meant there was only one solution."

#. Occurrence 5B_14:6173:6151: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0027; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:6173
msgctxt "text_id=6151 | speaker=aoko"
msgid "“<再接続|セレクタ>、<交流数紋|オルタネイト>……！”"
msgstr "\"<Reconnecting to alternating current!|Alternate selector!>\""

#. Occurrence 5B_14:6179:6152: scene=5B_14
#: 5B_14:6179
msgctxt "text_id=6152 | speaker=unknown"
msgid "　変革する第三層。"
msgstr "  The third layer began to transform."

#. Occurrence 5B_14:6184:6153: scene=5B_14
#: 5B_14:6184
msgctxt "text_id=6153 | speaker=unknown"
msgid "　直流から交流へ。本来なら軌道の変化を得意とする術式だが、今は単純に数が欲しい……！"
msgstr "  It switched from direct to alternating current. The spell's supposed strong point was its ability to adjust its trajectory mid-flight, but right now all she wanted was numbers."

#. Occurrence 5B_14:6228:6154: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0028; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:6228
msgctxt "text_id=6154 | speaker=aoko"
msgid "「<接続|セット>、<八芒星|オクタグラム>―――！"
msgstr "\"<Connecting.|Set.> Octogram!"

#. Occurrence 5B_14:6235:6155: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0029; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:6235
msgctxt "text_id=6155 | speaker=aoko"
msgid "　全界層、ブン回せ―――！」"
msgstr "  All layers, max rotation!\""

#. Occurrence 5B_14:6757:6156: scene=5B_14
#: 5B_14:6757
msgctxt "text_id=6156 | speaker=unknown"
msgid "　遊園地を照らす青い太陽。"
msgstr "  A blue sun shined down upon the amusement park."

#. Occurrence 5B_14:6762:6157: scene=5B_14
#: 5B_14:6762
msgctxt "text_id=6157 | speaker=unknown"
msgid "　最大出力の光弾が、黄金の月を射止めに走る。"
msgstr "  Beams of light at maximum output streaked forth to pierce the golden moon."

#. Occurrence 5B_14:7336:6158: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0030; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:7336
msgctxt "text_id=6158 | speaker=aoko"
msgid "「こ、のぉ……！」"
msgstr "\"Take...this...!\""

#. Occurrence 5B_14:7342:6159: scene=5B_14
#: 5B_14:7342
msgctxt "text_id=6159 | speaker=unknown"
msgid "　引き金は<絞|しぼ>ったまま、際限なく取りこむ魔力を、休むことなく放ち続ける。"
msgstr "  Holding down the trigger, she continued to fire, taking in energy ad infinitum."

#. Occurrence 5B_14:7679:6160: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0031; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:7679
msgctxt "text_id=6160 | speaker=aoko"
msgid "“っ―――、ぁ―――…………”"
msgstr "\"Gah... Ahgh...\""

#. Occurrence 5B_14:7685:6161: scene=5B_14
#: 5B_14:7685
msgctxt "text_id=6161 | speaker=unknown"
msgid "　臨界域から噴き出される青い炎。"
msgstr "  Blue flames shot forth at critical level."

#. Occurrence 5B_14:7690:6162: scene=5B_14
#: 5B_14:7690
msgctxt "text_id=6162 | speaker=unknown"
msgid "　だが氷塊は融解さえしない。"
msgstr "  But the ice would neither melt nor mar. "

#. Occurrence 5B_14:7695:6163: scene=5B_14
#: 5B_14:7695
msgctxt "text_id=6163 | speaker=unknown"
msgid "　温度以前に、カタチ取られた魔力量が違いすぎる。"
msgstr "  No amount of sheer heat could make a dent in something formed from such a colossal amount of magical energy."

#. Occurrence 5B_14:7800:6164: scene=5B_14
#: 5B_14:7800
msgctxt "text_id=6164 | speaker=unknown"
msgid "　体内の魔術回路の負荷が、鮮血となって荒れ狂う。"
msgstr "  The toll on her circuits sent them berserk, and blood began to run free."

#. Occurrence 5B_14:7806:6165: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0032; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:7806
msgctxt "text_id=6165 | speaker=aoko"
msgid "“っ……！！　これだけ、回して、るのに―――"
msgstr "(...Agh! The spin should have been more than enough..."

#. Occurrence 5B_14:7812:6166: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0033; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:7812
msgctxt "text_id=6166 | speaker=aoko"
msgid "　アイツの方が、ぜんぜん、上……！”"
msgstr "  He's...just...too strong!)"

#. Occurrence 5B_14:7890:6167: scene=5B_14
#: 5B_14:7890
msgctxt "text_id=6167 | speaker=unknown"
msgid "　この戦いは遊園地に満ちた魔力の奪い合いでもある。"
msgstr "  The battle had become a tussle over the magical energy that filled the park."

#. Occurrence 5B_14:7895:6168: scene=5B_14
#: 5B_14:7895
msgctxt "text_id=6168 | speaker=unknown"
msgid "　もとよりここはスナークの庭。"
msgstr "  From the very beginning, this had been the Snark's home turf."

#. Occurrence 5B_14:7900:6169: scene=5B_14
#: 5B_14:7900
msgctxt "text_id=6169 | speaker=unknown"
msgid "　空間の支配率はスナークが八割、青子は二割にすぎない。"
msgstr "  The Snark had control over at least eighty percent of the space, while Aoko had twenty at best."

#. Occurrence 5B_14:8030:6170: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0034; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:8030
msgctxt "text_id=6170 | speaker=aoko"
msgid "「だ、め……止められ、ない……！」"
msgstr "\"No... I...can't...stop it!\""

#. Occurrence 5B_14:8150:6171: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0035; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:8150
msgctxt "text_id=6171 | speaker=aoko"
msgid "“あ……”"
msgstr "(No...)"

#. Occurrence 5B_14:8156:6172: scene=5B_14
#: 5B_14:8156
msgctxt "text_id=6172 | speaker=unknown"
msgid "　勝敗を告げるように、氷の城が落ちてくる。"
msgstr "  The castle of ice descended as if to call the match."

#. Occurrence 5B_14:8237:6173: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0036; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:8237
msgctxt "text_id=6173 | speaker=aoko"
msgid "「あ―――ああ、ああぁああ……！」"
msgstr "\"Ah...AaaAAAhhhHHH!\""

#. Occurrence 5B_14:8243:6174: scene=5B_14
#: 5B_14:8243
msgctxt "text_id=6174 | speaker=unknown"
msgid "　青子にできるのはその結末を遅らせる程度。"
msgstr "  All she could do was delay the inevitable."

#. Occurrence 5B_14:8248:6175: scene=5B_14
#: 5B_14:8248
msgctxt "text_id=6175 | speaker=unknown"
msgid "　追いつめられるだけと分かっていながら、今は魔弾を撃ち続けるしかない。"
msgstr "  She knew that she had been backed into a wall, and right now, the only thing she could do was to keep firing."

#. Occurrence 5B_14:8303:6176: scene=5B_14
#: 5B_14:8303
msgctxt "text_id=6176 | speaker=unknown"
msgid "　ああ、でも―――今ならまだ、他に手はある。"
msgstr "  Then again, perhaps not. There was another option."

#. Occurrence 5B_14:8308:6177: scene=5B_14
#: 5B_14:8308
msgctxt "text_id=6177 | speaker=unknown"
msgid "　この魔力をすべて防御に回せば、万が一―――いや、高い確率で、<青子|じぶん>だけは助かるのでは、と―――"
msgstr "  If she converted all of her magical energy into a defense, there was a tiny chance―no, not tiny. A great possibility, in fact, that she could save just her―"

#. Occurrence 5B_14:8412:6178: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0037; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:8412
msgctxt "text_id=6178 | speaker=aoko"
msgid "“……っ、うるさい！"
msgstr "(Shut up and do it already!"

#. Occurrence 5B_14:8412:6179: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0037; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:8412
msgctxt "text_id=6179 | speaker=aoko"
msgid "　ここの魔力を使い切れば、あの氷だって……！”"
msgstr "  Not even that ice has a chance against all the magical energy here!)"

#. Occurrence 5B_14:8418:6180: scene=5B_14
#: 5B_14:8418
msgctxt "text_id=6180 | speaker=unknown"
msgid "　破綻した希望にすがって青子は回路を回し続ける。"
msgstr "  Clinging to that broken hope, Aoko continued to rotate her circuits."

#. Occurrence 5B_14:8533:6181: scene=5B_14
#: 5B_14:8533
msgctxt "text_id=6181 | speaker=unknown"
msgid "　魔力の<過剰摂取|オーバードウズ>で停止する時間。"
msgstr "  Time seemed to stop at the magical energy overdose."

#. Occurrence 5B_14:8538:6182: scene=5B_14
#: 5B_14:8538
msgctxt "text_id=6182 | speaker=unknown"
msgid "　永遠に続く一秒の激痛。"
msgstr "  A second of intense pain lasted an eternity."

#. Occurrence 5B_14:8543:6183: scene=5B_14
#: 5B_14:8543
msgctxt "text_id=6183 | speaker=unknown"
msgid "　その中で、"
msgstr "  Then, amidst everything..."

#. Occurrence 5B_14:8595:6184: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0038; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:8595
msgctxt "text_id=6184 | speaker=aoko"
msgid "“―――え？”"
msgstr "(Huh?)"

#. Occurrence 5B_14:8628:6185: scene=5B_14
#: 5B_14:8628
msgctxt "text_id=6185 | speaker=unknown"
msgid "　何かが、ひたひたと、"
msgstr "  Something approached one step at a time."

#. Occurrence 5B_14:8702:6186: scene=5B_14
#: 5B_14:8702
msgctxt "text_id=6186 | speaker=unknown"
msgid "　何かが、遊園地の物陰から、"
msgstr "  Something from among the park's shadows."

#. Occurrence 5B_14:8749:6187: scene=5B_14
#: 5B_14:8749
msgctxt "text_id=6187 | speaker=unknown"
msgid "　何かが、"
msgstr "  Something..."

msgctxt "text_id=6188 | speaker=unknown"
msgid "何かが、"
msgstr " Something..."

msgctxt "text_id=6189 | speaker=unknown"
msgid "何かが、"
msgstr " Something..."

#. Occurrence 5B_14:8928:6190: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0039; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:8928
msgctxt "text_id=6190 | speaker=aoko"
msgid "“ちょっ―――”"
msgstr "(Wai―)"

#. Occurrence 5B_14:8934:6191: scene=5B_14
#: 5B_14:8934
msgctxt "text_id=6191 | speaker=unknown"
msgid "　全身が総毛立つ。"
msgstr "  She felt goosebumps from head to toe."

#. Occurrence 5B_14:8939:6192: scene=5B_14
#: 5B_14:8939
msgctxt "text_id=6192 | speaker=unknown"
msgid "　頭上の氷塊なんて問題じゃない。"
msgstr "  The issue was no longer the ice overhead."

#. Occurrence 5B_14:8944:6193: scene=5B_14
#: 5B_14:8944
msgctxt "text_id=6193 | speaker=unknown"
msgid "　静止した時間の中で、ひたひたと、赤い死がやってくる。"
msgstr "  In the midst of this stillness, the red death drew closer, step by ominous step."

#. Occurrence 5B_14:8972:6194: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0040; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:8972
msgctxt "text_id=6194 | speaker=aoko"
msgid "“なんで、こんな、ところで…………！”"
msgstr "(Why here? Why now!?)"

#. Occurrence 5B_14:8978:6195: scene=5B_14
#: 5B_14:8978
msgctxt "text_id=6195 | speaker=unknown"
msgid "　恐怖で<回路|せいしん>が破裂しかける。"
msgstr "  Her circuits and her mind began to rupture out of terror."

#. Occurrence 5B_14:8983:6196: scene=5B_14
#: 5B_14:8983
msgctxt "text_id=6196 | speaker=unknown"
msgid "　<術式|こころ>の形成がほころびかける。"
msgstr "  The composition of her formula and soul began to rip apart."

#. Occurrence 5B_14:8988:6197: scene=5B_14
#: 5B_14:8988
msgctxt "text_id=6197 | speaker=unknown"
msgid "　ソレは彼女の背後にまでやってきて、"
msgstr "  There it was, just behind her."

#. Occurrence 5B_14:8993:6198: scene=5B_14
#: 5B_14:8993
msgctxt "text_id=6198 | speaker=unknown"
msgid "　ひたり、と。"
msgstr "  Its footsteps came to a halt."

#. Occurrence 5B_14:8998:6199: scene=5B_14
#: 5B_14:8998
msgctxt "text_id=6199 | speaker=unknown"
msgid "　血まみれの手で、後ろから青子の両頬に手を当てて、"
msgstr "  It reached around and cupped her face in its bloodstained hands."

#. Occurrence 5B_14:9093:6200: voice_id=C70_5B_14_0000; voice_prefix=C70; voice_category=0; scene=5B_14
#: 5B_14:9093
msgctxt "text_id=6200 | speaker=unknown"
msgid "　　　　　　　　　"
msgstr "                                                "

msgctxt "text_id=6201 | speaker=unknown"
msgid "『こんにち　は』"
msgstr "\"Greetings.\""

#. Occurrence 5B_14:9137:6202: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0041; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:9137
msgctxt "text_id=6202 | speaker=aoko"
msgid "“！！！！！”"
msgstr "\"!!!\""

#. Occurrence 5B_14:9143:6203: scene=5B_14
#: 5B_14:9143
msgctxt "text_id=6203 | speaker=unknown"
msgid "　あらゆる感情、あらゆる自我が絶叫したがる。"
msgstr "  She wanted to scream out with all her might."

#. Occurrence 5B_14:9148:6204: scene=5B_14
#: 5B_14:9148
msgctxt "text_id=6204 | speaker=unknown"
msgid "　もういい。どうでもいい、なんでもいい！"
msgstr "  This is it. Nothing matters! I couldn't care less!"

#. Occurrence 5B_14:9153:6205: scene=5B_14
#: 5B_14:9153
msgctxt "text_id=6205 | speaker=unknown"
msgid "　逃げられるのなら逃げてしまえ！"
msgstr "  Run or don't run, it doesn't matter!"

#. Occurrence 5B_14:9158:6206: scene=5B_14
#: 5B_14:9158
msgctxt "text_id=6206 | speaker=unknown"
msgid "　隠しているのなら明かせばいい！"
msgstr "  Quit hiding and reveal yourself!"

#. Occurrence 5B_14:9163:6207: scene=5B_14
#: 5B_14:9163
msgctxt "text_id=6207 | speaker=unknown"
msgid "　使えるのなら、そんなもの、いっそ無慈悲に使えばいい！"
msgstr "  Use whatever you can, and show no mercy!"

#. Occurrence 5B_14:9234:6208: scene=5B_14
#: 5B_14:9234
msgctxt "text_id=6208 | speaker=unknown"
msgid "　そうだ。"
msgstr "  That was it."

#. Occurrence 5B_14:9239:6209: scene=5B_14
#: 5B_14:9239
msgctxt "text_id=6209 | speaker=unknown"
msgid "　彼女は起死回生の切り札を持っている。"
msgstr "  She had one final card to play."

#. Occurrence 5B_14:9244:6210: scene=5B_14
#: 5B_14:9244
msgctxt "text_id=6210 | speaker=unknown"
msgid "　あんな氷塊、あんな玩具なんて物ともしない奇蹟を、ある日、ポンと冗談みたいに手渡された。"
msgstr "  Once, a miracle had been gifted to her, almost as a joke. It made the ice look like child's play."

#. Occurrence 5B_14:9253:6211: scene=5B_14
#: 5B_14:9253
msgctxt "text_id=6211 | speaker=unknown"
msgid "　　　　　　　　　　／それを、この赤い死が殺しに来る。"
msgstr "                    That was what the red death had come to kill."

#. Occurrence 5B_14:9273:6212: scene=5B_14
#: 5B_14:9273
msgctxt "text_id=6212 | speaker=unknown"
msgid "　使えば破滅。"
msgstr "  Using it would spell ruin."

#. Occurrence 5B_14:9278:6213: scene=5B_14
#: 5B_14:9278
msgctxt "text_id=6213 | speaker=unknown"
msgid "　使わずとも氷に潰されて死滅。"
msgstr "  Not using it would mean death by ice."

#. Occurrence 5B_14:9288:6214: scene=5B_14
#: 5B_14:9288
msgctxt "text_id=6214 | speaker=unknown"
msgid "　なら、どうしてためらう必要がある？"
msgstr "  Then, why hesitate?"

#. Occurrence 5B_14:9293:6215: scene=5B_14
#: 5B_14:9293
msgctxt "text_id=6215 | speaker=unknown"
msgid "　別に使用制限なんてものはない。"
msgstr "  There were no conditions on its use."

#. Occurrence 5B_14:9355:6216: scene=5B_14
#: 5B_14:9355
msgctxt "text_id=6216 | speaker=unknown"
msgid "　等価に何かが失われる事もない。"
msgstr "  There was no price to pay for its power."

#. Occurrence 5B_14:9360:6217: scene=5B_14
#: 5B_14:9360
msgctxt "text_id=6217 | speaker=unknown"
msgid "　ただ、彼女が彼女でなくなるだけ。"
msgstr "  She simply would cease to be herself."

#. Occurrence 5B_14:9460:6218: scene=5B_14
#: 5B_14:9460
msgctxt "text_id=6218 | speaker=unknown"
msgid "　たったそれだけ。"
msgstr "  That was all."

#. Occurrence 5B_14:9465:6219: scene=5B_14
#: 5B_14:9465
msgctxt "text_id=6219 | speaker=unknown"
msgid "　人間なんて曖昧なものだ。"
msgstr "  Humans loved to exist in areas of gray."

#. Occurrence 5B_14:9470:6220: scene=5B_14
#: 5B_14:9470
msgctxt "text_id=6220 | speaker=unknown"
msgid "　脳の電流は一分ごとに何十回と断線して、何一つ、“いつまでも続いている<自|も><分|の>”なんてない。"
msgstr "  Dozens of electrical impulses disconnect in the brain every minute; nothing lasts forever, not even one's self."

#. Occurrence 5B_14:9563:6221: scene=5B_14
#: 5B_14:9563
msgctxt "text_id=6221 | speaker=unknown"
msgid "　それは別段、<軽蔑|けいべつ>する事でもなく。"
msgstr "  It was not anything particularly worthy of disdain."

#. Occurrence 5B_14:9570:6222: scene=5B_14
#: 5B_14:9570
msgctxt "text_id=6222 | speaker=unknown"
msgid "　それは格段、<禁忌|きんき>するものでもない。"
msgstr "  It was not even anything remarkably worthy of being called taboo."

#. Occurrence 5B_14:9617:6223: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0042; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:9617
msgctxt "text_id=6223 | speaker=aoko"
msgid "“―――っ、さい”"
msgstr "(...Shut up.)"

#. Occurrence 5B_14:9669:6224: scene=5B_14
#: 5B_14:9669
msgctxt "text_id=6224 | speaker=unknown"
msgid "　なのに、口から漏れた声は怒りだった。"
msgstr "  What escaped her lips now was rage."

#. Occurrence 5B_14:9674:6225: scene=5B_14
#: 5B_14:9674
msgctxt "text_id=6225 | speaker=unknown"
msgid "　赤い影はかすかに首をかしげる。"
msgstr "  Bewilderment from the red silhouette."

#. Occurrence 5B_14:9766:6226: scene=5B_14
#: 5B_14:9766
msgctxt "text_id=6226 | speaker=unknown"
msgid "　少女は声なき声で叫ぶ。"
msgstr "  The girl let out an inaudible scream."

#. Occurrence 5B_14:9829:6227: scene=5B_14
#: 5B_14:9829
msgctxt "text_id=6227 | speaker=unknown"
msgid "　魔法を使えば勝てる？　事情も知らないでよくも勝手な。"
msgstr "  Could True Magic truly be her savior? What an opportunistic load of bull."

#. Occurrence 5B_14:9834:6228: scene=5B_14
#: 5B_14:9834
msgctxt "text_id=6228 | speaker=unknown"
msgid "　だいたい、そもそも―――"
msgstr "  After all, to begin with..."

#. Occurrence 5B_14:9899:6229: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0043; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:9899
msgctxt "text_id=6229 | speaker=aoko"
msgid "“あんなの、どうやって使えってぇのよ―――！”"
msgstr "(I have no clue how to do that shit yet!)"

#. Occurrence 5B_14:9905:6230: scene=5B_14
#: 5B_14:9905
msgctxt "text_id=6230 | speaker=unknown"
msgid "　彼女には、その魔法とやらの有効な利用法が、どうにも思い当たらない―――！"
msgstr "  Indeed, Aoko was still in the dark when it came to that Magic, whatever it was."

#. Occurrence 5B_14:10518:6231: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0044; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:10518
msgctxt "text_id=6231 | speaker=aoko"
msgid "「―――って、バカか私……！」"
msgstr "\"...I'm such a moron!\""

#. Occurrence 5B_14:10524:6232: scene=5B_14
#: 5B_14:10524
msgctxt "text_id=6232 | speaker=unknown"
msgid "　一瞬の錯覚から目を覚ます。"
msgstr "  She woke from her momentary hallucination."

#. Occurrence 5B_14:10529:6233: scene=5B_14
#: 5B_14:10529
msgctxt "text_id=6233 | speaker=unknown"
msgid "　折れようとしていた心が見せた幻。"
msgstr "  The very illusion her breaking soul had shown her."

#. Occurrence 5B_14:10580:6234: scene=5B_14
#: 5B_14:10580
msgctxt "text_id=6234 | speaker=unknown"
msgid "　最低ラインの弱音が、逆に少女の<誇|ほこ>りに火をつけた。"
msgstr "  Whining had had the opposite effect on her; her pride was now ablaze."

#. Occurrence 5B_14:10616:6235: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_14_0003; voice_prefix=A30; voice_category=3; scene=5B_14
#: 5B_14:10616
msgctxt "text_id=6235 | speaker=soujuurou"
msgid "『―――逃げるのか？』"
msgstr "\"So you're going to run from this responsibility, too?\""

#. Occurrence 5B_14:10659:6236: scene=5B_14
#: 5B_14:10659
msgctxt "text_id=6236 | speaker=unknown"
msgid "　そうだ。自分は王手をかけられているが、それは相手も同じこと。なぜ負けているかは明白で、あとは対策を立てるだけ。それは十分に実行可能だ。"
msgstr "  Soujyuro was right. Her opponent had put her in check, but she had done the same to it. It was clear why she was losing, so now all she needed was a counter-plan, well within her abilities."

#. Occurrence 5B_14:10665:6237: scene=5B_14
#: 5B_14:10665
msgctxt "text_id=6237 | speaker=unknown"
msgid "たしかに無茶な話だけど、試す前から諦めるのは許されない。"
msgstr "No matter the odds, she was not one to give up without giving it one last shot."

#. Occurrence 5B_14:10781:6238: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0045; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:10781
msgctxt "text_id=6238 | speaker=aoko"
msgid "“……そうだ。"
msgstr "(That's right."

#. Occurrence 5B_14:10787:6239: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0046; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:10787
msgctxt "text_id=6239 | speaker=aoko"
msgid "　放りだすのは、やれる事を全部やってから……！”"
msgstr "  Giving up only comes after you've tried absolutely everything!)"

#. Occurrence 5B_14:10793:6240: scene=5B_14
#: 5B_14:10793
msgctxt "text_id=6240 | speaker=unknown"
msgid "　もう感覚さえ無い指を握りしめる。"
msgstr "  Her numbed fingers clenched into a tight fist."

#. Occurrence 5B_14:10798:6241: scene=5B_14
#: 5B_14:10798
msgctxt "text_id=6241 | speaker=unknown"
msgid "　思考に浮かんだ無理難題は、正気を疑う大博打だ。"
msgstr "  She was betting against the house, an unreasonable gamble that should have made her question her sanity."

#. Occurrence 5B_14:10803:6242: scene=5B_14
#: 5B_14:10803
msgctxt "text_id=6242 | speaker=unknown"
msgid "　はじめの一歩をコンマでも間違えれば、その時点で青子の体は蒸発する。"
msgstr "  If her first step was off by an inch, her body would be instantly vaporized."

#. Occurrence 5B_14:10835:6243: scene=5B_14
#: 5B_14:10835
msgctxt "text_id=6243 | speaker=unknown"
msgid "　ああ、でも―――"
msgstr "  But..."

#. Occurrence 5B_14:10872:6244: scene=5B_14
#: 5B_14:10872
msgctxt "text_id=6244 | speaker=unknown"
msgid "　彼女は、逃げなかった少年を知っている。"
msgstr "  She knew a boy who never fled."

#. Occurrence 5B_14:10969:6245: scene=5B_14
#: 5B_14:10969
msgctxt "text_id=6245 | speaker=unknown"
msgid "　絶体絶命の窮地なのにギリギリまで耐え続けた、ちっぽけでも輝ける、強い勇気を知っている。"
msgstr "  She knew of a steadfast courage that could shine its light, no matter how small, through any desperate situation."

#. Occurrence 5B_14:11073:6246: scene=5B_14
#: 5B_14:11073
msgctxt "text_id=6246 | speaker=unknown"
msgid "　そう。この敗北は自分だけの問題ではない。"
msgstr "  Yes. There was more than just herself to be concerned about."

#. Occurrence 5B_14:11078:6247: scene=5B_14
#: 5B_14:11078
msgctxt "text_id=6247 | speaker=unknown"
msgid "　あの氷が落ちれば遊園地そのものが倒壊する。"
msgstr "  If that ice fell, it would mean the destruction of the park in its entirety."

#. Occurrence 5B_14:11083:6248: scene=5B_14
#: 5B_14:11083
msgctxt "text_id=6248 | speaker=unknown"
msgid "　平気な顔で、命懸けの綱渡りをやり通した誰かさんの成果も無駄になる。"
msgstr "  Everything he had achieved, everything he had risked and dared and happily put his life on the line for, would all be for naught."

#. Occurrence 5B_14:11090:6249: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0047; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:11090
msgctxt "text_id=6249 | speaker=aoko"
msgid "“―――ほんと。"
msgstr "(...Really."

#. Occurrence 5B_14:11096:6250: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0048; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:11096
msgctxt "text_id=6250 | speaker=aoko"
msgid "　それじゃ、何のために意地を張ったか分からない……！”"
msgstr "  What possessed him to be so bullheaded!?)"

#. Occurrence 5B_14:11243:6251: scene=5B_14
#: 5B_14:11243
msgctxt "text_id=6251 | speaker=unknown"
msgid "　決意と自信は、それこそ<迸|はし>る電荷のように。"
msgstr "  Determination and confidence surged through her like electricity."

#. Occurrence 5B_14:11248:6252: scene=5B_14
#: 5B_14:11248
msgctxt "text_id=6252 | speaker=unknown"
msgid "　このまま氷に押しつぶされるのなんて願い下げ。"
msgstr "  She was in no mood to be crushed by a giant sheet of ice."

#. Occurrence 5B_14:11253:6253: scene=5B_14
#: 5B_14:11253
msgctxt "text_id=6253 | speaker=unknown"
msgid "　どうせ負けるのなら自滅がいい、と少女は笑った。"
msgstr "  If she was going to lose, she'd rather do so as the grandest firework possible."

#. Occurrence 5B_14:11258:6254: scene=5B_14
#: 5B_14:11258
msgctxt "text_id=6254 | speaker=unknown"
msgid "　負けず嫌いでご免あそばせ。こうなったらやられる前に、灰になるまで燃え尽きてやる―――！"
msgstr "  Aoko was a sore loser. At this point, she would rather burn herself to cinders than let it decide her end."

#. Occurrence 5B_14:11413:6255: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0049; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:11413
msgctxt "text_id=6255 | speaker=aoko"
msgid "「<接|チ><続|ェ><解|ン><除|ジ>―――<領|チ><域|ェ><拡|ン><大|ジ>、<再接続|チェンジ>―――！」"
msgstr "\"<Disconnect! Expand area! Reconnect!|Change, change, change!>\""

#. Occurrence 5B_14:11428:6256: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0050; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:11428
msgctxt "text_id=6256 | speaker=aoko"
msgid "“ぐ、つぅ―――！”"
msgstr "  She grunted in pain."

#. Occurrence 5B_14:11433:6257: scene=5B_14
#: 5B_14:11433
msgctxt "text_id=6257 | speaker=unknown"
msgid "　激流する体内魔力。"
msgstr "  Energy raged through her body."

#. Occurrence 5B_14:11438:6258: scene=5B_14
#: 5B_14:11438
msgctxt "text_id=6258 | speaker=unknown"
msgid "　分解寸前の魔術回路。"
msgstr "  Her circuits were on the verge of disintegration."

#. Occurrence 5B_14:11443:6259: scene=5B_14
#: 5B_14:11443
msgctxt "text_id=6259 | speaker=unknown"
msgid "　魔術をカタチにした刻印は皮膚や肉のみならず、骨の<髄|ずい>、骨の<芯|しん>までその文字を刻んでいく。"
msgstr "  Inscribed upon her body, her Magic Crest was magecraft given physical form. It did not, however, stop with simply skin and flesh. It burrowed to the very marrow of her bones."

#. Occurrence 5B_14:11578:6260: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0051; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:11578
msgctxt "text_id=6260 | speaker=aoko"
msgid "「は―――いっっ、つぅ…………！」"
msgstr "\"Grrr.... GAHAH!\""

#. Occurrence 5B_14:11586:6261: scene=5B_14
#: 5B_14:11586
msgctxt "text_id=6261 | speaker=unknown"
msgid "　口元に<諧謔|かいぎゃく>の笑みが浮かぶ。"
msgstr "  A playful smile graced her lips."

#. Occurrence 5B_14:11591:6262: scene=5B_14
#: 5B_14:11591
msgctxt "text_id=6262 | speaker=unknown"
msgid "　あまりの激痛に理性、基準が逆転した。"
msgstr "  Her sense of reason had been turned upside-down by the pain."

#. Occurrence 5B_14:11596:6263: scene=5B_14
#: 5B_14:11596
msgctxt "text_id=6263 | speaker=unknown"
msgid "　それも当然。"
msgstr "  That was only natural."

#. Occurrence 5B_14:11602:6264: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0052; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:11602
msgctxt "text_id=6264 | speaker=aoko"
msgid "“なんだ、やればできるじゃない私……！”"
msgstr "(Huh. I can do this!)"

#. Occurrence 5B_14:11607:6265: scene=5B_14
#: 5B_14:11607
msgctxt "text_id=6265 | speaker=unknown"
msgid "　極限を<迎|むか>えてまだ耐えている自分の体を、誉めてやらないでどうするのか―――！"
msgstr "  She had to praise her own body for holding out so long while pushed beyond its limits."

#. Occurrence 5B_14:11749:6266: scene=5B_14
#: 5B_14:11749
msgctxt "text_id=6266 | speaker=unknown"
msgid "　髑髏の面が異常に気付く。"
msgstr "  The skull face noticed the abnormality."

#. Occurrence 5B_14:11754:6267: scene=5B_14
#: 5B_14:11754
msgctxt "text_id=6267 | speaker=unknown"
msgid "　空間の支配率が拮抗している事を、彼はようやく観測した。"
msgstr "  It finally recognized the challenge for dominance over this space."

#. Occurrence 5B_14:11759:6268: scene=5B_14
#: 5B_14:11759
msgctxt "text_id=6268 | speaker=unknown"
msgid "　だがその慢心を笑えようか。"
msgstr "  It laughed at the conceit it faced."

#. Occurrence 5B_14:11764:6269: scene=5B_14
#: 5B_14:11764
msgctxt "text_id=6269 | speaker=unknown"
msgid "　千年を越える器物の王、フラットスナークに勝る“魔力使い”が、この末世の時代に現れるなど―――！"
msgstr "  Never did it expect a Magician to challenge the great Flat Snark, lord of vessels over a millennium, and in such an age of decline!"

#. Occurrence 5B_14:11858:6270: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0053; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:11858
msgctxt "text_id=6270 | speaker=aoko"
msgid "「ふ―――っ、うっ……！」"
msgstr "\"Hrrrgh... UGH!\""

#. Occurrence 5B_14:11864:6271: scene=5B_14
#: 5B_14:11864
msgctxt "text_id=6271 | speaker=unknown"
msgid "　呼吸を整える。"
msgstr "  She tried to catch her breath."

#. Occurrence 5B_14:11869:6272: scene=5B_14
#: 5B_14:11869
msgctxt "text_id=6272 | speaker=unknown"
msgid "　この後に来るであろう激痛に身構える。"
msgstr "  She braced herself for the coming pain."

#. Occurrence 5B_14:11874:6273: scene=5B_14
#: 5B_14:11874
msgctxt "text_id=6273 | speaker=unknown"
msgid "　<あ|・><の|・><氷|・><を|・><撃|・><ち|・><破|・><る|・>。"
msgstr "  She was going to smash that ice to pieces."

#. Occurrence 5B_14:11879:6274: scene=5B_14
#: 5B_14:11879
msgctxt "text_id=6274 | speaker=unknown"
msgid "　使用できる魔力量は同じ。"
msgstr "  Both had access to the same amount of magical energy."

#. Occurrence 5B_14:11884:6275: scene=5B_14
#: 5B_14:11884
msgctxt "text_id=6275 | speaker=unknown"
msgid "　なのに力負けしているのは、つまり―――"
msgstr "  One of them was greatly outmatched, but..."

#. Occurrence 5B_14:11998:6276: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0054; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:11998
msgctxt "text_id=6276 | speaker=aoko"
msgid "“……出力装置に差があった。魔力の吸飲、砲身の規模で負けているのなら。"
msgstr "(There was a difference in our output. If I'm losing because of the scale of energy absorption and the size of the barrel, then..."

#. Occurrence 5B_14:12004:6277: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0055; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:12004
msgctxt "text_id=6277 | speaker=aoko"
msgid "　単純な話、<術式|わたし>を<増築|でかく>するだけでいい―――！”"
msgstr "  The solution is simple. All I need to do is make the formula bigger, and me with it!)"

#. Occurrence 5B_14:12050:6278: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0056; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:12050
msgctxt "text_id=6278 | speaker=aoko"
msgid "「―――<再接続|チェンジ>、<魔弾|ツアー><形式|プラン>―――」"
msgstr "\"<Reconnect bullet configuration!|Change Tour Plan!>\""

#. Occurrence 5B_14:12275:6279: scene=5B_14
#: 5B_14:12275
msgctxt "text_id=6279 | speaker=unknown"
msgid "　フィードバックは今までの比ではないだろう。"
msgstr "  The feedback would go beyond anything she had experienced to date."

#. Occurrence 5B_14:12280:6280: scene=5B_14
#: 5B_14:12280
msgctxt "text_id=6280 | speaker=unknown"
msgid "　彼女の選択は単純にして、蛮勇きわまりない。"
msgstr "  Quite simply, her decision went beyond recklessness."

#. Occurrence 5B_14:12285:6281: scene=5B_14
#: 5B_14:12285
msgctxt "text_id=6281 | speaker=unknown"
msgid "　最大展開する二つの術式。"
msgstr "  She expanded both formulae to maximum size."

#. Occurrence 5B_14:12290:6282: scene=5B_14
#: 5B_14:12290
msgctxt "text_id=6282 | speaker=unknown"
msgid "　一層は巨大な渦と化して霧という霧を飲みこみ、"
msgstr "  The first layer would transform into a giant vortex, swallowing up the mist."

#. Occurrence 5B_14:12295:6283: scene=5B_14
#: 5B_14:12295
msgctxt "text_id=6283 | speaker=unknown"
msgid "　二層はかたっぱしから魔力を加工して<砲身|あおこ>に注ぎ込む。"
msgstr "  The second layer would process it from one end and pump it into her, the barrel."

#. Occurrence 5B_14:12425:6284: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0057; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:12425
msgctxt "text_id=6284 | speaker=aoko"
msgid "「―――私の想定が甘かった。"
msgstr "\"...I was naïve,"

#. Occurrence 5B_14:12431:6285: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0058; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:12431
msgctxt "text_id=6285 | speaker=aoko"
msgid "　撃ち落とす、なんてハンパもいいとこ。"
msgstr "  thinking I could do something cute like shoot it down."

#. Occurrence 5B_14:12437:6286: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0059; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:12437
msgctxt "text_id=6286 | speaker=aoko"
msgid "　この場合、跡形もなく<撃|・><ち|・><砕|・><く|・>、だっ……！」"
msgstr "  What I need to do is blast it to hell!\""

#. Occurrence 5B_14:12541:6287: scene=5B_14
#: 5B_14:12541
msgctxt "text_id=6287 | speaker=unknown"
msgid "　術者の確信に、太古の魔力が呼応する。"
msgstr "  Primeval power answered the spellcaster's conviction."

#. Occurrence 5B_14:12546:6288: scene=5B_14
#: 5B_14:12546
msgctxt "text_id=6288 | speaker=unknown"
msgid "　のたうち回る<大蛇|オロチ>の紋様。"
msgstr "  It formed the pattern of a writhing serpent."

#. Occurrence 5B_14:12551:6289: scene=5B_14
#: 5B_14:12551
msgctxt "text_id=6289 | speaker=unknown"
msgid "　反旗を<翻|ひるが>す声なき魔力。"
msgstr "  Voiceless magical power flew a banner of revolution."

#. Occurrence 5B_14:12682:6290: scene=5B_14
#: 5B_14:12682
msgctxt "text_id=6290 | speaker=unknown"
msgid "　さあ―――いざ地を<省|かえり>みよ<貴|たけ>き遺産。"
msgstr "  Now, look upon the earth, o venerable one."

#. Occurrence 5B_14:12687:6291: scene=5B_14
#: 5B_14:12687
msgctxt "text_id=6291 | speaker=unknown"
msgid "　あれなるは開拓の<最先端|トップランナー>。"
msgstr "  See now this pioneer, this first among trailblazers."

#. Occurrence 5B_14:12692:6292: scene=5B_14
#: 5B_14:12692
msgctxt "text_id=6292 | speaker=unknown"
msgid "　これより数多の神秘、あらゆる伝統を台無しにする、恐れ知らずの人類代表。"
msgstr "  She embodies a species that knows no fear, that renders naught all manner of Mystic and tradition."

#. Occurrence 5B_14:12830:6293: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0060; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:12830
msgctxt "text_id=6293 | speaker=aoko"
msgid "「貸し借りはここまでよ嘘つきブージャム。"
msgstr "\"I'm done borrowing from you, you lying boojum."

#. Occurrence 5B_14:12836:6294: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0061; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:12836
msgctxt "text_id=6294 | speaker=aoko"
msgid "　お望み通り、ノシをつけて返してあげる……！」"
msgstr "  If you really want it, I'm more than happy to give it all back!\""

#. Occurrence 5B_14:12842:6295: scene=5B_14
#: 5B_14:12842
msgctxt "text_id=6295 | speaker=unknown"
msgid "　消費／消滅の理を<担|にな>う、最新の魔法使い―――！"
msgstr "  For the newest Magician commands the principles of consumption and extinction!"

#. Occurrence 5B_14:13353:6296: scene=5B_14
#: 5B_14:13353
msgctxt "text_id=6296 | speaker=unknown"
msgid "　常識外の光弾が氷の城を融解させる。"
msgstr "  An aberrant bullet of light melted through the castle of ice."

#. Occurrence 5B_14:13358:6297: scene=5B_14
#: 5B_14:13358
msgctxt "text_id=6297 | speaker=unknown"
msgid "　砲身は焼ききれない。"
msgstr "  The barrel held fast."

#. Occurrence 5B_14:13479:6298: scene=5B_14
#: 5B_14:13479
msgctxt "text_id=6298 | speaker=unknown"
msgid "　彼女の魔力の扱いは神懸かっている。"
msgstr "  Her control of magical energy was divine."

#. Occurrence 5B_14:13484:6299: scene=5B_14
#: 5B_14:13484
msgctxt "text_id=6299 | speaker=unknown"
msgid "　最大十万キロ、赤道の二周半に相当する<血管|バイパス>は貪欲に魔力を受け入れ、倍の速度で魔弾を月へとたたき込む―――！"
msgstr "  One hundred thousand miles of veins, equal to two and a half times the circumference of the Earth, hungrily drank in the magical energy. The subsequent magical strike hurtled straight up at the moon."

#. Occurrence 5B_14:13666:6300: scene=5B_14
#: 5B_14:13666
msgctxt "text_id=6300 | speaker=unknown"
msgid "　否　否　否　否！"
msgstr "  NO NO NO NO!"

#. Occurrence 5B_14:13672:6301: scene=5B_14
#: 5B_14:13672
msgctxt "text_id=6301 | speaker=unknown"
msgid "　月面に死相が浮かぶ。"
msgstr "  Death rose from the moon's surface."

#. Occurrence 5B_14:13677:6302: scene=5B_14
#: 5B_14:13677
msgctxt "text_id=6302 | speaker=unknown"
msgid "　廃遊園地に響く、恐怖あるいは<憤怒|ふんぬ>の叫び。"
msgstr "  A cry of indignant terror echoed through the abandoned park."

#. Occurrence 5B_14:13682:6303: scene=5B_14
#: 5B_14:13682
msgctxt "text_id=6303 | speaker=unknown"
msgid "　幻想に生きるソレにとって、現実はかくもおぞましく<眼|まなこ>を焦がす。"
msgstr "  Reality was burned into the eyes of this creature of fantasy."

#. Occurrence 5B_14:13705:6304: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0062; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:13705
msgctxt "text_id=6304 | speaker=aoko"
msgid "「―――ハ」"
msgstr "\"...Hah.\""

#. Occurrence 5B_14:13711:6305: scene=5B_14
#: 5B_14:13711
msgctxt "text_id=6305 | speaker=unknown"
msgid "　その悪あがきに、彼女は勝利を確信した。"
msgstr "  To Aoko, its vain struggle was the taste of victory."

#. Occurrence 5B_14:13716:6306: scene=5B_14
#: 5B_14:13716
msgctxt "text_id=6306 | speaker=unknown"
msgid "　あまりにも無駄な魔力の使い方だ。"
msgstr "  Victory despite her absolute reckless use of magical energy."

#. Occurrence 5B_14:13721:6307: scene=5B_14
#: 5B_14:13721
msgctxt "text_id=6307 | speaker=unknown"
msgid "　<傾|かたむ>きだしていた魔力の天秤は、完全に彼女のもとへなだれこみ―――"
msgstr "  The energy scales had been tipped to their breaking point but nevertheless in her favor."

#. Occurrence 5B_14:13728:6308: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0063; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:13728
msgctxt "text_id=6308 | speaker=aoko"
msgid "「<魔弾形|　ツアープラン>式―――」"
msgstr "\"<Bullet configuration...|Tour Plan...>\""

#. Occurrence 5B_14:13774:6309: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0064; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:13774
msgctxt "text_id=6309 | speaker=aoko"
msgid "「<大月蝕|ブラックライト>、<収斂投|　スターボウ>射―――！"
msgstr "\"<Total eclipse, converge|Blacklight, Starbow!>!"

#. Occurrence 5B_14:13780:6310: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_14_0065; voice_prefix=A10; voice_category=1; scene=5B_14
#: 5B_14:13780
msgctxt "text_id=6310 | speaker=aoko"
msgid "　一気に、ブチ抜けぇーーーーーえ！！！！！」"
msgstr "  Tear it a new one!\""

#. Occurrence 5B_14:14342:6311: scene=5B_14
#: 5B_14:14342
msgctxt "text_id=6311 | speaker=unknown"
msgid "　砕く。砕く。砕く。砕く。"
msgstr "  Shatter. Shatter. Shatter. Shatter."

#. Occurrence 5B_14:14347:6312: scene=5B_14
#: 5B_14:14347
msgctxt "text_id=6312 | speaker=unknown"
msgid "　微塵と散る摩天楼。"
msgstr "  The skyscraper scattered into atomized dust."

#. Occurrence 5B_14:14352:6313: scene=5B_14
#: 5B_14:14352
msgctxt "text_id=6313 | speaker=unknown"
msgid "　決して届かぬと謳われ、多くの挑戦者を飲んだ絶望の島。"
msgstr "  The island, its unattainability extolled, had swallowed whole the despair of its many challengers."

#. Occurrence 5B_14:14470:6314: scene=5B_14
#: 5B_14:14470
msgctxt "text_id=6314 | speaker=unknown"
msgid "　その、人智<未踏|みとう>を誇った先にあるモノこそ―――"
msgstr "  Long had it proudly eluded mankind's intellect..."

#. Occurrence 5B_14:14551:6315: scene=5B_14
#: 5B_14:14551
msgctxt "text_id=6315 | speaker=unknown"
msgid "　破滅を叫ぶ紺碧の霧。"
msgstr "  Yet now, azure mist bemoaned its demise."

#. Occurrence 5B_14:14556:6316: scene=5B_14
#: 5B_14:14556
msgctxt "text_id=6316 | speaker=unknown"
msgid "　崩壊する絶氷の<天|ソ><蓋|ラ>。"
msgstr "  In the sky, the icy canopy crumbled."

#. Occurrence 5B_14:14562:6317: scene=5B_14
#: 5B_14:14562
msgctxt "text_id=6317 | speaker=unknown"
msgid "　スナーク<狩り|ハント>の魔弾は月を越えて。"
msgstr "  The Snark-hunting bullet jumped over the moon."

#. Occurrence 5B_14:14568:6318: scene=5B_14
#: 5B_14:14568
msgctxt "text_id=6318 | speaker=unknown"
msgid "　断末魔は<潮騒|しおさい>のように、御伽の国に響き渡り―――"
msgstr "  Its throes of death sounded like the roaring sea, reverberating across this fairy-tale land."

#. Occurrence 5B_14:14715:6319: scene=5B_14
#: 5B_14:14715
msgctxt "text_id=6319 | speaker=unknown"
msgid "　―――勝敗は、ここに決した。"
msgstr "  ...The battle was over."

#. Occurrence 5B_14:14721:6320: scene=5B_14
#: 5B_14:14721
msgctxt "text_id=6320 | speaker=unknown"
msgid "　濃霧は途絶え、砕かれた氷は地上に降ることなく霧散していく。"
msgstr "  The thick fog dissipated, and the shattered ice melted away before it hit the ground."

#. Occurrence 5B_14:14726:6321: scene=5B_14
#: 5B_14:14726
msgctxt "text_id=6321 | speaker=unknown"
msgid "　魔弾は敗因を悔やませる間もなく、玉座ごと夜の王を撃ち砕いた。"
msgstr "  A lethal bullet unseated the night king from his throne, affording him no time to grieve his loss."

#. Occurrence 5B_14:14747:6322: scene=5B_14
#: 5B_14:14747
msgctxt "text_id=6322 | speaker=unknown"
msgid "　月の油。"
msgstr "  The Oil of the Moon."

#. Occurrence 5B_14:14752:6323: scene=5B_14
#: 5B_14:14752
msgctxt "text_id=6323 | speaker=unknown"
msgid "　触れられぬもの、フラットスナーク。"
msgstr "  The Untouched―Flat Snark."

#. Occurrence 5B_14:14758:6324: scene=5B_14
#: 5B_14:14758
msgctxt "text_id=6324 | speaker=unknown"
msgid "　廃棄されたモノを蘇らせる一夜の夢は、自らの死をもって、悪夢に幕を下ろしたのだ。"
msgstr "  The dreamscape that had begun with its resurrection ended with its demise, drawing a close to the nightmare."

#. Occurrence 5B_15:103:6325: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_15_0000; voice_prefix=A10; voice_category=1; scene=5B_15
#: 5B_15:103
msgctxt "text_id=6325 | speaker=aoko"
msgid "「―――うわ。さすがに、無茶だわ」"
msgstr "\"...Oh man. I guess I kind of went overboard.\""

#. Occurrence 5B_15:153:6326: scene=5B_15
#: 5B_15:153
msgctxt "text_id=6326 | speaker=unknown"
msgid "　青子は倒れたまま夜空を見上げている。"
msgstr "  Flat on her back, Aoko looked up at the night sky."

#. Occurrence 5B_15:158:6327: scene=5B_15
#: 5B_15:158
msgctxt "text_id=6327 | speaker=unknown"
msgid "　体はもう指一本だって動かない。"
msgstr "  She lay there perfectly still, not able to move a single finger."

#. Occurrence 5B_15:163:6328: scene=5B_15
#: 5B_15:163
msgctxt "text_id=6328 | speaker=unknown"
msgid "　なんとか体を起こそうと力を入れてみたが、どこもかしこも悲鳴をあげている。"
msgstr "  When she tried, her whole body screamed out in agony."

#. Occurrence 5B_15:183:6329: scene=5B_15
#: 5B_15:183
msgctxt "text_id=6329 | speaker=unknown"
msgid "　魔力はすっからかんで、魔術刻印も停止していた。"
msgstr "  She was completely empty of magical energy, and her Magic Crest had come to a halt."

#. Occurrence 5B_15:188:6330: scene=5B_15
#: 5B_15:188
msgctxt "text_id=6330 | speaker=unknown"
msgid "　体力の回復……もとい、身体機能の完全回復には丸一日を要するだろう。"
msgstr "  She estimated that it would likely require a whole day to recover all her bodily functions."

#. Occurrence 5B_15:193:6331: scene=5B_15
#: 5B_15:193
msgctxt "text_id=6331 | speaker=unknown"
msgid "　情けない話だが、今は呼吸だけで精一杯。"
msgstr "  Sadly, all she could really do in that moment was take a breath."

#. Occurrence 5B_15:212:6332: scene=5B_15
#: 5B_15:212
msgctxt "text_id=6332 | speaker=unknown"
msgid "　反面、胸はかつてない達成感に満ちていた。"
msgstr "  At least her chest was swelling with pride."

#. Occurrence 5B_15:253:6333: scene=5B_15
#: 5B_15:253
msgctxt "text_id=6333 | speaker=unknown"
msgid "　なにしろ、あの“童話の怪物”のうち一体を真っ向から撃ち壊したのだ。"
msgstr "  She had gone toe to toe with a fairy-tale monster and had emerged victorious."

#. Occurrence 5B_15:258:6334: scene=5B_15
#: 5B_15:258
msgctxt "text_id=6334 | speaker=unknown"
msgid "　自分に有利な状況が続いただけ、とも言えるが、手も足もでなかった半年前に比べれば格段の進歩である。"
msgstr "  The battlefield conditions had favored her, it was true, but there was no denying that Aoko had come a long way in the last six months."

#. Occurrence 5B_15:332:6335: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_15_0001; voice_prefix=A10; voice_category=1; scene=5B_15
#: 5B_15:332
msgctxt "text_id=6335 | speaker=aoko"
msgid "“……それはそれとして、有珠には<謝|あやま>っとかないと。"
msgstr "(...Luck or not, I owe Alice an apology."

#. Occurrence 5B_15:338:6336: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_15_0002; voice_prefix=A10; voice_category=1; scene=5B_15
#: 5B_15:338
msgctxt "text_id=6336 | speaker=aoko"
msgid "　プロイって、壊したらそれっきりだものね”"
msgstr "  Once a Ploy's been broken, it's gone forever.)"

#. Occurrence 5B_15:344:6337: scene=5B_15
#: 5B_15:344
msgctxt "text_id=6337 | speaker=unknown"
msgid "　そう。フラットスナークはもう二度と現れない。"
msgstr "  Flat Snark would never again return to this world."

#. Occurrence 5B_15:349:6338: scene=5B_15
#: 5B_15:349
msgctxt "text_id=6338 | speaker=unknown"
msgid "　ロンドンの協会に売り出せば値の付かない超稀少品、"
msgstr "   It was an insanely rare item, so invaluable that it would have been impossible to price it for auction at the Association in London."

#. Occurrence 5B_15:354:6339: scene=5B_15
#: 5B_15:354
msgctxt "text_id=6339 | speaker=unknown"
msgid "　魔術世界の財産とまで言われる秘術を、青子は跡形もなくブッ壊してしまったのだ。"
msgstr "  Aoko had sent Alice's priceless treasure to oblivion."

#. Occurrence 5B_15:359:6340: scene=5B_15
#: 5B_15:359
msgctxt "text_id=6340 | speaker=unknown"
msgid "　なんというか、その場のノリと勢いで。"
msgstr "  Needless to say, things had gotten more than a little out of hand."

#. Occurrence 5B_15:398:6341: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_15_0003; voice_prefix=A10; voice_category=1; scene=5B_15
#: 5B_15:398
msgctxt "text_id=6341 | speaker=aoko"
msgid "“まあ、でも―――”"
msgstr "(Still...)"

#. Occurrence 5B_15:433:6342: scene=5B_15
#: 5B_15:433
msgctxt "text_id=6342 | speaker=unknown"
msgid "　お互い納得ずくの戦いだったから、有珠は文句ひとつ言わないだろう。"
msgstr "  They had both agreed to the fight, so Alice probably would not complain."

#. Occurrence 5B_15:438:6343: scene=5B_15
#: 5B_15:438
msgctxt "text_id=6343 | speaker=unknown"
msgid "　内心では不満いっぱいと思われるが、あの少女はそういう、自らの品格を落とす真似はしないのだ。"
msgstr "  Even if she was furious, she would never be so undignified as to show it."

#. Occurrence 5B_15:514:6344: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_15_0004; voice_prefix=A10; voice_category=1; scene=5B_15
#: 5B_15:514
msgctxt "text_id=6344 | speaker=aoko"
msgid "「っ―――」"
msgstr "\"Ugh...\""

#. Occurrence 5B_15:713:6345: scene=5B_15
#: 5B_15:713
msgctxt "text_id=6345 | speaker=unknown"
msgid "　安心から気が緩み、積み重なった疲労がなだれこむ。"
msgstr "  The second Aoko relaxed, her fatigue finally caught up with her."

#. Occurrence 5B_15:718:6346: scene=5B_15
#: 5B_15:718
msgctxt "text_id=6346 | speaker=unknown"
msgid "　失神じみた眠気を青子は理性で押しとどめた。"
msgstr "  She did everything in her power to fight off the overwhelming drowsiness."

#. Occurrence 5B_15:723:6347: scene=5B_15
#: 5B_15:723
msgctxt "text_id=6347 | speaker=unknown"
msgid "　体の中は細かい傷だらけだが、奇跡的に外傷はない。このまま<十分|じゅっぷん>も休んでいれば立ち上がる事ぐらいはできそうだ。"
msgstr "  Aside from a few minor internal injuries, her body was miraculously unscathed. She felt like she could probably stand up and dust herself off after a bit of rest."

#. Occurrence 5B_15:813:6348: scene=5B_15
#: 5B_15:813
msgctxt "text_id=6348 | speaker=unknown"
msgid "　夜空には、いまだ炎上する黄金の月。"
msgstr "  The golden moon continued to burn in the night sky."

#. Occurrence 5B_15:820:6349: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_15_0005; voice_prefix=A10; voice_category=1; scene=5B_15
#: 5B_15:820
msgctxt "text_id=6349 | speaker=aoko"
msgid "“正体は油だものね。そりゃあ、いつまでも燃え―――”"
msgstr "(Well, you are oil, after all. You could probably burn for―)"

#. Occurrence 5B_15:830:6350: scene=5B_15
#: 5B_15:830
msgctxt "text_id=6350 | speaker=unknown"
msgid "　<漠然|ばくぜん>と空を見ていた目が、<愕然|がくぜん>とした空白に切り替わる。"
msgstr "  Aoko's bleary eyes went wide in astonishment."

#. Occurrence 5B_15:850:6351: scene=5B_15
#: 5B_15:850
msgctxt "text_id=6351 | speaker=unknown"
msgid "　彼女は指一本動かない状態で、"
msgstr "  She was still unable to lift a finger."

#. Occurrence 5B_15:857:6352: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_15_0006; voice_prefix=A10; voice_category=1; scene=5B_15
#: 5B_15:857
msgctxt "text_id=6352 | speaker=aoko"
msgid "“……そっか。スナークを見つけたベイカーも、最後はいっしょに消えるんだっけ―――”"
msgstr "(Oh, right. The Baker who found the Snark disappeared along with it...)"

#. Occurrence 5B_15:1017:6353: scene=5B_15
#: 5B_15:1017
msgctxt "text_id=6353 | speaker=unknown"
msgid "　あーあ、と。"
msgstr "  She sighed in resignation."

#. Occurrence 5B_15:1022:6354: scene=5B_15
#: 5B_15:1022
msgctxt "text_id=6354 | speaker=unknown"
msgid "　最後の反撃で燃え尽きる、十秒後の<自分|みらい>を受け入れた。"
msgstr "  Aoko accepted that her final stand left her with only ten seconds before she burned to ash, too."

#. Occurrence 5B_15:1082:6355: scene=5B_15
#: 5B_15:1082
msgctxt "text_id=6355 | speaker=unknown"
msgid "　―――一方、そのちょっと前。"
msgstr "  Elsewhere, just a short moment prior..."

#. Occurrence 5B_15:1088:6356: scene=5B_15
#: 5B_15:1088
msgctxt "text_id=6356 | speaker=unknown"
msgid "　強風<荒|すさ>ぶ<鉄骨橋|コースター>の上で、難しい顔のまま、彼は地上に目をこらしていた。"
msgstr "  Buffeted by strong winds atop the roller coaster, Soujyuro gravely peered down at the ground."

#. Occurrence 5B_15:1150:6357: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0000; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:1150
msgctxt "text_id=6357 | speaker=soujuurou"
msgid "「―――むむ？」"
msgstr "\"...Hmm?\""

#. Occurrence 5B_15:1197:6358: scene=5B_15
#: 5B_15:1197
msgctxt "text_id=6358 | speaker=unknown"
msgid "　こぼれた呟きはこの上なく頼りない。"
msgstr "  All he could muster was a single murmur."

#. Occurrence 5B_15:1202:6359: scene=5B_15
#: 5B_15:1202
msgctxt "text_id=6359 | speaker=unknown"
msgid "　彼の視線の先。地上ではクリーチャーたちの目を盗んで地面に図形を刻んでいる青子の姿と―――"
msgstr "  He could see Aoko on top of some drawing on the ground, and..."

#. Occurrence 5B_15:1268:6360: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0001; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:1268
msgctxt "text_id=6360 | speaker=soujuurou"
msgid "「……なんだアレ。いくらなんでも頑丈すぎないか？」"
msgstr "\"...What in the world is that thing made of?\""

#. Occurrence 5B_15:1274:6361: scene=5B_15
#: 5B_15:1274
msgctxt "text_id=6361 | speaker=unknown"
msgid "　そのずっと向こう。"
msgstr "  In the distance..."

#. Occurrence 5B_15:1279:6362: scene=5B_15
#: 5B_15:1279
msgctxt "text_id=6362 | speaker=unknown"
msgid "　倒壊したミラーハウスの方角に、何か、見覚えのあるモノを見た気がした。"
msgstr "  There was something familiar in the direction of the ruined house of mirrors."

#. Occurrence 5B_15:1299:6363: scene=5B_15
#: 5B_15:1299
msgctxt "text_id=6363 | speaker=unknown"
msgid "　草十郎の役割……地上六十メートルの高みから青子の髪を投げる、という仕事は終わっている。"
msgstr "  Soujyuro's job―to throw Aoko's hair from a great height―was complete."

#. Occurrence 5B_15:1304:6364: scene=5B_15
#: 5B_15:1304
msgctxt "text_id=6364 | speaker=unknown"
msgid "　派手さこそないが、掛け値無しで命がけの難行だった。"
msgstr "  While not the most impressive of tasks, it was absolutely a matter of life or death."

#. Occurrence 5B_15:1381:6365: scene=5B_15
#: 5B_15:1381
msgctxt "text_id=6365 | speaker=unknown"
msgid "　さらに付け加えるのなら、この後どうやって下りるのかを考えるだけで目眩がする。"
msgstr "  And to top it all off, just thinking about how he was going to get back down to the ground was making him dizzy."

#. Occurrence 5B_15:1386:6366: scene=5B_15
#: 5B_15:1386
msgctxt "text_id=6366 | speaker=unknown"
msgid "　これ以上の厄介事なんて、とてもじゃないが頷けない。"
msgstr "  He had experienced more than enough trouble for one day."

#. Occurrence 5B_15:1422:6367: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0002; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:1422
msgctxt "text_id=6367 | speaker=soujuurou"
msgid "「―――いや、でも、アレ―――」"
msgstr "\"Wait, but...\""

#. Occurrence 5B_15:1717:6368: scene=5B_15
#: 5B_15:1717
msgctxt "text_id=6368 | speaker=unknown"
msgid "　ぐらぐら揺れる橋の上で、わたわたと取り乱す。"
msgstr "  He was flustered as he stood atop the swaying bridge."

#. Occurrence 5B_15:1903:6369: scene=5B_15
#: 5B_15:1903
msgctxt "text_id=6369 | speaker=unknown"
msgid "　空には前触れなく現れた髑髏の面。"
msgstr "  A skull suddenly appeared in the sky above."

#. Occurrence 5B_15:1926:6370: scene=5B_15
#: 5B_15:1926
msgctxt "text_id=6370 | speaker=unknown"
msgid "　地上にはぐるんぐるん回転している青い光と、その中心にいる蒼崎青子。"
msgstr "  On the ground, he could see a circling blue light with Aoko Aozaki in the middle of it."

#. Occurrence 5B_15:1980:6371: scene=5B_15
#: 5B_15:1980
msgctxt "text_id=6371 | speaker=unknown"
msgid "　……そしてもう一つ。"
msgstr "  ...And one more thing."

#. Occurrence 5B_15:1985:6372: scene=5B_15
#: 5B_15:1985
msgctxt "text_id=6372 | speaker=unknown"
msgid "　この位置にいる草十郎にしか知り得ないヒト影が、月に挑む青子へと迫っていた。"
msgstr "  From an angle that only Soujyuro could see, a shadow stalked Aoko while she challenged the moon."

#. Occurrence 5B_15:2048:6373: scene=5B_15
#: 5B_15:2048
msgctxt "text_id=6373 | speaker=unknown"
msgid "　その影には下半身がない。"
msgstr "  It was shaped like a person missing the lower half of its body."

#. Occurrence 5B_15:2053:6374: scene=5B_15
#: 5B_15:2053
msgctxt "text_id=6374 | speaker=unknown"
msgid "　上半身だけの体で、ずるずると青子に近づいている。"
msgstr "  The disembodied torso slowly clawed its way toward Aoko."

#. Occurrence 5B_15:2058:6375: scene=5B_15
#: 5B_15:2058
msgctxt "text_id=6375 | speaker=unknown"
msgid "　距離的にはあと二百メートルほど。"
msgstr "  They were still over six hundred feet apart."

#. Occurrence 5B_15:2063:6376: scene=5B_15
#: 5B_15:2063
msgctxt "text_id=6376 | speaker=unknown"
msgid "　不運な事に、青子の背後から<這|・><っ|・><て|・><き|・><て|・>いるため、彼女はその影に気付けない。"
msgstr "  Unfortunately for Aoko, she completely failed to notice it approaching from behind."

#. Occurrence 5B_15:2087:6377: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0003; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:2087
msgctxt "text_id=6377 | speaker=soujuurou"
msgid "「―――遠くて見えないけど、アレは―――」"
msgstr "\"It's too far away to make out, but...isn't that...\""

#. Occurrence 5B_15:2100:6378: scene=5B_15
#: 5B_15:2100
msgctxt "text_id=6378 | speaker=unknown"
msgid "　間違いない。"
msgstr "  He was sure of what it was now."

#. Occurrence 5B_15:2105:6379: scene=5B_15
#: 5B_15:2105
msgctxt "text_id=6379 | speaker=unknown"
msgid "　この遊園地において、草十郎ではなく青子を狙うのは<あ|・><の|・><人|・><形|・>だけなのだから。"
msgstr "  There was only one thing in the park that would chase Aoko and not him: the puppet."

#. Occurrence 5B_15:2161:6380: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0004; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:2161
msgctxt "text_id=6380 | speaker=soujuurou"
msgid "「いや、でも。ほら、あるいは、ひょっとして―――"
msgstr "\"But... I mean, maybe it's..."

#. Occurrence 5B_15:2161:6381: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0004; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:2161
msgctxt "text_id=6381 | speaker=soujuurou"
msgid "　ただの偶然、ではないだろうか」"
msgstr "  ...a coincidence, right?\""

#. Occurrence 5B_15:2178:6382: scene=5B_15
#: 5B_15:2178
msgctxt "text_id=6382 | speaker=unknown"
msgid "　幾重にも交錯し、混乱する思考。"
msgstr "  His mind ran in circles."

#. Occurrence 5B_15:2183:6383: scene=5B_15
#: 5B_15:2183
msgctxt "text_id=6383 | speaker=unknown"
msgid "　それも無理からぬ事だろう。"
msgstr "  It was a perfectly reasonable reaction."

#. Occurrence 5B_15:2188:6384: scene=5B_15
#: 5B_15:2188
msgctxt "text_id=6384 | speaker=unknown"
msgid "　膨張した月と<光弾|ビーム>を撃ちまくってる少女、という状況だけで、草十郎的には目を疑う状況なのだ。"
msgstr "  Any grip on reality he might have had left was long lost when Aoko started firing beams of light at the monstrous moon."

#. Occurrence 5B_15:2470:6385: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0005; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:2470
msgctxt "text_id=6385 | speaker=soujuurou"
msgid "「うわぁ……！」"
msgstr "\"Whoa!\""

#. Occurrence 5B_15:2476:6386: scene=5B_15
#: 5B_15:2476
msgctxt "text_id=6386 | speaker=unknown"
msgid "　青子の容赦のない超距離魔弾は、嵐のようにコースターを揺さぶっていく。"
msgstr "  Aoko's merciless fire buffeted the roller coaster like a storm."

#. Occurrence 5B_15:2481:6387: scene=5B_15
#: 5B_15:2481
msgctxt "text_id=6387 | speaker=unknown"
msgid "　立っているだけで振り落とされ、転落死しかねない。"
msgstr "  Just standing on it was almost enough for him to be thrown off and killed."

#. Occurrence 5B_15:2607:6388: scene=5B_15
#: 5B_15:2607
msgctxt "text_id=6388 | speaker=unknown"
msgid "　とにかく、この状況は草十郎には難しすぎる。"
msgstr "  At any rate, Soujyuro couldn't fathom the situation."

#. Occurrence 5B_15:2612:6389: scene=5B_15
#: 5B_15:2612
msgctxt "text_id=6389 | speaker=unknown"
msgid "　ここからコースターの入り口まで戻って青子に注意を<促|うなが>しに行くか？"
msgstr "  Should he head back to the entrance of the roller coaster and warn Aoko about the incoming threat?"

#. Occurrence 5B_15:2618:6390: scene=5B_15
#: 5B_15:2618
msgctxt "text_id=6390 | speaker=unknown"
msgid "　いや、間に合うハズもなし、駆け下りたところで入り口には大量の焼きたてパンがいる。"
msgstr "  No, there was no way he would make it in time, and to make matters worse, there was a horde of bread down there, waiting for him."

#. Occurrence 5B_15:2623:6391: scene=5B_15
#: 5B_15:2623
msgctxt "text_id=6391 | speaker=unknown"
msgid "　そもそも青子は人形に気付いていて、近づいたとたん一撃で倒す可能性もある。その場合、自慢じゃないが足を引っ張る自信すらある草十郎だった。"
msgstr "  And it may very well have been the case that Aoko was already aware of the puppet and would take it out as soon as it got closer. If she was, Soujyuro was sure he would only be in the way."

#. Occurrence 5B_15:2884:6392: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0006; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:2884
msgctxt "text_id=6392 | speaker=soujuurou"
msgid "「っ………………」"
msgstr "\"But...\""

#. Occurrence 5B_15:2890:6393: scene=5B_15
#: 5B_15:2890
msgctxt "text_id=6393 | speaker=unknown"
msgid "　何を選んでも役に立てそうにない状況。"
msgstr "  It did not seem like there was anything he could do to help."

#. Occurrence 5B_15:2895:6394: scene=5B_15
#: 5B_15:2895
msgctxt "text_id=6394 | speaker=unknown"
msgid "　第一、危険なのは青子だけでなく、草十郎も窮地に立っている。"
msgstr "  And beyond that, Aoko was not the only one in danger. He was in quite a predicament himself."

#. Occurrence 5B_15:2931:6395: scene=5B_15
#: 5B_15:2931
msgctxt "text_id=6395 | speaker=unknown"
msgid "『行きは良い良い帰りは怖い』"
msgstr "\"You can't go home again.\""

#. Occurrence 5B_15:2986:6396: scene=5B_15
#: 5B_15:2986
msgctxt "text_id=6396 | speaker=unknown"
msgid "　帰り道に鬼が待っているのは都会であろうと山奥であろうと同じこと。"
msgstr "  The road home was never as safe as one thought. It was as true here as it had been in the mountains."

#. Occurrence 5B_15:2991:6397: scene=5B_15
#: 5B_15:2991
msgctxt "text_id=6397 | speaker=unknown"
msgid "　この道は特に顕著だ。行きはもちろん、帰り道も危険すぎる。"
msgstr "  The path he was on was no exception. As risky as the ascent had been, it was even more dangerous to go back down."

#. Occurrence 5B_15:2997:6398: scene=5B_15
#: 5B_15:2997
msgctxt "text_id=6398 | speaker=unknown"
msgid "<他|ひ><人|と>の事を心配する余裕はどこにもない。"
msgstr "This was no time to be worrying about others."

#. Occurrence 5B_15:3002:6399: scene=5B_15
#: 5B_15:3002
msgctxt "text_id=6399 | speaker=unknown"
msgid "　地上六十メートルの死の淵にいる事を忘れるな、と草十郎は震える足に言い聞かせる。"
msgstr "  His shaking legs reminded him that only two hundred feet separated him from death."

#. Occurrence 5B_15:3023:6400: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0007; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:3023
msgctxt "text_id=6400 | speaker=soujuurou"
msgid "“……大丈夫、それは分かっている。けど―――”"
msgstr "(I'll be fine. I know that. Just...)"

#. Occurrence 5B_15:3028:6401: scene=5B_15
#: 5B_15:3028
msgctxt "text_id=6401 | speaker=unknown"
msgid "　キリキリと頭が痛む。"
msgstr "  His head was pounding."

#. Occurrence 5B_15:3033:6402: scene=5B_15
#: 5B_15:3033
msgctxt "text_id=6402 | speaker=unknown"
msgid "　無謀である事も、馬鹿げた事なのも分かっている。"
msgstr "  This was reckless and stupid."

#. Occurrence 5B_15:3039:6403: scene=5B_15
#: 5B_15:3039
msgctxt "text_id=6403 | speaker=unknown"
msgid "山奥育ちの彼は、都会の誰よりも危険に関して敏感で、これからするコトを考えるだけで緊張で喉が嗄れきってしまう。"
msgstr "Having been raised in the mountains, he was more sensitive to danger than anyone raised in the city, and just thinking about what he was about to do made his throat seize up."

#. Occurrence 5B_15:3044:6404: scene=5B_15
#: 5B_15:3044
msgctxt "text_id=6404 | speaker=unknown"
msgid "　が、そんな草十郎でもはっきりと言えることは、"
msgstr "  There was only one thing he could say for sure."

#. Occurrence 5B_15:3054:6405: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0008; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:3054
msgctxt "text_id=6405 | speaker=soujuurou"
msgid "「蒼崎のことだ、アレにぜったい気付いていない……！」"
msgstr "\"Aozaki has no idea that thing is coming for her!\""

#. Occurrence 5B_15:3186:6406: scene=5B_15
#: 5B_15:3186
msgctxt "text_id=6406 | speaker=unknown"
msgid "　<半|なか>ば泣くような声をあげて、草十郎は高さ六十メートルの鉄骨を駆け下りだした。"
msgstr "  With a sobbing shout, Soujyuro started making his way down the two-hundred-foot frame of the roller coaster."

#. Occurrence 5B_15:3290:6407: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0009; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:3290
msgctxt "text_id=6407 | speaker=soujuurou"
msgid "「はっ、はっ、はぁ、はっ―――！」"
msgstr "\"Hah... hah... hah... haaa!\""

#. Occurrence 5B_15:3296:6408: scene=5B_15
#: 5B_15:3296
msgctxt "text_id=6408 | speaker=unknown"
msgid "　死の道行きを加速する。"
msgstr "  His race toward death accelerated."

#. Occurrence 5B_15:3301:6409: scene=5B_15
#: 5B_15:3301
msgctxt "text_id=6409 | speaker=unknown"
msgid "　加速するつもりはなくとも、下り坂である以上スピードは増していく。"
msgstr "  He never meant to speed up, but the downward slope propelled him forward."

#. Occurrence 5B_15:3436:6410: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0010; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:3436
msgctxt "text_id=6410 | speaker=soujuurou"
msgid "「っ、この、はっ、よっと―――！」"
msgstr "\"Here... I... go!\""

#. Occurrence 5B_15:3442:6411: scene=5B_15
#: 5B_15:3442
msgctxt "text_id=6411 | speaker=unknown"
msgid "　が、後悔はもう遅い。走りだしたのならもっと早く。"
msgstr "  It was too late for regrets. Now that he was running, he had no choice but to go even faster."

#. Occurrence 5B_15:3448:6412: scene=5B_15
#: 5B_15:3448
msgctxt "text_id=6412 | speaker=unknown"
msgid "なにしろホントに時間がない、今から全力で下りても間に合わない、ああでもそれより、コースターの出口にはブレッドマンたちで混雑中、"
msgstr "And time was not on his side―he would never make it in time if he took the long way down, never mind the bread-men crowding the exit of the roller coaster."

#. Occurrence 5B_15:3454:6413: scene=5B_15
#: 5B_15:3454
msgctxt "text_id=6413 | speaker=unknown"
msgid "となれば遅いも早いも結果は同じ、どのみち出口が塞がっている。急げ急げと必死になって、一歩ごとに落ちかける必要性とかまったくない……！"
msgstr "With the exits blocked, the outcome would be the same whether he went slowly or quickly. There was no reason to rush to his death as desperately as he did!"

#. Occurrence 5B_15:3562:6414: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0011; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:3562
msgctxt "text_id=6414 | speaker=soujuurou"
msgid "「っ、だから！？」"
msgstr "\"So what!?\""

#. Occurrence 5B_15:3568:6415: scene=5B_15
#: 5B_15:3568
msgctxt "text_id=6415 | speaker=unknown"
msgid "　それがどうしたと。"
msgstr "  So what if it was futile?"

#. Occurrence 5B_15:3573:6416: scene=5B_15
#: 5B_15:3573
msgctxt "text_id=6416 | speaker=unknown"
msgid "　ごちゃついた<煩悶|はんもん>を、彼は一太刀で切り払った。"
msgstr "  Soujyuro cleared the doubts from his mind."

#. Occurrence 5B_15:3578:6417: scene=5B_15
#: 5B_15:3578
msgctxt "text_id=6417 | speaker=unknown"
msgid "　自分にできる事は足下に意識を集中して、一秒でも早く駆け下りるだけ。"
msgstr "  He turned his attention to what he could do: keep his footing and try to arrive at the bottom as quickly as he could."

#. Occurrence 5B_15:3720:6418: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0012; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:3720
msgctxt "text_id=6418 | speaker=soujuurou"
msgid "“間違えるな。いま大事なのは、間に合うとか助けられるとか、そういう結果の話じゃなくて―――”"
msgstr "(Focus! Forget whether you'll be there in time to save her! The most important thing is...)"

#. Occurrence 5B_15:3726:6419: scene=5B_15
#: 5B_15:3726
msgctxt "text_id=6419 | speaker=unknown"
msgid "　ある衝動が、縮こまった手足を駆動させる。"
msgstr "  He had no idea what impulses were driving his stiff limbs."

#. Occurrence 5B_15:3731:6420: scene=5B_15
#: 5B_15:3731
msgctxt "text_id=6420 | speaker=unknown"
msgid "　渇ききった喉を、冷め切った<理屈|こころ>を、草十郎は“思いつき”だけで心の端っこに蹴り飛ばす。"
msgstr "  He just focused on the moment, pushing past the fear and the cold logic."

#. Occurrence 5B_15:3736:6421: scene=5B_15
#: 5B_15:3736
msgctxt "text_id=6421 | speaker=unknown"
msgid "　根が単純な人間の面目躍如、とにかく難しいコトは終わってから考える―――！"
msgstr "  At his core, he was the kind of person to deal with problems head-on. There would be time to think about the consequences later!"

#. Occurrence 5B_15:3889:6422: scene=5B_15
#: 5B_15:3889
msgctxt "text_id=6422 | speaker=unknown"
msgid "　だが、障害は縮こまる自分だけではない。"
msgstr "  But hesitation was not his only obstacle."

#. Occurrence 5B_15:3895:6423: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0013; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:3895
msgctxt "text_id=6423 | speaker=soujuurou"
msgid "「こんな時に―――！」"
msgstr "\"Not now!\""

#. Occurrence 5B_15:3900:6424: scene=5B_15
#: 5B_15:3900
msgctxt "text_id=6424 | speaker=unknown"
msgid "　レールに集中していなければ落ちる状況で、最悪の邪魔者が出現する。"
msgstr "  The worst possible hindrance appeared at a time when not focusing on the track would mean certain death."

#. Occurrence 5B_15:3998:6425: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0014; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:3998
msgctxt "text_id=6425 | speaker=soujuurou"
msgid "「！」"
msgstr "\"!\""

#. Occurrence 5B_15:4003:6426: scene=5B_15
#: 5B_15:4003
msgctxt "text_id=6426 | speaker=unknown"
msgid "　一見いままで通りの卵に違和感を覚える草十郎。"
msgstr "  Soujyuro sensed something wrong with the egg he had been so studiously observing out of one eye."

#. Occurrence 5B_15:4008:6427: scene=5B_15
#: 5B_15:4008
msgctxt "text_id=6427 | speaker=unknown"
msgid "　何が変わっているのか。"
msgstr "  Something had changed."

#. Occurrence 5B_15:4013:6428: scene=5B_15
#: 5B_15:4013
msgctxt "text_id=6428 | speaker=unknown"
msgid "　その変化に気付いた瞬間、"
msgstr "  And at the very moment he realized it..."

#. Occurrence 5B_15:4103:6429: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0015; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:4103
msgctxt "text_id=6429 | speaker=soujuurou"
msgid "「って、よそ見してる場合じゃない……！」"
msgstr "\"I can't be looking to the side right now!\""

#. Occurrence 5B_15:4123:6430: scene=5B_15
#: 5B_15:4123
msgctxt "text_id=6430 | speaker=unknown"
msgid "　踏み<外|はず>しかけた足を本能で持ち直す。"
msgstr "  Soujyuro stumbled then instinctively caught himself."

#. Occurrence 5B_15:4128:6431: scene=5B_15
#: 5B_15:4128
msgctxt "text_id=6431 | speaker=unknown"
msgid "　まだ落ちていない事が奇跡だった。"
msgstr "  It was a miracle he had not fallen."

#. Occurrence 5B_15:4133:6432: scene=5B_15
#: 5B_15:4133
msgctxt "text_id=6432 | speaker=unknown"
msgid "　コースターを駆け下りるのは自殺行為そのものだった。"
msgstr "  Descending a roller coaster on foot was an act of suicide."

#. Occurrence 5B_15:4201:6433: scene=5B_15
#: 5B_15:4201
msgctxt "text_id=6433 | speaker=unknown"
msgid "　卵はぴったりと並走し、隙あらば体当たりでもしてきそうな<剣呑|けんのん>さ。"
msgstr "  The egg stayed right by his side―so close it was likely it would collide with him."

#. Occurrence 5B_15:4207:6434: scene=5B_15
#: 5B_15:4207
msgctxt "text_id=6434 | speaker=unknown"
msgid "オマケにあまり直視したくないが、内部に作られた扉らしき飾りが、少しずつ開こうとしているのも気になりすぎる。"
msgstr "Though he was trying not to look at it, he could not help but feel uneasy that the door-like decoration in its center was gradually opening."

#. Occurrence 5B_15:4320:6435: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0016; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:4320
msgctxt "text_id=6435 | speaker=soujuurou"
msgid "「ああもう、畜生！　なんだって、こんな―――！」"
msgstr "\"Dammit! Why now!?\""

#. Occurrence 5B_15:4326:6436: scene=5B_15
#: 5B_15:4326
msgctxt "text_id=6436 | speaker=unknown"
msgid "　あまりにもどん詰まりな状況に悪態をつく。"
msgstr "  He cursed his rotten situation."

#. Occurrence 5B_15:4331:6437: scene=5B_15
#: 5B_15:4331
msgctxt "text_id=6437 | speaker=unknown"
msgid "　それでも足は緩めない。"
msgstr "  And yet, he refused to slow down."

#. Occurrence 5B_15:4337:6438: scene=5B_15
#: 5B_15:4337
msgctxt "text_id=6438 | speaker=unknown"
msgid "むしろ速度をより増して、彼は並走する卵を睨みつける。"
msgstr "He ran even faster, glaring at the egg on his side."

#. Occurrence 5B_15:4465:6439: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0017; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:4465
msgctxt "text_id=6439 | speaker=soujuurou"
msgid "「ハ―――ほんと、おかしい。"
msgstr "\"Hah... This is crazy."

#. Occurrence 5B_15:4471:6440: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0018; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:4471
msgctxt "text_id=6440 | speaker=soujuurou"
msgid "　こんな状況なのに、何で―――」"
msgstr "  What's wrong with me?\""

#. Occurrence 5B_15:4477:6441: scene=5B_15
#: 5B_15:4477
msgctxt "text_id=6441 | speaker=unknown"
msgid "　自分は笑っているのだろう、と草十郎は不思議に思った。"
msgstr "  Soujyuro was baffled to find that he was smiling."

#. Occurrence 5B_15:4482:6442: scene=5B_15
#: 5B_15:4482
msgctxt "text_id=6442 | speaker=unknown"
msgid "　青子のおまじないとやらの効果……なのかどうか、草十郎には判別できない。"
msgstr "  Perhaps it had something to do with Aoko's charm. Soujyuro could not tell one way or the other."

#. Occurrence 5B_15:4527:6443: scene=5B_15
#: 5B_15:4527
msgctxt "text_id=6443 | speaker=unknown"
msgid "　彼女の指の感触は、まだ肌に残っている。"
msgstr "  He could still feel Aoko's fingers on his skin."

#. Occurrence 5B_15:4569:6444: scene=5B_15
#: 5B_15:4569
msgctxt "text_id=6444 | speaker=unknown"
msgid "　向けられた信頼も期待も、しっかりと胸に<覚|おぼ>えている。"
msgstr "  The trust and expectation she had placed in him was etched into his heart."

#. Occurrence 5B_15:4574:6445: scene=5B_15
#: 5B_15:4574
msgctxt "text_id=6445 | speaker=unknown"
msgid "　……けれど、この衝動はそれらとは違うものだ。"
msgstr "  But what spurred him on was something entirely different."

#. Occurrence 5B_15:4662:6446: scene=5B_15
#: 5B_15:4662
msgctxt "text_id=6446 | speaker=unknown"
msgid "　この高揚は、もっと深層にある問題。"
msgstr "  This all stemmed from a much deeper problem."

#. Occurrence 5B_15:4667:6447: scene=5B_15
#: 5B_15:4667
msgctxt "text_id=6447 | speaker=unknown"
msgid "　今の彼には分からない、いずれ向き合う事になる、埋められるべきがらんどう。"
msgstr "  It was something inside him that he could not understand at the time, but would eventually come to terms with one day."

#. Occurrence 5B_15:4715:6448: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0019; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:4715
msgctxt "text_id=6448 | speaker=soujuurou"
msgid "「よし―――距離は、今なら二メートル、弱……！」"
msgstr "\"All right, less than five feet left!\""

#. Occurrence 5B_15:4770:6449: scene=5B_15
#: 5B_15:4770
msgctxt "text_id=6449 | speaker=unknown"
msgid "　死のレールを走りながら、草十郎は正確に距離を<測|はか>る。"
msgstr "  He carefully judged the distance as he ran down the track of death."

#. Occurrence 5B_15:4775:6450: scene=5B_15
#: 5B_15:4775
msgctxt "text_id=6450 | speaker=unknown"
msgid "　何との？"
msgstr "  But the distance between what?"

#. Occurrence 5B_15:4780:6451: scene=5B_15
#: 5B_15:4780
msgctxt "text_id=6451 | speaker=unknown"
msgid "　言うまでもない。この状況でたったひとつ、死の結末を飛び越える大一番との。"
msgstr "  That went without saying. It was the distance between himself and the one thing that could save his life."

#. Occurrence 5B_15:4877:6452: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0020; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:4877
msgctxt "text_id=6452 | speaker=soujuurou"
msgid "「はっ―――はっ、はっは、はっ！」"
msgstr "\"Hah... Hah! Haha! Hah...!\""

#. Occurrence 5B_15:4883:6453: scene=5B_15
#: 5B_15:4883
msgctxt "text_id=6453 | speaker=unknown"
msgid "　乱れる呼吸に合わせて、“行くぞ、行くぞ”とハッパをかける。"
msgstr "  He told himself he was going to do it, over and over, like a mantra."

#. Occurrence 5B_15:4890:6454: scene=5B_15
#: 5B_15:4890
msgctxt "text_id=6454 | speaker=unknown"
msgid "　本当にありえない。"
msgstr "  Soujyuro could not believe himself."

#. Occurrence 5B_15:4895:6455: scene=5B_15
#: 5B_15:4895
msgctxt "text_id=6455 | speaker=unknown"
msgid "　自分は馬鹿げた事をしようとしている。"
msgstr "  What he was about to do was incredibly stupid."

#. Occurrence 5B_15:4900:6456: scene=5B_15
#: 5B_15:4900
msgctxt "text_id=6456 | speaker=unknown"
msgid "　でも<そ|・><う|・><し|・><な|・><け|・><れ|・><ば|・><間|・><に|・><合|・><わ|・><な|・><い|・>、と気付いたのだからしようがない！"
msgstr "  But what is stupid when smart is not an option?"

#. Occurrence 5B_15:5004:6457: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0021; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:5004
msgctxt "text_id=6457 | speaker=soujuurou"
msgid "「ほんと―――なんで、そこまでやるんだ！？」"
msgstr "\"I'm really going to do this!? This is insane!\""

#. Occurrence 5B_15:5010:6458: scene=5B_15
#: 5B_15:5010
msgctxt "text_id=6458 | speaker=unknown"
msgid "　今さらな自問自答を、彼は鼻で笑った。"
msgstr "  Amidst it all, he laughed at how pointless such self-reflection was now."

#. Occurrence 5B_15:5015:6459: scene=5B_15
#: 5B_15:5015
msgctxt "text_id=6459 | speaker=unknown"
msgid "　一時的な混乱。極限状態における精神の高揚が、彼の心を裸にする。"
msgstr "  Temporary confusion, a psychological thrill ride; both had laid his soul bare."

#. Occurrence 5B_15:5114:6460: scene=5B_15
#: 5B_15:5114
msgctxt "text_id=6460 | speaker=unknown"
msgid "　大事なものは何なのか。"
msgstr "  What really mattered in life?"

#. Occurrence 5B_15:5119:6461: scene=5B_15
#: 5B_15:5119
msgctxt "text_id=6461 | speaker=unknown"
msgid "　そんなもの、シンプルな彼には考えるまでもない。"
msgstr "  The answer to that question was simple."

#. Occurrence 5B_15:5124:6462: scene=5B_15
#: 5B_15:5124
msgctxt "text_id=6462 | speaker=unknown"
msgid "　成功も報酬も、原始の心には美味しそうには映らない。"
msgstr "  His primitive values did not crave success or reward."

#. Occurrence 5B_15:5129:6463: scene=5B_15
#: 5B_15:5129
msgctxt "text_id=6463 | speaker=unknown"
msgid "　彼は、ただ、"
msgstr "  All he wanted was..."

#. Occurrence 5B_15:5174:6464: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0022; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:5174
msgctxt "text_id=6464 | speaker=soujuurou"
msgid "“よし―――”"
msgstr "(This is it!)"

#. Occurrence 5B_15:5180:6465: scene=5B_15
#: 5B_15:5180
msgctxt "text_id=6465 | speaker=unknown"
msgid "　これはただ、そうありたいと望んだだけの話。"
msgstr "  ...to live the way he wanted."

#. Occurrence 5B_15:5185:6466: scene=5B_15
#: 5B_15:5185
msgctxt "text_id=6466 | speaker=unknown"
msgid "　周りから強制された義務ではなく。"
msgstr "  It wasn't an obligation to the people around him."

#. Occurrence 5B_15:5190:6467: scene=5B_15
#: 5B_15:5190
msgctxt "text_id=6467 | speaker=unknown"
msgid "　ただ純粋に、そういう風に生きたいと信じた、愚直な自己の欲望そのもので―――"
msgstr "  His desire to live his way was his and his alone."

#. Occurrence 5B_15:5213:6468: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0023; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:5213
msgctxt "text_id=6468 | speaker=soujuurou"
msgid "“行こう！”"
msgstr "(Here we go!)"

#. Occurrence 5B_15:5272:6469: scene=5B_15
#: 5B_15:5272
msgctxt "text_id=6469 | speaker=unknown"
msgid "『！？』"
msgstr "\"!?\""

#. Occurrence 5B_15:5278:6470: scene=5B_15
#: 5B_15:5278
msgctxt "text_id=6470 | speaker=unknown"
msgid "　卵に発声機能があったのなら、そう驚いたに違いない。"
msgstr "  If the egg had been equipped with a vocal function, it would have gasped in shock at what happened next."

#. Occurrence 5B_15:5283:6471: scene=5B_15
#: 5B_15:5283
msgctxt "text_id=6471 | speaker=unknown"
msgid "　逃げるだけだった少年は、自分から大きく足を踏み外したのだ。"
msgstr "  The boy, who had only tried to escape up until this point, suddenly shifted his weight."

#. Occurrence 5B_15:5363:6472: scene=5B_15
#: 5B_15:5363
msgctxt "text_id=6472 | speaker=unknown"
msgid "　足は内ではなく、外に向かって。"
msgstr "  He pointed his feet outward instead of inward."

#. Occurrence 5B_15:5368:6473: scene=5B_15
#: 5B_15:5368
msgctxt "text_id=6473 | speaker=unknown"
msgid "　レールの端で、勢いを殺さないようわずかに膝を曲げ、浮遊する卵を凝視し―――"
msgstr "  On the edge of one rail, he crouched ever so slightly to maintain momentum, and gazed at the floating egg."

#. Occurrence 5B_15:5442:6474: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0024; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:5442
msgctxt "text_id=6474 | speaker=soujuurou"
msgid "“やれる―――距離的に問題はない！”"
msgstr "(Close enough! I can do this!)"

#. Occurrence 5B_15:5626:6475: scene=5B_15
#: 5B_15:5626
msgctxt "text_id=6475 | speaker=unknown"
msgid "　夜を駆ける。"
msgstr "  He soared through the night sky."

#. Occurrence 5B_15:5631:6476: scene=5B_15
#: 5B_15:5631
msgctxt "text_id=6476 | speaker=unknown"
msgid "　わずか１．５秒の夜間飛行。"
msgstr "  It was a flight that lasted a mere one and a half seconds―"

#. Occurrence 5B_15:5636:6477: scene=5B_15
#: 5B_15:5636
msgctxt "text_id=6477 | speaker=unknown"
msgid "　地上三十メートルの、<紐|ひも>なし<縄|なわ>なしバンジージャンプ。"
msgstr "  a cordless bungee jump from a hundred feet above ground."

#. Occurrence 5B_15:5641:6478: scene=5B_15
#: 5B_15:5641
msgctxt "text_id=6478 | speaker=unknown"
msgid "　その落下先は―――"
msgstr "  His destination:"

#. Occurrence 5B_15:5725:6479: scene=5B_15
#: 5B_15:5725
msgctxt "text_id=6479 | speaker=unknown"
msgid "　唯一の足場となる、空飛ぶ巨大な卵だった。"
msgstr "  the only thing that would stop his fall―the giant flying egg."

#. Occurrence 5B_15:5841:6480: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0025; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:5841
msgctxt "text_id=6480 | speaker=soujuurou"
msgid "「う、ひゃああーーーー！」"
msgstr "\"Hyaaah!\""

#. Occurrence 5B_15:5847:6481: scene=5B_15
#: 5B_15:5847
msgctxt "text_id=6481 | speaker=unknown"
msgid "　悲鳴のような、歓声のような声をあげながら、草十郎は必死に卵の表面にしがみつく。"
msgstr "  He shrieked, this time out of elation, as he desperately clung to the egg's surface."

#. Occurrence 5B_15:5867:6482: scene=5B_15
#: 5B_15:5867
msgctxt "text_id=6482 | speaker=unknown"
msgid "　……ほんの少し前。"
msgstr "  Just earlier..."

#. Occurrence 5B_15:5874:6483: scene=5B_15
#: 5B_15:5874
msgctxt "text_id=6483 | speaker=unknown"
msgid "　恐怖心が無ければビルの上も平均台も変わらない、と血も涙もない魔女は言った。"
msgstr "  The cold-blooded witch had told him that without fear, the top of a building would feel no different than a balance beam."

#. Occurrence 5B_15:5879:6484: scene=5B_15
#: 5B_15:5879
msgctxt "text_id=6484 | speaker=unknown"
msgid "　その魔女とて、この光景を見たら言葉を失っただろう。"
msgstr "  This from the same witch that would have been left speechless had she witnessed this spectacle."

#. Occurrence 5B_15:5884:6485: scene=5B_15
#: 5B_15:5884
msgctxt "text_id=6485 | speaker=unknown"
msgid "　いくら恐怖心が無いと言っても、無茶と無謀は別の物だ。"
msgstr "  It was one thing to be fearless, and another to be reckless."

#. Occurrence 5B_15:5889:6486: scene=5B_15
#: 5B_15:5889
msgctxt "text_id=6486 | speaker=unknown"
msgid "　あまつさえ、<こ|・><の|・><後|・>の行為に至っては、後日本気で頭にきた程である。"
msgstr "  What the boy did next would give her a headache in the days to come."

#. Occurrence 5B_15:5957:6487: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0026; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:5957
msgctxt "text_id=6487 | speaker=soujuurou"
msgid "「頼むぞ、卵！」"
msgstr "\"I'm counting on you, egg!\""

#. Occurrence 5B_15:5966:6488: scene=5B_15
#: 5B_15:5966
msgctxt "text_id=6488 | speaker=unknown"
msgid "　卵にしがみついたまま、<卵|・><か|・><ら|・><視|・><線|・><を|・><切|・><る|・>。"
msgstr "  Clinging to the egg, he shifted his gaze away from it."

#. Occurrence 5B_15:5971:6489: scene=5B_15
#: 5B_15:5971
msgctxt "text_id=6489 | speaker=unknown"
msgid "　急速な落下感覚。"
msgstr "  He felt the rapid descent."

#. Occurrence 5B_15:6052:6490: scene=5B_15
#: 5B_15:6052
msgctxt "text_id=6490 | speaker=unknown"
msgid "　草十郎は薄目で風景を確認しながら、残り一メートル付近で視線を戻し、卵を視界に<納|おさ>めながら飛びだした。"
msgstr "  Soujyuro, focusing his half-shut eyes on the ground, leaped off the egg once they were a few feet from the ground, then turned back to it, careful to reestablish eye contact."

#. Occurrence 5B_15:6118:6491: scene=5B_15
#: 5B_15:6118
msgctxt "text_id=6491 | speaker=unknown"
msgid "　―――いや、まことに信じがたい話ではあるが。"
msgstr "  Something so unbelievable, though to Soujyuro..."

#. Occurrence 5B_15:6124:6492: scene=5B_15
#: 5B_15:6124
msgctxt "text_id=6492 | speaker=unknown"
msgid "　彼にとってはデパートのエレベーターも、"
msgstr "  The elevator at the department store"

#. Occurrence 5B_15:6124:6493: scene=5B_15
#: 5B_15:6124
msgctxt "text_id=6493 | speaker=unknown"
msgid "　不思議動力で浮遊する卵も、"
msgstr "  and the mysterious floating egg were both just moving objects,"

#. Occurrence 5B_15:6124:6494: scene=5B_15
#: 5B_15:6124
msgctxt "text_id=6494 | speaker=unknown"
msgid "　そう大差のない「移動道具」に見えたのである……！"
msgstr "  virtually indistinguishable from one another."

#. Occurrence 5B_15:6240:6495: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0027; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:6240
msgctxt "text_id=6495 | speaker=soujuurou"
msgid "「よし、割れてない！"
msgstr "\"All right! It didn't break!"

#. Occurrence 5B_15:6240:6496: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0027; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:6240
msgctxt "text_id=6496 | speaker=soujuurou"
msgid "食べ物を粗末にするのはよくないと思う！」"
msgstr "It's always a shame when food goes to waste!\""

#. Occurrence 5B_15:6406:6497: scene=5B_15
#: 5B_15:6406
msgctxt "text_id=6497 | speaker=unknown"
msgid "　着地したのは小広場の近く。"
msgstr "  He landed near the plaza."

#. Occurrence 5B_15:6411:6498: scene=5B_15
#: 5B_15:6411
msgctxt "text_id=6498 | speaker=unknown"
msgid "　命を投げたショートカットは、これ以上ないカタチで実を結んだ。"
msgstr "  The shortcut that almost cost him his life had paid off."

#. Occurrence 5B_15:6488:6499: scene=5B_15
#: 5B_15:6488
msgctxt "text_id=6499 | speaker=unknown"
msgid "　草十郎は着地しながら、止まる事なく走りだす。"
msgstr "  Soujyuro took off running the second his feet touched the ground."

#. Occurrence 5B_15:6581:6500: scene=5B_15
#: 5B_15:6581
msgctxt "text_id=6500 | speaker=unknown"
msgid "　彼の脳裏にあるのは青子に迫る人形の姿だけ。"
msgstr "  The puppet after Aoko was the only thing on his mind."

#. Occurrence 5B_15:6608:6501: scene=5B_15
#: 5B_15:6608
msgctxt "text_id=6501 | speaker=unknown"
msgid "　なので、空から降ってくる月の光も、"
msgstr "  He paid no mind to the moonlight in the sky,"

#. Occurrence 5B_15:6706:6502: scene=5B_15
#: 5B_15:6706
msgctxt "text_id=6502 | speaker=unknown"
msgid "　利用された怒りに燃えて自ら破裂し、破片をまき散らさんとする卵も視界に映らない。"
msgstr "  nor to the egg which was furious about being used, and seconds away from self-destructing and blasting fragments all over the place."

#. Occurrence 5B_15:6777:6503: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0028; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:6777
msgctxt "text_id=6503 | speaker=soujuurou"
msgid "「蒼崎―――！」"
msgstr "\"Aozaki!\""

#. Occurrence 5B_15:6834:6504: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_15_0007; voice_prefix=A10; voice_category=1; scene=5B_15
#: 5B_15:6834
msgctxt "text_id=6504 | speaker=aoko"
msgid "「なぬ―――？」"
msgstr "\"Huh?\""

#. Occurrence 5B_15:6840:6505: scene=5B_15
#: 5B_15:6840
msgctxt "text_id=6505 | speaker=unknown"
msgid "　目を疑う青子の表情が、最後の一足に力を入れる。"
msgstr "  Aoko's dumbfounded expression spurred Soujyuro on."

#. Occurrence 5B_15:6940:6506: scene=5B_15
#: 5B_15:6940
msgctxt "text_id=6506 | speaker=unknown"
msgid "　<詩篇|のろい>が展開する。"
msgstr "  The curse was complete."

#. Occurrence 5B_15:6945:6507: scene=5B_15
#: 5B_15:6945
msgctxt "text_id=6507 | speaker=unknown"
msgid "　もはや逃がさぬと中身のない卵は<謳|うた>い―――"
msgstr "  The empty egg began to sing its warning to let them know there was no escape."

#. Occurrence 5B_15:7192:6508: scene=5B_15
#: 5B_15:7192
msgctxt "text_id=6508 | speaker=unknown"
msgid "　カオスに散らかる卵の断片。"
msgstr "  Shrapnel from the egg exploded through the air."

#. Occurrence 5B_15:7197:6509: scene=5B_15
#: 5B_15:7197
msgctxt "text_id=6509 | speaker=unknown"
msgid "　ダンプティに刻まれた“女王アリスを讃える唄”は、急速に五感を奪っていく。"
msgstr "  The \"Ode to Queen Alice\" that Alice had engraved into Dumpty quickly robbed him of his senses."

#. Occurrence 5B_15:7218:6510: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0029; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:7218
msgctxt "text_id=6510 | speaker=soujuurou"
msgid "「っ―――それは、それとして―――」"
msgstr "\"Okay... Was that it?\""

#. Occurrence 5B_15:7224:6511: scene=5B_15
#: 5B_15:7224
msgctxt "text_id=6511 | speaker=unknown"
msgid "　途切れていく感覚に<喝|かつ>を入れて、草十郎は横たわる青子に走り寄る。"
msgstr "  He snapped back to the task at hand and ran to Aoko, still lying on the ground."

#. Occurrence 5B_15:7229:6512: scene=5B_15
#: 5B_15:7229
msgctxt "text_id=6512 | speaker=unknown"
msgid "　足は止まらない。"
msgstr "  His legs moved as if they had a mind of their own,"

#. Occurrence 5B_15:7235:6513: scene=5B_15
#: 5B_15:7235
msgctxt "text_id=6513 | speaker=unknown"
msgid "そもそも感覚がないので自らの意志で止める事さえできず、"
msgstr " though he couldn't have stopped them anyway, since he could no longer feel them."

#. Occurrence 5B_15:7351:6514: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0030; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:7351
msgctxt "text_id=6514 | speaker=soujuurou"
msgid "「<人形|おまえ>、驚くほどしつこいぞ……！」"
msgstr "\"Don't you puppets ever give up!?\""

#. Occurrence 5B_15:7860:6515: scene=5B_15
#: 5B_15:7860
msgctxt "text_id=6515 | speaker=unknown"
msgid "　<交差点|スクランブル>の<爆発|マーダー><事故|ケース>。"
msgstr "  The Scrambled Murder Case."

#. Occurrence 5B_15:7865:6516: scene=5B_15
#: 5B_15:7865
msgctxt "text_id=6516 | speaker=unknown"
msgid "　三者三様の残骸が、閃光弾となって地上に咲く。"
msgstr "  Piles of rubble became flowers of light blooming from the earth."

#. Occurrence 5B_15:7916:6517: scene=5B_15
#: 5B_15:7916
msgctxt "text_id=6517 | speaker=unknown"
msgid "　……敗者たちがこぞって潰しあった最終幕。"
msgstr "  The final curtain drew closed, and the defeated left the battleground."

#. Occurrence 5B_15:7921:6518: scene=5B_15
#: 5B_15:7921
msgctxt "text_id=6518 | speaker=unknown"
msgid "　久遠寺有珠が見ていたら頭を抱えそうな結末から、ふたりは間一髪ではじき出された。"
msgstr "  Had Alice Kuonji seen it happen, she would have been beside herself. The two had escaped by a hair's breadth."

#. Occurrence 5B_15:8049:6519: scene=5B_15
#: 5B_15:8049
msgctxt "text_id=6519 | speaker=unknown"
msgid "　この、世にも<希|まれ>なつぶし合いを冷静に把握できたのは、助けられた少女だけ。"
msgstr "  The only person in a position to witness that rare mutual destruction was the girl who had been saved from it."

#. Occurrence 5B_15:8054:6520: scene=5B_15
#: 5B_15:8054
msgctxt "text_id=6520 | speaker=unknown"
msgid "　走り続けた少年は背後の結末にあまり関心もなく、"
msgstr "  The boy who had never stopped running paid it no mind."

#. Occurrence 5B_15:8137:6521: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_15_0031; voice_prefix=A30; voice_category=3; scene=5B_15
#: 5B_15:8137
msgctxt "text_id=6521 | speaker=soujuurou"
msgid "「はあ―――死ぬかと、思った」"
msgstr "\"Phew. I thought you were a goner.\""

#. Occurrence 5B_15:8143:6522: scene=5B_15
#: 5B_15:8143
msgctxt "text_id=6522 | speaker=unknown"
msgid "　自分のしでかした奇跡より、抱きかかえた少女の無事を確かめて、安堵の息を漏らしていた。"
msgstr "  The safety of the girl in his arms meant infinitely more to him than the miraculous way in which he saved her."

#. Occurrence 5B_16:59:6523: scene=5B_16
#: 5B_16:59
msgctxt "text_id=6523 | speaker=unknown"
msgid "　……かくして、夜明けを待たず月は落ちた。"
msgstr "  ...The moon did not wait for dawn to set."

#. Occurrence 5B_16:65:6524: scene=5B_16
#: 5B_16:65
msgctxt "text_id=6524 | speaker=unknown"
msgid "　御伽の国の<装飾|テクスチャ>が溶けていく。"
msgstr "  The ornamental texture of the fairy-tale kingdom faded away."

#. Occurrence 5B_16:70:6525: scene=5B_16
#: 5B_16:70
msgctxt "text_id=6525 | speaker=unknown"
msgid "　道に響いていた華やかな<旋律|コード>も、"
msgstr "  All of the illusions returned to the way they were before,"

#. Occurrence 5B_16:75:6526: scene=5B_16
#: 5B_16:75
msgctxt "text_id=6526 | speaker=unknown"
msgid "　来客を歓迎する<人形|パペット>たちの姿も、"
msgstr "  from the ostentatious chords reverberating through the streets,"

#. Occurrence 5B_16:80:6527: scene=5B_16
#: 5B_16:80
msgctxt "text_id=6527 | speaker=unknown"
msgid "　すべて幻となって、本来のカタチに戻っていく。"
msgstr "  to the puppets welcoming their guests."

#. Occurrence 5B_16:155:6528: scene=5B_16
#: 5B_16:155
msgctxt "text_id=6528 | speaker=unknown"
msgid "　<密|ひそ>やかに、<静|しず>やかに。"
msgstr "  Peace and quiet reigned once more"

#. Occurrence 5B_16:160:6529: scene=5B_16
#: 5B_16:160
msgctxt "text_id=6529 | speaker=unknown"
msgid "　もう二度と目覚める事のない、忘却の国に沈んでいく。"
msgstr "  over a forgotten kingdom, never to be awakened again."

#. Occurrence 5B_16:238:6530: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0000; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:238
msgctxt "text_id=6530 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5B_16:244:6531: scene=5B_16
#: 5B_16:244
msgctxt "text_id=6531 | speaker=unknown"
msgid "　一夜の夢の名残火。"
msgstr "  Out flickered the embers of a late-night dream..."

#. Occurrence 5B_16:249:6532: scene=5B_16
#: 5B_16:249
msgctxt "text_id=6532 | speaker=unknown"
msgid "　遊園地を照らす数多の<電飾|ライト>も、ひとつずつ消えていく。"
msgstr "  ...even the electric lamps that illuminated the park."

#. Occurrence 5B_16:289:6533: scene=5B_16
#: 5B_16:289
msgctxt "text_id=6533 | speaker=unknown"
msgid "　その光景をふたりは眺めていた。"
msgstr "  Together, they watched it disappear."

#. Occurrence 5B_16:309:6534: scene=5B_16
#: 5B_16:309
msgctxt "text_id=6534 | speaker=unknown"
msgid "　草十郎は地面に倒れこんで、必死に酸素を取りこんでいる。"
msgstr "  Soujyuro lay on the ground, desperately gasping for air like a fish out of water."

#. Occurrence 5B_16:314:6535: scene=5B_16
#: 5B_16:314
msgctxt "text_id=6535 | speaker=unknown"
msgid "　爆弾卵の<詩篇|のろい>で痛覚は麻痺し、積み重なった疲労は相当なものだろう。吹けば消えそうとはこの事だ。"
msgstr "  The curse of the exploding egg had numbed his pain, and he was understandably exhausted after all he had experienced. He looked like he could be blown away by the lightest of breezes."

#. Occurrence 5B_16:319:6536: scene=5B_16
#: 5B_16:319
msgctxt "text_id=6536 | speaker=unknown"
msgid "　一方の青子も疲れきってはいたが、草十郎ほど息の乱れはない。"
msgstr "  While Aoko was also exhausted, she was still in better shape."

#. Occurrence 5B_16:325:6537: scene=5B_16
#: 5B_16:325
msgctxt "text_id=6537 | speaker=unknown"
msgid "今は深呼吸を繰り返し、体力回復に努めている。"
msgstr "Focused on taking deep, even breaths, she was already working to recover her strength."

#. Occurrence 5B_16:376:6538: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0001; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:376
msgctxt "text_id=6538 | speaker=aoko"
msgid "「……あのさ」"
msgstr "\"...So.\""

#. Occurrence 5B_16:383:6539: scene=5B_16
#: 5B_16:383
msgctxt "text_id=6539 | speaker=unknown"
msgid "　青子は視線を遊園地に向けたまま、関心のない素振りで、草十郎に声をかけた。"
msgstr "  She addressed Soujyuro indifferently as her gaze remained on the amusement park."

#. Occurrence 5B_16:388:6540: scene=5B_16
#: 5B_16:388
msgctxt "text_id=6540 | speaker=unknown"
msgid "　やや芝居がかった唐突さ。本当は面と向かって話しかけたいのを、意地で堪えているのが見え見えである。"
msgstr "  The abruptness of it was a bit theatrical in nature. She wanted to look at him as she spoke, but her pride was simply too great."

#. Occurrence 5B_16:439:6541: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0002; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:439
msgctxt "text_id=6541 | speaker=aoko"
msgid "「……貴方、なんかすごいコトしなかった？」"
msgstr "\"...You did something kinda amazing, didn't you?\""

#. Occurrence 5B_16:503:6542: scene=5B_16
#: 5B_16:503
msgctxt "text_id=6542 | speaker=unknown"
msgid "　……彼女が死を受け入れた、永遠とも言える一瞬。"
msgstr "  The moment she had accepted death had seemed like an eternity."

#. Occurrence 5B_16:509:6543: scene=5B_16
#: 5B_16:509
msgctxt "text_id=6543 | speaker=unknown"
msgid "　月の破片に貫かれる自分を、冷静に、自分でもどうかと思うほど客観的に見ていた時。"
msgstr "  She was beside herself in shock at how indifferent she had been as the shards rained down from the moon."

#. Occurrence 5B_16:514:6544: scene=5B_16
#: 5B_16:514
msgctxt "text_id=6544 | speaker=unknown"
msgid "　力強く呼びかける声が、彼女を現実に引き戻した。"
msgstr "  But a reassuring voice had snapped her back into reality."

#. Occurrence 5B_16:585:6545: scene=5B_16
#: 5B_16:585
msgctxt "text_id=6545 | speaker=unknown"
msgid "　……いかなる理由で、何を考えて、どんな無茶をして、彼は自分を助けたのか。"
msgstr "  Why did he do it? What was he thinking? What moronic things had he done to pull it off?"

#. Occurrence 5B_16:590:6546: scene=5B_16
#: 5B_16:590
msgctxt "text_id=6546 | speaker=unknown"
msgid "　倒れていた青子には、そのあたりの経緯がまったく分からない。確かなことは、最後の最後で、最高のフォローをしてもらったという事だけ。"
msgstr "  She had no answers for these questions, lying on the ground as she was. All she knew was that he had more than made up for his failure in the house of mirrors and then some, in those fateful final moments."

#. Occurrence 5B_16:610:6547: scene=5B_16
#: 5B_16:610
msgctxt "text_id=6547 | speaker=unknown"
msgid "　それが知りたくて声をかけたが、それ以上のことは言葉にできない。"
msgstr "  She addressed him, hoping to find answers, but found herself unable to probe any further."

#. Occurrence 5B_16:624:6548: scene=5B_16
#: 5B_16:624
msgctxt "text_id=6548 | speaker=unknown"
msgid "　言葉にしたら負けな気がして、こんな風に、らしくない態度で声をかけたのだ。"
msgstr "  To dig any deeper would feel like defeat, which is why it was so unlike her to ask him in the first place."

#. Occurrence 5B_16:629:6549: scene=5B_16
#: 5B_16:629
msgctxt "text_id=6549 | speaker=unknown"
msgid "　もちろん幸い、話しかけられた彼には、そんな彼女のいじらしさに気付く余裕も情緒も、ありはしなかったのだが。"
msgstr "  Lucky for her, Soujyuro had neither the capacity nor sensitivity to understand how egocentric she was being."

#. Occurrence 5B_16:681:6550: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_16_0000; voice_prefix=A30; voice_category=3; scene=5B_16
#: 5B_16:681
msgctxt "text_id=6550 | speaker=soujuurou"
msgid "「すごいって、"
msgstr "\"Amazing?"

msgctxt "text_id=6551 | speaker=unknown"
msgid "それは、"
msgstr " You were..."

msgctxt "text_id=6552 | speaker=unknown"
msgid "蒼崎の方、"
msgstr "...pretty amazing..."

msgctxt "text_id=6553 | speaker=unknown"
msgid "だろ」"
msgstr "...Aozaki.\""

#. Occurrence 5B_16:695:6554: scene=5B_16
#: 5B_16:695
msgctxt "text_id=6554 | speaker=unknown"
msgid "　草十郎は胸を弾ませながら答える。"
msgstr "  He stuttered between labored breaths."

#. Occurrence 5B_16:700:6555: scene=5B_16
#: 5B_16:700
msgctxt "text_id=6555 | speaker=unknown"
msgid "　今は肺に酸素を送るのに手一杯で、青子に顔を向ける余裕もない。"
msgstr "  It was taking him so much effort just to breathe that he could not address her properly."

#. Occurrence 5B_16:706:6556: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0003; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:706
msgctxt "text_id=6556 | speaker=aoko"
msgid "「………………」"
msgstr "\"....\""

#. Occurrence 5B_16:711:6557: scene=5B_16
#: 5B_16:711
msgctxt "text_id=6557 | speaker=unknown"
msgid "　そんな様子を、少女は横目で観察する。"
msgstr "  She watched him out of the corner of her eye."

#. Occurrence 5B_16:766:6558: scene=5B_16
#: 5B_16:766
msgctxt "text_id=6558 | speaker=unknown"
msgid "　振り返れば、少年の役割はどれも同じだった。"
msgstr "  Thinking back on it, the boy had performed the same role each time."

#. Occurrence 5B_16:771:6559: scene=5B_16
#: 5B_16:771
msgctxt "text_id=6559 | speaker=unknown"
msgid "　鏡の城でも童話の遊園地でも、彼は自分の無力さを<嗤|わら>わず、自分にできる事と向きあい続けた。"
msgstr "  Each and every time, he did what he could in spite of his fecklessness."

#. Occurrence 5B_16:776:6560: scene=5B_16
#: 5B_16:776
msgctxt "text_id=6560 | speaker=unknown"
msgid "　相手を打ち負かしたのはいいものの、勢いあまって転びかけた愚か者とは大違いだ。"
msgstr "  It was far more admirable than her nearly suicidal tactics, even if she did defeat her opponent."

#. Occurrence 5B_16:811:6561: scene=5B_16
#: 5B_16:811
msgctxt "text_id=6561 | speaker=unknown"
msgid "　…………だから今の無謀だって、彼にすればそう特別な事ではなく、"
msgstr "  He did not even recognize how extraordinary his last act of courage was."

#. Occurrence 5B_16:842:6562: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_16_0001; voice_prefix=A30; voice_category=3; scene=5B_16
#: 5B_16:842
msgctxt "text_id=6562 | speaker=soujuurou"
msgid "『―――提案。あいつをやっつけるのに協力したら、俺の事は見逃してくれる？』"
msgstr "\"Here's an idea. If I help you kill that thing, will you let me go?\""

#. Occurrence 5B_16:872:6563: scene=5B_16
#: 5B_16:872
msgctxt "text_id=6563 | speaker=unknown"
msgid "　せめて、自分に出来る事からは目を背けない彼にとっての、<精一杯|できるかぎり>の勇気だった。"
msgstr "  At the very least, he had the courage to keep trying whatever he could."

#. Occurrence 5B_16:950:6564: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0004; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:950
msgctxt "text_id=6564 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5B_16:956:6565: scene=5B_16
#: 5B_16:956
msgctxt "text_id=6565 | speaker=unknown"
msgid "　観客から見ればただの脇役。"
msgstr "  A spectator might have viewed him as a supporting actor."

#. Occurrence 5B_16:961:6566: scene=5B_16
#: 5B_16:961
msgctxt "text_id=6566 | speaker=unknown"
msgid "　目の覚めるような活躍だなんてとても言えない。"
msgstr "  His actions were not exactly memorable."

#. Occurrence 5B_16:974:6567: scene=5B_16
#: 5B_16:974
msgctxt "text_id=6567 | speaker=unknown"
msgid "　けれど、転ばないよう手を引っ張られた少女にすれば話は別で、"
msgstr "  But the lead actress he supported did not see it that way."

#. Occurrence 5B_16:1015:6568: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0005; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1015
msgctxt "text_id=6568 | speaker=aoko"
msgid "“……まあね。"
msgstr "(Well..."

#. Occurrence 5B_16:1021:6569: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0006; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1021
msgctxt "text_id=6569 | speaker=aoko"
msgid "　認めたくないし、口になんて、もっとしたくないけど”"
msgstr "  I don't really want to admit it to myself, much less say it out loud, but...)"

#. Occurrence 5B_16:1027:6570: scene=5B_16
#: 5B_16:1027
msgctxt "text_id=6570 | speaker=unknown"
msgid "　少年の<奮起|ふんき>は脇役扱いされるものではなく。"
msgstr "  Such inspired actions were wasted in a supporting role."

#. Occurrence 5B_16:1032:6571: scene=5B_16
#: 5B_16:1032
msgctxt "text_id=6571 | speaker=unknown"
msgid "　本当にすごい事をしたのはコイツだよ、なんて、まわりに言い聞かせたいほどの奮戦だったのだ。"
msgstr "  This guy really pulled off the impossible. It was so amazing that she wanted to shout it as loud as she possibly could for all the world to hear."

#. Occurrence 5B_16:1067:6572: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0007; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1067
msgctxt "text_id=6572 | speaker=aoko"
msgid "「――――――はあ」"
msgstr "\"...Hah.\""

#. Occurrence 5B_16:1073:6573: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_16_0002; voice_prefix=A30; voice_category=3; scene=5B_16
#: 5B_16:1073
msgctxt "text_id=6573 | speaker=soujuurou"
msgid "「蒼崎？」"
msgstr "\"Aozaki?\""

#. Occurrence 5B_16:1080:6574: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0008; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1080
msgctxt "text_id=6574 | speaker=aoko"
msgid "“……ホント。人畜無害も、度を過ぎると侮れないわ”"
msgstr "(God. He's so innocent it makes me want to barf.)"

#. Occurrence 5B_16:1085:6575: scene=5B_16
#: 5B_16:1085
msgctxt "text_id=6575 | speaker=unknown"
msgid "　はあ、と青子は自分自身にため息をつく。"
msgstr "  All Aoko could do was sigh."

#. Occurrence 5B_16:1137:6576: scene=5B_16
#: 5B_16:1137
msgctxt "text_id=6576 | speaker=unknown"
msgid "　けれど仕方がない。たったいま窮地から救ってくれた姿は、ほんのちょっとだけ格好良かったし、"
msgstr "  How could she not? Even she was forced to admit that the way he'd snatched her from the jaws of death was... dashing."

#. Occurrence 5B_16:1144:6577: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0009; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1144
msgctxt "text_id=6577 | speaker=aoko"
msgid "「……ま。評価、甘めだけど」"
msgstr "\"I must be getting soft.\""

#. Occurrence 5B_16:1150:6578: scene=5B_16
#: 5B_16:1150
msgctxt "text_id=6578 | speaker=unknown"
msgid "　正直。こんなのにわざわざ手を下すなんて、<莫|ば><迦|か>らしいにも程がある。"
msgstr "  Truth be told, he was a lunatic for doing what he did."

#. Occurrence 5B_16:1241:6579: scene=5B_16
#: 5B_16:1241
msgctxt "text_id=6579 | speaker=unknown"
msgid "　呼吸を整え、少女はすぅ、と体を起こした。"
msgstr "  She steadied her breathing and composed herself."

#. Occurrence 5B_16:1246:6580: scene=5B_16
#: 5B_16:1246
msgctxt "text_id=6580 | speaker=unknown"
msgid "　……実のところまだ厳しいが、彼女にも魔術師としての誇りがある。"
msgstr "  While she was in bad shape, she still had her pride as a mage to consider."

#. Occurrence 5B_16:1251:6581: scene=5B_16
#: 5B_16:1251
msgctxt "text_id=6581 | speaker=unknown"
msgid "　なので、<宣言|せんげん>する時は<威厳|いげん>がなくてはいけないのだ。"
msgstr "  That was why she felt a need to maintain an air of dignity."

#. Occurrence 5B_16:1303:6582: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0010; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1303
msgctxt "text_id=6582 | speaker=aoko"
msgid "「静希君。見逃すのは今日だけって話だったけど、アレ、なしでいいわ。"
msgstr "\"Sizuki, I originally meant to let you off the hook for today only, but I'm willing to let the whole thing go."

#. Occurrence 5B_16:1310:6583: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0011; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1310
msgctxt "text_id=6583 | speaker=aoko"
msgid "とりあえず、命は助けてあげるから」"
msgstr "For the time being, I've decided to let you live.\""

#. Occurrence 5B_16:1343:6584: scene=5B_16
#: 5B_16:1343
msgctxt "text_id=6584 | speaker=unknown"
msgid "　仕方なさげに差し出される右手。"
msgstr "  She hastily extended her right hand."

#. Occurrence 5B_16:1348:6585: scene=5B_16
#: 5B_16:1348
msgctxt "text_id=6585 | speaker=unknown"
msgid "　握手とも、座りこんだ草十郎を立ち上がらせる為のものとも取れる。"
msgstr "  It was either to shake his or to help him up."

#. Occurrence 5B_16:1368:6586: scene=5B_16
#: 5B_16:1368
msgctxt "text_id=6586 | speaker=unknown"
msgid "　一方。"
msgstr "  However..."

#. Occurrence 5B_16:1444:6587: scene=5B_16
#: 5B_16:1444
msgctxt "text_id=6587 | speaker=unknown"
msgid "　差し出された手を取らず、草十郎は自分の足で立ち上がった。"
msgstr "  Soujyuro did not take her hand, but instead stood up on his own."

#. Occurrence 5B_16:1449:6588: scene=5B_16
#: 5B_16:1449
msgctxt "text_id=6588 | speaker=unknown"
msgid "　この夜。"
msgstr "  This night."

#. Occurrence 5B_16:1455:6589: scene=5B_16
#: 5B_16:1455
msgctxt "text_id=6589 | speaker=unknown"
msgid "散々な目にあわされながらも、結局一度も見せなかった、心から意外そうな<表|か><情|お>をして。"
msgstr "Despite the sheer insanity that he had just experienced, his face had not once looked as incredulous as it did now."

#. Occurrence 5B_16:1522:6590: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0012; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1522
msgctxt "text_id=6590 | speaker=aoko"
msgid "「な、なによそのリアクションは」"
msgstr "\"W-what? Something wrong?\""

#. Occurrence 5B_16:1528:6591: scene=5B_16
#: 5B_16:1528
msgctxt "text_id=6591 | speaker=unknown"
msgid "　何か、とんでもなく恥ずかしい事をした気になって言い<淀|よど>む青子。"
msgstr "  She stammered, worried that she had deeply embarrassed herself."

#. Occurrence 5B_16:1533:6592: scene=5B_16
#: 5B_16:1533
msgctxt "text_id=6592 | speaker=unknown"
msgid "　そんな彼女を、草十郎はまじまじと見つめている。"
msgstr "  Soujyuro's gaze was fixed upon Aoko."

#. Occurrence 5B_16:1589:6593: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0013; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1589
msgctxt "text_id=6593 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5B_16:1595:6594: scene=5B_16
#: 5B_16:1595
msgctxt "text_id=6594 | speaker=unknown"
msgid "　……問題は。"
msgstr "  A problem had dawned on Aoko."

#. Occurrence 5B_16:1601:6595: scene=5B_16
#: 5B_16:1601
msgctxt "text_id=6595 | speaker=unknown"
msgid "じろじろと見つめられれば不快になる筈なのに、嫌悪感がまったくないこと。"
msgstr "Though she normally hated being stared at, this time, she did not mind."

#. Occurrence 5B_16:1606:6596: scene=5B_16
#: 5B_16:1606
msgctxt "text_id=6596 | speaker=unknown"
msgid "　むしろ容認しちゃってもいいかも知れない、などと、青子をして思わせるほど温かみのある視線で―――"
msgstr "  Rather, she was enjoying the warmth in his eyes and felt like it was something she could almost come to appreciate."

#. Occurrence 5B_16:1663:6597: scene=5B_16
#: 5B_16:1663
msgctxt "text_id=6597 | speaker=unknown"
msgid "「いや、そんなお友達感覚の話じゃなくてだな。そういう好き嫌いじゃなくて、草の字は本気でおまえに―――」"
msgstr "\"Don't you get it? This isn't just about friendship! And I didn't mean he only 'likes' you, either! Believe me when I say that Sono-G really―\""

#. Occurrence 5B_16:1725:6598: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0014; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1725
msgctxt "text_id=6598 | speaker=aoko"
msgid "“……あ……”"
msgstr "(Oh...)"

#. Occurrence 5B_16:1731:6599: scene=5B_16
#: 5B_16:1731
msgctxt "text_id=6599 | speaker=unknown"
msgid "　そこで。"
msgstr "  The conversation came rushing back."

#. Occurrence 5B_16:1736:6600: scene=5B_16
#: 5B_16:1736
msgctxt "text_id=6600 | speaker=unknown"
msgid "　よせばいいのに、忘れていた台詞を思い出した。"
msgstr "  It was a memory better left forgotten."

#. Occurrence 5B_16:1789:6601: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0015; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1789
msgctxt "text_id=6601 | speaker=aoko"
msgid "“いかん、それは違う！”"
msgstr "(No, not happening!)"

#. Occurrence 5B_16:1841:6602: scene=5B_16
#: 5B_16:1841
msgctxt "text_id=6602 | speaker=unknown"
msgid "　鳶丸の台詞を心の中で思いっきり否定して、青子は草十郎に向き直る。"
msgstr "  Pushing Tobimaru's words out of her mind, Aoko turned to Soujyuro."

#. Occurrence 5B_16:1870:6603: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0016; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1870
msgctxt "text_id=6603 | speaker=aoko"
msgid "「そ、それとこれは別だから！"
msgstr "\"D-don't get any ideas!"

#. Occurrence 5B_16:1876:6604: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0017; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1876
msgctxt "text_id=6604 | speaker=aoko"
msgid "　私はアンタの事とか、ホントどうでもいいんだから！」"
msgstr "  I don't care about you in the least!\""

#. Occurrence 5B_16:1881:6605: scene=5B_16
#: 5B_16:1881
msgctxt "text_id=6605 | speaker=unknown"
msgid "　はい？　と首を傾げる草十郎。"
msgstr "  Puzzled, Soujyuro tilted his head."

#. Occurrence 5B_16:1915:6606: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_16_0003; voice_prefix=A30; voice_category=3; scene=5B_16
#: 5B_16:1915
msgctxt "text_id=6606 | speaker=soujuurou"
msgid "「さっき嫌いだって言われたけど」"
msgstr "\"You already told me how much you dislike me.\""

#. Occurrence 5B_16:1920:6607: scene=5B_16
#: 5B_16:1920
msgctxt "text_id=6607 | speaker=unknown"
msgid "　唐突な青子の発言に疑問こそあれ文句はなく、彼は淡々と言葉を返す。"
msgstr "  He responded matter-of-factly to her sudden declaration."

#. Occurrence 5B_16:1961:6608: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0018; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:1961
msgctxt "text_id=6608 | speaker=aoko"
msgid "「う―――」"
msgstr "\"Uuuh...\""

#. Occurrence 5B_16:1967:6609: scene=5B_16
#: 5B_16:1967
msgctxt "text_id=6609 | speaker=unknown"
msgid "　……たしかに、面と向かって言った。"
msgstr "  She certainly had pointed that out. And to his face no less."

#. Occurrence 5B_16:1972:6610: scene=5B_16
#: 5B_16:1972
msgctxt "text_id=6610 | speaker=unknown"
msgid "　けれどあれは言葉のアヤで、本気に取られると困ってしまうし、なによりそれより、今はそんな事を論じている場面ではなく、"
msgstr "  It had a mere figure of speech that he was not meant to take literally, but now was not the time to belabor the point."

#. Occurrence 5B_16:2001:6611: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0019; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:2001
msgctxt "text_id=6611 | speaker=aoko"
msgid "「そ、そうじゃなくて！　あなたが私に<惚|ほ>れてても、期待しないでって言ってるの！」"
msgstr "\"I-I'm not talking about that! I'm just saying... you shouldn't get your hopes up, no matter how far you've fallen for me!\""

#. Occurrence 5B_16:2007:6612: scene=5B_16
#: 5B_16:2007
msgctxt "text_id=6612 | speaker=unknown"
msgid "　つまり彼女は、そういう事を論じたいらしい。"
msgstr "  Yet, belabor she did anyway."

#. Occurrence 5B_16:2060:6613: scene=5B_16
#: 5B_16:2060
msgctxt "text_id=6613 | speaker=unknown"
msgid "　柄にもない事を怒鳴って、青子は<微|かす>かに赤面する。"
msgstr "  Aoko blushed slightly, realizing how inane she was being."

#. Occurrence 5B_16:2065:6614: scene=5B_16
#: 5B_16:2065
msgctxt "text_id=6614 | speaker=unknown"
msgid "　なんでこんなコトを口にする羽目になったんだろう、と悩みながら。"
msgstr "  She wondered how she'd ended up in this position."

#. Occurrence 5B_16:2106:6615: scene=5B_16
#: 5B_16:2106
msgctxt "text_id=6615 | speaker=unknown"
msgid "　……それでも、とにかく言いたい事、言うべき事は言ったのだ。"
msgstr "  And yet, she knew that she had to get this off her chest."

#. Occurrence 5B_16:2111:6616: scene=5B_16
#: 5B_16:2111
msgctxt "text_id=6616 | speaker=unknown"
msgid "　ここは礼儀として、相手の返答を待つだけである。"
msgstr "  All that was left was to politely wait for his response."

#. Occurrence 5B_16:2146:6617: scene=5B_16
#: 5B_16:2146
msgctxt "text_id=6617 | speaker=unknown"
msgid "“あなたとは付き合えない”"
msgstr "\"I can't date you.\""

#. Occurrence 5B_16:2168:6618: scene=5B_16
#: 5B_16:2168
msgctxt "text_id=6618 | speaker=unknown"
msgid "　なんてハートブレイクな言葉を受けて、純朴な少年はこの世の終わりのように、がっくりと肩を落とし……"
msgstr "  Such heartbreakingly painful words were too much for the simple boy to hear. His shoulders slumped as if the world was coming to an end..."

msgctxt "text_id=6619 | speaker=unknown"
msgid "　てはいなかった。"
msgstr "  ...Or so Aoko had imagined."

#. Occurrence 5B_16:2175:6620: scene=5B_16
#: 5B_16:2175
msgctxt "text_id=6620 | speaker=unknown"
msgid "　それどころか、なにやら真剣に考えこんでいる。"
msgstr "  On the contrary, Soujyuro was sitting there in deep thought."

#. Occurrence 5B_16:2203:6621: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_16_0004; voice_prefix=A30; voice_category=3; scene=5B_16
#: 5B_16:2203
msgctxt "text_id=6621 | speaker=soujuurou"
msgid "「俺が、蒼崎に、惚れてるって……？」"
msgstr "\"Did you just say... I'm in love with you?\""

#. Occurrence 5B_16:2231:6622: scene=5B_16
#: 5B_16:2231
msgctxt "text_id=6622 | speaker=unknown"
msgid "　呪文のように呟く草十郎。"
msgstr "  Soujyuro murmured the words as if they were a magic spell."

#. Occurrence 5B_16:2267:6623: scene=5B_16
#: 5B_16:2267
msgctxt "text_id=6623 | speaker=unknown"
msgid "　そうよ、と突っ返す青子。"
msgstr "  She shot right back with the affirmative."

#. Occurrence 5B_16:2314:6624: scene=5B_16
#: 5B_16:2314
msgctxt "text_id=6624 | speaker=unknown"
msgid "　深く、返事を待つ青子がドギマギするぐらい深く考えこんだ末、少年は少女を見つめ返して、すっぱりと言った。"
msgstr "  After a moment of deep contemplation, the boy turned to the expectant girl, and said,"

#. Occurrence 5B_16:2358:6625: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_16_0005; voice_prefix=A30; voice_category=3; scene=5B_16
#: 5B_16:2358
msgctxt "text_id=6625 | speaker=soujuurou"
msgid "「―――なんで？」"
msgstr "\"Why do you think that?\""

#. Occurrence 5B_16:2496:6626: scene=5B_16
#: 5B_16:2496
msgctxt "text_id=6626 | speaker=unknown"
msgid "　………冗談じゃ、"
msgstr "  He had to be joking."

msgctxt "text_id=6627 | speaker=unknown"
msgid "ない。"
msgstr " But he was not."

#. Occurrence 5B_16:2503:6628: scene=5B_16
#: 5B_16:2503
msgctxt "text_id=6628 | speaker=unknown"
msgid "　彼は本気で言っている。"
msgstr "  He was completely serious."

#. Occurrence 5B_16:2510:6629: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0021; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:2510
msgctxt "text_id=6629 | speaker=aoko"
msgid "“と―――”"
msgstr "(So...)"

#. Occurrence 5B_16:2515:6630: scene=5B_16
#: 5B_16:2515
msgctxt "text_id=6630 | speaker=unknown"
msgid "　つまり、好きではあるけど、好きなダケ。"
msgstr "  He liked her, but he didn't LIKE like her."

#. Occurrence 5B_16:2520:6631: scene=5B_16
#: 5B_16:2520
msgctxt "text_id=6631 | speaker=unknown"
msgid "　ぜんぶ副会長の早とちり。色恋沙汰とか男女の浪漫とか、はじめっからあたまになし。"
msgstr "  Of course the vice-president had jumped to conclusions. This boy had no interest in romance. He probably didn't even know what that was."

#. Occurrence 5B_16:2575:6632: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0022; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:2575
msgctxt "text_id=6632 | speaker=aoko"
msgid "“と、と、と―――”"
msgstr "(So... So... So...)"

#. Occurrence 5B_16:2580:6633: scene=5B_16
#: 5B_16:2580
msgctxt "text_id=6633 | speaker=unknown"
msgid "　まだ悩んでいる草十郎の仕草が、よけい恥ずかしい。"
msgstr "  She was incredibly embarrassed by how confused Soujyuro still appeared to be."

#. Occurrence 5B_16:2585:6634: scene=5B_16
#: 5B_16:2585
msgctxt "text_id=6634 | speaker=unknown"
msgid "　青子は顔どころか全身熱くなる衝動に襲われて、"
msgstr "  Her rosy complexion spread throughout her entire body."

#. Occurrence 5B_16:2632:6635: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_16_0006; voice_prefix=A30; voice_category=3; scene=5B_16
#: 5B_16:2632
msgctxt "text_id=6635 | speaker=soujuurou"
msgid "「むう。もう一度聞くけど、なんで？」"
msgstr "\"Umm... I'll ask again, but why do you think that?\""

#. Occurrence 5B_16:2653:6636: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0023; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:2653
msgctxt "text_id=6636 | speaker=aoko"
msgid "「そりゃあ、こっちが聞きたいわよーーーー！！！！」"
msgstr "\"THAT'S WHAT I WANNA KNOW!!!\""

#. Occurrence 5B_16:2660:6637: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0024; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:2660
msgctxt "text_id=6637 | speaker=aoko"
msgid "“鳶丸の、大馬鹿野郎ーーーーーーっ！！！！！”"
msgstr "(You freaking moron, Tobimaru!!!)"

#. Occurrence 5B_16:2680:6638: scene=5B_16
#: 5B_16:2680
msgctxt "text_id=6638 | speaker=unknown"
msgid "　……このように。"
msgstr "  Just like that..."

#. Occurrence 5B_16:2686:6639: scene=5B_16
#: 5B_16:2686
msgctxt "text_id=6639 | speaker=unknown"
msgid "もはや<釈明|しゃくめい>のしようもない、あるまじき暴挙に出たのだった。"
msgstr "She had lost her cool and given in to an unjustifiable outburst."

#. Occurrence 5B_16:2763:6640: scene=5B_16
#: 5B_16:2763
msgctxt "text_id=6640 | speaker=unknown"
msgid "　なんという現場封鎖、証拠隠滅。"
msgstr "  It was time to seal off the area and destroy all evidence."

#. Occurrence 5B_16:2768:6641: scene=5B_16
#: 5B_16:2768
msgctxt "text_id=6641 | speaker=unknown"
msgid "　恥ずかしさで頬が溶けるかのようなパニックと、鳶丸への恨みが彼女を突発的な犯行に走らせた。"
msgstr "  Aoko's embarrassment devolved into sheer panic, and her grudge against Tobimaru suddenly manifested as criminal assault."

#. Occurrence 5B_16:2773:6642: scene=5B_16
#: 5B_16:2773
msgctxt "text_id=6642 | speaker=unknown"
msgid "　飛ぶ鳥すら落とす正拳突き。もとい、やや弧を描いたのでストレートではなくフックと言うべきか。"
msgstr "  She lashed out with a punch that could have taken down a bird mid-flight. More specifically, it was a brutal right hook."

#. Occurrence 5B_16:2810:6643: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0025; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:2810
msgctxt "text_id=6643 | speaker=aoko"
msgid "「あ…………」"
msgstr "\"Ah...\""

#. Occurrence 5B_16:2816:6644: scene=5B_16
#: 5B_16:2816
msgctxt "text_id=6644 | speaker=unknown"
msgid "　会心の手応えに目を点にする青子。"
msgstr "  Aoko blinked. Her blow had connected with something solid, snapping her out of her reverie."

#. Occurrence 5B_16:2821:6645: scene=5B_16
#: 5B_16:2821
msgctxt "text_id=6645 | speaker=unknown"
msgid "　無防備だった彼と、激情に乗り出した自分。"
msgstr "  Her temper had lashed out at the completely defenseless Soujyuro."

#. Occurrence 5B_16:2826:6646: scene=5B_16
#: 5B_16:2826
msgctxt "text_id=6646 | speaker=unknown"
msgid "　腰の入った一撃は、見事なまでに彼の意識を刈り取った。"
msgstr "  It had been a splendid blow with all her weight behind it, knocking him out cold."

#. Occurrence 5B_16:2908:6647: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_16_0007; voice_prefix=A30; voice_category=3; scene=5B_16
#: 5B_16:2908
msgctxt "text_id=6647 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5B_16:2913:6648: scene=5B_16
#: 5B_16:2913
msgctxt "text_id=6648 | speaker=unknown"
msgid "　きゅう、と声をもらして倒れこむ草十郎。"
msgstr "  Soujyuro groaned, crumpling to the ground."

#. Occurrence 5B_16:2918:6649: scene=5B_16
#: 5B_16:2918
msgctxt "text_id=6649 | speaker=unknown"
msgid "　受けたばかりの詩篇の呪いと、今の一撃がトドメになったらしい。"
msgstr "  Her punch finished the job that the curse had started."

#. Occurrence 5B_16:2923:6650: scene=5B_16
#: 5B_16:2923
msgctxt "text_id=6650 | speaker=unknown"
msgid "　眠るように……と表現するにはやや苦しい、苦悶に歪んだ寝顔だが、これは気絶ではなく眠ったのだ、と青子は強引に解釈するコトにした。"
msgstr "  If not for the discomfort on his face, he appeared almost to be sleeping. Aoko convinced herself that he was napping, not concussed."

#. Occurrence 5B_16:2967:6651: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0026; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:2967
msgctxt "text_id=6651 | speaker=aoko"
msgid "「……ま、いっか。予定通りになったものね」"
msgstr "\"...Well, whatever. It was always going to end like this anyway.\""

#. Occurrence 5B_16:2973:6652: scene=5B_16
#: 5B_16:2973
msgctxt "text_id=6652 | speaker=unknown"
msgid "　うん、とノックダウンした草十郎を見て、青子は肩の力を抜いた。色々と邪魔が入ったけれど、とりあえずこれで一件落着だ。"
msgstr "  The tension in her shoulders eased away as she looked down at Soujyuro. A ton had gotten in her way over the course of today, but the day was saved, for now."

#. Occurrence 5B_16:2978:6653: scene=5B_16
#: 5B_16:2978
msgctxt "text_id=6653 | speaker=unknown"
msgid "　虚勢を張る相手もいなくなると、どっと疲れがやってくる。"
msgstr "  With nobody left to butt heads, she felt exhaustion finally overtake her."

#. Occurrence 5B_16:3014:6654: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0027; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3014
msgctxt "text_id=6654 | speaker=aoko"
msgid "「うわ……歩いて帰れるかな、私」"
msgstr "\"Ugh... How the heck am I going to walk home like this?\""

#. Occurrence 5B_16:3020:6655: scene=5B_16
#: 5B_16:3020
msgctxt "text_id=6655 | speaker=unknown"
msgid "　つい弱音をこぼすほどの疲労だった。"
msgstr "  Her fatigue was enough to make her complain out loud."

#. Occurrence 5B_16:3025:6656: scene=5B_16
#: 5B_16:3025
msgctxt "text_id=6656 | speaker=unknown"
msgid "　考えてみれば魔力を使いきったのも初めてだし、何の前準備もなしでこれだけの戦いをこなしたのも初めてだ。"
msgstr "  When she thought about it, she realized that this was the first time she had used up all of her magical energy and the first time she had participated in a battle of this scale without any prior preparation."

#. Occurrence 5B_16:3030:6657: scene=5B_16
#: 5B_16:3030
msgctxt "text_id=6657 | speaker=unknown"
msgid "　いや、そもそも―――"
msgstr "  Though in truth..."

#. Occurrence 5B_16:3072:6658: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0028; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3072
msgctxt "text_id=6658 | speaker=aoko"
msgid "「私ひとりじゃ、どっちも相打ちだったっけ」"
msgstr "\"It would have ended in mutual destruction if I'd been alone.\""

#. Occurrence 5B_16:3078:6659: scene=5B_16
#: 5B_16:3078
msgctxt "text_id=6659 | speaker=unknown"
msgid "　呟いた声は、どこか誇らしげだった。"
msgstr "  She felt somewhat proud as she whispered those words."

#. Occurrence 5B_16:3083:6660: scene=5B_16
#: 5B_16:3083
msgctxt "text_id=6660 | speaker=unknown"
msgid "　本来なら<自戒|じかい>すべき事なのに、苦笑いしている自分にやれやれと肩をすくめる。"
msgstr "  Normally, it was something that she would beat herself up over, but instead, she simply shrugged her shoulders with a bitter smile."

#. Occurrence 5B_16:3088:6661: scene=5B_16
#: 5B_16:3088
msgctxt "text_id=6661 | speaker=unknown"
msgid "　それもこれも、いま傍らで眠っている誰かさんのおかげだろう。"
msgstr "  After all, it was thanks to the person sleeping by her side."

#. Occurrence 5B_16:3122:6662: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0029; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3122
msgctxt "text_id=6662 | speaker=aoko"
msgid "「……ね、聞こえてないわよね？」"
msgstr "\"...Hey. You can't hear me, can you?\""

#. Occurrence 5B_16:3128:6663: scene=5B_16
#: 5B_16:3128
msgctxt "text_id=6663 | speaker=unknown"
msgid "　夜風よりも小さい呼びかけに、反応はない。"
msgstr "  As if the night had swallowed her voice before it reached him, she received no response."

#. Occurrence 5B_16:3133:6664: scene=5B_16
#: 5B_16:3133
msgctxt "text_id=6664 | speaker=unknown"
msgid "　それに安心して、もっと小さい声で彼女は続ける。"
msgstr "  Confident, she continued in an even quieter voice."

#. Occurrence 5B_16:3155:6665: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0030; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3155
msgctxt "text_id=6665 | speaker=aoko"
msgid "「……その、ありがと。"
msgstr "\"So, uh, thank you."

msgctxt "text_id=6666 | speaker=unknown"
msgid "十分に助けてもらったわ」"
msgstr " You really got me out of a jam, there.\""

#. Occurrence 5B_16:3190:6667: scene=5B_16
#: 5B_16:3190
msgctxt "text_id=6667 | speaker=unknown"
msgid "　もちろん返事はないし、期待もしていない。たんに言っておきたかっただけだ。"
msgstr "  Of course, there was no response from Soujyuro, and she was not expecting one. Saying it for the record was enough."

#. Occurrence 5B_16:3239:6668: scene=5B_16
#: 5B_16:3239
msgctxt "text_id=6668 | speaker=unknown"
msgid "　少女はしばしうなされ眠る少年を眺めたあと、よし、と気持ちを入れ替えてポケットに手を伸ばした。"
msgstr "  Aoko watched Soujyuro sleep for a while and then pulled something out of her pocket."

#. Occurrence 5B_16:3259:6669: scene=5B_16
#: 5B_16:3259
msgctxt "text_id=6669 | speaker=unknown"
msgid "　同居人にもらった、手のひらに納まりそうなガラスの瓶を取り出して、ポン、と開封する。"
msgstr "  It was the palm-sized glass bottle her roommate had given her, which she opened with a pop."

#. Occurrence 5B_16:3266:6670: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0031; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3266
msgctxt "text_id=6670 | speaker=aoko"
msgid "「でも、それとこれとは別だから」"
msgstr "\"But none of this matters.\""

#. Occurrence 5B_16:3317:6671: scene=5B_16
#: 5B_16:3317
msgctxt "text_id=6671 | speaker=unknown"
msgid "　冬の夜風よりクールな一言を残して、彼女は彼の名前を呼びかけた。"
msgstr "  Leaving behind words colder than a winter chill at night, she called out his name."

#. Occurrence 5B_16:3326:6672: scene=5B_16
#: 5B_16:3326
msgctxt "text_id=6672 | speaker=unknown"
msgid "　返事もないのに、瓶はことり、と反応する。"
msgstr "  She barely sensed the bottle moving."

#. Occurrence 5B_16:3331:6673: scene=5B_16
#: 5B_16:3331
msgctxt "text_id=6673 | speaker=unknown"
msgid "　横になっている少年の姿がぐにゃりと歪んだかと思うと、瓶の重さが少しだけ増した気がした。"
msgstr "  As the silhouette of the fallen boy appeared to blur, she got the feeling that the weight of the bottle had increased slightly."

#. Occurrence 5B_16:3394:6674: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0032; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3394
msgctxt "text_id=6674 | speaker=aoko"
msgid "「うわ。どうなってんだろ、コレ」"
msgstr "\"Whoa. That's kind of weird.\""

#. Occurrence 5B_16:3400:6675: scene=5B_16
#: 5B_16:3400
msgctxt "text_id=6675 | speaker=unknown"
msgid "　<曇|くも>ったガラスごしには、たしかに人影のような形が見える。"
msgstr "  What appeared to be a human form could clearly be seen inside the glass."

#. Occurrence 5B_16:3420:6676: scene=5B_16
#: 5B_16:3420
msgctxt "text_id=6676 | speaker=unknown"
msgid "　久遠寺有珠の道具は、魔術師たちですら頭を悩ます神秘の具現だ。"
msgstr "  Alice Kuonji's tools were Mystics that confounded even the most knowledgeable of mages."

#. Occurrence 5B_16:3425:6677: scene=5B_16
#: 5B_16:3425
msgctxt "text_id=6677 | speaker=unknown"
msgid "　理屈やら辻褄を合わせようとする時点で、<魔術師|あおこ>には手の届かない魔術である。"
msgstr "  As soon as Aoko tried to analyze them with logic or reason, she was already out of her depth."

#. Occurrence 5B_16:3449:6678: scene=5B_16
#: 5B_16:3449
msgctxt "text_id=6678 | speaker=unknown"
msgid "　それに納得して瓶の蓋を閉めると、少年の姿は手品のようにかき消えた。"
msgstr "  Knowing this all too well, Aoko closed the bottle and watched the boy disappear as if by some magic trick."

#. Occurrence 5B_16:3519:6679: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0033; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3519
msgctxt "text_id=6679 | speaker=aoko"
msgid "「……まったく。こんなの手品じゃなくて魔法だって」"
msgstr "\"Jeez. This is no stage trick. It's actual magic.\""

#. Occurrence 5B_16:3525:6680: scene=5B_16
#: 5B_16:3525
msgctxt "text_id=6680 | speaker=unknown"
msgid "　ひとり呟いて、青子は魔法の瓶を覗きこむ。"
msgstr "  She muttered as she looked into the magical bottle."

#. Occurrence 5B_16:3530:6681: scene=5B_16
#: 5B_16:3530
msgctxt "text_id=6681 | speaker=unknown"
msgid "　瓶の重さはさして変わらないし、どんな仕組みかも青子には分からない。けれどたしかに、人間ひとりが閉じこめられている。"
msgstr "  Its weight had not changed significantly, and she had no idea how it worked, but the one thing she did know was that there was a human being inside of it."

#. Occurrence 5B_16:3600:6682: scene=5B_16
#: 5B_16:3600
msgctxt "text_id=6682 | speaker=unknown"
msgid "　その軽さは幻のようで、いまいち実感が湧かなかった。"
msgstr "  Its light weight was almost unnerving,"

#. Occurrence 5B_16:3605:6683: scene=5B_16
#: 5B_16:3605
msgctxt "text_id=6683 | speaker=unknown"
msgid "　人の重さというより風の重さだ。"
msgstr "  closer to empty air than a human being."

#. Occurrence 5B_16:3610:6684: scene=5B_16
#: 5B_16:3610
msgctxt "text_id=6684 | speaker=unknown"
msgid "　夏の風を手探りで掻き集めて、この瓶に詰めこんだのなら、ちょうどこれぐらいの重さになるだろう。"
msgstr "  It was about as heavy as one would expect if they'd bottled a summer breeze."

#. Occurrence 5B_16:3616:6685: scene=5B_16
#: 5B_16:3616
msgctxt "text_id=6685 | speaker=unknown"
msgid "　だから彼女にとって、草十郎はそんなイメージなのだ。"
msgstr "  Though, that did fit her image of Soujyuro perfectly."

#. Occurrence 5B_16:3668:6686: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0034; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3668
msgctxt "text_id=6686 | speaker=aoko"
msgid "「……有珠の言う通り」"
msgstr "\"It's just like Alice said...\""

#. Occurrence 5B_16:3674:6687: scene=5B_16
#: 5B_16:3674
msgctxt "text_id=6687 | speaker=unknown"
msgid "　そんな事を考えてしまった自分を振り返って、ぼんやりと彼女は呟く。"
msgstr "  She muttered to no one in particular as she recalled the past."

#. Occurrence 5B_16:3689:6688: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_16_0035; voice_prefix=A10; voice_category=1; scene=5B_16
#: 5B_16:3689
msgctxt "text_id=6688 | speaker=aoko"
msgid "「ほんと、私らしくない」"
msgstr "\"This really isn't like me.\""

#. Occurrence 5B_16:3735:6689: scene=5B_16
#: 5B_16:3735
msgctxt "text_id=6689 | speaker=unknown"
msgid "　いつもの不機嫌さではなく、微笑むように苦笑する。"
msgstr "  Aoko wore a bittersweet smile. Her usual moodiness was gone."

#. Occurrence 5B_16:3740:6690: scene=5B_16
#: 5B_16:3740
msgctxt "text_id=6690 | speaker=unknown"
msgid "　世の中は広いのだし。ひとりぐらいは、ペースを乱す相手がいるのも、張り合いがあっていい。"
msgstr "  It was a dangerous world out there. It was good to have someone to keep her on her toes."

#. Occurrence 5B_16:3760:6691: scene=5B_16
#: 5B_16:3760
msgctxt "text_id=6691 | speaker=unknown"
msgid "　苦笑しながら、一回だけこつん、と小さな魔法の瓶を指で弾くと、彼女は静かに歩きだした。"
msgstr "  With a wry chuckle, she flicked the magical bottle with her finger and set off walking."

#. Occurrence 5B_16:3827:6692: scene=5B_16
#: 5B_16:3827
msgctxt "text_id=6692 | speaker=unknown"
msgid "　遠く、終演のベルが鳴る。"
msgstr "  She could hear a bell in the distance, signaling the end of the play."

#. Occurrence 5B_16:3834:6693: scene=5B_16
#: 5B_16:3834
msgctxt "text_id=6693 | speaker=unknown"
msgid "　世は全て事もなく、うたかたの夢も元通り。"
msgstr "  An ephemeral dream gave way to reality. In the grand scheme of things, it had been but an instant."

#. Occurrence 5B_16:3839:6694: scene=5B_16
#: 5B_16:3839
msgctxt "text_id=6694 | speaker=unknown"
msgid "　役者の去った遊園地は、静かに<装飾|あかり>を消していく。"
msgstr "  As the actors exited stage left, the last of the lights silently flickered out."

#. Occurrence 5B_16:3860:6695: scene=5B_16
#: 5B_16:3860
msgctxt "text_id=6695 | speaker=unknown"
msgid "　……こうして。とうに寿命を迎えていた遊園地は少年と少女の思い出の地になって、その役割を終えたのだった。"
msgstr "  And so, the long-dead amusement park played its final role, as a memory for a boy and a girl."

#. Occurrence 5B_2:61:6696: scene=5B_2
#: 5B_2:61
msgctxt "text_id=6696 | speaker=unknown"
msgid "　かくして、遊園地は遠き日の輝きを取り戻した。"
msgstr "  Faded glory returned to Kitsy Land."

#. Occurrence 5B_2:168:6697: scene=5B_2
#: 5B_2:168
msgctxt "text_id=6697 | speaker=unknown"
msgid "　夜を照らす無数の電飾。"
msgstr "  The neon glow of innumerable lights illuminated the night."

#. Occurrence 5B_2:173:6698: scene=5B_2
#: 5B_2:173
msgctxt "text_id=6698 | speaker=unknown"
msgid "　スピーカーから流れるレコードの音。"
msgstr "  Speakers filled the air with the sound of vinyl music."

#. Occurrence 5B_2:178:6699: scene=5B_2
#: 5B_2:178
msgctxt "text_id=6699 | speaker=unknown"
msgid "　くるくると回りだす大小のゴーラウンド。"
msgstr "  Merry-go-rounds, small and large, whirled round and round."

#. Occurrence 5B_2:218:6700: scene=5B_2
#: 5B_2:218
msgctxt "text_id=6700 | speaker=unknown"
msgid "　……言うまでもなく、すべてあり得ない光景だ。"
msgstr "  All in all, it made for a mind-bending spectacle."

#. Occurrence 5B_2:223:6701: scene=5B_2
#: 5B_2:223
msgctxt "text_id=6701 | speaker=unknown"
msgid "　魔力を電流に変換して施設を動かす、というのも錬金術なら可能だろう。"
msgstr "  It was certainly possible to power the facilities by transmuting magical energy into electricity via alchemy."

#. Occurrence 5B_2:244:6702: scene=5B_2
#: 5B_2:244
msgctxt "text_id=6702 | speaker=unknown"
msgid "　―――だが。"
msgstr "  That said..."

#. Occurrence 5B_2:273:6703: scene=5B_2
#: 5B_2:273
msgctxt "text_id=6703 | speaker=unknown"
msgid "　仮に電気が供給されたとしても、壊れたものは蘇らない。"
msgstr "  Simply supplying the park with electricity would not have brought back to life that which was broken."

#. Occurrence 5B_2:278:6704: scene=5B_2
#: 5B_2:278
msgctxt "text_id=6704 | speaker=unknown"
msgid "　少女が調合しているものは化学式ではなく、摂理を<融|と>かす魔女の鍋に他ならない。"
msgstr "  The young woman did this not by mixing chemicals into a compound, but by melting down divine providence into a witch's brew."

#. Occurrence 5B_2:370:6705: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0000; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:370
msgctxt "text_id=6705 | speaker=aoko"
msgid "“……まずいわね。有珠のプロイは何個か見てきたけど、今回のはケタが違う―――”"
msgstr "(...This is bad. I've seen her Ploys, and this one is something completely new.)"

#. Occurrence 5B_2:416:6706: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0001; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:416
msgctxt "text_id=6706 | speaker=aoko"
msgid "「――――<接続|セット>」"
msgstr "\"...<Connecting.|Set.>\""

#. Occurrence 5B_2:435:6707: scene=5B_2
#: 5B_2:435
msgctxt "text_id=6707 | speaker=unknown"
msgid "　不安を押し殺し、青子は右腕の刻印に火をいれる。"
msgstr "  Stifling her anxiety, Aoko fired up the crest on her right arm."

#. Occurrence 5B_2:456:6708: scene=5B_2
#: 5B_2:456
msgctxt "text_id=6708 | speaker=unknown"
msgid "　魔術回路が魔術師の<基|エ><本|ン><性|ジ><能|ン>なら、"
msgstr "  If Magic Circuits were a mage's engine,"

msgctxt "text_id=6709 | speaker=unknown"
msgid "　刻印は魔術行使を補助する<演算装置|ソフトウェア>だ。"
msgstr "  then their crest was software that assisted their magecraft."

#. Occurrence 5B_2:464:6710: scene=5B_2
#: 5B_2:464
msgctxt "text_id=6710 | speaker=unknown"
msgid "　魔術師として半人前の青子を助ける切り札。"
msgstr "  For the fledgling mage Aoko, this was her trump card."

#. Occurrence 5B_2:469:6711: scene=5B_2
#: 5B_2:469
msgctxt "text_id=6711 | speaker=unknown"
msgid "　刻印化された術式なら魔力を通すだけで……その効能は劣化するにしても……再現できる、蒼崎の後継者の証である。"
msgstr "  All she had to do was supply magical energy to her crest-based formula. It may not have been the strongest magecraft, but it was hers; proof that she was the successor of the Aozaki lineage."

#. Occurrence 5B_2:550:6712: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0002; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:550
msgctxt "text_id=6712 | speaker=aoko"
msgid "「―――行使二層、直流数紋」"
msgstr "\"Execute double layer. Direct current to crest.\""

#. Occurrence 5B_2:588:6713: scene=5B_2
#: 5B_2:588
msgctxt "text_id=6713 | speaker=unknown"
msgid "　刻印の紋様を術式再現のカタチに切り替え、自身の魔力回路に繋ぐ。"
msgstr "  The pattern of her crest shifted to execute the formula, which then connected to her Magic Circuits."

#. Occurrence 5B_2:593:6714: scene=5B_2
#: 5B_2:593
msgctxt "text_id=6714 | speaker=unknown"
msgid "　列車の<路線変更|レールチェンジ>じみた、何十という回路の<形成|パズル>。"
msgstr "  The process resembled trains changing rails, a puzzle involving dozens of circuits."

#. Occurrence 5B_2:598:6715: scene=5B_2
#: 5B_2:598
msgctxt "text_id=6715 | speaker=unknown"
msgid "　それをできるだけ迅速に、可能な限り丁寧に組みたてる。"
msgstr "  She constructed it as swiftly as possible without sacrificing the quality of its construction."

#. Occurrence 5B_2:707:6716: scene=5B_2
#: 5B_2:707
msgctxt "text_id=6716 | speaker=unknown"
msgid "　<無詠唱|そくせき>の魔術では久遠寺有珠に届かない。"
msgstr "  Instant magecraft cast without an incantation would not be enough to reach Alice Kuonji."

#. Occurrence 5B_2:712:6717: scene=5B_2
#: 5B_2:712
msgctxt "text_id=6717 | speaker=unknown"
msgid "　先の魔弾で有珠を守る防壁の強度は<測|はか>った。"
msgstr "  Aoko had gauged the strength of Alice's defense with her initial shots."

#. Occurrence 5B_2:717:6718: scene=5B_2
#: 5B_2:717
msgctxt "text_id=6718 | speaker=unknown"
msgid "　今度は先の五倍、二十トンの衝撃を叩きこむ。"
msgstr "  She would dial up the power five times the next time, driving twenty tons of force into her target."

#. Occurrence 5B_2:722:6719: scene=5B_2
#: 5B_2:722
msgctxt "text_id=6719 | speaker=unknown"
msgid "　漂いだした濃霧の守りと、有珠が常に<纏|まと>っている障壁。"
msgstr "  Alice had the protection of the thick, hanging fog and the dense barrier around her."

#. Occurrence 5B_2:727:6720: scene=5B_2
#: 5B_2:727
msgctxt "text_id=6720 | speaker=unknown"
msgid "　両方合わせても十分に貫通する。"
msgstr "  However, this attack would be more than enough to pierce through both."

#. Occurrence 5B_2:786:6721: scene=5B_2
#: 5B_2:786
msgctxt "text_id=6721 | speaker=unknown"
msgid "　なので、当たりどころが悪ければ胸骨が心臓に刺さってノックアウト。"
msgstr "  If Aoko struck home, it could cave in Alice's chest and end the fight."

#. Occurrence 5B_2:791:6722: scene=5B_2
#: 5B_2:791
msgctxt "text_id=6722 | speaker=unknown"
msgid "　<最悪|さいあく>でも時計台からは撃ち落とせる、のだが―――"
msgstr "  At worst, it would at least knock Alice down from her position atop the clock tower."

#. Occurrence 5B_2:808:6723: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_2_0000; voice_prefix=A30; voice_category=3; scene=5B_2
#: 5B_2:808
msgctxt "text_id=6723 | speaker=soujuurou"
msgid "「あの、そろそろいいかな」"
msgstr "\"Hey, I have a question.\""

#. Occurrence 5B_2:814:6724: scene=5B_2
#: 5B_2:814
msgctxt "text_id=6724 | speaker=unknown"
msgid "　殺し合いモードに入った緊張感を台無しにする男がひとり。"
msgstr "  As always, there was one guy who spoiled the deadly tension, pulling Aoko out of killer mode."

#. Occurrence 5B_2:834:6725: scene=5B_2
#: 5B_2:834
msgctxt "text_id=6725 | speaker=unknown"
msgid "　さっきから難しい顔で青子と有珠を交互に観察していた草十郎は、"
msgstr "  Soujyuro had been looking back and forth between Aoko and Alice in confusion."

#. Occurrence 5B_2:846:6726: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_2_0001; voice_prefix=A30; voice_category=3; scene=5B_2
#: 5B_2:846
msgctxt "text_id=6726 | speaker=soujuurou"
msgid "「それで、どういう話になったんだ？」"
msgstr "\"What's going on now?\""

#. Occurrence 5B_2:859:6727: scene=5B_2
#: 5B_2:859
msgctxt "text_id=6727 | speaker=unknown"
msgid "　駅まではどう行くんですか？"
msgstr "  He said it like he might ask"

msgctxt "text_id=6728 | speaker=unknown"
msgid "　みたいな質問を口にするのだった。"
msgstr "for directions to the train station."

#. Occurrence 5B_2:909:6729: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0003; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:909
msgctxt "text_id=6729 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5B_2:914:6730: scene=5B_2
#: 5B_2:914
msgctxt "text_id=6730 | speaker=unknown"
msgid "　怒鳴り返したいところだが、こう真剣に訊かれると怒るより呆れてしまう。"
msgstr "  Normally, she would have lashed out in response, but his deadly serious tone shocked rather than angered her."

#. Occurrence 5B_2:944:6731: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0004; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:944
msgctxt "text_id=6731 | speaker=aoko"
msgid "“……信じられない。慣れてきた、私……”"
msgstr "\"...Unbelievable. Is this my life now?\""

#. Occurrence 5B_2:949:6732: scene=5B_2
#: 5B_2:949
msgctxt "text_id=6732 | speaker=unknown"
msgid "　青子はぐっとため息を飲みこんで、刻印の起動に意識を集中する。"
msgstr "  Aoko swallowed back a sigh and returned her focus to activating her crest."

#. Occurrence 5B_2:1018:6733: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0005; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:1018
msgctxt "text_id=6733 | speaker=aoko"
msgid "「交渉は決裂。ちょっと怒らせすぎた。"
msgstr "\"Negotiations have broken down. I pissed her off a bit too much."

#. Occurrence 5B_2:1024:6734: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0006; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:1024
msgctxt "text_id=6734 | speaker=aoko"
msgid "　あの子から見れば、まあいい機会だし、遊園地ごと私を亡きものにしようってハラね」"
msgstr "  From her perspective, this is a good chance to kill me off. Along with the entire theme park, I guess.\""

#. Occurrence 5B_2:1030:6735: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_2_0002; voice_prefix=A30; voice_category=3; scene=5B_2
#: 5B_2:1030
msgctxt "text_id=6735 | speaker=soujuurou"
msgid "「？？？」"
msgstr "\"???\""

#. Occurrence 5B_2:1035:6736: scene=5B_2
#: 5B_2:1035
msgctxt "text_id=6736 | speaker=unknown"
msgid "　もっと簡単な言い回しプリーズ、と首をかしげる草十郎。"
msgstr "  Soujyuro tilted his head, as if begging for a simpler explanation."

#. Occurrence 5B_2:1090:6737: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0007; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:1090
msgctxt "text_id=6737 | speaker=aoko"
msgid "「私、わりとあの子に恨まれてるから。捕まったが最後、どんな風に殺されるか想像すらできないわ。"
msgstr "\"She's really got it in for me. I can't even imagine what sort of death she has in store if she catches me."

#. Occurrence 5B_2:1102:6738: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0008; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:1102
msgctxt "text_id=6738 | speaker=aoko"
msgid "　……要するに、アンタも私も、あの子をどうにかしないと生きて帰れないってコトよ」"
msgstr "  ...What I'm saying is, neither of us are getting out of this alive unless we do something about her.\""

#. Occurrence 5B_2:1183:6739: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_2_0003; voice_prefix=A30; voice_category=3; scene=5B_2
#: 5B_2:1183
msgctxt "text_id=6739 | speaker=soujuurou"
msgid "「そんな、とばっちりだ！」"
msgstr "\"So you're saying I got dragged into your quarrel!?\""

#. Occurrence 5B_2:1283:6740: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0009; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:1283
msgctxt "text_id=6740 | speaker=aoko"
msgid "「まあ―――そういう事になるかもね！」"
msgstr "\"Pretty much!\""

#. Occurrence 5B_2:1377:6741: scene=5B_2
#: 5B_2:1377
msgctxt "text_id=6741 | speaker=unknown"
msgid "　この期におよんで空気読めていない草十郎の叫びに、青子は渾身の右腕を放つ。"
msgstr "  As Soujyuro protested in a tone wholly inappropriate to the situation, Aoko let another blast rip from her right arm."

#. Occurrence 5B_2:1382:6742: scene=5B_2
#: 5B_2:1382
msgctxt "text_id=6742 | speaker=unknown"
msgid "　狙いは草十郎ではない。"
msgstr "  She was not aiming at Soujyuro, though."

#. Occurrence 5B_2:1387:6743: scene=5B_2
#: 5B_2:1387
msgctxt "text_id=6743 | speaker=unknown"
msgid "　ちょっと前までの青子なら草十郎へ掃射していた気配濃厚だが、今は時計台に立つ黒衣の少女が優先される―――！"
msgstr "  A little earlier in the day and Aoko would have been happy to do exactly that, but now, her attention was focused on the girl in black atop the clock tower."

#. Occurrence 5B_2:1713:6744: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0010; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:1713
msgctxt "text_id=6744 | speaker=aoko"
msgid "「っ―――！！！？」"
msgstr "\"!?!?!?\""

#. Occurrence 5B_2:1719:6745: scene=5B_2
#: 5B_2:1719
msgctxt "text_id=6745 | speaker=unknown"
msgid "　あまりの驚きに状況把握が間に合わない。"
msgstr "  Aoko's mind struggled to catch up to her astonishment."

#. Occurrence 5B_2:1724:6746: scene=5B_2
#: 5B_2:1724
msgctxt "text_id=6746 | speaker=unknown"
msgid "　現状で考えられる最速／最高威力の魔弾を防がれた。"
msgstr "  She had fired the strongest, fastest magic bullet she had the ability to conjure, and Alice blocked it."

#. Occurrence 5B_2:1729:6747: scene=5B_2
#: 5B_2:1729
msgctxt "text_id=6747 | speaker=unknown"
msgid "　それはいい。"
msgstr "  That much was to be expected;"

#. Occurrence 5B_2:1734:6748: scene=5B_2
#: 5B_2:1734
msgctxt "text_id=6748 | speaker=unknown"
msgid "　有珠が本気で防御に徹すればそれぐらいはするだろう。"
msgstr "  when Alice set her mind to defending herself, such an attack was child's play."

#. Occurrence 5B_2:1807:6749: scene=5B_2
#: 5B_2:1807
msgctxt "text_id=6749 | speaker=unknown"
msgid "　だが今のは何事か。"
msgstr "  But what just happened?"

#. Occurrence 5B_2:1812:6750: scene=5B_2
#: 5B_2:1812
msgctxt "text_id=6750 | speaker=unknown"
msgid "　何か得体の知れないものが飛んできて有珠を守った。"
msgstr "  Something Aoko had never seen before leapt to Alice's defense."

#. Occurrence 5B_2:1817:6751: scene=5B_2
#: 5B_2:1817
msgctxt "text_id=6751 | speaker=unknown"
msgid "　馬？バッタ？いや、そもそもあんな生き物はこの世には存在しない。"
msgstr "  A team of horses? A plague of locusts? No―those existed in the real world, unlike what Aoko had just witnessed."

#. Occurrence 5B_2:1822:6752: scene=5B_2
#: 5B_2:1822
msgctxt "text_id=6752 | speaker=unknown"
msgid "　あんな風に―――雲霞のように群をなして、夜空を埋め尽くしたりはしない。"
msgstr "  Normal creatures could not form like a spontaneous cloud of fog and then dissipate just as quickly into the night sky."

#. Occurrence 5B_2:2151:6753: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0011; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:2151
msgctxt "text_id=6753 | speaker=aoko"
msgid "「な―――」"
msgstr "\"What...?\""

#. Occurrence 5B_2:2247:6754: scene=5B_2
#: 5B_2:2247
msgctxt "text_id=6754 | speaker=unknown"
msgid "　あり得ないものが、あり得ないカタチで動き出す。"
msgstr "  Impossible things moved in impossible ways."

#. Occurrence 5B_2:2252:6755: scene=5B_2
#: 5B_2:2252
msgctxt "text_id=6755 | speaker=unknown"
msgid "　少女は彼らに電源など与えていない。"
msgstr "  Alice was not even supplying them with any power source."

#. Occurrence 5B_2:2257:6756: scene=5B_2
#: 5B_2:2257
msgctxt "text_id=6756 | speaker=unknown"
msgid "　そも必要としていない。"
msgstr "  Those things never needed power in the first place."

#. Occurrence 5B_2:2262:6757: scene=5B_2
#: 5B_2:2262
msgctxt "text_id=6757 | speaker=unknown"
msgid "　壊れ、<棄|す>てられた彼らは、もう人間の<法則|ルール>には従わない。"
msgstr "  Those broken and discarded things did not follow the rules of mankind."

#. Occurrence 5B_2:2445:6758: scene=5B_2
#: 5B_2:2445
msgctxt "text_id=6758 | speaker=unknown"
msgid "　それは、おとぎ話の侵略だった。"
msgstr "  This was an invasion of fairy tales."

#. Occurrence 5B_2:2450:6759: scene=5B_2
#: 5B_2:2450
msgctxt "text_id=6759 | speaker=unknown"
msgid "　<自動人形|オートマタ>なぞ優しいものだ。"
msgstr "  Compared to them, the automaton looked merciful."

#. Occurrence 5B_2:2455:6760: scene=5B_2
#: 5B_2:2455
msgctxt "text_id=6760 | speaker=unknown"
msgid "　自律する人形は魔術の<業|わざ>によるものだが、それでも、人形としてのあり方を守っていた。"
msgstr "  Autonomous puppets were products of magecraft, but even then they behaved as puppets should."

#. Occurrence 5B_2:2460:6761: scene=5B_2
#: 5B_2:2460
msgctxt "text_id=6761 | speaker=unknown"
msgid "　だが―――動きだし、新たな命を得た<彼|・><ら|・>は、もう人形ですらない。"
msgstr "  These newly animated things, however, were nothing of the sort."

#. Occurrence 5B_2:2513:6762: scene=5B_2
#: 5B_2:2513
msgctxt "text_id=6762 | speaker=unknown"
msgid "　器物が生物に、"
msgstr "  Empty vessels became living creatures―"

#. Occurrence 5B_2:2518:6763: scene=5B_2
#: 5B_2:2518
msgctxt "text_id=6763 | speaker=unknown"
msgid "　模型が畸形に変貌する。"
msgstr "  dummies warped into malformed beings."

#. Occurrence 5B_2:2523:6764: scene=5B_2
#: 5B_2:2523
msgctxt "text_id=6764 | speaker=unknown"
msgid "　広がりつつあるのは視覚化できるほど濃密な魔力の霧と、"
msgstr "  There was a fog so dense with magical energy it visibly spread to all corners of the park,"

#. Occurrence 5B_2:2528:6765: scene=5B_2
#: 5B_2:2528
msgctxt "text_id=6765 | speaker=unknown"
msgid "　入園者を歓迎する、千を超える<怪物|クリーチャー>たち……！"
msgstr "  bringing with it a monstrous welcoming party that easily numbered over a thousand."

#. Occurrence 5B_2:2570:6766: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0012; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:2570
msgctxt "text_id=6766 | speaker=aoko"
msgid "「っ、―――！！！！」"
msgstr "\"...!!!\""

#. Occurrence 5B_2:2602:6767: scene=5B_2
#: 5B_2:2602
msgctxt "text_id=6767 | speaker=unknown"
msgid "　背中を走る戦慄につき動かされ、青子は一工程の魔弾を掃射する。"
msgstr "  Spurred on by the shuddering sensation running down her spine, Aoko fired a barrage of single-action magic bullets."

#. Occurrence 5B_2:2743:6768: scene=5B_2
#: 5B_2:2743
msgctxt "text_id=6768 | speaker=unknown"
msgid "　無我夢中の攻撃は無様に散った。"
msgstr "  Her impulsive attack scattered futilely."

#. Occurrence 5B_2:2818:6769: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0013; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:2818
msgctxt "text_id=6769 | speaker=aoko"
msgid "「あ―――」"
msgstr "\"Ah!\""

#. Occurrence 5B_2:2823:6770: scene=5B_2
#: 5B_2:2823
msgctxt "text_id=6770 | speaker=unknown"
msgid "　メリーゴーラウンドの騎士は空を飛び、"
msgstr "  The knights of the merry-go-round soared into the sky."

#. Occurrence 5B_2:2828:6771: scene=5B_2
#: 5B_2:2828
msgctxt "text_id=6771 | speaker=unknown"
msgid "　<緑|みどり>トカゲは火を吹きながら集まりだす。"
msgstr "  Green, fire-breathing lizards flocked."

#. Occurrence 5B_2:2833:6772: scene=5B_2
#: 5B_2:2833
msgctxt "text_id=6772 | speaker=unknown"
msgid "　焼きたてべーカリーは経営を再開し、オーブンからは人間大の焼きたてパンが小隊を組んで進軍する。"
msgstr "  The bakeries opened their doors once again, and human-sized loaves of fresh bread marched from their ovens as platoons of newly-baked soldiers."

#. Occurrence 5B_2:2885:6773: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_2_0004; voice_prefix=A30; voice_category=3; scene=5B_2
#: 5B_2:2885
msgctxt "text_id=6773 | speaker=soujuurou"
msgid "「―――蒼崎、後ろ！」"
msgstr "\"...Aozaki, behind you!\""

#. Occurrence 5B_2:2891:6774: scene=5B_2
#: 5B_2:2891
msgctxt "text_id=6774 | speaker=unknown"
msgid "　青子と草十郎は包囲されつつあった。"
msgstr "  Aoko and Soujyuro were completely surrounded."

#. Occurrence 5B_2:2896:6775: scene=5B_2
#: 5B_2:2896
msgctxt "text_id=6775 | speaker=unknown"
msgid "　軋みをあげてゆっくりとまわる観覧車。"
msgstr "  The Ferris wheel creaked as it gently turned."

#. Occurrence 5B_2:2901:6776: scene=5B_2
#: 5B_2:2901
msgctxt "text_id=6776 | speaker=unknown"
msgid "　涙に濡れたキッツィーを乗せて、ガラクタの車両がコースターを走っていく。"
msgstr "  A rickety train car raced about the roller coaster tracks with Kitsy, tears streaming down its face, aboard."

#. Occurrence 5B_2:2971:6777: scene=5B_2
#: 5B_2:2971
msgctxt "text_id=6777 | speaker=unknown"
msgid "　あまりにも歪んだ幻想。"
msgstr "  It was a grossly twisted fantasy."

#. Occurrence 5B_2:2976:6778: scene=5B_2
#: 5B_2:2976
msgctxt "text_id=6778 | speaker=unknown"
msgid "　赤く回りだした遊園地を背に、黒衣の少女は君臨する。"
msgstr "  The girl in black reigned over the insanity-fueled park."

#. Occurrence 5B_2:3028:6779: scene=5B_2
#: 5B_2:3028
msgctxt "text_id=6779 | speaker=unknown"
msgid "　ああ、これはない。"
msgstr "  Oh, now we're screwed."

#. Occurrence 5B_2:3033:6780: scene=5B_2
#: 5B_2:3033
msgctxt "text_id=6780 | speaker=unknown"
msgid "　これはないわ、と忘我しながら、青子はこの現象が何であるかに当たりをつけた。"
msgstr "  Aoko was transfixed by the scene unfolding around her. Then, she realized what was happening."

#. Occurrence 5B_2:3066:6781: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0014; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:3066
msgctxt "text_id=6781 | speaker=aoko"
msgid "「―――そうだ、これは」"
msgstr "\"...Oh, I know what this is.\""

#. Occurrence 5B_2:3072:6782: scene=5B_2
#: 5B_2:3072
msgctxt "text_id=6782 | speaker=unknown"
msgid "　有珠に聞いたマインスターの使い魔たち。"
msgstr "  Alice had once told her of Meinster's familiars."

#. Occurrence 5B_2:3077:6783: scene=5B_2
#: 5B_2:3077
msgctxt "text_id=6783 | speaker=unknown"
msgid "　その中でも三本指に入る折り紙付きの使い魔が、これと似た出来事を起こすハズだ。"
msgstr "  Among them were three of particular notoriety, one of which she recalled being capable of something similar to this."

#. Occurrence 5B_2:3082:6784: scene=5B_2
#: 5B_2:3082
msgctxt "text_id=6784 | speaker=unknown"
msgid "　名前は、たしか―――"
msgstr "  And it was called..."

#. Occurrence 5B_2:3104:6785: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0015; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:3104
msgctxt "text_id=6785 | speaker=aoko"
msgid "「<童話の怪物|プロイキッシャー>、フラットスナーク……！」"
msgstr "\"Ploy Kickshaw... Flat Snark!\""

#. Occurrence 5B_2:3140:6786: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_2_0005; voice_prefix=A30; voice_category=3; scene=5B_2
#: 5B_2:3140
msgctxt "text_id=6786 | speaker=soujuurou"
msgid "「蒼崎、だから後ろ！」"
msgstr "\"Seriously, Aozaki! Behind you!\""

#. Occurrence 5B_2:3241:6787: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0016; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:3241
msgctxt "text_id=6787 | speaker=aoko"
msgid "「―――！」"
msgstr "\"...!\""

#. Occurrence 5B_2:3301:6788: scene=5B_2
#: 5B_2:3301
msgctxt "text_id=6788 | speaker=unknown"
msgid "　青い魔弾を受け、木っ端微塵に砕け散るクリーチャー。"
msgstr "  Struck by Aoko's bullets, the creatures exploded into splinters."

#. Occurrence 5B_2:3306:6789: scene=5B_2
#: 5B_2:3306
msgctxt "text_id=6789 | speaker=unknown"
msgid "　青子の魔弾の威力があがっている、というのもあるが、一体一体は自動人形ほど頑丈ではないようだ。"
msgstr "  It was clear Aoko's shots were becoming more powerful, but it was also the case that these beings were less robust than your average automata."

#. Occurrence 5B_2:3360:6790: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0017; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:3360
msgctxt "text_id=6790 | speaker=aoko"
msgid "「静希君、こっち！」"
msgstr "\"Sizuki, this way!\""

#. Occurrence 5B_2:3366:6791: scene=5B_2
#: 5B_2:3366
msgctxt "text_id=6791 | speaker=unknown"
msgid "　青子は時計台に背を向けて、草十郎の手をとって走りだす。"
msgstr "  Aoko turned away from the clock tower, grabbed his hand, and began to run."

#. Occurrence 5B_2:3446:6792: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_2_0006; voice_prefix=A30; voice_category=3; scene=5B_2
#: 5B_2:3446
msgctxt "text_id=6792 | speaker=soujuurou"
msgid "「ちょっ、蒼崎！？」"
msgstr "\"Wait, Aozaki?!\""

#. Occurrence 5B_2:3452:6793: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0018; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:3452
msgctxt "text_id=6793 | speaker=aoko"
msgid "「ごめん、これ無理！"
msgstr "\"Sorry, no time!"

#. Occurrence 5B_2:3459:6794: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0019; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:3459
msgctxt "text_id=6794 | speaker=aoko"
msgid "　逃げるわよ！」"
msgstr "  We're running!\""

#. Occurrence 5B_2:3465:6795: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_2_0007; voice_prefix=A30; voice_category=3; scene=5B_2
#: 5B_2:3465
msgctxt "text_id=6795 | speaker=soujuurou"
msgid "「逃げるってどこに！？」"
msgstr "\"Running? To where?!\""

#. Occurrence 5B_2:3471:6796: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_2_0020; voice_prefix=A10; voice_category=1; scene=5B_2
#: 5B_2:3471
msgctxt "text_id=6796 | speaker=aoko"
msgid "「どこって、とにかく行けるところまで……！」"
msgstr "\"It doesn't matter! Anywhere!\""

#. Occurrence 5B_2:3555:6797: scene=5B_2
#: 5B_2:3555
msgctxt "text_id=6797 | speaker=unknown"
msgid "　自分に言い聞かせるように叫んで、青子は気合いで道を<拓|ひら>く。"
msgstr "  She shouted as though trying to persuade herself as she valiantly cleared a path."

#. Occurrence 5B_2:3560:6798: scene=5B_2
#: 5B_2:3560
msgctxt "text_id=6798 | speaker=unknown"
msgid "　放たれる魔弾は悲鳴そのものだ。"
msgstr "  Aoko's magic bullets flew like a scream."

#. Occurrence 5B_2:3565:6799: scene=5B_2
#: 5B_2:3565
msgctxt "text_id=6799 | speaker=unknown"
msgid "　立ちふさがる……というより、ただ集まっていただけのクリーチャーたちを吹き飛ばし、ふたりは包囲網を抜けだした。"
msgstr "  Blowing away the creatures that blocked―or simply gathered around―their path, she made a hole for them to escape through."

#. Occurrence 5B_3:365:6800: scene=5B_3
#: 5B_3:365
msgctxt "text_id=6800 | speaker=unknown"
msgid "　青い火花を散らす魔弾。"
msgstr "  Magical bullets exploded like blue fireworks."

#. Occurrence 5B_3:406:6801: scene=5B_3
#: 5B_3:406
msgctxt "text_id=6801 | speaker=unknown"
msgid "　波うつレンガの道を青子たちはひた走る。"
msgstr "  Aoko and Soujyuro ran down the bumpy brick road."

#. Occurrence 5B_3:411:6802: scene=5B_3
#: 5B_3:411
msgctxt "text_id=6802 | speaker=unknown"
msgid "　つり橋効果を遥かに超える戦場での信頼感。"
msgstr "  Their bond, forged in the heat of battle, went far beyond mutual convenience."

#. Occurrence 5B_3:416:6803: scene=5B_3
#: 5B_3:416
msgctxt "text_id=6803 | speaker=unknown"
msgid "　ふたりは全速力で、さしたる会話もアイコンタクトもなく、遊園地の出口を目指す。"
msgstr "  They headed for the park's exit at full speed without exchanging a word or a look."

#. Occurrence 5B_3:421:6804: scene=5B_3
#: 5B_3:421
msgctxt "text_id=6804 | speaker=unknown"
msgid "　この異常は遊園地の中だけのこと。"
msgstr "  The weirdness only extended as far as the park border,"

#. Occurrence 5B_3:426:6805: scene=5B_3
#: 5B_3:426
msgctxt "text_id=6805 | speaker=unknown"
msgid "　なら、外に出てしまえば助かるだろうと。"
msgstr "  so they would be safe as long as they made it outside."

#. Occurrence 5B_3:476:6806: scene=5B_3
#: 5B_3:476
msgctxt "text_id=6806 | speaker=unknown"
msgid "　が。"
msgstr "  But..."

#. Occurrence 5B_3:481:6807: scene=5B_3
#: 5B_3:481
msgctxt "text_id=6807 | speaker=unknown"
msgid "　戦力差、数にして二人対数百人。"
msgstr "  Speaking in pure numbers, the difference in strength was two versus an army."

#. Occurrence 5B_3:486:6808: scene=5B_3
#: 5B_3:486
msgctxt "text_id=6808 | speaker=unknown"
msgid "　もとい、一人対数百体。"
msgstr "  Or rather, one versus an army."

#. Occurrence 5B_3:491:6809: scene=5B_3
#: 5B_3:491
msgctxt "text_id=6809 | speaker=unknown"
msgid "　草十郎はほとんど使い物にならないし、"
msgstr "  Soujyuro was hardly useful in this situation,"

#. Occurrence 5B_3:491:6810: scene=5B_3
#: 5B_3:491
msgctxt "text_id=6810 | speaker=unknown"
msgid "　襲いかかってくるのは人というより<人形|パペット>である。"
msgstr "  and \"man\"-power wasn't really the issue here, since they were facing puppets."

#. Occurrence 5B_3:543:6811: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0000; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:543
msgctxt "text_id=6811 | speaker=aoko"
msgid "「さっきの大丈夫！？"
msgstr "\"You okay!?"

#. Occurrence 5B_3:543:6812: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0000; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:543
msgctxt "text_id=6812 | speaker=aoko"
msgid "　上からこう、でっかいハサミが落ちてきたけど！」"
msgstr "  Those were some giant pincers back there!\""

#. Occurrence 5B_3:549:6813: scene=5B_3
#: 5B_3:549
msgctxt "text_id=6813 | speaker=unknown"
msgid "　立ちふさがる怪物を撃ち砕きながら青子が叫ぶ。"
msgstr "  Aoko shouted as she blasted away the monsters that stood in their path."

#. Occurrence 5B_3:554:6814: scene=5B_3
#: 5B_3:554
msgctxt "text_id=6814 | speaker=unknown"
msgid "　振り向く余裕も、立ち止まっている暇もない。"
msgstr "  There was no time to stop for breath, or even to look back."

#. Occurrence 5B_3:585:6815: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_3_0000; voice_prefix=A30; voice_category=3; scene=5B_3
#: 5B_3:585
msgctxt "text_id=6815 | speaker=soujuurou"
msgid "「なんとか、ギリギリ！」"
msgstr "\"Yeah, just barely!\""

#. Occurrence 5B_3:591:6816: scene=5B_3
#: 5B_3:591
msgctxt "text_id=6816 | speaker=unknown"
msgid "　青子を追う草十郎も、さすがに声がうわずっている。"
msgstr "  As Soujyuro pursued, his voice, too, had naturally become shrill."

#. Occurrence 5B_3:691:6817: scene=5B_3
#: 5B_3:691
msgctxt "text_id=6817 | speaker=unknown"
msgid "　―――さかのぼること五分前。"
msgstr "  ...Five minutes earlier."

#. Occurrence 5B_3:697:6818: scene=5B_3
#: 5B_3:697
msgctxt "text_id=6818 | speaker=unknown"
msgid "　広場の包囲網からは呆気なく抜け出せた。"
msgstr "  They had broken out of the siege at the plaza surprisingly fast."

#. Occurrence 5B_3:702:6819: scene=5B_3
#: 5B_3:702
msgctxt "text_id=6819 | speaker=unknown"
msgid "　住人たちの“目覚め”には個体差があって、大きなものほど動きだすには時間が必要らしい。"
msgstr "  It seemed that the residents' awakening differed case-by-case, with larger creatures taking additional time."

#. Occurrence 5B_3:772:6820: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0001; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:772
msgctxt "text_id=6820 | speaker=aoko"
msgid "「ラッキー、朝に弱いタイプばっかとみた！」"
msgstr "\"We're lucky they're not the morning type!\""

#. Occurrence 5B_3:778:6821: scene=5B_3
#: 5B_3:778
msgctxt "text_id=6821 | speaker=unknown"
msgid "　青子は軽口を言って、ひょっこり現れたザコをなぎ払う。"
msgstr "  Aoko joked as she mowed down the small fry that popped up."

#. Occurrence 5B_3:799:6822: scene=5B_3
#: 5B_3:799
msgctxt "text_id=6822 | speaker=unknown"
msgid "　そんな時。"
msgstr "  But then."

#. Occurrence 5B_3:825:6823: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0002; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:825
msgctxt "text_id=6823 | speaker=aoko"
msgid "「へ？」"
msgstr "\"Eh?\""

#. Occurrence 5B_3:830:6824: scene=5B_3
#: 5B_3:830
msgctxt "text_id=6824 | speaker=unknown"
msgid "　突如、ふたりの頭上にとんでもないモノが伸びてきた。"
msgstr "  Without warning, something outrageous extended its way down from above them."

#. Occurrence 5B_3:1002:6825: scene=5B_3
#: 5B_3:1002
msgctxt "text_id=6825 | speaker=unknown"
msgid "　ロブスター<専門店|レストラン>の屋根に鎮座していた、全長18メートルのザリガニ、そのハサミである。"
msgstr "  It was the claws of the sixty-foot lobster adorning the roof of a seafood restaurant."

#. Occurrence 5B_3:1122:6826: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0003; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:1122
msgctxt "text_id=6826 | speaker=aoko"
msgid "「…………！」"
msgstr "\"...!\""

#. Occurrence 5B_3:1127:6827: scene=5B_3
#: 5B_3:1127
msgctxt "text_id=6827 | speaker=unknown"
msgid "　ほとんどギロチンのようなハサミだった。"
msgstr "  Its pincers were like a guillotine."

#. Occurrence 5B_3:1132:6828: scene=5B_3
#: 5B_3:1132
msgctxt "text_id=6828 | speaker=unknown"
msgid "　レストラン前を横切る青子たちを、凄まじいスピードでまっ二つにしようと迫る<赤い甲殻類|レッドキング>。"
msgstr "  As Aoko and Soujyuro cut across the front of the restaurant, the red king pressed in at tremendous speed, keen on splitting them each in two."

#. Occurrence 5B_3:1205:6829: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0004; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:1205
msgctxt "text_id=6829 | speaker=aoko"
msgid "「静希君、ユーターン！　こっちはダメ！」"
msgstr "\"Sizuki, hard about! This way's no good!\""

#. Occurrence 5B_3:1211:6830: scene=5B_3
#: 5B_3:1211
msgctxt "text_id=6830 | speaker=unknown"
msgid "　ロブスター店を抜ければすぐに<正門|ゲート>だったが、ふたりは巨大ザリガニから逃れるように遠回りをする。"
msgstr "  The gate was just on the other side of the restaurant, but they had to take the long way around in order to lose the giant lobster snapping at their heels."

#. Occurrence 5B_3:1216:6831: scene=5B_3
#: 5B_3:1216
msgctxt "text_id=6831 | speaker=unknown"
msgid "　そうして迂回した先に待ち受けていたのは、おびただしいまでの怪物の群だった。"
msgstr "  Waiting along their detour had been a horde of monsters, too many to count."

#. Occurrence 5B_3:1263:6832: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_3_0001; voice_prefix=A30; voice_category=3; scene=5B_3
#: 5B_3:1263
msgctxt "text_id=6832 | speaker=soujuurou"
msgid "「なんとか、ギリギリ！」"
msgstr "\"Yeah, just barely!\""

#. Occurrence 5B_3:1303:6833: scene=5B_3
#: 5B_3:1303
msgctxt "text_id=6833 | speaker=unknown"
msgid "　あやうく首からすっぱり切られそうだったピンチを思いだしながら、草十郎は青子に叫び返す。"
msgstr "  Soujyuro called out in response, recalling just how narrowly he had avoided his head being severed clean from his body."

#. Occurrence 5B_3:1355:6834: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_3_0002; voice_prefix=A30; voice_category=3; scene=5B_3
#: 5B_3:1355
msgctxt "text_id=6834 | speaker=soujuurou"
msgid "「って前！　うわ、なんだあれ、焼きたてか！？」"
msgstr "\"In front of us! What the heck are those? Are they freshly baked!?\""

#. Occurrence 5B_3:1361:6835: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0005; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:1361
msgctxt "text_id=6835 | speaker=aoko"
msgid "「そうみたいね、要するに下級兵士よ！」"
msgstr "\"It looks like it! In other words, they're the cannon fodder!\""

#. Occurrence 5B_3:1421:6836: scene=5B_3
#: 5B_3:1421
msgctxt "text_id=6836 | speaker=unknown"
msgid "　青子は駆け足を止めて魔術刻印をフル回転させる。"
msgstr "  Aoko halted her sprint and set her crest into full operation."

#. Occurrence 5B_3:1428:6837: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0006; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:1428
msgctxt "text_id=6837 | speaker=aoko"
msgid "“距離七、六、五メートル……！"
msgstr "(Range: seven, six, five yards...!"

msgctxt "text_id=6838 | speaker=unknown"
msgid "　あの程度ならスナップだけで事足りる……！”"
msgstr "  At this distance, Snap'll take them down!)"

#. Occurrence 5B_3:1523:6839: scene=5B_3
#: 5B_3:1523
msgctxt "text_id=6839 | speaker=unknown"
msgid "　レンガの道を滑りながら右腕を一閃する。"
msgstr "  Sliding along the brick path, she brandished her right arm."

#. Occurrence 5B_3:1528:6840: scene=5B_3
#: 5B_3:1528
msgctxt "text_id=6840 | speaker=unknown"
msgid "　放たれる魔弾の雨。"
msgstr "  She loosed a shower of magic bullets."

#. Occurrence 5B_3:1571:6841: scene=5B_3
#: 5B_3:1571
msgctxt "text_id=6841 | speaker=unknown"
msgid "　威力より弾数を優先した<一工程|スナップ>は、立ちふさがる怪物たちを小気味良くまき散らかす。"
msgstr "  Snap was a single-action spell that favored rate of fire over power, and it mowed down the monsters with satisfying pops."

#. Occurrence 5B_3:1625:6842: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_3_0003; voice_prefix=A30; voice_category=3; scene=5B_3
#: 5B_3:1625
msgctxt "text_id=6842 | speaker=soujuurou"
msgid "「―――蒼崎、そっちも！」"
msgstr "\"...Aozaki, more over there!\""

#. Occurrence 5B_3:1705:6843: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0007; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:1705
msgctxt "text_id=6843 | speaker=aoko"
msgid "「了解……！」"
msgstr "\"Roger that!\""

#. Occurrence 5B_3:1862:6844: scene=5B_3
#: 5B_3:1862
msgctxt "text_id=6844 | speaker=unknown"
msgid "　電飾のついた遊歩道に、青い火花が咲き乱れる。"
msgstr "  Blue explosions bloomed along the lamp-lit promenade."

#. Occurrence 5B_3:1867:6845: scene=5B_3
#: 5B_3:1867
msgctxt "text_id=6845 | speaker=unknown"
msgid "　扇状に弾幕をはる青子の姿は、空から<俯瞰|ふかん>すれば美しいスターマインそのものだ。"
msgstr "  Aoko's curtain of fire fanned out―it was a marvelous Starmine fireworks show."

#. Occurrence 5B_3:1872:6846: scene=5B_3
#: 5B_3:1872
msgctxt "text_id=6846 | speaker=unknown"
msgid "　焼きたてパンの<遊び道具|レイカンファー>、ブレッドマンではそれこそ消し<炭|ずみ>にされるだけ。"
msgstr "  The toy bread-men turned to charcoal."

#. Occurrence 5B_3:1954:6847: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0008; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:1954
msgctxt "text_id=6847 | speaker=aoko"
msgid "“いける―――数でこそ押されてるけど、この状態が続くなら逃げきれる―――！”"
msgstr "(We can do this! They've got us overpowered in numbers, but at this rate we'll be able to get out of here!)"

#. Occurrence 5B_3:1969:6848: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_3_0009; voice_prefix=A10; voice_category=1; scene=5B_3
#: 5B_3:1969
msgctxt "text_id=6848 | speaker=aoko"
msgid "「静希君、そっちは！？」"
msgstr "\"Sizuki, how's it look over there!?\""

#. Occurrence 5B_3:2020:6849: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_3_0004; voice_prefix=A30; voice_category=3; scene=5B_3
#: 5B_3:2020
msgctxt "text_id=6849 | speaker=soujuurou"
msgid "「いない、空いてる！　ここからなら入り口の東側に出られるはずだ！」"
msgstr "\"Looks clear to me! We should be able to approach the exit from the east!\""

#. Occurrence 5B_3:2098:6850: scene=5B_3
#: 5B_3:2098
msgctxt "text_id=6850 | speaker=unknown"
msgid "　並の魔術師なら息切れをする数の魔弾を放ちながら、新米魔術師は敵の囲みを突破する。"
msgstr "  With a magical barrage that would leave an average spellcaster blue in the face, the novice mage broke through the siege."

#. Occurrence 5B_3:2105:6851: scene=5B_3
#: 5B_3:2105
msgctxt "text_id=6851 | speaker=unknown"
msgid "　……一方。"
msgstr "  Meanwhile..."

#. Occurrence 5B_3:2110:6852: scene=5B_3
#: 5B_3:2110
msgctxt "text_id=6852 | speaker=unknown"
msgid "　そんな光景を、じっくりと観察する鳥が一羽。"
msgstr "  A single bird keenly watched everything unfold."

#. Occurrence 5B_4:119:6853: scene=5B_4
#: 5B_4:119
msgctxt "text_id=6853 | speaker=unknown"
msgid "　チ、チチチ、チ！"
msgstr "  Chirp, cheep-cheep-cheep, chirp!"

#. Occurrence 5B_4:124:6854: scene=5B_4
#: 5B_4:124
msgctxt "text_id=6854 | speaker=unknown"
msgid "　高度を落として主人の視界に入るなり、かん高く鳴く青い鳥。"
msgstr "  The moment the blue bird descended into its master's field of vision, it made its high-pitched call."

#. Occurrence 5B_4:129:6855: scene=5B_4
#: 5B_4:129
msgctxt "text_id=6855 | speaker=unknown"
msgid "　その報告を、少女は無表情で聞いている。"
msgstr "  The girl listened expressionlessly to the report."

#. Occurrence 5B_4:150:6856: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_4_0000; voice_prefix=A40; voice_category=2; scene=5B_4
#: 5B_4:150
msgctxt "text_id=6856 | speaker=alice"
msgid "「……かまわないわ、予想通りよ。"
msgstr "\"...No matter. Everything is going as expected."

#. Occurrence 5B_4:156:6857: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_4_0001; voice_prefix=A40; voice_category=2; scene=5B_4
#: 5B_4:156
msgctxt "text_id=6857 | speaker=alice"
msgid "　撃つ事、壊す事しか能がなくても、青子の魔力の使い方は並じゃないから。急造の使い魔じゃ、まだ相手にはならないでしょう」"
msgstr "  Even if she only knows how to shoot and destroy, the way Aoko uses magical energy is extraordinary. Hastily formed familiars are no match for her.\""

#. Occurrence 5B_4:178:6858: scene=5B_4
#: 5B_4:178
msgctxt "text_id=6858 | speaker=unknown"
msgid "　チチチ、と羽をすくめる駒鳥。"
msgstr "  The robin flapped its wings as it tweeted in response."

#. Occurrence 5B_4:183:6859: scene=5B_4
#: 5B_4:183
msgctxt "text_id=6859 | speaker=unknown"
msgid "　青子を<誉|ほ>める有珠を批難しているのか、"
msgstr "  Perhaps it was criticizing Alice for complimenting Aoko."

#. Occurrence 5B_4:188:6860: scene=5B_4
#: 5B_4:188
msgctxt "text_id=6860 | speaker=unknown"
msgid "　有珠に誉められる青子に嫉妬しているのか。"
msgstr "  Or, perhaps it was jealous of Aoko for being praised by Alice."

#. Occurrence 5B_4:193:6861: scene=5B_4
#: 5B_4:193
msgctxt "text_id=6861 | speaker=unknown"
msgid "　主人である有珠にも、いまいち読み取れない鳴き声である。"
msgstr "  Alice could barely make sense of its chirping rant."

#. Occurrence 5B_4:297:6862: scene=5B_4
#: 5B_4:297
msgctxt "text_id=6862 | speaker=unknown"
msgid "　蒼崎青子は半人前の魔術師だ。"
msgstr "  Aoko Aozaki was a novice mage."

#. Occurrence 5B_4:302:6863: scene=5B_4
#: 5B_4:302
msgctxt "text_id=6863 | speaker=unknown"
msgid "　二年前まで魔術とは無関係に育ってきた少女で、生まれた時から魔女として育った有珠とは素質も経験も違いすぎる。"
msgstr "  Until just two years ago, she had grown up with no background in magecraft. Compared to Alice, who was raised as a witch from birth, Aoko possessed far less talent and experience."

#. Occurrence 5B_4:307:6864: scene=5B_4
#: 5B_4:307
msgctxt "text_id=6864 | speaker=unknown"
msgid "　本来なら相手にすらしない次元。"
msgstr "  There was simply no comparison to be made―"

#. Occurrence 5B_4:312:6865: scene=5B_4
#: 5B_4:312
msgctxt "text_id=6865 | speaker=unknown"
msgid "　魔術の腕を競うなら十回中十回、有珠に軍配があがるだろう。"
msgstr "  in a contest of skills in magecraft, ten times out of ten, Alice would be declared the victor."

#. Occurrence 5B_4:332:6866: scene=5B_4
#: 5B_4:332
msgctxt "text_id=6866 | speaker=unknown"
msgid "　けれど、こと戦い、殺し合いなら話は別だ。"
msgstr "  However, that narrative changed when it came to a battle for life-or-death."

#. Occurrence 5B_4:337:6867: scene=5B_4
#: 5B_4:337
msgctxt "text_id=6867 | speaker=unknown"
msgid "　久遠寺有珠は戦闘向きの魔術師ではなく、"
msgstr "  Alice Kuonji was not the type of mage suited to combat,"

#. Occurrence 5B_4:342:6868: scene=5B_4
#: 5B_4:342
msgctxt "text_id=6868 | speaker=unknown"
msgid "　蒼崎青子は戦いに特化した壊し屋である。"
msgstr "  while Aoko Aozaki, on the other hand, was built for it."

#. Occurrence 5B_4:348:6869: scene=5B_4
#: 5B_4:348
msgctxt "text_id=6869 | speaker=unknown"
msgid "　純粋な魔力勝負では青子の方が上だろう、と有珠は認めてさえいる。"
msgstr "  In a contest that pitted magical energy against magical energy, even Alice would concede that Aoko had the upper hand."

#. Occurrence 5B_4:368:6870: scene=5B_4
#: 5B_4:368
msgctxt "text_id=6870 | speaker=unknown"
msgid "　青子は魔力の使い方が抜群に上手い。"
msgstr "  Aoko's manipulation of magical energy was extraordinary."

#. Occurrence 5B_4:373:6871: scene=5B_4
#: 5B_4:373
msgctxt "text_id=6871 | speaker=unknown"
msgid "　魔術回路の規模は有珠より小さいが、回路の回転の速さ、その耐久構造、魔力の質、燃費の良さが並はずれている。"
msgstr "  The scale of her Magic Circuits was smaller than that of Alice, but their rotational speed, durability, and output quality―not to mention efficiency―were otherworldly."

#. Occurrence 5B_4:378:6872: scene=5B_4
#: 5B_4:378
msgctxt "text_id=6872 | speaker=unknown"
msgid "　それが蒼崎青子の特性だ。"
msgstr "  That was Aoko Aozaki's hallmark."

#. Occurrence 5B_4:384:6873: scene=5B_4
#: 5B_4:384
msgctxt "text_id=6873 | speaker=unknown"
msgid "　高度な魔術式は凡百に落ちるが、"
msgstr "  Though she had many failings when handling sophisticated formulae,"

msgctxt "text_id=6874 | speaker=unknown"
msgid "　魔力を流動させるだけの単純な魔術式なら、わずか二年の実践で有珠を上回っている。"
msgstr "  in just two years of practice, Aoko had surpassed Alice in simple formulae that merely required an energy input."

#. Occurrence 5B_4:406:6875: scene=5B_4
#: 5B_4:406
msgctxt "text_id=6875 | speaker=unknown"
msgid "　……天才的なノリの良さと勘の良さ。"
msgstr "  She also had a genius' instincts and adaptability."

#. Occurrence 5B_4:411:6876: scene=5B_4
#: 5B_4:411
msgctxt "text_id=6876 | speaker=unknown"
msgid "　彼女の魔術行使は強いのではなく、おそろしく“速い”のだ。"
msgstr "  Though Aoko was not particularly proficient at executing magecraft, she was terrifyingly fast."

#. Occurrence 5B_4:416:6877: scene=5B_4
#: 5B_4:416
msgctxt "text_id=6877 | speaker=unknown"
msgid "　蒼崎の家になんて生まれなければ、天才的な射撃手として名を<馳|は>せたに違いない。"
msgstr "  If she had been born outside the Aozaki clan, she would have doubtless risen to fame as a competitive sharpshooter."

#. Occurrence 5B_4:476:6878: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_4_0002; voice_prefix=A40; voice_category=2; scene=5B_4
#: 5B_4:476
msgctxt "text_id=6878 | speaker=alice"
msgid "「でも、残念ね」"
msgstr "\"What a pity.\""

#. Occurrence 5B_4:482:6879: scene=5B_4
#: 5B_4:482
msgctxt "text_id=6879 | speaker=unknown"
msgid "　正面から撃ちあえば有珠に勝ち目はない。"
msgstr "  In a straight shootout, Alice did not stand a chance."

#. Occurrence 5B_4:487:6880: scene=5B_4
#: 5B_4:487
msgctxt "text_id=6880 | speaker=unknown"
msgid "　否、そもそも魔弾などという原始的な魔術を、久遠寺有珠は習得していない。"
msgstr "  Alice Kuonji had never bothered to learn primitive magecraft like magic bullets in the first place."

#. Occurrence 5B_4:492:6881: scene=5B_4
#: 5B_4:492
msgctxt "text_id=6881 | speaker=unknown"
msgid "　彼女は典型的な人形師。"
msgstr "  She was the classic puppeteer."

#. Occurrence 5B_4:497:6882: scene=5B_4
#: 5B_4:497
msgctxt "text_id=6882 | speaker=unknown"
msgid "　戦闘はすべて、手足となる使い魔が行うことだ。"
msgstr "  Her familiars served as her arms and legs to carry out all the particulars of a battle."

#. Occurrence 5B_4:597:6883: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_4_0003; voice_prefix=A40; voice_category=2; scene=5B_4
#: 5B_4:597
msgctxt "text_id=6883 | speaker=alice"
msgid "「……制限時間には気づいているわよね青子。"
msgstr "\"Clock's ticking, Aoko."

#. Occurrence 5B_4:603:6884: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_4_0004; voice_prefix=A40; voice_category=2; scene=5B_4
#: 5B_4:603
msgctxt "text_id=6884 | speaker=alice"
msgid "　魔力はいくらでも貸してあげるけど―――貴女の魔弾は、あと半刻で<値崩|ねくず>れするわ」"
msgstr "  I'm happy to lend you all the ammunition you like, but after an hour, those bullets will be worthless.\""

#. Occurrence 5B_4:659:6885: scene=5B_4
#: 5B_4:659
msgctxt "text_id=6885 | speaker=unknown"
msgid "　チチチ、と<頷|うなず>くようにさえずって飛び立つ駒鳥。"
msgstr "  Chirping as if in agreement, the robin took flight."

#. Occurrence 5B_4:665:6886: scene=5B_4
#: 5B_4:665
msgctxt "text_id=6886 | speaker=unknown"
msgid "　遊園地が少女の支配下に<陥|おちい>ってからじき十分。"
msgstr "  It had been nearly ten minutes since Alice had made the amusement park into her dominion."

#. Occurrence 5B_4:670:6887: scene=5B_4
#: 5B_4:670
msgctxt "text_id=6887 | speaker=unknown"
msgid "　<緑|みどり>色の霧が何を生み出すものなのか。"
msgstr "  To what would the green fog give birth next?"

#. Occurrence 5B_4:675:6888: scene=5B_4
#: 5B_4:675
msgctxt "text_id=6888 | speaker=unknown"
msgid "　地上を走る青子たちも、そろそろ事の深刻さに気が付く頃だった。"
msgstr "  Aoko and Soujyuro, still running about, would soon come to understand the gravity of their situation."

#. Occurrence 5B_5:103:6889: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0000; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:103
msgctxt "text_id=6889 | speaker=aoko"
msgid "「静希君、正門ってこっち！？」"
msgstr "\"Sizuki, is this the way out?!\""

#. Occurrence 5B_5:109:6890: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0000; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:109
msgctxt "text_id=6890 | speaker=soujuurou"
msgid "「ああ、その店を曲がれば出口だ！」"
msgstr "\"Yeah, the exit is just around that store!\""

#. Occurrence 5B_5:210:6891: scene=5B_5
#: 5B_5:210
msgctxt "text_id=6891 | speaker=unknown"
msgid "　全力とは言わずとも、休まずに走り続けてはや十分。"
msgstr "  Running nonstop at full speed had them at their limits."

#. Occurrence 5B_5:210:6892: scene=5B_5
#: 5B_5:210
msgctxt "text_id=6892 | speaker=unknown"
msgid "　息を乱しながらふたりは曲がり角に飛びこんだ。"
msgstr "  Their breath ragged, the duo rounded a corner at a breakneck pace."

#. Occurrence 5B_5:215:6893: scene=5B_5
#: 5B_5:215
msgctxt "text_id=6893 | speaker=unknown"
msgid "　遊園地と言っても所詮はキッツィーランド。"
msgstr "  Amusement park though it was, this was still the infamous Kitsy Land."

#. Occurrence 5B_5:220:6894: scene=5B_5
#: 5B_5:220
msgctxt "text_id=6894 | speaker=unknown"
msgid "　高校生が全力で走れば二十分ほどで一周できる。"
msgstr "  It would have taken a high school student twenty minutes to sprint the entire circumference of the park."

#. Occurrence 5B_5:248:6895: scene=5B_5
#: 5B_5:248
msgctxt "text_id=6895 | speaker=unknown"
msgid "　そんな地域密着型のアミューズメントパークは、しかし。"
msgstr "  And though they were now intimately familiar with the park's geography..."

#. Occurrence 5B_5:463:6896: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0001; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:463
msgctxt "text_id=6896 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5B_5:469:6897: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0001; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:469
msgctxt "text_id=6897 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5B_5:474:6898: scene=5B_5
#: 5B_5:474
msgctxt "text_id=6898 | speaker=unknown"
msgid "　……このように。"
msgstr "  ...It was changing beyond recognition. "

#. Occurrence 5B_5:479:6899: scene=5B_5
#: 5B_5:479
msgctxt "text_id=6899 | speaker=unknown"
msgid "　住人ばかりか、遊園地そのものを変化させていた。"
msgstr "  The transformation was not limited to the park's residents, either."

#. Occurrence 5B_5:573:6900: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0002; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:573
msgctxt "text_id=6900 | speaker=soujuurou"
msgid "「……蒼崎」"
msgstr "\"Aozaki?\""

#. Occurrence 5B_5:585:6901: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0002; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:585
msgctxt "text_id=6901 | speaker=aoko"
msgid "「……なによ」"
msgstr "\"...What?!\""

#. Occurrence 5B_5:596:6902: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0003; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:596
msgctxt "text_id=6902 | speaker=soujuurou"
msgid "「……言いたくないんだけど。この遊園地、広くなってないか？」"
msgstr "\"I hate to ask, but... is it just me, or is the park getting bigger?\""

#. Occurrence 5B_5:621:6903: scene=5B_5
#: 5B_5:621
msgctxt "text_id=6903 | speaker=unknown"
msgid "　そう。"
msgstr "  It was."

#. Occurrence 5B_5:627:6904: scene=5B_5
#: 5B_5:627
msgctxt "text_id=6904 | speaker=unknown"
msgid "出口を間違えたとか、地形が変わっているとか、そんな現実的な間違いではない。"
msgstr "Their problem wasn't as mundane as mistaking the location of the exits, nor the strange terrain."

#. Occurrence 5B_5:633:6905: scene=5B_5
#: 5B_5:633
msgctxt "text_id=6905 | speaker=unknown"
msgid "　あらゆるものが、ねじ曲がっている。"
msgstr "  No, the park was warping and twisting in upon itself."

#. Occurrence 5B_5:639:6906: scene=5B_5
#: 5B_5:639
msgctxt "text_id=6906 | speaker=unknown"
msgid "　遊園地はそれ自体が生き物のように、いまもって、その規模を成長させていた。"
msgstr "  Even as they ran, its structure was expanding and growing, like that of a living creature."

#. Occurrence 5B_5:749:6907: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0004; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:749
msgctxt "text_id=6907 | speaker=soujuurou"
msgid "「―――」"
msgstr "\"...\""

#. Occurrence 5B_5:755:6908: scene=5B_5
#: 5B_5:755
msgctxt "text_id=6908 | speaker=unknown"
msgid "　気が付けば包囲網は一段と強固になっている。"
msgstr "  Soon, the pair noticed that the mob encircling them had grown even stronger."

#. Occurrence 5B_5:775:6909: scene=5B_5
#: 5B_5:775
msgctxt "text_id=6909 | speaker=unknown"
msgid "　草十郎に背中をあずけながら、青子は懸命に泣き言を抑えこむ。"
msgstr "  Entrusting her back to Soujyuro, Aoko summoned all of her effort just to keep from whining."

#. Occurrence 5B_5:780:6910: scene=5B_5
#: 5B_5:780
msgctxt "text_id=6910 | speaker=unknown"
msgid "　草十郎は驚き、怖がるだけでいい。"
msgstr "  No one would blame Soujyuro for cowering in shock,"

#. Occurrence 5B_5:785:6911: scene=5B_5
#: 5B_5:785
msgctxt "text_id=6911 | speaker=unknown"
msgid "　けれど青子はそうはいかない。"
msgstr "  but for Aoko to do the same?"

#. Occurrence 5B_5:790:6912: scene=5B_5
#: 5B_5:790
msgctxt "text_id=6912 | speaker=unknown"
msgid "　この状況を招き、彼の手を取った責任がある。"
msgstr "  She bore responsibility for causing and then dragging him into this mess."

#. Occurrence 5B_5:795:6913: scene=5B_5
#: 5B_5:795
msgctxt "text_id=6913 | speaker=unknown"
msgid "　おいそれとパニックに<陥|おちい>るワケにはいかないのだ。"
msgstr "  She could not afford to succumb to panic."

#. Occurrence 5B_5:885:6914: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0003; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:885
msgctxt "text_id=6914 | speaker=aoko"
msgid "“……大丈夫、落ち着け私……"
msgstr "(...Pull yourself together, Aoko."

#. Occurrence 5B_5:891:6915: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0004; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:891
msgctxt "text_id=6915 | speaker=aoko"
msgid "　遊園地の果てはある。遠いけど、鉄柵はちゃんと見える。"
msgstr "  The park has to end somewhere. It may be far, but the fence is right there."

#. Occurrence 5B_5:897:6916: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0005; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:897
msgctxt "text_id=6916 | speaker=aoko"
msgid "　フラットスナークだって制限無しってワケじゃない。外に逃げるって選択は正しいはず……。"
msgstr "  Even Flat Snark has limits. Getting to the exit is the right choice, I think."

#. Occurrence 5B_5:903:6917: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0006; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:903
msgctxt "text_id=6917 | speaker=aoko"
msgid "　現状、外までは目算で一キロぐらいだけど―――”"
msgstr "  But from here, it looks the better part of a mile away.)"

#. Occurrence 5B_5:944:6918: scene=5B_5
#: 5B_5:944
msgctxt "text_id=6918 | speaker=unknown"
msgid "　ここまで夢中で走りすぎた。"
msgstr "  Up until now they had been too concerned with simply running."

#. Occurrence 5B_5:949:6919: scene=5B_5
#: 5B_5:949
msgctxt "text_id=6919 | speaker=unknown"
msgid "　青子も草十郎も息が上がっている。"
msgstr "  Their breathing had become labored."

#. Occurrence 5B_5:954:6920: scene=5B_5
#: 5B_5:954
msgctxt "text_id=6920 | speaker=unknown"
msgid "　あと一キロ走るのなら、いったん休憩をいれないと途中で足が止まってしまう。"
msgstr "  If they had to run another mile without rest, they'd end up collapsing along the way."

#. Occurrence 5B_5:975:6921: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0005; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:975
msgctxt "text_id=6921 | speaker=soujuurou"
msgid "「……蒼崎。体、大丈夫か？」"
msgstr "\"...Aozaki? How are you holding up? Physically, I mean.\""

#. Occurrence 5B_5:1044:6922: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0007; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:1044
msgctxt "text_id=6922 | speaker=aoko"
msgid "「へ？」"
msgstr "\"W-what?\""

#. Occurrence 5B_5:1050:6923: scene=5B_5
#: 5B_5:1050
msgctxt "text_id=6923 | speaker=unknown"
msgid "　背中ごしに<囁|ささや>きかけられ、青子は現実に引き戻された。"
msgstr "  The whisper from behind pulled Aoko back to reality."

#. Occurrence 5B_5:1129:6924: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0008; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:1129
msgctxt "text_id=6924 | speaker=aoko"
msgid "「大丈夫だけど……ちょっと、一息いれたいわね」"
msgstr "\"I'm fine... but... I need to catch my breath.\""

#. Occurrence 5B_5:1141:6925: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0006; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:1141
msgctxt "text_id=6925 | speaker=soujuurou"
msgid "「……賛成。ここから休みなしで外周まで走るのは、やめた方がいい」"
msgstr "\"...Good idea. We'll never make it outside if we don't rest.\""

#. Occurrence 5B_5:1153:6926: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0009; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:1153
msgctxt "text_id=6926 | speaker=aoko"
msgid "「―――驚いた。静希君も外まで走ろう派とは」"
msgstr "\"...You know, I never would have thought you'd be okay with making a run for it.\""

#. Occurrence 5B_5:1247:6927: scene=5B_5
#: 5B_5:1247
msgctxt "text_id=6927 | speaker=unknown"
msgid "　言って、くすりと笑ってしまった。"
msgstr "  She let slip a giggle."

#. Occurrence 5B_5:1252:6928: scene=5B_5
#: 5B_5:1252
msgctxt "text_id=6928 | speaker=unknown"
msgid "　背中の戦友はパニック状態どころか、きちんと現状と、その打開策を考えていた。"
msgstr "  Far from debilitated by panic, her comrade-in-arms had been analyzing the situation and forming an escape plan."

#. Occurrence 5B_5:1329:6929: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0007; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:1329
msgctxt "text_id=6929 | speaker=soujuurou"
msgid "「ちょっとだけ建物に逃げこむのは？」"
msgstr "\"Why don't we hole up in one of those buildings for a while?\""

#. Occurrence 5B_5:1341:6930: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0010; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:1341
msgctxt "text_id=6930 | speaker=aoko"
msgid "「………気は進まないけど、それしかないわね」"
msgstr "\"...I don't like it, but it's our best option right now.\""

#. Occurrence 5B_5:1422:6931: scene=5B_5
#: 5B_5:1422
msgctxt "text_id=6931 | speaker=unknown"
msgid "　焼きたてパンたちの包囲網。"
msgstr "  The bread-men had them completely surrounded."

#. Occurrence 5B_5:1427:6932: scene=5B_5
#: 5B_5:1427
msgctxt "text_id=6932 | speaker=unknown"
msgid "　常人ならいざ知らず、青子ならこの囲みを破って建物に逃げこむのは<容易|ようい>だ。"
msgstr "  Perhaps this might have been a problem for an average person, but for Aoko, breaking through their formation to get to the building would be a cinch."

#. Occurrence 5B_5:1432:6933: scene=5B_5
#: 5B_5:1432
msgctxt "text_id=6933 | speaker=unknown"
msgid "　問題は―――"
msgstr "  The issue was..."

#. Occurrence 5B_5:1539:6934: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0011; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:1539
msgctxt "text_id=6934 | speaker=aoko"
msgid "“……問題は、どんな店を選ぶかってコト―――”"
msgstr "\"...Which store to pick?\""

#. Occurrence 5B_5:1601:6935: scene=5B_5
#: 5B_5:1601
msgctxt "text_id=6935 | speaker=unknown"
msgid "　変貌する遊園地の特性を考慮する。"
msgstr "  She considered the characteristics of the transforming park."

#. Occurrence 5B_5:1606:6936: scene=5B_5
#: 5B_5:1606
msgctxt "text_id=6936 | speaker=unknown"
msgid "　何が危険で、何が安全なのか。"
msgstr "  What would pose a danger, and what was safe?"

#. Occurrence 5B_5:1611:6937: scene=5B_5
#: 5B_5:1611
msgctxt "text_id=6937 | speaker=unknown"
msgid "　大事なのは建物の強度や複雑さではなく―――"
msgstr "  The most important factor was not the strength or the complexity of the building..."

#. Occurrence 5B_5:1643:6938: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0012; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:1643
msgctxt "text_id=6938 | speaker=aoko"
msgid "“そうだ、選ぶなら<あ|・><の|・><単|・><純|・><さ|・>で正しいはず……！”"
msgstr "(Keep it simple, stupid!)"

#. Occurrence 5B_5:1751:6939: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0013; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:1751
msgctxt "text_id=6939 | speaker=aoko"
msgid "「静希君、あっち！」"
msgstr "\"Sizuki, this way!\""

#. Occurrence 5B_5:1874:6940: scene=5B_5
#: 5B_5:1874
msgctxt "text_id=6940 | speaker=unknown"
msgid "　怪物たちを蹴散らしてカウンターに飛びこむ青子と、その後に続く草十郎。"
msgstr "  After routing the monsters, Aoko hopped behind the counter, soon followed by Soujyuro."

#. Occurrence 5B_5:2045:6941: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0014; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:2045
msgctxt "text_id=6941 | speaker=aoko"
msgid "「カウンターに隠れてて！」"
msgstr "\"Get behind the counter!\""

#. Occurrence 5B_5:2090:6942: scene=5B_5
#: 5B_5:2090
msgctxt "text_id=6942 | speaker=unknown"
msgid "　青子は西部劇の銃撃戦のように、カウンターを盾にして怪物たちと対峙する。"
msgstr "  Like she was in a Western shootout, Aoko squared off against the monsters, using the counter as cover."

#. Occurrence 5B_5:2384:6943: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0015; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:2384
msgctxt "text_id=6943 | speaker=aoko"
msgid "「ビンゴ……！　ここならスナーク化しないんだ！」"
msgstr "\"Bingo! Nothing in here can get Snarkified!\""

#. Occurrence 5B_5:2390:6944: scene=5B_5
#: 5B_5:2390
msgctxt "text_id=6944 | speaker=unknown"
msgid "　敵の様子を確認し、青子もカウンター内部に腰を下ろした。"
msgstr "  After assessing the current state of the enemy, Aoko sat down under the counter."

#. Occurrence 5B_5:2446:6945: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0008; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:2446
msgctxt "text_id=6945 | speaker=soujuurou"
msgid "「アイツらは……？」"
msgstr "\"What are they doing?\""

#. Occurrence 5B_5:2457:6946: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0016; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:2457
msgctxt "text_id=6946 | speaker=aoko"
msgid "「店の周りで<地団駄|じだんだ>踏んでるわ。理由があってね、アイツらはここには入ってこられないのよ」"
msgstr "\"They're stamping their feet in frustration, because they're angry that they can't get in.\""

#. Occurrence 5B_5:2468:6947: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0009; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:2468
msgctxt "text_id=6947 | speaker=soujuurou"
msgid "「？？」"
msgstr "\"?\""

#. Occurrence 5B_5:2537:6948: scene=5B_5
#: 5B_5:2537
msgctxt "text_id=6948 | speaker=unknown"
msgid "　不思議がる草十郎にまあまあと笑いかけて、青子は大きく胸を上下させた。"
msgstr "  Aoko gave the perplexed Soujyuro a grin and took a moment to catch her breath."

#. Occurrence 5B_5:2542:6949: scene=5B_5
#: 5B_5:2542
msgctxt "text_id=6949 | speaker=unknown"
msgid "　安堵と、おそらくは疲労からきた大きな息継ぎ。"
msgstr "  She heaved a heavy sigh of relief and fatigue."

#. Occurrence 5B_5:2632:6950: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0017; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:2632
msgctxt "text_id=6950 | speaker=aoko"
msgid "「とりあえずコーヒーブレイクね。ここは遊園地の中でも遊びのない場所だから、アイツらにとっては鬼門なのよ。"
msgstr "\"We'll take five here. This restaurant is the blandest place in the park, which makes it their Achilles' heel."

#. Occurrence 5B_5:2638:6951: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0018; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:2638
msgctxt "text_id=6951 | speaker=aoko"
msgid "　レジスターも調理道具も最近のものだし、擬人化されたマスコットもないし。スナーク化するには、ちょい文明圏すぎるってコト」"
msgstr "  The registers and utensils are all modern, and there are no mascot characters. It's just a bit too civilized for Snark to mess with.\""

#. Occurrence 5B_5:2705:6952: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0010; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:2705
msgctxt "text_id=6952 | speaker=soujuurou"
msgid "「すなーく？」"
msgstr "\"Snark?\""

#. Occurrence 5B_5:2752:6953: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0019; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:2752
msgctxt "text_id=6953 | speaker=aoko"
msgid "「アイツらの名前よ。つけたのは私じゃなくて有珠……なのかしらね。あの子の性格的にちょっと想像できないけど、まあ、とにかくそういう名前」"
msgstr "\"That's their name, though Alice is the one who came up with it... I think. It doesn't really sound like her, but whatever. That's what they're called.\""

#. Occurrence 5B_5:2821:6954: scene=5B_5
#: 5B_5:2821
msgctxt "text_id=6954 | speaker=unknown"
msgid "　安全と分かって落ち着いたのか、草十郎は興味津々とばかりに耳を傾ける。"
msgstr "  Perhaps now at ease from knowing they were safe, Soujyuro seemed enthralled in her explanation."

#. Occurrence 5B_5:2826:6955: scene=5B_5
#: 5B_5:2826
msgctxt "text_id=6955 | speaker=unknown"
msgid "　なるほど、なんてしかつめらしく頷いているが、きっと分かってないだろうなー、と青子はつい笑ってしまった。"
msgstr "  Aoko could not help but chuckle as Soujyuro nodded sagely. It was certain that he had no idea what she was talking about."

#. Occurrence 5B_5:2831:6956: scene=5B_5
#: 5B_5:2831
msgctxt "text_id=6956 | speaker=unknown"
msgid "　普段ならイラっとくるところだが、今は彼の妙な真面目さがありがたく、あたたかい。"
msgstr "  Normally this would have irritated her, but this time she was grateful for the warmth of his strange sobriety."

#. Occurrence 5B_5:2869:6957: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0011; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:2869
msgctxt "text_id=6957 | speaker=soujuurou"
msgid "「それはともかく。調子良さそうだな、蒼崎」"
msgstr "\"It's good that you seem better, Aozaki.\""

#. Occurrence 5B_5:2875:6958: scene=5B_5
#: 5B_5:2875
msgctxt "text_id=6958 | speaker=unknown"
msgid "　そんな青子の笑みを余裕と勘違いして、草十郎も顔をほころばす。"
msgstr "  Mistaking her smile for composure, Soujyuro broke into a smile himself."

#. Occurrence 5B_5:2880:6959: scene=5B_5
#: 5B_5:2880
msgctxt "text_id=6959 | speaker=unknown"
msgid "　誤解の連鎖だが、今はそれを<糾|ただ>すこともない。"
msgstr "  It was just another link in a chain of misunderstandings, but there was no need to redress it."

#. Occurrence 5B_5:2960:6960: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0020; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:2960
msgctxt "text_id=6960 | speaker=aoko"
msgid "「あれ、貴方から見ても分かる？"
msgstr "\"Oh, you can tell?"

#. Occurrence 5B_5:2960:6961: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0020; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:2960
msgctxt "text_id=6961 | speaker=aoko"
msgid "　私の魔弾の威力が上がっているの」"
msgstr "  Yeah, my magic bullets are getting more powerful.\""

#. Occurrence 5B_5:2993:6962: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0012; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:2993
msgctxt "text_id=6962 | speaker=soujuurou"
msgid "「そりゃあ、ミラーハウスでさんざん追いかけ回されたからな。あの時と同じ動作なのに物騒さが増していれば、イヤでも分かる」"
msgstr "\"Well, you did chase me all around that house of mirrors while firing those things at me, so I guess I've become really familiar with them, for better or worse.\""

#. Occurrence 5B_5:3019:6963: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0013; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:3019
msgctxt "text_id=6963 | speaker=soujuurou"
msgid "「でもいいのか？　たしか、数にかぎりがあるとか言ってただろ。もうずいぶん撃っちまったけど。二十、三十じゃきかないぞ」"
msgstr "\"Are you sure you're okay, though? I remember you mentioning that you had a limited number of shots, but you've fired at least twenty or thirty so far, right?\""

#. Occurrence 5B_5:3031:6964: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0021; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3031
msgctxt "text_id=6964 | speaker=aoko"
msgid "「―――アンタ、時々、アレよね」"
msgstr "\"You know, every now and then, you...\""

#. Occurrence 5B_5:3042:6965: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0014; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:3042
msgctxt "text_id=6965 | speaker=soujuurou"
msgid "「？」"
msgstr "\"?\""

#. Occurrence 5B_5:3047:6966: scene=5B_5
#: 5B_5:3047
msgctxt "text_id=6966 | speaker=unknown"
msgid "　不覚にも、ちょっと見直す青子だった。"
msgstr "  Her opinion of him improved, just a little bit."

#. Occurrence 5B_5:3074:6967: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0022; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3074
msgctxt "text_id=6967 | speaker=aoko"
msgid "「なんでもない。"
msgstr "\"Never mind."

#. Occurrence 5B_5:3080:6968: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0023; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3080
msgctxt "text_id=6968 | speaker=aoko"
msgid "　私の魔弾の威力が上がっているのは、単純に魔力の濃度の問題。さっきから霧がかかってるでしょ？　あれ、全部魔力なのよ。<魔|タ><弾|マ>を撃つための燃料と思って」"
msgstr "  My bullets' increase in power is a simple matter of the density of their magical energy. You've seen that fog around the park from a bit ago, right? It's all just magical energy. Think of it as fuel for my bullets.\""

#. Occurrence 5B_5:3130:6969: scene=5B_5
#: 5B_5:3130
msgctxt "text_id=6969 | speaker=unknown"
msgid "　魔力とは大きく二種類あり、"
msgstr "  Magical energy was divided into two broad categories."

#. Occurrence 5B_5:3130:6970: scene=5B_5
#: 5B_5:3130
msgctxt "text_id=6970 | speaker=unknown"
msgid "　魔術師が肉体から生成する<小源|オド>と、"
msgstr "  First was od, produced inside a mage's body."

msgctxt "text_id=6971 | speaker=unknown"
msgid "　大気に満ちている<大源|マナ>とがある。"
msgstr "  Second was mana, which filled the atmosphere."

#. Occurrence 5B_5:3137:6972: scene=5B_5
#: 5B_5:3137
msgctxt "text_id=6972 | speaker=unknown"
msgid "　この遊園地はいま、マナに満ちあふれた御伽の国だ。"
msgstr "  At the moment, the amusement park had turned into a fairy-tale land, overflowing with mana."

#. Occurrence 5B_5:3142:6973: scene=5B_5
#: 5B_5:3142
msgctxt "text_id=6973 | speaker=unknown"
msgid "　一般人にとっては何の効果もないが、魔術師にとっては術式を使いたい放題の楽園と化している。"
msgstr "  Although it meant nothing to the average person, to a mage it was a paradise where spells could be cast as much as one pleased."

#. Occurrence 5B_5:3163:6974: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0015; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:3163
msgctxt "text_id=6974 | speaker=soujuurou"
msgid "「じゃあ残り魔力とやらは気にしなくていいのか。"
msgstr "\"So that means you don't have to worry about how much magic-whatever you have left then."

#. Occurrence 5B_5:3169:6975: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0016; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:3169
msgctxt "text_id=6975 | speaker=soujuurou"
msgid "　注意すべきは怪我と体力だけ？」"
msgstr "  All we need to worry about are injuries and stamina?\""

#. Occurrence 5B_5:3196:6976: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0024; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3196
msgctxt "text_id=6976 | speaker=aoko"
msgid "「……まあ、個人的な責任においてはそのかぎりね」"
msgstr "\"...Well, as far as our own lives are concerned, yeah.\""

#. Occurrence 5B_5:3221:6977: scene=5B_5
#: 5B_5:3221
msgctxt "text_id=6977 | speaker=unknown"
msgid "　良かった、と息をつく草十郎。"
msgstr "  Soujyuro breathed a sigh of relief."

#. Occurrence 5B_5:3226:6978: scene=5B_5
#: 5B_5:3226
msgctxt "text_id=6978 | speaker=unknown"
msgid "　草十郎から見れば、青子は怪物たちをなぎ払う遊園地最強の暴れん坊だ。"
msgstr "  From Soujyuro's perspective, more so than the monsters she mowed down, Aoko was the biggest bully on the playground."

#. Occurrence 5B_5:3231:6979: scene=5B_5
#: 5B_5:3231
msgctxt "text_id=6979 | speaker=unknown"
msgid "　不安なのは魔力が尽きる事だったが、それがないのであればまさに百人力である。"
msgstr "  He had been concerned about what would happen should her magical energy be exhausted, but luckily for him she was far from surrendering her crown."

#. Occurrence 5B_5:3311:6980: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0025; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3311
msgctxt "text_id=6980 | speaker=aoko"
msgid "「頼りにしてくれるのは嬉しいけど、ぬか喜びよ。"
msgstr "\"It's nice that you trust me and all, but let's not get ahead of ourselves."

#. Occurrence 5B_5:3318:6981: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0026; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3318
msgctxt "text_id=6981 | speaker=aoko"
msgid "あんな雑魚たち、ただ動いているだけのガラクタなんだから。"
msgstr "Those minions out there are just walking garbage."

#. Occurrence 5B_5:3324:6982: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0027; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3324
msgctxt "text_id=6982 | speaker=aoko"
msgid "　スナーク本体は当然として、有珠が<他|・><の|・><童|・><話|・><の|・><怪|・><物|・>を出してきたら私じゃどうにもならない」"
msgstr "  If Alice summons any other fairy-tale monsters, let alone the actual Snark making an appearance, there's nothing I'll be able to do.\""

#. Occurrence 5B_5:3361:6983: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0017; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:3361
msgctxt "text_id=6983 | speaker=soujuurou"
msgid "「他の童話の怪物？　……遊園地をこんなふうに変えたヤツ以外に、まだいるのか？」"
msgstr "\"Other fairy-tale monsters? You mean there are others apart from the thing that changed the park?\""

#. Occurrence 5B_5:3398:6984: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0028; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3398
msgctxt "text_id=6984 | speaker=aoko"
msgid "「そ。プロイキッシャーって名付けられた、<魔術師|わたしたち>でさえ目を背けたくなる反則。"
msgstr "\"Yes. They're called Ploy Kickshaws, aberrations that even we mages can't stand to look at."

#. Occurrence 5B_5:3405:6985: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0029; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3405
msgctxt "text_id=6985 | speaker=aoko"
msgid "不可能な夢物語をも再現する、時代に取り残されたデタラメよ」"
msgstr "They're nonsense lost to time, used to revive impossible fantasies.\""

#. Occurrence 5B_5:3460:6986: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0018; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:3460
msgctxt "text_id=6986 | speaker=soujuurou"
msgid "「？？」"
msgstr "\"?\""

#. Occurrence 5B_5:3465:6987: scene=5B_5
#: 5B_5:3465
msgctxt "text_id=6987 | speaker=unknown"
msgid "　自分の事は棚にあげて？　と言いたげな顔である。"
msgstr "  Soujyuro's expression seemed to be calling her out on the hypocrisy."

#. Occurrence 5B_5:3545:6988: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0030; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3545
msgctxt "text_id=6988 | speaker=aoko"
msgid "「あのね、私たちはちゃんと現代によりそった魔術師よ。"
msgstr "\"Hey, most of us have modern standards, you know."

#. Occurrence 5B_5:3557:6989: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0031; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3557
msgctxt "text_id=6989 | speaker=aoko"
msgid "　できない事もあるし、当たり前の事だけど、近代兵器には敵わない。二十世紀―――ま、色んな戦争の後押しで、兵器の進化は私たちを越えちゃったから」"
msgstr "  Obviously there are things we can't do, and we're no match for modern weapons. The twentieth century―well, a bunch of wars helped weapons technology catch up to us.\""

#. Occurrence 5B_5:3584:6990: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0032; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3584
msgctxt "text_id=6990 | speaker=aoko"
msgid "「……けどあの子のは違う。どんなに人間の技術が進歩しようと関係ないって怪物なの。"
msgstr "\"...But that girl is a different beast altogether. Mankind's evolution can't hold a flame to her power."

#. Occurrence 5B_5:3597:6991: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0033; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3597
msgctxt "text_id=6991 | speaker=aoko"
msgid "　たとえば、あのブレッドマンいるでしょ？"
msgstr "  Take those bread-men, for instance."

#. Occurrence 5B_5:3603:6992: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0034; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3603
msgctxt "text_id=6992 | speaker=aoko"
msgid "　あいつには自動拳銃とかきかないわよ。たぶん、意味が分かっていないから」"
msgstr "  Something like a machine gun would have no effect on them, probably because guns make no sense to them.\""

#. Occurrence 5B_5:3608:6993: scene=5B_5
#: 5B_5:3608
msgctxt "text_id=6993 | speaker=unknown"
msgid "　ひょい、とカウンターから外を指す青子。"
msgstr "  Aoko casually gestured outside, past the counter."

#. Occurrence 5B_5:3687:6994: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0035; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3687
msgctxt "text_id=6994 | speaker=aoko"
msgid "「有珠の使い魔は全てが空想によってこねられた神秘なの。"
msgstr "\"Alice's familiars are Mystics kneaded from fantasies."

#. Occurrence 5B_5:3693:6995: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0036; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3693
msgctxt "text_id=6995 | speaker=aoko"
msgid "　前提からしてあり得ない事だから、通常の物理法則と折り合いが悪い。空想と現実は両立しないっていう、ごく当たり前の理由でね」"
msgstr "  They're all impossible in the first place, so they don't play nice with the laws of physics. That shouldn't come as a surprise, since fantasy and reality can't exist together.\""

#. Occurrence 5B_5:3759:6996: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0019; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:3759
msgctxt "text_id=6996 | speaker=soujuurou"
msgid "「……なるほど。ブレッドマンってのは、あの動く焼きたてパンの事なんだな」"
msgstr "\"...I see. So they're literally walking loaves of bread.\""

#. Occurrence 5B_5:3764:6997: scene=5B_5
#: 5B_5:3764
msgctxt "text_id=6997 | speaker=unknown"
msgid "　青子の説明の大部分をスルーして、気になるコトだけ拾う草十郎だった。"
msgstr "  Soujyuro seemed to have ignored the majority of Aoko's explanation and only reacted to the part that caught his curiosity."

#. Occurrence 5B_5:3847:6998: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0037; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3847
msgctxt "text_id=6998 | speaker=aoko"
msgid "「…………話を戻すけど。"
msgstr "\"...To get back on topic,"

#. Occurrence 5B_5:3853:6999: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0038; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3853
msgctxt "text_id=6999 | speaker=aoko"
msgid "　あいつらと近代兵器の相性は最悪。ロケット弾でも効果はないわ。意思の疎通、秩序の共有ができてないから」"
msgstr "  Modern arms don't stand a chance against those things. Even rockets would be useless. They aren't part of the same order or shared consciousness as us.\""

#. Occurrence 5B_5:3882:7000: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0039; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3882
msgctxt "text_id=7000 | speaker=aoko"
msgid "「<童話の怪物|プロイキッシャー>にとって、彼らの世界には存在しないもの、意味が分からないモノは、触れるコトなく霧散する。"
msgstr "\"To the Ploy Kickshaws―to the fairy-tale monsters―anything that doesn't exist in their world, anything they don't understand, disintegrates before it can even touch them."

#. Occurrence 5B_5:3895:7001: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0040; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:3895
msgctxt "text_id=7001 | speaker=aoko"
msgid "　彼らに<通|つう>じるのは同じ神秘を帯びた“魔力”だけっていうデタラメぶりよ。もう完全に<概念|がいねん>空間っていうか、概念宇宙っていうか―――」"
msgstr "  Only something equally nonsense can touch them, like magical energy infused with the same level of Mystics. They exist wholly in their own conceptual space or cosmos―\""

#. Occurrence 5B_5:3963:7002: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0020; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:3963
msgctxt "text_id=7002 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5B_5:4011:7003: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0041; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4011
msgctxt "text_id=7003 | speaker=aoko"
msgid "「…………こほん。"
msgstr "\"...Ahem."

#. Occurrence 5B_5:4023:7004: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0042; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4023
msgctxt "text_id=7004 | speaker=aoko"
msgid "　要するに、アイツらは伝承防御っていう特別なルールを持っていて、単純に強い力、強い魔術じゃ効果は薄いの。元になった童話にちなんだ欠点をつかないと倒せない。"
msgstr "  In short, they're protected by a special rule known as Folklore Defense, meaning that neither pure force nor strong magecraft have much effect. They can't be taken down without exploiting the weaknesses found in their original stories."

#. Occurrence 5B_5:4035:7005: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0043; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4035
msgctxt "text_id=7005 | speaker=aoko"
msgid "　ギリシャ神話のアキレスあたり分かりやすい喩えなんだけど……知ってる？」"
msgstr "  Are you familiar with the Greek myth of Achilles? It's a good, straightforward example.\""

#. Occurrence 5B_5:4040:7006: scene=5B_5
#: 5B_5:4040
msgctxt "text_id=7006 | speaker=unknown"
msgid "　草十郎はぶんぶんと首を振る。"
msgstr "  Soujyuro shook his head."

#. Occurrence 5B_5:4067:7007: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0044; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4067
msgctxt "text_id=7007 | speaker=aoko"
msgid "「そ。無事帰れたら、鳶丸あたりに教えてもらって。"
msgstr "\"Of course you aren't. If we get out of this alive, have Tobimaru tell you about it."

#. Occurrence 5B_5:4067:7008: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0044; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4067
msgctxt "text_id=7008 | speaker=aoko"
msgid "　定番だけどいい<教訓|はなし>よ、アレ」"
msgstr "  It's a cliché, but it's a good story.\""

#. Occurrence 5B_5:4078:7009: scene=5B_5
#: 5B_5:4078
msgctxt "text_id=7009 | speaker=unknown"
msgid "　……かなりおいてけぼり感ただよう草十郎だが、彼は彼なりに現状把握に努めてみた。"
msgstr "  Soujyuro was feeling pretty lost, but he did his best to grasp the situation."

#. Occurrence 5B_5:4098:7010: scene=5B_5
#: 5B_5:4098
msgctxt "text_id=7010 | speaker=unknown"
msgid "“<童話の怪物|プロイキッシャー>”とやらは、青子やミラーハウスの自動人形ですら<裸足|はだし>で逃げだすモノだという。"
msgstr "  He thought that Ploy Kickshaws were scary enough to chase Aoko and that puppet from before out of the house barefoot."

#. Occurrence 5B_5:4151:7011: scene=5B_5
#: 5B_5:4151
msgctxt "text_id=7011 | speaker=unknown"
msgid "　たしかに目の前の光景は誰かの悪夢の中に迷いこんだとしか思えない。"
msgstr "  Certainly, the scene before them was the stuff of nightmares."

#. Occurrence 5B_5:4229:7012: scene=5B_5
#: 5B_5:4229
msgctxt "text_id=7012 | speaker=unknown"
msgid "　だがしかし、と草十郎は思うのだ。"
msgstr "  But Soujyuro had a different way of thinking."

#. Occurrence 5B_5:4267:7013: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0021; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:4267
msgctxt "text_id=7013 | speaker=soujuurou"
msgid "「やっぱり、蒼崎の方が怖くないか？」"
msgstr "\"I think you're more scared than me, Aozaki.\""

#. Occurrence 5B_5:4345:7014: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0045; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4345
msgctxt "text_id=7014 | speaker=aoko"
msgid "「アンタ死ぬの？」"
msgstr "\"Do you want to die?!\""

#. Occurrence 5B_5:4351:7015: scene=5B_5
#: 5B_5:4351
msgctxt "text_id=7015 | speaker=unknown"
msgid "　ほら、と無言の抗議をする草十郎。"
msgstr "  Soujyuro waved in protest, silently pointing out that she had made his case for him."

#. Occurrence 5B_5:4393:7016: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0046; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4393
msgctxt "text_id=7016 | speaker=aoko"
msgid "「……あのね。いま私たちを取り囲んでるのはオマケにすぎないの。"
msgstr "\"Listen to me: the things surrounding us now are little more than fodder."

#. Occurrence 5B_5:4399:7017: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0047; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4399
msgctxt "text_id=7017 | speaker=aoko"
msgid "　有珠にとって、あのブレッドマンもロブスターもソーセージ屋のミンチマシーンも、全部が全部、私が撃ってる魔弾より価値がない。"
msgstr "  As far as Alice is concerned, the bread-men, the lobster, the meat mincer at the sausage place―they're all worth even less than my magic bullets are to me."

#. Occurrence 5B_5:4411:7018: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0048; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4411
msgctxt "text_id=7018 | speaker=aoko"
msgid "　いい？　あの動くマスコットたちはね、<た|・><だ|・><の|・><オ|・><マ|・><ケ|・>なの。有珠が解放した“童話の怪物”の、一呼吸みたいなものなのよ」"
msgstr "  Got it? The moving mascots and all the rest are a sideshow. They're nothing more than the breath of the monster she unleashed.\""

#. Occurrence 5B_5:4437:7019: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0022; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:4437
msgctxt "text_id=7019 | speaker=soujuurou"
msgid "「―――呼吸って、これが？」"
msgstr "\"These things...are just the breath?\""

#. Occurrence 5B_5:4449:7020: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0049; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4449
msgctxt "text_id=7020 | speaker=aoko"
msgid "「……私だって考えたくないわよ。"
msgstr "\"Yeah, crazy, I know."

#. Occurrence 5B_5:4455:7021: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0050; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4455
msgctxt "text_id=7021 | speaker=aoko"
msgid "　でもそれが現状。たった一体の“童話の怪物”だけで私たちは手一杯。"
msgstr "  But that's what we're dealing with right now. Just one of those fairy-tale monsters is enough to keep us busy."

#. Occurrence 5B_5:4462:7022: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0051; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4462
msgctxt "text_id=7022 | speaker=aoko"
msgid "そういう訳だから、有珠があと一体でも追加したら諦めて」"
msgstr "So if Alice decides to add another, we might as well give up.\""

#. Occurrence 5B_5:4499:7023: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0023; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:4499
msgctxt "text_id=7023 | speaker=soujuurou"
msgid "「追加って……これに制限はないのか？」"
msgstr "\"Add another? Isn't there some sort of limit?\""

#. Occurrence 5B_5:4505:7024: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0052; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4505
msgctxt "text_id=7024 | speaker=aoko"
msgid "「あの子が出し惜しみしなければ、まだ何体かストックはあるでしょうけど……ま、成立する条件はあるわね。"
msgstr "\"If she decides not to be stingy, she has a few more up her sleeve. Though... well, there are conditions to bringing them out."

#. Occurrence 5B_5:4511:7025: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0053; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4511
msgctxt "text_id=7025 | speaker=aoko"
msgid "　たとえば川がないと目を覚まさない怪物もいる。この遊園地、噴水はあるけど川はないでしょ？　元になった童話しばりなの、あの子の使い魔は」"
msgstr "  Like one monster that won't wake up if there's no river nearby. The park has fountains, sure, but no river, right? Her familiars are bound by their underlying stories.\""

#. Occurrence 5B_5:4532:7026: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0024; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:4532
msgctxt "text_id=7026 | speaker=soujuurou"
msgid "「童話って、かけそばとか？」"
msgstr "\"By fairy tale, you mean like the one about a bowl of soba noodles?\""

#. Occurrence 5B_5:4552:7027: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0054; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4552
msgctxt "text_id=7027 | speaker=aoko"
msgid "「<遊園地|ここ>に川がないのは不幸中の幸いね。もしあったら、もっと直接制圧に向いた奴が出てきてた」"
msgstr "\"Let me tell you, it's a small mercy there's no river here. Otherwise, something way better at squishing us would have appeared by now.\""

#. Occurrence 5B_5:4558:7028: scene=5B_5
#: 5B_5:4558
msgctxt "text_id=7028 | speaker=unknown"
msgid "　草十郎の合いの手をサラッと無視する青子だった。"
msgstr "  Aoko continued, completely ignoring Soujyuro."

#. Occurrence 5B_5:4625:7029: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0055; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4625
msgctxt "text_id=7029 | speaker=aoko"
msgid "「―――話の続きだけど。"
msgstr "\"Anyway, as I was saying..."

#. Occurrence 5B_5:4632:7030: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0056_0; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4632
msgctxt "text_id=7030 | speaker=aoko"
msgid "　有珠の魔術の基本はマザーグース……"
msgstr "  The foundation of Alice's magecraft is Mother Goose."

#. Occurrence 5B_5:4645:7031: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0056_1; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4645
msgctxt "text_id=7031 | speaker=aoko"
msgid "って知らないか。イギリスの唄で、遊び心にとんだ、メルヘンチックな内容よ。"
msgstr "Right, you wouldn't know that either. Mother Goose was an author of whimsical English nursery rhymes."

#. Occurrence 5B_5:4651:7032: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0057; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4651
msgctxt "text_id=7032 | speaker=aoko"
msgid "　ただ、そっち系のプロイキッシャーは怖くないの。"
msgstr "  To be honest, this type of Ploy Kickshaw isn't all that scary."

#. Occurrence 5B_5:4658:7033: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0058; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4658
msgctxt "text_id=7033 | speaker=aoko"
msgid "みんなそれなりに、なんとか魔術にも落としこめる範囲だから」"
msgstr "Taking them down with some form of magecraft is totally possible.\""

#. Occurrence 5B_5:4725:7034: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0025; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:4725
msgctxt "text_id=7034 | speaker=soujuurou"
msgid "「……聞きたくないんだけど、そっち系じゃないのは？」"
msgstr "\"...I'm afraid to ask, but what about the scary kind, then?\""

#. Occurrence 5B_5:4828:7035: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0059; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4828
msgctxt "text_id=7035 | speaker=aoko"
msgid "「マザーグースを下地にした、とある創作童話系。"
msgstr "\"They follow another fairy tale inspired by Mother Goose."

#. Occurrence 5B_5:4834:7036: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0060; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4834
msgctxt "text_id=7036 | speaker=aoko"
msgid "　……<有珠|あの子>のお母さんが好きでね、<こ|・><っ|・><ち|・><系|・>のはドイツもコイツも尋常じゃない。<魔術師|わたしたち>から見ても勘弁してって言いたくなるわ」"
msgstr "  Alice's mother was particularly fond of it, and every single one is bizarre. No mage wants to go up against one of those things.\""

#. Occurrence 5B_5:4857:7037: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0061; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4857
msgctxt "text_id=7037 | speaker=aoko"
msgid "「で、この遊園地を生き返らせたのは<こ|・><っ|・><ち|・><系|・>よ。"
msgstr "\"As it happens, that's exactly what brought the park back to life."

#. Occurrence 5B_5:4863:7038: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0062; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4863
msgctxt "text_id=7038 | speaker=aoko"
msgid "　たぶんフラットスナークってヤツだと思う。……私も聞き流していたから、詳しくは分からないけど」"
msgstr "  I'm pretty sure it's the one she calls Flat Snark, though I wasn't particularly paying attention, so I'm a little hazy on the details.\""

#. Occurrence 5B_5:4918:7039: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0026; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:4918
msgctxt "text_id=7039 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5B_5:4924:7040: scene=5B_5
#: 5B_5:4924
msgctxt "text_id=7040 | speaker=unknown"
msgid "　のど元まで出た不満を飲みこむ。"
msgstr "  Soujyuro swallowed the discomfort making its way up his throat."

#. Occurrence 5B_5:4929:7041: scene=5B_5
#: 5B_5:4929
msgctxt "text_id=7041 | speaker=unknown"
msgid "　こっち系とかそっち系とか曖昧な言い方はやめてほしい草十郎だったが、今の台詞には、他に追及すべき事があったからだ。"
msgstr "  He really wanted her to explain things a little less vaguely, but something she had just said necessitated further investigation."

#. Occurrence 5B_5:4955:7042: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0027; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:4955
msgctxt "text_id=7042 | speaker=soujuurou"
msgid "「待て蒼崎。あの子の話を聞き流したって、なんで」"
msgstr "\"Wait a second, Aozaki. You mean to tell me you weren't paying attention?\""

#. Occurrence 5B_5:4975:7043: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0063; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4975
msgctxt "text_id=7043 | speaker=aoko"
msgid "「いやぁ、説明してもらったのは随分と前だし……あの頃は有珠の話、あんまり信じられなかったのよね。"
msgstr "\"Well, you know, it was a while back that she explained it all to me, and I didn't really believe anything she had to say around then."

#. Occurrence 5B_5:4981:7044: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0064; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:4981
msgctxt "text_id=7044 | speaker=aoko"
msgid "　私が素人だと思って大げさに自分の魔術を語ってくれてるなあ、舐められてるなあ、とか。あはは」"
msgstr "  I thought that maybe she was talking up her own magecraft to a newbie, or that she wasn't taking me seriously. Ahaha.\""

#. Occurrence 5B_5:5024:7045: scene=5B_5
#: 5B_5:5024
msgctxt "text_id=7045 | speaker=unknown"
msgid "　無論、舐めていたのは青子の方だった。"
msgstr "  In truth, if anyone hadn't taken the lesson seriously, it was Aoko."

#. Occurrence 5B_5:5029:7046: scene=5B_5
#: 5B_5:5029
msgctxt "text_id=7046 | speaker=unknown"
msgid "　有珠を守る怪物が「本物」だと青子が経験するのは、二人が出会ってからしばらくしての事だ。"
msgstr "  She would learn that lesson firsthand soon enough, when she experienced just how real Alice's monsters were."

#. Occurrence 5B_5:5034:7047: scene=5B_5
#: 5B_5:5034
msgctxt "text_id=7047 | speaker=unknown"
msgid "　マインスターの魔女が魔術世界においてどれほど異端なのか、青子は身をもって経験する事になる。"
msgstr "  She'd also discover how heretical the Meinster witches truly were, in the world of magecraft."

#. Occurrence 5B_5:5071:7048: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0028; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:5071
msgctxt "text_id=7048 | speaker=soujuurou"
msgid "「……その聞き流した内容は？」"
msgstr "\"...Can you remember anything else about them?\""

#. Occurrence 5B_5:5083:7049: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0065; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5083
msgctxt "text_id=7049 | speaker=aoko"
msgid "「なんでも強力な結界を張るプロイだって。"
msgstr "\"From what I understand, it's a Ploy that puts up a powerful Bounded Field."

#. Occurrence 5B_5:5090:7050: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0066; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5090
msgctxt "text_id=7050 | speaker=aoko"
msgid "有珠が受け継いだ<玩具|プロイ>は山ほどあるけど、その中でも<選|え>りすぐりの一つよ。"
msgstr "Alice inherited a lot of Ploys, but this is one of her finest."

#. Occurrence 5B_5:5096:7051: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0067; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5096
msgctxt "text_id=7051 | speaker=aoko"
msgid "　<棄|す>てられたモノ、忘れられたモノを童話的に蘇らせるヤツで、今まで誰も破ったコトがないとか。"
msgstr "  It takes discarded and forgotten things and resurrects them like what happens in fairy tales. Supposedly, nobody's ever defeated it."

#. Occurrence 5B_5:5149:7052: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0068; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5149
msgctxt "text_id=7052 | speaker=aoko"
msgid "　それで、ついたあだ名が“<触|ふ>れられぬもの”」"
msgstr "  Oh, and its nickname is 'The Untouchable.'\""

#. Occurrence 5B_5:5170:7053: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0029; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:5170
msgctxt "text_id=7053 | speaker=soujuurou"
msgid "「？　ふらっとすなーく、じゃないのか？」"
msgstr "\"So it's not Flat Snark, or whatever it was?\""

#. Occurrence 5B_5:5183:7054: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0069; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5183
msgctxt "text_id=7054 | speaker=aoko"
msgid "「それもあだ名。とにかく正体が分からないヤツばっかりなんで、一つの個体に複数の名前がつけられるの。"
msgstr "\"That's just a nickname, too. Since nobody knows what its real form is, it picked up a few names along the way."

#. Occurrence 5B_5:5189:7055: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0070; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5189
msgctxt "text_id=7055 | speaker=aoko"
msgid "　フラットスナークはその中でも、正体不明さはトップランクのデタラメぶりよ。"
msgstr "  One of them is 'Flat Snark,' and it ranks high among her other nonsense in terms of how little is known about it."

#. Occurrence 5B_5:5202:7056: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0071; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5202
msgctxt "text_id=7056 | speaker=aoko"
msgid "　―――貴方、ルイス・キャロルの『スナーク狩り』って本、知ってる？」"
msgstr "  Have you heard of the book The Hunting of the Snark by Lewis Carroll?\""

#. Occurrence 5B_5:5251:7057: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0030; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:5251
msgctxt "text_id=7057 | speaker=soujuurou"
msgid "「いや。そもそもルイスキャロルというのは？」"
msgstr "\"No, and who is Loo-wis Car-rel?\""

#. Occurrence 5B_5:5263:7058: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0072; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5263
msgctxt "text_id=7058 | speaker=aoko"
msgid "「……そっからかあ……えーと、ドジスン教授は、そうね。特殊性癖を持った妄想紳士ってトコ？　ま、こっちは別にどうでもいいか。人によっては時間の無駄だろうし」"
msgstr "\"Okay, then... let's start from the beginning. Professor Dodgson was, hmm. He was a delusional gentleman with a peculiar disposition. Not that it matters right now. It's a waste of time to explain to some people.\""

#. Occurrence 5B_5:5289:7059: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0073; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5289
msgctxt "text_id=7059 | speaker=aoko"
msgid "「いま重要なのは、彼が残した著作の方。"
msgstr "\"What's important is the work he left behind."

#. Occurrence 5B_5:5295:7060: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0074; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5295
msgctxt "text_id=7060 | speaker=aoko"
msgid "　『スナーク狩り』はね、スナークって呼ばれる正体不明の怪物を捕まえようと奔走する冒険家たちの話なの」"
msgstr "  The Hunting of the Snark is a book about a band of adventurers who try to capture an unidentified monster known as the Snark.\""

#. Occurrence 5B_5:5358:7061: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0075; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5358
msgctxt "text_id=7061 | speaker=aoko"
msgid "「キャロルらしい、皮肉ばっちり、支離滅裂、意味不明、結末不在のホントに困った本で、一行は島で苦しみつつ、最終的にはスナークを見つけるものの、見つけた<主人公|ベイカー>は唐突に姿を消して終わってしまう。"
msgstr "\"It's very Carroll: satirical, nonsensical, and cryptic. It doesn't even really have an ending, either. Though the party does ultimately find the Snark on its island after much hardship, it ends with the protagonist who found it, the Baker, suddenly disappearing."

#. Occurrence 5B_5:5364:7062: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0076; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5364
msgctxt "text_id=7062 | speaker=aoko"
msgid "“よく分からないもの”探しに奔走する人間の風刺なんだけど―――この遊園地において、誰が<主人公|ベイカー>で、何が<怪物|スナーク>かは言うまでもないでしょ？」"
msgstr "  It's a satire about people who run about busily trying to find something they don't understand. But when it comes to the park here, it's pretty clear who the Baker is and who the Snark is, right?\""

#. Occurrence 5B_5:5391:7063: scene=5B_5
#: 5B_5:5391
msgctxt "text_id=7063 | speaker=unknown"
msgid "　青子は語らないが、フラットスナークには他にも俗称がある。"
msgstr "  Aoko elected not to share this, but Flat Snark had other popular names as well."

#. Occurrence 5B_5:5396:7064: scene=5B_5
#: 5B_5:5396
msgctxt "text_id=7064 | speaker=unknown"
msgid "　不可解の島、五次元平面。"
msgstr "  The Enigmatic Island. The Five-Dimensional Plane."

#. Occurrence 5B_5:5401:7065: scene=5B_5
#: 5B_5:5401
msgctxt "text_id=7065 | speaker=unknown"
msgid "　こちらは有珠が口にしたものではなく、かつてマインスターに破れた魔術師たちのうわごとだ。"
msgstr "  These names were not given to it by Alice, but rather muttered by mages whom the Meinsters defeated."

#. Occurrence 5B_5:5464:7066: scene=5B_5
#: 5B_5:5464
msgctxt "text_id=7066 | speaker=unknown"
msgid "　数学において、スナークとはグラフ理論で用いられる、矛盾した、決してあり得ないある平面グラフを指す。"
msgstr "  In mathematics, 'snark' is a term used in graph theory to refer to contradictory and impossible planar graphs."

#. Occurrence 5B_5:5469:7067: scene=5B_5
#: 5B_5:5469
msgctxt "text_id=7067 | speaker=unknown"
msgid "　この世に『無い』と立証されながらも名を与えられた平面。逆説のみで構成された不遇の存在。"
msgstr "  A plane, proven to be unable to exist in this world, was given the name, apt for an ill-fated existence paradoxical in nature."

#. Occurrence 5B_5:5474:7068: scene=5B_5
#: 5B_5:5474
msgctxt "text_id=7068 | speaker=unknown"
msgid "　その名を冠した“童話の怪物”は、誰にも正体を明かす事がないという。"
msgstr "  The fairy-tale monster ascribed this name was said to hold no form discoverable by man."

#. Occurrence 5B_5:5495:7069: scene=5B_5
#: 5B_5:5495
msgctxt "text_id=7069 | speaker=unknown"
msgid "　……そして、青子は語らない。"
msgstr "  Aoko also declined to mention something else:"

#. Occurrence 5B_5:5500:7070: scene=5B_5
#: 5B_5:5500
msgctxt "text_id=7070 | speaker=unknown"
msgid "　フラットスナークは成長する“童話の怪物”だ。"
msgstr "  Flat Snark was a fairy-tale monster that could grow."

#. Occurrence 5B_5:5505:7071: scene=5B_5
#: 5B_5:5505
msgctxt "text_id=7071 | speaker=unknown"
msgid "　どこかに隠れている本体は、こうしている今も遊園地を完全な御伽の国に変えようと、<魔|い><力|き>を吐き続けている事を。"
msgstr "  It would hide somewhere in the amusement park, continuously exhaling magical energy until the park completely transformed into a fantasy land."

#. Occurrence 5B_5:5586:7072: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0077; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5586
msgctxt "text_id=7072 | speaker=aoko"
msgid "「……ま、<脅|おど>かしてもしょうがないし」"
msgstr "\"...Well, it's not like there's any point in scaring him.\""

#. Occurrence 5B_5:5619:7073: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0031; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:5619
msgctxt "text_id=7073 | speaker=soujuurou"
msgid "「なにか言ったか？」"
msgstr "\"Did you say something, Aozaki?\""

#. Occurrence 5B_5:5630:7074: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0078; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5630
msgctxt "text_id=7074 | speaker=aoko"
msgid "「別に。簡単に言って、『童話世界の再生』がフラットスナークの力なの。"
msgstr "\"Nope. I was just thinking, Flat Snark's power is its ability to bring fairy-tale worlds to life..."

#. Occurrence 5B_5:5636:7075: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0079; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5636
msgctxt "text_id=7075 | speaker=aoko"
msgid "　この遊園地との相性は抜群でしょうね。なにしろ、元々が童話を元にした遊び場だから」"
msgstr "  When you think about it, the park makes for the perfect backdrop. I mean, it was originally a playground based on fairy tales, anyway.\""

#. Occurrence 5B_5:5664:7076: scene=5B_5
#: 5B_5:5664
msgctxt "text_id=7076 | speaker=unknown"
msgid "　……仮にオフィス街であったのなら、フラットスナークもここまでの脅威は持たなかっただろう。"
msgstr "  If this had been a business district, for example, Flat Snark would have posed far less of a threat."

#. Occurrence 5B_5:5669:7077: scene=5B_5
#: 5B_5:5669
msgctxt "text_id=7077 | speaker=unknown"
msgid "　せいぜいビルの窓硝子に恐竜の影絵を映す程度の力だ。"
msgstr "  At most, its power would be limited to projecting the shadow of a dinosaur onto a building's window panes."

#. Occurrence 5B_5:5702:7078: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0032; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:5702
msgctxt "text_id=7078 | speaker=soujuurou"
msgid "「あ。だからここは安全だって―――"
msgstr "\"Ah, so that's why it's safe―"

msgctxt "text_id=7079 | speaker=unknown"
msgid "ん？」"
msgstr " Hm?\""

#. Occurrence 5B_5:5724:7080: scene=5B_5
#: 5B_5:5724
msgctxt "text_id=7080 | speaker=unknown"
msgid "　草十郎が“その異変”に気が付いたのは、背中にぴちょん、と<粘|ねば>つく液体が落ちたからだ。"
msgstr "  Soujyuro realized that something was wrong when he noticed a glutinous liquid dripping onto his back."

#. Occurrence 5B_5:5795:7081: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0033; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:5795
msgctxt "text_id=7081 | speaker=soujuurou"
msgid "「あ、あ―――」"
msgstr "\"Uh, um―\""

#. Occurrence 5B_5:5800:7082: scene=5B_5
#: 5B_5:5800
msgctxt "text_id=7082 | speaker=unknown"
msgid "　天井を見上げる。"
msgstr "  He looked up to the ceiling."

#. Occurrence 5B_5:5806:7083: scene=5B_5
#: 5B_5:5806
msgctxt "text_id=7083 | speaker=unknown"
msgid "<ソ|・><レ|・>と目が合う。"
msgstr "Their eyes met."

#. Occurrence 5B_5:5812:7084: scene=5B_5
#: 5B_5:5812
msgctxt "text_id=7084 | speaker=unknown"
msgid "どうなっているのか考える前に、草十郎の腰は跳ね上がって―――"
msgstr "Before he had a chance to think, Soujyuro hopped up from the floor."

#. Occurrence 5B_5:5857:7085: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_5_0034; voice_prefix=A30; voice_category=3; scene=5B_5
#: 5B_5:5857
msgctxt "text_id=7085 | speaker=soujuurou"
msgid "「蒼崎、外だ！」"
msgstr "\"Aozaki, get out, now!\""

#. Occurrence 5B_5:5863:7086: scene=5B_5
#: 5B_5:5863
msgctxt "text_id=7086 | speaker=unknown"
msgid "　彼は<率先|そっせん>してカウンターから飛び出した。"
msgstr "  Taking the initiative, he jumped out from behind the counter."

#. Occurrence 5B_5:5901:7087: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0080; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5901
msgctxt "text_id=7087 | speaker=aoko"
msgid "「バカ、何して―――」"
msgstr "\"Are you mad? What do you think you're―\""

#. Occurrence 5B_5:5921:7088: scene=5B_5
#: 5B_5:5921
msgctxt "text_id=7088 | speaker=unknown"
msgid "　自殺行為に等しい愚行を止めようと、つられて青子は腰を浮かす。"
msgstr "  Trying to stop him from committing an act of suicide, she also came to her feet."

#. Occurrence 5B_5:5926:7089: scene=5B_5
#: 5B_5:5926
msgctxt "text_id=7089 | speaker=unknown"
msgid "　瞬間、頭上に何が生まれているのかに気が付いた。"
msgstr "  Immediately, she noticed something coming to life overhead."

#. Occurrence 5B_5:5994:7090: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0081; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:5994
msgctxt "text_id=7090 | speaker=aoko"
msgid "「！　って、ヤバ―――!?」"
msgstr "\"What the―!? Oh, crap!\""

#. Occurrence 5B_5:6225:7091: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0082; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:6225
msgctxt "text_id=7091 | speaker=aoko"
msgid "「あ、危なかったぁ……！」"
msgstr "\"Oh my god, that was close!\""

#. Occurrence 5B_5:6242:7092: scene=5B_5
#: 5B_5:6242
msgctxt "text_id=7092 | speaker=unknown"
msgid "　ばくん、と閉じられる巨大な口。"
msgstr "  The gargantuan mouth clamped shut."

#. Occurrence 5B_5:6247:7093: scene=5B_5
#: 5B_5:6247
msgctxt "text_id=7093 | speaker=unknown"
msgid "　呼びこみマスコットのいないバーガーショップは、その店ごと怪物に変貌していた。"
msgstr "  With no mascot to speak of, the burger joint itself began to transform into one giant monster."

#. Occurrence 5B_5:6322:7094: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0083; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:6322
msgctxt "text_id=7094 | speaker=aoko"
msgid "「もうっ、なんで天井にピエロの絵なんて描いてんのよあの店！？"
msgstr "\"Who the hell paints a giant clown on the ceiling!?"

#. Occurrence 5B_5:6329:7095: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_5_0084; voice_prefix=A10; voice_category=1; scene=5B_5
#: 5B_5:6329
msgctxt "text_id=7095 | speaker=aoko"
msgid "　普通、もっと違うところに労力さかない！？　そんなにピエロが好きなら入り口にでも飾っとけ！」"
msgstr "  Shouldn't they have flexed their creative muscle somehow else!? If they liked clowns that much, why didn't they put it at the entrance!?\""

#. Occurrence 5B_5:6335:7096: scene=5B_5
#: 5B_5:6335
msgctxt "text_id=7096 | speaker=unknown"
msgid "　罵倒しながら走る青子。"
msgstr "  Aoko aired out her grievances as she ran."

#. Occurrence 5B_5:6340:7097: scene=5B_5
#: 5B_5:6340
msgctxt "text_id=7097 | speaker=unknown"
msgid "　……もう安全な場所はどこにもない。"
msgstr "  ...There was no safe haven left."

#. Occurrence 5B_5:6345:7098: scene=5B_5
#: 5B_5:6345
msgctxt "text_id=7098 | speaker=unknown"
msgid "　かろうじて残っていた文明圏すら、刻一刻と童話に侵食されていた。"
msgstr "  Moment by moment, the last remnants of civilization were being eroded away by fairy tales."

#. Occurrence 5B_6:310:7099: scene=5B_6
#: 5B_6:310
msgctxt "text_id=7099 | speaker=unknown"
msgid "　遊園地のスナーク化は最終段階を迎えていた。"
msgstr "  The amusement park had reached the final stage of Snarkification."

#. Occurrence 5B_6:315:7100: scene=5B_6
#: 5B_6:315
msgctxt "text_id=7100 | speaker=unknown"
msgid "　命を与えられたのはマスコットたちだけではない。"
msgstr "  It was not just the mascot characters that had been granted life;"

#. Occurrence 5B_6:320:7101: scene=5B_6
#: 5B_6:320
msgctxt "text_id=7101 | speaker=unknown"
msgid "　バーガーショップのように、建物すら生き物に変貌しようとしている。"
msgstr "  like the burger joint, even the buildings had begun to transform."

#. Occurrence 5B_6:325:7102: scene=5B_6
#: 5B_6:325
msgctxt "text_id=7102 | speaker=unknown"
msgid "　遊園地を巡るコースターは<中華龍|チャイニーズドラゴン>よろしく、うねうねとのたうつ始末。"
msgstr "  The roller coaster that made its way about the park writhed and twisted like a Chinese dragon."

#. Occurrence 5B_6:433:7103: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0000; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:433
msgctxt "text_id=7103 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 5B_6:506:7104: scene=5B_6
#: 5B_6:506
msgctxt "text_id=7104 | speaker=unknown"
msgid "　呆然と、全長八十メートル近くまで膨張した観覧車を見上げる青子と草十郎。"
msgstr "  Aoko and Soujyuro stared, dumbfounded by the Ferris wheel, which had grown to over two hundred and fifty feet in height."

#. Occurrence 5B_6:511:7105: scene=5B_6
#: 5B_6:511
msgctxt "text_id=7105 | speaker=unknown"
msgid "　そんなふたりにチケットを配るように、大量のブレッドマンが襲いかかる。"
msgstr "  Hordes of bread-men closed in on them, as if to offer tickets."

#. Occurrence 5B_6:605:7106: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0001; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:605
msgctxt "text_id=7106 | speaker=aoko"
msgid "「このっ、列整理は間に合ってるっての！」"
msgstr "\"I'm telling you, the line is under control!\""

#. Occurrence 5B_6:685:7107: scene=5B_6
#: 5B_6:685
msgctxt "text_id=7107 | speaker=unknown"
msgid "　わらわらと大挙するオブジェ。"
msgstr "  Mobs of trinkets―actual kickshaws―rampaged the park."

#. Occurrence 5B_6:690:7108: scene=5B_6
#: 5B_6:690
msgctxt "text_id=7108 | speaker=unknown"
msgid "　包囲網は破っても破っても形成される。"
msgstr "  Whenever a hole was punched in the envelopment, it was instantly filled."

#. Occurrence 5B_6:695:7109: scene=5B_6
#: 5B_6:695
msgctxt "text_id=7109 | speaker=unknown"
msgid "　絶え間ない物量作戦。"
msgstr "  It was a battle of attrition with no end in sight."

#. Occurrence 5B_6:701:7110: scene=5B_6
#: 5B_6:701
msgctxt "text_id=7110 | speaker=unknown"
msgid "さもありなん、資源の<枯渇|こかつ>で悩むおとぎ<噺|ばなし>は<滅多|めった>にない……！"
msgstr "But that was a matter of course, as there were few fairy tales about limited resources."

#. Occurrence 5B_6:785:7111: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_6_0000; voice_prefix=A30; voice_category=3; scene=5B_6
#: 5B_6:785
msgctxt "text_id=7111 | speaker=soujuurou"
msgid "「っ、なんかどうしようもないぞ！"
msgstr "\"This is hopeless!"

#. Occurrence 5B_6:785:7112: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_6_0000; voice_prefix=A30; voice_category=3; scene=5B_6
#: 5B_6:785
msgctxt "text_id=7112 | speaker=soujuurou"
msgid "　コイツら、増える一方だ！」"
msgstr "  They just keep coming!\""

#. Occurrence 5B_6:853:7113: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0002; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:853
msgctxt "text_id=7113 | speaker=aoko"
msgid "「スナーク本体を探して！"
msgstr "\"Look for the Snark's real form!"

#. Occurrence 5B_6:859:7114: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0003; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:859
msgctxt "text_id=7114 | speaker=aoko"
msgid "　童話の怪物には本体にあたる器物があるの！　それさえ壊せば遊園地から出られるはず！」"
msgstr "  A fairy tale monster always has some vessel for its body! If we can just destroy that, we should be able to get out of here!\""

#. Occurrence 5B_6:1023:7115: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_6_0001; voice_prefix=A30; voice_category=3; scene=5B_6
#: 5B_6:1023
msgctxt "text_id=7115 | speaker=soujuurou"
msgid "「本体ってどんな!?」"
msgstr "\"A body? What kind of body?!\""

#. Occurrence 5B_6:1135:7116: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0004; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1135
msgctxt "text_id=7116 | speaker=aoko"
msgid "「さっき言ったでしょ、童話の怪物は現実に無いものだって！　今までいなかったおかしなヤツとか、現実じゃありえないモノ！　それが本体！」"
msgstr "\"I already told you, fairy tale monsters can't exist in reality! Anything weird or impossible you've never seen before―that's going to be it!\""

#. Occurrence 5B_6:1189:7117: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_6_0002; voice_prefix=A30; voice_category=3; scene=5B_6
#: 5B_6:1189
msgctxt "text_id=7117 | speaker=soujuurou"
msgid "「おかしなヤツって、たとえば!?」"
msgstr "\"Something weird or impossible? I need an example!\""

#. Occurrence 5B_6:1325:7118: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0005; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1325
msgctxt "text_id=7118 | speaker=aoko"
msgid "「だから！"
msgstr "\"Do I have to spell it out for you?!"

#. Occurrence 5B_6:1331:7119: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0006; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1331
msgctxt "text_id=7119 | speaker=aoko"
msgid "　命のある人形とか、空飛ぶゴーカートとか―――」"
msgstr "  Living puppets, flying go karts...\""

#. Occurrence 5B_6:1373:7120: scene=5B_6
#: 5B_6:1373
msgctxt "text_id=7120 | speaker=unknown"
msgid "　魔弾を放つ青子の手が止まる。"
msgstr "  Aoko paused her firing for a moment."

#. Occurrence 5B_6:1378:7121: scene=5B_6
#: 5B_6:1378
msgctxt "text_id=7121 | speaker=unknown"
msgid "　口にして、自分たちがどれほど<窮|きわ>まっているかを思い知ったのだ。"
msgstr "  After saying this out loud, she realized just how deep their grave was dug."

#. Occurrence 5B_6:1383:7122: scene=5B_6
#: 5B_6:1383
msgctxt "text_id=7122 | speaker=unknown"
msgid "　遊園地は“童話の怪物”と思われるモノであふれている。"
msgstr "  The amusement park was a treasure trove of fairy tale-esque creatures on any given day."

#. Occurrence 5B_6:1388:7123: scene=5B_6
#: 5B_6:1388
msgctxt "text_id=7123 | speaker=unknown"
msgid "　変形し、自ら動き出したオブジェたちはみな“現実にないモノ”なのだ。"
msgstr "  Who could say what was impossible amidst the newly transfigured knickknacks running around?"

#. Occurrence 5B_6:1478:7124: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0007; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1478
msgctxt "text_id=7124 | speaker=aoko"
msgid "「……そっか。おかしくないヤツなんて、一つもないんだ」"
msgstr "\"...Damn. Everything in here is weird.\""

#. Occurrence 5B_6:1537:7125: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0008; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1537
msgctxt "text_id=7125 | speaker=aoko"
msgid "“この中に紛れこんでる……？”"
msgstr "(So it's hiding in plain sight...)"

#. Occurrence 5B_6:1553:7126: scene=5B_6
#: 5B_6:1553
msgctxt "text_id=7126 | speaker=unknown"
msgid "　青子は呟きながら、それはないな、と唇を噛んだ。"
msgstr "  Hoping that she was wrong, Aoko bit her bottom lip."

#. Occurrence 5B_6:1573:7127: scene=5B_6
#: 5B_6:1573
msgctxt "text_id=7127 | speaker=unknown"
msgid "　フラットスナークは結界を張るタイプの<怪物|プロイ>だ。"
msgstr "  Flat Snark was the type of Ploy that deployed Bounded Fields."

#. Occurrence 5B_6:1578:7128: scene=5B_6
#: 5B_6:1578
msgctxt "text_id=7128 | speaker=unknown"
msgid "　これだけ大量の使い魔を統率している以上、本体の防御力は低いか、もしくは<皆無|かいむ>と見るべきだろう。"
msgstr "  Seeing as it was commanding so many familiars, it would not be unusual for its main body to have little or even no defenses."

#. Occurrence 5B_6:1584:7129: scene=5B_6
#: 5B_6:1584
msgctxt "text_id=7129 | speaker=unknown"
msgid "　……加えて、“触れられぬもの”“正体不明”という物語を原型としているのなら、見抜かれたが最後、呆気なく崩壊するのが筋というもの。"
msgstr "  Furthermore, if it was modeled from a story about it being untouchable and unidentifiable, it would be logical to assume that it would collapse in on itself shortly after being discovered."

#. Occurrence 5B_6:1623:7130: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0009; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1623
msgctxt "text_id=7130 | speaker=aoko"
msgid "“……逆に言えば、見つければ私たちの勝ち。"
msgstr "(Which means... We find it, we win."

#. Occurrence 5B_6:1629:7131: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0010; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1629
msgctxt "text_id=7131 | speaker=aoko"
msgid "　そんな<脆|もろ>いヤツが雑魚に紛れこむ？　木の葉を隠すなら森の中って言うけど―――”"
msgstr "  Would something so fragile really hide among its minions? They do say that the best place to hide a leaf is in the woods...)"

#. Occurrence 5B_6:1758:7132: scene=5B_6
#: 5B_6:1758
msgctxt "text_id=7132 | speaker=unknown"
msgid "　この通り。"
msgstr "  This was closer to the truth than Aoko realized."

#. Occurrence 5B_6:1763:7133: scene=5B_6
#: 5B_6:1763
msgctxt "text_id=7133 | speaker=unknown"
msgid "　流れ弾であっさり吹き飛ぶ可能性がある以上、青子たちの前には現れない。"
msgstr "  As long as there was the slightest possibility of it being hit by one of Aoko's stray bullets, it would not dare appear in front of them."

#. Occurrence 5B_6:1768:7134: scene=5B_6
#: 5B_6:1768
msgctxt "text_id=7134 | speaker=unknown"
msgid "　スナーク本体はもっと安全な場所で、この遊園地を育てている。"
msgstr "  Its true form was orchestrating the park from somewhere safe."

#. Occurrence 5B_6:1856:7135: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0011; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1856
msgctxt "text_id=7135 | speaker=aoko"
msgid "“……でもどこかに見えているはず。"
msgstr "(I'm sure we've seen it already."

#. Occurrence 5B_6:1862:7136: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0012; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:1862
msgctxt "text_id=7136 | speaker=aoko"
msgid "　スナークは本の主題だもの。<常|つね>に<視界|ページ>のどこかにいないと、主人公の資格がない―――！”"
msgstr "  It's the subject of a book named after it. If it's not standing out on every page, it has no right to be the title character!)"

#. Occurrence 5B_6:1868:7137: scene=5B_6
#: 5B_6:1868
msgctxt "text_id=7137 | speaker=unknown"
msgid "　それはどこか。"
msgstr "  But where?"

#. Occurrence 5B_6:1873:7138: scene=5B_6
#: 5B_6:1873
msgctxt "text_id=7138 | speaker=unknown"
msgid "　安易に考えるなら、あの観覧車がもっとも安全、かつ遊園地を象徴する“主題”だが―――"
msgstr "  Put very simply, the Ferris wheel was the safest location in the park, as well as a symbol of its past glory. Perhaps..."

#. Occurrence 5B_6:1944:7139: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_6_0003; voice_prefix=A30; voice_category=3; scene=5B_6
#: 5B_6:1944
msgctxt "text_id=7139 | speaker=soujuurou"
msgid "「あの子を捕まえるのは！？」"
msgstr "\"What if we just try to catch her instead!?\""

#. Occurrence 5B_6:1957:7140: scene=5B_6
#: 5B_6:1957
msgctxt "text_id=7140 | speaker=unknown"
msgid "　突然の提案に目を見張る。"
msgstr "  Her eyes opened wide at the sudden suggestion."

#. Occurrence 5B_6:1962:7141: scene=5B_6
#: 5B_6:1962
msgctxt "text_id=7141 | speaker=unknown"
msgid "　青子が打開策を思案していたように、草十郎もまた、彼なりに頭を巡らせていたらしい。"
msgstr "  While Aoko had been trying to come up with a plan to overcome this stalemate, it seemed Soujyuro had been racking his brain as well."

#. Occurrence 5B_6:2017:7142: scene=5B_6
#: 5B_6:2017
msgctxt "text_id=7142 | speaker=unknown"
msgid "　草十郎の提案はシンプルだ。"
msgstr "  His proposal was a simple one."

#. Occurrence 5B_6:2022:7143: scene=5B_6
#: 5B_6:2022
msgctxt "text_id=7143 | speaker=unknown"
msgid "　スナークの本体が見つけられないのなら、その持ち主である有珠を倒せばいいのではないか。"
msgstr "  If they could not find the Snark, they just needed to take out its master, Alice."

#. Occurrence 5B_6:2027:7144: scene=5B_6
#: 5B_6:2027
msgctxt "text_id=7144 | speaker=unknown"
msgid "　有珠は時計台から動いていない。"
msgstr "  Alice had not moved at all from the clock tower."

#. Occurrence 5B_6:2032:7145: scene=5B_6
#: 5B_6:2032
msgctxt "text_id=7145 | speaker=unknown"
msgid "　ここからでも、月光に照らされる姿は目に入る。"
msgstr "  Even from here, they could make out her figure, draped in moonlight."

#. Occurrence 5B_6:2091:7146: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0013; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:2091
msgctxt "text_id=7146 | speaker=aoko"
msgid "「それは一番ダメ！"
msgstr "\"That's the worst move we could make!"

#. Occurrence 5B_6:2098:7147: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0014; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:2098
msgctxt "text_id=7147 | speaker=aoko"
msgid "　有珠を殺してもフラットスナークは止まらないし、このトンデモが外にあふれだす事になる！"
msgstr "  Even if we killed her, it wouldn't stop the Snark, and all of this absurdity would just boil over to outside the park!"

#. Occurrence 5B_6:2110:7148: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_6_0015; voice_prefix=A10; voice_category=1; scene=5B_6
#: 5B_6:2110
msgctxt "text_id=7148 | speaker=aoko"
msgid "　だいたい、私じゃあの子を殺せないから！　よくて半殺しがいいところ！」"
msgstr "  Not to mention, I can't even kill her in the first place! At best, I could only get halfway there!\""

#. Occurrence 5B_6:2230:7149: scene=5B_6
#: 5B_6:2230
msgctxt "text_id=7149 | speaker=unknown"
msgid "　主人の悪口にいきりたったブレッドマンが、こんがり無惨に焼け焦げになる。"
msgstr "  A bread-man, angered at the insults hurled toward its master, moved to attack and was mercilessly burned to a crisp."

#. Occurrence 5B_6:2307:7150: scene=5B_6
#: 5B_6:2307
msgctxt "text_id=7150 | speaker=unknown"
msgid "　……じり、と背中をあわせて呼吸を整えるふたり。"
msgstr "  The two stood back-to-back, catching their breath."

#. Occurrence 5B_6:2312:7151: scene=5B_6
#: 5B_6:2312
msgctxt "text_id=7151 | speaker=unknown"
msgid "　目の醒めるような打開策は出ず、いよいよもって八方ふさがりになった状況に消沈する。"
msgstr "  With no plan to speak of and no route of escape, they had reached rock bottom."

#. Occurrence 5B_7:52:7152: scene=5B_7
#: 5B_7:52
msgctxt "text_id=7152 | speaker=unknown"
msgid "　一方。<獲物|えもの>の活きの良さが分かるのか、オブジェたちは輪になって青子たちを観察していた。"
msgstr "  Meanwhile, the oddities were forming a circle around their prey, as if they smelled blood in the water."

#. Occurrence 5B_7:58:7153: scene=5B_7
#: 5B_7:58
msgctxt "text_id=7153 | speaker=unknown"
msgid "　パン屋にひきずりこんで焼き殺すか、"
msgstr "  Were they to be dragged into a bakery for the oven?"

msgctxt "text_id=7154 | speaker=unknown"
msgid "　精肉店の挽肉機ですり潰すか。"
msgstr "  Minced in the meat grinder at the butcher shop?"

#. Occurrence 5B_7:66:7155: scene=5B_7
#: 5B_7:66
msgctxt "text_id=7155 | speaker=unknown"
msgid "　はたまた串刺しにしてゴーラウンドで引き回すか、"
msgstr "  Skewered and paraded around atop the carousel?"

msgctxt "text_id=7156 | speaker=unknown"
msgid "　トゲトゲだらけの<海賊船|ゆりかご>に乗せて航海に乗りだすか。"
msgstr "  Walk the plank of the thorny pirate ship?"

#. Occurrence 5B_7:112:7157: scene=5B_7
#: 5B_7:112
msgctxt "text_id=7157 | speaker=unknown"
msgid "　二年間眠っていた分、歓迎意欲は盛りだくさんだ。"
msgstr "  After two years of slumber, they were eager to welcome their new guests."

#. Occurrence 5B_7:181:7158: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_7_0000; voice_prefix=A30; voice_category=3; scene=5B_7
#: 5B_7:181
msgctxt "text_id=7158 | speaker=soujuurou"
msgid "「……いちおう、聞いておきたいんだけど」"
msgstr "\"There's something I need to ask you, Aozaki.\""

#. Occurrence 5B_7:198:7159: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0000; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:198
msgctxt "text_id=7159 | speaker=aoko"
msgid "「なに。手短にね、いま考え事してるから」"
msgstr "\"What is it? Keep it snappy. I'm thinking here.\""

#. Occurrence 5B_7:215:7160: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_7_0001; voice_prefix=A30; voice_category=3; scene=5B_7
#: 5B_7:215
msgctxt "text_id=7160 | speaker=soujuurou"
msgid "「ああ。……あの連中がなにをしたいか、イヤっていうほど伝わってくるんだけど。それって、あの子の趣味なのかな」"
msgstr "\"Okay. It's painfully clear what these things want to do to us, but what about her? Does she enjoy this?\""

#. Occurrence 5B_7:254:7161: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0001; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:254
msgctxt "text_id=7161 | speaker=aoko"
msgid "「……その疑問はなかったわ。"
msgstr "\"I doubt it."

#. Occurrence 5B_7:261:7162: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0002; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:261
msgctxt "text_id=7162 | speaker=aoko"
msgid "連中の人間嫌いは遊園地の怨念と、フラットスナークの性格じゃない？　基本的にマトモなヤツいないから、有珠の使い魔って。"
msgstr "These things' hatred of humans comes from a deep-seated grudge within the park itself, and maybe even Flat Snark's personality too. Alice's familiars are one big family of freaks."

#. Occurrence 5B_7:273:7163: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0003; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:273
msgctxt "text_id=7163 | speaker=aoko"
msgid "　ああ、でも―――」"
msgstr "  Though, now that you mention it...\""

#. Occurrence 5B_7:327:7164: scene=5B_7
#: 5B_7:327
msgctxt "text_id=7164 | speaker=unknown"
msgid "　なんというか、有珠の性格の怖さも否定できない青子だった。"
msgstr "  Aoko was unable to deny that there were some similarities."

#. Occurrence 5B_7:354:7165: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_7_0002; voice_prefix=A30; voice_category=3; scene=5B_7
#: 5B_7:354
msgctxt "text_id=7165 | speaker=soujuurou"
msgid "「それは結構。……それで、蒼崎の考えごとって？　止める方法、考えついたのか？」"
msgstr "\"Good to know. ...So, did you come up with anything, Aozaki? How do we stop them?\""

#. Occurrence 5B_7:365:7166: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0004; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:365
msgctxt "text_id=7166 | speaker=aoko"
msgid "「期待させて悪いけどお手上げ。ま、アンタが殺されれば止まるでしょうけど」"
msgstr "\"Sorry to get your hopes up, but I'm all out of ideas. Oh, but I bet they'd stop if you dropped dead.\""

#. Occurrence 5B_7:377:7167: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_7_0003; voice_prefix=A30; voice_category=3; scene=5B_7
#: 5B_7:377
msgctxt "text_id=7167 | speaker=soujuurou"
msgid "「それはイヤだ！　とりあえず逃げよう！」"
msgstr "\"No, thank you! Let's just get out of here!\""

#. Occurrence 5B_7:405:7168: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0005; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:405
msgctxt "text_id=7168 | speaker=aoko"
msgid "「え、ちょっ、静希君！？」"
msgstr "\"Hey, wait! Sizuki!?\""

#. Occurrence 5B_7:474:7169: scene=5B_7
#: 5B_7:474
msgctxt "text_id=7169 | speaker=unknown"
msgid "　―――突然の<展|こ><開|と>に目を見張る。"
msgstr "  She blinked in surprise at the sudden turn of events."

#. Occurrence 5B_7:480:7170: scene=5B_7
#: 5B_7:480
msgctxt "text_id=7170 | speaker=unknown"
msgid "　今まで青子に付いてくるだけだった草十郎は強引に青子の手を取って、焼きたてパンの群に突進―――囲みを<破|やぶ>ろうと力任せに特攻する。"
msgstr "  Soujyuro, who had until now been meekly following her lead, had grabbed Aoko's hand and pulled her with him into a head-on charge at the swarm of bread, in an attempt to break out of the encirclement."

#. Occurrence 5B_7:740:7171: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0006; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:740
msgctxt "text_id=7171 | speaker=aoko"
msgid "「い、意味わかんなすぎ！"
msgstr "\"Are you out of your mind!?"

#. Occurrence 5B_7:746:7172: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0007; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:746
msgctxt "text_id=7172 | speaker=aoko"
msgid "　なんで今の流れでそうなるのよアンタはーーーー！？」"
msgstr "  How on earth do you figure this is what we do next!?\""

#. Occurrence 5B_7:831:7173: scene=5B_7
#: 5B_7:831
msgctxt "text_id=7173 | speaker=unknown"
msgid "　別人のようなアグレッシブさを発揮する草十郎を<罵|ののし>りながら、律儀にフォローする青子。"
msgstr "  Aoko nonetheless followed Soujyuro's uncharacteristically gung-ho lead, cursing him all the while."

#. Occurrence 5B_7:921:7174: scene=5B_7
#: 5B_7:921
msgctxt "text_id=7174 | speaker=unknown"
msgid "　草十郎の体当たりでは包囲網を突破できない。"
msgstr "  Alone, he had no chance of breaking through the surrounding wall of enemies with brute force."

#. Occurrence 5B_7:926:7175: scene=5B_7
#: 5B_7:926
msgctxt "text_id=7175 | speaker=unknown"
msgid "　青子はすぐさま体勢をたてなおし、草十郎の正面に魔弾を掃射する。"
msgstr "  Aoko regained her bearings and let fly a spray of magic bullets ahead of Soujyuro."

#. Occurrence 5B_7:1015:7176: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0008; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:1015
msgctxt "text_id=7176 | speaker=aoko"
msgid "「っ、はっ―――！」"
msgstr "\"Hah...!\""

#. Occurrence 5B_7:1021:7177: scene=5B_7
#: 5B_7:1021
msgctxt "text_id=7177 | speaker=unknown"
msgid "　囲いを抜け、全力で走りだす。"
msgstr "  They burst through the net and ran as hard as they could."

#. Occurrence 5B_7:1026:7178: scene=5B_7
#: 5B_7:1026
msgctxt "text_id=7178 | speaker=unknown"
msgid "　こうなっては当初の予定通り、遊園地の外を目指すしかない。"
msgstr "  At this point, all that was left to do was what they had planned from the outset: get out of the park."

#. Occurrence 5B_7:1046:7179: scene=5B_7
#: 5B_7:1046
msgctxt "text_id=7179 | speaker=unknown"
msgid "　……まあ、それはともかくとして。"
msgstr "  But not before addressing what needed to be addressed."

#. Occurrence 5B_7:1103:7180: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0009; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:1103
msgctxt "text_id=7180 | speaker=aoko"
msgid "「なんでよ!?　さっきはあんなに諦め良かったのに！」"
msgstr "\"Where the hell did that come from! Hadn't you already given up back at the house of mirrors?!\""

#. Occurrence 5B_7:1109:7181: scene=5B_7
#: 5B_7:1109
msgctxt "text_id=7181 | speaker=unknown"
msgid "　青子には草十郎の反応が、とにかくホントに理解不能。"
msgstr "  Aoko could not begin to comprehend Soujyuro's reaction."

#. Occurrence 5B_7:1178:7182: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_7_0004; voice_prefix=A30; voice_category=3; scene=5B_7
#: 5B_7:1178
msgctxt "text_id=7182 | speaker=soujuurou"
msgid "「ミラーハウスの時と今は違うだろ！　いいから走れ！」"
msgstr "\"That was then and this is now! Just run!\""

#. Occurrence 5B_7:1229:7183: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0010; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:1229
msgctxt "text_id=7183 | speaker=aoko"
msgid "「違わないわよ！　アンタを殺そうとした私も、アンタを殺したい有珠も！　理由も結果も同じよ、私たち!?」"
msgstr "\"What are you talking about!? Alice wants to kill you for exactly the same reasons I did! This won't play out any differently!\""

#. Occurrence 5B_7:1281:7184: scene=5B_7
#: 5B_7:1281
msgctxt "text_id=7184 | speaker=unknown"
msgid "　何でこんなコトで怒鳴っているんだろう、と思いながらも青子は止まらない。"
msgstr "  Though she wondered what was getting her so worked up, Aoko did not stop."

#. Occurrence 5B_7:1286:7185: scene=5B_7
#: 5B_7:1286
msgctxt "text_id=7185 | speaker=unknown"
msgid "　きっと、無謀にもブレッドマンに突進した草十郎の馬鹿さ加減が頭にきているんだ、と自分自身に言い聞かせる。"
msgstr "  She told herself that the degree of Soujyuro's stupidity, charging the bread-men so recklessly, had caused her to lose her cool."

#. Occurrence 5B_7:1352:7186: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0011; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:1352
msgctxt "text_id=7186 | speaker=aoko"
msgid "「あのね、一緒に逃げてるぐらいで勘違いしないでくれる!?　言っとくけど私、明日になったらまたアンタを殺しに行くから！　死にたくないってんなら、ここで私からも逃げだしたら!?」"
msgstr "\"Hey, don't get the wrong idea! I'm gonna try and kill you again tomorrow! I'll really do it! So if you don't want to die, you should be trying to escape me too, got it?!\""

#. Occurrence 5B_7:1417:7187: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_7_0005; voice_prefix=A30; voice_category=3; scene=5B_7
#: 5B_7:1417
msgctxt "text_id=7187 | speaker=soujuurou"
msgid "「それはまた今度の話だろ！　だいたい、蒼崎に殺されるのならいいけど、あの子に殺されるのはイヤだ！」"
msgstr "\"Then let's talk about that tomorrow! I don't really care if you kill me, but just don't want to be killed by that girl!\""

#. Occurrence 5B_7:1423:7188: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0012; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:1423
msgctxt "text_id=7188 | speaker=aoko"
msgid "「だからなんで！？」"
msgstr "\"Like I said, WHY THE HELL NOT!?\""

#. Occurrence 5B_7:1429:7189: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_7_0006; voice_prefix=A30; voice_category=3; scene=5B_7
#: 5B_7:1429
msgctxt "text_id=7189 | speaker=soujuurou"
msgid "「だって顔も知らない！　話したコトさえない相手だ！」"
msgstr "\"I don't even know what she looks like, nor have I ever spoken to her!\""

#. Occurrence 5B_7:1483:7190: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0013; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:1483
msgctxt "text_id=7190 | speaker=aoko"
msgid "「―――は？」"
msgstr "\"...What?\""

#. Occurrence 5B_7:1518:7191: scene=5B_7
#: 5B_7:1518
msgctxt "text_id=7191 | speaker=unknown"
msgid "　沸き立っていた激情が、一瞬で鎮火する。"
msgstr "  It was like someone had doused water over her blazing fury."

#. Occurrence 5B_7:1523:7192: scene=5B_7
#: 5B_7:1523
msgctxt "text_id=7192 | speaker=unknown"
msgid "　あまりに簡潔かつどうでもいい理由に、青子の<直情|いかり>はあっさりと消えてしまった。"
msgstr "  Aoko's anger was snuffed out by the absurd simplicity of his reasoning."

#. Occurrence 5B_7:1574:7193: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_7_0014; voice_prefix=A10; voice_category=1; scene=5B_7
#: 5B_7:1574
msgctxt "text_id=7193 | speaker=aoko"
msgid "「顔も知らないって……」"
msgstr "\"Because you don't know what she looks like?\""

#. Occurrence 5B_7:1581:7194: scene=5B_7
#: 5B_7:1581
msgctxt "text_id=7194 | speaker=unknown"
msgid "　草十郎としては、よく知った相手なら殺されてもいいのだろうか？"
msgstr "  Could it be that Soujyuro did not mind being killed by someone as long as he had met them?"

#. Occurrence 5B_7:1586:7195: scene=5B_7
#: 5B_7:1586
msgctxt "text_id=7195 | speaker=unknown"
msgid "　ますますもって理解できない、と顔をしかめながら、青子は草十郎の背中を追いかけるのだった。"
msgstr "  Aoko grimaced as she followed him. "

#. Occurrence 5B_8:77:7196: scene=5B_8
#: 5B_8:77
msgctxt "text_id=7196 | speaker=unknown"
msgid "　時計台の上で、少女は使い魔の成長を監視している。"
msgstr "  From her spot atop the clock tower, the girl observed the growth of her familiar."

#. Occurrence 5B_8:82:7197: scene=5B_8
#: 5B_8:82
msgctxt "text_id=7197 | speaker=unknown"
msgid "　フラットスナーク。"
msgstr "  Flat Snark."

#. Occurrence 5B_8:87:7198: scene=5B_8
#: 5B_8:87
msgctxt "text_id=7198 | speaker=unknown"
msgid "　廃棄されたモノたちの救世主。"
msgstr "  A savior of the discarded."

#. Occurrence 5B_8:92:7199: scene=5B_8
#: 5B_8:92
msgctxt "text_id=7199 | speaker=unknown"
msgid "　朽ちゆく<運命|さだめ>のモノたちに一時の希望を与え、根こそぎ奪い去る、<性悪|しょうわる>で<低俗|ていぞく>な“童話の怪物”。"
msgstr "  It was a vile, vulgar fairy-tale monster who provided those abandoned by fate with a glimmer of hope, before snatching it away."

#. Occurrence 5B_8:99:7200: scene=5B_8
#: 5B_8:99
msgctxt "text_id=7200 | speaker=unknown"
msgid "　自らの手駒ではあるが、スナークがその<悪癖|あくへき>を発揮しないよう、少女は目を光らせていた。"
msgstr "  Alice had it under her control, but she was still keen to keep the Snark from expressing its bad habits."

#. Occurrence 5B_8:120:7201: scene=5B_8
#: 5B_8:120
msgctxt "text_id=7201 | speaker=unknown"
msgid "　いまやひとつの街ほどまでに広がった遊園地を一周した駒鳥が、少女に現状を報告する。"
msgstr "  After completing a lap around the park that had now reached the size of an entire town, the robin made its situation report."

#. Occurrence 5B_8:183:7202: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_8_0000; voice_prefix=A40; voice_category=2; scene=5B_8
#: 5B_8:183
msgctxt "text_id=7202 | speaker=alice"
msgid "「……そう。外を目指しているの」"
msgstr "\"...So. They're trying to get out.\""

#. Occurrence 5B_8:189:7203: scene=5B_8
#: 5B_8:189
msgctxt "text_id=7203 | speaker=unknown"
msgid "　青子は少年の安全を優先したのだろう。"
msgstr "  It seemed Aoko was prioritizing the safety of the boy."

#. Occurrence 5B_8:194:7204: scene=5B_8
#: 5B_8:194
msgctxt "text_id=7204 | speaker=unknown"
msgid "　たとえ一日で無駄になる事でも、一度決めた事を曲げないのは実に彼女らしい。"
msgstr "  Even if it resulted in wasting an entire day, choosing not to capitulate on a decision was very much like her."

#. Occurrence 5B_8:267:7205: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_8_0001; voice_prefix=A40; voice_category=2; scene=5B_8
#: 5B_8:267
msgctxt "text_id=7205 | speaker=alice"
msgid "「青子の事だから、時計台ごと私を焼き払いにくるかと思ったけど」"
msgstr "\"That's too bad. I was sure Aoko would attempt to burn down the clock tower and me with it.\""

#. Occurrence 5B_8:273:7206: scene=5B_8
#: 5B_8:273
msgctxt "text_id=7206 | speaker=unknown"
msgid "　チチチ、と<嘴|くちばし>を鳴らす青い鳥。"
msgstr "  The blue bird cheeped in response."

#. Occurrence 5B_8:278:7207: scene=5B_8
#: 5B_8:278
msgctxt "text_id=7207 | speaker=unknown"
msgid "　主人の語る青子像を否定しているのか、"
msgstr "  Was it denying its master's portrait of Aoko,"

#. Occurrence 5B_8:283:7208: scene=5B_8
#: 5B_8:283
msgctxt "text_id=7208 | speaker=unknown"
msgid "　青子ならやりかねないと同意しているのか。"
msgstr "  or agreeing that it was Aoko's style to do exactly that?"

#. Occurrence 5B_8:288:7209: scene=5B_8
#: 5B_8:288
msgctxt "text_id=7209 | speaker=unknown"
msgid "　傍目にはどちらにも取れる合いの手である。"
msgstr "  An outsider might interpret its interjections either way."

#. Occurrence 5B_8:337:7210: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_8_0002; voice_prefix=A40; voice_category=2; scene=5B_8
#: 5B_8:337
msgctxt "text_id=7210 | speaker=alice"
msgid "「退屈？」"
msgstr "\"Does this bore you?\""

#. Occurrence 5B_8:345:7211: scene=5B_8
#: 5B_8:345
msgctxt "text_id=7211 | speaker=unknown"
msgid "　突然話しかけられ、ビクッと震える駒鳥。"
msgstr "  The robin jumped at being addressed so unexpectedly."

#. Occurrence 5B_8:350:7212: scene=5B_8
#: 5B_8:350
msgctxt "text_id=7212 | speaker=unknown"
msgid "　チチチ、と必死に羽を振る仕草は、“そんなコトないっス！”とあわてる<丁稚|でっち>のようだ。"
msgstr "  It chirped and flapped its wings like a flustered servant, frantic to say otherwise."

#. Occurrence 5B_8:445:7213: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_8_0003; voice_prefix=A40; voice_category=2; scene=5B_8
#: 5B_8:445
msgctxt "text_id=7213 | speaker=alice"
msgid "「……珍しく気があったわね。"
msgstr "\"...It's rare for us to get along so well."

#. Occurrence 5B_8:451:7214: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_8_0004; voice_prefix=A40; voice_category=2; scene=5B_8
#: 5B_8:451
msgctxt "text_id=7214 | speaker=alice"
msgid "　いいわ。せっかくのゲームだし、もう少しだけ盛り上げましょう」"
msgstr "  Okay then. If it's a game she wants, a game she'll get. Let's liven things up a bit, shall we?\""

#. Occurrence 5B_8:457:7215: scene=5B_8
#: 5B_8:457
msgctxt "text_id=7215 | speaker=unknown"
msgid "　無表情のまま少女は小さな器物を取り出した。"
msgstr "  Calmly, she pulled out a small object from her pocket."

#. Occurrence 5B_8:462:7216: scene=5B_8
#: 5B_8:462
msgctxt "text_id=7216 | speaker=unknown"
msgid "　カチカチと内から秒針の音をこぼす、鈍色の<装飾卵|イースターエッグ>。"
msgstr "  It was a dark-gray Easter egg, and emanating from inside it was the ticking of a clock."

#. Occurrence 5B_8:531:7217: scene=5B_8
#: 5B_8:531
msgctxt "text_id=7217 | speaker=unknown"
msgid "　それがフラットスナークには及ばずとも、対個人戦においてトップランクに<性質|タチ>の悪い“<童話の怪物|プロイキッシャー>”である事を、駒鳥は知っている。"
msgstr "  The robin knew it to be a Ploy Kickshaw with a bad attitude far exceeding Flat Snark's, known to be among the best in one-on-one situations."

#. Occurrence 5B_8:645:7218: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_8_0005; voice_prefix=A40; voice_category=2; scene=5B_8
#: 5B_8:645
msgctxt "text_id=7218 | speaker=alice"
msgid "「行ってらっしゃい。<讃|たた>える時間は二十分に設定したわ。"
msgstr "\"Go. I've set the extolling time for twenty minutes."

#. Occurrence 5B_8:651:7219: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_5B_8_0006; voice_prefix=A40; voice_category=2; scene=5B_8
#: 5B_8:651
msgctxt "text_id=7219 | speaker=alice"
msgid "　……いつも通り、控え目に壊れてきて」"
msgstr "  Break, in that subtle way of yours.\""

#. Occurrence 5B_8:657:7220: scene=5B_8
#: 5B_8:657
msgctxt "text_id=7220 | speaker=unknown"
msgid "　魔女の一息と共に、<祝|いわ>いの言葉がつまった卵が消える。"
msgstr "  And together with the witch's breath, the egg filled with praise disappeared."

#. Occurrence 5B_8:724:7221: scene=5B_8
#: 5B_8:724
msgctxt "text_id=7221 | speaker=unknown"
msgid "　不意に、遊園地に強い風が吹いた。"
msgstr "  Suddenly, a strong wind swept through the park."

#. Occurrence 5B_8:730:7222: scene=5B_8
#: 5B_8:730
msgctxt "text_id=7222 | speaker=unknown"
msgid "　　　『彼らを殺すのは、自分だけで十分なのに』と。"
msgstr "      The words \"I could have killed them all by myself\" floated through the air."

#. Occurrence 5B_8:736:7223: scene=5B_8
#: 5B_8:736
msgctxt "text_id=7223 | speaker=unknown"
msgid "　それは、目に映っていながら見過ごしてしまう、巨大な何かの嘆息のようだった。"
msgstr "  It was the disappointment of something enormous that was visible to all, yet overlooked."

#. Occurrence 5B_9:94:7224: scene=5B_9
#: 5B_9:94
msgctxt "text_id=7224 | speaker=unknown"
msgid "　遊園地と外を分ける境界線に向かって、青子たちは走り続ける。"
msgstr "  Aoko and Soujyuro continued their dash toward the boundary separating the park from outside."

#. Occurrence 5B_9:248:7225: scene=5B_9
#: 5B_9:248
msgctxt "text_id=7225 | speaker=unknown"
msgid "　行く手を阻むオブジェの数は減ってきていた。"
msgstr "  The curio horde that stood in their way had reduced in number."

#. Occurrence 5B_9:253:7226: scene=5B_9
#: 5B_9:253
msgctxt "text_id=7226 | speaker=unknown"
msgid "　<外|そ><界|と>に通じる東側の鉄柵まで、あと三百メートル弱。"
msgstr "  The iron fence that separated the two from the outside world was just over three hundred yards away."

#. Occurrence 5B_9:318:7227: scene=5B_9
#: 5B_9:318
msgctxt "text_id=7227 | speaker=unknown"
msgid "　幸運な事に、鉄柵への道中にはこれといって巨大な建物はない。"
msgstr "  Fortunately, there were no particularly large buildings barring their path."

#. Occurrence 5B_9:325:7228: scene=5B_9
#: 5B_9:325
msgctxt "text_id=7228 | speaker=unknown"
msgid "　あの観覧車に立ち<塞|ふさ>がられたらそれこそ終わりだが、観覧車が動き出すまであと幾ばくかの<猶予|ゆうよ>があるようだ。"
msgstr "  If the Ferris wheel had stood in their way, that would have spelled the end, but thankfully, it had yet to reach its full strength."

#. Occurrence 5B_9:330:7229: scene=5B_9
#: 5B_9:330
msgctxt "text_id=7229 | speaker=unknown"
msgid "　現れるのは青子の簡易魔術で吹き飛ばせる程度のオブジェのみ。"
msgstr "  The only things that appeared before them were weak oddities that could easily be handled by Aoko's simple magecraft."

#. Occurrence 5B_9:351:7230: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0000; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:351
msgctxt "text_id=7230 | speaker=aoko"
msgid "“これなら、なんとか―――”"
msgstr "\"At this rate, we just might...\""

#. Occurrence 5B_9:410:7231: scene=5B_9
#: 5B_9:410
msgctxt "text_id=7231 | speaker=unknown"
msgid "　鉄柵まで辿り着ける、と青子は呼吸を整える。"
msgstr "  She would have said \"make it to the fence,\" if only her lungs would allow it."

#. Occurrence 5B_9:415:7232: scene=5B_9
#: 5B_9:415
msgctxt "text_id=7232 | speaker=unknown"
msgid "　遊園地に満ちている<魔力|マナ>を使用しているので、青子本人の魔力はほぼ満タン。"
msgstr "  Since Aoko was utilizing the ample mana filling the park, her tank of magical energy was nearly full."

#. Occurrence 5B_9:420:7233: scene=5B_9
#: 5B_9:420
msgctxt "text_id=7233 | speaker=unknown"
msgid "　<身体|からだ>の魔術回路は調子をあげる一方だし、一度ぐらいは全開で魔術行使をしてもいいぐらいだ。"
msgstr "  Moreover, the condition of her body's circuits was steadily improving, to the extent that she would be able to unleash at least one all-out onslaught."

#. Occurrence 5B_9:520:7234: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0001; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:520
msgctxt "text_id=7234 | speaker=aoko"
msgid "「―――？」"
msgstr "\"...?\""

#. Occurrence 5B_9:526:7235: scene=5B_9
#: 5B_9:526
msgctxt "text_id=7235 | speaker=unknown"
msgid "　と。"
msgstr "  Until..."

#. Occurrence 5B_9:532:7236: scene=5B_9
#: 5B_9:532
msgctxt "text_id=7236 | speaker=unknown"
msgid "そんな青子の視界上空に、なにやら系統の違うモノが浮遊していた。"
msgstr "Something unusual was hovering above her field of vision."

#. Occurrence 5B_9:537:7237: scene=5B_9
#: 5B_9:537
msgctxt "text_id=7237 | speaker=unknown"
msgid "　それは草十郎のななめ上空に張りつき、三メートルの高さを維持したまま移動している。"
msgstr "  It was locked on Soujyuro, hovering ten feet above him over to one side."

#. Occurrence 5B_9:616:7238: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0002; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:616
msgctxt "text_id=7238 | speaker=aoko"
msgid "「静希君、ちょっと」"
msgstr "\"Sizuki! Look!\""

#. Occurrence 5B_9:622:7239: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0000; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:622
msgctxt "text_id=7239 | speaker=soujuurou"
msgid "「ああ。さっきから付いてきてる」"
msgstr "\"What? That thing? It's been on us for a while.\""

#. Occurrence 5B_9:628:7240: scene=5B_9
#: 5B_9:628
msgctxt "text_id=7240 | speaker=unknown"
msgid "　青子より先に気づいていたのか、草十郎はイヤそうに上空を盗み見ていた。"
msgstr "  Soujyuro had seemingly noticed it before Aoko, hence his previous awkward glances toward the sky."

#. Occurrence 5B_9:633:7241: scene=5B_9
#: 5B_9:633
msgctxt "text_id=7241 | speaker=unknown"
msgid "　なにしろ自分にぴったりとくっついて来ているのだ。気にならない方がおかしい。"
msgstr "  In truth, it would have been stranger for him not to notice as the thing was practically glued to him."

#. Occurrence 5B_9:766:7242: scene=5B_9
#: 5B_9:766
msgctxt "text_id=7242 | speaker=unknown"
msgid "　浮遊物は大きさにして直径一メートルほど。"
msgstr "  In terms of its size, the floating object measured about three feet in diameter."

#. Occurrence 5B_9:771:7243: scene=5B_9
#: 5B_9:771
msgctxt "text_id=7243 | speaker=unknown"
msgid "　表面のタイルには<十|と><重|え><二|は><十|た><重|え>に廻る光の躍動。"
msgstr "  Tiles covered its exterior, about which a multitude of spinning lights danced about."

#. Occurrence 5B_9:792:7244: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0001; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:792
msgctxt "text_id=7244 | speaker=soujuurou"
msgid "「……卵、かな」"
msgstr "\"Is that an... egg?\""

#. Occurrence 5B_9:797:7245: scene=5B_9
#: 5B_9:797
msgctxt "text_id=7245 | speaker=unknown"
msgid "　草十郎は自信なさげに呟いた。"
msgstr "  Soujyuro asked, not really sure what to call it."

#. Occurrence 5B_9:865:7246: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0003; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:865
msgctxt "text_id=7246 | speaker=aoko"
msgid "「卵……？　卵って言ったら―――割れる卵！」"
msgstr "\"An egg? If it's an egg, then that means it'll crack!\""

#. Occurrence 5B_9:1010:7247: scene=5B_9
#: 5B_9:1010
msgctxt "text_id=7247 | speaker=unknown"
msgid "　<衛星|たまご>はゴムのように魔弾を弾く。"
msgstr "  Her bullets bounced off like it was made of rubber."

#. Occurrence 5B_9:1015:7248: scene=5B_9
#: 5B_9:1015
msgctxt "text_id=7248 | speaker=unknown"
msgid "　その特性―――干渉を当然のように無効化するのは、間違いなく“<童話の怪物|プロイキッシャー>”……！"
msgstr "  That trait―the ability to deflect all outside interference―confirmed to Aoko that this thing was undoubtedly a Ploy Kickshaw."

#. Occurrence 5B_9:1099:7249: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0004; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1099
msgctxt "text_id=7249 | speaker=aoko"
msgid "「やっぱり外からのルールじゃ壊れないか……"
msgstr "\"Knew it. I can't break its rules from the outside."

#. Occurrence 5B_9:1105:7250: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0005; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1105
msgctxt "text_id=7250 | speaker=aoko"
msgid "　静希君、アレから絶対に目をそらさないで！"
msgstr "  Sizuki, don't take your eyes off it even for a second!"

#. Occurrence 5B_9:1111:7251: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0006; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1111
msgctxt "text_id=7251 | speaker=aoko"
msgid "　いい、何があっても見続けること！　視界の<隅|すみ>に入れとくだけでいいから！」"
msgstr "  No matter what happens, keep your eyes locked on it! Even if it's just in the corner of your vision!\""

#. Occurrence 5B_9:1117:7252: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0002; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:1117
msgctxt "text_id=7252 | speaker=soujuurou"
msgid "「あ、ああ!?」"
msgstr "\"O-Okay?\""

#. Occurrence 5B_9:1155:7253: scene=5B_9
#: 5B_9:1155
msgctxt "text_id=7253 | speaker=unknown"
msgid "　草十郎に指示をだしながら、青子は走る速度を速める。"
msgstr "  Aoko picked up her pace as she barked orders."

#. Occurrence 5B_9:1160:7254: scene=5B_9
#: 5B_9:1160
msgctxt "text_id=7254 | speaker=unknown"
msgid "　……アレは文字通り、割れる卵だ。"
msgstr "  The egg man who sat on a wall..."

#. Occurrence 5B_9:1165:7255: scene=5B_9
#: 5B_9:1165
msgctxt "text_id=7255 | speaker=unknown"
msgid "　塀の上に乗った卵人間。"
msgstr "  He would crack, just as the tale spoke of."

#. Occurrence 5B_9:1170:7256: scene=5B_9
#: 5B_9:1170
msgctxt "text_id=7256 | speaker=unknown"
msgid "　何をしても、何を言っても決して落ちる事はないが、目を離した途端に落下して破片をまき散らす。"
msgstr "  Nothing anyone could do or say would cause him to fall, but the moment they stopped looking, he would tumble down and break into pieces."

#. Occurrence 5B_9:1224:7257: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0007; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1224
msgctxt "text_id=7257 | speaker=aoko"
msgid "「曰く、王様の軍隊でも元に戻せない数の破片―――」"
msgstr "\"'All the king's horses and all the king's men could put him back together again.' Or so it's said.\""

#. Occurrence 5B_9:1230:7258: scene=5B_9
#: 5B_9:1230
msgctxt "text_id=7258 | speaker=unknown"
msgid "　それがマザーグースに唄われるハンプティ・ダンプティの一節だ。"
msgstr "  It was the Mother Goose poem, Humpty Dumpty."

#. Occurrence 5B_9:1235:7259: scene=5B_9
#: 5B_9:1235
msgctxt "text_id=7259 | speaker=unknown"
msgid "　あの卵の標的が草十郎なら、草十郎が卵から視線をきった瞬間、落下して爆発する……！"
msgstr "  If Soujyuro was its target, then the moment he averted his gaze, it would tumble and explode."

#. Occurrence 5B_9:1299:7260: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0008; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1299
msgctxt "text_id=7260 | speaker=aoko"
msgid "「……まあ、爆発するかどうかは知らないけど」"
msgstr "\"Except for the exploding part. Who knows what'll happen when it falls.\""

#. Occurrence 5B_9:1305:7261: scene=5B_9
#: 5B_9:1305
msgctxt "text_id=7261 | speaker=unknown"
msgid "　どうあれ、厄介なモノをまき散らすに違いない。"
msgstr "  Either way, it was going to scatter something troublesome when it fell."

#. Occurrence 5B_9:1310:7262: scene=5B_9
#: 5B_9:1310
msgctxt "text_id=7262 | speaker=unknown"
msgid "　卵という形状、錠門の装飾、刻まれた詩文も気になる。"
msgstr "  Its oval shape, the keyhole adorning the front, and writing inscribed upon it... They all made her anxious."

#. Occurrence 5B_9:1315:7263: scene=5B_9
#: 5B_9:1315
msgctxt "text_id=7263 | speaker=unknown"
msgid "　アレが卵ならいつかは<孵|かえ>る。"
msgstr "  If it was an egg, that meant it was going to hatch at some point."

#. Occurrence 5B_9:1320:7264: scene=5B_9
#: 5B_9:1320
msgctxt "text_id=7264 | speaker=unknown"
msgid "　ずっと見続けていても、時間がくれば“中身が出る”としたら、ますます余力を残している場合ではない。"
msgstr "  Even if he continued his stare, once the time came for whatever was inside to come out, they would have even less ability to conserve their energy."

#. Occurrence 5B_9:1384:7265: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0003; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:1384
msgctxt "text_id=7265 | speaker=soujuurou"
msgid "「蒼崎、速すぎないか!?"
msgstr "\"Aozaki, slow down, would you!"

#. Occurrence 5B_9:1390:7266: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0004; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:1390
msgctxt "text_id=7266 | speaker=soujuurou"
msgid "　あんまり全力で走ると―――」"
msgstr "  If you use up all of your energy now, you'll―\""

#. Occurrence 5B_9:1436:7267: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0009; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1436
msgctxt "text_id=7267 | speaker=aoko"
msgid "「後の事は考えないで！"
msgstr "\"Forget about what comes next!"

#. Occurrence 5B_9:1442:7268: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0010; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1442
msgctxt "text_id=7268 | speaker=aoko"
msgid "　いいから静希君は卵だけに集中して―――」"
msgstr "  Just focus on watching that egg!\""

#. Occurrence 5B_9:1492:7269: scene=5B_9
#: 5B_9:1492
msgctxt "text_id=7269 | speaker=unknown"
msgid "　卵の出現にあわせて、ここぞとばかりに立ちふさがるブレッドマン。"
msgstr "  At this critical juncture, bread-men stepped out to join the egg and block their path."

#. Occurrence 5B_9:1543:7270: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0011; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1543
msgctxt "text_id=7270 | speaker=aoko"
msgid "「邪魔―――！」"
msgstr "\"Out of the way!\""

#. Occurrence 5B_9:1671:7271: scene=5B_9
#: 5B_9:1671
msgctxt "text_id=7271 | speaker=unknown"
msgid "　かつてない大軍で押し寄せる焼きたてパンを、"
msgstr "  The bread-men were marching forth in a grand battalion."

msgctxt "text_id=7272 | speaker=unknown"
msgid "　青子はこれまで以上の火力でなぎ払うのだが―――"
msgstr "  At her level of firepower, Aoko should have easily mowed them down. However..."

#. Occurrence 5B_9:1831:7273: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0012; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:1831
msgctxt "text_id=7273 | speaker=aoko"
msgid "「っ、<堅|かた>焼きか、この―――！」"
msgstr "\"These have hard crusts? Take this!\""

#. Occurrence 5B_9:1961:7274: scene=5B_9
#: 5B_9:1961
msgctxt "text_id=7274 | speaker=unknown"
msgid "　<弾く|スナップ>が効かないというのなら、刻印を用いた魔弾を放つ。"
msgstr "  If Snap failed to do the job, that meant it was time for her to put her crest to use."

#. Occurrence 5B_9:1966:7275: scene=5B_9
#: 5B_9:1966
msgctxt "text_id=7275 | speaker=unknown"
msgid "　<術式|だんがん>を用いた<風圧甲弾|ドロウ>。"
msgstr "  Draw: a formula-triggered bullet encased in a full wind jacket."

#. Occurrence 5B_9:1971:7276: scene=5B_9
#: 5B_9:1971
msgctxt "text_id=7276 | speaker=unknown"
msgid "　先ほどまでのが機関銃の掃射なら、これは大砲の一撃だ。"
msgstr "  If her previous shots were the equivalent of a machine gun volley, then this was her artillery shot."

#. Occurrence 5B_9:2095:7277: scene=5B_9
#: 5B_9:2095
msgctxt "text_id=7277 | speaker=unknown"
msgid "　<魔力|スナップ>に耐えきった堅焼きパンたちは、<魔術|ドロウ>の<奔流|ほんりゅう>を受けて焼き千切れていった。"
msgstr "  The hard-crust bread that had absorbed her Snap without a dent scattered into thousands of tiny pieces at her Draw's torrent."

#. Occurrence 5B_9:2179:7278: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0005; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:2179
msgctxt "text_id=7278 | speaker=soujuurou"
msgid "「うわ……」"
msgstr "\"Whoa...\""

#. Occurrence 5B_9:2185:7279: scene=5B_9
#: 5B_9:2185
msgctxt "text_id=7279 | speaker=unknown"
msgid "　もちろん、破壊はブレッドマンだけに留まらない。"
msgstr "  Of course, the destruction did not end with just the bread-men."

#. Occurrence 5B_9:2191:7280: scene=5B_9
#: 5B_9:2191
msgctxt "text_id=7280 | speaker=unknown"
msgid "　レンガの道は舗装をふっ飛ばされ丸裸にされ、"
msgstr "  What had once been a brick road was now thoroughly stripped of its pavement."

#. Occurrence 5B_9:2196:7281: scene=5B_9
#: 5B_9:2196
msgctxt "text_id=7281 | speaker=unknown"
msgid "　近くにあった売店は鉄骨だけを残した<骸骨|スケルトン>と化していた。"
msgstr "  The nearby stalls had been warped into twisted steel skeletons."

#. Occurrence 5B_9:2284:7282: scene=5B_9
#: 5B_9:2284
msgctxt "text_id=7282 | speaker=unknown"
msgid "　ブレッドマンの壁より青子の破壊活動の方がいずれ行く手を阻むのでは、と草十郎でなくとも不安に思う惨状である。"
msgstr "  It was a spectacle that made Soujyuro question what the greater obstacle to their escape was―the wall of bread-men, or Aoko's ability to lay waste to things?"

#. Occurrence 5B_9:2350:7283: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0013; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2350
msgctxt "text_id=7283 | speaker=aoko"
msgid "「ちょっと。なんで距離とるのよ、そこ。<傍|そば>にいないと危ないじゃない。"
msgstr "\"Hey! Don't wander off! It's dangerous if you don't stick close to me!"

#. Occurrence 5B_9:2366:7284: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0014; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2366
msgctxt "text_id=7284 | speaker=aoko"
msgid "　ほら、もっとこっち！"
msgstr "  Come on, get closer!"

#. Occurrence 5B_9:2373:7285: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0015; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2373
msgctxt "text_id=7285 | speaker=aoko"
msgid "　言っとくけどアンタがアイツらに囲まれちゃったらアウトよ？　私、人質とか意味ないタイプだし。そもそも区別して撃つとか、そういうのできないし」"
msgstr "  We're out of strikes, you know? If they surround you, you're a goner! You should know, hostages don't mean squat to me, and it's not like I can pick out my targets precisely anyway!\""

#. Occurrence 5B_9:2415:7286: scene=5B_9
#: 5B_9:2415
msgctxt "text_id=7286 | speaker=unknown"
msgid "　なるほど、と頷く草十郎。"
msgstr "  This made a lot of sense to Soujyuro."

#. Occurrence 5B_9:2420:7287: scene=5B_9
#: 5B_9:2420
msgctxt "text_id=7287 | speaker=unknown"
msgid "　人質は意味をなさない、という言葉の意味は分からずとも、彼女の言わんとするところは分かる。"
msgstr "  He had not fully appreciated the part about hostages, but he got the gist of it."

#. Occurrence 5B_9:2464:7288: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0006; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:2464
msgctxt "text_id=7288 | speaker=soujuurou"
msgid "「つまり、今はどこであろうと危険なのか」"
msgstr "\"So basically, I'm in danger no matter where I stand.\""

#. Occurrence 5B_9:2480:7289: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0016; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2480
msgctxt "text_id=7289 | speaker=aoko"
msgid "「……アンタね」"
msgstr "\"You...\""

#. Occurrence 5B_9:2523:7290: scene=5B_9
#: 5B_9:2523
msgctxt "text_id=7290 | speaker=unknown"
msgid "　草十郎の相変わらずの天然っぷりにカチンときながらも、青子は少しだけ感心した。"
msgstr "  Offended though she was by his typical naive response, she could not help but be impressed."

#. Occurrence 5B_9:2528:7291: scene=5B_9
#: 5B_9:2528
msgctxt "text_id=7291 | speaker=unknown"
msgid "　草十郎はいたって真面目だ。"
msgstr "  Soujyuro was a straight arrow through and through."

#. Occurrence 5B_9:2533:7292: scene=5B_9
#: 5B_9:2533
msgctxt "text_id=7292 | speaker=unknown"
msgid "　彼の視線は、今の乱戦の中でもしっかり頭上の卵に向けられている。"
msgstr "  His eyes stayed firmly focused on the egg overhead, even amidst the chaos of the melee unfolding before him."

#. Occurrence 5B_9:2559:7293: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0017; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2559
msgctxt "text_id=7293 | speaker=aoko"
msgid "「その分なら安心か。"
msgstr "\"I don't know why I worried."

#. Occurrence 5B_9:2565:7294: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0018; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2565
msgctxt "text_id=7294 | speaker=aoko"
msgid "　物分かりは悪いけど、一度言われた事はきっちり守るあたり、貴方のいいところよね」"
msgstr "  You may not be the sharpest tool, but you sure are good at following orders.\""

#. Occurrence 5B_9:2598:7295: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0007; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:2598
msgctxt "text_id=7295 | speaker=soujuurou"
msgid "「そんなことより蒼崎。俺の気のせいならいいんだけど、さっきのパン、堅くなかったか？」"
msgstr "\"One thing, Aozaki. Am I imagining it, or do those bread men seem tougher than before?\""

#. Occurrence 5B_9:2645:7296: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0019; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2645
msgctxt "text_id=7296 | speaker=aoko"
msgid "「……まあね。アイツら、少しずつ強くなってきてるわ。"
msgstr "\"...No, you weren't imagining that. They're getting stronger."

#. Occurrence 5B_9:2651:7297: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0020; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2651
msgctxt "text_id=7297 | speaker=aoko"
msgid "　大量生産が軌道に乗ったんで、今度はクオリティアップをテーマにしたのかも」"
msgstr "  They must have nailed down their mass-production process, so they've turned their attention to upping the quality.\""

#. Occurrence 5B_9:2694:7298: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0021; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2694
msgctxt "text_id=7298 | speaker=aoko"
msgid "「静希君でもお察しの通り、ここからは手強くなっていく一方よ。あのパンたちでさえ個体差がでてきたみたいだし。"
msgstr "\"As you figured out already, they're just going to get tougher as we go. It seems like even those bread guys have started to develop individuality."

#. Occurrence 5B_9:2700:7299: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0022; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2700
msgctxt "text_id=7299 | speaker=aoko"
msgid "　考えたくないけど、そのうちジャム塗ったりレタス乗っけたり、はては合体したりして」"
msgstr "  I hate to think about it, but they might start spreading themselves with jelly, or wearing other fillings and merging with one another.\""

#. Occurrence 5B_9:2744:7300: scene=5B_9
#: 5B_9:2744
msgctxt "text_id=7300 | speaker=unknown"
msgid "　冗談を言いながらも青子の目は真剣だ。"
msgstr "  Though she was joking, her eyes were dead serious."

#. Occurrence 5B_9:2754:7301: scene=5B_9
#: 5B_9:2754
msgctxt "text_id=7301 | speaker=unknown"
msgid "　容赦なく悪化していく状況に、草十郎は今更ながら戦慄を覚えてしまう。"
msgstr "  Soujyuro shuddered at the thought of the situation growing even more dire."

#. Occurrence 5B_9:2780:7302: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_5B_9_0008; voice_prefix=A30; voice_category=3; scene=5B_9
#: 5B_9:2780
msgctxt "text_id=7302 | speaker=soujuurou"
msgid "「じゃあ、そのうちミラーハウスの人形ぐらいに恐くなるのか、あいつら？」"
msgstr "\"So you're saying that those guys are going to become as terrifying as the puppet from the house of mirrors soon?\""

#. Occurrence 5B_9:2808:7303: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0023; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2808
msgctxt "text_id=7303 | speaker=aoko"
msgid "「間違いなくね。そこまで<高価|レア>なパンになったら私も自分だけで手一杯になる。ところで静希君、ああいうのとケンカできる？」"
msgstr "\"Oh, you can count on it. And I'll have my hands full with bread that rare. Say, Sizuki. Think you can handle yourself against one of those?\""

#. Occurrence 5B_9:2818:7304: scene=5B_9
#: 5B_9:2818
msgctxt "text_id=7304 | speaker=unknown"
msgid "　ぶんぶん、と草十郎は心底イヤそうな顔で首を振る。"
msgstr "  Soujyuro shook his head, a look of complete aversion upon his face."

#. Occurrence 5B_9:2830:7305: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_5B_9_0024; voice_prefix=A10; voice_category=1; scene=5B_9
#: 5B_9:2830
msgctxt "text_id=7305 | speaker=aoko"
msgid "「でしょ？　なら急ぎましょ。色々余裕ないんだから」"
msgstr "\"I didn't think so. So let's get moving, we can't afford to hang around here.\""

#. Occurrence 5B_9:2881:7306: scene=5B_9
#: 5B_9:2881
msgctxt "text_id=7306 | speaker=unknown"
msgid "　青子は短く深呼吸をして、駆け足を再開する。"
msgstr "  Aoko took a quick, deep breath, then began to sprint once again."

#. Occurrence 5B_9:2886:7307: scene=5B_9
#: 5B_9:2886
msgctxt "text_id=7307 | speaker=unknown"
msgid "　視界<遥|はる>か、霧の向こうの鉄柵まであと三百メートルほど。"
msgstr "  Far in the distance, through the fog, the iron fence waited, three hundred paces away."

#. Occurrence 5B_9:2891:7308: scene=5B_9
#: 5B_9:2891
msgctxt "text_id=7308 | speaker=unknown"
msgid "　……このまま何事もなければ無事にたどり着けるかもしれない。"
msgstr "  As long as nothing happened, they would make it there in one piece."

#. Occurrence 5B_9:2901:7309: scene=5B_9
#: 5B_9:2901
msgctxt "text_id=7309 | speaker=unknown"
msgid "　そんな都合のいい希望を抱きながら、草十郎は青子の後に続いていった。"
msgstr "  Soujyuro followed after Aoko, holding onto that all too convenient hope."

#. Occurrence 6_1:49:7310: scene=6_1
#: 6_1:49
msgctxt "text_id=7310 | speaker=unknown"
msgid "　彼はまだ、深い眠りの中にいる―――"
msgstr "  He was still in a deep sleep..."

#. Occurrence 6_1:88:7311: scene=6_1
#: 6_1:88
msgctxt "text_id=7311 | speaker=unknown"
msgid "　それは一面の、燃えるような<茜|あかね>色だった。"
msgstr "  It all seemed ablaze in a mad, fiery red."

#. Occurrence 6_1:96:7312: scene=6_1
#: 6_1:96
msgctxt "text_id=7312 | speaker=unknown"
msgid "　<忍|しの>びない雑念。"
msgstr "  Unbearable idle thoughts..."

#. Occurrence 6_1:101:7313: scene=6_1
#: 6_1:101
msgctxt "text_id=7313 | speaker=unknown"
msgid "　絶え間のない<我執|がしゅう>。"
msgstr "  Incessant obstinacy..."

#. Occurrence 6_1:106:7314: scene=6_1
#: 6_1:106
msgctxt "text_id=7314 | speaker=unknown"
msgid "　見るも悲哀、語るも<陰鬱|いんうつ>な<悲喜交々|ひきこもごも>。"
msgstr "  Melancholy sights and gloomy, bittersweet talk..."

#. Occurrence 6_1:111:7315: scene=6_1
#: 6_1:111
msgctxt "text_id=7315 | speaker=unknown"
msgid "　人と人の<交|まじ>わりから生じる<有為|うい><悪作|あくさ>。"
msgstr "  Fickle wickedness born of human interaction..."

#. Occurrence 6_1:116:7316: scene=6_1
#: 6_1:116
msgctxt "text_id=7316 | speaker=unknown"
msgid "　即ち、救いようのない共存の<声|おと>。"
msgstr "  Namely, the voice of a forsaken coexistence."

#. Occurrence 6_1:122:7317: scene=6_1
#: 6_1:122
msgctxt "text_id=7317 | speaker=unknown"
msgid "　これはその一切から、あまりにも遠い世界の<風景|はなし>。"
msgstr "  This, however, was the scenery of a world far removed from that."

#. Occurrence 6_1:142:7318: scene=6_1
#: 6_1:142
msgctxt "text_id=7318 | speaker=unknown"
msgid "　天上<楽土|らくど>と手を合わせる者もいれば、"
msgstr "  If there were those praying this was Paradise,"

#. Occurrence 6_1:147:7319: scene=6_1
#: 6_1:147
msgctxt "text_id=7319 | speaker=unknown"
msgid "　死後の<幽世|かくりよ>と目を伏せる者もいるだろう。"
msgstr "  then there were likely also those lamenting it as the underworld."

#. Occurrence 6_1:152:7320: scene=6_1
#: 6_1:152
msgctxt "text_id=7320 | speaker=unknown"
msgid "　あと十年、"
msgstr "  In a decade,"

#. Occurrence 6_1:157:7321: scene=6_1
#: 6_1:157
msgctxt "text_id=7321 | speaker=unknown"
msgid "　あるいは何十年後かにはあり方を変えていく、いまだ人の靴を知らぬ<紅葉|こうよう>の海。"
msgstr "  or perhaps longer, this would all change. But for now, the autumn leaves remained yet untrampled by human soles."

#. Occurrence 6_1:163:7322: scene=6_1
#: 6_1:163
msgctxt "text_id=7322 | speaker=unknown"
msgid "　それが、彼にとって当たり前の風景だった。"
msgstr "  It was scenery he knew well."

#. Occurrence 6_1:205:7323: scene=6_1
#: 6_1:205
msgctxt "text_id=7323 | speaker=unknown"
msgid "　<山中|さんちゅう>において人間の<営|いとな>みは<慎|つつ>ましくささやかだ。"
msgstr "  Life in the mountains was humble and modest."

#. Occurrence 6_1:210:7324: scene=6_1
#: 6_1:210
msgctxt "text_id=7324 | speaker=unknown"
msgid "　彼の住まいである山にも、向かいのお山にも目立つほどの建物はない。"
msgstr "  There were no conspicuous buildings among this wilderness he called home."

#. Occurrence 6_1:215:7325: scene=6_1
#: 6_1:215
msgctxt "text_id=7325 | speaker=unknown"
msgid "　衣食住に関する事柄は必要な分だけ、多くを奪うことなく積み重ねられている。"
msgstr "  They gathered and stockpiled only what they needed to survive, without pillaging the land."

#. Occurrence 6_1:235:7326: scene=6_1
#: 6_1:235
msgctxt "text_id=7326 | speaker=unknown"
msgid "　見れば蛇のように身をくねらせる野道や、<頂|いただき>に続く石段なども造られているが、それも山中に踏み入らなければ気付かない程度だ。"
msgstr "  Serpentine trails could be seen woven through the fields, and the stone steps leading to the summit were obscured by the forest, only visible once upon them."

#. Occurrence 6_1:240:7327: scene=6_1
#: 6_1:240
msgctxt "text_id=7327 | speaker=unknown"
msgid "　この山で暮らす者たちの方針だろう。"
msgstr "  The mountain inhabitants probably intended it that way."

#. Occurrence 6_1:245:7328: scene=6_1
#: 6_1:245
msgctxt "text_id=7328 | speaker=unknown"
msgid "　人の手によるもので、山の景色を損なう物は一つもない。"
msgstr "  There was no sign of mankind's exploitation among the mountain landscape."

#. Occurrence 6_1:291:7329: scene=6_1
#: 6_1:291
msgctxt "text_id=7329 | speaker=unknown"
msgid "　ふと、この<季節|しきさい>が一番好きだった事を思い出す。"
msgstr "  He suddenly remembered that this was the season he liked the most."

#. Occurrence 6_1:296:7330: scene=6_1
#: 6_1:296
msgctxt "text_id=7330 | speaker=unknown"
msgid "　好きというより己の性に合っていた。"
msgstr "  Or rather, it suited him the most."

#. Occurrence 6_1:301:7331: scene=6_1
#: 6_1:301
msgctxt "text_id=7331 | speaker=unknown"
msgid "　冬に備えてやるべき事は山積みだったが、<暇|ひま>を見付けては<頂|いただき>近くにまで足を運んだ。"
msgstr "  There was much to be done to prepare for winter, but whenever he had a free moment, he would make his way toward the mountaintop."

#. Occurrence 6_1:306:7332: scene=6_1
#: 6_1:306
msgctxt "text_id=7332 | speaker=unknown"
msgid "　深く呼吸をして、ぼんやりと斜陽の<兆|きざ>しを眺めていた時が、たぶん、毎日で二番目ぐらいに幸せだった。"
msgstr "  Gazing idly at the setting sun while breathing deep the crisp autumn air was probably the second favorite of his daily joys."

#. Occurrence 6_1:374:7333: scene=6_1
#: 6_1:374
msgctxt "text_id=7333 | speaker=unknown"
msgid "　茜の山をいっそう赤く染める夕日。"
msgstr "  It relaxed him, the cold but comforting wind at dusk,"

#. Occurrence 6_1:379:7334: scene=6_1
#: 6_1:379
msgctxt "text_id=7334 | speaker=unknown"
msgid "　<黄昏|たそがれ>時に吹く風は冷たくも、安らげるものだった。"
msgstr "  and the way the sunset dyed the peaks a vibrant crimson."

#. Occurrence 6_1:384:7335: scene=6_1
#: 6_1:384
msgctxt "text_id=7335 | speaker=unknown"
msgid "　山を下りてからまだ二ヶ月も<経|た>っていないのに、記憶が<薄|うす>れている事が少し<淋|さみ>しい。"
msgstr "  Not two months had passed since coming down from the mountains, and already it pained him that the memories had begun to fade."

#. Occurrence 6_1:389:7336: scene=6_1
#: 6_1:389
msgctxt "text_id=7336 | speaker=unknown"
msgid "　日々の記憶は薄れていくから、それに負けないように思い出は重ねていくしかないのだと、誰かが口にしていたっけ。"
msgstr "  Someone once told him that memories fade every day, so the best you one do is make as many new ones as possible."

#. Occurrence 6_1:411:7337: scene=6_1
#: 6_1:411
msgctxt "text_id=7337 | speaker=unknown"
msgid "　思い出はかくも<霞|かす>んでいく。"
msgstr "  Recollections grew hazy."

#. Occurrence 6_1:416:7338: scene=6_1
#: 6_1:416
msgctxt "text_id=7338 | speaker=unknown"
msgid "　住む場所が変われば、新しい生活は始まっていく。"
msgstr "  A new place to live meant the beginning of a new life."

#. Occurrence 6_1:421:7339: scene=6_1
#: 6_1:421
msgctxt "text_id=7339 | speaker=unknown"
msgid "　その中で、長く親しんできた景色を引きずるのは<贅沢|ぜいたく>なのか、未練なのか。"
msgstr "  He wasn't sure if he was reluctant to let go of the scenery he'd cherished for so long, or if he'd merely been spoiled by it."

#. Occurrence 6_1:426:7340: scene=6_1
#: 6_1:426
msgctxt "text_id=7340 | speaker=unknown"
msgid "　<現在|いま>の住み家は高いビルディングに囲まれた都会なのに、この記憶だけは鮮明であってほしいと思うのが後ろめたい。"
msgstr "  Despite his new home in a city surrounded by tall buildings, he felt guilty for wanting those memories alone to remain clear in his mind."

#. Occurrence 6_1:446:7341: scene=6_1
#: 6_1:446
msgctxt "text_id=7341 | speaker=unknown"
msgid "　なにしろせっかくの新生活。"
msgstr "  Either way, he had to make the best of a fresh start."

#. Occurrence 6_1:451:7342: scene=6_1
#: 6_1:451
msgctxt "text_id=7342 | speaker=unknown"
msgid "　新居より故郷を思うのはちょっと、男としてどうか、と彼は生真面目に反省して、"
msgstr "  \"What kind of man thinks more about where he came from than where he's going?\" he contemplated."

#. Occurrence 6_1:476:7343: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_1_0000; voice_prefix=A30; voice_category=3; scene=6_1
#: 6_1:476
msgctxt "text_id=7343 | speaker=soujuurou"
msgid "「そうか。これ、夢だ」"
msgstr "\"Oh. This is a dream.\""

#. Occurrence 6_1:482:7344: scene=6_1
#: 6_1:482
msgctxt "text_id=7344 | speaker=unknown"
msgid "　そう、ガラにもなく<耽|ふけ>っていた感傷を止めてみた。"
msgstr "  He tried to stop himself from indulging in uncharacteristic sentimentality."

#. Occurrence 6_1:487:7345: scene=6_1
#: 6_1:487
msgctxt "text_id=7345 | speaker=unknown"
msgid "　我が事ながら、何の迷いもなく夢と<判|わか>ってしまうあたり夢がない、と思いながら。"
msgstr "  It wouldn't be a dream if it was easy to understand."

#. Occurrence 6_1:564:7346: scene=6_1
#: 6_1:564
msgctxt "text_id=7346 | speaker=unknown"
msgid "　夢と断じた途端、紅葉に鋭角な影がそびえ立っていく。"
msgstr "  The moment he realized he was dreaming, angular shadows began to rise from the autumn colors."

#. Occurrence 6_1:569:7347: scene=6_1
#: 6_1:569
msgctxt "text_id=7347 | speaker=unknown"
msgid "　それはかつて知らず、今は<既|き><知|ち>となったコンクリートの建物たちだ。"
msgstr "  They were concrete buildings, previously unknown and yet familiar to him at the same time."

#. Occurrence 6_1:574:7348: scene=6_1
#: 6_1:574
msgctxt "text_id=7348 | speaker=unknown"
msgid "　思い出はこうやって、今の暮らしに<融|と>かされていく。"
msgstr "  This was how his current life was washing away his memories."

#. Occurrence 6_1:579:7349: scene=6_1
#: 6_1:579
msgctxt "text_id=7349 | speaker=unknown"
msgid "　もとより人間の記憶、人間の印象は、どうあがこうと劣化していく。"
msgstr "  Struggle as he might, there was no stopping the degradation of human memory or impressions."

#. Occurrence 6_1:599:7350: scene=6_1
#: 6_1:599
msgctxt "text_id=7350 | speaker=unknown"
msgid "　それは仕方のない事だ。"
msgstr "  It was merely a fact of life."

#. Occurrence 6_1:604:7351: scene=6_1
#: 6_1:604
msgctxt "text_id=7351 | speaker=unknown"
msgid "　何であれ、人間は過去より今に期待するものだし。"
msgstr "  By nature, humans lived in the present over the past."

#. Occurrence 6_1:609:7352: scene=6_1
#: 6_1:609
msgctxt "text_id=7352 | speaker=unknown"
msgid "　いずれ過去の思い出でさえ、ビルディングに飲みこまれていくだろう。"
msgstr "  Eventually, even his most cherished memories would be swallowed up the buildings."

#. Occurrence 6_1:614:7353: scene=6_1
#: 6_1:614
msgctxt "text_id=7353 | speaker=unknown"
msgid "　無情も薄情もない。"
msgstr "  It was neither cruel nor heartless."

#. Occurrence 6_1:619:7354: scene=6_1
#: 6_1:619
msgctxt "text_id=7354 | speaker=unknown"
msgid "　かならず消えると予感しているのなら、今はただ、鮮明に思いだせる記憶を夢見ていればいい。"
msgstr "  If they were sure to disappear, then for now he would content himself with dreaming about the memories he could clearly recall."

#. Occurrence 6_1:639:7355: scene=6_1
#: 6_1:639
msgctxt "text_id=7355 | speaker=unknown"
msgid "　山であろうと町であろうと、日々はもとより一瞬だ。"
msgstr "  Whether in the mountains or the city, the days flew by."

#. Occurrence 6_1:644:7356: scene=6_1
#: 6_1:644
msgctxt "text_id=7356 | speaker=unknown"
msgid "　たとえ一日後の今日でも、昨日と同じ風景はどこにもないのだから。"
msgstr "  Yesterday's scenery was not the same as today's."

#. Occurrence 6_1:653:7357: scene=6_1
#: 6_1:653
msgctxt "text_id=7357 | speaker=unknown"
msgid "　…………などと。"
msgstr "  ...And such."

#. Occurrence 6_1:658:7358: scene=6_1
#: 6_1:658
msgctxt "text_id=7358 | speaker=unknown"
msgid "　しんみりする暇を、彼女はまったく与えてくれなかった。"
msgstr "  She had given him no time to grieve."

#. Occurrence 6_1:663:7359: scene=6_1
#: 6_1:663
msgctxt "text_id=7359 | speaker=unknown"
msgid "　<懐|なつ>かしく遠い記憶は、美しいが故に<儚|はかな>いらしい。"
msgstr "  Distant nostalgia was beautiful, but that made it fleeting."

#. Occurrence 6_1:684:7360: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_1_0001; voice_prefix=A30; voice_category=3; scene=6_1
#: 6_1:684
msgctxt "text_id=7360 | speaker=soujuurou"
msgid "「……<見|み><上|あ>げ<入道|にゅうどう>じゃないんだぞ、蒼崎」"
msgstr "\"You're no 'miage nyudo,' Aozaki. I can't talk my way past you.\""

#. Occurrence 6_1:713:7361: scene=6_1
#: 6_1:713
msgctxt "text_id=7361 | speaker=unknown"
msgid "　軽い目眩から目を閉じる。"
msgstr "  A faint dizziness made him close his eyes."

#. Occurrence 6_1:718:7362: scene=6_1
#: 6_1:718
msgctxt "text_id=7362 | speaker=unknown"
msgid "　<視界|いしき>を切ったことで山の風景は見えなくなり、かわりに聞き覚えのある声が響いてきた。"
msgstr "  Without sight, the mountainous landscape vanished, but in its place a familiar voice could be heard."

#. Occurrence 6_1:723:7363: scene=6_1
#: 6_1:723
msgctxt "text_id=7363 | speaker=unknown"
msgid "　彼のいる山の中腹はおろか、山全体を震わすような大声だ。"
msgstr "  It was a booming voice that seemed to shake not only the mountainside he stood upon, but the entire mountain as well."

#. Occurrence 6_1:766:7364: scene=6_1
#: 6_1:766
msgctxt "text_id=7364 | speaker=unknown"
msgid "　それも当然で、さっき幻のように現れた蒼崎青子は山の向こうにでーんとそびえていたのだ。"
msgstr "  And of course, Aoko Aozaki reappeared, towering in the distance."

#. Occurrence 6_1:771:7365: scene=6_1
#: 6_1:771
msgctxt "text_id=7365 | speaker=unknown"
msgid "　本当に疲れてるんだな、と彼は自分の状態を確認しつつ、彼女の声に気を<配|くば>った。"
msgstr "  He must have been tired, he thought, diagnosing himself while trying to make out what she was saying."

#. Occurrence 6_1:776:7366: scene=6_1
#: 6_1:776
msgctxt "text_id=7366 | speaker=unknown"
msgid "　目を開けているとまた目眩がしそうなので、目は閉じたままである。"
msgstr "  Fearing the vertigo would return if he reopened his eyes, he decided to keep them closed."

#. Occurrence 6_1:812:7367: scene=6_1
#: 6_1:812
msgctxt "text_id=7367 | speaker=unknown"
msgid "　……おおよその雰囲気しか分からないが、彼女は誰かと口論しているようだった。"
msgstr "  ...It sounded like she was arguing with someone, though the tone was all he could make out."

#. Occurrence 6_1:817:7368: scene=6_1
#: 6_1:817
msgctxt "text_id=7368 | speaker=unknown"
msgid "　激しくはないが攻撃的な口調。"
msgstr "  It wasn't violent, but certainly aggressive."

#. Occurrence 6_1:822:7369: scene=6_1
#: 6_1:822
msgctxt "text_id=7369 | speaker=unknown"
msgid "　たぶん向かいの山にでも喧嘩を売っているのだろう。"
msgstr "  Maybe she was picking a fight with another mountain across the way."

#. Occurrence 6_1:827:7370: scene=6_1
#: 6_1:827
msgctxt "text_id=7370 | speaker=unknown"
msgid "　彼女なら十分にありえる、と彼はひとり頷いた。"
msgstr "  He wouldn't put it past her."

#. Occurrence 6_1:832:7371: scene=6_1
#: 6_1:832
msgctxt "text_id=7371 | speaker=unknown"
msgid "　なにしろ月まで吹っ飛ばした暴れん坊だ。"
msgstr "  After all, she was a troublemaker who blew up the moon."

#. Occurrence 6_1:901:7372: scene=6_1
#: 6_1:901
msgctxt "text_id=7372 | speaker=unknown"
msgid "　会話の内容はよく掴めない。"
msgstr "  He couldn't quite grasp the conversation."

#. Occurrence 6_1:906:7373: scene=6_1
#: 6_1:906
msgctxt "text_id=7373 | speaker=unknown"
msgid "　彼はなんとなく、漠然と、自分の人権あたりが盛大に無視されている気がした。……いかに夢中の出来事とはいえ、<甚|はなは>だよろしくない。"
msgstr "  Though somehow, vaguely, he had the sense that his human rights were being largely ignored. ...It was deeply unsettling, even for a dream."

#. Occurrence 6_1:911:7374: scene=6_1
#: 6_1:911
msgctxt "text_id=7374 | speaker=unknown"
msgid "　数分の後。"
msgstr "  After several minutes..."

#. Occurrence 6_1:916:7375: scene=6_1
#: 6_1:916
msgctxt "text_id=7375 | speaker=unknown"
msgid "　大迫力の口論は、青子側の勝利で終わったらしい。"
msgstr "  It seemed that the high-impact argument ended in Aoko's victory."

#. Occurrence 6_1:939:7376: scene=6_1
#: 6_1:939
msgctxt "text_id=7376 | speaker=unknown"
msgid "　そうして、強風のようだった声も聞こえなくなった。"
msgstr "  Then suddenly, the boisterous voice faded."

#. Occurrence 6_1:944:7377: scene=6_1
#: 6_1:944
msgctxt "text_id=7377 | speaker=unknown"
msgid "　次はマトモな光景でありますように、と他力本願<気|ぎ><味|み>に目を開ける。"
msgstr "  Praying everything would be back to normal, he opened his eyes."

#. Occurrence 6_1:1027:7378: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_1_0002; voice_prefix=A30; voice_category=3; scene=6_1
#: 6_1:1027
msgctxt "text_id=7378 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 6_1:1033:7379: scene=6_1
#: 6_1:1033
msgctxt "text_id=7379 | speaker=unknown"
msgid "　わずかに息をのむ。"
msgstr "  He took a deep, slow breath."

#. Occurrence 6_1:1038:7380: scene=6_1
#: 6_1:1038
msgctxt "text_id=7380 | speaker=unknown"
msgid "　先ほどまでの懐かしい記憶とは何もかも違う、けれど、そう嫌いでもない風景。"
msgstr "  The scenery was a far cry from the nostalgic dreamscape he had just left, albeit not unpleasant either."

#. Occurrence 6_1:1043:7381: scene=6_1
#: 6_1:1043
msgctxt "text_id=7381 | speaker=unknown"
msgid "　確かめるまでもなく、そこはあの遊園地だった。"
msgstr "  Without a doubt, it was the amusement park."

#. Occurrence 6_1:1063:7382: scene=6_1
#: 6_1:1063
msgctxt "text_id=7382 | speaker=unknown"
msgid "　彼にとって最も鮮明な<過去|いぜん>の記憶。"
msgstr "  To him, his was his freshest memory."

#. Occurrence 6_1:1068:7383: scene=6_1
#: 6_1:1068
msgctxt "text_id=7383 | speaker=unknown"
msgid "　蒼崎青子が爆破したミラーハウスが懐かしい。"
msgstr "  He recalled the house of mirrors that Aoko Aozaki destroyed."

#. Occurrence 6_1:1073:7384: scene=6_1
#: 6_1:1073
msgctxt "text_id=7384 | speaker=unknown"
msgid "　現実と寸分の狂いもない遊園地だが、今いるのは彼だけだ。"
msgstr "  This park was a flawless replica of reality, but he was the only one there."

#. Occurrence 6_1:1078:7385: scene=6_1
#: 6_1:1078
msgctxt "text_id=7385 | speaker=unknown"
msgid "　誰に追いかけられる心配もないので、キッツィーちゃんの残骸に腰を下ろして、撃ち抜かれた筈の月を見上げた。"
msgstr "  Without having to worry about anyone chasing him, he sat down on the wreckage of Kitsy's rides and looked up at the moon that should have been shot down."

#. Occurrence 6_1:1138:7386: scene=6_1
#: 6_1:1138
msgctxt "text_id=7386 | speaker=unknown"
msgid "　白い、<玻璃|はり>を思わせる冬の月。"
msgstr "  The winter moon shone white like a jewel."

#. Occurrence 6_1:1143:7387: scene=6_1
#: 6_1:1143
msgctxt "text_id=7387 | speaker=unknown"
msgid "　その月を背に、彼を殺そうとした少女の姿が重なった。"
msgstr "  It was layered over the figure of the girl who'd tried to kill him."

#. Occurrence 6_1:1148:7388: scene=6_1
#: 6_1:1148
msgctxt "text_id=7388 | speaker=unknown"
msgid "　……魔術師が魔女だと言うのなら、あの瞬間の彼女は確かにそうだったのだろう。"
msgstr "  ...If a mage was a witch, then she definitely fit the bill."

#. Occurrence 6_1:1153:7389: scene=6_1
#: 6_1:1153
msgctxt "text_id=7389 | speaker=unknown"
msgid "“殺されてもいい”"
msgstr "\"I don't mind being killed.\""

#. Occurrence 6_1:1158:7390: scene=6_1
#: 6_1:1158
msgctxt "text_id=7390 | speaker=unknown"
msgid "　そんな、あまりにも馬鹿げた言葉が、ごく自然にこぼれたぐらいには。"
msgstr "  Such an absurd thing to say, but it spilled out of him so naturally."

#. Occurrence 6_1:1179:7391: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_1_0004; voice_prefix=A30; voice_category=3; scene=6_1
#: 6_1:1179
msgctxt "text_id=7391 | speaker=soujuurou"
msgid "「……いや、でも―――」"
msgstr "\"...Well, maybe...\""

#. Occurrence 6_1:1185:7392: scene=6_1
#: 6_1:1185
msgctxt "text_id=7392 | speaker=unknown"
msgid "　あれは魔女やら魔術やらとは関係ない。"
msgstr "  That had nothing to do with witches or magecraft."

#. Occurrence 6_1:1190:7393: scene=6_1
#: 6_1:1190
msgctxt "text_id=7393 | speaker=unknown"
msgid "　<胸|こころ>の隙をついた響き。"
msgstr "  There was an echo in the gaps of his heart."

#. Occurrence 6_1:1195:7394: scene=6_1
#: 6_1:1195
msgctxt "text_id=7394 | speaker=unknown"
msgid "　彼女があんな言葉さえ口にしなければ、彼もあんな言葉を返さなかった。"
msgstr "  If she had not spoken those words, then he would not have responded as he did."

#. Occurrence 6_1:1218:7395: scene=6_1
#: 6_1:1218
msgctxt "text_id=7395 | speaker=unknown"
msgid "　……あのとき、蒼崎青子はどんな言葉を投げたのか。"
msgstr "  In that moment, what had Aoko Aozaki said to him?"

#. Occurrence 6_1:1223:7396: scene=6_1
#: 6_1:1223
msgctxt "text_id=7396 | speaker=unknown"
msgid "　それを思い出そうとしているうちに、深かった彼の眠りは終わりを告げた。"
msgstr "  As he tried to remember, his deep slumber drew to an end."

#. Occurrence 6_1:1229:7397: scene=6_1
#: 6_1:1229
msgctxt "text_id=7397 | speaker=unknown"
msgid "　もしかすると、夢見より長かった回想の答えもないままに。"
msgstr "  And with it, his chance to find the answers he so wished he could find."

#. Occurrence 6_2:61:7398: scene=6_2
#: 6_2:61
msgctxt "text_id=7398 | speaker=unknown"
msgid "　……そうして。"
msgstr "  Then..."

#. Occurrence 6_2:66:7399: scene=6_2
#: 6_2:66
msgctxt "text_id=7399 | speaker=unknown"
msgid "　見知らぬ部屋のベッドで目を覚ました瞬間、草十郎は大きく息を呑んだ。"
msgstr "  Soujyuro woke up in an unfamiliar room, gasping."

#. Occurrence 6_2:71:7400: scene=6_2
#: 6_2:71
msgctxt "text_id=7400 | speaker=unknown"
msgid "　アパートの安布団とは段違いのベッドの感触や、"
msgstr "  Not because the plush mattress he was on was softer than his apartment's cheap futon,"

#. Occurrence 6_2:76:7401: scene=6_2
#: 6_2:76
msgctxt "text_id=7401 | speaker=unknown"
msgid "　絨毯はおろか壁紙まで高価そうな部屋の雰囲気に……ではなく。"
msgstr "  or because everything from the carpet to the wallpaper looked expensive..."

#. Occurrence 6_2:105:7402: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0000; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:105
msgctxt "text_id=7402 | speaker=soujuurou"
msgid "「―――、―――」"
msgstr "\"...\""

#. Occurrence 6_2:111:7403: scene=6_2
#: 6_2:111
msgctxt "text_id=7403 | speaker=unknown"
msgid "　眼を白黒させたまま、こぼれかけた息を呑みこむ。"
msgstr "  Bewildered, he tried to catch his breath."

#. Occurrence 6_2:116:7404: scene=6_2
#: 6_2:116
msgctxt "text_id=7404 | speaker=unknown"
msgid "　驚きの<原因|モト>はそれだ。"
msgstr "  She was the cause of his surprise."

#. Occurrence 6_2:121:7405: scene=6_2
#: 6_2:121
msgctxt "text_id=7405 | speaker=unknown"
msgid "　草十郎がぱちりと目を覚ました<傍|かたわ>らに、あの、黒衣の少女が座っていた。"
msgstr "  The moment Soujyuro's eyes snapped open, there she was, the girl dressed in black, sitting at his bedside."

#. Occurrence 6_2:157:7406: scene=6_2
#: 6_2:157
msgctxt "text_id=7406 | speaker=unknown"
msgid "　物音ひとつない静寂だった。"
msgstr "  The silence was deafening."

#. Occurrence 6_2:162:7407: scene=6_2
#: 6_2:162
msgctxt "text_id=7407 | speaker=unknown"
msgid "　草十郎はベッドに横になったまま少女を見つめる。"
msgstr "  Still supine on the bed, Soujyuro gazed at her."

#. Occurrence 6_2:167:7408: scene=6_2
#: 6_2:167
msgctxt "text_id=7408 | speaker=unknown"
msgid "　なんとなく<上半身|からだ>を起こしたい衝動にかられもしたが、真っ正面からまじまじと見るのは無遠慮かもしれない、と思いとどまった。"
msgstr "  His impulse was to sit up, but he refrained, thinking it might be rude to be it staring at the person sitting next to him."

#. Occurrence 6_2:223:7409: scene=6_2
#: 6_2:223
msgctxt "text_id=7409 | speaker=unknown"
msgid "　少女は椅子に座っているようだ。"
msgstr "  She was just sitting there, on a chair,"

#. Occurrence 6_2:228:7410: scene=6_2
#: 6_2:228
msgctxt "text_id=7410 | speaker=unknown"
msgid "　黒い、飾り気のない服装。"
msgstr "  dressed in black, modest clothes."

#. Occurrence 6_2:233:7411: scene=6_2
#: 6_2:233
msgctxt "text_id=7411 | speaker=unknown"
msgid "　そのくせ質素な印象はなく、単色なのに言いようのない気品を感じる。"
msgstr "  Still, she projected an air that was anything but plain; her monochrome outfit evoked indescribable elegance."

#. Occurrence 6_2:238:7412: scene=6_2
#: 6_2:238
msgctxt "text_id=7412 | speaker=unknown"
msgid "　高級な繊維で作られた、この少女の為の装飾―――"
msgstr "  Like a costume handmade just for her, from the finest fabrics."

#. Occurrence 6_2:243:7413: scene=6_2
#: 6_2:243
msgctxt "text_id=7413 | speaker=unknown"
msgid "　そんな詩的な感想を、草十郎をして抱かせるほどの。"
msgstr "  It was enough to inspire poetic sentiments even in Soujyuro."

#. Occurrence 6_2:281:7414: scene=6_2
#: 6_2:281
msgctxt "text_id=7414 | speaker=unknown"
msgid "　少女は座ったままぴくりとも動かない。"
msgstr "  The girl continued to sit, completely motionless."

#. Occurrence 6_2:287:7415: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0001; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:287
msgctxt "text_id=7415 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 6_2:292:7416: scene=6_2
#: 6_2:292
msgctxt "text_id=7416 | speaker=unknown"
msgid "　草十郎の呼吸は知らず止まっていた。"
msgstr "  Without realizing it, Soujyuro had stopped breathing."

#. Occurrence 6_2:297:7417: scene=6_2
#: 6_2:297
msgctxt "text_id=7417 | speaker=unknown"
msgid "　呼吸を忘れて少女に見入ったのは、純粋な驚きからだ。"
msgstr "  Genuine astonishment had him captivated."

#. Occurrence 6_2:302:7418: scene=6_2
#: 6_2:302
msgctxt "text_id=7418 | speaker=unknown"
msgid "　ただ美しい。"
msgstr "  Such beauty..."

#. Occurrence 6_2:307:7419: scene=6_2
#: 6_2:307
msgctxt "text_id=7419 | speaker=unknown"
msgid "　その、あまりにも単純で、あんまりにも理由のない表現を同じ<人間|いきもの>に用いたのは、初めてのことだった。"
msgstr "  It was the first time he had ever thought to use such a simple, plain expression to describe another human being."

#. Occurrence 6_2:357:7420: scene=6_2
#: 6_2:357
msgctxt "text_id=7420 | speaker=unknown"
msgid "　純潔のまま成長した<水仙|すいせん>の花。"
msgstr "  She was the daffodil, in perfect bloom."

#. Occurrence 6_2:363:7421: scene=6_2
#: 6_2:363
msgctxt "text_id=7421 | speaker=unknown"
msgid "　あるいは、夢に描かれた理想の少女像。"
msgstr "  Or the ideal female form, seen only in dreams."

#. Occurrence 6_2:409:7422: scene=6_2
#: 6_2:409
msgctxt "text_id=7422 | speaker=unknown"
msgid "　少女のソレは、鑑賞され、愛でられる為の美しさだ。"
msgstr "  This quality was something to be cherished and admired in her."

#. Occurrence 6_2:414:7423: scene=6_2
#: 6_2:414
msgctxt "text_id=7423 | speaker=unknown"
msgid "　蒼崎青子の華やかな、生命に満ちた輝きとは違う。"
msgstr "  It was different from Aoko Aozaki's blindingly radiant vitality."

#. Occurrence 6_2:419:7424: scene=6_2
#: 6_2:419
msgctxt "text_id=7424 | speaker=unknown"
msgid "　なぜなら、生命あるかぎり人は老いて尽きる。"
msgstr "  After all, the flame that burns twice as bright burns half as long,"

#. Occurrence 6_2:424:7425: scene=6_2
#: 6_2:424
msgctxt "text_id=7425 | speaker=unknown"
msgid "　そのような結末―――幸福な完結は、この少女には許される筈がない。"
msgstr "  and there was no way this girl would be allowed such a happy ending."

#. Occurrence 6_2:444:7426: scene=6_2
#: 6_2:444
msgctxt "text_id=7426 | speaker=unknown"
msgid "　それはこの<奇跡|カタチ>のまま生まれ、このカタチのまま滅び去るひとつの<寓話|ぐうわ>。"
msgstr "  Her life was a solitary fable of someone who left the world in exactly the same way they entered it."

#. Occurrence 6_2:449:7427: scene=6_2
#: 6_2:449
msgctxt "text_id=7427 | speaker=unknown"
msgid "　生まれながらに人間としての生を奪われた、この世ならざる命のあり方。"
msgstr "  With her humanity stolen at birth, hers was an existence not of this world."

#. Occurrence 6_2:455:7428: scene=6_2
#: 6_2:455
msgctxt "text_id=7428 | speaker=unknown"
msgid "　……<過|か><度|ど>に美しいものほど、結末は<無惨|むざん>なものになる。"
msgstr "  ...The more beautiful something was, the more tragic its fate."

#. Occurrence 6_2:460:7429: scene=6_2
#: 6_2:460
msgctxt "text_id=7429 | speaker=unknown"
msgid "　山奥育ちの草十郎にとって、それは教えられるまでもなく経験している事だった。"
msgstr "  Growing up in the mountains, this was not something Soujyuro was taught, but something he learned from experience."

#. Occurrence 6_2:514:7430: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0002; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:514
msgctxt "text_id=7430 | speaker=soujuurou"
msgid "『……眠ってるみたいだ』"
msgstr "(...It looks like she's sleeping.)"

#. Occurrence 6_2:523:7431: scene=6_2
#: 6_2:523
msgctxt "text_id=7431 | speaker=unknown"
msgid "　草十郎は誘われるように、首を横に向ける。"
msgstr "  Soujyuro turned his head, as though he was being lured in."

#. Occurrence 6_2:528:7432: scene=6_2
#: 6_2:528
msgctxt "text_id=7432 | speaker=unknown"
msgid "　横顔を盗み見るのは無遠慮だと知りつつ、本能には逆らえなかった。"
msgstr "  He knew it was rude to stare, but he couldn't fight his instincts."

#. Occurrence 6_2:533:7433: scene=6_2
#: 6_2:533
msgctxt "text_id=7433 | speaker=unknown"
msgid "　そうして―――"
msgstr "  Then..."

#. Occurrence 6_2:599:7434: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0003; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:599
msgctxt "text_id=7434 | speaker=soujuurou"
msgid "「……え？」"
msgstr "\"...Huh?\""

#. Occurrence 6_2:605:7435: scene=6_2
#: 6_2:605
msgctxt "text_id=7435 | speaker=unknown"
msgid "　今度こそ本当に、一瞬、心臓が止まった。"
msgstr "  This time, his heart actually skipped a beat."

#. Occurrence 6_2:610:7436: scene=6_2
#: 6_2:610
msgctxt "text_id=7436 | speaker=unknown"
msgid "　少女は眠ってなどいなかった。"
msgstr "  She was not asleep at all."

#. Occurrence 6_2:615:7437: scene=6_2
#: 6_2:615
msgctxt "text_id=7437 | speaker=unknown"
msgid "　無表情に、横たわる怪我人を見つめていただけだったのだ。"
msgstr "  Expressionless, she was merely watching over him while he recovered."

#. Occurrence 6_2:673:7438: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0004; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:673
msgctxt "text_id=7438 | speaker=soujuurou"
msgid "「…………」"
msgstr "\"...\""

#. Occurrence 6_2:678:7439: scene=6_2
#: 6_2:678
msgctxt "text_id=7439 | speaker=unknown"
msgid "　草十郎はベッドに横になったまま、動かした首を戻す事もできず、かといって気のきいた台詞も浮かばず、少女と無言で見つめあう。"
msgstr "  Soujyuro froze, unable to turn his head away or think of something clever to say. It was like staring into her eyes turned him to stone."

#. Occurrence 6_2:698:7440: scene=6_2
#: 6_2:698
msgctxt "text_id=7440 | speaker=unknown"
msgid "　……<華奢|きゃしゃ>な輪郭からか、自分よりいくぶん幼く見える。"
msgstr "  Perhaps because of her delicate features, she looked somewhat younger than him."

#. Occurrence 6_2:703:7441: scene=6_2
#: 6_2:703
msgctxt "text_id=7441 | speaker=unknown"
msgid "　反面、落ち着いた表情が年上のようにも感じさせた。"
msgstr "  On the other hand, her tranquil expression made him feel like she was older."

#. Occurrence 6_2:708:7442: scene=6_2
#: 6_2:708
msgctxt "text_id=7442 | speaker=unknown"
msgid "　肩口までの髪はにごりのない黒。"
msgstr "  Jet-black hair, just to her shoulders."

#. Occurrence 6_2:713:7443: scene=6_2
#: 6_2:713
msgctxt "text_id=7443 | speaker=unknown"
msgid "　そんな髪に合わせたように、大きめの瞳も混ざり気のない黒一色。"
msgstr "  Her large eyes were set like onyx stones, matching her hair."

#. Occurrence 6_2:752:7444: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0005; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:752
msgctxt "text_id=7444 | speaker=soujuurou"
msgid "「……………………」"
msgstr "\"......\""

#. Occurrence 6_2:758:7445: scene=6_2
#: 6_2:758
msgctxt "text_id=7445 | speaker=unknown"
msgid "　少女は感情のない瞳を草十郎に向けている。"
msgstr "  Devoid of emotion, her gaze stayed fixed on Soujyuro."

#. Occurrence 6_2:763:7446: scene=6_2
#: 6_2:763
msgctxt "text_id=7446 | speaker=unknown"
msgid "　草十郎と見つめ合うカタチになっても目は逸らさない。"
msgstr "  Even after their eyes met, she did not turn away."

#. Occurrence 6_2:796:7447: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0006; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:796
msgctxt "text_id=7447 | speaker=soujuurou"
msgid "「…………………………」"
msgstr "\".........\""

#. Occurrence 6_2:802:7448: scene=6_2
#: 6_2:802
msgctxt "text_id=7448 | speaker=unknown"
msgid "　草十郎は声をかけようにもかけられない。"
msgstr "  He wanted to speak, but could not find the words."

#. Occurrence 6_2:807:7449: scene=6_2
#: 6_2:807
msgctxt "text_id=7449 | speaker=unknown"
msgid "　蛇に睨まれた蛙、という程でもないけれど、いま少女に話しかけるのは<躊躇|ためら>われた。"
msgstr "  It was not unlike a frog being stared down by a snake. Nevertheless he just could not bring himself to say something."

#. Occurrence 6_2:812:7450: scene=6_2
#: 6_2:812
msgctxt "text_id=7450 | speaker=unknown"
msgid "　それに、"
msgstr "  Additionally..."

#. Occurrence 6_2:906:7451: scene=6_2
#: 6_2:906
msgctxt "text_id=7451 | speaker=unknown"
msgid "　いかに<暢気|のんき>な草十郎でも、この少女が青子と同じ種類の<爆|にん><弾|げん>である事は身に染みて知っていた。"
msgstr "  No matter how carefree Soujyuro might have been, he was painfully aware that this girl was as powerful as Aoko."

#. Occurrence 6_2:912:7452: scene=6_2
#: 6_2:912
msgctxt "text_id=7452 | speaker=unknown"
msgid "　一方、少女は少女で<堅|かた>く口を閉ざしている。"
msgstr "  Less talkative, to be sure, but still powerful."

#. Occurrence 6_2:917:7453: scene=6_2
#: 6_2:917
msgctxt "text_id=7453 | speaker=unknown"
msgid "　一心に、雑念なく、横になった異邦人を看病する……ような雰囲気。"
msgstr "  Objectively, the scene was not unlike that of someone nursing a bedridden stranger."

#. Occurrence 6_2:952:7454: scene=6_2
#: 6_2:952
msgctxt "text_id=7454 | speaker=unknown"
msgid "　少女が何を考えているかは不明だが、草十郎にとっては辛い沈黙が続いていく。"
msgstr "  He had no idea what she may have been thinking about, but it seemed to him this harsh silence might last forever."

#. Occurrence 6_2:957:7455: scene=6_2
#: 6_2:957
msgctxt "text_id=7455 | speaker=unknown"
msgid "　草十郎に分かるのは、少女はこの沈黙をまったく気にしていない、という事だけ。"
msgstr "  All he could say for sure was that the quiet did not appear to bother her in the slightest."

#. Occurrence 6_2:962:7456: scene=6_2
#: 6_2:962
msgctxt "text_id=7456 | speaker=unknown"
msgid "　これでは何らかの罰ゲーム、<罰則|ペナルティ>と言えなくもない。"
msgstr "  It was like some bizarre form of punishment."

#. Occurrence 6_2:988:7457: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0007; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:988
msgctxt "text_id=7457 | speaker=soujuurou"
msgid "『……。これが蒼崎の仕込みなら手がこみすぎる……』"
msgstr "(...If this is some kind of test from Aozaki, it sure is elaborate.)"

#. Occurrence 6_2:994:7458: scene=6_2
#: 6_2:994
msgctxt "text_id=7458 | speaker=unknown"
msgid "　などと思いつつも、草十郎は少女から目を離せなかった。"
msgstr "  He thought, keeping his eyes on the girl."

#. Occurrence 6_2:999:7459: scene=6_2
#: 6_2:999
msgctxt "text_id=7459 | speaker=unknown"
msgid "　自分が首を戻したり目を閉じた瞬間、少女が隠し持ったナイフで自分の胸を刺すのでは……"
msgstr "  He felt like the moment he turned his head or blinked, she might stab him in the chest with a hidden blade..."

#. Occurrence 6_2:1004:7460: scene=6_2
#: 6_2:1004
msgctxt "text_id=7460 | speaker=unknown"
msgid "　なんて想像をかきたてられたからではない。"
msgstr "  ...and not because his imagination was running away with him."

#. Occurrence 6_2:1031:7461: scene=6_2
#: 6_2:1031
msgctxt "text_id=7461 | speaker=unknown"
msgid "　たしかに重苦しい沈黙で、遊園地での事を思い返すと不安になるけれど―――"
msgstr "  In the stifling silence, it was only natural that Soujyuro would think back on what had happened in the amusement park, and it made him uneasy."

#. Occurrence 6_2:1036:7462: scene=6_2
#: 6_2:1036
msgctxt "text_id=7462 | speaker=unknown"
msgid "　それ以上に少女は魅力的だと、彼は思ったのだ。"
msgstr "  But stronger than any anxiety was his fascination with the girl."

#. Occurrence 6_2:1084:7463: scene=6_2
#: 6_2:1084
msgctxt "text_id=7463 | speaker=unknown"
msgid "　細い体と白い肌。"
msgstr "  Her slender frame and milky white skin..."

#. Occurrence 6_2:1089:7464: scene=6_2
#: 6_2:1089
msgctxt "text_id=7464 | speaker=unknown"
msgid "　人を寄せ付けない瞳の冷たさと、いまだ残った少女の面影の温かさ。"
msgstr "  The chill of her guarded stare, the warmth of her lingering femininity..."

#. Occurrence 6_2:1094:7465: scene=6_2
#: 6_2:1094
msgctxt "text_id=7465 | speaker=unknown"
msgid "　その二つが混ざりあった姿は、魔的なものと言ってもいい。"
msgstr "  It was the mixture of those two latter qualities that was almost magical."

#. Occurrence 6_2:1115:7466: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0008; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1115
msgctxt "text_id=7466 | speaker=soujuurou"
msgid "『…………？』"
msgstr "(...?)"

#. Occurrence 6_2:1120:7467: scene=6_2
#: 6_2:1120
msgctxt "text_id=7467 | speaker=unknown"
msgid "　そこまで少女と向き合って、草十郎は彼女とは以前会っているような気がした。"
msgstr "  He stared at her for so long, he began to get the feeling that they had met somewhere before."

#. Occurrence 6_2:1125:7468: scene=6_2
#: 6_2:1125
msgctxt "text_id=7468 | speaker=unknown"
msgid "　遊園地の一件よりもう少し前。"
msgstr "  Sometime before the conflict at Kitsy Land..."

#. Occurrence 6_2:1130:7469: scene=6_2
#: 6_2:1130
msgctxt "text_id=7469 | speaker=unknown"
msgid "　どこでだったかは思い出せないけれど、たしかに以前見かけた気がする。"
msgstr "  He could not quite put his finger on it, but he was sure he had seen her previously."

#. Occurrence 6_2:1166:7470: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0009; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1166
msgctxt "text_id=7470 | speaker=soujuurou"
msgid "「その、いまさらだけど」"
msgstr "\"Um, I don't know if this is the right time to ask this, but...\""

#. Occurrence 6_2:1172:7471: scene=6_2
#: 6_2:1172
msgctxt "text_id=7471 | speaker=unknown"
msgid "　凍りついた部屋に、白々しく響く自分の声。"
msgstr "  His voice shattered the frozen silence in the room."

#. Occurrence 6_2:1177:7472: scene=6_2
#: 6_2:1177
msgctxt "text_id=7472 | speaker=unknown"
msgid "　その場違いさに申し訳ない気持ちになりながら、草十郎は少女に語りかけた。"
msgstr "  He almost felt sorry for making noise as he spoke out to her."

#. Occurrence 6_2:1182:7473: scene=6_2
#: 6_2:1182
msgctxt "text_id=7473 | speaker=unknown"
msgid "　いつまでも見つめ合っている訳にもいかない。"
msgstr "  But they could not very well just sit and stare at each other forever."

#. Occurrence 6_2:1187:7474: scene=6_2
#: 6_2:1187
msgctxt "text_id=7474 | speaker=unknown"
msgid "　……見つめ合っていると思っていたのは自分だけで、少女は睨み合っていたつもりかも知れないし。"
msgstr "  ...Though, he might have been the only one thinking they were \"staring,\" and perhaps she thought they were \"glaring\" at each other."

#. Occurrence 6_2:1253:7475: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0010; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1253
msgctxt "text_id=7475 | speaker=soujuurou"
msgid "「ここはどこで、君は誰だか分かるかな」"
msgstr "\"Where am I, and who might you be?\""

#. Occurrence 6_2:1259:7476: scene=6_2
#: 6_2:1259
msgctxt "text_id=7476 | speaker=unknown"
msgid "　少女は黒い瞳をかすかに細める。"
msgstr "  She narrowed her eyes slightly,"

#. Occurrence 6_2:1264:7477: scene=6_2
#: 6_2:1264
msgctxt "text_id=7477 | speaker=unknown"
msgid "　気分を害した……風ではなさそうだ。"
msgstr "  though apparently, not out of offense."

#. Occurrence 6_2:1285:7478: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_2_0000; voice_prefix=A40; voice_category=2; scene=6_2
#: 6_2:1285
msgctxt "text_id=7478 | speaker=alice"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 6_2:1291:7479: scene=6_2
#: 6_2:1291
msgctxt "text_id=7479 | speaker=unknown"
msgid "　質問の返事はない。"
msgstr "  There was no response."

#. Occurrence 6_2:1296:7480: scene=6_2
#: 6_2:1296
msgctxt "text_id=7480 | speaker=unknown"
msgid "　やっぱり黙ってよう、と草十郎が思った矢先、少女は静かに片腕を上げた。"
msgstr "  Just as he was thinking it would have been better to keep quiet, she quietly raised her hand."

#. Occurrence 6_2:1366:7481: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_2_0001; voice_prefix=A40; voice_category=2; scene=6_2
#: 6_2:1366
msgctxt "text_id=7481 | speaker=alice"
msgid "「これ、あなたのでしょう」"
msgstr "\"This is yours, is it not?\""

#. Occurrence 6_2:1372:7482: scene=6_2
#: 6_2:1372
msgctxt "text_id=7482 | speaker=unknown"
msgid "　冷たいが、唄のような声。"
msgstr "  Her voice was cold, but melodic."

#. Occurrence 6_2:1377:7483: scene=6_2
#: 6_2:1377
msgctxt "text_id=7483 | speaker=unknown"
msgid "　少女の指には白い布が<絡|から>まっている。"
msgstr "  A white piece of cloth was wrapped in her fingers."

#. Occurrence 6_2:1382:7484: scene=6_2
#: 6_2:1382
msgctxt "text_id=7484 | speaker=unknown"
msgid "　それが何であるかなど、草十郎には語るまでもない。"
msgstr "  There was no need to tell him what it was."

#. Occurrence 6_2:1387:7485: scene=6_2
#: 6_2:1387
msgctxt "text_id=7485 | speaker=unknown"
msgid "　自分の持ち物を忘れるほど寝ぼけてはいなかったらしい。"
msgstr "  He was conscious enough to recognize his own possessions."

#. Occurrence 6_2:1440:7486: scene=6_2
#: 6_2:1440
msgctxt "text_id=7486 | speaker=unknown"
msgid "　無言の草十郎に、少女はふわりと布を落とした。"
msgstr "  Soujyuro sat speechless as she tossed it to him."

#. Occurrence 6_2:1447:7487: scene=6_2
#: 6_2:1447
msgctxt "text_id=7487 | speaker=unknown"
msgid "　草十郎は布を拾い上げ、くるくると自分の首に巻く。"
msgstr "  Picking it up, he wrapped it around his neck."

#. Occurrence 6_2:1501:7488: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_2_0002; voice_prefix=A40; voice_category=2; scene=6_2
#: 6_2:1501
msgctxt "text_id=7488 | speaker=alice"
msgid "「……青子は、それを知っているの？」"
msgstr "\"...Does Aoko know about that?\""

#. Occurrence 6_2:1507:7489: scene=6_2
#: 6_2:1507
msgctxt "text_id=7489 | speaker=unknown"
msgid "　ぶしつけな問いから、草十郎は目を逸らす。"
msgstr "  He looked away in response to her blunt question,"

#. Occurrence 6_2:1512:7490: scene=6_2
#: 6_2:1512
msgctxt "text_id=7490 | speaker=unknown"
msgid "　彼の頭に浮かんだのはまったく関係のない事だ。"
msgstr "  distracted by something unrelated."

#. Occurrence 6_2:1517:7491: scene=6_2
#: 6_2:1517
msgctxt "text_id=7491 | speaker=unknown"
msgid "　少女は蒼崎青子を『青子』と呼んだ。"
msgstr "  She called Aoko Aozaki by her given name,"

#. Occurrence 6_2:1522:7492: scene=6_2
#: 6_2:1522
msgctxt "text_id=7492 | speaker=unknown"
msgid "　では、青子が喧嘩を売っていたのは向かいの山ではなく彼女だったのだろう、と。"
msgstr "  which led him to believe that the mountain Aoko had argued with in his dream was actually the girl beside him."

#. Occurrence 6_2:1558:7493: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0011; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1558
msgctxt "text_id=7493 | speaker=soujuurou"
msgid "「さあ、どうだろう」"
msgstr "\"I'm not sure.\""

#. Occurrence 6_2:1564:7494: scene=6_2
#: 6_2:1564
msgctxt "text_id=7494 | speaker=unknown"
msgid "　できるだけ真摯に、予断を<交|まじ>えず草十郎は返答する。"
msgstr "  As sincerely as he could, he answered without presumption."

#. Occurrence 6_2:1584:7495: scene=6_2
#: 6_2:1584
msgctxt "text_id=7495 | speaker=unknown"
msgid "　知るべき事と、知らなくてもいい事。"
msgstr "  There are things that should be known, and things that need not be."

#. Occurrence 6_2:1589:7496: scene=6_2
#: 6_2:1589
msgctxt "text_id=7496 | speaker=unknown"
msgid "　伝えるべき事と、伝わってはいけない事。"
msgstr "  There are also things that should be told, and other things that must not be."

#. Occurrence 6_2:1594:7497: scene=6_2
#: 6_2:1594
msgctxt "text_id=7497 | speaker=unknown"
msgid "　少女の言う「それ」がどちらなのか、草十郎には考えられない。ただ、"
msgstr "  Soujyuro was not exactly sure what \"that\" she was referring to. However..."

#. Occurrence 6_2:1601:7498: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0012; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1601
msgctxt "text_id=7498 | speaker=soujuurou"
msgid "「でも、その方がいいとは思うよ」"
msgstr "\"But, maybe it's better that way.\""

#. Occurrence 6_2:1618:7499: scene=6_2
#: 6_2:1618
msgctxt "text_id=7499 | speaker=unknown"
msgid "　ごく自然に、少女の問いに微笑んだ。"
msgstr "  He smiled slightly at her question."

#. Occurrence 6_2:1638:7500: scene=6_2
#: 6_2:1638
msgctxt "text_id=7500 | speaker=unknown"
msgid "　そんな草十郎の対応に感じ入るものがあったのか、部屋を支配していた重圧は目に見えて薄れていった。"
msgstr "  Perhaps impressed by his response, the overwhelming pressure in the room dissipated noticeably."

#. Occurrence 6_2:1643:7501: scene=6_2
#: 6_2:1643
msgctxt "text_id=7501 | speaker=unknown"
msgid "　もしかすると、緊張の度合いは草十郎より少女の方が上だったのかも知れない。"
msgstr "  Or maybe she had been more nervous than he was the entire time,"

#. Occurrence 6_2:1648:7502: scene=6_2
#: 6_2:1648
msgctxt "text_id=7502 | speaker=unknown"
msgid "　……この場を支配していた少女の心の在り方が、部屋に投影されていたのなら。"
msgstr "  projecting the image that his room was her domain a tad too strongly."

#. Occurrence 6_2:1707:7503: scene=6_2
#: 6_2:1707
msgctxt "text_id=7503 | speaker=unknown"
msgid "　緊張は消えた。"
msgstr "  The tension faded."

#. Occurrence 6_2:1720:7504: scene=6_2
#: 6_2:1720
msgctxt "text_id=7504 | speaker=unknown"
msgid "　草十郎は体を起こそうとベッドに腕をたてる。"
msgstr "  Soujyuro tried to sit up and prop his arms beneath him."

#. Occurrence 6_2:1725:7505: scene=6_2
#: 6_2:1725
msgctxt "text_id=7505 | speaker=unknown"
msgid "　こうして話し合える以上、寝たままなのは不便だと思ったらしい。"
msgstr "  Now that they were talking, it seemed awkward to stay lying down."

#. Occurrence 6_2:1730:7506: scene=6_2
#: 6_2:1730
msgctxt "text_id=7506 | speaker=unknown"
msgid "　が。起きようとした途端、体の異様なだるさに驚いてしまって、簡単には起き上がれなかった。"
msgstr "  However, his body felt strange as he tried to move, and it surprised him how difficult it was to sit up."

#. Occurrence 6_2:1736:7507: scene=6_2
#: 6_2:1736
msgctxt "text_id=7507 | speaker=unknown"
msgid "　もぞもぞと動いて、ようやく上半身を起こすのが精一杯だ。"
msgstr "  It took everything he had just to raise his upper body to a sitting position."

#. Occurrence 6_2:1786:7508: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0013; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1786
msgctxt "text_id=7508 | speaker=soujuurou"
msgid "「……あれ？　洋服のままだ」"
msgstr "\"...Huh? I'm still in my clothes.\""

#. Occurrence 6_2:1792:7509: scene=6_2
#: 6_2:1792
msgctxt "text_id=7509 | speaker=unknown"
msgid "　かかっていた毛布を<剥|は>ぐなり、不思議そうに首をかしげる。"
msgstr "  As he threw the covers back, he tilted his head quizzically."

#. Occurrence 6_2:1819:7510: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0014; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1819
msgctxt "text_id=7510 | speaker=soujuurou"
msgid "「申し訳ない。こんないい布団なのに、これじゃ不釣り合いだ。……というより、勿体ない」"
msgstr "\"I'm sorry. This is such a nice bed, too. I shouldn't be in my clothes under the sheets. What a waste of a good bed.\""

#. Occurrence 6_2:1845:7511: scene=6_2
#: 6_2:1845
msgctxt "text_id=7511 | speaker=unknown"
msgid "　どうせならベッドに似合う寝間着で寝たかった、などとぼやく草十郎を、少女は意外そうに見つめている。"
msgstr "  She stared at him, not expecting him to complain about not wearing pajamas while sleeping."

#. Occurrence 6_2:1850:7512: scene=6_2
#: 6_2:1850
msgctxt "text_id=7512 | speaker=unknown"
msgid "　何か、少女にとって予想外の事をしてしまったらしい。"
msgstr "  Somehow, it appeared that he had done something to surprise her."

#. Occurrence 6_2:1886:7513: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0015; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1886
msgctxt "text_id=7513 | speaker=soujuurou"
msgid "『なんでだ。何もしてないぞ、俺』"
msgstr "(But why? I didn't do anything.)"

#. Occurrence 6_2:1892:7514: scene=6_2
#: 6_2:1892
msgctxt "text_id=7514 | speaker=unknown"
msgid "　<謂|い>われのない好奇心を向けられ、なんとなく拗ねながら草十郎は少女に体を向けた。"
msgstr "  Pouting a bit at the unwarranted curiosity, he turned to face her."

#. Occurrence 6_2:1897:7515: scene=6_2
#: 6_2:1897
msgctxt "text_id=7515 | speaker=unknown"
msgid "　まだベッドの上に横たわってはいるものの、幾分ましな姿勢になっている。"
msgstr "  Although he was still mostly laying down, it was at least a more dignified position."

#. Occurrence 6_2:1931:7516: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0016; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:1931
msgctxt "text_id=7516 | speaker=soujuurou"
msgid "「それで、さっきの続きだけど」"
msgstr "\"So... any chance you'll tell me...?\""

#. Occurrence 6_2:1937:7517: scene=6_2
#: 6_2:1937
msgctxt "text_id=7517 | speaker=unknown"
msgid "　そう、ここが何処で少女が何者なのか、まずそれを教えてもらわないと始まらない。"
msgstr "  Indeed, he needed to find out where he was and who she was before anything else."

#. Occurrence 6_2:1942:7518: scene=6_2
#: 6_2:1942
msgctxt "text_id=7518 | speaker=unknown"
msgid "　実際のところ、遊園地の事を思い出せば思い出すほど、そら恐ろしい想像しかできないのだが。"
msgstr "  Actually, the more he thought about what happened at the amusement park, the more he got a sinking feeling in his stomach."

#. Occurrence 6_2:1981:7519: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_2_0003; voice_prefix=A40; voice_category=2; scene=6_2
#: 6_2:1981
msgctxt "text_id=7519 | speaker=alice"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 6_2:1987:7520: scene=6_2
#: 6_2:1987
msgctxt "text_id=7520 | speaker=unknown"
msgid "　そんな草十郎の決意が伝わったのか、少女も冷徹に、背中に回していた手を動かそうとした時。"
msgstr "  Perhaps finally getting through to her, she calmly moved her arm from behind her back, when..."

#. Occurrence 6_2:2025:7521: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_2_0004; voice_prefix=A40; voice_category=2; scene=6_2
#: 6_2:2025
msgctxt "text_id=7521 | speaker=alice"
msgid "「…………」"
msgstr "\"...\""

#. Occurrence 6_2:2031:7522: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_2_0017; voice_prefix=A30; voice_category=3; scene=6_2
#: 6_2:2031
msgctxt "text_id=7522 | speaker=soujuurou"
msgid "「…………」"
msgstr "\"...\""

#. Occurrence 6_2:2036:7523: scene=6_2
#: 6_2:2036
msgctxt "text_id=7523 | speaker=unknown"
msgid "　またも無言で見つめ合ってしまう。"
msgstr "  Once again, they silently locked eyes."

#. Occurrence 6_2:2041:7524: scene=6_2
#: 6_2:2041
msgctxt "text_id=7524 | speaker=unknown"
msgid "　バタバタバタ。"
msgstr "  Thump, thump, thump."

#. Occurrence 6_2:2046:7525: scene=6_2
#: 6_2:2046
msgctxt "text_id=7525 | speaker=unknown"
msgid "　外から響いてくる足音は、何者かが走って来るものだ。"
msgstr "  There was a startling sound of rapidly approaching footsteps."

#. Occurrence 6_2:2052:7526: scene=6_2
#: 6_2:2052
msgctxt "text_id=7526 | speaker=unknown"
msgid "　それが誰のものか、少女はともかく草十郎にさえもありありと予測でき―――"
msgstr "  They both had a pretty good idea of who it was."

#. Occurrence 6_2:2161:7527: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_2_0000; voice_prefix=A10; voice_category=1; scene=6_2
#: 6_2:2161
msgctxt "text_id=7527 | speaker=aoko"
msgid "「有珠っ、約束！」"
msgstr "\"Alice! You promised!\""

#. Occurrence 6_2:2167:7528: scene=6_2
#: 6_2:2167
msgctxt "text_id=7528 | speaker=unknown"
msgid "　この通り。"
msgstr "  Just as expected."

#. Occurrence 6_2:2172:7529: scene=6_2
#: 6_2:2172
msgctxt "text_id=7529 | speaker=unknown"
msgid "　乱暴な<一喝|いっかつ>と共に入ってきたのは予想通り、蒼崎青子その人だった。"
msgstr "  Aoko Aozaki burst through the door with a thunderous roar."

#. Occurrence 6_3:57:7530: scene=6_3
#: 6_3:57
msgctxt "text_id=7530 | speaker=unknown"
msgid "　彼女は制服姿で、長い髪をなびかせて登場した。"
msgstr "  She entered wearing her school uniform, her long hair flowing behind her."

#. Occurrence 6_3:62:7531: scene=6_3
#: 6_3:62
msgctxt "text_id=7531 | speaker=unknown"
msgid "　乱れた呼吸と不機嫌そうにつり上がった瞳が、どことなく修羅めいている。"
msgstr "  Her breathing was heavy and her forehead was wrinkled by a scowl, granting her a demonic appearance."

#. Occurrence 6_3:83:7532: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0000; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:83
msgctxt "text_id=7532 | speaker=aoko"
msgid "「有珠っ！」"
msgstr "\"Alice!\""

#. Occurrence 6_3:104:7533: scene=6_3
#: 6_3:104
msgctxt "text_id=7533 | speaker=unknown"
msgid "　青子にそう呼ばれた少女―――有珠はわずかに眉を<顰|ひそ>めた。"
msgstr "  This girl named Alice scowled slightly in response."

#. Occurrence 6_3:109:7534: scene=6_3
#: 6_3:109
msgctxt "text_id=7534 | speaker=unknown"
msgid "　……はあ、とかため息をこぼしたのかもしれない。"
msgstr "  She may have even let a sigh of disappointment slip out."

#. Occurrence 6_3:138:7535: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0000; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:138
msgctxt "text_id=7535 | speaker=alice"
msgid "「早かったわね、青子」"
msgstr "\"Aoko. Home early, I see.\""

#. Occurrence 6_3:144:7536: scene=6_3
#: 6_3:144
msgctxt "text_id=7536 | speaker=unknown"
msgid "　激している青子とは正反対の落ち着いた声。"
msgstr "  Her calm voice was the polar opposite of Aoko's."

#. Occurrence 6_3:149:7537: scene=6_3
#: 6_3:149
msgctxt "text_id=7537 | speaker=unknown"
msgid "　どこか白々しいのは言うまでもない。"
msgstr "  Needless to say, her voice dripped with a brazen coldness."

#. Occurrence 6_3:203:7538: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0001; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:203
msgctxt "text_id=7538 | speaker=aoko"
msgid "「そりゃあ、アンタの性格は知り抜いてるからね。"
msgstr "\"That's because I know you all too well."

#. Occurrence 6_3:209:7539: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0002; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:209
msgctxt "text_id=7539 | speaker=aoko"
msgid "　こういう時の短絡思考はこの二年で経験済みよ。お行儀がいいようで、面倒になったらあっさり投げ捨てるのがアンタでしょ」"
msgstr "  Over the past two years, I've come to expect how quickly you jump to conclusions. You might act mild-mannered, but as soon as things don't go your way, the veil drops.\""

#. Occurrence 6_3:254:7540: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0001; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:254
msgctxt "text_id=7540 | speaker=alice"
msgid "「いやね、人聞きの悪い」"
msgstr "\"Oh dear, you make it sound so scandalous.\""

#. Occurrence 6_3:274:7541: scene=6_3
#: 6_3:274
msgctxt "text_id=7541 | speaker=unknown"
msgid "　青子の指摘を軽く受け流す有珠。"
msgstr "  Effortlessly, she brushed aside Aoko's jab."

#. Occurrence 6_3:279:7542: scene=6_3
#: 6_3:279
msgctxt "text_id=7542 | speaker=unknown"
msgid "　もう草十郎なんて目に入っていない、と言わんばかりの態度だった。"
msgstr "  In doing so, Soujyuro had the distinct impression that she no longer even realized he was in the room."

#. Occurrence 6_3:326:7543: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0003; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:326
msgctxt "text_id=7543 | speaker=aoko"
msgid "「はん。それで今日まで何度<煮|に>え湯を飲まされたコトか。"
msgstr "\"Ha! Let the record show that I've lost count of how many times you've gone back on your word."

#. Occurrence 6_3:338:7544: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0004; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:338
msgctxt "text_id=7544 | speaker=aoko"
msgid "　青子に<譲|ゆず>るといったけど、よく考えると面倒だから私の方で処理しておいたわ―――なんて事<後承|いいわけ>諾、もう聞き飽きたっつーの。"
msgstr "  I'm tired of hearing the same old story after the fact: 'I know I said I would leave it to you, but after careful consideration I decided to take care of it myself.'"

#. Occurrence 6_3:365:7545: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0005; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:365
msgctxt "text_id=7545 | speaker=aoko"
msgid "　短気なのはそっちの自由だけど、それなら後の始末は相方に任せるのが最低限の筋ってもんじゃないの？」"
msgstr "  I may have come to terms with your short fuse, but the least you can do in return is to trust your partner to set things right, no?\""

#. Occurrence 6_3:394:7546: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0002; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:394
msgctxt "text_id=7546 | speaker=alice"
msgid "「そうね。そうでなければ協闘している意味がないわ。"
msgstr "\"You're right. We wouldn't be partners otherwise."

#. Occurrence 6_3:400:7547: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0003; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:400
msgctxt "text_id=7547 | speaker=alice"
msgid "　……まあ。今後の方針を勝手に決めた人の台詞じゃないとは思うけど」"
msgstr "  Though... you're hardly one to talk, after unilaterally deciding our plan from here on out.\""

#. Occurrence 6_3:435:7548: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0006; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:435
msgctxt "text_id=7548 | speaker=aoko"
msgid "「それもきっちり片をつけたでしょう。"
msgstr "\"We've been over this already."

#. Occurrence 6_3:441:7549: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0007; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:441
msgctxt "text_id=7549 | speaker=aoko"
msgid "　いい、勝ったのは<私|・><た|・><ち|・>よ。逃げ切れば見逃してあげるって言ったのは誰？　言動には責任を持ちなさい有珠。"
msgstr "  We won, okay! Besides, who was the one who said we should let him live if he escaped? Yet again you've gone back on your word, Alice."

#. Occurrence 6_3:447:7550: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0008; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:447
msgctxt "text_id=7550 | speaker=aoko"
msgid "　それともなに。もしかして、一番気に食わないのはそのあたりの理由なワケ？」"
msgstr "  Oh, don't tell me. Next you'll be saying *that's* the reason you can't let sleeping dogs lie!\""

#. Occurrence 6_3:483:7551: scene=6_3
#: 6_3:483
msgctxt "text_id=7551 | speaker=unknown"
msgid "　む、と考えこむ有珠。"
msgstr "  Alice frowned slightly and fell silent."

#. Occurrence 6_3:488:7552: scene=6_3
#: 6_3:488
msgctxt "text_id=7552 | speaker=unknown"
msgid "　青子の詰問は、有珠自身気付いていなかったところを突いたらしい。"
msgstr "  Her housemate seemed to have struck a nerve that Alice herself did not know was there."

#. Occurrence 6_3:531:7553: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0009; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:531
msgctxt "text_id=7553 | speaker=aoko"
msgid "「とにかく。"
msgstr "\"Anyway..."

#. Occurrence 6_3:537:7554: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0010; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:537
msgctxt "text_id=7554 | speaker=aoko"
msgid "　コイツの扱いは、ちゃんと目が覚めて、本人の意志でどうするか決めるまで保留ってコトで合意したでしょ。"
msgstr "  We agreed to decide what to do with him when he wakes up, after hearing him out, right?"

#. Occurrence 6_3:543:7555: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0011; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:543
msgctxt "text_id=7555 | speaker=aoko"
msgid "　人の留守中に出し抜くのはやめてよね」"
msgstr "  So stop trying to flip the script every time my back's turned.\""

#. Occurrence 6_3:584:7556: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0004; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:584
msgctxt "text_id=7556 | speaker=alice"
msgid "「……それ。青子、学校はどうしたの。"
msgstr "\"...Speaking of which, aren't you supposed to be at school?"

#. Occurrence 6_3:584:7557: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0004; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:584
msgctxt "text_id=7557 | speaker=alice"
msgid "　まだ正午になったばかりなのに」"
msgstr "  It's noon already.\""

#. Occurrence 6_3:627:7558: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0012; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:627
msgctxt "text_id=7558 | speaker=aoko"
msgid "「有珠の<学|と><校|こ>が今日で<終業式|おわり>って思い出して、家庭の事情って事で早退したのよ。期末試験前だってのに、ほんと、なにやってんだか」"
msgstr "\"I remembered you only had your school's end-of-term ceremony today, so I told them I had to leave early for personal reasons. This is so warped. I have finals coming up, for goodness' sake.\""

#. Occurrence 6_3:633:7559: scene=6_3
#: 6_3:633
msgctxt "text_id=7559 | speaker=unknown"
msgid "　誰かに同意を求めるのではなく、自分自身に言い聞かせるように青子は言う。"
msgstr "  Aoko grumbled, more to herself than anyone else in the room."

#. Occurrence 6_3:676:7560: scene=6_3
#: 6_3:676
msgctxt "text_id=7560 | speaker=unknown"
msgid "　そうして青子と有珠は見つめ合った。"
msgstr "  Then, she locked eyes with Alice."

#. Occurrence 6_3:681:7561: scene=6_3
#: 6_3:681
msgctxt "text_id=7561 | speaker=unknown"
msgid "　いや、正しくは睨み合っている。"
msgstr "  Or more accurately, they glared daggers at each other."

#. Occurrence 6_3:709:7562: scene=6_3
#: 6_3:709
msgctxt "text_id=7562 | speaker=unknown"
msgid "　今まさにとっくみ合いの喧嘩が始まりそうな緊迫感だが、<第三者|そうじゅうろう>としてはなす術なく眺めているしかない。"
msgstr "  The room had become tense once again, and it felt like a fight could break out at any moment. With no way to escape, Soujyuro had no choice but to sit and watch."

#. Occurrence 6_3:755:7563: scene=6_3
#: 6_3:755
msgctxt "text_id=7563 | speaker=unknown"
msgid "　……もっとも。"
msgstr "  But then..."

#. Occurrence 6_3:760:7564: scene=6_3
#: 6_3:760
msgctxt "text_id=7564 | speaker=unknown"
msgid "　しばらく続くと思われた沈黙は、一分ほどであっさりと終わってしまった。"
msgstr "  The electric silence that seemed like it would last forever suddenly broke about a minute later."

#. Occurrence 6_3:765:7565: scene=6_3
#: 6_3:765
msgctxt "text_id=7565 | speaker=unknown"
msgid "　この程度のぶつかり合いは日常茶飯事らしい。"
msgstr "  Apparently this sort of clash was an everyday occurrence."

#. Occurrence 6_3:808:7566: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0005; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:808
msgctxt "text_id=7566 | speaker=alice"
msgid "「……わたしは居間に行っているから。"
msgstr "\"...I'll be in the drawing room."

#. Occurrence 6_3:814:7567: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0006; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:814
msgctxt "text_id=7567 | speaker=alice"
msgid "　彼に事情を説明してあげて」"
msgstr "  Explain the circumstances to him.\""

#. Occurrence 6_3:841:7568: scene=6_3
#: 6_3:841
msgctxt "text_id=7568 | speaker=unknown"
msgid "　有珠は椅子から立ち上がり、扉へと歩きだす。"
msgstr "  Alice stood up from the chair and made for the door."

#. Occurrence 6_3:861:7569: scene=6_3
#: 6_3:861
msgctxt "text_id=7569 | speaker=unknown"
msgid "　その背中を見て草十郎は首を<傾|かし>げてしまった。"
msgstr "  Watching her go, Soujyuro cocked his head."

#. Occurrence 6_3:866:7570: scene=6_3
#: 6_3:866
msgctxt "text_id=7570 | speaker=unknown"
msgid "　有珠の手には何か、どう控えめに表現しても、"
msgstr "  In her hand was what could only be described as..."

#. Occurrence 6_3:886:7571: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_3_0000; voice_prefix=A30; voice_category=3; scene=6_3
#: 6_3:886
msgctxt "text_id=7571 | speaker=soujuurou"
msgid "『……果物、ナイフ……？』"
msgstr "(...A fruit knife?)"

#. Occurrence 6_3:891:7572: scene=6_3
#: 6_3:891
msgctxt "text_id=7572 | speaker=unknown"
msgid "　としか言い表せない<得物|えもの>が握られていたからだ。"
msgstr "  He had no other words to describe the tool she was clutching."

#. Occurrence 6_3:936:7573: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_3_0013; voice_prefix=A10; voice_category=1; scene=6_3
#: 6_3:936
msgctxt "text_id=7573 | speaker=aoko"
msgid "「有珠。あえて聞くけど、その手に持ってるの、なに？」"
msgstr "\"Alice. I hate to ask, but what's in your hand?\""

#. Occurrence 6_3:941:7574: scene=6_3
#: 6_3:941
msgctxt "text_id=7574 | speaker=unknown"
msgid "　横を通り過ぎる有珠に問いかける青子。"
msgstr "  Aoko asked Alice as she walked past."

#. Occurrence 6_3:979:7575: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_3_0007; voice_prefix=A40; voice_category=2; scene=6_3
#: 6_3:979
msgctxt "text_id=7575 | speaker=alice"
msgid "「短剣ね、どう見ても」"
msgstr "\"A dagger, what else?\""

#. Occurrence 6_3:1009:7576: scene=6_3
#: 6_3:1009
msgctxt "text_id=7576 | speaker=unknown"
msgid "　有珠は無表情で返答し、スタスタと部屋から立ち去った。"
msgstr "  Alice answered expressionlessly, before briskly walking out of the room."

#. Occurrence 6_3:1044:7577: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_3_0001; voice_prefix=A30; voice_category=3; scene=6_3
#: 6_3:1044
msgctxt "text_id=7577 | speaker=soujuurou"
msgid "「……………………」"
msgstr "\"...\""

#. Occurrence 6_3:1049:7578: scene=6_3
#: 6_3:1049
msgctxt "text_id=7578 | speaker=unknown"
msgid "　よし。今の会話に関しては深く考えないようにしよう、と自己防衛する草十郎なのだった。"
msgstr "  Soujyuro thought it best to not think too deeply about the scene he had just witnessed."

#. Occurrence 6_4:69:7579: scene=6_4
#: 6_4:69
msgctxt "text_id=7579 | speaker=unknown"
msgid "　ともあれ、緊張感の大本であった黒衣の少女は立ち去った。"
msgstr "  At any rate, the girl in black had withdrawn, and along with her the feeling of tension."

#. Occurrence 6_4:74:7580: scene=6_4
#: 6_4:74
msgctxt "text_id=7580 | speaker=unknown"
msgid "　部屋にはベッドに横になった草十郎と、制服姿の蒼崎青子がいる。"
msgstr "  Leaving a bedridden Soujyuro alone with an Aoko still dressed for school."

#. Occurrence 6_4:79:7581: scene=6_4
#: 6_4:79
msgctxt "text_id=7581 | speaker=unknown"
msgid "　草十郎からすれば、たまりにたまった疑問を解決するには絶好の機会だ。"
msgstr "  From Soujyuro's perspective, this was a perfect chance to get answers to his ever growing list of questions."

#. Occurrence 6_4:111:7582: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0000; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:111
msgctxt "text_id=7582 | speaker=soujuurou"
msgid "「ワケの分からない事だらけだ、蒼崎」"
msgstr "\"My head's spinning, Aozaki.\""

#. Occurrence 6_4:141:7583: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0000; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:141
msgctxt "text_id=7583 | speaker=aoko"
msgid "「でしょうね。順序だてて説明してあげるから、ちょっと黙ってて」"
msgstr "\"I bet. I'll explain everything in order, so just shut up and listen.\""

#. Occurrence 6_4:191:7584: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0001; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:191
msgctxt "text_id=7584 | speaker=aoko"
msgid "「顔の麻痺も取れてるし、呼吸も再開、と……これならもう安心かな」"
msgstr "\"I see the facial paralysis is gone, and your breathing has stabilized. It looks like you're through the worst of it.\""

#. Occurrence 6_4:211:7585: scene=6_4
#: 6_4:211
msgctxt "text_id=7585 | speaker=unknown"
msgid "　青子はよし、と頷いて椅子に腰を下ろした。"
msgstr "  She nodded, satisfied, as she took a seat."

#. Occurrence 6_4:238:7586: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0002; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:238
msgctxt "text_id=7586 | speaker=aoko"
msgid "「どう、調子は？」"
msgstr "\"How do you feel?\""

#. Occurrence 6_4:257:7587: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0001; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:257
msgctxt "text_id=7587 | speaker=soujuurou"
msgid "「…………なんか、だるい」"
msgstr "\"A bit...sluggish.\""

#. Occurrence 6_4:263:7588: scene=6_4
#: 6_4:263
msgctxt "text_id=7588 | speaker=unknown"
msgid "　がっくりと肩を落として、草十郎は弱々しく返答する。"
msgstr "  He answered meekly, dropping his shoulders."

#. Occurrence 6_4:268:7589: scene=6_4
#: 6_4:268
msgctxt "text_id=7589 | speaker=unknown"
msgid "　答えながらも左手を何度か握りしめたが、指の動きは緩慢で、ぎこちない。体がまだ不調であるのは明白だ。"
msgstr "  He opened and closed his left hand a few times, but moving his fingers felt slow and awkward. It was clear he was still in bad shape."

#. Occurrence 6_4:309:7590: scene=6_4
#: 6_4:309
msgctxt "text_id=7590 | speaker=unknown"
msgid "　一方、青子は目をしばたたいていた。"
msgstr "  Meanwhile, Aoko was blinking her eyes in wonder."

#. Occurrence 6_4:314:7591: scene=6_4
#: 6_4:314
msgctxt "text_id=7591 | speaker=unknown"
msgid "　驚き……というより、感心しているようだ。"
msgstr "  Or was it admiration?"

#. Occurrence 6_4:319:7592: scene=6_4
#: 6_4:319
msgctxt "text_id=7592 | speaker=unknown"
msgid "　有珠といい青子といい、草十郎には彼女たちの表情を読み取るのは難しい。"
msgstr "  Between Alice and Aoko, Soujyuro did not know which of the girls was the harder to read."

#. Occurrence 6_4:347:7593: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0003; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:347
msgctxt "text_id=7593 | speaker=aoko"
msgid "「ま、体が重いのは当然よ。"
msgstr "\"Well, you're bound to feel a bit sluggish."

#. Occurrence 6_4:354:7594: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0004; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:354
msgctxt "text_id=7594 | speaker=aoko"
msgid "まる二日経ってるし、寝てるだけでも体は弱ってるだろうし。"
msgstr "Lying in bed for two days straight would make anyone feel weak."

#. Occurrence 6_4:360:7595: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0005; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:360
msgctxt "text_id=7595 | speaker=aoko"
msgid "　でも、もう話せるくらい回復してるとは思わなかった。"
msgstr "  But, I never thought you would be well enough to speak."

#. Occurrence 6_4:360:7596: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0005; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:360
msgctxt "text_id=7596 | speaker=aoko"
msgid "　アンタって見かけより頑丈にできてるのね」"
msgstr "  You're a lot tougher than you look.\""

#. Occurrence 6_4:366:7597: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0002; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:366
msgctxt "text_id=7597 | speaker=soujuurou"
msgid "「？　……二日って？」"
msgstr "\"...Two days...?\""

#. Occurrence 6_4:394:7598: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0006; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:394
msgctxt "text_id=7598 | speaker=aoko"
msgid "「あれからそれだけ経ってるの。学校には欠席届だしといたから、その点は安心して。"
msgstr "\"It's been two days. Don't worry about the school, I submitted a notice of absence."

#. Occurrence 6_4:400:7599: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0007; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:400
msgctxt "text_id=7599 | speaker=aoko"
msgid "　ガンドの呪いもダンプティの<詩篇|のろい>も、私と有珠とで解呪しといたから」"
msgstr "  In the meantime, Alice and I dispelled the Gandr curse and Dumpty poem.\""

#. Occurrence 6_4:434:7600: scene=6_4
#: 6_4:434
msgctxt "text_id=7600 | speaker=unknown"
msgid "　呪いと聞いて、草十郎はああ、と頷いた。"
msgstr "  Soujyuro nodded at the word \"curse\" as if recalling it suddenly."

#. Occurrence 6_4:439:7601: scene=6_4
#: 6_4:439
msgctxt "text_id=7601 | speaker=unknown"
msgid "　そういえば、そんな事もあったなぁ、と。"
msgstr "  It was all coming back to him now."

#. Occurrence 6_4:481:7602: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0008; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:481
msgctxt "text_id=7602 | speaker=aoko"
msgid "「どうかした？　そんな遠い目しちゃって」"
msgstr "\"What's wrong? You look troubled by something.\""

#. Occurrence 6_4:496:7603: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0003; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:496
msgctxt "text_id=7603 | speaker=soujuurou"
msgid "「ああ、忘れてた。それで二日も寝こんでたのか。恐いもんだな、呪われるって事は」"
msgstr "\"I just forgot everything that really happened is all. Was I really asleep for two days? Getting cursed is pretty scary.\""

#. Occurrence 6_4:507:7604: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0009; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:507
msgctxt "text_id=7604 | speaker=aoko"
msgid "「……ほんと緊張感ないわねアンタ。蝋のように眠ってたのが嘘みたいよ。下手すると一生あのまま、石膏もどきだったかもしれないのに」"
msgstr "\"You're as cool as a cucumber, aren't you? It's as if two days on death's door hasn't changed you a bit. Do you realize you were one step away from becoming a vegetable for the rest of your life?\""

#. Occurrence 6_4:564:7605: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0004; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:564
msgctxt "text_id=7605 | speaker=soujuurou"
msgid "「……ちょっと待った。今、すごいコト言わなかったか？」"
msgstr "\"...Wait just a second. Was it really that bad?\""

#. Occurrence 6_4:577:7606: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0010; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:577
msgctxt "text_id=7606 | speaker=aoko"
msgid "「言ったけど聞かぬが花よ。"
msgstr "\"It was, and I guess you're proof that ignorance is bliss after all."

#. Occurrence 6_4:602:7607: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0011; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:602
msgctxt "text_id=7607 | speaker=aoko"
msgid "　ま、経緯はどうあれ、後で有珠にお礼を言っときなさい。私じゃ解呪できなかったんだから」"
msgstr "  Anyway, what's done is done. Be sure to thank Alice later. I couldn't have lifted the curses without her help.\""

#. Occurrence 6_4:616:7608: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0005; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:616
msgctxt "text_id=7608 | speaker=soujuurou"
msgid "「……ひどい花もあったもんだ。"
msgstr "\"...Sometimes bliss is overrated."

#. Occurrence 6_4:629:7609: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0006; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:629
msgctxt "text_id=7609 | speaker=soujuurou"
msgid "　あ、けど、有珠っていうのはさっきの<娘|こ>か？"
msgstr "  Oh, and yeah, you said the name 'Alice.' Was that girl Alice?"

#. Occurrence 6_4:629:7610: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0006; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:629
msgctxt "text_id=7610 | speaker=soujuurou"
msgid "　遊園地で、その……俺たちを殺そうとした？」"
msgstr "  Was she the one who, you know, tried to kill us at the amusement park?\""

#. Occurrence 6_4:648:7611: scene=6_4
#: 6_4:648
msgctxt "text_id=7611 | speaker=unknown"
msgid "　それにまあね、と答える青子。"
msgstr "  Aoko replied that it was."

#. Occurrence 6_4:669:7612: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0007; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:669
msgctxt "text_id=7612 | speaker=soujuurou"
msgid "「彼女、ずっとそこに座ってたけど。……ここは彼女の部屋なのか？」"
msgstr "\"She was sitting by my side for ages. Is this her room or something?\""

#. Occurrence 6_4:688:7613: scene=6_4
#: 6_4:688
msgctxt "text_id=7613 | speaker=unknown"
msgid "　草十郎は改めて部屋を見渡す。"
msgstr "  Soujyuro scanned the room again."

#. Occurrence 6_4:693:7614: scene=6_4
#: 6_4:693
msgctxt "text_id=7614 | speaker=unknown"
msgid "　自分が眠っていたベッド共々、彼の見聞にはない洋風の部屋。"
msgstr "  He was not accustomed to sleeping on anything other than a futon, and the room looked especially foreign to him."

#. Occurrence 6_4:726:7615: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0012; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:726
msgctxt "text_id=7615 | speaker=aoko"
msgid "「ううん、ここはただの客室。長いこと使ってなかったから埃だらけでしょ。"
msgstr "\"No, this is just a guest room. It hasn't been used in forever, hence the dust over everything."

#. Occurrence 6_4:732:7616: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0013; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:732
msgctxt "text_id=7616 | speaker=aoko"
msgid "　それより有珠と何か話したの、あなた？」"
msgstr "  More importantly, what did you and Alice talk about?\""

#. Occurrence 6_4:749:7617: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0008; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:749
msgctxt "text_id=7617 | speaker=soujuurou"
msgid "「―――。"
msgstr "\"...Well..."

#. Occurrence 6_4:756:7618: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0009; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:756
msgctxt "text_id=7618 | speaker=soujuurou"
msgid "いや、あれを会話と言うのは、ちょっと」"
msgstr "We didn't really talk so much as...\""

#. Occurrence 6_4:761:7619: scene=6_4
#: 6_4:761
msgctxt "text_id=7619 | speaker=unknown"
msgid "　草十郎は口に手を当てて、さっき交わした言葉を思い返す。"
msgstr "  He brought his hand to his mouth, and recalled the few words they exchanged."

#. Occurrence 6_4:790:7620: scene=6_4
#: 6_4:790
msgctxt "text_id=7620 | speaker=unknown"
msgid "　……彼の言う通り、アレを会話と言うのはおこがましい。"
msgstr "  As Soujyuro said, calling it a conversation would be a gross overstatement."

#. Occurrence 6_4:795:7621: scene=6_4
#: 6_4:795
msgctxt "text_id=7621 | speaker=unknown"
msgid "　なのに、思い返してみると何時間も話していた気がして、草十郎はかすかに苦笑してしまった。"
msgstr "  And yet, thinking back on it, it seemed like they had talked for hours, which brought an uncomfortable smile to his face."

#. Occurrence 6_4:828:7622: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0010; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:828
msgctxt "text_id=7622 | speaker=soujuurou"
msgid "「とはいえ、緊張は解けたと思うよ。"
msgstr "\"But it's fine, I'm no longer worried."

#. Occurrence 6_4:834:7623: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0011; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:834
msgctxt "text_id=7623 | speaker=soujuurou"
msgid "　蒼崎がやってくるのがもう少し遅かったら良かったのに」"
msgstr "  Although, it would have been nice if you had come a little later, Aozaki.\""

#. Occurrence 6_4:869:7624: scene=6_4
#: 6_4:869
msgctxt "text_id=7624 | speaker=unknown"
msgid "　本心からの一言に、青子はムッと瞳を細める。"
msgstr "  Aoko narrowed her eyes at his innocent slip of the tongue."

#. Occurrence 6_4:874:7625: scene=6_4
#: 6_4:874
msgctxt "text_id=7625 | speaker=unknown"
msgid "　草十郎が<青子|じぶん>を邪魔者扱いしていないのは分かるが、面と向かって言われるのは面白くない。"
msgstr "  She knew Soujyuro did not mean to treat her like a nuisance, but nevertheless, she found it hard to take the full brunt of the words said to her face."

#. Occurrence 6_4:886:7626: scene=6_4
#: 6_4:886
msgctxt "text_id=7626 | speaker=unknown"
msgid "　さらに面白くないのは、彼のそんな言動に慣れはじめている自分がいる事だ。"
msgstr "  Even worse, she sensed she was getting used to his manner of speaking."

#. Occurrence 6_4:928:7627: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0014; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:928
msgctxt "text_id=7627 | speaker=aoko"
msgid "「でも、だから、なのかもね。相変わらず首の皮一枚の人生送ってるわ、貴方って」"
msgstr "\"So that's why she... You really do have a knack for surviving by the skin of your teeth, don't you?\""

#. Occurrence 6_4:933:7628: scene=6_4
#: 6_4:933
msgctxt "text_id=7628 | speaker=unknown"
msgid "　それにはい？　と首を傾げる草十郎。"
msgstr "  He tilted his head, clearly confused."

#. Occurrence 6_4:960:7629: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0015; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:960
msgctxt "text_id=7629 | speaker=aoko"
msgid "「だから、アンタはよっぽど有珠好みの対応をしたのよ。"
msgstr "\"I'm saying you did something to please Alice."

#. Occurrence 6_4:960:7630: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0015; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:960
msgctxt "text_id=7630 | speaker=aoko"
msgid "　まだ生きてるって、そういうコト」"
msgstr "  That's the reason you're still alive.\""

#. Occurrence 6_4:983:7631: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0012; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:983
msgctxt "text_id=7631 | speaker=soujuurou"
msgid "「？？？」"
msgstr "\"???\""

#. Occurrence 6_4:988:7632: scene=6_4
#: 6_4:988
msgctxt "text_id=7632 | speaker=unknown"
msgid "　青子の言いたい事はどうにも草十郎には掴めなかった。"
msgstr "  No matter how hard he tried, he could not grasp what she was getting at."

#. Occurrence 6_4:993:7633: scene=6_4
#: 6_4:993
msgctxt "text_id=7633 | speaker=unknown"
msgid "　掴めなかったので、その事はあえて訊かない事にする。"
msgstr "  He decided to change the subject to something else."

#. Occurrence 6_4:1037:7634: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0013; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1037
msgctxt "text_id=7634 | speaker=soujuurou"
msgid "「……ところで、ここは何処なんだ？"
msgstr "\"...By the way, where are we, exactly?"

#. Occurrence 6_4:1037:7635: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0013; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1037
msgctxt "text_id=7635 | speaker=soujuurou"
msgid "　あの<娘|こ>に訊いても教えてくれなかったけど、蒼崎なら教えてくれるだろ」"
msgstr "  I asked the other girl, but she wouldn't tell me. You can tell me, right, Aozaki?\""

#. Occurrence 6_4:1065:7636: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0016; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1065
msgctxt "text_id=7636 | speaker=aoko"
msgid "「ここは三咲町の幽霊屋敷よ。正確には<久遠寺|くおんじ>邸と言えばいいかしらね。"
msgstr "\"You are inside Misaki's infamous haunted house. But you can call it the Kuonji Estate."

#. Occurrence 6_4:1087:7637: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0017; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1087
msgctxt "text_id=7637 | speaker=aoko"
msgid "　さっきの娘……久遠寺有珠の持ち家で、私が住んでるところでもある。あの後、貴方をここまで持ってきたんだけど、<覚|おぼ>えてないでしょ？」"
msgstr "  And that girl...that's Alice Kuonji. This is her mansion, which happens to be the place I currently call home. After the other night, I, uh, brought you here. You don't remember, do you?\""

#. Occurrence 6_4:1093:7638: scene=6_4
#: 6_4:1093
msgctxt "text_id=7638 | speaker=unknown"
msgid "　持ってきた、という単語にいまいち違和感を覚える草十郎だった。"
msgstr "  Something about the way she said that made him feel uncomfortable."

#. Occurrence 6_4:1114:7639: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0014; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1114
msgctxt "text_id=7639 | speaker=soujuurou"
msgid "「久遠寺って言う名前は聞きおぼえがあるような……そうだ、よく商店街でおじさんたちが話してた。なんでもえらいお金持ちだとか、なんとか」"
msgstr "\"Kuonji... I've heard that name before. Hey, I know, some old guys in the shopping district were talking about it. The Kuonji's are a rich and famous family, or something.\""

#. Occurrence 6_4:1120:7640: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0018; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1120
msgctxt "text_id=7640 | speaker=aoko"
msgid "「それ、有珠の前ではご<法度|はっと>よ。"
msgstr "\"Don't you dare say that in front of Alice."

#. Occurrence 6_4:1120:7641: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0018; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1120
msgctxt "text_id=7641 | speaker=aoko"
msgid "　穏便にここで暮らしたいならね」"
msgstr "  If you want to live here in peace, that is.\""

#. Occurrence 6_4:1145:7642: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0015; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1145
msgctxt "text_id=7642 | speaker=soujuurou"
msgid "「……？」"
msgstr "\"...?\""

#. Occurrence 6_4:1150:7643: scene=6_4
#: 6_4:1150
msgctxt "text_id=7643 | speaker=unknown"
msgid "　本日何度目かになる首傾げだった。"
msgstr "  Confused yet again, Soujyuro tilted his head for what seemed like the hundredth time that day."

#. Occurrence 6_4:1155:7644: scene=6_4
#: 6_4:1155
msgctxt "text_id=7644 | speaker=unknown"
msgid "　今、またも引っ掛かる単語が出てきた気がする。"
msgstr "  And once again, he had heard something to make him feel uneasy."

#. Occurrence 6_4:1190:7645: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0016; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1190
msgctxt "text_id=7645 | speaker=soujuurou"
msgid "「蒼崎。君、今なんて言った？」"
msgstr "\"Aozaki...? Did you just say...?\""

#. Occurrence 6_4:1211:7646: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0019; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1211
msgctxt "text_id=7646 | speaker=aoko"
msgid "「静希君。私ね、あからさまな嘘を言う人と、同じ事を何度も言わせる人と、察しの悪い人には容赦しないから。"
msgstr "\"Sizuki. I have very little patience for liars, idiots, and people that make me repeat myself."

#. Occurrence 6_4:1217:7647: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0020; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1217
msgctxt "text_id=7647 | speaker=aoko"
msgid "　そのあたり覚えておいてね、ここで平穏に暮らしたいなら」"
msgstr "  Do your best to remember that if you want to enjoy your stay here.\""

#. Occurrence 6_4:1223:7648: scene=6_4
#: 6_4:1223
msgctxt "text_id=7648 | speaker=unknown"
msgid "　極上の笑顔で、さわやかに不穏な宣言をする青子。"
msgstr "  With her best smile, Aoko made her threatening proclamation."

#. Occurrence 6_4:1228:7649: scene=6_4
#: 6_4:1228
msgctxt "text_id=7649 | speaker=unknown"
msgid "　もちろん、草十郎にとっては寝耳に水の話である。"
msgstr "  Needless to say, it caught Soujyuro completely off guard."

#. Occurrence 6_4:1275:7650: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0017; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1275
msgctxt "text_id=7650 | speaker=soujuurou"
msgid "「……気のせいならいいんだけど、君の言葉には、俺がここに住むような響きが感じられる」"
msgstr "\"I must have misheard you, because I could have sworn you said something about me living here.\""

#. Occurrence 6_4:1302:7651: scene=6_4
#: 6_4:1302
msgctxt "text_id=7651 | speaker=unknown"
msgid "　草十郎は正直に、心底から嫌そうな顔で青子を見る。"
msgstr "  He shot her an honest stare of disapproval."

#. Occurrence 6_4:1307:7652: scene=6_4
#: 6_4:1307
msgctxt "text_id=7652 | speaker=unknown"
msgid "　彼なりの精一杯の<反政府運動|レジスタンス>だ。"
msgstr "  It was the best resistance he could muster."

#. Occurrence 6_4:1312:7653: scene=6_4
#: 6_4:1312
msgctxt "text_id=7653 | speaker=unknown"
msgid "　が、そんな貧弱な運動は効かない、とばかりに青子は冷酷な視線を返すのだった。"
msgstr "  But it was not in the slightest effective against Aoko's overpowering ruthless glare."

#. Occurrence 6_4:1348:7654: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0021; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1348
msgctxt "text_id=7654 | speaker=aoko"
msgid "「貴方、自分の立場を分かってる？」"
msgstr "\"The quicker you understand the position you're in, the better it'll be for you.\""

#. Occurrence 6_4:1354:7655: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0018; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1354
msgctxt "text_id=7655 | speaker=soujuurou"
msgid "「えーと、」"
msgstr "\"You mean...\""

#. Occurrence 6_4:1359:7656: scene=6_4
#: 6_4:1359
msgctxt "text_id=7656 | speaker=unknown"
msgid "　それが分かっていれば蒼崎が苦労しない、というのは分かるよ―――"
msgstr "  He considered her words carefully."

#. Occurrence 6_4:1364:7657: scene=6_4
#: 6_4:1364
msgctxt "text_id=7657 | speaker=unknown"
msgid "　なんて感想を喉もとで止めて、草十郎は首を横に振った。"
msgstr "  He wanted to openly express his feelings on the matter, but instead he swallowed his words and shook his head."

#. Occurrence 6_4:1405:7658: scene=6_4
#: 6_4:1405
msgctxt "text_id=7658 | speaker=unknown"
msgid "　空気を読めない彼でも、今は自重すべきだと感じ取ったらしい。"
msgstr "  Despite his typical inability to read people's emotions, he at least seemed to understand the gravity of the situation."

#. Occurrence 6_4:1410:7659: scene=6_4
#: 6_4:1410
msgctxt "text_id=7659 | speaker=unknown"
msgid "　そんなのんびりした態度こそが青子の癪に障る事を、彼もそろそろ気付くべきだ。"
msgstr "  It appeared that he had finally realized that it was his carefree mood that typically got on Aoko's nerves."

#. Occurrence 6_4:1453:7660: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0022; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1453
msgctxt "text_id=7660 | speaker=aoko"
msgid "「……はあ。そうだった。アンタに回りくどいこと言っても無駄だったのよね。"
msgstr "\"...Ugh. My mistake. I forgot there's no use beating around the bush with you."

#. Occurrence 6_4:1460:7661: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0023; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1460
msgctxt "text_id=7661 | speaker=aoko"
msgid "いいわ、考える時間ぐらいあげたかったけど、時間もないし、はっきりと言ってあげる」"
msgstr "Fine, I wanted to give you time to think, but we're way past that, so I'll just come right out and say it.\""

#. Occurrence 6_4:1492:7662: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0024; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1492
msgctxt "text_id=7662 | speaker=aoko"
msgid "「いい、静希君？"
msgstr "\"Listen to me, Sizuki."

#. Occurrence 6_4:1509:7663: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0025; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1509
msgctxt "text_id=7663 | speaker=aoko"
msgid "　このたび、貴方は私たちの監視下に置かれることになりました。しばらくはここで一緒に暮らしてもらいます。"
msgstr "  As of now, you're being placed under our supervision. You will be living here, together with us, for the time being."

#. Occurrence 6_4:1515:7664: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0026; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1515
msgctxt "text_id=7664 | speaker=aoko"
msgid "　もちろん、生殺与奪の権利はこちらにあるという条件で」"
msgstr "  Naturally, I reserve the right to decide whether you live or die.\""

#. Occurrence 6_4:1565:7665: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0019; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1565
msgctxt "text_id=7665 | speaker=soujuurou"
msgid "「なっ……！」"
msgstr "\"Wha...?\""

#. Occurrence 6_4:1571:7666: scene=6_4
#: 6_4:1571
msgctxt "text_id=7666 | speaker=unknown"
msgid "　あまりの<横暴|おうぼう>さに吹き出しかける草十郎。"
msgstr "  The blatant tyranny in her voice caused him to sputter."

#. Occurrence 6_4:1607:7667: scene=6_4
#: 6_4:1607
msgctxt "text_id=7667 | speaker=unknown"
msgid "　笑顔で言えば傍若無人が通ると思うのもやめてほしい。"
msgstr "  He wished that she would stop smiling in an attempt to make it seem any less outrageous."

#. Occurrence 6_4:1644:7668: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0020; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1644
msgctxt "text_id=7668 | speaker=soujuurou"
msgid "「い、一緒に住むって蒼崎とか！？」"
msgstr "\"L-Live together? ...With you?!\""

#. Occurrence 6_4:1650:7669: scene=6_4
#: 6_4:1650
msgctxt "text_id=7669 | speaker=unknown"
msgid "　あわてているのは青子と一つ屋根の下で暮らす事に淡い期待を持ってのこと―――"
msgstr "  It was not the faint expectation of living under the same roof with Aoko that had him flustered."

#. Occurrence 6_4:1655:7670: scene=6_4
#: 6_4:1655
msgctxt "text_id=7670 | speaker=unknown"
msgid "　では当然なく、"
msgstr "  Rather..."

#. Occurrence 6_4:1675:7671: scene=6_4
#: 6_4:1675
msgctxt "text_id=7671 | speaker=unknown"
msgid "　純粋に、己が身を案じてだ。"
msgstr "  He was genuinely concerned about his own safety."

#. Occurrence 6_4:1695:7672: scene=6_4
#: 6_4:1695
msgctxt "text_id=7672 | speaker=unknown"
msgid "　いかに彼がお人好しでも、一度殺されかけた事実はきちんと受けとめていたらしい。"
msgstr "  Regardless of how good-natured he was, it seemed he finally had come to grips with the fact that he just escaped death."

#. Occurrence 6_4:1729:7673: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0021; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1729
msgctxt "text_id=7673 | speaker=soujuurou"
msgid "「とんでもない！"
msgstr "\"You can't be serious!"

#. Occurrence 6_4:1729:7674: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0021; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1729
msgctxt "text_id=7674 | speaker=soujuurou"
msgid "　冬眠前の熊と、一緒に<暖|だん>を取るようなもんだ！」"
msgstr "  That's like seeking warmth next to a bear before it goes into hibernation!\""

#. Occurrence 6_4:1747:7675: scene=6_4
#: 6_4:1747
msgctxt "text_id=7675 | speaker=unknown"
msgid "　失礼な感想に、青子はそうね、と平然と答える。"
msgstr "  Aoko agreed, as blunt a comparison as it was."

#. Occurrence 6_4:1774:7676: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0027; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1774
msgctxt "text_id=7676 | speaker=aoko"
msgid "「たまには的確な<比|ひ><喩|ゆ>をするじゃない。"
msgstr "\"Once in a while you have some pretty accurate metaphors, you know?"

#. Occurrence 6_4:1780:7677: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0028; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1780
msgctxt "text_id=7677 | speaker=aoko"
msgid "　貴方の言う通り、下手なコトをしたり決まりを破ったりしたら今度こそ息の根止めるからね。"
msgstr "  But I'm glad you figured it out. Make a wrong move or break a rule and I'll end you, for real this time."

#. Occurrence 6_4:1793:7678: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0029; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1793
msgctxt "text_id=7678 | speaker=aoko"
msgid "　それと、ここに住んでるのは私と有珠のふたりだけよ。"
msgstr "  Plus, it's just me and Alice you'll be living with."

#. Occurrence 6_4:1799:7679: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0030; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:1799
msgctxt "text_id=7679 | speaker=aoko"
msgid "　あの子、私なんかより数倍常識ないから。気をつけないと死んじゃうぞ」"
msgstr "  She has way less common sense than I do, so if you're not careful, you'll wind up dead by her hands, too.\""

#. Occurrence 6_4:1838:7680: scene=6_4
#: 6_4:1838
msgctxt "text_id=7680 | speaker=unknown"
msgid "　青子は１００パーセント本気である。"
msgstr "  Aoko was one hundred percent serious."

#. Occurrence 6_4:1843:7681: scene=6_4
#: 6_4:1843
msgctxt "text_id=7681 | speaker=unknown"
msgid "　<嘘|うそ><偽|いつわ>りない発言こそ誠意と言わんばかりだ。"
msgstr "  It was her sincerity that made it all the more believable."

#. Occurrence 6_4:1877:7682: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0022; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1877
msgctxt "text_id=7682 | speaker=soujuurou"
msgid "「いや、いやいやいや！」"
msgstr "\"No! No no no!\""

#. Occurrence 6_4:1882:7683: scene=6_4
#: 6_4:1882
msgctxt "text_id=7683 | speaker=unknown"
msgid "　無論、そんなんで被害者である草十郎が納得できる筈もない。"
msgstr "  Obviously, there was no way the victim, Soujyuro, could accept these terms."

#. Occurrence 6_4:1904:7684: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0023; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1904
msgctxt "text_id=7684 | speaker=soujuurou"
msgid "「待ってくれ、俺にはちっとも蒼崎が分からない！"
msgstr "\"Wait a minute. You're not making any sense, Aozaki!"

#. Occurrence 6_4:1911:7685: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0024_0; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1911
msgctxt "text_id=7685 | speaker=soujuurou"
msgid "　監視するって言うけど、なんでそんな話になってるんだ？　考えられる範囲、悪いコトとかしてないし、そもそも俺を見張っても得なコトなんていっこもないし！　"
msgstr "  You say I'm under your supervision, but why is that necessary? If you think about it, I haven't even done anything wrong, so there's really no point in keeping an eye on me!  "

#. Occurrence 6_4:1920:7686: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0024_1; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1920
msgctxt "text_id=7686 | speaker=soujuurou"
msgid "蒼崎は色々まちがってる！」"
msgstr "This has to be a misunderstanding!\""

#. Occurrence 6_4:1963:7687: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0025; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:1963
msgctxt "text_id=7687 | speaker=soujuurou"
msgid "「―――む。いや、それとも魔術師っていうのは、みんな蒼崎みたいなのか？」"
msgstr "\"...Is it... Are all mages like you, Aozaki?\""

#. Occurrence 6_4:1989:7688: scene=6_4
#: 6_4:1989
msgctxt "text_id=7688 | speaker=unknown"
msgid "　ぼうじゃくとかぶじんなのか？　と心底困った視線を向けてくる人畜無害。"
msgstr "  Arrogant and selfish...were the words that the harmless boy's gaze seemed to imply."

#. Occurrence 6_4:1994:7689: scene=6_4
#: 6_4:1994
msgctxt "text_id=7689 | speaker=unknown"
msgid "　……青子からすれば頭痛のタネもいいところだ。"
msgstr "  Aoko felt a headache coming on."

#. Occurrence 6_4:2016:7690: scene=6_4
#: 6_4:2016
msgctxt "text_id=7690 | speaker=unknown"
msgid "　素直すぎるのも考えもので、この通り、草十郎は青子が魔術師であることを異常だと思っていないのである。"
msgstr "  Due to his innate easygoing persona, Soujyuro had not thought to question that Aoko being a mage was out of the ordinary."

#. Occurrence 6_4:2065:7691: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0031; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2065
msgctxt "text_id=7691 | speaker=aoko"
msgid "「だ、か、らっ！　アンタが、そういう風に、誰はばかることなく私たちの事を言い触らさないかを見張ってんじゃない、この常識なしッ！」"
msgstr "\"That's the problem! We need to keep an eye on you so you don't go around saying things like that and blow our cover, you dunce!\""

#. Occurrence 6_4:2071:7692: scene=6_4
#: 6_4:2071
msgctxt "text_id=7692 | speaker=unknown"
msgid "　青子は勢いあまって椅子から立ち上がった。"
msgstr "  Aoko flew out of her chair."

#. Occurrence 6_4:2076:7693: scene=6_4
#: 6_4:2076
msgctxt "text_id=7693 | speaker=unknown"
msgid "　先ほどから我慢してきた青子の堪忍袋の緒はすっぱりさっぱり、気分よく断ち切れたらしい。"
msgstr "  She had been doing her best to keep her cool, but it seemed her well of patience had finally run dry."

#. Occurrence 6_4:2081:7694: scene=6_4
#: 6_4:2081
msgctxt "text_id=7694 | speaker=unknown"
msgid "　そんな青子を見て、ぽん、と草十郎は両手を合わせる。"
msgstr "  Witnessing Aoko snap, Soujyuro clapped his hands together."

#. Occurrence 6_4:2116:7695: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0026; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2116
msgctxt "text_id=7695 | speaker=soujuurou"
msgid "「そうか。蒼崎が俺を殺そうとしたのは、魔術師であることを隠さなくちゃいけないからだったっけ。"
msgstr "\"Oh now I get it. The reason you tried to kill me was because you have to hide the fact that you're a mage."

#. Occurrence 6_4:2129:7696: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0027; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2129
msgctxt "text_id=7696 | speaker=soujuurou"
msgid "　うん、それなら分かる。監視するのは蒼崎の秘密のコトで、俺の命云々はオマケみたいなものか」"
msgstr "  Okay, if that's the case then I get it. You're monitoring me to protect your secret, and not taking my life is your way of throwing me a bone.\""

#. Occurrence 6_4:2149:7697: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0032; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2149
msgctxt "text_id=7697 | speaker=aoko"
msgid "「…………。そりゃあ本質的に言えば、そうだけど。"
msgstr "\"...I mean, those aren't the words I would use, but sure."

#. Occurrence 6_4:2149:7698: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0032; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2149
msgctxt "text_id=7698 | speaker=aoko"
msgid "　身もフタもないわね、その言い方」"
msgstr "  It sounds a bit harsh when you put it that way.\""

#. Occurrence 6_4:2180:7699: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0028; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2180
msgctxt "text_id=7699 | speaker=soujuurou"
msgid "「けど、それはあまり意味がないんじゃないか？"
msgstr "\"But, isn't this all a little unrealistic?"

#. Occurrence 6_4:2186:7700: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0029; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2186
msgctxt "text_id=7700 | speaker=soujuurou"
msgid "　学校もあるし、バイトだってあるんだ。一日中、この家から出ないワケにはいかないんだぞ」"
msgstr "  I have school and work to go to. I can't stay locked up inside this house all day.\""

#. Occurrence 6_4:2233:7701: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0033; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2233
msgctxt "text_id=7701 | speaker=aoko"
msgid "「……………………」"
msgstr "\"...\""

#. Occurrence 6_4:2238:7702: scene=6_4
#: 6_4:2238
msgctxt "text_id=7702 | speaker=unknown"
msgid "　自分を客観視できる草十郎に感心したのも一瞬、あまりの返答に絶句する青子だった。"
msgstr "  In an instant, Soujyuro's objectivity had her stumped, leaving her at a loss for words."

#. Occurrence 6_4:2243:7703: scene=6_4
#: 6_4:2243
msgctxt "text_id=7703 | speaker=unknown"
msgid "　ほんとーに、この男は自分の立場というものが分かっていない。"
msgstr "  He honestly had no idea what position he was in."

#. Occurrence 6_4:2248:7704: scene=6_4
#: 6_4:2248
msgctxt "text_id=7704 | speaker=unknown"
msgid "　ここまでの話の流れで、そんな自由があると思っているあたり大物ではあるが。"
msgstr "  To believe that he had any sort of freedom at this point was shocking, to say the least."

#. Occurrence 6_4:2275:7705: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0034; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2275
msgctxt "text_id=7705 | speaker=aoko"
msgid "「……いや、落ち着け私。話が早くなってある意味助かるし」"
msgstr "\"...Just breathe, Aoko. If anything, this will speed things along.\""

#. Occurrence 6_4:2281:7706: scene=6_4
#: 6_4:2281
msgctxt "text_id=7706 | speaker=unknown"
msgid "　なんとか体裁を整える青子。"
msgstr "  Aoko somehow managed to compose herself."

#. Occurrence 6_4:2286:7707: scene=6_4
#: 6_4:2286
msgctxt "text_id=7707 | speaker=unknown"
msgid "　実のところ、青子も監獄じみた拘束をする気はない。"
msgstr "  As a matter of fact, she never had any intention of imprisoning him."

#. Occurrence 6_4:2291:7708: scene=6_4
#: 6_4:2291
msgctxt "text_id=7708 | speaker=unknown"
msgid "　あらゆる自由を禁じ屋敷に閉じこめる、なんて方法では草十郎との約束に反してしまう。"
msgstr "  Stripping him of his freedom and incarcerating him would go against their agreement, anyway."

#. Occurrence 6_4:2296:7709: scene=6_4
#: 6_4:2296
msgctxt "text_id=7709 | speaker=unknown"
msgid "　第一、そこまでするなら亡き者にしたほうが早い。"
msgstr "  Besides, if she was going to go that far it would be easier to just kill him."

#. Occurrence 6_4:2301:7710: scene=6_4
#: 6_4:2301
msgctxt "text_id=7710 | speaker=unknown"
msgid "　青子にとって『生かす』という事は、静希草十郎という人間の生活を最低限尊重する事である。"
msgstr "  To Aoko, letting him live meant showing a modicum of respect to Soujyuro's way of life."

#. Occurrence 6_4:2338:7711: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0030; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2338
msgctxt "text_id=7711 | speaker=soujuurou"
msgid "「あ。……も、もしかして、この部屋から出ちゃいけないのか、俺！？」"
msgstr "\"You're not saying... W-Wait, don't tell me I can't even leave this room?!\""

#. Occurrence 6_4:2356:7712: scene=6_4
#: 6_4:2356
msgctxt "text_id=7712 | speaker=unknown"
msgid "　ピコーン、と音が鳴りかねない顔で、思いつきを口にする草十郎。"
msgstr "  A light bulb went on in his head as he blurted out what he was thinking."

#. Occurrence 6_4:2361:7713: scene=6_4
#: 6_4:2361
msgctxt "text_id=7713 | speaker=unknown"
msgid "　悪い方向での想像にようやく行き着いてくれたらしい。"
msgstr "  It appeared he had finally got the grim message."

#. Occurrence 6_4:2366:7714: scene=6_4
#: 6_4:2366
msgctxt "text_id=7714 | speaker=unknown"
msgid "　そんな狼狽ぶりに、少しだけ<溜飲|りゅういん>をさげる青子だった。"
msgstr "  Aoko looked somewhat satisfied at his dismay."

#. Occurrence 6_4:2411:7715: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0035; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2411
msgctxt "text_id=7715 | speaker=aoko"
msgid "「大丈夫よ。監禁生活なんて面倒なコトだけはしないから。"
msgstr "\"Relax. Locking you up would actually be more trouble than it's worth."

#. Occurrence 6_4:2417:7716: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0036; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2417
msgctxt "text_id=7716 | speaker=aoko"
msgid "　貴方の自由はそれなりに考慮してあります。そのあたりのさじ加減は有珠の手腕に任せてあるから、貴方は心配しなくていいわ」"
msgstr "  Your freedom was taken into consideration. To what degree you are free will be left to the discretion of Alice and her abilities, so you won't have to worry about that.\""

#. Occurrence 6_4:2423:7717: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0031; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2423
msgctxt "text_id=7717 | speaker=soujuurou"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 6_4:2428:7718: scene=6_4
#: 6_4:2428
msgctxt "text_id=7718 | speaker=unknown"
msgid "　草十郎は無言で、それはよけいに心配なのでは、と顔を曇らせた。"
msgstr "  A gloomy look fell over Soujyuro's face, as he found his concern growing by the second."

#. Occurrence 6_4:2455:7719: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0037; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2455
msgctxt "text_id=7719 | speaker=aoko"
msgid "「いい？　貴方の処遇は、この家に住むコトを前提にした監視で、それも解決策が見つかるまでの期間限定。"
msgstr "\"All right, look. Sparing your life is based on the premise that you will live in this house under supervision, and that's only until a more permanent solution is found."

#. Occurrence 6_4:2461:7720: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0038; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2461
msgctxt "text_id=7720 | speaker=aoko"
msgid "　何でもいいから目撃者を殺す、なんて事より、こっちの方がよっぽど穏便でしょ。"
msgstr "  It's a lot more amicable than just disposing of the witness, don't you think?"

#. Occurrence 6_4:2474:7721: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0039; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2474
msgctxt "text_id=7721 | speaker=aoko"
msgid "　……だいたい、これは私と貴方との約束なんだから、いちいち文句言わないでよね。ただでさえ有珠との冷戦が続いてて頭痛いんだから」"
msgstr "  ...At any rate, this is my way of keeping our promise, so no complaining. This cold war I'm waging with Alice is enough of a headache, already.\""

#. Occurrence 6_4:2479:7722: scene=6_4
#: 6_4:2479
msgctxt "text_id=7722 | speaker=unknown"
msgid "　ため息まじりに言いつつ、青子はベッドの上の草十郎をキッと睨みつける。"
msgstr "  She sighed as she stared Soujyuro down as he lay on the bed."

#. Occurrence 6_4:2523:7723: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0040; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2523
msgctxt "text_id=7723 | speaker=aoko"
msgid "「けど勘違いはしないで。"
msgstr "\"But make no mistake."

#. Occurrence 6_4:2529:7724: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0041; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2529
msgctxt "text_id=7724 | speaker=aoko"
msgid "　ここじゃアンタの地位は最下層のさらに下、番犬より下なんだから。アンタの生殺与奪はあの夜から私が握ってるんだから、アンタは私に所有されてるようなもんなの。"
msgstr "  Your status here is the lowest of the low, even lower than a dog's. Since that night, I'm the one to decide whether you live or die, which means you belong to me now."

#. Occurrence 6_4:2535:7725: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0042; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2535
msgctxt "text_id=7725 | speaker=aoko"
msgid "　さ、これで自分の立場、<判|わか>った？」"
msgstr "  Is that clear enough for you?\""

#. Occurrence 6_4:2605:7726: scene=6_4
#: 6_4:2605
msgctxt "text_id=7726 | speaker=unknown"
msgid "　<大|おお><威|い><張|ば>りでそう言われて、青子に気付かれないよう、草十郎は天を仰いだ。"
msgstr "  As Aoko finished her declaration, Soujyuro subtly looked up at the ceiling so she would not notice his reaction."

#. Occurrence 6_4:2610:7727: scene=6_4
#: 6_4:2610
msgctxt "text_id=7727 | speaker=unknown"
msgid "　青子には申し訳ないが、ちっともぜんぜん判らない。"
msgstr "  He meant no offense to Aoko, but he had to hide the fact that he fundamentally disagreed with her analogy."

#. Occurrence 6_4:2615:7728: scene=6_4
#: 6_4:2615
msgctxt "text_id=7728 | speaker=unknown"
msgid "　個人的な感想と言えば、犬より簡単と言われて怒らないのは人間としても、お犬さまにも礼を欠くと思うのだが、自分と彼女の戦力差は兎と猪ほどもあるので反論もできない。"
msgstr "  In Soujyuro's opinion, it was disrespectful to both dogs and humans to call him lower than a dog. A more accurate analogy of their power dynamic would be that of a rabbit and a wild boar, hence why he chose not to voice this opinion."

#. Occurrence 6_4:2662:7729: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0032; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2662
msgctxt "text_id=7729 | speaker=soujuurou"
msgid "「……………………はあ」"
msgstr "\"...Haa.\""

#. Occurrence 6_4:2668:7730: scene=6_4
#: 6_4:2668
msgctxt "text_id=7730 | speaker=unknown"
msgid "　見上げた天井は、自分の安アパートとは違って豪奢な紋様があしらわれている。"
msgstr "  Unlike his apartment, the ceiling here was decorated with ornate patterns."

#. Occurrence 6_4:2673:7731: scene=6_4
#: 6_4:2673
msgctxt "text_id=7731 | speaker=unknown"
msgid "　……自分の扱いはともかく、建物に関しては文句なしにグレードが上がっている。"
msgstr "  Putting aside how he would be treated here, in terms of lodging, it was a definite upgrade."

#. Occurrence 6_4:2686:7732: scene=6_4
#: 6_4:2686
msgctxt "text_id=7732 | speaker=unknown"
msgid "　つまり、悪いことだけじゃないだろう、と。"
msgstr "  Maybe it would not be all that bad."

#. Occurrence 6_4:2691:7733: scene=6_4
#: 6_4:2691
msgctxt "text_id=7733 | speaker=unknown"
msgid "　自分に言い聞かせるように、草十郎はうんうんと頷いた。"
msgstr "  Soujyuro nodded slowly, as if to persuade himself."

#. Occurrence 6_4:2696:7734: scene=6_4
#: 6_4:2696
msgctxt "text_id=7734 | speaker=unknown"
msgid "　それに―――"
msgstr "  And..."

#. Occurrence 6_4:2760:7735: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0043; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2760
msgctxt "text_id=7735 | speaker=aoko"
msgid "“とりあえず、命は助けてあげるから”"
msgstr "\"For the time being, I've decided to let you live.\""

#. Occurrence 6_4:2767:7736: scene=6_4
#: 6_4:2767
msgctxt "text_id=7736 | speaker=unknown"
msgid "　あの時。"
msgstr "  That is what she had told him."

msgctxt "text_id=7737 | speaker=unknown"
msgid "彼女は確かにそう言ったのだ。"
msgstr " Not two days ago."

#. Occurrence 6_4:2818:7738: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0033; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2818
msgctxt "text_id=7738 | speaker=soujuurou"
msgid "「あまり納得したくないけど、自分の立場は分かったよ。"
msgstr "\"While I don't really accept what you're saying, I understand my position."

#. Occurrence 6_4:2818:7739: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0033; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2818
msgctxt "text_id=7739 | speaker=soujuurou"
msgid "　うん、たしかにそんな約束だった。色々と言いたい事はあるけど、それは認めるしかない。"
msgstr "  I remember what you promised me now. There are lots of things I could disagree with, but I admit you did promise me at least that."

#. Occurrence 6_4:2824:7740: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0034; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2824
msgctxt "text_id=7740 | speaker=soujuurou"
msgid "　だけど、君たちと一緒に住めっていうのは本気なのか？"
msgstr "  Are you really serious about me living with the two of you?"

#. Occurrence 6_4:2824:7741: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0034; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2824
msgctxt "text_id=7741 | speaker=soujuurou"
msgid "　蒼崎は細かいコトは気にしないとしても、さっきの娘は嫌がりそうだし、俺だって少しは……」"
msgstr "  I know you're pretty easygoing, but that girl seems pretty against it, and I'm not exactly―\""

#. Occurrence 6_4:2829:7742: scene=6_4
#: 6_4:2829
msgctxt "text_id=7742 | speaker=unknown"
msgid "　そこで、草十郎はぴたりと黙りこんだ。"
msgstr "  At that point, he zipped his lips."

#. Occurrence 6_4:2845:7743: scene=6_4
#: 6_4:2845
msgctxt "text_id=7743 | speaker=unknown"
msgid "　青子の目がひどく殺気を帯びて見えたからだ。"
msgstr "  Aoko's eyes were tinged with bloodlust."

#. Occurrence 6_4:2872:7744: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0044; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:2872
msgctxt "text_id=7744 | speaker=aoko"
msgid "「あら、静希君はご不満？」"
msgstr "\"Oh. Please excuse me. I'm sorry to hear that you're dissatisfied with the arrangement.\""

#. Occurrence 6_4:2891:7745: scene=6_4
#: 6_4:2891
msgctxt "text_id=7745 | speaker=unknown"
msgid "　無理に笑ってるとしか思えない彼女の口元に、草十郎は絶望を見た気がした。"
msgstr "  Her contrived smile, so obviously forced, struck despair into Soujyuro's heart."

#. Occurrence 6_4:2896:7746: scene=6_4
#: 6_4:2896
msgctxt "text_id=7746 | speaker=unknown"
msgid "　そういえば、さっき同じ事は何度も言わせるなと忠告された気がする。"
msgstr "  Come to think of it, he vaguely recalled her warning to him to not make her repeat herself."

#. Occurrence 6_4:2935:7747: scene=6_4
#: 6_4:2935
msgctxt "text_id=7747 | speaker=unknown"
msgid "　さらにさらに。"
msgstr "  Furthermore..."

#. Occurrence 6_4:2940:7748: scene=6_4
#: 6_4:2940
msgctxt "text_id=7748 | speaker=unknown"
msgid "　実際問題として、どんなに実感が湧かないとしても、静希草十郎の命は蒼崎青子に握られている。"
msgstr "  As a practical matter, Soujyuro Sizuki's life was now in the hands of Aoko Aozaki."

#. Occurrence 6_4:2945:7749: scene=6_4
#: 6_4:2945
msgctxt "text_id=7749 | speaker=unknown"
msgid "　怒らせるのは<賢|かしこ>くない、と他人事のように頷く草十郎なのだった。"
msgstr "  It would be unwise to anger her further, he told himself as if speaking to a third person."

#. Occurrence 6_4:2973:7750: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0035; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:2973
msgctxt "text_id=7750 | speaker=soujuurou"
msgid "「……いや、別に。だってそれ以外ないんだろう？」"
msgstr "\"N-Not at all. I mean, what choice do I have anyway?\""

#. Occurrence 6_4:2979:7751: scene=6_4
#: 6_4:2979
msgctxt "text_id=7751 | speaker=unknown"
msgid "　当然、と頷く青子と、"
msgstr "  \"None,\" Aoko said with a firm nod of her head."

#. Occurrence 6_4:2984:7752: scene=6_4
#: 6_4:2984
msgctxt "text_id=7752 | speaker=unknown"
msgid "　降伏するようにがっくりと肩を落とす草十郎。"
msgstr "  Soujyuro slumped his shoulders in surrender."

#. Occurrence 6_4:3033:7753: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0036; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3033
msgctxt "text_id=7753 | speaker=soujuurou"
msgid "「……うん、蒼崎の言い分は分かった。"
msgstr "\"All right. I understand you now, Aozaki."

#. Occurrence 6_4:3039:7754: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0037; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3039
msgctxt "text_id=7754 | speaker=soujuurou"
msgid "　ただ、いちおう聞いておきたいんだけど。俺の人権はどこにいってしまったんだろう？」"
msgstr "  Just, let me ask you this one thing. Do I have any human rights?\""

#. Occurrence 6_4:3066:7755: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0045; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3066
msgctxt "text_id=7755 | speaker=aoko"
msgid "「莫迦ね、そんな形のない物なんて初めからあるワケないでしょ。つまんないこと言わないでよ」"
msgstr "\"Poor little Sizuki. You never had any in the first place. Now, stop wasting my time with stupid questions.\""

#. Occurrence 6_4:3072:7756: scene=6_4
#: 6_4:3072
msgctxt "text_id=7756 | speaker=unknown"
msgid "　……うん、たしかに今のはつまらない事だった、と草十郎は噛みしめる。"
msgstr "  Soujyuro reflected upon her answer, now feeling like his question was, indeed, stupid."

#. Occurrence 6_4:3077:7757: scene=6_4
#: 6_4:3077
msgctxt "text_id=7757 | speaker=unknown"
msgid "　そもそも彼にしてみれば、いまの青子の答えは分かりきっていた事だ。"
msgstr "  He should have already known the answer before he asked."

#. Occurrence 6_4:3138:7758: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0038; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3138
msgctxt "text_id=7758 | speaker=soujuurou"
msgid "「……ああ、だと思った。"
msgstr "\"That's...what I thought."

#. Occurrence 6_4:3138:7759: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0038; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3138
msgctxt "text_id=7759 | speaker=soujuurou"
msgid "　そんな気はしてたんだ、目が覚める前から」"
msgstr "  I had a feeling this was going to happen, even before waking up.\""

#. Occurrence 6_4:3151:7760: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0046; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3151
msgctxt "text_id=7760 | speaker=aoko"
msgid "「？」"
msgstr "\"?\""

#. Occurrence 6_4:3157:7761: scene=6_4
#: 6_4:3157
msgctxt "text_id=7761 | speaker=unknown"
msgid "　草十郎の独白に青子は不審げな目を向けたが、すぐに気を取り直した。"
msgstr "  His muttering provoked a dubious stare from Aoko, before she quickly retracted it."

#. Occurrence 6_4:3162:7762: scene=6_4
#: 6_4:3162
msgctxt "text_id=7762 | speaker=unknown"
msgid "　この男の発言をいちいち気にしていたら日が暮れてしまう、と骨身に染みているからだろう。"
msgstr "  If she questioned every little thing he said, they would be there until sundown."

#. Occurrence 6_4:3190:7763: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0047; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3190
msgctxt "text_id=7763 | speaker=aoko"
msgid "「とにかく納得いったみたいね。"
msgstr "\"Well, as long as you understand."

#. Occurrence 6_4:3196:7764: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0048; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3196
msgctxt "text_id=7764 | speaker=aoko"
msgid "　じゃあ次、いよいよ本題。居間に移動するわよ。"
msgstr "  Now, we need to get down to brass tacks. Let's move to the drawing room."

#. Occurrence 6_4:3196:7765: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0048; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3196
msgctxt "text_id=7765 | speaker=aoko"
msgid "　説明しなくちゃいけない事が山ほどあるんだから。"
msgstr "  I have a ton of explaining to do."

#. Occurrence 6_4:3223:7766: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0049; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3223
msgctxt "text_id=7766 | speaker=aoko"
msgid "　―――って、ひとりで立てる？」"
msgstr "  Can you stand on your own?\""

#. Occurrence 6_4:3236:7767: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0039; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3236
msgctxt "text_id=7767 | speaker=soujuurou"
msgid "「さっきから手を動かしてたから、血は巡ってる。"
msgstr "\"I was able to move my hands earlier, so blood is at least flowing."

#. Occurrence 6_4:3236:7768: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0039; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3236
msgctxt "text_id=7768 | speaker=soujuurou"
msgid "　歩くぐらいならいけそうだ」"
msgstr "  I should be able to walk.\""

#. Occurrence 6_4:3273:7769: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0050; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3273
msgctxt "text_id=7769 | speaker=aoko"
msgid "「そ。なら問題ないわね」"
msgstr "\"Good. You'll be fine then.\""

#. Occurrence 6_4:3304:7770: scene=6_4
#: 6_4:3304
msgctxt "text_id=7770 | speaker=unknown"
msgid "　言うなり、彼女はくるりと草十郎に背を向けて歩きだした。"
msgstr "  With that, she turned her back and walked away from him."

#. Occurrence 6_4:3309:7771: scene=6_4
#: 6_4:3309
msgctxt "text_id=7771 | speaker=unknown"
msgid "　その背中は、もう何度と見てきた颯爽とした後ろ姿だ。"
msgstr "  He had seen this bold form of hers many times before."

#. Occurrence 6_4:3352:7772: scene=6_4
#: 6_4:3352
msgctxt "text_id=7772 | speaker=unknown"
msgid "　瞬間、落雷のように記憶が巻き戻される。"
msgstr "  Instantly, the memories flashed back to him like lightning."

#. Occurrence 6_4:3401:7773: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0040; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3401
msgctxt "text_id=7773 | speaker=soujuurou"
msgid "『……そうだった。蒼崎は、こういうヤツだった』"
msgstr "(I remember now. This is the Aozaki I know.)"

#. Occurrence 6_4:3407:7774: scene=6_4
#: 6_4:3407
msgctxt "text_id=7774 | speaker=unknown"
msgid "　知らず、頬がほころぶ。"
msgstr "  Without knowing it, he cracked a smile."

#. Occurrence 6_4:3412:7775: scene=6_4
#: 6_4:3412
msgctxt "text_id=7775 | speaker=unknown"
msgid "　草十郎にとっては右も左も分からない状況だったけれど、それだけで彼は充分に落ち着けた。"
msgstr "  He was so lost that he did not know his left from his right, but recalling this alone was enough to calm him."

#. Occurrence 6_4:3451:7776: scene=6_4
#: 6_4:3451
msgctxt "text_id=7776 | speaker=unknown"
msgid "　……今の青子は、ミラーハウスでの彼女とは違う。"
msgstr "  The Aoko he knew was different from the one in the house of mirrors."

#. Occurrence 6_4:3456:7777: scene=6_4
#: 6_4:3456
msgctxt "text_id=7777 | speaker=unknown"
msgid "　あんな、無理やりに思い詰めた彼女ではない。"
msgstr "  She was not that brooding girl he saw there."

#. Occurrence 6_4:3461:7778: scene=6_4
#: 6_4:3461
msgctxt "text_id=7778 | speaker=unknown"
msgid "　きびきびとした動作もためらいのない視線も、なんだかひどく懐かしい。"
msgstr "  He felt a pang of nostalgia; the Aoko he knew was brisk in movement and unfaltering in gaze, just like this one."

#. Occurrence 6_4:3466:7779: scene=6_4
#: 6_4:3466
msgctxt "text_id=7779 | speaker=unknown"
msgid "　それは初めて会った時と同じ、不機嫌そうで、そのくせ自信に満ちた彼女本来のあり方だった。"
msgstr "  She was the same as when he first met her; moody, yet overflowing with confidence; in her element."

#. Occurrence 6_4:3528:7780: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0051; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3528
msgctxt "text_id=7780 | speaker=aoko"
msgid "「ほら、急いだ急いだ。"
msgstr "\"Let's go, let's go. Chop-chop."

#. Occurrence 6_4:3534:7781: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0052; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3534
msgctxt "text_id=7781 | speaker=aoko"
msgid "　有珠がさっきから居間でお待ちかねよ」"
msgstr "  Alice is waiting for us in the drawing room.\""

#. Occurrence 6_4:3540:7782: scene=6_4
#: 6_4:3540
msgctxt "text_id=7782 | speaker=unknown"
msgid "　彼女はとっくに扉から出て、薄ら寒そうな廊下に立っている。"
msgstr "  She was already outside the door, standing in the chilly corridor."

#. Occurrence 6_4:3574:7783: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0041; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3574
msgctxt "text_id=7783 | speaker=soujuurou"
msgid "「はあ。寝たきりの辛さを知らないだろう、蒼崎は」"
msgstr "\"Hngh... You must not know what it's like to be bedridden, Aozaki.\""

#. Occurrence 6_4:3594:7784: scene=6_4
#: 6_4:3594
msgctxt "text_id=7784 | speaker=unknown"
msgid "　ぼやきつつ、草十郎はなんとかベッドから起き上がった。"
msgstr "  Grunting and groaning, Soujyuro eventually got to his feet."

#. Occurrence 6_4:3640:7785: scene=6_4
#: 6_4:3640
msgctxt "text_id=7785 | speaker=unknown"
msgid "　横臥中だるかった体は、立ち上がって歩こうとすると逆に硬く痛む。"
msgstr "  His body, heavy and stiff while he was lying down, cried out in pain as he tried to stand and walk."

#. Occurrence 6_4:3645:7786: scene=6_4
#: 6_4:3645
msgctxt "text_id=7786 | speaker=unknown"
msgid "　一歩前に出るだけで骨に<痺|しび>れと痛みが響いた。"
msgstr "  Every step sent shooting pains through his bones."

#. Occurrence 6_4:3650:7787: scene=6_4
#: 6_4:3650
msgctxt "text_id=7787 | speaker=unknown"
msgid "　それでもしれっとした顔で青子へと歩きだす。"
msgstr "  Despite this, he put on a calm face and made his way toward Aoko."

#. Occurrence 6_4:3670:7788: scene=6_4
#: 6_4:3670
msgctxt "text_id=7788 | speaker=unknown"
msgid "　苦いもの、厳しいものは無意識に受け入れる草十郎だったが、今回にかぎっては意識的に受け流した。"
msgstr "  Typically, he was quick to not pay any mind to life's little struggles, but these pains... He needed to force himself to consciously ignore them."

#. Occurrence 6_4:3675:7789: scene=6_4
#: 6_4:3675
msgctxt "text_id=7789 | speaker=unknown"
msgid "　要するにやせ我慢だ。彼がこんなふうに、不自然に自分の気持ちを抑えこむのは珍しい。"
msgstr "  In other words, he was displaying false bravado. An uncharacteristic reaction for someone who never suppressed their true feelings."

#. Occurrence 6_4:3727:7790: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0053; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3727
msgctxt "text_id=7790 | speaker=aoko"
msgid "「驚いた。アンタ、ほんとにタフね」"
msgstr "\"Amazing. You really are tough, huh?\""

#. Occurrence 6_4:3733:7791: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0042; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3733
msgctxt "text_id=7791 | speaker=soujuurou"
msgid "「ありがとう。けど、心は弱いんだ」"
msgstr "\"Thanks. It's just my heart that's fragile.\""

#. Occurrence 6_4:3745:7792: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0054; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3745
msgctxt "text_id=7792 | speaker=aoko"
msgid "「そ。参考までに心に留めておくわ。出来るだけ優しく扱えるようにね」"
msgstr "\"Oh yeah? I'll keep that in mind and try not to hurt your precious feelings.\""

#. Occurrence 6_4:3750:7793: scene=6_4
#: 6_4:3750
msgctxt "text_id=7793 | speaker=unknown"
msgid "　もちろん、青子の声には優しさなど微塵もない。"
msgstr "  Naturally, her voice was devoid of any true empathy."

#. Occurrence 6_4:3755:7794: scene=6_4
#: 6_4:3755
msgctxt "text_id=7794 | speaker=unknown"
msgid "　がっくりとする草十郎をよそに、青子はスタスタと廊下を歩きはじめる。"
msgstr "  She turned away from the once-more dejected Soujyuro, and began walking briskly down the corridor."

#. Occurrence 6_4:3794:7795: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0055; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3794
msgctxt "text_id=7795 | speaker=aoko"
msgid "「―――、と」"
msgstr "\"...Oh, and...\""

#. Occurrence 6_4:3799:7796: scene=6_4
#: 6_4:3799
msgctxt "text_id=7796 | speaker=unknown"
msgid "　その時、何かを思い立ったように彼女はピタリと足を止めて振り向いた。"
msgstr "  Just then, she stopped, feet snapped together, as though something had popped into her head."

#. Occurrence 6_4:3804:7797: scene=6_4
#: 6_4:3804
msgctxt "text_id=7797 | speaker=unknown"
msgid "　言い忘れていた事、それでいて何でもない事を告げるように、"
msgstr "  And just as if she was remembering something she had forgotten, in a completely trivial way..."

#. Occurrence 6_4:3858:7798: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_4_0056; voice_prefix=A10; voice_category=1; scene=6_4
#: 6_4:3858
msgctxt "text_id=7798 | speaker=aoko"
msgid "「それじゃ行くわよ。付いてきて、草十郎」"
msgstr "\"Follow me, Soujyuro.\""

#. Occurrence 6_4:3864:7799: scene=6_4
#: 6_4:3864
msgctxt "text_id=7799 | speaker=unknown"
msgid "　颯爽と振り向いて、彼女は自然にそう言った。"
msgstr "  She gallantly turned back the way she was heading, the words sounding so natural as she spoke them."

#. Occurrence 6_4:3917:7800: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_4_0043; voice_prefix=A30; voice_category=3; scene=6_4
#: 6_4:3917
msgctxt "text_id=7800 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 6_4:3924:7801: scene=6_4
#: 6_4:3924
msgctxt "text_id=7801 | speaker=unknown"
msgid "　その時に開かれた視界を、彼女は知らない。"
msgstr "  Aoko did not see the look in Soujyuro's eyes as he heard her words."

#. Occurrence 6_4:3929:7802: scene=6_4
#: 6_4:3929
msgctxt "text_id=7802 | speaker=unknown"
msgid "　彼女が魔法使いだと言うのなら、この言葉こそ魔法だったことを、口にした当人だけが知らずじまい。"
msgstr "  For though she worked in the arcane, the spell Aoko had woven was apparent to everyone but her."

#. Occurrence 6_4:3934:7803: scene=6_4
#: 6_4:3934
msgctxt "text_id=7803 | speaker=unknown"
msgid "　彼は眩しいものを見たようにまばたきをした後、自然に頷いて、その背中を追いかけた。"
msgstr "  After blinking his eyes as if blinded by something, Soujyuro casually nodded, and followed behind her."

#. Occurrence 6_5:49:7804: scene=6_5
#: 6_5:49
msgctxt "text_id=7804 | speaker=unknown"
msgid "　館の広さはかなりのものだった。"
msgstr "  The sheer size of the interior was daunting."

#. Occurrence 6_5:54:7805: scene=6_5
#: 6_5:54
msgctxt "text_id=7805 | speaker=unknown"
msgid "　三階建ての洋館は、部屋の数でも草十郎の住むアパートを上回っている。"
msgstr "  The three floors of this mansion contained more rooms than Soujyuro's entire apartment building."

#. Occurrence 6_5:59:7806: scene=6_5
#: 6_5:59
msgctxt "text_id=7806 | speaker=unknown"
msgid "　ただ、その広さは持てあまし気味だ。"
msgstr "  Except, their size was excessive."

#. Occurrence 6_5:64:7807: scene=6_5
#: 6_5:64
msgctxt "text_id=7807 | speaker=unknown"
msgid "　部屋数と住人の比率は合っていない。絨毯張りの廊下は、その豪華さとは裏腹に寒々しかった。"
msgstr "  Here, the mansion's rooms seemed too numerous for so few inhabitants; its lavish carpeted halls cold and dreary."

#. Occurrence 6_5:84:7808: scene=6_5
#: 6_5:84
msgctxt "text_id=7808 | speaker=unknown"
msgid "　草十郎が眠っていた客室は二階の東側にあった。"
msgstr "  The guest room that Soujyuro had been sleeping in was on the second floor of the east wing."

#. Occurrence 6_5:89:7809: scene=6_5
#: 6_5:89
msgctxt "text_id=7809 | speaker=unknown"
msgid "　一階に下りる階段はこの廊下の先、館の中央にあるらしい。"
msgstr "  A staircase leading down to the first floor was at the end of the corridor, at the center of the mansion."

#. Occurrence 6_5:94:7810: scene=6_5
#: 6_5:94
msgctxt "text_id=7810 | speaker=unknown"
msgid "　窓から差しこむ冬の日射しが、廃墟じみた廊下をいっそう寂しく見せている。"
msgstr "  Winter sunlight beamed through the windows, which only made the empty corridor appear even lonelier."

#. Occurrence 6_5:146:7811: scene=6_5
#: 6_5:146
msgctxt "text_id=7811 | speaker=unknown"
msgid "　館の中央部は吹き抜けになっていて、そのまま一階の様子が見下ろせた。"
msgstr "  The center of the mansion was topped by a vaulted skylight overlooking the first floor."

#. Occurrence 6_5:151:7812: scene=6_5
#: 6_5:151
msgctxt "text_id=7812 | speaker=unknown"
msgid "　階段は壁に<沿|そ>って造られている。"
msgstr "  The staircase, connecting the first and second floors, lined its walls."

#. Occurrence 6_5:156:7813: scene=6_5
#: 6_5:156
msgctxt "text_id=7813 | speaker=unknown"
msgid "　一階と二階を繋ぐ階段の他に、二階のホール裏には三階への階段もある。おそらく屋根裏に倉庫でもあるのだろう。"
msgstr "  Another staircase at the other end of the second floor corridor presumably led to an attic, or storeroom of sorts on the third floor."

#. Occurrence 6_5:177:7814: scene=6_5
#: 6_5:177
msgctxt "text_id=7814 | speaker=unknown"
msgid "　きょろきょろと見渡している草十郎をよそに、青子は慣れた足取りで階段を下りていく。"
msgstr "  Paying no mind to Soujyuro's gawking, Aoko descended the stairs with familiar steps."

#. Occurrence 6_5:203:7815: scene=6_5
#: 6_5:203
msgctxt "text_id=7815 | speaker=unknown"
msgid "　ロビーは一転して白色と木の空間だった。"
msgstr "  The foyer was a place of white and woodgrain."

#. Occurrence 6_5:209:7816: scene=6_5
#: 6_5:209
msgctxt "text_id=7816 | speaker=unknown"
msgid "　天井からの日射しが木の床を明るく照らす。"
msgstr "  Its hardwood floors shone brightly under the sunlight coming in from the ceiling,"

#. Occurrence 6_5:214:7817: scene=6_5
#: 6_5:214
msgctxt "text_id=7817 | speaker=unknown"
msgid "　壁は一面の白色。一点の汚れもなく、高い壁をより堅固に見せている。"
msgstr "  and the tall, white walls were spotless and brawny."

#. Occurrence 6_5:235:7818: scene=6_5
#: 6_5:235
msgctxt "text_id=7818 | speaker=unknown"
msgid "　二階に続く階段と、"
msgstr "  There, was a staircase leading to the second floor,"

msgctxt "text_id=7819 | speaker=unknown"
msgid "　長らく使われていない暖炉。"
msgstr "  and a long unused fireplace;"

#. Occurrence 6_5:243:7820: scene=6_5
#: 6_5:243
msgctxt "text_id=7820 | speaker=unknown"
msgid "　ぞんざいに放置された電話機と、"
msgstr "  a neglected telephone sat on a table,"

msgctxt "text_id=7821 | speaker=unknown"
msgid "　独りぼっちで時を刻む大時計。"
msgstr "  opposite a solemn grandfather clock."

#. Occurrence 6_5:272:7822: scene=6_5
#: 6_5:272
msgctxt "text_id=7822 | speaker=unknown"
msgid "　ここは洋館というより古城の様だ。"
msgstr "  It was more like an old castle than a mansion."

#. Occurrence 6_5:277:7823: scene=6_5
#: 6_5:277
msgctxt "text_id=7823 | speaker=unknown"
msgid "　あまりの異世界っぷりに呆然としている草十郎に、青子は冷たい視線を向ける。"
msgstr "  Aoko shot Soujyuro a callous stare, who stood captivated by the otherworldly scenery."

#. Occurrence 6_5:304:7824: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0000; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:304
msgctxt "text_id=7824 | speaker=aoko"
msgid "「居間はこっちよ。ぼさっとしない」"
msgstr "\"Hey, snap out of it. The drawing room is this way.\""

#. Occurrence 6_5:310:7825: scene=6_5
#: 6_5:310
msgctxt "text_id=7825 | speaker=unknown"
msgid "　彼女は階段横の扉に手を掛けた。"
msgstr "  She grabbed the knob of the door next to the stairs."

#. Occurrence 6_5:347:7826: scene=6_5
#: 6_5:347
msgctxt "text_id=7826 | speaker=unknown"
msgid "　ロビーには四つの扉があって、玄関から見て東側の扉が居間に続いているらしい。"
msgstr "  There were four doors to the foyer, and the easternmost as you entered the house led to the drawing room."

#. Occurrence 6_5:352:7827: scene=6_5
#: 6_5:352
msgctxt "text_id=7827 | speaker=unknown"
msgid "　反対側にある西の扉は館の左翼に。"
msgstr "  The door on the opposite side of the foyer led to the mansion's west wing."

#. Occurrence 6_5:372:7828: scene=6_5
#: 6_5:372
msgctxt "text_id=7828 | speaker=unknown"
msgid "　南側の扉は玄関。"
msgstr "  To the south was the entrance."

#. Occurrence 6_5:393:7829: scene=6_5
#: 6_5:393
msgctxt "text_id=7829 | speaker=unknown"
msgid "　北側、暖炉の横にはさらにもう一つ。"
msgstr "  On the north side was one more door next to the fireplace."

#. Occurrence 6_5:398:7830: scene=6_5
#: 6_5:398
msgctxt "text_id=7830 | speaker=unknown"
msgid "　階段の下に隠れている扉は浴場に続いているのだが、今の草十郎には知るよしもない。"
msgstr "  Tucked underneath the stairs, this door connected to a bathroom, unbeknownst to Soujyuro."

#. Occurrence 6_5:445:7831: scene=6_5
#: 6_5:445
msgctxt "text_id=7831 | speaker=unknown"
msgid "　一階の廊下には窓がないため、全体的に薄暗い。"
msgstr "  Due to the lack of windows, the first floor's corridors were not well lit."

#. Occurrence 6_5:450:7832: scene=6_5
#: 6_5:450
msgctxt "text_id=7832 | speaker=unknown"
msgid "　さながら、二階は放置された診療所で、ロビーは日本とは思えない西洋の城。"
msgstr "  If the second floor was a seldom-attended infirmary, and the foyer a stairwell in some foreign castle,"

#. Occurrence 6_5:455:7833: scene=6_5
#: 6_5:455
msgctxt "text_id=7833 | speaker=unknown"
msgid "　そして一階廊下はホテルを思わせる窓なき迷路。"
msgstr "  then the first floor corridor was a windowless labyrinth, not unlike the corridors of a hotel."

#. Occurrence 6_5:476:7834: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0000; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:476
msgctxt "text_id=7834 | speaker=soujuurou"
msgid "「…………」"
msgstr "\"...\""

#. Occurrence 6_5:481:7835: scene=6_5
#: 6_5:481
msgctxt "text_id=7835 | speaker=unknown"
msgid "　都会に来て日が浅い草十郎にも、この洋館がただならぬものである事は感じ取れる。"
msgstr "  Although it had not been long since Soujyuro came to the city, even he could feel this place was out of the ordinary."

#. Occurrence 6_5:486:7836: scene=6_5
#: 6_5:486
msgctxt "text_id=7836 | speaker=unknown"
msgid "　手放しで喜べないのは、そのお化け屋敷としばらく付き合う事になりそうだからだ。"
msgstr "  Seeing as how he was going to be stuck here for the foreseeable future, he found it hard to get excited about living in a haunted house."

#. Occurrence 6_5:521:7837: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0001; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:521
msgctxt "text_id=7837 | speaker=aoko"
msgid "「そこが居間で、奥が厨房ね。簡単な料理ぐらいはできるようになってるから。"
msgstr "\"So that's the drawing room, and a little farther down is the kitchen. It's fine for cooking simple meals."

#. Occurrence 6_5:528:7838: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0002_0; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:528
msgctxt "text_id=7838 | speaker=aoko"
msgid "　居間のとなりにはサンルームがあるんだけど、ここが食卓の代わり……"
msgstr "  Here, next to the drawing room, is the sunroom, which we use as a dining room,"

#. Occurrence 6_5:540:7839: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0002_1; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:540
msgctxt "text_id=7839 | speaker=aoko"
msgid "って、そんなの後でいっか」"
msgstr " but we'll get into that later.\""

#. Occurrence 6_5:546:7840: scene=6_5
#: 6_5:546
msgctxt "text_id=7840 | speaker=unknown"
msgid "　言って、青子は暗い廊下の扉に手を掛ける。"
msgstr "  Aoko said, reaching for a door along the dim corridor."

#. Occurrence 6_5:590:7841: scene=6_5
#: 6_5:590
msgctxt "text_id=7841 | speaker=unknown"
msgid "　ドアノブを回す<間際|まぎわ>。"
msgstr "  However, she paused before turning the knob."

#. Occurrence 6_5:623:7842: scene=6_5
#: 6_5:623
msgctxt "text_id=7842 | speaker=unknown"
msgid "　青子は意味ありげな<視線|コンタクト>を草十郎に送ったが、すぐに消した。"
msgstr "  She flashed Soujyuro a meaningful glance, which she quickly withdrew."

#. Occurrence 6_5:628:7843: scene=6_5
#: 6_5:628
msgctxt "text_id=7843 | speaker=unknown"
msgid "　ドアノブは待ったなしで回される。"
msgstr "  Then, without further ado, she opened the door."

#. Occurrence 6_5:699:7844: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0003; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:699
msgctxt "text_id=7844 | speaker=aoko"
msgid "「お待たせ。承諾したわよ、あいつ」"
msgstr "\"Sorry for the wait. He's on board,\""

#. Occurrence 6_5:705:7845: scene=6_5
#: 6_5:705
msgctxt "text_id=7845 | speaker=unknown"
msgid "　青子は居間に入りながら、中にいる有珠に語りかける。"
msgstr "  she said to Alice as she entered the drawing room."

#. Occurrence 6_5:710:7846: scene=6_5
#: 6_5:710
msgctxt "text_id=7846 | speaker=unknown"
msgid "　草十郎も少しだけ迷ってから、居間へと足を踏み入れた。"
msgstr "  After hesitating for a moment, Soujyuro entered after her."

#. Occurrence 6_5:750:7847: scene=6_5
#: 6_5:750
msgctxt "text_id=7847 | speaker=unknown"
msgid "　廊下とは違い、居間は思いのほか現代的だった。"
msgstr "  Compared to the corridor, the drawing room was unexpectedly modern."

#. Occurrence 6_5:755:7848: scene=6_5
#: 6_5:755
msgctxt "text_id=7848 | speaker=unknown"
msgid "　絨毯の敷き詰められた床も、革のソファーも、30インチの大きなテレビも、草十郎がこれまで知り得た一般家庭の趣きに満ちている。"
msgstr "  The carpeted floor, leather sofas, and a large, 30-inch television were more what Soujyuro had come to expect in a normal home."

#. Occurrence 6_5:761:7849: scene=6_5
#: 6_5:761
msgctxt "text_id=7849 | speaker=unknown"
msgid "　その家庭的な居間のソファーに、家庭的な団らんとはかけ離れた少女が座っていた。"
msgstr "  In this family-oriented room, a girl far removed from said setting sat quietly on the sofa."

#. Occurrence 6_5:806:7850: scene=6_5
#: 6_5:806
msgctxt "text_id=7850 | speaker=unknown"
msgid "　青子は黒い少女の向かいのソファーに座る。"
msgstr "  Aoko sat on the sofa across from the girl in all-black."

#. Occurrence 6_5:811:7851: scene=6_5
#: 6_5:811
msgctxt "text_id=7851 | speaker=unknown"
msgid "　草十郎に残された席は二つ。"
msgstr "  This gave Soujyuro two seating options:"

#. Occurrence 6_5:835:7852: scene=6_5
#: 6_5:835
msgctxt "text_id=7852 | speaker=unknown"
msgid "　蒼崎青子のとなりか、"
msgstr "  Next to Aoko Aozaki,"

#. Occurrence 6_5:862:7853: scene=6_5
#: 6_5:862
msgctxt "text_id=7853 | speaker=unknown"
msgid "　久遠寺有珠のとなりか。"
msgstr "  or next to Alice Kuonji."

#. Occurrence 6_5:902:7854: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0001; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:902
msgctxt "text_id=7854 | speaker=soujuurou"
msgid "「…………」"
msgstr "\"...\""

#. Occurrence 6_5:938:7855: scene=6_5
#: 6_5:938
msgctxt "text_id=7855 | speaker=unknown"
msgid "　草十郎は二秒ほど悩んだ末、どっちも不吉な気がしたので壁ぎわで立つ道を選んだ。"
msgstr "  After about two seconds of deliberation, he decided to stand by the wall, as neither option appealed."

#. Occurrence 6_5:943:7856: scene=6_5
#: 6_5:943
msgctxt "text_id=7856 | speaker=unknown"
msgid "　テーブルを挟んで青子と有珠は向き合っている。"
msgstr "  Aoko and Alice were facing each other across a coffee table."

#. Occurrence 6_5:948:7857: scene=6_5
#: 6_5:948
msgctxt "text_id=7857 | speaker=unknown"
msgid "　何も載せられていない真っ平らなテーブルが、どことなく寒い。"
msgstr "  The clean, perfectly level table somehow added to the austere atmosphere."

#. Occurrence 6_5:982:7858: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0004; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:982
msgctxt "text_id=7858 | speaker=aoko"
msgid "「当事者も認めた事だし、これで何の問題もないわね、有珠」"
msgstr "\"And since he agreed, you shouldn't have any objections, right, Alice?\""

#. Occurrence 6_5:1009:7859: scene=6_5
#: 6_5:1009
msgctxt "text_id=7859 | speaker=unknown"
msgid "　青子の念押しに、有珠はこくんとうなずいた。"
msgstr "  Alice gave one, deep nod in response to her non-question."

#. Occurrence 6_5:1050:7860: scene=6_5
#: 6_5:1050
msgctxt "text_id=7860 | speaker=unknown"
msgid "　……こうして壁ぎわから見ていると、目に見えない文句のぶつけ合いが手に取るようだ。"
msgstr "  From his position against the wall, they looked as though they were clearing up some niggling grievance."

#. Occurrence 6_5:1055:7861: scene=6_5
#: 6_5:1055
msgctxt "text_id=7861 | speaker=unknown"
msgid "　彼女たちの間で、自分の扱いについて一波乱あったんだな、と今更ながら草十郎は感じ取った。"
msgstr "  Soujyuro got the feeling that the two did not entirely see eye to eye concerning what to do with him."

#. Occurrence 6_5:1097:7862: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0000; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:1097
msgctxt "text_id=7862 | speaker=alice"
msgid "「……そうね。原因も究明しないといけないし」"
msgstr "\"...I suppose not. But we still need to investigate the cause.\""

#. Occurrence 6_5:1131:7863: scene=6_5
#: 6_5:1131
msgctxt "text_id=7863 | speaker=unknown"
msgid "　<昏|くら>い色をした目が草十郎を流し見る。"
msgstr "  She cast a sideways look at Soujyuro with those darkly shaded eyes of hers."

#. Occurrence 6_5:1136:7864: scene=6_5
#: 6_5:1136
msgctxt "text_id=7864 | speaker=unknown"
msgid "　視線と同じ<抑揚|よくよう>のない声。"
msgstr "  Her voice shared the same, cold indifference,"

#. Occurrence 6_5:1141:7865: scene=6_5
#: 6_5:1141
msgctxt "text_id=7865 | speaker=unknown"
msgid "　そのくせ、草十郎の同居を認めていない意志がありありと伝わってくる。"
msgstr "  making it abundantly clear that she had no intention of accepting him as a housemate."

#. Occurrence 6_5:1167:7866: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0001; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:1167
msgctxt "text_id=7866 | speaker=alice"
msgid "「けれど、貴方はそれでいいの？"
msgstr "\"And you, you're fine with this?"

#. Occurrence 6_5:1173:7867: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0002; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:1173
msgctxt "text_id=7867 | speaker=alice"
msgid "　遊園地での事を忘れてはいないでしょう？」"
msgstr "  I do hope you haven't forgotten about what happened at the amusement park.\""

#. Occurrence 6_5:1179:7868: scene=6_5
#: 6_5:1179
msgctxt "text_id=7868 | speaker=unknown"
msgid "　有珠の声には批難と、試しの色が混ざっている。"
msgstr "  Alice's voice was a mixture of judgment and scrutiny."

#. Occurrence 6_5:1184:7869: scene=6_5
#: 6_5:1184
msgctxt "text_id=7869 | speaker=unknown"
msgid "　自分も青子も一般人からすれば危険物だ。そんな得体の知れない人間の<傍|そば>にいられるのか、と。"
msgstr "  She was aware that from an outsider's perspective she and Aoko appeared dangerous. She wanted to know if Soujyuro was up to the challenge of living with such people."

#. Occurrence 6_5:1229:7870: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0002; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:1229
msgctxt "text_id=7870 | speaker=soujuurou"
msgid "「そりゃあ夢だと思いこみたいけど、ちゃんと覚えてるし。できるだけ無事に済ませるには、これが一番<無難|ぶなん>そうだ」"
msgstr "\"I wish it had all been a bad dream, but I remember it perfectly.\""

#. Occurrence 6_5:1243:7871: scene=6_5
#: 6_5:1243
msgctxt "text_id=7871 | speaker=unknown"
msgid "　なにより命の保証はされてるみたいだし、と。"
msgstr "  Above all else, it was the only way they would let him live."

#. Occurrence 6_5:1277:7872: scene=6_5
#: 6_5:1277
msgctxt "text_id=7872 | speaker=unknown"
msgid "　返答する草十郎に、有珠はそう、と無関心げに答えた。"
msgstr "  Alice responded apathetically with a noncommittal murmur."

#. Occurrence 6_5:1282:7873: scene=6_5
#: 6_5:1282
msgctxt "text_id=7873 | speaker=unknown"
msgid "　そうして無言のまま、コトリ、とテーブルに小物を置く。"
msgstr "  She silently placed a small object on the table with a clink."

#. Occurrence 6_5:1350:7874: scene=6_5
#: 6_5:1350
msgctxt "text_id=7874 | speaker=unknown"
msgid "　白い指が置いた物は、<硝子|ガラス>の<小瓶|こびん>だった。"
msgstr "  She pulled her pale fingers away from a small glass bottle."

#. Occurrence 6_5:1355:7875: scene=6_5
#: 6_5:1355
msgctxt "text_id=7875 | speaker=unknown"
msgid "　ガラスは透明というより薄い青色をしていて、その色あいだけでも高級品だと見て取れる。"
msgstr "  The glass, more pale blue than transparent, was enough to signify its high quality."

#. Occurrence 6_5:1360:7876: scene=6_5
#: 6_5:1360
msgctxt "text_id=7876 | speaker=unknown"
msgid "　有珠はその瓶の<蓋|ふた>を、鶴か何かを思わせる仕草で抜いた。"
msgstr "  With a crane-like motion, she removed the stopper."

#. Occurrence 6_5:1404:7877: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0003; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:1404
msgctxt "text_id=7877 | speaker=soujuurou"
msgid "『………………？』"
msgstr "(...?)"

#. Occurrence 6_5:1410:7878: scene=6_5
#: 6_5:1410
msgctxt "text_id=7878 | speaker=unknown"
msgid "　草十郎にとっては初めて見る小瓶だったが、妙にひっかかる物がある。"
msgstr "  Even though this was the first time he had seen such a thing, something about it made him uneasy."

#. Occurrence 6_5:1415:7879: scene=6_5
#: 6_5:1415
msgctxt "text_id=7879 | speaker=unknown"
msgid "　しかし悲しいかな、何がネックなのか思い当たらない。"
msgstr "  Was it that it made him sad, or...?"

#. Occurrence 6_5:1467:7880: scene=6_5
#: 6_5:1467
msgctxt "text_id=7880 | speaker=unknown"
msgid "　青子が<傍観|ぼうかん>を決めこんでいるのも気にかかる。"
msgstr "  Aoko's standoffish behavior only added to his concern."

#. Occurrence 6_5:1478:7881: scene=6_5
#: 6_5:1478
msgctxt "text_id=7881 | speaker=unknown"
msgid "　そんな、イヤな予感に気を張る草十郎に、有珠はもう一度視線を投げた。"
msgstr "  Alice once again fixed her eyes on Soujyuro, who was bracing himself for the worst."

#. Occurrence 6_5:1522:7882: scene=6_5
#: 6_5:1522
msgctxt "text_id=7882 | speaker=unknown"
msgid "　……少女の瞳は、やはり魔的な感じがする。"
msgstr "  The glint in her eyes was bewitching."

#. Occurrence 6_5:1527:7883: scene=6_5
#: 6_5:1527
msgctxt "text_id=7883 | speaker=unknown"
msgid "　そんなコトを思っていた草十郎に、有珠は表情のない顔で呼び掛けた。"
msgstr "  With not a single emotion apparent on her face, she called his name."

#. Occurrence 6_5:1566:7884: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0003; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:1566
msgctxt "text_id=7884 | speaker=alice"
msgid "「静希君」、と。"
msgstr "\"Sizuki.\""

#. Occurrence 6_5:1644:7885: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0004; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:1644
msgctxt "text_id=7885 | speaker=soujuurou"
msgid "　{{{は―――い？}}}"
msgstr "  (Ye- huh?)"

#. Occurrence 6_5:1650:7886: scene=6_5
#: 6_5:1650
msgctxt "text_id=7886 | speaker=unknown"
msgid "　<囁|ささや>くような有珠の呼びかけに応えた瞬間。"
msgstr "  The moment he responded to her whispered call,"

#. Occurrence 6_5:1655:7887: scene=6_5
#: 6_5:1655
msgctxt "text_id=7887 | speaker=unknown"
msgid "　<彼|・>の周囲の風景は、かくのように一変していた。"
msgstr "  his surroundings began to transform."

#. Occurrence 6_5:1660:7888: scene=6_5
#: 6_5:1660
msgctxt "text_id=7888 | speaker=unknown"
msgid "　空気は色と形を持ったように<濁|にご>っている。"
msgstr "  The air grew thick; so thick, it took on a color and shape."

#. Occurrence 6_5:1665:7889: scene=6_5
#: 6_5:1665
msgctxt "text_id=7889 | speaker=unknown"
msgid "　重く肌に<纏|まと>わりつく密度の濃さ、不自由さは、さながら空気が文字になったようだ。"
msgstr "  The density and discomfort that coiled around his skin made it seem like the air had become words."

#. Occurrence 6_5:1730:7890: scene=6_5
#: 6_5:1730
msgctxt "text_id=7890 | speaker=unknown"
msgid "　{{{、―――、、―――！}}}"
msgstr "  (...!)"

#. Occurrence 6_5:1736:7891: scene=6_5
#: 6_5:1736
msgctxt "text_id=7891 | speaker=unknown"
msgid "　息を吸う口から、<文字|いぶつ>が肺に入る錯覚に襲われる。"
msgstr "  Opening his mouth to gasp for air, the words invaded his lungs."

#. Occurrence 6_5:1741:7892: scene=6_5
#: 6_5:1741
msgctxt "text_id=7892 | speaker=unknown"
msgid "　咄嗟に口を<塞|ふさ>ぐ右手も、胸を押さえる左手も、きちんと見えるのによく見えない。"
msgstr "  Instinctively, he covered his mouth with his right hand, and clutched his chest with his left, both hands appearing clear as mud."

#. Occurrence 6_5:1746:7893: scene=6_5
#: 6_5:1746
msgctxt "text_id=7893 | speaker=unknown"
msgid "　山で出会った深い霧だって、ここまで意識を<拐|かどわ>かす事はなかったはずだ。"
msgstr "  Even the thickest of mountain fogs never seized his senses like this."

#. Occurrence 6_5:1804:7894: scene=6_5
#: 6_5:1804
msgctxt "text_id=7894 | speaker=unknown"
msgid "　―――喩えるなら、そう。"
msgstr "  If he had to come up with an analogy..."

#. Occurrence 6_5:1810:7895: scene=6_5
#: 6_5:1810
msgctxt "text_id=7895 | speaker=unknown"
msgid "　まったく見当違いの比喩ではあるが、まるで生身のまま、<新|・><聞|・><紙|・><の|・><中|・><で|・>立っているような。"
msgstr "  ...no words could quite describe it, but it was like he was standing in the pages of a newspaper."

#. Occurrence 6_5:1859:7896: scene=6_5
#: 6_5:1859
msgctxt "text_id=7896 | speaker=unknown"
msgid "　味わった事のない方位感覚に、まず聴覚から慣れていく。"
msgstr "  The first sense to adjust to this new sensation was his hearing."

#. Occurrence 6_5:1864:7897: scene=6_5
#: 6_5:1864
msgctxt "text_id=7897 | speaker=unknown"
msgid "　呼吸は普段通りだが、ざらついた圧迫感がある。"
msgstr "  Then his breathing stabilized, yet the feeling of suffocation remained."

#. Occurrence 6_5:1869:7898: scene=6_5
#: 6_5:1869
msgctxt "text_id=7898 | speaker=unknown"
msgid "　別に閉じこめられている訳ではないのに、この周りはひどく<狭|せま>い。"
msgstr "  There was nothing restraining him that he could see, but he felt an intense claustrophobia."

#. Occurrence 6_5:1874:7899: scene=6_5
#: 6_5:1874
msgctxt "text_id=7899 | speaker=unknown"
msgid "　突然の異変に驚くより先に、その狭さから逃れるために手を伸ばしたほどだ。"
msgstr "  Before he'd even felt shock at the sudden change, he reached out in an attempt to find an escape."

#. Occurrence 6_5:1901:7900: scene=6_5
#: 6_5:1901
msgctxt "text_id=7900 | speaker=unknown"
msgid "　けれど伸ばした手は<空|くう>を切るだけ。"
msgstr "  But his outstretched hands found only emptiness."

#. Occurrence 6_5:1906:7901: scene=6_5
#: 6_5:1906
msgctxt "text_id=7901 | speaker=unknown"
msgid "　周囲に壁はなく、これだけ見晴らしのいい場所で「狭い」と感じること自体、常軌を逸している。"
msgstr "  It seemed contradictory that a place with no walls and a wide view could feel so cramped."

#. Occurrence 6_5:1911:7902: scene=6_5
#: 6_5:1911
msgctxt "text_id=7902 | speaker=unknown"
msgid "　深い霧の日は神隠しに遭う―――"
msgstr "  Spirited away in a dense fog..."

#. Occurrence 6_5:1916:7903: scene=6_5
#: 6_5:1916
msgctxt "text_id=7903 | speaker=unknown"
msgid "　山でのそんな<口伝|くでん>を信じていた<彼|・>ではなかったが、これは本当に神隠しの領域では、と思いかけて、"
msgstr "  Back in the mountains, such superstitions never seemed real to him. Until now."

#. Occurrence 6_5:1986:7904: scene=6_5
#: 6_5:1986
msgctxt "text_id=7904 | speaker=unknown"
msgid "　そこでようやく、"
msgstr "  And then,"

#. Occurrence 6_5:1993:7905: scene=6_5
#: 6_5:1993
msgctxt "text_id=7905 | speaker=unknown"
msgid "　彼はもっと別の、"
msgstr "  he finally noticed:"

#. Occurrence 6_5:2000:7906: scene=6_5
#: 6_5:2000
msgctxt "text_id=7906 | speaker=unknown"
msgid "　驚かなくてはいけないコトに気が付いた。"
msgstr "  a surprise to beat all surprises."

#. Occurrence 6_5:2020:7907: scene=6_5
#: 6_5:2020
msgctxt "text_id=7907 | speaker=unknown"
msgid "　そもそもの話、居間が別世界に一変した訳ではない。"
msgstr "  The drawing room had not changed into another world at all."

#. Occurrence 6_5:2025:7908: scene=6_5
#: 6_5:2025
msgctxt "text_id=7908 | speaker=unknown"
msgid "　なぜなら霧ごしに見える景色は、間違いなく<彼|・>が先ほどまで居た居間の物だったし、"
msgstr "  He knew this for certain because he could still see the room he was just in through the fog,"

#. Occurrence 6_5:2030:7909: scene=6_5
#: 6_5:2030
msgctxt "text_id=7909 | speaker=unknown"
msgid "　その場にいた二人の少女―――蒼崎青子と久遠寺有珠の姿もきちんと見えている。"
msgstr "  as well as the two girls, Aoko Aozaki and Alice Kuonji, watching him closely."

#. Occurrence 6_5:2036:7910: scene=6_5
#: 6_5:2036
msgctxt "text_id=7910 | speaker=unknown"
msgid "　ただ、その見え方に問題があっただけだ。"
msgstr "  It was simply a problem of perspective."

#. Occurrence 6_5:2120:7911: scene=6_5
#: 6_5:2120
msgctxt "text_id=7911 | speaker=unknown"
msgid "　地面は黒い、真っ平らな地平だった。"
msgstr "  The floor was dark and perfectly flat."

#. Occurrence 6_5:2125:7912: scene=6_5
#: 6_5:2125
msgctxt "text_id=7912 | speaker=unknown"
msgid "　そこから見上げるようにして二人の姿が見える。"
msgstr "  Looking up, there the two of them stood."

#. Occurrence 6_5:2131:7913: scene=6_5
#: 6_5:2131
msgctxt "text_id=7913 | speaker=unknown"
msgid "　現実味のない、入道雲の様に大きな少女が、冷たい瞳を向けている。"
msgstr "  The two girls were like two impossibly gargantuan clouds, coldly looking down at him."

#. Occurrence 6_5:2151:7914: scene=6_5
#: 6_5:2151
msgctxt "text_id=7914 | speaker=unknown"
msgid "　部屋の構造、そこにあった家具の位置関係を思い出し、<彼|・>は信じがたい素直さで、この事態を把握した。"
msgstr "  Remembering the structure of the room and layout of the furniture, Soujyuro's unsurpassed candor finally grasped his predicament."

#. Occurrence 6_5:2156:7915: scene=6_5
#: 6_5:2156
msgctxt "text_id=7915 | speaker=unknown"
msgid "　あの遊園地でのパレードを経験しておいて、なお信じられない、と頭を抱えそうだが。"
msgstr "  The parade at the amusement park had nothing on this."

#. Occurrence 6_5:2215:7916: scene=6_5
#: 6_5:2215
msgctxt "text_id=7916 | speaker=unknown"
msgid "　<此|・><処|・>は間違いなく、久遠寺有珠が取り出した小瓶の中であるらしい。"
msgstr "  Somehow, he was inside the glass bottle that Alice Kuonji produced only moments ago."

#. Occurrence 6_5:2249:7917: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0005; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2249
msgctxt "text_id=7917 | speaker=aoko"
msgid "「<図|はか>らずも」"
msgstr "\"That was unexpected.\""

#. Occurrence 6_5:2255:7918: scene=6_5
#: 6_5:2255
msgctxt "text_id=7918 | speaker=unknown"
msgid "　青子は有珠の性根の悪さに呆れながら、テーブルに置かれた小瓶をチラ見する。"
msgstr "  Marveling at Alice's wickedness, Aoko glanced at the small bottle on the table."

#. Occurrence 6_5:2272:7919: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0006; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2272
msgctxt "text_id=7919 | speaker=aoko"
msgid "「二日前の夜と同じ状況になったわね。"
msgstr "\"It's the same as two nights ago,"

#. Occurrence 6_5:2272:7920: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0006; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2272
msgctxt "text_id=7920 | speaker=aoko"
msgid "　今回、<草十郎|ソイツ>は起きてるけど」"
msgstr "  only this time, he's awake.\""

#. Occurrence 6_5:2303:7921: scene=6_5
#: 6_5:2303
msgctxt "text_id=7921 | speaker=unknown"
msgid "　淡々と青子は語った。"
msgstr "  Aoko calmly mused."

#. Occurrence 6_5:2327:7922: scene=6_5
#: 6_5:2327
msgctxt "text_id=7922 | speaker=unknown"
msgid "　有珠はというと、小瓶には視線も落とさず、目前の青子を見つめている。"
msgstr "  Alice, however, was not looking down at the bottle Instead her eyes were locked on Aoko."

#. Occurrence 6_5:2354:7923: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0004; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:2354
msgctxt "text_id=7923 | speaker=alice"
msgid "「……意外ね。青子は怒ると思ってたのに」"
msgstr "\"...I'm surprised. I thought you would be upset.\""

#. Occurrence 6_5:2374:7924: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0007; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2374
msgctxt "text_id=7924 | speaker=aoko"
msgid "「いや、私も似たようなコト考えてたから。"
msgstr "\"Not really. I thought about doing something similar."

#. Occurrence 6_5:2380:7925: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0008; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2380
msgctxt "text_id=7925 | speaker=aoko"
msgid "　少しは魔術ってもんを思い知らせておかないと困るでしょ。"
msgstr "  He needed to be taught a little lesson about magecraft, anyway."

#. Occurrence 6_5:2387:7926: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0009; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2387
msgctxt "text_id=7926 | speaker=aoko"
msgid "有珠がやってくれるなら止めはしないし<怒|おこ>りもしないわ。"
msgstr "You're saving me the trouble, to tell the truth. I'm not even mad."

#. Occurrence 6_5:2393:7927: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0010; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2393
msgctxt "text_id=7927 | speaker=aoko"
msgid "　……ま、こっちが予定していたものより何倍もメチャクチャだけど」"
msgstr "  ...Though, this is pretty hardcore even for me.\""

#. Occurrence 6_5:2429:7928: scene=6_5
#: 6_5:2429
msgctxt "text_id=7928 | speaker=unknown"
msgid "　言いつつ、青子は小瓶から視線を外さない。"
msgstr "  Aoko did not take her eyes off the bottle as she spoke."

#. Occurrence 6_5:2434:7929: scene=6_5
#: 6_5:2434
msgctxt "text_id=7929 | speaker=unknown"
msgid "　有珠の魔術に無関心を装っているものの、興味を隠しきれていない。"
msgstr "  Although she did her best to feign indifference toward Alice's magecraft, she could not completely hide her curiosity."

#. Occurrence 6_5:2454:7930: scene=6_5
#: 6_5:2454
msgctxt "text_id=7930 | speaker=unknown"
msgid "　小瓶の中の人影はようやく事態が飲みこめたのか、バタバタと手を伸ばしたり、全力で走ってみたり、色々と試行錯誤しているように見えた。"
msgstr "  The figure inside the bottle, likely having caught on to what was happening, tried various things like flailing its arms and sprinting around."

#. Occurrence 6_5:2459:7931: scene=6_5
#: 6_5:2459
msgctxt "text_id=7931 | speaker=unknown"
msgid "　小瓶の表面が<濁|にご>っているため、<外|そ><界|と>からでは<瓶|なか>の様子はぼんやりとしか分からない。"
msgstr "  The surface of the bottle was cloudy, so it was hard to make out exactly what was happening inside."

#. Occurrence 6_5:2499:7932: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0011; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2499
msgctxt "text_id=7932 | speaker=aoko"
msgid "「……ところで、これって私にくれたヤツとは別物みたいだけど」"
msgstr "\"...By the way, this looks totally different from the one you gave me.\""

#. Occurrence 6_5:2523:7933: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0005; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:2523
msgctxt "text_id=7933 | speaker=alice"
msgid "「アレより作りは細かいわ。"
msgstr "\"This one took more time to create."

#. Occurrence 6_5:2530:7934: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0006; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:2530
msgctxt "text_id=7934 | speaker=alice"
msgid "青子にあげたのは使い捨ての、隔離するだけの物よ。コレはお互いの声も聞こえるから」"
msgstr "The one I gave you was disposable, and only made to isolate the subject. This one allows for two-way communication.\""

#. Occurrence 6_5:2574:7935: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0012; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2574
msgctxt "text_id=7935 | speaker=aoko"
msgid "「へえ。けど、そのわりには何の反応もないわね」"
msgstr "\"Really? He doesn't seem to be replying, though.\""

#. Occurrence 6_5:2587:7936: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0007; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:2587
msgctxt "text_id=7936 | speaker=alice"
msgid "「青子には聞こえないだけよ」"
msgstr "\"You just can't hear him.\""

#. Occurrence 6_5:2610:7937: scene=6_5
#: 6_5:2610
msgctxt "text_id=7937 | speaker=unknown"
msgid "　平然と言って、有珠は小瓶へ視線を落とした。"
msgstr "  Alice said calmly, finally dropping her gaze to the bottle."

#. Occurrence 6_5:2615:7938: scene=6_5
#: 6_5:2615
msgctxt "text_id=7938 | speaker=unknown"
msgid "　同時に人影の動きが止まる。"
msgstr "  Just then, the figure inside stopped moving."

#. Occurrence 6_5:2620:7939: scene=6_5
#: 6_5:2620
msgctxt "text_id=7939 | speaker=unknown"
msgid "　どうやら有珠だけが、小瓶の中の別世界と関わりが持てるようだ。"
msgstr "  It appeared only Alice had a connection to the world inside the bottle."

#. Occurrence 6_5:2654:7940: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0013; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2654
msgctxt "text_id=7940 | speaker=aoko"
msgid "『……なんだ、術者にしか特典はないんだ』"
msgstr "(Lame. Only the caster gets to have fun?)"

#. Occurrence 6_5:2660:7941: scene=6_5
#: 6_5:2660
msgctxt "text_id=7941 | speaker=unknown"
msgid "　つまらなそうに<嘆息|たんそく>する青子。"
msgstr "  Aoko sighed, losing interest."

#. Occurrence 6_5:2665:7942: scene=6_5
#: 6_5:2665
msgctxt "text_id=7942 | speaker=unknown"
msgid "　そんな青子をよそに、有珠は誰に話しかけるのでもなく口を開けた。"
msgstr "  Ignoring Aoko, Alice opened her mouth as if to speak to someone not altogether there."

#. Occurrence 6_5:2710:7943: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0008; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:2710
msgctxt "text_id=7943 | speaker=alice"
msgid "「どう？　これでも一番、無難だと思う……？」"
msgstr "\"How about now? Still think this is the safest option?\""

#. Occurrence 6_5:2716:7944: scene=6_5
#: 6_5:2716
msgctxt "text_id=7944 | speaker=unknown"
msgid "　語りかける相手は、言うまでもなく小瓶の中の人影だ。"
msgstr "  The person she was talking to was none other than the one inside the bottle."

#. Occurrence 6_5:2721:7945: scene=6_5
#: 6_5:2721
msgctxt "text_id=7945 | speaker=unknown"
msgid "　先ほどの会話。"
msgstr "  She was, of course, referring to Soujyuro's earlier comment."

#. Occurrence 6_5:2726:7946: scene=6_5
#: 6_5:2726
msgctxt "text_id=7946 | speaker=unknown"
msgid "　この洋館に住む事が無難だと言った彼の言葉を、少女はこんなカタチで確認しているのだ。"
msgstr "  It was her way of testing the boy who implied that living in this mansion seemed safe."

#. Occurrence 6_5:2770:7947: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0014; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:2770
msgctxt "text_id=7947 | speaker=aoko"
msgid "『……いきなり小瓶に閉じこめて聞き返すあたり容赦ないというか……この子の洋館への執着も問題よね……』"
msgstr "(Suddenly trapping him in a bottle and interrogating him is pretty ruthless, but even more worrisome is her attachment to this mansion.)"

#. Occurrence 6_5:2776:7948: scene=6_5
#: 6_5:2776
msgctxt "text_id=7948 | speaker=unknown"
msgid "　が、目撃者をミラーハウスに誘いこんで、正々堂々と殺し合いをしよう、と提案した自分が批難できる事でもない。"
msgstr "  Then again, considering Aoko had invited this witness to a house of mirrors for a fight to the death, she was in no position to criticize."

#. Occurrence 6_5:2787:7949: scene=6_5
#: 6_5:2787
msgctxt "text_id=7949 | speaker=unknown"
msgid "　青子は有珠が感情的になって手をあげないよう注意しつつ、あくまで傍観者として事の顛末を見定めている。"
msgstr "  She would make sure Alice did not let her emotions get the best of her, but for now she was content to observe as a bystander."

#. Occurrence 6_5:2844:7950: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0009; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:2844
msgctxt "text_id=7950 | speaker=alice"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 6_5:2849:7951: scene=6_5
#: 6_5:2849
msgctxt "text_id=7951 | speaker=unknown"
msgid "　少し間をおいて、有珠の表情が変化した。"
msgstr "  After a moment, Alice's expression changed."

#. Occurrence 6_5:2854:7952: scene=6_5
#: 6_5:2854
msgctxt "text_id=7952 | speaker=unknown"
msgid "　少女の問いかけに、人影は何らかの返答をしたらしい。"
msgstr "  She must have gotten an answer to her question."

#. Occurrence 6_5:2859:7953: scene=6_5
#: 6_5:2859
msgctxt "text_id=7953 | speaker=unknown"
msgid "　小瓶の中の様子を探れない青子には彼がなんと返答したかは分からない。"
msgstr "  Without any way to tell what the situation was inside the bottle, Aoko had no idea what that answer was, however."

#. Occurrence 6_5:2864:7954: scene=6_5
#: 6_5:2864
msgctxt "text_id=7954 | speaker=unknown"
msgid "　ただ、"
msgstr "  Only..."

#. Occurrence 6_5:2896:7955: scene=6_5
#: 6_5:2896
msgctxt "text_id=7955 | speaker=unknown"
msgid "　相方がああいう顔をしている時は、完膚無きまで、相手の言い分が正しかった時なのだった。"
msgstr "  That Alice's face was the one she had made when the boy she was talking to said what she wanted to hear."

#. Occurrence 6_5:2958:7956: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0010; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:2958
msgctxt "text_id=7956 | speaker=alice"
msgid "「……わたしが言える事でもないけど」"
msgstr "\"...I suppose I'm not one to talk, but....\""

#. Occurrence 6_5:2981:7957: scene=6_5
#: 6_5:2981
msgctxt "text_id=7957 | speaker=unknown"
msgid "　少女は一瞬、青子を<一瞥|いちべつ>する。"
msgstr "  For an instant, she glanced at Aoko."

#. Occurrence 6_5:2986:7958: scene=6_5
#: 6_5:2986
msgctxt "text_id=7958 | speaker=unknown"
msgid "　有珠はかすかにかぶりをふって小瓶に手を伸ばし、"
msgstr "  Slightly shaking her head, she reached for the small bottle."

#. Occurrence 6_5:3024:7959: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0011; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:3024
msgctxt "text_id=7959 | speaker=alice"
msgid "「……本当。物好きね、静希君は」"
msgstr "\"This Sizuki is quite a strange one.\""

#. Occurrence 6_5:3030:7960: scene=6_5
#: 6_5:3030
msgctxt "text_id=7960 | speaker=unknown"
msgid "　<憂鬱|ゆううつ>げなため息のように、彼の名前を口にした。"
msgstr "  She said his name with what seemed like a forlorn frown."

#. Occurrence 6_5:3072:7961: scene=6_5
#: 6_5:3072
msgctxt "text_id=7961 | speaker=unknown"
msgid "　<蓋|フタ>が抜かれた瞬間、居間の空気がわずかに揺れた。"
msgstr "  As soon as she removed the stopper, the air in the room quivered."

#. Occurrence 6_5:3077:7962: scene=6_5
#: 6_5:3077
msgctxt "text_id=7962 | speaker=unknown"
msgid "　かと思うと、先ほどまで壁際に影だけ映していた少年が、<憮然|ぶぜん>とした顔で壁に寄りかかっていた。"
msgstr "  The boy, who had been casting a shadow on the wall until a minute ago, now leaned against it for support again."

#. Occurrence 6_5:3082:7963: scene=6_5
#: 6_5:3082
msgctxt "text_id=7963 | speaker=unknown"
msgid "　ちょうど自分の背後にいる草十郎へ、青子は片肘をついたまま振り向く。"
msgstr "  Aoko turned around to face Soujyuro right behind her, resting her elbow over the back of the sofa."

#. Occurrence 6_5:3116:7964: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0015; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3116
msgctxt "text_id=7964 | speaker=aoko"
msgid "「どう、気分は？」"
msgstr "\"How do you feel?\""

#. Occurrence 6_5:3141:7965: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0006; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:3141
msgctxt "text_id=7965 | speaker=soujuurou"
msgid "「見ての通り、めちゃくちゃだ」"
msgstr "\"What does it look like? Messed up.\""

#. Occurrence 6_5:3147:7966: scene=6_5
#: 6_5:3147
msgctxt "text_id=7966 | speaker=unknown"
msgid "　草十郎は柄にもなく敵意をむき出しにしていた。"
msgstr "  Soujyuro answered with unusual hostility."

#. Occurrence 6_5:3152:7967: scene=6_5
#: 6_5:3152
msgctxt "text_id=7967 | speaker=unknown"
msgid "　<怯|おび>えや驚きではなく怒っているあたり、相変わらず謎なヤツ、と青子は思う。"
msgstr "  Aoko was reminded of his strange behavior, as she was sure that he would be scared or shocked, not angry."

#. Occurrence 6_5:3190:7968: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0007; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:3190
msgctxt "text_id=7968 | speaker=soujuurou"
msgid "「……夢で似たようなものを見てなかったら、今ごろ心臓が止まってたところだ。そこはついてたと思う。"
msgstr "\"If I hadn't already seen something similar in a dream, my heart probably would have stopped. I'm lucky it didn't."

#. Occurrence 6_5:3197:7969: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0008_0; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:3197
msgctxt "text_id=7969 | speaker=soujuurou"
msgid "　信じられないのは、なんでいちいち実践するかって事だ。魔術は恐いものなんだって言えば済むだろうに。"
msgstr "  What I can't believe is why you felt the need to use magecraft on me. You could have just said it was scary and left it at that."

#. Occurrence 6_5:3211:7970: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0008_1; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:3211
msgctxt "text_id=7970 | speaker=soujuurou"
msgid "それと、ぶっそうな蒼崎の声、聞こえてたぞ」"
msgstr " Plus, I could hear the threatening things you said, Aozaki.\""

#. Occurrence 6_5:3251:7971: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0016; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3251
msgctxt "text_id=7971 | speaker=aoko"
msgid "「ぶっそうで悪うございました。"
msgstr "\"My sincerest apologies."

#. Occurrence 6_5:3258:7972: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0017; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3258
msgctxt "text_id=7972 | speaker=aoko"
msgid "けど、言葉じゃなくてきちんと実感してもらいたかったのは本当よ。"
msgstr "But it is true that I wanted you to feel it for yourself."

#. Occurrence 6_5:3264:7973: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0018; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3264
msgctxt "text_id=7973 | speaker=aoko"
msgid "　どう？　魔術ってもんを甘く見てたでしょ、草十郎？」"
msgstr "  At least now you'll take magecraft seriously, won't you, Soujyuro?\""

#. Occurrence 6_5:3297:7974: scene=6_5
#: 6_5:3297
msgctxt "text_id=7974 | speaker=unknown"
msgid "　不本意ながらも、むう、と納得する草十郎。"
msgstr "  As much as he hated to admit it, she was right."

#. Occurrence 6_5:3302:7975: scene=6_5
#: 6_5:3302
msgctxt "text_id=7975 | speaker=unknown"
msgid "　彼の場合、『甘く見ていた』と言うより『分かっていなかった』と言う方が正しいのだが。"
msgstr "  Though, it was not that he had taken magecraft lightly, but merely that he couldn't understand it."

#. Occurrence 6_5:3323:7976: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0009; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:3323
msgctxt "text_id=7976 | speaker=soujuurou"
msgid "「けど、実感うんぬん言われても困る。"
msgstr "\"I still don't really get it, though, even after that experience."

#. Occurrence 6_5:3329:7977: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0010; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:3329
msgctxt "text_id=7977 | speaker=soujuurou"
msgid "　これまでの蒼崎の無茶っぷりと、今の訳の分からなさはとても比べられない」"
msgstr "  Compared to the crazy stuff I've seen you do, Aozaki, whatever the heck just happened to me was hardly unbelievable.\""

#. Occurrence 6_5:3348:7978: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0019; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3348
msgctxt "text_id=7978 | speaker=aoko"
msgid "「ちょ、"
msgstr "\"W-Wha..."

msgctxt "text_id=7979 | speaker=unknown"
msgid "そりゃそうよ、有珠と比べないでよね。"
msgstr " Of course not! Alice and I are totally different."

#. Occurrence 6_5:3361:7980: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0020; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3361
msgctxt "text_id=7980 | speaker=aoko"
msgid "　有珠の魔術は私たちの中でもデタラメで、もう言葉にできないぐらい最悪なんだって言ったでしょ」"
msgstr "  I already told you, even in our world, her magecraft is considered over-the-top and unspeakably horrible.\""

#. Occurrence 6_5:3401:7981: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0012; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:3401
msgctxt "text_id=7981 | speaker=alice"
msgid "「……失礼ね。人命を<脅|おびや>かす、という点なら青子の方がよっぽど酷いと思うけど。"
msgstr "\"...How rude. When it comes to which of us is more of a threat to human life, I think you're far more dangerous than me."

#. Occurrence 6_5:3413:7982: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0013; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:3413
msgctxt "text_id=7982 | speaker=alice"
msgid "　それより貴女、本当に彼を殺す気はあったの？"
msgstr "  And that's besides the point. I'm starting to harbor doubts about you even wanting to kill him in the first place."

#. Occurrence 6_5:3419:7983: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0014; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:3419
msgctxt "text_id=7983 | speaker=alice"
msgid "　一体どんな追いつめ方をすれば、蒼崎ならたぶん安全、なんて言葉が返ってくるのかしらね」"
msgstr "  You must have been pretty soft on him for him to say he believes that he's 'safe' here.\""

#. Occurrence 6_5:3464:7984: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0021; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3464
msgctxt "text_id=7984 | speaker=aoko"
msgid "「そ―――"
msgstr "\"W-Well..."

msgctxt "text_id=7985 | speaker=unknown"
msgid "そんなのあったに決まってるでしょ！"
msgstr " Of course I wanted to kill him!"

#. Occurrence 6_5:3478:7986: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0022; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3478
msgctxt "text_id=7986 | speaker=aoko"
msgid "　コイツがなんて言ったか知らないけど、ぜったい意味違うから！"
msgstr "  I don't know what he's told you, but you've got it all twisted!"

#. Occurrence 6_5:3484:7987: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0023; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3484
msgctxt "text_id=7987 | speaker=aoko"
msgid "　<草十郎|コイツ>はね、そもそも何が危ないのか<火傷|ヤケド>するまで気付かない……"
msgstr "  This guy doesn't realize he's in danger until he gets burned."

#. Occurrence 6_5:3496:7988: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0024; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3496
msgctxt "text_id=7988 | speaker=aoko"
msgid "っていうか、火傷しても“よし、死ななきゃ安い”なんて本気で思っちゃう天然ボケなのっ！"
msgstr "And even then, he'd probably think 'well at least I'm still alive' and whistle all the way home!"

#. Occurrence 6_5:3531:7989: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_5_0025; voice_prefix=A10; voice_category=1; scene=6_5
#: 6_5:3531
msgctxt "text_id=7989 | speaker=aoko"
msgid "　ね、そうでしょ草十郎！？」"
msgstr "  Isn't that right, Soujyuro?!\""

#. Occurrence 6_5:3567:7990: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_5_0011; voice_prefix=A30; voice_category=3; scene=6_5
#: 6_5:3567
msgctxt "text_id=7990 | speaker=soujuurou"
msgid "「え？」"
msgstr "\"Huh?\""

#. Occurrence 6_5:3572:7991: scene=6_5
#: 6_5:3572
msgctxt "text_id=7991 | speaker=unknown"
msgid "　とつぜん怒鳴られ、よく分からないクセに「うん、まあ」とうなずく天然なんとか。"
msgstr "  He had no idea why she was suddenly shouting, but he nodded anyway just to be safe."

#. Occurrence 6_5:3610:7992: scene=6_5
#: 6_5:3610
msgctxt "text_id=7992 | speaker=unknown"
msgid "　居間は騒がしいコトこの上ない。"
msgstr "  The drawing room had become awfully noisy."

#. Occurrence 6_5:3621:7993: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_5_0015; voice_prefix=A40; voice_category=2; scene=6_5
#: 6_5:3621
msgctxt "text_id=7993 | speaker=alice"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 6_5:3626:7994: scene=6_5
#: 6_5:3626
msgctxt "text_id=7994 | speaker=unknown"
msgid "　そんなふたりを、有珠は<呆|あき>れたように見つめていた。"
msgstr "  Alice sat watching the two at a complete loss."

#. Occurrence 6_6:54:7995: scene=6_6
#: 6_6:54
msgctxt "text_id=7995 | speaker=unknown"
msgid "　ともあれ、草十郎は洋館での監視生活を承諾した。"
msgstr "  And so, Soujyuro accepted his supervised life in the mansion,"

#. Occurrence 6_6:59:7996: scene=6_6
#: 6_6:59
msgctxt "text_id=7996 | speaker=unknown"
msgid "　魔術を<生業|なりわい>とする者と屋根を同じくすること。"
msgstr "  and that he would be living under the same roof as two professional mages."

#. Occurrence 6_6:64:7997: scene=6_6
#: 6_6:64
msgctxt "text_id=7997 | speaker=unknown"
msgid "　それがどれだけ危険であるのか、身をもって体験させられた上で、"
msgstr "  Having experienced firsthand how dangerous that life could get, he was finally at peace with the situation."

#. Occurrence 6_6:117:7998: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0000; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:117
msgctxt "text_id=7998 | speaker=soujuurou"
msgid "「うん、まあ、そういう事なら」"
msgstr "\"If that's how it's going to be, then oh well.\""

#. Occurrence 6_6:123:7999: scene=6_6
#: 6_6:123
msgctxt "text_id=7999 | speaker=unknown"
msgid "　とてもそうは見えないが、彼なりに真剣に考えた末で、はっきりと答えたのである。"
msgstr "  Even if he did not seem like it, he had thought it through in his own way and come to a clear resolution."

#. Occurrence 6_6:156:8000: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0000; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:156
msgctxt "text_id=8000 | speaker=aoko"
msgid "「それじゃ、やっと本題に入れるわね。"
msgstr "\"Okay, down to business."

#. Occurrence 6_6:162:8001: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0001; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:162
msgctxt "text_id=8001 | speaker=aoko"
msgid "　監視するとは言ったけど、どうやって草十郎を監視するのか。そもそも、貴方を監視する原因になった『魔術』とは何なのか。そのあたり、ざざっと説明させてもらうわ」"
msgstr "  So, I know we said that you'd be under supervision, but we haven't really talked about how we'll be doing that, or the 'magecraft' that is responsible for enforcing it. Let me start with a brief explanation.\""

#. Occurrence 6_6:199:8002: scene=6_6
#: 6_6:199
msgctxt "text_id=8002 | speaker=unknown"
msgid "　新しい規則のレクチャーはきちんと聞くように教育されているのか、草十郎はいいぞ、と身構える。"
msgstr "  Perhaps he was brought up to listen closely to lectures about new information, because Soujyuro suddenly looked attentive."

#. Occurrence 6_6:227:8003: scene=6_6
#: 6_6:227
msgctxt "text_id=8003 | speaker=unknown"
msgid "　一方、有珠はまだ不満があるようで、かたくなに口を閉ざしていた。"
msgstr "  Alice, on the other hand, kept her mouth shut in silent defiance."

#. Occurrence 6_6:274:8004: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0002; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:274
msgctxt "text_id=8004 | speaker=aoko"
msgid "「最初に言っておくと、アンタをここに住まわせる期限は決まってるから。"
msgstr "\"First off, the time you'll be made to live here has been predetermined."

#. Occurrence 6_6:280:8005: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0003; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:280
msgctxt "text_id=8005 | speaker=aoko"
msgid "　要はその期限まで、誰にも私たちの事をしゃべらず、また、勝手に死ななければ晴れて自由の身ってこと。"
msgstr "  In short, until the end of that period, if you don't tell anyone about us or die for some reason, you're free to go."

#. Occurrence 6_6:297:8006: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0004; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:297
msgctxt "text_id=8006 | speaker=aoko"
msgid "　ね、そうよね有珠？」"
msgstr "  Good so far, Alice?\""

#. Occurrence 6_6:337:8007: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0000; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:337
msgctxt "text_id=8007 | speaker=alice"
msgid "「……そうね。わたしたちを怒らせなければ、そういう可能性もあるわね」"
msgstr "\"...Indeed. Provided he refrains from angering us, that is, he has a chance of survival.\""

#. Occurrence 6_6:362:8008: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0001; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:362
msgctxt "text_id=8008 | speaker=soujuurou"
msgid "「よし、いきなり話が食い違ってる」"
msgstr "\"Yup, this is already off on the wrong foot.\""

#. Occurrence 6_6:367:8009: scene=6_6
#: 6_6:367
msgctxt "text_id=8009 | speaker=unknown"
msgid "　<予|う><想|ん><通|う><り|ん>、とうなずく草十郎と、"
msgstr "  Soujyuro's head dropped, like he knew what was coming."

#. Occurrence 6_6:403:8010: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0005; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:403
msgctxt "text_id=8010 | speaker=aoko"
msgid "「ちょっと黙ってて有珠。"
msgstr "\"That's enough, Alice."

#. Occurrence 6_6:419:8011: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0006; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:419
msgctxt "text_id=8011 | speaker=aoko"
msgid "あとアンタも黙ってろ」"
msgstr "And you, shut up.\""

#. Occurrence 6_6:424:8012: scene=6_6
#: 6_6:424
msgctxt "text_id=8012 | speaker=unknown"
msgid "　そんなふたりを睨みつける、気苦労の多い青子。"
msgstr "  She scowled at the two of them, already at her wits' end."

#. Occurrence 6_6:469:8013: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0007; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:469
msgctxt "text_id=8013 | speaker=aoko"
msgid "「……話を続けるけど。"
msgstr "\"As I was saying..."

#. Occurrence 6_6:481:8014: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0008; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:481
msgctxt "text_id=8014 | speaker=aoko"
msgid "　秘密保持のためにアンタを住まわせる場合、二次災害はどうしても避けられない。"
msgstr "  Having you live with us for the sake of confidentiality means other problems are bound to come up."

#. Occurrence 6_6:487:8015: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0009; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:487
msgctxt "text_id=8015 | speaker=aoko"
msgid "　同じ家にいる以上、余計に秘密を見せる事になるからね。有珠はそれがイヤなんだろうけど」"
msgstr "  You'll likely be exposed to even more of our secrets. That's what has Alice so bent out of shape.\""

#. Occurrence 6_6:519:8016: scene=6_6
#: 6_6:519
msgctxt "text_id=8016 | speaker=unknown"
msgid "　言われてみればその通りだ。"
msgstr "  Now that Aoko mentioned it, Soujyuro could see her point."

#. Occurrence 6_6:524:8017: scene=6_6
#: 6_6:524
msgctxt "text_id=8017 | speaker=unknown"
msgid "　監視対象を軟禁した場合、更なる内部事情の<露呈|ろてい>は避けられない。"
msgstr "  With their target of observation under house arrest, the disclosure of more confidential information was inevitable."

#. Occurrence 6_6:561:8018: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0002; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:561
msgctxt "text_id=8018 | speaker=soujuurou"
msgid "「ちょっと待ってくれ。どうどう巡りじゃないか、それ？」"
msgstr "\"Hold on a second. Doesn't that make me being here a little counterproductive?\""

#. Occurrence 6_6:567:8019: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0010; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:567
msgctxt "text_id=8019 | speaker=aoko"
msgid "「大丈夫、問題ないわ。だって、最後にはここで暮らした記憶ごと、私たちの事を忘れてもらう事にしたから」"
msgstr "\"It's not a problem. In the end, we'll just have you forget everything about us, and about living here at all.\""

#. Occurrence 6_6:589:8020: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0003; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:589
msgctxt "text_id=8020 | speaker=soujuurou"
msgid "「―――忘れてもらう？」"
msgstr "\"...Have me forget?\""

#. Occurrence 6_6:610:8021: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0011; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:610
msgctxt "text_id=8021 | speaker=aoko"
msgid "「そ。公園での一件からまるごと全部、忘れてもらう。"
msgstr "\"Right. From the incident in the park onward, you'll forget everything."

#. Occurrence 6_6:616:8022: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0012; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:616
msgctxt "text_id=8022 | speaker=aoko"
msgid "　ルーンっていう魔術系統があるんだけどね、その中でサクッと記憶を忘れさせる物があるのよ。"
msgstr "  There's a kind of magecraft called 'runes' that has the power to make one forget memories."

#. Occurrence 6_6:622:8023: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0013; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:622
msgctxt "text_id=8023 | speaker=aoko"
msgid "　非人道的であるのは変わらないけど、ま、命を消すかわりに記憶を消すって事で妥協して」"
msgstr "  It's a bit inhumane, but erasing memories seems a bit better than, well, erasing your life.\""

#. Occurrence 6_6:649:8024: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0004; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:649
msgctxt "text_id=8024 | speaker=soujuurou"
msgid "「――――蒼崎、それは」"
msgstr "\"...Do I get a say in―\""

#. Occurrence 6_6:674:8025: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0014; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:674
msgctxt "text_id=8025 | speaker=aoko"
msgid "「悪いけど反論は却下。"
msgstr "\"Sorry, but no objections."

#. Occurrence 6_6:680:8026: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0015; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:680
msgctxt "text_id=8026 | speaker=aoko"
msgid "　で、肝心の<忘却|ぼうきゃく>のルーンなんだけど。私も有珠も専門外だから、文献を探して修得するのに時間がかかる。"
msgstr "  Anyway, an amnesia rune is outside of our field of expertise, so it's going to take some time for us to find the rune and learn everything about it."

#. Occurrence 6_6:686:8027: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0016; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:686
msgctxt "text_id=8027 | speaker=aoko"
msgid "　つまり、それが監視の期限ってワケ。"
msgstr "  In other words, that's when you get to leave."

#. Occurrence 6_6:692:8028: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0017; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:692
msgctxt "text_id=8028 | speaker=aoko"
msgid "　私たちが忘却のルーンを見つけるまで、命を担保に口を閉じていてもらうわ」"
msgstr "  Until we find this rune, we're using your life as collateral so you keep your mouth shut.\""

#. Occurrence 6_6:719:8029: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0018; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:719
msgctxt "text_id=8029 | speaker=aoko"
msgid "「有珠はそんなややこしい事はせずに、五感全部壊してしまおうなんて言ってるけど。"
msgstr "\"Alice's idea is that we destroy your five senses and be done with you to avoid the extra effort."

#. Occurrence 6_6:732:8030: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0019; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:732
msgctxt "text_id=8030 | speaker=aoko"
msgid "　―――静希君、<彫像生活|リビングスタチュー>とか嫌でしょ？」"
msgstr "  So, Sizuki? What do you say? Fancy becoming a living statue?\""

#. Occurrence 6_6:769:8031: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0005; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:769
msgctxt "text_id=8031 | speaker=soujuurou"
msgid "「む」"
msgstr "\"Hmm.\""

#. Occurrence 6_6:774:8032: scene=6_6
#: 6_6:774
msgctxt "text_id=8032 | speaker=unknown"
msgid "　青子の言っている事は八割納得できる草十郎だったが、最後のリビングスタチュー、という単語はあまりにも意味不明だった。"
msgstr "  Soujyuro only understood about eighty percent of what Aoko had explained, and the last part about a living statue had gone straight over his head."

#. Occurrence 6_6:779:8033: scene=6_6
#: 6_6:779
msgctxt "text_id=8033 | speaker=unknown"
msgid "　できるかぎり想像力を働かせるも、こう、キッツィーちゃんばりのクリーチャーしか想像できない。"
msgstr "  He had tried his best to visualize what Aoko was going on about, but the only thing he could conjure in his mind was an image of the mascot creature Kitsy."

#. Occurrence 6_6:800:8034: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0006; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:800
msgctxt "text_id=8034 | speaker=soujuurou"
msgid "「うん。それは、たしかにイヤだな」"
msgstr "\"Yeah, I'd rather not.\""

#. Occurrence 6_6:824:8035: scene=6_6
#: 6_6:824
msgctxt "text_id=8035 | speaker=unknown"
msgid "　難しい顔で頷く草十郎に、青子もでしょう、と同意する。二人の<齟齬|そご>はとても深い。"
msgstr "  Aoko agreed with the bewildered Soujyuro, neither one the wiser to the other's misinterpretation."

#. Occurrence 6_6:864:8036: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0020; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:864
msgctxt "text_id=8036 | speaker=aoko"
msgid "「とにかく、遅くても一ヶ月で“忘却のルーン”は見つけだせるだろうし、一回きりの実行ならプラス二ヶ月ぐらいでなんとかなるわ。"
msgstr "\"Anyway, at most it will probably take about a month to find this amnesia rune, and another two to put it to use."

#. Occurrence 6_6:870:8037: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0021; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:870
msgctxt "text_id=8037 | speaker=aoko"
msgid "　それまで<草十郎|アンタ>にはここで暮らしてもらうワケだけど……私たちについて無知なまま歩き回られると、命の保証はできないのよ」"
msgstr "  Until then, that means you'll be living with us. However, we can't just let you wander around without a clue what's going on. That's a surefire way to get yourself killed.\""

#. Occurrence 6_6:891:8038: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0022; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:891
msgctxt "text_id=8038 | speaker=aoko"
msgid "「そっちもこっちの事情を知らないのは気持ち悪いだろうし。なんで、今から簡潔に、現代の魔法使いのなんたるかを教えてあげる。"
msgstr "\"I doubt you would be comfortable being left in the dark about us, either. So starting now, I'm going to fill you in on what it's like to be a modern magician."

#. Occurrence 6_6:897:8039: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0023; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:897
msgctxt "text_id=8039 | speaker=aoko"
msgid "　それで少しは私たちへの勘違いもなくなるだろうし」"
msgstr "  At the very least, it'll hopefully prevent any more misunderstandings.\""

#. Occurrence 6_6:926:8040: scene=6_6
#: 6_6:926
msgctxt "text_id=8040 | speaker=unknown"
msgid "　ま、この山奥育ちに現代も過去もないだろうけど、と青子は自分の台詞に苦笑いをこぼした。"
msgstr "  Not that she thought this country bumpkin had any idea of old or new anyway. The thought brought a smug grin to her lips."

#. Occurrence 6_6:957:8041: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0024; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:957
msgctxt "text_id=8041 | speaker=aoko"
msgid "「洋館のことは後にして、まずは<魔術師|わたしたち>の立場についてね。"
msgstr "\"Let's leave a tour of the mansion for later, and start with who and what mages are."

#. Occurrence 6_6:963:8042: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0025; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:963
msgctxt "text_id=8042 | speaker=aoko"
msgid "　あ、でも一から百まで理解する必要はないから。"
msgstr "  And don't worry―you don't need to understand everything right away."

#. Occurrence 6_6:969:8043: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0026; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:969
msgctxt "text_id=8043 | speaker=aoko"
msgid "　どうせ門外漢なんだし、感じ入った事だけしっかり噛みしめておきなさい」"
msgstr "  You're an outsider, after all, so just bite off only what you can chew.\""

#. Occurrence 6_6:1003:8044: scene=6_6
#: 6_6:1003
msgctxt "text_id=8044 | speaker=unknown"
msgid "　教師めいた言葉に、草十郎は素直に頷いた。"
msgstr "  Soujyuro nodded obediently to Aoko's professorial instructions."

#. Occurrence 6_6:1008:8045: scene=6_6
#: 6_6:1008
msgctxt "text_id=8045 | speaker=unknown"
msgid "　要するに、理解できない事は聞き返さなくていい、と青子は言ったのだ。"
msgstr "  This was Aoko's way of telling him not to ask questions when he did not understand something."

#. Occurrence 6_6:1013:8046: scene=6_6
#: 6_6:1013
msgctxt "text_id=8046 | speaker=unknown"
msgid "　その発言自体に納得のいかない草十郎だったが、聞き返すのはダメらしいので素直に従った。"
msgstr "  And though Soujyuro had taken issue with her statement, he meekly obeyed knowing better than to object now."

#. Occurrence 6_6:1052:8047: scene=6_6
#: 6_6:1052
msgctxt "text_id=8047 | speaker=unknown"
msgid "　よろしい、と頷いて、青子は話をはじめる。"
msgstr "  Aoko nodded approvingly at his attentiveness, and started her lecture."

#. Occurrence 6_6:1057:8048: scene=6_6
#: 6_6:1057
msgctxt "text_id=8048 | speaker=unknown"
msgid "　長く、それは長くなる話を。"
msgstr "  Her long, long lecture."

#. Occurrence 6_6:1092:8049: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0027; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1092
msgctxt "text_id=8049 | speaker=aoko"
msgid "「まず魔術師、魔法使いの話からね。"
msgstr "\"Let's start with mages-magicians, basically."

#. Occurrence 6_6:1098:8050: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0028; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1098
msgctxt "text_id=8050 | speaker=aoko"
msgid "　<魔|・><術|・>と<魔|・><法|・>の違いは草十郎には関わりのない話だからしないけど、それぞれ別種の物だと思ってくれればいいわ。"
msgstr "  Since it doesn't concern you, I'll skip the part about how magecraft and Magic are not the same. All you need to remember is that they are two different things."

#. Occurrence 6_6:1113:8051: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0029; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1113
msgctxt "text_id=8051 | speaker=aoko"
msgid "　で、魔術師の事だけど、これは絶対条件として隠された存在でなくてはならないの。"
msgstr "  Mages, as an absolute rule, must operate in secrecy."

#. Occurrence 6_6:1119:8052: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0030; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1119
msgctxt "text_id=8052 | speaker=aoko"
msgid "　<魔術師|どうぎょうしゃ>に知られるのは仕方ないとしても、貴方みたいに関わりのない人間に知られるのは罪にあたる。ほとんど死罪クラスのね」"
msgstr "  Naturally, mages will find out about other mages, so it's only a crime if an outsider like you finds out about one of us. A crime punishable by death, I should add.\""

#. Occurrence 6_6:1140:8053: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0031; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1140
msgctxt "text_id=8053 | speaker=aoko"
msgid "「何故かって言うと、魔術ってのは隠されていないと力が薄れてしまうものだから。"
msgstr "\"The reason being, that the more magecraft is exposed, the weaker it becomes."

#. Occurrence 6_6:1146:8054: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0032; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1146
msgctxt "text_id=8054 | speaker=aoko"
msgid "　神秘の語源は閉ざす、というギリシャ語だけど、魔術は限られた密儀でなければ魔術でなくなってしまう。"
msgstr "  You'll often hear us say 'Mystic' or 'mystery,' which come from a Greek word that means 'to shut the mouth.' It follows that magecraft would cease to be if its secrets were revealed."

#. Occurrence 6_6:1152:8055: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0033; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1152
msgctxt "text_id=8055 | speaker=aoko"
msgid "　文明にとって、未知なるモノ、未開なる<場所|モノ>は<拓|ひら>かれていないからこそ恐怖に値するのと同じね」"
msgstr "  Civilization has always treated the unexplored and the unknown as things to be feared because of their mysterious nature.\""

#. Occurrence 6_6:1196:8056: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0034; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1196
msgctxt "text_id=8056 | speaker=aoko"
msgid "「知られたら迫害されるから隠す、じゃないの。"
msgstr "\"But we don't hide ourselves because we fear persecution if we're discovered."

#. Occurrence 6_6:1202:8057: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0035; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1202
msgctxt "text_id=8057 | speaker=aoko"
msgid "　未知でなくなった魔術師……というより魔術ね。"
msgstr "  What we fear is the loss of the unknown itself."

#. Occurrence 6_6:1208:8058: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0036; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1208
msgctxt "text_id=8058 | speaker=aoko"
msgid "　明かされた魔術は力を弱めてしまう。だから<隠匿|いんとく>するのよ。何より、<魔術師|わたしたち>の未来のために」"
msgstr "  When our arts are revealed, they become weaker. So by protecting our secrecy, we're also protecting our own future.\""

#. Occurrence 6_6:1247:8059: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0007; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:1247
msgctxt "text_id=8059 | speaker=soujuurou"
msgid "「……魔術の仕組みはよく分からないけど、とにかく自分だけの秘密でないと弱くなるって事か。"
msgstr "\"...I'm not clear on how magecraft works yet, but I think what you're saying is that if you don't keep it a secret, it gets weaker."

#. Occurrence 6_6:1259:8060: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0008; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:1259
msgctxt "text_id=8060 | speaker=soujuurou"
msgid "　じゃあ蒼崎も弱くなってるのか？　俺が見ちゃったから」"
msgstr "  So then, does that mean you got weaker now that I saw you, Aozaki?\""

#. Occurrence 6_6:1293:8061: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0037; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1293
msgctxt "text_id=8061 | speaker=aoko"
msgid "「いいえ、別に。"
msgstr "\"No, not particularly."

#. Occurrence 6_6:1305:8062: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0038; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1305
msgctxt "text_id=8062 | speaker=aoko"
msgid "　……ここからはちょっと込みいった話でね。"
msgstr "  ...Let me explain in a little more detail."

#. Occurrence 6_6:1311:8063: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0039; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1311
msgctxt "text_id=8063 | speaker=aoko"
msgid "　弱くなる、っていうのはあくまで全体、それも随分と未来の話。個人単位では関係のない話よ。"
msgstr "  When I say it loses power, I mean magecraft as a whole will get weaker in the future. I'm not talking about individuals."

#. Occurrence 6_6:1323:8064: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0040; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1323
msgctxt "text_id=8064 | speaker=aoko"
msgid "　汝、<隠匿|いんとく>すべし―――って不文律は、この大本の仕組みが<形骸|けいがい>化して、いつのまにか絶対のルールになっているだけなの」"
msgstr "  The unwritten law that 'Thou shalt conceal thyself' was an adage from a bygone age, but at some point it became a law of the highest order.\""

#. Occurrence 6_6:1365:8065: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0041; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1365
msgctxt "text_id=8065 | speaker=aoko"
msgid "「文明社会の法律と一緒よ。犯罪、不道徳を罰するのは人間的であろうとする意識の高さと、それとはまったく別の、全体の仕組みを守るための構造的な結論でしょ。"
msgstr "\"It's like laws in a civilized society: we like to think that it's human nature to punish crime and immorality, but ultimately a structural solution is needed to maintain order."

#. Occurrence 6_6:1371:8066: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0042; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1371
msgctxt "text_id=8066 | speaker=aoko"
msgid "　犯罪が罰せられるのは、野放しにしたらせっかく築いた社会がうまく機能しなくなるから。"
msgstr "  If crimes were left unpunished, the society we strived so hard to build would collapse."

#. Occurrence 6_6:1377:8067: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0043; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1377
msgctxt "text_id=8067 | speaker=aoko"
msgid "　で、<魔|わ><術|た><師|し>たちにとって犯罪にあたるのは神秘の一般化、低俗化であって、不道徳とか殺人とかは―――ま、それぞれの良心次第ってコトで、基本的に罪にもならない」"
msgstr "  And what we mages consider to be a crime is dissemination and vulgarization of the Mystic. Merely immoral things like murder, well... those are a matter of perspective, and they generally aren't considered outright crimes.\""

#. Occurrence 6_6:1420:8068: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0044; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1420
msgctxt "text_id=8068 | speaker=aoko"
msgid "そんなろくでもない連中にルールを敷いたのが、魔術協会っていう集まり。組合みたいなものよ。"
msgstr "\"The good-for-nothing bunch responsible for imposing this law is a group called the Mage's Association. Think of them as a labor union."

#. Occurrence 6_6:1426:8069: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0045; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1426
msgctxt "text_id=8069 | speaker=aoko"
msgid "“魔術を不朽の神秘とせよ”……というのは、魔術を魔術として永続させるために敷いたルールにすぎないわ」"
msgstr "The phrase 'Make eternal the mysticism of magecraft' is nothing more than a rule they created to perpetuate magecraft itself.\""

#. Occurrence 6_6:1464:8070: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0046; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1464
msgctxt "text_id=8070 | speaker=aoko"
msgid "「けど、その原則は絶対でさ。"
msgstr "\"Nevertheless, the rule is absolute."

#. Occurrence 6_6:1470:8071: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0047; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1470
msgctxt "text_id=8071 | speaker=aoko"
msgid "　これを破った者は、魔術世界には居られなくなる。"
msgstr "  Those who violate it cease to exist in the magical world."

#. Occurrence 6_6:1476:8072: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0048; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1476
msgctxt "text_id=8072 | speaker=aoko"
msgid "　いえ、実際問題として、<生|・><き|・><て|・><い|・><く|・><の|・><が|・><困|・><難|・><に|・><な|・><る|・>。"
msgstr "  Or rather, it would be difficult for them to go on living at all."

#. Occurrence 6_6:1519:8073: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0049; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1519
msgctxt "text_id=8073 | speaker=aoko"
msgid "　私たちは私たちの……まあ、魔術師としての命？"
msgstr "  For us, that's our...well, our life as mages, I guess."

#. Occurrence 6_6:1525:8074: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0050; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1525
msgctxt "text_id=8074 | speaker=aoko"
msgid "　そういうのを守るために、目撃者であるアンタを消さなくちゃいけなかった」"
msgstr "  In order to protect it, we had no choice but to erase you, the witness to our magecraft.\""

#. Occurrence 6_6:1560:8075: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0009; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:1560
msgctxt "text_id=8075 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 6_6:1579:8076: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0051; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1579
msgctxt "text_id=8076 | speaker=aoko"
msgid "「そこ、同情とかしなくていいから。私たちの事情を知ったぐらいで、遊園地のことを帳消しにしないでよ。"
msgstr "\"Don't give me those puppy-dog eyes. Just because you know a little about our lives doesn't mean we're not fessing up to what happened at the amusement park."

#. Occurrence 6_6:1585:8077: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0052; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1585
msgctxt "text_id=8077 | speaker=aoko"
msgid "　私たちは私たちの判断でアンタを殺そうとしたんだから、誰彼のせいってワケじゃない。"
msgstr "  It was our decision to try and kill you. It wasn't anyone else's fault."

#. Occurrence 6_6:1598:8078: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0053; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1598
msgctxt "text_id=8078 | speaker=aoko"
msgid "　恨むなら、きちんと私を恨んでちょうだい」"
msgstr "  So if you're going to blame anyone, blame me.\""

#. Occurrence 6_6:1637:8079: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0054; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1637
msgctxt "text_id=8079 | speaker=aoko"
msgid "「ま、それはともかく。"
msgstr "\"Okay, back to the topic."

#. Occurrence 6_6:1643:8080: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0055; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1643
msgctxt "text_id=8080 | speaker=aoko"
msgid "　過去、魔術師は職業として成りたったぐらい社会に認知されていたけど、その魔術自体は墓まで持っていく秘密だった。"
msgstr "  In the past, mages were recognized in society enough for it to be considered an occupation, but they took their own magecraft with them to their graves."

#. Occurrence 6_6:1650:8081: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0056; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1650
msgctxt "text_id=8081 | speaker=aoko"
msgid "それがどう<歪|ゆが>んだかは知らないけど、現代ではその職業すら秘密にしなくてはならなくなった。"
msgstr "I don't know what led to things getting so twisted, but even the profession itself has to be kept secret these days."

#. Occurrence 6_6:1656:8082: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0057; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1656
msgctxt "text_id=8082 | speaker=aoko"
msgid "　そこまでしないと、遠い未来、魔術すら消費するだけのものに解体されると協会は恐れたのよ」"
msgstr "  If they didn't go that far, the Association feared that in the distant future, magecraft would be used up and the Association would fall apart.\""

#. Occurrence 6_6:1677:8083: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0058; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1677
msgctxt "text_id=8083 | speaker=aoko"
msgid "「自然界の仕組みも、かつて天上の領域だった宇宙の運営すら、私たちは人智で解き明かせるほどになった。"
msgstr "\"We had reached a point where everything became explainable through human knowledge, from the building blocks of nature to the fabric of the cosmos, once considered to be the realm of the gods."

#. Occurrence 6_6:1683:8084: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0059; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1683
msgctxt "text_id=8084 | speaker=aoko"
msgid "　人の手にあまるもの。神秘という未知の領域にとって、魔術が最後の砦になると協会の設立者は信じたのかもしれない。"
msgstr "  Maybe the founders believed that magecraft would become the last bastion for the unknown, for Mystics-that which is beyond human reach."

#. Occurrence 6_6:1689:8085: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0060; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1689
msgctxt "text_id=8085 | speaker=aoko"
msgid "　それとも、魔術なんてもう意味がないって達観したのかもね」"
msgstr "  Or maybe, they thought that in the long run magecraft would eventually become meaningless.\""

#. Occurrence 6_6:1736:8086: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0061; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1736
msgctxt "text_id=8086 | speaker=aoko"
msgid "「そんなわけで、魔術師はその正体を隠して各々の秘儀を伝えていった。他人に教えるワケにはいかないから、必然的にその伝承者は子孫になる。"
msgstr "\"Whatever the reason, mages hid their identities and passed on their individual rituals in secret. And since they couldn't pass it on to outsiders, it was only natural that they taught it to their descendants."

#. Occurrence 6_6:1742:8087: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0062; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1742
msgctxt "text_id=8087 | speaker=aoko"
msgid "　私も有珠も、そうやって何代か続いた連中の<末|すえ>なのよ。"
msgstr "  Alice and I are both products of generations of lineage."

#. Occurrence 6_6:1748:8088: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0063; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1748
msgctxt "text_id=8088 | speaker=aoko"
msgid "　さっき言った魔術協会っていうのは、そんな細々と続いてる連中を束ねる一大組織。魔術師にとって司法の神ってところかしらね」"
msgstr "  The Mage's Association I mentioned earlier is a vast organization that governs those magecraft wielders still dedicated to their field. Mages think of them as their ruling body.\""

#. Occurrence 6_6:1769:8089: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0064; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1769
msgctxt "text_id=8089 | speaker=aoko"
msgid "「協会も色んな派閥に分かれるんだけど、大抵の魔術師はロンドンの魔術協会に属している。"
msgstr "\"The Association is actually made up of a bunch of factions, and the vast majority of mages are affiliated with the London chapter."

#. Occurrence 6_6:1769:8090: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0064; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1769
msgctxt "text_id=8090 | speaker=aoko"
msgid "　汝隠匿すべしっていうのも協会の三大原則の一つよ。"
msgstr "  The law to conceal ourselves was one of their three main principles."

#. Occurrence 6_6:1775:8091: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0065; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1775
msgctxt "text_id=8091 | speaker=aoko"
msgid "　魔術師が一般人に秘密を漏らすと協会から罰が下される仕組みになっている。"
msgstr "  If a mage reveals their secret to a civilian, the Association is quick to make an example of them."

#. Occurrence 6_6:1781:8092: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0066; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1781
msgctxt "text_id=8092 | speaker=aoko"
msgid "　ま、そんな罰なんかなくても、自分と血族が伝えた魔術のために、目撃者は消さないといけないんだけど」"
msgstr "  But even if the mage doesn't get punished, the witness should still be eliminated to protect the mage and their family's magecraft.\""

#. Occurrence 6_6:1829:8093: scene=6_6
#: 6_6:1829
msgctxt "text_id=8093 | speaker=unknown"
msgid "　まずはここまで、と青子は話を区切る。"
msgstr "  And that was the end of the first part of the lecture. Aoko paused for a moment."

#. Occurrence 6_6:1834:8094: scene=6_6
#: 6_6:1834
msgctxt "text_id=8094 | speaker=unknown"
msgid "　草十郎は草十郎なりに話をまとめているようだ。"
msgstr "  Soujyuro was doing his best to process the information."

#. Occurrence 6_6:1867:8095: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0067; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1867
msgctxt "text_id=8095 | speaker=aoko"
msgid "「次いくけど、いい？」"
msgstr "\"Ready to move on?\""

#. Occurrence 6_6:1887:8096: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0010; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:1887
msgctxt "text_id=8096 | speaker=soujuurou"
msgid "「いいけど、その前に確認したい。"
msgstr "\"Sure, but let me see if I understand so far:"

#. Occurrence 6_6:1899:8097: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0011; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:1899
msgctxt "text_id=8097 | speaker=soujuurou"
msgid "　魔術師が正体を隠すのは自分のためじゃなく魔術のためだったけど、最近では自分の正体を隠すことの方が重要になっている。"
msgstr "  Mages used to hide their identities not for their own sake, but for the sake of magecraft. Now, they're more concerned with hiding themselves."

#. Occurrence 6_6:1906:8098: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0012; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:1906
msgctxt "text_id=8098 | speaker=soujuurou"
msgid "そして、その決まりを破ると協会というところからお<咎|とが>めがくる。"
msgstr "And if you break the rules, you'll be punished by a place called the Association."

#. Occurrence 6_6:1918:8099: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0013; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:1918
msgctxt "text_id=8099 | speaker=soujuurou"
msgid "　……つまり、蒼崎たちもその協会に入っているのか？」"
msgstr "  ...Does that mean that you two are members of the Association?\""

#. Occurrence 6_6:1958:8100: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0068; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1958
msgctxt "text_id=8100 | speaker=aoko"
msgid "「いいえ、私たちはフリーよ。いちおう協会と繋がりはあるけどね。"
msgstr "\"No, we're freelance, though we walk in similar circles."

#. Occurrence 6_6:1965:8101: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0069; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1965
msgctxt "text_id=8101 | speaker=aoko"
msgid "単純に、協会は最大勢力ってだけ。連中は頼まれもしないのに魔術世界全体の秩序を守ってるの。"
msgstr "They're simply the largest organized group. Even though no one asked them to, they've taken it upon themselves to police the world of magecraft."

#. Occurrence 6_6:1971:8102: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0070; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:1971
msgctxt "text_id=8102 | speaker=aoko"
msgid "　だから私たちが何であれ、彼らとの関わりがないにしても、魔術師としての決まりを破ったら罰しにくるわ」"
msgstr "  So no matter how unaffiliated we are as mages, if we break the rules we'll get punished anyway.\""

#. Occurrence 6_6:2006:8103: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0014; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2006
msgctxt "text_id=8103 | speaker=soujuurou"
msgid "「……分かった。だいたい呑みこめた」"
msgstr "\"...Okay. I think I got the gist of it.\""

#. Occurrence 6_6:2012:8104: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0071; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2012
msgctxt "text_id=8104 | speaker=aoko"
msgid "「よしよし。そうやって自分に必要な部分だけ手に入れなさい。"
msgstr "\"It's all right. Just focus on the parts important to you."

#. Occurrence 6_6:2018:8105: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0072; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2018
msgctxt "text_id=8105 | speaker=aoko"
msgid "　じゃ、次は魔術について。……といっても、私自身、語れるほど学んでいないんだけどね」"
msgstr "  Next is magecraft. Though... I've barely learned enough to talk about it, myself.\""

#. Occurrence 6_6:2024:8106: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0015; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2024
msgctxt "text_id=8106 | speaker=soujuurou"
msgid "「？」"
msgstr "\"?\""

#. Occurrence 6_6:2047:8107: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0073; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2047
msgctxt "text_id=8107 | speaker=aoko"
msgid "「ごめん、こっちの話だから忘れて。"
msgstr "\"Sorry, forget I said that."

#. Occurrence 6_6:2053:8108: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0074; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2053
msgctxt "text_id=8108 | speaker=aoko"
msgid "　―――さっきも言ったけど、現代において魔術は無意味な物になりつつある。"
msgstr "  ...I touched on this already, but these days, magecraft is losing its meaning."

#. Occurrence 6_6:2059:8109: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0075; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2059
msgctxt "text_id=8109 | speaker=aoko"
msgid "　ライターのない大昔なら火を起こせればそれは<神秘|まじゅつ>として成り立つわ。けど<現代|いま>は何かと便利でしょう？　貴方ならよく分かると思うけど」"
msgstr "  If you created fire a long time ago when there were no lighters, that was enough to count as a Mystic feat. But nowadays, life is awfully convenient, right? You of all people can appreciate that.\""

#. Occurrence 6_6:2105:8110: scene=6_6
#: 6_6:2105
msgctxt "text_id=8110 | speaker=unknown"
msgid "　青子の問いかけに、草十郎はまあ、と浮かない顔で同意した。"
msgstr "  Soujyuro nodded with a glum look on his face."

#. Occurrence 6_6:2110:8111: scene=6_6
#: 6_6:2110
msgctxt "text_id=8111 | speaker=unknown"
msgid "　草十郎も、その便利さを痛いほど実感している。"
msgstr "  He had been made painfully aware of such conveniences."

#. Occurrence 6_6:2115:8112: scene=6_6
#: 6_6:2115
msgctxt "text_id=8112 | speaker=unknown"
msgid "　山では一日かける大仕事が、ここでは簡単に出来てしまう。"
msgstr "  Difficult tasks that would occupy an entire day of work in the mountains, could be performed easily here."

#. Occurrence 6_6:2121:8113: scene=6_6
#: 6_6:2121
msgctxt "text_id=8113 | speaker=unknown"
msgid "電気も水道もない世界で育った彼にしてみれば、都会の生活そのものが魔法だ。"
msgstr "For him, having been brought up in the mountains without electricity or running water, city life was by definition magic."

#. Occurrence 6_6:2126:8114: scene=6_6
#: 6_6:2126
msgctxt "text_id=8114 | speaker=unknown"
msgid "　この便利さが常識なのだと順応するのに、どれだけ苦労したことか。"
msgstr "  He only wished it would not be such backbreaking work to adapt to said conveniences."

#. Occurrence 6_6:2153:8115: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0016; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2153
msgctxt "text_id=8115 | speaker=soujuurou"
msgid "「あ。"
msgstr "\"Oh."

#. Occurrence 6_6:2160:8116: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0017; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2160
msgctxt "text_id=8116 | speaker=soujuurou"
msgid "でも、道具を使わずに火を起こせるのは神さまの仕事だと思うけど」"
msgstr "I do think that creating fire without tools should be a god's job, though.\""

#. Occurrence 6_6:2185:8117: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0076; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2185
msgctxt "text_id=8117 | speaker=aoko"
msgid "「そのために積み重ねた手間は、火炎放射器を手に入れるより面倒だとしても？」"
msgstr "\"Even though we've worked out how to do it more efficiently with a flamethrower?\""

#. Occurrence 6_6:2213:8118: scene=6_6
#: 6_6:2213
msgctxt "text_id=8118 | speaker=unknown"
msgid "　青子の言葉に、草十郎は答えられない。"
msgstr "  Soujyuro wasn't sure how to answer Aoko."

#. Occurrence 6_6:2218:8119: scene=6_6
#: 6_6:2218
msgctxt "text_id=8119 | speaker=unknown"
msgid "　人間が神さまの真似事をする為にはどれだけの尽力があったのか、安易に答える事は彼女への侮辱だと思ったからだ。"
msgstr "  It would have been easy for him to ask Aoko how much accumulated effort she thought it had taken humans to imitate those gods, but he knew it would come across as an insult."

#. Occurrence 6_6:2256:8120: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0018; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2256
msgctxt "text_id=8120 | speaker=soujuurou"
msgid "「……。さっきのを見るかぎり、魔術ってのはなんでも出来ると思ったけど、それは誤解なのか」"
msgstr "\"...From what I just saw, I was under the impression that magecraft could do anything, but maybe I misunderstood.\""

#. Occurrence 6_6:2262:8121: scene=6_6
#: 6_6:2262
msgctxt "text_id=8121 | speaker=unknown"
msgid "　ちらり、とテーブルの上の小瓶に目をやる草十郎。"
msgstr "  He glanced at the glass bottle on the table."

#. Occurrence 6_6:2267:8122: scene=6_6
#: 6_6:2267
msgctxt "text_id=8122 | speaker=unknown"
msgid "　内心、それはそれでホッとできる。"
msgstr "  Mentally, he sighed in relief."

#. Occurrence 6_6:2272:8123: scene=6_6
#: 6_6:2272
msgctxt "text_id=8123 | speaker=unknown"
msgid "　あんな小瓶の中に閉じこめられていたなんて、今でも現実だと信じられない。"
msgstr "  He still had not come to terms with the fact that he had been trapped inside that tiny thing."

#. Occurrence 6_6:2315:8124: scene=6_6
#: 6_6:2315
msgctxt "text_id=8124 | speaker=unknown"
msgid "　―――しかし。"
msgstr "  However..."

#. Occurrence 6_6:2322:8125: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0077; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2322
msgctxt "text_id=8125 | speaker=aoko"
msgid "「あら、それこそ誤解よ。"
msgstr "\"Oh, that's a misunderstanding all right."

#. Occurrence 6_6:2322:8126: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0077; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2322
msgctxt "text_id=8126 | speaker=aoko"
msgid "　万能じゃなければ誰が魔術なんて学ぶと思ってるの？」"
msgstr "  If magecraft wasn't all-powerful, why would anyone bother to learn it?\""

#. Occurrence 6_6:2349:8127: scene=6_6
#: 6_6:2349
msgctxt "text_id=8127 | speaker=unknown"
msgid "　胸を張って青子は言い返した。"
msgstr "  Aoko puffed out her chest as she chided him."

#. Occurrence 6_6:2376:8128: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0078; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2376
msgctxt "text_id=8128 | speaker=aoko"
msgid "「手間暇かかるけど、魔術に出来ない事はないわ。"
msgstr "\"It might take some doing, but there's nothing magecraft can't do."

#. Occurrence 6_6:2382:8129: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0079; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2382
msgctxt "text_id=8129 | speaker=aoko"
msgid "　中には“出来ていないけど出来ているように見せる”みたいな、何らかのイカサマはあるけどね。"
msgstr "  Granted, some users are able to trick you into thinking something's possible when it really isn't."

#. Occurrence 6_6:2388:8130: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0080; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2388
msgctxt "text_id=8130 | speaker=aoko"
msgid "　この世界に生まれた以上、その許容範囲で出来ない事なんてないの。そこで魔法がでてくるんだけど、それはまた改めて」"
msgstr "  But since we were born into this world, there's nothing that we can't do within its limits. Besides True Magic, of course, but we'll get into that some other time.\""

#. Occurrence 6_6:2426:8131: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0081; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2426
msgctxt "text_id=8131 | speaker=aoko"
msgid "「私が言いたかったのは、魔術は奇跡を起こしているのではなくて、その過程が奇跡だってこと。"
msgstr "\"What I'm trying to say is that magecraft doesn't create miracles. It's only the process that's miraculous."

#. Occurrence 6_6:2432:8132: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0082; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2432
msgctxt "text_id=8132 | speaker=aoko"
msgid "　結果が奇跡になるのは魔法の方なの」"
msgstr "  To produce a real miracle, you need True Magic.\""

#. Occurrence 6_6:2459:8133: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0083; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2459
msgctxt "text_id=8133 | speaker=aoko"
msgid "「偉大な魔術師っていうのは、個人の魔術だけで旅客機飛ばしたりする人のこと。"
msgstr "\"A great mage is someone who can fly a passenger jet with only their own magecraft."

#. Occurrence 6_6:2465:8134: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0084; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2465
msgctxt "text_id=8134 | speaker=aoko"
msgid "　対して、偉大な魔法使いっていうのは、<現|い><在|ま>不可能な事を可能にする人の事よ。"
msgstr "  Meanwhile, a Magician deals in making the impossible possible."

#. Occurrence 6_6:2484:8135: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0085; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2484
msgctxt "text_id=8135 | speaker=aoko"
msgid "　……そういった意味じゃ、私たちは最後の魔法使いになるかも知れないけどね」"
msgstr "  ...Which is why we might just turn out to be the last Magicians.\""

#. Occurrence 6_6:2523:8136: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0001; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:2523
msgctxt "text_id=8136 | speaker=alice"
msgid "「脱線してるわよ、青子」"
msgstr "\"Focus, Aoko.\""

#. Occurrence 6_6:2529:8137: scene=6_6
#: 6_6:2529
msgctxt "text_id=8137 | speaker=unknown"
msgid "　触れてはいけない一線に踏みこんだのか。"
msgstr "  Alice had been quietly listening until she muttered her rebuke,"

#. Occurrence 6_6:2534:8138: scene=6_6
#: 6_6:2534
msgctxt "text_id=8138 | speaker=unknown"
msgid "　黙って聞いていた有珠が、<窘|たしな>めるように呟いた。"
msgstr "  as if Aoko had crossed a line."

#. Occurrence 6_6:2561:8139: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0002; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:2561
msgctxt "text_id=8139 | speaker=alice"
msgid "「……そこまで教える必要はないでしょう。"
msgstr "\"He doesn't need to know that."

#. Occurrence 6_6:2567:8140: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0003; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:2567
msgctxt "text_id=8140 | speaker=alice"
msgid "　静希君に教えるべき事は、わたしたちと暮らす上で危険になる事だけじゃなかった？」"
msgstr "  Shouldn't we be educating Sizuki on the dangers of living with us?\""

#. Occurrence 6_6:2612:8141: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0086; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2612
msgctxt "text_id=8141 | speaker=aoko"
msgid "「悪かったわ、ちょい口<滑|すべ>らせた。"
msgstr "\"Sorry. You're right. Slip of the tongue."

#. Occurrence 6_6:2624:8142: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0087; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2624
msgctxt "text_id=8142 | speaker=aoko"
msgid "　ともかく、魔術師っていうのは暇さえあれば魔術の実験をしてる連中で―――自分の家系が伝えてきた秘儀を守るためなら鬼でも悪魔にでもなる」"
msgstr "  Anyway, mages spend every waking moment experimenting in magecraft, and would become devils in a heartbeat in order to protect their magecraft, by which I mean their family secrets.\""

#. Occurrence 6_6:2651:8143: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0088; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2651
msgctxt "text_id=8143 | speaker=aoko"
msgid "「必然、そのアジト……工房って言うんだけど、工房も魔術的な機構が積み重なって、要塞みたいになっちゃうのよ。"
msgstr "\"Their lairs―which we call workshops―are like fortresses packed with all kinds of magical mechanisms."

#. Occurrence 6_6:2657:8144: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0089; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2657
msgctxt "text_id=8144 | speaker=aoko"
msgid "　秘儀を守るために、入ってきた相手を問答無用で叩きのめす仕掛けとか。"
msgstr "  Like traps that kill intruders before they even know what hit them. It's all to protect our secrets."

#. Occurrence 6_6:2669:8145: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0090; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2669
msgctxt "text_id=8145 | speaker=aoko"
msgid "　この洋館も、そういった工房と同じなの。"
msgstr "  This mansion is no different."

#. Occurrence 6_6:2675:8146: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0091; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2675
msgctxt "text_id=8146 | speaker=aoko"
msgid "　不用心に歩き回って、さっきみたいな事になったら私でも助けてあげられないから、暗闇には気をつけなさい。気が付いたら鏡の中にいる！とか本気であるから」"
msgstr "  If you wind up trapped like you were before because you wandered around carelessly, even I won't be able to help you, so be careful of the dark. You might even find yourself stuck inside a mirror! ...Seriously, that can actually happen.\""

#. Occurrence 6_6:2720:8147: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0019; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2720
msgctxt "text_id=8147 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 6_6:2726:8148: scene=6_6
#: 6_6:2726
msgctxt "text_id=8148 | speaker=unknown"
msgid "　その気をつけ方を具体的に教えてくれないものか、と心底思う草十郎だが、口にしたところでいい返事はなさそうだった。"
msgstr "  Soujyuro so hoped they would provide him with a general idea of what to watch out for, but he passed, knowing that he was unlikely to get a straight answer."

#. Occurrence 6_6:2761:8149: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0092; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2761
msgctxt "text_id=8149 | speaker=aoko"
msgid "「枝葉から入っちゃったけど、要は私たちのプライベートに関わるなってコト。"
msgstr "\"That was a lot to take in in one go, but my point is: keep your nose out of where it doesn't belong."

#. Occurrence 6_6:2767:8150: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0093; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2767
msgctxt "text_id=8150 | speaker=aoko"
msgid "　いくら最後には記憶を消すっていっても、それを<見|・><ら|・><れ|・><た|・><段|・><階|・><で|・><消|・><す|・><し|・><か|・><な|・><い|・>ものもあるから」"
msgstr "  Even though we're going to erase your memory in the end, there are still things that we'd have to kill you for seeing.\""

#. Occurrence 6_6:2799:8151: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0020; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2799
msgctxt "text_id=8151 | speaker=soujuurou"
msgid "「……なるほど。この<館|なか>にもルールがある事はよく分かった。他に注意すべきコトは―――」"
msgstr "\"...Got it. The mansion has rules I have to follow, I understand. Is there anything else I should...\""

#. Occurrence 6_6:2813:8152: scene=6_6
#: 6_6:2813
msgctxt "text_id=8152 | speaker=unknown"
msgid "　言いかけて、はてな、と草十郎は視線を泳がす。"
msgstr "  His eyes wandered as he trailed off mid-sentence, pondering."

#. Occurrence 6_6:2818:8153: scene=6_6
#: 6_6:2818
msgctxt "text_id=8153 | speaker=unknown"
msgid "　館の方が危ない、とか、魔術は隠すものだ、とか。"
msgstr "  He understood that the mansion was more dangerous than outside, and that magecraft needed to stay secret."

#. Occurrence 6_6:2823:8154: scene=6_6
#: 6_6:2823
msgctxt "text_id=8154 | speaker=unknown"
msgid "　その説明は彼がこうなった原因と矛盾する。"
msgstr "  But the explanation seemed to contradict his current problem."

#. Occurrence 6_6:2829:8155: scene=6_6
#: 6_6:2829
msgctxt "text_id=8155 | speaker=unknown"
msgid "そもそも、そこまでして隠すものを、どうして草十郎は目の当たりにする事になったのか。"
msgstr "For starters, how had he managed to witness something that they took such pains to keep hidden?"

#. Occurrence 6_6:2856:8156: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0021; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2856
msgctxt "text_id=8156 | speaker=soujuurou"
msgid "「すまない。話の腰を折るんだけど、いいかな。"
msgstr "\"I'm sorry, it just occurred to me."

#. Occurrence 6_6:2862:8157: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0022; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2862
msgctxt "text_id=8157 | speaker=soujuurou"
msgid "　魔術師は協会という組織で結ばれてるんだろう？　なら、どうして蒼崎はあんな人形に襲われたんだ？"
msgstr "  Mages are all united under the organization called the Association, right? If that's the case, why were you attacked by that puppet, Aozaki?"

#. Occurrence 6_6:2887:8158: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0023; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:2887
msgctxt "text_id=8158 | speaker=soujuurou"
msgid "　あれの持ち主が魔術師なら、君たちは味方同士で争っている事になる。なにか、説明が不足していないか？」"
msgstr "  If its master was a mage, wouldn't that mean that you were fighting an ally? Am I missing something here?\""

#. Occurrence 6_6:2947:8159: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0094; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2947
msgctxt "text_id=8159 | speaker=aoko"
msgid "「……それは最後にしようと思ってたのよ。"
msgstr "\"...I was saving that for last."

#. Occurrence 6_6:2958:8160: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0095; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2958
msgctxt "text_id=8160 | speaker=aoko"
msgid "　普通はここまでの話だけで<眉唾|まゆつば>ものっていうか、笑い飛ばすっていうか。"
msgstr "  Normally, this would be the point in the story where you'd say I made it all up or laugh it off."

#. Occurrence 6_6:2970:8161: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0096; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:2970
msgctxt "text_id=8161 | speaker=aoko"
msgid "　いくら経験済みだからって、魔術なんて<存在|モン>をあっさり受け入れるなんて出来ないって言うか―――」"
msgstr "  Even if you've experienced it, the existence of magecraft shouldn't be something you accept so easily...\""

#. Occurrence 6_6:3010:8162: scene=6_6
#: 6_6:3010
msgctxt "text_id=8162 | speaker=unknown"
msgid "　すっかり自分の話を信じこんでいる草十郎に対して、青子は困ったように頬をかく。"
msgstr "  Aoko scratched her head as though troubled by how Soujyuro could take every word at face value."

#. Occurrence 6_6:3015:8163: scene=6_6
#: 6_6:3015
msgctxt "text_id=8163 | speaker=unknown"
msgid "　向かい合った有珠も、表情にこそ出ていないが同意見のようだ。"
msgstr "  Across from her, Alice's face betrayed no expression, but she shared the same opinion."

#. Occurrence 6_6:3060:8164: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0024; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:3060
msgctxt "text_id=8164 | speaker=soujuurou"
msgid "「？　おかしいのか、それ？」"
msgstr "\"Is that so weird?\""

#. Occurrence 6_6:3085:8165: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0097; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3085
msgctxt "text_id=8165 | speaker=aoko"
msgid "「おかしいわよ。"
msgstr "\"It's mega weird."

#. Occurrence 6_6:3085:8166: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0097; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3085
msgctxt "text_id=8166 | speaker=aoko"
msgid "　そもそも、あんたは第一ステップから変だった。"
msgstr "  In fact, you've been weird from the get-go."

#. Occurrence 6_6:3091:8167: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0098; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3091
msgctxt "text_id=8167 | speaker=aoko"
msgid "　普通は驚いたり恐がったり無視したりするものなのに、どうして魔法使いだ、なんて言った私を信じたの？」"
msgstr "  A normal person would be shocked, scared, unwilling to accept our existence. Why do you of all people believe me when I say I'm a magician?\""

#. Occurrence 6_6:3117:8168: scene=6_6
#: 6_6:3117
msgctxt "text_id=8168 | speaker=unknown"
msgid "　思えば、それはミラーハウスで訊くべき問いだった。"
msgstr "  In retrospect, this question should have been posed at the house of mirrors."

#. Occurrence 6_6:3122:8169: scene=6_6
#: 6_6:3122
msgctxt "text_id=8169 | speaker=unknown"
msgid "　あの時、静希草十郎は見た事のない『魔術』という現象に驚いたのであって、それを使う青子自身に何の驚きも、不快感も表さなかったのだ。"
msgstr "  Back then, though Soujyuro was surprised by seeing the phenomenon of magecraft for the first time, he showed no surprise or discomfort toward Aoko, the mage wielding it."

#. Occurrence 6_6:3186:8170: scene=6_6
#: 6_6:3186
msgctxt "text_id=8170 | speaker=unknown"
msgid "　ふたりの少女―――いや、魔術師の疑惑の眼差しを一身に受けて、草十郎は困ってしまう。"
msgstr "  Feeling the probing stares of the two girls―no, the two mages―made Soujyuro feel uneasy."

#. Occurrence 6_6:3191:8171: scene=6_6
#: 6_6:3191
msgctxt "text_id=8171 | speaker=unknown"
msgid "　彼にしてみれば、そんな疑問すら疑問なのだ。"
msgstr "  From where he was standing, their suspicion was suspicious in and of itself."

#. Occurrence 6_6:3234:8172: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0025; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:3234
msgctxt "text_id=8172 | speaker=soujuurou"
msgid "「なんでも何もない。蒼崎。山ではね、有る物は有るのが当たり前なんだよ。"
msgstr "\"There's no reason at all, really. Up in the mountains, people just accept things as they are."

#. Occurrence 6_6:3240:8173: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0026; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:3240
msgctxt "text_id=8173 | speaker=soujuurou"
msgid "　理由をつけられるだけの知識がなかったからにしても、実際に見た物を信じない、なんて事はないんだ。"
msgstr "  We don't deny something we see in front of us just because we don't have the knowledge to explain it."

#. Occurrence 6_6:3246:8174: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0027; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:3246
msgctxt "text_id=8174 | speaker=soujuurou"
msgid "　それに君も言ったろう。貴方にとっては魔法もライターも同じ物なんだろうって」"
msgstr "  You said it yourself. Lighters and magic might as well be the same thing, right?\""

#. Occurrence 6_6:3252:8175: scene=6_6
#: 6_6:3252
msgctxt "text_id=8175 | speaker=unknown"
msgid "　いやまあ、今では違うけど、と付け足して草十郎は言葉をきった。"
msgstr "  Thought they weren't really the same to him anymore, he added quietly before shutting up."

#. Occurrence 6_6:3284:8176: scene=6_6
#: 6_6:3284
msgctxt "text_id=8176 | speaker=unknown"
msgid "　素朴だった山での日々を語った、本心からの言葉。"
msgstr "  What he said about those innocent days in the mountains had come from the heart."

#. Occurrence 6_6:3289:8177: scene=6_6
#: 6_6:3289
msgctxt "text_id=8177 | speaker=unknown"
msgid "　それは蒼崎青子だけでなく、久遠寺有珠まで<得心|とくしん>させる響きがあった。"
msgstr "  And the words resonated with not only Aoko Aozaki, but also Alice Kuonji."

#. Occurrence 6_6:3313:8178: scene=6_6
#: 6_6:3313
msgctxt "text_id=8178 | speaker=unknown"
msgid "　誰であれ持っているだろう、胸を張れる<矜持|きょうじ>。"
msgstr "  It was something everyone should have―principles to stand by."

#. Occurrence 6_6:3318:8179: scene=6_6
#: 6_6:3318
msgctxt "text_id=8179 | speaker=unknown"
msgid "　きっとこの少年にとって、今の言葉こそが揺るぎのない真実だったのだ。"
msgstr "  Indeed, to this boy, those words were an unshakable truth."

#. Occurrence 6_6:3362:8180: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0099; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3362
msgctxt "text_id=8180 | speaker=aoko"
msgid "「有るものは有る、か」"
msgstr "\"Some things are the way they are. I see what you're saying.\""

#. Occurrence 6_6:3368:8181: scene=6_6
#: 6_6:3368
msgctxt "text_id=8181 | speaker=unknown"
msgid "　ちょっとだけ感心する。"
msgstr "  She was impressed, if only slightly."

#. Occurrence 6_6:3373:8182: scene=6_6
#: 6_6:3373
msgctxt "text_id=8182 | speaker=unknown"
msgid "　この少年自体がどんなに異端でも、彼自身が周りの物をそんな風に受けとめているのなら、たしかに、いつだって自然に生きられるはずだ。"
msgstr "  If this boy, no matter how much of an outlier he was, could accept the things around him, he would be able to get through this just fine."

#. Occurrence 6_6:3401:8183: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0100; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3401
msgctxt "text_id=8183 | speaker=aoko"
msgid "「そうね。草十郎はそうなのよね。"
msgstr "\"That's a good way of explaining it, Soujyuro."

#. Occurrence 6_6:3407:8184: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0101; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3407
msgctxt "text_id=8184 | speaker=aoko"
msgid "　簡単に信じてもらえるコトが信じられない、なんて、私たちの方がどうかしてたわ」"
msgstr "  I guess the fault's with us for not believing you sincerely.\""

#. Occurrence 6_6:3419:8185: scene=6_6
#: 6_6:3419
msgctxt "text_id=8185 | speaker=unknown"
msgid "　……たとえば、初めて出逢った時のように。"
msgstr "  Much like when Aoko met Soujyuro for the first time..."

#. Occurrence 6_6:3424:8186: scene=6_6
#: 6_6:3424
msgctxt "text_id=8186 | speaker=unknown"
msgid "　あの教室でも、この少年は全ての出来事を<是|よし>と受けとめていたんだと、少女は懐かしく苦笑した。"
msgstr "  In that classroom on his first day, Soujyuro took everything that was happening in his stride. The memory brought a bitter smile to Aoko's face."

#. Occurrence 6_6:3506:8187: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0102; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3506
msgctxt "text_id=8187 | speaker=aoko"
msgid "「じゃ、気を取り直してっと……"
msgstr "\"All right, let's get back on track."

#. Occurrence 6_6:3512:8188: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0103; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3512
msgctxt "text_id=8188 | speaker=aoko"
msgid "　草十郎の疑問だけどね。魔術師も色々あって、協会に属していない連中もいるの。"
msgstr "  To your earlier question, for various reasons, there are mages that don't belong to the Association at all."

#. Occurrence 6_6:3519:8189: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0104; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3519
msgctxt "text_id=8189 | speaker=aoko"
msgid "こういった連中は協会の目を盗んでやりたい放題で、利益目的で他の魔術師にケンカを売ってくる。あの人形の持ち主もその<類|たぐい>」"
msgstr "They do as they please behind the Association's back and fight other mages for their personal gain. That puppet's master is one of those types.\""

#. Occurrence 6_6:3560:8190: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0105; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3560
msgctxt "text_id=8190 | speaker=aoko"
msgid "「そんな連中にとって、私たちは都合のいい、格好のカモなのよ。"
msgstr "\"To those jerkwads, we're a convenient, easy target."

#. Occurrence 6_6:3567:8191: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0106; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3567
msgctxt "text_id=8191 | speaker=aoko"
msgid "私たちは協会と協定関係にあるだけで門下ってワケじゃないから。私たちが殺されたところで、協会は助けてくれないしね」"
msgstr "But just because we have an arrangement with the Association doesn't mean we're one of them. It's not like they'll come to save the day if we're at risk of being killed.\""

#. Occurrence 6_6:3603:8192: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0028; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:3603
msgctxt "text_id=8192 | speaker=soujuurou"
msgid "「？　でも、魔術師が魔術を使うのは禁じてるんだろ？」"
msgstr "\"But aren't mages forbidden from using magecraft?\""

#. Occurrence 6_6:3628:8193: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0107; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3628
msgctxt "text_id=8193 | speaker=aoko"
msgid "「それが<公|おおやけ>にならないのなら、協会は目をつむるわ。"
msgstr "\"As long as it's not in public, the Association turns a blind eye."

#. Occurrence 6_6:3634:8194: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0108; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3634
msgctxt "text_id=8194 | speaker=aoko"
msgid "　むしろ、バレなければ魔術師同士の争いを<奨励|しょうれい>してるぐらいよ。技術も使わないと<錆|さ>びるってね。"
msgstr "  Heck, they practically encourage fights between mages, as long as it's kept a secret. Like if we don't use it, we'll get rusty or something."

#. Occurrence 6_6:3640:8195: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0109; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3640
msgctxt "text_id=8195 | speaker=aoko"
msgid "　……まあ。私たちが襲われてるのはそれとは別の話で、たんに土地を持ってるからなんだけど」"
msgstr "  ...Anyway, the attacks on us are a different story and have to do with the fact that we own land.\""

#. Occurrence 6_6:3681:8196: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0029; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:3681
msgctxt "text_id=8196 | speaker=soujuurou"
msgid "「……土地って、この家？」"
msgstr "\"...By land, you mean this house?\""

#. Occurrence 6_6:3694:8197: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0110; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3694
msgctxt "text_id=8197 | speaker=aoko"
msgid "「まさか。この三咲市一帯の管理地の権利を持ってるのよ、私と有珠は」"
msgstr "\"Oh, please. Just this house? Alice and I hold the rights to the entirety of Misaki City. We're administrators of the whole region.\""

#. Occurrence 6_6:3785:8198: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0030; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:3785
msgctxt "text_id=8198 | speaker=soujuurou"
msgid "「管理地って、つまり土地の利権―――！？」"
msgstr "\"Administrators? You own... all the land in Misaki?!\""

#. Occurrence 6_6:3848:8199: scene=6_6
#: 6_6:3848
msgctxt "text_id=8199 | speaker=unknown"
msgid "　眩しい、と目を<背|そむ>ける草十郎。"
msgstr "  Dazzled, Soujyuro looked away."

#. Occurrence 6_6:3853:8200: scene=6_6
#: 6_6:3853
msgctxt "text_id=8200 | speaker=unknown"
msgid "　いま、彼が見ている青子には確実に<後光|ごこう>が差している。"
msgstr "  He was sure he could see a halo of light around Aoko."

#. Occurrence 6_6:3858:8201: scene=6_6
#: 6_6:3858
msgctxt "text_id=8201 | speaker=unknown"
msgid "　貸しアパート生活いまだ二週間の草十郎だが、都会において土地の権利がいかに偉大なものか、ほんと身をもって知っていたからだ。"
msgstr "  He had only been renting an apartment for two weeks, but he was already aware of how magnificent the prospect of owning land in the city might be."

#. Occurrence 6_6:3908:8202: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0031; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:3908
msgctxt "text_id=8202 | speaker=soujuurou"
msgid "「お……おお……」"
msgstr "\"You're r-r-r...\""

#. Occurrence 6_6:3914:8203: scene=6_6
#: 6_6:3914
msgctxt "text_id=8203 | speaker=unknown"
msgid "　お金、持ちだ―――！"
msgstr "  The word Soujyuro was trying to articulate was \"rich.\""

#. Occurrence 6_6:3919:8204: scene=6_6
#: 6_6:3919
msgctxt "text_id=8204 | speaker=unknown"
msgid "　などと、草十郎はよく分からない感動でワナワナ震えている。"
msgstr "  He shook all over with an emotion he did not fully grasp."

#. Occurrence 6_6:3954:8205: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0111; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3954
msgctxt "text_id=8205 | speaker=aoko"
msgid "「……悪いけど、そういうんじゃないから。"
msgstr "\"...Hold it, you're thinking about this all wrong."

#. Occurrence 6_6:3960:8206: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0112; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3960
msgctxt "text_id=8206 | speaker=aoko"
msgid "　私たちで土地って言ったら、魔術師としての霊地の所有権、支配権のコトを言うの。"
msgstr "  When we say land, we're talking about the ownership and control of spiritual grounds, as mages."

#. Occurrence 6_6:3972:8207: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0113; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:3972
msgctxt "text_id=8207 | speaker=aoko"
msgid "　<蒼崎|うち>はマイナーだけど古くからこのあたりに根を下ろしてた魔術師で、三咲町もうちの管理下ってワケ」"
msgstr "  The Aozaki family might be a minor player, but we've got old roots here as mages, which is why Misaki falls under our jurisdiction.\""

#. Occurrence 6_6:4005:8208: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0114; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4005
msgctxt "text_id=8208 | speaker=aoko"
msgid "「管理地って言うのはね、霊的な力が<歪|ゆが>んで、集まりやすい土地のコト。そういう土地は昔から貴重で、魔術の実践、実験には不可欠でもある。"
msgstr "\"When I say we administer the land, I'm talking about a place where spiritual power is distorted and gathers easily. This type of land has always been valuable, and it's vital to the experimentation and practice of magecraft."

#. Occurrence 6_6:4011:8209: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0115; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4011
msgctxt "text_id=8209 | speaker=aoko"
msgid "　成功への絶対条件は優れた霊地、堅固な工房、多くの弟子たちってね。"
msgstr "  After all, the three pillars of what makes a successful mages are a strong workshop, lots of disciples, and fertile spiritual grounds."

#. Occurrence 6_6:4017:8210: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0116; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4017
msgctxt "text_id=8210 | speaker=aoko"
msgid "　魔術師たちにとって、土地つき館つきの住み家を持つのは一つの野望なんだから」"
msgstr "  To us, owning administered land and a residence to live in are number one on the priority list.\""

#. Occurrence 6_6:4056:8211: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0033; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:4056
msgctxt "text_id=8211 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 6_6:4061:8212: scene=6_6
#: 6_6:4061
msgctxt "text_id=8212 | speaker=unknown"
msgid "　その野望を二つも叶えている青子たちは何様なんだろう、と思いつつ草十郎は先を<促|うなが>した。"
msgstr "  Soujyuro let her continue while wondering exactly who these two girls were to have achieved both ambitions already."

#. Occurrence 6_6:4105:8213: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0117; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4105
msgctxt "text_id=8213 | speaker=aoko"
msgid "「でも、その管理地は大部分が協会に仕切られてて、もう余っている土地はないの。"
msgstr "\"However, most sacred grounds have already been claimed by the Association. There's nothing left for anyone else."

#. Occurrence 6_6:4111:8214: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0118; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4111
msgctxt "text_id=8214 | speaker=aoko"
msgid "　はぐれ魔術師や土地のない魔術師は、協会に毎月寄付金を納めて土地を借りるしかない。ま、ていよく協会のお偉いさんたちに尽くす働きバチってところね」"
msgstr "  Rogue and landless mages have no choice but to borrow land from the organization in exchange for a monthly donation. They're basically worker bees, slaving away for the top dogs of the Association.\""

#. Occurrence 6_6:4145:8215: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0119; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4145
msgctxt "text_id=8215 | speaker=aoko"
msgid "「でも、ここの土地は何百年も前から蒼崎の物だから協会とは関係がないの。"
msgstr "\"But this land here, it's been in my family for hundreds of years, so the Association can't get their grubby hands on it."

#. Occurrence 6_6:4151:8216: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0120; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4151
msgctxt "text_id=8216 | speaker=aoko"
msgid "　ここまで言えば分かるでしょ？"
msgstr "  Do you understand what I'm saying, Soujyuro?"

#. Occurrence 6_6:4157:8217: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0121; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4157
msgctxt "text_id=8217 | speaker=aoko"
msgid "　そういったフリーの連中からすれば、私たちの管理地はこの上ないご馳走なんだって」"
msgstr "  To rogue mages, our land is the juiciest fruit there is.\""

#. Occurrence 6_6:4177:8218: scene=6_6
#: 6_6:4177
msgctxt "text_id=8218 | speaker=unknown"
msgid "　……物騒なんだか所帯染みているのか微妙な話になってきたな、と内心うなずく草十郎。"
msgstr "  Soujyuro nodded to himself, unsure whether to call the conversation mundane or outright disturbing."

#. Occurrence 6_6:4197:8219: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0034; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:4197
msgctxt "text_id=8219 | speaker=soujuurou"
msgid "「よく分かった。"
msgstr "\"I get it."

#. Occurrence 6_6:4197:8220: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0034; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:4197
msgctxt "text_id=8220 | speaker=soujuurou"
msgid "　蒼崎たちは土地の奪い合いをしているんだな？」"
msgstr "So you're basically fighting over the land.\""

#. Occurrence 6_6:4231:8221: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0122; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4231
msgctxt "text_id=8221 | speaker=aoko"
msgid "「そういう事。"
msgstr "\"Pretty much."

#. Occurrence 6_6:4238:8222: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0123; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4238
msgctxt "text_id=8222 | speaker=aoko"
msgid "ただ三咲の管理地はマイナーのさらにマイナーだから、やってくる挑戦者も三流ばっかりよ。"
msgstr "But because the administered land of Misaki is so minor, its challengers have all been third-rate."

#. Occurrence 6_6:4244:8223: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0124; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4244
msgctxt "text_id=8223 | speaker=aoko"
msgid "　今回の敵だって、どっかの三流魔術師がここなら楽に奪えると思ってやってきたんだろうし。ま、それもアンタの乱入で休戦してるんだけど」"
msgstr "  The enemy this time is probably some small fry thinking this place was low-hanging fruit. Though for now, we're on a ceasefire because of your intrusion.\""

#. Occurrence 6_6:4286:8224: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0004; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4286
msgctxt "text_id=8224 | speaker=alice"
msgid "「……管理地の話はそれで十分よ、青子。"
msgstr "\"...That's enough about administered land, Aoko."

#. Occurrence 6_6:4299:8225: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0005; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4299
msgctxt "text_id=8225 | speaker=alice"
msgid "　静希君も、他に魔術師がいると分かってくれたようだし。"
msgstr "  Sizuki seems to understand the point that there are other mages out there apart from us."

#. Occurrence 6_6:4305:8226: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0006; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4305
msgctxt "text_id=8226 | speaker=alice"
msgid "　危険があるとすれば、わたしたちの戦いに彼が巻きこまれる可能性だけど」"
msgstr "  If any danger exists, it's more likely to arise as a result of him becoming involved in one of our battles.\""

#. Occurrence 6_6:4349:8227: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0125; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4349
msgctxt "text_id=8227 | speaker=aoko"
msgid "「それは大丈夫でしょ。"
msgstr "\"He'll be fine."

#. Occurrence 6_6:4355:8228: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0126; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4355
msgctxt "text_id=8228 | speaker=aoko"
msgid "　だってコイツ、魔力の欠片もないじゃない。魔力感知にはひっかからないし、番犬以下の人間は戦力って言わないから、狙われる事もないだろうし。"
msgstr "  Besides, this guy has zero trace of magical energy, so there's no chance of him being sensed. Plus, he has less tactical value than a watchdog, so he shouldn't be a target anyway."

#. Occurrence 6_6:4361:8229: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0127; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4361
msgctxt "text_id=8229 | speaker=aoko"
msgid "　私たちはただ、忘却のルーンを見つけるまでコイツを逃がさなければいいだけでしょ」"
msgstr "  We just have to make sure he doesn't escape before we can find the amnesia rune.\""

#. Occurrence 6_6:4402:8230: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0007; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4402
msgctxt "text_id=8230 | speaker=alice"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 6_6:4408:8231: scene=6_6
#: 6_6:4408
msgctxt "text_id=8231 | speaker=unknown"
msgid "　有珠は無言で、相棒である少女を見つめる。"
msgstr "  Alice silently stared her partner down."

#. Occurrence 6_6:4413:8232: scene=6_6
#: 6_6:4413
msgctxt "text_id=8232 | speaker=unknown"
msgid "　有珠の言う“巻きこまれる”と、青子の言う“巻きこまれる”は、その深刻さ、過酷さが違っていた。"
msgstr "  Their ideas of 'involving' Soujyuro differed greatly in both gravity and risk."

#. Occurrence 6_6:4454:8233: scene=6_6
#: 6_6:4454
msgctxt "text_id=8233 | speaker=unknown"
msgid "　青子はその浅い経験から、彼が直接的な戦いには巻きこまれないと断じている。"
msgstr "  Aoko's lack of experience had led her to believe that Soujyuro would not get directly involved in any fighting."

#. Occurrence 6_6:4459:8234: scene=6_6
#: 6_6:4459
msgctxt "text_id=8234 | speaker=unknown"
msgid "　清廉潔白で合理的。"
msgstr "  It was an honest and rational thought."

#. Occurrence 6_6:4465:8235: scene=6_6
#: 6_6:4465
msgctxt "text_id=8235 | speaker=unknown"
msgid "無駄を嫌う彼女は、敵にも同じ効率を求めてしまう節がある。"
msgstr "Aoko despised wasted action, so it was natural for her to expect the same frugality from her enemies."

#. Occurrence 6_6:4470:8236: scene=6_6
#: 6_6:4470
msgctxt "text_id=8236 | speaker=unknown"
msgid "　だが―――世の中には、そも事を終えるまで、自らの正否を量れぬ者もいる。"
msgstr "  However, there were those in this world who could not tell right from wrong until it was too late."

#. Occurrence 6_6:4519:8237: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0008; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4519
msgctxt "text_id=8237 | speaker=alice"
msgid "「…………先の事は誰にも分からないから。"
msgstr "\"...No one knows what the future will bring."

#. Occurrence 6_6:4525:8238: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0009; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4525
msgctxt "text_id=8238 | speaker=alice"
msgid "　その時になって、後悔がなければいいけれど」"
msgstr "  I only hope that when the time comes, we won't regret this.\""

#. Occurrence 6_6:4540:8239: scene=6_6
#: 6_6:4540
msgctxt "text_id=8239 | speaker=unknown"
msgid "　陰鬱なため息をついて、有珠は席を立った。"
msgstr "  With a gloomy sigh, Alice came to her feet."

#. Occurrence 6_6:4580:8240: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0128; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4580
msgctxt "text_id=8240 | speaker=aoko"
msgid "「ちょっと。何のために<長話|ながばなし>したと思ってるのよ。"
msgstr "\"Ahem. I'm not done with the lecture yet. You don't think that was entirely for Sizuki's benefit, do you?"

#. Occurrence 6_6:4586:8241: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_6_0129; voice_prefix=A10; voice_category=1; scene=6_6
#: 6_6:4586
msgctxt "text_id=8241 | speaker=aoko"
msgid "　いちばん重要なアンタの<同意|いけん>、聞いてないんですけど？」"
msgstr "  Your opinion matters the most, and we still haven't heard it yet.\""

#. Occurrence 6_6:4609:8242: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0010; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4609
msgctxt "text_id=8242 | speaker=alice"
msgid "「貴女が貴女の方針を守るというのなら、それでいいわ。"
msgstr "\"If you must stick to your plan, that's fine."

#. Occurrence 6_6:4615:8243: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0011; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4615
msgctxt "text_id=8243 | speaker=alice"
msgid "　わたしも好きにするだけよ」"
msgstr "  I'll stick to mine.\""

#. Occurrence 6_6:4649:8244: scene=6_6
#: 6_6:4649
msgctxt "text_id=8244 | speaker=unknown"
msgid "　音もなく扉に向かう有珠。"
msgstr "  Alice glided soundlessly to the door."

#. Occurrence 6_6:4693:8245: scene=6_6
#: 6_6:4693
msgctxt "text_id=8245 | speaker=unknown"
msgid "　黒衣の少女は扉を開け、薄暗い廊下の前で立ち止まった。"
msgstr "  As the girl in black opened it, she paused, barely lit by the dim corridor."

#. Occurrence 6_6:4698:8246: scene=6_6
#: 6_6:4698
msgctxt "text_id=8246 | speaker=unknown"
msgid "　同時に、"
msgstr "  Then,"

#. Occurrence 6_6:4762:8247: scene=6_6
#: 6_6:4762
msgctxt "text_id=8247 | speaker=unknown"
msgid "　つい、と。"
msgstr "  without warning..."

#. Occurrence 6_6:4776:8248: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_6_0035; voice_prefix=A30; voice_category=3; scene=6_6
#: 6_6:4776
msgctxt "text_id=8248 | speaker=soujuurou"
msgid "「！？」"
msgstr "\"?!\""

#. Occurrence 6_6:4781:8249: scene=6_6
#: 6_6:4781
msgctxt "text_id=8249 | speaker=unknown"
msgid "　少女の足取りに合わせるよう、テーブルにあった小瓶が<宙|ちゅう>に浮き―――慈悲も<躊躇|ためら>いもなく、無惨に砕け散った。"
msgstr "  To the rhythm of her footsteps, the small glass bottle floated into the air and shattered, without mercy."

#. Occurrence 6_6:4913:8250: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0012; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4913
msgctxt "text_id=8250 | speaker=alice"
msgid "「……あの時、こうしておけばよかった」"
msgstr "\"That is what I should have done earlier.\""

#. Occurrence 6_6:4919:8251: scene=6_6
#: 6_6:4919
msgctxt "text_id=8251 | speaker=unknown"
msgid "　さらりとした声に、顔面蒼白になる草十郎。"
msgstr "  Her sharp tone made Soujyuro's face go pale."

#. Occurrence 6_6:4924:8252: scene=6_6
#: 6_6:4924
msgctxt "text_id=8252 | speaker=unknown"
msgid "　有珠の声は静かすぎて、本気なのか冗談なのかまったく読み取れない。"
msgstr "  Alice's voice was so quiet, it was hard to tell if she was being serious or mocking him."

#. Occurrence 6_6:4982:8253: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0013; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:4982
msgctxt "text_id=8253 | speaker=alice"
msgid "「わたしも言い忘れていたけど」"
msgstr "\"I forgot to mention something.\""

#. Occurrence 6_6:4994:8254: scene=6_6
#: 6_6:4994
msgctxt "text_id=8254 | speaker=unknown"
msgid "　少女の横顔が、いっそう冷たく青子と草十郎を流し見る。"
msgstr "  She icily eyed them before turning away,"

#. Occurrence 6_6:4999:8255: scene=6_6
#: 6_6:4999
msgctxt "text_id=8255 | speaker=unknown"
msgid "　洋館の主は、その表情よりなお冷たい声で、"
msgstr "  and in a voice even colder than her gaze, stated,"

#. Occurrence 6_6:5026:8256: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_6_0014; voice_prefix=A40; voice_category=2; scene=6_6
#: 6_6:5026
msgctxt "text_id=8256 | speaker=alice"
msgid "「まだ、<認|みと>めていないから」"
msgstr "\"I'm still not happy with this arrangement.\""

#. Occurrence 6_6:5066:8257: scene=6_6
#: 6_6:5066
msgctxt "text_id=8257 | speaker=unknown"
msgid "　あまりにも前途多難な伝言を残していった。"
msgstr "  Her frigid departure seemed to forbode the many difficulties that lay ahead."

#. Occurrence 6_7:53:8258: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0000; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:53
msgctxt "text_id=8258 | speaker=aoko"
msgid "「……ったく、往生際が悪い」"
msgstr "\"...She is *such* a sore loser.\""

#. Occurrence 6_7:60:8259: scene=6_7
#: 6_7:60
msgctxt "text_id=8259 | speaker=unknown"
msgid "　ソファーにもたれながら悪態をつく青子。"
msgstr "  Aoko leaned back on the sofa while hurling abusive epithets."

#. Occurrence 6_7:65:8260: scene=6_7
#: 6_7:65
msgctxt "text_id=8260 | speaker=unknown"
msgid "　不機嫌そうな顔は、普段よりイライラ度を増している。"
msgstr "  Her face looked even more irritated than usual."

#. Occurrence 6_7:86:8261: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0001; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:86
msgctxt "text_id=8261 | speaker=aoko"
msgid "「見逃すのと<洋館|ここ>に住まわせるのは別問題よって、じゃあそれ以外にどんな方法があるってのよ。"
msgstr "\"She says letting you go and letting you stay here are out of the question, but I don't see *her* coming up with any bright ideas."

#. Occurrence 6_7:92:8262: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0002; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:92
msgctxt "text_id=8262 | speaker=aoko"
msgid "　……譲る気もなさそうだし。この分じゃ実力行使に出るかもね、あの<娘|こ>」"
msgstr "  She's as stubborn as a mule. I wouldn't put it past her to resort to violence to get her way.\""

#. Occurrence 6_7:125:8263: scene=6_7
#: 6_7:125
msgctxt "text_id=8263 | speaker=unknown"
msgid "　ぶつぶつと呟く青子に、草十郎は不審げな視線を送る。"
msgstr "  Soujyuro threw a wary glance at Aoko while she grumbled."

#. Occurrence 6_7:154:8264: scene=6_7
#: 6_7:154
msgctxt "text_id=8264 | speaker=unknown"
msgid "　今の決意表明―――小瓶を粉々にする―――はどういう^事なのか、と。"
msgstr "  He wondered what Alice's show of defiance meant, shattering the glass bottle like she did."

#. Occurrence 6_7:184:8265: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0003; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:184
msgctxt "text_id=8265 | speaker=aoko"
msgid "「草十郎には“記憶を無くしてもらう”ってコトで話はつけたけど、心の底から納得してないってコトでしょ。"
msgstr "\"I thought I could convince her by including the backstop that we could erase your memory, but she's having none of it."

#. Occurrence 6_7:190:8266: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0004; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:190
msgctxt "text_id=8266 | speaker=aoko"
msgid "　……有珠にしちゃあ珍しく他人を意識してたけど、やっぱりここに住まわせるとなると難しいみたい。"
msgstr "  ...It's rare that Alice is even cognizant of other people, but maybe having you live here was a step too far for her."

#. Occurrence 6_7:196:8267: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0005; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:196
msgctxt "text_id=8267 | speaker=aoko"
msgid "　寝てる分には良かったけど、起きてるアンタを見たらこう、<得|え>も言わぬ<嗜虐心|しぎゃくしん>を刺激されたとかさ」"
msgstr "  She was fine while you were sleeping, but once she saw you awake, it must have roused her sadistic side.\""

#. Occurrence 6_7:224:8268: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0006; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:224
msgctxt "text_id=8268 | speaker=aoko"
msgid "「気をつけてね草十郎。"
msgstr "\"Watch your back, Soujyuro."

#. Occurrence 6_7:230:8269: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0007; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:230
msgctxt "text_id=8269 | speaker=aoko"
msgid "　あの娘、アンタを殺しにくるかもしれないから」"
msgstr "  She just might come to finish you off.\""

#. Occurrence 6_7:236:8270: scene=6_7
#: 6_7:236
msgctxt "text_id=8270 | speaker=unknown"
msgid "　などと忠告しつつ、青子自身、これ以上有珠を説得する気はなさそうだった。"
msgstr "  If anything, Aoko's warning was an indication that persuading Alice had hit a dead end."

#. Occurrence 6_7:273:8271: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0000; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:273
msgctxt "text_id=8271 | speaker=soujuurou"
msgid "「……なんか、状況はあの夜からあまり変わってないようだね、蒼崎」"
msgstr "\"...Somehow, it doesn't seem like the situation has changed much from the other night, Aozaki.\""

#. Occurrence 6_7:279:8272: scene=6_7
#: 6_7:279
msgctxt "text_id=8272 | speaker=unknown"
msgid "　思わず呟いた一言に、青子はそう？　と軽く視線を返す。"
msgstr "  She shot him an unconcerned look in reply."

#. Occurrence 6_7:313:8273: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0001; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:313
msgctxt "text_id=8273 | speaker=soujuurou"
msgid "「そう？　じゃないぞ。"
msgstr "\"I mean it, really."

#. Occurrence 6_7:319:8274: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0002; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:319
msgctxt "text_id=8274 | speaker=soujuurou"
msgid "　蒼崎の次はあの娘がやる気満々じゃないか。さっきみたいな目にあったら逃げることもできない。"
msgstr "  That girl is just itching to finish what you started. The next time I make eye contact with her, I might not walk away alive."

#. Occurrence 6_7:325:8275: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0003; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:325
msgctxt "text_id=8275 | speaker=soujuurou"
msgid "　こういうの、生殺しって言うんじゃないか？」"
msgstr "  This must be what people call a cliffhanger.\""

#. Occurrence 6_7:365:8276: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0008; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:365
msgctxt "text_id=8276 | speaker=aoko"
msgid "「そうならないように努力するのね。"
msgstr "\"I'll try to make sure that doesn't happen."

#. Occurrence 6_7:371:8277: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0009; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:371
msgctxt "text_id=8277 | speaker=aoko"
msgid "　ま、有珠の理由は遊園地の時ほど切迫したものじゃないから、そのうち<諦|あきら>めてくれるとは思うんだけど」"
msgstr "  Besides, Alice isn't feeling as urgent as I was at the amusement park, so there's always a chance that she'll get over it by herself.\""

#. Occurrence 6_7:399:8278: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0004; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:399
msgctxt "text_id=8278 | speaker=soujuurou"
msgid "「蒼崎の時とは違う、有珠の理由……？」"
msgstr "\"You mean her reason for wanting me dead is... different from yours?\""

#. Occurrence 6_7:443:8279: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0010; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:443
msgctxt "text_id=8279 | speaker=aoko"
msgid "「ええ。遊園地の時は秘密厳守のためだったけど、それは一応解決してる。アンタが底抜けに律儀なヤツだってのは、有珠だってもう分かってるし。"
msgstr "\"Yeah. That time at the park was because of our strict adherence to the secrecy law, but we've solved it for now. Even Alice understands how creepily earnest you are."

#. Occurrence 6_7:449:8280: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0011; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:449
msgctxt "text_id=8280 | speaker=aoko"
msgid "　なんで、秘密厳守云々であそこまで反対する理由はないの。あの娘は単にね、ここに住んでほしくないだけなのよ。それだけで、有珠はアンタを殺したがってる」"
msgstr "  So she should have no reason left to worry about confidentiality. At this point, she probably just doesn't want you to live here, hence her desire to murder you.\""

#. Occurrence 6_7:500:8281: scene=6_7
#: 6_7:500
msgctxt "text_id=8281 | speaker=unknown"
msgid "　きっぱりと言う青子の目は真剣そのものだ。"
msgstr "  She said so matter-of-factly, her eyes cold and serious."

#. Occurrence 6_7:505:8282: scene=6_7
#: 6_7:505
msgctxt "text_id=8282 | speaker=unknown"
msgid "　そこには嘘も<誇張|こちょう>も影すらない。困った事に。"
msgstr "  Soujyuro had hoped for a trace of deceit or exaggeration, but alas."

#. Occurrence 6_7:538:8283: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0005; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:538
msgctxt "text_id=8283 | speaker=soujuurou"
msgid "「たしかに、あの娘はそんな素振りだったけど。"
msgstr "\"I did get that impression from her."

#. Occurrence 6_7:544:8284: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0006; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:544
msgctxt "text_id=8284 | speaker=soujuurou"
msgid "　……変だね、それならもっと他の手段をとればいいのに」"
msgstr "  ...But it's strange. If that's how she really feels, then surely we can find another solution.\""

#. Occurrence 6_7:550:8285: scene=6_7
#: 6_7:550
msgctxt "text_id=8285 | speaker=unknown"
msgid "　有珠に申し訳ないものを感じているのか、柄にもなく深刻に悩む草十郎。"
msgstr "  Perhaps feeling guilty about putting Alice out, Soujyuro looked uncharacteristically concerned."

#. Occurrence 6_7:555:8286: scene=6_7
#: 6_7:555
msgctxt "text_id=8286 | speaker=unknown"
msgid "　その言葉の意味を、青子は瞬時に読み取った。"
msgstr "  Aoko immediately knew what his words really meant."

#. Occurrence 6_7:599:8287: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0012; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:599
msgctxt "text_id=8287 | speaker=aoko"
msgid "「例えば、記憶を消す魔術が見つかるまで、さっきの小瓶の中に閉じこめておくとか？」"
msgstr "\"You mean like keeping you locked up inside that tiny glass bottle until we find the magecraft needed to erase your memory?\""

#. Occurrence 6_7:630:8288: scene=6_7
#: 6_7:630
msgctxt "text_id=8288 | speaker=unknown"
msgid "　青子の声に、先ほどまでの<気怠|けだる>さはない。"
msgstr "  The apathy in her voice until now was gone."

#. Occurrence 6_7:647:8289: scene=6_7
#: 6_7:647
msgctxt "text_id=8289 | speaker=unknown"
msgid "　草十郎は頷きだけで答えた。"
msgstr "  Soujyuro answered with a simple nod."

#. Occurrence 6_7:652:8290: scene=6_7
#: 6_7:652
msgctxt "text_id=8290 | speaker=unknown"
msgid "　事実、彼女たちにとってそれが最も<安易|イージー>な方法である事は間違いない。"
msgstr "  In truth, it was undoubtedly the easiest solution for all parties concerned."

#. Occurrence 6_7:657:8291: scene=6_7
#: 6_7:657
msgctxt "text_id=8291 | speaker=unknown"
msgid "　だが、"
msgstr "  However..."

#. Occurrence 6_7:690:8292: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0013; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:690
msgctxt "text_id=8292 | speaker=aoko"
msgid "「草十郎。私、約束は破らないの。覚えておいて」"
msgstr "\"Soujyuro. I don't break promises. Remember that.\""

#. Occurrence 6_7:696:8293: scene=6_7
#: 6_7:696
msgctxt "text_id=8293 | speaker=unknown"
msgid "　その安易さを、彼女は嫌った。"
msgstr "  She hated taking the easy way out, "

#. Occurrence 6_7:701:8294: scene=6_7
#: 6_7:701
msgctxt "text_id=8294 | speaker=unknown"
msgid "　静かな言葉にはかすかな怒りがある。"
msgstr "  and that quiet fury was clear in her soft words."

#. Occurrence 6_7:706:8295: scene=6_7
#: 6_7:706
msgctxt "text_id=8295 | speaker=unknown"
msgid "　その怒りが何に対して向けられているのか、草十郎には痛いほどよく分かった。"
msgstr "  As for where that fury was directed, Soujyuro was acutely aware."

#. Occurrence 6_7:711:8296: scene=6_7
#: 6_7:711
msgctxt "text_id=8296 | speaker=unknown"
msgid "　胸の痛みは、彼女にそんな台詞を言わせてしまった後悔によるものだ。"
msgstr "  The pain in his chest made him regret making her say those words."

#. Occurrence 6_7:745:8297: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0007; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:745
msgctxt "text_id=8297 | speaker=soujuurou"
msgid "「すまない。考えが足りなかった」"
msgstr "\"I'm sorry. I wasn't thinking.\""

#. Occurrence 6_7:772:8298: scene=6_7
#: 6_7:772
msgctxt "text_id=8298 | speaker=unknown"
msgid "　草十郎の突然の謝罪に、青子はいつもの不機嫌そうな表情に戻る。"
msgstr "  His sudden apology caused her usual sullen expression to return."

#. Occurrence 6_7:777:8299: scene=6_7
#: 6_7:777
msgctxt "text_id=8299 | speaker=unknown"
msgid "　青子本人、自分が怒った理由はおろか、怒っていた事すら気付いていない。"
msgstr "  Aoko had not appreciated how angry she was, let alone the reason for it."

#. Occurrence 6_7:782:8300: scene=6_7
#: 6_7:782
msgctxt "text_id=8300 | speaker=unknown"
msgid "　そんな青子からすると、草十郎の謝罪はまさに寝耳に水だ。"
msgstr "  To her, his apology had come out of nowhere."

#. Occurrence 6_7:817:8301: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0014; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:817
msgctxt "text_id=8301 | speaker=aoko"
msgid "「……アンタって、ほんと分かんないわね。"
msgstr "\"...I don't get you at all sometimes."

#. Occurrence 6_7:817:8302: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0014; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:817
msgctxt "text_id=8302 | speaker=aoko"
msgid "　なんでそこで謝るのよ」"
msgstr "  What are you apologizing for this time?\""

#. Occurrence 6_7:822:8303: scene=6_7
#: 6_7:822
msgctxt "text_id=8303 | speaker=unknown"
msgid "　青子はまじまじと草十郎を見る。"
msgstr "  She stared at Soujyuro, unblinking."

#. Occurrence 6_7:844:8304: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0008; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:844
msgctxt "text_id=8304 | speaker=soujuurou"
msgid "「？　……あれ、そうだな。自分でもよく分からない。"
msgstr "\"Mmm? Oh... er... I'm not sure, myself."

msgctxt "text_id=8305 | speaker=unknown"
msgid "　たぶん、そういう気分になったからだろう」"
msgstr "  I guess I just felt like I should.\""

#. Occurrence 6_7:857:8306: scene=6_7
#: 6_7:857
msgctxt "text_id=8306 | speaker=unknown"
msgid "　よく分からない、などと言いつつ、草十郎は真剣に返答する。青子は呆れて言葉もない。"
msgstr "  Even in saying he was not sure, Soujyuro had answered honestly. Aoko was at a loss for words."

#. Occurrence 6_7:884:8307: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0009; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:884
msgctxt "text_id=8307 | speaker=soujuurou"
msgid "「ただ、蒼崎の言いたい事は分かった。"
msgstr "\"But, I get what you're trying to say, Aozaki."

#. Occurrence 6_7:890:8308: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0010; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:890
msgctxt "text_id=8308 | speaker=soujuurou"
msgid "　約束を守るっていう事は、結果じゃなく、過程を守るって事なんだな」"
msgstr "  Keeping a promise is more about the process than the outcome.\""

#. Occurrence 6_7:896:8309: scene=6_7
#: 6_7:896
msgctxt "text_id=8309 | speaker=unknown"
msgid "　恥ずかしげもなくまっすぐに、草十郎は青子に笑いかけた。"
msgstr "  He shot her a brazenly honest smile."

#. Occurrence 6_7:901:8310: scene=6_7
#: 6_7:901
msgctxt "text_id=8310 | speaker=unknown"
msgid "　純粋な嬉しさに満ちた笑顔は、思わず笑みを返したくなるほどだ。"
msgstr "  That smiling face, filled with blissful ignorance, almost made her smile back instinctively."

#. Occurrence 6_7:943:8311: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0015; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:943
msgctxt "text_id=8311 | speaker=aoko"
msgid "「あ、当たり前じゃない。オチだけ合っていればいいなんて、恥ずかしくてできないでしょ」"
msgstr "\"N-Now you get it. If life were only a means to an end, I couldn't live with myself.\""

#. Occurrence 6_7:949:8312: scene=6_7
#: 6_7:949
msgctxt "text_id=8312 | speaker=unknown"
msgid "　照れたように顔を背けて、青子は小さく言い返す。"
msgstr "  Aoko attempted to cover for her embarrassment with a quick retort."

#. Occurrence 6_7:954:8313: scene=6_7
#: 6_7:954
msgctxt "text_id=8313 | speaker=unknown"
msgid "　不覚にも自分の本音を言い当てられ、少しだけくすぐったかったのだ。"
msgstr "  Though unintentional, having her true feelings exposed like that made Aoko a little uncomfortable."

#. Occurrence 6_7:998:8314: scene=6_7
#: 6_7:998
msgctxt "text_id=8314 | speaker=unknown"
msgid "　いつもなら不快なだけ。"
msgstr "  Finding offense in something was second nature to Aoko. Being made to feel uncomfortable was not."

#. Occurrence 6_7:1003:8315: scene=6_7
#: 6_7:1003
msgctxt "text_id=8315 | speaker=unknown"
msgid "　が、何故か今は嬉しくて、つい顔を背けてしまった。"
msgstr "  Though far from being unhappy at the remark, she turned away from its speaker."

#. Occurrence 6_7:1008:8316: scene=6_7
#: 6_7:1008
msgctxt "text_id=8316 | speaker=unknown"
msgid "　そんな自分が余計にみっともなく、青子は誤魔化すように言葉を続ける。"
msgstr "  To disguise her perceived shame, Aoko started up the conversation again."

#. Occurrence 6_7:1050:8317: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0016; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1050
msgctxt "text_id=8317 | speaker=aoko"
msgid "「貴方を見逃すって言うなら、気持ちの問題じゃなくて、ちゃんと状況もそうなるようにするのは当たり前なの。"
msgstr "\"If I say I'll let you go, you can be sure I'm going to do just that, regardless of how I feel."

#. Occurrence 6_7:1056:8318: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0017; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1056
msgctxt "text_id=8318 | speaker=aoko"
msgid "　草十郎をここに住まわせる事があの約束を守る事になるんなら、厄介な有珠だって言い伏せるわよ。"
msgstr "  And if letting you live here is what it takes to keep my promise, I can take it, even if it means Alice and I butt heads."

#. Occurrence 6_7:1062:8319: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0018; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1062
msgctxt "text_id=8319 | speaker=aoko"
msgid "　……<脅|おど>かすだけならまだしも、ずっと瓶づけなんてさせられるワケないでしょう」"
msgstr "  ...Even if they're just idle threats, there's no way I would let her bottle you up forever.\""

#. Occurrence 6_7:1107:8320: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0011; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1107
msgctxt "text_id=8320 | speaker=soujuurou"
msgid "「そっか。蒼崎があの娘を説得しない素振りなのは、もうできるだけの説得をした後だからなのか。"
msgstr "\"Thanks. Now I get why you've given up trying to persuade her―she won't be persuaded anymore."

#. Occurrence 6_7:1120:8321: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0012; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1120
msgctxt "text_id=8321 | speaker=soujuurou"
msgid "　あ。それで彼女とは冷戦中なんだ」"
msgstr "  Oh, so that's why you called it cold war.\""

#. Occurrence 6_7:1149:8322: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0019; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1149
msgctxt "text_id=8322 | speaker=aoko"
msgid "「……別にアンタのためじゃないわ。私は私のために約束を守ってるだけだし。"
msgstr "\"...It's not as if I'm doing this for you. I'm just keeping my promise."

#. Occurrence 6_7:1155:8323: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0020; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1155
msgctxt "text_id=8323 | speaker=aoko"
msgid "　お察しの通り、私のやるべき事はもう終わってるし？　あとは<草十郎|そっち>が努力する番だから、勝手にすれば？」"
msgstr "  Like you said, I've done my part. Now it's your turn, Soujyuro-the ball's in your court.\""

#. Occurrence 6_7:1168:8324: scene=6_7
#: 6_7:1168
msgctxt "text_id=8324 | speaker=unknown"
msgid "　言われて、はい？　と首をかしげる草十郎。"
msgstr "  \"Huh?\" he replied, tilting his head."

#. Occurrence 6_7:1202:8325: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0021; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1202
msgctxt "text_id=8325 | speaker=aoko"
msgid "「あのね。いい？　同居案をなんとか認めさせる事が出来るのは私だけだから、二日間ぶっ通しで有珠を言い伏せもした。けどそれ以上は無理。"
msgstr "\"All right, listen up. I spent two entire days arguing and trying to convince Alice into agreeing to this co-habitation idea because, hello, I was the only one capable of doing it. But I've hit a dead end."

#. Occurrence 6_7:1208:8326: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0022; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1208
msgctxt "text_id=8326 | speaker=aoko"
msgid "　私、ここから先はノータッチだから。"
msgstr "  From now on, I'm taking a hands-off approach."

#. Occurrence 6_7:1214:8327: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0023; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1214
msgctxt "text_id=8327 | speaker=aoko"
msgid "　しばらくは有珠から守ってあげるけど、その間にあの子にアンタを認めさせる事は、アンタにしか出来ないんだからね、草十郎」"
msgstr "  I'll protect you from Alice for the time being, but in the meantime you're the only one who can convince her to accept you, Soujyuro.\""

#. Occurrence 6_7:1290:8328: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0013; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1290
msgctxt "text_id=8328 | speaker=soujuurou"
msgid "「なんと！」"
msgstr "\"What?!\""

#. Occurrence 6_7:1296:8329: scene=6_7
#: 6_7:1296
msgctxt "text_id=8329 | speaker=unknown"
msgid "　そういう流れになるのか、と面食らう草十郎。"
msgstr "  Soujyuro had not expected that at all."

#. Occurrence 6_7:1307:8330: scene=6_7
#: 6_7:1307
msgctxt "text_id=8330 | speaker=unknown"
msgid "　久遠寺有珠。"
msgstr "  Alice Kuonji."

#. Occurrence 6_7:1312:8331: scene=6_7
#: 6_7:1312
msgctxt "text_id=8331 | speaker=unknown"
msgid "　他人を寄せ付けない黒衣の少女。"
msgstr "  The girl in black who kept everyone at arm's length."

#. Occurrence 6_7:1317:8332: scene=6_7
#: 6_7:1317
msgctxt "text_id=8332 | speaker=unknown"
msgid "　青子が現代に隠れ住む魔法使いなら、彼女は中世に実在した魔女さながらだ。"
msgstr "  If Aoko was a modern day mage in hiding, then Alice was a bona fide witch from the middle ages."

#. Occurrence 6_7:1346:8333: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0014; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1346
msgctxt "text_id=8333 | speaker=soujuurou"
msgid "「……蒼崎。君、自分がどれだけ難しい事を言っているか分かってるか？」"
msgstr "\"...Aozaki, you understand how difficult that will be, right?\""

#. Occurrence 6_7:1371:8334: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0024; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1371
msgctxt "text_id=8334 | speaker=aoko"
msgid "「そうね。私もこの件に関してだけは同情するわ」"
msgstr "\"Of course I do, and now you know how I feel.\""

#. Occurrence 6_7:1412:8335: scene=6_7
#: 6_7:1412
msgctxt "text_id=8335 | speaker=unknown"
msgid "　青子はソファーから立ち上がる。"
msgstr "  Aoko stood up from the sofa."

#. Occurrence 6_7:1417:8336: scene=6_7
#: 6_7:1417
msgctxt "text_id=8336 | speaker=unknown"
msgid "　とりあえず話はここまでらしい。"
msgstr "  This was the end of the discussion, at least for now."

#. Occurrence 6_7:1455:8337: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0025; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1455
msgctxt "text_id=8337 | speaker=aoko"
msgid "「私たちがどんな人間かはおおよそ<判|わか>ったでしょ。"
msgstr "\"So now you have an idea of what kind of people we are."

#. Occurrence 6_7:1461:8338: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0026; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1461
msgctxt "text_id=8338 | speaker=aoko"
msgid "　魔術に関してはこれ以上立ち入らない方がアンタのためだから、説明はここまでね。"
msgstr "  The less involved you are in magecraft the better, so I'll spare you any further lectures."

#. Occurrence 6_7:1472:8339: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0027; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1472
msgctxt "text_id=8339 | speaker=aoko"
msgid "　で、肝心の今後の方針だけど、三ヶ月間ここで暮らす。"
msgstr "  The long and short of it is, you'll be living here for three months."

#. Occurrence 6_7:1478:8340: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0028; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1478
msgctxt "text_id=8340 | speaker=aoko"
msgid "　当初の目標……というより最初の試練は、なんとか有珠に同居人として認めてもらう事」"
msgstr "  Your first objective... or first trial, if you like, is to somehow get Alice to accept you as her roommate.\""

#. Occurrence 6_7:1524:8341: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0015; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1524
msgctxt "text_id=8341 | speaker=soujuurou"
msgid "「試練って言った。いま、そういうたぐいのコトを言った」"
msgstr "\"A trial? You just called it a trial.\""

#. Occurrence 6_7:1549:8342: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0029; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1549
msgctxt "text_id=8342 | speaker=aoko"
msgid "「誤魔化してもいいコトないでしょ、この手のコトは。"
msgstr "\"Sugarcoating it won't do you any favors."

#. Occurrence 6_7:1555:8343: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0030; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1555
msgctxt "text_id=8343 | speaker=aoko"
msgid "　うまくいかなきゃ<粉々|こなごな>なワケだし？」"
msgstr "  After all, blow it and you're a dead man, remember?\""

#. Occurrence 6_7:1576:8344: scene=6_7
#: 6_7:1576
msgctxt "text_id=8344 | speaker=unknown"
msgid "　血も涙もない発言をして、青子はドアへと歩きだす。"
msgstr "  With her cold-blooded remark, Aoko started walking toward the door."

#. Occurrence 6_7:1633:8345: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0031; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1633
msgctxt "text_id=8345 | speaker=aoko"
msgid "「あ、そうそう。"
msgstr "\"Oh, and one more thing."

#. Occurrence 6_7:1639:8346: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0032; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1639
msgctxt "text_id=8346 | speaker=aoko"
msgid "　草十郎の部屋だけど、三階に用意しといたから。二階のホールの裏側に階段があるから使って。ここは寮ってワケでもないし、時間は自由に使いなさい。"
msgstr "  About your room, it's up on the third floor. There's a set of stairs on the far side of the second floor hall, so use those. Also, this is not a dorm, so you're free to spend your time however you want."

#. Occurrence 6_7:1650:8347: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0033; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1650
msgctxt "text_id=8347 | speaker=aoko"
msgid "　ただし、西館にだけは入らないようにね。東館は私が借りてるから比較的安全だけど、それでも歩き回らない方が無難だわ。"
msgstr "  But whatever you do, do not go into the west wing. I rent the east wing, so it should be relatively safe in comparison, but still, it's generally safer to not wander around."

#. Occurrence 6_7:1657:8348: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0034; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1657
msgctxt "text_id=8348 | speaker=aoko"
msgid "ま、基本安全なのはアンタの部屋と<居間|ここ>だけよ」"
msgstr "In other words, the safest places for you are your room and the drawing room.\""

#. Occurrence 6_7:1695:8349: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0016; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1695
msgctxt "text_id=8349 | speaker=soujuurou"
msgid "「な―――<館|なか>の説明って、まさかそれだけ！？"
msgstr "\"W-Wait, is that really all you're going to tell me about the mansion?!"

#. Occurrence 6_7:1714:8350: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0017; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1714
msgctxt "text_id=8350 | speaker=soujuurou"
msgid "　蒼崎はいろいろおかしい、魔術なんかよりもっと大事な説明があると思う！」"
msgstr "  Aozaki, that's messed up! That seems way more important to explain than magecraft!\""

#. Occurrence 6_7:1720:8351: scene=6_7
#: 6_7:1720
msgctxt "text_id=8351 | speaker=unknown"
msgid "　じゃあね、とばかりに居間から出ていこうとする青子を、草十郎は決死の面持ちで呼び止める。"
msgstr "  He desperately called out to her as she began to leave the drawing room."

#. Occurrence 6_7:1749:8352: scene=6_7
#: 6_7:1749
msgctxt "text_id=8352 | speaker=unknown"
msgid "　そんな草十郎を、心底かったりー、と<憐|あわ>れむ青子。"
msgstr "  Aoko could not help by pity Soujyuro."

#. Occurrence 6_7:1786:8353: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0018; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1786
msgctxt "text_id=8353 | speaker=soujuurou"
msgid "「せめてほら、案内とか」"
msgstr "\"Can't you at least show me around?\""

#. Occurrence 6_7:1816:8354: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0035; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1816
msgctxt "text_id=8354 | speaker=aoko"
msgid "「面倒なんでパス。お上りさんを案内するなんて二回もやれば十分よ。"
msgstr "\"Sorry, but I'll have to pass. Showing a country bumpkin the lay of the land twice is plenty enough for me."

#. Occurrence 6_7:1822:8355: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0036; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1822
msgctxt "text_id=8355 | speaker=aoko"
msgid "　起きたばっかりだし、とりあえず今日は部屋で休んだら？"
msgstr "  Plus, you just woke up. Why not take it easy in your room for the rest of the night?"

#. Occurrence 6_7:1822:8356: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0036; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1822
msgctxt "text_id=8356 | speaker=aoko"
msgid "　朝になったら学校まで案内してあげるから」"
msgstr "  I'll show you how to get to school in the morning.\""

#. Occurrence 6_7:1849:8357: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0037; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1849
msgctxt "text_id=8357 | speaker=aoko"
msgid "「もっとも、私もそう暇じゃなし、側についてあげられるのは期末試験が終わるまでってコトで。"
msgstr "\"It's not like I'm made of free time. My obligation to put up with you ends as soon as final exams are over."

#. Occurrence 6_7:1855:8358: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_7_0038; voice_prefix=A10; voice_category=1; scene=6_7
#: 6_7:1855
msgctxt "text_id=8358 | speaker=aoko"
msgid "　一週間以内に有珠と仲良くなるなり、弱みを握るなりしないと、ま、アレよね」"
msgstr "  If you don't find some way to make nice with Alice, or find some way to blackmail her within a week, well, you know what that means.\""

#. Occurrence 6_7:1903:8359: scene=6_7
#: 6_7:1903
msgctxt "text_id=8359 | speaker=unknown"
msgid "　じゃあねー、と去っていく最終鬼畜会長。"
msgstr "  With barely a wave of goodbye the student council tyrant walked out."

#. Occurrence 6_7:1937:8360: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_7_0019; voice_prefix=A30; voice_category=3; scene=6_7
#: 6_7:1937
msgctxt "text_id=8360 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 6_7:1943:8361: scene=6_7
#: 6_7:1943
msgctxt "text_id=8361 | speaker=unknown"
msgid "　挙げた手を、思わずニギニギしてしまう。"
msgstr "  He unconsciously clenched the hand he had raised."

#. Occurrence 6_7:1953:8362: scene=6_7
#: 6_7:1953
msgctxt "text_id=8362 | speaker=unknown"
msgid "　ひとり残されて、本気で途方にくれる草十郎。"
msgstr "  Left all alone, he was at a complete loss."

#. Occurrence 6_7:1958:8363: scene=6_7
#: 6_7:1958
msgctxt "text_id=8363 | speaker=unknown"
msgid "　そんな彼を励ますように、"
msgstr "  Then, as if to encourage him..."

#. Occurrence 6_7:1996:8364: scene=6_7
#: 6_7:1996
msgctxt "text_id=8364 | speaker=unknown"
msgid "　チチチ、と。"
msgstr "  Chirp chirp chirp."

#. Occurrence 6_7:2001:8365: scene=6_7
#: 6_7:2001
msgctxt "text_id=8365 | speaker=unknown"
msgid "　軽快な羽音と共に、いずこともなく現れる青い<駒鳥|コマドリ>。"
msgstr "  With the sound of lightly fluttering wings, a blue robin appeared out of nowhere."

#. Occurrence 6_7:2053:8366: scene=6_7
#: 6_7:2053
msgctxt "text_id=8366 | speaker=unknown"
msgid "　でっぷりとした小鳥は無邪気そうな瞳を草十郎に向けている。"
msgstr "  The tiny, chubby bird innocently looked Soujyuro up and down."

#. Occurrence 6_7:2063:8367: scene=6_7
#: 6_7:2063
msgctxt "text_id=8367 | speaker=unknown"
msgid "　俗説で言うところの幸福を運ぶ青い鳥は、まるで彼の先行きを応援するように羽ばたくと、"
msgstr "  The blue robin, a bird said to bring happiness according to folklore, flapped its little wings as if to cheer him on."

#. Occurrence 6_7:2105:8368: scene=6_7
#: 6_7:2105
msgctxt "text_id=8368 | speaker=unknown"
msgid "　情け容赦なく、居間の電気を消したのだった。"
msgstr "  Then, with a flutter, it mercilessly flicked off the lights."

#. Occurrence 6_8:81:8369: scene=6_8
#: 6_8:81
msgctxt "text_id=8369 | speaker=unknown"
msgid "　草十郎を居間に残したまま、青子は自室に戻ってきた。"
msgstr "  Leaving Soujyuro alone in the drawing room, Aoko returned to her bedroom."

#. Occurrence 6_8:86:8370: scene=6_8
#: 6_8:86
msgctxt "text_id=8370 | speaker=unknown"
msgid "　ドアを閉めベッドに腰を下ろすと、どっと疲れが押し寄せてくる。"
msgstr "  She closed the door to her room, and as soon as she sat on her bed she was overcome by a unexpected wave of exhaustion."

#. Occurrence 6_8:91:8371: scene=6_8
#: 6_8:91
msgctxt "text_id=8371 | speaker=unknown"
msgid "　草十郎には知るよしもないが、青子は青子で臨戦態勢だったのだ。"
msgstr "  Soujyuro had no way of knowing, but she had been preparing for war."

#. Occurrence 6_8:96:8372: scene=6_8
#: 6_8:96
msgctxt "text_id=8372 | speaker=unknown"
msgid "　いつ有珠が直情にかられてプロイを持ちだしても、即座に反応できるように。"
msgstr "  In the event that Alice impulsively pulled out a Ploy, Aoko had to be ready to react in an instant."

#. Occurrence 6_8:130:8373: scene=6_8
#: 6_8:130
msgctxt "text_id=8373 | speaker=unknown"
msgid "　はあ、とため息をつく。"
msgstr "  She sighed heavily."

#. Occurrence 6_8:135:8374: scene=6_8
#: 6_8:135
msgctxt "text_id=8374 | speaker=unknown"
msgid "　それは有珠との暗闘による気疲れ―――ではなく。"
msgstr "  But not from the fatigue she felt at fighting with Alice."

#. Occurrence 6_8:156:8375: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0000; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:156
msgctxt "text_id=8375 | speaker=aoko"
msgid "「……ちょっと突っぱねすぎたか？」"
msgstr "\"...Was I too hard on him?\""

#. Occurrence 6_8:162:8376: scene=6_8
#: 6_8:162
msgctxt "text_id=8376 | speaker=unknown"
msgid "　むう、と眉を<顰|ひそ>める。"
msgstr "  She frowned a dejected frown."

#. Occurrence 6_8:167:8377: scene=6_8
#: 6_8:167
msgctxt "text_id=8377 | speaker=unknown"
msgid "　彼女の頭を重くしているのは、まったく別の問題だった。"
msgstr "  What weighed on Aoko's mind was not Alice."

#. Occurrence 6_8:201:8378: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0001; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:201
msgctxt "text_id=8378 | speaker=aoko"
msgid "「……でも甘くするのはアイツのためにならないし。"
msgstr "\"...I mean, going easy on him wouldn't do him any favors, either."

#. Occurrence 6_8:207:8379: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0002; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:207
msgctxt "text_id=8379 | speaker=aoko"
msgid "　基本、大人しくしてもらった方がいいワケだし……」"
msgstr "  The best thing he can do for himself is to lay low.\""

#. Occurrence 6_8:213:8380: scene=6_8
#: 6_8:213
msgctxt "text_id=8380 | speaker=unknown"
msgid "　安心されて我が家のように歩き回られるのも困る。"
msgstr "  It would be trouble if he wandered around like he owned the place, after all."

#. Occurrence 6_8:218:8381: scene=6_8
#: 6_8:218
msgctxt "text_id=8381 | speaker=unknown"
msgid "　彼にはおっかなびっくり、極力、自分の部屋に閉じこもってもらった方が安全なのだ。"
msgstr "  The safest thing for him would be if he holed up in his room, too scared out of his wits to leave it."

#. Occurrence 6_8:245:8382: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0003; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:245
msgctxt "text_id=8382 | speaker=aoko"
msgid "「ま、蒼崎は味方だ、なんて勘違いされても困るしね。"
msgstr "\"God, I hope he doesn't think I'm his ally or something."

#. Occurrence 6_8:251:8383: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0004; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:251
msgctxt "text_id=8383 | speaker=aoko"
msgid "　有珠同様、人でなし扱いされた方が楽だわ」"
msgstr "  Alice is the lucky one, I'd kill to have him treat me as a stranger.\""

#. Occurrence 6_8:278:8384: scene=6_8
#: 6_8:278
msgctxt "text_id=8384 | speaker=unknown"
msgid "　よし、と自分の選択に納得する青子。"
msgstr "  She nodded to herself, agreeing with her take on the situation."

#. Occurrence 6_8:283:8385: scene=6_8
#: 6_8:283
msgctxt "text_id=8385 | speaker=unknown"
msgid "　彼女の方針はおおむね正しい。"
msgstr "  For the most part, it was a sound plan."

#. Occurrence 6_8:302:8386: scene=6_8
#: 6_8:302
msgctxt "text_id=8386 | speaker=unknown"
msgid "　問題があるとすれば、"
msgstr "  If there were a problem, it would be this."

#. Occurrence 6_8:337:8387: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_8_0000; voice_prefix=A30; voice_category=3; scene=6_8
#: 6_8:337
msgctxt "text_id=8387 | speaker=soujuurou"
msgid "「すまない蒼崎。ひとつ聞きたい事があるんだが……」"
msgstr "\"Sorry Aozaki. I just have one quick question.\""

#. Occurrence 6_8:356:8388: scene=6_8
#: 6_8:356
msgctxt "text_id=8388 | speaker=unknown"
msgid "　居間で別れてから十分弱。"
msgstr "  Not ten minutes had passed since leaving him in the drawing room."

#. Occurrence 6_8:361:8389: scene=6_8
#: 6_8:361
msgctxt "text_id=8389 | speaker=unknown"
msgid "　最速とも言える開き直りで青子の部屋を訪れた、静希草十郎の危機感の無さだった。"
msgstr "  For Soujyuro to shirk off what she had said and visit her room so fast, it was like he had no sense of danger at all."

#. Occurrence 6_8:429:8390: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_8_0001; voice_prefix=A30; voice_category=3; scene=6_8
#: 6_8:429
msgctxt "text_id=8390 | speaker=soujuurou"
msgid "「実は、外に出たいんだ」"
msgstr "\"I need to go outside.\""

#. Occurrence 6_8:435:8391: scene=6_8
#: 6_8:435
msgctxt "text_id=8391 | speaker=unknown"
msgid "　それがこの男の言い分だった。"
msgstr "  Of course he would ask to leave the house."

#. Occurrence 6_8:463:8392: scene=6_8
#: 6_8:463
msgctxt "text_id=8392 | speaker=unknown"
msgid "　青子には嫌味を返す気力もない。"
msgstr "  Aoko lacked the energy for a sarcastic barb."

#. Occurrence 6_8:493:8393: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_8_0002; voice_prefix=A30; voice_category=3; scene=6_8
#: 6_8:493
msgctxt "text_id=8393 | speaker=soujuurou"
msgid "「洋館の中は歩き回らないし、用を済ませたらきちんと戻ってくる。ただ、門限とかあったら聞いておこうと思って」"
msgstr "\"I won't wander around the mansion, and I'll come right back when I'm finished. I just figured I should check if there was a curfew or anything.\""

#. Occurrence 6_8:539:8394: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0005; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:539
msgctxt "text_id=8394 | speaker=aoko"
msgid "「でも、アルバイトには行くのよね」"
msgstr "\"Work, is it?\""

#. Occurrence 6_8:555:8395: scene=6_8
#: 6_8:555
msgctxt "text_id=8395 | speaker=unknown"
msgid "　なんで分かる!?　と驚く草十郎。"
msgstr "  \"How did you know?!\" Soujyuro exclaimed in surprise."

#. Occurrence 6_8:560:8396: scene=6_8
#: 6_8:560
msgctxt "text_id=8396 | speaker=unknown"
msgid "　正直、驚きたいのは青子の方である。"
msgstr "  When it was Aoko who desired to display her shock at him."

#. Occurrence 6_8:587:8397: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0006; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:587
msgctxt "text_id=8397 | speaker=aoko"
msgid "「……まあいいわ。"
msgstr "\"Fine. You can go."

#. Occurrence 6_8:593:8398: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0007; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:593
msgctxt "text_id=8398 | speaker=aoko"
msgid "　基本、午後十時まで。その時間には必ず屋敷にいること。"
msgstr "  You should make sure you're back on the estate by ten every night."

#. Occurrence 6_8:593:8399: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0007; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:593
msgctxt "text_id=8399 | speaker=aoko"
msgid "　その後は夜勤にでかけるなり、庭でバーベキューするなり、なんでも好きにしていい。"
msgstr "  As long as you keep to the curfew, you can go work your after-school job, have a barbecue in the garden, do whatever you want. I don't care."

#. Occurrence 6_8:605:8400: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0008; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:605
msgctxt "text_id=8400 | speaker=aoko"
msgid "　それと、玄関に鍵はかかってないから」"
msgstr "  The front door is never locked anyway.\""

#. Occurrence 6_8:629:8401: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_8_0003; voice_prefix=A30; voice_category=3; scene=6_8
#: 6_8:629
msgctxt "text_id=8401 | speaker=soujuurou"
msgid "「……気のせいじゃなければだけど。"
msgstr "\"...I get the impression you're, err..."

#. Occurrence 6_8:635:8402: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_8_0004; voice_prefix=A30; voice_category=3; scene=6_8
#: 6_8:635
msgctxt "text_id=8402 | speaker=soujuurou"
msgid "　蒼崎、すごく怒ってないか？」"
msgstr "  Angry with me.\""

#. Occurrence 6_8:678:8403: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0009; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:678
msgctxt "text_id=8403 | speaker=aoko"
msgid "「アンタ相手に気を遣った自分に<呆|あき>れ果ててるだけよ。"
msgstr "\"I'm angry all right, just not with you. I'm angry at myself for caring what happens to you."

#. Occurrence 6_8:690:8404: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0010; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:690
msgctxt "text_id=8404 | speaker=aoko"
msgid "　外に出るのはいいけど、その前にこの<錠剤|じょうざい>飲んで」"
msgstr "  And before you go out, take this pill.\""

#. Occurrence 6_8:696:8405: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_8_0005; voice_prefix=A30; voice_category=3; scene=6_8
#: 6_8:696
msgctxt "text_id=8405 | speaker=soujuurou"
msgid "「？？」"
msgstr "\"??\""

#. Occurrence 6_8:701:8406: scene=6_8
#: 6_8:701
msgctxt "text_id=8406 | speaker=unknown"
msgid "　青子から差し出された紫色の錠剤を、半信半疑で草十郎は口に入れた。"
msgstr "  Soujyuro took the purple pill from her outstretched hand and dubiously put it in his mouth."

#. Occurrence 6_8:706:8407: scene=6_8
#: 6_8:706
msgctxt "text_id=8407 | speaker=unknown"
msgid "　体に<良|い>い薬か何かだろう、と思いこんでいる風だ。"
msgstr "  He told himself that it must have been some kind of medicine."

#. Occurrence 6_8:745:8408: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_8_0006; voice_prefix=A30; voice_category=3; scene=6_8
#: 6_8:745
msgctxt "text_id=8408 | speaker=soujuurou"
msgid "「それじゃ行ってくる。色々ありがとう、蒼崎」"
msgstr "\"All right, I'm off then. Thanks for everything, Aozaki.\""

#. Occurrence 6_8:751:8409: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0011; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:751
msgctxt "text_id=8409 | speaker=aoko"
msgid "「あっそ。今度は窓から出ていかないでよね」"
msgstr "\"Oh and...don't leave through the window this time, okay?\""

#. Occurrence 6_8:784:8410: scene=6_8
#: 6_8:784
msgctxt "text_id=8410 | speaker=unknown"
msgid "　何が嬉しいのか、あはは、などと平和ぼけに笑って草十郎はホールへ向かっていった。"
msgstr "  Soujyuro laughed himself all the way to the foyer, unsure of what exactly he had found funny."

#. Occurrence 6_8:789:8411: scene=6_8
#: 6_8:789
msgctxt "text_id=8411 | speaker=unknown"
msgid "　その背中を、青子は<半|なか>ば冷たく、半ば不思議そうに観察する。"
msgstr "  Aoko watched him go, both indifferent and amazed all at once."

#. Occurrence 6_8:825:8412: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0012; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:825
msgctxt "text_id=8412 | speaker=aoko"
msgid "「ま、予定が半日早まっただけか。"
msgstr "\"Well that happened about half a day earlier than planned."

#. Occurrence 6_8:832:8413: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_8_0013; voice_prefix=A10; voice_category=1; scene=6_8
#: 6_8:832
msgctxt "text_id=8413 | speaker=aoko"
msgid "あの薬を飲ませるの、明日の朝にしてあげようと思ったのに」"
msgstr "He was supposed to take his first pill tomorrow morning.\""

#. Occurrence 6_8:896:8414: scene=6_8
#: 6_8:896
msgctxt "text_id=8414 | speaker=unknown"
msgid "　やれやれと髪をかいて自室に戻る。"
msgstr "  She huffed, ruffling her hair in exasperation and returning to her room."

#. Occurrence 6_8:901:8415: scene=6_8
#: 6_8:901
msgctxt "text_id=8415 | speaker=unknown"
msgid "　彼の行動原理なんて考えるまでもない。"
msgstr "  Discerning what made Soujyuro tick was a waste of brain matter."

#. Occurrence 6_8:906:8416: scene=6_8
#: 6_8:906
msgctxt "text_id=8416 | speaker=unknown"
msgid "　おおかた、二日間寝こんでいた自分の体より、アルバイトを休んでいた事の方が気になっていたのだろう。"
msgstr "  In all likeliness, he was more concerned about missing two days of work than his own well-being after being bedridden for two days."

#. Occurrence 6_9:91:8417: scene=6_9
#: 6_9:91
msgctxt "text_id=8417 | speaker=unknown"
msgid "　一日の仕事を終え、草十郎は洋館に戻ってきた。"
msgstr "  With the day's work behind him, Soujyuro returned to the mansion."

#. Occurrence 6_9:113:8418: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0000; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:113
msgctxt "text_id=8418 | speaker=soujuurou"
msgid "「よし。どこを探しても、二階のホールから上がれる階段はここだけだ」"
msgstr "\"This must be it. It's the only set of stairs leading up from the second floor hall.\""

#. Occurrence 6_9:119:8419: scene=6_9
#: 6_9:119
msgctxt "text_id=8419 | speaker=unknown"
msgid "　日付も替わろうとする零時前。"
msgstr "  It was just before midnight."

#. Occurrence 6_9:124:8420: scene=6_9
#: 6_9:124
msgctxt "text_id=8420 | speaker=unknown"
msgid "　くたびれた階段の先には、このような景色が広がっていた。"
msgstr "  This was the scene that awaited him beyond the rickety staircase."

#. Occurrence 6_9:173:8421: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0001; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:173
msgctxt "text_id=8421 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 6_9:179:8422: scene=6_9
#: 6_9:179
msgctxt "text_id=8422 | speaker=unknown"
msgid "　たいていのコトには驚かない……もう驚きなれてしまった……草十郎をして、それは、言葉を失う光景だった。"
msgstr "  Not much surprised Soujyuro. Or rather, being surprised had become normal to him. This scene, however, was enough to leave him speechless."

#. Occurrence 6_9:201:8423: scene=6_9
#: 6_9:201
msgctxt "text_id=8423 | speaker=unknown"
msgid "　草十郎にあてがわれた部屋は、"
msgstr "  The room allotted to Soujyuro,"

#. Occurrence 6_9:206:8424: scene=6_9
#: 6_9:206
msgctxt "text_id=8424 | speaker=unknown"
msgid "　どこをどう見ても、"
msgstr "  no matter how he looked at it,"

#. Occurrence 6_9:211:8425: scene=6_9
#: 6_9:211
msgctxt "text_id=8425 | speaker=unknown"
msgid "　何をとりつくろうとも、"
msgstr "  no matter how he ran it through in his mind,"

#. Occurrence 6_9:216:8426: scene=6_9
#: 6_9:216
msgctxt "text_id=8426 | speaker=unknown"
msgid "　まがうことなき屋根裏部屋でした。"
msgstr "  was without a shadow of a doubt, an attic."

#. Occurrence 6_9:238:8427: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0002; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:238
msgctxt "text_id=8427 | speaker=soujuurou"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 6_9:260:8428: scene=6_9
#: 6_9:260
msgctxt "text_id=8428 | speaker=unknown"
msgid "　むう、と己の<処遇|しょぐう>に<一抹|いちまつ>の不安を覚える。"
msgstr "  This treatment stirred a tinge of anxiety in him."

#. Occurrence 6_9:266:8429: scene=6_9
#: 6_9:266
msgctxt "text_id=8429 | speaker=unknown"
msgid "　ただでさえ気の重いことばかりなのに、こんなんでやっていけるのかな、とシーツの敷かれたベッドに倒れこもうとした時、"
msgstr "  Just as he was about to flop onto the taut sheets of his bed, wondering if he could make this work despite his share of other problems,"

#. Occurrence 6_9:273:8430: scene=6_9
#: 6_9:273
msgctxt "text_id=8430 | speaker=unknown"
msgid "　ささやかすぎて役に立たない、ちぐはぐな気遣いがあった。"
msgstr "  he noticed an awkward courtesy, so meager as to be useless."

#. Occurrence 6_9:296:8431: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_9_0000; voice_prefix=A10; voice_category=1; scene=6_9
#: 6_9:296
msgctxt "text_id=8431 | speaker=aoko"
msgid "『寒かったら重ねて使うこと。これはサービスとする』"
msgstr "\"Something to use if you get cold. Consider it a gift.\""

#. Occurrence 6_9:302:8432: scene=6_9
#: 6_9:302
msgctxt "text_id=8432 | speaker=unknown"
msgid "　メモにある文字は、几帳面な性格がにじみ出ている。"
msgstr "  The message in the memo pointed to the meticulous personality of the author."

#. Occurrence 6_9:307:8433: scene=6_9
#: 6_9:307
msgctxt "text_id=8433 | speaker=unknown"
msgid "　布団は十分用意されていた。"
msgstr "  The bed had been perfectly prepared."

#. Occurrence 6_9:314:8434: scene=6_9
#: 6_9:314
msgctxt "text_id=8434 | speaker=unknown"
msgid "　その上で、念のためにと置かれた毛布を大事そうに<端|はし>にどけて、草十郎は空を仰いだ。"
msgstr "  Carefully, setting aside the blanket that had been painstakingly placed on the edge of the bed for him in case he needed it, he looked up at the sky."

#. Occurrence 6_9:377:8435: scene=6_9
#: 6_9:377
msgctxt "text_id=8435 | speaker=unknown"
msgid "　おぼろげではあるが、天窓には星が<瞬|またた>いている。"
msgstr "  Though faint, the stars twinkled through the skylight."

#. Occurrence 6_9:382:8436: scene=6_9
#: 6_9:382
msgctxt "text_id=8436 | speaker=unknown"
msgid "　山育ちである彼にすれば、不満はあれ十分な明かりといえる。"
msgstr "  For a mountain boy, that meager light was more than enough for him."

#. Occurrence 6_9:387:8437: scene=6_9
#: 6_9:387
msgctxt "text_id=8437 | speaker=unknown"
msgid "　居間との格差から面食らってしまったが、冷静になれば落胆するコトでもない。"
msgstr "  The stark contrast with the drawing room had caught him off guard, but now that he had collected himself, it was not so bad."

#. Occurrence 6_9:407:8438: scene=6_9
#: 6_9:407
msgctxt "text_id=8438 | speaker=unknown"
msgid "　この部屋はこの部屋で彼の性格に合っているのだし。"
msgstr "  This room fit his personality."

#. Occurrence 6_9:412:8439: scene=6_9
#: 6_9:412
msgctxt "text_id=8439 | speaker=unknown"
msgid "　いまだ勝手の分からない建物だとしても、町の建物よりは安心できた。"
msgstr "  Even if he still was not used to the building, he felt more at ease here than he did in any building in the city, "

#. Occurrence 6_9:417:8440: scene=6_9
#: 6_9:417
msgctxt "text_id=8440 | speaker=unknown"
msgid "　丘の上、森の中に建っているからだろう。"
msgstr "  perhaps because it was built on a hill, surrounded by woods."

#. Occurrence 6_9:422:8441: scene=6_9
#: 6_9:422
msgctxt "text_id=8441 | speaker=unknown"
msgid "　ここは少しだけ彼の住んでいた山の空気に近いのだ。"
msgstr "  The atmosphere here was a little closer to the mountains where he used to live."

#. Occurrence 6_9:443:8442: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0003; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:443
msgctxt "text_id=8442 | speaker=soujuurou"
msgid "「……あ。でも、家の中に霧が出るのはどうなんだろう？」"
msgstr "\"...Oh. Is it normal for there to be fog inside the house?\""

#. Occurrence 6_9:468:8443: scene=6_9
#: 6_9:468
msgctxt "text_id=8443 | speaker=unknown"
msgid "　先ほどの光景を思い返して首をかしげる。"
msgstr "  He crooked his neck, pondering over the spectacle he had witnessed."

#. Occurrence 6_9:473:8444: scene=6_9
#: 6_9:473
msgctxt "text_id=8444 | speaker=unknown"
msgid "　草十郎はここに来る途中、二階のホールで霧らしきものを見かけていた。"
msgstr "  On the way to his room, Soujyuro had encountered what looked like fog in the foyer on the second floor."

#. Occurrence 6_9:544:8445: scene=6_9
#: 6_9:544
msgctxt "text_id=8445 | speaker=unknown"
msgid "　白い霧は廊下の一部分にだけ漂っていて、<藪蚊|やぶか>の群を思わせた。"
msgstr "  The misty fog drifted into a portion of the corridor, reminding him of a swarm of mosquitoes."

#. Occurrence 6_9:555:8446: scene=6_9
#: 6_9:555
msgctxt "text_id=8446 | speaker=unknown"
msgid "　じっと見ていると、おかしな風景が見えた気がして近寄ったのだが、"
msgstr "  As he stared at it, he swore he could make out a strange landscape, and as he moved closer to get a better look..."

#. Occurrence 6_9:568:8447: scene=6_9
#: 6_9:568
msgctxt "text_id=8447 | speaker=unknown"
msgid "　これまたとつぜん、不自然なことに青い小鳥が目の前を横切ったのだ。館内で。"
msgstr "  Again, out of nowhere, here inside of the mansion, a little blue bird darted purposefully in front of him."

#. Occurrence 6_9:634:8448: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0004; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:634
msgctxt "text_id=8448 | speaker=soujuurou"
msgid "「―――鳥？」"
msgstr "\"...A bird?\""

#. Occurrence 6_9:640:8449: scene=6_9
#: 6_9:640
msgctxt "text_id=8449 | speaker=unknown"
msgid "　小鳥に気を取られて立ち止まる。"
msgstr "  The bird caught his attention, stopping him in his tracks."

#. Occurrence 6_9:645:8450: scene=6_9
#: 6_9:645
msgctxt "text_id=8450 | speaker=unknown"
msgid "　もう一度霧を見ると、おかしな風景は消えていた。"
msgstr "  When he looked to check on the fog again, the strange scene had disappeared."

#. Occurrence 6_9:695:8451: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0005; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:695
msgctxt "text_id=8451 | speaker=soujuurou"
msgid "「……この家、隙間でもあるのかな。"
msgstr "\"...This house must have a draft."

#. Occurrence 6_9:695:8452: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0005; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:695
msgctxt "text_id=8452 | speaker=soujuurou"
msgid "　明日、蒼崎に訊いてみるか」"
msgstr "  I'll ask Aozaki about it tomorrow,\""

#. Occurrence 6_9:701:8453: scene=6_9
#: 6_9:701
msgctxt "text_id=8453 | speaker=unknown"
msgid "　ベッドに腰掛けながら呟く。"
msgstr "  he muttered to himself as he sat on the bed."

#. Occurrence 6_9:706:8454: scene=6_9
#: 6_9:706
msgctxt "text_id=8454 | speaker=unknown"
msgid "　天窓から<覗|のぞ>く星の光は、ささやかではあるが気持ちを落ち着かせてくれた。"
msgstr "  Meager as it was, the starlight peeping in through the skylight calmed him."

#. Occurrence 6_9:733:8455: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0006; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:733
msgctxt "text_id=8455 | speaker=soujuurou"
msgid "「うん、これなら―――」"
msgstr "\"Yeah, this will work.\""

#. Occurrence 6_9:746:8456: scene=6_9
#: 6_9:746
msgctxt "text_id=8456 | speaker=unknown"
msgid "　ほう、と息を吐いてベッドに体を預ける。"
msgstr "  Exhaling slowly, he laid down."

#. Occurrence 6_9:751:8457: scene=6_9
#: 6_9:751
msgctxt "text_id=8457 | speaker=unknown"
msgid "　とりあえず衣食住はあるのだし、ベッドは見た目より何倍も柔らかいし。"
msgstr "  For the time being, he had the essentials needed to live, and his bed was many times softer than it appeared."

#. Occurrence 6_9:756:8458: scene=6_9
#: 6_9:756
msgctxt "text_id=8458 | speaker=unknown"
msgid "　心配事はあまりないな、と草十郎は速やかに眠りに落ちていった。"
msgstr "  Thinking his worries seemed smaller than they were, he quickly drifted off to sleep."

#. Occurrence 6_9:805:8459: scene=6_9
#: 6_9:805
msgctxt "text_id=8459 | speaker=unknown"
msgid "　以上が、彼の目覚めてから眠るまでの話。"
msgstr "  That was the story of from when he opened his eyes, to when he fell asleep."

#. Occurrence 6_9:811:8460: scene=6_9
#: 6_9:811
msgctxt "text_id=8460 | speaker=unknown"
msgid "　長い夜のあとの、短い夜はこうして終わった。"
msgstr "  Just like that, the short night following the long night was over."

#. Occurrence 6_9:817:8461: scene=6_9
#: 6_9:817
msgctxt "text_id=8461 | speaker=unknown"
msgid "　……どうあれ。"
msgstr "  For one thing was true..."

#. Occurrence 6_9:822:8462: scene=6_9
#: 6_9:822
msgctxt "text_id=8462 | speaker=unknown"
msgid "　楽観的すぎるけれど、やっていけない事はなさそうだ。"
msgstr "  Soujyuro was an optimist to a fault, but it wasn't the end of the world."

#. Occurrence 6_9:873:8463: scene=6_9
#: 6_9:873
msgctxt "text_id=8463 | speaker=unknown"
msgid "　そんな、踏まれても踏まれても応えない<天然草|てんねんそう>の話から、時間は五時間ほどさかのぼる。"
msgstr "  Now, let us rewind five hours prior to this glutton for punishment going to bed."

#. Occurrence 6_9:939:8464: scene=6_9
#: 6_9:939
msgctxt "text_id=8464 | speaker=unknown"
msgid "　魔術師の当事者ふたりと、おまけの少年の不毛な話し合いが終わった午後七時。"
msgstr "  It was seven o'clock in the evening, just after the unproductive discussion between the two mages and the boy had ended."

#. Occurrence 6_9:944:8465: scene=6_9
#: 6_9:944
msgctxt "text_id=8465 | speaker=unknown"
msgid "　居間に<同居人|あおこ>と<闖入者|そうじゅうろう>を残したまま、少女はひとりロビーを歩いていた。"
msgstr "  Leaving her roommate and the intruder in the drawing room, the girl walked alone through the foyer."

#. Occurrence 6_9:949:8466: scene=6_9
#: 6_9:949
msgctxt "text_id=8466 | speaker=unknown"
msgid "　向かう先は館の西館。"
msgstr "  From there, she headed to the west wing."

#. Occurrence 6_9:954:8467: scene=6_9
#: 6_9:954
msgctxt "text_id=8467 | speaker=unknown"
msgid "　同居人である蒼崎青子でさえ滅多に足を踏み入れない、久遠寺有珠の居住区である。"
msgstr "  These were Alice Kuonji's personal chambers, in which even her roommate, Aoko Aozaki, seldom dared to step foot."

#. Occurrence 6_9:998:8468: scene=6_9
#: 6_9:998
msgctxt "text_id=8468 | speaker=unknown"
msgid "　月明かりだけのロビー。"
msgstr "  The foyer was illuminated only by pale moonlight."

#. Occurrence 6_9:1003:8469: scene=6_9
#: 6_9:1003
msgctxt "text_id=8469 | speaker=unknown"
msgid "　寒々しい明かりの下、硬い足音が<木霊|こだま>している。"
msgstr "  Hard footsteps echoed through the dreary, moonlit lobby."

#. Occurrence 6_9:1008:8470: scene=6_9
#: 6_9:1008
msgctxt "text_id=8470 | speaker=unknown"
msgid "　洋風の屋敷では靴を脱ぐ習慣はない。"
msgstr "  In such mansions in Japan, there was no custom for removing shoes at the door."

#. Occurrence 6_9:1013:8471: scene=6_9
#: 6_9:1013
msgctxt "text_id=8471 | speaker=unknown"
msgid "　有珠はブーツのままロビーを横断する。"
msgstr "  Hence, Alice crossed the foyer in her boots."

#. Occurrence 6_9:1018:8472: scene=6_9
#: 6_9:1018
msgctxt "text_id=8472 | speaker=unknown"
msgid "　彼女が靴を脱ぐのは寝室で休む時だけだ。"
msgstr "  She only removed them when she relaxed in her bedroom."

#. Occurrence 6_9:1080:8473: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0000; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1080
msgctxt "text_id=8473 | speaker=alice"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 6_9:1086:8474: scene=6_9
#: 6_9:1086
msgctxt "text_id=8474 | speaker=unknown"
msgid "　……ふと、有珠は子供の頃の出来事を思い出した。"
msgstr "  ...Suddenly, she remembered something from her childhood."

#. Occurrence 6_9:1091:8475: scene=6_9
#: 6_9:1091
msgctxt "text_id=8475 | speaker=unknown"
msgid "　冷たい床の感覚を楽しみたくて、日射しの強い日は裸足でこのロビーを歩いた。"
msgstr "  She used to enjoy the feeling of the cold hardwood floor on her bare feet, and would walk around the foyer on particularly sunny days."

#. Occurrence 6_9:1096:8476: scene=6_9
#: 6_9:1096
msgctxt "text_id=8476 | speaker=unknown"
msgid "　それを父に優しく<咎|とが>められて以来、彼女は裸足で歩く事はなくなったのだが―――"
msgstr "  After her father affectionately scolded her for it, she never did it again."

#. Occurrence 6_9:1141:8477: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0001; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1141
msgctxt "text_id=8477 | speaker=alice"
msgid "「……そうだったわね。青子は結局、守らなかった」"
msgstr "\"And I don't know why I bother. Aoko never does.\""

#. Occurrence 6_9:1147:8478: scene=6_9
#: 6_9:1147
msgctxt "text_id=8478 | speaker=unknown"
msgid "　かすかなため息がもれる。"
msgstr "  She let out a quiet sigh."

#. Occurrence 6_9:1152:8479: scene=6_9
#: 6_9:1152
msgctxt "text_id=8479 | speaker=unknown"
msgid "　日本に来てから得た新しい同居人は、有珠の言いつけには従わなかった。"
msgstr "  Alice's new roommate, whom she took on after coming to Japan, would not comply with her instructions."

#. Occurrence 6_9:1193:8480: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_6_9_0001; voice_prefix=A10; voice_category=1; scene=6_9
#: 6_9:1193
msgctxt "text_id=8480 | speaker=aoko"
msgid "“落ち着かないものはしょうがない”"
msgstr "\"Old habits die hard.\""

#. Occurrence 6_9:1199:8481: scene=6_9
#: 6_9:1199
msgctxt "text_id=8481 | speaker=unknown"
msgid "　と、青子はスリッパに履き替える事がある。"
msgstr "  Aoko would say, changing into her slippers."

#. Occurrence 6_9:1204:8482: scene=6_9
#: 6_9:1204
msgctxt "text_id=8482 | speaker=unknown"
msgid "　中学生まで一般家屋で暮らしていた青子にすれば自然なのだろうが、あのペタペタいう足音でロビーを移動される度に、有珠は彼女との共同生活を破棄したくなったものだ。"
msgstr "  Aoko might have found it natural to do so given that she lived in a typical Japanese house through middle school, but every time Alice heard her flip-flopping through the foyer, she wanted to cancel their cohabitation."

#. Occurrence 6_9:1240:8483: scene=6_9
#: 6_9:1240
msgctxt "text_id=8483 | speaker=unknown"
msgid "　それも今ではさして気にはならない。"
msgstr "  By now, Alice was not particularly bothered by it anymore."

#. Occurrence 6_9:1245:8484: scene=6_9
#: 6_9:1245
msgctxt "text_id=8484 | speaker=unknown"
msgid "　人間の順応性は時に優秀で、不義理だ。"
msgstr "  Human adaptability was remarkable at times, and ungracious at others."

#. Occurrence 6_9:1250:8485: scene=6_9
#: 6_9:1250
msgctxt "text_id=8485 | speaker=unknown"
msgid "　現実の<忙|いそが>しさの前には、昔からの思い入れなんて<脆|もろ>すぎる。"
msgstr "  The emotional attachments of the past had proved far too brittle under the weight of reality."

#. Occurrence 6_9:1294:8486: scene=6_9
#: 6_9:1294
msgctxt "text_id=8486 | speaker=unknown"
msgid "　階段の手すりには青い小鳥が止まっていた。"
msgstr "  A little blue bird was perched on the banister."

#. Occurrence 6_9:1302:8487: scene=6_9
#: 6_9:1302
msgctxt "text_id=8487 | speaker=unknown"
msgid "　小さな鳴き声に、少女は足を止めて視線を向ける。"
msgstr "  Its tiny chirping made Alice stop and look its way."

#. Occurrence 6_9:1319:8488: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0002; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1319
msgctxt "text_id=8488 | speaker=alice"
msgid "「……今夜は放っておくわ。今は青子の問題よ」"
msgstr "\"...Leave him be for tonight. Right now, he's Aoko's problem.\""

#. Occurrence 6_9:1371:8489: scene=6_9
#: 6_9:1371
msgctxt "text_id=8489 | speaker=unknown"
msgid "　感情の乏しい声に、小鳥は首をかしげながら鳴いた。"
msgstr "  The lack of feeling in her voice made the bird tilt its head as it sang."

#. Occurrence 6_9:1377:8490: scene=6_9
#: 6_9:1377
msgctxt "text_id=8490 | speaker=unknown"
msgid "　チチチ、と。"
msgstr "  Tweet tweet tweet."

#. Occurrence 6_9:1382:8491: scene=6_9
#: 6_9:1382
msgctxt "text_id=8491 | speaker=unknown"
msgid "　いつもの<主人|アリス>からは考えつかない、懐の深さを<訝|いぶか>しむように。"
msgstr "  It trilled, as though questioning its master's uncharacteristic leniency."

#. Occurrence 6_9:1423:8492: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0003; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1423
msgctxt "text_id=8492 | speaker=alice"
msgid "「約束は約束よ。今夜ぐらいは大目に見ないと。"
msgstr "\"A promise is a promise. I can at least tolerate him for tonight."

#. Occurrence 6_9:1429:8493: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0004; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1429
msgctxt "text_id=8493 | speaker=alice"
msgid "　……青子と彼は、それだけの活躍をしたのだし」"
msgstr "  Aoko and the boy did go to such lengths, after all.\""

#. Occurrence 6_9:1435:8494: scene=6_9
#: 6_9:1435
msgctxt "text_id=8494 | speaker=unknown"
msgid "　小鳥に言い聞かせる声は、内容とは裏腹に不機嫌気味だ。"
msgstr "  She said to the bird, her voice betraying her discontent."

#. Occurrence 6_9:1440:8495: scene=6_9
#: 6_9:1440
msgctxt "text_id=8495 | speaker=unknown"
msgid "“勝負に勝てば見逃してあげる”"
msgstr "\"If you win, I'll let you go.\""

#. Occurrence 6_9:1445:8496: scene=6_9
#: 6_9:1445
msgctxt "text_id=8496 | speaker=unknown"
msgid "　その約束を守ってはいるものの、少女の胸には消しがたい戦意が灯っている。"
msgstr "  She would keep that promise, in spite of the unquenchable desire to fight that burned in her chest."

#. Occurrence 6_9:1480:8497: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0005; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1480
msgctxt "text_id=8497 | speaker=alice"
msgid "「……でも、その後の処遇は別の話。"
msgstr "\"...But I didn't make any guarantees after that."

#. Occurrence 6_9:1486:8498: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0006; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1486
msgctxt "text_id=8498 | speaker=alice"
msgid "　条件付きのゲームに勝ったぐらいで、いつまでも得意げでいられるのは心外だわ」"
msgstr "  She scraped a win even with a handicap in our little game, but I won't let her strut around childishly rubbing it my face forever.\""

#. Occurrence 6_9:1492:8499: scene=6_9
#: 6_9:1492
msgctxt "text_id=8499 | speaker=unknown"
msgid "　潔癖性からくる完全主義か。"
msgstr "  Perhaps it was perfectionism born of fastidiousness, but "

#. Occurrence 6_9:1497:8500: scene=6_9
#: 6_9:1497
msgctxt "text_id=8500 | speaker=unknown"
msgid "　こう見えて久遠寺有珠は負けず嫌いらしい。"
msgstr "  despite her prim demeanor, Alice Kuonji was a sore loser."

#. Occurrence 6_9:1502:8501: scene=6_9
#: 6_9:1502
msgctxt "text_id=8501 | speaker=unknown"
msgid "　魔術の優劣などどうでもいいが、ゲームに負けた事が今も不満で仕方がないのだ。"
msgstr "  It did not matter to her whose magecraft was superior. Losing the game had proven hard to move on from."

#. Occurrence 6_9:1548:8502: scene=6_9
#: 6_9:1548
msgctxt "text_id=8502 | speaker=unknown"
msgid "　シュタ、と翼をあげて同意する小鳥。"
msgstr "  The little bird fluttered its wings in agreement."

#. Occurrence 6_9:1553:8503: scene=6_9
#: 6_9:1553
msgctxt "text_id=8503 | speaker=unknown"
msgid "　有珠の嫌悪感を汲んで、<草十郎|がいてき>を打ちのめさんとやる気に満ちている。"
msgstr "  Drinking in Alice's contempt, it was itching to dive-bomb the invader."

#. Occurrence 6_9:1558:8504: scene=6_9
#: 6_9:1558
msgctxt "text_id=8504 | speaker=unknown"
msgid "　その<羽繕|はづくろ>いは、上官に<敬礼|けいれい>する仕草に見えなくもない。"
msgstr "  It looked like a soldier saluting a superior officer as it preened itself."

#. Occurrence 6_9:1618:8505: scene=6_9
#: 6_9:1618
msgctxt "text_id=8505 | speaker=unknown"
msgid "　かくして、青い小鳥は主人に向き直る。"
msgstr "  The blue bird turned to face its master."

#. Occurrence 6_9:1625:8506: scene=6_9
#: 6_9:1625
msgctxt "text_id=8506 | speaker=unknown"
msgid "　チチチ、チチチ。"
msgstr "  Tweet tweet tweet, tweet tweet tweet."

#. Occurrence 6_9:1630:8507: scene=6_9
#: 6_9:1630
msgctxt "text_id=8507 | speaker=unknown"
msgid "　軽快な鳴き声は、明日の朝一番で<草十郎|アイツ>をヤりましょう、と宣言するかのようだ。"
msgstr "  Its lighthearted tweeting seemed to display a desire to deal with Soujyuro first thing in the morning."

#. Occurrence 6_9:1677:8508: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0007; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1677
msgctxt "text_id=8508 | speaker=alice"
msgid "「…………そうね。理由さえできたのなら、瓶なり本なりに入ってもらいましょう」"
msgstr "\"...Indeed. If he gives us a reason, let us put him in a bottle, or perhaps a book.\""

#. Occurrence 6_9:1706:8509: scene=6_9
#: 6_9:1706
msgctxt "text_id=8509 | speaker=unknown"
msgid "　だが、少女の声には張りがなかった。"
msgstr "  Except, her words lacked any bite."

#. Occurrence 6_9:1712:8510: scene=6_9
#: 6_9:1712
msgctxt "text_id=8510 | speaker=unknown"
msgid "　魔女らしい、容赦のない台詞だったが、よくよく考えてみれば<生温|なまぬる>いコトこの上ない。コマドリ的に。"
msgstr "  On the face of it, they were the chilling kind one might come to expect from a witch's lips, but then again so tame as to remind you of a certain robin's flapping."

#. Occurrence 6_9:1747:8511: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0008; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1747
msgctxt "text_id=8511 | speaker=alice"
msgid "「しばらくの話よ。けど、それも<一時|いっとき>だけ。わたしの我慢も長くは続かないし。"
msgstr "\"It's only a matter of time, and there's not very much at that. My patience has its limits."

#. Occurrence 6_9:1753:8512: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0009; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1753
msgctxt "text_id=8512 | speaker=alice"
msgid "　……だいたい、青子も人にかまけていられる立場じゃないわ。五日もすれば思い知るでしょう。そうすれば―――」"
msgstr "  Aoko is in no position to dote on others in the first place. I give her five days. And then...\""

#. Occurrence 6_9:1792:8513: scene=6_9
#: 6_9:1792
msgctxt "text_id=8513 | speaker=unknown"
msgid "　その時こそ、彼を<排斥|はいせき>するのは<容易|たやす>い。"
msgstr "  When that time came, expelling him would be simple."

#. Occurrence 6_9:1797:8514: scene=6_9
#: 6_9:1797
msgctxt "text_id=8514 | speaker=unknown"
msgid "　同居人が夢のない合理主義者である事を、有珠はよく分かっている。"
msgstr "  Alice was well aware her roommate was a pragmatist with no vision."

#. Occurrence 6_9:1817:8515: scene=6_9
#: 6_9:1817
msgctxt "text_id=8515 | speaker=unknown"
msgid "　青子の置かれた状況は、いつまでもあんな余分を許しはしない。"
msgstr "  The situation she'd created would not allow her to wait around."

#. Occurrence 6_9:1822:8516: scene=6_9
#: 6_9:1822
msgctxt "text_id=8516 | speaker=unknown"
msgid "　あの少年の保護に割り当てる<時間|よゆう>は、せいぜい三日から四日ほど。"
msgstr "  She could only afford to protect that boy for three or four days at most."

#. Occurrence 6_9:1827:8517: scene=6_9
#: 6_9:1827
msgctxt "text_id=8517 | speaker=unknown"
msgid "　それを過ぎれば青子の方から“あとは有珠の判断に任せる”と折れるだろう。"
msgstr "  Beyond that, Alice sensed Aoko would crack and say something like, \"You take care of this, Alice.\""

#. Occurrence 6_9:1848:8518: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0010; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1848
msgctxt "text_id=8518 | speaker=alice"
msgid "「それまで待つか、あるいはわたしの我慢がきかなくなるか。"
msgstr "\"Will I wait until then, or will I lose my patience first?"

#. Occurrence 6_9:1854:8519: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0011; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1854
msgctxt "text_id=8519 | speaker=alice"
msgid "　どちらにしても結果は変わらないわ」"
msgstr "  Whichever comes first, the end result will be the same.\""

#. Occurrence 6_9:1860:8520: scene=6_9
#: 6_9:1860
msgctxt "text_id=8520 | speaker=unknown"
msgid "　久遠寺有珠はこれ以上の厄介事を許さない。"
msgstr "  Alice Kuonji would suffer no more irritations."

#. Occurrence 6_9:1867:8521: scene=6_9
#: 6_9:1867
msgctxt "text_id=8521 | speaker=unknown"
msgid "　目撃者の保護や、まして、この洋館に住まわせるなんてもってのほかで―――"
msgstr "  And protecting a witness, let alone allowing them to live in her mansion, was an *indignity*."

#. Occurrence 6_9:1936:8522: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0012; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:1936
msgctxt "text_id=8522 | speaker=alice"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 6_9:1942:8523: scene=6_9
#: 6_9:1942
msgctxt "text_id=8523 | speaker=unknown"
msgid "　<漏|も>れだした<濃霧|のうむ>に引かれるよう、有珠は視線を上げた。"
msgstr "  Alice looked up, fascinated by the dense fog that had crawled into the foyer."

#. Occurrence 6_9:1947:8524: scene=6_9
#: 6_9:1947
msgctxt "text_id=8524 | speaker=unknown"
msgid "　暖炉の上には一枚の鏡がある。"
msgstr "  Above the fireplace was a single mirror."

#. Occurrence 6_9:1998:8525: scene=6_9
#: 6_9:1998
msgctxt "text_id=8525 | speaker=unknown"
msgid "　本来なら絵画が飾られるだろう壁には、直径一メートルほどの鏡。"
msgstr "  Roughly three feet in diameter, it decorated the wall where one might find a painting."

#. Occurrence 6_9:2003:8526: scene=6_9
#: 6_9:2003
msgctxt "text_id=8526 | speaker=unknown"
msgid "　鏡の表面はぼんやりと<曇|くも>り、ロビーの様子を<曖昧|あいまい>に映している。"
msgstr "  Its surface was faintly clouded, and vaguely reflected the foyer's appearance."

#. Occurrence 6_9:2032:8527: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0013; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:2032
msgctxt "text_id=8527 | speaker=alice"
msgid "「……スナークを<喪|な>くした影響でしょうね。"
msgstr "\"This is what I get for losing the Snark."

#. Occurrence 6_9:2038:8528: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0014; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:2038
msgctxt "text_id=8528 | speaker=alice"
msgid "　鏡の機能、しばらくは制御できないみたい」"
msgstr "  I suppose that means the mirror is out of commission for the time being.\""

#. Occurrence 6_9:2067:8529: scene=6_9
#: 6_9:2067
msgctxt "text_id=8529 | speaker=unknown"
msgid "　主人の呟きに、小鳥は喜びの<鳴|こえ>をあげた。"
msgstr "  The little bird joyfully chirped at its master's mumbling."

#. Occurrence 6_9:2072:8530: scene=6_9
#: 6_9:2072
msgctxt "text_id=8530 | speaker=unknown"
msgid "　それなら自分たちが手を下すまでもなく、邪魔者は鏡に落ちて退場すると。"
msgstr "  The bird attempted to imply that there was no need for her to lift a finger, not if the nuisance would fall into the mirror of his own accord."

#. Occurrence 6_9:2099:8531: scene=6_9
#: 6_9:2099
msgctxt "text_id=8531 | speaker=unknown"
msgid "　……あるいは。"
msgstr "  Or perhaps..."

#. Occurrence 6_9:2104:8532: scene=6_9
#: 6_9:2104
msgctxt "text_id=8532 | speaker=unknown"
msgid "　この小鳥さえそんな鳴き声をあげなければ、有珠も同じ意見だっただろう。"
msgstr "  Had the little bird had not sang, Alice would have come to the same conclusion."

#. Occurrence 6_9:2131:8533: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0015; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:2131
msgctxt "text_id=8533 | speaker=alice"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 6_9:2137:8534: scene=6_9
#: 6_9:2137
msgctxt "text_id=8534 | speaker=unknown"
msgid "　少女はなんとなしに、先ほどの会話を思い出した。"
msgstr "  For some reason, she recalled an earlier conversation."

#. Occurrence 6_9:2204:8535: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0016; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:2204
msgctxt "text_id=8535 | speaker=alice"
msgid "“これでも一番、無難だと思う？”"
msgstr "\"How about now? Still think this is the safest option?\""

#. Occurrence 6_9:2210:8536: scene=6_9
#: 6_9:2210
msgctxt "text_id=8536 | speaker=unknown"
msgid "　そう問うた少女に、小瓶の中の少年は肩をすくめながら答えた。"
msgstr "  In response to her question, the boy inside the bottle shrugged his shoulders and answered."

#. Occurrence 6_9:2236:8537: scene=6_9
#: 6_9:2236
msgctxt "text_id=8537 | speaker=unknown"
msgid "　自分にとっては町も<洋|こ><館|こ>も変わらない、と。"
msgstr "  From his perspective, the city and the mansion were no different."

#. Occurrence 6_9:2242:8538: scene=6_9
#: 6_9:2242
msgctxt "text_id=8538 | speaker=unknown"
msgid "　なんでも、田舎から出てきたばかりの彼にすれば、あらゆるものが“見たこともないもの”なのだそうだ。"
msgstr "  It seemed that having just moved from the countryside, everything was \"something he had never seen before.\""

#. Occurrence 6_9:2263:8539: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0007; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:2263
msgctxt "text_id=8539 | speaker=soujuurou"
msgid "『自慢できるコトじゃないが、まだ書き物さえ満足にできないし、都会のルールは複雑すぎて、何が正しいのかさえ区別がつかない』"
msgstr "\"I'm not proud of it, but I still have trouble writing, and the city rules are so complicated that I don't even know right from wrong.\""

#. Occurrence 6_9:2269:8540: scene=6_9
#: 6_9:2269
msgctxt "text_id=8540 | speaker=unknown"
msgid "　……あれは恥ずかしさより、<憤|いきどお>りに満ちた声だった。"
msgstr "  More than embarrassment, his voice was full of resentment."

#. Occurrence 6_9:2274:8541: scene=6_9
#: 6_9:2274
msgctxt "text_id=8541 | speaker=unknown"
msgid "　彼が何に対して怒っているのか、有珠には読み取れない。"
msgstr "  He was angry about something, though Alice could not tell what."

#. Occurrence 6_9:2279:8542: scene=6_9
#: 6_9:2279
msgctxt "text_id=8542 | speaker=unknown"
msgid "　ただ、"
msgstr "  But..."

#. Occurrence 6_9:2347:8543: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0008; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:2347
msgctxt "text_id=8543 | speaker=soujuurou"
msgid "『だから、どこにいても危ない事に変わりはないんだ。"
msgstr "\"That's why no matter where I go I'm always in danger."

#. Occurrence 6_9:2353:8544: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0009; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:2353
msgctxt "text_id=8544 | speaker=soujuurou"
msgid "　極端な話、道を歩くだけでも、人と話すだけでも不安になる。俺は、どこでだろうと上手くやっていける保証はないんだよ。"
msgstr "  It may be an exaggeration, but even walking down the street, or talking to someone makes me anxious. No matter where I am, there's no guarantee I'll make it out."

#. Occurrence 6_9:2359:8545: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_6_9_0010; voice_prefix=A30; voice_category=3; scene=6_9
#: 6_9:2359
msgctxt "text_id=8545 | speaker=soujuurou"
msgid "　けど、ここにはそんなヤツに気を遣ってくれる人がいる。気遣ってくれる理由は物騒なものっぽいけど、それは本当に、贅沢なコトだと思うんだ』"
msgstr "  But here, there's someone that might show concern for a person like me. Sure, my reasoning is a little messed up, but I've never known such luxury.\""

#. Occurrence 6_9:2416:8546: scene=6_9
#: 6_9:2416
msgctxt "text_id=8546 | speaker=unknown"
msgid "　……少女の瞳がわずかに曇る。"
msgstr "  Her eyes welled up ever so slightly."

#. Occurrence 6_9:2421:8547: scene=6_9
#: 6_9:2421
msgctxt "text_id=8547 | speaker=unknown"
msgid "　静かにこぼれたあの言葉は、無視できるものではなかった。"
msgstr "  Those soft words were something she could not brush off,"

#. Occurrence 6_9:2426:8548: scene=6_9
#: 6_9:2426
msgctxt "text_id=8548 | speaker=unknown"
msgid "　だって、きちんと筋が通っている。"
msgstr "  because they made sense to her."

#. Occurrence 6_9:2431:8549: scene=6_9
#: 6_9:2431
msgctxt "text_id=8549 | speaker=unknown"
msgid "　彼にとって都会はどこであろうと危険なら、この洋館ですら“何も”変わらないのだ。"
msgstr "  Given that everything in the city was a danger to him, nothing had changed after coming to the mansion."

#. Occurrence 6_9:2451:8550: scene=6_9
#: 6_9:2451
msgctxt "text_id=8550 | speaker=unknown"
msgid "　本当に、この洋館を恐れるだけの理由がない。"
msgstr "  In reality, he had no reason to fear this place in particular;"

#. Occurrence 6_9:2456:8551: scene=6_9
#: 6_9:2456
msgctxt "text_id=8551 | speaker=unknown"
msgid "　外との違いがあるとしたら、それは味方になってくれる誰かがいるかいないかという点だけ。"
msgstr "  if anything was different from the outside, it would be that someone here was his ally."

#. Occurrence 6_9:2476:8552: scene=6_9
#: 6_9:2476
msgctxt "text_id=8552 | speaker=unknown"
msgid "　その説でいけば、彼は何ひとつ嘘を言っていない。"
msgstr "  With that view, he had been entirely sincere."

#. Occurrence 6_9:2483:8553: scene=6_9
#: 6_9:2483
msgctxt "text_id=8553 | speaker=unknown"
msgid "　久遠寺有珠へのご機嫌とりでもなく、"
msgstr "  His explanation hadn't contained any flattery towards Alice Kuonji,"

msgctxt "text_id=8554 | speaker=unknown"
msgid "　蒼崎青子に頼ろうとしたのでもなく。"
msgstr "  mor pandering to Aoko Aozaki."

#. Occurrence 6_9:2491:8555: scene=6_9
#: 6_9:2491
msgctxt "text_id=8555 | speaker=unknown"
msgid "　心から、『ここがいい』と告げたのだ。"
msgstr "  He was simply speaking from the heart: \"I like it here.\""

#. Occurrence 6_9:2540:8556: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0017; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:2540
msgctxt "text_id=8556 | speaker=alice"
msgid "「……いま、鏡に迷いこまれるのは迷惑ね。"
msgstr "\"Perhaps having him wander into the mirror is more trouble than it's worth right now."

#. Occurrence 6_9:2546:8557: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0018; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:2546
msgctxt "text_id=8557 | speaker=alice"
msgid "　鏡の機能は侵入者の探索に専念させたいし、彼が迷いこみそうになったら止めてあげて」"
msgstr "  I want to dedicate the mirror's function to searching for intruders, so if it looks like he's going to be swallowed up by it, do stop him, will you?\""

#. Occurrence 6_9:2558:8558: scene=6_9
#: 6_9:2558
msgctxt "text_id=8558 | speaker=unknown"
msgid "　予想外の言葉に小鳥の羽が震える。"
msgstr "  The bird shook its feathers at her strange instruction."

#. Occurrence 6_9:2599:8559: scene=6_9
#: 6_9:2599
msgctxt "text_id=8559 | speaker=unknown"
msgid "　少女は鏡から視線を逸らして歩きだした。"
msgstr "  Alice looked away from the mirror and continued her walk."

#. Occurrence 6_9:2646:8560: scene=6_9
#: 6_9:2646
msgctxt "text_id=8560 | speaker=unknown"
msgid "　抗議の<鳴|こえ>をあげる小鳥。"
msgstr "  The bird chirped in protest."

#. Occurrence 6_9:2652:8561: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_6_9_0019; voice_prefix=A40; voice_category=2; scene=6_9
#: 6_9:2652
msgctxt "text_id=8561 | speaker=alice"
msgid "「貴方の仕事よロビン。それぐらいの役には立って」"
msgstr "\"It is your job, Robin. At least get that right, would you?\""

#. Occurrence 6_9:2659:8562: scene=6_9
#: 6_9:2659
msgctxt "text_id=8562 | speaker=unknown"
msgid "　それに冷たい言葉を返して、少女は西館に消えていった。"
msgstr "  Leaving the bird with that icy retort, she vanished into the west wing."

#. Occurrence 6_9:2723:8563: scene=6_9
#: 6_9:2723
msgctxt "text_id=8563 | speaker=unknown"
msgid "　後に残されたのは月の明かりと、"
msgstr "  All that remained was the moonlight,"

#. Occurrence 6_9:2743:8564: scene=6_9
#: 6_9:2743
msgctxt "text_id=8564 | speaker=unknown"
msgid "　かつてない変化の予兆に激震する、青い小鳥だけだった。"
msgstr "  and the little blue bird, trembling at an perilous prospect of unprecedented change."

#. Occurrence 7_1:78:8565: scene=7_1
#: 7_1:78
msgctxt "text_id=8565 | speaker=unknown"
msgid "　　　　　　むかし、うつくしい鳥を見た。"
msgstr "            Once, long ago, I saw a beautiful bird fly overhead."

#. Occurrence 7_1:98:8566: scene=7_1
#: 7_1:98
msgctxt "text_id=8566 | speaker=unknown"
msgid "　はるかな青い空を、ぐるぐると、回るように飛んでいる。"
msgstr "  Round and round, it circled the distant blue sky."

#. Occurrence 7_1:166:8567: scene=7_1
#: 7_1:166
msgctxt "text_id=8567 | speaker=unknown"
msgid "　もう鳥たちの時代も終わって、"
msgstr "  How high it flew in this era when humans,"

#. Occurrence 7_1:171:8568: scene=7_1
#: 7_1:171
msgctxt "text_id=8568 | speaker=unknown"
msgid "　とっくに人間の時代になっているのに。"
msgstr "  not birds, reigned supreme."

#. Occurrence 7_1:177:8569: scene=7_1
#: 7_1:177
msgctxt "text_id=8569 | speaker=unknown"
msgid "　あの鳥は地上で増え続けるわたしたちのことも、"
msgstr "  And yet the bird was completely uninterested"

#. Occurrence 7_1:182:8570: scene=7_1
#: 7_1:182
msgctxt "text_id=8570 | speaker=unknown"
msgid "　より高さを増していくわたしたちの家にも、"
msgstr "  in humanity's endless desire for expansion,"

#. Occurrence 7_1:187:8571: scene=7_1
#: 7_1:187
msgctxt "text_id=8571 | speaker=unknown"
msgid "　工場の煙突から<煤|すす>をまき散らすわたしたちの文明にも、"
msgstr "  our creation of even higher homes,"

#. Occurrence 7_1:192:8572: scene=7_1
#: 7_1:192
msgctxt "text_id=8572 | speaker=unknown"
msgid "　まるで関心がないようだった。"
msgstr "  or the smoke bellowing from industry's chimneys."

#. Occurrence 7_1:252:8573: scene=7_1
#: 7_1:252
msgctxt "text_id=8573 | speaker=unknown"
msgid "　いつまでも、いつまでも。"
msgstr "  The sky extends further than the eye can see."

#. Occurrence 7_1:258:8574: scene=7_1
#: 7_1:258
msgctxt "text_id=8574 | speaker=unknown"
msgid "　大空はもう誰のものでもないのに。"
msgstr "  It belongs to no one, not now, not then."

#. Occurrence 7_1:263:8575: scene=7_1
#: 7_1:263
msgctxt "text_id=8575 | speaker=unknown"
msgid "　鳥は<気高|けだか>く。"
msgstr "  The bird was a truly noble creature."

#. Occurrence 7_1:268:8576: scene=7_1
#: 7_1:268
msgctxt "text_id=8576 | speaker=unknown"
msgid "　古い野生の空のまま、力強く羽ばたいていた。"
msgstr "  Flapping its wings powerfully across the wild, ancient sky."

#. Occurrence 7_1:326:8577: scene=7_1
#: 7_1:326
msgctxt "text_id=8577 | speaker=unknown"
msgid "　……けれど、鉄の音は響いて。"
msgstr "  Until... The sudden sound of cold iron."

#. Occurrence 7_1:331:8578: scene=7_1
#: 7_1:331
msgctxt "text_id=8578 | speaker=unknown"
msgid "　羽は撃たれて、シンメトリは失われ。"
msgstr "  A wing is shot, its symmetry gone forever."

#. Occurrence 7_1:336:8579: scene=7_1
#: 7_1:336
msgctxt "text_id=8579 | speaker=unknown"
msgid "　地に落ちた姿はずるずると無惨に映り。"
msgstr "  Cruel and tragic, its body plummets downwards."

#. Occurrence 7_1:389:8580: scene=7_1
#: 7_1:389
msgctxt "text_id=8580 | speaker=unknown"
msgid "　ああ―――それでも彼は、最後まで鳥として羽ばたいて。"
msgstr "  Not knowing its fate, the bird frantically beats its wings till the very end."

#. Occurrence 7_1:395:8581: scene=7_1
#: 7_1:395
msgctxt "text_id=8581 | speaker=unknown"
msgid "　わずかに風をきって、瞳を<北|ソラ>に向けたまま、乾いた地面に墜落した。"
msgstr "  One moment soaring with eyes to the sky, the next crashing down to the dry, hardened earth."

#. Occurrence 7_1:435:8582: scene=7_1
#: 7_1:435
msgctxt "text_id=8582 | speaker=unknown"
msgid "　……そんな光景を、今になって夢に見た。"
msgstr "  ...This was the dream I saw."

#. Occurrence 7_1:440:8583: scene=7_1
#: 7_1:440
msgctxt "text_id=8583 | speaker=unknown"
msgid "　あんなにも心に残ったのに、どうしてか、よく覚えていない。"
msgstr "  No matter how much I thought about it, its details remained clouded."

#. Occurrence 7_1:465:8584: scene=7_1
#: 7_1:465
msgctxt "text_id=8584 | speaker=unknown"
msgid "　あの鳥は―――どんなカタチをしていただろう？"
msgstr "  What did that bird look like, for instance?"

#. Occurrence 7_1:528:8585: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0000; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:528
msgctxt "text_id=8585 | speaker=yamashiro"
msgid "「はい、今日の授業はここまで。"
msgstr "\"All right, class dismissed!"

#. Occurrence 7_1:550:8586: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0001; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:550
msgctxt "text_id=8586 | speaker=yamashiro"
msgid "　試験範囲の総まとめなんかやっちゃいましたけど、これ、うちのクラスだけですから。よそのクラスには内密にお願いしますね。担任特権と思ってください。"
msgstr "  That's everything that will be on the test. Please don't share it with the other classes. You're the only ones I'm telling-think of it as a homeroom bonus."

#. Occurrence 7_1:558:8587: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0002; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:558
msgctxt "text_id=8587 | speaker=yamashiro"
msgid "　ほら、現国の平均点ぐらいは学年一番にしておくと、皆さんも鼻が高いと思いまして」"
msgstr "  Remember, if this class gets the highest scores you can brag about it to all the other classes!\""

#. Occurrence 7_1:583:8588: scene=7_1
#: 7_1:583
msgctxt "text_id=8588 | speaker=unknown"
msgid "　ははは、と穏和な笑顔で語りかける山城教諭。"
msgstr "  Mr. Yamasiro chuckled as he finished."

#. Occurrence 7_1:588:8589: scene=7_1
#: 7_1:588
msgctxt "text_id=8589 | speaker=unknown"
msgid "　２－Ｃの担任らしい、心温まる気遣いに教室中が和むのであった。"
msgstr "  This was typical of the kind teacher responsible for Year 2 Class C, the master at relaxing his pupils."

#. Occurrence 7_1:610:8590: voice_id=D90_7_1_0000; voice_prefix=D90; voice_category=0; scene=7_1
#: 7_1:610
msgctxt "text_id=8590 | speaker=unknown"
msgid "「せんせい、口元に本音出てるー。鼻を高くしたいのはあたしたちじゃないですよねー」"
msgstr "\"I think you've got that backward, Mr. Yamasiro. You're the one who's after bragging rights!\""

#. Occurrence 7_1:621:8591: voice_id=E20_7_1_9000; voice_prefix=E20; voice_category=0; scene=7_1
#: 7_1:621
msgctxt "text_id=8591 | speaker=unknown"
msgid "「鼻っていうか面子ですよねー。センセ、里中先生に嫌味言われてばっかりだしー」"
msgstr "\"Yeah, then he can finally get Mr. Satonaka off his back. We know he's been making fun of you all semester for our bad grades, sir.\""

#. Occurrence 7_1:627:8592: voice_id=E30_7_1_0000; voice_prefix=E30; voice_category=0; scene=7_1
#: 7_1:627
msgctxt "text_id=8592 | speaker=unknown"
msgid "「つーかハッキリ言えばいいんすよ、オマエらあたま悪すぎだってー。いやあまあ、うちのクラス見事なまでに体育会系ばっかりだけどさー！」"
msgstr "\"Err, duuh! We're like, total washouts, except for our totally excellent sports skills!\""

#. Occurrence 7_1:661:8593: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0003; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:661
msgctxt "text_id=8593 | speaker=yamashiro"
msgid "「いえいえ。テストの点数だけが学生生活ではありませんから、僕から言うべきコトは何も。"
msgstr "\"Please, though it might not mean much coming from me, high school is about more than just your test scores."

#. Occurrence 7_1:667:8594: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0004; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:667
msgctxt "text_id=8594 | speaker=yamashiro"
msgid "　先生方もそこまで目くじらたててるワケじゃないので、別にクラス全員が赤点でも僕の人生には何ら関わりはないんですけどねー。"
msgstr "  Teachers don't really care that much about your grades, you know. Even if you all fail, it's not like anything bad will happen to us."

#. Occurrence 7_1:673:8595: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0005; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:673
msgctxt "text_id=8595 | speaker=yamashiro"
msgid "　しかし一方ではひとり、厄介な御仁がおりまして」"
msgstr "  But there is one student who does bother me...\""

#. Occurrence 7_1:703:8596: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0006; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:703
msgctxt "text_id=8596 | speaker=yamashiro"
msgid "「皆さんが選んだ全校生徒代表の方なんですが、これが恐ろしいのなんの。"
msgstr "\"I think you know who I'm talking about-you chose her to represent the entire student body, a monumentally awful decision."

#. Occurrence 7_1:709:8597: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0007; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:709
msgctxt "text_id=8597 | speaker=yamashiro"
msgid "“テストの点数が低いのは生徒ではなく教育する側が無能だからです。教育委員会への報告準備はいつでも出来ていますので”と日夜<脅|おど>してくるんですよ。"
msgstr "  She makes a daily point to threaten to report me to the Board of Education, claiming my students' grades are the result of poor instruction rather than lack of studying."

#. Occurrence 7_1:720:8598: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0008; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:720
msgctxt "text_id=8598 | speaker=yamashiro"
msgid "　それでも生徒たちが直らないようなら、その時は直接私が監督します、とか。生徒としてどうなんですかね、アレ」"
msgstr "  She said if students' scores don't improve, she'd come supervise my classes herself. What kind of student even says such a thing?!\""

#. Occurrence 7_1:758:8599: voice_id=D80_7_1_0000; voice_prefix=D80; voice_category=0; scene=7_1
#: 7_1:758
msgctxt "text_id=8599 | speaker=unknown"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 7_1:764:8600: scene=7_1
#: 7_1:764
msgctxt "text_id=8600 | speaker=unknown"
msgid "　<和気藹々|わきあいあい>としていた空気が、一瞬にして氷点下まで落ちこんでいく。"
msgstr "  The warm atmosphere in the room suddenly fell below freezing."

#. Occurrence 7_1:770:8601: scene=7_1
#: 7_1:770
msgctxt "text_id=8601 | speaker=unknown"
msgid "　２－Ｃ組の生徒たちも、誰が本当の敵なのかなんとなく悟ったようだ。"
msgstr "  The students of Class C now knew who their true enemy was."

#. Occurrence 7_1:800:8602: voice_id=E20_7_1_9001; voice_prefix=E20; voice_category=0; scene=7_1
#: 7_1:800
msgctxt "text_id=8602 | speaker=unknown"
msgid "「あー……そっか、山城センセ生徒会の顧問だったっけ……南無南無」"
msgstr "\"Right... I forgot Mr. Yamasiro was the student body advisor.\""

#. Occurrence 7_1:806:8603: voice_id=E30_7_1_0001; voice_prefix=E30; voice_category=0; scene=7_1
#: 7_1:806
msgctxt "text_id=8603 | speaker=unknown"
msgid "「さすがは応援団を立ち直らせた女傑。教師一人退職に追いこむなど造作もねぇ……」"
msgstr "\"The student president managed to revive the cheer squad, so I wouldn't be surprised if she can force a teacher out of their job, too.\""

#. Occurrence 7_1:846:8604: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0000; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:846
msgctxt "text_id=8604 | speaker=kinomi"
msgid "「やっぱりなあ。会長、ぜったい歳サバ読んでるって。"
msgstr "\"Yeah. I heard the she can guess teachers' ages with 100% accuracy."

#. Occurrence 7_1:846:8605: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0000; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:846
msgctxt "text_id=8605 | speaker=kinomi"
msgid "　あの迫力、同年代と思えねーし！"
msgstr "  I can't believe she's the same age as us!"

#. Occurrence 7_1:854:8606: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0001; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:854
msgctxt "text_id=8606 | speaker=kinomi"
msgid "　"
msgstr "  "

msgctxt "text_id=8607 | speaker=unknown"
msgid "ほら、うちの女子と比べると特に。こう、おっぱい的に」"
msgstr "I mean, look at her compared to the girls in our class. Her boobs are way bigger!\""

#. Occurrence 7_1:880:8608: voice_id=D90_7_1_0002; voice_prefix=D90; voice_category=0; scene=7_1
#: 7_1:880
msgctxt "text_id=8608 | speaker=unknown"
msgid "「せんせー、木乃美だけでもＡ組に引き取ってもらえませんかー。そりゃ男子はみんなサルですけど、コイツだけレベルの違うサルですよ絶対！」"
msgstr "\"Oh my god, please get Kinomi moved to Class A, sir! It's hard enough with a class full of apes, but he's such a pig!\""

#. Occurrence 7_1:901:8609: voice_id=E30_7_1_0002; voice_prefix=E30; voice_category=0; scene=7_1
#: 7_1:901
msgctxt "text_id=8609 | speaker=unknown"
msgid "「あれ。でも女史、Ａ組だけどあんまり成績よくねえよな？　中の上ぐらいじゃなかったっけ？」"
msgstr "\"But y'know, that girl doesn't even get the grades for a Class A member. Kinda middle of the pack, right?\""

#. Occurrence 7_1:907:8610: voice_id=E20_7_1_0000; voice_prefix=E20; voice_category=0; scene=7_1
#: 7_1:907
msgctxt "text_id=8610 | speaker=unknown"
msgid "「そうだけど、別にいいんじゃない？　塾もいってないし、生徒会しきって、たまにバイトまでしてるんだから。あれで学年トップだったら逆に気持ち悪すぎ」"
msgstr "\"That's the point, dumbass. She doesn't need to go to cram school, she's on the student council, and sometimes does a job or two. It'd be heinous if she got awesome grades too.\""

#. Occurrence 7_1:913:8611: voice_id=E40_7_1_0000; voice_prefix=E40; voice_category=0; scene=7_1
#: 7_1:913
msgctxt "text_id=8611 | speaker=unknown"
msgid "「だよなー。首位は副会長に任せとけばいいんだよー」"
msgstr "\"Totally... We should leave the good grades to the vice-president.\""

#. Occurrence 7_1:943:8612: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0009; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:943
msgctxt "text_id=8612 | speaker=yamashiro"
msgid "「はっはっは。まあまあ皆さん、うわさ話はそのあたりで。地獄耳という言葉もありますから。"
msgstr "\"Hahaha. All right, that's enough gossiping, everyone. It's not nice to talk about people behind their backs."

#. Occurrence 7_1:949:8613: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0010; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:949
msgctxt "text_id=8613 | speaker=yamashiro"
msgid "　じゃ、それなりに復習をよろしく。あんまり点数が悪いと冬休みそのものがなくなりますからねぇ。"
msgstr "  In any case, good luck with your studies. Remember, if your grades don't improve then winter vacation gets canceled!"

#. Occurrence 7_1:960:8614: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0011; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:960
msgctxt "text_id=8614 | speaker=yamashiro"
msgid "　あ、それと静希君、ちょっといいですか？」"
msgstr "  Oh, and Sizuki, could I have a word before you go?\""

#. Occurrence 7_1:999:8615: scene=7_1
#: 7_1:999
msgctxt "text_id=8615 | speaker=unknown"
msgid "　山城教諭は教材をまとめると、草十郎に手招きをしながら廊下に出て行った。"
msgstr "  Mr. Yamasiro gathered his things and beckoned for Soujyuro to join him in the hallway."

#. Occurrence 7_1:1048:8616: scene=7_1
#: 7_1:1048
msgctxt "text_id=8616 | speaker=unknown"
msgid "　休み時間だというのに、廊下に生徒の姿は見られない。"
msgstr "  There were no other students to be seen despite it being break time between classes."

#. Occurrence 7_1:1053:8617: scene=7_1
#: 7_1:1053
msgctxt "text_id=8617 | speaker=unknown"
msgid "　生徒たちの騒ぎ声は聞こえるものの、廊下はひっそりと落ち着いている。"
msgstr "  Voices were audible in the distance, but the hall itself felt strangely quiet and calm."

#. Occurrence 7_1:1058:8618: scene=7_1
#: 7_1:1058
msgctxt "text_id=8618 | speaker=unknown"
msgid "　窓のない廊下は閉塞感があるためだろう。"
msgstr "  Perhaps it was due to the sense of confinement created by the lack of windows."

#. Occurrence 7_1:1063:8619: scene=7_1
#: 7_1:1063
msgctxt "text_id=8619 | speaker=unknown"
msgid "　生徒たちにとって休み時間の憩いの場は教室内か、そのベランダになっていた。"
msgstr "  Usually students spent their breaks either in their classrooms or on the veranda."

#. Occurrence 7_1:1084:8620: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0000; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1084
msgctxt "text_id=8620 | speaker=soujuurou"
msgid "「なんですか、山城先生？」"
msgstr "\"What is it, sir?\""

#. Occurrence 7_1:1107:8621: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0012; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:1107
msgctxt "text_id=8621 | speaker=yamashiro"
msgid "「いえ、そう大した用事じゃないんですけどね。"
msgstr "\"Oh, nothing major."

#. Occurrence 7_1:1113:8622: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0013; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:1113
msgctxt "text_id=8622 | speaker=yamashiro"
msgid "　試験前にこんな話をするのもデリカシーがないんですが、気になったので。どうだろう、学校には慣れたかな？」"
msgstr "  Sorry to bring this up right before exams, but I've been meaning to ask: how's everything going with school? You settling in all right?\""

#. Occurrence 7_1:1138:8623: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0001; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1138
msgctxt "text_id=8623 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 7_1:1172:8624: scene=7_1
#: 7_1:1172
msgctxt "text_id=8624 | speaker=unknown"
msgid "　担任の気遣いに驚きつつも、なんとなく嬉しくなる草十郎だった。"
msgstr "  Though this level of concern from a teacher startled him, Soujyuro felt reassured."

#. Occurrence 7_1:1177:8625: scene=7_1
#: 7_1:1177
msgctxt "text_id=8625 | speaker=unknown"
msgid "　さもありなん。"
msgstr "  It was only natural."

#. Occurrence 7_1:1183:8626: scene=7_1
#: 7_1:1183
msgctxt "text_id=8626 | speaker=unknown"
msgid "ここのところ不条理な人間に振り回されてばかりだったので、<些細|ささい>な<心配|こころくば>りでもぐっっと励まされるのだ。"
msgstr "After having had to deal with such difficult personalities lately, Mr. Yamasiro's trivial questions were refreshing."

#. Occurrence 7_1:1221:8627: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0002; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1221
msgctxt "text_id=8627 | speaker=soujuurou"
msgid "「はい。学校の造りや決まりなら、自分なりに分かってきました。友達も増えましたし」"
msgstr "\"Yes. I think I understand the basics of school life for now. And I've made friends, too.\""

#. Occurrence 7_1:1227:8628: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0014; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:1227
msgctxt "text_id=8628 | speaker=yamashiro"
msgid "「そっか、それは良かった。うちのクラスは口の悪い面々だけど、その分気を遣わなくていいからね。静希君と相性がよくて助かったよ」"
msgstr "\"Good, glad to hear it. Students in my class tend to mouth off, so don't take them too seriously. I'm glad you're able to fit in.\""

#. Occurrence 7_1:1262:8629: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0003; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1262
msgctxt "text_id=8629 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 7_1:1267:8630: scene=7_1
#: 7_1:1267
msgctxt "text_id=8630 | speaker=unknown"
msgid "　おお、と草十郎は目を輝かせる。"
msgstr "  Soujyuro's eyes shone brightly in appreciation."

#. Occurrence 7_1:1272:8631: scene=7_1
#: 7_1:1272
msgctxt "text_id=8631 | speaker=unknown"
msgid "　蒼崎青子に『憎むべき<昼行灯|ひるあんどん>、教師にあるまじきのれんに腕押し野郎』と酷評される山城教諭だが、彼は彼なりに気配りの人なのだった。"
msgstr "  In Aoko's words, Mr. Yamasiro was a brutish, forgettable, downright detestable man who did not even deserve the title of teacher. But Soujyuro found him considerate in his own way."

#. Occurrence 7_1:1310:8632: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0015; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:1310
msgctxt "text_id=8632 | speaker=yamashiro"
msgid "「アルバイトもほどほどにね。試験前だって言えばたいていのところは休ませてくれるから、あまり無理はしないように。"
msgstr "\"Take it easy with your part-time jobs. We give students a lot of time off before exams, but don't push yourself too hard."

#. Occurrence 7_1:1316:8633: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_1_0016; voice_prefix=B60; voice_category=7; scene=7_1
#: 7_1:1316
msgctxt "text_id=8633 | speaker=yamashiro"
msgid "　また、試験で困ったコトがあったら周りに相談しなさい。ひとりで悩んでいても時間の無駄だよ。ほら、学校っていうのは話し相手にだけは困らないから」"
msgstr "  And if you have trouble with exams just ask the other students for help. There's no need to suffer in silence. If this school has anything it's plenty of people to talk to.\""

#. Occurrence 7_1:1355:8634: scene=7_1
#: 7_1:1355
msgctxt "text_id=8634 | speaker=unknown"
msgid "　それじゃあ、と手を挙げて山城教諭は去っていった。"
msgstr "  With a wave of his hand Mr. Yamasiro was gone."

#. Occurrence 7_1:1367:8635: scene=7_1
#: 7_1:1367
msgctxt "text_id=8635 | speaker=unknown"
msgid "　純朴な少年は昼行灯な忠告をまっすぐに受けとめ、なるほど、と頷きながら教室に引き返す。"
msgstr "  The pure-hearted Soujyuro gave him a solemn nod as if to say he accepted the advice of his so-called forgettable teacher, and went back into his classroom."

#. Occurrence 7_1:1427:8636: scene=7_1
#: 7_1:1427
msgctxt "text_id=8636 | speaker=unknown"
msgid "　そうして、"
msgstr "  And then..."

#. Occurrence 7_1:1444:8637: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0002; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:1444
msgctxt "text_id=8637 | speaker=kinomi"
msgid "「ちょっ、女のコトで相談だあ！？」"
msgstr "\"Come again? You want my advice about girls?!\""

#. Occurrence 7_1:1451:8638: scene=7_1
#: 7_1:1451
msgctxt "text_id=8638 | speaker=unknown"
msgid "　一分も待たず、山城教諭から受けたアドバイスを実行した。"
msgstr "  Soujyuro had not wasted a moment in putting Mr. Yamasiro's advice into practice."

#. Occurrence 7_1:1485:8639: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0004; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1485
msgctxt "text_id=8639 | speaker=soujuurou"
msgid "「そうらしい。難問にぶち当たっているんだ。"
msgstr "\"Yeah... It's like I've hit a wall with them."

#. Occurrence 7_1:1492:8640: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0005; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1492
msgctxt "text_id=8640 | speaker=soujuurou"
msgid "深く考えてみて気付いたんだが、どうも、自分は発想が貧困らしい」"
msgstr "I thought about it and thought about it, but I realized that I'm no good at figuring them out.\""

#. Occurrence 7_1:1503:8641: scene=7_1
#: 7_1:1503
msgctxt "text_id=8641 | speaker=unknown"
msgid "　いまじねーしょんがよわいのだ、と無念そうに目を伏せる草十郎。"
msgstr "  Soujyuro averted his eyes out of shame over his lack of insight."

#. Occurrence 7_1:1524:8642: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0003; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:1524
msgctxt "text_id=8642 | speaker=kinomi"
msgid "「いや、豊かだと思ってたコトがビックリなんだけど……まあいい、こっちこい」"
msgstr "\"You coulda fooled me. I thought you were man with the ladies! Well, you came to the right guy. Follow me.\""

#. Occurrence 7_1:1580:8643: scene=7_1
#: 7_1:1580
msgctxt "text_id=8643 | speaker=unknown"
msgid "　木乃美は呆れながらも草十郎の肩をつかみ、教室の<端|はし>に移動した。"
msgstr "  Shocked as he was, Kinomi grabbed Soujyuro by the shoulder and pulled him over to the wall."

#. Occurrence 7_1:1585:8644: scene=7_1
#: 7_1:1585
msgctxt "text_id=8644 | speaker=unknown"
msgid "　真顔で「女の子は難しいと訊く」と切り出された時は吹きそうになった木乃美だが、考えてみると草十郎が自分から相談ごとにくるのは初めてだ。"
msgstr "  Kinomi had nearly burst out laughing when Soujyuro, with a straight face, had admitted his difficulty with girls. But, he realized it was the first time Soujyuro had ever turned to him for advice."

#. Occurrence 7_1:1636:8645: scene=7_1
#: 7_1:1636
msgctxt "text_id=8645 | speaker=unknown"
msgid "　バイト先でもたいていのものは辛抱強くこなしてしまうこの男が悩んでいるのだ。"
msgstr "  Soujyuro was always able to break down any task at his part-time jobs into bite-size pieces, but he was clearly struggling with a different problem now."

#. Occurrence 7_1:1641:8646: scene=7_1
#: 7_1:1641
msgctxt "text_id=8646 | speaker=unknown"
msgid "　これは、よっぽどのコトとかからねばなるまい。"
msgstr "  This was going to take some serious effort."

#. Occurrence 7_1:1667:8647: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0004; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:1667
msgctxt "text_id=8647 | speaker=kinomi"
msgid "「で。なんかやっちまったのか、ｙｏｕ」"
msgstr "\"Okay. Give it to me straight, pal. How big did you screw up?\""

#. Occurrence 7_1:1678:8648: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0006; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1678
msgctxt "text_id=8648 | speaker=soujuurou"
msgid "「……。これから、やるのかもしれない」"
msgstr "\"I didn't screw up yet... but it might happen soon.\""

#. Occurrence 7_1:1723:8649: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0007; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1723
msgctxt "text_id=8649 | speaker=soujuurou"
msgid "「木乃美。たとえばの話、まっどべあにハリセンボンみたいな女の子が入ってきたとする。"
msgstr "\"Let's say a girl walked into The Mad Bear who's as prickly as a porcupine."

#. Occurrence 7_1:1730:8650: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0008; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1730
msgctxt "text_id=8650 | speaker=soujuurou"
msgid "その子は俺が嫌いで、まっどべあから出ていってほしいようなんだけど、俺はまっどべあを辞めるワケにはいかない」"
msgstr "She doesn't like me and wants me to leave, but I don't want to.\""

#. Occurrence 7_1:1755:8651: scene=7_1
#: 7_1:1755
msgctxt "text_id=8651 | speaker=unknown"
msgid "　なによりお金のために、と草十郎は熱弁する。"
msgstr "  Soujyuro explained that he couldn't just quit his part-time job at the restaurant-he needed the money."

#. Occurrence 7_1:1770:8652: scene=7_1
#: 7_1:1770
msgctxt "text_id=8652 | speaker=unknown"
msgid "　とりあえず頷くしかない木乃美だった。"
msgstr "  Kinomi grunted a few times to indicate he was still following Soujyuro's story."

#. Occurrence 7_1:1810:8653: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0005; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:1810
msgctxt "text_id=8653 | speaker=kinomi"
msgid "「……つまり、その女を追い出したいと？」"
msgstr "\"So, like, you want the girl to split?\""

#. Occurrence 7_1:1834:8654: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0009; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1834
msgctxt "text_id=8654 | speaker=soujuurou"
msgid "「逆だ。なんとか認めてもらいたい。"
msgstr "\"No, no. I want her to be okay with me working there."

#. Occurrence 7_1:1840:8655: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0010; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1840
msgctxt "text_id=8655 | speaker=soujuurou"
msgid "　隠していたけど、俺はその女の子が嫌いというワケじゃなくて……」"
msgstr "  Because the thing is... I sort of... don't not like her.\""

#. Occurrence 7_1:1865:8656: scene=7_1
#: 7_1:1865
msgctxt "text_id=8656 | speaker=unknown"
msgid "　草十郎はむう、と眉間に<皺|しわ>を寄せる。"
msgstr "  Soujyuro furrowed his brow."

#. Occurrence 7_1:1870:8657: scene=7_1
#: 7_1:1870
msgctxt "text_id=8657 | speaker=unknown"
msgid "　この男らしからぬ歯切れの悪さに、木乃美はははあんと事情を察した。"
msgstr "  Kinomi could not help but laugh at his friend's lack of manly resolve in his answer."

#. Occurrence 7_1:1893:8658: scene=7_1
#: 7_1:1893
msgctxt "text_id=8658 | speaker=unknown"
msgid "　こと女性関係においてのみ、木乃美芳助の巡りの良さは三倍以上になるのである。"
msgstr "  Girls were the one area where Housuke's skills and experience were triple those of Soujyuro."

#. Occurrence 7_1:1920:8659: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0006; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:1920
msgctxt "text_id=8659 | speaker=kinomi"
msgid "「―――ははあん。はっはっーん。"
msgstr "\"A-ha. Now I see."

#. Occurrence 7_1:1926:8660: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0007; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:1926
msgctxt "text_id=8660 | speaker=kinomi"
msgid "　なんだよ、ようはナンパかよ。むしろ仲良くなりたいってワケ？」"
msgstr "  That's just the art of flirting, man. You want to get along with her, right?\""

#. Occurrence 7_1:1958:8661: scene=7_1
#: 7_1:1958
msgctxt "text_id=8661 | speaker=unknown"
msgid "　木乃美の指摘に、む？　と思案する草十郎。"
msgstr "  Soujyuro wasn't sure how to respond."

#. Occurrence 7_1:1968:8662: scene=7_1
#: 7_1:1968
msgctxt "text_id=8662 | speaker=unknown"
msgid "　彼本人、それがどういうコトなのかよく分からないまま、こくんと頷いた。"
msgstr "  He nodded slowly without really understanding the implication of what Kinomi had said."

#. Occurrence 7_1:1995:8663: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0011; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:1995
msgctxt "text_id=8663 | speaker=soujuurou"
msgid "「けど、どうすればいいのか分からない。そもそもどうやって、同い年の女の子と仲良く話ができるんだ？」"
msgstr "\"But I don't know what to do. How can I get along with girls my age?\""

#. Occurrence 7_1:2006:8664: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0008; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2006
msgctxt "text_id=8664 | speaker=kinomi"
msgid "「クラスの女どもとは話してんじゃん。あれでいいんだっつの、オレは羨ましいっつの。"
msgstr "\"You talk to girls in our class all the time! Honestly, you make all the other guys look bad, you're a natural at it."

#. Occurrence 7_1:2017:8665: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0009; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2017
msgctxt "text_id=8665 | speaker=kinomi"
msgid "　持ち前の天然系で押してけばいいべ。"
msgstr "  Just keep being your usual clueless self and I'm sure you'll be fine."

#. Occurrence 7_1:2023:8666: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0010; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2023
msgctxt "text_id=8666 | speaker=kinomi"
msgid "　山育ちってのは稀少なアイデンティティだと思うぜ？　珍しいものは<活|い>かさないとさー」"
msgstr "  Being raised in the mountains makes you Mr. Mysterious. You gotta use that unique identity to your advantage.\""

#. Occurrence 7_1:2050:8667: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0012; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:2050
msgctxt "text_id=8667 | speaker=soujuurou"
msgid "「そうかな。珍しいというのは、あんまりいいコトじゃない気がする。"
msgstr "\"Really? I don't think being unusual is such a good thing, though."

#. Occurrence 7_1:2080:8668: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0013; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:2080
msgctxt "text_id=8668 | speaker=soujuurou"
msgid "　だいたい、そもそも嫌われている場合はどうすればいいんだ？　クラスのみんなは親切だけど、相手はハリセンボンだ。いや、このさいハリネズミでもいい」"
msgstr "  Like, how do you talk to someone who hates your guts? People in class are nice, but I'm dealing with a thorny beast here! O-Or maybe a hedgehog is a better metaphor...\""

#. Occurrence 7_1:2104:8669: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0011; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2104
msgctxt "text_id=8669 | speaker=kinomi"
msgid "「そういう場合はめげなきゃいいんだよ。相手が折れるのを待つって寸法だな。トゲだけに」"
msgstr "\"Don't be a chicken, man. You know what they say, a tiny thorn can stop a lion. She'll come around.\""

#. Occurrence 7_1:2130:8670: scene=7_1
#: 7_1:2130
msgctxt "text_id=8670 | speaker=unknown"
msgid "　むむう、と草十郎の皺はますます深くなる。"
msgstr "  Soujyuro's brow sunk deeper still."

#. Occurrence 7_1:2154:8671: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0014; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:2154
msgctxt "text_id=8671 | speaker=soujuurou"
msgid "「このたとえ話は、ダメだ」"
msgstr "\"All these abstract metaphors are too much for me.\""

#. Occurrence 7_1:2159:8672: scene=7_1
#: 7_1:2159
msgctxt "text_id=8672 | speaker=unknown"
msgid "　などと右往左往するものの、他にうまい喩えが見つからない模様。"
msgstr "  He needed more concrete material to work with."

#. Occurrence 7_1:2207:8673: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0012; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2207
msgctxt "text_id=8673 | speaker=kinomi"
msgid "「ばっか。女なんてのは機嫌を取ってればいいんだよ。"
msgstr "\"Come on, dude. You have to put in the work to get on a girl's good side."

#. Occurrence 7_1:2213:8674: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0013; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2213
msgctxt "text_id=8674 | speaker=kinomi"
msgid "　まずは女の趣味とか、大事にしてるもんとか聞いて、そこをフォローすればいい。自分の都合より相手の都合だ。まずは<外堀|そとぼり>から攻めろってコトだな」"
msgstr "  First ask about her hobbies and stuff she likes, then go from there. Think about what she wants, not what you want. You gotta blitz 'em from where they're weak, as they say.\""

#. Occurrence 7_1:2224:8675: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0015; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:2224
msgctxt "text_id=8675 | speaker=soujuurou"
msgid "「外堀……外回りか」"
msgstr "\"You mean... don't be too direct?\""

#. Occurrence 7_1:2251:8676: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0014; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2251
msgctxt "text_id=8676 | speaker=kinomi"
msgid "「もち。その後は、ま、結局はこれが一番効果的なんだけどな。袖の下ってヤツ？　プレゼントで釣れ。"
msgstr "\"You got it. And then comes the most important part: bribery. You gotta shower her with presents."

#. Occurrence 7_1:2257:8677: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0015; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2257
msgctxt "text_id=8677 | speaker=kinomi"
msgid "　そん時の<需要|じゅよう>と<供給|きょうきゅう>さえ合えば、嫌われてても受け取ってもらえる。受け取らせちまえば、あとはそれが義理になるってもんだ」"
msgstr "  If the supply matches the demand, she'll accept your gift even if she don't like you. Then you've got her, she'll feel like she owes you one.\""

#. Occurrence 7_1:2272:8678: scene=7_1
#: 7_1:2272
msgctxt "text_id=8678 | speaker=unknown"
msgid "　いまのところオレはこれで連戦連敗さ！　と力強く語る友人に、何か間違った頼もしさを覚える草十郎だった。"
msgstr "  Kinomi then proclaimed with an odd sense of pride that this approach had resulted in only failure for him."

#. Occurrence 7_1:2327:8679: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0016; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:2327
msgctxt "text_id=8679 | speaker=soujuurou"
msgid "「―――けど問題がある木乃美。"
msgstr "\"There's just one problem, Kinomi."

#. Occurrence 7_1:2333:8680: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0017; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:2333
msgctxt "text_id=8680 | speaker=soujuurou"
msgid "　たしかにごはんとか、そういうのをおごってもらうと嬉しい。けど」"
msgstr "  I get that girls like being taken out to dinner, but...\""

#. Occurrence 7_1:2360:8681: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0016; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2360
msgctxt "text_id=8681 | speaker=kinomi"
msgid "「そんな<余裕|かね>はないってんだろ。分かってる分かってる。"
msgstr "\"You can't afford it. I know, I know."

#. Occurrence 7_1:2366:8682: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0017; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:2366
msgctxt "text_id=8682 | speaker=kinomi"
msgid "　……ひひひ、仕方ないねぇ。そういう静希君のために、いっちょ割のいいバイトを紹介してやろうじゃねえのよ」"
msgstr "  I got you covered, haha. I'm gonna let you in on a sweet little secret-an easy way to get you some cold hard dough.\""

#. Occurrence 7_1:2378:8683: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0018; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:2378
msgctxt "text_id=8683 | speaker=soujuurou"
msgid "「？」"
msgstr "\"?\""

#. Occurrence 7_1:2430:8684: scene=7_1
#: 7_1:2430
msgctxt "text_id=8684 | speaker=unknown"
msgid "　教室の<端|はし>から、さらに<隅|すみ>へ。"
msgstr "  They slid from the side of the classroom deeper to one corner."

#. Occurrence 7_1:2440:8685: scene=7_1
#: 7_1:2440
msgctxt "text_id=8685 | speaker=unknown"
msgid "　木乃美は人気のないロッカーの前まで草十郎を連れこんだ。"
msgstr "  To in front of the lockers, where no one ever stayed for long."

#. Occurrence 7_1:2445:8686: scene=7_1
#: 7_1:2445
msgctxt "text_id=8686 | speaker=unknown"
msgid "　それが他人には聞かせられない、悪質な勧誘の<類|たぐい>であるコトを草十郎が知るのは、これより何日か後の話である。"
msgstr "  It would be days before Soujyuro realized the suggestion he was receiving was of the illegitimate kind, the kind he should not have shared with anyone."

#. Occurrence 7_1:2496:8687: scene=7_1
#: 7_1:2496
msgctxt "text_id=8687 | speaker=unknown"
msgid "　その夜。"
msgstr "  That night..."

#. Occurrence 7_1:2502:8688: scene=7_1
#: 7_1:2502
msgctxt "text_id=8688 | speaker=unknown"
msgid "　洋館の夕食は、一面のパン尽くしだった。"
msgstr "  Dinner at the mansion was a feast of bread."

#. Occurrence 7_1:2548:8689: scene=7_1
#: 7_1:2548
msgctxt "text_id=8689 | speaker=unknown"
msgid "　テーブルの中央にはカットされたソフトブレッドが積まれ、"
msgstr "  Soft slices lay stacked in the center of the table,"

#. Occurrence 7_1:2554:8690: scene=7_1
#: 7_1:2554
msgctxt "text_id=8690 | speaker=unknown"
msgid "　周りには色とりどりのジャムが置かれ、"
msgstr "  surrounded by variously colored jams."

#. Occurrence 7_1:2559:8691: scene=7_1
#: 7_1:2559
msgctxt "text_id=8691 | speaker=unknown"
msgid "　ボウルにはレタスを中心にしたサラダ、"
msgstr "  In a bowl was salad-mainly lettuce-"

#. Occurrence 7_1:2564:8692: scene=7_1
#: 7_1:2564
msgctxt "text_id=8692 | speaker=unknown"
msgid "　小皿には太さがマチマチなハムが並んでいた。"
msgstr "  with a small plate of unevenly cut ham."

#. Occurrence 7_1:2604:8693: scene=7_1
#: 7_1:2604
msgctxt "text_id=8693 | speaker=unknown"
msgid "　一般家庭の夕食、その平均をまだ知らない草十郎ではあるが、これがおかしな<夕食|もの>であるコトは感じ取れる。"
msgstr "  Soujyuro may have had no frame of reference for what an average family dinner should be, but he could tell that this was most certainly not normal."

#. Occurrence 7_1:2610:8694: scene=7_1
#: 7_1:2610
msgctxt "text_id=8694 | speaker=unknown"
msgid "　率直に言って、手を抜いているコトこの上ない。"
msgstr "  In truth, it was a first-rate case of laziness."

#. Occurrence 7_1:2649:8695: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0000; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:2649
msgctxt "text_id=8695 | speaker=aoko"
msgid "「あ。チョコのペースト切れたままじゃん。"
msgstr "\"Ugh. We're out of chocolate spread."

#. Occurrence 7_1:2655:8696: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0001; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:2655
msgctxt "text_id=8696 | speaker=aoko"
msgid "　有珠、新しいの買っておいてって言わなかった？」"
msgstr "  Didn't I tell you to buy some more, Alice?\""

#. Occurrence 7_1:2674:8697: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0000; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:2674
msgctxt "text_id=8697 | speaker=alice"
msgid "「……今日は一日、部屋に籠もっていたから。"
msgstr "\"I've been locked away in my room all day."

#. Occurrence 7_1:2680:8698: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0001; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:2680
msgctxt "text_id=8698 | speaker=alice"
msgid "　第一、チョコレイトを食べるのは貴女だけよ。自分のものは自分で調達をするべきね」"
msgstr "  And more importantly, you're the only one that eats that stuff, so you should buy it.\""

#. Occurrence 7_1:2718:8699: scene=7_1
#: 7_1:2718
msgctxt "text_id=8699 | speaker=unknown"
msgid "　が、彼女たち的に、この夕食は普通らしい。"
msgstr "  For these two girls, however, this dinner seemed to be completely normal."

#. Occurrence 7_1:2724:8700: scene=7_1
#: 7_1:2724
msgctxt "text_id=8700 | speaker=unknown"
msgid "　食事の準備は変則的な当番制で、今夜は久遠寺有珠のターンだった。"
msgstr "  They had a system of irregularly taking turns being in charge of meals, and tonight was Alice's turn."

#. Occurrence 7_1:2729:8701: scene=7_1
#: 7_1:2729
msgctxt "text_id=8701 | speaker=unknown"
msgid "　有珠にとって食事当番とは、平時は手間暇を最小限に抑える作業であり、祝時のみ腕によりをかけて調理する……ものだった。"
msgstr "  Normally she would spend as little time and effort as possible, only truly applying herself when there was something to celebrate."

#. Occurrence 7_1:2773:8702: scene=7_1
#: 7_1:2773
msgctxt "text_id=8702 | speaker=unknown"
msgid "　無論、そんな有珠の哲学を草十郎が知るよしもない。"
msgstr "  Of course, Soujyuro was none the wiser to Alice's unique approach to food preparation."

#. Occurrence 7_1:2778:8703: scene=7_1
#: 7_1:2778
msgctxt "text_id=8703 | speaker=unknown"
msgid "　草十郎から見ても簡素な食事。"
msgstr "  For him it was a plain, lackluster meal."

#. Occurrence 7_1:2783:8704: scene=7_1
#: 7_1:2783
msgctxt "text_id=8704 | speaker=unknown"
msgid "　加えて、"
msgstr "  And when it came to dinner..."

#. Occurrence 7_1:2837:8705: scene=7_1
#: 7_1:2837
msgctxt "text_id=8705 | speaker=unknown"
msgid "　ふたりの間にはこれといった会話はない。"
msgstr "  Not saying anything to each other was another staple of their meals."

#. Occurrence 7_1:2842:8706: scene=7_1
#: 7_1:2842
msgctxt "text_id=8706 | speaker=unknown"
msgid "　食器の音、椅子ずれの音、時計の音だけが、サンルームに流れている。"
msgstr "  The sounds of cutlery, the scraping of chairs, and the tick-tock of the clock were the only things to be heard in the sunroom."

#. Occurrence 7_1:2867:8707: scene=7_1
#: 7_1:2867
msgctxt "text_id=8707 | speaker=unknown"
msgid "　ちなみに草十郎はと言うと、夕食は済ませていたので居間からサンルームの様子を眺めているだけだった。"
msgstr "  Soujyuro himself had already eaten. At this moment he was watching the goings-on from the drawing room."

#. Occurrence 7_1:2904:8708: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0002; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:2904
msgctxt "text_id=8708 | speaker=aoko"
msgid "「草十郎、九時からアルバイトでしょ。行ってらっしゃい。私たちの事は気にしないでいいから」"
msgstr "\"Your part-time job starts at nine, right, Soujyuro? See you later then. Don't mind us.\""

#. Occurrence 7_1:2930:8709: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0019; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:2930
msgctxt "text_id=8709 | speaker=soujuurou"
msgid "「ああ。じゃあ行ってくる」"
msgstr "\"Okay. I'll get going then.\""

#. Occurrence 7_1:2980:8710: scene=7_1
#: 7_1:2980
msgctxt "text_id=8710 | speaker=unknown"
msgid "　青子の声に頷いて、コートを羽織る。"
msgstr "  Soujyuro donned his coat with a goodbye nod."

#. Occurrence 7_1:2997:8711: scene=7_1
#: 7_1:2997
msgctxt "text_id=8711 | speaker=unknown"
msgid "　草十郎がもう一度サンルームに目をやると、"
msgstr "  When Soujyuro glanced again at the sunroom"

#. Occurrence 7_1:3023:8712: scene=7_1
#: 7_1:3023
msgctxt "text_id=8712 | speaker=unknown"
msgid "　気のせいか、ばったりと有珠と視線が合った。"
msgstr "  he momentarily locked eyes with Alice, or so he imagined."

#. Occurrence 7_1:3070:8713: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0020; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:3070
msgctxt "text_id=8713 | speaker=soujuurou"
msgid "「？」"
msgstr "\"Huh?\""

#. Occurrence 7_1:3076:8714: scene=7_1
#: 7_1:3076
msgctxt "text_id=8714 | speaker=unknown"
msgid "　今日一日、有珠は草十郎を無視し続けた。"
msgstr "  She had been ignoring him all day."

#. Occurrence 7_1:3081:8715: scene=7_1
#: 7_1:3081
msgctxt "text_id=8715 | speaker=unknown"
msgid "　視界にさえ入れない、という徹底ぶりである。"
msgstr "  And not just refusing to talk to him-she had avoided him so much so as to not look at him all day until this very moment."

#. Occurrence 7_1:3086:8716: scene=7_1
#: 7_1:3086
msgctxt "text_id=8716 | speaker=unknown"
msgid "　邪魔者として睨まれているのであれば合点がいくが、先ほどの視線に敵意はなかった。"
msgstr "  He could understand if he was annoying her as the outsider in the mansion, but he felt no animosity in her gaze just now."

#. Occurrence 7_1:3112:8717: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0021; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:3112
msgctxt "text_id=8717 | speaker=soujuurou"
msgid "「……居間の様子を見てた、のかな」"
msgstr "\"Maybe she was just glancing in the general direction of the drawing room.\""

#. Occurrence 7_1:3190:8718: scene=7_1
#: 7_1:3190
msgctxt "text_id=8718 | speaker=unknown"
msgid "　きょろきょろと居間を見渡して、草十郎はロビーへと向かっていった。"
msgstr "  Soujyuro looked nervously at his surroundings for a moment before heading to the foyer."

#. Occurrence 7_1:3243:8719: scene=7_1
#: 7_1:3243
msgctxt "text_id=8719 | speaker=unknown"
msgid "　草十郎の退出を認めると、有珠は不自然だった視線を戻す。"
msgstr "  Alice only let her gaze return to normal when she was completely sure he was gone."

#. Occurrence 7_1:3263:8720: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0003; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3263
msgctxt "text_id=8720 | speaker=aoko"
msgid "「―――はあ、めんどくさ」"
msgstr "\"Ugh. So much drama.\""

#. Occurrence 7_1:3268:8721: scene=7_1
#: 7_1:3268
msgctxt "text_id=8721 | speaker=unknown"
msgid "　青子からすれば露骨すぎて呆れてしまう。"
msgstr "  Aoko was appalled by Alice's brazen display."

#. Occurrence 7_1:3273:8722: scene=7_1
#: 7_1:3273
msgctxt "text_id=8722 | speaker=unknown"
msgid "　無関心を装っているのがバレバレなのだ。"
msgstr "  So much so, her immaculate veneer of apathy crumbled."

#. Occurrence 7_1:3314:8723: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0002; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3314
msgctxt "text_id=8723 | speaker=alice"
msgid "「……なに。<献立|こんだて>に不満でもあるの、青子」"
msgstr "\"What's that, Aoko? Still upset over tonight's lack of chocolate?\""

#. Occurrence 7_1:3320:8724: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0004; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3320
msgctxt "text_id=8724 | speaker=aoko"
msgid "「もちろんあるけど、いつもの事だし慣れてるわよ。"
msgstr "\"I would be, but I'm so over expecting other people to pull their weight."

#. Occurrence 7_1:3339:8725: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0005; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3339
msgctxt "text_id=8725 | speaker=aoko"
msgid "　私が呆れてるのはアンタの意地の悪さの方。"
msgstr "  No, what I can't stand is your attitude."

#. Occurrence 7_1:3345:8726: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0006; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3345
msgctxt "text_id=8726 | speaker=aoko"
msgid "　徹底的に無視してるクセに、相手の反応を<窺|うかが>ってるなんて女々しくない？　罠張って待ち受けるようなもんじゃない」"
msgstr "  It's pretty sissy of you to pretend to ignore him while watching his every move. Could you be any more obvious with such a cheap trap?\""

#. Occurrence 7_1:3378:8727: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0003; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3378
msgctxt "text_id=8727 | speaker=alice"
msgid "「彼の反応なんて探ってないわ。そもそも興味がないもの。それと、今のは差別発言ね。女々しいという表現は女性軽視にすぎるわ。"
msgstr "\"I was not watching his every move. I could care less what he does. And mind how you use the word 'sissy.' It reeks of sexism."

#. Occurrence 7_1:3385:8728: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0004; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3385
msgctxt "text_id=8728 | speaker=alice"
msgid "今の場合なら、貴女は矛盾している、と言ってちょうだい」"
msgstr "Next time, just say 'you're a hypocrite,' okay?\""

#. Occurrence 7_1:3407:8729: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0007; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3407
msgctxt "text_id=8729 | speaker=aoko"
msgid "「うわ、自覚ありときた」"
msgstr "\"Well look who suddenly found a soap box.\""

#. Occurrence 7_1:3446:8730: scene=7_1
#: 7_1:3446
msgctxt "text_id=8730 | speaker=unknown"
msgid "　同居人の指摘を聞き流して、有珠は夕食を再開する。"
msgstr "  Choosing not to rise to her roommate's jibe, Alice resumed eating."

#. Occurrence 7_1:3451:8731: scene=7_1
#: 7_1:3451
msgctxt "text_id=8731 | speaker=unknown"
msgid "　青子は呆れ顔のまま、ソフトブレッドをちぎっては食べ、ちぎっては食べるのだった。"
msgstr "  Aoko tore off pieces of bread and ate them one by one, anger still visible on her face."

#. Occurrence 7_1:3488:8732: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0008; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3488
msgctxt "text_id=8732 | speaker=aoko"
msgid "「じゃあここからは蒼崎青子としてじゃなく、共犯者としての質問ね。"
msgstr "\"Forget whatever issues you and me have for a minute, and take some advice from someone who knows a thing or two about messing with that boy."

#. Occurrence 7_1:3512:8733: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0009; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3512
msgctxt "text_id=8733 | speaker=aoko"
msgid "　有珠的に、彼を見逃していいと思える判断材料はない？"
msgstr "  Maybe, we need to cut him some slack."

#. Occurrence 7_1:3518:8734: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0010; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3518
msgctxt "text_id=8734 | speaker=aoko"
msgid "　ありえないけど、実は彼も魔術師でした、なんてオチであったとしても、<洋|こ><館|こ>に住まわせるのは容認できない？」"
msgstr "  Hypothetically, let's say it turns out that he's a mage too. Then would you be okay with him living here?\""

#. Occurrence 7_1:3558:8735: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0005; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3558
msgctxt "text_id=8735 | speaker=alice"
msgid "「その理由なら認めるわ。彼を許すのではなく、そんな事に気付かなかったわたしたちへのペナルティとして。"
msgstr "\"Sure. But not for his benefit. I couldn't think of a more fitting punishment for you and I for not recognizing his ability sooner."

#. Occurrence 7_1:3570:8736: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0006; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3570
msgctxt "text_id=8736 | speaker=alice"
msgid "　……そうね。今のは絶対にありえない話だけど、それと同じに、絶対の結論もまたないわ。"
msgstr "  So, yes, hypothetically speaking, I would. But we can burn that bridge when we come to it."

#. Occurrence 7_1:3576:8737: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0007; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3576
msgctxt "text_id=8737 | speaker=alice"
msgid "　彼がここに住む選択を呑む場合すらあるかもしれない。気の迷いは、わたしにだってあるのだし」"
msgstr "  But until then, perhaps I should accept his presence here, perhaps not. I reserve the right to have whims of my own.\""

#. Occurrence 7_1:3613:8738: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0011; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3613
msgctxt "text_id=8738 | speaker=aoko"
msgid "「ええそう、そういうコトよ。"
msgstr "\"Then we're agreed."

#. Occurrence 7_1:3619:8739: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0012; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3619
msgctxt "text_id=8739 | speaker=aoko"
msgid "　今は私との義理とかプライドで冷静をたもってるアンタだけど、アイツの努力次第で少しは、」"
msgstr "  You can keep your chilly distance out of duty to me or personal pride, but if he shows signs of improving, then maybe-\""

#. Occurrence 7_1:3654:8740: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0008; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3654
msgctxt "text_id=8740 | speaker=alice"
msgid "「それは諦めて。彼が何をしようと無駄だから。"
msgstr "\"Dream on. It doesn't matter what he does, he'll never change."

#. Occurrence 7_1:3660:8741: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0009; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3660
msgctxt "text_id=8741 | speaker=alice"
msgid "　貴女も知っていると思うけど―――」"
msgstr "  As you very well know.\""

#. Occurrence 7_1:3681:8742: scene=7_1
#: 7_1:3681
msgctxt "text_id=8742 | speaker=unknown"
msgid "　そもそも、この少女は他人に気を許す事が出来ない。"
msgstr "  Alice had never been the type to let her guard down around others."

#. Occurrence 7_1:3686:8743: scene=7_1
#: 7_1:3686
msgctxt "text_id=8743 | speaker=unknown"
msgid "　多くの器物、多くの童話を再現する代償として、魔女は人間を嫌うものなのだ。"
msgstr "  The young witch despised humans, having recreated so many of their objects and fairy tales."

#. Occurrence 7_1:3725:8744: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0013; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3725
msgctxt "text_id=8744 | speaker=aoko"
msgid "「そんなのアンタ個人のトラウマでしょ。自分の意固地さを魔女の血統云々で棚上げするのはそれこそ女々しいわ。"
msgstr "\"You can't use being a witch as an excuse for every personal issue you have. Yet another example of you being sissy, if you ask me."

#. Occurrence 7_1:3731:8745: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0014; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3731
msgctxt "text_id=8745 | speaker=aoko"
msgid "　いいじゃない、嫌いなら嫌いでハッキリしてれば。"
msgstr "  It's fine if you dislike him, just come out and act like it."

#. Occurrence 7_1:3743:8746: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0015; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3743
msgctxt "text_id=8746 | speaker=aoko"
msgid "　私が気にくわないのはね、アンタのどっちつかずの態度よ有珠」"
msgstr "  Stop trying to have it both ways.\""

#. Occurrence 7_1:3768:8747: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0010; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3768
msgctxt "text_id=8747 | speaker=alice"
msgid "「どっちつかずの態度……？」"
msgstr "\"And what's that supposed to mean?\""

#. Occurrence 7_1:3804:8748: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0016; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3804
msgctxt "text_id=8748 | speaker=aoko"
msgid "「そ。無視するなら徹底して無視してやれって言ってるの。"
msgstr "\"That if you want to ignore him then ignore him for real."

#. Occurrence 7_1:3810:8749: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0017; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3810
msgctxt "text_id=8749 | speaker=aoko"
msgid "　ガチガチに守りをかためて、そのクセ城門だけ開けて、獲物が油断して入ってきたら串刺しにする気満々とか、相棒として見てられないわ。"
msgstr "  You're fortifying the castle walls while leaving the front gate wide open, waiting for him to make the horrible mistake of exactly what you're urging him to do. It's gross to watch."

#. Occurrence 7_1:3821:8750: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0018; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3821
msgctxt "text_id=8750 | speaker=aoko"
msgid "　アイツにできるコトなんて閉ざされた門をあける事ぐらいだっていうのに、その機会さえ無くすのはどうなの？」"
msgstr "  If you don't want him to come inside, then shut the damn door already!\""

#. Occurrence 7_1:3868:8751: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0011; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3868
msgctxt "text_id=8751 | speaker=alice"
msgid "「……ごめんなさい青子。もう少し簡単に言って。"
msgstr "\"I'm sorry, Aoko, you've lost me."

#. Occurrence 7_1:3874:8752: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0012; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:3874
msgctxt "text_id=8752 | speaker=alice"
msgid "　その喩えは、ちょっと……」"
msgstr "  Say that again in plain English.\""

#. Occurrence 7_1:3880:8753: scene=7_1
#: 7_1:3880
msgctxt "text_id=8753 | speaker=unknown"
msgid "　何を比喩しているのか分からない、と言いよどむ有珠。"
msgstr "  Alice seemed unable to grasp Aoko's metaphor."

#. Occurrence 7_1:3905:8754: scene=7_1
#: 7_1:3905
msgctxt "text_id=8754 | speaker=unknown"
msgid "　そんな相棒の無自覚さに、青子の苛立ちは一瞬だけ沸点を超えたようだ。"
msgstr "  Meanwhile, Aoko had had it up to here with her roommate's lack of self-awareness and was starting to lose her cool."

#. Occurrence 7_1:3939:8755: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0019; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3939
msgctxt "text_id=8755 | speaker=aoko"
msgid "「だから興味ないとか言っておきながらコナかけるなってコト！　あんなにチラチラ盗み見たら、アイツ、ヘンに勘違いしちゃうかもしれないでしょ？"
msgstr "\"If you really don't care, then quit worrying so much about him! If he notices you gawking at him, he might just get the wrong idea!"

#. Occurrence 7_1:3951:8756: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0020_0; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3951
msgctxt "text_id=8756 | speaker=aoko"
msgid "“有珠はああ見えて、本当は自分と仲直りしたがっているに違いない。じゃあさっそく部屋に押しかけてみよう”"
msgstr "  He's probably thinking, 'Alice looked like she wanted to patch things up. Maybe I should go stop by her room.'"

#. Occurrence 7_1:3963:8757: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0020_1; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:3963
msgctxt "text_id=8757 | speaker=aoko"
msgid "とか！」"
msgstr " Or even worse!\""

#. Occurrence 7_1:4015:8758: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0013; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4015
msgctxt "text_id=8758 | speaker=alice"
msgid "「―――そういうコトに、なるの？」"
msgstr "\"...You really think so?\""

#. Occurrence 7_1:4039:8759: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0021; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:4039
msgctxt "text_id=8759 | speaker=aoko"
msgid "「なる。少なくとも、私だったらいいかげんイライラして“話があるなら校舎裏まで来い”って決着つけかねないレベル。この<毒婦|どくふ>」"
msgstr "\"Yes! If it were me you were doing that to, I'd be dragging you out back and smacking you senseless. Bitch.\""

#. Occurrence 7_1:4079:8760: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0014; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4079
msgctxt "text_id=8760 | speaker=alice"
msgid "「……そうだったのね。気をつけるわ。"
msgstr "\"Very well. I'll be more careful."

#. Occurrence 7_1:4085:8761: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0015; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4085
msgctxt "text_id=8761 | speaker=alice"
msgid "　別に、彼と話をする気はないんだし。わたしも、彼を見ていたというより、彼の手足を見ていたのだし」"
msgstr "  It's not like I want to talk to him anyway. And for the record I didn't look at him, exactly. Only at his arms and legs.\""

#. Occurrence 7_1:4108:8762: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0022; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:4108
msgctxt "text_id=8762 | speaker=aoko"
msgid "「？　手足って、なんで？」"
msgstr "\"And why in the world would you look at his arms and legs?\""

#. Occurrence 7_1:4143:8763: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0016; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4143
msgctxt "text_id=8763 | speaker=alice"
msgid "「手足は手足よ。彼個人には思うところはないけど、あの夜の出来事はまだ記憶に新しいから。"
msgstr "\"Because of what happened the other night, though I doubt he even remembers."

#. Occurrence 7_1:4155:8764: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0017; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4155
msgctxt "text_id=8764 | speaker=alice"
msgid "それが少しだけ気になって、つい視線で追っていたのね」"
msgstr "I was thinking about it and just...happened to glance over at his arms and legs.\""

#. Occurrence 7_1:4177:8765: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0023; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:4177
msgctxt "text_id=8765 | speaker=aoko"
msgid "「あの夜って、遊園地のこと？　なんかしたっけアイツ？」"
msgstr "\"You mean at the amusement park? I don't remember him doing anything special.\""

#. Occurrence 7_1:4218:8766: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0018; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4218
msgctxt "text_id=8766 | speaker=alice"
msgid "「…………」"
msgstr "\"...\""

#. Occurrence 7_1:4241:8767: scene=7_1
#: 7_1:4241
msgctxt "text_id=8767 | speaker=unknown"
msgid "　有珠の表情が見るからに不機嫌になる。"
msgstr "  Alice's expression soured."

#. Occurrence 7_1:4246:8768: scene=7_1
#: 7_1:4246
msgctxt "text_id=8768 | speaker=unknown"
msgid "　遊園地での敗北をいまだ引きずっているらしい。"
msgstr "  She still felt the sting of her defeat."

#. Occurrence 7_1:4267:8769: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0019; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4267
msgctxt "text_id=8769 | speaker=alice"
msgid "「飛んだでしょう、彼。"
msgstr "\"You saw the way he flew through the air, didn't you?"

#. Occurrence 7_1:4273:8770: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0020; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4273
msgctxt "text_id=8770 | speaker=alice"
msgid "　レールの上から、私のダンプティに向かって」"
msgstr "  Off the track, straight at my Dumpty.\""

#. Occurrence 7_1:4285:8771: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0024; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:4285
msgctxt "text_id=8771 | speaker=aoko"
msgid "「ええ、そんなコト言ってたわね。勢いでつい、一メートルぐらいだから飛んじゃったー、とか」"
msgstr "\"Sure, you were raving about how he flew a whole couple of feet.\""

#. Occurrence 7_1:4311:8772: scene=7_1
#: 7_1:4311
msgctxt "text_id=8772 | speaker=unknown"
msgid "　幸運な事に、青子はあの現場を見ていない。"
msgstr "  Aoko had not actually seen it in person, luckily."

#. Occurrence 7_1:4316:8773: scene=7_1
#: 7_1:4316
msgctxt "text_id=8773 | speaker=unknown"
msgid "　草十郎が死のジャンプをこなした理由のひとつが、<自分|あおこ>がかけた暗示によるもの、としか知らないのだ。"
msgstr "  All she knew was that the spell she had placed on Soujyuro was part of the reason he survived that jump of death."

#. Occurrence 7_1:4383:8774: scene=7_1
#: 7_1:4383
msgctxt "text_id=8774 | speaker=unknown"
msgid "　一方、有珠はあの光景を時計台から目撃していた。"
msgstr "  Alice on the other hand had observed the whole scene from the clock tower."

#. Occurrence 7_1:4388:8775: scene=7_1
#: 7_1:4388
msgctxt "text_id=8775 | speaker=unknown"
msgid "　本当にわずか一瞬だけだったが、"
msgstr "  It had only lasted an instant"

#. Occurrence 7_1:4393:8776: scene=7_1
#: 7_1:4393
msgctxt "text_id=8776 | speaker=unknown"
msgid "　崩れ去るスナークよりも"
msgstr "  but it had burned itself into her mind's eye,"

#. Occurrence 7_1:4398:8777: scene=7_1
#: 7_1:4398
msgctxt "text_id=8777 | speaker=unknown"
msgid "　地上で月を落とす青子よりも、"
msgstr "  more than when her precious moon had fallen at Aoko's hands"

#. Occurrence 7_1:4403:8778: scene=7_1
#: 7_1:4403
msgctxt "text_id=8778 | speaker=unknown"
msgid "　目を奪ったその光景。"
msgstr "  and Flat Snark had come tumbling down."

#. Occurrence 7_1:4441:8779: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0025; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:4441
msgctxt "text_id=8779 | speaker=aoko"
msgid "「でも、それがどうしたの？　卵の仇討ちってワケ？」"
msgstr "\"So that's it. You wanna get back at him for what happened to Dumpty, do you?\""

#. Occurrence 7_1:4463:8780: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0021_0; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4463
msgctxt "text_id=8780 | speaker=alice"
msgid "「ダンプティは壊れるのが仕事だから、仇討ちも何もないわ。"
msgstr "\"Dumpty's destruction was purely business. I feel no need for retaliation."

#. Occurrence 7_1:4476:8781: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0021_1; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4476
msgctxt "text_id=8781 | speaker=alice"
msgid "ただ……人間の体って、あんな風に動くんだなって」"
msgstr " I was just intrigued to observe the movement of a human body.\""

#. Occurrence 7_1:4509:8782: scene=7_1
#: 7_1:4509
msgctxt "text_id=8782 | speaker=unknown"
msgid "　そう。"
msgstr "  As it goes..."

#. Occurrence 7_1:4515:8783: scene=7_1
#: 7_1:4515
msgctxt "text_id=8783 | speaker=unknown"
msgid "人付き合いの少ない有珠にとって、草十郎の跳躍は初めて見る衝撃だった。"
msgstr "For someone with as little human interaction as Alice, Soujyuro's leap must have appeared quite remarkable."

#. Occurrence 7_1:4542:8784: scene=7_1
#: 7_1:4542
msgctxt "text_id=8784 | speaker=unknown"
msgid "　森の動物たちより何倍もバランスの悪い、二本の手足。"
msgstr "  Particularly because his legs were orders of magnitude less capable than those of an animal in the forest."

#. Occurrence 7_1:4547:8785: scene=7_1
#: 7_1:4547
msgctxt "text_id=8785 | speaker=unknown"
msgid "　あんな頼りのない足なのに、あんなに無力な両手だったのに、鳥のように虚空を駆った人のカタチ。"
msgstr "  And yet, even with such feeble legs, with those meek arms of his, he managed to fly through the open air like a bird."

#. Occurrence 7_1:4553:8786: scene=7_1
#: 7_1:4553
msgctxt "text_id=8786 | speaker=unknown"
msgid "　それは都市で暮らす人間が、野生の<動物|ピューマ>の躍動を見る感動に近かった。"
msgstr "  To her, it was akin to the feeling city folk get when they see a wild creature in its natural habitat."

#. Occurrence 7_1:4604:8787: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0022; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4604
msgctxt "text_id=8787 | speaker=alice"
msgid "「……気にしないで。機会があるなら、もう一度見たいと思っただけ。"
msgstr "\"...Forget I mentioned it. I just hope I can witness that again someday."

#. Occurrence 7_1:4611:8788: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0023; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4611
msgctxt "text_id=8788 | speaker=alice"
msgid "別に、彼に何を期待しているワケじゃないわ」"
msgstr "And when I say 'human' I am not referring to him.\""

#. Occurrence 7_1:4635:8789: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0026; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:4635
msgctxt "text_id=8789 | speaker=aoko"
msgid "「……なるほど。有珠のプロイってだいたいが人型じゃないしね。たんに物珍しさで見ていただけか」"
msgstr "\"...I see. It was novel for you. It makes sense considering most of your Ploys have non-human forms.\""

#. Occurrence 7_1:4659:8790: scene=7_1
#: 7_1:4659
msgctxt "text_id=8790 | speaker=unknown"
msgid "　はーあ、と両肩を落とす青子。"
msgstr "  Aoko sighed and released the tension from her shoulders."

#. Occurrence 7_1:4664:8791: scene=7_1
#: 7_1:4664
msgctxt "text_id=8791 | speaker=unknown"
msgid "　有珠の思わせぶりな態度が、新しい玩具を欲しがる子供の好奇心と知って落胆したのだ。"
msgstr "  She was disappointed to discover that Alice's behavior stemmed from simple curiosity, like that of a child with a new toy."

#. Occurrence 7_1:4698:8792: scene=7_1
#: 7_1:4698
msgctxt "text_id=8792 | speaker=unknown"
msgid "　そんな同居人の態度に、有珠も異論を唱えなかった。"
msgstr "  And Alice was in no position to take issue with her reaction."

#. Occurrence 7_1:4703:8793: scene=7_1
#: 7_1:4703
msgctxt "text_id=8793 | speaker=unknown"
msgid "　彼女自身、自分の抱いた感動が何なのか、よく分かっていなかったからだ。"
msgstr "  And how could she? She was not entirely sure what it was that she herself was feeling."

#. Occurrence 7_1:4755:8794: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0027; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:4755
msgctxt "text_id=8794 | speaker=aoko"
msgid "「夕食、明日は私が作るから。"
msgstr "\"I'll make dinner tomorrow."

#. Occurrence 7_1:4761:8795: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0028; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:4761
msgctxt "text_id=8795 | speaker=aoko"
msgid "　試験前だってのにこんなしょぼくれたもん食べさせられたら、一夜漬けする気合いも湧かないわよ」"
msgstr "  Another meal like this before exams is going to make it impossible to study.\""

#. Occurrence 7_1:4792:8796: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0024; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:4792
msgctxt "text_id=8796 | speaker=alice"
msgid "「ご自由に。わたしも手が空いて助かるわ」"
msgstr "\"No complaints from me. I certainly wouldn't mind the free time.\""

#. Occurrence 7_1:4844:8797: scene=7_1
#: 7_1:4844
msgctxt "text_id=8797 | speaker=unknown"
msgid "　洋館の夜は過ぎていく。"
msgstr "  Night came and went in the mansion."

#. Occurrence 7_1:4849:8798: scene=7_1
#: 7_1:4849
msgctxt "text_id=8798 | speaker=unknown"
msgid "　幸か不幸か、異物混入による変化は、まだ表面化していないようだ。"
msgstr "  For better or worse, the disturbances caused by the foreign invader had not yet caused the kettle to boil over."

#. Occurrence 7_1:4960:8799: scene=7_1
#: 7_1:4960
msgctxt "text_id=8799 | speaker=unknown"
msgid "　翌朝、空に白みがかかりだした午前六時半。"
msgstr "  The next morning, at six-thirty, as sunlight spread out across the sky..."

#. Occurrence 7_1:4965:8800: scene=7_1
#: 7_1:4965
msgctxt "text_id=8800 | speaker=unknown"
msgid "　冷えこんだ空気の中、なぜか草十郎は青子と一緒に登校していた。"
msgstr "  Soujyuro walked to school with Aoko in the chilly morning air."

#. Occurrence 7_1:5012:8801: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0029; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:5012
msgctxt "text_id=8801 | speaker=aoko"
msgid "“いい？　洋館にいる時は、極力一人にならない事。”"
msgstr "\"So try not to ever be alone in the house. Okay?\""

#. Occurrence 7_1:5018:8802: scene=7_1
#: 7_1:5018
msgctxt "text_id=8802 | speaker=unknown"
msgid "　青子はその忠告通り、こうして洋館を出るまでは草十郎の安全を確保している。"
msgstr "  It was her intention to keep Soujyuro safe until he left the mansion."

#. Occurrence 7_1:5023:8803: scene=7_1
#: 7_1:5023
msgctxt "text_id=8803 | speaker=unknown"
msgid "　……にしても、"
msgstr "  Nonetheless..."

#. Occurrence 7_1:5062:8804: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0030; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:5062
msgctxt "text_id=8804 | speaker=aoko"
msgid "「眠い。六時から登校とか、アンタも働き者ね」"
msgstr "\"God I'm sleepy. What's the deal with going to school so early?\""

#. Occurrence 7_1:5068:8805: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0022; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:5068
msgctxt "text_id=8805 | speaker=soujuurou"
msgid "「そうでもないよ。三十分<仕|し><出|だ>しを手伝うだけだし」"
msgstr "\"I'm not. I have to pull a thirty-minute shift helping with deliveries.\""

#. Occurrence 7_1:5113:8806: scene=7_1
#: 7_1:5113
msgctxt "text_id=8806 | speaker=unknown"
msgid "　期末試験を控えた状況とは思えない、<逞|たくま>しいまでの労働意欲である。"
msgstr "  His work ethic was a little too strong for a student entering finals."

#. Occurrence 7_1:5140:8807: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0023; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:5140
msgctxt "text_id=8807 | speaker=soujuurou"
msgid "「それより蒼崎、無理してないか？"
msgstr "\"Are you sure you're not pushing yourself too hard, Aozaki?"

#. Occurrence 7_1:5140:8808: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0023; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:5140
msgctxt "text_id=8808 | speaker=soujuurou"
msgid "　別に、こっちに付き合う事ないんだぞ」"
msgstr "  You don't need to keep tabs on me, you know.\""

#. Occurrence 7_1:5176:8809: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0031; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:5176
msgctxt "text_id=8809 | speaker=aoko"
msgid "「ご心配なく、生徒会室で仮眠とるから。"
msgstr "\"Oh don't you worry. I'll catch up on some sleep in the student council's room when we're done."

#. Occurrence 7_1:5176:8810: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0031; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:5176
msgctxt "text_id=8810 | speaker=aoko"
msgid "　約束だし、門までは一緒に行くわよ」"
msgstr "  I promised I'd walk you as far as the front gate, and I plan to stick to it.\""

#. Occurrence 7_1:5241:8811: scene=7_1
#: 7_1:5241
msgctxt "text_id=8811 | speaker=unknown"
msgid "　青子は思う。"
msgstr "  But internally, Aoko was worried."

#. Occurrence 7_1:5246:8812: scene=7_1
#: 7_1:5246
msgctxt "text_id=8812 | speaker=unknown"
msgid "　はたして、同居人がどんな罠を仕掛けているか。"
msgstr "  What traps did her roommate have in store for him?"

#. Occurrence 7_1:5251:8813: scene=7_1
#: 7_1:5251
msgctxt "text_id=8813 | speaker=unknown"
msgid "　まさか森の中まで<禁忌|タブー>を仕掛けているとは思えないが、念のためだ。"
msgstr "  She could not imagine Alice had planned anything to go down in the woods, but she wanted to be safer than sorry."

#. Occurrence 7_1:5256:8814: scene=7_1
#: 7_1:5256
msgctxt "text_id=8814 | speaker=unknown"
msgid "　せめて行き道ぐらいは草十郎の味方になろう、と決めた青子である。"
msgstr "  The least she could do was accompany Soujyuro to school. That much she was firmly committed to."

#. Occurrence 7_1:5317:8815: scene=7_1
#: 7_1:5317
msgctxt "text_id=8815 | speaker=unknown"
msgid "　罠があるのなら行き道で解除すればいい。"
msgstr "  Any traps that presented themselves could then be dealt with on the spot."

#. Occurrence 7_1:5322:8816: scene=7_1
#: 7_1:5322
msgctxt "text_id=8816 | speaker=unknown"
msgid "　一度解除……といっても青子には壊す程度しかできないのだが……してしまえば、しばらくは安全になるだろう。"
msgstr "  Well, not \"dealt with\" so much as destroyed, since that was Aoko's forte. But that would be enough to keep him safe for the time being."

#. Occurrence 7_1:5370:8817: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0032; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:5370
msgctxt "text_id=8817 | speaker=aoko"
msgid "「ま、帰り道に関しては、有珠もそこまで暇ではないと信じるしかないんだけど」"
msgstr "\"As for when you get out of school, all we can do is hope that Alice is short on free time today.\""

#. Occurrence 7_1:5383:8818: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0024; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:5383
msgctxt "text_id=8818 | speaker=soujuurou"
msgid "「？」"
msgstr "\"Err... Okay?\""

#. Occurrence 7_1:5455:8819: scene=7_1
#: 7_1:5455
msgctxt "text_id=8819 | speaker=unknown"
msgid "　夜に罠を仕掛けて、解除されたら休むことなく日中に仕掛けてまわる……なんてマメさを発揮されてはお手上げだ。"
msgstr "  If Alice was willing to put all her energy into a new trap after the first had failed, then they were as good as dead anyway."

#. Occurrence 7_1:5460:8820: scene=7_1
#: 7_1:5460
msgctxt "text_id=8820 | speaker=unknown"
msgid "　その時はその時。"
msgstr "  But Aoko would cross that road when she came to it."

#. Occurrence 7_1:5465:8821: scene=7_1
#: 7_1:5465
msgctxt "text_id=8821 | speaker=unknown"
msgid "　久遠寺有珠にとって、静希草十郎はそこまでするほどの外敵だっただけの話だ。"
msgstr "  It all depended on how deep Alice's dislike of Soujyuro really went."

#. Occurrence 7_1:5470:8822: scene=7_1
#: 7_1:5470
msgctxt "text_id=8822 | speaker=unknown"
msgid "　あの少女が頑なに守ってきた、魔女としての<矜持|プライド>を台無しにしてもいい程の。"
msgstr "  It would have to be enough to make her abandon her pride as a witch, something she had protected fervently until now."

#. Occurrence 7_1:5553:8823: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0033; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:5553
msgctxt "text_id=8823 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 7_1:5558:8824: scene=7_1
#: 7_1:5558
msgctxt "text_id=8824 | speaker=unknown"
msgid "　そもそも、その場合は青子がどれだけ尽力してもこの少年は守りきれない。日中のコトまで気を回すのは意味がなかった。"
msgstr "  If that were the case Aoko knew she would never be able to keep him safe. The moment twenty-four seven protection became necessary was the moment she had failed."

#. Occurrence 7_1:5563:8825: scene=7_1
#: 7_1:5563
msgctxt "text_id=8825 | speaker=unknown"
msgid "　自分にできるかぎりの事ならするが、自分の範疇を超えた事はあっさりと切り捨てるのが青子の人間性である。"
msgstr "  Her character led her to focus on what she could do in the here and now, and ignore the rest."

#. Occurrence 7_1:5568:8826: scene=7_1
#: 7_1:5568
msgctxt "text_id=8826 | speaker=unknown"
msgid "　彼女にとっては、この方針が最大限の譲歩だった。"
msgstr "  And this current plan of hers was her best attempt at doing right by everyone."

#. Occurrence 7_1:5633:8827: scene=7_1
#: 7_1:5633
msgctxt "text_id=8827 | speaker=unknown"
msgid "　久遠寺の敷地から出る。"
msgstr "  They left behind the Kuonji Estate."

#. Occurrence 7_1:5638:8828: scene=7_1
#: 7_1:5638
msgctxt "text_id=8828 | speaker=unknown"
msgid "　坂を下りて住宅地に出るまでふたり一緒だ。"
msgstr "  And the two remained together until the residential area at the bottom of the hill."

#. Occurrence 7_1:5643:8829: scene=7_1
#: 7_1:5643
msgctxt "text_id=8829 | speaker=unknown"
msgid "　ふと、青子は傍らの少年を盗み見る。"
msgstr "  Where Aoko glanced casually at Soujyuro."

#. Occurrence 7_1:5650:8830: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0034; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:5650
msgctxt "text_id=8830 | speaker=aoko"
msgid "「ところで、何か考えてる？」"
msgstr "\"So, any thoughts?\""

#. Occurrence 7_1:5691:8831: scene=7_1
#: 7_1:5691
msgctxt "text_id=8831 | speaker=unknown"
msgid "　青子は気まぐれで問いただしたが、意外な事に草十郎は質問の意図を察していた。"
msgstr "  Surprisingly, Soujyuro saw through her harmless question and sensed the bigger issue."

#. Occurrence 7_1:5697:8832: scene=7_1
#: 7_1:5697
msgctxt "text_id=8832 | speaker=unknown"
msgid "“有珠をどう納得させるのか”"
msgstr "  How was he going to win Alice over?"

#. Occurrence 7_1:5703:8833: scene=7_1
#: 7_1:5703
msgctxt "text_id=8833 | speaker=unknown"
msgid "　その難問を、彼は彼なりに考えていたらしい。"
msgstr "  In fact he had been thinking about that very question."

#. Occurrence 7_1:5752:8834: scene=7_1
#: 7_1:5752
msgctxt "text_id=8834 | speaker=unknown"
msgid "　友人曰く。"
msgstr "  According to his friend..."

#. Occurrence 7_1:5757:8835: scene=7_1
#: 7_1:5757
msgctxt "text_id=8835 | speaker=unknown"
msgid "　この手の難問には大きく三通りの対応法があるという。"
msgstr "  There were three basic approaches he could take."

#. Occurrence 7_1:5762:8836: scene=7_1
#: 7_1:5762
msgctxt "text_id=8836 | speaker=unknown"
msgid "　一つは外回り。"
msgstr "  One was the roundabout approach."

#. Occurrence 7_1:5789:8837: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0018; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:5789
msgctxt "text_id=8837 | speaker=kinomi"
msgid "“こいつは時間がかかるが、もっとも自然だ。"
msgstr "\"This way takes the longest, but it's the most natural."

#. Occurrence 7_1:5795:8838: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0019; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:5795
msgctxt "text_id=8838 | speaker=kinomi"
msgid "　人間ってのは自分が好きなものを大切にされると、コロッと気を許しちまう。仲間意識ってヤツだな！”"
msgstr "  Humans love it when you pay attention to the things they like, just as friends do.\""

#. Occurrence 7_1:5801:8839: scene=7_1
#: 7_1:5801
msgctxt "text_id=8839 | speaker=unknown"
msgid "　つまり、ターゲット本人ではなく、ターゲットが大事にしているものに気を遣え、というコトらしい。"
msgstr "  In other words, instead of focusing on the person one wishes to win over, one should focus on their interests."

#. Occurrence 7_1:5826:8840: scene=7_1
#: 7_1:5826
msgctxt "text_id=8840 | speaker=unknown"
msgid "　木乃美らしからぬ大人な意見ではあったが、残念なことに、草十郎は有珠の<嗜好|しこう>を知らなかった。"
msgstr "  It was a surprisingly mature opinion coming from Kinomi. Unfortunately, Soujyuro had no idea what sort of things Alice liked."

#. Occurrence 7_1:5831:8841: scene=7_1
#: 7_1:5831
msgctxt "text_id=8841 | speaker=unknown"
msgid "　洋館を大切にしているコトは感じ取っているが、ここで洋館の掃除などをしても逆効果な気がする。"
msgstr "  She seemed very fond of the mansion, but what could he do-clean it for her? He sensed that would have a reverse effect."

#. Occurrence 7_1:5836:8842: scene=7_1
#: 7_1:5836
msgctxt "text_id=8842 | speaker=unknown"
msgid "　草十郎としては、大切すぎるものには簡単に触れて欲しくないのではないか、と思うのだ。"
msgstr "  He had the distinct feeling she would not want him touching what was precious to her."

#. Occurrence 7_1:5856:8843: scene=7_1
#: 7_1:5856
msgctxt "text_id=8843 | speaker=unknown"
msgid "　二つめは内回り。"
msgstr "  The second approach was to take the inner track."

#. Occurrence 7_1:5871:8844: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0020; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:5871
msgctxt "text_id=8844 | speaker=kinomi"
msgid "“でも、やっぱり本人を落とすのが一番早い。オレたちに魅力がないのなら、魅力のある外付け装備に頼るのだ。"
msgstr "\"It's the fastest way to get someone to fall for you. When you can't coast on your natural good looks and charm, that's what your wallet is for."

#. Occurrence 7_1:5877:8845: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0021; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:5877
msgctxt "text_id=8845 | speaker=kinomi"
msgid "　―――そう、プレゼントなンだよ静希クン！”"
msgstr "  You know what I'm talking about-gifts!\""

#. Occurrence 7_1:5889:8846: scene=7_1
#: 7_1:5889
msgctxt "text_id=8846 | speaker=unknown"
msgid "　即ち短期決戦。かつ、一撃必殺。"
msgstr "  A quick-and-dirty strategy-the assassin's strike."

#. Occurrence 7_1:5894:8847: scene=7_1
#: 7_1:5894
msgctxt "text_id=8847 | speaker=unknown"
msgid "　高価な贈り物で相手の意識を変えろ、というコトらしい。"
msgstr "  Manipulate someone's feelings with an expensive gift."

#. Occurrence 7_1:5919:8848: scene=7_1
#: 7_1:5919
msgctxt "text_id=8848 | speaker=unknown"
msgid "　素晴らしい作戦だ、と草十郎も思う。"
msgstr "  To Soujyuro, this sounded like his best chance."

#. Occurrence 7_1:5924:8849: scene=7_1
#: 7_1:5924
msgctxt "text_id=8849 | speaker=unknown"
msgid "　なによりシンプルなのがいい。わかりやすいのは彼にとってありがたい。"
msgstr "  The approach was easy for him to grasp, and he appreciated its simplicity."

#. Occurrence 7_1:5929:8850: scene=7_1
#: 7_1:5929
msgctxt "text_id=8850 | speaker=unknown"
msgid "　しかし―――つまるところ、それも一つ目の作戦と同じ気がする。"
msgstr "  However, he had the same concerns as with the first approach."

#. Occurrence 7_1:5934:8851: scene=7_1
#: 7_1:5934
msgctxt "text_id=8851 | speaker=unknown"
msgid "　なにより、先立つものがないのが致命的だ。"
msgstr "  A step was missing, and without this step the plan was bound to fail."

#. Occurrence 7_1:5963:8852: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0022_0; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:5963
#. Occurrence 7_1:5970:8852: scene=7_1
#: 7_1:5970
msgctxt "text_id=8852 | speaker=kinomi"
msgid "“あとは……まあ、<見|ケン>ってヤツ？"
msgstr "\"The only other option is...well, I guess you could call it 'wait and see.'"

#. Occurrence 7_1:5983:8853: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0022_1; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:5983
msgctxt "text_id=8853 | speaker=kinomi"
msgid "　オレにはよくわかんねえけどさー、やりすぎると悪い印象を持たれるとか殿下がいってたなー。"
msgstr "  I don't fully understand it myself, but they say if you try too hard, your plan's bound to backfire."

#. Occurrence 7_1:5995:8854: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_1_0023; voice_prefix=B50; voice_category=6; scene=7_1
#: 7_1:5995
msgctxt "text_id=8854 | speaker=kinomi"
msgid "　アタシ、いま落とされてる！　って意識させちゃダメなんだとよ。付き合った後で、アレ、アタシ落とされた？　と気づかせるのが上等なんだとか”"
msgstr "  Like, you don't ever want the girl to have a sudden epiphany of 'Oh, now I love him!' It's better that it dawns on her after you've hung out together for a while, like, 'Wait...I think I like him!'\""

#. Occurrence 7_1:6027:8855: scene=7_1
#: 7_1:6027
msgctxt "text_id=8855 | speaker=unknown"
msgid "　言わんとするところはまったく分からないが、要は無理をするな、というコトらしい。"
msgstr "  Though Soujyuro did not quite grasp the details he understood the basic idea: Don't press your luck."

#. Occurrence 7_1:6032:8856: scene=7_1
#: 7_1:6032
msgctxt "text_id=8856 | speaker=unknown"
msgid "　まったく同感だ。"
msgstr "  He knew that much was good advice."

#. Occurrence 7_1:6043:8857: scene=7_1
#: 7_1:6043
msgctxt "text_id=8857 | speaker=unknown"
msgid "　気に入られる為に努力するのは正しい。"
msgstr "  He would have to try extremely hard to get on Alice's good side."

#. Occurrence 7_1:6048:8858: scene=7_1
#: 7_1:6048
msgctxt "text_id=8858 | speaker=unknown"
msgid "　けれど、それにも段階があるのでは、と草十郎は思うのだ。"
msgstr "  And he could tell it would be a long process to get there."

#. Occurrence 7_1:6076:8859: scene=7_1
#: 7_1:6076
msgctxt "text_id=8859 | speaker=unknown"
msgid "　昔、山で見知らぬ狐のテリトリーに入ってしまったコトを思いだす。"
msgstr "  Soujyuro recalled the time he had wandered inside a fox's territory in the mountains."

#. Occurrence 7_1:6081:8860: scene=7_1
#: 7_1:6081
msgctxt "text_id=8860 | speaker=unknown"
msgid "　あの時は手持ちの食べ物などを置いてしまったが、それ以降、狐の気配はなくなってしまった。"
msgstr "  He had left some food on the ground for the fox, and then it never bothered him again."

#. Occurrence 7_1:6086:8861: scene=7_1
#: 7_1:6086
msgctxt "text_id=8861 | speaker=unknown"
msgid "　善意、懇意のカタチは人それぞれ。"
msgstr "  What is considered good will and kindness varies from person to person."

#. Occurrence 7_1:6091:8862: scene=7_1
#: 7_1:6091
msgctxt "text_id=8862 | speaker=unknown"
msgid "　一方的な善意は時として重荷になる。"
msgstr "  But if there is enough good will from one side, regardless of whether that good will is reciprocated, the other side will eventually start to feel an obligation to do so."

#. Occurrence 7_1:6096:8863: scene=7_1
#: 7_1:6096
msgctxt "text_id=8863 | speaker=unknown"
msgid "　なので、"
msgstr "  That was key."

#. Occurrence 7_1:6142:8864: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0025; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:6142
msgctxt "text_id=8864 | speaker=soujuurou"
msgid "「大丈夫、考えてるよ。とりあえず自分にできるコトとか、したいコトをしようと思う。"
msgstr "\"It's okay, I'll think of something. For now, I can only do... what I can do."

#. Occurrence 7_1:6149:8865: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0026; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:6149
msgctxt "text_id=8865 | speaker=soujuurou"
msgid "安心してくれ。蒼崎に忠告されたコトすら、きちんと守る方針だ」"
msgstr "Don't worry. I've taken your counsel to heart, Aozaki.\""

#. Occurrence 7_1:6178:8866: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0035; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:6178
msgctxt "text_id=8866 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 7_1:6185:8867: scene=7_1
#: 7_1:6185
msgctxt "text_id=8867 | speaker=unknown"
msgid "　まかせろ、と胸を張る草十郎。"
msgstr "  Soujyuro seemed ready to face things head on."

#. Occurrence 7_1:6190:8868: scene=7_1
#: 7_1:6190
msgctxt "text_id=8868 | speaker=unknown"
msgid "　まったく頼り甲斐のない返答に、ほんと大丈夫かコイツ、とつい親身になってしまう青子だった。"
msgstr "  His answer did little to reassure Aoko, however. She found herself more concerned about his safety than ever before."

#. Occurrence 7_1:6244:8869: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_1_0000; voice_prefix=B10; voice_category=5; scene=7_1
#: 7_1:6244
msgctxt "text_id=8869 | speaker=kojika"
msgid "「学校にあるような<箒|ほうき>がほしい？」"
msgstr "\"You're looking for a broom like the ones at school?\""

#. Occurrence 7_1:6289:8870: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0027; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:6289
msgctxt "text_id=8870 | speaker=soujuurou"
msgid "「そうなんだ。できれば安く買えるところ」"
msgstr "\"Yeah. The cheaper the better.\""

#. Occurrence 7_1:6301:8871: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_1_0001; voice_prefix=B10; voice_category=5; scene=7_1
#: 7_1:6301
msgctxt "text_id=8871 | speaker=kojika"
msgid "「……静希の家、アパートよね。箒なんてモノ必要とは思えないけど」"
msgstr "\"Don't you live in an apartment? Who needs a broom in an apartment?\""

#. Occurrence 7_1:6327:8872: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0028; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:6327
msgctxt "text_id=8872 | speaker=soujuurou"
msgid "「いや、ちょっと気になるところがあって掃除がしたいんだ。ゴミ袋もあると助かる」"
msgstr "\"Well, you know, I've been wanting to clean things up a little. I could use some trash bags, too.\""

#. Occurrence 7_1:6374:8873: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_1_0002; voice_prefix=B10; voice_category=5; scene=7_1
#: 7_1:6374
msgctxt "text_id=8873 | speaker=kojika"
msgid "「無駄な出費はできないって言ってたクセに。"
msgstr "\"Aren't you supposed to be broke or something?"

#. Occurrence 7_1:6380:8874: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_1_0003; voice_prefix=B10; voice_category=5; scene=7_1
#: 7_1:6380
msgctxt "text_id=8874 | speaker=kojika"
msgid "　ま、どうでもいいけど。うちのでよければ使う？　貸してあげましょうか？」"
msgstr "  Whatever. Wanna use my broom then? I'll lend it to you if you want.\""

#. Occurrence 7_1:6391:8875: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0029; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:6391
msgctxt "text_id=8875 | speaker=soujuurou"
msgid "「たぶん一日じゃ終わらないから自分で買うよ。"
msgstr "\"Actually... I need it for longer than one day, so maybe it's best I buy my own."

#. Occurrence 7_1:6397:8876: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0030; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:6397
msgctxt "text_id=8876 | speaker=soujuurou"
msgid "　もとから欲しかったものだし。あると便利だよ、箒」"
msgstr "  I mean, I always wanted my own broom. Brooms are nice to have around, you know?\""

#. Occurrence 7_1:6449:8877: scene=7_1
#: 7_1:6449
msgctxt "text_id=8877 | speaker=unknown"
msgid "　学校が終わってから、アルバイトの帰り道。"
msgstr "  Soujyuro was on his way home from his part-time job after school."

#. Occurrence 7_1:6467:8878: scene=7_1
#: 7_1:6467
msgctxt "text_id=8878 | speaker=unknown"
msgid "　時刻はバイト終了時間から二時間ほど早い午後四時。"
msgstr "  It was four in the afternoon, two hours earlier than his part-time job would have normally ended."

#. Occurrence 7_1:6472:8879: scene=7_1
#: 7_1:6472
msgctxt "text_id=8879 | speaker=unknown"
msgid "　試験前日に学生を拘束するとは何事か、とお店の会計係に叱られたまっどべあ料理長は泣く泣く草十郎を送りだしてくれた。"
msgstr "  The Mad Bear's head chef had gotten in trouble with the accountant for making a student work the day before exams. Thus, Soujyuro's boss had tearfully sent him home early."

#. Occurrence 7_1:6491:8880: scene=7_1
#: 7_1:6491
msgctxt "text_id=8880 | speaker=unknown"
msgid "　そして。"
msgstr "  And that is when it happened."

#. Occurrence 7_1:6496:8881: scene=7_1
#: 7_1:6496
msgctxt "text_id=8881 | speaker=unknown"
msgid "　この二時間のタイムラグこそが、草十郎の明暗を分けるのだ。多分。"
msgstr "  The interruption to his standard schedule must have been just the shock he needed."

#. Occurrence 7_1:6530:8882: scene=7_1
#: 7_1:6530
msgctxt "text_id=8882 | speaker=unknown"
msgid "　本来の予定では、草十郎は生徒会の作業を終えてから下校する青子と合流し、久遠寺邸に向かわなければならない。"
msgstr "  Normally, he would meet up with Aoko after she was done with student council affairs and go home with her."

#. Occurrence 7_1:6551:8883: scene=7_1
#: 7_1:6551
msgctxt "text_id=8883 | speaker=unknown"
msgid "　が、何を思ったか草十郎はバイト仲間の同期生に、この近くで竹箒を売っている店はないかと訊ねていた。"
msgstr "  However, today, Soujyuro was asking the other students who worked at the same place if they knew any shops in the area where he could buy a broom."

#. Occurrence 7_1:6584:8884: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_1_0004; voice_prefix=B10; voice_category=5; scene=7_1
#: 7_1:6584
msgctxt "text_id=8884 | speaker=kojika"
msgid "「田舎者の趣味って理解不能ね。<酔狂|すいきょう>すぎ。"
msgstr "\"God, what's wrong with you? People from the countryside are like, so weird."

#. Occurrence 7_1:6590:8885: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_1_0005; voice_prefix=B10; voice_category=5; scene=7_1
#: 7_1:6590
msgctxt "text_id=8885 | speaker=kojika"
msgid "　<三咲高|うち>の近くにまっずいラーメン屋あるでしょ。あそこの通りを終わりまで行けば沖田って<金物|かなもの>店がある。"
msgstr "  Anyway... You know that nasty ramen place near school? Just go to the end of that street and there's a hardware store called Okita."

#. Occurrence 7_1:6597:8886: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_1_0006; voice_prefix=B10; voice_category=5; scene=7_1
#: 7_1:6597
msgctxt "text_id=8886 | speaker=kojika"
msgid "一式揃えるなら西口のホームセンターより安くあがるわ。"
msgstr "It's way cheaper than the home supply store to the west of the station, as long as they have what you want, anyway."

#. Occurrence 7_1:6618:8887: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_1_0007; voice_prefix=B10; voice_category=5; scene=7_1
#: 7_1:6618
msgctxt "text_id=8887 | speaker=kojika"
msgid "　……どうでもいいけど、わたしの<自転車|チャリ>使う？　どうせ試験明けまで使わないし」"
msgstr "  Use my bicycle if you want, I don't care. I won't need it until exams are over anyway.\""

#. Occurrence 7_1:6652:8888: scene=7_1
#: 7_1:6652
msgctxt "text_id=8888 | speaker=unknown"
msgid "　思わぬ助け船に目を輝かせるが、久遠寺邸までの坂道を自転車で、しかも荷物を抱えて走るのは難しそうだ。"
msgstr "  Soujyuro's eyes lit up as if he had met his savior. But biking uphill to the mansion, let alone with a package to carry, was not a pretty thought."

#. Occurrence 7_1:6663:8889: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0031; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:6663
msgctxt "text_id=8889 | speaker=soujuurou"
msgid "「いや、自転車には乗ってみたいけど、今回は遠慮するよ。じゃあまた明日、学校で」"
msgstr "\"I appreciate the offer, but I'll pass. See you at school tomorrow!\""

#. Occurrence 7_1:6700:8890: scene=7_1
#: 7_1:6700
msgctxt "text_id=8890 | speaker=unknown"
msgid "　少女に礼を言って金物店に向かう。"
msgstr "  Saying farewell to his co-workers he headed to the hardware store."

#. Occurrence 7_1:6710:8891: scene=7_1
#: 7_1:6710
msgctxt "text_id=8891 | speaker=unknown"
msgid "　目的は安くて丈夫な竹箒と、大型のチリ取り。"
msgstr "  He needed a cheap and sturdy bamboo broom and a large dustpan to go with it."

#. Occurrence 7_1:6715:8892: scene=7_1
#: 7_1:6715
msgctxt "text_id=8892 | speaker=unknown"
msgid "　できれば台車や添え木用の棒もほしい、といざ考えだすと色々なものが欲しい草十郎だった。"
msgstr "  If possible, a pushcart and stick for a splint would have been nice, too. As it happened, Soujyuro wanted quite a few things."

#. Occurrence 7_1:6753:8893: scene=7_1
#: 7_1:6753
msgctxt "text_id=8893 | speaker=unknown"
msgid "　<午睡|ごすい>から目を覚ますと、少女は作業を再開した。"
msgstr "  Alice returned to her work after waking from her nap."

#. Occurrence 7_1:6786:8894: scene=7_1
#: 7_1:6786
msgctxt "text_id=8894 | speaker=unknown"
msgid "　久遠寺邸には別館があり、その内部は図書室になっている。"
msgstr "  The Kuonji Estate had an annex that housed a library."

#. Occurrence 7_1:6791:8895: scene=7_1
#: 7_1:6791
msgctxt "text_id=8895 | speaker=unknown"
msgid "　少女の母から受け継いだ書物を収蔵したそこは、同居人である蒼崎青子も立ち入る事を<躊躇|ちゅうちょ>する領域だ。"
msgstr "  The library was filled with books handed down to her from her mother, so it was Alice's territory such that even Aoko dared not enter."

#. Occurrence 7_1:6796:8896: scene=7_1
#: 7_1:6796
msgctxt "text_id=8896 | speaker=unknown"
msgid "　久遠寺邸が時代に取り残された魔女の館なら、"
msgstr "  If the mansion was a witch's abode, left behind by the times,"

#. Occurrence 7_1:6801:8897: scene=7_1
#: 7_1:6801
msgctxt "text_id=8897 | speaker=unknown"
msgid "　この図書室は時代に忘れ去られた<御伽|おとぎ>の部屋。"
msgstr "  the library was a fairy-tale quarters, lost to the ages."

#. Occurrence 7_1:6806:8898: scene=7_1
#: 7_1:6806
msgctxt "text_id=8898 | speaker=unknown"
msgid "　童話を操る幼い魔女からすれば、必然、相性の良い聖域と言える。"
msgstr "  It was a natural sanctuary for the young witch who could command Ploys to do her bidding."

#. Occurrence 7_1:6864:8899: scene=7_1
#: 7_1:6864
msgctxt "text_id=8899 | speaker=unknown"
msgid "　少女は記憶を頼りに本棚を巡っていく。"
msgstr "  She relied on her memory to recall the location of each book on the many shelves."

#. Occurrence 7_1:6869:8900: scene=7_1
#: 7_1:6869
msgctxt "text_id=8900 | speaker=unknown"
msgid "　……と。"
msgstr "  And then she saw it."

#. Occurrence 7_1:6880:8901: scene=7_1
#: 7_1:6880
msgctxt "text_id=8901 | speaker=unknown"
msgid "　なんとなしに顔を上げた時、おかしな風景を見てしまった。"
msgstr "  Upon raising her head she was met with the most unusual of sights."

#. Occurrence 7_1:6914:8902: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0025; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:6914
msgctxt "text_id=8902 | speaker=alice"
msgid "「…………」"
msgstr "\"...\""

#. Occurrence 7_1:6920:8903: scene=7_1
#: 7_1:6920
msgctxt "text_id=8903 | speaker=unknown"
msgid "　優美な眉が不満げに寄せられる。"
msgstr "  Her elegant eyebrows bristled in distaste."

#. Occurrence 7_1:6930:8904: scene=7_1
#: 7_1:6930
msgctxt "text_id=8904 | speaker=unknown"
msgid "　その後の予定は、なにひとつ守れなかった。"
msgstr "  From that moment on, she failed to accomplish anything she had planned for that day."

#. Occurrence 7_1:6935:8905: scene=7_1
#: 7_1:6935
msgctxt "text_id=8905 | speaker=unknown"
msgid "　少女は日が暮れるまで眉のカタチを変えず、じっと、窓の外のおかしな景色を眺めていたからだ。"
msgstr "  She was instead forced to stare at the strange sight outside her window, eyebrows fixed in that position until the sun set."

#. Occurrence 7_1:7026:8906: scene=7_1
#: 7_1:7026
msgctxt "text_id=8906 | speaker=unknown"
msgid "　―――とまあ。"
msgstr "  Ah well."

#. Occurrence 7_1:7032:8907: scene=7_1
#: 7_1:7032
msgctxt "text_id=8907 | speaker=unknown"
msgid "　丘の上の洋館で寝泊りするようになっても、草十郎の日常に、とりわけ大きな変化は訪れなかった。"
msgstr "  Moving into the grand mansion on the hill had not brought any major changes to Soujyuro's day-to-day schedule."

#. Occurrence 7_1:7052:8908: scene=7_1
#: 7_1:7052
msgctxt "text_id=8908 | speaker=unknown"
msgid "　起床、"
msgstr "  He woke up,"

msgctxt "text_id=8909 | speaker=unknown"
msgid "アルバイト、"
msgstr " went to his part-time job,"

msgctxt "text_id=8910 | speaker=unknown"
msgid "朝食、"
msgstr " ate breakfast,"

msgctxt "text_id=8911 | speaker=unknown"
msgid "登校。"
msgstr " and went to school."

#. Occurrence 7_1:7106:8912: scene=7_1
#: 7_1:7106
msgctxt "text_id=8912 | speaker=unknown"
msgid "　慣れない授業、"
msgstr "  Classes came and went, still strange and new,"

msgctxt "text_id=8913 | speaker=unknown"
msgid "数少ない憩いの休み時間、"
msgstr " broken up by rare and brief moments of rest,"

msgctxt "text_id=8914 | speaker=unknown"
msgid "放課後。"
msgstr " until the school day ended."

#. Occurrence 7_1:7147:8915: scene=7_1
#: 7_1:7147
msgctxt "text_id=8915 | speaker=unknown"
msgid "　下校、"
msgstr "  He left school,"

msgctxt "text_id=8916 | speaker=unknown"
msgid "アルバイト、"
msgstr " went to his part-time job,"

msgctxt "text_id=8917 | speaker=unknown"
msgid "仮眠、"
msgstr " slept,"

msgctxt "text_id=8918 | speaker=unknown"
msgid "起床、"
msgstr " woke up,"

msgctxt "text_id=8919 | speaker=unknown"
msgid "試験勉強。"
msgstr " and studied for exams."

#. Occurrence 7_1:7240:8920: scene=7_1
#: 7_1:7240
msgctxt "text_id=8920 | speaker=unknown"
msgid "　ささやかな少年のささやかな日常は、本人の努力とは正反対に、<為|な>す<術|すべ>なく流れていく。"
msgstr "  A modest life for a modest young man, continuing every day in the same fashion despite his best efforts to change his fortune."

#. Occurrence 7_1:7260:8921: scene=7_1
#: 7_1:7260
msgctxt "text_id=8921 | speaker=unknown"
msgid "　状況は一向に変わらない。"
msgstr "  But nothing ever really changes."

#. Occurrence 7_1:7265:8922: scene=7_1
#: 7_1:7265
msgctxt "text_id=8922 | speaker=unknown"
msgid "　館内では頻繁に青子が隣にいたり、"
msgstr "  Whether Aoko was by his side in the mansion, as was frequently the case,"

#. Occurrence 7_1:7270:8923: scene=7_1
#: 7_1:7270
msgctxt "text_id=8923 | speaker=unknown"
msgid "　眠る前に有珠の用意した薬を飲まされたりするのも同じ。"
msgstr "  or whether Alice was making him drink some potion she prepared before going to bed."

#. Occurrence 7_1:7276:8924: scene=7_1
#: 7_1:7276
msgctxt "text_id=8924 | speaker=unknown"
msgid "　前者は草十郎の安全を考慮した青子のフォローであり、"
msgstr "  The former was an attempt by Aoko to make him feel better,"

#. Occurrence 7_1:7281:8925: scene=7_1
#: 7_1:7281
msgctxt "text_id=8925 | speaker=unknown"
msgid "　後者は、理屈は分からないが、やっぱり彼の安全のためだという。"
msgstr "  the latter was some attempt to keep him safe, even if he did not fully appreciate it."

#. Occurrence 7_1:7328:8926: scene=7_1
#: 7_1:7328
msgctxt "text_id=8926 | speaker=unknown"
msgid "　そして。今朝も今朝とて何の変化もない状況に頭を悩ませつつ、草十郎は朝の紅茶を淹れていた。"
msgstr "  Then, one day, a day like any other, while Soujyuro was pouring himself some tea as he worried over the lack of change in his life..."

#. Occurrence 7_1:7335:8927: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_1_0032; voice_prefix=A30; voice_category=3; scene=7_1
#: 7_1:7335
msgctxt "text_id=8927 | speaker=soujuurou"
msgid "「…………ああ、そう言えば」"
msgstr "\"...Oh, by the way.\""

#. Occurrence 7_1:7341:8928: scene=7_1
#: 7_1:7341
msgctxt "text_id=8928 | speaker=unknown"
msgid "　有珠との関係に変化はないが、大きな変化はここにある。草十郎の朝の一服は、煎茶から紅茶に変わっていた。"
msgstr "  His relationship with Alice was the same as ever, but there was one major change this morning-he was drinking black tea instead of green."

#. Occurrence 7_1:7373:8929: scene=7_1
#: 7_1:7373
msgctxt "text_id=8929 | speaker=unknown"
msgid "　台所には様々な紅茶の葉があるが、ビギナーである草十郎には無用の長物だ。"
msgstr "  Though there were all sorts of different types of tea to be found in the kitchen, a newcomer to the world of tea like Soujyuro could not tell one of them from the next."

#. Occurrence 7_1:7379:8930: scene=7_1
#: 7_1:7379
msgctxt "text_id=8930 | speaker=unknown"
msgid "　彼の用意する紅茶は当然ティーバッグで、自分用に一杯<淹|い>れて<食卓|サンルーム>に移動する。"
msgstr "  Naturally his tea-making skills were limited to tea bags, one of which he placed in his cup before returning to the dining table."

#. Occurrence 7_1:7399:8931: scene=7_1
#: 7_1:7399
msgctxt "text_id=8931 | speaker=unknown"
msgid "　テーブルには先客が二名。"
msgstr "  Alice and Aoko were already seated."

#. Occurrence 7_1:7404:8932: scene=7_1
#: 7_1:7404
msgctxt "text_id=8932 | speaker=unknown"
msgid "　青子と有珠は無言で朝食を<摂|と>っている。"
msgstr "  The two were eating in silence."

#. Occurrence 7_1:7410:8933: scene=7_1
#: 7_1:7410
msgctxt "text_id=8933 | speaker=unknown"
msgid "　久遠寺邸において、朝食は完全個人主義だ。"
msgstr "  In this household it was everyone for themselves when it came to breakfast."

#. Occurrence 7_1:7415:8934: scene=7_1
#: 7_1:7415
msgctxt "text_id=8934 | speaker=unknown"
msgid "　ふたりの朝食は<婉曲|えんきょく>に言えば質素な―――真実を言うと用意に二秒もかからない、堅そうな石窯パン一つきりである。"
msgstr "  The diplomatic description of their breakfasts would be \"simple.\" The more accurate description would be \"two slices of stale bread prepared in seconds.\""

#. Occurrence 7_1:7449:8935: scene=7_1
#: 7_1:7449
msgctxt "text_id=8935 | speaker=unknown"
msgid "　青子たちは<時折|ときおり>言葉を交わすと、最後に紅茶を一口だけ<啜|すす>って席を立つ。"
msgstr "  Aoko exchanged a word or two with Alice, took a sip of tea, and stood up from her seat."

#. Occurrence 7_1:7460:8936: scene=7_1
#: 7_1:7460
msgctxt "text_id=8936 | speaker=unknown"
msgid "　有珠はもう高校が冬休みに入っているのでそのまま自室へ戻り、"
msgstr "  Since it was winter break for the high-schooler Alice, she returned to her room after eating as she normally did,"

msgctxt "text_id=8937 | speaker=unknown"
msgid "青子はこれから学校なので鞄を片手に玄関へ。"
msgstr " while Aoko headed to the front door, shoes in hand, ready for school."

#. Occurrence 7_1:7479:8938: scene=7_1
#: 7_1:7479
msgctxt "text_id=8938 | speaker=unknown"
msgid "　草十郎も食器を片づけた後、青子の後を追って洋館を後にする。"
msgstr "  After hurriedly clearing the table, Soujyuro rushed out the door after Aoko."

#. Occurrence 7_1:7484:8939: scene=7_1
#: 7_1:7484
msgctxt "text_id=8939 | speaker=unknown"
msgid "　ふたりは長い坂を下りて学校へ。"
msgstr "  Together they walked down the long hill in the direction of school."

#. Occurrence 7_1:7513:8940: scene=7_1
#: 7_1:7513
msgctxt "text_id=8940 | speaker=unknown"
msgid "　三日間はこんな風に、実に簡潔に過ぎてしまった。"
msgstr "  They had spent three days following this very simple routine."

#. Occurrence 7_1:7559:8941: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0036; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:7559
msgctxt "text_id=8941 | speaker=aoko"
msgid "「ところで、あれから動きはあった？」"
msgstr "\"So, any word on you-know-who?\""

#. Occurrence 7_1:7583:8942: scene=7_1
#: 7_1:7583
msgctxt "text_id=8942 | speaker=unknown"
msgid "　授業も終えた夕刻時。"
msgstr "  School had ended, and evening had arrived."

#. Occurrence 7_1:7588:8943: scene=7_1
#: 7_1:7588
msgctxt "text_id=8943 | speaker=unknown"
msgid "　青子の問いに、有珠は掴んだバターロールもそのままに、首を横に振るだけで『いいえ』と答えた。"
msgstr "  Buttered bread roll in one hand, Alice replied with a simple, silent shake of her head."

#. Occurrence 7_1:7610:8944: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0037; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:7610
msgctxt "text_id=8944 | speaker=aoko"
msgid "「そう。なら、<敵側|あっち>も次の手を考えているんでしょうね。"
msgstr "\"Thought so. The enemy must be considering their next move too."

#. Occurrence 7_1:7610:8945: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0037; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:7610
msgctxt "text_id=8945 | speaker=aoko"
msgid "　魔術師本体の居場所は見当ついてる？」"
msgstr "  Have you figured out where the mage is?\""

#. Occurrence 7_1:7631:8946: scene=7_1
#: 7_1:7631
msgctxt "text_id=8946 | speaker=unknown"
msgid "　返答はまったく同じ。"
msgstr "  Her response was exactly the same."

#. Occurrence 7_1:7653:8947: scene=7_1
#: 7_1:7653
msgctxt "text_id=8947 | speaker=unknown"
msgid "　落胆した風もなく、青子はバターロールを一口噛んでからサラダにフォークを突き刺した。"
msgstr "  Without showing the slightest sign of dejection she continued to chew the roll and took a stab at her salad."

#. Occurrence 7_1:7681:8948: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0038; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:7681
msgctxt "text_id=8948 | speaker=aoko"
msgid "「そ。私も試験が終わったら手伝うから、それまで悪いけどひとりでやってて。今日からあのバカを一夜漬けにしなくちゃいけないんで、余裕ないの」"
msgstr "\"Okay then. I'll help you once exams are over if you can manage on your own till then. I have to help that idiot study so my schedule is pretty warped.\""

#. Occurrence 7_1:7704:8949: scene=7_1
#: 7_1:7704
msgctxt "text_id=8949 | speaker=unknown"
msgid "　それには思うところがあるのか、有珠はわずかに顔を曇らせた。"
msgstr "  Alice's face grew dour as if she had something to get off her chest."

#. Occurrence 7_1:7740:8950: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0039; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:7740
msgctxt "text_id=8950 | speaker=aoko"
msgid "「？　問題ないでしょ、有珠はもう休みに入ってるんだから。一日ぜんぶ使えるじゃない」"
msgstr "\"Don't give me that look. You're on winter break, you can spend all day working on it, can't you?\""

#. Occurrence 7_1:7778:8951: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0026; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:7778
msgctxt "text_id=8951 | speaker=alice"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 7_1:7783:8952: scene=7_1
#: 7_1:7783
msgctxt "text_id=8952 | speaker=unknown"
msgid "　たしかに有珠は冬休み中で、一日のすべてを魔術師としての生活に<費|つい>やしている。"
msgstr "  Alice was indeed on vacation and could spend all day every day on her work as a mage."

#. Occurrence 7_1:7788:8953: scene=7_1
#: 7_1:7788
msgctxt "text_id=8953 | speaker=unknown"
msgid "　ただ、ここ数日はある理由で図書室に籠もりきりだった。"
msgstr "  Yet she had spent the past few days holed up in the library instead."

#. Occurrence 7_1:7793:8954: scene=7_1
#: 7_1:7793
msgctxt "text_id=8954 | speaker=unknown"
msgid "　青子の言う“挑戦者への対策”に徹していたワケでもない。"
msgstr "  She was hardly devoting herself to \"dealing with the challenger,\" as Aoko put it."

#. Occurrence 7_1:7839:8955: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_1_0040; voice_prefix=A10; voice_category=1; scene=7_1
#: 7_1:7839
msgctxt "text_id=8955 | speaker=aoko"
msgid "「有珠？　聞いてる？」"
msgstr "\"Alice? Are you listening?\""

#. Occurrence 7_1:7872:8956: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_1_0027; voice_prefix=A40; voice_category=2; scene=7_1
#: 7_1:7872
msgctxt "text_id=8956 | speaker=alice"
msgid "「……分かってる。今夜から、そっちもやるから」"
msgstr "\"Yes. I'll get to work on it tonight.\""

#. Occurrence 7_1:7883:8957: scene=7_1
#: 7_1:7883
msgctxt "text_id=8957 | speaker=unknown"
msgid "　ため息まじりに返答して席を立つ。"
msgstr "  Sighing, she stood up."

#. Occurrence 7_1:7914:8958: scene=7_1
#: 7_1:7914
msgctxt "text_id=8958 | speaker=unknown"
msgid "　……何が気になって、何が言いたかったのか。"
msgstr "  What was bothering Alice, and what was it she wanted to say?"

#. Occurrence 7_1:7919:8959: scene=7_1
#: 7_1:7919
msgctxt "text_id=8959 | speaker=unknown"
msgid "　ほんの二時間前、彼女が何をしていたのか。"
msgstr "  What had she been doing only two hours earlier?"

#. Occurrence 7_1:7935:8960: scene=7_1
#: 7_1:7935
msgctxt "text_id=8960 | speaker=unknown"
msgid "　それらの出来事を飲みこんで、有珠は食卓から去っていった。"
msgstr "  The young witch took her leave from the breakfast table without offering a single clue."

msgctxt "text_id=8961 | speaker=unknown"
msgid "　その、二時間前の話―――"
msgstr "  Two hours earlier..."

msgctxt "text_id=8962 | speaker=unknown"
msgid "　眠りに落ちて見る夢は、"
msgstr "  Her dreams at night often involved"

msgctxt "text_id=8963 | speaker=unknown"
msgid "　たいてい、幼い頃の記憶だった。"
msgstr "  memories from when she was young."

msgctxt "text_id=8964 | speaker=unknown"
msgid "　イングランドの北西部。"
msgstr "  In the northeast of England,"

msgctxt "text_id=8965 | speaker=unknown"
msgid "　深い霧に覆われたオークの森。"
msgstr "  there was a misty oak forest."

msgctxt "text_id=8966 | speaker=unknown"
msgid "　二十世紀にあっても人を寄せ付けない、鳥と獣たちの王国。"
msgstr "  This was a land of birds and beasts, a land untouched by the modern era, where no human dared to enter."

msgctxt "text_id=8967 | speaker=unknown"
msgid "　その一角に、彼女の生まれ育った家があった。"
msgstr "  There, deep within the woods, was the home where she was born and raised."

msgctxt "text_id=8968 | speaker=unknown"
msgid "　何代と続いてきた古い生き物。"
msgstr "  The woods were an ancient creature unto themselves, existing for generations."

msgctxt "text_id=8969 | speaker=unknown"
msgid "　偉大な、あるいは愚かな先祖の言いつけ通り、かたくなに純潔を守り続けた、原初の魔女の<末裔|まつえい>たち。"
msgstr "  Her venerable-or perhaps foolish-ancestors had insisted on maintaining its purity, passing this tradition of the First Witches down to their descendants."

msgctxt "text_id=8970 | speaker=unknown"
msgid "　先代たちがどれほどの年月を重ねてきたのか、少女は正確に把握していない。"
msgstr "  Alice did not know for certain how far back her family line extended."

msgctxt "text_id=8971 | speaker=unknown"
msgid "　少女の母までは確かに伝わっていたが、少女には<口伝|くでん>でしか教えられなかった。"
msgstr "  This knowledge had been passed down the generations without fail until her mother, but Alice only knew what she'd been taught via oral tradition."

msgctxt "text_id=8972 | speaker=unknown"
msgid "　だから、彼女たちがその土地に根を下ろしてどれほどの年月が経っていたのか、知るものはもう誰もいない。"
msgstr "  Thus, no one alive knew exactly when those first women made those woods their home."

msgctxt "text_id=8973 | speaker=unknown"
msgid "　伝統はすっかり<剥|は>がれ落ちて、"
msgstr "  The traditions had been forgotten,"

msgctxt "text_id=8974 | speaker=unknown"
msgid "　角をいただいた白馬も、"
msgstr "  and by the time she was born"

msgctxt "text_id=8975 | speaker=unknown"
msgid "　虹色にはばたく鳥も、"
msgstr "  there were no horned white horses,"

msgctxt "text_id=8976 | speaker=unknown"
msgid "　少女が生まれた時には影も形も見あたらなかった。"
msgstr "  no rainbow-colored birds flying in the sky."

msgctxt "text_id=8977 | speaker=unknown"
msgid "　代わりにあるものと言えば、少女の家には不釣り合いな、近代的な家具の数々だった。"
msgstr "  Instead, what she had was a collection of modern furniture."

msgctxt "text_id=8978 | speaker=unknown"
msgid "　それらは森の空気にも少女の肌にも合わなかったが、決して不快なものではなかったと憶えている。"
msgstr "  Furniture that was neither befitting those woods' legacy, nor the rooms it sat in. And though their fabric was far too rough for a young woman's skin, still they were not wholly uncomfortable to sit on."

msgctxt "text_id=8979 | speaker=unknown"
msgid "　時代遅れの母と、"
msgstr "  The collection was her inheritance granted to her mother and then to her,"

msgctxt "text_id=8980 | speaker=unknown"
msgid "　時代遅れの自分に贈られた記念品。"
msgstr "  both old-fashioned women from a bygone era."

msgctxt "text_id=8981 | speaker=unknown"
msgid "　それらに愛情を抱いたのは、"
msgstr "  She knew the furniture had been a gift from a man from nearby Manchester who visited her mother once a week,"

msgctxt "text_id=8982 | speaker=unknown"
msgid "　一週間に一度、<近くの都市|マンチェスター>からやってくる男性からの贈り物である事を、子供心に分かっていたからだろう。"
msgstr "  and this pleased her somehow in a childlike way, stoking her sense of nostalgia."

msgctxt "text_id=8983 | speaker=unknown"
msgid "　……それも、今では失われた。"
msgstr "  Indeed, only nostalgia and old furniture remained."

msgctxt "text_id=8984 | speaker=unknown"
msgid "　きらきら光る運転手付きの<高級車|キャデラック>も、"
msgstr "  No sparkling Cadillac with a chauffeur,"

msgctxt "text_id=8985 | speaker=unknown"
msgid "　お城のような<花園|ガーデン>も、"
msgstr "  no gardens grand enough for a castle,"

msgctxt "text_id=8986 | speaker=unknown"
msgid "　たくさんの大人たちも、"
msgstr "  and no adults filling the space with life."

msgctxt "text_id=8987 | speaker=unknown"
msgid "　<霧|きり>のように消えてしまった。"
msgstr "  They had all disappeared like the mist."

msgctxt "text_id=8988 | speaker=unknown"
msgid "　あるいは、霧の中に消えてしまった。"
msgstr "  ...Or perhaps they disappeared into the mist."

msgctxt "text_id=8989 | speaker=unknown"
msgid "　幸せに満ちた母の笑顔も、"
msgstr "  No longer could Alice see the smiling faces of her parents, her mother's filled with happiness"

msgctxt "text_id=8990 | speaker=unknown"
msgid "　はにかむような父の笑顔もない。"
msgstr "  and her father's sweet as a honeycomb."

msgctxt "text_id=8991 | speaker=unknown"
msgid "　そんなもの、初めから森が<赦|ゆる>しはしなかったのだ。"
msgstr "  The woods had prohibited such things from her earliest days."

msgctxt "text_id=8992 | speaker=unknown"
msgid "　……今はただ、疑問だけが残っている。"
msgstr "  ...All that remained were hazy doubts."

msgctxt "text_id=8993 | speaker=unknown"
msgid "　洋館には不釣り合いだった数々の異物。"
msgstr "  Still, countless oddities around the mansion remained."

msgctxt "text_id=8994 | speaker=unknown"
msgid "　何ひとつ自分が望んだわけではない高級品。"
msgstr "  There were priceless items which she had never wished for."

msgctxt "text_id=8995 | speaker=unknown"
msgid "　ただ<厭|いや>らしいだけの贈り物。"
msgstr "  Gifts, which only served to irritate her."

msgctxt "text_id=8996 | speaker=unknown"
msgid "　それを、あんなにも<愛|いと>おしく<触|ふ>れていたのは、一体どんな気の迷いだったのか―――"
msgstr "  How could she have ever handled them so fondly? Alice found herself unable to relate to her former self."

msgctxt "text_id=8997 | speaker=unknown"
msgid "「――――――」"
msgstr "\"...\""

msgctxt "text_id=8998 | speaker=unknown"
msgid "　閉じられた<目蓋|まぶた>がかすかに動く。"
msgstr "  Her closed eyelids fluttered."

msgctxt "text_id=8999 | speaker=unknown"
msgid "　日が<翳|かげ>りだす前の午後。"
msgstr "  It was afternoon, the sun still hiding behind clouds."

msgctxt "text_id=9000 | speaker=unknown"
msgid "　少女は自分の耳ではなく、館が聞き届けた音に反応して、うっすらと意識を起こした。"
msgstr "  She was called back to the waking world, not by the sound her own ears could hear, but by the mansion reacting to it."

msgctxt "text_id=9001 | speaker=unknown"
msgid "　辛そうに目蓋を押さえる少女を気遣ってか、鳴き声をあげる青い小鳥。"
msgstr "  A small bluish bird piped up, perhaps worried by the painful-looking way she squeezed her eyes shut."

msgctxt "text_id=9002 | speaker=unknown"
msgid "　少女はぼんやりとした目で、"
msgstr "  Her vision was still blurred with sleep."

msgctxt "text_id=9003 | speaker=unknown"
msgid "「……不思議ね。ずっと昔の、鳥の夢を見たわ」"
msgstr "\"How odd. You look just like a bird I met in my dreams once upon a time.\""

msgctxt "text_id=9004 | speaker=unknown"
msgid "　薄れていく夢の<内容|きおく>に<縋|すが>るように、独り言を口にした。"
msgstr "  Speaking these words, she felt the details of her dream fading."

msgctxt "text_id=9005 | speaker=unknown"
msgid "　鳥と聞いて、我が事のようにはしゃぐ駒鳥。"
msgstr "  The robin frolicked, as if proud to be the bird of which she spoke."

msgctxt "text_id=9006 | speaker=unknown"
msgid "「……安心して。ほとんど覚えていないけど、貴方じゃない事だけは確かだから。"
msgstr "\"Don't worry. I can scarcely recall the dream now, but I know it wasn't you I dreamt of."

msgctxt "text_id=9007 | speaker=unknown"
msgid "　それよりこの音、なに？」"
msgstr "  ...And what's making that noise?\""

msgctxt "text_id=9008 | speaker=unknown"
msgid "　<肩|はね>を落としてがっかりする駒鳥に、少女は冷たい目のまま追及する。"
msgstr "  She stared coldly at the now disappointed bird as she demanded her answer."

msgctxt "text_id=9009 | speaker=unknown"
msgid "　……彼女が目を覚ました原因。"
msgstr "  Then, she realized what had drawn her out of her slumber."

msgctxt "text_id=9010 | speaker=unknown"
msgid "　館の裏庭の方から響く、<耳障|みみざわ>りな雑音について。"
msgstr "  It was the grating noise ringing out from the mansion's rear courtyard."

msgctxt "text_id=9011 | speaker=unknown"
msgid "　裏庭からの雑音がなんなのか熟知していた駒鳥は、胸を張って主人に報告する。"
msgstr "  The robin had detected the clamor, and come to alert the head of household."

msgctxt "text_id=9012 | speaker=unknown"
msgid "　聞いて。少女の眠気は、今度こそ霧散した。"
msgstr "  She listened. And all at once her grogginess vanished without a trace."

msgctxt "text_id=9013 | speaker=unknown"
msgid "「…………そう。<目障|めざわ>りなだけでなく、<耳障|みみざわ>りにまでさせてくれるのね、彼」"
msgstr "\"Ah yes. He's not only hard on the eyes, but also on the ears, it seems.\""

msgctxt "text_id=9014 | speaker=unknown"
msgid "　つまらなげに漏らした言葉は、魔女としての責務とはまた違う、いわれのない個人的な<感情|いらだち>を含んでいた。"
msgstr "  Her disinterested remark had less to do with her position as resident witch, than with her irrational irritation."

msgctxt "text_id=9015 | speaker=unknown"
msgid "　長らく使われていなかったポンプが、ギッコギッコと音を立てる。"
msgstr "  A long-unused pump was the source of the ruckus."

msgctxt "text_id=9016 | speaker=unknown"
msgid "　久遠寺邸の裏庭。"
msgstr "  There, in the Kuonji Estate's courtyard..."

msgctxt "text_id=9017 | speaker=unknown"
msgid "　じき日没を迎える森には<痩身|そうしん>の人影があった。"
msgstr "  A slim silhouette was visible against the trees, as the day crept closer to sundown."

msgctxt "text_id=9018 | speaker=unknown"
msgid "　人影はきょろきょろと森を見渡しながら、草むらに埋もれたビニール袋や不法投棄された自転車を片付けたり、まれに、折れかかった木の枝などを補強したり、ひと思いに伐採などしていたりする。"
msgstr "  Glancing furtively around the trees, the figure was gathering everything from plastic bags to an illegally abandoned bicycle. At times, the figure attempted to mend broken tree branches, while at other times he resolutely pruned them."

msgctxt "text_id=9019 | speaker=unknown"
msgid "「む、これはひどい」"
msgstr "\"Hrm. What a mess.\""

msgctxt "text_id=9020 | speaker=unknown"
msgid "　おそらく洋館に住んでいる人物、どちらかの手によるものだろう。"
msgstr "  It was surely the fault of one of the two roommates."

msgctxt "text_id=9021 | speaker=unknown"
msgid "　館の物置に放置されたゴミ袋が野犬によってここまで運ばれ、無惨に食い散らかされていた。"
msgstr "  Wild dogs had gotten into the mansion's storage shed, torn open some trash bags, and made an enormous mess."

msgctxt "text_id=9022 | speaker=unknown"
msgid "　彼は持参した竹箒を片手に、黙々とゴミを片づける。"
msgstr "  Bamboo broom in hand, Soujyuro set himself to silently tidying things up."

msgctxt "text_id=9023 | speaker=unknown"
msgid "「………………」"
msgstr "\"...\""

msgctxt "text_id=9024 | speaker=unknown"
msgid "　有珠は散歩中という<体|てい>で、その人影に出くわした。"
msgstr "  Alice approached the figure on the pretense of taking a morning walk."

msgctxt "text_id=9025 | speaker=unknown"
msgid "　<一月|ひとつき>に一度あるかないかの森の散歩が今である理由は、あえて語るまでもない。"
msgstr "  She took such walks once a month at most, but she had special reason for taking this one."

msgctxt "text_id=9026 | speaker=unknown"
msgid "「静希君」"
msgstr "\"Sizuki.\""

msgctxt "text_id=9027 | speaker=unknown"
msgid "「こんにちは。今から外出？」"
msgstr "\"Hello. Are you going out?\""

msgctxt "text_id=9028 | speaker=unknown"
msgid "　気軽に挨拶など返される。"
msgstr "  He replied casually."

msgctxt "text_id=9029 | speaker=unknown"
msgid "　有珠は努めて視線を冷たくして、森の様子を観察した。"
msgstr "  Alice surveyed the trees around her with as cold a gaze as she could muster."

msgctxt "text_id=9030 | speaker=unknown"
msgid "「出かけないわ。"
msgstr "\"No, I'm not going anywhere."

msgctxt "text_id=9031 | speaker=unknown"
msgid "そういう貴方は何を？　青子と一緒に帰ってくるものと思っていたけど、青子は？」"
msgstr "And what, may I ask, are you doing out here? I thought you would be coming home from school with Aoko later. Where is she?\""

msgctxt "text_id=9032 | speaker=unknown"
msgid "「蒼崎ならまだ学校。こっちはバイトが早めに終わったんで、ここで暇を潰している。"
msgstr "\"Aozaki's still at school. I finished work early today, so I'm just passing the time."

msgctxt "text_id=9033 | speaker=unknown"
msgid "夕方になったら正門で蒼崎と合流して、洋館に戻るよ」"
msgstr "I'll meet her at the front gate later and walk her back.\""

msgctxt "text_id=9034 | speaker=unknown"
msgid "「……そう。でも、貴方が先に帰ってきている事を、青子には伝えてあるの？」"
msgstr "\"I see. But did you tell her you were coming home early today?\""

msgctxt "text_id=9035 | speaker=unknown"
msgid "「あ」"
msgstr "\"Oh. Uh...\""

msgctxt "text_id=9036 | speaker=unknown"
msgid "　しまった、と草十郎は不安げに言葉を切った。"
msgstr "  Soujyuro stumbled over his words with obvious unease."

msgctxt "text_id=9037 | speaker=unknown"
msgid "“いい？　洋館の正門前、五時だからね！”"
msgstr "\"So we'll meet at the mansion's front gate at five! Got it?\" "

msgctxt "text_id=9038 | speaker=unknown"
msgid "　その約束は当然守る気満々だった。"
msgstr "  And he had every intension of doing as promised."

msgctxt "text_id=9039 | speaker=unknown"
msgid "　が、今にして思うと、それは“五時まで洋館に入るな”というコトだったのかもしれない。"
msgstr "  But maybe what Aoko really meant to say was \"Stay away from the mansion until five o'clock!\""

msgctxt "text_id=9040 | speaker=unknown"
msgid "「……申し訳ない。蒼崎には黙っていてくれると助かる」"
msgstr "\"I'm sorry. Please don't tell Aozaki about this.\""

msgctxt "text_id=9041 | speaker=unknown"
msgid "「別に。青子との会話で、貴方の話題があがる事はないから気にしないで。"
msgstr "\"Don't worry, I won't. Besides, we never talk about you anyway."

msgctxt "text_id=9042 | speaker=unknown"
msgid "　……それより何をしているの？　貴方と青子、今日から期末試験でしょう？　勉強、しなくていいの？」"
msgstr "  What exactly are you doing here? I thought you and Aoko have exams. Shouldn't you be studying?\""

msgctxt "text_id=9043 | speaker=unknown"
msgid "「うん？　勉強ならちゃんとするよ。"
msgstr "\"What? Oh, I haven't neglected to study."

msgctxt "text_id=9044 | speaker=unknown"
msgid "　寝る前にきちんと、二時間」"
msgstr "  I do two hours every night before I go to bed.\""

msgctxt "text_id=9045 | speaker=unknown"
msgid "　どうも、彼にはまだ“試験前は念入りに復習をする”知恵がないようだ。"
msgstr "  He was not yet familiar with the common student concept of \"cramming.\""

msgctxt "text_id=9046 | speaker=unknown"
msgid "　その考えはこの数時間後に<改|あらた>められる事になるが、今はまだ先の話だ。"
msgstr "  He would be in a few hours from now, however."

msgctxt "text_id=9047 | speaker=unknown"
msgid "「それより森の荒れ具合が気になって。"
msgstr "\"I was more worried about the condition of the woods around the mansion."

msgctxt "text_id=9048 | speaker=unknown"
msgid "　この丘、どのくらいほったらかしだったんだ？」"
msgstr "  When was the last time someone tended to this hill?\""

msgctxt "text_id=9049 | speaker=unknown"
msgid "「…………」"
msgstr "\"...\""

msgctxt "text_id=9050 | speaker=unknown"
msgid "　有珠は答えない。"
msgstr "  Alice stood speechless."

msgctxt "text_id=9051 | speaker=unknown"
msgid "　彼女がこの土地に住みはじめて三年ほど経つが、口にする必要はない。"
msgstr "  She had lived here for three years, but there was no need to tell him that."

msgctxt "text_id=9052 | speaker=unknown"
msgid "　沈黙する有珠が気にならないのか、草十郎はひょいひょいとマイペースにゴミを拾っていく。"
msgstr "  Soujyuro casually continued collecting trash as if Alice had not been standing before him in silence."

msgctxt "text_id=9053 | speaker=unknown"
msgid "　少女から見ると<厚|あつ>かましいコトこの上ない。"
msgstr "  For her, it was one of the most brazen insults she had ever received."

msgctxt "text_id=9054 | speaker=unknown"
msgid "「―――貴方」"
msgstr "\"Why, you...\""

msgctxt "text_id=9055 | speaker=unknown"
msgid "　今すぐ消えて、と続きかねない声。"
msgstr "  Her voice full of desire to extinguish his life."

msgctxt "text_id=9056 | speaker=unknown"
msgid "「あいたっ」"
msgstr "\"Yowch!\""

msgctxt "text_id=9057 | speaker=unknown"
msgid "　それを、間の抜けた声が押し止めた。"
msgstr "  His simple cry interrupted her before she could finish."

msgctxt "text_id=9058 | speaker=unknown"
msgid "「いたた……なんか硬いの蹴ったぞ、今」"
msgstr "\"Ouch... I just kicked something really hard.\""

msgctxt "text_id=9059 | speaker=unknown"
msgid "　草十郎の足下には、錆びた金属の固まりが埋もれていた。"
msgstr "  A rusty mass of metal lay buried at his feet."

msgctxt "text_id=9060 | speaker=unknown"
msgid "「鉄の……なんだろう、このギサギザ。危ないけど、これ閉じるのか？」"
msgstr "\"What's this spiky metal thing? I should shut this before someone gets hurt.\""

msgctxt "text_id=9061 | speaker=unknown"
msgid "　不思議そうに足下の危険物を観察する。"
msgstr "  He inspected the dangerous object before him with a befuddled expression."

msgctxt "text_id=9062 | speaker=unknown"
msgid "　それが野生の獣の<脚|あし>を捕らえる<道具|ワナ>である事を、彼は知らないらしい。"
msgstr "  Apparently, he had no idea that it was a common trap used to catch wild animals."

msgctxt "text_id=9063 | speaker=unknown"
msgid "「……<虎挟|とらばさ>みね。昔、この山には野犬が多くいたというから、その頃のものでしょう。"
msgstr "\"That's a bear trap. We used to have a stray dog problem up here."

msgctxt "text_id=9064 | speaker=unknown"
msgid "　街の人たちが忘れていったのよ、きっと」"
msgstr "  Someone from town must have left it there.\""

msgctxt "text_id=9065 | speaker=unknown"
msgid "「野犬……これ、犬を捕まえる道具なのか？」"
msgstr "\"Strays, huh? Do people really use this to catch dogs?\""

msgctxt "text_id=9066 | speaker=unknown"
msgid "「ええ。踏みつけると、その口みたいなのがバネで閉じると聞いたわ。"
msgstr "\"Yes. When an animal steps on it a spring makes that sharp part clamp onto their leg."

msgctxt "text_id=9067 | speaker=unknown"
msgid "実際に稼働するところは見た事がないけれど」"
msgstr "Though I've never actually seen one in action, come to think of it.\""

msgctxt "text_id=9068 | speaker=unknown"
msgid "「そうなのか。でもこんな見え見えの仕掛け、引っかかる動物がいるのかな」"
msgstr "\"Really? It's so obvious it's a trap, though. What animal would fall for it?\""

msgctxt "text_id=9069 | speaker=unknown"
msgid "　素朴な疑問に、たしかに、と有珠は頷いた。"
msgstr "  Alice could only nod in agreement with his naive observation."

msgctxt "text_id=9070 | speaker=unknown"
msgid "　虎挟みなんてものを見たのは子供の時以来だが、彼女も前から妙に思っていたのだ。"
msgstr "  Though she had not seen one of the devices since her childhood, she remembered harboring the same doubts back then."

msgctxt "text_id=9071 | speaker=unknown"
msgid "　有珠は獣たちの<賢|かしこ>さを知っている。"
msgstr "  Alice knew very well how smart wild animals really were."

msgctxt "text_id=9072 | speaker=unknown"
msgid "　なのにどうして、彼らはこんなあからさまな罠に食いつかれて、人間の手にかかってきたのか？"
msgstr "  How could they so easily be fooled and delivered into human hands by such a simplistic contraption?"

msgctxt "text_id=9073 | speaker=unknown"
msgid "「…………食べ物とか、置くのかも」"
msgstr "\"...Some people use food as bait.\""

msgctxt "text_id=9074 | speaker=unknown"
msgid "　つい、思いつきが声にでる。"
msgstr "  Alice let slip."

msgctxt "text_id=9075 | speaker=unknown"
msgid "「食べ物ほしさに、こんな、見るからに痛そうなものに近づくかな」"
msgstr "\"And the hungry animal approaches even though it's obviously dangerous?\""

msgctxt "text_id=9076 | speaker=unknown"
msgid "「それはそうだけど、時と場合によるでしょう。"
msgstr "\"Yes, but timing and circumstance play a key part."

msgctxt "text_id=9077 | speaker=unknown"
msgid "　動物だって、死にそうなぐらいお腹が減っていたら、誘惑には勝てないわ。"
msgstr "  You see, if an animal is starving to death, curiosity is bound to get the better of it."

msgctxt "text_id=9078 | speaker=unknown"
msgid "　罠にかかっても傷つくのは片足だけでしょうし。危ないと分かっていても、飢えて死ぬよりはいいと食べてしまうのではないかしら」"
msgstr "  The worst that could happen is injuring one leg. Even if the animal recognizes the danger, suffering an injury to its leg is far better than dying from starvation.\""

msgctxt "text_id=9079 | speaker=unknown"
msgid "　……そう。"
msgstr "  Indeed."

msgctxt "text_id=9080 | speaker=unknown"
msgid "　たとえその後、猟師の手による死が待っていようと、目前の飢餓には耐えられない。"
msgstr "  An animal lives knowing it might ultimately die at a hunter's hand, but the prospect of dying from hunger is unbearable."

msgctxt "text_id=9081 | speaker=unknown"
msgid "　それが子供を養う親だったら尚更だ。"
msgstr "  That was doubly true for any creature that had young to look after."

msgctxt "text_id=9082 | speaker=unknown"
msgid "　親犬は子供のために片足を犠牲にして、餌を手に入れた代償として狩られてしまう。"
msgstr "  A dog willing to sacrifice a leg to obtain food for its pup was easy prey for a trapper."

msgctxt "text_id=9083 | speaker=unknown"
msgid "　はじめから危険と分かった上での挑戦……なのかもしれない。"
msgstr "  Perhaps it would try anyway, knowing full well the risk."

msgctxt "text_id=9084 | speaker=unknown"
msgid "　動物たちは生き残る為なら片足ぐらいと決断して、結果的に殺されてしまうだけの話。"
msgstr "  The end result was the same: the animal would risk its leg to survive, and end up dead."

msgctxt "text_id=9085 | speaker=unknown"
msgid "「人間と変わらないわ。"
msgstr "\"Humans are no different."

msgctxt "text_id=9086 | speaker=unknown"
msgid "　片手を失うことで死なずに済むのなら、それぐらいの取捨選択はすると思う」"
msgstr "  If losing a leg is what it takes to survive, anyone would make the same choice.\""

msgctxt "text_id=9087 | speaker=unknown"
msgid "　自分を納得させるように少女は断言する。"
msgstr "  She spoke assertively as if trying to convince herself at the same time."

msgctxt "text_id=9088 | speaker=unknown"
msgid "　それを、"
msgstr "  That was―"

msgctxt "text_id=9089 | speaker=unknown"
msgid "「どうだろう。人間と動物は、ちょっと違うんじゃないかな」"
msgstr "  \"Humans and animals are kinda different, don't you think?\""

msgctxt "text_id=9090 | speaker=unknown"
msgid "　再度、自信なげな声が押し止めた。"
msgstr "Once again, his timid voice cut her off mid-thought."

msgctxt "text_id=9091 | speaker=unknown"
msgid "「……違うって、なにが？」"
msgstr "\"What do you mean 'different'?\""

msgctxt "text_id=9092 | speaker=unknown"
msgid "「片足を犠牲にして助かろうってところ、かな。"
msgstr "\"I mean, the whole idea that losing a leg could help you..."

msgctxt "text_id=9093 | speaker=unknown"
msgid "　動物には無駄がない。あれこれ考える知恵もない。"
msgstr "  Animals do not squander anything. And they don't have such complicated thoughts, either."

msgctxt "text_id=9094 | speaker=unknown"
msgid "　だから俺たちみたいに、<無|・><く|・><な|・><っ|・><た|・><ら|・><別|・><の|・><物|・><で|・><補|・><う|・>、なんて選択が、そもそもないんだ」"
msgstr "  They don't consider giving up one thing in order to gain another the way humans do.\""

msgctxt "text_id=9095 | speaker=unknown"
msgid "「動物にとって、片足を無くすコトは命を無くすコトと変わらない。"
msgstr "\"For them, losing a leg is the same as dying."

msgctxt "text_id=9096 | speaker=unknown"
msgid "無駄がないという在り方は、何も失えない在り方なんだと思う。動物はみんな、少しでも自分の<価値|からだ>が欠けたら、もう生きていけない事を知っている」"
msgstr "Living without waste is the same as living without losing anything at all. Every animal knows that losing even a part of themselves means they're as good as dead.\""

msgctxt "text_id=9097 | speaker=unknown"
msgid "「……だから、この罠を見て、それでも進もうとした時、彼らには“足ぐらいなくなっても”なんて思いはないんじゃないかな。"
msgstr "\"No animal calculates whether it's worth losing a leg or not at the moment they see a trap and decide to approach it."

msgctxt "text_id=9098 | speaker=unknown"
msgid "　はじめから助かる気はない。片足を失うと認めた時点で、彼らは自分の命そのものを差しだしている」"
msgstr "  That kind of thinking doesn't work for them. When they know they'll lose a leg, they're already prepared to sacrifice their whole life.\""

msgctxt "text_id=9099 | speaker=unknown"
msgid "　予想外の意見だったが、なるほど、と少女は受け入れた。"
msgstr "  It was far from the response she had expected him to give, but she found herself nodding nonetheless."

msgctxt "text_id=9100 | speaker=unknown"
msgid "　この少年は都会生まれではなく、まだ自然と共存している山村で育った人間だ。"
msgstr "  He had been raised in a mountain village where people had to coexist with nature, not in crowded urban area."

msgctxt "text_id=9101 | speaker=unknown"
msgid "　文明で武装し、弱いもの、老いたものを助けてくれる社会に生まれたものではない。"
msgstr "  His childhood environment was not a civilized or cultured one where the weak and old were protected."

msgctxt "text_id=9102 | speaker=unknown"
msgid "　これまでの彼の在り方は、創意工夫に満ちた便利な日々ではなく、自然との共存による生活だったのだろう。"
msgstr "  No, he was accustomed to a lifestyle where mankind and nature coexisted, not one of infinite possibilities and convenience."

msgctxt "text_id=9103 | speaker=unknown"
msgid "　そんな草十郎にとって、傷とは傷のまま、永遠に残るものだったに違いない。"
msgstr "  It was no wonder that Soujyuro saw injuries as something that, once inflicted, lasted forever."

msgctxt "text_id=9104 | speaker=unknown"
msgid "　そうでなければ、自然に生きる動物の在り方を口にできない。"
msgstr "  If not, then he would not have explained the way wild animals live in nature in such detail."

msgctxt "text_id=9105 | speaker=unknown"
msgid "　……彼の言うことはもっともだ。"
msgstr "  His words rang very true."

msgctxt "text_id=9106 | speaker=unknown"
msgid "　足を負傷して走れなくなった馬は、もう「馬」として機能せず、人々からも「馬」として見られないように。"
msgstr "  A horse rendered unable to run by a leg injury could no longer function in the way a horse is meant to function. It would thus no longer be seen as a horse at all in human society."

msgctxt "text_id=9107 | speaker=unknown"
msgid "　野生の獣は、その手足を走らせる機能を<損|そこ>なった時点で、<生命|いのち>より先に己の<意義|かち>を<喪|うしな>うのだ―――"
msgstr "  Once a wild animal loses its ability to run, though it may still live, it loses its sense of significance in the world."

msgctxt "text_id=9108 | speaker=unknown"
msgid "「でもコレ、一度でも獲物を捕まえたコトがあるのかな」"
msgstr "\"I wonder if this one has ever caught anything.\""

msgctxt "text_id=9109 | speaker=unknown"
msgid "「さあ。仕掛けたのはわたしじゃないから」"
msgstr "\"Well, we'd have to be the people who put it here to know that, wouldn't we?\""

msgctxt "text_id=9110 | speaker=unknown"
msgid "　親しげに話しかけられ、有珠は気を引き締めて返答した。"
msgstr "  Alice's tone was tense in response to his friendly and candid observations."

msgctxt "text_id=9111 | speaker=unknown"
msgid "　つい話し込んでしまったが、有珠にとってみれば虎挟みよりこの少年の方が何倍も邪魔なのだ。"
msgstr "  Though she'd been the one to strike up a conversation, she still found the bear trap far less of a nuisance than Soujyuro himself."

msgctxt "text_id=9112 | speaker=unknown"
msgid "「それより。森の手入れをしているようだけど、何のつもり？　わたしへのご機嫌<伺|うかが>い？」"
msgstr "\"In any case, I can see that you're trying to clean things up, but what's this all in aid of? Is this your attempt to get on my good side?\""

msgctxt "text_id=9113 | speaker=unknown"
msgid "　少女の瞳に敵意がともる。"
msgstr "  Animosity burned in her eyes."

msgctxt "text_id=9114 | speaker=unknown"
msgid "　自分に媚びへつらった時点で、有珠は草十郎を自分流に処置しようと決めていた。"
msgstr "  She did not like being sucked up to, and decided that the moment he did so would be the moment she disposed of him."

msgctxt "text_id=9115 | speaker=unknown"
msgid "　不義理もいい。絶交もいい。裏切りもいい。"
msgstr "  It was one thing to be ingracious, treacherous, or even to cut off relations with her."

msgctxt "text_id=9116 | speaker=unknown"
msgid "　けれど、心にもない言葉で話しかけられる事だけは許せない。"
msgstr "  But she could not abide being spoken to insincerely."

msgctxt "text_id=9117 | speaker=unknown"
msgid "　それは少女にとって、何よりも重い侮辱だった。"
msgstr "  For her, that was the ultimate insult."

msgctxt "text_id=9118 | speaker=unknown"
msgid "「うん？　森の手入れをすると、なんでそっちの機嫌が良くなるんだ？"
msgstr "\"How would cleaning the woods make you happy?"

msgctxt "text_id=9119 | speaker=unknown"
msgid "　こんなに荒れ放題なんだから、ふたりともこの森はあんまり好きじゃないんだろ。森がきれいになって気分が良くなるのは、俺だけだと思うけど」"
msgstr "  It's only this bad because neither of you care, right? I thought I was the only one who felt bad seeing the grounds in this state.\""

msgctxt "text_id=9120 | speaker=unknown"
msgid "　が。有珠の敵意も、この少年にはまったく伝わらなかったようだ。"
msgstr "  It seemed he had not picked up on her animosity one bit."

msgctxt "text_id=9121 | speaker=unknown"
msgid "「……待って。たしかに森には手を入れていないけれど、嫌いな訳じゃない。愛情はそれなりにあるわ」"
msgstr "\"...Excuse me, I'm well aware that I haven't kept the grounds in the best shape, but it's not because I don't care. In fact, I love the trees in a way.\""

msgctxt "text_id=9122 | speaker=unknown"
msgid "「それはヘンだ。なら、どうして放っておく」"
msgstr "\"Really? Then why don't you groom them?\""

msgctxt "text_id=9123 | speaker=unknown"
msgid "「愛情はあっても愛着はないだけよ。"
msgstr "\"I love them, but I don't dote on them."

msgctxt "text_id=9124 | speaker=unknown"
msgid "……でも反省したわ。これからは森の手入れも日課にいれる。"
msgstr "However, I've reconsidered. I'm going to make tending to the grounds a part of my daily routine."

msgctxt "text_id=9125 | speaker=unknown"
msgid "　けど、貴方だっておかしいでしょう？"
msgstr "  In any case, the only strange thing here is your behavior."

msgctxt "text_id=9126 | speaker=unknown"
msgid "　この森のどこに、貴方が気に入るものがあるの？」"
msgstr "  What interest do you have in these woods?\""

msgctxt "text_id=9127 | speaker=unknown"
msgid "「おかしくはない。"
msgstr "\"It's not strange at all."

msgctxt "text_id=9128 | speaker=unknown"
msgid "森はたいてい好きだし、この丘、ちょっと故郷の山に似ているし。"
msgstr "I love woods, and this hill reminds me of the mountains back home."

msgctxt "text_id=9129 | speaker=unknown"
msgid "　ほら。好きだった子にそっくりな子が困ってたら、なんとかしてあげようと思わないか？」"
msgstr "  When you see a person struggling who kinda looks like someone you were once sweet on, don't you feel like stepping in to help?\""

msgctxt "text_id=9130 | speaker=unknown"
msgid "“なんというか、人間として”"
msgstr "\"You know... as a fellow human being,\""

msgctxt "text_id=9131 | speaker=unknown"
msgid "　などと締めくくる草十郎。"
msgstr "  he concluded."

msgctxt "text_id=9132 | speaker=unknown"
msgid "　その余計な一言は、有珠の心をかき乱すには十分だった。"
msgstr "  His last uncalled-for remark upset Alice."

msgctxt "text_id=9133 | speaker=unknown"
msgid "「……納得いかない。それだけで大切に扱うの？"
msgstr "\"So being raised in the mountains makes you want to clean up the backyard? No, I'm not convinced."

msgctxt "text_id=9134 | speaker=unknown"
msgid "　本当はわたしへの当てつけなんでしょう？"
msgstr "  I think this is all an effort to butter me up."

msgctxt "text_id=9135 | speaker=unknown"
msgid "　だいたい、こんな森が好きなんておかしいわ。オークの木も根付かない、どこにでもある普通の森なのに」"
msgstr "  Why would you feel so attached to an otherwise unremarkable wood like this? It doesn't even have any oak trees.\""

msgctxt "text_id=9136 | speaker=unknown"
msgid "「？　別にそれでいいじゃないか。"
msgstr "\"So? I like it. Isn't that enough?"

msgctxt "text_id=9137 | speaker=unknown"
msgid "　森は普通にあるだけでいいんだ。なにもおかしくない。きれいなものをきれいと思うのは、いい事だと思うんだが」"
msgstr "  I like these woods just because they're here. I don't think there's anything wrong with finding something beautiful for no particular reason.\""

msgctxt "text_id=9138 | speaker=unknown"
msgid "「……明確な理由もないのに？　この世のすべての森が好きだっていうの？"
msgstr "\"No particular reason? Are you telling me you like every wooded area on earth?"

msgctxt "text_id=9139 | speaker=unknown"
msgid "　貴方とこの森には何の因果関係もないわ。"
msgstr "  You have no relationship with this wood."

msgctxt "text_id=9140 | speaker=unknown"
msgid "　文脈として、貴方がこの森を好きになる理由がない。"
msgstr "  There is no context or reason for your liking it."

msgctxt "text_id=9141 | speaker=unknown"
msgid "　理由がないなら、それはわたしへの―――」"
msgstr "  And if there's no external reason, then it must be because you're up to something.\""

msgctxt "text_id=9142 | speaker=unknown"
msgid "「？　好きってコトに理由は必要なのか？」"
msgstr "\"...Do I need a reason to like something?\""

msgctxt "text_id=9143 | speaker=unknown"
msgid "「え―――」"
msgstr "\"Huh?\""

msgctxt "text_id=9144 | speaker=unknown"
msgid "　不思議なものを見るように少年は言った。"
msgstr "  Soujyuro had uttered his question as if he had been confronted with an entirely new concept."

msgctxt "text_id=9145 | speaker=unknown"
msgid "　それは、愛情に理由はいらない、という意味ではなく。"
msgstr "  The cliché \"love needs no reason\" was certainly not what he intended to throw in her face."

msgctxt "text_id=9146 | speaker=unknown"
msgid "　理由のない<感|も><情|の>はすべて嘘なのかと、問い返すような言葉だった。"
msgstr "  He had simply asked whether feeling without reason could be real."

msgctxt "text_id=9147 | speaker=unknown"
msgid "　……カッと沸き立っていた胸が冷めていく。"
msgstr "  After boiling over at him, Alice simmered down."

msgctxt "text_id=9148 | speaker=unknown"
msgid "　少女は声を荒らげた自分を恥じて、一歩、少年から身を引いた。"
msgstr "  She took a step back, embarrassed to have raised her voice at him."

msgctxt "text_id=9149 | speaker=unknown"
msgid "「――――――」"
msgstr "\"...\""

msgctxt "text_id=9150 | speaker=unknown"
msgid "「………………」"
msgstr "\"...\""

msgctxt "text_id=9151 | speaker=unknown"
msgid "　気まずい沈黙。"
msgstr "  It was an unbearably awkward silence."

msgctxt "text_id=9152 | speaker=unknown"
msgid "　有珠は何か、自分なりの<矜持|きょうじ>を示そうと言葉を探していた。"
msgstr "  Alice searched for the words to regain her pride."

msgctxt "text_id=9153 | speaker=unknown"
msgid "　やりこめられたままでは立場が逆だ。"
msgstr "  She could not leave it on that note or it would have looked like he won the argument."

msgctxt "text_id=9154 | speaker=unknown"
msgid "　何しろここは自分の森、彼女の世界。"
msgstr "  At the end of the day this was her wood; her world."

msgctxt "text_id=9155 | speaker=unknown"
msgid "　こんな、ただの人間に言い負かされたままでは魔女の<沽券|こけん>に関わると唇を噛んでいる。"
msgstr "  Losing an argument to a mere human was enough to make any witch bite her lip at the dishonor."

msgctxt "text_id=9156 | speaker=unknown"
msgid "「ところで。これは残しておく？」"
msgstr "\"By the way, should I leave this here?\""

msgctxt "text_id=9157 | speaker=unknown"
msgid "　一方。そんな彼女の戦意もどこ吹く風で、草十郎は虎挟みに手を伸ばす。"
msgstr "  Soujyuro casually reached out toward the bear trap as if Alice's animosity had been a mild gust of wind."

msgctxt "text_id=9158 | speaker=unknown"
msgid "「……必要ないわ。わたしのものではないと言ったでしょう」"
msgstr "\"I don't need it. I said it's not mine, remember?\""

msgctxt "text_id=9159 | speaker=unknown"
msgid "「そっか。なら回収しよう。もう錆びて動かないけど、犬の歯みたいで物騒だ。残しておくと夢に見そうだし」"
msgstr "\"Okay, then I'll get rid of it. It's rusty and I doubt it still works, and those teeth look pretty sharp. If I leave it here, I'll probably have a bad dream about it.\""

msgctxt "text_id=9160 | speaker=unknown"
msgid "　よいしょ、と重い鉄の塊を持ち上げる草十郎。"
msgstr "  Soujyuro lifted up the heavy mass of iron with a loud exhale of breath."

msgctxt "text_id=9161 | speaker=unknown"
msgid "　少年はそのまま木の陰まで歩いていくと、おかしなモノに虎挟みを放りこんだ。"
msgstr "  He preceded to walk over to the shade of a nearby tree and toss it inside something unusual-looking."

msgctxt "text_id=9162 | speaker=unknown"
msgid "「……静希君。そのリヤカー、どこにあったの？」"
msgstr "\"Where did you find that trailer, Sizuki?\""

msgctxt "text_id=9163 | speaker=unknown"
msgid "「どこって、町のお店だよ。"
msgstr "\"A shop in town."

msgctxt "text_id=9164 | speaker=unknown"
msgid "　もしかしたらと思って買ってきて正解だった。ここのところ、どうしてか悪い予感だけはあたるんだ」"
msgstr "  I thought I might need it, and boy was I right. I'm getting good at listening to my gut instincts.\""

msgctxt "text_id=9165 | speaker=unknown"
msgid "　嬉しそうにリヤカーを移動させる、謎のボランティアマスター。"
msgstr "  What an odd master of good deeds he must have appeared, so proudly dragging along that trailer of his."

msgctxt "text_id=9166 | speaker=unknown"
msgid "　その笑顔を見て、この少年につっかかるのがどれだけ時間の無駄なのか、有珠はようやく悟った。"
msgstr "  Seeing the grin on his face, Alice realized just how pointless it was to try to converse with the boy any further."

msgctxt "text_id=9167 | speaker=unknown"
msgid "「………そう。話しかけたわたしが、どうかしていたわ」"
msgstr "\"...It's my own fault for trying to talk to him. I should have known better.\""

msgctxt "text_id=9168 | speaker=unknown"
msgid "　少年に背を向けて、洋館に足を向ける。"
msgstr "  She turned away and headed back toward the mansion."

msgctxt "text_id=9169 | speaker=unknown"
msgid "　……まったく、青子の言うとおりだ。"
msgstr "  Aoko had been right all along."

msgctxt "text_id=9170 | speaker=unknown"
msgid "　余計な時間を使ったと反省しながら、有珠は徹底的に、あの少年は無視しようと<自|みずか>らに言い聞かせた。"
msgstr "  Realizing how much time she had wasted, Alice now fully agreed: she should do everything in her power to ignore him, utterly and completely."

#. Occurrence 7_2:49:9171: scene=7_2
#: 7_2:49
msgctxt "text_id=9171 | speaker=unknown"
msgid "　私立という事もあって、三咲高校の冬休みは早い。"
msgstr "  Misaki High was a private school, and as such its winter break started earlier than public schools."

#. Occurrence 7_2:54:9172: scene=7_2
#: 7_2:54
msgctxt "text_id=9172 | speaker=unknown"
msgid "　十二月の<半|なか>ばには終業式を<迎|むか>え、校舎と生徒たちはつかの間、二学期までの疲れを癒す事になる。"
msgstr "  The end-of-term ceremony was in mid-December, followed by a brief respite before the next term began."

#. Occurrence 7_2:59:9173: scene=7_2
#: 7_2:59
msgctxt "text_id=9173 | speaker=unknown"
msgid "　無論。"
msgstr "  Of course..."

#. Occurrence 7_2:64:9174: scene=7_2
#: 7_2:64
msgctxt "text_id=9174 | speaker=unknown"
msgid "　彼らにとっては恒例の関門、幸せな長期休日の前に立ちはだかる<期末試験|みっかかん>を無事に乗り越えられたら、の話であるが。"
msgstr "  That was if and only if they overcame the classic obstacle lying between them and an extended break from school: final exams."

#. Occurrence 7_2:122:9175: scene=7_2
#: 7_2:122
msgctxt "text_id=9175 | speaker=unknown"
msgid "　深夜放送を受信するラジオ。"
msgstr "  The radio continued its broadcast late into the night."

#. Occurrence 7_2:127:9176: scene=7_2
#: 7_2:127
msgctxt "text_id=9176 | speaker=unknown"
msgid "　<台所|した>まで下りる手間をはぶく、紅茶用の魔法瓶。"
msgstr "  A thermos of hot tea eliminated the need to venture down to the kitchen."

#. Occurrence 7_2:132:9177: scene=7_2
#: 7_2:132
msgctxt "text_id=9177 | speaker=unknown"
msgid "　冬の寒さから足を守る電気毛布と、夜食のカニパン。"
msgstr "  An electric blanket kept away the winter cold, and a crab-shaped pastry staved off any dinnertime hunger."

#. Occurrence 7_2:150:9178: scene=7_2
#: 7_2:150
msgctxt "text_id=9178 | speaker=unknown"
msgid "　このように。"
msgstr "  These were the lengths Aoko had gone to."

#. Occurrence 7_2:155:9179: scene=7_2
#: 7_2:155
msgctxt "text_id=9179 | speaker=unknown"
msgid "　青子の部屋は<一分|いちぶ>の<隙|すき>もない、一夜漬け強制空間になっていた。"
msgstr "  She needed to ensure that every aspect of her surroundings helped her pull a successful all-nighter."

#. Occurrence 7_2:187:9180: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0000; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:187
msgctxt "text_id=9180 | speaker=aoko"
msgid "「期末試験一日目、ご苦労さま。"
msgstr "\"Congrats on surviving the first day of exams."

#. Occurrence 7_2:193:9181: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0001; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:193
msgctxt "text_id=9181 | speaker=aoko"
msgid "　それで、生まれ変わる覚悟はできた？」"
msgstr "  Are you ready to leave your old study habits behind and be reborn as a new student?\""

#. Occurrence 7_2:214:9182: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0000; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:214
msgctxt "text_id=9182 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 7_2:219:9183: scene=7_2
#: 7_2:219
msgctxt "text_id=9183 | speaker=unknown"
msgid "　こくこく、と頷く草十郎。"
msgstr "  Soujyuro nodded earnestly."

#. Occurrence 7_2:224:9184: scene=7_2
#: 7_2:224
msgctxt "text_id=9184 | speaker=unknown"
msgid "　アルバイトから戻ってきた彼を待っていたのは、魔術師ではなく、鬼の生徒会長としての蒼崎青子だった。"
msgstr "  Upon returning from work he encountered not the mage he expected but the demon student council president-Aozaki."

#. Occurrence 7_2:257:9185: scene=7_2
#: 7_2:257
msgctxt "text_id=9185 | speaker=unknown"
msgid "　時をさかのぼること半日前。"
msgstr "  Half a day earlier."

#. Occurrence 7_2:275:9186: scene=7_2
#: 7_2:275
msgctxt "text_id=9186 | speaker=unknown"
msgid "　期末試験一日目を終え、かねてからの計画を実行しようと洋館に向かう草十郎の前に、"
msgstr "  The first day of exams were over, and Soujyuro was about to head back to the mansion where he hoped to put his plan into practice, when..."

#. Occurrence 7_2:300:9187: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0002; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:300
msgctxt "text_id=9187 | speaker=aoko"
msgid "「今夜、私の部屋で監禁ね。"
msgstr "\"Tonight, I'm holding you prisoner."

#. Occurrence 7_2:306:9188: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0003; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:306
msgctxt "text_id=9188 | speaker=aoko"
msgid "　あ、夕方からのアルバイトは当然キャンセル。ちょっと本気で、あの点数はあり得ないから」"
msgstr "  Your grades are simply unacceptable. Cancel your shift and any other plans you have.\""

#. Occurrence 7_2:316:9189: scene=7_2
#: 7_2:316
msgctxt "text_id=9189 | speaker=unknown"
msgid "　青い炎に包まれた笑顔が現れたのである。"
msgstr "  ...a cold, blue grin greeted him in the hallway."

#. Occurrence 7_2:321:9190: scene=7_2
#: 7_2:321
msgctxt "text_id=9190 | speaker=unknown"
msgid "　その手にはしわくちゃに握りしめられた静希草十郎のテスト用紙。"
msgstr "  Clenched in her fist was Soujyuro's exam paper."

#. Occurrence 7_2:361:9191: scene=7_2
#: 7_2:361
msgctxt "text_id=9191 | speaker=unknown"
msgid "　おそらく職員室で山城教諭から"
msgstr "  Mr. Yamasiro had no doubt said,"

#. Occurrence 7_2:367:9192: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_2_0000; voice_prefix=B60; voice_category=7; scene=7_2
#: 7_2:367
msgctxt "text_id=9192 | speaker=yamashiro"
msgid "『ま、転校してきたばかりだし、しょうがないよね』"
msgstr "\"He only just transferred. We can't expect miracles.\""

#. Occurrence 7_2:372:9193: scene=7_2
#: 7_2:372
msgctxt "text_id=9193 | speaker=unknown"
msgid "　と見せられたものを、<勢|いきお>い<奪|うば>い取ってきたに違いない。"
msgstr "  But she had snatched the exam out of the teacher's hands the minute he tried to show her."

#. Occurrence 7_2:419:9194: scene=7_2
#: 7_2:419
msgctxt "text_id=9194 | speaker=unknown"
msgid "　かくして、今日まで屋根裏部屋で寝泊りしていた草十郎は、この日にかぎって青子の部屋に通された。"
msgstr "  That was how Soujyuro had ended up in Aoko's room, instead of the room in the attic to which he was accustomed."

#. Occurrence 7_2:439:9195: scene=7_2
#: 7_2:439
msgctxt "text_id=9195 | speaker=unknown"
msgid "　色々疑問視する点はあるものの、青子とて年頃の女学生である。"
msgstr "  Though her situation was far from normal, at the end of the day she was an adolescent girl like any other."

#. Occurrence 7_2:445:9196: scene=7_2
#: 7_2:445
msgctxt "text_id=9196 | speaker=unknown"
msgid "同年代の男子を自分の部屋に立ち入らせることに抵抗はある。"
msgstr "Naturally, she felt uncomfortable letting a boy her own age into her room."

#. Occurrence 7_2:450:9197: scene=7_2
#: 7_2:450
msgctxt "text_id=9197 | speaker=unknown"
msgid "　が、それ以上に草十郎の答案用紙はあり得なかったのだ。"
msgstr "  However, his grades were truly something that called for desperate measures."

#. Occurrence 7_2:455:9198: scene=7_2
#: 7_2:455
msgctxt "text_id=9198 | speaker=unknown"
msgid "　なので、今日の不機嫌度は五割増し。彼女のこめかみから怒りマークがとれないのも無理からぬ事である。"
msgstr "  That explained why her mood was even worse than normal today and the vein on her forehead was pulsing visibly with anger."

#. Occurrence 7_2:480:9199: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0004; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:480
msgctxt "text_id=9199 | speaker=aoko"
msgid "「先に自分の復習、済ませる。"
msgstr "\"I need to finish my own studies first."

#. Occurrence 7_2:486:9200: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0005; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:486
msgctxt "text_id=9200 | speaker=aoko"
msgid "　アンタはそのテーブル使ってて」"
msgstr "  You can use that table in the meantime.\""

#. Occurrence 7_2:496:9201: scene=7_2
#: 7_2:496
msgctxt "text_id=9201 | speaker=unknown"
msgid "　青子はテーブルに背を向け、愛用の机に向かった。"
msgstr "  Aoko turned her back to him and sat down at her favorite desk."

#. Occurrence 7_2:501:9202: scene=7_2
#: 7_2:501
msgctxt "text_id=9202 | speaker=unknown"
msgid "　一方、草十郎の前には安物のガラステーブルが一つ。"
msgstr "  Soujyuro was left standing before a cheap-looking glass table."

#. Occurrence 7_2:526:9203: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0001; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:526
msgctxt "text_id=9203 | speaker=soujuurou"
msgid "「……なんか色々と慣れないな。"
msgstr "\"I'm still really not used to all this."

#. Occurrence 7_2:545:9204: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0002; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:545
msgctxt "text_id=9204 | speaker=soujuurou"
msgid "　なあ蒼崎、この青いのなんだ？」"
msgstr "  What's that blue thing over there, Aozaki?\""

#. Occurrence 7_2:551:9205: scene=7_2
#: 7_2:551
msgctxt "text_id=9205 | speaker=unknown"
msgid "　落ち着かないのか、草十郎は部屋の隅にたてかけられたギターを眺める。"
msgstr "  Restless, Soujyuro found his eyes drawn to the guitar propped up in the corner."

#. Occurrence 7_2:587:9206: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0003; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:587
msgctxt "text_id=9206 | speaker=soujuurou"
msgid "「なんか薄いし青いしとんがってるし、きっと蒼崎の事だし。"
msgstr "\"It's thin, blue and intense-looking, it's got your name written all over it."

#. Occurrence 7_2:594:9207: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0004; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:594
msgctxt "text_id=9207 | speaker=soujuurou"
msgid "……もしかしなくても、武器か？」"
msgstr "Don't tell me it's some kind of weapon?\""

#. Occurrence 7_2:600:9208: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0006; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:600
msgctxt "text_id=9208 | speaker=aoko"
msgid "「楽器よそれ。エレキはともかく、アコギは音楽室で似たようなのあったでしょう。あとこれ以上<青青|あおあお>言ったら、そのとんがってるので殴るからね」"
msgstr "\"It's a musical instrument. I understand if you've never seen an electric one, but you must've seen an acoustic guitar in the music room. Keep talking, though, and you'll soon see if it also works as a weapon.\""

#. Occurrence 7_2:632:9209: scene=7_2
#: 7_2:632
msgctxt "text_id=9209 | speaker=unknown"
msgid "　やっぱり武器じゃないか、という感想を<堪|こら>えて、草十郎もクッションに腰を下ろす。"
msgstr "  Soujyuro plopped himself down onto a cushion, struggling to suppress the desire to retort that it was a weapon after all."

#. Occurrence 7_2:684:9210: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0005; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:684
msgctxt "text_id=9210 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 7_2:706:9211: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0007; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:706
msgctxt "text_id=9211 | speaker=aoko"
msgid "「ちょっとは落ち着きなさいよ。いつもは耳の遠い大型犬みたいに鈍感なクセに。何か気になるものでもあるの？」"
msgstr "\"Don't play the victim. Usually you're as oblivious as an old and deaf dog. What's got you worked up this time?\""

#. Occurrence 7_2:725:9212: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0006; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:725
msgctxt "text_id=9212 | speaker=soujuurou"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 7_2:730:9213: scene=7_2
#: 7_2:730
msgctxt "text_id=9213 | speaker=unknown"
msgid "　この場合、鈍感なのは青子の方なのだが、"
msgstr "  In fact it was Aoko who was oblivious for once."

#. Occurrence 7_2:735:9214: scene=7_2
#: 7_2:735
msgctxt "text_id=9214 | speaker=unknown"
msgid "　草十郎もなぜ自分が落ち着かないのか分かっていないので、鈍感なのはお互い様である。"
msgstr "  For his part, Soujyuro could not figure out why he felt so restless either. Suffice it to say, they were both pretty clueless in this moment."

#. Occurrence 7_2:759:9215: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0008; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:759
msgctxt "text_id=9215 | speaker=aoko"
msgid "「あ、もしかして内装？　この部屋の家具のグレードが居間とは違うから不思議がってるのね。"
msgstr "\"Is it the way I decorated my room? My furniture's totally different to the stuff in the drawing room, so I understand if it seems a little weird."

#. Occurrence 7_2:765:9216: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0009; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:765
msgctxt "text_id=9216 | speaker=aoko"
msgid "　ここ、ベッド以外は私の家から持ちこんだ物なの。引っ越してから二年経つけど、まだ屋敷には馴染んでないでしょ？」"
msgstr "  I brought everything from home except the bed. It's been two years since I moved here, but I still don't feel like me and my stuff belong in this big, old house.\""

#. Occurrence 7_2:801:9217: scene=7_2
#: 7_2:801
msgctxt "text_id=9217 | speaker=unknown"
msgid "　そわそわと落ち着かない草十郎の心情を曲解、納得いったのか、青子は自分の勉強を始めてしまう。"
msgstr "  Though she misunderstood the real reason for Soujyuro's nervousness, Aoko seemed satisfied that she had resolved Soujyuro's anxiety for the time being and returned to her studies."

#. Occurrence 7_2:806:9218: scene=7_2
#: 7_2:806
msgctxt "text_id=9218 | speaker=unknown"
msgid "　早送りのようにめくられていくノートと教科書。"
msgstr "  She flipped through her notes and textbooks as if fast-forwarding a tape."

#. Occurrence 7_2:811:9219: scene=7_2
#: 7_2:811
msgctxt "text_id=9219 | speaker=unknown"
msgid "　そこに余人の立ち入る隙間はない。"
msgstr "  There was no opening for an outsider like him to intrude in her high-speed study session."

#. Occurrence 7_2:831:9220: scene=7_2
#: 7_2:831
msgctxt "text_id=9220 | speaker=unknown"
msgid "　青子の背中から立ち上るオーラに圧倒され、草十郎も気を引き締めてテーブルに向かった。"
msgstr "  Repelled by her intensity, he retreated to his table. He was at least sensitive enough to pick up on her desire to be left alone."

#. Occurrence 7_2:836:9221: scene=7_2
#: 7_2:836
msgctxt "text_id=9221 | speaker=unknown"
msgid "　完全に無視されていながら平然と自分の作業に入れるあたり、草十郎も只者ではない。"
msgstr "  It was a testament to Soujyuro that having his needs utterly ignored was now second nature to him, to the extent that he could now happily go about his business in solitude."

#. Occurrence 7_2:885:9222: scene=7_2
#: 7_2:885
msgctxt "text_id=9222 | speaker=unknown"
msgid "　それから二時間。"
msgstr "  Two hours passed."

#. Occurrence 7_2:908:9223: scene=7_2
#: 7_2:908
msgctxt "text_id=9223 | speaker=unknown"
msgid "　十一時近くなって、ようやく青子の<集中力|スピード>が減速していった。"
msgstr "  Then, as the clock neared eleven, Aoko's speed and concentration began to slip."

#. Occurrence 7_2:913:9224: scene=7_2
#: 7_2:913
msgctxt "text_id=9224 | speaker=unknown"
msgid "　それを<頃合|ころあ>いと見て、草十郎は凛と伸びた青子の背中に話しかけた。"
msgstr "  Seeing his window of opportunity, Soujyuro seized the moment to strike up a conversation."

#. Occurrence 7_2:934:9225: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0007; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:934
msgctxt "text_id=9225 | speaker=soujuurou"
msgid "「蒼崎、ちょっといいかな」"
msgstr "\"Aozaki, can I talk to you for a minute?\""

#. Occurrence 7_2:940:9226: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0010; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:940
msgctxt "text_id=9226 | speaker=aoko"
msgid "「ん、なに？」"
msgstr "\"What is it?\""

#. Occurrence 7_2:946:9227: scene=7_2
#: 7_2:946
msgctxt "text_id=9227 | speaker=unknown"
msgid "　遠慮がちな声に、青子は振り向かずに応えた。"
msgstr "  She spoke hesitantly, not bothering to turn to face him."

#. Occurrence 7_2:951:9228: scene=7_2
#: 7_2:951
msgctxt "text_id=9228 | speaker=unknown"
msgid "　減速しているといっても、青子のノートをめくる動作は止まらない。"
msgstr "  She continued to flip the pages of her textbook, albeit at a slower speed than before."

#. Occurrence 7_2:972:9229: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0008; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:972
msgctxt "text_id=9229 | speaker=soujuurou"
msgid "「この三日間、蒼崎たちの夕食事情を見てきたけど。"
msgstr "\"I noticed how you and Alice have been acting at dinner these past three days, and, uh..."

#. Occurrence 7_2:978:9230: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0009; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:978
msgctxt "text_id=9230 | speaker=soujuurou"
msgid "　君たちの食事はいつもああなのか？」"
msgstr "  Is it always like that?\""

#. Occurrence 7_2:984:9231: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0011; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:984
msgctxt "text_id=9231 | speaker=aoko"
msgid "「そうだけど、おかしい？」"
msgstr "\"Yes, it's normal. Do we not look normal?\""

#. Occurrence 7_2:1000:9232: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0010; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:1000
msgctxt "text_id=9232 | speaker=soujuurou"
msgid "「む……そう言われると困るな。"
msgstr "\"Hm... I'm not sure how to answer that."

#. Occurrence 7_2:1011:9233: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0011; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:1011
msgctxt "text_id=9233 | speaker=soujuurou"
msgid "　ただ、学校じゃみんな楽しそうだった。誰かと食事を摂るって事は、ああいう風になるコトだって思ってた。だから、もしかすると」"
msgstr "  It's just, at school people seem to enjoy eating together, so I thought it was strange that the two of you don't look like you enjoy it, and I thought maybe it's because of... you know...\""

#. Occurrence 7_2:1045:9234: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0012; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1045
msgctxt "text_id=9234 | speaker=aoko"
msgid "「もしかしないわよ。別にアンタのせいで有珠と話さないワケじゃないわ。私たちはいつもああだから」"
msgstr "\"Don't worry, it's not because of you that we haven't been talking at mealtimes. We've never talked to each other during meals.\""

#. Occurrence 7_2:1051:9235: scene=7_2
#: 7_2:1051
msgctxt "text_id=9235 | speaker=unknown"
msgid "　平然と語る青子の背中は、そんな事実をどうも思っていないようだった。"
msgstr "  Aoko spoke calmly with her back still turned, seemingly unaware of what he was getting at."

#. Occurrence 7_2:1082:9236: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0012; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:1082
msgctxt "text_id=9236 | speaker=soujuurou"
msgid "「張りつめた食卓だな。"
msgstr "\"Well, it can get pretty tense."

#. Occurrence 7_2:1088:9237: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0013; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:1088
msgctxt "text_id=9237 | speaker=soujuurou"
msgid "　蒼崎と有珠は、仲がいいと思ってたのに」"
msgstr "  And here I thought you two were close friends.\""

#. Occurrence 7_2:1094:9238: scene=7_2
#: 7_2:1094
msgctxt "text_id=9238 | speaker=unknown"
msgid "　青子は否定も肯定もしない。"
msgstr "  She neither confirmed nor denied his statement."

#. Occurrence 7_2:1099:9239: scene=7_2
#: 7_2:1099
msgctxt "text_id=9239 | speaker=unknown"
msgid "　ただ、草十郎の残念そうな呟きが、少しだけ意外だった。"
msgstr "  She was, however, surprised by the disappointed tone in which he had made it."

#. Occurrence 7_2:1120:9240: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0013; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1120
msgctxt "text_id=9240 | speaker=aoko"
msgid "「ま、張りつめた食卓っていうのは合ってるわね。"
msgstr "\"You're not wrong. It can get tense."

#. Occurrence 7_2:1126:9241: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0014; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1126
msgctxt "text_id=9241 | speaker=aoko"
msgid "　有珠が何回アンタの飲み物にメスカリンを入れてたかなんてもう覚えてないし、昨日なんか堂々とサラダの中にナナカマドなんか混ざってるし。"
msgstr "  I can't remember how many times she's put mescaline in your drink, and yesterday she was adding rowan to your salad."

#. Occurrence 7_2:1132:9242: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0015; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1132
msgctxt "text_id=9242 | speaker=aoko"
msgid "　……ほんと、あの娘なに考えてるんだろう」"
msgstr "  ...Beats me what the hell she was thinking.\""

#. Occurrence 7_2:1137:9243: scene=7_2
#: 7_2:1137
msgctxt "text_id=9243 | speaker=unknown"
msgid "　思い出すように苦笑しながら、青子は教科書をめくっていく。"
msgstr "  A bitter smile spread across her face in reminiscence. The pages of her textbook continued to turn."

#. Occurrence 7_2:1163:9244: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0014; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:1163
msgctxt "text_id=9244 | speaker=soujuurou"
msgid "「メスカリン……？」"
msgstr "\"Mescaline? What's that?\""

#. Occurrence 7_2:1169:9245: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0016; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1169
msgctxt "text_id=9245 | speaker=aoko"
msgid "「サボテンからとれる<植物塩基|アルカロイド>よ。有珠が使う以上、ただの幻覚剤じゃないでしょうけどね。……っと、私はこんなもんでいっか」"
msgstr "\"It's a hallucinogenic alkaloid produced by the peyote cactus. I'm assuming it's more than just your average hallucinogen if Alice is using it, though... And I'm done!\""

#. Occurrence 7_2:1178:9246: scene=7_2
#: 7_2:1178
msgctxt "text_id=9246 | speaker=unknown"
msgid "　そう言う彼女の手元で、ぱたん、と四冊目の教科書が閉じられた。"
msgstr "  With that she slammed shut her fourth textbook of the night."

#. Occurrence 7_2:1184:9247: scene=7_2
#: 7_2:1184
msgctxt "text_id=9247 | speaker=unknown"
msgid "　今まで微動だにしなかった背中がくるりと反転する。"
msgstr "  After having scarcely changed position the whole night she finally turned in her chair to face him."

#. Occurrence 7_2:1221:9248: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0017; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1221
msgctxt "text_id=9248 | speaker=aoko"
msgid "「さ、今度はアンタを仕込まなくちゃね。"
msgstr "\"Now it's time to put you to work."

#. Occurrence 7_2:1227:9249: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0018; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1227
msgctxt "text_id=9249 | speaker=aoko"
msgid "　今日の四科目の答案、実に草十郎らしい出来栄えで卒倒しそうになったわ、私」"
msgstr "  I don't know what else I was expecting, but I still almost fainted when I saw your scores.\""

#. Occurrence 7_2:1233:9250: scene=7_2
#: 7_2:1233
msgctxt "text_id=9250 | speaker=unknown"
msgid "　口調は楽しそうに、けれど視線は不機嫌そうに、青子はあぐらをかく草十郎を見つめる。"
msgstr "  Her tone was light but her gaze was heavy as she stared at Soujyuro, seated cross-legged on the floor."

#. Occurrence 7_2:1254:9251: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0019; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1254
msgctxt "text_id=9251 | speaker=aoko"
msgid "「現国、地理、数学、電子工学。"
msgstr "\"Modern literature, geography, math, and electronics..."

#. Occurrence 7_2:1260:9252: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0020; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1260
msgctxt "text_id=9252 | speaker=aoko"
msgid "　あの調子であと二日続けたら、冬休みが消えるのは当然でしょうね。そうなると困るのは私なのよ、実際」"
msgstr "  If you don't up your grades over the next two days your winter break is as good as gone. And that'll be more of a problem for me than you.\""

#. Occurrence 7_2:1295:9253: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0015; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:1295
msgctxt "text_id=9253 | speaker=soujuurou"
msgid "「いや、俺も困るぞ。休みなのに学校に行くのは、なんか気が乗らない」"
msgstr "\"I disagree. I think it'll be worse. Going to school during the break would not work out for me.\""

#. Occurrence 7_2:1300:9254: scene=7_2
#: 7_2:1300
msgctxt "text_id=9254 | speaker=unknown"
msgid "　冷静に誤りを訂正する草十郎。"
msgstr "  Soujyuro calmly corrected her."

#. Occurrence 7_2:1322:9255: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0021; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1322
msgctxt "text_id=9255 | speaker=aoko"
msgid "「そりゃあ私の台詞だ！　アンタが学校に行くってコトは、必然、こっちまでとばっちりがくるっての！」"
msgstr "\"For you?! If you have to go to school over the break, what do you think will happen to me?\""

#. Occurrence 7_2:1327:9256: scene=7_2
#: 7_2:1327
msgctxt "text_id=9256 | speaker=unknown"
msgid "　思い出したくもない、山城教諭のニヤニヤ顔を想像してしまう青子だった。"
msgstr "  All she could think about, as much as she tried not to, was Mr. Yamasiro and his annoying grin."

#. Occurrence 7_2:1353:9257: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0022; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1353
msgctxt "text_id=9257 | speaker=aoko"
msgid "「それ以前に、私の目が黒いうちはオール赤なんて<生徒|ヤツ>は許さない。"
msgstr "\"I cannot allow any student to fail every single class. Not on my watch."

#. Occurrence 7_2:1359:9258: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0023; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1359
msgctxt "text_id=9258 | speaker=aoko"
msgid "　本来なら性根から叩き直すところだけど……」"
msgstr "  If I could beat good grades out of you I would.\""

#. Occurrence 7_2:1380:9259: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0024; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1380
msgctxt "text_id=9259 | speaker=aoko"
msgid "「ま、アンタは色々事情があるから、とりあえず点数だけで勘弁してあげる。"
msgstr "\"Lucky for you, you have 'extenuating circumstances,' shall we say, so I'll give you a pass just this once."

#. Occurrence 7_2:1391:9260: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0025; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1391
msgctxt "text_id=9260 | speaker=aoko"
msgid "　私もテストは一夜漬けで片付ける方だから、アンタ一人仕込むのに、そう時間はかからないだろうし」"
msgstr "  A good all-nighter is usually enough for me to prepare for exams, so it shouldn't take too long to get you up to speed either.\""

#. Occurrence 7_2:1412:9261: scene=7_2
#: 7_2:1412
msgctxt "text_id=9261 | speaker=unknown"
msgid "　青子の宣言に、草十郎は露骨に表情を曇らせる。"
msgstr "  Soujyuro's expression openly soured in response to her declaration."

#. Occurrence 7_2:1412:9262: scene=7_2
#: 7_2:1412
msgctxt "text_id=9262 | speaker=unknown"
msgid "　そんなお節介はいらない、とでも言いたげな顔である。"
msgstr "  It was obvious he did not think he needed her meddling in his studies."

#. Occurrence 7_2:1446:9263: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0026; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1446
msgctxt "text_id=9263 | speaker=aoko"
msgid "「アンタね。苦労するのは私と貴方、どっちだと思う？」"
msgstr "\"Oh, please. Which of us do you think is going to have the harder time of it, me or you?\""

#. Occurrence 7_2:1451:9264: scene=7_2
#: 7_2:1451
msgctxt "text_id=9264 | speaker=unknown"
msgid "　間違いなく自分だな、と運命的に悟りながらも草十郎は静かにうなだれた。"
msgstr "  Soujyuro got the feeling that it would be him, but he nodded slowly nonetheless."

#. Occurrence 7_2:1456:9265: scene=7_2
#: 7_2:1456
msgctxt "text_id=9265 | speaker=unknown"
msgid "　どのみち断ったところで断りきれるはずがないし、青子の言う通り、苦労の度合いは彼女の方が大きいだろう。"
msgstr "  Then again, it would probably take more effort on her part than on his, and in any case he knew there was no way to talk her out of it."

#. Occurrence 7_2:1493:9266: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_2_0016; voice_prefix=A30; voice_category=3; scene=7_2
#: 7_2:1493
msgctxt "text_id=9266 | speaker=soujuurou"
msgid "「……この度は、ご迷惑をおかけします」"
msgstr "\"...I feel bad for making you do this.\""

#. Occurrence 7_2:1499:9267: scene=7_2
#: 7_2:1499
msgctxt "text_id=9267 | speaker=unknown"
msgid "　観念と感謝の意をこめて、ぺこりと一礼する草十郎。"
msgstr "  Soujyuro summarily bowed his head to show gratitude and willingness to work."

#. Occurrence 7_2:1535:9268: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0027; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1535
msgctxt "text_id=9268 | speaker=aoko"
msgid "「よろしい。"
msgstr "\"Good."

#. Occurrence 7_2:1542:9269: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0028; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1542
msgctxt "text_id=9269 | speaker=aoko"
msgid "安心なさい、私だって鬼じゃないから。"
msgstr "And don't worry, I'm not a demon, like they say."

#. Occurrence 7_2:1548:9270: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0029; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1548
msgctxt "text_id=9270 | speaker=aoko"
msgid "　別に平均点狙うってワケでもなし、予定通りこなしていけば三時には眠れるわよ」"
msgstr "  You can get less than average marks and still pass. You'll probably be able to go to bed by three.\""

#. Occurrence 7_2:1568:9271: scene=7_2
#: 7_2:1568
msgctxt "text_id=9271 | speaker=unknown"
msgid "　殊勝な教え子の態度に、青子は満足そうに頷いた。"
msgstr "  She nodded with satisfaction, pleased by his studious attitude."

#. Occurrence 7_2:1578:9272: scene=7_2
#: 7_2:1578
msgctxt "text_id=9272 | speaker=unknown"
msgid "　ほんとうに色々問題のある草十郎だが、この素直さがあれば大抵のコトはなんとか出来てしまうだろう、と。"
msgstr "  He had plenty of obstacles ahead of him, but that sense of humility might be enough to see him through."

#. Occurrence 7_2:1604:9273: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0030; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1604
msgctxt "text_id=9273 | speaker=aoko"
msgid "「……って、なにホトケ心だしてるんだ私。"
msgstr "\"Wait, what was I thinking? I can't afford to be this soft on you."

#. Occurrence 7_2:1623:9274: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0031; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1623
msgctxt "text_id=9274 | speaker=aoko"
msgid "　いい、静希君？　このあと頼られちゃたまんないから<釘|くぎ>さしておくけど、私がマンツーマンで誰かを仕込むなんてコト、滅多にないから。"
msgstr "  Sizuki, let me be straight about this... temporary arrangement. It's not every day I offer private, one-on-one lessons like this."

#. Occurrence 7_2:1629:9275: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_2_0032; voice_prefix=A10; voice_category=1; scene=7_2
#: 7_2:1629
msgctxt "text_id=9275 | speaker=aoko"
msgid "　これはあくまで、異例中の異例だって覚えておいてね」"
msgstr "  This is beyond rare, an exception among exceptions. And don't you go forgetting that.\""

#. Occurrence 7_2:1659:9276: scene=7_2
#: 7_2:1659
msgctxt "text_id=9276 | speaker=unknown"
msgid "　自分に言い聞かせるような青子の宣言に、えー、と顔を曇らせる草十郎。"
msgstr "  She spoke more to convince herself than him, but his expression still darkened."

#. Occurrence 7_2:1678:9277: scene=7_2
#: 7_2:1678
msgctxt "text_id=9277 | speaker=unknown"
msgid "　その顔の上に“拾ってください”なんて単語を連想してしまい、自らの甘さにうなだれる青子だった。"
msgstr "  It made one want to hang a side around his neck that read, \"please take me home,\" like an abandoned pet. Aoko chided herself for being so soft."

#. Occurrence 7_2:1686:9278: scene=7_2
#: 7_2:1686
msgctxt "text_id=9278 | speaker=unknown"
msgid "　そう言えば、初めて出会った日は雨だったっけ、などと思いながら。"
msgstr "  For some reason, in that moment she recalled that it had been raining the day they met each other."

#. Occurrence 7_3:39:9279: scene=7_3
#: 7_3:39
msgctxt "text_id=9279 | speaker=unknown"
msgid "　……時間は、砂が落ちるようにすぎていく。"
msgstr "  Time passed like the falling grains of an hourglass."

#. Occurrence 7_3:103:9280: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_9000; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:103
msgctxt "text_id=9280 | speaker=aoko"
msgid "「―――結局」"
msgstr "\"...Finished.\""

#. Occurrence 7_3:108:9281: scene=7_3
#: 7_3:108
msgctxt "text_id=9281 | speaker=unknown"
msgid "　窓から差しこむ朝の光に目を細めて、青子は何杯目かの紅茶を飲み干した。"
msgstr "  Aoko squinted as light poured through the window and she downed another cup of tea. She had lost count of exactly how many she had drank long ago."

#. Occurrence 7_3:123:9282: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0001; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:123
msgctxt "text_id=9282 | speaker=soujuurou"
msgid "「一晩かかったね、蒼崎」"
msgstr "\"And it only took the whole night, eh, Aozaki?\""

#. Occurrence 7_3:128:9283: scene=7_3
#: 7_3:128
msgctxt "text_id=9283 | speaker=unknown"
msgid "　不思議だ、とばかりに青子の独白を拾う草十郎。"
msgstr "  Soujyuro picked up on what she left unspoken."

#. Occurrence 7_3:148:9284: scene=7_3
#: 7_3:148
msgctxt "text_id=9284 | speaker=unknown"
msgid "　青子にはいつもの覇気がない。"
msgstr "  Aoko had used up all her pep."

#. Occurrence 7_3:153:9285: scene=7_3
#: 7_3:153
msgctxt "text_id=9285 | speaker=unknown"
msgid "　徹夜明けプラス、一晩じゅう草十郎を怒鳴りつけた疲労のためだ。"
msgstr "  In staying up all night, but also in shouting at him."

#. Occurrence 7_3:158:9286: scene=7_3
#: 7_3:158
msgctxt "text_id=9286 | speaker=unknown"
msgid "　一方、草十郎は昨夜とまったく同じ顔色である。"
msgstr "  He looked pale and uncomfortable, just as he had all night long."

#. Occurrence 7_3:188:9287: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0000; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:188
msgctxt "text_id=9287 | speaker=aoko"
msgid "「……ええ。甘く見てたわ、アンタの事を」"
msgstr "\"I underestimated you, Soujyuro Sizuki.\""

#. Occurrence 7_3:199:9288: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0002; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:199
msgctxt "text_id=9288 | speaker=soujuurou"
msgid "「だから、誉めても何も出ないって」"
msgstr "\"Come on, Aozaki, you know I get weirded out when you compliment me.\""

#. Occurrence 7_3:210:9289: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0001; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:210
msgctxt "text_id=9289 | speaker=aoko"
msgid "「ある意味、誉めるに値するかもね……」"
msgstr "\"No, no. You deserve a pat on the head.\""

#. Occurrence 7_3:220:9290: scene=7_3
#: 7_3:220
msgctxt "text_id=9290 | speaker=unknown"
msgid "　呆れる青子だが、半分は本気で感心していた。"
msgstr "  She was at the end of her rope, but she could not help the bit of pride that swelled up in her."

#. Occurrence 7_3:257:9291: scene=7_3
#: 7_3:257
msgctxt "text_id=9291 | speaker=unknown"
msgid "　この山奥育ちには下積みがなさすぎる。"
msgstr "  His lack of even the most basic comprehension was shocking, even taking into account his upbringing in the wilderness."

#. Occurrence 7_3:262:9292: scene=7_3
#: 7_3:262
msgctxt "text_id=9292 | speaker=unknown"
msgid "　控えめに言うと、かろうじて中学生レベルの学力だ。"
msgstr "  His ability was that of a middle school student, and that was being generous."

#. Occurrence 7_3:267:9293: scene=7_3
#: 7_3:267
msgctxt "text_id=9293 | speaker=unknown"
msgid "　なので、理解、修得を目的にした試験勉強は諦めるしかない。"
msgstr "  Preparing him for exams by teaching him new concepts and ideas was a waste of time."

#. Occurrence 7_3:272:9294: scene=7_3
#: 7_3:272
msgctxt "text_id=9294 | speaker=unknown"
msgid "　基本は点数稼ぎの暗記だけ。"
msgstr "  Rote memorization was his only hope for passing."

#. Occurrence 7_3:277:9295: scene=7_3
#: 7_3:277
msgctxt "text_id=9295 | speaker=unknown"
msgid "　明日になれば忘れるハリボテの一夜漬けでいい、と青子は教官役を買ってでたのだ。"
msgstr "  Everything he memorized could collapse like a house of cards afterwards for all she cared. So long as he remembered for his exams."

#. Occurrence 7_3:297:9296: scene=7_3
#: 7_3:297
msgctxt "text_id=9296 | speaker=unknown"
msgid "　……誤算だったのは、思いの外、この生徒が優秀だった事だろう。"
msgstr "  Assuming he had the capacity to be a good student in the first place had been her mistake."

#. Occurrence 7_3:302:9297: scene=7_3
#: 7_3:302
msgctxt "text_id=9297 | speaker=unknown"
msgid "　四教科の試験範囲を終えるのに一晩かかってしまったが、それでもここまで熱心に、覚えたことを無駄にしないよう真剣に取り組むとは思わなかった。"
msgstr "  It took all night to cover the content for just four exams, and she still did not feel confident he could apply what he so earnestly tried to memorize."

#. Occurrence 7_3:339:9298: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0002; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:339
msgctxt "text_id=9298 | speaker=aoko"
msgid "「でもねぇ。真面目なのはいいコトだけど、アンタ、暗記するのに時間かかりすぎ」"
msgstr "\"I appreciate your effort, but you just take too long to memorize new information.\""

#. Occurrence 7_3:352:9299: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0003; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:352
msgctxt "text_id=9299 | speaker=soujuurou"
msgid "「そこは大目に見てほしい。今まで、頭より体で覚えるコトのが多かったんだ」"
msgstr "\"Come on, go easy on me. I'm used to learning things with my body, not my head.\""

#. Occurrence 7_3:388:9300: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0003; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:388
msgctxt "text_id=9300 | speaker=aoko"
msgid "「…………」"
msgstr "\"...\""

#. Occurrence 7_3:393:9301: scene=7_3
#: 7_3:393
msgctxt "text_id=9301 | speaker=unknown"
msgid "　青子は仕方なさげにため息をつく。"
msgstr "  Aoko let out an exasperated sigh."

#. Occurrence 7_3:398:9302: scene=7_3
#: 7_3:398
msgctxt "text_id=9302 | speaker=unknown"
msgid "　たしかに、山奥での生活で重要なのは知識ではなく経験則なのだろう、と。"
msgstr "  Naturally, physical prowess mattered more in mountain life than the intellectual kind, but still."

#. Occurrence 7_3:424:9303: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0004; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:424
msgctxt "text_id=9303 | speaker=aoko"
msgid "「……まあいいわ。これで山城からアンタの成績について相談される事もないでしょうし。"
msgstr "\"Whatever. At least now you should do well enough to satisfy Yamasiro."

#. Occurrence 7_3:430:9304: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0005; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:430
msgctxt "text_id=9304 | speaker=aoko"
msgid "　紅茶、もう一杯<淹|い>れてくれる？」"
msgstr "  Mind making some more tea?\""

#. Occurrence 7_3:448:9305: scene=7_3
#: 7_3:448
msgctxt "text_id=9305 | speaker=unknown"
msgid "　疲れきって背中を伸ばす青子に、はいはいと応えて立ち上がる草十郎。"
msgstr "  Soujyuro stood up and obeyed, as Aoko stretched her aching back."

#. Occurrence 7_3:453:9306: scene=7_3
#: 7_3:453
msgctxt "text_id=9306 | speaker=unknown"
msgid "　ティーバッグの紅茶は大量に買いこんでいたらしく、まだ十分に余っている。"
msgstr "  She had apparently bought the tea bags in bulk, so there were still plenty to use."

#. Occurrence 7_3:486:9307: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0004; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:486
msgctxt "text_id=9307 | speaker=soujuurou"
msgid "「まったく。無駄遣いだな、蒼崎は」"
msgstr "\"Good grief. This is so wasteful.\""

#. Occurrence 7_3:492:9308: scene=7_3
#: 7_3:492
msgctxt "text_id=9308 | speaker=unknown"
msgid "　青子に聞こえないよう呟く。"
msgstr "  He spoke under his breath so she wouldn't hear."

#. Occurrence 7_3:497:9309: scene=7_3
#: 7_3:497
msgctxt "text_id=9309 | speaker=unknown"
msgid "　一晩<厳|きび>しく教えられた反撃か、青子のだらしのない点が見られて嬉しいらしい。"
msgstr "  It made him somehow happy to see her so tired and unfocused after the grueling all-night lesson she had given him."

#. Occurrence 7_3:502:9310: scene=7_3
#: 7_3:502
msgctxt "text_id=9310 | speaker=unknown"
msgid "　……その買いすぎたティーバッグは失敗ではなく、<今|・><夜|・>の補給物資になる事を、この時点では想像もできない草十郎だった。"
msgstr "  It did not cross his mind that the excess tea bags, far from being an indulgent purchase, were purchased intentionally to sustain them through the night."

#. Occurrence 7_3:541:9311: scene=7_3
#: 7_3:541
msgctxt "text_id=9311 | speaker=unknown"
msgid "　そんな平和ぼけしまくった草十郎を、青子は弛緩した面持ちで眺めている。"
msgstr "  A relaxed expression came across Aoko's face as she watched him, naive and peaceful as could be."

#. Occurrence 7_3:568:9312: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0006; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:568
msgctxt "text_id=9312 | speaker=aoko"
msgid "「……悪くないけど。せめて、リーフティーで淹れられるように仕込まなくちゃダメかな……」"
msgstr "\"Not bad. But I should teach him how to make it from tea leaves instead.\""

#. Occurrence 7_3:573:9313: scene=7_3
#: 7_3:573
msgctxt "text_id=9313 | speaker=unknown"
msgid "　独り言じみた青子の所感が聞こえたのか、草十郎はひょいと青子を振り返る。"
msgstr "  Seeming to have overheard her not-so inner monologue, Soujyuro made to face her."

#. Occurrence 7_3:610:9314: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0005; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:610
msgctxt "text_id=9314 | speaker=soujuurou"
msgid "「やっぱり味は違うのか？」"
msgstr "\"Does it really make a difference?\""

#. Occurrence 7_3:631:9315: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0007; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:631
msgctxt "text_id=9315 | speaker=aoko"
msgid "「違う違う、もうぜーんぜん。"
msgstr "\"Yeah, big time."

#. Occurrence 7_3:637:9316: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0008; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:637
msgctxt "text_id=9316 | speaker=aoko"
msgid "　……ま、正直私はどうでもいいんだけど、有珠はね、かなりお茶にはうるさいよ。"
msgstr "  ...Although, honestly I don't really care. Alice is the one who's really picky about her tea."

#. Occurrence 7_3:648:9317: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0009; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:648
msgctxt "text_id=9317 | speaker=aoko"
msgid "　―――そうだ。草十郎、有珠と上手くいってる？」"
msgstr "  Which reminds me. How are things going between you two?\""

#. Occurrence 7_3:668:9318: scene=7_3
#: 7_3:668
msgctxt "text_id=9318 | speaker=unknown"
msgid "　まだ教科書やらテキストやらが散乱しているテーブルに体を寝かせて、楽しそうに青子は言う。"
msgstr "  Aoko cheerfully slumped over the table, now covered with textbooks and scribbled notes."

#. Occurrence 7_3:673:9319: scene=7_3
#: 7_3:673
msgctxt "text_id=9319 | speaker=unknown"
msgid "　そんな彼女に、草十郎は恨みがましい視線を送った。"
msgstr "  Soujyuro watched her with a hint of resentment in his eyes."

#. Occurrence 7_3:712:9320: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0006; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:712
msgctxt "text_id=9320 | speaker=soujuurou"
msgid "「彼女と会えるのは食事の時だけで、食事といったらアレだろう。どうやって仲良くなれって言うんだ」"
msgstr "\"We only ever see each other at dinner, and you know how that goes. Honestly, I don't know why I should bother getting along with her.\""

#. Occurrence 7_3:733:9321: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0010; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:733
msgctxt "text_id=9321 | speaker=aoko"
msgid "「そう？　私はじゅうぶん脈アリだと思ったけど。"
msgstr "\"Really? And here's me thinking you'd have lots of motivation to play nice."

#. Occurrence 7_3:739:9322: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0011; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:739
msgctxt "text_id=9322 | speaker=aoko"
msgid "　<草|そ><十|っ><郎|ち>は有珠を恐がってないし、有珠は<草|そ><十|っ><郎|ち>を追い出す理由を見つけようと躍起になってるし。"
msgstr "  It's not like you're scared of her, for one. Plus, she's looking for any reason to kick you out."

#. Occurrence 7_3:745:9323: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0012; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:745
msgctxt "text_id=9323 | speaker=aoko"
msgid "　いい条件よ、これって」"
msgstr "  Sounds like a great reason to make nice, if you ask me.\""

#. Occurrence 7_3:782:9324: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0007; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:782
msgctxt "text_id=9324 | speaker=soujuurou"
msgid "「……ぜんぜん分からないな。"
msgstr "\"...Are you sure about that?"

#. Occurrence 7_3:788:9325: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0008; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:788
msgctxt "text_id=9325 | speaker=soujuurou"
msgid "　あの娘とこっちの関係は、遊園地前の蒼崎と俺の関係と同じじゃないか。いったいドコがいい条件なんだ？」"
msgstr "  Because to me, it feels a lot like me and you before everything at the amusement park. How is that a 'good' reason?\""

#. Occurrence 7_3:820:9326: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0013; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:820
msgctxt "text_id=9326 | speaker=aoko"
msgid "「とりあえず反目しあってはいないでしょ？"
msgstr "\"My point is, there's no hostility between you, right?"

#. Occurrence 7_3:826:9327: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0014; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:826
msgctxt "text_id=9327 | speaker=aoko"
msgid "　一方通行の関係だけど、それはそれ、有珠にしちゃあ上出来っていうか。理由を探している時点で可能性アリってね。"
msgstr "  It's a one-sided relationship, but that's not actually bad considering this is Alice we're talking about. You have a chance as long as she hasn't found a reason to off you."

#. Occurrence 7_3:832:9328: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0015; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:832
msgctxt "text_id=9328 | speaker=aoko"
msgid "　あの娘は反感に応える事がクセになっちゃってるから、大抵、相手を自滅させちゃうのよ」"
msgstr "  She's usually quick to respond to hostility, and it's her enemies that usually end up destroying themselves.\""

#. Occurrence 7_3:873:9329: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0009; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:873
msgctxt "text_id=9329 | speaker=soujuurou"
msgid "「？？」"
msgstr "\"?\""

#. Occurrence 7_3:878:9330: scene=7_3
#: 7_3:878
msgctxt "text_id=9330 | speaker=unknown"
msgid "　抽象的な青子の言に、草十郎はますます首を傾げる。"
msgstr "  Her ominous words only confused Soujyuro further."

#. Occurrence 7_3:899:9331: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0016; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:899
msgctxt "text_id=9331 | speaker=aoko"
msgid "「知ってしまえば単純な話なんだけどね、あの娘の場合。"
msgstr "\"Once you understand that, it's actually pretty simple."

#. Occurrence 7_3:905:9332: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0017; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:905
msgctxt "text_id=9332 | speaker=aoko"
msgid "　ただ―――」"
msgstr "  Except...\""

#. Occurrence 7_3:910:9333: scene=7_3
#: 7_3:910
msgctxt "text_id=9333 | speaker=unknown"
msgid "　知ったところで、そのスタンスを実践できるかは別の話。"
msgstr "  Whether or not he could put it into practice was another story altogether."

#. Occurrence 7_3:943:9334: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0010; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:943
msgctxt "text_id=9334 | speaker=soujuurou"
msgid "「難しいよ、蒼崎は」"
msgstr "\"Sounds like a difficult situation, then, Aozaki.\""

#. Occurrence 7_3:949:9335: scene=7_3
#: 7_3:949
msgctxt "text_id=9335 | speaker=unknown"
msgid "　言いつつ、草十郎はふたり分のティーカップを持ってテーブルに戻る。"
msgstr "  He carried their tea cups back to the table as he spoke."

#. Occurrence 7_3:955:9336: scene=7_3
#: 7_3:955
msgctxt "text_id=9336 | speaker=unknown"
msgid "青子はカップを受け取ると、疲れを打ち消すようにと口に運んだ。"
msgstr "Aoko picked hers up and took a sip as if to dispel her exhaustion."

#. Occurrence 7_3:986:9337: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0011; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:986
msgctxt "text_id=9337 | speaker=soujuurou"
msgid "「でも、たしかに君の言う通りだ。"
msgstr "\"But, I think you're right."

#. Occurrence 7_3:992:9338: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0012; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:992
msgctxt "text_id=9338 | speaker=soujuurou"
msgid "　俺はまだ、あの<娘|こ>の顔しか知らない。久遠寺有珠という名前すら<定|さだ>かじゃないのは、問題があるね」"
msgstr "  I still don't know her at all. The problem is, my knowledge of Alice Kuonji ends with her name.\""

#. Occurrence 7_3:998:9339: scene=7_3
#: 7_3:998
msgctxt "text_id=9339 | speaker=unknown"
msgid "　青子に<倣|なら>ってカップに口をつける。"
msgstr "  He followed Aoko's lead and took a sip of his own."

#. Occurrence 7_3:1004:9340: scene=7_3
#: 7_3:1004
msgctxt "text_id=9340 | speaker=unknown"
msgid "草十郎のカップに注がれたのは紅茶ではなく、ただのお湯だ。"
msgstr "His cup contained not tea but plain hot water."

#. Occurrence 7_3:1029:9341: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0018; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1029
msgctxt "text_id=9341 | speaker=aoko"
msgid "「ふーん。あの娘のこと、教えてほしい？」"
msgstr "\"Hm. Well, would you like me to tell you a bit about her?\""

#. Occurrence 7_3:1034:9342: scene=7_3
#: 7_3:1034
msgctxt "text_id=9342 | speaker=unknown"
msgid "　真横に座った草十郎を<覗|のぞ>きこむ青子。"
msgstr "  Aoko scrutinized him carefully as she sat."

#. Occurrence 7_3:1039:9343: scene=7_3
#: 7_3:1039
msgctxt "text_id=9343 | speaker=unknown"
msgid "　まっとうな人間なら見惚れかねない青子の仕草に、"
msgstr "  Most boys would have been captivated by her gaze in that moment..."

#. Occurrence 7_3:1051:9344: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0013; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1051
msgctxt "text_id=9344 | speaker=soujuurou"
msgid "「いや。そういう事は、本人に訊いてあげるべきだと思う」"
msgstr "\"No. I think I should ask her myself.\""

#. Occurrence 7_3:1056:9345: scene=7_3
#: 7_3:1056
msgctxt "text_id=9345 | speaker=unknown"
msgid "　彼は真摯に、居もしない少女に語りかけるよう、きっぱりと返答した。"
msgstr "  ...but he ignored her and stared straight ahead as if speaking directly to Alice herself."

#. Occurrence 7_3:1083:9346: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0019; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1083
msgctxt "text_id=9346 | speaker=aoko"
msgid "「……そうね。"
msgstr "\"...Fine."

#. Occurrence 7_3:1090:9347: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0020; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1090
msgctxt "text_id=9347 | speaker=aoko"
msgid "ほんと、アンタって有珠好みの対応をするわ。"
msgstr "You really want to do this her way, don't you?"

#. Occurrence 7_3:1102:9348: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0021; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1102
msgctxt "text_id=9348 | speaker=aoko"
msgid "　ね。前から気になってたけど、客室で有珠に何を言ったの？　いくら私との約束とはいえ、あの娘が部外者を半日も放置するなんてあり得ないのよ？」"
msgstr "  Speaking of which, what exactly did you say to her in the guest room? I know she and I have an agreement, but I've never known her to just ignore a visitor for half a day.\""

#. Occurrence 7_3:1113:9349: scene=7_3
#: 7_3:1113
msgctxt "text_id=9349 | speaker=unknown"
msgid "　あの時―――"
msgstr "  He thought back to that moment."

#. Occurrence 7_3:1174:9350: scene=7_3
#: 7_3:1174
msgctxt "text_id=9350 | speaker=unknown"
msgid "　客室で目が覚めて、有珠と交わした二、三の言葉を草十郎は思い出した。"
msgstr "  He could recall only two or three words he had exchanged with Alice after awakening in the guest room."

#. Occurrence 7_3:1179:9351: scene=7_3
#: 7_3:1179
msgctxt "text_id=9351 | speaker=unknown"
msgid "　あの会話が特別なものであったとは思えないが、だからといって、気軽に話すことはできない。"
msgstr "  He did not recall the conversation being anything special, but he could not bring himself to casually share it with Aoko now."

#. Occurrence 7_3:1184:9352: scene=7_3
#: 7_3:1184
msgctxt "text_id=9352 | speaker=unknown"
msgid "　あれは、その―――"
msgstr "  After all..."

#. Occurrence 7_3:1220:9353: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0022; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1220
msgctxt "text_id=9353 | speaker=aoko"
msgid "「ね、どんな台詞であの娘の気を変えたの？」"
msgstr "\"Hey, what did you say that had such an effect on her?\""

#. Occurrence 7_3:1225:9354: scene=7_3
#: 7_3:1225
msgctxt "text_id=9354 | speaker=unknown"
msgid "　教えなさい、と詰め寄ってくる青子。"
msgstr "  Aoko eagerly pressed him for answers."

#. Occurrence 7_3:1231:9355: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0014; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1231
msgctxt "text_id=9355 | speaker=soujuurou"
msgid "「―――」"
msgstr "\"...\""

#. Occurrence 7_3:1236:9356: scene=7_3
#: 7_3:1236
msgctxt "text_id=9356 | speaker=unknown"
msgid "　草十郎はむう、と難しそうに眉をひそめる。"
msgstr "  Soujyuro frowned, unsure of what to say."

#. Occurrence 7_3:1241:9357: scene=7_3
#: 7_3:1241
msgctxt "text_id=9357 | speaker=unknown"
msgid "　有珠にとってどうであったかは不明だが、彼にとって、あれは<侵|おか>しがたいものだった。"
msgstr "  He did not know what the interaction had been like for Alice, but for him it had felt special, sacred almost."

#. Occurrence 7_3:1246:9358: scene=7_3
#: 7_3:1246
msgctxt "text_id=9358 | speaker=unknown"
msgid "　ある一点。なにを、誰に対して気遣ったか。"
msgstr "  The question was, why-and for whom-was he so concerned?"

#. Occurrence 7_3:1272:9359: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0023; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1272
msgctxt "text_id=9359 | speaker=aoko"
msgid "「ほら、白状しなさいってば。"
msgstr "\"Come on, just tell me."

#. Occurrence 7_3:1272:9360: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0023; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1272
msgctxt "text_id=9360 | speaker=aoko"
msgid "　隠しごとなんて似合わないわよ？」"
msgstr "  I can tell you're just dying to let it out.\""

#. Occurrence 7_3:1293:9361: scene=7_3
#: 7_3:1293
msgctxt "text_id=9361 | speaker=unknown"
msgid "　意地の悪い笑顔が、ずいっとにじり寄る。"
msgstr "  Her disconcerting smile moved even closer."

#. Occurrence 7_3:1299:9362: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0015; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1299
msgctxt "text_id=9362 | speaker=soujuurou"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 7_3:1304:9363: scene=7_3
#: 7_3:1304
msgctxt "text_id=9363 | speaker=unknown"
msgid "　どうにも黙秘ではやり過ごせそうにない。"
msgstr "  Soujyuro did not look like he was able to stay silent much longer."

#. Occurrence 7_3:1309:9364: scene=7_3
#: 7_3:1309
msgctxt "text_id=9364 | speaker=unknown"
msgid "　草十郎もいずれ知ることになるが、蒼崎青子はこれでゴシップ好きの困った一面があったりするのだ。"
msgstr "  As he would eventually come to realize, Aoko Aozaki had a sometimes troubling propensity to gossip."

#. Occurrence 7_3:1349:9365: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0016; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1349
msgctxt "text_id=9365 | speaker=soujuurou"
msgid "「―――まあ。あの<娘|こ>と何を話したかは言わないけど。"
msgstr "\"...Well, I can't tell you what we talked about."

#. Occurrence 7_3:1355:9366: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0017; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1355
msgctxt "text_id=9366 | speaker=soujuurou"
msgid "　今の蒼崎に比べれば、花も浪漫もなかったのだけは確かかな。"
msgstr "  But I will say that she wasn't as flirtatious as the way you are right now."

#. Occurrence 7_3:1362:9367: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0018; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1362
msgctxt "text_id=9367 | speaker=soujuurou"
msgid "さっきまでは蒼崎が鬼みたいだったから、いいもんだなって気が付かなかった」"
msgstr "After how strict you were earlier I didn't realize you had such a friendly side.\""

#. Occurrence 7_3:1368:9368: scene=7_3
#: 7_3:1368
msgctxt "text_id=9368 | speaker=unknown"
msgid "　横から覗きこんでいる青子に、草十郎は真顔で視線を返す。"
msgstr "  He stared directly into her eyes as he spoke."

#. Occurrence 7_3:1405:9369: scene=7_3
#: 7_3:1405
msgctxt "text_id=9369 | speaker=unknown"
msgid "　慌てて飛びのく青子。"
msgstr "  Aoko nearly leapt out of her seat in panic."

#. Occurrence 7_3:1410:9370: scene=7_3
#: 7_3:1410
msgctxt "text_id=9370 | speaker=unknown"
msgid "　言われてみれば、さっきまで体が触れ合うぐらい近寄っていた気がする。"
msgstr "  Now that he pointed it out, she realized their bodies were practically touching."

#. Occurrence 7_3:1437:9371: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0024; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1437
msgctxt "text_id=9371 | speaker=aoko"
msgid "「し、仕方ないでしょ、この方が効率良かったんだから。"
msgstr "\"S-So you noticed, huh? I was just u-using the most effective way to break you, of course!"

#. Occurrence 7_3:1460:9372: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0025; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1460
msgctxt "text_id=9372 | speaker=aoko"
msgid "　アンタ、横にいないとすぐ間違えるし」"
msgstr "  And besides, the moment you leave my side, all hell seems to break loose.\""

#. Occurrence 7_3:1474:9373: scene=7_3
#: 7_3:1474
msgctxt "text_id=9373 | speaker=unknown"
msgid "　悪態を吐きつつ青子は立ち上がった。"
msgstr "  Aoko stood up as she lashed back at him."

#. Occurrence 7_3:1509:9374: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0019; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1509
msgctxt "text_id=9374 | speaker=soujuurou"
msgid "「そうだね。なんか昔みたいで、久しぶりに集中できた。"
msgstr "\"You got me there. I haven't felt so focused in years."

#. Occurrence 7_3:1515:9375: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0020; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1515
msgctxt "text_id=9375 | speaker=soujuurou"
msgid "　これが異例中の異例っていうのが、本当に残念だ」"
msgstr "  Too bad this was just 'an exception among exceptions.'\""

#. Occurrence 7_3:1548:9376: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0026; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1548
msgctxt "text_id=9376 | speaker=aoko"
msgid "「……余裕あるじゃない。その分じゃ今日のテストだけじゃなく、有珠との話し合いも上手くいきそうね、草十郎？」"
msgstr "\"...Well look at you, Soujyuro. Before you know it, you'll be acing your exams and your relationship with Alice.\""

#. Occurrence 7_3:1566:9377: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0021; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1566
msgctxt "text_id=9377 | speaker=soujuurou"
msgid "「ああ、それはもちろん」"
msgstr "\"I will, Aozaki. Don't you worry.\""

#. Occurrence 7_3:1590:9378: scene=7_3
#: 7_3:1590
msgctxt "text_id=9378 | speaker=unknown"
msgid "　爽やかな返答に、青子はつい絶句する。"
msgstr "  His cool response caught her off guard, and for a moment she was at a loss for words."

#. Occurrence 7_3:1595:9379: scene=7_3
#: 7_3:1595
msgctxt "text_id=9379 | speaker=unknown"
msgid "　嫌味のつもりだったのに、まさか笑顔で返されるとは思ってもいなかったのだ。"
msgstr "  She meant it sarcastically, and yet he responded with a warm smile."

#. Occurrence 7_3:1629:9380: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0022; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1629
msgctxt "text_id=9380 | speaker=soujuurou"
msgid "「方針変更だ。まずは近くで話しかけてみるよ。"
msgstr "\"I'm gonna change my strategy. The first step: engage her directly."

#. Occurrence 7_3:1629:9381: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0022; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1629
msgctxt "text_id=9381 | speaker=soujuurou"
msgid "　嫌なことは、いずれ終わるって分かったから」"
msgstr "  You can't stay mad forever, as they say.\""

#. Occurrence 7_3:1635:9382: scene=7_3
#: 7_3:1635
msgctxt "text_id=9382 | speaker=unknown"
msgid "　そう言って立ち上がる草十郎の姿を、青子は絶句したまま見つめた。"
msgstr "  Aoko remained in a state of silent shock as he spoke and rose to his feet."

#. Occurrence 7_3:1640:9383: scene=7_3
#: 7_3:1640
msgctxt "text_id=9383 | speaker=unknown"
msgid "　……頼りがいがある姿というか、きちんと芯の通った振る舞いというか。不覚にも、少しだけ尊敬してしまった程だ。"
msgstr "  She could not help but feel a reluctant respect for what seemed to be his newfound confidence and competence."

#. Occurrence 7_3:1664:9384: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0023; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1664
msgctxt "text_id=9384 | speaker=soujuurou"
msgid "「とりあえず今日はひとりで帰って、有珠と話してみる。"
msgstr "\"I'll go home by myself today and speak to Alice."

#. Occurrence 7_3:1670:9385: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0024; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1670
msgctxt "text_id=9385 | speaker=soujuurou"
msgid "　蒼崎は放課後、生徒会だろう？」"
msgstr "  You have a student council meeting after class, right?\""

#. Occurrence 7_3:1679:9386: scene=7_3
#: 7_3:1679
msgctxt "text_id=9386 | speaker=unknown"
msgid "　草十郎の言う通り、青子には冬休み直前の最後の会議が待ち受けていた。"
msgstr "  He was right. It was their last meeting before winter break."

#. Occurrence 7_3:1684:9387: scene=7_3
#: 7_3:1684
msgctxt "text_id=9387 | speaker=unknown"
msgid "　本来なら会議の終わりまで待つか、学校からそのままアルバイトに行くのが草十郎の日課である。"
msgstr "  Normally he would have waited until the meeting ended, or else gone straight to his part-time job."

#. Occurrence 7_3:1702:9388: scene=7_3
#: 7_3:1702
msgctxt "text_id=9388 | speaker=unknown"
msgid "　それも、ひとえに洋館で草十郎と有珠が二人きりにならないよう、青子なりの配慮なのだが―――"
msgstr "  This was part of Aoko's plan to make sure he and Alice were never alone in the mansion together."

#. Occurrence 7_3:1724:9389: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0027; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1724
msgctxt "text_id=9389 | speaker=aoko"
msgid "「……待った。まさかアンタ、ひとりで有珠とやりあうつもりなの？」"
msgstr "\"...Hold it. You mean you're planning to face Alice by yourself?\""

#. Occurrence 7_3:1740:9390: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0025; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1740
msgctxt "text_id=9390 | speaker=soujuurou"
msgid "「別にやりあうつもりはないぞ。<試|し><合|あ>っても勝てないだろ、有珠には」"
msgstr "\"You make it sound like we're gonna get into a fight. I wouldn't stand a chance, you know that.\""

#. Occurrence 7_3:1745:9391: scene=7_3
#: 7_3:1745
msgctxt "text_id=9391 | speaker=unknown"
msgid "　驚く青子に、平然と草十郎は返答する。"
msgstr "  His reply made complete sense, which floored her."

#. Occurrence 7_3:1771:9392: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0026; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1771
msgctxt "text_id=9392 | speaker=soujuurou"
msgid "「でも、蒼崎がいたら話が複雑になるのは目に見えてるんだ。そんなワケで、今日はゆっくり鳶丸の相手でもしててくれ」"
msgstr "\"Even I can see that things only get more messy when you're around, Aozaki. That's why I'd appreciate it if you take your time with Tobimaru today.\""

#. Occurrence 7_3:1795:9393: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0028; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1795
msgctxt "text_id=9393 | speaker=aoko"
msgid "「…………本気？」"
msgstr "\"...Are you serious?\""

#. Occurrence 7_3:1815:9394: scene=7_3
#: 7_3:1815
msgctxt "text_id=9394 | speaker=unknown"
msgid "　試すような青子の問いに、草十郎は気軽に頷いた。"
msgstr "  He felt like he was being tested but nodded nonchalantly nonetheless."

#. Occurrence 7_3:1820:9395: scene=7_3
#: 7_3:1820
msgctxt "text_id=9395 | speaker=unknown"
msgid "　事の深刻さを理解している青子と、"
msgstr "  Knowing how grave the situation really was,"

#. Occurrence 7_3:1825:9396: scene=7_3
#: 7_3:1825
msgctxt "text_id=9396 | speaker=unknown"
msgid "　その深刻さは<要|い>らないと語る草十郎。"
msgstr "  Aoko was not sure how to respond to his apparent lack of concern."

#. Occurrence 7_3:1830:9397: scene=7_3
#: 7_3:1830
msgctxt "text_id=9397 | speaker=unknown"
msgid "　窓から差しこむ朝の光が、立ったまま話し合うふたりを光と影とに<別|わ>けている。"
msgstr "  The morning light coming through the window marked a stark contrast between the two."

#. Occurrence 7_3:1870:9398: scene=7_3
#: 7_3:1870
msgctxt "text_id=9398 | speaker=unknown"
msgid "　どちらが光に照らされているのか、"
msgstr "  Which stood bathed in light?"

#. Occurrence 7_3:1875:9399: scene=7_3
#: 7_3:1875
msgctxt "text_id=9399 | speaker=unknown"
msgid "　どちらが影に佇んでいるかは、語るまでもない。"
msgstr "  Which lurked in darkness? That went without saying."

#. Occurrence 7_3:1881:9400: scene=7_3
#: 7_3:1881
msgctxt "text_id=9400 | speaker=unknown"
msgid "　短かな、ほんの数秒ほどの沈黙。"
msgstr "  The silence lasted for only a brief moment."

#. Occurrence 7_3:1886:9401: scene=7_3
#: 7_3:1886
msgctxt "text_id=9401 | speaker=unknown"
msgid "　青子は草十郎を真顔で見つめて、"
msgstr "  Staring at him gravely, she said,"

#. Occurrence 7_3:1921:9402: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0029; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1921
msgctxt "text_id=9402 | speaker=aoko"
msgid "「そ。なら止めはしないわ」"
msgstr "\"Fine. Then I won't stop you.\""

#. Occurrence 7_3:1928:9403: scene=7_3
#: 7_3:1928
msgctxt "text_id=9403 | speaker=unknown"
msgid "　青子はそう口にした。"
msgstr "  That was all she had."

#. Occurrence 7_3:1933:9404: scene=7_3
#: 7_3:1933
msgctxt "text_id=9404 | speaker=unknown"
msgid "　先ほどまでの沈黙の意図も、わずかな葛藤も感じさせない、彼女らしい<冷徹|ドライ>さ。"
msgstr "  Her dry tone hid the significance of their pregnant silence, not revealing the slightest sign of discord."

#. Occurrence 7_3:1966:9405: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0027; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:1966
msgctxt "text_id=9405 | speaker=soujuurou"
msgid "「……なんか怒ってないか、蒼崎？」"
msgstr "\"Are you sure you're not angry, Aozaki?\""

#. Occurrence 7_3:1984:9406: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0030; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:1984
msgctxt "text_id=9406 | speaker=aoko"
msgid "「別に。それで、何か考えはあるの？　下手な考えは通じないわよ、あの娘には」"
msgstr "\"Yes, I'm sure. But do you have some kind of plan? You need a good plan of attack with her, you know.\""

#. Occurrence 7_3:2003:9407: scene=7_3
#: 7_3:2003
msgctxt "text_id=9407 | speaker=unknown"
msgid "　む、と眉をよせて考えこむ草十郎。"
msgstr "  Soujyuro furrowed his brow in deep thought."

#. Occurrence 7_3:2008:9408: scene=7_3
#: 7_3:2008
msgctxt "text_id=9408 | speaker=unknown"
msgid "　たしかに会話だけで有珠と親しくなるのは難しい。というか、不可能な気さえする。"
msgstr "  He knew it would be hard to get close to her through talk alone. In fact, it felt nearly impossible."

#. Occurrence 7_3:2029:9409: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_3_0000; voice_prefix=B50; voice_category=6; scene=7_3
#: 7_3:2029
msgctxt "text_id=9409 | speaker=kinomi"
msgid "“言葉で落ちないヤツは物で釣れ”"
msgstr "\"Gifts work where words fail.\""

#. Occurrence 7_3:2035:9410: scene=7_3
#: 7_3:2035
msgctxt "text_id=9410 | speaker=unknown"
msgid "　彼の数少ない相談相手（勘違い含む）である木乃美芳助はそんな助言をしてくれた。"
msgstr "  Kinomi had been the voice of wisdom (and folly) for him countless times in the past."

#. Occurrence 7_3:2040:9411: scene=7_3
#: 7_3:2040
msgctxt "text_id=9411 | speaker=unknown"
msgid "　ちなみに木乃美の助言は対青子用のものだったが、その時の草十郎の感想は、"
msgstr "  Incidentally, Kinomi had been referring to Aoko at the time he shared that pearl of wisdom,"

#. Occurrence 7_3:2045:9412: scene=7_3
#: 7_3:2045
msgctxt "text_id=9412 | speaker=unknown"
msgid "“蒼崎を物で釣ると、後が恐そうだ”である。"
msgstr "but Soujyuro had had the distinct impression that trying to buy Aozaki's kindness with gifts would not end well."

#. Occurrence 7_3:2081:9413: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0028; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:2081
msgctxt "text_id=9413 | speaker=soujuurou"
msgid "「……む。だいたい、有珠の趣味も分からないじゃないか。"
msgstr "\"Hm. I don't know what kind of stuff Alice is in to."

#. Occurrence 7_3:2087:9414: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0029; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:2087
msgctxt "text_id=9414 | speaker=soujuurou"
msgid "　考えてみると、今の自分と彼女はまるで接点がない」"
msgstr "  We probably have almost nothing in common.\""

#. Occurrence 7_3:2093:9415: scene=7_3
#: 7_3:2093
msgctxt "text_id=9415 | speaker=unknown"
msgid "　困ったな、と腕を組む草十郎。"
msgstr "  Soujyuro crossed his arms at a loss."

#. Occurrence 7_3:2126:9416: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0031; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2126
msgctxt "text_id=9416 | speaker=aoko"
msgid "「いつもの事だけど、何も考えてなかったワケね」"
msgstr "\"In other words, you haven't got any plan, as usual.\""

#. Occurrence 7_3:2139:9417: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0030; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:2139
msgctxt "text_id=9417 | speaker=soujuurou"
msgid "「うん。でもまあ、あれこれ考えなくてもいいと思う。"
msgstr "\"Right. But I don't want to overthink this too much, either."

#. Occurrence 7_3:2159:9418: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0031; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:2159
msgctxt "text_id=9418 | speaker=soujuurou"
msgid "　有珠にはあれこれ説明するとか、分かってもらおうとか、そういうんじゃなくて、なんていうか―――」"
msgstr "  It's not like I'm going to explain things to her and then she'll suddenly understand. I mean...\""

#. Occurrence 7_3:2179:9419: scene=7_3
#: 7_3:2179
msgctxt "text_id=9419 | speaker=unknown"
msgid "　言葉にできない印象を、なんとか言葉にしようと悩む。"
msgstr "  He pondered intently as he tried to put his vague thoughts into something concrete."

#. Occurrence 7_3:2179:9420: scene=7_3
#: 7_3:2179
msgctxt "text_id=9420 | speaker=unknown"
msgid "　思考時間は短かった。"
msgstr "  But he did not spend much time in thought."

#. Occurrence 7_3:2184:9421: scene=7_3
#: 7_3:2184
msgctxt "text_id=9421 | speaker=unknown"
msgid "　草十郎はああ、と小さく頷いて、"
msgstr "  With a nod he concluded,"

#. Occurrence 7_3:2191:9422: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0032; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:2191
msgctxt "text_id=9422 | speaker=soujuurou"
msgid "「要は、俺が彼女を好きかどうかって事じゃないか？」"
msgstr "\"What's more important is whether I like her or not, right?\""

#. Occurrence 7_3:2197:9423: scene=7_3
#: 7_3:2197
msgctxt "text_id=9423 | speaker=unknown"
msgid "　あっさりと、言いづらい感想を口にした。"
msgstr "  He articulated that which is often so hard to say, with surprising clarity and calm."

#. Occurrence 7_3:2229:9424: scene=7_3
#: 7_3:2229
msgctxt "text_id=9424 | speaker=unknown"
msgid "　確かに、それは全ての前提だ。"
msgstr "  It was certainly a prerequisite for the task he hoped to achieve."

#. Occurrence 7_3:2234:9425: scene=7_3
#: 7_3:2234
msgctxt "text_id=9425 | speaker=unknown"
msgid "　認められるために話すのではなく、"
msgstr "  He had no hope of making her appreciate him with words,"

#. Occurrence 7_3:2239:9426: scene=7_3
#: 7_3:2239
msgctxt "text_id=9426 | speaker=unknown"
msgid "　見返りを求めての求愛でもない。"
msgstr "  or with acts of giving with the expectation of reciprocation."

#. Occurrence 7_3:2244:9427: scene=7_3
#: 7_3:2244
msgctxt "text_id=9427 | speaker=unknown"
msgid "　まずその人が好きだから、触れ合ってみようと思う。"
msgstr "  He simply wished to get to know her better because he liked her."

#. Occurrence 7_3:2249:9428: scene=7_3
#: 7_3:2249
msgctxt "text_id=9428 | speaker=unknown"
msgid "　それは打算のない、清潔な心のあり方だ。"
msgstr "  That was his honest, uncontrived intention, and it reflected the purity of his heart."

#. Occurrence 7_3:2269:9429: scene=7_3
#: 7_3:2269
msgctxt "text_id=9429 | speaker=unknown"
msgid "　けれど、それが人間として幸福かどうかは、また別の話。"
msgstr "  But whether that was in his best interest or not was another story altogether."

#. Occurrence 7_3:2275:9430: scene=7_3
#: 7_3:2275
msgctxt "text_id=9430 | speaker=unknown"
msgid "　計算と妥協、我欲と食い合い。"
msgstr "  Calculation and compromise, selfishness and conflict."

#. Occurrence 7_3:2280:9431: scene=7_3
#: 7_3:2280
msgctxt "text_id=9431 | speaker=unknown"
msgid "　道徳が非人間と<糾|うた>うものこそが正しい人間性と信じる者には、その清潔さは目に痛い。"
msgstr "  Purity such as his often irritated people who believed that morals went against human nature."

#. Occurrence 7_3:2285:9432: scene=7_3
#: 7_3:2285
msgctxt "text_id=9432 | speaker=unknown"
msgid "　……いや、正しくは。"
msgstr "  Or rather..."

#. Occurrence 7_3:2291:9433: scene=7_3
#: 7_3:2291
msgctxt "text_id=9433 | speaker=unknown"
msgid "そう信じざるを得なくなってしまった者にとっては。"
msgstr "People who were inevitably forced to believe it."

#. Occurrence 7_3:2333:9434: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0032; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2333
msgctxt "text_id=9434 | speaker=aoko"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 7_3:2339:9435: scene=7_3
#: 7_3:2339
msgctxt "text_id=9435 | speaker=unknown"
msgid "　草十郎の言葉に何も返さず、青子は音もなく歩きだした。"
msgstr "  Aoko silently walked away without responding to what Soujyuro said."

#. Occurrence 7_3:2344:9436: scene=7_3
#: 7_3:2344
msgctxt "text_id=9436 | speaker=unknown"
msgid "　長い髪を揺らして、草十郎の前を通り過ぎる。"
msgstr "  Her long hair swung from side to side as she passed him."

#. Occurrence 7_3:2365:9437: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0033; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:2365
msgctxt "text_id=9437 | speaker=soujuurou"
msgid "「蒼崎？」"
msgstr "\"Aozaki?\""

#. Occurrence 7_3:2370:9438: scene=7_3
#: 7_3:2370
msgctxt "text_id=9438 | speaker=unknown"
msgid "　どこか冷たい素振りの彼女を、草十郎は呼び止める。"
msgstr "  Noting her strangely cold manner, he called out to her."

#. Occurrence 7_3:2375:9439: scene=7_3
#: 7_3:2375
msgctxt "text_id=9439 | speaker=unknown"
msgid "　青子はもう部屋のドアを開けていた。"
msgstr "  However, she was already opening the door to leave."

#. Occurrence 7_3:2409:9440: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0033; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2409
msgctxt "text_id=9440 | speaker=aoko"
msgid "「下でシャワー浴びてくるから。"
msgstr "\"I'm going to take a shower downstairs."

#. Occurrence 7_3:2409:9441: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0033; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2409
msgctxt "text_id=9441 | speaker=aoko"
msgid "　貴方は自分の部屋に戻ってて」"
msgstr "  You can go back to your room.\""

#. Occurrence 7_3:2415:9442: scene=7_3
#: 7_3:2415
msgctxt "text_id=9442 | speaker=unknown"
msgid "　<抑揚|よくよう>のない台詞。"
msgstr "  Her words lacked any expressive inflection."

#. Occurrence 7_3:2420:9443: scene=7_3
#: 7_3:2420
msgctxt "text_id=9443 | speaker=unknown"
msgid "　それに戸惑いながらも草十郎は頷いた。"
msgstr "  In his confusion, all Soujyuro could do was nod."

#. Occurrence 7_3:2441:9444: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0034; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:2441
msgctxt "text_id=9444 | speaker=soujuurou"
msgid "「いいけど……やっぱり怒ってないか、蒼崎？」"
msgstr "\"Okay... But are you sure you're not mad?\""

#. Occurrence 7_3:2454:9445: scene=7_3
#: 7_3:2454
msgctxt "text_id=9445 | speaker=unknown"
msgid "　言われて、青子の顔に表情が戻る。"
msgstr "  Emotion returned to her face as he spoke."

#. Occurrence 7_3:2459:9446: scene=7_3
#: 7_3:2459
msgctxt "text_id=9446 | speaker=unknown"
msgid "　それはいつもの、もう見慣れた不機嫌そうな顔ではなかった。"
msgstr "  Yet it was not the typical irritated look to which he had grown so accustomed."

#. Occurrence 7_3:2487:9447: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0034; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2487
msgctxt "text_id=9447 | speaker=aoko"
msgid "「……そうね。アンタ流に言えば、たぶん私は怒ってる。"
msgstr "\"I guess I might be what someone like you would call mad."

#. Occurrence 7_3:2493:9448: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0035; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2493
msgctxt "text_id=9448 | speaker=aoko"
msgid "　何に対してのものかは、あんまり言いたくないけど」"
msgstr "  I'd rather not discuss the reason why, though.\""

#. Occurrence 7_3:2511:9449: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_3_0035; voice_prefix=A30; voice_category=3; scene=7_3
#: 7_3:2511
msgctxt "text_id=9449 | speaker=soujuurou"
msgid "「…………」"
msgstr "\"...\""

#. Occurrence 7_3:2517:9450: scene=7_3
#: 7_3:2517
msgctxt "text_id=9450 | speaker=unknown"
msgid "　その原因が自分である事すら草十郎には分からない。"
msgstr "  Poor Soujyuro did not even realize that he himself was the reason."

#. Occurrence 7_3:2522:9451: scene=7_3
#: 7_3:2522
msgctxt "text_id=9451 | speaker=unknown"
msgid "　そんな草十郎を見て、彼女はほんの一瞬だけ、今まで草十郎が見たことのない表情を見せた。"
msgstr "  She looked at him, and for an instant he witnessed an emotion on her face of which he had never seen the likes of before."

#. Occurrence 7_3:2556:9452: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0036; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2556
msgctxt "text_id=9452 | speaker=aoko"
msgid "「じゃあね。これが最後になるかも知れないから、お別れぐらいは言っておくわ。"
msgstr "\"See you. This might be the last time we meet, so I should say goodbye."

#. Occurrence 7_3:2562:9453: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0037; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2562
msgctxt "text_id=9453 | speaker=aoko"
msgid "　貴方は有珠を甘く見すぎてる。"
msgstr "  You take Alice far too lightly, you know."

#. Occurrence 7_3:2568:9454: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0038; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2568
msgctxt "text_id=9454 | speaker=aoko"
msgid "　……でも、それが同時にアンタの強みなのよね。私たちには、毒にしかならないけれど」"
msgstr "  For you that's a strength, but for us, it's pure poison.\""

#. Occurrence 7_3:2595:9455: scene=7_3
#: 7_3:2595
msgctxt "text_id=9455 | speaker=unknown"
msgid "　バタン、と音をたてて閉められるドア。"
msgstr "  The door slammed loudly shut behind her."

#. Occurrence 7_3:2600:9456: scene=7_3
#: 7_3:2600
msgctxt "text_id=9456 | speaker=unknown"
msgid "　壁ごしに歩み去っていく足音が聞こえてくる。"
msgstr "  Her steps were audible as she walked away on the other side of the wall."

#. Occurrence 7_3:2605:9457: scene=7_3
#: 7_3:2605
msgctxt "text_id=9457 | speaker=unknown"
msgid "　暖房のない廊下は冷蔵庫なみの寒さのはずだが、青子は慣れているようだった。"
msgstr "  The corridor must have been nearly freezing without any central heating, but Aoko seemed perfectly comfortable."

#. Occurrence 7_3:2653:9458: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0039; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2653
msgctxt "text_id=9458 | speaker=aoko"
msgid "「―――って、なんで私から出ていくんだっ。"
msgstr "\"Wait, why am I leaving first?"

#. Occurrence 7_3:2659:9459: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_3_0040; voice_prefix=A10; voice_category=1; scene=7_3
#: 7_3:2659
msgctxt "text_id=9459 | speaker=aoko"
msgid "　順番が逆！　普通、先に出てくのは<男子|そっち>じゃない」"
msgstr "  This is all backward! It's my room, you go first!\""

#. Occurrence 7_3:2701:9460: scene=7_3
#: 7_3:2701
msgctxt "text_id=9460 | speaker=unknown"
msgid "　しっしっ、と青子にうながされ、部屋からほっぽり出される草十郎。"
msgstr "  Aoko promptly kicked Soujyuro out of her room."

#. Occurrence 7_3:2711:9461: scene=7_3
#: 7_3:2711
msgctxt "text_id=9461 | speaker=unknown"
msgid "　バタン、と閉じられる木製の扉。"
msgstr "  Once again the wooden door closed with a slam."

#. Occurrence 7_3:2716:9462: scene=7_3
#: 7_3:2716
msgctxt "text_id=9462 | speaker=unknown"
msgid "　思っていたほど廊下は冷えこんでいなかった。"
msgstr "  The corridor was not as cold as he had expected."

#. Occurrence 7_3:2722:9463: scene=7_3
#: 7_3:2722
msgctxt "text_id=9463 | speaker=unknown"
msgid "　―――まあ、冷蔵庫よりはマシな程度には。"
msgstr "  Not quite as bad as a freezer, at least."

#. Occurrence 7_5:123:9464: scene=7_5
#: 7_5:123
msgctxt "text_id=9464 | speaker=unknown"
msgid "　二日目の期末試験が終わって、草十郎はひとり洋館への帰路についた。"
msgstr "  The second day of exams ended and Soujyuro was on his way back to the mansion."

#. Occurrence 7_5:128:9465: scene=7_5
#: 7_5:128
msgctxt "text_id=9465 | speaker=unknown"
msgid "　坂道は上に行くほど傾斜を増していき、森も深さを増していく。"
msgstr "  The road grew steeper and the woods thicker as he made his way up the familiar slope."

#. Occurrence 7_5:133:9466: scene=7_5
#: 7_5:133
msgctxt "text_id=9466 | speaker=unknown"
msgid "　それが二十分以上も続くのだから、地域住人たちにとって久遠寺邸のある丘は山以外の何物でもない。"
msgstr "  People in town called it not a hill but a mountain, simply because it took over twenty minutes to climb."

#. Occurrence 7_5:153:9467: scene=7_5
#: 7_5:153
msgctxt "text_id=9467 | speaker=unknown"
msgid "　一方、草十郎にすれば歩くだけで踏破できる森を山と呼ぶには抵抗がある。"
msgstr "  This did not sit well with Soujyuro, for whom a mountain was something that could not be overcome so easily."

#. Occurrence 7_5:158:9468: scene=7_5
#: 7_5:158
msgctxt "text_id=9468 | speaker=unknown"
msgid "　舗装された道があり、"
msgstr "  The road was paved, for one thing,"

#. Occurrence 7_5:163:9469: scene=7_5
#: 7_5:163
msgctxt "text_id=9469 | speaker=unknown"
msgid "　日射しで方角を確かめられる程度の森であり、"
msgstr "  and the canopy overhead let in plenty of sunlight to guide the way."

#. Occurrence 7_5:168:9470: scene=7_5
#: 7_5:168
msgctxt "text_id=9470 | speaker=unknown"
msgid "　急な斜面も、<茂|しげ>みに<潜|ひそ>む動物の姿もない。"
msgstr "  None of the inclines were especially steep, and no animals lurked in the underbrush."

#. Occurrence 7_5:173:9471: scene=7_5
#: 7_5:173
msgctxt "text_id=9471 | speaker=unknown"
msgid "　ここでは遭難の恐れはおろか、迷う事を心配する必要もないのだから。"
msgstr "  There was no chance of losing his way, no reason to worry about getting lost."

#. Occurrence 7_5:205:9472: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0000; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:205
msgctxt "text_id=9472 | speaker=soujuurou"
msgid "「……情けない。まだ未練ばっかりだ」"
msgstr "\"...How sad. I'm still complaining.\""

#. Occurrence 7_5:211:9473: scene=7_5
#: 7_5:211
msgctxt "text_id=9473 | speaker=unknown"
msgid "　知らず知らずのうち回想していた自分を、草十郎は静かに罵倒した。"
msgstr "  Soujyuro quietly reprimanded himself for getting so wrapped up in his own little world."

#. Occurrence 7_5:216:9474: scene=7_5
#: 7_5:216
msgctxt "text_id=9474 | speaker=unknown"
msgid "　町に引っ越してきてからの数週間は、山と町を比較してばかりだった。"
msgstr "  In the past few weeks since moving here he had been constantly comparing the town with his former mountain home."

#. Occurrence 7_5:236:9475: scene=7_5
#: 7_5:236
msgctxt "text_id=9475 | speaker=unknown"
msgid "　その時はこんな風に自分を叱る事もなかったが、"
msgstr "  Normally he would not get upset over it,"

#. Occurrence 7_5:236:9476: scene=7_5
#: 7_5:236
msgctxt "text_id=9476 | speaker=unknown"
msgid "　ここ数日―――蒼崎青子と知り合ってからは、それが後ろ向きだという事にようやく気が付いたのだ。"
msgstr "  but in recent days--since meeting Aoko, as it happened--he had become rather hung up on the differences."

#. Occurrence 7_5:241:9477: scene=7_5
#: 7_5:241
msgctxt "text_id=9477 | speaker=unknown"
msgid "　理由、理念はどうあれ立ち止まらない少女。"
msgstr "  The reasons for this eluded him, but he knew that Aoko was a force that could not be stopped."

#. Occurrence 7_5:250:9478: scene=7_5
#: 7_5:250
msgctxt "text_id=9478 | speaker=unknown"
msgid "　その姿を目で追ううちに、自分も自然と早足になっていたらしい。"
msgstr "  This naturally made him want to quicken his own pace."

#. Occurrence 7_5:290:9479: scene=7_5
#: 7_5:290
msgctxt "text_id=9479 | speaker=unknown"
msgid "　その青子が住む洋館は、活き活きとした彼女には不釣り合いな<趣|おもむき>だ。"
msgstr "  The mansion where they both lived was the antipathy of her lively personality."

#. Occurrence 7_5:295:9480: scene=7_5
#: 7_5:295
msgctxt "text_id=9480 | speaker=unknown"
msgid "　三咲町の中でも<一際|ひときわ>異彩な建物。"
msgstr "  It stood out like a sore thumb, even in a town like Misaki."

#. Occurrence 7_5:300:9481: scene=7_5
#: 7_5:300
msgctxt "text_id=9481 | speaker=unknown"
msgid "　幽霊屋敷と呼ばれる洋館。"
msgstr "  Some people said it was haunted."

#. Occurrence 7_5:305:9482: scene=7_5
#: 7_5:305
msgctxt "text_id=9482 | speaker=unknown"
msgid "　実際住んでいるのは幽霊ではなく魔法使いなのだけど、どっちもどっちなので、世論というのはわりと正しいのかもしれない。"
msgstr "  There were no ghosts, per se, but it was inhabited by magicians, so their claims were closer to the truth than they could have possibly known."

#. Occurrence 7_5:347:9483: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0001; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:347
msgctxt "text_id=9483 | speaker=soujuurou"
msgid "「……そう言えば。幽霊と魔法使いっていうのは、どっちが常識はずれなんだろう？」"
msgstr "\"Speaking of which, I wonder. Between ghosts and magicians, which would be more surprising?\""

#. Occurrence 7_5:353:9484: scene=7_5
#: 7_5:353
msgctxt "text_id=9484 | speaker=unknown"
msgid "　都会の生活に慣れていない自分を棚に上げて、草十郎ははて、と首をひねる。"
msgstr "  Lost in contemplation as he was, the boy failed to notice how his own lack of familiarity with city life played into the equation."

#. Occurrence 7_5:358:9485: scene=7_5
#: 7_5:358
msgctxt "text_id=9485 | speaker=unknown"
msgid "　ともあれ、どちらにしてもやるべき事は変わらない。"
msgstr "  In any case, none of his pondering changed what needed to be done."

#. Occurrence 7_5:378:9486: scene=7_5
#: 7_5:378
msgctxt "text_id=9486 | speaker=unknown"
msgid "　期末試験は明日で終わりだ。"
msgstr "  Tomorrow was the last day of exams."

#. Occurrence 7_5:383:9487: scene=7_5
#: 7_5:383
msgctxt "text_id=9487 | speaker=unknown"
msgid "　青子が責任持って草十郎を保護する、といったリミットまであとわずか。"
msgstr "  That meant he only had a little longer until Aoko stopped taking responsibility for his safety."

#. Occurrence 7_5:388:9488: scene=7_5
#: 7_5:388
msgctxt "text_id=9488 | speaker=unknown"
msgid "　可能であるなら今日のうちに、草十郎は洋館の主に同居人として認められなくてはいけない。"
msgstr "  If possible, today was going to be the day when the mansion's owner accepted his continued residence there."

#. Occurrence 7_5:426:9489: scene=7_5
#: 7_5:426
msgctxt "text_id=9489 | speaker=unknown"
msgid "　館をぐるりと囲む木々の隙間、自然の並木道を通って、草十郎は玄関まで歩いていく。"
msgstr "  Soujyuro slipped between the trees encircling the mansion and walked down the naturally tree-lined avenue that led him to the front door."

#. Occurrence 7_5:435:9490: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0002; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:435
msgctxt "text_id=9490 | speaker=soujuurou"
msgid "「――――――よし」"
msgstr "\"...Here goes.\""

#. Occurrence 7_5:440:9491: scene=7_5
#: 7_5:440
msgctxt "text_id=9491 | speaker=unknown"
msgid "　玄関の前で一度だけ深呼吸をし、草十郎は館内へと入っていった。"
msgstr "  Taking a deep breath he stepped across the threshold."

#. Occurrence 7_5:445:9492: scene=7_5
#: 7_5:445
msgctxt "text_id=9492 | speaker=unknown"
msgid "　目指すは有珠がいるであろう居間である。"
msgstr "  The drawing room was where he expected to find Alice."

#. Occurrence 7_5:483:9493: scene=7_5
#: 7_5:483
msgctxt "text_id=9493 | speaker=unknown"
msgid "　しかし。"
msgstr "  However..."

#. Occurrence 7_5:488:9494: scene=7_5
#: 7_5:488
msgctxt "text_id=9494 | speaker=unknown"
msgid "　そんな草十郎を迎えたのは、予想外の光景だった。"
msgstr "  He found himself face to face with a most unexpected scene."

#. Occurrence 7_5:508:9495: scene=7_5
#: 7_5:508
msgctxt "text_id=9495 | speaker=unknown"
msgid "　少し歩いて、玄関から館のホールであるロビーに辿り着く。"
msgstr "  A few steps in, he arrived at the large foyer extending from the mansion's entrance."

#. Occurrence 7_5:528:9496: scene=7_5
#: 7_5:528
msgctxt "text_id=9496 | speaker=unknown"
msgid "　そのロビーにひとつ、大きな違和感がある。"
msgstr "  But one thing was clearly out of place."

#. Occurrence 7_5:533:9497: scene=7_5
#: 7_5:533
msgctxt "text_id=9497 | speaker=unknown"
msgid "　中世の城を思わせる洋館のロビー。"
msgstr "  The foyer of the mansion was like a hall in a medieval castle."

#. Occurrence 7_5:538:9498: scene=7_5
#: 7_5:538
msgctxt "text_id=9498 | speaker=unknown"
msgid "　人工の明かりは一切なく、冬の肌寒い日射しが、さあ、と天窓から影を落としている。"
msgstr "  It was illuminated by the cold winter sun casting down through the skylight, unaided by artificial light."

#. Occurrence 7_5:574:9499: scene=7_5
#: 7_5:574
msgctxt "text_id=9499 | speaker=unknown"
msgid "　緑薫る、木製のタイル。"
msgstr "  The wooden tiles smelled of the outdoors."

#. Occurrence 7_5:592:9500: scene=7_5
#: 7_5:592
msgctxt "text_id=9500 | speaker=unknown"
msgid "　四角い大樹によりそう黒衣。"
msgstr "  And there was Alice, dressed all in black, huddled against a column so enormous it resembled a sharply cornered tree trunk."

#. Occurrence 7_5:610:9501: scene=7_5
#: 7_5:610
msgctxt "text_id=9501 | speaker=unknown"
msgid "　少女は文字通り、洋館に体を預けている。"
msgstr "  The mansion was quite literally supporting her frail body."

#. Occurrence 7_5:628:9502: scene=7_5
#: 7_5:628
msgctxt "text_id=9502 | speaker=unknown"
msgid "　母親の子守歌か、穏やかな揺りかごか。"
msgstr "  Like a mother's lullaby, or a gently rocking cradle."

#. Occurrence 7_5:646:9503: scene=7_5
#: 7_5:646
msgctxt "text_id=9503 | speaker=unknown"
msgid "　洋館は少女の眠りを守るように、空気のざわめきさえ飲みこんでいた。"
msgstr "  The heavy atmosphere within this old building suppressed even the slightest stir, almost as if warding away any disturbance to her slumber."

#. Occurrence 7_5:680:9504: scene=7_5
#: 7_5:680
msgctxt "text_id=9504 | speaker=unknown"
msgid "　館の影で眠る少女。"
msgstr "  There she slept in the shadows of home."

#. Occurrence 7_5:685:9505: scene=7_5
#: 7_5:685
msgctxt "text_id=9505 | speaker=unknown"
msgid "　余人の目から隠された有珠の姿は、このロビーで最も鮮明に、見る者を魅了する。"
msgstr "  Hidden away from outsiders, her sleeping figure was enough to mesmerize anyone who laid eyes upon her."

#. Occurrence 7_5:706:9506: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0003; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:706
msgctxt "text_id=9506 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 7_5:711:9507: scene=7_5
#: 7_5:711
msgctxt "text_id=9507 | speaker=unknown"
msgid "　草十郎は当惑から、つい天井をあおいでしまった。"
msgstr "  Soujyuro instinctively looked up at the ceiling out of sheer awkwardness."

#. Occurrence 7_5:717:9508: scene=7_5
#: 7_5:717
msgctxt "text_id=9508 | speaker=unknown"
msgid "　……だって、不意打ちにも程がある。"
msgstr "  He wanted to surprise her, but not in this way."

#. Occurrence 7_5:722:9509: scene=7_5
#: 7_5:722
msgctxt "text_id=9509 | speaker=unknown"
msgid "　少女は暖炉の傍で、その細い体を預けて眠っている。"
msgstr "  Her slender frame lay asleep by the fireplace."

#. Occurrence 7_5:727:9510: scene=7_5
#: 7_5:727
msgctxt "text_id=9510 | speaker=unknown"
msgid "　いかに美しい絵画のようでも、この状況は心臓に悪い。"
msgstr "  The scene was as beautiful as a painting, yet hard on his heart at the same time."

#. Occurrence 7_5:761:9511: scene=7_5
#: 7_5:761
msgctxt "text_id=9511 | speaker=unknown"
msgid "　……命を感じさせない眠り。"
msgstr "  Her slumber seemed...breathless."

#. Occurrence 7_5:766:9512: scene=7_5
#: 7_5:766
msgctxt "text_id=9512 | speaker=unknown"
msgid "　あまりにも静かで、取り除くもののないカタチ。"
msgstr "  She was too still, with not even a hint of movement."

#. Occurrence 7_5:780:9513: scene=7_5
#: 7_5:780
msgctxt "text_id=9513 | speaker=unknown"
msgid "　この寒空の下、冷たい柱にしなだれているのに、彼女は幸福に包まれていた。"
msgstr "  And yet, slumped against that frigid column under the cold winter sky, happiness appeared to be her blanket."

#. Occurrence 7_5:786:9514: scene=7_5
#: 7_5:786
msgctxt "text_id=9514 | speaker=unknown"
msgid "　死という名の永眠を、見る者に思わせてしまうほどの。"
msgstr "  A passerby would not be blamed for thinking she was in that most peaceful state of eternal slumber: death."

#. Occurrence 7_5:859:9515: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0004; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:859
msgctxt "text_id=9515 | speaker=soujuurou"
msgid "「……寒くないのかな、この子は」"
msgstr "\"She must be pretty cold.\""

#. Occurrence 7_5:865:9516: scene=7_5
#: 7_5:865
msgctxt "text_id=9516 | speaker=unknown"
msgid "　ぼんやりと有珠を眺めながら、ぽつりと呟く。"
msgstr "  Soujyuro spoke to himself as he gazed idly upon her."

#. Occurrence 7_5:870:9517: scene=7_5
#: 7_5:870
msgctxt "text_id=9517 | speaker=unknown"
msgid "　毛布でも持ってくる……なんて気の利いた案を、彼は微塵も考えなかった。"
msgstr "  Bringing her a blanket or something warm did not so much as cross the boy's mind."

#. Occurrence 7_5:886:9518: scene=7_5
#: 7_5:886
msgctxt "text_id=9518 | speaker=unknown"
msgid "　代わりに思いついた事は、なぜか、ふたり分のお茶を淹れる事だった。"
msgstr "  Instead, odd as it sounds, the first thing he thought to do was to go prepare some tea."

#. Occurrence 7_5:927:9519: scene=7_5
#: 7_5:927
msgctxt "text_id=9519 | speaker=unknown"
msgid "　静かにドアを開けて居間に移動する。"
msgstr "  He made sure to be as quiet as possible as he opened the drawing room door."

#. Occurrence 7_5:932:9520: scene=7_5
#: 7_5:932
msgctxt "text_id=9520 | speaker=unknown"
msgid "　テーブルの上には三粒の錠剤。"
msgstr "  On the table, waiting for him, were three pills."

#. Occurrence 7_5:937:9521: scene=7_5
#: 7_5:937
msgctxt "text_id=9521 | speaker=unknown"
msgid "　毎日帰ってきたら飲むように、と青子から言われている薬である。"
msgstr "  They were the medicine Aoko required him to take every day when he arrived home."

#. Occurrence 7_5:942:9522: scene=7_5
#: 7_5:942
msgctxt "text_id=9522 | speaker=unknown"
msgid "　わずかに甘い錠剤を飲みこんで台所に足を運び、数ある紅茶の箱からひとつを選んで、ふたり分の紅茶を淹れる。"
msgstr "  Gulping down the vaguely sweet pills and continuing on to the kitchen, he selected a box of tea from among the many in the cabinet and brewed enough for two people."

#. Occurrence 7_5:958:9523: scene=7_5
#: 7_5:958
msgctxt "text_id=9523 | speaker=unknown"
msgid "　そうしてロビーに戻ってみても、少女は眠ったままだった。"
msgstr "  Alice was still asleep when he returned to the foyer."

#. Occurrence 7_5:1005:9524: scene=7_5
#: 7_5:1005
msgctxt "text_id=9524 | speaker=unknown"
msgid "　物音に少しだけ気を配って床に腰を下ろす。"
msgstr "  Careful not to make any noise, he crouched close to the ground."

#. Occurrence 7_5:1010:9525: scene=7_5
#: 7_5:1010
msgctxt "text_id=9525 | speaker=unknown"
msgid "　ズボン越しに伝わってくる床の<感触|つめたさ>にビックリする。"
msgstr "  He was startled by how cold the floor felt through his pants."

#. Occurrence 7_5:1015:9526: scene=7_5
#: 7_5:1015
msgctxt "text_id=9526 | speaker=unknown"
msgid "　暖炉の<傍|そば>なら温かいのでは、と考えもしたが、青子曰く、あの暖炉は無用の長物とかなんとか。"
msgstr "  He thought it would be warmer here by the fireplace, but then again he recalled how Aoko had referred to it as \"a useless hole in the wall.\""

#. Occurrence 7_5:1020:9527: scene=7_5
#: 7_5:1020
msgctxt "text_id=9527 | speaker=unknown"
msgid "　青子も有珠も手入れの仕方を知らないらしい。"
msgstr "  What was likely the case was that neither she nor Alice knew how to use it properly."

#. Occurrence 7_5:1053:9528: scene=7_5
#: 7_5:1053
msgctxt "text_id=9528 | speaker=unknown"
msgid "　草十郎は盆に載せたティーカップを有珠と自分の前に置くと、おもむろに鞄から古典の教科書を取り出した。"
msgstr "  After taking the teacups from the tray and placing one in front of each of them, Soujyuro carefully pulled his textbook on classical literature from his satchel."

#. Occurrence 7_5:1074:9529: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0005; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:1074
msgctxt "text_id=9529 | speaker=soujuurou"
msgid "「……蒼崎、怒ってたからな」"
msgstr "\"I better get to work or Aozaki will get mad at me again.\""

#. Occurrence 7_5:1080:9530: scene=7_5
#: 7_5:1080
msgctxt "text_id=9530 | speaker=unknown"
msgid "　今朝の青子の顔を思い出して、つい独白する。"
msgstr "  He could still see her angry face from this morning."

#. Occurrence 7_5:1085:9531: scene=7_5
#: 7_5:1085
msgctxt "text_id=9531 | speaker=unknown"
msgid "　彼女が怒っていた理由も、あの一瞬の顔もまったく意味不明のままだ。"
msgstr "  The reason for her anger was still as much a mystery as the unusual look he saw briefly come across her face."

#. Occurrence 7_5:1105:9532: scene=7_5
#: 7_5:1105
msgctxt "text_id=9532 | speaker=unknown"
msgid "　それはそれとして、明日にそなえて復習をしなくてはいけない事だけはハッキリしていた。"
msgstr "  In any case, one thing was certain-he needed to start studying for tomorrow."

#. Occurrence 7_5:1110:9533: scene=7_5
#: 7_5:1110
msgctxt "text_id=9533 | speaker=unknown"
msgid "　青子のおかげで今日のテストは幾分ましになったけれど、明日の科目はさらに難敵だ。"
msgstr "  Thanks to Aoko's instruction, today's exams went well enough, but tomorrow's would be an even more formidable challenge."

#. Occurrence 7_5:1115:9534: scene=7_5
#: 7_5:1115
msgctxt "text_id=9534 | speaker=unknown"
msgid "　今朝から怒っている彼女が今夜も手伝ってくれるとは思えない。"
msgstr "  After how angry she was this morning, he could not expect her to help him again tonight."

#. Occurrence 7_5:1143:9535: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0006; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:1143
msgctxt "text_id=9535 | speaker=soujuurou"
msgid "「そのくせ点数悪いと怒るし。別に、蒼崎が怒る筋合いじゃないと思う」"
msgstr "\"Which means I'll probably do poorly, and then she'll get mad at me again. Not that my grades have anything to do with her in the first place.\""

#. Occurrence 7_5:1150:9536: scene=7_5
#: 7_5:1150
msgctxt "text_id=9536 | speaker=unknown"
msgid "　文句を言いつつ教科書を開く。"
msgstr "  He complained under his breath as he cracked open his textbook."

#. Occurrence 7_5:1168:9537: scene=7_5
#: 7_5:1168
msgctxt "text_id=9537 | speaker=unknown"
msgid "　有珠の目が覚めるまで、そうやって待つつもりらしい。"
msgstr "  Apparently, he intended to spend his time in this fashion until Alice finally awoke."

#. Occurrence 7_5:1188:9538: scene=7_5
#: 7_5:1188
msgctxt "text_id=9538 | speaker=unknown"
msgid "　ホールにはページをめくる音だけが響いていく。"
msgstr "  The sound of the pages turning was the only audible noise in the grand hall."

#. Occurrence 7_5:1193:9539: scene=7_5
#: 7_5:1193
msgctxt "text_id=9539 | speaker=unknown"
msgid "　時計の針も、森のざわめきも届かない<午睡|ごすい>。"
msgstr "  There was no ticking of clocks, or rustling of leaves to disturb her sleep."

#. Occurrence 7_5:1199:9540: scene=7_5
#: 7_5:1199
msgctxt "text_id=9540 | speaker=unknown"
msgid "　……数時間が経って、草十郎は静かに立ち上がった。"
msgstr "  After a few hours Soujyuro quietly rose to his feet."

#. Occurrence 7_5:1204:9541: scene=7_5
#: 7_5:1204
msgctxt "text_id=9541 | speaker=unknown"
msgid "　ロビーに差しこむ日射しは、白から赤に変わりつつある。"
msgstr "  The light that filled the foyer was beginning to turn from white to red."

#. Occurrence 7_5:1225:9542: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0007; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:1225
msgctxt "text_id=9542 | speaker=soujuurou"
msgid "「そろそろバイトの時間か」"
msgstr "\"Time to go to work.\""

#. Occurrence 7_5:1244:9543: scene=7_5
#: 7_5:1244
msgctxt "text_id=9543 | speaker=unknown"
msgid "　固まった背筋を伸ばして、草十郎はちらりと有珠を見た。"
msgstr "  He glanced again at Alice as he stretched his stiff back."

#. Occurrence 7_5:1249:9544: scene=7_5
#: 7_5:1249
msgctxt "text_id=9544 | speaker=unknown"
msgid "　眠りは変わらず穏やかだ。"
msgstr "  She slept in perfect stillness just as she had this entire time."

#. Occurrence 7_5:1255:9545: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0008; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:1255
msgctxt "text_id=9545 | speaker=soujuurou"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 7_5:1260:9546: scene=7_5
#: 7_5:1260
msgctxt "text_id=9546 | speaker=unknown"
msgid "　む、と草十郎は真剣に眉をよせる。"
msgstr "  Soujyuro arched his brow in speculation."

#. Occurrence 7_5:1265:9547: scene=7_5
#: 7_5:1265
msgctxt "text_id=9547 | speaker=unknown"
msgid "　このまま寝かせておいていいのか、有珠の日常を知らない彼には悩みどころだ。"
msgstr "  He had no idea what her normal sleeping schedule was like, so he had no idea as to whether he should wake her."

#. Occurrence 7_5:1286:9548: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_5_0009; voice_prefix=A30; voice_category=3; scene=7_5
#: 7_5:1286
msgctxt "text_id=9548 | speaker=soujuurou"
msgid "「……いや。蒼崎も帰ってくるだろうし、いらぬ世話かな」"
msgstr "\"...Never mind. Aozaki will be home soon anyway. She'll be fine.\""

#. Occurrence 7_5:1304:9549: scene=7_5
#: 7_5:1304
msgctxt "text_id=9549 | speaker=unknown"
msgid "　いかなる思考が生み出した結論か、草十郎はひとり頷いて洋館を後にした。"
msgstr "  As if reaching the end of a long train of thought, Soujyuro gave a quick nod of his head and took his leave of the mansion."

#. Occurrence 7_5:1320:9550: scene=7_5
#: 7_5:1320
msgctxt "text_id=9550 | speaker=unknown"
msgid "　今日のバイト先は三咲町商店街にある、中華飯店まっどべあである。"
msgstr "  Today, work was a shift at the Chinese restaurant in Misaki's shopping district, The Mad Bear."

#. Occurrence 7_6:69:9551: scene=7_6
#: 7_6:69
msgctxt "text_id=9551 | speaker=unknown"
msgid "　その制服は、輝かんばかりの色彩センスで作られていた。"
msgstr "  Their uniforms had been made by someone with an obvious preference for garish colors."

#. Occurrence 7_6:74:9552: scene=7_6
#: 7_6:74
msgctxt "text_id=9552 | speaker=unknown"
msgid "　オレンジ一色のエプロンにはデフォルメされた白熊が一頭、その強靱な爪で中華鍋を<爆砕|ばくさい>している。"
msgstr "  The orange apron was emblazoned with a cartoonish polar bear slashing a wok in two with its powerful claws."

#. Occurrence 7_6:79:9553: scene=7_6
#: 7_6:79
msgctxt "text_id=9553 | speaker=unknown"
msgid "　三咲町周辺では他の追随を許さないほど独創的な、山岳地帯の標識と見まがうデザインだ。"
msgstr "  The design resembled warning signs about wild animals seen in the mountains and stood out in Misaki for its one-of-a-kind originality."

#. Occurrence 7_6:115:9554: scene=7_6
#: 7_6:115
msgctxt "text_id=9554 | speaker=unknown"
msgid "　ここは中華飯店まっどべあ。"
msgstr "  This was the Chinese restaurant The Mad Bear."

#. Occurrence 7_6:120:9555: scene=7_6
#: 7_6:120
msgctxt "text_id=9555 | speaker=unknown"
msgid "　地域密着型の、名前とロゴ以外はどこにでもある大衆食堂。"
msgstr "  Aside from its name and logo, the restaurant was the type of cheap, hole-in-the-wall dive that could be found anywhere."

#. Occurrence 7_6:125:9556: scene=7_6
#: 7_6:125
msgctxt "text_id=9556 | speaker=unknown"
msgid "　近年増えはじめているファミリーレストランに押されはじめているものの、食事処として日々絶賛営業中の老舗である。"
msgstr "  It faced competition from the ever-increasing number of chain restaurants, though it had managed to last longer than other dining spots, having received rave reviews on a regular basis."

#. Occurrence 7_6:145:9557: scene=7_6
#: 7_6:145
msgctxt "text_id=9557 | speaker=unknown"
msgid "　近隣住民との触れ合いを大切にする彼らは、サービスの一環として出張配達も行っていた。"
msgstr "  The Mad Bear prioritized the personal touch, focusing on its local clientèle, and thus made a point to offer home delivery."

#. Occurrence 7_6:150:9558: scene=7_6
#: 7_6:150
msgctxt "text_id=9558 | speaker=unknown"
msgid "　人呼んで『<Ｑ|クイック>　<Ｋ|キラー>　<Ｓ|サービス>　・森のクマさん』。"
msgstr "  It had earned the affectionate moniker QKS, the Quick Killer Stop."

#. Occurrence 7_6:155:9559: scene=7_6
#: 7_6:155
msgctxt "text_id=9559 | speaker=unknown"
msgid "　現在、草十郎のおもな仕事はその出前役である。"
msgstr "  Making these deliveries was Soujyuro's responsibility for the time being."

#. Occurrence 7_6:160:9560: scene=7_6
#: 7_6:160
msgctxt "text_id=9560 | speaker=unknown"
msgid "　自転車で宅配が可能な三咲丘周辺は彼の受け持ちで、出前先が遠くなると先輩方の愛車・万能50ccキングサーモン号の出番となるがどうでもいい。"
msgstr "  Places in Misaki within cycling distance fell under his domain. Anything beyond that was handled by a more experienced staff member on the legendary 50cc King Salmon motorbike, but anyway..."

#. Occurrence 7_6:193:9561: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_6_0000; voice_prefix=B50; voice_category=6; scene=7_6
#: 7_6:193
msgctxt "text_id=9561 | speaker=kinomi"
msgid "「<社木|やしろぎ>のダチから聞いたんだけどな」"
msgstr "\"You'll never guess what a buddy in Yashirogi told me...\""

#. Occurrence 7_6:199:9562: scene=7_6
#: 7_6:199
msgctxt "text_id=9562 | speaker=unknown"
msgid "　出前待機中の配達人は、暇さえあればウェイターと洗い物を一身に引き受ける。"
msgstr "  When delivery workers were not out on deliveries they spent their shift busing tables or washing dishes."

#. Occurrence 7_6:204:9563: scene=7_6
#: 7_6:204
msgctxt "text_id=9563 | speaker=unknown"
msgid "　今日はまだ夕飯時になっていないので、宅配専門の彼らは厨房で仲良く皿洗いをしていた。"
msgstr "  The dinner rush was yet to come, and Soujyuro and his fellow delivery boys were shooting the breeze while washing dishes in the back."

#. Occurrence 7_6:236:9564: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_6_0001; voice_prefix=B50; voice_category=6; scene=7_6
#: 7_6:236
msgctxt "text_id=9564 | speaker=kinomi"
msgid "「聞いてるか、静希」"
msgstr "\"Yo, Sizuki!\""

#. Occurrence 7_6:242:9565: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0000; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:242
msgctxt "text_id=9565 | speaker=soujuurou"
msgid "「聞いてるよ、木乃美」"
msgstr "\"I'm listening, Kinomi, I'm listening.\""

#. Occurrence 7_6:248:9566: scene=7_6
#: 7_6:248
msgctxt "text_id=9566 | speaker=unknown"
msgid "　学生バイトである彼らは大きな流し台に両手をつっこんだまま、熱心に仕事をしている……フリをしながら話しこんでいる。"
msgstr "  The two were elbow deep in a giant sink as they enthusiastically scrubbed. At least, that was what they pretended to do while they gossiped."

#. Occurrence 7_6:274:9567: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_6_0002; voice_prefix=B50; voice_category=6; scene=7_6
#: 7_6:274
msgctxt "text_id=9567 | speaker=kinomi"
msgid "「和食のケニヤだけじゃねえんだってよ。三咲町の<大帝都|だいていと>にもメシアンにもその手の注文があったらしいぜ。"
msgstr "\"He said it's not just that Japanese place, you know, Keniya? He heard Imperial Metropolis and Messiaen here in Misaki got orders, too!"

#. Occurrence 7_6:280:9568: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_6_0003; voice_prefix=B50; voice_category=6; scene=7_6
#: 7_6:280
msgctxt "text_id=9568 | speaker=kinomi"
msgid "　そんなに肉がほしいなら<下市|したいち>に行けばいいのにな。なんだって、生肉だの大物の鮭まるごとだのを出前させやがるのか。"
msgstr "  I mean, if you want that much meat just go to Shitaichi! Man! Who the heck orders raw meat and an entire salmon?"

#. Occurrence 7_6:291:9569: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_6_0004; voice_prefix=B50; voice_category=6; scene=7_6
#: 7_6:291
msgctxt "text_id=9569 | speaker=kinomi"
msgid "　どうよ。こう、露骨にやばそうな話じゃねえ？　ワニとかアザラシでも飼ってるんじゃねえかな、そいつ」"
msgstr "  I tell ya, there's some weird shit going on at that place, for real. Maybe they have a pet alligator or something!\""

#. Occurrence 7_6:312:9570: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0001; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:312
msgctxt "text_id=9570 | speaker=soujuurou"
msgid "「他に比べてみると、たしかに珍しい話だと思う。ところで木乃美、ワニってなんだ？」"
msgstr "\"I've definitely never heard of an order like that before. What's an 'alligator'?\""

#. Occurrence 7_6:335:9571: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_6_0005; voice_prefix=B50; voice_category=6; scene=7_6
#: 7_6:335
msgctxt "text_id=9571 | speaker=kinomi"
msgid "「ワニはワニだろー。だっせぇ、実物見たコトないのかよー。まあオレもねえけどな。"
msgstr "\"An alligator's an alligator, dude. You've really never seen one? I mean, I've never actually seen one in real life, either, but even I know what an alligator is."

#. Occurrence 7_6:346:9572: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_7_6_0006; voice_prefix=B50; voice_category=6; scene=7_6
#: 7_6:346
msgctxt "text_id=9572 | speaker=kinomi"
msgid "　んー、今度がくがく動物ランドのアフリカ特集ビデオを貸してやるから、見とけよ」"
msgstr "  You know what? I'll lend you my tape of 'The World's Most Terrifying Animals' episode on Africa.\""

#. Occurrence 7_6:351:9573: scene=7_6
#: 7_6:351
msgctxt "text_id=9573 | speaker=unknown"
msgid "　木乃美も慣れたもので、草十郎への対応が板に付いてきている。"
msgstr "  This was a familiar pattern of conversation between the two, especially now Kinomi was used to Soujyuro's lack of general knowledge."

#. Occurrence 7_6:387:9574: scene=7_6
#: 7_6:387
msgctxt "text_id=9574 | speaker=unknown"
msgid "　そんなとりとめのない会話をしていると、出前の注文を告げる電話が鳴った。マネージャーが素早く受話器を取り、注文と住所を確認する。"
msgstr "  Their banter was interrupted by the delivery phone. The manager snapped up the receiver and quickly jotted down the order and address."

#. Occurrence 7_6:392:9575: scene=7_6
#: 7_6:392
msgctxt "text_id=9575 | speaker=unknown"
msgid "　受話器が置かれると、厨房に集まっている宅配者たちはみんなそっぽを向いた。"
msgstr "  Once he hung up, everyone in the kitchen did their best to avoid making eye contact with him."

#. Occurrence 7_6:397:9576: scene=7_6
#: 7_6:397
msgctxt "text_id=9576 | speaker=unknown"
msgid "　この寒空の中、風をきって出前に行くのは誰だって嫌なものだ。"
msgstr "  Nobody wanted to go rushing out for a delivery on such a cold day."

#. Occurrence 7_6:420:9577: voice_id=D20_7_6_0000; voice_prefix=D20; voice_category=0; scene=7_6
#: 7_6:420
msgctxt "text_id=9577 | speaker=unknown"
msgid "「静希くん。ちょっと遠いけど、配達お願い」"
msgstr "\"Sizuki. This one's a little far away, but I want you to handle it.\""

#. Occurrence 7_6:426:9578: scene=7_6
#: 7_6:426
msgctxt "text_id=9578 | speaker=unknown"
msgid "　そんな根性無しのアルバイターたちに失望する様子もなく、マネージャーは草十郎へ声をかけた。"
msgstr "  The manager singled Soujyuro out for the task, seemingly unfazed by his staff's laziness."

#. Occurrence 7_6:447:9579: voice_id=D20_7_6_0001; voice_prefix=D20; voice_category=0; scene=7_6
#: 7_6:447
msgctxt "text_id=9579 | speaker=unknown"
msgid "「はいこれ、届けるもののリスト。異例だからあまり他のバイトには他言しないようにね」"
msgstr "\"Here's the order, and it's an unusual one, so keep it to yourself, okay?\""

#. Occurrence 7_6:453:9580: scene=7_6
#: 7_6:453
msgctxt "text_id=9580 | speaker=unknown"
msgid "　マネージャーの手には注文と住所を書き留めたメモ用紙が一枚。"
msgstr "  The manager tore the sheet with the order and address written on it from his memo pad."

#. Occurrence 7_6:458:9581: scene=7_6
#: 7_6:458
msgctxt "text_id=9581 | speaker=unknown"
msgid "　それを受け取って、草十郎は静かに顔をしかめた。"
msgstr "  Soujyuro took one look at it before a grimace quietly spread across his face."

#. Occurrence 7_6:487:9582: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0002; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:487
msgctxt "text_id=9582 | speaker=soujuurou"
msgid "「マネージャー」"
msgstr "\"Uh, boss?\""

#. Occurrence 7_6:493:9583: voice_id=D20_7_6_0002; voice_prefix=D20; voice_category=0; scene=7_6
#: 7_6:493
msgctxt "text_id=9583 | speaker=unknown"
msgid "「なんだい？」"
msgstr "\"Yeah?\""

#. Occurrence 7_6:498:9584: scene=7_6
#: 7_6:498
msgctxt "text_id=9584 | speaker=unknown"
msgid "　言いたい事は分かっている、とばかりにマネージャーは草十郎を見つめ返す。"
msgstr "  The manager stared right back at him as if he could tell what it was he wanted to say."

#. Occurrence 7_6:519:9585: voice_id=D20_7_6_0003; voice_prefix=D20; voice_category=0; scene=7_6
#: 7_6:519
msgctxt "text_id=9585 | speaker=unknown"
msgid "「君の疑問はもっともだ。しかし、まあ、長いことこの商売をやっていると、時にはこんな馬鹿な話が転がってくる事もある。そうおかしなコトじゃない。"
msgstr "\"Look, I know what you're thinking. But I've been in this business a long time, and this is far from the strangest thing I've seen. It's no big deal."

#. Occurrence 7_6:525:9586: voice_id=D20_7_6_0004; voice_prefix=D20; voice_category=0; scene=7_6
#: 7_6:525
msgctxt "text_id=9586 | speaker=unknown"
msgid "　じゃ、冷蔵庫から品物持ってくるから」"
msgstr "  Now help me get the stuff from cold storage.\""

#. Occurrence 7_6:530:9587: scene=7_6
#: 7_6:530
msgctxt "text_id=9587 | speaker=unknown"
msgid "　ごく自然に厨房を後にする黒服のマネージャーの姿を、なるほど、と感心して草十郎は眺めた。"
msgstr "  Soujyuro stared in admiration as the manager, dressed in black, marched out of the kitchen in his all-business way."

#. Occurrence 7_6:535:9588: scene=7_6
#: 7_6:535
msgctxt "text_id=9588 | speaker=unknown"
msgid "　どんな所でも、おかしな話はあるものらしい。"
msgstr "  Nowhere was free from the odd occurrence now and then."

#. Occurrence 7_6:624:9589: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0000; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:624
msgctxt "text_id=9589 | speaker=aoko"
msgid "「遅いっ！」"
msgstr "\"You're late!\""

#. Occurrence 7_6:652:9590: scene=7_6
#: 7_6:652
msgctxt "text_id=9590 | speaker=unknown"
msgid "　午後十時過ぎ。"
msgstr "  It was after ten at night."

#. Occurrence 7_6:657:9591: scene=7_6
#: 7_6:657
msgctxt "text_id=9591 | speaker=unknown"
msgid "　アルバイトを終え、ちょっとした寄り道をしてきた草十郎を迎えたのは、ごらんの通り、<怒|いか>れる蒼崎青子だった。"
msgstr "  Soujyuro had taken a small detour on his way home from work, and now faced an outraged Aoko, as expected."

#. Occurrence 7_6:691:9592: scene=7_6
#: 7_6:691
msgctxt "text_id=9592 | speaker=unknown"
msgid "　目に見えて不機嫌そうな彼女を見て、草十郎はホッと胸をなで下ろす。"
msgstr "  Seeing her so visibly irritated made him feel a rush of relief."

#. Occurrence 7_6:696:9593: scene=7_6
#: 7_6:696
msgctxt "text_id=9593 | speaker=unknown"
msgid "　青子がなぜ怒っているのか不明だが、今朝の分かりづらい怒りとは別種のものだったからだ。"
msgstr "  He did not know why she was angry, but he could tell it was a different type of anger than what he saw earlier that morning."

#. Occurrence 7_6:722:9594: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0003; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:722
msgctxt "text_id=9594 | speaker=soujuurou"
msgid "「遅いって、まだ十時になったばかりだろう。"
msgstr "\"Really? But it's only a little after ten."

#. Occurrence 7_6:722:9595: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0003; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:722
msgctxt "text_id=9595 | speaker=soujuurou"
msgid "　どうしたんだ、蒼崎」"
msgstr "  Did something happen, Aozaki?\""

#. Occurrence 7_6:744:9596: scene=7_6
#: 7_6:744
msgctxt "text_id=9596 | speaker=unknown"
msgid "　両手に抱えたダンボールを床に下ろしながら、草十郎は暖炉のあたりに視線を向ける。"
msgstr "  He set down the cardboard box he had been carrying in his arms and glanced toward the fireplace."

#. Occurrence 7_6:749:9597: scene=7_6
#: 7_6:749
msgctxt "text_id=9597 | speaker=unknown"
msgid "　ひとり眠っていた少女の姿はない。"
msgstr "  The sleeping girl was there no more."

#. Occurrence 7_6:783:9598: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0001; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:783
msgctxt "text_id=9598 | speaker=aoko"
msgid "「違うわ。もう十時になった、の間違いでしょ。"
msgstr "\"It's not 'only a little after' ten... You arrived after curfew!"

#. Occurrence 7_6:789:9599: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0002; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:789
msgctxt "text_id=9599 | speaker=aoko"
msgid "　アンタってほんと、自分がどんな状態にあるか分かってないのね」"
msgstr "  You've got no clue why I'm angry, do you?\""

#. Occurrence 7_6:807:9600: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0004; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:807
msgctxt "text_id=9600 | speaker=soujuurou"
msgid "「？」"
msgstr "\"?\""

#. Occurrence 7_6:813:9601: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0003; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:813
msgctxt "text_id=9601 | speaker=aoko"
msgid "「いいから、居間に来て」"
msgstr "\"Just come with me to the drawing room.\""

#. Occurrence 7_6:849:9602: scene=7_6
#: 7_6:849
msgctxt "text_id=9602 | speaker=unknown"
msgid "　首を傾げる草十郎をよそに、青子はスタスタと居間へと歩いて行く。"
msgstr "  She walked briskly to the other room without pausing, leaving Soujyuro standing in confusion, head tilted to one side."

#. Occurrence 7_6:854:9603: scene=7_6
#: 7_6:854
msgctxt "text_id=9603 | speaker=unknown"
msgid "　ダンボール箱を抱え直し、草十郎もいそいそと後に続く。"
msgstr "  He proceeded to pick his box back up and follow after her eagerly."

#. Occurrence 7_6:901:9604: scene=7_6
#: 7_6:901
msgctxt "text_id=9604 | speaker=unknown"
msgid "　草十郎はコートを脱いで、コートハンガーに掛けながら居間に入った。"
msgstr "  He removed his coat and hung it on a hanger as he entered the living room."

#. Occurrence 7_6:906:9605: scene=7_6
#: 7_6:906
msgctxt "text_id=9605 | speaker=unknown"
msgid "　有珠は自室に引きこもっているようだ。"
msgstr "  Apparently today was one of those days where Alice kept herself locked away in her room."

#. Occurrence 7_6:911:9606: scene=7_6
#: 7_6:911
msgctxt "text_id=9606 | speaker=unknown"
msgid "　テーブルの上にはお馴染みの錠剤が置かれている。"
msgstr "  On the table were the familiar pills."

#. Occurrence 7_6:947:9607: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0004; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:947
msgctxt "text_id=9607 | speaker=aoko"
msgid "「……説明しなかった私も悪いけど、貴方も帰ってくる時間は守ってよね。こっちはそのつもりで作ってるんだから」"
msgstr "\"It's partly my fault for not being more clear about this, but you need to come home on time. Your curfew exists for a reason.\""

#. Occurrence 7_6:959:9608: scene=7_6
#: 7_6:959
msgctxt "text_id=9608 | speaker=unknown"
msgid "　はい、とテーブル上の錠剤と、水の入ったコップを差しだす青子。"
msgstr "  Aoko handed him the pills and a glass of water with an expectant look on her face."

#. Occurrence 7_6:992:9609: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0005; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:992
msgctxt "text_id=9609 | speaker=soujuurou"
msgid "「？　薬なら出かける前に飲んだけど。"
msgstr "\"But I already took the pills before I went out."

#. Occurrence 7_6:992:9610: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0005; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:992
msgctxt "text_id=9610 | speaker=soujuurou"
msgid "　体の調子だって悪くないし、そんなにあわてるコトか？」"
msgstr "  And I feel fine, anyway. I don't think I need any more pills today.\""

#. Occurrence 7_6:1011:9611: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0005; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1011
msgctxt "text_id=9611 | speaker=aoko"
msgid "「は？　なんだって私たちがアンタの健康気にかけなくちゃいけないのよ」"
msgstr "\"Excuse me? You think this has anything to do with how you feel?\""

#. Occurrence 7_6:1058:9612: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0006; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1058
msgctxt "text_id=9612 | speaker=aoko"
msgid "「勘違いしてるようだけど、アンタが帰ってくる度に飲んでるのって、平たく言えば毒よ？"
msgstr "\"Let's get real. These pills that you take every day when you come home... They're poison."

#. Occurrence 7_6:1064:9613: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0007; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1064
msgctxt "text_id=9613 | speaker=aoko"
msgid "　速効性じゃないから効き目は半日すると出てくるんだけど、その前に新しい<錠剤|どくやく>を飲んでおかないと、古い毒が体に回ってばったり逝くって寸法ね。"
msgstr "  Slow-acting poison, mind, and they take half a day to kick in. If you don't take more pills before that happens, the older poison will kill you."

#. Occurrence 7_6:1102:9614: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0008; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1102
msgctxt "text_id=9614 | speaker=aoko"
msgid "　有珠のヤツ、これぐらいしないと信用できないって言い張ったのよ」"
msgstr "  This is how much rope Alice is willing to give you.\""

#. Occurrence 7_6:1142:9615: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0009; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1142
msgctxt "text_id=9615 | speaker=aoko"
msgid "「ほら、分かったらさっさと飲む。"
msgstr "\"Get it? So drink up."

#. Occurrence 7_6:1155:9616: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0010; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1155
msgctxt "text_id=9616 | speaker=aoko"
msgid "　……ま、私もこれ、面倒だと思うし。"
msgstr "  I'm enjoying this just about as much as you are."

#. Occurrence 7_6:1161:9617: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0011; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1161
msgctxt "text_id=9617 | speaker=aoko"
msgid "　近いうちもっと形のある方法を考えてみるから、それまでこの方法で我慢して」"
msgstr "  And until I think of a way around this, you're going to have to deal with it.\""

#. Occurrence 7_6:1209:9618: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0006; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1209
msgctxt "text_id=9618 | speaker=soujuurou"
msgid "「……言ってる事は支離滅裂だが、とにかく今までよくない物を飲んでたんだな？」"
msgstr "\"...Maybe I misheard you for a second. Did you say that these pills I've been taking this whole time are actually bad for me?\""

#. Occurrence 7_6:1249:9619: scene=7_6
#: 7_6:1249
msgctxt "text_id=9619 | speaker=unknown"
msgid "　青子から錠剤を受け取って、草十郎は一口で飲みこんだ。"
msgstr "  Soujyuro took the pills from her and gulped it down."

#. Occurrence 7_6:1274:9620: scene=7_6
#: 7_6:1274
msgctxt "text_id=9620 | speaker=unknown"
msgid "　毒物だと聞いて<怯|ひる>んだ素振りもない。"
msgstr "  The fact that it was poison gave him no pause at all."

#. Occurrence 7_6:1279:9621: scene=7_6
#: 7_6:1279
msgctxt "text_id=9621 | speaker=unknown"
msgid "　どうも、青子たちの横暴を非難する気はないらしい。"
msgstr "  And as for his roommates' tyrannical behavior, he showed no signs of standing up to it."

#. Occurrence 7_6:1318:9622: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0007; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1318
msgctxt "text_id=9622 | speaker=soujuurou"
msgid "「まったく。毒をもって毒を制するなんて、また古風な真似するな、蒼崎も有珠も」"
msgstr "\"Using poison to cancel poison... You two are really taking the old-fashioned approach, huh?\""

#. Occurrence 7_6:1324:9623: scene=7_6
#: 7_6:1324
msgctxt "text_id=9623 | speaker=unknown"
msgid "　笑いのツボに入ったらしく、草十郎は頬を<緩|ゆる>ませる。"
msgstr "  Soujyuro's face relaxed into a smile upon finding the funny side of the situation."

#. Occurrence 7_6:1344:9624: scene=7_6
#: 7_6:1344
msgctxt "text_id=9624 | speaker=unknown"
msgid "　一方、青子的には、どうしてそこで笑うのかまったくもって理解不能なのだった。"
msgstr "  Aoko was utterly dumbfounded as to how he could be happy at a time like this."

#. Occurrence 7_6:1373:9625: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0008; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1373
msgctxt "text_id=9625 | speaker=soujuurou"
msgid "「今日帰りが遅れたのは、アパートまで荷物を取りにいっていたからなんだ。そういうコトなら、電話のひとつでもすればよかった」"
msgstr "\"I was running late on the way home because I dropped by my old apartment to get all my stuff. You could've tried calling me if it was such a big deal, you know.\""

#. Occurrence 7_6:1385:9626: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0012; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1385
msgctxt "text_id=9626 | speaker=aoko"
msgid "「……荷物って、まさかそれじゃないでしょうね」"
msgstr "\"Your stuff? Wait...is that everything?\""

#. Occurrence 7_6:1391:9627: scene=7_6
#: 7_6:1391
msgctxt "text_id=9627 | speaker=unknown"
msgid "　持ってきたダンボール箱を指差され、草十郎はもちろん、と頷く。"
msgstr "  Soujyuro nodded emphatically as she pointed incredulously at the cardboard box in his hands."

#. Occurrence 7_6:1426:9628: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0009; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1426
msgctxt "text_id=9628 | speaker=soujuurou"
msgid "「住んでいないのに家賃を払うのは馬鹿らしいから、今日で引き上げてきた。いちおう、いつでも戻れるように話はつけてあるから、三ヶ月ぐらいは大丈夫だよ」"
msgstr "\"It's stupid to pay rent when I don't even live there, so I thought I should move everything out. But I arranged it so I can go back any time within the next three months.\""

#. Occurrence 7_6:1445:9629: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0013; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1445
msgctxt "text_id=9629 | speaker=aoko"
msgid "「家賃……？"
msgstr "\"Rent...?"

#. Occurrence 7_6:1475:9630: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0014_0; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1475
msgctxt "text_id=9630 | speaker=aoko"
msgid "　あ、そっか。そうよね、"
msgstr "  Oh, right."

#. Occurrence 7_6:1488:9631: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0014_1; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1488
msgctxt "text_id=9631 | speaker=aoko"
msgid "私ってばなんでそんな事を忘れてたんだろう。有珠が聞いたら喜ぶわ、そりゃ」"
msgstr " How could I forget? I'm sure Alice will be thrilled to hear about this.\""

#. Occurrence 7_6:1513:9632: scene=7_6
#: 7_6:1513
msgctxt "text_id=9632 | speaker=unknown"
msgid "　華のような笑顔、とはこのコトか。"
msgstr "  A smile blossomed across her face, as they say."

#. Occurrence 7_6:1518:9633: scene=7_6
#: 7_6:1518
msgctxt "text_id=9633 | speaker=unknown"
msgid "　一点の曇りもない、ズバリ、新しい<悪巧|わるだく>みを思いついた子供のような笑顔である。"
msgstr "  It was the open, bold-faced look of a child who just came up with a mischievous plan."

#. Occurrence 7_6:1523:9634: scene=7_6
#: 7_6:1523
msgctxt "text_id=9634 | speaker=unknown"
msgid "　不吉なコトこの上ない、と来るべき脅威に震える草十郎だった。"
msgstr "  Soujyuro shook with fear at the thought of what that smile might bring his way."

#. Occurrence 7_6:1571:9635: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0015; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1571
msgctxt "text_id=9635 | speaker=aoko"
msgid "「けど随分少ないのね、荷物。ダンボール一箱分しかないの？」"
msgstr "\"You sure don't have much. That one cardboard box contains all your worldly possessions?\""

#. Occurrence 7_6:1577:9636: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0010; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1577
msgctxt "text_id=9636 | speaker=soujuurou"
msgid "「そうかな、十分多いだろ。それより有珠は自室か？」"
msgstr "\"This is a lot to me. Is Alice upstairs?\""

#. Occurrence 7_6:1583:9637: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0016; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1583
msgctxt "text_id=9637 | speaker=aoko"
msgid "「ちょっと前に戻ったわ。珍しく食後もここに残ってたんだけど、待ちきれなかったみたいね」"
msgstr "\"She just went to her room, although she stayed at the dinner table longer than usual. I guess she got tired of waiting.\""

#. Occurrence 7_6:1600:9638: scene=7_6
#: 7_6:1600
msgctxt "text_id=9638 | speaker=unknown"
msgid "　青子は不敵な笑顔のまま、意味ありげな視線を草十郎に投げかける。"
msgstr "  She gave Soujyuro a meaningful look while continuing to smile that sinister smile."

#. Occurrence 7_6:1649:9639: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0011; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1649
msgctxt "text_id=9639 | speaker=soujuurou"
msgid "「待ちきれなかったって、何を」"
msgstr "\"She got tired of waiting? For what?\""

#. Occurrence 7_6:1689:9640: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0017; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1689
msgctxt "text_id=9640 | speaker=aoko"
msgid "「そりゃあ、有珠が眠ってるのをいいことに在庫のないフォションとブルーキャリコを勝手に使ってくれた、どこかの誰かさんにお仕置きするためなんじゃない？」"
msgstr "\"I imagine she wanted to punish whoever decided to use the last of her Fauchon and Blue Calico.\""

#. Occurrence 7_6:1734:9641: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0012; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1734
msgctxt "text_id=9641 | speaker=soujuurou"
msgid "「フォション……って、あのお茶の葉？」"
msgstr "\"Why do I know that name...? I think 'Fauchon' is that brand of tea I used.\""

#. Occurrence 7_6:1740:9642: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0018; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1740
msgctxt "text_id=9642 | speaker=aoko"
msgid "「そう。私もびっくりしたけどね。有珠がどっかで寝入るのはよくある事だけど、紅茶を用意して眠るなんてのは初めてだったから。"
msgstr "\"It sure is. To be honest even I was shocked when I first walked in. I know how she falls asleep all over the mansion, but I've never seen her prepare tea first."

#. Occurrence 7_6:1746:9643: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0019; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1746
msgctxt "text_id=9643 | speaker=aoko"
msgid "　どんな心境の変化か知りたくて起こしたら、有珠の方が驚いてたわ。一体、誰の仕業なんだって」"
msgstr "  I woke her up to see if she was okay, and she was just as surprised as I was. We couldn't imagine who would do such a thing.\""

#. Occurrence 7_6:1771:9644: scene=7_6
#: 7_6:1771
msgctxt "text_id=9644 | speaker=unknown"
msgid "　ぽん、と手を叩く草十郎。"
msgstr "  Soujyuro clapped his hands together as if remembering something important."

#. Occurrence 7_6:1782:9645: scene=7_6
#: 7_6:1782
msgctxt "text_id=9645 | speaker=unknown"
msgid "　お茶の用意はしたけれど、<後|あと><片付|かたづ>けをした記憶はまったくない。"
msgstr "  He had forgotten to clean up the tea before leaving."

#. Occurrence 7_6:1802:9646: scene=7_6
#: 7_6:1802
msgctxt "text_id=9646 | speaker=unknown"
msgid "　まずいな、という顔をする草十郎と、そんな彼を見て楽しむ青子。"
msgstr "  The regret written from forehead to chin delighted Aoko immensely."

#. Occurrence 7_6:1837:9647: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0013; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1837
msgctxt "text_id=9647 | speaker=soujuurou"
msgid "「そうか……それじゃあ、有珠は怒っていただろう」"
msgstr "\"I see... How mad was she?\""

#. Occurrence 7_6:1856:9648: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0020; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1856
msgctxt "text_id=9648 | speaker=aoko"
msgid "「当然。駒鳥がとばっちりでドリブルされてたしね」"
msgstr "\"Pretty mad. Robin was all aflutter about it, too.\""

#. Occurrence 7_6:1869:9649: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0014; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1869
msgctxt "text_id=9649 | speaker=soujuurou"
msgid "「ああ、俺でも怒る。片付けをきちんとしないなんて、だらしないにもほどがある」"
msgstr "\"Well I'm mad at myself, too, if that helps. I can't believe I forget to take them back to the kitchen.\""

#. Occurrence 7_6:1880:9650: scene=7_6
#: 7_6:1880
msgctxt "text_id=9650 | speaker=unknown"
msgid "　なんたる失態、と草十郎は激しく自分を責めた。"
msgstr "  Soujyuro harshly scolded himself for his failure."

#. Occurrence 7_6:1904:9651: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0021; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:1904
msgctxt "text_id=9651 | speaker=aoko"
msgid "「論点違うっ！　あのね、寝顔をまぢかで見られたから怒ってるのよ有珠は！」"
msgstr "\"No dummy! She's mad at you because you sat and watched her sleep!\""

#. Occurrence 7_6:1989:9652: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0015; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:1989
msgctxt "text_id=9652 | speaker=soujuurou"
msgid "「え…………そうかな。有珠は、そういうのは気にしないと思うんだけど」"
msgstr "\"Oh... I didn't think she would mind all that much.\""

#. Occurrence 7_6:2029:9653: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0022; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2029
msgctxt "text_id=9653 | speaker=aoko"
msgid "「アンタはそうかもしれないけど、私たちは気にするの！」"
msgstr "\"Well WE do mind when you watch us sleep, just so you know!\""

#. Occurrence 7_6:2070:9654: scene=7_6
#: 7_6:2070
msgctxt "text_id=9654 | speaker=unknown"
msgid "　ぎりり、とガラスを裂く擬音のような目で睨む青子。"
msgstr "  Aoko's glare was enough to make glass shatter."

#. Occurrence 7_6:2075:9655: scene=7_6
#: 7_6:2075
msgctxt "text_id=9655 | speaker=unknown"
msgid "　私たち、という響きに言いようのない迫力を感じる草十郎だった。"
msgstr "  There was an indescribable intensity in the way she said that."

#. Occurrence 7_6:2126:9656: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0016; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2126
msgctxt "text_id=9656 | speaker=soujuurou"
msgid "「それは蒼崎たち限定の話か？」"
msgstr "\"You mean it's a personal pet peeve for you and Alice?\""

#. Occurrence 7_6:2166:9657: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0023; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2166
msgctxt "text_id=9657 | speaker=aoko"
msgid "「世間一般での常識よ。自分が気にしないからって他人もそうだと思ってると、いつか火傷するからね」"
msgstr "\"No, it's common sense! If you go around assuming that other people feel the same way as you, you're asking for trouble.\""

#. Occurrence 7_6:2206:9658: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0017; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2206
msgctxt "text_id=9658 | speaker=soujuurou"
msgid "「む。でもそれだったら、ロビーで寝ている有珠にだって問題ないか？　見かけたら放っておけないだろう、あんなの」"
msgstr "\"Huh. But isn't it kind of her fault for falling asleep in the foyer in the first place? It would be stranger if I saw her like that and didn't want to look out for her.\""

#. Occurrence 7_6:2233:9659: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0024; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2233
msgctxt "text_id=9659 | speaker=aoko"
msgid "「……その心意気は立派だけど、そこはそれ、この館の持ち主は彼女だから。"
msgstr "\"Look, I appreciate that's what you thought, but you just have to understand that that's how the lady of the house is."

#. Occurrence 7_6:2239:9660: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0025; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2239
msgctxt "text_id=9660 | speaker=aoko"
msgid "　この洋館内で貴方が出会ったあらゆる<不義|ふぎ><不始末|ふしまつ>、<失敗|しっぱい><失|しっ><態|たい>の責任は草十郎に押しつけられるの。"
msgstr "  While you live here, responsibility for any and all mistakes or bad judgment on your part will be laid at your feet and your feet alone."

#. Occurrence 7_6:2245:9661: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0026; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2245
msgctxt "text_id=9661 | speaker=aoko"
msgid "　この意味、分かる？」"
msgstr "  Do you get what I'm trying to say here?\""

#. Occurrence 7_6:2262:9662: scene=7_6
#: 7_6:2262
msgctxt "text_id=9662 | speaker=unknown"
msgid "　あんまりな青子の言葉に、草十郎はむむ、と考えこんで、"
msgstr "  Aoko's question sent Soujyuro into a trance of deep thought until finally he uttered,"

#. Occurrence 7_6:2304:9663: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0018; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2304
msgctxt "text_id=9663 | speaker=soujuurou"
msgid "「―――つまり、ここは有珠の自治領なんだな？」"
msgstr "\"So in other words, I'm in Alice's kingdom now?\""

#. Occurrence 7_6:2316:9664: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0027; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2316
msgctxt "text_id=9664 | speaker=aoko"
msgid "「はい、よくできました。正確には私と有珠のだけどね。"
msgstr "\"Yes, congratulations. Although technically this kingdom belongs to both me and her."

#. Occurrence 7_6:2316:9665: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0027; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2316
msgctxt "text_id=9665 | speaker=aoko"
msgid "　領主は何をやっても許されるってコトよ」"
msgstr "  Which means what we say goes.\""

#. Occurrence 7_6:2363:9666: scene=7_6
#: 7_6:2363
msgctxt "text_id=9666 | speaker=unknown"
msgid "　笑顔で言って、青子はソファーに腰を下ろした。"
msgstr "  She smiled as she spoke and plopped herself down on the sofa."

#. Occurrence 7_6:2368:9667: scene=7_6
#: 7_6:2368
msgctxt "text_id=9667 | speaker=unknown"
msgid "　草十郎は青子の向かいのソファーの後ろに立ったまま、今の会話を振り返っていた。"
msgstr "  Soujyuro remained standing behind the sofa opposite her as he ran over their conversation again and again in his head."

#. Occurrence 7_6:2373:9668: scene=7_6
#: 7_6:2373
msgctxt "text_id=9668 | speaker=unknown"
msgid "　有珠の自治領、青子の自治領と言うが、そもそも彼女の家族、実家はどうなっているのか。"
msgstr "  The notion of this being their kingdom made him realize he actually had no idea where the girls had come from or their families' background."

#. Occurrence 7_6:2409:9669: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0019; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2409
msgctxt "text_id=9669 | speaker=soujuurou"
msgid "「蒼崎。君、ご両親はどうしてるんだ？」"
msgstr "\"Where are your parents, Aozaki?\""

#. Occurrence 7_6:2414:9670: scene=7_6
#: 7_6:2414
msgctxt "text_id=9670 | speaker=unknown"
msgid "　草十郎はつい、思いついた疑問を口にする。"
msgstr "  He inadvertently blurted out, this being the question foremost on his mind."

#. Occurrence 7_6:2435:9671: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0028; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2435
msgctxt "text_id=9671 | speaker=aoko"
msgid "「生きてるわよ。三咲町から下りに四駅いった<陶川|とうかわ>ってところの地主。師は祖父だけど、今は隠居して両親と一緒の土地に住んでるわ」"
msgstr "\"They're alive and well. They own a place in Toukawa, four stops from Misaki. I learned everything I know from my grandfather, who's retired now and lives with them.\""

#. Occurrence 7_6:2468:9672: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0020; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2468
msgctxt "text_id=9672 | speaker=soujuurou"
msgid "「……む。そう聞くと、なんだか普通の家庭だな」"
msgstr "\"Huh. Sounds like a pretty normal family.\""

#. Occurrence 7_6:2473:9673: scene=7_6
#: 7_6:2473
msgctxt "text_id=9673 | speaker=unknown"
msgid "　魔法使いの一族というから、草十郎はもっと破天荒なものを想像していたらしい。"
msgstr "  Soujyuro had imagined something more outrageous for a family of magicians."

#. Occurrence 7_6:2494:9674: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0029; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2494
msgctxt "text_id=9674 | speaker=aoko"
msgid "「両親はね。父さんにはあんまり魔術回路は作られなかったみたいだから。その分、私には二世代分の潜在能力があるって祖父は言ってるけど、どうだか。"
msgstr "\"Sure, as far as my parents go. My father sucked as a mage. My grandfather says it skipped a generation so I get double the power, but I'm not so sure about that."

#. Occurrence 7_6:2510:9675: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0030; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2510
msgctxt "text_id=9675 | speaker=aoko"
msgid "　草十郎の期待してるような一族は、どっちかって言うと有珠のほうよ。私と違って英国出身だからね、彼女」"
msgstr "  I think Alice has more the type of family you're imagining. She's from England, you know.\""

#. Occurrence 7_6:2522:9676: scene=7_6
#: 7_6:2522
msgctxt "text_id=9676 | speaker=unknown"
msgid "　そこまで口にして、いけない、と青子は会話を止めた。"
msgstr "  Aoko offered nothing more, as if to suggest that was as far as she was willing to reveal for now."

#. Occurrence 7_6:2527:9677: scene=7_6
#: 7_6:2527
msgctxt "text_id=9677 | speaker=unknown"
msgid "　有珠の事は本人から訊く―――目の前の少年はそう言った。その方針を、こんなところで台無しにする訳にはいかない。"
msgstr "  Soujyuro had insisted on talking to Alice directly rather than hearing things secondhand, so chose not to go back on his word by pushing the topic further."

#. Occurrence 7_6:2555:9678: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0031; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2555
msgctxt "text_id=9678 | speaker=aoko"
msgid "「ま、詳しくは本人から訊きなさい。有珠の紅茶好きもそこからきてるんだし。"
msgstr "\"Ask her if you want to know more. Now you know why she loves English blends of tea so much."

#. Occurrence 7_6:2579:9679: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0032; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2579
msgctxt "text_id=9679 | speaker=aoko"
msgid "　……そう言えば、なんで今日にかぎってリーフティーなんか淹れたの？　ティーバッグを使ったほうがまだマシだったでしょうに」"
msgstr "  ...Speaking of which, why did you use tea leaves today of all days? You should've stuck to the tea bags.\""

#. Occurrence 7_6:2606:9680: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0021; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2606
msgctxt "text_id=9680 | speaker=soujuurou"
msgid "「蒼崎が、そっちの方がいいって言ったじゃないか。"
msgstr "\"But you said the leaves taste better."

#. Occurrence 7_6:2606:9681: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0021; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2606
msgctxt "text_id=9681 | speaker=soujuurou"
msgid "　有珠は紅茶にうるさいって」"
msgstr "  And also that Alice is picky about her tea.\""

#. Occurrence 7_6:2630:9682: scene=7_6
#: 7_6:2630
msgctxt "text_id=9682 | speaker=unknown"
msgid "　むう、と自らの失言に青子は言いよどむ。"
msgstr "  Aoko was momentarily at a loss for words."

#. Occurrence 7_6:2635:9683: scene=7_6
#: 7_6:2635
msgctxt "text_id=9683 | speaker=unknown"
msgid "　大雑把に見えて細かい事を覚えているヤツめ、と。"
msgstr "  He seemed so oblivious most of the time, but apparently he was attentive to some details, at least selectively."

#. Occurrence 7_6:2662:9684: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0033; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2662
msgctxt "text_id=9684 | speaker=aoko"
msgid "「……ま、いいわ。それより明日の放課後だけど、またひとりで帰ってくれない？"
msgstr "\"Just forget it. Anyway, think you can make it home by yourself tomorrow?"

#. Occurrence 7_6:2668:9685: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0034; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2668
msgctxt "text_id=9685 | speaker=aoko"
msgid "　年明けの行事があるんだけど、その場しのぎで言った<餅|もち>つき大会が通っちゃってさ。明日も忙しいのよ、私」"
msgstr "  They accepted my proposal for a mochi-making festival in the new year, so I'll be pretty busy with that.\""

#. Occurrence 7_6:2691:9686: scene=7_6
#: 7_6:2691
msgctxt "text_id=9686 | speaker=unknown"
msgid "　了解、と頷く草十郎。"
msgstr "  Soujyuro nodded in acceptance."

#. Occurrence 7_6:2696:9687: scene=7_6
#: 7_6:2696
msgctxt "text_id=9687 | speaker=unknown"
msgid "　青子に言われずともそのつもりだったらしい。"
msgstr "  In fact he had already been planning to do so before she even asked."

#. Occurrence 7_6:2724:9688: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0022; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2724
msgctxt "text_id=9688 | speaker=soujuurou"
msgid "「それはいいけど、体は大丈夫か蒼崎？　昨日から寝てないだろう」"
msgstr "\"I'll be fine, but what about you? You haven't even slept since yesterday.\""

#. Occurrence 7_6:2750:9689: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0035; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2750
msgctxt "text_id=9689 | speaker=aoko"
msgid "「夕方に三時間ちょい仮眠をとったから調子はいいわ。"
msgstr "\"Oh, I took a quick three-hour nap earlier. I'll be fine."

#. Occurrence 7_6:2756:9690: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0036; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2756
msgctxt "text_id=9690 | speaker=aoko"
msgid "　そう言うアンタこそ体は<保|も>つんでしょうね？　もう少ししたら昨日の続き、始めるわよ」"
msgstr "  What about you for that matter? I hope you didn't forget about our session tonight.\""

#. Occurrence 7_6:2793:9691: scene=7_6
#: 7_6:2793
msgctxt "text_id=9691 | speaker=unknown"
msgid "　昨日の続き、とはマンツーマンによる一夜漬けだ。"
msgstr "  She meant the all-night cramming session, of course."

#. Occurrence 7_6:2798:9692: scene=7_6
#: 7_6:2798
msgctxt "text_id=9692 | speaker=unknown"
msgid "　あれから一睡もしていない草十郎にとって、厳しい荒行なのは言うまでもないが―――"
msgstr "  Needless to say, Soujyuro was more than likely to struggle given that he, too, had not slept a wink."

#. Occurrence 7_6:2835:9693: scene=7_6
#: 7_6:2835
msgctxt "text_id=9693 | speaker=unknown"
msgid "　それ以上に、嬉しくてつい頬が緩んでしまう。"
msgstr "  All he could do was give a relieved smile."

#. Occurrence 7_6:2840:9694: scene=7_6
#: 7_6:2840
msgctxt "text_id=9694 | speaker=unknown"
msgid "　転校当時、物陰からはらはらと自分の行動を監視していた彼女の、分かりづらい心遣いが思い出される。"
msgstr "  He thought back to the days just after he transferred here, when she watched his every move from the sidelines and showed a startling amount of concern for him."

#. Occurrence 7_6:2867:9695: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0023; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2867
msgctxt "text_id=9695 | speaker=soujuurou"
msgid "「いいよ。どのみち苦労するのは蒼崎の方だし。"
msgstr "\"I didn't forget. And besides, it's tougher on you than me, Aozaki."

#. Occurrence 7_6:2867:9696: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_6_0023; voice_prefix=A30; voice_category=3; scene=7_6
#: 7_6:2867
msgctxt "text_id=9696 | speaker=soujuurou"
msgid "　異例中の異例は、有り難く受け取っておくとしよう」"
msgstr "  I'm still glad to be your exception among exceptions.\""

#. Occurrence 7_6:2907:9697: scene=7_6
#: 7_6:2907
msgctxt "text_id=9697 | speaker=unknown"
msgid "　晴れ晴れとした顔で返され、青子は小さく呆れながら、"
msgstr "  His cheery response grated on her just a little."

#. Occurrence 7_6:2930:9698: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_6_0037; voice_prefix=A10; voice_category=1; scene=7_6
#: 7_6:2930
msgctxt "text_id=9698 | speaker=aoko"
msgid "「……ほんと。くだらない事だけは、しつこく覚えてるんだから」"
msgstr "\"Wow. You manage to forget everything except the most irritating little details, don't you?\""

#. Occurrence 7_6:2936:9699: scene=7_6
#: 7_6:2936
msgctxt "text_id=9699 | speaker=unknown"
msgid "　その笑顔から視線を逸らすように、やれやれと肩をすくめるのだった。"
msgstr "  She heaved her shoulders in exasperation and dropped her head as an excuse to look away from the beaming smile on his face."

#. Occurrence 7_7:86:9700: scene=7_7
#: 7_7:86
msgctxt "text_id=9700 | speaker=unknown"
msgid "　翌日。"
msgstr "  The following day..."

#. Occurrence 7_7:91:9701: scene=7_7
#: 7_7:91
msgctxt "text_id=9701 | speaker=unknown"
msgid "　期末試験、その最終日は滞りなく終了した。"
msgstr "  The last day of finals had ended without a hitch."

#. Occurrence 7_7:106:9702: scene=7_7
#: 7_7:106
msgctxt "text_id=9702 | speaker=unknown"
msgid "　多くの学生たちにとって十二月最大の難問は、晴れて過去の歴史と消え去った。"
msgstr "  That final December hurdle was finally a thing of the past."

#. Occurrence 7_7:111:9703: scene=7_7
#: 7_7:111
msgctxt "text_id=9703 | speaker=unknown"
msgid "　だが。"
msgstr "  For all but one student, that is."

#. Occurrence 7_7:126:9704: scene=7_7
#: 7_7:126
msgctxt "text_id=9704 | speaker=unknown"
msgid "　草十郎にとって最大の難問は、この後にこそ控えている。"
msgstr "  To Soujyuro, the greatest challenge was yet to come."

#. Occurrence 7_7:169:9705: scene=7_7
#: 7_7:169
msgctxt "text_id=9705 | speaker=unknown"
msgid "　明日の終業式に向けて浮き足立つクラスメイトたちと町中で別れを告げ、白犬塚の森の中へ。"
msgstr "  He bid farewell to his classmates, all jittery with excitement for the last day of term, and headed into the Shiroinuzuka woods."

#. Occurrence 7_7:174:9706: scene=7_7
#: 7_7:174
msgctxt "text_id=9706 | speaker=unknown"
msgid "　昨日通りの帰宅風景、"
msgstr "  The road home was no different than yesterday,"

#. Occurrence 7_7:179:9707: scene=7_7
#: 7_7:179
msgctxt "text_id=9707 | speaker=unknown"
msgid "　昨日の焼き直しのような気分で、草十郎は坂道を登っていく。"
msgstr "  like he was reliving yet another day striding up that hill."

#. Occurrence 7_7:223:9708: scene=7_7
#: 7_7:223
msgctxt "text_id=9708 | speaker=unknown"
msgid "　草十郎とて確固たる決意に燃えている。"
msgstr "  Yet today, there was a fierce determination in his steps."

#. Occurrence 7_7:228:9709: scene=7_7
#: 7_7:228
msgctxt "text_id=9709 | speaker=unknown"
msgid "　今日が最終期限であるし、なにより草十郎自身、あの少女の<話|こえ>を聞きたがっていた。"
msgstr "  Today was his last chance, and he wanted nothing more than to talk to the girl."

#. Occurrence 7_7:233:9710: scene=7_7
#: 7_7:233
msgctxt "text_id=9710 | speaker=unknown"
msgid "　多少邪険に扱われても、とことん無視されても、果ては“怒らせると鏡の国に放りこまれるわよ”とニヤけ顔で笑う青子の忠告を実現させる事になったとしても、挨拶ぐらいはしたいのである。"
msgstr "  He did not care if she was cruel to him or ignored him, nor whether Aoko was being truthful when she said that she could trap him in a mirror land or something like that. All he really cared about was having the chance to speak with her face-to-face."

#. Occurrence 7_7:275:9711: scene=7_7
#: 7_7:275
msgctxt "text_id=9711 | speaker=unknown"
msgid "　―――しかし。"
msgstr "  But nothing is ever that simple."

#. Occurrence 7_7:281:9712: scene=7_7
#: 7_7:281
msgctxt "text_id=9712 | speaker=unknown"
msgid "　草十郎を待ち受けていたものは、半分以上、なんとなく予感していた通りの光景だった。"
msgstr "  To tell the truth, what he found upon finally entering the mansion was not wholly unexpected."

#. Occurrence 7_7:315:9713: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0000; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:315
msgctxt "text_id=9713 | speaker=soujuurou"
msgid "「…………よく寝る子だな、ほんと」"
msgstr "\"...She sure sleeps a lot.\""

#. Occurrence 7_7:350:9714: scene=7_7
#: 7_7:350
msgctxt "text_id=9714 | speaker=unknown"
msgid "　目眩を覚えるほどの既視感。"
msgstr "  The déjà vu he was experiencing made him dizzy."

#. Occurrence 7_7:355:9715: scene=7_7
#: 7_7:355
msgctxt "text_id=9715 | speaker=unknown"
msgid "　見た目だけなら昨日と何ら変わらない風景に迎えられて、草十郎は素直な感想を漏らした。"
msgstr "  Faced with an exact reenactment of the previous day, he could not help but blurt out what he was thinking."

#. Occurrence 7_7:375:9716: scene=7_7
#: 7_7:375
msgctxt "text_id=9716 | speaker=unknown"
msgid "　少女は今日も暖炉の<傍|そば>で眠っている。"
msgstr "  Alice was sleeping by the fireplace, just as she had done yesterday."

#. Occurrence 7_7:380:9717: scene=7_7
#: 7_7:380
msgctxt "text_id=9717 | speaker=unknown"
msgid "　正座から横にしなだれ落ちた両足は、絵本で見る少女の座り方に似ていた。"
msgstr "  The way her legs draped to one side resembled those of a princess in a children's book."

#. Occurrence 7_7:385:9718: scene=7_7
#: 7_7:385
msgctxt "text_id=9718 | speaker=unknown"
msgid "　昨日よりは<幾分|いくぶん>居心地のいい座り方だろう。"
msgstr "  She looked more comfortable than she had the day before."

#. Occurrence 7_7:403:9719: scene=7_7
#: 7_7:403
msgctxt "text_id=9719 | speaker=unknown"
msgid "　たまに奇跡的な察しの良さを発揮する彼は、それで事の<絡|から><繰|くり>が読めてしまった。"
msgstr "  Miraculously, he had a rare flash of insight that enabled him to read the situation more clearly."

#. Occurrence 7_7:424:9720: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0001; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:424
msgctxt "text_id=9720 | speaker=soujuurou"
msgid "『……学校で、鳶丸はひとり何をしているんだろう……』"
msgstr "(...What could Tobimaru be doing at school on his own?)"

#. Occurrence 7_7:438:9721: scene=7_7
#: 7_7:438
msgctxt "text_id=9721 | speaker=unknown"
msgid "　ちらりと入ってきた玄関へ視線を投げて、よし、と気合いを入れて腕まくりをする。"
msgstr "  Upon glancing back at the entrance, he made his decision, took a deep breath, and rolled up his sleeves."

#. Occurrence 7_7:443:9722: scene=7_7
#: 7_7:443
msgctxt "text_id=9722 | speaker=unknown"
msgid "　何もかも昨日の通りなら、自分もそれに合わせてみようと思ったのか。"
msgstr "  If today was a reenactment of yesterday, then he supposed he would play along with that idea."

#. Occurrence 7_7:448:9723: scene=7_7
#: 7_7:448
msgctxt "text_id=9723 | speaker=unknown"
msgid "　草十郎は鞄を置いて台所に向かった。"
msgstr "  Soujyuro removed his shoes and headed for the kitchen."

#. Occurrence 7_7:453:9724: scene=7_7
#: 7_7:453
msgctxt "text_id=9724 | speaker=unknown"
msgid "　もちろん昨日と同じ、不出来な紅茶を淹れるために。"
msgstr "  He was off to prepare another ill-fated pot of tea."

#. Occurrence 7_7:494:9725: scene=7_7
#: 7_7:494
msgctxt "text_id=9725 | speaker=unknown"
msgid "　フォションは怒られたので、今日は反省してジャクソンのフルーツハーブを手に取る。"
msgstr "  Since she was angry about him using her precious Fauchon, this time he turned to Jacksons' Fruit & Herb brew."

#. Occurrence 7_7:500:9726: scene=7_7
#: 7_7:500
msgctxt "text_id=9726 | speaker=unknown"
msgid "　……悲しいかな、これが今の草十郎の限界だった。"
msgstr "  ...Sadly, this was about as much as Soujyuro could manage to amend his behavior."

#. Occurrence 7_7:505:9727: scene=7_7
#: 7_7:505
msgctxt "text_id=9727 | speaker=unknown"
msgid "　お茶の葉の種類で怒られたのではなく、それを使いこなせなかった事が問題だったと気付いていない。"
msgstr "  He had failed to realize that it was not the brand of tea that had landed him in hot water, but rather his incorrect brewing method."

#. Occurrence 7_7:551:9728: scene=7_7
#: 7_7:551
msgctxt "text_id=9728 | speaker=unknown"
msgid "　ポットに紅茶を淹れてロビーに戻る。"
msgstr "  After filling the pot with tea, he carried it back to the foyer."

#. Occurrence 7_7:557:9729: scene=7_7
#: 7_7:557
msgctxt "text_id=9729 | speaker=unknown"
msgid "　白い息をこぼして草十郎は暖炉の前にあぐらをかいた。"
msgstr "  His breath was visible in the cold air as he sat himself down by the fireplace."

#. Occurrence 7_7:562:9730: scene=7_7
#: 7_7:562
msgctxt "text_id=9730 | speaker=unknown"
msgid "　自分で淹れたフルーツミックスを口にし、鞄から教科書を取りだす。"
msgstr "  Soujyuro took a sip of the fruity tea he prepared for himself and pulled his textbook from his bag."

#. Occurrence 7_7:567:9731: scene=7_7
#: 7_7:567
msgctxt "text_id=9731 | speaker=unknown"
msgid "　期末試験は終わったけれど、一日目の科目はいくつか補習を宣言されたので、やっぱりこうなる運命なのだ。"
msgstr "  Exams were over now, but he had been instructed to take extra classes for the subjects from day one of school. Quite inevitable."

#. Occurrence 7_7:597:9732: scene=7_7
#: 7_7:597
msgctxt "text_id=9732 | speaker=unknown"
msgid "　ロビーは外より<幾分|いくぶん>暖かいが、快適にはほど遠い。何らかの暖が恋しくなる寒さだ。"
msgstr "  The foyer was warmer than outside but still far from comfortable. It was enough to make anyone yearn for some source of warmth."

#. Occurrence 7_7:602:9733: scene=7_7
#: 7_7:602
msgctxt "text_id=9733 | speaker=unknown"
msgid "　冬の寒気を色濃く残すホールで、草十郎は電子工学のテキストに没頭した。"
msgstr "  Soujyuro dove into his electronics textbook in the winter-chilled hall."

#. Occurrence 7_7:607:9734: scene=7_7
#: 7_7:607
msgctxt "text_id=9734 | speaker=unknown"
msgid "　選択する生徒が少ないという理由で勧められた科目だが、高校から基礎が始まる分、他の科目より少しだけ面白い。"
msgstr "  The class was not very popular, which is why it had been recommended to him in the first place. That fact that everyone who took it started on equal footing made it more appealing to him than other classes."

#. Occurrence 7_7:628:9735: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0002; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:628
msgctxt "text_id=9735 | speaker=soujuurou"
msgid "『けど、蒼崎の言う通り』"
msgstr "(Aozaki was right...)"

#. Occurrence 7_7:634:9736: scene=7_7
#: 7_7:634
msgctxt "text_id=9736 | speaker=unknown"
msgid "　味の分からない紅茶を空にして、カップに二杯目を注ぐ。"
msgstr "  He downed the rest of the tea, having no appreciation for its flavor, and refilled his cup."

#. Occurrence 7_7:639:9737: scene=7_7
#: 7_7:639
msgctxt "text_id=9737 | speaker=unknown"
msgid "　陶磁器のポットは保温性に勝れているので、紅茶はまだ温かい。"
msgstr "  The tea was still warm, since the ceramic teapot had excellent heat retention."

#. Occurrence 7_7:645:9738: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0003; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:645
msgctxt "text_id=9738 | speaker=soujuurou"
msgid "『文字で物事を覚えるのは、苦手みたいだ』"
msgstr "(I can't seem to remember anything that's written down.)"

#. Occurrence 7_7:663:9739: scene=7_7
#: 7_7:663
msgctxt "text_id=9739 | speaker=unknown"
msgid "　ぼんやりと思いながら、草十郎は文字の羅列を読み進める。"
msgstr "  He vaguely recalled their conversation as his eyes advanced across the page."

#. Occurrence 7_7:683:9740: scene=7_7
#: 7_7:683
msgctxt "text_id=9740 | speaker=unknown"
msgid "　ロビーに電灯はなく、天窓からの日射しだけが頼りだ。"
msgstr "  The lack of lighting in the foyer was forcing him to rely on illumination from the skylight."

#. Occurrence 7_7:688:9741: scene=7_7
#: 7_7:688
msgctxt "text_id=9741 | speaker=unknown"
msgid "　斜に差しこむ光はロビーに明暗を作り、壁際の暖炉はじき影に沈もうとしている。"
msgstr "  The light cut into the room at a diagonal angle in such a way as to divide the foyer into light and dark areas, with the fireplace in shadow."

#. Occurrence 7_7:722:9742: scene=7_7
#: 7_7:722
msgctxt "text_id=9742 | speaker=unknown"
msgid "　見ようによっては、灰に<浸|ひた>された廃墟の風景。"
msgstr "  The room resembled ancient ruins covered in ash."

#. Occurrence 7_7:727:9743: scene=7_7
#: 7_7:727
msgctxt "text_id=9743 | speaker=unknown"
msgid "　あるいは、くすんだ童話の中に忘れられた、色あせた挿し絵の世界。"
msgstr "  Or perhaps the quiet, forgotten world of a faded fairy tale."

#. Occurrence 7_7:733:9744: scene=7_7
#: 7_7:733
msgctxt "text_id=9744 | speaker=unknown"
msgid "　白い城壁の部屋で、時間は人知れず、太陽の目を盗むようにこつこつと流れていった。"
msgstr "  Time slipped on by within the white walls of this room, hidden away from the sun."

#. Occurrence 7_7:808:9745: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0004; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:808
msgctxt "text_id=9745 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 7_7:814:9746: scene=7_7
#: 7_7:814
msgctxt "text_id=9746 | speaker=unknown"
msgid "　そうして、ゆるやかに時間が過ぎたあと。"
msgstr "  The minutes passed slowly for some time. Until..."

#. Occurrence 7_7:820:9747: scene=7_7
#: 7_7:820
msgctxt "text_id=9747 | speaker=unknown"
msgid "　ぱたんと教科書を閉じた音が、くすんだ風景を現実に引き戻した。"
msgstr "  The sound of a textbook slamming shut brought the room back to reality."

#. Occurrence 7_7:825:9748: scene=7_7
#: 7_7:825
msgctxt "text_id=9748 | speaker=unknown"
msgid "　草十郎は腕を伸ばして肩の凝りをほぐすと、いそいそと後片づけをはじめる。"
msgstr "  Soujyuro stretched his stiff back and eagerly got started on clearing up."

#. Occurrence 7_7:846:9749: scene=7_7
#: 7_7:846
msgctxt "text_id=9749 | speaker=unknown"
msgid "　本を鞄にしまい、"
msgstr "  He put his textbook back in his bag,"

msgctxt "text_id=9750 | speaker=unknown"
msgid "　有珠のカップはそのまま床に残し、"
msgstr "placed his cup on the tray,"

msgctxt "text_id=9751 | speaker=unknown"
msgid "　自分の使ったカップをトレイに載せて立ち上がって、"
msgstr "leaving Alice's sitting in front of her on the floor."

#. Occurrence 7_7:859:9752: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0005; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:859
msgctxt "text_id=9752 | speaker=soujuurou"
msgid "「バイトの時間だ」"
msgstr "\"Well, time to go to work,\""

#. Occurrence 7_7:864:9753: scene=7_7
#: 7_7:864
msgctxt "text_id=9753 | speaker=unknown"
msgid "　あっさりと。"
msgstr "  he said unceremoniously."

#. Occurrence 7_7:882:9754: scene=7_7
#: 7_7:882
msgctxt "text_id=9754 | speaker=unknown"
msgid "　そういう事なら仕方ない、と納得するように口にして、眠るロビーを後にした。"
msgstr "  He spoke as if to convince himself that he had no other choice as he prepared to leave the sleepy foyer behind."

#. Occurrence 7_7:917:9755: scene=7_7
#: 7_7:917
msgctxt "text_id=9755 | speaker=unknown"
msgid "　―――その直前。"
msgstr "  But before he could..."

#. Occurrence 7_7:927:9756: scene=7_7
#: 7_7:927
msgctxt "text_id=9756 | speaker=unknown"
msgid "　背後からの物音を聞いて、草十郎は足を止めた。"
msgstr "  A sound behind him stopped him in his tracks."

#. Occurrence 7_7:942:9757: scene=7_7
#: 7_7:942
msgctxt "text_id=9757 | speaker=unknown"
msgid "　鞄を<脇|わき>に挟んだままトレイ片手に振り返る。"
msgstr "  He turned around with his bag under his arm and tray in his hands."

#. Occurrence 7_7:957:9758: scene=7_7
#: 7_7:957
msgctxt "text_id=9758 | speaker=unknown"
msgid "　有珠用のカップに注がれた紅茶に波ひとつ立てず、"
msgstr "  So as not to cause even a ripple in her teacup, he greeted her,"

#. Occurrence 7_7:976:9759: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0006; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:976
msgctxt "text_id=9759 | speaker=soujuurou"
msgid "「や」"
msgstr "\"Hey,\""

#. Occurrence 7_7:981:9760: scene=7_7
#: 7_7:981
msgctxt "text_id=9760 | speaker=unknown"
msgid "　気軽な口振りで、草十郎はそう語りかけた。"
msgstr "  in a light, easygoing manner."

#. Occurrence 7_7:1000:9761: scene=7_7
#: 7_7:1000
msgctxt "text_id=9761 | speaker=unknown"
msgid "　暖炉の横で座ったままの、黒い瞳の眠り姫に。"
msgstr "  She remained seated next to the fireplace like a black-eyed sleeping beauty."

#. Occurrence 7_7:1031:9762: scene=7_7
#: 7_7:1031
msgctxt "text_id=9762 | speaker=unknown"
msgid "　有珠は彫像のようだった寝顔と変わらない静かさで草十郎を見ている。"
msgstr "  Her face was as still as a statue, almost no different than it had been in slumber."

#. Occurrence 7_7:1036:9763: scene=7_7
#: 7_7:1036
msgctxt "text_id=9763 | speaker=unknown"
msgid "　それを見て、草十郎は今更ながら有珠と青子の違いに気が付いた。"
msgstr "  Looking at Alice now, he realized just how different she and Aoko really were."

#. Occurrence 7_7:1070:9764: scene=7_7
#: 7_7:1070
msgctxt "text_id=9764 | speaker=unknown"
msgid "　青子は、その思考経路は謎としても、実に分かりやすい意思表示をしてくれる。"
msgstr "  Aoko communicated her feelings openly, even if he never could quite tell where they came from."

#. Occurrence 7_7:1075:9765: scene=7_7
#: 7_7:1075
msgctxt "text_id=9765 | speaker=unknown"
msgid "　トレードマークである不機嫌そうな顔は、何に不機嫌なのかはさておくとして、常に意思を反映している。"
msgstr "  Her trademark expression of irritation would keep him guessing as to the reason she was angry, but to her credit her emotional state was always clear."

#. Occurrence 7_7:1080:9766: scene=7_7
#: 7_7:1080
msgctxt "text_id=9766 | speaker=unknown"
msgid "　対して、有珠はそもそも感情が読めない。"
msgstr "  Alice, on the other hand, was completely unreadable."

#. Occurrence 7_7:1085:9767: scene=7_7
#: 7_7:1085
msgctxt "text_id=9767 | speaker=unknown"
msgid "　怒っているのか悲しんでいるのかさえ表れない。"
msgstr "  She might be angry, or then again sad; he could not tell either way."

#. Occurrence 7_7:1106:9768: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0000; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1106
msgctxt "text_id=9768 | speaker=alice"
msgid "「何の、つもり―――？」"
msgstr "\"What do you think you're doing?\""

#. Occurrence 7_7:1123:9769: scene=7_7
#: 7_7:1123
msgctxt "text_id=9769 | speaker=unknown"
msgid "　沈みこむような問いかけ。"
msgstr "  Her question gave him a sinking feeling in the pit of his stomach."

#. Occurrence 7_7:1128:9770: scene=7_7
#: 7_7:1128
msgctxt "text_id=9770 | speaker=unknown"
msgid "　敵意なのか疑問なのかすら、草十郎には判別がつかない。"
msgstr "  He could not decide whether it was animosity or perplexity that he heard in her voice."

#. Occurrence 7_7:1133:9771: scene=7_7
#: 7_7:1133
msgctxt "text_id=9771 | speaker=unknown"
msgid "　もし前者なら、有珠を相手にあの夜の再現になるかもしれない。"
msgstr "  If the former, this was likely to turn into a replay of their interaction from the other night."

#. Occurrence 7_7:1163:9772: scene=7_7
#: 7_7:1163
msgctxt "text_id=9772 | speaker=unknown"
msgid "　粉々に散った小瓶が草十郎の脳裏をよぎる。"
msgstr "  An image of the shattered bottle sprang to his mind."

#. Occurrence 7_7:1168:9773: scene=7_7
#: 7_7:1168
msgctxt "text_id=9773 | speaker=unknown"
msgid "　返答次第では無事では済まないと承知して、"
msgstr "  Soujyuro knew his response would be extremely important,"

#. Occurrence 7_7:1173:9774: scene=7_7
#: 7_7:1173
msgctxt "text_id=9774 | speaker=unknown"
msgid "　しばし迷ったあと、草十郎は覚悟を決めた。"
msgstr "  and after struggling for a few moments he finally worked up the courage to say something."

#. Occurrence 7_7:1178:9775: scene=7_7
#: 7_7:1178
msgctxt "text_id=9775 | speaker=unknown"
msgid "　と、言うより―――"
msgstr "  Just not the correct thing, unfortunately."

#. Occurrence 7_7:1211:9776: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0007; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1211
msgctxt "text_id=9776 | speaker=soujuurou"
msgid "「そうだな。一口じゃ説明できないから、座るよ」"
msgstr "\"Right, about that... It'll take awhile to explain, so let me just have a seat first.\""

#. Occurrence 7_7:1217:9777: scene=7_7
#: 7_7:1217
msgctxt "text_id=9777 | speaker=unknown"
msgid "　何が正しい選択か考えもつかなかったので、単純に、自分のしたい事をする事にした。"
msgstr "  He had no idea what the correct approach would be, so he simply did whatever came into his mind instead."

#. Occurrence 7_7:1251:9778: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0001; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1251
msgctxt "text_id=9778 | speaker=alice"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 7_7:1256:9779: scene=7_7
#: 7_7:1256
msgctxt "text_id=9779 | speaker=unknown"
msgid "　返事はない。"
msgstr "  She gave him no response."

#. Occurrence 7_7:1261:9780: scene=7_7
#: 7_7:1261
msgctxt "text_id=9780 | speaker=unknown"
msgid "　黒衣の少女は嫌がっているようにも見えたが、草十郎はあえて無視した。"
msgstr "  Her face said that she detested his presence, but he plowed ahead regardless."

#. Occurrence 7_7:1296:9781: scene=7_7
#: 7_7:1296
msgctxt "text_id=9781 | speaker=unknown"
msgid "　もう一度床に座ってトレイを置くと、ふたりの視線はぴったりと合った。"
msgstr "  Soujyuro took a seat and set down the tray once more. Their eyes met."

#. Occurrence 7_7:1301:9782: scene=7_7
#: 7_7:1301
msgctxt "text_id=9782 | speaker=unknown"
msgid "　底の見えない有珠の瞳は、依然として余人を寄せつけない。"
msgstr "  Her inscrutable gaze was enough to turn most people away."

#. Occurrence 7_7:1318:9783: scene=7_7
#: 7_7:1318
msgctxt "text_id=9783 | speaker=unknown"
msgid "　が。肝心の草十郎は、そんな重圧をまったく感じてはいないようだった。"
msgstr "  But, the target of her animosity appeared not to notice it at all."

#. Occurrence 7_7:1355:9784: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0002; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1355
msgctxt "text_id=9784 | speaker=alice"
msgid "「それで、なに……？」"
msgstr "\"Yes...?\""

#. Occurrence 7_7:1361:9785: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0008; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1361
msgctxt "text_id=9785 | speaker=soujuurou"
msgid "「ああ。遅くなったけど、こうして話がしたかったんだ、有珠と」"
msgstr "\"Ah, well, I guess I should have done this a long time ago, but I've been wanting to talk to you about something, Alice.\""

#. Occurrence 7_7:1373:9786: scene=7_7
#: 7_7:1373
msgctxt "text_id=9786 | speaker=unknown"
msgid "　一口じゃ説明できないらしいのに、草十郎はあっさりと一口で説明した。"
msgstr "  Despite having suggested that it would take time to explain, he managed to sum things up succinctly."

#. Occurrence 7_7:1400:9787: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0003; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1400
msgctxt "text_id=9787 | speaker=alice"
msgid "「わたしと……？　青子とではなく？」"
msgstr "\"Me? Not Aoko?\""

#. Occurrence 7_7:1406:9788: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0009; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1406
msgctxt "text_id=9788 | speaker=soujuurou"
msgid "「ん？　そうだね、蒼崎とはもっと話したいところだけど、それよりは三人で話してみたい」"
msgstr "\"Hm? Well, I have lots to talk to Aozaki about. In fact, I think all three of us should sit down at some point...\""

#. Occurrence 7_7:1412:9789: scene=7_7
#: 7_7:1412
msgctxt "text_id=9789 | speaker=unknown"
msgid "　草十郎の意図が読めず、戸惑う有珠。"
msgstr "  Alice found herself out of kilter, unable to read his true intentions."

#. Occurrence 7_7:1417:9790: scene=7_7
#: 7_7:1417
msgctxt "text_id=9790 | speaker=unknown"
msgid "　そんな有珠の困惑に気付かず、草十郎はしかつめらしく話を続ける。"
msgstr "  Soujyuro continued on, failing to notice her bewilderment."

#. Occurrence 7_7:1451:9791: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0010; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1451
msgctxt "text_id=9791 | speaker=soujuurou"
msgid "「蒼崎は普段から有珠とは会話がないって言うんだ。それが俺のせいなら困るし、俺のせいじゃないならもっと困る。"
msgstr "\"Aozaki said you two rarely speak to each other. I'd feel bad if that's because of me, but I'd feel even worse if it isn't."

#. Occurrence 7_7:1457:9792: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0011; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1457
msgctxt "text_id=9792 | speaker=soujuurou"
msgid "　せっかく同じ場所に居るのに会話がないなんて、もったいないと思うんだ」"
msgstr "  It's sad that we live together but never talk.\""

#. Occurrence 7_7:1477:9793: scene=7_7
#: 7_7:1477
msgctxt "text_id=9793 | speaker=unknown"
msgid "　噛みしめるような、やけに情感の籠もった声。"
msgstr "  Each word he spoke was heavy with emotion."

#. Occurrence 7_7:1482:9794: scene=7_7
#: 7_7:1482
msgctxt "text_id=9794 | speaker=unknown"
msgid "　有珠には少年の意図はこれっぽっちも掴めない。"
msgstr "  Alice remained utterly unable to discern this boy's intentions."

#. Occurrence 7_7:1487:9795: scene=7_7
#: 7_7:1487
msgctxt "text_id=9795 | speaker=unknown"
msgid "　けれど、彼が自分に対して強く、何かを願っているのは感じ取れる。"
msgstr "  All she could parse was that there was something he wanted from her."

#. Occurrence 7_7:1502:9796: scene=7_7
#: 7_7:1502
msgctxt "text_id=9796 | speaker=unknown"
msgid "　……それが。"
msgstr "  ...But what could that be?"

#. Occurrence 7_7:1507:9797: scene=7_7
#: 7_7:1507
msgctxt "text_id=9797 | speaker=unknown"
msgid "　恐れに起因するものでない事が、彼女には意外だった。"
msgstr "  What she found even stranger was that he was not speaking to her from a place of fear."

#. Occurrence 7_7:1542:9798: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0004; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1542
msgctxt "text_id=9798 | speaker=alice"
msgid "「貴方は、わたしが恐くないの……？」"
msgstr "\"Aren't you afraid of me?\""

#. Occurrence 7_7:1564:9799: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0012; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1564
msgctxt "text_id=9799 | speaker=soujuurou"
msgid "「ああ。だってそう言えるほど、俺は君をよく知らない」"
msgstr "\"No. I don't know enough about you to be scared of you, to tell the truth.\""

#. Occurrence 7_7:1600:9800: scene=7_7
#: 7_7:1600
msgctxt "text_id=9800 | speaker=unknown"
msgid "　見開いた瞳は<玻|は><璃|り>細工のように。"
msgstr "  Her gleaming eyes looked like they were made of polished quartz."

#. Occurrence 7_7:1605:9801: scene=7_7
#: 7_7:1605
msgctxt "text_id=9801 | speaker=unknown"
msgid "　少女にとって、少年の予想外さはもう驚きの域だった。"
msgstr "  His response had not been what she expected."

#. Occurrence 7_7:1610:9802: scene=7_7
#: 7_7:1610
msgctxt "text_id=9802 | speaker=unknown"
msgid "　あまりにも素直な、脊髄反射のような答え。"
msgstr "  He spoke with pure honesty and unfettered truth."

#. Occurrence 7_7:1615:9803: scene=7_7
#: 7_7:1615
msgctxt "text_id=9803 | speaker=unknown"
msgid "　そんな無遠慮極まりない言葉が、なぜか不快と感じない。"
msgstr "  Such boldness, however, did not actually upset her."

#. Occurrence 7_7:1661:9804: scene=7_7
#: 7_7:1661
msgctxt "text_id=9804 | speaker=unknown"
msgid "　ふたりの会話はそこで途絶えた。"
msgstr "  Their conversation ground to a halt,"

#. Occurrence 7_7:1688:9805: scene=7_7
#: 7_7:1688
msgctxt "text_id=9805 | speaker=unknown"
msgid "　いや、もとより会話は成立していない。"
msgstr "  if you could even call it a conversation in the first place."

#. Occurrence 7_7:1705:9806: scene=7_7
#: 7_7:1705
msgctxt "text_id=9806 | speaker=unknown"
msgid "　不思議と居心地のいい沈黙を嫌うように、少女は気を引き締める。"
msgstr "  Alice grew tense, as if displeased by the strangely comfortable moment of silence between them."

#. Occurrence 7_7:1710:9807: scene=7_7
#: 7_7:1710
msgctxt "text_id=9807 | speaker=unknown"
msgid "　少年はそんな少女の視線を、怯えることなく受けとめる。"
msgstr "  Soujyuro endured her cold stare, showing no sign of flinching."

#. Occurrence 7_7:1731:9808: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0005; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1731
msgctxt "text_id=9808 | speaker=alice"
msgid "「…………話」"
msgstr "\"...Talk.\""

#. Occurrence 7_7:1750:9809: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0013; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1750
msgctxt "text_id=9809 | speaker=soujuurou"
msgid "「ん？」"
msgstr "\"Hm?\""

#. Occurrence 7_7:1768:9810: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0006; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1768
msgctxt "text_id=9810 | speaker=alice"
msgid "「わたしと話をしたいと言ったでしょう。"
msgstr "\"You said you wanted to talk to me."

#. Occurrence 7_7:1774:9811: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0007; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1774
msgctxt "text_id=9811 | speaker=alice"
msgid "　なら、好きにしてみたら……？」"
msgstr "  So... be my guest. Whatever topic you like.\""

#. Occurrence 7_7:1808:9812: scene=7_7
#: 7_7:1808
msgctxt "text_id=9812 | speaker=unknown"
msgid "　できるものならしてみろ、という少女の誘い。"
msgstr "  It was more a challenge than an invitation."

#. Occurrence 7_7:1813:9813: scene=7_7
#: 7_7:1813
msgctxt "text_id=9813 | speaker=unknown"
msgid "　草十郎には彼女に話しかける話題も、親密さもない。"
msgstr "  He had neither a topic on hand, nor were they intimate enough to strike up a casual conversation."

#. Occurrence 7_7:1818:9814: scene=7_7
#: 7_7:1818
msgctxt "text_id=9814 | speaker=unknown"
msgid "　意地の悪い少女の挑発は、しかし。"
msgstr "  Nonetheless, her challenge hanged in the air, waiting for a response."

#. Occurrence 7_7:1853:9815: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0014; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1853
msgctxt "text_id=9815 | speaker=soujuurou"
msgid "「じゃあ、あの鳥の話を。ほら、そこにいる青い鳥。"
msgstr "\"Well, what about that bird? The blue one over there."

#. Occurrence 7_7:1859:9816: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0015; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1859
msgctxt "text_id=9816 | speaker=soujuurou"
msgid "　たまに見かけるんだけど、君の飼い鳥か？"
msgstr "  I see it around now and then. Is it your pet?"

#. Occurrence 7_7:1865:9817: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0016; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1865
msgctxt "text_id=9817 | speaker=soujuurou"
msgid "　それともほら、なんて言ったかな。プロイ、だっけ。あの鳥も有珠の使い魔？」"
msgstr "  Or is it one of those, what are they called... 'Ploys'? A magical familiar?\""

#. Occurrence 7_7:1885:9818: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0008; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1885
msgctxt "text_id=9818 | speaker=alice"
msgid "「っ―――」"
msgstr "\"...\""

#. Occurrence 7_7:1890:9819: scene=7_7
#: 7_7:1890
msgctxt "text_id=9819 | speaker=unknown"
msgid "　一瞬、少女の瞳に人間らしい色が灯る。"
msgstr "  Her eyes let slip for a moment a very natural response."

#. Occurrence 7_7:1895:9820: scene=7_7
#: 7_7:1895
msgctxt "text_id=9820 | speaker=unknown"
msgid "　あの厄介者、と睨みつけるような視線だった。"
msgstr "  It was annoyance, such as that which one might feel toward a troublemaker."

#. Occurrence 7_7:1943:9821: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0009; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1943
msgctxt "text_id=9821 | speaker=alice"
msgid "「……アレもプロイだけど、わたしとは何の関係もない<駄鳥|だちょう>。ずいぶん古くから<在|い>るだけで、わたしもよく知らないわ」"
msgstr "\"Yes, it's a Ploy, but the stupid bird isn't mine. It's lived here longer than I have, and I'm afraid I don't know much about it.\""

#. Occurrence 7_7:1962:9822: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0017; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:1962
msgctxt "text_id=9822 | speaker=soujuurou"
msgid "「？　じゃあ勝手に住んでるのか、この家に？」"
msgstr "\"You mean... it just decided to live here of its own free will?\""

#. Occurrence 7_7:1995:9823: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0010; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:1995
msgctxt "text_id=9823 | speaker=alice"
msgid "「勝手になんて、わたしが許す筈がないでしょう。"
msgstr "\"Of course not. I would never allow such a thing."

#. Occurrence 7_7:2001:9824: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0011; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2001
msgctxt "text_id=9824 | speaker=alice"
msgid "　……ロビンは本当に役に立たないけど、あんなのでも母から譲り受けたものだから。失敗続きでも、特別に住まわせてあげてるの」"
msgstr "  Robin's useless, but I inherited it from my mother. As such, I permit it to continue living here, despite its constant failures and shortcomings.\""

#. Occurrence 7_7:2038:9825: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0018; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2038
msgctxt "text_id=9825 | speaker=soujuurou"
msgid "「そっか、安心した。ここに住むの、役に立たなきゃダメってワケでもないんだね」"
msgstr "\"I see. That's a relief. Here I was thinking I'm the only useless one in the house.\""

#. Occurrence 7_7:2058:9826: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0012; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2058
msgctxt "text_id=9826 | speaker=alice"
msgid "「っ―――」"
msgstr "\"...\""

#. Occurrence 7_7:2092:9827: scene=7_7
#: 7_7:2092
msgctxt "text_id=9827 | speaker=unknown"
msgid "　無防備な笑顔を向けられて、少女は顔を<逸|そ>らして黙りこんでしまった。"
msgstr "  She turned away in silence to avoid looking at his hapless grin."

#. Occurrence 7_7:2097:9828: scene=7_7
#: 7_7:2097
msgctxt "text_id=9828 | speaker=unknown"
msgid "　あとの時間は、草十郎が喋るだけの一方通行だ。"
msgstr "  Thus began Soujyuro's very lengthy monologue."

#. Occurrence 7_7:2102:9829: scene=7_7
#: 7_7:2102
msgctxt "text_id=9829 | speaker=unknown"
msgid "　日々のアルバイトのこと。学校のこと。遊園地でのこと。町のこと。家賃のこと。"
msgstr "  It started with his part-time job, then moved on to the school. Next came the amusement park and random gossip around town, and last the subject of rent."

#. Occurrence 7_7:2107:9830: scene=7_7
#: 7_7:2107
msgctxt "text_id=9830 | speaker=unknown"
msgid "　そんな益体のない話をすること二十分。"
msgstr "  He spent all of twenty minutes on mindless small talk."

#. Occurrence 7_7:2112:9831: scene=7_7
#: 7_7:2112
msgctxt "text_id=9831 | speaker=unknown"
msgid "　さすがにこれ以上は延ばせない、と少年は会話を切った。"
msgstr "  Then he ran out of things to say and finally stopped."

#. Occurrence 7_7:2144:9832: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0019; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2144
msgctxt "text_id=9832 | speaker=soujuurou"
msgid "「ごめん。アルバイトがあるから、もう行くよ」"
msgstr "\"Sorry. I'm on the clock soon, so I should get going.\""

#. Occurrence 7_7:2162:9833: scene=7_7
#: 7_7:2162
msgctxt "text_id=9833 | speaker=unknown"
msgid "　……この通り。"
msgstr "  And that was that."

#. Occurrence 7_7:2167:9834: scene=7_7
#: 7_7:2167
msgctxt "text_id=9834 | speaker=unknown"
msgid "　せっかくの機会をあっさり諦めるあたり、本当に何も考えていなかったらしい。"
msgstr "  After finally getting his long-awaited chance to talk to her, he realized he had no exit plan in place."

#. Occurrence 7_7:2200:9835: scene=7_7
#: 7_7:2200
msgctxt "text_id=9835 | speaker=unknown"
msgid "　草十郎はトレイを厨房に戻し、鞄をロビーに置いて玄関に向かう。"
msgstr "  So he returned the tray to the kitchen, placed his bag in the foyer, and headed for the door."

#. Occurrence 7_7:2205:9836: scene=7_7
#: 7_7:2205
msgctxt "text_id=9836 | speaker=unknown"
msgid "　有珠は彼のそんな淡泊さを知らなかった。"
msgstr "  She had never seen the boy so candid."

#. Occurrence 7_7:2210:9837: scene=7_7
#: 7_7:2210
msgctxt "text_id=9837 | speaker=unknown"
msgid "　なので、意表をつかれて見届けそうになって、つい、"
msgstr "  Which was why, overcome with surprise, she found herself calling out to him."

#. Occurrence 7_7:2229:9838: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0013; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2229
msgctxt "text_id=9838 | speaker=alice"
msgid "「―――待って」"
msgstr "\"...Wait.\""

#. Occurrence 7_7:2235:9839: scene=7_7
#: 7_7:2235
msgctxt "text_id=9839 | speaker=unknown"
msgid "　必要もないのに、その背中を呼び止めていた。"
msgstr "  She had no reason to do so, and yet she called out anyway."

#. Occurrence 7_7:2268:9840: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0020; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2268
msgctxt "text_id=9840 | speaker=soujuurou"
msgid "「ん、なに？」"
msgstr "\"Hm? Yes?\""

#. Occurrence 7_7:2288:9841: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0014; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2288
msgctxt "text_id=9841 | speaker=alice"
msgid "「…………その。"
msgstr "\"...It's just..."

#. Occurrence 7_7:2300:9842: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0015; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2300
msgctxt "text_id=9842 | speaker=alice"
msgid "　今日は、ポットがあったけど」"
msgstr "  I saw the pot you used today.\""

#. Occurrence 7_7:2320:9843: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0021; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2320
msgctxt "text_id=9843 | speaker=soujuurou"
msgid "「あ、うん。昨日の反省点だったから。結局、使ったのは自分だけだけど」"
msgstr "\"Oh, right. I wasn't going to make the same mistake as yesterday. But I guess I'm the only one who drank any today, so...\""

#. Occurrence 7_7:2354:9844: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0016; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2354
msgctxt "text_id=9844 | speaker=alice"
msgid "「そう。……そのポットはコーヒーとの兼用だから、ハーブティーには合わないわ」"
msgstr "\"Well, that pot is normally used for coffee, so you shouldn't put tea leaves in it.\""

#. Occurrence 7_7:2360:9845: scene=7_7
#: 7_7:2360
msgctxt "text_id=9845 | speaker=unknown"
msgid "　む、と目を見張る草十郎。"
msgstr "  Soujyuro's eyes grew wide with shock."

#. Occurrence 7_7:2365:9846: scene=7_7
#: 7_7:2365
msgctxt "text_id=9846 | speaker=unknown"
msgid "　言われてみれば、紅茶のポットとカップは何種類もあった。どうも各紅茶には専用のティーセットが定められているらしい。"
msgstr "  Now he remembered that there had been all sorts of cups and teapots in the cupboard. Each one specially designed for a different type of tea!"

#. Occurrence 7_7:2386:9847: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0022; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2386
msgctxt "text_id=9847 | speaker=soujuurou"
msgid "「……なかなかに奥深い。"
msgstr "\"Who knew there was so much to brewing tea?"

#. Occurrence 7_7:2392:9848: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0023; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2392
msgctxt "text_id=9848 | speaker=soujuurou"
msgid "　あれかな、慣れない事はするもんじゃないってコトか」"
msgstr "  I guess a beginner like me shouldn't mess with things he doesn't understand, huh?\""

#. Occurrence 7_7:2397:9849: scene=7_7
#: 7_7:2397
msgctxt "text_id=9849 | speaker=unknown"
msgid "　やれやれと嘆息する。"
msgstr "  She let out a vexed sigh."

#. Occurrence 7_7:2416:9850: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0017; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2416
msgctxt "text_id=9850 | speaker=alice"
msgid "「……どうして、わたしを起こさなかったの？」"
msgstr "\"Why didn't you wake me?\""

#. Occurrence 7_7:2421:9851: scene=7_7
#: 7_7:2421
msgctxt "text_id=9851 | speaker=unknown"
msgid "　草十郎の言葉なんて聞いていないのか、それとも、それが本当に訊ねたかった事なのか。"
msgstr "  Either she had not heard what he said, or she had been waiting this whole time for a chance to ask him that."

#. Occurrence 7_7:2426:9852: scene=7_7
#: 7_7:2426
msgctxt "text_id=9852 | speaker=unknown"
msgid "　有珠は彼の言葉を<遮|さえぎ>って問いただした。"
msgstr "  In any case, her question abruptly interrupted his stream of thought."

#. Occurrence 7_7:2465:9853: scene=7_7
#: 7_7:2465
msgctxt "text_id=9853 | speaker=unknown"
msgid "　草十郎はむ、と自問するように黙りこむ。"
msgstr "  He fell silent with introspection."

#. Occurrence 7_7:2470:9854: scene=7_7
#: 7_7:2470
msgctxt "text_id=9854 | speaker=unknown"
msgid "　言われて見れば、昨日も今日も“有珠を起こす”という発想に、まったく思い至らなかったからだ。"
msgstr "  The thought of waking her had not so much as crossed his mind either that day or the previous one."

#. Occurrence 7_7:2502:9855: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0018; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2502
msgctxt "text_id=9855 | speaker=alice"
msgid "「……言って。"
msgstr "\"...Tell me."

#. Occurrence 7_7:2509:9856: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0019; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2509
msgctxt "text_id=9856 | speaker=alice"
msgid "起こす気も、起きることも期待していなかったのは、なぜ？」"
msgstr "You didn't wake me. Did you expect me to just keep sleeping?\""

#. Occurrence 7_7:2515:9857: scene=7_7
#: 7_7:2515
msgctxt "text_id=9857 | speaker=unknown"
msgid "　その視線には殺意すら含まれている。"
msgstr "  Her eyes were filled with animosity."

#. Occurrence 7_7:2520:9858: scene=7_7
#: 7_7:2520
msgctxt "text_id=9858 | speaker=unknown"
msgid "　深い瞳にはどんな嘘も通用しない。"
msgstr "  Lies were useless against such an all-piercing gaze."

#. Occurrence 7_7:2525:9859: scene=7_7
#: 7_7:2525
msgctxt "text_id=9859 | speaker=unknown"
msgid "　夕暮れのロビーは一転して、生死を分かつ法廷になっていた。"
msgstr "  The setting sun transformed the foyer into a battle of life and death."

#. Occurrence 7_7:2557:9860: scene=7_7
#: 7_7:2557
msgctxt "text_id=9860 | speaker=unknown"
msgid "　嘘も、つまらない答えも許さない。"
msgstr "  Lies or deceptive answers would not be permitted."

#. Occurrence 7_7:2562:9861: scene=7_7
#: 7_7:2562
msgctxt "text_id=9861 | speaker=unknown"
msgid "　何を口にしようと心臓を貫かれそうな雰囲気の中、草十郎が抱いた感情は恐れより痛みだった。"
msgstr "  Amidst the palpable tension that filled the room, where any move, wrong or otherwise, was likely to get him killed, he felt pain rather than fear."

#. Occurrence 7_7:2567:9862: scene=7_7
#: 7_7:2567
msgctxt "text_id=9862 | speaker=unknown"
msgid "　久遠寺有珠の声は冷たく、また、回答を拒絶している。"
msgstr "  Alice's voice was icy cold, preemptively rejecting any response he was to give."

#. Occurrence 7_7:2572:9863: scene=7_7
#: 7_7:2572
msgctxt "text_id=9863 | speaker=unknown"
msgid "　少年は漠然と、地面に落ちながら<独|ひと>り立ちしたひな鳥を連想した。"
msgstr "  The boy vaguely imagined a newborn chick that had fallen from the nest, struggling to survive on its own."

#. Occurrence 7_7:2578:9864: scene=7_7
#: 7_7:2578
msgctxt "text_id=9864 | speaker=unknown"
msgid "　一縷の希望を待ちながら、その希望の<在処|ありか>を憎む、取り残されたモノの喘ぎ。"
msgstr "  It gasped, hanging on to a thread of hope, yet detesting where that thread hung."

#. Occurrence 7_7:2611:9865: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0024; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2611
msgctxt "text_id=9865 | speaker=soujuurou"
msgid "「言わなきゃいけないか？」"
msgstr "\"Do you really want to know?\""

#. Occurrence 7_7:2616:9866: scene=7_7
#: 7_7:2616
msgctxt "text_id=9866 | speaker=unknown"
msgid "　有珠はこくりと頷く。"
msgstr "  Alice nodded sharply."

#. Occurrence 7_7:2629:9867: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0025; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2629
msgctxt "text_id=9867 | speaker=soujuurou"
msgid "「じゃあ言うけど、別に深い考えがあったワケじゃない。"
msgstr "\"Fine, but it's not especially meaningful or anything."

#. Occurrence 7_7:2629:9868: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0025; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2629
msgctxt "text_id=9868 | speaker=soujuurou"
msgid "　単に、寝た子を起こすのはよくないだろ」"
msgstr "  I just think it's rude to wake someone who's asleep.\""

#. Occurrence 7_7:2635:9869: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0020; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2635
msgctxt "text_id=9869 | speaker=alice"
msgid "「……冗談は聞いてないわ」"
msgstr "\"...I have no time for jokes.\""

#. Occurrence 7_7:2641:9870: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0026; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2641
msgctxt "text_id=9870 | speaker=soujuurou"
msgid "「冗談じゃないよ。眠っているのならそのままでいいと思ったんだ。話はしたいけど、それはまた、目が覚めた次の機会にするべきだって」"
msgstr "\"That is the truth. I just thought I should let you sleep. I really wanted to talk, but I decided to wait till the next time we saw each other.\""

#. Occurrence 7_7:2677:9871: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0021; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2677
msgctxt "text_id=9871 | speaker=alice"
msgid "「……ずいぶんと悠長なのね。青子が貴方を守るのは今日までだって聞いているけど。"
msgstr "\"How sweet of you. That reminds me, Aoko's protection over you ends today, doesn't it?"

#. Occurrence 7_7:2683:9872: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0022; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2683
msgctxt "text_id=9872 | speaker=alice"
msgid "　わたしに取り入る機会はこれが最後なのに。"
msgstr "  That makes this your last chance to win me over."

#. Occurrence 7_7:2689:9873: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0023; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2689
msgctxt "text_id=9873 | speaker=alice"
msgid "　それとも―――あれだけ忠告されておいて、まだ何も分かっていないの？」"
msgstr "  So, have you, or have you not, learned your lesson, hmm?\""

#. Occurrence 7_7:2710:9874: scene=7_7
#: 7_7:2710
msgctxt "text_id=9874 | speaker=unknown"
msgid "　何も分かっていない。"
msgstr "  He had not."

#. Occurrence 7_7:2715:9875: scene=7_7
#: 7_7:2715
msgctxt "text_id=9875 | speaker=unknown"
msgid "　約束はした、事情も分かった、同じ人間として話し合えた。だから―――もう殺される事はないはずだ、と。"
msgstr "  He swore to her, agreed to her terms, and gone as far as to sit face to face with her to get to know her. Surely, he thought, this was enough to escape death."

#. Occurrence 7_7:2720:9876: scene=7_7
#: 7_7:2720
msgctxt "text_id=9876 | speaker=unknown"
msgid "　そんな良識、常識からの判断なら、少女はこの場で魔女としての鉄槌を振り下ろす。"
msgstr "  And she believed, as a mage, that his naive goodwill and simplemindedness were all the reasons she needed to execute him."

#. Occurrence 7_7:2725:9877: scene=7_7
#: 7_7:2725
msgctxt "text_id=9877 | speaker=unknown"
msgid "　くだらない勘違いは、どちらにとっても害にしかならないからだ。"
msgstr "  Trivial misunderstandings would only make things worse at this point."

#. Occurrence 7_7:2759:9878: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0027; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2759
msgctxt "text_id=9878 | speaker=soujuurou"
msgid "「そりゃ何も分からないよ。魔術とか魔法とか、たった数日で分かるもんか。"
msgstr "\"What lesson? What am I supposed to have learned? All this magic and magecraft stuff is way over my head."

#. Occurrence 7_7:2765:9879: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0028; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2765
msgctxt "text_id=9879 | speaker=soujuurou"
msgid "　はっきりしているのは、有珠も蒼崎も言った事はきっちり守るってコトだけだ」"
msgstr "  All I know is I've done everything you and Aozaki have asked of me.\""

#. Occurrence 7_7:2785:9880: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0024; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:2785
msgctxt "text_id=9880 | speaker=alice"
msgid "「なら、どうして」"
msgstr "\"Then why...?\""

#. Occurrence 7_7:2790:9881: scene=7_7
#: 7_7:2790
msgctxt "text_id=9881 | speaker=unknown"
msgid "　眠っている自分を起こして、命を<乞|こ>わなかったのかと視線で問う。"
msgstr "  Her gaze said what she really wanted to ask. She wanted to know why he did not beg for his life."

#. Occurrence 7_7:2824:9882: scene=7_7
#: 7_7:2824
msgctxt "text_id=9882 | speaker=unknown"
msgid "　有珠は知っている。"
msgstr "  She knew the answer."

#. Occurrence 7_7:2842:9883: scene=7_7
#: 7_7:2842
msgctxt "text_id=9883 | speaker=unknown"
msgid "　この少年が自分を起こさず立ち去ろうとした時に見せた表情を。"
msgstr "  She saw the look on his face when he turned to leave without so much as trying to wake her."

#. Occurrence 7_7:2877:9884: scene=7_7
#: 7_7:2877
msgctxt "text_id=9884 | speaker=unknown"
msgid "“そういう事なら仕方がない―――”"
msgstr "  A look of resignation."

#. Occurrence 7_7:2882:9885: scene=7_7
#: 7_7:2882
msgctxt "text_id=9885 | speaker=unknown"
msgid "　あの顔は、一体どういう意味だったのか。"
msgstr "  What on earth had it meant?"

#. Occurrence 7_7:2917:9886: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0029; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2917
msgctxt "text_id=9886 | speaker=soujuurou"
msgid "「どうしてって、そう言われても困る。"
msgstr "\"What do you expect me to say?"

#. Occurrence 7_7:2933:9887: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0030; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2933
msgctxt "text_id=9887 | speaker=soujuurou"
msgid "　……そうだな。機会が訪れなかったのなら、それはそういう事だと思ったのかもしれない。"
msgstr "  I thought if the opportunity didn't present itself, then so be it."

#. Occurrence 7_7:2945:9888: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0031; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:2945
msgctxt "text_id=9888 | speaker=soujuurou"
msgid "　君の寝顔はそれぐらい、なんていうか判断に困った。蒼崎とは違う意味で、簡単には関われないと思ったんだ」"
msgstr "  When I saw you sleeping again I didn't know what to do. You're not exactly the easiest people to approach, you and Aozaki, though Aozaki is a little different...\""

#. Occurrence 7_7:2965:9889: scene=7_7
#: 7_7:2965
msgctxt "text_id=9889 | speaker=unknown"
msgid "　うまく言葉にできないながらも、草十郎はあの時の気持ちを口にする。"
msgstr "  Soujyuro struggled to find the right words, but said what he was feeling in the moment anyway."

#. Occurrence 7_7:2984:9890: scene=7_7
#: 7_7:2984
msgctxt "text_id=9890 | speaker=unknown"
msgid "　誰かを必要としているクセに誰も望んでいない、眠りの森の少女の姿を。"
msgstr "  He'd seen a sleeping witch of the wood who clearly needed someone's help yet sought the help of no one."

#. Occurrence 7_7:3005:9891: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0025; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:3005
msgctxt "text_id=9891 | speaker=alice"
msgid "「……そう。でも、静希君は関わろうとしているのね。"
msgstr "\"But here you are trying to approach me anyway."

#. Occurrence 7_7:3011:9892: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0026; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:3011
msgctxt "text_id=9892 | speaker=alice"
msgid "　その機会は、訪れなかったのに」"
msgstr "  Even though the opportunity never presented itself.\""

#. Occurrence 7_7:3044:9893: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0032; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3044
msgctxt "text_id=9893 | speaker=soujuurou"
msgid "「機会はやってきたよ。なんで、こっちも今日ぐらいは自分の勝手にして、無茶をしたくなったんだ」"
msgstr "\"Oh, but it did. That's why I decided to do things my way today, even if nothing could go right to begin with.\""

#. Occurrence 7_7:3061:9894: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0027; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:3061
msgctxt "text_id=9894 | speaker=alice"
msgid "「静希君の言う通りなら、わたしは貴方を拒絶するしかないのに？」"
msgstr "\"You talk as though you always expected me to reject you.\""

#. Occurrence 7_7:3082:9895: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0033; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3082
msgctxt "text_id=9895 | speaker=soujuurou"
msgid "「まあ、そこが難しいところなんだけど」"
msgstr "\"Err, yeah, I guess it's hard to explain.\""

#. Occurrence 7_7:3099:9896: scene=7_7
#: 7_7:3099
msgctxt "text_id=9896 | speaker=unknown"
msgid "　草十郎はちらりと玄関に視線を向ける。"
msgstr "  Soujyuro glanced at the entrance."

#. Occurrence 7_7:3104:9897: scene=7_7
#: 7_7:3104
msgctxt "text_id=9897 | speaker=unknown"
msgid "　今は何の意味もない行為だが、そうせずにはいられなかったのだ。"
msgstr "  He had no reason to-he just felt an urge to do so."

#. Occurrence 7_7:3111:9898: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0034; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3111
msgctxt "text_id=9898 | speaker=soujuurou"
msgid "「たぶん、そこを解決したがってるのは俺だけじゃないと思うよ」"
msgstr "\"I doubt I'm the only one who'd like to see this situation solved.\""

#. Occurrence 7_7:3144:9899: scene=7_7
#: 7_7:3144
msgctxt "text_id=9899 | speaker=unknown"
msgid "　自問めいた答えは少女に対して向けられたものでもある。"
msgstr "  He muttered as if speaking to himself, but it was clearly meant for her to hear."

#. Occurrence 7_7:3149:9900: scene=7_7
#: 7_7:3149
msgctxt "text_id=9900 | speaker=unknown"
msgid "　それが大きな間違いだという事を、有珠は分かっている。"
msgstr "  Alice knew full well how poorly he had understood the situation."

#. Occurrence 7_7:3154:9901: scene=7_7
#: 7_7:3154
msgctxt "text_id=9901 | speaker=unknown"
msgid "　全て彼の勘違い。"
msgstr "  All of this was one giant misunderstanding on his part."

#. Occurrence 7_7:3159:9902: scene=7_7
#: 7_7:3159
msgctxt "text_id=9902 | speaker=unknown"
msgid "　死に瀕した子猫に手を伸ばそうとする程度の、清らかで浅ましい、小さな善性。"
msgstr "  His tiny gesture of goodwill, pitiful and pure, resembled that of someone reaching out to help a dying kitten."

#. Occurrence 7_7:3164:9903: scene=7_7
#: 7_7:3164
msgctxt "text_id=9903 | speaker=unknown"
msgid "　それが、有珠には<茨|いばら>のようにいとわしかった。"
msgstr "  For Alice, doing so would be akin to clutching the thorns of a rose."

#. Occurrence 7_7:3170:9904: scene=7_7
#: 7_7:3170
msgctxt "text_id=9904 | speaker=unknown"
msgid "　……久しぶりに、胸に痛いと感じたのだ。"
msgstr "  She felt pain in her chest for the first time in quite a while."

#. Occurrence 7_7:3205:9905: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0028; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:3205
msgctxt "text_id=9905 | speaker=alice"
msgid "「……けど、わたしは貴方の同居を認めてはいないわ」"
msgstr "\"I still don't want you in the mansion.\""

#. Occurrence 7_7:3223:9906: scene=7_7
#: 7_7:3223
msgctxt "text_id=9906 | speaker=unknown"
msgid "　そんな心を隠すように、うつむき加減に有珠は言った。"
msgstr "  She addressed the floor at her feet to avoid showing him how she truly felt."

#. Occurrence 7_7:3228:9907: scene=7_7
#: 7_7:3228
msgctxt "text_id=9907 | speaker=unknown"
msgid "　立っている草十郎からでは、今の有珠が、あの時の青子と同じ顔をしている事には気づけない。"
msgstr "  If he had, he would have seen that her face looked just the way Aoko's had earlier."

#. Occurrence 7_7:3262:9908: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0035; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3262
msgctxt "text_id=9908 | speaker=soujuurou"
msgid "「だろうな。それはきっと、今は解決できない問題だ。"
msgstr "\"I'm sure you don't. And I doubt that'll change anytime soon."

#. Occurrence 7_7:3268:9909: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0036; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3268
msgctxt "text_id=9909 | speaker=soujuurou"
msgid "　でもそのうち、何かの気まぐれであっさり終わるものかもしれない。だからその時まで、有珠はずっと、俺を嫌っていていいんだと思う」"
msgstr "  But that doesn't mean we can't work something out. It's okay if you keep hating me in the meantime.\""

#. Occurrence 7_7:3289:9910: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0029; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:3289
msgctxt "text_id=9910 | speaker=alice"
msgid "「―――――――――」"
msgstr "\"...\""

#. Occurrence 7_7:3295:9911: scene=7_7
#: 7_7:3295
msgctxt "text_id=9911 | speaker=unknown"
msgid "　息を飲む気配は、それこそ声のように。"
msgstr "  Her gasp of breath was like a response in itself."

#. Occurrence 7_7:3300:9912: scene=7_7
#: 7_7:3300
msgctxt "text_id=9912 | speaker=unknown"
msgid "　その時まで、嫌ってもいいと。"
msgstr "  To suggest she could keep hating him..."

#. Occurrence 7_7:3305:9913: scene=7_7
#: 7_7:3305
msgctxt "text_id=9913 | speaker=unknown"
msgid "　そんな言葉を、少女は今まで、いや、一度だけ、強く願った事があって―――"
msgstr "  She had once wished to hear those words so dearly, if only the once."

#. Occurrence 7_7:3332:9914: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0037; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3332
msgctxt "text_id=9914 | speaker=soujuurou"
msgid "「だいたいだぞ。有珠だけじゃなく、蒼崎も同居を認めてない節があるじゃないか。"
msgstr "\"I mean, you're not the only one. That goes for Aozaki, too. I don't think she wants me here, either."

#. Occurrence 7_7:3338:9915: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0038; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3338
msgctxt "text_id=9915 | speaker=soujuurou"
msgid "　だから、認めてもらう、なんて意気ごみ自体が間違いなんだ。どうあっても俺は蒼崎や君たちとは違うんだし。"
msgstr "  Expecting to feel welcomed would be a big mistake on my part. We're fundamentally different people, and that's never going to change."

#. Occurrence 7_7:3344:9916: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0039; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3344
msgctxt "text_id=9916 | speaker=soujuurou"
msgid "　となると、あとは我慢してもらうしかない。"
msgstr "  I just want you to tolerate me."

#. Occurrence 7_7:3351:9917: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0040; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3351
msgctxt "text_id=9917 | speaker=soujuurou"
msgid "難しい話だけど、一緒にいても邪魔にならないぐらいなら、その可能性はあがらないか？」"
msgstr "I know it's a lot to ask, but is there a way I could live here without bothering you too much?\""

#. Occurrence 7_7:3383:9918: scene=7_7
#: 7_7:3383
msgctxt "text_id=9918 | speaker=unknown"
msgid "　たしかにその通りなのだけど、それが出来るのなら苦労はしない―――と、そこまで思って、有珠はなるほど、と頷いてしまった。"
msgstr "  Thinking that of course it was possible, but if it were that easy none of this would have been necessary in the first place, Alice nodded in agreement."

#. Occurrence 7_7:3388:9919: scene=7_7
#: 7_7:3388
msgctxt "text_id=9919 | speaker=unknown"
msgid "　彼が企んだ訳ではないのだろうが。"
msgstr "  There was no way he could have planned for things to work out this well."

#. Occurrence 7_7:3393:9920: scene=7_7
#: 7_7:3393
msgctxt "text_id=9920 | speaker=unknown"
msgid "　こうして会話が成立している時点で、自分は術中に<嵌|はま>ってしまったのだ。"
msgstr "  But his plan in fact had worked, if inadvertently, from the moment the conversation began."

#. Occurrence 7_7:3426:9921: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_7_0030; voice_prefix=A40; voice_category=2; scene=7_7
#: 7_7:3426
msgctxt "text_id=9921 | speaker=alice"
msgid "「例えば、貴方が<隣|となり>にいても眠っていられるぐらいに？」"
msgstr "\"You mean, so that I can sleep undisturbed even with you sitting right next to me?\""

#. Occurrence 7_7:3444:9922: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0041; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3444
msgctxt "text_id=9922 | speaker=soujuurou"
msgid "「そうだね、例えばの話」"
msgstr "\"Sure, why not.\""

#. Occurrence 7_7:3461:9923: scene=7_7
#: 7_7:3461
msgctxt "text_id=9923 | speaker=unknown"
msgid "　笑顔で返して草十郎はロビーを後にする。"
msgstr "  Beaming, Soujyuro stood up and left the foyer."

#. Occurrence 7_7:3466:9924: scene=7_7
#: 7_7:3466
msgctxt "text_id=9924 | speaker=unknown"
msgid "　その後ろ姿を有珠はもう止めなかった。"
msgstr "  Alice did not stop him this time."

#. Occurrence 7_7:3518:9925: scene=7_7
#: 7_7:3518
msgctxt "text_id=9925 | speaker=unknown"
msgid "　玄関から外に出た少年は、心機一転してアルバイト先に足を向ける。"
msgstr "  He had a newfound spring in his step as he headed to work."

#. Occurrence 7_7:3523:9926: scene=7_7
#: 7_7:3523
msgctxt "text_id=9926 | speaker=unknown"
msgid "　ただ、その前に。"
msgstr "  But something gave him a moment's pause."

#. Occurrence 7_7:3530:9927: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_7_0042; voice_prefix=A30; voice_category=3; scene=7_7
#: 7_7:3530
msgctxt "text_id=9927 | speaker=soujuurou"
msgid "「じっさい、覗き見は趣味が悪いと思う」"
msgstr "\"It's not nice to spy on people.\""

#. Occurrence 7_7:3536:9928: scene=7_7
#: 7_7:3536
msgctxt "text_id=9928 | speaker=unknown"
msgid "　誰かに告げるように、そんな文句を呟いた。"
msgstr "  He complained aloud to make sure a certain someone heard him."

#. Occurrence 7_8:49:9929: scene=7_8
#: 7_8:49
msgctxt "text_id=9929 | speaker=unknown"
msgid "　草十郎が洋館を後にしてから二分ほど経った後、足音を忍ばせて、長い髪の人影がロビーに入ってきた。"
msgstr "  No more than two minutes had passed since Soujyuro left the mansion when a long-haired figure came creeping into the foyer."

#. Occurrence 7_8:54:9930: scene=7_8
#: 7_8:54
msgctxt "text_id=9930 | speaker=unknown"
msgid "　今まで外から様子を<窺|うかが>っていた、蒼崎青子その人である。"
msgstr "  Aoko Aozaki had been just outside the entire time, eavesdropping."

#. Occurrence 7_8:86:9931: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0000; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:86
msgctxt "text_id=9931 | speaker=alice"
msgid "「……帰ってたの？」"
msgstr "\"...When did you get home?\""

#. Occurrence 7_8:104:9932: scene=7_8
#: 7_8:104
msgctxt "text_id=9932 | speaker=unknown"
msgid "　むっとした目付きで、有珠は青子に語りかけた。"
msgstr "  With a sullen glare, Alice addressed the interloper."

#. Occurrence 7_8:109:9933: scene=7_8
#: 7_8:109
msgctxt "text_id=9933 | speaker=unknown"
msgid "　どれほど外に居たのか、青子の体は寒さで震えている。"
msgstr "  Aoko was shivering from head to toe after standing in the cold for so long."

#. Occurrence 7_8:114:9934: scene=7_8
#: 7_8:114
msgctxt "text_id=9934 | speaker=unknown"
msgid "　手袋は悪、と公言している青子は、よほどの寒さでなければ手袋はつけない。それが災いして、長い指が哀れなほど赤くなっていた。"
msgstr "  She deemed gloves an abomination and refused to wear them except in the most extreme cold. As a result, her slender fingers were pitifully swollen and red."

#. Occurrence 7_8:150:9935: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0000; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:150
msgctxt "text_id=9935 | speaker=aoko"
msgid "「ちょっと前にね。それでどうだったの有珠？　ずいぶんと話してたみたいだけど」"
msgstr "\"Don't know, a while ago. Anyway, how did it go? You two were talking for so long...\""

#. Occurrence 7_8:156:9936: scene=7_8
#: 7_8:156
msgctxt "text_id=9936 | speaker=unknown"
msgid "　吐息で両手を温めながら、青子はどこか楽しそうに問いただす。"
msgstr "  She looked strangely elated, as she blew on her hands to warm them."

#. Occurrence 7_8:192:9937: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0001; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:192
msgctxt "text_id=9937 | speaker=alice"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 7_8:197:9938: scene=7_8
#: 7_8:197
msgctxt "text_id=9938 | speaker=unknown"
msgid "　その意地の悪い顔で、有珠は事の<絡繰|からくり>を読み取った。"
msgstr "  Alice was not fooled at all by Aoko's facade, clear from the ill-tempered look she wore on her face."

#. Occurrence 7_8:224:9939: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0002; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:224
msgctxt "text_id=9939 | speaker=alice"
msgid "「……貴女がここまで過保護とは思わなかったわ。"
msgstr "\"...I never expected you to be so overprotective."

#. Occurrence 7_8:230:9940: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0003; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:230
msgctxt "text_id=9940 | speaker=alice"
msgid "　意地？　それとも義務？」"
msgstr "  But did you do it out of stubbornness, or obligation?\""

#. Occurrence 7_8:249:9941: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0001; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:249
msgctxt "text_id=9941 | speaker=aoko"
msgid "「どっちかっていうと成り行きね。"
msgstr "\"Oh, please, I was just going with the flow."

#. Occurrence 7_8:255:9942: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0002; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:255
msgctxt "text_id=9942 | speaker=aoko"
msgid "　で、どうだったのよ結果は。気にくわなかったら実力行使に出るって言ってたじゃない」"
msgstr "  But seriously, how did it go? You told me you'd resort to force if he made you mad.\""

#. Occurrence 7_8:300:9943: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0004; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:300
msgctxt "text_id=9943 | speaker=alice"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 7_8:305:9944: scene=7_8
#: 7_8:305
msgctxt "text_id=9944 | speaker=unknown"
msgid "　上機嫌な青子を前に、有珠はますます面持ちを暗くしていく。"
msgstr "  Alice's mood was growing darker and darker the longer she had to look at Aoko's cheerful posturing."

#. Occurrence 7_8:338:9945: scene=7_8
#: 7_8:338
msgctxt "text_id=9945 | speaker=unknown"
msgid "　話は昨日の夕食までさかのぼる。"
msgstr "  It all went back to their dinner together the previous night."

#. Occurrence 7_8:343:9946: scene=7_8
#: 7_8:343
msgctxt "text_id=9946 | speaker=unknown"
msgid "　ロビーでの一件で草十郎への不信感、および関心がメーターを振り切ったのか、有珠は“明日も彼をひとりで帰して”と青子に強要した。"
msgstr "  After everything that happened in the foyer, Alice was both more suspicious of and intrigued by Soujyuro than ever before. She insisted that Aoko let him walk home alone the next day."

#. Occurrence 7_8:363:9947: scene=7_8
#: 7_8:363
msgctxt "text_id=9947 | speaker=unknown"
msgid "　今日の眠りは薬による擬似的なもので、意図的に昨日の状況を再現したものである。"
msgstr "  She then used a concoction to fake her slumber and recreate the same scene as the previous day."

#. Occurrence 7_8:368:9948: scene=7_8
#: 7_8:368
msgctxt "text_id=9948 | speaker=unknown"
msgid "　状況はうまくいったが結果は彼女の予想から外れ、また、お節介な同居人が壁越しに手に汗握っていた、というのも面白くない。"
msgstr "  That portion of her plan went well, but the rest had veered totally off course. It did not help to know her roommate had savored every moment of it from the other side of the wall, either."

#. Occurrence 7_8:373:9949: scene=7_8
#: 7_8:373
msgctxt "text_id=9949 | speaker=unknown"
msgid "　さらに付け足すのなら、そんなどうでもいい事に腹を立てている自分にも呆れてしまう有珠だった。"
msgstr "  To make matters worse, Alice was frustrated at herself for letting such trivial matters bother her."

#. Occurrence 7_8:403:9950: scene=7_8
#: 7_8:403
msgctxt "text_id=9950 | speaker=unknown"
msgid "　床に置かれたティーカップを見つめる有珠。"
msgstr "  She stared at the teacup still sitting on the floor."

#. Occurrence 7_8:408:9951: scene=7_8
#: 7_8:408
msgctxt "text_id=9951 | speaker=unknown"
msgid "　その白い指が冷えたカップの<縁|ふち>をなぞっていく。"
msgstr "  Her pale finger traced its cold rim."

#. Occurrence 7_8:425:9952: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0005; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:425
msgctxt "text_id=9952 | speaker=alice"
msgid "「……青子の言う通り、害にはならない人ね。"
msgstr "\"It's as you said. He is harmless."

#. Occurrence 7_8:431:9953: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0006; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:431
msgctxt "text_id=9953 | speaker=alice"
msgid "　あくまで、今のところの話だけど」"
msgstr "  ...For the time being.\""

#. Occurrence 7_8:436:9954: scene=7_8
#: 7_8:436
msgctxt "text_id=9954 | speaker=unknown"
msgid "　青子に内心の苛立ちを見せないよう、有珠は冷淡な感想を述べた。"
msgstr "  She forced a tone of indifference in order to hide her irritation with her apprentice."

#. Occurrence 7_8:441:9955: scene=7_8
#: 7_8:441
msgctxt "text_id=9955 | speaker=unknown"
msgid "　その時点で、もう結論は出ているようなものだが。"
msgstr "  It was in this moment that Soujyuro's fate was decided."

#. Occurrence 7_8:476:9956: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0003; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:476
msgctxt "text_id=9956 | speaker=aoko"
msgid "「あら、それだけ？　有珠にしては長く話してたのに」"
msgstr "\"That's it? You were talking for what seemed like forever.\""

#. Occurrence 7_8:481:9957: scene=7_8
#: 7_8:481
msgctxt "text_id=9957 | speaker=unknown"
msgid "　白状しろ、とばかりに青子はしつこく繰り返す。"
msgstr "  Relentless, Aoko continued her line of questioning."

#. Occurrence 7_8:486:9958: scene=7_8
#: 7_8:486
msgctxt "text_id=9958 | speaker=unknown"
msgid "　有珠はそんな同居人を冷徹に見据えると、"
msgstr "  Alice only stared back icily."

#. Occurrence 7_8:507:9959: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0007; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:507
msgctxt "text_id=9959 | speaker=alice"
msgid "「青子。貴女、隠していたわね」"
msgstr "\"Aoko, I know you were eavesdropping.\""

#. Occurrence 7_8:512:9960: scene=7_8
#: 7_8:512
msgctxt "text_id=9960 | speaker=unknown"
msgid "　敵意すらこめて、彼女の不義を糾弾した。"
msgstr "  She voiced her displeasure at Aoko's behavior in no uncertain terms."

#. Occurrence 7_8:549:9961: scene=7_8
#: 7_8:549
msgctxt "text_id=9961 | speaker=unknown"
msgid "　ロビーの空気が凍る。"
msgstr "  Suddenly the air in the foyer felt cold as ice."

#. Occurrence 7_8:554:9962: scene=7_8
#: 7_8:554
msgctxt "text_id=9962 | speaker=unknown"
msgid "　ふたりの少女は相手の出方を探るように見つめ合った。"
msgstr "  They stared at one another, each trying to guess the other's next move."

#. Occurrence 7_8:591:9963: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0004; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:591
msgctxt "text_id=9963 | speaker=aoko"
msgid "「…………流石ね。よくそこに気が付いたもんだわ。でも、こればかりは譲れないのよ」"
msgstr "\"...So you did notice. This... doesn't change anything about our deal. I hope that's clear.\""

#. Occurrence 7_8:597:9964: scene=7_8
#: 7_8:597
msgctxt "text_id=9964 | speaker=unknown"
msgid "　じり、と腰を落として有珠を睨む青子。"
msgstr "  Aoko widened her stance and glared at Alice."

#. Occurrence 7_8:631:9965: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0008; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:631
msgctxt "text_id=9965 | speaker=alice"
msgid "「なにも全て奪うとは言っていないわ。……そうね。貴女にも三割ぐらいは回すつもり」"
msgstr "\"I'm a reasonable person, Aoko. It's fine with me if you take thirty percent.\""

#. Occurrence 7_8:637:9966: scene=7_8
#: 7_8:637
msgctxt "text_id=9966 | speaker=unknown"
msgid "　戦闘態勢に入った青子に動じず、有珠は視線だけで青子を牽制する。"
msgstr "  Completely unperturbed by Aoko's warlike posturing, a simple look was all Alice needed to keep her roommate in check."

#. Occurrence 7_8:676:9967: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0005; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:676
msgctxt "text_id=9967 | speaker=aoko"
msgid "「ふん。十が三に化けちゃあ、ちょっと黙ってらんないわね」"
msgstr "\"Down from all of it? Hah! Not a chance.\""

#. Occurrence 7_8:697:9968: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0009; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:697
msgctxt "text_id=9968 | speaker=alice"
msgid "「高望みは命取りよ、青子」"
msgstr "\"Fly too high and you may lose those wings, Aoko.\""

#. Occurrence 7_8:703:9969: scene=7_8
#: 7_8:703
msgctxt "text_id=9969 | speaker=unknown"
msgid "　凛とした姿勢のままで有珠は動かない。"
msgstr "  Alice remained calm and dignified, not moving a muscle."

#. Occurrence 7_8:746:9970: scene=7_8
#: 7_8:746
msgctxt "text_id=9970 | speaker=unknown"
msgid "　そうして無言のまま、両者は長いこと見つめ合った。"
msgstr "  It felt like hours passed as the two stared at each other in silence."

#. Occurrence 7_8:751:9971: scene=7_8
#: 7_8:751
msgctxt "text_id=9971 | speaker=unknown"
msgid "　ぎり、と悔しげに歯を鳴らす青子。"
msgstr "  Aoko was grinding her teeth in frustration."

#. Occurrence 7_8:759:9972: scene=7_8
#: 7_8:759
msgctxt "text_id=9972 | speaker=unknown"
msgid "　このままでは外敵との対決を前にして、仲間割れという形で幕は下りかねない。"
msgstr "  At this rate, their alliance would be in tatters before they even confronted their foe."

#. Occurrence 7_8:791:9973: scene=7_8
#: 7_8:791
msgctxt "text_id=9973 | speaker=unknown"
msgid "　……加えて。"
msgstr "  And worst of all,"

#. Occurrence 7_8:796:9974: scene=7_8
#: 7_8:796
msgctxt "text_id=9974 | speaker=unknown"
msgid "　どう考えても、分が悪いのは自分だった。"
msgstr "  she knew Alice had the upper hand."

#. Occurrence 7_8:840:9975: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0006; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:840
msgctxt "text_id=9975 | speaker=aoko"
msgid "「…………けち」"
msgstr "\"...Cheapskate.\""

#. Occurrence 7_8:845:9976: scene=7_8
#: 7_8:845
msgctxt "text_id=9976 | speaker=unknown"
msgid "　青子はちっ、と舌打ちして敗北を認める。"
msgstr "  Aoko accepted her defeat with a \"tsk.\""

#. Occurrence 7_8:875:9977: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0007; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:875
msgctxt "text_id=9977 | speaker=aoko"
msgid "「悔しいけど有珠が六、私が四で手を打つわ」"
msgstr "\"Fine. You get sixty, I get forty.\""

#. Occurrence 7_8:881:9978: scene=7_8
#: 7_8:881
msgctxt "text_id=9978 | speaker=unknown"
msgid "　無念げに妥協する青子と、満足げにうなずく有珠。"
msgstr "  It pained her to settle for less. Alice nodded in satisfaction."

#. Occurrence 7_8:916:9979: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0010; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:916
msgctxt "text_id=9979 | speaker=alice"
msgid "「そうね。<家主|やぬし>はわたしだけど、彼を招いたのは青子だから。そのかわり、<家賃|やちん>の取り立ては貴女の役割ね」"
msgstr "\"Very well. But I'm the head of the house, and you're the one who brought him here, so it's your job to collect rent.\""

#. Occurrence 7_8:935:9980: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0008; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:935
msgctxt "text_id=9980 | speaker=aoko"
msgid "「……いいけど。あーあ、情けない。こんな事なら錬金術でもかじっておくんだった。そうすれば、こんな思いをしなくてもすんだのに」"
msgstr "\"Fine. Ugh, this sucks. I should've gone into alchemy instead, then all my problems would be solved.\""

#. Occurrence 7_8:941:9981: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0011; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:941
msgctxt "text_id=9981 | speaker=alice"
msgid "「そうでもないわ。彼ら、バブルが弾けて大変だって話よ」"
msgstr "\"Not really. Not even alchemists are immune to market downturns.\""

#. Occurrence 7_8:969:9982: scene=7_8
#: 7_8:969
msgctxt "text_id=9982 | speaker=unknown"
msgid "　妙に実感のこもった有珠の言葉に、青子ははいはいと空返事をする。"
msgstr "  Alice spoke with the confidence of someone with first-hand experience of such matters, yet Aoko only nodded absentmindedly in response."

#. Occurrence 7_8:974:9983: scene=7_8
#: 7_8:974
msgctxt "text_id=9983 | speaker=unknown"
msgid "　ふたりは草十郎を住まわせた後の、彼が支払う家賃の取り分を真剣に議論していたのだ。"
msgstr "  Their bitter fight was over how to split the take of Soujyuro's rent now that he was officially going to move in."

#. Occurrence 7_8:980:9984: scene=7_8
#: 7_8:980
msgctxt "text_id=9984 | speaker=unknown"
msgid "　魔術師にあるまじき口論である。"
msgstr "  Not the most becoming quarrel for a pair of mages."

#. Occurrence 7_8:985:9985: scene=7_8
#: 7_8:985
msgctxt "text_id=9985 | speaker=unknown"
msgid "　無理やり同居を強制しておいて家賃を取るあたり、詐欺を通り越してもはや暴力と言っていいレベル。"
msgstr "  Forcing a boy to live with them and then demanding he pay rent was beyond extortion-it was truly vicious."

#. Occurrence 7_8:1018:9986: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0009; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:1018
msgctxt "text_id=9986 | speaker=aoko"
msgid "「でも、そんな台詞が出るって事は有珠もようやく認めたってコトね」"
msgstr "\"Since we're even discussing this, I assume that means you've accepted his presence in the mansion?\""

#. Occurrence 7_8:1023:9987: scene=7_8
#: 7_8:1023
msgctxt "text_id=9987 | speaker=unknown"
msgid "　よしよし、と満足する青子。"
msgstr "  Aoko was triumphantly satisfied with herself."

#. Occurrence 7_8:1040:9988: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0012; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:1040
msgctxt "text_id=9988 | speaker=alice"
msgid "「……認めてはいないけど、公園での夜、彼を結界で捕捉しなかった責任があるから。"
msgstr "\"The only thing I've accepted is my responsibility for not catching him with the Bounded Field in the park that night."

#. Occurrence 7_8:1046:9989: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0013; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:1046
msgctxt "text_id=9989 | speaker=alice"
msgid "　彼と約束をした青子だけを責められないでしょう」"
msgstr "  I mean, it's not as if I can blame it all on you and your promise to him.\""

#. Occurrence 7_8:1081:9990: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0010; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:1081
msgctxt "text_id=9990 | speaker=aoko"
msgid "「……約束、か」"
msgstr "\"...Oh, *that* promise.\""

#. Occurrence 7_8:1087:9991: scene=7_8
#: 7_8:1087
msgctxt "text_id=9991 | speaker=unknown"
msgid "　遊園地の夜を思い出すように、青子は天井を見上げた。"
msgstr "  Aoko looked up at the ceiling as she recalled the night at the amusement park."

#. Occurrence 7_8:1092:9992: scene=7_8
#: 7_8:1092
msgctxt "text_id=9992 | speaker=unknown"
msgid "　たかだか一週間ほど前の出来事なのに、あれから随分と草十郎との縁が強くなった気がする。"
msgstr "  Only a week at most had passed since then, but Aoko already felt that Soujyuro's fate and her own had become intrinsically linked."

#. Occurrence 7_8:1097:9993: scene=7_8
#: 7_8:1097
msgctxt "text_id=9993 | speaker=unknown"
msgid "　それとも、初めて会ったあの時から縁は強いものだったのだろうか。"
msgstr "  Or perhaps they had always been connected by fate since the moment they'd met."

#. Occurrence 7_8:1102:9994: scene=7_8
#: 7_8:1102
msgctxt "text_id=9994 | speaker=unknown"
msgid "　未来視ではない青子には、とうてい預かり知らぬコトではあるが。"
msgstr "  She could not see into the future, so there was no way to know for sure."

#. Occurrence 7_8:1136:9995: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0011; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:1136
msgctxt "text_id=9995 | speaker=aoko"
msgid "「ま、縁とか運とかはともかく。"
msgstr "\"Destiny and fate aside,"

#. Occurrence 7_8:1142:9996: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0012; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:1142
msgctxt "text_id=9996 | speaker=aoko"
msgid "　変だけどいい奴よね、あいつ」"
msgstr "  he's not a bad egg. Besides being weird, I mean.\""

#. Occurrence 7_8:1148:9997: scene=7_8
#: 7_8:1148
msgctxt "text_id=9997 | speaker=unknown"
msgid "　有珠に同意を求めるワケでもなく呟く青子。"
msgstr "  A thought uttered to herself in self-confirmation more than to Alice."

#. Occurrence 7_8:1167:9998: scene=7_8
#: 7_8:1167
msgctxt "text_id=9998 | speaker=unknown"
msgid "　それを有珠は不機嫌そうに眺める。"
msgstr "  Alice could only look on in annoyance."

#. Occurrence 7_8:1172:9999: scene=7_8
#: 7_8:1172
msgctxt "text_id=9999 | speaker=unknown"
msgid "　なにか、今の台詞が気に入らなかったのかも知れない。"
msgstr "  Perhaps in an attempt to voice her displeasure at her comment."

#. Occurrence 7_8:1199:10000: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0014; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:1199
msgctxt "text_id=10000 | speaker=alice"
msgid "「青子、あの傷を知ってる？」"
msgstr "\"Do you know about his injury, Aoko?\""

#. Occurrence 7_8:1205:10001: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0013; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:1205
msgctxt "text_id=10001 | speaker=aoko"
msgid "「傷……？」"
msgstr "\"Injury? What injury?\""

#. Occurrence 7_8:1217:10002: scene=7_8
#: 7_8:1217
msgctxt "text_id=10002 | speaker=unknown"
msgid "　思わず口にでた声を、有珠は細い指で押し止めた。"
msgstr "  Alice raised her slender fingers to her mouth as if to push the words back in."

#. Occurrence 7_8:1222:10003: scene=7_8
#: 7_8:1222
msgctxt "text_id=10003 | speaker=unknown"
msgid "　感情的に出てしまった質問。"
msgstr "  She had blurted it out in the heat of the moment."

#. Occurrence 7_8:1227:10004: scene=7_8
#: 7_8:1227
msgctxt "text_id=10004 | speaker=unknown"
msgid "　人に話す事ではないと分かっていたのに訊かずには―――知らさずにはいられなかった、自分しか知らない秘密。"
msgstr "  A secret that no one else was supposed to know, but that which one couldn't keep to herself."

#. Occurrence 7_8:1261:10005: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0014; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:1261
msgctxt "text_id=10005 | speaker=aoko"
msgid "「？？」"
msgstr "\"?\""

#. Occurrence 7_8:1266:10006: scene=7_8
#: 7_8:1266
msgctxt "text_id=10006 | speaker=unknown"
msgid "　有珠の問いに首を傾げる青子。"
msgstr "  Aoko tilted her head in confusion."

#. Occurrence 7_8:1286:10007: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0015; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:1286
msgctxt "text_id=10007 | speaker=alice"
msgid "「―――そう」"
msgstr "\"...I see.\""

#. Occurrence 7_8:1291:10008: scene=7_8
#: 7_8:1291
msgctxt "text_id=10008 | speaker=unknown"
msgid "　なぜか胸を撫でおろす。"
msgstr "  Alice looked relieved for some reason."

#. Occurrence 7_8:1296:10009: scene=7_8
#: 7_8:1296
msgctxt "text_id=10009 | speaker=unknown"
msgid "　青子に感じた突発的な反感も、それで晴れてくれたようだ。"
msgstr "  Her sudden antipathy towards Aoko had dissipated as well."

#. Occurrence 7_8:1330:10010: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0016; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:1330
msgctxt "text_id=10010 | speaker=alice"
msgid "「―――<倖|しあわ>せな人」"
msgstr "\"Ignorance is bliss, I suppose.\""

#. Occurrence 7_8:1336:10011: scene=7_8
#: 7_8:1336
msgctxt "text_id=10011 | speaker=unknown"
msgid "　そうして。"
msgstr "  Said Alice, as she took a sip of her cold tea."

#. Occurrence 7_8:1341:10012: scene=7_8
#: 7_8:1341
msgctxt "text_id=10012 | speaker=unknown"
msgid "　誰がどう倖せなのか口にせず、有珠は冷めきった紅茶を口にした。"
msgstr "  She made no attempt to explain who was fortunate, or why."

#. Occurrence 7_8:1359:10013: scene=7_8
#: 7_8:1359
msgctxt "text_id=10013 | speaker=unknown"
msgid "　とたん、その可憐な顔が苦々しい<貌|かお>を作る。"
msgstr "  A moment later, her beautiful face contorted in revulsion."

#. Occurrence 7_8:1391:10014: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_8_0017; voice_prefix=A40; voice_category=2; scene=7_8
#: 7_8:1391
msgctxt "text_id=10014 | speaker=alice"
msgid "「……まずい」"
msgstr "\"...Yuck.\""

#. Occurrence 7_8:1402:10015: scene=7_8
#: 7_8:1402
msgctxt "text_id=10015 | speaker=unknown"
msgid "　無情にも床に放置されるカップ。"
msgstr "  She abandoned the cup to the floor once more."

#. Occurrence 7_8:1408:10016: scene=7_8
#: 7_8:1408
msgctxt "text_id=10016 | speaker=unknown"
msgid "　少女の黒衣がおごそかに揺れる。"
msgstr "  Her black dress unceremoniously scrunched up as she stood."

#. Occurrence 7_8:1413:10017: scene=7_8
#: 7_8:1413
msgctxt "text_id=10017 | speaker=unknown"
msgid "　未熟な紅茶を一口だけ飲んだ有珠は、口直しとばかりに居間へと歩いていってしまった。"
msgstr "  Just one sip of the under-brewed tea sent her fleeing to the drawing room to remove the bad taste from her mouth."

#. Occurrence 7_8:1445:10018: scene=7_8
#: 7_8:1445
msgctxt "text_id=10018 | speaker=unknown"
msgid "　それを見送った後、ためらいながらも青子は残されたティーカップを手に取った。"
msgstr "  As soon as she was gone Aoko hesitatingly took the teacup in her own hands."

#. Occurrence 7_8:1450:10019: scene=7_8
#: 7_8:1450
msgctxt "text_id=10019 | speaker=unknown"
msgid "　よせばいいのに、有珠の酷評を受けた草十郎のお茶を飲む気になったのだ。"
msgstr "  It was almost certainly better left untasted, but she could not help but wonder how Soujyuro's tea could arouse such a strong response."

#. Occurrence 7_8:1461:10020: scene=7_8
#: 7_8:1461
msgctxt "text_id=10020 | speaker=unknown"
msgid "　くいと一口に試した後、青子も静かにカップを戻す。"
msgstr "  After one small sip she returned it quietly to the floor."

#. Occurrence 7_8:1502:10021: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_8_0015; voice_prefix=A10; voice_category=1; scene=7_8
#: 7_8:1502
msgctxt "text_id=10021 | speaker=aoko"
msgid "「……だからティーバッグにしろって言ったのに、あの莫迦」"
msgstr "\"Yep, he should have used the tea bags like I told him to. Dummy.\""

#. Occurrence 7_8:1508:10022: scene=7_8
#: 7_8:1508
msgctxt "text_id=10022 | speaker=unknown"
msgid "　有珠と同じ、苦いような困ったような顔をして、青子はそう呟いた。"
msgstr "  The expression on her face was nearly identical to that of her roommate's."

#. Occurrence 7_EX:97:10023: scene=7_EX
#: 7_EX:97
msgctxt "text_id=10023 | speaker=unknown"
msgid "　夜中、洋館を歩いていると不思議なコトに遭遇する。"
msgstr "  Walking around the mansion at night often led to mysterious encounters."

#. Occurrence 7_EX:131:10024: scene=7_EX
#: 7_EX:131
msgctxt "text_id=10024 | speaker=unknown"
msgid "　館内にただよう霧や、"
msgstr "  Mist might suddenly fill the hallway,"

#. Occurrence 7_EX:171:10025: scene=7_EX
#: 7_EX:171
msgctxt "text_id=10025 | speaker=unknown"
msgid "　増えたり減ったりするドア。"
msgstr "  or doors might appear and disappear."

#. Occurrence 7_EX:210:10026: scene=7_EX
#: 7_EX:210
msgctxt "text_id=10026 | speaker=unknown"
msgid "　絨毯の手入れをする子豚っぽい影を見たかと思えば、このように、"
msgstr "  Just when Soujyuro thought he had seen it all with pig-shaped shadows mending the carpet,"

#. Occurrence 7_EX:236:10027: scene=7_EX
#: 7_EX:236
msgctxt "text_id=10027 | speaker=unknown"
msgid "　サンルームに向かってはかき消える、鳥たちの羽音を聞いたりもする。"
msgstr "  he heard the sound of a bird's flapping coming from the sunroom."

#. Occurrence 7_EX:285:10028: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0000; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:285
msgctxt "text_id=10028 | speaker=soujuurou"
msgid "「なにごと……！？」"
msgstr "\"What's going on over there?!\""

#. Occurrence 7_EX:294:10029: scene=7_EX
#: 7_EX:294
msgctxt "text_id=10029 | speaker=unknown"
msgid "　たいていの事は見ざる聞かざるな草十郎も、今の羽音は聞き過ごせなかった。"
msgstr "  As much as he had become accustomed to turning a blind eye to such occurrences, the sound of flapping wings in the sunroom was too much to ignore."

#. Occurrence 7_EX:315:10030: scene=7_EX
#: 7_EX:315
msgctxt "text_id=10030 | speaker=unknown"
msgid "　一羽や二羽の話ではないのだ。"
msgstr "  And not just one bird, or even two, it sounded like dozens."

#. Occurrence 7_EX:320:10031: scene=7_EX
#: 7_EX:320
msgctxt "text_id=10031 | speaker=unknown"
msgid "　十羽単位の鳥がサンルームに突撃したとすれば、窓ガラスとて無事では済むまい。"
msgstr "  So many birds packed in the sunroom would inevitably lead to shattered windows and broken glass."

#. Occurrence 7_EX:337:10032: scene=7_EX
#: 7_EX:337
msgctxt "text_id=10032 | speaker=unknown"
msgid "　いてもたってもいられず、草十郎はちり取りと<箒|ほうき>を手にして走りだした。"
msgstr "  Soujyuro grabbed a broom and dashed toward the sound, prepared for the worst."

#. Occurrence 7_EX:342:10033: scene=7_EX
#: 7_EX:342
msgctxt "text_id=10033 | speaker=unknown"
msgid "　生来の小姑根性か、せいいっぱいの自己防衛か。"
msgstr "  Perhaps he was moved by his natural impulse to help, or desperate self-defense."

#. Occurrence 7_EX:347:10034: scene=7_EX
#: 7_EX:347
msgctxt "text_id=10034 | speaker=unknown"
msgid "　今日の授業でたまたま、"
msgstr "  His mind flashed to what a teacher had said at school."

#. Occurrence 7_EX:380:10035: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_EX_0000; voice_prefix=B60; voice_category=7; scene=7_EX
#: 7_EX:380
msgctxt "text_id=10035 | speaker=yamashiro"
msgid "「皆さんも部屋の整頓は心がけてくださいね。人間の自制心って環境に流されるらしいですから。"
msgstr "\"You should all make sure to keep your rooms orderly and clean. Work ethic and self-discipline will have a positive impact on your surroundings."

#. Occurrence 7_EX:387:10036: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_EX_0001; voice_prefix=B60; voice_category=7; scene=7_EX
#: 7_EX:387
msgctxt "text_id=10036 | speaker=yamashiro"
msgid "ほら、それまで犯罪の少ない街だったのに、一つボロボロの家が出来ただけで近隣住人がみーんな自堕落になるというアレ。"
msgstr "Think about it. Even in a nice neighborhood where there isn't much crime, it only takes one ill-kept house to send the whole block into a spiral of depravity."

#. Occurrence 7_EX:393:10037: speaker=yamashiro; speaker_ja=山城教諭; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B60_7_EX_0002; voice_prefix=B60; voice_category=7; scene=7_EX
#: 7_EX:393
msgctxt "text_id=10037 | speaker=yamashiro"
msgid "　環境への無関心さがすさんだ精神を作り上げるとか眉唾ですけど、正直なところ、ブームだからって盗んだバイクで走り回ったり、学校の廊下の窓ガラスとか割ってまわっちゃダメですよ。先生の仕事が増えますから」"
msgstr "  Of course, we all know a messy room won't turn you into a criminal. But I'd better not catch any of you breaking windows in the hallway or going for a joy ride on stolen motorcycles. Think of all the pain you'd be causing your poor teacher!\""

#. Occurrence 7_EX:433:10038: scene=7_EX
#: 7_EX:433
msgctxt "text_id=10038 | speaker=unknown"
msgid "　時に、校内暴力がある種の若者にとってステータスになっていた時代の話である。"
msgstr "  At the time, school gangs had garnered a certain reputation among the youths."

#. Occurrence 7_EX:473:10039: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0001; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:473
msgctxt "text_id=10039 | speaker=soujuurou"
msgid "「窓が割れると、心が荒れる」"
msgstr "\"Broken windows lead to broken hearts.\""

#. Occurrence 7_EX:479:10040: scene=7_EX
#: 7_EX:479
msgctxt "text_id=10040 | speaker=unknown"
msgid "　草十郎はなるほど、と今日聞いた話を<反芻|はんすう>する。"
msgstr "  Soujyuro appreciated the basic message of the lecture as he ruminated over it."

#. Occurrence 7_EX:484:10041: scene=7_EX
#: 7_EX:484
msgctxt "text_id=10041 | speaker=unknown"
msgid "　割れ窓理論を聞いていた彼にとって、洋館内のモラル低下は放っておけない。"
msgstr "  The thought of broken windows had given him a sense of urgency, as if the mansion's very moral foundations were at stake."

#. Occurrence 7_EX:529:10042: scene=7_EX
#: 7_EX:529
msgctxt "text_id=10042 | speaker=unknown"
msgid "　……同居人は<既|すで>にして十分なほど凶暴だが、これ以上<横暴|おうぼう>さが増しては、なにより本人の為にならない。また学校でよからぬ噂が流れてしまう。"
msgstr "  His roommates were harsh enough with him already; anything further would only lead to rampant rumors at school about their cruelty."

#. Occurrence 7_EX:547:10043: scene=7_EX
#: 7_EX:547
msgctxt "text_id=10043 | speaker=unknown"
msgid "　我らが生徒会長の名誉を守る為。"
msgstr "  He had to protect the honor of the student council president."

#. Occurrence 7_EX:552:10044: scene=7_EX
#: 7_EX:552
msgctxt "text_id=10044 | speaker=unknown"
msgid "　ひいては実害から自分の身を守る為、草十郎はサンルームの掃除に向かったのだが―――"
msgstr "  It was also concern for his own safety that sent him rushing to the sunroom. However..."

#. Occurrence 7_EX:621:10045: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0002; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:621
msgctxt "text_id=10045 | speaker=soujuurou"
msgid "「む？」"
msgstr "\"Huh?\""

#. Occurrence 7_EX:628:10046: scene=7_EX
#: 7_EX:628
msgctxt "text_id=10046 | speaker=unknown"
msgid "　この通り、サンルームには鳥の姿はおろか、鳴き声さえ有りはしなかった。"
msgstr "  There wasn't a bird to be seen or a chirp to be heard upon his arrival."

#. Occurrence 7_EX:666:10047: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_EX_0000; voice_prefix=A10; voice_category=1; scene=7_EX
#: 7_EX:666
msgctxt "text_id=10047 | speaker=aoko"
msgid "「あら」"
msgstr "\"Oh, hey.\""

#. Occurrence 7_EX:685:10048: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_EX_0000; voice_prefix=A40; voice_category=2; scene=7_EX
#: 7_EX:685
msgctxt "text_id=10048 | speaker=alice"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 7_EX:706:10049: scene=7_EX
#: 7_EX:706
msgctxt "text_id=10049 | speaker=unknown"
msgid "　中庭を<臨|のぞ>むテーブルには、午後のお茶を<愉|たの>しむ蒼崎青子と久遠寺有珠の姿のみ。"
msgstr "  Only Alice and Aoko, sipping afternoon tea at the table that overlooked the courtyard, were present."

#. Occurrence 7_EX:711:10050: scene=7_EX
#: 7_EX:711
msgctxt "text_id=10050 | speaker=unknown"
msgid "　草十郎ソナー探知で十八羽は居たであろう鳥の気配はどこにもない。"
msgstr "  The dozens of birds Soujyuro had sensed with his mountain intuition were nowhere to be seen."

#. Occurrence 7_EX:753:10051: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0003; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:753
msgctxt "text_id=10051 | speaker=soujuurou"
msgid "「いまここに鳥がこなかった！？」"
msgstr "\"Did anyone see a flock of birds?!\""

#. Occurrence 7_EX:789:10052: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_EX_0001; voice_prefix=A10; voice_category=1; scene=7_EX
#: 7_EX:789
msgctxt "text_id=10052 | speaker=aoko"
msgid "「有珠、見た？」"
msgstr "\"Alice?\""

#. Occurrence 7_EX:801:10053: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_EX_0001; voice_prefix=A40; voice_category=2; scene=7_EX
#: 7_EX:801
msgctxt "text_id=10053 | speaker=alice"
msgid "「さあ。もう見えないのなら、いないという事でしょう」"
msgstr "\"Who knows. If can't see them, there must not be any birds.\""

#. Occurrence 7_EX:813:10054: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_EX_0002; voice_prefix=A10; voice_category=1; scene=7_EX
#: 7_EX:813
msgctxt "text_id=10054 | speaker=aoko"
msgid "「だって。いないよ、鳥」"
msgstr "\"You heard her; no birds.\""

#. Occurrence 7_EX:848:10055: scene=7_EX
#: 7_EX:848
msgctxt "text_id=10055 | speaker=unknown"
msgid "　草十郎ですら感じ取れる、<清々|すがすが>しいまでの嘘である。"
msgstr "  It was a lie so blatant even Soujyuro could see through it."

#. Occurrence 7_EX:885:10056: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0004; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:885
msgctxt "text_id=10056 | speaker=soujuurou"
msgid "「そんなバカな」"
msgstr "\"That can't be true.\""

#. Occurrence 7_EX:899:10057: scene=7_EX
#: 7_EX:899
msgctxt "text_id=10057 | speaker=unknown"
msgid "　さっきの羽音は聞き間違いではない。"
msgstr "  He knew for a fact he had heard the flapping of a flock of birds."

#. Occurrence 7_EX:904:10058: scene=7_EX
#: 7_EX:904
msgctxt "text_id=10058 | speaker=unknown"
msgid "　こと野生動物の生態については<一家言|いっかげん>あるのか、草十郎は急ぎ足で窓まで移動し、ますます眉を<曇|くも>らせた。"
msgstr "  Unable to accept that there really were no wild animals in the room, Soujyuro approached the windows with suspicion."

#. Occurrence 7_EX:909:10059: scene=7_EX
#: 7_EX:909
msgctxt "text_id=10059 | speaker=unknown"
msgid "　窓ガラスには鳥の跡はおろか、羽の一枚すら落ちていない。"
msgstr "  There were no feathers or any other signs of birds having been outside, either."

#. Occurrence 7_EX:962:10060: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_EX_0003; voice_prefix=A10; voice_category=1; scene=7_EX
#: 7_EX:962
msgctxt "text_id=10060 | speaker=aoko"
msgid "「あ。夕食、<鶏|とり>鍋？」"
msgstr "\"Oh right, dinner. Chicken stew, was it?\""

#. Occurrence 7_EX:976:10061: scene=7_EX
#: 7_EX:976
msgctxt "text_id=10061 | speaker=unknown"
msgid "　鳥を探す草十郎を見て、なぜその発想にいきつくのか。"
msgstr "  Of course Aoko would say something like that as she watched Soujyuro search desperately."

#. Occurrence 7_EX:1017:10062: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0005; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:1017
msgctxt "text_id=10062 | speaker=soujuurou"
msgid "「あいにく、今日のバイトは魚屋さんだ。<鰯|いわし>でよければ土産にするけど」"
msgstr "\"Sorry, I'm working at the fish place tonight. But I've got you covered if you want sardines.\""

#. Occurrence 7_EX:1039:10063: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_EX_0004; voice_prefix=A10; voice_category=1; scene=7_EX
#: 7_EX:1039
msgctxt "text_id=10063 | speaker=aoko"
msgid "「鰯……鰯か……私、あのパイ嫌いなのよね……。"
msgstr "\"Sardines... Sardines, huh... I don't like sardine pie..."

#. Occurrence 7_EX:1051:10064: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_7_EX_0005; voice_prefix=A10; voice_category=1; scene=7_EX
#: 7_EX:1051
msgctxt "text_id=10064 | speaker=aoko"
msgid "　いえ、むしろ鰯のパイとか食べたコトないのよね……」"
msgstr "  Not that I've ever had it.\""

#. Occurrence 7_EX:1084:10065: scene=7_EX
#: 7_EX:1084
msgctxt "text_id=10065 | speaker=unknown"
msgid "　青子の<独|ひと>り芸は、この時代ではあまりに高度すぎたようだ。"
msgstr "  Aoko's stand-up routine was far ahead of its time."

#. Occurrence 7_EX:1103:10066: scene=7_EX
#: 7_EX:1103
msgctxt "text_id=10066 | speaker=unknown"
msgid "　草十郎は窓ガラスから離れ、とぼとぼサンルームを後にし、"
msgstr "  Soujyuro backed away from the window and begrudgingly left the sunroom,"

#. Occurrence 7_EX:1127:10067: scene=7_EX
#: 7_EX:1127
msgctxt "text_id=10067 | speaker=unknown"
msgid "　今まで幾度とあった、有珠からのよく分からない視線を感じた。"
msgstr "  feeling Alice's all-too-familiar inscrutable gaze upon his back."

#. Occurrence 7_EX:1207:10068: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0006; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:1207
msgctxt "text_id=10068 | speaker=soujuurou"
msgid "「なんだい、<有|アリ>―――」"
msgstr "\"What's up, Alice-\""

#. Occurrence 7_EX:1213:10069: scene=7_EX
#: 7_EX:1213
msgctxt "text_id=10069 | speaker=unknown"
msgid "　何か聞きたい事でもあるのだろうか、と声をかけ、"
msgstr "  Just as he opened his mouth to ask her what she wanted..."

#. Occurrence 7_EX:1247:10070: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0007; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:1247
msgctxt "text_id=10070 | speaker=soujuurou"
msgid "「あいたっ」"
msgstr "\"Ow!\""

#. Occurrence 7_EX:1254:10071: scene=7_EX
#: 7_EX:1254
msgctxt "text_id=10071 | speaker=unknown"
msgid "　そんな草十郎の頭部に、青い流星が直撃した。"
msgstr "  A blue comet crashed into his head."

#. Occurrence 7_EX:1311:10072: scene=7_EX
#: 7_EX:1311
msgctxt "text_id=10072 | speaker=unknown"
msgid "　流星の正体は言うまでもない。"
msgstr "  It needed no explanation."

#. Occurrence 7_EX:1318:10073: scene=7_EX
#: 7_EX:1318
msgctxt "text_id=10073 | speaker=unknown"
msgid "　洋館に出没する謎の駒鳥である。"
msgstr "  It could only be Robin, the mysterious bird that appeared frequently in the mansion."

#. Occurrence 7_EX:1376:10074: scene=7_EX
#: 7_EX:1376
msgctxt "text_id=10074 | speaker=unknown"
msgid "　チチチチチチ、と甲高く駒鳥は<訴|うった>える。"
msgstr "  Chirp, chirp, chirp! It shrilled accusingly."

#. Occurrence 7_EX:1382:10075: scene=7_EX
#: 7_EX:1382
msgctxt "text_id=10075 | speaker=unknown"
msgid "　……実のところ。"
msgstr "  The truth was..."

#. Occurrence 7_EX:1387:10076: scene=7_EX
#: 7_EX:1387
msgctxt "text_id=10076 | speaker=unknown"
msgid "　草十郎に激突するコレこそが洋館の七不思議、その最たるものだった。"
msgstr "  The tiny aggressor that assaulted him just now was the greatest of the mansion's seven wonders."

#. Occurrence 7_EX:1547:10077: scene=7_EX
#: 7_EX:1547
msgctxt "text_id=10077 | speaker=unknown"
msgid "　アルバイトに向かう途中、多くの人々とすれ違う。"
msgstr "  Soujyuro encountered all sorts of people along his route to work."

#. Occurrence 7_EX:1554:10078: scene=7_EX
#: 7_EX:1554
msgctxt "text_id=10078 | speaker=unknown"
msgid "　まだ都会慣れしていない草十郎にとって、駅前通りの人の流れは圧巻だ。"
msgstr "  Still new to city life, he found the crowds of people outside the station utterly fascinating. In fact, they were the highlight of his commute."

#. Occurrence 7_EX:1559:10079: scene=7_EX
#: 7_EX:1559
msgctxt "text_id=10079 | speaker=unknown"
msgid "　誰一人として、同じ服装や歩き方の人間がいない。"
msgstr "  No two people wore exactly the same clothes or walked in the same fashion."

#. Occurrence 7_EX:1564:10080: scene=7_EX
#: 7_EX:1564
msgctxt "text_id=10080 | speaker=unknown"
msgid "　ここまで人が多ければ似たような外見の人間がいそうなものだが、ただの一人も<被|かぶ>っていない。"
msgstr "  With so many people, you would think they would all melt into an indistinguishable huddle, but each person he saw was different and unique."

#. Occurrence 7_EX:1569:10081: scene=7_EX
#: 7_EX:1569
msgctxt "text_id=10081 | speaker=unknown"
msgid "　多種多様な街の<賑|にぎ>わいに、子供のように感心してしまう。"
msgstr "  Soujyuro was excited as a child as he looked out at the bustling, diverse streets of the city."

#. Occurrence 7_EX:1619:10082: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0008; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:1619
msgctxt "text_id=10082 | speaker=soujuurou"
msgid "「―――いや」"
msgstr "\"...Stop it.\""

#. Occurrence 7_EX:1625:10083: scene=7_EX
#: 7_EX:1625
msgctxt "text_id=10083 | speaker=unknown"
msgid "　草十郎は目を閉じて反省した。"
msgstr "  Closing his eyes in shame, he sighed."

#. Occurrence 7_EX:1630:10084: scene=7_EX
#: 7_EX:1630
msgctxt "text_id=10084 | speaker=unknown"
msgid "　こんな事で感心しているようじゃまだまだ田舎者だ、とため息をつく。"
msgstr "  He was upset with himself for behaving like a bumbling tourist from the countryside."

#. Occurrence 7_EX:1671:10085: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0000; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:1671
msgctxt "text_id=10085 | speaker=kojika"
msgid "「ちょっと。青信号で突っ立ってられるの、邪魔なんだけど。なにガラにもなく<黄昏|たそが>れてるんだか」"
msgstr "\"Hey, you'll get in people's way spacing out in front of the crosswalk like that. Daydream somewhere else.\""

#. Occurrence 7_EX:1677:10086: scene=7_EX
#: 7_EX:1677
msgctxt "text_id=10086 | speaker=unknown"
msgid "　と。ややセンチになっていた背中に、聞き覚えのある、刺々しい声がかけられた。"
msgstr "  A stern and familiar voice behind him snapped him out of his navel-gazing."

#. Occurrence 7_EX:1736:10087: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0001; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:1736
msgctxt "text_id=10087 | speaker=kojika"
msgid "「なんだ、まっどべあに行く途中だったんだ。"
msgstr "\"Let me guess. On your way to The Mad Bear?"

#. Occurrence 7_EX:1748:10088: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0002; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:1748
msgctxt "text_id=10088 | speaker=kojika"
msgid "　……ふーん。わたしはコンビニのバイト。こっちは五時からだけど、静希は？」"
msgstr "  My shift at the convenience store that starts at five. You?\""

#. Occurrence 7_EX:1760:10089: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0009; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:1760
msgctxt "text_id=10089 | speaker=soujuurou"
msgid "「同じく五時から。<久|く><万|ま><梨|り>はどこか寄るところでも？」"
msgstr "\"Same. Five o'clock start. Were you on your way somewhere else?\""

#. Occurrence 7_EX:1787:10090: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0003; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:1787
msgctxt "text_id=10090 | speaker=kojika"
msgid "「本屋に寄った帰り。読みたかった本がなくなってたから、仕方なく出歩いてたところよ」"
msgstr "\"I just stopped by a bookstore. I'm out of stuff to read, so I thought I'd look for something new.\""

#. Occurrence 7_EX:1799:10091: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0010; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:1799
msgctxt "text_id=10091 | speaker=soujuurou"
msgid "「なるほど。時間を持て余しているところも同じだね」"
msgstr "\"I see. I guess we both have some time to spare.\""

#. Occurrence 7_EX:1850:10092: scene=7_EX
#: 7_EX:1850
msgctxt "text_id=10092 | speaker=unknown"
msgid "　声をかけてきたのはバイト先の知り合いでもあり、同期生でもある<久万梨|くまり><金鹿|こじか>だった。"
msgstr "  The girl who greeted him was Kojika Kumari, a work friend who was also in the same year at Misaki High."

#. Occurrence 7_EX:1855:10093: scene=7_EX
#: 7_EX:1855
msgctxt "text_id=10093 | speaker=unknown"
msgid "　声をかけてきた、というよりは因縁をつけてきた、という表現の方が正しいのだが。"
msgstr "  Though, it would have been more accurate to say she was looking for a pretext to fight him rather than greet him."

#. Occurrence 7_EX:1888:10094: scene=7_EX
#: 7_EX:1888
msgctxt "text_id=10094 | speaker=unknown"
msgid "　久万梨は草十郎にとってはじめての先輩でもある。"
msgstr "  To Soujyuro, Kumari had been the first person in the city he could look up to."

#. Occurrence 7_EX:1933:10095: scene=7_EX
#: 7_EX:1933
msgctxt "text_id=10095 | speaker=unknown"
msgid "　最初のアルバイト先で知り合い、"
msgstr "  They'd met at his first job,"

#. Occurrence 7_EX:1974:10096: scene=7_EX
#: 7_EX:1974
msgctxt "text_id=10096 | speaker=unknown"
msgid "　レジ打ちを間違え続けた事からコンビニは向いてないから辞めろと本気で軽蔑され、なぜか最後に、"
msgstr "  where she insisted he wasn't cut out to work the register after many mistakes, and convinced him to quit working at convenience stores altogether."

#. Occurrence 7_EX:1999:10097: scene=7_EX
#: 7_EX:1999
msgctxt "text_id=10097 | speaker=unknown"
msgid "“こっちの方が貴方に向いてる”と<中華飯店|まっどべあ>を紹介してくれた人物だ。"
msgstr "  In the end, she introduced him to his current job at the Chinese restaurant, The Mad Bear, a much better fit for Soujyuro."

#. Occurrence 7_EX:2036:10098: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0004; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2036
msgctxt "text_id=10098 | speaker=kojika"
msgid "「なにその無理矢理な顔。なんか元気ない。いつも以上にイラっとくるわ。"
msgstr "\"You look a little worse for wear, Sizuki. Why the long face? I've never seen you so pouty."

#. Occurrence 7_EX:2042:10099: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0005; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2042
msgctxt "text_id=10099 | speaker=kojika"
msgid "　静希のいいところなんて、いつもピシッとしている背筋ぐらいなのに、みっともなく丸まってるし。"
msgstr "  Usually, standing up straight is the one thing you're good at."

#. Occurrence 7_EX:2101:10100: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0006; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2101
msgctxt "text_id=10100 | speaker=kojika"
msgid "　もしかして悩みとかあるの？　……まっどべあに質の悪い先輩でもいるとか。それなら話ぐらいは聞いてあげるから、言ってみたら？」"
msgstr "  Something on your mind? ...Wait, are you getting bullied by the older guys at The Mad Bear? You can tell me anything, you know.\""

#. Occurrence 7_EX:2142:10101: scene=7_EX
#: 7_EX:2142
msgctxt "text_id=10101 | speaker=unknown"
msgid "　態度こそ厳しいものの、久万梨の目は真剣である。"
msgstr "  Though her tone was stern, her eyes were earnest."

#. Occurrence 7_EX:2147:10102: scene=7_EX
#: 7_EX:2147
msgctxt "text_id=10102 | speaker=unknown"
msgid "　都会育ちの久万梨にとって、静希草十郎という人間はそのすべてが癪に障るらしい。"
msgstr "  Having grown up in the city herself, she was irritated by virtually everything Soujyuro said and did."

#. Occurrence 7_EX:2152:10103: scene=7_EX
#: 7_EX:2152
msgctxt "text_id=10103 | speaker=unknown"
msgid "　が、それはそれとして、彼女は草十郎を対等の知人として捉えている。"
msgstr "  Nevertheless, she still treated him like an equal."

#. Occurrence 7_EX:2157:10104: scene=7_EX
#: 7_EX:2157
msgctxt "text_id=10104 | speaker=unknown"
msgid "　バイト先を紹介してくれたのも、そういう彼女の生真面目さ故だった。"
msgstr "  Introducing him to his current job was just one example of her sincerity."

#. Occurrence 7_EX:2210:10105: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0011; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2210
msgctxt "text_id=10105 | speaker=soujuurou"
msgid "「いや、別に悩みとかそういうんじゃなくて。不思議なコトがあったというか、珍しいものを見たというか……」"
msgstr "\"No, nothing like that. It's just, something strange happened. Something really unusual...\""

#. Occurrence 7_EX:2262:10106: scene=7_EX
#: 7_EX:2262
msgctxt "text_id=10106 | speaker=unknown"
msgid "　どう説明するべきか考えながら、草十郎は用件だけを口にした。"
msgstr "  Soujyuro could not find the words to explain his situation, but that did not stop him from trying."

#. Occurrence 7_EX:2267:10107: scene=7_EX
#: 7_EX:2267
msgctxt "text_id=10107 | speaker=unknown"
msgid "　まっどべあには何の問題もない。"
msgstr "  There were no problems at The Mad Bear to speak of."

#. Occurrence 7_EX:2272:10108: scene=7_EX
#: 7_EX:2272
msgctxt "text_id=10108 | speaker=unknown"
msgid "　商店街の<魚達|ウオタツ>と同じぐらい好い職場だ。"
msgstr "  He liked it just as much as his other job at Uotatsu, the fishmongers in the shopping district."

#. Occurrence 7_EX:2277:10109: scene=7_EX
#: 7_EX:2277
msgctxt "text_id=10109 | speaker=unknown"
msgid "　そういった仕事の話とはまったく関係なく、"
msgstr "  In fact, his problem had nothing to do with work at all."

#. Occurrence 7_EX:2282:10110: scene=7_EX
#: 7_EX:2282
msgctxt "text_id=10110 | speaker=unknown"
msgid "　最近、青い鳥によくつっつかれるのだと。"
msgstr "  No, his problem was a certain blue bird that would not stop pecking at him recently."

#. Occurrence 7_EX:2320:10111: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0007; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2320
msgctxt "text_id=10111 | speaker=kojika"
msgid "「鳥につっつかれる？　なにそれ、小さい悩み。"
msgstr "\"You're getting pecked? By a bird? ...Wow. And here I was thinking the world had ended."

#. Occurrence 7_EX:2326:10112: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0008; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2326
msgctxt "text_id=10112 | speaker=kojika"
msgid "　……でもまあ、青い鳥っていうのは確かに珍しいわね」"
msgstr "  ...It is pretty unusual for a bird to be blue, I guess.\""

#. Occurrence 7_EX:2332:10113: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0012; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2332
msgctxt "text_id=10113 | speaker=soujuurou"
msgid "「いや、珍しいのは外見の話じゃなくて……」"
msgstr "\"And that's not the only thing unusual about it.\""

#. Occurrence 7_EX:2338:10114: scene=7_EX
#: 7_EX:2338
msgctxt "text_id=10114 | speaker=unknown"
msgid "　うまく説明できず言いよどむ。"
msgstr "  He stopped, unsure of how to proceed."

#. Occurrence 7_EX:2380:10115: scene=7_EX
#: 7_EX:2380
msgctxt "text_id=10115 | speaker=unknown"
msgid "　あの青い鳥の、でっぷりとした外見や鳴き声を、人語でどう表現したものだろうか？"
msgstr "  Words alone were not enough to convey the bird's plump body or the sound of its chirping."

#. Occurrence 7_EX:2427:10116: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0009; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2427
msgctxt "text_id=10116 | speaker=kojika"
msgid "「……ふーん。綺麗な青色といったらマウンテンブルーバードだけど、日本にはいないわよね。"
msgstr "\"Hmm. There is a beautifully colored bird called the mountain bluebird, but they're not native to Japan."

#. Occurrence 7_EX:2433:10117: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0010; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2433
msgctxt "text_id=10117 | speaker=kojika"
msgid "　青いツバメだったらいるかもしれないけど」"
msgstr "  Maybe it's a blue swallow?\""

#. Occurrence 7_EX:2444:10118: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0013; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2444
msgctxt "text_id=10118 | speaker=soujuurou"
msgid "「いや、ツバメじゃなくて、丸っこいんだ。図鑑で調べたんだけど、どうもコマドリっぽい。けど」"
msgstr "\"No, it's more round than a swallow. I tried to look it up in a bird book and the closest thing I found was a robin.\""

#. Occurrence 7_EX:2471:10119: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0011; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2471
msgctxt "text_id=10119 | speaker=kojika"
msgid "「うん、青色のコマドリは存在しない。"
msgstr "\"Yeah, but robins aren't blue."

#. Occurrence 7_EX:2483:10120: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0012; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2483
msgctxt "text_id=10120 | speaker=kojika"
msgid "　……静希は縁日の青ひよこって知ってる？　知らないわよね。いい、そう面白い話じゃないから忘れて。"
msgstr "  ...You know those blue chicks they have at fairs in the city? Of course you don't, why would you? Just forget it."

#. Occurrence 7_EX:2489:10121: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0013; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2489
msgctxt "text_id=10121 | speaker=kojika"
msgid "　それより、そのコマドリって一羽だけなの？」"
msgstr "  Anyway, this robin-is it the only one?\""

#. Occurrence 7_EX:2524:10122: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0014; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2524
msgctxt "text_id=10122 | speaker=soujuurou"
msgid "「ああ、一羽だけだ。つがいは見あたらない」"
msgstr "\"Yeah, there's only one. It doesn't seem to have a mate.\""

#. Occurrence 7_EX:2545:10123: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0014; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2545
msgctxt "text_id=10123 | speaker=kojika"
msgid "「ふーん。突然変異だとしたらちょっと可哀想ね。"
msgstr "\"Hmm. Well, if it's the only one of its kind, then I feel kinda sorry for it."

#. Occurrence 7_EX:2551:10124: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0015; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2551
msgctxt "text_id=10124 | speaker=kojika"
msgid "　……生まれた時から最後の一羽だなんて、孤独にもほどがあるわ。"
msgstr "  Imagine being the last one of your kind since the day you're born. Talk about lonely!"

#. Occurrence 7_EX:2563:10125: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0016; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2563
msgctxt "text_id=10125 | speaker=kojika"
msgid "　どんな鳥かは知らないけど、次に見かけたら優しくしてあげたら？　自販機で十円を拾う、ぐらいの幸運は運んでくれるかもよ」"
msgstr "  I have no idea what species it could be. Maybe you should try being nice to it next time. It might bring you something special, like when you find a ten yen coin in a vending machine!\""

#. Occurrence 7_EX:2601:10126: scene=7_EX
#: 7_EX:2601
msgctxt "text_id=10126 | speaker=unknown"
msgid "　久万梨の言い分は優しさあふれるものだが、あの駒鳥につっつかれる草十郎としては、何とも頷きがたいものだった。"
msgstr "  Her words were perfectly kind, but he could hardly sympathize with the creature after all the painful pecking to which it had subjected him."

#. Occurrence 7_EX:2606:10127: scene=7_EX
#: 7_EX:2606
msgctxt "text_id=10127 | speaker=unknown"
msgid "　そもそも孤独なんて、あの駒鳥にもっとも似合わない表現ではないだろうか？"
msgstr "  He wouldn't have called the bird lonely, either."

#. Occurrence 7_EX:2643:10128: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0017; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2643
msgctxt "text_id=10128 | speaker=kojika"
msgid "「いいじゃない、小鳥一羽ぐらい。"
msgstr "\"If one little bird is all that's bothering you, you're lucky."

#. Occurrence 7_EX:2649:10129: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0018; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2649
msgctxt "text_id=10129 | speaker=kojika"
msgid "　そりゃ都会で鳥につつかれるのは珍しいけど、いい方の珍事よ、それ。これがゴミ袋をあさるカラスの大軍だったら困りものでしょうけど」"
msgstr "  The pecking part is weird for sure, especially in a city like this, but it could be way worse. Imagine getting attacked by an army of crows that swarm around the dumpsters!\""

#. Occurrence 7_EX:2669:10130: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0015; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2669
msgctxt "text_id=10130 | speaker=soujuurou"
msgid "「あ。そういえば、他にも気になる事が」"
msgstr "\"Right. Actually, there was something else bothering me, too.\""

#. Occurrence 7_EX:2689:10131: scene=7_EX
#: 7_EX:2689
msgctxt "text_id=10131 | speaker=unknown"
msgid "　久万梨の言葉から、草十郎は久遠寺邸・とり集団失踪事件を思い出した。"
msgstr "  Her example had reminded him of the mystery of the disappearing birds at the mansion."

#. Occurrence 7_EX:2694:10132: scene=7_EX
#: 7_EX:2694
msgctxt "text_id=10132 | speaker=unknown"
msgid "　あの鳥たちも不思議と言えば不思議すぎる。"
msgstr "  A stranger than strange event."

#. Occurrence 7_EX:2761:10133: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0016; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2761
msgctxt "text_id=10133 | speaker=soujuurou"
msgid "「実は今、あそこに見える丘に住んでるんだけど。"
msgstr "\"See that hill? I actually live on it."

#. Occurrence 7_EX:2767:10134: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0017; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2767
msgctxt "text_id=10134 | speaker=soujuurou"
msgid "　でるんだ、大量のムクドリが頻繁に。そのクセ、街に出ると見かけない」"
msgstr "  I see lots of starlings around there, but for some reason they never come down to town.\""

#. Occurrence 7_EX:2788:10135: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0019; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2788
msgctxt "text_id=10135 | speaker=kojika"
msgid "「当たり前でしょ。町じゃ鳥なんて見かけないし、あそこは山だから動物は多いんじゃない？"
msgstr "\"Well, duh, you never see birds in town. But on a mountain like that there are bound to be wild animals!"

#. Occurrence 7_EX:2821:10136: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0020; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2821
msgctxt "text_id=10136 | speaker=kojika"
msgid "　それより貴方、あの山に引っ越したの？　前のアパートは引き払ったって聞いてたけど。……学校まで通うの、大変じゃない。なんだってあんな<辺鄙|へんぴ>なところに」"
msgstr "  Why would you move way out there, anyway? I mean, I heard you moved out of your old apartment, but isn't it a pain getting to school? What are you doing out there in the boonies?\""

#. Occurrence 7_EX:2857:10137: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0018; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2857
msgctxt "text_id=10137 | speaker=soujuurou"
msgid "「ちょっとした成り行きだよ。それに通うのは大変じゃない。大変なのは中の話なんだ」"
msgstr "\"Things just worked out that way. And the commute isn't hard. If anything is painful, it's what happens inside that place.\""

#. Occurrence 7_EX:2868:10138: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0021; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2868
msgctxt "text_id=10138 | speaker=kojika"
msgid "「？」"
msgstr "\"Huh?\""

#. Occurrence 7_EX:2873:10139: scene=7_EX
#: 7_EX:2873
msgctxt "text_id=10139 | speaker=unknown"
msgid "　街に出るまで徒歩三十分。"
msgstr "  It took thirty minutes to reach town on foot."

#. Occurrence 7_EX:2878:10140: scene=7_EX
#: 7_EX:2878
msgctxt "text_id=10140 | speaker=unknown"
msgid "　近場のコンビニエンスストアまで四十分はかかる立地条件だが、草十郎にとって交通の不便さはそう問題ではない。"
msgstr "  The forty minutes to the nearest convenience store would be the real kicker for most people, but for Soujyuro it was no inconvenience."

#. Occurrence 7_EX:2883:10141: scene=7_EX
#: 7_EX:2883
msgctxt "text_id=10141 | speaker=unknown"
msgid "　問題は住んでいる建物の人外魔境っぷりである。"
msgstr "  The real problem was the dark forces beyond human understanding that lurked within the grounds."

#. Occurrence 7_EX:2920:10142: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0019; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2920
msgctxt "text_id=10142 | speaker=soujuurou"
msgid "「すまない、それは久万梨に話すことじゃなかった。"
msgstr "\"Sorry, I didn't mean to bring all my complaints to you."

#. Occurrence 7_EX:2932:10143: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0020; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:2932
msgctxt "text_id=10143 | speaker=soujuurou"
msgid "　それより今の話だ。町には鳥が少ないと言ったけど、どうして？」"
msgstr "  I'm curious about how you said there aren't many birds in town, though. Why is that?\""

#. Occurrence 7_EX:2958:10144: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0022; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2958
msgctxt "text_id=10144 | speaker=kojika"
msgid "「……たんに、環境に適応できなかったのよ。"
msgstr "\"Simple. They failed to adapt to the environment."

#. Occurrence 7_EX:2982:10145: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0023; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:2982
msgctxt "text_id=10145 | speaker=kojika"
msgid "　なに、鳥の話には随分と食いつくわね。静希、動物好き？」"
msgstr "  I didn't know you were so interested in birds. Are you an animal lover or something?\""

#. Occurrence 7_EX:3001:10146: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0021; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3001
msgctxt "text_id=10146 | speaker=soujuurou"
msgid "「どちらかというと好きな方だけど」"
msgstr "\"I guess I do like animals more than I dislike them.\""

#. Occurrence 7_EX:3022:10147: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0024; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3022
msgctxt "text_id=10147 | speaker=kojika"
msgid "「そ。わたしは嫌い。そんなわたしに鳥の話とかしてほしい？」"
msgstr "\"Really? I can't stand them. I'm surprised you didn't pick up on it sooner.\""

#. Occurrence 7_EX:3072:10148: scene=7_EX
#: 7_EX:3072
msgctxt "text_id=10148 | speaker=unknown"
msgid "　久万梨の言葉は矛盾に満ちている。"
msgstr "  Her statement could hardly be more self-contradictory."

#. Occurrence 7_EX:3077:10149: scene=7_EX
#: 7_EX:3077
msgctxt "text_id=10149 | speaker=unknown"
msgid "　動物嫌いという彼女が、なぜ先ほど“鳥には優しく”と口にしたのか。"
msgstr "  Minutes after telling him to be nice to a bird that attacked him, she was now claiming she did not even like animals."

#. Occurrence 7_EX:3112:10150: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0022; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3112
msgctxt "text_id=10150 | speaker=soujuurou"
msgid "「そうだな。嫌いなだけで苦手でないのなら、知ってる範囲で聞かせてほしい」"
msgstr "\"Well, even if you can't stand animals, I'd still like to hear what you know about birds.\""

#. Occurrence 7_EX:3133:10151: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0025; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3133
msgctxt "text_id=10151 | speaker=kojika"
msgid "「痛いトコつくじゃない。"
msgstr "\"Can't take a hint, huh."

#. Occurrence 7_EX:3162:10152: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0026; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3162
msgctxt "text_id=10152 | speaker=kojika"
msgid "　いいわ、バイトまでの時間つぶしにしてあげる。"
msgstr "  Fine. I need to kill some time until work starts anyway."

#. Occurrence 7_EX:3168:10153: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0027; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3168
msgctxt "text_id=10153 | speaker=kojika"
msgid "　さっきの続き。環境に適応できるかできないかってところからね」"
msgstr "  So, like I was saying, survival is all about being able to adapt to your environment.\""

#. Occurrence 7_EX:3221:10154: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0028; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3221
msgctxt "text_id=10154 | speaker=kojika"
msgid "「今でこそこんなだけど、三咲はここまで大きな町じゃなかったんだって。"
msgstr "\"Misaki's pretty big now, but it wasn't always like this."

#. Occurrence 7_EX:3227:10155: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0029; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3227
msgctxt "text_id=10155 | speaker=kojika"
msgid "　昔はその半分が森だったから、彼らはもともと森に適した生活をしていたのよ」"
msgstr "  Half of it used to be woodland, which was closer to the type of environment the poor things were used to living in.\""

#. Occurrence 7_EX:3247:10156: scene=7_EX
#: 7_EX:3247
msgctxt "text_id=10156 | speaker=unknown"
msgid "　久万梨は鳥たちを「彼ら」と呼んだ。"
msgstr "  The way Kumari addressed them was of note."

#. Occurrence 7_EX:3252:10157: scene=7_EX
#: 7_EX:3252
msgctxt "text_id=10157 | speaker=unknown"
msgid "　好きか嫌いかはともかく、鳥たちに敬意を払っている証だろう。"
msgstr "  Whether she liked them or not, she seemed to at least have some respect for them."

#. Occurrence 7_EX:3286:10158: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0030; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3286
msgctxt "text_id=10158 | speaker=kojika"
msgid "「でも近代化した街じゃ自然のサイクルも成り立たない。人間ってのは、まず環境を自分たちの都合に変えるから。"
msgstr "\"Nature ended up with the short straw as the city modernized. Humans always change their surroundings to suit their needs, after all."

#. Occurrence 7_EX:3292:10159: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0031; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3292
msgctxt "text_id=10159 | speaker=kojika"
msgid "　<藪蚊|やぶか>が多いって事で小さな川の流れを変えたり、町中コンクリートで塗り固めちゃえば鳥的にはお手上げよ。"
msgstr "  Diverting streams to get rid of mosquitoes, covering everything in town with concrete... It made the area unlivable for the birds."

#. Occurrence 7_EX:3298:10160: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0032; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3298
msgctxt "text_id=10160 | speaker=kojika"
msgid "　虫も森も少ないんじゃもう山に逃げるしかない。彼らは故郷を追われて、この森から山に移った。"
msgstr "  Without enough bugs or trees they had no choice but to flee. Chased out of their home they moved from the forest to the mountains."

#. Occurrence 7_EX:3304:10161: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0033; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3304
msgctxt "text_id=10161 | speaker=kojika"
msgid "　人間にとって都合のいい町は、鳥たちが生きるコロニーにはなり得ないから」"
msgstr "  A convenient urban center for humans isn't the kind of place that can support a colony of birds.\""

#. Occurrence 7_EX:3345:10162: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0023; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3345
msgctxt "text_id=10162 | speaker=soujuurou"
msgid "「……そんな事ぐらいで減るものか？"
msgstr "\"And that's all it took to get rid of birds in the city?"

#. Occurrence 7_EX:3351:10163: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0024; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3351
msgctxt "text_id=10163 | speaker=soujuurou"
msgid "　その、姿を見なくなるぐらいに？」"
msgstr "  Just like that, and we never see them again?\""

#. Occurrence 7_EX:3362:10164: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0034; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3362
msgctxt "text_id=10164 | speaker=kojika"
msgid "「そこまで極端じゃない……とは思う。現に貴方だってムクドリを見てるでしょう？"
msgstr "\"It's not *that* extreme. I mean, come on, you just said you see starlings."

#. Occurrence 7_EX:3368:10165: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0035; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3368
msgctxt "text_id=10165 | speaker=kojika"
msgid "　比較の問題よ。町には人間が多いから、鳥の姿はよけい稀少に感じるだけ。たまに見かけるだけで、珍しいと思えるぐらいにね」"
msgstr "  It's all relative. There are so many humans in town, the number of birds seems small in comparison. It feels special just to spot one here or there.\""

#. Occurrence 7_EX:3403:10166: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0025; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3403
msgctxt "text_id=10166 | speaker=soujuurou"
msgid "「ああ、たしかに。じゃあ鳥は町から居なくなっただけで、あの山に移り住んで―――」"
msgstr "\"That's true. So they all just left town and moved to the mountains...\""

#. Occurrence 7_EX:3409:10167: scene=7_EX
#: 7_EX:3409
msgctxt "text_id=10167 | speaker=unknown"
msgid "　目立たないだけで、きちんと今も生き続けている。"
msgstr "  Humans might not be able to see them in day-to-day life, but they were alive and well nonetheless."

#. Occurrence 7_EX:3414:10168: scene=7_EX
#: 7_EX:3414
msgctxt "text_id=10168 | speaker=unknown"
msgid "　時代と共に、その在り方、カタチは変わっても、まったくの無に帰する事はない。"
msgstr "  Their habitat and lifestyle changed with the times, but they never truly disappeared."

#. Occurrence 7_EX:3419:10169: scene=7_EX
#: 7_EX:3419
msgctxt "text_id=10169 | speaker=unknown"
msgid "　そう安心して気を取り直す草十郎を、久万梨は冷めた顔で否定した。"
msgstr "  Soujyuro's sense of relief was sharply disrupted by a serious look from Kumari."

#. Occurrence 7_EX:3453:10170: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0036; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3453
msgctxt "text_id=10170 | speaker=kojika"
msgid "「あの山に天敵がいなければね。"
msgstr "\"But the birds aren't safe in the mountains."

#. Occurrence 7_EX:3459:10171: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0037; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3459
msgctxt "text_id=10171 | speaker=kojika"
msgid "　人間の手による<乱獲|らんかく>か、移った先にいる生態系との衝突か。どちらにせよ、居場所を失った彼らの寿命は短いと思う。一世紀持てばいい方かもしれない。"
msgstr "  There's still overfishing by humans and conflict between the birds and their new ecosystem. With everything going on I doubt they'll last very long. Even a century might be optimistic."

#. Occurrence 7_EX:3465:10172: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0038; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3465
msgctxt "text_id=10172 | speaker=kojika"
msgid "　……リョコウバトの例もあるし。気が付いた時には取り返しつかないのが動物と人間の関係よ」"
msgstr "  Just look at what happened to passenger pigeons. Once humans noticed what they'd done to them, it was already too late. That's how it always is.\""

#. Occurrence 7_EX:3500:10173: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0026; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3500
msgctxt "text_id=10173 | speaker=soujuurou"
msgid "「リョコウバト……？」"
msgstr "\"...What are passenger pigeons?\""

#. Occurrence 7_EX:3517:10174: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0039; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3517
msgctxt "text_id=10174 | speaker=kojika"
msgid "「そ、リョコウバト。体長は四十センチほどもある、大型のきれいな鳥。"
msgstr "\"Oh, they were large, beautiful birds, about sixteen inches from head to tail."

#. Occurrence 7_EX:3523:10175: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0040; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3523
msgctxt "text_id=10175 | speaker=kojika"
msgid "　オスの翼は深い青色で、胸は鮮やかな<臙脂|えんじ>色。オレンジ色の目は嘘みたいに愛らしくて、その羽は時速百キロで長い距離を旅するの」"
msgstr "  The males were a deep blue, with vivid red on their breast. The cutest part was their orange eyes-like something out of a book! And they could fly up to sixty miles per hour over great distances.\""

#. Occurrence 7_EX:3543:10176: scene=7_EX
#: 7_EX:3543
msgctxt "text_id=10176 | speaker=unknown"
msgid "　久万梨の声は、少しだけ優しい。"
msgstr "  Her voice had a certain tenderness to it."

#. Occurrence 7_EX:3548:10177: scene=7_EX
#: 7_EX:3548
msgctxt "text_id=10177 | speaker=unknown"
msgid "　彼女は図鑑でしか観ることのない鳥の姿を、ひとり夢想しているようだった。"
msgstr "  She was daydreaming about birds she had never even seen in the flesh."

#. Occurrence 7_EX:3593:10178: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0041; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3593
msgctxt "text_id=10178 | speaker=kojika"
msgid "「北アメリカにいた<鳩|ハト>でね、春は南から北へ、冬は冬越えのために北から南に移動するの。"
msgstr "\"They were a type of pigeon native to North America, so they used to fly north in spring and then back south in winter until it got warm again."

#. Occurrence 7_EX:3599:10179: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0042; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3599
msgctxt "text_id=10179 | speaker=kojika"
msgid "　今から百年以上も前の話よ。"
msgstr "  But that was over a century ago."

#. Occurrence 7_EX:3605:10180: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0043; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3605
msgctxt "text_id=10180 | speaker=kojika"
msgid "　彼らはかつて地上でもっとも繁殖した高等動物だった。"
msgstr "  They used to be the most common higher animal on Earth."

#. Occurrence 7_EX:3611:10181: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0044; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3611
msgctxt "text_id=10181 | speaker=kojika"
msgid "　なにしろその数は五十億。当時の総人口より多かったっていうんだから、圧巻よね」"
msgstr "  There were five billion of them in total-that's more passenger pigeons than humans! Pretty amazing, right?\""

#. Occurrence 7_EX:3645:10182: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0027; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3645
msgctxt "text_id=10182 | speaker=soujuurou"
msgid "「なんと。人間より数の多い動物がいたっていうのか？」"
msgstr "\"Wow. I never thought about an animal being more common than humans.\""

#. Occurrence 7_EX:3667:10183: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0045; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3667
msgctxt "text_id=10183 | speaker=kojika"
msgid "「うん。でも彼らは絶滅したわ。他ならぬ人間の手によって。"
msgstr "\"Yeah, I know. But now they're all extinct, thanks to those same humans."

#. Occurrence 7_EX:3673:10184: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0046; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3673
msgctxt "text_id=10184 | speaker=kojika"
msgid "　１６世紀にヨーロッパからアメリカ大陸にやってきた探検家たちは、空を覆いつくすほどの鳥の群を見た。"
msgstr "  Settlers from Europe who went to the Americas in the sixteenth century mentioned flocks of passenger pigeons so vast they covered the entire sky."

#. Occurrence 7_EX:3679:10185: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0047; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3679
msgctxt "text_id=10185 | speaker=kojika"
msgid "　それがリョコウバトを<記|しる>した、一番古くて確かな記録」"
msgstr "  Those are the oldest written references to them that we have.\""

#. Occurrence 7_EX:3714:10186: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0048; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3714
msgctxt "text_id=10186 | speaker=kojika"
msgid "「……まあ、わたしも本で知った知識だけど。"
msgstr "\"Books are the only way to know anything about them these days."

#. Occurrence 7_EX:3720:10187: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0049; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3720
msgctxt "text_id=10187 | speaker=kojika"
msgid "　太陽を隠して、そのおびただしい数で森を覆って、雪のように糞を落としていく光景なんて、今じゃもう夢物語でしょうね。"
msgstr "  It's hard to imagine so many birds that they block out the sun, cover whole forests, and rain down droppings like snow. It sounds like something out of a dream, doesn't it?"

#. Occurrence 7_EX:3726:10188: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0050; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3726
msgctxt "text_id=10188 | speaker=kojika"
msgid "　でも当時の人にとっては悪夢だった。"
msgstr "  But for people back then it was more like a nightmare."

#. Occurrence 7_EX:3732:10189: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0051; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3732
msgctxt "text_id=10189 | speaker=kojika"
msgid "　リョコウバト一羽一羽は美しいフォルムをしていても、それだけの数が集まれば、それはもう暴力なんだから」"
msgstr "  Sure, each individual bird was beautiful, but together they amounted to a violent force of nature.\""

#. Occurrence 7_EX:3766:10190: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0052; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3766
msgctxt "text_id=10190 | speaker=kojika"
msgid "「彼らはその時点では、森を破壊し、人間を脅かす悪魔のような存在だった。"
msgstr "\"They were downright demonic with the power to destroy forests and threaten everyone."

#. Occurrence 7_EX:3772:10191: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0053; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3772
msgctxt "text_id=10191 | speaker=kojika"
msgid "　営巣地は十キロメートルにまでおよんで、一コロニーにつき五万羽近い鳥の鳴き声が響いたのよ。"
msgstr "  Their nesting grounds were up to six miles wide, and just one colony could have fifty thousand birds in it, so you can imagine how loud it got."

#. Occurrence 7_EX:3778:10192: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0054; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3778
msgctxt "text_id=10192 | speaker=kojika"
msgid "　一瞬にして風景を変えるほどの鳥の群れと、世界を覆うほどの鳴き声。冒険家たちが<竦|すく>んだのもうなずけるわね」"
msgstr "  A flock of birds so big it could instantly transform the landscape and cover the whole land with its cries... I can see why the settlers were scared at first.\""

#. Occurrence 7_EX:3814:10193: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0028; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3814
msgctxt "text_id=10193 | speaker=soujuurou"
msgid "「一つの住み処に五万羽―――」"
msgstr "\"Fifty thousand birds, all in one spot...\""

#. Occurrence 7_EX:3820:10194: scene=7_EX
#: 7_EX:3820
msgctxt "text_id=10194 | speaker=unknown"
msgid "　草十郎は指折り数えながら絶句した。"
msgstr "  Soujyuro trailed off as he attempted to count the number with his digits."

#. Occurrence 7_EX:3825:10195: scene=7_EX
#: 7_EX:3825
msgctxt "text_id=10195 | speaker=unknown"
msgid "　駅前の人の流れだけで手一杯な彼では、想像が追いつかないらしい。"
msgstr "  He could barely count the number of people in the crowd outside the station. This would be far beyond his capacity."

#. Occurrence 7_EX:3851:10196: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0029; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:3851
msgctxt "text_id=10196 | speaker=soujuurou"
msgid "「でも、そんな数の鳥を、人間の手でどうやって？」"
msgstr "\"But if there were so many of them, how could humans wipe them out?\""

#. Occurrence 7_EX:3862:10197: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0055; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3862
msgctxt "text_id=10197 | speaker=kojika"
msgid "「ええ。当時、誰もがそう思ったんでしょうね。"
msgstr "\"Good question. No one back then thought it was possible, either."

#. Occurrence 7_EX:3868:10198: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0056; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3868
msgctxt "text_id=10198 | speaker=kojika"
msgid "　でも話は簡単だったの。人間にとってリョコウバトは脅威でもあったけど、同時に安価な<実|みの>りでもあったから」"
msgstr "  But it's simple when you realize that passenger pigeons were both a threat and a cheap commodity.\""

#. Occurrence 7_EX:3904:10199: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0057; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3904
msgctxt "text_id=10199 | speaker=kojika"
msgid "「渡り鳥の胸肉は美味しいでしょ。よく鍛えられてるから。"
msgstr "\"All the flying was what made the meat of migratory birds so delicious to humans."

#. Occurrence 7_EX:3910:10200: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0058; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3910
msgctxt "text_id=10200 | speaker=kojika"
msgid "　そんな食材が、空に向かって鉄砲を撃つだけでバタバタと落ちてきたとしたら、貴方はどうする？"
msgstr "  And all you had to do was point your gun in the air. Bang! And there's dinner. What would you do in their shoes?"

#. Occurrence 7_EX:3916:10201: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0059; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3916
msgctxt "text_id=10201 | speaker=kojika"
msgid "　ま―――身もフタもないコトを言えば、リョコウバトって鳥は、簡単にお金にできる生き物だった」"
msgstr "  This might sound heartless, but the passenger pigeons were a species that could easily be converted into cold, hard cash.\""

#. Occurrence 7_EX:3965:10202: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0060; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3965
msgctxt "text_id=10202 | speaker=kojika"
msgid "「かくして、狩りは延々と続けられた。"
msgstr "\"Naturally, the hunting went on and on."

#. Occurrence 7_EX:3971:10203: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0061; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3971
msgctxt "text_id=10203 | speaker=kojika"
msgid "　落ちた鳥は羽をむしられて、塩漬けのタルにおしこまれて、次々と出荷された」"
msgstr "  People would pluck their feathers, stick them in a barrel with salt, and ship them out.\""

#. Occurrence 7_EX:3992:10204: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0062; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3992
msgctxt "text_id=10204 | speaker=kojika"
msgid "「それはもう狩りですらなかった。ただの消費。人間側は労働の実感も、作業の手間すら感じなくなっていた。"
msgstr "\"It wasn't hunting after a point, just consuming a resource. It didn't feel like work or labor to the people doing it."

#. Occurrence 7_EX:3998:10205: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0063; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:3998
msgctxt "text_id=10205 | speaker=kojika"
msgid "　その頃、リョコウバトは一羽一セントで手に入れる事が出来たんだって。ここでいうならたった一円。"
msgstr "  In those days you could get a whole passenger pigeon for one cent. That's roughly equal to one yen."

#. Occurrence 7_EX:4004:10206: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0064; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4004
msgctxt "text_id=10206 | speaker=kojika"
msgid "　―――ほんと、信じられる？"
msgstr "  Can you believe it?"

#. Occurrence 7_EX:4010:10207: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0065; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4010
msgctxt "text_id=10207 | speaker=kojika"
msgid "　その国最小の通貨一枚で売買される命が、この地球にはあったなんて」"
msgstr "  The smallest denomination of currency in society was enough to purchase an entire life.\""

#. Occurrence 7_EX:4061:10208: scene=7_EX
#: 7_EX:4061
msgctxt "text_id=10208 | speaker=unknown"
msgid "　久万梨はあくまで他人事のように語る。"
msgstr "  Kumari spoke as if reciting from a textbook."

#. Occurrence 7_EX:4066:10209: scene=7_EX
#: 7_EX:4066
msgctxt "text_id=10209 | speaker=unknown"
msgid "　……なのに、声にかすかな翳りがあるのは、鳥たちへの謝罪か、同種への嫌悪からか。"
msgstr "  Her voice nevertheless had a certain darkness to it-was it pity for the slain birds, or disgust for her fellow man?"

#. Occurrence 7_EX:4071:10210: scene=7_EX
#: 7_EX:4071
msgctxt "text_id=10210 | speaker=unknown"
msgid "　どちらにせよ人間らしい、身勝手な<諧謔|かいぎゃく>だ。"
msgstr "  Either way, the passenger pigeons' fate was a cruel joke carried out by humanity. Typical, some might say."

#. Occurrence 7_EX:4076:10211: scene=7_EX
#: 7_EX:4076
msgctxt "text_id=10211 | speaker=unknown"
msgid "　一方。そんな人間らしさを、草十郎はまだ理解できないでいる。"
msgstr "  Poor Soujyuro had yet to comprehend just how typical that side of humanity was."

#. Occurrence 7_EX:4115:10212: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0066; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4115
msgctxt "text_id=10212 | speaker=kojika"
msgid "「けど、それはまだまだ序の口で、本番は１９世紀に入ってからだった。"
msgstr "\"And that was only the beginning. The real damage began in the nineteenth century."

#. Occurrence 7_EX:4121:10213: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0067; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4121
msgctxt "text_id=10213 | speaker=kojika"
msgid "　人間のリョコウバト狩りはますます熱狂していった。"
msgstr "  Passenger pigeon hunting became more popular than ever before."

#. Occurrence 7_EX:4127:10214: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0068; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4127
msgctxt "text_id=10214 | speaker=kojika"
msgid "　学校で習ったでしょ。ゴールドラッシュ、南北戦争を経て、アメリカ合衆国は急激に成長していく。"
msgstr "  Remember learning about the Gold Rush, and the American Civil War? America was expanding really fast back then."

#. Occurrence 7_EX:4133:10215: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0069; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4133
msgctxt "text_id=10215 | speaker=kojika"
msgid "　西欧からの移民は増え続け、１８７０年には４０００万もの人口に達していたわ。そんな移民たちの胃袋と財布を満たす材料として、リョコウバトは最高の獲物だった」"
msgstr "  Immigrants kept flooding in from Europe, and by 1870 there were forty million people living in America. Passenger pigeons were the perfect thing for their purses and stomachs.\""

#. Occurrence 7_EX:4175:10216: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0070; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4175
msgctxt "text_id=10216 | speaker=kojika"
msgid "「で、もっと最悪な事に、人間は工夫する生き物だった。"
msgstr "\"But the worst part is how scheming people were."

#. Occurrence 7_EX:4181:10217: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0071; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4181
msgctxt "text_id=10217 | speaker=kojika"
msgid "　彼らはより速く、より多く、より簡単にリョコウバトを乱獲する手段を競い合った。"
msgstr "  They competed to find the fastest, most efficient way to catch as many passenger pigeons as possible."

#. Occurrence 7_EX:4187:10218: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0072; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4187
msgctxt "text_id=10218 | speaker=kojika"
msgid "　目を潰したハトを囮にして集団を誘いこんで、一日で一万羽以上捕らえたヤツさえいた。それでも彼らは乱獲に疑問すら持たなかった。"
msgstr "  One thing they used to do is blind one pigeon and then use it as a lure for the group, sometimes catching ten thousand in a single day. Yet no one had a single qualm about what they were doing."

#. Occurrence 7_EX:4193:10219: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0073; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4193
msgctxt "text_id=10219 | speaker=kojika"
msgid "　―――繁殖と狩猟のバランスは、誰が見ても明らかに狂っていたのに」"
msgstr "  Any sane person could see that the balance between breeding and hunting was clearly out of whack.\""

#. Occurrence 7_EX:4242:10220: scene=7_EX
#: 7_EX:4242
msgctxt "text_id=10220 | speaker=unknown"
msgid "　淡々と、努めて冷静でいるように淡々と、久万梨は語る。"
msgstr "  She was doing everything she could to speak in calm, measured tones."

#. Occurrence 7_EX:4247:10221: scene=7_EX
#: 7_EX:4247
msgctxt "text_id=10221 | speaker=unknown"
msgid "　一方、草十郎はただ感心するばかりだった。"
msgstr "  Soujyuro, meanwhile, was completely enraptured by her words."

#. Occurrence 7_EX:4252:10222: scene=7_EX
#: 7_EX:4252
msgctxt "text_id=10222 | speaker=unknown"
msgid "　山育ちである草十郎からすれば気持ちのいい話ではないのに、今は、「どうしてそうなったのか」という疑問の方が強いらしい。"
msgstr "  Having been raised in the mountains it was by no means a happy story for him, but right now he was more interested in knowing why it ever happened in the first place."

#. Occurrence 7_EX:4279:10223: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0030; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:4279
msgctxt "text_id=10223 | speaker=soujuurou"
msgid "「それ、一方的すぎないか？　リョコウバトだって数が減ってくれば、人間には近寄らないんじゃ」"
msgstr "\"Something seems off about that. If their numbers were decreasing so fast the passenger pigeons should've tried harder to avoid humans.\""

#. Occurrence 7_EX:4290:10224: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0074; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4290
msgctxt "text_id=10224 | speaker=kojika"
msgid "「そこが彼らの不幸だったのよ。"
msgstr "\"That's where they were unlucky."

#. Occurrence 7_EX:4296:10225: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0075; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4296
msgctxt "text_id=10225 | speaker=kojika"
msgid "　リョコウバトは繁殖力が非常に弱くて、自衛手段を持たない鳥だった。大群で暮らすこと。それだけが、彼らの身を守る手段だったの」"
msgstr "  They had really low fertility rates and no means of protecting themselves. All they knew to do was live together in groups. That was their only form of self-defense.\""

#. Occurrence 7_EX:4330:10226: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0076; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4330
msgctxt "text_id=10226 | speaker=kojika"
msgid "「彼らが五十億の王国を築けたのは、それまで天敵がいなかったからなんでしょうね。先住民であるインディアンも彼らを乱獲する事はなかったと言うし。"
msgstr "\"Passenger pigeons managed to build an empire of five billion only because they lacked natural predators. Indigenous people didn't hunt them either, apparently."

#. Occurrence 7_EX:4336:10227: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0077; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4336
msgctxt "text_id=10227 | speaker=kojika"
msgid "　けど入植者たちは自然のサイクルにはてんで<疎|うと>かった。"
msgstr "  It was the settlers who wrecked the local ecosystem."

#. Occurrence 7_EX:4342:10228: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0078; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4342
msgctxt "text_id=10228 | speaker=kojika"
msgid "　何より、あの<夥|おびただ>しい数の鳥が絶滅するなんて夢にも思わなかった。"
msgstr "  No one ever imagined in their wildest dreams that so many birds could just go extinct."

#. Occurrence 7_EX:4348:10229: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0079; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4348
msgctxt "text_id=10229 | speaker=kojika"
msgid "　リョコウバトにしたら青天の霹靂よ。まさか何世紀も遅れて、海の向こうから天敵がやってくるなんて」"
msgstr "  The passenger pigeons couldn't have been prepared for a predator showing up centuries later out of the blue from across the ocean.\""

#. Occurrence 7_EX:4382:10230: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0080; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4382
msgctxt "text_id=10230 | speaker=kojika"
msgid "「そうして１８９６年。人間はようやく、熱狂を覚ますほどの現実に直面したわ。"
msgstr "\"Finally, in 1896 humans began to realize what their crazed enthusiasm had brought about."

#. Occurrence 7_EX:4388:10231: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0081; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4388
msgctxt "text_id=10231 | speaker=kojika"
msgid "　たったの２５万羽。"
msgstr "  A quarter of a million passenger pigeons..."

#. Occurrence 7_EX:4394:10232: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0082; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4394
msgctxt "text_id=10232 | speaker=kojika"
msgid "　それが確認されたリョコウバトの総数。何もかも手遅れよ。急いで保護法が作られたけど、人間の習慣はそう簡単には変わらないわ」"
msgstr "  That's how many they estimated were still left. But it was too late. The government tried passing laws to protect them, but human habits are hard to break.\""

#. Occurrence 7_EX:4424:10233: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0083; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4424
msgctxt "text_id=10233 | speaker=kojika"
msgid "「あるいは、狩人たちはこう思ったのかもしれない。"
msgstr "\"Or maybe hunters just thought that with two hundred and fifty thousand passenger pigeons still left,"

#. Occurrence 7_EX:4430:10234: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0084; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4430
msgctxt "text_id=10234 | speaker=kojika"
msgid "　<ま|・><だ|・><２|・><５|・><万|・><羽|・><も|・><い|・><る|・><じ|・><ゃ|・><な|・><い|・><か|・>、千羽や二千羽ぐらいなら独り占めしても構わないだろう、って」"
msgstr "  taking one or two thousand wouldn't be a big deal in the greater scheme of things.\""

#. Occurrence 7_EX:4451:10235: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0085; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4451
msgctxt "text_id=10235 | speaker=kojika"
msgid "「そうしてハンターたちは当時最新の技術―――電報でリョコウバトたちの所在を報せあって、実に２０万羽のリョコウバトを仕留め、４万羽を傷つけた。"
msgstr "\"Hunters started using the latest technological breakthrough, the telegraph, to keep track of where the passenger pigeons were. Soon they had shot down two hundred thousand, and injured forty thousand more."

#. Occurrence 7_EX:4457:10236: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0086; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4457
msgctxt "text_id=10236 | speaker=kojika"
msgid "　生き延びたのは５０００羽だけ。この時点で、彼らは野生で生きられる種ではなくなったのよ」"
msgstr "  That left only five thousand passenger pigeons in the world. And at that point they could no longer survive in the wild.\""

#. Occurrence 7_EX:4489:10237: scene=7_EX
#: 7_EX:4489
msgctxt "text_id=10237 | speaker=unknown"
msgid "　草十郎は顔をしかめている。"
msgstr "  Soujyuro's face sunk into a scowl."

#. Occurrence 7_EX:4494:10238: scene=7_EX
#: 7_EX:4494
msgctxt "text_id=10238 | speaker=unknown"
msgid "“野生で生きられる種ではない。”"
msgstr "  No longer able to survive in the wild..."

#. Occurrence 7_EX:4499:10239: scene=7_EX
#: 7_EX:4499
msgctxt "text_id=10239 | speaker=unknown"
msgid "　その言葉の意味を、彼は言われるまでもなく知っているからだ。"
msgstr "  He knew all too well what that phrase meant."

#. Occurrence 7_EX:4519:10240: scene=7_EX
#: 7_EX:4519
msgctxt "text_id=10240 | speaker=unknown"
msgid "　野生動物は単体で生き続けるものではない。"
msgstr "  No wild animal can last long on its own."

#. Occurrence 7_EX:4524:10241: scene=7_EX
#: 7_EX:4524
msgctxt "text_id=10241 | speaker=unknown"
msgid "　全体の数と、それを支える餌場を一定数維持できなければ、存続する事ができない。"
msgstr "  No animal can survive without a sufficiently large population of their fellow kind and sufficient feeding grounds to support the group."

#. Occurrence 7_EX:4529:10242: scene=7_EX
#: 7_EX:4529
msgctxt "text_id=10242 | speaker=unknown"
msgid "　<大|・><群|・><で|・><あ|・><る|・><事|・>がリョコウバトのシステムであったのなら、もうその時点で、彼らは袋小路に入っていた。"
msgstr "  Strength in their massive numbers was all the passenger pigeons ever had, and so once that was gone they were as good as extinct."

#. Occurrence 7_EX:4555:10243: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0031; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:4555
msgctxt "text_id=10243 | speaker=soujuurou"
msgid "「それで、リョコウバトはどうなったんだ？」"
msgstr "\"What happened to them in the end, though?\""

#. Occurrence 7_EX:4575:10244: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0087; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4575
msgctxt "text_id=10244 | speaker=kojika"
msgid "「最後に保護されたリョコウバトはたったの三羽。"
msgstr "\"Eventually there were only *three* passenger pigeons left."

#. Occurrence 7_EX:4581:10245: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0088; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4581
msgctxt "text_id=10245 | speaker=kojika"
msgid "　シンシナティの動物園ではオス二羽、メス一羽のリョコウバトが飼育されたけど、一年でオスたちは死んじゃったわ。"
msgstr "  Two males and one female were kept in captivity at the Cincinnati Zoo, but within the year both the males had died."

#. Occurrence 7_EX:4587:10246: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0089; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4587
msgctxt "text_id=10246 | speaker=kojika"
msgid "　残されたのはメス一羽だけ。"
msgstr "  Then only the female was left."

#. Occurrence 7_EX:4593:10247: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0090; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4593
msgctxt "text_id=10247 | speaker=kojika"
msgid "　その時点で、彼女は地上でもっとも孤独な生き物になった」"
msgstr "  At that moment when the other two died, she became the single loneliest creature on earth.\""

#. Occurrence 7_EX:4614:10248: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0091; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4614
msgctxt "text_id=10248 | speaker=kojika"
msgid "「名前はマーサ。"
msgstr "\"Her name was Martha."

#. Occurrence 7_EX:4620:10249: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0092; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4620
msgctxt "text_id=10249 | speaker=kojika"
msgid "　北アメリカを旅する鳥たちの最後の一羽でありながら、ただの一度も空を飛ぶ事ができなかった<籠|かご>の鳥。"
msgstr "  The last of her species that had once soared over North America, she would never fly free again, trapped forever in her cage."

#. Occurrence 7_EX:4626:10250: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0093; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4626
msgctxt "text_id=10250 | speaker=kojika"
msgid "　結局、２９年で彼女はその命を終えたわ。"
msgstr "  At the age of twenty nine she finally passed."

#. Occurrence 7_EX:4632:10251: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0094; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4632
msgctxt "text_id=10251 | speaker=kojika"
msgid "　１９１４年９月１日午後１時。"
msgstr "  It happened at 1:00 PM on September 1st, 1914."

#. Occurrence 7_EX:4638:10252: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0095; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4638
msgctxt "text_id=10252 | speaker=kojika"
msgid "　一つの種が終わる時間がここまで正確に残っている例は、今のところこれだけよ」"
msgstr "  The only case in all of Earth history where we know the exact moment a species went extinct.\""

#. Occurrence 7_EX:4684:10253: scene=7_EX
#: 7_EX:4684
msgctxt "text_id=10253 | speaker=unknown"
msgid "　……五十億の死にまつわる話は終わった。"
msgstr "  The story of five billion deaths had finally come to an end."

#. Occurrence 7_EX:4689:10254: scene=7_EX
#: 7_EX:4689
msgctxt "text_id=10254 | speaker=unknown"
msgid "　文明に飲みこまれた鳥の末路。"
msgstr "  The birds had been swallowed up by the machinations of human civilization."

#. Occurrence 7_EX:4694:10255: scene=7_EX
#: 7_EX:4694
msgctxt "text_id=10255 | speaker=unknown"
msgid "　失われた鳥たちへの哀歌のような久万梨の話は、しかし、草十郎にはあまり伝わらなかったようだ。"
msgstr "  Kumari had intended to show her sympathy for the lost species, but the emotional impact had clearly been all but lost on Soujyuro."

#. Occurrence 7_EX:4724:10256: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0096; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4724
msgctxt "text_id=10256 | speaker=kojika"
msgid "「意外。できるだけ詩的に語ったつもりだけど、ウケ、悪いみたい。"
msgstr "\"Huh. I tried to make it sound all poetic and tragic, but I guess I failed."

#. Occurrence 7_EX:4731:10257: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0097; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4731
msgctxt "text_id=10257 | speaker=kojika"
msgid "山育ちの貴方には<憤慨|ふんがい>ものの話だと思ったのに」"
msgstr "Aren't you angry, as someone raised around nature in the mountains?\""

#. Occurrence 7_EX:4748:10258: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0032; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:4748
msgctxt "text_id=10258 | speaker=soujuurou"
msgid "「え―――いや、すごい話だったけど。"
msgstr "\"Oh... It was definitely an amazing story."

#. Occurrence 7_EX:4754:10259: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0033; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:4754
msgctxt "text_id=10259 | speaker=soujuurou"
msgid "　その、整理がつかなくて。当時の人たちは自分たちの手で減らしておいたのに、なんで最後は保護したのかって」"
msgstr "  But it doesn't make sense. Why would humans keep passenger pigeons in captivity after working so hard to kill them?\""

#. Occurrence 7_EX:4786:10260: scene=7_EX
#: 7_EX:4786
msgctxt "text_id=10260 | speaker=unknown"
msgid "　その呟きを聞いて、久万梨はきょとんと眉を上げた。"
msgstr "  Kumari stared blankly at him, eyebrows raised high."

#. Occurrence 7_EX:4791:10261: scene=7_EX
#: 7_EX:4791
msgctxt "text_id=10261 | speaker=unknown"
msgid "　おそらく、草十郎はこう言いたかったのだ。"
msgstr "  What he likely meant to ask was why humans would protect the last of a species"

#. Occurrence 7_EX:4797:10262: scene=7_EX
#: 7_EX:4797
msgctxt "text_id=10262 | speaker=unknown"
msgid "“奪うために減らしたのに、なぜ最後の一羽を守ろうとしたのか”と。"
msgstr "  they themselves had hunted into extinction."

#. Occurrence 7_EX:4817:10263: scene=7_EX
#: 7_EX:4817
msgctxt "text_id=10263 | speaker=unknown"
msgid "　久万梨が思い違いをしたのも無理はない。"
msgstr "  Kumari could hardly be blamed for her bewilderment."

#. Occurrence 7_EX:4822:10264: scene=7_EX
#: 7_EX:4822
msgctxt "text_id=10264 | speaker=unknown"
msgid "　都会育ちの彼女には、草十郎の疑問の危うさは理解できない。"
msgstr "  Having been raised in the city she failed to recognize the danger inherent in his cluelessness."

#. Occurrence 7_EX:4860:10265: scene=7_EX
#: 7_EX:4860
msgctxt "text_id=10265 | speaker=unknown"
msgid "　この少年にはまだ、"
msgstr "  He felt neither anger toward humans"

#. Occurrence 7_EX:4865:10266: scene=7_EX
#: 7_EX:4865
msgctxt "text_id=10266 | speaker=unknown"
msgid "　人間の身勝手な行為への怒りも、"
msgstr "  for their base selfishness, nor sympathy for the birds"

#. Occurrence 7_EX:4870:10267: scene=7_EX
#: 7_EX:4870
msgctxt "text_id=10267 | speaker=unknown"
msgid "　<住処|すみか>から移動しなかった鳥たちへの同情もない。"
msgstr "  who remained in their natural habitat even at the cost of their lives."

#. Occurrence 7_EX:4876:10268: scene=7_EX
#: 7_EX:4876
msgctxt "text_id=10268 | speaker=unknown"
msgid "　そのどちらかに肩入れする<独善|じぶん>を、ここまで育てずに暮らしてきた。"
msgstr "  His upbringing had not provided him with the necessary sense of self-righteousness to produce feelings in either direction."

#. Occurrence 7_EX:4911:10269: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0098; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4911
msgctxt "text_id=10269 | speaker=kojika"
msgid "「……あいかわらず、よく分かんないヤツ。"
msgstr "\"You don't get it, do you?"

#. Occurrence 7_EX:4922:10270: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0099; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4922
msgctxt "text_id=10270 | speaker=kojika"
msgid "　ま、わたしが言いたかったのは、どんなに強く美しく見えても、居場所から追われた生き物ははかないってコト。"
msgstr "  My point was that no matter how strong and beautiful animals might look, they don't stand a chance outside of their natural habitat."

#. Occurrence 7_EX:4933:10271: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0100; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4933
msgctxt "text_id=10271 | speaker=kojika"
msgid "　静希くん。"
msgstr "  Think about it, Sizuki."

#. Occurrence 7_EX:4939:10272: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0101; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:4939
msgctxt "text_id=10272 | speaker=kojika"
msgid "　貴方が見た鳥は、その最後の一羽かもしれないわよ？」"
msgstr "  That bird you're complaining about might be the very last of its kind.\""

#. Occurrence 7_EX:4985:10273: scene=7_EX
#: 7_EX:4985
msgctxt "text_id=10273 | speaker=unknown"
msgid "　……<益体|やくたい>のない立ち話は終わった。"
msgstr "  And with that, their idle conversation came to an end."

#. Occurrence 7_EX:4990:10274: scene=7_EX
#: 7_EX:4990
msgctxt "text_id=10274 | speaker=unknown"
msgid "　アルバイトの時間が近づき、草十郎は一足先にバイト先へ向かっていった。"
msgstr "  It was nearly time for their shifts to begin, and Soujyuro was the first to head off."

#. Occurrence 7_EX:5014:10275: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0102; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:5014
msgctxt "text_id=10275 | speaker=kojika"
msgid "「……らしくない。なに熱く語ってたんだろ、わたし」"
msgstr "\"What was I even thinking? It's not like me to rant like that.\""

#. Occurrence 7_EX:5020:10276: scene=7_EX
#: 7_EX:5020
msgctxt "text_id=10276 | speaker=unknown"
msgid "　草十郎と別れた後も、久万梨は公園に留まっていた。"
msgstr "  Kumari remained in the park after Soujyuro left."

#. Occurrence 7_EX:5025:10277: scene=7_EX
#: 7_EX:5025
msgctxt "text_id=10277 | speaker=unknown"
msgid "　マーサ。最後の一羽。"
msgstr "  Martha. The last of her species..."

#. Occurrence 7_EX:5030:10278: scene=7_EX
#: 7_EX:5030
msgctxt "text_id=10278 | speaker=unknown"
msgid "　そのフレーズは青い鳥にあてられたものではなく―――"
msgstr "  She had not been referring to the blue bird when she mentioned Martha, but..."

#. Occurrence 7_EX:5063:10279: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0103; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:5063
msgctxt "text_id=10279 | speaker=kojika"
msgid "「やめやめ。珍しいから特別視するとか、バカみたいだし」"
msgstr "\"No, stop it. Thinking something is special just because it's rare is dumb.\""

#. Occurrence 7_EX:5069:10280: scene=7_EX
#: 7_EX:5069
msgctxt "text_id=10280 | speaker=unknown"
msgid "　我が事のように愚痴りながら頭をかく。"
msgstr "  She rubbed the back of her head, apparently angry at herself for getting involved in something that was none of her business."

#. Occurrence 7_EX:5074:10281: scene=7_EX
#: 7_EX:5074
msgctxt "text_id=10281 | speaker=unknown"
msgid "　久万梨からすれば草十郎は赤の他人で、同じクラスの仲間でもない。"
msgstr "  She and Soujyuro were not even in the same class at school; he was a total stranger as far as she was concerned."

#. Occurrence 7_EX:5079:10282: scene=7_EX
#: 7_EX:5079
msgctxt "text_id=10282 | speaker=unknown"
msgid "　リョコウバトの話に熱が入ったのは、嫌いなコトの話ほど熱心に調べてしまう彼女の悪癖の結果である。"
msgstr "  The more something bothered her, the more she felt compelled to investigate it. It was a personal quirk of hers and the only reason she had gotten so worked up about the passenger pigeons."

#. Occurrence 7_EX:5104:10283: scene=7_EX
#: 7_EX:5104
msgctxt "text_id=10283 | speaker=unknown"
msgid "　カタチのいい眉をひそめる。"
msgstr "  Kumari's well-groomed brow furrowed."

#. Occurrence 7_EX:5109:10284: scene=7_EX
#: 7_EX:5109
msgctxt "text_id=10284 | speaker=unknown"
msgid "　まっどべあで働く以上、ヘンな悩みを抱えて欲しくないので話し相手になったが、あるいは、あの少年に妙な磁力があるのだろうか？"
msgstr "  She had only spoken to Soujyuro to make sure he was doing okay at The Mad Bear. Or maybe, it was that she had been strangely drawn to him."

#. Occurrence 7_EX:5114:10285: scene=7_EX
#: 7_EX:5114
msgctxt "text_id=10285 | speaker=unknown"
msgid "　話せば話すほど深みに<嵌|はま>っている気がする。"
msgstr "  The more they spoke the more she felt drawn to him."

#. Occurrence 7_EX:5148:10286: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0104; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:5148
msgctxt "text_id=10286 | speaker=kojika"
msgid "「まあ、見てて頼りないってのが一番だろうけど……話してみるとしっかりしすぎてるのよね、彼」"
msgstr "\"At first glance he looks like the last guy you would rely on, but when you get to talking to him you realize he's really got it together.\""

#. Occurrence 7_EX:5154:10287: scene=7_EX
#: 7_EX:5154
msgctxt "text_id=10287 | speaker=unknown"
msgid "　久万梨はそうぼやきながら、別れ際の会話を思い出した。"
msgstr "  Amidst her muttered complaints she recalled their conversation upon parting."

#. Occurrence 7_EX:5198:10288: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0105; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:5198
msgctxt "text_id=10288 | speaker=kojika"
msgid "“で、少しは町に慣れた？”"
msgstr "\"So, gotten used to everything yet?\""

#. Occurrence 7_EX:5204:10289: scene=7_EX
#: 7_EX:5204
msgctxt "text_id=10289 | speaker=unknown"
msgid "　そう訊いた久万梨に、草十郎は頼りなげに首を振った。"
msgstr "  to which he had given a weak shake of his head."

#. Occurrence 7_EX:5241:10290: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0034; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:5241
msgctxt "text_id=10290 | speaker=soujuurou"
msgid "“全然。何にせよ、覚えなくちゃいけない事が多すぎて”"
msgstr "\"Not at all. There are so many things to keep track of.\""

#. Occurrence 7_EX:5247:10291: scene=7_EX
#: 7_EX:5247
msgctxt "text_id=10291 | speaker=unknown"
msgid "　日々新しい出会いがあって、それを飲みこむだけで手一杯。"
msgstr "  He was trying his best to keep up with the overwhelming amount of new information every day."

#. Occurrence 7_EX:5252:10292: scene=7_EX
#: 7_EX:5252
msgctxt "text_id=10292 | speaker=unknown"
msgid "　あの純朴な少年は弱々しく見えるものの、町のすべてを受け入れようと全力で立っているのだ。"
msgstr "  However, despite his apparent naivety and frailty, he was in fact trying to learn everything he could about his new surroundings."

#. Occurrence 7_EX:5272:10293: scene=7_EX
#: 7_EX:5272
msgctxt "text_id=10293 | speaker=unknown"
msgid "　しかし―――日々新しい出会いがある、というのは大仰すぎるのではないか。"
msgstr "  But at the same, there was no reason it needed to be so overwhelming in the first place."

#. Occurrence 7_EX:5277:10294: scene=7_EX
#: 7_EX:5277
msgctxt "text_id=10294 | speaker=unknown"
msgid "　出会ったものを一つも取り落とさないよう努力するのは、彼が素直すぎるからだ。"
msgstr "  It was only due to his own naively subordinate frame of mind that he felt compelled to memorize each and every detail."

#. Occurrence 7_EX:5303:10295: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0035; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:5303
msgctxt "text_id=10295 | speaker=soujuurou"
msgid "“どうだろう。素直って言うのはちょっと違うと思うよ。"
msgstr "\"I wonder...I don't think I'm exactly being subordinate."

#. Occurrence 7_EX:5309:10296: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0036; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:5309
msgctxt "text_id=10296 | speaker=soujuurou"
msgid "　単に、それが良いことか悪いことか、まだ分かってないだけかもしれないし”"
msgstr "  The fact is I'm still just figuring out what's right and wrong.\""

#. Occurrence 7_EX:5315:10297: scene=7_EX
#: 7_EX:5315
msgctxt "text_id=10297 | speaker=unknown"
msgid "　彼はばつが悪そうに返す。"
msgstr "  He awkwardly claimed."

#. Occurrence 7_EX:5350:10298: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0106; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:5350
msgctxt "text_id=10298 | speaker=kojika"
msgid "“そうね。でも、もしかしたら、そもそも―――”"
msgstr "\"Right. But, maybe... Just maybe...\""

#. Occurrence 7_EX:5356:10299: scene=7_EX
#: 7_EX:5356
msgctxt "text_id=10299 | speaker=unknown"
msgid "　そこまで言いかけて、久万梨はまた今度、と手を振って別れる事にした。"
msgstr "  Kumari stopped herself mid-train of thought, deciding to instead wave goodbye and take her leave."

#. Occurrence 7_EX:5399:10300: scene=7_EX
#: 7_EX:5399
msgctxt "text_id=10300 | speaker=unknown"
msgid "　思い返すとますますため息がでてきた。"
msgstr "  She sighed aloud every time she replayed the scene in her head."

#. Occurrence 7_EX:5404:10301: scene=7_EX
#: 7_EX:5404
msgctxt "text_id=10301 | speaker=unknown"
msgid "　コンビニエンスストアのアルバイトまであと五分ほど。"
msgstr "  Work at the convenience store started in five minutes."

#. Occurrence 7_EX:5409:10302: scene=7_EX
#: 7_EX:5409
msgctxt "text_id=10302 | speaker=unknown"
msgid "　久万梨は頬を叩いて先ほどの会話を飲み下す。"
msgstr "  She gave herself a light slap on the face in an effort to forget their conversation."

#. Occurrence 7_EX:5414:10303: scene=7_EX
#: 7_EX:5414
msgctxt "text_id=10303 | speaker=unknown"
msgid "　他人のコトで気を病む余裕も、考察にふける義理もない。"
msgstr "  She reminded herself that she had neither the energy to worry about other people's problems nor the obligation to do so."

#. Occurrence 7_EX:5419:10304: scene=7_EX
#: 7_EX:5419
msgctxt "text_id=10304 | speaker=unknown"
msgid "　彼女は彼女で、大学進学の費用を貯める野望がある。"
msgstr "  She had her own concerns-saving up enough money for college, for example."

#. Occurrence 7_EX:5424:10305: scene=7_EX
#: 7_EX:5424
msgctxt "text_id=10305 | speaker=unknown"
msgid "　<日夜|にちや>両親の反対と戦う久万梨金鹿にとって、同級生の悩みなど二の次だ。"
msgstr "  Fighting against her parents' opposition every night was draining enough. There was no room for burdening herself with other students' issues."

#. Occurrence 7_EX:5457:10306: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0107; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:5457
msgctxt "text_id=10306 | speaker=kojika"
msgid "「……でも、もしかしたら、そもそも、か」"
msgstr "\"Right. But, maybe... Just maybe...\""

#. Occurrence 7_EX:5463:10307: scene=7_EX
#: 7_EX:5463
msgctxt "text_id=10307 | speaker=unknown"
msgid "　我ながらなんて思わせぶりで、実のない言い回しかと苦笑いする。"
msgstr "  It was not like her to get so tongue-tied, she thought to herself under a strained smile."

#. Occurrence 7_EX:5489:10308: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0108; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:5489
msgctxt "text_id=10308 | speaker=kojika"
msgid "「ほんと、はっきり言ってやればよかった。"
msgstr "\"I should have made my point more clearly."

#. Occurrence 7_EX:5495:10309: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_7_EX_0109; voice_prefix=B10; voice_category=5; scene=7_EX
#: 7_EX:5495
msgctxt "text_id=10309 | speaker=kojika"
msgid "　貴方は単に、<人の善悪|そういうの>に関わる気が、これっぽっちもないんじゃないのかって」"
msgstr "  I should have flat-out asked him if he cares at all about human morality.\""

#. Occurrence 7_EX:5501:10310: scene=7_EX
#: 7_EX:5501
msgctxt "text_id=10310 | speaker=unknown"
msgid "　だからアイツ嫌いなのよ、と。"
msgstr "  He really did annoy her."

#. Occurrence 7_EX:5506:10311: scene=7_EX
#: 7_EX:5506
msgctxt "text_id=10311 | speaker=unknown"
msgid "　悪態にもとれるため息をこぼして、彼女は公園を後にした。"
msgstr "  Now in a thoroughly bad mood, she left the park in a huff."

#. Occurrence 7_EX:5606:10312: scene=7_EX
#: 7_EX:5606
msgctxt "text_id=10312 | speaker=unknown"
msgid "　草十郎がアルバイトを終え、土産の<鰯|いわし>を片手に居間に入ると、ソファーには有珠の姿があった。"
msgstr "  When Soujyuro entered the drawing room after work with a gift of sardines for his roommates, he came face to face with Alice sitting on the sofa."

#. Occurrence 7_EX:5637:10313: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0037; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:5637
msgctxt "text_id=10313 | speaker=soujuurou"
msgid "「や。こんばんは、有珠」"
msgstr "\"Oh, err... Hi, Alice.\""

#. Occurrence 7_EX:5648:10314: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0038; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:5648
msgctxt "text_id=10314 | speaker=soujuurou"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 7_EX:5653:10315: scene=7_EX
#: 7_EX:5653
msgctxt "text_id=10315 | speaker=unknown"
msgid "　さすがの草十郎も、まだ「ただいま」と言えるだけの親しみはないらしい。"
msgstr "  The sense of familiarity to be able to say \"I'm home\" when entering the mansion still eluded Soujyuro."

#. Occurrence 7_EX:5684:10316: scene=7_EX
#: 7_EX:5684
msgctxt "text_id=10316 | speaker=unknown"
msgid "　草十郎はそのまま台所に移動し、バケツに水を溜めて魚を保存しようとして、"
msgstr "  He headed straight to the kitchen to fill a bucket with water to keep the sardines fresh,"

msgctxt "text_id=10317 | speaker=unknown"
msgid "背後からイヤそうな視線を感じ、しずしずと冷蔵庫を開けた。"
msgstr " but the icy stare on his back sent him anxiously to the refrigerator instead."

#. Occurrence 7_EX:5717:10318: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0039; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:5717
msgctxt "text_id=10318 | speaker=soujuurou"
msgid "『台所にバケツはダメなんだな……』"
msgstr "(Buckets are not allowed in the kitchen, remember?)"

#. Occurrence 7_EX:5722:10319: scene=7_EX
#: 7_EX:5722
msgctxt "text_id=10319 | speaker=unknown"
msgid "　仕方ない、とお手軽に魚を冷蔵庫にしまって、草十郎は居間の様子を窺った。"
msgstr "  Calmly accepting the change in plans, he shoved the sardines into the fridge and peeked back into the drawing room."

#. Occurrence 7_EX:5748:10320: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0040; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:5748
msgctxt "text_id=10320 | speaker=soujuurou"
msgid "「有珠、蒼崎は？」"
msgstr "\"Alice, have you seen Aozaki?\""

#. Occurrence 7_EX:5768:10321: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_EX_9000; voice_prefix=A40; voice_category=2; scene=7_EX
#: 7_EX:5768
msgctxt "text_id=10321 | speaker=alice"
msgid "「さあ。自分の部屋にいるか、出かけているんでしょう」"
msgstr "\"Well, either she's in her room or she's gone out somewhere.\""

#. Occurrence 7_EX:5774:10322: scene=7_EX
#: 7_EX:5774
msgctxt "text_id=10322 | speaker=unknown"
msgid "　にべもなく返される。"
msgstr "  Her reply was curt."

#. Occurrence 7_EX:5792:10323: scene=7_EX
#: 7_EX:5792
msgctxt "text_id=10323 | speaker=unknown"
msgid "　そうかと頷いて、草十郎はやや散らかった台所を片づけはじめた。"
msgstr "  He nodded and got to work cleaning the kitchen."

#. Occurrence 7_EX:5797:10324: scene=7_EX
#: 7_EX:5797
msgctxt "text_id=10324 | speaker=unknown"
msgid "　特に話題もないし、無理に話をする必要性も感じなかったからだろう。"
msgstr "  There was nothing in particular he wanted to say to her and also sensed that it would not be a good idea to start up a conversation needlessly."

#. Occurrence 7_EX:5817:10325: scene=7_EX
#: 7_EX:5817
msgctxt "text_id=10325 | speaker=unknown"
msgid "　水回りを片づけ、まな板を洗い、包丁を拭き、食器を調理時に出しやすい位置に整理整頓する。"
msgstr "  So he tidied up the sink area, washed the cutting board, wiped down the knives, and put away the cutlery so they could be easily found."

#. Occurrence 7_EX:5822:10326: scene=7_EX
#: 7_EX:5822
msgctxt "text_id=10326 | speaker=unknown"
msgid "　そんな、いずれ凄腕のハウスキーパーになる事を約束された、よどみのない作業っぷりを、"
msgstr "  Her black eyes monitored every action in his streamlined work flow,"

#. Occurrence 7_EX:5843:10327: scene=7_EX
#: 7_EX:5843
msgctxt "text_id=10327 | speaker=unknown"
msgid "　じっと観察する黒い目が、二つ。"
msgstr "  a rhythm that even the most seasoned housekeeper would be envious of."

#. Occurrence 7_EX:5863:10328: scene=7_EX
#: 7_EX:5863
msgctxt "text_id=10328 | speaker=unknown"
msgid "　草十郎がその視線に気が付くのは時間の問題だ。"
msgstr "  He would surely notice her gaze before too long."

#. Occurrence 7_EX:5882:10329: scene=7_EX
#: 7_EX:5882
msgctxt "text_id=10329 | speaker=unknown"
msgid "　身をかがめて、台所の収納に<寸胴|ずんどう>をしまう。"
msgstr "  He bent over to store a large pot under the sink when it happened."

#. Occurrence 7_EX:5887:10330: scene=7_EX
#: 7_EX:5887
msgctxt "text_id=10330 | speaker=unknown"
msgid "　そのまま立ち上がれば、居間にいる有珠と視線がばったり合って、"
msgstr "  As he began to stand back up he locked eyes with Alice, and then..."

#. Occurrence 7_EX:5922:10331: voice_id=BA0_7_EX_0000; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:5922
msgctxt "text_id=10331 | speaker=unknown"
msgid "『メェーーーデーーーっすよーーーー！"
msgstr "\"MAYDAY! MAYDAY!"

#. Occurrence 7_EX:5922:10332: voice_id=BA0_7_EX_0000; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:5922
msgctxt "text_id=10332 | speaker=unknown"
msgid "　小僧、今すぐロビーに顔を貸すっスーー！』"
msgstr "  Sling yer hook, boy!\""

#. Occurrence 7_EX:5969:10333: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0041; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:5969
msgctxt "text_id=10333 | speaker=soujuurou"
msgid "「あいたっ」"
msgstr "\"Owww!\""

#. Occurrence 7_EX:5975:10334: scene=7_EX
#: 7_EX:5975
msgctxt "text_id=10334 | speaker=unknown"
msgid "　その直前。"
msgstr "  Before he could make another move,"

#. Occurrence 7_EX:5981:10335: scene=7_EX
#: 7_EX:5981
msgctxt "text_id=10335 | speaker=unknown"
msgid "立ち上がろうとした草十郎の後頭部に、青い衝撃が突き刺さった。"
msgstr " he felt something slam into the back of his head―a bright shock of blue."

#. Occurrence 7_EX:6001:10336: scene=7_EX
#: 7_EX:6001
msgctxt "text_id=10336 | speaker=unknown"
msgid "　確かめるまでもない。"
msgstr "  He knew what it was without looking."

#. Occurrence 7_EX:6035:10337: scene=7_EX
#: 7_EX:6035
msgctxt "text_id=10337 | speaker=unknown"
msgid "　洋館内せましと飛び回る、青い駒鳥だった。"
msgstr "  It could only be the mansion's blue robin."

#. Occurrence 7_EX:6071:10338: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0042; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:6071
msgctxt "text_id=10338 | speaker=soujuurou"
msgid "「……洋館に戻ってくるなり、駒鳥に呼び出される」"
msgstr "\"Why does that thing have to start messing with me as soon as I get home?\""

#. Occurrence 7_EX:6077:10339: scene=7_EX
#: 7_EX:6077
msgctxt "text_id=10339 | speaker=unknown"
msgid "　ぼそっと呟く。"
msgstr "  Soujyuro muttered under his breath."

#. Occurrence 7_EX:6082:10340: scene=7_EX
#: 7_EX:6082
msgctxt "text_id=10340 | speaker=unknown"
msgid "　草十郎なりに、誰かにグチを言いたい気分だったのだろう。"
msgstr "  It was a rare situation that made Soujyuro feel like complaining."

#. Occurrence 7_EX:6118:10341: voice_id=BA0_7_EX_0001; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6118
msgctxt "text_id=10341 | speaker=unknown"
msgid "『小僧、ちょっとそこに座るッス』"
msgstr "\"Pull up a chair, boy!\""

#. Occurrence 7_EX:6124:10342: scene=7_EX
#: 7_EX:6124
msgctxt "text_id=10342 | speaker=unknown"
msgid "　チチチと駒鳥はさえずる。"
msgstr "  The robin chirped in its shrill tone."

#. Occurrence 7_EX:6129:10343: scene=7_EX
#: 7_EX:6129
msgctxt "text_id=10343 | speaker=unknown"
msgid "　……さて。"
msgstr "  You see..."

#. Occurrence 7_EX:6134:10344: scene=7_EX
#: 7_EX:6134
msgctxt "text_id=10344 | speaker=unknown"
msgid "　実のところ、<頻繁|ひんぱん>に激突してくるコレこそが洋館の七不思議、その最たるものだった。"
msgstr "  This little creature that loved to attack Soujyuro so, was the greatest of the mansion's many wonders."

#. Occurrence 7_EX:6139:10345: scene=7_EX
#: 7_EX:6139
msgctxt "text_id=10345 | speaker=unknown"
msgid "　なぜなら、"
msgstr "  And with good reason."

#. Occurrence 7_EX:6189:10346: voice_id=BA0_7_EX_0002; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6189
msgctxt "text_id=10346 | speaker=unknown"
msgid "『なめてるっすね？　ジブン駒鳥だってなめてるッスね？　ところで鳥鍋ってどういうコトっすか、それ美味しいんっスか、今度みまってほしいッス！』"
msgstr "\"Are you havin' a bird bath, mate? You think you're better than me, ey? And what the bloody hell is chicken stew supposed to mean anyway? You got somefink against a Richard the Third?\""

#. Occurrence 7_EX:6195:10347: scene=7_EX
#: 7_EX:6195
msgctxt "text_id=10347 | speaker=unknown"
msgid "　この通り。"
msgstr "  Like so."

#. Occurrence 7_EX:6200:10348: scene=7_EX
#: 7_EX:6200
msgctxt "text_id=10348 | speaker=unknown"
msgid "　駒鳥が何を伝えたいのか、草十郎にはなんとなく分かってしまうのだ。"
msgstr "  Soujyuro had an inkling of what the bird was getting at."

#. Occurrence 7_EX:6236:10349: scene=7_EX
#: 7_EX:6236
msgctxt "text_id=10349 | speaker=unknown"
msgid "　山育ちの草十郎にとって、これこそが悪夢だった。"
msgstr "  For someone raised in the mountains this was an utter nightmare."

#. Occurrence 7_EX:6241:10350: scene=7_EX
#: 7_EX:6241
msgctxt "text_id=10350 | speaker=unknown"
msgid "　しゃべる動物なんて聞いた事もない。"
msgstr "  Animals were not supposed to be able to talk."

#. Occurrence 7_EX:6246:10351: scene=7_EX
#: 7_EX:6246
msgctxt "text_id=10351 | speaker=unknown"
msgid "　そりゃあ、ごく<希|まれ>に、十年以上も山で暮らしていれば鳥の気持ちが分かるような時はある。もちろん錯覚だが、ちょっとだけ友情を感じる時もあった。"
msgstr "  Then again, having lived in the mountains for over a decade he did sometimes feel like he could understand what birds were trying to say. He knew it was just his imagination, but sometimes he thought they even saw him as a friend."

#. Occurrence 7_EX:6266:10352: scene=7_EX
#: 7_EX:6266
msgctxt "text_id=10352 | speaker=unknown"
msgid "　だがこれはない。"
msgstr "  That was not the case with this bird."

#. Occurrence 7_EX:6271:10353: scene=7_EX
#: 7_EX:6271
msgctxt "text_id=10353 | speaker=unknown"
msgid "　都会人より動物に馴れている分、草十郎は野<生動|かれら>物に対しては徹底的なリアリストなのである。"
msgstr "  Soujyuro had a realist's attitude toward wild animals as a result of being so familiar with them, in contrast to the ever mysterious humans who lived in the city."

#. Occurrence 7_EX:6302:10354: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0043; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:6302
msgctxt "text_id=10354 | speaker=soujuurou"
msgid "「しかし、現実だ」"
msgstr "\"It's... really talking to me.\""

#. Occurrence 7_EX:6308:10355: scene=7_EX
#: 7_EX:6308
msgctxt "text_id=10355 | speaker=unknown"
msgid "　頭を抱えて無視したいところだが、久万梨に聞いた話が脳裏をよぎる。"
msgstr "  As much as he wanted to deny the reality he was facing, he could not help but recall Kumari's story."

#. Occurrence 7_EX:6313:10356: scene=7_EX
#: 7_EX:6313
msgctxt "text_id=10356 | speaker=unknown"
msgid "　鳥には優しく。"
msgstr "  She had said to try and be nice to the bird the next time he saw it."

#. Occurrence 7_EX:6318:10357: scene=7_EX
#: 7_EX:6318
msgctxt "text_id=10357 | speaker=unknown"
msgid "　それが珍しいものなら、珍しいものなりに孤独を抱えているのだとか、なんとか。"
msgstr "  According to her, any rare or one-of-a-kind creature must accordingly feel very lonely."

#. Occurrence 7_EX:6355:10358: voice_id=BA0_7_EX_0003; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6355
msgctxt "text_id=10358 | speaker=unknown"
msgid "『座れって言ってるのにシカトっすか。"
msgstr "\"I said sit your pipe and drum down! You hearin' me all right, mate?"

#. Occurrence 7_EX:6361:10359: voice_id=BA0_7_EX_0004; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6361
msgctxt "text_id=10359 | speaker=unknown"
msgid "　あ、でもイスないッスねココ。じゃあ立ってるッス。小坊主だけに、廊下に立ってるのがお似合いッス。"
msgstr "  Hang on, there's no chair in 'ere! All right, just stand. I mean, I've stood up with you enough for the both of us!"

#. Occurrence 7_EX:6367:10360: voice_id=BA0_7_EX_0005; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6367
msgctxt "text_id=10360 | speaker=unknown"
msgid "　あれ、いまウマイこと言ったっスかねジブン！？』"
msgstr "  Get it? Pretty clever, if I say so myself!\""

#. Occurrence 7_EX:6414:10361: scene=7_EX
#: 7_EX:6414
msgctxt "text_id=10361 | speaker=unknown"
msgid "　羽ばたいているのも疲れたのか、駒鳥は受話器の横に着陸する。"
msgstr "  The bird perched itself on the telephone receiver, seemingly worn out from all the flapping."

#. Occurrence 7_EX:6419:10362: scene=7_EX
#: 7_EX:6419
msgctxt "text_id=10362 | speaker=unknown"
msgid "　草十郎に打つ手はない。"
msgstr "  Soujyuro was dumbfounded."

#. Occurrence 7_EX:6424:10363: scene=7_EX
#: 7_EX:6424
msgctxt "text_id=10363 | speaker=unknown"
msgid "　基本、この鳥の鳴き声を聞くだけが対抗手段なのだった。"
msgstr "  Listening in silence to the bird's chatter was his way of expressing his denial."

#. Occurrence 7_EX:6494:10364: voice_id=BA0_7_EX_0006; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6494
msgctxt "text_id=10364 | speaker=unknown"
msgid "『ジブン長いッス。プロイ<歴|れき>長いッスよ。"
msgstr "\"I'm pretty old, ya know, on account of me long career as a Ploy."

#. Occurrence 7_EX:6501:10365: voice_id=BA0_7_EX_0007; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6501
msgctxt "text_id=10365 | speaker=unknown"
msgid "マイ女神の頃からアリスさんに仕えてるっス。なんで青いかとかどうでもいいっス。"
msgstr "I've served Miss Alice from when the Goddess Mum was around. Don't ask why I'm blue."

#. Occurrence 7_EX:6513:10366: voice_id=BA0_7_EX_0008; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6513
msgctxt "text_id=10366 | speaker=unknown"
msgid "特技はズバリ探偵役と被害者役。でも探偵であるジブンが真っ先にコロコロするんで、誰がジブンを殺したか、結局誰も分からないッス』"
msgstr "My best skills are playin' the detective and the victim. But my detective side always dies first so no one can ever figure out who killed me!\""

#. Occurrence 7_EX:6532:10367: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0044; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:6532
msgctxt "text_id=10367 | speaker=soujuurou"
msgid "「プロイ？　待ってくれ、それには聞き覚えがある。プロイってなんなんだ？」"
msgstr "\"Wait, you're a Ploy? I've heard that word before. What does it mean again?\""

#. Occurrence 7_EX:6571:10368: voice_id=BA0_7_EX_0009; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6571
msgctxt "text_id=10368 | speaker=unknown"
msgid "『？？？　なんなんだと言われても困るッス。"
msgstr "\"Say what? Is you askin' what I is?"

#. Occurrence 7_EX:6577:10369: voice_id=BA0_7_EX_0010; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6577
msgctxt "text_id=10369 | speaker=unknown"
msgid "　エロイ、とかヤクイ、とかの最上級じゃないっスか？』"
msgstr "  I don't know what to feel right now―sexy or terrified!\""

#. Occurrence 7_EX:6606:10370: scene=7_EX
#: 7_EX:6606
msgctxt "text_id=10370 | speaker=unknown"
msgid "　ふむふむと話し合う久遠寺邸最弱のコンビ。"
msgstr "  Thusly, the conversation began between the two most powerless residents of the Kuonji Estate."

#. Occurrence 7_EX:6611:10371: scene=7_EX
#: 7_EX:6611
msgctxt "text_id=10371 | speaker=unknown"
msgid "　かくして、"
msgstr "  Humankind and birdkind, able to"

#. Occurrence 7_EX:6616:10372: scene=7_EX
#: 7_EX:6616
msgctxt "text_id=10372 | speaker=unknown"
msgid "　鳥と人間は分かり合えたらしい。"
msgstr "  understand one another after all."

#. Occurrence 7_EX:6636:10373: scene=7_EX
#: 7_EX:6636
msgctxt "text_id=10373 | speaker=unknown"
msgid "　いちいち悩むのも疲れたのか、無視するのも体力がいると気が付いたのか。"
msgstr "  Soujyuro was tired of letting the bird get to him, fully aware that ignoring it took more energy than it was worth."

#. Occurrence 7_EX:6641:10374: scene=7_EX
#: 7_EX:6641
msgctxt "text_id=10374 | speaker=unknown"
msgid "　観念した草十郎が合いの手を入れはじめたところ、二人はすっかりうち解けていた。"
msgstr "  Filled with a sense of resignation, by the time he finally did make an attempt to interject, both parties' guards were firmly down."

#. Occurrence 7_EX:6647:10375: scene=7_EX
#: 7_EX:6647
msgctxt "text_id=10375 | speaker=unknown"
msgid "　草十郎は珍しい話し相手として、"
msgstr "  Soujyuro was focused on how rare the bird was,"

#. Occurrence 7_EX:6652:10376: scene=7_EX
#: 7_EX:6652
msgctxt "text_id=10376 | speaker=unknown"
msgid "　駒鳥は<排斥|はいせき>すべきライバルとして、ではあるが。"
msgstr "  while Robin was focused on his showdown with his rival that was to be eliminated at all costs."

#. Occurrence 7_EX:6689:10377: voice_id=BA0_7_EX_0011; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6689
msgctxt "text_id=10377 | speaker=unknown"
msgid "『いいんスよ、細けぇ事は。そんなコトよりマイ天使・アリスさんの話をするッス』"
msgstr "\"Don't get your knickers in a twist. Let's talk about something more important, like my beloved Miss Alice! The Angel Mum herself!\""

#. Occurrence 7_EX:6731:10378: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0045; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:6731
msgctxt "text_id=10378 | speaker=soujuurou"
msgid "「なんと。有珠って天使なのか？」"
msgstr "\"Wait. She's an angel?\""

#. Occurrence 7_EX:6737:10379: scene=7_EX
#: 7_EX:6737
msgctxt "text_id=10379 | speaker=unknown"
msgid "　ところで天使ってなんだ、と続けないあたり、草十郎にも学習の跡が見られる。"
msgstr "  It was an impressive sign of progress that he did not need to ask what an \"angel\" was."

#. Occurrence 7_EX:6758:10380: voice_id=BA0_7_EX_0012; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6758
msgctxt "text_id=10380 | speaker=unknown"
msgid "『ヒユっす。ジブンにとって天使のような存在ってコトっす。下界の喧噪とか、ジブンの言葉をガン無視するところとかマジ天使。"
msgstr "\"Aye bruv, an angel! The way she's above the hustle and bustle of the masses, the way she doesn't give me the time of day... Absolutely angelic, I tell ya!"

#. Occurrence 7_EX:6769:10381: voice_id=BA0_7_EX_0013; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6769
msgctxt "text_id=10381 | speaker=unknown"
msgid "　アリスさんは神聖<不可侵|ふかしん>にして冷酷非道。マイ女神であったところの<母君|ははぎみ>とはちょっと、毛色が違うッス。"
msgstr "  She's holy and sacred she is, but she's also cruel and inhuman. Pretty fittin' for an angel, don't you think?"

#. Occurrence 7_EX:6775:10382: voice_id=BA0_7_EX_0014; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6775
msgctxt "text_id=10382 | speaker=unknown"
msgid "　ショージキ<女神|ははぎみ>、ちょっと育てかた間違ったッスね』"
msgstr "  Honestly, sometimes I think Goddess Mum didn't do the best job raisin' Angel Mum.\""

#. Occurrence 7_EX:6819:10383: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0046; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:6819
msgctxt "text_id=10383 | speaker=soujuurou"
msgid "「そうか。そりゃあ有珠にもお母さんはいるんだよな。"
msgstr "\"Okay... So Alice has a mom?"

#. Occurrence 7_EX:6825:10384: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0047; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:6825
msgctxt "text_id=10384 | speaker=soujuurou"
msgid "　この家にはいないようだけど」"
msgstr "  I thought maybe she didn't have any family at all.\""

#. Occurrence 7_EX:6848:10385: voice_id=BA0_7_EX_0015; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6848
msgctxt "text_id=10385 | speaker=unknown"
msgid "『イエス、悲しいコトにみまかられたっス。あの頃は全英の鳥が泣いたッス。アリスさんに負けないぐらい美しかったッス。あ、後でアルバムとか見るッスか？　６ペンスで手を打つッスよ』"
msgstr "\"Oh yes, she has one all right, but it's a sob story, innit? All the birds in England cried out that day! Her mum was even more smashing than Alice. Gots photos later if you like. Fer only sixpence! How 'bout it, lad?\""

#. Occurrence 7_EX:6883:10386: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0048; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:6883
msgctxt "text_id=10386 | speaker=soujuurou"
msgid "「いや。そういうのは、本人の許しがないと」"
msgstr "\"Uh, no thanks. I wouldn't want to do that without her permission.\""

#. Occurrence 7_EX:6889:10387: scene=7_EX
#: 7_EX:6889
msgctxt "text_id=10387 | speaker=unknown"
msgid "　いけないんじゃないかな？　と首をかしげる草十郎。"
msgstr "  Soujyuro said earnestly as he tilted his head."

#. Occurrence 7_EX:6894:10388: scene=7_EX
#: 7_EX:6894
msgctxt "text_id=10388 | speaker=unknown"
msgid "　やや弱気なのは、以前と比べて有珠への興味が高まっているせいだ。"
msgstr "  The reason for his unease was also due to the fact that he had grown more interested in Alice than before."

#. Occurrence 7_EX:6899:10389: scene=7_EX
#: 7_EX:6899
msgctxt "text_id=10389 | speaker=unknown"
msgid "　人畜無害な顔をして、彼も健康な青年男子であるらしい。"
msgstr "  Despite his detached and passive attitude, he was still a young man like any other, after all."

#. Occurrence 7_EX:6941:10390: voice_id=BA0_7_EX_0016; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6941
msgctxt "text_id=10390 | speaker=unknown"
msgid "『イエス、それはそうッスね。"
msgstr "\"And right you'd be, lad."

#. Occurrence 7_EX:6947:10391: voice_id=BA0_7_EX_0017; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6947
msgctxt "text_id=10391 | speaker=unknown"
msgid "　おまえ、シャバ僧のわりにいいコト言うッス。人の<過去話|カコバナ>とかみだりにしちゃいけないッス。"
msgstr "  You know, you make sum sense for a feral human. You're right, I shouldn't go blabbin' about people's pasts."

#. Occurrence 7_EX:6953:10392: voice_id=BA0_7_EX_0018; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:6953
msgctxt "text_id=10392 | speaker=unknown"
msgid "　―――ところでアリスさんの子供時代の話とかしていいっスか？　ジブン、シャバ僧の知らないアリスさんを<赤裸々|せきらら>にアピールして、精神的上位に立ちたいッス』"
msgstr "  But maybe you'd 'ike to hear about her childhood! How 'bout it, lad? I'd love to lay bare some of her deepest, darkest secrets for ya. It'd make me feel like a heap 'o dosh!\""

#. Occurrence 7_EX:6964:10393: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0049; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:6964
msgctxt "text_id=10393 | speaker=soujuurou"
msgid "「あ、いや、だからそういう話は」"
msgstr "\"Err... I just said I don't want to-\""

#. Occurrence 7_EX:7010:10394: voice_id=BA0_7_EX_0019; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7010
msgctxt "text_id=10394 | speaker=unknown"
msgid "『安心しろっス、アリスさんには黙っておいてやるっスから。"
msgstr "\"Lighten up, lad. I won't tell Alice about our little rabbit and pork."

#. Occurrence 7_EX:7017:10395: voice_id=BA0_7_EX_0020; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7017
msgctxt "text_id=10395 | speaker=unknown"
msgid "まずはアレすね、ジブンとアリスさんが初めて出会った時のメモリーを聞くっスよ。アリスさんああ見えて友達一人しかいなかったッスから、もっぱらジブンが話し相手っつーか。"
msgstr "Let me start with the day we first met. Despite 'er looks she didn't have so much as a single friend in the world, ya see. I was the only one that mother 'o pearl had to talk to."

#. Occurrence 7_EX:7023:10396: voice_id=BA0_7_EX_0021; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7023
msgctxt "text_id=10396 | speaker=unknown"
msgid "　ほら、壁相手にカコンカコーンってピンポン玉打ち返すゲーム。あんな感じっス。アリスさんのメモリーはおよそ十四年分。じゃあ一年目から行くッスよ』"
msgstr "  Imagine playin' that game where you bounce a ball against a wall by your lonesome. It was just like that. Fourteen years of memories with her, I have. So lemme start at the beginning...\""

#. Occurrence 7_EX:7049:10397: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0050; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:7049
msgctxt "text_id=10397 | speaker=soujuurou"
msgid "「あ、いや、だから」"
msgstr "\"I just said-\""

#. Occurrence 7_EX:7075:10398: voice_id=BA0_7_EX_0022; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7075
msgctxt "text_id=10398 | speaker=unknown"
msgid "『行くッスよー！"
msgstr "\"Here we go!"

#. Occurrence 7_EX:7081:10399: voice_id=BA0_7_EX_0023; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7081
msgctxt "text_id=10399 | speaker=unknown"
msgid "　もう誰もジブンを止められないッスー！』"
msgstr "  Buckle in 'cause this is gonna get good!\""

#. Occurrence 7_EX:7115:10400: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0051; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:7115
msgctxt "text_id=10400 | speaker=soujuurou"
msgid "「――――――っ」"
msgstr "\"...\""

#. Occurrence 7_EX:7121:10401: scene=7_EX
#: 7_EX:7121
msgctxt "text_id=10401 | speaker=unknown"
msgid "　この鳥は、まずい。"
msgstr "  This bird was trouble."

#. Occurrence 7_EX:7126:10402: scene=7_EX
#: 7_EX:7126
msgctxt "text_id=10402 | speaker=unknown"
msgid "　<鳥頭|とりあたま>にも程がある。"
msgstr "  The word \"bird-brained\" had taken on a whole new meaning to Soujyuro."

#. Occurrence 7_EX:7131:10403: scene=7_EX
#: 7_EX:7131
msgctxt "text_id=10403 | speaker=unknown"
msgid "　加えて、このまま話を聞いていたら取り返しのつかないコトになる、と察する草十郎だった。"
msgstr "  If he were stuck here listening any longer, he had the feeling he might hear something he would not be able to unhear."

#. Occurrence 7_EX:7164:10404: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0052; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:7164
msgctxt "text_id=10404 | speaker=soujuurou"
msgid "「すまない。そろそろいいかな」"
msgstr "\"Sorry, but I should really get going.\""

#. Occurrence 7_EX:7172:10405: scene=7_EX
#: 7_EX:7172
msgctxt "text_id=10405 | speaker=unknown"
msgid "　草十郎は手をあげて、じゃあ、と三階の屋根裏部屋への逃走を試みた。"
msgstr "  With a wave of his hand he attempted to flee to the attic above the second floor."

#. Occurrence 7_EX:7207:10406: voice_id=BA0_7_EX_0024; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7207
msgctxt "text_id=10406 | speaker=unknown"
msgid "『ちょっ、待つッスーーー！　ここからがいいところなのにナンデ去るっスか。スカーレットオハラっすか。激動の主人公気取りっスか！"
msgstr "\"Now wait just one minute, boy! You're about to miss the best part! Who do you think you are, Scarlet O'Hara? You think you're the most important character in this war?!"

#. Occurrence 7_EX:7218:10407: voice_id=BA0_7_EX_0025; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7218
msgctxt "text_id=10407 | speaker=unknown"
msgid "　そのあたりジブン、なんか納得いかないッス。まだうちに入ったばかりの新参ものが、なんでアリスさんの視線をひとりじめしてるっスか？　許せないスけど、その秘訣を教えてほしいっス。<切実|せつじつ>に。ジブン、本気だしたら凄いッスよ』"
msgstr "  You're not foolin' me, that's for sure. What's a saucepan and lid like you gettin' all Angel Mum's attention? Why, you're all she looks at. I can't stand it! So you'd better tell me your secret! I'm serious, and you ne'er wanna see me get serious!\""

#. Occurrence 7_EX:7252:10408: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0053; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:7252
msgctxt "text_id=10408 | speaker=soujuurou"
msgid "「なに？」"
msgstr "\"What?\""

#. Occurrence 7_EX:7259:10409: scene=7_EX
#: 7_EX:7259
msgctxt "text_id=10409 | speaker=unknown"
msgid "　もう半分ほど登っていた階段から、草十郎はトコトコと舞い戻る。"
msgstr "  Halfway up the stairs already, Soujyuro quickly retraced his steps."

#. Occurrence 7_EX:7270:10410: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0054; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:7270
msgctxt "text_id=10410 | speaker=soujuurou"
msgid "「君。いまのはどういう？」"
msgstr "\"What did you just say?\""

#. Occurrence 7_EX:7304:10411: voice_id=BA0_7_EX_0026; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7304
msgctxt "text_id=10411 | speaker=unknown"
msgid "『だからアリスさん、スキあらばオマエを見てるッス。"
msgstr "\"That whenever Angel Mum has a moment to spare, she starts watchin' you like a hawk, that's what!"

#. Occurrence 7_EX:7310:10412: voice_id=BA0_7_EX_0027; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7310
msgctxt "text_id=10412 | speaker=unknown"
msgid "　思い出したッスよ、そもそもジブン、熱視線でサーチされてるからってつけあがるなと釘刺しにきたんス。"
msgstr "  And now I remember why I wanted to talk to you! I wanted to make sure you don't go gettin' any big ideas just 'cause she's looking you over with that burning look in her mince pies!"

#. Occurrence 7_EX:7321:10413: voice_id=BA0_7_EX_0028; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7321
msgctxt "text_id=10413 | speaker=unknown"
msgid "　だいたい草の字は何度もジブンに助けられてるッス。"
msgstr "  I've already saved you more times than you know, Mr. Sono-G."

#. Occurrence 7_EX:7327:10414: voice_id=BA0_7_EX_0029; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7327
msgctxt "text_id=10414 | speaker=unknown"
msgid "　アリスさんの命令がなかったら、今ごろ草の字、鏡の中でおだぶつっス。コレなんスかね。人間の感情とかわかんないっスけど、魚へんに里とか描くっスかね？』"
msgstr "  If it wasn't for Miss Alice's orders you'd be stuck in some old mirror, you know. What's really going on? Is this that crazy rubber and glove that you humans get all Moby Dick over?\""

#. Occurrence 7_EX:7393:10415: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0055; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:7393
msgctxt "text_id=10415 | speaker=soujuurou"
msgid "「助けられてるって、俺が？」"
msgstr "\"...You're saying she saved me? Alice? Saved me?\""

#. Occurrence 7_EX:7400:10416: voice_id=BA0_7_EX_0030; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7400
msgctxt "text_id=10416 | speaker=unknown"
msgid "『まあ、殺そうとしてるのもアリスさんっスけどね！"
msgstr "\"Yeah, well, she's also the one tryin' to kill you, but come off it!"

#. Occurrence 7_EX:7407:10417: voice_id=BA0_7_EX_0031_0; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7407
msgctxt "text_id=10417 | speaker=unknown"
msgid "　アリスさんはこう言ったっス。彼が鏡の中に迷いこみそうになったら助けてあげて、危険なモノには近寄らないように誘導もしてあげて、ええ、でも思い上がらないコトねシズキクン、別にアンタのコトが心配なワケ"
msgstr "  Here's what she told me. She said to save you if you ever were about to get lost in the mirror or got too close to somefin dangerous... but don't go gettin' no big 'ead, you hear me? It's not like anyone cares what happens to yo-"

#. Occurrence 7_EX:7422:10418: voice_id=BA0_7_EX_0031_1; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7422
msgctxt "text_id=10418 | speaker=unknown"
msgid "じゃぶきゃっ！？』"
msgstr "GYARGH!\""

#. Occurrence 7_EX:7442:10419: scene=7_EX
#: 7_EX:7442
msgctxt "text_id=10419 | speaker=unknown"
msgid "　一瞬の早技だった。"
msgstr "  It happened in a flash."

#. Occurrence 7_EX:7447:10420: scene=7_EX
#: 7_EX:7447
msgctxt "text_id=10420 | speaker=unknown"
msgid "　突如ロビーにやってきた有珠は、一瞬の<躊躇|ちゅうちょ>もなく受話器台の駒鳥を片手で粉砕した。"
msgstr "  With a swift, unhesitating strike of her hand, Alice squashed the bird right then and there as it sat on the telephone receiver stand in the foyer."

#. Occurrence 7_EX:7452:10421: scene=7_EX
#: 7_EX:7452
msgctxt "text_id=10421 | speaker=unknown"
msgid "　もとい、片手で押さえつけた。"
msgstr "  Her pressed palm continued to pin it down."

#. Occurrence 7_EX:7472:10422: scene=7_EX
#: 7_EX:7472
msgctxt "text_id=10422 | speaker=unknown"
msgid "　青い鳥はぶにゃ、と潰されたカラーボールのように変形しながら、"
msgstr "  The bird's crushed form resembled a bright rubber ball, like what a child might play with."

#. Occurrence 7_EX:7483:10423: voice_id=BA0_7_EX_0032; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7483
msgctxt "text_id=10423 | speaker=unknown"
msgid "『ちょっ、アリスさん暗いッスー！"
msgstr "\"Hey! What's the big idea, Miss Alice!"

#. Occurrence 7_EX:7489:10424: voice_id=BA0_7_EX_0033; voice_prefix=BA0; voice_category=0; scene=7_EX
#: 7_EX:7489
msgctxt "text_id=10424 | speaker=unknown"
msgid "　そして痛い、体中の血液がくちばしからこう、右方向に流れていく感覚とかー！』"
msgstr "  You're killin' me! I can feel all the blood in my body gushing out me beak!\""

#. Occurrence 7_EX:7495:10425: scene=7_EX
#: 7_EX:7495
msgctxt "text_id=10425 | speaker=unknown"
msgid "　たくましい鳴き声をあげている。"
msgstr "  The bird raised a mighty uproar."

#. Occurrence 7_EX:7550:10426: scene=7_EX
#: 7_EX:7550
msgctxt "text_id=10426 | speaker=unknown"
msgid "「…………"
msgstr "\"..."

#. Occurrence 7_EX:7558:10427: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_7_EX_0002; voice_prefix=A40; voice_category=2; scene=7_EX
#: 7_EX:7558
msgctxt "text_id=10427 | speaker=alice"
msgid "コレの言うことは、気にしないで」"
msgstr "...Ignore everything the bird says.\""

#. Occurrence 7_EX:7580:10428: scene=7_EX
#: 7_EX:7580
msgctxt "text_id=10428 | speaker=unknown"
msgid "　駒鳥を回収し、居間に去っていく有珠。"
msgstr "  Alice returned to the drawing room, taking the bird with her."

#. Occurrence 7_EX:7585:10429: scene=7_EX
#: 7_EX:7585
msgctxt "text_id=10429 | speaker=unknown"
msgid "　その後ろ姿は駒鳥とは正反対の、暗い<翳|かげ>りを帯びている。"
msgstr "  Her dark silhouette cloaked in shadow was the complete opposite of the gaudy little bird."

#. Occurrence 7_EX:7618:10430: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0056; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:7618
msgctxt "text_id=10430 | speaker=soujuurou"
msgid "「…………」"
msgstr "\"...\""

#. Occurrence 7_EX:7623:10431: scene=7_EX
#: 7_EX:7623
msgctxt "text_id=10431 | speaker=unknown"
msgid "　草十郎は困った顔のまま腕を組んで、"
msgstr "  Soujyuro folded his arms as he stood alone, no less confused than before, and whispered,"

#. Occurrence 7_EX:7634:10432: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_7_EX_0057; voice_prefix=A30; voice_category=3; scene=7_EX
#: 7_EX:7634
msgctxt "text_id=10432 | speaker=soujuurou"
msgid "「こうして、ますます疑問は増えていくのだった」"
msgstr "\"Things get stranger by the day around here,\""

#. Occurrence 7_EX:7640:10433: scene=7_EX
#: 7_EX:7640
msgctxt "text_id=10433 | speaker=unknown"
msgid "　ひとり、天窓から<覗|のぞ>く夜空に呟いた。"
msgstr "  up at the night sky visible through the skylight."

#. Occurrence 8_1:54:10434: scene=8_1
#: 8_1:54
msgctxt "text_id=10434 | speaker=unknown"
msgid "　三咲高校の冬休みは十二月の中旬から始まる。"
msgstr "  Misaki High School's winter vacation began in mid-December."

#. Occurrence 8_1:61:10435: scene=8_1
#: 8_1:61
msgctxt "text_id=10435 | speaker=unknown"
msgid "　全国に名を馳せる運動部もなく、熱心な進学校でもない学校の静けさは清潔感すらある。"
msgstr "  The tranquil air of the school was a refreshing change of pace from the more competitive schools and their nationally famous sports teams and exam-oriented curriculum."

#. Occurrence 8_1:66:10436: scene=8_1
#: 8_1:66
msgctxt "text_id=10436 | speaker=unknown"
msgid "　<人気|ひとけ>の<絶|た>えた新築の建物は、冬の湖に舞い下りた白鳥を思わせる。"
msgstr "  The empty, newly constructed building evoked images of a pure white swan descending upon a still winter lake."

#. Occurrence 8_1:71:10437: scene=8_1
#: 8_1:71
msgctxt "text_id=10437 | speaker=unknown"
msgid "　近代化の進んだ校舎は、その血液である生徒を<欠|か>いても在り方を損なわず、粛々と<佇|たたず>んでいる。"
msgstr "  The modern school building felt alive in its stillness, in spite of the absence of its lifeblood of students."

#. Occurrence 8_1:92:10438: scene=8_1
#: 8_1:92
msgctxt "text_id=10438 | speaker=unknown"
msgid "　だが、生徒の多くはその前身を知らない。"
msgstr "  Most students never knew what this building used to look like."

#. Occurrence 8_1:97:10439: scene=8_1
#: 8_1:97
msgctxt "text_id=10439 | speaker=unknown"
msgid "　今の姿とは比べようのない、木造の小さな<学舎|まなびや>。"
msgstr "  It was just a small, rundown wooden building, a shadow of its former self."

#. Occurrence 8_1:102:10440: scene=8_1
#: 8_1:102
msgctxt "text_id=10440 | speaker=unknown"
msgid "　その旧校舎は取り壊される事もなく、今でも<鎮|しず>かに眠っている。"
msgstr "  The former school was never torn down and now stood in lonely silence."

#. Occurrence 8_1:107:10441: scene=8_1
#: 8_1:107
msgctxt "text_id=10441 | speaker=unknown"
msgid "　裏山に<延々|えんえん>と続く森のただ中に、ひっそりとその身を隠すように。"
msgstr "  It was tucked away deep in a seemingly infinite wood that stretched across the mountains."

#. Occurrence 8_1:143:10442: scene=8_1
#: 8_1:143
msgctxt "text_id=10442 | speaker=unknown"
msgid "　枯葉を<掃|は>く竹ぼうきの音が響く。"
msgstr "  The sound of brooms sweeping dead leaves resonated in the air."

#. Occurrence 8_1:148:10443: scene=8_1
#: 8_1:148
msgctxt "text_id=10443 | speaker=unknown"
msgid "　裏山に枯れ落ちた葉は、砂浜に打ち寄せる波のようだ。掃いても掃いてもきりがない。"
msgstr "  The ocean of leaves had accumulated into piles as big as sand dunes; sweeping was a futile venture at this point."

#. Occurrence 8_1:153:10444: scene=8_1
#: 8_1:153
msgctxt "text_id=10444 | speaker=unknown"
msgid "　なにしろ二年間以上放置された魔境である。"
msgstr "  An ominous feeling lingered in the air, perhaps the result of two years of abandonment."

#. Occurrence 8_1:158:10445: scene=8_1
#: 8_1:158
msgctxt "text_id=10445 | speaker=unknown"
msgid "　仮に校内あげての清掃を始めたところで、一日二日でどうにかなるものではない。"
msgstr "  Cleaning the inside of the building alone would take more than a few days to finish."

#. Occurrence 8_1:163:10446: scene=8_1
#: 8_1:163
msgctxt "text_id=10446 | speaker=unknown"
msgid "　<況|いわ>んや、"
msgstr "  Not to mention,"

#. Occurrence 8_1:197:10447: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0000; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:197
msgctxt "text_id=10447 | speaker=kinomi"
msgid "「あー、ほんとだりぃー、存在価値がみいだせねぇー。"
msgstr "\"Ugh, this SUCKS! We're students, dammit! Not machines!"

#. Occurrence 8_1:203:10448: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0001; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:203
msgctxt "text_id=10448 | speaker=kinomi"
msgid "　バッカじゃねえの、冬休みは短いってのに、なんでこんな事やらせんだよ生徒会は」"
msgstr "  We barely get any winter break and then the student council has us out here doing this crap?\""

#. Occurrence 8_1:216:10449: scene=8_1
#: 8_1:216
msgctxt "text_id=10449 | speaker=unknown"
msgid "　その参加者がこのような<不心得|ふこころえ><者|もの>では、裏山の美化など望むべくもないのだった。"
msgstr "  The misguided youth sent here for the job wasted no time making it clear he wanted no part in the beautification efforts."

#. Occurrence 8_1:246:10450: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0002; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:246
msgctxt "text_id=10450 | speaker=kinomi"
msgid "「っていうかジャージでやらせんなよ、ジャンパーぐらい着させろよなー。"
msgstr "\"At least let us wear a jacket or something! It's freezing out here!"

#. Occurrence 8_1:253:10451: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0003; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:253
msgctxt "text_id=10451 | speaker=kinomi"
msgid "なにこれ、もしかして体育の補習？　寒中マラソン？　オレ体育だけはサボったコトねぇんスけどねー！」"
msgstr "Is this part of gym class or something? Winter marathon training? And I'm saying this as someone who NEVER skips gym class!\""

#. Occurrence 8_1:259:10452: scene=8_1
#: 8_1:259
msgctxt "text_id=10452 | speaker=unknown"
msgid "　なげやりに竹ぼうきをブンブンと振り回し、<罵詈|ばり><雑言|ぞうごん>をまき散らす<木乃美|きのみ><芳助|ほうすけ>。"
msgstr "  Housuke Kinomi continued to mumble and grumble to himself as he reluctantly swept away at the ground."

#. Occurrence 8_1:276:10453: scene=8_1
#: 8_1:276
msgctxt "text_id=10453 | speaker=unknown"
msgid "　それを横目にしながら、草十郎は無言でざっざっと竹ぼうきを動かしていた。"
msgstr "  Meanwhile, Soujyuro silently and swiftly continued his sweeping, glaring at Kinomi out of the corner of his eye."

#. Occurrence 8_1:310:10454: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0004; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:310
msgctxt "text_id=10454 | speaker=kinomi"
msgid "「おい、なに真面目にやってんだよ。こんなの適当でいいんだって。だいたい四十人しかいねえのに、こんな山みたいな庭の掃除なんか終わるかってんだ」"
msgstr "\"Are you seriously trying to clean up all this for real? There's only, like, forty of us out here. There's no way we're going to get all this cleaned up, so who cares?\""

#. Occurrence 8_1:316:10455: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0000; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:316
msgctxt "text_id=10455 | speaker=soujuurou"
msgid "「終わらない事なんてない。少しうるさいぞ、木乃美は」"
msgstr "\"Anything can be completed with diligence, Kinomi. Stop complaining so hard.\""

#. Occurrence 8_1:324:10456: scene=8_1
#: 8_1:324
msgctxt "text_id=10456 | speaker=unknown"
msgid "　振り向きもせず<窘|たしな>める草十郎に、木乃美はますます詰まらなそうに竹ぼうきを振り回した。"
msgstr "  Kinomi went back to idly swinging his broom without even glancing over at Soujyuro."

#. Occurrence 8_1:354:10457: scene=8_1
#: 8_1:354
msgctxt "text_id=10457 | speaker=unknown"
msgid "　朝の裏山は寒い。"
msgstr "  Mornings on the mountain were cold."

#. Occurrence 8_1:359:10458: scene=8_1
#: 8_1:359
msgctxt "text_id=10458 | speaker=unknown"
msgid "　曇った空には太陽の影もなく、灰色の光が裏庭を照らしていた。真冬の見本みたいな寒さは、軍手ごしにも手をかじかませる。"
msgstr "  There was no hint of sun in the cloudy sky above; ash-gray light illuminated the rear courtyard; the sharp cold of mid-winter pierced through everyone's gloves as if they did not exist."

#. Occurrence 8_1:364:10459: scene=8_1
#: 8_1:364
msgctxt "text_id=10459 | speaker=unknown"
msgid "　こんな日は部屋でぬくんでいるべきなのに、何の因果か、彼らは裏山の掃除なんてやっていた。"
msgstr "  A day like this was best spent indoors under warm blankets, but for some reason they were out here cleaning."

#. Occurrence 8_1:384:10460: scene=8_1
#: 8_1:384
msgctxt "text_id=10460 | speaker=unknown"
msgid "　冬期特別清掃班。"
msgstr "  The Special Winter Cleaning Team."

#. Occurrence 8_1:404:10461: scene=8_1
#: 8_1:404
msgctxt "text_id=10461 | speaker=unknown"
msgid "　それは、いいかげん荒れ放題の裏山をどうにかしようと集結した有志たちによる、決死隊の呼称である。"
msgstr "  That was the name given to this elite force sent to clean up this dilapidated, overgrown mountain."

#. Occurrence 8_1:409:10462: scene=8_1
#: 8_1:409
msgctxt "text_id=10462 | speaker=unknown"
msgid "　一般生徒は彼らを美化という名の神に信心を捧げた、鋼のお掃除部隊と思うだろう。"
msgstr "  The other students had put their faith into this team to fulfill this beautification mission, respecting them for their sacrifice."

#. Occurrence 8_1:429:10463: scene=8_1
#: 8_1:429
msgctxt "text_id=10463 | speaker=unknown"
msgid "　しかし、その実態は期末試験の補習の一貫として用意された、ただの罰ゲーム部隊だった。"
msgstr "  The reality, however, was that this was nothing more than a ragtag dare-losing gang of students needing remedial lessons before their exams."

#. Occurrence 8_1:434:10464: scene=8_1
#: 8_1:434
msgctxt "text_id=10464 | speaker=unknown"
msgid "　今年度の生徒会が力技で実行した、一年計画の犠牲者である。"
msgstr "  They were the victims of a year-long arm-twisting scheme by the student council."

#. Occurrence 8_1:467:10465: scene=8_1
#: 8_1:467
msgctxt "text_id=10465 | speaker=unknown"
msgid "　そろそろ雪が降ってもおかしくないこの季節に、誰が好き好んで枯葉拾いなぞやるものか。"
msgstr "  Who in their right mind would come out here to sweep up leaves with a blizzard looming on the horizon?"

#. Occurrence 8_1:472:10466: scene=8_1
#: 8_1:472
msgctxt "text_id=10466 | speaker=unknown"
msgid "　結局集まった四十人のうち一人を除いて、有志でもなんでもなかったりする。"
msgstr "  Other than one of the forty assembled, none of them had any semblance of interest in the task at hand."

#. Occurrence 8_1:506:10467: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0005; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:506
msgctxt "text_id=10467 | speaker=kinomi"
msgid "「げ。おい見ろよ<静希|しずき>。<赤羽|あかばね>たち、向こうで焼き芋とかレトロなマネしてやがる！"
msgstr "\"Hey, Sizuki, look over there. Akabane and those guys are over there roasting sweet potatoes! What is this, the 50s or something?!"

#. Occurrence 8_1:522:10468: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0006; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:522
msgctxt "text_id=10468 | speaker=kinomi"
msgid "　んが、二番煎じはいかにもあたま悪いしな。そうだ、オレたちはイカでも焼かねぇ？」"
msgstr "  Looks like they don't even know how to roast them properly. Oh, I know! Wanna grill some squid?\""

#. Occurrence 8_1:542:10469: scene=8_1
#: 8_1:542
msgctxt "text_id=10469 | speaker=unknown"
msgid "　もとより掃除をする気のない木乃美はしきりに草十郎を懐柔しようとしていた。"
msgstr "  Kinomi did not want to be here to begin with, and was constantly trying to break Soujyuro into joining him."

#. Occurrence 8_1:559:10470: scene=8_1
#: 8_1:559
msgctxt "text_id=10470 | speaker=unknown"
msgid "　清掃班はグループに分けられており、草十郎と木乃美は体育館裏の担当だ。"
msgstr "  The cleaning squad was divided into groups. Soujyuro and Kinomi were in charge of cleaning behind the gymnasium."

#. Occurrence 8_1:564:10471: scene=8_1
#: 8_1:564
msgctxt "text_id=10471 | speaker=unknown"
msgid "　リーダーは草十郎で、一般兵士は木乃美である。"
msgstr "  Soujyuro was the leader of the platoon. Kinomi was the grunt."

#. Occurrence 8_1:588:10472: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0001; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:588
msgctxt "text_id=10472 | speaker=soujuurou"
msgid "「ああ。こことあっちの垣根をきれいにしたら、焼き芋だろうと焼きイカだろうとネコ鍋だろうと好きにしよう。その頃にはちょうどお昼だ」"
msgstr "\"Look, when we finish cleaning up around this fence you can go off and eat your sweet potato or squid or whatever it is you want because it'll be lunch time.\""

#. Occurrence 8_1:609:10473: scene=8_1
#: 8_1:609
msgctxt "text_id=10473 | speaker=unknown"
msgid "　草十郎は慣れた手つきで、かき集めた枯葉をビニールのゴミ袋に詰めていく。"
msgstr "  Soujyuro said, as he expertly packed his swept leaves into trash bags."

#. Occurrence 8_1:618:10474: scene=8_1
#: 8_1:618
msgctxt "text_id=10474 | speaker=unknown"
msgid "　うっすらと霧が立ち籠める朝七時から集まって、すでに二時間。"
msgstr "  Two hours had passed since they assembled on this foggy morning at seven o'clock."

#. Occurrence 8_1:623:10475: scene=8_1
#: 8_1:623
msgctxt "text_id=10475 | speaker=unknown"
msgid "　誰もが<音|ね>を上げてだらけ始めている中、草十郎は開始時と同じペースで黙々と働いていた。"
msgstr "  While everyone else chatted and laughed as they worked, Soujyuro alone had worked in complete silence at the same blistering pace since he started."

#. Occurrence 8_1:628:10476: scene=8_1
#: 8_1:628
msgctxt "text_id=10476 | speaker=unknown"
msgid "　掃除用に着替えたジャージはえらく寒いのに、泣き言一つないのは運動量の多さ故だろう。"
msgstr "  The sheer amount of work he put in was likely the only thing keeping him from complaining of the cold in his thin jersey."

#. Occurrence 8_1:661:10477: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0007; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:661
msgctxt "text_id=10477 | speaker=kinomi"
msgid "「なー、やめようぜ。みろ、そこの池……スケートリンク……？　いや、やっぱ池……？"
msgstr "\"Come on, let's take a break. Look at that pond...or should I say ice skating rink? No, on second thought, it's just a pond."

#. Occurrence 8_1:668:10478: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0008; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:668
msgctxt "text_id=10478 | speaker=kinomi"
msgid "　とにかく、そこの池らしきモノだってカチカチに凍ってるぐらいなんだぜ？"
msgstr "  But it's frozen solid, dude! That's how cold it is out here!"

#. Occurrence 8_1:674:10479: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0009; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:674
msgctxt "text_id=10479 | speaker=kinomi"
msgid "　こんな雪原じゃ人体はフツー動かねえよ、機械伯爵でもなきゃだよ、そろそろ人間狩りがはじまるよー」"
msgstr "  A normal human can't work in these snowy conditions unless they're some kind of robot. We're going to have to start eating each other to survive if this keeps up!\""

#. Occurrence 8_1:716:10480: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0010; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:716
msgctxt "text_id=10480 | speaker=kinomi"
msgid "「なんで、いいかげん休憩しねえ？"
msgstr "\"Why won't you just take a break for a minute?"

#. Occurrence 8_1:722:10481: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0011; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:722
msgctxt "text_id=10481 | speaker=kinomi"
msgid "　せっかく枯葉集めたんだから、燃やして暖まんないとさー。どうせ監視役は殿下しかいないんだしさー。な、焼きイカやろうぜ、焼きイカー」"
msgstr "  We got all these leaves together, why don't we burn 'em and get warmed up! Nobody's really watching, come on let's grill some squiiid! Pleeeeeease!\""

#. Occurrence 8_1:742:10482: scene=8_1
#: 8_1:742
msgctxt "text_id=10482 | speaker=unknown"
msgid "　イカに思い入れがあるのか、木乃美はしつこく主張する。"
msgstr "  For some reason, Kinomi was droning on about his squid."

#. Occurrence 8_1:747:10483: scene=8_1
#: 8_1:747
msgctxt "text_id=10483 | speaker=unknown"
msgid "　相棒の泣き言を黙って受けとめていた草十郎だが、それもそろそろ限界らしかった。"
msgstr "  Soujyuro had managed to withstand the barrage of complaints from his comrade, but even he was reaching his limit."

#. Occurrence 8_1:775:10484: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0002; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:775
msgctxt "text_id=10484 | speaker=soujuurou"
msgid "「木乃美、頼むから……」"
msgstr "\"Kinomi, please...\""

#. Occurrence 8_1:817:10485: scene=8_1
#: 8_1:817
msgctxt "text_id=10485 | speaker=unknown"
msgid "　その時、草十郎は相棒の背後に死神の姿を認めた。"
msgstr "  Just then, Soujyuro saw the Grim Reaper himself creeping behind Kinomi."

#. Occurrence 8_1:822:10486: scene=8_1
#: 8_1:822
msgctxt "text_id=10486 | speaker=unknown"
msgid "　手に持っている物が竹ぼうきではなくクマデなのがまたらしい。"
msgstr "  In his hands he held a rake instead of a soft bamboo broom."

#. Occurrence 8_1:848:10487: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0000; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:848
msgctxt "text_id=10487 | speaker=tobimaru"
msgid "「いいぜ。おまえがイカなんてモンを用意してるほどの大人物だってんなら、<謹|つつし>んでイカ焼きぐらい許可してやるよ。なんなら醤油はこっちで用意してやろう」"
msgstr "\"Sounds good to me. I'll let a bit of grilled squid slide. Far be it for me to get between the big man and his squid. I tell you what, I'll even get you the soy sauce.\""

#. Occurrence 8_1:867:10488: scene=8_1
#: 8_1:867
msgctxt "text_id=10488 | speaker=unknown"
msgid "　背中からの声に、木乃美はびくり、と背筋を伸ばし、"
msgstr "  Kinomi shot to attention at the voice behind him."

#. Occurrence 8_1:873:10489: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0012; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:873
msgctxt "text_id=10489 | speaker=kinomi"
msgid "「ひゃあ！　その物言い、槻司<某|なにがし>―――！」"
msgstr "\"Ahhh! Tsukiji, is that you?!\""

#. Occurrence 8_1:879:10490: scene=8_1
#: 8_1:879
msgctxt "text_id=10490 | speaker=unknown"
msgid "　時代劇めいた台詞を吐いて、振り向きざまに竹ぼうきを振るう。"
msgstr "  Before quickly turning around, swinging his broom in the process."

#. Occurrence 8_1:887:10491: scene=8_1
#: 8_1:887
msgctxt "text_id=10491 | speaker=unknown"
msgid "　それを鳶丸はクマデでがっしりと受けとめた。"
msgstr "  Tobimaru easily blocked the swing with his rake."

#. Occurrence 8_1:913:10492: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0001; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:913
msgctxt "text_id=10492 | speaker=tobimaru"
msgid "「ああ？　テメエ、やる気十分じゃねえか。あふれる労働意欲を抑えきれないってワケか？　なんなら<特別|シベリア>コースにでも行っちまうか？」"
msgstr "\"Oh, so NOW you wanna use that broom, huh? Just can't contain all that hard-working spirit, I see. Maybe I should assign you to the special Siberian trail, then!\""

#. Occurrence 8_1:931:10493: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0013; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:931
msgctxt "text_id=10493 | speaker=kinomi"
msgid "「はん。女ども集めて焼却炉に陣どってる野郎の言葉なんざ聞かねえよ。真冬に南国気分とかマジ寒いわ」"
msgstr "\"Hah. All you've done is stand over by the furnace with the girls pretending like you're on a Caribbean holiday instead of out here in the freezing cold.\""

#. Occurrence 8_1:970:10494: scene=8_1
#: 8_1:970
msgctxt "text_id=10494 | speaker=unknown"
msgid "　竹ぼうきとクマデを交差させて、ふたりは不敵な笑みを浮かべている。"
msgstr "  Both boys glared at each other with a wry smile, broom and rake locked in an embrace."

#. Occurrence 8_1:975:10495: scene=8_1
#: 8_1:975
msgctxt "text_id=10495 | speaker=unknown"
msgid "　これでも学園内限定で仲のいいコンビだった。"
msgstr "  These two were only friendly with each other on school grounds."

#. Occurrence 8_1:1020:10496: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0003; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1020
msgctxt "text_id=10496 | speaker=soujuurou"
msgid "「鳶丸。いちおう、彼は戦力なんだから邪魔しないでくれ」"
msgstr "\"Tobimaru, please don't distract him any more than he already is.\""

#. Occurrence 8_1:1026:10497: scene=8_1
#: 8_1:1026
msgctxt "text_id=10497 | speaker=unknown"
msgid "　チ、と心底忌々しそうに舌打ちし、矛を納める両者。"
msgstr "  Both of them scoffed angrily and put away their weapons."

#. Occurrence 8_1:1031:10498: scene=8_1
#: 8_1:1031
msgctxt "text_id=10498 | speaker=unknown"
msgid "　なんというか、ゴミ袋片手に、俗世のコトなど関心ありません、と掃除をする草十郎の<言|げん>には逆らえない。"
msgstr "  They both knew better than to argue with Soujyuro, the only one cleaning with a garbage bag in hand."

#. Occurrence 8_1:1068:10499: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0004; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1068
msgctxt "text_id=10499 | speaker=soujuurou"
msgid "「それで、何しに来たんだ鳶丸。"
msgstr "\"Something we can help you with, Tobimaru?"

#. Occurrence 8_1:1074:10500: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0005; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1074
msgctxt "text_id=10500 | speaker=soujuurou"
msgid "　君はあったかい焼却炉の前で、永遠に火の管理をすると豪語していたんじゃなかったっけ？」"
msgstr "  I thought you were too busy pretending to tend the fire over at the furnace.\""

#. Occurrence 8_1:1080:10501: scene=8_1
#: 8_1:1080
msgctxt "text_id=10501 | speaker=unknown"
msgid "　もとい。"
msgstr "  A harsh comment."

#. Occurrence 8_1:1085:10502: scene=8_1
#: 8_1:1085
msgctxt "text_id=10502 | speaker=unknown"
msgid "　この男も、多少は俗世に関心があったらしい。"
msgstr "  Apparently even Soujyuro had a slight taste for drama."

#. Occurrence 8_1:1118:10503: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0002; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1118
msgctxt "text_id=10503 | speaker=tobimaru"
msgid "「なんてこった……善良な生徒ですら、俺をそんな目で見るのか……」"
msgstr "\"So it's come to this. Even the upstanding students like you are looking down on me now.\""

#. Occurrence 8_1:1124:10504: scene=8_1
#: 8_1:1124
msgctxt "text_id=10504 | speaker=unknown"
msgid "　悲しそうに鳶丸は言う。"
msgstr "  Tobimaru seemed sad at Soujyuro's observation."

#. Occurrence 8_1:1129:10505: scene=8_1
#: 8_1:1129
msgctxt "text_id=10505 | speaker=unknown"
msgid "　が、集められた落ち葉を燃やして<暖|だん>を取りながら、女子の清掃班を手伝いと称してはべらせている以上、かける情けは落ち葉一枚分もないのである。"
msgstr "  But as long as Tobimaru continued to claim he was helping the girls clean by doing nothing more than standing in front of a pile of burning leaves, Soujyuro found it hard to sympathize."

#. Occurrence 8_1:1165:10506: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0014; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:1165
msgctxt "text_id=10506 | speaker=kinomi"
msgid "「いいから用件を言えよ。殿下と違ってオレらはヒマじゃねえんだ」"
msgstr "\"Just tell us what you want. We're actually busy doing work over here, unlike some people.\""

#. Occurrence 8_1:1181:10507: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0003; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1181
msgctxt "text_id=10507 | speaker=tobimaru"
msgid "「ああそうかよ。草十郎、そろそろ小休止だ。"
msgstr "\"Oh is that so? Well, lucky for you it's almost break time."

#. Occurrence 8_1:1181:10508: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0003; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1181
msgctxt "text_id=10508 | speaker=tobimaru"
msgid "　向こうで<暖|あたた>まろうや」"
msgstr "  Let's get warmed up over there.\""

#. Occurrence 8_1:1201:10509: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0015; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:1201
msgctxt "text_id=10509 | speaker=kinomi"
msgid "「お、なんだブレイクかよ！　話せるじゃん、殿下！」"
msgstr "\"Oh, break time! Now you're talking!\""

#. Occurrence 8_1:1234:10510: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0004; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1234
msgctxt "text_id=10510 | speaker=tobimaru"
msgid "「あ？　テメエは除外に決まってんだろ。特権は功労者にのみ与えられるモンだ。"
msgstr "\"Huh? Not for you, idiot. Only people who've actually done some work today can take a break."

#. Occurrence 8_1:1240:10511: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0005; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1240
msgctxt "text_id=10511 | speaker=tobimaru"
msgid "　焼却炉の前に来たけりゃ、それ相応の貢ぎ物を持ってきやがれ。具体的に言うと、リヤカー一台分のゴミ袋な」"
msgstr "  If you wanna come stand by the furnace then bring me enough leaves to fill a cart. Until then, keep sweeping.\""

#. Occurrence 8_1:1265:10512: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0016; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:1265
msgctxt "text_id=10512 | speaker=kinomi"
msgid "「ひっでぇ、生徒会横暴ー！」"
msgstr "\"Argh! I have rights, you know! This is abuse of power!\""

#. Occurrence 8_1:1285:10513: scene=8_1
#: 8_1:1285
msgctxt "text_id=10513 | speaker=unknown"
msgid "　木乃美の抗議は当然のように届かない。"
msgstr "  Kinomi's complaints naturally fell on deaf ears."

#. Occurrence 8_1:1290:10514: scene=8_1
#: 8_1:1290
msgctxt "text_id=10514 | speaker=unknown"
msgid "　清掃班の指揮役として<抜擢|ばってき>された鳶丸には、こんなんでも絶対的な権力があった。"
msgstr "  Tobimaru had been selected to lead the cleaning operation, and his word was final."

#. Occurrence 8_1:1295:10515: scene=8_1
#: 8_1:1295
msgctxt "text_id=10515 | speaker=unknown"
msgid "　彼がちょっと記録に手を加えれば、木乃美は明日も明後日も清掃班に参加する事になる。"
msgstr "  If Kinomi were to continue to push his buttons, he knew he would be on cleaning duty tomorrow and the next day, too."

#. Occurrence 8_1:1335:10516: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0006; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1335
msgctxt "text_id=10516 | speaker=tobimaru"
msgid "「さ、行くぞ。誰の趣味かしらねえが、なぜかしるこの缶が山ほどあってな。中華まんの一つでもあった方が気が利くってもんなんだがねぇ。アレか、遭難用のチョコレートみたいなもんか？"
msgstr "\"All right, here we go, people. Don't ask me why, but we have a bunch of cans of sweet red-bean soup. Some meat buns would've been better, but that would have required a certain someone to use their brain. We've also got some emergency chocolate."

#. Occurrence 8_1:1341:10517: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0007; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1341
msgctxt "text_id=10517 | speaker=tobimaru"
msgid "　……ったく、アイツの考えはいまだに分かんねぇなあ」"
msgstr "  ...Goddammit. What the hell was she thinking?\""

#. Occurrence 8_1:1357:10518: scene=8_1
#: 8_1:1357
msgctxt "text_id=10518 | speaker=unknown"
msgid "　それはそれで気が利いているのでは、と感心する草十郎。"
msgstr "  Soujyuro reassured Tobimaru by saying that he thought the food would do just fine for everyone."

#. Occurrence 8_1:1391:10519: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0008; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1391
msgctxt "text_id=10519 | speaker=tobimaru"
msgid "「ん？　なんだよ、行かねえのか草十郎？」"
msgstr "\"Huh? Wait, you're not coming?\""

#. Occurrence 8_1:1397:10520: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0006; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1397
msgctxt "text_id=10520 | speaker=soujuurou"
msgid "「ああ、自分はここに残るよ。<暖|だん>なら木乃美の言うように葉を燃やせばいい。そこに池もある。火の始末なら安心だ」"
msgstr "\"No, I'm gonna stay here. We can just burn some leaves to stay warm like Kinomi said. We've got a pond right there, so we can easily put it out when we're done.\""

#. Occurrence 8_1:1420:10521: scene=8_1
#: 8_1:1420
msgctxt "text_id=10521 | speaker=unknown"
msgid "　木乃美に気をつかっての返答である。"
msgstr "  This was clearly for Kinomi's benefit."

#. Occurrence 8_1:1425:10522: scene=8_1
#: 8_1:1425
msgctxt "text_id=10522 | speaker=unknown"
msgid "　鳶丸は眉をひそめ、木乃美はプルプル震えている。"
msgstr "  Tobimaru furrowed his brow while Kinomi shivered from the cold."

#. Occurrence 8_1:1463:10523: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0017; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:1463
msgctxt "text_id=10523 | speaker=kinomi"
msgid "「おお……ぉおおお……！"
msgstr "\"Ohhh... Ohhhhhhhh!"

#. Occurrence 8_1:1475:10524: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0018; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:1475
msgctxt "text_id=10524 | speaker=kinomi"
msgid "　オ、オレはいま友情ってもんを実感している！　すげえな、真心ってほんとにあったんだ！"
msgstr "  I-Is that a glimmer of friendship I just saw! You know what? You're as pure as the snow is white!"

#. Occurrence 8_1:1482:10525: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0019; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:1482
msgctxt "text_id=10525 | speaker=kinomi"
msgid "　クソ、待ってろ静希！　いま赤羽たちからイモ奪ってくる！」"
msgstr "  This is nuts, but just wait here, Sizuki! I'm gonna go grab some potatoes from Akabane!\""

#. Occurrence 8_1:1495:10526: scene=8_1
#: 8_1:1495
msgctxt "text_id=10526 | speaker=unknown"
msgid "　根は照れ屋なのか、木乃美はとなりの班の集まりへ走っていった。"
msgstr "  Perhaps shy to show his true feelings, Kinomi ran off to the neighboring group."

#. Occurrence 8_1:1529:10527: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0009; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1529
msgctxt "text_id=10527 | speaker=tobimaru"
msgid "「……ま、予想はしてたけどな。ほらよ」"
msgstr "\"...Eh, I figured you'd say that. Here.\""

#. Occurrence 8_1:1548:10528: scene=8_1
#: 8_1:1548
msgctxt "text_id=10528 | speaker=unknown"
msgid "　やれやれと頭をかきながら、鳶丸はジャージのポケットからホット缶を取りだした。"
msgstr "  Tobimaru pulled out a hot can from his jersey pocket, scratching his head in exacerbation."

#. Occurrence 8_1:1553:10529: scene=8_1
#: 8_1:1553
msgctxt "text_id=10529 | speaker=unknown"
msgid "　左右のポケットと、ズボンの後ろ、合わせて三本。"
msgstr "  He pulled out three in all, one from each jersey pocket and one from his pants pocket."

#. Occurrence 8_1:1574:10530: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0010; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1574
msgctxt "text_id=10530 | speaker=tobimaru"
msgid "「さっさと焚火の用意をしようぜ。"
msgstr "\"Let's get a fire going."

#. Occurrence 8_1:1574:10531: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0010; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1574
msgctxt "text_id=10531 | speaker=tobimaru"
msgid "　俺もこっちで休む事にするわ」"
msgstr "  I'm gonna chill over here too.\""

#. Occurrence 8_1:1590:10532: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0007; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1590
msgctxt "text_id=10532 | speaker=soujuurou"
msgid "「付き合いがいいのはお互いさまだな」"
msgstr "\"I guess we both know how to deal with people, huh?\""

#. Occurrence 8_1:1601:10533: scene=8_1
#: 8_1:1601
msgctxt "text_id=10533 | speaker=unknown"
msgid "　草十郎は手早く焚火の用意を済ませる。"
msgstr "  Soujyuro quickly prepared the leaves for the fire."

#. Occurrence 8_1:1612:10534: scene=8_1
#: 8_1:1612
msgctxt "text_id=10534 | speaker=unknown"
msgid "　落ち葉を集め、きちんと<燻|くすぶ>るよう、あっさりと燃やしてみせた。"
msgstr "  Carefully gathering them up for them to burn neatly."

#. Occurrence 8_1:1641:10535: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0011; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1641
msgctxt "text_id=10535 | speaker=tobimaru"
msgid "「…………慣れてるな」"
msgstr "\"...You're pretty good at that.\""

#. Occurrence 8_1:1647:10536: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0008; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1647
msgctxt "text_id=10536 | speaker=soujuurou"
msgid "「マッチがあるから、楽なんだ」"
msgstr "\"Eh, it's easy when you have matches.\""

#. Occurrence 8_1:1653:10537: scene=8_1
#: 8_1:1653
msgctxt "text_id=10537 | speaker=unknown"
msgid "　草十郎は火をつけた落ち葉の前にしゃがみこんで、かじかんだ両手をかざした。"
msgstr "  Soujyuro crouched down in front of the burning leaves and warmed his hands near the flames."

#. Occurrence 8_1:1658:10538: scene=8_1
#: 8_1:1658
msgctxt "text_id=10538 | speaker=unknown"
msgid "　寒そうな素振りは見られなかったが、草十郎は草十郎なりに寒かったらしい。"
msgstr "  Even though he showed no signs of being cold, underneath it all, Soujyuro was cold, too."

#. Occurrence 8_1:1678:10539: scene=8_1
#: 8_1:1678
msgctxt "text_id=10539 | speaker=unknown"
msgid "　ぱちぱちと煙る落ち葉の山を、懐かしむように草十郎は眺めている。"
msgstr "  He gazed into the fire as the smoke rose from the pile of leaves, as if remembering the good times from his past."

#. Occurrence 8_1:1694:10540: scene=8_1
#: 8_1:1694
msgctxt "text_id=10540 | speaker=unknown"
msgid "　……その姿に、鳶丸は一抹の不安を感じた。"
msgstr "  Tobimaru felt a touch of concern as he looked at Soujyuro."

#. Occurrence 8_1:1699:10541: scene=8_1
#: 8_1:1699
msgctxt "text_id=10541 | speaker=unknown"
msgid "　望郷や追想。住む場所を奪われ追われた、異邦人のような暗い<翳|かげ>りを、その姿に見たからだ。"
msgstr "  He saw within him homesickness and retrospection. He also saw a dark shadow looming over him, like a stranger in a foreign land without a home."

#. Occurrence 8_1:1720:10542: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0012; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1720
msgctxt "text_id=10542 | speaker=tobimaru"
msgid "「元気ねえな、草十郎」"
msgstr "\"You don't look so good, Soujyuro.\""

#. Occurrence 8_1:1726:10543: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0009; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1726
msgctxt "text_id=10543 | speaker=soujuurou"
msgid "「……まあね。少し、疲れてる」"
msgstr "\"I suppose I *am* a little tired.\""

#. Occurrence 8_1:1746:10544: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0013; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1746
msgctxt "text_id=10544 | speaker=tobimaru"
msgid "「悩みごとなら相談にのるぜ。気が向いたら話してくれ」"
msgstr "\"If you need to talk, I'm here for you. Just let me know.\""

#. Occurrence 8_1:1753:10545: scene=8_1
#: 8_1:1753
msgctxt "text_id=10545 | speaker=unknown"
msgid "　お汁粉缶を開けて、人差し指に残ったリングプルを持て余しながら鳶丸は続ける。"
msgstr "  Tobimaru continued speaking with the pull-tab from the can of sweet red-bean soup still around his index finger."

#. Occurrence 8_1:1758:10546: scene=8_1
#: 8_1:1758
msgctxt "text_id=10546 | speaker=unknown"
msgid "　草十郎は焚火に意識を向けたままだ。"
msgstr "  Soujyuro was focused on the fire."

#. Occurrence 8_1:1793:10547: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0014; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1793
msgctxt "text_id=10547 | speaker=tobimaru"
msgid "「そういえばな。おまえが学校休んでる時、蒼崎に殴られたぜ。なんでも俺は大ぼら吹きだそうだ」"
msgstr "\"Oh yeah, while you were taking a break from school, Aozaki slugged me. She said I've got a big mouth.\""

#. Occurrence 8_1:1811:10548: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0010; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1811
msgctxt "text_id=10548 | speaker=soujuurou"
msgid "「すごいな、大抜擢じゃないか」"
msgstr "\"Wow, congratulations.\""

#. Occurrence 8_1:1828:10549: scene=8_1
#: 8_1:1828
msgctxt "text_id=10549 | speaker=unknown"
msgid "　草十郎の返答は、時々このように脈絡がない。"
msgstr "  Sometimes Soujyuro would reply incoherently like this."

#. Occurrence 8_1:1838:10550: scene=8_1
#: 8_1:1838
msgctxt "text_id=10550 | speaker=unknown"
msgid "　おそらく文化圏の違いだろう、と鳶丸は気にしない事にした。"
msgstr "  Tobimaru chalked it up to cultural differences."

#. Occurrence 8_1:1864:10551: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0015; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1864
msgctxt "text_id=10551 | speaker=tobimaru"
msgid "「なあ、蒼崎とはどうなってんだ？　テスト前は駅まで一緒に帰ってただろ。うまくいってんのか、あれから？」"
msgstr "\"Say, how are things going with Aozaki anyway? You used to walk with her to the train station before exams. Have things been going well since then?\""

#. Occurrence 8_1:1869:10552: scene=8_1
#: 8_1:1869
msgctxt "text_id=10552 | speaker=unknown"
msgid "　そんなハズはあるまい、と誰よりも分かっているクセに問いただす。そんな鳶丸に、"
msgstr "  It was obvious to everyone that that was far from the case, yet Tobimaru asked anyway."

#. Occurrence 8_1:1891:10553: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0011; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:1891
msgctxt "text_id=10553 | speaker=soujuurou"
msgid "「ああ、今は一緒に住んでるよ」"
msgstr "\"Yeah, we live together now.\""

#. Occurrence 8_1:1897:10554: scene=8_1
#: 8_1:1897
msgctxt "text_id=10554 | speaker=unknown"
msgid "　草十郎はあっさりと真実を告げるのだった。"
msgstr "  Soujyuro went with the truthful, blunt response."

#. Occurrence 8_1:1934:10555: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0016; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1934
msgctxt "text_id=10555 | speaker=tobimaru"
msgid "「ほー。そうか、一緒ときたか」"
msgstr "\"Wow. I see, I see. That was quick, dating already, huh?\""

#. Occurrence 8_1:1939:10556: scene=8_1
#: 8_1:1939
msgctxt "text_id=10556 | speaker=unknown"
msgid "　あまりに自然な返答にハハハ、と鳶丸は相づちを打ち、"
msgstr "  Tobimaru tried to laugh off Soujyuro's all-too casual confession, however..."

#. Occurrence 8_1:1987:10557: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0017; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:1987
msgctxt "text_id=10557 | speaker=tobimaru"
msgid "「あん、一緒に住んでるだぁーー！？」"
msgstr "\"Wait, you LIVE TOGETHER?!\""

#. Occurrence 8_1:2022:10558: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0012; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2022
msgctxt "text_id=10558 | speaker=soujuurou"
msgid "「どうした鳶丸。火でも飛んだか？」"
msgstr "\"Are you okay, Tobimaru? Did a spark hit you?\""

#. Occurrence 8_1:2038:10559: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0018; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2038
msgctxt "text_id=10559 | speaker=tobimaru"
msgid "「飛んでねえし、それより怖ぇ。おい、今の聞き捨てならねえ<戯言|たわごと>はホントの話か？」"
msgstr "\"No, worse. My friend just said the wildest thing I've ever heard.\""

#. Occurrence 8_1:2048:10560: scene=8_1
#: 8_1:2048
msgctxt "text_id=10560 | speaker=unknown"
msgid "　戯言とは何事だ、と草十郎は無言で抗議。"
msgstr "  Soujyuro protested Tobimaru's reply with silence."

#. Occurrence 8_1:2074:10561: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0019; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2074
msgctxt "text_id=10561 | speaker=tobimaru"
msgid "「っ―――その余裕、マジか……女に興味なさそうな顔してて、やる事やってんじゃねえかテメエ」"
msgstr "\"...Y-You're not joking, are you? One day you're barely interested in girls and the next you're shacked up with one?!\""

#. Occurrence 8_1:2080:10562: scene=8_1
#: 8_1:2080
msgctxt "text_id=10562 | speaker=unknown"
msgid "　物理的に先を越された訳でもないのに、なぜか精神的に先を越された気がする鳶丸だった。"
msgstr "  Tobimaru had always felt that he and Soujyuro were an equal match strength-wise, but for some reason he could not shake the feeling that Soujyuro was now his superior in the brain department."

#. Occurrence 8_1:2085:10563: scene=8_1
#: 8_1:2085
msgctxt "text_id=10563 | speaker=unknown"
msgid "　そんな彼に、草十郎は珍しく怒りの視線を向ける。"
msgstr "  Soujyuro cast a rare angry glare in Tobimaru's direction."

#. Occurrence 8_1:2111:10564: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0013; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2111
msgctxt "text_id=10564 | speaker=soujuurou"
msgid "「こっちこそ聞き捨てならない。"
msgstr "\"That was awfully rude."

#. Occurrence 8_1:2117:10565: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0014; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2117
msgctxt "text_id=10565 | speaker=soujuurou"
msgid "　なんだ、その女に興味はないってのは」"
msgstr "  What do you mean I'm not interested in girls?\""

#. Occurrence 8_1:2123:10566: scene=8_1
#: 8_1:2123
msgctxt "text_id=10566 | speaker=unknown"
msgid "　本気で怒っているらしく言葉も冷たい。"
msgstr "  Soujyuro seemed genuinely angry, and his voice was icy."

#. Occurrence 8_1:2128:10567: scene=8_1
#: 8_1:2128
msgctxt "text_id=10567 | speaker=unknown"
msgid "　草十郎のかつてない不機嫌さに、鳶丸も平静さを取り戻す。"
msgstr "  This uncharacteristic level of anger from Soujyuro was enough to get Tobimaru to back down."

#. Occurrence 8_1:2155:10568: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0020_0; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2155
msgctxt "text_id=10568 | speaker=tobimaru"
msgid "「いや、悪い。そんな雰囲気あったんだよ、おまえさんは。それは謝る。"
msgstr "\"Hey look, I was out of line. I just assumed a few things. I apologize."

#. Occurrence 8_1:2167:10569: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0020_1; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2167
msgctxt "text_id=10569 | speaker=tobimaru"
msgid "けどよ、蒼崎と一緒に住んでるってどういうことだ？　いくらなんでも<一足|いっそく>飛びすぎだろ」"
msgstr " But seriously, what do you mean you're living with her? This all seems way too fast for you.\""

#. Occurrence 8_1:2193:10570: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0015; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2193
msgctxt "text_id=10570 | speaker=soujuurou"
msgid "「別に、君が期待しているような事はない。彼女が住んでいるところの部屋を借りる事になっただけだ。"
msgstr "\"It's not what you think. I'm just renting a room in her house."

#. Occurrence 8_1:2199:10571: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0016; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2199
msgctxt "text_id=10571 | speaker=soujuurou"
msgid "　屋根の裏にある部屋なんだけど、板張で山小屋を思い出すんで気に入ってる」"
msgstr "  It's up in the attic, but it reminds me of a mountain cottage so I kind of like it.\""

#. Occurrence 8_1:2205:10572: scene=8_1
#: 8_1:2205
msgctxt "text_id=10572 | speaker=unknown"
msgid "　それは屋根裏部屋というのだが、あえて鳶丸はスルーした。"
msgstr "  Tobimaru did not bat an eyelid at hearing that Soujyuro now lived in an attic, and continued his questioning."

#. Occurrence 8_1:2239:10573: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0021; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2239
msgctxt "text_id=10573 | speaker=tobimaru"
msgid "「屋敷って、あの久遠寺の屋敷か……？"
msgstr "\"I mean we're talking about *that* mansion, right? The Kuonji mansion?"

#. Occurrence 8_1:2245:10574: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0022; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2245
msgctxt "text_id=10574 | speaker=tobimaru"
msgid "　それこそまさかだぜ。草十郎。おまえ、いったいどんな手品を使いやがった？」"
msgstr "  This is out of this world! What kind of wizard are you to pull that off?\""

#. Occurrence 8_1:2251:10575: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0017; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2251
msgctxt "text_id=10575 | speaker=soujuurou"
msgid "「？　鳶丸こそ、あの家を知ってるのか？」"
msgstr "\"Huh? You know the place, Tobimaru?\""

#. Occurrence 8_1:2257:10576: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0023; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2257
msgctxt "text_id=10576 | speaker=tobimaru"
msgid "「そりゃあな。これでも槻司家期待の跡取り候補だぜ、俺は。久遠寺グループのご令嬢が住んでる屋敷ぐらいは知ってるさ。礼園女学院の二年生だろ、たしか」"
msgstr "\"Come on, dude, you're talking to the heir to the Tsukiji throne here. Of course I know about the mansion where the first daughter of the Kuonji Group lives. She's a sophomore at the Reien Girls Academy, right?\""

#. Occurrence 8_1:2289:10577: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0018; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2289
msgctxt "text_id=10577 | speaker=soujuurou"
msgid "「久遠寺……なに？」"
msgstr "\"Kuonji... what?\""

#. Occurrence 8_1:2294:10578: scene=8_1
#: 8_1:2294
msgctxt "text_id=10578 | speaker=unknown"
msgid "　ますます首をかしげる草十郎に、鳶丸はやれやれと説明を続けた。もちろん、草十郎が分かるレベルに落としこんで。"
msgstr "  Soujyuro was looking more confused than ever, so Tobimaru reluctantly explained everything as simply as he could so Soujyuro could understand."

#. Occurrence 8_1:2327:10579: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0024; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2327
msgctxt "text_id=10579 | speaker=tobimaru"
msgid "「久遠寺グループ……つーか財団だな。"
msgstr "\"The Kuonji Group. Well, they're more like a foundation, really."

#. Occurrence 8_1:2333:10580: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0025; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2333
msgctxt "text_id=10580 | speaker=tobimaru"
msgid "　平たく言えば一族全部がお金持ちで、仲良く会社を経営してる連中だと思えばいい。複合企業とまではいかないが、輸出業じゃあかなりのもんだ」"
msgstr "  All you need to know is, the whole family is loaded and they own and manage various companies together. They're not quite a conglomerate, but they're a big deal in the exports industry.\""

#. Occurrence 8_1:2354:10581: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0026; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2354
msgctxt "text_id=10581 | speaker=tobimaru"
msgid "「ホームグラウンドは国外で、先代の会長の英国びいきがたたって一時期は沈みかけてたんだが、五年くらい前かね。本拠地をこっちに移してからはご存じの通りだ。"
msgstr "\"They used to operate out of England because their old chairman loved the place, but things went south about five years ago so they moved all their operations back here."

#. Occurrence 8_1:2360:10582: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0027; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2360
msgctxt "text_id=10582 | speaker=tobimaru"
msgid "　会長が息子に移ってからはきちんと持ち直して、今や町の名士だろ。ここでも久遠寺の名前はそこかしこで目に入る。この学校の建て直し予算の半分は連中からだしな」"
msgstr "  Since their son took over, things have rebounded for them and that's why you see their name plastered around town. They contributed, like, half the funds required to rebuild our school.\""

#. Occurrence 8_1:2392:10583: scene=8_1
#: 8_1:2392
msgctxt "text_id=10583 | speaker=unknown"
msgid "　極めて簡単に言ったのだが、それでも草十郎には早すぎたようだ。"
msgstr "  Despite the oversimplified explanation, Soujyuro still seemed to not be getting it."

#. Occurrence 8_1:2397:10584: scene=8_1
#: 8_1:2397
msgctxt "text_id=10584 | speaker=unknown"
msgid "　仕方なく鳶丸は話をきる。"
msgstr "  With that, Tobimaru decided to give up on trying to explain."

#. Occurrence 8_1:2430:10585: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0028; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2430
msgctxt "text_id=10585 | speaker=tobimaru"
msgid "「あれだ、想像もできない金持ちってコト。"
msgstr "\"They're filthy rich, okay?"

#. Occurrence 8_1:2436:10586: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0029; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2436
msgctxt "text_id=10586 | speaker=tobimaru"
msgid "　草の字が働いてる喫茶店だって、久遠寺が向こうから持ってきたブランドだぜ？　今じゃ全国チェーンになっちまったがな」"
msgstr "  You know that coffee place you work at? The Kuonjis brought that franchise here. Now they're a national chain!\""

#. Occurrence 8_1:2442:10587: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0019; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2442
msgctxt "text_id=10587 | speaker=soujuurou"
msgid "「つまりすごく偉いんだね。……おかしいな、ならなんであんなに倹約してるんだろう……」"
msgstr "\"Okay, so they're very rich and very important. ...Weird. If that's the case, then why is she so frugal all the time?\""

#. Occurrence 8_1:2457:10588: scene=8_1
#: 8_1:2457
msgctxt "text_id=10588 | speaker=unknown"
msgid "　ぶつぶつと呟く草十郎。"
msgstr "  Soujyuro mumbled incoherently to himself."

#. Occurrence 8_1:2462:10589: scene=8_1
#: 8_1:2462
msgctxt "text_id=10589 | speaker=unknown"
msgid "　そんな草十郎に、鳶丸は羨ましいような、心底から同情しているような、複雑な顔を向ける。"
msgstr "  Tobimaru looked at him with a complex expression on his face, somewhere between envy and heartfelt sympathy."

#. Occurrence 8_1:2483:10590: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0030; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2483
msgctxt "text_id=10590 | speaker=tobimaru"
msgid "「しっかし、うまい事やったな草十郎。"
msgstr "\"Whatever the case, you've done good for yourself, buddy."

#. Occurrence 8_1:2503:10591: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0031; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2503
msgctxt "text_id=10591 | speaker=tobimaru"
msgid "　それで、本当のところはどうなんだ？　男と女が同じ屋根の下にいれば、やる事はひとつだろう？」"
msgstr "  Tell me the truth, though. When a guy and a girl are living under the same roof, only one thing can be happening, am I right?\""

#. Occurrence 8_1:2514:10592: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0020; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2514
msgctxt "text_id=10592 | speaker=soujuurou"
msgid "「あんがい古いな、鳶丸も」"
msgstr "\"That's a surprisingly old-fashioned thought for you to have, Tobimaru.\""

#. Occurrence 8_1:2525:10593: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0032; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2525
msgctxt "text_id=10593 | speaker=tobimaru"
msgid "「ぬかせ。そのあたりを誤魔化してたら男なんざやってらんねえ」"
msgstr "\"Oh give me a break! What kind of guy is afraid to talk about this kind of stuff?\""

#. Occurrence 8_1:2536:10594: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0021; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2536
msgctxt "text_id=10594 | speaker=soujuurou"
msgid "「そりゃごもっとも。実を言うと、正直な話―――」"
msgstr "\"I suppose you're right. So, the truth is...\""

#. Occurrence 8_1:2574:10595: scene=8_1
#: 8_1:2574
msgctxt "text_id=10595 | speaker=unknown"
msgid "　今のところまったく色気のない雑居ではあるが、同じ家で生活している以上、不意打ち気味のニアミスはある。"
msgstr "  Though Soujyuro and Aoko were living together, there was absolutely no chemistry between them. Though that was not to say that living in such close quarters as they did, unintended mishaps did not occur from time to time."

#. Occurrence 8_1:2579:10596: scene=8_1
#: 8_1:2579
msgctxt "text_id=10596 | speaker=unknown"
msgid "　あるのではあるが、しかし―――"
msgstr "  But, even still..."

#. Occurrence 8_1:2618:10597: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0022; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2618
msgctxt "text_id=10597 | speaker=soujuurou"
msgid "「驚くぐらい、そういうコトにはなってない。"
msgstr "\"You'd be surprised how nothing like that goes on."

#. Occurrence 8_1:2618:10598: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0022; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2618
msgctxt "text_id=10598 | speaker=soujuurou"
msgid "　あの屋敷、すごく広いし」"
msgstr "  The mansion is pretty huge, after all.\""

#. Occurrence 8_1:2624:10599: scene=8_1
#: 8_1:2624
msgctxt "text_id=10599 | speaker=unknown"
msgid "　青子たちも草十郎も私用で忙しいため、そんな浮き足だった状況にはなっていなかった。"
msgstr "  Everyone was often busy with their own affairs, so there was no opportunity for that sort of thing to happen."

#. Occurrence 8_1:2650:10600: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0023; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2650
msgctxt "text_id=10600 | speaker=soujuurou"
msgid "「そもそもだな。もし鳶丸だったら、下宿先が同じって理由だけで、蒼崎に言い寄る気になるかい？」"
msgstr "\"I mean, answer me this. Would you suddenly make advances on Aozaki just because you were living under the same roof?\""

#. Occurrence 8_1:2661:10601: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0033; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2661
msgctxt "text_id=10601 | speaker=tobimaru"
msgid "「……いや。ならねえな、そりゃあ」"
msgstr "\"...Nope, never.\""

#. Occurrence 8_1:2666:10602: scene=8_1
#: 8_1:2666
msgctxt "text_id=10602 | speaker=unknown"
msgid "　数々の彼女の戦歴を思い出しているのか、感慨深くうなずく鳶丸。"
msgstr "  Tobimaru nodded intently, as if he was thinking back over his many ex-relationships."

#. Occurrence 8_1:2710:10603: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0034; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2710
msgctxt "text_id=10603 | speaker=tobimaru"
msgid "「いや、健全だな」"
msgstr "\"Well, this all sounds very wholesome.\""

#. Occurrence 8_1:2716:10604: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0024; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2716
msgctxt "text_id=10604 | speaker=soujuurou"
msgid "「ああ、健全だろ」"
msgstr "\"Yeah, I feel great.\""

#. Occurrence 8_1:2722:10605: scene=8_1
#: 8_1:2722
msgctxt "text_id=10605 | speaker=unknown"
msgid "　虚脱感のある鳶丸の呟きに、のんびりと焚火にあたりながら短く同意する草十郎。"
msgstr "  Soujyuro gave no more than a quick affirmation to Tobimaru's despondent murmur."

#. Occurrence 8_1:2727:10606: scene=8_1
#: 8_1:2727
msgctxt "text_id=10606 | speaker=unknown"
msgid "　もっとも。"
msgstr "  He was doing fine."

#. Occurrence 8_1:2732:10607: scene=8_1
#: 8_1:2732
msgctxt "text_id=10607 | speaker=unknown"
msgid "　健全であるかは別にして、あの洋館に寝泊りし、青子と有珠相手に平静を保てているのは、間違いなく草十郎の<人柄|さいのう>だろう。"
msgstr "  But besides his physical health, it was surely Soujyuro's personality that enabled him to maintain any semblance of peace dealing with both Aoko and Alice while living in that mansion."

#. Occurrence 8_1:2765:10608: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0025; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2765
msgctxt "text_id=10608 | speaker=soujuurou"
msgid "「でも、それとは別の話で蒼崎には頭があがらないんだ。"
msgstr "\"On an unrelated note, I'm totally indebted to Aozaki."

#. Occurrence 8_1:2771:10609: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0026; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2771
msgctxt "text_id=10609 | speaker=soujuurou"
msgid "　彼女には、もう返せない借りがあってさ」"
msgstr "  I'm not sure how I can ever repay her for what she's done for me.\""

#. Occurrence 8_1:2777:10610: scene=8_1
#: 8_1:2777
msgctxt "text_id=10610 | speaker=unknown"
msgid "　ぼんやりとしていた彼の瞳が、少しだけ真剣になって焚火を見詰める。"
msgstr "  Soujyuro's eyes turned slightly serious as he stared into the fire."

#. Occurrence 8_1:2782:10611: scene=8_1
#: 8_1:2782
msgctxt "text_id=10611 | speaker=unknown"
msgid "　それが額面通りの意味でない事は、鳶丸にも感じ取れた。"
msgstr "  Tobimaru felt that there was more to those words than what Soujyuro was letting on."

#. Occurrence 8_1:2803:10612: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0035; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2803
msgctxt "text_id=10612 | speaker=tobimaru"
msgid "「もう返せない借りだあ？」"
msgstr "\"So you owe her big time, huh?\""

#. Occurrence 8_1:2809:10613: scene=8_1
#: 8_1:2809
msgctxt "text_id=10613 | speaker=unknown"
msgid "　繰り返す鳶丸に、草十郎は無言でうなずく。"
msgstr "  Soujyuro merely nodded in silence at Tobimaru's inquisitive acknowledgment."

#. Occurrence 8_1:2827:10614: scene=8_1
#: 8_1:2827
msgctxt "text_id=10614 | speaker=unknown"
msgid "　―――と。"
msgstr "  And just then..."

#. Occurrence 8_1:2832:10615: scene=8_1
#: 8_1:2832
msgctxt "text_id=10615 | speaker=unknown"
msgid "　深刻な沈黙を破るように、森の奥から妙な叫び声が届いてきた。"
msgstr "  A strange scream pierced through the still silence of the wood like a knife."

#. Occurrence 8_1:2858:10616: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0036; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2858
msgctxt "text_id=10616 | speaker=tobimaru"
msgid "「……なんか聞こえたな？」"
msgstr "\"...Did you hear that?\""

#. Occurrence 8_1:2867:10617: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0027; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2867
msgctxt "text_id=10617 | speaker=soujuurou"
msgid "「ああ、木乃美だ」"
msgstr "\"Yeah, and it was Kinomi.\""

#. Occurrence 8_1:2873:10618: scene=8_1
#: 8_1:2873
msgctxt "text_id=10618 | speaker=unknown"
msgid "　答えるより早く草十郎は立ち上がる。"
msgstr "  Soujyuro had already stood up before he responded."

#. Occurrence 8_1:2892:10619: scene=8_1
#: 8_1:2892
msgctxt "text_id=10619 | speaker=unknown"
msgid "　そのまま凍った池まで走り、竹ぼうきで氷を叩き割り、"
msgstr "  He bolted to the frozen pond, broke the ice with his broom,"

msgctxt "text_id=10620 | speaker=unknown"
msgid "バケツに水を汲んで焚火にぶちまける。十秒足らずの早技だった。"
msgstr " scooped up some of the frigid water in a bucket and threw it on the fire, all in less than ten seconds."

#. Occurrence 8_1:2915:10621: scene=8_1
#: 8_1:2915
msgctxt "text_id=10621 | speaker=unknown"
msgid "　草十郎は絶叫が聞こえた森の奥へと走り出す。"
msgstr "  Then he immediately ran off into the depths of the woods from where he heard the scream."

#. Occurrence 8_1:2920:10622: scene=8_1
#: 8_1:2920
msgctxt "text_id=10622 | speaker=unknown"
msgid "　何事かとあわてながら鳶丸も後を追う。"
msgstr "  Tobimaru followed after him in panicked confusion."

#. Occurrence 8_1:2971:10623: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0028; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2971
msgctxt "text_id=10623 | speaker=soujuurou"
msgid "「鳶丸、この先に何かあるのか？」"
msgstr "\"Tobimaru, do you know what's down this way?\""

#. Occurrence 8_1:2977:10624: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0037; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2977
msgctxt "text_id=10624 | speaker=tobimaru"
msgid "「たしか旧校舎が残ってるはずだ」"
msgstr "\"The remains of the old school building should be there.\""

#. Occurrence 8_1:2983:10625: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0029; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2983
msgctxt "text_id=10625 | speaker=soujuurou"
msgid "「他には？　野犬の住みかとか、そういうイヤな話は？」"
msgstr "\"Anything else? You know, like a pack of wild dogs, or bad stuff like that?\""

#. Occurrence 8_1:2989:10626: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0038; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:2989
msgctxt "text_id=10626 | speaker=tobimaru"
msgid "「はあ？　いや、いるとしても鹿か兎じゃねえか？」"
msgstr "\"Huh? No, dude. If anything it'd just be some deer, or rabbits, or something.\""

#. Occurrence 8_1:2995:10627: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0030; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:2995
msgctxt "text_id=10627 | speaker=soujuurou"
msgid "「なら怖がるコトもないか。急ごう、鳶丸」"
msgstr "\"Then there's nothing to be afraid of. Let's hurry.\""

#. Occurrence 8_1:3015:10628: scene=8_1
#: 8_1:3015
msgctxt "text_id=10628 | speaker=unknown"
msgid "　山育ちで慣れているのか、草十郎は腐葉土の上でも軽々と走っていく。"
msgstr "  Perhaps because of his time spent growing up in the mountains, Soujyuro quickly sprinted over the slippery dead leaves."

#. Occurrence 8_1:3020:10629: scene=8_1
#: 8_1:3020
msgctxt "text_id=10629 | speaker=unknown"
msgid "　鳶丸も足には自信がある方だが、森の中では草十郎には付いていけない。"
msgstr "  Tobimaru was not particularly cautious himself, but nevertheless he could not keep up with Soujyuro in here."

#. Occurrence 8_1:3066:10630: scene=8_1
#: 8_1:3066
msgctxt "text_id=10630 | speaker=unknown"
msgid "　そうして、いつしか草十郎はひとりきりで走っていた。"
msgstr "  Before long, Soujyuro found himself running alone."

#. Occurrence 8_1:3071:10631: scene=8_1
#: 8_1:3071
msgctxt "text_id=10631 | speaker=unknown"
msgid "　木々の葉で閉ざされた獣道を、時には両手で力強く払い除けながら、時には柳のように擦り抜けながら。"
msgstr "  When foliage blocked the natural trail, he would sometimes clear it away by brute force. But just as often, he would expertly weave through the brush."

#. Occurrence 8_1:3076:10632: scene=8_1
#: 8_1:3076
msgctxt "text_id=10632 | speaker=unknown"
msgid "　この程度の緑の深さなら慣れたものらしい。"
msgstr "  It was clear that he was used to dealing with this level of nature."

#. Occurrence 8_1:3125:10633: scene=8_1
#: 8_1:3125
msgctxt "text_id=10633 | speaker=unknown"
msgid "　数分後、草十郎はその広場に辿り着いた。"
msgstr "  After a few minutes, Soujyuro arrived at a clearing."

#. Occurrence 8_1:3130:10634: scene=8_1
#: 8_1:3130
msgctxt "text_id=10634 | speaker=unknown"
msgid "　木々の壁はここで終わっている。"
msgstr "  The wall of trees had ended."

#. Occurrence 8_1:3135:10635: scene=8_1
#: 8_1:3135
msgctxt "text_id=10635 | speaker=unknown"
msgid "　山の中腹に<拓|ひら>かれた人工の広場。"
msgstr "  It was an obviously man-made clearing here on the mountainside."

#. Occurrence 8_1:3140:10636: scene=8_1
#: 8_1:3140
msgctxt "text_id=10636 | speaker=unknown"
msgid "　遠くに見える木造の建物が旧校舎だろう。"
msgstr "  In the distance was what looked like an old wooden school building."

#. Occurrence 8_1:3145:10637: scene=8_1
#: 8_1:3145
msgctxt "text_id=10637 | speaker=unknown"
msgid "　小学校ほどの、小さいが趣のある建物が、人知れず冬の荒れ野に埋没していた。"
msgstr "  It was a small, aesthetically pleasing building no larger than an elementary school, lost in the depths of the winter wilderness."

#. Occurrence 8_1:3178:10638: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0031; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3178
msgctxt "text_id=10638 | speaker=soujuurou"
msgid "「木乃美」"
msgstr "\"Kinomi.\""

#. Occurrence 8_1:3183:10639: scene=8_1
#: 8_1:3183
msgctxt "text_id=10639 | speaker=unknown"
msgid "　その旧校舎のグラウンドに、木乃美はひとりで立ちつくしていた。"
msgstr "  Kinomi stood alone on the old school's grounds."

#. Occurrence 8_1:3192:10640: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0020; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:3192
msgctxt "text_id=10640 | speaker=kinomi"
msgid "「お？　なんで静希まで追いかけてきたん？」"
msgstr "\"Hey. What are you doing here, Sizuki?\""

#. Occurrence 8_1:3197:10641: scene=8_1
#: 8_1:3197
msgctxt "text_id=10641 | speaker=unknown"
msgid "　不思議そうに首をかしげる木乃美に、草十郎はむっと顔をしかめる。"
msgstr "  A sour expression came over Soujyuro's face as Kinomi tilted his head in confusion."

#. Occurrence 8_1:3203:10642: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0032; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3203
msgctxt "text_id=10642 | speaker=soujuurou"
msgid "「そっちこそどうしたんだ。へんな声あげて」"
msgstr "\"That's what I want to know. And what was that scream all about?\""

#. Occurrence 8_1:3234:10643: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0021; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:3234
msgctxt "text_id=10643 | speaker=kinomi"
msgid "「声ぇ？　いや、そりゃガキ相手に怒鳴ったけどよ。"
msgstr "\"Huh? What scream? I was just pissed at this dumb kid."

#. Occurrence 8_1:3240:10644: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0022; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:3240
msgctxt "text_id=10644 | speaker=kinomi"
msgid "　ほら、あのガキだよ。イモ持ってるだろ……ってああ、中に逃げこみやがった！」"
msgstr "  Look, there he is. I know he's got some potatoes on him. Dammit, we let him run off inside!\""

#. Occurrence 8_1:3246:10645: scene=8_1
#: 8_1:3246
msgctxt "text_id=10645 | speaker=unknown"
msgid "　旧校舎を指差しながら<憤慨|ふんがい>する木乃美。"
msgstr "  Kinomi pointed resentfully toward the old school building."

#. Occurrence 8_1:3251:10646: scene=8_1
#: 8_1:3251
msgctxt "text_id=10646 | speaker=unknown"
msgid "　確かに、百メートルほど離れた旧校舎の入り口に、人影らしきものが立っている。"
msgstr "  There was indeed somebody standing at the entrance to the building just over three hundred feet in the distance."

#. Occurrence 8_1:3277:10647: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0023; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:3277
msgctxt "text_id=10647 | speaker=kinomi"
msgid "「ったく、こんな上まで来やがって。いつから子供の遊び場になってんだ、ここ」"
msgstr "\"What the hell is he doing up here anyway? Is this where kids hang out nowadays?\""

#. Occurrence 8_1:3283:10648: scene=8_1
#: 8_1:3283
msgctxt "text_id=10648 | speaker=unknown"
msgid "　まあどうでもいいけど、と木乃美は肩をすくめる。"
msgstr "  Kinomi shrugged his shoulders to signal how little he cared what the young children did with their time."

#. Occurrence 8_1:3288:10649: scene=8_1
#: 8_1:3288
msgctxt "text_id=10649 | speaker=unknown"
msgid "　ここの森は深くはあるが、遭難するほどの場所でもない。"
msgstr "  This place was deep in the woods, but it was not particularly dangerous."

#. Occurrence 8_1:3293:10650: scene=8_1
#: 8_1:3293
msgctxt "text_id=10650 | speaker=unknown"
msgid "　草十郎は森の中をつっきってきたが、外にはコンクリートで舗装された道があるのだ。"
msgstr "  Soujyuro had run through the wood to get here, but there was also a paved road leading to this spot from outside the woods, too."

#. Occurrence 8_1:3298:10651: scene=8_1
#: 8_1:3298
msgctxt "text_id=10651 | speaker=unknown"
msgid "　木乃美はそちらを使って登ってきたようだ。"
msgstr "  Kinomi apparently followed that road to get here."

#. Occurrence 8_1:3333:10652: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0033; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3333
msgctxt "text_id=10652 | speaker=soujuurou"
msgid "「んー……子供………？」"
msgstr "\"Hmm... a child?\""

#. Occurrence 8_1:3338:10653: scene=8_1
#: 8_1:3338
msgctxt "text_id=10653 | speaker=unknown"
msgid "　目を細めて草十郎は呟く。"
msgstr "  Soujyuro squinted."

#. Occurrence 8_1:3356:10654: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0024; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:3356
msgctxt "text_id=10654 | speaker=kinomi"
msgid "「ああ。金髪なんでさっきはちょっと驚いたけどな。外国人の子供って、なんか怖いだろ？」"
msgstr "\"Yeah, he had blond hair, which kinda freaked me out at first. Foreign kids are scary, man!\""

#. Occurrence 8_1:3376:10655: scene=8_1
#: 8_1:3376
msgctxt "text_id=10655 | speaker=unknown"
msgid "　地方都市において、まだ外国人の姿は珍しい。"
msgstr "  It was indeed quite rare to see a foreigner in a provincial town such as Misaki."

#. Occurrence 8_1:3381:10656: scene=8_1
#: 8_1:3381
msgctxt "text_id=10656 | speaker=unknown"
msgid "　テレビならいざしらず、生で外国の子供を見た事がない草十郎にはよけい不思議な感覚だった。"
msgstr "  Soujyuro had never even seen a foreigner in person, which made the whole thing even more mysterious."

#. Occurrence 8_1:3419:10657: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0034; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3419
msgctxt "text_id=10657 | speaker=soujuurou"
msgid "「それで、木乃美はなんでここまで？」"
msgstr "\"Why did you feel the need to run all the way up here again?\""

#. Occurrence 8_1:3439:10658: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0025; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:3439
msgctxt "text_id=10658 | speaker=kinomi"
msgid "「いや、赤羽たちがよ、ガキに食料奪われたって言うからここまで追いかけてきたんだ。"
msgstr "\"Eh, Akabane said that stupid kid stole their food, so I was chasing him down and ended up here."

#. Occurrence 8_1:3446:10659: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0026; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:3446
msgctxt "text_id=10659 | speaker=kinomi"
msgid "そういう事だから、ふたりがかりであのお子さまとっちめようぜ」"
msgstr "Since you're here, let's team up and see if we can catch him.\""

#. Occurrence 8_1:3464:10660: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0035; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3464
msgctxt "text_id=10660 | speaker=soujuurou"
msgid "「怖いことを考えるな、木乃美は」"
msgstr "\"That's a little menacing, Kinomi.\""

#. Occurrence 8_1:3470:10661: scene=8_1
#: 8_1:3470
msgctxt "text_id=10661 | speaker=unknown"
msgid "　賛同しかねる、と草十郎。"
msgstr "  Soujyuro could not find it in him to agree with his plan."

#. Occurrence 8_1:3475:10662: scene=8_1
#: 8_1:3475
msgctxt "text_id=10662 | speaker=unknown"
msgid "　<多勢|たぜい>に<無勢|ぶぜい>は義に反する、といわんばかりである。"
msgstr "  It seemed unfair to team up against a little kid."

#. Occurrence 8_1:3501:10663: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0036; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3501
msgctxt "text_id=10663 | speaker=soujuurou"
msgid "「いいから帰ろう。あの子、こっちを睨んでるじゃないか。"
msgstr "\"Come on, let's head back. That kid is over there just staring at us."

#. Occurrence 8_1:3507:10664: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0037; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3507
msgctxt "text_id=10664 | speaker=soujuurou"
msgid "　それに、鳶丸にこんなところ見られたら冬休み中ずっと山の掃除で終わる事になるぞ？」"
msgstr "  And besides, if Tobimaru sees us up here slacking off we're gonna be cleaning this mountain for the whole of winter break.\""

#. Occurrence 8_1:3542:10665: scene=8_1
#: 8_1:3542
msgctxt "text_id=10665 | speaker=unknown"
msgid "　ぽん、と木乃美の肩に手を置いて、草十郎はもと来た道を戻りはじめた。"
msgstr "  Soujyuro took Kinomi by the shoulders and began leading him back to the path he came from."

#. Occurrence 8_1:3547:10666: scene=8_1
#: 8_1:3547
msgctxt "text_id=10666 | speaker=unknown"
msgid "　木乃美は口惜しげに旧校舎に視線を投げて、草十郎に付いていく。"
msgstr "  Kinomi cast one last gaze at the old school building before reluctantly following."

#. Occurrence 8_1:3579:10667: scene=8_1
#: 8_1:3579
msgctxt "text_id=10667 | speaker=unknown"
msgid "　そんなふたりを出迎えるように、息を切らした鳶丸が登ってきた。"
msgstr "  Just then, Tobimaru appeared, panting and out of breath."

#. Occurrence 8_1:3613:10668: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0039; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:3613
msgctxt "text_id=10668 | speaker=tobimaru"
msgid "「は、速いな、草十郎」"
msgstr "\"How... are you... so fast?!\""

#. Occurrence 8_1:3619:10669: scene=8_1
#: 8_1:3619
msgctxt "text_id=10669 | speaker=unknown"
msgid "　鳶丸の息は乱れている。"
msgstr "  Tobimaru could hardly catch his breath."

#. Occurrence 8_1:3624:10670: scene=8_1
#: 8_1:3624
msgctxt "text_id=10670 | speaker=unknown"
msgid "　草十郎に遅れること三分弱だが、十分に健脚だ。"
msgstr "  He arrived about three minutes behind Soujyuro, despite having a good set of legs on him."

#. Occurrence 8_1:3645:10671: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0040; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:3645
msgctxt "text_id=10671 | speaker=tobimaru"
msgid "「それでどうした。木乃美、無事か？」"
msgstr "\"So what's going on? Are you all right, Kinomi?\""

#. Occurrence 8_1:3666:10672: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_1_0027; voice_prefix=B50; voice_category=6; scene=8_1
#: 8_1:3666
msgctxt "text_id=10672 | speaker=kinomi"
msgid "「？　無事も何も、殿下こそどったん？」"
msgstr "\"Huh? Yeah I'm fine. What about you, Your Highness?\""

#. Occurrence 8_1:3672:10673: scene=8_1
#: 8_1:3672
msgctxt "text_id=10673 | speaker=unknown"
msgid "　鳶丸に心配されるコトなど初めてなのか、目をしばたたく木乃美。"
msgstr "  Kinomi seemed perplexed at Tobimaru's first-ever display of concern for him."

#. Occurrence 8_1:3709:10674: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0041; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:3709
msgctxt "text_id=10674 | speaker=tobimaru"
msgid "「なんだそりゃ。テメェ、あれだけの大声をあげておいてしらばっくれる気か？　上で何かあったんだろうが」"
msgstr "\"What the hell is that supposed to mean? You're out here in the middle of nowhere screaming bloody murder and what am I supposed to think? We were worried!\""

#. Occurrence 8_1:3737:10675: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0038; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3737
msgctxt "text_id=10675 | speaker=soujuurou"
msgid "「すまない、こっちの早とちりだった。"
msgstr "\"That was my fault. I guess I jumped to conclusions."

#. Occurrence 8_1:3743:10676: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0039; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3743
msgctxt "text_id=10676 | speaker=soujuurou"
msgid "　鳶丸は知らないだろうけど、木乃美は時々、バイト先でも奇声をあげる癖があるんだ」"
msgstr "  You've probably never heard him do it, but sometimes at work Kinomi has this habit of letting out a weird yell like that.\""

#. Occurrence 8_1:3748:10677: scene=8_1
#: 8_1:3748
msgctxt "text_id=10677 | speaker=unknown"
msgid "　堂々と言う草十郎の横で、木乃美は不満げに顔をしかめる。彼的に、そんな噂は初耳だった。"
msgstr "  Kinomi looked disapproving as Soujyuro nonchalantly shared this insight. This was the first he had ever heard of it."

#. Occurrence 8_1:3792:10678: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0042; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:3792
msgctxt "text_id=10678 | speaker=tobimaru"
msgid "「……怪しいな。また良からぬ事でも企んでるんじゃねえか、そこの？」"
msgstr "\"...I'm not buying it. You're up to something, aren't you?\""

#. Occurrence 8_1:3809:10679: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0040; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3809
msgctxt "text_id=10679 | speaker=soujuurou"
msgid "「無いよ。戻って掃除の続きをするぞ、鳶丸」"
msgstr "\"Of course not. Come on, Tobimaru, there's cleaning to be done.\""

#. Occurrence 8_1:3815:10680: scene=8_1
#: 8_1:3815
msgctxt "text_id=10680 | speaker=unknown"
msgid "　ぽんぽんと鳶丸の肩を叩いて草十郎は歩きだす。"
msgstr "  Soujyuro pat Tobimaru on the shoulder a couple of times and started walking."

#. Occurrence 8_1:3820:10681: scene=8_1
#: 8_1:3820
msgctxt "text_id=10681 | speaker=unknown"
msgid "　そんな草十郎に、鳶丸は不審げな眼差しを向けた。"
msgstr "  Tobimaru cast a doubtful glare in his direction as he meandered off."

#. Occurrence 8_1:3825:10682: scene=8_1
#: 8_1:3825
msgctxt "text_id=10682 | speaker=unknown"
msgid "　なんとなく、草十郎が木乃美の悪事を<庇|かば>っているように思えたからだ。"
msgstr "  He had a feeling that Soujyuro was covering for Kinomi somehow."

#. Occurrence 8_1:3861:10683: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_1_0043; voice_prefix=B70; voice_category=4; scene=8_1
#: 8_1:3861
msgctxt "text_id=10683 | speaker=tobimaru"
msgid "「まさか、旧校舎に火なんてつけてないだろうな？」"
msgstr "\"You didn't set the old school building on fire or something, did you?\""

#. Occurrence 8_1:3867:10684: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_1_0041; voice_prefix=A30; voice_category=3; scene=8_1
#: 8_1:3867
msgctxt "text_id=10684 | speaker=soujuurou"
msgid "「誰もしないよ、そんな事は」"
msgstr "\"Of course not. Who would even do that?\""

#. Occurrence 8_1:3874:10685: scene=8_1
#: 8_1:3874
msgctxt "text_id=10685 | speaker=unknown"
msgid "　さっさと掃除に戻りたいらしく、草十郎は背後の鳶丸を振り向きもせず歩いていく。"
msgstr "  Soujyuro kept walking and did not even look back at Tobimaru as he spoke."

#. Occurrence 8_1:3879:10686: scene=8_1
#: 8_1:3879
msgctxt "text_id=10686 | speaker=unknown"
msgid "　鳶丸と木乃美は首をかしげながらも、めずらしく強引な草十郎に従った。"
msgstr "  Tobimaru and Kinomi tilted their heads in confusion as they reluctantly followed the unusually aggressive Soujyuro back to their cleaning spot."

#. Occurrence 8_2:47:10687: scene=8_2
#: 8_2:47
msgctxt "text_id=10687 | speaker=unknown"
msgid "　これといった快事も不祥事もなく、本日の特別清掃班の活動は終了した。"
msgstr "  And so, the Special Winter Cleaning Team's activities ended uneventfully."

#. Occurrence 8_2:52:10688: scene=8_2
#: 8_2:52
msgctxt "text_id=10688 | speaker=unknown"
msgid "　ただいまの時刻、午後三時。"
msgstr "  The time was three in the afternoon."

#. Occurrence 8_2:57:10689: scene=8_2
#: 8_2:57
msgctxt "text_id=10689 | speaker=unknown"
msgid "　別れ際、草十郎は木乃美たちから遊びに誘われたが、夕方からアルバイトが入っている、と丁寧に断った。"
msgstr "  Upon departing, Kinomi and his crew invited Soujyuro to come hang out with them, but he declined politely due to his job that evening."

#. Occurrence 8_2:78:10690: scene=8_2
#: 8_2:78
msgctxt "text_id=10690 | speaker=unknown"
msgid "　夕方からのバイトまであと二時間ほど。"
msgstr "  He had about two hours until his shift began."

#. Occurrence 8_2:83:10691: scene=8_2
#: 8_2:83
msgctxt "text_id=10691 | speaker=unknown"
msgid "　遊ぶほどの時間はないが、さりとて、暇つぶしには持て余す長さと言える。"
msgstr "  Not quite enough time to do anything fun, but just enough time to have to fill it with something."

#. Occurrence 8_2:110:10692: scene=8_2
#: 8_2:110
msgctxt "text_id=10692 | speaker=unknown"
msgid "　公園で体を休める、という考えも浮かんだが、町中でも冬の寒さはそれなりに堪えるので却下。"
msgstr "  Soujyuro thought about relaxing in a park somewhere, but quickly changed his mind after remembering how cold it was, even in the city."

#. Occurrence 8_2:130:10693: scene=8_2
#: 8_2:130
msgctxt "text_id=10693 | speaker=unknown"
msgid "　ちなみに、例の錠剤は朝のうちに青子から手渡されていた。"
msgstr "  Not to forget that Aoko handed him those pills in the morning."

#. Occurrence 8_2:135:10694: scene=8_2
#: 8_2:135
msgctxt "text_id=10694 | speaker=unknown"
msgid "　青子の読みはまったく正しい。今から洋館に戻ってもすぐとんぼ返りになるだけである。"
msgstr "  Aoko was absolutely correct in her prediction. Heading back to the mansion now would just be a waste of time."

#. Occurrence 8_2:140:10695: scene=8_2
#: 8_2:140
msgctxt "text_id=10695 | speaker=unknown"
msgid "　骨折り損のなんとやらで、アルバイトを終えるまで洋館に戻る必要はまったくない。"
msgstr "  There was no reason for him to return to the mansion until after his shift at work."

#. Occurrence 8_2:183:10696: scene=8_2
#: 8_2:183
msgctxt "text_id=10696 | speaker=unknown"
msgid "　―――まったくないのだが、草十郎はすんなり帰途についていた。"
msgstr "  Still, Soujyuro found himself on the way back anyway."

#. Occurrence 8_2:188:10697: scene=8_2
#: 8_2:188
msgctxt "text_id=10697 | speaker=unknown"
msgid "　山奥育ちにとって、二時間程度の散歩は苦でもなんでもないのである。"
msgstr "  Having grown up deep in the mountains, a little two hour walk was really no sweat off his back."

#. Occurrence 8_2:221:10698: scene=8_2
#: 8_2:221
msgctxt "text_id=10698 | speaker=unknown"
msgid "　この三咲町は三咲市の中でも閑静な住宅地に入る。"
msgstr "  Misaki was one of the more quiet residential areas in Misaki City."

#. Occurrence 8_2:226:10699: scene=8_2
#: 8_2:226
msgctxt "text_id=10699 | speaker=unknown"
msgid "　その中でひときわ異質なのがここ白犬塚だ。"
msgstr "  The only thing that really stood out here was Shiroinuzuka."

#. Occurrence 8_2:231:10700: scene=8_2
#: 8_2:231
msgctxt "text_id=10700 | speaker=unknown"
msgid "　森に向かうひとつきりの坂道。"
msgstr "  It was a hill that lead directly into the woods."

#. Occurrence 8_2:236:10701: scene=8_2
#: 8_2:236
msgctxt "text_id=10701 | speaker=unknown"
msgid "　住宅地の奥にそびえる山影は、物言わずとも人々の営みを威圧している。"
msgstr "  The silhouette of the mountains served as backdrop to suburbia, silently overshadowing the small human actions of the people who lived there."

#. Occurrence 8_2:256:10702: scene=8_2
#: 8_2:256
msgctxt "text_id=10702 | speaker=unknown"
msgid "　近代化の進む現代においても、自然への<崇拝|すうはい>は住民たちの心に根付いている。"
msgstr "  Even in this modern day of technological progress, the people here were always careful to pay reverence to the nature around them."

#. Occurrence 8_2:261:10703: scene=8_2
#: 8_2:261
msgctxt "text_id=10703 | speaker=unknown"
msgid "　あの洋館も、何らかの<社|やしろ>であれば幽霊屋敷などではなく、霊験あらたかな観光名所になっていたかもしれない。"
msgstr "  If that mansion were a shrine, it would not be a haunted house but a famous tourist attraction."

#. Occurrence 8_2:282:10704: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_2_0000; voice_prefix=A30; voice_category=3; scene=8_2
#: 8_2:282
msgctxt "text_id=10704 | speaker=soujuurou"
msgid "「……というより、今さら気付いたけど……」"
msgstr "\"...Wait, I just realized something.\""

#. Occurrence 8_2:288:10705: scene=8_2
#: 8_2:288
msgctxt "text_id=10705 | speaker=unknown"
msgid "　白犬塚周辺の家は、どれもたいへん立派である。"
msgstr "  The houses around Shiroinuzuka were all magnificent."

#. Occurrence 8_2:293:10706: scene=8_2
#: 8_2:293
msgctxt "text_id=10706 | speaker=unknown"
msgid "　人々の住む坂の下から、森の中にある洋館の屋根を見上げ、なるほど、と草十郎は納得した。"
msgstr "  Soujyuro understood as he looked from the bottom of this hill where the rest of the town lived at the roof of the mansion tucked away in the woods."

#. Occurrence 8_2:298:10707: scene=8_2
#: 8_2:298
msgctxt "text_id=10707 | speaker=unknown"
msgid "　鳶丸の言う通り、あの洋館を所有する久遠寺家はこの町一番のお金持ちなのだ、と。"
msgstr "  He understood what Tobimaru was talking about, about how the Kuonji family who owned that mansion might be the richest people in town."

#. Occurrence 8_2:319:10708: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_2_0001; voice_prefix=A30; voice_category=3; scene=8_2
#: 8_2:319
msgctxt "text_id=10708 | speaker=soujuurou"
msgid "「……そのわりに家賃を取るところを見ると、やっぱり嫌われていると見るべきか」"
msgstr "\"They really do hate me. Why else would they ask for rent?\""

#. Occurrence 8_2:325:10709: scene=8_2
#: 8_2:325
msgctxt "text_id=10709 | speaker=unknown"
msgid "　ふむ、とそんな事を考えつつ、草十郎は洋館への坂道を歩きはじめた。"
msgstr "  Soujyuro began walking towards the mansion with such thoughts simmering in his mind."

#. Occurrence 8_2:330:10710: scene=8_2
#: 8_2:330
msgctxt "text_id=10710 | speaker=unknown"
msgid "　土の感触のないアスファルトの道が少し<淋|さみ>しい。"
msgstr "  The feeling of the hard asphalt beneath his feet instead of soft dirt felt lonely and isolating."

#. Occurrence 8_2:375:10711: scene=8_2
#: 8_2:375
msgctxt "text_id=10711 | speaker=unknown"
msgid "　舗装された道を十分ほど歩いて、森の鉄柵にたどり着く。"
msgstr "  He walked along the paved road for ten minutes or so before reaching the iron fence of the wood."

#. Occurrence 8_2:380:10712: scene=8_2
#: 8_2:380
msgctxt "text_id=10712 | speaker=unknown"
msgid "　この先は久遠寺の私有地だ。"
msgstr "  Beyond this fence was the private property of the Kuonji family."

#. Occurrence 8_2:385:10713: scene=8_2
#: 8_2:385
msgctxt "text_id=10713 | speaker=unknown"
msgid "　関係者以外立ち入り禁止、といった不粋な看板はない。"
msgstr "  It was bereft of any awkward no-trespassing signs."

#. Occurrence 8_2:390:10714: scene=8_2
#: 8_2:390
msgctxt "text_id=10714 | speaker=unknown"
msgid "　ただ、訪れた者の精神を圧迫する、いかつい鉄柵が<人避|ひとよ>けの結界となっている。"
msgstr "  The tall, overbearing iron fence was more than enough to remind visitors that they were unwelcome there."

#. Occurrence 8_2:423:10715: scene=8_2
#: 8_2:423
msgctxt "text_id=10715 | speaker=unknown"
msgid "　そんな鉄柵を、草十郎は気軽に押し開ける。"
msgstr "  Soujyuro casually pushed on the iron gate."

#. Occurrence 8_2:428:10716: scene=8_2
#: 8_2:428
msgctxt "text_id=10716 | speaker=unknown"
msgid "　期末試験が終わってからまだ二日しか経っていないのに、ひとりでこの森に入る事に慣れきった風である。"
msgstr "  Only two days had passed since the end of final exams, and he already seemed more than comfortable with the idea of entering this wood alone."

#. Occurrence 8_2:458:10717: scene=8_2
#: 8_2:458
msgctxt "text_id=10717 | speaker=unknown"
msgid "　森から洋館までの林道は、やはり蛇のように曲がりくねっている。"
msgstr "  The path to the mansion from inside the wood curved and bent like a snake."

#. Occurrence 8_2:463:10718: scene=8_2
#: 8_2:463
msgctxt "text_id=10718 | speaker=unknown"
msgid "　林道を使うと洋館の敷地まで約十五分。"
msgstr "  It took about fifteen minutes to reach the mansion on this path."

#. Occurrence 8_2:468:10719: scene=8_2
#: 8_2:468
msgctxt "text_id=10719 | speaker=unknown"
msgid "　なだらかな坂道を無視して森を一直線に歩いてもいいのだが、その場合、疲労は何倍にもなる。火急の用でもないかぎり、林道を使うのが常識的だ。"
msgstr "  He could have chosen to ignore the long incline and travel in a straight line through the wood, but he would have expended significantly more energy in doing so. No, using the wooded path was the sensible option, barring an emergency."

#. Occurrence 8_2:542:10720: scene=8_2
#: 8_2:542
msgctxt "text_id=10720 | speaker=unknown"
msgid "　ロビーに入ると、居間から話し声が聞こえてきた。"
msgstr "  Upon entering the foyer, Soujyuro heard a conversation coming from the drawing room."

#. Occurrence 8_2:547:10721: scene=8_2
#: 8_2:547
msgctxt "text_id=10721 | speaker=unknown"
msgid "　青子と有珠のものであるのは間違いなく、とりあえず草十郎は居間へと向かう。"
msgstr "  It was no doubt Aoko and Alice. Soujyuro decided to join them."

#. Occurrence 8_2:582:10722: scene=8_2
#: 8_2:582
msgctxt "text_id=10722 | speaker=unknown"
msgid "　期末試験が終わった日から、青子と有珠の生活スタイルは日常から非日常へと切り替わっていた。"
msgstr "  Ever since final exams had ended, Aoko and Alice had switched from their daily routine to a more irregular schedule."

#. Occurrence 8_2:589:10723: scene=8_2
#: 8_2:589
msgctxt "text_id=10723 | speaker=unknown"
msgid "　青子が有珠の部屋……館の西館、左翼一帯……に行ったきり戻ってこなかったり、"
msgstr "  Aoko would disappear into Alice's room in the west wing of the mansion for a while, where she would remain,"

#. Occurrence 8_2:596:10724: scene=8_2
#: 8_2:596
msgctxt "text_id=10724 | speaker=unknown"
msgid "　有珠が青子の部屋に入ったきり出てこなかったりと、"
msgstr "  and Alice would go into Aoko's room, not to be seen again."

#. Occurrence 8_2:601:10725: scene=8_2
#: 8_2:601
msgctxt "text_id=10725 | speaker=unknown"
msgid "　絶対立ち入り禁止とされる屋敷裏手に回る廊下の先に向かったりと、草十郎の知らないところで絶賛活動中だ。"
msgstr "  Or they would vanish into the corridors leading around to the rear of the mansion doing who knows what, where Soujyuro was most certainly not allowed to enter."

#. Occurrence 8_2:635:10726: scene=8_2
#: 8_2:635
msgctxt "text_id=10726 | speaker=unknown"
msgid "　もっとも、草十郎はそれに関わる気もないし、青子たちも関わらせる気もないので、今のところ問題はない。"
msgstr "  Not that he was interested in what they were doing since Aoko and Alice did not seem to want to include him either, serving both parties nicely."

#. Occurrence 8_2:640:10727: scene=8_2
#: 8_2:640
msgctxt "text_id=10727 | speaker=unknown"
msgid "　久遠寺邸はとりあえず平穏である。"
msgstr "  For the time being, the Kuonji Estate was pretty peaceful."

#. Occurrence 8_2:698:10728: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_2_0002; voice_prefix=A30; voice_category=3; scene=8_2
#: 8_2:698
msgctxt "text_id=10728 | speaker=soujuurou"
msgid "「ただいま」"
msgstr "\"I'm home.\""

#. Occurrence 8_2:704:10729: scene=8_2
#: 8_2:704
msgctxt "text_id=10729 | speaker=unknown"
msgid "　草十郎は静かに居間の扉を開けた。"
msgstr "  Soujyuro quietly opened the door to the drawing room."

#. Occurrence 8_2:709:10730: scene=8_2
#: 8_2:709
msgctxt "text_id=10730 | speaker=unknown"
msgid "　お互い関わらないようにしているといっても、挨拶はきちんとする。それが彼の方針である。"
msgstr "  Even though they tried not to be involved in each other's business, Soujyuro made it a habit to greet them."

#. Occurrence 8_2:744:10731: scene=8_2
#: 8_2:744
msgctxt "text_id=10731 | speaker=unknown"
msgid "　ふたりは向かい合うかたちでソファーに座っていた。"
msgstr "  The two girls sat across from him on the sofa."

#. Occurrence 8_2:749:10732: scene=8_2
#: 8_2:749
msgctxt "text_id=10732 | speaker=unknown"
msgid "　テーブルの上には豪華な装飾をした、大きな鏡が置かれている。"
msgstr "  On the table in front of them was a large, extravagantly decorated mirror."

#. Occurrence 8_2:754:10733: scene=8_2
#: 8_2:754
msgctxt "text_id=10733 | speaker=unknown"
msgid "　青子の服装は動きやすさを重視したもので、下はスカートではなくジーンズを穿いていた。"
msgstr "  Aoko was dressed for comfort; wearing jeans instead of her usual skirt."

#. Occurrence 8_2:759:10734: scene=8_2
#: 8_2:759
msgctxt "text_id=10734 | speaker=unknown"
msgid "　そんな青子とは対照的に、有珠はいつもの黒衣のままだ。"
msgstr "  In stark contrast, Alice was dressed in her usual all black."

#. Occurrence 8_2:764:10735: scene=8_2
#: 8_2:764
msgctxt "text_id=10735 | speaker=unknown"
msgid "　学校はとっくに休みに入っているというが、<頑|かたく>なにあの黒衣を通している。"
msgstr "  Even though the break from school was well underway, the witch still insisted on wearing black."

#. Occurrence 8_2:800:10736: scene=8_2
#: 8_2:800
msgctxt "text_id=10736 | speaker=unknown"
msgid "　青子曰く、「単に面倒だからでしょ」とのコト。"
msgstr "  As Aoko had explained, it was probably because it was too much effort for Alice to wear anything else."

#. Occurrence 8_2:805:10737: scene=8_2
#: 8_2:805
msgctxt "text_id=10737 | speaker=unknown"
msgid "　少しは違う服装を見たいな、と思う草十郎である。"
msgstr "  Soujyuro's thought was that he would like to see her wear something different."

#. Occurrence 8_2:836:10738: scene=8_2
#: 8_2:836
msgctxt "text_id=10738 | speaker=unknown"
msgid "　何か口論していたようで、居間の雰囲気はどこか張り詰めていた。"
msgstr "  Aoko and Alice seemed to be in the middle of some sort of dispute; the air in the drawing room was tense."

#. Occurrence 8_2:841:10739: scene=8_2
#: 8_2:841
msgctxt "text_id=10739 | speaker=unknown"
msgid "　草十郎の挨拶にも反応しない。"
msgstr "  They both ignored his greeting."

#. Occurrence 8_2:846:10740: scene=8_2
#: 8_2:846
msgctxt "text_id=10740 | speaker=unknown"
msgid "　ただ有珠がちらり、と草十郎に視線を向けただけだった。"
msgstr "  Alice only briefly looked up at him."

#. Occurrence 8_2:876:10741: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0000; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:876
msgctxt "text_id=10741 | speaker=aoko"
msgid "「じゃあ<陶川|とうかわ>の<支点|してん>は？　あそこの柱は白色だし、そう簡単には奪われないでしょう？」"
msgstr "\"Hmm, what about the Toukawa point? That pillar is white, so hopefully it won't be so easy to remove.\""

#. Occurrence 8_2:890:10742: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0000; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:890
msgctxt "text_id=10742 | speaker=alice"
msgid "「……ええ。今のところ陶川は侵食されていないけど、ひとつ隣りの<鈴穂|すずほ>の支点が消された以上、楽観はできないわ。"
msgstr "\"...Yes. The Toukawa one is still active, but the Suzuho support next to it has gone, so we can't really be too careful."

#. Occurrence 8_2:890:10743: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0000; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:890
msgctxt "text_id=10743 | speaker=alice"
msgid "　残りの割り出しは今までより早くなる」"
msgstr "  With each sigil they discover, they get better at finding the others.\""

#. Occurrence 8_2:910:10744: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0001; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:910
msgctxt "text_id=10744 | speaker=aoko"
msgid "「そっか。一個釣れれば、あとは芋づる式だもんね。"
msgstr "\"That makes sense. I guess once they've found one, they can easily find the other connections."

#. Occurrence 8_2:927:10745: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0002; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:927
msgctxt "text_id=10745 | speaker=aoko"
msgid "　……反省したわ。甘く見てたのはこっちの方だった。ここからは、一週間単位の攻防になるわね」"
msgstr "  ...I really messed up. I should have been more careful. This is going to turn into a weekly battle soon.\""

#. Occurrence 8_2:963:10746: scene=8_2
#: 8_2:963
msgctxt "text_id=10746 | speaker=unknown"
msgid "　テーブルを挟んでの会話は続く。"
msgstr "  The two continued their heated discussion from opposite sides of the table."

#. Occurrence 8_2:968:10747: scene=8_2
#: 8_2:968
msgctxt "text_id=10747 | speaker=unknown"
msgid "　青子は帰ってきた草十郎を見ようともしない。"
msgstr "  Aoko neglected to even glance up at Soujyuro."

#. Occurrence 8_2:973:10748: scene=8_2
#: 8_2:973
msgctxt "text_id=10748 | speaker=unknown"
msgid "　それとも話に集中するため、気を配る必要性を感じていないだけか。"
msgstr "  Soujyuro sensed that she wanted to concentrate on the discussion at hand."

#. Occurrence 8_2:1017:10749: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0003; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:1017
msgctxt "text_id=10749 | speaker=aoko"
msgid "「……でも解せないな。"
msgstr "\"...It's so strange, though."

#. Occurrence 8_2:1023:10750: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0004; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:1023
msgctxt "text_id=10750 | speaker=aoko"
msgid "　あの夜に人形をだしてくるタイミングといい、隠し方だけは一級品なうちの支点を短期間で特定する事といい、コイツ、まず間違いなく市内に<隠れ家|アジト>を敷いてるわよね。"
msgstr "  Setting aside the timing of the puppet that night and how quickly they were able to find our expertly hidden sigil, whoever it is most definitely has to have some kind of hideout in the city."

#. Occurrence 8_2:1029:10751: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0005; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:1029
msgctxt "text_id=10751 | speaker=aoko"
msgid "　なのになんで結界に異常がないんだろう。三咲市一帯の索敵網は、もう百年近く破られた事がないのに」"
msgstr "  But if that's the case, why aren't we detecting any abnormalities in the field? The dragnet around Misaki City hasn't been broken for nearly a hundred years.\""

#. Occurrence 8_2:1058:10752: scene=8_2
#: 8_2:1058
msgctxt "text_id=10752 | speaker=unknown"
msgid "　爪をかむ青子に、有珠は小さくうなずいた。"
msgstr "  Aoko bit her nails nervously, while Alice nodded along."

#. Occurrence 8_2:1063:10753: scene=8_2
#: 8_2:1063
msgctxt "text_id=10753 | speaker=unknown"
msgid "　彼女も青子と同じ疑問を持っているらしい。"
msgstr "  It seemed as though she was wondering the same thing."

#. Occurrence 8_2:1090:10754: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0001; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:1090
msgctxt "text_id=10754 | speaker=alice"
msgid "「……母もここの結界には触れなかった。"
msgstr "\"...Even my mother wasn't able to touch this Bounded Field."

#. Occurrence 8_2:1096:10755: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0002; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:1096
msgctxt "text_id=10755 | speaker=alice"
msgid "　三咲の結界をかいくぐるには貴女のお<祖父|じい>さんか、それ以上の技量を持つ魔術師でないと難しい。"
msgstr "  The only person capable of getting through Misaki's Bounded Field would have been your grandfather or an even more capable mage."

#. Occurrence 8_2:1103:10756: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0003; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:1103
msgctxt "text_id=10756 | speaker=alice"
msgid "けど、それほどの魔術師なら逆に<魔力|けはい>は隠しきれない。"
msgstr "But someone exuding that level of magical energy would find it that much harder to cover his or her tracks."

#. Occurrence 8_2:1115:10757: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0004; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:1115
msgctxt "text_id=10757 | speaker=alice"
msgid "　……なにか特殊な<隠行法|おんぎょうほう>かもしれないわね。ここ数年、新しい<妖精環|サークル>の話は聞かないけど」"
msgstr "  ...It could be some kind of unique concealment ward, but I haven't heard anything about any new faerie circles forming these past few years.\""

#. Occurrence 8_2:1151:10758: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0006; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:1151
msgctxt "text_id=10758 | speaker=aoko"
msgid "「なに、シャーウッドの森？　<皐|メ><月|イ><の|キ><王|ン><様|グ>なら以前、有珠の霧が粉砕したじゃない。アレ以上の隠行があるっていうの？」"
msgstr "\"Where was it, Sherwood Forest? The May King was able to break through your mist, remember? Do you think there's some sort of concealment stronger than that?\""

#. Occurrence 8_2:1170:10759: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0005; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:1170
msgctxt "text_id=10759 | speaker=alice"
msgid "「例えばの話よ。今回の相手はこちら以上の技量を持っているか、こちらの知らない技術を持っているか。"
msgstr "\"All I'm saying is if whoever we're dealing with has skills greater than our own, maybe there are some techniques we aren't aware of."

#. Occurrence 8_2:1188:10760: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0006; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:1188
msgctxt "text_id=10760 | speaker=alice"
msgid "　どちらにせよ評価を改めるべきね。わたしたち、気づかないうちに追い詰められているのかも」"
msgstr "  Either way we need to reevaluate things. We might be under more pressure than we thought.\""

#. Occurrence 8_2:1218:10761: scene=8_2
#: 8_2:1218
msgctxt "text_id=10761 | speaker=unknown"
msgid "　ふたりはそれきり黙りこむ。"
msgstr "  The two fell silent."

#. Occurrence 8_2:1223:10762: scene=8_2
#: 8_2:1223
msgctxt "text_id=10762 | speaker=unknown"
msgid "　草十郎はしばし迷ってから、もう一度声をかけてみる事にした。"
msgstr "  Soujyuro, after some internal deliberation, decided to break the silence."

#. Occurrence 8_2:1258:10763: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_2_0003; voice_prefix=A30; voice_category=3; scene=8_2
#: 8_2:1258
msgctxt "text_id=10763 | speaker=soujuurou"
msgid "「やあ、ただいま」"
msgstr "\"So... I'm home.\""

#. Occurrence 8_2:1263:10764: scene=8_2
#: 8_2:1263
msgctxt "text_id=10764 | speaker=unknown"
msgid "　遠慮がちなその一言に、青子はようやく草十郎に視線を向けた。"
msgstr "  Aoko finally looked up at him in response to his hesitant declaration."

#. Occurrence 8_2:1294:10765: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0007; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:1294
msgctxt "text_id=10765 | speaker=aoko"
msgid "「いいからお風呂に入ってきたら？　汚れてるわよ、草十郎」"
msgstr "\"That's fine, Soujyuro, but will you please take a bath? You're dirty.\""

#. Occurrence 8_2:1324:10766: scene=8_2
#: 8_2:1324
msgctxt "text_id=10766 | speaker=unknown"
msgid "　それだけ言って、青子は鏡に視線を戻す。"
msgstr "  And with that, Aoko returned her gaze to the mirror."

#. Occurrence 8_2:1329:10767: scene=8_2
#: 8_2:1329
msgctxt "text_id=10767 | speaker=unknown"
msgid "　有珠はもう一度だけちらりと草十郎に視線を向けたあと、テーブルの上の鏡に見入った。"
msgstr "  Alice briefly looked up at Soujyuro again before also returning her gaze to the mirror."

#. Occurrence 8_2:1347:10768: scene=8_2
#: 8_2:1347
msgctxt "text_id=10768 | speaker=unknown"
msgid "　とりあえず挨拶を済ませて満足したのか、草十郎はぱたんと扉を閉め、居間を<後|あと>にした。"
msgstr "  Perhaps feeling at least somewhat satisfied that his greeting was acknowledged, Soujyuro left the drawing room and closed the door behind him."

#. Occurrence 8_2:1393:10769: scene=8_2
#: 8_2:1393
msgctxt "text_id=10769 | speaker=unknown"
msgid "　青子の言う通り、服の端々はわずかに汚れていた。"
msgstr "  Aoko was right. His clothes were a little soiled."

#. Occurrence 8_2:1399:10770: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_2_0004; voice_prefix=A30; voice_category=3; scene=8_2
#: 8_2:1399
msgctxt "text_id=10770 | speaker=soujuurou"
msgid "「……そうだな。もったいないけど、確かに」"
msgstr "\"...It's a waste of water, but I guess I should.\""

#. Occurrence 8_2:1410:10771: scene=8_2
#: 8_2:1410
msgctxt "text_id=10771 | speaker=unknown"
msgid "　別に汗をかいた訳でもないが、この寒さの中での湯浴みはちょっと楽しそうだ、と草十郎は自室に戻る。"
msgstr "  Soujyuro returned to his room, thinking that a bath might actually feel pretty nice in this cold weather, despite not really having broken a sweat at all during the day."

#. Occurrence 8_2:1457:10772: scene=8_2
#: 8_2:1457
msgctxt "text_id=10772 | speaker=unknown"
msgid "　ロビーから二階へ、さらに階段を上がって屋根裏の部屋に入る。"
msgstr "  He climbed the stairs from the foyer and up the second flight into the attic."

#. Occurrence 8_2:1498:10773: scene=8_2
#: 8_2:1498
msgctxt "text_id=10773 | speaker=unknown"
msgid "　ここは他の部屋と違い余計な装飾がない。"
msgstr "  Unlike the other rooms in the mansion, this one had no frills to its decor."

#. Occurrence 8_2:1503:10774: scene=8_2
#: 8_2:1503
msgctxt "text_id=10774 | speaker=unknown"
msgid "　暮らすにはいささか不便だが、草十郎にとっては落ち着ける場所でもある。"
msgstr "  It was a little cumbersome to use as a living space, but comfortable enough for Soujyuro."

#. Occurrence 8_2:1508:10775: scene=8_2
#: 8_2:1508
msgctxt "text_id=10775 | speaker=unknown"
msgid "　洋館はどこもかしこも豪華すぎて気を遣うのだろう。"
msgstr "  Everywhere else in the mansion was a little too gaudy for his tastes."

#. Occurrence 8_2:1513:10776: scene=8_2
#: 8_2:1513
msgctxt "text_id=10776 | speaker=unknown"
msgid "　経緯はどうあれ寝泊りする部屋に関してなら、草十郎はたいへん満足していた。"
msgstr "  As far as shelter and a place to sleep went, Soujyuro was more than satisfied with his accommodations."

#. Occurrence 8_2:1547:10777: scene=8_2
#: 8_2:1547
msgctxt "text_id=10777 | speaker=unknown"
msgid "　屋根裏には電気は通っていない。"
msgstr "  There was no electricity in the attic."

#. Occurrence 8_2:1552:10778: scene=8_2
#: 8_2:1552
msgctxt "text_id=10778 | speaker=unknown"
msgid "　明かりは小さな天窓だけだ。"
msgstr "  The only light was that which crept in from a small skylight."

#. Occurrence 8_2:1557:10779: scene=8_2
#: 8_2:1557
msgctxt "text_id=10779 | speaker=unknown"
msgid "　が、そもそも電灯に馴染めない草十郎にとって、それはどうでもいい事だ。"
msgstr "  Not that Soujyuro minded. He was more accustomed to living without electricity than living with it."

#. Occurrence 8_2:1562:10780: scene=8_2
#: 8_2:1562
msgctxt "text_id=10780 | speaker=unknown"
msgid "　冬の暗い日射しだけをたよりに着替えとタオルを用意して、ロビーへとって返す。"
msgstr "  With only the faint winter light to guide him, he readied a change of clothes and a towel before heading down to the foyer."

#. Occurrence 8_2:1608:10781: scene=8_2
#: 8_2:1608
msgctxt "text_id=10781 | speaker=unknown"
msgid "　これだけ大きな建物なのに、館には浴場が一つしかない。"
msgstr "  Despite the magnificent size of the mansion, there was only one bath in the whole building."

#. Occurrence 8_2:1613:10782: scene=8_2
#: 8_2:1613
msgctxt "text_id=10782 | speaker=unknown"
msgid "　その浴場もあまり広くないので、館の設計者は風呂を重要視しなかったのだろう。あるいは、湯浴みに馴染みがなかったのか。"
msgstr "  And not a particularly large one at that. Whoever the architect was, he or she must not have thought a bath to be so important, or perhaps they were not the bath type."

#. Occurrence 8_2:1645:10783: scene=8_2
#: 8_2:1645
msgctxt "text_id=10783 | speaker=unknown"
msgid "　草十郎はロビーまで下り、階段の裏側に回りこむ。"
msgstr "  Soujyuro descended to the foyer and made his way to the back of the stairs."

#. Occurrence 8_2:1651:10784: scene=8_2
#: 8_2:1651
msgctxt "text_id=10784 | speaker=unknown"
msgid "　浴場へ続く扉をノックする。当然ながら返事はない。二人はいまも居間で会議中である。"
msgstr "  He knocked on the door to the bath. As expected, there was no answer from the other side. The only other two occupants of the mansion were still talking in the drawing room."

#. Occurrence 8_2:1657:10785: scene=8_2
#: 8_2:1657
msgctxt "text_id=10785 | speaker=unknown"
msgid "　それを確認して、軽い足取りで草十郎は中へと入っていった。"
msgstr "  After confirming it was unoccupied, Soujyuro quietly entered the bathroom."

#. Occurrence 8_2:1703:10786: scene=8_2
#: 8_2:1703
msgctxt "text_id=10786 | speaker=unknown"
msgid "　彼らしい話ではあるが。"
msgstr "  Even though Soujyuro was not aware of it himself, as was common for him, "

#. Occurrence 8_2:1708:10787: scene=8_2
#: 8_2:1708
msgctxt "text_id=10787 | speaker=unknown"
msgid "　山から下りて出来た唯一の趣味が湯浴みであるという事を、草十郎本人はまだ自覚していなかった。"
msgstr "  the only hobby he had acquired since coming down from the mountain was taking a nice, relaxing bath."

#. Occurrence 8_2:1771:10788: scene=8_2
#: 8_2:1771
msgctxt "text_id=10788 | speaker=unknown"
msgid "　草十郎が去った後も、少女たちの協議は続いていた。"
msgstr "  Soujyuro had left, but the two girls were still locked in their heated discussion."

#. Occurrence 8_2:1777:10789: scene=8_2
#: 8_2:1777
msgctxt "text_id=10789 | speaker=unknown"
msgid "　議題は言うまでもなく、先月から三咲市に現れた外部の魔術師について。"
msgstr "  Needless to say, the topic of their conversation was still that of the outsider mage who had appeared in Misaki City last month."

#. Occurrence 8_2:1782:10790: scene=8_2
#: 8_2:1782
msgctxt "text_id=10790 | speaker=unknown"
msgid "　<目撃者|そうじゅうろう>の一件で中断されていた、彼女たち本来の責務……管理地を奪いに来た略奪者への対応、その排除である。"
msgstr "  This was, after all, the problem that had occupied their time before this whole situation with Soujyuro arose―dealing with and eliminating the interloper who had set his or her sights on their territory."

#. Occurrence 8_2:1814:10791: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0008; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:1814
msgctxt "text_id=10791 | speaker=aoko"
msgid "「……今までは囮にばっかり食いついてたから甘く見てたけど……それも計算尽くだったのかしらね。"
msgstr "\"...All this time we'd been preoccupied by a decoy. No doubt also a part of their plan."

#. Occurrence 8_2:1821:10792: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0009; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:1821
msgctxt "text_id=10792 | speaker=aoko"
msgid "こっちが油断してる隙に、本命を一つ奪われた。"
msgstr "Then, while we're distracted, they've crept in and stolen another one."

#. Occurrence 8_2:1833:10793: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0010; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:1833
msgctxt "text_id=10793 | speaker=aoko"
msgid "　この<魔|あ><術|い><師|て>との戦いは、これからが本番ってコトか」"
msgstr "  The fight against this mage has only just begun.\""

#. Occurrence 8_2:1865:10794: scene=8_2
#: 8_2:1865
msgctxt "text_id=10794 | speaker=unknown"
msgid "　事態は深刻化している。"
msgstr "  The situation was growing more dire by the day."

#. Occurrence 8_2:1870:10795: scene=8_2
#: 8_2:1870
msgctxt "text_id=10795 | speaker=unknown"
msgid "　敵魔術師は二日前までの散漫的な小競り合いから、巧みな攻勢に転じてきていた。"
msgstr "  Until only a couple of days ago, the enemy had limited themselves to small skirmishes. But now they had shifted to a full-on offensive."

#. Occurrence 8_2:1890:10796: scene=8_2
#: 8_2:1890
msgctxt "text_id=10796 | speaker=unknown"
msgid "　青子たちには、大きく分けて二つの結界の守りがある。"
msgstr "  Aoko had two major Bounded Fields she used for defense."

#. Occurrence 8_2:1906:10797: scene=8_2
#: 8_2:1906
msgctxt "text_id=10797 | speaker=unknown"
msgid "　一つは三咲市一帯に張られた、魔力・魔術の働きを測定する大結界。"
msgstr "  One, the larger of the two, was placed around Misaki City to detect magical energy and magecraft."

#. Occurrence 8_2:1911:10798: scene=8_2
#: 8_2:1911
msgctxt "text_id=10798 | speaker=unknown"
msgid "　これは外部からの来訪者を把握、監視する為のもので、管理地のオーナーである蒼崎の先祖が敷いた、消しようのない機能だ。"
msgstr "  This was used to observe and monitor visitors from outside the city, and was initially set up by Aozaki's ancestors, the administrators of this territory, and had no way to be removed."

#. Occurrence 8_2:1931:10799: scene=8_2
#: 8_2:1931
msgctxt "text_id=10799 | speaker=unknown"
msgid "　もう一つは土地の霊脈を生かし、その力を管理するもの。"
msgstr "  The other was set up to energize and manage leylines from within the territory."

#. Occurrence 8_2:1936:10800: scene=8_2
#: 8_2:1936
msgctxt "text_id=10800 | speaker=unknown"
msgid "　大地に刻まれた五つの支点によって、そのサークルの内部を守る典型的な方陣である。"
msgstr "  The five sigils carved into the earth made up a standard square-type array, protecting all that lay within its bounds."

#. Occurrence 8_2:1953:10801: scene=8_2
#: 8_2:1953
msgctxt "text_id=10801 | speaker=unknown"
msgid "　人為的に<大|マ><源|ナ>の流れに手を加え、その力の終点が久遠寺邸に集まる―――ありていにいえば、三咲市における魔力を独占する為の結界だ。"
msgstr "  After some manipulation of the mana flow, the power within was directed to accumulate at the Kuonji Estate. That is to say, the Bounded Field existed to monopolize the magical energy within Misaki City."

#. Occurrence 8_2:1973:10802: scene=8_2
#: 8_2:1973
msgctxt "text_id=10802 | speaker=unknown"
msgid "　支点は久遠寺邸を中心にして、全部で五点。"
msgstr "  There were five sigils in total, with the Kuonji Estate located in the center."

#. Occurrence 8_2:1978:10803: scene=8_2
#: 8_2:1978
msgctxt "text_id=10803 | speaker=unknown"
msgid "　これを全て退去させられた場合、青子たちの『管理地の持ち主』という事実は、文字通り、ただの肩書きになり下がる。"
msgstr "  If all five sigils were forcibly removed, Aoko's jurisdiction over this territory would be in title only."

#. Occurrence 8_2:1984:10804: scene=8_2
#: 8_2:1984
msgctxt "text_id=10804 | speaker=unknown"
msgid "　土地のバックアップを失った管理人は、外部から現れた略奪者と同じ条件になり―――個人の力量だけで、敵を撃退しなければならなくなるのだ。"
msgstr "  Without the power of the land to back them up, they would be forced to fight back against their invaders on equal ground, with only their own innate abilities to protect them."

#. Occurrence 8_2:2016:10805: scene=8_2
#: 8_2:2016
msgctxt "text_id=10805 | speaker=unknown"
msgid "　有珠はともかく、まだ未熟な青子が管理地を死守できているのは、この二つに頼るところが大きい。"
msgstr "  The only reason Alice and the inexperienced Aoko were able to defend this territory so far was because of these two fields."

#. Occurrence 8_2:2022:10806: scene=8_2
#: 8_2:2022
msgctxt "text_id=10806 | speaker=unknown"
msgid "　とくに蒼崎に伝わる<索敵網|だいけっかい>は彼女の生命線ですらある。"
msgstr "  The dragnet that notified Aozaki of any threats was also her lifeline."

#. Occurrence 8_2:2027:10807: scene=8_2
#: 8_2:2027
msgctxt "text_id=10807 | speaker=unknown"
msgid "　が、今回の敵はこの大結界の目をかいくぐり、好き勝手<町|まち>を<跋扈|ばっこ>していた。"
msgstr "  But this time, their enemy had somehow slipped through the cracks and was running rampant."

#. Occurrence 8_2:2032:10808: scene=8_2
#: 8_2:2032
msgctxt "text_id=10808 | speaker=unknown"
msgid "　結果、彼女たちはこうして受けに回っている。"
msgstr "  This was what the girls had to face up to."

#. Occurrence 8_2:2075:10809: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0007; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2075
msgctxt "text_id=10809 | speaker=alice"
msgid "「……どちらにせよ時間の問題ね。"
msgstr "\"Either way, it's just a matter of time at this point."

#. Occurrence 8_2:2082:10810: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0008_0; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2082
msgctxt "text_id=10810 | speaker=alice"
msgid "　支点がすべて潰されたら、いよいよ<洋|こ><館|こ>での籠城になるけど……"
msgstr "  Once all the sigils are destroyed, this mansion will be our last stronghold of defense."

#. Occurrence 8_2:2094:10811: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0008_1; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2094
msgctxt "text_id=10811 | speaker=alice"
msgid "いいの、青子？」"
msgstr " Are you okay with that, Aoko?\""

#. Occurrence 8_2:2135:10812: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0011; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2135
msgctxt "text_id=10812 | speaker=aoko"
msgid "「？　別にいいんじゃないの？　有珠の言う通り、残りの支点を消されるのは時間の問題なんだし。"
msgstr "\"I mean, what other choice do we have? Like you said, it's only a matter of time before the sigils are destroyed."

#. Occurrence 8_2:2147:10813: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0012; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2147
msgctxt "text_id=10813 | speaker=aoko"
msgid "　そりゃ<魔術師|てき>の<隠れ家|アジト>を発見できれば御の字だけど、それは絶対必要ってワケでもないでしょ。支点を消されても私にはあんまり関係ないし」"
msgstr "  Our best chance would be to find their hideout, but it's not exactly a necessity. They can remove the sigils for all I care.\""

#. Occurrence 8_2:2174:10814: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0013; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2174
msgctxt "text_id=10814 | speaker=aoko"
msgid "「なにより、館の守りはアンタがいるかぎり万全だしね。"
msgstr "\"As long as you're here then the mansion itself shouldn't be a problem to defend."

#. Occurrence 8_2:2180:10815: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0014; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2180
msgctxt "text_id=10815 | speaker=aoko"
msgid "　あっちの方からやって来てくれるなら、それこそ飛んで火にいる、よ。"
msgstr "  And if they do, then they're marching to their own demise."

#. Occurrence 8_2:2202:10816: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0015; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2202
msgctxt "text_id=10816 | speaker=aoko"
msgid "　他に心配事なんてないでしょ？」"
msgstr "  What else is there to worry about?\""

#. Occurrence 8_2:2263:10817: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0009; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2263
msgctxt "text_id=10817 | speaker=alice"
msgid "「……そうね。敵が一人だけなら、その時は鏡の範囲を<洋館|ここ>に集中させて、戦場にすればいい。わたしたちにとって、その方が有利だったわ」"
msgstr "\"...Nothing, I suppose. With only a single opponent to deal with, we're better off focusing the field of the mirror on the estate, and making this mansion our last line of defense.\""

#. Occurrence 8_2:2293:10818: scene=8_2
#: 8_2:2293
msgctxt "text_id=10818 | speaker=unknown"
msgid "　有珠はその白い指で、テーブルに置かれた鏡に触れる。"
msgstr "  Alice touched the mirror on the table with her pale fingers."

#. Occurrence 8_2:2298:10819: scene=8_2
#: 8_2:2298
msgctxt "text_id=10819 | speaker=unknown"
msgid "　途端、水のように波立つ鏡面。"
msgstr "  The surface of the mirror rippled like water."

#. Occurrence 8_2:2386:10820: scene=8_2
#: 8_2:2386
msgctxt "text_id=10820 | speaker=unknown"
msgid "　蒼崎の結界とは別の、三咲市の守り神。"
msgstr "  The mirror was another protector of Misaki City, separate from Aozaki's Bounded Fields."

#. Occurrence 8_2:2391:10821: scene=8_2
#: 8_2:2391
msgctxt "text_id=10821 | speaker=unknown"
msgid "　正しくは三咲市ではなく、久遠寺有珠だけを守る“童話の怪物”。濃霧を生み、訪れる者をゲーム盤の世界に<誘|いざな>う招待状。"
msgstr "  More accurately, it was a Ploy that existed only to protect Alice Kuonji rather than Misaki City itself. It generated a thick fog and acted as an invitation to any visitors, drawing them in to its board game-like world."

#. Occurrence 8_2:2396:10822: scene=8_2
#: 8_2:2396
msgctxt "text_id=10822 | speaker=unknown"
msgid "　持ち主である少女は鏡とだけ呼び、"
msgstr "  Alice referred to it only as \"the mirror,\""

#. Occurrence 8_2:2401:10823: scene=8_2
#: 8_2:2401
msgctxt "text_id=10823 | speaker=unknown"
msgid "　少女の友人に<午睡|ごすい>の鏡と名付けられた、"
msgstr "  but it was known to her friends as the Mirror of Slumber."

#. Occurrence 8_2:2406:10824: scene=8_2
#: 8_2:2406
msgctxt "text_id=10824 | speaker=unknown"
msgid "　久遠寺有珠の扱う魔術である。"
msgstr "  This was a magecraft that Alice Kuonji wielded."

#. Occurrence 8_2:2459:10825: scene=8_2
#: 8_2:2459
msgctxt "text_id=10825 | speaker=unknown"
msgid "　波打つ鏡面には、一つの城と多くの森、平原と川が浮かび上がっている。"
msgstr "  Within the rippling surface of the mirror, an image of a castle began to form and also a lush forest, a field, and a river."

#. Occurrence 8_2:2464:10826: scene=8_2
#: 8_2:2464
msgctxt "text_id=10826 | speaker=unknown"
msgid "　その様子を無言で眺めていた青子だったが、"
msgstr "  Aoko stared at the mirror in silence"

#. Occurrence 8_2:2491:10827: scene=8_2
#: 8_2:2491
msgctxt "text_id=10827 | speaker=unknown"
msgid "　突然、よし、とばかりにソファーから立ち上がった。"
msgstr "  before suddenly jumping to her feet off the sofa."

#. Occurrence 8_2:2526:10828: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0016; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2526
msgctxt "text_id=10828 | speaker=aoko"
msgid "「そうと決まれば、<後|あと>は行動あるのみね。"
msgstr "\"Now that that's all decided, we can get back to actually doing stuff."

#. Occurrence 8_2:2532:10829: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0017; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2532
msgctxt "text_id=10829 | speaker=aoko"
msgid "　出かけるわよ有珠。とにかく現場を見ない事には始まらない」"
msgstr "  I'm going out, Alice. We can't do anything until we have eyes on the ground.\""

#. Occurrence 8_2:2563:10830: scene=8_2
#: 8_2:2563
msgctxt "text_id=10830 | speaker=unknown"
msgid "　決意に満ちた青子の声に、有珠は気だるげに吐息をもらして、鏡面をさらりと<撫|な>でる。"
msgstr "  Alice let out a tired sigh in response to Aoko's determination, then gave the mirror a gentle caress."

#. Occurrence 8_2:2570:10831: scene=8_2
#: 8_2:2570
msgctxt "text_id=10831 | speaker=unknown"
msgid "　……とぷ、と水の騒ぐ音。"
msgstr "  ...The sound of dripping water filled the room."

#. Occurrence 8_2:2575:10832: scene=8_2
#: 8_2:2575
msgctxt "text_id=10832 | speaker=unknown"
msgid "　鏡は有珠の<一|ひと><撫|な>でで濃霧に包まれ、テーブルに沈み消えた。"
msgstr "  The mirror began to consume the table in a thick fog with a single caress from Alice."

#. Occurrence 8_2:2609:10833: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0010; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2609
msgctxt "text_id=10833 | speaker=alice"
msgid "「順番に回るのなら、帰るのは朝になるわね」"
msgstr "\"If we're visiting each sigil, we definitely won't be back until morning.\""

#. Occurrence 8_2:2634:10834: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0018; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2634
msgctxt "text_id=10834 | speaker=aoko"
msgid "「まあまあ、そう億劫がらないで。"
msgstr "\"Nah. We'll be home in no time!"

#. Occurrence 8_2:2646:10835: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0019; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2646
msgctxt "text_id=10835 | speaker=aoko"
msgid "　ところで有珠、火の五芒星の退去ってこうだっけ」"
msgstr "  Oh right, I meant to ask you. Is this the proper way to do a fire pentagram banishment?\""

#. Occurrence 8_2:2665:10836: scene=8_2
#: 8_2:2665
msgctxt "text_id=10836 | speaker=unknown"
msgid "　青子は中空に指を滑らせる。"
msgstr "  Aoko traced a shape in the air with her fingers."

#. Occurrence 8_2:2670:10837: scene=8_2
#: 8_2:2670
msgctxt "text_id=10837 | speaker=unknown"
msgid "　上から始まって右下へ、右下から左上、左上から……と星型の軌跡が描かれる。"
msgstr "  She mimed a star shape starting from the top, moving down and to the right, from there to the upper left, and so on."

#. Occurrence 8_2:2696:10838: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0011; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2696
msgctxt "text_id=10838 | speaker=alice"
msgid "「……そろそろ壊すこと以外も覚えないと駄目よ、青子」"
msgstr "\"It's about time you learned something other than how to break things, Aoko.\""

#. Occurrence 8_2:2717:10839: scene=8_2
#: 8_2:2717
msgctxt "text_id=10839 | speaker=unknown"
msgid "　ため息をつきながら、有珠もソファーから腰をあげる。"
msgstr "  Alice sat up from the sofa, letting out a heavy sigh."

#. Occurrence 8_2:2743:10840: scene=8_2
#: 8_2:2743
msgctxt "text_id=10840 | speaker=unknown"
msgid "　ふたりは<上着掛け|コートハンガー>からそれぞれのコートを手に取り、居間を後にする。"
msgstr "  They both took their coats from their hangers and left the drawing room."

#. Occurrence 8_2:2787:10841: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0020; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2787
msgctxt "text_id=10841 | speaker=aoko"
msgid "「失礼ね、私だって日々成長してるわよ。"
msgstr "\"Well, excuse me. I guess I need to study some more on top of all the studying I already do."

#. Occurrence 8_2:2794:10842: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0021; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2794
msgctxt "text_id=10842 | speaker=aoko"
msgid "この<間|あいだ>のお<呪|まじな>いだってちゃんと成功したんだから」"
msgstr "Remember that charm I pulled off just the other day?\""

#. Occurrence 8_2:2812:10843: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0012; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2812
msgctxt "text_id=10843 | speaker=alice"
msgid "「……お呪い？」"
msgstr "\"...What charm?\""

#. Occurrence 8_2:2829:10844: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0022; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2829
msgctxt "text_id=10844 | speaker=aoko"
msgid "「簡単な暗示の呪文。"
msgstr "\"That simple Mesmerize."

#. Occurrence 8_2:2835:10845: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0023; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2835
msgctxt "text_id=10845 | speaker=aoko"
msgid "　ほら、有珠が教えてくれた、空<気のおも|かるく、よわく>り、胸<のふる|うまく、はやく>え。ひ<かりは先|チクタクチクタク>立つ、か<げは遅れ|いそげやいそげ>る。ってヤツ」"
msgstr "  You know, the one you taught me. 'Light and frail, nimble and quick. Tick-tock, tick-tock, there's no time to waste.' That one!\""

#. Occurrence 8_2:2867:10846: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0013; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2867
msgctxt "text_id=10846 | speaker=alice"
msgid "「………………それ、本当？」"
msgstr "\"...Are you being serious right now?\""

#. Occurrence 8_2:2873:10847: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0024; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2873
msgctxt "text_id=10847 | speaker=aoko"
msgid "「ホントもホント。後で草十郎に聞いてみなさい」"
msgstr "\"Yes, I'm serious! You can ask Soujyuro later if you don't believe me.\""

#. Occurrence 8_2:2884:10848: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0014; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2884
msgctxt "text_id=10848 | speaker=alice"
msgid "「…………………………」"
msgstr "\"...\""

#. Occurrence 8_2:2889:10849: scene=8_2
#: 8_2:2889
msgctxt "text_id=10849 | speaker=unknown"
msgid "　有珠は納得のいかない面持ちで、喉まで出かけた言葉を飲みこんだ。"
msgstr "  Alice swallowed her words, clearly displeased."

#. Occurrence 8_2:2894:10850: scene=8_2
#: 8_2:2894
msgctxt "text_id=10850 | speaker=unknown"
msgid "　特に話題にする事でもない、とギリギリで疑問を止められたのだろう。"
msgstr "  She likely stopped herself in time to realize it was not worth the effort to take issue with it."

#. Occurrence 8_2:2920:10851: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_2_0015; voice_prefix=A40; voice_category=2; scene=8_2
#: 8_2:2920
msgctxt "text_id=10851 | speaker=alice"
msgid "「……けど。留守中、その彼はどうするの？」"
msgstr "\"On the topic, what will he do while we're away?\""

#. Occurrence 8_2:2939:10852: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_2_0025; voice_prefix=A10; voice_category=1; scene=8_2
#: 8_2:2939
msgctxt "text_id=10852 | speaker=aoko"
msgid "「大丈夫でしょ。有珠の西館と開かずの間に入らなきゃ即死するような事は……」"
msgstr "\"He'll be fine. As long as he doesn't try to go into the west wing or anything like that, there shouldn't be any immediate threat to his...\""

#. Occurrence 8_2:2946:10853: scene=8_2
#: 8_2:2946
msgctxt "text_id=10853 | speaker=unknown"
msgid "　青子は答えながらロビーに通じる扉を開ける。"
msgstr "  Aoko responded hastily as she opened the door to the foyer."

#. Occurrence 8_2:2977:10854: scene=8_2
#: 8_2:2977
msgctxt "text_id=10854 | speaker=unknown"
msgid "　直後。"
msgstr "  As soon as she did..."

#. Occurrence 8_2:2982:10855: scene=8_2
#: 8_2:2982
msgctxt "text_id=10855 | speaker=unknown"
msgid "　突然の疑問に声をあげる有珠のように、青子の喉は凍りついた。"
msgstr "  Just as quickly as Alice's doubts had gotten stuck in her throat, Aoko suddenly froze, unable to speak."

#. Occurrence 8_3:130:10856: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0000; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:130
msgctxt "text_id=10856 | speaker=aoko"
msgid "「……………、ですって？」"
msgstr "\"...What?\""

#. Occurrence 8_3:136:10857: scene=8_3
#: 8_3:136
msgctxt "text_id=10857 | speaker=unknown"
msgid "　それが誰なのか、青子は咄嗟に思いつけなかった。"
msgstr "  For a moment, Aoko wasn't sure who was standing before her."

#. Occurrence 8_3:171:10858: scene=8_3
#: 8_3:171
msgctxt "text_id=10858 | speaker=unknown"
msgid "　不意打ち気味の<当惑|とうわく>に<眩|くら>みながら、午後の<斜光|さしび>を眺めている事しかできない。"
msgstr "  She could only stare at the glinting rays of sunlight creeping into the room as she reeled from the shock."

#. Occurrence 8_3:178:10859: scene=8_3
#: 8_3:178
msgctxt "text_id=10859 | speaker=unknown"
msgid "　びっくり箱に驚いた時のような、"
msgstr "  Her mind was completely blank."

#. Occurrence 8_3:200:10860: scene=8_3
#: 8_3:200
msgctxt "text_id=10860 | speaker=unknown"
msgid "　寝起きの時のような空白。"
msgstr "  It was as if she had just woken up from a nap, or a jack-in-the-box had just opened in her face."

#. Occurrence 8_3:205:10861: scene=8_3
#: 8_3:205
msgctxt "text_id=10861 | speaker=unknown"
msgid "　そんな沈黙がどれだけ続いたのか、正確に知り得たのは、当の人影だけだろう。"
msgstr "  Soujyuro was probably the only person who truly knew how long that dumbfounded silence went on."

#. Occurrence 8_3:251:10862: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0001; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:251
msgctxt "text_id=10862 | speaker=aoko"
msgid "「……アンタ、こんなところで何してるのよ、いったい」"
msgstr "\"...What the hell are you doing standing there like that?\""

#. Occurrence 8_3:257:10863: scene=8_3
#: 8_3:257
msgctxt "text_id=10863 | speaker=unknown"
msgid "　どれほどか経って、ようやく青子は口を開いた。"
msgstr "  Aoko had finally found her voice."

#. Occurrence 8_3:297:10864: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0000; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:297
msgctxt "text_id=10864 | speaker=soujuurou"
msgid "「何って、着替えてるんだけど」"
msgstr "\"What? I'm changing clothes.\""

#. Occurrence 8_3:303:10865: scene=8_3
#: 8_3:303
msgctxt "text_id=10865 | speaker=unknown"
msgid "　青子の質問に、その人影は平然と答えた。"
msgstr "  Soujyuro's response was matter-of-fact."

#. Occurrence 8_3:308:10866: scene=8_3
#: 8_3:308
msgctxt "text_id=10866 | speaker=unknown"
msgid "　なぜ脱衣場ではなくロビーで着替えているのか、その経緯を説明しないまま。"
msgstr "  He offered no explanation as to why he was changing in the foyer and not the bathroom."

#. Occurrence 8_3:348:10867: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0002; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:348
msgctxt "text_id=10867 | speaker=aoko"
msgid "「………………」"
msgstr "\"...\""

#. Occurrence 8_3:353:10868: scene=8_3
#: 8_3:353
msgctxt "text_id=10868 | speaker=unknown"
msgid "　そんな草十郎に一声……率直に言うと怒鳴り……あげなくてはいけないのに、青子は言葉を止めてしまう。"
msgstr "  Aoko was too shocked to read him the riot act."

#. Occurrence 8_3:389:10869: scene=8_3
#: 8_3:389
msgctxt "text_id=10869 | speaker=unknown"
msgid "　今まで浴場にいたであろう彼は、ちょうどシャツを着ようとしているところだった。"
msgstr "  Soujyuro was putting a shirt on after presumably just getting out from the bath."

#. Occurrence 8_3:394:10870: scene=8_3
#: 8_3:394
msgctxt "text_id=10870 | speaker=unknown"
msgid "　上半身<裸|はだか>で、首には布が巻かれている。"
msgstr "  His neck was wrapped in bandages, and he was completely shirtless."

#. Occurrence 8_3:399:10871: scene=8_3
#: 8_3:399
msgctxt "text_id=10871 | speaker=unknown"
msgid "　髪は濡れているものの、肌に上気したところは見られない。おそらく水で体を洗ったのだろう。"
msgstr "  His hair was wet, but his skin wasn't glistening from the steam of hot water. He must have washed himself with nothing more than cold water."

#. Occurrence 8_3:426:10872: scene=8_3
#: 8_3:426
msgctxt "text_id=10872 | speaker=unknown"
msgid "　この寒空によく、と呆れるところだが、そんな<所感|しょかん>は些細な事だ。"
msgstr "  Though shocked as to why anyone would do such a thing in this cold weather, she let it slide."

#. Occurrence 8_3:431:10873: scene=8_3
#: 8_3:431
msgctxt "text_id=10873 | speaker=unknown"
msgid "　<沈黙|おどろき>は、純粋に彼の体に起因する。"
msgstr "  The source of her silent stupor was simply his body."

#. Occurrence 8_3:458:10874: scene=8_3
#: 8_3:458
msgctxt "text_id=10874 | speaker=unknown"
msgid "　今まで線の細い人畜無害っぷりだったのに、<装飾|ようふく>を取ればこの通り、弱々しいイメージなど見られない。"
msgstr "  Until now, she'd only seen him as harmless. Without his clothing to hide him, however, he was more fit than she'd ever imagined."

#. Occurrence 8_3:463:10875: scene=8_3
#: 8_3:463
msgctxt "text_id=10875 | speaker=unknown"
msgid "　何事も体が資本な山育ちなら、むしろ鍛え方が足りないのかもしれないが、青子にとっては予想外の体つきだった。"
msgstr "  For a rough mountain upbringing where one's body and strength meant survival, perhaps he was even a bit underdeveloped."

#. Occurrence 8_3:468:10876: scene=8_3
#: 8_3:468
msgctxt "text_id=10876 | speaker=unknown"
msgid "　それと、おまけに、"
msgstr "  And on top of that..."

#. Occurrence 8_3:515:10877: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0003; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:515
msgctxt "text_id=10877 | speaker=aoko"
msgid "「……それ、傷跡なの？」"
msgstr "\"...Are those scars?\""

#. Occurrence 8_3:521:10878: scene=8_3
#: 8_3:521
msgctxt "text_id=10878 | speaker=unknown"
msgid "　青子は恐る恐る口にする。"
msgstr "  Aoko asked cautiously."

#. Occurrence 8_3:537:10879: scene=8_3
#: 8_3:537
msgctxt "text_id=10879 | speaker=unknown"
msgid "　草十郎はうん？　と視線を落とした。"
msgstr "  Soujyuro followed her gaze."

#. Occurrence 8_3:542:10880: scene=8_3
#: 8_3:542
msgctxt "text_id=10880 | speaker=unknown"
msgid "　彼の腕にはうっすらと火傷の跡らしきものがある。"
msgstr "  He had something that looked like a burn scar on his arm."

#. Occurrence 8_3:547:10881: scene=8_3
#: 8_3:547
msgctxt "text_id=10881 | speaker=unknown"
msgid "　青子の魔術刻印のような秩序のある紋様ではなく、不幸な事故を思わせる<斑|まだら>模様。"
msgstr "  It was random in appearance, nothing like Aoko's Magic Crest with its ordered patterns."

#. Occurrence 8_3:582:10882: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0001; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:582
msgctxt "text_id=10882 | speaker=soujuurou"
msgid "「ああ、これか。ずいぶん前に野犬の群れに襲われて、噛みつかれたんだ。命があっただけでも幸運だから、傷跡ぐらいはご愛敬だ」"
msgstr "\"Oh, this? A long time ago I was attacked by a pack of wild dogs and they bit me. It's a miracle I'm even still alive, so if anything I'm fond of the scar.\""

#. Occurrence 8_3:602:10883: scene=8_3
#: 8_3:602
msgctxt "text_id=10883 | speaker=unknown"
msgid "　……ずいぶん前、とは子供の頃の出来事らしい。"
msgstr "  A long time ago... He must be talking about when he was a child."

#. Occurrence 8_3:607:10884: scene=8_3
#: 8_3:607
msgctxt "text_id=10884 | speaker=unknown"
msgid "　<一命|いちめい>は取り留めたものの、彼の住んでいた山奥では満足な治療もできなかったのだろう。"
msgstr "  Though his life was saved, it was apparent that he hadn't been able to receive proper treatment deep in the mountains where he lived."

#. Occurrence 8_3:640:10885: scene=8_3
#: 8_3:640
msgctxt "text_id=10885 | speaker=unknown"
msgid "　その傷跡は消えていない。"
msgstr "  Those scars were proof of that."

#. Occurrence 8_3:645:10886: scene=8_3
#: 8_3:645
msgctxt "text_id=10886 | speaker=unknown"
msgid "　何年も前に受けてあの状態なら、もう一<生涯|しょうがい>変わらないだろう。"
msgstr "  Considering it had happened so many years ago, it was likely they would never fade."

#. Occurrence 8_3:650:10887: scene=8_3
#: 8_3:650
msgctxt "text_id=10887 | speaker=unknown"
msgid "　……半面、肌に残る野性の<傷|あ><痕|と>は、無駄のない体に相応しかった。直視した彼女が、たとえ一瞬だけだろうと、感じ入った程度には。"
msgstr "  If only for an instant, Aoko thought the wild scars left on his skin suited his lean body perfectly."

#. Occurrence 8_3:683:10888: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0002; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:683
msgctxt "text_id=10888 | speaker=soujuurou"
msgid "「……たしかにあまり気持ちのいいものじゃないな。"
msgstr "\"...I know it's not pleasant to look at."

#. Occurrence 8_3:683:10889: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0002; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:683
msgctxt "text_id=10889 | speaker=soujuurou"
msgid "　自分の部屋で着替えるべきだった」"
msgstr "  I should have just changed in my own room.\""

#. Occurrence 8_3:689:10890: scene=8_3
#: 8_3:689
msgctxt "text_id=10890 | speaker=unknown"
msgid "　無言で固まった青子を見て、草十郎はシャツを着ながら、少しだけ恥じ入るように弁明した。"
msgstr "  Soujyuro sounded slightly ashamed as he put on his shirt, looking at Aoko standing there in cold silence."

#. Occurrence 8_3:694:10891: scene=8_3
#: 8_3:694
msgctxt "text_id=10891 | speaker=unknown"
msgid "　ふたりからは何の返答もない。"
msgstr "  The two girls had no response."

#. Occurrence 8_3:704:10892: scene=8_3
#: 8_3:704
msgctxt "text_id=10892 | speaker=unknown"
msgid "　草十郎は自分の部屋に戻ろうと階段に向かう。"
msgstr "  Soujyuro headed for the stairs to go back to his room."

#. Occurrence 8_3:749:10893: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0004; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:749
msgctxt "text_id=10893 | speaker=aoko"
msgid "「ちょ、ちょっと待って、草十郎」"
msgstr "\"W-Wait a second, Soujyuro.\""

#. Occurrence 8_3:762:10894: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0003; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:762
msgctxt "text_id=10894 | speaker=soujuurou"
msgid "「？」"
msgstr "\"Hm?\""

#. Occurrence 8_3:767:10895: scene=8_3
#: 8_3:767
msgctxt "text_id=10895 | speaker=unknown"
msgid "　足を止めて振り返る草十郎。"
msgstr "  Soujyuro stopped and turned around."

#. Occurrence 8_3:779:10896: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0005; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:779
msgctxt "text_id=10896 | speaker=aoko"
msgid "「え―――あ、うん、なんていうか―――」"
msgstr "\"Ummm, so, how do I say this...\""

#. Occurrence 8_3:790:10897: scene=8_3
#: 8_3:790
msgctxt "text_id=10897 | speaker=unknown"
msgid "　自分でも呼び止めた意図が分からず、青子は気まずそうに視線を逸らす。"
msgstr "  Aoko looked away awkwardly, apparently not knowing why she had stopped him herself."

#. Occurrence 8_3:827:10898: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0004; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:827
msgctxt "text_id=10898 | speaker=soujuurou"
msgid "「？？　……なんか蒼崎らしくない。"
msgstr "\"Huh? This isn't like you, Aozaki."

#. Occurrence 8_3:833:10899: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0005; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:833
msgctxt "text_id=10899 | speaker=soujuurou"
msgid "　さっきからヘンだけど、熱でもあるんじゃないのか？"
msgstr "  You're acting strange. Did you get a fever or something?"

#. Occurrence 8_3:833:10900: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0005; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:833
msgctxt "text_id=10900 | speaker=soujuurou"
msgid "　あれから満足に寝てないだろ、ふたりとも」"
msgstr "  I bet neither of you have gotten enough sleep since all that, have you?\""

#. Occurrence 8_3:839:10901: scene=8_3
#: 8_3:839
msgctxt "text_id=10901 | speaker=unknown"
msgid "　あれから、とは期末試験からの話である。"
msgstr "  He was of course referring to the final exams."

#. Occurrence 8_3:844:10902: scene=8_3
#: 8_3:844
msgctxt "text_id=10902 | speaker=unknown"
msgid "　草十郎から見ると、青子の働きぶりは“おかしい”“ヘンな人”レベルの扱いになっているらしい。"
msgstr "  From Soujyuro's perspective, the amount of work Aoko put in seemed strange."

#. Occurrence 8_3:880:10903: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0006; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:880
msgctxt "text_id=10903 | speaker=aoko"
msgid "「ね、熱なんてないったらっ！"
msgstr "\"I-I don't have a fever!"

#. Occurrence 8_3:886:10904: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0007; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:886
msgctxt "text_id=10904 | speaker=aoko"
msgid "　そうじゃなくて―――ど、どうしてこんなところで着替えてたのよ、アンタはっ！」"
msgstr "  That's not what this is about... I just want to know why the hell you're changing clothes here!\""

#. Occurrence 8_3:912:10905: scene=8_3
#: 8_3:912
msgctxt "text_id=10905 | speaker=unknown"
msgid "　目に見えてとりつくろう青子。"
msgstr "  Aoko was doing her best to keep up appearances."

#. Occurrence 8_3:917:10906: scene=8_3
#: 8_3:917
msgctxt "text_id=10906 | speaker=unknown"
msgid "　一方―――"
msgstr "  But..."

#. Occurrence 8_3:941:10907: scene=8_3
#: 8_3:941
msgctxt "text_id=10907 | speaker=unknown"
msgid "　なぜか、そんな青子以上に言いよどむ草十郎。"
msgstr "  For some reason, Soujyuro was hesitant to say too much more."

#. Occurrence 8_3:962:10908: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0006; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:962
msgctxt "text_id=10908 | speaker=soujuurou"
msgid "「それは、その。"
msgstr "\"So, well, this isn't easy to say..."

#. Occurrence 8_3:968:10909: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0007; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:968
msgctxt "text_id=10909 | speaker=soujuurou"
msgid "　……言いづらいんだが、下着の管理は、きちんとした方がいいと思う。どっちだかは知らないけど」"
msgstr "  But you need to take care of your underwear better. I don't know whose it is, though.\""

#. Occurrence 8_3:996:10910: scene=8_3
#: 8_3:996
msgctxt "text_id=10910 | speaker=unknown"
msgid "　草十郎の台詞に、今まで青子の後ろで黙っていた有珠がぴくりと反応した。"
msgstr "  Alice, who had been completely silent behind Aoko, couldn't resist responding to that statement."

#. Occurrence 8_3:1001:10911: scene=8_3
#: 8_3:1001
msgctxt "text_id=10911 | speaker=unknown"
msgid "　我関せずを貫くつもりだった彼女も、今の台詞は無視できなかったらしい。"
msgstr "  Although she hadn't wanted to get involved, this was something she couldn't ignore."

#. Occurrence 8_3:1042:10912: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_3_0000; voice_prefix=A40; voice_category=2; scene=8_3
#: 8_3:1042
msgctxt "text_id=10912 | speaker=alice"
msgid "「言っておくけど、それは青子だから」"
msgstr "\"I must point out, it was most definitely Aoko.\""

#. Occurrence 8_3:1048:10913: scene=8_3
#: 8_3:1048
msgctxt "text_id=10913 | speaker=unknown"
msgid "　あまりにも素早い正当性の主張だった。"
msgstr "  Alice's response was quick and to the point."

#. Occurrence 8_3:1090:10914: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0008; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:1090
msgctxt "text_id=10914 | speaker=aoko"
msgid "「……洗濯の当番は、たしかに私だったけど」"
msgstr "\"...I may have been in charge of laundry, but...\""

#. Occurrence 8_3:1096:10915: scene=8_3
#: 8_3:1096
msgctxt "text_id=10915 | speaker=unknown"
msgid "　その後に何か続きそうな、険悪極まりない青子の切り返しである。"
msgstr "  Aoko seemed like she was just holding back on going critical."

#. Occurrence 8_3:1117:10916: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_3_0008; voice_prefix=A30; voice_category=3; scene=8_3
#: 8_3:1117
msgctxt "text_id=10916 | speaker=soujuurou"
msgid "「とにかく、もうすぐアルバイトだから着替えてくる」"
msgstr "\"Anyway, I really have to get dressed, or I'm going to be late for work.\""

#. Occurrence 8_3:1123:10917: scene=8_3
#: 8_3:1123
msgctxt "text_id=10917 | speaker=unknown"
msgid "　そんなふたりの言い合いに破滅の前兆を感じ取り、素早く戦場から離脱する草十郎。"
msgstr "  Sensing that those two were probably about to get into an argument, Soujyuro took his chance to leave."

#. Occurrence 8_3:1159:10918: scene=8_3
#: 8_3:1159
msgctxt "text_id=10918 | speaker=unknown"
msgid "　かくて、人騒がせな人影は早足で去っていった。"
msgstr "  And with that, Soujyuro briskly left the scene."

#. Occurrence 8_3:1233:10919: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0009; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:1233
msgctxt "text_id=10919 | speaker=aoko"
msgid "「……………有珠」"
msgstr "\"...Alice.\""

#. Occurrence 8_3:1244:10920: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_3_0001; voice_prefix=A40; voice_category=2; scene=8_3
#: 8_3:1244
msgctxt "text_id=10920 | speaker=alice"
msgid "「……………とりあえず、片づけてくるわ」"
msgstr "\"...I'll go clean up.\""

#. Occurrence 8_3:1255:10921: scene=8_3
#: 8_3:1255
msgctxt "text_id=10921 | speaker=unknown"
msgid "　一見して冷静なまま、有珠は脱衣場に消えていった。"
msgstr "  Alice calmly walked into the bathroom."

#. Occurrence 8_3:1292:10922: scene=8_3
#: 8_3:1292
msgctxt "text_id=10922 | speaker=unknown"
msgid "　数分後。"
msgstr "  A few minutes later..."

#. Occurrence 8_3:1308:10923: scene=8_3
#: 8_3:1308
msgctxt "text_id=10923 | speaker=unknown"
msgid "　気を取り直し、魔術師として外出しようとする直前、思いだしたように青子は相方の少女に訊ねた。"
msgstr "  Just as the two were about to head out and fulfill their duties as mages, Aoko remembered something she wanted to ask."

#. Occurrence 8_3:1329:10924: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0010; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:1329
msgctxt "text_id=10924 | speaker=aoko"
msgid "「そうだ有珠。傷ってアレの事？」"
msgstr "\"Alice, do you think those scars were...?\""

#. Occurrence 8_3:1344:10925: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_3_0002; voice_prefix=A40; voice_category=2; scene=8_3
#: 8_3:1344
msgctxt "text_id=10925 | speaker=alice"
msgid "「……アレは傷跡じゃないわ。"
msgstr "\"...I don't think so."

#. Occurrence 8_3:1350:10926: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_3_0003; voice_prefix=A40; voice_category=2; scene=8_3
#: 8_3:1350
msgctxt "text_id=10926 | speaker=alice"
msgid "　だって、あんなにも誇らしいもの」"
msgstr "  He seemed so proud, after all.\""

#. Occurrence 8_3:1370:10927: scene=8_3
#: 8_3:1370
msgctxt "text_id=10927 | speaker=unknown"
msgid "　たしかに、と青子は思う。"
msgstr "  Aoko agreed."

#. Occurrence 8_3:1375:10928: scene=8_3
#: 8_3:1375
msgctxt "text_id=10928 | speaker=unknown"
msgid "　あの傷跡に感じ入ったのは、彼本人が過去の出来事として受け入れ、何の後悔も持っていなかったからだ。"
msgstr "  What had impressed her the most about those scars was how he treated them simply as a part of his past, absent of any regret."

#. Occurrence 8_3:1391:10929: scene=8_3
#: 8_3:1391
msgctxt "text_id=10929 | speaker=unknown"
msgid "　それを有珠のように誇らしい、とは思えなかった青子だが、一瞬だけよぎった印象に間違いはなかったらしい。"
msgstr "  Aoko wouldn't have gone so far as to say he was proud, but it seemed her instincts had been correct."

#. Occurrence 8_3:1396:10930: scene=8_3
#: 8_3:1396
msgctxt "text_id=10930 | speaker=unknown"
msgid "　それと、もう一つ。"
msgstr "  That, and one more thing."

#. Occurrence 8_3:1422:10931: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0011; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:1422
msgctxt "text_id=10931 | speaker=aoko"
msgid "「でも一つだけはっきりしたわ。"
msgstr "\"One thing is clear, though."

#. Occurrence 8_3:1428:10932: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0012; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:1428
msgctxt "text_id=10932 | speaker=aoko"
msgid "　それじゃあ、不覚にも見惚れてたのは私ひとりじゃなかったってコトよね、有珠？」"
msgstr "  I wasn't the only one who was pleasantly surprised at what I saw. Was I, Alice?\""

#. Occurrence 8_3:1464:10933: scene=8_3
#: 8_3:1464
msgctxt "text_id=10933 | speaker=unknown"
msgid "　<悪戯|いたずら>の共犯の事実を求めるように、青子は楽しげに問いかける。"
msgstr "  Aoko smiled wryly at Alice, like a child who knew they were doing something they shouldn't with their friend."

#. Occurrence 8_3:1469:10934: scene=8_3
#: 8_3:1469
msgctxt "text_id=10934 | speaker=unknown"
msgid "　一部始終、我関せずと無視していた少女に向かって。"
msgstr "  Alice was trying to ignore her as best she could."

#. Occurrence 8_3:1474:10935: scene=8_3
#: 8_3:1474
msgctxt "text_id=10935 | speaker=unknown"
msgid "　有珠は答えず、ただ視線を逸らしただけだった。"
msgstr "  She looked away without saying a word."

#. Occurrence 8_3:1479:10936: scene=8_3
#: 8_3:1479
msgctxt "text_id=10936 | speaker=unknown"
msgid "　それで満足いったのか、青子はくすりと<微笑|わら>って玄関へ歩きだす。"
msgstr "  Aoko let out a satisfied snicker and began walking towards the front door."

#. Occurrence 8_3:1524:10937: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0013; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:1524
msgctxt "text_id=10937 | speaker=aoko"
msgid "「じゃ、行こうか。まずはあの公園からでいいでしょ？"
msgstr "\"Let's get going. We should probably start at that park, right?"

#. Occurrence 8_3:1524:10938: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_3_0013; voice_prefix=A10; voice_category=1; scene=8_3
#: 8_3:1524
msgctxt "text_id=10938 | speaker=aoko"
msgid "　今回の件は、あそこから全てが始まったわけだし」"
msgstr "  Since that's where this all started.\""

#. Occurrence 8_3:1530:10939: scene=8_3
#: 8_3:1530
msgctxt "text_id=10939 | speaker=unknown"
msgid "　三咲町の公園。"
msgstr "  She was talking about the local park in Misaki."

#. Occurrence 8_3:1550:10940: scene=8_3
#: 8_3:1550
msgctxt "text_id=10940 | speaker=unknown"
msgid "　奇しくもそこは、敵の人形とも、草十郎とも関わりが始まった因縁の土地である。"
msgstr "  The place where they had run into the enemy puppets and, of course, where their involvement with Soujyuro had all begun."

#. Occurrence 8_4:64:10941: scene=8_4
#: 8_4:64
msgctxt "text_id=10941 | speaker=unknown"
msgid "　翌日、早朝。"
msgstr "  Early the next morning..."

#. Occurrence 8_4:69:10942: scene=8_4
#: 8_4:69
msgctxt "text_id=10942 | speaker=unknown"
msgid "　まだ多くの人々が眠りについている午前五時。"
msgstr "  It was five o'clock in the morning. Most people were still in their beds sleeping."

#. Occurrence 8_4:74:10943: scene=8_4
#: 8_4:74
msgctxt "text_id=10943 | speaker=unknown"
msgid "　去年あたりから二十四時間営業のコンビニエンスストアがぽつぽつと現れてはいるが、三咲町は古き良き八十年代前期の色が濃い。"
msgstr "  Although some twenty-four hour convenience stores had opened last year, Misaki Town was still very much living in the good old days of the early eighties."

#. Occurrence 8_4:79:10944: scene=8_4
#: 8_4:79
msgctxt "text_id=10944 | speaker=unknown"
msgid "　商店街で一番の早起きと言われる豆腐屋ですら、店開きは六時からだ。"
msgstr "  Even the tofu shop in the shopping district, known for opening earlier than anywhere else, didn't open until six."

#. Occurrence 8_4:99:10945: scene=8_4
#: 8_4:99
msgctxt "text_id=10945 | speaker=unknown"
msgid "　八十年代後半。"
msgstr "  But this was the late eighties, during the latter half of Japan's bubble economy."

#. Occurrence 8_4:104:10946: scene=8_4
#: 8_4:104
msgctxt "text_id=10946 | speaker=unknown"
msgid "　バブル末期と言えど、地方都市の人々の生活はいまだ不夜城にはほど遠い。"
msgstr "  It was a time when metropolitan areas never slept. Those in the countryside, however, remained in the past."

#. Occurrence 8_4:109:10947: scene=8_4
#: 8_4:109
msgctxt "text_id=10947 | speaker=unknown"
msgid "　住宅地は静まりかえり、道を行く会社員の姿もなく、自動車の音すらしない。"
msgstr "  The homes were blanketed in silence, the streets were empty of commuters, and not a single automobile could be heard."

#. Occurrence 8_4:114:10948: scene=8_4
#: 8_4:114
msgctxt "text_id=10948 | speaker=unknown"
msgid "　太陽は地平線に半身を残している。"
msgstr "  The sun was just barely peeking over the horizon."

#. Occurrence 8_4:119:10949: scene=8_4
#: 8_4:119
msgctxt "text_id=10949 | speaker=unknown"
msgid "　町が目覚めるには、あと半刻ばかりの眠りが必要だった。"
msgstr "  The town would still be asleep for at least an hour longer before it began waking up."

#. Occurrence 8_4:153:10950: scene=8_4
#: 8_4:153
msgctxt "text_id=10950 | speaker=unknown"
msgid "　そんな中、久遠寺邸に足を踏み入れる影がひとつ。"
msgstr "  It was during this time that someone stepped onto the Kuonji Estate."

#. Occurrence 8_4:158:10951: scene=8_4
#: 8_4:158
msgctxt "text_id=10951 | speaker=unknown"
msgid "　冬休みという事で深夜割り当てのアルバイトに精を出し、たったいま帰ってきた草十郎である。"
msgstr "  Soujyuro was working the late shift during winter vacation and had just come home."

#. Occurrence 8_4:172:10952: scene=8_4
#: 8_4:172
msgctxt "text_id=10952 | speaker=unknown"
msgid "　それぞれ自室で眠っているであろう青子と有珠を起こさないように、草十郎は静かに居間へ移動する。"
msgstr "  He moved quietly through the drawing room so he wouldn't wake up Aoko and Alice, who were presumably still asleep."

#. Occurrence 8_4:218:10953: scene=8_4
#: 8_4:218
msgctxt "text_id=10953 | speaker=unknown"
msgid "　話は変わるが、久遠寺邸には幾つかのルールがある。"
msgstr "  The Kuonji Estate had a few established rules."

#. Occurrence 8_4:223:10954: scene=8_4
#: 8_4:223
msgctxt "text_id=10954 | speaker=unknown"
msgid "　その一つがノーモア日本茶。"
msgstr "  One of those rules forbade more Japanese tea."

#. Occurrence 8_4:228:10955: scene=8_4
#: 8_4:228
msgctxt "text_id=10955 | speaker=unknown"
msgid "　この、まったく新しい法案が可決されたのは三日前。"
msgstr "  This new rule had only came into effect three days prior."

#. Occurrence 8_4:233:10956: scene=8_4
#: 8_4:233
msgctxt "text_id=10956 | speaker=unknown"
msgid "　ある夕食後、台所でのほほんとほうじ茶を飲んでいた草十郎を見て、久遠寺有珠が「あ」と発音した事に由来する。"
msgstr "  It was proposed after Alice saw Soujyuro drinking green tea in the kitchen after dinner one night."

#. Occurrence 8_4:268:10957: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0000; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:268
msgctxt "text_id=10957 | speaker=alice"
msgid "「あ」"
msgstr "\"Ah.\""

#. Occurrence 8_4:302:10958: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0000; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:302
msgctxt "text_id=10958 | speaker=soujuurou"
msgid "「あ？」"
msgstr "\"Ah?\""

#. Occurrence 8_4:327:10959: scene=8_4
#: 8_4:327
msgctxt "text_id=10959 | speaker=unknown"
msgid "　思えば、突然の出来事だった。"
msgstr "  Looking back on it, the decision had been made rather abruptly."

#. Occurrence 8_4:332:10960: scene=8_4
#: 8_4:332
msgctxt "text_id=10960 | speaker=unknown"
msgid "　背後からの声は有珠の一言であり、"
msgstr "  That single gasp of surprise was all Alice said."

#. Occurrence 8_4:360:10961: scene=8_4
#: 8_4:360
msgctxt "text_id=10961 | speaker=unknown"
msgid "　彼女は頭痛を堪えるような仕草をした後、青子を呼びつけて、以後、この洋館における番茶・梅昆布茶の錬成を禁止させた。"
msgstr "  She grasped her head as if she was battling the most vicious of migraines, called for Aoko, and then made the decision to ban all Japanese teas from this mansion."

#. Occurrence 8_4:365:10962: scene=8_4
#: 8_4:365
msgctxt "text_id=10962 | speaker=unknown"
msgid "　青子の交渉で、夏場の麦茶だけはＯＫ、と<言|げん>をとれたのは奇跡と言えるだろう。"
msgstr "  By some miracle, Aoko managed to negotiate and keep Soujyuro's privileges to barley tea during the summer."

#. Occurrence 8_4:410:10963: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0000; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:410
msgctxt "text_id=10963 | speaker=aoko"
msgid "“だいたい、イギリスさんだって初めはグリーンティーが主流だったじゃない”"
msgstr "\"Even the British only drank green tea at first, you know.\""

#. Occurrence 8_4:416:10964: scene=8_4
#: 8_4:416
msgctxt "text_id=10964 | speaker=unknown"
msgid "　といった青子の反撃が、痛いところをついた結果である。"
msgstr "  Aoko had clearly hit a nerve with this argument."

#. Occurrence 8_4:434:10965: scene=8_4
#: 8_4:434
msgctxt "text_id=10965 | speaker=unknown"
msgid "　ちなみに、「あ」は「ありえない」の「あ」ではないか、と蒼崎青子は睨んでいる。"
msgstr "  Aoko stared at Alice, fairly certain why she was so taken aback by Soujyuro's actions."

#. Occurrence 8_4:486:10966: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0001; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:486
msgctxt "text_id=10966 | speaker=soujuurou"
msgid "「そこまで嫌がらなくてもなあ……お茶はなんだって美味しいのに」"
msgstr "\"I don't get why it's such a big deal... Tea is good no matter what kind it is...\""

#. Occurrence 8_4:492:10967: scene=8_4
#: 8_4:492
msgctxt "text_id=10967 | speaker=unknown"
msgid "　ひとり呟きながら、温かい緑茶を飲む草十郎。"
msgstr "  Soujyuro grumbled to himself while sipping his hot green tea."

#. Occurrence 8_4:508:10968: scene=8_4
#: 8_4:508
msgctxt "text_id=10968 | speaker=unknown"
msgid "　紅茶用のカップにほうじ茶を注いだ事が有珠のわななきの最たる理由であった事を、彼は知らない。"
msgstr "  He didn't realize that Alice was upset because he had poured his green tea into a teacup meant for black tea."

#. Occurrence 8_4:513:10969: scene=8_4
#: 8_4:513
msgctxt "text_id=10969 | speaker=unknown"
msgid "　また彼の名誉のために付け加えると、使ったティーカップは有珠が草十郎に使ってもよい、と許可したものである。"
msgstr "  In Soujyuro's defense, this was the only tea cup that Alice had given him permission to use."

#. Occurrence 8_4:533:10970: scene=8_4
#: 8_4:533
msgctxt "text_id=10970 | speaker=unknown"
msgid "　ともあれ、今は彼だけの幸福空間だ。"
msgstr "  At any rate, the early morning was his to enjoy."

#. Occurrence 8_4:538:10971: scene=8_4
#: 8_4:538
msgctxt "text_id=10971 | speaker=unknown"
msgid "　内緒で持ちこんだ日本茶セット一式を使って、草十郎は労働後の<一時|ひととき>にひたりきる。"
msgstr "  This was his moment to relax with the Japanese tea set he'd smuggled in."

#. Occurrence 8_4:558:10972: scene=8_4
#: 8_4:558
msgctxt "text_id=10972 | speaker=unknown"
msgid "　特別、本を読むワケでも、テレビをつけるワケでもなく、窓越しの庭……というより密林……を、<慈|いつく>しみの目で眺める。"
msgstr "  He didn't use this time to read books or watch TV. He just drank his tea and gazed fondly at the garden-or rather, the dense woods outside."

#. Occurrence 8_4:563:10973: scene=8_4
#: 8_4:563
msgctxt "text_id=10973 | speaker=unknown"
msgid "　アレはなんとかしたいなー、などと思いつつ、まったりし続ける草十郎だった。"
msgstr "  Soujyuro simply sat, relaxed, and let his mind wander."

#. Occurrence 8_4:631:10974: scene=8_4
#: 8_4:631
msgctxt "text_id=10974 | speaker=unknown"
msgid "　彼がぼんやりすること、約半刻。"
msgstr "  About an hour passed."

#. Occurrence 8_4:636:10975: scene=8_4
#: 8_4:636
msgctxt "text_id=10975 | speaker=unknown"
msgid "　疲れがじゅうぶんにとれた頃、ホールから物音が聞こえてきた。"
msgstr "  Just as he was beginning to feel refreshed, he heard sounds coming from the foyer."

#. Occurrence 8_4:672:10976: scene=8_4
#: 8_4:672
msgctxt "text_id=10976 | speaker=unknown"
msgid "　それが青子と有珠の話し声と知って、草十郎は神速で湯呑みや急須、お茶の葉をキッチンに隠す。"
msgstr "  He knew it was Aoko and Alice talking, so he rushed to hide his teacup, teapot, and tea leaves in the kitchen."

#. Occurrence 8_4:677:10977: scene=8_4
#: 8_4:677
msgctxt "text_id=10977 | speaker=unknown"
msgid "　台所には使われていない棚が山ほどあるので<隠蔽|いんぺい>自体は簡単だ。むしろ、青子たちの食事事情を如実に語る台所の在り方に困る草十郎である。"
msgstr "  Hiding the contraband was easy enough, considering just how many unused shelves there were in the kitchen. Soujyuro was perturbed by how they wasted the potential of such a splendid kitchen."

#. Occurrence 8_4:730:10978: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0001; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:730
msgctxt "text_id=10978 | speaker=aoko"
msgid "「あら。早いのね、草十郎」"
msgstr "\"Oh, you're up early, Soujyuro.\""

#. Occurrence 8_4:740:10979: scene=8_4
#: 8_4:740
msgctxt "text_id=10979 | speaker=unknown"
msgid "　青子は白いダウンジャケットを脱ぎながら声をかけた。"
msgstr "  Aoko spoke as she took off her white down jacket."

#. Occurrence 8_4:746:10980: scene=8_4
#: 8_4:746
msgctxt "text_id=10980 | speaker=unknown"
msgid "　彼女の横では、有珠が無言で黒いコートを脱いでいる。"
msgstr "  Next to her, Alice silently took off her black coat."

#. Occurrence 8_4:770:10981: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0002; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:770
msgctxt "text_id=10981 | speaker=soujuurou"
msgid "「いや、いま帰ってきたんだ。<天城浜|あまぎはま>の食品工場に深夜のパートで入ることになって、その帰り」"
msgstr "\"No, I just got home actually. I started working the late shift at a food factory over in Amagihama.\""

#. Occurrence 8_4:780:10982: scene=8_4
#: 8_4:780
msgctxt "text_id=10982 | speaker=unknown"
msgid "　台所から顔をだしながら、さも今からお湯を沸かしますよー、というジェスチャーをする草十郎。"
msgstr "  Soujyuro stuck his head out from the kitchen and gestured that he was about to put on some water to boil."

#. Occurrence 8_4:809:10983: scene=8_4
#: 8_4:809
msgctxt "text_id=10983 | speaker=unknown"
msgid "　それに有珠は<微|かす>かに首を傾げた。"
msgstr "  Alice tilted her head slightly at him."

#. Occurrence 8_4:814:10984: scene=8_4
#: 8_4:814
msgctxt "text_id=10984 | speaker=unknown"
msgid "　……別に、草十郎のジェスチャーが彼女の笑いのツボに入った訳ではない。"
msgstr "  It wasn't that she thought his gesturing was funny or anything like that."

#. Occurrence 8_4:825:10985: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0001; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:825
msgctxt "text_id=10985 | speaker=alice"
msgid "「天城浜から……？」"
msgstr "\"Amagihama...?\""

#. Occurrence 8_4:830:10986: scene=8_4
#: 8_4:830
msgctxt "text_id=10986 | speaker=unknown"
msgid "　有珠はちらりと居間の時計を見て、いっそう表情を曇らせる。"
msgstr "  Alice glanced up at the clock in the drawing room, and her expression darkened."

#. Occurrence 8_4:864:10987: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0002; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:864
msgctxt "text_id=10987 | speaker=aoko"
msgid "「どうしたの、有珠？」"
msgstr "\"What's wrong, Alice?\""

#. Occurrence 8_4:869:10988: scene=8_4
#: 8_4:869
msgctxt "text_id=10988 | speaker=unknown"
msgid "　いち早くソファーに腰を下ろした青子が、立ったままの有珠に問いかけた。"
msgstr "  Aoko asked this from her comfortable seat on the sofa."

#. Occurrence 8_4:878:10989: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0002; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:878
msgctxt "text_id=10989 | speaker=alice"
msgid "「別に」"
msgstr "\"Nothing.\""

#. Occurrence 8_4:888:10990: scene=8_4
#: 8_4:888
msgctxt "text_id=10990 | speaker=unknown"
msgid "　素っ気なく答えて、有珠もソファーに腰を下ろす。"
msgstr "  Alice responded indifferently before finally sitting down as well."

#. Occurrence 8_4:918:10991: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0003; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:918
msgctxt "text_id=10991 | speaker=aoko"
msgid "「草十郎ー。砂糖は一杯だけだからねー」"
msgstr "\"Soujyuro! Just one spoon of sugar, remember?\""

#. Occurrence 8_4:924:10992: scene=8_4
#: 8_4:924
msgctxt "text_id=10992 | speaker=unknown"
msgid "　青子はごく当然とばかりに、台所に声を投げた。"
msgstr "  Aoko yelled her matter-of-course request into the kitchen."

#. Occurrence 8_4:929:10993: scene=8_4
#: 8_4:929
msgctxt "text_id=10993 | speaker=unknown"
msgid "　返事はないが、あっちはそれで了解しているらしい。"
msgstr "  Soujyuro didn't respond, but it was an affirmative silence."

#. Occurrence 8_4:934:10994: scene=8_4
#: 8_4:934
msgctxt "text_id=10994 | speaker=unknown"
msgid "　有珠には<与|あずか>り知れない、二晩にわたる一夜漬けの成果だった。"
msgstr "  This was the result of two entire nights' worth of cramming that Alice knew nothing about."

#. Occurrence 8_4:961:10995: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0004; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:961
msgctxt "text_id=10995 | speaker=aoko"
msgid "「有珠は？」"
msgstr "\"What about you, Alice?\""

#. Occurrence 8_4:982:10996: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0003; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:982
msgctxt "text_id=10996 | speaker=alice"
msgid "「……わたしは、ミルクだけでいいけど」"
msgstr "\"I'll just have mine with milk.\""

#. Occurrence 8_4:987:10997: scene=8_4
#: 8_4:987
msgctxt "text_id=10997 | speaker=unknown"
msgid "　仕方なく答える有珠に、"
msgstr "  Alice responded out of obligation."

#. Occurrence 8_4:1006:10998: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0003; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1006
msgctxt "text_id=10998 | speaker=soujuurou"
msgid "「了解、ミルクティーだね」"
msgstr "\"Tea with milk, got it.\""

#. Occurrence 8_4:1011:10999: scene=8_4
#: 8_4:1011
msgctxt "text_id=10999 | speaker=unknown"
msgid "　と、なぜか律儀に返ってくる声があった。"
msgstr "  For some reason, Soujyuro dutifully answered Alice's request."

#. Occurrence 8_4:1049:11000: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0005; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1049
msgctxt "text_id=11000 | speaker=aoko"
msgid "「ま、いいけど。いちいちつっこんでたらキリがないし。"
msgstr "\"Fine. I'd get sick of his voice if he replied every time, anyway."

#. Occurrence 8_4:1071:11001: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0006; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1071
msgctxt "text_id=11001 | speaker=aoko"
msgid "　それより珍しいじゃない。有珠がティーバッグのお茶飲むなんて」"
msgstr "  Anyway, isn't it pretty rare for you to be drinking tea from a tea bag, Alice?\""

#. Occurrence 8_4:1090:11002: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0004; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:1090
msgctxt "text_id=11002 | speaker=alice"
msgid "「……今日は疲れたから、たまには」"
msgstr "\"...I'm just tired today. I thought I might as well.\""

#. Occurrence 8_4:1095:11003: scene=8_4
#: 8_4:1095
msgctxt "text_id=11003 | speaker=unknown"
msgid "　人の厚意を受け取ろう、と思ったらしい。"
msgstr "  It seemed she had allowed herself to accept another's kindness, at least for today."

#. Occurrence 8_4:1116:11004: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0007; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1116
msgctxt "text_id=11004 | speaker=aoko"
msgid "「ふーん。ま、いいか。それより草十郎ー。"
msgstr "\"Hmph, if you say so. More importantly, Soujyuro?"

#. Occurrence 8_4:1132:11005: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0008; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1132
msgctxt "text_id=11005 | speaker=aoko"
msgid "　アンタ、さっきおかしなこと言わなかった？」"
msgstr "  Didn't you say something weird earlier?\""

#. Occurrence 8_4:1151:11006: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0004; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1151
msgctxt "text_id=11006 | speaker=soujuurou"
msgid "「？　別に言ってないぞ、そんな事」"
msgstr "\"Hm? I don't think so.\""

#. Occurrence 8_4:1171:11007: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0009; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1171
msgctxt "text_id=11007 | speaker=aoko"
msgid "「そう？　ならいいんだけど」"
msgstr "\"Oh? I could've sworn you said something.\""

#. Occurrence 8_4:1176:11008: scene=8_4
#: 8_4:1176
msgctxt "text_id=11008 | speaker=unknown"
msgid "　居間と台所、実に四メートルもの距離で会話をするふたり。"
msgstr "  The two were conversing over a distance of four yards."

#. Occurrence 8_4:1181:11009: scene=8_4
#: 8_4:1181
msgctxt "text_id=11009 | speaker=unknown"
msgid "　それに、ぽつりと有珠は付け足した。"
msgstr "  Alice decided to add her opinion to the conversation."

#. Occurrence 8_4:1217:11010: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0005; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:1217
msgctxt "text_id=11010 | speaker=alice"
msgid "「……静希君がおかしな事を言わない日はないと思うわ、わたし」"
msgstr "\"...I don't think a day has ever gone by when he hasn't said something weird, to be honest.\""

#. Occurrence 8_4:1223:11011: scene=8_4
#: 8_4:1223
msgctxt "text_id=11011 | speaker=unknown"
msgid "　あんまりな有珠の声は、幸運なことに、台所にいる草十郎には聞こえなかった。"
msgstr "  Her quiet tone was luckily just low enough that Soujyuro couldn't hear her from the kitchen."

#. Occurrence 8_4:1262:11012: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0010; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1262
msgctxt "text_id=11012 | speaker=aoko"
msgid "「そりゃあそうだけど、いま、ちょっと変だったでしょ？"
msgstr "\"I agree, but seriously... Wasn't he talking kind of strangely just now?"

#. Occurrence 8_4:1274:11013: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0011; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1274
msgctxt "text_id=11013 | speaker=aoko"
msgid "　……いや、何が引っかかったのかまでは分からないんだけどさ」"
msgstr "  ...I don't exactly know how to describe it.\""

#. Occurrence 8_4:1297:11014: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0006; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:1297
msgctxt "text_id=11014 | speaker=alice"
msgid "「そうね。会話自体は普通だったけれど、内容を考えてみると、どこかおかしいわね」"
msgstr "\"True. The conversation itself was normal, but something did seem off about what he was saying.\""

#. Occurrence 8_4:1330:11015: scene=8_4
#: 8_4:1330
msgctxt "text_id=11015 | speaker=unknown"
msgid "　要領のつかめない会話に、ますます不機嫌さをます青子。"
msgstr "  Aoko became gradually more irritated as she failed to grasp what had been odd about the conversation."

#. Occurrence 8_4:1336:11016: scene=8_4
#: 8_4:1336
msgctxt "text_id=11016 | speaker=unknown"
msgid "　そこへ、三人分のティーカップをトレイに載せて草十郎が現れた。"
msgstr "  Just then, Soujyuro appeared holding a tray with a teacup for each of them."

#. Occurrence 8_4:1376:11017: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0005; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1376
msgctxt "text_id=11017 | speaker=soujuurou"
msgid "「なにを話してるんだ。"
msgstr "\"What are you guys talking about?"

#. Occurrence 8_4:1376:11018: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0005; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1376
msgctxt "text_id=11018 | speaker=soujuurou"
msgid "　単に、新しいアルバイトを始めただけだろ」"
msgstr "  I literally just said I started a new part-time job. That's all.\""

#. Occurrence 8_4:1395:11019: scene=8_4
#: 8_4:1395
msgctxt "text_id=11019 | speaker=unknown"
msgid "　音をたてず、黒テーブルにカップを置く草十郎。"
msgstr "  He put the cups down on the black table without making even the slightest sound."

#. Occurrence 8_4:1400:11020: scene=8_4
#: 8_4:1400
msgctxt "text_id=11020 | speaker=unknown"
msgid "　ウェイターのアルバイトもやっているらしく、その折り目正しさは有珠をして文句のつけどころがない。"
msgstr "  Alice couldn't complain about how proper his job as a waiter had made him."

#. Occurrence 8_4:1434:11021: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0007; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:1434
msgctxt "text_id=11021 | speaker=alice"
msgid "「…………」"
msgstr "\"...\""

#. Occurrence 8_4:1439:11022: scene=8_4
#: 8_4:1439
msgctxt "text_id=11022 | speaker=unknown"
msgid "　お礼までは口にしないが、かすかに<顎|あご>を引いて感謝の意を示す有珠。"
msgstr "  While she didn't say anything out loud, she did nod in his direction to show some gratitude."

#. Occurrence 8_4:1444:11023: scene=8_4
#: 8_4:1444
msgctxt "text_id=11023 | speaker=unknown"
msgid "　一方、"
msgstr "  Aoko, however..."

#. Occurrence 8_4:1468:11024: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0012; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1468
msgctxt "text_id=11024 | speaker=aoko"
msgid "「天城浜だっけ？　あそこってスタジアムがある所でしょ。ツアーの会場になるから時々行くけど」"
msgstr "\"Amagihama, was it? There's a huge stadium over there that I go to sometimes when a band I like is on tour.\""

#. Occurrence 8_4:1479:11025: scene=8_4
#: 8_4:1479
msgctxt "text_id=11025 | speaker=unknown"
msgid "　全校生徒の見本になるべき生徒会長は、あろう事かロックバンドの話に夢中だった。"
msgstr "  The student council president, a supposed model student, loved rock bands."

#. Occurrence 8_4:1499:11026: scene=8_4
#: 8_4:1499
msgctxt "text_id=11026 | speaker=unknown"
msgid "　青子は密かなバンド好きで、中学の頃は暇さえあれば遠出して小さなライブハウスに入り浸っていたらしい。"
msgstr "  Aoko was secretly obsessed with a number of bands and used to travel way out of town just to see them perform live when she was in middle school."

#. Occurrence 8_4:1519:11027: scene=8_4
#: 8_4:1519
msgctxt "text_id=11027 | speaker=unknown"
msgid "　もちろん、草十郎にはよく分からない世界である。"
msgstr "  Of course, this was a world that Soujyuro was far from familiar with."

#. Occurrence 8_4:1556:11028: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0013; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1556
msgctxt "text_id=11028 | speaker=aoko"
msgid "「それよりまた新しいバイトはじめたんだ。そんなに働いてどうする気なのよ、草十郎は」"
msgstr "\"Anyway, I can't believe you've started yet another part-time job. What are you trying to accomplish working that hard, Soujyuro?\""

#. Occurrence 8_4:1597:11029: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0006; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1597
msgctxt "text_id=11029 | speaker=soujuurou"
msgid "「……ああ、よく聞いてくれたね。"
msgstr "\"...Oh, you were listening."

#. Occurrence 8_4:1603:11030: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0007; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1603
msgctxt "text_id=11030 | speaker=soujuurou"
msgid "　本人の名誉のために名前は伏せるけど、誰かさんと誰かさんが俺の少ない収入を無慈悲に奪っていくから、働く先を増やしたんだ」"
msgstr "  Well, I have to work more because there are a couple of people in my life who like to take all my money from me for every little thing you can imagine.\""

#. Occurrence 8_4:1613:11031: scene=8_4
#: 8_4:1613
msgctxt "text_id=11031 | speaker=unknown"
msgid "　静希草十郎、せいいっぱいの抵抗だった。"
msgstr "  This was as much resistance as Soujyuro was able to give."

#. Occurrence 8_4:1618:11032: scene=8_4
#: 8_4:1618
msgctxt "text_id=11032 | speaker=unknown"
msgid "　そんな草十郎の独白をまったく聞いていないように、青子はティーカップを口に運ぶ。"
msgstr "  Aoko lifted her teacup to her mouth as if she was completely oblivious to Soujyuro's monologue."

#. Occurrence 8_4:1659:11033: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0008; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:1659
msgctxt "text_id=11033 | speaker=alice"
msgid "「それは大変ね」"
msgstr "\"Sounds rough.\""

#. Occurrence 8_4:1664:11034: scene=8_4
#: 8_4:1664
msgctxt "text_id=11034 | speaker=unknown"
msgid "　ことり、と静かにカップを置く有珠。"
msgstr "  Alice said this as she set her teacup down quietly."

#. Occurrence 8_4:1669:11035: scene=8_4
#: 8_4:1669
msgctxt "text_id=11035 | speaker=unknown"
msgid "　……彼女にいたっては、本気で分かっていない節もある。"
msgstr "  There were some things she just did not understand."

#. Occurrence 8_4:1692:11036: scene=8_4
#: 8_4:1692
msgctxt "text_id=11036 | speaker=unknown"
msgid "　そんな有珠と草十郎を見て、青子はくっくっと笑いを堪えていた。"
msgstr "  Aoko had to hold back her laughter as she looked at Alice and Soujyuro."

#. Occurrence 8_4:1728:11037: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0008; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1728
msgctxt "text_id=11037 | speaker=soujuurou"
msgid "「……はあ。言った自分が未熟だった」"
msgstr "\"I should've known better than to say anything.\""

#. Occurrence 8_4:1734:11038: scene=8_4
#: 8_4:1734
msgctxt "text_id=11038 | speaker=unknown"
msgid "　がっくりと肩を落とし紅茶を一口飲んでみる。"
msgstr "  Soujyuro's shoulders fell as he said this."

#. Occurrence 8_4:1752:11039: scene=8_4
#: 8_4:1752
msgctxt "text_id=11039 | speaker=unknown"
msgid "　やっぱり、彼にはいまいち不鮮明な味わいだ。"
msgstr "  He took a sip of his black tea, still unsure about the taste."

#. Occurrence 8_4:1789:11040: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0009; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1789
msgctxt "text_id=11040 | speaker=soujuurou"
msgid "「ま、アルバイトが多いって分かってくれるだけでいいか。"
msgstr "\"As long as you know I'm working a lot, I guess that's fine."

#. Occurrence 8_4:1795:11041: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0010; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:1795
msgctxt "text_id=11041 | speaker=soujuurou"
msgid "　そういったワケだから、冬休み中は夜も留守にする。例の薬はアルバイト先で飲むしかないんだけど―――」"
msgstr "  So that means I'll also be away at night during winter vacation. I'll have to take those pills at work, though...\""

#. Occurrence 8_4:1821:11042: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0014; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1821
msgctxt "text_id=11042 | speaker=aoko"
msgid "「ああ、それなら心配いらないわ。もうあれは止めたから。"
msgstr "\"Oh, don't worry about that. I'm done with those."

#. Occurrence 8_4:1833:11043: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0015; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1833
msgctxt "text_id=11043 | speaker=aoko"
msgid "　いちいち作るのも面倒だし、もっと静希クンに似合うのを見付けてきたの」"
msgstr "  They were a pain to make, and I found something more suitable for you anyway.\""

#. Occurrence 8_4:1869:11044: scene=8_4
#: 8_4:1869
msgctxt "text_id=11044 | speaker=unknown"
msgid "　ニマア、と性悪<極|きわ>まりない笑み。"
msgstr "  Aoko had a huge, ominous grin on her face."

#. Occurrence 8_4:1875:11045: scene=8_4
#: 8_4:1875
msgctxt "text_id=11045 | speaker=unknown"
msgid "　青子はジャケットのポケットに手をいれて、愛らしい紙袋を取り出した。"
msgstr "  She put her hand into her jacket pocket and pulled out a little paper bag."

#. Occurrence 8_4:1880:11046: scene=8_4
#: 8_4:1880
msgctxt "text_id=11046 | speaker=unknown"
msgid "　直径二十センチもない円形の何かを、プレゼント用の袋で包んでいる。"
msgstr "  It was a small, circular object about twenty inches in diameter, wrapped up nicely like a present."

#. Occurrence 8_4:1928:11047: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0016; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:1928
msgctxt "text_id=11047 | speaker=aoko"
msgid "「はい、これは入居祝い。これからはそれを付けておくのよ、草十郎」"
msgstr "\"Here's a little something to celebrate your moving in here. I want you to wear that from now on, Soujyuro.\""

#. Occurrence 8_4:1934:11048: scene=8_4
#: 8_4:1934
msgctxt "text_id=11048 | speaker=unknown"
msgid "　紙袋を開ける草十郎。"
msgstr "  Soujyuro opened the paper bag."

#. Occurrence 8_4:1964:11049: scene=8_4
#: 8_4:1964
msgctxt "text_id=11049 | speaker=unknown"
msgid "　出てきたのは白色のベルトだった。"
msgstr "  Inside was a white belt."

#. Occurrence 8_4:1969:11050: scene=8_4
#: 8_4:1969
msgctxt "text_id=11050 | speaker=unknown"
msgid "　ズボンの腰に付けるものではない。"
msgstr "  But it wasn't a belt for putting around your waist to keep your pants up."

#. Occurrence 8_4:1974:11051: scene=8_4
#: 8_4:1974
msgctxt "text_id=11051 | speaker=unknown"
msgid "　嘘偽りなく、極めて端的に説明すると、首輪以外の何物でもないのだった。"
msgstr "  To put it as clearly as possible, it was a collar."

#. Occurrence 8_4:2010:11052: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0009; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:2010
msgctxt "text_id=11052 | speaker=alice"
msgid "「青子……」"
msgstr "\"Aoko...\""

#. Occurrence 8_4:2016:11053: scene=8_4
#: 8_4:2016
msgctxt "text_id=11053 | speaker=unknown"
msgid "　さすがにどうかと思ったのか、有珠は顔を曇らせる。"
msgstr "  Alice's expression darkened at this turn of events."

#. Occurrence 8_4:2021:11054: scene=8_4
#: 8_4:2021
msgctxt "text_id=11054 | speaker=unknown"
msgid "　友人の人の悪さに呆れたのか、草十郎への同情かは不明である。"
msgstr "  But it wasn't clear whether it was her friend's insidiousness or sympathy for Soujyuro that concerned her."

#. Occurrence 8_4:2060:11055: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0017; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:2060
msgctxt "text_id=11055 | speaker=aoko"
msgid "「どう、気に入った？」"
msgstr "\"So, what do you think?\""

#. Occurrence 8_4:2066:11056: scene=8_4
#: 8_4:2066
msgctxt "text_id=11056 | speaker=unknown"
msgid "　一方、青子は明らかに正気ではない。"
msgstr "  Aoko was clearly a little crazy."

#. Occurrence 8_4:2071:11057: scene=8_4
#: 8_4:2071
msgctxt "text_id=11057 | speaker=unknown"
msgid "　もとい、本気ではない。"
msgstr "  At least she wasn't totally serious."

#. Occurrence 8_4:2076:11058: scene=8_4
#: 8_4:2076
msgctxt "text_id=11058 | speaker=unknown"
msgid "　これは冗談半分の<悪戯|いたずら>で、嫌がる草十郎の反応を期待しているだけなのは見え見えだ。"
msgstr "  It was obvious that it was at least half a prank to just see how Soujyuro would react."

#. Occurrence 8_4:2109:11059: scene=8_4
#: 8_4:2109
msgctxt "text_id=11059 | speaker=unknown"
msgid "　―――が。"
msgstr "  But..."

#. Occurrence 8_4:2126:11060: scene=8_4
#: 8_4:2126
msgctxt "text_id=11060 | speaker=unknown"
msgid "　贈られた本人である草十郎は、わりかし真剣に首輪を見つめているのだった。"
msgstr "  Soujyuro was solemnly considering the collar he had just been gifted."

#. Occurrence 8_4:2138:11061: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0011; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2138
msgctxt "text_id=11061 | speaker=soujuurou"
msgid "「うん。意味は掴みかねるけど、こういうものを人から貰うのは、これが初めてだ」"
msgstr "\"I'm not exactly sure what this means, but it's the first time anyone has given me something like this.\""

#. Occurrence 8_4:2158:11062: scene=8_4
#: 8_4:2158
msgctxt "text_id=11062 | speaker=unknown"
msgid "　……幸せな思い出にひたるような呟き。"
msgstr "  ...He actually sounded like this would be a happy memory for him."

#. Occurrence 8_4:2182:11063: scene=8_4
#: 8_4:2182
msgctxt "text_id=11063 | speaker=unknown"
msgid "　それを横で見ながら、何か間違っていると有珠は目を細める。"
msgstr "  Alice narrowed her eyes at what was transpiring."

#. Occurrence 8_4:2214:11064: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0012; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2214
msgctxt "text_id=11064 | speaker=soujuurou"
msgid "「けど、これは何に使うんだ？」"
msgstr "\"But what exactly am I supposed to use this for?\""

#. Occurrence 8_4:2240:11065: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0018; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:2240
msgctxt "text_id=11065 | speaker=aoko"
msgid "「簡単よ。<緊箍児|きんこじ>と同じで、飼い犬が主人に逆らうと首を絞めるの。あっちは頭につけてたけど、それよりは首のがマシでしょう？」"
msgstr "\"It's simple. It's like the golden headband in Journey to the West. Wukong had to wear it if he stepped out of line, though this you wear around your neck like a dog collar.\""

#. Occurrence 8_4:2245:11066: scene=8_4
#: 8_4:2245
msgctxt "text_id=11066 | speaker=unknown"
msgid "　む、とようやく青子の意地悪さに気が付く草十郎。"
msgstr "  Soujyuro grimaced when he finally understood Aoko's mean-spirited gift."

#. Occurrence 8_4:2250:11067: scene=8_4
#: 8_4:2250
msgctxt "text_id=11067 | speaker=unknown"
msgid "　その緊箍児とやらは一体どんな経緯で、どんな悪党が使用するに至ったのか、ぜひ聞かせてほしいところである。"
msgstr "  He really wanted to ask her what kind of person comes up with such an evil idea."

#. Occurrence 8_4:2286:11068: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0013; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2286
msgctxt "text_id=11068 | speaker=soujuurou"
msgid "「……つまり、秘密をばらしたり逆らったりしたら首が絞まる、と。"
msgstr "\"So basically, if I divulge any secrets or disobey you, then that collar will choke me. Is that right?"

#. Occurrence 8_4:2292:11069: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0014; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2292
msgctxt "text_id=11069 | speaker=soujuurou"
msgid "　―――やっぱり熱でもあるんじゃないのか、蒼崎は」"
msgstr "  ...Are you *sure* you're feeling well, Aozaki?\""

#. Occurrence 8_4:2314:11070: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0019; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:2314
msgctxt "text_id=11070 | speaker=aoko"
msgid "「あら、首輪はいや？　せっかく草十郎に似合いそうな物を見付けたのに」"
msgstr "\"Oh, do you not like it? I tried to pick out what I thought would suit you best!\""

#. Occurrence 8_4:2334:11071: scene=8_4
#: 8_4:2334
msgctxt "text_id=11071 | speaker=unknown"
msgid "　からかいの入った微笑み。"
msgstr "  Aoko still had an evil grin on her face."

#. Occurrence 8_4:2339:11072: scene=8_4
#: 8_4:2339
msgctxt "text_id=11072 | speaker=unknown"
msgid "　しかし。青子本人、半ば冗談のつもりで用意したソレを、"
msgstr "  But Soujyuro had a surprising response to this gift that Aoko had clearly gotten as a prank."

#. Occurrence 8_4:2380:11073: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0015; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2380
msgctxt "text_id=11073 | speaker=soujuurou"
msgid "「……それもそうか。毎日毒を飲むよりはましだし、このベルト自体、いいものだし。"
msgstr "\"Hmm... I guess you're right. I mean, it's better than taking poison every day, and the belt itself looks well-made."

#. Occurrence 8_4:2391:11074: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0016; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2391
msgctxt "text_id=11074 | speaker=soujuurou"
msgid "　うん、気に入った。ありがとう蒼崎」"
msgstr "  I actually like it. Thank you, Aozaki.\""

#. Occurrence 8_4:2413:11075: scene=8_4
#: 8_4:2413
msgctxt "text_id=11075 | speaker=unknown"
msgid "　お世辞ではなく、彼は本気でそう言った。"
msgstr "  He spoke one hundred percent truthfully."

#. Occurrence 8_4:2423:11076: scene=8_4
#: 8_4:2423
msgctxt "text_id=11076 | speaker=unknown"
msgid "　さすがに青子も意表をつかれたのか、ほんと？　と小声で聞き返す。"
msgstr "  Aoko's face contorted in disbelief, and she could only mumble if he was serious."

#. Occurrence 8_4:2457:11077: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0017; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2457
msgctxt "text_id=11077 | speaker=soujuurou"
msgid "「人の厚意はどんなものだって嬉しいよ。"
msgstr "\"I'm happy about any act of kindness."

#. Occurrence 8_4:2463:11078: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0018; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2463
msgctxt "text_id=11078 | speaker=soujuurou"
msgid "　それに、それが蒼崎なら尚更だ」"
msgstr "  Even more so when it's from you, Aozaki.\""

#. Occurrence 8_4:2492:11079: scene=8_4
#: 8_4:2492
msgctxt "text_id=11079 | speaker=unknown"
msgid "　言って、草十郎は<首輪|ベルト>を首に巻いた。"
msgstr "  And with that, Soujyuro put the \"belt\" around his neck."

#. Occurrence 8_4:2497:11080: scene=8_4
#: 8_4:2497
msgctxt "text_id=11080 | speaker=unknown"
msgid "　首に巻いた布を覆うように。"
msgstr "  He placed it over the bandages already there."

#. Occurrence 8_4:2520:11081: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0019; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2520
msgctxt "text_id=11081 | speaker=soujuurou"
msgid "「こんな感じかな。きついけど、そのうち慣れるだろ」"
msgstr "\"I guess this works. It's a little tight, but I'm sure I'll get used to it.\""

#. Occurrence 8_4:2526:11082: scene=8_4
#: 8_4:2526
msgctxt "text_id=11082 | speaker=unknown"
msgid "　言いつつ、居心地が悪そうにベルトをずらす。"
msgstr "  Despite his words to the contrary, Soujyuro tugged at the belt uncomfortably and adjusted it."

#. Occurrence 8_4:2531:11083: scene=8_4
#: 8_4:2531
msgctxt "text_id=11083 | speaker=unknown"
msgid "　その仕草はどことなく倒錯的で、言い出した青子本人も赤面してしまった。"
msgstr "  It was such a perverse scene that even Aoko's face was red as a beet, even though this had all been her idea."

#. Occurrence 8_4:2536:11084: scene=8_4
#: 8_4:2536
msgctxt "text_id=11084 | speaker=unknown"
msgid "　昨日見た傷跡が、鮮明に思い出されたせいかもしれない。"
msgstr "  Perhaps it was because it gave her such a clear reminder of the scars she had seen the day before."

#. Occurrence 8_4:2574:11085: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0020; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2574
msgctxt "text_id=11085 | speaker=soujuurou"
msgid "「よし。留め方はこれでいいのか」"
msgstr "\"Okay. Is it on right?\""

#. Occurrence 8_4:2602:11086: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0020; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:2602
msgctxt "text_id=11086 | speaker=aoko"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 8_4:2607:11087: scene=8_4
#: 8_4:2607
msgctxt "text_id=11087 | speaker=unknown"
msgid "　確認のために近寄る草十郎に、うっ、と罪悪感から後退する青子。"
msgstr "  Aoko retreated guiltily as Soujyuro came closer for her to check the fit of his new collar."

#. Occurrence 8_4:2642:11088: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0021; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2642
msgctxt "text_id=11088 | speaker=soujuurou"
msgid "「？　黙ってちゃ分からないのに。"
msgstr "\"If you don't say anything, how will I know if it fits right?"

#. Occurrence 8_4:2648:11089: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0022; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2648
msgctxt "text_id=11089 | speaker=soujuurou"
msgid "　いいよ、有珠に聞くから」"
msgstr "  It's okay. I'll just ask Alice.\""

#. Occurrence 8_4:2688:11090: scene=8_4
#: 8_4:2688
msgctxt "text_id=11090 | speaker=unknown"
msgid "　青子から有珠に視線を移す草十郎。"
msgstr "  Soujyuro shifted his gaze from Aoko to Alice."

#. Occurrence 8_4:2693:11091: scene=8_4
#: 8_4:2693
msgctxt "text_id=11091 | speaker=unknown"
msgid "　有珠はしみじみと首輪をした草十郎を見つめて、"
msgstr "  Alice stared intently at Soujyuro wearing his new collar and said,"

#. Occurrence 8_4:2720:11092: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0010; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:2720
msgctxt "text_id=11092 | speaker=alice"
msgid "「―――ロックね。青子、趣味に走りすぎよ」"
msgstr "\"...Punk rock, hm? Aoko, stop trying to dress him how you want him to look.\""

#. Occurrence 8_4:2745:11093: scene=8_4
#: 8_4:2745
msgctxt "text_id=11093 | speaker=unknown"
msgid "　同居人へのとどめを口にした。"
msgstr "  She could not have put it any more bluntly."

#. Occurrence 8_4:2774:11094: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0021; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:2774
msgctxt "text_id=11094 | speaker=aoko"
msgid "「や、"
msgstr "\"Sh-"

msgctxt "text_id=11095 | speaker=unknown"
msgid "やかましい、そんなんじゃないっ！"
msgstr " Shut up! That's not what I was trying to do!"

#. Occurrence 8_4:2803:11096: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0022; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:2803
msgctxt "text_id=11096 | speaker=aoko"
msgid "　もういい、とにかくそういう事よ！　これからはその首輪が薬の代わりよ、せいぜい秘密を守ることね！」"
msgstr "  Just ignore her! From now on, that collar will replace those pills I was giving you. Don't you go divulging any of our secrets!\""

#. Occurrence 8_4:2838:11097: scene=8_4
#: 8_4:2838
msgctxt "text_id=11097 | speaker=unknown"
msgid "　なぜか語尾を強調して、青子はドスドスと廊下に向かう。"
msgstr "  Aoko was oddly emphatic as she spoke before stomping off toward the hallway."

#. Occurrence 8_4:2876:11098: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_4_0023; voice_prefix=A10; voice_category=1; scene=8_4
#: 8_4:2876
msgctxt "text_id=11098 | speaker=aoko"
msgid "「それと、これからお昼まで仮眠をとるけど、くだらないコトで起こしたら殺すから！」"
msgstr "\"I'm going to take a nap until lunch. If you wake me up for ANY stupid reason, I WILL murder you!\""

#. Occurrence 8_4:2888:11099: scene=8_4
#: 8_4:2888
msgctxt "text_id=11099 | speaker=unknown"
msgid "　壁よ砕けよとばかりに扉を閉め、青子は居間を後にした。"
msgstr "  Aoko slammed the door behind her as she left the drawing room."

#. Occurrence 8_4:2893:11100: scene=8_4
#: 8_4:2893
msgctxt "text_id=11100 | speaker=unknown"
msgid "　そんな青子を、草十郎は不思議そうに見送っている。"
msgstr "  Soujyuro stared in amazement."

#. Occurrence 8_4:2924:11101: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0023; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2924
msgctxt "text_id=11101 | speaker=soujuurou"
msgid "「……なんで蒼崎は、いつもいきなり怒るんだろう」"
msgstr "\"...I'll never understand why she gets so mad like that all of a sudden.\""

#. Occurrence 8_4:2929:11102: scene=8_4
#: 8_4:2929
msgctxt "text_id=11102 | speaker=unknown"
msgid "　有珠が目前にいる事を忘れて、つい呟く草十郎。"
msgstr "  He murmured to himself, forgetting that Alice was standing right there in front of him."

#. Occurrence 8_4:2954:11103: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0011; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:2954
msgctxt "text_id=11103 | speaker=alice"
msgid "「静希君には悪意が通じないからでしょう。"
msgstr "\"I assume it's because her ill intent doesn't seem to get through to you."

#. Occurrence 8_4:2954:11104: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0011; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:2954
msgctxt "text_id=11104 | speaker=alice"
msgid "　気にする必要はないわ」"
msgstr "  I wouldn't worry about it if I were you.\""

#. Occurrence 8_4:2990:11105: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0024; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:2990
msgctxt "text_id=11105 | speaker=soujuurou"
msgid "「悪意って、今のが？」"
msgstr "\"Ill intent? What? Just now?\""

#. Occurrence 8_4:3010:11106: scene=8_4
#: 8_4:3010
msgctxt "text_id=11106 | speaker=unknown"
msgid "　聞き返されて、有珠はハッと顔を上げた。"
msgstr "  Alice looked up at Soujyuro's innocent response."

#. Occurrence 8_4:3015:11107: scene=8_4
#: 8_4:3015
msgctxt "text_id=11107 | speaker=unknown"
msgid "　その目は、今の自分の行為に驚いたものだ。"
msgstr "  There was a glimmer in her eyes that showed surprise at her current actions."

#. Occurrence 8_4:3044:11108: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0012; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:3044
msgctxt "text_id=11108 | speaker=alice"
msgid "「……なんでもないから、気にしないで」"
msgstr "\"It's nothing. Don't worry about it.\""

#. Occurrence 8_4:3050:11109: scene=8_4
#: 8_4:3050
msgctxt "text_id=11109 | speaker=unknown"
msgid "　簡潔に答えて、いつもの無表情に戻る有珠。"
msgstr "  With that terse reply, she returned to her usual expressionless self."

#. Occurrence 8_4:3055:11110: scene=8_4
#: 8_4:3055
msgctxt "text_id=11110 | speaker=unknown"
msgid "　青子の気持ちなど、いちいち説明するまでもない。"
msgstr "  There was no use explaining Aoko's feelings."

#. Occurrence 8_4:3074:11111: scene=8_4
#: 8_4:3074
msgctxt "text_id=11111 | speaker=unknown"
msgid "　青子は草十郎の困る顔が見たくて首輪を買ってきたのに、その悪戯心が素直に喜ばれ、自らの良心に背中をくすぐられただけなのだ。"
msgstr "  Aoko bought that collar for the sole purpose of annoying Soujyuro and causing mischief. When things didn't turn out how she'd planned, her conscience got the better of her."

#. Occurrence 8_4:3094:11112: scene=8_4
#: 8_4:3094
msgctxt "text_id=11112 | speaker=unknown"
msgid "　草十郎は青子に怒られたと勘違いしているが、今のは青子の自爆にすぎない。"
msgstr "  Soujyuro mistakenly thought that Aoko was angry at him, when in reality she was only angry at herself."

#. Occurrence 8_4:3111:11113: scene=8_4
#: 8_4:3111
msgctxt "text_id=11113 | speaker=unknown"
msgid "　その微笑ましい行き違いを、有珠は草十郎に語らない。"
msgstr "  Alice didn't bother telling Soujyuro all these heartwarming details, though."

#. Occurrence 8_4:3116:11114: scene=8_4
#: 8_4:3116
msgctxt "text_id=11114 | speaker=unknown"
msgid "　面倒だからではなく―――そもそも『意味のない会話をする』思考そのものがない。"
msgstr "  Not because it was too much work, just because she was never one to have meaningless conversation."

#. Occurrence 8_4:3136:11115: scene=8_4
#: 8_4:3136
msgctxt "text_id=11115 | speaker=unknown"
msgid "　久遠寺有珠はそういう風に育てられている。"
msgstr "  That was how she had been raised."

#. Occurrence 8_4:3163:11116: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0013; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:3163
msgctxt "text_id=11116 | speaker=alice"
msgid "「……静希君は、これからどうするの？」"
msgstr "\"So what are your plans for the rest of the day, Sizuki?\""

#. Occurrence 8_4:3169:11117: scene=8_4
#: 8_4:3169
msgctxt "text_id=11117 | speaker=unknown"
msgid "　唐突に、有珠はそんな事を問いただした。"
msgstr "  Alice suddenly changed the topic."

#. Occurrence 8_4:3195:11118: scene=8_4
#: 8_4:3195
msgctxt "text_id=11118 | speaker=unknown"
msgid "　草十郎はしばし考えこんで、"
msgstr "  Soujyuro thought for a while before replying."

#. Occurrence 8_4:3231:11119: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0025; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:3231
msgctxt "text_id=11119 | speaker=soujuurou"
msgid "「夕方までゆっくりするよ。ここのところ忙しすぎた。"
msgstr "\"I'm just going to relax until the evening. I've been way too busy recently."

#. Occurrence 8_4:3237:11120: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_4_0026; voice_prefix=A30; voice_category=3; scene=8_4
#: 8_4:3237
msgctxt "text_id=11120 | speaker=soujuurou"
msgid "　せっかくだからテレビも見ていたいし、お昼には蒼崎を起こさないといけないだろ？」"
msgstr "  I want to watch some TV now since we have to wake up Aozaki at lunchtime, right?\""

#. Occurrence 8_4:3273:11121: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_4_0014; voice_prefix=A40; voice_category=2; scene=8_4
#: 8_4:3273
msgctxt "text_id=11121 | speaker=alice"
msgid "「……そう。なら静かにしていて」"
msgstr "\"...Right. Just keep it quiet, then.\""

#. Occurrence 8_4:3284:11122: scene=8_4
#: 8_4:3284
msgctxt "text_id=11122 | speaker=unknown"
msgid "　有珠は小さくため息をついて立ち上がった。"
msgstr "  Alice let out a gentle sigh and rose to her feet."

#. Occurrence 8_4:3289:11123: scene=8_4
#: 8_4:3289
msgctxt "text_id=11123 | speaker=unknown"
msgid "　静かにしていて。"
msgstr "  Just keep it quiet..."

#. Occurrence 8_4:3306:11124: scene=8_4
#: 8_4:3306
msgctxt "text_id=11124 | speaker=unknown"
msgid "　その言葉が何を示していたのか、草十郎は数分後に実感する事になる。"
msgstr "  Soujyuro would understand exactly what she meant by those words in just a few minutes."

#. Occurrence 8_5:62:11125: scene=8_5
#: 8_5:62
msgctxt "text_id=11125 | speaker=unknown"
msgid "　窓からの日射しが明るい。"
msgstr "  The sun shining through the window was bright."

#. Occurrence 8_5:67:11126: scene=8_5
#: 8_5:67
msgctxt "text_id=11126 | speaker=unknown"
msgid "　そろそろテレビのお茶の間番組にエンジンがかかってくる午前九時。"
msgstr "  It was just about nine o'clock, about time for the morning television programs to get going."

#. Occurrence 8_5:72:11127: scene=8_5
#: 8_5:72
msgctxt "text_id=11127 | speaker=unknown"
msgid "　草十郎はソファーに座って、外の様子を眺めていた。"
msgstr "  Soujyuro was sitting on the sofa, staring out the window at the scene outside."

#. Occurrence 8_5:95:11128: scene=8_5
#: 8_5:95
msgctxt "text_id=11128 | speaker=unknown"
msgid "　隣室のサンルームから見える中庭の荒廃ぶりは、とても一言では表せない。"
msgstr "  The view from the neighboring sunroom showed a courtyard in a state of disrepair."

#. Occurrence 8_5:100:11129: scene=8_5
#: 8_5:100
msgctxt "text_id=11129 | speaker=unknown"
msgid "　あるがままの自然は<尊|とうと>いが、人の手によって整頓された自然にも理解のある草十郎である。"
msgstr "  Soujyuro could appreciate the outdoors in both its natural, wild state, and when tamed by human hands."

#. Occurrence 8_5:121:11130: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0000; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:121
msgctxt "text_id=11130 | speaker=soujuurou"
msgid "“……アレは、近いうちになんとかせねばなるまい”"
msgstr "\"...I really need to do something about that sometime soon.\""

#. Occurrence 8_5:136:11131: scene=8_5
#: 8_5:136
msgctxt "text_id=11131 | speaker=unknown"
msgid "　などと、こぢんまりとした野望に燃えながら、教科書のページをまた一枚めくる。"
msgstr "  Soujyuro muttered to himself, turning another page in his textbook."

#. Occurrence 8_5:141:11132: scene=8_5
#: 8_5:141
msgctxt "text_id=11132 | speaker=unknown"
msgid "　テーブルには数学のテキストと青子印のノート。"
msgstr "  On the table before him was a mathematics textbook and a notebook with Aoko's name on it."

#. Occurrence 8_5:152:11133: scene=8_5
#: 8_5:152
msgctxt "text_id=11133 | speaker=unknown"
msgid "　一見して休日も予習を怠らない優等生……ではあるが、その実、これは妥協の結果である。"
msgstr "  Although at first glance he appeared to be a diligent student studying on his day off, he was in truth only doing so as a compromise."

#. Occurrence 8_5:157:11134: scene=8_5
#: 8_5:157
msgctxt "text_id=11134 | speaker=unknown"
msgid "　草十郎が第一目的とした朝のテレビ観賞は、ある理由から断念されてしまったからだ。"
msgstr "  He had given up on his main intent of watching the morning television shows."

#. Occurrence 8_5:188:11135: scene=8_5
#: 8_5:188
msgctxt "text_id=11135 | speaker=unknown"
msgid "　理由は言うまでもない。"
msgstr "  The reason why he gave up was simple."

#. Occurrence 8_5:211:11136: scene=8_5
#: 8_5:211
msgctxt "text_id=11136 | speaker=unknown"
msgid "　こうして、今も草十郎の正面で読書に没頭する、久遠寺有珠に気を遣っての事だ。"
msgstr "  He was being considerate of Alice, who sat in front of him with her nose buried in a book."

#. Occurrence 8_5:216:11137: scene=8_5
#: 8_5:216
msgctxt "text_id=11137 | speaker=unknown"
msgid "　てっきり自室に引きこもると思われていた彼女は、古びた本を持ち出して読書を始めてしまった。"
msgstr "  Instead of holing herself up in her room, she'd brought out her old, dusty books to read."

#. Occurrence 8_5:235:11138: scene=8_5
#: 8_5:235
msgctxt "text_id=11138 | speaker=unknown"
msgid "　静かにしていて、とはこういう事で、もはや無遠慮にテレビをつける事は難しい。"
msgstr "  This is what she meant when she had said to keep quiet. Soujyuro found it difficult to turn on the TV."

#. Occurrence 8_5:259:11139: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0001; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:259
msgctxt "text_id=11139 | speaker=soujuurou"
msgid "“……とりあえず、しばらくテレビは控えよう”"
msgstr "(...I guess I won't be watching TV for a while.)"

#. Occurrence 8_5:265:11140: scene=8_5
#: 8_5:265
msgctxt "text_id=11140 | speaker=unknown"
msgid "　そんな結論に達し、それじゃあ、と草十郎は赤点の補習課題に手を出したのだ。"
msgstr "  With that decided, Soujyuro resigned himself to reviewing some of the practice problems he'd gotten wrong."

#. Occurrence 8_5:270:11141: scene=8_5
#: 8_5:270
msgctxt "text_id=11141 | speaker=unknown"
msgid "　なぜか居間で。"
msgstr "  ...In the drawing room, for some reason."

#. Occurrence 8_5:276:11142: scene=8_5
#: 8_5:276
msgctxt "text_id=11142 | speaker=unknown"
msgid "ここに留まる理由もなかったが、自室に戻る理由も、同じぐらいなかったらしい。"
msgstr "There wasn't any particular purpose in doing it there, but he also had no real reason to study back up in his room."

#. Occurrence 8_5:301:11143: scene=8_5
#: 8_5:301
msgctxt "text_id=11143 | speaker=unknown"
msgid "　かくて、彼は有珠がいるにも拘わらず、<暢気|のんき>に<教科書|テキスト>に蛍光ペンなどを引いていたりする。"
msgstr "  And so there he was, leisurely highlighting his textbook with Alice there in the same room."

#. Occurrence 8_5:306:11144: scene=8_5
#: 8_5:306
msgctxt "text_id=11144 | speaker=unknown"
msgid "　草十郎にしてみれば屋根裏の自室も、有珠のいる居間もそう変わりはない。"
msgstr "  To Soujyuro, there really was no difference between his room in the attic and the drawing room with Alice."

#. Occurrence 8_5:311:11145: scene=8_5
#: 8_5:311
msgctxt "text_id=11145 | speaker=unknown"
msgid "　波乱の予兆さえなければ人食い虎とでも同居する―――"
msgstr "  To be fair, he could probably live with a tiger as long as it didn't cause any trouble."

#. Occurrence 8_5:316:11146: scene=8_5
#: 8_5:316
msgctxt "text_id=11146 | speaker=unknown"
msgid "　それが静希草十郎の、最大にして最悪の長所だった。"
msgstr "  That was both Soujyuro's biggest strength and his biggest weakness."

#. Occurrence 8_5:363:11147: scene=8_5
#: 8_5:363
msgctxt "text_id=11147 | speaker=unknown"
msgid "　気が付けば、時計の針が十一時を指していた。"
msgstr "  Before he knew it, the clock was showing eleven."

#. Occurrence 8_5:368:11148: scene=8_5
#: 8_5:368
msgctxt "text_id=11148 | speaker=unknown"
msgid "　二時間近くかけても、数学の課題は半分も終わらない。"
msgstr "  He'd spent two hours doing his math problems but wasn't even halfway finished."

#. Occurrence 8_5:373:11149: scene=8_5
#: 8_5:373
msgctxt "text_id=11149 | speaker=unknown"
msgid "　この程度で音をあげる自分の根性の無さに、草十郎は消沈する。"
msgstr "  More than that, he was disappointed in himself for lacking the courage to speak up at all."

#. Occurrence 8_5:391:11150: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0002; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:391
msgctxt "text_id=11150 | speaker=soujuurou"
msgid "『……それにくらべて、蒼崎は頑張ってる』"
msgstr "(...In comparison, Aozaki is really working hard.)"

#. Occurrence 8_5:396:11151: scene=8_5
#: 8_5:396
msgctxt "text_id=11151 | speaker=unknown"
msgid "　ぽん、とノートの上を転がっていくシャープペン。"
msgstr "  He dropped his mechanical pencil onto the notebook and watched it roll away."

#. Occurrence 8_5:422:11152: scene=8_5
#: 8_5:422
msgctxt "text_id=11152 | speaker=unknown"
msgid "　試験が終わってからこっち、青子たちが何やら活動している事は知っている。"
msgstr "  He knew that Aoko and Alice were busy with something since final exams had ended."

#. Occurrence 8_5:427:11153: scene=8_5
#: 8_5:427
msgctxt "text_id=11153 | speaker=unknown"
msgid "　それで彼女がほとんど眠っていない事も、"
msgstr "  He also knew that she had hardly gotten any sleep recently."

#. Occurrence 8_5:432:11154: scene=8_5
#: 8_5:432
msgctxt "text_id=11154 | speaker=unknown"
msgid "　試験中、自分を無視していればもっと楽になっていたであろう事も、分かっていた。"
msgstr "  If she had been able to ignore him during exams, she probably would have had an easier time."

#. Occurrence 8_5:452:11155: scene=8_5
#: 8_5:452
msgctxt "text_id=11155 | speaker=unknown"
msgid "　今日の仮眠だって、青子にとっては何日かぶりのまともな睡眠だろう。"
msgstr "  Today's nap was probably the first proper sleep Aoko had gotten in days."

#. Occurrence 8_5:457:11156: scene=8_5
#: 8_5:457
msgctxt "text_id=11156 | speaker=unknown"
msgid "　疲労はとうにピークの筈だ。なのに、そんな素振りも見せないで青子はきびきびと歩いている。"
msgstr "  Though, she showed no signs of exhaustion despite the fact that she must have hit peak long ago. She always seemed raring to go."

#. Occurrence 8_5:488:11157: scene=8_5
#: 8_5:488
msgctxt "text_id=11157 | speaker=unknown"
msgid "　弱音を吐かない、のではなく。"
msgstr "  It wasn't that she was trying to act tough;"

#. Occurrence 8_5:493:11158: scene=8_5
#: 8_5:493
msgctxt "text_id=11158 | speaker=unknown"
msgid "　弱音そのものが浮かんでいない、前向きで強い<信念|こころ>。"
msgstr "  that was just the kind of person she was. Always positive, always tough as nails."

#. Occurrence 8_5:498:11159: scene=8_5
#: 8_5:498
msgctxt "text_id=11159 | speaker=unknown"
msgid "　彼女が時に理不尽として映るのは、そのまっすぐさ故だろう。"
msgstr "  And that was exactly why she came off as completely irrational at times."

#. Occurrence 8_5:531:11160: scene=8_5
#: 8_5:531
msgctxt "text_id=11160 | speaker=unknown"
msgid "　それを言うなら目前の有珠だって同じかもしれない。"
msgstr "  But if that was the case, you could probably describe Alice in exactly the same way."

#. Occurrence 8_5:556:11161: scene=8_5
#: 8_5:556
msgctxt "text_id=11161 | speaker=unknown"
msgid "　目的に向かってひた走る彼女たちを見ていると、漠然と自分の中途半端さを考えてしまう。"
msgstr "  Soujyuro couldn't help but feel a bit inadequate when he saw their single-minded focus on their goals."

#. Occurrence 8_5:562:11162: scene=8_5
#: 8_5:562
msgctxt "text_id=11162 | speaker=unknown"
msgid "　今までは新生活に慣れようと必死だったけれど、もし慣れてしまったのなら、その後はどうする気なのか、と。"
msgstr "  He'd been so preoccupied with adjusting to his new life that he'd neglected to think about what he was going to do with himself after."

#. Occurrence 8_5:597:11163: scene=8_5
#: 8_5:597
msgctxt "text_id=11163 | speaker=unknown"
msgid "　それを思うと、草十郎の心は暗い影に<覆|おお>われる。"
msgstr "  Thinking about this cast a gloomy cloud over his heart."

#. Occurrence 8_5:602:11164: scene=8_5
#: 8_5:602
msgctxt "text_id=11164 | speaker=unknown"
msgid "　自分は彼女たちのような、明確な目的はもう見つからない気がするからだ。"
msgstr "  He felt like he'd never find a clear purpose in life like Aoko and Alice seemed to have."

#. Occurrence 8_5:618:11165: scene=8_5
#: 8_5:618
msgctxt "text_id=11165 | speaker=unknown"
msgid "　……山から下りた時から。"
msgstr "  ...At least not since he'd left the mountains."

#. Occurrence 8_5:623:11166: scene=8_5
#: 8_5:623
msgctxt "text_id=11166 | speaker=unknown"
msgid "　彼の糸は断ち切れて、二度と戻ることはない。"
msgstr "  His old life was gone now, never to return."

#. Occurrence 8_5:643:11167: scene=8_5
#: 8_5:643
msgctxt "text_id=11167 | speaker=unknown"
msgid "　糸の切れた<凧|たこ>は<惰性|だせい>で流れていくだけだ。"
msgstr "  He was like a kite cut from its string, destined to fly only where the winds took it."

#. Occurrence 8_5:658:11168: scene=8_5
#: 8_5:658
msgctxt "text_id=11168 | speaker=unknown"
msgid "　その先には何もないと分かっていても、地に足がついていないのでどうにもならない。"
msgstr "  And without anything to ground him, he couldn't do anything about the empty future that lay ahead."

#. Occurrence 8_5:663:11169: scene=8_5
#: 8_5:663
msgctxt "text_id=11169 | speaker=unknown"
msgid "　いずれ空にまぎれて、地上から見えなくなる。"
msgstr "  He could only let himself fly where the currents took him, slowly losing sight of the ground below."

#. Occurrence 8_5:697:11170: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0003; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:697
msgctxt "text_id=11170 | speaker=soujuurou"
msgid "『……そうだな。便利な物はあふれているけど、本当に望むものは―――』"
msgstr "(There's all the conveniences you could ask for here, but nothing I truly desire...)"

#. Occurrence 8_5:703:11171: scene=8_5
#: 8_5:703
msgctxt "text_id=11171 | speaker=unknown"
msgid "　町を歩くだけで山ほどある筈なのに、どうしても見つけ出せない。"
msgstr "  The town was full of options, but he could find nothing."

#. Occurrence 8_5:723:11172: scene=8_5
#: 8_5:723
msgctxt "text_id=11172 | speaker=unknown"
msgid "　もう何度も繰り返した自問。"
msgstr "  He'd asked himself the same questions time and time again."

#. Occurrence 8_5:728:11173: scene=8_5
#: 8_5:728
msgctxt "text_id=11173 | speaker=unknown"
msgid "　自分に言い聞かせたところで気持ちは晴れるどころか、暗くなっていく一方だった。"
msgstr "  It never made him feel any better. If anything, it only made him feel worse and worse."

#. Occurrence 8_5:733:11174: scene=8_5
#: 8_5:733
msgctxt "text_id=11174 | speaker=unknown"
msgid "　それとも、あるいは。"
msgstr "  That, or..."

#. Occurrence 8_5:738:11175: scene=8_5
#: 8_5:738
msgctxt "text_id=11175 | speaker=unknown"
msgid "　己の半端さを嘆くほどには、いつか、希望らしきものが見つかると<縋|すが>っているのだろうか……？"
msgstr "  Maybe he felt that lamenting his own ineptitude would lead to finding some kind of goal or desire someday."

#. Occurrence 8_5:765:11176: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0004; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:765
msgctxt "text_id=11176 | speaker=soujuurou"
msgid "「―――――はあ」"
msgstr "\"...Hah.\""

#. Occurrence 8_5:772:11177: scene=8_5
#: 8_5:772
msgctxt "text_id=11177 | speaker=unknown"
msgid "　自分の弱音に呆れて、草十郎はノートを閉じた。"
msgstr "  Tired of his own sniveling, Soujyuro dejectedly closed his notebook."

#. Occurrence 8_5:788:11178: scene=8_5
#: 8_5:788
msgctxt "text_id=11178 | speaker=unknown"
msgid "　ふと視線をあげると、ブラウン管に自分の顔が映っている。"
msgstr "  When he looked up, he saw his own face reflected back at him in the TV screen."

#. Occurrence 8_5:793:11179: scene=8_5
#: 8_5:793
msgctxt "text_id=11179 | speaker=unknown"
msgid "　昨日まではなかった首の飾りは、まだ居心地が悪そうに巻かれていた。"
msgstr "  His new collar was there around his neck, looking as out of place as ever."

#. Occurrence 8_5:840:11180: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0005; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:840
msgctxt "text_id=11180 | speaker=soujuurou"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 8_5:846:11181: scene=8_5
#: 8_5:846
msgctxt "text_id=11181 | speaker=unknown"
msgid "　なるほど。他人の強さを見て自分の弱さを嘆く馬鹿者には、首輪の一つも着けていなくては危なっかしい。"
msgstr "  Perhaps a fool like him who felt weak when faced with others' strengths did need to wear a collar after all."

#. Occurrence 8_5:875:11182: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0006; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:875
msgctxt "text_id=11182 | speaker=soujuurou"
msgid "『まったくだ。悩むのはいっちょ前になってから』"
msgstr "(This is silly. I shouldn't worry about this until I'm actually an adult.)"

#. Occurrence 8_5:887:11183: scene=8_5
#: 8_5:887
msgctxt "text_id=11183 | speaker=unknown"
msgid "　弱音を振り払って、背中を伸ばす。"
msgstr "  He shook off his thoughts of doom and gloom and sat up straight."

#. Occurrence 8_5:892:11184: scene=8_5
#: 8_5:892
msgctxt "text_id=11184 | speaker=unknown"
msgid "　<鈍|にぶ>った体に活を入れて、草十郎は立ち上がった。"
msgstr "  After psyching himself up a little, he stood up from the sofa."

#. Occurrence 8_5:933:11185: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0007; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:933
msgctxt "text_id=11185 | speaker=soujuurou"
msgid "「よし。何か作るけど、有珠は？」"
msgstr "\"I'm gonna make some food. You want anything, Alice?\""

#. Occurrence 8_5:939:11186: scene=8_5
#: 8_5:939
msgctxt "text_id=11186 | speaker=unknown"
msgid "　ついでに。"
msgstr "  Soujyuro asked casually."

#. Occurrence 8_5:945:11187: scene=8_5
#: 8_5:945
msgctxt "text_id=11187 | speaker=unknown"
msgid "今までやりたい放題していた草十郎だが、きちんと有珠を気にかけていたらしい。"
msgstr "While Soujyuro had been doing his own thing, he had remained mindful of Alice."

#. Occurrence 8_5:985:11188: scene=8_5
#: 8_5:985
msgctxt "text_id=11188 | speaker=unknown"
msgid "　名前を呼ばれて、有珠はハッとあたりを見渡した。"
msgstr "  Alice looked up, surprised at hearing her name."

#. Occurrence 8_5:990:11189: scene=8_5
#: 8_5:990
msgctxt "text_id=11189 | speaker=unknown"
msgid "　草十郎とは逆に、完全に草十郎を失念していたようだ。"
msgstr "  She had completely forgotten Soujyuro was even there."

#. Occurrence 8_5:1017:11190: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_5_0000; voice_prefix=A40; voice_category=2; scene=8_5
#: 8_5:1017
msgctxt "text_id=11190 | speaker=alice"
msgid "「わ、わたし……？」"
msgstr "\"M-Me...?\""

#. Occurrence 8_5:1038:11191: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_5_0008; voice_prefix=A30; voice_category=3; scene=8_5
#: 8_5:1038
msgctxt "text_id=11191 | speaker=soujuurou"
msgid "「ああ。有珠、朝から紅茶しか飲んでないだろ。どうせ作るなら、いっぱい作った方がお得なんだ」"
msgstr "\"Yes, you. You've only had some tea all morning. If I'm going to be cooking, I might as well cook for everyone.\""

#. Occurrence 8_5:1064:11192: scene=8_5
#: 8_5:1064
msgctxt "text_id=11192 | speaker=unknown"
msgid "　有珠の返事も待たず、草十郎はエプロンをしながら台所へと歩いていく。"
msgstr "  Without waiting for her reply, Soujyuro headed off to the kitchen while putting on his apron."

#. Occurrence 8_5:1070:11193: scene=8_5
#: 8_5:1070
msgctxt "text_id=11193 | speaker=unknown"
msgid "　それを有珠は手だけで呼び止めるが、草十郎はもう台所に移動していた。"
msgstr "  Alice tried to wave at him to stop, but by then he'd already disappeared into the kitchen."

#. Occurrence 8_5:1117:11194: scene=8_5
#: 8_5:1117
msgctxt "text_id=11194 | speaker=unknown"
msgid "　……わざわざ台所まで足を運び、自分の分はいらない、というのも<躊躇|ためら>われる。"
msgstr "  She was hesitant to walk all the way in there just to tell him she didn't need anything."

#. Occurrence 8_5:1122:11195: scene=8_5
#: 8_5:1122
msgctxt "text_id=11195 | speaker=unknown"
msgid "　というか、空腹なのは事実なのだ。"
msgstr "  And besides, she was actually hungry."

#. Occurrence 8_5:1127:11196: scene=8_5
#: 8_5:1127
msgctxt "text_id=11196 | speaker=unknown"
msgid "　草十郎の提案は、今の彼女の健康状態から見れば合理的である。"
msgstr "  Soujyuro's proposal made sense, and her empty stomach agreed."

#. Occurrence 8_5:1147:11197: scene=8_5
#: 8_5:1147
msgctxt "text_id=11197 | speaker=unknown"
msgid "　有珠は空腹で、草十郎は昼食を作る。"
msgstr "  Alice was hungry, and Soujyuro was going to make lunch."

#. Occurrence 8_5:1152:11198: scene=8_5
#: 8_5:1152
msgctxt "text_id=11198 | speaker=unknown"
msgid "　一緒に作るのなら、別々に昼食を用意する時間を短縮できる。"
msgstr "  Making lunch for both of them would save the time and trouble of cooking two separate meals."

#. Occurrence 8_5:1157:11199: scene=8_5
#: 8_5:1157
msgctxt "text_id=11199 | speaker=unknown"
msgid "　感情論を除けば、有珠にはまったく反論の余地がない。"
msgstr "  There was no logical reason for Alice to refuse his gesture."

#. Occurrence 8_5:1185:11200: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_5_0001; voice_prefix=A40; voice_category=2; scene=8_5
#: 8_5:1185
msgctxt "text_id=11200 | speaker=alice"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 8_5:1191:11201: scene=8_5
#: 8_5:1191
msgctxt "text_id=11201 | speaker=unknown"
msgid "　喉まで出た声を飲みこんで、有珠は草十郎を黙認する事にした。"
msgstr "  She decided to stay quiet, and tacitly accept his offer."

#. Occurrence 8_5:1248:11202: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_5_0002; voice_prefix=A40; voice_category=2; scene=8_5
#: 8_5:1248
msgctxt "text_id=11202 | speaker=alice"
msgid "『……変な人』"
msgstr "\"...He is so strange.\""

#. Occurrence 8_5:1253:11203: scene=8_5
#: 8_5:1253
msgctxt "text_id=11203 | speaker=unknown"
msgid "　わずかに間をおいて、誰に聞かせるでもなく、控えめに呟きながら。"
msgstr "  She whispered the words softly, not for anyone in particular to hear but herself."

#. Occurrence 8_6:64:11204: scene=8_6
#: 8_6:64
msgctxt "text_id=11204 | speaker=unknown"
msgid "　とは言いつつも実のところ。"
msgstr "  The truth was, however..."

#. Occurrence 8_6:69:11205: scene=8_6
#: 8_6:69
msgctxt "text_id=11205 | speaker=unknown"
msgid "　今朝からこっち、久遠寺有珠はたいへん立腹していた。"
msgstr "  Alice had been in a bad mood all morning."

#. Occurrence 8_6:130:11206: scene=8_6
#: 8_6:130
msgctxt "text_id=11206 | speaker=unknown"
msgid "　三咲市の支点をチェックして回り、始発の電車で陶川から帰ってくる時から、彼女はずっと、今日は居間で日が暮れるまで読書、文字がゲシュタルトるまで読書、と決めていたのである。"
msgstr "  After checking all the sigils around Misaki City and boarding the first train back from Toukawa, all she wanted to do was spend the rest of her day reading until the words turned into a jumble."

#. Occurrence 8_6:135:11207: scene=8_6
#: 8_6:135
msgctxt "text_id=11207 | speaker=unknown"
msgid "　そんな鉄の意志は、居間に余人がいたところで<覆|くつがえ>されるものではない。"
msgstr "  Her iron resolve to complete this task would not be interrupted by someone else milling about in the drawing room."

#. Occurrence 8_6:158:11208: scene=8_6
#: 8_6:158
msgctxt "text_id=11208 | speaker=unknown"
msgid "　ましてや自分は館の主人なのだから、草十郎の為に自室に引きこもるなんてもっての外だ。"
msgstr "  This was her mansion and there was no way she was going to lock herself up in her room on account of Soujyuro."

#. Occurrence 8_6:178:11209: scene=8_6
#: 8_6:178
msgctxt "text_id=11209 | speaker=unknown"
msgid "　……しかし。"
msgstr "  However..."

#. Occurrence 8_6:184:11210: scene=8_6
#: 8_6:184
msgctxt "text_id=11210 | speaker=unknown"
msgid "そうは言いつつも、理由なく草十郎を追い出すのもなんだか間違っている。"
msgstr "With that said, she knew it would be wrong to kick Soujyuro out for no real reason."

#. Occurrence 8_6:200:11211: scene=8_6
#: 8_6:200
msgctxt "text_id=11211 | speaker=unknown"
msgid "　現状において、草十郎はたしかに“静かに”している。"
msgstr "  As it stood, Soujyuro had actually kept quiet like she'd asked."

#. Occurrence 8_6:205:11212: scene=8_6
#: 8_6:205
msgctxt "text_id=11212 | speaker=unknown"
msgid "　彼に問題はない。それでもひとりでいたいなら、有珠の方が自室に戻るべきなのである。"
msgstr "  He wasn't in the wrong here. If Alice had really wanted to be alone, she should have gone to her room."

#. Occurrence 8_6:251:11213: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0000; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:251
msgctxt "text_id=11213 | speaker=alice"
msgid "“……静かにして、じゃなくて、ひとりにさせて、と言うべきだった―――”"
msgstr "\"I should have told him to leave me alone instead of just telling him to be quiet...\""

#. Occurrence 8_6:257:11214: scene=8_6
#: 8_6:257
msgctxt "text_id=11214 | speaker=unknown"
msgid "　そんなジレンマに陥りながら、少しだけ意地になって有珠は居間に残ったのだ。"
msgstr "  Alice had defiantly stayed in the drawing room despite realizing the dilemma she'd put herself in."

#. Occurrence 8_6:262:11215: scene=8_6
#: 8_6:262
msgctxt "text_id=11215 | speaker=unknown"
msgid "　どうせ、草十郎の方が音をあげて屋根裏部屋に逃げこむだろうと予想して。"
msgstr "  She had figured Soujyuro would eventually make a ruckus and run off to hide in his attic room."

#. Occurrence 8_6:299:11216: scene=8_6
#: 8_6:299
msgctxt "text_id=11216 | speaker=unknown"
msgid "　結果、予想は大きく外れる事になった。"
msgstr "  Her assumption could not have been more wrong."

#. Occurrence 8_6:304:11217: scene=8_6
#: 8_6:304
msgctxt "text_id=11217 | speaker=unknown"
msgid "　彼は居間から退散しなかったし、"
msgstr "  Soujyuro never left the drawing room."

#. Occurrence 8_6:309:11218: scene=8_6
#: 8_6:309
msgctxt "text_id=11218 | speaker=unknown"
msgid "　不思議なことに、少女も草十郎の<存在|こと>が気にならなくなったからだ。"
msgstr "  Moreover, she had actually stopped caring that he was there."

#. Occurrence 8_6:329:11219: scene=8_6
#: 8_6:329
msgctxt "text_id=11219 | speaker=unknown"
msgid "　彼は有珠を意識する事なく、また、無視しているわけでもなかった。"
msgstr "  Though he hadn't paid her any attention, he hadn't ignored her either."

#. Occurrence 8_6:337:11220: scene=8_6
#: 8_6:337
msgctxt "text_id=11220 | speaker=unknown"
msgid "　お互い無言でいたのに、それで気まずいという事もない。"
msgstr "  They had simply sat in silence together without any awkwardness."

#. Occurrence 8_6:342:11221: scene=8_6
#: 8_6:342
msgctxt "text_id=11221 | speaker=unknown"
msgid "　ひとりでいるような解放感があるのに、誰かが<傍|そば>にいるという安心感がある。"
msgstr "  Alice felt the freedom of being alone along with the comfort of someone being by her side."

#. Occurrence 8_6:362:11222: scene=8_6
#: 8_6:362
msgctxt "text_id=11222 | speaker=unknown"
msgid "　……言葉にすると、静希草十郎という人間はそんな感じだった。"
msgstr "  To put it into words, Soujyuro was just that kind of person."

#. Occurrence 8_6:380:11223: scene=8_6
#: 8_6:380
msgctxt "text_id=11223 | speaker=unknown"
msgid "　だからこそ、すぐ傍に他人がいたのに眠り続ける、なんて事が出来たのかも知れない。"
msgstr "  That was probably the only reason Alice had been able to sleep so soundly with him there next to her."

#. Occurrence 8_6:432:11224: scene=8_6
#: 8_6:432
msgctxt "text_id=11224 | speaker=unknown"
msgid "　そんな有珠の内面も知らず、草十郎は台所で何やら調理を続けている。"
msgstr "  Soujyuro continued cooking in the kitchen, oblivious to the thoughts that went through Alice's head."

#. Occurrence 8_6:437:11225: scene=8_6
#: 8_6:437
msgctxt "text_id=11225 | speaker=unknown"
msgid "　居間からは見えないけれど、有珠には気楽に調理している後ろ姿が容易に想像できた。"
msgstr "  She couldn't see him from the drawing room, but she could easily imagine him cooking in the kitchen."

#. Occurrence 8_6:473:11226: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0001; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:473
msgctxt "text_id=11226 | speaker=alice"
msgid "「……変な人ね、ほんとうに」"
msgstr "\"...He really is strange.\""

#. Occurrence 8_6:479:11227: scene=8_6
#: 8_6:479
msgctxt "text_id=11227 | speaker=unknown"
msgid "　二度目の所感を漏らして、有珠は読書を再開した。"
msgstr "  Alice resumed reading after unwittingly stating her feelings out loud a second time."

#. Occurrence 8_6:484:11228: scene=8_6
#: 8_6:484
msgctxt "text_id=11228 | speaker=unknown"
msgid "　居間から差しこむ光はじき正午である事を示している。"
msgstr "  The sunlight beaming into the drawing room showed that it was noon."

#. Occurrence 8_6:489:11229: scene=8_6
#: 8_6:489
msgctxt "text_id=11229 | speaker=unknown"
msgid "　冬の曇った天気にしては、その日射しはどこか温かそうだった。"
msgstr "  The sunlight actually looked warm, despite it being a cloudy winter day."

#. Occurrence 8_6:536:11230: scene=8_6
#: 8_6:536
msgctxt "text_id=11230 | speaker=unknown"
msgid "　ちょうど正午にさしかかろうとした時、草十郎は二人分の食器を持って居間へ戻ってきた。"
msgstr "  Just as noon struck, Soujyuro returned to the drawing room with two sets of plates."

#. Occurrence 8_6:541:11231: scene=8_6
#: 8_6:541
msgctxt "text_id=11231 | speaker=unknown"
msgid "　大きなクリーム色のお皿には、なんとも言えない色合いの料理が盛られている。"
msgstr "  Some food of an indescribable color was piled on the large cream-colored plates."

#. Occurrence 8_6:597:11232: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0002; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:597
msgctxt "text_id=11232 | speaker=alice"
msgid "「これ、は―――」"
msgstr "\"This is, um...\""

#. Occurrence 8_6:603:11233: scene=8_6
#: 8_6:603
msgctxt "text_id=11233 | speaker=unknown"
msgid "　期待など、してはいなかった。"
msgstr "  She hadn't expected much."

#. Occurrence 8_6:608:11234: scene=8_6
#: 8_6:608
msgctxt "text_id=11234 | speaker=unknown"
msgid "　期待などしてはいなかったので、粗末なものがきたらそれを理由に断ろう―――"
msgstr "  And since she also hadn't requested anything, she could just refuse if it was something she didn't want..."

#. Occurrence 8_6:613:11235: scene=8_6
#: 8_6:613
msgctxt "text_id=11235 | speaker=unknown"
msgid "　なんて<覚悟|かくご><装填|そうてん>済みの有珠をして、それは、絶句させるに足る魔料理だった。"
msgstr "  But this \"food\" left her at a loss for words despite psyching herself up."

#. Occurrence 8_6:662:11236: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0003; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:662
msgctxt "text_id=11236 | speaker=alice"
msgid "「これ、は、なに？」"
msgstr "\"What... is this?\""

#. Occurrence 8_6:667:11237: scene=8_6
#: 8_6:667
msgctxt "text_id=11237 | speaker=unknown"
msgid "　おそるおそる口にする有珠。"
msgstr "  Alice spoke as though she was terrified of what had been placed before her."

#. Occurrence 8_6:709:11238: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0000; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:709
msgctxt "text_id=11238 | speaker=soujuurou"
msgid "「ん？　なにって、焼きうどんになんか掛けてみた」"
msgstr "\"Huh? I just put some stuff on top of stir-fried udon noodles.\""

#. Occurrence 8_6:743:11239: scene=8_6
#: 8_6:743
msgctxt "text_id=11239 | speaker=unknown"
msgid "　青子がいたら鉄拳制裁ものの発言である。"
msgstr "  If Aoko had been there, she probably would have punched him."

#. Occurrence 8_6:765:11240: scene=8_6
#: 8_6:765
msgctxt "text_id=11240 | speaker=unknown"
msgid "　草十郎はなに恥じらう事なく、どん、どん、とテーブルに大皿を置いていく。"
msgstr "  But Soujyuro just confidently placed the two large plates on the table."

#. Occurrence 8_6:770:11241: scene=8_6
#: 8_6:770
msgctxt "text_id=11241 | speaker=unknown"
msgid "　ごうごうと立ち上る、<恐山|おそれざん>の憤怒のごとき湯気。"
msgstr "  Steam billowed from the mountain of food like an angry volcano ready to erupt at any moment."

#. Occurrence 8_6:775:11242: scene=8_6
#: 8_6:775
msgctxt "text_id=11242 | speaker=unknown"
msgid "　どろどろとドロドロする、エトナ火山の<溶岩|マグマ>のごときなんか。"
msgstr "  The thick mystery sauce flowed over the plates as magma might from said eruption."

#. Occurrence 8_6:780:11243: scene=8_6
#: 8_6:780
msgctxt "text_id=11243 | speaker=unknown"
msgid "　その下に身を潜める、ごんぶとな無数の<触手|うどん>たち。"
msgstr "  And below it all were a seemingly infinite number of slimy tentacle-like noodles."

#. Occurrence 8_6:800:11244: scene=8_6
#: 8_6:800
msgctxt "text_id=11244 | speaker=unknown"
msgid "　……もはや語るまでもない。"
msgstr "  There was really nothing more to say about it."

#. Occurrence 8_6:805:11245: scene=8_6
#: 8_6:805
msgctxt "text_id=11245 | speaker=unknown"
msgid "　これは質より量を重視する、一人暮らしの男子学生にのみ伝わる味わい。"
msgstr "  This was clearly the food of a poor, struggling student who favored quantity over quality."

#. Occurrence 8_6:825:11246: scene=8_6
#: 8_6:825
msgctxt "text_id=11246 | speaker=unknown"
msgid "　必要なものはレシピとやる気と材料だけ。"
msgstr "  All that was required was a basic recipe, the will to cook something, and what few ingredients were needed."

#. Occurrence 8_6:830:11247: scene=8_6
#: 8_6:830
msgctxt "text_id=11247 | speaker=unknown"
msgid "　喩えるなら、大量の焼きうどんに、大量のあんかけを組み合わせた芸術的なまでの芸術性のなさ。"
msgstr "  The pile of stir-fried noodles with sauce slathered on top was so horrifically bad, it was almost an art form."

#. Occurrence 8_6:835:11248: scene=8_6
#: 8_6:835
msgctxt "text_id=11248 | speaker=unknown"
msgid "　そう、これこそは紛うことなき<男|おとこ>料理。"
msgstr "  This was a bachelor's cooking, if she'd ever seen it."

#. Occurrence 8_6:841:11249: scene=8_6
#: 8_6:841
msgctxt "text_id=11249 | speaker=unknown"
msgid "　またの名をまかないとも言う。"
msgstr "  There was really nothing else you could call it."

#. Occurrence 8_6:905:11250: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0004; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:905
msgctxt "text_id=11250 | speaker=alice"
msgid "「……………………」"
msgstr "\"...\""

#. Occurrence 8_6:910:11251: scene=8_6
#: 8_6:910
msgctxt "text_id=11251 | speaker=unknown"
msgid "　一時間も何をやっていたかと思えば、せっせとあんかけを作っていたらしい。"
msgstr "  She had wondered what he was doing for an hour in there, and it turned out he had been making this sauce."

#. Occurrence 8_6:915:11252: scene=8_6
#: 8_6:915
msgctxt "text_id=11252 | speaker=unknown"
msgid "　焼きうどんだけで十分なのに、もう<一手間|ひとてま>加えたのは草十郎なりに真心だろう。"
msgstr "  No sauce would've been fine, but Soujyuro had wholeheartedly gone the extra mile."

#. Occurrence 8_6:920:11253: scene=8_6
#: 8_6:920
msgctxt "text_id=11253 | speaker=unknown"
msgid "　草十郎は小さくおじぎをしてから箸を手にとった。"
msgstr "  Soujyuro bowed his head slightly and picked up his chopsticks."

#. Occurrence 8_6:925:11254: scene=8_6
#: 8_6:925
msgctxt "text_id=11254 | speaker=unknown"
msgid "　有珠にはフォークが用意されている。"
msgstr "  He had brought a fork for Alice."

#. Occurrence 8_6:949:11255: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0005; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:949
msgctxt "text_id=11255 | speaker=alice"
msgid "「……………………」"
msgstr "\"...\""

#. Occurrence 8_6:957:11256: scene=8_6
#: 8_6:957
msgctxt "text_id=11256 | speaker=unknown"
msgid "　フォークを手にとって、有珠はあんかけに半分埋まっている麺をつついてみる。"
msgstr "  She picked up the fork and stuck it into the noodles half-drowning in sauce."

#. Occurrence 8_6:962:11257: scene=8_6
#: 8_6:962
msgctxt "text_id=11257 | speaker=unknown"
msgid "　毒見にしか見えない有珠の様子を気にした風もなく、草十郎は行儀よく食べはじめていた。"
msgstr "  Soujyuro began eating, not seeming to care that Alice sat there looking like she was about to eat poison."

#. Occurrence 8_6:1019:11258: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0006; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1019
msgctxt "text_id=11258 | speaker=alice"
msgid "「……………………」"
msgstr "\"...\""

#. Occurrence 8_6:1024:11259: scene=8_6
#: 8_6:1024
msgctxt "text_id=11259 | speaker=unknown"
msgid "　有珠的には挑戦と映ったのか、むっと眉をひそめながら、大雑把すぎる料理を口に運ぶ。"
msgstr "  Seeming to view this as a challenge, Alice furrowed her brow and slowly brought the mass of noodles to her mouth."

#. Occurrence 8_6:1077:11260: scene=8_6
#: 8_6:1077
msgctxt "text_id=11260 | speaker=unknown"
msgid "　……形容し辛い味ではあるが、食べられないほど不味くはない。あえて批評するのなら、わりとクセになる味、というところだった。"
msgstr "  ...It was a little salty and ugly to look at, but it didn't taste all that bad. If anything, it was actually pretty good."

#. Occurrence 8_6:1125:11261: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0001; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:1125
msgctxt "text_id=11261 | speaker=soujuurou"
msgid "「ひとつ、聞きたいんだけど」"
msgstr "\"So, I want to ask you something.\""

#. Occurrence 8_6:1143:11262: scene=8_6
#: 8_6:1143
msgctxt "text_id=11262 | speaker=unknown"
msgid "　焼きうどんを食べるのを中断して、草十郎は有珠に語りかけた。"
msgstr "  Soujyuro put down his chopsticks and turned to speak to Alice."

#. Occurrence 8_6:1149:11263: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0002; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:1149
msgctxt "text_id=11263 | speaker=soujuurou"
msgid "「実際の話。魔術師の話はともかくとして、蒼崎はまだ誰にも手をだしてないんじゃないか？」"
msgstr "\"Be honest with me. Mage or not, Aozaki hasn't actually taken a life yet, has she?\""

#. Occurrence 8_6:1190:11264: scene=8_6
#: 8_6:1190
msgctxt "text_id=11264 | speaker=unknown"
msgid "　唐突な問いに、有珠は静かに顔を上げた。"
msgstr "  Alice looked up quietly at the sudden question."

#. Occurrence 8_6:1195:11265: scene=8_6
#: 8_6:1195
msgctxt "text_id=11265 | speaker=unknown"
msgid "　今まで男料理の観察にうつむいていた有珠の視線が、まっすぐに草十郎と向き合う。"
msgstr "  She had been inspecting Soujyuro's meal, but now she looked straight at him."

#. Occurrence 8_6:1236:11266: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0007; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1236
msgctxt "text_id=11266 | speaker=alice"
msgid "「……おかしな事を訊くのね、静希君は」"
msgstr "\"...That's a rather odd question, Sizuki.\""

#. Occurrence 8_6:1255:11267: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0003; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:1255
msgctxt "text_id=11267 | speaker=soujuurou"
msgid "「有珠には悪いけど、これは蒼崎本人には訊きようのない事だから。言いたくなければ答えないでくれ」"
msgstr "\"I know. I hate to ask you, but it's just not something I feel comfortable asking Aozaki directly. If you don't want to answer, you don't have to.\""

#. Occurrence 8_6:1287:11268: scene=8_6
#: 8_6:1287
msgctxt "text_id=11268 | speaker=unknown"
msgid "　有珠からの返答はない。"
msgstr "  Alice didn't respond."

#. Occurrence 8_6:1292:11269: scene=8_6
#: 8_6:1292
msgctxt "text_id=11269 | speaker=unknown"
msgid "　それを残念に思う事もなく、草十郎は食事を再開した。"
msgstr "  Soujyuro resumed eating, not seeming disappointed."

#. Occurrence 8_6:1297:11270: scene=8_6
#: 8_6:1297
msgctxt "text_id=11270 | speaker=unknown"
msgid "　つるつると麺を食べていく草十郎を、有珠は何の感情もなく眺めている。"
msgstr "  Alice stared blankly at him slurping his noodles."

#. Occurrence 8_6:1302:11271: scene=8_6
#: 8_6:1302
msgctxt "text_id=11271 | speaker=unknown"
msgid "　少女は何度か<逡巡|しゅんじゅん>した後、"
msgstr "  After much hesitation, she replied."

#. Occurrence 8_6:1342:11272: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0008; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1342
msgctxt "text_id=11272 | speaker=alice"
msgid "「……静希君の言う通り、青子はまだ人を殺した事はないわ。"
msgstr "\"No. Just like you said, Aoko hasn't killed anyone yet."

#. Occurrence 8_6:1349:11273: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0009; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1349
msgctxt "text_id=11273 | speaker=alice"
msgid "その行為自体は、何回かこなしてはいるけれど」"
msgstr "She has been involved in that sort of thing multiple times, though.\""

#. Occurrence 8_6:1355:11274: scene=8_6
#: 8_6:1355
msgctxt "text_id=11274 | speaker=unknown"
msgid "　途切れがちに有珠は言う。"
msgstr "  Alice's response was slow and measured."

#. Occurrence 8_6:1360:11275: scene=8_6
#: 8_6:1360
msgctxt "text_id=11275 | speaker=unknown"
msgid "　それに、草十郎はまた困ったように顔をしかめた。"
msgstr "  Soujyuro still looked troubled."

#. Occurrence 8_6:1395:11276: scene=8_6
#: 8_6:1395
msgctxt "text_id=11276 | speaker=unknown"
msgid "　彼は会話の内容にではなく、有珠に対してすまなそうに顔を曇らせている。"
msgstr "  But not at the conversation they were having. Rather, he looked apologetic towards Alice."

#. Occurrence 8_6:1400:11277: scene=8_6
#: 8_6:1400
msgctxt "text_id=11277 | speaker=unknown"
msgid "　言いたくなければ、答えなくてよかったのに、と。"
msgstr "  He'd said she didn't have to answer if she didn't want to."

#. Occurrence 8_6:1405:11278: scene=8_6
#: 8_6:1405
msgctxt "text_id=11278 | speaker=unknown"
msgid "　そんな草十郎の顔に動じず、有珠は淡々と続けていく。"
msgstr "  But Alice kept talking despite the face he was making."

#. Occurrence 8_6:1426:11279: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0010; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1426
msgctxt "text_id=11279 | speaker=alice"
msgid "「静希君が見た公園での出来事が、青子にとって初めての殺人行為よ。あいにく相手は人形だったけど」"
msgstr "\"That day you saw us in the park was the first time Aoko had ever killed anything. That was just a puppet, though.\""

#. Occurrence 8_6:1454:11280: scene=8_6
#: 8_6:1454
msgctxt "text_id=11280 | speaker=unknown"
msgid "　静かに頷く草十郎。"
msgstr "  Soujyuro silently nodded."

#. Occurrence 8_6:1459:11281: scene=8_6
#: 8_6:1459
msgctxt "text_id=11281 | speaker=unknown"
msgid "　その仕草に、有珠は不審そうに目を細めた。"
msgstr "  Alice narrowed her eyes at him suspiciously."

#. Occurrence 8_6:1496:11282: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0011; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1496
msgctxt "text_id=11282 | speaker=alice"
msgid "「まるで、はじめから分かっていた素振りね」"
msgstr "\"It almost seems like you knew all of this from the beginning.\""

#. Occurrence 8_6:1515:11283: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0004; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:1515
msgctxt "text_id=11283 | speaker=soujuurou"
msgid "「そうじゃな……いや、そうなのかな。"
msgstr "\"No, not... well, maybe?"

#. Occurrence 8_6:1521:11284: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0005; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:1521
msgctxt "text_id=11284 | speaker=soujuurou"
msgid "　たまにその手の台詞を言うけど、何か違う気がしたんだ。……だからたぶん、蒼崎はまだ人殺しというのを体験していないんじゃないかって。"
msgstr "  She just says stuff like that sometimes, but it's never felt like she's ever actually killed anyone before."

#. Occurrence 8_6:1527:11285: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0006; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:1527
msgctxt "text_id=11285 | speaker=soujuurou"
msgid "　でもまあ、そんな事よりもっと確かなのは」"
msgstr "  But more than that, I guess the best evidence is...\""

#. Occurrence 8_6:1552:11286: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0012; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1552
msgctxt "text_id=11286 | speaker=alice"
msgid "「静希君が、いま生きているという事ね」"
msgstr "\"The fact that you're still alive?\""

#. Occurrence 8_6:1571:11287: scene=8_6
#: 8_6:1571
msgctxt "text_id=11287 | speaker=unknown"
msgid "　ご名答、とばかりに草十郎は苦笑した。"
msgstr "  Soujyuro chuckled at Alice's stellar response."

#. Occurrence 8_6:1621:11288: scene=8_6
#: 8_6:1621
msgctxt "text_id=11288 | speaker=unknown"
msgid "　……そう。"
msgstr "  Exactly."

#. Occurrence 8_6:1626:11289: scene=8_6
#: 8_6:1626
msgctxt "text_id=11289 | speaker=unknown"
msgid "　あの夜、もし彼女がそういった<手応|てごた>えを知っていたのなら、あんな回りくどい事にはならなかった。"
msgstr "  Things would have been more clear-cut that night if Aoko had actually killed someone before."

#. Occurrence 8_6:1631:11290: scene=8_6
#: 8_6:1631
msgctxt "text_id=11290 | speaker=unknown"
msgid "　草十郎は青子の顔を見る事なく殺されていただろう。"
msgstr "  Soujyuro would have been dead before he ever even saw her face."

#. Occurrence 8_6:1636:11291: scene=8_6
#: 8_6:1636
msgctxt "text_id=11291 | speaker=unknown"
msgid "　幸か不幸か、あれだけの非情さと行動力を持っていながら、蒼崎青子はいまだ<そ|・><の|・><感|・><覚|・>を知らないのだ。"
msgstr "  For better or for worse, Aoko remained inexperienced in spite of her ruthlessness and decisiveness."

#. Occurrence 8_6:1669:11292: scene=8_6
#: 8_6:1669
msgctxt "text_id=11292 | speaker=unknown"
msgid "　ホッと肩を下ろす草十郎。"
msgstr "  Soujyuro relaxed his shoulders."

#. Occurrence 8_6:1674:11293: scene=8_6
#: 8_6:1674
msgctxt "text_id=11293 | speaker=unknown"
msgid "　今まで苦々しかった表情も、いつも通りのぼんやりとしたものに戻る。"
msgstr "  His stern face gradually returned to its normal carefree state."

#. Occurrence 8_6:1679:11294: scene=8_6
#: 8_6:1679
msgctxt "text_id=11294 | speaker=unknown"
msgid "　そこへ、"
msgstr "  Then..."

#. Occurrence 8_6:1721:11295: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0013; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1721
msgctxt "text_id=11295 | speaker=alice"
msgid "「―――でも、そんな事は関係ないわ。"
msgstr "\"...But even so, none of that really matters."

#. Occurrence 8_6:1727:11296: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0014; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1727
msgctxt "text_id=11296 | speaker=alice"
msgid "　あの子はそのあたりが異常だから。行為は理性に、経験は知識でたやすく補ってしまう。"
msgstr "  That's just the way she is. She acts with reason and uses her knowledge to make up for any inexperience she might have."

#. Occurrence 8_6:1753:11297: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0015; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:1753
msgctxt "text_id=11297 | speaker=alice"
msgid "　……そうね。青子はその気になれば、迷う事なく<他人|ひと>の命に手をだせる。静希君ふうに言うのなら、だけど」"
msgstr "  Sizuki, I think if she really felt like it, she could take another person's life, as you put it.\""

#. Occurrence 8_6:1773:11298: scene=8_6
#: 8_6:1773
msgctxt "text_id=11298 | speaker=unknown"
msgid "　それだけ言って、有珠はまたフォークで麺をコネコネする。"
msgstr "  And with that, Alice went back to twirling noodles around her fork."

#. Occurrence 8_6:1791:11299: scene=8_6
#: 8_6:1791
msgctxt "text_id=11299 | speaker=unknown"
msgid "　……もしかして楽しくてやっているのだろうか、などと思いながら、草十郎は有珠の言葉を<反芻|はんすう>していた。"
msgstr "  She looks like she's having fun, Soujyuro thought as he ruminated over what she'd just said."

#. Occurrence 8_6:1816:11300: scene=8_6
#: 8_6:1816
msgctxt "text_id=11300 | speaker=unknown"
msgid "　道徳を犯す自分を容認できる理性と、"
msgstr "  She was rational enough to accept herself despite acting against society's morals,"

#. Occurrence 8_6:1821:11301: scene=8_6
#: 8_6:1821
msgctxt "text_id=11301 | speaker=unknown"
msgid "　実経験から得られる確信を超える知性。"
msgstr "  and possessed of an intellect that exceeded even the confidence gained through experience."

#. Occurrence 8_6:1826:11302: scene=8_6
#: 8_6:1826
msgctxt "text_id=11302 | speaker=unknown"
msgid "　そんな理屈だけの絵空事を実現できるように、青子は育てられてきたのだろうか。"
msgstr "  Had Aoko been raised to utilize her logic and reason to forge reality from fiction?"

#. Occurrence 8_6:1843:11303: scene=8_6
#: 8_6:1843
msgctxt "text_id=11303 | speaker=unknown"
msgid "　それなら、確かに―――彼女たちが自分と違うのは、納得のいく事ではあるが。"
msgstr "  If that was the case, then perhaps they really were different from Soujyuro."

#. Occurrence 8_6:1864:11304: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0007; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:1864
msgctxt "text_id=11304 | speaker=soujuurou"
msgid "「……すまない。こんなことを訊いたのは、蒼崎には内緒にしておいてくれないか？」"
msgstr "\"...I'm sorry. Can you please not tell Aozaki that I asked you this?\""

#. Occurrence 8_6:1882:11305: scene=8_6
#: 8_6:1882
msgctxt "text_id=11305 | speaker=unknown"
msgid "　反省するような、思い詰めた顔。"
msgstr "  Soujyuro seemed serious, as if he really regretted asking."

#. Occurrence 8_6:1903:11306: scene=8_6
#: 8_6:1903
msgctxt "text_id=11306 | speaker=unknown"
msgid "　有珠の表情に変化はないが、彼女も初めからそのつもりだったようだ。"
msgstr "  Alice's expression remained unchanged, but she had never intended on saying anything to Aoko anyway."

#. Occurrence 8_6:1937:11307: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0008; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:1937
msgctxt "text_id=11307 | speaker=soujuurou"
msgid "「ありがとう。なんだか、有珠には内緒話ばかりたまっていくね」"
msgstr "\"Thank you. I'm not sure why, but I seem to have a lot of secret conversations with you.\""

#. Occurrence 8_6:1974:11308: scene=8_6
#: 8_6:1974
msgctxt "text_id=11308 | speaker=unknown"
msgid "　草十郎は食事を再開する。"
msgstr "  Soujyuro went back to eating his food."

#. Occurrence 8_6:1992:11309: scene=8_6
#: 8_6:1992
msgctxt "text_id=11309 | speaker=unknown"
msgid "　まだ有珠は一口しか食べていないのに、彼はそれでたいらげてしまっていた。"
msgstr "  Though Alice had still only had a single bite, he was already scraping his clean."

#. Occurrence 8_6:2013:11310: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0009; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2013
msgctxt "text_id=11310 | speaker=soujuurou"
msgid "「そういえば蒼崎にも訊いたんだけど、有珠と蒼崎はいつもああなのか？」"
msgstr "\"I already asked Aozaki this, but do the two of you always get along like that?\""

#. Occurrence 8_6:2038:11311: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0016; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2038
msgctxt "text_id=11311 | speaker=alice"
msgid "「――――――」"
msgstr "\"...\""

#. Occurrence 8_6:2043:11312: scene=8_6
#: 8_6:2043
msgctxt "text_id=11312 | speaker=unknown"
msgid "　先ほどまでの会話など何処へやら、草十郎はまったく違う話をはじめた。"
msgstr "  Soujyuro had suddenly decided to change the topic of conversation."

#. Occurrence 8_6:2048:11313: scene=8_6
#: 8_6:2048
msgctxt "text_id=11313 | speaker=unknown"
msgid "　どこかドライな青子と有珠の関係。"
msgstr "  His new topic was the rather cold and dry relationship between Aoko and Alice."

#. Occurrence 8_6:2053:11314: scene=8_6
#: 8_6:2053
msgctxt "text_id=11314 | speaker=unknown"
msgid "　青子はそれが普通だと語っていたが、有珠からならまた別の見解があるかもしれない。"
msgstr "  Aoko said their relationship was normal, but maybe Alice had a different opinion."

#. Occurrence 8_6:2081:11315: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0017; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2081
msgctxt "text_id=11315 | speaker=alice"
msgid "「……会話が少ない事を言っているのなら、そうなるわ。"
msgstr "\"...If you're talking about how we rarely talk to each other, that's just what happens."

#. Occurrence 8_6:2087:11316: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0018; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2087
msgctxt "text_id=11316 | speaker=alice"
msgid "　けど、別に不便じゃないから」"
msgstr "  It's convenient. It isn't something that bothers us.\""

#. Occurrence 8_6:2093:11317: scene=8_6
#: 8_6:2093
msgctxt "text_id=11317 | speaker=unknown"
msgid "　簡潔に答えて、有珠はフォークで麺をくるくると巻いている。"
msgstr "  Alice was still twirling noodles with her fork as she gave her concise answer."

#. Occurrence 8_6:2098:11318: scene=8_6
#: 8_6:2098
msgctxt "text_id=11318 | speaker=unknown"
msgid "　巻いてはいるけど、食べるそぶりはまったくなかった。"
msgstr "  Around and around the noodles went, but none made it into her mouth."

#. Occurrence 8_6:2139:11319: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0010; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2139
msgctxt "text_id=11319 | speaker=soujuurou"
msgid "「不便じゃないって……そういうの、仲がいいって言わないんじゃないか？」"
msgstr "\"What do you mean, 'It's convenient'? Do you mean that you're friends?\""

#. Occurrence 8_6:2145:11320: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0019; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2145
msgctxt "text_id=11320 | speaker=alice"
msgid "「……？　わたしと青子の仲が良くないと、静希君は困るの？」"
msgstr "\"...Would it make things difficult for you if we didn't get along?\""

#. Occurrence 8_6:2183:11321: scene=8_6
#: 8_6:2183
msgctxt "text_id=11321 | speaker=unknown"
msgid "　不思議そうに言う有珠に、草十郎は言葉を呑んでしまった。"
msgstr "  Soujyuro swallowed his words at Alice's perplexed reply."

#. Occurrence 8_6:2188:11322: scene=8_6
#: 8_6:2188
msgctxt "text_id=11322 | speaker=unknown"
msgid "　実はかなり困るのだけど、そんな風に素直に聞かれると答えにも困る。"
msgstr "  It would, actually, but he wasn't sure how to respond when asked so directly."

#. Occurrence 8_6:2222:11323: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0011; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2222
msgctxt "text_id=11323 | speaker=soujuurou"
msgid "「……いや、なんかこっちの考え方が悪かったみたいだ。"
msgstr "\"...No, maybe I was just thinking about it the wrong way."

#. Occurrence 8_6:2222:11324: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0011; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2222
msgctxt "text_id=11324 | speaker=soujuurou"
msgid "　もうその話題には触れない事にしたから忘れてくれ。"
msgstr "  I promise I won't bring it up again, so just forget I asked."

#. Occurrence 8_6:2233:11325: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0012; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2233
msgctxt "text_id=11325 | speaker=soujuurou"
msgid "　それより、有珠」"
msgstr "  More importantly, Alice...\""

#. Occurrence 8_6:2253:11326: scene=8_6
#: 8_6:2253
msgctxt "text_id=11326 | speaker=unknown"
msgid "　今までのどんな時よりも真剣な、<射|い><貫|ぬ>くような視線で草十郎は有珠を見る。"
msgstr "  Soujyuro gave Alice a piercing stare that was more intense than any time they'd talked before."

#. Occurrence 8_6:2279:11327: scene=8_6
#: 8_6:2279
msgctxt "text_id=11327 | speaker=unknown"
msgid "　彼には似合わない、強い視線を前にして有珠は少し体を引いてしまう。"
msgstr "  Alice was taken slightly aback at the unusually intense look in his eyes."

#. Occurrence 8_6:2345:11328: scene=8_6
#: 8_6:2345
msgctxt "text_id=11328 | speaker=unknown"
msgid "　かすかな緊張が有珠の頬を紅潮させる。"
msgstr "  Her face became slightly flushed out of nervousness."

#. Occurrence 8_6:2350:11329: scene=8_6
#: 8_6:2350
msgctxt "text_id=11329 | speaker=unknown"
msgid "　他人にここまで強く見つめられる事なんて、青子以外なかったからだ。"
msgstr "  Nobody besides Aoko had ever stared at her like this before."

#. Occurrence 8_6:2393:11330: scene=8_6
#: 8_6:2393
msgctxt "text_id=11330 | speaker=unknown"
msgid "　有珠の緊張を知ってか知らずか、草十郎はしばらく黙ってから、ゆっくりと、偽りのない気持ちを口にした。"
msgstr "  Whether or not he noticed, Soujyuro waited a few moments before speaking slowly and with complete conviction."

#. Occurrence 8_6:2417:11331: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0013; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2417
msgctxt "text_id=11331 | speaker=soujuurou"
msgid "「それ、食べないなら欲しいんだけど」"
msgstr "\"If you're not going to eat that, do you mind if I have it?\""

#. Occurrence 8_6:2527:11332: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0020; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2527
msgctxt "text_id=11332 | speaker=alice"
msgid "「……………………」"
msgstr "\"...\""

#. Occurrence 8_6:2532:11333: scene=8_6
#: 8_6:2532
msgctxt "text_id=11333 | speaker=unknown"
msgid "　どこか気まずい沈黙が流れる。"
msgstr "  An awkward silence followed."

#. Occurrence 8_6:2558:11334: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0021; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2558
msgctxt "text_id=11334 | speaker=alice"
msgid "「悪いけど。これ、わたしのだから」"
msgstr "\"Sorry, this is mine.\""

#. Occurrence 8_6:2564:11335: scene=8_6
#: 8_6:2564
msgctxt "text_id=11335 | speaker=unknown"
msgid "　作ったのは静希君だけど、とにかくそういうコトだから、と有珠は切り捨てる。"
msgstr "  Sizuki had cooked it, sure, but Alice wasn't wrong. He had made it for her after all."

#. Occurrence 8_6:2569:11336: scene=8_6
#: 8_6:2569
msgctxt "text_id=11336 | speaker=unknown"
msgid "　多少、自分でもよく分からない怒気をこめて。"
msgstr "  There was a slight tinge of anger in her voice, but even she wasn't sure why it was there."

#. Occurrence 8_6:2605:11337: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0014; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2605
msgctxt "text_id=11337 | speaker=soujuurou"
msgid "「そうだね。少し意地汚かった」"
msgstr "\"You're right. Sorry, I shouldn't have asked.\""

#. Occurrence 8_6:2612:11338: scene=8_6
#: 8_6:2612
msgctxt "text_id=11338 | speaker=unknown"
msgid "　すとん、とソファーに戻る草十郎。"
msgstr "  Soujyuro plopped himself down on the sofa."

#. Occurrence 8_6:2617:11339: scene=8_6
#: 8_6:2617
msgctxt "text_id=11339 | speaker=unknown"
msgid "　その仕草があまりにも哀れだったからか。"
msgstr "  This must have looked particularly pathetic to Alice since she responded with,"

#. Occurrence 8_6:2624:11340: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0022; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2624
msgctxt "text_id=11340 | speaker=alice"
msgid "「……その、材料はもう残ってないの？」"
msgstr "\"Umm, are there any ingredients left to cook some more?\""

#. Occurrence 8_6:2648:11341: scene=8_6
#: 8_6:2648
msgctxt "text_id=11341 | speaker=unknown"
msgid "　つい口にして、あわてて有珠は口を<塞|ふさ>いだ。"
msgstr "  She quickly covered her mouth. Apparently she had surprised even herself."

#. Occurrence 8_6:2653:11342: scene=8_6
#: 8_6:2653
msgctxt "text_id=11342 | speaker=unknown"
msgid "　そんな事を訊くなんて、まったく彼女らしくない。"
msgstr "  It was quite unusual for her to ask something like that."

#. Occurrence 8_6:2674:11343: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0015; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2674
msgctxt "text_id=11343 | speaker=soujuurou"
msgid "「残ってないよ。蒼崎の分も作っちゃったから」"
msgstr "\"Nope. I used everything and made some for Aozaki as well.\""

#. Occurrence 8_6:2680:11344: scene=8_6
#: 8_6:2680
msgctxt "text_id=11344 | speaker=unknown"
msgid "　まだ未練があるのか、有珠のお皿を見ながら草十郎は答える。"
msgstr "  Soujyuro stared a bit regretfully at Alice's plate as he responded."

#. Occurrence 8_6:2685:11345: scene=8_6
#: 8_6:2685
msgctxt "text_id=11345 | speaker=unknown"
msgid "　その言葉も有珠的に無視できなかったのか、よせばいいのに、彼女は再度声をかけてしまった。"
msgstr "  Alice could have just let it go, but for some reason she felt the need to speak up again."

#. Occurrence 8_6:2711:11346: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0023; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2711
msgctxt "text_id=11346 | speaker=alice"
msgid "「……青子なら、眠っているけど」"
msgstr "\"...But Aoko is still sleeping.\""

#. Occurrence 8_6:2733:11347: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0016; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2733
msgctxt "text_id=11347 | speaker=soujuurou"
msgid "「いや、もうすぐ起こすから。起きた後で作らされるより、一緒に作っておいた方が楽だしね。"
msgstr "\"Yeah, but I'm gonna wake her up soon, and she'd have told me to make her something anyway."

#. Occurrence 8_6:2744:11348: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0017; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2744
msgctxt "text_id=11348 | speaker=soujuurou"
msgid "　……と、もうすぐ一時か。ちょうどいい、行って起こしてくるよ」"
msgstr "  ...Speaking of which, it's almost one o'clock. I'll go and wake her up now.\""

#. Occurrence 8_6:2797:11349: speaker=alice; speaker_ja=有珠; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A40_8_6_0024; voice_prefix=A40; voice_category=2; scene=8_6
#: 8_6:2797
msgctxt "text_id=11349 | speaker=alice"
msgid "「青子は、起こしたら殺すって言ってたけど」"
msgstr "\"Didn't she say she'd kill you if you woke her up?\""

#. Occurrence 8_6:2802:11350: scene=8_6
#: 8_6:2802
msgctxt "text_id=11350 | speaker=unknown"
msgid "　なんでそんな事をするのか疑問、と有珠は首を傾げる。"
msgstr "  Alice wasn't sure why Soujyuro was willing to take such a risk."

#. Occurrence 8_6:2807:11351: scene=8_6
#: 8_6:2807
msgctxt "text_id=11351 | speaker=unknown"
msgid "　まったくだ、と同意しながらも草十郎は歩きだす。"
msgstr "  Soujyuro agreed, but started walking anyway."

#. Occurrence 8_6:2847:11352: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_6_0018; voice_prefix=A30; voice_category=3; scene=8_6
#: 8_6:2847
msgctxt "text_id=11352 | speaker=soujuurou"
msgid "「でもさ。いま起こしておかないと、やっぱり後で殺される運命にあると思うんだ」"
msgstr "\"Maybe so, but I feel like if I don't wake her up now, she's going to end up killing me later anyway.\""

#. Occurrence 8_6:2853:11353: scene=8_6
#: 8_6:2853
msgctxt "text_id=11353 | speaker=unknown"
msgid "　悪態なのに、親愛に満ちた言葉。"
msgstr "  His words were surprisingly affectionate."

#. Occurrence 8_6:2863:11354: scene=8_6
#: 8_6:2863
msgctxt "text_id=11354 | speaker=unknown"
msgid "　同情に値する言葉を残して、草十郎は青子の部屋へと向かっていった。"
msgstr "  Leaving Alice with only that, Soujyuro headed to Aoko's room."

#. Occurrence 8_6:2905:11355: scene=8_6
#: 8_6:2905
msgctxt "text_id=11355 | speaker=unknown"
msgid "　それを無言で見送ってから、有珠はあんかけ焼きうどんを一口食べてみる。"
msgstr "  Alice watched him leave in silence before taking another bite of the stir-fried noodles."

#. Occurrence 8_6:2924:11356: scene=8_6
#: 8_6:2924
msgctxt "text_id=11356 | speaker=unknown"
msgid "　ちらりと廊下への扉に目をやって、誰も来そうにない事を確認すると、さらに一口。"
msgstr "  Glancing at the door to the hallway to make sure nobody was coming, she took another bite."

#. Occurrence 8_6:2942:11357: scene=8_6
#: 8_6:2942
msgctxt "text_id=11357 | speaker=unknown"
msgid "　そんな事を何回も繰り返すうちにクリーム色のお皿は空になって、二階から青子の怒鳴り声が聞こえた気がした。"
msgstr "  She repeated that process many times before finishing her food. It was then that she heard Aoko's wrath coming from the second floor."

#. Occurrence 8_6:2962:11358: scene=8_6
#: 8_6:2962
msgctxt "text_id=11358 | speaker=unknown"
msgid "　それに少しだけ同情して、厳かな仕草で、有珠は自分と草十郎の食器を片付けはじめた。"
msgstr "  Alice stood up and began solemnly clearing the table, feeling a bit sorry for what Soujyuro was dealing with."

#. Occurrence 8_6:2978:11359: scene=8_6
#: 8_6:2978
msgctxt "text_id=11359 | speaker=unknown"
msgid "　そんな気はなかったけれど、これぐらいはしてあげないといけない、と思ったらしい。"
msgstr "  She knew she didn't really have to, but she felt like it was the least she could do for him."

#. Occurrence 8_6:2999:11360: scene=8_6
#: 8_6:2999
msgctxt "text_id=11360 | speaker=unknown"
msgid "　……不覚にも。"
msgstr "  ...She'd never really expected to feel this way."

#. Occurrence 8_6:3013:11361: scene=8_6
#: 8_6:3013
msgctxt "text_id=11361 | speaker=unknown"
msgid "　はじめて食べた彼の手料理は、紅茶の不出来な淹れ方を忘れさせるほどには、まあ、悪くはない味だったのだから。"
msgstr "  But he'd cooked for her, and it was surprisingly good. Almost enough to make her forget how bad he was at making tea."

#. Occurrence 8_EX:80:11362: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0000; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:80
msgctxt "text_id=11362 | speaker=kojika"
msgid "「失礼します。２－Ｄの<久万梨|くまり>です。"
msgstr "\"Hi. Kumari from Class 2-D."

#. Occurrence 8_EX:86:11363: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0001; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:86
msgctxt "text_id=11363 | speaker=kojika"
msgid "　体育館倉庫の鍵、職員室に返してきました」"
msgstr "  I returned the key to the gym's storage to the faculty room.\""

#. Occurrence 8_EX:92:11364: scene=8_EX
#: 8_EX:92
msgctxt "text_id=11364 | speaker=unknown"
msgid "　<久万梨|くまり><金鹿|こじか>が第二生徒会室に入ると、室内にいるのは蒼崎青子だけだった。"
msgstr "  Only Aoko was present in the second student council room when Kojika Kumari entered."

#. Occurrence 8_EX:127:11365: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0000; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:127
msgctxt "text_id=11365 | speaker=aoko"
msgid "「おつかれ。"
msgstr "\"Oh, thank you."

#. Occurrence 8_EX:127:11366: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0000; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:127
msgctxt "text_id=11366 | speaker=aoko"
msgid "　もうちょっとでバイト終わるから、そこ座ってて」"
msgstr "  I'm almost done with this, so just have a seat there.\""

#. Occurrence 8_EX:133:11367: scene=8_EX
#: 8_EX:133
msgctxt "text_id=11367 | speaker=unknown"
msgid "　青子は長テーブルに陣取って、大量の教科書に囲まれながら、スラスラとリズムよくボールペンを走らせていた。"
msgstr "  Aoko was seated at a long table, surrounded by a pile of textbooks and using her pen to write rapidly."

#. Occurrence 8_EX:138:11368: scene=8_EX
#: 8_EX:138
msgctxt "text_id=11368 | speaker=unknown"
msgid "　机上にあるのは学校指定のノートではなく、こじゃれたレポート用紙である。"
msgstr "  Strewn about the table were not school-specified notebooks, but rather papers for writing reports."

#. Occurrence 8_EX:170:11369: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0002; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:170
msgctxt "text_id=11369 | speaker=kojika"
msgid "「なにしてんの蒼崎。課題？　それとも補習？"
msgstr "\"What are you working on? Homework? Review questions?"

#. Occurrence 8_EX:176:11370: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0003; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:176
msgctxt "text_id=11370 | speaker=kojika"
msgid "　どっちにしても真面目なこと。冬休み、始まったばかりなのに。そりゃあ、こんなところで特別清掃なんかに付き合わされているけどさ」"
msgstr "  Looks pretty intense, whatever it is. Winter vacation just started! I mean, we have this special winter cleaning thing to do too, I guess.\""

#. Occurrence 8_EX:195:11371: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0001; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:195
msgctxt "text_id=11371 | speaker=aoko"
msgid "「んー、これは別件。知り合いの大学生から流してもらった代筆のバイト。"
msgstr "\"Mm, this is separate from all that. A university student I know gave me some work as a ghostwriter."

#. Occurrence 8_EX:202:11372: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0002; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:202
msgctxt "text_id=11372 | speaker=aoko"
msgid "何年も前に提出されたレポートを丸写しにして、卒論クリアしようって話」"
msgstr "They want me to copy this old report from a few years ago verbatim for their graduate thesis.\""

#. Occurrence 8_EX:235:11373: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0004; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:235
msgctxt "text_id=11373 | speaker=kojika"
msgid "「チッ、写本ならぬ写レポートかよ。結構な量だなオイ。"
msgstr "\"Tch, they've got you copying a whole book, it looks like!"

#. Occurrence 8_EX:241:11374: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0005; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:241
msgctxt "text_id=11374 | speaker=kojika"
msgid "　それ、どこの大学生？　まさか<渠裸|みぞら>大じゃないでしょうね」"
msgstr "  What university do they go to? Not Mizora, is it?\""

#. Occurrence 8_EX:262:11375: scene=8_EX
#: 8_EX:262
msgctxt "text_id=11375 | speaker=unknown"
msgid "　不快さを隠しもせず、久万梨は青子の傍らにあるレポートをめくっていく。"
msgstr "  Kumari couldn't seem to hide her discomfort as she started thumbing through some of the reports next to Aoko."

#. Occurrence 8_EX:267:11376: scene=8_EX
#: 8_EX:267
msgctxt "text_id=11376 | speaker=unknown"
msgid "　やや茶色に変色したレポート用紙は、少なく見積もっても十年は前の物だ。"
msgstr "  The slightly brown-tinged reports had to be at least ten years old."

#. Occurrence 8_EX:304:11377: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0003; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:304
msgctxt "text_id=11377 | speaker=aoko"
msgid "「そのまさかよ。知り合いの大学生なんてミゾラ以外にいるかっていうの。"
msgstr "\"Of course they go to Mizora. I don't know students from any other university."

#. Occurrence 8_EX:310:11378: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0004; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:310
msgctxt "text_id=11378 | speaker=aoko"
msgid "　安心なさい、クマの兄貴たちからの仕事じゃないから。そもそもアンタの兄貴軍団、今年も<留年|のこ>る気満々なんでしょ？」"
msgstr "  Don't worry, Kuma, it's not from your brother and his crew. Aren't they all planning to stay back another year again this year anyway?\""

#. Occurrence 8_EX:316:11379: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0006; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:316
msgctxt "text_id=11379 | speaker=kojika"
msgid "「クマ言わないで。軍団もやめろ」"
msgstr "\"Can you stop calling me that? And please stop referring to them as a crew?\""

#. Occurrence 8_EX:336:11380: scene=8_EX
#: 8_EX:336
msgctxt "text_id=11380 | speaker=unknown"
msgid "　久万梨の声は刺々しい。"
msgstr "  Her voice was snappy."

#. Occurrence 8_EX:341:11381: scene=8_EX
#: 8_EX:341
msgctxt "text_id=11381 | speaker=unknown"
msgid "　いつも不機嫌な青子が言える事ではないが、この女生徒も青子に負けず劣らずの愛想の無さである。"
msgstr "  Not that Aoko could judge, but this girl's unfriendliness could rival even her own at times."

#. Occurrence 8_EX:346:11382: scene=8_EX
#: 8_EX:346
msgctxt "text_id=11382 | speaker=unknown"
msgid "　平時は素っ気ない口調の久万梨は、本音がむき出しになると乱暴な口調になる。"
msgstr "  Kumari's speech was dry enough as it was, but when she got riled up about something she really let it all out."

#. Occurrence 8_EX:351:11383: scene=8_EX
#: 8_EX:351
msgctxt "text_id=11383 | speaker=unknown"
msgid "　どうも父親<譲|ゆず>りの癖らしい。本人はその癖を改善しようと努めているが、小学生までの習慣は中々抜けない。"
msgstr "  Apparently she got it from her father. She was trying to work on it, but it was hard to fix an old habit she had since elementary school."

#. Occurrence 8_EX:402:11384: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0007; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:402
msgctxt "text_id=11384 | speaker=kojika"
msgid "「けどこれ、どうなのよ。丸写しにしても古すぎて通らないんじゃない？」"
msgstr "\"Is this even going to work with a report that old, though? Don't you think they'll notice?\""

#. Occurrence 8_EX:425:11385: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0005; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:425
msgctxt "text_id=11385 | speaker=aoko"
msgid "「そこはそれ、腐っても鯛というか。"
msgstr "\"Well, it's better than nothing, isn't it?"

#. Occurrence 8_EX:431:11386: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0006; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:431
msgctxt "text_id=11386 | speaker=aoko"
msgid "“技術的に古い部分はピックアップしてあるから、<教科書|テキスト>参考にして数字だけ変えておいて”だってさ」"
msgstr "  They told me they marked all the out of date data and that I just need to change those numbers by looking at the textbooks.\""

#. Occurrence 8_EX:468:11387: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0008; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:468
msgctxt "text_id=11387 | speaker=kojika"
msgid "「なにそれ、ホントにバカじゃないの？　そこまで分かってるなら自分でやればいいのに。で、いつからやってるの」"
msgstr "\"That's dumb. If they did all that, they could just change it themselves! How long have you been working on this?\""

#. Occurrence 8_EX:492:11388: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0007; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:492
msgctxt "text_id=11388 | speaker=aoko"
msgid "「今日の朝から。半日の稼ぎにしちゃあ悪くないわよ。"
msgstr "\"Since this morning. It's really not bad money for a half day's work."

#. Occurrence 8_EX:492:11389: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0007; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:492
msgctxt "text_id=11389 | speaker=aoko"
msgid "　レポート一冊分で一万円」"
msgstr "  They're paying me 10,000 yen per report.\""

#. Occurrence 8_EX:516:11390: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0009; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:516
msgctxt "text_id=11390 | speaker=kojika"
msgid "「ケッ、生徒会長が内職かよ。"
msgstr "\"I can't believe the student council president actually has a side hustle like this."

#. Occurrence 8_EX:516:11391: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0009; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:516
msgctxt "text_id=11391 | speaker=kojika"
msgid "　どうりで槻司に監督を任せたワケだ」"
msgstr "  No wonder you left Tsukiji in charge.\""

#. Occurrence 8_EX:539:11392: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0008; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:539
msgctxt "text_id=11392 | speaker=aoko"
msgid "「はい。他言は無用でお願いします」"
msgstr "\"Right. Let's just keep this between us, shall we?\""

#. Occurrence 8_EX:574:11393: scene=8_EX
#: 8_EX:574
msgctxt "text_id=11393 | speaker=unknown"
msgid "　爽やかな笑顔で返されて毒気を抜かれたのか、久万梨はぶすっとした顔のままパイプ椅子に腰を掛けた。"
msgstr "  Kumari relaxed a bit at Aoko's pleasant response and decided to sit down in the nearest chair."

#. Occurrence 8_EX:594:11394: scene=8_EX
#: 8_EX:594
msgctxt "text_id=11394 | speaker=unknown"
msgid "　生徒会室にはボールペンの音だけ。"
msgstr "  The room was silent save for the sound of the scratching of Aoko's ballpoint pen."

#. Occurrence 8_EX:613:11395: scene=8_EX
#: 8_EX:613
msgctxt "text_id=11395 | speaker=unknown"
msgid "　ふと見上げた空は青く高く、裏庭にはジャージ姿で野球をしている男子たちの姿があった。"
msgstr "  The sky was clear blue and there were boys in the rear courtyard playing baseball in their jerseys."

#. Occurrence 8_EX:618:11396: scene=8_EX
#: 8_EX:618
msgctxt "text_id=11396 | speaker=unknown"
msgid "　特別清掃も終わり、なし崩し的に遊び始めたらしい。"
msgstr "  With the special winter cleaning finished, it seemed they'd decided to start enjoying their free time."

#. Occurrence 8_EX:624:11397: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0010; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:624
msgctxt "text_id=11397 | speaker=kojika"
msgid "「この寒いのによくもまあ。"
msgstr "\"I don't know how they can stand it out there in the cold like that."

#. Occurrence 8_EX:630:11398: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0011; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:630
msgctxt "text_id=11398 | speaker=kojika"
msgid "　―――って、アレ二年の男どもだ」"
msgstr "  ...Wait, those're the second-year boys.\""

#. Occurrence 8_EX:650:11399: scene=8_EX
#: 8_EX:650
msgctxt "text_id=11399 | speaker=unknown"
msgid "　十分な人数が集まらなかったのか、彼らは五人一チームで試合をしている。"
msgstr "  Said boys were playing in teams of five since they apparently could not get enough people together to play a proper game."

#. Occurrence 8_EX:655:11400: scene=8_EX
#: 8_EX:655
msgctxt "text_id=11400 | speaker=unknown"
msgid "　凡打、三振の多いグダグダな試合内容だが、当人たちはたいへん盛り上がっているようだ。"
msgstr "  It was a boring game of mostly strikeouts and poor hits, but they sure seemed to be having fun."

#. Occurrence 8_EX:660:11401: scene=8_EX
#: 8_EX:660
msgctxt "text_id=11401 | speaker=unknown"
msgid "　聞こえてくる喚声は口汚いものばかりだが、罵声をあびせながらもみな笑っているあたり、ホントに男子はバカばっかりだ。"
msgstr "  Their yelling and hollering mostly consisted of bad words, surprised yells, and cackling laughter."

#. Occurrence 8_EX:692:11402: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0012; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:692
msgctxt "text_id=11402 | speaker=kojika"
msgid "「あれ。<芳助|ほうすけ>と<静希|しずき>が一緒なのは分かるけど、<槻司|つきじ>も一緒じゃん。蒼崎、あいつら仲いいの？」"
msgstr "\"Oh, of course Housuke and Sizuki are together, but Tsukiji looks like he's with them too... Are they friends?\""

#. Occurrence 8_EX:710:11403: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0009; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:710
msgctxt "text_id=11403 | speaker=aoko"
msgid "「はあ？　なんで<Ｃ|よ><組|そ>のクラスの集まりに顔だしてんのよ<鳶|ア><丸|イツ>。……まあ、裏山の清掃が終わってるなら文句はないけど」"
msgstr "\"Huh? Why the heck is he hanging out with the Class C crowd? Well, as long as they're done with their cleanup, they can do whatever they want I guess.\""

#. Occurrence 8_EX:727:11404: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0013; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:727
msgctxt "text_id=11404 | speaker=kojika"
msgid "「あ、投げた。槻司、ピッチャーできるんだ」"
msgstr "\"Wow, I didn't know Tsukiji could pitch.\""

#. Occurrence 8_EX:748:11405: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0010; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:748
msgctxt "text_id=11405 | speaker=aoko"
msgid "「基本、<鳶丸|アイツ>はなんでもできるからねー。"
msgstr "\"He can kind of do it all."

#. Occurrence 8_EX:754:11406: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0011; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:754
msgctxt "text_id=11406 | speaker=aoko"
msgid "　本人さぼり症でめったに動かないけど、本気だせば何だってこなすのよ。唯一足りない才能があるとしたら、子供らしさってヤツでしょうね」"
msgstr "  He's lazy, so he never accomplishes much. He can do just about anything when he puts his mind to it, though. If there's anything he's lacking, it's the ability to just be a kid sometimes.\""

#. Occurrence 8_EX:772:11407: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0014; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:772
msgctxt "text_id=11407 | speaker=kojika"
msgid "「ふーん。詳しいじゃない。"
msgstr "\"Hmph, you seem to know a lot about him."

#. Occurrence 8_EX:778:11408: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0015; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:778
msgctxt "text_id=11408 | speaker=kojika"
msgid "　……蒼崎、槻司と付き合ってるってホント？」"
msgstr "  ...Are the two of you dating?\""

#. Occurrence 8_EX:811:11409: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0012; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:811
msgctxt "text_id=11409 | speaker=aoko"
msgid "「アイツと付き合うぐらいならアンタと付き合うわ。"
msgstr "\"Seriously? I'd date you before I dated him. Give me a break."

#. Occurrence 8_EX:817:11410: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0013; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:817
msgctxt "text_id=11410 | speaker=aoko"
msgid "　顔の良い男は好きじゃないし。やっぱり男はシュワちゃんぐらいじゃないと」"
msgstr "  I'm not into the pretty boys. I need a macho man. Like that Austrian.\""

#. Occurrence 8_EX:839:11411: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0016; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:839
msgctxt "text_id=11411 | speaker=kojika"
msgid "「シュワ……誰それ？」"
msgstr "\"What Austrian?\""

#. Occurrence 8_EX:845:11412: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0014; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:845
msgctxt "text_id=11412 | speaker=aoko"
msgid "「グレートの方のコナンの主役やった人」"
msgstr "\"You know, the guy that starred in those barbarian movies!\""

#. Occurrence 8_EX:856:11413: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0017; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:856
msgctxt "text_id=11413 | speaker=kojika"
msgid "「へえ、アゴ割れてないとダメなんだ。蒼崎って面食いかと思ってたけど、ごっつい系が趣味なの？」"
msgstr "\"Ohhh, so you like a chiseled jawline? I didn't know you were into the musclehead types!\""

#. Occurrence 8_EX:877:11414: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0015; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:877
msgctxt "text_id=11414 | speaker=aoko"
msgid "「……別にそういうワケじゃないけど。"
msgstr "\"I mean, not exclusively..."

#. Occurrence 8_EX:883:11415: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0016; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:883
msgctxt "text_id=11415 | speaker=aoko"
msgid "　教訓よ、教訓。なよっとしたヤツとか、やけに口がうまいヤツとか、気軽な男はほんと信用ならないっていうか」"
msgstr "  I'm trying to say that you can't trust smooth-talking, carefree guys just because they happen to look attractive.\""

#. Occurrence 8_EX:920:11416: scene=8_EX
#: 8_EX:920
msgctxt "text_id=11416 | speaker=unknown"
msgid "　青子はレポート用紙を、"
msgstr "  They continued their conversation..."

#. Occurrence 8_EX:926:11417: scene=8_EX
#: 8_EX:926
msgctxt "text_id=11417 | speaker=unknown"
msgid "　久万梨は校庭を眺めながら、とりとめのない会話をする。"
msgstr "  ...one staring at the report pages and the other gazing out at the schoolyard."

#. Occurrence 8_EX:931:11418: scene=8_EX
#: 8_EX:931
msgctxt "text_id=11418 | speaker=unknown"
msgid "　ふたりが知り合ったのは高校生になってからだが、根本的なところで気が合うらしく、今ではこうして<駄弁|だべ>りあう仲になっていた。"
msgstr "  They had met in high school and soon grew to be friends who enjoyed chatting together."

#. Occurrence 8_EX:952:11419: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0018; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:952
msgctxt "text_id=11419 | speaker=kojika"
msgid "「蒼崎、冬休みはどうする？　予定、ある？」"
msgstr "\"So what are your plans over the winter vacation? Wanna do something?\""

#. Occurrence 8_EX:958:11420: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0017; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:958
msgctxt "text_id=11420 | speaker=aoko"
msgid "「うーん、一回ぐらいは遊びに行きたいんだけど、ちょい忙しくて。年明けに時間つくるから、それまで待って。"
msgstr "\"Hmm... I want to, but I'm going to be so busy. How about around the start of the new year?"

#. Occurrence 8_EX:964:11421: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0018; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:964
msgctxt "text_id=11421 | speaker=aoko"
msgid "　あ、Ｂ組の山瀬さんたち誘う？　たしか去年も冬休みに上京してたでしょ、彼女ら」"
msgstr "  Should we invite Yamase and those other girls from Class B? I think they went up to Tokyo last winter vacation.\""

#. Occurrence 8_EX:985:11422: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0019; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:985
msgctxt "text_id=11422 | speaker=kojika"
msgid "「あー、ありゃわたしたちと系統が違う。生粋のお嬢さまだからねぇ。蒼崎の趣味知ったらドン引きされるから、やめといた方がいい」"
msgstr "\"They aren't really our style, are they? They'd freak if they found out what kind of stuff you're into! I wouldn't bother with them.\""

#. Occurrence 8_EX:1013:11423: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0020; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1013
msgctxt "text_id=11423 | speaker=kojika"
msgid "「あ、打たれた。"
msgstr "\"Uh oh, Tsukiji allowed a hit."

#. Occurrence 8_EX:1020:11424: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0021; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1020
msgctxt "text_id=11424 | speaker=kojika"
msgid "あ、<柵|さく>越えた。"
msgstr "Wow, it went over the fence."

#. Occurrence 8_EX:1027:11425: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0022; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1027
msgctxt "text_id=11425 | speaker=kojika"
msgid "あれってホームランってヤツだ。やるじゃん静希。槻司から一本とるなんて、運動神経<抜群|ばつぐん>ね」"
msgstr "Nice home run, Sizuki. He's more athletic than I thought if he managed to hit a home run off of Tsukiji like that.\""

#. Occurrence 8_EX:1048:11426: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0019; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1048
msgctxt "text_id=11426 | speaker=aoko"
msgid "「そりゃ山育ちだし、それぐらい取り柄がないと。"
msgstr "\"He grew up in the mountains. He's gotta be at least a little strong."

#. Occurrence 8_EX:1054:11427: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0020; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1054
msgctxt "text_id=11427 | speaker=aoko"
msgid "　来年の身体測定、鳶丸とトップ争うんじゃない？　山じゃ二時間歩きっぱなしとかザラだったそうだし。水泳部じゃなく陸上部に紹介すればよかった」"
msgstr "  He might beat Tobimaru for the top spot in next year's fitness check. It's a piece of cake for someone out in the mountains to walk for two hours straight. He should've been on the track team instead of swimming.\""

#. Occurrence 8_EX:1060:11428: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0023; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1060
msgctxt "text_id=11428 | speaker=kojika"
msgid "「ふーん。詳しいのね。もしかして付き合ってるのあっちとか。あ、いや、さすがにないかー」"
msgstr "\"Wow, you know a lot about him too. Maybe *he's* the one you're dating? ...Nah, can't be.\""

#. Occurrence 8_EX:1091:11429: scene=8_EX
#: 8_EX:1091
msgctxt "text_id=11429 | speaker=unknown"
msgid "　よどみのなかったボールペンの音が止まる。"
msgstr "  The constant sound of Aoko's ballpoint pen moving across paper suddenly stopped."

#. Occurrence 8_EX:1108:11430: scene=8_EX
#: 8_EX:1108
msgctxt "text_id=11430 | speaker=unknown"
msgid "　青子はごく自然な仕草で席を立ち、"
msgstr "  She stood up naturally from her seat,"

msgctxt "text_id=11431 | speaker=unknown"
msgid "小休止といわんばかりにお茶を淹れて、"
msgstr " took a quick break to pour some fresh tea,"

msgctxt "text_id=11432 | speaker=unknown"
msgid "何事もなかったように作業に戻った。"
msgstr " and returned to her work without acknowledging what had been said."

#. Occurrence 8_EX:1144:11433: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0021; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1144
msgctxt "text_id=11433 | speaker=aoko"
msgid "「冬休みの予定だけど。久万梨、何かリクエストある？」"
msgstr "\"Is there anything in particular you want to do over the winter break?\""

#. Occurrence 8_EX:1162:11434: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0024; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1162
msgctxt "text_id=11434 | speaker=kojika"
msgid "「別に。見たい映画がたまってるだけ。<三咲|こっち>じゃ上映しない映画をハシゴしたい。蒼崎は？」"
msgstr "\"Not really. There are a lot of movies I've been wanting to see though. I'd love to run through all the ones that don't get shown here. What about you?\""

#. Occurrence 8_EX:1180:11435: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0022; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1180
msgctxt "text_id=11435 | speaker=aoko"
msgid "「私は新しい冬物とＣＤ買えればいいかな。デヴィッドボウイの。あ、その前にまずはＣＤプレーヤーか。そろそろ三万円きるはずなのよ、アレ」"
msgstr "\"I'm thinking of getting some winter clothes or a CD... I'd need a CD player first, though. Should be able to get one for under 30,000 yen soon.\""

#. Occurrence 8_EX:1215:11436: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0025; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1215
msgctxt "text_id=11436 | speaker=kojika"
msgid "「はあ。新しいもの好きよね、アンタ。ＣＤなんて高いだけで、騒がれてるのは今だけだってば。"
msgstr "\"You like all that new stuff, don't you? CDs are just an expensive fad. They won't be around for long, I think."

#. Occurrence 8_EX:1221:11437: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0026; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1221
msgctxt "text_id=11437 | speaker=kojika"
msgid "　だいたい、音楽なんてレンタルしてカセットテープに落とせば５００円で済むじゃない。ベータデッキみたいにそのうち<廃|すた>れるって」"
msgstr "  You can just rent whatever music you want and record it onto a tape for 500 yen! CDs are going the way of Betamax, you'll see.\""

#. Occurrence 8_EX:1242:11438: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0023; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1242
msgctxt "text_id=11438 | speaker=aoko"
msgid "「そう？　私、ＣＤは定番になると思うけどな。過去になるのはカセットテープの方よ、きっと」"
msgstr "\"Really? I think CDs are going to be the new standard. If anything's going the way of Betamax, it's cassette tapes.\""

#. Occurrence 8_EX:1248:11439: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0027; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1248
msgctxt "text_id=11439 | speaker=kojika"
msgid "「それはない。絶対ない。賭けてもいい。だって、ＣＤって録音できないんでしょ？　そんなのにカセットテープが負けるはずない」"
msgstr "\"No way! I'd bet anything on it! How could CDs ever be better than cassettes when you can't even record to them!\""

#. Occurrence 8_EX:1278:11440: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0024; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1278
msgctxt "text_id=11440 | speaker=aoko"
msgid "「クマは保守派だからなー。政権交代は何にだってあるでしょうに。"
msgstr "\"You're so conservative, Kuma. Watch out for when that party change happens, 'cause it always does."

#. Occurrence 8_EX:1285:11441: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0025; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1285
msgctxt "text_id=11441 | speaker=aoko"
msgid "でもまあ、その賭け乗った。生徒会の歴史に書いておくからね。十年……いえ、五年後を楽しみにしていましょう」"
msgstr "But hey, I'll take that bet. I'm going to put it down here in the student council minutes. I look forward to winning ten...no, not even... five years from now!\""

#. Occurrence 8_EX:1291:11442: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0028; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1291
msgctxt "text_id=11442 | speaker=kojika"
msgid "「五年後か。いいね、ちょうど大学の終わりだ。蒼崎、東京の大学に行くんでしょ？　どこ志望してるのか教えてよ」"
msgstr "\"Five years, huh? Sounds good. We should be finishing up college around then. You're planning on going to college in Tokyo, right? Where are you thinking exactly?\""

#. Occurrence 8_EX:1312:11443: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0026; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1312
msgctxt "text_id=11443 | speaker=aoko"
msgid "「実はまだ決めてないのよ。上京したいのは山々なんだけど」"
msgstr "\"I haven't decided yet. I just know I definitely want to be in Tokyo.\""

#. Occurrence 8_EX:1318:11444: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0029; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1318
msgctxt "text_id=11444 | speaker=kojika"
msgid "「ありゃ意外。アンタのことだから、むこう三年分ぐらいスケジュール組んでると思ったのに」"
msgstr "\"I'm surprised! I thought you'd have the next three years of your life completely planned by now.\""

#. Occurrence 8_EX:1350:11445: scene=8_EX
#: 8_EX:1350
msgctxt "text_id=11445 | speaker=unknown"
msgid "　あはは、と青子は苦笑いで誤魔化す。"
msgstr "  Aoko laughed dryly at the obvious jab."

#. Occurrence 8_EX:1355:11446: scene=8_EX
#: 8_EX:1355
msgctxt "text_id=11446 | speaker=unknown"
msgid "　生き方の方針は決まっているものの、将来の展望はいまいち考えていない青子だった。"
msgstr "  Aoko knew what direction she wanted her life to go in, but she didn't usually think too much about the details."

#. Occurrence 8_EX:1360:11447: scene=8_EX
#: 8_EX:1360
msgctxt "text_id=11447 | speaker=unknown"
msgid "　やると決めた事はやる性格のため、いちいちスケジュールを紙に起こす習慣がないせいもある。"
msgstr "  Once she made a decision, she followed through with it. That was why she didn't actually write out a schedule."

#. Occurrence 8_EX:1388:11448: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0027; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1388
msgctxt "text_id=11448 | speaker=aoko"
msgid "「クマ、終わったら駅前のラーメン屋付き合ってよ。"
msgstr "\"Anyway, come grab some food with me at that ramen shop in front of the station when I'm done with this."

#. Occurrence 8_EX:1388:11449: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0027; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1388
msgctxt "text_id=11449 | speaker=aoko"
msgid "　体力つかったから、なんかお腹減ってきた」"
msgstr "  I'm getting hungry from all this work.\""

#. Occurrence 8_EX:1407:11450: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0030; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1407
msgctxt "text_id=11450 | speaker=kojika"
msgid "「……そこは、頭つかったから甘いもの食べたくなった、にしといた方が女らしいと思うけどね。"
msgstr "\"I feel like most girls would want something sweet after doing all that work, but okay."

#. Occurrence 8_EX:1418:11451: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0031; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1418
msgctxt "text_id=11451 | speaker=kojika"
msgid "　いいよ。うちでいいならサービスしとくけど、よってく？」"
msgstr "  I'm interested. If you come to my place, you can eat for free though. What do you say?\""

#. Occurrence 8_EX:1436:11452: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0028; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1436
msgctxt "text_id=11452 | speaker=aoko"
msgid "「もっちろん！　持つべきものは女の友情！」"
msgstr "\"Of course! Everyone needs a good girl friend like you!\""

#. Occurrence 8_EX:1470:11453: scene=8_EX
#: 8_EX:1470
msgctxt "text_id=11453 | speaker=unknown"
msgid "　冬休みを間近に控えた生徒会室。"
msgstr "  The girls waited patiently for winter vacation to start in the student council room."

#. Occurrence 8_EX:1475:11454: scene=8_EX
#: 8_EX:1475
msgctxt "text_id=11454 | speaker=unknown"
msgid "　ふたりは他愛のない会話で放課後を消費していく。"
msgstr "  Their free time after school was spent through this kind of frivolous conversation."

#. Occurrence 8_EX:1480:11455: scene=8_EX
#: 8_EX:1480
msgctxt "text_id=11455 | speaker=unknown"
msgid "　夜は魔術師として歩く青子も、昼間はいたってノーマルな学生だ。友人と話すときは年相応の無邪気さを隠しもしない。"
msgstr "  Aoko spent her nights as a mage and her days as a normal high school student. The conversations she had with her friends were no different from any other girls her age."

#. Occurrence 8_EX:1485:11456: scene=8_EX
#: 8_EX:1485
msgctxt "text_id=11456 | speaker=unknown"
msgid "　たとえ敵との戦いが本格化していようと、二足のわらじを履くと決めた以上、どちらも楽しむのが青子である。"
msgstr "  She enjoyed both aspects of her life equally, even if one of those involved fighting against mortal enemies."

#. Occurrence 8_EX:1519:11457: speaker=kojika; speaker_ja=金鹿; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B10_8_EX_0032; voice_prefix=B10; voice_category=5; scene=8_EX
#: 8_EX:1519
msgctxt "text_id=11457 | speaker=kojika"
msgid "「ところで蒼崎。さっきの賭け金はどうする？」"
msgstr "\"So, Aozaki. How much are we going to wager on that bet earlier?\""

#. Occurrence 8_EX:1532:11458: speaker=aoko; speaker_ja=青子; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A10_8_EX_0029; voice_prefix=A10; voice_category=1; scene=8_EX
#: 8_EX:1532
msgctxt "text_id=11458 | speaker=aoko"
msgid "「そうね。私も鬼じゃないし、その時の貯金一割で手を打つわ。根こそぎ奪うのは勘弁してあげる」"
msgstr "\"I'm not completely evil, so I'll just take ten percent of whatever savings you have at the time. I don't want to clean you out, after all.\""

#. Occurrence 8_EX:1538:11459: scene=8_EX
#: 8_EX:1538
msgctxt "text_id=11459 | speaker=unknown"
msgid "　もっとも。"
msgstr "  She wasn't lying."

#. Occurrence 8_EX:1543:11460: scene=8_EX
#: 8_EX:1543
msgctxt "text_id=11460 | speaker=unknown"
msgid "　この通り、根本的な意地の悪さは変わらないのだが。"
msgstr "  But fundamentally she was still an imp at heart."

#. Occurrence 8_EX:1604:11461: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0000; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:1604
msgctxt "text_id=11461 | speaker=soujuurou"
msgid "「なんかゾワッときたな、今」"
msgstr "\"I just got a bad feeling all of a sudden.\""

#. Occurrence 8_EX:1610:11462: scene=8_EX
#: 8_EX:1610
msgctxt "text_id=11462 | speaker=unknown"
msgid "　くしゅん、と気の抜けたクシャミをして、被害者Ａはそう呟いた。"
msgstr "  Victim A whispered quietly after sneezing."

#. Occurrence 8_EX:1647:11463: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0000; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:1647
msgctxt "text_id=11463 | speaker=kinomi"
msgid "「なんだよ、風邪でもひいたかー静希？"
msgstr "\"You catch a cold or something, Sizuki?"

#. Occurrence 8_EX:1658:11464: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0001; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:1658
msgctxt "text_id=11464 | speaker=kinomi"
msgid "　よし、んじゃこんなとこで野球やっててもしょうがねえし！　町にくりだすとしましょうか！」"
msgstr "  Let's wrap up this game and head into town. Whaddya say?\""

#. Occurrence 8_EX:1693:11465: scene=8_EX
#: 8_EX:1693
msgctxt "text_id=11465 | speaker=unknown"
msgid "　五人野球、四試合目。"
msgstr "  This was their fourth game of five-man baseball."

#. Occurrence 8_EX:1698:11466: scene=8_EX
#: 8_EX:1698
msgctxt "text_id=11466 | speaker=unknown"
msgid "　内野ゴロはキャッチされた時点でアウト、ホームランには余ったお汁粉缶をプレゼント、という特殊ルールを聞きつけて野次馬が集まりだし、リーグ戦が始まってから既に一時間。"
msgstr "  They'd gained some spectators since starting an hour ago, and were playing special rules where infield grounders were called out when caught, and home runs were rewarded with leftover sweet red-bean soup cans."

#. Occurrence 8_EX:1703:11467: scene=8_EX
#: 8_EX:1703
msgctxt "text_id=11467 | speaker=unknown"
msgid "　自分たちの試合がまだ先であるコトに痺れを切らした木乃美芳助は、早くも飽きはじめていた。"
msgstr "  Housuke Kinomi had gotten bored once he realized it was still going to be a while until it was his turn to play."

#. Occurrence 8_EX:1734:11468: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0000; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:1734
msgctxt "text_id=11468 | speaker=tobimaru"
msgid "「おまえホント猿だったんだな。先立つものがねえから野球やろうぜって言いだしたのはテメエだろうが」"
msgstr "\"Seriously? You're the one who came up with the stupid idea of playing baseball in the first place!\""

#. Occurrence 8_EX:1752:11469: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0002; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:1752
msgctxt "text_id=11469 | speaker=kinomi"
msgid "「えー。それはそれ、これはこれっしょ。"
msgstr "\"That was then, this is now!"

#. Occurrence 8_EX:1758:11470: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0003; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:1758
msgctxt "text_id=11470 | speaker=kinomi"
msgid "　だってＡ組の奴らとか集まってきたしさあ、オレ、あいつら嫌いだしさあ。なんかノリが合わないっていうか」"
msgstr "  All these losers from Class A showed up, and I hate 'em. Can't get along with 'em at all.\""

#. Occurrence 8_EX:1791:11471: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0001; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:1791
msgctxt "text_id=11471 | speaker=tobimaru"
msgid "「安心しろ、<Ａ組|あっち>もテメエとは合わねえとよ。"
msgstr "\"Don't worry, I don't think they like you either."

#. Occurrence 8_EX:1797:11472: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0002; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:1797
msgctxt "text_id=11472 | speaker=tobimaru"
msgid "　いい機会じゃねえか、気にくわないんなら試合で片づけてやれよ。こっちも本気でやってやるから」"
msgstr "  But hey, this will be a good chance to show them up. I'll actually try to play for real if you will.\""

#. Occurrence 8_EX:1817:11473: scene=8_EX
#: 8_EX:1817
msgctxt "text_id=11473 | speaker=unknown"
msgid "　鳶丸は壁に向かってピッチングなどしながら木乃美をたしなめる。"
msgstr "  Tobimaru calmly punched back down at Kinomi while practicing his pitching at the wall."

#. Occurrence 8_EX:1822:11474: scene=8_EX
#: 8_EX:1822
msgctxt "text_id=11474 | speaker=unknown"
msgid "　先ほどホームランを打たれてご立腹なのか、普段より当たりがきつい。"
msgstr "  He was throwing harder than usual. Maybe he was angry because of that home run he gave up earlier."

#. Occurrence 8_EX:1827:11475: scene=8_EX
#: 8_EX:1827
msgctxt "text_id=11475 | speaker=unknown"
msgid "　ちなみに、彼もＡ組の生徒であり、集まってきたＡ組男子のキャプテンに収まっている。"
msgstr "  He was in Class A and had taken on the role of captain for the other boys from Class A who showed up to play."

#. Occurrence 8_EX:1858:11476: voice_id=D50_8_EX_0000; voice_prefix=D50; voice_category=0; scene=8_EX
#: 8_EX:1858
msgctxt "text_id=11476 | speaker=unknown"
msgid "「ちょっと待った、そりゃ誤解だぜ殿下。"
msgstr "\"Hold on. That's not entirely true."

#. Occurrence 8_EX:1864:11477: voice_id=D50_8_EX_0001; voice_prefix=D50; voice_category=0; scene=8_EX
#: 8_EX:1864
msgctxt "text_id=11477 | speaker=unknown"
msgid "　オレたち木乃美けっこう好きよ？"
msgstr "  We actually kind of like Kinomi."

#. Occurrence 8_EX:1871:11478: voice_id=D50_8_EX_0002; voice_prefix=D50; voice_category=0; scene=8_EX
#: 8_EX:1871
msgctxt "text_id=11478 | speaker=unknown"
msgid "　バカなところとか、平気で女連中の品評会ひらくところとか、合コン企画するところとか。真似できねーよ、ホント」"
msgstr "  We like how much of a spaz he is, how he'll openly rate girls on how hot they are, how he's always planning matchmaking parties... There's nobody else like him!\""

#. Occurrence 8_EX:1877:11479: scene=8_EX
#: 8_EX:1877
msgctxt "text_id=11479 | speaker=unknown"
msgid "　うんうん、と力強くうなずくＡ組男子一同。"
msgstr "  All the other boys in Class A nodded affirmatively."

#. Occurrence 8_EX:1903:11480: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0004; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:1903
msgctxt "text_id=11480 | speaker=kinomi"
msgid "「ざけんな、テメエらいつも美味しいところだけ持っていきやがって！"
msgstr "\"Really? Don't act like you're all about fun and games like that without telling the whole truth!"

#. Occurrence 8_EX:1910:11481: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0005; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:1910
msgctxt "text_id=11481 | speaker=kinomi"
msgid "“カラオケ会ひらいてよー”“女の子と遊びたいよー”、"
msgstr "'You should host a karaoke party.' 'Oh, get together some cute girls so we can all hang out together.'"

msgctxt "text_id=11482 | speaker=unknown"
msgid "　なんて甘えてきやがって、なんで気が付いたらオレ一人だけで会計してたの？　一緒にテニス部のぞきに行ったのにどうしてオレだけ悪者なの？　もしかして利用されてるだけってそろそろ気が付いていいの？」"
msgstr "  And then what happens? You all leave me to pay the bill! And when we went to go check out the girls in the tennis club, who caught all the heat for it? Me! You think I can't tell when I'm being used?\""

#. Occurrence 8_EX:1947:11483: voice_id=D60_8_EX_0000; voice_prefix=D60; voice_category=0; scene=8_EX
#: 8_EX:1947
msgctxt "text_id=11483 | speaker=unknown"
msgid "「やべ、まだ気付いてなかった！　本物だ！」"
msgstr "\"What? You only figured that out now? Haha!\""

#. Occurrence 8_EX:1953:11484: voice_id=D70_8_EX_0000; voice_prefix=D70; voice_category=0; scene=8_EX
#: 8_EX:1953
msgctxt "text_id=11484 | speaker=unknown"
msgid "「ごめん、木乃美のおかげで僕にも彼女ができました！　彼女の口癖は“木乃美クンよりマシよ"
msgstr "\"Sorry Kinomi, but thanks to you I finally got a girlfriend! She always tells me, 'It could be worse, I could be dating Kinomi!"

#. Occurrence 8_EX:1953:11485: voice_id=D70_8_EX_0000; voice_prefix=D70; voice_category=0; scene=8_EX
#: 8_EX:1953
msgctxt "text_id=11485 | speaker=unknown"
msgid "”です！」"
msgstr "'\""

#. Occurrence 8_EX:1981:11486: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0006; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:1981
msgctxt "text_id=11486 | speaker=kinomi"
msgid "「があー！　テメエら本気でむかつく！"
msgstr "\"Ugh! You guys are so lame!"

#. Occurrence 8_EX:1981:11487: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0006; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:1981
msgctxt "text_id=11487 | speaker=kinomi"
msgid "　青くせぇ学生生活おくってんじゃねえ！」"
msgstr "  I don't need to know about that kinda shit!\""

#. Occurrence 8_EX:2005:11488: scene=8_EX
#: 8_EX:2005
msgctxt "text_id=11488 | speaker=unknown"
msgid "　木乃美はバットを振り回してＡ組男子を追い回し、Ａ組男子たちは陽気に逃げ回りながら木乃美に感謝する。"
msgstr "  Kinomi took his bat and swung it around as he chased after the boys in Class A. They seemed to be having fun running from him while sarcastically thanking him."

#. Occurrence 8_EX:2010:11489: scene=8_EX
#: 8_EX:2010
msgctxt "text_id=11489 | speaker=unknown"
msgid "　基本、<罵|ののし>りあいなのに<和気|わき><藹々|あいあい>としているのは、木乃美芳助の人徳のなせる業だ。"
msgstr "  One of Kinomi's best virtues was his ability to remain good-natured in the face of insults."

#. Occurrence 8_EX:2046:11490: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0001; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:2046
msgctxt "text_id=11490 | speaker=soujuurou"
msgid "「ははは。木乃美は人気者だなあ」"
msgstr "\"Hahaha! You're as popular as ever, Kinomi!\""

#. Occurrence 8_EX:2052:11491: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0003; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2052
msgctxt "text_id=11491 | speaker=tobimaru"
msgid "「ああ、バカなのが救いだな。あれで下手に<利口|りこう>だったら犯罪者になってるところだ。"
msgstr "\"It's a good thing he's dumb. If he was clever, he'd probably end up as some kind of criminal."

#. Occurrence 8_EX:2058:11492: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0004; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2058
msgctxt "text_id=11492 | speaker=tobimaru"
msgid "　いや、その前に今度こそ蒼崎にしめられるか。あいつ、小ずるいチンピラには容赦ねえからな」"
msgstr "  After all that's happened though, he'd probably end up on the wrong end of Aozaki's fists. She doesn't have time to deal with someone like that!\""

#. Occurrence 8_EX:2078:11493: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0002; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:2078
msgctxt "text_id=11493 | speaker=soujuurou"
msgid "「そうなのか。―――ん？　今度こそ？」"
msgstr "\"You think so? ...Hm? All that's happened?\""

#. Occurrence 8_EX:2098:11494: scene=8_EX
#: 8_EX:2098
msgctxt "text_id=11494 | speaker=unknown"
msgid "　む、と考えこむ草十郎。"
msgstr "  Soujyuro fell deep into thought."

#. Occurrence 8_EX:2103:11495: scene=8_EX
#: 8_EX:2103
msgctxt "text_id=11495 | speaker=unknown"
msgid "　今の言いぶりだと、木乃美に蒼崎青子に関して、なにやら前科があるようだ。"
msgstr "  From the way that sounded, Kinomi seemed to have some kind of history with Aoko Aozaki."

#. Occurrence 8_EX:2144:11496: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0003; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:2144
msgctxt "text_id=11496 | speaker=soujuurou"
msgid "「木乃美は蒼崎に、その、ケソウ、してた事があるのか？」"
msgstr "\"Have Kinomi and Aozaki ever been an 'item'?\""

#. Occurrence 8_EX:2155:11497: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0005; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2155
msgctxt "text_id=11497 | speaker=tobimaru"
msgid "「あん、ケソウ？　ああ、懸想か。"
msgstr "\"An item? You mean a couple?"

#. Occurrence 8_EX:2166:11498: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0006; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2166
msgctxt "text_id=11498 | speaker=tobimaru"
msgid "　あのバカにそんな風情があるかって。ちょいとな、蒼崎と木乃美には条件反射じみた事件があったんだよ。"
msgstr "  You really think that idiot would have standards? There was a little incident between the two, but nothing more than that."

#. Occurrence 8_EX:2172:11499: speaker=tobimaru; speaker_ja=鳶丸; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B70_8_EX_0007; voice_prefix=B70; voice_category=4; scene=8_EX
#: 8_EX:2172
msgctxt "text_id=11499 | speaker=tobimaru"
msgid "　ありゃあ入学式の事だ。そうだよな、木乃美！」"
msgstr "  Back at the school entrance ceremony. Right, Kinomi?\""

#. Occurrence 8_EX:2177:11500: scene=8_EX
#: 8_EX:2177
msgctxt "text_id=11500 | speaker=unknown"
msgid "　鳶丸に怒鳴られ、木乃美は足を止めて振り返る。"
msgstr "  Kinomi froze and glanced back at Tobimaru's provocation."

#. Occurrence 8_EX:2218:11501: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0007; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2218
msgctxt "text_id=11501 | speaker=kinomi"
msgid "「おう、入学式な！　すげー<身体|からだ>してる女子がいたからさあ、つい声をかけたんだよな！」"
msgstr "\"Oh yeah, duh! I just remember seeing this chick with a smoking bod, and before I knew it I was reaching out to touch her!"

#. Occurrence 8_EX:2224:11502: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0008; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2224
msgctxt "text_id=11502 | speaker=kinomi"
msgid "“かーのじょ、どの<組|クラス>ぅ？”って。"
msgstr "  I was like, 'Hey, so what class are you in, girl?'"

#. Occurrence 8_EX:2235:11503: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0009; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2235
msgctxt "text_id=11503 | speaker=kinomi"
msgid "　いや、でもまさか、手が出るとは思わなかった。"
msgstr "  I didn't really mean to touch her like that though."

#. Occurrence 8_EX:2241:11504: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0010; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2241
msgctxt "text_id=11504 | speaker=kinomi"
msgid "　オレ的には一センチ前で<寸止|すんど>めしようとしたんだけど、目測をあやまった。オレの視覚情報より、蒼崎の肉体のサイズがやや<勝|まさ>っていたというコトさね」"
msgstr "  I really tried to stop myself, but I think my brain had a major malfunction, and my hand just went for it!\""

#. Occurrence 8_EX:2280:11505: scene=8_EX
#: 8_EX:2280
msgctxt "text_id=11505 | speaker=unknown"
msgid "　はっはっは、と遠い目で空を見上げる木乃美芳助。"
msgstr "  Kinomi laughed loudly as he gazed up at the sky."

#. Occurrence 8_EX:2290:11506: scene=8_EX
#: 8_EX:2290
msgctxt "text_id=11506 | speaker=unknown"
msgid "　草十郎は草十郎で、今の言葉だけで入学式に何が起きたのか、正確に把握したらしい。"
msgstr "  That was all the explanation Soujyuro needed to know what really happened that day at the entrance ceremony."

#. Occurrence 8_EX:2316:11507: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0004; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:2316
msgctxt "text_id=11507 | speaker=soujuurou"
msgid "「―――バカな。"
msgstr "\"...You idiot."

#. Occurrence 8_EX:2323:11508: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0005; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:2323
msgctxt "text_id=11508 | speaker=soujuurou"
msgid "なぜ命がある、木乃美」"
msgstr "How are you even still alive after that?\""

#. Occurrence 8_EX:2358:11509: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0011; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2358
msgctxt "text_id=11509 | speaker=kinomi"
msgid "「だろー？　オレのアゴ、垂直に跳ね上がったんだぜ!?"
msgstr "\"I know, right?! I thought she knocked my jaw clean off!"

#. Occurrence 8_EX:2392:11510: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0012; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2392
msgctxt "text_id=11510 | speaker=kinomi"
msgid "　平手とか拳とかそういうレベルじゃねえの、下からギャーンだぜギャーン！　周りにいたギャラリーいわく、“プールで縦に沈めたビート板が浮上するように蒼崎の靴が閃いた”らしい。"
msgstr "  It wasn't just a slap or a fist, you know? People were sayin' that it was like her foot was one of those swimboards if you dunk 'em deep in the water, shooting up to my chin like BAM!"

#. Occurrence 8_EX:2423:11511: speaker=kinomi; speaker_ja=木乃美; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=B50_8_EX_0013; voice_prefix=B50; voice_category=6; scene=8_EX
#: 8_EX:2423
msgctxt "text_id=11511 | speaker=kinomi"
msgid "　…………あの、今だから言いますけど、オレ、あの後の記憶がすっぽりないのです」"
msgstr "  ...I can tell you this now, but I don't have the slightest memory of anything that happened after that!\""

#. Occurrence 8_EX:2449:11512: speaker=soujuurou; speaker_ja=草十郎; speaker_source=voice_category_map; speaker_confidence=probable; voice_id=A30_8_EX_0006; voice_prefix=A30; voice_category=3; scene=8_EX
#: 8_EX:2449
msgctxt "text_id=11512 | speaker=soujuurou"
msgid "「――――――」"
